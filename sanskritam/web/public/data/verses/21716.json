[{"id": 7001716000, "chapter_id": 21716, "verse_number": "१-१०२-१", "content_sanskrit": "ब्रह्मोवाच ।\nश्रृणु पुत्र प्रवक्ष्यामि पुराणं लिंगसंज्ञितम् ।\nपठतां श्रृण्वतां चैव भुक्तिमुक्तिप्रदायकम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001716001, "chapter_id": 21716, "verse_number": "१-१०२-२", "content_sanskrit": "यच्च लिंगाभिधं तिष्ठन्वह्निलिंगे हरोऽभ्यधात् ।\nमह्यं धर्मादिसिद्ध्यर्थं मग्निकल्पकथाश्रयम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001716002, "chapter_id": 21716, "verse_number": "१-१०२-३", "content_sanskrit": "तदेव व्यासदेवेन भागद्वयसमन्वितम् ।\nपुराणं लिंगमुदितं बह्वाख्यानविचित्रितम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001716003, "chapter_id": 21716, "verse_number": "१-१०२-४", "content_sanskrit": "तदेकादशसाहस्रं हरमाहात्म्यसूचकम् ।\nपरं सर्वपुराणानां सारभूतं जगत्त्रये ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001716004, "chapter_id": 21716, "verse_number": "१-१०२-५", "content_sanskrit": "पुराणोपक्रमे प्रश्नः सृष्टिः संक्षेपतः पुरा ।\nयोगाख्यानं ततः प्रोक्तं कल्पाख्यानं ततः परम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001716005, "chapter_id": 21716, "verse_number": "१-१०२-६", "content_sanskrit": "लिंगोद्भवस्तदंबा च कीर्तिता हि ततः परम् ।\nसनत्कुमारशैलादिसंवादश्चाथ पावनः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001716006, "chapter_id": 21716, "verse_number": "१-१०२-७", "content_sanskrit": "ततो दाधीचचरितं युगधर्मनिरूपणम् ।\nततो भुवन कोशाख्या सूर्यसोमान्वयस्ततः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001716007, "chapter_id": 21716, "verse_number": "१-१०२-८", "content_sanskrit": "ततश्च विस्तरात्सर्गस्त्रिपुराख्यानकं तथा ।\nलिंगप्रतिष्ठा च ततः पशुपाशविमोक्षणम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001716008, "chapter_id": 21716, "verse_number": "१-१०२-९", "content_sanskrit": "शिवव्रतानि च तथा सदाचारनिरूपणम् ।\nप्रायश्चितान्यरिष्टानि काशीश्रीशैलवर्णनम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001716009, "chapter_id": 21716, "verse_number": "१-१०२-१०", "content_sanskrit": "अंधकाख्यानकं पश्चाद्वाराहचरितं पुनः ।\nनृसिंहचरितं पश्चाज्जलंधरवधस्ततः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001716010, "chapter_id": 21716, "verse_number": "१-१०२-११", "content_sanskrit": "शैवं सहस्रनामाथ दक्षयज्ञविनाशनम् ।\nकामस्य दहनं पश्चाद्गिरिजायाः करग्रहः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001716011, "chapter_id": 21716, "verse_number": "१-१०२-१२", "content_sanskrit": "ततो विनायकाख्यानं नृपाख्यानं शिवस्य च ।\nउपमन्युकथा चापि पूर्वभाग इतीरितः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001716012, "chapter_id": 21716, "verse_number": "१-१०२-१३", "content_sanskrit": "विष्णुमाहात्म्यकथनमंबरीषकथा ततः ।\nसनत्कुमारनंदीशसंवादश्च पुनर्मुने ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001716013, "chapter_id": 21716, "verse_number": "१-१०२-१४", "content_sanskrit": "शिवमाहात्म्यसंयुक्तः स्नानयागादिकं ततः ।\nसूर्यपूजाविधिश्चैव शिवपूजा च मुक्तिदा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001716014, "chapter_id": 21716, "verse_number": "१-१०२-१५", "content_sanskrit": "दानानि बहुधाक्तानि श्राद्धप्रकरणं ततः ।\nप्रतिष्ठातं त्रमुदितं ततोऽघोरस्य कीर्तनम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001716015, "chapter_id": 21716, "verse_number": "१-१०२-१६", "content_sanskrit": "वज्रेश्वरी महाविद्या गायत्रीमहिमा ततः ।\nत्र्यंबकस्य च माहात्म्यं पुराणश्रवणस्य च ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001716016, "chapter_id": 21716, "verse_number": "१-१०२-१७", "content_sanskrit": "एवं चोपरिभागस्ते लैंगस्य कथितो मया ।\nव्यासेन हि निबद्धस्य रुद्रामाहात्म्यसूचितः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001716017, "chapter_id": 21716, "verse_number": "१-१०२-१८", "content_sanskrit": "लिखित्वैतत्पुराणं तु तिलधेनुसमन्वितम् ।\nफाल्गुन्यां पूर्णिमायां यो दद्याद्भक्त्या द्विजातये ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001716018, "chapter_id": 21716, "verse_number": "१-१०२-१९", "content_sanskrit": "स लभेच्छिवसायुज्यं जरामरणवर्जितम् ।\nयः पठेच्छृणुयाद्वापि लैंगं पापापहं नरः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001716019, "chapter_id": 21716, "verse_number": "१-१०२-२०", "content_sanskrit": "स भुक्तभोगो लोकेऽस्मिन्नंते शिवपुरं व्रजेत् ।\nलिंगानुक्रमणीमेतां पठेद्यः श्रृणुयात्तथा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001716020, "chapter_id": 21716, "verse_number": "१-१०२-२१", "content_sanskrit": "तावुभौ शिवभक्तौ तु लोकद्वितयभोगिनौ ।\nजायतां गिरिजाभर्तुः प्रसादान्नात्र संशयः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]