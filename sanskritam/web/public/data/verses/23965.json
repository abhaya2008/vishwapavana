[{"id": 7003965000, "chapter_id": 23965, "verse_number": "३-१-२८-१", "content_sanskrit": "श्रीसूत उवाच ।\nकोटितीर्थं महापुण्यं सेवित्वा केवलं नरः ।\nस्नातुं जितेंद्रियस्तीर्थं ततः साध्यामृतं व्रजेत्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003965001, "chapter_id": 23965, "verse_number": "३-१-२८-२", "content_sanskrit": "साध्यामृतं महातीर्थ महापुण्यफलप्रदम् ।\nमहादुःखप्रशमनं गन्धमादनपर्वते॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003965002, "chapter_id": 23965, "verse_number": "३-१-२८-३", "content_sanskrit": "अस्ति पापहरं पुंसां सर्वाभीष्टप्रदायकम् ।\nयत्र स्नात्वा नरो भक्त्या सर्वान्कामानवाप्नुयात्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003965003, "chapter_id": 23965, "verse_number": "३-१-२८-४", "content_sanskrit": "तपसा ब्रह्मचर्येण यज्ञैर्दानेन वा पुनः ।\nगतिं तां न लभेन्मर्त्यो यां साध्यामृतमज्जनात्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003965004, "chapter_id": 23965, "verse_number": "३-१-२८-५", "content_sanskrit": "स्पृष्टानि येषामंगानि साध्यामृतजलैः शुभैः ।\nतेषां देहगतं पापं तत्क्षणादेव नश्यति॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003965005, "chapter_id": 23965, "verse_number": "३-१-२८-६", "content_sanskrit": "साध्यामृतजले यस्तु साघमर्षणकृन्नरः ।\nस विधूयेह पापानि विष्णुलोके महीयते॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003965006, "chapter_id": 23965, "verse_number": "३-१-२८-७", "content_sanskrit": "पूर्वे वयसि पापानि कृत्वा कर्माणि यो नरः ।\nपश्चात्साध्यामृतं सेवेत्पश्चात्तापसमन्वितः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003965007, "chapter_id": 23965, "verse_number": "३-१-२८-८", "content_sanskrit": "अन्ते वयसि मुक्तः स्यात्स नरो नात्र संशयः ।\nसाध्यामृते नरः स्नात्वा देहबंधाद्विमुच्यते॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003965008, "chapter_id": 23965, "verse_number": "३-१-२८-९", "content_sanskrit": "साध्यामृतजले स्नाता मनुष्याः पापक र्मिणः ।\nअनेकक्लेशघोराणि नरकाणि न यांति हि॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003965009, "chapter_id": 23965, "verse_number": "३-१-२८-१०", "content_sanskrit": "साध्यामृतजले स्नानात्पुंसां या स्याद्गतिर्द्विजाः ।\nन सा गतिर्भवेद्यज्ञैर्न वेदैः पुण्यकर्मभिः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003965010, "chapter_id": 23965, "verse_number": "३-१-२८-११", "content_sanskrit": "यावदस्थि मनुष्याणां साध्यामृतजले स्थितम् ।\nतावद्वर्षाणि तिष्ठंति शिवलोके सुपूजिताः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003965011, "chapter_id": 23965, "verse_number": "३-१-२८-१२", "content_sanskrit": "अपहत्य तमस्तीव्रं यथा भात्युदये रविः ।\nतथा साध्यामृतस्नायी भित्त्वा पापानि राजते॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003965012, "chapter_id": 23965, "verse_number": "३-१-२८-१३", "content_sanskrit": "वांछितांल्लभते कामानत्र स्नातो नरः सदा ।\nयत्र स्नात्वा महापुण्ये पुरा राजा पुरूरवाः ।\nविप्रयोगं सहोर्वश्या जहौ तुंबुरुशापजम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003965013, "chapter_id": 23965, "verse_number": "३-१-२८-१४", "content_sanskrit": "ऋषय ऊचुः ।\nकथं सूत महाभाग सहोर्वश्यामरस्त्रिया॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003965014, "chapter_id": 23965, "verse_number": "३-१-२८-१५", "content_sanskrit": "प्रथमं लब्धवान्योगं मर्त्यो राजा पुरूरवाः ।\nविप्रयोगं सहोर्वश्या जहौ तुंबुरुशापजम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003965015, "chapter_id": 23965, "verse_number": "३-१-२८-१६", "content_sanskrit": "हेतुना केन राजानं शशाप तुंबुरुर्मुनिः ।\nएतत्सर्वं समाचक्ष्व विस्तरान्मुनिपुंगव॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003965016, "chapter_id": 23965, "verse_number": "३-१-२८-१७", "content_sanskrit": "सूत उवाच ।\nआसीत्पुरूरवानाम शक्रतुल्यपराक्रमः ।\nराजराजसमो राजा पुरा ह्यमरपूजितः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003965017, "chapter_id": 23965, "verse_number": "३-१-२८-१८", "content_sanskrit": "धर्मतः पालयामास मेदिनीं स नृपोत्तमः ।\nईजे च बहुभिर्यज्ञैर्ददौ दानानि सर्वदा॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003965018, "chapter_id": 23965, "verse_number": "३-१-२८-१९", "content_sanskrit": "प्रशासति महीं सर्वां राज्ञि तस्मिन्महामतौ ।\nमित्रावरुणशापेन भुवं प्रापोर्वशी द्विजाः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003965019, "chapter_id": 23965, "verse_number": "३-१-२८-२०", "content_sanskrit": "सा चचारोर्वशी तत्र राज्ञस्तस्य पुरांतिके ।\nकोकिलालापमधुरवीणयोपवने जगौ॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003965020, "chapter_id": 23965, "verse_number": "३-१-२८-२१", "content_sanskrit": "स राजोपवने रंतुं कदाचिद्धृतकौतुकः ।\nआरूढतुरगः प्रायाल्ललनाशतसंवृतः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003965021, "chapter_id": 23965, "verse_number": "३-१-२८-२२", "content_sanskrit": "तादृशीमुर्वशीं तत्र करसम्मितमध्यमाम् ।\nउवाच चैनां राजासौ भार्या मम भवेति वै॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003965022, "chapter_id": 23965, "verse_number": "३-१-२८-२३", "content_sanskrit": "सापि कामातुरा तत्र राजानं प्रत्यभाषत ।\nभवत्वेवं नरश्रेष्ठ समयं यदि मे भवान्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003965023, "chapter_id": 23965, "verse_number": "३-१-२८-२४", "content_sanskrit": "करिष्यति तवाभ्याशे वत्स्यामि धृतकौतुका ।\nकरिष्ये समयं सुभ्रु तवाहमिति सोऽब्रवीत्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003965024, "chapter_id": 23965, "verse_number": "३-१-२८-२५", "content_sanskrit": "अथोर्वशी बभाषे तं पुरूरवसमुत्सुका ।\nपुत्रभूतं मम यदि रक्षस्युरणकद्वयम्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003965025, "chapter_id": 23965, "verse_number": "३-१-२८-२६", "content_sanskrit": "न नग्नो दृश्यसे राजन्कदापि यदि वै तथा ।\nनोच्छिष्टं मम दद्याश्चेत्तदा वत्स्ये तवांतिके॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003965026, "chapter_id": 23965, "verse_number": "३-१-२८-२७", "content_sanskrit": "घृतमात्राशना चाहं भविष्यामि नृपोत्तम ।\nएवमस्त्विति राजोक्तां तां निनाय निजं गृहम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003965027, "chapter_id": 23965, "verse_number": "३-१-२८-२८", "content_sanskrit": "अलकायां स भूपालस्तथा चैत्ररथे वने ।\nरेमे सरस्वतीतीरे पद्मखण्डमनोरमे॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003965028, "chapter_id": 23965, "verse_number": "३-१-२८-२९", "content_sanskrit": "एकषष्टिं स वर्षाणि रममाणस्तयानयत् ।\nतेनोर्वशी प्रतिदिनं वर्धमानानुरागिणी॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003965029, "chapter_id": 23965, "verse_number": "३-१-२८-३०", "content_sanskrit": "स्पृहां न देवलोकेऽपि चकार तनुमध्यमा ।\nनाभवद्रमणीयोऽसौ देवलोकस्तया विना॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003965030, "chapter_id": 23965, "verse_number": "३-१-२८-३१", "content_sanskrit": "अतस्तामानयिष्यामि देवलोकमिति द्विजाः ।\nविश्वावसुर्विचार्यैवं भूर्लोकमगमत्क्षणात्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003965031, "chapter_id": 23965, "verse_number": "३-१-२८-३२", "content_sanskrit": "उर्वश्याः समयं राज्ञा विश्वावसुरयं सह ।\nविदित्वा सह गन्धर्वैः समवेतो निशांतरे॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003965032, "chapter_id": 23965, "verse_number": "३-१-२८-३३", "content_sanskrit": "उर्वश्याः शयनाभ्याशाज्जग्राहोरणकं जवात् ।\nआकाशे नीयमानस्य तस्य श्रुत्वोर्वशी पतिम्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003965033, "chapter_id": 23965, "verse_number": "३-१-२८-३४", "content_sanskrit": "अब्रवीन्मत्सुतः केन गृह्यते त्यज्यतामयम् ।\nअनाथा शरणं यामि कं नरं गतचेतना॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003965034, "chapter_id": 23965, "verse_number": "३-१-२८-३५", "content_sanskrit": "पुरूरवाः समाकर्ण्य वाक्यं तस्या निशांतरे ।\nमां न नग्नं निरीक्षेत देवीति न ययौ तदा॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003965035, "chapter_id": 23965, "verse_number": "३-१-२८-३६", "content_sanskrit": "अथान्यमप्युरणकं गन्धर्वाः प्रतिगृह्य ते ।\nययुस्तस्योरणस्यापि शब्दं शुश्राव चोर्वशी॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003965036, "chapter_id": 23965, "verse_number": "३-१-२८-३७", "content_sanskrit": "अनाथाया मम सुतो गृह्यते तस्करैरिति ।\nचुक्रोश देवी परुषं कं यामि शरणं नरम्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003965037, "chapter_id": 23965, "verse_number": "३-१-२८-३८", "content_sanskrit": "अमर्षवशमापन्नः श्रुत्वा तद्वचनं नृपः ।\nतिमिरेणावृतं सर्वमिति मत्त्वा स खङ्गधृक्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003965038, "chapter_id": 23965, "verse_number": "३-१-२८-३९", "content_sanskrit": "दुष्टदुष्ट कुतो यासीत्यभ्यधावद्वचो वदन् ।\nतावत्सौदामिनी दीप्ता गन्ध र्वैर्जनिता भृशम्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003965039, "chapter_id": 23965, "verse_number": "३-१-२८-४०", "content_sanskrit": "तत्प्रभामंडलैर्देवी राजानं विगतांबरम् ।\nदृष्ट्वा निवृत्तसमया तत्क्षणादेव निर्ययौ॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003965040, "chapter_id": 23965, "verse_number": "३-१-२८-४१", "content_sanskrit": "त्यक्त्वा ह्युरणकौ तत्र गंधर्वा अपि निर्ययुः ।\nराजा मेषौ समादाय हृष्टः स्वशयनांतिकम्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003965041, "chapter_id": 23965, "verse_number": "३-१-२८-४२", "content_sanskrit": "आगतो नोर्वशीं तत्र ददर्शायतलोचनाम् ।\nतां चापश्यन्विवस्त्रश्च बभ्रामोन्मत्तवद्भुवि॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003965042, "chapter_id": 23965, "verse_number": "३-१-२८-४३", "content_sanskrit": "कुरुक्षेत्रं गतो राजा तटाके पद्मसंकुले ।\nचतुर्भिरप्सरस्त्रीभिः क्रीडमाना ददर्श ताम्॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003965043, "chapter_id": 23965, "verse_number": "३-१-२८-४४", "content_sanskrit": "हे जाये तिष्ठ मनसा घोरेति व्याहरन्मुहुः ।\nएवं बहुप्रकारं वै स सूक्तं प्रालपन्नृपः॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003965044, "chapter_id": 23965, "verse_number": "३-१-२८-४५", "content_sanskrit": "अब्रवीदुर्वशी तं च क्रीडती साप्सरोगणैः ।\nमहाराजालमेतेन चेष्टितेन तवानघ॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003965045, "chapter_id": 23965, "verse_number": "३-१-२८-४६", "content_sanskrit": "त्वत्तो गर्भिण्यहं पूर्वमब्दांते भवतात्र वै ।\nआगंतव्यं कुमारस्ते भविष्यत्यतिधार्मिकः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003965046, "chapter_id": 23965, "verse_number": "३-१-२८-४७", "content_sanskrit": "एकां विभावरीं राजंस्त्वया वत्स्यामि वै तदा ।\nइत्युक्तो नृपतिर्हृष्टः स्वपुरीं प्राविशद्द्विजाः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003965047, "chapter_id": 23965, "verse_number": "३-१-२८-४८", "content_sanskrit": "तासामप्सरसां सा तु कथयामास तं नृपम् ।\nअयं स पुरुषश्रेष्ठो येनाहं कामरूपिणा॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003965048, "chapter_id": 23965, "verse_number": "३-१-२८-४९", "content_sanskrit": "एतावंतं महाकालमनुरागवशातुरा ।\nउषितास्मि सहानेन सख्यो नृपतिना चिरम्॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003965049, "chapter_id": 23965, "verse_number": "३-१-२८-५०", "content_sanskrit": "एवमुक्तास्ततः सख्यस्तामूचुः साधुसाध्विति ।\nअनेन साकमास्यामः सर्वकालं वयं सखि॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003965050, "chapter_id": 23965, "verse_number": "३-१-२८-५१", "content_sanskrit": "इत्यूचुरुर्वशीं तत्र सखीमप्सरसस्तदा ।\nअब्देऽथ पूर्णे राजापि तटाकांति कमाययौ॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003965051, "chapter_id": 23965, "verse_number": "३-१-२८-५२", "content_sanskrit": "आगतं नृपतिं दृष्ट्वा पुरूरवसमुर्वशी ।\nकुमारमायुषं तस्मै ददौ संप्रीतमानसा॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003965052, "chapter_id": 23965, "verse_number": "३-१-२८-५३", "content_sanskrit": "तेन साकं निशामेकामुषिता सानु रागिणी ।\nपंचपुत्रप्रदं गर्भं तस्मादापाशु सोर्वशी॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003965053, "chapter_id": 23965, "verse_number": "३-१-२८-५४", "content_sanskrit": "उवाच चैनं राजानमुर्वशी परमांगना ।\nवरं दास्यंति गन्धर्वा मत्प्रीत्या तव भूपते॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003965054, "chapter_id": 23965, "verse_number": "३-१-२८-५५", "content_sanskrit": "भवतां प्रार्थ्यतां तेभ्यो वरो राजर्षिसत्तम ।\nइत्युक्तः स तया राजा प्राह गन्धर्वसत्तमान्॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003965055, "chapter_id": 23965, "verse_number": "३-१-२८-५६", "content_sanskrit": "अहं संपूर्णकोशश्च विजिताराति मंडलः ।\nसलोकतां विनोर्वश्याः प्राप्तव्यं नान्यदस्ति मे॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003965056, "chapter_id": 23965, "verse_number": "३-१-२८-५७", "content_sanskrit": "अतस्तया सहोर्वश्या कालं नेतुमहं वृणे ।\nएवमुक्ते नृपेणाथ गन्धर्वास्तुष्ट मानसाः ।\nअग्निस्थालीं प्रदायास्मै प्रोचुश्चैनं नृपं तदा॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003965057, "chapter_id": 23965, "verse_number": "३-१-२८-५८", "content_sanskrit": "गन्धर्वा ऊचुः ।\nअग्निं वेदानुसारी त्वं त्रिधा कृत्वा नृपोत्तम॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003965058, "chapter_id": 23965, "verse_number": "३-१-२८-५९", "content_sanskrit": "इष्ट्वा यज्ञेन चोर्वश्याः सालोक्यं याहि भूपते ।\nइतीरितस्तैरादाय स्थालीमग्नेर्ययौ नृपः॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003965059, "chapter_id": 23965, "verse_number": "३-१-२८-६०", "content_sanskrit": "अहो बतातिमूढोहमिति मध्ये वनं नृपः ।\nउर्वशी न मया लब्धा वह्निस्थाल्या तु किं फलम्॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003965060, "chapter_id": 23965, "verse_number": "३-१-२८-६१", "content_sanskrit": "निधायैव वने स्थालीं स्वपुरं प्रययौ नृपः ।\nअर्धरात्रे व्यतीतेऽसौ विनिद्रोऽचिंतयत्स्वयम्॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003965061, "chapter_id": 23965, "verse_number": "३-१-२८-६२", "content_sanskrit": "उर्वशीलोकसिद्ध्यर्थं मम गन्धर्वपुंगवैः ।\nअग्निस्थाली संप्रदत्ता सा च त्यक्ता मया वने॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003965062, "chapter_id": 23965, "verse_number": "३-१-२८-६३", "content_sanskrit": "आहरिष्ये पुनः स्थालीमित्युत्थाय ययौ वनम् ।\nनाग्निस्थालीं ददर्शासौ वने तत्र पुरूरवाः॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003965063, "chapter_id": 23965, "verse_number": "३-१-२८-६४", "content_sanskrit": "शमीगर्भमथाश्वत्थमग्निस्थाने विलोक्य सः ।\nव्यचिंतयन्मया स्थाली निक्षिप्तात्र वने पुरा॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003965064, "chapter_id": 23965, "verse_number": "३-१-२८-६५", "content_sanskrit": "सा चाश्वत्थः शमीगर्भः समभूदधुना त्विह ।\nतस्मादेनं समादाय वह्निरूपमहं पुरम्॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003965065, "chapter_id": 23965, "verse_number": "३-१-२८-६६", "content_sanskrit": "गत्वा कृत्वारणीं सम्यक्तदुत्पन्नाग्निमादरात् ।\nउपास्यामीति निश्चित्य स्वपुरं गतवान्नृपः॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003965066, "chapter_id": 23965, "verse_number": "३-१-२८-६७", "content_sanskrit": "रमणीयारणीं चक्रे स्वांगुलैः प्रमिता मसौ ।\nनिर्माणसमये राजा गायत्रीमजपद्द्विजाः॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003965067, "chapter_id": 23965, "verse_number": "३-१-२८-६८", "content_sanskrit": "गायत्र्याः पठ्यमानाया यानि संत्यक्षराणि हि ।\nतावदंगुलिमर्यादामकरोदरणीं नृपः॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003965068, "chapter_id": 23965, "verse_number": "३-१-२८-६९", "content_sanskrit": "तत्र निर्मथनादग्नित्रयमुत्पाद्य भूपतिः ।\nउर्वशीलोकसंप्राप्तिफलमुद्दिश्य कांक्षितम्॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003965069, "chapter_id": 23965, "verse_number": "३-१-२८-७०", "content_sanskrit": "वेदानुसारी नृपतिर्जुहावाग्नित्रयं मुदा ।\nतेनैव चाग्निविधिना बहून्यज्ञानथातनोत्॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003965070, "chapter_id": 23965, "verse_number": "३-१-२८-७१", "content_sanskrit": "तेन गन्धर्वलोकांश्च संप्राप्य जगतीपतिः ।\nसहोर्वश्या चिरं रेमे देवलोके द्विजोत्तमाः॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003965071, "chapter_id": 23965, "verse_number": "३-१-२८-७२", "content_sanskrit": "अथ सर्वामरोपेतः कदाचिद्बलवृत्रहा ।\nनृत्यं सुरांगनानां वै व्यलोकयत संसदि॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003965072, "chapter_id": 23965, "verse_number": "३-१-२८-७३", "content_sanskrit": "पुरूरवा नृपोप्यायात्तदा देवेंद्रसंसदम् ।\nद्रष्टुं सुरांगनानृत्यं मनोहारि दिवौकसाम्॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003965073, "chapter_id": 23965, "verse_number": "३-१-२८-७४", "content_sanskrit": "एकैकशस्ताः शक्रस्य ननृतुः पुरतोंऽगनाः ।\nअथोर्वशी समागत्य ननर्त पुरतो हरेः॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003965074, "chapter_id": 23965, "verse_number": "३-१-२८-७५", "content_sanskrit": "नृत्ताभिनयसामर्थ्यगर्वयुक्ता तदोर्वशी ।\nतं पुरूरवसं दृष्ट्वा जहासातिमनोहरा॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003965075, "chapter_id": 23965, "verse_number": "३-१-२८-७६", "content_sanskrit": "जहास तत्र राजापि तां विलोक्य तदोर्वशीम् ।\nहाससंकुपितस्तत्र नाट्याचार्योऽथ तुंबुरुः ।\nशशाप तावुभौ कोपादुर्वशीं च नृपोत्तमम्॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003965076, "chapter_id": 23965, "verse_number": "३-१-२८-७७", "content_sanskrit": "तुंबुरुरुवाच ।\nअनेकदेवसंपूर्णसभायामत्र यत्कृतम्॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003965077, "chapter_id": 23965, "verse_number": "३-१-२८-७८", "content_sanskrit": "युवाभ्यां हसितं नृत्तमध्ये निष्कारणं वृथा ।\nतस्माज्झटिति राजेंद्र वियोगो युवयोः क्षणात्॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003965078, "chapter_id": 23965, "verse_number": "३-१-२८-७९", "content_sanskrit": "भूयादिति शशापैनं सर्वदैवतसंनिधौ ।\nअथ शप्तो नृपस्तत्र नाट्याचार्येण दुःखितः॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003965079, "chapter_id": 23965, "verse_number": "३-१-२८-८०", "content_sanskrit": "जगाम शरणं तत्र पाहिपाहीति वज्रिणम् ।\nउवाच दीनया वाचा पुरुहूतं पुरूरवाः॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003965080, "chapter_id": 23965, "verse_number": "३-१-२८-८१", "content_sanskrit": "उर्वश्या सह सालोक्यसिद्ध्यर्थमहमिष्टवान् ।\nअतस्तस्मा वियोगो मेऽसह्यः स्यात्पाकशासन॥ ८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003965081, "chapter_id": 23965, "verse_number": "३-१-२८-८२", "content_sanskrit": "इत्युक्तवंतं तं प्राह सहस्राक्षः शचीपतिः ।\nशापमोक्षं प्रवक्ष्यामि मा भैषीस्त्वं नृपोत्तम॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003965082, "chapter_id": 23965, "verse_number": "३-१-२८-८३", "content_sanskrit": "दक्षिणांभोनिधौ पुण्ये गंधमादनपर्वते ।\nसाध्यामृतमिति ख्यातं तीर्थमस्ति महत्तरम्॥ ८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003965083, "chapter_id": 23965, "verse_number": "३-१-२८-८४", "content_sanskrit": "सेवितं सर्वदेवैश्च सिद्धचारणकिन्नरैः ।\nसनकादि महायोगिमुनिवृंदनिषेवितम्॥ ८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003965084, "chapter_id": 23965, "verse_number": "३-१-२८-८५", "content_sanskrit": "भुक्तिमुक्तिप्रदं पुंसां सर्वशापविमोक्षदम् ।\nअस्ति तीर्थं भवांस्तत्र गच्छस्व त्वरया नृप॥ ८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003965085, "chapter_id": 23965, "verse_number": "३-१-२८-८६", "content_sanskrit": "सर्वेषाममृतं स्नानादत्र साध्यं यतस्ततः ।\nसाध्यामृतमिति ख्यातं सर्वलोकेषु विश्रुतम्॥ ८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003965086, "chapter_id": 23965, "verse_number": "३-१-२८-८७", "content_sanskrit": "तत्र स्नानात्तवोर्वश्याः पुनर्योगो भविष्यति ।\nमम लोके निवासश्च भविष्यति न संशयः॥ ८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003965087, "chapter_id": 23965, "verse_number": "३-१-२८-८८", "content_sanskrit": "इति प्रतिसमादिष्टो नृपः संप्रीतमानसः ।\nसाध्यामृतं महातीर्थं समुद्दिश्य ययौ क्षणात्॥ ८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003965088, "chapter_id": 23965, "verse_number": "३-१-२८-८९", "content_sanskrit": "सस्नौ साध्यामृते तत्र महापातकनाशने ।\nतत्र स्नानान्नृपो विप्राः सद्यः शापेन मोचितः॥ ८९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003965089, "chapter_id": 23965, "verse_number": "३-१-२८-९०", "content_sanskrit": "स्नानानंतरमेवासावुर्वश्या सह संगतः ।\nतया सह विमानस्थः प्रययावमरावतीम्॥ ९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003965090, "chapter_id": 23965, "verse_number": "३-१-२८-९१", "content_sanskrit": "रेमे पुनस्तया सार्धं देववद्देवमंदिरे ।\nएवंप्रभावं तत्तीर्थं साध्यामृतमनुत्तमम्॥ ९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003965091, "chapter_id": 23965, "verse_number": "३-१-२८-९२", "content_sanskrit": "पुरूरवा सहोर्वश्या यत्र स्नानेन संगतः ।\nअतोऽत्र तीर्थे यः स्नायान्महापातकनाशने॥ ९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003965092, "chapter_id": 23965, "verse_number": "३-१-२८-९३", "content_sanskrit": "वांछितांल्लभते कामान्यास्यति स्वर्गमुत्तमम् ।\nनिष्कामः स्नाति चेद्वि प्रा मोक्षमाप्नोति मानवः॥ ९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003965093, "chapter_id": 23965, "verse_number": "३-१-२८-९४", "content_sanskrit": "इमं पवित्रं पापघ्नमध्यायं पठते तु यः ।\nशृणुयाद्वा मनुष्योऽसौ वैकुंठे लभते स्थितिम्॥ ९४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003965094, "chapter_id": 23965, "verse_number": "३-१-२८-९५", "content_sanskrit": "एवं वः कथितं विप्रा वैभवं पापनाशनम् ।\nसाध्यामृतस्य तीर्थस्य विस्तराच्छ्रद्धया मया॥ ९५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003965095, "chapter_id": 23965, "verse_number": "३-१-२८-९६", "content_sanskrit": "यत्पुरा सनकादिभ्यः प्रोक्तवांश्चतुराननः॥ ९६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}]