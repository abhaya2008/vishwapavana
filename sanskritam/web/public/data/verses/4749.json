[{"id": 2177571, "chapter_id": 4749, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2177572, "chapter_id": 4749, "verse_number": "१", "content_sanskrit": "तस्मिन् प्रयाते दुर्धर्षे यदूनामृषभस्ततः ।\nअब्रवीत् पुण्डरीकाक्षः कुन्तीपुत्रं युधिष्ठिरम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2177573, "chapter_id": 4749, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2177574, "chapter_id": 4749, "verse_number": "२", "content_sanskrit": "एष ते पाण्डवो भ्राता पुत्रशोकमपारयन् ।\nजिघांसुर्द्रौणिमाक्रन्दे एक एवाभिधावति\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2177575, "chapter_id": 4749, "verse_number": "३", "content_sanskrit": "भीमः प्रियस्ते सर्वेभ्यो भ्रातृभ्यो भरतर्षभ ।\nतं कृच्छ्रगतमद्य त्वं कस्मान्नाभ्यवपद्यसे\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2177576, "chapter_id": 4749, "verse_number": "४", "content_sanskrit": "यत्तदाचष्ट पुत्राय द्रोणः प्रहरतां वरः ।\nअस्त्रं ब्रह्मशिरो नाम तद्दहेत् पृथिवीमपि\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2177577, "chapter_id": 4749, "verse_number": "५", "content_sanskrit": "तन्महात्मा महाभागः केतुः सर्वधनुष्मताम् ।\nप्रत्यपादयदाचार्यः प्रीयमाणो धनञ्जयम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2177578, "chapter_id": 4749, "verse_number": "६", "content_sanskrit": "तं पुत्रोऽप्येक एवैनम् अन्वयाचदमर्षणः ।\nततः प्रोवाच पुत्राय नातिहृष्टमना इव\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2177579, "chapter_id": 4749, "verse_number": "७", "content_sanskrit": "विदितं चापलं ह्यासीद् आत्मजस्य महात्मनः ।\nसर्वधर्मविदाचार्यः सोऽन्वशासत् सुतं ततः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2177580, "chapter_id": 4749, "verse_number": "", "content_sanskrit": "द्रोणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2177581, "chapter_id": 4749, "verse_number": "८", "content_sanskrit": "परमापद्गतेनापि न स्म तात त्वया रणे ।\nइदमस्त्रं प्रयोक्तव्यं मानुषेषु विशेषतः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2177582, "chapter_id": 4749, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2177583, "chapter_id": 4749, "verse_number": "९", "content_sanskrit": "इत्युक्तवान् गुरुः पुत्रं द्रोणः पश्चादथोक्तवान् ।\nन त्वं जातु सतां मार्गे स्थातेति पुरुषर्षभ\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2177584, "chapter_id": 4749, "verse_number": "१०", "content_sanskrit": "स तदाज्ञाय दुष्टात्मा पितुर्वचनमप्रियम् ।\nनिराशः सर्वकल्याणे शोचन् पर्यपतन्महीम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2177585, "chapter_id": 4749, "verse_number": "", "content_sanskrit": "कदाचित् स नरश्रेष्ठ वनस्थे त्वयि भारत ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2177586, "chapter_id": 4749, "verse_number": "", "content_sanskrit": "(ततस्तु वचनं श्रुत्वा भीमसेनोऽब्रवीदिदम्\t॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2177587, "chapter_id": 4749, "verse_number": "", "content_sanskrit": "किं तेन पुत्र कान्तेन मातुः क्लेशकरेण वै ।\nयस्य न स्फुरते कीर्तिः धनस्थे वरदे यथा\t॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2177588, "chapter_id": 4749, "verse_number": "", "content_sanskrit": "अद्यैवाहं प्रयास्यामि हनिष्यामि त्वया रणे ।\nकृपं च कृतवर्माणमश्वत्थामानमेव च\t॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2177589, "chapter_id": 4749, "verse_number": "", "content_sanskrit": "भविष्यामि ततः प्रीतः कृते कार्ये सुदुस्तरे ।\nइत्येवं वचनं श्रुत्वा वासुदेवोऽब्रवीदिदम्\t॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2177590, "chapter_id": 4749, "verse_number": "११", "content_sanskrit": "शृणु भो भीमवाक्यं मे यथा वनगते त्वयि ।\nअश्वत्थामा कुरुश्रेष्ठ वनस्थे त्वयि भारत\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2177591, "chapter_id": 4749, "verse_number": "१२", "content_sanskrit": "अवसद् द्वारकामेत्य वृष्णिभिः परमार्चितः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2177592, "chapter_id": 4749, "verse_number": "१३", "content_sanskrit": "स कदाचित् समुद्रान्ते वसन् द्वारवतीमनु ।\nएक एकं समागम्य मामुवाच हसन्निव\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2177593, "chapter_id": 4749, "verse_number": "१४", "content_sanskrit": "यत् तदुग्रं तपः कृष्ण चरन्नमितविक्रमः ।\nअगस्त्याद् भारताचार्यः प्रत्यपद्यत मे पिता\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2177594, "chapter_id": 4749, "verse_number": "१५", "content_sanskrit": "अस्त्रं ब्रह्मशिरो नाम देवगन्धर्वपूजितम् ।\nतदद्य मयि दाशार्ह यथा पितरि मे तथा\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2177595, "chapter_id": 4749, "verse_number": "१७", "content_sanskrit": "अस्मत्तस्तदुपादाय दिव्यमस्त्रविदां वर ।\nममाप्यस्त्रं प्रयच्छ त्वं चक्रं रिपुहरं रणे\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2177596, "chapter_id": 4749, "verse_number": "१८", "content_sanskrit": "स राजन् प्रीयमाणेन मयाऽप्युक्तः कृताञ्जलिः ।\nयाचमानः प्रयत्नेन मत्तोऽस्त्रं भरतर्षभ\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2177597, "chapter_id": 4749, "verse_number": "१९", "content_sanskrit": "देवदानवगन्धर्वमनुष्यपतगोरगाः ।\nन समा मम वीर्यस्य शतांशेनापि पिण्डिताः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2177598, "chapter_id": 4749, "verse_number": "२०", "content_sanskrit": "इदं धनुरियं शक्तिरिदं चक्रमियं गदा ।\nयद्यदिच्छसि चेदस्त्रं मत्तस्तत्तद् ददामि ते\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2177599, "chapter_id": 4749, "verse_number": "२१", "content_sanskrit": "यच्छक्नोषि समुद्यन्तुं प्रयोक्तुमपि वा रणे ।\nतद् गृहाण विनाऽस्त्रेण यन्मे दातुमिहेच्छसि\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2177600, "chapter_id": 4749, "verse_number": "२२", "content_sanskrit": "स सुनाभं सहस्रारं वज्रनाभमयस्मयम् ।\nवव्रे चक्रं महाभागो मत्तः स्पर्धन् मया सह\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2177601, "chapter_id": 4749, "verse_number": "२३", "content_sanskrit": "गृहाण चक्रमित्युक्तो मया तु तदनन्तरम् ।\nजग्राहोपेत्य सहसा चक्रं सव्येन पाणिना\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2177602, "chapter_id": 4749, "verse_number": "२४", "content_sanskrit": "न चैनमशकत् स्थानात् प्रचालयितुमप्युत\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2177603, "chapter_id": 4749, "verse_number": "२५", "content_sanskrit": "अथैनं दक्षिणेनापि ग्रहीतुमुपचक्रमे ।\nसर्वयत्नेन तेनापि गृह्य नैनमकम्पयत्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2177604, "chapter_id": 4749, "verse_number": "२६", "content_sanskrit": "ततः सर्वबलेनापि यदैनं न शशाक ह ।\nउद्यन्तुं वा चालयितुं द्रौणिः परमदुर्मनाः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2177605, "chapter_id": 4749, "verse_number": "२७", "content_sanskrit": "कृत्वा यत्नं परं श्रान्तः स न्यवर्तत भारत\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2177606, "chapter_id": 4749, "verse_number": "२८", "content_sanskrit": "निवृत्तमनसं तस्मादभिप्रायाद् विचेतसम् ।\nअहमामन्त्र्य संविग्नमश्वत्थामानमब्रुवम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2177607, "chapter_id": 4749, "verse_number": "२९", "content_sanskrit": "यः स दैवमनुष्येषु प्रमाणं परमं गतः ।\nगाण्डीवधन्वा श्वेताश्वः कपिप्रवरकेतनः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2177608, "chapter_id": 4749, "verse_number": "३०", "content_sanskrit": "यः साक्षाद्देवदेवेशं शितिकण्ठमुमापतिम् ।\nद्वन्द्वयुद्धे पुरा जिष्णुस्तोषयामास शङ्करम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2177609, "chapter_id": 4749, "verse_number": "३१", "content_sanskrit": "यस्मात् प्रियतरो नास्ति ममान्यः पुरुषो भुवि ।\nन देयं तस्य मे किञ्चिदपि प्राणान्महात्मनः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2177610, "chapter_id": 4749, "verse_number": "३२", "content_sanskrit": "तेनापि सुहृदा ब्रह्मन् पार्थेनाक्लिष्टकर्मणा ।\nनोक्तपूर्वमिदं वाक्यं यस्त्वं मामभिभाषसे\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2177611, "chapter_id": 4749, "verse_number": "३३", "content_sanskrit": "ब्रह्मचर्यं महद्घोरं चरित्वा द्वादशवार्षिकीम् ।\nहिमवत्पादमभ्येत्य यो मया तपसाऽऽर्जितः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2177612, "chapter_id": 4749, "verse_number": "३४", "content_sanskrit": "समानव्रतचारिण्यां रुग्मिण्यां यो व्यजायत ।\nसनत्कुमारस्तेजस्वी प्रद्युम्नो नाम मे सुतः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2177613, "chapter_id": 4749, "verse_number": "३५", "content_sanskrit": "तेनाप्येतन्महद्दिव्यं चक्रमप्रतिमं रणे ।\nन प्रार्थितमभून्मूढ तदिदं प्रार्थितं त्वया\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2177614, "chapter_id": 4749, "verse_number": "३६", "content_sanskrit": "रामेणातिबलेनैव नोक्तपूर्वं कदाचन ।\nन गदेन न साम्बेन यदिदं प्रार्थितं त्वया\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2177615, "chapter_id": 4749, "verse_number": "३७", "content_sanskrit": "द्वारकावासिभिश्चैव वृष्ण्यन्धकमहारथैः ।\nनोक्तपूर्वमिदं क्षुद्रं यदिदं प्रार्थितं त्वया\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2177616, "chapter_id": 4749, "verse_number": "३८", "content_sanskrit": "भारताचार्यपुत्रः सन् मानितस्त्वं मया द्विजः ।\nचक्रेण रथिनां श्रेष्ठ यन्नस्तात युयुत्ससे\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2177617, "chapter_id": 4749, "verse_number": "३९", "content_sanskrit": "एवमुक्तो मया द्रौणिर्मामिदं प्रत्युवाच ह\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2177618, "chapter_id": 4749, "verse_number": "", "content_sanskrit": "द्रौणिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2177619, "chapter_id": 4749, "verse_number": "४०", "content_sanskrit": "प्रयुज्य भवते पूजां योत्स्ये कृष्ण त्वया सह\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2177620, "chapter_id": 4749, "verse_number": "४१", "content_sanskrit": "प्रार्थितं ते मया चक्रं देवदानवपूजितम् ।\nअजेयः स्यामिति विभो सत्यमेतद् ब्रवीमि ते\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2177621, "chapter_id": 4749, "verse_number": "४२", "content_sanskrit": "सोऽहं तद् दुर्लभं चक्रमनवाप्यैव केशव ।\nप्रतियास्यामि गोविन्द शिवेनाभिवदस्व माम्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2177622, "chapter_id": 4749, "verse_number": "४३", "content_sanskrit": "एतत्सुनाभं भोजानामृषभेण त्वया धृतम् ।\nचक्रमप्रतिचक्रेण भुवि नान्योऽभिपद्यते\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2177623, "chapter_id": 4749, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2177624, "chapter_id": 4749, "verse_number": "४४", "content_sanskrit": "एतावदुक्त्वा द्रौणिर्मां युग्यानश्वान् धनानि च ।\nआदायोपययौ काले रत्नानि विविधानि च\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2177625, "chapter_id": 4749, "verse_number": "४५", "content_sanskrit": "स संरब्धो दुरात्मा च चपलः क्रूर एव च ।\nवेद चास्त्रं ब्रह्मशिरस्तस्माद् रक्ष्यो वृकोदरः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2177626, "chapter_id": 4749, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nऐषीकपर्वणि वासुदेववचनं नाम तृतीयोऽध्यायः ॥३॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]