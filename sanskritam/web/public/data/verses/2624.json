[{"id": 2076590, "chapter_id": 2624, "verse_number": "१२-१२९-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2076591, "chapter_id": 2624, "verse_number": "१२-१२९-१", "content_sanskrit": "नामृतस्येव पर्याप्तिर्ममास्ति ब्रुवति त्वयि।\n[यथाहि स्वात्मवृत्तिस्थस्तथा तृप्तोऽस्मि भारत॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2076592, "chapter_id": 2624, "verse_number": "१२-१२९-२", "content_sanskrit": "तस्मात्कथय भूयोऽपि त्वं ममेह पितामह।\n[न हि तृप्तिमहं यामि पिबन्धर्मामृतं हि ते॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2076593, "chapter_id": 2624, "verse_number": "१२-१२९-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2076594, "chapter_id": 2624, "verse_number": "१२-१२९-३", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nगौतमस्य च संवादं यमस्य च महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2076595, "chapter_id": 2624, "verse_number": "१२-१२९-४", "content_sanskrit": "पारियात्रं गिरिं प्राप्य गौतमस्याश्रमो महान्।\nवसते गौतमो यत्र तपसा दग्धकिल्विषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2076596, "chapter_id": 2624, "verse_number": "१२-१२९-५", "content_sanskrit": "पृष्टिं वर्षसहस्राणि सोऽतप्यद्गौतमस्तपः।\nतमुग्रतपसा युक्तं भावितं सुमहामुनिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2076597, "chapter_id": 2624, "verse_number": "१२-१२९-६", "content_sanskrit": "उपयातो नरव्याघ्र लोकपालो यमस्तदा।\nतमपश्यत्सुतपसमृषिं वै गौतमं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2076598, "chapter_id": 2624, "verse_number": "१२-१२९-७", "content_sanskrit": "स तं विदित्वा ब्रह्मर्षियेममागतमोजसा।\nप्राञ्जलिः प्रणतो भूत्वा उपसृप्तस्तपोधनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2076599, "chapter_id": 2624, "verse_number": "१२-१२९-८", "content_sanskrit": "तं धर्मराजो दृष्ट्वैव नमस्कृत्य द्विजोत्तमम्।\nन्यमन्त्रयत धर्मेण क्रियतां किमिति ब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2076600, "chapter_id": 2624, "verse_number": "१२-१२९-९x", "content_sanskrit": "गौतम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2076601, "chapter_id": 2624, "verse_number": "१२-१२९-९", "content_sanskrit": "मातापितृभ्यामानृण्यं किं कृत्वा समवाप्नुयात्।\nकथं च लोकानाप्नोति पुरुषो दुर्लभाञ्शुभान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2076602, "chapter_id": 2624, "verse_number": "१२-१२९-१०x", "content_sanskrit": "यम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2076603, "chapter_id": 2624, "verse_number": "१२-१२९-१०", "content_sanskrit": "तपः शौचवता नित्यं सत्यधर्मरतेन च।\nमातापित्रोरहरहः पूजनं कार्यमञ्जसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2076604, "chapter_id": 2624, "verse_number": "१२-१२९-११", "content_sanskrit": "अश्वमेधैश्च यष्टव्यं बहुभिः स्वाप्तदक्षिणैः।\nतेन लोकानवाप्नोति पुरुषोऽद्भुतदर्शनान्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2076605, "chapter_id": 2624, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि एकोनत्रिंशदधिकशततमोऽध्यायः॥ १२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]