[{"id": 2016220, "chapter_id": 1341, "verse_number": "२-८२-१", "content_sanskrit": "शकुनिरुवाच॥\nयां त्वमेतां श्रियं पाण्डुपुत्रे युधिष्ठिरे।\nतप्यसे तां हरिष्यामि द्यूतेन जयतां वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2016221, "chapter_id": 1341, "verse_number": "२-८२-२", "content_sanskrit": "आहूयतां परं राजन्कुन्तीपुत्रो युधिष्ठिरः।\nअगत्वा संशयमहमयुद्ध्वा च चमूमुखे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2016222, "chapter_id": 1341, "verse_number": "२-८२-३", "content_sanskrit": "अक्षान्क्षिपन्नक्षतः सन्विद्वानविदुषो जये।\nग्लहान्धनूंषि मे विद्धि शरानक्षांश्च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2016223, "chapter_id": 1341, "verse_number": "२-८२-४", "content_sanskrit": "अक्षाणां हृदयं मे ज्यां रथं विद्धि ममास्फुरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2016224, "chapter_id": 1341, "verse_number": "२-८२-५x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2016225, "chapter_id": 1341, "verse_number": "२-८२-५", "content_sanskrit": "अयमुत्सहते राजच्छ्रियमाहर्तुमक्षवित्।\nद्यूतेन पाण्डुपुत्रेभ्यस्तदनुज्ञातुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2016226, "chapter_id": 1341, "verse_number": "२-८२-६x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2016227, "chapter_id": 1341, "verse_number": "२-८२-६", "content_sanskrit": "स्थितोऽस्मि शासने भ्रातुर्विदुरस्य महात्मनः।\nतेन सङ्गम्य वेत्स्यामि कार्यस्यास्य विनिश्चयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2016228, "chapter_id": 1341, "verse_number": "२-८२-७x", "content_sanskrit": "दुर्योधन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2016229, "chapter_id": 1341, "verse_number": "२-८२-७", "content_sanskrit": "कृष्णादभ्याधिकः सोऽपि क्षत्ता बोद्धा विशाम्पते।\nकेवलं धर्ममेवाह न तद्विजयसाधकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2016230, "chapter_id": 1341, "verse_number": "२-८२-८", "content_sanskrit": "जयश्च धर्मतोपेतस्तथैव भरतर्षभ।\nतस्माद्विनयतो जेता तावुभौ च विरोधिनौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2016231, "chapter_id": 1341, "verse_number": "२-८२-९", "content_sanskrit": "व्यपनेष्यति ते बुद्धिं विदुरो मुक्तसंशयः।\nपाण्डवानां हिते युक्तो न तथा मम कौरव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2016232, "chapter_id": 1341, "verse_number": "२-८२-१०", "content_sanskrit": "नारभेतान्यसामर्थ्यात्पुरुषः कार्यमात्मनः।\nमतिसाम्यं द्वयोर्नास्ति कार्येषु कुरुनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2016233, "chapter_id": 1341, "verse_number": "२-८२-११", "content_sanskrit": "भयं परिहरन्मत्त आत्मानं परिपालयन्।\nवर्षासु क्लिन्नवटवत्तिष्ठन्नैवावसीदति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2016234, "chapter_id": 1341, "verse_number": "२-८२-१२", "content_sanskrit": "न व्याधयो नापि यमः प्राप्तुं श्रेयः प्रतीक्षते।\nयावदेव भवेत्कल्पस्तावच्छ्रेयः समाचरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2016235, "chapter_id": 1341, "verse_number": "२-८२-१३x", "content_sanskrit": "धृतराष्ट्र उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2016236, "chapter_id": 1341, "verse_number": "२-८२-१३", "content_sanskrit": "सर्वथा पुत्र बलिभिर्विग्रहो मे रोचते।\nवैरं विकारं सृजति तद्वै शस्त्रमनायसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2016237, "chapter_id": 1341, "verse_number": "२-८२-१४", "content_sanskrit": "अनर्थमर्थं मन्यसे राजपुत्र\nसङ्ग्रन्थनं कलहस्यातियाति।\nतद्वै प्रवृत्तं तु यथाकथञ्चित्\nसृजेदसीन्निशितान्सायकांश्च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2016238, "chapter_id": 1341, "verse_number": "२-८२-१५x", "content_sanskrit": "दुर्योधन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2016239, "chapter_id": 1341, "verse_number": "२-८२-१५", "content_sanskrit": "द्यूते पुराणैर्व्यवहारः प्रणीत-\nस्तत्रात्ययो नास्ति न सम्प्रहारः।\nतद्रोचतां शकुनेर्वाक्यमद्य\nसभां क्षिप्रं त्वमिहाज्ञापयस्व॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2016240, "chapter_id": 1341, "verse_number": "२-८२-१६", "content_sanskrit": "स्वर्गद्वारं दीव्यतां नो विशिष्टं\nतद्वर्तिनां चापि तथैव युक्तम्।\nभवेदेवं ह्यात्मना तुल्यमेव\nदुरोदरं पाण्डवैस्त्वं कुरुष्व॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2016241, "chapter_id": 1341, "verse_number": "२-८२-१७x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2016242, "chapter_id": 1341, "verse_number": "२-८२-१७", "content_sanskrit": "वाक्यं न मे रोचते यत्त्वयोक्तं\nयत्ते प्रियं तत्क्रियतां नरेन्द्र।\nपश्चात्तप्स्यसे तदुपाक्रम्य वाक्यं\nन हीदृशं भावि वचो हि धर्म्यम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2016243, "chapter_id": 1341, "verse_number": "२-८२-१८", "content_sanskrit": "दृष्टं ह्येतद्विदुरेणै सर्वं\nविपश्चिता बुद्धिविद्यानुगेन।\nतदेवैतदवशस्याभ्युपैति\nमहद्भयं क्षत्रियजीवघाति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2016244, "chapter_id": 1341, "verse_number": "२-८२-१९x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2016245, "chapter_id": 1341, "verse_number": "२-८२-१९", "content_sanskrit": "एवमुक्त्वा धृतराष्ट्रो मनीषी\nदैवं मत्वा परमं दुस्तरं च।\nशशासोच्चैः पुरुषान्पुत्रवाक्ये\nस्थितो राजा दैवसंमूढचेताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2016246, "chapter_id": 1341, "verse_number": "२-८२-२०", "content_sanskrit": "सहस्रस्तम्भां हेमवैदूर्यचित्रां\nशतद्वारां तोरणस्फाटिकाढ्याम्।\nसभामग्र्यां क्रोशमात्रायतां मे\nतद्विस्तारामाशु कुर्वन्तु युक्ताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2016247, "chapter_id": 1341, "verse_number": "२-८२-२१", "content_sanskrit": "श्रुत्वा तस्य त्वरिता निर्विशङ्काः\nप्राज्ञा दक्षास्तां तदा चक्रुराशु।\nसर्वद्रव्याण्युपजह्रुः सभायां\nसहस्रशः शिल्पिनश्चैव युक्ताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2016248, "chapter_id": 1341, "verse_number": "२-८२-२२", "content_sanskrit": "कालेनाल्पेनाथ निष्ठां गतां तां\nसभां रम्यां बहुरत्नां विचित्राम्।\nचित्रैर्हैमैरासनैरभ्युपेता-\nमाचख्युस्ते तस्य राज्ञः प्रतीताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2016249, "chapter_id": 1341, "verse_number": "२-८२-२३", "content_sanskrit": "ततो विद्वान्विदुरं मन्त्रिमुख्य-\nमुवाचेदं धृतराष्ट्रो नरेन्द्रः।\nयुधिष्ठिरं राजपुत्रं च गत्वा\nमद्वाक्येन क्षिप्रमिहानयस्व॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2016250, "chapter_id": 1341, "verse_number": "२-८२-२४", "content_sanskrit": "सभेयं मे बहुरत्ना विचित्रा\nशय्यासनैरुपपन्ना महार्हैः।\nसा दृश्यतां भ्रातृभिः सार्धमेत्य\nमुहृद्द्यूतं वर्ततामत्र चेति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2016251, "chapter_id": 1341, "verse_number": "२-८२-२५x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2016252, "chapter_id": 1341, "verse_number": "२-८२-२५", "content_sanskrit": "मतमाज्ञाय पुत्रस्य धृतराष्ट्रो नराधिपः।\nमत्वा च दुस्तरं दैवमेतद्राजंश्चकार ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2016253, "chapter_id": 1341, "verse_number": "२-८२-२६", "content_sanskrit": "अन्यायेन तथोक्तस्तु विदुरो विदुषां वरः।\nनाभ्यनन्दद्वचो भ्रातुर्वचनं चेदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2016254, "chapter_id": 1341, "verse_number": "२-८२-२७x", "content_sanskrit": "विदुर उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2016255, "chapter_id": 1341, "verse_number": "२-८२-२७", "content_sanskrit": "नाभिनन्दे नृपते प्रैषमेतं\nमैवं कृथाः कुलनाशाद्बिभेमि।\nपुत्रैर्भिन्नः कलहस्ते ध्रुवं स्या-\nदेतच्छङ्के द्यूतकृते नरेन्द्र॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2016256, "chapter_id": 1341, "verse_number": "२-८२-२८x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2016257, "chapter_id": 1341, "verse_number": "२-८२-२८", "content_sanskrit": "नेह क्षत्तः कलहस्तप्स्यते मां\nन चेद्दैवं प्रतिलोमं भविष्यत्।\nछात्रा तु दिष्टस्य वशे किलेदं\nसर्वं जगच्चेष्टति न स्वतन्त्रम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2016258, "chapter_id": 1341, "verse_number": "२-८२-२९", "content_sanskrit": "तदद्य विदुर प्राप्य राजानं मम शासनात्।\nक्षिप्रमानय दुर्धर्षं कुन्तीपुत्रं युधिष्ठिरम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2016259, "chapter_id": 1341, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि द्यूतपर्वणि द्व्यशीतितमोऽध्यायः॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]