[{"id": 2001024, "chapter_id": 1007, "verse_number": "१-८-०x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2001025, "chapter_id": 1007, "verse_number": "१-८-१", "content_sanskrit": "स चापि च्यवनो ब्रह्मन्भार्गवोऽजनयत्सुतम्।\nसुकन्यायां महात्मानं प्रमतिं दीप्ततेजसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2001026, "chapter_id": 1007, "verse_number": "१-८-२", "content_sanskrit": "प्रमतिस्तु रुरुं नाम घृताच्यां समजीजनत्।\nरुरुः प्रमद्वरायां तु शुनकं समजीजनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2001027, "chapter_id": 1007, "verse_number": "१-८-३", "content_sanskrit": "शुनकस्तु महासत्वः सर्वभार्गवनन्दनः।\nजातस्तपसि तीव्रे च स्थितः स्थिरयशास्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2001028, "chapter_id": 1007, "verse_number": "१-८-४", "content_sanskrit": "तस्य ब्रह्मन्रुरोः सर्वं चरितं भूरितेजसः।\nविस्तरेण प्रवक्ष्यामि तच्छृणु त्वमशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2001029, "chapter_id": 1007, "verse_number": "१-८-५", "content_sanskrit": "ऋषिरासीन्महान्पूर्वं तपोविद्यासमन्वितः।\nस्थूलकेश इति ख्यातः सर्वभूतहिते रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2001030, "chapter_id": 1007, "verse_number": "१-८-६", "content_sanskrit": "एतस्मिन्नेव काले तु मेनकायां प्रजज्ञिवान्।\nगन्धर्वराजो विप्रर्षे विश्वावसुरिति स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2001031, "chapter_id": 1007, "verse_number": "१-८-७", "content_sanskrit": "अप्सरा मेनका तस्य तं गर्भं भृगुनन्दन।\nउत्ससर्ज यथाकालं स्थूलकेशाश्रमं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2001032, "chapter_id": 1007, "verse_number": "१-८-८", "content_sanskrit": "उत्सृज्य चैव तं गर्भं नद्यास्तीरे जगाम सा।\nअप्सरा मेनका ब्रह्मन्निर्दया निरपत्रपा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2001033, "chapter_id": 1007, "verse_number": "१-८-९", "content_sanskrit": "कन्याममरगर्भाभां ज्वलन्तीमिव च श्रिया।\nतां ददर्श समुत्सृष्टां नदीतीरे महानृषिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2001034, "chapter_id": 1007, "verse_number": "१-८-१०", "content_sanskrit": "स्थूलकेशः स तेजस्वी विजने बन्धुवर्जिताम्।\nस तां दृष्ट्वा तदा कन्यां स्थूलकेशो महाद्विजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2001035, "chapter_id": 1007, "verse_number": "१-८-११", "content_sanskrit": "जग्राह च मुनिश्रेष्ठः कृपाविष्टः पुपोष च।\nववृधे सा वरारोहा तस्याश्रमपदे शुभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2001036, "chapter_id": 1007, "verse_number": "१-८-१२", "content_sanskrit": "जातकाद्याः क्रियाश्चास्या विधिपूर्वं यथाक्रमम्।\nस्थूलकेशो महाभागश्चकार सुमहानृषिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2001037, "chapter_id": 1007, "verse_number": "१-८-१३", "content_sanskrit": "प्रमदाभ्यो वरा सा तु सत्त्वरूपगुणान्विता।\nततः प्रमद्वरेत्यस्या नाम चक्रे महानृषिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2001038, "chapter_id": 1007, "verse_number": "१-८-१४", "content_sanskrit": "तामाश्रमपदे तस्य रुरुर्दृष्ट्वा प्रमद्वराम्।\nबभूव किल धर्मात्मा मदनोपहतस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2001039, "chapter_id": 1007, "verse_number": "१-८-१५", "content_sanskrit": "पितरं सखिभिः सोऽथ श्रावयामास भार्गवम्।\nप्रमतिश्चाभ्ययाचत्तां स्थूलकेशं यशस्विनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2001040, "chapter_id": 1007, "verse_number": "१-८-१६", "content_sanskrit": "ततः प्रादात्पिता कन्यां रुरवे तां प्रमद्वराम्।\nविवाहं स्थापयित्वाग्रे नक्षत्रे भगदैवते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2001041, "chapter_id": 1007, "verse_number": "१-८-१७", "content_sanskrit": "ततः कतिपयाहस्य विवाहे समुपस्थिते।\nसखीभिः क्रीडती सार्धं सा कन्यावरवर्णिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2001042, "chapter_id": 1007, "verse_number": "१-८-१८", "content_sanskrit": "नापश्यत्संप्रसुप्तं वै भुजंगं तिर्यगायतम्।\nपदा चैनं समाक्रामन्मुमूर्षुः कालचोदिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2001043, "chapter_id": 1007, "verse_number": "१-८-१९", "content_sanskrit": "स तस्याः संप्रमत्तायाश्चोदितः कालधर्मणा।\nविषोपलिप्तान्दशनान्भृशमङ्गे न्यपातयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2001044, "chapter_id": 1007, "verse_number": "१-८-२०", "content_sanskrit": "सा दष्टा तेन सर्पेण पपात सहसा भुवि।\nविवर्णा विगतश्रीका भ्रष्टाभरणचेतना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2001045, "chapter_id": 1007, "verse_number": "१-८-२१", "content_sanskrit": "निरानन्दकरी तेषां बन्धूनां मुक्तमूर्धजा।\nव्यसुरप्रेक्षणीया सा प्रेक्षणीयतमाऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2001046, "chapter_id": 1007, "verse_number": "१-८-२२", "content_sanskrit": "प्रसुप्तेवाभवच्चापि भुवि सर्पविषार्दिता।\nभूयो मनोहरतरा बभूव तनुमध्यमा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2001047, "chapter_id": 1007, "verse_number": "१-८-२३", "content_sanskrit": "ददर्श तां पिता चैव ये चैवान्ये तपस्विनः।\nविचेष्टमानां पतितां भूतले पद्मवर्चसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2001048, "chapter_id": 1007, "verse_number": "१-८-२४", "content_sanskrit": "ततः सर्वे द्विजतराः समाजग्मुः कृपान्विताः।\nस्वस्त्यात्रेयो महाजानुः कुशिकः शङ्खमेखलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2001049, "chapter_id": 1007, "verse_number": "१-८-२५", "content_sanskrit": "उद्दालकः कठश्चैव श्वेतश्चैव महायशाः।\nभरद्वाजः कौणकृत्स्य आर्ष्टिषेणोऽथ गौतमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2001050, "chapter_id": 1007, "verse_number": "१-८-२६", "content_sanskrit": "प्रमतिः सह पुत्रेण तथान्ये वनवासिनः।\nतां ते कन्यां व्यसुं दृष्ट्वा भुजंगस्य विषार्दिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2001051, "chapter_id": 1007, "verse_number": "१-८-२७", "content_sanskrit": "रुरुदुः कृपयाऽविष्टा रुरुस्त्वार्तो बहिर्ययौ।\nते च सर्वे द्विजश्रेष्ठास्तत्रैवोपाविशंस्तदा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2001052, "chapter_id": 1007, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि पौलोमपर्वणि अष्टमोऽध्यायः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]