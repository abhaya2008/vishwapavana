[{"id": 2121774, "chapter_id": 3610, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2121775, "chapter_id": 3610, "verse_number": "१", "content_sanskrit": "एवं तच्छिल्पिवर्येण विहितं विश्वकर्मणा ।\nप्रविशन्नेव गोविन्दो ददर्श परितो मुहुः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2121776, "chapter_id": 3610, "verse_number": "२", "content_sanskrit": "मुमुदे विश्वकर्माणं प्राञ्जलिं प्रणताननम् ।\nइन्द्रः सहामरैः श्रीमांन् तत्र तत्र विलोकयन् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2121777, "chapter_id": 3610, "verse_number": "३", "content_sanskrit": "एवमालोकयाञ्चक्रुर्द्वारकामृषभास्त्रयः ।\nउपेन्द्रबलदेवौ च वासवश्च महायशाः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2121778, "chapter_id": 3610, "verse_number": "४", "content_sanskrit": "ततस्तं पाण्डरं शौरिर्मूर्ध्नि तिष्ठन् गरुत्मतः ।\nप्रीतः शङ्खमुपाध्मासीद् विद्विषां रोमहर्षणम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2121779, "chapter_id": 3610, "verse_number": "५", "content_sanskrit": "तस्य शङ्खस्य शब्देन सागरश्चुक्षुभे भृशम् ।\nररास च नभः सर्वं तच्चित्रमभवत् तदा ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2121780, "chapter_id": 3610, "verse_number": "६", "content_sanskrit": "पाञ्चजन्यस्य निर्घोषं निशम्य कुकुरान्धकाः ।\nविशोकाः समपद्यन्त गरुडस्य च दर्शनात् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2121781, "chapter_id": 3610, "verse_number": "७", "content_sanskrit": "शङ्खचक्रगदापाणिं सुपर्णस्योपरि स्थितम् ।\nदृष्ट्वा जहृषिरे भौमा भास्करोदयतेजसम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2121782, "chapter_id": 3610, "verse_number": "८", "content_sanskrit": "ततस्तूर्यप्रणादश्च भेरीणां च महास्वनः ।\nसिंहनादश्च सञ्जज्ञे सर्वेषां पुरवासिनाम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2121783, "chapter_id": 3610, "verse_number": "१०", "content_sanskrit": "ततस्ते सर्वदाशार्हाः सर्वे च कुकुरान्धकाः ।\nप्रीयमाणाः समाजग्मुरालोक्य मधुसूदनम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2121784, "chapter_id": 3610, "verse_number": "११", "content_sanskrit": "वसुदेवं पुरस्कृत्य वेणुशङ्खरवैः सह ।\nउग्रसेनो ययौ राजा वासुदेवनिवेशनात् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2121785, "chapter_id": 3610, "verse_number": "१२", "content_sanskrit": "आनन्दितं पर्यचरन् स्वेषु वेश्मसु देवकी ।\nरोहिणी च ययौ देशमाहुकस्य च याः स्त्रियः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2121786, "chapter_id": 3610, "verse_number": "१३", "content_sanskrit": "हता ब्रह्मद्विषः सर्वे जयन्त्यन्धकवृष्णयः ।\nएवमुक्तः सह स्त्रीभिरक्षतैर्मधुसूदनः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2121787, "chapter_id": 3610, "verse_number": "१४", "content_sanskrit": "ततः शौरिः सुपर्णेन स्वं निवेशनमभ्ययात् ।\nचकाराथ यथोद्देशमीश्वरो मणिपर्वतम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2121788, "chapter_id": 3610, "verse_number": "१५", "content_sanskrit": "ततो धनानि रत्नानि सत्यां च मधुसूदनः ।\nनिधाय पुण्डरीकाक्षः पितुर्दर्शनलालसः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2121789, "chapter_id": 3610, "verse_number": "१६", "content_sanskrit": "ततः सान्दीपिनं पूर्वं ब्रह्माचार्यं च भारत ।\nववन्दे पृथुताम्राक्षः प्रीयमाणो महामनाः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2121790, "chapter_id": 3610, "verse_number": "१७", "content_sanskrit": "तथाऽश्रुपरिपूर्णाक्षमानन्दागतचेतसा ।\nववन्दे सह रामेण पितरं वासवानुजः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2121791, "chapter_id": 3610, "verse_number": "१८", "content_sanskrit": "यथाश्रेष्ठमुपागम्य सात्वतान् यदुनन्दनः ।\nसर्वेषां नाम जग्राह दाशार्हाणां मधुक्षयः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2121792, "chapter_id": 3610, "verse_number": "१९", "content_sanskrit": "ततः सर्वाणि वित्तानि सर्वरत्नमयानि च ।\nव्यभजत् तानि तेभ्योऽथ सर्वेभ्यो यदुनन्दनः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2121793, "chapter_id": 3610, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nसभापर्वणि द्विपञ्चाशोऽध्यायः ॥५२॥\n॥ अर्घाभिहरणपर्वणि एकविंशोऽध्यायः ॥२१॥\n—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]