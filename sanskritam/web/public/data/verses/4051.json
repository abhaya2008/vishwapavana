[{"id": 2141495, "chapter_id": 4051, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2141496, "chapter_id": 4051, "verse_number": "१", "content_sanskrit": "तं पार्थः प्रतिजग्राह वायुवेगमिवोद्धतः ।\nशरजालेन महता वर्षमाण इवाम्बुदः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2141497, "chapter_id": 4051, "verse_number": "२", "content_sanskrit": "तयोर्देवासुरसमः सन्निपातो महानभूत् ।\nकिरतोः शरजालानि वृत्रवासवयोरिव\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2141498, "chapter_id": 4051, "verse_number": "३", "content_sanskrit": "न स्म सूर्यस्तदा भाति न च वाति समीरणः ।\nशरजाले कृते व्योम्नि छायाभूतमिवाभवत्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2141499, "chapter_id": 4051, "verse_number": "४", "content_sanskrit": "महांश्चटचटाशब्दो योधयोर्युध्यमानयोः ।\nदह्यतामिव वेणूनामासीत् परमदारुणः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2141500, "chapter_id": 4051, "verse_number": "५", "content_sanskrit": "हयांस्तस्यार्जुनः सङ्खे कृतवानल्पचेतसः ।\nते राजन्न प्रजानन्ति दिशं काञ्चन मोहिताः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2141501, "chapter_id": 4051, "verse_number": "६", "content_sanskrit": "ततो द्रौणिर्महावीर्यः पार्थस्य विचरिष्यतः ।\nविवरं सूक्ष्ममालोक्य ज्यां नुनोद क्षुरेण च\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2141502, "chapter_id": 4051, "verse_number": "७", "content_sanskrit": "तदस्यापूजयन् देवाः कर्म दृष्ट्वाऽतिमानुषम् ।\nन शक्तोऽन्यः पुमान् स्थातुम् ऋते द्रौणेर्धनञ्जयम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2141503, "chapter_id": 4051, "verse_number": "८", "content_sanskrit": "ततो द्रौणिर्धनूंष्यष्टौ व्यतिक्रम्य नरर्षभः ।\nपुनरभ्यहनत् पार्थं हृदये कङ्कपत्रिभिः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2141504, "chapter_id": 4051, "verse_number": "९", "content_sanskrit": "ततः पार्थो महाबाहुः प्रहसन् स्वनवत् तदा ।\nयोजयामास च तदा मौर्व्या गाण्डीवमोजसा\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2141505, "chapter_id": 4051, "verse_number": "१०", "content_sanskrit": "तं दृष्ट्वा क्रुद्धमायान्तं प्रभिन्नमिव कुञ्जरम् ।\nक्रुद्धः समाह्वयामास द्रौणिर्युद्धाय भारत\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2141506, "chapter_id": 4051, "verse_number": "११", "content_sanskrit": "ततोऽर्धचन्द्रमाहृत्य तेन पार्थः समाहतः ।\nवारणेनेव मत्तेन मत्तो वारणयूथपः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2141507, "chapter_id": 4051, "verse_number": "१२", "content_sanskrit": "ततः प्रववृते युद्धं पृथिव्यामेकवीरयोः ।\nरणमध्ये तयोरासीत् सुमहद्रोमहर्षणम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2141508, "chapter_id": 4051, "verse_number": "१३", "content_sanskrit": "तौ वीरौ कुरवः सर्वे ददृशुर्विस्मयान्विताः ।\nयुध्यमानौ महात्मानौ द्विरदाविव सङ्गतौ\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2141509, "chapter_id": 4051, "verse_number": "१४", "content_sanskrit": "तौ समाजघ्नतुर्वीरौ परस्परममर्षणौ ।\nशरैराशीविषाकारैर्ज्वलद्भिरिव पावकैः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2141510, "chapter_id": 4051, "verse_number": "१५", "content_sanskrit": "अक्षय्याविषुधी दिव्यौ पाण्डवस्य महात्मनः ।\nतेन पार्थो रणे शूरस्तस्थौ गिरिरिवाचलः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2141511, "chapter_id": 4051, "verse_number": "१६", "content_sanskrit": "अश्वत्थाम्नः पुनर्बाणाः क्षिप्रमभ्यस्यतो रणे ।\nजग्मुः परिक्षयं शीघ्रमभूत् तेनाधिकोऽर्जुनः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2141512, "chapter_id": 4051, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां विराटपर्वणि एकोनषष्टितमोऽध्यायः ॥५९॥\nगोग्रहणपर्वणि द्वात्रिंशोऽध्यायः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]