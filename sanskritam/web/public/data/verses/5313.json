[{"id": 2202634, "chapter_id": 5313, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2202635, "chapter_id": 5313, "verse_number": "१", "content_sanskrit": "अहिंसा वैदिकं कर्म ध्यानमिन्द्रियसंयमः ।\nतपोऽथ गुरुशुश्रूषा किं श्रेयः पुरुषं प्रति\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2202636, "chapter_id": 5313, "verse_number": "", "content_sanskrit": "बृहस्पतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2202637, "chapter_id": 5313, "verse_number": "२", "content_sanskrit": "सर्वाण्येतानि धर्मस्य पृथग्द्वाराणि सर्वशः ।\nशृणु सङ्कीर्त्यमानानि षडेव भरतर्षभ\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2202638, "chapter_id": 5313, "verse_number": "३", "content_sanskrit": "हन्त निश्रेयसं जन्तोरहं वक्ष्याम्यनुत्तमम् ।\nअहिंसापाश्रयं धर्मं यः साधयति वै नरः\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2202639, "chapter_id": 5313, "verse_number": "४", "content_sanskrit": "त्रीन् दोषान् सर्वभूतेषु निधाय पुरुषः सदा ।\nकामक्रोधौ च संयम्य ततः सिद्धिमुपाश्नुते\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2202640, "chapter_id": 5313, "verse_number": "५", "content_sanskrit": "अहिंसकानि भूतानि दण्डेन विनिहन्ति यः ।\nआत्मनः सुखमन्विच्छन् न स प्रेत्य सुखी भवेत्\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2202641, "chapter_id": 5313, "verse_number": "६", "content_sanskrit": "आत्मोपमश्च भूतेषु यो वै भवति पूरुषः ।\nन्यस्तदण्डो जितक्रोधः स प्रेत्य सुखमेधते\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2202642, "chapter_id": 5313, "verse_number": "७", "content_sanskrit": "सर्वभूतात्मभूतस्य सर्वभूतानि पश्यतः ।\nदेवापि मार्गे मुह्यन्ति अपदस्य पदैषिणः\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2202643, "chapter_id": 5313, "verse_number": "८", "content_sanskrit": "न तत् परस्य सन्दद्यात् प्रतिकूलं यदात्मनः ।\nएष सङ्क्षेपतो धर्मः कामादन्यः प्रवर्तते\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2202644, "chapter_id": 5313, "verse_number": "९", "content_sanskrit": "प्रत्याख्याने च दाने च सुखदुःखे प्रियाप्रिये ।\nआत्मौपम्येन पुरुषः समाधिमधिगच्छति\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2202645, "chapter_id": 5313, "verse_number": "१०", "content_sanskrit": "यथा परः प्रक्रमतेऽपरेषु\nतथाऽपरः प्रक्रमते परस्मिन् ।\nएषैव तेऽस्तूपमा जीवलोके\nयथा धर्मो निपुणेनोपदिष्टः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2202646, "chapter_id": 5313, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2202647, "chapter_id": 5313, "verse_number": "११", "content_sanskrit": "इत्युक्त्वा तं सुरगुरुर्धर्मराजं युधिष्ठिरम् ।\nदिवमाचक्रमे धीमान् सर्वेषामेव पश्यताम्\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2202648, "chapter_id": 5313, "verse_number": "", "content_sanskrit": "॥इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे अहिंसादीनां श्रेयस्त्वकथनं नाम चतुःषष्ट्युत्तरशततमोऽध्यायः ॥१६४॥\n॥ इति युधिष्ठिरबृहस्पतिसंवादः समाप्तः ॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]