[{"id": 5000449000, "chapter_id": 9449, "verse_number": "६-४२-१", "content_sanskrit": "ततस्ते राक्षसास्तत्र गत्वा रावणमन्दिरम्।\nन्यवेदयन् पुरीं रुद्धां रामेण सह वानरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000449001, "chapter_id": 9449, "verse_number": "६-४२-२", "content_sanskrit": "रुद्धां तु नगरीं श्रुत्वा जातक्रोधो निशाचरः।\nविधानं द्विगुणं कृत्वा प्रासादं चाप्यरोहत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000449002, "chapter_id": 9449, "verse_number": "६-४२-३", "content_sanskrit": "स ददर्श वृतां लङ्कां सशैलवनकाननाम्।\nअसंख्येयैर्हरिगणैः सर्वतो युद्धकाङ्क्षिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000449003, "chapter_id": 9449, "verse_number": "६-४२-४", "content_sanskrit": "स दृष्ट्वा वानरैः सर्वैर्वसुधां कपिलीकृताम्।\nकथं क्षपयितव्याः स्युरिति चिन्तापरोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000449004, "chapter_id": 9449, "verse_number": "६-४२-५", "content_sanskrit": "स चिन्तयित्वा सुचिरं धैर्यमालम्ब्य रावणः।\nराघवं हरियूथांश्च ददर्शायतलोचनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000449005, "chapter_id": 9449, "verse_number": "६-४२-६", "content_sanskrit": "राघवः सह सैन्येन मुदितो नाम पुप्लुवे।\nलङ्कां ददर्श गुप्तां वै सर्वतो राक्षसैर्वृताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000449006, "chapter_id": 9449, "verse_number": "६-४२-७", "content_sanskrit": "दृष्ट्वा दाशरथिर्लङ्कां चित्रध्वजपताकिनीम्।\nजगाम सहसा सीतां दूयमानेन चेतसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000449007, "chapter_id": 9449, "verse_number": "६-४२-८", "content_sanskrit": "अत्र सा मृगशावाक्षी मत्कृते जनकात्मजा।\nपीड्यते शोकसंतप्ता कृशा स्थण्डिलशायिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000449008, "chapter_id": 9449, "verse_number": "६-४२-९", "content_sanskrit": "निपीड्यमानां धर्मात्मा वैदेहीमनुचिन्तयन्।\nक्षिप्रमाज्ञापयद् रामो वानरान् द्विषतां वधे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000449009, "chapter_id": 9449, "verse_number": "६-४२-१०", "content_sanskrit": "एवमुक्ते तु वचसि रामेणाक्लिष्टकर्मणा।\nसंघर्षमाणाः प्लवगाः सिंहनादैरनादयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000449010, "chapter_id": 9449, "verse_number": "६-४२-११", "content_sanskrit": "शिखरैर्विकिरामैतां लङ्कां मुष्टिभिरेव वा।\nइति स्म दधिरे सर्वे मनांसि हरियूथपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000449011, "chapter_id": 9449, "verse_number": "६-४२-१२", "content_sanskrit": "उद्यम्य गिरिशृङ्गाणि महान्ति शिखराणि च।\nतरूंश्चोत्पाट्य विविधांस्तिष्ठन्ति हरियूथपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000449012, "chapter_id": 9449, "verse_number": "६-४२-१३", "content_sanskrit": "प्रेक्षतो राक्षसेन्द्रस्य तान्यनीकानि भागशः।\nराघवप्रियकामार्थं लङ्कामारुरुहुस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000449013, "chapter_id": 9449, "verse_number": "६-४२-१४", "content_sanskrit": "ते ताम्रवक्त्रा हेमाभा रामार्थे त्यक्तजीविताः।\nलङ्कामेवाभ्यवर्तन्त सालभूधरयोधिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000449014, "chapter_id": 9449, "verse_number": "६-४२-१५", "content_sanskrit": "ते द्रुमैः पर्वताग्रैश्च मुष्टिभिश्च प्लवंगमाः।\nप्राकाराग्राण्यसंख्यानि ममन्थुस्तोरणानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000449015, "chapter_id": 9449, "verse_number": "६-४२-१६", "content_sanskrit": "परिखान् पूरयन्तश्च प्रसन्नसलिलाशयान्।\nपांसुभिः पर्वताग्रैश्च तृणैः काष्ठैश्च वानराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000449016, "chapter_id": 9449, "verse_number": "६-४२-१७", "content_sanskrit": "ततः सहस्रयूथाश्च कोटियूथाश्च यूथपाः।\nकोटियूथशताश्चान्ये लङ्कामारुरुहुस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000449017, "chapter_id": 9449, "verse_number": "६-४२-१८", "content_sanskrit": "काञ्चनानि प्रमर्दन्तस्तोरणानि प्लवंगमाः।\nकैलासशिखराग्राणि गोपुराणि प्रमथ्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000449018, "chapter_id": 9449, "verse_number": "६-४२-१९", "content_sanskrit": "आप्लवन्तः प्लवन्तश्च गर्जन्तश्च प्लवंगमाः।\nलङ्कां तामभिधावन्ति महावारणसंनिभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000449019, "chapter_id": 9449, "verse_number": "६-४२-२०", "content_sanskrit": "जयत्युरुबलो रामो लक्ष्मणश्च महाबलः।\nराजा जयति सुग्रीवो राघवेणाभिपालितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000449020, "chapter_id": 9449, "verse_number": "६-४२-२१", "content_sanskrit": "इत्येवं घोषयन्तश्च गर्जन्तश्च प्लवंगमाः।\nअभ्यधावन्त लङ्कायाः प्राकारं कामरूपिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000449021, "chapter_id": 9449, "verse_number": "६-४२-२२", "content_sanskrit": "वीरबाहुः सुबाहुश्च नलश्च पनसस्तथा।\nनिपीड्योपनिविष्टास्ते प्राकारं हरियूथपाः।\nएतस्मिन्नन्तरे चक्रुः स्कन्धावारनिवेशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000449022, "chapter_id": 9449, "verse_number": "६-४२-२३", "content_sanskrit": "पूर्वद्वारं तु कुमुदः कोटिभिर्दशभिर्वृतः।\nआवृत्य बलवांस्तस्थौ हरिभिर्जितकाशिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000449023, "chapter_id": 9449, "verse_number": "६-४२-२४", "content_sanskrit": "सहायार्थे तु तस्यैव निविष्टः प्रघसो हरिः।\nपनसश्च महाबाहुर्वानरैरभिसंवृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000449024, "chapter_id": 9449, "verse_number": "६-४२-२५", "content_sanskrit": "दक्षिणद्वारमासाद्य वीरः शतबलिः कपिः।\nआवृत्य बलवांस्तस्थौ विंशत्या कोटिभिर्वृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000449025, "chapter_id": 9449, "verse_number": "६-४२-२६", "content_sanskrit": "सुषेणः पश्चिमद्वारं गत्वा तारापिता बली।\nआवृत्य बलवांस्तस्थौ कोटिकोटिभिरावृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000449026, "chapter_id": 9449, "verse_number": "६-४२-२७", "content_sanskrit": "उत्तरद्वारमागम्य रामः सौमित्रिणा सह।\nआवृत्य बलवांस्तस्थौ सुग्रीवश्च हरीश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000449027, "chapter_id": 9449, "verse_number": "६-४२-२८", "content_sanskrit": "गोलाङ्गूलो महाकायो गवाक्षो भीमदर्शना।\nवृतः कोट्या महावीर्यस्तस्थौ रामस्य पार्श्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000449028, "chapter_id": 9449, "verse_number": "६-४२-२९", "content_sanskrit": "ऋक्षाणां भीमकोपानां धूम्रः शत्रुनिबर्हणः।\nवृतः कोट्या महावीर्यस्तस्थौ रामस्य पार्श्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000449029, "chapter_id": 9449, "verse_number": "६-४२-३०", "content_sanskrit": "संनद्धस्तु महावीर्यो गदापाणिर्विभीषणः।\nवृतो यत्तैस्तु सचिवैस्तस्थौ यत्र महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000449030, "chapter_id": 9449, "verse_number": "६-४२-३१", "content_sanskrit": "गजो गवाक्षो गवयः शरभो गन्धमादनः।\nसमन्तात् परिधावन्तो ररक्षुर्हरिवाहिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000449031, "chapter_id": 9449, "verse_number": "६-४२-३२", "content_sanskrit": "ततः कोपपरीतात्मा रावणो राक्षसेश्वरः।\nनिर्याणं सर्वसैन्यानां द्रुतमाज्ञापयत् तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000449032, "chapter_id": 9449, "verse_number": "६-४२-३३", "content_sanskrit": "एतच्छ्रुत्वा तदा वाक्यं रावणस्य मुखेरितम्।\nसहसा भीमनिर्घोषमुद‍्घुष्टं रजनीचरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000449033, "chapter_id": 9449, "verse_number": "६-४२-३४", "content_sanskrit": "ततः प्रबोधिता भेर्यश्चन्द्रपाण्डुरपुष्कराः।\nहेमकोणैरभिहता राक्षसानां समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000449034, "chapter_id": 9449, "verse_number": "६-४२-३५", "content_sanskrit": "विनेदुश्च महाघोषाः शङ्खाः शतसहस्रशः।\nराक्षसानां सुघोराणां मुखमारुतपूरिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000449035, "chapter_id": 9449, "verse_number": "६-४२-३६", "content_sanskrit": "ते बभुः शुभनीलाङ्गाः सशङ्खा रजनीचराः।\nविद्युन्मण्डलसंनद्धाः सबलाका इवाम्बुदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000449036, "chapter_id": 9449, "verse_number": "६-४२-३७", "content_sanskrit": "निष्पतन्ति ततः सैन्या हृष्टा रावणचोदिताः।\nसमये पूर्यमाणस्य वेगा इव महोदधेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000449037, "chapter_id": 9449, "verse_number": "६-४२-३८", "content_sanskrit": "ततो वानरसैन्येन मुक्तो नादः समन्ततः।\nमलयः पूरितो येन ससानुप्रस्थकन्दरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000449038, "chapter_id": 9449, "verse_number": "६-४२-३९", "content_sanskrit": "शङ्खदुन्दुभिनिर्घोषः सिंहनादस्तरस्विनाम्।\nपृथिवीं चान्तरिक्षं च सागरं चाभ्यनादयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000449039, "chapter_id": 9449, "verse_number": "६-४२-४०", "content_sanskrit": "गजानां बृंहितैः सार्धं हयानां ह्रेषितैरपि।\nरथानां नेमिनिर्घोषै रक्षसां वदनस्वनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000449040, "chapter_id": 9449, "verse_number": "६-४२-४१", "content_sanskrit": "एतस्मिन्नन्तरे घोरः संग्रामः समपद्यत।\nरक्षसां वानराणां च यथा देवासुरे पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000449041, "chapter_id": 9449, "verse_number": "६-४२-४२", "content_sanskrit": "ते गदाभिः प्रदीप्ताभिः शक्तिशूलपरश्वधैः।\nनिजघ्नुर्वानरान् सर्वान् कथयन्तः स्वविक्रमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000449042, "chapter_id": 9449, "verse_number": "६-४२-४३", "content_sanskrit": "तथा वृक्षैर्महाकायाः पर्वताग्रैश्च वानराः।\nनिजघ्नुस्तानि रक्षांसि नखैर्दन्तैश्च वेगिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000449043, "chapter_id": 9449, "verse_number": "६-४२-४४", "content_sanskrit": "राजा जयति सुग्रीव इति शब्दो महानभूत्।\nराजञ्जयजयेत्युक्त्वा स्वस्वनामकथां ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000449044, "chapter_id": 9449, "verse_number": "६-४२-४५", "content_sanskrit": "राक्षसास्त्वपरे भीमाः प्राकारस्था महीं गतान्।\nवानरान् भिन्दिपालैश्च शूलैश्चैव व्यदारयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000449045, "chapter_id": 9449, "verse_number": "६-४२-४६", "content_sanskrit": "वानराश्चापि संक्रुद्धाः प्राकारस्थान् महीं गताः।\nराक्षसान् पातयामासुः खमाप्लुत्य स्वबाहुभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000449046, "chapter_id": 9449, "verse_number": "६-४२-४७", "content_sanskrit": "स सम्प्रहारस्तुमुलो मांसशोणितकर्दमः।\nरक्षसां वानराणां च सम्बभूवाद्भुतोपमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000449047, "chapter_id": 9449, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमद्युद्धकाण्डे द्विचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]