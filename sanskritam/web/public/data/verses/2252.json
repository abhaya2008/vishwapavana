[{"id": 2057893, "chapter_id": 2252, "verse_number": "७-१७९-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2057894, "chapter_id": 2252, "verse_number": "७-१७९-१", "content_sanskrit": "संदृश्य समरे भीमं रक्षसा ग्रस्तमन्तिकात्।\nवासुदेवोऽव्रवीद्राजन्घटोत्कचमिदं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2057895, "chapter_id": 2252, "verse_number": "७-१७९-२", "content_sanskrit": "पश्य भीमं महाबाहो रक्षसा ग्रस्तमाहवे।\nपश्यतां सर्वसैन्यानां तव चैव महाद्युते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2057896, "chapter_id": 2252, "verse_number": "७-१७९-३", "content_sanskrit": "स कर्णं त्वं समुत्सृज्य राक्षसेन्द्रमलायुधम्।\nजहि क्षिप्रं महाबाहो पश्चात्कर्णं बधिष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2057897, "chapter_id": 2252, "verse_number": "७-१७९-४", "content_sanskrit": "स वार्ष्णेयवचः श्रुत्वा कर्णमुत्सृज्य वीर्यवान्।\nयुयुधे राक्षसेन्द्रेण बकभ्रात्रा घटोत्कचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2057898, "chapter_id": 2252, "verse_number": "७-१७९-५", "content_sanskrit": "तयोः सुतुमुलं युद्धं बभूव निशि रक्षसोः।\nअलायुधस्य चैवोग्रं हेडिम्बेश्चापि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2057899, "chapter_id": 2252, "verse_number": "७-१७९-६", "content_sanskrit": "अलायुधस्य योधांश्च राक्षसान्भीमदर्शनान्।\nवेगेनापततः शूरान्प्रगृहीतशरासनान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2057900, "chapter_id": 2252, "verse_number": "७-१७९-७", "content_sanskrit": "आत्तायुधः सुसङ्क्रुद्धो युयुधानो महारथः।\nनकुलः सहदेवश्च चिच्छिदुर्निशितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2057901, "chapter_id": 2252, "verse_number": "७-१७९-८", "content_sanskrit": "सर्वांश्च समरे राजन्किरीटी क्षत्रियर्षभान्।\nपरिचिक्षेप बीभत्सुः सर्वतः प्रकिरञ्छरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2057902, "chapter_id": 2252, "verse_number": "७-१७९-९", "content_sanskrit": "कर्णश्च समरे राजन्व्यद्रावयत पार्थिवान्।\nधृष्टद्युम्नशिखण्ड्यादीन्पाञ्चालानां पहारथान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2057903, "chapter_id": 2252, "verse_number": "७-१७९-१०", "content_sanskrit": "तान्वध्यमानान्दृष्ट्वाऽथ भीमो भीमपराक्रमः।\nअभ्ययात्त्वरितः कर्णं विशिखान्प्रकिरन्रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2057904, "chapter_id": 2252, "verse_number": "७-१७९-११", "content_sanskrit": "ततस्तेऽप्याययुर्हत्वा राक्षसान्यत्र सूतजः।\nनकुलः सहदेवश्च सात्यकिश्च महारथः।\nते कर्णे योधयामासुः पाञ्चाला द्रोणमेव तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2057905, "chapter_id": 2252, "verse_number": "७-१७९-१२", "content_sanskrit": "अलायुधस्तु सङ्क्रुद्धो घटोत्कचमरिन्दमम्।\nपरिघेणातिकायेन ताडयामास मूर्धनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2057906, "chapter_id": 2252, "verse_number": "७-१७९-१३", "content_sanskrit": "स तु तेन प्रहारेण भैमसेनिर्महाबलः।\nईषन्मूर्छितमात्मानमस्तम्भयत वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2057907, "chapter_id": 2252, "verse_number": "७-१७९-१४", "content_sanskrit": "ततो दीप्ताग्निसङ्काशां शतघण्टामलङ्कृताम्।\nचिक्षेप तस्मै समरे गदां काञ्चनभूषिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2057908, "chapter_id": 2252, "verse_number": "७-१७९-१५", "content_sanskrit": "सा हयांश्च रथं चास्य सारथिं च महास्वना।\nचूर्णयामास वेगेन विसृष्टा भीमकर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2057909, "chapter_id": 2252, "verse_number": "७-१७९-१६", "content_sanskrit": "स भग्नहयचक्राक्षाद्विशीर्णध्वजकूबरात्।\nउत्पपात रथात्तूर्णं मायामास्थाय राक्षसीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2057910, "chapter_id": 2252, "verse_number": "७-१७९-१७", "content_sanskrit": "स समास्थाय मायां तु ववर्ष रुधिरं बहु।\nविद्युद्विभ्राजितं चासीत्तुमुलाभ्राकुलं नभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2057911, "chapter_id": 2252, "verse_number": "७-१७९-१८", "content_sanskrit": "ततो वज्रनिपाताश्च साशनिस्तनयित्नवः।\nमहांश्चटचटाशब्दस्तत्रासीच्च महाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2057912, "chapter_id": 2252, "verse_number": "७-१७९-१९", "content_sanskrit": "तां प्रेक्ष्य महतीं मायां राक्षसो राक्षसस्य च।\nऊर्ध्वमुत्पत्य हैडिम्बिस्तां मायां माययाऽवधीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2057913, "chapter_id": 2252, "verse_number": "७-१७९-२०", "content_sanskrit": "सोऽभिवीक्ष्य हतां मायां मायावी माययैव हि।\nअश्मवर्षं सुतुमुलं विससर्ज घटोत्कचे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2057914, "chapter_id": 2252, "verse_number": "७-१७९-२१", "content_sanskrit": "अश्मवर्षं स तं घोरं शरवर्षेण वीर्यवान्।\nदिक्षु विध्वंसयामास तदद्भुतमिवाभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2057915, "chapter_id": 2252, "verse_number": "७-१७९-२२", "content_sanskrit": "ततो नानाप्रहरणैरन्योन्यमभिवर्षताम्।\nआयसैः परिघैः शूलैर्गदामुसलमुद्गरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2057916, "chapter_id": 2252, "verse_number": "७-१७९-२३", "content_sanskrit": "पिनाकैः करवालैश्च तोमरप्रासकम्पनैः।\nनाराचैर्निशितैर्भल्लैः शरैश्चक्रैः परश्वथैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2057917, "chapter_id": 2252, "verse_number": "७-१७९-२४", "content_sanskrit": "अयोगुडैर्भिण्डिपालैर्गोशीर्षोलूखलैरपि।\nउत्पाटितैर्महाशाखैर्विविधैर्जगतीरुहैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2057918, "chapter_id": 2252, "verse_number": "७-१७९-२५", "content_sanskrit": "शमीपीलूकदम्बैश्च चम्पकैश्चैव भारत।\nइङ्गुदैर्बदरीभिश्च कोविदारैश्च पुष्पितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2057919, "chapter_id": 2252, "verse_number": "७-१७९-२६", "content_sanskrit": "पलाशैश्चारिमेदैश्च प्लुक्षन्यग्रोधपिप्पलैः।\nमहद्भिः समरे तस्मिन्न्योन्यमभिजघ्नतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2057920, "chapter_id": 2252, "verse_number": "७-१७९-२७", "content_sanskrit": "विपुलैः पर्वताग्रैश्च नानाधातुभिराचितैः।\nतेषां शब्दो महानासीद्वज्राणां भिद्यतामिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2057921, "chapter_id": 2252, "verse_number": "७-१७९-२८", "content_sanskrit": "युद्धं समभवद्धोरं भैम्यलायुधयोर्नृप।\nहरीन्द्रयोर्यथा राजन्वालिसुग्रीवयोः पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2057922, "chapter_id": 2252, "verse_number": "७-१७९-२९", "content_sanskrit": "तौ युद्ध्वा विविधैर्घोरैरायुधैर्विशिखैस्तथा।\nउत्सृज्य च शितौ खङ्खागवन्योमभिपेततुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2057923, "chapter_id": 2252, "verse_number": "७-१७९-३०", "content_sanskrit": "तावन्योन्यमभिद्रुत्य केशेषु सुमहाबलौ।\nभुजाभ्यां पर्यगृह्णीतां महाकायौ महाबलौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2057924, "chapter_id": 2252, "verse_number": "७-१७९-३१", "content_sanskrit": "तौ स्विन्नगात्रौ प्रस्वेदं सुस्रुवाते जनाधिप।\nरुधिरं च महाकायावतिवृष्टाविवाम्बुदौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2057925, "chapter_id": 2252, "verse_number": "७-१७९-३२", "content_sanskrit": "अथाभिपत्य वेगेन समुद्धाम्य च राक्षसम्।\nबलेनाक्षिप्य हैडिम्बिश्चकर्तास्य शिरो महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2057926, "chapter_id": 2252, "verse_number": "७-१७९-३३", "content_sanskrit": "सोऽपहृत्य शिरस्तस्य कुण्डलाभ्यां विभूपितम्।\nतदा सुतुमुलं नादं ननाद सुमहाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2057927, "chapter_id": 2252, "verse_number": "७-१७९-३४", "content_sanskrit": "हतं दृष्ट्वा महाकायं बकज्ञातिमरिन्दमम्।\nपाञ्चालाः पाण्डवाश्चैव सिंहनादान्विनेदिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2057928, "chapter_id": 2252, "verse_number": "७-१७९-३५", "content_sanskrit": "ततो भेरीसहस्राणि शङ्खानामयुतानि च।\nअवादयन्पाण्डवेया राक्षसे निहते युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2057929, "chapter_id": 2252, "verse_number": "७-१७९-३६", "content_sanskrit": "अतीव सा निशा तेषां बभूव विजयावहा।\nविद्योतमाना विबभौ समन्ताद्दीपमालिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2057930, "chapter_id": 2252, "verse_number": "७-१७९-३७", "content_sanskrit": "अलायुधस्य तु शिरो भैमसेनिर्महाबलः।\nदुर्योधनस्य प्रमुखे चिक्षेप गतचेतसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2057931, "chapter_id": 2252, "verse_number": "७-१७९-३८", "content_sanskrit": "अथ दुर्योधनो राजा दृष्ट्वा हतमलायुधम्।\nबभूव परमोद्विग्नः सह सैन्येन भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2057932, "chapter_id": 2252, "verse_number": "७-१७९-३९", "content_sanskrit": "तेन ह्यस्य प्रतिज्ञातं भीमसेनमहं युधि।\nहन्तेति स्वयमागम्य स्मरता वैरमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2057933, "chapter_id": 2252, "verse_number": "७-१७९-४०", "content_sanskrit": "ध्रुवं स तेन हन्तव्य इत्यमन्यत पार्थिवः।\nजीवितं चिरकालं भ्रातॄणां चाप्यमन्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2057934, "chapter_id": 2252, "verse_number": "७-१७९-४१", "content_sanskrit": "स तं दृष्ट्वा विनिहतं भीमसेनात्मजेन वै।\nप्रतिज्ञां भीमसेनस्य पूर्णामेवाभ्यमन्यत॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2057935, "chapter_id": 2252, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि घटोत्कचवधपर्वणि चतुर्दशरात्रियुद्धे एकोनाशीत्यधिकशततमोऽध्यायः॥ १७९ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-१७९-२८ हरीन्द्रयोः सिंहमुख्ययोः॥ ५-१७९-१७९ एकोनाशीत्यधिकशततमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]