[{"id": 7003969000, "chapter_id": 23969, "verse_number": "३-१-३२-१", "content_sanskrit": "श्रीसूत उवाच ।\nभूयोऽपिसंप्रवक्ष्यामि धनुष्कोटेस्तु वैभवम् ।\nयुष्माकमादरेणाहं नैमिषारण्यवा सिनः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003969001, "chapter_id": 23969, "verse_number": "३-१-३२-२", "content_sanskrit": "नंदोनाम महाराजः सोमवंशसमुद्भवः ।\nधर्मेण पालयामास सागरांतां धरामिमाम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003969002, "chapter_id": 23969, "verse_number": "३-१-३२-३", "content_sanskrit": "तस्य पुत्रः समभवद्धर्मगुप्त इति श्रुतः ।\nराज्य रक्षाधुरं नंदो निजपुत्रे निधाय सः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003969003, "chapter_id": 23969, "verse_number": "३-१-३२-४", "content_sanskrit": "जितेंद्रियो जिताहारः प्रविवेश तपोवनम् ।\nताते तपोवनं याते धर्मगुप्ताभिधो नृपः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003969004, "chapter_id": 23969, "verse_number": "३-१-३२-५", "content_sanskrit": "मेदिनीं पालया मास धर्मज्ञो नीतितत्परः ।\nईजे बहुविधैर्यज्ञैर्देवानिंद्रपुरोगमान्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003969005, "chapter_id": 23969, "verse_number": "३-१-३२-६", "content_sanskrit": "ब्राह्मणेभ्यो ददौ वित्तं क्षेत्राणि च बहूनि सः ।\nसर्वे स्वधर्मनिरतास्तस्मिन्राजनि शासति॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003969006, "chapter_id": 23969, "verse_number": "३-१-३२-७", "content_sanskrit": "बभूवुर्नाभवन्पीडास्तस्मिंश्चोरादिसंभवाः ।\nकदाचिद्धर्मगुप्तोऽयमारूढस्तुरगोत्तमम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003969007, "chapter_id": 23969, "verse_number": "३-१-३२-८", "content_sanskrit": "वनं विवेश विप्रेंद्रा मृगयारसकौ तुकी ।\nतमालतालहिंतालकुरवाकुलदिङ्मुखे॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003969008, "chapter_id": 23969, "verse_number": "३-१-३२-९", "content_sanskrit": "विचचार वने तस्मिन्सिंहव्याघ्रभयानके ।\nमत्तालिकुलसंनादसंमूर्छितदिगंतरे॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003969009, "chapter_id": 23969, "verse_number": "३-१-३२-१०", "content_sanskrit": "पद्म कल्हारकुमुदनीलोत्पलवनाकुलैः ।\nतटाकैरपि संपूर्णे तपस्विजनमंडिते॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003969010, "chapter_id": 23969, "verse_number": "३-१-३२-११", "content_sanskrit": "तस्मिन्वने संचरतो धर्मगुप्तस्य भूपतेः ।\nअभूद्विभावरी विप्रास्त मसावृतदिङ्मुखा॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003969011, "chapter_id": 23969, "verse_number": "३-१-३२-१२", "content_sanskrit": "राजापि पश्चिमां संध्यामुपास्य नियमान्वितः ।\nजजाप तत्र च वने गायत्रीं वेदमातरम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003969012, "chapter_id": 23969, "verse_number": "३-१-३२-१३", "content_sanskrit": "सिंहव्याघ्रादिभीत्या स्मिन्वृक्षमेकं समास्थिते ।\nराजपुत्रे तदाभ्यागादृक्षः सिंहभयार्दितः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003969013, "chapter_id": 23969, "verse_number": "३-१-३२-१४", "content_sanskrit": "अन्वधावतं तं ऋक्षमैकः सिंहो वनेचरः ।\nअनुद्रुतः स सिंहेन ऋक्षो वृक्षमुपारुहत्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003969014, "chapter_id": 23969, "verse_number": "३-१-३२-१५", "content_sanskrit": "आरुह्य ऋक्षो वृक्षं तं ददर्श जगतीपतिम् ।\nवृक्षस्थितं महात्मानं महाबलपराक्रमम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003969015, "chapter_id": 23969, "verse_number": "३-१-३२-१६", "content_sanskrit": "उवाच भूपतिं दृष्ट्वा ऋक्षोयं वनगोचरः ।\nमा भीतिं कुरु राजेंद्र वत्स्यावो रजनीमिह॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003969016, "chapter_id": 23969, "verse_number": "३-१-३२-१७", "content_sanskrit": "महासत्त्वो महाकायो महादंष्ट्रासमाकुलः ।\nवृक्षमूलं समायातः सिंहो यमतिभीषणः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003969017, "chapter_id": 23969, "verse_number": "३-१-३२-१८", "content_sanskrit": "रात्र्यर्धं भज निद्रा त्वं रक्ष्यमाणो मयादितः ।\nततः प्रसुप्तं मां रक्ष शर्वर्यर्धं महामते॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003969018, "chapter_id": 23969, "verse_number": "३-१-३२-१९", "content_sanskrit": "इति तद्वाक्यमादाय सुप्ते नंदसुते हरिः ।\nप्रोवाच ऋक्षं सुप्तोऽयं नृपश्च त्यज्यतामिति॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003969019, "chapter_id": 23969, "verse_number": "३-१-३२-२०", "content_sanskrit": "तं सिंहमब्रवीदृक्षो धर्मज्ञो द्विजसत्तमाः ।\nभवान्धर्मं न जानीषे मृगराज वनेचर॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003969020, "chapter_id": 23969, "verse_number": "३-१-३२-२१", "content_sanskrit": "विश्वासघातिनां लोके महाकष्टा भवंति हि ।\nन हि मित्रद्रुहां पापं नश्येयज्ञायुतैरपि॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003969021, "chapter_id": 23969, "verse_number": "३-१-३२-२२", "content_sanskrit": "ब्रह्महत्यादिपापानां कथंचिन्निष्कृतिर्भवेत् ।\nविश्वस्तघातिनां पापं न नश्येज्जन्मकोटिभिः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003969022, "chapter_id": 23969, "verse_number": "३-१-३२-२३", "content_sanskrit": "नाहं मेरुं महाभारं मन्ये पंचास्य भूतले ।\nमहाभारमिमं मन्ये लोके विश्वासघातकम्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003969023, "chapter_id": 23969, "verse_number": "३-१-३२-२४", "content_sanskrit": "एवमुक्तेऽथ ऋक्षेण सिंहस्तूष्णीमभूत्तदा ।\nधर्मगुप्ते प्रबुद्धे तु ऋक्षः सुष्वाप भूरुहे॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003969024, "chapter_id": 23969, "verse_number": "३-१-३२-२५", "content_sanskrit": "ततः सिंहोऽब्रवीद्भूपमेनमृक्षं त्यजस्व मे ।\nएवमुक्तेऽथ सिंहेन राजा सुप्तमशंकितः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003969025, "chapter_id": 23969, "verse_number": "३-१-३२-२६", "content_sanskrit": "स्वांकन्यस्तशिरस्कं तमृक्षं तत्याज भूतले ।\nपात्यमानस्ततो राज्ञा नखालंबितपादपः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003969026, "chapter_id": 23969, "verse_number": "३-१-३२-२७", "content_sanskrit": "ऋक्षः पुण्यवशाद्वृक्षान्न पपात महीतले ।\nस ऋक्षो नृपमभ्येत्य कोपाद्वाक्यमभाषत॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003969027, "chapter_id": 23969, "verse_number": "३-१-३२-२८", "content_sanskrit": "कामरूपधरो राजन्नहं भृगुकुलोद्भवः ।\nध्यानकाष्ठाभिधो नाम्ना ऋक्षरूपमधारयम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003969028, "chapter_id": 23969, "verse_number": "३-१-३२-२९", "content_sanskrit": "यस्मादनागसं सुप्तमत्याक्षीन्मां भवान्नृप ।\nमच्छापात्त्वमतः शीघ्रमुन्मत्तश्चर भूपते॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003969029, "chapter_id": 23969, "verse_number": "३-१-३२-३०", "content_sanskrit": "इति शप्त्वा मुनिर्भूपं ततः सिंहमभाषत ।\nनृसिंहस्त्वं महायक्षः कुबेरसचिवः पुरा॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003969030, "chapter_id": 23969, "verse_number": "३-१-३२-३१", "content_sanskrit": "हिमवद्गिरिमासाद्य कदाचित्त्वं वधूसखः ।\nअज्ञानाद्गौतमाभ्याशे विहारमतनोर्मुदा॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003969031, "chapter_id": 23969, "verse_number": "३-१-३२-३२", "content_sanskrit": "गौतमोप्युटजाद्दैवात्समिदाहरणाय वै ।\nनिर्गतस्त्वां विवसनं दृष्ट्वा शापमुदाहरत्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003969032, "chapter_id": 23969, "verse_number": "३-१-३२-३३", "content_sanskrit": "यस्मान्ममाश्रमेऽद्य त्वं विवस्त्रः स्थितवानसि ।\nअतः सिंहत्वमद्यैव भविता ते न संशयः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003969033, "chapter_id": 23969, "verse_number": "३-१-३२-३४", "content_sanskrit": "इति गौतमशापेन सिंहत्वमगमत्पुरा ।\nकुबेरसचिवो यक्षो भद्रनामा भवान्पुरा॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003969034, "chapter_id": 23969, "verse_number": "३-१-३२-३५", "content_sanskrit": "कुबेरो धर्मशीलो हि तद्भृत्याश्च तथैव हि ।\nअतः किमर्थं त्वं हंसि मामृषिं वनगोचरम्॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003969035, "chapter_id": 23969, "verse_number": "३-१-३२-३६", "content_sanskrit": "एतत्सर्वमहं ध्याना ज्जानामीह मृगाधिप ।\nइत्युक्ते ध्यानकाष्ठेन त्यक्त्वा सिंहत्वमाशु सः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003969036, "chapter_id": 23969, "verse_number": "३-१-३२-३७", "content_sanskrit": "यक्षरूपं गतो दिव्यं कुबेरसचिवात्मकम् ।\nध्यानकाष्ठमसावाह प्रांजलिः प्रणतो मुनिम्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003969037, "chapter_id": 23969, "verse_number": "३-१-३२-३८", "content_sanskrit": "अद्य ज्ञातं मया सर्वं पूर्ववृत्तं महामुने ।\nगौतमः शापकाले मे शापांतमपि चोक्तवान्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003969038, "chapter_id": 23969, "verse_number": "३-१-३२-३९", "content_sanskrit": "ध्यानकाष्ठे न संवाद ऋक्षरूपेण ते यदा ।\nतदा निर्धूय सिंहत्वं यक्षरूपमवाप्स्यसि॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003969039, "chapter_id": 23969, "verse_number": "३-१-३२-४०", "content_sanskrit": "इति मामब्रवीद्ब्रह्मन्गौतमो मुनिपुंगवः ।\nअद्य सिंहत्वनाशान्मे जानामि त्वां महामुने॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003969040, "chapter_id": 23969, "verse_number": "३-१-३२-४१", "content_sanskrit": "ध्यानकाष्ठाभिधं शुद्धं कामरूपधरं सदा ।\nइत्युक्त्वा तं प्रणम्याथ ध्यानकाष्ठं स यक्षराट्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003969041, "chapter_id": 23969, "verse_number": "३-१-३२-४२", "content_sanskrit": "विमानवरमा रुह्य प्रययावलकापुरीम् ।\nतस्मिन्गते तु यक्षेशे ध्यानकाष्ठो महामुनिः॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003969042, "chapter_id": 23969, "verse_number": "३-१-३२-४३", "content_sanskrit": "अव्याहतेष्टगमनो यथेष्ठः प्रययौ महीम् ।\nध्यानकाष्ठे गते तस्मि न्कामरूपधरे मुनौ॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003969043, "chapter_id": 23969, "verse_number": "३-१-३२-४४", "content_sanskrit": "धर्मगुप्तौ मुनेः शापादुन्मत्तः प्रययौ पुरीम् ।\nउन्मत्तरूपं तं दृष्ट्वा मंत्रिणस्तु नृपोत्तमम्॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003969044, "chapter_id": 23969, "verse_number": "३-१-३२-४५", "content_sanskrit": "पितुः सकाशमा निन्यू रेवातीरे मनोरमे ।\nतस्मै निवेदयामासुर्मतिभ्रंशं सुतस्य ते॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003969045, "chapter_id": 23969, "verse_number": "३-१-३२-४६", "content_sanskrit": "ज्ञात्वा तु पुत्रवृत्तांतं नन्दस्तस्य पिता तदा ।\nपुत्रमादाय तरसा जैमिनेरन्तिकं ययौ ।\nतस्मै निवेदयामास पुत्रवृत्तान्तमादितः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003969046, "chapter_id": 23969, "verse_number": "३-१-३२-४७", "content_sanskrit": "भगवञ्जैमिने पुत्रो ममाद्योन्मत्ततां गतः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003969047, "chapter_id": 23969, "verse_number": "३-१-३२-४८", "content_sanskrit": "अस्योन्मादविनाशाय ब्रूह्युपायं महामुने ।\nइति पृष्टश्चिरं दध्यौ जैमिनिर्मुनिपुंगवः॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003969048, "chapter_id": 23969, "verse_number": "३-१-३२-४९", "content_sanskrit": "ध्यात्वा तु सुचिरं कालं नृपं नंदमथाब्रवीत् ।\nध्यानकाष्ठस्य शापेन ह्युन्म त्तस्ते सुतोऽभवत्॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003969049, "chapter_id": 23969, "verse_number": "३-१-३२-५०", "content_sanskrit": "तस्य शापस्य मोक्षार्थमुपायं प्रब्रवीमि ते ।\nदक्षिणांबुनिधौ सेतौ पुण्ये पापविनाशने॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003969050, "chapter_id": 23969, "verse_number": "३-१-३२-५१", "content_sanskrit": "धनुष्कोटिरिति ख्यातं तीर्थमस्ति महत्तरम् ।\nपवित्राणां पवित्रं च मंगलानां च मंगलम्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003969051, "chapter_id": 23969, "verse_number": "३-१-३२-५२", "content_sanskrit": "श्रुतिसिद्धं महापुण्यं ब्रह्महत्यादिशोधकम् ।\nनीत्वा तत्र सुतं तेऽद्य स्नापयस्व महीपते॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003969052, "chapter_id": 23969, "verse_number": "३-१-३२-५३", "content_sanskrit": "उन्मादस्तत्क्षणादेव तस्य नश्येन्न संशयः ।\nइत्युक्तस्तं प्रणम्यासौ जैमिनिं मुनिपुंगवम्॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003969053, "chapter_id": 23969, "verse_number": "३-१-३२-५४", "content_sanskrit": "नंदः पुत्रं समादाय धनुष्कोटिं ययौ तदा ।\nतत्र च स्नापयामास पुत्रं नियमपूर्वकम्॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003969054, "chapter_id": 23969, "verse_number": "३-१-३२-५५", "content_sanskrit": "स्नानमात्रात्ततः सद्यो नष्टोन्मादोऽभवत्सुतः ।\nस्वयं सस्नौ स नन्दोपि धनुष्कोटौ सभक्तिकम्॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003969055, "chapter_id": 23969, "verse_number": "३-१-३२-५६", "content_sanskrit": "उषित्वा दिनमेकं तु सपुत्रस्तु पिता तदा ।\nसेवित्वा रामनाथं च सांबमूर्तिं घृणानिधिम्॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003969056, "chapter_id": 23969, "verse_number": "३-१-३२-५७", "content_sanskrit": "पुत्रमापृच्छय नंदस्तं प्रययौ तपसे वनम् ।\nगते पितरि पुत्रोऽपि धर्मगुप्तो नृपो द्विजाः॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003969057, "chapter_id": 23969, "verse_number": "३-१-३२-५८", "content_sanskrit": "प्रददौ रामनाथाय बहुवित्तानि भक्तितः ।\nब्राह्मणेभ्यो धनं धान्यं क्षेत्राणि च ददौ तदा॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003969058, "chapter_id": 23969, "verse_number": "३-१-३२-५९", "content_sanskrit": "प्रययौ मंत्रिभिः सार्धं स्वां पुरीं तदनंतरम् ।\nधर्मेण पालयामास राज्यं निहतकण्टकम्॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003969059, "chapter_id": 23969, "verse_number": "३-१-३२-६०", "content_sanskrit": "पितृपैतामहं विप्रा धर्मगुप्तोऽतिधार्मिकः ।\nउन्मादैरप्यपस्मारैर्ग्रहैर्दुष्टैश्च ये नराः॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003969060, "chapter_id": 23969, "verse_number": "३-१-३२-६१", "content_sanskrit": "ग्रस्ता भवंति विप्रेंद्रास्तेऽपि चात्र निमज्जनात् ।\nधनुष्कोटौ विमुक्ताः स्युः सत्यं सत्यं वदाम्यहम्॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003969061, "chapter_id": 23969, "verse_number": "३-१-३२-६२", "content_sanskrit": "परित्यज्य धनुष्कोटिं तीर्थमन्यद्व्रजेत्तु यः ।\nसिद्धं स गोपयस्त्यक्त्वा स्नुहीक्षीरं प्रयाचते॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003969062, "chapter_id": 23969, "verse_number": "३-१-३२-६३", "content_sanskrit": "धनुष्कोटिर्धनुष्कोटिर्धनुष्कोटिरिति द्विजाः ।\nत्रिः पठन्तो नरा ये तु यत्र क्वापि जलाशये॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003969063, "chapter_id": 23969, "verse_number": "३-१-३२-६४", "content_sanskrit": "स्नांति सर्वे नरास्ते वै यास्यंति ब्रह्मणः पदम् ।\nएवं वः कथिता विप्रा धर्मगुप्तकथा शुभा॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003969064, "chapter_id": 23969, "verse_number": "३-१-३२-६५", "content_sanskrit": "यस्याः श्रवणमात्रेण ब्रह्महत्या विनश्यति ।\nस्वर्णस्तेयादयश्चान्ये नश्येयुः पापसंचयाः॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}]