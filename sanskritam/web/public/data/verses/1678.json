[{"id": 2031121, "chapter_id": 1678, "verse_number": "४-१-०x", "content_sanskrit": "॥ श्रीवेदव्यासाय नमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2031122, "chapter_id": 1678, "verse_number": "४-१-१", "content_sanskrit": "नारायणं नमस्कृत्य नरं चैव नरोत्तमम्।\nदेवीं सरस्वतीं व्यासं ततो जयमुदीरयेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2031123, "chapter_id": 1678, "verse_number": "४-१-२x", "content_sanskrit": "॥ जनमेजय उवाच ।\nकथं विराटनगरे मम पूर्वपितामहाः ।\nअज्ञातवासमुषिता दुर्योधनभयार्दिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2031124, "chapter_id": 1678, "verse_number": "४-१-२", "content_sanskrit": "पतिव्रता महाभागा सततं सुखभागिनी ।\nद्रौपदी सा कथं ब्रह्मन्नज्ञाता दुःखिताऽवसत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2031125, "chapter_id": 1678, "verse_number": "४-१-३", "content_sanskrit": "ते च ब्राह्मणमुख्याश्च सूतपौरोगवैः सह।\nअज्ञातवासमुषिताः कथं च परिचारकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2031126, "chapter_id": 1678, "verse_number": "४-१-४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2031127, "chapter_id": 1678, "verse_number": "४-१-४", "content_sanskrit": "यथा विराटनगरे तव पूर्वपितामहाः ।\nअज्ञातवासमुषितास्तावद्वक्ष्यामि तच्छृणु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2031128, "chapter_id": 1678, "verse_number": "४-१-५", "content_sanskrit": "तथा स तान्वराँल्लब्ध्वा धर्मराजो युधिष्ठिरः।\nगत्वाऽऽश्रमं ब्राह्मणेभ्य आचख्यौ वृत्तमात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2031129, "chapter_id": 1678, "verse_number": "४-१-६", "content_sanskrit": "कथयित्वा च तत्सर्वं ब्राह्मणेभ्यो युधिष्ठिरः।\nअरणीसहितं भाण्डं ब्राह्मणाय न्यवेदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2031130, "chapter_id": 1678, "verse_number": "४-१-७", "content_sanskrit": "ततो युधिष्ठिरो राजा कुन्तीपुत्रो दृढव्रतः।\nसमाहूयानुजान्सर्वानिति होवाच भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2031131, "chapter_id": 1678, "verse_number": "४-१-८", "content_sanskrit": "द्वादशेमानि वर्षाणि राष्ट्राद्विप्रोषिता वयम्।\nछद्मना हृतराज्याश्च निस्वाश्च बहुशः कृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2031132, "chapter_id": 1678, "verse_number": "४-१-९", "content_sanskrit": "उषिताश्च वने वासं यथा द्वादश वत्सरान्।\nअज्ञातचर्यां वत्स्यामश्छन्ना वर्षं त्रयोदशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2031133, "chapter_id": 1678, "verse_number": "४-१-१०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2031134, "chapter_id": 1678, "verse_number": "४-१-१०", "content_sanskrit": "धर्मेण तेऽभ्यनुज्ञाताः पाण्डवाः सत्यविक्रमाः।\nअज्ञातवासं वत्स्यन्तश्छन्ना वर्षं त्रयोदशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2031135, "chapter_id": 1678, "verse_number": "४-१-११", "content_sanskrit": "उपोपविश्य विद्वांसः स्नातकाः संशितव्रताः ।\nये तत्र ब्राह्मणा आसन्वनवाससहायिनः ।\nये च भक्ता वसन्ति स्म वनवासे तपस्विनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2031136, "chapter_id": 1678, "verse_number": "४-१-१२", "content_sanskrit": "तानब्रुवन्महात्मानो हृष्टाः प्राञ्जलयः स्थिताः ।\nअभ्यनुज्ञापयिष्यन्तस्तान्प्रवासे धृतव्रताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2031137, "chapter_id": 1678, "verse_number": "४-१-१३", "content_sanskrit": "विदितं भवतां सर्वं धार्तराष्ट्रैर्यथा वयम् ।\nछद्मना हृतराज्याश्च निस्वाश्च बहुशः कृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2031138, "chapter_id": 1678, "verse_number": "४-१-१४", "content_sanskrit": "उषिताश्च वने वासं यथा द्वादशवत्सरान् ।\nभवद्भिरेव सहिता वन्याहारा द्विजोत्तमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2031139, "chapter_id": 1678, "verse_number": "४-१-१५", "content_sanskrit": "अज्ञातवाससमयं शेषं वर्षं त्रयोदशम्।\nतद्वत्स्यामो वयं छन्नास्तदनुज्ञातुमर्हथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2031140, "chapter_id": 1678, "verse_number": "४-१-१६", "content_sanskrit": "सुयोधनश्च दुष्टात्मा कर्णश्च सहसौबलः ।\nजानन्तो विषमं कुर्युरस्मास्वत्यन्तवैरिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2031141, "chapter_id": 1678, "verse_number": "४-१-१७", "content_sanskrit": "युक्तचाराश्च यत्ताश्च दाये स्वस्य जनस्य च ।\nदुरात्मनां हि कस्तेषां विश्वासं गन्तुमर्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2031142, "chapter_id": 1678, "verse_number": "४-१-१८", "content_sanskrit": "अपि नस्तद्भवेद्भूयो यद्वयं ब्राह्मणैः सह।\nसमस्तेषु च राष्ट्रेषु स्वराज्यस्था भवेम हि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2031143, "chapter_id": 1678, "verse_number": "४-१-१९", "content_sanskrit": "इत्युक्त्वा दुःखशोकार्तः शुचिर्धर्मसुतस्तदा।\nसंमूर्च्छितोऽभवद्राजा सास्रकण्ठो युधिष्ठिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2031144, "chapter_id": 1678, "verse_number": "४-१-२०", "content_sanskrit": "तमथाश्वासयन्सर्वे ब्राह्मणा भ्रातृभिः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2031145, "chapter_id": 1678, "verse_number": "४-१-२१", "content_sanskrit": "प्रबुध्य दुःखमोहार्तो धौम्यं धर्मभृतांवरम् ।\nप्रावैक्षत तदा राजा साश्रुकण्ठो युधिष्ठिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2031146, "chapter_id": 1678, "verse_number": "४-१-२२", "content_sanskrit": "अथ धौम्योऽब्रवीद्वाक्यं महार्थं नृपतिं तदा।\nआश्वासयंस्तं स नृपं भ्रातॄंश्च ब्राह्मणैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2031147, "chapter_id": 1678, "verse_number": "४-१-२३", "content_sanskrit": "राजन्विद्वान्भवान्दान्तः सत्यसन्धो जितेन्द्रियः।\nनैवंविधाः प्रमुह्यन्ति धीराः कस्यांचिदापदि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2031148, "chapter_id": 1678, "verse_number": "४-१-२४", "content_sanskrit": "देवैरप्यापदः प्राप्ताश्छन्नैश्च बहुभिस्तदा।\nतत्रतत्र सपत्नानां निग्रहार्थं महात्मभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2031149, "chapter_id": 1678, "verse_number": "४-१-२५", "content_sanskrit": "दितिपुत्रैर्हृते राज्ये देवराजः सुदुःखितः।\nब्रह्माणं तोषयिष्यंश्च ब्रह्मरूपं विधाय च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2031150, "chapter_id": 1678, "verse_number": "४-१-२६", "content_sanskrit": "इन्द्रेण निषधं प्राप्य गिरिप्रस्थाह्वये पुरे।\nछन्नेनोष्य कृतं कर्म द्विषतां बलनिग्रहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2031151, "chapter_id": 1678, "verse_number": "४-१-२७", "content_sanskrit": "प्रसादाद्ब्रह्मणो राजन्दितेः पुत्रान्महाबलान् ।\nनिर्जित्य तरसा शत्रून्पुनर्लोकाञ्जुगोप च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2031152, "chapter_id": 1678, "verse_number": "४-१-२८", "content_sanskrit": "विष्णुनाऽश्मगिरिं प्राप्य तदा दित्यां निवत्स्यता।\nगर्भे वधार्थं दैत्यानामज्ञातेनोषितं चिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2031153, "chapter_id": 1678, "verse_number": "४-१-२९", "content_sanskrit": "प्रोष्य वामनरूपेण च्छन्नेन ब्रह्मचारिणा।\nबलेर्यथा हृतं राज्यं विक्रमैस्तच्च ते श्रुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2031154, "chapter_id": 1678, "verse_number": "४-१-३०", "content_sanskrit": "और्वेण वसता छन्नमूरौ ब्रह्मर्षिणा तदा।\nयत्कृतं तात लोकेषु तच्च सर्वं श्रुतं त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2031155, "chapter_id": 1678, "verse_number": "४-१-३१", "content_sanskrit": "प्रच्छन्नेनापि सर्वत्र हरिणा वृत्रनिग्रहे।\nवज्रं प्रविश्य शक्रस्य यत्कृतं तच्च ते श्रुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2031156, "chapter_id": 1678, "verse_number": "४-१-३२", "content_sanskrit": "हुताशनेन यच्चापः प्रविश्य च्छन्नमूषितम्।\nविबुधानां हि यत्कर्म कृतं तच्चापि ते श्रुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2031157, "chapter_id": 1678, "verse_number": "४-१-३३", "content_sanskrit": "यथा विवस्वता तात छन्नेनोत्तमतेजसा।\nनिर्दग्धाः शत्रवः सर्वे वसता गवि वर्षशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2031158, "chapter_id": 1678, "verse_number": "४-१-३४", "content_sanskrit": "विष्णुना वसता चात्र गृहे दशरथस्य वै।\nदशग्रीवो हतश्छन्नं संयुगे भीमकर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2031159, "chapter_id": 1678, "verse_number": "४-१-३५", "content_sanskrit": "एवमेते महात्मानः प्रच्छन्नास्तत्रतत्र हि।\nअजयञ्छात्रवान्मुख्यांस्तथा त्वमपि जेष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2031160, "chapter_id": 1678, "verse_number": "४-१-३६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2031161, "chapter_id": 1678, "verse_number": "४-१-३६", "content_sanskrit": "इति धौम्येन धर्मज्ञो वाक्यैः स परिहर्षितः।\nशान्तबुद्धिः पुनर्भूत्वा व्यष्टम्भत युधिष्ठिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2031162, "chapter_id": 1678, "verse_number": "४-१-३७", "content_sanskrit": "अथाब्रवीन्महाबाहुर्भीमसेनो महाबलः।\nराजानं बलिनां श्रेष्ठो गिरा संपरिहर्षयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2031163, "chapter_id": 1678, "verse_number": "४-१-३८", "content_sanskrit": "अवेक्षय महाराज तव गाण्डीवधन्वना।\nधर्मार्थपरया बुद्ध्या न किंचित्साहसं कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2031164, "chapter_id": 1678, "verse_number": "४-१-३९", "content_sanskrit": "सहदेवो मया नित्यं नकुलश्च निवारितौ ।\nशक्तौ विध्वंसने तेषां शत्रुघ्नौ भीमविक्रमौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2031165, "chapter_id": 1678, "verse_number": "४-१-४०", "content_sanskrit": "न वयं वर्त्म हास्यामो यस्मिन्योक्ष्यति नो भवान् ।\nतद्विधत्तां भवान्सर्वं क्षिप्रं जेष्यामहे परान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2031166, "chapter_id": 1678, "verse_number": "४-१-४१", "content_sanskrit": "इत्युक्तो भीमसेनेन धर्मराजो युधिष्ठिरः ।\nसुखोपविष्टो विद्वद्भिस्तापसैः संशितव्रतैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2031167, "chapter_id": 1678, "verse_number": "४-१-४२", "content_sanskrit": "ये तद्भक्त्याऽभवंस्तस्मिन्वनवासे तपस्विनः ।\nतानब्रवीन्महाप्राज्ञः शिष्टान्राजा कृताञ्जलिः ।\nअभ्यनुज्ञापयिष्यन्वै तस्मिन्वासे धृतव्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2031168, "chapter_id": 1678, "verse_number": "४-१-४३", "content_sanskrit": "विदितं भवतां सर्वे र्धार्तराष्ट्रैर्यथा वयम्।\nसंमन्त्राहृतराज्याश्च निस्स्वाश्च बहुशः कृताः ।\nउषिताः स्मो वने कृच्छ्रं तथा वर्षाणि द्वादश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2031169, "chapter_id": 1678, "verse_number": "४-१-४४", "content_sanskrit": "अज्ञातचर्यासमयं शेषं वर्षं त्रयोदशम्।\nतद्वत्स्यामः क्वचिच्छन्नास्तदनुज्ञातुमर्हथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2031170, "chapter_id": 1678, "verse_number": "४-१-४५", "content_sanskrit": "इत्युक्ता धर्मराजेन ब्राह्मणाः परमाशिषः ।\nप्रयुज्यापृच्छ्य भरतान्यथास्वं प्रययुर्गृहान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2031171, "chapter_id": 1678, "verse_number": "४-१-४६", "content_sanskrit": "सर्वे वेदविदो मुख्या यतयो मुनयस्तदा।\nआशीरुक्त्वा यथान्यायं पुनर्दर्शनकाङ्क्षिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2031172, "chapter_id": 1678, "verse_number": "४-१-४७", "content_sanskrit": "ते तु भृत्याश्च दूताश्च शिल्पिनः परिचारकाः।\nअनुज्ञाप्य यथान्यायं पुनर्दर्शनकाङ्क्षिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2031173, "chapter_id": 1678, "verse_number": "४-१-४८", "content_sanskrit": "सह धौम्येन विद्वांसस्तथा ते पञ्च पाण्डवाः।\nउत्थाय प्रययुर्वीराः कृष्णामादाय भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2031174, "chapter_id": 1678, "verse_number": "४-१-४९", "content_sanskrit": "क्रोशमात्रमतिक्रम्य तस्माद्वासान्निमित्ततः ।\nश्वोभूते मनुजव्याघ्राश्छन्नवासार्थमुद्यताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2031175, "chapter_id": 1678, "verse_number": "४-१-५०", "content_sanskrit": "पृथक् शास्त्रविदः सर्वे सर्वे मन्त्रविशारदाः ।\nसन्धिविग्रहतत्वज्ञा मन्त्राय समुपाविशन् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2031176, "chapter_id": 1678, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते विराटपर्वणि पाण्डवप्रवेशपर्वणि प्रथमोऽध्यायः ॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]