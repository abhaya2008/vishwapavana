[{"id": 7000678000, "chapter_id": 20678, "verse_number": "६-२१-१", "content_sanskrit": "नारद उवाच ।\nसगरस्यात्मजा वीराः कथं जाता महाबलाः ।\nविक्रांताः षष्टिसाहस्रा विज्ञानेश्वर तद्वद ॥१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000678001, "chapter_id": 20678, "verse_number": "६-२१-२", "content_sanskrit": "श्रीपार्वतीपतिरुवाच ।\nद्वे पत्न्यौ सगरस्यास्तां तपसा दग्धकिल्बिषे ।\nऔर्वस्ताभ्यां वरं प्रादात्तोषितो मुनिसत्तमः ॥२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000678002, "chapter_id": 20678, "verse_number": "६-२१-३", "content_sanskrit": "षष्टिंपुत्रसहस्राणि एका वव्रे तरस्विनाम् ।\nएका वंशधरं त्वेकं यथेष्टं वरशालिनी ॥३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000678003, "chapter_id": 20678, "verse_number": "६-२१-४", "content_sanskrit": "तत्रैका सुषुवे तुंब्यां पुत्रान्शूरान्बहूनथ ।\nते तु सर्वेऽपि धात्रीभिर्वर्द्धितास्तु यथाक्रमम् ॥४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000678004, "chapter_id": 20678, "verse_number": "६-२१-५", "content_sanskrit": "कपिलानां तु दुग्धानां तेषां तत्र महात्मनाम् ॥५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000678005, "chapter_id": 20678, "verse_number": "६-२१-६", "content_sanskrit": "तेनैव दुग्धयोगेन ववृधुस्ते महात्मनः ।\nएकः पंचजनो नाम पुत्रो राजा बभूव ह ॥६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000678006, "chapter_id": 20678, "verse_number": "६-२१-७", "content_sanskrit": "ततः पंचजनस्यासीदंशुमान्नाम वीर्यवान् ।\nदिलीपस्तनयस्तस्य पुत्रो यस्य भगीरथः ॥७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000678007, "chapter_id": 20678, "verse_number": "६-२१-८", "content_sanskrit": "यस्तु गंगासरिच्छ्रेष्ठामानयामास सुव्रतः ।\nसमुद्र मानयित्वैनां दुहितृत्वमकल्पयत् ॥८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000678008, "chapter_id": 20678, "verse_number": "६-२१-९", "content_sanskrit": "नारदौवाच ।\nकथं गंगा समानीता किं तपस्तेन वै कृतम् ।\nतत्सर्वं मे समाचक्ष्व सुव्रतोऽसि दयानिधे ॥९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000678009, "chapter_id": 20678, "verse_number": "६-२१-१०", "content_sanskrit": "महादेव उवाच ।\nपूर्वजानां हितार्थाय गतोऽसौ हैमके गिरौ ।\nतत्र गत्वा तपस्तप्तं वर्षाणामयुतं तदा ॥१० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000678010, "chapter_id": 20678, "verse_number": "६-२१-११", "content_sanskrit": "आदिदेवः प्रसन्नोऽभूद्योऽसौ देवो निरंजनः ।\nतेन दत्ता इयं गंगा आकाशात्समुपस्थिता ॥११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000678011, "chapter_id": 20678, "verse_number": "६-२१-१२", "content_sanskrit": "तत्र विश्वेश्वरो देवो यत्र तिष्ठति नित्यशः ।\nगंगां दृष्ट्वाऽगतां तेन गृहीता जाह्नवी तदा ॥१२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000678012, "chapter_id": 20678, "verse_number": "६-२१-१३", "content_sanskrit": "जटाजूटे च संधार्य वर्षाणामयुतं स्थितम् ।\nन निःसृता तदा गंगा ईशस्यैव प्रभावतः ॥१३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000678013, "chapter_id": 20678, "verse_number": "६-२१-१४", "content_sanskrit": "विचारितं तदा तेन क्व गता मम मातृका ।\nस ध्यानेन विचार्यैवं गृहीता चेश्वरेण तु ॥१४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000678014, "chapter_id": 20678, "verse_number": "६-२१-१५", "content_sanskrit": "ततः कैलासमगमत्स तु भगीरथो नृपः ।\nतत्र गत्वा मुनिश्रेष्ठ ह्यकरोदुल्बणं तपः ॥१५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000678015, "chapter_id": 20678, "verse_number": "६-२१-१६", "content_sanskrit": "आराधितस्तदा तेन दत्तवानहमापगाम् ।\nएकं केशं परित्यज्य दत्ता त्रिपथगा तदा ॥१६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000678016, "chapter_id": 20678, "verse_number": "६-२१-१७", "content_sanskrit": "स गृहीत्वा गतो गंगां पाताले यत्र पूर्वजाः ।\nअलकनंदा तदा नाम गंगायाः प्रथमं स्मृतम् ॥१७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000678017, "chapter_id": 20678, "verse_number": "६-२१-१८", "content_sanskrit": "हरिद्वारे यदायाता विष्णुपादोदकी तदा ।\nतदेव तीर्थं प्रवरं देवानामपि दुर्ल्लभम् ॥१८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000678018, "chapter_id": 20678, "verse_number": "६-२१-१९", "content_sanskrit": "तत्तीर्थे च नरः स्नात्वा हरिं दृष्ट्वा विशेषतः ।\nप्रदक्षिणं ये कुर्वंति न चैते दुःखभागिनः ॥१९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000678019, "chapter_id": 20678, "verse_number": "६-२१-२०", "content_sanskrit": "ब्रह्महत्यादि पापानां राशयः संत्यनेकशः ।\nविलयं यांति ते सर्वे हरेर्दर्शनतः सदा ॥२० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000678020, "chapter_id": 20678, "verse_number": "६-२१-२१", "content_sanskrit": "एकदा केशवस्थाने हरिद्वारे ह्यहं गतः ।\nतस्मात्तीर्थप्रभावाच्च जातोऽहं विष्णुरूपवान् ॥२१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000678021, "chapter_id": 20678, "verse_number": "६-२१-२२", "content_sanskrit": "ये गच्छंति नरश्रेष्ठास्ते वै यांति ह्यनामयम् ।\nचतुर्भुजास्तु ते लोकाः नरा नार्यश्च सर्वशः ॥२२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000678022, "chapter_id": 20678, "verse_number": "६-२१-२३", "content_sanskrit": "वैकुंठं यांति ते सर्वे हरेर्दर्शनमात्रतः ।\nममाप्यधिक तीर्थं तु हरिद्वारं सुशोभनम् ॥२३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000678023, "chapter_id": 20678, "verse_number": "६-२१-२४", "content_sanskrit": "तीर्थानां प्रवरं तीर्थं चतुर्वर्गप्रदायकम् ।\nकलौ धर्मकरं पुंसां मोक्षदं चार्थदं तथा ॥२४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000678024, "chapter_id": 20678, "verse_number": "६-२१-२५", "content_sanskrit": "यत्र गंगा महारम्या नित्यं वहति निर्मला ।\nएतत्कथानकं पुण्यं हरिद्वाराख्यमुत्तमम् ॥२५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000678025, "chapter_id": 20678, "verse_number": "६-२१-२६", "content_sanskrit": "उक्तं च शृण्वतां पुंसां फलं भवति शाश्वतम् ।\nअश्वमेधे कृते यागे गोसहस्रे तथैव च ॥२६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000678026, "chapter_id": 20678, "verse_number": "६-२१-२७", "content_sanskrit": "तत्पुण्यं लभते विद्वान्हरेर्दर्शनमात्रतः ।\nगोहंता ब्रह्महा चैव ये चान्ये पितृघातकाः ॥२७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000678027, "chapter_id": 20678, "verse_number": "६-२१-२८", "content_sanskrit": "एवंविधानि पापानि बहून्यपि च वै द्विज ।\nविलयं यांति सर्वाणि हरेर्दर्शनमात्रतः ॥२८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]