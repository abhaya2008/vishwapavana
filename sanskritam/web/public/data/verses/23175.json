[{"id": 7003175000, "chapter_id": 23175, "verse_number": "४-१११-१", "content_sanskrit": "राधिकोवाच ।\nज्ञानात्मकश्च परमो ब्रह्मेशशेषपूजितः ।\nज्ञानं च न ददौ तुभ्यं मन्मुलं प्रेषिता सति ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003175001, "chapter_id": 23175, "verse_number": "४-१११-२", "content_sanskrit": "तेनैव च्छद्मना तुभ्यं भावार्थं बोधयामि किम् ।\nवेदाः सन्तश्च भावार्थं नैव जानन्ति तस्य च ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003175002, "chapter_id": 23175, "verse_number": "४-१११-३", "content_sanskrit": "स्त्रीजातिरबला मूढा वक्तुतोऽज्ञानतत्परा ।\nततस्तद्विरहेणैव संततं हतचेतना ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003175003, "chapter_id": 23175, "verse_number": "४-१११-४", "content_sanskrit": "किं वाऽहं कथयिष्यामि ज्ञानं पञ्चविधेषु च ।\nभक्त्यात्मकं सर्वपरं निबोध कथयामि ते ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003175004, "chapter_id": 23175, "verse_number": "४-१११-५", "content_sanskrit": "श्रीकृष्णस्य वरेणापि न साधो निर्भयो भव ।\nगोलोके चापि पतनं संभवेच्च कुयोगिनः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003175005, "chapter_id": 23175, "verse_number": "४-१११-६", "content_sanskrit": "तस्मात्सर्वं परित्यज्य भजस्व परमेश्वरम् ।\nपुत्रबुद्धिं परित्यज्य ब्रह्मरूपं निशामय ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003175006, "chapter_id": 23175, "verse_number": "४-१११-७", "content_sanskrit": "यशोदे भवती सर्वे परित्यज्य च नश्वरम् ।\nगत्वा वृन्दावनं रम्यं पुण्यक्षेत्रं च भारतम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003175007, "chapter_id": 23175, "verse_number": "४-१११-८", "content_sanskrit": "कृत्वा त्रिकालस्नानं च निर्मले यमुनाजले ।\nकृत्वाऽष्टदलपद्मं च स्निग्धेन चन्दनेन च ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003175008, "chapter_id": 23175, "verse_number": "४-१११-९", "content_sanskrit": "ध्यानेन गर्गदत्तेन शुद्धेन मनसा सति ।\nसंपूज्य परमानन्दं सानन्दं व्रज तत्पदम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003175009, "chapter_id": 23175, "verse_number": "४-१११-१०", "content_sanskrit": "कृत्वा निकृन्तनं कर्म पिदृभिः शतकैः सह ।\nवैष्णवेन सहाऽऽलापं कुरुष्व सततं सति ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003175010, "chapter_id": 23175, "verse_number": "४-१११-११", "content_sanskrit": "वरं हुतवहज्वालां भक्तो वाञ्छति पञ्जरम् ।\nवरं च कण्टके वासं वरं च विष्भक्षणम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003175011, "chapter_id": 23175, "verse_number": "४-१११-१२", "content_sanskrit": "हरिभक्तिविहीनानां न सङ्गं नाशकारणम् ।\nस्वयं नष्टो भक्तिहीनो बृद्धिणेदं करोति च ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003175012, "chapter_id": 23175, "verse_number": "४-१११-१३", "content_sanskrit": "अङ्कुरो भक्तिवृक्षस्य भक्तसङ्गेन वर्धते ।\nपरं हरिकथालापपीयूषासेचनेन च ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003175013, "chapter_id": 23175, "verse_number": "४-१११-१४", "content_sanskrit": "अभक्तालापदीपाग्निज्वालायाः कलयापि च ।\nअङ्कुरः शुष्कतां याति पुनः सेकेन वर्धते ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003175014, "chapter_id": 23175, "verse_number": "४-१११-१५", "content_sanskrit": "तस्मादभक्तसङ्गं च सावधानः परित्यज ।\nयथा दृष्ट्वा कालसर्पं नरो भीत्वा पलायते ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003175015, "chapter_id": 23175, "verse_number": "४-१११-१६", "content_sanskrit": "यशोदे च प्रयत्नेन स्वात्मनः पुत्रमीश्वरम् ।\nराम नारायणनन्त मुकुन्द मधुसूदन ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003175016, "chapter_id": 23175, "verse_number": "४-१११-१७", "content_sanskrit": "कृष्ण केशव कंसारे हरे वैकुण्ठ वामन ।\nइत्येकादश नामानि पठेद्वा पाठयेदिति ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003175017, "chapter_id": 23175, "verse_number": "४-१११-१८", "content_sanskrit": "जन्मकोटिसहस्राणां पातकादेव मुच्यते ।\nराशब्दो विश्ववचनो मश्चापीश्वरवाचकः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003175018, "chapter_id": 23175, "verse_number": "४-१११-१९", "content_sanskrit": "विश्वानामीश्वरो यो हि तेन रामः प्रकीर्तितः ।\nरमते रमया सार्वं तेन रामं विदुर्बुधा ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003175019, "chapter_id": 23175, "verse_number": "४-१११-२०", "content_sanskrit": "रमाया रमणस्थानं रामं रामविदो विदुः ।\nराश्चेति लक्ष्मीवचनो मश्चापीश्वरवाचकः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003175020, "chapter_id": 23175, "verse_number": "४-१११-२१", "content_sanskrit": "लक्ष्मीपतिं गतिं रामं प्रवदन्ति मनीषिणः ।\nनाम्नां सहस्रं दिव्यानां स्मरणे यत्फलं लभेत् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003175021, "chapter_id": 23175, "verse_number": "४-१११-२२", "content_sanskrit": "तत्फलं लभते नूनं रामोच्चारणमात्रतः ।\nसारूप्यमुक्तिवचनो सारेति च विदुर्बुधाः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003175022, "chapter_id": 23175, "verse_number": "४-१११-२३", "content_sanskrit": "यो देवोऽप्ययनं तस्य स च नारायणः स्मृतः ।\nनाराश्च कृतपापाश्चाप्ययनं गमनं स्मृतम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003175023, "chapter_id": 23175, "verse_number": "४-१११-२४", "content_sanskrit": "यतो हि गमनं तेषां सोऽयं नारायणः स्मृतः ।\nसकृन्नारायणेत्युक्त्वा पुमान्कल्मशतत्रयम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003175024, "chapter_id": 23175, "verse_number": "४-१११-२५", "content_sanskrit": "गङ्गादिसर्वतीर्थेषु स्नातो भवति निश्चितम् ।\nनारं च मोक्षणं पुण्यमयनं ज्ञानमीप्सितम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003175025, "chapter_id": 23175, "verse_number": "४-१११-२६", "content_sanskrit": "तयोर्ज्ञानं भवेद्यस्मात्सोऽयं नारायणः प्रभुः ।\nनास्त्यन्तो यस्य वेदेषु पुराणेषु चतुर्षु च ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003175026, "chapter_id": 23175, "verse_number": "४-१११-२७", "content_sanskrit": "शास्त्रेष्वन्येषु योगेषु तेनानन्तं विदुर्बुधाः ।\nमुकुमध्ययमानं च निर्वाणं मोक्षवाचकम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003175027, "chapter_id": 23175, "verse_number": "४-१११-२८", "content_sanskrit": "तद्ददाति च यो देवो मुकुंदस्तेन कीर्तितः ।\nमुकुं भक्तिरसप्रेमवचनं वेदसंमतम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003175028, "chapter_id": 23175, "verse_number": "४-१११-२९", "content_sanskrit": "यस्तं ददाति भक्तेभ्यो मुकंदस्तेन कीर्तितः ।\nसूदनं मधुदैत्यस्य यस्मात्स मधुसूदनः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003175029, "chapter_id": 23175, "verse_number": "४-१११-३०", "content_sanskrit": "इति सन्तो वदन्तीशं वेदे भिन्नार्थमीप्सितम् ।\nमधु क्लीबं च माध्वीके कृतकर्मशुभाशुभे ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003175030, "chapter_id": 23175, "verse_number": "४-१११-३१", "content_sanskrit": "भक्तानां कर्मणां चैव सूदनं मधुसूदनः ।\nपरिणामाशुभं कर्मं भ्रान्तानां मधुरं मधु ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003175031, "chapter_id": 23175, "verse_number": "४-१११-३२", "content_sanskrit": "करोति सूदनं यो हि स एव मधुसूदनः ।\nकृषिरुत्कृष्टवचनो णश्च सद्भक्तिवाचकः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003175032, "chapter_id": 23175, "verse_number": "४-१११-३३", "content_sanskrit": "अश्चापि दातृवचनः कृष्णं तेन विदुर्बुधाः ।\nकृषिश्च परमानन्दे णश्च तद्दास्यकर्मणि ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003175033, "chapter_id": 23175, "verse_number": "४-१११-३४", "content_sanskrit": "तयोर्दाता च यो देवस्तेन कृष्णः प्रकीर्तितः ।\nकोटिजन्मार्जिते पापे कृषिःक्लेशे च वर्तते ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003175034, "chapter_id": 23175, "verse_number": "४-१११-३५", "content_sanskrit": "भक्तानां णश्च निर्वाणे तेन कृष्णः प्रकीर्तितः ।\nनाम्नां सहस्रं दिव्यानां त्रिरावृत्त्या चयत्फलम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003175035, "chapter_id": 23175, "verse_number": "४-१११-३६", "content_sanskrit": "एकावृत्त्या तु कृष्णस्य तत्फलं लभते नरः ।\nकृष्णनाम्नः परं नाम न भूतं न भविष्यति ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003175036, "chapter_id": 23175, "verse_number": "४-१११-३७", "content_sanskrit": "सर्वेभ्यश्च परं नाम कृष्णेति वैदिका विदुः ।\nकृष्ण कृष्णोति हे गोपि यस्तं स्मरति नित्यशः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003175037, "chapter_id": 23175, "verse_number": "४-१११-३८", "content_sanskrit": "जलं भित्त्वा यथा पद्मं नरकादुद्धरेच्च सः ।\nकृष्णेति मङ्गलं नाम यस्य वाचि प्रवर्तते ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003175038, "chapter_id": 23175, "verse_number": "४-१११-३९", "content_sanskrit": "भस्मीभवन्ति सद्यस्तु महापातककोटयः ।\nअश्वमेधसहस्रेभ्यः फलं कृष्णजपस्य च ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003175039, "chapter_id": 23175, "verse_number": "४-१११-४०", "content_sanskrit": "वरं तेभ्यः पुनर्जन्म नातो भक्तपुनर्भवः ।\nसर्वेषामपि यज्ञानां लक्षाणि च व्रतानि च ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003175040, "chapter_id": 23175, "verse_number": "४-१११-४१", "content_sanskrit": "तीर्थस्नानानि सर्वाणि तपांस्यनशनानि च ।\nवेदपाठसहस्राणि प्रादक्षिण्यं भुवः शतम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003175041, "chapter_id": 23175, "verse_number": "४-१११-४२", "content_sanskrit": "कृष्णनामजपस्यास्य कलां नार्हन्ति षोडशीम् ।\nतेषां लोभा द्भवेत्स्वर्गफलं च सुचिरं नृणाम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003175042, "chapter_id": 23175, "verse_number": "४-१११-४३", "content_sanskrit": "स्वर्कादवश्यं पुंसश्च जपकर्तुर्हरेः पदम् ।\nके जले सर्वदेहेऽपि शयनं यस्य चाऽऽत्मनः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003175043, "chapter_id": 23175, "verse_number": "४-१११-४४", "content_sanskrit": "वदन्ति वैदिकाः सर्वे तं देवं केशवं परम् ।\nकंसश्च पातके विघ्ने रोगे शोके च दानवे ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003175044, "chapter_id": 23175, "verse_number": "४-१११-४५", "content_sanskrit": "तेषामरिर्निहन्ता च स कंसारिः प्रकीर्तितः ।\nरुद्ररूपेण संहर्ता विश्वानामपि नित्यशः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003175045, "chapter_id": 23175, "verse_number": "४-१११-४६", "content_sanskrit": "भक्तानां पातकानां च हरिस्तेन प्रकीर्तितः ।\nमा च ब्रह्मस्वरूपा या मूलप्रकृतिरीश्वरी ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003175046, "chapter_id": 23175, "verse_number": "४-१११-४७", "content_sanskrit": "नारायणीति विख्याता विष्णुमाया सनातनी ।\nमहालक्ष्मीस्वरूपा च वेदमाता सरस्वती ।\nराधा वसुंधरा गङ्गा तासां स्वामी च माधवः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003175047, "chapter_id": 23175, "verse_number": "४-१११-४८", "content_sanskrit": "ब्रह्मेशशेषादिभवैश्च वन्द्यं ध्यानैर्न किंचित्सनकादिभिश्च ।\nवेदैः पुराणैर्न निरूपितं च भजस्व भक्त्या नवनीतचोरम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003175048, "chapter_id": 23175, "verse_number": "४-१११-४९", "content_sanskrit": "क्व चापि दुग्धं क्व दघि घृतं वा नवोद्धृतं वा क्व च तक्रमीप्सितम् ।\nतेषां क्व चोरोभवतिं क्व चापि क्व बन्धनं ते भवमूलमध्ये  ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003175049, "chapter_id": 23175, "verse_number": "४-१११-५०", "content_sanskrit": "न योगिभिः सिद्धगणैर्मुनीन्द्रैर्न भक्तसंघैर्भवपद्मशेषैः ।\nयोगैर्न बद्धो न हि रक्षितुं क्षमैः कथं स वद्धस्तव मूलमध्यतः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003175050, "chapter_id": 23175, "verse_number": "४-१११-५१", "content_sanskrit": "प्रम्णानु भक्त्या स्तवनेन पूजया भजस्व पुत्रं तरसा च भारते ।\nहृत्पद्ममध्ये स्थितमीश्वरं परं ध्यानेन यत्नेन च संततं सति ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003175051, "chapter_id": 23175, "verse_number": "४-१११-५२", "content_sanskrit": "वरं वृणुष्व भद्रं ते यत्ते मनसि वाञ्छितम् ।\nसर्वं दास्यामि जगति देवानामपि दुर्लभम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003175052, "chapter_id": 23175, "verse_number": "४-१११-५३", "content_sanskrit": "यशोदोवाच ।\nहरौ च निश्चला भक्तिस्तद्दास्यं वाञ्छितं मम ।\nतव नाम्नश्च व्युत्पत्तिः का वा तद्वक्तुमर्हसि ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003175053, "chapter_id": 23175, "verse_number": "४-१११-५४", "content_sanskrit": "राधिकोवाच ।\nभवेद्भक्तिर्निश्चला ते हरेर्दास्यं च दुर्लभम् ।\nलभस्व मद्वरेणापि कथयामि सुनिर्णयम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003175054, "chapter_id": 23175, "verse_number": "४-१११-५५", "content_sanskrit": "पुरा नन्देन दृष्टाऽहं भाण्डीरे वटमूलके ।\nमया च कथितो नन्दो निषिद्धश्च प्रजेश्वरः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003175055, "chapter_id": 23175, "verse_number": "४-१११-५६", "content_sanskrit": "अहमेव स्वयं राधा छाया रायणकामिनी ।\nरायणः श्रीहरेरंशः पार्षदप्रवरो महान् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003175056, "chapter_id": 23175, "verse_number": "४-१११-५७", "content_sanskrit": "राशब्दश्च महाविष्णुर्विश्वानि यस्य लोमसु ।\nविश्वप्राणिषु विश्वेषु धा धात्री मातृवाचकः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003175057, "chapter_id": 23175, "verse_number": "४-१११-५८", "content_sanskrit": "धात्री माताऽहमेतेषां मूलप्रकृतिरीश्वरी ।\nतेन राधा समाख्याता हरिणा च पुरा बुधैः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003175058, "chapter_id": 23175, "verse_number": "४-१११-५९", "content_sanskrit": "अहं सुदामशापेन वृषभानसुताऽधुना ।\nशतवर्षं च विच्छेदो हरिणा सह सांप्रतम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003175059, "chapter_id": 23175, "verse_number": "४-१११-६०", "content_sanskrit": "वृषभानश्च कृष्णस्य पार्षदप्रवरो महान् ।\nपितॄणां मानसी कन्या मम माता कलावती ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003175060, "chapter_id": 23175, "verse_number": "४-१११-६१", "content_sanskrit": "अयोनिसंभवाऽहं च मम माता च भारते ।\nपुनः सार्थं च युष्माभिर्यास्यामि श्रीहरेः पदम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003175061, "chapter_id": 23175, "verse_number": "४-१११-६२", "content_sanskrit": "इति ते कथितं सर्वं व्रजं व्रज व्रजेश्वरि ।\nव्रजेश्वरेण सहिता स्वामिना ज्ञानिना सति ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003175062, "chapter_id": 23175, "verse_number": "४-१११-६३", "content_sanskrit": "ममाधुना च भवती ध्यानस्य व्यवधानिका ।\nध्यानभङ्गे महादोषो नराणामपि सुन्दरि ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}]