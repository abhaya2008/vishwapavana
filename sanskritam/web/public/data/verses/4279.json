[{"id": 2151035, "chapter_id": 4279, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2151036, "chapter_id": 4279, "verse_number": "१", "content_sanskrit": "भारतस्यास्य वर्षस्य तथा हैमवतस्य च ।\nप्रमाणमायुषः सूत फलं चापि शुभाशुभम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2151037, "chapter_id": 4279, "verse_number": "२", "content_sanskrit": "अनागतमतिक्रान्तं वर्तमानं च सञ्जय ।\nआचक्ष्व मे विस्तरेण हरिवर्षं तथैव च\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2151038, "chapter_id": 4279, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2151039, "chapter_id": 4279, "verse_number": "३", "content_sanskrit": "चत्वारि भारते वर्षे युगानि भरतर्षभ ।\nकृतं त्रेता द्वापरं च तिष्यं च कुरुवर्धन\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2151040, "chapter_id": 4279, "verse_number": "४", "content_sanskrit": "पूर्वं कृतयुगं नाम ततस्त्रेतायुगं विभो ।\nसङ्क्षेपाद् द्वापरस्याथ ततस्तिष्यं प्रवर्तते\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2151041, "chapter_id": 4279, "verse_number": "५", "content_sanskrit": "चत्वारि च सहस्राणि वर्षाणां कुरुसत्तम ।\nआयुःसङ्ख्या कृतयुगे सङ्ख्याता राजसत्तम\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2151042, "chapter_id": 4279, "verse_number": "६", "content_sanskrit": "तथा त्रीणि सहस्राणि त्रेतायां मनुजाधिप ।\nद्विसहस्रं द्वापरे तु शते तिष्ठति सम्प्रति\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2151043, "chapter_id": 4279, "verse_number": "७", "content_sanskrit": "न प्रमाणस्थितिर्ह्यस्ति तिष्येऽस्मिन् भरतर्षभ ।\nगर्भस्थाश्च म्रियन्तेऽत्र तथा जाता म्रियन्ति च\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2151044, "chapter_id": 4279, "verse_number": "८", "content_sanskrit": "महाबला महासत्त्वाः प्रजा गुणसमन्विताः ।\nअजायन्त कृते राजन् मुनयः सुतपोधनाः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2151045, "chapter_id": 4279, "verse_number": "९", "content_sanskrit": "महोत्साहा महात्मानो धार्मिकाः सत्यवादिनः ।\nजाताः कृतयुगे राजन् धनिनः प्रियदर्शनाः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2151046, "chapter_id": 4279, "verse_number": "१०", "content_sanskrit": "आयुष्मन्तो महावीरा धनुर्धरवरा युधि ।\nजायन्ते क्षत्रियाः शूरास्त्रेतायां चक्रवर्तिनः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2151047, "chapter_id": 4279, "verse_number": "११", "content_sanskrit": "सर्ववर्णा महाराज जायन्ते द्वापरे सति ।\nमहोत्साहा महावीर्याः परस्परवधैषिणः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2151048, "chapter_id": 4279, "verse_number": "१२", "content_sanskrit": "तेजसाऽल्पेन संयुक्ताः क्रोधनाः पुरुषा नृप ।\nलुब्धाश्चानृतकाश्चैव तिष्ये जायन्ति भारत\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2151049, "chapter_id": 4279, "verse_number": "१३", "content_sanskrit": "ईर्ष्या मानस्तथा क्रोधो मायाऽसूया तथैव च ।\nतिष्ये भवन्ति मर्त्यानां रागो लोभश्च भारत\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2151050, "chapter_id": 4279, "verse_number": "१४", "content_sanskrit": "सङ्क्षेपो वर्तन्ते राजन् द्वापरेऽस्मिन् नराधिप ।\nगुणोत्तरं हैमवतं हरिवर्षं ततः परम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2151051, "chapter_id": 4279, "verse_number": "११", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां भीष्मपर्वणि\nएकादशोऽध्यायः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2151052, "chapter_id": 4279, "verse_number": "", "content_sanskrit": "॥ समाप्तम् जम्बूखण्डविनिर्माणपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]