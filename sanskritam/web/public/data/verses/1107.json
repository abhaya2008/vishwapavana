[{"id": 2005492, "chapter_id": 1107, "verse_number": "१-१०८-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2005493, "chapter_id": 1107, "verse_number": "१-१०८-१", "content_sanskrit": "चेदिराजसुतां ज्ञात्वा दाशराजेन वर्धिताम्।\nविवाहं कारयामास शास्त्रदृष्टेन कर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2005494, "chapter_id": 1107, "verse_number": "१-१०८-२", "content_sanskrit": "ततो विवाहे निर्वृत्ते स राजा शान्तनुर्नृपः।\nतां कन्यां रूपसंपन्नां स्वगृहे संन्यवेशयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2005495, "chapter_id": 1107, "verse_number": "१-१०८-३", "content_sanskrit": "ततः शान्तनवो धीमान्सत्यवत्यामजायत।\nवीरश्चित्राङ्गदो नाम वीर्यवान्पुरुषेश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2005496, "chapter_id": 1107, "verse_number": "१-१०८-४", "content_sanskrit": "अथापरं महेष्वासं सत्यवत्यां सुतं प्रभुः।\nविचित्रवीर्यं राजानं जनयामास वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2005497, "chapter_id": 1107, "verse_number": "१-१०८-५", "content_sanskrit": "अप्राप्तवति तस्मिंस्तु यौवनं पुरुषर्षभे।\nस राजा शान्तनुर्धीमान्कालधर्ममुपेयिवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2005498, "chapter_id": 1107, "verse_number": "१-१०८-६", "content_sanskrit": "स्वर्गते शान्तनौ भीष्मश्चित्राङ्गदमरिन्दनम्।\nस्थापयामास वै राज्ये सत्यवत्या मते स्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2005499, "chapter_id": 1107, "verse_number": "१-१०८-७", "content_sanskrit": "स तु चित्राङ्गदः शौर्यात्सर्वांश्चिक्षेप पार्थिवान्।\nमनुष्यं न हि मेन स कंचित्सदृशमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2005500, "chapter_id": 1107, "verse_number": "१-१०८-८", "content_sanskrit": "तं क्षिपन्तं सुरांश्चैव मनुष्यानसुरांस्तथा।\nगन्धर्वराजो बलवांस्तुल्यनामाऽभ्ययात्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2005501, "chapter_id": 1107, "verse_number": "१-१०८-९x", "content_sanskrit": "गन्धर्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2005502, "chapter_id": 1107, "verse_number": "१-१०८-९", "content_sanskrit": "त्वं वै सदृशनामासि युद्धं देहि नृपात्मज।\nनाम वाऽन्यत्प्रगृह्णीष्व यदि युद्धं न दास्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2005503, "chapter_id": 1107, "verse_number": "१-१०८-१०", "content_sanskrit": "त्वयाहं युद्धमिच्छामि त्वत्सकाशं तु नामतः।\nआगतोस्मि वृथाऽऽभाष्य न गच्छेन्नाम ते मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2005504, "chapter_id": 1107, "verse_number": "१-१०८-११", "content_sanskrit": "इत्युक्त्वा गर्जमानौ तौ हिरण्वत्यास्तटं गतौ।\nतेनास्य सुमहद्युद्धं कुरुक्षेत्रे बभूव ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2005505, "chapter_id": 1107, "verse_number": "१-१०८-१२", "content_sanskrit": "तयोर्बलवतोस्तत्र गन्धर्वकुरुमुख्ययोः।\nनद्यास्तीरे हिरण्वत्याः समास्तिस्रोऽभवद्रणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2005506, "chapter_id": 1107, "verse_number": "१-१०८-१३", "content_sanskrit": "तस्मिन्विमर्दे तुमुले शस्त्रवर्षसमाकुले।\nमायाधिकोऽवधीद्वीरं गन्धर्वः कुरुसत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2005507, "chapter_id": 1107, "verse_number": "१-१०८-१४", "content_sanskrit": "स हत्वा तु नरश्रेष्ठं चित्राङ्गदमरिन्दमम्।\nअन्ताय कृत्वा गन्धर्वो दिवमाचक्रमे ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2005508, "chapter_id": 1107, "verse_number": "१-१०८-१५", "content_sanskrit": "तस्मिन्पुरुषशार्दूले निहते भूरितेजसि।\nभीष्मः शान्तनवो राजा प्रेतकार्याण्यकारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2005509, "chapter_id": 1107, "verse_number": "१-१०८-१६", "content_sanskrit": "विचित्रवीर्यं च तदा बालमप्राप्तयौवनम्।\nकुरुराज्ये महाबाहुरभ्यषिञ्चदनन्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2005510, "chapter_id": 1107, "verse_number": "१-१०८-१७", "content_sanskrit": "विचित्रवीर्यः स तदा भीष्मस्य वचने स्थितः।\nअन्वशासन्महाराज पितृपैतामहं पदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2005511, "chapter_id": 1107, "verse_number": "१-१०८-१८", "content_sanskrit": "स धर्मशास्त्रकुशलं भीष्मं शान्तनवं नृपः।\nपूजयामास धर्मेण स चैनं प्रत्यपालयत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2005512, "chapter_id": 1107, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि अष्टाधिकशततमोऽध्यायः॥ १०८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]