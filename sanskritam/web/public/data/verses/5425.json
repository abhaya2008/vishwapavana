[{"id": 2207524, "chapter_id": 5425, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2207525, "chapter_id": 5425, "verse_number": "१", "content_sanskrit": "यस्मादेकान्तमासीनः तूष्णीं किञ्चिदचिन्तयन् ।\nपूर्वं पूर्वं परित्यज्य स निरारम्भको भवेत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2207526, "chapter_id": 5425, "verse_number": "२", "content_sanskrit": "सर्वमित्रः सर्वसहः समरक्तो जितेन्द्रियः ।\nव्यपेतभयमन्युश्च कामहा मुच्यते नरः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2207527, "chapter_id": 5425, "verse_number": "३", "content_sanskrit": "आत्मवत् सर्वभूतेषु यश्चरेन्नियतः शुचिः ।\nनित्यमेव यथान्यायं यश्चरेन्नियतेन्द्रियः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2207528, "chapter_id": 5425, "verse_number": "४", "content_sanskrit": "अमानी निरभीमानः सर्वतो मुक्त एव सः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2207529, "chapter_id": 5425, "verse_number": "५", "content_sanskrit": "जीवितं मरणं चोभे सुखदुःखे तथैव च ।\nलाभालाभौ प्रियद्वेष्यौ यस्य साम्येन वर्तते\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2207530, "chapter_id": 5425, "verse_number": "६", "content_sanskrit": "कञ्चिन्न तु स्पृहायेत नाभिजानाति किञ्चन ।\nनिर्द्वन्द्वो वीतरागात्मा सर्वतो मुक्त एव सः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2207531, "chapter_id": 5425, "verse_number": "७", "content_sanskrit": "अनमित्रो न बद्धश्चाप्यनपत्यश्च यः क्वचित् ।\nत्यक्तधर्मार्थकामश्च निराकाङ्क्षी स मुच्यते\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2207532, "chapter_id": 5425, "verse_number": "८", "content_sanskrit": "नैव धर्मी न चाधर्मी पूर्वोपचितहा च यः ।\nक्षीणधातुः प्रशान्तश्च निर्द्वन्द्वः स विमुच्यते\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2207533, "chapter_id": 5425, "verse_number": "९", "content_sanskrit": "अकर्मा चाविकाङ्क्षश्च पश्यन् जगदशाश्वतम् ।\nअस्वस्थमवशं नित्यं जन्मसंसारमोहितम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2207534, "chapter_id": 5425, "verse_number": "१०", "content_sanskrit": "वैराग्यबुद्धिः सततं तापदोषव्यपेक्षकः ।\nआत्मबन्धविनिर्मोक्षं स करोत्यचिरादिव\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2207535, "chapter_id": 5425, "verse_number": "११", "content_sanskrit": "अगन्धरसमस्पर्शमशब्दमपरिग्रहम् ।\nअरूपमनभिज्ञेयं दृष्ट्वाऽऽत्मानं विमुच्यते\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2207536, "chapter_id": 5425, "verse_number": "१२", "content_sanskrit": "पञ्चभूतगुणैर्भग्नममूर्तिमविलेपनम् ।\nअगुणं गुणभोक्तारं यः पश्यति स मुच्यते\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2207537, "chapter_id": 5425, "verse_number": "१३", "content_sanskrit": "विहाय सर्वसङ्कल्पान् बुद्ध्या शारीरमानसान् ।\nशनैर्निर्वाणमाप्नोति निरिन्धन इवानलः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2207538, "chapter_id": 5425, "verse_number": "१४", "content_sanskrit": "विमुक्तः सर्वसंस्कारैस्ततो ब्रह्म सनातनम् ।\nपरमाप्नोति वै शान्तो ह्यचलं दिव्यमक्षरम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2207539, "chapter_id": 5425, "verse_number": "१५", "content_sanskrit": "अतः परं प्रवक्ष्यामि योगशास्त्रमनुत्तमम् ।\nयज्ज्ञात्वा सिद्धमात्मानं लोके पश्यन्ति योगिनः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2207540, "chapter_id": 5425, "verse_number": "१६", "content_sanskrit": "तस्योपदेशं वक्ष्यामि यथावत् तन्निबोध मे ।\nयैर्योगैर्भावयन् नित्यं पश्यत्यात्मानमात्मनि\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2207541, "chapter_id": 5425, "verse_number": "१७", "content_sanskrit": "इन्द्रियाण्युपसंहृत्य मन आत्मनि धारयेत् ।\nतीव्रं तप्त्वा तपः पूर्वं ततो योक्तुमुपक्रमेत्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2207542, "chapter_id": 5425, "verse_number": "१८", "content_sanskrit": "तपस्वी नित्यसङ्कल्पो दम्भाहङ्कारवर्जितः ।\nमनीषी मनसा विप्रः पश्यत्यात्मानमात्मनि\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2207543, "chapter_id": 5425, "verse_number": "१९", "content_sanskrit": "न चेच्छक्नोत्ययं साधुर्योक्तुमात्मानमात्मनि ।\nतत एकान्तशीलः सन् पश्यत्यात्मानमात्मनि\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2207544, "chapter_id": 5425, "verse_number": "२०", "content_sanskrit": "संयतः सततं युक्त आत्मवान् नियतेन्द्रियः ।\nयथाऽयमात्मन्यात्मानं साधु युक्तः प्रपश्यति\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2207545, "chapter_id": 5425, "verse_number": "२१", "content_sanskrit": "यथा हि पुरुषं स्वप्ने दृष्ट्वा पश्यत्यसाविति ।\nतथारूपमिवात्मानं साधु युक्तः प्रपश्यति\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2207546, "chapter_id": 5425, "verse_number": "२२", "content_sanskrit": "इषीकां वा यथा मुञ्जात् कश्चिन्निहृत्य दर्शयेत् ।\nयोगी निविष्टमात्मानं तथा सम्पश्यते तनौ\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2207547, "chapter_id": 5425, "verse_number": "२३", "content_sanskrit": "मुञ्जं शरीरं तस्याहुरिषीकामात्मनि श्रिताम् ।\nएतन्निदर्शनं प्रोक्तं योगविद्भिरनुत्तमम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2207548, "chapter_id": 5425, "verse_number": "२४", "content_sanskrit": "यदा हि युक्तमात्मानं सम्यक् पश्यति देहभृत् ।\nतदाऽस्य केशवे भक्तिस्त्रैलोक्यस्यापि यः प्रभुः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2207549, "chapter_id": 5425, "verse_number": "२५", "content_sanskrit": "अन्या अन्याश्च तनवो यथेष्टं प्रतिपद्यते ।\nविनिर्भिद्य जरां मृत्युं न हृष्यति न शोचति\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2207550, "chapter_id": 5425, "verse_number": "२६", "content_sanskrit": "देवानामपि देवत्वं युक्तः कारयते वशी ।\nब्रह्म चाव्ययमाप्नोति हित्वा देहमशाश्वतम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2207551, "chapter_id": 5425, "verse_number": "२७", "content_sanskrit": "विनश्यत्स्वपि लोकेषु न भयं तस्य जायते ।\nक्लिश्यमानेषु भूतेषु न स क्लिश्यति केनचित्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2207552, "chapter_id": 5425, "verse_number": "२८", "content_sanskrit": "दुःखशोकमलैर्घोरैः सङ्गस्नेहसमुद्भवैः ।\nन विचाल्येत युक्तात्मा निस्पृहः शान्तमानसः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2207553, "chapter_id": 5425, "verse_number": "२९", "content_sanskrit": "नैनं शस्त्राणि विध्यन्ते न मृत्युश्चास्य विद्यते ।\nनातः सुखतरं किञ्चिल्लोके क्वचन विद्यते\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2207554, "chapter_id": 5425, "verse_number": "३०", "content_sanskrit": "सम्यग्युक्तो यदाऽऽत्मानमात्मन्येव प्रपश्यति ।\nतदैव न स्पृहयति साक्षादपि मरुत्पतेः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2207555, "chapter_id": 5425, "verse_number": "३१", "content_sanskrit": "निर्वेदस्तु न गन्तव्यो युञ्जानेन कथञ्चन\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2207556, "chapter_id": 5425, "verse_number": "३२", "content_sanskrit": "योगमेकान्तशीलस्तु यथा विन्दति तच्छृणु\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2207557, "chapter_id": 5425, "verse_number": "३३", "content_sanskrit": "दृष्टपूर्वां दिशं ध्यात्वा यस्मिन् सन्निवसेत् पुरे ।\nपुरस्याभ्यन्तरे तस्य मनश्चार्यं न बाह्यतः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2207558, "chapter_id": 5425, "verse_number": "३४", "content_sanskrit": "पुरस्याभ्यन्तरे तिष्ठन् यस्मिन्नावसथे वसेत् ।\nतस्मिन्नावसथे चार्यं न बाह्याभ्यन्तरे मनः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2207559, "chapter_id": 5425, "verse_number": "३५", "content_sanskrit": "प्रचिन्त्यावसथं कृत्स्नं यस्मिन् कायेऽवतिष्ठते ।\nतस्मिन् काये मनश्चार्यं न कथञ्चन बाह्यतः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2207560, "chapter_id": 5425, "verse_number": "३६", "content_sanskrit": "सन्नियम्येन्द्रियग्रामं निर्घोषे निर्जने शुभे ।\nकायमभ्यन्तरे कृत्स्नमेकाग्रः परिचिन्तयेत्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2207561, "chapter_id": 5425, "verse_number": "३७", "content_sanskrit": "दन्तांस्तालु च जिह्वां च गलं ग्रीवां तथैव च ।\nहृदयं चिन्तयेच्चापि तथा हृदयबन्धनम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2207562, "chapter_id": 5425, "verse_number": "३८", "content_sanskrit": "इत्युक्तः स मया शिष्यो मेधावी मधुसूदन ।\nपप्रच्छ पुनरेवेमं मोक्षधर्मं सुदुर्वचम्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2207563, "chapter_id": 5425, "verse_number": "", "content_sanskrit": "शिष्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2207564, "chapter_id": 5425, "verse_number": "३९", "content_sanskrit": "भुक्तं भुक्तं कथमिदमन्नं कोष्ठे विपच्यते ।\nकथं रसत्वं व्रजति शोणितं जायते कथम्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2207565, "chapter_id": 5425, "verse_number": "४०", "content_sanskrit": "कथं मांसं च मेदश्च स्नाय्वस्थीनि च पोषयेत् ।\nकथमेतानि सर्वाणि शरीरापि शरीरिणाम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2207566, "chapter_id": 5425, "verse_number": "४१", "content_sanskrit": "वर्धन्ते वर्धमानस्य वर्धते च कथं बलम् ।\nनिरासनं निष्कसनं मलानां च पृथक् पृथक्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2207567, "chapter_id": 5425, "verse_number": "४२", "content_sanskrit": "कुतो वायुः प्रश्वसिति उच्छ्वसित्यपि वा पुनः ।\nकथं देहमधिष्ठाय तिष्ठत्यात्माऽयमात्मनि\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2207568, "chapter_id": 5425, "verse_number": "४३", "content_sanskrit": "जीवः कायं वहति चेच्चेष्टमानः कलेबरम् ।\nकिंवर्णः कीदृशश्चैव निवेशयति वै मनः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2207569, "chapter_id": 5425, "verse_number": "४४", "content_sanskrit": "याथातथ्येन भगवन् वक्तुमर्हसि मेऽनघ\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2207570, "chapter_id": 5425, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2207571, "chapter_id": 5425, "verse_number": "समाप्तिः", "content_sanskrit": "इति सम्परिपृष्टोऽहं तेन विप्रेण माधव ।\nप्रत्यब्रवं महाप्राज्ञ यथाश्रुतमरिन्दम\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2207572, "chapter_id": 5425, "verse_number": "४६", "content_sanskrit": "यथा श्वगोष्ठे प्रक्षिप्य नष्टे भाण्डमना भवेत्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2207573, "chapter_id": 5425, "verse_number": "४७", "content_sanskrit": "तथा स्वकायं प्रक्षिप्य मनोद्वारैरनिश्चलैः ।\nआत्मानं तत्र मार्गेत प्रमादं परिवर्जयेत्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2207574, "chapter_id": 5425, "verse_number": "४८", "content_sanskrit": "एवं सततमुद्युक्तः प्रीतात्मा नचिरात् स च ।\nआसादयति तद् ब्रह्म यद् दृष्ट्वा स्यात् प्रधानवित्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2207575, "chapter_id": 5425, "verse_number": "४९", "content_sanskrit": "न त्वसौ चक्षुषा ग्राह्यो न च सर्वैरपीन्द्रियैः ।\nमनसा तु प्रदीपेन महानात्मा प्रदृश्यते\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2207576, "chapter_id": 5425, "verse_number": "५०", "content_sanskrit": "सर्वतः पादपाणिं तं सर्वतोक्षिशिरोमुखम् ।\nजीवो निष्क्रान्तमात्मानं शरीरात् सम्प्रपश्यति\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2207577, "chapter_id": 5425, "verse_number": "५१", "content_sanskrit": "स तमुत्सृज्य देहं तत् प्रध्यायद् ब्रह्म केवलम् ।\nआत्मानमालोकयति मनसा प्रहसन्निव\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2207578, "chapter_id": 5425, "verse_number": "५२", "content_sanskrit": "इदं सर्वं रहस्यं ते मयोक्तं द्विजसत्तम ।\nआपृच्छे साधयिष्यामि गच्छ विप्र यथासुखम्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2207579, "chapter_id": 5425, "verse_number": "५३", "content_sanskrit": "इत्युक्तः स तदा कृष्ण मया शिष्यो महातपाः ।\nअगच्छद् वै यथाकामं ब्राह्मणश्छिन्नसंशयः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2207580, "chapter_id": 5425, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि\nएकोनविंशोऽध्यायः ॥१९॥\nअनुगीतापर्वणि चतुर्थोऽध्यायः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]