[{"id": 7003264000, "chapter_id": 23264, "verse_number": "१-६७-१", "content_sanskrit": "ययातिरुवाच  ।\nब्राह्मणप्रमुखा वर्णाः सर्वे श्रृण्वन्तु मे वचः  ।\nज्येष्ठं प्रति यथा राज्यं न देयं मे कथंचन ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003264001, "chapter_id": 23264, "verse_number": "१-६७-२", "content_sanskrit": "मम ज्येष्ठेन यदुना नियोगो नानुपालितः  ।\nप्रतिकूलमतिश्चैव न स पुत्रः सतां मतः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003264002, "chapter_id": 23264, "verse_number": "१-६७-३", "content_sanskrit": "मातापित्रोर्वचनकृत्सद्भिः पुत्रः प्रशस्यते  ।\nस पुत्रः पुत्रवद्यस्तु वर्तते मातृपितृषु ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003264003, "chapter_id": 23264, "verse_number": "१-६७-४", "content_sanskrit": "यदुनाहमवज्ञातस्तथा तुर्वसुनापि च  ।\nद्रुह्येन चानुना चैव मय्यवज्ञा कृता भृशम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003264004, "chapter_id": 23264, "verse_number": "१-६७-५", "content_sanskrit": "पुरुणा च कृतं वाक्यं मानितश्च विशेषतः  ।\nकनीयान्मम दायादो जरा येन धृता मम ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003264005, "chapter_id": 23264, "verse_number": "१-६७-६", "content_sanskrit": "शुक्रेण मे समादिष्टा देवयान्याः कृते जरा  ।\nप्रार्थितेन पुनस्तेन जरा संचारिणी कृता ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003264006, "chapter_id": 23264, "verse_number": "१-६७-७", "content_sanskrit": "शुक्रेण च वरो दत्तः काव्येनोशनसा क्वयम्  ।\nपुत्रो यस्त्वानुवर्तेत स ते राज्यधरस्त्विति ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003264007, "chapter_id": 23264, "verse_number": "१-६७-८", "content_sanskrit": "भवंतोऽप्यनुजानंतु पूरू राज्येऽभिषिच्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003264008, "chapter_id": 23264, "verse_number": "१-६७-९", "content_sanskrit": "प्रकृतय ऊचुः  ।\nयः पुत्रो गुणसंपन्नो मातापित्रोर्हितः सदा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003264009, "chapter_id": 23264, "verse_number": "१-६७-१०", "content_sanskrit": "सर्वमर्हति कल्याणं कनीया नपि स प्रभुः  ।\nअर्हः पूरुरिदं राज्यं यः सुतो वाक्यकृत्तव ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003264010, "chapter_id": 23264, "verse_number": "१-६७-११", "content_sanskrit": "वरदानेन शुक्रस्य न शक्यं कर्तुमन्यथा  ।\nसूत उवाच  ।\nएवं जानपदैस्तुष्टैरित्युक्तो नाहुषस्तदा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003264011, "chapter_id": 23264, "verse_number": "१-६७-१२", "content_sanskrit": "अभिषिच्य ततो राज्यं पूरुं स सुतमात्मनः  ।\nदिशि दक्षिणपूर्वस्यां तुर्वसुं पुत्रमादिशत् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003264012, "chapter_id": 23264, "verse_number": "१-६७-१३", "content_sanskrit": "दक्षिणायामथो राजा यदुं ज्येष्ठं न्ययोजयेत्  ।\nप्रतीच्यामुत्तरस्यां तु द्रुह्युं चानुं च तावुभौ ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003264013, "chapter_id": 23264, "verse_number": "१-६७-१४", "content_sanskrit": "सप्तद्वीपां ययातिस्तु जित्वा पृथ्वीं ससागराम्  ।\nव्यभजच्च त्रिधा राज्यं पुत्रेभ्यो नाहुषस्तदा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003264014, "chapter_id": 23264, "verse_number": "१-६७-१५", "content_sanskrit": "पुत्रसंक्रामितश्रीस्तु हर्षनिर्भरमानसः  ।\nप्रीतिमानभवद्राजा भारमावेश्य बंधुषु ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003264015, "chapter_id": 23264, "verse_number": "१-६७-१६", "content_sanskrit": "अत्र गाथा महाराज्ञा पुरा गीता ययातिना  ।\nयाभिः प्रत्याहरेत्कामान्सर्वतोंगानि कूर्मवत् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003264016, "chapter_id": 23264, "verse_number": "१-६७-१७", "content_sanskrit": "ताभिरेव नरः श्रीमान्नान्यथा कर्मकोटिकृत्  ।\nन जातु कामः कामानामुपभोगेन शाम्यति ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003264017, "chapter_id": 23264, "verse_number": "१-६७-१८", "content_sanskrit": "हविषा कृष्णवर्त्मेव भूय एवाभिवर्धते  ।\nयत्पृथिव्यां व्रीहियवं हिरण्यं पशवः स्त्रियः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003264018, "chapter_id": 23264, "verse_number": "१-६७-१९", "content_sanskrit": "नालमेकस्य तत्सर्वमिति मत्वा शमं व्रजेत्  ।\nयदा न कुरुते भावं सर्वभूतेषु पापकम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003264019, "chapter_id": 23264, "verse_number": "१-६७-२०", "content_sanskrit": "कर्मण मनसा वाचा ब्रह्म संपद्यते तदा  ।\nयदा परान्न बिभेति परे चास्मान्न बिभ्यति ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003264020, "chapter_id": 23264, "verse_number": "१-६७-२१", "content_sanskrit": "यदा न निन्देन्न द्वोष्टि ब्रह्म संपद्यते तदा  ।\nया दुस्त्यजा दुर्मतिभिर्या न जीर्यति जीर्यतः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003264021, "chapter_id": 23264, "verse_number": "१-६७-२२", "content_sanskrit": "योसौ प्राणान्तिको रोगस्तां तृष्णां त्यजतः सुखम्  ।\nजीर्यन्ति जीर्यतः केशा दन्ता जीर्यांति जीर्यतः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003264022, "chapter_id": 23264, "verse_number": "१-६७-२३", "content_sanskrit": "चक्षुः श्रोत्रे च जीर्येते तृष्णैका निरुपद्रवा  ।\nजीर्यंति देहिनः सर्वे स्वभावादेव नान्यथा ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003264023, "chapter_id": 23264, "verse_number": "१-६७-२४", "content_sanskrit": "जीविताशा धनाशा च जीयतोपि न जीर्यते  ।\nयच्च कामसुखं लोके यच्च दिव्यं महत्सुखम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003264024, "chapter_id": 23264, "verse_number": "१-६७-२५", "content_sanskrit": "तृष्णाक्षयसुखस्यैतत्कलां नार्हति षोडशीम्  ।\nएवमुक्त्वा स राजर्षिः सदारः प्राविशद्वनम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003264025, "chapter_id": 23264, "verse_number": "१-६७-२६", "content_sanskrit": "भृगुतुंगे तपस्ते वा तत्रैव च महायशाः  ।\nसाधयित्वा त्वनशनं सदारः स्वर्गमाप्तवान् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003264026, "chapter_id": 23264, "verse_number": "१-६७-२७", "content_sanskrit": "तस्य वंशास्तु पंचैते पुण्या देवर्षिसत्कृताः  ।\nयैर्व्याप्ता पृथिवी कृत्स्ना सूर्यस्येव मरीचिभिः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003264027, "chapter_id": 23264, "verse_number": "१-६७-२८", "content_sanskrit": "धनी प्रजावानायुष्मान्कीर्तिमांश्च भवेन्नरः  ।\nययातिचरितं पुण्यं पठञ्छृण्वंश्च बुद्धिमान् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003264028, "chapter_id": 23264, "verse_number": "१-६७-२९", "content_sanskrit": "सर्वपाप विनिर्मुक्तः शिवलोके महीयते ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]