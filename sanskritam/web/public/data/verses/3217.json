[{"id": 2102460, "chapter_id": 3217, "verse_number": "१४-७३-१", "content_sanskrit": "वैशम्पायन उवाच।\nदीक्षाकाले तु सम्प्राप्ते ततस्ते सुमहर्त्विजः।\nविधिवद्दीक्षयामासुरश्वमेधाय पार्थिवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2102461, "chapter_id": 3217, "verse_number": "१४-७३-२", "content_sanskrit": "कृत्वा स पशुमेधांश्च दीक्षितः पाण्डुनन्दनः।\nधर्मराजो महातेजाः सहर्त्विग्भिर्व्यरोचत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2102462, "chapter_id": 3217, "verse_number": "१४-७३-३", "content_sanskrit": "हयश्च हयमेधार्थं स्वयं स ब्रह्मवादिना।\nउत्सृष्टः शास्त्रविधिना व्यासेनामिततेजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2102463, "chapter_id": 3217, "verse_number": "१४-७३-४", "content_sanskrit": "स राजा राजधर्मेण दीक्षितो विबभौ तदा।\nहेममाली रुक्मकण्ठः प्रदीप्त इव पावकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2102464, "chapter_id": 3217, "verse_number": "१४-७३-५", "content_sanskrit": "कृष्णाजिनी दण्डपाणिः क्षौमवासाः स धर्मजः।\nविबभौ द्युतिमान्भूयः प्रजापतिरिवाध्वरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2102465, "chapter_id": 3217, "verse_number": "१४-७३-६", "content_sanskrit": "तथैवास्यर्त्विजः सर्वे तुल्यवेषा विशांपते।\nबभूवुरर्जुनश्चापि प्रदीप्त इव पावकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2102466, "chapter_id": 3217, "verse_number": "१४-७३-७", "content_sanskrit": "श्वेताश्वः कपिकेतुश्च ससाराश्वं धनञ्जयः।\nविधिवत्पृथिवीपाल धर्मराजस्य शासनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2102467, "chapter_id": 3217, "verse_number": "१४-७३-८", "content_sanskrit": "**क्षिपन्गाण्डिवं राजन्बद्धगोधाङ्गुलित्रवान्।\nतमश्वं पृथिवीपाल मुदा युक्तः ससार च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2102468, "chapter_id": 3217, "verse_number": "१४-७३-९", "content_sanskrit": "अनुमार्गं तदा राजन्नागमत्तत्पुरं विभो।\nद्रष्टुकामं कुरुश्रेष्ठं प्रयास्यनतं धनञ्जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2102469, "chapter_id": 3217, "verse_number": "१४-७३-१०", "content_sanskrit": "तेषामन्योन्यसम्मर्दादूष्मेव समाजायत।\nदिदृक्षूणां हयं तं च तं चैव हयसारिणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2102470, "chapter_id": 3217, "verse_number": "१४-७३-११", "content_sanskrit": "ततः शब्दो महाराज दिशः खं प्रतिपूरयन्।\nबभूव प्रेक्षतां नॄमां कुन्तीपुत्रं धनंजयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2102471, "chapter_id": 3217, "verse_number": "१४-७३-१२", "content_sanskrit": "एष गच्छति कौन्तेयस्तुरगश्चैव दीप्तिमान्।\nसमन्वेति महाबाहुः संस्पृशन्धनुरुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2102472, "chapter_id": 3217, "verse_number": "१४-७३-१३", "content_sanskrit": "एवं शुश्राव वदतां गिरो जिष्णुरुदारधीः।\nस्वस्ति तेऽस्तु व्रजारिष्टं पुनश्चैहीति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2102473, "chapter_id": 3217, "verse_number": "१४-७३-१४", "content_sanskrit": "अथापरे मनुष्येन्द्र पुरुषा वाक्यमब्रुवन्।\nनैनं पश्याम सम्मर्दे धनुरेतत्प्रदृश्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2102474, "chapter_id": 3217, "verse_number": "१४-७३-१५", "content_sanskrit": "एतद्धि भीमनिर्ह्रादं विश्रुतं गाण्डिवं धनुः।\nस्वस्ति गच्छत्वरिष्टो वै पन्थानमकुतोभयम्।\nनिवृत्तमेनं द्रक्ष्यामः पुनरेष्यति च ध्रुवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2102475, "chapter_id": 3217, "verse_number": "१४-७३-१६", "content_sanskrit": "एवमाद्या मनुष्याणां स्त्रीणां च भरतर्षभ।\nशुश्राव मधुरा वाचः पुनःपुनरुदारधीः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2102476, "chapter_id": 3217, "verse_number": "१४-७३-१७", "content_sanskrit": "याज्ञवल्क्यस्य शिष्यश्च कुशलो यज्ञकर्मणि।\nप्रायात्पार्थेन सहितः शान्त्यर्थं वेदपारगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2102477, "chapter_id": 3217, "verse_number": "१४-७३-१८", "content_sanskrit": "ब्राह्मणाश्च महीपाल बहवो वेदपारगाः।\nअनुजग्मुर्महात्मानं क्षत्रियाश्च विशाम्पते।\nविधिवत्पृथिवीपाल धर्मराजस्य शासनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2102478, "chapter_id": 3217, "verse_number": "१४-७३-१९", "content_sanskrit": "पाण्डवैः पृथिवीमश्वो निर्जितामस्त्रतेजसा।\nचचार स महाराज यथादेशं च सत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2102479, "chapter_id": 3217, "verse_number": "१४-७३-२०", "content_sanskrit": "तत्र युद्धानि वृत्तानि यान्यासन्पाण्डवस्य ह।\nतानि वक्ष्यामि ते वीर विचित्राणि महान्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2102480, "chapter_id": 3217, "verse_number": "१४-७३-२१", "content_sanskrit": "स हयः पृथिवीं राजन्प्रदक्षिणमवर्तत।\nससारेत्तरतः पूर्वं तन्निबोध महीपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2102481, "chapter_id": 3217, "verse_number": "१४-७३-२२", "content_sanskrit": "अवमृद्रन्स राष्ट्राणि पार्थिवानां हयोत्तमः।\nशनैस्तदा परिययौ श्वेताश्वश्च महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2102482, "chapter_id": 3217, "verse_number": "१४-७३-२३", "content_sanskrit": "तत्र सङ्गणना नास्ति राज्ञामयुतशस्तदा।\nयेऽयुध्यन्त महाराज क्षत्रिया हतबान्धवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2102483, "chapter_id": 3217, "verse_number": "१४-७३-२४", "content_sanskrit": "किराता यवना राजन्बहवोऽसिधनुर्धराः।\nम्लेच्छाश्चान्ये बहुविधाः पूर्वं ये निकृता रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2102484, "chapter_id": 3217, "verse_number": "१४-७३-२५", "content_sanskrit": "आर्याश्च पृथिवीपालाः प्रहृष्टनरवाहनाः।\nसमीयुः पाण्डुपुत्रेण बहवो युद्धदुर्मदाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2102485, "chapter_id": 3217, "verse_number": "१४-७३-२६", "content_sanskrit": "एवं वृत्तानि युद्धानि तत्रतत्र महीपते।\nअर्जुनस्य महीपालैर्नानादेशसमागतैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2102486, "chapter_id": 3217, "verse_number": "१४-७३-२७", "content_sanskrit": "यान्यत्र हयतो राजन्प्रवृत्तानि महान्ति च।\nतानि युद्धानि वक्ष्यामि कौन्तेयस्य तवानघ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2102487, "chapter_id": 3217, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि त्रिसप्ततितमोऽध्यायः॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]