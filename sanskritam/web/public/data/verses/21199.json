[{"id": 7001199000, "chapter_id": 21199, "verse_number": "२-३-४७-१", "content_sanskrit": "ब्रह्मोवाच ।\nततः शैलवरः सोपि प्रीत्या दुर्गोपवीतकम् ।\nकारयामास सोत्साहं वेदमन्त्रैश्शिवस्य च॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001199001, "chapter_id": 21199, "verse_number": "२-३-४७-२", "content_sanskrit": "अथ विष्ण्वादयो देवा मुनयस्सकुतू हलम् ।\nहिमाचलप्रार्थनया विवेशान्तर्गृहं गिरेः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001199002, "chapter_id": 21199, "verse_number": "२-३-४७-३", "content_sanskrit": "श्रुत्याचारं भवाचारं विधाय च यथार्थतः ।\nशिवामलंकृतां चक्रुश्शिवदत्तविभूषणैः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001199003, "chapter_id": 21199, "verse_number": "२-३-४७-४", "content_sanskrit": "प्रथमं स्नापयित्वा तां भूषयित्वाथ सर्वशः ।\nनीराजिता सखीभिश्च विप्रपत्नीभिरेव च॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001199004, "chapter_id": 21199, "verse_number": "२-३-४७-५", "content_sanskrit": "अहताम्बरयुग्मेन शोभिता वरवर्णिनी ।\nविरराज महाशैलदुहिता शङ्करप्रिया॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001199005, "chapter_id": 21199, "verse_number": "२-३-४७-६", "content_sanskrit": "कंचुकी परमा दिव्या नानारत्नान्विताद्भुता ।\nविधृता च तया देव्या विलसन्त्याधिकं मुने॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001199006, "chapter_id": 21199, "verse_number": "२-३-४७-७", "content_sanskrit": "सा बभार तथा हारं दिव्यरत्नसमन्वितम् ।\nवलयानि महार्हाणि शुद्धचामीकराणि च॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001199007, "chapter_id": 21199, "verse_number": "२-३-४७-८", "content_sanskrit": "स्थिता तत्रैव सुभगा ध्यायन्ती मनसा शिवम् ।\nशुशुभेति महाशैलकन्यका त्रिजगत्प्रसूः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001199008, "chapter_id": 21199, "verse_number": "२-३-४७-९", "content_sanskrit": "तदोत्सवो महानासीदुभयत्र मुदा वहः ।\nदानं बभूव विविधं ब्राह्मणेभ्यो विवर्णितम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001199009, "chapter_id": 21199, "verse_number": "२-३-४७-१०", "content_sanskrit": "अन्येषां द्रव्यदानं च बभूव विविधम्महत् ।\nगीतवाद्यविनोदश्च तत्रोत्सवपुरस्सरम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001199010, "chapter_id": 21199, "verse_number": "२-३-४७-११", "content_sanskrit": "अथ विष्णुरहं धाता शक्राद्या अमरास्तथा ।\nमुनयश्च महाप्रीत्या निखिलास्सोत्सवा मुदा॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001199011, "chapter_id": 21199, "verse_number": "२-३-४७-१२", "content_sanskrit": "सुप्रणम्य शिवां भक्त्या स्मृत्वा शिवपदाम्बुजम् ।\nसम्प्राप्य हिमगिर्य्याज्ञां स्वं स्वं स्थाने समाश्रिताः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001199012, "chapter_id": 21199, "verse_number": "२-३-४७-१३", "content_sanskrit": "एतस्मिन्नन्तरे तत्र ज्योतिःशास्त्र विशारदः ।\nहिमवन्तं गिरीन्द्रं तं गर्गो वाक्यमभाषत॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001199013, "chapter_id": 21199, "verse_number": "२-३-४७-१४", "content_sanskrit": "॥ गर्ग उवाच  ।\nहिमाचल धराधीश स्वामिन् कालीपतिः प्रभो ।\nपाणिग्रहार्थं शंभुं चानय त्वं निजमंदिरम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001199014, "chapter_id": 21199, "verse_number": "२-३-४७-१५", "content_sanskrit": "॥ ब्रह्मोवाच  ।\nअथ तं समयं ज्ञात्वा कन्यादानोचितं गिरिः ।\nनिवेदितं च गर्गेण मुसुदेऽतीव चेतसि॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001199015, "chapter_id": 21199, "verse_number": "२-३-४७-१६", "content_sanskrit": "महीधरान्द्विजांश्चैव परानपि तदा गिरिः ।\nप्रेषयामास सुप्रीत्या शिवानयनकाम्यया॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001199016, "chapter_id": 21199, "verse_number": "२-३-४७-१७", "content_sanskrit": "ते पर्वता द्विजाश्चैव सर्वमंगलपाणयः ।\nसंजग्मुस्सोत्सवाः प्रीत्या यत्र देवो महेश्वरः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001199017, "chapter_id": 21199, "verse_number": "२-३-४७-१८", "content_sanskrit": "तदा वादित्रघोषेण ब्रह्मघोषेण भूयसा ।\nमहोत्साहोऽभवत्तत्र गीतनृत्यान्वितेन हि॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001199018, "chapter_id": 21199, "verse_number": "२-३-४७-१९", "content_sanskrit": "श्रुत्वा वादित्रनिर्घोषं सर्वे शंकरसेवकाः ।\nउत्थितास्त्वैकपद्येन सदेवर्षिगणा मुदा॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001199019, "chapter_id": 21199, "verse_number": "२-३-४७-२०", "content_sanskrit": "परस्परं समूचुस्ते हर्षनिर्भरमानसाः ।\nअत्रागच्छंति गिरयश्शिवानयनकाम्यया॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001199020, "chapter_id": 21199, "verse_number": "२-३-४७-२१", "content_sanskrit": "पाणिग्रहणकालो हि नूनं सद्यस्समागतः ।\nमहद्भाग्यं हि सर्वेषां संप्राप्तमहि मन्महे॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001199021, "chapter_id": 21199, "verse_number": "२-३-४७-२२", "content_sanskrit": "धन्या वयं विशेषेण विवाहं शिवयोर्ध्रुवम् ।\nद्रक्ष्यामः परमप्रीत्या जगतां मंगलालयम्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001199022, "chapter_id": 21199, "verse_number": "२-३-४७-२३", "content_sanskrit": "ब्रह्मोवाच ।\nएवं यावदभूत्तेषां संवादस्तत्र चादरात् ।\nतावत्सर्वे समायाताः पर्वतेंद्रस्य मंत्रिणः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001199023, "chapter_id": 21199, "verse_number": "२-३-४७-२४", "content_sanskrit": "ते गत्वा प्रार्थयांचक्रुश्शिव विष्ण्वादिकानपि ।\nकन्यादानोचितः कालो वर्तते गम्यतामिति॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001199024, "chapter_id": 21199, "verse_number": "२-३-४७-२५", "content_sanskrit": "ते तच्छ्रुत्वा सुरास्सर्वे मुने विष्ण्वादयोऽखिलाः ।\nमुमुदुश्चेतसातीव जयेत्यूचुर्गिरिं द्रुतम्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001199025, "chapter_id": 21199, "verse_number": "२-३-४७-२६", "content_sanskrit": "शिवोऽपि मुमुदेऽतीव कालीप्रापणलालसः ।\nगुप्तं चकार तच्चिह्नं मनस्येवाद्भुताकृतिः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001199026, "chapter_id": 21199, "verse_number": "२-३-४७-२७", "content_sanskrit": "अथ स्नानं कृतन्तेन मङ्गलद्रव्यसंयुतम् ।\nशूलिना सुप्रसन्नेन लोकानुग्रहकारिणा॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001199027, "chapter_id": 21199, "verse_number": "२-३-४७-२८", "content_sanskrit": "स्नातस्सुवाससा युक्तस्सर्वैस्तैः परिवारितः ।\nआरोपितो वृषस्कन्धे लोकपालैस्सुसेवितः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001199028, "chapter_id": 21199, "verse_number": "२-३-४७-२९", "content_sanskrit": "पुरस्कृत्य प्रभुं सर्वे जग्मुर्हिमगिरेर्गृहम् ।\nवाद्यानि वादयन्तश्च कृतवन्तः कुतूहलम्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001199029, "chapter_id": 21199, "verse_number": "२-३-४७-३०", "content_sanskrit": "हिमागप्रेषिता विप्रास्तथा ते पर्वतोत्तमाः ।\nशम्भोरग्रचरा ह्यासन्कुतूहलसमन्विताः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001199030, "chapter_id": 21199, "verse_number": "२-३-४७-३१", "content_sanskrit": "बभौ छत्रेण महता ध्रियमाणो हि मूर्द्धनि ।\nचामरैर्वीज्यमानोऽसौ सविता नो महेश्वरः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001199031, "chapter_id": 21199, "verse_number": "२-३-४७-३२", "content_sanskrit": "अहं विष्णुस्तथा चेन्द्रो लोकपाला स्तथैव च ।\nअग्रगाः स्मातिशोभन्ते श्रिया परमया श्रिताः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001199032, "chapter_id": 21199, "verse_number": "२-३-४७-३३", "content_sanskrit": "ततश्शङ्खाश्च भेर्य्यश्च पटहानकगोमुखाः ।\nपुनः पुनरवाद्यन्त वादित्राणि महोत्सवे॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001199033, "chapter_id": 21199, "verse_number": "२-३-४७-३४", "content_sanskrit": "तथैव गायकास्सर्वे जगुः परममङ्गलम् ।\nनर्तक्यो ननृतुस्सर्वा नानातालसमन्विताः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001199034, "chapter_id": 21199, "verse_number": "२-३-४७-३५", "content_sanskrit": "एभिस्समेतो जगदेकबन्धुर्ययौ तदानीं परमेशवर्चसा ।\nसुसेव्यमानस्सकलैस्सुरेश्वरैर्विकीर्यमाणः कुसुमैश्च हर्षितैः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001199035, "chapter_id": 21199, "verse_number": "२-३-४७-३६", "content_sanskrit": "सम्पूजितस्तदा शम्भुः प्रविष्टो यज्ञमण्डपम् ।\nसंस्तूयमानो बह्वीभिः स्तुतिभिः परमेश्वरः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001199036, "chapter_id": 21199, "verse_number": "२-३-४७-३७", "content_sanskrit": "वृषादुत्तारयामासुर्महेशम्पर्वतोत्तमाः ।\nनिन्युर्गृहान्तरम्प्रीत्या महोत्सवपुरस्सरम्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001199037, "chapter_id": 21199, "verse_number": "२-३-४७-३८", "content_sanskrit": "हिमालयोऽपि सम्प्राप्तं सदेवगणमीश्वरम् ।\nप्रणम्य विधिवद्भक्त्या नीराजनमथाकरोत्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001199038, "chapter_id": 21199, "verse_number": "२-३-४७-३९", "content_sanskrit": "सर्वान्सुरान्मुनीनन्यान्प्रणम्य समहोत्सवः ।\nसम्मानमकरोत्तेषां प्रशंसन्स्वविधिम्मुदा॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001199039, "chapter_id": 21199, "verse_number": "२-३-४७-४०", "content_sanskrit": "सोऽगस्साच्युतमीशानं सुपाद्यार्घ्यपुरस्सरम् ।\nसदेवमुख्यवर्गं च निनाय स्वालयान्तरम्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001199040, "chapter_id": 21199, "verse_number": "२-३-४७-४१", "content_sanskrit": "प्राङ्गणे स्थापयामास रत्नसिंहासनेषु तान् ।\nसर्वान्विष्णु च मामीशं विशिष्टांश्च विशेषतः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001199041, "chapter_id": 21199, "verse_number": "२-३-४७-४२", "content_sanskrit": "सखीभिर्मेनया प्रीत्या ब्राह्मणस्त्रीभिरेव च ।\nअन्याभिश्च पुरन्धीभिश्चक्रे नीराजनम्मुदा॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001199042, "chapter_id": 21199, "verse_number": "२-३-४७-४३", "content_sanskrit": "पुरोधसा कृत्यविदा शंकराय महात्मने ।\nमधुपर्कादिकं यद्यत्कृत्यं तत्तत्कृतं मुदा॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001199043, "chapter_id": 21199, "verse_number": "२-३-४७-४४", "content_sanskrit": "मया स नोदितस्तत्र पुरोधाः कृतवांस्तदा ।\nसुमंगलं च यत्कर्म प्रस्तावसदृशम्मुने॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001199044, "chapter_id": 21199, "verse_number": "२-३-४७-४५", "content_sanskrit": "अन्तर्वेद्यां महाप्रीत्या सम्प्रविश्य हिमाद्रिणा ।\nयत्र सा पार्वती कन्या सर्वाभरणभूषिता॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001199045, "chapter_id": 21199, "verse_number": "२-३-४७-४६", "content_sanskrit": "वेदिकोपरि तन्वंगी संस्थिता सुविराजिता ।\nतत्र नीतो मद्दादेवो विष्णुना च मया सह॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001199046, "chapter_id": 21199, "verse_number": "२-३-४७-४७", "content_sanskrit": "लग्नन्निरीक्षमाणास्ते वाचस्पतिपुरोगमाः ।\nकन्यादानोचितन्तत्र बभूवुः परमोत्सवाः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001199047, "chapter_id": 21199, "verse_number": "२-३-४७-४८", "content_sanskrit": "तत्रोपविष्टो गर्गश्च यत्रास्ति घटिकालयम् ।\nयावच्छेषा घटी तावत्कृतम्प्रणवभाषणम्॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001199048, "chapter_id": 21199, "verse_number": "२-३-४७-४९", "content_sanskrit": "पुण्याहम्प्रवदन्गर्गस्समाध्रेऽञ्जलिम्मुदा ।\nपार्व्वत्यक्षतपूर्णं च ववृषे च शिवोपरि॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001199049, "chapter_id": 21199, "verse_number": "२-३-४७-५०", "content_sanskrit": "तया सम्पूजितो रुद्रो दध्यक्षतकुशाम्बुभिः ।\nपरमोदाढ्यया तत्र पार्वत्या रुचिरास्यया॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001199050, "chapter_id": 21199, "verse_number": "२-३-४७-५१", "content_sanskrit": "विलोकयन्ती तं शम्भुं यस्यार्थे परमन्तपः ।\nकृतम्पुरा महाप्रीत्या विरराज शिवाति सा॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001199051, "chapter_id": 21199, "verse_number": "२-३-४७-५२", "content_sanskrit": "मया मुने तदोक्तस्तु गर्गादिमुनिभिश्च सः ।\nसमानर्च शिवां शम्भुर्लौकिकाचारसंरतः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001199052, "chapter_id": 21199, "verse_number": "२-३-४७-५३", "content_sanskrit": "एवं परस्परं तौ वै पार्व्वतीपरमेश्वरौ ।\nअर्चयन्तौ तदानीञ्च शुशुभाते जगन्मयौ॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001199053, "chapter_id": 21199, "verse_number": "२-३-४७-५४", "content_sanskrit": "त्रैलोक्यलक्ष्म्या संवीतौ निरीक्षन्तौ परस्परम् ।\nतदा नीराजितौ लक्ष्म्यादिभिस्स्त्रीभिर्विशेषतः॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001199054, "chapter_id": 21199, "verse_number": "२-३-४७-५५", "content_sanskrit": "तथा परा वै द्विजयोषितश्च नीराजयामासुरथो पुरस्त्रियः ।\nशिवाञ्च शम्भुञ्च विलोकयन्त्योऽवापुर्म्मुदन्तास्सकला महोत्सवम्॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}]