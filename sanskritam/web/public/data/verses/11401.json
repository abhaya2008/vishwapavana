[{"id": 50008394, "chapter_id": 11401, "verse_number": "1", "content_sanskrit": "श्रीशुक उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50008395, "chapter_id": 11401, "verse_number": "2", "content_sanskrit": "निशम्य कौशारविणोपवर्णितां हरेः कथां कारणसूकरात्मनः। पुनः स पप्रच्छ समुद्यताञ्जलिर्न चातितृप्तो विदुरो धृतव्रतः॥ ३/१५/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50008396, "chapter_id": 11401, "verse_number": "3", "content_sanskrit": "विदुर उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50008397, "chapter_id": 11401, "verse_number": "4", "content_sanskrit": "तेनैव च मुनिश्रेष्ठ हरिणा यज्ञमूर्तिना। आदिदैत्यो हिरण्याक्षो हत इत्यनुशुश्रुमः॥ ३/१५/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50008398, "chapter_id": 11401, "verse_number": "5", "content_sanskrit": "तस्य चोद्धरतः क्षोणीं स्वदंष्ट्राग्रेण लीलया। दैत्यराजस्य च ब्रह्मन् कस्माद्धेतोरभून्मृधः॥ ३/१५/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50008399, "chapter_id": 11401, "verse_number": "6", "content_sanskrit": "मैत्रेय उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50008400, "chapter_id": 11401, "verse_number": "7", "content_sanskrit": "साधु वीर त्वया पृष्टमवतारकथां हरेः। यत् त्वं पृच्छसि मर्त्यानां मृत्युपाशविशातनीम्॥ ३/१५/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50008401, "chapter_id": 11401, "verse_number": "8", "content_sanskrit": "ययोत्तानपदः पुत्रो मुनिना गीतयाऽर्भकः। मृत्योः कृत्वेह मूध्र्न्यङ्घ्रिमारुरोह हरेः पदम्॥ ३/१५/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50008402, "chapter_id": 11401, "verse_number": "9", "content_sanskrit": "अथात्रापीतिहासोऽयं श्रुतो मे वर्णितः पुरा। ब्रह्मणा देवदेवेन देवानामनुपृच्छताम्॥ ३/१५/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50008403, "chapter_id": 11401, "verse_number": "10", "content_sanskrit": "दितिर्दाक्षायणी क्षत्तर्मारीचं काश्यपं पतिम्। अपत्यकामा चकमे सन्ध्यायां हृच्छयार्दिता॥ ३/१५/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50008404, "chapter_id": 11401, "verse_number": "11", "content_sanskrit": "इष्ट्वाऽग्निजिह्वं पयसा पुरुषं यजुषां पतिम्। निम्लोचत्यर्क आसीनमग्न्यागारे समाहितम्॥ ३/१५/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50008405, "chapter_id": 11401, "verse_number": "12", "content_sanskrit": "दितिरुवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50008406, "chapter_id": 11401, "verse_number": "13", "content_sanskrit": "एष मां त्वत्कृते विद्वन् काम आत्तशरासनः। धुनोति दीनां विक्रम्य रम्भामिव मतङ्गजः॥ ३/१५/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50008407, "chapter_id": 11401, "verse_number": "14", "content_sanskrit": "तद् भवान् दह्यमानायां सपत्नीनां समृद्धिभिः। प्रजावतीनां भद्रं ते मय्यायुङ्क्तामनुग्रहम्॥ ३/१५/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50008408, "chapter_id": 11401, "verse_number": "15", "content_sanskrit": "भर्तर्याप्तोरुमानानां लोकानाविशते यशः। पतिर्भवद्विधो यासां प्रजया ननु जायते॥ ३/१५/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50008409, "chapter_id": 11401, "verse_number": "16", "content_sanskrit": "पुरा पिता नो भगवान् दक्षो दुहितृवत्सलः। कं वृणीत वरं वत्सा इत्यपृच्छत नः पृथक्॥ ३/१५/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50008410, "chapter_id": 11401, "verse_number": "17", "content_sanskrit": "इति ज्ञात्वाऽऽत्मजानां नो भावं सन्तानभावनः। त्रयोदशाददात् तासां यास्ते शीलमनुव्रताः॥ ३/१५/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50008411, "chapter_id": 11401, "verse_number": "18", "content_sanskrit": "अथ मे कुरु कल्याण कामं कञ्जविलोचन। आप्तोपसर्पणं भूमन्नमोघं हि महीयसि॥ ३/१५/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50008412, "chapter_id": 11401, "verse_number": "19", "content_sanskrit": "मैत्रेय उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50008413, "chapter_id": 11401, "verse_number": "20", "content_sanskrit": "इति तां वीक्ष्य मारीचः कृपणां बहुभाषिणीम्। प्रत्याहानुनयन् वाचा प्रवृद्धानङ्गकश्मलाम्॥ ३/१५/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50008414, "chapter_id": 11401, "verse_number": "21", "content_sanskrit": "एष तेऽहं विधास्यामि प्रियं भीरु यदिच्छसि। तस्याः कामं न कः कुर्यात् सिद्धिस्त्रैवर्गिका यतः॥ ३/१५/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50008415, "chapter_id": 11401, "verse_number": "22", "content_sanskrit": "सर्वाश्रमानुपादाय स्वाश्रमेण कळत्रवान्। व्यसनार्णवमत्येति जलयानैर्यथाऽर्णवम्॥ ३/१५/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50008416, "chapter_id": 11401, "verse_number": "23", "content_sanskrit": "यामाहुरात्मनो ह्यर्धं श्रेयस्कामस्य मानिनि। यस्यां स्वधुरमध्यस्य पुमांश्चरति विज्वरः॥ ३/१५/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50008417, "chapter_id": 11401, "verse_number": "24", "content_sanskrit": "यामाश्रित्येन्द्रियारातीन् दुर्जयानितराश्रमैः। वयं जयेम हेळाभिर्दस्यून् दुर्गपतिर्यथा॥ ३/१५/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50008418, "chapter_id": 11401, "verse_number": "25", "content_sanskrit": "न वयं प्रभवस्तां त्वामनुकर्तुं गृहेश्वरि। अप्यायुषा वा कात्स्र्न्येन ये चान्ये गुणगृध्नवः॥ ३/१५/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 50008419, "chapter_id": 11401, "verse_number": "26", "content_sanskrit": "अथापि काममेतं ते प्रजात्यै करवाण्यलम्। यथा मां नातिवाचन्ति मूहूर्तं प्रतिपालय॥ ३/१५/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 50008420, "chapter_id": 11401, "verse_number": "27", "content_sanskrit": "एषा घोरतरा वेळा घोराणां घोरदर्शना। चरन्ति यस्यां भूतानि भूतेशानुचराणि ह॥ ३/१५/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 50008421, "chapter_id": 11401, "verse_number": "28", "content_sanskrit": "एतस्यां साध्वि सन्ध्यायां भगवान् भूतभावनः। परीतो भूतपार्षद्भिर्वृषेणाटति भूतराट्॥ ३/१५/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 50008422, "chapter_id": 11401, "verse_number": "29", "content_sanskrit": "श्मशानचक्रानिलधूळधूम्रविकार्णविद्योतजटाकलापः। भस्मावगुण्ठामलरुग्मदेहो देवस्त्रिभिः पश्यति देवरस्ते॥ ३/१५/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 50008423, "chapter_id": 11401, "verse_number": "30", "content_sanskrit": "न यस्य लोके स्वजनः परो वा नात्यादृतो नोत कश्चिद्विगर्ह्यः। वयं व्रतैर्यच्चरणापविद्धा- माशास्महेऽजां बत भुक्तभोगाम्॥ ३/१५/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 50008424, "chapter_id": 11401, "verse_number": "31", "content_sanskrit": "यस्यानवद्याचरितं मनीषिणो गृह्णन्त्यविद्यापटलं बिभित्सवः। निरस्तसाम्यातिशयो हरेः स्वयं पिशाचचर्यामचरत् सतां गतिः॥ ३/१५/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 50008425, "chapter_id": 11401, "verse_number": "32", "content_sanskrit": "हसन्ति यस्याचरितं हि दुर्भगाः स्वात्मन् रतस्याविदुषः समीहितम्। यैर्वस्त्रमाल्याभरणानुलेपनैः श्वभोजनं स्वात्मतयोपलाळतम्॥ ३/१५/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 50008426, "chapter_id": 11401, "verse_number": "33", "content_sanskrit": "ब्रह्मादयो यत्कृतसेतुपाला यत्कारणं विश्वमिदं हि मायया। आज्ञाकरी तस्य पिशाचचर्या अहो विभूम्नश्चरितं विडम्बनम्॥ ३/१५/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 50008427, "chapter_id": 11401, "verse_number": "34", "content_sanskrit": "मैत्रेय उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 50008428, "chapter_id": 11401, "verse_number": "35", "content_sanskrit": "एवं संवेदिता भर्त्रा मन्मथोन्मथितेन्द्रिया। जग्राह वासो ब्रह्मर्षेर्वृषळीव गतत्रपा॥ ३/१५/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 50008429, "chapter_id": 11401, "verse_number": "36", "content_sanskrit": "स विदित्वाऽथ भार्यायास्तन्निर्बन्धं विकर्मणि। नत्वा दिष्टाय रहसि तया चोपविवेश ह॥ ३/१५/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 50008430, "chapter_id": 11401, "verse_number": "37", "content_sanskrit": "अथोपस्पृश्य सलिलं प्राणानायम्य वाग्यतः। ध्यायन् जजाप विरजं ब्रह्म ज्योतिः सनातनम्॥ ३/१५/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 50008431, "chapter_id": 11401, "verse_number": "38", "content_sanskrit": "दितिस्तु व्रीळता तेन कर्मावद्येन भारत। उपसङ्गम्य विप्रर्षिमधोमुख्यभ्यभाषत॥ ३/१५/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 50008432, "chapter_id": 11401, "verse_number": "39", "content_sanskrit": "न मे गर्भमिमं ब्रह्मन् भूतानामृषभोऽवधीत्। रुद्रः पतिर्हि भूतानां यस्याकरवमंहसम्॥ ३/१५/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 50008433, "chapter_id": 11401, "verse_number": "40", "content_sanskrit": "नमो रुद्राय महते देवायोग्राय मीळ्हुषे। शिवाय न्यस्तदण्डाय धृतदण्डाय मन्यवे॥ ३/१५/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 50008434, "chapter_id": 11401, "verse_number": "41", "content_sanskrit": "स नः प्रसीदताद् भीमो भगवानुर्वनुग्रहः। व्याधस्याप्यनुकम्प्यानां स्त्रीणां देवः सतीपतिः॥ ३/१५/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 50008435, "chapter_id": 11401, "verse_number": "42", "content_sanskrit": "मैत्रेय उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 50008436, "chapter_id": 11401, "verse_number": "43", "content_sanskrit": "स्वगर्भस्याशिषं लौक्यामाशासानां प्रवेपतीम्। निवृत्तसन्ध्यानियमो भार्यामाह प्रजापतिः॥ ३/१५/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 50008437, "chapter_id": 11401, "verse_number": "44", "content_sanskrit": "काश्यप उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 50008438, "chapter_id": 11401, "verse_number": "45", "content_sanskrit": "अप्रायत्यादात्मनस्ते दोषान्मौहूर्तिकादुत। मन्निर्देशातिचारेण देवानां चैव हेळनात्॥ ३/१५/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 50008439, "chapter_id": 11401, "verse_number": "46", "content_sanskrit": "भविष्यतस्तवाभद्रावभद्रे जाठराधमौ। लोकान् सपालांस्त्रींश्चण्डौ मुहुराक्रन्दयिष्यतः॥ ३/१५/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 50008440, "chapter_id": 11401, "verse_number": "47", "content_sanskrit": "प्राणिनां हन्यमानानां दीनानामकृतागसाम्। स्त्रीणां निगृह्यमाणानां कोपितेषु महात्मसु॥ ३/१५/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 50008441, "chapter_id": 11401, "verse_number": "48", "content_sanskrit": "तदा विश्वेश्वरः क्रुद्धो भगवान् लोकभावनः। हनिष्यत्यवतीर्यासौ यथाऽद्रींश्छतपर्वधृक्॥ ३/१५/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 50008442, "chapter_id": 11401, "verse_number": "49", "content_sanskrit": "दितिरुवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 50008443, "chapter_id": 11401, "verse_number": "50", "content_sanskrit": "वधं भगवता साक्षात् सुनाभोदारबाहुना। आशासे पुत्रयोर्मह्यं मा क्रुद्धाद् ब्राह्मणात् प्रभो॥ ३/१५/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 50008444, "chapter_id": 11401, "verse_number": "51", "content_sanskrit": "न ब्रह्मदण्डदग्धस्य न भूतभयदस्य च। नारक्यश्चानुगृह्णन्ति यांयां योनिमसौ गतः॥ ३/१५/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 50008445, "chapter_id": 11401, "verse_number": "52", "content_sanskrit": "काश्यप उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 50008446, "chapter_id": 11401, "verse_number": "53", "content_sanskrit": "कृतशोकानुतापेन सद्यः प्रत्यवमर्शनात्। भगवत्युरुमानाच्च भवे मय्यपि चादरात्॥ ३/१५/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 50008447, "chapter_id": 11401, "verse_number": "54", "content_sanskrit": "पुत्रस्यैव च पुत्राणां भवितैकः सतां मतः। गायन्ति यद्यशः शुद्धं भगवद्यशसा समम्॥ ३/१५/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 50008448, "chapter_id": 11401, "verse_number": "55", "content_sanskrit": "योगैर्हेमेव दुर्वर्णं भावयिष्यन्ति साधवः। निर्वैरादिभिरात्मानं यच्छीलमनुवर्तितुम्॥ ३/१५/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 50008449, "chapter_id": 11401, "verse_number": "56", "content_sanskrit": "यत्प्रसादादिदं विश्वं प्रसीदति यदात्मकम्। शश्वद्दृक् भगवान् यस्य तोष्यतेऽनन्यया दृशा॥ ३/१५/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 50008450, "chapter_id": 11401, "verse_number": "57", "content_sanskrit": "स वै महाभागवतो महात्मा महानुभावो महतां महिष्ठः। प्रवृद्धभक्त्या ह्यनुभाविताशये निवेश्य वैकुण्ठमतद् विहास्यति॥ ३/१५/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 50008451, "chapter_id": 11401, "verse_number": "58", "content_sanskrit": "अलम्पटः शीलधरो गुणाकरो हृष्टः परार्थे व्यथितेषु दुःखितः। अभूतशत्रुर्जगतः शोकहर्ता नैदाधिकं तापमिवोडुराजः॥ ३/१५/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 50008452, "chapter_id": 11401, "verse_number": "59", "content_sanskrit": "अन्तर्बहिश्चानिलवच्चरन्तं स्वपूरुषेच्छानुगृहीतरूपम्। पौत्रस्तव श्रीललनाललामं द्रष्टा स्फुरत्कुण्डलमण्डिताननम्॥ ३/१५/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 50008453, "chapter_id": 11401, "verse_number": "60", "content_sanskrit": "मैत्रेय उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 50008454, "chapter_id": 11401, "verse_number": "61", "content_sanskrit": "श्रुत्वा भागवतं पौत्रममोदत दितिर्भृशम्। पुत्रयोश्च वधं कृष्णाद् विदित्वाऽऽसीन्महामनाः॥ ३/१५/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 50008455, "chapter_id": 11401, "verse_number": "62", "content_sanskrit": "॥ इति श्रीमद्भागवते तृतीयस्कन्धे पञ्चदशोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}]