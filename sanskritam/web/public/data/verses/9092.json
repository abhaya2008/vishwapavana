[{"id": 5000092000, "chapter_id": 9092, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अयोध्याकाण्डे पञ्चदशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000092001, "chapter_id": 9092, "verse_number": "२-१५-१", "content_sanskrit": "ते तु तां रजनीमुष्य ब्राह्मणा वेदपारगाः।\nउपतस्थुरुपस्थानं सह राजपुरोहिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000092002, "chapter_id": 9092, "verse_number": "२-१५-२", "content_sanskrit": "अमात्या बलमुख्याश्च मुख्या ये निगमस्य च।\nराघवस्याभिषेकार्थे प्रीयमाणाः सुसंगताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000092003, "chapter_id": 9092, "verse_number": "२-१५-३", "content_sanskrit": "उदिते विमले सूर्ये पुष्ये चाभ्यागतेऽहनि।\nलग्ने कर्कटके प्राप्ते जन्म रामस्य च स्थिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000092004, "chapter_id": 9092, "verse_number": "२-१५-४", "content_sanskrit": "अभिषेकाय रामस्य द्विजेन्द्रैरुपकल्पितम्।\nकाञ्चना जलकुम्भाश्च भद्रपीठं स्वलंकृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000092005, "chapter_id": 9092, "verse_number": "२-१५-५", "content_sanskrit": "रथश्च सम्यगास्तीर्णो भास्वता व्याघ्रचर्मणा।\nगङ्गायमुनयोः पुण्यात् संगमादाहृतं जलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000092006, "chapter_id": 9092, "verse_number": "२-१५-६", "content_sanskrit": "याश्चान्याः सरितः पुण्या ह्रदाः कूपाः सरांसि च।\nप्राग्वहाश्चोर्ध्ववाहाश्च तिर्यग्वाहाश्च क्षीरिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000092007, "chapter_id": 9092, "verse_number": "२-१५-७", "content_sanskrit": "ताभ्यश्चैवाहृतं तोयं समुद्रेभ्यश्च सर्वशः।\nक्षौद्रं दधि घृतं लाजा दर्भाः सुमनसः पयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000092008, "chapter_id": 9092, "verse_number": "२-१५-८", "content_sanskrit": "अष्टौ च कन्या रुचिरा मत्तश्च वरवारणः।\nसजलाः क्षीरिभिश्छन्ना घटाः काञ्चनराजताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000092009, "chapter_id": 9092, "verse_number": "२-१५-९", "content_sanskrit": "पद्मोत्पलयुता भान्ति पूर्णाः परमवारिणा।\nचन्द्रांशुविकचप्रख्यं पाण्डुरं रत्नभूषितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000092010, "chapter_id": 9092, "verse_number": "२-१५-१०", "content_sanskrit": "सज्जं तिष्ठति रामस्य वालव्यजनमुत्तमम्।\nचन्द्रमण्डलसंकाशमातपत्रं च पाण्डुरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000092011, "chapter_id": 9092, "verse_number": "२-१५-११", "content_sanskrit": "सज्जं द्युतिकरं श्रीमदभिषेकपुरस्सरम्।\nपाण्डुरश्च वृषः सज्जः पाण्डुराश्वश्च संस्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000092012, "chapter_id": 9092, "verse_number": "२-१५-१२", "content_sanskrit": "वादित्राणि च सर्वाणि वन्दिनश्च तथापरे।\nइक्ष्वाकूणां यथा राज्ये सम्भ्रियेताभिषेचनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000092013, "chapter_id": 9092, "verse_number": "२-१५-१३", "content_sanskrit": "तथाजातीयमादाय राजपुत्राभिषेचनम्।\nते राजवचनात् तत्र समवेता महीपतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000092014, "chapter_id": 9092, "verse_number": "२-१५-१४", "content_sanskrit": "अपश्यन्तोऽब्रुवन् को नु राज्ञो नः प्रतिवेदयेत्।\nन पश्यामश्च राजानमुदितश्च दिवाकरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000092015, "chapter_id": 9092, "verse_number": "२-१५-१५", "content_sanskrit": "यौवराज्याभिषेकश्च सज्जो रामस्य धीमतः।\nइति तेषु ब्रुवाणेषु सर्वांस्तांश्च महीपतीन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000092016, "chapter_id": 9092, "verse_number": "२-१५-१६", "content_sanskrit": "अब्रवीत् तानिदं वाक्यं सुमन्त्रो राजसत्कृतः।\nरामं राज्ञो नियोगेन त्वरया प्रस्थितो ह्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000092017, "chapter_id": 9092, "verse_number": "२-१५-१७", "content_sanskrit": "पूज्या राज्ञो भवन्तश्च रामस्य तु विशेषतः।\nअयं पृच्छामि वचनात् सुखमायुष्मतामहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000092018, "chapter_id": 9092, "verse_number": "२-१५-१८", "content_sanskrit": "राज्ञः सम्प्रतिबुद्धस्य चानागमनकारणम्।\nइत्युक्त्वान्तःपुरद्वारमाजगाम पुराणवित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000092019, "chapter_id": 9092, "verse_number": "२-१५-१९", "content_sanskrit": "सदा सक्तं च तद् वेश्म सुमन्त्रः प्रविवेश ह।\nतुष्टावास्य तदा वंशं प्रविश्य स विशाम्पतेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000092020, "chapter_id": 9092, "verse_number": "२-१५-२०", "content_sanskrit": "शयनीयं नरेन्द्रस्य तदासाद्य व्यतिष्ठत।\nसोऽत्यासाद्य तु तद् वेश्म तिरस्करणिमन्तरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000092021, "chapter_id": 9092, "verse_number": "२-१५-२१", "content_sanskrit": "आशीर्भिर्गुणयुक्ताभिरभितुष्टाव राघवम्।\nसोमसूर्यौ च काकुत्स्थ शिववैश्रवणावपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000092022, "chapter_id": 9092, "verse_number": "२-१५-२२", "content_sanskrit": "वरुणश्चाग्निरिन्द्रश्च विजयं प्रदिशन्तु ते।\nगता भगवती रात्रिरहः शिवमुपस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000092023, "chapter_id": 9092, "verse_number": "२-१५-२३", "content_sanskrit": "बुद्ध्यस्व राजशार्दूल कुरु कार्यमनन्तरम्।\nब्राह्मणा बलमुख्याश्च नैगमाश्चागतास्त्विह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000092024, "chapter_id": 9092, "verse_number": "२-१५-२४", "content_sanskrit": "दर्शनं तेऽभिकांक्षन्ते प्रतिबुद्ध्यस्व राघव।\nस्तुवन्तं तं तदा सूतं सुमन्त्रं मन्त्रकोविदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000092025, "chapter_id": 9092, "verse_number": "२-१५-२५", "content_sanskrit": "प्रतिबुद्ध्य ततो राजा इदं वचनमब्रवीत्।\nराममानय सूतेति यदस्यभिहितो मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000092026, "chapter_id": 9092, "verse_number": "२-१५-२६", "content_sanskrit": "किमिदं कारणं येन ममाज्ञा प्रतिवाह्यते।\nन चैव सम्प्रसुप्तोऽहमानयेहाशु राघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000092027, "chapter_id": 9092, "verse_number": "२-१५-२७", "content_sanskrit": "इति राजा दशरथः सूतं तत्रान्वशात् पुनः।\nस राजवचनं श्रुत्वा शिरसा प्रतिपूज्य तम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000092028, "chapter_id": 9092, "verse_number": "२-१५-२८", "content_sanskrit": "निर्जगाम नृपावासान्मन्यमानः प्रियं महत्।\nप्रपन्नो राजमार्गं च पताकाध्वजशोभितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000092029, "chapter_id": 9092, "verse_number": "२-१५-२९", "content_sanskrit": "हृष्टः प्रमुदितः सूतो जगामाशु विलोकयन्।\nस सूतस्तत्र शुश्राव रामाधिकरणाः कथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000092030, "chapter_id": 9092, "verse_number": "२-१५-३०", "content_sanskrit": "अभिषेचनसंयुक्ताः सर्वलोकस्य हृष्टवत्।\nततो ददर्श रुचिरं कैलाससदृशप्रभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000092031, "chapter_id": 9092, "verse_number": "२-१५-३१", "content_sanskrit": "रामवेश्म सुमन्त्रस्तु शक्रवेश्मसमप्रभम्।\nमहाकपाटपिहितं वितर्दिशतशोभितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000092032, "chapter_id": 9092, "verse_number": "२-१५-३२", "content_sanskrit": "काञ्चनप्रतिमैकाग्रं मणिविद्रुमतोरणम्।\nशारदाभ्रघनप्रख्यं दीप्तं मेरुगुहासमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000092033, "chapter_id": 9092, "verse_number": "२-१५-३३", "content_sanskrit": "मणिभिर्वरमाल्यानां सुमहद्भिरलंकृतम्।\nमुक्तामणिभिराकीर्णं चन्दनागुरुभूषितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000092034, "chapter_id": 9092, "verse_number": "२-१५-३४", "content_sanskrit": "गन्धान् मनोज्ञान् विसृजद् दार्दुरं शिखरं यथा।\nसारसैश्च मयूरैश्च विनदद्भिर्विराजितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000092035, "chapter_id": 9092, "verse_number": "२-१५-३५", "content_sanskrit": "सुकृतेहामृगाकीर्णमुत्कीर्णं भक्तिभिस्तथा।\nमनश्चक्षुश्च भूतानामाददत् तिग्मतेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000092036, "chapter_id": 9092, "verse_number": "२-१५-३६", "content_sanskrit": "चन्द्रभास्करसंकाशं कुबेरभवनोपमम्।\nमहेन्द्रधामप्रतिमं नानापक्षिसमाकुलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000092037, "chapter_id": 9092, "verse_number": "२-१५-३७", "content_sanskrit": "मेरुशृङ्गसमं सूतो रामवेश्म ददर्श ह।\nउपस्थितैः समाकीर्णं जनैरञ्जलिकारिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000092038, "chapter_id": 9092, "verse_number": "२-१५-३८", "content_sanskrit": "उपादाय समाक्रान्तैस्तदा जानपदैर्जनैः।\nरामाभिषेकसुमुखैरुन्मुखैः समलंकृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000092039, "chapter_id": 9092, "verse_number": "२-१५-३९", "content_sanskrit": "महामेघसमप्रख्यमुदग्रं सुविराजितम्।\nनानारत्नसमाकीर्णं कुब्जकैरपि चावृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000092040, "chapter_id": 9092, "verse_number": "२-१५-४०", "content_sanskrit": "स वाजियुक्तेन रथेन सारथिः\nसमाकुलं राजकुलं विराजयन्।\nवरूथिना राजगृहाभिपातिना\nपुरस्य सर्वस्य मनांसि हर्षयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000092041, "chapter_id": 9092, "verse_number": "२-१५-४१", "content_sanskrit": "ततः समासाद्य महाधनं महत्\nप्रहृष्टरोमा स बभूव सारथिः।\nमृगैर्मयूरैश्च समाकुलोल्बणं\nगृहं वरार्हस्य शचीपतेरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000092042, "chapter_id": 9092, "verse_number": "२-१५-४२", "content_sanskrit": "स तत्र कैलासनिभाः स्वलंकृताः\nप्रविश्य कक्ष्यास्त्रिदशालयोपमाः।\nप्रियान् वरान् राममते स्थितान् बहून्\nव्यपोह्य शुद्धान्तमुपस्थितौ रथी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000092043, "chapter_id": 9092, "verse_number": "२-१५-४३", "content_sanskrit": "स तत्र शुश्राव च हर्षयुक्ता\nरामाभिषेकार्थकृतां जनानाम्।\nनरेन्द्रसूनोरभिमङ्गलार्थाः\nसर्वस्य लोकस्य गिरः प्रहृष्टाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000092044, "chapter_id": 9092, "verse_number": "२-१५-४४", "content_sanskrit": "महेन्द्रसद्मप्रतिमं च वेश्म\nरामस्य रम्यं मृगपक्षिजुष्टम्।\nददर्श मेरोरिव शृङ्गमुच्चं\nविभ्राजमानं प्रभया सुमन्त्रः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000092045, "chapter_id": 9092, "verse_number": "२-१५-४५", "content_sanskrit": "उपस्थितैरञ्जलिकारिभिश्च\nसोपायनैर्जानपदैर्जनैश्च।\nकोट्या परार्धैश्च विमुक्तयानैः\nसमाकुलं द्वारपदं ददर्श ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000092046, "chapter_id": 9092, "verse_number": "२-१५-४६", "content_sanskrit": "ततो महामेघमहीधराभं\nप्रभिन्नमत्यङ्कुशमत्यसह्यम्।\nरामोपवाह्यं रुचिरं ददर्श\nशत्रुञ्जयं नागमुदग्रकायम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000092047, "chapter_id": 9092, "verse_number": "२-१५-४७", "content_sanskrit": "स्वलंकृतान् साश्वरथान् सकुञ्जरा-\nनमात्यमुख्यांश्च ददर्श वल्लभान्।\nव्यपोह्य सूतः सहितान् समन्ततः\nसमृद्धमन्तःपुरमाविवेश ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000092048, "chapter_id": 9092, "verse_number": "२-१५-४८", "content_sanskrit": "ततोऽद्रिकूटाचलमेघसंनिभं\nमहाविमानोपमवेश्मसंयुतम्।\nअवार्यमाणः प्रविवेश सारथिः\nप्रभूतरत्नं मकरो यथार्णवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000092049, "chapter_id": 9092, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अयोध्याकाण्डे पञ्चदशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]