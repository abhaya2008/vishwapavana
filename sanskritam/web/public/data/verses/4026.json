[{"id": 2140198, "chapter_id": 4026, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2140199, "chapter_id": 4026, "verse_number": "१", "content_sanskrit": "तमसाऽभिप्लुते लोके रजसा चैव भारत ।\nव्यतिष्ठन्त मुहूर्तं ते व्यूढानीकाः प्रहारिणः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2140200, "chapter_id": 4026, "verse_number": "२", "content_sanskrit": "ततोऽन्धकारं प्रणुदन्नुदतिष्ठन्निशाकरः ।\nकुर्वाणो विमलां रात्रिं नन्दयन् क्षत्रियान् रणे\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2140201, "chapter_id": 4026, "verse_number": "३", "content_sanskrit": "ततः प्रकाशमासाद्य पुनर्युद्धमवर्तत ।\nघोररूपं तदा तस्मिन्नवैक्षन्त परस्परम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2140202, "chapter_id": 4026, "verse_number": "४", "content_sanskrit": "ततः सुशर्मा त्रैगर्तः सह भ्रात्रा सुवर्मणा ।\nअभ्यद्रवन्मत्स्यराजं शरव्रातेन सर्वशः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2140203, "chapter_id": 4026, "verse_number": "५", "content_sanskrit": "ततो रथाभ्यां प्रस्कन्द्य भ्रातरौ क्षत्रियावुभौ ।\nगदापाणी सुसंरब्धौ समभ्यद्रवतां हयान्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2140204, "chapter_id": 4026, "verse_number": "६", "content_sanskrit": "तथैव तेषां तुमुलानि तानि\nक्रुद्धानि चान्योन्यमभिद्रवन्ति ।\nगदासिपट्टैश्च परश्वधैश्च\nप्रासैश्च तीक्ष्णाग्रसुरूपधारैः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2140205, "chapter_id": 4026, "verse_number": "७", "content_sanskrit": "बलं तु मत्स्यस्य बलेन राजा\nसर्वं त्रिगर्ताधिपतिः सुशर्मा ।\nप्रमथ्य जित्वा च निपीड्य मत्स्यान्\nविराटमोजस्विनमभ्यधावत्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2140206, "chapter_id": 4026, "verse_number": "८", "content_sanskrit": "मत्ताविव वृषावेतौ गजाविव मदोद्धतौ ।\nसिंहाविव गजग्राहौ वृत्रशक्राविवोद्धतौ\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2140207, "chapter_id": 4026, "verse_number": "९", "content_sanskrit": "उभौ तुल्यबलोत्साहावुभौ तुल्यपराक्रमौ ।\nउभौ तुल्यास्त्रविदुषावुभौ युद्धविशारदौ\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2140208, "chapter_id": 4026, "verse_number": "१०", "content_sanskrit": "तौ निहत्य पृथग्धुर्यावुभौ तौ पार्ष्णिसारथी ।\nआस्तां तुल्यधनुग्राहौ विष्णुकंसाविवोद्धतौ\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2140209, "chapter_id": 4026, "verse_number": "११", "content_sanskrit": "सुशर्मा परवीरघ्नो बलवान् वीर्यवान् गदी ।\nविरथं मत्स्यराजानं जीवग्राहमथाग्रहीत्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2140210, "chapter_id": 4026, "verse_number": "१२", "content_sanskrit": "तमुन्मथ्य सुशर्मा तु विराटं भीमविक्रमम् ।\nस्यन्दनं स्वं समारोप्य प्रययौ शीघ्रवाहनः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2140211, "chapter_id": 4026, "verse_number": "१३", "content_sanskrit": "तस्मिन् गृहीते नृपतौ विराटे बलवत्तरे ।\nबलं सर्वं विभग्नं तन्निरुत्साहं निराशकम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2140212, "chapter_id": 4026, "verse_number": "१४", "content_sanskrit": "प्राद्रवन्त भयान्मत्स्याः त्रिगर्तैरर्दिता रणे ।\nविदिक्षु दिक्षु सर्वासु पलायन्ति च यान्ति च\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2140213, "chapter_id": 4026, "verse_number": "१५", "content_sanskrit": "तेषु विद्राव्यमाणेषु कुन्तीपुत्रो युधिष्ठिरः ।\nअभ्यभाषत धर्मात्मा भीमसेनमरिन्दमम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2140214, "chapter_id": 4026, "verse_number": "१६", "content_sanskrit": "मत्स्यराजः परामृष्टस्त्रिगर्तेन सुशर्मणा ।\nतं मोक्षय महाबाहो मा गमद् द्विषतां वशम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2140215, "chapter_id": 4026, "verse_number": "१७", "content_sanskrit": "उषिताः स्म सुखं सर्वे सर्वकामैः सुपूजिताः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2140216, "chapter_id": 4026, "verse_number": "१८", "content_sanskrit": "भीमसेन महाबाहो गृहीतं तु सुशर्मणा ।\nत्रायस्व मोचय क्षिप्रमस्मत्प्रीतिकरं नृपम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2140217, "chapter_id": 4026, "verse_number": "१९", "content_sanskrit": "भीमसेन त्वया कार्या तस्य वासस्य निष्कृतिः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2140218, "chapter_id": 4026, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2140219, "chapter_id": 4026, "verse_number": "२०", "content_sanskrit": "तं तथावादिनं तत्र भीमसेनो महाबलः ।\nअभ्यभाषत दुर्धर्षो रणमध्ये युधिष्ठिरम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2140220, "chapter_id": 4026, "verse_number": "२१", "content_sanskrit": "अहमेनं परित्रास्ये शासनात् तव पार्थिव ।\nपश्येदं सुमहत् कर्म युध्यतो मम शत्रुभिः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2140221, "chapter_id": 4026, "verse_number": "२२", "content_sanskrit": "स्बबाहुबलमाश्रित्य परेषामसमं रणे ।\nएकान्तमाश्रितो राजन् तिष्ठ त्वं भ्रातृभिः सह\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2140222, "chapter_id": 4026, "verse_number": "२३", "content_sanskrit": "अयं वृक्षो महासारो गिरिमात्रो वनस्पतिः ।\nअहमेनं समारुज्य पोथयिष्यामि शात्रवान्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2140223, "chapter_id": 4026, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2140224, "chapter_id": 4026, "verse_number": "२४", "content_sanskrit": "तं मत्तमिव मातङ्गं वीक्षमाणं वनस्पतिम् ।\nअब्रवीद् भ्रातरं वीरं धर्मराजो युधिष्ठिरः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2140225, "chapter_id": 4026, "verse_number": "२५", "content_sanskrit": "मा भीम साहसं कार्षीस्तिष्ठत्वेष वनस्पतिः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2140226, "chapter_id": 4026, "verse_number": "२६", "content_sanskrit": "मा त्वां वृक्षेण कर्माणि कुर्वन्तमतिमानुषम् ।\nजनाः समवबुद्ध्येरन् भीमोऽयमिति भारत\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2140227, "chapter_id": 4026, "verse_number": "२७", "content_sanskrit": "मा ग्रहीस्त्वमिमं वृक्षं सिंहनादं च मानद ।\nवृक्षं चेत् त्वं नयेर्वीर विज्ञास्यति जनो ध्रुवम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2140228, "chapter_id": 4026, "verse_number": "२८", "content_sanskrit": "अन्यदेवायुधं गृह्य प्रतिपद्यस्व मानुषम् ।\nचापं वा यदि वा शक्तिं निस्त्रिंशं वा गृहाण भो\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2140229, "chapter_id": 4026, "verse_number": "२९", "content_sanskrit": "यदेव मानुषं भीम भवेदन्यैरलक्षितम् ।\nतदेवायुधमादाय मोचयाशु महीपतिम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2140230, "chapter_id": 4026, "verse_number": "३०", "content_sanskrit": "यमौ च पक्षरक्षौ ते भवितारौ महाबलौ ।\nव्यायच्छतस्ते समरे मत्स्यराजं परीप्सतः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2140231, "chapter_id": 4026, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2140232, "chapter_id": 4026, "verse_number": "३१", "content_sanskrit": "इत्युक्त्वा भीमसेनं तं स्वयमेव युधिष्ठिरः ।\nअन्वयाज्जवनैरश्वैः परीप्सन् मत्स्यसत्तमम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2140233, "chapter_id": 4026, "verse_number": "३२", "content_sanskrit": "भ्रातुर्वचनमादाय भीमो वृक्षं विसृज्य च ।\nचापमादाय सम्प्राप्तो रथमारुह्य पाण्डवः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2140234, "chapter_id": 4026, "verse_number": "३३", "content_sanskrit": "ते संहताः सर्व एव हयान् पार्था अचोदयन् ।\nदिव्यास्त्रकुशलाः सर्वे नीतिज्ञाश्चास्पृशन् परान्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2140235, "chapter_id": 4026, "verse_number": "३४", "content_sanskrit": "ततः समस्तास्ते सर्वे तुरगानभ्यचोदयन् ।\nदिव्यमस्त्रं विकुर्वाणाः त्रिगर्तांश्चप्युपाद्रवन्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2140236, "chapter_id": 4026, "verse_number": "३५", "content_sanskrit": "तान् निवृत्तरथान् दृष्ट्वा पाण्डवान् महतीं चमूम् ।\nवैराटिः परमक्रुद्धो युयुधे परमाद्भुतम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2140237, "chapter_id": 4026, "verse_number": "३६", "content_sanskrit": "त्रिगर्ताः समतिक्रम्य अयुध्यन्त जयैषिणः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2140238, "chapter_id": 4026, "verse_number": "३७", "content_sanskrit": "तान् भीमसेनः सङ्क्रुद्धः सर्वशस्त्रभृतां वरः ।\nद्विसहस्रं रथान् वीरः परलोकं प्रवेशयत्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2140239, "chapter_id": 4026, "verse_number": "३८", "content_sanskrit": "सहस्रं प्राहिणोद् राजा कुन्तीपुत्रो युधिष्ठिरः ।\nनकुलश्चापि सप्तैव शतानि प्राहिणोच्छरैः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2140240, "chapter_id": 4026, "verse_number": "३९", "content_sanskrit": "शतानि त्रीणि शूराणां सहदेवः प्रतापवान् ।\nयुधिष्ठिरसमादिष्टो निजघ्ने पुरुषर्षभः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2140241, "chapter_id": 4026, "verse_number": "४०", "content_sanskrit": "प्रविश्य महतीं सेनां त्रिगर्तानां महाबलाः ।\nक्षोभयन्तश्च सैन्यानि सिंहाः क्षुद्रमृगानिव\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2140242, "chapter_id": 4026, "verse_number": "४१", "content_sanskrit": "ततो युधिष्ठिरो राजा त्वरमाणो महाबलः ।\nअभिद्रुत्य सुशर्माणं शरैरभ्यहनद् भृशम्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2140243, "chapter_id": 4026, "verse_number": "४२", "content_sanskrit": "सुशर्माऽपि सुसङ्क्रुद्धस्त्वरमाणो युधिष्ठिरम् ।\nअविध्यद् दशभिर्बाणैश्चतुर्भिश्चतुरो हयान्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2140244, "chapter_id": 4026, "verse_number": "४३", "content_sanskrit": "ततो राजन् क्षिप्रकारी कुन्तीपुत्रो वृकोदरः ।\nसमासाद्य सुशर्माणमश्वांस्तस्य न्यपातयत्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2140245, "chapter_id": 4026, "verse_number": "४४", "content_sanskrit": "पृष्ठगोपांस्तु तस्याथ हत्वा परमसायकैः ।\nअथास्य सारथिं क्रुद्धो रथोपस्थादपातयत्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2140246, "chapter_id": 4026, "verse_number": "४५", "content_sanskrit": "चक्ररक्षस्तु शूरश्च शोणाश्वो नाम नामतः ।\nस भयाद् विरथं दृष्ट्वा त्रिगर्तं व्याजहात् तदा\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2140247, "chapter_id": 4026, "verse_number": "४६", "content_sanskrit": "ततो विराटः प्रस्कन्द्य रथादथ सुशर्मणः ।\nगदामस्य परामृश्य तमेवाभ्यहनद् बली\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2140248, "chapter_id": 4026, "verse_number": "४७", "content_sanskrit": "स चचार गदापाणिर्वृद्धोऽपि तरुणो यथा\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2140249, "chapter_id": 4026, "verse_number": "४८", "content_sanskrit": "भीमस्तु भीमसङ्काशो रथात् प्रस्कन्द्य वीर्यवान् ।\nत्रिगर्तराजमादत्त सिंहः क्षुद्रमृगं यथा\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2140250, "chapter_id": 4026, "verse_number": "४९", "content_sanskrit": "तस्मिन् वीरे गृहीते तु त्रिगर्तानां महारथे ।\nअभज्यत बलं सर्वं त्रिगर्तानां भयातुरम्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2140251, "chapter_id": 4026, "verse_number": "५०", "content_sanskrit": "निवर्त्य गास्ततः सर्वाः पाण्डुपुत्राः महाबलाः ।\nअवजित्य सुशर्माणं धनं चादाय सर्वशः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2140252, "chapter_id": 4026, "verse_number": "५१", "content_sanskrit": "स्वबाहुबलसम्पन्ना ह्रीनिषेधा यतव्रताः ।\nविराटस्य महात्मानः परिक्लेशविनाशनाः\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2140253, "chapter_id": 4026, "verse_number": "५२", "content_sanskrit": "स्थिताः समक्षं ते सर्वे त्वथ भीमोऽभ्यभाषत\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2140254, "chapter_id": 4026, "verse_number": "५३", "content_sanskrit": "नायं पापसमाचारो मत्तो जीवितुमर्हति ।\nकिं नु शक्यं मया कर्तुं यद् राजा सततं घृणी\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2140255, "chapter_id": 4026, "verse_number": "५४", "content_sanskrit": "गले गृहीत्वा राजानमानीय विवशं वशम् ।\nतत एनं विचेष्टन्तं बद्ध्वा पार्थो वृकोदरः\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2140256, "chapter_id": 4026, "verse_number": "५५", "content_sanskrit": "रथमारोपयामास विसञ्ज्ञं पांसुकुण्ठितम्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2140257, "chapter_id": 4026, "verse_number": "५६", "content_sanskrit": "अभ्येत्य रणमध्यस्थमभ्यगच्छद् युधिष्ठिरम् ।\nदर्शयामास भीमस्तु सुशर्माणं नराधिपम्\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2140258, "chapter_id": 4026, "verse_number": "५७", "content_sanskrit": "प्रोवाच पुरुषव्याघ्रो भीममाहवशोभिनम्\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2140259, "chapter_id": 4026, "verse_number": "५८", "content_sanskrit": "तं राजा प्राहसद् दृष्ट्वा मुच्यतां वै नराधमः\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2140260, "chapter_id": 4026, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2140261, "chapter_id": 4026, "verse_number": "५९", "content_sanskrit": "एवमुक्तोऽब्रवीद् भीमः सुशर्माणं महाबलम्\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2140262, "chapter_id": 4026, "verse_number": "६०", "content_sanskrit": "जीवितुं चेच्छसे मूढ हेतुं मे गदतः शृणु ।\nदासोऽस्मीति त्वया वाच्यं संसत्सु च सभासु च\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2140263, "chapter_id": 4026, "verse_number": "६१", "content_sanskrit": "एवं ते जीवितं दद्यामेष युद्धजितो विधिः\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2140264, "chapter_id": 4026, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2140265, "chapter_id": 4026, "verse_number": "६२", "content_sanskrit": "तमुवाच ततो ज्येष्ठो भ्राता सप्रणयं वचः\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2140266, "chapter_id": 4026, "verse_number": "६३", "content_sanskrit": "मुञ्च मुञ्चाधमाचारं प्रमाणं यदि ते वयम् ।\nदासभावं गतो ह्येष विराटस्य महीपतेः\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2140267, "chapter_id": 4026, "verse_number": "६४", "content_sanskrit": "अदासो गच्छ मुक्तोऽसि मैवं कार्षीः कदाचन\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2140268, "chapter_id": 4026, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2140269, "chapter_id": 4026, "verse_number": "६५", "content_sanskrit": "एवमुक्ते तु सव्रीडः सुशर्माऽसीदधोमुखः\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2140270, "chapter_id": 4026, "verse_number": "६६", "content_sanskrit": "मोचयित्वा विराटं तु पाण्डवास्ते हतद्विषः ।\nस्वबाहुबलसम्पन्ना ह्रीनिषेधा यतव्रताः\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2140271, "chapter_id": 4026, "verse_number": "६७", "content_sanskrit": "सङ्ग्रामशिरसो मध्ये तां रात्रिं सुखिनोऽवसत्\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2140272, "chapter_id": 4026, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां विराटपर्वणि चतुस्त्रिंशोऽध्यायः ॥३४॥ गोग्रहणपर्वणि सप्तमोऽध्यायः ॥७॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}]