[{"id": 7000584000, "chapter_id": 20584, "verse_number": "५-४३-१", "content_sanskrit": "शेष उवाच ।\nहनूमान्वीरसिंहं तु समागत्याब्रवीद्वचः ।\nतिष्ठ यासि कुतो वीर जेष्यामि त्वां क्षणादिह॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000584001, "chapter_id": 20584, "verse_number": "५-४३-२", "content_sanskrit": "एवमुक्तं समाकर्ण्य प्लवगस्य वचो महत् ।\nकोपपूरपरिप्लुष्टः कार्मुकं जलदस्वनम्॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000584002, "chapter_id": 20584, "verse_number": "५-४३-३", "content_sanskrit": "विनद्य घोरान्निशितान्बाणान्मुंचन्बभौ रणे ।\nआषाढे जलदस्येव धारासारे मनोहरः॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000584003, "chapter_id": 20584, "verse_number": "५-४३-४", "content_sanskrit": "तान्दृष्ट्वा निशितान्बाणान्स्वदेहे सुविलग्नकान् ।\nचुकोप हृदयेऽत्यतं हनूमानंजनी सुतः॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000584004, "chapter_id": 20584, "verse_number": "५-४३-५", "content_sanskrit": "मुष्टिना ताडयामास हृदये वज्रसारिणा ।\nसमुष्टिना हतो वीरः पपात धरणीतले॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000584005, "chapter_id": 20584, "verse_number": "५-४३-६", "content_sanskrit": "मूर्च्छितं तं समालोक्य पितृव्यं स शुभांगदः ।\nरुक्मांगदोऽपि संमूर्च्छां त्यक्त्वागाद्रणमंडलम्॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000584006, "chapter_id": 20584, "verse_number": "५-४३-७", "content_sanskrit": "बाणान्समभिवर्षंतौ मेघाविव महास्वनौ ।\nकुर्वंतौ कदनं घोरं प्लवंगं प्रति जग्मतुः॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000584007, "chapter_id": 20584, "verse_number": "५-४३-८", "content_sanskrit": "तौ दृष्ट्वा समरे वीरौ समायातौ कपीश्वरः ।\nलांगूलेन च संवेष्ट्य सरथौ चापधारकौ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000584008, "chapter_id": 20584, "verse_number": "५-४३-९", "content_sanskrit": "स्फोटयामास भूदेशे तत्क्षणान्मूर्च्छितावुभौ ।\nनिश्चेष्टौ समभूतां तौ रुधिरारक्तदेहकौ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000584009, "chapter_id": 20584, "verse_number": "५-४३-१०", "content_sanskrit": "बलमित्रश्चिरं युद्धं विधाय सुमदेन हि ।\nमूर्च्छामप्रापयत्तं वै बाणैः सुशितपर्वभिः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000584010, "chapter_id": 20584, "verse_number": "५-४३-११", "content_sanskrit": "पुष्कलेन क्षणान्नीतो मूर्च्छां चैतन्यवर्जिताम् ।\nजयमाप्तं तु कटकं शत्रुघ्नस्य भटार्दनम्॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000584011, "chapter_id": 20584, "verse_number": "५-४३-१२", "content_sanskrit": "एतस्मिन्समये सांबः स्यंदनं वरमास्थितः ।\nविस्फारयन्धनुर्दिव्यमुपाधावद्भटानिमान्॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000584012, "chapter_id": 20584, "verse_number": "५-४३-१३", "content_sanskrit": "जटाजूटांतरगतां चंद्ररेखां वहन्महान् ।\nसर्पाभूषां मनःस्पर्शां दधदाजगवं धनुः॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000584013, "chapter_id": 20584, "verse_number": "५-४३-१४", "content_sanskrit": "मूर्च्छितान्स्वजनान्दृष्ट्वा भक्तार्तिघ्नो महेश्वरः ।\nयोद्धुं प्रायान्महासैन्यैः शत्रुघ्नस्य भटानिमान्॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000584014, "chapter_id": 20584, "verse_number": "५-४३-१५", "content_sanskrit": "सगणः सपरीवारः कंपयन्पृथिवीतलम् ।\nभक्तरक्षार्थमागच्छंस्त्रिपुरं तु पुरा यथा॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000584015, "chapter_id": 20584, "verse_number": "५-४३-१६", "content_sanskrit": "कोपाच्छोणतरे नेत्रे वहन्प्रलयकारकः ।\nपश्यन्वीरान्बहुमतीन्पिनाकी देववंदितः॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000584016, "chapter_id": 20584, "verse_number": "५-४३-१७", "content_sanskrit": "तमागतं महेशानं वीक्ष्य रामानुजो बली ।\nजगाम समरे योद्धुं सर्वदेवशिरोमणिम्॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000584017, "chapter_id": 20584, "verse_number": "५-४३-१८", "content_sanskrit": "अथागतं तु शत्रुघ्नं रुद्रो वीक्ष्य पिनाकधृक् ।\nउवाच परमापन्नः कोपं सगुणचापधृक्॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000584018, "chapter_id": 20584, "verse_number": "५-४३-१९", "content_sanskrit": "पुष्कलेन महत्कर्म कृतं रामांघ्रिसेविना ।\nमद्भक्तं यो रणे हत्वा गतः समरमंडलम्॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000584019, "chapter_id": 20584, "verse_number": "५-४३-२०", "content_sanskrit": "अद्य क्वास्ति परो वीरः पुष्कलः परमास्त्रवित् ।\nतं हत्वा सुखमाप्स्यामि समरे भक्तपीडनम्॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000584020, "chapter_id": 20584, "verse_number": "५-४३-२१", "content_sanskrit": "शेष उवाच ।\nइत्युक्त्वा वीरभद्रं स प्रेषयामास पुष्कलम् ।\nयाहि त्वं समरे योद्धुं पुष्कलं सेवकार्दनम्॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000584021, "chapter_id": 20584, "verse_number": "५-४३-२२", "content_sanskrit": "नंदिनं प्रेषयामास हनूमंतं महाबलम् ।\nकुशध्वजं प्रचंडं तु भृंगिणं च सुबाहुकम्॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000584022, "chapter_id": 20584, "verse_number": "५-४३-२३", "content_sanskrit": "सुमदं चंडनामानं गणं स्वीयं समादिशत् ।\nपुष्कलस्तु समायांतं वीरभद्रं महागणम्॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000584023, "chapter_id": 20584, "verse_number": "५-४३-२४", "content_sanskrit": "महारुद्रस्य संवीक्ष्य योद्धुं प्रायान्महामनाः ।\nपुष्कलः पंचभिर्बाणैस्ताडयामास संयुगे॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000584024, "chapter_id": 20584, "verse_number": "५-४३-२५", "content_sanskrit": "तैर्बाणैः क्षतगात्रस्तु त्रिशूलं स समादिशत् ।\nस त्रिशूलं क्षणाच्छित्त्वा व्यगर्जत महाबलः॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000584025, "chapter_id": 20584, "verse_number": "५-४३-२६", "content_sanskrit": "छिन्नं स्वीयं त्रिशूलं वै वीक्ष्य रुद्रानुगो बली ।\nखट्वांगेन जघानाशु मस्तके भारतिं द्विज॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000584026, "chapter_id": 20584, "verse_number": "५-४३-२७", "content_sanskrit": "खट्वांगाभिहतः सोऽथ मुमूर्च्छ क्षणमुद्भटः ।\nविहाय मूर्च्छां सद्वीरः पुष्कलः परमास्त्रवित्॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000584027, "chapter_id": 20584, "verse_number": "५-४३-२८", "content_sanskrit": "शरैश्चिच्छेद खट्वांगं करस्थं तस्य तत्क्षणात् ।\nवीरभद्रः स्वकेच्छिन्ने खट्वांगे करसंस्थिते॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000584028, "chapter_id": 20584, "verse_number": "५-४३-२९", "content_sanskrit": "परमक्रोधमापन्नो बभंज रथिनो रथम् ।\nभंक्त्वा रथं तु वीरस्य पदातिं च विधाय सः॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000584029, "chapter_id": 20584, "verse_number": "५-४३-३०", "content_sanskrit": "बाहुयुद्धेन युयुधे पुष्कलेन महात्मना ।\nस पुष्कलो रथं त्यक्त्वा चूर्णितं तेन वेगतः॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000584030, "chapter_id": 20584, "verse_number": "५-४३-३१", "content_sanskrit": "मुष्टिना ताडयामास वीरभद्रं महाबलः ।\nअन्योन्यं मुष्टिभिर्घ्नंतावूरुभिर्जानुभिस्तथा॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000584031, "chapter_id": 20584, "verse_number": "५-४३-३२", "content_sanskrit": "परस्परवधोद्युक्तौ परस्परजयैषिणौ ।\nएवं चतुर्दिनमभूद्रात्रिं दिवमपीशयोः॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000584032, "chapter_id": 20584, "verse_number": "५-४३-३३", "content_sanskrit": "न कोपि तत्र हीयेत न जीयेत महाबलः ।\nपंचमे तु दिने वृत्ते वीरभद्रो महाबलः॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000584033, "chapter_id": 20584, "verse_number": "५-४३-३४", "content_sanskrit": "गृहीत्वा नभ उड्डीनो महावीरं तु पुष्कलम् ।\nतत्र युद्धं तयोरासीद्देवासुरविमोहनम्॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000584034, "chapter_id": 20584, "verse_number": "५-४३-३५", "content_sanskrit": "मुष्टिना चरणाघातैर्बाहुभिः सुखुरैर्महत् ।\nतदात्यंतं प्रकुपितः पुष्कलो वीरभद्रकम्॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000584035, "chapter_id": 20584, "verse_number": "५-४३-३६", "content_sanskrit": "गृहीत्वा कंठदेशे तु ताडयामास भूतले ।\nतत्प्रहारेण व्यथितो वीरभद्रो महाबलः॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000584036, "chapter_id": 20584, "verse_number": "५-४३-३७", "content_sanskrit": "गृहीत्वा पुष्कलं पादे जघानास्फालयन्मुहुः ।\nताडयित्वा महीदेशे पुष्कलं सुमहाबलः॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000584037, "chapter_id": 20584, "verse_number": "५-४३-३८", "content_sanskrit": "त्रिशूलेन चकर्ताशु शिरो ज्वलितकुंडलम् ।\nजगर्ज पुष्कलं हत्वा वीरभद्रो महाबलः॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000584038, "chapter_id": 20584, "verse_number": "५-४३-३९", "content_sanskrit": "गर्जता तेन शार्वेण प्रापितास्त्रा समुद्भटाः ।\nहाहाकारो महानासीत्पुष्कले पतिते रणे॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000584039, "chapter_id": 20584, "verse_number": "५-४३-४०", "content_sanskrit": "त्रासं प्रापुर्जनाः सर्वे रणमध्ये सुकोविदाः ।\nते शशंशुश्च शत्रुघ्नं पुष्कलं पतितं रणे॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000584040, "chapter_id": 20584, "verse_number": "५-४३-४१", "content_sanskrit": "निहतं वीरभद्रेण महेश्वरगणेन वै ।\nइत्याश्रुत्य महावीरः पुष्कलस्य वधं तदा॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000584041, "chapter_id": 20584, "verse_number": "५-४३-४२", "content_sanskrit": "दुःखं प्राप्तो रणेऽत्यतं कंपमानः शुचा महान् ।\nतं दुःखितं च शत्रुघ्नं ज्ञात्वा रुद्रो ऽब्रवीद्वचः॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000584042, "chapter_id": 20584, "verse_number": "५-४३-४३", "content_sanskrit": "शत्रुघ्नं समरे वीरं शोचंतं पुष्कले हते ।\nरे शत्रुघ्न रणे शोकं मा कृथाः सुमहाबल॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000584043, "chapter_id": 20584, "verse_number": "५-४३-४४", "content_sanskrit": "वीराणां रणमध्ये तु पातनं कीर्तये स्मृतम् ।\nधन्यो वीरः पुष्कलाख्यो यश्च वै दिनपंचकम्॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000584044, "chapter_id": 20584, "verse_number": "५-४३-४५", "content_sanskrit": "युयुधे वीरभद्रेण महाप्रलयकारिणा ।\nयेन क्षणाद्विनिहतो दक्षो मदपमानकृत्॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000584045, "chapter_id": 20584, "verse_number": "५-४३-४६", "content_sanskrit": "क्षणाद्विनिहता येन दैत्यास्त्रिपुरसैनिकाः ।\nतस्माद्युद्ध्स्व राजेंद्र शोकं त्यक्त्वा महाबल॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000584046, "chapter_id": 20584, "verse_number": "५-४३-४७", "content_sanskrit": "यत्नात्तिष्ठाद्य वीराग्र्य मयि योद्धरि संस्थिते ।\nशोकं संत्यज्य शत्रुघ्नो वीरश्चुक्रोध शंकरम्॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000584047, "chapter_id": 20584, "verse_number": "५-४३-४८", "content_sanskrit": "आत्तसज्जधनुर्बाणैः प्रचच्छाद महेश्वरम् ।\nते बाणाः सुरशीर्षण्य वपुषं क्षतविक्षतम्॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000584048, "chapter_id": 20584, "verse_number": "५-४३-४९", "content_sanskrit": "अकुर्वत महच्चित्रं भक्तरक्षार्थमागतम् ।\nते बाणाः शंकरस्यापि बाणा नभसि संस्थिताः॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000584049, "chapter_id": 20584, "verse_number": "५-४३-५०", "content_sanskrit": "व्याप्यैतत्सकलं विश्वं चित्रकारि मुनेरपि ।\nतद्बाणयोर्युद्धबलं वीक्ष्य सर्वत्र मेनिरे॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000584050, "chapter_id": 20584, "verse_number": "५-४३-५१", "content_sanskrit": "प्रलयं लोकसंहारकारकं सर्वमोहकम् ।\nआकाशे तु विमानानि संश्रित्य स्वपुरस्थिताः॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000584051, "chapter_id": 20584, "verse_number": "५-४३-५२", "content_sanskrit": "विलोकयितुमागत्य प्रशंसंति तयोर्भृशम् ।\nअयं लोकत्रयस्यास्य प्रलयोत्पत्तिकारकः॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000584052, "chapter_id": 20584, "verse_number": "५-४३-५३", "content_sanskrit": "असावपि महाराज रामचंद्रस्य चानुजः ।\nकिमिदं भविता को वा जेष्यति क्षितिमंडले॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000584053, "chapter_id": 20584, "verse_number": "५-४३-५४", "content_sanskrit": "पराजयं वा को वीरः प्राप्स्यते रणमूर्धनि ।\nएवमेकादशाहानि वृत्तं युद्धं परस्परम्॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000584054, "chapter_id": 20584, "verse_number": "५-४३-५५", "content_sanskrit": "द्वादशे दिवसे प्राप्ते मुमोचास्त्रं नराधिपः ।\nब्रह्मसंज्ञं महादेवं हंतुं क्रोधसमन्वितः॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000584055, "chapter_id": 20584, "verse_number": "५-४३-५६", "content_sanskrit": "सविज्ञाय महास्त्रं तन्मुक्तं शत्रुघ्नवैरिणा ।\nहसन्नप्यपिबत्तेन मुक्तं ब्रह्मशिरो महत्॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000584056, "chapter_id": 20584, "verse_number": "५-४३-५७", "content_sanskrit": "अत्यंतं विस्मयं प्राप्य किं कर्तव्यमतः परम् ।\nएवं विचारयुक्तस्य हृदये ज्वलनोपमम्॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000584057, "chapter_id": 20584, "verse_number": "५-४३-५८", "content_sanskrit": "शरं वै निचखानाशु देवदेव शिरोमणिः ।\nतेन बाणेन शत्रुघ्नो मूर्च्छितो रणमंडले॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000584058, "chapter_id": 20584, "verse_number": "५-४३-५९", "content_sanskrit": "हाहाभूतमभूत्सर्वं कटकं भटसेवितम् ।\nवीराः सर्वे रुद्रगणैः पातिताः पृथिवीतले॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000584059, "chapter_id": 20584, "verse_number": "५-४३-६०", "content_sanskrit": "सुबाहुसुमदोन्मुख्याः स्वबाहुबलदर्पिताः ।\nपतितं मूर्च्छया वीक्ष्य शत्रुघ्नं शरपीडितम्॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000584060, "chapter_id": 20584, "verse_number": "५-४३-६१", "content_sanskrit": "पुष्कलं तु रथे स्थाप्य सेवकैः परिरक्षितुम् ।\nहनूमानागतो योद्धुं शिवं संहारकारकम्॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000584061, "chapter_id": 20584, "verse_number": "५-४३-६२", "content_sanskrit": "श्रीरामस्मरणं योधान्स्वीयान्विप्र प्रहर्षितान् ।\nप्रकुर्वन्रोषितस्तीव्रं लांगूलं च प्रकंपयन्॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}]