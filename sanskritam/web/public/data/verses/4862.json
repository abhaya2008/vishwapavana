[{"id": 2182203, "chapter_id": 4862, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2182204, "chapter_id": 4862, "verse_number": "१", "content_sanskrit": "केषां राजा प्रभवति वित्तस्य भरतर्षभ ।\nकया च वृत्त्या वर्तेत तन्मे ब्रूहि पितामह\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2182205, "chapter_id": 4862, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2182206, "chapter_id": 4862, "verse_number": "२", "content_sanskrit": "अब्राह्मणानां वित्तस्य स्वामी राजेति वैदिकम् ।\nब्राह्मणानां च ये केचिद् विकर्मस्था भवन्त्युत\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2182207, "chapter_id": 4862, "verse_number": "३", "content_sanskrit": "विकर्मस्थाश्च नोपेक्ष्या विप्रा राज्ञा कथञ्चन ।\nइति राज्ञां पुरावृत्तमभिजल्पन्ति साधवः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2182208, "chapter_id": 4862, "verse_number": "४", "content_sanskrit": "यस्य स्म विषये राज्ञः स्तेनो भवति वै द्विजः ।\nराज्ञ एवापराधं तं मन्यन्ते किल्बिषं नृप\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2182209, "chapter_id": 4862, "verse_number": "५", "content_sanskrit": "अभिशस्तमिवात्मानं मन्यन्ते तेन कर्मणा ।\nतस्माद् राजर्षयः सर्वे ब्राह्मणानन्वपालयन्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2182210, "chapter_id": 4862, "verse_number": "६", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nगीतं केकयराजेन ह्रियमाणेन रक्षसा\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2182211, "chapter_id": 4862, "verse_number": "७", "content_sanskrit": "केकयानामधिपतिं रक्षो जग्राह दारुणम् ।\nस्वाध्यायेनान्वितं राजन्नरण्ये संशितव्रतम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2182212, "chapter_id": 4862, "verse_number": "", "content_sanskrit": "राजा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2182213, "chapter_id": 4862, "verse_number": "८", "content_sanskrit": "न मे स्तेनो जनपदे न कदर्यो न मद्यपः ।\nनानाहिताग्निर्नायज्वा मा ममान्तरमाविशः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2182214, "chapter_id": 4862, "verse_number": "९", "content_sanskrit": "नच मे ब्राह्मणोऽविद्वान् नाव्रती नाप्यसोमपः ।\nनानाहिताग्निर्विषये मा ममान्तरमाविशः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2182215, "chapter_id": 4862, "verse_number": "१०", "content_sanskrit": "नानाप्तदक्षिणैर्यज्ञैर्यजन्ते विषये मम ।\nअधीते नाव्रती कश्चिन्मा ममान्तरमाविशः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2182216, "chapter_id": 4862, "verse_number": "११", "content_sanskrit": "अधीयतेऽध्यापयन्ति यजन्ते याजयन्ति च ।\nददति प्रतिगृह्णन्ति षट्सु कर्मस्ववस्थिताः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2182217, "chapter_id": 4862, "verse_number": "१२", "content_sanskrit": "पूजिताः संविभक्ताश्च मृदवः सत्यवादिनः ।\nब्राह्मणा मे स्वकर्मस्था मा ममान्तरमाविशः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2182218, "chapter_id": 4862, "verse_number": "१३", "content_sanskrit": "न याचन्ते प्रयच्छन्ति सत्यधर्मविशारदाः ।\nनाध्यापयन्त्यधीयन्ते यजन्ते नच याजकाः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2182219, "chapter_id": 4862, "verse_number": "१४", "content_sanskrit": "ब्राह्मणान् परिरक्षन्ति सङ्ग्रामेष्वपलायिनः ।\nक्षत्रिया मे स्वकर्मस्था मा ममान्तरमाविशः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2182220, "chapter_id": 4862, "verse_number": "१५", "content_sanskrit": "कृषिगोरक्षवाणिज्यमुपजीवन्त्यमायया ।\nअप्रमत्ताः क्रियावन्तः सुव्रताः सत्यवादिनः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2182221, "chapter_id": 4862, "verse_number": "१६", "content_sanskrit": "संविभागं दमं शौचं सौहृदं च व्यपाश्रिताः ।\nमम वैश्याः स्वकर्मस्थाः मा ममान्तरमाविशः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2182222, "chapter_id": 4862, "verse_number": "१७", "content_sanskrit": "त्रीन् वर्णाननुतिष्ठन्ति यथावदनसूयकाः ।\nमम शूद्राः स्वकर्मस्था मा ममान्तरमाविशः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2182223, "chapter_id": 4862, "verse_number": "१८", "content_sanskrit": "कृपणानाथवृद्धानां दुर्बलातुरयोषिताम् ।\nसंविभक्तास्मि सर्वेषां मा ममान्तरमाविशः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2182224, "chapter_id": 4862, "verse_number": "१९", "content_sanskrit": "कुलदेशादिधर्माणां प्रथितानां यथाविधि ।\nअव्युच्छेत्तास्मि सर्वेषां मा ममान्तरमाविशः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2182225, "chapter_id": 4862, "verse_number": "२०", "content_sanskrit": "तपस्विनो मे विषये पूजिताः परिपालिताः ।\nसंविभक्ताश्च सत्कृत्य मा ममान्तरमाविशः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2182226, "chapter_id": 4862, "verse_number": "२१", "content_sanskrit": "नासंविभज्य भोक्तास्मि न विशामि परस्त्रियम् ।\nस्वतन्त्रो जातु न क्रीडे मा ममान्तरमाविशः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2182227, "chapter_id": 4862, "verse_number": "२२", "content_sanskrit": "नाब्रह्मचारी भिक्षावान् भिक्षुर्वाब्रह्मचारिकः ।\nअनृत्विजं हुतं नास्ति मा ममान्तरमाविशः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2182228, "chapter_id": 4862, "verse_number": "२३", "content_sanskrit": "नावजानाम्यहं वृद्धान्न वैद्यान्न तपस्विनः ।\nराष्ट्रे स्वपति जागर्मि मा ममान्तरमाविशः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2182229, "chapter_id": 4862, "verse_number": "२४", "content_sanskrit": "शुक्लकर्मास्मि सर्वत्र न दुर्गतिभयं मम ।\nधर्मचारी गृहस्थश्च मा ममान्तरमाविशः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2182230, "chapter_id": 4862, "verse_number": "२५", "content_sanskrit": "वेदाध्ययनसम्पन्नस्तपस्वी सर्वधर्मवित् ।\nस्वामी सर्वस्य राज्यस्य श्रीमान् मम पुरोहितः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2182231, "chapter_id": 4862, "verse_number": "२६", "content_sanskrit": "दानेन दिव्यानभिवाञ्छामि लोकान्\nसत्येनाथो ब्राह्मणानां च गुप्त्या ।\nशुश्रूषया चापि गुरूनुपैमि\nन मे भयं विद्यते राक्षसेभ्यः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2182232, "chapter_id": 4862, "verse_number": "२७", "content_sanskrit": "न मे राष्ट्रे विधवा ब्रह्मबन्धु-\nर्न ब्राह्मणः कृपणो नोत चोरः ।\n,न पारजायी नच पापकर्मा\nन मे भयं विद्यते राक्षसेभ्यः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2182233, "chapter_id": 4862, "verse_number": "२८", "content_sanskrit": "न मे शस्त्रैरनिर्भिन्नमङ्गे द्व्यङ्गुलमन्तरम् ।\nधर्मार्थं युद्ध्यमानस्य मा ममान्तरमाविशः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2182234, "chapter_id": 4862, "verse_number": "२९", "content_sanskrit": "गोब्राह्मणे च यज्ञे च नित्यं स्वस्त्ययनं मम ।\nआशासते जना राष्ट्रे मा ममान्तरमाविशः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2182235, "chapter_id": 4862, "verse_number": "३०", "content_sanskrit": "नारीणां व्यभिचाराच्च अन्यायाच्च महीक्षिताम् ।\nविप्राणां कर्मदोषाच्च प्रजानां जायते भयम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2182236, "chapter_id": 4862, "verse_number": "३१", "content_sanskrit": "अवृष्टिर्मारको रोगः सततं क्षुद्भयानि च ।\nविग्रहश्च सदा तस्मिन् देशे भवति दारुणे\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2182237, "chapter_id": 4862, "verse_number": "३२", "content_sanskrit": "यक्षरक्षःपिशाचेभ्यो नासुरेभ्यः कथञ्चन ।\nभयमुत्पद्यते तत्र यत्र विप्राः सुसंयताः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2182238, "chapter_id": 4862, "verse_number": "३३", "content_sanskrit": "गन्धर्वाप्सरसः सिद्धा पन्नगाश्च सरीसृपाः ।\nमानवान्न जिघांसन्ति यत्र नार्यः पतिव्रताः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2182239, "chapter_id": 4862, "verse_number": "३४", "content_sanskrit": "ब्राह्मणा क्षत्रिया वैश्या यत्र शूद्राश्च धार्मिकाः ।\nनानावृष्टिभयं तत्र न दुर्भिक्षं न विभ्रमः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2182240, "chapter_id": 4862, "verse_number": "३५", "content_sanskrit": "धार्मिको यत्र भूपालो न तत्रास्ति पराभवः ।\nउत्पाता नच दृश्यन्ते न दिव्या नच मानुषा\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2182241, "chapter_id": 4862, "verse_number": "", "content_sanskrit": "राक्षसः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2182242, "chapter_id": 4862, "verse_number": "३६", "content_sanskrit": "यस्मात् सर्वास्ववस्थासु धर्ममेवान्ववेक्षसे ।\nतस्मात् प्राप्नुहि कैकेय गृहान् स्वस्ति व्रजाम्यहम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2182243, "chapter_id": 4862, "verse_number": "३७", "content_sanskrit": "येषां गोब्राह्मणा रक्ष्याः प्रजा रक्ष्याश्च केकय ।\nन रक्षोभ्यो भयं तेषां कुत एव तु मानुषात्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2182244, "chapter_id": 4862, "verse_number": "३८", "content_sanskrit": "येषां पुरोगमा विप्रा येषां ब्रह्मबलं बलम् ।\nप्रियातिथ्यास्तथा दारास्ते वै स्वर्गजितो नराः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2182245, "chapter_id": 4862, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2182246, "chapter_id": 4862, "verse_number": "३९", "content_sanskrit": "तस्माद् द्विजातीन् रक्षेत ते हि रक्षन्ति रक्षिताः ।\nआशीरेषां भवेद् राज्ञां राष्ट्रं सम्यक् प्रवर्धते\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2182247, "chapter_id": 4862, "verse_number": "४०", "content_sanskrit": "तस्माद् राज्ञा विशेषेण विकर्मस्था द्विजातयः ।\nनियम्याः संविभज्याश्च प्रजानुग्रहकारणात्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2182248, "chapter_id": 4862, "verse_number": "४१", "content_sanskrit": "य एवं वर्तते राजा पौरजानपदेष्विह ।\nअनुभूयेह भद्राणि प्राप्नोतीन्द्रसलोकताम्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2182249, "chapter_id": 4862, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि राजधर्मे एकोनाशीतितमोऽध्यायः ॥ ७९ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]