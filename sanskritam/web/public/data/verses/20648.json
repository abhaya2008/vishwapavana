[{"id": 7000648000, "chapter_id": 20648, "verse_number": "५-१०७-१", "content_sanskrit": "शुचिस्मितोवाच ।\nकश्यपं जमदग्निं च देवानां च पुरा कथम् ।\nररक्ष भस्म तद्ब्रह्मन्समाचक्ष्व मुने मम ॥१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000648001, "chapter_id": 20648, "verse_number": "५-१०७-२", "content_sanskrit": "दधीच उवाच ।\nकश्यपादियुता देवाः पूर्वमभ्यागमन्गिरिम् ।\nशोकरं नाम विख्यातं गिरिमध्ये सुशोभनम् ॥२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000648002, "chapter_id": 20648, "verse_number": "५-१०७-३", "content_sanskrit": "नानाविहंगसंकीर्णं नानामुनिगणाश्रयम् ।\nवासुदेवाश्रयं रम्यमप्सरोगणसेवितम् ॥३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000648003, "chapter_id": 20648, "verse_number": "५-१०७-४", "content_sanskrit": "विचित्रवृक्षसंवीतं सर्वर्तुकुसुमोज्ज्वलम् ।\nतथाविधं प्रविश्यैते गिरिं वयमथापरे ॥४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000648004, "chapter_id": 20648, "verse_number": "५-१०७-५", "content_sanskrit": "स्तुवंतः केशवं तत्र गताः स्म गिरिशेश्वरम् ।\nदृष्ट्वा तत्र महाज्वालां प्रविष्टाश्च वयं च ताम् ॥५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000648005, "chapter_id": 20648, "verse_number": "५-१०७-६", "content_sanskrit": "मामेकं तु तिरस्कृत्य ह्यदहद्देवता मुनीन् ।\nमां ददाह ततः पश्चाद्भस्मीभूता वयं शुभे ॥६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000648006, "chapter_id": 20648, "verse_number": "५-१०७-७", "content_sanskrit": "अस्मानेतादृशान्दृष्ट्वा वीरभद्रः प्रतापवान् ।\nकेनापिकारणेनासौ गतवान्पर्वतं च तम् ॥७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000648007, "chapter_id": 20648, "verse_number": "५-१०७-८", "content_sanskrit": "भस्मोद्धूलितसर्वांगो मस्तकस्थशिवः शुचिः ।\nएकाकी निःस्पृहः शान्तो हाहाशब्दमथाशृणोत् ॥८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000648008, "chapter_id": 20648, "verse_number": "५-१०७-९", "content_sanskrit": "अथ चिंतापरश्चासीन्म्रियमाण शवध्वनिः ।\nशवानामिवगंधश्च दृश्यते तन्निरीक्षणे ॥९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000648009, "chapter_id": 20648, "verse_number": "५-१०७-१०", "content_sanskrit": "इति निश्चित्य मनसा जगामाग्निमतिप्रभम् ।\nस वह्निर्वीरभद्रं च दग्धुमारब्धवानथ ॥१० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000648010, "chapter_id": 20648, "verse_number": "५-१०७-११", "content_sanskrit": "तृणाग्निरिव शांतोऽभूदासाद्य सलिलं यथा ।\nततोऽपरां महाज्वालां वीरभद्रस्तु दृष्टवान् ॥११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000648011, "chapter_id": 20648, "verse_number": "५-१०७-१२", "content_sanskrit": "खं गच्छंतीं महाकालो ज्वालां निपतितामपि ।\nमनसा चिंतयच्चापि वीरभद्रः प्रतापवान् ॥१२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000648012, "chapter_id": 20648, "verse_number": "५-१०७-१३", "content_sanskrit": "सर्वेषां नाशिनी ज्वाला प्राणिनां शतकोटिशः ।\nतत्सर्वं रक्षणार्थं हि पिपासुश्चाप्यहं त्विमाम् ॥१३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000648013, "chapter_id": 20648, "verse_number": "५-१०७-१४", "content_sanskrit": "प्राश्नामि महतीं ज्वालां सलिलं तृषितो यथा ।\nएतस्मिन्नंतरे वीरं वागाह चाशरीरिणी ॥१४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000648014, "chapter_id": 20648, "verse_number": "५-१०७-१५", "content_sanskrit": "भारत्युवाच ।\nवीर मा साहसं कार्षीः क्व तृषा क्वाशुशुक्षणिः ।\nतृषितानां जलेनार्थो विपरीतो वनाग्निना ॥१५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000648015, "chapter_id": 20648, "verse_number": "५-१०७-१६", "content_sanskrit": "निकामं योजनशिराः प्रणष्टो राक्षसेश्वरः ।\nशतयोजनवक्त्रश्च शतबाहुस्तथापरः ॥१६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000648016, "chapter_id": 20648, "verse_number": "५-१०७-१७", "content_sanskrit": "अगस्त्यश्च महाभागो निःशेषं पीतसागरः ।\nएतानन्यानसंख्याताञ्ज्वालेयं तानमारयत् ॥१७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000648017, "chapter_id": 20648, "verse_number": "५-१०७-१८", "content_sanskrit": "वीरभद्र उवाच ।\nभीषिकेयं महाज्वाला त्वदुक्ता न हि जायते ।\nसरस्वति भवत्यां च ममरोषश्च जायते ॥१८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000648018, "chapter_id": 20648, "verse_number": "५-१०७-१९", "content_sanskrit": "सर्वदेवार्चितपदं वीरभद्रमवेहि माम् ।\nभारत्युवाच ।\nमयोक्तं हितभावेन न द्वेषान्नान्यतो मुने ॥१९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000648019, "chapter_id": 20648, "verse_number": "५-१०७-२०", "content_sanskrit": "कोपमुत्सृज वीर त्वमात्मनोहितमाचर ।\nइत्युक्त्वांतर्दधे देवी भारती वीरभीतितः ॥२० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000648020, "chapter_id": 20648, "verse_number": "५-१०७-२१", "content_sanskrit": "अथ वीरो महाज्वालामपासील्लीलयैव तु ।\nक्षणेन महती ज्वाला शतयोजनविस्तृता ॥२१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000648021, "chapter_id": 20648, "verse_number": "५-१०७-२२", "content_sanskrit": "एकेन वीरभद्रेण पीता परमदुःसहा ।\nअथ चेंद्रमुखानां च मुनीनां भस्मराशयः ॥२२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000648022, "chapter_id": 20648, "verse_number": "५-१०७-२३", "content_sanskrit": "दृष्टा वै वीरभद्रेण आहूताश्च महात्मना ।\nन चाब्रुवन्प्रतिवचो मृता मुनिदिवौकसः ॥२३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000648023, "chapter_id": 20648, "verse_number": "५-१०७-२४", "content_sanskrit": "वीरभद्रस्तु विज्ञाय नाशं मुनिदिवौकसाम् ।\nदध्यावमून्कथं सर्वाञ्जीवयाम्यद्य कोविदः ॥२४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000648024, "chapter_id": 20648, "verse_number": "५-१०७-२५", "content_sanskrit": "ध्यानेन दृष्टवांश्चापि जीवितं भस्मदेहिनाम् ।\nअथाचम्य मृतानां तु भस्मान्यथ च भस्मना ॥२५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000648025, "chapter_id": 20648, "verse_number": "५-१०७-२६", "content_sanskrit": "मृत्युंजयेन मंत्रेण मंत्रितेन ह्यमंत्रयत् ।\nअथोत्थिता मुनिवराः स्वं स्वं रूपमुपाश्रिताः ॥२६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000648026, "chapter_id": 20648, "verse_number": "५-१०७-२७", "content_sanskrit": "अथ ते गतवंतश्च गिरिपार्श्वं महाप्रभम् ।\nतत्रापि भक्षिताः सर्वे सर्पेणातिशरीरिणा ॥२७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000648027, "chapter_id": 20648, "verse_number": "५-१०७-२८", "content_sanskrit": "अथ वीरो महासर्पसमीपमगमत्प्रभुः ।\nवीरमागतमालोक्य भुजगो योद्धुमारभत् ॥२८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000648028, "chapter_id": 20648, "verse_number": "५-१०७-२९", "content_sanskrit": "युयुधे वर्षमेकं तु नानारूपधरः फणी ।\nअथ वीरः प्रगृह्यौष्ठयुगं करयुगेन च ॥२९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000648029, "chapter_id": 20648, "verse_number": "५-१०७-३०", "content_sanskrit": "द्विधा चक्रे समस्तांगं देवांस्तत्र गतायुषः ।\nदृष्ट्वाथ भस्मनैवैताञ्जीवयामास शंकरः ॥३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000648030, "chapter_id": 20648, "verse_number": "५-१०७-३१", "content_sanskrit": "अथ देवाः समुनयो वीरभद्रं प्रणम्य तु ।\nगतवंतो यथामार्गं ददृशू रक्ष आगतम् ॥३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000648031, "chapter_id": 20648, "verse_number": "५-१०७-३२", "content_sanskrit": "पंचमेढ्रं महाकायं दोर्भिश्च दशभिर्युतम् ।\nपंचपादसमोपेतं शिरोभिर्युतमष्टभिः ॥३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000648032, "chapter_id": 20648, "verse_number": "५-१०७-३३", "content_sanskrit": "कांक्षमाणं महाहारं युध्यमानो हि वालिना ।\nमहावराहवपुषो वासुदेवस्य यद्बलम् ॥३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000648033, "chapter_id": 20648, "verse_number": "५-१०७-३४", "content_sanskrit": "तादृशं द्विगुणीभूतं कपौ वालिनि निश्चितम् ।\nतादृशं वानरश्रेष्ठं ससुग्रीवं सराक्षसः ॥३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000648034, "chapter_id": 20648, "verse_number": "५-१०७-३५", "content_sanskrit": "मुष्टियुद्धे पंचपादैः सहसा हत्य वालिनम् ।\nसुग्रीवं च कराभ्यां स हंतुमेव प्रचक्रमे ॥३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000648035, "chapter_id": 20648, "verse_number": "५-१०७-३६", "content_sanskrit": "आस्ये निक्षिप्य सुग्रीवमग्रसत्कवलं यथा ।\nवालिसुग्रीवग्रसनं दृष्ट्वा चिंतामवाप ह ॥३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000648036, "chapter_id": 20648, "verse_number": "५-१०७-३७", "content_sanskrit": "कथमेनं हनिष्यामि रक्षयिष्ये कथं कपिम् ।\nएवं हि चिंतयानं तं वानरं राक्षसेश्वरः ॥३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000648037, "chapter_id": 20648, "verse_number": "५-१०७-३८", "content_sanskrit": "अग्रसीदेकयत्नेन तथाभूतं च राक्षसम् ।\nदृष्ट्वा देवर्षयः सर्वे पलायनपरास्तथा ॥३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000648038, "chapter_id": 20648, "verse_number": "५-१०७-३९", "content_sanskrit": "पलायमानांस्तान्दृष्ट्वा पंचमेढ्रः स राक्षसः ।\nहस्तैः समस्तैस्तान्सर्वानादायाभक्षयत्तदा ॥३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000648039, "chapter_id": 20648, "verse_number": "५-१०७-४०", "content_sanskrit": "वीरभद्रस्ततो दृष्ट्वा वानरर्षिसुरादनम् ।\nपंचाशद्योजनशिलां करेणादाय तं रुषा ॥४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000648040, "chapter_id": 20648, "verse_number": "५-१०७-४१", "content_sanskrit": "निजघान शिरोमध्ये मध्यमं पतितं शिरः ।\nतत आदाय शैलस्य शृंगं तच्छतयोजनम् ॥४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000648041, "chapter_id": 20648, "verse_number": "५-१०७-४२", "content_sanskrit": "स्थापयित्वा दृढतरं राक्षसेंद्रं तथाहरत् ।\nराक्षसोऽथ बभाषे तं वीरभद्रं त्रिलोचनम् ॥४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000648042, "chapter_id": 20648, "verse_number": "५-१०७-४३", "content_sanskrit": "मम बाहुबलं पश्य वीक्षितं त्वद्बलं मया ।\nअसिद्वयं तैलधौतं पंचाशद्योजनोन्नतम् ॥४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000648043, "chapter_id": 20648, "verse_number": "५-१०७-४४", "content_sanskrit": "एकयोजनविस्तारं सुदृढं लक्षणान्वितम् ।\nएकं गृहाणाभिमतं विशिष्टं तन्ममप्रियम् ॥४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000648044, "chapter_id": 20648, "verse_number": "५-१०७-४५", "content_sanskrit": "वीरभद्रस्तथेत्युक्त्वा गृहीत्वासिं महाबलः ।\nकरेणाचालयत्तीक्ष्णं क्ष्वेलीं चक्रे ततः क्रुधा ॥४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000648045, "chapter_id": 20648, "verse_number": "५-१०७-४६", "content_sanskrit": "गृहीतासिस्तथा क्ष्वेलद्यं चक्रे राक्षसपुंगवः ।\nवीरभद्रं समभ्येत्य कंठं प्रतिसमर्पयत् ॥४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000648046, "chapter_id": 20648, "verse_number": "५-१०७-४७", "content_sanskrit": "तद्गात्रं भिन्नमभवच्छोणितं निर्गतं बहु ।\nराक्षसस्त्वेकहस्तेन पपौ तच्छोणितं ततः ॥४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000648047, "chapter_id": 20648, "verse_number": "५-१०७-४८", "content_sanskrit": "वीरभद्रः कंठदेशे राक्षसं प्राहरद्रुषा ।\nशिरोद्वयं तथाच्छिन्नं पतमानं ततोऽग्रहीत् ॥४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000648048, "chapter_id": 20648, "verse_number": "५-१०७-४९", "content_sanskrit": "न्यभक्षयदमेयात्मा सिंहनादं चकार ह ।\nतेन नादेन महता क्षुब्धमासीज्जगत्त्रयम् ॥४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000648049, "chapter_id": 20648, "verse_number": "५-१०७-५०", "content_sanskrit": "अन्योन्यमसिघातेन भिन्नगात्रौ विकस्वरौ ।\nकिंशुकाविव दृश्येते पुष्पितौ रुधिरोक्षितौ ॥५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000648050, "chapter_id": 20648, "verse_number": "५-१०७-५१", "content_sanskrit": "वर्षमेकं तु संयुध्य सासीदेवासुरौ तदा ।\nअतःपरं वर्षमेकं गदायुद्धमभूत्तयोः ॥५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000648051, "chapter_id": 20648, "verse_number": "५-१०७-५२", "content_sanskrit": "असिपुत्रिकया पश्चाद्वर्षमेकमभूद्रणः ।\nपुनर्गृहीत्वासियुगं युयुधाते परस्परम् ॥५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000648052, "chapter_id": 20648, "verse_number": "५-१०७-५३", "content_sanskrit": "शं ब्रुवाणो महाखड्गं दंष्ट्राकारो गणेश्वरः ।\nसरोषरक्तनयनश्चालयित्वासिमग्रतः ॥५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000648053, "chapter_id": 20648, "verse_number": "५-१०७-५४", "content_sanskrit": "तस्य कंठवनं सर्वं चिच्छेद कदलद्यं यथा ।\nशिरांसि सर्वाण्यादाय बभक्ष भगनेत्रहा ॥५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000648054, "chapter_id": 20648, "verse_number": "५-१०७-५५", "content_sanskrit": "तस्य गात्रं कररुहैर्विदार्याहृत्य देवताः ।\nकपींद्रौ च तथा चान्या अद्राक्षीत्परमेश्वरीम् ॥५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000648055, "chapter_id": 20648, "verse_number": "५-१०७-५६", "content_sanskrit": "एतद्युद्धं महाघोरं नारदो वीक्ष्य चाभ्यगात् ।\nब्रह्मणे वासुदेवाय शंकराय व्यजिज्ञपत् ॥५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000648056, "chapter_id": 20648, "verse_number": "५-१०७-५७", "content_sanskrit": "मुनयो रक्षिता देवा वालिसुग्रीव वानरौ ।\nएतौ संजीवयामास ब्रह्मविष्णुशिवात्मकः ॥५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000648057, "chapter_id": 20648, "verse_number": "५-१०७-५८", "content_sanskrit": "रक्षसे शंभुना दत्तो वरः परमदारुणः ।\nहिरण्यकशिपोराज्ये बलवानेक राक्षसः ॥५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000648058, "chapter_id": 20648, "verse_number": "५-१०७-५९", "content_sanskrit": "देवैः सार्द्धं तु युयुधे वर्षाणां शतमद्भुतम् ।\nपलायिताश्च बहुधा मृताश्च शतशोसुराः ॥५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000648059, "chapter_id": 20648, "verse_number": "५-१०७-६०", "content_sanskrit": "शुक्रेण रक्षितः सोऽथ गुरुणाचिंतयत्त्विदम् ।\nमृतोऽस्मि शतशः शुक्र जीवितोऽस्मि त्वयैव हि ॥६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000648060, "chapter_id": 20648, "verse_number": "५-१०७-६१", "content_sanskrit": "अमृत्यवे त्वमेतस्मादुदरस्थमृताय च ।\nअन्यथा मरणं मह्यं भविष्यति न संशयः ॥६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000648061, "chapter_id": 20648, "verse_number": "५-१०७-६२", "content_sanskrit": "गुरो यमेन साकं मे युद्धमासीत्सुदारुणम् ।\nमयासौ ग्रसितो युद्धे यमराजः प्रतापवान् ॥६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000648062, "chapter_id": 20648, "verse_number": "५-१०७-६३", "content_sanskrit": "ममोदरं प्रविश्यासौ बिभेद च ननाद च ।\nअहं मृतस्तदा चासं त्वया संजीवितः पुनः ॥६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000648063, "chapter_id": 20648, "verse_number": "५-१०७-६४", "content_sanskrit": "तस्मादुदरसंस्थानां मरणाय तपे तपः ।\nशुक्र उवाच ।\nएवमेतन्न संदेहो यथावत्त्वं समाचर ॥६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000648064, "chapter_id": 20648, "verse_number": "५-१०७-६५", "content_sanskrit": "स्यमंतपंचकं तीर्थं तत्र त्वं तप्तुमर्हसि ।\nराक्षस उवाच ।\nतपे महत्तपो घोरं यन्न चीर्णं सुरासुरैः ॥६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000648065, "chapter_id": 20648, "verse_number": "५-१०७-६६", "content_sanskrit": "गुल्फप्रदेशे पादान्ते त्वयःपाशैः प्रबध्य च ।\nअयःस्तंभयुगं कृत्वा अयःपट्टिकयान्वितम् ॥६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000648066, "chapter_id": 20648, "verse_number": "५-१०७-६७", "content_sanskrit": "पट्टिकायां पादबंधं कृत्वाधः शीर्षतां तथा ।\nविवृतास्यं तथा कल्पं कृत्वाधोमुखमुच्चकैः ॥६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000648067, "chapter_id": 20648, "verse_number": "५-१०७-६८", "content_sanskrit": "स्तंभोत्तरेण ज्वालायां चक्रिकायामितस्ततः ।\nअधःशिरास्तथा तिष्ठन्नुन्मील्यैव विलोचने ॥६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000648068, "chapter_id": 20648, "verse_number": "५-१०७-६९", "content_sanskrit": "एवं तपश्चरिष्यामि वरदः कोपि मे भवेत् ।\nब्रह्मा वा वरदः सोऽस्तु शंकरो विष्णुरेव च ॥६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000648069, "chapter_id": 20648, "verse_number": "५-१०७-७०", "content_sanskrit": "वरदे न तु मे भाव्यं यो वा कोवा वरप्रदः ।\nइत्थमाभाष्य मुनिना गुरुणा भार्गवेण सः ॥७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000648070, "chapter_id": 20648, "verse_number": "५-१०७-७१", "content_sanskrit": "तथातपच्च षण्मासं पुनरन्यच्चकार ह ।\nनखाभ्यां स्वशिरश्छित्त्वा जुहावाग्नौ समंत्रकम् ॥७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000648071, "chapter_id": 20648, "verse_number": "५-१०७-७२", "content_sanskrit": "नमो भद्राय मंत्रेण चत्वारि च शिरांसि सः ।\nपंचमं तु शिरो हातुं यतमाने च राक्षसे ॥७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000648072, "chapter_id": 20648, "verse_number": "५-१०७-७३", "content_sanskrit": "वह्निमध्यात्समुत्तस्थौ भगवानंबिकापतिः ।\nशुद्धस्फटिकसंकाशो बालचन्द्र विभूषणः ॥७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000648073, "chapter_id": 20648, "verse_number": "५-१०७-७४", "content_sanskrit": "अधःशिरस्कं तद्रक्ष इदमाह महेश्वरः ।\nमा साहसं कृथा रक्षो वरदोऽस्मि वरं वृणु ॥७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000648074, "chapter_id": 20648, "verse_number": "५-१०७-७५", "content_sanskrit": "राक्षस उवाच ।\nबहूनां च वराणां त्वं दाता नूनं महेश्वरः ।\nहतशीर्षसमुत्पत्तिं ग्रस्तजीवमृतिं तथा ॥७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000648075, "chapter_id": 20648, "verse_number": "५-१०७-७६", "content_sanskrit": "वराहवपुषो विष्णोरस्तु शक्तिश्चतुर्गुणा ।\nमयि तेन हि रोषः स्यात्संनिधिस्तु सदा मम ॥७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000648076, "chapter_id": 20648, "verse_number": "५-१०७-७७", "content_sanskrit": "त्वज्जटोत्पाटनेनैकः पुरुषः संभविष्यति ।\nतेनैव मरणं नान्यैरिदमस्तु वृतं मम ॥७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000648077, "chapter_id": 20648, "verse_number": "५-१०७-७८", "content_sanskrit": "भविष्यत्येवमेवैतदित्युक्त्वांतर्हितोहरः ।\nएवंलब्धवरः पापी राक्षसो निहतस्त्वया ॥७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000648078, "chapter_id": 20648, "verse_number": "५-१०७-७९", "content_sanskrit": "अथालिंग्य हरिर्वीरं शंकरश्च पितामहः ।\nयथागतमथोजग्मुरथ देवादियोषितः ॥७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000648079, "chapter_id": 20648, "verse_number": "५-१०७-८०", "content_sanskrit": "निपत्य दंडवद्भूमौ वीरभद्रमथाब्रुवन् ।\nनमस्ते देवदेवेश नमस्ते करुणाकर ॥८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000648080, "chapter_id": 20648, "verse_number": "५-१०७-८१", "content_sanskrit": "नमस्ते शाश्वतानंत नमस्ते वरदो भव ।\nवीरभद्र उवाच ।\nभस्मना जीवयिष्यामि सुरान्समुनि वानरान् ॥८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000648081, "chapter_id": 20648, "verse_number": "५-१०७-८२", "content_sanskrit": "भवतीभिः प्रतोष्टव्यं शोकः कार्यो न चाधुना ।\nइत्युक्त्वा वीरभद्रस्तु भस्मनाजीवयत्सतान् ॥८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000648082, "chapter_id": 20648, "verse_number": "५-१०७-८३", "content_sanskrit": "उत्थिता मुनिदेवाश्च वानरौ चोत्थितौ ततः ।\nइदमूचुर्वचो हृष्टाः शिरःस्थांजलयो नमन् ॥८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000648083, "chapter_id": 20648, "verse_number": "५-१०७-८४", "content_sanskrit": "त्वयात्र जीवितास्तात पिता त्वं धर्मतो हि नः ।\nअस्माकं शरणं नित्यं भव शंकरसंभव ॥८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000648084, "chapter_id": 20648, "verse_number": "५-१०७-८५", "content_sanskrit": "शिशूनां दुष्टचरितं दृष्ट्वा शिक्षेस्तथा च तान् ।\nरक्षेः परकृता बाधा व्याधिभ्यश्च यथौरसान् ॥८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000648085, "chapter_id": 20648, "verse_number": "५-१०७-८६", "content_sanskrit": "दक्षाध्वरे कृतागस्काः शिक्षिता भवतानघ ।\nइदानीं रक्षितास्तात वयं शिशुवदेव ते ॥८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000648086, "chapter_id": 20648, "verse_number": "५-१०७-८७", "content_sanskrit": "वीरभद्र उवाच ।\nसत्यमेतन्न संदेहो यत्र बाधा भवेत्तु वः ।\nतत्र मां स्मरत क्षिप्रं बाधानाशं गमिष्यति ॥८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000648087, "chapter_id": 20648, "verse_number": "५-१०७-८८", "content_sanskrit": "वीरभद्रं पदं येपि पठंत्यष्टशतं ततः ।\nप्रणवादि नमोंऽतं च चतुर्थीसहितं तथा ॥८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000648088, "chapter_id": 20648, "verse_number": "५-१०७-८९", "content_sanskrit": "तेषां राक्षसपीडानां नाशनं च भविष्यति ।\nब्रह्मराक्षसपीडासु पिशाचादिभयेषु च ॥८९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000648089, "chapter_id": 20648, "verse_number": "५-१०७-९०", "content_sanskrit": "नामानुस्मरणात्सर्वबाधानां च विनाशनम् ॥९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000648090, "chapter_id": 20648, "verse_number": "५-१०७-९१", "content_sanskrit": "विद्युत्प्रभालोचनमुग्रमीशं बालेंदुदंष्ट्रारुणशोभिताधरम् ।\nसुनीलगात्रं च जटाकृतस्रजं दधानमंगे भसितत्रिपुंड्रकम् ॥९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000648091, "chapter_id": 20648, "verse_number": "५-१०७-९२", "content_sanskrit": "ब्रह्मराक्षसमुक्त्यर्थं स्मरणं त्विदमीरितम् ।\nमंत्रे च वीरभद्रस्य सर्वमेतदुदीरितम् ॥९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000648092, "chapter_id": 20648, "verse_number": "५-१०७-९३", "content_sanskrit": "दधीच उवाच ।\nअथैवं विदधे वीरो मुनिदेवास्तथागताः ।\nएतत्त्रियायुषं प्रोक्तं भस्ममाहात्म्यमुत्तमम् ॥९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7000648093, "chapter_id": 20648, "verse_number": "५-१०७-९४", "content_sanskrit": "पठतः शृण्वतो वापि स्मरतोऽघविनाशनम् ।\nशिवभक्तिप्रदं पुण्यमायुरारोग्यवर्द्धनम् ॥९४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7000648094, "chapter_id": 20648, "verse_number": "५-१०७-९५", "content_sanskrit": "शुचिस्मितोवाच ।\nअहं कृतार्था धन्या च नारीणामुत्तमास्म्यहम् ।\nहतपापा तथा चास्मि नमस्ते मुनिपुंगव ॥९५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}]