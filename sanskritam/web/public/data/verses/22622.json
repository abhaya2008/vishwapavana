[{"id": 7002622000, "chapter_id": 22622, "verse_number": "५-७-१", "content_sanskrit": "सूत उवाच ।\nचित्रकूटगिरेर्देशे परिहारो महीपतिः ।\nकलिंजरपुरं रम्यमक्रोशायतनं स्मृतम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002622001, "chapter_id": 22622, "verse_number": "५-७-२", "content_sanskrit": "अध्यास्य बौद्धहंता स सुखितोभवदूर्जितः ।\nराजपुत्राख्यदेशे च चपहानिर्महीपतिः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002622002, "chapter_id": 22622, "verse_number": "५-७-३", "content_sanskrit": "अजमेरपुरं रम्यं विधिशोभासमन्वितम् ।\nचातुर्वर्ण्ययुतं दिव्यमध्यास्य सुखितोऽभवत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002622003, "chapter_id": 22622, "verse_number": "५-७-४", "content_sanskrit": "शुक्लो नाम महीपालो गत आनर्तऽमंडले ।\nद्वारकां नाम नगरीमध्यास्य सुखितोऽभवत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002622004, "chapter_id": 22622, "verse_number": "५-७-५", "content_sanskrit": "शौनक उवाच ।\nतेषामग्न्युद्भवानां च ये भूपा राज्यसत्कृताः ।\nतान्मे ब्रूहि महाभाग सूतो वाक्यमथाब्रवीत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002622005, "chapter_id": 22622, "verse_number": "५-७-६", "content_sanskrit": "गच्छध्वं ब्राह्मणाः सर्वे योगनिद्रावशो ह्यहम् ।\nतच्छुत्वा मुनयः सर्वे विष्णोर्ध्यानं प्रचक्रिरे ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002622006, "chapter_id": 22622, "verse_number": "५-७-७", "content_sanskrit": "पूर्णे द्वे च सहस्रान्ते सूतो वचनमब्रवीत् ।\nसप्तत्रिंशशते वर्षे दशाब्दे चाधिके कलौ ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002622007, "chapter_id": 22622, "verse_number": "५-७-८", "content_sanskrit": "प्रमरो नाम भूपालः कृतं राज्यं च षट्समाः ।\nमहामदस्ततो जातः पितुरर्धं कृतं पदम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002622008, "chapter_id": 22622, "verse_number": "५-७-९", "content_sanskrit": "देवापिस्तनयस्तस्य पितु स्तुल्यं कृतं पदम् ।\nदेवदूतस्तस्य सुतः पितुस्तुल्यं स्मृतं पदम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002622009, "chapter_id": 22622, "verse_number": "५-७-१०", "content_sanskrit": "तस्माद्गंधर्वसेनश्च पंचाशदब्दभूपदम् ।\nकृत्वा च स्वसुतं शंखमभिषिच्य वनं गतः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002622010, "chapter_id": 22622, "verse_number": "५-७-११", "content_sanskrit": "शंखेन तत्पदं प्राप्तं राज्यं त्रिंशत्समाः कृतम् ।\nदेवांगना वीरमती शक्रेण प्रेषिता तदा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002622011, "chapter_id": 22622, "verse_number": "५-७-१२", "content_sanskrit": "गंधर्वसेनं संप्राप्य पुत्ररत्नमजीजनत् ।\nसुतस्य जन्मकाले तु नभसः पुष्पवृष्टयः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002622012, "chapter_id": 22622, "verse_number": "५-७-१३", "content_sanskrit": "पेतुर्दुंदुभयो नेदुर्वांति वाताः सुखप्रदाः ।\nशिवदृष्टिर्द्विजो नाम शिष्यैस्सार्द्धं वनं गतः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002622013, "chapter_id": 22622, "verse_number": "५-७-१४", "content_sanskrit": "विंशद्भिः कर्मयोगं च समाराध्य शिवोऽभवत् ।\nपूर्णे त्रिंशच्छते वर्षे कलौ प्राप्ते भयंकरे ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002622014, "chapter_id": 22622, "verse_number": "५-७-१५", "content_sanskrit": "शकानां च विनाशार्थमार्यधर्मविवृद्धये ।\nजातश्शिवाज्ञया सोऽपि कैलासाद्गुह्यकालयात् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002622015, "chapter_id": 22622, "verse_number": "५-७-१६", "content_sanskrit": "विक्रमादित्यनामानं पिता कृत्वा मुमोद ह ।\nस बालोऽपि महाप्राज्ञः पितृ मातृप्रियंकरः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002622016, "chapter_id": 22622, "verse_number": "५-७-१७", "content_sanskrit": "पञ्चवर्षे वयःप्राप्ते तपसोऽर्थे वनं गतः ।\nद्वादशाब्दं प्रयत्नेन विक्रमेण कृतं तपः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002622017, "chapter_id": 22622, "verse_number": "५-७-१८", "content_sanskrit": "पश्चादम्बावतीं दिव्यां पुरीं यातः श्रियान्वितः ।\nदिव्यं सिंहासनं रम्यं द्वात्रिंशन्मूर्तिसंयुतम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002622018, "chapter_id": 22622, "verse_number": "५-७-१९", "content_sanskrit": "शिवेन प्रेषितं तस्मै सोपि तत्पदमग्रहीत् ।\nवैतालस्तस्य रक्षार्थं पार्वत्या निर्मितो गतः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002622019, "chapter_id": 22622, "verse_number": "५-७-२०", "content_sanskrit": "एकदा स नृपो वीरो महाकालेशश्वरस्थलम् ।\nगत्वा सम्पूजयामास देवदेवं पिनाकिनम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002622020, "chapter_id": 22622, "verse_number": "५-७-२१", "content_sanskrit": "सभा धर्ममयी तत्र निर्मिता व्यूहविस्तरा ।\nनानाधातुकृतस्तम्भा नानामणिविभूषिता ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002622021, "chapter_id": 22622, "verse_number": "५-७-२२", "content_sanskrit": "नानाद्रुमलताकीर्णा पुष्पवल्लीभिरन्विता ।\nतत्र सिंहासनं दिव्यं स्था पितं तेन शौनक ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002622022, "chapter_id": 22622, "verse_number": "५-७-२३", "content_sanskrit": "आहूय ब्राह्मणान्मुख्यान्वेदवेदांगपारगान् ।\nपूजयित्वा विधानेन धर्मगाथामथाऽशृणोत् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002622023, "chapter_id": 22622, "verse_number": "५-७-२४", "content_sanskrit": "एतस्मिन्नन्तरे तत्र वैतालो नाम देवता ।\nस कृत्वा ब्राह्मणं रूप जयाशीर्भिः प्रशस्य तम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002622024, "chapter_id": 22622, "verse_number": "५-७-२५", "content_sanskrit": "उपविश्यासने विप्रो राजानमिदमब्रवीत् ।\nयदि ते श्रवणे श्रद्धा विक्रमादित्यभूपते ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002622025, "chapter_id": 22622, "verse_number": "५-७-२६", "content_sanskrit": "वर्णयामि महाख्यानमितिहाससमुच्चयम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]