[{"id": 7003690000, "chapter_id": 23690, "verse_number": "१-३-११-१", "content_sanskrit": "ब्रह्मोवाच ।\nस तु सिंहस्थितां गौरीं ज्वलंती विविधायुधाम् ।\nशैलवर्षेण महता कुपितः समपूरयत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003690001, "chapter_id": 23690, "verse_number": "१-३-११-२", "content_sanskrit": "शरवर्षेण महता तन्निवार्य विदूरतः ।\nबिभेद निशितैः शस्त्रैरशेषं तस्य विग्रहम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003690002, "chapter_id": 23690, "verse_number": "१-३-११-३", "content_sanskrit": "भिद्यमानोऽपि दैत्येंद्रः शैलसारप्रदुर्धरः ।\nविषादं नागमत्किंचिद्ववृधे युद्धदुर्मदः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003690003, "chapter_id": 23690, "verse_number": "१-३-११-४", "content_sanskrit": "भिद्यमानः स खड्गेन चक्रैरसिभिरृष्टिभिः ।\nशूलेन चायुधैश्चान्यैरंतर्धानमगाहत ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003690004, "chapter_id": 23690, "verse_number": "१-३-११-५", "content_sanskrit": "ततः सिंहाकृतिर्भीमः प्रचंडनिनदाननः ।\nतीक्ष्णदंष्ट्रः शितनखः परिबभ्राम केसरी ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003690005, "chapter_id": 23690, "verse_number": "१-३-११-६", "content_sanskrit": "देवीसिंहश्चपेटेन ताडयामास पाणिना ।\nदैत्यसिंहस्य च नखैस्तस्य वक्षो व्यदारयत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003690006, "chapter_id": 23690, "verse_number": "१-३-११-७", "content_sanskrit": "अथ व्याघ्रतया प्राप्तः स्फुटव्यात्ताननो महान् ।\nतं हंतुं च बलाद्देवी वेगेन करमक्षिपत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003690007, "chapter_id": 23690, "verse_number": "१-३-११-८", "content_sanskrit": "दीर्घाभिर्न्नीलरेखाभिः पूर्णः पिंगलविग्रहः ।\nयानावलिभिराकीर्णः स्वर्णाद्रिरिव संचरन् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003690008, "chapter_id": 23690, "verse_number": "१-३-११-९", "content_sanskrit": "मृगैरिव परित्रातुं मुच्यमानोऽग्रतो बली ।\nज्वलंतमिव रोषाग्निं जिह्वाहेतिभिरावहन् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003690009, "chapter_id": 23690, "verse_number": "१-३-११-१०", "content_sanskrit": "आगच्छंतं रयाद्देवी भल्लेन शशिवर्चसा ।\nप्रतिविव्याध तं व्याघ्रं पुरत्रयमिवेश्वरः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003690010, "chapter_id": 23690, "verse_number": "१-३-११-११", "content_sanskrit": "स बाणस्तन्मुखे मग्नस्तद्रक्तेन समुक्षितः ।\nजगाहे गगनं भित्त्वा देहमस्य विनिर्गतः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003690011, "chapter_id": 23690, "verse_number": "१-३-११-१२", "content_sanskrit": "स दैत्यो वारणो भूत्वा देवीमाश्वभ्युपागमत् ।\nबलिभिः पशुभिर्भिन्नैस्तस्याः प्रीतिमिवावहन् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003690012, "chapter_id": 23690, "verse_number": "१-३-११-१३", "content_sanskrit": "तं गजेंद्रं समायांतं मदक्लिन्नमहीतलम् ।\nदेवीसिंहस्तदा दृष्ट्वा ननर्द च जघान च ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003690013, "chapter_id": 23690, "verse_number": "१-३-११-१४", "content_sanskrit": "अथ खड्गधरो वीरश्चर्मपाणिः समुद्गतः ।\nवक्त्रं दधानो बभ्राम दंष्ट्राभ्रुकुटिभीषणम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003690014, "chapter_id": 23690, "verse_number": "१-३-११-१५", "content_sanskrit": "देवी च विलसत्खड्गचक्रचक्रलसत्करा ।\nयुयोध तेन वीरेण भग्नशीर्षाभ्यपद्यत ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003690015, "chapter_id": 23690, "verse_number": "१-३-११-१६", "content_sanskrit": "भूयः स माहिषं रूपमास्थायासुरमायया ।\nदेव्या योद्धुं प्रववृते यथापूर्वमनाकुलम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003690016, "chapter_id": 23690, "verse_number": "१-३-११-१७", "content_sanskrit": "अथ देवैमुनींद्रैश्च चोदितो गौतमो मुनिः ।\nप्रबोधयितुमारेभे स्तुतिभिर्जगदंबिकाम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003690017, "chapter_id": 23690, "verse_number": "१-३-११-१८", "content_sanskrit": "त्वयि सर्वस्य जगतः प्राणशक्तिः परा मता ।\nओजःशक्तिर्ज्ञानशक्तिर्बलशक्तिश्च गम्यते ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003690018, "chapter_id": 23690, "verse_number": "१-३-११-१९", "content_sanskrit": "किमेतदद्य मोहाय युद्धमारभ्यते त्वया ।\nउपसंह्रियतामेष दैत्यो भुवनगुप्तये ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003690019, "chapter_id": 23690, "verse_number": "१-३-११-२०", "content_sanskrit": "भिन्नानामस्य देहानामुपसंहरणात्तव ।\nवलयश्चोपदिश्यन्ते निगमोक्ता वरप्रदाः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003690020, "chapter_id": 23690, "verse_number": "१-३-११-२१", "content_sanskrit": "अन्यथा तृणकल्पस्य शत्रोरस्य निबर्हणे ।\nकालाग्निवर्चसो देवि किमर्थं संभ्रमस्त्वियान् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003690021, "chapter_id": 23690, "verse_number": "१-३-११-२२", "content_sanskrit": "स्वशक्तिमवसंस्तभ्य समाकर्षयतां रिपोः ।\nप्राणशक्तिं त्रिशूलेन गुणत्रयवपुर्धृता ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003690022, "chapter_id": 23690, "verse_number": "१-३-११-२३", "content_sanskrit": "इति स्म बोधितातेन पुरा भगवती तदा ।\nमहिषासुरमाक्रम्य त्रिशूलेनाभ्यधारयत् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003690023, "chapter_id": 23690, "verse_number": "१-३-११-२४", "content_sanskrit": "अनेकगिरिसंकाशं देव्या विग्रहमात्मनः ।\nअशक्तस्तं धारयितुं ससाद महिषासुरः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003690024, "chapter_id": 23690, "verse_number": "१-३-११-२५", "content_sanskrit": "निष्पिष्टो विलुठन्क्रोशन्नाक्रांतश्च परिस्फुरन् ।\nनिर्गंतुमुद्गतशिरा न शशाकासुराधिपः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003690025, "chapter_id": 23690, "verse_number": "१-३-११-२६", "content_sanskrit": "त्रिशूलमुखभिन्नांगरक्तधारासमुद्धतः ।\nसमुद्र इव संजातः संध्यारुणकलेवरः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003690026, "chapter_id": 23690, "verse_number": "१-३-११-२७", "content_sanskrit": "अथ खड्गेन तीक्ष्णेन कर्तयित्वा च तच्छिरः ।\nननर्त्त तस्य शिरसि तिष्ठन्ती महिषार्दिनी ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003690027, "chapter_id": 23690, "verse_number": "१-३-११-२८", "content_sanskrit": "दुर्गां सिद्धाश्च गन्धर्वाः प्रशशंसुर्महर्षयः ।\nपुष्पवृष्टिश्च महती देवैर्मुक्ता समंततः ।\nप्रणतः प्रांजलिर्देवीं तुष्टाव विबुधाधिपः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003690028, "chapter_id": 23690, "verse_number": "१-३-११-२९", "content_sanskrit": "इन्द्र उवाच ।\nनमस्ते जगतां मात्रे भूतानां बीजसंविदे ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003690029, "chapter_id": 23690, "verse_number": "१-३-११-३०", "content_sanskrit": "भक्तिः श्रद्धा च भजतां शक्तिश्चासि त्वमंबिके ।\nकारणं परमा कीर्तिः शातिर्दांतिः कला क्षमा ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003690030, "chapter_id": 23690, "verse_number": "१-३-११-३१", "content_sanskrit": "एकैव विश्वरूपा त्वं नामभेदेर्निगद्यसे ।\nतेषुतेषु पदेष्वस्मांस्तपोऽनुगुणसिद्धिषु ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003690031, "chapter_id": 23690, "verse_number": "१-३-११-३२", "content_sanskrit": "नियुज्य शत्रुं निर्भिद्य शिवा ज्ञेया प्रकाशसे ।\nहतोयं महिषो दुष्टो विनिकृत्तश्च शांभवि ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003690032, "chapter_id": 23690, "verse_number": "१-३-११-३३", "content_sanskrit": "छिन्नमेतस्य तु शिरः सजीवमिव लक्ष्यते ।\nरक्तनेत्रं तीक्ष्णशृगं ज्वलज्जिह्वं चलं शिरः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003690033, "chapter_id": 23690, "verse_number": "१-३-११-३४", "content_sanskrit": "आक्रम्य तव तिष्ठन्त्या रूपमेव सदास्तु नः ।\nचक्रशृंगधनुर्बाणखङ्गचर्मवराभयैः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003690034, "chapter_id": 23690, "verse_number": "१-३-११-३५", "content_sanskrit": "शूलघण्टांकुशकशाकपालकुलिशादिभिः ।\nअशेषदेवतामूर्तिरशेषैदेंवतायुधैः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003690035, "chapter_id": 23690, "verse_number": "१-३-११-३६", "content_sanskrit": "आपूरिता त्वमेवांब सर्वशत्रून्निहंसि नः ।\nआयुधानां सहस्राणि तन्मयास्ते विभूतयः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003690036, "chapter_id": 23690, "verse_number": "१-३-११-३७", "content_sanskrit": "त्वज्जितारातयः सर्वे विविधायुधवाहनाः ।\nरथनागहयैर्युक्ताः ससैन्या अपि भूभृतः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003690037, "chapter_id": 23690, "verse_number": "१-३-११-३८", "content_sanskrit": "क्षणेन दग्धवीर्याः स्युस्त्वत्प्रसादविवर्जिताः ।\nअपदोऽप्यल्पवीर्योऽपि त्वत्पादांबुजसेवकः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003690038, "chapter_id": 23690, "verse_number": "१-३-११-३९", "content_sanskrit": "त्रिलोकनाथतां प्राप्तः प्रथते कीर्तिमण्डितः ।\nतद्रूपमिदमत्युग्रं ध्यायतामर्चतां सदा ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003690039, "chapter_id": 23690, "verse_number": "१-३-११-४०", "content_sanskrit": "न शत्रुभ्यो भयं किंचिद्भवेद्विजयशालिनाम् ।\nईदृशं सर्वलोकेषु रूपं ते देववंदितम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003690040, "chapter_id": 23690, "verse_number": "१-३-११-४१", "content_sanskrit": "पूज्यतामिष्टसिद्ध्यर्थं देवैर्भृत्यैश्च सर्वदा ।\nमातरश्च त्वया सृष्टाः सर्वाभीष्टफलप्रदाः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003690041, "chapter_id": 23690, "verse_number": "१-३-११-४२", "content_sanskrit": "सगणाः प्रतिपूज्यंतां सर्वस्थानेषु सर्वदा ।\nअयं च निहतो दैत्यस्त्वत्पादकृतलांछनः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003690042, "chapter_id": 23690, "verse_number": "१-३-११-४३", "content_sanskrit": "तव भक्तैः सदा पूज्यस्त्वत्प्रमादात्त्वदग्रतः ।\nइत्थं सुरेन्द्रप्रणुता सर्वर्षिसुरसेविता ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003690043, "chapter_id": 23690, "verse_number": "१-३-११-४४", "content_sanskrit": "तथेति वरदा देवी ससर्ज च दिवं प्रति ।\nस्वयमप्यात्मनस्तत्र तद्रूपं विविधायुधम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003690044, "chapter_id": 23690, "verse_number": "१-३-११-४५", "content_sanskrit": "संस्थाप्य मातृभिः सार्धं स्थानरक्षणमातनोत् ।\nसंगृह्य विमलं रूपं सखीजनसमावृता ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003690045, "chapter_id": 23690, "verse_number": "१-३-११-४६", "content_sanskrit": "महिषस्य शिरोऽपश्यद्विकृतं खङ्गधारया ।\nकथयन्ती पुनस्तस्य चित्रं लोकविभूषणम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003690046, "chapter_id": 23690, "verse_number": "१-३-११-४७", "content_sanskrit": "सखीभिः सह सा बाला कण्ठं तस्य व्यलोकयत् ।\nअपश्यच्च तदा लिगं कर्त्तुं तस्य च पूजनम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003690047, "chapter_id": 23690, "verse_number": "१-३-११-४८", "content_sanskrit": "आदत्त सहसा गौरी लिगं तस्य गले स्थितम् ।\nआलोकयच्च सुचिरं रक्तधारापरिप्लुतम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003690048, "chapter_id": 23690, "verse_number": "१-३-११-४९", "content_sanskrit": "आसज्जत पुनर्लिंगमस्याः पाणितलं गतम् ।\nविमोचयितुमुद्युक्ता नाशक्नोल्लग्नमंजसा ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003690049, "chapter_id": 23690, "verse_number": "१-३-११-५०", "content_sanskrit": "अचिंतयच्च सा देवी किमेतदिति विस्मयात् ।\nविषादेन च संयुक्ता महर्षीणां पुरः स्थिता ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003690050, "chapter_id": 23690, "verse_number": "१-३-११-५१", "content_sanskrit": "आहतः शिवभक्तोऽयमिति शोकं समाविशत् ।\nअगर्हत भृशं मौढ्यमात्मनः स्त्रीस्वभावजम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003690051, "chapter_id": 23690, "verse_number": "१-३-११-५२", "content_sanskrit": "अविचार समारब्धं शिवभक्तनिबर्हणम् ।\nउपतापपरीतांगी गौतमं मुनिसत्तमम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003690052, "chapter_id": 23690, "verse_number": "१-३-११-५३", "content_sanskrit": "उपगम्याब्रवीद्बाला साहसं कृतमात्मना ।\nभगवन्सर्वधर्मज्ञ गौतमार्य मुनीश्वर ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003690053, "chapter_id": 23690, "verse_number": "१-३-११-५४", "content_sanskrit": "मान्यया धर्मरूपेण कोऽप्यधर्मः प्रकल्पितः ।\nदेवानां रक्षणं कर्तुमभयं दातुमुद्यता ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003690054, "chapter_id": 23690, "verse_number": "१-३-११-५५", "content_sanskrit": "अज्ञानान्महिषं दैत्यं शिवभक्तिममर्दयम् ।\nरजसाक्रान्तबुद्धीनां न भवेद्धर्मसंग्रहः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003690055, "chapter_id": 23690, "verse_number": "१-३-११-५६", "content_sanskrit": "गुरुप्रसादसुलभः स्फुरद्विघ्नशताकुलः ।\nसुदुर्धर्षा निराचारदुर्दमाः शिवसंश्रयाः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003690056, "chapter_id": 23690, "verse_number": "१-३-११-५७", "content_sanskrit": "विशेषतो लिंगधराः शिवस्तान्बहु मन्यते ।\nपुरा पुरत्रयावासा दैतेया लिंगधारका ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003690057, "chapter_id": 23690, "verse_number": "१-३-११-५८", "content_sanskrit": "अजिताः शंभुना पूर्वं मुक्तलिंगा निषूदिताः ।\nअस्य कंठस्थितं लिंगं मम पाणिं न मुंचति ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003690058, "chapter_id": 23690, "verse_number": "१-३-११-५९", "content_sanskrit": "कथं पापं निरस्यामि शिवभक्तवधाश्रितम् ।\nअस्य कंठस्थितं लिंगं धारयंती तपोन्विता ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003690059, "chapter_id": 23690, "verse_number": "१-३-११-६०", "content_sanskrit": "तीर्थयात्रां करिष्यामि यावच्छंभुः प्रसीदति ।\nपुनः कैलासमुख्येषु शंभुस्थानेषु भूरिषु ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003690060, "chapter_id": 23690, "verse_number": "१-३-११-६१", "content_sanskrit": "तीर्थेषु रचितस्नाना लप्स्ये पापविशोधनम् ।\nइति तस्याः परिश्रांतिं दुर्धर्मपरिशंकया ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003690061, "chapter_id": 23690, "verse_number": "१-३-११-६२", "content_sanskrit": "आकर्ण्य शिवधर्मज्ञो भयार्त्तां तामवोचत ।\nमा भैषीर्गिरिजे मोहाच्छिवभक्तो हतस्त्विति ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003690062, "chapter_id": 23690, "verse_number": "१-३-११-६३", "content_sanskrit": "धर्मसूक्ष्मार्थवेत्तारौ दुर्लभा गिरिकन्यके ।\nसदा शिवस्य वदनैः सद्योजातादि संश्रितैः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003690063, "chapter_id": 23690, "verse_number": "१-३-११-६४", "content_sanskrit": "आगमाः पंचभिः प्रोक्ता अष्टाविंशतिकोटयः ।\nनिर्णयाः शिवभक्तानां शिवमार्गस्य शोभनाः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003690064, "chapter_id": 23690, "verse_number": "१-३-११-६५", "content_sanskrit": "तेषुतेषु मुनींद्रैश्च नत्वैव प्रतिपद्यते ।\nकालो मुखं च कंकालं शैवं पाशुपतं तथा ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003690065, "chapter_id": 23690, "verse_number": "१-३-११-६६", "content_sanskrit": "महाव्रतं पंच चैताः शिवमार्गप्रवृत्तयः ।\nभेदाश्च बहवस्तेषामन्योन्यस्य शिवे रताः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003690066, "chapter_id": 23690, "verse_number": "१-३-११-६७", "content_sanskrit": "साध्य एको हि बलवान्सर्वैस्तैरनिशं शिवः ।\nसर्व एव सदा पूज्याः स्वधर्मपरिनिष्ठितैः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003690067, "chapter_id": 23690, "verse_number": "१-३-११-६८", "content_sanskrit": "अमत्सरैः शिवे भक्तैः शिवाज्ञापरिपालकैः ।\nवेदैश्च बहुभिर्यज्ञैर्भक्त्या च परया शिवः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003690068, "chapter_id": 23690, "verse_number": "१-३-११-६९", "content_sanskrit": "आराध्यते महादेवः सर्वदा सर्वदायकः ।\nजीवहिंसा न कर्त्तव्या विशेषण तपस्विभिः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003690069, "chapter_id": 23690, "verse_number": "१-३-११-७०", "content_sanskrit": "शिवधर्मस्य भेत्तारो निहंतव्यास्तथांजसा ।\nन वेषजुषि वीक्षेत न लिगं नैव संभवम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003690070, "chapter_id": 23690, "verse_number": "१-३-११-७१", "content_sanskrit": "शिवधर्मस्य भेत्तारं हन्यादेवाविचारयन् ।\nबहुभिः स्फूर्तया बुद्ध्या धर्मविद्भिर्निरूपिते ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003690071, "chapter_id": 23690, "verse_number": "१-३-११-७२", "content_sanskrit": "शिवधर्मस्य विलये सद्यः शक्तिः प्रवर्तते ।\nअस्य कर्म पुनर्दिष्टं लिंगमैश्वर्यचर्चितम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003690072, "chapter_id": 23690, "verse_number": "१-३-११-७३", "content_sanskrit": "न जेतुं शक्यते देवि तेनासौ सर्वदैवतैः ।\nयदयं निहतो देवि त्वया शंकरमान्यया ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003690073, "chapter_id": 23690, "verse_number": "१-३-११-७४", "content_sanskrit": "आक्रांतः शापदोषेण महर्षीणां शिवाश्रयात् ।\nअथ ते कुपितास्तस्य वैषम्यादवमानतः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003690074, "chapter_id": 23690, "verse_number": "१-३-११-७५", "content_sanskrit": "शेपुर्महिषवद्दुष्टो महिषोऽयं भवत्विति ।\nततस्तद्वचनात्सद्यो महिषोऽभूत्क्षणात्तथा ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003690075, "chapter_id": 23690, "verse_number": "१-३-११-७६", "content_sanskrit": "प्रणम्य तोषयामास ययाचे शापमोचनम् ।\nदत्त्वा प्रकामरूपत्वं ददुरस्मै प्रसादिताः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003690076, "chapter_id": 23690, "verse_number": "१-३-११-७७", "content_sanskrit": "महिषत्वेपि संहारं स्वयं देव्या शिवाज्ञया ।\nविषादो न च कर्त्तव्यो अंगदर्शनतस्त्वया ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003690077, "chapter_id": 23690, "verse_number": "१-३-११-७८", "content_sanskrit": "सिद्धानां शिवरूपाणामवज्ञा कं न बाधते ।\nमहिषत्वे समुत्पन्ने दोषेण समुपस्थिते ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003690078, "chapter_id": 23690, "verse_number": "१-३-११-७९", "content_sanskrit": "सिद्धप्रसादाल्लब्धोऽयं शापनाशस्त्वया कृतः ।\nसर्वे लोकाश्च संत्राता दुष्टोयं परिरक्षितः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003690079, "chapter_id": 23690, "verse_number": "१-३-११-८०", "content_sanskrit": "शापदोषसमुत्पन्ने महिषत्वे विमोचिते ।\nत्वया च गिरिशप्रीत्यै तपः कुर्वाणयाद्रिजे ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003690080, "chapter_id": 23690, "verse_number": "१-३-११-८१", "content_sanskrit": "द्रष्टव्यं तैजसं लिंगमरुणाचलसंज्ञितम् ।\nपूर्वजन्मनि भक्तोऽयमरुणाद्रिपतेः स्फुटम् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003690081, "chapter_id": 23690, "verse_number": "१-३-११-८२", "content_sanskrit": "महिषत्वे मदाक्रांतः परं लिंगेन संगतः ।\nभक्त्या लिंगधरं हंतुं कः समर्थो जगत्त्रये ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003690082, "chapter_id": 23690, "verse_number": "१-३-११-८३", "content_sanskrit": "दृष्टाः पुरत्रये पूर्वं रुद्रेण पूजितास्त्रयः ।\nत्वत्खड्गपरिकृत्तेन कंठेनास्य वरानने ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003690083, "chapter_id": 23690, "verse_number": "१-३-११-८४", "content_sanskrit": "दीक्षादिरहितं लिंगं दत्तं हंतीति चोदितम् ।\nकृतं हि महिषेणापि भक्तितो लिंगधारणम् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003690084, "chapter_id": 23690, "verse_number": "१-३-११-८५", "content_sanskrit": "कदाचित्क्षपणोक्तानां विभाषात्प्रत्ययं गतः ।\nपूर्वजन्मतपोयोगात्स्मरणो लिंगधारणात् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003690085, "chapter_id": 23690, "verse_number": "१-३-११-८६", "content_sanskrit": "त्वत्पादपद्मसंस्पर्शादयं मुक्तो न संशयः ।\nमदुक्तनिष्कृतीनां तु पातकानां च नाशनम् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003690086, "chapter_id": 23690, "verse_number": "१-३-११-८७", "content_sanskrit": "दर्शनं शैलवर्यस्य प्रायश्चित्तं परं मतम् ।\nसंस्थाप्य विविधाञ्छैवाञ्छिवसिद्धांतवेदिनः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003690087, "chapter_id": 23690, "verse_number": "१-३-११-८८", "content_sanskrit": "आवाह्य सर्वतीर्थानि सर्वदोषनिवृत्तये ।\nसरः किमपि संपाद्य स्नात्वा तत्र वरानने ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003690088, "chapter_id": 23690, "verse_number": "१-३-११-८९", "content_sanskrit": "अघमर्षणसंयुक्ता सलिंगा स्नानमाचर ।\nत्रिसंध्यं चैव मासांते देवयागमहोत्सवे ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003690089, "chapter_id": 23690, "verse_number": "१-३-११-९०", "content_sanskrit": "आराधयोपचारैस्त्वमरुणाद्रिमयं शिवम् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003690090, "chapter_id": 23690, "verse_number": "१-३-११-९१", "content_sanskrit": "एवं तस्य मुनेर्निशम्य वचनं शैवार्थसंभावितं प्रीता देवनमस्कृता गिरिसुता देवी जगद्रक्षिका ।\nशैवं धर्ममिमं विधातुमुचितं शोणाचलस्याग्रतस्तीर्थागाहनबुद्धिमाशु विदधे कर्तुं त्वघक्षालनम् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003690091, "chapter_id": 23690, "verse_number": "१-३-११-९२", "content_sanskrit": "इति श्रीस्कान्दे महापुराण एकाशीतिसाहस्र्यां संहितायां प्रथमे माहेश्वरखण्डेऽरुणाचलमाहात्म्ये पूर्वार्धे महिषासुरवधोत्तरं देवीपाणौ महिषासुरशिरःसंलग्रतावृत्तांतवर्णनंनामैकादशोऽध्यायः ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}]