[{"id": 2064553, "chapter_id": 2371, "verse_number": "८-९२-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2064554, "chapter_id": 2371, "verse_number": "८-९२-१", "content_sanskrit": "प्रजापतिस्तु तं दृष्ट्वा देवभागं समागतम्।\nअब्रवीत्तु ततो राजन्पश्यतो वै स्वयंभुवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2064555, "chapter_id": 2371, "verse_number": "८-९२-२", "content_sanskrit": "उभावतिरथौ शूरावुभौ दृढपराक्रमौ।\nउभौ सदृशकर्माणौ वज्रिचक्रायुधौपमौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2064556, "chapter_id": 2371, "verse_number": "८-९२-३", "content_sanskrit": "अहो बत महद्युद्धं कर्णार्जुनसमागमे।\nभविष्यति महाघोरं वृत्रवासवयोरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2064557, "chapter_id": 2371, "verse_number": "८-९२-४", "content_sanskrit": "प्रजापतिरथोक्त्वैवं स्वयम्भुवमचोदयत्।\nसमोऽस्तु विजयः काममुभयोर्नरसिंहयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2064558, "chapter_id": 2371, "verse_number": "८-९२-५", "content_sanskrit": "कर्णार्जुनविवादेन मा नश्येदखिलं जगत्।\nस्वयंभो ब्रूहि तद्वाक्यं समोऽस्तु विजयोऽनयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2064559, "chapter_id": 2371, "verse_number": "८-९२-६", "content_sanskrit": "एवमुक्तस्तु भगवाञ्जये ताभ्यामनिश्चिते।\nइत्यब्रवीन्महाराज महाब्रह्मा प्रजापतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2064560, "chapter_id": 2371, "verse_number": "८-९२-७", "content_sanskrit": "द्वावप्येतौ हि कृतिनौ द्वावप्यतिबलोत्कटौ।\nभविष्यत्यनयोर्युद्धं त्रैलोक्यस्य भयावहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2064561, "chapter_id": 2371, "verse_number": "८-९२-८", "content_sanskrit": "ततः प्रजापतिं तत्र सहस्राक्षोऽभ्यचोदयत्।\nविजयो ध्रुव एवास्तु पाण्डवस्य महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2064562, "chapter_id": 2371, "verse_number": "८-९२-९", "content_sanskrit": "मनस्वी बलवाञ्शूरः कृतविद्यस्तपोधनः।\nविभर्ति च महातेजा धनुर्वेदमशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2064563, "chapter_id": 2371, "verse_number": "८-९२-१०", "content_sanskrit": "पार्थः सर्वगुणोपेतो देवकार्यमिदं यतः।\nक्लिश्यन्ते पाण्डवा नित्यं वनवासादिभिर्भृशं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2064564, "chapter_id": 2371, "verse_number": "८-९२-११", "content_sanskrit": "सम्पन्नस्तपसा चैव पर्याप्तः पुरुषर्षभः।\nअतिक्रामेच्च माहात्म्याद्दिष्टमप्यविचारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2064565, "chapter_id": 2371, "verse_number": "८-९२-१२", "content_sanskrit": "अतिक्रमे च लोकानामभावो नियतो भवेत्।\nनावस्थानं च पश्यामि क्रुद्धयोः कृष्णयोः क्वचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2064566, "chapter_id": 2371, "verse_number": "८-९२-१३", "content_sanskrit": "स्रष्टारौ जगतश्चैतौ ततश्च पुरुषर्षभौ।\nनरनारायणावेतौ पुराणावृषिसत्तमौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2064567, "chapter_id": 2371, "verse_number": "८-९२-१४", "content_sanskrit": "अनियम्यौ नियन्तारौ जगतः पुरुषर्षभौ।\n[नैतयोस्तु समः कश्चिद्दिवि वा मानुषेषु वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2064568, "chapter_id": 2371, "verse_number": "८-९२-१५", "content_sanskrit": "अनुगम्यास्त्रयो लोकाः सह देवर्षिचारणैः।\nसर्वदेवगणाश्चापि सर्वभूतानि यानि च।\nअनयोस्तु प्रभावेन वर्तते निखिलं जगत्॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2064569, "chapter_id": 2371, "verse_number": "८-९२-१६", "content_sanskrit": "कामं तु सुकृताँल्लोकानाप्नोतु पुरुषर्षभः।\nकर्णो वैकर्तनः शूरो विजयस्त्वस्तु कृष्णयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2064570, "chapter_id": 2371, "verse_number": "८-९२-१७", "content_sanskrit": "वसूनां समलोकत्वं मरुतां वासमाप्नुयात्।\nसहितो द्रोणभीष्माभ्यां नाकपृष्ठे महीयताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2064571, "chapter_id": 2371, "verse_number": "८-९२-१८", "content_sanskrit": "`क्लेशितो हि वने पार्थो दिर्घकालं पितामह।\nतस्मादेष जयेद्युद्धे तपसाऽभ्यधिकोऽर्जुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2064572, "chapter_id": 2371, "verse_number": "८-९२-१९", "content_sanskrit": "पूर्वं भगवता प्रोक्तः कृष्णयोर्विजयो ध्रुवः।\nतत्तथास्तु नमस्तेऽस्तु प्रमो ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2064573, "chapter_id": 2371, "verse_number": "८-९२-२०", "content_sanskrit": "तत्सहस्राक्षवचनं निशम्य भगवान्प्रभुः।\nनोवाच तज्जयं तुल्यं तयोः कर्णकिरीटिनोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2064574, "chapter_id": 2371, "verse_number": "८-९२-२१", "content_sanskrit": "तस्मादाशां गतः शक्रस्तूष्णीम्भूते पितामहे।\nविजयः पाण्डवेयस्य कर्णस्य च वधो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2064575, "chapter_id": 2371, "verse_number": "८-९२-२२", "content_sanskrit": "ब्रह्मेशानौ ततो वाक्यमूचतुर्भुवनेश्वरम्।\nविजयो ध्रुव एवास्तु पाण्डवस्य महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2064576, "chapter_id": 2371, "verse_number": "८-९२-२३", "content_sanskrit": "मनस्वी जयतां शूरः कृतविद्यस्तपोधनः।\nबिभर्ति च महातेजा धनुर्वेदमशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2064577, "chapter_id": 2371, "verse_number": "८-९२-२४", "content_sanskrit": "अतिक्रामेच्च माहात्म्याद्दिष्टमप्यविचारयन्।\nअतिक्रमे च लोकानामभावो नियतो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2064578, "chapter_id": 2371, "verse_number": "८-९२-२५", "content_sanskrit": "न च विद्म ह्यवस्थानं क्रुद्धयोः कृष्णयोः क्वचित्।\nस्रष्टारौ जगतश्चैव सतश्च पुरुषर्षभौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2064579, "chapter_id": 2371, "verse_number": "८-९२-२६", "content_sanskrit": "कामं तु सुकृताँल्लोकान्प्राप्नोत्वेष परन्तपः।\nकर्णो वैकर्तनः शूरो विजयस्तु नरे ध्रुवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2064580, "chapter_id": 2371, "verse_number": "८-९२-२७", "content_sanskrit": "तथोक्ते देवदेवाभ्यां सहस्राक्षोऽब्रवीद्वचः।\nआमन्त्र्य सर्वभूतानि ब्रह्मेशानानुशासनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2064581, "chapter_id": 2371, "verse_number": "८-९२-२८", "content_sanskrit": "श्रुतं भवद्भिर्यत्प्रोक्तं भगवद्भ्यां जगद्धितम्।\nतत्तथा व्येतु ते रोगः शमाप्नुत विमन्यवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2064582, "chapter_id": 2371, "verse_number": "८-९२-२९", "content_sanskrit": "इति श्रुत्वेन्द्रवचनं सर्वभूतानि मानिष।\nविस्मितान्यभवन्राजन्पूजयाञ्चक्रिरे तदा।\nनोचुस्तदा जयं तुल्यं तयोः पुरुषसिंहयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2064583, "chapter_id": 2371, "verse_number": "८-९२-३०", "content_sanskrit": "व्यसृजंश्च सुगन्धीनि पुष्पवर्षाणि हर्षिताः।\nनानारूपाणि विबुधा देवतूर्याण्यवादयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2064584, "chapter_id": 2371, "verse_number": "८-९२-३१", "content_sanskrit": "दिदृक्षवश्चाप्रतिमं द्वैरथं नरसिंहयोः।\nविस्मयोत्फुल्लनयना नान्या बुबुधिरे क्रियाः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2064585, "chapter_id": 2371, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि सप्तदशदिवसयुद्धे द्विनवतितमोऽध्यायः॥ ९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]