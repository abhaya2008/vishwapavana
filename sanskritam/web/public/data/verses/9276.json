[{"id": 5000276000, "chapter_id": 9276, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे किष्किन्धाकाण्डे चतुर्थः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000276001, "chapter_id": 9276, "verse_number": "४-४-१", "content_sanskrit": "ततः प्रहृष्टो हनुमान् कृत्यवानिति तद्वचः।\nश्रुत्वा मधुरभावं च सुग्रीवं मनसा गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000276002, "chapter_id": 9276, "verse_number": "४-४-२", "content_sanskrit": "भाव्यो राज्यागमस्तस्य सुग्रीवस्य महात्मनः।\nयदयं कृत्यवान् प्राप्तः कृत्यं चैतदुपागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000276003, "chapter_id": 9276, "verse_number": "४-४-३", "content_sanskrit": "ततः परमसंहृष्टो हनूमान् प्लवगोत्तमः।\nप्रत्युवाच ततो वाक्यं रामं वाक्यविशारदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000276004, "chapter_id": 9276, "verse_number": "४-४-४", "content_sanskrit": "किमर्थं त्वं वनं घोरं पम्पाकाननमण्डितम्।\nआगतः सानुजो दुर्गं नानाव्यालमृगायुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000276005, "chapter_id": 9276, "verse_number": "४-४-५", "content_sanskrit": "तस्य तद् वचनं श्रुत्वा लक्ष्मणो रामचोदितः।\nआचचक्षे महात्मानं रामं दशरथात्मजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000276006, "chapter_id": 9276, "verse_number": "४-४-६", "content_sanskrit": "राजा दशरथो नाम द्युतिमान् धर्मवत्सलः।\nचातुर्वर्ण्यं स्वधर्मेण नित्यमेवाभिपालयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000276007, "chapter_id": 9276, "verse_number": "४-४-७", "content_sanskrit": "न द्वेष्टा विद्यते तस्य स तु द्वेष्टि न कंचन।\nस तु सर्वेषु भूतेषु पितामह इवापरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000276008, "chapter_id": 9276, "verse_number": "४-४-८", "content_sanskrit": "अग्निष्टोमादिभिर्यज्ञैरिष्टवानाप्तदक्षिणैः।\nतस्यायं पूर्वजः पुत्रो रामो नाम जनैः श्रुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000276009, "chapter_id": 9276, "verse_number": "४-४-९", "content_sanskrit": "शरण्यः सर्वभूतानां पितुर्निर्देशपारगः।\nज्येष्ठो दशरथस्यायं पुत्राणां गुणवत्तरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000276010, "chapter_id": 9276, "verse_number": "४-४-१०", "content_sanskrit": "राजलक्षणसंयुक्तः संयुक्तो राज्यसम्पदा।\nराज्याद् भ्रष्टो मया वस्तुं वने सार्धमिहागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000276011, "chapter_id": 9276, "verse_number": "४-४-११", "content_sanskrit": "भार्यया च महाभाग सीतयानुगतो वशी।\nदिनक्षये महातेजाः प्रभयेव दिवाकरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000276012, "chapter_id": 9276, "verse_number": "४-४-१२", "content_sanskrit": "अहमस्यावरो भ्राता गुणैर्दास्यमुपागतः।\nकृतज्ञस्य बहुज्ञस्य लक्ष्मणो नाम नामतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000276013, "chapter_id": 9276, "verse_number": "४-४-१३", "content_sanskrit": "सुखार्हस्य महार्हस्य सर्वभूतहितात्मनः।\nऐश्वर्येण विहीनस्य वनवासे रतस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000276014, "chapter_id": 9276, "verse_number": "४-४-१४", "content_sanskrit": "रक्षसापहृता भार्या रहिते कामरूपिणा।\nतच्च न ज्ञायते रक्षः पत्नी येनास्य वा हृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000276015, "chapter_id": 9276, "verse_number": "४-४-१५", "content_sanskrit": "दनुर्नाम दितेः पुत्रः शापाद् राक्षसतां गतः।\nआख्यातस्तेन सुग्रीवः समर्थो वानराधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000276016, "chapter_id": 9276, "verse_number": "४-४-१६", "content_sanskrit": "स ज्ञास्यति महावीर्यस्तव भार्यापहारिणम्।\nएवमुक्त्वा दनुः स्वर्गं भ्राजमानो दिवं गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000276017, "chapter_id": 9276, "verse_number": "४-४-१७", "content_sanskrit": "एतत् ते सर्वमाख्यातं याथातथ्येन पृच्छतः।\nअहं चैव च रामश्च सुग्रीवं शरणं गतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000276018, "chapter_id": 9276, "verse_number": "४-४-१८", "content_sanskrit": "एष दत्त्वा च वित्तानि प्राप्य चानुत्तमं यशः।\nलोकनाथः पुरा भूत्वा सुग्रीवं नाथमिच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000276019, "chapter_id": 9276, "verse_number": "४-४-१९", "content_sanskrit": "सीता यस्य स्नुषा चासीच्छरण्यो धर्मवत्सलः।\nतस्य पुत्रः शरण्यश्च सुग्रीवं शरणं गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000276020, "chapter_id": 9276, "verse_number": "४-४-२०", "content_sanskrit": "सर्वलोकस्य धर्मात्मा शरण्यः शरणं पुरा।\nगुरुर्मे राघवः सोऽयं सुग्रीवं शरणं गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000276021, "chapter_id": 9276, "verse_number": "४-४-२१", "content_sanskrit": "यस्य प्रसादे सततं प्रसीदेयुरिमाः प्रजाः।\nस रामो वानरेन्द्रस्य प्रसादमभिकांक्षते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000276022, "chapter_id": 9276, "verse_number": "४-४-२२", "content_sanskrit": "येन सर्वगुणोपेताः पृथिव्यां सर्वपार्थिवाः।\nमानिताः सततं राज्ञा सदा दशरथेन वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000276023, "chapter_id": 9276, "verse_number": "४-४-२३", "content_sanskrit": "तस्यायं पूर्वजः पुत्रस्त्रिषु लोकेषु विश्रुतः।\nसुग्रीवं वानरेन्द्रं तु रामः शरणमागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000276024, "chapter_id": 9276, "verse_number": "४-४-२४", "content_sanskrit": "शोकाभिभूते रामे तु शोकार्ते शरणं गते।\nकर्तुमर्हति सुग्रीवः प्रसादं सह यूथपैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000276025, "chapter_id": 9276, "verse_number": "४-४-२५", "content_sanskrit": "एवं ब्रुवाणं सौमित्रिं करुणं साश्रुपातनम्।\nहनूमान् प्रत्युवाचेदं वाक्यं वाक्यविशारदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000276026, "chapter_id": 9276, "verse_number": "४-४-२६", "content_sanskrit": "ईदृशा बुद्धिसम्पन्ना जितक्रोधा जितेन्द्रियाः।\nद्रष्टव्या वानरेन्द्रेण दिष्ट्या दर्शनमागताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000276027, "chapter_id": 9276, "verse_number": "४-४-२७", "content_sanskrit": "स हि राज्याश्च विभ्रष्टः कृतवैरश्च वालिना।\nहृतदारो वने त्रस्तो भ्रात्रा विनिकृतो भृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000276028, "chapter_id": 9276, "verse_number": "४-४-२८", "content_sanskrit": "करिष्यति स साहाय्यं युवयोर्भास्करात्मजः।\nसुग्रीवः सह चास्माभिः सीतायाः परिमार्गणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000276029, "chapter_id": 9276, "verse_number": "४-४-२९", "content_sanskrit": "इत्येवमुक्त्वा हनुमान् श्लक्ष्णं मधुरया गिरा।\nबभाषे साधु गच्छामः सुग्रीवमिति राघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000276030, "chapter_id": 9276, "verse_number": "४-४-३०", "content_sanskrit": "एवं ब्रुवन्तं धर्मात्मा हनूमन्तं स लक्ष्मणः।\nप्रतिपूज्य यथान्यायमिदं प्रोवाच राघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000276031, "chapter_id": 9276, "verse_number": "४-४-३१", "content_sanskrit": "कपिः कथयते हृष्टो यथायं मारुतात्मजः।\nकृत्यवान् सोऽपि सम्प्राप्तः कृतकृत्योऽसि राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000276032, "chapter_id": 9276, "verse_number": "४-४-३२", "content_sanskrit": "प्रसन्नमुखवर्णश्च व्यक्तं हृष्टश्च भाषते।\nनानृतं वक्ष्यते वीरो हनूमान् मारुतात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000276033, "chapter_id": 9276, "verse_number": "४-४-३३", "content_sanskrit": "ततः स सुमहाप्राज्ञो हनूमान् मारुतात्मजः।\nजगामादाय तौ वीरौ हरिराजाय राघवौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000276034, "chapter_id": 9276, "verse_number": "४-४-३४", "content_sanskrit": "भिक्षुरूपं परित्यज्य वानरं रूपमास्थितः।\nपृष्ठमारोप्य तौ वीरौ जगाम कपिकुञ्जरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000276035, "chapter_id": 9276, "verse_number": "४-४-३५", "content_sanskrit": "स तु विपुलयशाः कपिप्रवीरः\nपवनसुतः कृतकृत्यवत् प्रहृष्टः।\nगिरिवरमुरुविक्रमः प्रयातः\nस शुभमतिः सह रामलक्ष्मणाभ्याम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000276036, "chapter_id": 9276, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे चतुर्थः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]