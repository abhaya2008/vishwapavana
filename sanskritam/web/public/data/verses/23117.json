[{"id": 7003117000, "chapter_id": 23117, "verse_number": "४-५३-१", "content_sanskrit": "नारद उवाच ।\nसमतीते पूर्णरासे किं चकार जगत्पतिः ।\nरहस्यं किं बभूवाथ तद्भवान्वक्तुमर्हति ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003117001, "chapter_id": 23117, "verse_number": "४-५३-२", "content_sanskrit": "श्रीनारायण उवाच ।\nरासं निवर्त्य रासे च रासेश्वर्या समन्वितः ।\nस्वयं रासेश्वरस्तस्माद्यमुनापुलिनं ययौ ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003117002, "chapter_id": 23117, "verse_number": "४-५३-३", "content_sanskrit": "तत्र स्नात्वा जलं पीत्वा निर्मलं निर्मले जले ।\nसार्द्धं गोपाङ्गनाभिश्च जलक्रीडां चकार सः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003117003, "chapter_id": 23117, "verse_number": "४-५३-४", "content_sanskrit": "ततो जगाम भगवान्भाण्डीरं राधया सह ।\nगोपाङ्गनाश्च स्वगृहान्प्रययुर्विरहातुराः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003117004, "chapter_id": 23117, "verse_number": "४-५३-५", "content_sanskrit": "क्रीडां चकार रहसि भाण्डीरे मालतीवने ।\nमालतीपुष्पशय्यायां रम्यायां रमणोत्सुकः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003117005, "chapter_id": 23117, "verse_number": "४-५३-६", "content_sanskrit": "कृत्वा क्रीडां च तत्रैव वासन्तीकाननं ययौ ।\nरेमे तत्रैव रासेशो वसन्ते सुमनोहरे ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003117006, "chapter_id": 23117, "verse_number": "४-५३-७", "content_sanskrit": "तत्रैव रमणं कृत्वा ययौ चन्दनकाननम् ।\nचन्दनोक्षितसर्वांगो गृहीत्वा चन्दनोक्षित म् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003117007, "chapter_id": 23117, "verse_number": "४-५३-८", "content_sanskrit": "रम्ये चन्दनतल्पे च स्निग्धे चन्दनपल्लवे ।\nपूर्णचन्द्रे समुदिते विजहार तया सह ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003117008, "chapter_id": 23117, "verse_number": "४-५३-९", "content_sanskrit": "कृत्वा विहारं तत्रैव ययौ चम्पककाननम् ।\nरम्ये चम्पकतल्पे च चकार रतिमीश्व री ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003117009, "chapter_id": 23117, "verse_number": "४-५३-१०", "content_sanskrit": "रतिं निर्वर्त्य तत्रैव ययौ पद्मवनं प्रभुः ।\nपद्मपत्रसमाकीर्णे तल्पेऽतिसुमनोहरे ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003117010, "chapter_id": 23117, "verse_number": "४-५३-११", "content_sanskrit": "सार्धं तत्र पद्ममुख्या शीतेन पद्मवायुना।\nचकार सुखसंभोगं ययौ निद्रां तया सह ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003117011, "chapter_id": 23117, "verse_number": "४-५३-१२", "content_sanskrit": "विहाय निद्रां निद्रेशो ददर्श निद्रितां प्रियाम् ।\nशयानां पद्मतल्पे च सुखसंभोगमात्रतः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003117012, "chapter_id": 23117, "verse_number": "४-५३-१३", "content_sanskrit": "दृष्ट्वा मुखं च घर्माक्तं शरच्चन्द्रविनिंदितम् ।\nअतिसंलुप्तसिन्दूरं लुप्तं कज्जलमुल्बणम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003117013, "chapter_id": 23117, "verse_number": "४-५३-१४", "content_sanskrit": "संलुप्ताधररागं च संलुप्तगण्डपत्रकम् ।\nविस्रस्तकबरीभारं नेत्रोत्पलविमुद्रितम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003117014, "chapter_id": 23117, "verse_number": "४-५३-१५", "content_sanskrit": "रत्नकुण्डलयुग्मेनामूल्येन परिशोभितम् ।\nराजितं मौक्तिकेनैव गजराजोद्भवेन च ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003117015, "chapter_id": 23117, "verse_number": "४-५३-१६", "content_sanskrit": "प्रेम्णा स्वसूक्ष्मवस्त्रेण वह्निशुद्धेन माधवः ।\nचकार मार्जनं भक्त्या तद्वक्त्रं भक्तवत्सलः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003117016, "chapter_id": 23117, "verse_number": "४-५३-१७", "content_sanskrit": "केशसंमार्जनं कृत्वा निर्माय कबरीं हरिः ।\nमाधवीमालतीमालाजालेन परिशोभिताम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003117017, "chapter_id": 23117, "verse_number": "४-५३-१८", "content_sanskrit": "रत्नपट्टसूत्रबद्धां वामवक्त्रां मनोहराम् ।\nअतीव वर्तुलाकारां कुन्दपुष्पसुशोभिताम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003117018, "chapter_id": 23117, "verse_number": "४-५३-१९", "content_sanskrit": "ददौ सिन्दूरतिलकमधश्चन्दनमुज्ज्वलम् ।\nकस्तूरीबिन्दुना सार्द्धं परितः परिशोभिताम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003117019, "chapter_id": 23117, "verse_number": "४-५३-२०", "content_sanskrit": "चकार पत्रकं गण्डयुग्मे चित्रविचित्रितम् ।\nप्रददौ कज्जलं भक्त्या नेत्रोत्पलसमुज्ज्वलम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003117020, "chapter_id": 23117, "verse_number": "४-५३-२१", "content_sanskrit": "चकाराधररागं च राधायाश्चानुरागतः ।\nकर्णभूषणयुग्मं च चकारातीव निर्मलम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003117021, "chapter_id": 23117, "verse_number": "४-५३-२२", "content_sanskrit": "अमूल्यरत्नहारं च स्तनभार युगोज्ज्वलम् ।\nददौ कण्ठे च वैकुण्ठो मणिराजिविराजितम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003117022, "chapter_id": 23117, "verse_number": "४-५३-२३", "content_sanskrit": "वह्निशुद्धांशुकं दिव्यममूल्यं विश्वरत्नतः ।\nवासयामास वसनं कस्तूरीकुङ्कुमाक्तकम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003117023, "chapter_id": 23117, "verse_number": "४-५३-२४", "content_sanskrit": "प्रददौ पादयुगले रत्नमञ्जीररञ्जितम् ।\nचकारालक्तकं भक्त्या पादुङ्गुलिनखेषु च ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003117024, "chapter_id": 23117, "verse_number": "४-५३-२५", "content_sanskrit": "चकार सेवां सेव्यायाः सेव्यस्त्रिजगतां सताम् ।\nअहो सेवकसंभक्त्या श्वेतेन चामरेण च ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003117025, "chapter_id": 23117, "verse_number": "४-५३-२६", "content_sanskrit": "सर्वभावविदां श्रेष्ठो बोधज्ञः कामशास्त्रवित् ।\nकामिनीं बोधयामास वासयामास वक्षसि ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003117026, "chapter_id": 23117, "verse_number": "४-५३-२७", "content_sanskrit": "प्रेम्णा च प्रददौ तस्यै सद्रत्नदर्पणं शुभम् ।\nसुवेषदर्शनार्थं च मुखचन्द्रं च मार्जितुम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003117027, "chapter_id": 23117, "verse_number": "४-५३-२८", "content_sanskrit": "नानापुष्पैर्विरचितामम्लानां चन्दनोक्षिताम् ।\nगण्डे सौभाग्ययुक्तायाः सौभाग्येन ददौ हरिः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003117028, "chapter_id": 23117, "verse_number": "४-५३-२९", "content_sanskrit": "कस्तूरीकुङ्कमाक्तं च सुगन्धिचन्दनं ततः ।\nददौ प्रियायाः सर्वाङ्गे प्रियः प्रेमभरेण च ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003117029, "chapter_id": 23117, "verse_number": "४-५३-३०", "content_sanskrit": "पारिजातस्य कुसुमं दत्तं रहसि ब्रह्मणा ।\nप्रददौ तत्कबर्यां च ललितायां च नारद ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003117030, "chapter_id": 23117, "verse_number": "४-५३-३१", "content_sanskrit": "कमलं निर्मलं दिव्यं सहस्रदलमुज्ज्वलम् ।\nशिवेन दत्तं रहसि ददौ तद्दक्षिणे करे ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003117031, "chapter_id": 23117, "verse_number": "४-५३-३२", "content_sanskrit": "अतिसारं मणीन्द्राणां मणिरत्नं च कौस्तुभम् ।\nदत्तं रहसि धर्मेण तस्यै सुप्रीतये ददौ ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003117032, "chapter_id": 23117, "verse_number": "४-५३-३३", "content_sanskrit": "आसवं रत्नपात्रस्थं दस्रदत्तं च निर्जने ।\nपानार्थं प्रददौ तस्यै कामोन्मादकरं परम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003117033, "chapter_id": 23117, "verse_number": "४-५३-३४", "content_sanskrit": "मालतीमाधवीकुन्दमन्दारचम्पकादिकम्।\nपुष्पं सद्रत्नपात्रस्थं तस्यै सुप्रीतये ददौ ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003117034, "chapter_id": 23117, "verse_number": "४-५३-३५", "content_sanskrit": "सुदुर्लभं च ताम्बूलं कर्पूरादिसुसंस्कृतम् ।\nभक्षणं कारयामास समयज्ञश्च तां प्रियाम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003117035, "chapter_id": 23117, "verse_number": "४-५३-३६", "content_sanskrit": "सुदुर्लभं च विश्वेषु वाक्पतेः परिनिर्मितम् ।\nअनुत्तमममूल्यं च वरुणेन रहःस्थले ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003117036, "chapter_id": 23117, "verse_number": "४-५३-३७", "content_sanskrit": "अतिसूक्ष्ममनुपमं दत्तं भक्त्या विराजितम् ।\nवासयामास वसनं कृत्वा नग्नां च कौतुकात् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003117037, "chapter_id": 23117, "verse_number": "४-५३-३८", "content_sanskrit": "देवराजेन दत्तं च गजराजेन्द्रमौक्तिकम् ।\nनासिकाभूषणं चारु तस्यै सुप्रीतये ददौ ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003117038, "chapter_id": 23117, "verse_number": "४-५३-३९", "content_sanskrit": "एतस्मिन्नन्तरे तत्र सुशीलाद्याश्च गोपिकाः ।\nषष्टिः सत्सहचर्यश्च राधायाः सुप्रतिष्ठिताः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003117039, "chapter_id": 23117, "verse_number": "४-५३-४०", "content_sanskrit": "षष्टिसत्कोटिगोपीभिः सार्धं संहृष्टमानसाः ।\nआययुः पादचिह्नेन प्रियस्य वहतः प्रियाम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003117040, "chapter_id": 23117, "verse_number": "४-५३-४१", "content_sanskrit": "काश्चिच्चंदनहस्ताश्च काश्चिच्चामरवाहिकाः ।\nकाश्चित्कस्तूरिहस्ताश्च मालाहस्ताश्च काश्चन ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003117041, "chapter_id": 23117, "verse_number": "४-५३-४२", "content_sanskrit": "काश्चित्सिंदूरहस्ताश्च काश्चित्कंकतिकाकराः ।\nकाश्चिदलक्तककरा वस्त्रहस्ताश्च काश्चन ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003117042, "chapter_id": 23117, "verse_number": "४-५३-४३", "content_sanskrit": "काश्चिद्दर्पणहस्ताश्च पुष्पपात्रधरा वराः ।\nकाश्चित्क्रीडापद्महस्ता मालाहस्ताश्च काश्चन ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003117043, "chapter_id": 23117, "verse_number": "४-५३-४४", "content_sanskrit": "काश्चिदासवहस्ताश्च काश्चिद्भूषणवाहिकाः ।\nकरतालकराः काश्चिन्मृदंगवाहिकाः पराः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003117044, "chapter_id": 23117, "verse_number": "४-५३-४५", "content_sanskrit": "स्वरयंत्रकराः काश्चिद्वीणाहस्ताश्च काश्चन ।\nषट्त्रिंशद्रागरागिण्यो गोपिकारूपधारिकाः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003117045, "chapter_id": 23117, "verse_number": "४-५३-४६", "content_sanskrit": "गोलोकादागतायाश्च भारतं राधया सह ।\nकाश्चिज्जगुश्च ननृतुस्तत्रागत्य च काश्चन ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003117046, "chapter_id": 23117, "verse_number": "४-५३-४७", "content_sanskrit": "काश्चिच्चक्रुश्च सेवां च राधायाः श्वेतचामरैः ।\nकाश्चिच्चक्रुश्च देव्याश्च पादसंवाहनं मुदा ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003117047, "chapter_id": 23117, "verse_number": "४-५३-४८", "content_sanskrit": "काचिद्ददौ च ताम्बूलं भक्षणार्थे महामुने ।\nएवं कौतुकयुक्तश्च पुण्ये वृन्दावने वने ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003117048, "chapter_id": 23117, "verse_number": "४-५३-४९", "content_sanskrit": "प्रतस्थौ गोपिकासार्द्धं राधावक्षःस्थलस्थितः ।\nक्षणं पपौ च माध्वीकं प्रियया सह माधवः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003117049, "chapter_id": 23117, "verse_number": "४-५३-५०", "content_sanskrit": "क्षणं चखाद ताम्बूलं क्षणं निद्रां ययौ मुदा ।\nक्षणं चकार शृङ्गारं रत्ननिर्मितमन्दिरे ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003117050, "chapter_id": 23117, "verse_number": "४-५३-५१", "content_sanskrit": "क्षणं जलविहारं च चकार यमुनाजले ।\nइत्येवं कथिता वत्स रासक्रीडा हरेरहो ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003117051, "chapter_id": 23117, "verse_number": "४-५३-५२", "content_sanskrit": "स्वेच्छामयस्यात्मनश्च परिपूर्णतमस्य च ।\nनिर्गुणस्य स्वतन्त्रस्य परस्य प्रकृतेः प्रभोः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003117052, "chapter_id": 23117, "verse_number": "४-५३-५३", "content_sanskrit": "ब्रह्मविष्णुशिवादीनामीश्वरस्य परस्य च ।\nकृष्णजन्मरहस्यं च बालक्रीडनमीप्सितम् ॥५३। ।\nउक्तं किशोरचरितं किं भूयः श्रोतुमिच्छसि ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]