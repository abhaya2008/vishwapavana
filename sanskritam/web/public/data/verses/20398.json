[{"id": 7000398000, "chapter_id": 20398, "verse_number": "२-७०-१", "content_sanskrit": "मातलिरुवाच ।\nयमपीडां प्रवक्ष्यामि महातीव्रां सुदारुणाम् ।\nभुंजंति पापिनः सर्वे क्रूरास्ते ब्रह्मघातकाः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000398001, "chapter_id": 20398, "verse_number": "२-७०-२", "content_sanskrit": "क्वचित्पापाः प्रपच्यंते तीव्रेण करिषाग्निना ।\nक्वचित्सिंहैर्वृकैर्व्याघ्रैर्दंशैः कीटैश्च दारुणैः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000398002, "chapter_id": 20398, "verse_number": "२-७०-३", "content_sanskrit": "क्वचिन्महाजलौकोभिः क्वचिदाजगरैः पुनः ।\nमक्षिकाभिश्च रौद्राभिः क्वचित्सर्पैर्विषोल्बणैः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000398003, "chapter_id": 20398, "verse_number": "२-७०-४", "content_sanskrit": "मत्तमातंगयूथैश्च बलोत्कृष्टैः प्रमाथिभिः ।\nपंथानमुल्लिखद्भिश्च तीक्ष्णशृंगमहावृषैः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000398004, "chapter_id": 20398, "verse_number": "२-७०-५", "content_sanskrit": "महाशृंगैश्च महिषैर्दुष्टगात्रप्रबाधकैः ।\nडाकिनीभिश्च रौद्राभिर्विकरालैश्च राक्षसैः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000398005, "chapter_id": 20398, "verse_number": "२-७०-६", "content_sanskrit": "व्याधिभिश्च महाघोरैः पीड्यमाना व्रजंति ते ।\nमहातुलां समारूढा दह्यमाना दवानले॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000398006, "chapter_id": 20398, "verse_number": "२-७०-७", "content_sanskrit": "महावेगप्रधूतास्ते महाचंडेन वायुना ।\nमहापाषाणवर्षेण भिद्यमानाश्च सर्वतः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000398007, "chapter_id": 20398, "verse_number": "२-७०-८", "content_sanskrit": "पतद्भिर्वज्रनिर्घोषैरुल्कापातैश्च दारुणैः ।\nप्रदीप्तांगारवर्षेण हन्यमाना व्रजंति ते॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000398008, "chapter_id": 20398, "verse_number": "२-७०-९", "content_sanskrit": "महता पांसुवर्षेण पूर्यमाणा यमं गताः ।\nये नराः पापकर्माणः पापं भुंजंति दारुणम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000398009, "chapter_id": 20398, "verse_number": "२-७०-१०", "content_sanskrit": "एवं पापविशेषेण पापिष्ठाः पापकारकाः ।\nनरकं प्रतिभुंजंति बहुपीडासमाकुलम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000398010, "chapter_id": 20398, "verse_number": "२-७०-११", "content_sanskrit": "एतत्ते सर्वमाख्यातं विवेकं पुण्यपापयोः ।\nअन्यत्किं ते प्रवक्ष्यामि धर्मशास्त्रमनुत्तमम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}]