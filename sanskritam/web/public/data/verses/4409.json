[{"id": 2157272, "chapter_id": 4409, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2157273, "chapter_id": 4409, "verse_number": "१", "content_sanskrit": "बहूनि सुविचित्राणि द्वन्द्वयुद्धानि सञ्जय ।\nत्वयोक्तानि निशम्याहं स्पृहयामि सचक्षुताम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2157274, "chapter_id": 4409, "verse_number": "२", "content_sanskrit": "नहि देवासुरं युद्धमीदृग्रूपं भवेदिति ।\nचिन्तयामि च युद्धानि श्रुत्वा घोराणि सञ्जय\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2157275, "chapter_id": 4409, "verse_number": "३", "content_sanskrit": "आश्चर्यभूतं लोकेऽस्मिन् कथयिष्यन्ति मानवाः ।\nकुरूणां पाण्डवानां च युद्धं देवासुरोपमम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2157276, "chapter_id": 4409, "verse_number": "४", "content_sanskrit": "नहि मे तृप्तिरस्तीह शृण्वतो युद्धमुत्तमम् ।\nतस्मादार्तायनेर्युद्धं सौभद्रस्य च शंस मे\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2157277, "chapter_id": 4409, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2157278, "chapter_id": 4409, "verse_number": "५", "content_sanskrit": "सादितं प्रेक्ष्य यन्तारं शल्यः सर्वायसीं गदाम् ।\nसमुत्क्षिप्य नदन् क्रुद्धः प्रचस्कन्द रथोत्तमात्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2157279, "chapter_id": 4409, "verse_number": "६", "content_sanskrit": "सौभद्रोऽप्यशनिप्रख्यामादाय स्वरथाद् गदाम् ।\nएह्येहीत्यब्रवीच्छल्यं यत्नाद् भीमेन वारितः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2157280, "chapter_id": 4409, "verse_number": "७", "content_sanskrit": "वारयित्वा तु सौभद्रं भीमसेनः प्रतापवान् ।\nशल्यमासाद्य समरे तस्थौ मेरुरिवाचलः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2157281, "chapter_id": 4409, "verse_number": "८", "content_sanskrit": "तथैव मद्रराजोऽपि भीमं दृष्ट्वा महागदम् ।\nससाराभिमुखस्तूर्णं शार्दूल इव कुञ्जरम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2157282, "chapter_id": 4409, "verse_number": "९", "content_sanskrit": "तं दीप्तमिव कालाग्निं दण्डहस्तमिवान्तकम् ।\nजवेनाभ्यपतद् भीमः प्रगृह्य महतीं गदाम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2157283, "chapter_id": 4409, "verse_number": "१०", "content_sanskrit": "ततस्तूर्यनिनादश्च शङ्खानां च सहस्रशः ।\nसिंहनादश्च सञ्जज्ञे भेरीणां च महास्वनः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2157284, "chapter_id": 4409, "verse_number": "११", "content_sanskrit": "पश्यतां शतशो ह्यासीद् अन्योन्यगतचेतसाम् ।\nपाण्डवानां कुरूणां च साधु साध्विति निस्वनः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2157285, "chapter_id": 4409, "verse_number": "१२", "content_sanskrit": "नहि मद्राधिपादन्यः सर्वराजसु भारत ।\nसोढुमुत्सहते वेगं भीमसेनस्य संयुगे\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2157286, "chapter_id": 4409, "verse_number": "१३", "content_sanskrit": "तथा मद्राधिपस्यापि गदावेगं महात्मनः ।\nसोढुमुत्सहते लोके युधि कोऽन्यो वृकोदरात्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2157287, "chapter_id": 4409, "verse_number": "१४", "content_sanskrit": "पट्टैर्जाम्बूनदैर्बद्धा बभूव जनभीषणी ।\nप्रजज्वाल तदा विद्धा भीमेन महती गदा\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2157288, "chapter_id": 4409, "verse_number": "१५", "content_sanskrit": "साग्निदीप्ता महारौद्रा गदा सा शुशुभे तदा ।\nतथैव चरतो मार्गान् मण्डलानि च भागशः\nमहाविद्युत्प्रतीकाशा शल्यस्य शुशुभे गदा\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2157289, "chapter_id": 4409, "verse_number": "१६", "content_sanskrit": "तौ वृषाविव नर्दन्तौ मण्डलानि विचेरतुः ।\nआवर्तितगदाहस्तावुभौ शल्यवृकोदरौ\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2157290, "chapter_id": 4409, "verse_number": "१७", "content_sanskrit": "कोपताम्रेक्षणौ वीरौ शत्रुसङ्घविमर्दनौ ।\nमहामात्रौ महोत्साहौ गदायुद्धविशारदौ\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2157291, "chapter_id": 4409, "verse_number": "१८", "content_sanskrit": "मण्डलावर्तवेगेषु गदाप्रहरणेषु च ।\nनिर्विशेषमभूद् युद्धं तयोः पुरुषसिंहयोः ।\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2157292, "chapter_id": 4409, "verse_number": "१९", "content_sanskrit": "ताडिता भीमसेनेन शल्यस्य महती गदा ।\nसाग्निज्वाला महारौद्रा तदा तूर्णमशीर्यत\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2157293, "chapter_id": 4409, "verse_number": "२०", "content_sanskrit": "तथैव भीमसेनस्य द्विषताऽभिहता गदा ।\nवर्षाप्रदोषे खद्योतैः वृतो वृक्ष इवाबभौ\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2157294, "chapter_id": 4409, "verse_number": "२१", "content_sanskrit": "गदा क्षिप्ता तु समरे मद्रराजेन धीमता ।\nआकाशं दीपयन्ती सा पावकं चासृजद् बहु\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2157295, "chapter_id": 4409, "verse_number": "२२", "content_sanskrit": "तथैव भीमसेनेन प्रेषिता शत्रुघातिना ।\nभीमरूपा महावेगा गदा शल्यं रणेऽतुदत्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2157296, "chapter_id": 4409, "verse_number": "२३", "content_sanskrit": "त्रासयामास तत् सैन्यं महावेगोग्रदर्शना \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2157297, "chapter_id": 4409, "verse_number": "२४", "content_sanskrit": "ते चैवोभे गदे श्रेष्ठे समासाद्य परस्परम् ।\nतथा विसृजतां वह्निं नागकन्ये इवोज्ज्वले ।\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2157298, "chapter_id": 4409, "verse_number": "२५", "content_sanskrit": "पुनः शल्येन भीमस्य गदाग्राद् गदया हतात् ।\nसङ्घर्षणादुत्थितोऽग्निः दीपयामास मेदिनीम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2157299, "chapter_id": 4409, "verse_number": "२६", "content_sanskrit": "पुनश्च भीमसेनेन शल्यस्य महती गदा ।\nताडिता सहसा राजन् विससर्जाथ पावकम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2157300, "chapter_id": 4409, "verse_number": "२७", "content_sanskrit": "नखैरिव महाव्याघ्रौ दन्तैरिव महागजौ ।\nतौ विचेरतुरासाद्य गदाग्राभ्यां परस्परम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2157301, "chapter_id": 4409, "verse_number": "२८", "content_sanskrit": "तौ गदाग्राहतैर्गात्रैः क्षणेन रुधिरोक्षितौ ।\nददृशाते महात्मानौ किंशुकाविव पुष्पितौ\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2157302, "chapter_id": 4409, "verse_number": "२९", "content_sanskrit": "शुश्रुवुर्दिक्षु सर्वासु तयोः पुरुषसिंहयोः ।\nगदासङ्घातसंह्रादाः शक्राशनिरवा इव\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2157303, "chapter_id": 4409, "verse_number": "३०", "content_sanskrit": "गदया मद्रराजेन सव्यदक्षिणमाहतः ।\nन स स्म विव्यथे भीमो भिद्यमान इवाचलः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2157304, "chapter_id": 4409, "verse_number": "३१", "content_sanskrit": "तथा भीमगदावेगैः ताड्यमानो महाबलः ।\nधैर्यान्मद्राधिपस्तस्थौ वज्रैर्गिरिरिवाहतः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2157305, "chapter_id": 4409, "verse_number": "३२", "content_sanskrit": "आपेततुर्महामार्गात् समुच्छ्रितमहागदौ ।\nपुनरावृत्तमार्गस्थौ मण्डलानि विचेरतुः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2157306, "chapter_id": 4409, "verse_number": "३३", "content_sanskrit": "अथाप्लुत्य पदान्यष्टौ सन्निपत्य गजाविव ।\nसहसा लोहदण्डाभ्यामन्योन्यमभिजघ्नतुः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2157307, "chapter_id": 4409, "verse_number": "३४", "content_sanskrit": "तौ परस्परवेगाच्च गदाभ्यां च दृढाहतौ ।\nयुगपत् पेततुर्वीरौ क्षिताविन्द्रध्वजाविव\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2157308, "chapter_id": 4409, "verse_number": "३५", "content_sanskrit": "तथा विह्वलगात्रं तं निःश्वसन्तं पुनःपुनः ।\nशल्यमभ्यपतत् तूर्णं कृतवर्मा महारथः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2157309, "chapter_id": 4409, "verse_number": "३६", "content_sanskrit": "दृष्ट्वा चैनं मद्रराजं गदयाऽभिनिपीडितम् ।\nवेष्टमानं महाराज मूर्च्छयाऽभिपरिप्लुतम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2157310, "chapter_id": 4409, "verse_number": "३७", "content_sanskrit": "ततः स निजमारोप्य मद्राणामधिपं रथम् ।\nअपोवाह रणाद् राजन् तूर्णमायोधनाद् बहिः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2157311, "chapter_id": 4409, "verse_number": "३८", "content_sanskrit": "भूमौ निपतितो वीरो निमेषात् पुनरुत्थितः ।\nभीमसेनो महाबाहुर्गदापाणिरदृश्यत\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2157312, "chapter_id": 4409, "verse_number": "३९", "content_sanskrit": "ततो मद्राधिपं दृष्ट्वा धार्तराष्ट्राः पराङ्मुखम् ।\nसनागरथपत्त्यश्वाः समकम्पन्त मारिष\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2157313, "chapter_id": 4409, "verse_number": "४०", "content_sanskrit": "ते पाण्डवैरर्द्यमानाः तावका जितकाशिभिः ।\nभीता दिशो व्यकीर्यन्त वायुनुन्ना यथा घनाः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2157314, "chapter_id": 4409, "verse_number": "४१", "content_sanskrit": "निर्जित्य धार्तराष्ट्रांस्ते पाण्डवेया महारथाः ।\nव्यरोचन्त रणे राजन् दीप्यमाना इवाग्नयः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2157315, "chapter_id": 4409, "verse_number": "४२", "content_sanskrit": "अथ मड्डुकभेरिमहामुरजाः\nपणवानकदुन्दुभिझर्झरिभिः ।\nविनदन्ति भृशं सह शङ्खरवैः\nविविधैश्च नरोत्तम सिंहरवैः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2157316, "chapter_id": 4409, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nद्रोणपर्वणि चतुर्दशोऽध्यायः ॥ १४ ॥\nद्रोणाभिषेकपर्वणि चतुर्दशोऽध्यायः ॥ १४ ॥\n– – ० – –", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]