[{"id": 2087846, "chapter_id": 2870, "verse_number": "१२-३७५-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2087847, "chapter_id": 2870, "verse_number": "१२-३७५-१", "content_sanskrit": "स चामन्त्र्योरगश्रेष्ठं ब्राह्मणः कृतनिश्चयः।\nदीक्षाकाङ्क्षी तदा राजंश्च्यवनं भार्गवं श्रितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2087848, "chapter_id": 2870, "verse_number": "१२-३७५-२", "content_sanskrit": "स तेन कृतसत्कारो धर्ममेवाधितस्थिवान्।\nतथैव च कथामेतां राजन्कथितवांस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2087849, "chapter_id": 2870, "verse_number": "१२-३७५-३", "content_sanskrit": "भार्गवेणापि राजेन्द्र जनकस्य निवेशने।\nकथैषा कथिता पुण्या नारदाय महात्मने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2087850, "chapter_id": 2870, "verse_number": "१२-३७५-४", "content_sanskrit": "नारदेनापि राजेन्द्र देवेन्द्रस्य निवेशने।\nकथिता भरतश्रेष्ठ पृष्टेनाक्लिष्टकर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2087851, "chapter_id": 2870, "verse_number": "१२-३७५-५", "content_sanskrit": "देवराजेन च पुरा कथितैषा कथा शुभा।\nसमस्तेभ्यः प्रशस्तेभ्यो विप्रेभ्यो वसुधाधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2087852, "chapter_id": 2870, "verse_number": "१२-३७५-६", "content_sanskrit": "यदा च मम रामेण युद्धमासीत्सुदारुणम्।\nवसुभिश्च तदा राजन्कथेयं कथिता मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2087853, "chapter_id": 2870, "verse_number": "१२-३७५-७", "content_sanskrit": "पृच्छमानाय तत्त्वेन मया चैवोत्तमा तव।\nकथेयं कथिता पुण्या धर्म्या धर्मभृतांवर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2087854, "chapter_id": 2870, "verse_number": "१२-३७५-८", "content_sanskrit": "तदेव परमो धर्मो यन्मां पृच्छसि भारत।\nआसीद्धीरो ह्यनाकाङ्क्षी धर्मार्थकरणे नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2087855, "chapter_id": 2870, "verse_number": "१२-३७५-९", "content_sanskrit": "स च किल कृतनिश्चयो द्विजो\nभुजगपतिप्रतिदशितात्मकृत्यः।\nयमनियमसहो वनान्तरं\nपरिगणितोञ्छशिलाशनः प्रविष्टः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2087856, "chapter_id": 2870, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसाहस्रिकायां संहितायां वैयासिक्यां शान्तिपर्वणि मोक्षधर्मपर्वणि उञ्छवृत्त्युपाख्याने पञ्चसप्तत्यधिकत्रिशततमोऽध्यायः॥ ३७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}]