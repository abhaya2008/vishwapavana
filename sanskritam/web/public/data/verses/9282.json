[{"id": 5000282000, "chapter_id": 9282, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे किष्किन्धाकाण्डे दशमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000282001, "chapter_id": 9282, "verse_number": "४-१०-१", "content_sanskrit": "ततः क्रोधसमाविष्टं संरब्धं तमुपागतम्।\nअहं प्रसादयांचक्रे भ्रातरं हितकाम्यया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000282002, "chapter_id": 9282, "verse_number": "४-१०-२", "content_sanskrit": "दिष्ट्यासि कुशली प्राप्तो निहतश्च त्वया रिपुः।\nअनाथस्य हि मे नाथस्त्वमेकोऽनाथनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000282003, "chapter_id": 9282, "verse_number": "४-१०-३", "content_sanskrit": "इदं बहुशलाकं ते पूर्णचन्द्रमिवोदितम्।\nछत्रं सवालव्यजनं प्रतीच्छस्व मया धृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000282004, "chapter_id": 9282, "verse_number": "४-१०-४", "content_sanskrit": "आर्तस्तत्र बिलद्वारि स्थितः संवत्सरं नृप।\nदृष्ट्वा च शोणितं द्वारि बिलाच्चापि समुत्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000282005, "chapter_id": 9282, "verse_number": "४-१०-५", "content_sanskrit": "शोकसंविग्नहृदयो भृशं व्याकुलितेन्द्रियः।\nअपिधाय बिलद्वारं शैलशृङ्गेण तत् तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000282006, "chapter_id": 9282, "verse_number": "४-१०-६", "content_sanskrit": "तस्माद् देशादपाक्रम्य किष्किन्धां प्राविशं पुनः।\nविषादात्त्विह मां दृष्ट्वा पौरैर्मन्त्रिभिरेव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000282007, "chapter_id": 9282, "verse_number": "४-१०-७", "content_sanskrit": "अभिषिक्तो न कामेन तन्मे क्षन्तुं त्वमर्हसि।\nत्वमेव राजा मानार्हः सदा चाहं यथा पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000282008, "chapter_id": 9282, "verse_number": "४-१०-८", "content_sanskrit": "राजभावे नियोगोऽयं मम त्वद्विरहात् कृतः।\nसामात्यपौरनगरं स्थितं निहतकण्टकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000282009, "chapter_id": 9282, "verse_number": "४-१०-९", "content_sanskrit": "न्यासभूतमिदं राज्यं तव निर्यातयाम्यहम्।\nमा च रोषं कृथाः सौम्य मम शत्रुनिषूदन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000282010, "chapter_id": 9282, "verse_number": "४-१०-१०", "content_sanskrit": "याचे त्वां शिरसा राजन् मया बद्धोऽयमञ्जलिः।\nबलादस्मिन् समागम्य मन्त्रिभिः पुरवासिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000282011, "chapter_id": 9282, "verse_number": "४-१०-११", "content_sanskrit": "राजभावे नियुक्तोऽहं शून्यदेशजिगीषया।\nस्निग्धमेवं ब्रुवाणं मां स विनिर्भर्त्स्य वानरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000282012, "chapter_id": 9282, "verse_number": "४-१०-१२", "content_sanskrit": "धिक्त्वामिति च मामुक्त्वा बहु तत्तदुवाच ह।\nप्रकृतीश्च समानीय मन्त्रिणश्चैव सम्मतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000282013, "chapter_id": 9282, "verse_number": "४-१०-१३", "content_sanskrit": "मामाह सुहृदां मध्ये वाक्यं परमगर्हितम्।\nविदितं वो मया रात्रौ मायावी स महासुरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000282014, "chapter_id": 9282, "verse_number": "४-१०-१४", "content_sanskrit": "मां समाह्वयत क्रुद्धो युद्धाकांक्षी तदा पुरा।\nतस्य तद् भाषितं श्रुत्वा निःसृतोऽहं नृपालयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000282015, "chapter_id": 9282, "verse_number": "४-१०-१५", "content_sanskrit": "अनुयातश्च मां तूर्णमयं भ्राता सुदारुणः।\nस तु दृष्ट्वैव मां रात्रौ सद्वितीयं महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000282016, "chapter_id": 9282, "verse_number": "४-१०-१६", "content_sanskrit": "प्राद्रवद् भयसंत्रस्तो वीक्ष्यावां समुपागतौ।\nअभिद्रुतस्तु वेगेन विवेश स महाबिलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000282017, "chapter_id": 9282, "verse_number": "४-१०-१७", "content_sanskrit": "तं प्रविष्टं विदित्वा तु सुघोरं सुमहद‍‍्बिलम्।\nअयमुक्तोऽथ मे भ्राता मया तु क्रूरदर्शनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000282018, "chapter_id": 9282, "verse_number": "४-१०-१८", "content_sanskrit": "अहत्वा नास्ति मे शक्तिः प्रतिगन्तुमितः पुरीम्।\nबिलद्वारि प्रतीक्ष त्वं यावदेनं निहन्म्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000282019, "chapter_id": 9282, "verse_number": "४-१०-१९", "content_sanskrit": "स्थितोऽयमिति मत्वाहं प्रविष्टस्तु दुरासदम्।\nतं मे मार्गयतस्तत्र गतः संवत्सरस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000282020, "chapter_id": 9282, "verse_number": "४-१०-२०", "content_sanskrit": "स तु दृष्टो मया शत्रुरनिर्वेदाद् भयावहः।\nनिहतश्च मया सद्यः स सर्वैः सह बन्धुभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000282021, "chapter_id": 9282, "verse_number": "४-१०-२१", "content_sanskrit": "तस्यास्यात्तु प्रवृत्तेन रुधिरौघेण तद‍‍्बिलम्।\nपूर्णमासीद् दुराक्रामं स्तनतस्तस्य भूतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000282022, "chapter_id": 9282, "verse_number": "४-१०-२२", "content_sanskrit": "सूदयित्वा तु तं शत्रुं विक्रान्तं तमहं सुखम्।\nनिष्क्रामं नैव पश्यामि बिलस्य पिहितं मुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000282023, "chapter_id": 9282, "verse_number": "४-१०-२३", "content_sanskrit": "विक्रोशमानस्य तु मे सुग्रीवेति पुनः पुनः।\nयतः प्रतिवचो नास्ति ततोऽहं भृशदुःखितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000282024, "chapter_id": 9282, "verse_number": "४-१०-२४", "content_sanskrit": "पादप्रहारैस्तु मया बहुभिः परिपातितम्।\nततोऽहं तेन निष्क्रम्य पथा पुरमुपागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000282025, "chapter_id": 9282, "verse_number": "४-१०-२५", "content_sanskrit": "तत्रानेनास्मि संरुद्धो राज्यं मृगयताऽऽत्मनः।\nसुग्रीवेण नृशंसेन विस्मृत्य भ्रातृसौहृदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000282026, "chapter_id": 9282, "verse_number": "४-१०-२६", "content_sanskrit": "एवमुक्त्वा तु मां तत्र वस्त्रेणैकेन वानरः।\nतदा निर्वासयामास वाली विगतसाध्वसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000282027, "chapter_id": 9282, "verse_number": "४-१०-२७", "content_sanskrit": "तेनाहमपविद्धश्च हृतदारश्च राघव।\nतद्भयाच्च महीं सर्वां क्रान्तवान् सवनार्णवाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000282028, "chapter_id": 9282, "verse_number": "४-१०-२८", "content_sanskrit": "ऋष्यमूकं गिरिवरं भार्याहरणदुःखितः।\nप्रविष्टोऽस्मि दुराधर्षं वालिनः कारणान्तरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000282029, "chapter_id": 9282, "verse_number": "४-१०-२९", "content_sanskrit": "एतत्ते सर्वमाख्यातं वैरानुकथनं महत्।\nअनागसा मया प्राप्तं व्यसनं पश्य राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000282030, "chapter_id": 9282, "verse_number": "४-१०-३०", "content_sanskrit": "वालिनश्च भयात् तस्य सर्वलोकभयापह।\nकर्तुमर्हसि मे वीर प्रसादं तस्य निग्रहात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000282031, "chapter_id": 9282, "verse_number": "४-१०-३१", "content_sanskrit": "एवमुक्तः स तेजस्वी धर्मज्ञो धर्मसंहितम्।\nवचनं वक्तुमारेभे सुग्रीवं प्रहसन्निव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000282032, "chapter_id": 9282, "verse_number": "४-१०-३२", "content_sanskrit": "अमोघाः सूर्यसंकाशा निशिता मे शरा इमे।\nतस्मिन् वालिनि दुर्वृत्ते पतिष्यन्ति रुषान्विताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000282033, "chapter_id": 9282, "verse_number": "४-१०-३३", "content_sanskrit": "यावत् तं नहि पश्येयं तव भार्यापहारिणम्।\nतावत् स जीवेत् पापात्मा वाली चारित्रदूषकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000282034, "chapter_id": 9282, "verse_number": "४-१०-३४", "content_sanskrit": "आत्मानुमानात् पश्यामि मग्नस्त्वं शोकसागरे।\nत्वामहं तारयिष्यामि बाढं प्राप्स्यसि पुष्कलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000282035, "chapter_id": 9282, "verse_number": "४-१०-३५", "content_sanskrit": "तस्य तद् वचनं श्रुत्वा हर्षपौरुषवर्धनम्।\nसुग्रीवः परमप्रीतः सुमहद्वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000282036, "chapter_id": 9282, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे दशमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]