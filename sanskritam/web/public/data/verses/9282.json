[{"id": 40018301, "chapter_id": 9282, "verse_number": "1", "content_sanskrit": "स प्रविश्यसभांराजादीनःपरमदुःखितः । निषपादासनेमुख्येसिंहःक्रुद्धइवश्वसन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40018302, "chapter_id": 9282, "verse_number": "2", "content_sanskrit": "अब्रवीच्च स तान्सर्वान् बलमुख्यान् महाबलः । रावणःप्राञ्जलिर्वाक्यंपुत्रव्यसनकर्शितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40018303, "chapter_id": 9282, "verse_number": "3", "content_sanskrit": "सर्वेभवन्तस्सर्वेणहस्त्यश्वेनसमावृताः । निर्यान्तुरथसङ्घैश्चपादातैश्चोपशोभिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40018304, "chapter_id": 9282, "verse_number": "4", "content_sanskrit": "एकंरामंपरिक्षिप्यसमरेहन्तुमर्हथ । वर्षन्तश्शरवर्षाणिप्रावृट् कालइवाम्बुदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40018305, "chapter_id": 9282, "verse_number": "5", "content_sanskrit": "अथवाहंशरैस्तीक्ष्णैर्भिन्नगात्रंमहाहवे । भवद्भिःश्वोनिहन्तास्मिरामंलोकस्यपश्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40018306, "chapter_id": 9282, "verse_number": "6", "content_sanskrit": "इत्येतद्वाक्यमादायरक्षसेन्द्रस्यराक्षसाः । निर्ययुस्तेरथैःशीघ्रैर्नानानीकैश्चसंयुताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40018307, "chapter_id": 9282, "verse_number": "7", "content_sanskrit": "परिघान् पट्टसांश्चैवशरखङ्गपरश्वधान् । शरीरान्तकरान् सर्वेचिक्षिपुर्वानरान् प्रति ॥ वानराश्चद्रुमान्शैलान्राक्षसान्प्रतिचिक्षिपुः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40018308, "chapter_id": 9282, "verse_number": "8", "content_sanskrit": "स सङ्ग्रामोमहाभीमस्सूर्यस्यदयनंप्रति ॥ रक्षसांवानराणां च तुमुलस्समपद्यत ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40018309, "chapter_id": 9282, "verse_number": "9", "content_sanskrit": "तेगदाभिश्चचित्राभिःप्रासैःखडगैःपरश्वधैः ॥ अन्योन्यंसमरेजघ्नुस्तदावानरराक्षसाः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40018310, "chapter_id": 9282, "verse_number": "10", "content_sanskrit": "एवंप्रवृत्तेसङ्ग्रामेह्यद्भुतंसुमहद्रजः ॥ रक्षसांवानराणां च शान्तंशोणितविस्रवैः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40018311, "chapter_id": 9282, "verse_number": "11", "content_sanskrit": "मातङ्गरथकूलाश्चवाजिमत्सास्यध्वजद्रुमाः ॥ शरीरसङ्घाटवहाःप्रसस्रुःशोणितापगाः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40018312, "chapter_id": 9282, "verse_number": "12", "content_sanskrit": "ततस्तेवानराःसर्वेशोणितौघपरिप्लुताः ॥ ध्वजवर्मरथानश्वान्नानाप्रहरणानि च । आप्लुत्याप्लुत्यसमरेवानरेन्द्राबभञ्चिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40018313, "chapter_id": 9282, "verse_number": "13", "content_sanskrit": "ततस्तेवानराःसर्वेशोणितौघपरिप्लुताः ॥ ध्वजवर्मरथानश्वान्नानाप्रहरणानि च । आप्लुत्याप्लुत्यसमरेवानरेन्द्राबभञ्चिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40018314, "chapter_id": 9282, "verse_number": "14", "content_sanskrit": "केशान् कर्णललाटं च नासिकाश्चप्लवङ्गमाः । रक्षसांदशनैस्तीक्ष्णैर्नखैश्चापिव्यकर्तयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40018315, "chapter_id": 9282, "verse_number": "15", "content_sanskrit": "एकैकंराक्षसंसङ्ख्येशतंवानरपुङ्गवाः । अभ्यधावन्तफलिनंवृक्षंशकुनयोयथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40018316, "chapter_id": 9282, "verse_number": "16", "content_sanskrit": "तदागदाभिर्गुर्वीभिःप्रासैःखडगैःपरश्वधैः । निर्जघ्नुर्वानरान्घोरान्राक्षसाःपर्वतोपमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40018317, "chapter_id": 9282, "verse_number": "17", "content_sanskrit": "राक्षसैर्वध्यमानानांवानराणांमहाचमूः । शरण्यंशरणंयातारामंदशरथात्मजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40018318, "chapter_id": 9282, "verse_number": "18", "content_sanskrit": "ततोरामोमहातेजाधनुरादायवीर्यवान् । प्रविश्यराक्षसंसैन्यंशरवर्षंववर्ष ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40018319, "chapter_id": 9282, "verse_number": "19", "content_sanskrit": "प्रविष्टंतुतदारामंमेघास्सूर्यमिवाम्बरे । नाथिजग्मुर्महाघोरानिर्दहन्तंशराग्निना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40018320, "chapter_id": 9282, "verse_number": "20", "content_sanskrit": "कृतान्येवसुघोराणिरामेणरजनीचराः । ददृशुस्ते न वैरामंकर्माण्यसुकराणिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40018321, "chapter_id": 9282, "verse_number": "21", "content_sanskrit": "चालयन्तंमहासैन्यंविधमन्तंमहारथान् । ददृशुस्ते न वैरामंवातंवनगतंयथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40018322, "chapter_id": 9282, "verse_number": "22", "content_sanskrit": "छिन्नंभिन्नंशरैर्दग्धंप्रभन्नंशस्त्रपीडितम् । बलंरामेणददृशुर्नरामंशीघ्रकारिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40018323, "chapter_id": 9282, "verse_number": "23", "content_sanskrit": "प्रहरन्तंशरीरेषु न तेपश्यन्तिराघवम् । इन्द्रियार्थेषुतिष्ठन्तंभूतात्मानमिवप्रजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40018324, "chapter_id": 9282, "verse_number": "24", "content_sanskrit": "एषहन्तिगजानीकमेषहन्तिमहारथान् । एषहन्तिशरैस्तीक्ष्णैःपदातीस्वाजिभिःसह ॥ इतितेराक्षसास्सर्वेरामस्यसदृशान्रणे । अन्योन्यंकुपिताजघ्नुस्सादृश्याद्राघवस्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40018325, "chapter_id": 9282, "verse_number": "25", "content_sanskrit": "एषहन्तिगजानीकमेषहन्तिमहारथान् । एषहन्तिशरैस्तीक्ष्णैःपदातीस्वाजिभिःसह ॥ इतितेराक्षसास्सर्वेरामस्यसदृशान्रणे । अन्योन्यंकुपिताजघ्नुस्सादृश्याद्राघवस्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40018326, "chapter_id": 9282, "verse_number": "26", "content_sanskrit": "न तेददृशिरेरामंदहन्तमपिवाहिनीम् । मोहिताःपरमास्त्रणगान्धर्वेणमहात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40018327, "chapter_id": 9282, "verse_number": "27", "content_sanskrit": "तेतुरामसहस्राणिरणेपश्यन्तिराक्षसाः । पुनःपश्यन्तिकाकुत्स्थमेकमेवमहाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40018328, "chapter_id": 9282, "verse_number": "28", "content_sanskrit": "भ्रमन्तीकाञ्चनींकोटिंकार्मुकस्यमहात्मनः । अलातचक्रप्रतिमांददृशुस्ते न राघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40018329, "chapter_id": 9282, "verse_number": "29", "content_sanskrit": "शरीरनाभिसत्त्वार्चिश्शरारंनेमिकार्मुकम् । ज्याघोषतलनिर्घोषंतेजोबुधदिगुणप्रभम् ॥ दिव्यास्त्रगुणपर्यन्तंनिघ्नन्तंयुधिराक्षसान् । ददृशूरामचक्रंतत्कालचक्रमिवप्रजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40018330, "chapter_id": 9282, "verse_number": "30", "content_sanskrit": "शरीरनाभिसत्त्वार्चिश्शरारंनेमिकार्मुकम् । ज्याघोषतलनिर्घोषंतेजोबुधदिगुणप्रभम् ॥ दिव्यास्त्रगुणपर्यन्तंनिघ्नन्तंयुधिराक्षसान् । ददृशूरामचक्रंतत्कालचक्रमिवप्रजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40018331, "chapter_id": 9282, "verse_number": "31", "content_sanskrit": "अनीकंदशसाहस्रंरथानांवातरम्हसाम् । अष्टादशसहस्राणिकुञ्जराणांतरस्विनाम् ॥ चतुर्दशसहस्राणिसारोहाणां च वाजिनाम् । पूर्णेशतसहस्रेद्वेराक्षसानांपदातिनाम् ॥ दिवसस्याष्टभागेनशरैरग्निशिखोपमैः । हतात्यान्येकेनरामेणरक्षसांकामरूपिणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40018332, "chapter_id": 9282, "verse_number": "32", "content_sanskrit": "अनीकंदशसाहस्रंरथानांवातरम्हसाम् । अष्टादशसहस्राणिकुञ्जराणांतरस्विनाम् ॥ चतुर्दशसहस्राणिसारोहाणां च वाजिनाम् । पूर्णेशतसहस्रेद्वेराक्षसानांपदातिनाम् ॥ दिवसस्याष्टभागेनशरैरग्निशिखोपमैः । हतात्यान्येकेनरामेणरक्षसांकामरूपिणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40018333, "chapter_id": 9282, "verse_number": "33", "content_sanskrit": "अनीकंदशसाहस्रंरथानांवातरम्हसाम् । अष्टादशसहस्राणिकुञ्जराणांतरस्विनाम् ॥ चतुर्दशसहस्राणिसारोहाणां च वाजिनाम् । पूर्णेशतसहस्रेद्वेराक्षसानांपदातिनाम् ॥ दिवसस्याष्टभागेनशरैरग्निशिखोपमैः । हतात्यान्येकेनरामेणरक्षसांकामरूपिणाम् ॥", "padacche