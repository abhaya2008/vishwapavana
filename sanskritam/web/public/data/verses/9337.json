[{"id": 5000337000, "chapter_id": 9337, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे किष्किन्धाकाण्डे पञ्चषष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000337001, "chapter_id": 9337, "verse_number": "४-६५-१", "content_sanskrit": "अथाङ्गदवचः श्रुत्वा ते सर्वे वानरर्षभाः।\nस्वं स्वं गतौ समुत्साहमूचुस्तत्र यथाक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000337002, "chapter_id": 9337, "verse_number": "४-६५-२", "content_sanskrit": "गजो गवाक्षो गवयः शरभो गन्धमादनः।\nमैन्दश्च द्विविदश्चैव सुषेणो जाम्बवांस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000337003, "chapter_id": 9337, "verse_number": "४-६५-३", "content_sanskrit": "आबभाषे गजस्तत्र प्लवेयं दशयोजनम्।\nगवाक्षो योजनान्याह गमिष्यामीति विंशतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000337004, "chapter_id": 9337, "verse_number": "४-६५-४", "content_sanskrit": "शरभो वानरस्तत्र वानरांस्तानुवाच ह।\nत्रिंशतं तु गमिष्यामि योजनानां प्लवङ्गमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000337005, "chapter_id": 9337, "verse_number": "४-६५-५", "content_sanskrit": "ऋषभो वानरस्तत्र वानरांस्तानुवाच ह।\nचत्वारिंशद् गमिष्यामि योजनानां न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000337006, "chapter_id": 9337, "verse_number": "४-६५-६", "content_sanskrit": "वानरांस्तु महातेजा अब्रवीद् गन्धमादनः।\nयोजनानां गमिष्यामि पञ्चाशत्तु न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000337007, "chapter_id": 9337, "verse_number": "४-६५-७", "content_sanskrit": "मैन्दस्तु वानरस्तत्र वानरांस्तानुवाच ह।\nयोजनानां परं षष्टिमहं प्लवितुमुत्सहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000337008, "chapter_id": 9337, "verse_number": "४-६५-८", "content_sanskrit": "ततस्तत्र महातेजा द्विविदः प्रत्यभाषत।\nगमिष्यामि न संदेहः सप्ततिं योजनान्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000337009, "chapter_id": 9337, "verse_number": "४-६५-९", "content_sanskrit": "सुषेणस्तु महातेजाः सत्त्ववान् कपिसत्तमः।\nअशीतिं प्रतिजानेऽहं योजनानां पराक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000337010, "chapter_id": 9337, "verse_number": "४-६५-१०", "content_sanskrit": "तेषां कथयतां तत्र सर्वांस्ताननुमान्य च।\nततो वृद्धतमस्तेषां जाम्बवान् प्रत्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000337011, "chapter_id": 9337, "verse_number": "४-६५-११", "content_sanskrit": "पूर्वमस्माकमप्यासीत् कश्चिद् गतिपराक्रमः।\nते वयं वयसः पारमनुप्राप्ताः स्म साम्प्रतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000337012, "chapter_id": 9337, "verse_number": "४-६५-१२", "content_sanskrit": "किं तु नैवं गते शक्यमिदं कार्यमुपेक्षितुम्।\nयदर्थं कपिराजश्च रामश्च कृतनिश्चयौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000337013, "chapter_id": 9337, "verse_number": "४-६५-१३", "content_sanskrit": "साम्प्रतं कालमस्माकं या गतिस्तां निबोधत।\nनवतिं योजनानां तु गमिष्यामि न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000337014, "chapter_id": 9337, "verse_number": "४-६५-१४", "content_sanskrit": "तांश्च सर्वान् हरिश्रेष्ठाञ्जाम्बवानिदमब्रवीत्।\nन खल्वेतावदेवासीद् गमने मे पराक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000337015, "chapter_id": 9337, "verse_number": "४-६५-१५", "content_sanskrit": "मया वैरोचने यज्ञे प्रभविष्णुः सनातनः।\nप्रदक्षिणीकृतः पूर्वं क्रममाणस्त्रिविक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000337016, "chapter_id": 9337, "verse_number": "४-६५-१६", "content_sanskrit": "स इदानीमहं वृद्धः प्लवने मन्दविक्रमः।\nयौवने च तदासीन्मे बलमप्रतिमं परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000337017, "chapter_id": 9337, "verse_number": "४-६५-१७", "content_sanskrit": "सम्प्रत्येतावदेवाद्य शक्यं मे गमने स्वतः।\nनैतावता च संसिद्धिः कार्यस्यास्य भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000337018, "chapter_id": 9337, "verse_number": "४-६५-१८", "content_sanskrit": "अथोत्तरमुदारार्थमब्रवीदङ्गदस्तदा।\nअनुमान्य तदा प्राज्ञो जाम्बवन्तं महाकपिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000337019, "chapter_id": 9337, "verse_number": "४-६५-१९", "content_sanskrit": "अहमेतद् गमिष्यामि योजनानां शतं महत्।\nनिवर्तने तु मे शक्तिः स्यान्न वेति न निश्चितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000337020, "chapter_id": 9337, "verse_number": "४-६५-२०", "content_sanskrit": "तमुवाच हरिश्रेष्ठं जाम्बवान् वाक्यकोविदः।\nज्ञायते गमने शक्तिस्तव हर्यृक्षसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000337021, "chapter_id": 9337, "verse_number": "४-६५-२१", "content_sanskrit": "कामं शतसहस्रं वा नह्येष विधिरुच्यते।\nयोजनानां भवान् शक्तो गन्तुं प्रतिनिवर्तितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000337022, "chapter_id": 9337, "verse_number": "४-६५-२२", "content_sanskrit": "नहि प्रेषयिता तात स्वामी प्रेष्यः कथंचन।\nभवतायं जनः सर्वः प्रेष्यः प्लवगसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000337023, "chapter_id": 9337, "verse_number": "४-६५-२३", "content_sanskrit": "भवान् कलत्रमस्माकं स्वामिभावे व्यवस्थितः।\nस्वामी कलत्रं सैन्यस्य गतिरेषा परंतप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000337024, "chapter_id": 9337, "verse_number": "४-६५-२४", "content_sanskrit": "अपि वै तस्य कार्यस्य भवान् मूलमरिंदम।\nतस्मात् कलत्रवत् तात प्रतिपाल्यः सदा भवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000337025, "chapter_id": 9337, "verse_number": "४-६५-२५", "content_sanskrit": "मूलमर्थस्य संरक्ष्यमेष कार्यविदां नयः।\nमूले हि सति सिध्यन्ति गुणाः सर्वे फलोदयाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000337026, "chapter_id": 9337, "verse_number": "४-६५-२६", "content_sanskrit": "तद् भवानस्य कार्यस्य साधनं सत्यविक्रम।\nवुद्धिविक्रमसम्पन्नो हेतुरत्र परंतप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000337027, "chapter_id": 9337, "verse_number": "४-६५-२७", "content_sanskrit": "गुरुश्च गुरुपुत्रश्च त्वं हि नः कपिसत्तम।\nभवन्तमाश्रित्य वयं समर्था ह्यर्थसाधने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000337028, "chapter_id": 9337, "verse_number": "४-६५-२८", "content_sanskrit": "उक्तवाक्यं महाप्राज्ञं जाम्बवन्तं महाकपिः।\nप्रत्युवाचोत्तरं वाक्यं वालिसूनुरथाङ्गदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000337029, "chapter_id": 9337, "verse_number": "४-६५-२९", "content_sanskrit": "यदि नाहं गमिष्यामि नान्यो वानरपुङ्गवः।\nपुनः खल्विदमस्माभिः कार्यं प्रायोपवेशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000337030, "chapter_id": 9337, "verse_number": "४-६५-३०", "content_sanskrit": "नह्यकृत्वा हरिपतेः संदेशं तस्य धीमतः।\nतत्रापि गत्वा प्राणानां न पश्ये परिरक्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000337031, "chapter_id": 9337, "verse_number": "४-६५-३१", "content_sanskrit": "स हि प्रसादे चात्यर्थकोपे च हरिरीश्वरः।\nअतीत्य तस्य संदेशं विनाशो गमने भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000337032, "chapter_id": 9337, "verse_number": "४-६५-३२", "content_sanskrit": "तत्तथा ह्यस्य कार्यस्य न भवत्यन्यथा गतिः।\nतद् भवानेव दृष्टार्थः संचिन्तयितुमर्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000337033, "chapter_id": 9337, "verse_number": "४-६५-३३", "content_sanskrit": "सोऽङ्गदेन तदा वीरः प्रत्युक्तः प्लवगर्षभः।\nजाम्बवानुत्तमं वाक्यं प्रोवाचेदं ततोऽङ्गदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000337034, "chapter_id": 9337, "verse_number": "४-६५-३४", "content_sanskrit": "तस्य ते वीर कार्यस्य न किंचित् परिहास्यते।\nएष संचोदयाम्येनं यः कार्यं साधयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000337035, "chapter_id": 9337, "verse_number": "४-६५-३५", "content_sanskrit": "ततः प्रतीतं प्लवतां वरिष्ठ-\nमेकान्तमाश्रित्य सुखोपविष्टम्।\nसंचोदयामास हरिप्रवीरो\nहरिप्रवीरं हनुमन्तमेव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000337036, "chapter_id": 9337, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे पञ्चषष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]