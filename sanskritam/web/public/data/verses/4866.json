[{"id": 2182375, "chapter_id": 4866, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2182376, "chapter_id": 4866, "verse_number": "१", "content_sanskrit": "एवमग्राह्यके तस्मिन् ज्ञातिसम्बन्धिमण्डले ।\nमित्रेष्वमित्रेष्वपि च कथं भावो विभाव्यते\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2182377, "chapter_id": 4866, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2182378, "chapter_id": 4866, "verse_number": "२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nवासुदेवस्य संवादं सुरर्षेर्नारदस्य च\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2182379, "chapter_id": 4866, "verse_number": "", "content_sanskrit": "श्रीवासुदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2182380, "chapter_id": 4866, "verse_number": "३", "content_sanskrit": "नासुहृत् परमं मन्त्रं नारदार्हति वेदितुम् ।\nअपण्डितो वापि सुहृत् पण्डितो वापि नात्मवान्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2182381, "chapter_id": 4866, "verse_number": "४", "content_sanskrit": "स ते सौहृदमास्थाय किञ्चिद् वक्ष्यामि नारद ।\nकृत्स्नां च बुद्धिं सम्प्रेक्ष्य सम्पृच्छे त्रिदिवङ्गम\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2182382, "chapter_id": 4866, "verse_number": "५", "content_sanskrit": "दास्यमैश्वर्यवादेन ज्ञातीनां वै करोम्यहम् ।\nअर्धभोक्तास्मि भोगानां वाग्दुरुक्तानि च क्षमे\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2182383, "chapter_id": 4866, "verse_number": "६", "content_sanskrit": "अरणीमग्निकामो वा मथ्नाति हृदयं मम ।\nवाचा दुरुक्तं देवर्षे तन्मे दहति नित्यदा\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2182384, "chapter_id": 4866, "verse_number": "७", "content_sanskrit": "बलं सङ्कर्षणे नित्यं सौकुमार्यं पुनर्गदे ।\nरूपेण मत्तः प्रद्युम्नः सोऽसहायोऽस्मि नारद\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2182385, "chapter_id": 4866, "verse_number": "८", "content_sanskrit": "अन्ये हि सुमहाभागा बलवन्तो दुरासदाः ।\nनित्योत्थानेन सम्पन्ना नारदान्धकवृष्णयः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2182386, "chapter_id": 4866, "verse_number": "९", "content_sanskrit": "यस्य न स्युर्न वै स स्याद् यस्य स्युः कृत्स्नमेव तत् ।\nद्वयोरेव प्रचलतोर्नित्यं वृणोम्येकतरं नच\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2182387, "chapter_id": 4866, "verse_number": "१०", "content_sanskrit": "स्यातां यस्याहुकाक्रूरौ किन्न दुःखतरं ततः ।\nयस्य वापि न तौ स्यातां किन्न दुःखतरं ततः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2182388, "chapter_id": 4866, "verse_number": "११", "content_sanskrit": "सोऽहं कितवमातेव द्वयोरपि महामुने ।\nनैकस्य जयमाशासे द्वितीयस्य पराजयम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2182389, "chapter_id": 4866, "verse_number": "१२", "content_sanskrit": "ममैवं क्लिश्यमानस्य नारदोभयतः सदा ।\nवक्तुमर्हसि यच्छ्रेयो ज्ञातीनामात्मनस्तथा\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2182390, "chapter_id": 4866, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2182391, "chapter_id": 4866, "verse_number": "१३", "content_sanskrit": "आपदो द्विविधाः कृष्ण बाह्याश्चाभ्यन्तराश्च ह ।\nप्रादुर्भवन्ति वार्ष्णेय स्वकृता यदि वाऽन्यतः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2182392, "chapter_id": 4866, "verse_number": "१४", "content_sanskrit": "सेयमाभ्यन्तरा तुभ्यमापत् कृच्छ्रा स्वकर्मजा ।\nअक्रूरभोजप्रभवाः सर्वे ह्येते तदन्वयाः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2182393, "chapter_id": 4866, "verse_number": "१५", "content_sanskrit": "अर्थहेतोर्हि कामाद्वा द्वारा बीभत्सयापि वा ।\nआत्मना प्राप्तमैश्वर्यमन्यत्र प्रतिपादितम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2182394, "chapter_id": 4866, "verse_number": "१६", "content_sanskrit": "कृतमूलमिदानीं तज्ज्ञातिवृद्धं सहायवत् ।\nन शक्यं पुनरादातुं वान्तमन्नमिव त्वया\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2182395, "chapter_id": 4866, "verse_number": "१७", "content_sanskrit": "बभ्रूग्रसेनयो राज्यं नाप्तुं शक्यं कथञ्चन ।\nज्ञातिभेदभयात् कृष्ण त्वया चापि विशेषतः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2182396, "chapter_id": 4866, "verse_number": "१८", "content_sanskrit": "तच्चेत् सिद्ध्येत् प्रयत्नेन कृत्वा कर्म सुदुष्करम् ।\nमहत् क्षयं व्ययं वा स्याद् विनाशो वा पुनर्भवेत्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2182397, "chapter_id": 4866, "verse_number": "१९", "content_sanskrit": "अनायसेन शस्त्रेण मृदुना हृदयच्छिदा ।\nजिह्वामुद्धर सर्वेषां परिमृज्यानुमृज्य च\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2182398, "chapter_id": 4866, "verse_number": "", "content_sanskrit": "वासुदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2182399, "chapter_id": 4866, "verse_number": "२०", "content_sanskrit": "अनायसं मुने शस्त्रं मृदु विद्यामहं कथम् ।\nयेनैषामुद्धरे जिह्वां परिमृज्यानुमृज्य च\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2182400, "chapter_id": 4866, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2182401, "chapter_id": 4866, "verse_number": "२१", "content_sanskrit": "शक्त्यान्नदानं सततं तितिक्षा दम आर्जवम् ।\nयथार्हप्रतिपूजा च शस्त्रमेतदनायसम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2182402, "chapter_id": 4866, "verse_number": "२२", "content_sanskrit": "ज्ञातीनां वक्तुकामानां कटूनि च लघूनि च ।\nगिरा त्वं हृदयं वाचं शमयस्व मनांसि च\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2182403, "chapter_id": 4866, "verse_number": "२३", "content_sanskrit": "नामहापुरुषः कश्चिन्नानात्मा नासहायवान् ।\nमहतीं धुरमादत्ते तामुद्यम्योरसा वह\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2182404, "chapter_id": 4866, "verse_number": "२४", "content_sanskrit": "सर्व एव गुरुं भारमनड्वान् वहते समे ।\nदुर्गे प्रतीकः सुगवो भारं वहति दुर्वहम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2182405, "chapter_id": 4866, "verse_number": "२५", "content_sanskrit": "भेदाद् विनाशः सङ्घानां सङ्घमुख्योऽसि केशव ।\nयथा त्वां प्राप्य नोत्सीदेदयं सङ्घस्तथा कुरु\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2182406, "chapter_id": 4866, "verse_number": "२६", "content_sanskrit": "नान्यत्र बुद्धिक्षान्तिभ्यां नान्यत्रेन्द्रियनिग्रहात् ।\nनान्यत्र धनसन्त्यागाद् गणः प्राज्ञेऽवतिष्ठते\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2182407, "chapter_id": 4866, "verse_number": "२७", "content_sanskrit": "धन्यं यशस्यमायुष्यं स्वपक्षोद्भावनं शुभम् ।\nज्ञातीनामविनाशः स्याद् यथा कृष्ण तथा कुरु\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2182408, "chapter_id": 4866, "verse_number": "२८", "content_sanskrit": "आयत्यां च तदात्वे च न तेऽस्त्यविदितं प्रभो ।\nषाड्गुण्यस्य विधानेन यात्रायानविधौ तथा\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2182409, "chapter_id": 4866, "verse_number": "२९", "content_sanskrit": "माधवाः कुकुरा भोजाः सर्वे चान्धकवृष्णयः ।\nत्वय्यासक्ता महाबाहो लोका लोकेश्वराश्च ये\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2182410, "chapter_id": 4866, "verse_number": "३०", "content_sanskrit": "उपासते हि त्वद्बुद्धिमृषयश्चापि माधव ।\nत्वं गुरुः सर्वभूतानां जानीषे त्वं गतागतम् ।\nत्वामासाद्य यदुश्रेष्ठमेधन्ते ज्ञातिनः सुखम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2182411, "chapter_id": 4866, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि राजधर्मे त्र्यशीतितमोऽध्यायः ॥ ८३ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]