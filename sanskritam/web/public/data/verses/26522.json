[{"id": 7006522000, "chapter_id": 26522, "verse_number": "३-६१-१", "content_sanskrit": "वरुणस्य विप्रचित्तेः सार्द्धं युद्धं पराजयं च वैशम्पायन उवाच विप्रचित्तिस्तु वरुणं दैत्यानामादिरव्ययम् ।\nजघानेषुगणैः क्रुद्धो दीप्तैरिव महोरगैः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006522001, "chapter_id": 26522, "verse_number": "३-६१-२", "content_sanskrit": "स दह्यमानो दैत्येन दीप्तैः शरगभस्तिभिः ।\nनाभ्यजानत कर्तव्यं संग्रामे स जलेश्वरः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006522002, "chapter_id": 26522, "verse_number": "३-६१-३", "content_sanskrit": "सर्वलोकेश्वरस्येव परमेष्ठी प्रजापतिः ।\nन शक्नोत्यग्रतः स्थातुं विप्रचित्तेर्जलाधिपः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006522003, "chapter_id": 26522, "verse_number": "३-६१-४", "content_sanskrit": "वज्रो नाम महाव्यूहो निर्भयः सर्वतोमुखः ।\nतं व्यूह्य प्रत्ययुध्यन्त दानवा देववाहिनीम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006522004, "chapter_id": 26522, "verse_number": "३-६१-५", "content_sanskrit": "वह्निज्वालासमं तत्र रविमण्डलसंनिभम् ।\nमुखमाभाति दैत्यस्य विप्रचित्तेर्महात्मनः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006522005, "chapter_id": 26522, "verse_number": "३-६१-६", "content_sanskrit": "वरुणस्तु महातेजा विप्रचित्तिं महासुरम् ।\nप्रदहन्निव तेजोभिर्जिगीषुः प्रत्यवैक्षत ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006522006, "chapter_id": 26522, "verse_number": "३-६१-७", "content_sanskrit": "स्रग्दाममालाभरणः केयूराङ्गदभूषणः ।\nजग्राह परिघं दैत्यः कैलासशिखरोपमम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006522007, "chapter_id": 26522, "verse_number": "३-६१-८", "content_sanskrit": "पिनद्धं काञ्चनैः पट्टैर्हेममालिनमायसम् ।\nयमदण्डोपमं घोरं दैत्यानां भयनाशनम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006522008, "chapter_id": 26522, "verse_number": "३-६१-९", "content_sanskrit": "भ्रामयामास संक्रुद्धो महाशक्रध्वजोपमम् ।\nविननाद विवृत्तास्यो विप्रचित्तिर्महासुरः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006522009, "chapter_id": 26522, "verse_number": "३-६१-१०", "content_sanskrit": "स कण्ठस्थेन निष्केण भुजस्थैरपि चाङ्गदैः ।\nकुण्डलाभ्यां विचित्राभ्यां भ्राजते काञ्चनस्रजा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006522010, "chapter_id": 26522, "verse_number": "३-६१-११", "content_sanskrit": "दानवो भूषणैर्भाति परिघेणायसेन च ।\nयथेन्द्रधनुषा मेघः सविद्युत्स्तनयित्नुमान् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006522011, "chapter_id": 26522, "verse_number": "३-६१-१२", "content_sanskrit": "प्रस्फुरन् परिघास्त्रेण वातस्कन्धान्महास्वनः ।\nजज्वाल च सधूमार्चिः साङ्कर्षण इवानलः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006522012, "chapter_id": 26522, "verse_number": "३-६१-१३", "content_sanskrit": "विद्याधरगणैः सार्धं गन्धर्वनगरैरपि ।\nसह चैवामरावत्या सिद्धलोकैस्तथा सह ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006522013, "chapter_id": 26522, "verse_number": "३-६१-१४", "content_sanskrit": "ग्रहनक्षत्रसहितं सार्कचन्द्रविभूषितम् ।\nदैत्येन्द्रपरिघोद्धूतं भ्रमतीव नभस्तलम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006522014, "chapter_id": 26522, "verse_number": "३-६१-१५", "content_sanskrit": "दुरासदः सुसंजज्ञे परिघाभरणक्षमः ।\nसुरेन्धनोऽसुरेन्द्राग्निर्युगान्ताग्निरिवोत्थितः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006522015, "chapter_id": 26522, "verse_number": "३-६१-१६", "content_sanskrit": "त्रिदशा वरुणश्चैव न शेकुः स्पन्दितुं भयात् ।\nतत्रासीन्निर्भयस्त्वेकः कौशिको वासवः प्रभुः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006522016, "chapter_id": 26522, "verse_number": "३-६१-१७", "content_sanskrit": "भास्करप्रतिमं घोरं परिघं रौद्रदर्शनम् ।\nपातयामास सेनायां जलेशस्य स दानवः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006522017, "chapter_id": 26522, "verse_number": "३-६१-१८", "content_sanskrit": "पतता तेन संग्रामे जलेशस्य महात्मनः ।\nभूतानां शतसाहस्रं परिघेण समाहतम् ।\nतेषां गात्राणि चासाद्य व्यशीर्यन्त सहस्रशः॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006522018, "chapter_id": 26522, "verse_number": "३-६१-१९", "content_sanskrit": "विशीर्यमाणं विबभावुल्काशतमिवाम्बरे ।\nभूयश्चैनं तदाऽऽभ्राम्य वरुणाय न्यपातयत् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006522019, "chapter_id": 26522, "verse_number": "३-६१-२०", "content_sanskrit": "पात्यमाने तदा तस्मिञ्छरीरे वारुणे तदा ।\nस भिन्नः परिघो घोरो देवगात्रे व्यशीर्यत ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006522020, "chapter_id": 26522, "verse_number": "३-६१-२१", "content_sanskrit": "शीर्यमाणस्य चूर्णानि खद्योता इव चाम्बरे ।\nस तु तेन प्रहारेण न चचाल जलाधिपः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006522021, "chapter_id": 26522, "verse_number": "३-६१-२२", "content_sanskrit": "परिघेण हतः संख्ये यथा वज्रहतोऽचलः ।\nस्वसैन्येष्वपि भग्नेषु भिन्नदेहेषु चाहवे ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006522022, "chapter_id": 26522, "verse_number": "३-६१-२३", "content_sanskrit": "मुहूर्तमगमत् क्षोभमपाम्पतिरमर्षणः ।\nसोऽमर्षं च समापन्नो वरुणोऽमितविक्रमः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006522023, "chapter_id": 26522, "verse_number": "३-६१-२४", "content_sanskrit": "सर्वसंहारमकरोत् स्वपक्षस्यारिमर्दनः ।\nस सागरैश्चतुर्भिश्च वृतो दीप्तैश्च पन्नगैः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006522024, "chapter_id": 26522, "verse_number": "३-६१-२५", "content_sanskrit": "शङ्खमुक्तामणिचितो बिभ्रत्तोयमयं वपुः ।\nपाण्डुरोद्भूतवसनो नानारत्नविभूषितः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006522025, "chapter_id": 26522, "verse_number": "३-६१-२६", "content_sanskrit": "वरुणः पाशधृक्छ्रीमान् कूर्ममीनसमाकुलः ।\nवरुणस्तु तदा क्रुद्धस्तान्निरीक्ष्य स्वसैनिकान् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006522026, "chapter_id": 26522, "verse_number": "३-६१-२७", "content_sanskrit": "उवाच दृष्ट्वा युध्यध्वं दानवानां जिघांसया ।\nअहमेनं हनिष्यामि भयं मुक्त्वा तु युध्यत ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006522027, "chapter_id": 26522, "verse_number": "३-६१-२८", "content_sanskrit": "ततस्ते पन्नगाः सर्वे महार्णवजलाश्रयाः ।\nजघ्नुर्दैत्यान् रणमुखे नदन्तो जयगृद्धिनः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006522028, "chapter_id": 26522, "verse_number": "३-६१-२९", "content_sanskrit": "ते तु नालीकनाराचैर्गदाभिर्मुसलैस्तथा ।\nअभ्यघ्नन् दानवान् हृष्टा मुदिता वरुणानुगाः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006522029, "chapter_id": 26522, "verse_number": "३-६१-३०", "content_sanskrit": "विप्रचित्तिस्तु संक्रुद्धो महाबलपराक्रमः ।\nपन्नगानां शरीराणि व्यधमद् युद्धदुर्मदः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006522030, "chapter_id": 26522, "verse_number": "३-६१-३१", "content_sanskrit": "गरुडेनापि चास्त्रेण पन्नगान् दानवोत्तमः ।\nसमरे घातयामास गरुडैः पन्नगाशनैः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006522031, "chapter_id": 26522, "verse_number": "३-६१-३२", "content_sanskrit": "स शरैः सूर्यसंकाशैः शातकुम्भविभूषितैः ।\nपन्नगान् समरे वीरः प्रममाथ सुदुर्जयान् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006522032, "chapter_id": 26522, "verse_number": "३-६१-३३", "content_sanskrit": "समरे भिन्नगात्रास्ते पन्नगाः शरपीडिताः ।\nपेतुर्मथितसर्वाङ्गा गजा इव महागजैः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006522033, "chapter_id": 26522, "verse_number": "३-६१-३४", "content_sanskrit": "तपन्तं तमिवादित्यं दीप्तैर्बाणगभस्तिभिः ।\nअभ्यधावत संक्रुद्धः समरे वरुणः प्रभुः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006522034, "chapter_id": 26522, "verse_number": "३-६१-३५", "content_sanskrit": "ततस्तु दानवास्तत्र भिन्नदेहाः सहस्रशः ।\nव्यथिता विद्रवन्ति स्म दिशो दश विचेतसः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006522035, "chapter_id": 26522, "verse_number": "३-६१-३६", "content_sanskrit": "इन्द्रस्यार्थे पराक्रम्य वरुणस्त्यक्तजीवितः ।\nविनर्दमानो युयुधे समरे पाशभृद्वरः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006522036, "chapter_id": 26522, "verse_number": "३-६१-३७", "content_sanskrit": "वरुणः पन्नगाश्चैव मुष्टिभिः समरोत्कटाः ।\nअभ्यवर्तन्त समरे विप्रचित्तिं महासुरम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006522037, "chapter_id": 26522, "verse_number": "३-६१-३८", "content_sanskrit": "ततोऽस्त्रैश्च शिलाभिश्च प्राहरत् स बलोत्कटः ।\nव्यपोहत महातेजा विप्रचित्तिर्महासुरः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006522038, "chapter_id": 26522, "verse_number": "३-६१-३९", "content_sanskrit": "ततः पावकसंकाशैः स मुक्तैः शीघ्रगामिभिः ।\nवरुणस्य महावेगान् बिभेद समरे हयान् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006522039, "chapter_id": 26522, "verse_number": "३-६१-४०", "content_sanskrit": "कर्मणा तेन महता विप्रचित्तेर्महात्मनः ।\nअग्नेराज्याहुतस्येव तेजः समभिवर्धत ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006522040, "chapter_id": 26522, "verse_number": "३-६१-४१", "content_sanskrit": "स शरैः सूर्यसंकाशैः सुमुक्तैः शीघ्रगामिभिः ।\nवारुणीं तां महासेनां निर्ममन्थ महाबलः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006522041, "chapter_id": 26522, "verse_number": "३-६१-४२", "content_sanskrit": "क्षीणास्त्रां सायकाक्रान्तां शरजालेन मोहिताम् ।\nशूलशक्त्यृष्टिभिन्नां च चकार रुधिरोक्षिताम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006522042, "chapter_id": 26522, "verse_number": "३-६१-४३", "content_sanskrit": "स शेरैर्वह्निसंकाशैः सुमुक्तैर्नतपर्वभिः ।\nवरुणस्य महावेगान् बिभेद समरे हयान् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006522043, "chapter_id": 26522, "verse_number": "३-६१-४४", "content_sanskrit": "अभिद्रुतोऽथ दैत्येन ससैन्यः सलिलाधिपः ।\nमहेन्द्रं शरणं प्राप्तो विप्रचित्तेर्भयार्दितः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]