[{"id": 2062884, "chapter_id": 2338, "verse_number": "८-५९-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2062885, "chapter_id": 2338, "verse_number": "८-५९-१", "content_sanskrit": "ततः प्रववृते भूयः सङ्ग्रामो राजसत्तम।\nकर्णस्य पाण्डवानां च यमराष्ट्रविवर्धनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2062886, "chapter_id": 2338, "verse_number": "८-५९-२", "content_sanskrit": "धनूंषि बाणान्परिघानसिपट्टसतोमरान्।\nमुसलानि भुशुण्डीश्च शक्तिरिष्टिपरश्वथान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2062887, "chapter_id": 2338, "verse_number": "८-५९-३", "content_sanskrit": "गदाः प्रासाञ्शितान्कुन्तान्भिंडिपालान्महाङ्कुशान्।\nप्रगृह्य क्षिप्रमापेतुः परस्परजिघांसया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2062888, "chapter_id": 2338, "verse_number": "८-५९-४", "content_sanskrit": "बाणज्यातलशब्देन द्यां दिशः प्रदिशो वियत्।\nपृथिवीं नेमिघोषेण नादयन्तोऽभ्ययुः परान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2062889, "chapter_id": 2338, "verse_number": "८-५९-५", "content_sanskrit": "तेन शब्देन महता संहृष्टाश्चक्रुराहवम्।\nवीरा वीरैर्महाप्तोरकलहान्तं तितीर्षवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2062890, "chapter_id": 2338, "verse_number": "८-५९-६", "content_sanskrit": "ज्यातलत्रधनुःशब्दाञ्शस्त्राणां च निपात्यताम्।\nताडितानां च पतता निनादांश्च पदातिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2062891, "chapter_id": 2338, "verse_number": "८-५९-७", "content_sanskrit": "बाणशब्दांश्च विविधाञ्शूराणां चाभिगर्जताम्।\nश्रुत्वा गजा भृशं त्रेसुः पेतुर्मम्लुश्च सैनिकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2062892, "chapter_id": 2338, "verse_number": "८-५९-८", "content_sanskrit": "तेषां निनदतां चैव शस्त्रवर्षं च मुञ्चताम्।\nबहूनाधिरथिर्वीरः प्रममाथेषुभिः परान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2062893, "chapter_id": 2338, "verse_number": "८-५९-९", "content_sanskrit": "पञ्च पाञ्चालवीराणां रथान्दश च पञ्च च।\nसाश्वसूतध्वजान्कर्णः शरैर्निन्ये यमक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2062894, "chapter_id": 2338, "verse_number": "८-५९-१०", "content_sanskrit": "योधमुख्या महावीर्याः पाण्डूनां कर्णमाहवे।\nशिक्षितास्तमभिद्रुत्य परिवव्रुः समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2062895, "chapter_id": 2338, "verse_number": "८-५९-११", "content_sanskrit": "ततः कर्णो द्विषत्सेनां शरवर्षैर्विलोडयन्।\nविजगाहाण्डजाकीर्णां पद्मिनीमिव यूथपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2062896, "chapter_id": 2338, "verse_number": "८-५९-१२", "content_sanskrit": "द्विषत्सैन्यमवस्कन्द्य राधेयो धनुरुत्तमम्।\nविधुन्वानः शितैर्बाणैः शिरांस्युन्मथ्य पातयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2062897, "chapter_id": 2338, "verse_number": "८-५९-१३", "content_sanskrit": "`हस्तिनः समहामात्रान्साश्वारोहान्हयानपि।\nरथिनोऽप्येकबाणेन भ्रमतश्चावपातयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2062898, "chapter_id": 2338, "verse_number": "८-५९-१४", "content_sanskrit": "वर्म वा चर्म वाऽश्रित्य निपातमपि देहिनः।\nविषेहुर्नास्य संस्पर्शं द्वितीयस्य पतत्त्रिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2062899, "chapter_id": 2338, "verse_number": "८-५९-१५", "content_sanskrit": "वर्मयुक्तेषु देहेषु धनुषोऽस्यञ्शिताञ्शरान्।\nमौर्व्या तलत्रे न्यहनत्कशया वाजिनो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2062900, "chapter_id": 2338, "verse_number": "८-५९-१६", "content_sanskrit": "पाण्डुसृञ्जयपाञ्चालाञ्शरगोचरमागतान्।\nममर्द तरसा कर्णः सिंहो मृगगणानिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2062901, "chapter_id": 2338, "verse_number": "८-५९-१७", "content_sanskrit": "ततः पाञ्चालपुत्रश्च द्रौपदेयाश्च मारिष।\nयमौ च युयुधानश्च त्वरिताः कर्णमभ्ययुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2062902, "chapter_id": 2338, "verse_number": "८-५९-१८", "content_sanskrit": "तेषु व्यायच्छमानेषु कुरुपाञ्चालपाण्डुषु।\nप्रियानसून्रणे त्यक्त्वा योधा जघ्नुः परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2062903, "chapter_id": 2338, "verse_number": "८-५९-१९", "content_sanskrit": "सुसन्नद्धाः कवचिनः सशिरस्त्राणभूषणाः।\nगदाभिर्मुसलैश्चान्ये परिघैश्च महाबालाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2062904, "chapter_id": 2338, "verse_number": "८-५९-२०", "content_sanskrit": "समभ्यधावन्त भृशं कालदण्डैरिवोद्यतैः।\nनर्दन्तश्चाह्वयन्तश्च प्रवल्गन्तश्च मारिष॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2062905, "chapter_id": 2338, "verse_number": "८-५९-२१", "content_sanskrit": "ततो निजघ्नुरन्योन्यं पेतुश्चान्योन्यताडिताः।\nवमन्तो रुधिरं गात्रैर्विमस्तिष्केक्षमायुधाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2062906, "chapter_id": 2338, "verse_number": "८-५९-२२", "content_sanskrit": "दन्तपूर्णैः सरुधिरैर्वक्रैर्दाडिमसन्निभैः।\nजीवन्त इव चाप्येके तस्थुः शस्त्रौघबृंहिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2062907, "chapter_id": 2338, "verse_number": "८-५९-२३", "content_sanskrit": "परश्वथैश्चाप्यपरे पट्टसैरसिभिस्तथा।\nशक्तिभिर्भिण्डिपालैश्च नखरप्रासतोमरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2062908, "chapter_id": 2338, "verse_number": "८-५९-२४", "content_sanskrit": "ततक्षुश्चिच्छिदुश्चान्ये बिभिदुश्चिक्षिपुस्तथा।\nसञ्चकर्तुश्च जघ्नुश्च राजन्योधा महारणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2062909, "chapter_id": 2338, "verse_number": "८-५९-२५", "content_sanskrit": "पेतुरन्योन्यनिहता व्यसवो रुधिरोक्षिताः।\nक्षरन्तः स्वरसं रक्तं प्रकृत्ताश्चन्दना इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2062910, "chapter_id": 2338, "verse_number": "८-५९-२६", "content_sanskrit": "रथै रथा विनिहता हस्तिभिश्चापि हस्तिनः।\nनरैर्नरा हताः पेतुरश्वाश्चाश्वैः सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2062911, "chapter_id": 2338, "verse_number": "८-५९-२७", "content_sanskrit": "ध्वजाः शिरांसि च्छिन्नाः पेतुर्महीतले॥\n`वध्यतां दारुणाः शब्दाः पततां स्तनतामपि।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2062912, "chapter_id": 2338, "verse_number": "८-५९-२८", "content_sanskrit": "क्षुरैर्भल्लार्धचन्द्रैश्च च्छिन्नाः पेतुर्महीतले॥\nनराश्वेभरथानां हिनराश्वेभरथैस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2062913, "chapter_id": 2338, "verse_number": "८-५९-२९", "content_sanskrit": "नरांश्च नागांश्च रथान्हयान्ममृदुराहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2062914, "chapter_id": 2338, "verse_number": "८-५९-३०", "content_sanskrit": "अश्वारोहैर्हताः शूराश्छिन्नहस्ताश्च दन्तिनः।\nसपताकाध्वजाः पेतुर्विशीर्णा इव पर्वताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2062915, "chapter_id": 2338, "verse_number": "८-५९-३१", "content_sanskrit": "पत्तिभिश्च समाप्लुत्य द्विरदाः स्यन्दनास्तथा।\nहताश्च हन्यमानाश्च पतिताश्चैव सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2062916, "chapter_id": 2338, "verse_number": "८-५९-३२", "content_sanskrit": "अश्वारोहाः समासाद्य त्वरिताः पत्तिभिर्हताः।\nसादिभिः पत्तिसङ्घाश्च निहता युधि शेरते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2062917, "chapter_id": 2338, "verse_number": "८-५९-३३", "content_sanskrit": "मृदितानीव पद्मानि प्रम्लाना इव च स्रजः।\nहतानां वदनान्यासन्गात्राणि च महाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2062918, "chapter_id": 2338, "verse_number": "८-५९-३४", "content_sanskrit": "रूपाण्यत्यर्थकान्तानि द्विरदाश्वनृणां नृप।\nसमुन्नानीव वस्त्राणि ययुर्दुर्दुर्शतां पराम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2062919, "chapter_id": 2338, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि सप्तदशदिवसयुद्धे एकोनषष्टितमोऽध्यायः॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]