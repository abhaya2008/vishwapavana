[{"id": 6000017000, "chapter_id": 10017, "verse_number": null, "content_sanskrit": "अथ सप्‍तदशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000017001, "chapter_id": 10017, "verse_number": null, "content_sanskrit": "सूत उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_017/BhP_01.017.001.m4a", "display_order": 2}, {"id": 6000017002, "chapter_id": 10017, "verse_number": "१-१७-१", "content_sanskrit": "तत्र गोमिथुनं राजा हन्यमानमनाथवत्।\nदण्डहस्तं ‍च वृषलं ददृशे नृपलाञ्छनम्॥ १/१७/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_017/BhP_01.017.002.m4a", "display_order": 3, "topics": [{"text": "तत्र प्राचीसरस्वतीतीरे राजवेषधारिणा शूद्रेण ताड्यमानगोमिथुनदर्शनम्", "range": "१"}]}, {"id": 6000017003, "chapter_id": 10017, "verse_number": "१-१७-२", "content_sanskrit": "वृषं मृणालधवलं मेहन्तमिव बिभ्यतम्।\nवेपमानं पदैकेन सीदन्तं शूद्रपीडितम्॥ १/१७/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_017/BhP_01.017.003.m4a", "display_order": 4, "topics": [{"text": "वृषभो धर्म इति, गौर्भूमिरिति, शूद्रः कलिरिति च ज्ञातवता परीक्षिता कलिवधाय खड्गपरिग्रहः", "range": "२–२७"}]}, {"id": 6000017004, "chapter_id": 10017, "verse_number": "१-१७-३", "content_sanskrit": "गां ‍च धर्मदुघां दीनां भृशं शूद्रपदाहताम्।\nविवत्सामश्रुवदनां कृशां यवसमिच्छतीम्॥ १/१७/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_017/BhP_01.017.004.m4a", "display_order": 5}, {"id": 6000017005, "chapter_id": 10017, "verse_number": "१-१७-४", "content_sanskrit": "पप्रच्छ रथमारूढः कार्तस्वरपरिच्छदम्।\nमेघगम्भीरया वाचा समारोपितकार्मुकः॥ १/१७/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_017/BhP_01.017.005.m4a", "display_order": 6}, {"id": 6000017006, "chapter_id": 10017, "verse_number": "१-१७-५", "content_sanskrit": "कस्त्वं मच्छरणे लोके बलाद्धंस्यबलौ बली।\nनरदेवोऽसि वेषेण नटवत्कर्मणाऽद्विजः॥ १/१७/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_017/BhP_01.017.006.m4a", "display_order": 7}, {"id": 6000017007, "chapter_id": 10017, "verse_number": "१-१७-६", "content_sanskrit": "स त्वं कृष्णे गते दूरं सह गाण्डीवधन्वना।\nशोच्योऽस्यशोच्यान्रहसि प्रहरन्वधमर्हसि॥ १/१७/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_017/BhP_01.017.007.m4a", "display_order": 8}, {"id": 6000017008, "chapter_id": 10017, "verse_number": "१-१७-७", "content_sanskrit": "त्वं वा मृणालधवलः पादैर्न्यूनः पदा चरन्।\nवृषरूपेण किं कश्‍चिद्देवो नः परिखेदयन्॥ १/१७/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_017/BhP_01.017.008.m4a", "display_order": 9}, {"id": 6000017009, "chapter_id": 10017, "verse_number": "१-१७-८", "content_sanskrit": "न जातु कौरवेन्द्राणां दोर्दण्डपरिरम्भिते।\nभूतले निपतन्त्यस्मिन्विना त्वां प्राणिनां शुचः॥ १/१७/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_017/BhP_01.017.009.m4a", "display_order": 10}, {"id": 6000017010, "chapter_id": 10017, "verse_number": "१-१७-९", "content_sanskrit": "मा सौरभेयानुशुचो व्येतु ते वृषलाद्भयम्।\nमा रोदीरम्ब भद्रं ते खलानां मयि शास्तरि॥ १/१७/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_017/BhP_01.017.010.m4a", "display_order": 11}, {"id": 6000017011, "chapter_id": 10017, "verse_number": "१-१७-१०", "content_sanskrit": "यस्य राष्‍ट्रे प्रजा मातर्हिंस्यन्ते साध्वसाधुभिः।\nतस्य मत्तस्य नश्यन्ति कीर्तिरायुर्भगो गतिः॥ १/१७/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_017/BhP_01.017.011.m4a", "display_order": 12}, {"id": 6000017012, "chapter_id": 10017, "verse_number": "१-१७-११", "content_sanskrit": "एष राज्ञः परो धर्मो ह्यार्तानामार्तिनिग्रहः।\nअत एनं वधिष्यामि भूतद्रुहमसत्तमम्॥ १/१७/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_017/BhP_01.017.012.m4a", "display_order": 13}, {"id": 6000017013, "chapter_id": 10017, "verse_number": "१-१७-१२", "content_sanskrit": "कोऽवृश्‍चत्तव पादांस्‍त्रीन्सौरभेय चतुष्पदः।\nमा भूवंस्त्वादृशा राष्‍ट्रे राज्ञां कृष्णानुवर्तिनाम्॥ १/१७/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_017/BhP_01.017.013.m4a", "display_order": 14}, {"id": 6000017014, "chapter_id": 10017, "verse_number": "१-१७-१३", "content_sanskrit": "आख्याहि वृष भद्रं वः साधूनामकृतागसाम्। आत्मवैरूप्यकर्तारं पार्थानां कीर्तिदूषणम्।\nगलेऽनागस्यघं युञ्जन्सर्वतोऽस्य च तद्भयम्॥ १/१७/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_017/BhP_01.017.014.m4a", "display_order": 15}, {"id": 6000017015, "chapter_id": 10017, "verse_number": "१-१७-१४", "content_sanskrit": "अनागस्स्विह भूतेषु य आगस्कृन्निरङ्कुशः।\nआहर्ताऽस्मि भुजं साक्षादमर्त्यस्यापि साङ्गदम्॥ १/१७/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_017/BhP_01.017.015.m4a", "display_order": 16}, {"id": 6000017016, "chapter_id": 10017, "verse_number": "१-१७-१५", "content_sanskrit": "राज्ञो हि परमो धर्मः स्वधर्मस्यानुपालनम्।\nशासतोऽन्यान्यथाशास्‍त्रमनापद्युत्पथानिह॥ १/१७/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_017/BhP_01.017.016.m4a", "display_order": 17}, {"id": 6000017017, "chapter_id": 10017, "verse_number": null, "content_sanskrit": "धर्म उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_017/BhP_01.017.017.m4a", "display_order": 18}, {"id": 6000017018, "chapter_id": 10017, "verse_number": "१-१७-१६", "content_sanskrit": "एतद्वः पाण्डवेयानां युक्‍तमार्ताभयं वचः।\nयेषां गुणगणैः कृष्णो दौत्यादौ भगवान्वृतः॥ १/१७/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_017/BhP_01.017.018.m4a", "display_order": 19}, {"id": 6000017019, "chapter_id": 10017, "verse_number": "१-१७-१७", "content_sanskrit": "न वयं क्लेशबीजानि यतः स्युः पुरुषर्षभ।\nपुरुषं तं विजानीमः वाक्यभेदविमोहिताः॥ १/१७/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_017/BhP_01.017.019.m4a", "display_order": 20}, {"id": 6000017020, "chapter_id": 10017, "verse_number": "१-१७-१८", "content_sanskrit": "केचिद्वैकल्पवचस आहुरात्मानमात्मनः।\nदैवमन्ये परे कर्म स्वभावमपरे प्रभुम्॥ १/१७/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_017/BhP_01.017.020.m4a", "display_order": 21}, {"id": 6000017021, "chapter_id": 10017, "verse_number": "१-१७-१९", "content_sanskrit": "अप्रतर्क्यादनिर्देश्यादिति केष्वपि निश्‍चयः।\nअत्रानुरूपं राजर्षे विमृश स्वमनीषया॥ १/१७/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_017/BhP_01.017.021.m4a", "display_order": 22}, {"id": 6000017022, "chapter_id": 10017, "verse_number": "१-१७-२०", "content_sanskrit": "एवं धर्मे प्रवदति स सम्राट् द्विजसत्तम।\nसमाहितेन मनसा विदित्वा प्रत्यचष्‍ट तम्॥ १/१७/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_017/BhP_01.017.022.m4a", "display_order": 23}, {"id": 6000017023, "chapter_id": 10017, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_017/BhP_01.017.023.m4a", "display_order": 24}, {"id": 6000017024, "chapter_id": 10017, "verse_number": "१-१७-२१", "content_sanskrit": "धर्मं ब्रवीषि धर्मज्ञ धर्मोऽसि वृषरूपधृक्।\nयदधर्मकृतः स्थानं सूचकस्यापि तद्भवेत्॥ १/१७/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_017/BhP_01.017.024.m4a", "display_order": 25}, {"id": 6000017025, "chapter_id": 10017, "verse_number": "१-१७-२२", "content_sanskrit": "अथवा देवमायाया नूनं गतिरगोचरा।\nचेतसो वचसश्‍चापि भूतानामिति निश्‍चयः॥ १/१७/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_017/BhP_01.017.025.m4a", "display_order": 26}, {"id": 6000017026, "chapter_id": 10017, "verse_number": "१-१७-२३", "content_sanskrit": "तपः शौचं दया सत्यं इति पादाः कृते कृताः।\nअधर्माङ्गैस्‍त्रयो भग्नाः स्मयसङ्गमदैस्तव॥ १/१७/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_017/BhP_01.017.026.m4a", "display_order": 27}, {"id": 6000017027, "chapter_id": 10017, "verse_number": "१-१७-२४", "content_sanskrit": "इदानीं धर्मपादस्ते सत्यं निर्वर्तसे यतः।\nतं जिघृक्षत्यधर्मोऽयमनृतेनैधितः कलिः॥ १/१७/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_017/BhP_01.017.027.m4a", "display_order": 28}, {"id": 6000017028, "chapter_id": 10017, "verse_number": "१-१७-२५", "content_sanskrit": "इयं ‍च भूर्भगवता न्यासितोरुभरा सती।\nश्रीमद्भिस्तत्पदन्यासैः सर्वतः कृतकौतुका॥ १/१७/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_017/BhP_01.017.028.m4a", "display_order": 29}, {"id": 6000017029, "chapter_id": 10017, "verse_number": "१-१७-२६", "content_sanskrit": "शोचन्त्यश्रुकला साध्वी दुर्भगेवोज्झिताऽधुना।\nअब्रह्मण्या नृपव्याजाः शूद्रा भोक्ष्यन्ति मामिति॥ १/१७/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_017/BhP_01.017.029.m4a", "display_order": 30}, {"id": 6000017030, "chapter_id": 10017, "verse_number": null, "content_sanskrit": "सूत उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_017/BhP_01.017.030.m4a", "display_order": 31}, {"id": 6000017031, "chapter_id": 10017, "verse_number": "१-१७-२७", "content_sanskrit": "इति धर्मं महीं ‍चैव सान्त्वयित्वा महारथः।\nनिशातमाददे खड्गं कलयेऽधर्महेतवे॥ १/१७/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_017/BhP_01.017.031.m4a", "display_order": 32}, {"id": 6000017032, "chapter_id": 10017, "verse_number": "१-१७-२८", "content_sanskrit": "तज्जिघांसुमभिप्रेत्य विहाय नृपलाच्छनम्।\nतत्पादमूलं शिरसा समगाद्भयविह्वलः॥ १/१७/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_017/BhP_01.017.032.m4a", "display_order": 33, "topics": [{"text": "शरणगताय स्वस्य निवासाय किंचित्स्थानं याचमानाय कलये द्यूतादिस्थानपञ्चकदानम्", "range": "२८–४४"}]}, {"id": 6000017033, "chapter_id": 10017, "verse_number": "१-१७-२९", "content_sanskrit": "पतितं पादयोर्वीरः कृपया दीनवत्सलः।\nशरण्यो नावधीच्छ्लोक्य आह चेदं हसन्निव॥ १/१७/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_017/BhP_01.017.033.m4a", "display_order": 34}, {"id": 6000017034, "chapter_id": 10017, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_017/BhP_01.017.034.m4a", "display_order": 35}, {"id": 6000017035, "chapter_id": 10017, "verse_number": "१-१७-३०", "content_sanskrit": "न ते गुडाकेशयशोधराणां बद्धाञ्जलेर्भो भयमस्ति किञ्चित्।\nन वर्तितव्यं भवता कथञ्चित् क्षेत्रे मदीये त्वमधर्मबन्धुः॥ १/१७/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_017/BhP_01.017.035.m4a", "display_order": 36}, {"id": 6000017036, "chapter_id": 10017, "verse_number": "१-१७-३१", "content_sanskrit": "त्वां वर्तमानं नरदेवदेहेष्वनुप्रवृत्तोऽयमधर्मयूथः।\nलोभोऽनृतं चौर्यमनार्यमंहो ज्येष्‍ठा च माया कलहश्‍च दम्भः॥ १/१७/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_017/BhP_01.017.036.m4a", "display_order": 37}, {"id": 6000017037, "chapter_id": 10017, "verse_number": "१-१७-३२", "content_sanskrit": "न वर्तितव्यं तदधर्मबन्धो धर्मेण सत्येन च वर्तितव्ये।\nब्रह्मावर्ते यत्र यजन्ति यज्ञैः यज्ञेश्‍वरं ब्रह्मवितानयज्ञाः॥ १/१७/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_017/BhP_01.017.037.m4a", "display_order": 38}, {"id": 6000017038, "chapter_id": 10017, "verse_number": "१-१७-३३", "content_sanskrit": "यस्मिन्हरिर्भगवानिज्यमान इष्‍टात्ममूर्तिर्यजतां शं तनोति।\nकामानमोघान् स्थिरजङ्गमानाम् अन्तर्बहिर्वायुरिवेश आत्मा॥ १/१७/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_017/BhP_01.017.038.m4a", "display_order": 39}, {"id": 6000017039, "chapter_id": 10017, "verse_number": "१-१७-३४", "content_sanskrit": "परीक्षितैवमादिष्‍टः स कलिर्जातवेपथुः।\nतमुद्यतासिमाहेदं दण्डपाणिमिवोद्यतम्॥ १/१७/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_017/BhP_01.017.039.m4a", "display_order": 40}, {"id": 6000017040, "chapter_id": 10017, "verse_number": "१-१७-३५", "content_sanskrit": "यत्र क्‍व वाऽथ वत्स्यामि सार्वभौम तवाज्ञया।\nलक्षये तत्र तत्रापि त्वामात्तेषुशरासनम्॥ १/१७/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_017/BhP_01.017.040.m4a", "display_order": 41}, {"id": 6000017041, "chapter_id": 10017, "verse_number": "१-१७-३६", "content_sanskrit": "तन्मे धर्मभृतां श्रेष्‍ठ स्थानं निर्देष्‍टुमर्हसि।\nयत्रैव नियतो वत्स्य आतिष्‍ठंस्तेऽनुशासनम्॥ १/१७/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_017/BhP_01.017.041.m4a", "display_order": 42}, {"id": 6000017042, "chapter_id": 10017, "verse_number": null, "content_sanskrit": "सूत उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_017/BhP_01.017.042.m4a", "display_order": 43}, {"id": 6000017043, "chapter_id": 10017, "verse_number": "१-१७-३७", "content_sanskrit": "अभ्यर्थितस्तदा तस्मै स्थानानि कलये ददौ।\nद्यूतं पानं स्‍त्रियः सूना यत्राधर्मश्‍चतुर्विधः॥ १/१७/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_017/BhP_01.017.043.m4a", "display_order": 44}, {"id": 6000017044, "chapter_id": 10017, "verse_number": "१-१७-३८", "content_sanskrit": "पुनश्‍च याचमानाय जातरूपमदात्प्रभुः।\nततोऽनृतं मदः कामो रजो वैरं ‍च पञ्चमम्॥ १/१७/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_017/BhP_01.017.044.m4a", "display_order": 45}, {"id": 6000017045, "chapter_id": 10017, "verse_number": "१-१७-३९", "content_sanskrit": "अमूनि पञ्चस्थानानि ह्यधर्मप्रभवः कलिः।\nऔत्तरेयेण दत्तानि न्यवसत्तन्निदेशकृत्॥ १/१७/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_017/BhP_01.017.045.m4a", "display_order": 46}, {"id": 6000017046, "chapter_id": 10017, "verse_number": "१-१७-४०", "content_sanskrit": "अथैतानि न सेवेत बुभूषुः पुरुषः क्‍वचित्।\nविशेषतो धर्मशीलो राजा लोकपतिर्गुरुः॥ १/१७/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_017/BhP_01.017.046.m4a", "display_order": 47}, {"id": 6000017047, "chapter_id": 10017, "verse_number": "१-१७-४१", "content_sanskrit": "वृषस्य नष्‍टांस्‍त्रीन्पादांस्तपः शौचं दयामिति।\nप्रतिसन्दध आश्‍वास्य महीं ‍च समवर्धयत्॥ १/१७/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_017/BhP_01.017.047.m4a", "display_order": 48}, {"id": 6000017048, "chapter_id": 10017, "verse_number": "१-१७-४२", "content_sanskrit": "स एष एतर्ह्यध्यास्त आसनं पार्थिवोचितम्।\nपितामहेनोपन्यस्तं राज्ञाऽरण्यं विविक्षता॥ १/१७/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_017/BhP_01.017.048.m4a", "display_order": 49}, {"id": 6000017049, "chapter_id": 10017, "verse_number": "१-१७-४३", "content_sanskrit": "आस्तेऽधुना स राजर्षिः कौरवेन्द्रः श्रियोल्‍लसन्।\nगजाह्वये महाभागश्‍चक्रवर्ती बृहच्छ्रवाः॥ १/१७/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_017/BhP_01.017.049.m4a", "display_order": 50}, {"id": 6000017050, "chapter_id": 10017, "verse_number": "१-१७-४४", "content_sanskrit": "इत्थं भूतानुभावोऽयमभिमन्युसुतो नृपः।\nयस्य पालयतः क्षोणीं यूयं सत्राय दीक्षिताः॥ १/१७/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_017/BhP_01.017.050.m4a", "display_order": 51}, {"id": 6000017051, "chapter_id": 10017, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां प्रथमस्कन्धे सप्‍तदशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]