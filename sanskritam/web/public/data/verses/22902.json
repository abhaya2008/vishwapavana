[{"id": 7002902000, "chapter_id": 22902, "verse_number": "९-१८७-१", "content_sanskrit": "श्रीकृष्ण उवाच ।\nअथातः संप्रवक्ष्यामि तव पांडुकुलोद्वह ।\nपुण्यं हेमरथं नाम महापातकनाशनम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002902001, "chapter_id": 22902, "verse_number": "९-१८७-२", "content_sanskrit": "पुण्येऽह्नि विप्रकथिते स्वनुलिप्ते गृहांगणे ।\nकृष्णाजिनतिलान्कृत्वा कांचनं स्थापयेद्रथम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002902002, "chapter_id": 22902, "verse_number": "९-१८७-३", "content_sanskrit": "चतुरस्रं महाभाग चतुश्चक्रं सकूबरम् ।\nब्रह्माणमग्रतः कृत्वा गृहीतप्रग्रहं शुभम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002902003, "chapter_id": 22902, "verse_number": "९-१८७-४", "content_sanskrit": "इंद्रनीलेन कुंभेन ध्वजरूपेण संयुतम् ।\nलोकपालाष्टकोपेतं पद्मरागदलान्वितम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002902004, "chapter_id": 22902, "verse_number": "९-१८७-५", "content_sanskrit": "चत्वारः पूर्णकलशा धान्यान्यष्टादशैव तु ।\nकौशेयवस्त्रसंवीतमुपरिष्टाद्वितानकम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002902005, "chapter_id": 22902, "verse_number": "९-१८७-६", "content_sanskrit": "मध्ये तु फलसंयुक्तं पुरुषेण समन्वितम् ।\nयोगयुक्तः पुमान्कार्यस्तं च तत्राधिवासयेत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002902006, "chapter_id": 22902, "verse_number": "९-१८७-७", "content_sanskrit": "एवंविधं पूजयित्वा माल्यगंधानुलेपनैः ।\nचक्ररक्षावुभौ तस्य कार्यौ विश्वकुमारकौ ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002902007, "chapter_id": 22902, "verse_number": "९-१८७-८", "content_sanskrit": "पुण्यं कालं ततः प्राप्य स्नातः संपूज्य देवताः ।\nत्रिःप्रदक्षिणमावृत्य गृहीतकुसुमांजलिः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002902008, "chapter_id": 22902, "verse_number": "९-१८७-९", "content_sanskrit": "शुक्लमाल्यांबरधर इमं मंत्रमुदीरयेत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002902009, "chapter_id": 22902, "verse_number": "९-१८७-१०", "content_sanskrit": "नमोनमः पापविनाशनाय विश्वात्मने देवतुरंगमाय ।\nधात्रामधीशाय भवाभवाय रथस्य दानान्मम देहि शांतिम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002902010, "chapter_id": 22902, "verse_number": "९-१८७-११", "content_sanskrit": "वस्वष्टकादित्यमरुद्गणानां त्वमेव धाता परमं निधानम् ।\nयतस्ततो मे हृदयं प्रयातु धर्मैकतानत्वमघौघनाशात् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002902011, "chapter_id": 22902, "verse_number": "९-१८७-१२", "content_sanskrit": "इति तुरगरथप्रदानमेतद्भवभयसूदनमंत्रं यः करोति ।\nसकलुषपटलैर्विमुक्तदेहः परममुपैति पदं पिनाकपाणेः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002902012, "chapter_id": 22902, "verse_number": "९-१८७-१३", "content_sanskrit": "देदीप्यमानवपुषा च जितप्रभावमाक्रम्य मडलमखंडलचंडभानोः ।\nसिद्धांगनानयनयुग्मप्रनि पीयमानवक्त्रांबुजेंऽबुजभवेन चिरं सहास्ते ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002902013, "chapter_id": 22902, "verse_number": "९-१८७-१४", "content_sanskrit": "इति पठति शृणोति वा य एतत्कनकतुरंगरथप्रदानमस्मिन् ।\nन स नरकपुरं व्रजेत्कदाचिन्नरकरिपोर्भवनं प्रयाति भूयः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]