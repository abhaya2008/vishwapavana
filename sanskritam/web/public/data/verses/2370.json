[{"id": 2064485, "chapter_id": 2370, "verse_number": "८-९१-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2064486, "chapter_id": 2370, "verse_number": "८-९१-१", "content_sanskrit": "वृषसेनं हतं दृष्ट्वा क्रोधामर्षसमन्वितः।\nपुत्रशोकोद्भवं वारि नेत्राभ्यां समवासृजत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2064487, "chapter_id": 2370, "verse_number": "८-९१-२", "content_sanskrit": "रथेन कर्णस्तेजस्वी जगामाभिमुखो रिपुम्।\nयुद्धायामर्पताम्राक्षः समाहूय धनञ्जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2064488, "chapter_id": 2370, "verse_number": "८-९१-३", "content_sanskrit": "तौ रथौ सूर्यसङ्काशौ वैयाघ्रपरिवारितौ।\nसमेतौ ददृशुस्तत्र द्वाविवार्कौ समुद्गतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2064489, "chapter_id": 2370, "verse_number": "८-९१-४", "content_sanskrit": "श्वेताश्वौ पुरुषादित्यावास्थितावरिमर्दनौ।\nशुशुभाते महात्मानौ चन्द्रादित्यौ यथा दिवि।\n`रथौ चतुर्भिर्जलदैर्भगमित्राविवाम्बरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2064490, "chapter_id": 2370, "verse_number": "८-९१-५", "content_sanskrit": "तौ दृष्ट्वा विस्मयं जग्मुः सर्वसैन्यानि मारिष।\nत्रैलोक्यविजये यत्ताविन्द्रवैरोचनाविव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2064491, "chapter_id": 2370, "verse_number": "८-९१-६", "content_sanskrit": "रथज्यातलनिर्हादैर्बाणशङ्खरवैस्तथा।\nतौ रथावभ्यधावन्त क्षत्रियाः सर्व एव हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2064492, "chapter_id": 2370, "verse_number": "८-९१-७", "content_sanskrit": "ध्वजावालोक्य वीराणां विस्मयः समपद्यत।\nहस्तिकक्ष्यां च कर्णस्य वानरं च किरीटिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2064493, "chapter_id": 2370, "verse_number": "८-९१-८", "content_sanskrit": "तौ रथौ सम्प्रसक्तौ तु दृष्ट्वा भारत पार्थिवाः।\nसिंहनादरवांश्चक्रुः साधुवादांश्च पुष्कलान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2064494, "chapter_id": 2370, "verse_number": "८-९१-९", "content_sanskrit": "श्रुत्वा तयोर्द्वैरथं च तत्र योधाः सहस्रशः।\nचक्रुर्बाहुस्वनांश्चैव तथा बाणरवं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2064495, "chapter_id": 2370, "verse_number": "८-९१-१०", "content_sanskrit": "आजघ्नुः कुरवस्तत्र वादित्राणि समन्ततः।\nराधेयमभितो दध्मुः शङ्खाञ्शतसहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2064496, "chapter_id": 2370, "verse_number": "८-९१-११", "content_sanskrit": "तथैव पाण्डवाः सर्वे हर्षयन्तो धनञ्जयम्।\nतूर्यशङ्खनिनादेन दिशः सर्वा व्यनादयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2064497, "chapter_id": 2370, "verse_number": "८-९१-१२", "content_sanskrit": "क्ष्वेलितास्फोटितोत्क्रुष्टैस्तुमुलं सर्वतोऽभवत्।\nबाहुशब्दैश्च शूराणां कर्णार्जुनसमागमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2064498, "chapter_id": 2370, "verse_number": "८-९१-१३", "content_sanskrit": "तौ दृष्ट्वा पुरुषव्याघ्रौ रथस्थौ रथिनां वरौ।\nप्रगृहीतमहाचापौ शरशक्तिध्वजायुतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2064499, "chapter_id": 2370, "verse_number": "८-९१-१४", "content_sanskrit": "वर्मिणौ बद्धनिस्त्रिंशौ श्वेताश्वौ शङ्खशोभितौ।\nतूणीरवसम्पन्नौ द्वावप्येतौ सुदर्शनौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2064500, "chapter_id": 2370, "verse_number": "८-९१-१५", "content_sanskrit": "रक्तचन्दनदिग्धाङ्गौ समदौ गोवृषाविव।\nचापविद्युद्ध्वजोपेतौ शस्त्रसम्पत्तियोधिनौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2064501, "chapter_id": 2370, "verse_number": "८-९१-१६", "content_sanskrit": "चामरव्यजनोपैतौ श्वेतच्छत्रोपशोभितौ।\nकृष्णशल्यरथोपेतौ तुल्यरूपौ महारथौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2064502, "chapter_id": 2370, "verse_number": "८-९१-१७", "content_sanskrit": "सिंहस्कन्धौ दीर्घभुजौ रक्ताक्षौ हेममालिनौ।\nसिंहस्कन्धप्रतीकाशौ व्यूढोरस्कौ महाबलौ।\nअन्योन्यवधमिच्छन्तावन्योन्यजयकाङ्क्षिणौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2064503, "chapter_id": 2370, "verse_number": "८-९१-१८", "content_sanskrit": "अन्योन्यमभिधावन्तौ गोष्ठे गोवृषभाविव।\nप्रभिन्नाविव मातङ्गौ सुसंरब्धाविवाचलौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2064504, "chapter_id": 2370, "verse_number": "८-९१-१९", "content_sanskrit": "आशीविषशिशुप्रख्यौ यमकालान्तकोपमौ।\nइन्द्रवृत्राविव क्रुद्धौ सूर्यचन्द्रसमप्रभौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2064505, "chapter_id": 2370, "verse_number": "८-९१-२०", "content_sanskrit": "महाग्रहाविव क्रुद्धौ युगान्ताय समुत्थितौ।\nदेवगर्भौ देवसमौ देवतुल्यौ च रूपतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2064506, "chapter_id": 2370, "verse_number": "८-९१-२१", "content_sanskrit": "यदृच्छया समायातौ सूर्याचन्द्रमसौ यथा।\nबलिनौ समरे दृप्तौ नानाशस्त्रधरौ युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2064507, "chapter_id": 2370, "verse_number": "८-९१-२२", "content_sanskrit": "तौ दृष्ट्वा पुरुषव्याघ्रौ शार्दूलाविव धिष्ठितौ।\nबभूव परमो हर्षस्तावकानां विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2064508, "chapter_id": 2370, "verse_number": "८-९१-२३", "content_sanskrit": "संशयः सर्वभूतानां विजये समपद्यत।\nसमेतौ पुरुषव्याघ्रौ प्रेक्ष्य कर्णधनञ्जयौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2064509, "chapter_id": 2370, "verse_number": "८-९१-२४", "content_sanskrit": "उभौ वरायुधधरावुभौ रणकृतश्रमौ।\nउभौ च बाहुशब्देन नादयन्तौ नभस्तलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2064510, "chapter_id": 2370, "verse_number": "८-९१-२५", "content_sanskrit": "उभौ विश्रुतकर्माणौ पौरुषेण बलेन च।\nउभौ च सदृशौ युद्धे शम्बरामरराजयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2064511, "chapter_id": 2370, "verse_number": "८-९१-२६", "content_sanskrit": "कार्तवीर्यसमौ चोभावुभौ दाशरथेः समौ।\nविष्णुवीर्यसमौ चोभावुभौ भवसमौ युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2064512, "chapter_id": 2370, "verse_number": "८-९१-२७", "content_sanskrit": "उभौ श्वेतहयौ राजन्रथप्रवरवाहिनौ।\nसारथिप्रवरौ चापि उभौ मद्रजनार्दनौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2064513, "chapter_id": 2370, "verse_number": "८-९१-२८", "content_sanskrit": "ततो दृष्ट्वा महाराज राजमानौ महारथौ।\nसिद्धचारणसङ्घानां विस्मयः समपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2064514, "chapter_id": 2370, "verse_number": "८-९१-२९", "content_sanskrit": "धार्तराष्ट्रास्ततस्तूर्णं सबला भरतर्षभ।\nपरिवव्रुर्महात्मानं कर्णमाहवशोभिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2064515, "chapter_id": 2370, "verse_number": "८-९१-३०", "content_sanskrit": "तथैव पाण्डवा दृष्ट्वा धृष्टद्युम्नपुरोगमाः।\nयमौ च चेकितानश्च प्रहृष्टाश्च प्रभद्रकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2064516, "chapter_id": 2370, "verse_number": "८-९१-३१", "content_sanskrit": "नानादेश्याश्च ये शूराः शिष्टा युद्धाभिनन्दिनः।\nते सर्वे सहिता हृष्टाः परिवव्रुर्धनञ्जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2064517, "chapter_id": 2370, "verse_number": "८-९१-३२", "content_sanskrit": "रिरक्षिषन्तः शथ्रुघ्नाः पत्त्यश्वरथकुञ्जराः।\nधनञ्जयस्य विजये धृताः कर्णवधेऽपि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2064518, "chapter_id": 2370, "verse_number": "८-९१-३३", "content_sanskrit": "तथैव तावकाः सर्वे यत्ताः सेनाप्रहारिणः।\nदुर्योधनमुखा राजन्कर्णं जुगुपुराहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2064519, "chapter_id": 2370, "verse_number": "८-९१-३४", "content_sanskrit": "तावकानां रणे कर्णो ग्लहो ह्यासीद्विशाम्पते।\nतथैव पाण्डवेयानां ग्लहः पार्थोऽभवत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2064520, "chapter_id": 2370, "verse_number": "८-९१-३५", "content_sanskrit": "तयोस्तु सभ्यास्तत्रासन्प्रेक्षकाश्चाभवन्युधि।\nतत्रैषां ग्लहमानानां ध्रुवौ जयपराजयौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2064521, "chapter_id": 2370, "verse_number": "८-९१-३६", "content_sanskrit": "ताभ्यां द्यतं समासक्तं विजयायेतराय वा।\nअस्माकं पाण्डवानां च स्थितानां रणमूर्धनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2064522, "chapter_id": 2370, "verse_number": "८-९१-३७", "content_sanskrit": "तौ तु स्थितौ महाराज समरे युद्धशालिनौ।\nअन्योन्यं प्रतिसंरब्धावन्योन्यवधकाङ्क्षिणौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2064523, "chapter_id": 2370, "verse_number": "८-९१-३८", "content_sanskrit": "तावुमौ प्रजिहीर्षन्ताविन्द्रवृत्राविव प्रभो।\nभीमरूपधरावास्तां महाधूमाविव ग्रहौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2064524, "chapter_id": 2370, "verse_number": "८-९१-३९", "content_sanskrit": "ततोऽन्तरिक्षे सञ्जज्ञे विवादो भरतर्षभ।\nमिथो भेदाश्च भूतानामासन्कर्णार्जुनान्तरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2064525, "chapter_id": 2370, "verse_number": "८-९१-४०", "content_sanskrit": "व्याश्रयन्त द्विधा भिन्नाः सर्वे लोकास्तु मारिष।\nदेवदानवगन्धर्वाः पिशाचोरगराक्षसाः।\nप्रतिपक्षग्रहं चक्रुः कर्णार्जुनसमागमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2064526, "chapter_id": 2370, "verse_number": "८-९१-४१", "content_sanskrit": "द्यौरासीत्कर्णपक्षेऽत्र सनक्षत्रा विशाम्पते।\nभूर्विशाला पार्थमाता पुत्रस्य जयकाङ्क्षिणी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2064527, "chapter_id": 2370, "verse_number": "८-९१-४२", "content_sanskrit": "सागराश्चैव गिरयः सरितश्च नरोत्तम।\nमहीजा जलजाश्चैव व्याश्रयन्त किरीटिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2064528, "chapter_id": 2370, "verse_number": "८-९१-४३", "content_sanskrit": "असुरा यातुधानाश्च गुह्यकाश्च परन्तप।\nकर्णः समभवद्यत्र खेचराणि वयांसि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2064529, "chapter_id": 2370, "verse_number": "८-९१-४४", "content_sanskrit": "रत्नानि निधयः सर्वे वेदाश्चाख्यानपञ्चमाः।\nसोपवेदोपनिषदो व्याश्रयन्त किरीटिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2064530, "chapter_id": 2370, "verse_number": "८-९१-४५", "content_sanskrit": "वासुकिश्चित्रसेनश्च तक्षकश्चोपतक्षकः।\nमहीवियज्जलचराः काद्रवेयाश्च सान्वयाः।\nविषवन्तो महानागा वेगिनश्चार्जुनेऽभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2064531, "chapter_id": 2370, "verse_number": "८-९१-४६", "content_sanskrit": "ऐरावताः सौरभेया वैशालेयाश्च भोगिनः।\nएतेऽभवन्नर्जुनस्य पापाः सर्पाश्च कर्णतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2064532, "chapter_id": 2370, "verse_number": "८-९१-४७", "content_sanskrit": "ईहामृगा व्यालमृगा मङ्गला मृगपक्षिणः।\nमङ्गलाः पशवश्चैव सिंहव्याघ्रास्तथैव च।\nपार्थस्य विजये राजन्सर्व एव समाश्रिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2064533, "chapter_id": 2370, "verse_number": "८-९१-४८", "content_sanskrit": "वसवो मरुतः साध्या रुद्रा देवाश्विनावपि।\nअग्नी रुद्रश्च सोमश्च पन्नगाश्च दिशो दश।\nकर्णतः समपद्यन्त श्वसृगालवयांसि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2064534, "chapter_id": 2370, "verse_number": "८-९१-४९", "content_sanskrit": "वसवश्च महेन्द्रेण मरुतश्च सहाग्निना।\nधनञ्जयस्य ते वर्गा आदित्याः कर्णतोऽभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2064535, "chapter_id": 2370, "verse_number": "८-९१-५०", "content_sanskrit": "देवताः पितृभिः सार्धमृषिभिश्च परन्तप।\nतुम्बुरुप्रमुखाः सर्वे गन्धर्वा भरतर्षभ।\nयमौ वैश्रवणश्चैव वरुणश्च यतोऽर्जुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2064536, "chapter_id": 2370, "verse_number": "८-९१-५१", "content_sanskrit": "देवर्षिब्रह्मर्षिगणाः सर्वे च खचराश्च ये\nप्रालेयाः सहमौनेयाः शुभाश्चाप्सरसां गणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2064537, "chapter_id": 2370, "verse_number": "८-९१-५२", "content_sanskrit": "सहाप्सरोभिः शुभ्राभिर्देवदूताश्च गुह्यकाः।\nकिरीटिनं संश्रिताः स्म पुण्यगन्धा मनोरमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2064538, "chapter_id": 2370, "verse_number": "८-९१-५३", "content_sanskrit": "अमनोज्ञाश्च ये गन्धास्ते सर्वे कर्णमाश्रिताः।\nविपरीतान्यनिष्टानि भवन्ति विनशिष्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2064539, "chapter_id": 2370, "verse_number": "८-९१-५४", "content_sanskrit": "ये त्वन्तकाले पुरुषं विपरीतमुपाश्रितम्।\nप्रविशन्ति नरं क्षिप्रं मृत्युकालेऽभ्युपागते।\nते भावाः सहिताः कर्णं प्रविष्टाः सूतनन्दनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2064540, "chapter_id": 2370, "verse_number": "८-९१-५५", "content_sanskrit": "ओजस्तेजश्च सिद्धिश्च प्रहर्षः सत्यविक्रमौ।\nमनस्तुष्टिर्जयश्चापि तथाऽऽनन्दो नृपोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2064541, "chapter_id": 2370, "verse_number": "८-९१-५६", "content_sanskrit": "ईदृशार्नि नरव्याघ् तस्मिन्सङ्ग्रामसागरे।\nनिमित्तानि च शुभ्राणि विविशुर्जिष्णुमाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2064542, "chapter_id": 2370, "verse_number": "८-९१-५७", "content_sanskrit": "ऋषयो ब्राह्मणैः सार्धमभजन्त किरीटिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2064543, "chapter_id": 2370, "verse_number": "८-९१-५८", "content_sanskrit": "ततो देवगणैः सार्धं सिद्धाश्च सह चारणैः।\nद्विधा भूता महाराज व्याश्रयन्त नरोत्तमौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2064544, "chapter_id": 2370, "verse_number": "८-९१-५९", "content_sanskrit": "विमानानि विचित्राणि गुणवन्ति च सर्वशः।\nसमारुह्य समाजग्मुर्द्वैरथं कर्णपार्थयोः।\nअन्तरिक्षे महाराज देवगन्धर्वराक्षसाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2064545, "chapter_id": 2370, "verse_number": "८-९१-६०", "content_sanskrit": "एवं सर्वेषु भूतेषु द्विधा भूतेषु भारत।\nआशंसमानेषु जयं राधेयस्यार्जुनस्य च।\nविमानायुतसम्बाधमाकाशमभवत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2064546, "chapter_id": 2370, "verse_number": "८-९१-६१", "content_sanskrit": "ईहामृगव्यालमृगैर्दिपाश्वरथपङ्क्तिभिः।\nऊह्यमानाः परे मेघैर्वायुना च मनीषिणः।\nदिदृक्षवः समाजग्मुः कर्णार्जुनसमागमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2064547, "chapter_id": 2370, "verse_number": "८-९१-६२", "content_sanskrit": "देवदानवगन्धर्वा नागयक्षपतत्रिणः।\nमहर्षयो देवगणाः पितरश्च स्वधाभुजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2064548, "chapter_id": 2370, "verse_number": "८-९१-६३", "content_sanskrit": "तपोविद्यौषधीसिदधा नानारूपाम्बरत्विषः।\nअन्तरिक्षे महाराज विवदन्तोऽवतस्थिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2064549, "chapter_id": 2370, "verse_number": "८-९१-६४", "content_sanskrit": "ब्रह्मा ब्रह्मर्षिभिः सार्धं प्रजापतिभिरेव च।\nआस्थितो यानमाकाशे दिव्यं तेजः समागताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2064550, "chapter_id": 2370, "verse_number": "८-९१-६५", "content_sanskrit": "ततः प्रजापतिस्तूर्णमाजगाम महामते।\nद्वैरथं युधि तं द्रुष्टं कर्णपाण्डवयोस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2064551, "chapter_id": 2370, "verse_number": "८-९१-६६", "content_sanskrit": "विजित्य कर्णः स्विदिमां वसुन्धरा--\nमथार्जुनः स्वित्प्रतिपद्यतेऽखिलाम्।\nइतीश्वरस्यापि बभूव संशयः\nप्रजापतेः प्रेक्ष्य तयोर्महद्बलम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2064552, "chapter_id": 2370, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि सप्तदशदिवसयुद्धे एकनवतितमोऽध्यायः॥ ९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}]