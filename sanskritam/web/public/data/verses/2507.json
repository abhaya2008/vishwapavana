[{"id": 2071403, "chapter_id": 2507, "verse_number": "१२-१२-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2071404, "chapter_id": 2507, "verse_number": "१२-१२-१", "content_sanskrit": "अर्जुनस्य वचः श्रुत्वा नकुलो वाक्यमब्रवीत्।\nराजानमभिसंप्रेक्ष्य सर्वधर्मभृतां वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2071405, "chapter_id": 2507, "verse_number": "१२-१२-२", "content_sanskrit": "अनुरुध्य महाप्राज्ञो भ्रातुश्चित्तमरिंदम।\nव्यूढोरस्को महाबाहुस्ताम्रास्यो मितभाषिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2071406, "chapter_id": 2507, "verse_number": "१२-१२-३x", "content_sanskrit": "नकुल उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2071407, "chapter_id": 2507, "verse_number": "१२-१२-३", "content_sanskrit": "विशाखयूपे देवानां सर्वेषामग्नयश्चिताः।\nतस्माद्विद्वि महाराज देवाः कर्मफले स्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2071408, "chapter_id": 2507, "verse_number": "१२-१२-४", "content_sanskrit": "अनास्तिकानां भूतानां प्राणदाः पितरश्च ये।\nतेऽपि कर्मैव कुर्वन्ति विधिं पश्यस्व पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2071409, "chapter_id": 2507, "verse_number": "१२-१२-५", "content_sanskrit": "वेदवादापविद्धास्तु तान्विद्धि भृशनास्तिकान्।\nन हि वेदोक्तमुत्सृज्य विप्रः सर्वेषु कर्मसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2071410, "chapter_id": 2507, "verse_number": "१२-१२-६", "content_sanskrit": "देवयानेन नाकस्य पृष्ठमाप्नोति भारत।\nअत्याश्रमानयं सर्वानित्याहुर्वेदमिश्चयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2071411, "chapter_id": 2507, "verse_number": "१२-१२-७", "content_sanskrit": "ब्राह्मणाः श्रुतिसंपन्नास्तान्निबोध नराधिप।\nवित्तानि धर्मलब्धानि क्रतुमुख्येष्ववासृजन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2071412, "chapter_id": 2507, "verse_number": "१२-१२-८", "content_sanskrit": "कृतात्मा स महाराज स वै त्यागी स्मृतो नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2071413, "chapter_id": 2507, "verse_number": "१२-१२-९", "content_sanskrit": "अनवेक्ष्य सुखादानं तथैवोर्ध्वं प्रतिष्ठितः।\nआत्मत्यागी महाराज स त्यागी तापसो मतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2071414, "chapter_id": 2507, "verse_number": "१२-१२-१०", "content_sanskrit": "अनिकेतः परिपतन्वृक्षमूलाश्रयो मुनिः।\nअयाचकः सदायोगी स त्यागी पार्थ भिक्षुकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2071415, "chapter_id": 2507, "verse_number": "१२-१२-११", "content_sanskrit": "क्रोधहर्षावनादृत्य पैशुन्यं च विशेषतः।\nविप्रो वेदानधीते यः स त्यागी गुरुपूजकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2071416, "chapter_id": 2507, "verse_number": "१२-१२-१२", "content_sanskrit": "आश्रमांस्तुलया सर्वान्धृतानाहुर्मनीषिणः।\nएकतश्च त्रयो राजन्गृहस्थाश्रम एकतः॥ १२-१२-१३aसमीक्ष्य तुलया पार्थ कामं स्वर्गं च भारत।\nअयं पन्था महर्षीणाप्रियं लोकविदां गतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2071417, "chapter_id": 2507, "verse_number": "१२-१२-१४", "content_sanskrit": "इति यः कुरुते भावं स त्यागी भरतर्षभ।\nनरः परित्यज्य गृहान्वनमेति विमूढवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2071418, "chapter_id": 2507, "verse_number": "१२-१२-१५", "content_sanskrit": "यदा कामान्समीक्षेत धर्मवैतंसिको नरः।\nअथैनं मृत्युपाशेन कण्ठे बध्नाति सृत्युराट्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2071419, "chapter_id": 2507, "verse_number": "१२-१२-१६", "content_sanskrit": "अभिमानकृतं कर्म नैतत्फलवदुच्यते।\nत्यागयुक्तं महाराज सर्वमेव महाफलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2071420, "chapter_id": 2507, "verse_number": "१२-१२-१७", "content_sanskrit": "शमो दमस्तथा धैर्यं सत्यं शौचमथार्जवम्।\nयज्ञो धृतिश्च धर्मश्च नित्यमार्षो विधिः स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2071421, "chapter_id": 2507, "verse_number": "१२-१२-१८", "content_sanskrit": "पितृदेवातिथिकृते समारम्भोऽत्र शस्यते।\nअत्रैव हि महाराज त्रिवर्गः केवलं फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2071422, "chapter_id": 2507, "verse_number": "१२-१२-१९", "content_sanskrit": "एतस्मिन्वर्तमानस्य विधौ विप्रनिषेविते।\nत्यागिनः प्रसृतस्येह नोच्छित्तिर्विद्यते क्वचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2071423, "chapter_id": 2507, "verse_number": "१२-१२-२०", "content_sanskrit": "असृजद्धि प्रजा राजन्प्रजापतिरकल्मषः।\nमां यक्ष्यन्तीति धर्मात्मा यज्ञैर्विविधदक्षिणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2071424, "chapter_id": 2507, "verse_number": "१२-१२-२१", "content_sanskrit": "वीरुधश्चैव वृक्षांश्च यज्ञार्थं वै तथौषधीः।\nपशूंश्चैव तथा मेध्यान्यज्ञार्थानि हवींषि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2071425, "chapter_id": 2507, "verse_number": "१२-१२-२२", "content_sanskrit": "गृहस्थाश्रमिणस्तच्च यज्ञकर्माविरोधितम्।\nतस्माद्गार्हस्थ्यमेवेह दुष्करं दुर्लभं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2071426, "chapter_id": 2507, "verse_number": "१२-१२-२३", "content_sanskrit": "तत्संप्राप्य गृहस्था ये पशुधान्यधनान्विताः।\nन यजन्ते महाराज शाश्वतं तेषु किल्विषम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2071427, "chapter_id": 2507, "verse_number": "१२-१२-२४", "content_sanskrit": "स्वाध्याययज्ञा ऋषयो ज्ञानयज्ञास्तथा परे।\nअथापरे महायज्ञान्मनस्येव वितन्वते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2071428, "chapter_id": 2507, "verse_number": "१२-१२-२५", "content_sanskrit": "`इदमन्यन्महाराज विद्वद्भिः कथितं मम।\nभूमिरग्निश्च वायुश्च न चापो न दिवाकरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2071429, "chapter_id": 2507, "verse_number": "१२-१२-२६", "content_sanskrit": "नक्षत्राणि न चन्द्रश्च न दिशः काल एव च।\nशब्दः स्पर्शश्च रूपं च न गन्धो न रसः क्वचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2071430, "chapter_id": 2507, "verse_number": "१२-१२-२७", "content_sanskrit": "न च सन्ति प्रमाणानि यैः प्रमेयं प्रसाध्यते।\nप्रत्यक्षमनुमानं न नोपमानमथागमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2071431, "chapter_id": 2507, "verse_number": "१२-१२-२८", "content_sanskrit": "नार्थापत्तिर्न चैतिह्यं न दृष्टान्तो न संशयः।\nन क्वचिन्निर्णयो राजन्न धर्माधर्म एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2071432, "chapter_id": 2507, "verse_number": "१२-१२-२९", "content_sanskrit": "तिर्यक्व स्थावरं चैव न देवा न च मानुषाः।\nवर्णाश्रमविभागाश्च न च कर्ता न कामकृत्।\nन चार्थश्च विभूतिश्च न चार्थस्य विचेष्टितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2071433, "chapter_id": 2507, "verse_number": "१२-१२-३०", "content_sanskrit": "तमोभूतमिदं सर्वमनालोकं जगन्नृप।\nन चात्मा विद्यमानोपि मनसा योगमिच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2071434, "chapter_id": 2507, "verse_number": "१२-१२-३१", "content_sanskrit": "अचेतनं मनस्त्वासीदात्मा एव सचेतनः।\nईश्वरश्चेतनस्त्वेकस्तेनेदं गहनीकृतम्।\nमन्त्राश्च चेतना राजन्न च देहेन योजिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2071435, "chapter_id": 2507, "verse_number": "१२-१२-३२", "content_sanskrit": "तेन विश्वसृजो नाम ऋषयो मन्त्रदेवताः।\nचैतन्यमीश्वरात्प्राप्य ब्रह्माण्डं तैर्विनिर्मितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2071436, "chapter_id": 2507, "verse_number": "१२-१२-३३", "content_sanskrit": "इष्ट्वा विश्वसृजं यज्ञं निर्मितः प्रपितामहः।\nसृष्टिस्तेन समारब्धा प्रसादादीश्वरस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2071437, "chapter_id": 2507, "verse_number": "१२-१२-३४", "content_sanskrit": "चैतन्यमीश्वरस्येदं सचेतनमिदं जगत्।\nयोगेन च समाविष्टं जगत्कृत्स्नं च शंभुना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2071438, "chapter_id": 2507, "verse_number": "१२-१२-३५", "content_sanskrit": "धर्मश्चार्थश्च कामश्च उक्तो मोक्षश्च संक्षये।\nब्रह्मणः परमेशस्य ईश्वरेण यदृच्छया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2071439, "chapter_id": 2507, "verse_number": "१२-१२-३६", "content_sanskrit": "अज्ञो जन्तुरनीशश्च भाजनं सुखदुःखयोः।\nईश्वरप्रेरितो गच्छेत्स्वर्गं वा श्वभ्रमेव वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2071440, "chapter_id": 2507, "verse_number": "१२-१२-३७", "content_sanskrit": "प्रधानं पुरुषः चैव आत्मानं सर्वदेहिनाम्।\nमनसा विषयैश्चैव चेतनेन प्रचोदिताः।\nसुखदुःखेन युज्यन्ते कर्मभिश्च प्रचोदिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2071441, "chapter_id": 2507, "verse_number": "१२-१२-३८", "content_sanskrit": "वर्णाश्रमविभागाश्च ईश्वरेण प्रवर्तिताः।\nसदेवासुरगन्धर्वं येनेदं निर्मितं जगत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2071442, "chapter_id": 2507, "verse_number": "१२-१२-३९", "content_sanskrit": "त्वं चान्ये च महाराज ईश्वरस्य वशे स्थिताः।\nजीवन्ते च म्रियन्ते च न स्वतन्त्राः कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2071443, "chapter_id": 2507, "verse_number": "१२-१२-४०", "content_sanskrit": "हित्वाहित्वा च भूतानि हत्वा सर्वमिदं जगत्।\nयजन्ते कर्मणा देवा न स पापेन लिप्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2071444, "chapter_id": 2507, "verse_number": "१२-१२-४१", "content_sanskrit": "हिंसात्मकानि कर्माणि सर्वेषां गृहमेधिनाम्।\nदेवतानामृषीणां च ते च यान्ति परां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2071445, "chapter_id": 2507, "verse_number": "१२-१२-४२", "content_sanskrit": "पातिताः शत्रवः पूर्व सर्वत्र वसुधाधिपैः।\nप्रजानां हितकामैश्च आत्मनश्च हितैषिभिः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2071446, "chapter_id": 2507, "verse_number": "१२-१२-४३", "content_sanskrit": "यदि तत्र भवेत्पापं कथं ते स्वर्गमास्थिताः।\nन प्राप्ता नरकं राजन्वेष्टिताः पापकर्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2071447, "chapter_id": 2507, "verse_number": "१२-१२-४४", "content_sanskrit": "एवं मनःसमाधानं मार्गमातिष्ठतो नृप।\nद्विजातेर्ब्रह्मभूतस्य स्पृहयन्ति दिवौकसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2071448, "chapter_id": 2507, "verse_number": "१२-१२-४५", "content_sanskrit": "स रत्नानि विचित्राणि संहृतानि ततस्ततः।\nमखेष्वनभिसन्त्यज्य नास्तिक्यमभिजल्पसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2071449, "chapter_id": 2507, "verse_number": "१२-१२-४६", "content_sanskrit": "कुटुम्बमास्थिते त्यागं न पश्यामि नराधिप।\nराजसूयाश्वमेधेषु सर्वमेधेषु वा पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2071450, "chapter_id": 2507, "verse_number": "१२-१२-४७", "content_sanskrit": "ये चान्ये क्रतवस्तात ब्राह्मणैरभिपूजिताः।\nतैर्यजस्व महीपाल शक्रो देवपतिर्यथा।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2071451, "chapter_id": 2507, "verse_number": "१२-१२-४८", "content_sanskrit": "राज्ञः प्रमाददोषेण दस्युभिः परिमुष्यताम्।\nअशरण्यः प्रजानां यः स राजा कलिरुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2071452, "chapter_id": 2507, "verse_number": "१२-१२-४९", "content_sanskrit": "अश्वान्गाश्चैव दासीश्च करेणूश्च स्वलंकृताः।\nग्रामाञ्जनपदांश्चैव क्षेत्राणि च गृहाणि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2071453, "chapter_id": 2507, "verse_number": "१२-१२-५०", "content_sanskrit": "अप्रदाय द्विजातिभ्यो मात्सर्याविष्टचेतसः।\nवयं ते राजकलयो भविष्याम विशांपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2071454, "chapter_id": 2507, "verse_number": "१२-१२-५१", "content_sanskrit": "अदातारोऽशरण्याश्च राजकिल्विषभागिनः।\nदुःखानामेव भोक्तारो न सुखानां कदाचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2071455, "chapter_id": 2507, "verse_number": "१२-१२-५२", "content_sanskrit": "अनिष्ट्वा च महायज्ञैरकृत्वा च पितृस्वधाम्।\nतीर्थेष्वनभिसंप्लुत्य प्रव्रजिष्यसि चेत्प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2071456, "chapter_id": 2507, "verse_number": "१२-१२-५३", "content_sanskrit": "छिन्नाभ्रमिव गन्तासि विलयं मारुतेरितम्।\nलोकयोरुभयोर्भ्रष्टो ह्यन्तराले व्यवस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2071457, "chapter_id": 2507, "verse_number": "१२-१२-५४", "content_sanskrit": "अन्तर्बहिश्च यत्किंचिन्मनोव्यासङ्गकारकम्।\nपरित्यज्य भवेत्त्यागी न हित्वा प्रतितिष्ठति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2071458, "chapter_id": 2507, "verse_number": "१२-१२-५५", "content_sanskrit": "एतस्मिन्वर्तमानस्य विधौ विप्रनिषेविते।\nब्राह्मणस्य महाराज नोच्छित्तिर्विद्यते क्वचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2071459, "chapter_id": 2507, "verse_number": "१२-१२-५६", "content_sanskrit": "निहत्य शत्रूंस्तरसा समृद्धाञ्शक्रो यथा दैत्यबलानि सङ्ख्ये।\nकः पार्थ शोचेन्निरतः स्वधर्मे पूर्वैः स्मृते पार्थिवशिष्टजुष्टे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2071460, "chapter_id": 2507, "verse_number": "१२-१२-५७", "content_sanskrit": "क्षात्रेण धर्मेण पराक्रमेण जित्वा महीं मन्त्रविद्भ्यः प्रदाय।\nनाकस्य पृष्ठेऽसि नरेन्द्र गन्ता न शोचितव्यं भवताऽद्य पार्थ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2071461, "chapter_id": 2507, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि द्वादशोऽध्यायः॥ १२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]