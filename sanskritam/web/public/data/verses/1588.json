[{"id": 2027328, "chapter_id": 1588, "verse_number": "३-२२६-०x", "content_sanskrit": "कन्योवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2027329, "chapter_id": 1588, "verse_number": "३-२२६-१", "content_sanskrit": "अहं प्रजापतेः कन्या देवसेनेति वुश्रुता।\nभगिनी मे दैत्यसेना सा पूर्वं कोशिना हृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2027330, "chapter_id": 1588, "verse_number": "३-२२६-२", "content_sanskrit": "सहैवावां भगिन्यौ तु सखीभिः सह मानसम्।\nआगच्छावो विहारार्थमनुज्ञाप्य प्रजापतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2027331, "chapter_id": 1588, "verse_number": "३-२२६-३", "content_sanskrit": "नित्यं चावां प्रार्थयते हर्तुं केशी महासुरः।\nइच्छत्येनं दैत्यसेना न चाहं पाकशासन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2027332, "chapter_id": 1588, "verse_number": "३-२२६-४", "content_sanskrit": "सा हृताऽनेन भगवान्मुक्ताऽहं त्वद्बलेन तु।\nत्वया देवेन्द्र निर्दिष्टं पतिमिच्छामि दुर्जयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2027333, "chapter_id": 1588, "verse_number": "३-२२६-५x", "content_sanskrit": "इन्द्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2027334, "chapter_id": 1588, "verse_number": "३-२२६-५", "content_sanskrit": "मम मातृष्वसेयी त्वं माता दाक्षायणी मम।\nआख्यातुं त्वहमिच्छामि स्वयमात्मबलं त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2027335, "chapter_id": 1588, "verse_number": "३-२२६-६x", "content_sanskrit": "कन्योवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2027336, "chapter_id": 1588, "verse_number": "३-२२६-६", "content_sanskrit": "अबलाऽहं महाबाहो पतिस्तु बलवान्मम।\nवरदानात्पितुर्भावी सुरासुरनमस्कृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2027337, "chapter_id": 1588, "verse_number": "३-२२६-७x", "content_sanskrit": "इन्द्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2027338, "chapter_id": 1588, "verse_number": "३-२२६-७", "content_sanskrit": "कीदृशं तु बलंदेवि पत्युस्तव भविष्यति।\nएतदिच्छाम्यहं श्रोतुं तव वाक्यमनिन्दिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2027339, "chapter_id": 1588, "verse_number": "३-२२६-८x", "content_sanskrit": "कन्योवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2027340, "chapter_id": 1588, "verse_number": "३-२२६-८", "content_sanskrit": "देवदानवयक्षाणां किन्नरोरगरक्षसाम्।\nजेता यो दुष्टदैत्यानां महावीर्यो महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2027341, "chapter_id": 1588, "verse_number": "३-२२६-९", "content_sanskrit": "यस्तु सर्वाणि भूतानि त्वया सह विजेष्यति।\nस हि मे भविता भर्ता ब्रह्मण्यः कीर्तिवर्धनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2027342, "chapter_id": 1588, "verse_number": "३-२२६-१०x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2027343, "chapter_id": 1588, "verse_number": "३-२२६-१०", "content_sanskrit": "इन्द्रस्तस्या वचः श्रुत्वा दुःखितोऽचिन्तयद्भृशम्।\nअस्या देव्याः पतिर्नास्ति यादृशं संप्रभाषते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2027344, "chapter_id": 1588, "verse_number": "३-२२६-११", "content_sanskrit": "अथापश्यत्स उदये भास्करं भास्करद्युतिः।\nसोमं चैव महाभागं प्रविशन्तं दिवाकरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2027345, "chapter_id": 1588, "verse_number": "३-२२६-१२", "content_sanskrit": "अमावास्यां प्रवृत्तायां मुहूर्ते रौद्र एव तु।\nदेवासुरं च संग्रामं सोऽपश्यदुदये गिरौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2027346, "chapter_id": 1588, "verse_number": "३-२२६-१३", "content_sanskrit": "लोहितैश्च घनैर्युक्तां पूर्वां संध्यां शतक्रतुः।\nअपश्यल्लोहितोदं च मघवान्वरुणालयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2027347, "chapter_id": 1588, "verse_number": "३-२२६-१४", "content_sanskrit": "भृगुभिश्चाङ्गिरोभ्यश्च हुतं मन्त्रैः पृथग्विधैः।\nहव्यं गृहीत्वा वह्निं च प्रविशन्तं दिवाकरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2027348, "chapter_id": 1588, "verse_number": "३-२२६-१५", "content_sanskrit": "पर्व चैव चतुर्विंशं तदा सूर्यमुपस्थितम्।\nतथा सूर्यं वह्निगतं सोमं सूर्यगतं च तम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2027349, "chapter_id": 1588, "verse_number": "३-२२६-१६", "content_sanskrit": "समालोक्यैकतामेव शशिनो भास्करस्य च।\nसमवायं तु तं रौद्रं दृष्ट्वा शक्रोऽन्वचिन्तयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2027350, "chapter_id": 1588, "verse_number": "३-२२६-१७", "content_sanskrit": "सूर्याचन्द्रमसोर्घोरं दृश्यते परिवेषणम्।\nएतस्मिन्नेव रात्र्यन्ते महद्युद्धं तु शंसति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2027351, "chapter_id": 1588, "verse_number": "३-२२६-१८", "content_sanskrit": "सरित्सिन्धुरपीयं तु प्रत्यसृग्वाहिनी भृशम्।\nशृगालिनयग्निवक्रा च प्रत्यादित्यं विराविणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2027352, "chapter_id": 1588, "verse_number": "३-२२६-१९", "content_sanskrit": "एष रौद्रश्चसंघातो महान्युक्तश्च तेजसा।\nसोमस्य वह्निसूर्याभ्यामद्भुतोऽयं समागमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2027353, "chapter_id": 1588, "verse_number": "३-२२६-२०", "content_sanskrit": "जनयेद्यं सुतं सोमः सोऽस्या देव्याः पतिर्भवेत्।\nअथानेकैर्गुणैश्चाग्निरग्निः सर्वाश्च देवताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2027354, "chapter_id": 1588, "verse_number": "३-२२६-२१", "content_sanskrit": "एष चेञ्जनयेद्गर्भं सोऽस्या देव्याः पतिर्भवेत्।\nएवं संचिन्त्य भगवान्ब्रह्मलोकं तदा गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2027355, "chapter_id": 1588, "verse_number": "३-२२६-२२", "content_sanskrit": "गृहीत्वा देवसेनां तां ववन्दे स पितामहम्।\nउवाच चास्या देव्यास्त्वं साधु शूरं पतिं दिशा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2027356, "chapter_id": 1588, "verse_number": "३-२२६-२३x", "content_sanskrit": "ब्रह्मोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2027357, "chapter_id": 1588, "verse_number": "३-२२६-२३", "content_sanskrit": "यथैतच्चिन्तितंकार्यं त्वया दानवसूदन।\nतथा स भविता गर्भो बलवानुरुविक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2027358, "chapter_id": 1588, "verse_number": "३-२२६-२४", "content_sanskrit": "स विष्यति सेनानीस्त्वया सह शतक्रतो।\nअस्या देव्याः पतिश्चैव स भविष्यति वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2027359, "chapter_id": 1588, "verse_number": "३-२२६-२५", "content_sanskrit": "एतच्छ्रुत्वा नमस्तस्मै कृत्वाऽसौ मह कन्यया।\nतत्राभ्यगच्छद्देवेन्द्रो यत्र सप्तर्षयोऽभवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2027360, "chapter_id": 1588, "verse_number": "३-२२६-२६", "content_sanskrit": "वसिष्ठप्रमुखा मुख्या विप्रेन्द्राः सुमहाप्रभाः।\nभागार्थं तपसोपात्तं तेषां सोमं तथाऽध्वरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2027361, "chapter_id": 1588, "verse_number": "३-२२६-२७", "content_sanskrit": "पिपासवो ययुर्देवाः शतक्रतुपुरोगमाः।\nइष्टिं कृत्वयतान्यायं सुसमिद्धे हुताशने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2027362, "chapter_id": 1588, "verse_number": "३-२२६-२८", "content_sanskrit": "जुहुवुस्ते महात्मानो हव्यं सर्वदिवौकसाम्।\nसमाहूतो हुतवहःसोऽद्भुतः सूर्यमण्डलात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2027363, "chapter_id": 1588, "verse_number": "३-२२६-२९", "content_sanskrit": "विनिःसृत्य ययौ वह्निः पार्श्वतो विधिवत्प्रभुः।\nआगम्याहवनीयं वै तैर्द्विजैर्मन्त्रतो हुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2027364, "chapter_id": 1588, "verse_number": "३-२२६-३०", "content_sanskrit": "सतत्र विविधं हव्यं प्रतिगृह्यहुताशनः।\nऋषिभ्यो भरतश्रेष्ठ प्रायच्छत दिवौकसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2027365, "chapter_id": 1588, "verse_number": "३-२२६-३१", "content_sanskrit": "निष्क्रामंश्चाप्यपश्यत्स पत्नीस्तेषां महात्मनाम्।\nस्वेष्वासतेषूपविष्टाः स्नायन्तीश्च यथासुस्वम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2027366, "chapter_id": 1588, "verse_number": "३-२२६-३२", "content_sanskrit": "रुक्मवेदिनिभास्तास्तु चन्द्रलेखा इवामलाः।\nहुताशनार्चिःप्रतिमाः सर्वास्तारा इवाद्भुताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2027367, "chapter_id": 1588, "verse_number": "३-२२६-३३", "content_sanskrit": "स तत्रतेन मनसा बभूव क्षुभितेन्द्रियः।\nपत्नीर्दृष्ट्वा द्विजेन्द्राणां वह्निः कामवशं ययौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2027368, "chapter_id": 1588, "verse_number": "३-२२६-३४", "content_sanskrit": "भूयः संचिन्तयामास न न्याय्यं क्षुभितो ह्यहम्।\nसाध्व्यः पत्न्यो द्विजेन्द्राणामकामा कामयाम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2027369, "chapter_id": 1588, "verse_number": "३-२२६-३५", "content_sanskrit": "नैताः शक्या मया द्रष्टुं स्प्रष्टुं वाऽप्यनिमित्ततः।\nगार्हपत्यं समाविश्य तस्मात्पश्याम्यभीक्ष्णशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2027370, "chapter_id": 1588, "verse_number": "३-२२६-३६x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2027371, "chapter_id": 1588, "verse_number": "३-२२६-३६", "content_sanskrit": "संस्पृशन्निव सर्वास्ताः शिखाभिः काञ्चनप्रभाः।\nपश्यमानश्च मुमुदे गार्हपत्यं समाश्रितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2027372, "chapter_id": 1588, "verse_number": "३-२२६-३७", "content_sanskrit": "निरुध्य तत्रसुचिरमेवं वह्निर्वनं गतः।\nमनस्तासु विनिक्षिप्य कामयानो वराङ्गनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2027373, "chapter_id": 1588, "verse_number": "३-२२६-३८", "content_sanskrit": "कामसंतप्तहृदयो देहत्यागे विनिश्चितः।\nअलाभे ब्राह्मणस्त्रीणामग्निर्वनमुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2027374, "chapter_id": 1588, "verse_number": "३-२२६-३९", "content_sanskrit": "स्वाहा तं दक्षदुहिता प्रथमाऽकामयत्तदा।\nसा तस्य च्छिद्रमन्वैच्छच्चिरात्प्रभृतिभामिनी।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2027375, "chapter_id": 1588, "verse_number": "३-२२६-४०", "content_sanskrit": "सा तं ज्ञात्वा यथावत्तु वर्हिं वनमुपागतम्।\nतत्त्वतः कामसंतप्तं चिन्तयामास भामिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2027376, "chapter_id": 1588, "verse_number": "३-२२६-४१", "content_sanskrit": "अहं सप्तर्षिपत्नीनां कृत्वा रूपाणि पावकम्।\nकामयिष्यामि कामार्तं तासां रूपेण मोहितम्।\nएवं कृते प्रीतिरस् कामावाप्तिश्च मे भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2027377, "chapter_id": 1588, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि मार्कण्डेयसमास्यापर्वणि षङ्घिंशत्यधिकद्विशततमोऽध्यायः ॥ २२६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]