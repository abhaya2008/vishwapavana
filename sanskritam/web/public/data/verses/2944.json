[{"id": 2091409, "chapter_id": 2944, "verse_number": "१३-७४-१", "content_sanskrit": "युधिष्ठिर उवाच।\nइमे वै मानवा लोके स्त्रीषु सज्जन्त्यभीक्ष्णशः।\nमोहेन परमाविष्टा देवदृष्टेन कर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2091410, "chapter_id": 2944, "verse_number": "१३-७४-२", "content_sanskrit": "स्त्रियश्च पुरुषेष्वेव प्रत्यक्षं लोकसाक्षिकम्।\nअत्र मे संशयस्तीव्रो हृदि सम्परिवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2091411, "chapter_id": 2944, "verse_number": "१३-७४-३", "content_sanskrit": "कथमासां नराः सङ्गं कुर्वते कुरुनन्दनः।\nस्त्रियो वातेषु रज्यन्ते विरज्यन्ते च ताः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2091412, "chapter_id": 2944, "verse_number": "१३-७४-४", "content_sanskrit": "इति ताः पुरुषव्याघ्र कथं शक्यास्तु रक्षितुम्।\nप्रमदाः पुरुषेणेह तन्मे व्याख्यातुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2091413, "chapter_id": 2944, "verse_number": "१३-७४-५x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2091414, "chapter_id": 2944, "verse_number": "१३-७४-५", "content_sanskrit": "एत्वा हि स्वीयमायाभिर्वञ्चयन्तीह मानवान्।\nन चासां मुच्यते कश्चित्पुरुषो हस्तमागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2091415, "chapter_id": 2944, "verse_number": "१३-७४-६", "content_sanskrit": "गावो नवतृणानीव गृह्णन्त्येता नवन्नवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2091416, "chapter_id": 2944, "verse_number": "१३-७४-७", "content_sanskrit": "शम्बरस्य च या माया माया या नमुचेरपि।\nबलेः कुम्भीनसेश्चैव सर्वास्तां योषितो विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2091417, "chapter_id": 2944, "verse_number": "१३-७४-८", "content_sanskrit": "हसन्तं प्रहसन्त्येता रुद्रन्तं प्ररुदन्ति च।\nअप्रियं प्रियवाक्यैश्च गृह्णते कालयोगतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2091418, "chapter_id": 2944, "verse_number": "१३-७४-९", "content_sanskrit": "`यदि जिह्वासहस्रं स्याज्जीवेच्च शरदां शतम्।\nअनन्यकर्मा स्त्रीदोषाननुक्त्वा निधनं व्रजेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2091419, "chapter_id": 2944, "verse_number": "१३-७४-१०", "content_sanskrit": "उशना वेद यच्छास्त्रं यच्च वेद बृहस्पतिः।\nस्त्री बुद्ध्या न विशिष्येत तास्तु रक्ष्याः कथं नरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2091420, "chapter_id": 2944, "verse_number": "१३-७४-११", "content_sanskrit": "अनृतं सत्यमित्याहुः सत्यं चापि तथाऽनृतम्।\nइति यास्ताः कथं वीर संरक्ष्याः पुरुषैरिह।\n`दोषास्पदेऽशुचौ देहे ह्यासां सक्तास्त्वहो नराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2091421, "chapter_id": 2944, "verse_number": "१३-७४-१२", "content_sanskrit": "स्त्रीणां बुद्ध्यर्थनिष्कर्षादर्थशास्त्राणि शत्रुहन्।\nबृहस्पतिप्रभृतिभिर्मन्ये सद्भिः कृतानि वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2091422, "chapter_id": 2944, "verse_number": "१३-७४-१३", "content_sanskrit": "संपूज्यमानाः पुरुषैर्विकुर्वन्ति मनो नृषु।\nअपास्ताश्च तथा राजन्विकुर्वन्ति मनः स्त्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2091423, "chapter_id": 2944, "verse_number": "१३-७४-१४", "content_sanskrit": "इमाः प्रजा महापाहो धार्मिक्य इति नः श्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2091424, "chapter_id": 2944, "verse_number": "१३-७४-१५", "content_sanskrit": "सत्कृतासत्कृताश्चापि विकुर्वन्ति मनः सदा।\nकस्ताः शक्तो रक्षितुं स्यादिति मे संशयो महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2091425, "chapter_id": 2944, "verse_number": "१३-७४-१६", "content_sanskrit": "तथा ब्रूहि महाभाग कुरूणां वंशवर्धन।\nयदि शक्या कुरुश्रेष्ठ रक्षा तासां कदाचन।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2091426, "chapter_id": 2944, "verse_number": "१३-७४-१७", "content_sanskrit": "कर्तुं वा कृतपूर्वं वा तन्मे व्याख्यातुमर्हसि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2091427, "chapter_id": 2944, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि चतुःसप्ततितमोऽध्यायः॥१३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]