[{"id": 2189219, "chapter_id": 5017, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2189220, "chapter_id": 5017, "verse_number": "१", "content_sanskrit": "प्रियः सर्वस्य लोकस्य सर्वसत्वाभिनन्दितः ।\nगुणैः सर्वैरुपेतश्च कोन्वसि भुवि मानवः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2189221, "chapter_id": 5017, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2189222, "chapter_id": 5017, "verse_number": "२", "content_sanskrit": "अत्र ते वर्तयिष्यामि पृच्छतो भरतर्षभ ।\nउग्रसेनस्य संवादं नारदे केशवस्य च\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2189223, "chapter_id": 5017, "verse_number": "", "content_sanskrit": "उग्रसेनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2189224, "chapter_id": 5017, "verse_number": "३", "content_sanskrit": "यस्य सङ्कल्पते लोको नारदस्य प्रकीर्तने ।\nमन्ये स गुणसम्पन्नो ब्रूहि तन्मम पृच्छतः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2189225, "chapter_id": 5017, "verse_number": "", "content_sanskrit": "वासुदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2189226, "chapter_id": 5017, "verse_number": "४", "content_sanskrit": "कुक्कुराधिप यान्मन्ये शृणु तान् मे विवक्षतः ।\nनारदस्य गुणान् साधून् सङ्क्षेपेण नराधिप\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2189227, "chapter_id": 5017, "verse_number": "५", "content_sanskrit": "न चारित्रनिमित्तोऽस्याहङ्कारो देहपातनः ।\nअभिन्नश्रुतचारित्रस्तस्मात् सर्वत्र पूजितः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2189228, "chapter_id": 5017, "verse_number": "६", "content_sanskrit": "अरतिः क्रोधचापल्ये भयं नैतानि नारदे ।\nअदीर्घसूत्रः शूरश्च तस्मात् सर्वत्र पूजितः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2189229, "chapter_id": 5017, "verse_number": "७", "content_sanskrit": "उपास्यो नारदो बाढं वाचि नास्य व्यतिक्रमः ।\nकामतो यदि वा लोभात् तस्मात् सर्वत्र पूजितः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2189230, "chapter_id": 5017, "verse_number": "८", "content_sanskrit": "अध्यात्मविधितत्त्वज्ञः क्षान्तः शक्तो जितेन्द्रियः ।\nऋजुश्च सत्यवादी च तस्मात् सर्वत्र पूजितः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2189231, "chapter_id": 5017, "verse_number": "९", "content_sanskrit": "तेजसा यशसा बुद्ध्या ज्ञानेन विनयेन च ।\nजन्मना तपसा वृद्धस्तस्मात् सर्वत्र पूजितः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2189232, "chapter_id": 5017, "verse_number": "१०", "content_sanskrit": "सुशीलः सुखसंवेशः सुभोजः स्वादरः शुचिः ।\nसुवाक्यश्चाप्यनीर्ष्यश्च तस्मात् सर्वत्र पूजितः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2189233, "chapter_id": 5017, "verse_number": "११", "content_sanskrit": "कल्याणं कुरुते बाढं पापमस्मिन्न विद्यते ।\nन प्रीयते परानर्थैस्तस्मात् सर्वत्र पूजितः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2189234, "chapter_id": 5017, "verse_number": "१२", "content_sanskrit": "वेदश्रुतिभिराख्यानैरर्थानभिजिगीषति ।\nतितिक्षुरनवज्ञश्च तस्मात् सर्वत्र पूजितः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2189235, "chapter_id": 5017, "verse_number": "१३", "content_sanskrit": "समत्वाच्च प्रियो नास्ति नाप्रियश्च कथञ्चन ।\nमनोऽनुकूलवादी च तस्मात् सर्वत्र पूजितः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2189236, "chapter_id": 5017, "verse_number": "१४", "content_sanskrit": "बहुश्रुतश्चित्रकथः पण्डितोऽनलसोऽशठः ।\nअदीनोऽक्रोधनोऽलुब्धस्तस्मात् सर्वत्र पूजितः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2189237, "chapter_id": 5017, "verse_number": "१५", "content_sanskrit": "नार्थे धने वा कामे वा भूतपूर्वोऽस्य विग्रहः ।\nदोषाश्चास्य समुच्छिन्नास्तस्मात् सर्वत्र पूजितः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2189238, "chapter_id": 5017, "verse_number": "१६", "content_sanskrit": "दृढभक्तिरनिन्द्यात्मा श्रुतवाननृशंसवान् ।\nवीतसम्मोहदोषश्च तस्मात् सर्वत्र पूजितः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2189239, "chapter_id": 5017, "verse_number": "१७", "content_sanskrit": "असक्तः सर्वसङ्गेषु सक्तात्मेव च लक्ष्यते ।\nअदीर्घसंशयो वाग्मी तस्मात् सर्वत्र पूजितः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2189240, "chapter_id": 5017, "verse_number": "१८", "content_sanskrit": "समाधिर्नास्य कामार्थे नात्मानं स्तौति कर्हिचित् ।\nअनीर्षुर्मृदुसंवादस्तस्मात् सर्वत्र पूजितः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2189241, "chapter_id": 5017, "verse_number": "१९", "content_sanskrit": "नाहङ्कारे मुक्तिरस्य चारित्रे बुद्धिरास्थिता ।\nवेदार्थविद् विभागेन यज्ञविद्योगवित् कविः ।\nभक्तिमान् स सदा विद्वांस्तस्मात् सर्वत्र पूजितः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2189242, "chapter_id": 5017, "verse_number": "२०", "content_sanskrit": "त्रिगुणं गुणभोक्तारं पञ्चयज्ञात्मकं तथा ।\nयथावत् स विजानाति तस्मात् सर्वत्र पूजितः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2189243, "chapter_id": 5017, "verse_number": "२१", "content_sanskrit": "लोकस्य विविधं चित्तं प्रेक्षते चाप्यकुत्सयन् ।\nसंसर्गविद्याकुशलस्तस्मात् सर्वत्र पूजितः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2189244, "chapter_id": 5017, "verse_number": "२२", "content_sanskrit": "नासूयत्यागमं कञ्चित् स्वनयेनोपजीवति ।\nअवन्ध्यकालोऽवश्यात्मा तस्मात् सर्वत्र पूजितः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2189245, "chapter_id": 5017, "verse_number": "२३", "content_sanskrit": "कृतश्रमः कृतप्रज्ञो न च तृप्तः समाधितः ।\nनित्ययुक्तोऽप्रमत्तश्च तस्मात् सर्वत्र पूजितः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2189246, "chapter_id": 5017, "verse_number": "२४", "content_sanskrit": "नापत्रपश्च युक्तश्च नियुक्तः श्रेयसे परैः ।\nअभेत्ता परगुह्यानां तस्मात् सर्वत्र पूजितः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2189247, "chapter_id": 5017, "verse_number": "२५", "content_sanskrit": "न हृष्यत्यर्थलाभेषु नालाभे तु व्यथत्यपि ।\nस्थिरबुद्धिरसक्तात्मा तस्मात् सर्वत्र पूजितः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2189248, "chapter_id": 5017, "verse_number": "२६", "content_sanskrit": "तं सर्वगुणसम्पन्नं दक्षं शुचिमनामयम् ।\nकालज्ञं च प्रियज्ञं च कः प्रियं न करिष्यति\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2189249, "chapter_id": 5017, "verse_number": "२७", "content_sanskrit": "इत्युक्तः सम्प्रशस्यैनमुग्रसेनो गतो गृहात् ।\nआस्ते कृष्णस्तथैकान्ते पर्यङ्के रत्नभूषिते\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2189250, "chapter_id": 5017, "verse_number": "२८", "content_sanskrit": "कदाचित् तत्र भगवान् प्रविवेश महामुनिः ।\nतमभ्यर्च्य यथान्यायं तूष्णीमास्ते जनार्दनः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2189251, "chapter_id": 5017, "verse_number": "२९", "content_sanskrit": "तं खिन्नमिव संलक्ष्य केशवं वाक्यमब्रवीत् ।\nकिमिदं केशव तव वैमनस्यं जनार्दन ।\nअभूतपूर्वं गोविन्द तन्मे व्याख्यातुमर्हसि\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2189252, "chapter_id": 5017, "verse_number": "", "content_sanskrit": "वासुदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2189253, "chapter_id": 5017, "verse_number": "३०", "content_sanskrit": "नासुहृत् परमं मेऽद्य नापदोऽर्हति वेदितुम् ।\nअपण्डितो वापि सुहृत् पण्डितो वाऽप्यनात्मवान् \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2189254, "chapter_id": 5017, "verse_number": "३१", "content_sanskrit": "स त्वं सुहृच्च विद्वांश्च जितात्मा श्रोतुमर्हसि ।\nअप्येतद् हृदि यद् दुःखं तद् भवान् श्रोतुमर्हति\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2189255, "chapter_id": 5017, "verse_number": "३२", "content_sanskrit": "दास्यमैश्वर्यवादेन ज्ञातीनां च करोम्यहम् ।\nद्विषन्ति सततं ऋद्धा ज्ञातिसम्बन्धिबान्धवाः\t॥ ३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2189256, "chapter_id": 5017, "verse_number": "३३", "content_sanskrit": "दिव्या अपि तथा भोगा दत्तास्तेषां यथा पृथक् ।\nतथाऽपि च द्विषन्तो मां वर्तन्ते च परस्परम् \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2189257, "chapter_id": 5017, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2189258, "chapter_id": 5017, "verse_number": "३४", "content_sanskrit": "अनायसेन शस्त्रेण परिमृज्यानुमृज्य च ।\nजिह्वामुद्धर चैतेषां न वक्ष्यन्ति ततः परम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2189259, "chapter_id": 5017, "verse_number": "", "content_sanskrit": "भगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2189260, "chapter_id": 5017, "verse_number": "३५", "content_sanskrit": "अनायसं कथं विन्द्यां शस्त्रं मुनिवरोत्तम ।\nयेनैषामुद्धरे जिह्वा ब्रूहि तन्मे यथातथम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2189261, "chapter_id": 5017, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2189262, "chapter_id": 5017, "verse_number": "३६", "content_sanskrit": "गोहिरण्यं च वासांसि रत्नाद्यं यद्धनं बहु ।\nआस्ये प्रक्षिप चैतेषां शस्त्रमेतदनायसम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2189263, "chapter_id": 5017, "verse_number": "३७", "content_sanskrit": "सुहृत्सम्बन्धिमित्राणां गुरूणां स्वजनस्य च ।\nआख्यातं शस्त्रमेतद्धि तेन च्छिन्धि पुनः पुनः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2189264, "chapter_id": 5017, "verse_number": "३९", "content_sanskrit": "तवैश्वर्यप्रदानानि श्लाघ्यमेषां वचांसि च ।\nसमर्थं त्वामभिज्ञाय प्रवदन्ति च ते नराः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2189265, "chapter_id": 5017, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2189266, "chapter_id": 5017, "verse_number": "४०", "content_sanskrit": "ततः प्रहस्य भगवान् सम्पूज्य च महामुनिम् ।\nतथाऽकरोन्महातेजा मुनिवाक्येन चोदितः \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2189267, "chapter_id": 5017, "verse_number": "४१", "content_sanskrit": "एवम्प्रभावो ब्रह्मर्षिर्नारदो मुनिसत्तमः ।\nपृष्टवानसि यन्मां त्वं तदुक्तं राजसत्तम \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2189268, "chapter_id": 5017, "verse_number": "४२", "content_sanskrit": "सर्वधर्महिते युक्ताः सत्यधर्मपरायणाः ।\nलोकप्रियत्वं गच्छन्ति ज्ञानविज्ञानकोविदाः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2189269, "chapter_id": 5017, "verse_number": "", "content_sanskrit": "॥ इति इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे षट्षष्टितमोऽध्यायः ॥६६॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]