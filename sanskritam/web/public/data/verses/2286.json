[{"id": 2060079, "chapter_id": 2286, "verse_number": "८-७-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2060080, "chapter_id": 2286, "verse_number": "८-७-१", "content_sanskrit": "हते द्रोणे महेष्वासे तस्मिन्नहनि भारत।\nकृते च मोघसंकल्पे द्रोणपुत्रे महारथे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2060081, "chapter_id": 2286, "verse_number": "८-७-२", "content_sanskrit": "द्रवमाणे महाराज कौरवाणां बलार्णवे।\nव्यूह्य पार्थः स्वकं सैन्यमतिष्ठद्वातृभिर्वृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2060082, "chapter_id": 2286, "verse_number": "८-७-३", "content_sanskrit": "तमवस्थितमाज्ञाय पुत्रस्ते भरतर्षभ।\nविद्रुतं स्वबलं दृष्ट्वा पौरुषेण न्यवारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2060083, "chapter_id": 2286, "verse_number": "८-७-४", "content_sanskrit": "स्वमनीकमवस्थाप्य बाहुवीर्यमुपाश्रितः।\nयुद्धा च सुचिरं कालं पाण्डवैः सह भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2060084, "chapter_id": 2286, "verse_number": "८-७-५", "content_sanskrit": "लब्धलक्षैः परैर्हष्टैर्व्यायच्छद्भिश्चिरं तदा।\nसन्ध्याकालं समासाद्य प्रत्याहारमकारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2060085, "chapter_id": 2286, "verse_number": "८-७-६", "content_sanskrit": "`निवेश्य बलवद्वोरं क्षुत्पिपासाबलैर्युतम्।\nश्रमेण महता युक्तं तथा द्रोणवधेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2060086, "chapter_id": 2286, "verse_number": "८-७-७", "content_sanskrit": "दीनरूपा रणे कर्म कृत्वा घोरं च शर्वरीम्।\nविशं प्राप्य सा सेना विश्रम्य मुदिताऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2060087, "chapter_id": 2286, "verse_number": "८-७-८", "content_sanskrit": "कृत्वाऽवहारं सैन्यानां प्रविश्य शिबिरं स्वकम्।\nकुरवः सहिता मन्त्रं मन्त्रयाञ्चक्रिरे मिथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2060088, "chapter_id": 2286, "verse_number": "८-७-९", "content_sanskrit": "पर्यङ्केषु परार्ध्येषु स्पर्ध्यास्तरणवत्सु च।\nवरासनेषूपविष्टाः सुखशय्यास्विवामराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2060089, "chapter_id": 2286, "verse_number": "८-७-१०", "content_sanskrit": "ततो दुर्योधनो राजा साम्ना परमवल्गुना।\nतानाभाष्य महेष्वासान्प्राप्तकालमभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2060090, "chapter_id": 2286, "verse_number": "८-७-११", "content_sanskrit": "मतं मतिमतां श्रेष्ठाः सर्वे प्रब्रूत मा चिरम्।\nएवङ्गतेन यत्कार्यं भवेत्कार्यतरं नृपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2060091, "chapter_id": 2286, "verse_number": "८-७-१२x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2060092, "chapter_id": 2286, "verse_number": "८-७-१२", "content_sanskrit": "एवमुक्ते नरेन्द्रेण नरसिंहा युयुत्सवः।\nचक्रुर्नानाविधाश्चेष्टाः सिंहासनगतास्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2060093, "chapter_id": 2286, "verse_number": "८-७-१३", "content_sanskrit": "तेषां निशाम्येङ्गितानि युद्धे प्राणाञ्जुहूषताम्।\nसमुद्वीक्ष्य मुखं राज्ञो बालार्कसमवर्चसम्।\nआचार्यपुत्रो मेधावी वाक्यज्ञो वाक्यमाददे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2060094, "chapter_id": 2286, "verse_number": "८-७-१४", "content_sanskrit": "रागो योगस्तथा दाक्ष्यां नयश्चेत्यर्थसाधकाः।\nउपायाः पण्डितैः प्रोक्तास्ते तु दैवमुपाश्रिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2060095, "chapter_id": 2286, "verse_number": "८-७-१५", "content_sanskrit": "लोकप्रवीरा येऽस्माकं देवकल्पा महारथाः।\nनीतिमन्तस्तथा युक्ता दक्षा रक्ताश्च ते हताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2060096, "chapter_id": 2286, "verse_number": "८-७-१६", "content_sanskrit": "न त्वेव कार्यं नैराश्यमस्माभिर्विजयं प्रति।\nसुनीतैरिह सर्वार्थैर्दैवमप्यनुलोम्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2060097, "chapter_id": 2286, "verse_number": "८-७-१७", "content_sanskrit": "ते वयं प्रवरं नॄणां सर्वैर्योधगुणैर्युतम्।\nकर्णमेवाभिषेभ्यामः सैनापत्येन भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2060098, "chapter_id": 2286, "verse_number": "८-७-१८", "content_sanskrit": "कर्णं सेनापतिं कृत्वा प्रमथिष्यामहे रिपून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2060099, "chapter_id": 2286, "verse_number": "८-७-१९", "content_sanskrit": "एष ह्यतिबलः शूरः कृतास्त्रो युद्धदुर्मदः।\nवैवस्वत इवासह्यः शक्तो जेतुं रणे निपून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2060100, "chapter_id": 2286, "verse_number": "८-७-२०", "content_sanskrit": "एतदाचार्यतनयाच्छ्रुत्वा राजंस्तवात्मजः।\n`दुर्योधनो महाराज भृशं प्रीतमनास्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2060101, "chapter_id": 2286, "verse_number": "८-७-२१", "content_sanskrit": "आशां बहुमतीं चक्रे वर्णं प्रति स वै तदा।\nहते भीष्मे च द्रोणे च कर्णो जेष्यति पाण्डवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2060102, "chapter_id": 2286, "verse_number": "८-७-२२", "content_sanskrit": "तामाशां हृदये कृत्वा समाश्वस्य च भारत।\n[ततो दुर्योधनः प्रीतः प्रियं श्रुत्वाऽस्य तद्वचः।\nप्रीतिसत्कारसंयुक्तं तथ्यमात्महितं शूभम्॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2060103, "chapter_id": 2286, "verse_number": "८-७-२३", "content_sanskrit": "स्वं मनः समवस्थाप्य बाहुवीर्यमुपाश्रितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2060104, "chapter_id": 2286, "verse_number": "८-७-२४", "content_sanskrit": "`प्रियसत्कारसंयुक्तं तथ्यमात्महिते रतम्।\nदुर्योधनो महाराज राधेयमिदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2060105, "chapter_id": 2286, "verse_number": "८-७-२५", "content_sanskrit": "कर्ण जानामि ते वीर्यं सौहृदं परमं मयि।\nतथाऽपि त्वां महाबाहो प्रवक्ष्यामि हितं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2060106, "chapter_id": 2286, "verse_number": "८-७-२६", "content_sanskrit": "श्रुत्वा यथेष्टं च कुरु वीर यत्तव रोचते।\nभवान्प्राज्ञतमो नित्यं मम चैव परा गतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2060107, "chapter_id": 2286, "verse_number": "८-७-२७", "content_sanskrit": "भीष्मद्रोणावतिरथौ हतौ सेनापती मम।\nसेनापतिर्भवानस्तु ताभ्यां द्रविणवत्तरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2060108, "chapter_id": 2286, "verse_number": "८-७-२८", "content_sanskrit": "वृद्धो च तौ महेष्वासौ सापेक्षो च धनञ्जये।\nमानितौ च मया वीरौ राधेय वचनात्तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2060109, "chapter_id": 2286, "verse_number": "८-७-२९", "content_sanskrit": "पितामहत्वं सम्प्रेक्ष्य पाण्डुपुत्रा महारणे।\nरक्षितास्तात भीष्मेण दिवसानि दशैव तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2060110, "chapter_id": 2286, "verse_number": "८-७-३०", "content_sanskrit": "न्यस्तशस्त्रे तु भवति हतो भीष्मः पितामहः।\nशिखण्डिनं पुरुस्कृत्य फल्गुनेन महाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2060111, "chapter_id": 2286, "verse_number": "८-७-३१", "content_sanskrit": "हते तस्मिन्महेष्वासे शरतल्पगते तथा।\nत्वयोक्ते पुरुषव्याघ्र द्रोणो ह्यासीत्पुरःसरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2060112, "chapter_id": 2286, "verse_number": "८-७-३२", "content_sanskrit": "तेनापि रक्षिताः पार्थाः शिष्यत्वादिति मे मतिः।\nस चापि निहतो वृद्धो धृष्टद्युम्नेन सत्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2060113, "chapter_id": 2286, "verse_number": "८-७-३३", "content_sanskrit": "निहताभ्यां प्रधानाभ्यां ताभ्यामतुलविक्रम।\nत्वत्समं समरे योधं नान्यं पश्यामि चिन्तयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2060114, "chapter_id": 2286, "verse_number": "८-७-३४", "content_sanskrit": "भवानेव तु नः शक्तो विजयाय न संशयः।\nपूर्वं मध्ये च पश्चाश्च तथैव विहितं हितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2060115, "chapter_id": 2286, "verse_number": "८-७-३५", "content_sanskrit": "स भवान्धुर्यवत्सङ्ख्ये धुरमुद्वोऽढुमर्हति।\nअभिषेचय सैनान्ये स्वयमात्मानमात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2060116, "chapter_id": 2286, "verse_number": "८-७-३६", "content_sanskrit": "देवतानां यथा स्कन्दः सेनानीः प्रभुरव्ययः।\nतथा भवानिमां सेनां धार्तराष्ट्रीं बिभर्तु वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2060117, "chapter_id": 2286, "verse_number": "८-७-३७", "content_sanskrit": "जहि शत्रुगणान्सर्वान्महेन्द्रो दानवानिव।\nअवस्थितं रमे दृष्ट्वा पाण्डवास्त्वां महारथाः।\nद्रविष्यन्ति च पाञ्चाला विष्णुं दृष्ट्वेव दानवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2060118, "chapter_id": 2286, "verse_number": "८-७-३८", "content_sanskrit": "तस्मात्त्वं पुरुषव्याघ्र प्रकर्षैतां महाचमूम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2060119, "chapter_id": 2286, "verse_number": "८-७-३९", "content_sanskrit": "भवत्यवस्थिते यत्ते पाण्डवा मन्दचेतसः।\nद्रविष्यन्ति सहामात्याः पाञ्चालाः सृञ्जयाश्च ह।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2060120, "chapter_id": 2286, "verse_number": "८-७-४०", "content_sanskrit": "यथा ह्यभ्युदितः सूर्यः प्रतपन्स्वेन तेजसा।\nव्यपोहति तमस्तीव्रं तथा शत्रून्प्रतापय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2060121, "chapter_id": 2286, "verse_number": "८-७-४१x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2060122, "chapter_id": 2286, "verse_number": "८-७-४१", "content_sanskrit": "एवमुक्तस्तु राधेयो राज्ञा दुर्योधनेन ह।\nराज्ञां मध्ये महाबाहुः प्रीतात्मा स महाबलः।\nहर्षयन्नब्रवीत्कर्णो दुर्योधनमिदं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2060123, "chapter_id": 2286, "verse_number": "८-७-४२x", "content_sanskrit": "कर्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2060124, "chapter_id": 2286, "verse_number": "८-७-४२", "content_sanskrit": "उक्तमेतन्मया पूर्वं गान्धारे तव सन्निधौ।\nजेष्यामि पाण्डवान्सर्वान्सपुत्रान्सजनार्दनान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2060125, "chapter_id": 2286, "verse_number": "८-७-४३", "content_sanskrit": "सेनापतिर्भविष्यामि तवाहं नात्र संशयः।\nस्थिरो भव महाराज जितान्विद्वि च पाण्डवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2060126, "chapter_id": 2286, "verse_number": "८-७-४४x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2060127, "chapter_id": 2286, "verse_number": "८-७-४४", "content_sanskrit": "एवमुक्तो महाराज ततो दुर्याधनो नृपः।\nउत्तस्थौ राजभिः सार्धं देवैरिव शतक्रतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2060128, "chapter_id": 2286, "verse_number": "८-७-४५", "content_sanskrit": "सैनापत्येन सत्कर्तुं कर्णं स्कन्दमिवामराः।\nततोऽभिषिषिचुः कर्णं विधिदृष्टेन कर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2060129, "chapter_id": 2286, "verse_number": "८-७-४६", "content_sanskrit": "दुर्योधनमुक्ता राजन्राजानो विजयैषिणः।\nशातकुम्भमयैः कुम्भेर्माहेयैश्चाभिमन्त्रितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2060130, "chapter_id": 2286, "verse_number": "८-७-४७", "content_sanskrit": "तोयपूर्णैर्विषाणैश्च द्विपखङ्गमहर्षभैः।\nमणिमुक्तायुतैश्चान्यैः पुण्यगन्धैस्तथौषधैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2060131, "chapter_id": 2286, "verse_number": "८-७-४८", "content_sanskrit": "औदुम्बरे सुखासीनमासने क्षौमसंवृते।\nशास्त्रदृष्टेन विधिना सम्भारैश्च सुसम्भृतैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2060132, "chapter_id": 2286, "verse_number": "८-७-४९", "content_sanskrit": "ब्राह्मणः क्षत्रिया वैश्यास्तथा शूद्राश्च सम्मताः।\nतुष्टुवुस्तं महात्मानमभिषिक्तं वरासने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2060133, "chapter_id": 2286, "verse_number": "८-७-५०", "content_sanskrit": "ततोऽभिषिक्ते राजेन्द्र निष्कैर्गोभिर्धनेन च।\nवाचयामास विप्राग्र्यान्राधेयः परवीरहा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2060134, "chapter_id": 2286, "verse_number": "८-७-५१", "content_sanskrit": "`स व्यरोचत राधेयः सूतमागधबन्दिभिः।\nस्तूयमानो यथा भानुरुदये ब्रह्मवादिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2060135, "chapter_id": 2286, "verse_number": "८-७-५२", "content_sanskrit": "ततः पुण्याहघोषेण वादित्रनिनदेन च।\nजयशब्देन शूराणां तुमुलः सर्वतोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2060136, "chapter_id": 2286, "verse_number": "८-७-५३", "content_sanskrit": "जयेत्यूचुर्नृपाः सर्वे राधेयं तत्र सङ्गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2060137, "chapter_id": 2286, "verse_number": "८-७-५४", "content_sanskrit": "जय पार्थान्सगोविन्दान्सानुगांस्तान्महामृधे।\nइति तं बन्दिनः प्राहुर्द्विजाश्च पुरुषर्षभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2060138, "chapter_id": 2286, "verse_number": "८-७-५५", "content_sanskrit": "जहि पार्थान्सपाञ्चालान्राधेय विजयाय नः।\nउद्यन्निव सदा भानुस्तमांस्युग्रैर्गभस्तिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2060139, "chapter_id": 2286, "verse_number": "८-७-५६", "content_sanskrit": "न ह्यलं त्वद्विसृष्टानां शराणां वै सकेशवाः।\nउलूकाः सूर्यरश्मीनां ज्वलतामिव दर्शने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2060140, "chapter_id": 2286, "verse_number": "८-७-५७", "content_sanskrit": "न हि पार्थाः सपाञ्चालाः स्थातुं शक्तास्तवाग्रतः।\nआत्तवज्रस्य समरे महेन्द्रस्येव दानवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2060141, "chapter_id": 2286, "verse_number": "८-७-५८x", "content_sanskrit": "`सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2060142, "chapter_id": 2286, "verse_number": "८-७-५८", "content_sanskrit": "स सत्कृतः स्तूयमानः सुहृद्गणवृतो रुषा।\nकर्णो दुर्योधनं वाक्यमब्रवीत्प्रहसन्प्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2060143, "chapter_id": 2286, "verse_number": "८-७-५९", "content_sanskrit": "दुर्योधनाद्य सगणं पाण्डूनां प्रवरैः सह।\nफल्गुनं सूदयिष्यामि त्वत्प्रियार्थं सबान्धवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2060144, "chapter_id": 2286, "verse_number": "८-७-६०", "content_sanskrit": "सपर्वतार्णवद्वीपां शाधि गां गतपाण्डवाम्।\nपुत्रपौत्रप्रपौत्रेषु प्रतिष्ठां गमयिष्यमि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2060145, "chapter_id": 2286, "verse_number": "८-७-६१", "content_sanskrit": "नासह्यं विद्यते मह्यं त्वत्प्रियार्थमरिन्दम।\nसत्यधर्मानुरक्तस्य सिद्धिरात्मवतो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2060146, "chapter_id": 2286, "verse_number": "८-७-६२", "content_sanskrit": "अभिषिक्तस्तु राघेयः प्रभया सोऽमितप्रभः।\nअत्यरिच्यत रूपेण दिवाकर इवापरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2060147, "chapter_id": 2286, "verse_number": "८-७-६३", "content_sanskrit": "सैनापत्ये तु राधेयमभिषिच्य सुतस्तव।\nअमन्यत तदात्मानं कृतार्थं कालचोदितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2060148, "chapter_id": 2286, "verse_number": "८-७-६४", "content_sanskrit": "कर्णोऽपि राज्ञः संप्राप्य सैनापत्यमरिन्दमः।\nयोगमाज्ञापयामास सूर्यस्योदयनं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2060149, "chapter_id": 2286, "verse_number": "८-७-६५", "content_sanskrit": "तव पुत्रैर्वृतः कर्णः शुशुभे तत्र भारत।\nदेवैरिव यथा स्कन्दः सङ्ग्रामे तारकामये॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2060150, "chapter_id": 2286, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि सप्तमोऽध्यायः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}]