[{"id": 6000049000, "chapter_id": 10049, "verse_number": null, "content_sanskrit": "अथ एकोनविंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1, "topics": [{"text": "ब्रह्मणा हिरण्याक्षवधप्रार्थना २२-२८", "range": null}]}, {"id": 6000049001, "chapter_id": 10049, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_019/BhP_03.019.001.m4a", "display_order": 2}, {"id": 6000049002, "chapter_id": 10049, "verse_number": "३-१९-१", "content_sanskrit": "तदेवमाकर्ण्य जलेशभाषितं महामनास्तद्विगणय्य दुर्मदः।\nहरेर्विदित्वा गतिमङ्ग नारदाद् रसातलं संविविशे त्वरान्वितः॥ ३/१९/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_019/BhP_03.019.002.m4a", "display_order": 3, "topics": [{"text": "नारायणान्वेषिणा हिरण्याक्षेण नारदवचनाद्रसातलगमनम्", "range": "१"}]}, {"id": 6000049003, "chapter_id": 10049, "verse_number": "३-१९-२", "content_sanskrit": "ददर्श तत्राविजितं धराधरं प्रोन्नीयमानावनिमग्रदंष्ट्रया।\nमुष्णन्तमक्ष्णाम्बुरुहारुणश्रियं जहास चाहो वनगोचरो मृगः॥ ३/१९/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_019/BhP_03.019.003.m4a", "display_order": 4, "topics": [{"text": "हरिनिन्दा", "range": "२–७"}]}, {"id": 6000049004, "chapter_id": 10049, "verse_number": "३-१९-३", "content_sanskrit": "आहैनमेह्यज्ञ महीं विमुञ्च नो रसौकसां विश्वसृजेयमर्पिता।\nन स्वस्ति यास्यस्यमुया मयेक्षितः सुराधमासादितसूकराकृते॥ ३/१९/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_019/BhP_03.019.004.m4a", "display_order": 5}, {"id": 6000049005, "chapter_id": 10049, "verse_number": "३-१९-४", "content_sanskrit": "त्वं नः सपत्नैरभयाय किं वृतो यो मायया हंस्यसुरान् परोक्षजित्।\nत्वां योगमायाबलमल्पपौरुषं संस्थाप्य मूढं प्रमृजे सुहृच्छुचः॥ ३/१९/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_019/BhP_03.019.005.m4a", "display_order": 6}, {"id": 6000049006, "chapter_id": 10049, "verse_number": "३-१९-५", "content_sanskrit": "त्वयि स्थिते गदया शीर्णशीर्षण्यस्मद्भुजच्युतया ये च तुभ्यम्।\nबलिं हरन्त्यृषयो ये च देवाः स्वयं सर्वे न भविष्यन्त्यमूलाः॥ ३/१९/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_019/BhP_03.019.006.m4a", "display_order": 7}, {"id": 6000049007, "chapter_id": 10049, "verse_number": "३-१९-६", "content_sanskrit": "स तुद्यमानोऽरिदुरुक्ततोमरैर्दंष्ट्राग्रगां गामुपलभ्य भीताम्।\nतोदं मृषन् निरगादम्बुमध्याद् ग्राहाहतः सकरेणुर्यथेभः॥ ३/१९/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_019/BhP_03.019.007.m4a", "display_order": 8}, {"id": 6000049008, "chapter_id": 10049, "verse_number": "३-१९-७", "content_sanskrit": "तं निःसरन्तं सलिलादनुद्रुतो हिरण्यकेशो द्विरदं यथा झषः।\nकरालदंष्ट्रोऽशनिनिःस्वनोऽब्रवीद् गतह्रियां किं न्वसतां विगर्हितम्॥ ३/१९/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_019/BhP_03.019.008.m4a", "display_order": 9}, {"id": 6000049009, "chapter_id": 10049, "verse_number": "३-१९-८", "content_sanskrit": "स गामुदस्तात् सलिलस्य गोचरे विन्यस्य तस्यामदधात् स्वसत्त्वम्।\nअभिष्टुतो विश्वसृजां प्रसूनैरापूर्यमाणो विबुधैः पश्यतोऽरेः॥ ३/१९/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_019/BhP_03.019.009.m4a", "display_order": 10, "topics": [{"text": "भगवता भूदेव्युद्धरणम्", "range": "८–९"}]}, {"id": 6000049010, "chapter_id": 10049, "verse_number": "३-१९-९", "content_sanskrit": "परानुषक्तं तपनीयोपकल्पमहागदं काञ्चनचित्रिताङ्गम्।\nमर्माण्यभीक्ष्णं प्रतुदन्तं दुरुक्तैः प्रचण्डमन्युः प्रहसंस्तं बभाषे॥ ३/१९/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_019/BhP_03.019.010.m4a", "display_order": 11}, {"id": 6000049011, "chapter_id": 10049, "verse_number": null, "content_sanskrit": "भगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_019/BhP_03.019.011.m4a", "display_order": 12}, {"id": 6000049012, "chapter_id": 10049, "verse_number": "३-१९-१०", "content_sanskrit": "सत्यं वयं भो वनगोचरा मृगाः युष्मद्विधान् मृगये ग्रामसिंहान्।\nन मृत्युपाशैः प्रतियुक्तस्य वीरा विकत्थनं तव गृह्णन्त्यभद्र॥ ३/१९/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_019/BhP_03.019.012.m4a", "display_order": 13, "topics": [{"text": "तत्र वराहरूपिणा हरिणा सह युद्धारम्भः", "range": "१०–२१"}]}, {"id": 6000049013, "chapter_id": 10049, "verse_number": "३-१९-११", "content_sanskrit": "एते वयं न्यासहरा रसौकसां गतह्रियो गदया द्रावितास्ते।\nतिष्ठामहेऽथापि कथञ्चिदाजौ स्थेयं क्‍व यामो बलिनोत्पाद्य वैरम्॥ ३/१९/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_019/BhP_03.019.013.m4a", "display_order": 14}, {"id": 6000049014, "chapter_id": 10049, "verse_number": "३-१९-१२", "content_sanskrit": "त्वं यद् रथानां किल यूथपाधिपो घटस्व नोऽस्वस्तय आश्वदुद्रुहः।\nसंस्थाप्य चास्मान् प्रमृजाश्रु स्वकानां यः स्वां प्रतिज्ञां नातिपिपर्त्यसभ्यः॥ ३/१९/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_019/BhP_03.019.014.m4a", "display_order": 15}, {"id": 6000049015, "chapter_id": 10049, "verse_number": "३-१९-१३", "content_sanskrit": "सोऽधिक्षिप्तो भगवता प्रलब्धश्च रुषा भृशम्।\nआजहारोल्बणं क्रोधं क्रीड्यमानोऽहिराडिव॥ ३/१९/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_019/BhP_03.019.015.m4a", "display_order": 16}, {"id": 6000049016, "chapter_id": 10049, "verse_number": "३-१९-१४", "content_sanskrit": "विसृजन्नहिवच्छ्वासं मन्युप्रचलितेन्द्रियः।\nआसाद्य तरसा दैत्यो गदयाऽभ्यहनद्धरिम्॥ ३/१९/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_019/BhP_03.019.016.m4a", "display_order": 17}, {"id": 6000049017, "chapter_id": 10049, "verse_number": "३-१९-१५", "content_sanskrit": "भगवांस्तु गदावेगं विसृष्टं रिपुणोरसि।\nअवञ्चयत् तिरश्चीनो योगारूढ इवान्तकम्॥ ३/१९/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_019/BhP_03.019.017.m4a", "display_order": 18}, {"id": 6000049018, "chapter_id": 10049, "verse_number": "३-१९-१६", "content_sanskrit": "पुनर्गदां स्वामादाय भ्रामयन्तमभीक्ष्णशः।\nअभ्यधावद्धरिः क्रुद्धः संरम्भाद् दष्टदच्छदः॥ ३/१९/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_019/BhP_03.019.018.m4a", "display_order": 19}, {"id": 6000049019, "chapter_id": 10049, "verse_number": "३-१९-१७", "content_sanskrit": "ततः स्वगदयाऽऽरातिं दक्षिणांसभुवि प्रभुः।\nआजघ्ने स तु तां सौम्य गदया कोविदोऽहनत्॥ ३/१९/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_019/BhP_03.019.019.m4a", "display_order": 20}, {"id": 6000049020, "chapter_id": 10049, "verse_number": "३-१९-१८", "content_sanskrit": "एवं गदाभ्यां गुर्वीभ्यां हर्यक्षो हरिरेव च।\nजिगीषया सुसंरब्धावन्योन्यमभिजघ्नतुः॥ ३/१९/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_019/BhP_03.019.020.m4a", "display_order": 21}, {"id": 6000049021, "chapter_id": 10049, "verse_number": "३-१९-१९", "content_sanskrit": "तयोः स्पृधोः स्निग्धगदाहताङ्गयोः क्षतस्रवाघ्राणविवृद्धयुद्धयोः।\nविचित्रमार्गांश्चरतोर्जिगीषया व्यभादिलायामिव शुष्मिणोर्मृधः॥ ३/१९/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_019/BhP_03.019.021.m4a", "display_order": 22}, {"id": 6000049022, "chapter_id": 10049, "verse_number": "३-१९-२०", "content_sanskrit": "दैत्यस्य यज्ञावयवस्य मायया गृहीतवाराहतनोर्महात्मनः।\nकौरव्य मह्यां द्विषतोर्विमर्दनं दिदृक्षुरागाद् ऋषिभिर्वृतः स्वराट्॥ ३/१९/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_019/BhP_03.019.022.m4a", "display_order": 23}, {"id": 6000049023, "chapter_id": 10049, "verse_number": "३-१९-२१", "content_sanskrit": "आसन्नशौण्डीरमपेतसाध्वसं कृतप्रतीकारमहार्यविक्रमम्।\nविलक्ष्य दैत्यं भगवान् सहस्रणीर्जगाद नारायणमादिसूकरम्॥ ३/१९/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_019/BhP_03.019.023.m4a", "display_order": 24}, {"id": 6000049024, "chapter_id": 10049, "verse_number": null, "content_sanskrit": "ब्रह्मोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_019/BhP_03.019.024.m4a", "display_order": 25}, {"id": 6000049025, "chapter_id": 10049, "verse_number": "३-१९-२२", "content_sanskrit": "एष ते देव देवानामङ्घ्रिमूलमुपेयुषाम्।\nविप्राणां सौरभेयीणां भूतानामप्यनागसाम्॥ ३/१९/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_019/BhP_03.019.025.m4a", "display_order": 26}, {"id": 6000049026, "chapter_id": 10049, "verse_number": "३-१९-२३", "content_sanskrit": "आगस्कृद् भयकृद् दुष्कृदस्मल्लब्धवरोऽसुरः।\nअन्वेषयन्नप्रतिरथो लोकानटति कण्टकः॥ ३/१९/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_019/BhP_03.019.026.m4a", "display_order": 27}, {"id": 6000049027, "chapter_id": 10049, "verse_number": "३-१९-२४", "content_sanskrit": "मैनं मायाविनं दृप्तं निरङ्कुशमसत्तमम्।\nआक्रीड बालवद् देव यदाशीविषमुत्थितम्॥ ३/१९/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_019/BhP_03.019.027.m4a", "display_order": 28}, {"id": 6000049028, "chapter_id": 10049, "verse_number": "३-१९-२५", "content_sanskrit": "न यावदेष वर्धेत स्वां वेलां प्राप्य दारुणः।\nस्वां देव मायामास्थाय तावज्जह्येनमच्युत॥ ३/१९/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_019/BhP_03.019.028.m4a", "display_order": 29}, {"id": 6000049029, "chapter_id": 10049, "verse_number": "३-१९-२६", "content_sanskrit": "एषा घोरतमा सन्ध्या लोकशम्बट्करी प्रभो।\nउपसर्पति सर्वात्मन् सुराणां जयमावह॥ ३/१९/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_019/BhP_03.019.029.m4a", "display_order": 30}, {"id": 6000049030, "chapter_id": 10049, "verse_number": "३-१९-२७", "content_sanskrit": "अधुनैवाभिजिन्नाम योगो मौहूर्तिकोऽभ्यगात्।\nशिवाय नस्त्वं सुहृदामाशु निस्तर दुस्तरम्॥ ३/१९/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_019/BhP_03.019.030.m4a", "display_order": 31}, {"id": 6000049031, "chapter_id": 10049, "verse_number": "३-१९-२८", "content_sanskrit": "दिष्ट्या त्वा विहितं मृत्युमयमासादितः स्वयम्।\nविक्रम्यैनं मृधे हत्वा लोकानाधेहि शर्मणि॥ ३/१९/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_019/BhP_03.019.031.m4a", "display_order": 32}, {"id": 6000049032, "chapter_id": 10049, "verse_number": null, "content_sanskrit": "इति श्रीमद्भागवते वैयासिक्यां संहितायां तृतीयस्कन्धे एकोनविंशाध्यायः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]