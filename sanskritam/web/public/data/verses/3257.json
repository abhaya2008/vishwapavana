[{"id": 2104698, "chapter_id": 3257, "verse_number": "१४-११३-१", "content_sanskrit": "वैशम्पायन उवाच।\nकेशवेनैवमुक्ते तु चान्द्रायणविधिक्रमे।\nअपृच्छत्पुनरन्यांश्च धर्मान्धर्मात्मजो नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2104699, "chapter_id": 3257, "verse_number": "१४-११३-२x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2104700, "chapter_id": 3257, "verse_number": "१४-११३-२", "content_sanskrit": "सर्वभूतपते श्रीमन्सर्वभूतनमस्कृत।\nसर्वभूतहितं धर्मं सर्वज्ञ कथयस्व नः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2104701, "chapter_id": 3257, "verse_number": "१४-११३-३x", "content_sanskrit": "भगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2104702, "chapter_id": 3257, "verse_number": "१४-११३-३", "content_sanskrit": "यद्दरिद्रजनस्यापि स्वर्ग्यं सुखकरं भवेत्।\nसर्वपापप्रशमनं तच्छृणुष्व युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2104703, "chapter_id": 3257, "verse_number": "१४-११३-४", "content_sanskrit": "कार्तिकाद्यास्तु ये मासा द्वादशैव प्रकीर्तिताः।\nतेष्वेकबुक्तनिमः सर्वेषामुच्यते मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2104704, "chapter_id": 3257, "verse_number": "१४-११३-५", "content_sanskrit": "कार्तिके यस्तु वै मासे नन्दायां संयतेन्द्रियः।\nएकभुक्तेन मद्भक्तो मासमेकं तु वर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2104705, "chapter_id": 3257, "verse_number": "१४-११३-६", "content_sanskrit": "जलं वा न पिबेन्मासे नान्तरं भोजनात्परम्।\nआदित्यरूपं मां नित्यमर्चयन्सुसमाहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2104706, "chapter_id": 3257, "verse_number": "१४-११३-७", "content_sanskrit": "व्रतान्ते भोजयेद्विप्रान्दक्षिणां सम्प्रदाय च।\nक्रोधलोभविनिर्मुक्तस्तस्य पुण्यफलं शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2104707, "chapter_id": 3257, "verse_number": "१४-११३-८", "content_sanskrit": "विधिवत्कपिलादाने यत्पुण्यं समुदाहृतम्।\nतत्पुण्यं समनुप्राप्य सूर्यकलोके महीयते।\nततश्चापि च्युतः कालात्पुरुषेषूपजायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2104708, "chapter_id": 3257, "verse_number": "१४-११३-९", "content_sanskrit": "मार्गशीर्षं तु यो मासमेकभुक्तेन वर्तते।\nकामं क्रोधं च लोभं च परित्यज्य यथाविधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2104709, "chapter_id": 3257, "verse_number": "१४-११३-१०", "content_sanskrit": "स्नात्वा चादित्यरूपं मामर्ययेन्नियतेन्द्रियः।\nजपेच्चैव च गायत्रीं मामिकां वाग्यतेन्द्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2104710, "chapter_id": 3257, "verse_number": "१४-११३-११", "content_sanskrit": "मासे परिसमाप्ते तु भोजयित्वा द्विजाञ्शुचिः।\nतानर्चयति मद्भक्त्या तस्य पुण्यफलं शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2104711, "chapter_id": 3257, "verse_number": "१४-११३-१२", "content_sanskrit": "अग्निहोत्रे कृते पुण्यमाहिताग्नेस्तु यद्भवेत्।\nतत्पुण्यं फलमासाद्य योनेनांऽबरशोभिना।\nसह सप्तर्षिलोकेषु यथाकामं यथासुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2104712, "chapter_id": 3257, "verse_number": "१४-११३-१३", "content_sanskrit": "ततश्चापि च्युतः कालाद्धरिवर्षेषु जायते।\nतत्र प्रकामं क्रीडित्वा राजा पश्चाद्भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2104713, "chapter_id": 3257, "verse_number": "१४-११३-१४", "content_sanskrit": "******** क्षिपेदेवमेकभुक्तेन यो नरः।\nअर्चयन्नेव मां नित्यं मद्गतेनान्तरात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2104714, "chapter_id": 3257, "verse_number": "१४-११३-१५", "content_sanskrit": "अहिंसासत्यसहितः क्रोधहर्षविवर्जितः।\nएवं युक्तस्य राजेन्द्र शृणु यत्फलमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2104715, "chapter_id": 3257, "verse_number": "१४-११३-१६", "content_sanskrit": "विप्रातिथ्यसहस्रेषु यत्पुण्यं समुदाहृतम्।\nतत्पुण्यं समनुप्राप्य शक्रलोके महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2104716, "chapter_id": 3257, "verse_number": "१४-११३-१७", "content_sanskrit": "अवतीर्णस्ततः कालादिलावर्षेषु जायते।\nतत्र स्थित्वा चिरं कालमस्मिन्विप्रो भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2104717, "chapter_id": 3257, "verse_number": "१४-११३-१८", "content_sanskrit": "माघमासं सदा यस्तु वर्तते चैकभुक्ततः।\nमदर्चनपरो भूत्वा डंभक्तोधविवर्जितः।\nमामिकामपि सावित्रीं सन्ध्यायां तु जपेद्बुधः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2104718, "chapter_id": 3257, "verse_number": "१४-११३-१९", "content_sanskrit": "दत्त्वा दु दक्षिणामन्ते भोजयित्वा द्विजानपि।\nनमिस्करोति तान्भक्त्या मद्गतेनान्तरात्मना।\nत्रिकालस्नानयुक्तस्य तस्य पुण्यफलं शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2104719, "chapter_id": 3257, "verse_number": "१४-११३-२०", "content_sanskrit": "नीलकण्ठप्रयुक्तेन योनेनांऽबरशोभिना।\nपितृलोकं व्रजेच्छ्रीमान्सेव्यमानोप्सरोणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2104720, "chapter_id": 3257, "verse_number": "१४-११३-२१", "content_sanskrit": "तत्र प्रकामं क्रीडित्वा भद्राश्वेषूपजायते।\nततश्च्युतश्चतुर्वेदी विप्रो भवति भूतले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2104721, "chapter_id": 3257, "verse_number": "१४-११३-२२", "content_sanskrit": "यश्चरेत्फाल्गुनं मासमेकभुक्तो जितेन्द्रियः।\nनमो ब्रह्मण्यदेवायेत्येतन्मन्त्रं जपेत्सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2104722, "chapter_id": 3257, "verse_number": "१४-११३-२३", "content_sanskrit": "पायसं भोजयेद्विप्रान्व्रतान्ते संयतेन्द्रियः।\nमदर्चनपरोऽक्रोधस्तस्य पुण्यफलं शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2104723, "chapter_id": 3257, "verse_number": "१४-११३-२४", "content_sanskrit": "विमानं सारसैर्युक्तमारूढः कामगामि च।\nनक्षत्रलोके रमते नक्षत्रसदृशाकृतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2104724, "chapter_id": 3257, "verse_number": "१४-११३-२५", "content_sanskrit": "ततश्चापि च्युतः कालात्केतुमालेषु जायते।\nतत्र प्रकामं क्रीडित्वा मानुषेषु मुनिर्भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2104725, "chapter_id": 3257, "verse_number": "१४-११३-२६", "content_sanskrit": "चैत्रमासं तु यो राजन्नेकभुक्तेन वर्तते।\nब्रह्मचारी च मद्भक्त्या तस्य पुण्यफलं शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2104726, "chapter_id": 3257, "verse_number": "१४-११३-२७", "content_sanskrit": "यदग्निहोत्रिणः पुण्यं यथोक्तं व्रतचारिणः।\nतत्पुण्यफकलमासाद्य चन्द्रलोके महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2104727, "chapter_id": 3257, "verse_number": "१४-११३-२८", "content_sanskrit": "ततोऽवतीर्णो जायेत वर्षे रमणके पुनः।\nभुक्त्वा कामांस्ततस्तस्मिन्निह राजा भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2104728, "chapter_id": 3257, "verse_number": "१४-११३-२९", "content_sanskrit": "वैशाखे यस्तु मासे वै ह्येकभुक्तेन वर्तते।\nद्विजमग्रासने कृत्वा भुञ्जन्भूमौ च वाग्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2104729, "chapter_id": 3257, "verse_number": "१४-११३-३०", "content_sanskrit": "नमो ब्रह्मण्यदेवायेत्यर्चयित्वा दिवाकरम्।\nव्रतान्ते भोजयेद्विप्रांस्तस्य पुण्यफलं शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2104730, "chapter_id": 3257, "verse_number": "१४-११३-३१", "content_sanskrit": "फलं यद्विधिवत्प्रोक्तमग्निष्टोमातिरात्रयोः।\nतत्पुण्यफलमासाद्य देवलोके महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2104731, "chapter_id": 3257, "verse_number": "१४-११३-३२", "content_sanskrit": "ततो हैमवते वर्षे जायते कालपर्ययात्।\nतत्र प्रकामं क्रीडित्वा विप्रः पश्चाद्भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2104732, "chapter_id": 3257, "verse_number": "१४-११३-३३", "content_sanskrit": "ज्येष्ठमासं तु यो विप्रो ह्येकभुक्तेन वर्तते।\nविप्रमग्रासने कृत्वा भूमौ भुञ्जन्यथाविधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2104733, "chapter_id": 3257, "verse_number": "१४-११३-३४", "content_sanskrit": "नमो ब्रह्मण्यदेवायेत्युच्चरन्मां समाहितः।\nडंभानृतविनिर्मुक्तस्तस्य पुण्यफलं शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2104734, "chapter_id": 3257, "verse_number": "१४-११३-३५", "content_sanskrit": "चीर्णे चान्द्रायणे सम्यग्यत्पुण्यं समुदाहृतम्।\nतत्पुण्यफलमासाद्य देवलोके महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2104735, "chapter_id": 3257, "verse_number": "१४-११३-३६", "content_sanskrit": "अथोत्तरकुरौ वर्षे जायते निर्गतस्ततः।\nततश्चापि च्युतः कालादिह लोके द्विजो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2104736, "chapter_id": 3257, "verse_number": "१४-११३-३७", "content_sanskrit": "आषाढमासं यो राजन्नेकभुक्तेन वर्तते।\nब्रह्मचारी जितक्रोधो मदर्चनपरायणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2104737, "chapter_id": 3257, "verse_number": "१४-११३-३८", "content_sanskrit": "विप्रमग्रासने कृत्वा भूमौ भुञ्जञ्जितेन्द्रियः।\nकृत्वा त्रिषवणं स्नानमष्टाक्षरविधानतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2104738, "chapter_id": 3257, "verse_number": "१४-११३-३९", "content_sanskrit": "व्रतान्ते भोजयेद्विद्वान्पायसेन युधिष्ठिर।\nगुडोदनेन राजेन्द्र तस्य पुण्यफलं शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2104739, "chapter_id": 3257, "verse_number": "१४-११३-४०", "content_sanskrit": "कपिलाशतदानस्य यत्पुण्यं पाण्डुनन्दन।\nतत्पुण्यफलमासाद्य देवलोके महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2104740, "chapter_id": 3257, "verse_number": "१४-११३-४१", "content_sanskrit": "ततोऽवतीर्णः काले तु शाकद्वीपे तु जायते।\nततश्चापि च्युतः कालादिह विप्रो भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2104741, "chapter_id": 3257, "verse_number": "१४-११३-४२", "content_sanskrit": "श्रावणं यः क्षिपेन्मासमेकभुक्तेन वर्तते।\nनमो ब्रह्मण्यदेवायेत्युक्त्वा मामर्चयेत्सदा।\nविप्रमाग्रासने कृत्वा भूमौ भुञ्जन्यथाविधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2104742, "chapter_id": 3257, "verse_number": "१४-११३-४३", "content_sanskrit": "पायसेनार्चयन्विप्राञ्जितक्रोधो जितेन्द्रियः।\nलोभमोहविनिर्मुक्तस्तस्य पुण्यफलं शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2104743, "chapter_id": 3257, "verse_number": "१४-११३-४४", "content_sanskrit": "कपिलादानस्य यत्पुण्यं विधिदत्तस्य पाण्डव।\nतत्पुण्यं सम***प्राप्य शक्रलोके महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2104744, "chapter_id": 3257, "verse_number": "१४-११३-४५", "content_sanskrit": "ततश्चापि च्युत कालात्कुशद्वीपे प्रजायते।\nतत्रि प्रकामं क्रीडित्वा विप्रो भवति मानुषे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2104745, "chapter_id": 3257, "verse_number": "१४-११३-४६", "content_sanskrit": "यस्तु भाद्रपदं मासमेकभुक्तेन वर्तते।\nब्रह्मचारी जितक्रोधः सत्यसन्धो जितेन्द्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2104746, "chapter_id": 3257, "verse_number": "१४-११३-४७", "content_sanskrit": "विप्रमग्रासने कृत्वा पाकभेदविवर्जितः।\nनमो ब्रह्मण्यदेवायेत्युक्त्वाऽस्य चरणौ स्पृशेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2104747, "chapter_id": 3257, "verse_number": "१४-११३-४८", "content_sanskrit": "तिलानपि घृतं वाऽपि व्रतान्ते दक्षिमां ददत्।\nमद्भक्तस्य नरश्रेष्ठ तस्य पुण्यफलं शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2104748, "chapter_id": 3257, "verse_number": "१४-११३-४९", "content_sanskrit": "यत्फलं विधिवत्प्रोक्तं राजसूयाश्वमेधयोः।\nतत्पुण्यफलमासाद्य शक्रलोके महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2104749, "chapter_id": 3257, "verse_number": "१४-११३-५०", "content_sanskrit": "ततश्चापि च्युतः कालाज्जायते धनदालये।\nतत्र प्रकामं क्रीकडित्वा राजा भवति मानुषे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2104750, "chapter_id": 3257, "verse_number": "१४-११३-५१", "content_sanskrit": "यश्चाप्याश्वयुजं मासमेकभुक्तेन वर्तते।\nमद्गायत्रीं जपेद्भक्त्या मद्गतेनान्तरात्मना।\nद्विसन्ध्यं वा त्रिसन्ध्यं वा शतमष्टोत्तरं तु वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2104751, "chapter_id": 3257, "verse_number": "१४-११३-५२", "content_sanskrit": "विप्रमग्रासने कृत्वा संयतेन्द्रियमानसः।\nव्रतान्ते भोजयेद्विप्रांस्तस्य पुण्यफलं शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2104752, "chapter_id": 3257, "verse_number": "१४-११३-५३", "content_sanskrit": "अश्वमेधस्य यत्पुण्यं विधिवत्पाण्डुनन्दन।\nतत्पुण्यफलमासाद्य मम लोके महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2104753, "chapter_id": 3257, "verse_number": "१४-११३-५४", "content_sanskrit": "ततश्चापि च्युतः कालाच्छ्वेतद्वीपे प्रजायते।\nतत्र भुक्त्वा च भोगांश्च ततो विप्रवरो भवेत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2104754, "chapter_id": 3257, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि वैष्णवधऱ्मपर्वणि त्रयोदशाधिकशततमोऽध्यायः॥ ११३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]