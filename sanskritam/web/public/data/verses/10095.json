[{"id": 6000095000, "chapter_id": 10095, "verse_number": null, "content_sanskrit": "अथ एकत्रिंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000095001, "chapter_id": 10095, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_031/BhP_04.031.001.m4a", "display_order": 2}, {"id": 6000095002, "chapter_id": 10095, "verse_number": "४-३१-१", "content_sanskrit": "तत उत्पन्नविज्ञाना आश्वधोक्षजभाषितम्।\nस्मरन्त आत्मजे भार्यां विसृज्य प्राव्रजन् गृहात्॥ ४/३१/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_031/BhP_04.031.002.m4a", "display_order": 3, "topics": [{"text": "प्रचेतोभिः स्वकुटुम्बभारं स्वपुत्रे दक्षे विन्यस्य गृहात्प्रव्रजनम्", "range": "१–४"}]}, {"id": 6000095003, "chapter_id": 10095, "verse_number": "४-३१-२", "content_sanskrit": "दीक्षिता ब्रह्मसत्रेण सर्वभूतात्ममेधसा।\nप्रतीच्यां दिशि वेलायां सिद्धोऽभूद् यत्र जाजलिः॥ ४/३१/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_031/BhP_04.031.003.m4a", "display_order": 4}, {"id": 6000095004, "chapter_id": 10095, "verse_number": "४-३१-३", "content_sanskrit": "तान् निर्जितप्राणमनोवचोदृशो जितासनाञ्छान्तसमानविग्रहान्।\nपरेऽमले ब्रह्मणि योजितात्मनः सुरासुरेड्यो ददृशे स्म नारदः॥ ४/३१/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_031/BhP_04.031.004.m4a", "display_order": 5}, {"id": 6000095005, "chapter_id": 10095, "verse_number": "४-३१-४", "content_sanskrit": "तमागतं त उत्थाय प्रणिपत्याभिनन्द्य च।\nपूजयित्वा यथादेशं सुखासीनमथाब्रुवन्॥ ४/३१/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_031/BhP_04.031.005.m4a", "display_order": 6}, {"id": 6000095006, "chapter_id": 10095, "verse_number": "४-३१-५", "content_sanskrit": "स्वागतं ते सुरर्षेऽद्य दिष्ट्या नो दर्शनं गतः।\nतव चङ्क्रमणं ब्रह्मन्नभयाय यथा रवेः॥ ४/३१/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_031/BhP_04.031.006.m4a", "display_order": 7, "topics": [{"text": "समुद्रतीरे तपस्यतां तेषां नारदोपदेशः तेषां मोक्षप्राप्तिश्च", "range": "५–२८"}]}, {"id": 6000095007, "chapter_id": 10095, "verse_number": "४-३१-६", "content_sanskrit": "यदादिष्टं भगवता शिवेनाधोक्षजेन च।\nतद् गृहेषु प्रसक्तानां प्रायशः क्षपितं प्रभो॥ ४/३१/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_031/BhP_04.031.007.m4a", "display_order": 8}, {"id": 6000095008, "chapter_id": 10095, "verse_number": "४-३१-७", "content_sanskrit": "तन्नः प्रद्योतयाध्यात्मज्ञानं तत्त्वार्थदर्शनम्।\nयेनाञ्जसा तरिष्यामो दुस्तरं भवसागरम्॥ ४/३१/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_031/BhP_04.031.008.m4a", "display_order": 9}, {"id": 6000095009, "chapter_id": 10095, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_031/BhP_04.031.009.m4a", "display_order": 10}, {"id": 6000095010, "chapter_id": 10095, "verse_number": "४-३१-८", "content_sanskrit": "इति प्रचेतसा पृष्टो भगवान् नारदो मुनिः।\nभगवत्युत्तमश्लोक आविष्टात्माऽब्रवीन्नृपान्॥ ४/३१/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_031/BhP_04.031.010.m4a", "display_order": 11}, {"id": 6000095011, "chapter_id": 10095, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_031/BhP_04.031.011.m4a", "display_order": 12}, {"id": 6000095012, "chapter_id": 10095, "verse_number": "४-३१-९", "content_sanskrit": "तज्जन्म तानि कर्माणि तदायुस्तन्मनो वचः।\nनृणां येन हि विश्वात्मा सेव्यते हरिरीश्वरः॥ ४/३१/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_031/BhP_04.031.012.m4a", "display_order": 13}, {"id": 6000095013, "chapter_id": 10095, "verse_number": "४-३१-१०", "content_sanskrit": "किं जन्मभिस्‍त्रिभिर्वेह शुक्लसावित्रयाज्ञिकैः।\nकर्मभिर्वा त्रयीप्रोक्तैः पुंसोऽपि विबुधायुषः॥ ४/३१/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_031/BhP_04.031.013.m4a", "display_order": 14}, {"id": 6000095014, "chapter_id": 10095, "verse_number": "४-३१-११", "content_sanskrit": "श्रुतेन तपसा वा किं वचोभिश्चित्तवृत्तिभिः।\nबुद्ध्या वा किं निपुणया बलेनेन्द्रियराधसा॥ ४/३१/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_031/BhP_04.031.014.m4a", "display_order": 15}, {"id": 6000095015, "chapter_id": 10095, "verse_number": "४-३१-१२", "content_sanskrit": "किं वा योगेन सांख्येन न्यासस्वाध्याययोरपि।\nकिं वा श्रेयोभिरन्यैश्च न यत्रात्मप्रदो हरिः॥ ४/३१/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_031/BhP_04.031.015.m4a", "display_order": 16}, {"id": 6000095016, "chapter_id": 10095, "verse_number": "४-३१-१३", "content_sanskrit": "श्रेयसामपि सर्वेषामात्मा ह्यवधिरर्थितः।\nसर्वेषामपि भूतानां हरिरात्माऽऽत्मदः प्रियः॥ ४/३१/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_031/BhP_04.031.016.m4a", "display_order": 17}, {"id": 6000095017, "chapter_id": 10095, "verse_number": "४-३१-१४", "content_sanskrit": "यथा तरोर्मूलनिषेचनेन तृप्यन्ति तत्स्कन्धभुजोपशाखाः।\nप्राणोपहारोऽत्र यथेन्द्रियाणां तथैव सर्वार्हणमच्युतेज्या॥ ४/३१/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_031/BhP_04.031.017.m4a", "display_order": 18}, {"id": 6000095018, "chapter_id": 10095, "verse_number": "४-३१-१५", "content_sanskrit": "यथैव सूर्यात् प्रभवन्ति गावः पुनश्च तस्मिन् प्रविशन्ति काले।\nभूतानि भूमौ स्थिरजङ्गमानि तथा हरावेव गुणप्रवाहः॥ ४/३१/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_031/BhP_04.031.018.m4a", "display_order": 19}, {"id": 6000095019, "chapter_id": 10095, "verse_number": "४-३१-१६", "content_sanskrit": "एतत् परं तज्जगदात्मनः पदं सकृद् विभातं सवितुर्यथा प्रभा।\nयदाऽसवो जाग्रति सुप्तवृत्तयो द्रव्यक्रियाकारकविभ्रमात्ययः॥ ४/३१/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_031/BhP_04.031.019.m4a", "display_order": 20}, {"id": 6000095020, "chapter_id": 10095, "verse_number": "४-३१-१७", "content_sanskrit": "यथा नभस्यभ्रतमःप्रकाशा भवन्ति भूयो न भवन्त्यनुक्रमात्।\nएवं परे ब्रह्मणि शक्तयस्त्वमू रजस्तमस्सत्त्वमिति प्रवाहः॥ ४/३१/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_031/BhP_04.031.020.m4a", "display_order": 21}, {"id": 6000095021, "chapter_id": 10095, "verse_number": "४-३१-१८", "content_sanskrit": "तेनैकमात्मनमशेषदेहिनां कालं प्रधानं पुरुषं परेशम्।\nस्वतेजसा ध्वस्तगुणप्रवाहमात्मैकभावेन भजध्वमद्धा॥ ४/३१/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_031/BhP_04.031.021.m4a", "display_order": 22}, {"id": 6000095022, "chapter_id": 10095, "verse_number": "४-३१-१९", "content_sanskrit": "निरस्तसङ्कल्पविकल्पमद्वयं द्वयापवादोपरमोपलम्भनम्।\nअनादिमध्यान्तमजस्रनिर्वृतिं संज्ञप्तिमात्रं भजतामुया दृशा॥ ४/३१/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_031/BhP_04.031.022.m4a", "display_order": 23}, {"id": 6000095023, "chapter_id": 10095, "verse_number": "४-३१-२०", "content_sanskrit": "दयया सर्वभूतेषु संतुष्ट्या येन केन वा।\nसर्वेन्द्रियोपशान्त्या च तुष्यत्याशु जनार्दनः॥ ४/३१/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_031/BhP_04.031.023.m4a", "display_order": 24}, {"id": 6000095024, "chapter_id": 10095, "verse_number": "४-३१-२१", "content_sanskrit": "अपगतसकलेषणामलात्मन्यविरतमेधितभावनोपहूतः।\nनिजजनवशगत्वमाप्तवान् यो न सरति च्छिद्रवदक्षरः सतां हि॥ ४/३१/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_031/BhP_04.031.024.m4a", "display_order": 25}, {"id": 6000095025, "chapter_id": 10095, "verse_number": "४-३१-२२", "content_sanskrit": "न भजति कुमनीषिणां स इज्यां हरिरधनात्मधनप्रियो रसज्ञः।\nश्रुतधनकुलकर्मणां मदैर्ये विदधति पापमकिञ्चनेषु सत्सु॥ ४/३१/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_031/BhP_04.031.025.m4a", "display_order": 26}, {"id": 6000095026, "chapter_id": 10095, "verse_number": "४-३१-२३", "content_sanskrit": "श्रियमनुचरतीं तदर्थिनश्च द्विपदपतीन् विबुधांश्च यः स्वपूर्णः।\nन भजति निजभृत्यवर्गतन्त्रः कथममुमुद्विसृजेत् पुमान् कृतज्ञः॥ ४/३१/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_031/BhP_04.031.026.m4a", "display_order": 27}, {"id": 6000095027, "chapter_id": 10095, "verse_number": "४-३१-२४", "content_sanskrit": "भवतां वंशधुर्योऽभूद् ध्रुवश्चित्ररथः स्वराट्।\nगुरुदारवचोबाणैर्निर्भिण्णहृदयोऽर्भकः॥ ४/३१/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_031/BhP_04.031.027.m4a", "display_order": 28}, {"id": 6000095028, "chapter_id": 10095, "verse_number": "४-३१-२५", "content_sanskrit": "त्यक्त्वा स्‍त्रैणं च तं गच्छन् दृष्टो मे पथ्युदारधीः।\nपञ्चवर्षो मदादेशैः संराध्य पुरुषेश्वरम्॥ ४/३१/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_031/BhP_04.031.028.m4a", "display_order": 29}, {"id": 6000095029, "chapter_id": 10095, "verse_number": "४-३१-२६", "content_sanskrit": "तत् परं सर्वधिष्ण्येभ्यो मायाधिष्ठितमारुहत्।\nमुनयोऽद्याप्युदीक्षन्ते परं नापुरवाङ् नृपाः॥ ४/३१/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_031/BhP_04.031.029.m4a", "display_order": 30}, {"id": 6000095030, "chapter_id": 10095, "verse_number": "४-३१-२७", "content_sanskrit": "तं यूयं सर्वभूतानाम् अन्तर्यामिणमीश्वरम्।\nरुद्रादिष्टोपदेशेन भजध्वं भवनुत्तये॥ ४/३१/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_031/BhP_04.031.030.m4a", "display_order": 31}, {"id": 6000095031, "chapter_id": 10095, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_031/BhP_04.031.031.m4a", "display_order": 32}, {"id": 6000095032, "chapter_id": 10095, "verse_number": "४-३१-२८", "content_sanskrit": "इति प्रचेतसां राजन्नन्यांश्च भगवत्कथाः।\nश्रावयित्वा ब्रह्मलोकं ययौ स्वायम्भुवो मुनिः॥ ४/३१/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_031/BhP_04.031.032.m4a", "display_order": 33}, {"id": 6000095033, "chapter_id": 10095, "verse_number": "४-३१-२९", "content_sanskrit": "तेऽपि तन्मुखनिर्यातं यशो लोकमलापहम्।\nहरेर्निशम्य तत्पादं ध्यायन्तस्तद्गतिं ययुः॥ ४/३१/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_031/BhP_04.031.033.m4a", "display_order": 34}, {"id": 6000095034, "chapter_id": 10095, "verse_number": "४-३१-३०", "content_sanskrit": "एतत् तेऽभिहितं क्षत्तर्यन्मां त्वं परिपृष्टवान्।\nप्रचेतसां नारदस्य संवादं हरिकीर्तनम्॥ ४/३१/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_031/BhP_04.031.034.m4a", "display_order": 35}, {"id": 6000095035, "chapter_id": 10095, "verse_number": "४-३१-३१", "content_sanskrit": "य एष उत्तानपदो मानवस्यानुवर्णितः।\nवंशं प्रियव्रतस्यापि निबोध नृपसत्तम॥ ४/३१/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_031/BhP_04.031.035.m4a", "display_order": 36}, {"id": 6000095036, "chapter_id": 10095, "verse_number": "४-३१-३२", "content_sanskrit": "यो नारदादात्मविद्यामधिगम्य पुनर्महीम्।\nभुक्त्वा विभज्य पुत्रेभ्य ऐश्वरं समगात् पदम्॥ ४/३१/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_031/BhP_04.031.036.m4a", "display_order": 37}, {"id": 6000095037, "chapter_id": 10095, "verse_number": "४-३१-३३", "content_sanskrit": "इत्थं तु कौषारविणोपवर्णितां क्षत्ता निशम्याजितपादसत्कथाम्।\nप्रवृद्धभावाश्रुकलाकुलो मुनेर्दधार मूर्ध्ना चरणं हृदा हरेः॥ ४/३१/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_031/BhP_04.031.037.m4a", "display_order": 38}, {"id": 6000095038, "chapter_id": 10095, "verse_number": null, "content_sanskrit": "विदुर उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_031/BhP_04.031.038.m4a", "display_order": 39}, {"id": 6000095039, "chapter_id": 10095, "verse_number": "४-३१-३४", "content_sanskrit": "सोऽयं तेन महायोगिन् भवता करुणात्मना।\nदर्शितस्तमसः पारो यत्राकिञ्चनगो हरिः॥ ४/३१/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_031/BhP_04.031.039.m4a", "display_order": 40}, {"id": 6000095040, "chapter_id": 10095, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_031/BhP_04.031.040.m4a", "display_order": 41}, {"id": 6000095041, "chapter_id": 10095, "verse_number": "४-३१-३५", "content_sanskrit": "इत्यानम्य तमामन्त्र्य विदुरो गजसाह्वयम्।\nस्वानां दिदृक्षुः प्रययौ ज्ञातीनां निर्वृताशयः॥ ४/३१/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_031/BhP_04.031.041.m4a", "display_order": 42}, {"id": 6000095042, "chapter_id": 10095, "verse_number": "४-३१-३६", "content_sanskrit": "एतद् यः शृृणुयाद् राजन् राज्ञां हर्यर्पितात्मनाम्।\nआयुर्धनं यशः स्वस्ति गतिमैश्वर्यमाप्नुयात्॥ ४/३१/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_031/BhP_04.031.042.m4a", "display_order": 43}, {"id": 6000095043, "chapter_id": 10095, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां चतुर्थस्कन्धे एकत्रिंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 6000095044, "chapter_id": 10095, "verse_number": null, "content_sanskrit": "इति चतुर्थस्कन्धः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]