[{"id": 50024672, "chapter_id": 11876, "verse_number": "1", "content_sanskrit": "--- --- --- ---   नित्या एव हि चेतनाः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50024673, "chapter_id": 11876, "verse_number": "2", "content_sanskrit": "॥ गुणादिविवेकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50024674, "chapter_id": 11876, "verse_number": "3", "content_sanskrit": "गुणक्रियाजातिपूर्वा धर्माः सर्वेऽपि वस्तुनः॥ ९॥ रूपमेव द्विधं तच्च यावद्वस्तु च खण्डितम्। खण्डिते भेद ऐक्यं च यावद्वस्तु न भेदवत्॥ १०॥ खण्डितं रूपमेवात्र विकारोऽपि विकारिणः। कार्यकारणयोश्चैव तथैव गुणतद्वतोः॥ ११॥ क्रियाक्रियावतोस्तद्वत् तथा जातिविशेषयोः। 【पाठभेदः: BG—क्रियाक्रियावतोश्चैव तथैवांशांशिनोरपि॥ १२॥】 विशिष्टशुद्धयोश्चैव तथैवांशांशिनोरपि॥ १२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50024675, "chapter_id": 11876, "verse_number": "4", "content_sanskrit": "॥ उपसंहारः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50024676, "chapter_id": 11876, "verse_number": "5", "content_sanskrit": "य एतत् परतन्त्रं तु सर्वमेव हरेः सदा। वशमित्येव जानाति संसारान्मुच्यते हि सः॥ १३॥”", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50024677, "chapter_id": 11876, "verse_number": "6", "content_sanskrit": "॥ इति श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचितस्तत्त्वविवेकः सम्पूर्णः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}]