[{"id": 7004055000, "chapter_id": 24055, "verse_number": "४-४-१", "content_sanskrit": "सूत उवाच ।\nमुनिपृष्टास्तदा देवा भगवंस्ते किमब्रुवन् ।\nसर्वलोकहितार्थाय तदाख्याहि महामुने ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004055001, "chapter_id": 24055, "verse_number": "४-४-२", "content_sanskrit": "श्रीव्यास उवाच ।\nअगस्तिवचनं श्रुत्वा बहुमानपुरस्सरम् ।\nधिषणाधिपतेरास्यं विबुधा व्यालुलोकिरे ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004055002, "chapter_id": 24055, "verse_number": "४-४-३", "content_sanskrit": "वाक्पतिरुवाच ।\nशृण्वगस्ते महाभाग देवागमनकारणम् ।\nधन्योसि कृतकृत्योसि मान्योसि महता मपि ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004055003, "chapter_id": 24055, "verse_number": "४-४-४", "content_sanskrit": "प्रत्याश्रमं प्रतिनगं प्रत्यरण्यं तपोधनाः ।\nकिं न संति मुनिश्रेष्ठ काचिदन्यैव ते स्थितिः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004055004, "chapter_id": 24055, "verse_number": "४-४-५", "content_sanskrit": "तपोलक्ष्मीस्त्वयीहास्ति ब्राह्मतेजस्त्वयि स्थिरम् ।\nपुण्यलक्ष्मीस्त्वयि परा त्वय्यौदार्यं मनस्त्वयि ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004055005, "chapter_id": 24055, "verse_number": "४-४-६", "content_sanskrit": "पतिव्रतेयं कल्याणी लोपामुद्रा सधर्मिणी ।\nतवांगच्छायया तुल्या यत्कथापुण्यकारिणी ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004055006, "chapter_id": 24055, "verse_number": "४-४-७", "content_sanskrit": "पतिव्रतास्वरुंधत्या सावित्र्याप्यनसूयया ।\nशांडिल्यया च सत्या च लक्ष्म्या च शतरूपया ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004055007, "chapter_id": 24055, "verse_number": "४-४-८", "content_sanskrit": "मेनया च सुनीत्या च संज्ञया स्वाहया तथा ।\nयथैषा वर्ण्यते श्रेष्ठा न तथान्येति निश्चितम ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004055008, "chapter_id": 24055, "verse_number": "४-४-९", "content_sanskrit": "भुंक्ते भुक्ते त्वयि मुने तिष्ठति त्वयि तिष्ठति ।\nविनिद्रिते च निद्राति प्रथमं प्रतिबुध्यते ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004055009, "chapter_id": 24055, "verse_number": "४-४-१०", "content_sanskrit": "अनलंकृतमात्मानं तव नो दर्शयेत्क्वचित् ।\nकार्यार्थं प्रोषिते क्वापि सर्वमंडनवर्जिता ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004055010, "chapter_id": 24055, "verse_number": "४-४-११", "content_sanskrit": "न च ते नाम गृह्णीयात्तवायुष्यविवृद्धये ।\nपुरुषांतरनामापि न गृह्णाति कदाचन ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004055011, "chapter_id": 24055, "verse_number": "४-४-१२", "content_sanskrit": "आक्रुष्टापि न चाक्रोशेत्ताडितापि प्रसीदति ।\nइदं कुरु कृतं स्वामिन्मन्यतामिति वक्ति च ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004055012, "chapter_id": 24055, "verse_number": "४-४-१३", "content_sanskrit": "आहूता गृहकार्याणि त्यक्त्वा गच्छति सत्वरम् ।\nकिमर्थं व्याहृता नाथ सप्रसादो विधीयताम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004055013, "chapter_id": 24055, "verse_number": "४-४-१४", "content_sanskrit": "न चिरं तिष्ठति द्वारि न द्वारमुपसेवते ।\nअदापितं त्वया किंचित्कस्मैचिन्न ददात्यपि ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004055014, "chapter_id": 24055, "verse_number": "४-४-१५", "content_sanskrit": "पूजोपकरणं सर्वमनुक्ता साधयेत्स्वयम् ।\nनियमोदकबर्हींषि पत्रपुप्पाक्षतादिकम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004055015, "chapter_id": 24055, "verse_number": "४-४-१६", "content_sanskrit": "प्रतीक्षमाणावसरं यथाकालोचितं हि यत् ।\nतदुपस्थापयेत्सर्वमनुद्विग्नातिहृष्टवत् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004055016, "chapter_id": 24055, "verse_number": "४-४-१७", "content_sanskrit": "सेवते भर्त्तुरुच्छिष्टमिष्टमन्नं फलादिकम् ।\nमहाप्रसाद इत्युक्त्वा परिदत्तं प्रतीच्छति ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004055017, "chapter_id": 24055, "verse_number": "४-४-१८", "content_sanskrit": "अविभज्य न चाश्नीयाद्देवपित्रतिथिष्वपि ।\nपरिचारकवर्गेषु गोषु भिक्षुकुलेषु च ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004055018, "chapter_id": 24055, "verse_number": "४-४-१९", "content_sanskrit": "संयतोपस्करादक्षा हृष्टा व्यय पराङ्मुखी ।\nकुर्यात्त्वयाननुज्ञाता नोपवासव्रतादिकम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004055019, "chapter_id": 24055, "verse_number": "४-४-२०", "content_sanskrit": "दूरतो वर्जयेदेषा समाजोत्सवदर्शनम् ।\nन गच्छेत्तीर्थयात्रादि विवाहप्रेक्षणादिषु ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004055020, "chapter_id": 24055, "verse_number": "४-४-२१", "content_sanskrit": "सुखसुप्तं सुखासीनं रममाणं यदृच्छया ।\nआंतरेष्वपि कार्येषु पतिं नोत्थापयेत्क्वचित् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004055021, "chapter_id": 24055, "verse_number": "४-४-२२", "content_sanskrit": "स्त्रीधर्मिणी त्रिरात्रं तु स्वमुखं नैव दर्श येत् ।\nस्ववाक्यं श्रावयेन्नापि यावत्स्नाता न शुद्धितः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004055022, "chapter_id": 24055, "verse_number": "४-४-२३", "content_sanskrit": "सुस्नाता भर्तृवदनमीहतेन्यस्य न क्वचित् ।\nअथवा मनसि ध्यात्वा पतिं भानुं विलोकयेत् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004055023, "chapter_id": 24055, "verse_number": "४-४-२४", "content_sanskrit": "हरिद्रां कुंकुमं चैव सिंदूर कज्जलं तथा ।\nकूर्पासकं च तांबूलं मांगल्याभरणं शुभम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004055024, "chapter_id": 24055, "verse_number": "४-४-२५", "content_sanskrit": "केशसंस्कारकबरी करकर्णादिभूषणम् ।\nभर्त्तुरायुष्यमिच्छंती दूरये न्न पतिव्रता ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004055025, "chapter_id": 24055, "verse_number": "४-४-२६", "content_sanskrit": "न रजक्या न हैतुक्या तथा श्रमणया न च ।\nन च दुर्भगया क्वापि सखित्वं कुरुते सती ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004055026, "chapter_id": 24055, "verse_number": "४-४-२७", "content_sanskrit": "भर्तृविद्वेषिणीं नारीं नैषा संभाषते क्वचित् ।\nनैकाकिनी क्वचिद्भूयान्न नग्ना स्नाति च क्वचित् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004055027, "chapter_id": 24055, "verse_number": "४-४-२८", "content_sanskrit": "नोलूखले न मुसले न वर्द्धन्यां दृषद्यपि ।\nन यंत्रकेन देहल्यां सती चोपविशेत्क्वचित् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004055028, "chapter_id": 24055, "verse_number": "४-४-२९", "content_sanskrit": "विना व्यवायसमयं प्रागल्भ्यं न क्वचिच्चरेत् ।\nयत्रयत्ररुचिर्भर्त्तुस्तत्र प्रेमवती सदा ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004055029, "chapter_id": 24055, "verse_number": "४-४-३०", "content_sanskrit": "इदमेव व्रतं स्त्रीणामयमेवपरो वृषः ।\nइयमेको देवपूजा भर्त्तुर्वाक्यं न लंघयेत ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004055030, "chapter_id": 24055, "verse_number": "४-४-३१", "content_sanskrit": "क्लीबं वा दुरवस्थंवा व्याधितं वृद्धमेव वा ।\nसुस्थितं दुःस्थितं वापि पतिमेकं न लंघयेत ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004055031, "chapter_id": 24055, "verse_number": "४-४-३२", "content_sanskrit": "हृष्टाहृष्टेविषण्णास्या विषण्णास्ये प्रिये सदा ।\nएकरूपा भवेत्पुण्या संपत्सु च विपत्सु च ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004055032, "chapter_id": 24055, "verse_number": "४-४-३३", "content_sanskrit": "सर्पिर्लवणतैलादि क्षयेपि च पतिव्रता ।\nपतिं नास्तीति न ब्रूयादायासेषु न योजयेत् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004055033, "chapter_id": 24055, "verse_number": "४-४-३४", "content_sanskrit": "तीर्थस्नानार्थिनी नारी पतिपादोदकं पिबेत् ।\nशंकरादपि विष्णोर्वा पतिरेकोधिकः स्त्रियाः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004055034, "chapter_id": 24055, "verse_number": "४-४-३५", "content_sanskrit": "व्रतोपवासनियमं पतिमुल्लंघ्य या चरेत् ।\nआयुष्यं हरते भर्त्तुर्मृता निरयमृच्छति ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004055035, "chapter_id": 24055, "verse_number": "४-४-३६", "content_sanskrit": "उक्ता प्रत्युत्तरं दद्याद्या नारी क्रोधतत्परा ।\nसरमा जायते ग्रामे सृगाली निर्जने वने ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004055036, "chapter_id": 24055, "verse_number": "४-४-३७", "content_sanskrit": "स्त्रीणां हि परमश्चैको नियमः समुदाहृतः॥ऽ  ।\nअभ्यर्च्य चरणौ भर्त्तुर्भोक्तव्यं कृतनिश्चयम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004055037, "chapter_id": 24055, "verse_number": "४-४-३८", "content_sanskrit": "उच्चासनं न सेवेत न व्रजेत्परवेश्मसु ।\nन त्रपाकर वाक्यानि वक्तव्यानि कदाचन ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004055038, "chapter_id": 24055, "verse_number": "४-४-३९", "content_sanskrit": "अपवादो न वक्तव्यः कलहं दूरतस्त्यजेत् ।\nगुरूणां सन्निधौ क्वापि नोच्चैर्ब्रूयान्न वा हसेत् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004055039, "chapter_id": 24055, "verse_number": "४-४-४०", "content_sanskrit": "या भर्तारं परित्यज्य रहश्चरति दुर्मतिः ।\nउलूकी जायते क्रूरा वृक्षकोटरशायिनी ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004055040, "chapter_id": 24055, "verse_number": "४-४-४१", "content_sanskrit": "ताडिता ताडितुं चेच्छेत्सा व्याघ्री वृषदंशिका ।\nकटाक्षयतियाऽन्यं वै केकराक्षी तु सा भवेत ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004055041, "chapter_id": 24055, "verse_number": "४-४-४२", "content_sanskrit": "या भर्तारं परित्यज्य मिष्टमऽश्नाति केवलम् ।\nग्रामे वासकरी भूयाद्वल्गुर्वापि श्वविट्भुजा ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004055042, "chapter_id": 24055, "verse_number": "४-४-४३", "content_sanskrit": "या त्वं कृत्याऽप्रियं ब्रूते मूका सा जायते खलु ।\nया सपत्नीं सदेर्ष्येत दुर्भगा सा पुनःपुन्ः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004055043, "chapter_id": 24055, "verse_number": "४-४-४४", "content_sanskrit": "दृष्टिं विलुप्य भर्तुर्या कंचिदन्यं समीक्षते ।\nकाणा च विमुखी चापि कुरूपा चापि जायते ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004055044, "chapter_id": 24055, "verse_number": "४-४-४५", "content_sanskrit": "बाह्यादायांतमालोक्य त्वरिता च जलाशनैः ।\nतांबूलैर्व्यजनैश्चैव पादसंवाहनादिभिः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004055045, "chapter_id": 24055, "verse_number": "४-४-४६", "content_sanskrit": "तथैव चाटुवचनैः खेदसंनोदनैः परैः ।\nया प्रियं प्रीणयेत्प्रीता त्रिलोकी प्रीणिता तया ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004055046, "chapter_id": 24055, "verse_number": "४-४-४७", "content_sanskrit": "मितं ददाति हि पिता मितं भ्राता मितं सुतः ।\nअमितस्य हि दातारं भर्त्तारं पूजये त्सदा ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004055047, "chapter_id": 24055, "verse_number": "४-४-४८", "content_sanskrit": "भर्ता देवो गुरुर्भर्ता धर्म तीर्थ व्रतानि च ।\nतस्मात्सर्वं परित्यज्य पतिमेकं समर्चयेत ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004055048, "chapter_id": 24055, "verse_number": "४-४-४९", "content_sanskrit": "जीवहीनो यथा देहः क्षणादशुचितां व्रजेत् ।\nभर्तृहीना तथा योषित्सुस्नाताप्यशुचिः सदा ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004055049, "chapter_id": 24055, "verse_number": "४-४-५०", "content_sanskrit": "अमंगलेभ्यः सर्वेभ्यो विधवा त्यक्तमंगला ।\nविधवा दर्शनात्सिद्धिः क्वापि जातु न जायते ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004055050, "chapter_id": 24055, "verse_number": "४-४-५१", "content_sanskrit": "विहाय मातरं चैकां सर्वमंगलवर्जिताम ।\nतदाशिषमपि प्राज्ञस्त्यजेदाशीविषोपमाम ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004055051, "chapter_id": 24055, "verse_number": "४-४-५२", "content_sanskrit": "कन्याविवाहसमये वाचयेयुरिति द्विजाः ।\nभर्तुः सहचरी भूयाज्जीवतोऽजीवतोपिवा ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004055052, "chapter_id": 24055, "verse_number": "४-४-५३", "content_sanskrit": "भर्ता सदानुयातव्यो देहवच्छायया स्त्रिया ।\nचंद्रमा ज्योत्स्नया यद्वद्विद्युत्वान्विद्युता यथा ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004055053, "chapter_id": 24055, "verse_number": "४-४-५४", "content_sanskrit": "अनुव्रजति भर्तारं गृहात्पितृवनं मुदा ।\nपदेपदेऽश्वमेधस्य फलं प्राप्नोत्यसंशयम ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004055054, "chapter_id": 24055, "verse_number": "४-४-५५", "content_sanskrit": "व्यालग्राही यथा व्यालं बलादुद्धरते बिलात ।\nएवमुत्क्रम्य दूतेभ्यः पतिं स्वर्गं नयेत्सती ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004055055, "chapter_id": 24055, "verse_number": "४-४-५६", "content_sanskrit": "यमदूताः पलायंते सतीमालोक्य दूरतः ।\nअपि दुष्कृतकर्माणं समुत्सृज्य च तत्पतिम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004055056, "chapter_id": 24055, "verse_number": "४-४-५७", "content_sanskrit": "न तथा बिभीमो वह्नेर्नतथा विद्युतो यथा ।\nआपतंतीं समालोक्य वयं दूताः पतिव्रताम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004055057, "chapter_id": 24055, "verse_number": "४-४-५८", "content_sanskrit": "तपनस्तप्यतेत्यंतं दहनोपि च दह्यते ।\nकंपंते सर्व तेजांसि दृष्ट्वा पातिव्रतं महः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004055058, "chapter_id": 24055, "verse_number": "४-४-५९", "content_sanskrit": "यावत्स्वलोमसंख्यास्ति तावत्कोट्ययुतानि च ।\nभर्त्रा स्वर्गसुखं भुंक्ते रममाणा पतिव्रता ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004055059, "chapter_id": 24055, "verse_number": "४-४-६०", "content_sanskrit": "धन्या सा जननी लोके धन्योसौ जनकः पुनः ।\nधन्यः स च पतिः श्रीमान्येषां गेहे पतिव्रता ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004055060, "chapter_id": 24055, "verse_number": "४-४-६१", "content_sanskrit": "पितृवंश्यामातृवंश्याःपतिवंश्यास्त्रयस्त्रयः ।\nपतिव्रतायाः पुण्येन स्वर्गसौख्यानि भुंजते ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004055061, "chapter_id": 24055, "verse_number": "४-४-६२", "content_sanskrit": "शीलभंगेन दुर्वृत्ताः पातयंति कुलत्रयम् ।\nपितुर्मातुस्तथापत्युरिहामुत्र च दुःखिताः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004055062, "chapter_id": 24055, "verse_number": "४-४-६३", "content_sanskrit": "पतिव्रतायाश्चरणो यत्र यत्र स्पृशेद्भुवम् ।\nतत्रेति भूमिर्मन्येत नात्र भारोस्तिपावनी ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004055063, "chapter_id": 24055, "verse_number": "४-४-६४", "content_sanskrit": "बिभ्यत्पतिव्रतास्पर्शं कुरुते भानुमानपि ।\nसोमो गंधवहश्चापि स्वपावित्र्याय नान्यथा ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004055064, "chapter_id": 24055, "verse_number": "४-४-६५", "content_sanskrit": "आपः पतिव्रता स्पर्शमभिलष्यंति सर्वदा ।\nअद्य जाड्यविनाशो नो जातास्त्वद्याऽन्यपावनाः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004055065, "chapter_id": 24055, "verse_number": "४-४-६६", "content_sanskrit": "गृहेगृहे न किं नार्यो रूपलावण्यगर्विताः ।\nपरं विश्वेशभक्त्यैव लभ्यते स्त्री पतिव्रता ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004055066, "chapter_id": 24055, "verse_number": "४-४-६७", "content_sanskrit": "भार्या मूलं गृहस्थस्य भार्या मूलं सुखस्य च ।\nभार्या धर्मफला भार्या सं तानवृद्धये ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004055067, "chapter_id": 24055, "verse_number": "४-४-६८", "content_sanskrit": "परलोकस्त्वयं लोको जीयते भार्यया द्वयम् ।\nदेवपित्रतिथीज्यादि नाभार्यः कर्म चार्हति ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004055068, "chapter_id": 24055, "verse_number": "४-४-६९", "content_sanskrit": "गृहस्थः स हि विज्ञेयो यस्य गेहे पतिव्रता ।\nग्रसतेऽन्या प्रतिपदं राक्षस्या जरयाथवा ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004055069, "chapter_id": 24055, "verse_number": "४-४-७०", "content_sanskrit": "यथा गंगाऽवगाहेन शरीरं पावनं भवेत् ।\nतथा पतिव्रता दृष्ट्या शुभया पावनं भवेत् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004055070, "chapter_id": 24055, "verse_number": "४-४-७१", "content_sanskrit": "अनुयाति न भर्तारं यदि दैवात्कथंचन ।\nतत्रापि शीलं संरक्ष्यं शीलभंगात्पतत्यधः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004055071, "chapter_id": 24055, "verse_number": "४-४-७२", "content_sanskrit": "तद्वैगुण्यादपिस्वर्गात्पतिः पतति नान्यथा ।\nतस्याः पिता च माता च भ्रातृवर्गस्तथैव च ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004055072, "chapter_id": 24055, "verse_number": "४-४-७३", "content_sanskrit": "पत्यौ मृते च यायोषिद्वैधव्यं पालयेत्क्वचित् ।\nसा पुनः प्राप्य भर्तारं स्वर्गभोगान्समश्नुते ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004055073, "chapter_id": 24055, "verse_number": "४-४-७४", "content_sanskrit": "विधवा कबरीबंधो भर्तृबंधाय जायते ।\nशिरसो वपनं तस्मात्कार्यं विधवया सदा ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004055074, "chapter_id": 24055, "verse_number": "४-४-७५", "content_sanskrit": "एकाहारः सदा कार्यो न द्वितीयं कदाचन ।\nत्रिरात्रं पंचरात्रं वा पक्षव्रतमथापि वा ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004055075, "chapter_id": 24055, "verse_number": "४-४-७६", "content_sanskrit": "मासोपवासं वा कुर्याच्चांद्रायणमथापि वा ।\nकृच्छ्रं वराकं वा कुर्यात्तप्तकृच्छ्रमथापि वा ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004055076, "chapter_id": 24055, "verse_number": "४-४-७७", "content_sanskrit": "यवान्नैर्वा फलाहारैः शाकाहारैः पयोव्रतैः ।\nप्राणयात्रां प्रकुर्वीत यावत्प्राणः स्वयं व्रजेत् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004055077, "chapter_id": 24055, "verse_number": "४-४-७८", "content_sanskrit": "पर्यंकशायिनी नारी वि धवा पातयेत्पतिम् ।\nतस्माद्भूशयनं कार्यं पतिसौख्यसमीहया ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004055078, "chapter_id": 24055, "verse_number": "४-४-७९", "content_sanskrit": "न चांगोद्वर्तनं कार्यं स्त्रिया विधवया क्वचित् ।\nगंधद्रव्यस्य संयोगो नैव कार्यस्तया पुनः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004055079, "chapter_id": 24055, "verse_number": "४-४-८०", "content_sanskrit": "तर्पणं प्रत्यहं कार्यं भर्तुः कुशतिलोदकैः ।\nतत्पितुस्तत्पितुश्चापि नामगोत्रादिपूर्वकम ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004055080, "chapter_id": 24055, "verse_number": "४-४-८१", "content_sanskrit": "विष्णोस्तु पूजनं कार्यं पति बुद्ध्या न चान्यथा ।\nपतिमेव सदा ध्यायेद्विष्णुरूपधरं हरिम् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004055081, "chapter_id": 24055, "verse_number": "४-४-८२", "content_sanskrit": "यद्यदिष्टतमं लोके यच्च पत्युः समीहितम् ।\nतत्तद्गुणवते देयं पतिप्रीणनकाम्यया ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7004055082, "chapter_id": 24055, "verse_number": "४-४-८३", "content_sanskrit": "वैशाखे कार्तिके माघे विशेषनियमांश्चरेत् ।\nस्नानं दानं तीर्थयात्रां विष्णोर्नामग्रहं मुहुः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7004055083, "chapter_id": 24055, "verse_number": "४-४-८४", "content_sanskrit": "वैशाखे जलकुंभांश्च कार्तिके घृतदीपकाः ।\nमाघे धान्य तिलोत्सर्गः स्वर्गलोके विशिष्यते ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7004055084, "chapter_id": 24055, "verse_number": "४-४-८५", "content_sanskrit": "प्रपा कार्या च वैशाखे देवे देया गलंतिका ।\nउपानद्व्यजनं छत्रं सूक्ष्मवासांसि चन्दनम् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7004055085, "chapter_id": 24055, "verse_number": "४-४-८६", "content_sanskrit": "सकर्पूरं च तांबूलं पुष्पदानं तथैव च ।\nजलपात्राण्यनेकानि तथा पुष्प गृहाणि च ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7004055086, "chapter_id": 24055, "verse_number": "४-४-८७", "content_sanskrit": "पानानि च विचित्राणि द्राक्षा रंभा फलानि च ।\nदेयानि द्विजमुख्येभ्यः पतिर्मे प्रीयतामिति ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7004055087, "chapter_id": 24055, "verse_number": "४-४-८८", "content_sanskrit": "ऊर्जे यवान्नमश्नीयादेकान्नमथवा पुनः ।\nवृंताकं सूरणं चैव शूकशिंबिं च वर्जयेत् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7004055088, "chapter_id": 24055, "verse_number": "४-४-८९", "content_sanskrit": "कार्तिके वर्जयेत्तैलं कार्तिके वर्जये न्मधु ।\nकार्तिके वर्जयेत्कांस्यं कार्तिके चापिसंधितम् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7004055089, "chapter_id": 24055, "verse_number": "४-४-९०", "content_sanskrit": "कार्तिके मौननियमे घंटां चारु प्रदापयेत ।\nपत्रभोजी कांस्यपात्रं घृतपूर्णं प्रयच्छति ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7004055090, "chapter_id": 24055, "verse_number": "४-४-९१", "content_sanskrit": "भूमिशय्याव्रते देया शय्या श्लक्ष्णा सतूलिका ।\nफलत्यागे फलं देयं रसत्यागे च तद्रसम् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7004055091, "chapter_id": 24055, "verse_number": "४-४-९२", "content_sanskrit": "धान्यत्यागे च तद्धान्यमथवा शालयः स्मृताः ।\nधेनूर्दद्यात्प्रयत्नेन सालंकाराः सकांचनाः ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7004055092, "chapter_id": 24055, "verse_number": "४-४-९३", "content_sanskrit": "एकतः सर्वदानानि दीपदानं तथैकतः ।\nकार्तिके दीपदानस्य कलां नार्हंति षोडशीम् ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7004055093, "chapter_id": 24055, "verse_number": "४-४-९४", "content_sanskrit": "किंचिदभ्युदिते सूर्ये माघस्नानं समाचरेत् ।\nयथाशक्त्या च नियमान्माघस्नायी समाचरेत् ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7004055094, "chapter_id": 24055, "verse_number": "४-४-९५", "content_sanskrit": "पक्वान्नैर्भो जयेद्विप्रान्यतिनोपि तपस्विनः ।\nलड्डुकैः फेणिकाभिश्च वटकेंडरिकादिभिः ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7004055095, "chapter_id": 24055, "verse_number": "४-४-९६", "content_sanskrit": "घृतपक्वैः समीरचैः शुचिकर्पूरवासितैः ।\nगर्भे शर्करया पूर्णैर्नेत्रानं दैः सुगंधिभिः ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7004055096, "chapter_id": 24055, "verse_number": "४-४-९७", "content_sanskrit": "शुष्केंधनानां भारांश्च दद्याच्छीतापनुत्तये ।\nकंचुकं तूलगर्भं च तूलिकां सूपवीतिकाम् ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7004055097, "chapter_id": 24055, "verse_number": "४-४-९८", "content_sanskrit": "मंजिष्ठा रक्तवासांसि तथा तूलवतीं पटीम् ।\nजातीफल लवंगैश्च तांबूलानि बहून्यपि ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7004055098, "chapter_id": 24055, "verse_number": "४-४-९९", "content_sanskrit": "कंबलानि विचित्राणि निर्वातानि गृहाणि च ।\nमृदुलाः पादरक्षाश्च सुगंध्युद्वर्त्तनानि च ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7004055099, "chapter_id": 24055, "verse_number": "४-४-१००", "content_sanskrit": "घृतकंबलपूजाभिर्महास्नानपुरःसरम् ।\nकृष्णागुरुप्रभृतिभिर्गर्भागारे प्रधूपनैः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7004055100, "chapter_id": 24055, "verse_number": "४-४-१०१", "content_sanskrit": "स्थूलवर्तिप्रदीपैश्च नैवेद्यैर्विविधैस्तथा ।\nभर्तृस्वरूपो भगवान्प्रीयतामिति चोच्चरेत् ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7004055101, "chapter_id": 24055, "verse_number": "४-४-१०२", "content_sanskrit": "एवंविधैश्च विधवा विविधैर्नियमैर्व्रतैः ।\nवैशाखान्कार्तिकान्माघानेवमेवातिवाहयेत् ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7004055102, "chapter_id": 24055, "verse_number": "४-४-१०३", "content_sanskrit": "नाधिरोहेदनड्वाहं प्राणैः कंठगतैरपि ।\nकंचुकं न परीदध्याद्वासो न विकृतं न्यसेत् ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7004055103, "chapter_id": 24055, "verse_number": "४-४-१०४", "content_sanskrit": "अपृष्ट्वा तु सुतान्किंचिन्न कुर्याद्भर्तृतत्परा ।\nएवं चर्यापरा नित्यं विधवापि शुभा मता ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7004055104, "chapter_id": 24055, "verse_number": "४-४-१०५", "content_sanskrit": "एवं धर्मसमायुक्ता विधवापि पतिव्रता ।\nपतिलोकानवाप्नोति नभवेत्क्वापि दुःखभाक् ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7004055105, "chapter_id": 24055, "verse_number": "४-४-१०६", "content_sanskrit": "न गंगया तया भेदो या नारी पतिदेवता ।\nउमाशिवसमा साक्षात्त स्मात्तां पूजयेद्बुधः ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7004055106, "chapter_id": 24055, "verse_number": "४-४-१०७", "content_sanskrit": "बृहस्पतिरुवाच ।\nगंगास्नानफलं त्वेतद्यज्जातं तव दर्शनम् ।\nलोपामुद्रे महामातर्भर्तृपादांबुजेक्षणे ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7004055107, "chapter_id": 24055, "verse_number": "४-४-१०८", "content_sanskrit": "इति स्तुत्वा महाभागां राजपुत्रीं पतिव्रताम् ।\nप्रणम्य च गुरुः प्राह मुनिं सर्वार्थकोविदः ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7004055108, "chapter_id": 24055, "verse_number": "४-४-१०९", "content_sanskrit": "प्रणवस्त्वं श्रुतिरियं क्षमैषा त्वं स्वयं तपः ।\nसत्क्रियेयं फलं त्वं हि धन्योसीति महामुने ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7004055109, "chapter_id": 24055, "verse_number": "४-४-११०", "content_sanskrit": "इदं पातिव्रतं तेजो ब्रह्मतेजो भवान्परम् ।\nतत्राप्येतत्तपस्तेजः किमसाध्यतमं तव ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7004055110, "chapter_id": 24055, "verse_number": "४-४-१११", "content_sanskrit": "तव नाविदितं किंचित्तथापि च वदाम्यहम् ।\nयदर्थमागता देवास्तन्मुनेत्र निशामय ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7004055111, "chapter_id": 24055, "verse_number": "४-४-११२", "content_sanskrit": "अयं शतमखः श्रीमान्वृत्रहा कुलिशायुधः ।\nसिद्ध्यष्टकं हि यद्द्वारि दृक्प्रसादं समीक्षते ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7004055112, "chapter_id": 24055, "verse_number": "४-४-११३", "content_sanskrit": "यस्यपुर्याः परिसरे कामधेनु व्रजश्चरेत् ।\nयत्पौराः कल्पवृक्षाणां नित्यं छायासु शेरते ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7004055113, "chapter_id": 24055, "verse_number": "४-४-११४", "content_sanskrit": "यद्रथ्यासु च तिष्ठंति ते चिंतामणिकर्कराः ।\nअयमग्निर्जगद्योनिर्धर्मराजस्त्वयं पुनः ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7004055114, "chapter_id": 24055, "verse_number": "४-४-११५", "content_sanskrit": "निरृतिर्वरुणोवायुःश्रीदरुद्रादयस्त्वमी ।\nआराध्यंते च चारित्रैः सर्वकामार्थ मीश्वराः ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7004055115, "chapter_id": 24055, "verse_number": "४-४-११६", "content_sanskrit": "ममभ्यर्थयितारोमी त्वं याच्यस्तु जगत्कृते ।\nवाङ्मात्रोद्यमसाध्यं तत्तवविश्वोपकारकम् ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7004055116, "chapter_id": 24055, "verse_number": "४-४-११७", "content_sanskrit": "कश्चिच्छैलो विंध्यनामा भानुमार्गावरोधकः ।\nवर्धितः स्पर्धया मेरोस्तद्वृद्धिं त्वं निवारय ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7004055117, "chapter_id": 24055, "verse_number": "४-४-११८", "content_sanskrit": "ये च स्वभावकठिना ये च मार्गावरोधकाः ।\nये स्पर्द्धया वृद्धिमंतस्तद्वृद्धिर्वर्धिताऽशुभा ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7004055118, "chapter_id": 24055, "verse_number": "४-४-११९", "content_sanskrit": "इति श्रुत्वा गुरोर्वाक्यमविचार्य महामुनिः ।\nक्षणं मुनिःसमाधाय तथेति प्रत्युवाच ह ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7004055119, "chapter_id": 24055, "verse_number": "४-४-१२०", "content_sanskrit": "साधयिष्यामि वः कार्यं विसर्ज्येति दिवौकसः ।\nपुनश्चिंतापरो भूत्वाऽगस्तिर्ध्यानपरोभवत् ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7004055120, "chapter_id": 24055, "verse_number": "४-४-१२१", "content_sanskrit": "वेदव्यास उवाच ।\nइमं पतिव्रताध्यायं श्रुत्वा स्त्रीपुरुषोपिवा ।\nपापकंचुकमुत्सृज्य शक्रलोकं प्रयास्यति ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}]