[
  {
    "id": 20013467,
    "chapter_id": 6701,
    "verse_number": "9.1",
    "content_sanskrit": "अथ नवमः सर्गः । अथ संयमिक्षितिपतेर्वचनै- र्निगमार्थनिर्णयकरैः सनयैः । शमिताग्रहोऽपि पुनरप्यवद- त्कृतसंशयः सपदि कर्मजडः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "avatarnika": ""
  },
  {
    "id": 20013468,
    "chapter_id": 6701,
    "verse_number": "9.2",
    "content_sanskrit": "यतिराज संप्रति ममाभिनवा- न्न विषादितोऽस्म्यपजयादपि तु । अपि जैमिनीयवचनान्यहहो- न्मथितानि हीति भृशमस्मि कृशः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "avatarnika": ""
  },
  {
    "id": 20013469,
    "chapter_id": 6701,
    "verse_number": "9.3",
    "content_sanskrit": "स हि वेत्यनागतमतीतमपि प्रियकृत्समस्तजगतोऽधिकृतः । निगमप्रवर्तनविधौ स कथं तपसां निधिर्वितथसूत्रपदः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "avatarnika": ""
  },
  {
    "id": 20013470,
    "chapter_id": 6701,
    "verse_number": "9.4",
    "content_sanskrit": "इति संदिहानमवदत्तमसौ न हि जैमिनावपनयोऽस्ति मनाक् । प्रमिमीमहे न वयमेव मुने- र्हृदयं यथावदनभिज्ञतया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "avatarnika": ""
  },
  {
    "id": 20013471,
    "chapter_id": 6701,
    "verse_number": "9.5",
    "content_sanskrit": "यदि विद्यते कविजनाविदितं हृदयं मुनेस्तदिह वर्णय भोः । यदि युक्तमत्रभवता कथितं हृदि कुर्महे दलदहंकृतयः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "avatarnika": ""
  },
  {
    "id": 20013472,
    "chapter_id": 6701,
    "verse_number": "9.6",
    "content_sanskrit": "अभिसंधिमानपि परे विषय- प्रसरन्मतीननुजिघृक्षुरसौ । तदवाप्तिसाधनतया सकलं सुकृतं न्यरुक्षपदिति स्म परम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "avatarnika": ""
  },
  {
    "id": 20013473,
    "chapter_id": 6701,
    "verse_number": "9.7",
    "content_sanskrit": "वचनं तमेतमिति धर्मचयं विदधाति बोधजनिहेतुतया । तदपेक्षयैव स च मोक्षपरो निरधारयन्न परथेति वयम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "avatarnika": ""
  },
  {
    "id": 20013474,
    "chapter_id": 6701,
    "verse_number": "9.8",
    "content_sanskrit": "श्रुतयः क्रियार्थकतया सफला अतदर्थकानि तु वचांसि वृथा । इति सूत्रयन्ननु कथं मुनिरा- डपि सिद्धवस्तुपरतां मनुते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "avatarnika": ""
  },
  {
    "id": 20013475,
    "chapter_id": 6701,
    "verse_number": "9.9",
    "content_sanskrit": "श्रुतिराशिरद्वयपरोऽपि परं- परयाऽऽत्मबोधफलकर्मणि च । प्रसरत्कटाक्ष इति कार्यपर- त्वमसूचि तत्प्रकरणस्थगिराम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "avatarnika": ""
  },
  {
    "id": 20013476,
    "chapter_id": 6701,
    "verse_number": "9.10",
    "content_sanskrit": "ननु सच्चिदात्मपरताऽभिमता यदि कृत्स्नवेदनिवयस्य मुनेः । फलदातृतामपुरुषस्य वद- न्स कथं निराह परमेशमपि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "avatarnika": ""
  },
  {
    "id": 20013477,
    "chapter_id": 6701,
    "verse_number": "9.11",
    "content_sanskrit": "ननु कर्तृपूर्वकमिदं जगदि- त्यनुमानमागमवचांसि विना । परमेश्वरं प्रथयति श्रुतप- स्त्वनुवादमात्रमिति काणभुजाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "avatarnika": ""
  },
  {
    "id": 20013478,
    "chapter_id": 6701,
    "verse_number": "9.12",
    "content_sanskrit": "न कथंचिदौपनिषदं पुरुषं मनुते बृहन्तमिति वेदवचः । कथयत्यवेदविद्गोचरतां गमयेत्कथं तमनुमानमिदम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "avatarnika": ""
  },
  {
    "id": 20013479,
    "chapter_id": 6701,
    "verse_number": "9.13",
    "content_sanskrit": "इति भावमात्मनि निधाय मुनिः स निराकरोन्निशितयुक्तिशतैः । अनुमानमीश्वरपरं जगतः प्रभवं लयं फलमपीश्वरतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "avatarnika": ""
  },
  {
    "id": 20013480,
    "chapter_id": 6701,
    "verse_number": "9.14",
    "content_sanskrit": "तदिहास्मदुक्तविधया निषदा न विरुद्धमन्वपि मुनेर्वचसि । इति गूढभावमनवेक्ष्य बुधा- स्तमनीशवाच्यमिति ब्रुवते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "avatarnika": ""
  },
  {
    "id": 20013481,
    "chapter_id": 6701,
    "verse_number": "9.15",
    "content_sanskrit": "किमु तावतैव स निरीश्वरवा- द्यभवत्परात्मविदुषां प्रवरः । न निशाटनाहिततमः क्वचिद- प्यहनि प्रभां मलिनयेत्तरणेः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "avatarnika": ""
  },
  {
    "id": 20013482,
    "chapter_id": 6701,
    "verse_number": "9.16",
    "content_sanskrit": "इति जैमिनीयवचसां हृदयं कथितं निशम्य यतिकेसरिणा । मनसा ननन्द कविराण्नितरां स सशारदाश्च सदसस्पतयः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "avatarnika": ""
  },
  {
    "id": 20013483,
    "chapter_id": 6701,
    "verse_number": "9.17",
    "content_sanskrit": "विदिताशयोऽपि परिवर्तमना- ग्विशयः स जैमिनिमवाप हृदा । अवगन्तुमस्य वचसाऽपि पुनः स च संस्मृतः सविधमाप कवेः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "avatarnika": ""
  },
  {
    "id": 20013484,
    "chapter_id": 6701,
    "verse_number": "9.18",
    "content_sanskrit": "अवदच्च शृष्विति स भाष्यकृति मजेहाहि संशयमिमं सुमते । यदवोचदेष मम सूत्रतते- र्हृदयं तदेव मम नापरथा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "avatarnika": ""
  },
  {
    "id": 20013485,
    "chapter_id": 6701,
    "verse_number": "9.19",
    "content_sanskrit": "न ममैव वेद त्हृदयं यमिरा- डपितु श्रुतेः सकलशास्त्रततेः । यदभूद्भविष्यति भवत्तदपिं हायमेव वेद न तथा त्वितरः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "avatarnika": ""
  },
  {
    "id": 20013486,
    "chapter_id": 6701,
    "verse_number": "9.20",
    "content_sanskrit": "गुरुणा चिदेकरसतत्परता निरणायि हि श्रुतिशिरोवचसाम् । कथमेकसूत्रमपि तद्विमतं कथयाम्यहं तदुपसादितधीः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "avatarnika": ""
  },
  {
    "id": 20013487,
    "chapter_id": 6701,
    "verse_number": "9.21",
    "content_sanskrit": "अलमाकलय्य विशयं सुयशः शृणु मे रहस्यमिममेव परम् । त्वमेवेहि संसृतिनिमग्नजनो- त्तरणे गृहीतवपुषं पुरुषम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "avatarnika": ""
  },
  {
    "id": 20013488,
    "chapter_id": 6701,
    "verse_number": "9.22",
    "content_sanskrit": "आद्ये सत्त्वमुनिः सतां वितरति ज्ञानं द्वितीये युगे दत्तो द्वापरनामके तु सुमतिर्व्यासः कलौ शंकरः । इत्येवं स्फुटमीारतोऽस्य महिमा शैवे पुराणे यत- स्तस्य त्वं सुमते मते स्ववतरेः संसारवार्धिं तरेः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "avatarnika": ""
  },
  {
    "id": 20013489,
    "chapter_id": 6701,
    "verse_number": "9.23",
    "content_sanskrit": "इतिबोधितद्विजवरोऽन्तरधा- न्मनसोपगुह्य यमिनामृषभम् । स च यायजूकपरिषत्प्रमुखः प्रणिपत्य शंकरमवोचदिदम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "avatarnika": ""
  },
  {
    "id": 20013490,
    "chapter_id": 6701,
    "verse_number": "9.24",
    "content_sanskrit": "विदितोऽस्ति संप्रति भवाञ्जगतः प्रकृतिर्निरस्तसमतातिशयः । अवबोधमात्रवपुरप्यबुधो- द्धरणाय केवलमुपात्ततनुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "avatarnika": ""
  },
  {
    "id": 20013491,
    "chapter_id": 6701,
    "verse_number": "9.25",
    "content_sanskrit": "यदेकमुदितं पदं यतिवर त्रयीमस्तकै स्तदस्य परिपालकस्त्वमसि तत्त्वमस्यायुधः । परं गलितसौगतप्रलपितान्धकूपान्तरे पतत्कथमिवान्यथा प्रलयमद्य नाऽऽपत्स्यते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "avatarnika": ""
  },
  {
    "id": 20013492,
    "chapter_id": 6701,
    "verse_number": "9.26",
    "content_sanskrit": "प्रबुद्धोऽहं स्वप्नादिति कृतमतिः स्वप्नमपरं यथा मूढः स्वप्ने कलयति तथा मोहवशगाः । विमुक्तिं मन्यन्ते कतिचिदिह लोकान्तरगतिं हसन्त्येतान्दासास्तव गलितमायाः परगुरोः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "avatarnika": ""
  },
  {
    "id": 20013493,
    "chapter_id": 6701,
    "verse_number": "9.27",
    "content_sanskrit": "मुहुर्धिग्धिग्भेदिप्रलपितविमुक्तिं यदुदयेऽ- प्यसारः संसारो विरमति न कर्तृत्वमुखरः । भृशं विद्मन्मोदे स्थिरतमविमुक्तिं त्वदुदितां भवातीता येयं निरवधिचिदानन्दलहरी ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "avatarnika": ""
  },
  {
    "id": 20013494,
    "chapter_id": 6701,
    "verse_number": "9.28",
    "content_sanskrit": "अविचाराक्षस्या गिलितमखिलेशं परगुरो पिचण्डं भित्त्वाऽस्याः सरभसमुषमादुदहरः । वृतां पश्यन्रक्षोयुवतिभिरमुष्य प्रियतमां हनूमाल्लोकेड्यस्तव तु कियती स्यान्महितता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "avatarnika": ""
  },
  {
    "id": 20013495,
    "chapter_id": 6701,
    "verse_number": "9.29",
    "content_sanskrit": "जगदार्तिहन्ननवगम्य पुरा महिमानमीदृशमचिन्त्यमहम् । तव यत्पुरोऽब्रुवमसांप्रतम- प्यखिलं क्षमस्व करुणाजलधे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "avatarnika": ""
  },
  {
    "id": 20013496,
    "chapter_id": 6701,
    "verse_number": "9.30",
    "content_sanskrit": "कपिलाक्षपादकणभुक्प्रमुखा अपि मोहमीयुरमितप्रतिभाः । श्रुतिभावनिर्णयविधावितरः प्रभवेत्कथं परशिवांशमृते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "avatarnika": ""
  },
  {
    "id": 20013497,
    "chapter_id": 6701,
    "verse_number": "9.31",
    "content_sanskrit": "समेतैरेतैः किं कपिलकणभुग्गौतमवच- स्तमस्तोमैश्वेतोमलिनिमसमारम्भणचणैः । सुधाधारोद्गारप्रचुरभगवत्पादवदन- प्ररोहद्वाहारामृतकिरणपुञ्जे विजयिनि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "avatarnika": ""
  },
  {
    "id": 20013498,
    "chapter_id": 6701,
    "verse_number": "9.32",
    "content_sanskrit": "भिन्दानैर्देवमेतैरभिनवयवनैः सद्गवीभञ्जनोत्कै- र्व्याप्ता सर्वेयमुर्वी क्व जगति भजतां कैवमुक्तिप्रसक्तिः । यद्वा सद्वादिराजा विजितकलिमला विष्णुतत्त्वानुरक्ता उज्जृम्भन्ते समन्ताद्दिशि दिशि कृतिनः किं तया चिन्तया मे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "avatarnika": ""
  },
  {
    "id": 20013499,
    "chapter_id": 6701,
    "verse_number": "9.33",
    "content_sanskrit": "कथंमलपबुद्धिविवृतिप्रचय- प्रबलोरगक्षतिहताः श्रुतयः । न यदि त्वदुक्त्यमृतसेकधृता विहरेयुरात्मविधुतानुशयाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 33,
    "avatarnika": ""
  },
  {
    "id": 20013500,
    "chapter_id": 6701,
    "verse_number": "9.34",
    "content_sanskrit": "भवदुक्तसूक्त्यमृतभानुकर । न चरेयुरार्य यदि कः शमयेत् । अतितीव्रदुःसहभवोष्णकर- प्रचुरातपप्रभवतापमिमम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34,
    "avatarnika": ""
  },
  {
    "id": 20013501,
    "chapter_id": 6701,
    "verse_number": "9.35",
    "content_sanskrit": "बत कर्मयन्त्रमधिरुह्य तपः- श्रुतगेहदारसुतभृत्यधनैः । अतिरूढमानभरितः पतितो भवतोद्धृतोऽस्मि भवकूपबिलात् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 35,
    "avatarnika": ""
  },
  {
    "id": 20013502,
    "chapter_id": 6701,
    "verse_number": "9.36",
    "content_sanskrit": "अहमाचरं बहु तपोऽसुकरं ननु पूर्वजन्मसु न चेदधुना । जगदीश्वरेण करुणानिधिना भवता कथा मम कथं घटते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 36,
    "avatarnika": ""
  },
  {
    "id": 20013503,
    "chapter_id": 6701,
    "verse_number": "9.37",
    "content_sanskrit": "शान्तिप्राक्सुकृताङ्कुरं दमसमुल्लासोलसत्पल्लवं वैराग्यद्रुमकोरकं सहनतावल्लीप्रसूनोत्करम् । ऐकाग्रीसुमनोमरन्दविसृतिं श्रद्धासमुद्यत्फलं विन्देयं सुगुरोर्गिरां परिचयं पुण्यैरगण्यैरहम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 37,
    "avatarnika": ""
  },
  {
    "id": 20013504,
    "chapter_id": 6701,
    "verse_number": "9.38",
    "content_sanskrit": "त्रिदिवौकसामपि पुमर्थकरी- मिह संसरज्जनविमुक्तिकरीम् । करुणोर्मिलां तव कटाक्षझरी- मवगाहतेऽत्र खलु धन्यतमः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 38,
    "avatarnika": ""
  },
  {
    "id": 20013505,
    "chapter_id": 6701,
    "verse_number": "9.39",
    "content_sanskrit": "केचिच्चञ्चललोचनाकुचतटीचेलाञ्चलोच्चालन- स्पर्शद्राक्परिरम्भसंभ्रमकलालीलासु लोलाशयाः । सन्त्वेते कृतिनस्तु निस्तुलयशःकोशादयः श्रीगुरु- व्याहारक्षरितामृताब्धिलहरीदोलासु खेलन्त्यमी ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 39,
    "avatarnika": ""
  },
  {
    "id": 20013506,
    "chapter_id": 6701,
    "verse_number": "9.40",
    "content_sanskrit": "चिन्तासंतानतन्तुग्रथितनवभवत्सूक्तिमुक्ताफलौघै- रुद्यद्वैशद्यसद्यःपरिहृततिमिरैर्हारिणो हारिणोऽमी । सन्तः संतोषवन्तो यतिवर किमतो मण्डनं पण्डितानां विद्या हृद्या स्वयं ताञ्छतमखमुखरान्वारयन्ती वृणीते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 40,
    "avatarnika": ""
  },
  {
    "id": 20013507,
    "chapter_id": 6701,
    "verse_number": "9.41",
    "content_sanskrit": "सन्तः संतोषपोषं दधतु तव कृताम्नायशोभैर्यशोभिः सौरालौकैरुलूका इव निखिलखला मोहमाहो वहन्तु । धीरश्रीशंकरार्यप्रणतिपरिणतिभ्रश्यदन्तर्दुरन्त- ध्वान्ताः सन्तो वयं तु प्रचुरतरनिजानन्दसिन्धौ निमग्नाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 41,
    "avatarnika": ""
  },
  {
    "id": 20013508,
    "chapter_id": 6701,
    "verse_number": "9.42",
    "content_sanskrit": "चिन्तासंतानशाखी पदसरसिजयोर्वन्दनं नन्दनं ते संकल्पः कल्पवल्ली मनसि गुणनुतेर्वर्णना स्वर्णदीथम् । स्वर्गो दृग्गोचरस्त्वत्पदभजनमतः संविचार्येदमार्या मन्यन्ते स्वर्गमन्यं तृणवदतिलघुं शंकरार्य त्वदीयाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 42,
    "avatarnika": ""
  },
  {
    "id": 20013509,
    "chapter_id": 6701,
    "verse_number": "9.43",
    "content_sanskrit": "तदहं विसृज्य सुतदारगृहं द्रविणानि कर्म च गृहे विहितम् । शरणं वृणोमि भगवच्चरणा- वनुशाधि किंकरममुं कृपया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 43,
    "avatarnika": ""
  },
  {
    "id": 20013510,
    "chapter_id": 6701,
    "verse_number": "9.44",
    "content_sanskrit": "इति सूनृतोक्तिभिरुदीर्णगुणः सुधियाऽऽत्मवाननुजिघृक्षुरसौ । समुदैक्षतास्य सहधर्मचरीं विदिताशया मुनिमवोचत सा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 44,
    "avatarnika": ""
  },
  {
    "id": 20013511,
    "chapter_id": 6701,
    "verse_number": "9.45",
    "content_sanskrit": "यतिपुण्डरीक तव वेद्मि मनो ननु पूर्वमेव विदितं च मया । इह भावि तापसमुखादखिलं तदुदीर्यते शृणु ससभ्यजनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 45,
    "avatarnika": ""
  },
  {
    "id": 20013512,
    "chapter_id": 6701,
    "verse_number": "9.46",
    "content_sanskrit": "मयि जातु मातुरुपकण्ठजुषि प्रभया तडित्प्रतिभटोच्चजटः । सितभूतिरूषितसमस्ततनुः श्रमणोऽभ्यगादपरसूर्य इव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 46,
    "avatarnika": ""
  },
  {
    "id": 20013513,
    "chapter_id": 6701,
    "verse_number": "9.47",
    "content_sanskrit": "परिगृह्य पाद्यमुख्याऽर्हणया रचिताञ्जलिर्नमितपूर्वतनुः । जननी तदाऽऽत्तवरिवस्यममुं मुनिमन्वयुङ्क्त मम भाव्यखिलम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 47,
    "avatarnika": ""
  },
  {
    "id": 20013514,
    "chapter_id": 6701,
    "verse_number": "9.48",
    "content_sanskrit": "भगवन्न वेद्मि दुहितुर्मम भा- व्यखिलं च वेत्ति तपसा हि भवान् । प्रणते जने हि सुधियः कथय- न्त्यपि गोप्यमार्यसदृशाः कृपया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 48,
    "avatarnika": ""
  },
  {
    "id": 20013515,
    "chapter_id": 6701,
    "verse_number": "9.49",
    "content_sanskrit": "कियदायुराप्स्यति सुतान्कति वा दयितं कथंविधमुपैष्यति च । अथ च क्रतूनपि करिष्यति मे दुहिता प्रभूतधनधान्यवती ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 49,
    "avatarnika": ""
  },
  {
    "id": 20013516,
    "chapter_id": 6701,
    "verse_number": "9.50",
    "content_sanskrit": "इति पृष्टभाविचरितः प्रसुवा क्षणमात्रमीलितविलोचनकः । सकलं क्रमेण कथयन्निदम- प्यपरं जगाद सुरहस्यमपि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 50,
    "avatarnika": ""
  },
  {
    "id": 20013517,
    "chapter_id": 6701,
    "verse_number": "9.51",
    "content_sanskrit": "निगमाध्वनि प्रबलबाह्ममतै- रमितैरधिक्षिति खिले द्रुहिणः । पुनरुद्दिधीर्षुरवतीर्य खलु प्रतिभाति मण्डनकवीन्द्रमिषात् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 51,
    "avatarnika": ""
  },
  {
    "id": 20013518,
    "chapter_id": 6701,
    "verse_number": "9.52",
    "content_sanskrit": "तमवाप्य रुद्रमिव साऽद्रिसुता दयिता तवाच्युतमवाब्धिसुता । अनुरूपमाहृतसमस्तमखा ससुता भविष्यति चिरं मुदिता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 52,
    "avatarnika": ""
  },
  {
    "id": 20013519,
    "chapter_id": 6701,
    "verse_number": "9.53",
    "content_sanskrit": "अथ नष्टमौपनिषदं प्रबलैः कुमतैः कृतान्तमित साधयितुम् । ननु मानुषं वपुरुपेत्य शिवः समलंकरिष्यति धरां स्वपदैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 53,
    "avatarnika": ""
  },
  {
    "id": 20013520,
    "chapter_id": 6701,
    "verse_number": "9.54",
    "content_sanskrit": "सह तेन वादमुपगम्य चिरं दुहितुः पतिस्तु यतिवेषजुषा । विजितस्तमेव शरणं जगतां शरणं गमिष्यति विसृष्टगृहः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 54,
    "avatarnika": ""
  },
  {
    "id": 20013521,
    "chapter_id": 6701,
    "verse_number": "9.55",
    "content_sanskrit": "इति गामुदीर्य स मुनिः प्रययौ सकलं यथातथमभूच्च मम । भवदीयशिष्यपदमस्य कथं वितथं भविष्यति मुनेर्वचसि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 55,
    "avatarnika": ""
  },
  {
    "id": 20013522,
    "chapter_id": 6701,
    "verse_number": "9.56",
    "content_sanskrit": "अपि तु त्वयाऽद्य न समग्रजितः प्रथिताग्रणीर्मम पतिर्यदहम् । वपुरर्धमस्य न जिता मतिम- न्नपि मां विजित्य कुरु शिष्यमिमम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 56,
    "avatarnika": ""
  },
  {
    "id": 20013523,
    "chapter_id": 6701,
    "verse_number": "9.57",
    "content_sanskrit": "यदपि त्वमस्य जगतः प्रभवो ननु सर्वविच्च परमः पुरुषः । तदपि त्वयैव सह वादकृते हृदयं बिभर्ति मम तूत्कलिकाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 57,
    "avatarnika": ""
  },
  {
    "id": 20013524,
    "chapter_id": 6701,
    "verse_number": "9.58",
    "content_sanskrit": "इति यायजूकसहधर्मचरी- कथितं वचोऽर्थवदगर्ह्यपदम् । मधुरं निशम्य मुदितः सुतरां प्रतिवक्तुमैहत यतिप्रवरः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 58,
    "avatarnika": ""
  },
  {
    "id": 20013525,
    "chapter_id": 6701,
    "verse_number": "9.59",
    "content_sanskrit": "यदवादि वादकलहोत्सुकतां प्रतिपद्यते हृदयमित्यबले । तदसांप्रतं न हि महायशसो महिलाजनेन कथयन्ति कथाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 59,
    "avatarnika": ""
  },
  {
    "id": 20013526,
    "chapter_id": 6701,
    "verse_number": "9.60",
    "content_sanskrit": "स्वमतं प्रभेत्तुमिह यो यतते स वधूजनोऽस्तु यदि वाऽस्त्वितरः । यतितव्यमेव खलु तस्य जये निजपक्षरक्षणपरैर्भगवन् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 60,
    "avatarnika": ""
  },
  {
    "id": 20013527,
    "chapter_id": 6701,
    "verse_number": "9.61",
    "content_sanskrit": "अत एव गार्ग्यभिधया कलहं सह याज्ञवल्क्यमुनिराडकरोत् । जनकस्तथा सुलभाऽबलया किममी भवन्ति न यशोनिधयः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 61,
    "avatarnika": ""
  },
  {
    "id": 20013528,
    "chapter_id": 6701,
    "verse_number": "9.62",
    "content_sanskrit": "इति युक्तिमदुदितमाकलय- न्मुदितान्तरः श्रुतिसरिज्जलधिः । स तया विवादमधिदेवतया वचसामियेष विदुषां सदसि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 62,
    "avatarnika": ""
  },
  {
    "id": 20013529,
    "chapter_id": 6701,
    "verse_number": "9.63",
    "content_sanskrit": "अथ सा कथा प्रववृते स्म तयो- रुभयोः परस्परजयोत्सुकयोः । मतिचातुरीरचितशब्दझरी श्रुतिविस्मयीकृतविचक्षणयोः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 63,
    "avatarnika": ""
  },
  {
    "id": 20013530,
    "chapter_id": 6701,
    "verse_number": "9.64",
    "content_sanskrit": "अनयोर्विचित्रपदयुक्तिभरै- र्निशमय्य संकथनमाकलितम् । न फणीशमप्यतुलयन्न पेंपीं न गुरुं कविं किमपरं जगति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 64,
    "avatarnika": ""
  },
  {
    "id": 20013531,
    "chapter_id": 6701,
    "verse_number": "9.65",
    "content_sanskrit": "न दिवा न निश्यपि च वादकथा विरराम नैयमिककालमृते । इति जल्पतोः सममनल्पधियो- र्दिवसाश्च सप्त दश चात्यगमन् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 65,
    "avatarnika": ""
  },
  {
    "id": 20013532,
    "chapter_id": 6701,
    "verse_number": "9.66",
    "content_sanskrit": "अथ शारदाऽकृतकवाक्प्रमुखे- ष्वखिलेषु शास्त्रनिचयेषु परम् । तमजेयमात्मनि विचिन्त्य मुनिं पुनरप्यचिन्तयदिदं तरसा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 66,
    "avatarnika": ""
  },
  {
    "id": 20013533,
    "chapter_id": 6701,
    "verse_number": "9.67",
    "content_sanskrit": "अतिबाल्य एव कृतसंन्यसनो नियमैः परैरविधुरश्च सदा । मदनागमेष्वकृतबुद्धिरसौ तदनेन संप्रति जयेयमहम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 67,
    "avatarnika": ""
  },
  {
    "id": 20013534,
    "chapter_id": 6701,
    "verse_number": "9.68",
    "content_sanskrit": "इति संप्रधार्य पुनरप्यमुना कथने प्रसङ्गमथ संगतिसः । यमिनं सदस्यमुमपृच्छदसौ कुसुमास्त्रशास्त्रहृदयं विदुषी ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 68,
    "avatarnika": ""
  },
  {
    "id": 20013535,
    "chapter_id": 6701,
    "verse_number": "9.69",
    "content_sanskrit": "कलाः कियन्त्यो वद पुष्पधन्वनः किमात्मिकाः किं च पदं समाश्रिताः । पूर्वे च पक्षे कथमम्यथा स्थितिः कथं युवत्यां कथमेव पूरुषे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 69,
    "avatarnika": ""
  },
  {
    "id": 20013536,
    "chapter_id": 6701,
    "verse_number": "9.70",
    "content_sanskrit": "नेतीरितः किंचिदुवाच शंकरो विचिन्तयन्नत्र चिरं विचक्षणः । तासामनुक्तौ भविताऽल्पवेदिता भवेत्तदुक्तौ मम धर्मसंक्षयः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 70,
    "avatarnika": ""
  },
  {
    "id": 20013537,
    "chapter_id": 6701,
    "verse_number": "9.71",
    "content_sanskrit": "इति संविचिन्त्य स हृदाऽऽशु तदाऽ- नवबुद्धपुष्पशरशास्त्र इव । विदितागमोऽपि सुरिरक्षयिषु- र्नियमं जगाद जगति व्रतिनाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 71,
    "avatarnika": ""
  },
  {
    "id": 20013538,
    "chapter_id": 6701,
    "verse_number": "9.72",
    "content_sanskrit": "इह मासमात्रमवधिः क्रियता- मनुमन्यते हि दिवसस्य गणः । तदनन्तरं सुदति हास्यसि भोः कुसुमास्त्रशास्त्रनिपुणत्वमपि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 72,
    "avatarnika": ""
  },
  {
    "id": 20013539,
    "chapter_id": 6701,
    "verse_number": "9.73",
    "content_sanskrit": "उररीकृते सति तथेति तयाऽऽ- क्रमते स्म योगिमृगराड्गगनम् । श्रुतविग्रहः श्रुतविनेययुतो दधदभ्रचारमथ योगदृशा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 73,
    "avatarnika": ""
  },
  {
    "id": 20013540,
    "chapter_id": 6701,
    "verse_number": "9.74",
    "content_sanskrit": "स ददर्श कुत्रचिदमर्त्यमिव त्रिदिवच्युतं विगतसत्त्वमपि । मनुजेश्वरं परिवृतं प्रलप- त्प्रमदाभिरार्तिमदमात्यजनम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 74,
    "avatarnika": ""
  },
  {
    "id": 20013541,
    "chapter_id": 6701,
    "verse_number": "9.75",
    "content_sanskrit": "अथो निशाखेटवशादटव्यां मूले तरोर्मोहवशात्परासुम् । तं वीक्ष्य मार्गेऽमरकं नृपालं सनन्दनं प्राह स संयमीन्द्रः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 75,
    "avatarnika": ""
  },
  {
    "id": 20013542,
    "chapter_id": 6701,
    "verse_number": "9.76",
    "content_sanskrit": "सौन्दर्यसौभाग्यनिकेतसीमाः परःशता यस्य पयोरुहाक्ष्यः । स एष राजाऽमरकाभिधानः शेते गतासुः श्रमतो धरण्याम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 76,
    "avatarnika": ""
  },
  {
    "id": 20013543,
    "chapter_id": 6701,
    "verse_number": "9.77",
    "content_sanskrit": "प्रविश्य कायं तमिमं परासो- र्नृपस्य राज्येऽस्य सुतं निवेश्य । योगानुभावात्पुनरप्युपैतु- मुत्कण्ठते मानसमस्मदीयम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 77,
    "avatarnika": ""
  },
  {
    "id": 20013544,
    "chapter_id": 6701,
    "verse_number": "9.78",
    "content_sanskrit": "अन्यादृशानामदसीयनाना- कुशेशयाक्षीकिलकिंचितानाम् । सर्वज्ञतानिर्हरणाय सोऽहं साक्षित्वमप्याश्रयितुं समीहे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 78,
    "avatarnika": ""
  },
  {
    "id": 20013545,
    "chapter_id": 6701,
    "verse_number": "9.79",
    "content_sanskrit": "इत्यूचिवांसं यतितल्लजं तं सनन्दनः प्राह ससान्त्वमेनम् । सर्वज्ञ नैवाविदितं तवास्ति तथाऽपि भक्तिर्मुखरं तनोति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 79,
    "avatarnika": ""
  },
  {
    "id": 20013546,
    "chapter_id": 6701,
    "verse_number": "9.80",
    "content_sanskrit": "मत्स्येन्द्रनामा हि पुरा महात्मा गोरक्षमादिश्य निजाङ्गगुत्यै । नृपस्य कस्यापि तनुं परासोः प्रविश्य तत्पत्तनमाससाद ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 80,
    "avatarnika": ""
  },
  {
    "id": 20013547,
    "chapter_id": 6701,
    "verse_number": "9.81",
    "content_sanskrit": "भद्रासनाध्यासिनि योगिवर्ये भद्राण्यनिद्राण्यभवन्प्रजानाम् । ववर्ष कालेषु बलाहकोऽपि सस्यानि चाऽऽशास्यफलान्यभूवन् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 81,
    "avatarnika": ""
  },
  {
    "id": 20013548,
    "chapter_id": 6701,
    "verse_number": "9.82",
    "content_sanskrit": "विज्ञाय विज्ञाः सचिवा नृपस्य काये प्रविष्टं कमपीह दिव्यम् । समादिशन्नाजसरोरुहाक्षीः सर्वात्मना तस्य वशीक्रियायै ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 82,
    "avatarnika": ""
  },
  {
    "id": 20013549,
    "chapter_id": 6701,
    "verse_number": "9.83",
    "content_sanskrit": "संगीतलास्याभिनयादिमेषु संसक्तचेता ललितेषु तासाम् । स एष विस्मृत्य मुनिः समाधिं सर्वात्मना प्राकृतवद्बभूव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 83,
    "avatarnika": ""
  },
  {
    "id": 20013550,
    "chapter_id": 6701,
    "verse_number": "9.84",
    "content_sanskrit": "गोरक्ष एषोऽथ गुरोः प्रवृत्तिं विज्ञाय रक्षन्बहुधाऽस्य देहम् । निशान्तकान्तानटनोपदेष्टा नितान्तमस्याभवदन्तरङ्गः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 84,
    "avatarnika": ""
  },
  {
    "id": 20013551,
    "chapter_id": 6701,
    "verse_number": "9.85",
    "content_sanskrit": "तत्रैकदा तत्त्वनिबोधनेन निवृत्तरागं निजदेशिकं सः । योगानुपूर्वीमुपदिश्य निन्ये यथापुरं प्राक्तनमेव देहं ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 85,
    "avatarnika": ""
  },
  {
    "id": 20013552,
    "chapter_id": 6701,
    "verse_number": "9.86",
    "content_sanskrit": "हन्तेदृशोऽयं विषयानुरागः किंचोर्ध्वरेतोव्रतखण्डनेन । किंनोदयेत्किल्विषमुल्बणं ते कृत्यं भवानेव कृती विवेक्तुम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 86,
    "avatarnika": ""
  },
  {
    "id": 20013553,
    "chapter_id": 6701,
    "verse_number": "9.87",
    "content_sanskrit": "व्रतमस्मदीयमतुलं क्व मह-त्क्व च कामशास्त्रमतिगर्ह्यमिदम् । तदपीष्यते भगवतैव यदि ह्यनवस्थितं जगदिहैव भवेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 87,
    "avatarnika": ""
  },
  {
    "id": 20013554,
    "chapter_id": 6701,
    "verse_number": "9.88",
    "content_sanskrit": "अधिमेदिनि प्रथयितुं शिथिलं धृतकङ्कणस्य यतिधर्ममिमम् । भवतः किमस्त्यविदितं तदपि प्रणयान्मयोदितमिदं भगवन् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 88,
    "avatarnika": ""
  },
  {
    "id": 20013555,
    "chapter_id": 6701,
    "verse_number": "9.89",
    "content_sanskrit": "स निशम्य पद्मचरणस्य गिरं गिरति स्म गीष्पतिसमप्रतिभः । अविगीतमेव भवता फणितं शृणु सौम्य वच्मि परमार्थमिदम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 89,
    "avatarnika": ""
  },
  {
    "id": 20013556,
    "chapter_id": 6701,
    "verse_number": "9.90",
    "content_sanskrit": "असङ्गिनो न प्रभवन्ति कामा हरेरिवाभीरवधूसखस्य । वज्रोलियोगप्रतिभूः स एष वत्सावकीर्णित्वविपर्ययो नः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 90,
    "avatarnika": ""
  },
  {
    "id": 20013557,
    "chapter_id": 6701,
    "verse_number": "9.91",
    "content_sanskrit": "संकल्प एवाखिलकाममूलं स एव मे नास्ति समस्य विष्णोः । तन्मूलहानौ भवपाशनाशः कर्तुः सदा स्याद्भवदोषदृष्टेः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 91,
    "avatarnika": ""
  },
  {
    "id": 20013558,
    "chapter_id": 6701,
    "verse_number": "9.92",
    "content_sanskrit": "अविचार्य यस्तु वपुराद्यहमि-त्यभिमन्यते जडमतिः सुदृढम् । तमबुद्धतत्त्वमधिकृत्य विधि-प्रतिषेधशास्त्रमखिलं सफलम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 92,
    "avatarnika": ""
  },
  {
    "id": 20013559,
    "chapter_id": 6701,
    "verse_number": "9.93",
    "content_sanskrit": "कृतधीस्त्वनाश्रममवर्णमजा-त्यवबोधमात्रमजमेकरसम् । स्वतयाऽवगत्य न भजेन्निवस-न्निगमस्य मूर्ध्नि विधिकिंकरताम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 93,
    "avatarnika": ""
  },
  {
    "id": 20013560,
    "chapter_id": 6701,
    "verse_number": "9.94",
    "content_sanskrit": "कलशादि मृत्प्रभवमस्ति यथा मृदमन्तरा न जगदेवमिदम् । परमात्मजन्यमपि तेन विना समयत्रयेऽपि न समस्ति खलु ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 94,
    "avatarnika": ""
  },
  {
    "id": 20013561,
    "chapter_id": 6701,
    "verse_number": "9.95",
    "content_sanskrit": "कथंमज्यते जगदशेषमिदं कलयन्मृषेति हृदि कर्मफलैः । न फलाय हि स्वपनकालकृतं सुकृतादि जात्वनृतबुद्धिहतम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 95,
    "avatarnika": ""
  },
  {
    "id": 20013562,
    "chapter_id": 6701,
    "verse_number": "9.96",
    "content_sanskrit": "तदयं करोतु हयमेधशता-न्यमितानि विप्रहननान्यथवा । परमार्थविन्न सुकृतैर्दुरितै-रपि लिप्यतेऽस्तमितकर्तृतया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 96,
    "avatarnika": ""
  },
  {
    "id": 20013563,
    "chapter_id": 6701,
    "verse_number": "9.97",
    "content_sanskrit": "अवधीत्त्रिशीर्षमददाच्च यती-न्वृकमण्डलाय कुपितः शतशः । बत लोमहानिरपि तेन कृता न शतक्रतोरिति हि बह्वृचगीः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 97,
    "avatarnika": ""
  },
  {
    "id": 20013564,
    "chapter_id": 6701,
    "verse_number": "9.98",
    "content_sanskrit": "बहुदक्षिणैरयजत क्रतुभि-र्विबुधानतर्पयदसंख्यधनैः । जनकस्तथाऽप्यभयमाप परं न तु देहयोगमिति काण्ववचः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 98,
    "avatarnika": ""
  },
  {
    "id": 20013565,
    "chapter_id": 6701,
    "verse_number": "9.99",
    "content_sanskrit": "न विहीयतेऽहिरिपुवद्दुरितै-र्न च वर्धते जनकवत्सुकृतैः । न स तापमेत्यकरवं दुरितं किमहं न साध्वकरवं त्विति च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 99,
    "avatarnika": ""
  },
  {
    "id": 20013566,
    "chapter_id": 6701,
    "verse_number": "9.100",
    "content_sanskrit": "तदनङ्गशास्त्रपरिशीलनम-प्यमुनैव सौम्य करणेन कृतम् । न हि दोषकृत्तदपि शिष्टसर-ण्यवनार्थमन्यवपुरेत्य यते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 100,
    "avatarnika": ""
  },
  {
    "id": 20013567,
    "chapter_id": 6701,
    "verse_number": "9.101",
    "content_sanskrit": "इति सत्कथाः स कथनीययशा भवभीतिभञ्जनकरीः कथयन् । सुदुरासदं चरणचारिजनै-र्गिरिशृङ्गमेत्य पुनरेव जगौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 101,
    "avatarnika": ""
  },
  {
    "id": 20013568,
    "chapter_id": 6701,
    "verse_number": "9.102",
    "content_sanskrit": "अथ साऽनुपश्यत विभाति गुहा पुरतः शिला समतला विपुला । सरसी च तत्परिसरेऽच्छजला फलभारनम्रतरुरम्यतटा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 102,
    "avatarnika": ""
  },
  {
    "id": 20013569,
    "chapter_id": 6701,
    "verse_number": "9.103",
    "content_sanskrit": "परिपाल्यतामिह वसद्भिरिदं वपुरप्रमादमनवद्यगुणाः । अहमास्थितस्तदुचितं करणं कल्यामि यावदसमेशुकलाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 103,
    "avatarnika": ""
  },
  {
    "id": 20013570,
    "chapter_id": 6701,
    "verse_number": "9.104",
    "content_sanskrit": "इति शिष्यवर्गमनुशास्य यमि-प्रवरो विसृष्टकरणोऽधिगुहम् । महिपस्यं वर्ष्म गुरुयोगबलोऽ-विशदातिवाहिकशरीरयुतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 104,
    "avatarnika": ""
  },
  {
    "id": 20013571,
    "chapter_id": 6701,
    "verse_number": "9.105",
    "content_sanskrit": "अङ्गुष्ठमारभ्य समीरणं नय-न्करन्ध्रमार्गाद्वहिरेत्य योगवित् । करन्ध्रमार्गेण शनैः प्रविष्टवा-न्मृतस्य यावच्चरणाग्रमेकधीः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 105,
    "avatarnika": ""
  },
  {
    "id": 20013572,
    "chapter_id": 6701,
    "verse_number": "9.106",
    "content_sanskrit": "गात्रं गतासोर्वसुधाधिपस्य शनैः समासपन्दत हृत्प्रदेशे । तथोदमीलन्नयनं क्रमेण तथोदतिष्ठत्स यथा पुरैव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 106,
    "avatarnika": ""
  },
  {
    "id": 20013573,
    "chapter_id": 6701,
    "verse_number": "9.107",
    "content_sanskrit": "आदौ तदङ्गमुदयन्मुखकान्ति पश्चा-श्वासान्तनिर्यदनिलं शनकैः परस्तात् । उन्मीलदङ्घ्रिचालनं तदनूद्यदक्षि-व्याकोचमुत्थितमुपात्तबलं क्रमेण ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 107,
    "avatarnika": ""
  },
  {
    "id": 20013574,
    "chapter_id": 6701,
    "verse_number": "9.108",
    "content_sanskrit": "तं प्राप्तजीवमुपलभ्य पतिं प्रभूत-हर्षस्वनाः प्रमुदिताननपङ्कजास्ताः । नार्यो विरेजुररुणोदयसंप्रफुल्ल-पद्माः ससारसरवा इव वारिजिन्यः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 108,
    "avatarnika": ""
  },
  {
    "id": 20013575,
    "chapter_id": 6701,
    "verse_number": "9.109",
    "content_sanskrit": "हर्ष तासामुदितमतुलं वीक्ष्य वामेक्षणाना-माप्तप्राणं नृपमपि महामात्यमुख्याः प्रहृष्टाः । दध्मुः शङ्खान्पणवपटहान्दुन्दुभींश्चाभिजघ्नु-स्तेषां घोषाः सपदि बधिरीचक्रिरे द्यां भुवं च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 109,
    "avatarnika": ""
  },
  {
    "id": 20013576,
    "chapter_id": 6701,
    "verse_number": "9.110",
    "content_sanskrit": "अथ पुरोहितमन्त्रिपुरः सरै-र्नरपतिः कृतशान्तिककर्मभिः । विहितमाङ्गलिकः स यथोचितं नगरमास्थितभद्रगजो ययौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 110,
    "avatarnika": ""
  },
  {
    "id": 20013577,
    "chapter_id": 6701,
    "verse_number": "9.111",
    "content_sanskrit": "समधिगम्य पुरं परिसान्त्वित-प्रियजनः सचिवैः सह संमतैः । भुवमपालयदाहतशासनो नृपतिभिर्दिवमिन्द्र इवाधिराट् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 111,
    "avatarnika": ""
  },
  {
    "id": 20013578,
    "chapter_id": 6701,
    "verse_number": "9.112",
    "content_sanskrit": "इति श्रीमाधवीये तत्सार्वज्ञ्योपायगोचरः । संक्षेपशंकरजये सर्गोऽयं नवमोऽभवत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 112,
