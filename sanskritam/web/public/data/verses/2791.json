[{"id": 2084205, "chapter_id": 2791, "verse_number": "१२-२९६-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2084206, "chapter_id": 2791, "verse_number": "१२-२९६-१", "content_sanskrit": "अतः परं महाबाहो यच्छ्रेयस्तद्ब्रवीहि मे।\nन तृप्याम्यमृतस्येव वचसस्ते पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2084207, "chapter_id": 2791, "verse_number": "१२-२९६-२", "content_sanskrit": "किं कर्म पुरुषः कृत्वा शुभं पुरुषसत्तम।\nश्रेयः परमवाप्नोति प्रेत्य चेह च तद्वद॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2084208, "chapter_id": 2791, "verse_number": "१२-२९६-३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2084209, "chapter_id": 2791, "verse_number": "१२-२९६-३", "content_sanskrit": "अत्र ते वर्तयिष्यामि यथा पूर्वं महायशाः।\nपराशरं महात्मानं पप्रच्छ जनको नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2084210, "chapter_id": 2791, "verse_number": "१२-२९६-४", "content_sanskrit": "किं श्रेयः सर्वभूतानामस्मिँल्लोके परत्र च।\nयद्भवेत्प्रतिपत्त्व्यं तद्भवान्प्रब्रवीतु मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2084211, "chapter_id": 2791, "verse_number": "१२-२९६-५", "content_sanskrit": "ततः स तपसा युक्तः सर्वधर्मविधानवित्।\nनृपायानुग्रहमना मुनिर्वाक्यमथाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2084212, "chapter_id": 2791, "verse_number": "१२-२९६-६x", "content_sanskrit": "पराशर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2084213, "chapter_id": 2791, "verse_number": "१२-२९६-६", "content_sanskrit": "धर्म एव कृतः श्रेयानिह लोके परत्र च।\nतस्माद्धि परमं नास्ति यथा प्राहुर्मनीषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2084214, "chapter_id": 2791, "verse_number": "१२-२९६-७", "content_sanskrit": "प्रतिपद्य नरो धर्मं स्वर्गलोके महीयते।\nधर्मात्मकः कर्मविधिर्देहिनां नृपसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2084215, "chapter_id": 2791, "verse_number": "१२-२९६-८", "content_sanskrit": "तस्मिन्त्राश्रमिणः सन्तः स्वकर्माणीह कुर्वते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2084216, "chapter_id": 2791, "verse_number": "१२-२९६-९", "content_sanskrit": "चतुर्विधा हि लोकेऽस्मिन्यात्रा तात विधीयते।\nमर्त्या यत्रावतिष्ठन्ते सा च कामात्प्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2084217, "chapter_id": 2791, "verse_number": "१२-२९६-१०", "content_sanskrit": "सुकृतासुकृतं कर्म निषेव्य विविधैः क्रमैः।\nदशार्धप्रविभक्तानां भूतानां विविधा गतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2084218, "chapter_id": 2791, "verse_number": "१२-२९६-११", "content_sanskrit": "सौवर्णं राजतं चापि यथा भाण्डं निषिच्यते।\nतथा निपिच्यते जन्तुः पूर्वकर्मवशानुगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2084219, "chapter_id": 2791, "verse_number": "१२-२९६-१२", "content_sanskrit": "नाबीजाज्जायते किंचिन्नाकृत्वा सुखमेधते।\nसुकृतैर्विन्दते सौख्यं प्राप्य देहक्षयं नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2084220, "chapter_id": 2791, "verse_number": "१२-२९६-१३", "content_sanskrit": "दैवं तात न पश्यामि नास्ति दैवस्य साधनम्।\nस्वभावतो हि संसिद्धा देवगन्धर्वदानवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2084221, "chapter_id": 2791, "verse_number": "१२-२९६-१४", "content_sanskrit": "प्रेत्य यान्त्यकृतं कर्म न स्मरन्ति सदा जनाः।\nते वै तस्य फलप्राप्तौ कर्म चापि चतुर्विधम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2084222, "chapter_id": 2791, "verse_number": "१२-२९६-१५", "content_sanskrit": "लोकयात्राश्रयश्चैव शब्दो वेदाश्रयः कृतः।\nशान्त्यर्थं मनसस्तात नैतद्वृद्धानुशासनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2084223, "chapter_id": 2791, "verse_number": "१२-२९६-१६", "content_sanskrit": "चक्षुषा मनसा वाचा कर्मणा च चतुर्विधम्।\nकुरुते यादृशं कर्म तादृशं प्रतिपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2084224, "chapter_id": 2791, "verse_number": "१२-२९६-१७", "content_sanskrit": "निरन्तरं च मिश्रं च लभते कर्म पार्थिव।\nकल्याणं यदि वा पापं न तु नाशोऽस्य विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2084225, "chapter_id": 2791, "verse_number": "१२-२९६-१८", "content_sanskrit": "कदाचित्सुकृतं तात कूटस्थमिव तिष्ठति।\nमज्जमानस्य संसारे यावद्दुःखाद्विमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2084226, "chapter_id": 2791, "verse_number": "१२-२९६-१९", "content_sanskrit": "ततो दुःखक्षयं कृत्वा सुकृतं कर्म सेवते।\nसुकृतक्षयाच्च दुष्कृतं तद्विद्धि मनुजाधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2084227, "chapter_id": 2791, "verse_number": "१२-२९६-२०", "content_sanskrit": "दमः क्षमा धृतिस्तेजः संतोषः सत्यवादिता।\nह्रीरहिंसाऽव्यसनिता दाक्ष्यं चेति सुखावहाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2084228, "chapter_id": 2791, "verse_number": "१२-२९६-२१", "content_sanskrit": "दुष्कृते सुकृते चापि न जन्तुर्नियतो भवेत्।\nनित्यं मनः समाधाने प्रयतेत विचक्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2084229, "chapter_id": 2791, "verse_number": "१२-२९६-२२", "content_sanskrit": "नायं परस्य सुकृतं दुष्कृतं चापि सेवते।\nकरोति यादृशं कर्म तादृशं प्रतिपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2084230, "chapter_id": 2791, "verse_number": "१२-२९६-२३", "content_sanskrit": "सुखदुःखे समाधाय पुमानन्येन गच्छति।\nअन्येनैव जनः सर्वः संगतो यश्च पार्थिवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2084231, "chapter_id": 2791, "verse_number": "१२-२९६-२४", "content_sanskrit": "परेषां यदसूयेत न तत्कुर्यात्स्वयं नरः।\nयो ह्यसूयुस्तथा युक्तः सोऽवहासं नियच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2084232, "chapter_id": 2791, "verse_number": "१२-२९६-२५", "content_sanskrit": "भीरू राजन्यो ब्राह्मणः सर्वभक्ष्यो\nवैश्योऽनीहावान्हीनवर्णोऽलसश्च।\nविद्वांश्राशीलो वृत्तहीनः कुलीनः\nसत्याद्विभ्रष्टो ब्राह्मणस्त्री च तुष्टा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2084233, "chapter_id": 2791, "verse_number": "१२-२९६-२६", "content_sanskrit": "रागी युक्तः पचमानोऽऽत्महेतो\nर्मूर्खो वक्ता नृपहीनं च राष्ट्रम्।\nएते सर्वे शोच्यतां यान्ति राज\nन्यश्रायुक्तः स्नेहहीनः प्रजासु॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2084234, "chapter_id": 2791, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि षण्णवत्यधिकद्विशततमोऽध्यायः॥ २९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]