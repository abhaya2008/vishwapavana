[{"id": 2142571, "chapter_id": 4075, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2142572, "chapter_id": 4075, "verse_number": "१", "content_sanskrit": "पुरोहितं ते प्रस्थाप्य नगरं नागसाह्वयम् ।\nदूतान् प्रस्थापयामासुः पार्थिवेभ्यस्ततस्ततः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2142573, "chapter_id": 4075, "verse_number": "२", "content_sanskrit": "प्रस्थाप्य दूतानन्यत्र द्वारकां पुरुषर्षभः ।\nस्वयं जगाम कौरव्यः कुन्तीपुत्रो धनञ्जयः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2142574, "chapter_id": 4075, "verse_number": "३", "content_sanskrit": "गते द्वारवतीं कृष्णे बलदेवे च माधवे ।\nसह वृष्ण्यन्धकैः सर्वैर्भोजैश्च शतशस्तदा\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2142575, "chapter_id": 4075, "verse_number": "४", "content_sanskrit": "सर्वमागमयामास पाण्डवानां विचेष्टितम् ।\nधृतराष्ट्रात्मजो राजा गूढैः प्रणिहितैश्चरैः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2142576, "chapter_id": 4075, "verse_number": "५", "content_sanskrit": "स श्रुत्वा माधवं यान्तं सदश्वैरनिलोपमैः ।\nबलेन नातिमहता द्वारकामभ्ययात् पुरीम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2142577, "chapter_id": 4075, "verse_number": "६", "content_sanskrit": "तमेव दिवसं चापि कौन्तेयः पाण्डुनन्दनः ।\nआनर्तनगरीं रम्यां जगामाशु धनञ्जयः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2142578, "chapter_id": 4075, "verse_number": "७", "content_sanskrit": "तौ यात्वा पुरुषव्याघ्रौ वार्ष्णेयमभिजग्मतुः ।\nसुप्तं महति पर्यङ्के परार्घ्यास्तरणास्तृते\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2142579, "chapter_id": 4075, "verse_number": "८", "content_sanskrit": "दुर्योधनस्तु प्रथमं वासुदेवमुपाश्रयत् ।\nउच्छीर्षतश्च कृष्णस्य निषसाद वरासने\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2142580, "chapter_id": 4075, "verse_number": "९", "content_sanskrit": "ततः किरीटी तस्यानु प्रविवेश महामनाः ।\nपश्चार्धेन स कृष्णस्य प्रह्वोऽतिष्ठत् कृताञ्जलिः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2142581, "chapter_id": 4075, "verse_number": "१०", "content_sanskrit": "प्रतिबुद्धः स वार्ष्णेयो ददर्शाग्रे किरीटिनम् ।\nपश्चाद् दुर्योधनं शौरिरपश्यदमितद्युतिः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2142582, "chapter_id": 4075, "verse_number": "११", "content_sanskrit": "स तयोः स्वागतं पृष्ट्वा यथार्हं प्रतिपूज्य तौ ।\nपप्रच्छ तौ महाबाहू किं कार्यं युवयोरिति\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2142583, "chapter_id": 4075, "verse_number": "१२", "content_sanskrit": "ततो दुर्योधनः कृष्णमिदं वचनमब्रवीत्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2142584, "chapter_id": 4075, "verse_number": "१३", "content_sanskrit": "विग्रहेऽस्मिन् भवान् साह्यं मम दातुमिहार्हसि ।\nसमं हि भवतः सख्यं मयि चैवार्जुनेऽपि च\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2142585, "chapter_id": 4075, "verse_number": "१४", "content_sanskrit": "तथा सम्बन्धकं तुल्यमस्माकं त्वयि माधव\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2142586, "chapter_id": 4075, "verse_number": "१५", "content_sanskrit": "अहं चाभिगतः पूर्वं त्वामद्य मधुसूदन ।\nपूर्वं चाभिगताः सन्तो भजन्ते पूर्वसारिणः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2142587, "chapter_id": 4075, "verse_number": "१६", "content_sanskrit": "त्वं चापि पुरुषव्याघ्र सत्तमोऽसि सतामपि ।\nसततं सम्मतो लोके सद्वृत्तमनुपालय\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2142588, "chapter_id": 4075, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2142589, "chapter_id": 4075, "verse_number": "१७", "content_sanskrit": "धार्तराष्ट्रस्य तद्वाक्यं श्रुत्वाऽमरवरोत्तमः ।\nपुरुषोत्तमस्त्विदं वाक्यं दुर्योधनमभाषत\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2142590, "chapter_id": 4075, "verse_number": "१८", "content_sanskrit": "भवानभिगतः पूर्वमत्र मे नास्ति संशयः ।\nमया तु दृष्टः प्रथमं कुन्तीपुत्रो धनञ्जयः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2142591, "chapter_id": 4075, "verse_number": "१९", "content_sanskrit": "तव पूर्वाभिगमनात् पूर्वं चाप्यस्य दर्शनात् ।\nसाहाय्यमुभयोरेव करिष्यामि सुयोधन\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2142592, "chapter_id": 4075, "verse_number": "२०", "content_sanskrit": "प्रवारणं च बालानां पूर्वं कार्यमिति श्रुतिः ।\nतस्मात् प्रवारणं पूर्वमर्हः पार्थो धनञ्जयः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2142593, "chapter_id": 4075, "verse_number": "२१", "content_sanskrit": "मत्संहननतुल्यानां गोपानामर्बुदं महत् ।\nनारायणा इति ख्याताः सर्वे सङ्ग्रामयोधिनः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2142594, "chapter_id": 4075, "verse_number": "२२", "content_sanskrit": "ते वा युधि दुराधर्षा भवन्त्येकस्य सैनिकाः ।\nअयुध्यमानः सङ्ग्रामे न्यस्तशस्त्रोऽहमेकतः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2142595, "chapter_id": 4075, "verse_number": "२३", "content_sanskrit": "आभ्यामन्यतरं पार्थ यत् ते कृत्यतरं मतम् ।\nतं वृणीताद् भवानग्रे प्रवार्यस्त्वं हि धर्मतः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2142596, "chapter_id": 4075, "verse_number": "२४", "content_sanskrit": "एतद् विदित्वा कौन्तेय विचार्य च पुनः पुनः ।\nतान् वा वरय साहाय्ये मां साचिव्येऽथवा पुनः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2142597, "chapter_id": 4075, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2142598, "chapter_id": 4075, "verse_number": "२५", "content_sanskrit": "एवमुक्तस्तु कृष्णेन कुन्तीपुत्रो धनञ्जयः ।\nअयुध्यमानं सङ्ग्रामे वरयामास केशवम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2142599, "chapter_id": 4075, "verse_number": "२६", "content_sanskrit": "नारायणममित्रघ्नं कामाज्जातमजं नृषु ।\nदुर्योधनस्तु तत् सैन्यं सर्वमावरयत् तदा\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2142600, "chapter_id": 4075, "verse_number": "२७", "content_sanskrit": "सहस्राणां सहस्रं तु योधानां प्राप्य भारत ।\nकृष्णं चापहृतं ज्ञात्वा सम्प्राप परमां मुदम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2142601, "chapter_id": 4075, "verse_number": "२८", "content_sanskrit": "दुर्योधनस्तु तत् सैन्यं सर्वमादाय पार्थिवः ।\nततोऽभ्ययाद् भीमबलो रौहिणेयं महाबलम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2142602, "chapter_id": 4075, "verse_number": "२९", "content_sanskrit": "सर्वं चागमने हेतुं स तस्मै सन्न्यवेदयत् ।\nप्रत्युवाच ततः शौरिर्धार्तराष्ट्रमिदं वचः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2142603, "chapter_id": 4075, "verse_number": "", "content_sanskrit": "बलदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2142604, "chapter_id": 4075, "verse_number": "३०", "content_sanskrit": "विदितं ते नरव्याघ्र सर्वं भवितुमर्हति ।\nयन्मयोक्तं विराटस्य पुरा वैवाहिके तदा\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2142605, "chapter_id": 4075, "verse_number": "३१", "content_sanskrit": "निगृह्योक्तो हृषीकेशः त्वदर्थं कुरुनन्दन ।\nत्वया सम्बन्धकं तुल्यमिति राजन् पुनः पुनः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2142606, "chapter_id": 4075, "verse_number": "३२", "content_sanskrit": "न च तद्वाक्यमुक्तं वै केशवः प्रत्यपद्यत\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2142607, "chapter_id": 4075, "verse_number": "३३", "content_sanskrit": "न चाहमुत्सहे कृष्णं विना स्थातुमपि क्षणम् ।\nनाहं सहायः पार्थस्य नापि दुर्योधनस्य वै\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2142608, "chapter_id": 4075, "verse_number": "समाप्तिः", "content_sanskrit": "इति मे निश्चिता बुद्धिर्वासुदेवमवेक्ष्य ह\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2142609, "chapter_id": 4075, "verse_number": "३५", "content_sanskrit": "जातोऽसि भारते वंशे सर्वपार्थिवपूजिते ।\nगच्छ युध्यस्व धर्मेण क्षात्रेण पुरुषर्षभ\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2142610, "chapter_id": 4075, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2142611, "chapter_id": 4075, "verse_number": "३६", "content_sanskrit": "इत्येवमुक्तस्तु तदा परिष्वज्य हलायुधम् ।\nकृष्णं चापहृतं ज्ञात्वा युद्धान्मेने जितं जयम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2142612, "chapter_id": 4075, "verse_number": "३७", "content_sanskrit": "सोऽभ्ययात् कृतवर्माणं धृतराष्ट्रसुतो नृपः ।\nकृतवर्मा ददौ तस्य सेनामक्षोहिणीं तदा\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2142613, "chapter_id": 4075, "verse_number": "३८", "content_sanskrit": "स तेन सर्वसैन्येन भीमेन कुरुनन्दनः ।\nवृतः प्रतिययौ हृष्टः सुहृदः सम्प्रहर्षयन्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2142614, "chapter_id": 4075, "verse_number": "३९", "content_sanskrit": "ततः पीताम्बरधरो जगत्स्रष्टा जनार्दनः ।\nगते दुर्योधने कृष्णः किरीटिनमथाब्रवीत्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2142615, "chapter_id": 4075, "verse_number": "४०", "content_sanskrit": "अयुध्यमानः कां बुद्धिमास्थायाहं वृतस्त्वया\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2142616, "chapter_id": 4075, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2142617, "chapter_id": 4075, "verse_number": "४१", "content_sanskrit": "भवान् समर्थस्तान् सर्वान् निहन्तुं नात्र संशयः ।\nनिहन्तुमहमप्येकः समर्थः पुरुषर्षभ\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2142618, "chapter_id": 4075, "verse_number": "४२", "content_sanskrit": "भवांश्च कीर्तिमाँल्लोके तद्यशस्त्वां गमिष्यति ।\nयशसां चाहमप्यर्थी तस्मादसि मया वृतः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2142619, "chapter_id": 4075, "verse_number": "४३", "content_sanskrit": "सारथ्यं तु त्वया कार्यमिति मे मानसं सदा ।\nचिररात्रेप्सितं कामं तद् भवान् कर्तुमर्हति\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2142620, "chapter_id": 4075, "verse_number": "", "content_sanskrit": "वासुदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2142621, "chapter_id": 4075, "verse_number": "४४", "content_sanskrit": "उपपन्नमिदं पार्थ यत् स्पर्धेथा मया सह ।\nसारथ्यं ते करिष्यामि कामः सम्पद्यतां तव\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2142622, "chapter_id": 4075, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2142623, "chapter_id": 4075, "verse_number": "४५", "content_sanskrit": "एवं प्रमुदितः पार्थः कृष्णेन सहितस्तदा ।\nवृतो दशार्हप्रवरैः पुनरायाद् युधिष्ठिरम्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2142624, "chapter_id": 4075, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि सप्तमोऽध्यायः॥७॥ सेनोद्योगपर्वणि सप्तमोऽध्यायः॥७॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]