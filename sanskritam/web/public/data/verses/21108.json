[{"id": 7001108000, "chapter_id": 21108, "verse_number": "२-१-१९-१", "content_sanskrit": "ब्रह्मोवाच ।\nपाद्मे कल्पे मम सुरा ब्रह्मणो मानसात्सुतात् ।\nपुलस्त्याद्विश्रवा जज्ञे तस्य वैश्रवणस्सुतः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001108001, "chapter_id": 21108, "verse_number": "२-१-१९-२", "content_sanskrit": "तेनेयमलका भुक्ता पुरी विश्वकृता कृता ।\nआराध्य त्र्यंबकं देवमत्युग्रतपसा पुरा॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001108002, "chapter_id": 21108, "verse_number": "२-१-१९-३", "content_sanskrit": "व्यतीते तत्र कल्पे वै प्रवृत्ते मेघवाहने ।\nयाज्ञदत्तिरसौ श्रीदस्तपस्तेपे सुदुस्सहम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001108003, "chapter_id": 21108, "verse_number": "२-१-१९-४", "content_sanskrit": "भक्ति प्रभावं विज्ञाय शंभोस्तद्दीपमात्रतः ।\nपुरा पुरारेस्संप्राप्य काशिकां चित्प्रकाशिकाम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001108004, "chapter_id": 21108, "verse_number": "२-१-१९-५", "content_sanskrit": "शिवैकादशमुद्बोध्य चित्तरत्नप्रदीपकैः ।\nअनन्यभक्तिस्नेहाढ्यस्तन्मयो ध्याननिश्चलः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001108005, "chapter_id": 21108, "verse_number": "२-१-१९-६", "content_sanskrit": "शिवैक्यं सुमहापात्रं तपोग्निपरिबृंहितम् ।\nकामक्रोधमहाविघ्नपतंगाघात वर्जितम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001108006, "chapter_id": 21108, "verse_number": "२-१-१९-७", "content_sanskrit": "प्राणसंरोधनिर्वातं निर्मलं निर्मलेक्षणात् ।\nसंस्थाप्य शांभवं लिंगं सद्भावकुसुमार्चितम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001108007, "chapter_id": 21108, "verse_number": "२-१-१९-८", "content_sanskrit": "तावत्तताप स तपस्त्वगस्थिपरिशेषितम् ।\nयावद्बभूव तद्वर्णं वर्षाणामयुतं शतम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001108008, "chapter_id": 21108, "verse_number": "२-१-१९-९", "content_sanskrit": "ततस्सह विशालाक्ष्या देवो विश्वेश्वररस्वयम् ।\nअलकापतिमालोक्य प्रसन्नेनांतरात्मना॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001108009, "chapter_id": 21108, "verse_number": "२-१-१९-१०", "content_sanskrit": "लिंगे मनस्समाधाय स्थितं स्थाणुस्वरूपिणम् ।\nउवाच वरदोऽस्मीति तदाचक्ष्वालकापते॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001108010, "chapter_id": 21108, "verse_number": "२-१-१९-११", "content_sanskrit": "उन्मील्य नयने यावत्स पश्यति तपोधनः ।\nतावदुद्यत्सहस्रांशु सहस्राधिकतेजसम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001108011, "chapter_id": 21108, "verse_number": "२-१-१९-१२", "content_sanskrit": "पुरो ददर्श श्रीकंठं चन्द्रचूडमुमाधवम् ।\nतत्तेजः परिभूताक्षितेजाः संमील्य लोचने॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001108012, "chapter_id": 21108, "verse_number": "२-१-१९-१३", "content_sanskrit": "उवाच देवदेवेशं मनोरथपदातिगम् ।\nनिजांघ्रिदर्शने नाथ दृक्सामर्थ्यं प्रयच्छ मे॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001108013, "chapter_id": 21108, "verse_number": "२-१-१९-१४", "content_sanskrit": "अयमेव वरो नाथ यत्त्वं साक्षान्निरीक्ष्यसे ।\nकिमन्येन वरेणेश नमस्ते शशिशेखर॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001108014, "chapter_id": 21108, "verse_number": "२-१-१९-१५", "content_sanskrit": "इति तद्वचनं श्रुत्वा देवदेव उमापतिः ।\nददौ दर्शनसामर्थ्यं स्पृष्ट्वा पाणितलेन तम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001108015, "chapter_id": 21108, "verse_number": "२-१-१९-१६", "content_sanskrit": "प्रसार्य नयने पूर्वमुमामेव व्यलोकयत् ।\nतोऽसौ याज्ञदत्तिस्तु तत्सामर्थ्यमवाप्य च॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001108016, "chapter_id": 21108, "verse_number": "२-१-१९-१७", "content_sanskrit": "शंभोस्समीपे का योषिदेषा सर्वांगसुन्दरी ।\nअनया किं तपस्तप्तं ममापि तपसोऽधिकम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001108017, "chapter_id": 21108, "verse_number": "२-१-१९-१८", "content_sanskrit": "अहो रूपमहो प्रेम सौभाग्यं श्रीरहो भृशम् ।\nइत्यवादीदसौ पुत्रो मुहुर्मुहुरतीव हि॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001108018, "chapter_id": 21108, "verse_number": "२-१-१९-१९", "content_sanskrit": "क्रूर दृग्वीक्षते यावत्पुनःपुनरिदं वदन् ।\nतावत्पुस्फोट तन्नेत्रं वारां वामाविलोकनात्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001108019, "chapter_id": 21108, "verse_number": "२-१-१९-२०", "content_sanskrit": "अथ देव्यब्रवीद्देव किमसौ दुष्टतापसः ।\nअसकृद्वीक्ष्य मां वक्ति कुरु त्वं मे तपःप्रभाम्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001108020, "chapter_id": 21108, "verse_number": "२-१-१९-२१", "content_sanskrit": "असकृद्दक्षिणेनाक्ष्णा पुनर्मामेव पश्यति ।\nअसूयमानो मे रूपप्रेम सौभाग्यसंपद॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001108021, "chapter_id": 21108, "verse_number": "२-१-१९-२२", "content_sanskrit": "इति देवीगिरं श्रुत्वा प्रहस्य प्राह तां प्रभुः ।\nउमे त्वदीयः पुत्रोऽयं न च क्रूरेण चक्षुषा॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001108022, "chapter_id": 21108, "verse_number": "२-१-१९-२३", "content_sanskrit": "संपश्यति तपोलक्ष्मीं तव किं त्वधिवर्णयेत् ।\nइति देवीं समाभाष्य तमीशः पुनरब्रवीत्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001108023, "chapter_id": 21108, "verse_number": "२-१-१९-२४", "content_sanskrit": "वरान्ददामि ते वत्स तपसानेन तोषितः ।\nनिधीनामथ नाथस्त्वं गुह्यकानां भवेश्वरः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001108024, "chapter_id": 21108, "verse_number": "२-१-१९-२५", "content_sanskrit": "यक्षाणां किन्नराणां च राज्ञां राज च सुव्रतः ।\nपतिः पुण्यजनानां च सर्वेषां धनदो भव॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001108025, "chapter_id": 21108, "verse_number": "२-१-१९-२६", "content_sanskrit": "मया सख्यं च ते नित्यं वत्स्यामि च तवांतिके ।\nअलकां निकषा मित्र तव प्रीतिविवृद्धये॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001108026, "chapter_id": 21108, "verse_number": "२-१-१९-२७", "content_sanskrit": "आगच्छ पादयोरस्याः पत ते जननी त्वियम् ।\nयाज्ञदत्ते महाभक्त सुप्रसन्नेन चेतसा॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001108027, "chapter_id": 21108, "verse_number": "२-१-१९-२८", "content_sanskrit": "ब्रह्मोवाच ।\nइति दत्त्वा वरान्देवः पुनराह शिवां शिवः ।\nप्रसादं कुरु देवेशि तपस्विन्यंगजेऽत्र वै॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001108028, "chapter_id": 21108, "verse_number": "२-१-१९-२९", "content_sanskrit": "इत्याकर्ण्य वचश्शंभोः पार्वती जगदम्बिका ।\nअब्रवीद्याज्ञदत्तिं तं सुप्रसन्नेन चेतसा॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001108029, "chapter_id": 21108, "verse_number": "२-१-१९-३०", "content_sanskrit": "देव्युवाच ।\nवत्स ते निर्मला भक्तिर्भवे भवतु सर्वदा ।\nभवैकपिंगो नेत्रेण वामेन स्फुटितेन ह॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001108030, "chapter_id": 21108, "verse_number": "२-१-१९-३१", "content_sanskrit": "देवेन दत्ता ये तुभ्यं वरास्संतु तथैव ते ।\nकुबेरो भव नाम्ना त्वं मम रूपेर्ष्यया सुत॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001108031, "chapter_id": 21108, "verse_number": "२-१-१९-३२", "content_sanskrit": "इति दत्त्वा वरान्देवो देव्या सह महेश्वरः ।\nधनदायाविवेशाथ धाम वैश्वेश्वराभिधम्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001108032, "chapter_id": 21108, "verse_number": "२-१-१९-३३", "content_sanskrit": "इत्थं सखित्वं श्रीशंभोः प्रापैष धनदः पुरम् ।\nअलकान्निकषा चासीत्कैलासश्शंकरालयः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]