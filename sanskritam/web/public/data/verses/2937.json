[{"id": 2091193, "chapter_id": 2937, "verse_number": "१३-६७-१", "content_sanskrit": "युधिष्ठिर उवाच।\nपितामह महाप्राज्ञ सर्वशास्त्रविशारद।\nत्वत्तोऽहं श्रोतुमिच्छामि धर्मं भरतसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2091194, "chapter_id": 2937, "verse_number": "१३-६७-२", "content_sanskrit": "शरणागतं ये रक्षन्ति भूतग्रामं चतुर्विधम्।\nकिं तस्य भरतश्रेष्ठ फलं भवति तत्त्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2091195, "chapter_id": 2937, "verse_number": "१३-६७-३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2091196, "chapter_id": 2937, "verse_number": "१३-६७-३", "content_sanskrit": "इदं शृणु महाप्राज्ञ धर्मपुत्र महायशः।\nइतिहासं पुरावृत्तं शरणार्थं महाफलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2091197, "chapter_id": 2937, "verse_number": "१३-६७-४", "content_sanskrit": "प्रपात्यमानः श्येनेन कपोतः प्रियदर्शनः।\nवृषदर्भं महाभागं नरेन्द्रं शरणं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2091198, "chapter_id": 2937, "verse_number": "१३-६७-५", "content_sanskrit": "स तं दृष्ट्वा विशुद्धात्मा त्रासादङ्कमुपागतम्।\nआश्वास्याश्वसिहीत्याह न तेऽस्ति भयमण्डज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2091199, "chapter_id": 2937, "verse_number": "१३-६७-६", "content_sanskrit": "भयं ते सुमहत्कस्मात्कुत्र किं वा कृतं त्वया।\nयेन त्वमिह सम्प्राप्तो विसंज्ञो भ्रान्तचेतनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2091200, "chapter_id": 2937, "verse_number": "१३-६७-७", "content_sanskrit": "नवनीलोत्पलापीड चारुवर्ण सुदर्शन।\nदाडिमाशोकपुष्पाक्ष मा त्रसस्वाभयं तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2091201, "chapter_id": 2937, "verse_number": "१३-६७-८", "content_sanskrit": "मत्सकाशमनुप्राप्तं न त्वां कश्चित्समुत्सहेत्।\nमनसा ग्रहणं कर्तुं रक्षाध्यक्षपुरस्कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2091202, "chapter_id": 2937, "verse_number": "१३-६७-९", "content_sanskrit": "काशिराज्यं तदद्यैव त्वदर्तं जीवितं तथा।\nत्यजेयं भव विस्रब्धः कपोत भयं तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2091203, "chapter_id": 2937, "verse_number": "१३-६७-१०x", "content_sanskrit": "श्येन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2091204, "chapter_id": 2937, "verse_number": "१३-६७-१०", "content_sanskrit": "ममैतद्विहितं भक्ष्यं न राजंस्त्रातुमर्हसि।\nअतिक्रान्तं च प्राप्तं च प्रयत्नाच्चोपपादितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2091205, "chapter_id": 2937, "verse_number": "१३-६७-११", "content_sanskrit": "मांसं च रुधइरं चास्य मज्जा मेदश्च मे हितम्।\nपरितोषकरो ह्येष मम माऽस्याग्रतो भव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2091206, "chapter_id": 2937, "verse_number": "१३-६७-१२", "content_sanskrit": "तृष्णा मे बाधतेऽत्युग्रा क्षुधा निर्दहतीव माम्।\nमुञ्चैनं नहि शक्ष्यामि राजन्मन्दयितुं क्षुधाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2091207, "chapter_id": 2937, "verse_number": "१३-६७-१३", "content_sanskrit": "मया ह्यनुसृतो ह्येष मत्पक्षनखविक्षतः।\nकिञ्चिदुच्छ्वासनिःश्वासं न राजन्गोप्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2091208, "chapter_id": 2937, "verse_number": "१३-६७-१४", "content_sanskrit": "यदि स्वविषये राजन्प्रभुस्त्वं रक्षणे नृणाम्।\nखेचरस्य तृषार्तस्य न त्वं प्रभुरथोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2091209, "chapter_id": 2937, "verse_number": "१३-६७-१५", "content_sanskrit": "यदि वैरिषु भृत्येषु स्वजनव्यवहारयोः।\nविषयेष्विन्द्रियाणां च आकाशे मा पराक्रम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2091210, "chapter_id": 2937, "verse_number": "१३-६७-१६", "content_sanskrit": "प्रभुत्वं हि पराक्रम्य सम्यक् पक्षहरेषु ते।\nयदि त्वमिह धर्मार्थी मामपि द्रष्टुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2091211, "chapter_id": 2937, "verse_number": "१३-६७-१७x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2091212, "chapter_id": 2937, "verse_number": "१३-६७-१७", "content_sanskrit": "श्रुत्वा श्येनस्य तद्वाक्यं राजर्षिर्विस्मयं गतः।\nसम्भाव्य चैनं तद्वाक्यं तदर्थी प्रत्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2091213, "chapter_id": 2937, "verse_number": "१३-६७-१८x", "content_sanskrit": "राजोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2091214, "chapter_id": 2937, "verse_number": "१३-६७-१८", "content_sanskrit": "गोवृषो वा वराहो वा मृगो वा महिषोपि वा।\nत्वदथर्मद्य क्रियतां क्षुधाप्रशमनाय ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2091215, "chapter_id": 2937, "verse_number": "१३-६७-१९", "content_sanskrit": "शरणागतं न त्यजेयमिति मे व्रतमाहितम्।\nन मुञ्चति ममाङ्गानि द्विजोऽयं पश्य वै द्विज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2091216, "chapter_id": 2937, "verse_number": "१३-६७-२०x", "content_sanskrit": "श्येन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2091217, "chapter_id": 2937, "verse_number": "१३-६७-२०", "content_sanskrit": "न वराहं न चोक्षाणं न चान्यान्विविधान्द्विजान्\nभक्षयामि महाराज किमन्नाद्येन तेन मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2091218, "chapter_id": 2937, "verse_number": "१३-६७-२१", "content_sanskrit": "यस्तु मे विहितो भक्ष्यः स्वयं देवैः सनातनः।\nश्येनाः कपोतान्खादन्ति स्तितिरेषा सनातनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2091219, "chapter_id": 2937, "verse_number": "१३-६७-२२", "content_sanskrit": "उशीनर कपोते तु यदि स्नेहस्तवानघ।\nततस्त्वं मे प्रयच्छाद्य स्वमांसं तुलया धृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2091220, "chapter_id": 2937, "verse_number": "१३-६७-२३x", "content_sanskrit": "राजोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2091221, "chapter_id": 2937, "verse_number": "१३-६७-२३", "content_sanskrit": "महाननुग्रहो मेऽद्य यस्त्वमेवमिहात्थ माम्।\nबाढमेव करिष्यामीत्युक्त्वाऽसौ राजसत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2091222, "chapter_id": 2937, "verse_number": "१३-६७-२४", "content_sanskrit": "उत्कृत्योत्कृत्य मांसानि तुलया समतोलयत्।\nअन्तःपुरे ततस्तस्य स्त्रियो रत्नविभूषिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2091223, "chapter_id": 2937, "verse_number": "१३-६७-२५", "content_sanskrit": "हाहाभूता विनिष्क्रान्ताः श्रुत्वा परमदुःखिताः।\nतासां रुदितशब्देन मन्त्रिभृत्यजनस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2091224, "chapter_id": 2937, "verse_number": "१३-६७-२६", "content_sanskrit": "बभूव सुमहान्नादो मेघगम्भीरनिःस्वनः।\nनिरुद्धं गगनं सर्वं व्यभ्रं मेघैः समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2091225, "chapter_id": 2937, "verse_number": "१३-६७-२७", "content_sanskrit": "मही प्रचलिता चासीत्तस्य सत्येन कर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2091226, "chapter_id": 2937, "verse_number": "१३-६७-२८", "content_sanskrit": "स राजा पार्श्वतश्चैव बाहुभ्यामूरुतश्च यत्।\nतानि मांसानि सञ्छिद्य तुलां पूरयतेऽशनैः।\nतथापि न समस्तेन कपोतेन बभूव ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2091227, "chapter_id": 2937, "verse_number": "१३-६७-२९", "content_sanskrit": "अस्थिभूतो यदा राजा निर्मांसो रुधिरस्रवः।\nतुलां ततः समारूढः स्वं मांसक्षयमुत्सृजन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2091228, "chapter_id": 2937, "verse_number": "१३-६७-३०", "content_sanskrit": "ततः सेन्द्रास्त्रयो लोकास्तं नरेन्द्रमुपस्थिताः।\nर्भर्यश्चाकाशगैस्तत्र वादिता देवदुन्दुभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2091229, "chapter_id": 2937, "verse_number": "१३-६७-३१", "content_sanskrit": "अमृतेनावसिक्तश्च वृषदर्भो नरेश्वरः।\nदिव्यैश्च सुसुखैर्माल्यैरभिवृष्टः पुनःपुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2091230, "chapter_id": 2937, "verse_number": "१३-६७-३२", "content_sanskrit": "देवगन्धर्वसन्घातैरप्सरोभिश्च सर्वतः।\nनृत्तश्चैवोपगीतश्च पितामह इव प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2091231, "chapter_id": 2937, "verse_number": "१३-६७-३३", "content_sanskrit": "हेमप्रासादसम्बाधं मणिकाञ्चनतोरणम्।\nसवैडूर्यमणिस्तम्भं विमानं समधिष्ठितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2091232, "chapter_id": 2937, "verse_number": "१३-६७-३४", "content_sanskrit": "स राजर्षिर्गतः स्वर्गं कर्मणा तेन शाश्वतम्।\nशरणागतेषु चैवं त्वं कुरु सर्वं युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2091233, "chapter_id": 2937, "verse_number": "१३-६७-३५", "content_sanskrit": "भक्तानामनुरक्तानामाश्रितानां च रक्षिता।\nदयावान्सर्वभूतेषु परत्र सुखमेधते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2091234, "chapter_id": 2937, "verse_number": "१३-६७-३६", "content_sanskrit": "साधुवृत्तो हि यो राजा सद्वृत्तमनुतिष्ठति।\nकिं न प्राप्तं भवेत्तेनि स्वव्याजेनेह कर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2091235, "chapter_id": 2937, "verse_number": "१३-६७-३७", "content_sanskrit": "स राजर्षिर्विशुद्धात्मा धीरः सत्यपराक्रमः।\nकाशीनामीश्वरः ख्यातस्त्रिषु लोकेषु कर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2091236, "chapter_id": 2937, "verse_number": "१३-६७-३८", "content_sanskrit": "योऽप्यन्यः कारेयदेवं शरणागतरक्षणम्।\nसोपि गच्छेत तामेव गतिं भरतसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2091237, "chapter_id": 2937, "verse_number": "१३-६७-३९", "content_sanskrit": "इदं वृत्तं हि राजर्षे वृषदर्भस्य कीर्तयन्।\nपूतात्मा वै भवेल्लोके शृणुयाद्यश्च नित्यशः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2091238, "chapter_id": 2937, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि सप्तषष्टितमोऽध्यायः॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]