[{"id": 7005695000, "chapter_id": 25695, "verse_number": "१६८-१", "content_sanskrit": "भगवन्नाभितः कमलोत्पत्तिवर्णनम् ।\nमत्स्य उवाच ।\nआपवः स विभुर्भूत्वा चारयामास वै तपः ।\nच्छादयित्यात्मनो देहं यादसाङ्कुलसम्भवम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005695001, "chapter_id": 25695, "verse_number": "१६८-२", "content_sanskrit": "ततो महात्मातिबलो मतिं लोकस्य सर्जने ।\nमहतां पञ्चभूतानां विश्वो विश्वमचिन्तयत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005695002, "chapter_id": 25695, "verse_number": "१६८-३", "content_sanskrit": "तस्य चिन्तयमानस्य निर्वाते संस्थितेऽर्णवे ।\nनिराकाशे तोयमये सूक्ष्मे जगति गह्वरे ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005695003, "chapter_id": 25695, "verse_number": "१६८-४", "content_sanskrit": "ईषत्सङ्क्षोभयामास सोऽर्णवं सलिलाश्रयः ।\nअनन्तरोर्मिभिःसूक्ष्ममथच्छिद्रमभूत् पूरा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005695004, "chapter_id": 25695, "verse_number": "१६८-५", "content_sanskrit": "शब्दं प्रति तदोद्भूतो मारुतश्छिद्रसम्भवः ।\nस लब्ध्वान्तरमक्षोभ्योण्यवर्धत समीरणः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005695005, "chapter_id": 25695, "verse_number": "१६८-६", "content_sanskrit": "विवर्द्धता बलवता वेगाद्विक्षोभितोऽर्णवः ।\nतस्यार्णवस्य क्षुब्धस्य तस्मिन्नम्भसि मन्थिते ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005695006, "chapter_id": 25695, "verse_number": "१६८-७", "content_sanskrit": "कृष्णवर्त्मा समभवत् प्रभुर्वैश्वानरो महान् ।\nततः स शोषयामास पावकः सलिलं बहु ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005695007, "chapter_id": 25695, "verse_number": "१६८-८", "content_sanskrit": "क्षयाज्जलनिधेश्छिद्रमभवद्विस्तृतं नभः ।\nआत्मतेजोद्भवाः पुण्या आपोऽमृत रसोपमाः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005695008, "chapter_id": 25695, "verse_number": "१६८-९", "content_sanskrit": "आकाशं च्छिद्रसम्भूतं वायुराकाशसम्भवः ।\nआभ्यां सङ्घर्षणोद्भूतं पावकं वायुसम्भवम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005695009, "chapter_id": 25695, "verse_number": "१६८-१०", "content_sanskrit": "दृष्ट्वा प्रीतो महादेवो महाभूत विभावनः ।\nदृष्ट्वा भूतानि भगवांल्लोक सृष्ट्यर्थमुत्तमम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005695010, "chapter_id": 25695, "verse_number": "१६८-११", "content_sanskrit": "ब्रह्मणो जन्मसहितं बहुरूपो व्यचिन्तयत् ।\nचतुर्युगाभि सङ्ख्याते सहस्र युगपर्यये ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005695011, "chapter_id": 25695, "verse_number": "१६८-१२", "content_sanskrit": "बहुजन्मविशुद्धात्मा ब्राह्मणेह निरुच्यते ।\nयत् पृथिव्यां द्विजेन्द्राणां तपसा भवितात्मना ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005695012, "chapter_id": 25695, "verse_number": "१६८-१३", "content_sanskrit": "ज्ञानं दृष्टन्तु विश्वार्थे योगिनां याति मुख्यताम् ।\nतं योगवन्तं विज्ञाय सम्पूर्णैश्वर्यमुत्तमम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005695013, "chapter_id": 25695, "verse_number": "१६८-१४", "content_sanskrit": "पदे ब्रह्मणि विश्वेशं न्ययोजयत योगवित् ।\nततस्तस्मिन् महातोये महीशो हरिरच्युतः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005695014, "chapter_id": 25695, "verse_number": "१६८-१५", "content_sanskrit": "स्वयं क्रीडंश्च विधिवन्मोदते सर्वलोककृत् ।\nपद्मं नाभ्युद्भवं चैकं समुत्पादितवांस्तदा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005695015, "chapter_id": 25695, "verse_number": "१६८-१६", "content_sanskrit": "सहस्रपर्णं विरजं भास्कराभं हिरण्मयम् ।\nहुताशनज्वलितशिखोज्ज्वलत्प्रभमुपस्थितं शरदमलार्कतेजसम् ।\nविराजते कमलमुदारवर्चसं महात्मनस्तनुरुहचारुदर्शनम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]