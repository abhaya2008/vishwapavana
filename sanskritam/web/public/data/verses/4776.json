[{"id": 2178543, "chapter_id": 4776, "verse_number": "", "content_sanskrit": "कृष्णं प्रति गान्धार्या रुदन्तीनां स्त्रीणां प्रदर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2178544, "chapter_id": 4776, "verse_number": "", "content_sanskrit": "गान्धारी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2178545, "chapter_id": 4776, "verse_number": "१", "content_sanskrit": "अध्यर्धगुणमाहुर्यं बले शौर्ये च माधव ।\nपित्रा त्वया च दाशार्ह दृप्तं सिंहमिवोत्कटम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2178546, "chapter_id": 4776, "verse_number": "२", "content_sanskrit": "यो बिभेद चमूमेको मम पुत्रस्य दुर्भिदाम् ।\nस भूत्वा मृत्युरन्येषां स्वयं मृत्युवशं गतः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2178547, "chapter_id": 4776, "verse_number": "३", "content_sanskrit": "तस्योपलक्षये कृष्ण कार्ष्णेरमिततेजसः ।\nअभिमन्योर्हतस्यापि प्रभा नैवोपशाम्यति\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2178548, "chapter_id": 4776, "verse_number": "४", "content_sanskrit": "एषा विराटदुहिता स्नुषा गाण्डीवधन्वनः ।\nहतं बाला पतिं वीरं दृष्ट्वा शोचत्यनिन्दिता\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2178549, "chapter_id": 4776, "verse_number": "५", "content_sanskrit": "तमेषा हि समासाद्य भार्या भर्तारमन्तिकात् ।\nविराटदुहिता कृष्ण पाणिना परिमार्जति\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2178550, "chapter_id": 4776, "verse_number": "६", "content_sanskrit": "तथा वक्त्रमुपाघ्राय सौभद्रस्य यशस्विनी ।\nविबुद्धकमलाकारं कम्बुवृत्तशिरोधरम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2178551, "chapter_id": 4776, "verse_number": "७", "content_sanskrit": "कामरूपमतीवैषा परिष्वजति भामिनी\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2178552, "chapter_id": 4776, "verse_number": "८", "content_sanskrit": "लज्जमाना पुरा चैनं माध्वीकमदमूर्च्छिता\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2178553, "chapter_id": 4776, "verse_number": "९", "content_sanskrit": "तस्य क्षतजसन्दिग्धं जातरूपपरिष्कृतम् ।\nविमुच्य कवचं कृष्ण शरीरमभिवीक्षते\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2178554, "chapter_id": 4776, "verse_number": "१०", "content_sanskrit": "अवेक्षमाणा तं बाला कृष्ण त्वामभिवीक्षते\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2178555, "chapter_id": 4776, "verse_number": "११", "content_sanskrit": "कथं ते पुण्डरीकाक्ष सदृशाक्षो निपातितः ।\nबले शौर्ये च सदृशस्तेजसा चैव तेऽनघ\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2178556, "chapter_id": 4776, "verse_number": "१२", "content_sanskrit": "रूपेण च तवात्यर्थं शेते भुवि निपातितः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2178557, "chapter_id": 4776, "verse_number": "१३", "content_sanskrit": "अत्यन्तसुकुमारस्य राङ्कवाजिनशायिनः ।\nकच्चिदद्य शरीरं ते भूमौ न परितप्यते\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2178558, "chapter_id": 4776, "verse_number": "१४", "content_sanskrit": "मातङ्गभुजवर्ष्माणौ ज्याक्षेपकठिनत्वचौ ।\nकाञ्चनाङ्गदिनौ शेते विक्षिप्य विपुलौ भुजौ\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2178559, "chapter_id": 4776, "verse_number": "१५", "content_sanskrit": "व्यायम्य बहुधा नूनं सुखसुप्तः श्रमादिव ।\nएवं विलपतीमार्तां किं मां न प्रतिभाषसे\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2178560, "chapter_id": 4776, "verse_number": "१६", "content_sanskrit": "ननु मां त्वं पुरा दूराद् अभिवीक्ष्याभिभाषसे ।\nन स्मराम्यपराधं मे किं मां न प्रतिभाषसे\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2178561, "chapter_id": 4776, "verse_number": "१७", "content_sanskrit": "आर्यामार्य सुभद्रां त्वमिमांश्च त्रिदशोपमान् ।\nपितॄन् मातॄंश्च दुःखार्तान् विहाय क्व गमिष्यसि\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2178562, "chapter_id": 4776, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2178563, "chapter_id": 4776, "verse_number": "१८", "content_sanskrit": "तस्य शोणितसन्दिग्धान् केशानुन्नम्य पाणिना ।\nउत्सङ्गे वक्त्रमाधाय जीवन्तमिव पृच्छति\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2178564, "chapter_id": 4776, "verse_number": "१९", "content_sanskrit": "स्वस्रीयं वासुदेवस्य पुत्रं गाण्डीवधन्वनः ।\nकथं त्वां रणमध्यस्थं जघ्नुरेते महारथाः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2178565, "chapter_id": 4776, "verse_number": "२०", "content_sanskrit": "धिगस्तु क्रूरकर्तॄंस्तान् कृपकर्णजयद्रथान् ।\nद्रोणद्रौणायनी चोभौ यैरहं विधवा कृता\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2178566, "chapter_id": 4776, "verse_number": "२१", "content_sanskrit": "रथर्षभाणां सर्वेषां कथमासीत् तदा मनः ।\nबालं त्वां परिवार्यैकमनेकेषां निजघ्नताम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2178567, "chapter_id": 4776, "verse_number": "२२", "content_sanskrit": "कथं नु पाण्डवानां च पाञ्चालानां च पश्यताम् ।\nत्वं वीर निधनं प्राप्तो नाथवान् सन्ननाथवत्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2178568, "chapter_id": 4776, "verse_number": "२३", "content_sanskrit": "दृष्ट्वा बहुभिराक्रन्दैर्निहितं त्वामनाथवत् ।\nवीराः पुरुषशार्दूलाः कथं जीवन्ति पाण्डवाः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2178569, "chapter_id": 4776, "verse_number": "२४", "content_sanskrit": "न राज्यलाभो विपुलः शत्रूणां वा पराभवः ।\nप्रीतिं दास्यति पार्थानां त्वामृते पुष्करेक्षण\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2178570, "chapter_id": 4776, "verse_number": "२५", "content_sanskrit": "तव शस्त्रजितान् लोकान् धर्मेण च दमेन च ।\nक्षिप्रमन्वागमिष्यामि तत्र मां प्रतिपालय\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2178571, "chapter_id": 4776, "verse_number": "२६", "content_sanskrit": "दुष्करं पुनरप्राप्ते काले भवति केनचित् ।\nयदहं त्वा(त्वां) रणे दृष्ट्वा हतं जीवामि दुर्भगा\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2178572, "chapter_id": 4776, "verse_number": "२७", "content_sanskrit": "कामिदानीं नरव्याघ्र त्वं श्लक्ष्णस्मितया गिरा ।\nपितृलोके समेत्यान्यां मामिवामन्त्रयिष्यसि\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2178573, "chapter_id": 4776, "verse_number": "२८", "content_sanskrit": "नूनमप्सरसां स्वर्गे मनांसि प्रमथिष्यसि ।\nपरमेण च रूपेण गिरा च स्मितपूर्वया\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2178574, "chapter_id": 4776, "verse_number": "२९", "content_sanskrit": "प्राप्य पुण्यकृताँल्लोकानप्सरोभिः समेयिवान् ।\nसौभद्र विहरन् काले स्मरेथाः सुकृतानि मे\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2178575, "chapter_id": 4776, "verse_number": "३०", "content_sanskrit": "एतावानिह संवासो विहितस्ते मया सह ।\nषण्मासान् सप्तमे मासे त्वं वीर निधनं गतः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2178576, "chapter_id": 4776, "verse_number": "", "content_sanskrit": "गान्धारी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2178577, "chapter_id": 4776, "verse_number": "३१", "content_sanskrit": "इत्युक्तवचनामेनामपाकर्षन्ति दुःखिताम् ।\nउत्तरां मोघसङ्कल्पां मत्स्यराजकुलस्त्रियः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2178578, "chapter_id": 4776, "verse_number": "३२", "content_sanskrit": "उत्तरामपकृष्यैतामार्तामार्ततराः स्वयम् ।\nविराटं निहतं दृष्ट्वा क्रोशन्ति विलपन्ति च\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2178579, "chapter_id": 4776, "verse_number": "३३", "content_sanskrit": "द्रोणास्त्रशरसङ्कृत्तं शयानं शोणितोक्षितम् ।\nविराटं वितुदन्त्येते गृध्रगोमायुवायसाः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2178580, "chapter_id": 4776, "verse_number": "३४", "content_sanskrit": "वितुद्यमानं विहगैर्विराटमसितेक्षणाः ।\nन शक्नुवन्ति विवशा विसर्जयितुमातुराः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2178581, "chapter_id": 4776, "verse_number": "३५", "content_sanskrit": "आसामातपतप्तानामायासेन च योषिताम् ।\nश्रमेण च विवर्णानां रूपाणां विकृतं वपुः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2178582, "chapter_id": 4776, "verse_number": "३६", "content_sanskrit": "उत्तरां चाभिमन्युं च काम्भोजं च सुदक्षिणम् ।\nशिशूनेतान् हतान् पश्य लक्ष(क्ष्म)णं च सुदर्शनम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2178583, "chapter_id": 4776, "verse_number": "३७", "content_sanskrit": "(कार्ष्णिनाऽभिहतं कृष्ण लक्षणं प्रियदर्शनम्) ।\nआयोधनशिरोमध्ये शयानं पश्य माधव\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2178584, "chapter_id": 4776, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां स्त्रीपर्वणि विंशोऽध्यायः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2178585, "chapter_id": 4776, "verse_number": "", "content_sanskrit": "स्त्रीपर्वणि पञ्चमोऽध्यायः ॥५॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]