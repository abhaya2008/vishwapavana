[{"id": 2006444, "chapter_id": 1128, "verse_number": "१-१२९-०x", "content_sanskrit": "कुन्त्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2006445, "chapter_id": 1128, "verse_number": "१-१२९-१", "content_sanskrit": "अपत्यकाम एवं स्यान्ममापत्यं भवेदिति।\nविप्रं वा गुणसंपन्नं सर्वभूतहिते रतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2006446, "chapter_id": 1128, "verse_number": "१-१२९-२", "content_sanskrit": "अनुजानीहि भद्रं ते दैवतं हि पतिः स्त्रियः।\nयं त्वं वक्ष्यसि धर्मज्ञ देवं ब्राह्मणमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2006447, "chapter_id": 1128, "verse_number": "१-१२९-३", "content_sanskrit": "यथोद्दिष्टं त्वया वीर तत्कर्तास्मि महाभुज।\nदेवात्पुत्रफलं सद्यो विप्रात्कालान्तरे भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2006448, "chapter_id": 1128, "verse_number": "१-१२९-४", "content_sanskrit": "आवाहयामि कं देवं कदा वा भरतर्षभ।\nत्वत्त आज्ञां प्रतीक्षन्तीं विद्ध्यस्मिन्कर्मणीप्सिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2006449, "chapter_id": 1128, "verse_number": "१-१२९-५x", "content_sanskrit": "पाण्डुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2006450, "chapter_id": 1128, "verse_number": "१-१२९-५", "content_sanskrit": "धन्योऽञस्म्यनुगृहीतोऽस्मि त्वं नो धात्री कुलस्य हि।\nनमो महर्षये तस्मै येन दत्तो वरस्तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2006451, "chapter_id": 1128, "verse_number": "१-१२९-६", "content_sanskrit": "न चाधर्मेण धर्मज्ञे शक्याः पालयितुं प्रजाः।\nतस्मात्त्वं पुत्रलाभाय सन्तानाय ममैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2006452, "chapter_id": 1128, "verse_number": "१-१२९-७", "content_sanskrit": "प्रवरं सर्वदेवानां धर्ममावाहयाबले।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2006453, "chapter_id": 1128, "verse_number": "१-१२९-७x", "content_sanskrit": "वैशम्पायन उवाच।\nपाण्डुना समनुज्ञाता भारतेन यशस्विना।\nमतिं चक्रे महाराज धर्मस्यावाहने तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2006454, "chapter_id": 1128, "verse_number": "१-१२९-८x", "content_sanskrit": "पाण्डुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2006455, "chapter_id": 1128, "verse_number": "१-१२९-८", "content_sanskrit": "अद्यैव त्वं वरारोहे प्रयतस्व यथाविधि।\nधार्मिकश्च कुरूणां हि भविष्यति न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2006456, "chapter_id": 1128, "verse_number": "१-१२९-९", "content_sanskrit": "दत्तस्य तस्य धर्मेण नाधर्मे रंस्यते मनः।\nधर्मादिकं हि धर्मज्ञे धर्मान्तं धर्ममध्यमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2006457, "chapter_id": 1128, "verse_number": "१-१२९-१०", "content_sanskrit": "अपत्यमिष्टं लोकेषु यशःकीर्तिविवर्धनम्।\nतस्माद्धर्मं पुरस्कृत्य नियता त्वं शुचिस्मिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2006458, "chapter_id": 1128, "verse_number": "१-१२९-११", "content_sanskrit": "आकाराचारसंपन्ना भजस्वाराधय स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2006459, "chapter_id": 1128, "verse_number": "१-१२९-१२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2006460, "chapter_id": 1128, "verse_number": "१-१२९-१२", "content_sanskrit": "सा तथोक्ता तथेत्युक्त्वा तेन भर्त्रा वराङ्गना।\nअभिवाद्याभ्यनुज्ञाता प्रदक्षिणमथाकरोत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2006461, "chapter_id": 1128, "verse_number": "१-१२९-१३", "content_sanskrit": "संवत्सरोषिते गर्भे गान्धार्या जनमेजय।\nआजुबहाव ततो धर्मं कुन्ती गर्भार्थमच्युतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2006462, "chapter_id": 1128, "verse_number": "१-१२९-१४", "content_sanskrit": "सा बलिं त्वरिता देवी धर्मायोपजहार ह।\nजजाप विधिवज्जप्यं दत्तं दुर्वाससा पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2006463, "chapter_id": 1128, "verse_number": "१-१२९-१५", "content_sanskrit": "जानन्ती धर्ममग्र्यं वै धर्मं वशमुपानयत्।\nआहूतो नियमात्कुन्त्या सर्वभूतनमस्कृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2006464, "chapter_id": 1128, "verse_number": "१-१२९-१६", "content_sanskrit": "आजगाम ततो देवीं धर्मो मन्त्रबलात्ततः।\nविमाने सूर्यसङ्काशे कुन्ती यत्र जपस्थिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2006465, "chapter_id": 1128, "verse_number": "१-१२९-१७", "content_sanskrit": "ददृशे भगवान्धर्मः सन्तानार्थाय पाण्डवे।\nविहस्य तां ततो ब्रूयाः कुन्ति किं ते ददाम्यहम्।\nसा तं विहस्यमानापि पुत्रं देह्यब्रवीदिदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2006466, "chapter_id": 1128, "verse_number": "१-१२९-१८", "content_sanskrit": "तस्मिन्बहुमृगेऽरण्ये शतशृङ्गे नगोत्तमे।\nपाण्डोरर्थे महाभागा कुन्ती धर्ममुपागमत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2006467, "chapter_id": 1128, "verse_number": "१-१२९-१९", "content_sanskrit": "ऋतुकाले शुचिः स्नाता शुक्लवस्त्रा यशस्विनी।\nशय्यां जग्राह सुश्रोणी सह धर्मेण सुव्रता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2006468, "chapter_id": 1128, "verse_number": "१-१२९-२०", "content_sanskrit": "धर्मेण सह संगम्य योगमूर्तिधरेण सा।\nलेभे पुत्रं महाबाहुं सर्वप्राणभृतां वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2006469, "chapter_id": 1128, "verse_number": "१-१२९-२१", "content_sanskrit": "ऐन्द्रे चन्द्रमसा युक्ते मुहूर्तेऽभिजितेऽष्टमे।\nदिवा मध्यगते सूर्ये तिथौ पूर्णे हि पूजिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2006470, "chapter_id": 1128, "verse_number": "१-१२९-२२", "content_sanskrit": "समृद्धयसशं कुन्ती सुषाव प्रवरं सुतम्।\nजातमात्रे सुते तस्मिन्वागुवाचाशरीरिणी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2006471, "chapter_id": 1128, "verse_number": "१-१२९-२३", "content_sanskrit": "एष धर्मभृतां श्रेष्ठो भविष्यति नरोत्तमः।\nविक्रान्तः सत्यवाक्चैव राजा पृथ्व्यां भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2006472, "chapter_id": 1128, "verse_number": "१-१२९-२४", "content_sanskrit": "युधिष्ठिर इति ख्यातः पाण्डोः प्रथमजः सुतः।\nभविता प्रथितो राजा त्रिषु लोकेषु विश्रुतः।\nयशसा तेजसा चैव वृत्तेन च समन्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2006473, "chapter_id": 1128, "verse_number": "१-१२९-२५", "content_sanskrit": "संवत्सरे द्वितीये तु गान्धार्या उदरं महत्।\nन च प्राजायत तदा ततस्तां दुःखमाविशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2006474, "chapter_id": 1128, "verse_number": "१-१२९-२६", "content_sanskrit": "श्रुत्वा कुन्तीसुतं जातं बालार्कसमतेजसम्।\nउदस्यात्मनः स्थैर्यमुपालभ्य च सौबली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2006475, "chapter_id": 1128, "verse_number": "१-१२९-२७", "content_sanskrit": "कौरवस्यापरिज्ञातं यत्नेन महता स्वयम्।\nउदरं घातयामास गान्धारी शोकमूर्छिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2006476, "chapter_id": 1128, "verse_number": "१-१२९-२८", "content_sanskrit": "ततो जज्ञे मांसपेशी लोहाष्ठीलेव संहता।\nद्विवर्षसंभृता कुक्षौ तामुत्स्रष्टुं प्रचक्रमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2006477, "chapter_id": 1128, "verse_number": "१-१२९-२९", "content_sanskrit": "अथ द्वैपायनो ज्ञात्वा त्वरितः समुपागमत्।\nतां स मांसमयीं पेशीं ददर्श जपतां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2006478, "chapter_id": 1128, "verse_number": "१-१२९-३०", "content_sanskrit": "ततोऽवदत्सौबलेयीं किमिदं ते चिकीर्षितम्।\nसा चात्मनो मतं सर्वं शशंस परमर्षये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2006479, "chapter_id": 1128, "verse_number": "१-१२९-३१x", "content_sanskrit": "गान्धार्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2006480, "chapter_id": 1128, "verse_number": "१-१२९-३१", "content_sanskrit": "ज्येष्ठं कुन्तीसुतं जातं श्रुत्वा रविसमप्रभम्।\nदुःखेन परमेणेदमुदरं घातितं मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2006481, "chapter_id": 1128, "verse_number": "१-१२९-३२", "content_sanskrit": "शतं च किल पुत्राणां वितीर्णं मे त्वया पुरा।\nइयं च मे मांसपेशी जाता पुत्रशताय वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2006482, "chapter_id": 1128, "verse_number": "१-१२९-३३x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2006483, "chapter_id": 1128, "verse_number": "१-१२९-३३", "content_sanskrit": "एवमेतत्सौबलेयि नैतज्जात्वन्यथा भवेत्।\nवितथं नोक्तपूर्वं मे स्वैरेष्वपि कुतोऽन्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2006484, "chapter_id": 1128, "verse_number": "१-१२९-३४", "content_sanskrit": "घृतपूर्णं कुण्डशतं क्षिप्रमेव विधीयताम्।\nसुगुप्तेषु च देशेषु रक्षा चैव विधीयताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2006485, "chapter_id": 1128, "verse_number": "१-१२९-३५", "content_sanskrit": "शीताभिरद्भिरष्ठीलामिमां च परिषिञ्चय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2006486, "chapter_id": 1128, "verse_number": "१-१२९-३६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2006487, "chapter_id": 1128, "verse_number": "१-१२९-३६", "content_sanskrit": "सा सिच्यमाना ह्यष्ठीला ह्यभवच्छतधा तदा।\nअङ्गुष्ठपर्वभात्राणां गर्भाणां तत्क्षणं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2006488, "chapter_id": 1128, "verse_number": "१-१२९-३७", "content_sanskrit": "एकाधिकशतं पूर्णं यथायोगं विशांपते।\nततः कुण्डशतं तत्र आनाय्य तु महानृषिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2006489, "chapter_id": 1128, "verse_number": "१-१२९-३८", "content_sanskrit": "मांसपेश्यास्तदा राजन्क्रमशः कालपर्ययात्।\nततस्तांस्तेषु कुण्डेषु गर्भान्सर्वान्समादधत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2006490, "chapter_id": 1128, "verse_number": "१-१२९-३९", "content_sanskrit": "स्वनुगुप्तेषु देशेषु रक्षां चैषां व्यधापयत्।\nशशास चैव कृष्णो वै गर्भाणां रक्षणं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2006491, "chapter_id": 1128, "verse_number": "१-१२९-४०", "content_sanskrit": "उवाच चैनां भगवान्कालेनैतावता पुनः।\nस्फुटमानेषु कुण्डेषु जाताञ्जानीहि शोभने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2006492, "chapter_id": 1128, "verse_number": "१-१२९-४१", "content_sanskrit": "उद्धाटनीयान्येतानि कुण्डानीति च सौबलीम्।\nइत्युक्त्वा भगवान्व्यासस्तथा प्रतिविधाय च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2006493, "chapter_id": 1128, "verse_number": "१-१२९-४२", "content_sanskrit": "जगाम तपसे धीमान्हिमवन्तं शिलोच्चयम्।\nअह्नोत्तराः कुमारस्ते कुण्डेभ्यस्तु समुत्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2006494, "chapter_id": 1128, "verse_number": "१-१२९-४३", "content_sanskrit": "तेनैवैषां क्रमेणासीज्ज्योष्ठानुज्येष्ठता तदा।\nजन्मतश्च प्रमाणेन ज्येष्ठः कुन्तीसुतोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2006495, "chapter_id": 1128, "verse_number": "१-१२९-४४", "content_sanskrit": "धार्मिकं च सुतं दृष्ट्वा पाण्डुः कुन्तीमथाऽब्रवीत्।\nप्राहुः क्षत्रं बलज्येष्ठं बलज्येष्ठं सुतं वृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2006496, "chapter_id": 1128, "verse_number": "१-१२९-४५", "content_sanskrit": "ततः कुन्तीमभिक्रम्य शशासातीव भारत।\nवायुमावाहयस्वेति स देवो बलवत्तरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2006497, "chapter_id": 1128, "verse_number": "१-१२९-४६", "content_sanskrit": "अश्वमेधः क्रतुश्रेष्ठो ज्योतिःश्रेष्ठो दिवाकरः।\nब्राह्मणो द्विपदां श्रेष्ठो देवश्रेष्ठश्च मारुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2006498, "chapter_id": 1128, "verse_number": "१-१२९-४७", "content_sanskrit": "मारुतं मरुतां श्रेष्ठं सर्वप्राणिभिरीडितम्।\nआवाहय त्वं नियमात्पुत्रार्थं वरवर्णिनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2006499, "chapter_id": 1128, "verse_number": "१-१२९-४८", "content_sanskrit": "स नो यं दास्यति सुतं स प्राणबलवान्नृषु।\nभविष्यति वरारोहे बलज्येष्ठा हि भूमिपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2006500, "chapter_id": 1128, "verse_number": "१-१२९-४९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2006501, "chapter_id": 1128, "verse_number": "१-१२९-४९", "content_sanskrit": "तथोक्तवति सा काले वायुमेवाजुहाव ह।\nद्वितीयेनोपहारेण तेनोक्तविधिना पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2006502, "chapter_id": 1128, "verse_number": "१-१२९-५०", "content_sanskrit": "तैरेव नियमैः स्थित्वा मन्त्रग्राममुदैरयत्।\nआजगाम ततो वायुः किं करोमीति चाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2006503, "chapter_id": 1128, "verse_number": "१-१२९-५१", "content_sanskrit": "लज्जान्विता ततः कुन्ती पुत्रमैच्छन्महाबलम्।\nतथास्त्विति च तां वायुः समालभ्य दिवं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2006504, "chapter_id": 1128, "verse_number": "१-१२९-५२", "content_sanskrit": "तस्यां जज्ञे महावीर्यो भीमो भीमपराक्रमः।\nतमप्यतिबलं जातं वागुवाचाशरीरिणी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2006505, "chapter_id": 1128, "verse_number": "१-१२९-५३", "content_sanskrit": "सर्वेषां बलिनां श्रेष्ठो जातोऽयमिति भारत।\nजातमात्रे कुमारे तु सर्वलोकस्य पार्थिवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2006506, "chapter_id": 1128, "verse_number": "१-१२९-५४", "content_sanskrit": "मूत्रं प्रसुस्रुवुः सर्वे व्यथां चापि प्रपेदिरे।\nवाहनानि व्यशीर्यन्त व्यमुञ्चन्नश्रुबिन्दवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2006507, "chapter_id": 1128, "verse_number": "१-१२९-५५", "content_sanskrit": "यथाऽनिलः समुद्भूतः समर्थः कम्पने भुवः।\nतथा ह्युपचिताङ्गो वै भीमो भीमपराक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2006508, "chapter_id": 1128, "verse_number": "१-१२९-५६", "content_sanskrit": "इदं चाद्भुतमत्रासीज्जातमात्रे वृकोदरे।\nयदऱ्कात्पतितो मातुः शिलां गात्रैरचूर्णयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2006509, "chapter_id": 1128, "verse_number": "१-१२९-५७", "content_sanskrit": "कुन्ती तु सह पुत्रेण याता सुरुचिरं सरः।\nस्नात्वा च सुतमादाय दशमेऽहनि यादवी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2006510, "chapter_id": 1128, "verse_number": "१-१२९-५८", "content_sanskrit": "दैवतान्यर्चयिष्यन्ती निर्जगामाश्रमात्पृथा।\nशैलाभ्याशेन गच्छन्त्यास्तदा भरतसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2006511, "chapter_id": 1128, "verse_number": "१-१२९-५९", "content_sanskrit": "निश्चक्राम महाव्याघ्रो जिघांसुर्गिरिगह्वरात्।\nतमापतन्तं शार्दूलं विकृष्य धनुरुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2006512, "chapter_id": 1128, "verse_number": "१-१२९-६०", "content_sanskrit": "निर्बिभेद शरैः पाण्डुस्त्रिभिस्तिरदशविक्रमः।\nनादेन महता तां तु पूरयन्तं गिरेर्गुहाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2006513, "chapter_id": 1128, "verse_number": "१-१२९-६१", "content_sanskrit": "दृष्ट्वा शैलमुपारोढुमैच्छत्कुन्ती भयात्तदा।\nत्रासात्तस्याः सुतस्त्वङ्कात्पपात भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2006514, "chapter_id": 1128, "verse_number": "१-१२९-६२", "content_sanskrit": "पर्वतस्योपरिस्थायामधस्तादपतच्छिशुः।\nस शिलां चूर्णयामास वज्रवद्वज्रिचोदितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2006515, "chapter_id": 1128, "verse_number": "१-१२९-६३", "content_sanskrit": "पुत्रस्नेहात्ततः पाण्डुरभ्यधावद्गिरेस्तटम्।\nपतता तेन शतधा शिला गात्रैर्विचूर्णिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2006516, "chapter_id": 1128, "verse_number": "१-१२९-६४", "content_sanskrit": "शिलां च चूर्णितां दृष्ट्वा परं विस्मयमागमत्।\nस तु जन्मनि भीमस्य विनदन्तं विनादितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2006517, "chapter_id": 1128, "verse_number": "१-१२९-६५", "content_sanskrit": "ददर्श गिरिशृङ्गस्थं व्याघ्रं व्याघ्रपराक्रमः।\nदारसंरक्षणार्थाय पुत्रसंरक्षणाय च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2006518, "chapter_id": 1128, "verse_number": "१-१२९-६६", "content_sanskrit": "सदा बाणधनुष्पाणिरभवत्कुरुनन्दनः।\nमघे चन्द्रमसा युक्ते सिंहे चाभ्युदिते गुरौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2006519, "chapter_id": 1128, "verse_number": "१-१२९-६७", "content_sanskrit": "दिवा मध्यगते सूर्ये तिथौ पुण्ये त्रयोदशे।\nपित्र्ये मुहूर्ते सा कुन्ती सुषुवे भीममच्युतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2006520, "chapter_id": 1128, "verse_number": "१-१२९-६८", "content_sanskrit": "यस्मिन्नहनि भमस्तु जज्ञे भीमपराक्रमः।\nतामेव रात्रिं पूर्वां तु जज्ञे दुर्योधनो नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2006521, "chapter_id": 1128, "verse_number": "१-१२९-६९", "content_sanskrit": "स जातमात्र एवाथ धृतराष्ट्रसुतो नृप।\nरासभारावसदृशं रुराव च ननाद च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2006522, "chapter_id": 1128, "verse_number": "१-१२९-७०", "content_sanskrit": "तं खराः प्रत्यभाषन्त गृध्रगोमायुवायसाः।\nक्रव्यादाः प्राणदन्घोराः शिवाश्चाशिवनिस्वनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2006523, "chapter_id": 1128, "verse_number": "१-१२९-७१", "content_sanskrit": "वाताश्च प्रववुश्चापि दिग्दाहश्चाभवत्तदा।\nततस्तु भीतवद्राजा धृतराष्ट्रोऽब्रवीदिदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2006524, "chapter_id": 1128, "verse_number": "१-१२९-७२", "content_sanskrit": "समानीय बहून्विप्रान्भीष्मं विदुरमेव च।\nअन्यांश्च सुहृदो राजन्कुरून्सर्वांस्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2006525, "chapter_id": 1128, "verse_number": "१-१२९-७३", "content_sanskrit": "युधिष्ठिरो राजपुत्रो ज्येष्ठो नः कुलवर्धनः।\nप्राप्तः स्वगुणतो राज्यं न तस्मिन्वाच्यमस्तिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2006526, "chapter_id": 1128, "verse_number": "१-१२९-७४", "content_sanskrit": "अयं त्वनन्तरस्तस्मादपि राजा भविष्यति।\nएतद्विब्रूत मे तथ्यं यदत्र भविता ध्रुवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2006527, "chapter_id": 1128, "verse_number": "१-१२९-७५", "content_sanskrit": "अस्मिञ्जाते निमित्तानि शंसन्ती हाशिवं महत्।\nअतो ब्रवीमि विदुर द्रुतं मां भयमाविशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2006528, "chapter_id": 1128, "verse_number": "१-१२९-७६", "content_sanskrit": "वाक्यस्यैतस्य निधेन दिक्षु सर्वासु भारत।\nक्रव्यादाः प्राणदन्घोराः शिवाश्चाशिवनिस्वनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2006529, "chapter_id": 1128, "verse_number": "१-१२९-७७", "content_sanskrit": "लक्षयित्वा निमित्तानि तानि घोराणि सर्वशः।\nतेऽब्रुवन्ब्राह्मणा राजन्विदुरश्च महामतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2006530, "chapter_id": 1128, "verse_number": "१-१२९-७८", "content_sanskrit": "यथेमानि निमित्तानि घोराणि मनुजाधिप।\nउत्थितानि सुते जाते ज्येष्ठे ते पुरुषर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2006531, "chapter_id": 1128, "verse_number": "१-१२९-७९", "content_sanskrit": "व्यक्तं कुलान्तकरणो भवितैष सुतस्तव।\nतस्य शान्तिः परित्यागे गुप्तावपनयो महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2006532, "chapter_id": 1128, "verse_number": "१-१२९-८०", "content_sanskrit": "एष दुर्योधनो राजा मधुपिङ्गललोचनः।\nन केवलं कुलस्यान्तं क्षत्रियान्तं करिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2006533, "chapter_id": 1128, "verse_number": "१-१२९-८१", "content_sanskrit": "शतमेकोनमप्यस्तु पुत्राणां ते महीपते।\nत्यजैनमेकं शान्तिं चेत्कुलस्येच्छसि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2006534, "chapter_id": 1128, "verse_number": "१-१२९-८२", "content_sanskrit": "एकेन कुरु वै क्षेमं कुलस्य जगतस्तथा।\nत्यजेदेकं कुलस्यार्थे ग्रामस्यार्थे कुलं त्यजेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2006535, "chapter_id": 1128, "verse_number": "१-१२९-८३", "content_sanskrit": "ग्रामं जनपदस्यार्थे आत्मार्थे पृथिवीं त्यजेत्।\nस तथा विदुरेणोक्तस्तैश्च सर्वैर्द्विजोत्तमैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2006536, "chapter_id": 1128, "verse_number": "१-१२९-८४", "content_sanskrit": "न चकार तथा राजा पुत्रस्नेहसमन्वितः।\nततः पुत्रशतं पूर्ण धृतराष्ट्रस्य पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2006537, "chapter_id": 1128, "verse_number": "१-१२९-८५", "content_sanskrit": "अह्नांशतेन संजज्ञे कन्या चैका शताधिका।\nगान्धार्यां क्लिश्यमानायामुदरेण विवर्धता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2006538, "chapter_id": 1128, "verse_number": "१-१२९-८६", "content_sanskrit": "वैश्या सा त्वम्बिकापुत्रं कन्या परिचचार ह।\nतया समभवद्राजा धृतराष्ट्रो यदृच्छया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2006539, "chapter_id": 1128, "verse_number": "१-१२९-८७", "content_sanskrit": "तस्मिन्संवत्सरे राजन्धृतराष्ट्रान्महायशाः।\nजज्ञे धीमांस्ततस्तस्यां युयुत्सुः करमो नृप।\nएवं पुत्रशतं जज्ञे धृतराष्ट्रस्य धीमतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2006540, "chapter_id": 1128, "verse_number": "१-१२९-८८", "content_sanskrit": "महारथानां वीराणां कन्या चैका शताधिका।\nयुयुत्सुश्च महातेजा वैश्यापुत्रः प्रतापवान्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2006541, "chapter_id": 1128, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि एकोनत्रिंशदधिकशततमोऽध्यायः॥ १२९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}]