[{"id": 5000114000, "chapter_id": 9114, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अयोध्याकाण्डे सप्तत्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000114001, "chapter_id": 9114, "verse_number": "२-३७-१", "content_sanskrit": "महामात्रवचः श्रुत्वा रामो दशरथं तदा।\nअभ्यभाषत वाक्यं तु विनयज्ञो विनीतवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000114002, "chapter_id": 9114, "verse_number": "२-३७-२", "content_sanskrit": "त्यक्तभोगस्य मे राजन् वने वन्येन जीवतः।\nकिं कार्यमनुयात्रेण त्यक्तसङ्गस्य सर्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000114003, "chapter_id": 9114, "verse_number": "२-३७-३", "content_sanskrit": "यो हि दत्त्वा द्विपश्रेष्ठं कक्ष्यायां कुरुते मनः।\nरज्जुस्नेहेन किं तस्य त्यजतः कुञ्जरोत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000114004, "chapter_id": 9114, "verse_number": "२-३७-४", "content_sanskrit": "तथा मम सतां श्रेष्ठ किं ध्वजिन्या जगत्पते।\nसर्वाण्येवानुजानामि चीराण्येवानयन्तु मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000114005, "chapter_id": 9114, "verse_number": "२-३७-५", "content_sanskrit": "खनित्रपिटके चोभे समानयत गच्छत।\nचतुर्दश वने वासं वर्षाणि वसतो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000114006, "chapter_id": 9114, "verse_number": "२-३७-६", "content_sanskrit": "अथ चीराणि कैकेयी स्वयमाहृत्य राघवम्।\nउवाच परिधत्स्वेति जनौघे निरपत्रपा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000114007, "chapter_id": 9114, "verse_number": "२-३७-७", "content_sanskrit": "स चीरे पुरुषव्याघ्रः कैकेय्याः प्रतिगृह्य ते।\nसूक्ष्मवस्त्रमवक्षिप्य मुनिवस्त्राण्यवस्त ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000114008, "chapter_id": 9114, "verse_number": "२-३७-८", "content_sanskrit": "लक्ष्मणश्चापि तत्रैव विहाय वसने शुभे।\nतापसाच्छादने चैव जग्राह पितुरग्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000114009, "chapter_id": 9114, "verse_number": "२-३७-९", "content_sanskrit": "अथात्मपरिधानार्थं सीता कौशेयवासिनी।\nसम्प्रेक्ष्य चीरं संत्रस्ता पृषती वागुरामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000114010, "chapter_id": 9114, "verse_number": "२-३७-१०", "content_sanskrit": "सा व्यपत्रपमाणेव प्रगृह्य च सुदुर्मनाः।\nकैकेय्याः कुशचीरे ते जानकी शुभलक्षणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000114011, "chapter_id": 9114, "verse_number": "२-३७-११", "content_sanskrit": "अश्रुसम्पूर्णनेत्रा च धर्मज्ञा धर्मदर्शिनी।\nगन्धर्वराजप्रतिमं भर्तारमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000114012, "chapter_id": 9114, "verse_number": "२-३७-१२", "content_sanskrit": "कथं नु चीरं बघ्नन्ति मुनयो वनवासिनः।\nइति ह्यकुशला सीता सा मुमोह मुहुर्मुहुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000114013, "chapter_id": 9114, "verse_number": "२-३७-१३", "content_sanskrit": "कृत्वा कण्ठे स्म सा चीरमेकमादाय पाणिना।\nतस्थौ ह्यकुशला तत्र व्रीडिता जनकात्मजा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000114014, "chapter_id": 9114, "verse_number": "२-३७-१४", "content_sanskrit": "तस्यास्तत् क्षिप्रमागत्य रामो धर्मभृतां वरः।\nचीरं बबन्ध सीतायाः कौशेयस्योपरि स्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000114015, "chapter_id": 9114, "verse_number": "२-३७-१५", "content_sanskrit": "रामं प्रेक्ष्य तु सीताया बध्नन्तं चीरमुत्तमम्।\nअन्तःपुरचरा नार्यो मुमुचुर्वारि नेत्रजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000114016, "chapter_id": 9114, "verse_number": "२-३७-१६", "content_sanskrit": "ऊचुश्च परमायत्ता रामं ज्वलिततेजसम्।\nवत्स नैवं नियुक्तेयं वनवासे मनस्विनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000114017, "chapter_id": 9114, "verse_number": "२-३७-१७", "content_sanskrit": "पितुर्वाक्यानुरोधेन गतस्य विजनं वनम्।\nतावद् दर्शनमस्या नः सफलं भवतु प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000114018, "chapter_id": 9114, "verse_number": "२-३७-१८", "content_sanskrit": "लक्ष्मणेन सहायेन वनं गच्छस्व पुत्रक।\nनेयमर्हति कल्याणि वस्तुं तापसवद् वने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000114019, "chapter_id": 9114, "verse_number": "२-३७-१९", "content_sanskrit": "कुरु नो याचनां पुत्र सीता तिष्ठतु भामिनी।\nधर्मनित्यः स्वयं स्थातुं न हीदानीं त्वमिच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000114020, "chapter_id": 9114, "verse_number": "२-३७-२०", "content_sanskrit": "तासामेवंविधा वाचः शृण्वन् दशरथात्मजः।\nबबन्धैव तथा चीरं सीतया तुल्यशीलया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000114021, "chapter_id": 9114, "verse_number": "२-३७-२१", "content_sanskrit": "चीरे गृहीते तु तया सबाष्पो नृपतेर्गुरुः।\nनिवार्य सीतां कैकेयीं वसिष्ठो वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000114022, "chapter_id": 9114, "verse_number": "२-३७-२२", "content_sanskrit": "अतिप्रवृत्ते दुर्मेधे कैकेयि कुलपांसनि।\nवञ्चयित्वा तु राजानं न प्रमाणेऽवतिष्ठसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000114023, "chapter_id": 9114, "verse_number": "२-३७-२३", "content_sanskrit": "न गन्तव्यं वनं देव्या सीतया शीलवर्जिते।\nअनुष्ठास्यति रामस्य सीता प्रकृतमासनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000114024, "chapter_id": 9114, "verse_number": "२-३७-२४", "content_sanskrit": "आत्मा हि दाराः सर्वेषां दारसंग्रहवर्तिनाम्।\nआत्मेयमिति रामस्य पालयिष्यति मेदिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000114025, "chapter_id": 9114, "verse_number": "२-३७-२५", "content_sanskrit": "अथ यास्यति वैदेही वनं रामेण संगता।\nवयमत्रानुयास्यामः पुरं चेदं गमिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000114026, "chapter_id": 9114, "verse_number": "२-३७-२६", "content_sanskrit": "अन्तपालाश्च यास्यन्ति सदारो यत्र राघवः।\nसहोपजीव्यं राष्ट्रं च पुरं च सपरिच्छदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000114027, "chapter_id": 9114, "verse_number": "२-३७-२७", "content_sanskrit": "भरतश्च सशत्रुघ्नश्चीरवासा वनेचरः।\nवने वसन्तं काकुत्स्थमनुवत्स्यति पूर्वजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000114028, "chapter_id": 9114, "verse_number": "२-३७-२८", "content_sanskrit": "ततः शून्यां गतजनां वसुधां पादपैः सह।\nत्वमेका शाधि दुर्वृत्ता प्रजानामहिते स्थिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000114029, "chapter_id": 9114, "verse_number": "२-३७-२९", "content_sanskrit": "न हि तद् भविता राष्ट्रं यत्र रामो न भूपतिः।\nतद् वनं भविता राष्ट्रं यत्र रामो निवत्स्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000114030, "chapter_id": 9114, "verse_number": "२-३७-३०", "content_sanskrit": "न ह्यदत्तां महीं पित्रा भरतः शास्तुमिच्छति।\nत्वयि वा पुत्रवद् वस्तुं यदि जातो महीपतेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000114031, "chapter_id": 9114, "verse_number": "२-३७-३१", "content_sanskrit": "यद्यपि त्वं क्षितितलाद् गगनं चोत्पतिष्यसि।\nपितृवंशचरित्रज्ञः सोऽन्यथा न करिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000114032, "chapter_id": 9114, "verse_number": "२-३७-३२", "content_sanskrit": "तत् त्वया पुत्रगर्धिन्या पुत्रस्य कृतमप्रियम्।\nलोके नहि स विद्येत यो न राममनुव्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000114033, "chapter_id": 9114, "verse_number": "२-३७-३३", "content_sanskrit": "द्रक्ष्यस्यद्यैव कैकेयि पशुव्यालमृगद्विजान्।\nगच्छतः सह रामेण पादपांश्च तदुन्मुखान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000114034, "chapter_id": 9114, "verse_number": "२-३७-३४", "content_sanskrit": "अथोत्तमान्याभरणानि देवि\nदेहि स्नुषायै व्यपनीय चीरम्।\nन चीरमस्याः प्रविधीयतेति\nन्यवारयत् तद् वसनं वसिष्ठः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000114035, "chapter_id": 9114, "verse_number": "२-३७-३५", "content_sanskrit": "एकस्य रामस्य वने निवास-\nस्त्वया वृतः केकयराजपुत्रि।\nविभूषितेयं प्रतिकर्मनित्या\nवसत्वरण्ये सह राघवेण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000114036, "chapter_id": 9114, "verse_number": "२-३७-३६", "content_sanskrit": "यानैश्च मुख्यैः परिचारकैश्च\nसुसंवृता गच्छतु राजपुत्री।\nवस्त्रैश्च सर्वैः सहितैर्विधानै-\nर्नेयं वृता ते वरसम्प्रदाने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000114037, "chapter_id": 9114, "verse_number": "२-३७-३७", "content_sanskrit": "तस्मिंस्तथा जल्पति विप्रमुख्ये\nगुरौ नृपस्याप्रतिमप्रभावे।\nनैव स्म सीता विनिवृत्तभावा\nप्रियस्य भर्तुः प्रतिकारकामा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000114038, "chapter_id": 9114, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अयोध्याकाण्डे सप्तत्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]