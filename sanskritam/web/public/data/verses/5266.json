[{"id": 2200317, "chapter_id": 5266, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2200318, "chapter_id": 5266, "verse_number": "१", "content_sanskrit": "यास्तु गोमातरस्तस्य कामचारिण्य आगताः ।\nसमीपं हि सुमित्रस्य कृतज्ञाः समुपस्थिताः\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2200319, "chapter_id": 5266, "verse_number": "२", "content_sanskrit": "अभिप्रशस्य चैवाहुस्तमृषिं पुण्यदर्शनाः ।\nगोलोकादागता वेद ऋषे गोमातरो वयम्\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2200320, "chapter_id": 5266, "verse_number": "३", "content_sanskrit": "सुप्रीताः स्म वरं गृह्ण यमिच्छसि महामुने ।\nयद्धि गोषु परां बुद्धिं कृतवानसि नित्यदा\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2200321, "chapter_id": 5266, "verse_number": "", "content_sanskrit": "सुमित्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2200322, "chapter_id": 5266, "verse_number": "४", "content_sanskrit": "प्रीतोऽस्म्यनुगृहीतोऽस्मि यन्मां गोमातरः शुभाः ।\nसुप्रीतमनसः सर्वास्तिष्ठन्ते च वरप्रदाः\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2200323, "chapter_id": 5266, "verse_number": "५", "content_sanskrit": "भवेद् गोष्वेव मे भक्तिर्यथैवाद्य तथा सदा ।\nगोघ्नाश्चैवावसीदन्तु नरा ब्रह्मद्विषश्च ये\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2200324, "chapter_id": 5266, "verse_number": "", "content_sanskrit": "गोमातरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2200325, "chapter_id": 5266, "verse_number": "६", "content_sanskrit": "एवमेतदृषिश्रेष्ठ हितं वदसि नः प्रियम् ।\nएहि गच्छ सहास्माभिर्गोलोकमृषिसत्तम\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2200326, "chapter_id": 5266, "verse_number": "", "content_sanskrit": "सुमित्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2200327, "chapter_id": 5266, "verse_number": "७", "content_sanskrit": "यूयमिष्टां गतिं यान्तु न ह्यहं गन्तुमुत्सहे ।\nइमा गावः समुत्सृज्य तपस्विन्यो मम प्रियाः\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2200328, "chapter_id": 5266, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2200329, "chapter_id": 5266, "verse_number": "८", "content_sanskrit": "तास्तु तस्य वचः श्रुत्वा कपिलानां सुदारुणम् ।\nनिन्युस्तमृषिमुत्क्षिप्य भार्गवं नभ उद्वहन्\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2200330, "chapter_id": 5266, "verse_number": "९", "content_sanskrit": "कळेवरं तु तत्रैव तस्य सन्न्यस्य मातरः ।\nनिष्कृष्य करणं योगादानयन् भार्गवस्य वै\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2200331, "chapter_id": 5266, "verse_number": "१०", "content_sanskrit": "सर्वं चास्य तदाचख्युः कपिलानां विचेष्टितम् ।\nयदर्थं हरणं गोभिर्गोलोकं लोकमातरः\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2200332, "chapter_id": 5266, "verse_number": "११", "content_sanskrit": "ततस्तु कपिलास्तत्र तस्य दृष्ट्वा कळेवरम् ।\nतथाप्रतिज्ञं शृङ्गैश्च खुरैश्चाप्यवचूर्णयन्\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2200333, "chapter_id": 5266, "verse_number": "१२", "content_sanskrit": "ततः सञ्छिद्य बहुधा भार्गवं नृपसत्तम ।\nययुर्यत्रेतरा गावस्तच्च सर्वं न्यवेदयन्\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2200334, "chapter_id": 5266, "verse_number": "१३", "content_sanskrit": "अथ गोमातृभिः शप्तास्ता गावः पृथिवीचराः ।\nअमेध्यवदनाः क्षिप्रं भवध्वं ब्रह्मघातकाः\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2200335, "chapter_id": 5266, "verse_number": "१४", "content_sanskrit": "एवं कृतज्ञा गावो हि यथा गोमातरो नृप ।\nऋषिश्च प्राप्तवाँल्लोकं गावश्च परिमोक्षिताः\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2200336, "chapter_id": 5266, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे भार्गवस्य गोलोकप्राप्तिर्नाम सप्तदशाधिकशततमोऽध्यायः ॥११७॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]