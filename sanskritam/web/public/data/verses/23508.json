[{"id": 7003508000, "chapter_id": 23508, "verse_number": "१४८-१", "content_sanskrit": "अथ स्तुतस्वामिमाहात्म्यम् ।\nसूत उवाच ।\nगोनिष्क्रमणमाहात्म्यं श्रुत्वा गुह्यमनुत्तमम् ।\nविस्मयं परमं गत्वा सर्वरत्नविभूषिता ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003508001, "chapter_id": 23508, "verse_number": "१४८-२", "content_sanskrit": "धरण्युवाच ।\nअहो गवां हि माहात्म्यं तव चैवं श्रुतं मया ।\nयच्छ्रुत्वाऽहं जगन्नाथ जातास्मि परिनिर्वृता ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003508002, "chapter_id": 23508, "verse_number": "१४८-३", "content_sanskrit": "एवमेव परं गुह्यं ब्रूहि नारायण प्रभो ।\nअस्मात्क्षेत्रात्परं देव यदि क्षेत्रं विशिष्यते ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003508003, "chapter_id": 23508, "verse_number": "१४८-४", "content_sanskrit": "श्रीवराह उवाच ।\nअहं नारायणो देवः सर्वधर्मव्यपाश्रयः ।\nमात्सर्यं चैव मे नास्ति तेनाहं परमः प्रभुः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003508004, "chapter_id": 23508, "verse_number": "१४८-५", "content_sanskrit": "एतच्छास्त्रं महाभागे प्रयुक्तं लीलया मया ।\nवराहरूपमादाय सर्वभागवतप्रियम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003508005, "chapter_id": 23508, "verse_number": "१४८-६", "content_sanskrit": "धरण्युवाच ।\nयथा यथा भाषसि धर्मकारणमिदं वचो धर्मविनिश्चयं महत् ।\nतथा तथा देव वराऽप्रमेयं हृद्यं मनो भावयसे जनार्दन ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003508006, "chapter_id": 23508, "verse_number": "१४८-७", "content_sanskrit": "ततो महीवचः श्रुत्वा धर्मश्रेष्ठी महामनाः ।\nवराहरूपी भगवान्प्रत्युवाच वसुन्धराम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003508007, "chapter_id": 23508, "verse_number": "१४८-८", "content_sanskrit": "श्रीवराह उवाच ।\nसाधु भूमे महाभागे मम कर्मव्यवस्थिते ।\nकथयिष्याम्यहं ह्येवं गुह्यं लोकसुखावहम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003508008, "chapter_id": 23508, "verse_number": "१४८-९", "content_sanskrit": "स्तुतस्वामीति विख्यातं गुह्यं क्षेत्रं परं मम ।\nह्यपरं युगमासाद्य तत्र स्थास्यामि सुन्दरि ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003508009, "chapter_id": 23508, "verse_number": "१४८-१०", "content_sanskrit": "पुत्रोऽहं वसुदेवस्य देवक्या गर्भसम्भवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003508010, "chapter_id": 23508, "verse_number": "१४८-११", "content_sanskrit": "वासुदेव इति ख्यातः सर्वदानवसूदनः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003508011, "chapter_id": 23508, "verse_number": "१४८-१२", "content_sanskrit": "पञ्च तस्य सुशिष्याश्च भविष्यन्ति विचक्षणाः ।\nऋषयो धर्मसंयुक्ता मत्प्रसादाद्बलाश्रिताः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003508012, "chapter_id": 23508, "verse_number": "१४८-१३", "content_sanskrit": "ते मां संस्थापयिष्पन्ति धर्ममूर्त्तिं महीं गतम् ।\nशाण्डिल्यो जाजलिश्चैव कपिलश्चोपसायकः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003508013, "chapter_id": 23508, "verse_number": "१४८-१४", "content_sanskrit": "भृगुश्चैव महाभागे मम मागार्नुसारिणः ।\nते च प्रसन्नमनस आत्मदृष्टान्तदर्शिनः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003508014, "chapter_id": 23508, "verse_number": "१४८-१५", "content_sanskrit": "स्वयं ज्ञानप्रभावेण भासयिष्यन्ति मां सदा ।\nसङ्कर्षणो वासुदेवो प्रद्युम्नो ह्यनिरुद्धकः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003508015, "chapter_id": 23508, "verse_number": "१४८-१६", "content_sanskrit": "गच्छता बहुकालेन मम कर्मपरायणः ।\nततो दीर्घेण कालेन इज्यापूर्वस्थितेन च ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003508016, "chapter_id": 23508, "verse_number": "१४८-१७", "content_sanskrit": "वरं तेषां प्रदास्यामि यो यस्य हृदि संस्थितः ।\nते प्रवक्ष्यन्ति मां देवि आत्मशास्त्रव्यवस्थिताः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003508017, "chapter_id": 23508, "verse_number": "१४८-१८", "content_sanskrit": "आत्मशास्त्रं प्रतिष्ठेत यत्र धर्मः सुनिष्ठितः ।\nभवत्वेतन्निश्चयेन न तु मिथ्या कदाचन ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003508018, "chapter_id": 23508, "verse_number": "१४८-१९", "content_sanskrit": "तव देव प्रसादेन इहलोकः प्रवर्तताम् ।\nतानप्येवं वदिष्यामि शिष्याय भवतां प्रियम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003508019, "chapter_id": 23508, "verse_number": "१४८-२०", "content_sanskrit": "भविष्यति न संदेहो यतो यूयं मम प्रियाः ।\nसुशिष्या बाढमित्येवं भविष्यन्ति न संशयः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003508020, "chapter_id": 23508, "verse_number": "१४८-२१", "content_sanskrit": "तदेते प्रवदिष्यन्ति सर्वभागवतप्रियम् ।\nयथा च मथ्यमानाद्वै दध्नश्चोद्ध्रियते घृतम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003508021, "chapter_id": 23508, "verse_number": "१४८-२२", "content_sanskrit": "एवं सर्वेषु  शास्त्रेषु वाराहं घृतसम्मितम् ।\nवाराहं ज्ञानमुत्सृज्य महाभागं महौजसम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003508022, "chapter_id": 23508, "verse_number": "१४८-२३", "content_sanskrit": "एवं समं मया चैव ह्यात्मना परिभाषितम् ।\nते प्रणामं करिष्यन्ति सिद्धिं प्राप्स्यन्ति वै पराम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003508023, "chapter_id": 23508, "verse_number": "१४८-२४", "content_sanskrit": "महाज्ञानमिदं सूक्ष्मं भूमे भक्तेषु दृश्यते ।\nशास्त्राणां परमं शास्त्रं सर्वसंसारमोक्षणम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003508024, "chapter_id": 23508, "verse_number": "१४८-२५", "content_sanskrit": "किञ्चिदन्यत्प्रवक्ष्यामि तच्छृणुष्व वसुन्धरे ।\nशास्त्रमेतन्महाभागे स्धूलकर्म महौजसम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003508025, "chapter_id": 23508, "verse_number": "१४८-२६", "content_sanskrit": "केचित्तरन्ति ज्ञानेन केचित्कर्मणि निष्ठिताः ।\nकेचिद्यथेष्टं सुश्रोणि केचिद्दानेन कर्मणा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003508026, "chapter_id": 23508, "verse_number": "१४८-२७", "content_sanskrit": "केचिद्योगबलं भुक्ता पश्यन्ति मम संस्थितम् ।\nविधिपूर्वं तु मे किञ्चिन्नराः पश्यन्ति निष्ठिताः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003508027, "chapter_id": 23508, "verse_number": "१४८-२८", "content_sanskrit": "सर्वधर्मकराः केचित्सर्वाशाः सर्वविक्रयाः ।\nते मां पश्यन्ति वै भूमे एकचित्त व्यवस्थिताः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003508028, "chapter_id": 23508, "verse_number": "१४८-२९", "content_sanskrit": "एवमेतन्महाशास्त्रं देवि संसारमोक्षणम् ।\nमम भक्तव्यवस्थायै प्रयुक्तं परमं प्रियम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003508029, "chapter_id": 23508, "verse_number": "१४८-३०", "content_sanskrit": "ते तथा च प्रवक्ष्यन्ति यच्च यस्याभिरोचते ।\nअन्यथान्यस्य दृष्टानामृषिभिर्यत्प्रयोजितम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003508030, "chapter_id": 23508, "verse_number": "१४८-३१", "content_sanskrit": "तद्युगस्य प्रभावेण भूमे कुर्वन्ति मानवाः ।\nतैः स्वशिष्यैः समं देवि ये शास्त्रविनियोजिताः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003508031, "chapter_id": 23508, "verse_number": "१४८-३२", "content_sanskrit": "मत्प्रसादेन ते सर्वे सिद्धिं यास्यन्ति मत्पराम् ।\nमम शिष्येषु येषां च मात्सर्योपहतात्मनाम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003508032, "chapter_id": 23508, "verse_number": "१४८-३३", "content_sanskrit": "मच्छास्त्रे च भवेद्दोषस्तेषामत्र पुनर्भवः ।\nमात्सर्यं ये च कुर्वन्ति मद्धर्मपरमे जने ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003508033, "chapter_id": 23508, "verse_number": "१४८-३४", "content_sanskrit": "तेषां नायं परो लोको मात्सर्योपहतात्मनाम् ।\nअन्यच्च ते प्रवक्ष्यामि तच्छृणुष्व वसुन्धरे ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003508034, "chapter_id": 23508, "verse_number": "१४८-३५", "content_sanskrit": "मम मार्गानुसारेण परं गुह्यं मम प्रिये ।\nशास्त्रवन्तो विनीताश्च बहुदोषविवर्विताः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003508035, "chapter_id": 23508, "verse_number": "१४८-३६", "content_sanskrit": "ते तु मात्सर्यर्दोषेण नष्टाचाराः पतन्त्यधः ।\nमात्सर्यं सर्वनाशाय मात्सर्यं धर्मनाशकम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003508036, "chapter_id": 23508, "verse_number": "१४८-३७", "content_sanskrit": "यस्तु मात्सर्यसंयुक्तो न स पश्यति मां क्वचित् ।\nबहुकर्मसमायुक्ता दानाध्ययननिष्ठिताः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003508037, "chapter_id": 23508, "verse_number": "१४८-३८", "content_sanskrit": "तपसा ज्ञानयुक्ता वा नित्यं कर्मसु चोद्यताः ।\nअनेन हि स्वभावेन मात्सर्यं चैव कुर्वते ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003508038, "chapter_id": 23508, "verse_number": "१४८-३९", "content_sanskrit": "न ते पश्यन्ति मां भूमे मायया परिदूषिताः ।\nन कर्त्तव्यं ततः सर्वैर्मात्सर्यं धर्मघातकम् ।\nमम शास्त्रपरेणेह यदीच्छेत्परमां गतिम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003508039, "chapter_id": 23508, "verse_number": "१४८-४०", "content_sanskrit": "एतद्गुह्यं महाभागे न जानन्ति मनीषिणः ।\nमात्सर्यस्य तु दोषेण बहवो निधनं गताः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003508040, "chapter_id": 23508, "verse_number": "१४८-४१", "content_sanskrit": "एतच्छास्त्रं महाभागे प्रयुक्तं विधिना मया ।\nवराहरूपमादाय सर्वभागवतप्रियम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003508041, "chapter_id": 23508, "verse_number": "१४८-४२", "content_sanskrit": "तत्राश्चर्यं महाभागे शृणु भूतगिरौ मम ।\nआयसी प्रतिमा तत्र ह्यभेद्या चैव दृश्यते ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003508042, "chapter_id": 23508, "verse_number": "१४८-४३", "content_sanskrit": "ब्रुवन्ति केचित्कांस्येति आयसीत्यपरेऽब्रुवन् ।\nपाषाणीत्यपरे केचिदन्ये वज्रमयीति च ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003508043, "chapter_id": 23508, "verse_number": "१४८-४४", "content_sanskrit": "ऊर्द्ध्वं वा यदि वाऽधो वा ये कुर्वन्ति ममार्चनम् ।\nतथापि मां संस्पृशन्ति शिरोमध्ये तु सुन्दरि ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003508044, "chapter_id": 23508, "verse_number": "१४८-४५", "content_sanskrit": "ये तु पश्यन्ति मां भूमे मणिपूरगिरौ स्थितम् ।\nस्तुवन्त्याचार्यवन्तश्च मत्प्रसादत्सु संयताः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003508045, "chapter_id": 23508, "verse_number": "१४८-४६", "content_sanskrit": "आचार्याणां गुणान्भुक्त्वा मम कर्मपथे स्थिताः ।\nसर्वकिल्बिषमुक्ताश्च यान्ति ते परमां गतिम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003508046, "chapter_id": 23508, "verse_number": "१४८-४७", "content_sanskrit": "तस्मिन्क्षेत्रे महाभागे अस्ति गुह्यं परं मम ।\nपंचारुमेति विख्यातमुत्तरां दिशमाश्रितम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003508047, "chapter_id": 23508, "verse_number": "१४८-४८", "content_sanskrit": "तत्र स्नानं प्रकुर्वीत पंचकालोषितो नरः ।\nमोदते नन्दने दिव्ये ह्यप्सरोभिः समाकुले ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003508048, "chapter_id": 23508, "verse_number": "१४८-४९", "content_sanskrit": "अथात्र मुंचते प्राणान्कृतकृत्यो भवेन्नरः ।\nनन्दनं वनमुत्सृत्य मम लोकं च गच्छति ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003508049, "chapter_id": 23508, "verse_number": "१४८-५०", "content_sanskrit": "भृगुकुण्डेति विख्यातमत्र गुह्यं परं मम ।\nमम दक्षिणपार्श्वे तु अदूरादर्धयोजनात् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003508050, "chapter_id": 23508, "verse_number": "१४८-५१", "content_sanskrit": "तत्र स्नानं तु कुर्वीत मम मार्गानुसारकः ।\nभूपृष्ठे न तु जायेत कालेन विजितेन्द्रियः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003508051, "chapter_id": 23508, "verse_number": "१४८-५२", "content_sanskrit": "ध्रुवो यत्र तु तिष्ठेत मेरुशृंगे शिलोच्चये ।\nतत्र मोदति सुश्रोणि अप्सरोभिर्यथासुखम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003508052, "chapter_id": 23508, "verse_number": "१४८-५३", "content_sanskrit": "अथात्र मुंचते प्राणान् मम कर्मपथे स्थितः ।\nध्रुवलोकं परित्यज्य मम लोके महीयते ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003508053, "chapter_id": 23508, "verse_number": "१४८-५४", "content_sanskrit": "मणिकुण्डेति विख्यातं तत्र गुह्यं परं मम ।\nमणयो यत्र दृश्यन्ते अनेकालयसंस्थिताः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003508054, "chapter_id": 23508, "verse_number": "१४८-५५", "content_sanskrit": "अगाधं तं हृदं भद्रे देवानामपि दुर्लभम् ।\nविस्मयं किं पुनस्तत्र मलयश्चंचलः स्थितः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003508055, "chapter_id": 23508, "verse_number": "१४८-५६", "content_sanskrit": "तत्र स्नानं प्रकुर्वीत पंचकालोषितो नरः ।\nरत्नभागी भवेद्वीरो राजलक्षणसंयुतः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003508056, "chapter_id": 23508, "verse_number": "१४८-५७", "content_sanskrit": "अथात्र मुंचते प्राणान्मम कर्मपथे स्थितः ।\nछित्त्वा वै सर्वसंसारं मम लोकं प्रपद्यते ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003508057, "chapter_id": 23508, "verse_number": "१४८-५८", "content_sanskrit": "सुगुह्यं पूर्वपार्श्वेन मम क्षेत्रस्य सुन्दरि ।\nअदूरतस्त्रिकोशेन परिमाणं विधीयते ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003508058, "chapter_id": 23508, "verse_number": "१४८-५९", "content_sanskrit": "तत्र स्नानं तु कुर्वीत मम लोकं स गच्छति ।\nधूतपापेति विख्यातं तत्र गुह्यं परं मम ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003508059, "chapter_id": 23508, "verse_number": "१४८-६०", "content_sanskrit": "पंचक्रोशाददूराद्वै मम क्षेत्रस्य पश्चिमे ।\nतत्र कुण्डं महाभागे मम तद्रोचते जलम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003508060, "chapter_id": 23508, "verse_number": "१४८-६१", "content_sanskrit": "सुवर्णाभं मारकतमगाधं निर्मितं मया ।\nतत्र स्नानं प्रकुर्वीत पंचभक्तोषितो नरः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003508061, "chapter_id": 23508, "verse_number": "१४८-६२", "content_sanskrit": "धुन्वानो दुष्करं कर्म पंचभूतात्मनिष्ठितम् ।\nकृतोदकस्तत्र भद्रे धूतपापो यशस्विनि ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003508062, "chapter_id": 23508, "verse_number": "१४८-६३", "content_sanskrit": "गत्वेन्द्रलोकं सुश्रोणि देवैः सह स मोदते ।\nअथात्र मुंचते प्राणान्मम कर्मपरायणः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003508063, "chapter_id": 23508, "verse_number": "१४८-६४", "content_sanskrit": "इन्द्रलोकं परित्यज्य मम लोकं प्रपद्यते ।\nतत्राश्चर्यं महाभागे धूतपापे शृणुष्व मे ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003508064, "chapter_id": 23508, "verse_number": "१४८-६५", "content_sanskrit": "वर्त्तते च विशालाक्षि मणिपूरे गिरौ मम ।\nतावन्न पतते धारा यावत्पापं न धूयते ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003508065, "chapter_id": 23508, "verse_number": "१४८-६६", "content_sanskrit": "धूते पापे च सुश्रोणि धारा च पतति क्षितौ ।\nएवं तत्र विशालाक्षि वृक्षमश्वत्थमिश्रितम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003508066, "chapter_id": 23508, "verse_number": "१४८-६७", "content_sanskrit": "धूतपापं न प्रविशेत्प्रविशत्यमले नरे ।\nतस्मिन्क्षेत्रे वरारोहे समन्तात्पंचयोजने ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003508067, "chapter_id": 23508, "verse_number": "१४८-६८", "content_sanskrit": "यत्र तिष्ठाम्यहं देवि पश्चिमां दिशमाश्रितः ।\nतत्र चामलकं भद्रे अदूरादर्द्धयोजनात् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003508068, "chapter_id": 23508, "verse_number": "१४८-६९", "content_sanskrit": "मम चैव प्रभावेण सर्वकालफलोदयम् ।\nतत्र कश्चिन्न जानाति पापकर्मा नराधमः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003508069, "chapter_id": 23508, "verse_number": "१४८-७०", "content_sanskrit": "भक्तं भागवतं शुद्धं मम कर्मव्यवस्थितम् ।\nउपोष्य च त्रिरात्राणि श्रद्दधानो जितेन्द्रियः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003508070, "chapter_id": 23508, "verse_number": "१४८-७१", "content_sanskrit": "तत्र गत्वा वरारोहे उदिते च दिवाकरे ।\nअथ मध्याह्नवेलायां यदि वाऽस्तंगतेऽपि वा ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003508071, "chapter_id": 23508, "verse_number": "१४८-७२", "content_sanskrit": "एकचित्तेन गन्तव्यं धृतिं कृत्वा सुपुष्कलाम् ।\nयत्तत्र लभते भद्रे फलमामलकं शुभम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003508072, "chapter_id": 23508, "verse_number": "१४८-७३", "content_sanskrit": "पंचरात्रेण लभते तस्मिन्भूतगिरौ मम ।\nततो हरिवचः श्रुत्वा सा मही संशितव्रता ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003508073, "chapter_id": 23508, "verse_number": "१४८-७४", "content_sanskrit": "पुनर्नारायणं तत्र प्रोवाच विनयान्विता ।\nस्तुतस्वामी श्रुतोऽसि त्वं तत्त्र स्थानानि यानि च ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003508074, "chapter_id": 23508, "verse_number": "१४८-७५", "content_sanskrit": "एतन्नामनिरुक्तिं त्वं वक्तुमर्हसि साम्प्रतम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003508075, "chapter_id": 23508, "verse_number": "१४८-७६", "content_sanskrit": "श्रीवराह उवाच ।\nभूमे हित्वा तु संसारान्ये चान्ये देवकण्टकाः ।\nद्वापरे युगमासाद्य यत्र स्थास्यामि सुन्दरि ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003508076, "chapter_id": 23508, "verse_number": "१४८-७७", "content_sanskrit": "ततोऽमरैश्च ब्रह्माद्यैर्बहुभिर्मन्त्रवादिभिः ।\nस्तुतिं कर्त्तुं समारब्धं मणिपूराश्रितस्य मे ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003508077, "chapter_id": 23508, "verse_number": "१४८-७८", "content_sanskrit": "ततो मां नारदो देवि असितो देवलस्तथा ।\nपर्वतश्च महाभागे मम भक्त्या व्यवस्थितः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003508078, "chapter_id": 23508, "verse_number": "१४८-७९", "content_sanskrit": "नाम कुर्वन्ति मे तत्र मणिपूरगिरौ ततः ।\nस्तुतस्वामीति विख्यातं मम कर्मव्यपाश्रितम् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003508079, "chapter_id": 23508, "verse_number": "१४८-८०", "content_sanskrit": "एतत्ते कथितं भद्रे निरुक्तिकरणं मया ।\nत्वया पृष्टं हि यद्भद्रे सर्वभागवतप्रियम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003508080, "chapter_id": 23508, "verse_number": "१४८-८१", "content_sanskrit": "एतत्स्तुतगिरेर्देवि माहात्म्यं कथितं मया ।\nद्वापरं युगमासाद्य यत्र स्थास्यामि सुन्दरि ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003508081, "chapter_id": 23508, "verse_number": "१४८-८२", "content_sanskrit": "एतानि भूमे गुह्यानि तत्र भूतगिरौ मम ।\nश्रद्धधानेन मर्त्त्येन श्रोतव्यं नात्र संशयः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003508082, "chapter_id": 23508, "verse_number": "१४८-८३", "content_sanskrit": "एतत्ते कथितं भद्रे सर्वधर्मव्यपाश्रयम् ।\nश्रीस्तुतस्वामिमाहात्म्यं किमन्यत्परिपृच्छसि ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}]