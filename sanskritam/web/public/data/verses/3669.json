[{"id": 2124537, "chapter_id": 3669, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2124538, "chapter_id": 3669, "verse_number": "१", "content_sanskrit": "भोजाः प्रव्रजितान् श्रुत्वा वृष्णयश्चान्धकैः सह ।\nपाण्डवान् दुःखसन्तप्तान् समाजग्मुर्महावने\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2124539, "chapter_id": 3669, "verse_number": "२", "content_sanskrit": "पाञ्चालस्य तु दायादो धृष्टकेतुश्च चेदिपः ।\nकेकयाश्च महेष्वासा भ्रातरो लोकविश्रुताः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2124540, "chapter_id": 3669, "verse_number": "३", "content_sanskrit": "वने तेऽभिययुः पार्थान् क्रोधामर्षसमन्वितान् ।\nगर्हयन्तो धार्तराष्ट्रान् किं कुर्म इति चाब्रुवन्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2124541, "chapter_id": 3669, "verse_number": "४", "content_sanskrit": "वासुदेवं पुरस्कृत्य सर्वे ते क्षत्रियर्षभाः ।\nपरिवार्योपविविशुर्धर्मराजं युधिष्ठिरम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2124542, "chapter_id": 3669, "verse_number": "", "content_sanskrit": "श्रीवासुदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2124543, "chapter_id": 3669, "verse_number": "५", "content_sanskrit": "दुर्योधनस्य कर्णस्य शकुनेश्च दुरात्मनः ।\nदुश्शासनचतुर्थानां भूमिः पास्यति शोणितम् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2124544, "chapter_id": 3669, "verse_number": "६", "content_sanskrit": "ततः सर्वेऽभिषिञ्चामो धर्मराजं युधिष्ठिरम् ।\nनिकृत्या च चरन् वध्य एष धर्मः सनातनः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2124545, "chapter_id": 3669, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2124546, "chapter_id": 3669, "verse_number": "७", "content_sanskrit": "पार्थानामभिषङ्गेण तथा क्रुद्धं जनार्दनम् ।\nअर्जुनः शमयामास दिधक्षन्तमिव प्रजाः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2124547, "chapter_id": 3669, "verse_number": "८", "content_sanskrit": "सङ्क्रुद्धं केशवं दृष्ट्वा पूर्वदेवेषु भारत ।\nकीर्तयामास कर्मार्णि सत्यकीर्तेर्महात्मनः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2124548, "chapter_id": 3669, "verse_number": "९", "content_sanskrit": "पुरुषस्याप्रमेयस्य सत्यस्यामिततेजसः ।\nप्रजापतिपतेर्विष्णोर्लोकनाथस्य धीमतः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2124549, "chapter_id": 3669, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2124550, "chapter_id": 3669, "verse_number": "१०", "content_sanskrit": "दशवर्षसहस्राणि यत्र सायंगृहो मुनिः ।\nव्यचरस्त्वं पुरा कृष्ण पर्वते गन्धमादने\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2124551, "chapter_id": 3669, "verse_number": "११", "content_sanskrit": "दशवर्षसहस्राणि दशवर्षशतानि च ।\nपुष्करेष्ववसः कृष्ण त्वमपो भक्षयन् पुरा\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2124552, "chapter_id": 3669, "verse_number": "१२", "content_sanskrit": "ऊर्ध्वबाहुर्विशालायां बदर्यां मधुसूदन ।\nअतिष्ठस्त्वेकपादेन वायुभक्षः शतं समाः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2124553, "chapter_id": 3669, "verse_number": "१३", "content_sanskrit": "कृष्णाजिनोत्तरासङ्गः कृशो धमनिसन्ततः ।\nआसीः कृष्ण सरस्वत्यां सत्रे द्वादशवार्षिके\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2124554, "chapter_id": 3669, "verse_number": "१४", "content_sanskrit": "प्रभासमप्यथासाद्य तीर्थं पुण्यजनार्चितम् ।\nतत्र कृष्ण महाबाहो दिव्यं वर्षसहस्रकम् ।\nअतिष्ठस्तप एकेन पादेन नियमे स्थितः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2124555, "chapter_id": 3669, "verse_number": "१५", "content_sanskrit": "क्षेत्रज्ञः सर्वभूतानामादिरन्तश्च केशव ।\nतपसां च निधिः कृष्ण यज्ञस्त्वं च सनातनः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2124556, "chapter_id": 3669, "verse_number": "१६", "content_sanskrit": "निहत्य नरकं भौममाहृत्य मणिकुण्डले ।\nप्रादास्त्वमदितेः कृष्ण भवान् नः परमा गतिः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2124557, "chapter_id": 3669, "verse_number": "१७", "content_sanskrit": "प्रथमोत्पादितं कृष्ण मेध्यमश्वमवासृजः ।\nकृत्वा तत् कर्म लोकानामृषभः सर्वलोकजित् ।\nअवधीस्त्वं रणे सर्वान् समेतान् दैत्यदानवान्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2124558, "chapter_id": 3669, "verse_number": "१८", "content_sanskrit": "ततः सर्वेश्वरत्वं च सम्प्रदाय शचीपतेः ।\nमानुषेषु महाबाहो प्रादुर्भूतोऽसि केशव\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2124559, "chapter_id": 3669, "verse_number": "१९", "content_sanskrit": "स त्वं नारायणो भूत्वा हरिरासीः सनातनः ।\nब्रह्मा सोमश्च सूर्यश्च धर्मो धाता यमोऽनलः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2124560, "chapter_id": 3669, "verse_number": "२०", "content_sanskrit": "वायुर्वैश्रवणो रुद्रः कालः खं पृथिवी दिशः ।\nअजश्चराचरगुरुः स्रष्टा त्वं पुरुषोत्तमः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2124561, "chapter_id": 3669, "verse_number": "२१", "content_sanskrit": "नारायणो ह्यभूः पूर्वं क्रतुभिर्भूरिदक्षिणैः ।\nअयजो भूरितेजास्त्वं कृष्ण चैत्ररथे वने\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2124562, "chapter_id": 3669, "verse_number": "२२", "content_sanskrit": "शतं शतसहस्राणि सुवर्णस्य जनार्दन ।\nएकैकस्मिंस्तथा यज्ञे परिपूर्णानि दत्तवान्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2124563, "chapter_id": 3669, "verse_number": "२३", "content_sanskrit": "अदितेरपि पुत्रत्वमाप्य यादवनन्दन ।\nत्वं विष्णुरिति विख्यात इन्द्रादवरजोऽभवः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2124564, "chapter_id": 3669, "verse_number": "२४", "content_sanskrit": "शिशुर्भूत्वा दिवं खं च पृथिवीं च परन्तप ।\nत्रिभिर्विक्रमणैः कृष्ण पूर्वं त्वं क्रान्तवानसि\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2124565, "chapter_id": 3669, "verse_number": "२५", "content_sanskrit": "सम्प्राप्य दिवमाकाशमादित्यसदने स्थितः ।\nअत्यरोचश्च भूतात्मन् भास्करं स्वेन तेजसा\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2124566, "chapter_id": 3669, "verse_number": "२६", "content_sanskrit": "मौरवाः सादिताः पाशा निशुम्भनरकौ हतौ ।\nकृतः क्षेमः पुनः पन्थाः प्राग्ज्योतिषपुरं प्रति\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2124567, "chapter_id": 3669, "verse_number": "२७", "content_sanskrit": "जारुथ्यामावृतिः कोपात् शिशुपालोनृपैः सह ।\nभीमधन्वा च शैब्यश्च शतधन्वा च निर्जितः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2124568, "chapter_id": 3669, "verse_number": "२८", "content_sanskrit": "तथा पर्जन्यघोषेण रथेनादित्यवर्चसा ।\nअहार्षी रुग्मिणीं भैष्मीं निर्जित्य रुग्मिणम् मृधे ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2124569, "chapter_id": 3669, "verse_number": "२९", "content_sanskrit": "इन्द्रद्युम्नो हतः कोपाद् यवनश्च कशेरुकः ।\nहतः सौभपतिः साल्वः त्वया सौभं च पातितम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2124570, "chapter_id": 3669, "verse_number": "३०", "content_sanskrit": "इरावत्यां तथा भोजः कार्तवीर्यसमो युधि ।\nगोपतिस्ताळकेतुश्च त्वया विनिहतावुभौ\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2124571, "chapter_id": 3669, "verse_number": "३१", "content_sanskrit": "तां च भोगवतीं पुण्यामृषिकान्तां जनार्दन ।\nद्वारकामात्मसात् कृत्वा समुद्रं गमयिष्यसि\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2124572, "chapter_id": 3669, "verse_number": "३२", "content_sanskrit": "न क्रोधो न च मात्सर्यं नानृतं मधुसूदन ।\nत्वयि तिष्ठति दाशार्ह न नृशंसः कुतोऽनृजुः \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2124573, "chapter_id": 3669, "verse_number": "३३", "content_sanskrit": "आसीनं चित्तमध्ये त्वां दीप्यमानं स्वतेजसा ।\nआगम्य मुनयः सर्वे याचन्त्यभयमच्युत \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2124574, "chapter_id": 3669, "verse_number": "३४", "content_sanskrit": "युगान्ते सर्वभूतानि संक्षिप्य मधुसूदन ।\nआत्मन्येवात्मना कृत्वा जगदास्से परन्तप\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2124575, "chapter_id": 3669, "verse_number": "३५", "content_sanskrit": "नैव पूर्वे परे चैव करिष्यन्ति कृतानि ते ।\nकर्माणि यानि देव त्वं बाल एव महाद्युते\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2124576, "chapter_id": 3669, "verse_number": "३६", "content_sanskrit": "कृतवान् पुण्डरीकाक्ष बलदेवसहायवान् ।\nवैराजभवने चापि ब्रह्मणा न्यवसः सह \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2124577, "chapter_id": 3669, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2124578, "chapter_id": 3669, "verse_number": "३७", "content_sanskrit": "एवमुक्त्वा स्वमात्मानमात्मा कृष्णस्य पाण्डवः ।\nतूष्णीमासीत् ततः पार्थमित्युवाच जनार्दनः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2124579, "chapter_id": 3669, "verse_number": "३८", "content_sanskrit": "ममैव त्वं तवैवाहं ये मदीयास्तवैव ते ।\nयस्त्वां द्वेष्टि स मां द्वेष्टि यस्त्वामनु स मामनु\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2124580, "chapter_id": 3669, "verse_number": "३९", "content_sanskrit": "नरस्त्वमसि दुर्धर्ष हरिर्नारायणोऽस्म्यहम् ।\nलोकाल्लोकमिमं प्राप्तौ नरनारायणावृषी\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2124581, "chapter_id": 3669, "verse_number": "४०", "content_sanskrit": "अनन्यः पार्थ मत्तस्त्वम् अहं त्वत्तश्च भारत ।\nनावयोरन्तरं शक्यं वेदितुं भरतर्षभ\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2124582, "chapter_id": 3669, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2124583, "chapter_id": 3669, "verse_number": "४१", "content_sanskrit": "तस्मिन् वीरसमावाये सङ्क्रुद्धेष्वथ राजसु ।\nधृष्टद्युम्नमुखैर्वीरैर्भ्रातृभिः परिवारिता\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2124584, "chapter_id": 3669, "verse_number": "४२", "content_sanskrit": "पाञ्चाली पुण्डरीकाक्षमासीनं यादवैःसह ।\nअभिगम्याब्रवीत् कृष्णा शरण्यं शरणैषिणी\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2124585, "chapter_id": 3669, "verse_number": "४३", "content_sanskrit": "पूर्वे प्रजानिसर्गे त्वामाहुरेकं प्रजापतिम् ।\nस्रष्टारं सर्वलोकानामसितो देवलोऽब्रवीत्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2124586, "chapter_id": 3669, "verse_number": "४४", "content_sanskrit": "विष्णुस्त्वमसि दुर्धर्षस्त्वं यज्ञो मधुसूदन ।\nयष्टा त्वमसि यष्टव्यो जामदग्न्यो यथाऽब्रबीत्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2124587, "chapter_id": 3669, "verse_number": "४५", "content_sanskrit": "ऋषयस्त्वां क्षमामाहुः सत्यं च पुरुषेश्वर ।\nसत्याद् यज्ञोऽसि सम्भूतः कश्यपस्त्वां यथाऽब्रवीत्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2124588, "chapter_id": 3669, "verse_number": "४६", "content_sanskrit": "साध्यानामपि देवानां वसूनामीश्वरेश्वरः ।\nलोकभावन लोकेश यथा त्वां नारदोऽब्रवीत्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2124589, "chapter_id": 3669, "verse_number": "४७", "content_sanskrit": "द्यौश्च ते शिरसा व्याप्ता पद्भ्यां च पृथिवी विभो ।\nजठरे त इमे लोकाः पुरुषोऽसि सनातनः \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2124590, "chapter_id": 3669, "verse_number": "४८", "content_sanskrit": "विद्यातपोभितृप्तानां तपसा भावितात्मनाम् ।\nआत्मदर्शनसिद्धानामृषीणामसि सत्तमः \t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2124591, "chapter_id": 3669, "verse_number": "४९", "content_sanskrit": "राजर्षीणां पुण्यकृतामाहवेष्वनिवर्तिनाम् ।\nसर्वधर्मोपपन्नानां त्वं गतिः पुरुषोत्तम \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2124592, "chapter_id": 3669, "verse_number": "५०", "content_sanskrit": "त्वं प्रभुस्त्वं विभुश्च त्वमात्मभूस्त्वं सनातनः ।\nलोकपालाश्च लोकाश्च नक्षत्राणि दिशो दश ।\nनभश्चन्द्रश्च सूर्यश्च त्वयि सर्वं प्रतिष्ठितम् \t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2124593, "chapter_id": 3669, "verse_number": "५१", "content_sanskrit": "मर्त्यता चैव भूतानाममरत्वं दिवौकसाम् ।\nत्वयि सर्वं महाबाहो लोककार्यं प्रतिष्ठितम् \t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2124594, "chapter_id": 3669, "verse_number": "५२", "content_sanskrit": "सा तेऽहं दुःखमाख्यास्ये प्रणयान्मधुसूदन ।\nईशस्त्वं सर्वलोकानां ये दिव्या ये च मानुषाः\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2124595, "chapter_id": 3669, "verse_number": "५३", "content_sanskrit": "कथं नु भार्या पार्थानां तव कृष्ण सखी विभो ।\nधृष्टद्युम्नस्य भगिनी परिकृष्येत मादृशी\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2124596, "chapter_id": 3669, "verse_number": "५४", "content_sanskrit": "स्त्रीधर्मिणी वेपमाना रुधिरेण समुक्षिता ।\nएकवस्त्रा विकृष्टाऽस्मि दुःखिता कुरुसंसदि\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2124597, "chapter_id": 3669, "verse_number": "५५", "content_sanskrit": "राजमध्ये सभायां तु रजसाऽभिसमीरिताः ।\nदासीभावेन भोक्तुं मामीषुस्ते मधुसूदन\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2124598, "chapter_id": 3669, "verse_number": "५६", "content_sanskrit": "दृष्ट्वा च मां धार्तराष्ट्राः प्राहसन् पापचेतसः ।\nजीवत्सु पाण्डुपुत्रेषु पाञ्चालेष्वथ वृष्णिषु\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2124599, "chapter_id": 3669, "verse_number": "५७", "content_sanskrit": "नन्वहं कृष्ण भीष्मस्य धृतराष्ट्रस्य चोभयोः ।\nस्नुषा भवामि धर्मेण साऽहं दासीकृता बलात्\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2124600, "chapter_id": 3669, "verse_number": "५८", "content_sanskrit": "गर्हये पाण्डवांस्त्वेव युधि श्रेष्ठान् महाबलान् ।\nये क्लिश्यमानां पश्यन्ति धर्मपत्नीं यशस्विनीम् \t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2124601, "chapter_id": 3669, "verse_number": "५९", "content_sanskrit": "धिग्बलं भीमसेनस्य धिक् पार्थस्य धनुष्मतः ।\nयौ मां विप्रकृतां च्छिद्रैर्मर्षयेतां जनार्दन\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2124602, "chapter_id": 3669, "verse_number": "६०", "content_sanskrit": "शाश्वतोऽयं धर्मपथः सद्भिराचरितः सदा ।\nयद् भार्यां परिरक्षन्ते भर्तारोऽल्पबला अपि \t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2124603, "chapter_id": 3669, "verse_number": "६१", "content_sanskrit": "भार्यायां रक्ष्यमाणायां प्रजा भवति रक्षिता ।\nप्रजायां रक्ष्यमाणायामात्मा भवति रक्षितः \t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2124604, "chapter_id": 3669, "verse_number": "६२", "content_sanskrit": "आत्मा हि जायते तस्यां तस्माज्जाया भवत्युत ।\nभर्ता च भार्यया रक्ष्यः कथं जायेन्ममोदरे\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2124605, "chapter_id": 3669, "verse_number": "६३", "content_sanskrit": "नन्विमे शरणं प्राप्तं न त्यजन्ति कदाचन ।\nते मां शरणमापन्नामन्वपद्यन् कथं परान् \t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2124606, "chapter_id": 3669, "verse_number": "६४", "content_sanskrit": "पञ्चेमे पञ्चभिर्जाताः कुमारा भूरितेजसः ।\nएतेषामप्यवेक्षार्थं त्रातव्याऽस्मि जनार्दन \t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2124607, "chapter_id": 3669, "verse_number": "६५", "content_sanskrit": "प्रतिविन्ध्यो युधिष्ठिरात् सुतसोमो वृकोदरात् ।\nअर्जुनाच्छ्रुतकीर्तिस्तु शतानीकस्तु नाकुलिः \t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2124608, "chapter_id": 3669, "verse_number": "६६", "content_sanskrit": "कनिष्ठाच्छ्रुतसेनश्च सर्वे सत्यपराक्रमाः ।\nप्रद्युम्नो यादृशः कृष्ण तादृशास्ते महारथाः\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2124609, "chapter_id": 3669, "verse_number": "६७", "content_sanskrit": "नन्विमे धनुषि श्रेष्ठा अजेया युधि शात्रवैः ।\nकिमर्थं धार्तराष्ट्राणां सहन्ते दुर्बलीयसाम् \t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2124610, "chapter_id": 3669, "verse_number": "६८", "content_sanskrit": "अधर्मेण हृतं राज्यं सर्वे दासास्तथा कृताः ।\nसभायां परिकृष्टाऽहमेकवस्त्रा रजस्वला\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2124611, "chapter_id": 3669, "verse_number": "६९", "content_sanskrit": "नाधिज्यमपि तच्छक्यं कर्तुमन्येन गाण्डिवम् ।\nअन्यत्रार्जुनभीमाभ्यां त्वया वा मधुसूदन\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2124612, "chapter_id": 3669, "verse_number": "७०", "content_sanskrit": "धिग् बलं भीमसेनस्य धिक् पार्थस्य च गाण्डिवम् ।\nयत्र दुर्योधनः पापो मुहूर्तमपि जीवति\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2124613, "chapter_id": 3669, "verse_number": "७१", "content_sanskrit": "य एतानाक्षिपद् राष्ट्रात् सह मात्रा विहिंसकान् ।\nअधीयानान् पुरा बालान् व्रतस्थान् मधुसूदन \t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2124614, "chapter_id": 3669, "verse_number": "७२", "content_sanskrit": "भोजने भीमसेनस्य पापः प्राक्षेपयद् विषम् ।\nकालकूटनिभं तीक्ष्णं सम्भृतं रोमहर्षणम् \t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2124615, "chapter_id": 3669, "verse_number": "७३", "content_sanskrit": "तज्जीर्णमविकारेण सहान्नेन जनार्दन ।\nसशेषत्वान्महाबाहो भीमस्य पुरुषोत्तम\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2124616, "chapter_id": 3669, "verse_number": "७४", "content_sanskrit": "प्रमाणकोट्यां विश्वस्तं पाशैर्बध्वा वृकोदरम् ।\nतोये सुभीमे गङ्गायाः प्राक्षिप्य गृहमाव्रजन्\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2124617, "chapter_id": 3669, "verse_number": "७५", "content_sanskrit": "यदा विबुद्धः कौन्तेयस्तदा संछिद्य बन्धनम् ।\nउदतिष्ठन्महाबाहुर्भीमसेनो महाबलः\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2124618, "chapter_id": 3669, "verse_number": "७६", "content_sanskrit": "आशीविषैः कृष्णसर्पैः सुप्तं चैनमदंशयत् ।\nसर्वेष्वेवाङ्गदेशेषु न ममार ह शत्रुहा\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2124619, "chapter_id": 3669, "verse_number": "७७", "content_sanskrit": "प्रतिबुद्धस्तु कौन्तेयः सर्पान् सर्वानपोथयत् ।\nसारथिं चास्य दयितमपहस्तेन जघ्निवान् \t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2124620, "chapter_id": 3669, "verse_number": "७८", "content_sanskrit": "ततः पुनरुपाधाक्षीद् बालकान् वारणावते ।\nशयानानार्यया सार्धं को नु तत् कर्तुमर्हति\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2124621, "chapter_id": 3669, "verse_number": "७९", "content_sanskrit": "तत्रार्या रुदती भीता पाण्डवानिदमब्रवीत् ।\nमहद्व्यसनमापन्ना शिखिना परिवारिता \t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2124622, "chapter_id": 3669, "verse_number": "८०", "content_sanskrit": "हा हताऽस्मि कुतोन्वद्य भवेच्छान्तिरिहानलात् ।\nअनाथा विनशिष्यामि बालकैः पुत्रकैः सह\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2124623, "chapter_id": 3669, "verse_number": "८१", "content_sanskrit": "तत्र भीमो महाबाहुर्वायुवेगपराक्रमः ।\nआर्यामाश्वासयामास भ्रातॄंश्चापि वृकोदरः\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2124624, "chapter_id": 3669, "verse_number": "८२", "content_sanskrit": "वैनतेयो यथा पक्षी गरुडः पततां वरः ।\nतथैवाभिपतिष्यामि भयं वो नेह विद्यते \t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2124625, "chapter_id": 3669, "verse_number": "८३", "content_sanskrit": "आर्यामङ्केन वामेन दक्षिणेन युधिष्ठिरम् ।\nअंसयोश्च यमौ कृत्वा पृष्ठे बीभत्सुमेव च \t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2124626, "chapter_id": 3669, "verse_number": "८४", "content_sanskrit": "सहसोत्पत्य वेगेन सर्वानादाय वीर्यवान् ।\nभ्रातॄनार्यां च बलवान् मोक्षयामास पावकात् \t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2124627, "chapter_id": 3669, "verse_number": "८५", "content_sanskrit": "ते रात्रौ प्रस्थिताः सर्वे मात्रा सह यशस्विनः ।\nअभ्यगच्छन् महारण्यं हिडिम्बवनमन्तिकात्\t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2124628, "chapter_id": 3669, "verse_number": "८६", "content_sanskrit": "श्रान्ताः प्रसुप्तास्तत्रेमे मात्रा सह सुखेदिताः ।\nसुप्तांश्चैनानभ्यगच्छद्धिडिम्बा नाम राक्षसी\t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2124629, "chapter_id": 3669, "verse_number": "८७", "content_sanskrit": "सा दृष्ट्वा पाण्डवं भीमं शयानं भ्रातृभिः सह ।\nहृच्छयेणाभिभूताङ्गी भीमसेनमकामयत्\t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2124630, "chapter_id": 3669, "verse_number": "८८", "content_sanskrit": "भीमस्य पादौ कृत्वा तु स्वपतोऽङ्के ततो बलात् ।\nपर्यष्वजत संहृष्टा कल्याणी मृदुपाणिना\t॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2124631, "chapter_id": 3669, "verse_number": "८९", "content_sanskrit": "तामबुद्ध्यदमेयात्मा बलवान् सत्यविक्रमः ।\nपर्यपृच्छच्च तां भीमः कस्य त्वमसि शोभने \t॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2124632, "chapter_id": 3669, "verse_number": "९०", "content_sanskrit": "सैवमुक्ता तु भीमेन राक्षसी कामरूपिणी ।\nभीमसेनं महात्मानमिदमाह शुचिस्मिता\t॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2124633, "chapter_id": 3669, "verse_number": "९१", "content_sanskrit": "पलायध्वमितः क्षिप्रं मम भ्राता सुवीर्यवान् ।\nआगमिष्यति संहर्तुं तस्माद् गच्छत माचिरम् \t॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2124634, "chapter_id": 3669, "verse_number": "९२", "content_sanskrit": "अथ तां प्रत्युवाचैष साम्ना परमवल्गुना ।\nनोद्विजामि तव भ्रातुर्नैतांश्च प्रतिबोधये ।\nआगतं प्रतिपत्स्यामि भ्रातरं राक्षसं तव\t॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2124635, "chapter_id": 3669, "verse_number": "९३", "content_sanskrit": "तयोः श्रुत्वा तु कथितमागच्छद् राक्षसाधमः ।\nभीमरूपो महानादान् विनदन् भीमदर्शनः \t॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2124636, "chapter_id": 3669, "verse_number": "९४", "content_sanskrit": "केन सार्धं कथयसि आनयैनं ममान्तिकम् ।\nहिडिम्बे भक्षयिष्यावो न चिरं कर्तुमर्हसि\t॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2124637, "chapter_id": 3669, "verse_number": "", "content_sanskrit": "द्रौपदी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2124638, "chapter_id": 3669, "verse_number": "९५", "content_sanskrit": "सा कृपासङ्गृहीतेन हृदयेन मनस्विनी ।\nनैनमैच्छत् तदाऽऽख्यातुम् अनुक्रोशादनिन्दिता\t॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2124639, "chapter_id": 3669, "verse_number": "९६", "content_sanskrit": "स नादान् विनदन् घोरान् राक्षसः पुरुषादकः ।\nअभ्यद्रवत वेगेन भीमसेनं तदा किल\t॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2124640, "chapter_id": 3669, "verse_number": "९७", "content_sanskrit": "तमभिद्रुत्य वेगेन सङ्क्रुद्धो महता बली ।\nअगृह्णात् पाणिना पाणिं भीमसेनस्य राक्षसः \t॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2124641, "chapter_id": 3669, "verse_number": "९८", "content_sanskrit": "इन्द्राशनिसमस्पर्शं वज्रसंहननं दृढम् ।\nसंहत्य भीमसेनस्य व्याक्षिपत् सहसा करम्\t॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2124642, "chapter_id": 3669, "verse_number": "९९", "content_sanskrit": "गृहीतः पाणिना पाणिं भीमसेनोऽथ रक्षसा ।\nनामृष्यत महाबाहुस्तत्राक्रुद्ध्यद् वृकोदरः \t॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2124643, "chapter_id": 3669, "verse_number": "१००", "content_sanskrit": "अथासीत् तुमुलं युद्धं भीमसेनहिडिम्बयोः ।\nसर्वास्त्रविदुषोर्घोरं वृत्रवासवयोरिव\t॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2124644, "chapter_id": 3669, "verse_number": "१०१", "content_sanskrit": "हत्वा हिडिम्बं भीमोऽथ प्रस्थितो भ्रातृभिः सह ।\nहिडिम्बामग्रतः कृत्वा यस्यां जातो घटोत्कचः\t॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2124645, "chapter_id": 3669, "verse_number": "१०२", "content_sanskrit": "ततस्ते भ्रातरः सर्वे सह मात्रा यशस्विनः ।\nएकचक्रामभिगताः संवृता ब्राह्मणव्रजैः \t॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2124646, "chapter_id": 3669, "verse_number": "१०३", "content_sanskrit": "प्रस्थाने व्यास एषां च मन्त्री प्रियहितोऽभवत् ।\nततोऽगच्छन्नेकचक्रां पाण्डवाः संशितव्रताः\t॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2124647, "chapter_id": 3669, "verse_number": "१०४", "content_sanskrit": "तत्राप्यासादयामासुर्बकं नाम महाबलम् ।\nपुरुषादं प्रतिभयं हिडिम्बेनैव सम्मितम्\t॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2124648, "chapter_id": 3669, "verse_number": "१०५", "content_sanskrit": "तं चापि विनिहत्योग्रं भीमः प्रहरतां वरः ।\nसहितो भ्रातृभिः सर्वैर्द्रुपदस्य पुरं ययौ\t॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2124649, "chapter_id": 3669, "verse_number": "१०६", "content_sanskrit": "लब्धाऽहमपि तत्रैव वसता सव्यसाचिना ।\nयथा त्वया जिता कृष्ण रुग्मिणी भीष्मकात्मजा\t॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2124650, "chapter_id": 3669, "verse_number": "१०७", "content_sanskrit": "एवं सुयुद्धे पार्थेन जिताऽहं मधुसूदन ।\nस्वयंवरे महत् कर्म कृत्वा ह्यसुकरं परैः \t॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2124651, "chapter_id": 3669, "verse_number": "१०८", "content_sanskrit": "एवं क्लेशैः सुबहुभिः क्लिश्यमाना सुदुःखिता ।\nनिवसाम्यार्यया हीना कृष्ण धौम्यपुरस्सरा\t॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2124652, "chapter_id": 3669, "verse_number": "१०९", "content_sanskrit": "त इमे सिंहविक्रान्ता वीर्येणाभ्यधिकाः परैः ।\nविहीनैः परिकृष्यन्तीं समुपैक्षन्त मां कथम्\t॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2124653, "chapter_id": 3669, "verse_number": "११०", "content_sanskrit": "एतादृशानि दुःखानि सहन्ते दुर्बलीयसाम् ।\nदीर्घकालं प्रदीप्तानि पापानां क्षुद्रकर्मणाम् \t॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2124654, "chapter_id": 3669, "verse_number": "१११", "content_sanskrit": "कुले महति जाताऽस्मि दिव्येन विधिना किल ।\nपाण्डवानां प्रिया भार्या स्नुषा पाण्डोर्महात्मनः \t॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2124655, "chapter_id": 3669, "verse_number": "११२", "content_sanskrit": "कचग्रहमनुप्राप्ता का नु जीवेत मादृशी ।\nपञ्चानामिन्द्रकल्पानां प्रेक्षतां मधुसूदन\t॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2124656, "chapter_id": 3669, "verse_number": "११३", "content_sanskrit": "इत्युक्त्वा प्रारुदत् कृष्णा मुखं प्रच्छाद्य पाणिना ।\nपद्मकोशप्रकाशेन मृदुना मृदुभाषिणी \t॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2124657, "chapter_id": 3669, "verse_number": "११४", "content_sanskrit": "स्तनावपतितौ पीनौ सुजातौ शुभलक्षणौ ।\nअभ्यवर्षत पाञ्चाली दुःखजैरश्रुबिन्दुभिः \t॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2124658, "chapter_id": 3669, "verse_number": "११५", "content_sanskrit": "चक्षुषी परिमार्जन्ती निश्श्वसन्ती पुनः पुनः ।\nबाष्पपूर्णेन कण्ठेन क्रुद्धा वचनमब्रवीत्\t॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2124659, "chapter_id": 3669, "verse_number": "११६", "content_sanskrit": "नैव मे पतयः सन्ति न पुत्रा मधुसूदन ।\nन भ्रातरो न च पिता नैव त्वं न च बान्धवाः \t॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2124660, "chapter_id": 3669, "verse_number": "११७", "content_sanskrit": "ये मां विप्रकृतां क्षुद्रैरुपेक्षन्ते विशोकवत् ।\nन हि मे शाम्यते दुःखं कर्णो यत् प्राहसत् तदा \t ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2124661, "chapter_id": 3669, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2124662, "chapter_id": 3669, "verse_number": "११८", "content_sanskrit": "अथैनामब्रवीत् कृष्णस्तस्मिन् वीरसमागमे ।\nरोदिष्यन्ति स्त्रियो ह्येवं येषां क्रुद्धाऽसि भामिनि\t ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 2124663, "chapter_id": 3669, "verse_number": "११९", "content_sanskrit": "बीभत्सुशरसञ्छन्नान् शोणितौघपरिप्लुतान् ।\nद्रक्ष्यसि ह्यनवद्याङ्गि दुर्योधनमुखान् रिपून् \t॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 2124664, "chapter_id": 3669, "verse_number": "१२०", "content_sanskrit": "निहतान् जीवितं त्यक्त्वा शयानान् वसुधातळे ।\nसत्यं ते प्रतिजानामि राज्ञो राज्ञी भविष्यसि\t॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 2124665, "chapter_id": 3669, "verse_number": "", "content_sanskrit": "पतेद् द्यौर्हिमवान् शीर्येत् पृथिवी शकलीभवेत् ।\nशुष्येत् तोयनिधिः कृष्णे न मे मिथ्या वचो भवेत् \t॥१२१", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 2124666, "chapter_id": 3669, "verse_number": "१२२", "content_sanskrit": "तच्छ्रुत्वा द्रौपदी वाक्यप्रतिवाक्यमथाच्युता ।\nसाचीकृतमवैक्षत् सा पाञ्चाली मध्यमं पतिम् \t॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 2124667, "chapter_id": 3669, "verse_number": "", "content_sanskrit": "धृष्टद्युम्नः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 2124668, "chapter_id": 3669, "verse_number": "१२३", "content_sanskrit": "अहं द्रोणं हनिष्यामि शिखण्डी च पितामहम् ।\nदुर्योधनं भीमसेनः कर्णं हन्ता धनञ्जयः \t॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 2124669, "chapter_id": 3669, "verse_number": "१२४", "content_sanskrit": "आबभाषे तथा कृष्णामर्जुनः प्रहसन्निव ।\nमा रोदीः शुभताम्राक्षि यथाऽऽह वरवर्णिनि ।\nकृष्णोऽयं तत् तथा देवि नान्यथा चारुलोचने\t॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 2124670, "chapter_id": 3669, "verse_number": "१२५", "content_sanskrit": "रामकृष्णौ व्यपाश्रित्य अजेयाः स्म शुचिस्मिते ।\nअपि वृत्रहणा युद्धे किं पुनर्धृतराष्ट्रजैः\t॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 2124671, "chapter_id": 3669, "verse_number": "१२६", "content_sanskrit": "इत्युक्त्वाऽभिमुखा वीरा वासुदेवमुपास्थिताः ।\nतेषां मध्ये महाबाहुः केशवो वाक्यमब्रवीत्\t॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 2124672, "chapter_id": 3669, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां वनपर्वणि\nएकादशोऽध्यायः ॥११॥\n॥ कैरातपर्वणि प्रथमोऽध्यायः ॥१॥\n—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}]