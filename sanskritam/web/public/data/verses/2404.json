[{"id": 2066514, "chapter_id": 2404, "verse_number": "९-२२-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2066515, "chapter_id": 2404, "verse_number": "९-२२-१", "content_sanskrit": "वर्तमाने तदा युद्धे घोररूपे भयानके।\nअभज्यत बलं तत्र तव पुत्रस्य पाण्डवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2066516, "chapter_id": 2404, "verse_number": "९-२२-२", "content_sanskrit": "तांस्तु सर्वानयन्तेन सन्निवार्य महारथाः।\nपुत्रास्ते योधयामासुः पाण्डवानामनीकिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2066517, "chapter_id": 2404, "verse_number": "९-२२-३", "content_sanskrit": "निवृत्ताः सहसा योधास्तव पुत्रजयैपिणः।\nसन्निवृत्तेषु तेष्वेवं युद्धमासीत्सुदारुणम्।\nतावकानां परेषां च देवासुररणोपभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2066518, "chapter_id": 2404, "verse_number": "९-२२-४", "content_sanskrit": "परेषां तावकानां च नासीत्कश्चित्पराङ्मुखः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2066519, "chapter_id": 2404, "verse_number": "९-२२-५", "content_sanskrit": "अनुमानेन युध्यन्ते सञ्ज्ञाभिश्च परस्परम्।\nतेषां क्षयो महानासीद्युध्यतामितरेतरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2066520, "chapter_id": 2404, "verse_number": "९-२२-६", "content_sanskrit": "ततो युधिष्ठिरो राजा क्रोधेन महता युतः।\nजिगीषमाणः सङ्ग्रामे धार्तराष्ट्रान्सराजकान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2066521, "chapter_id": 2404, "verse_number": "९-२२-७", "content_sanskrit": "त्रिभिः शारद्वतं विद्व्वा रुक्मपुङ्खैः शिलाशितैः।\nचतुर्भिर्निजघानाश्वान्कल्याणान्कृतवर्मणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2066522, "chapter_id": 2404, "verse_number": "९-२२-८", "content_sanskrit": "अश्वत्थामा तु हार्दिक्यमपोवाह यशस्विनम्।\nअथ शारद्वतोऽष्टाभिः प्रत्यविध्यद्युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2066523, "chapter_id": 2404, "verse_number": "९-२२-९", "content_sanskrit": "ततो दुर्योधनो राजा रथान्सप्तशतान्रणे।\nप्रैषयद्यत्र राजाऽसौ धर्मपुत्रो युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2066524, "chapter_id": 2404, "verse_number": "९-२२-१०", "content_sanskrit": "ते रथा रथिभिर्युक्ता मनोमारुतरंहसः।\nअभ्यद्रवन्त सङ्ग्रामे कौन्तेयस्य रथं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2066525, "chapter_id": 2404, "verse_number": "९-२२-११", "content_sanskrit": "ते समन्तान्महाराज परिवार्य युधिष्ठिरम्।\nअदृश्यं सायकैश्चक्रुर्मेघा इव दिवाकरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2066526, "chapter_id": 2404, "verse_number": "९-२२-१२", "content_sanskrit": "तं दृष्ट्वा धर्मराजानं कौरवेयैस्तथावृतम्।\nनामृष्यन्त सुसंरब्धाः शिखण्डिप्रमुखा रथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2066527, "chapter_id": 2404, "verse_number": "९-२२-१३", "content_sanskrit": "रथैरश्ववरैर्युक्तैः किङ्किणीजालसंवृतैः।\nआजग्मुरथ रक्षन्तः कुन्तीपुत्रं युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2066528, "chapter_id": 2404, "verse_number": "९-२२-१४", "content_sanskrit": "ततः प्रववृते रौद्रः सङ्ग्रामः शोणितोदकः।\nपाण्डवानां कुरूणां च यमराष्ट्रविवर्धनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2066529, "chapter_id": 2404, "verse_number": "९-२२-१५", "content_sanskrit": "रथान्सप्तशतान्हत्वा कुरूणामाततायिनाम्।\nपाण्डवाः सह पाञ्चालैः पुनरेवाभ्यवारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2066530, "chapter_id": 2404, "verse_number": "९-२२-१६", "content_sanskrit": "तत्र युद्धं महच्चासीत्तव पुत्रस्य पाण्डवैः।\nन च तत्तादृशं दृष्टं नैव चापि परिश्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2066531, "chapter_id": 2404, "verse_number": "९-२२-१७", "content_sanskrit": "वर्तमाने तदा युद्धे निर्मर्यादे समन्ततः।\nवध्यमानेषु योधेषु तावकेष्वितरेषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2066532, "chapter_id": 2404, "verse_number": "९-२२-१८", "content_sanskrit": "विनदत्सु च योधेषु शङ्खवर्यैश्च पूरितैः।\nउत्क्रुष्टैः सिंहनादैश्च गर्जितैश्चैव धन्विनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2066533, "chapter_id": 2404, "verse_number": "९-२२-१९", "content_sanskrit": "अतिप्रवृत्ते युद्धे च छिद्यमानेषु मर्मसु।\nधावमानेषु योधेषु जयगृद्धिषु मारिष॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2066534, "chapter_id": 2404, "verse_number": "९-२२-२०", "content_sanskrit": "संहारे सर्वतो जाते पृथिव्यां शोकसम्भवे।\nवह्नीनामुत्तमस्त्रीणां सीमन्तोद्धरणे कृते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2066535, "chapter_id": 2404, "verse_number": "९-२२-२१", "content_sanskrit": "निर्मर्यादे महायुद्धे वर्तमाने सुदारुणे।\nप्रादुरासन्विनाशाय तदोत्पाताः सुदारुणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2066536, "chapter_id": 2404, "verse_number": "९-२२-२२", "content_sanskrit": "चचाल शब्दं कुर्वाणा सपर्वतवना मही।\nसदण्डाः सोल्मुका राजन्कीर्यमाणाः समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2066537, "chapter_id": 2404, "verse_number": "९-२२-२३", "content_sanskrit": "उल्काः पेतुर्दिवो भूमावाहत्य रविमण्डलम्।\nविष्वग्वाताः प्रादुरासन्नीचैः शर्करवर्षिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2066538, "chapter_id": 2404, "verse_number": "९-२२-२४", "content_sanskrit": "अश्रूणि मुमुचुर्नागा वेपथुं चास्पृशन्भृशम्।\nएतान्धोराननादृत्य समुत्पातान्सुदारुणान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2066539, "chapter_id": 2404, "verse_number": "९-२२-२५", "content_sanskrit": "पुनर्युद्धाय संयत्ताः क्षत्रियास्तस्थुरव्यथाः।\nरमणीये कुरुक्षेत्रे पुण्ये स्वर्गं यियासवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2066540, "chapter_id": 2404, "verse_number": "९-२२-२६", "content_sanskrit": "ततो गान्धारराजस्य पुत्रः शकुनिरब्रवीत्।\nयुध्यध्वमग्रतो यावत्पृष्ठतो हन्मि पाण्डवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2066541, "chapter_id": 2404, "verse_number": "९-२२-२७", "content_sanskrit": "ततो नः सम्प्रायातानां मद्रयोधास्तरस्विनः।\nहृष्टाः किलाकिलाशब्दमकुर्वत परे तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2066542, "chapter_id": 2404, "verse_number": "९-२२-२८", "content_sanskrit": "अस्मांस्तु पुनरासाद्य लब्धलक्षा दुरासदाः।\nशरासनानि धुन्वन्तः शरवर्षैरवाकिरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2066543, "chapter_id": 2404, "verse_number": "९-२२-२९", "content_sanskrit": "ततो हतं परैस्तत्र मद्रराजबलं तदा।\nदुर्योधनबलं दृष्ट्वा पुनरासीत्पराङ्मुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2066544, "chapter_id": 2404, "verse_number": "९-२२-३०", "content_sanskrit": "गान्धारराजस्तु पुनर्वाक्यमाह ततो बली।\nनिवर्तध्वमधर्मज्ञा युध्यध्वं किं सृतेन वः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2066545, "chapter_id": 2404, "verse_number": "९-२२-३१", "content_sanskrit": "अनीकं दशसाहस्रमश्वानां भरतर्षभ।\nआसीद्गान्धारराजस्य विशालप्रासयोधिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2066546, "chapter_id": 2404, "verse_number": "९-२२-३२", "content_sanskrit": "बलेन तेन विक्रम्य वर्तमाने जनक्षये।\nपृष्ठतः पाण्डवानीकमभ्यघ्नन्निशितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2066547, "chapter_id": 2404, "verse_number": "९-२२-३३", "content_sanskrit": "तदभ्रमिव वातेन क्षिप्यमाणं समन्ततः।\nअभज्यत महाराज पाण्डूनां सुमहद्बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2066548, "chapter_id": 2404, "verse_number": "९-२२-३४", "content_sanskrit": "ततो युधिष्ठिरः प्रेक्ष्य भग्नं स्वबलमन्तिकात्।\nअभ्यनोदयदव्यग्रः सहदेवं महाबलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2066549, "chapter_id": 2404, "verse_number": "९-२२-३५", "content_sanskrit": "असौ सुबलपुत्रो नो जघनं पीड्य दंशितः।\nसैन्यानि सूदयत्येष पश्य पाण्डव दुर्मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2066550, "chapter_id": 2404, "verse_number": "९-२२-३६", "content_sanskrit": "गच्छ त्वं द्रौपदेयैश्च शकुनिं सौबलं जहि।\nरथानीकमहं धक्ष्ये पाञ्चालसहितोऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2066551, "chapter_id": 2404, "verse_number": "९-२२-३७", "content_sanskrit": "गच्छन्तु कुञ्जराः सर्वे वाजिनश्च सह त्वया।\nपादाताश्च त्रिसाहस्राः शकुनिं तैर्वृतो जहि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2066552, "chapter_id": 2404, "verse_number": "९-२२-३८", "content_sanskrit": "ततो गजाः सप्तशताश्चापपाणिभिरास्थिताः।\nपञ्च चाश्वसहस्राणि सहदेवश्च वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2066553, "chapter_id": 2404, "verse_number": "९-२२-३९", "content_sanskrit": "पादाताश्च त्रिसाहस्रा द्रौपदेयाश्च सर्वशः।\nरणे ह्यभ्यद्रवंस्ते तु शकुनिं युद्धदुर्मदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2066554, "chapter_id": 2404, "verse_number": "९-२२-४०", "content_sanskrit": "ततस्तु सौबलो राजन्नभ्यतिक्रम्य पाण्डवान्।\nजघान पृष्ठतः सेनां जयगृद्वः प्रतापवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2066555, "chapter_id": 2404, "verse_number": "९-२२-४१", "content_sanskrit": "अश्वारोहास्तु संरब्धाः पाण्डवानां तरस्विनाम्।\nप्राविशन्सौबलानीकमभ्यतिक्रम्य तान्रथान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2066556, "chapter_id": 2404, "verse_number": "९-२२-४२", "content_sanskrit": "ते तत्र सादिनः शूराः सौबलस्य महद्बलम्।\nरणमध्ये व्यतिष्ठन्त शरवर्षैरवाकिरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2066557, "chapter_id": 2404, "verse_number": "९-२२-४३", "content_sanskrit": "तदुद्यतगदाप्रासमकापुरुषसेवितम्।\nप्रावर्तत महद्युद्धं राजन्दुर्मन्त्रिते तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2066558, "chapter_id": 2404, "verse_number": "९-२२-४४", "content_sanskrit": "उपारमन्त ज्याशब्दाः प्रेक्षका रथिनोऽभवन्।\nन हि स्वेषां परेषां वा विशेषः प्रत्यदृश्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2066559, "chapter_id": 2404, "verse_number": "९-२२-४५", "content_sanskrit": "शूरबाहुविसृष्टानां शक्तीनां भरतर्षभ।\nज्योतिषामिव सम्पातमपश्यन्कुरुपाण्डवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2066560, "chapter_id": 2404, "verse_number": "९-२२-४६", "content_sanskrit": "ऋष्टिभिर्विमलाभिश्च तत्रतत्र विशाम्पते।\nसम्पतन्तीभिराकाशमावृतं बह्वशोभत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2066561, "chapter_id": 2404, "verse_number": "९-२२-४७", "content_sanskrit": "प्रासानां पततां राजन्रूपमासीत्समन्ततः।\nशलभानामिवाकाशे तदा भरतसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2066562, "chapter_id": 2404, "verse_number": "९-२२-४८", "content_sanskrit": "रुधिरोक्षितसर्वाङ्गा विप्रविद्धैर्नियन्तृभिः।\nहयाः परिपतन्तिस्म शतशोऽथ सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2066563, "chapter_id": 2404, "verse_number": "९-२२-४९", "content_sanskrit": "अन्योन्यं परिपिष्टाश्च समासाद्य परस्परम्।\nसुविक्षताः स्म दृश्यन्ते वमन्तो रुधिरं मुखैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2066564, "chapter_id": 2404, "verse_number": "९-२२-५०", "content_sanskrit": "ततोऽभवत्तमो घोरं सैन्येन रजसा वृतम्।\nतानपाक्रमतोऽद्राक्षं तस्माद्देशादरिन्दम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2066565, "chapter_id": 2404, "verse_number": "९-२२-५१", "content_sanskrit": "अश्वान्राजन्मनुष्यांश्च रजसा संवृते सति।\nभूमौ निपतिताश्चान्ये वमन्तो रुधिरं बहु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2066566, "chapter_id": 2404, "verse_number": "९-२२-५२", "content_sanskrit": "केशाकेशि समालग्ना न शेकुश्चेष्टितुं नराः।\nअन्योन्यमश्वपृष्ठेभ्यो विकर्षन्तो महाबलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2066567, "chapter_id": 2404, "verse_number": "९-२२-५३", "content_sanskrit": "मल्ला इव समासाद्य निजघ्नुरितरेतरम्।\nअश्वैश्च व्यपकृष्यन्त बहवोऽत्र गतासवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2066568, "chapter_id": 2404, "verse_number": "९-२२-५४", "content_sanskrit": "भूमौ निपतिताश्चान्ये बहवो विजयैषिणः।\nतत्रतत्र व्यदृश्यन्त पुरुषाः शूरमानिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2066569, "chapter_id": 2404, "verse_number": "९-२२-५५", "content_sanskrit": "रक्तोक्षितैश्छिन्नभुजैरवकृष्टशिरोरुहैः।\nव्यदृश्यत मही कीर्णा शतशोऽथ सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2066570, "chapter_id": 2404, "verse_number": "९-२२-५६", "content_sanskrit": "दूरं न शक्यं तत्रासीद्गन्तुमश्वेन केनचित्।\nसाश्वारोहैर्हतैरश्वैरावृते वसुधातले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2066571, "chapter_id": 2404, "verse_number": "९-२२-५७", "content_sanskrit": "रुधिरोक्षितसन्नाहैरात्तशस्त्रैरुदायुधैः।\nनानाप्रहरणैर्घोरैः परस्परवधैषिभिः।\nसुसन्निकृष्टे सङ्ग्रामे हतभूयिष्ठसैनिके॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2066572, "chapter_id": 2404, "verse_number": "९-२२-५८", "content_sanskrit": "स मुहूर्तं ततो युद्ध्वा सौबलोऽथ विशाम्पते।\nषट्साहस्रैर्हयैः शिष्टेरपायाच्छकुनिस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2066573, "chapter_id": 2404, "verse_number": "९-२२-५९", "content_sanskrit": "तथैव पाण्डवानीकं रुधिरेण समुक्षितम्।\nषट्साहस्रैर्हयैः शिष्टेरपायाच्छ्रान्तवाहनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2066574, "chapter_id": 2404, "verse_number": "९-२२-६०", "content_sanskrit": "अश्वारोहाश्च पाण्डूनामब्रुवन्रुधिरोक्षिताः।\nसुसन्निकृष्टे सङ्ग्रामे भूयिष्ठे त्यक्तजीविताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2066575, "chapter_id": 2404, "verse_number": "९-२२-६१", "content_sanskrit": "न हि शक्यं रथैर्योद्धुं कुत एव महागजैः।\nरथानेव रथा यान्तु कुञ्जराः कुञ्जरानपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2066576, "chapter_id": 2404, "verse_number": "९-२२-६२", "content_sanskrit": "प्रतियातो हि शकुनिः स्वमनीकमवस्थितः।\nन पुनः सौबलो राजा योद्धुमभ्यागमिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2066577, "chapter_id": 2404, "verse_number": "९-२२-६३", "content_sanskrit": "ततस्तु द्रौपदेयाश्च ते च मत्ता महाद्विपाः।\nप्रययुर्यत्र पाञ्चाल्यो धृष्टद्युम्नो महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2066578, "chapter_id": 2404, "verse_number": "९-२२-६४", "content_sanskrit": "सहदेवोऽपि कौरव्य रजोमेघे समुत्थिते।\nएकाकी प्रययौ तत्र यत्र राजा युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2066579, "chapter_id": 2404, "verse_number": "९-२२-६५", "content_sanskrit": "ततस्तेषु प्रयातेषु शकुनिः सौबलः पुनः।\nपार्श्वतोऽभ्यहनत्क्रुद्धो धृष्टद्युम्नस्य वाहिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2066580, "chapter_id": 2404, "verse_number": "९-२२-६६", "content_sanskrit": "तत्पुनस्तुमुलं युद्धं प्राणांस्त्यक्त्वाऽभ्यवर्तत।\nतावकानां परेषां च परस्परवधैषिणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2066581, "chapter_id": 2404, "verse_number": "९-२२-६७", "content_sanskrit": "ते चान्योन्यमवैक्षन्त तस्मिन्वीरसमागमे।\nयोधाः पर्यपतन्राजञ्शतशोऽथ सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2066582, "chapter_id": 2404, "verse_number": "९-२२-६८", "content_sanskrit": "असिभिश्छिद्यमानानां शिरसां लोकसंक्षये।\nप्रादुरासीन्महाञ्शब्दस्तालानां पततामिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2066583, "chapter_id": 2404, "verse_number": "९-२२-६९", "content_sanskrit": "विमुक्तानां शरीराणां छिन्नानां पततां भुवि।\nसायुधानां च बाहूनामूरूणां च विशाम्पते।\nआसीत्कटकटाशब्दः सुमहान्रोमहर्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2066584, "chapter_id": 2404, "verse_number": "९-२२-७०", "content_sanskrit": "निघ्नन्तो निशितैः शस्त्रैर्भ्रातॄन्पुत्रान्सखीनपि।\nयोधाः परिपतन्ति स्म यथाऽऽमिषकृते खगाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2066585, "chapter_id": 2404, "verse_number": "९-२२-७१", "content_sanskrit": "अन्योन्यं प्रतिसंरब्धाः समासाद्य परस्परम्।\nअहम्पूर्वमहम्पूर्वमिति निघ्नन्सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2066586, "chapter_id": 2404, "verse_number": "९-२२-७२", "content_sanskrit": "संयातेनासनभ्रष्टैरश्वारोहैर्गतासुभिः।\nहयाः परिपतन्ति स्म शतशोऽथ सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2066587, "chapter_id": 2404, "verse_number": "९-२२-७३", "content_sanskrit": "स्फुरतां प्रतिपिष्टानामश्वानां शीघ्रगामिनाम्।\nस्तनतां च मनुष्याणां सन्नद्धानां विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2066588, "chapter_id": 2404, "verse_number": "९-२२-७४", "content_sanskrit": "शक्त्यृष्टिप्रासशब्दश्च तुमुलः समपद्यत।\nभिन्दतां परमर्माणि राजन्दुर्मन्त्रिते तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2066589, "chapter_id": 2404, "verse_number": "९-२२-७५", "content_sanskrit": "श्रमाभिभूताः संरब्धा श्रान्तवाहाः पिपासवः।\nविक्षताश्च शितैः शस्त्रैरभ्यवर्न्तत तावकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2066590, "chapter_id": 2404, "verse_number": "९-२२-७६", "content_sanskrit": "मत्ता रुधिरगन्धेन बहवोऽत्र विचेतसः।\nजघ्नुः परान्स्वकांश्चैव प्राप्तान्प्राप्ताननन्तरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2066591, "chapter_id": 2404, "verse_number": "९-२२-७७", "content_sanskrit": "बहवश्च गतप्राणाः क्षत्रिया जयगृद्विनः।\nभूमावभ्यपतन्राजञ्शरवृष्टिभिरावृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2066592, "chapter_id": 2404, "verse_number": "९-२२-७८", "content_sanskrit": "वृकगृध्रशृगालानां तुमुले मोदनेऽहनि।\nआसीद्बलक्षयो घोरस्तव पुत्रस्य पश्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2066593, "chapter_id": 2404, "verse_number": "९-२२-७९", "content_sanskrit": "नराश्वकायैः सञ्छन्ना भूमिरासीद्विशाम्पते।\nरुधिरोदकचित्रा च भीरूणां भयवर्धिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2066594, "chapter_id": 2404, "verse_number": "९-२२-८०", "content_sanskrit": "असिभिः पट्टसैः शूलैस्तक्षमाणाः पुनःपुनः।\nतावकाः पाण़्वेयाश्च न न्यवर्तन्त भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2066595, "chapter_id": 2404, "verse_number": "९-२२-८१", "content_sanskrit": "प्रहरन्तो यथाशक्ति यावत्प्राणस्य धारणम्।\nयोधाः परिपतन्ति स्म वमन्तो रुधिरं मुखैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2066596, "chapter_id": 2404, "verse_number": "९-२२-८२", "content_sanskrit": "शिरो गृहीत्वा केशेषु कबन्धः स प्रदृश्यते।\nउद्यम्य च शितं खङ्गं रुधिरेण परिप्लुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2066597, "chapter_id": 2404, "verse_number": "९-२२-८३", "content_sanskrit": "तथोत्थितेषु बहुषु कबन्धेषु नराधिप।\nतथा रुधिरगन्धेन योधाः कश्मलमाविशन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2066598, "chapter_id": 2404, "verse_number": "९-२२-८४", "content_sanskrit": "मन्दीभूते ततः शब्दे पाण्डवानां महद्बलम्।\nअल्पावशिष्टैस्तुरगैरभ्यवर्तत सौबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2066599, "chapter_id": 2404, "verse_number": "९-२२-८५", "content_sanskrit": "ततोऽभ्यधावंस्त्वरिताः पाण्डवा जयगृद्विनः।\nपदातयश्च नागाश्च सादिनश्चोद्यतायुधाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2066600, "chapter_id": 2404, "verse_number": "९-२२-८६", "content_sanskrit": "कोष्ठकीकृत्य चाप्येनं परिक्षिप्य च सर्वशः।\nशस्त्रैर्नानाविधैर्जघ्नुर्युद्वपारं तितीर्षवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2066601, "chapter_id": 2404, "verse_number": "९-२२-८७", "content_sanskrit": "त्वदीयास्तांस्तु सम्प्रेक्ष्य सर्वतः समभिद्रुतान्।\nरथाश्वपत्तिद्विरदाः पाण्डवानभिदुद्रुवुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2066602, "chapter_id": 2404, "verse_number": "९-२२-८८", "content_sanskrit": "केचित्पदातयः पद्भिर्मुष्टिभिश्च परस्परम्।\nनिजघ्नुः समरे शूराः क्षीणशस्त्रास्ततोऽपतन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2066603, "chapter_id": 2404, "verse_number": "९-२२-८९", "content_sanskrit": "रथेभ्यो रथिनः पेतुर्द्विपेभ्यो हस्तिसादिनः।\nविमानेभ्यो दिवो भ्रष्टाः सिद्वाः पुण्यक्षयादिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2066604, "chapter_id": 2404, "verse_number": "९-२२-९०", "content_sanskrit": "एवमन्योन्यमायत्ता योधा जघ्नुर्महाहवे।\nपितॄन्भ्रातॄन्वयस्यांश्च पुत्रानपि तथा परे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2066605, "chapter_id": 2404, "verse_number": "९-२२-९१", "content_sanskrit": "एवमासीदमर्यादं युद्वं भरतसत्तम।\nप्रासासिबाणकलिलं वर्तमाने सुदारुणे॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2066606, "chapter_id": 2404, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शल्यपर्वणि शल्यवधपर्वणि अष्टादशदिवसयुद्धे द्वाविंशोऽध्यायः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}]