[{"id": 7000209000, "chapter_id": 20209, "verse_number": "२०९-१", "content_sanskrit": "द्विविदवानरवधवर्णनम् व्यास उवाच शृणुध्वं मुनयः सर्वे बलस्य बलशालिनः ।\nकृतं यदन्यदेवाभूत्तदपि श्रूयतां द्विजाः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000209001, "chapter_id": 20209, "verse_number": "२०९-२", "content_sanskrit": "नरकस्यासुरेन्द्रस्य देवपक्षविरोधिनः ।\nसखाऽभवन्महावीर्यो द्विविदो नाम वानरः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000209002, "chapter_id": 20209, "verse_number": "२०९-३", "content_sanskrit": "वैरानुबन्धं बलवान्स चकार सुरान्प्रति ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000209003, "chapter_id": 20209, "verse_number": "२०९-४", "content_sanskrit": "द्विविद उवाच नरकं हतवान्कृष्णो बलदर्पसमन्वितम् ।\nकरिष्ये सर्वदेवानां तस्मादेष प्रतिक्रियाम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000209004, "chapter_id": 20209, "verse_number": "२०९-५", "content_sanskrit": "यज्ञविध्वंसनं कुर्वन्मर्त्यलोकक्षयं तथा ।\nततो विध्वंसयामास यज्ञानज्ञानमोहितः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000209005, "chapter_id": 20209, "verse_number": "२०९-६", "content_sanskrit": "बिभेद साधुमर्यादां क्षयं चक्रे च देहिनाम् ।\nददाह चपलो देशं पुरग्रामान्तराणि च ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000209006, "chapter_id": 20209, "verse_number": "२०९-७", "content_sanskrit": "क्वचिच्च पर्वतक्षेपाद्‌ग्रामादीन्समचूर्णयत् ।\nशैलानुत्पाट्य तोयेषु मुमोचाम्बुनिधौ तथा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000209007, "chapter_id": 20209, "verse_number": "२०९-८", "content_sanskrit": "पुनश्वार्णवमध्यस्थः क्षोभयामास सागरम् ।\nतेनातिक्षोभितश्चाब्धिरुद्वेलो जायते द्विजाः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000209008, "chapter_id": 20209, "verse_number": "२०९-९", "content_sanskrit": "प्लावयंस्तीरजन्ग्रामान्पुरादीनतिवेगवान् ।\nकामरूपं महारूपं कृत्वा सस्यान्यनेकशः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000209009, "chapter_id": 20209, "verse_number": "२०९-१०", "content_sanskrit": "लुठन्भ३मणसंमर्दः संचूर्णयति वानरः ।\nतेन विप्रकृतं सर्वं जगदेतद्‌दुरात्मना ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000209010, "chapter_id": 20209, "verse_number": "२०९-११", "content_sanskrit": "निःस्वाध्यायवषट्‌कारं द्विजाश्चाऽऽसीत्सुदुःखितम् ।\nकदाचिद्रैवतोद्याने पपौ पानं हलायुधः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000209011, "chapter_id": 20209, "verse_number": "२०९-१२", "content_sanskrit": "रेवती च महाभागा तथैवान्या वरस्त्रियः ।\nउद्‌गीयमानो विलसल्ललनामौलिमध्यगः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000209012, "chapter_id": 20209, "verse_number": "२०९-१३", "content_sanskrit": "मुशलं च चकारास्य संमुखः स विडम्बनाम् ।\nतथैव योषितां तासां जहासाभिमुखं कपिः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000209013, "chapter_id": 20209, "verse_number": "२०९-१४", "content_sanskrit": "पानपूर्णांश्च करकांश्चिक्षेपाऽऽहत्य वै तदा ।\nततः कोपपरीतात्मा भर्त्सयामास तं बलम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000209014, "chapter_id": 20209, "verse_number": "२०९-१५", "content_sanskrit": "तथाऽपि तमवज्ञाय चक्रे किलकिलाध्वनिम् ।\nततः समुत्थाय बलो जगृहे मुशलं रुषा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000209015, "chapter_id": 20209, "verse_number": "२०९-१६", "content_sanskrit": "सोऽपि शैलशिलां भीमां जग्राह प्लवगोत्तमः ।\nचिक्षेप च स तां क्षिप्तां मुशलेन सहस्रधा ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000209016, "chapter_id": 20209, "verse_number": "२०९-१७", "content_sanskrit": "बिभेद यादवश्रेष्ठः सा पपात महीतले ।\nअपतनमुशलं चासौ समुल्लङ्घ्य प्लवंघमः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000209017, "chapter_id": 20209, "verse_number": "२०९-१८", "content_sanskrit": "वेगेनाऽऽयम्य रोषेण बलेनोरस्यताडयत् ।\nततो बलेन कोपेन मुष्टिना मूर्ध्नि ताडितः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000209018, "chapter_id": 20209, "verse_number": "२०९-१९", "content_sanskrit": "पपात रुधिरोद्‌गारी द्विविदः क्षीणजीवितः ।\nपतता तच्छरीरेण गिरेः श्रृङ्गमशीर्यत ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000209019, "chapter_id": 20209, "verse_number": "२०९-२०", "content_sanskrit": "मुनयः शतधा वज्रिवज्रेणेव हि ताडितम् ।\nपुष्पवृष्टिं ततो देवा रामस्योपरि चिक्षिपुः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000209020, "chapter_id": 20209, "verse_number": "२०९-२१", "content_sanskrit": "प्रशशंसुस्तदाऽभ्येत्य साध्वेतत्ते महत्कृतम् ।\nअनेन दुष्टकपिना दैत्यपक्षोपकारिणा ।\nजगन्निराकृतं वीर दिष्ट्या स क्षयमागतः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000209021, "chapter_id": 20209, "verse_number": "२०९-२२", "content_sanskrit": "व्यास उवाच एवंविधान्यनेकानि बलदेवस्य धीमतः ।\nकर्माण्यपरिमेयानि शेषस्य धरणीभृतः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]