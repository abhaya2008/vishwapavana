[{"id": 5000444000, "chapter_id": 9444, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे सप्तत्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000444001, "chapter_id": 9444, "verse_number": "६-३७-१", "content_sanskrit": "नरवानरराजानौ स तु वायुसुतः कपिः।\nजाम्बवानृक्षराजश्च राक्षसश्च विभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000444002, "chapter_id": 9444, "verse_number": "६-३७-२", "content_sanskrit": "अङ्गदो वालिपुत्रश्च सौमित्रिः शरभः कपिः।\nसुषेणः सहदायादो मैन्दो द्विविद एव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000444003, "chapter_id": 9444, "verse_number": "६-३७-३", "content_sanskrit": "गजो गवाक्षः कुमुदो नलोऽथ पनसस्तथा।\nअमित्रविषयं प्राप्ताः समवेताः समर्थयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000444004, "chapter_id": 9444, "verse_number": "६-३७-४", "content_sanskrit": "इयं सा लक्ष्यते लङ्का पुरी रावणपालिता।\nसासुरोरगगन्धर्वैरमरैरपि दुर्जया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000444005, "chapter_id": 9444, "verse_number": "६-३७-५", "content_sanskrit": "कार्यसिद्धिं पुरस्कृत्य मन्त्रयध्वं विनिर्णये।\nनित्यं संनिहितो यत्र रावणो राक्षसाधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000444006, "chapter_id": 9444, "verse_number": "६-३७-६", "content_sanskrit": "अथ तेषु ब्रुवाणेषु रावणावरजोऽब्रवीत्।\nवाक्यमग्राम्यपदवत् पुष्कलार्थं विभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000444007, "chapter_id": 9444, "verse_number": "६-३७-७", "content_sanskrit": "अनलः पनसश्चैव सम्पातिः प्रमतिस्तथा।\nगत्वा लङ्कां ममामात्याः पुरीं पुनरिहागताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000444008, "chapter_id": 9444, "verse_number": "६-३७-८", "content_sanskrit": "भूत्वा शकुनयः सर्वे प्रविष्टाश्च रिपोर्बलम्।\nविधानं विहितं यच्च तद् दृष्ट्वा समुपस्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000444009, "chapter_id": 9444, "verse_number": "६-३७-९", "content_sanskrit": "संविधानं यथाहुस्ते रावणस्य दुरात्मनः।\nराम तद् ब्रुवतः सर्वं याथातथ्येन मे शृणु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000444010, "chapter_id": 9444, "verse_number": "६-३७-१०", "content_sanskrit": "पूर्वं प्रहस्तः सबलो द्वारमासाद्य तिष्ठति।\nदक्षिणं च महावीर्यौ महापार्श्वमहोदरौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000444011, "chapter_id": 9444, "verse_number": "६-३७-११", "content_sanskrit": "इन्द्रजित् पश्चिमं द्वारं राक्षसैर्बहुभिर्वृतः।\nपट्टिशासिधनुष्मद्भिः शूलमुद‍्गरपाणिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000444012, "chapter_id": 9444, "verse_number": "६-३७-१२", "content_sanskrit": "नानाप्रहरणैः शूरैरावृतो रावणात्मजः।\nराक्षसानां सहस्रैस्तु बहुभिः शस्त्रपाणिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000444013, "chapter_id": 9444, "verse_number": "६-३७-१३", "content_sanskrit": "युक्तः परमसंविग्नो राक्षसैः सह मन्त्रवित्।\nउत्तरं नगरद्वारं रावणः स्वयमास्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000444014, "chapter_id": 9444, "verse_number": "६-३७-१४", "content_sanskrit": "विरूपाक्षस्तु महता शूलखड्गधनुष्मता।\nबलेन राक्षसैः सार्धं मध्यमं गुल्ममाश्रितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000444015, "chapter_id": 9444, "verse_number": "६-३७-१५", "content_sanskrit": "एतानेवं विधान् गुल्माँल्लङ्कायां समुदीक्ष्य ते।\nमामका मन्त्रिणः सर्वे शीघ्रं पुनरिहागताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000444016, "chapter_id": 9444, "verse_number": "६-३७-१६", "content_sanskrit": "गजानां दशसाहस्रं रथानामयुतं तथा।\nहयानामयुते द्वे च साग्रकोटिश्च रक्षसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000444017, "chapter_id": 9444, "verse_number": "६-३७-१७", "content_sanskrit": "विक्रान्ता बलवन्तश्च संयुगेष्वाततायिनः।\nइष्टा राक्षसराजस्य नित्यमेते निशाचराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000444018, "chapter_id": 9444, "verse_number": "६-३७-१८", "content_sanskrit": "एकैकस्यात्र युद्धार्थे राक्षसस्य विशाम्पते।\nपरीवारः सहस्राणां सहस्रमुपतिष्ठते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000444019, "chapter_id": 9444, "verse_number": "६-३७-१९", "content_sanskrit": "एतां प्रवृत्तिं लङ्कायां मन्त्रिप्रोक्तां विभीषणः।\nएवमुक्त्वा महाबाहू राक्षसांस्तानदर्शयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000444020, "chapter_id": 9444, "verse_number": "६-३७-२०", "content_sanskrit": "लङ्कायां सचिवैः सर्वं रामाय प्रत्यवेदयत्।\nरामं कमलपत्राक्षमिदमुत्तरमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000444021, "chapter_id": 9444, "verse_number": "६-३७-२१", "content_sanskrit": "रावणावरजः श्रीमान् रामप्रियचिकीर्षया।\nकुबेरं तु यदा राम रावणः प्रतियुद्ध्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000444022, "chapter_id": 9444, "verse_number": "६-३७-२२", "content_sanskrit": "षष्टिः शतसहस्राणि तदा निर्यान्ति राक्षसाः।\nपराक्रमेण वीर्येण तेजसा सत्त्वगौरवात्।\nसदृशा ह्यत्र दर्पेण रावणस्य दुरात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000444023, "chapter_id": 9444, "verse_number": "६-३७-२३", "content_sanskrit": "अत्र मन्युर्न कर्तव्यः कोपये त्वां न भीषये।\nसमर्थो ह्यसि वीर्येण सुराणामपि निग्रहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000444024, "chapter_id": 9444, "verse_number": "६-३७-२४", "content_sanskrit": "तद्भवांश्चतुरङ्गेण बलेन महता वृतम्।\nव्यूह्येदं वानरानीकं निर्मथिष्यसि रावणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000444025, "chapter_id": 9444, "verse_number": "६-३७-२५", "content_sanskrit": "रावणावरजे वाक्यमेवं ब्रुवति राघवः।\nशत्रूणां प्रतिघातार्थमिदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000444026, "chapter_id": 9444, "verse_number": "६-३७-२६", "content_sanskrit": "पूर्वद्वारं तु लङ्काया नीलो वानरपुङ्गवः।\nप्रहस्तं प्रतियोद्धा स्याद् वानरैर्बहुभिर्वृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000444027, "chapter_id": 9444, "verse_number": "६-३७-२७", "content_sanskrit": "अङ्गदो वालिपुत्रस्तु बलेन महता वृतः।\nदक्षिणे बाधतां द्वारे महापार्श्वमहोदरौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000444028, "chapter_id": 9444, "verse_number": "६-३७-२८", "content_sanskrit": "हनूमान् पश्चिमद्वारं निष्पीड्य पवनात्मजः।\nप्रविशत्वप्रमेयात्मा बहुभिः कपिभिर्वृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000444029, "chapter_id": 9444, "verse_number": "६-३७-२९", "content_sanskrit": "दैत्यदानवसङ्घानामृषीणां च महात्मनाम्।\nविप्रकारप्रियः क्षुद्रो वरदानबलान्वितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000444030, "chapter_id": 9444, "verse_number": "६-३७-३०", "content_sanskrit": "परिक्रमति यः सर्वान् लोकान् संतापयन् प्रजाः।\nतस्याहं राक्षसेन्द्रस्य स्वयमेव वधे धृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000444031, "chapter_id": 9444, "verse_number": "६-३७-३१", "content_sanskrit": "उत्तरं नगरद्वारमहं सौमित्रिणा सह।\nनिपीड्याभिप्रवेक्ष्यामि सबलो यत्र रावणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000444032, "chapter_id": 9444, "verse_number": "६-३७-३२", "content_sanskrit": "वानरेन्द्रश्च बलवानृक्षराजश्च वीर्यवान्।\nराक्षसेन्द्रानुजश्चैव गुल्मे भवतु मध्यमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000444033, "chapter_id": 9444, "verse_number": "६-३७-३३", "content_sanskrit": "न चैव मानुषं रूपं कार्यं हरिभिराहवे।\nएषा भवतु नः संज्ञा युद्धेऽस्मिन् वानरे बले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000444034, "chapter_id": 9444, "verse_number": "६-३७-३४", "content_sanskrit": "वानरा एव नश्चिह्नं स्वजनेऽस्मिन् भविष्यति।\nवयं तु मानुषेणैव सप्त योत्स्यामहे परान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000444035, "chapter_id": 9444, "verse_number": "६-३७-३५", "content_sanskrit": "अहमेव सह भ्रात्रा लक्ष्मणेन महौजसा।\nआत्मना पञ्चमश्चायं सखा मम विभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000444036, "chapter_id": 9444, "verse_number": "६-३७-३६", "content_sanskrit": "स रामः कृत्यसिद्ध्यर्थमेवमुक्त्वा विभीषणम्।\nसुवेलारोहणे बुद्धिं चकार मतिमान् प्रभुः।\nरमणीयतरं दृष्ट्वा सुवेलस्य गिरेस्तटम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000444037, "chapter_id": 9444, "verse_number": "६-३७-३७", "content_sanskrit": "ततस्तु रामो महता बलेन\nप्रच्छाद्य सर्वां पृथिवीं महात्मा।\nप्रहृष्टरूपोऽभिजगाम लङ्कां\nकृत्वा मतिं सोऽरिवधे महात्मा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000444038, "chapter_id": 9444, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे सप्तत्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]