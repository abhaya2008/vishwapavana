[{"id": 2114436, "chapter_id": 3461, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2114437, "chapter_id": 3461, "verse_number": "१", "content_sanskrit": "धृतराष्ट्रस्तु राजेन्द्र यदा पौरवनन्दनः ।\nयुधिष्ठिरमजानाद् वै समर्थं राज्यरक्षणे \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2114438, "chapter_id": 3461, "verse_number": "२", "content_sanskrit": "यौवराज्यभिषेकार्थममन्त्रयत मन्त्रिभिः ।\nते तु बुद्ध्वाऽन्वतप्यन्त धृतराष्ट्रात्मजास्तदा \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2114439, "chapter_id": 3461, "verse_number": "३", "content_sanskrit": "ततः संवत्सरस्यान्ते पाण्डुपुत्रो महायशाः ।\nस्थापितो धृतराष्ट्रेण यौवराज्ये युधिष्ठिरः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2114440, "chapter_id": 3461, "verse_number": "४", "content_sanskrit": "अदीर्घेण च कालेन कुन्तीपुत्रो युधिष्ठिरः ।\nपित्र्यामन्तर्दधे कीर्तिं शीलवृत्तसमाधिभिः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2114441, "chapter_id": 3461, "verse_number": "५", "content_sanskrit": "असियुद्धे रणोद्याने बाहुयुद्धे च पाण्डवः ।\nसङ्कर्षणाच्छिक्षितवान् शश्वच्छिक्षां वृकोदरः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2114442, "chapter_id": 3461, "verse_number": "६", "content_sanskrit": "ते तं बुद्ध्वाऽन्वतप्यन्त धृतराष्ट्रात्मजास्तदा ।\nसमाप्तविद्यः सोऽभ्यस्य द्युमत्सेनसमो बले\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2114443, "chapter_id": 3461, "verse_number": "७", "content_sanskrit": "ततः सवंत्सरस्यान्ते पाण्डुपुत्रो महायशाः ।\nगदाबलाभ्यां सम्पन्नो भ्रातॄणामचरद् वशे \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2114444, "chapter_id": 3461, "verse_number": "८", "content_sanskrit": "प्रगाढदृढमुष्टित्वे लाघवे चातिवेधने ।\nलक्षवेद्ये च मोक्षे च तोमरग्रहणेऽपि च \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2114445, "chapter_id": 3461, "verse_number": "९", "content_sanskrit": "असिशक्तिगदायुद्धे बभूवाप्रतिमोऽर्जुनः ।\nक्षुरनाराचभल्लानां विपाठानां सुतेजसाम् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2114446, "chapter_id": 3461, "verse_number": "१०", "content_sanskrit": "ऋजुवक्रविशालानां प्रयोक्ता पाण्डवोऽभवत् ।\nलाघवात् सौष्ठवाच्चैव नान्यः कश्चित्तु विद्यते\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2114447, "chapter_id": 3461, "verse_number": "११", "content_sanskrit": "बीभत्सुसदृशो लोक इति द्रोणोऽभ्यभाषत ।\nगजयुद्धेऽश्वयुद्धे च रथयुद्धे च पाण्डवः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2114448, "chapter_id": 3461, "verse_number": "१२", "content_sanskrit": "पारगो भुजयुद्धे च बभूवैष धनञ्जयः ।\nस्वभावादगमच्छब्दो महीं सागरमेखलाम् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2114449, "chapter_id": 3461, "verse_number": "१३", "content_sanskrit": "नास्त्यर्जुनसमः कश्चिदित्येवं मेनिरे जनाः ।\nअथाब्रवीत् तदा द्रोणः फल्गुनं जनसंसदि\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2114450, "chapter_id": 3461, "verse_number": "१४", "content_sanskrit": "अगस्त्यस्य धनुर्वेदे शिष्यो मम गुरुः सदा ।\nअग्निवेश्य इति ख्यातस्तस्य शिष्योऽस्मि भारत\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2114451, "chapter_id": 3461, "verse_number": "१५", "content_sanskrit": "तीर्थात् तीर्थगतं पार्थ मया सङ्क्रामितं त्वयि ।\nतपसेदं मया प्राप्तममोघमशनिप्रभम् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2114452, "chapter_id": 3461, "verse_number": "१६", "content_sanskrit": "अस्त्रं ब्रह्मशिरो नाम यद् दहेत् पृथिवीमपि ।\nददता चास्मि सन्दिष्टो न मनुष्येष्विदं त्वया\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2114453, "chapter_id": 3461, "verse_number": "१७", "content_sanskrit": "भारद्वाज प्रमोक्तव्यमस्त्रं संयुगमूर्धनि ।\nयद्यदन्तर्हितं भूतं किञ्चिद् युद्धे त्वया सह \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2114454, "chapter_id": 3461, "verse_number": "१८", "content_sanskrit": "महातेजस्तदेतेन हन्याः शस्त्रेण संयुगे ।\nअवाप्यं च त्वया वीर दिव्यं नान्यस्तदर्हति\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2114455, "chapter_id": 3461, "verse_number": "१९", "content_sanskrit": "युद्धे हि प्रतियोद्धव्यो युध्यमानेन संयुगे ।\nसमयश्च रक्ष्यो बलवान् ईदृशो हि विशाम्पते \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2114456, "chapter_id": 3461, "verse_number": "२०", "content_sanskrit": "आचार्यदक्षिणां देहि ज्ञातिग्रामस्य पश्यतः ।\nददामीति प्रतिज्ञाते फल्गुनेनाब्रवीद् गुरुः \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2114457, "chapter_id": 3461, "verse_number": "२१", "content_sanskrit": "युद्धे हि प्रतियोद्धव्यो युध्यमानोऽप्यहं रणे ।\nतत् तथेति प्रतिज्ञाय द्रोणाय कुरुपुङ्गवः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2114458, "chapter_id": 3461, "verse_number": "२२", "content_sanskrit": "उपसङ्गृह्य चरणौ युधिष्ठिरवशोऽभवत् ।\nउद्धवात् सकलां नीतिं भोजाद् बुद्धिमतां वरात् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2114459, "chapter_id": 3461, "verse_number": "२३", "content_sanskrit": "गदायुद्धेऽसियुद्धे च रथयुद्धे च भारत ।\nदिव्यमानुषसम्भूतान् अवापास्त्रविदां वरः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2114460, "chapter_id": 3461, "verse_number": "२४", "content_sanskrit": "सर्वांस्तथाऽखिलानस्त्रान् शस्त्राणि च तथा गुरोः ।\nसर्वां तामखिलां नीतिं पातालाधिपतेस्तथा\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2114461, "chapter_id": 3461, "verse_number": "२५", "content_sanskrit": "अस्त्रे शस्त्रे च शास्त्रे च रथानागाश्वकर्मणि ।\nअवाप्य सहदेवोऽपि भ्रातॄणामचरद् वशे\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2114462, "chapter_id": 3461, "verse_number": "२६", "content_sanskrit": "द्रोणेनैवं विनीतश्च भ्रातॄणां नकुलः प्रियः ।\nचित्रयोधी समाज्ञातो बभूवास्त्रविशारदः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2114463, "chapter_id": 3461, "verse_number": "२७", "content_sanskrit": "त्रिवर्षकृतयत्नैस्तु गान्धाराणामुपप्लवे ।\nअर्जुनप्रमुखैः पार्थैः सौवीराः समरे हताः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2114464, "chapter_id": 3461, "verse_number": "२८", "content_sanskrit": "न शशाक वशे कर्तुं यं पाण्डुरपि वीर्यवान् ।\nसोऽर्जुनेन वशं नीतो स राजा यवनाधिपः \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2114465, "chapter_id": 3461, "verse_number": "२९", "content_sanskrit": "अतीव बलसम्मत्तस्त्वतिमानी कुरून् प्रति ।\nकुन्तलो नाम सौवीरो दान्तः पार्थेन धीमता\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2114466, "chapter_id": 3461, "verse_number": "३०", "content_sanskrit": "दन्तवक्रेति विख्यातं पुरं पार्थस्य तेजसा ।\nसुमित्रं नाम सौवीरमर्जुनोऽदमयन्मृधे \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2114467, "chapter_id": 3461, "verse_number": "३१", "content_sanskrit": "भीमसेनसहायश्च सरथो मरुधन्वसु ।\nप्रतीच्यां समरे राजन् जिगाय भरतर्षभः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2114468, "chapter_id": 3461, "verse_number": "३२", "content_sanskrit": "अर्जुनः समरे प्राच्यान् सर्वानेकरथोऽजयत् ।\nतथैवैकरथो भूत्वा दाक्षिणात्यान् नराधिपान् \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2114469, "chapter_id": 3461, "verse_number": "३३", "content_sanskrit": "धनौघं प्रापयामास कुरुराष्ट्रं धनञ्जयः ।\nअतः पञ्चदशे वर्षे सर्वमेतच्चकार सः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2114470, "chapter_id": 3461, "verse_number": "३४", "content_sanskrit": "तं दृष्ट्वा धार्तराष्ट्राणां ततो भयमजायत ।\nस सर्वान् धृतराष्ट्रस्य पुत्रान् विप्रचकार ह \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2114471, "chapter_id": 3461, "verse_number": "३५", "content_sanskrit": "भीमसेनो महाबाहुर्बलाद् बलवतां वरः ।\nअदुष्टभावं तं दोषैर्जगृहुर्दुष्टबुद्धयः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2114472, "chapter_id": 3461, "verse_number": "३६", "content_sanskrit": "धार्तराष्ट्रास्तथा सर्वे भयाद् भीमस्य कर्मणः ।\nतान् दृष्ट्वा कर्मभिः पार्थान् सर्वानहतलक्षणान् \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2114473, "chapter_id": 3461, "verse_number": "३७", "content_sanskrit": "बलाद् बाहुबलात् तेभ्यो बिभियुर्दुष्टबुद्धयः ।\nततो बलमभिख्यातं विज्ञाय दृढधन्विनाम् ।\nदूषितः सहसा भावो धृतराष्ट्रस्य पाण्डुषु\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2114474, "chapter_id": 3461, "verse_number": "१४०", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nचत्वारिंशत्यधिकशततमोऽध्यायः ॥१४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2114475, "chapter_id": 3461, "verse_number": "८८", "content_sanskrit": "॥ इति सम्भवपर्वणि अष्टाशीतितमोऽध्यायः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2114476, "chapter_id": 3461, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]