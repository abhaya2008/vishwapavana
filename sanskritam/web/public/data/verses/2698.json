[{"id": 2079737, "chapter_id": 2698, "verse_number": "१२-२०३-०x", "content_sanskrit": "मनुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2079738, "chapter_id": 2698, "verse_number": "१२-२०३-१", "content_sanskrit": "दुःखोपघाते शारीरे मानसे चाप्युपस्थिते।\nयस्मिन्न शक्यते कर्तुं यत्नस्तं नानुचिन्तयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2079739, "chapter_id": 2698, "verse_number": "१२-२०३-२", "content_sanskrit": "भैषज्यमेतद्दुःखस्य यदेतन्नानुचिन्तयेत्।\nचिन्त्यमानं हि चाभ्येति भूयश्चापि प्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2079740, "chapter_id": 2698, "verse_number": "१२-२०३-३", "content_sanskrit": "प्रज्ञया मानसं दुःखं हन्याच्छारीरमौषधैः।\nएतद्विज्ञानसामर्थ्यं न बालैः समतामियात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2079741, "chapter_id": 2698, "verse_number": "१२-२०३-४", "content_sanskrit": "अनित्यं यौवनं रूपं जीवितं द्रव्यसंचयः।\nआरोग्यं प्रियसंवासो गृध्येत्तत्र न पण्डितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2079742, "chapter_id": 2698, "verse_number": "१२-२०३-५", "content_sanskrit": "न जानपदिकं दुःखमेकः शोचितुमर्हति।\nअशोचन्प्रतिकुर्वीत यदि पश्येदुपक्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2079743, "chapter_id": 2698, "verse_number": "१२-२०३-६", "content_sanskrit": "सुखाद्बहुतरं दुःखं जीविते नास्ति संशयः।\nस्रिग्धस्य चेन्द्रियार्थेषु मोहान्मरणमप्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2079744, "chapter_id": 2698, "verse_number": "१२-२०३-७", "content_sanskrit": "परित्यजति यो दुःखं सुखं वाऽप्युभयं नरः।\nअभ्येति ब्रह्म सोत्यन्तं न ते शोचन्ति पण्डिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2079745, "chapter_id": 2698, "verse_number": "१२-२०३-८", "content_sanskrit": "दुःखमर्था हि युज्यन्ते पालने न च ते सुखम्।\nदुःखेन चाधिगम्यन्ते नाशमेषां न चिन्तयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2079746, "chapter_id": 2698, "verse_number": "१२-२०३-९", "content_sanskrit": "ज्ञानं ज्ञेयाभिर्निवृत्तं विद्धि ज्ञानगुणं मनः।\nप्रज्ञाकरणसंयुक्तं ततो बुद्धिः प्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2079747, "chapter_id": 2698, "verse_number": "१२-२०३-१०", "content_sanskrit": "यदा कर्मगुणोपेता बुद्धिर्मनसि वर्तते।\nतदा प्रज्ञायते ब्रह्म ध्यानयोगसमाधिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2079748, "chapter_id": 2698, "verse_number": "१२-२०३-११", "content_sanskrit": "सेयं गुणवती बुद्धिर्गुणेष्वेवाभिवर्तते।\nअपरादभिनिः स्रौति गिरेः शृङ्गादिवोदकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2079749, "chapter_id": 2698, "verse_number": "१२-२०३-१२", "content_sanskrit": "यदा निर्गुणमाप्नोति ध्यानं मनसि पूर्वजम्।\nतदा प्रज्ञायते ब्रह्म निकषं निकषे यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2079750, "chapter_id": 2698, "verse_number": "१२-२०३-१३", "content_sanskrit": "मनस्त्वसंहृतं बुद्ध्या हीन्द्रियार्थनिदर्शकम्।\nन समर्थं गुणापेक्षि निर्गुणस्य निदर्शने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2079751, "chapter_id": 2698, "verse_number": "१२-२०३-१४", "content_sanskrit": "सर्वाण्येतानि संवार्य द्वाराणि मनसि स्थितः।\nमनस्येकाग्रतां कृत्वा तत्परं प्रतिपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2079752, "chapter_id": 2698, "verse_number": "१२-२०३-१५", "content_sanskrit": "यथा महान्ति भूतानि निवर्तन्ते गुणक्षये।\nतथेन्द्रियाण्युपादाय बुद्धिर्मनसि वर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2079753, "chapter_id": 2698, "verse_number": "१२-२०३-१६", "content_sanskrit": "यदा मनसि सा बुद्धिर्वर्ततेऽन्तरचारिणी।\nव्यवसायगुणोपेता तदा संपद्यते मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2079754, "chapter_id": 2698, "verse_number": "१२-२०३-१७", "content_sanskrit": "गुणवद्भिर्गुणोपेतं यदा ध्यानगतं मनः।\nतदा सर्वान्गुणान्हित्वा निर्गुणं प्रतिपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2079755, "chapter_id": 2698, "verse_number": "१२-२०३-१८", "content_sanskrit": "अव्यक्तस्येह विज्ञाने नास्ति तुल्यं निदर्शनम्।\nयत्र नास्ति पदन्यासः कस्तं विषयमाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2079756, "chapter_id": 2698, "verse_number": "१२-२०३-१९", "content_sanskrit": "तपसा चानुमानेन गुणैर्जात्या श्रुतेन च।\nनिनीषेत्परमं ब्रह्म विशुद्धेनान्तरात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2079757, "chapter_id": 2698, "verse_number": "१२-२०३-२०", "content_sanskrit": "गुणहीनो हि तं मार्गं बहिः समनुवर्तते।\nगुणाभावात्प्रकृत्या वा निस्तर्क्यं ज्ञेयसंमितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2079758, "chapter_id": 2698, "verse_number": "१२-२०३-२१", "content_sanskrit": "नैर्गुण्याद्ब्रह्म चाप्नोति सगुणत्वान्निवर्तते।\nगुणप्रसारिणी बुद्धिर्हुताशन इवेन्धने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2079759, "chapter_id": 2698, "verse_number": "१२-२०३-२२", "content_sanskrit": "यदा पञ्च वियुक्तानि इन्द्रियाणि स्वकर्मभिः।\nतदा तत्परमं ब्रह्म संमुक्तं प्रकृतेः परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2079760, "chapter_id": 2698, "verse_number": "१२-२०३-२३", "content_sanskrit": "एवं प्रकृतितः सर्वे संभवन्ति शरीरिणः।\nनिवर्तन्ते निवृत्तौ च स्वर्गे नैवोपयान्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2079761, "chapter_id": 2698, "verse_number": "१२-२०३-२४", "content_sanskrit": "पुरुषप्रकृतिर्बुद्धिर्विशेषाश्चेन्द्रियाणि च।\nअहंकारोऽभिमानश्च संभूतो भूतसंज्ञकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2079762, "chapter_id": 2698, "verse_number": "१२-२०३-२५", "content_sanskrit": "एतस्याद्या प्रवृत्तिस्तु प्रधानात्संप्रवर्तते।\nद्वितीया मिथुनव्यक्तिमविशेषान्नियच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2079763, "chapter_id": 2698, "verse_number": "१२-२०३-२६", "content_sanskrit": "धर्मादुत्कृष्यते श्रेयस्तथा धर्मोऽष्यधर्मतः।\nरागवान्प्रकृतिं ह्येति विरक्तो ज्ञानवान्भवम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2079764, "chapter_id": 2698, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि त्र्यधिकद्विशततमोऽध्यायः॥ २०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]