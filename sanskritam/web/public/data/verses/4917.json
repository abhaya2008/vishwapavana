[{"id": 2184434, "chapter_id": 4917, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2184435, "chapter_id": 4917, "verse_number": "१", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nयथा दस्युः समर्यादः प्रेत्यभावे न नश्यति\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2184436, "chapter_id": 4917, "verse_number": "२", "content_sanskrit": "प्रहर्ता मतिमान् शूरः श्रुतवाननृशंसवान् ।\nरक्षन्नक्षयिणं धर्मं ब्रह्मण्यो गुरुपूजकः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2184437, "chapter_id": 4917, "verse_number": "३", "content_sanskrit": "निषाद्यां क्षत्रियाज्जातः क्षत्रधर्मानुपालकः ।\nकापव्यो नाम नैषादिर्दस्युत्वात् सिद्धिमाप्तवान्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2184438, "chapter_id": 4917, "verse_number": "४", "content_sanskrit": "अरण्ये सायं पूर्वाह्णे मृगयूथप्रकोपिता ।\nविधिज्ञो मृगजातीनां निपातानां च कोविदः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2184439, "chapter_id": 4917, "verse_number": "५", "content_sanskrit": "सर्वकाननदेशज्ञः पारियात्रचरः सदा ।\nधर्मज्ञः सर्वभूतानाममोघेषुर्दृढायुधः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2184440, "chapter_id": 4917, "verse_number": "६", "content_sanskrit": "अप्यनेकशताः सेना एक एव जिगाय सः ।\nस वृद्धावन्धपितरौ महारण्येऽभ्यपूजयत्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2184441, "chapter_id": 4917, "verse_number": "७", "content_sanskrit": "मधुमांसैर्मूलफलैरन्नैरुच्चावचैरपि ।\nसत्कृत्य भोजयामास सम्यक्परिचचार च\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2184442, "chapter_id": 4917, "verse_number": "८", "content_sanskrit": "आरण्यकान् प्रव्रजितान् ब्राह्मणान् परिपालयन् ।\nअपि तेभ्यो मृगान् हत्वा निनाय च महावने\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2184443, "chapter_id": 4917, "verse_number": "९", "content_sanskrit": "ये स्म न प्रतिगृह्णन्ति दस्युभोजनशङ्कया ।\nतेषामासाद्य गेहेषु काल्य एव स गच्छति\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2184444, "chapter_id": 4917, "verse_number": "१०", "content_sanskrit": "तं बहूनि सहस्राणि ग्रामणित्वेन वव्रिरे ।\nनिर्मर्यादानि दस्यूनां निरनुक्रोशकारिणाम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2184445, "chapter_id": 4917, "verse_number": "", "content_sanskrit": "दस्यवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2184446, "chapter_id": 4917, "verse_number": "११", "content_sanskrit": "मुहूर्तदेशकालज्ञ प्राज्ञ शीलदृढायुध ।\nग्रामणीर्भव नो मुख्यः सर्वेषामेव सम्मतः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2184447, "chapter_id": 4917, "verse_number": "", "content_sanskrit": "यथा यथा वक्ष्यसि नः करिष्यामस्तथा तथा ।\nपालयास्मान् यथान्यायं यथा माता यथा पिता\t॥१२ ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2184448, "chapter_id": 4917, "verse_number": "", "content_sanskrit": "कापव्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2184449, "chapter_id": 4917, "verse_number": "", "content_sanskrit": "मा वधीस्त्वं स्त्रियं भीरुं मा शिशुं मा तपस्विनम् ।\nनायुध्यमानो हन्तव्यो न च ग्राह्या बलात् स्त्रियः\t॥१३", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2184450, "chapter_id": 4917, "verse_number": "१४", "content_sanskrit": "सर्वथा स्त्री न हन्तव्या सर्वसत्त्वेषु युध्यता ।\nनित्यं गोब्राह्मणे स्वस्ति योद्धव्यं च तदर्थतः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2184451, "chapter_id": 4917, "verse_number": "१५", "content_sanskrit": "सस्यं च नापहन्तव्यं सीरविघ्नं च मा कृथाः ।\nपूज्यन्ते यत्र देवाश्च पितरोऽतिथयस्तथा\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2184452, "chapter_id": 4917, "verse_number": "१६", "content_sanskrit": "सर्वभूतेष्वपि च वै ब्राह्मणो मोक्षमर्हति ।\nकार्या चापचितिस्तेषां सर्वस्वेनापि या भवेत्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2184453, "chapter_id": 4917, "verse_number": "१७", "content_sanskrit": "यस्य ह्येते सम्प्रदुष्टा मन्त्रयन्ति पराभवम् ।\nन तस्य त्रिषु लोकेषु त्राता भवति कश्चन\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2184454, "chapter_id": 4917, "verse_number": "१८", "content_sanskrit": "यो ब्राह्मणान् परिभवेद् विनाशं वापि रोचयेत् ।\nसूर्योदय इवावश्यं ध्रुवं तस्य पराभवः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2184455, "chapter_id": 4917, "verse_number": "१९", "content_sanskrit": "इहैव फलमासीनः प्रत्याकाङ्क्षेत शक्तितः ।\nये ये नो न प्रदास्यन्ति तांस्तान् सेनाभियास्यति\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2184456, "chapter_id": 4917, "verse_number": "२०", "content_sanskrit": "शिष्ट्यर्थं विहितो दण्डो न वधार्थं विनिश्चयः ।\nये च शिष्टान् प्रबाधन्ते धर्मस्तेषां वधः स्मृतः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2184457, "chapter_id": 4917, "verse_number": "२१", "content_sanskrit": "ये हि राष्ट्रोपरोधेन वृद्धिं कुर्वन्ति केचन ।\nतदेव तेऽनु मीयन्ते कुणपं कृमयो यथा\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2184458, "chapter_id": 4917, "verse_number": "२२", "content_sanskrit": "ये पुनर्धर्मशास्त्रेण वर्तेरन्निह दस्यवः ।\nअप्यदस्यवो भूत्वा क्षिप्रं सिद्धिमवाप्नुयुः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2184459, "chapter_id": 4917, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2184460, "chapter_id": 4917, "verse_number": "२३", "content_sanskrit": "तत् सर्वमुपचक्रुस्ते कापव्यस्यानुशासनम् ।\nवृत्तिं च लेभिरे सर्वे पापेभ्यश्चाप्युपारमन्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2184461, "chapter_id": 4917, "verse_number": "२४", "content_sanskrit": "कापव्यः कर्मणा तेन महतीं सिद्धिमाप्तवान् ।\nसाधूनामाचरन्क्षेमं दस्यून् पापान्निवर्तयन्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2184462, "chapter_id": 4917, "verse_number": "२५", "content_sanskrit": "इदं कापव्यचरितं यो नित्य अनुकीर्तयेत् ।\nनारण्येभ्यः स भूतेभ्यो भयमार्छेत् कदाचन\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2184463, "chapter_id": 4917, "verse_number": "२६", "content_sanskrit": "भयं तस्य न मर्त्येभ्यो नामर्त्येभ्यः कथञ्चन ।\nअसतो नासतो राजन् स ह्यरण्येषु गोपिता\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2184464, "chapter_id": 4917, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि आपद्धर्मे पञ्चमोऽध्यायः ॥ ५ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]