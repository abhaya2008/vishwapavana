[{"id": 40018952, "chapter_id": 9300, "verse_number": "1", "content_sanskrit": "भ्रातरंनिहतंदृष्टवाशयानंनिर्जितंरणे । शोकवेगपरीतात्माविललापविभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40018953, "chapter_id": 9300, "verse_number": "2", "content_sanskrit": "वीर विक्रान्त विख्यात प्रवीण नयकोविद । महार्हाशयनोपेतकिंशेषेनिहतोभुवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40018954, "chapter_id": 9300, "verse_number": "3", "content_sanskrit": "विक्षिप्यदीर्घौनिश्चेष्टौभुजावङ्गभूषितौ । मुकुटेनापवृत्तेनभास्कराकारवर्चसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40018955, "chapter_id": 9300, "verse_number": "4", "content_sanskrit": "दंवीरसम्प्राप्तंयन्मयापूर्वमीरितम् । काममोहपरीतस्ययत्तन्नरुचितंतव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40018956, "chapter_id": 9300, "verse_number": "5", "content_sanskrit": "यन्नदर्पात्प्रहस्तोवानेन्द्रजिन्नापरेजनाः । न कुम्बकर्णोऽतिरथोनातिकायोनरान्तकः ॥ न स्वयंत्वममन्येथास्तस्योदर्कोऽयमागतः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40018957, "chapter_id": 9300, "verse_number": "6", "content_sanskrit": "गतस्सेतुस्सुनीतीनांगतोधर्मस्यविग्रहः ॥ गतस्सत्त्वस्यसङ्क्षेपःप्रस्तावानांगतिर्गता । आदित्यःपतितोभूमौमग्नस्तमसिचन्द्रमाः ॥ चित्रभानुःप्रशान्तार्चिर्व्यवसायोनिरुद्यमः । अस्मिन्निपतितेवीरे भूमौशस्त्रभृतांवरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40018958, "chapter_id": 9300, "verse_number": "7", "content_sanskrit": "गतस्सेतुस्सुनीतीनांगतोधर्मस्यविग्रहः ॥ गतस्सत्त्वस्यसङ्क्षेपःप्रस्तावानांगतिर्गता । आदित्यःपतितोभूमौमग्नस्तमसिचन्द्रमाः ॥ चित्रभानुःप्रशान्तार्चिर्व्यवसायोनिरुद्यमः । अस्मिन्निपतितेवीरे भूमौशस्त्रभृतांवरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40018959, "chapter_id": 9300, "verse_number": "8", "content_sanskrit": "गतस्सेतुस्सुनीतीनांगतोधर्मस्यविग्रहः ॥ गतस्सत्त्वस्यसङ्क्षेपःप्रस्तावानांगतिर्गता । आदित्यःपतितोभूमौमग्नस्तमसिचन्द्रमाः ॥ चित्रभानुःप्रशान्तार्चिर्व्यवसायोनिरुद्यमः । अस्मिन्निपतितेवीरे भूमौशस्त्रभृतांवरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40018960, "chapter_id": 9300, "verse_number": "9", "content_sanskrit": "किंशेषमिहलोकस्यगतसत्त्वस्यसम्प्रति । रणेराक्षसशार्दूलेप्रसुप्तइवपांसुषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40018961, "chapter_id": 9300, "verse_number": "10", "content_sanskrit": "धृतिप्रवालःप्रसह्याग्य्रपुष्पस्तपोबलश्शौर्यनिबद्धमूलः । रणेमहान्राक्षसराजवृक्षःसम्मर्दितोराघवमारुतेन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40018962, "chapter_id": 9300, "verse_number": "11", "content_sanskrit": "तेजोविषाणःकुलवंशवंशःकोपप्रसादापरगात्रहस्तः । इक्ष्वाकुसिंहावगृहीतदेहःसुप्तःक्षितौरावणगन्धहस्ती ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40018963, "chapter_id": 9300, "verse_number": "12", "content_sanskrit": "पराक्रमोत्साहविजृम्भितार्चिर्निःश्वासधूमस्स्वबलप्रतापः । प्रतापवान्सम्यतिराक्षसाग्निर्विर्वापितोरामपयोधरेण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40018964, "chapter_id": 9300, "verse_number": "13", "content_sanskrit": "सिंहरक्षलाङ्गूलककुद्विषाणःपराभिजिद्गन्धनगन्धहस्ती । रक्षोवृषश्चापलकर्णचक्षुःक्षितीश्वरव्याघ्रहतोऽवसन्नः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40018965, "chapter_id": 9300, "verse_number": "14", "content_sanskrit": "वदन्तंहेतुमद्वाक्यंपरिदृष्टार्थनिश्चयम् । रामःशोकसमाविष्टमित्युवाचविभीषणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40018966, "chapter_id": 9300, "verse_number": "15", "content_sanskrit": "नायंविनष्टोनिश्चेष्टस्समरेचण्डविक्रमः । अत्युन्नतमहोत्साहःपतितोऽयमशङ्कितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40018967, "chapter_id": 9300, "verse_number": "16", "content_sanskrit": "नैवंविनष्टाःशोच्यन्तेक्षत्रधर्मव्यवस्थिताः । वृधदिमाशंसमानायेनिपतन्तिरणाजिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40018968, "chapter_id": 9300, "verse_number": "17", "content_sanskrit": "येनसेन्द्रास्त्रयोलोकास्त्रासितायुधिधीमता । तस्मिन्कालसमायुक्ते न कालःपरिशोचितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40018969, "chapter_id": 9300, "verse_number": "18", "content_sanskrit": "नैकान्तविजयोयुद्धेभूतपूर्वःकदाचन । परैराहन्यतेवीरःपरान्वाहन्तिसंयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40018970, "chapter_id": 9300, "verse_number": "19", "content_sanskrit": "इयंहिपूर्वैस्सन्दिष्टागतिःक्षत्रियसम्मता । क्षत्रियोनिहतंसङ्ख्ये न शोच्यइतिनिश्चयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40018971, "chapter_id": 9300, "verse_number": "20", "content_sanskrit": "तदेवंनिश्चयंदृष्टवातत्त्वमास्थायविज्वरः । यदिहानन्तरंकार्यंकल्प्यंतदनुचिन्तय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40018972, "chapter_id": 9300, "verse_number": "21", "content_sanskrit": "मुक्तवाक्यंविक्रान्तंराजपुत्रंविभीषणः । उवाचशोकसन्तप्तोभ्रातुर्हितमनन्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40018973, "chapter_id": 9300, "verse_number": "22", "content_sanskrit": "योऽयंविमर्देष्वविभग्नपूर्वःसुरैस्समस्थेरपिवासवेन । भवन्तमासाद्यरणेविभग्नोवेलामिवासाद्ययथासमुद्रः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40018974, "chapter_id": 9300, "verse_number": "23", "content_sanskrit": "अनेनदत्तानिवनीपकेषुभुक्ताश्चभोगानिभृताश्चभृत्याः । धनानिमित्रेषुसमर्पितानिवैराण्यमित्रेषुनिपातितानि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40018975, "chapter_id": 9300, "verse_number": "24", "content_sanskrit": "एषोहिताग्निश्च:महातपाश्चवेदान्तगःकर्मसुचाग्य्रशूरः । एतस्ययत्प्रेतगतस्यकृत्यंतत्कर्तुमिच्छामितवप्रसादात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]