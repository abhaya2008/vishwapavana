[{"id": 2139965, "chapter_id": 4022, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2139966, "chapter_id": 4022, "verse_number": "१", "content_sanskrit": "अथाऽब्रवीत् सभामध्ये द्रोणः सूक्ष्मार्थदर्शिवान्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2139967, "chapter_id": 4022, "verse_number": "२", "content_sanskrit": "न तादृशा विनश्यन्ति नापि यान्ति पराभवम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2139968, "chapter_id": 4022, "verse_number": "३", "content_sanskrit": "शूराः सुकृतविद्याश्च बुद्धिमन्तो जितेन्द्रियाः ।\nधर्मज्ञाः सत्यसन्धाश्च युधिष्ठिरमनुव्रताः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2139969, "chapter_id": 4022, "verse_number": "४", "content_sanskrit": "नीतिधर्मार्थतत्वज्ञं पितृवच्च समाहितम् ।\nधर्मे स्थितं सत्यधृतिं ज्येष्ठं श्रेष्ठापचायिनम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2139970, "chapter_id": 4022, "verse_number": "५", "content_sanskrit": "अनुव्रता महात्मानो भ्रातरो भ्रातरं प्रियम् ।\nअजातशत्रुं दुर्धर्षं स तानपि तथाऽनुजान्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2139971, "chapter_id": 4022, "verse_number": "६", "content_sanskrit": "तेषां तथा विधेयानां निभृतानां महात्मनाम् ।\nकिमर्थं नीतिमान् प्राज्ञो निःश्रेयो न करिष्यति\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2139972, "chapter_id": 4022, "verse_number": "७", "content_sanskrit": "तस्माद् यत्नात् परीक्षध्वं न तावत् समयो गतः ।\nन ते विनाशमृच्छेयुरिति मे नैष्ठिकी मतिः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2139973, "chapter_id": 4022, "verse_number": "८", "content_sanskrit": "चिन्त्यतां चैव यत् कार्यं तच्च क्षिप्रमकालिकम् ।\nक्रियतां साधु निश्चित्य वासश्चैषां विचिन्त्यताम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2139974, "chapter_id": 4022, "verse_number": "९", "content_sanskrit": "यथा च पाण्डुपुत्राणां सर्वार्थेषु हितात्मनाम् ।\nप्रवृत्तिरुपलभ्येत तथा नीतिर्विधीयताम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2139975, "chapter_id": 4022, "verse_number": "१०", "content_sanskrit": "सर्वोपायैर्यतस्व त्वं यथा पश्यसि पाण्डवान् ।\nदुर्ज्ञेयाः खलु ते वीरा रक्ष्या नित्यं च दैवतैः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2139976, "chapter_id": 4022, "verse_number": "११", "content_sanskrit": "शुद्धात्मा ज्ञानवान् पार्थः सत्यवान् नीतिमान् शुचिः ।\nतेजोराशिभिरापूर्णो दहेदपि च चक्षुषा\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2139977, "chapter_id": 4022, "verse_number": "१२", "content_sanskrit": "तस्माद् यत्नश्च क्रियतां भूयश्च मृगयामहे ।\nब्राह्मणैश्चारपुरुषैः सिद्धैस्तापसनैपुणैः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2139978, "chapter_id": 4022, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2139979, "chapter_id": 4022, "verse_number": "१३", "content_sanskrit": "ततः शान्तनवो धीमान् भारतानां पितामहः ।\nश्रुतवान् देशकालज्ञो नीतिमांश्च महामतिः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2139980, "chapter_id": 4022, "verse_number": "१४", "content_sanskrit": "तस्मिन्नुपरते वाक्ये आचार्यस्य महात्मनः ।\nअनन्तरमुवाचेदं वाक्यं हेत्वर्थसंहितम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2139981, "chapter_id": 4022, "verse_number": "१५", "content_sanskrit": "युधिष्ठिरे समासक्तां धर्मज्ञे धर्मसंवृताम् ।\nपाण्डवे नित्यमव्यग्रां गिरं भीष्मः समाददे\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2139982, "chapter_id": 4022, "verse_number": "१६", "content_sanskrit": "असत्सु दुर्लभां नित्यं सतां चाभिमतां सदा ।\nभीष्मस्त्वभ्यवदत् तत्र गिरं साधुभिरर्चिताम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2139983, "chapter_id": 4022, "verse_number": "१७", "content_sanskrit": "यथा नो ब्राह्मणोऽवादीद् आचार्यः सर्वधर्मवित् ।\nश्रुतशास्त्रोपसम्पन्ना नाशं नायान्ति पाण्डवाः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2139984, "chapter_id": 4022, "verse_number": "१८", "content_sanskrit": "सर्वलक्षणसम्पन्नाः साधुवृत्तसमन्विताः ।\nवृद्धानुशासने यत्ताः सत्यधर्मपरायणाः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2139985, "chapter_id": 4022, "verse_number": "१९", "content_sanskrit": "समयं समयज्ञास्ते पालयन्तः शुभव्रताः ।\nन विषीदन्ति ते पार्था उद्वहन्तः सतां धुरम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2139986, "chapter_id": 4022, "verse_number": "२०", "content_sanskrit": "क्षत्रधर्मरता नित्यं केशवानुगताः सदा ।\nप्रवीरपुरुषास्ते वै महात्मानो महाव्रताः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2139987, "chapter_id": 4022, "verse_number": "२१", "content_sanskrit": "तपसा चैव गुप्तास्ते स्ववीर्येण च पाण्डवाः ।\nन नाशमधिगच्छेयुरिति मे नैष्ठिकी मतिः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2139988, "chapter_id": 4022, "verse_number": "२२", "content_sanskrit": "तत्र बुद्धिं प्रवक्ष्यामि पाण्डवान्वेषणे शृणु ।\nननु नीतिः सुनीतस्य शक्यते वेदितुं परैः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2139989, "chapter_id": 4022, "verse_number": "२३", "content_sanskrit": "यत्तु शक्यमिहास्माभिस्तान् वै सञ्चिन्त्य पाण्डवान् ।\nबुद्ध्या प्रणेतुं तद्वोऽहं प्रवक्ष्यामि निबोधत\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2139990, "chapter_id": 4022, "verse_number": "२४", "content_sanskrit": "न त्वियं साधु वक्तव्या तस्य नीतिः कथञ्चन ।\nवृद्धानुशासने तात तिष्ठतः सत्यवादिनः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2139991, "chapter_id": 4022, "verse_number": "२५", "content_sanskrit": "अयुक्तं तु मया वक्तुं तुल्या मे कुरुपाण्डवाः ।\nनिवासं पाण्डुपुत्राणां सञ्चिन्त्य च वदाम्यहम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2139992, "chapter_id": 4022, "verse_number": "२६", "content_sanskrit": "बहुना किं प्रलापेन यतो धर्मस्ततो जयः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2139993, "chapter_id": 4022, "verse_number": "२७", "content_sanskrit": "अवश्यं तु नियुक्तेन सभामध्ये विवक्षता ।\nयथामति विवेक्तव्यं सदृशं धर्मलिप्सया\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2139994, "chapter_id": 4022, "verse_number": "२८", "content_sanskrit": "तत्र नाहं तथा मन्ये यथाऽन्ये मेनिरे जनाः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2139995, "chapter_id": 4022, "verse_number": "२९", "content_sanskrit": "निवासं पाण्डुपुत्राणां शृणु त्वं मनुजाधिप ।\nपुरे जनपदे वाऽपि यत्र राजा युधिष्ठिरः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2139996, "chapter_id": 4022, "verse_number": "३०", "content_sanskrit": "नासूयको ना वाग्दुष्टो नाल्पभोग्यो न मत्सरी ।\nभविष्यति जनस्तत्र स्वयं धर्ममनुव्रतः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2139997, "chapter_id": 4022, "verse_number": "३१", "content_sanskrit": "दानशीलः क्षमायुक्तो निर्भृतो ह्रीनिषेधनः ।\nप्रियवाक् सत्यवाक् शूरो धर्मशीलो जितेन्द्रियः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2139998, "chapter_id": 4022, "verse_number": "३२", "content_sanskrit": "हृष्टस्तुष्टः शुचिर्दान्तो यत्र राजा युधिष्ठिरः ।\nपुरे जनपदे भव्यो यत्र राजा युधिष्ठिरः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2139999, "chapter_id": 4022, "verse_number": "३३", "content_sanskrit": "ब्रह्मघोषाश्च भूयांसः शब्दाः पुण्यास्तथैव च ।\nक्रतवश्च भविष्यन्ति भूयांसो भूरिदक्षिणाः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2140000, "chapter_id": 4022, "verse_number": "३४", "content_sanskrit": "सदा च तत्र पर्जन्यः सम्यग्वर्षी न संशयः ।\nसम्पन्नसस्या च मही भविष्यति निरीतिका\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2140001, "chapter_id": 4022, "verse_number": "३५", "content_sanskrit": "गुणवन्ति च धान्यानि रसवन्ति फलानि च ।\nगन्धवन्ति च माल्यानि शुभशब्दा च भारती\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2140002, "chapter_id": 4022, "verse_number": "३६", "content_sanskrit": "वायुश्च सुखसंस्पर्शो यत्र राजा युधिष्ठिरः ।\nभयं च नाविशेत् तत्र निष्प्रतीपं च दर्शनम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2140003, "chapter_id": 4022, "verse_number": "३७", "content_sanskrit": "न रोगास्तत्र दृश्यन्ते नाधयो व्याधयो न च ।\nन चोरा नहि डम्भाश्च न च बाधा भवन्ति च\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2140004, "chapter_id": 4022, "verse_number": "३८", "content_sanskrit": "नाशक्ता न च दुष्टाश्च यत्र राजा युधिष्ठिरः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2140005, "chapter_id": 4022, "verse_number": "३९", "content_sanskrit": "बहुक्षीरदुघा गावः सुपुष्टाश्च सुदर्शनाः ।\nपयांसि दधिसर्पींषि रसवन्ति हितानि च\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2140006, "chapter_id": 4022, "verse_number": "४०", "content_sanskrit": "सलिलानि प्रसन्नानि सर्वे भावाश्च शोभनाः ।\nगुणवन्ति च पानानि भोज्यानि विविधानि च\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2140007, "chapter_id": 4022, "verse_number": "४१", "content_sanskrit": "तत्र राजन् भविष्यन्ति यत्र राजा युधिष्ठिरः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2140008, "chapter_id": 4022, "verse_number": "४२", "content_sanskrit": "रसाः स्पर्शाश्च गन्धाश्च शब्दाश्चापि गुणान्विताः ।\nदृश्यानि च प्रसन्नानि यत्र राजा युधिष्ठिरः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2140009, "chapter_id": 4022, "verse_number": "४३", "content_sanskrit": "धर्माश्च तत्र वै सन्ति सेविताश्च द्विजातिभिः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2140010, "chapter_id": 4022, "verse_number": "४४", "content_sanskrit": "स्वैःस्वैर्गुणैश्च संयुक्ताः तस्मिन् वर्षे त्रयोदशे ।\nदेशे तत्र भविष्यन्ति तात पाण्डवसंश्रिते\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2140011, "chapter_id": 4022, "verse_number": "४५", "content_sanskrit": "सम्प्रीतिमान् जनस्तत्र सन्तुष्टः शुचिरव्यथः ।\nदेवतातिथिपूजासु सर्वभूतानुरागवान्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2140012, "chapter_id": 4022, "verse_number": "४६", "content_sanskrit": "इष्टदाने महोत्साहा नित्यं धर्मपरायणाः ।\nव्यक्तवाक्यास्तथा तात शुभकल्याणमङ्गलाः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2140013, "chapter_id": 4022, "verse_number": "४७", "content_sanskrit": "अशुभद्विट् शुभप्रेप्सुरिष्टयज्ञः शुभव्रतः ।\nभविष्यति जनस्तत्र यत्र राजा युधिष्ठिरः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2140014, "chapter_id": 4022, "verse_number": "४८", "content_sanskrit": "नित्योत्सवप्रमुदितो नित्यहृष्टः श्रियान्वितः ।\nभविष्यति निवासोऽयं यत्र राजा युधिष्ठिरः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2140015, "chapter_id": 4022, "verse_number": "४९", "content_sanskrit": "धर्मात्मा स तु दुर्ज्ञेयः सर्वज्ञैश्च द्विजातिभिः ।\nकिं पुनः प्राकृतैः पार्थः शक्यो ज्ञातुं वने वसन्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2140016, "chapter_id": 4022, "verse_number": "५०", "content_sanskrit": "तस्मिन् सत्यं धृतिर्दाक्ष्यं परा शान्तिर्ध्रुवा क्षमा ।\nह्रीः श्रीः कीर्तिः परं तेज आनृशंस्यं तथाऽऽर्जवम्\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2140017, "chapter_id": 4022, "verse_number": "५१", "content_sanskrit": "तस्मान्निवासः पार्थानां चिन्त्यतां यद् ब्रवीमि वः ।\nगतिर्वा परमा तत्र नोत्सहे वक्तुमन्यथा\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2140018, "chapter_id": 4022, "verse_number": "५२", "content_sanskrit": "एवमेव तु सञ्चिन्त्य यत् कृत्यं साधु मन्यसे ।\nतत् क्षिप्रं कुरु कौरव्य यद्येतच्छ्रद्दधासि मे\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2140019, "chapter_id": 4022, "verse_number": "५३", "content_sanskrit": "कुलस्य हि क्षमं तात यदहं तद् ब्रवीमि ते\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2140020, "chapter_id": 4022, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां विराटपर्वणि त्रिंशोऽध्यायः ॥३०॥\nगोग्रहणपर्वणि तृतीयोऽध्यायः ॥३॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]