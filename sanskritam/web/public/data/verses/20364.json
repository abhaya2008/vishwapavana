[{"id": 7000364000, "chapter_id": 20364, "verse_number": "२-३६-१", "content_sanskrit": "सुनीथोवाच ।\nसत्यमुक्तं त्वया भद्रे एवमेतत्करोम्यहम् ।\nअनया विद्यया विप्रं मोहयिष्यामि नान्यथा॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000364001, "chapter_id": 20364, "verse_number": "२-३६-२", "content_sanskrit": "साहाय्यं देहि मे पुण्यं येन गच्छामि सांप्रतम् ।\nएवमुक्ता तया रंभा तामुवाच मनस्विनीम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000364002, "chapter_id": 20364, "verse_number": "२-३६-३", "content_sanskrit": "कीदृग्ददामि साहाय्यं तत्त्वं कथय भामिनि ।\nदूतत्वं गच्छ मे भद्रे एतं प्रति सुसांप्रतम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000364003, "chapter_id": 20364, "verse_number": "२-३६-४", "content_sanskrit": "एवमुक्तं तया तां तु रंभां प्रति सुलोचनाम् ।\nएवमेव प्रतिज्ञातं रंभया देवयोषिता॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000364004, "chapter_id": 20364, "verse_number": "२-३६-५", "content_sanskrit": "करिष्ये तव साहाय्यमादेशो मम दीयताम् ।\nसद्भावेन विशालाक्षी रूपयौवनशालिनी॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000364005, "chapter_id": 20364, "verse_number": "२-३६-६", "content_sanskrit": "मायया दिव्यरूपा सा संबभूव वरानना ।\nरूपेणाप्रतिमालोके मोहयंती जगत्त्रयम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000364006, "chapter_id": 20364, "verse_number": "२-३६-७", "content_sanskrit": "मेरोश्चैव महापुण्ये शिखरे चारुकंदरे ।\nनानाधातुसमाकीर्णे नानारत्नोपशोभिते॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000364007, "chapter_id": 20364, "verse_number": "२-३६-८", "content_sanskrit": "देववृक्षैः समाकीर्णे बहुपुष्पोपशोभिते ।\nदेववृंदसमाकीर्णे गंधर्वाप्सरसेविते॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000364008, "chapter_id": 20364, "verse_number": "२-३६-९", "content_sanskrit": "मनोहरे सुरम्ये च शीतच्छायासमाकुले ।\nचंदनानामशोकानां तरूणां चारुहासिनी॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000364009, "chapter_id": 20364, "verse_number": "२-३६-१०", "content_sanskrit": "दोलायां सा समारूढा सर्वशृङ्गारशोभिता ।\nकौशेयेन सुनीलेन राजमाना वरानना॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000364010, "chapter_id": 20364, "verse_number": "२-३६-११", "content_sanskrit": "बंधूकपुष्पवर्णेन कंचुकेन द्विजोत्तम ।\nसर्वांगसुंदरी बाला वीणातालकराविला॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000364011, "chapter_id": 20364, "verse_number": "२-३६-१२", "content_sanskrit": "गायमाना वरं गीतं सुस्वरं विश्वमोहनम् ।\nताभिः परिवृता बाला सखीभिः सुमनोहरा॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000364012, "chapter_id": 20364, "verse_number": "२-३६-१३", "content_sanskrit": "अंगस्तु कंदरे पुण्ये एकांते ध्यानमास्थितः ।\nकामक्रोधविहीनस्तु ध्यायमानो जनार्दनम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000364013, "chapter_id": 20364, "verse_number": "२-३६-१४", "content_sanskrit": "स श्रुत्वा सुस्वरं गीतं मधुरं सुमनोहरम् ।\nतालमानक्रियोपेतं सर्वसत्वविकर्षणम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000364014, "chapter_id": 20364, "verse_number": "२-३६-१५", "content_sanskrit": "ध्यानाच्चचाल तेजस्वी मायागीतेन मोहितः ।\nसमुत्थायासनात्तूर्णं वीक्षमाणो मुहुर्मुहुः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000364015, "chapter_id": 20364, "verse_number": "२-३६-१६", "content_sanskrit": "जगाम तत्र वेगेन मायाचलितमानसः ।\nदोलासंस्थां विलोक्यैव वीणादंडकराविलाम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000364016, "chapter_id": 20364, "verse_number": "२-३६-१७", "content_sanskrit": "हसमानां सुगायंतीं पूर्णचंद्रनिभाननाम् ।\nमोहितस्तेन गीतेन रूपेणापि महायशाः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000364017, "chapter_id": 20364, "verse_number": "२-३६-१८", "content_sanskrit": "तस्या लावण्यभावेन मन्मथस्य शराहतः ।\nआकुलव्याकुलज्ञान ऋषिपुत्रो द्विजोत्तमः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000364018, "chapter_id": 20364, "verse_number": "२-३६-१९", "content_sanskrit": "प्रलपत्यतिमोहेन जृंभते च पुनः पुनः ।\nस्वेदः कंपोथ संतापस्तस्याजायत तत्क्षणात्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000364019, "chapter_id": 20364, "verse_number": "२-३६-२०", "content_sanskrit": "मुह्यन्निव महामोहैर्ग्लानश्चलितमानसः ।\nवेपमानस्ततस्त्वंगो दूयमानः समागतः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000364020, "chapter_id": 20364, "verse_number": "२-३६-२१", "content_sanskrit": "तामालोक्य विशालाक्षीं मृत्युकन्यां यशस्विनीम् ।\nअथोवाच महात्मा स सुनीथां चारुहासिनीम्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000364021, "chapter_id": 20364, "verse_number": "२-३६-२२", "content_sanskrit": "का त्वं कस्य वरारोहे सखीभिः परिवारिता ।\nकेन कार्येण संप्राप्ता केन त्वं प्रेषिता वनम्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000364022, "chapter_id": 20364, "verse_number": "२-३६-२३", "content_sanskrit": "तवांगं सुंदरं सर्वमत्र भाति महावने ।\nसमाचक्ष्व ममाद्यैव प्रसादसुमुखी भव॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000364023, "chapter_id": 20364, "verse_number": "२-३६-२४", "content_sanskrit": "मायामोहेन संमुग्धस्तस्याः कर्म न विंदति ।\nमार्गणैर्मन्मथस्यापि परिविद्धो महामुनिः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000364024, "chapter_id": 20364, "verse_number": "२-३६-२५", "content_sanskrit": "एवंविधं महद्वाक्यं समाकर्ण्य महामतेः ।\nनोवाच किंचित्सा विप्रं समालोक्य सखीमुखम्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000364025, "chapter_id": 20364, "verse_number": "२-३६-२६", "content_sanskrit": "रंभां च प्रेरयामास सुनीथा संज्ञया सखीम् ।\nसमुवाच ततो रंभा सादरं तं द्विजं प्रति॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000364026, "chapter_id": 20364, "verse_number": "२-३६-२७", "content_sanskrit": "इयं कन्या महाभागा मृत्योश्चापि महात्मनः ।\nसुनीथाख्या प्रसिद्धेयं सर्वलक्षणसंपदा॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000364027, "chapter_id": 20364, "verse_number": "२-३६-२८", "content_sanskrit": "पतिमन्विच्छती बाला धर्मवंतं तपोनिधिम् ।\nशांतं दांतं महाप्राज्ञं वेदविद्याविशारदम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000364028, "chapter_id": 20364, "verse_number": "२-३६-२९", "content_sanskrit": "एवंविधं महद्वाक्यं समाकर्ण्य महामुनिः ।\nतामुवाच ततस्त्वंगो रंभामप्सरसां वराम्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000364029, "chapter_id": 20364, "verse_number": "२-३६-३०", "content_sanskrit": "मया चाराधितो विष्णुः सर्वविश्वमयो हरिः ।\nतेन दत्तो वरो मह्यं पुत्राख्यः सर्वसिद्धिदः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000364030, "chapter_id": 20364, "verse_number": "२-३६-३१", "content_sanskrit": "तन्निमित्तमहं भद्रे सुतार्थं नित्यमेव च ।\nकस्यचित्पुण्यवीर्यस्य कन्यामेकां प्रचिंतये॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000364031, "chapter_id": 20364, "verse_number": "२-३६-३२", "content_sanskrit": "सदैवाहं न पश्यामि सुभार्यां सत्यमीदृशीम् ।\nइयं धर्मस्य वै कन्या धर्माचारा वरानना॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000364032, "chapter_id": 20364, "verse_number": "२-३६-३३", "content_sanskrit": "मामेवं हि भजत्वेषा यदि कान्तमिहेच्छति ।\nयं यमिच्छेदियं बाला तं ददामि न संशयः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000364033, "chapter_id": 20364, "verse_number": "२-३६-३४", "content_sanskrit": "अदेयं देयमित्याह अस्याः संगमकारणात् ।\nएकमेवं त्वया देयं श्रूयतां द्विजसत्तम॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000364034, "chapter_id": 20364, "verse_number": "२-३६-३५", "content_sanskrit": "रंभोवाच ।\nविप्रेंद्र त्वं शृणुष्वेह प्रतिज्ञां वच्मि सांप्रतम् ।\nएषा नैव त्वया त्याज्या धर्मपत्नी तवैव हि॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000364035, "chapter_id": 20364, "verse_number": "२-३६-३६", "content_sanskrit": "अस्या दोषो गुणो नैव ग्राह्य एव त्वया कदा ।\nइत्यर्थे प्रत्ययं विप्र प्रत्यक्षं परिदर्शय॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000364036, "chapter_id": 20364, "verse_number": "२-३६-३७", "content_sanskrit": "स्वहस्तं देहि विप्रेंद्र सत्यप्रत्ययकारकम् ।\nएवमस्तु मया दत्तो ह्यस्या हस्तो न संशयः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000364037, "chapter_id": 20364, "verse_number": "२-३६-३८", "content_sanskrit": "सूत उवाच ।\nएवं संबधिकं कृत्वा सत्यप्रत्ययकारकम् ।\nगांधर्वेण विवाहेन सुनीथामुपयेमिवान्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000364038, "chapter_id": 20364, "verse_number": "२-३६-३९", "content_sanskrit": "तस्मै दत्वा सुनीथां तां रंभा हृष्टेन चेतसा ।\nसा तां चामंत्रयित्वा वै गता गेहं स्वकं पुनः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000364039, "chapter_id": 20364, "verse_number": "२-३६-४०", "content_sanskrit": "प्रहृष्टचेतसः सख्यः स्वस्थानं परिजग्मिरे ।\nगतासु तासु सर्वासु सखीषु द्विजसत्तमः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000364040, "chapter_id": 20364, "verse_number": "२-३६-४१", "content_sanskrit": "रेमे त्वंगस्तया सार्धं प्रियया भार्यया सह ।\nतस्यामुत्पाद्य तनयं सर्वलक्षणसंयुतम्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000364041, "chapter_id": 20364, "verse_number": "२-३६-४२", "content_sanskrit": "चकार नाम तस्यैव वेनाख्यं तनयस्य हि ।\nववृधे स महातेजाः सुनीथातनयस्तदा॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000364042, "chapter_id": 20364, "verse_number": "२-३६-४३", "content_sanskrit": "वेदशास्त्रमधीत्यैव धनुर्वेदं गुणान्वितम् ।\nसर्वासामपि मेधावी विद्यानां पारमेयिवान्॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000364043, "chapter_id": 20364, "verse_number": "२-३६-४४", "content_sanskrit": "अंगस्य तनयो वेनः शिष्टाचारेण वर्तते ।\nस वेनो ब्राह्मणश्रेष्ठः क्षत्त्राचारपरोऽभवत्॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000364044, "chapter_id": 20364, "verse_number": "२-३६-४५", "content_sanskrit": "दिवि चेंद्रो यथा भाति सर्वतेजःसमन्वितः ।\nभात्येवं तु महाप्राज्ञः स्वबलेन पराक्रमैः॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000364045, "chapter_id": 20364, "verse_number": "२-३६-४६", "content_sanskrit": "चाक्षुषस्यांतरे प्राप्ते वैवस्वतसमागते ।\nप्रजापालं विना लोके प्रजाः सीदंति सर्वदा॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000364046, "chapter_id": 20364, "verse_number": "२-३६-४७", "content_sanskrit": "ऋषयो धर्मतत्त्वज्ञाः प्रजाहेतोस्तपोधनाः ।\nव्यचिंतयन्महीपालं धर्मज्ञं सत्यपंडितम्॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000364047, "chapter_id": 20364, "verse_number": "२-३६-४८", "content_sanskrit": "तं वेनमेव ददृशुः संपन्नं लक्षणैर्युतम् ।\nप्राजापत्ये पदे पुण्ये अभ्यषिंचन्द्विजोत्तमाः॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000364048, "chapter_id": 20364, "verse_number": "२-३६-४९", "content_sanskrit": "अभिषिक्ते महाभागे त्वंगपुत्रे तदा नृपे ।\nते प्रजापतयः सर्वे जग्मुश्चैव तपोवनम्॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000364049, "chapter_id": 20364, "verse_number": "२-३६-५०", "content_sanskrit": "गतेषु तेषु सर्वेषु वेनो राज्यमकारयत् ।\nसूत उवाच ।\nसा सुनीथा सुतं दृष्ट्वा सर्वराज्यप्रसाधकम्॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000364050, "chapter_id": 20364, "verse_number": "२-३६-५१", "content_sanskrit": "विशंकते प्रभावेण शापात्तस्य महात्मनः ।\nमम पुत्रो महाभागो धर्मत्राता भविष्यति॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000364051, "chapter_id": 20364, "verse_number": "२-३६-५२", "content_sanskrit": "इत्येवं चिंतयेन्नित्यं पूर्वपापाद्विशंकिता ।\nधर्मांगानि सुपुण्यानि सुताग्रे परिदर्शयेत्॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000364052, "chapter_id": 20364, "verse_number": "२-३६-५३", "content_sanskrit": "सत्यभावादि कान्पुण्यान्गुणान्सा वै प्रकाशयेत् ।\nइत्युवाच सुतं सा हि अहं धर्मसुता सुत॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000364053, "chapter_id": 20364, "verse_number": "२-३६-५४", "content_sanskrit": "पिता ते धर्मतत्त्वज्ञस्तस्माद्धर्मं समाचर ।\nइत्येवं बोधयेन्नित्यं पुत्रं वेनं तदा सती॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000364054, "chapter_id": 20364, "verse_number": "२-३६-५५", "content_sanskrit": "मातापित्रोस्तयोर्वाक्यं प्रजायुक्तं प्रपालयेत् ।\nएवं वेनः प्रजापालः संजातःक्षितिमंडले॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000364055, "chapter_id": 20364, "verse_number": "२-३६-५६", "content_sanskrit": "सुखेन जीवते लोकःप्रजाधर्मेणरंजिताः ।\nएवं राज्यप्रभावं तु वेनस्यापि महात्मनः॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000364056, "chapter_id": 20364, "verse_number": "२-३६-५७", "content_sanskrit": "धर्मभावाः प्रवर्तंते तस्मिञ्छासति पार्थिवे॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]