[{"id": 7003939000, "chapter_id": 23939, "verse_number": "३-१-२-१", "content_sanskrit": "ऋषय ऊचुः ।\nकथं सूत महाभाग रामेणाक्लिष्टकर्मणा ।\nसेतुर्बद्धो नदीनाथे ह्यगाधे वरुणालये॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003939001, "chapter_id": 23939, "verse_number": "३-१-२-२", "content_sanskrit": "सेतौ च कति तीर्थानि गंधमादनपर्वते ।\nएतन्नः श्रद्दधानानां ब्रूहि पौराणिकोत्तम॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003939002, "chapter_id": 23939, "verse_number": "३-१-२-३", "content_sanskrit": "श्रीसूत उवाच ।\nरामेण हि यथासेतुर्निबद्धो वरुणालये ।\nतदहं संप्रवक्ष्यामि युष्माकं मुनिपुंगवाः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003939003, "chapter_id": 23939, "verse_number": "३-१-२-४", "content_sanskrit": "आज्ञया हि पितू रामो न्यवसद्दंडकानने ।\nसीतालक्ष्मणसंयुक्तः पंचवट्यां समाहितः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003939004, "chapter_id": 23939, "verse_number": "३-१-२-५", "content_sanskrit": "तस्मिन्निव सतस्तस्य राघवस्य महात्मनः ।\nरावणेन हृता भार्या मारीचच्छद्मना द्विजाः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003939005, "chapter_id": 23939, "verse_number": "३-१-२-६", "content_sanskrit": "मार्गमाणो वने भार्यां रामो दशरथात्मजः ।\nपंपातीरे जगा मासौ शोकमोहसमन्वितः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003939006, "chapter_id": 23939, "verse_number": "३-१-२-७", "content_sanskrit": "दृष्टवान्वानरं तत्र कंचिद्दशरथात्मजः ।\nवानरेणाथ पृष्टोऽयं को भवानिति राघवः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003939007, "chapter_id": 23939, "verse_number": "३-१-२-८", "content_sanskrit": "आदितः स्वस्य वृत्तांत्तं तस्मै प्रोवाच तत्त्वतः ।\nअथ राघवसंपृष्टो वानरः को भवानिति॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003939008, "chapter_id": 23939, "verse_number": "३-१-२-९", "content_sanskrit": "सोपि विज्ञापयामास राघवाय महात्मने ।\nअहं सुग्रीवसचिवो हनूमा न्नाम वानरः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003939009, "chapter_id": 23939, "verse_number": "३-१-२-१०", "content_sanskrit": "तेन च प्रेरितोऽभ्यागां युवाभ्यां सख्यमिच्छता ।\nआगच्छतं तद्भद्रं वां सुग्रीवांतिकमाशु वै॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003939010, "chapter_id": 23939, "verse_number": "३-१-२-११", "content_sanskrit": "तथास्त्विति स रामो पि तेन साकं मुनीश्वराः ।\nसुग्रीवांतिकमागप्य सख्यं चक्रेऽग्निसाक्षिकम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003939011, "chapter_id": 23939, "verse_number": "३-१-२-१२", "content_sanskrit": "प्रतिजज्ञेऽथ रामोऽपि तस्मै वालिवधं प्रति ।\nसुग्रीवश्चापि वै देह्याः पुनरानयनं द्विजाः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003939012, "chapter_id": 23939, "verse_number": "३-१-२-१३", "content_sanskrit": "इत्येवं समयं कृत्वा विश्वास्य च परस्परम् ।\nमुदा परमया युक्तौ नरेश्वरकपीश्वरौ॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003939013, "chapter_id": 23939, "verse_number": "३-१-२-१४", "content_sanskrit": "आसाते ब्राह्मणश्रेष्ठा ऋष्यमूकगिरौ तथा ।\nसुग्रीवप्रत्ययार्थं च दुंदुभेः कायमाशु वै॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003939014, "chapter_id": 23939, "verse_number": "३-१-२-१५", "content_sanskrit": "पादांगुष्ठेन चिक्षेप राघवो बहुयोजनम् ।\nसप्तताला विनिर्भिन्ना राघवेण महात्मना॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003939015, "chapter_id": 23939, "verse_number": "३-१-२-१६", "content_sanskrit": "ततः प्रीतमना वीरः सुग्रीवो राममब्रवीत् ।\nइंद्रादिदेवताभ्योऽपि नास्ति राघव मे भयम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003939016, "chapter_id": 23939, "verse_number": "३-१-२-१७", "content_sanskrit": "भवान्मित्रं मया लब्धो यस्मादति पराक्रमः ।\nअहं लंकेश्वरं हत्वा भार्यामानयितास्मि ते॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003939017, "chapter_id": 23939, "verse_number": "३-१-२-१८", "content_sanskrit": "ततः सुग्रीवसहितो रामचंद्रो महाबलः ।\nसलक्ष्मणो ययौ तूर्णं किष्किंधां वालिपालिताम्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003939018, "chapter_id": 23939, "verse_number": "३-१-२-१९", "content_sanskrit": "ततो जगर्ज सुग्रीवो वाल्यागमनकांक्षया ।\nअमृष्यमाणो वाली च गर्जितं स्वानुजस्य वै॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003939019, "chapter_id": 23939, "verse_number": "३-१-२-२०", "content_sanskrit": "अंतःपुराद्विनिष्क्रम्य युयुधेऽवरजेन सः ।\nवालिमुष्टिप्रहारेण ताडितो भृशविह्वलः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003939020, "chapter_id": 23939, "verse_number": "३-१-२-२१", "content_sanskrit": "सुग्रीवो निर्गतस्तूर्णं यत्र रामो महाबलः ।\nततो रामो महाबाहुस्सुग्रीवस्य शिरोधरे॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003939021, "chapter_id": 23939, "verse_number": "३-१-२-२२", "content_sanskrit": "लतामाबध्य चिह्नं तु युद्धायाचोदयत्तदा ।\nगर्जितेन समाहूय सुग्रीवो वालिनं पुनः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003939022, "chapter_id": 23939, "verse_number": "३-१-२-२३", "content_sanskrit": "रामप्रेरणया तेन बाहुयुद्धमथाकरोत् ।\nततो वालिनमाजघ्ने शरेणैकेन राघवः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003939023, "chapter_id": 23939, "verse_number": "३-१-२-२४", "content_sanskrit": "हते वालिनि सुग्रीवः किष्किंधां प्रत्यपद्यत ।\nततो वर्षास्वतीतासु सुग्रीवो वानराधिपः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003939024, "chapter_id": 23939, "verse_number": "३-१-२-२५", "content_sanskrit": "सीतामानयितुं तूर्णं वानराणां महाचमूम् ।\nसमादाय समागच्छदंतिकं नृपपुत्रयोः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003939025, "chapter_id": 23939, "verse_number": "३-१-२-२६", "content_sanskrit": "प्रस्थापयामास कपीन्सीतान्वेषणकांक्षया ।\nविदितायां तु वैदेह्या लंकायां वायुसूनुना॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003939026, "chapter_id": 23939, "verse_number": "३-१-२-२७", "content_sanskrit": "दत्ते चूडामणौ चापि राघवो हर्षशोकवान् ।\nसुग्रीवेणानुजेनापि वायुपुत्रेण धीमता॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003939027, "chapter_id": 23939, "verse_number": "३-१-२-२८", "content_sanskrit": "तथान्यैः कपिभिश्चैव जांबवन्नलमुख्यकैः ।\nअन्वीयमानो रामोऽसौ मुहूर्तेऽभिजिति द्विजाः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003939028, "chapter_id": 23939, "verse_number": "३-१-२-२९", "content_sanskrit": "विलंघ्य विविधा न्देशान्महेंद्रं पर्वतं ययौ ।\nचक्रतीर्थं ततो गत्वा निवासमकरोत्तदा॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003939029, "chapter_id": 23939, "verse_number": "३-१-२-३०", "content_sanskrit": "तत्रैव तु स धर्मात्मा समागच्छद्विभीषणः ।\nभ्राता वै राक्षसेंद्रस्य चतुर्भिः सचिवैः सह॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003939030, "chapter_id": 23939, "verse_number": "३-१-२-३१", "content_sanskrit": "प्रतिजग्राह रामस्तं स्वागतेन महात्मना ।\nसुग्रीवस्य तु शंकाऽभूत्प्रणिधिः स्यादयं त्विति॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003939031, "chapter_id": 23939, "verse_number": "३-१-२-३२", "content_sanskrit": "राघवस्तस्य चेष्टाभिः सम्यक्स्वचरितैर्हितैः ।\nअदुष्टमेनं दृष्ट्वैव तत एनमपूजयत्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003939032, "chapter_id": 23939, "verse_number": "३-१-२-३३", "content_sanskrit": "सर्वराक्षसराज्ये तमभ्यषिंचद्विभीषणम् ।\nचक्रे च मंत्रिप्रवरं सदृशं रविसूनुना॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003939033, "chapter_id": 23939, "verse_number": "३-१-२-३४", "content_sanskrit": "चक्रतीर्थं समासाद्य निवसद्रघुनंदनः ।\nचिंतयन्राघवः श्रीमान्सुग्रीवादीनभाषत॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003939034, "chapter_id": 23939, "verse_number": "३-१-२-३५", "content_sanskrit": "मध्ये वानरमु ख्यानां प्राप्तकालमिदं वचः ।\nउपायः को नु भवतामेतत्सागरलंघने॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003939035, "chapter_id": 23939, "verse_number": "३-१-२-३६", "content_sanskrit": "इयं च महती सेना सागरश्चापि दुस्तरः ।\nअंभोराशिरयं नीलश्चंचलोर्म्मिसमाकुलः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003939036, "chapter_id": 23939, "verse_number": "३-१-२-३७", "content_sanskrit": "उद्यन्मत्स्यो महानक्रशंखशुक्तिसमाकुलः ।\nक्वचिदौर्वानलाक्रांतः फेनवानतिभीषणः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003939037, "chapter_id": 23939, "verse_number": "३-१-२-३८", "content_sanskrit": "प्रकृष्टपवनाकृष्टनीलमेघसमन्वितः ।\nप्रलयांभोधरारावः सारवाननिलोद्धतः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003939038, "chapter_id": 23939, "verse_number": "३-१-२-३९", "content_sanskrit": "कथं सागरमक्षोभ्यं तरामो वरुणा लयम् ।\nसैन्यैः परिवृताः सर्वे वानराणां महौजसाम्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003939039, "chapter_id": 23939, "verse_number": "३-१-२-४०", "content_sanskrit": "उपायैरधिगच्छामो यथा नदनदीपतिम् ।\nकथं तरामः सहसा ससैन्या वरुणालयम्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003939040, "chapter_id": 23939, "verse_number": "३-१-२-४१", "content_sanskrit": "शतयोजनमायातं मनसापि दुरासदम् ।\nअतो नु विघ्ना बहवः कथं प्राप्या च मैथिली॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003939041, "chapter_id": 23939, "verse_number": "३-१-२-४२", "content_sanskrit": "कष्टात्कष्टतरं प्राप्ता वयमद्य निराश्रयाः ।\nमहाजले महावाते समुद्रे हि निराश्रये॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003939042, "chapter_id": 23939, "verse_number": "३-१-२-४३", "content_sanskrit": "उपायं कं विधास्यामस्तरणार्थं वनौकसाम् ।\nराज्याद्भ्रष्टो वनं प्राप्तो हृता सीता मृतः पिता॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003939043, "chapter_id": 23939, "verse_number": "३-१-२-४४", "content_sanskrit": "इतोऽपि दुःसहं दुःखं यत्सागरविलंघनम् ।\nधिग्धिग्गर्जितमंभोधे धिगेतां वारिराशिताम्॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003939044, "chapter_id": 23939, "verse_number": "३-१-२-४५", "content_sanskrit": "कथं तद्वचनं मिथ्या महर्षेः कुम्भजन्मनः ।\nहत्वा त्वं रावणं पापं पवित्रे गंधमादने ।\nपापोपशमनायाशु गच्छस्वेति यदीरितम्॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003939045, "chapter_id": 23939, "verse_number": "३-१-२-४६", "content_sanskrit": "श्रीसूत उवाच ।\nइति रामवचः श्रुत्वा सुग्रीवप्रमुखास्तदा॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003939046, "chapter_id": 23939, "verse_number": "३-१-२-४७", "content_sanskrit": "ऊचुः प्रांजलयः संर्मे राघवं तं महाबलम् ।\nनौभिरेनं तरिष्यामः प्लवैश्च विविधैरिति॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003939047, "chapter_id": 23939, "verse_number": "३-१-२-४८", "content_sanskrit": "मध्ये वानरकोटीनां तदोवाच विभीषणः ।\nसमुद्रं राघवो राजा शरणं गन्तुमर्हति॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003939048, "chapter_id": 23939, "verse_number": "३-१-२-४९", "content_sanskrit": "खनितः सागरैरेष समुद्रो वरुणालयः ।\nकर्तुमर्हति रामस्य तज्ज्ञातेः कार्यमंबुधिः॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003939049, "chapter_id": 23939, "verse_number": "३-१-२-५०", "content_sanskrit": "विभीषणेनैवमुक्तो राक्षसेन विपश्चिता ।\nसांत्वयन्राघवः सर्वान्वानरानिदमब्रवीत्॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003939050, "chapter_id": 23939, "verse_number": "३-१-२-५१", "content_sanskrit": "शतयोजन विस्तारमशक्ताः सर्ववानराः ।\nतर्तुं प्लवोडुपैरेनं समुद्रमतिभीषणम्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003939051, "chapter_id": 23939, "verse_number": "३-१-२-५२", "content_sanskrit": "नावो न संति सेनाया बह्व्या वानरपुंगवाः ।\nवणिजामुपघातं च कथमस्मद्विधश्चरेत्॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003939052, "chapter_id": 23939, "verse_number": "३-१-२-५३", "content_sanskrit": "विस्तीर्णं चैव नः सैन्यं हन्याच्छिद्रेषु वा परः ।\nप्लवोडुपप्रतारोऽतो नैवात्र मम रोचते॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003939053, "chapter_id": 23939, "verse_number": "३-१-२-५४", "content_sanskrit": "विभीषेणोक्तमे वेदं मोदते मम वानराः ।\nअहं त्विमं जलनिधिमुपास्ये मार्गसिद्धये॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003939054, "chapter_id": 23939, "verse_number": "३-१-२-५५", "content_sanskrit": "नो चेद्दर्शयिता मार्गं धक्ष्याम्येनमहं तदा ।\nमहास्त्रैरप्रतिहतैरत्यग्निपवनोज्ज्वलैः॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003939055, "chapter_id": 23939, "verse_number": "३-१-२-५६", "content_sanskrit": "इत्युक्त्वा सहसौमित्रिरुपस्पृश्याथ राघवः ।\nप्रतिशिश्ये जलनिधिं विधिवत्कुशसंस्तरे॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003939056, "chapter_id": 23939, "verse_number": "३-१-२-५७", "content_sanskrit": "तदा रामः कुशा स्तीर्णे तीरे नदनदीपतेः ।\nसंविवेश महाबाहुर्वेद्यामिव हुताशनः॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003939057, "chapter_id": 23939, "verse_number": "३-१-२-५८", "content_sanskrit": "शेषभोगनिभं बाहुमुपधाय रघूद्वहः ।\nदक्षिणो दक्षिणं बाहुमुपास्ते मकरालयम्॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003939058, "chapter_id": 23939, "verse_number": "३-१-२-५९", "content_sanskrit": "तस्य रामस्य सुप्तस्य कुशास्तीर्णे महीतले ।\nनियमादप्रमत्तस्य निशास्तिस्रोऽतिचक्रमुः॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003939059, "chapter_id": 23939, "verse_number": "३-१-२-६०", "content_sanskrit": "स त्रिरात्रोषितस्तत्र नयज्ञो धर्मतत्परः ।\nउपास्तेस्म तदा रामः सागरं मार्गसिद्धये॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003939060, "chapter_id": 23939, "verse_number": "३-१-२-६१", "content_sanskrit": "न च दर्शयते मन्दस्तदा रामस्य सागरः ।\nप्रयतेनापि रामेण यथार्हमपि पूजितः॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003939061, "chapter_id": 23939, "verse_number": "३-१-२-६२", "content_sanskrit": "तथापि सागरो रामं न दर्शयति चात्मनः ।\nसमुद्राय ततः क्रुद्धो रामो रक्तांतलोचनः॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003939062, "chapter_id": 23939, "verse_number": "३-१-२-६३", "content_sanskrit": "समीपवर्तिनं चेदं लक्ष्मणं प्रत्यभाषत ।\nअद्य मद्बाणनिर्भिन्नैर्मकरैर्वरुणालयम्॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003939063, "chapter_id": 23939, "verse_number": "३-१-२-६४", "content_sanskrit": "निरुद्धतोयं सौमित्रे करिष्यामि क्षणादहम् ।\nसशंखशुक्ताजालं हि समीनमकरं शनैः॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003939064, "chapter_id": 23939, "verse_number": "३-१-२-६५", "content_sanskrit": "अद्य बाणैरमोघास्त्रैर्वारिधिं परिशोषये ।\nक्षमया हि समायुक्तं मामयं मकरालयः॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003939065, "chapter_id": 23939, "verse_number": "३-१-२-६६", "content_sanskrit": "असमर्थं विजानाति धिक्क्षमामीदृशे जने ।\nन दर्शयति साम्ना मे सागरो रूपमात्मनः॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003939066, "chapter_id": 23939, "verse_number": "३-१-२-६७", "content_sanskrit": "चापमानय सौमित्रे शरांश्चाशीविषोपमान् ।\nसागरं शोषयिष्यामि पद्भ्यां यांतु प्लवंगमाः॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003939067, "chapter_id": 23939, "verse_number": "३-१-२-६८", "content_sanskrit": "एनं लंघितमर्यादं सहस्रोर्मिसमाकुलम् ।\nनिर्मर्यादं करिष्यामि सायकैर्वरुणालयम्॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003939068, "chapter_id": 23939, "verse_number": "३-१-२-६९", "content_sanskrit": "महार्णवं शोषयिष्ये महादानवसंकुलम् ।\nमहामकरनक्राढ्यं महावीचिसमाकुलम्॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003939069, "chapter_id": 23939, "verse_number": "३-१-२-७०", "content_sanskrit": "एवमुक्त्वा धनुष्पाणिः क्रोधपर्याकुलेक्षणः ।\nरामो बभूव दुर्धर्षस्त्रिपुरघ्नो यथा शिवः॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003939070, "chapter_id": 23939, "verse_number": "३-१-२-७१", "content_sanskrit": "आकृष्य चापं कोपेन कम्पयित्वा शरैर्जगत् ।\nमुमोच विशिखानुग्रांस्त्रिपुरेषु यथा भवः॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003939071, "chapter_id": 23939, "verse_number": "३-१-२-७२", "content_sanskrit": "दीप्ता बाणाश्च ये घोरा भासयन्तो दिशो दश ।\nप्राविशन्वारिधेस्तोयं दृप्तदानवसंकुलम्॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003939072, "chapter_id": 23939, "verse_number": "३-१-२-७३", "content_sanskrit": "समुद्रस्तु ततो भीतो वेपमानः कृतांजलिः ।\nअनन्यशरणो विप्राः पाता लात्स्वयमुत्थितः॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003939073, "chapter_id": 23939, "verse_number": "३-१-२-७४", "content_sanskrit": "शरणं राघवं भेजे कैवल्यपदकारणम् ।\nतुष्टाव राघवं विप्रा भूत्वा शब्दैर्मनोरमैः॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003939074, "chapter_id": 23939, "verse_number": "३-१-२-७५", "content_sanskrit": "समुद्र उवाच ।\nनमामि ते राघव पादपंकजं सीतापते सौख्यद पादसेवनात् ।\nनमामि ते गौतमदारमोक्षजं श्रीपादरेणुं सुरवृन्दसेव्यम्॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003939075, "chapter_id": 23939, "verse_number": "३-१-२-७६", "content_sanskrit": "सुन्दप्रियादेहविदारिणे नमो नमोस्तु ते कौशिकयागरक्षिणे ।\nनमो महादेवशरासभेदिने नमो नमो राक्षससंघनाशिने॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003939076, "chapter_id": 23939, "verse_number": "३-१-२-७७", "content_sanskrit": "रामराम नमस्यामि भक्तानामिष्टदायिनम् ।\nअवतीर्णो रघुकुले देवकार्यचिकीर्षया॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003939077, "chapter_id": 23939, "verse_number": "३-१-२-७८", "content_sanskrit": "नारायणमनाद्यंतं मोक्षदं शिवमच्युतम् ।\nरामराम महाबाहो रक्ष मां शरणागतम्॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003939078, "chapter_id": 23939, "verse_number": "३-१-२-७९", "content_sanskrit": "कोपं संहर राजेंद्र क्षमस्व करुणालय ।\nभूमिर्वातो वियच्चापो ज्योतींषि च रघूद्वह॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003939079, "chapter_id": 23939, "verse_number": "३-१-२-८०", "content_sanskrit": "यत्स्वभावानि सृष्टानि ब्रह्मणा परमेष्ठिना ।\nवर्तंते तत्स्वभा वानि स्वभावो मे ह्यगाधता॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003939080, "chapter_id": 23939, "verse_number": "३-१-२-८१", "content_sanskrit": "विकारस्तु भवेद्गाध एतत्सत्यं वदाम्यहम् ।\nलोभात्कामाद्भयाद्वापि रागाद्वापि रघूद्वह॥ ८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003939081, "chapter_id": 23939, "verse_number": "३-१-२-८२", "content_sanskrit": "न वंशजं गुणं हातुमुत्सहेयं कथंचन ।\nतत्करिष्ये च साहाय्यं सेनायास्तरणे तव॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003939082, "chapter_id": 23939, "verse_number": "३-१-२-८३", "content_sanskrit": "इत्युक्तवन्तं जलधिं रामोऽवादीन्नदीपतिम् ।\nससैन्योऽहं गमि ष्यामि लंकां रावणपालिताम्॥ ८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003939083, "chapter_id": 23939, "verse_number": "३-१-२-८४", "content_sanskrit": "तच्छोषमुपयाहि त्वं तरणार्थं ममाधुना ।\nइत्युक्तस्तं पुनः प्राह राघवं वरुणालयः॥ ८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003939084, "chapter_id": 23939, "verse_number": "३-१-२-८५", "content_sanskrit": "शृणुष्वाव हितो राम श्रुत्वा कर्तव्यमाचर ।\nयद्याज्ञया ते शुष्यामि ससैन्यस्य यियासतः॥ ८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003939085, "chapter_id": 23939, "verse_number": "३-१-२-८६", "content_sanskrit": "अन्येऽप्याज्ञापयिष्यंति मामेवं धनुषो बलात् ।\nउपायमन्यं वक्ष्यामि तरणार्थं बलस्य ते॥ ८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003939086, "chapter_id": 23939, "verse_number": "३-१-२-८७", "content_sanskrit": "अस्ति ह्यत्र नलोनाम वानरः शिल्पिसंमतः ।\nत्वष्टुः काकुत्स्थ तनयो बलवान्विश्वकर्मणः॥ ८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003939087, "chapter_id": 23939, "verse_number": "३-१-२-८८", "content_sanskrit": "स यत्काष्ठं तृणं वापि शिलां वा क्षेप्स्यते मयि ।\nसर्वं तद्धारयिष्यामि स ते सेतुर्भविष्यति॥ ८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003939088, "chapter_id": 23939, "verse_number": "३-१-२-८९", "content_sanskrit": "सेतुना तेन गच्छ त्वं लंकां रावणपालि ताम् ।\nउक्त्वेत्यंतर्हिते तस्मिन्रामो नलमुवाच ह॥ ८९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003939089, "chapter_id": 23939, "verse_number": "३-१-२-९०", "content_sanskrit": "कुरु सेतुं समुद्रे त्वं शक्तो ह्यसि महामते ।\nतदाऽब्रवीन्नलो वाक्यं रामं धर्मभृतां वरम्॥ ९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003939090, "chapter_id": 23939, "verse_number": "३-१-२-९१", "content_sanskrit": "अहं सेतुं विधास्यामि ह्यगाधे वरुणालये ।\nपित्रा दत्तवरश्चाहं सामर्थ्ये चापि तत्समः॥ ९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003939091, "chapter_id": 23939, "verse_number": "३-१-२-९२", "content_sanskrit": "मातुर्मम वरो दत्तो मन्दरे विश्वक र्मणा ।\nशिल्पकर्मणि मत्तुल्यो भविता ते सुतस्त्विति॥ ९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003939092, "chapter_id": 23939, "verse_number": "३-१-२-९३", "content_sanskrit": "पुत्रोऽहमौरसस्तस्य तुल्यो वै विश्वकर्मणा ।\nअद्यैव कामं बध्नंतु सेतुं वानरपुं गवाः॥ ९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003939093, "chapter_id": 23939, "verse_number": "३-१-२-९४", "content_sanskrit": "ततो रामनिसृष्टास्ते वानरा बलवत्तराः ।\nपर्वतान्गिरिशृंगाणि लतातृणमहीरुहान्॥ ९४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003939094, "chapter_id": 23939, "verse_number": "३-१-२-९५", "content_sanskrit": "समाजह्रुर्महाकाया गरुडानिलरंहसः ।\nनलश्चक्रे महासेर्तुमध्ये नदनदीपतेः॥ ९५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003939095, "chapter_id": 23939, "verse_number": "३-१-२-९६", "content_sanskrit": "दशयोजनविस्तीर्णं शतयोजनमायतम् ।\nजानकीरमणो रामः सेतुमेवमकारयत्॥ ९६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003939096, "chapter_id": 23939, "verse_number": "३-१-२-९७", "content_sanskrit": "नलेन वानरेन्द्रेण विश्वकर्मसुतेन वै ।\nतमेवं सेतुमासाद्य रामचन्द्रेण कारितम्॥ ९७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7003939097, "chapter_id": 23939, "verse_number": "३-१-२-९८", "content_sanskrit": "सर्वे पातकिनो मर्त्या मुच्यन्ते सर्वपातकैः ।\nव्रतदान तपोहोमैर्न तथा तुष्यते शिवः॥ ९८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7003939098, "chapter_id": 23939, "verse_number": "३-१-२-९९", "content_sanskrit": "सेतुमज्जनमात्रेण यथा तुष्यति शंकरः ।\nन तुल्यं विद्यते तेजोयथा सौरेण तेजसा॥ ९९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7003939099, "chapter_id": 23939, "verse_number": "३-१-२-१००", "content_sanskrit": "सेतुस्नानेन च तथा न तुल्यं विद्यते क्वचित् ।\nतत्सेतुमूलं लंकायां यत्ररामो यियासया॥ १०० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7003939100, "chapter_id": 23939, "verse_number": "३-१-२-१०१", "content_sanskrit": "वानरैः सेतुमारेभे पुण्यं पाप प्रणाशनम् ।\nतद्दर्भशयनं नाम्ना पश्चाल्लोकेषु विश्रुतम्॥ १०१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7003939101, "chapter_id": 23939, "verse_number": "३-१-२-१०२", "content_sanskrit": "एवमुक्तं मया विप्राः समुद्रे सेतुबंधनम् ।\nअत्र तीर्थान्यनेकानि संति पुण्यान्यनेकशः॥ १०२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7003939102, "chapter_id": 23939, "verse_number": "३-१-२-१०३", "content_sanskrit": "न संख्यां नामधेयं वा शेषो गणयितुं क्षमः ।\nकिं त्वहं प्रब्रवीम्यद्य तत्र तीर्थानि कानिचित्॥ १०३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7003939103, "chapter_id": 23939, "verse_number": "३-१-२-१०४", "content_sanskrit": "चतुर्विंशति तीर्थानि संति सेतौ प्रधानतः ।\nप्रथमं चकतीर्थं स्याद्वेतालवरदं ततः॥ १०४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7003939104, "chapter_id": 23939, "verse_number": "३-१-२-१०५", "content_sanskrit": "ततः पापविनाशार्थं तीर्थं लोकेषु विश्रुतम् ।\nततः सीतासरः पुण्यं ततो मंगलतीर्थकम्॥ १०५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7003939105, "chapter_id": 23939, "verse_number": "३-१-२-१०६", "content_sanskrit": "ततः सकलपापघ्नी नाम्ना चामृतवापिका ।\nब्रह्मकुण्डं ततस्तीर्थं ततः कुंडं हनूमतः॥ १०६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7003939106, "chapter_id": 23939, "verse_number": "३-१-२-१०७", "content_sanskrit": "आगस्त्यं हि ततस्तीर्थं रामतीर्थ मतः परम् ।\nततो लक्ष्मणतीर्थं स्याज्जटातीर्थमतः परम्॥ १०७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7003939107, "chapter_id": 23939, "verse_number": "३-१-२-१०८", "content_sanskrit": "ततो लक्ष्म्याः परं तीर्थमग्नितीर्थमतः परम् ।\nचक्रतीर्थं ततः पुण्यं शिवतीर्थमतः परम्॥ १०८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7003939108, "chapter_id": 23939, "verse_number": "३-१-२-१०९", "content_sanskrit": "ततः शंखाभिधं तीर्थं ततो यामुनतीर्थकम् ।\nगंगातीर्थं ततः पश्चाद्गयातीर्थमनन्तरम्॥ १०९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7003939109, "chapter_id": 23939, "verse_number": "३-१-२-११०", "content_sanskrit": "ततः स्यात्कोटितीर्थाख्यं साध्यानाममृतं ततः ।\nमानसाख्यं ततस्तीर्थं धनुष्कोटिस्ततः परम्॥ ११० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7003939110, "chapter_id": 23939, "verse_number": "३-१-२-१११", "content_sanskrit": "प्रधानतीर्थान्येतानि महापापहराणि च ।\nकथितानि द्विजश्रेष्ठास्सेतुमध्यगतानि वै॥ १११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7003939111, "chapter_id": 23939, "verse_number": "३-१-२-११२", "content_sanskrit": "यथा सेतुश्च बद्धोऽभूद्रामेण जलधौ महान् ।\nकथितं तच्च विप्रेन्द्राः पुण्यं पापहारं तथा॥ ११२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7003939112, "chapter_id": 23939, "verse_number": "३-१-२-११३", "content_sanskrit": "यच्छ्रुत्वा च पठित्वा च मुच्यते मानवो भुवि॥ ११३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7003939113, "chapter_id": 23939, "verse_number": "३-१-२-११४", "content_sanskrit": "अध्यायमेनं पठते मनुष्यः शृणोति वा भक्तियुतो द्विजेंद्राः ।\nसो नंतमाप्नोति जयं परत्र पुनर्भवक्लेशमसौ न गच्छेत्॥ ११४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}]