[{"id": 5000217000, "chapter_id": 9217, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे एकविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000217001, "chapter_id": 9217, "verse_number": "३-२१-१", "content_sanskrit": "स पुनः पतितां दृष्ट्वा क्रोधाच्छूर्पणखां पुनः।\nउवाच व्यक्तया वाचा तामनर्थार्थमागताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000217002, "chapter_id": 9217, "verse_number": "३-२१-२", "content_sanskrit": "मया त्विदानीं शूरास्ते राक्षसाः पिशिताशनाः।\nत्वत्प्रियार्थं विनिर्दिष्टाः किमर्थं रुद्यते पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000217003, "chapter_id": 9217, "verse_number": "३-२१-३", "content_sanskrit": "भक्ताश्चैवानुरक्ताश्च हिताश्च मम नित्यशः।\nहन्यमाना न हन्यन्ते न न कुर्युर्वचो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000217004, "chapter_id": 9217, "verse_number": "३-२१-४", "content_sanskrit": "किमेतच्छ्रोतुमिच्छामि कारणं यत्कृते पुनः।\nहा नाथेति विनर्दन्ती सर्पवच्चेष्टसे क्षितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000217005, "chapter_id": 9217, "verse_number": "३-२१-५", "content_sanskrit": "अनाथवद् विलपसि किं नु नाथे मयि स्थिते।\nउत्तिष्ठोत्तिष्ठ मा मैवं वैक्लव्यं त्यज्यतामिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000217006, "chapter_id": 9217, "verse_number": "३-२१-६", "content_sanskrit": "इत्येवमुक्ता दुर्धर्षा खरेण परिसान्त्विता।\nविमृज्य नयने सास्रे खरं भ्रातरमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000217007, "chapter_id": 9217, "verse_number": "३-२१-७", "content_sanskrit": "अस्मीदानीमहं प्राप्ता हतश्रवणनासिका।\nशोणितौघपरिक्लिन्ना त्वया च परिसान्त्विता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000217008, "chapter_id": 9217, "verse_number": "३-२१-८", "content_sanskrit": "प्रेषिताश्च त्वया शूरा राक्षसास्ते चतुर्दश।\nनिहन्तुं राघवं घोरं मत्प्रियार्थं सलक्ष्मणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000217009, "chapter_id": 9217, "verse_number": "३-२१-९", "content_sanskrit": "ते तु रामेण सामर्षाः शूलपट्टिशपाणयः।\nसमरे निहताः सर्वे सायकैर्मर्मभेदिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000217010, "chapter_id": 9217, "verse_number": "३-२१-१०", "content_sanskrit": "तान् भूमौ पतितान् दृष्ट्वा क्षणेनैव महाजवान्।\nरामस्य च महत्कर्म महांस्त्रासोऽभवन्मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000217011, "chapter_id": 9217, "verse_number": "३-२१-११", "content_sanskrit": "सास्मि भीता समुद्विग्ना विषण्णा च निशाचर।\nशरणं त्वां पुनः प्राप्ता सर्वतो भयदर्शिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000217012, "chapter_id": 9217, "verse_number": "३-२१-१२", "content_sanskrit": "विषादनक्राध्युषिते परित्रासोर्मिमालिनि।\nकिं मां न त्रायसे मग्नां विपुले शोकसागरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000217013, "chapter_id": 9217, "verse_number": "३-२१-१३", "content_sanskrit": "एते च निहता भूमौ रामेण निशितैः शरैः।\nये च मे पदवीं प्राप्ता राक्षसाः पिशिताशनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000217014, "chapter_id": 9217, "verse_number": "३-२१-१४", "content_sanskrit": "मयि ते यद्यनुक्रोशो यदि रक्षःसु तेषु च।\nरामेण यदि शक्तिस्ते तेजो वास्ति निशाचर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000217015, "chapter_id": 9217, "verse_number": "३-२१-१५", "content_sanskrit": "दण्डकारण्यनिलयं जहि राक्षसकण्टकम्।\nयदि रामममित्रघ्नं न त्वमद्य वधिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000217016, "chapter_id": 9217, "verse_number": "३-२१-१६", "content_sanskrit": "तव चैवाग्रतः प्राणांस्त्यक्ष्यामि निरपत्रपा।\nबुद्ध्याहमनुपश्यामि न त्वं रामस्य संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000217017, "chapter_id": 9217, "verse_number": "३-२१-१७", "content_sanskrit": "स्थातुं प्रतिमुखे शक्तः सबलोऽपि महारणे।\nशूरमानी न शूरस्त्वं मिथ्यारोपितविक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000217018, "chapter_id": 9217, "verse_number": "३-२१-१८", "content_sanskrit": "अपयाहि जनस्थानात् त्वरितः सहबान्धवः।\nजहि त्वं समरे मूढान्यथा तु कुलपांसन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000217019, "chapter_id": 9217, "verse_number": "३-२१-१९", "content_sanskrit": "मानुषौ तौ न शक्नोषि हन्तुं वै रामलक्ष्मणौ।\nनिःसत्त्वस्याल्पवीर्यस्य वासस्ते कीदृशस्त्विह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000217020, "chapter_id": 9217, "verse_number": "३-२१-२०", "content_sanskrit": "रामतेजोऽभिभूतो हि त्वं क्षिप्रं विनशिष्यसि।\nस हि तेजःसमायुक्तो रामो दशरथात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000217021, "chapter_id": 9217, "verse_number": "३-२१-२१", "content_sanskrit": "भ्राता चास्य महावीर्यो येन चास्मि विरूपिता।\nएवं विलप्य बहुशो राक्षसी प्रदरोदरी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000217022, "chapter_id": 9217, "verse_number": "३-२१-२२", "content_sanskrit": "भ्रातुः समीपे शोकार्ता नष्टसंज्ञा बभूव ह।\nकराभ्यामुदरं हत्वा रुरोद भृशदुःखिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000217023, "chapter_id": 9217, "verse_number": null, "content_sanskrit": "इति वाल्मीकि रामायणे आदि काव्ये अरण्यकाण्डे एकविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]