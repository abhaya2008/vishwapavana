 "display_order": 23}, {"id": 40015192, "chapter_id": 9217, "verse_number": "24", "content_sanskrit": "ततस्तेतंमहात्मानंचाराराक्षससत्तमम् । कृत्वाप्रदक्षिणंजग्मुर्यत्ररामस्सलक्ष्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40015193, "chapter_id": 9217, "verse_number": "25", "content_sanskrit": "तेसुवेलस्यशैलस्यसमीपेरामलक्ष्मणौ । प्रच्छन्नाददृशुर्गत्वाससुग्रीवविभीषणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40015194, "chapter_id": 9217, "verse_number": "26", "content_sanskrit": "प्रेक्षमाणाश्चमूंतांतुबभूवुर्भयविक्लबाः । तेतुधर्मात्मनादृष्टाराक्षसेन्द्रेणराक्षसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40015195, "chapter_id": 9217, "verse_number": "27", "content_sanskrit": "विभीषणेनतत्रस्थानिगृहीतायदृच्छया । शार्दूलोग्राहितस्त्वेकःपापोऽयमितिराक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40015196, "chapter_id": 9217, "verse_number": "28", "content_sanskrit": "मोचितस्सोऽपिरामेणवध्यमानःप्लवङ्गमैः । अनृशंस्येनरामेणमोचिताराक्षसाःपरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40015197, "chapter_id": 9217, "verse_number": "29", "content_sanskrit": "वानरैरर्दितास्तेतुविक्रान्तैर्लघुविक्रमैः । पुनर्लङ्कामनुप्राप्ताश्वसन्तोनष्टचेतसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]