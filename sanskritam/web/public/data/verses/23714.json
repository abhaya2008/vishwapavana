[{"id": 7003714000, "chapter_id": 23714, "verse_number": "१-४-२२-१", "content_sanskrit": "मार्कंडेय उवाच ।\nस्वामिन्नित्यशिवानन्द भगवन्नंदिकेश्वर ।\nआह्लादितोऽस्मि शोणेशमाहात्म्यसुधया त्वया ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003714001, "chapter_id": 23714, "verse_number": "१-४-२२-२", "content_sanskrit": "कथं वज्रांगदः पांड्यराजः शोणव्यतिक्रमम् ।\nचक्रे कथं तद्भक्त्यैव प्राप्तवान्संपदं पुनः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003714002, "chapter_id": 23714, "verse_number": "१-४-२२-३", "content_sanskrit": "कथं विद्याधराधीशौ कांतिशालिकलाधरौ ।\nदुर्वासःशापनिर्विद्धाववितौ शोणशंभुना ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003714003, "chapter_id": 23714, "verse_number": "१-४-२२-४", "content_sanskrit": "नंदिकेश्वर उवाच ।\nदीर्घायुष्यत्वसाफल्यं लब्धवांस्त्वं मृकण्डुज ।\nयदियं स्थेयसी भक्तिर्भवतो भूतनायके ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003714004, "chapter_id": 23714, "verse_number": "१-४-२२-५", "content_sanskrit": "वक्ष्ये वज्रांगदोदंतं वृत्तं विद्याभृतोरपि ।\nयतोऽभून्महितो लोके शोणाद्रीश्वरवैभवः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003714005, "chapter_id": 23714, "verse_number": "१-४-२२-६", "content_sanskrit": "आसीद्वज्रांगदोनाम पुरा पांड्येषु पार्थिवः ।\nआस्ते यस्य भुजस्तम्भे वसुधा सालभंजिका ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003714006, "chapter_id": 23714, "verse_number": "१-४-२२-७", "content_sanskrit": "धार्मिको न्यायविज्ज्ञाता गंभीरो दक्षिणम् क्षमः ।\nशांतो विनयवान्धीमानेकदारव्रतः कृती ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003714007, "chapter_id": 23714, "verse_number": "१-४-२२-८", "content_sanskrit": "शिवपूजार्चनरतः श्रीमाञ्छीलवतां वरः ।\nपृथ्वीमासेतुकेदाराच्छशास जितशात्रवः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003714008, "chapter_id": 23714, "verse_number": "१-४-२२-९", "content_sanskrit": "कदाचिन्मृगयाव्याजात्स चरन्सुतुरंगमः ।\nअरुणाचलपर्यंतं कांतारं समगाहत ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003714009, "chapter_id": 23714, "verse_number": "१-४-२२-१०", "content_sanskrit": "स तत्र बहलामोदं कंचित्कस्तूरिकामृगम् ।\nदृष्ट्वा तमन्वक्तुरगं प्रावर्तयत कौतुकात् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003714010, "chapter_id": 23714, "verse_number": "१-४-२२-११", "content_sanskrit": "स मृगोऽनुद्रुतस्तेन अभितः शोणपर्वतम् ।\nप्रादक्षिण्यात्परीयाय पपात च मनोजवः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003714011, "chapter_id": 23714, "verse_number": "१-४-२२-१२", "content_sanskrit": "ततः स भग्नसारोपि राजा जातश्रमश्चरन् ।\nपपात वाहाद्विच्छायः क्षीणपुण्य इव द्युतः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003714012, "chapter_id": 23714, "verse_number": "१-४-२२-१३", "content_sanskrit": "अज्ञातकारणेनैवं मातंगेनेव पीडितः ।\nनाज्ञासीत्क्षणमात्मानं राजा ग्रहगृहीतवत् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003714013, "chapter_id": 23714, "verse_number": "१-४-२२-१४", "content_sanskrit": "अचिंतयच्च कोयं मे निर्हेतुः सत्त्वविप्लवः ।\nक्व गतः स ह्यकस्मान्मे उपवाह्यस्तुरंगमः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003714014, "chapter_id": 23714, "verse_number": "१-४-२२-१५", "content_sanskrit": "इति चिंताकुले तस्मिंस्तज्ज्ञानेप्यपटीयसि ।\nतडित्तटजटालेव सहसा द्यौरदृश्यत ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003714015, "chapter_id": 23714, "verse_number": "१-४-२२-१६", "content_sanskrit": "निरीक्षमाण एवास्मिन्हित्वा तिर्यक्कलेवरम् ।\nतूर्णं तुरंगसारंगौ खेचरत्वमुपागतौ ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003714016, "chapter_id": 23714, "verse_number": "१-४-२२-१७", "content_sanskrit": "किरीटिनौ कुण्डलिनौ हारकेयूरधारिणौ ।\nक्षौमांतरीयोत्तरीयौ स्रग्विणौ च विरेजतुः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003714017, "chapter_id": 23714, "verse_number": "१-४-२२-१८", "content_sanskrit": "अवोचतां च नृपतिमाश्चर्याकृष्टमानसम् ।\nहरंताविव दन्तांशुजालैस्त्वस्यार्त्तिजं तमः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003714018, "chapter_id": 23714, "verse_number": "१-४-२२-१९", "content_sanskrit": "राजन्नलं विषादेन शोणाद्रीशप्रभावतः ।\nएतां जानीहि संजातां नवां नौ चेदृशी दशाम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003714019, "chapter_id": 23714, "verse_number": "१-४-२२-२०", "content_sanskrit": "तदोवाच तयोः किंचिदाश्वस्तैव पार्थिवः ।\nकृतांजलिरभाषिष्ट तावुभौ विनयान्वितः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003714020, "chapter_id": 23714, "verse_number": "१-४-२२-२१", "content_sanskrit": "कौ युवां निर्मितो याभ्यामभिषंगो ममेदृशः ।\nभद्रौ भणतमार्त्तानां त्राणं हि महतां गुणः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003714021, "chapter_id": 23714, "verse_number": "१-४-२२-२२", "content_sanskrit": "इति तेन कृते प्रश्ने तमुवाच कलाधरः ।\nराजानं जनिताश्चर्यं निर्दिष्टः कांतिशालिना ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003714022, "chapter_id": 23714, "verse_number": "१-४-२२-२३", "content_sanskrit": "अवेहि राजन्नावां हि पुराविद्याधरेश्वरौ ।\nपरस्परातिसौहार्दौ वसंतमदनाविव ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003714023, "chapter_id": 23714, "verse_number": "१-४-२२-२४", "content_sanskrit": "एकदा तु सुवर्णाद्रेः पार्श्वे दुर्वाससो मुनेः ।\nतपोवनमगच्छाव मनसोऽपि दुरासदम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003714024, "chapter_id": 23714, "verse_number": "१-४-२२-२५", "content_sanskrit": "क्रोशेद्धां तपसस्तस्य शिवाराधनसाधनीम् ।\nपुष्पोज्ज्वलामपश्याव पुण्यामारामवाटिकाम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003714025, "chapter_id": 23714, "verse_number": "१-४-२२-२६", "content_sanskrit": "विनीतावप्यसंजातौ तत्त्वोचितसुधीगणौ ।\nप्राविशाव तदुद्यानं प्रसूनावचयोत्सुकौ ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003714026, "chapter_id": 23714, "verse_number": "१-४-२२-२७", "content_sanskrit": "स्थलस्य तस्य सौहार्दात्कांतिशाल्यतिगर्वितः ।\nसंचचार मुहुः पादन्यासैराघट्टयन्महीम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003714027, "chapter_id": 23714, "verse_number": "१-४-२२-२८", "content_sanskrit": "अहं तु तत्र पुष्पाणां गंधातिशयमोहितः ।\nविकस्वरेषु पुष्पेषु न्यस्तहस्तो दुराशयः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003714028, "chapter_id": 23714, "verse_number": "१-४-२२-२९", "content_sanskrit": "ततः शांडिल्यमूलस्थो व्याघ्रचर्मासने स्थितः ।\nदुर्वासास्तपसां राशिर्ज्वलन्निव हुताशनः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003714029, "chapter_id": 23714, "verse_number": "१-४-२२-३०", "content_sanskrit": "अमर्षोत्कर्षनीरंध्रस्पंदमानाधरच्छदः ।\nकराल भृकुटीबंधसारालितविशालभूः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003714030, "chapter_id": 23714, "verse_number": "१-४-२२-३१", "content_sanskrit": "सरोषोऽभूत्तेजसाढ्यो घर्मदंतुरविग्रहः ।\nदहन्निव दृशा पश्यन्नभर्त्सयत नौ मुनिः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003714031, "chapter_id": 23714, "verse_number": "१-४-२२-३२", "content_sanskrit": "आः पापौ प्रच्युताचारौ कौ युवामतिगर्वितौ ।\nज्वलतः कोपवह्नेर्मे शलभत्वमुपागतौ ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003714032, "chapter_id": 23714, "verse_number": "१-४-२२-३३", "content_sanskrit": "तपोवनमिदं मत्कं पावनं भूतभावनम् ।\nपादैर्न स्पृशतः क्वापि सूर्याचंद्रमसावपि ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003714033, "chapter_id": 23714, "verse_number": "१-४-२२-३४", "content_sanskrit": "पुरवैरिसपर्यायाः पर्यायकमिदं वनम् ।\nन स्पंदतेऽत्र वातोपि न लिप्यंतेऽत्र षटपदाः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003714034, "chapter_id": 23714, "verse_number": "१-४-२२-३५", "content_sanskrit": "तदेतत्पादसंचारैर्दूषयन्नेष पातकी ।\nहयो भवतु भूलोके परवाह्यत्वपीडितः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003714035, "chapter_id": 23714, "verse_number": "१-४-२२-३६", "content_sanskrit": "अपरोप्ययमत्युग्रे पतत्वचलकंदरे ।\nप्रसूनगंधलोभाद्यो गंधसारंगतां गतः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003714036, "chapter_id": 23714, "verse_number": "१-४-२२-३७", "content_sanskrit": "इति तेनोग्ररोषेण शापवज्रे निपातिते ।\nतत्क्षणाद्विगलद्गर्वावावां तं शरणं गतौ ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003714037, "chapter_id": 23714, "verse_number": "१-४-२२-३८", "content_sanskrit": "अभिधाय च तं देवमाहितांघ्रिपरिग्रहैः ।\nअमोघ एष त्वच्छापस्तदस्यांतो निवेद्यताम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003714038, "chapter_id": 23714, "verse_number": "१-४-२२-३९", "content_sanskrit": "अथातिदीनमनसावावामालोक्य पार्थिव ।\nसानुग्रहोऽभून्मुनिराट् कारुण्यादतिशीतलः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003714039, "chapter_id": 23714, "verse_number": "१-४-२२-४०", "content_sanskrit": "अभाषत च मैवं भो भवतोः क्वापि दुर्धियोः ।\nशापस्य भविता शांतिररुणाद्रेः प्रदक्षिणात् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003714040, "chapter_id": 23714, "verse_number": "१-४-२२-४१", "content_sanskrit": "पुरा खलु पुरारातिरध्यतिष्ठच्छुभां सभाम् ।\nपर्युपास्यत दिक्पालैरिंद्रोपेंद्रयमादिभिः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003714041, "chapter_id": 23714, "verse_number": "१-४-२२-४२", "content_sanskrit": "तदा च देवदेवाय नंदनारण्यदेवता ।\nउपायनीकृतवती फलं किमपि पाटलम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003714042, "chapter_id": 23714, "verse_number": "१-४-२२-४३", "content_sanskrit": "बाल्यात्कुतूहलाक्रान्तौ गजाननषडाननौ ।\nपितरं तदयाचेतां लोभनीयतरं फलम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003714043, "chapter_id": 23714, "verse_number": "१-४-२२-४४", "content_sanskrit": "अथ ताववदद्देवस्तनयौ फलतर्षितौ ।\nगोपयित्वा फलं पाणिसंपुटेन कुमारकौ ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003714044, "chapter_id": 23714, "verse_number": "१-४-२२-४५", "content_sanskrit": "इमां समस्तां पृथिवीं लोकालोकेन वेष्टिताम् ।\nयो वां प्रदक्षिणीकर्तुमीष्टे तस्मै ददाम्यहम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003714045, "chapter_id": 23714, "verse_number": "१-४-२२-४६", "content_sanskrit": "इत्युक्ते पार्वतीशेन स्मयमानमुखेंदुना ।\nस्कंदः प्रदक्षिणीकर्तुं मेदिनीमुपचक्रमे ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003714046, "chapter_id": 23714, "verse_number": "१-४-२२-४७", "content_sanskrit": "लंबोदरस्तु देवस्य शोणशैलाकृतेः पितुः ।\nप्रदक्षिणं ततः कृत्वा पुरस्तादेव तत्क्षणात् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003714047, "chapter_id": 23714, "verse_number": "१-४-२२-४८", "content_sanskrit": "तद्दृष्ट्वा तस्य चातुर्यं हेरंबाय त्रियंवकः ।\nफलं वितीर्णवानस्मै प्रणयाघ्रातमस्तकः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003714048, "chapter_id": 23714, "verse_number": "१-४-२२-४९", "content_sanskrit": "अद्यप्रभृति सर्वेषां फलानामधिनायकः ।\nभवेत्यस्मै वरं दत्त्वा ह्येकदंताय शंकरः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003714049, "chapter_id": 23714, "verse_number": "१-४-२२-५०", "content_sanskrit": "बभाषे च सभास्तारान्सर्वानपि सुरासुरान् ।\nप्रसरद्दशनज्योत्स्नाकर्बुरीकृतमंदिरः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003714050, "chapter_id": 23714, "verse_number": "१-४-२२-५१", "content_sanskrit": "स्थावरोयं ममाकारः शोणाद्रिर्योऽस्य भक्तितः ।\nप्रदक्षिणां वितनुते स मे सारूप्यभाग्भवेत् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003714051, "chapter_id": 23714, "verse_number": "१-४-२२-५२", "content_sanskrit": "गिरेः प्रदक्षिणेनास्य यस्य धत्तः पदे रुजम् ।\nस सम्राट्सकलोत्कृष्टं लभते शाश्वतं पदम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003714052, "chapter_id": 23714, "verse_number": "१-४-२२-५३", "content_sanskrit": "इति शासनतः शंभोः शोणशैलप्रदक्षिणम् ।\nविधाय सर्वगीर्वाणा लेभिरे स्वं स्वमीप्सितम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003714053, "chapter_id": 23714, "verse_number": "१-४-२२-५४", "content_sanskrit": "युवामपि मदोद्भूतमालिन्यौ शिक्षितौ मया ।\nप्रदक्षिणेन शोणाद्रेः शापांतो वां भविष्यति ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003714054, "chapter_id": 23714, "verse_number": "१-४-२२-५५", "content_sanskrit": "तिरश्चोरपि वां सिध्येदरुणाद्रेः प्रदक्षिणा ।\nवज्रांगदस्य पांड्यस्य नृपतेरनुबंधतः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003714055, "chapter_id": 23714, "verse_number": "१-४-२२-५६", "content_sanskrit": "इत्यमर्षणमहर्षिमहाब्धेः शापहालहल शोषितगात्रौ ।\nपातितौ बहुलपातकभारात्क्षिप्रमश्वमृगजातिषु जातौ ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003714056, "chapter_id": 23714, "verse_number": "१-४-२२-५७", "content_sanskrit": "इति श्रीस्कान्दे महापुराण एकाशीतिसाहस्र्यां संहितायां प्रथमे माहेश्वरखण्डेऽरुणाचलमाहात्म्य उत्तरार्धे ऽरुणाचलप्रदक्षिणामाहात्म्ये वज्रांगद वृत्तांतवर्णनं नाम द्वाविंशतितमोऽध्यायः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]