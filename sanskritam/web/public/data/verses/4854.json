[{"id": 2181905, "chapter_id": 4854, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2181906, "chapter_id": 4854, "verse_number": "१", "content_sanskrit": "दण्डनीतिश्च राजा च समस्तौ तावुभावपि ।\nकस्य किं कुर्वतः सिद्ध्यै तन्मे ब्रूहि पितामह\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2181907, "chapter_id": 4854, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2181908, "chapter_id": 4854, "verse_number": "२", "content_sanskrit": "महाभाग्यं दण्डनीत्याः साध्यं शब्दैः सहेतुकैः ।\nशृणु मे शंसतो राजन् यथावदिह भारत\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2181909, "chapter_id": 4854, "verse_number": "३", "content_sanskrit": "दण्डनीतिः स्वधर्मेभ्यश्चातुर्वर्ण्यं नियच्छति ।\nप्रयुक्ता स्वामिनाऽसम्यगधर्मेभ्यश्च यच्छति\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2181910, "chapter_id": 4854, "verse_number": "४", "content_sanskrit": "चातुर्वर्ण्ये स्वधर्मस्थे मर्यादानामसङ्करे ।\nदण्डनीतिकृते क्षेमे प्रजानामकुतोभये\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2181911, "chapter_id": 4854, "verse_number": "५", "content_sanskrit": "सोमे प्रयत्नं कुर्वन्ति त्रयो वर्णा यथाविधि ।\nतस्माद् देवमनुष्याणां सुखं विद्धि समाहितम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2181912, "chapter_id": 4854, "verse_number": "६", "content_sanskrit": "कालो वा कारणं राज्ञो राजा वा कालकारणम् ।\nइति ते संशयो मा भूद् राजा कालस्य कारणम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2181913, "chapter_id": 4854, "verse_number": "७", "content_sanskrit": "दण्डनीत्या यदा राजा सम्यक् कार्त्स्न्येन वर्तते ।\nतदा कृतयुगं नाम कालः श्रेष्ठः प्रवर्तते\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2181914, "chapter_id": 4854, "verse_number": "८", "content_sanskrit": "भवेत् कृतयुगे धर्मो नाधर्मो विद्यते क्वचित् ।\nसर्वेषामेव वर्णानां नाधर्मे रमते मनः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2181915, "chapter_id": 4854, "verse_number": "९", "content_sanskrit": "योगक्षेमाः प्रवर्तन्ते प्रजानां नात्र संशयः ।\nवैदिकानि च कर्माणि भवन्त्यविगुणान्युत\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2181916, "chapter_id": 4854, "verse_number": "१०", "content_sanskrit": "ऋतवश्च सुखाः सर्वे भवन्त्युत निरामयाः ।\nप्रसीदन्ति नराणां च स्वरवर्णमनांसि च\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2181917, "chapter_id": 4854, "verse_number": "११", "content_sanskrit": "व्याधयो न भवन्त्यत्र नाल्पायुर्दृश्यते नरः ।\nविधवा न भवन्त्यत्र नृशंसो नाभिजायते\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2181918, "chapter_id": 4854, "verse_number": "१२", "content_sanskrit": "अकृष्टपच्या पृथिवी भवन्त्योषधयस्तथा ।\nत्वक्पत्रफलमूलानि वीर्यवन्ति भवन्ति च\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2181919, "chapter_id": 4854, "verse_number": "१३", "content_sanskrit": "नाधर्मो विद्यते तत्र धर्म एव तु केवलः ।\nइति कार्तयुगानेतान् गुणान् विद्धि युधिष्ठिर\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2181920, "chapter_id": 4854, "verse_number": "१४", "content_sanskrit": "दण्डनीत्या यदा राजा त्रीनंशाननुवर्तते ।\nचतुर्थमंशमुत्सृज्य तदा त्रेता प्रवर्तते\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2181921, "chapter_id": 4854, "verse_number": "१५", "content_sanskrit": "अधर्मस्य चतुर्थांशस्त्रीनंशाननुवर्तते ।\nकृष्टपच्यैव पृथिवी भवन्त्योषधयस्तथा\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2181922, "chapter_id": 4854, "verse_number": "१६", "content_sanskrit": "अर्धं त्यक्त्वा यदा राजा नीत्यर्धमनुवर्तते ।\nततस्तु द्वापरं नाम स कालः सम्प्रवर्तते\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2181923, "chapter_id": 4854, "verse_number": "१७", "content_sanskrit": "अशुभस्य तदा त्वर्धं द्वावंशावनुवर्तते ।\nकृष्टपच्यैव पृथिवी भवत्यल्पफला तथा\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2181924, "chapter_id": 4854, "verse_number": "१८", "content_sanskrit": "दण्डनीतिं परित्यज्य यदा कार्त्स्न्येन भूमिपः ।\nप्रजाः क्लिश्नात्ययोगेन प्रविश्यति तदा कलिः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2181925, "chapter_id": 4854, "verse_number": "१९", "content_sanskrit": "कलावधर्मो भूयिष्ठं धर्मो भवति तु क्वचित् ।\nसर्वेषामेव वर्णानां स्वधर्माच्च्यवते मनः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2181926, "chapter_id": 4854, "verse_number": "२०", "content_sanskrit": "शूद्रा भैक्षेण जीवन्ति ब्राह्मणाः परिचर्यया ।\nयोगक्षेमस्य नाशश्च वर्तते वर्णसङ्करः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2181927, "chapter_id": 4854, "verse_number": "२१", "content_sanskrit": "वैदिकानि च कर्माणि भवन्ति विगुणान्युत ।\nऋतवो नसुखाः सर्वे भवन्त्यामयिनस्तथा\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2181928, "chapter_id": 4854, "verse_number": "२२", "content_sanskrit": "ह्रसन्ति च मनुष्याणां स्वरवर्णमनांस्युत ।\nव्याधयश्च भवन्त्यत्र म्रियन्ते चाशतायुषः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2181929, "chapter_id": 4854, "verse_number": "२३", "content_sanskrit": "विधवाश्च भवन्त्यत्र नृशंसा जायते प्रजा ।\nक्वचिद् वर्षति पर्जन्यः क्वचित् सस्यं प्ररोहति\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2181930, "chapter_id": 4854, "verse_number": "२४", "content_sanskrit": "रसाः सर्वे क्षयं यान्ति यदा नेच्छति भूमिपः ।\nप्रजाः संरक्षितुं सम्यग् दण्डनीतिसमन्वितः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2181931, "chapter_id": 4854, "verse_number": "२५", "content_sanskrit": "राजा कृतयुगस्रष्टा त्रेताया द्वापरस्य च ।\nयुगस्य च चतुर्थस्य राजा भवति कारणम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2181932, "chapter_id": 4854, "verse_number": "२६", "content_sanskrit": "कृतस्य करणाद् राजा स्वर्गमत्यन्तमश्नुते ।\nत्रेतायाः करणाद् राजा स्वर्गं नात्यन्तमश्नुते\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2181933, "chapter_id": 4854, "verse_number": "२७", "content_sanskrit": "प्रवर्तनाद् द्वापरस्य यथाभागमुपाश्नुते ।\nकलेः प्रवर्तनाद् राजा पापमत्यन्तमश्नुते\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2181934, "chapter_id": 4854, "verse_number": "२८", "content_sanskrit": "ततो वसति दुष्कर्मा नरके शाश्वतीः समाः ।\nप्रजानां कल्मषे मग्नोऽकीर्तिं पापं च विन्दति\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2181935, "chapter_id": 4854, "verse_number": "२९", "content_sanskrit": "दण्डनीतिं पुरस्कृत्य क्षत्रियेण विजानता ।\nलिप्सितव्यमलब्धं च लब्धं रक्ष्यं च भारत\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2181936, "chapter_id": 4854, "verse_number": "३०", "content_sanskrit": "लोकस्य सीमन्तकरी मर्यादा लोकभावनी ।\nसम्यङ्नीता दण्डनीतिर्यथा माता यथा पिता\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2181937, "chapter_id": 4854, "verse_number": "३१", "content_sanskrit": "यस्यां भवन्ति भूतानि तद् विद्धि भरतर्षभ ।\nएष एव परो धर्मो यद्राजा दण्डनीतिमान्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2181938, "chapter_id": 4854, "verse_number": "३२", "content_sanskrit": "तस्मात् कौरव्य धर्मेण प्रजाः पालय नीतिमान् ।\nएवंवृत्तः प्रजा रक्षन् स्वर्गं जेतासि दुर्जयम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2181939, "chapter_id": 4854, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि राजधर्मे एकसप्ततितमोऽध्यायः ॥ ७१ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]