[{"id": 2081642, "chapter_id": 2731, "verse_number": "१२-२३५-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2081643, "chapter_id": 2731, "verse_number": "१२-२३६-१", "content_sanskrit": "किंशीलः किंसमाचारः किंविद्यः किंपराक्रमः।\nप्राप्नोति ब्रह्मणः स्थानं यत्परं प्रकृतेर्ध्रुवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2081644, "chapter_id": 2731, "verse_number": "१२-२३६-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2081645, "chapter_id": 2731, "verse_number": "१२-२३६-२", "content_sanskrit": "मोक्षधर्मेषु नियतो लध्वाहारो जितेन्द्रियः।\nप्राप्नोति ब्रह्मणः स्थानं तत्परं प्रकृतेर्ध्रुवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2081646, "chapter_id": 2731, "verse_number": "१२-२३६-३", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nजैगीषव्यस्य संवादमसितस्य च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2081647, "chapter_id": 2731, "verse_number": "१२-२३६-४", "content_sanskrit": "`महादेवान्तरे वृत्तं देव्याश्चैवान्तरे तथा।\nयथावच्छृणु राजेन्द्र ज्ञानदं पापनाशनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2081648, "chapter_id": 2731, "verse_number": "१२-२३६-५", "content_sanskrit": "जैगीषव्यं नहाप्रज्ञं धर्नाणामागतागमम्।\nअक्रुध्यन्तमहृष्यन्तमसितो देवलोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2081649, "chapter_id": 2731, "verse_number": "१२-२३६-६", "content_sanskrit": "न प्रीमसे बन्द्यमानो निन्द्यमानो न कुप्यसे।\nका ते प्रज्ञा कुतश्चैषा किं ते तस्याः परायणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2081650, "chapter_id": 2731, "verse_number": "१२-२३६-७x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2081651, "chapter_id": 2731, "verse_number": "१२-२३६-७", "content_sanskrit": "इति तेनानुयुक्तः स तमृपाच महातपाः।\nमहद्वाक्यप्रसंदिग्धं पुष्कलार्थपदं शुचि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2081652, "chapter_id": 2731, "verse_number": "१२-२३६-८x", "content_sanskrit": "जैगीषव्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2081653, "chapter_id": 2731, "verse_number": "१२-२३६-८", "content_sanskrit": "या यतियौ परा निष्ठा या शान्तिः पुण्यकर्मणाम्।\nतां तेऽहं सं प्रवक्ष्यामि यां मां पृच्छसि वै द्विज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2081654, "chapter_id": 2731, "verse_number": "१२-२३६-९", "content_sanskrit": "निन्वत्सु वा सप्ता नित्यं प्रशंसत्सु च देवल।\nनिहवन्ति च ये तेषां समयं सुकृतं च यत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2081655, "chapter_id": 2731, "verse_number": "१२-२३६-१०", "content_sanskrit": "उक्ताश्च न विवक्ष्यन्ति वक्तारमहिते हितम्।\nप्रतिहन्तुं न चेच्छन्ति हन्तारं वै मनीषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2081656, "chapter_id": 2731, "verse_number": "१२-२३६-११", "content_sanskrit": "नाप्राप्तमनुशोचन्ति प्राप्तकालानि कुर्वते।\nन चातीतानि शोचन्ति न चैतान्प्रतिजानते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2081657, "chapter_id": 2731, "verse_number": "१२-२३६-१२", "content_sanskrit": "संप्राप्तानां च पूज्यानां कामादर्थेषु देवल।\nयथोपपत्तिं कुर्वन्ति शक्तिमन्तो धृतव्रताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2081658, "chapter_id": 2731, "verse_number": "१२-२३६-१३", "content_sanskrit": "पक्वविद्या महाप्राज्ञा जितक्रोधा जितेन्द्रियाः।\nमनसा कर्मणा वाचा नापराध्यन्ति कस्यचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2081659, "chapter_id": 2731, "verse_number": "१२-२३६-१४", "content_sanskrit": "अनीर्षवो न चोन्योन्यं विहिंसन्ति कदाचन।\nन च जातूपतप्यन्ते धीराः परसमृद्धिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2081660, "chapter_id": 2731, "verse_number": "१२-२३६-१५", "content_sanskrit": "निन्दाप्रशंसे चात्यर्थं न वदन्ति परस्य च।\nन च निन्दाप्रशंसाभ्यां विक्रियन्ते कदाचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2081661, "chapter_id": 2731, "verse_number": "१२-२३६-१६", "content_sanskrit": "सर्वतश्च प्रशान्ता ये सर्वभूतहिते रताः।\nन कुध्यन्ति स हृष्यन्ति नापराध्यन्ति कस्यचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2081662, "chapter_id": 2731, "verse_number": "१२-२३६-१७", "content_sanskrit": "विमुच्य हृदयग्रन्थिं चङ्कम्यन्ते यथासुखम्।\nन चैषां बान्धवाः सन्ति ये चान्येषां च बान्धवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2081663, "chapter_id": 2731, "verse_number": "१२-२३६-१८", "content_sanskrit": "अमित्राश्च न सन्त्येषां ये चामित्रा न कस्यचित्।\nय एवं कुर्वते मर्त्याः सुखं जीवन्ति सर्वदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2081664, "chapter_id": 2731, "verse_number": "१२-२३६-१९", "content_sanskrit": "ये धर्मं चानुरुध्यन्ते धर्मज्ञा द्विजसत्तमाः।\nये ह्यतो विच्युता मार्गात्ते हृष्यन्त्युद्विजन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2081665, "chapter_id": 2731, "verse_number": "१२-२३६-२०", "content_sanskrit": "आस्थितस्तमहं मार्गमसूयिष्यामि कं कथम्।\nनिन्द्यमानः प्रशस्तो वा हृष्येयं केन हेतुना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2081666, "chapter_id": 2731, "verse_number": "१२-२३६-२१", "content_sanskrit": "यद्यदिच्छन्ति तत्तस्मादधिगच्छन्ति मानवाः।\nन मे निन्दाप्रशंसाभ्यां ह्रासवृद्धी भविष्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2081667, "chapter_id": 2731, "verse_number": "१२-२३६-२२", "content_sanskrit": "अमृतस्येव संतृप्येदवमानस्य तत्त्ववित्।\nविषस्येवोद्विजेन्नित्यं संमानस्य विचक्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2081668, "chapter_id": 2731, "verse_number": "१२-२३६-२३", "content_sanskrit": "अवज्ञातः सुखं शेते इह चामुत्र चोभयोः।\nविमुक्तः सर्वपापेभ्यो योऽवमन्ता स बुध्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2081669, "chapter_id": 2731, "verse_number": "१२-२३६-२४", "content_sanskrit": "परां गतिं च ये केचित्प्रार्थयन्ति मनीषिणः।\nएतद्व्रतं समाश्रित्य सुखमेधन्ति ते जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2081670, "chapter_id": 2731, "verse_number": "१२-२३६-२५", "content_sanskrit": "सर्वतश्च समाहृत्य क्रतून्सर्वाञ्जितेन्द्रियः।\nप्राप्नोति ब्रह्मणः स्थानं यत्परं प्रकृतेर्ध्रुवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2081671, "chapter_id": 2731, "verse_number": "१२-२३६-२६", "content_sanskrit": "नास्य देवा न गन्धर्वा न पिशाचा न राक्षसाः।\nपदमन्ववरोहन्ति प्राप्तस्य परमां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2081672, "chapter_id": 2731, "verse_number": "१२-२३६-२७", "content_sanskrit": "`एतच्छ्रुत्वा मुनेस्तस्य वचनं देवलस्तथा।\nतदधीनो भवच्छिष्यः सर्वद्वन्द्वविनिष्ठितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2081673, "chapter_id": 2731, "verse_number": "१२-२३६-२८", "content_sanskrit": "अथान्यत्तु पुरावृतं जैगीषव्यस्य धीमतः।\nशृणु राजन्नवहितः सर्वज्ञानसमन्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2081674, "chapter_id": 2731, "verse_number": "१२-२३६-२९", "content_sanskrit": "यमाहुः सर्वलोकेशं सर्वलोकनमस्कृतम्।\nअष्टमूर्ति जगन्मूर्तिमिष्टसंधिविभूषितम्॥\nयं प्राप्ता न विषीदन्ति न शोचन्त्युद्विजन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2081675, "chapter_id": 2731, "verse_number": "१२-२३६-३०", "content_sanskrit": "यस्य स्वाभाविकी शक्तिरिदं विश्वं चराचरम्।\nयाति सज्जति सर्वात्मा स देवः परमेश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2081676, "chapter_id": 2731, "verse_number": "१२-२३६-३१", "content_sanskrit": "मेरोरुत्तरपूर्वे तु सर्वरत्नविभूषिते।\nअचिन्त्ये विमले स्थाने सर्वर्तुकुसुमान्विते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2081677, "chapter_id": 2731, "verse_number": "१२-२३६-३२", "content_sanskrit": "वृक्षैश्च शोभिते नित्यं दिव्यवायुसमीरिते।\nनानाभूतगणैर्युक्तः सर्वदेवनमस्कृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2081678, "chapter_id": 2731, "verse_number": "१२-२३६-३३", "content_sanskrit": "तत्र विद्याधरगणा गन्धर्वाप्सरसां गणाः।\nलोकपालाः समुद्राश्च नद्यः शैलाः सरांसि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2081679, "chapter_id": 2731, "verse_number": "१२-२३६-३४", "content_sanskrit": "ऋषयो वालखिल्याश्च यज्ञाः स्तोभाह्वयास्तथा।\nउपासांचक्रिरे देवं प्रजानां पतयस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2081680, "chapter_id": 2731, "verse_number": "१२-२३६-३५", "content_sanskrit": "तत्र रुद्रो महादेवो देव्या चैव सहोमया।\nआस्ते वृषध्वजः श्रीमान्सोमसूर्याग्निलोचनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2081681, "chapter_id": 2731, "verse_number": "१२-२३६-३६", "content_sanskrit": "तत्रैवं देवमालोक्य देवी धात्री विभावरी।\nउमा देवी परेशानमपृच्छद्विनयान्विता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2081682, "chapter_id": 2731, "verse_number": "१२-२३६-३७", "content_sanskrit": "अर्थः कोऽथार्थशक्तिः का भगवन्ब्रूहि मेऽर्थितः।\nतयैवं परिपृष्टोऽसौ प्राह देवो महेश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2081683, "chapter_id": 2731, "verse_number": "१२-२३६-३८", "content_sanskrit": "अर्थोऽहमर्थशक्तिस्त्वं भोक्ताऽहं भोज्यमेव च।\nरूपं विद्धि महाभागे प्रकृतिस्त्वं परो ह्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2081684, "chapter_id": 2731, "verse_number": "१२-२३६-३९", "content_sanskrit": "अहं विष्णुरहं ब्रह्मा ह्यहं यज्ञस्तथैव च।\nआवयोर्न च भेदोऽस्ति परमार्थस्ततोऽबले।\nतथापि विद्मस्ते भेदं किं मां त्वं परिपृच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2081685, "chapter_id": 2731, "verse_number": "१२-२३६-४०", "content_sanskrit": "एवमुक्ता ततः प्राह ह्यधिकं ह्येतयोर्वद।\nश्रेष्ठं वेद महादेव नम इत्येव भामिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2081686, "chapter_id": 2731, "verse_number": "१२-२३६-४१", "content_sanskrit": "तदन्तरे स्थितो विद्वान्वसुरूपो महामुनिः।\nजैगीषव्यः स्मयन्प्राह ह्यर्थ इत्येव नादयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2081687, "chapter_id": 2731, "verse_number": "१२-२३६-४२", "content_sanskrit": "श्रेष्ठोन्योऽस्मान्महीपिण्डा तल्लीना शक्तिरापरा।\nमुद्रिकादिविशेषेण विस्तृता संभृतेति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2081688, "chapter_id": 2731, "verse_number": "१२-२३६-४३", "content_sanskrit": "तच्छ्रुत्वा वचनं देवी कोसावित्यब्रवीद्रुषा।\nवाक्यमस्याद्य संभङ्क्त्वा प्रोक्तवानिति शंकरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2081689, "chapter_id": 2731, "verse_number": "१२-२३६-४४", "content_sanskrit": "तच्छ्रुत्वा निर्गतो धीमानाश्रमं स्वं महामुनिः।\nस्थानात्स्वर्गगणे विद्वान्योगैश्वर्यसमन्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2081690, "chapter_id": 2731, "verse_number": "१२-२३६-४५", "content_sanskrit": "ततः प्रहस्य भगवान्सर्वपापहरो हरः।\nप्राह देवीं प्रशान्तात्मा जैगीषव्यो महामुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2081691, "chapter_id": 2731, "verse_number": "१२-२३६-४६", "content_sanskrit": "भक्तो मम सखा चैव शिष्यश्चात्र महामुनिः।\nजैगीषव्य इति ख्यातः प्रोक्त्वासा निर्गतः शुभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2081692, "chapter_id": 2731, "verse_number": "१२-२३६-४७", "content_sanskrit": "तच्छ्रुत्वा साऽथ संक्रुद्धा न न्याय्यं तेन वै कृतम्।\nविकृताऽहं त्वया देव मुनिना च तथाकृता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2081693, "chapter_id": 2731, "verse_number": "१२-२३६-४८", "content_sanskrit": "अत*ज्ञादयदेवेश मध्ये प्राप्तं न तच्छ्रुतम्।\nतच्छ्रुत्वा भगवानाह महादेवः पिनाकधृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2081694, "chapter_id": 2731, "verse_number": "१२-२३६-४९", "content_sanskrit": "निरपेक्षो मुनिर्योगी मामुपाश्रित्य संस्थितः।\nनिर्द्वन्द्वः सततं धीमान्समरूपस्वभावधृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2081695, "chapter_id": 2731, "verse_number": "१२-२३६-५०", "content_sanskrit": "तस्मात्क्षमस्व तं देवि रक्षितव्यस्त्वया च सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2081696, "chapter_id": 2731, "verse_number": "१२-२३६-५१", "content_sanskrit": "इत्युक्ता प्राह सा देवी मुनेस्तस्य महात्मनः।\nनिराशत्वमहं द्रष्टुमिच्छाम्यन्तकनाशन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2081697, "chapter_id": 2731, "verse_number": "१२-२३६-५२", "content_sanskrit": "तथेति चोक्त्वा तां देवो वृषमारुह्य सत्वरम्।\nदेवगन्धर्वसङ्घैश्च स्तूयमानो जगत्पतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2081698, "chapter_id": 2731, "verse_number": "१२-२३६-५३", "content_sanskrit": "अजरामरशुद्धात्मा यत्रास्ते स महामुनिः।\nइतस्ततः समाहृत्य वीरसंघैर्महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2081699, "chapter_id": 2731, "verse_number": "१२-२३६-५४", "content_sanskrit": "देहप्रावरणार्थं वै संसरन्स तदा मुनिः।\nप्रत्युद्गम्य महादेवं यथार्हं प्रतिपूज्य च।\nपुनः स पूर्ववत्कथां सूच्या सूत्रेण सूचयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2081700, "chapter_id": 2731, "verse_number": "१२-२३६-५५", "content_sanskrit": "तमाह भगवाञ्शंभुः किं प्रदास्यामि ते मुने।\nवृणीष्व मत्तः सर्वं त्वं जैगीषव्य यदीच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2081701, "chapter_id": 2731, "verse_number": "१२-२३६-५६", "content_sanskrit": "नावलोकयमानस्तु देवदेवं महामुनिः।\nअनवाप्तं न पश्यामि त्वत्तो गोवृषभध्वज।\nकृतार्थः परिपूर्णोऽहं यत्ते कार्यं तु गम्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2081702, "chapter_id": 2731, "verse_number": "१२-२३६-५७", "content_sanskrit": "प्रहसंस्तु पुनः शर्वो वृणीष्वेति तमब्रवीत्।\nअवश्यं हि वरो प्रत्तः श्राव्यं वरमनुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2081703, "chapter_id": 2731, "verse_number": "१२-२३६-५८", "content_sanskrit": "जैगीषव्यस्तमाहेदं श्रोतव्यं च त्वया मम।\nसूचीमनु महादेव सूत्रं समनुगच्छतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2081704, "chapter_id": 2731, "verse_number": "१२-२३६-५९", "content_sanskrit": "ततः प्रहस्य भगवान्गौरीमालोक्य शङ्करः।\nस्वस्थानं प्रययौ हृष्टः सर्वदेवनमस्कृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2081705, "chapter_id": 2731, "verse_number": "१२-२३६-६०", "content_sanskrit": "एतत्ते कथितं राजन्यस्मात्त्वं परिपृच्छसि।\nनिर्द्वन्द्वा योगिनो नित्याः सर्वशस्ते स्वयंभुवः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2081706, "chapter_id": 2731, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि षट्त्रिंशदधिकद्विशंततमोऽध्यायः॥ २३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}]