[{"id": 2087782, "chapter_id": 2866, "verse_number": "१२-३७१-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2087783, "chapter_id": 2866, "verse_number": "१२-३७१-१", "content_sanskrit": "स पन्नगपतिस्तत्र प्रययौ ब्राह्मणं प्रति।\nतमेव मनसा ध्यायन्कार्यवत्तां विचारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2087784, "chapter_id": 2866, "verse_number": "१२-३७१-२", "content_sanskrit": "तमतिक्रम्य नागेन्द्रो मतिमान्स नरेश्वर।\nप्रोवाच मधुरं वाक्यं प्रकृत्या धर्मवत्सलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2087785, "chapter_id": 2866, "verse_number": "१२-३७१-३", "content_sanskrit": "भोभो क्षाम्याभिभाषए त्वां न रोषं कर्तुमर्हसि।\nइह त्वमभिसंप्राप्तः कस्यार्थे किं प्रयोजनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2087786, "chapter_id": 2866, "verse_number": "१२-३७१-४", "content_sanskrit": "आभिमुख्यादभिक्रम्य स्नेहात्पृच्छामि ते द्विज।\nविविक्ते गोमतीतीरे कं वा त्वं पर्युपाससे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2087787, "chapter_id": 2866, "verse_number": "१२-३७१-५x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2087788, "chapter_id": 2866, "verse_number": "१२-३७१-५", "content_sanskrit": "धर्मारण्यं हि मां विद्धि नागं द्रष्टुमिहागतम्।\nपद्मनाभं द्विजश्रेष्ठ तत्र मे कार्यमाहितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2087789, "chapter_id": 2866, "verse_number": "१२-३७१-६", "content_sanskrit": "तस्य चाहमसान्निध्ये श्रुतवानस्मि तं गतम्।\nस्वजनात्तं प्रतीक्षामि पर्जन्यमिव कर्षकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2087790, "chapter_id": 2866, "verse_number": "१२-३७१-७", "content_sanskrit": "तस्य चाक्लेशकरणं स्वस्तिकारसमाहितम्।\nआवर्तयामि तद्ब्रह्म योगयुक्तो निरामयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2087791, "chapter_id": 2866, "verse_number": "१२-३७१-८x", "content_sanskrit": "नाग उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2087792, "chapter_id": 2866, "verse_number": "१२-३७१-८", "content_sanskrit": "अहो कल्याणवृत्तस्त्वं साधुः सज्जनवत्सलः।\nअवाच्यस्त्वं महाभाग परं स्नेहेन पश्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2087793, "chapter_id": 2866, "verse_number": "१२-३७१-९", "content_sanskrit": "अहं स नागो विप्रर्षे यथा मां विन्दते भवान्।\nआज्ञापय यथास्वैरं किं करोमि प्रियं तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2087794, "chapter_id": 2866, "verse_number": "१२-३७१-१०", "content_sanskrit": "भवन्तं स्वजनादस्मि संप्राप्तं श्रुतवानहम्।\nअतस्त्वां स्वयमेवाहं द्रष्टुमभ्यागतो द्विज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2087795, "chapter_id": 2866, "verse_number": "१२-३७१-११", "content_sanskrit": "संप्राप्तश्च भवानद्य कृतार्थः प्रतियास्यति।\nविस्रब्धो मां द्विजश्रेष्ठ विषये योक्तमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2087796, "chapter_id": 2866, "verse_number": "१२-३७१-१२", "content_sanskrit": "वयं हि भवता सर्वे गुणक्रीता विशेषतः।\nयस्त्वमात्महितं त्यक्त्वा मामेवेहानुरुध्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2087797, "chapter_id": 2866, "verse_number": "१२-३७१-१३x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2087798, "chapter_id": 2866, "verse_number": "१२-३७१-१३", "content_sanskrit": "आगतोऽहं महाभाग तव दर्शनलालसः।\nकंचिदर्थमनर्यज्ञः प्रष्टुकामो भुजंगम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2087799, "chapter_id": 2866, "verse_number": "१२-३७१-१४", "content_sanskrit": "अहमात्मानमात्मस्थो मार्गगाणोऽऽत्मनो गतिम्।\nवासार्थिनं महाप्रज्ञं चलच्चित्तमुपास्मि ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2087800, "chapter_id": 2866, "verse_number": "१२-३७१-१५", "content_sanskrit": "प्रकाशितस्त्वं स गुणैर्यशोगर्भगभस्तिभिः।\nशशाङ्ककरसंस्पर्शैर्हृद्यैरात्मप्रकाशितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2087801, "chapter_id": 2866, "verse_number": "१२-३७१-१६", "content_sanskrit": "तस्य मे प्रश्नमुत्पन्नं छिन्धि त्वमनिलाशन।\nपश्चात्कार्यं वदिष्यामि श्रोतुमर्हति तद्भवान्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2087802, "chapter_id": 2866, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि एकसप्तत्यधिकत्रिशततमोऽध्यायः॥ ३७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]