[{"id": 7000439000, "chapter_id": 20439, "verse_number": "२-१११-१", "content_sanskrit": "कुंजल उवाच ।\nनिर्गच्छमाने समराय वीरे नहुषे हि तस्मिन्सुरराज तुल्ये ।\nसकौतुका मंगलगीतयुक्ताः स्त्रियस्तु सर्वाः परिजग्मुरत्र॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000439001, "chapter_id": 20439, "verse_number": "२-१११-२", "content_sanskrit": "देवतानां वरा नार्यो रंभाद्यप्सरसस्तथा ।\nकिन्नर्यः कौतुकोत्सुक्यो जगुः स्वरेण सत्तम॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000439002, "chapter_id": 20439, "verse_number": "२-१११-३", "content_sanskrit": "गंधर्वाणां तथा नार्यो रूपालंकारसंयुताः ।\nकौतुकाय गतास्तत्र यत्र राजा स तिष्ठति॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000439003, "chapter_id": 20439, "verse_number": "२-१११-४", "content_sanskrit": "पुरं महोदयं नाम हुंडस्यापि दुरात्मनः ।\nनंदनोपवनैर्दिव्यैः सर्वत्र समलंकृतम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000439004, "chapter_id": 20439, "verse_number": "२-१११-५", "content_sanskrit": "सप्तकक्षान्वितैर्गेहैः कलशैरुपशोभितः ।\nसपताकैर्महादंडैः शोभमानं पुरोत्तमम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000439005, "chapter_id": 20439, "verse_number": "२-१११-६", "content_sanskrit": "कैलासशिखराकारैः सोन्नतैर्दिवमास्थितैः ।\nसर्वश्रियान्वितैर्दिव्यैर्भ्राजमानं पुरोत्तमम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000439006, "chapter_id": 20439, "verse_number": "२-१११-७", "content_sanskrit": "वनैश्चोपवनैर्दिव्यैस्तडागैः सागरोपमैः ।\nजलपूर्णैः सुशोभैस्तु पद्मै रक्तोत्पलान्वितैः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000439007, "chapter_id": 20439, "verse_number": "२-१११-८", "content_sanskrit": "प्राकारैश्च महारत्नैरट्टालकशतैरपि ।\nपरिखाभिः सुपूर्णाभिर्जलैः स्वच्छैः प्रशोभितम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000439008, "chapter_id": 20439, "verse_number": "२-१११-९", "content_sanskrit": "अन्यैश्चैव महारत्नैर्गजाश्वैश्च विराजितम् ।\nसुनारीभिः समाकीर्णं पुरुषैश्च महाप्रभैः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000439009, "chapter_id": 20439, "verse_number": "२-१११-१०", "content_sanskrit": "नानाप्रभावैर्दिव्यैश्च शोभमानं महोदयम् ।\nराजश्रेष्ठो महावीरो नहुषो ददृशे पुरम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000439010, "chapter_id": 20439, "verse_number": "२-१११-११", "content_sanskrit": "पुरप्रांते वनं दिव्यं दिव्यवृक्षैरलंकृतम् ।\nतद्विवेश महावीरो नंदनं हि यथाऽमरः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000439011, "chapter_id": 20439, "verse_number": "२-१११-१२", "content_sanskrit": "रथेन सह धर्मात्मा तेन मातलिना सह ।\nप्रविष्टः स तु राजेंद्रो वनमध्ये सरित्तटे॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000439012, "chapter_id": 20439, "verse_number": "२-१११-१३", "content_sanskrit": "तत्र ता रूपसंयुक्ता दिव्या नार्यः समागताः ।\nगंधर्वा गीततत्त्वज्ञा जगुर्गीतैर्नृपोत्तमम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000439013, "chapter_id": 20439, "verse_number": "२-१११-१४", "content_sanskrit": "सूताश्च मागधाः सर्वे तं स्तुवंति नृपोत्तमम् ।\nराजानमायुपुत्रं तं भ्राजमानं यथा रविम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000439014, "chapter_id": 20439, "verse_number": "२-१११-१५", "content_sanskrit": "शुश्राव गीतं मधुरं नहुषः किन्नरेरितम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]