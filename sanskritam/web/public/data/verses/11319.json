[{"id": 50006152, "chapter_id": 11319, "verse_number": "1", "content_sanskrit": "- 【पाठभेदः: TRK—(ॐ ऐहिकमप्रस्तुतप्रतिबन्धे तद्दर्शनात् ॐ॥ ॐ एवं मुक्तिफलानियमस्तदवस्थावधृतेस्तदवस्थावधृतेः ॐ॥)】 एवमेवाविरोधेन प्रारब्धस्यैव कर्मणः। ज्ञानं दृष्टफलं प्रोक्तं मुक्तिश्चैवेह लभ्यते 【पाठभेदः: BG—मुक्तिश्चेहैव लभ्यते】 ॥ २७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50006153, "chapter_id": 11319, "verse_number": "2", "content_sanskrit": "॥ इति श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचिते ब्रह्मसूत्रानुव्याख्याने तृतीयाध्यायस्य चतुर्थः पादः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50006154, "chapter_id": 11319, "verse_number": "3", "content_sanskrit": "॥ समाप्तश्चायमध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50006155, "chapter_id": 11319, "verse_number": "4", "content_sanskrit": "॥ चतुर्थाध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50006156, "chapter_id": 11319, "verse_number": "5", "content_sanskrit": "॥ प्रथमः पादः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}]