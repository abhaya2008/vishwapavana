[{"id": 7000821000, "chapter_id": 20821, "verse_number": "६-१६४-१", "content_sanskrit": "महादेव उवाच ।\nअत्र तीर्थं महच्चान्यत्कश्यपाख्यं सुरेश्वरि ।\nयत्र ह्रदो महानासीन्नगदेव विनिर्मितः॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000821001, "chapter_id": 20821, "verse_number": "६-१६४-२", "content_sanskrit": "तत्र कुशेश्वरो नाम देवो यत्र विराजते ।\nयत्र कुंडं तथा रम्यं कश्यपेन विनिर्मितम्॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000821002, "chapter_id": 20821, "verse_number": "६-१६४-३", "content_sanskrit": "तत्र स्नात्वा तु भो देवि न नरो निरयं व्रजेत् ।\nअग्निहोत्रकरा विप्रा नित्यं वेदपरायणाः॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000821003, "chapter_id": 20821, "verse_number": "६-१६४-४", "content_sanskrit": "निवसंति महदेवि काश्यपायां बहुश्रुताः ।\nयथा काशी तथा चेयं नगरी ऋषिनिर्मिता॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000821004, "chapter_id": 20821, "verse_number": "६-१६४-५", "content_sanskrit": "काश्यपेन यतश्चात्र तप्तं बहुतरं तपः ।\nगंगा वै तपसा येन आनीतेशजटोद्भवा॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000821005, "chapter_id": 20821, "verse_number": "६-१६४-६", "content_sanskrit": "सा गंगा काश्यपी देवि महापातकनाशिनी ।\nयस्या दर्शनमात्रेण मुच्यंते दुष्टकिल्बिषात्॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000821006, "chapter_id": 20821, "verse_number": "६-१६४-७", "content_sanskrit": "गोदानं च प्रशंसंति रथदानं तथैव च ।\nश्राद्धं कृत्वा तु तत्रैव दानं देयं प्रयत्नतः॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000821007, "chapter_id": 20821, "verse_number": "६-१६४-८", "content_sanskrit": "कलौ युगे तथा घोरे महापातकनाशनम् ।\nकश्यपाख्यं समं तीर्थं न भूतं न भविष्यति॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000821008, "chapter_id": 20821, "verse_number": "६-१६४-९", "content_sanskrit": "यत्र वै देवताः सर्वा ऋषयो वीतकल्मषाः ।\nनित्यं तिष्ठंति देवेशि तीर्थराजप्रसादतः॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}]