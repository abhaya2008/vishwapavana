[{"id": 6000193000, "chapter_id": 10193, "verse_number": null, "content_sanskrit": "अथ अष्टादशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000193001, "chapter_id": 10193, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_018/BhP_09.018.001.m4a", "display_order": 2}, {"id": 6000193002, "chapter_id": 10193, "verse_number": "९-१८-१", "content_sanskrit": "वितथस्य सुतान्मन्योर्बृहत्क्षेत्रो जयस्ततः।\nमहावीर्यो नरो गर्गः सङ्कृतिस्तु नरात्मजः॥ ९/१८/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_018/BhP_09.018.002.m4a", "display_order": 3, "topics": [{"text": "वितथवंशकथने रन्तिदेवचरित्रवर्णनम्", "range": "१–१८"}]}, {"id": 6000193003, "chapter_id": 10193, "verse_number": "९-१८-२", "content_sanskrit": "गुरुश्च रन्तिदेवश्च सङ्कृतेः पाण्डुनन्दन।\nरन्तिदेवस्य हि यश इहामुत्र च गीयते॥ ९/१८/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_018/BhP_09.018.003.m4a", "display_order": 4}, {"id": 6000193004, "chapter_id": 10193, "verse_number": "९-१८-३", "content_sanskrit": "वीतवित्तस्य ददतो लब्धं लब्धं बुभुक्षतः।\nनिष्किञ्चनस्य धीरस्य सकुटुम्बस्य सीदतः॥ ९/१८/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_018/BhP_09.018.004.m4a", "display_order": 5}, {"id": 6000193005, "chapter_id": 10193, "verse_number": "९-१८-४", "content_sanskrit": "व्यतीयुरष्टचत्वारिंशद् अहान्यपिबतः किल।\nघृतपायससंयावं तोयं प्रातरुपस्थितम्॥ ९/१८/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_018/BhP_09.018.005.m4a", "display_order": 6}, {"id": 6000193006, "chapter_id": 10193, "verse_number": "९-१८-५", "content_sanskrit": "कृत्स्नप्राप्तकुटुम्बस्य क्षुत्तृड्भ्यां जातवेपथोः।\nअतिथिर्बाह्मणः काले भोक्तुकामस्य चागमत्॥ ९/१८/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_018/BhP_09.018.006.m4a", "display_order": 7}, {"id": 6000193007, "chapter_id": 10193, "verse_number": "९-१८-६", "content_sanskrit": "तस्मै संव्यभजत् सोऽन्नमाहृत्य श्रद्धयाऽन्वितः।\nहरिं सर्वत्र सम्पश्यन् स भुक्त्वा प्रययौ द्विजः॥ ९/१८/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_018/BhP_09.018.007.m4a", "display_order": 8}, {"id": 6000193008, "chapter_id": 10193, "verse_number": "९-१८-७", "content_sanskrit": "अथाऽन्यो भोक्ष्यमाणस्य विभक्तस्य महीपतेः।\nविभक्तं व्यभजत् तस्मै वृषलाय हरिं स्मरन्॥ ९/१८/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_018/BhP_09.018.008.m4a", "display_order": 9}, {"id": 6000193009, "chapter_id": 10193, "verse_number": "९-१८-८", "content_sanskrit": "याते शूद्रे तमभ्यागादतिथिः श्वभिरावृतः।\nराजन् मे दीयतामन्नं सगणाय बुभुक्षते॥ ९/१८/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_018/BhP_09.018.009.m4a", "display_order": 10}, {"id": 6000193010, "chapter_id": 10193, "verse_number": "९-१८-९", "content_sanskrit": "स आतिथ्यावशिष्टं यद् बहुमानपुरस्सरम्।\nतच्च दत्त्वा नमश्चक्रे श्वभ्यः श्वपतये विभुः॥ ९/१८/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_018/BhP_09.018.010.m4a", "display_order": 11}, {"id": 6000193011, "chapter_id": 10193, "verse_number": "९-१८-१०", "content_sanskrit": "पानीयमात्रमुच्छेषं तच्चैकपरितर्पणम्।\nपास्यतः पुल्कसोऽभ्यागाद् अपो देह्यशुभस्य मे॥ ९/१८/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_018/BhP_09.018.011.m4a", "display_order": 12}, {"id": 6000193012, "chapter_id": 10193, "verse_number": "९-१८-११", "content_sanskrit": "तस्यातिकरुणां वाचं निशम्य विपुलश्रमम्।\nकृपया भृशसन्तप्त इदमाहामृतं वचः॥ ९/१८/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_018/BhP_09.018.012.m4a", "display_order": 13}, {"id": 6000193013, "chapter_id": 10193, "verse_number": "९-१८-१२", "content_sanskrit": "न कामयेऽहं गतिमीश्वराणां महर्द्धियुक्तामपुनर्भवं च।\nआर्तिं प्रपद्येऽखिलदेहभाजाम् अन्तःस्थितां येन भवन्त्यदुःखाः॥ ९/१८/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_018/BhP_09.018.013.m4a", "display_order": 14}, {"id": 6000193014, "chapter_id": 10193, "verse_number": "९-१८-१३", "content_sanskrit": "क्षुत्तृट्श्रमो गात्रपरिश्रमश्च दैन्यं क्लमः शोकविषादमोहाः।\nसर्वे निवृत्ताः कृपणस्य जन्तोर्जिजीविषोर्जीवजलार्पणेन॥ ९/१८/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_018/BhP_09.018.014.m4a", "display_order": 15}, {"id": 6000193015, "chapter_id": 10193, "verse_number": "९-१८-१४", "content_sanskrit": "एवं प्रभाष्य पानीयं म्रियमाणः पिपासया।\nपुल्कसायाददाद् धीरो निसर्गकरुणो नृपः॥ ९/१८/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_018/BhP_09.018.015.m4a", "display_order": 16}, {"id": 6000193016, "chapter_id": 10193, "verse_number": "९-१८-१५", "content_sanskrit": "तस्य त्रिभुवनाधीशाः फलदाः फलमिच्छताम्।\nआत्मानं दर्शयाञ्चक्रुर्मायां विष्णुविनिर्मिताम्॥ ९/१८/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_018/BhP_09.018.016.m4a", "display_order": 17}, {"id": 6000193017, "chapter_id": 10193, "verse_number": "९-१८-१६", "content_sanskrit": "स वै तेभ्यो नमस्कृत्य निःसङ्गो विगतस्पृहः।\nवासुदेवे भगवति भक्त्या चक्रे मनः परम्॥ ९/१८/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_018/BhP_09.018.017.m4a", "display_order": 18}, {"id": 6000193018, "chapter_id": 10193, "verse_number": "९-१८-१७", "content_sanskrit": "ईश्वरालम्बनं चित्तं कुर्वतोऽनन्यराधसः।\nमाया गुणमयी राजन् स्वप्नवत् प्रत्यलीयत॥ ९/१८/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_018/BhP_09.018.018.m4a", "display_order": 19}, {"id": 6000193019, "chapter_id": 10193, "verse_number": "९-१८-१८", "content_sanskrit": "तत्प्रसङ्गानुभावेन रन्तिदेवानुवर्तिनः।\nअभवन् योगिनः सर्वे नारायणपरायणाः॥ ९/१८/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_018/BhP_09.018.019.m4a", "display_order": 20}, {"id": 6000193020, "chapter_id": 10193, "verse_number": "९-१८-१९", "content_sanskrit": "गर्गाच्छिनिस्ततो गार्ग्यात् क्षत्राद् ब्रह्म ह्यवर्तत। दुरितक्षयो महावीर्यात् तस्य त्रय्यारुणिः कविः।\nपुष्करारुणिरित्यत्र ये ब्राह्मणगतिं गताः॥ ९/१८/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_018/BhP_09.018.020.m4a", "display_order": 21, "topics": [{"text": "गर्गस्य वंशे गार्ग्यादिब्राह्मणोत्पत्तिः", "range": "१९–२१"}]}, {"id": 6000193021, "chapter_id": 10193, "verse_number": "९-१८-२०", "content_sanskrit": "बृहत्क्षेत्रस्य होत्रोऽस्माद्धस्ती यद् हस्तिनापुरम्।\nअजमीढो द्विमीढश्च पुरुमीढश्च हस्तिनः॥ ९/१८/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_018/BhP_09.018.021.m4a", "display_order": 22}, {"id": 6000193022, "chapter_id": 10193, "verse_number": "९-१८-२१", "content_sanskrit": "अजमीढस्य वंश्याः स्युः प्रियमेधादयो द्विजाः॥ ९/१८/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_018/BhP_09.018.022.m4a", "display_order": 23}, {"id": 6000193023, "chapter_id": 10193, "verse_number": "९-१८-२२", "content_sanskrit": "अजमीढाद् बृहदिषुस्तस्य पुत्रो बृहद्धनुः।\nबृहत्कायस्ततस्तस्य पुत्र आसीज्जयद्रथः॥ ९/१८/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_018/BhP_09.018.023.m4a", "display_order": 24, "topics": [{"text": "अजमीढस्य वंशे केषांचिद् मृद्गलशरद्वत्कृपप्रभृतीनां ब्राह्मणानामुत्पत्तिः", "range": "२२–३७"}]}, {"id": 6000193024, "chapter_id": 10193, "verse_number": "९-१८-२३", "content_sanskrit": "तत्सुतो विशदस्तस्य श्येनजित् समजायत।\nरुचिराश्वो दृढहनुः काश्यो वत्सश्च तत्सुताः॥ ९/१८/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_018/BhP_09.018.024.m4a", "display_order": 25}, {"id": 6000193025, "chapter_id": 10193, "verse_number": "९-१८-२४", "content_sanskrit": "रुचिराश्वसुतो याजः पृथुसेनस्तदात्मजः।\nपारस्तत्तनयो नीपस्तस्य पुत्रशतं त्वभूत्॥ ९/१८/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_018/BhP_09.018.025.m4a", "display_order": 26}, {"id": 6000193026, "chapter_id": 10193, "verse_number": "९-१८-२५", "content_sanskrit": "अणुहो नाम यस्तेषां ज्येष्ठो सत्यात्मको नृप।\nस कल्यां शुककन्यायां ब्रह्मदत्तमजीजनत्॥ ९/१८/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_018/BhP_09.018.026.m4a", "display_order": 27}, {"id": 6000193027, "chapter_id": 10193, "verse_number": "९-१८-२६", "content_sanskrit": "योगेशो गवि भार्यायां विश्वक्सेनमधात् सुतम्।\nजैगीषव्योपदेशेन योगतन्त्रं चकार ह॥ ९/१८/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_018/BhP_09.018.027.m4a", "display_order": 28}, {"id": 6000193028, "chapter_id": 10193, "verse_number": "९-१८-२७", "content_sanskrit": "उदक्सेनस्ततस्तस्माद् भल्लादो बार्हदीषवाः।\nयवीनरो द्विमीढस्य कृतिमांस्तत्सुतस्ततः॥ ९/१८/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_018/BhP_09.018.028.m4a", "display_order": 29}, {"id": 6000193029, "chapter_id": 10193, "verse_number": "९-१८-२८", "content_sanskrit": "नाम्ना सत्यधृतिर्यस्माद् दृढनेमिः सुपार्श्वकृत्।\nसुपार्श्वात् सुमतिस्तस्य पुत्रः सन्ततिमांस्ततः॥ ९/१८/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_018/BhP_09.018.029.m4a", "display_order": 30}, {"id": 6000193030, "chapter_id": 10193, "verse_number": "९-१८-२९", "content_sanskrit": "कृतिर्हिरण्यनाभाद् यो योगं प्राप्य जगौ द्विषट्।\nसंहिताः प्राच्यसाम्नां वै नीपो ह्यौग्रायुधस्ततः॥ ९/१८/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_018/BhP_09.018.030.m4a", "display_order": 31}, {"id": 6000193031, "chapter_id": 10193, "verse_number": "९-१८-३०", "content_sanskrit": "तस्य क्षेम्यः सुवीरोऽथ सुवीरस्य रिपुञ्जयः।\nततो बहुतिथो नाम पुरुमीढोऽप्रजोऽभवत्॥ ९/१८/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_018/BhP_09.018.031.m4a", "display_order": 32}, {"id": 6000193032, "chapter_id": 10193, "verse_number": "९-१८-३१", "content_sanskrit": "नलिन्यामजमीढस्य नीलः शान्तिस्तु तत्सुतः।\nशान्तेः सुशान्तिस्तत्पुत्रः पुराजोऽर्कस्ततोऽभवत्॥ ९/१८/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_018/BhP_09.018.032.m4a", "display_order": 33}, {"id": 6000193033, "chapter_id": 10193, "verse_number": "९-१८-३२", "content_sanskrit": "हर्म्याश्वस्तत्सुतस्तस्य पञ्चासन् मुद्गलादयः।\nयवीनरो बृहदिषुः काम्पिल्यः सञ्जयस्ततः॥ ९/१८/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_018/BhP_09.018.033.m4a", "display_order": 34}, {"id": 6000193034, "chapter_id": 10193, "verse_number": "९-१८-३३", "content_sanskrit": "हर्म्याश्वः प्राह पुत्रा मे पञ्चानां रक्षणाय हि।\nविषयाणामलमिमे इति पञ्चालसञ्ज्ञिताः॥ ९/१८/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_018/BhP_09.018.034.m4a", "display_order": 35}, {"id": 6000193035, "chapter_id": 10193, "verse_number": "९-१८-३४", "content_sanskrit": "मुद्गलाद् ब्रह्म निर्वृत्तं गोत्रं मौद्गल्यसञ्ज्ञितम्।\nमिथुनं मुद्गलाद्धार्म्याद्दिवोदासः पुमानभूत्॥ ९/१८/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_018/BhP_09.018.035.m4a", "display_order": 36}, {"id": 6000193036, "chapter_id": 10193, "verse_number": "९-१८-३५", "content_sanskrit": "अहल्या कन्यका यस्यां शतानन्दस्तु गौतमात्।\nतस्य शतधृतिः पुत्रो धनुर्वेदविशारदः॥ ९/१८/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_018/BhP_09.018.036.m4a", "display_order": 37}, {"id": 6000193037, "chapter_id": 10193, "verse_number": "९-१८-३६", "content_sanskrit": "शरद्वांस्तत्सुतो यस्मादुर्वशीदर्शनात् किल।\nशरस्तम्बेऽपतद् रेतो मिथुनं तदभूच्छुभम्॥ ९/१८/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_018/BhP_09.018.037.m4a", "display_order": 38}, {"id": 6000193038, "chapter_id": 10193, "verse_number": "९-१८-३७", "content_sanskrit": "तद् दृष्ट्वा कृपयाऽगृह्णाच्छन्तनुर्मृगयां चरन्।\nकृपः कुमारः कन्या च द्रोणपत्न्यभवत् कृपी॥ ९/१८/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_018/BhP_09.018.038.m4a", "display_order": 39}, {"id": 6000193039, "chapter_id": 10193, "verse_number": null, "content_sanskrit": "इति श्रीमद्भागवते वैयासिक्यां संहितायां नवमस्कन्धे अष्टादशाध्यायः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]