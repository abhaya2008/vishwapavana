[{"id": 2185548, "chapter_id": 4937, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2185549, "chapter_id": 4937, "verse_number": "१", "content_sanskrit": "अमन्वतामधिष्ठानमुक्तो लोभः पितामह ।\nअज्ञानमपि वै तात श्रोतुमिच्छामि तत्त्वतः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2185550, "chapter_id": 4937, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2185551, "chapter_id": 4937, "verse_number": "२", "content_sanskrit": "करोति पापं योऽज्ञानान्नात्मनो वेत्ति च क्षयम् ।\nप्रद्वेष्टि साधुवृत्तांश्च स लोकस्यैति वाच्यताम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2185552, "chapter_id": 4937, "verse_number": "३", "content_sanskrit": "अज्ञानान्निरयं याति तथाज्ञानेन दुर्गतिम् ।\nअज्ञानात् क्लेशमाप्नोति तथापत्सु निमज्जति\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2185553, "chapter_id": 4937, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2185554, "chapter_id": 4937, "verse_number": "४", "content_sanskrit": "अज्ञानस्य प्रवृत्तिं च स्थानं वृद्धिं क्षयोदयौ ।\nमूलं योगं गतिं कालं कारणं हेतुमेव च\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2185555, "chapter_id": 4937, "verse_number": "५", "content_sanskrit": "श्रोतुमिच्छामि तत्त्वेन यथावदिह पार्थिव ।\nअज्ञानप्रभवं हीदं यद् दुःखमुपलभ्यते\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2185556, "chapter_id": 4937, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2185557, "chapter_id": 4937, "verse_number": "६", "content_sanskrit": "रागो द्वेषस्तथा मोहो हर्षः शोकोऽभिमानिता ।\nकामः क्रोधश्च दर्पश्च तन्द्रीरालस्यमेव च\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2185558, "chapter_id": 4937, "verse_number": "७", "content_sanskrit": "इच्छा द्वेषस्तथा तापः परवृद्ध्युपतापिता ।\nअज्ञानमेतन्निर्दिष्टं पापानां चैव याः क्रियाः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2185559, "chapter_id": 4937, "verse_number": "८", "content_sanskrit": "एतस्य या प्रवृत्तिश्च वृद्ध्यादीन् यांश्च पृच्छसि ।\nविस्तरेण महाबाहो शृणु तच्च विशां पते\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2185560, "chapter_id": 4937, "verse_number": "९", "content_sanskrit": "उभावेतौ समफलौ समदोषौ च भारत ।\nअज्ञानं चातिलोभश्चाप्येकं जानीहि पार्थिव\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2185561, "chapter_id": 4937, "verse_number": "१०", "content_sanskrit": "लोभप्रभवमज्ञानं वृद्धं भूयः प्रवर्धते ।\nस्थाने स्थानं क्षये क्षैण्यमुपैति विविधां गतिम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2185562, "chapter_id": 4937, "verse_number": "११", "content_sanskrit": "मूलं लोभस्य महतः कालात्मगतिरेव च ।\nछिन्नेऽच्छिन्ने तथा लोभे कारणं काल एव हि\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2185563, "chapter_id": 4937, "verse_number": "१२", "content_sanskrit": "तस्याज्ञानात्तु लोभो हि लोभादज्ञानमेव च ।\nसर्वे दोषास्तथा लोभात्तस्माल्लोभं विवर्जयेत्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2185564, "chapter_id": 4937, "verse_number": "१३", "content_sanskrit": "जनको युवनाश्वश्च वृषादर्भिः प्रसेनजित् ।\nलोभक्षयाद् दिवं प्राप्तास्तथैवान्ये जनाधिपाः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2185565, "chapter_id": 4937, "verse_number": "१४", "content_sanskrit": "प्रत्यक्षं तु कुरुश्रेष्ठ त्यज लोभमिहात्मना ।\nत्यक्त्वा लोभं सुखं लोके प्रेत्य चानुचरिष्यसि\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2185566, "chapter_id": 4937, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि आपद्धर्मे पञ्चविंशोऽध्यायः ॥ २५ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]