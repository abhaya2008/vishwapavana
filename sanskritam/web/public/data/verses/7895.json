[{"id": 33000212, "chapter_id": 7895, "verse_number": "1", "content_sanskrit": "ऐश्वर्य इन्दति नाथति सुरत्यपि नाधते । तप्यते तपतीत्येके सुवतीष्टे च सौति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1, "avatarnika": ""}, {"id": 33000213, "chapter_id": 7895, "verse_number": "2", "content_sanskrit": "भुनक्ति पाति दयते गोपायति पिपर्ति च । रक्षति त्रायते त्राणे पालयत्यपि तेजति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2, "avatarnika": ""}, {"id": 33000214, "chapter_id": 7895, "verse_number": "3", "content_sanskrit": "स्पृणोति कुण्डयति च गुण्डत्यवति जंसति । शास्ति शिष्टौ दण्डयति शिक्षयत्यपि दाम्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3, "avatarnika": ""}, {"id": 33000215, "chapter_id": 7895, "verse_number": "4", "content_sanskrit": "आवर्जयति वशयत्यपि राधयतीति च । वशीकरोति सङ्गृह्णात्यात्मने द्वौ वशीकृतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4, "avatarnika": ""}, {"id": 33000216, "chapter_id": 7895, "verse_number": "5", "content_sanskrit": "परिक्रीणीत इत्येतद् उत्कोचादिवशीकृतौ । आयत्तौ स्यादायतते वशीभवति राध्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5, "avatarnika": ""}, {"id": 33000217, "chapter_id": 7895, "verse_number": "6", "content_sanskrit": "स्थिरीकृतौ स्थापयति द्रढयत्यपि बृंहति । दधाति धत्ते बिभृते बिभर्ति भरतीति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6, "avatarnika": ""}, {"id": 33000218, "chapter_id": 7895, "verse_number": "7", "content_sanskrit": "धरतीत्यात्मनेऽपि द्वौ भुरण्यति धियत्यपि । मलते धारयति च मल्लते पोषयत्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7, "avatarnika": ""}, {"id": 33000219, "chapter_id": 7895, "verse_number": "8", "content_sanskrit": "दधते त्रासयति च स्कुन्दते धारणाऽर्थकाः । नियुङ्क्त आज्ञापयति निर्दिशत्यादिशत्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8, "avatarnika": ""}, {"id": 33000220, "chapter_id": 7895, "verse_number": "9", "content_sanskrit": "द्वावात्मनेऽपि चाऽऽज्ञायाम् अथ प्रस्थापयत्यमी । स्युः प्रेषणे प्रेषयति प्रेष्यति प्रहिणोति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9, "avatarnika": ""}, {"id": 33000221, "chapter_id": 7895, "verse_number": "10", "content_sanskrit": "सन्देशे वादयति च सन्दिशत्यात्मनेऽप्यदः । सुवति क्षिप्यति प्रेरयतीरति कुषुभ्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10, "avatarnika": ""}, {"id": 33000222, "chapter_id": 7895, "verse_number": "11", "content_sanskrit": "नुदति क्षिपतीत्येतावात्मने कालयत्यपि । डिपत्येवं डेपयति लाभयत्यपि डिप्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11, "avatarnika": ""}, {"id": 33000223, "chapter_id": 7895, "verse_number": "12", "content_sanskrit": "ईरयत्येलयति च प्रेरणेऽस्यति विस्यति । सेवते जुषते चाऽपि शेवते क्लेवतेऽपि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12, "avatarnika": ""}, {"id": 33000224, "chapter_id": 7895, "verse_number": "13", "content_sanskrit": "खेवते गेवते चाऽपि ग्लेवते पेवते तथा । मेवते चाऽपि सेवायां भजति श्रयतीति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13, "avatarnika": ""}, {"id": 33000225, "chapter_id": 7895, "verse_number": "14", "content_sanskrit": "आत्मनेऽनुरुणद्ध्येतेऽनुसरत्यनुवर्तते । सम्भक्तौ तु वृणीते स्युर्वनत्येवं सनत्यमी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14, "avatarnika": ""}, {"id": 33000226, "chapter_id": 7895, "verse_number": "15", "content_sanskrit": "सजूःकरोत्यात्मनेऽपि साह्ये सत्राकरोति च । नृणाति लम्भयति च वहत्यपि नयत्यमू ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15, "avatarnika": ""}, {"id": 33000227, "chapter_id": 7895, "verse_number": "16", "content_sanskrit": "आत्मनेऽपि प्रापणे स्युः प्रापयत्यापयत्यपि । गत्यर्था ये णिजन्तास्ते धातवो नीञ्समार्थकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16, "avatarnika": ""}, {"id": 33000228, "chapter_id": 7895, "verse_number": "17", "content_sanskrit": "मन्दायते शोठति च लुण्ठत्यपि विलम्बने । द्वावात्मनेऽपि समयाकरोति व्याक्षिपत्यमू ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17, "avatarnika": ""}, {"id": 33000229, "chapter_id": 7895, "verse_number": "18", "content_sanskrit": "प्रतीक्षते प्रतीक्षायां स्युरागमयते तथा । अनुपालयतीत्येते प्रतिपालयतीति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18, "avatarnika": ""}, {"id": 33000230, "chapter_id": 7895, "verse_number": "19", "content_sanskrit": "त्वरायां सम्भ्रमति च सम्भ्राम्यति तुरण्यति । गुप्यति त्वरते सप्त सम्भ्रम्यति तुतोर्ति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19, "avatarnika": ""}, {"id": 33000231, "chapter_id": 7895, "verse_number": "20", "content_sanskrit": "वैक्लव्ये विक्लवति च टलति ट्वलतीति च । समति स्तमतीत्येते विह्वलत्यपि कन्दते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20, "avatarnika": ""}, {"id": 33000232, "chapter_id": 7895, "verse_number": "21", "content_sanskrit": "क्रन्दतेऽपि च कैश्चित् तु क्लदते क्रदते स्मृते। क्लीबायते क्लीबते च क्लैब्ये स्युरवगल्भते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21, "avatarnika": ""}, {"id": 33000233, "chapter_id": 7895, "verse_number": "22", "content_sanskrit": "कुटति ग्रन्थते हूर्छत्यपि क्मरति वङ्कते । नसते तुणति क्रुञ्चत्येवं ह्वरति कुञ्चति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22, "avatarnika": ""}, {"id": 33000234, "chapter_id": 7895, "verse_number": "23", "content_sanskrit": "भुजति ध्वरतीत्येते कौटिल्ये न्युब्जतीति च । गुप्तोक्तौ स्यान्मन्त्रयते भेदे तूपजपत्यदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23, "avatarnika": ""}, {"id": 33000235, "chapter_id": 7895, "verse_number": "24", "content_sanskrit": "दम्भेच्छायां धीप्सतीति दिदम्भिषति धिप्सति । संवर्मयति सन्नह्यत्यात्मने सज्जतीत्यमी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24, "avatarnika": ""}, {"id": 33000236, "chapter_id": 7895, "verse_number": "25", "content_sanskrit": "संयतते दंशयते सन्नाहे पदपञ्चकम् । अध्यास्ते त्वधिशेते चाऽधिवसत्यधितिष्ठति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25, "avatarnika": ""}, {"id": 33000237, "chapter_id": 7895, "verse_number": "26", "content_sanskrit": "अधिरोहत्यधिक्रामत्यारोहत्यधिरोहणे । स्पन्दने स्पन्दते तद्वत् स्फुरति स्फुलति द्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26, "avatarnika": ""}, {"id": 33000238, "chapter_id": 7895, "verse_number": "27", "content_sanskrit": "चलने चलति प्रेङ्खत्येवं ह्मलति घट्टते । वलते वल्लते वेल्लत्येवं ह्वलति चेलति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27, "avatarnika": ""}, {"id": 33000239, "chapter_id": 7895, "verse_number": "28", "content_sanskrit": "उच्छ्राये तटति स्तुप्यत्युच्छ्रयत्यात्मनेऽप्यदः । क्षोभते क्षुभ्यति क्षोभे क्षुभ्नाति च्छान्दसं क्वचित्  ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28, "avatarnika": ""}, {"id": 33000240, "chapter_id": 7895, "verse_number": "29", "content_sanskrit": "प्रतिष्ठतेऽञ्चत्ययते व्रजत्ययति गच्छति । ऋणोत्यटति यात्येति सरतीयर्ति सर्पति  ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29, "avatarnika": ""}, {"id": 33000241, "chapter_id": 7895, "verse_number": "30", "content_sanskrit": "हम्मति द्रमति त्वङ्गतीङ्गत्यमति मीमति । जिहीते कङ्कते नक्षतीखत्यृच्छति वभ्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30, "avatarnika": ""}, {"id": 33000242, "chapter_id": 7895, "verse_number": "31", "content_sanskrit": "श्वङ्‌ङ्कते त्रौकते वस्कतेंऽहते टीकतेऽभ्रति । मस्कते लङ्घते शोणत्यङ्घते त्रङ्कतेऽर्दति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31, "avatarnika": ""}, {"id": 33000243, "chapter_id": 7895, "verse_number": "32", "content_sanskrit": "पयते वयते विच्छायति पन्थयतीजते । चरण्यति स्रङ्कतेऽपि घटते श्वञ्चतेऽङ्गति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32, "avatarnika": ""}, {"id": 33000244, "chapter_id": 7895, "verse_number": "33", "content_sanskrit": "रङ्गति श्वचते लङ्गतीर्ते ध्वजति ध्वञ्जति । चरति धञ्जति शवत्यण्ठते ग्लुञ्चतीष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33, "avatarnika": ""}, {"id": 33000245, "chapter_id": 7895, "verse_number": "34", "content_sanskrit": "वञ्चति म्रोचति म्लोचत्यजति त्वञ्चतीजते । फणति द्रवते गाते पद्यते विच्छति क्वचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34, "avatarnika": ""}, {"id": 33000246, "chapter_id": 7895, "verse_number": "35", "content_sanskrit": "पथति क्रामति पतयते रिण्वति रण्वति । स्रवति श्यायते धन्वत्यञ्चते सलतीत्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35, "avatarnika": ""}, {"id": 33000247, "chapter_id": 7895, "verse_number": "36", "content_sanskrit": "शुनति च्छङ्गयति च श्वर्तयत्यपि रेवते । ममर्ति च्छान्दसं केचिद् एषते नेषते गतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36, "avatarnika": ""}, {"id": 33000248, "chapter_id": 7895, "verse_number": "37", "content_sanskrit": "सप्ताशीतिरितोऽप्यन्ये नोक्ता विस्तरतो भयात् । वेगितायां गतौ सप्ताऽमी स्युर्धावति तूर्यते  ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37, "avatarnika": ""}, {"id": 33000249, "chapter_id": 7895, "verse_number": "38", "content_sanskrit": "जवति श्वल्लति श्वलत्यपि द्रवति रंहति । डयते डीयते व्योमगतेऽथाऽकति चाऽगति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38, "avatarnika": ""}, {"id": 33000250, "chapter_id": 7895, "verse_number": "39", "content_sanskrit": "चञ्चूर्यतेऽटाट्यते जङ्गम्यते चाऽप्यरार्यते । गत्यर्था यङ्लुगन्ता ये कुटिलायां गतौ हि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39, "avatarnika": ""}, {"id": 33000251, "chapter_id": 7895, "verse_number": "40", "content_sanskrit": "वल्गतीति प्लुतगतौ प्लवते शशति त्रयम् । मन्दायां चोपति गतौ चतुरायां तु धोरति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40, "avatarnika": ""}, {"id": 33000252, "chapter_id": 7895, "verse_number": "41", "content_sanskrit": "सन्ततायाम् अतति च त्सरति च्छद्मना गतौ । मन्दते विकलायां तु द्वयं खञ्जति खोरति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41, "avatarnika": ""}, {"id": 33000253, "chapter_id": 7895, "verse_number": "42", "content_sanskrit": "नीचैः फक्वति कुत्सायां द्रात्यथाऽग्रे पुरत्यदः । पवते वाति वातस्य वहति प्रवहत्यपाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42, "avatarnika": ""}, {"id": 33000254, "chapter_id": 7895, "verse_number": "43", "content_sanskrit": "भ्रमति भ्राम्यति भ्रम्यत्यपि पर्यटति भ्रमे । घोणते घूर्णते पर्येत्येते घुणति घूर्णति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43, "avatarnika": ""}, {"id": 33000255, "chapter_id": 7895, "verse_number": "44", "content_sanskrit": "उद्गच्छत्युन्नमति चाऽप्युज्जिहीत उदीयते । उदञ्चत्युदयत्येतावात्मने द्वावुदेति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44, "avatarnika": ""}, {"id": 33000256, "chapter_id": 7895, "verse_number": "45", "content_sanskrit": "गत्यर्थाः प्राय उत्पूर्वा उदयस्याऽभिधायकाः । आक्रम्यते चाऽक्रमते ज्योतिष्कर्तृक उद्गमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45, "avatarnika": ""}, {"id": 33000257, "chapter_id": 7895, "verse_number": "46", "content_sanskrit": "सञ्चारे चरतीत्येष तृतीयायुक्त आत्मने । पतत्यधोगतौ भ्रंसतेऽपि भ्रश्यति भृश्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46, "avatarnika": ""}, {"id": 33000258, "chapter_id": 7895, "verse_number": "47", "content_sanskrit": "गलति स्रंसतेऽष्टाऽमी च्यवते स्कन्दतीति च । अस्तङ्गमेऽस्तमयते निम्लोचत्यस्तमेति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47, "avatarnika": ""}, {"id": 33000259, "chapter_id": 7895, "verse_number": "48", "content_sanskrit": "इष्यति नश्यति पलायतेऽन्तर्घत्त इत्यपि । मुण्ठतेऽपैत्यपक्रामत्येवमाद्याः पलायने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48, "avatarnika": ""}, {"id": 33000260, "chapter_id": 7895, "verse_number": "49", "content_sanskrit": "स्कुनाति च स्कुनीते च स्कुनोत्याप्रवतेऽपि च । स्कुनुते स्कुन्दते चाऽपि षड् आप्रवणवाचिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49, "avatarnika": ""}, {"id": 33000261, "chapter_id": 7895, "verse_number": "50", "content_sanskrit": "अतिक्रामत्युच्चरतेऽट्टयत्यतिचरत्यपि । उल्लङ्घयत्यतिक्राम्यत्येवमाद्या अतिक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50, "avatarnika": ""}, {"id": 33000262, "chapter_id": 7895, "verse_number": "51", "content_sanskrit": "द्यौत्यभिगच्छत्यभियात्यभ्येत्याद्या अभिक्रमे । अभियोगेऽभ्यवस्कन्दत्यड्डत्यास्तिघ्नुतेऽपि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51, "avatarnika": ""}, {"id": 33000263, "chapter_id": 7895, "verse_number": "52", "content_sanskrit": "सप्ताऽभियुङ्क्ते तिक्नोति तिग्नोत्यासेधतीति च । सेनया त्वभियाने स्याद् अभिषेणयतीति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52, "avatarnika": ""}, {"id": 33000264, "chapter_id": 7895, "verse_number": "53", "content_sanskrit": "सन्निकर्षत्यवष्टभ्नात्यासीदत्यपि नेदते । परस्मै द्वौ सन्निकृषतेऽवष्टभ्नोति चाऽन्तिके ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53, "avatarnika": ""}, {"id": 33000265, "chapter_id": 7895, "verse_number": "54", "content_sanskrit": "प्राप्तौ प्राप्नोति भवते विन्दत्यवरुणद्धि च। आत्मनेऽपि द्वयं भावयते लभत ॠच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54, "avatarnika": ""}, {"id": 33000266, "chapter_id": 7895, "verse_number": "55", "content_sanskrit": "व्याप्नोति चाऽश्नुतेऽक्ष्णोति व्याप्तौ श्लाखति शाखति । द्वावाचिनोति वेवेष्ट्यात्मनेऽप्यक्षति चेन्वति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55, "avatarnika": ""}, {"id": 33000267, "chapter_id": 7895, "verse_number": "56", "content_sanskrit": "पर्याप्नोति तु शक्नोति क्षमते प्रभवत्यपि । पोथत्यलत्यात्मनेऽपि द्वौ पारयति कल्पते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56, "avatarnika": ""}, {"id": 33000268, "chapter_id": 7895, "verse_number": "57", "content_sanskrit": "राघते लाघते शक्तौ स्फुरते विभवत्यपि । स्युरुद्यमेऽवगुरुते वृहत्यडति गूर्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57, "avatarnika": ""}, {"id": 33000269, "chapter_id": 7895, "verse_number": "58", "content_sanskrit": "उद्गारयत उद्युङ्क्त उद्यच्छत्यात्मनेऽप्यदः। हेडति स्नायति वटत्यपि गुध्यति वण्डते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58, "avatarnika": ""}, {"id": 33000270, "chapter_id": 7895, "verse_number": "59", "content_sanskrit": "मण्डते वेष्टते वेष्टे मगध्यति मुरत्यपि । कृणत्ति गुण्डयति च परिक्षिपति चाऽऽत्मने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59, "avatarnika": ""}, {"id": 33000271, "chapter_id": 7895, "verse_number": "60", "content_sanskrit": "वेष्टनायां वटयति चेष्टयत्यादयोऽपि च । निरुणद्धि निगृह्णाति चाऽऽत्मने द्वौ निरोधने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60, "avatarnika": ""}, {"id": 33000272, "chapter_id": 7895, "verse_number": "61", "content_sanskrit": "आञ्छत्याकर्ष आकर्षत्यायच्छत्यात्मनेऽप्यदः। धृष्णोति चाऽधिकुरुते धर्षयत्यपि धर्षति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61, "avatarnika": ""}, {"id": 33000273, "chapter_id": 7895, "verse_number": "62", "content_sanskrit": "जयत्येवं विजयते ज्रयत्यभिभवत्यपि । अभ्यस्ति च प्रसहते पराभावयतीति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62, "avatarnika": ""}, {"id": 33000274, "chapter_id": 7895, "verse_number": "63", "content_sanskrit": "विमानयत्यभिभवे व्लीनाति न्यक्करोति च । लङ्गयत्याक्रमति च तरत्याक्रम्यतीति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63, "avatarnika": ""}, {"id": 33000275, "chapter_id": 7895, "verse_number": "64", "content_sanskrit": "विशेषयत्यतिशये ह्यतिशेते विशेषति। उत्कर्षयत्यञ्चयति विशिनष्टि प्रकर्षति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64, "avatarnika": ""}, {"id": 33000276, "chapter_id": 7895, "verse_number": "65", "content_sanskrit": "चित्रीयते लिङ्गयति विस्माययति चाऽद्भुते । स्यातां कुहयते विस्मापयते हेतुतोऽद्भुते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65, "avatarnika": ""}, {"id": 33000277, "chapter_id": 7895, "verse_number": "66", "content_sanskrit": "धूनयति धुवति चलयति धूनोति धवति धुनाति च धुनोति । चत्वारि चाऽऽत्मने कम्पयति क्ष्मापयति वाजयति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66, "avatarnika": ""}, {"id": 33000278, "chapter_id": 7895, "verse_number": "67", "content_sanskrit": "ह्वालयति ह्मालयति ह्वलयति ह्मलयतीति स्युः। तद्वत् प्रेङ्खोलयति प्रकम्पने डोलयत्यपि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67, "avatarnika": ""}, {"id": 33000279, "chapter_id": 7895, "verse_number": "68", "content_sanskrit": "विलोडयति मथ्नाति मथत्येवं खजत्यपि । गाहते मन्थने लुट्यत्यपि लोटति मन्थति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68, "avatarnika": ""}, {"id": 33000280, "chapter_id": 7895, "verse_number": "69", "content_sanskrit": "खेटत्युत्त्रासने भाययत्येवं दरयत्यपि । प्रयोजकाद्भये भीषयते भापयतेऽपि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69, "avatarnika": ""}, {"id": 33000281, "chapter_id": 7895, "verse_number": "70", "content_sanskrit": "क्ष्मायते कम्पते त्वङ्गत्येजतीर्ते  च वेपते । केपते ग्लेपते कम्पे गेपते विजते दश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70, "avatarnika": ""}, {"id": 33000282, "chapter_id": 7895, "verse_number": "71", "content_sanskrit": "ताडने ताडयति च हन्ति विध्यति तण्डते। प्रहरत्यात्मने सट्टयति स्फिट्टयतीति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71, "avatarnika": ""}, {"id": 33000283, "chapter_id": 7895, "verse_number": "72", "content_sanskrit": "आघट्टयति चाऽस्फालयति जासयतीत्यमी । आहतेऽकर्मकत्वे स्यात् स्वकीयेऽङ्गे च कर्मणि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72, "avatarnika": ""}, {"id": 33000284, "chapter_id": 7895, "verse_number": "73", "content_sanskrit": "युध्यते सम्प्रहरते युद्धे जजति जञ्जति । सम्मर्दयति सङ्ग्रामयतीमे कलहायते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73, "avatarnika": ""}, {"id": 33000285, "chapter_id": 7895, "verse_number": "74", "content_sanskrit": "करोत्युपाजेऽन्वाजेभ्याम् आत्मनेऽपि बलाऽर्पणे । विक्रम्यते वीरयते पराक्रमत इत्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74, "avatarnika": ""}, {"id": 33000286, "chapter_id": 7895, "verse_number": "75", "content_sanskrit": "प्रगल्भते शूरयते पराक्रम्यत इत्यसौ । ओजायते विक्रमते विक्रमेऽष्टपदी भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75, "avatarnika": ""}, {"id": 33000287, "chapter_id": 7895, "verse_number": "76", "content_sanskrit": "अरुष्करोत्यात्मनेऽपि व्रणयत्यङ्गचूर्णने । गोकर्तृकायां हिंसायां प्रस्तुम्पति सुटा भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76, "avatarnika": ""}, {"id": 33000288, "chapter_id": 7895, "verse_number": "77", "content_sanskrit": "हिनस्ति सञ्ज्ञपयति सूदते हन्ति तर्दति । तोपति च त्रोपतीषत्यपि तूर्वति थूर्वति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77, "avatarnika": ""}, {"id": 33000289, "chapter_id": 7895, "verse_number": "78", "content_sanskrit": "तोफति त्रोफति रुशत्यपि तुम्पति त्रुम्पति । तुम्फति त्रुम्फति शसत्यूर्वत्यर्वति तोजति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78, "avatarnika": ""}, {"id": 33000290, "chapter_id": 7895, "verse_number": "79", "content_sanskrit": "नभते भर्वति मषत्येवं नभ्नाति नभ्यति । तोभते शर्वति वषत्यपि तुभ्नाति तुभ्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79, "avatarnika": ""}, {"id": 33000291, "chapter_id": 7895, "verse_number": "80", "content_sanskrit": "शूर्यते शेषति तुपत्यपि रोषति रेषति । धूर्यते यूषति तुफत्यपि दूर्वति धूर्वति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80, "avatarnika": ""}, {"id": 33000292, "chapter_id": 7895, "verse_number": "81", "content_sanskrit": "प्रमापयत्यर्दयति निर्वापयति रिष्यति । तृणेढि मारयति च श्लथत्यर्दति गूर्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81, "avatarnika": ""}, {"id": 33000293, "chapter_id": 7895, "verse_number": "82", "content_sanskrit": "ऋथत्युज्जासयति च श्राथयत्यपि युथ्यति । तृहत्युध्नुटयति  च क्षिणाति च कृणाति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82, "avatarnika": ""}, {"id": 33000294, "chapter_id": 7895, "verse_number": "83", "content_sanskrit": "प्रतिष्किरत्यालभते तृणात्युन्मथतीति च । क्षिणोति च्छषति द्रूणाति कृणोति क्षिणोति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83, "avatarnika": ""}, {"id": 33000295, "chapter_id": 7895, "verse_number": "84", "content_sanskrit": "अष्टौ क्षणोति मीनाति कृणातीत्यात्मनेऽप्यमी । कुन्थति पुन्थति लुन्थति रिशति रुशति हिंसति स्तृहति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84, "avatarnika": ""}, {"id": 33000296, "chapter_id": 7895, "verse_number": "85", "content_sanskrit": "तृंहति सृम्भति मृणति च चुम्बयति श्रथति च क्लथति । सर्भति मेदति दृणति स्फिट्टयति च हिंसयत्यमी चृतति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85, "avatarnika": ""}, {"id": 33000297, "chapter_id": 7895, "verse_number": "86", "content_sanskrit": "षण्णवतिहिंसायाम् उक्ताः शिष्टाश्च ये गणे दृश्याः । केवालीशेवालीकेवासीमस्मसाशब्दाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86, "avatarnika": ""}, {"id": 33000298, "chapter_id": 7895, "verse_number": "87", "content_sanskrit": "आतालीवर्षालीपार्दालीमसमसाश्च तथा । गतिसञ्ज्ञा हिंसायाम् अष्टोद्दिष्टाः करोतेः प्राक् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87, "avatarnika": ""}, {"id": 33000299, "chapter_id": 7895, "verse_number": "88", "content_sanskrit": "वस्तयते गन्धयते लुम्बति लुम्बयति चाऽर्दनार्थाः स्युः । ओहति तोहति दोहति तद्वत् तुम्बति च तुम्बयत्येते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88, "avatarnika": ""}, {"id": 33000300, "chapter_id": 7895, "verse_number": "89", "content_sanskrit": "दृम्फति दृफति दुनोति व्यथयति दुःखयति तपति पीडयति । क्लिश्नाति दूनयत्यपि धृपायति खेदयत्याद्याः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89, "avatarnika": ""}, {"id": 33000301, "chapter_id": 7895, "verse_number": "90", "content_sanskrit": "दुःखाकरोति तुदति च करोति वैकल्यमुदाद्विभ्योऽमी । आत्मनेऽपि ग्लपयति ग्लापयत्यपि पीडने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90, "avatarnika": ""}, {"id": 33000302, "chapter_id": 7895, "verse_number": "91", "content_sanskrit": "रोठते लोठते कुथ्नात्यपि मन्थति बाधते । एठते हेठते तत्र लोटते क्लेशयत्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91, "avatarnika": ""}, {"id": 33000303, "chapter_id": 7895, "verse_number": "92", "content_sanskrit": "शण्डते शूलति रुजत्यूषत्यामयतीति च । भनक्ति मोटयति च भञ्जयत्यपि मोटति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92, "avatarnika": ""}, {"id": 33000304, "chapter_id": 7895, "verse_number": "93", "content_sanskrit": "मुटति म्रदते मर्दे मृद्राति च पिनष्टि च । क्षुन्ते क्षुणत्ति सञ्चूर्णयति पाशयतीति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93, "avatarnika": ""}, {"id": 33000305, "chapter_id": 7895, "verse_number": "94", "content_sanskrit": "पंसयति ध्वंसयति च नक्कयति च धक्कयत्येते । जम्भयति क्षपयति च नाशयति च नाशनाऽर्थाः स्युः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94, "avatarnika": ""}, {"id": 33000306, "chapter_id": 7895, "verse_number": "95", "content_sanskrit": "उन्मूलयत्युज्जहाति चोत्पाटयति वै समाः। उत्खनत्यात्मनेऽप्येते पञ्चोज्जटयतीति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95, "avatarnika": ""}, {"id": 33000307, "chapter_id": 7895, "verse_number": "96", "content_sanskrit": "भङ्गे पराभवत्युक्ते पराभवत इत्यमू । जयत्युत्कर्षसम्प्राप्तौ तथा विजयते पदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96, "avatarnika": ""}]