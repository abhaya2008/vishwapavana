[{"id": 7002572000, "chapter_id": 22572, "verse_number": "२-१८-१", "content_sanskrit": "सूत उवाच ।\nअथातो होमद्रव्याणां प्रमाणमभिधीयते ।\nप्रमाणे चाप्रमाणे च निष्फलं भवति धुवम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002572001, "chapter_id": 22572, "verse_number": "२-१८-२", "content_sanskrit": "कर्षमात्रं घृतं होमे शुक्तिमात्रं पयः स्मृतम् ।\nतत्समं पञ्चगव्यं च दधि दुग्धं तथा मधु ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002572002, "chapter_id": 22572, "verse_number": "२-१८-३", "content_sanskrit": "मुष्टिमानेन पृथुका लाजाः स्युर्मुष्टिसंमिताः ।\nशर्करा मुष्टिमात्रा च शर्करातोलकं विदुः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002572003, "chapter_id": 22572, "verse_number": "२-१८-४", "content_sanskrit": "त्रितोलकं गुडं विद्यादिक्षुपर्ववि धिर्भवेत् ।\nएकैकं पत्रपुष्पाणि शालूकस्य त्रिमुष्टिकम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002572004, "chapter_id": 22572, "verse_number": "२-१८-५", "content_sanskrit": "एकलग्ने न जुहुयान्न पृथग्जुहुयात्क्वचित् ।\nसवृंतकं जपापुष्पं केशरं तत्सवृंतकम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002572005, "chapter_id": 22572, "verse_number": "२-१८-६", "content_sanskrit": "एकैकशश्च पद्मानां जलजानां तथैव च ।\nजीवंत्याः फलमानेन पिष्टकानां प्रसंख्यया ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002572006, "chapter_id": 22572, "verse_number": "२-१८-७", "content_sanskrit": "वसंतकं धात्रिमाने मोदकस्य प्रमाणतः ।\nएकैकशः फलानां च मातुलिंगत्रिखेडकम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002572007, "chapter_id": 22572, "verse_number": "२-१८-८", "content_sanskrit": "अष्टधा नालिकेरस्य पनसं दशधा भवेत् ।\nपद्मबीजप्रमाणेन कूष्मांडं चाष्टधा भवेत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002572008, "chapter_id": 22572, "verse_number": "२-१८-९", "content_sanskrit": "उर्वारुकं चाष्टधा च गुडूची चतुरंगुलम् ।\nपूगमानं च मांसस्य सगुडं तत्र दृश्यते ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002572009, "chapter_id": 22572, "verse_number": "२-१८-१०", "content_sanskrit": "अन्यत्र बदरीमानं तिंदुकं च त्रिधा कृतम् ।\nकाष्ठं प्रादेशमात्रं स्याद्दूर्वा याश्च त्रिपत्रकम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002572010, "chapter_id": 22572, "verse_number": "२-१८-११", "content_sanskrit": "भूर्जपत्रं च गृह्णीयाच्छमीं प्रादेशमात्रिकाम् ।\nव्रीहयो मुष्टिमात्राः स्युः शुक्तिमानेन सर्षपाः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002572011, "chapter_id": 22572, "verse_number": "२-१८-१२", "content_sanskrit": "मरिचाः स्युर्विमा नेन मृणालं चाथ मूलकम् ।\nसप्तखंडं च वार्ताकं त्रिपुष्टं च त्रिधोदितम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002572012, "chapter_id": 22572, "verse_number": "२-१८-१३", "content_sanskrit": "चंदनागुरुकर्पूरकस्तूरीकुंकुमानि च ।\nतित्तिडीबीजमानेन समुद्दि ष्टानि देशिकैः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002572013, "chapter_id": 22572, "verse_number": "२-१८-१४", "content_sanskrit": "समिदाप्लवने त्र्यंगतिलानामपि मध्यतः ।\nदशकं प्लावनेनैव सहस्राणां शतं विना ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002572014, "chapter_id": 22572, "verse_number": "२-१८-१५", "content_sanskrit": "एवं व्रीहिप्लावने च काष्ठवदि क्षुदंडकम् ।\nप्रोक्षणं मृदुपुष्पाणां लतादीनां तथैव च ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002572015, "chapter_id": 22572, "verse_number": "२-१८-१६", "content_sanskrit": "पायसान्ने तथान्ने च मोदके पिष्टकेऽपि च ।\nशाल्यासक्तेन जुहुयाद्व्यत्यये व्यत्ययं फलम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002572016, "chapter_id": 22572, "verse_number": "२-१८-१७", "content_sanskrit": "बिल्वपत्रस्य प्लवनं दंडं हित्वा च प्लावयेत् ।\nवृंतसंप्लावनादेव फलं हरति राक्षसः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002572017, "chapter_id": 22572, "verse_number": "२-१८-१८", "content_sanskrit": "बिल्वपत्रस्य पूर्वार्धप्राप्तमात्रेण योज येत् ।\nपत्रत्रयं तथा होमे छिन्नेभिन्नेऽतिदूषणम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002572018, "chapter_id": 22572, "verse_number": "२-१८-१९", "content_sanskrit": "न द्वित्रिप्लवनं कुर्यात्कृत्वा याति रसातलम् ।\nतस्माच्च पुत्रशिष्याद्यैर्ब्राह्मणैस्तत्त्वकोविदैः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002572019, "chapter_id": 22572, "verse_number": "२-१८-२०", "content_sanskrit": "पूर्वाशाभिमुखो भूत्वा पावयेच्च यथाक्रमात् ।\nन न्यूनं नाधिकं कुर्याच्छांतिपक्ष उदङ्मुखः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002572020, "chapter_id": 22572, "verse_number": "२-१८-२१", "content_sanskrit": "पायसान्यन्यदेवेषु यत्नेन परिव र्जयेत् ।\nन चाग्नौ दापयेद्यत्नादेतेभ्यः प्रतिपादयेत् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002572021, "chapter_id": 22572, "verse_number": "२-१८-२२", "content_sanskrit": "कनिष्ठांगुलिमासाद्य प्रकुर्यात्पर्वभूषणम् ।\nगुणदोरकमानेन तावद्धोमगतिर्बुधाः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002572022, "chapter_id": 22572, "verse_number": "२-१८-२३", "content_sanskrit": "अंगुलैर्द्वित्रिचतुरैः पत्रहोमाकृतिक्रमात् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]