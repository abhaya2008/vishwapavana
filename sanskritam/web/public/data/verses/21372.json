[{"id": 7001372000, "chapter_id": 21372, "verse_number": "५-१९-१", "content_sanskrit": "सनत्कुमार उवाच ।\nरविचन्द्रमसोर्यावन्मयूखा भासयंति हि ।\nतावत्प्रमाणा पृथिवी भूलोकस्स तु गीयते॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001372001, "chapter_id": 21372, "verse_number": "५-१९-२", "content_sanskrit": "भूमेर्योजनलक्षे तु संस्थितं रविमण्डलम् ।\nयोजनानां सहस्राणि सदैव परिसंख्यया॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001372002, "chapter_id": 21372, "verse_number": "५-१९-३", "content_sanskrit": "शशिनस्तु प्रमाणाय जगतः परिचक्षते ।\nरवेरूर्ध्वं शशी तस्थौ लक्षयोजनसंख्यया॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001372003, "chapter_id": 21372, "verse_number": "५-१९-४", "content_sanskrit": "ग्रहाणां मण्डलं कृत्स्नं शशेरुपरि संस्थितम् ।\nसनक्षत्रं सहस्राणि दशैव परितोपरि॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001372004, "chapter_id": 21372, "verse_number": "५-१९-५", "content_sanskrit": "बुधस्तस्मादथो काव्यस्तस्माद्भौमस्य मण्डलम् ।\nबृहस्पतिस्तदूर्ध्वं तु तस्योपरि शनैश्चरः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001372005, "chapter_id": 21372, "verse_number": "५-१९-६", "content_sanskrit": "सप्तर्षिमण्डलं तस्माल्लक्षेणैकेन संस्थितम् ।\nऋषिभ्य तु सहस्राणां शतादूर्ध्वं ध्रुवः स्थितः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001372006, "chapter_id": 21372, "verse_number": "५-१९-७", "content_sanskrit": "मेढीभूतस्स यस्तस्य ज्योतिश्चक्रस्य वै ध्रुवः ।\nभूर्भुवःस्वरिति ज्ञेयं भुव ऊर्ध्वं ध्रुवादवाक्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001372007, "chapter_id": 21372, "verse_number": "५-१९-८", "content_sanskrit": "एकयोजनकोटिस्तु यत्र ते कल्पवासिनः ।\nध्रुवादूर्ध्वं महर्लोकस्सप्तैते ब्रह्मणस्सुताः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001372008, "chapter_id": 21372, "verse_number": "५-१९-९", "content_sanskrit": "सनकश्च सनन्दश्च तृतीयश्च सनातनः ।\nकपिलश्चासुरिश्चैव वोढुः पंचशिखस्तथा॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001372009, "chapter_id": 21372, "verse_number": "५-१९-१०", "content_sanskrit": "उपरिष्टात्ततश्शुक्रो द्विलक्षाभ्यंतरे स्थितः ।\nद्विलक्षयोजनं तस्मादधः सोमसुतः स्मृतः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001372010, "chapter_id": 21372, "verse_number": "५-१९-११", "content_sanskrit": "द्विलक्षयोजनं तस्मादूर्ध्वं भौमस्स्थितो मुने ।\nद्विलक्षयोजनं तस्मादूर्ध्वं जीवः स्थितो गुरु॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001372011, "chapter_id": 21372, "verse_number": "५-१९-१२", "content_sanskrit": "द्विलक्षयोजनं जीवादूर्ध्वं सौरिर्व्यवस्थितः ।\nएते सप्तग्रहाः प्रोक्तास्स्वस्वराशिव्यवस्थिता॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001372012, "chapter_id": 21372, "verse_number": "५-१९-१३", "content_sanskrit": "रुद्रलक्षैर्योजनतस्सप्तोर्ध्वमृषयः स्थिताः ।\nविश्वलक्षैर्योजनतो ध्रुवस्थितिरुदाहृता॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001372013, "chapter_id": 21372, "verse_number": "५-१९-१४", "content_sanskrit": "चतुर्गुणोत्तरे चार्द्धे जनलोकात्तपः स्मृतम् ।\nवैराजा यत्र देवा वै स्थिता दाहविवर्जिताः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001372014, "chapter_id": 21372, "verse_number": "५-१९-१५", "content_sanskrit": "षड्गुणेन तपोलोकात्सत्यलोको व्यवस्थितः ।\nब्रह्मलोकः स विज्ञेयो वसंत्यमलचेतसः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001372015, "chapter_id": 21372, "verse_number": "५-१९-१६", "content_sanskrit": "सत्यधर्मरताश्चैव ज्ञानिनो ब्रह्मचारिणः ।\nयद्गामिनोऽथ भूलोकान्निवसंति हि मानवाः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001372016, "chapter_id": 21372, "verse_number": "५-१९-१७", "content_sanskrit": "भुवर्लोके तु संसिद्धा मुनयो देवरूपिणः ।\nस्वर्गलोके सुरादित्या मरुतो वसवोऽश्विनौ॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001372017, "chapter_id": 21372, "verse_number": "५-१९-१८", "content_sanskrit": "विश्वेदेवास्तथा रुद्रास्साध्या नागाः खगादयः ।\nनवग्रहास्ततस्तत्र ऋषयो वीतकल्मषाः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001372018, "chapter_id": 21372, "verse_number": "५-१९-१९", "content_sanskrit": "एते सप्त महालोकाः कालेय कथितास्तव ।\nपातालानि च सप्तैव ब्रह्माण्डस्य च विस्तरः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001372019, "chapter_id": 21372, "verse_number": "५-१९-२०", "content_sanskrit": "दधिवृक्षफलं यद्वद्वृत्तिश्चोर्ध्वमधस्तथा ।\nएतदंडकटाहेन सर्वतो वै समावृतम्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001372020, "chapter_id": 21372, "verse_number": "५-१९-२१", "content_sanskrit": "दशगुणेन पयसा सर्वतस्तत्समावृतम् ।\nवह्निना वायुना चापि नभसा तमसा तथा॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001372021, "chapter_id": 21372, "verse_number": "५-१९-२२", "content_sanskrit": "भूतादिनापि महता दिग्गुणोत्तरवेष्टितः ।\nमहांतं च समावृत्य प्रधानं पुरुषः स्थितः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001372022, "chapter_id": 21372, "verse_number": "५-१९-२३", "content_sanskrit": "अनंतस्य न तस्यास्ति संख्यापि परमात्मनः ।\nतेनानंत इति ख्यातः प्रमाणं नास्ति वै यतः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001372023, "chapter_id": 21372, "verse_number": "५-१९-२४", "content_sanskrit": "हेतुभूतस्समस्तस्य प्रकृतिस्सा परा मुने ।\nअंडानां तु सहस्राणां सहस्राण्ययुतानि च॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001372024, "chapter_id": 21372, "verse_number": "५-१९-२५", "content_sanskrit": "ईदृशानां प्रभूतानि तस्मादव्यक्तजन्मनः ।\nदारुण्यग्निस्तिले तैलं पयस्सु च यथा घृतम्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001372025, "chapter_id": 21372, "verse_number": "५-१९-२६", "content_sanskrit": "तथासौ परमात्मा वै सर्वं व्याप्यात्मवेदनः ।\nआदिबीजात्प्रसुवते ततस्तेभ्यः परेण्डजाः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001372026, "chapter_id": 21372, "verse_number": "५-१९-२७", "content_sanskrit": "तेभ्यः पुत्रास्तथान्येषां बीजान्यन्यानि वै ततः ।\nमहदादयो विशेषांतास्तद्भवंति सुरादयः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001372027, "chapter_id": 21372, "verse_number": "५-१९-२८", "content_sanskrit": "बीजाद्वृक्षप्ररोहेण यथा नापचयस्तरोः ।\nसूर्य्यकांतमणेः सूर्य्याद्यद्वद्वह्निः प्रजायते॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001372028, "chapter_id": 21372, "verse_number": "५-१९-२९", "content_sanskrit": "तद्वत्संजायते सृष्टिः शिवस्तत्रः न कामयेत् ।\nशिवशक्तिसमायोगे देवाद्याः प्रभवंति हि॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001372029, "chapter_id": 21372, "verse_number": "५-१९-३०", "content_sanskrit": "तथा स्वकर्मणैकेन प्ररोहमुपयांति वै ।\nब्रह्मा विष्णुश्च रुद्राश्च स शिवः परिगीयते॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001372030, "chapter_id": 21372, "verse_number": "५-१९-३१", "content_sanskrit": "तस्मादुद्धरते सर्वं यस्मिंश्च लयमेष्यति ।\nकर्ता क्रियाणां सर्वासां स शिवः परिगीयते॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001372031, "chapter_id": 21372, "verse_number": "५-१९-३२", "content_sanskrit": "व्यास उवाच ।\nसनत्कुमार सर्वज्ञ छिंधि मे संशयं महत् ।\nसन्ति लोका हि ब्रह्मांडादुपरिष्टान्न वा मुने॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001372032, "chapter_id": 21372, "verse_number": "५-१९-३३", "content_sanskrit": "सनत्कुमार उवाच ।\nब्रह्मांडादुपरिष्टाच्च संति लोका मुनीश्वर ।\nताञ्छृणु त्वं विशेषेण वच्मि तेऽहं समागतः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001372033, "chapter_id": 21372, "verse_number": "५-१९-३४", "content_sanskrit": "विधिलोकात्परो लोको वैकुंठ इति विश्रुतः ।\nविराजते महादीप्त्या यत्र विष्णुः प्रतिष्ठितः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001372034, "chapter_id": 21372, "verse_number": "५-१९-३५", "content_sanskrit": "तस्योपरिष्टात्कौमारो लोको हि परमाद्भुतः ।\nसेनानीः शंभुतनयो राजते यत्र सुप्रभः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001372035, "chapter_id": 21372, "verse_number": "५-१९-३६", "content_sanskrit": "ततः परमुमालोको महादिव्यो विरा जते ।\nयत्र शक्तिर्विभात्येका त्रिदेवजननी शिवा॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001372036, "chapter_id": 21372, "verse_number": "५-१९-३७", "content_sanskrit": "परात्परा हि प्रकृती रजस्सत्त्वतमोमयी ।\nनिर्गुणा च स्वयं देवी निर्विकारा शिवात्मिका॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001372037, "chapter_id": 21372, "verse_number": "५-१९-३८", "content_sanskrit": "तस्योपरिष्टाद्विज्ञेयश्शिवलोकस्सनातनः ।\nअविनाशी महादिव्यो महाशोभान्वितस्सदा॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001372038, "chapter_id": 21372, "verse_number": "५-१९-३९", "content_sanskrit": "विराजते परं ब्रह्म यत्र शंभुर्महेश्वरः ।\nत्रिदेवजनकस्वामी सर्वेषां त्रिगुणात्परः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001372039, "chapter_id": 21372, "verse_number": "५-१९-४०", "content_sanskrit": "तत ऊर्ध्वं न लोकाश्च गोलोकस्तत्समीपतः ।\nगोमातरस्सुशीलाख्यास्तत्र संति शिवप्रिया॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001372040, "chapter_id": 21372, "verse_number": "५-१९-४१", "content_sanskrit": "तत्पालः कृष्णनामा हि राजते शंकराज्ञया ।\nप्रतिष्ठितश्शिवेनैव शक्त्या स्वच्छन्दचारिणा॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001372041, "chapter_id": 21372, "verse_number": "५-१९-४२", "content_sanskrit": "शिवलोकोऽद्भुतो व्यास निराधारो मनोहरः ।\nअतिनिर्वचनीयश्च नानावस्तुविराजितः॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001372042, "chapter_id": 21372, "verse_number": "५-१९-४३", "content_sanskrit": "शिवस्तु तदधिष्ठाता सर्वदेवशिरोमणिः ।\nविष्णुब्रह्महरैस्सेव्यः परमात्मा निरञ्जनः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001372043, "chapter_id": 21372, "verse_number": "५-१९-४४", "content_sanskrit": "इति ते कथिता तात सर्वब्रह्मांडसंस्थितिः ।\nतदूर्ध्वं लोकसंस्थानं किमन्यच्छ्रोतुमिच्छसि॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]