[{"id": 2050572, "chapter_id": 2107, "verse_number": "७-३४-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2050573, "chapter_id": 2107, "verse_number": "७-३४-१", "content_sanskrit": "स्थिरो भव महाराज शोकं धारय दुर्धरम्।\nमहान्तं बन्धुनाशं ते कथयिष्यामि तच्छृशु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2050574, "chapter_id": 2107, "verse_number": "७-३४-२", "content_sanskrit": "पद्मव्यूहो महाराज आचार्येणाभिकल्पितः।\nतत्र पद्मोपमाः सर्वे राजानो विनिवेशिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2050575, "chapter_id": 2107, "verse_number": "७-३४-३", "content_sanskrit": "कुमारा राजलोकस्य निक्षिप्ताः केसरोपामाः।\nकर्णिकास्थो महाराज तस्य दुर्योधनोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2050576, "chapter_id": 2107, "verse_number": "७-३४-४", "content_sanskrit": "कृताभिसमयाः सर्वे सुवर्णविकृतध्वजाः।\nरक्ताम्बरधराः सर्वे सर्वे रक्तविभूषणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2050577, "chapter_id": 2107, "verse_number": "७-३४-५", "content_sanskrit": "सर्वे रक्तपताकाश्च सर्वे वै हेममालिनः।\nचन्दनागुरुदिग्धाङ्गाः स्रग्विणः सूक्ष्मवाससः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2050578, "chapter_id": 2107, "verse_number": "७-३४-६", "content_sanskrit": "सहिताः पर्यधावन्त कार्ष्णि प्रतियुयुत्सवः।\nतेषां दशसहस्राणि बभूवुर्दृढधन्विनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2050579, "chapter_id": 2107, "verse_number": "७-३४-७", "content_sanskrit": "पौत्रं तव पुरस्कृत्य लक्ष्मणं प्रियदर्शनम्।\nअन्योन्यसमदुःखास्ते अन्योन्यसमसाहसाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2050580, "chapter_id": 2107, "verse_number": "७-३४-८", "content_sanskrit": "अन्योन्यं स्पर्धमानाश्च अन्योन्यस्य हिते रताः।\nदुर्योधनस्तु राजेन्द्र सैन्यमध्ये व्यवस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2050581, "chapter_id": 2107, "verse_number": "७-३४-९", "content_sanskrit": "कर्णदुःशासनकृपैर्वृतो राजा महारथैः।\nदेवराजोपमः श्रीमाञ्श्वेतच्छत्राभिसंवृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2050582, "chapter_id": 2107, "verse_number": "७-३४-१०", "content_sanskrit": "चामरव्यजनाक्षेपैरुदयन्निव भास्करः।\nप्रमुखे तस्य सैन्यस्य द्रोणोऽवस्थित नायकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2050583, "chapter_id": 2107, "verse_number": "७-३४-११", "content_sanskrit": "सिन्धुराजस्तथाऽतिष्ठच्छ्रीमान्मेरुरिवाचलः।\nसिन्धुराजस्य पार्श्वस्था अश्वत्थामपुरोगमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2050584, "chapter_id": 2107, "verse_number": "७-३४-१२", "content_sanskrit": "सुतास्तव महाराज त्रिंशत्त्रिदशसन्निभाः।\nगान्धारराजः कितवः शल्यो भूरिश्रवास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2050585, "chapter_id": 2107, "verse_number": "७-३४-१३", "content_sanskrit": "पार्श्वतः सिन्धुराजस्य व्यराजन्त महारथाः।\nततः प्रववृते युद्धं तुमुलं लोमहर्षणम्।\nतावकानां परेषां च मृत्युं कृत्वा निवर्तनम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2050586, "chapter_id": 2107, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि अभिमन्युवधपर्वणि त्रयोदशदिवसयुद्धे चतुस्त्रिंशोऽध्यायः॥ ३४ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-३४-२ चक्रव्यूह इति झ.पाठः॥ ५-३४-१० प्रमुखेऽग्रे। सैन्यस्य नायको द्रोणः। अवस्थितेतिच्छन्दोनुरोधाद्विसर्गलोपः॥ ५-३४-३४ चतुस्त्रिंशोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]