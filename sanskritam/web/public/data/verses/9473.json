[{"id": 5000473000, "chapter_id": 9473, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे षट्षष्टितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000473001, "chapter_id": 9473, "verse_number": "६-६६-१", "content_sanskrit": "स लङ्घयित्वा प्राकारं गिरिकूटोपमो महान्।\nनिर्ययौ नगरात् तूर्णं कुम्भकर्णो महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000473002, "chapter_id": 9473, "verse_number": "६-६६-२", "content_sanskrit": "ननाद च महानादं समुद्रमभिनादयन्।\nविजयन्निव निर्घातान् विधमन्निव पर्वतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000473003, "chapter_id": 9473, "verse_number": "६-६६-३", "content_sanskrit": "तमवध्यं मघवता यमेन वरुणेन वा।\nप्रेक्ष्य भीमाक्षमायान्तं वानरा विप्रदुद्रुवुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000473004, "chapter_id": 9473, "verse_number": "६-६६-४", "content_sanskrit": "तांस्तु विप्रद्रुतान् दृष्ट्वा राजपुत्रोऽङ्गदोऽब्रवीत्।\nनलं नीलं गवाक्षं च कुमुदं च महाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000473005, "chapter_id": 9473, "verse_number": "६-६६-५", "content_sanskrit": "आत्मनस्तानि विस्मृत्य वीर्याण्यभिजनानि च।\nक्व गच्छत भयत्रस्ताः प्राकृता हरयो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000473006, "chapter_id": 9473, "verse_number": "६-६६-६", "content_sanskrit": "साधु सौम्या निवर्तध्वं किं प्राणान् परिरक्षथ।\nनालं युद्धाय वै रक्षो महतीयं विभीषिका ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000473007, "chapter_id": 9473, "verse_number": "६-६६-७", "content_sanskrit": "महतीमुत्थितामेनां राक्षसानां विभीषिकाम्।\nविक्रमाद् विधमिष्यामो निवर्तध्वं प्लवङ्गमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000473008, "chapter_id": 9473, "verse_number": "६-६६-८", "content_sanskrit": "कृच्छ्रेण तु समाश्वस्य संगम्य च ततस्ततः।\nवृक्षान् गृहीत्वा हरयः सम्प्रतस्थू रणाजिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000473009, "chapter_id": 9473, "verse_number": "६-६६-९", "content_sanskrit": "ते निवर्त्य तु संरब्धाः कुम्भकर्णं वनौकसः।\nनिजघ्नुः परमक्रुद्धाः समदा इव कुञ्जराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000473010, "chapter_id": 9473, "verse_number": "६-६६-१०", "content_sanskrit": "प्रांशुभिर्गिरिशृङ्गैश्च शिलाभिश्च महाबलाः।\nपादपैः पुष्पिताग्रैश्च हन्यमानो न कम्पते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000473011, "chapter_id": 9473, "verse_number": "६-६६-११", "content_sanskrit": "तस्य गात्रेषु पतिता भिद्यन्ते बहवः शिलाः।\nपादपाः पुष्पिताग्राश्च भग्नाः पेतुर्महीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000473012, "chapter_id": 9473, "verse_number": "६-६६-१२", "content_sanskrit": "सोऽपि सैन्यानि संक्रुद्धौ वानराणां महौजसाम्।\nममन्थ परमायत्तो वनान्यग्निरिवोत्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000473013, "chapter_id": 9473, "verse_number": "६-६६-१३", "content_sanskrit": "लोहितार्द्रास्तु बहवः शेरते वानरर्षभाः।\nनिरस्ताः पतिता भूमौ ताम्रपुष्पा इव द्रुमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000473014, "chapter_id": 9473, "verse_number": "६-६६-१४", "content_sanskrit": "लङ्घयन्तः प्रधावन्तो वानरा नावलोकयन्।\nकेचित् समुद्रे पतिताः केचिद् गगनमास्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000473015, "chapter_id": 9473, "verse_number": "६-६६-१५", "content_sanskrit": "वध्यमानास्तु ते वीरा राक्षसेन च लीलया।\nसागरं येन ते तीर्णाः पथा तेनैव दुद्रुवुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000473016, "chapter_id": 9473, "verse_number": "६-६६-१६", "content_sanskrit": "ते स्थलानि तदा निम्नं विवर्णवदना भयात्।\nऋक्षा वृक्षान् समारूढाः केचित् पर्वतमाश्रिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000473017, "chapter_id": 9473, "verse_number": "६-६६-१७", "content_sanskrit": "ममज्जुरर्णवे केचिद् गुहाः केचित् समाश्रिताः।\nनिपेतुः केचिदपरे केचिन्नैवावतस्थिरे।\nकेचिद् भूमौ निपतिताः केचित् सुप्ता मृता इव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000473018, "chapter_id": 9473, "verse_number": "६-६६-१८", "content_sanskrit": "तान् समीक्ष्याङ्गदो भग्नान् वानरानिदमब्रवीत्।\nअवतिष्ठत युध्यामो निवर्तध्वं प्लवंगमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000473019, "chapter_id": 9473, "verse_number": "६-६६-१९", "content_sanskrit": "भग्नानां वो न पश्यामि परिक्रम्य महीमिमाम्।\nस्थानं सर्वे निवर्तध्वं किं प्राणान् परिरक्षथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000473020, "chapter_id": 9473, "verse_number": "६-६६-२०", "content_sanskrit": "निरायुधानां क्रमतामसङ्गगतिपौरुषाः।\nदारा ह्युपहसिष्यन्ति स वै घातः सुजीवताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000473021, "chapter_id": 9473, "verse_number": "६-६६-२१", "content_sanskrit": "कुलेषु जाताः सर्वेऽस्मिन् विस्तीर्णेषु महत्सु च।\nक्व गच्छत भयत्रस्ताः प्राकृता हरयो यथा।\nअनार्याः खलु यद्भीतास्त्यक्त्वा वीर्यं प्रधावत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000473022, "chapter_id": 9473, "verse_number": "६-६६-२२", "content_sanskrit": "विकत्थनानि वो यानि भवद्भिर्जनसंसदि।\nतानि वः क्व नु यातानि सोदग्राणि हितानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000473023, "chapter_id": 9473, "verse_number": "६-६६-२३", "content_sanskrit": "भीरोः प्रवादाः श्रूयन्ते यस्तु जीवति धिक्कृतः।\nमार्गः सत्पुरुषैर्जुष्टः सेव्यतां त्यज्यतां भयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000473024, "chapter_id": 9473, "verse_number": "६-६६-२४", "content_sanskrit": "शयामहे वा निहताः पृथिव्यामल्पजीविताः।\nप्राप्नुयामो ब्रह्मलोकं दुष्प्रापं च कुयोधिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000473025, "chapter_id": 9473, "verse_number": "६-६६-२५", "content_sanskrit": "अवाप्नुयामः कीर्तिं वा निहत्वा शत्रुमाहवे।\nनिहता वीरलोकस्य भोक्ष्यामो वसु वानराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000473026, "chapter_id": 9473, "verse_number": "६-६६-२६", "content_sanskrit": "न कुम्भकर्णः काकुत्स्थं दृष्ट्वा जीवन् गमिष्यति।\nदीप्यमानमिवासाद्य पतङ्गो ज्वलनं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000473027, "chapter_id": 9473, "verse_number": "६-६६-२७", "content_sanskrit": "पलायनेन चोद्दिष्टाः प्राणान् रक्षामहे वयम्।\nएकेन बहवो भग्ना यशो नाशं गमिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000473028, "chapter_id": 9473, "verse_number": "६-६६-२८", "content_sanskrit": "एवं ब्रुवाणं तं शूरमङ्गदं कनकाङ्गदम्।\nद्रवमाणास्ततो वाक्यमूचुः शूरविगर्हितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000473029, "chapter_id": 9473, "verse_number": "६-६६-२९", "content_sanskrit": "कृतं नः कदनं घोरं कुम्भकर्णेन रक्षसा।\nन स्थानकालो गच्छामो दयितं जीवितं हि नः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000473030, "chapter_id": 9473, "verse_number": "६-६६-३०", "content_sanskrit": "एतावदुक्त्वा वचनं सर्वे ते भेजिरे दिशः।\nभीमं भीमाक्षमायान्तं दृष्ट्वा वानरयूथपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000473031, "chapter_id": 9473, "verse_number": "६-६६-३१", "content_sanskrit": "द्रवमाणास्तु ते वीरा अङ्गदेन बलीमुखाः।\nसान्त्वनैश्चानुमानैश्च ततः सर्वे निवर्तिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000473032, "chapter_id": 9473, "verse_number": "६-६६-३२", "content_sanskrit": "प्रहर्षमुपनीताश्च वालिपुत्रेण धीमता।\nआज्ञाप्रतीक्षास्तस्थुश्च सर्वे वानरयूथपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000473033, "chapter_id": 9473, "verse_number": "६-६६-३३", "content_sanskrit": "ऋषभशरभमैन्दधूम्रनीलाः\nकुमुदसुषेणगवाक्षरम्भताराः।\nद्विविदपनसवायुपुत्रमुख्या-\nस्त्वरिततराभिमुखं रणं प्रयाताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000473034, "chapter_id": 9473, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे षट्षष्टितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]