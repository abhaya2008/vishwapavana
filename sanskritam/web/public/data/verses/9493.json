[{"id": 5000493000, "chapter_id": 9493, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे षडशीतितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000493001, "chapter_id": 9493, "verse_number": "६-८६-१", "content_sanskrit": "अथ तस्यामवस्थायां लक्ष्मणं रावणानुजः।\nपरेषामहितं वाक्यमर्थसाधकमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000493002, "chapter_id": 9493, "verse_number": "६-८६-२", "content_sanskrit": "यदेतद् राक्षसानीकं मेघश्यामं विलोक्यते।\nएतदायोध्यतां शीघ्रं कपिभिश्च शिलायुधैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000493003, "chapter_id": 9493, "verse_number": "६-८६-३", "content_sanskrit": "तस्यानीकस्य महतो भेदने यत लक्ष्मण।\nराक्षसेन्द्रसुतोऽप्यत्र भिन्ने दृश्यो भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000493004, "chapter_id": 9493, "verse_number": "६-८६-४", "content_sanskrit": "स त्वमिन्द्राशनिप्रख्यैः शरैरवकिरन् परान्।\nअभिद्रवाशु यावद् वै नैतत् कर्म समाप्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000493005, "chapter_id": 9493, "verse_number": "६-८६-५", "content_sanskrit": "जहि वीर दुरात्मानं मायापरमधार्मिकम्।\nरावणिं क्रूरकर्माणं सर्वलोकभयावहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000493006, "chapter_id": 9493, "verse_number": "६-८६-६", "content_sanskrit": "विभीषणवचः श्रुत्वा लक्ष्मणः शुभलक्षणः।\nववर्ष शरवर्षेण राक्षसेन्द्रसुतं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000493007, "chapter_id": 9493, "verse_number": "६-८६-७", "content_sanskrit": "ऋक्षाः शाखामृगाश्चैव द्रुमप्रवरयोधिनः।\nअभ्यधावन्त सहितास्तदनीकमवस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000493008, "chapter_id": 9493, "verse_number": "६-८६-८", "content_sanskrit": "राक्षसाश्च शितैर्बाणैरसिभिः शक्तितोमरैः।\nअभ्यवर्तन्त समरे कपिसैन्यजिघांसवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000493009, "chapter_id": 9493, "verse_number": "६-८६-९", "content_sanskrit": "स सम्प्रहारस्तुमुलः संजज्ञे कपिरक्षसाम्।\nशब्देन महता लङ्कां नादयन् वै समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000493010, "chapter_id": 9493, "verse_number": "६-८६-१०", "content_sanskrit": "शस्त्रैश्च विविधाकारैः शितैर्बाणैश्च पादपैः।\nउद्यतैर्गिरिशृङ्गैश्च घोरैराकाशमावृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000493011, "chapter_id": 9493, "verse_number": "६-८६-११", "content_sanskrit": "राक्षसा वानरेन्द्रेषु विकृताननबाहवः।\nनिवेशयन्तः शस्त्राणि चक्रुस्ते सुमहद्भयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000493012, "chapter_id": 9493, "verse_number": "६-८६-१२", "content_sanskrit": "तथैव सकलैर्वृक्षैर्गिरिशृङ्गैश्च वानराः।\nअभिजघ्नुर्निजघ्नुश्च समरे सर्वराक्षसान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000493013, "chapter_id": 9493, "verse_number": "६-८६-१३", "content_sanskrit": "ऋक्षवानरमुख्यैश्च महाकायैर्महाबलैः।\nरक्षसां युध्यमानानां महद्भयमजायत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000493014, "chapter_id": 9493, "verse_number": "६-८६-१४", "content_sanskrit": "स्वमनीकं विषण्णं तु श्रुत्वा शत्रुभिरर्दितम्।\nउदतिष्ठत दुर्धर्षः स कर्मण्यननुष्ठिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000493015, "chapter_id": 9493, "verse_number": "६-८६-१५", "content_sanskrit": "वृक्षान्धकारान्निर्गत्य जातक्रोधः स रावणिः।\nआरुरोह रथं सज्जं पूर्वयुक्तं सुसंयतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000493016, "chapter_id": 9493, "verse_number": "६-८६-१६", "content_sanskrit": "स भीमकार्मुकशरः कृष्णाञ्जनचयोपमः।\nरक्तास्यनयनो भीमो बभौ मृत्युरिवान्तकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000493017, "chapter_id": 9493, "verse_number": "६-८६-१७", "content_sanskrit": "दृष्ट्वैव तु रथस्थं तं पर्यवर्तत तद् बलम्।\nरक्षसां भीमवेगानां लक्ष्मणेन युयुत्सताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000493018, "chapter_id": 9493, "verse_number": "६-८६-१८", "content_sanskrit": "तस्मिंस्तु काले हनुमानरुजत् स दुरासदम्।\nधरणीधरसंकाशो महावृक्षमरिंदमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000493019, "chapter_id": 9493, "verse_number": "६-८६-१९", "content_sanskrit": "स राक्षसानां तत् सैन्यं कालाग्निरिव निर्दहन्।\nचकार बहुभिर्वृक्षैर्निःसंज्ञं युधि वानरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000493020, "chapter_id": 9493, "verse_number": "६-८६-२०", "content_sanskrit": "विध्वंसयन्तं तरसा दृष्ट्वैव पवनात्मजम्।\nराक्षसानां सहस्राणि हनूमन्तमवाकिरन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000493021, "chapter_id": 9493, "verse_number": "६-८६-२१", "content_sanskrit": "शितशूलधराः शूलैरसिभिश्चासिपाणयः।\nशक्तिहस्ताश्च शक्तीभिः पट्टिशैः पट्टिशायुधाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000493022, "chapter_id": 9493, "verse_number": "६-८६-२२", "content_sanskrit": "परिघैश्च गदाभिश्च कुन्तैश्च शुभदर्शनैः।\nशतशश्च शतघ्नीभिरायसैरपि मुद‍्गरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000493023, "chapter_id": 9493, "verse_number": "६-८६-२३", "content_sanskrit": "घोरैः परशुभिश्चैव भिन्दिपालैश्च राक्षसाः।\nमुष्टिभिर्वज्रकल्पैश्च तलैरशनिसंनिभैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000493024, "chapter_id": 9493, "verse_number": "६-८६-२४", "content_sanskrit": "अभिजघ्नुः समासाद्य समन्तात् पर्वतोपमम्।\nतेषामपि च संक्रुद्धश्चकार कदनं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000493025, "chapter_id": 9493, "verse_number": "६-८६-२५", "content_sanskrit": "स ददर्श कपिश्रेष्ठमचलोपममिन्द्रजित्।\nसूदमानमसंत्रस्तममित्रान् पवनात्मजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000493026, "chapter_id": 9493, "verse_number": "६-८६-२६", "content_sanskrit": "स सारथिमुवाचेदं याहि यत्रैष वानरः।\nक्षयमेव हि नः कुर्याद् राक्षसानामुपेक्षितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000493027, "chapter_id": 9493, "verse_number": "६-८६-२७", "content_sanskrit": "इत्युक्तः सारथिस्तेन ययौ यत्र स मारुतिः।\nवहन् परमदुर्धर्षं स्थितमिन्द्रजितं रथे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000493028, "chapter_id": 9493, "verse_number": "६-८६-२८", "content_sanskrit": "सोऽभ्युपेत्य शरान् खड्गान् पट्टिशांश्च परश्वधान्।\nअभ्यवर्षत दुर्धर्षः कपिमूर्धनि राक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000493029, "chapter_id": 9493, "verse_number": "६-८६-२९", "content_sanskrit": "तानि शस्त्राणि घोराणि प्रतिगृह्य स मारुतिः।\nरोषेण महताविष्टो वाक्यं चेदमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000493030, "chapter_id": 9493, "verse_number": "६-८६-३०", "content_sanskrit": "युध्यस्व यदि शूरोऽसि रावणात्मज दुर्मते।\nवायुपुत्रं समासाद्य न जीवन् प्रतियास्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000493031, "chapter_id": 9493, "verse_number": "६-८६-३१", "content_sanskrit": "बाहुभ्यां सम्प्रयुध्यस्व यदि मे द्वन्द्वमाहवे।\nवेगं सहस्व दुर्बुद्धे ततस्त्वं रक्षसां वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000493032, "chapter_id": 9493, "verse_number": "६-८६-३२", "content_sanskrit": "हनूमन्तं जिघांसन्तं समुद्यतशरासनम्।\nरावणात्मजमाचष्टे लक्ष्मणाय विभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000493033, "chapter_id": 9493, "verse_number": "६-८६-३३", "content_sanskrit": "यः स वासवनिर्जेता रावणस्यात्मसम्भवः।\nस एष रथमास्थाय हनूमन्तं जिघांसति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000493034, "chapter_id": 9493, "verse_number": "६-८६-३४", "content_sanskrit": "तमप्रतिमसंस्थानैः शरैः शत्रुनिवारणैः।\nजीवितान्तकरैर्घोरैः सौमित्रे रावणिं जहि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000493035, "chapter_id": 9493, "verse_number": "६-८६-३५", "content_sanskrit": "इत्येवमुक्तस्तु तदा महात्मा\nविभीषणेनारिविभीषणेन।\nददर्श तं पर्वतसंनिकाशं\nरथस्थितं भीमबलं दुरासदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000493036, "chapter_id": 9493, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे षडशीतितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]