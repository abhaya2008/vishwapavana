[{"id": 2151299, "chapter_id": 4285, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2151300, "chapter_id": 4285, "verse_number": "१", "content_sanskrit": "यथा स भगवान् व्यासः कृष्णद्वैपायनोऽब्रवीत् ।\nतथैव सहिताः सर्वे समाजग्मुर्महीक्षितः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2151301, "chapter_id": 4285, "verse_number": "२", "content_sanskrit": "मघाविषयगः सोमस्तद्दिनं प्रत्यपद्यत ।\nदीप्यमानाश्च सम्पेतुर्दिवि सप्त महाग्रहाः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2151302, "chapter_id": 4285, "verse_number": "३", "content_sanskrit": "द्विधाभूत इवादित्य उदये प्रत्यदृश्यत ।\nज्वलन्त्या शिखया भूयो भानुमानुदितो दिवि ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2151303, "chapter_id": 4285, "verse_number": "४", "content_sanskrit": "ववाशिरे च दीप्तायां दिशि गोमायुवायसाः ।\nलिप्समानाः शरीराणि मांसशोणितभोजनाः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2151304, "chapter_id": 4285, "verse_number": "५", "content_sanskrit": "अहन्यहनि पार्थानां वृद्धः कुरुपितामहः ।\nभरद्वाजात्मजश्चैव प्रातरुत्थाय संयतौ ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2151305, "chapter_id": 4285, "verse_number": "६", "content_sanskrit": "जयोऽस्तु पाण्डुपुत्राणामित्यूचुररिन्दमौ ।\nयुयुधाते तवार्थाय यथा स समयः कृतः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2151306, "chapter_id": 4285, "verse_number": "७", "content_sanskrit": "सर्वधर्मविशेषज्ञः पिता देवव्रतस्तव ।\nसमानीय महीपालानिदं वचनमब्रवीत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2151307, "chapter_id": 4285, "verse_number": "८", "content_sanskrit": "इदं वः क्षत्रिया द्वारं स्वर्गायापावृतं महत् ।\nगच्छध्वं तेन शक्रस्य ब्रह्मणश्च सलोकताम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2151308, "chapter_id": 4285, "verse_number": "९", "content_sanskrit": "एष वः शाश्वतः पन्था पूर्वैः पूर्वतरैर्गतः ।\nसम्भावयत चात्मानमव्यग्रमनसो युधि ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2151309, "chapter_id": 4285, "verse_number": "१०", "content_sanskrit": "नाभागो हि ययातिश्च मान्धाता नहुषो नृगः ।\nसंसिद्धाः परमं स्थानं गताः कर्मभिरीदृशैः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2151310, "chapter_id": 4285, "verse_number": "११", "content_sanskrit": "अधर्मः क्षत्रियस्यैष यद् व्याधिमरणं गृहे ।\nयदाजौ निधनं याति सोऽस्य धर्मः सनातनः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2151311, "chapter_id": 4285, "verse_number": "१२", "content_sanskrit": "एवमुक्ता महीपाला भीष्मेण भरतर्षभ ।\nनिर्ययुः स्वान्यनीकानि शोभयन्तो रथोत्तमैः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2151312, "chapter_id": 4285, "verse_number": "१३", "content_sanskrit": "स तु वैकर्तनः कर्णः सामात्यः सह बन्धुभिः ।\nन्यासितः समरे शस्त्रं भीष्मेण भरतर्षभ ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2151313, "chapter_id": 4285, "verse_number": "१४", "content_sanskrit": "अपेतकर्णाः पुत्रास्ते राजानश्चैव तावकाः ।\nनिर्ययुः सिंहनादेन नादयन्तो दिशो दश ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2151314, "chapter_id": 4285, "verse_number": "१५", "content_sanskrit": "श्वेतैश्छत्रैः पताकाभिर्ध्वजवारणवाजिभिः ।\nतान्यनीकान्यशोभन्त रथैरथ पदातिभिः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2151315, "chapter_id": 4285, "verse_number": "१६", "content_sanskrit": "भेरीपणवशब्दैश्च पटहानां च निस्वनैः ।\nरथनेमिनिनादैश्च बभूवाकुलिता मही ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2151316, "chapter_id": 4285, "verse_number": "१७", "content_sanskrit": "काञ्चनाङ्गदकेयूरैः कार्मुकैश्च महारथाः ।\nभ्राजमाना व्यदृश्यन्त जङ्गमाः पर्वता इव ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2151317, "chapter_id": 4285, "verse_number": "१८", "content_sanskrit": "ताळेन महता भीष्मः पञ्चतारेण केतुना ।\nविमलादित्यसङ्काशस्तस्थौ कुरुचमूपतिः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2151318, "chapter_id": 4285, "verse_number": "१९", "content_sanskrit": "ये त्वदीया महेष्वासा राजानो भरतर्षभ ।\nअवर्तन्त यथादेशं राजन् शान्तनवस्य ते ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2151319, "chapter_id": 4285, "verse_number": "२०", "content_sanskrit": "शत्रुगावसनः शैब्यः सहितः सर्वराजभिः ।\nययौ मातङ्गराजेन राजार्हेण पताकिना ।\nपद्मवर्णस्त्वनीकानां सर्वेषामग्रतः स्थितः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2151320, "chapter_id": 4285, "verse_number": "२१", "content_sanskrit": "अश्वत्थामा ययौ तस्मिन् सिंहलाङ्गूलकेतनः ।\nश्रुतायुश्चित्रसेनश्च पुरुमित्रो विविंशतिः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2151321, "chapter_id": 4285, "verse_number": "२२", "content_sanskrit": "शल्यो भूरिश्रवाश्चैव विकर्णश्च महारथः ।\nएते सप्त महेष्वासा द्रोणपुत्रपुरोगमाः ।\nस्यन्दनैर्वरवर्णाभैर्भीष्मस्यासन् पुरःसराः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2151322, "chapter_id": 4285, "verse_number": "२३", "content_sanskrit": "तेषामपि महोत्सेधाः शोभयन्तो रथोत्तमान् ।\nभ्राजमाना व्यदृश्यन्त जाम्बूनदमया ध्वजाः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2151323, "chapter_id": 4285, "verse_number": "२४", "content_sanskrit": "जाम्बूनदमयी वेदिः कमण्डलुविभूषिता ।\nकेतुराचार्यमुख्यस्य द्रोणस्य धनुषा सह ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2151324, "chapter_id": 4285, "verse_number": "२५", "content_sanskrit": "अनेकशतसाहस्रमनीकमनुकर्षतः ।\nमहान् दुर्योधनस्यासीन्नागो मणिमयो ध्वजः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2151325, "chapter_id": 4285, "verse_number": "२६", "content_sanskrit": "तस्य पौरवकाळिङ्गौ काम्बोजश्च सुदक्षिणः ।\nक्षेमधन्वा सुमित्रश्च तस्थुः प्रमुखतो रथाः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2151326, "chapter_id": 4285, "verse_number": "२७", "content_sanskrit": "स्यन्दनेन महार्हेण केतुना वृषभेण च ।\nप्रकर्षन्निव सेनाग्रं मागधश्च नृपो ययौ ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2151327, "chapter_id": 4285, "verse_number": "२८", "content_sanskrit": "तदङ्गपतिना गुप्तं कृपेण च महात्मना ।\nशारदाभ्रचयप्रख्यं प्राच्यानामभवद् बलम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2151328, "chapter_id": 4285, "verse_number": "२९", "content_sanskrit": "अनीकप्रमुखे तिष्ठन् वराहेण महायशाः ।\nशुशुभे केतुमुख्येन राजतेन जयद्रथः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2151329, "chapter_id": 4285, "verse_number": "३०", "content_sanskrit": "शतं रथसहस्राणां तस्यासन् वशवर्तिनः ।\nअष्टौ नागसहस्राणि सादिनामयुतानि षट् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2151330, "chapter_id": 4285, "verse_number": "३१", "content_sanskrit": "तत्सिन्धुपतिना राजन् पालितं ध्वजिनीमुखम् ।\nअनन्तरथनागाश्वमशोभत महद् बलम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2151331, "chapter_id": 4285, "verse_number": "३२", "content_sanskrit": "षष्ठ्या रथसहस्रैस्तु नागानामयुतेन च ।\nपतिः सर्वकळिङ्गानां ययौ केतुमता सह ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2151332, "chapter_id": 4285, "verse_number": "३३", "content_sanskrit": "तस्य पर्वतसङ्काशा व्यरोचन्त महागजाः ।\nयन्त्रतोमरतूणीरैः पताकाभिश्च शोभिताः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2151333, "chapter_id": 4285, "verse_number": "३४", "content_sanskrit": "शुशुभे केतुमुख्येन पादपेन कळिङ्गपः ।\nश्वेतच्छत्रेण निष्केण चामरव्यजनेन च ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2151334, "chapter_id": 4285, "verse_number": "३५", "content_sanskrit": "केतुमानपि मातङ्गं विचित्रपरमाङ्कुशम् ।\nआस्थितः समरे राजन् मेघस्थ इव भानुमान् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2151335, "chapter_id": 4285, "verse_number": "३६", "content_sanskrit": "तेजसा दीप्यमानस्तु वारणोत्तममास्थितः ।\nभगदत्तो ययौ राजा यथा वज्रधरस्तथा ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2151336, "chapter_id": 4285, "verse_number": "३७", "content_sanskrit": "गजस्कन्धगतावास्तां भगदत्तेन सम्मितौ ।\nविन्दानुविन्दावावन्त्यौ केतुमन्तमनुव्रतौ ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2151337, "chapter_id": 4285, "verse_number": "३८", "content_sanskrit": "स रथानीकवान् व्यूहो हस्त्यङ्गोत्तमशीर्षवान् ।\nवाजिपक्षः पतन्नुग्रः प्राहरत् सर्वतोमुखः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2151338, "chapter_id": 4285, "verse_number": "३९", "content_sanskrit": "द्रोणेन विहितो राजन् राज्ञा शान्तनवेन च ।\nतथैवाचार्यपुत्रेण बाह्लीकेन कृपेण च ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2151339, "chapter_id": 4285, "verse_number": "१७", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां भीष्मपर्वणि सप्तदशोऽध्यायः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2151340, "chapter_id": 4285, "verse_number": "४", "content_sanskrit": "॥ भगवद्गीतापर्वणि चतुर्थोऽध्यायः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]