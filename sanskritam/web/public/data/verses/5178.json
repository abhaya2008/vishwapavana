[{"id": 2196023, "chapter_id": 5178, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2196024, "chapter_id": 5178, "verse_number": "१", "content_sanskrit": "प्रायश्चित्तं कृतघ्नानां प्रतिब्रूहि पितामह ।\nमातॄः पितॄन् गुरूंश्चैव येऽवमन्यन्ति मोहिताः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2196025, "chapter_id": 5178, "verse_number": "२", "content_sanskrit": "ये चाप्यन्ये परे तात कृतघ्ना निरपत्रपाः ।\nतेषां गतिं महाबाहो श्रोतुमिच्छामि तत्त्वतः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2196026, "chapter_id": 5178, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2196027, "chapter_id": 5178, "verse_number": "३", "content_sanskrit": "कृतघ्नानां गतिस्तात नरके शाश्वतीः समाः ।\nमातापितृगुरूणां च ये न तिष्ठन्त शासने ।\nक्रि(कृ)मिकीटपिपीलेषु जायन्ते स्थावरेषु च\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2196028, "chapter_id": 5178, "verse_number": "४", "content_sanskrit": "दुर्लभो हि पुनस्तेषां मानुष्ये पुनरुद्भवः ।\nअत्राप्युदाहरन्तीममितिहासं पुरातनम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2196029, "chapter_id": 5178, "verse_number": "५", "content_sanskrit": "वत्सनाभो महाप्राज्ञो महर्षिः संशितव्रतः ।\nवल्मीकभूतो ब्रह्मर्षिस्तप्यते सुमहत्तपः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2196030, "chapter_id": 5178, "verse_number": "६", "content_sanskrit": "तस्मिंश्च तप्यति तपो वासवो भरतर्षभ ।\nववर्ष सुमहद् वर्षं सविद्युत्स्तनयित्नुमान्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2196031, "chapter_id": 5178, "verse_number": "७", "content_sanskrit": "तत्र सप्ताहवर्षं तु मुमुचे पाकशासनः ।\nनिमीलिताक्षस्तद्वर्षं प्रत्यगृह्यत वै द्विजः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2196032, "chapter_id": 5178, "verse_number": "८", "content_sanskrit": "तस्मिन् पतति वर्षे तु शीतवातसमन्विते ।\nविशीर्णध्वस्तशिखरो वल्मीकोऽशनिताडितः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2196033, "chapter_id": 5178, "verse_number": "९", "content_sanskrit": "ताड्यमाने ततस्तस्मिन् वत्सनाभे महात्मनि ।\nकारुण्यात् तस्य धर्मस्तु स्वमानृशंस्यमथाकरोत्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2196034, "chapter_id": 5178, "verse_number": "१०", "content_sanskrit": "चिन्तयानस्य ब्रह्मर्षिं तपन्तमतिधार्मिकम् ।\nअनुरूपा मतिः क्षिप्रमुपजाता स्वभावजा\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2196035, "chapter_id": 5178, "verse_number": "११", "content_sanskrit": "स्वं रूपं माहिषं कृत्वा सुमहान्तं मनोहरम् ।\nरक्षार्थं वत्सनाभस्य चतुष्पादुपरिस्थितः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2196036, "chapter_id": 5178, "verse_number": "१२", "content_sanskrit": "यदा त्वपगतं वर्षं वृष्टिवातसमन्वितम् ।\nततो महिषरूपेण धर्मो धर्मभृतांवर\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2196037, "chapter_id": 5178, "verse_number": "१३", "content_sanskrit": "शनैर्वल्मीकमुत्सृज्य प्राद्रवद् भरतर्षभ ।\nस्थितेऽस्मिन् वृष्टिसम्पाते वीक्षते स्म महातपाः ।\nदिशश्च विपुलास्तत्र गिरीणां शिखराणि च\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2196038, "chapter_id": 5178, "verse_number": "१४", "content_sanskrit": "दृष्ट्वा च पृथिवीं सर्वां सलिलेन परिप्लुताम् ।\nजलाशयान् स तान् दृष्ट्वा विप्रः प्रमुदितोऽभवत्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2196039, "chapter_id": 5178, "verse_number": "१५", "content_sanskrit": "अचिन्तयद् विस्मितश्च वर्षात् केनास्मि रक्षितः ।\nततोऽपश्यत् तत्र महिषमवस्थितमदूरतः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2196040, "chapter_id": 5178, "verse_number": "१६", "content_sanskrit": "तिर्यग्योनावपि कथं दृश्यते धर्मवत्सलः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2196041, "chapter_id": 5178, "verse_number": "१७", "content_sanskrit": "अतो नु भद्रं महिषः शिलापट्ट इव स्थितः ।\nपीवरश्चैव बल्यश्च बहुमांसो भवेदयम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2196042, "chapter_id": 5178, "verse_number": "१८", "content_sanskrit": "तस्य बुद्धिरियं जाता धर्मसंसक्तजा मुनेः ।\nकृतघ्ना नरकं यान्ति ये च विश्वस्तघातिनः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2196043, "chapter_id": 5178, "verse_number": "१९", "content_sanskrit": "निष्कृतिं नैव पश्यामि कृतघ्नानां कथञ्चन ।\nऋते प्राणपरित्यागाद् धर्मज्ञानां वचो यथा\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2196044, "chapter_id": 5178, "verse_number": "२०", "content_sanskrit": "अकृत्वा भरणं पित्रोरदत्त्वा गुरुदक्षिणाम् ।\nकृतघ्नतां च सम्प्राप्य मरणान्ता च निष्कृतिः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2196045, "chapter_id": 5178, "verse_number": "२१", "content_sanskrit": "आकाङ्क्षायामुपेक्षायां चोपपातकमुत्तमम् ।\nतस्मात् प्राणान् परित्यक्ष्ये प्रायश्चित्तार्थमित्युत\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2196046, "chapter_id": 5178, "verse_number": "२२", "content_sanskrit": "स मेरुशिखरं गत्वा निःसङ्गेनान्तरात्मना ।\nप्रायश्चित्तं कर्तुकामः शरीरं त्यक्तुमुद्यतः ।\nनिगृहीतश्च धर्मात्मा हस्ते धर्मेण धर्मवित्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2196047, "chapter_id": 5178, "verse_number": "", "content_sanskrit": "धर्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2196048, "chapter_id": 5178, "verse_number": "२३", "content_sanskrit": "वत्सनाभ महाप्राज्ञ बहुवर्षशतायुष ।\nपरितुष्टोऽस्मि त्यागेन निःसङ्गेन तथाऽऽत्मनः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2196049, "chapter_id": 5178, "verse_number": "२४", "content_sanskrit": "एवं धर्मभृतः सर्वे विमृशन्ति कृताकृतम् ।\nन कश्चिद् वत्सनाभस्य यस्य नोपहतं मनः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2196050, "chapter_id": 5178, "verse_number": "२५", "content_sanskrit": "यश्चानवद्यश्चरति शक्तो धर्मं च सर्वशः ।\nनिवर्तस्व महाप्राज्ञ पूतात्मा ह्यसि शाश्वतः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2196051, "chapter_id": 5178, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि\nदानधर्मे वत्सनाभोपाख्यानं नाम एकोनत्रिंशोऽध्यायः ॥३०॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]