[{"id": 2018564, "chapter_id": 1388, "verse_number": "३-११-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2018565, "chapter_id": 1388, "verse_number": "३-११-१", "content_sanskrit": "वसत्सु वै द्वैतवने पाण्डवेषु महात्मसु।\nअनुकीर्णं महारण्यं ब्राह्मणैः समपद्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2018566, "chapter_id": 1388, "verse_number": "३-११-२", "content_sanskrit": "ईर्यमाणेन सततं ब्रह्मघोषेण सर्वशः।\nब्रह्मलोकसमं पुण्यमासीद्द्वैतवनं सरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2018567, "chapter_id": 1388, "verse_number": "३-११-३", "content_sanskrit": "यजुषामृचां साम्नां च गद्यानां चैव सर्वशः।\nआसीदुच्चार्यमाणानां निःस्वनो हृदयंगमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2018568, "chapter_id": 1388, "verse_number": "३-११-४", "content_sanskrit": "ज्याघोषश्चैव पार्थानां ब्रह्मघोषश्च धीमताम्।\nसंसृष्टं ब्रह्मणा क्षत्रं भूय एव व्यरोचत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2018569, "chapter_id": 1388, "verse_number": "३-११-५", "content_sanskrit": "अथाब्रवीद्बको दाल्भ्यो धर्मराजं युधिष्ठिरम्।\nसन्ध्यां कौन्तेयमासीनमृषिभिः परिवारितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2018570, "chapter_id": 1388, "verse_number": "३-११-६", "content_sanskrit": "पश्य द्वैतवने पार्थ ब्राह्मणानां तपस्विनाम्।\nहोमवेलां कुरुश्रेष्ठ संप्रज्वलितपावकाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2018571, "chapter_id": 1388, "verse_number": "३-११-७", "content_sanskrit": "चरन्ति धर्मं पुण्येऽस्मिंस्त्वया गुप्ता धृतव्रताः।\nभृगवोऽङ्गिरसश्चैव वासिष्ठाः काश्यपैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2018572, "chapter_id": 1388, "verse_number": "३-११-८", "content_sanskrit": "आगस्त्याश्च महाभागा आत्रेयाश्चोत्तमव्रताः।\nसर्वस्य जगतः श्रेष्ठा ब्राह्मणाः संगतास्त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2018573, "chapter_id": 1388, "verse_number": "३-११-९", "content_sanskrit": "इदं तु वचनं पार्थ शृण्वेकाग्रमना मम।\nभ्रातृभिः सह कौन्तेय यत्त्वां वक्ष्यामि कौरव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2018574, "chapter_id": 1388, "verse_number": "३-११-१०", "content_sanskrit": "ब्राह्म क्षत्रेण संसृष्टं क्षत्रं च ब्रह्मणा सह।\nउदीर्णे दहतः शत्रून्वनानीवाग्निमारुतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2018575, "chapter_id": 1388, "verse_number": "३-११-११", "content_sanskrit": "नाब्राह्मणस्तात चिरं बुभूषे-\nदिच्छन्नमं लोकममुं च जेतुम्।\nविनीतधर्मार्थमपेतमोहं\nलब्ध्वा द्विजं हन्ति नृपः सपत्नान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2018576, "chapter_id": 1388, "verse_number": "३-११-१२", "content_sanskrit": "चरन्नैश्रेयसं धर्मं प्रजापालनकारितम्।\nनाध्यगच्छद्बलिर्लोके तीर्थमन्यत्र वै द्विजात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2018577, "chapter_id": 1388, "verse_number": "३-११-१३", "content_sanskrit": "अनूनमासीदसुरस्य कामै-\nवैरोचनेः श्रीरपि चाक्षयाऽऽसीत्।\nलब्ध्वा महीं ब्राह्मणसंप्रयोगा-\nत्तेष्वाचरन्दुष्टमयथो व्यनश्यत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2018578, "chapter_id": 1388, "verse_number": "३-११-१४", "content_sanskrit": "नाब्राह्मणं भूमिरियं सभूति-\nर्वर्णं द्वितीयं भजते चिराय।\nसमुद्रनेमिर्नमते तु तस्मै\nयं ब्राह्मणः शास्ति नयैर्विनीतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2018579, "chapter_id": 1388, "verse_number": "३-११-१५", "content_sanskrit": "कुञ्चरस्येव संग्रामे परिगृह्याङ्कुशग्रहम्।\nब्राह्माणैर्विप्रहीनस्य क्षत्रस्य क्षीयते बलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2018580, "chapter_id": 1388, "verse_number": "३-११-१६", "content_sanskrit": "ब्राह्मण्यनुपमा दृष्टिः क्षात्रमप्रतिमं बलम्।\nतौ यदा चरतः सार्धं तदा लोकः प्रसीदती ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2018581, "chapter_id": 1388, "verse_number": "३-११-१७", "content_sanskrit": "यथा हि सुमहानग्निः कक्षं दहति सानिलः।\nतथा दहति राजन्यो ब्राह्मणेन समं रिपुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2018582, "chapter_id": 1388, "verse_number": "३-११-१८", "content_sanskrit": "ब्राह्मणेष्वेव मेधावी बुद्धिपर्येषणं चरेत्।\nअलब्धस्य च लाभाय लब्धस्य परिवृद्धये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2018583, "chapter_id": 1388, "verse_number": "३-११-१९", "content_sanskrit": "अलब्धलाभाय च लब्धवृद्धये।\nयथार्हतीर्थप्रतिपादनाय।\nयशस्विनं वेदविदं विपश्चितं\nबहुश्रुं ब्राह्मणमेव वासयेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2018584, "chapter_id": 1388, "verse_number": "३-११-२०", "content_sanskrit": "ब्राह्मणेषूत्तमा भक्तिस्तव नित्यं युधिष्ठिर।\nतेन ते सर्वलोकेषु दीप्यते प्रथितं यशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2018585, "chapter_id": 1388, "verse_number": "३-११-२१x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2018586, "chapter_id": 1388, "verse_number": "३-११-२१", "content_sanskrit": "ततस्ते ब्राह्मणाः सर्वे बकं दाल्भ्यमंपूजयन्।\nयुधिष्ठिरं स्तूयमाने भूयः सुमनसोऽभवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2018587, "chapter_id": 1388, "verse_number": "३-११-२२", "content_sanskrit": "द्वैपायनो नारदश्च जामदग्न्यः पृथुश्रवाः।\nइन्द्रद्युम्नो भालुकिश्च कृतचेताः सहस्रपात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2018588, "chapter_id": 1388, "verse_number": "३-११-२३", "content_sanskrit": "कर्णश्रवाश्च मुञ्जश्च लवणाश्वश्च काश्यपः।\nहारीतः स्थूणकर्णश्च अग्निवेश्योऽथ शौनकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2018589, "chapter_id": 1388, "verse_number": "३-११-२४", "content_sanskrit": "कृतवाक्च सुवाश्चैव बृहदश्चो विभावसुः।\nऊर्ध्वरेता वृषामित्रः सुहोत्रो होत्रवाहनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2018590, "chapter_id": 1388, "verse_number": "३-११-२५", "content_sanskrit": "एते चान्ये च बहवो ब्राह्मणाः संशितव्रताः।\nअजातशत्रुमानर्चुः पुरंदरमिवर्षयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2018591, "chapter_id": 1388, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि अर्जुनाबिगमनपर्वणि षड्विंशोऽध्यायः ॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]