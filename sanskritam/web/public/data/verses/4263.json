[{"id": 2150407, "chapter_id": 4263, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2150408, "chapter_id": 4263, "verse_number": "१", "content_sanskrit": "शिखण्डिवाक्यं श्रुत्वाऽथ स यक्षो भरतर्षभ ।\nप्रोवाच मनसा चिन्त्य दैवेनोपनिपीडितः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2150409, "chapter_id": 4263, "verse_number": "२", "content_sanskrit": "भवितव्यं यथा तद्धि मम दुःखाय कौरव\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2150410, "chapter_id": 4263, "verse_number": "", "content_sanskrit": "स्थूणाकर्णः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2150411, "chapter_id": 4263, "verse_number": "३", "content_sanskrit": "भद्रे कामं करिष्यामि समयं तु निबोध मे\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2150412, "chapter_id": 4263, "verse_number": "४", "content_sanskrit": "स्वं ते पुंस्त्वं प्रदास्यामि स्त्रीत्वं धारयितास्मि ते ।\nकञ्चित् कालं तु ते दास्ये पुँल्लिङ्गं स्वमिदं तव\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2150413, "chapter_id": 4263, "verse_number": "५", "content_sanskrit": "आगन्तव्यं त्वया काले सत्यं चैव वदस्व मे\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2150414, "chapter_id": 4263, "verse_number": "६", "content_sanskrit": "प्रभुः सङ्कल्पसिद्धोऽस्मि कामरूपी विहङ्गमः ।\nमत्प्रसादात् पुरं चैव त्राहि बन्धूंश्च केवलम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2150415, "chapter_id": 4263, "verse_number": "७", "content_sanskrit": "स्त्रीलिङ्गं धारयिष्यामि तवेदं पार्थिवात्मजे ।\nसत्यं मे प्रतिजानीहि करिष्यामि प्रियं तव\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2150416, "chapter_id": 4263, "verse_number": "", "content_sanskrit": "शिखण्डी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2150417, "chapter_id": 4263, "verse_number": "८", "content_sanskrit": "प्रतिदास्यामि भगवन् पुँल्लिङ्गं तव सुव्रत ।\nकिञ्चित् कालान्तरं स्त्रीत्वं धारयस्व निशाचर\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2150418, "chapter_id": 4263, "verse_number": "९", "content_sanskrit": "प्रतियाते दशार्णे तु पार्थिवे हेमवर्मणि ।\nकन्यैव हि भविष्यामि पुरुषस्त्वं भविष्यसि\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2150419, "chapter_id": 4263, "verse_number": "१०", "content_sanskrit": "इत्युक्त्वा समयं तत्र चक्राते तावुभौ नृप ।\nअन्योन्यस्यानभिद्रोहे तौ सङ्क्रामयतुस्तदा\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2150420, "chapter_id": 4263, "verse_number": "११", "content_sanskrit": "स्त्रीलिङ्गं धारयामास स्थूणो यक्षोऽथ भारत ।\nयक्षरूपं च तद्दीप्तं शिखण्डी प्रत्यपद्यत\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2150421, "chapter_id": 4263, "verse_number": "१२", "content_sanskrit": "ततः शिखण्डी पाञ्चाल्यः पुंस्त्वमासाद्य भारत ।\nविवेश नगरं हृष्टः पितरं च समासदत्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2150422, "chapter_id": 4263, "verse_number": "१३", "content_sanskrit": "यथावृत्तं तु तत्सर्वमाचख्यौ द्रुपदस्य तत् ।\nमातुश्च रहिते राजन् प्रसादं यक्षजं तदा\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2150423, "chapter_id": 4263, "verse_number": "१४", "content_sanskrit": "द्रुपदस्तस्य तच्छ्रुत्वा हर्षमाहारयत् परम् ।\nसभार्यस्तच्च सस्मार महेश्वरवचस्तदा\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2150424, "chapter_id": 4263, "verse_number": "१५", "content_sanskrit": "ततः सम्प्रेषयामास दशार्णाधिपतेर्नृपः ।\nपुरुषोऽयं मम सुतः श्रद्दधातु भवानिति\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2150425, "chapter_id": 4263, "verse_number": "१६", "content_sanskrit": "अथ दाशार्णको राजा सहसाऽभ्यागमत् तदा ।\nपाञ्चालराजं द्रुपदं दुःखशोकसमन्वितः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2150426, "chapter_id": 4263, "verse_number": "१७", "content_sanskrit": "ततः काम्पिल्यमासाद्य दशार्णाधिपतिस्ततः ।\nप्रेषयामास सत्कृत्य दूतं ब्रह्मविदां वरम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2150427, "chapter_id": 4263, "verse_number": "१८", "content_sanskrit": "ब्रूहि मद्वचनाद् दूत पाञ्चाल्यं तं नृपाधमम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2150428, "chapter_id": 4263, "verse_number": "१९", "content_sanskrit": "यन्मे कन्यां स्वकन्यार्थे वृतवानसि दुर्मते ।\nफलं तस्यावलेपस्य द्रक्ष्यस्यद्य न संशयः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2150429, "chapter_id": 4263, "verse_number": "२०", "content_sanskrit": "एवमुक्तश्च तेनासौ ब्राह्मणो राजसत्तम ।\nदूतः प्रयातो नगरं दाशार्णनृपचोदितः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2150430, "chapter_id": 4263, "verse_number": "२१", "content_sanskrit": "तत आसादयामास पुरोधा द्रुपदं पुरे\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2150431, "chapter_id": 4263, "verse_number": "२२", "content_sanskrit": "तस्मिन् पाञ्चालको राजा गामर्घ्यं च सुसत्कृतम् ।\nप्रापयामास राजेन्द्र सह तेन शिखण्डिना\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2150432, "chapter_id": 4263, "verse_number": "२३", "content_sanskrit": "तां पूजां नाभ्यनन्दत् स वाक्यं चेदमुवाच ह ।\nयदुक्तं तेन वीरेण राज्ञा काञ्चनवर्मणा\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2150433, "chapter_id": 4263, "verse_number": "२४", "content_sanskrit": "यत् तेऽहमधमाचार दुहित्राऽस्म्यभिवञ्चितः ।\nतस्य पापस्य करणात् फलं प्राप्नुहि दुर्मते\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2150434, "chapter_id": 4263, "verse_number": "२५", "content_sanskrit": "देहि युद्धं नरपते ममाद्य रणमूर्धनि ।\nउद्धरिष्यामि सद्यस्त्वां सामात्यसुतबान्धवम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2150435, "chapter_id": 4263, "verse_number": "२६", "content_sanskrit": "तदुपालम्भसंयुक्तं श्रावितः किल पार्थिव ।\nदशार्णपतिदूतेन मन्त्रिमध्ये पुरोधसा\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2150436, "chapter_id": 4263, "verse_number": "२७", "content_sanskrit": "अब्रवीद् भरतश्रेष्ठ द्रुपदः प्रणयाद् वचः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2150437, "chapter_id": 4263, "verse_number": "२८", "content_sanskrit": "यदाह मां भवान् ब्रह्मन् सम्बन्धिवचनाद् वचः ।\nअस्योत्तरं प्रतिवचो दूतो राज्ञो वदिष्यति\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2150438, "chapter_id": 4263, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2150439, "chapter_id": 4263, "verse_number": "२९", "content_sanskrit": "ततः सम्प्रेषयामास द्रुपदोऽपि महात्मने ।\nहिरण्यवर्मणे दूतं ब्राह्मणं वेदपारगम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2150440, "chapter_id": 4263, "verse_number": "३०", "content_sanskrit": "समागम्य तु राजाऽसौ दशार्णाधिपतिस्तदा ।\nतद्वाक्यमाददे राजन् यदुक्तं द्रुपदेन ह\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2150441, "chapter_id": 4263, "verse_number": "३१", "content_sanskrit": "आगमः क्रियतां व्यक्तं कुमारोऽयं सुतो मम ।\nमिथ्यैतदुक्तं केनापि तन्न श्रद्धेयमित्युत\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2150442, "chapter_id": 4263, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2150443, "chapter_id": 4263, "verse_number": "३२", "content_sanskrit": "ततः स राजा द्रुपदस्य श्रुत्वा\nविमर्दनार्थं युवतीर्वरिष्ठाः ।\nसम्प्रेषयामास सुचारुरूपाः\nशिखण्डिनं स्त्री पुमान् वेति वेत्तुम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2150444, "chapter_id": 4263, "verse_number": "३३", "content_sanskrit": "ताः प्रेषितास्तत्त्वभावं विदित्वा\nप्रीत्या राज्ञे तच्छशंसुर्हि सर्वम् ।\nशिखण्डिनं पुरुषं कौरवेन्द्र\nदशार्णराजाय महानुभावम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2150445, "chapter_id": 4263, "verse_number": "३४", "content_sanskrit": "ततः कृत्वा तु राजा स आगमं प्रीतिमानथ ।\nसम्बन्धिना समागम्य हृष्टो मासमुवास ह\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2150446, "chapter_id": 4263, "verse_number": "३५", "content_sanskrit": "शिखण्डिने च मुदितः प्रादाद् वित्तं जनेश्वरः ।\nहस्तिनोऽश्वांश्च गाश्चैव दासीर्बहुशतास्तथा\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2150447, "chapter_id": 4263, "verse_number": "३६", "content_sanskrit": "पूजितश्च प्रतिययौ निमन्त्र्य तनयां किल\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2150448, "chapter_id": 4263, "verse_number": "३७", "content_sanskrit": "विनीतकिल्बिषे प्रीते हेमवर्मणि पार्थिवे ।\nप्रतियाते दशार्णे तु हृष्टरूपा शिखण्डिनी\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2150449, "chapter_id": 4263, "verse_number": "३८", "content_sanskrit": "कस्यचित्त्वथ कालस्य कुबेरो नरवाहनः ।\nलोकयात्रां प्रकुर्वाणः स्थूणस्यागान्निवेशनम्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2150450, "chapter_id": 4263, "verse_number": "३९", "content_sanskrit": "स तद्गृहस्योपरि वर्तमान\nआलोकयामास धनाधिगोप्ता ।\nस्थूणस्य यक्षस्य विवेश वेश्म\nस्वलङ्कृतं माल्यगुणैर्विचित्रैः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2150451, "chapter_id": 4263, "verse_number": "४०", "content_sanskrit": "लाजैश्च गन्धैश्च तथा वितानैः\nअभ्यर्चितं धूपनधूपितं च ।\nध्वजैः पताकाभिरलङ्कृतं च\nभक्ष्यान्नपेयामिषदत्तमोदम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2150452, "chapter_id": 4263, "verse_number": "४१", "content_sanskrit": "तत् स्थानं तस्य दृष्ट्वा तु सर्वतः समलङ्कृतम् ।\nमणिरत्नसुवर्णानां मालाभिः परिपूरितम्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2150453, "chapter_id": 4263, "verse_number": "४२", "content_sanskrit": "नानाकुसुमगन्धाढ्यं सिक्तसम्मृष्टशोभितम् ।\nअथाब्रवीद् यक्षपतिस्तान् यक्षाननुगांस्तदा\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2150454, "chapter_id": 4263, "verse_number": "४३", "content_sanskrit": "स्वलङ्कृतमिदं वेश्म स्थूणस्यामितविक्रमाः ।\nनोपसर्पति मां चैव कस्मादद्य स मन्दधीः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2150455, "chapter_id": 4263, "verse_number": "४४", "content_sanskrit": "यस्माज्जानन् स मन्दात्मा मामसौ नोपसर्पति ।\nतस्मात् तस्मै महादण्डो धार्यः स्यादिति मे मतिः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2150456, "chapter_id": 4263, "verse_number": "", "content_sanskrit": "यक्षाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2150457, "chapter_id": 4263, "verse_number": "४५", "content_sanskrit": "द्रुपदस्य सुता राजन् राज्ञो जाता शिखण्डिनी ।\nतस्या निमित्ते कस्मिंश्चित् प्रादात् पुरुषलक्षणम्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2150458, "chapter_id": 4263, "verse_number": "४६", "content_sanskrit": "अग्रहील्लक्षणं स्त्रीणां स्त्रीभूता तिष्ठते गृहे ।\nनोपसर्पति तेनासौ सव्रीडः स्त्रीस्वरूपवान्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2150459, "chapter_id": 4263, "verse_number": "४७", "content_sanskrit": "एतस्मात् कारणाद् राजन् स्थूणो न त्वाऽद्य पश्यति ।\nश्रुत्वा कुरु यथा न्याय्यं विमानमिह तिष्ठताम्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2150460, "chapter_id": 4263, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2150461, "chapter_id": 4263, "verse_number": "४८", "content_sanskrit": "आनीयतां स्थूण इति ततो यक्षाधिपोऽब्रवीत् ।\nकर्तास्मि निग्रहं तस्य प्रत्युवाच पुनः पुनः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2150462, "chapter_id": 4263, "verse_number": "४९", "content_sanskrit": "सोऽभ्यगच्छत यक्षेन्द्रमाहूतः पृथिवीपते ।\nस्त्रीस्वरूपो महाराज तस्थौ व्रीडासमन्वितः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2150463, "chapter_id": 4263, "verse_number": "५०", "content_sanskrit": "तं शशापाथ सङ्क्रुद्धो धनदः कुरुनन्दन\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2150464, "chapter_id": 4263, "verse_number": "५१", "content_sanskrit": "एवमेव भवत्वस्य स्त्रीत्वं पापस्य गुह्यकाः\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2150465, "chapter_id": 4263, "verse_number": "५२", "content_sanskrit": "ततोऽब्रवीद् यक्षपतिर्महात्मा\nयस्माददास्त्ववमत्येह यक्षान् ।\nशिखण्डिनो लक्षणं पापबुद्धे\nस्त्रीलक्षणं चाग्रहीः पापकर्मन्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2150466, "chapter_id": 4263, "verse_number": "५३", "content_sanskrit": "अप्रवृत्तं सुदुर्बुद्धे यस्मादेतत् त्वया कृतम् ।\nतस्मादद्यप्रभृत्येव स्त्री त्वं सा पुरुषस्तथा\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2150467, "chapter_id": 4263, "verse_number": "५४", "content_sanskrit": "ततः प्रसादयामासुर्यक्षा वैश्रवणं किल ।\nस्थूणस्यार्थे कुरुष्वान्तं शापस्येति पुनः पुनः\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2150468, "chapter_id": 4263, "verse_number": "५५", "content_sanskrit": "ततो महात्मा यक्षेन्द्रः प्रत्युवाचानुगामिनः ।\nसर्वान् यक्षगणांस्तात शापस्यान्तचिकीर्षया\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2150469, "chapter_id": 4263, "verse_number": "५६", "content_sanskrit": "हते शिखण्डिनि रणे स्वं रूपं प्रतिपत्स्यते ।\nस्थूणो यक्षो निरुद्वेगो भवत्विति महामनाः\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2150470, "chapter_id": 4263, "verse_number": "५७", "content_sanskrit": "इत्युक्त्वा भगवान् देवो यक्षराजः सुपूजितः ।\nप्रययौ सहितः सर्वैर्निमेषान्तरचारिभिः\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2150471, "chapter_id": 4263, "verse_number": "५८", "content_sanskrit": "स्थूणस्तु शापं सम्प्राप्य तत्रैव न्यवसत् तदा ।\nसमये चागमत् तूर्णं शिखण्डी तं क्षपाचरम्\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2150472, "chapter_id": 4263, "verse_number": "५९", "content_sanskrit": "सोऽभिगम्याब्रवीद् वाक्यं प्राप्तोऽस्मि भगवन्निति ।\nतमब्रवीत् ततः स्थूणः प्रीतोऽस्मीति पुनः पुनः\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2150473, "chapter_id": 4263, "verse_number": "६०", "content_sanskrit": "आर्जवेनागतं दृष्ट्वा राजपुत्रं शिखण्डिनम् ।\nसर्वमेव यथावृत्तमाचचक्षे शिखण्डिने\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2150474, "chapter_id": 4263, "verse_number": "", "content_sanskrit": "यक्षः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2150475, "chapter_id": 4263, "verse_number": "६१", "content_sanskrit": "शप्तो वैश्रवणेनाहं त्वत्कृते पार्थिवात्मज ।\nगच्छेदानीं यथाकामं चर लोकान् यथासुखम्\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2150476, "chapter_id": 4263, "verse_number": "६२", "content_sanskrit": "दिष्टमेतत् पुरा मन्ये न शक्यमतिवर्तितुम् ।\nगमनं तव चेतो हि पौलस्त्यस्य च दर्शनम्\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2150477, "chapter_id": 4263, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2150478, "chapter_id": 4263, "verse_number": "६३", "content_sanskrit": "एवमुक्तः शिखण्डी तु स्थूणयक्षेण भारत ।\nक्षिप्रं जगाम नगरं हर्षेण महता वृतः\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2150479, "chapter_id": 4263, "verse_number": "६४", "content_sanskrit": "पूजयामास विविधैर्गन्धमाल्यैर्मनोरमैः ।\nद्विजातीन् देवताश्चैव चैत्यानथ चतुष्पथान्\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2150480, "chapter_id": 4263, "verse_number": "६५", "content_sanskrit": "द्रुपदः सह पुत्रेण सिद्धार्थेन शिखण्डिना ।\nमुदं च परमां लेभे पाञ्चाल्यः सह बान्धवैः\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2150481, "chapter_id": 4263, "verse_number": "६६", "content_sanskrit": "शिष्यार्थं प्रददौ चाथ द्रोणाय कुरुपुङ्गव ।\nशिखण्डिनं महाराज पुत्रं स्त्रीपूर्विणं तथा\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2150482, "chapter_id": 4263, "verse_number": "६७", "content_sanskrit": "प्रतिपेदे चतुष्पादं धनुर्वेदं नृपात्मजः ।\nशिखण्डी सह युष्माभिर्धृष्टद्युम्नश्च पार्षतः\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2150483, "chapter_id": 4263, "verse_number": "६८", "content_sanskrit": "मम त्वेतच्चरास्तात यथावत् प्रत्यवेदयन् ।\nजडान्धबधिराकारा ये मुक्ता द्रुपदे मया\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2150484, "chapter_id": 4263, "verse_number": "६९", "content_sanskrit": "एवमेव महाराज स्त्री पुमान् द्रुपदात्मजः ।\nस सम्भूतः कुरुश्रेष्ठ शिखण्डी रथसत्तमः\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2150485, "chapter_id": 4263, "verse_number": "७०", "content_sanskrit": "ज्येष्ठा काशीपतेः कन्या अम्बा नामेति विश्रुता ।\nद्रुपदस्य कुले जाता शिखण्डी भरतर्षभ\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2150486, "chapter_id": 4263, "verse_number": "७१", "content_sanskrit": "नाहमेनं धनुष्पाणिं युयुत्सुं समुपस्थितम् ।\nमुहूर्तमपि पश्येयं प्रहरेयं न चाप्युत\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2150487, "chapter_id": 4263, "verse_number": "७२", "content_sanskrit": "व्रतमेतन्मम सदा पृथिव्यामपि विश्रुतम्\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2150488, "chapter_id": 4263, "verse_number": "७३", "content_sanskrit": "स्त्रियां स्त्रीपूर्वके चापि स्त्रीनाम्नि स्त्रीस्वरूपिणि ।\nन मुञ्चेयमहं बाणमिति कौरवनन्दन\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2150489, "chapter_id": 4263, "verse_number": "७४", "content_sanskrit": "न हन्यामहमेतेन कारणेन शिखण्डिनम् ।\nएतत् तत्त्वमहं वेद जन्म तात शिखण्डिनः\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2150490, "chapter_id": 4263, "verse_number": "७५", "content_sanskrit": "अतो नैनं हनिष्यामि समरेष्वाततायिनम् ।\nयदि भीष्मः स्त्रियं हन्यात् सन्तः कुर्युर्विगर्हणाम्\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2150491, "chapter_id": 4263, "verse_number": "७६", "content_sanskrit": "नैनं तस्माद्धनिष्यामि दृष्ट्वाऽपि समरे स्थितम्\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2150492, "chapter_id": 4263, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2150493, "chapter_id": 4263, "verse_number": "७७", "content_sanskrit": "एतच्छ्रुत्वा तु कौरव्यो राजा दुर्योधनस्तदा ।\nमुहूर्तमिव स ध्यात्वा भीष्मे युक्तममन्यत\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2150494, "chapter_id": 4263, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि चतुर्नवत्युत्तरशततमोऽध्यायः ॥१९४॥\nअम्बोपाख्यानपर्वणि चतुर्विंशोऽध्यायः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}]