[{"id": 2049497, "chapter_id": 2087, "verse_number": "७-१४-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2049498, "chapter_id": 2087, "verse_number": "७-१४-१", "content_sanskrit": "ततः स पाण्डवानीके जनयन्सुमहद्भयम्।\nव्यचरत्पृतनां द्रोणो दहन्कक्षमिवानलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2049499, "chapter_id": 2087, "verse_number": "७-१४-२", "content_sanskrit": "निर्दहन्तमनीकानि साक्षादग्निमिवोत्थितम्।\nदृष्ट्वा रुक्मरथं क्रुद्धं समकम्पन्त सृञ्जयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2049500, "chapter_id": 2087, "verse_number": "७-१४-३", "content_sanskrit": "सततं कृष्यतः सङ्ख्ये धनुषोऽस्याशुकारिणः।\nज्याघोषः शुश्रुवेऽत्यर्थं विस्फूर्जितमिवाशनेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2049501, "chapter_id": 2087, "verse_number": "७-१४-४", "content_sanskrit": "रथिनः सादिनश्चैव नागानश्वान्पदातिनः।\nरौद्रा हस्तवता मुक्ताः सम्मृद्गन्ति स्स सायकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2049502, "chapter_id": 2087, "verse_number": "७-१४-५", "content_sanskrit": "नानद्यमानः पर्जन्यः प्रवृद्धः शुचिसङ्क्षये।\nअश्मवर्षमिवावर्षत्परेषामावहद्भयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2049503, "chapter_id": 2087, "verse_number": "७-१४-६", "content_sanskrit": "विचरन्स दिशः सर्वाः सेनां सङ्क्षोभयन्प्रभुः।\nवर्धयामास सन्त्रासं शात्रवाणाममानुषम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2049504, "chapter_id": 2087, "verse_number": "७-१४-७", "content_sanskrit": "तस्य विद्युदिवाभ्रेषु चापं हेमपरिष्कृतम्।\nभ्राजमानं रथे तस्मिन्दृश्यते स्म महाभयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2049505, "chapter_id": 2087, "verse_number": "७-१४-८", "content_sanskrit": "स वीरः सत्यवान्प्राज्ञो धर्मनित्यः सदा पुनः।\nयुगान्तकालवद्धोरां रौद्रां प्रावर्तयन्नदीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2049506, "chapter_id": 2087, "verse_number": "७-१४-९", "content_sanskrit": "अमर्षवेगप्रभवां क्रव्यादगणसङ्कुलाम्।\nबलौघैः सर्वतः पूर्णां ध्वजवृक्षापहारिणीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2049507, "chapter_id": 2087, "verse_number": "७-१४-१०", "content_sanskrit": "शोणितोदां रथावर्तां हस्त्यश्वकृतरोधसम्।\nकवचोडुपसंयुक्तां मांसपङ्कसमाकुलाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2049508, "chapter_id": 2087, "verse_number": "७-१४-११", "content_sanskrit": "मेदोमज्जास्थिसिकतामुष्मीषचयफेनिलाम्॥\nसङ्ग्रामजलदापूर्णां प्रासमत्स्यसमाकुलाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2049509, "chapter_id": 2087, "verse_number": "७-१४-१२", "content_sanskrit": "नरनागाश्वकलिलां शरवेगौघवाहिनीम्।\nशरीरदारुसङ्घाटां रथकच्छपसङ्कुलाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2049510, "chapter_id": 2087, "verse_number": "७-१४-१३", "content_sanskrit": "उत्तमाङ्गैः पङ्कजिनीं निस्त्रिंशझषसङ्कुलाम्।\nरथनागहूदोपेतां नानाभारणभूषिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2049511, "chapter_id": 2087, "verse_number": "७-१४-१४", "content_sanskrit": "महारथशतावर्तां भूमिरेणूर्मिमालिनीम्।\nमहावीर्यवतां सङ्ख्ये सुतरां भीरुदुस्तराम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2049512, "chapter_id": 2087, "verse_number": "७-१४-१५", "content_sanskrit": "शरीरशतसम्बाधां गृध्रकङ्कनिषेविताम्।\nमहारथसहस्राणि नयन्तीं यमसादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2049513, "chapter_id": 2087, "verse_number": "७-१४-१६", "content_sanskrit": "शूलव्यालसमाकीर्णां प्राणिवाजिनिषेविताम्।\nछिन्नक्षत्रमहाहंसां मुकुटाण्डजसेविताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2049514, "chapter_id": 2087, "verse_number": "७-१४-१७", "content_sanskrit": "चक्रकूर्माङ्गदानक्रां शरक्षुद्रझषाकुलाम्।\nबकगृध्रसृगालानां घोरसङ्घैर्निषेविताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2049515, "chapter_id": 2087, "verse_number": "७-१४-१८", "content_sanskrit": "निहतान्प्राणिनः सङ्ख्ये द्रोणेन बलिना रणे।\nवहन्तीं पितृलोकाय शतशो राजसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2049516, "chapter_id": 2087, "verse_number": "७-१४-१९", "content_sanskrit": "शऱीरशतसम्बाधां केशशैवलशाद्वलाम्।\nनदीं प्रावर्तयद्राजन्भीरूपणां भयवर्धिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2049517, "chapter_id": 2087, "verse_number": "७-१४-२०", "content_sanskrit": "तर्जयन्तमनीकानि तानि तानि महारथम्।\nसर्वतोऽभ्यद्रवन्द्रोणं युधिष्ठिरपुरोगमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2049518, "chapter_id": 2087, "verse_number": "७-१४-२१", "content_sanskrit": "तानभिद्रवतः शूरांस्तावका दृढविक्रमाः।\nसर्वतः प्रत्यगृह्णन्त तदभूद्रोमहर्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2049519, "chapter_id": 2087, "verse_number": "७-१४-२२", "content_sanskrit": "शतमायस्तु शकुनिः सहदेवं समाद्रवत्।\nसनियन्तृध्वजरथं विव्याघ निशितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2049520, "chapter_id": 2087, "verse_number": "७-१४-२३", "content_sanskrit": "तस्य माद्रीसुतः केतुं धनुः सूतं हयानपि।\nनातिक्रुद्धः शरैश्छित्त्वा षष्ठ्या विव्याध सौबलम्।\n`भित्त्वा च शरवर्षेण शकुनिं प्रत्यवारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2049521, "chapter_id": 2087, "verse_number": "७-१४-२४", "content_sanskrit": "गदां गृहीत्वा शकुनिः प्रचस्कन्द रथोत्तमात्।\nस तस्य गदया राजन्रथात्सूतमपातयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2049522, "chapter_id": 2087, "verse_number": "७-१४-२५", "content_sanskrit": "ततस्तौ विरथौ राजन्गदाहस्तौ महाबलौ।\nचिक्रीडतू रणे शूरौ सशृङ्गाविव पर्वतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2049523, "chapter_id": 2087, "verse_number": "७-१४-२६", "content_sanskrit": "द्रोणः पाञ्चालदायादं विव्याध निशितैः शरैः।\nतयोस्तत्र महाराज बाणवर्षैः प्रकाशितम्।\nखद्योतैरिव चाकाशं प्रदोषे पुरुषर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2049524, "chapter_id": 2087, "verse_number": "७-१४-२७", "content_sanskrit": "विविंशतिं भीमसेनो विंशत्या निशितैः शरैः।\nविद्ध्वा नाकम्पयद्वीरस्तदद्भुतमिवाभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2049525, "chapter_id": 2087, "verse_number": "७-१४-२८", "content_sanskrit": "विविंशतिस्तु सहसा व्यश्वकेतुशरासनम्।\nभीमं चक्रे महाराज ततः सैन्यान्यपूजयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2049526, "chapter_id": 2087, "verse_number": "७-१४-२९", "content_sanskrit": "स तन्न ममृषे वीरः शत्रोर्विक्रममाहवे।\nततोऽस्य गदया दान्तान्हयात्सर्वानपातयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2049527, "chapter_id": 2087, "verse_number": "७-१४-३०", "content_sanskrit": "हताश्वात्स रथाद्राजन्गृह्य चर्म महाबलः।\nअभ्ययाद्भीमसेनं तु मत्तो मत्तमिव द्विपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2049528, "chapter_id": 2087, "verse_number": "७-१४-३१", "content_sanskrit": "शल्यस्तु नकुलं वीरः स्वस्रीयं प्रियमात्मनः।\nविव्याध प्रहसन्बाणैर्लालयन्कोपयन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2049529, "chapter_id": 2087, "verse_number": "७-१४-३२", "content_sanskrit": "तस्याश्वानातपत्रं च ध्वजं सूतमथो धनुः।\nनिपात्य नकुलः सङ्ख्ये शङ्खं दध्मौ प्रतापवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2049530, "chapter_id": 2087, "verse_number": "७-१४-३३", "content_sanskrit": "धृष्टकेतुः कृपेणास्ताञ्छित्त्वा बहुविधाञ्छरान्।\nकृपं विव्याध सप्तत्या ध्वजं चास्य त्रिभिः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2049531, "chapter_id": 2087, "verse_number": "७-१४-३४", "content_sanskrit": "तं कृपः शरवर्षेण महता समवारयत्।\nविव्याध च रणे विप्रो धृष्टकेतुममर्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2049532, "chapter_id": 2087, "verse_number": "७-१४-३५", "content_sanskrit": "सात्यकिः कृतवर्माणं नाराचेन स्तनान्तरे।\nविद्ध्वा विव्याध सप्तत्या पुनरन्यैः स्मयन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2049533, "chapter_id": 2087, "verse_number": "७-१४-३६", "content_sanskrit": "तं भोजः सप्तसप्तत्या विद्ध्वाऽऽशु निशितैः शरैः।\nनाकम्पयत शैनेयं शीघ्रो वायुरिवाचलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2049534, "chapter_id": 2087, "verse_number": "७-१४-३७", "content_sanskrit": "सेनापतिः सुशर्माणं भृशं मर्मस्वताडयत्।\nस चापि तं तोमरेण जत्रुदेशेऽभ्यताडयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2049535, "chapter_id": 2087, "verse_number": "७-१४-३८", "content_sanskrit": "वैकर्तनं तु समरे विराटः प्रत्यवारयत्।\nसह मत्स्यैर्महावीर्यैस्तदद्भुतमिवाभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2049536, "chapter_id": 2087, "verse_number": "७-१४-३९", "content_sanskrit": "तत्पौरुषमभूत्तत्र सूतपुत्रस्य दारुणम्।\nयत्सैन्यं वारयामास शरैः सन्नतपर्वभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2049537, "chapter_id": 2087, "verse_number": "७-१४-४०", "content_sanskrit": "द्रुपदस्तु स्वयं राजा भगदत्तेन सङ्गतः।\nतयोर्युद्धं महाराज चित्ररूपमिवाभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2049538, "chapter_id": 2087, "verse_number": "७-१४-४१", "content_sanskrit": "भगदत्तस्तु राजानं द्रुपदं नतपर्वभिः।\nसनियन्तृध्वजरथं विव्याध पुरुषर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2049539, "chapter_id": 2087, "verse_number": "७-१४-४२", "content_sanskrit": "द्रुपदस्तु ततः क्रुद्धो भगदत्तं महारथम्।\nआजघानोरसि क्षिप्रं शरेणानतपर्वणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2049540, "chapter_id": 2087, "verse_number": "७-१४-४३", "content_sanskrit": "युद्धं योधवरौ लोके सौमदत्तिशिखण्डिनौ।\nभूतानां त्रासजननं चक्रातेऽस्त्रविशारदौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2049541, "chapter_id": 2087, "verse_number": "७-१४-४४", "content_sanskrit": "भूरिश्रवा रणे राजन्याज्ञसेनिं महारथम्।\nमहता सायकौघेन च्छादयामास वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2049542, "chapter_id": 2087, "verse_number": "७-१४-४५", "content_sanskrit": "शिखण्डी तु ततः क्रुद्धः सौमदत्तिं विशाम्पते।\nनवत्या सायकानां तु कम्पयामास भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2049543, "chapter_id": 2087, "verse_number": "७-१४-४६", "content_sanskrit": "राक्षसौ रौद्रकर्माणौ हेडिम्बालम्बुसावुभौ।\nचक्रातेऽत्युद्भुतं युद्धं परस्परजयैषिणौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2049544, "chapter_id": 2087, "verse_number": "७-१४-४७", "content_sanskrit": "मायाशतसृजौ दृप्तौ मायाभिरितरेतरम्।\nअन्तर्हितौ चेरतुस्तौ भृशं विस्मयकारिणौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2049545, "chapter_id": 2087, "verse_number": "७-१४-४८", "content_sanskrit": "चेकितानोऽनुविन्देन युयुधे चातिभैरवम्।\nयथा देवासुरे युद्धे बलशक्रौ महाबलौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2049546, "chapter_id": 2087, "verse_number": "७-१४-४९", "content_sanskrit": "लक्ष्मणः क्षत्रदेवेन विमर्दमकरोद्भृशम्।\nयथा विष्णुः पुरा राजन्हिरण्याक्षेण संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2049547, "chapter_id": 2087, "verse_number": "७-१४-५०", "content_sanskrit": "ततः प्रचलिताश्वेन विधिवत्कल्पितेन च।\nरथेनाभ्यपतद्राजन्सौभद्रं पौरवो पौरवो नदन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2049548, "chapter_id": 2087, "verse_number": "७-१४-५१", "content_sanskrit": "ततोऽभ्ययात्स त्वरितो युद्धाकाङ्क्षी महाबलः।\nतेन चक्रे महद्युद्धमभिमन्युररिन्दमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2049549, "chapter_id": 2087, "verse_number": "७-१४-५२", "content_sanskrit": "पौरवस्त्वथ सौभद्रं शरव्रातैरवाकिरत्।\nतस्यार्जुनिर्ध्वजं छत्रं धनुश्चोर्व्यामपातयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2049550, "chapter_id": 2087, "verse_number": "७-१४-५३", "content_sanskrit": "सौभद्रः पौरवं त्वन्यैर्विद्ध्वा सप्तभिराशुगैः।\nपञ्चभिस्तस्य विव्याध हयान्सूनं च सायकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2049551, "chapter_id": 2087, "verse_number": "७-१४-५४", "content_sanskrit": "ततः प्रहर्षयन्सेनां सिंहवद्विनदन्मुहुः।\nसमादत्तार्जुनिस्तूर्णं पौरवान्तकरं शरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2049552, "chapter_id": 2087, "verse_number": "७-१४-५५", "content_sanskrit": "तं तु सन्धितमाज्ञाय सायकं घोरदर्शनम्।\nद्वाभ्यां शराभ्यां हार्दिक्यश्चिच्छेद सशरं धनुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2049553, "chapter_id": 2087, "verse_number": "७-१४-५६", "content_sanskrit": "तदुत्सृज्य धनुश्छिन्नं सौभद्रः परवीरहा।\nउद्बबर्ह सितं खङ्गमाददनाः शरावरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2049554, "chapter_id": 2087, "verse_number": "७-१४-५७", "content_sanskrit": "स तेनानेकतारेण चर्मणा कृतहस्तवत्।\nभ्रान्तासिना चरन्मार्गान्दर्शयन्वीर्यमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2049555, "chapter_id": 2087, "verse_number": "७-१४-५८", "content_sanskrit": "भ्रामितं पुनरुद्धान्तमाधूतं पुनरुत्थितम्।\nचर्मनिस्त्रिंशयो राजन्निर्विशेषमदृश्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2049556, "chapter_id": 2087, "verse_number": "७-१४-५९", "content_sanskrit": "स पौरवरथस्येषामाप्लुत्य सहसा नदन्।\nपौरवं रथमास्थाय केशपक्षे परामृशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2049557, "chapter_id": 2087, "verse_number": "७-१४-६०", "content_sanskrit": "जघानास्य पदा सूतमसिना पातयद्धृजम्।\nविक्षोभ्याम्भोनिधिं तार्क्ष्यस्तं नागमिव चाक्षिपत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2049558, "chapter_id": 2087, "verse_number": "७-१४-६१", "content_sanskrit": "तमागलितकेशान्तं ददृशुः सर्वपार्थिवाः।\nउक्षाणमिव सिंहेन पात्यमानमचेतसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2049559, "chapter_id": 2087, "verse_number": "७-१४-६२", "content_sanskrit": "तमार्जुनिवशं प्राप्तं कृष्यमाणमनाथवत्।\nपौरवं पातितं दृष्ट्वा नामृष्यत जयद्रूथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2049560, "chapter_id": 2087, "verse_number": "७-१४-६३", "content_sanskrit": "स बर्हिबर्हावततं किङ्किणीशतजालवत्।\nचर्म चादाय खङ्गं च नदन्पर्यपतद्रथात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2049561, "chapter_id": 2087, "verse_number": "७-१४-६४", "content_sanskrit": "ततः सैन्धवमालोक्य कार्ष्णिरुत्सृज्य पौरवम्।\nउत्पपात रथात्तूर्णं श्येनवन्निपपात च।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2049562, "chapter_id": 2087, "verse_number": "७-१४-६५", "content_sanskrit": "प्रासपट्टिशनिस्त्रिंशाञ्छत्रुभिः सम्प्रचोदितान्।\nचिच्छेद चासिना कार्ष्णिश्चर्मणा संरुरोध च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2049563, "chapter_id": 2087, "verse_number": "७-१४-६६", "content_sanskrit": "स दर्शयित्वा सैन्यानां स्वबाहुबलमात्मनः।\nतमुद्यम्य महाखङ्गं चर्म चाथ पुनर्बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2049564, "chapter_id": 2087, "verse_number": "७-१४-६७", "content_sanskrit": "वृद्धक्षत्रस्य दायादं पितुरत्यन्तवैरिणम्।\nससाराभिमुखः शूरः शार्दूल इव कुञ्जरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2049565, "chapter_id": 2087, "verse_number": "७-१४-६८", "content_sanskrit": "तौ परस्परमासाद्य खह्गदन्तनखायुधौ।\nहृष्टवत्सम्प्रजहाते व्याघ्रकेसरिणाविव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2049566, "chapter_id": 2087, "verse_number": "७-१४-६९", "content_sanskrit": "सम्पातेष्वभिघातेषु निपातेष्वसिचर्मणोः।\nन तयोरन्तरं कश्चिद्ददर्श नरसिंहयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2049567, "chapter_id": 2087, "verse_number": "७-१४-७०", "content_sanskrit": "अवक्षेपोऽसिनिर्हादः शस्त्रान्तरनिदर्शनम्।\nबाह्यान्तरनिपातश्च निर्विशेमदृश्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2049568, "chapter_id": 2087, "verse_number": "७-१४-७१", "content_sanskrit": "बाह्यमाभ्यन्तरं चैव चरन्तौ मार्गमुत्तमम्।\nददृशाते महात्मानौ सपक्षाविव पर्वतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2049569, "chapter_id": 2087, "verse_number": "७-१४-७२", "content_sanskrit": "ततो विक्षिपतः खङ्गं सौभद्रस्य यशस्विनः।\nशरावरणपक्षान्ते प्रजहार जयद्रथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2049570, "chapter_id": 2087, "verse_number": "७-१४-७३", "content_sanskrit": "रुक्मपत्रान्तरे सक्तस्तस्मिंश्चर्मणि भास्वरे।\nसिन्धुराजबलोद्धूतः सोऽभज्यत महानसिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2049571, "chapter_id": 2087, "verse_number": "७-१४-७४", "content_sanskrit": "भग्नमाज्ञाय निस्त्रिंशमवप्लुत्य पदानि षट्।\nअदृश्यत निमेषेण स्वरथं पुनरास्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2049572, "chapter_id": 2087, "verse_number": "७-१४-७५", "content_sanskrit": "तं कार्ष्णिं समरान्मुक्तमास्थितं रथमुत्तमम्।\nसहिताः सर्वराजानः परिवव्रुः समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2049573, "chapter_id": 2087, "verse_number": "७-१४-७६", "content_sanskrit": "ततश्चर्म च खङ्गं च समुत्क्षिप्य महाबलः।\nननादार्जुनदायादः प्रेक्षमाणो जयद्रथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2049574, "chapter_id": 2087, "verse_number": "७-१४-७७", "content_sanskrit": "सिन्धुराजं परित्यज्य सौभद्रः परवीरहा।\nतापयामास तत्सैन्यं भुवनं भास्करो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2049575, "chapter_id": 2087, "verse_number": "७-१४-७८", "content_sanskrit": "तस्य सर्वायसीं शक्तिं शल्यः कनकभूषणाम्।\nचिक्षेप समरे घोरां दीप्तामग्निशिखामिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2049576, "chapter_id": 2087, "verse_number": "७-१४-७९", "content_sanskrit": "तामवप्लुत्य जग्राह विकोशं चाकरोदसिम्।\nवैनतेयो यथा कार्ष्णिः पतन्तमुरगोत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2049577, "chapter_id": 2087, "verse_number": "७-१४-८०", "content_sanskrit": "तस्य लाषवमाज्ञाय सत्वं चामिततेजसः।\nसहिताः सर्वराजानः सिंहनादमथानदन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2049578, "chapter_id": 2087, "verse_number": "७-१४-८१", "content_sanskrit": "ततस्तामेव शल्यस्य सौभद्रः परवीरहा।\nमुमोच भुजवीर्येण वैदूर्यविकृतां शिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2049579, "chapter_id": 2087, "verse_number": "७-१४-८२", "content_sanskrit": "सा तस्य रथमासाद्य निर्मुक्तभुजगोपमा।\nजघान सूतं शल्यस्य रथाच्चैनमपातयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2049580, "chapter_id": 2087, "verse_number": "७-१४-८३", "content_sanskrit": "ततो विराटद्रुपदौ धृष्टकेतुर्युधिष्ठिरः।\nसात्यकिः केकया भीमो धृष्टद्युम्नशिखण्डिनौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2049581, "chapter_id": 2087, "verse_number": "७-१४-८४", "content_sanskrit": "यमौ च द्रौपदेयाश्च साधुसाध्विति चुक्रुशुः।\nबाणशब्दाश्च विविधाः सिंहनादाश्च पुष्कलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2049582, "chapter_id": 2087, "verse_number": "७-१४-८५", "content_sanskrit": "प्रादुरासन्हर्षयन्तः सौभद्रमपलायिनम्।\nतन्नामृष्यन्त पुत्रास्ते शत्रोर्विजयलक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2049583, "chapter_id": 2087, "verse_number": "७-१४-८६", "content_sanskrit": "अथैनं सहसा सर्वे समन्तान्निशितैः शरैः।\nअभ्याकिरन्महाराज जलदा इव पर्वतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2049584, "chapter_id": 2087, "verse_number": "७-१४-८७", "content_sanskrit": "तेषां च प्रियमन्विच्छन्सूतस्य च पराभवम्।\nआर्तायनिरमित्रघ्नः क्रुद्धः सौभद्रमभ्ययात्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2049585, "chapter_id": 2087, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि द्रोणाभिषेकपर्वणि एकादशदिवसयुद्धे चतुर्दशोऽध्यायः॥ १४ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-१४-५ शुचिसङ्क्षये ग्रीष्मान्ते॥ ५-१४-१६ प्राणिन एव वाजिनः पक्षिणः॥ ५-१४-८७ पराभवं प्रेक्ष्येति शेषः॥ ५-१४-१४ चतुर्दशोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}]