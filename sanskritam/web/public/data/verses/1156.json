[{"id": 2008088, "chapter_id": 1156, "verse_number": "१-१५७-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2008089, "chapter_id": 1156, "verse_number": "१-१५७-१", "content_sanskrit": "पाण्डवास्तु रथान्युक्तान्सदश्वैरनिलोपमैः।\nआरोहमाणा भीष्मस्य पादौ जगृहुरार्तवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2008090, "chapter_id": 1156, "verse_number": "१-१५७-२", "content_sanskrit": "राज्ञश्च धृतराष्ट्रस्य द्रोणस्य च महात्मनः।\nअन्येषां चैव वृद्धानां कृपस्य विदुरस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2008091, "chapter_id": 1156, "verse_number": "१-१५७-३", "content_sanskrit": "एवं सर्वान्कुरून्वृद्धानभिवाद्य यतव्रताः।\nसमालिङ्ग्य समानान्वै बालैश्चाप्यभिवादिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2008092, "chapter_id": 1156, "verse_number": "१-१५७-४", "content_sanskrit": "सर्वा मातॄस्तथाऽऽपृच्छ्य कृत्वा चैव प्रदक्षिणम्।\nप्रकृतीरपि सर्वाश्च प्रययुर्वारणावतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2008093, "chapter_id": 1156, "verse_number": "१-१५७-५", "content_sanskrit": "विदुरश्च महाप्राज्ञस्तथाऽन्ये कुरुपुङ्गवाः।\nपौराश्च पुरुषव्याघ्रानन्वीयुः शोककर्शिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2008094, "chapter_id": 1156, "verse_number": "१-१५७-६", "content_sanskrit": "तत्र केचिद्ब्रुवन्ति स्म ब्राह्मणा निर्भयास्तदा।\nदीनान्दृष्ट्वा पाण्डुसुतानतीव भृशदुःखिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2008095, "chapter_id": 1156, "verse_number": "१-१५७-७", "content_sanskrit": "विषमं पश्यते राजा सर्वथा स सुमन्दधीः।\nकौरव्यो धृतराष्ट्रस्तु न च धर्मं प्रपश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2008096, "chapter_id": 1156, "verse_number": "१-१५७-८", "content_sanskrit": "न हि पापमपापात्मा रोचयिष्यति पाण्डवः।\nभीमो वा बलिनां श्रेष्ठः कौन्तेयो वा धनञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2008097, "chapter_id": 1156, "verse_number": "१-१५७-९", "content_sanskrit": "कुत एव महात्मानौ माद्रीपुत्रौ करिष्यतः।\nतान्राज्यं पितृतः प्राप्तान्धृतराष्ट्रो न मृष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2008098, "chapter_id": 1156, "verse_number": "१-१५७-१०", "content_sanskrit": "अधर्म्यमिदमत्यन्तं कथं भीष्मोऽनुमन्यते।\nविवास्यमानानस्थाने नगरे योऽभिमन्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2008099, "chapter_id": 1156, "verse_number": "१-१५७-११", "content_sanskrit": "पितेव हि नृपोऽस्माकमभूच्छान्तनवः पुरा।\nविचित्रवीर्यो राजर्षिः पाण्डुश्च कुरुनन्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2008100, "chapter_id": 1156, "verse_number": "१-१५७-१२", "content_sanskrit": "स तस्मिन्पुरुषव्याघ्रे देवभावं गते सति।\nराजपुत्रानिमान्बालान्धृतराष्ट्रो न मृष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2008101, "chapter_id": 1156, "verse_number": "१-१५७-१३", "content_sanskrit": "वयमेतदनिच्छन्तः सर्व एव पुरोत्तमात्।\nगृहान्विहाय गच्छामो यत्र गन्ता युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2008102, "chapter_id": 1156, "verse_number": "१-१५७-१४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2008103, "chapter_id": 1156, "verse_number": "१-१५७-१४", "content_sanskrit": "तांस्तथा वादिनः पौरान्दुःकितान्दुःखकर्शितः।\nउवाच मनसा ध्यात्वा धर्मराजो युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2008104, "chapter_id": 1156, "verse_number": "१-१५७-१५", "content_sanskrit": "पिता मान्यो गुरुः श्रेष्ठो यदाह पृथिवीपतिः।\nअशङ्कमानैस्तत्कार्यमस्माभिरिति नो व्रतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2008105, "chapter_id": 1156, "verse_number": "१-१५७-१६", "content_sanskrit": "भवन्तः सुहृदोऽस्माकं यात कृत्वा प्रदक्षिणम्।\nप्रतिनन्द्य तथाऽऽशीर्भिर्निवर्तध्वं यथागृहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2008106, "chapter_id": 1156, "verse_number": "१-१५७-१७", "content_sanskrit": "यदा तु कार्यमस्माकं भवद्भिरुपपत्स्यते।\nतदा करिष्यथास्माकं प्रियाणि च हितानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2008107, "chapter_id": 1156, "verse_number": "१-१५७-१८", "content_sanskrit": "एवमुक्तास्तदा पौराः कृत्वा चापि प्रदक्षिणम्।\nआशीर्भिश्चाभिनन्द्यैताञ्जग्मुर्नगरमेव हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2008108, "chapter_id": 1156, "verse_number": "१-१५७-१९", "content_sanskrit": "पौरेषु विनिवृत्तेषु विदुरः सर्वधर्मवित्।\nबोधयन्पाण्डवश्रेष्ठमिदंवचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2008109, "chapter_id": 1156, "verse_number": "१-१५७-२०", "content_sanskrit": "प्राज्ञः प्राज्ञं प्रलापज्ञः प्रलापज्ञमिदं वचः।\nयो जानाति परप्रज्ञां नीतिशास्त्रानुसारिणीम्।\nविज्ञायेह तथा कुर्यादापदं निस्तरेद्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2008110, "chapter_id": 1156, "verse_number": "१-१५७-२१", "content_sanskrit": "अलोहं निशितं शस्त्रं शरीपरिकर्तनम्।\nयो वेत्ति न तु तं घ्नन्ति प्रतिघातविदं द्विषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2008111, "chapter_id": 1156, "verse_number": "१-१५७-२२", "content_sanskrit": "कक्षघ्नः शिशिरघ्नश्च महाकक्षे बिलौकसः।\nन दहेदिति चात्मानं यो रक्षति स जीवति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2008112, "chapter_id": 1156, "verse_number": "१-१५७-२३", "content_sanskrit": "नाचक्षुर्वेत्ति पन्थानं नाचक्षुर्विन्दते दिशः।\nनाधृतिर्भूतिमाप्नोति बुध्यस्वैवं प्रबोधितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2008113, "chapter_id": 1156, "verse_number": "१-१५७-२४", "content_sanskrit": "अनाप्तैर्दत्तमादत्ते नरः शस्त्रमलोहजम्।\nश्वाविच्छरणमासाद्य प्रमुच्येत हुताशनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2008114, "chapter_id": 1156, "verse_number": "१-१५७-२५", "content_sanskrit": "चरन्मार्गान्विजानाति नक्षत्रैर्विन्दते दिशः।\nआत्मना चात्मनः पञ्च पीडयन्नानुपीड्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2008115, "chapter_id": 1156, "verse_number": "१-१५७-२६", "content_sanskrit": "एवमुक्तः प्रत्युवाच धर्मराजो युधिष्ठिरः।\nविदुरं विदुषां श्रेष्ठं ज्ञातमित्येव पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2008116, "chapter_id": 1156, "verse_number": "१-१५७-२७", "content_sanskrit": "अनुशिक्ष्यानुगम्यैतान्कृत्वा चैव प्रदक्षिणम्।\nपाण्डवानभ्यनुज्ञाय विदुरः प्रययौ गृहान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2008117, "chapter_id": 1156, "verse_number": "१-१५७-२८", "content_sanskrit": "निवृत्ते विदुरे चापि भीष्मे पौरजने तथा।\nअजातशत्रुमासाद्य कुन्ती वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2008118, "chapter_id": 1156, "verse_number": "१-१५७-२९", "content_sanskrit": "क्षत्ता यदब्रवीद्वाक्यं जनमध्येऽब्रुवन्निव।\nत्वया च स तथेत्युक्तो जानीमो न च तद्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2008119, "chapter_id": 1156, "verse_number": "१-१५७-३०", "content_sanskrit": "यदीदं शक्यमस्माभिर्ज्ञातुं नैव च दोषवत्।\nश्रोतुमिच्छामि तत्सर्वं संवादं तव तस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2008120, "chapter_id": 1156, "verse_number": "१-१५७-३१x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2008121, "chapter_id": 1156, "verse_number": "१-१५७-३१", "content_sanskrit": "विषादग्नेश्च बोद्धव्यमिति मां विदुरोऽब्रवीत्।\nपन्थानो वेदितव्याश्च नक्षत्रैश्च तथा दिशः।\nकुड्याश्चविदिताःकार्याःस्याच्छुद्धिरितिचाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2008122, "chapter_id": 1156, "verse_number": "१-१५७-३२", "content_sanskrit": "जितेन्द्रियश्च वसुधां प्राप्स्यतीति च मेऽब्रवीत्।\nविज्ञातमिति तत्सर्वं प्रत्युक्तो विदुरो मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2008123, "chapter_id": 1156, "verse_number": "१-१५७-३३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2008124, "chapter_id": 1156, "verse_number": "१-१५७-३३", "content_sanskrit": "अष्टमेऽहनि रोहिण्यां प्रयाताः फाल्गुनस्य ते।\nवारणावतमासाद्य ददृशुर्नागरं जनम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2008125, "chapter_id": 1156, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि जतुगृहपर्वणि सप्तपञ्चादशदधिकशततमोऽध्यायः॥ १५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]