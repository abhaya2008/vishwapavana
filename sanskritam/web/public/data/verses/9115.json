[{"id": 5000115000, "chapter_id": 9115, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अयोध्याकाण्डे अष्टात्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000115001, "chapter_id": 9115, "verse_number": "२-३८-१", "content_sanskrit": "तस्यां चीरं वसानायां नाथवत्यामनाथवत्।\nप्रचुक्रोश जनः सर्वो धिक् त्वां दशरथं त्विति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000115002, "chapter_id": 9115, "verse_number": "२-३८-२", "content_sanskrit": "तेन तत्र प्रणादेन दुःखितः स महीपतिः।\nचिच्छेद जीविते श्रद्धां धर्मे यशसि चात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000115003, "chapter_id": 9115, "verse_number": "२-३८-३", "content_sanskrit": "स निःश्वस्योष्णमैक्ष्वाकस्तां भार्यामिदमब्रवीत्।\nकैकेयि कुशचीरेण न सीता गन्तुमर्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000115004, "chapter_id": 9115, "verse_number": "२-३८-४", "content_sanskrit": "सुकुमारी च बाला च सततं च सुखोचिता।\nनेयं वनस्य योग्येति सत्यमाह गुरुर्मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000115005, "chapter_id": 9115, "verse_number": "२-३८-५", "content_sanskrit": "इयं हि कस्यापि करोति किंचित्\nतपस्विनी राजवरस्य पुत्री।\nया चीरमासाद्य जनस्य मध्ये\nस्थिता विसंज्ञा श्रमणीव काचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000115006, "chapter_id": 9115, "verse_number": "२-३८-६", "content_sanskrit": "चीराण्यपास्याज्जनकस्य कन्या\nनेयं प्रतिज्ञा मम दत्तपूर्वा।\nयथासुखं गच्छतु राजपुत्री\nवनं समग्रा सह सर्वरत्नैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000115007, "chapter_id": 9115, "verse_number": "२-३८-७", "content_sanskrit": "अजीवनार्हेण मया नृशंसा\nकृता प्रतिज्ञा नियमेन तावत्।\nत्वया हि बाल्यात् प्रतिपन्नमेतत्\nतन्मा दहेद् वेणुमिवात्मपुष्पम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000115008, "chapter_id": 9115, "verse_number": "२-३८-८", "content_sanskrit": "रामेण यदि ते पापे किंचित्कृतमशोभनम्।\nअपकारः क इह ते वैदेह्या दर्शितोऽधमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000115009, "chapter_id": 9115, "verse_number": "२-३८-९", "content_sanskrit": "मृगीवोत्फुल्लनयना मृदुशीला मनस्विनी।\nअपकारं कमिव ते करोति जनकात्मजा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000115010, "chapter_id": 9115, "verse_number": "२-३८-१०", "content_sanskrit": "ननु पर्याप्तमेवं ते पापे रामविवासनम्।\nकिमेभिः कृपणैर्भूयः पातकैरपि ते कृतैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000115011, "chapter_id": 9115, "verse_number": "२-३८-११", "content_sanskrit": "प्रतिज्ञातं मया तावत् त्वयोक्तं देवि शृण्वता।\nरामं यदभिषेकाय त्वमिहागतमब्रवीः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000115012, "chapter_id": 9115, "verse_number": "२-३८-१२", "content_sanskrit": "तत्त्वेतत् समतिक्रम्य निरयं गन्तुमिच्छसि।\nमैथिलीमपि या हि त्वमीक्षसे चीरवासिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000115013, "chapter_id": 9115, "verse_number": "२-३८-१३", "content_sanskrit": "एवं ब्रुवन्तं पितरं रामः सम्प्रस्थितो वनम्।\nअवाक्शिरसमासीनमिदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000115014, "chapter_id": 9115, "verse_number": "२-३८-१४", "content_sanskrit": "इयं धार्मिक कौसल्या मम माता यशस्विनी।\nवृद्धा चाक्षुद्रशीला च न च त्वां देव गर्हते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000115015, "chapter_id": 9115, "verse_number": "२-३८-१५", "content_sanskrit": "मया विहीनां वरद प्रपन्नां शोकसागरम्।\nअदृष्टपूर्वव्यसनां भूयः सम्मन्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000115016, "chapter_id": 9115, "verse_number": "२-३८-१६", "content_sanskrit": "पुत्रशोकं यथा नर्च्छेत् त्वया पूज्येन पूजिता।\nमां हि संचिन्तयन्ती सा त्वयि जीवेत् तपस्विनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000115017, "chapter_id": 9115, "verse_number": "२-३८-१७", "content_sanskrit": "इमां महेन्द्रोपम जातगर्धिनीं\nतथा विधातुं जननीं ममार्हसि।\nयथा वनस्थे मयि शोककर्शिता\nन जीवितं न्यस्य यमक्षयं व्रजेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000115018, "chapter_id": 9115, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अयोध्याकाण्डे अष्टात्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]