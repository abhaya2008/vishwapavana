[{"id": 900005686, "chapter_id": 8438, "verse_number": "19.1", "content_sanskrit": "ॐ अन्तस्तद्धर्मोपदेशात् ॐ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900005687, "chapter_id": 8438, "verse_number": "19.2", "content_sanskrit": "तत्र रूढिं च तच्छब्दानामपि स्वयम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900005688, "chapter_id": 8438, "verse_number": "19.3", "content_sanskrit": "समुद्रान्तःस्थितत्वाद्यैस्तद्धर्मैर्विष्णुरूढताम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900005689, "chapter_id": 8438, "verse_number": "19.4", "content_sanskrit": "अभिदां तैश्च पुनरेव न्यवारयत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900005690, "chapter_id": 8438, "verse_number": "19.5", "content_sanskrit": "अभिदां तैश्च पुनरेव न्यवारयत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}]