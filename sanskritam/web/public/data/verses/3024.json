[{"id": 2094620, "chapter_id": 3024, "verse_number": "१३-१५४-१", "content_sanskrit": "`युधिष्ठिर उवाच।\nगार्हस्थ्यं धर्ममखिलं प्रब्रूहि भरतर्षभ।\nऋद्धिमाप्नोति किं कृत्वा मनुष्य इह पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2094621, "chapter_id": 3024, "verse_number": "१३-१५४-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2094622, "chapter_id": 3024, "verse_number": "१३-१५४-२", "content_sanskrit": "अत्र ते वर्तयिष्यामि पुरावृत्तं जनाधिप।\nवासुदेवस्य संवादं पृथिव्याश्चैव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2094623, "chapter_id": 3024, "verse_number": "१३-१५४-३", "content_sanskrit": "संस्तुत्य पृथिवीं देवीं वासुदेवः प्रतापवान्।\nपप्रच्छ भरतश्रेष्ठ मां त्वं यत्पृच्छसेऽद्य वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2094624, "chapter_id": 3024, "verse_number": "१३-१५४-४x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2094625, "chapter_id": 3024, "verse_number": "१३-१५४-४", "content_sanskrit": "गार्हस्थ्यं धर्ममाश्रित्य मया वा मद्विधेन वा।\nकिमवश्यं धरे कार्यं किं वा कृत्वा सुखं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2094626, "chapter_id": 3024, "verse_number": "१३-१५४-५x", "content_sanskrit": "पृथिव्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2094627, "chapter_id": 3024, "verse_number": "१३-१५४-५", "content_sanskrit": "ऋषयः पितरो देवा मनुष्याश्चैव माधव।\nपूज्याश्चैवार्चनीयाश्च यथा चैव निबोध मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2094628, "chapter_id": 3024, "verse_number": "१३-१५४-६", "content_sanskrit": "सदा यज्ञेन देवांश्च सदाऽऽतिथ्येन मानुषान्।\nछन्दतस्तर्पणेनापि पितॄन्युञ्जन्ति नित्यशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2094629, "chapter_id": 3024, "verse_number": "१३-१५४-७", "content_sanskrit": "तेन ह्यृषिगणाः प्रीता ब्रह्मचयेणि चानघ।\nनित्यमग्निं परिचरेदभुक्त्वा बलिकर्म च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2094630, "chapter_id": 3024, "verse_number": "१३-१५४-८", "content_sanskrit": "कुर्यात्तथैव देवान्वै प्रियं मे मधुसूदन।\nकुर्यादहरहः श्राद्धमन्नाद्येनोदकेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2094631, "chapter_id": 3024, "verse_number": "१३-१५४-९", "content_sanskrit": "पयोमूलफलैर्वाऽपि पितॄणां प्रीतिमावहेत्।\nसिद्धान्नाद्वैश्वदेवं वै कुर्यादग्नौ यथाविधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2094632, "chapter_id": 3024, "verse_number": "१३-१५४-१०", "content_sanskrit": "आग्नीषोमं वैश्वदेवं धान्वन्तर्यमनन्तरम्।\nप्रजानां पतये चैव पृथग्घोमो विधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2094633, "chapter_id": 3024, "verse_number": "१३-१५४-११", "content_sanskrit": "तथैव चानुपूर्व्येण बलिकर्म प्रयोजयेत्।\nदक्षिणायां यमायेति प्रतीच्यां वरुणाय च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2094634, "chapter_id": 3024, "verse_number": "१३-१५४-१२", "content_sanskrit": "सोमाय चाप्युदीच्यां वै वास्तुमध्ये प्रजापतेः।\nधन्वन्तरेः प्रागुदीच्यां प्राच्यां शक्राय माधव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2094635, "chapter_id": 3024, "verse_number": "१३-१५४-१३", "content_sanskrit": "मनुष्येभ्य इति प्राहुर्बलिं द्वारि गृहस्य वै।\nमरुद्भ्यो दैवतेभ्यश्च बलिमन्तर्गृहे हरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2094636, "chapter_id": 3024, "verse_number": "१३-१५४-१४", "content_sanskrit": "तथैव विश्वेदेवेभ्यो बलिमाकाशतो हरेत्।\nनिशाचरेभ्यो भूतेभ्यो बलिं नक्तं यथा हरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2094637, "chapter_id": 3024, "verse_number": "१३-१५४-१५", "content_sanskrit": "एवं कृत्वा बलिं सम्यग्दद्याद्भिक्षां द्विजाय वै।\nअलाभे ब्राह्मणस्याग्नावग्रमुद्धृत्य निक्षिपेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2094638, "chapter_id": 3024, "verse_number": "१३-१५४-१६", "content_sanskrit": "यदा श्राद्धं पितृभ्योपि दातुमिच्छेत मानवः।\nतदा पश्चात्प्रकुर्वीत निवृत्ते श्राद्धकर्मणि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2094639, "chapter_id": 3024, "verse_number": "१३-१५४-१७", "content_sanskrit": "पितॄन्सन्तर्पयित्वा तु बलिं कुर्याद्विधानतः।\nवेश्वदैवं ततः कुर्यात्पश्चाद्ब्राह्म्णभोजनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2094640, "chapter_id": 3024, "verse_number": "१३-१५४-१८", "content_sanskrit": "ततोऽन्नेनावशेषेण भोजयेदतिथीनपि।\nअर्घ्यपूर्वं महाराज ततः प्रीणाति मानवान्।\nअनित्यं हि स्थितो यस्मात्तस्मादतिथिरुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2094641, "chapter_id": 3024, "verse_number": "१३-१५४-१९", "content_sanskrit": "आचार्यस्य पितुश्चैव सख्युराप्तस्य चातिथेः।\nइदमस्ति गृहे मह्यमिति नित्यं निवेदयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2094642, "chapter_id": 3024, "verse_number": "१३-१५४-२०", "content_sanskrit": "ते यद्वदेयुस्तत्कुर्यादिति धर्मो विधीयते।\nगृहस्थः पुरुषः कृष्ण शिष्टाशी च सदा भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2094643, "chapter_id": 3024, "verse_number": "१३-१५४-२१", "content_sanskrit": "राजर्त्विजं स्नातकं च गुरुं श्वशुरमेव च।\nअर्चयेन्मधुपर्केण परिसंवत्सरोषितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2094644, "chapter_id": 3024, "verse_number": "१३-१५४-२२", "content_sanskrit": "श्वभ्यश्च श्वपचेभ्यश्च वयोभ्यश्चावपेद्भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2094645, "chapter_id": 3024, "verse_number": "१३-१५४-२३", "content_sanskrit": "वैश्वदेवं हि नामैतत्सायं प्रातर्विधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2094646, "chapter_id": 3024, "verse_number": "१३-१५४-२४", "content_sanskrit": "एतांस्तु धर्मान्गार्हस्थ्यान्यः कुर्यादनसूयकः।\nस इहर्द्धिं परां प्राप्य प्रेत्य लोके महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2094647, "chapter_id": 3024, "verse_number": "१३-१५४-२५x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2094648, "chapter_id": 3024, "verse_number": "१३-१५४-२५", "content_sanskrit": "इति भूमेर्वचः श्रुत्वा वासुदेवः प्रतापवान्।\nतथा चकार सततं त्वमप्येवं सदाऽऽचर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2094649, "chapter_id": 3024, "verse_number": "१३-१५४-२६", "content_sanskrit": "एतद्गृहस्थधर्मं त्वं चेष्टमानो जनाधिप।\nइह लोके यशः प्राप्य प्रेत्य स्वर्गमवाप्स्यसि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2094650, "chapter_id": 3024, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि चतुःपञ्चाशददिकशततमोऽध्यायः॥ १५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]