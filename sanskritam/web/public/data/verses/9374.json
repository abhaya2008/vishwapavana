[{"id": 5000374000, "chapter_id": 9374, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे सुन्दरकाण्डे पञ्चत्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000374001, "chapter_id": 9374, "verse_number": "५-३५-१", "content_sanskrit": "तां तु रामकथां श्रुत्वा वैदेही वानरर्षभात्।\nउवाच वचनं सान्त्वमिदं मधुरया गिरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000374002, "chapter_id": 9374, "verse_number": "५-३५-२", "content_sanskrit": "क्व ते रामेण संसर्गः कथं जानासि लक्ष्मणम्।\nवानराणां नराणां च कथमासीत् समागमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000374003, "chapter_id": 9374, "verse_number": "५-३५-३", "content_sanskrit": "यानि रामस्य चिह्नानि लक्ष्मणस्य च वानर।\nतानि भूयः समाचक्ष्व न मां शोकः समाविशेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000374004, "chapter_id": 9374, "verse_number": "५-३५-४", "content_sanskrit": "कीदृशं तस्य संस्थानं रूपं तस्य च कीदृशम्।\nकथमूरू कथं बाहू लक्ष्मणस्य च शंस मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000374005, "chapter_id": 9374, "verse_number": "५-३५-५", "content_sanskrit": "एवमुक्तस्तु वैदेह्या हनूमान् मारुतात्मजः।\nततो रामं यथातत्त्वमाख्यातुमुपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000374006, "chapter_id": 9374, "verse_number": "५-३५-६", "content_sanskrit": "जानन्ती बत दिष्ट्या मां वैदेहि परिपृच्छसि।\nभर्तुः कमलपत्राक्षि संस्थानं लक्ष्मणस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000374007, "chapter_id": 9374, "verse_number": "५-३५-७", "content_sanskrit": "यानि रामस्य चिह्नानि लक्ष्मणस्य च यानि वै।\nलक्षितानि विशालाक्षि वदतः शृणु तानि मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000374008, "chapter_id": 9374, "verse_number": "५-३५-८", "content_sanskrit": "रामः कमलपत्राक्षः पूर्णचन्द्रनिभाननः।\nरूपदाक्षिण्यसम्पन्नः प्रसूतो जनकात्मजे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000374009, "chapter_id": 9374, "verse_number": "५-३५-९", "content_sanskrit": "तेजसाऽऽदित्यसंकाशः क्षमया पृथिवीसमः।\nबृहस्पतिसमो बुद्ध्या यशसा वासवोपमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000374010, "chapter_id": 9374, "verse_number": "५-३५-१०", "content_sanskrit": "रक्षिता जीवलोकस्य स्वजनस्य च रक्षिता।\nरक्षिता स्वस्य वृत्तस्य धर्मस्य च परंतपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000374011, "chapter_id": 9374, "verse_number": "५-३५-११", "content_sanskrit": "रामो भामिनि लोकस्य चातुर्वर्ण्यस्य रक्षिता।\nमर्यादानां च लोकस्य कर्ता कारयिता च सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000374012, "chapter_id": 9374, "verse_number": "५-३५-१२", "content_sanskrit": "अर्चिष्मानर्चितोऽत्यर्थं ब्रह्मचर्यव्रते स्थितः।\nसाधूनामुपकारज्ञः प्रचारज्ञश्च कर्मणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000374013, "chapter_id": 9374, "verse_number": "५-३५-१३", "content_sanskrit": "राजनीत्यां विनीतश्च ब्राह्मणानामुपासकः।\nज्ञानवान् शीलसम्पन्नो विनीतश्च परंतपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000374014, "chapter_id": 9374, "verse_number": "५-३५-१४", "content_sanskrit": "यजुर्वेदविनीतश्च वेदविद्भिः सुपूजितः।\nधनुर्वेदे च वेदे च वेदाङ्गेषु च निष्ठितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000374015, "chapter_id": 9374, "verse_number": "५-३५-१५", "content_sanskrit": "विपुलांसो महाबाहुः कम्बुग्रीवः शुभाननः।\nगूढजत्रुः सुताम्राक्षो रामो नाम जनैः श्रुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000374016, "chapter_id": 9374, "verse_number": "५-३५-१६", "content_sanskrit": "दुन्दुभिस्वननिर्घोषः स्निग्धवर्णः प्रतापवान्।\nसमश्च सुविभक्ताङ्गो वर्णं श्यामं समाश्रितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000374017, "chapter_id": 9374, "verse_number": "५-३५-१७", "content_sanskrit": "त्रिस्थिरस्त्रिप्रलम्बश्च त्रिसमस्त्रिषु चोन्नतः।\nत्रिताम्रस्त्रिषु च स्निग्धो गम्भीरस्त्रिषु नित्यशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000374018, "chapter_id": 9374, "verse_number": "५-३५-१८", "content_sanskrit": "त्रिवलीमांस्त्र्यवनतश्चतुर्व्यङ्गस्त्रिशीर्षवान्।\nचतुष्कलश्चतुर्लेखश्चतुष्किष्कुश्चतुःसमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000374019, "chapter_id": 9374, "verse_number": "५-३५-१९", "content_sanskrit": "चतुर्दशसमद्वन्द्वश्चतुर्दंष्ट्रश्चतुर्गतिः।\nमहोष्ठहनुनासश्च पञ्चस्निग्धोऽष्टवंशवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000374020, "chapter_id": 9374, "verse_number": "५-३५-२०", "content_sanskrit": "दशपद्मो दशबृहत् त्रिभिर्व्याप्तो द्विशुक्लवान्।\nषडुन्नतो नवतनुस्त्रिभिर्व्याप्नोति राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000374021, "chapter_id": 9374, "verse_number": "५-३५-२१", "content_sanskrit": "सत्यधर्मरतः श्रीमान् संग्रहानुग्रहे रतः।\nदेशकालविभागज्ञः सर्वलोकप्रियंवदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000374022, "chapter_id": 9374, "verse_number": "५-३५-२२", "content_sanskrit": "भ्राता चास्य च वैमात्रः सौमित्रिरमितप्रभः।\nअनुरागेण रूपेण गुणैश्चापि तथाविधः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000374023, "chapter_id": 9374, "verse_number": "५-३५-२३", "content_sanskrit": "स सुवर्णच्छविः श्रीमान् रामः श्यामो महायशाः।\nतावुभौ नरशार्दूलौ त्वद्दर्शनकृतोत्सवौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000374024, "chapter_id": 9374, "verse_number": "५-३५-२४", "content_sanskrit": "विचिन्वन्तौ महीं कृत्स्नामस्माभिः सह संगतौ।\nत्वामेव मार्गमाणौ तौ विचरन्तौ वसुन्धराम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000374025, "chapter_id": 9374, "verse_number": "५-३५-२५", "content_sanskrit": "ददर्शतुर्मृगपतिं पूर्वजेनावरोपितम्।\nऋष्यमूकस्य मूले तु बहुपादपसंकुले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000374026, "chapter_id": 9374, "verse_number": "५-३५-२६", "content_sanskrit": "भ्रातुर्भयार्तमासीनं सुग्रीवं प्रियदर्शनम्।\nवयं च हरिराजं तं सुग्रीवं सत्यसङ्गरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000374027, "chapter_id": 9374, "verse_number": "५-३५-२७", "content_sanskrit": "परिचर्यामहे राज्यात् पूर्वजेनावरोपितम्।\nततस्तौ चीरवसनौ धनुःप्रवरपाणिनौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000374028, "chapter_id": 9374, "verse_number": "५-३५-२८", "content_sanskrit": "ऋष्यमूकस्य शैलस्य रम्यं देशमुपागतौ।\nस तौ दृष्ट्वा नरव्याघ्रौ धन्विनौ वानरर्षभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000374029, "chapter_id": 9374, "verse_number": "५-३५-२९", "content_sanskrit": "अभिप्लुतो गिरेस्तस्य शिखरं भयमोहितः।\nततः स शिखरे तस्मिन् वानरेन्द्रो व्यवस्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000374030, "chapter_id": 9374, "verse_number": "५-३५-३०", "content_sanskrit": "तयोः समीपं मामेव प्रेषयामास सत्वरम्।\nतावहं पुरुषव्याघ्रौ सुग्रीववचनात् प्रभू ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000374031, "chapter_id": 9374, "verse_number": "५-३५-३१", "content_sanskrit": "रूपलक्षणसम्पन्नौ कृताञ्जलिरुपस्थितः।\nतौ परिज्ञाततत्त्वार्थौ मया प्रीतिसमन्वितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000374032, "chapter_id": 9374, "verse_number": "५-३५-३२", "content_sanskrit": "पृष्ठमारोप्य तं देशं प्रापितौ पुरुषर्षभौ।\nनिवेदितौ च तत्त्वेन सुग्रीवाय महात्मने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000374033, "chapter_id": 9374, "verse_number": "५-३५-३३", "content_sanskrit": "तयोरन्योन्यसम्भाषाद् भृशं प्रीतिरजायत।\nतत्र तौ कीर्तिसम्पन्नौ हरीश्वरनरेश्वरौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000374034, "chapter_id": 9374, "verse_number": "५-३५-३४", "content_sanskrit": "परस्परकृताश्वासौ कथया पूर्ववृत्तया।\nतं ततः सान्त्वयामास सुग्रीवं लक्ष्मणाग्रजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000374035, "chapter_id": 9374, "verse_number": "५-३५-३५", "content_sanskrit": "स्त्रीहेतोर्वालिना भ्रात्रा निरस्तं पुरुतेजसा।\nततस्त्वन्नाशजं शोकं रामस्याक्लिष्टकर्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000374036, "chapter_id": 9374, "verse_number": "५-३५-३६", "content_sanskrit": "लक्ष्मणो वानरेन्द्राय सुग्रीवाय न्यवेदयत्।\nस श्रुत्वा वानरेन्द्रस्तु लक्ष्मणेनेरितं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000374037, "chapter_id": 9374, "verse_number": "५-३५-३७", "content_sanskrit": "तदासीन्निष्प्रभोऽत्यर्थं ग्रहग्रस्त इवांशुमान्।\nततस्त्वद‍्गात्रशोभीनि रक्षसा ह्रियमाणया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000374038, "chapter_id": 9374, "verse_number": "५-३५-३८", "content_sanskrit": "यान्याभरणजालानि पातितानि महीतले।\nतानि सर्वाणि रामाय आनीय हरियूथपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000374039, "chapter_id": 9374, "verse_number": "५-३५-३९", "content_sanskrit": "संहृष्टा दर्शयामासुर्गतिं तु न विदुस्तव।\nतानि रामाय दत्तानि मयैवोपहृतानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000374040, "chapter_id": 9374, "verse_number": "५-३५-४०", "content_sanskrit": "स्वनवन्त्यवकीर्णानि तस्मिन् विहतचेतसि।\nतान्यङ्के दर्शनीयानि कृत्वा बहुविधं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000374041, "chapter_id": 9374, "verse_number": "५-३५-४१", "content_sanskrit": "तेन देवप्रकाशेन देवेन परिदेवितम्।\nपश्यतस्तानि रुदतस्ताम्यतश्च पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000374042, "chapter_id": 9374, "verse_number": "५-३५-४२", "content_sanskrit": "प्रादीपयद् दाशरथेस्तदा शोकहुताशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000374043, "chapter_id": 9374, "verse_number": "५-३५-४३", "content_sanskrit": "शायितं च चिरं तेन दुःखार्तेन महात्मना।\nमयापि विविधैर्वाक्यैः कृच्छ्रादुत्थापितः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000374044, "chapter_id": 9374, "verse_number": "५-३५-४४", "content_sanskrit": "तानि दृष्ट्वा महार्हाणि दर्शयित्वा मुहुर्मुहुः।\nराघवः सहसौमित्रिः सुग्रीवे संन्यवेशयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000374045, "chapter_id": 9374, "verse_number": "५-३५-४५", "content_sanskrit": "स तवादर्शनादार्ये राघवः परितप्यते।\nमहता ज्वलता नित्यमग्निनेवाग्निपर्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000374046, "chapter_id": 9374, "verse_number": "५-३५-४६", "content_sanskrit": "त्वत्कृते तमनिद्रा च शोकश्चिन्ता च राघवम्।\nतापयन्ति महात्मानमग्न्यगारमिवाग्नयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000374047, "chapter_id": 9374, "verse_number": "५-३५-४७", "content_sanskrit": "तवादर्शनशोकेन राघवः परिचाल्यते।\nमहता भूमिकम्पेन महानिव शिलोच्चयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000374048, "chapter_id": 9374, "verse_number": "५-३५-४८", "content_sanskrit": "काननानि सुरम्याणि नदीप्रस्रवणानि च।\nचरन् न रतिमाप्नोति त्वामपश्यन् नृपात्मजे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000374049, "chapter_id": 9374, "verse_number": "५-३५-४९", "content_sanskrit": "स त्वां मनुजशार्दूलः क्षिप्रं प्राप्स्यति राघवः।\nसमित्रबान्धवं हत्वा रावणं जनकात्मजे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000374050, "chapter_id": 9374, "verse_number": "५-३५-५०", "content_sanskrit": "सहितौ रामसुग्रीवावुभावकुरुतां तदा।\nसमयं वालिनं हन्तुं तव चान्वेषणं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000374051, "chapter_id": 9374, "verse_number": "५-३५-५१", "content_sanskrit": "ततस्ताभ्यां कुमाराभ्यां वीराभ्यां स हरीश्वरः।\nकिष्किन्धां समुपागम्य वाली युद्धे निपातितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000374052, "chapter_id": 9374, "verse_number": "५-३५-५२", "content_sanskrit": "ततो निहत्य तरसा रामो वालिनमाहवे।\nसर्वर्क्षहरिसङ्घानां सुग्रीवमकरोत् पतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000374053, "chapter_id": 9374, "verse_number": "५-३५-५३", "content_sanskrit": "रामसुग्रीवयोरैक्यं देव्येवं समजायत।\nहनूमन्तं च मां विद्धि तयोर्दूतमुपागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000374054, "chapter_id": 9374, "verse_number": "५-३५-५४", "content_sanskrit": "स्वं राज्यं प्राप्य सुग्रीवः स्वानानीय महाकपीन्।\nत्वदर्थं प्रेषयामास दिशो दश महाबलान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000374055, "chapter_id": 9374, "verse_number": "५-३५-५५", "content_sanskrit": "आदिष्टा वानरेन्द्रेण सुग्रीवेण महौजसः।\nअद्रिराजप्रतीकाशाः सर्वतः प्रस्थिता महीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 5000374056, "chapter_id": 9374, "verse_number": "५-३५-५६", "content_sanskrit": "ततस्ते मार्गमाणा वै सुग्रीववचनातुराः।\nचरन्ति वसुधां कृत्स्नां वयमन्ये च वानराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 5000374057, "chapter_id": 9374, "verse_number": "५-३५-५७", "content_sanskrit": "अङ्गदो नाम लक्ष्मीवान् वालिसूनुर्महाबलः।\nप्रस्थितः कपिशार्दूलस्त्रिभागबलसंवृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 5000374058, "chapter_id": 9374, "verse_number": "५-३५-५८", "content_sanskrit": "तेषां नो विप्रणष्टानां विन्ध्ये पर्वतसत्तमे।\nभृशं शोकपरीतानामहोरात्रगणा गताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 5000374059, "chapter_id": 9374, "verse_number": "५-३५-५९", "content_sanskrit": "ते वयं कार्यनैराश्यात् कालस्यातिक्रमेण च।\nभयाच्च कपिराजस्य प्राणांस्त्यक्तुमुपस्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 5000374060, "chapter_id": 9374, "verse_number": "५-३५-६०", "content_sanskrit": "विचित्य गिरिदुर्गाणि नदीप्रस्रवणानि च।\nअनासाद्य पदं देव्याः प्राणांस्त्यक्तुं व्यवस्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 5000374061, "chapter_id": 9374, "verse_number": "५-३५-६१", "content_sanskrit": "ततस्तस्य गिरेर्मूर्ध्नि वयं प्रायमुपास्महे।\nदृष्ट्वा प्रायोपविष्टांश्च सर्वान् वानरपुङ्गवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 5000374062, "chapter_id": 9374, "verse_number": "५-३५-६२", "content_sanskrit": "भृशं शोकार्णवे मग्नः पर्यदेवयदङ्गदः।\nतव नाशं च वैदेहि वालिनश्च तथा वधम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 5000374063, "chapter_id": 9374, "verse_number": "५-३५-६३", "content_sanskrit": "प्रायोपवेशमस्माकं मरणं च जटायुषः।\nतेषां नः स्वामिसंदेशान्निराशानां मुमूर्षताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 5000374064, "chapter_id": 9374, "verse_number": "५-३५-६४", "content_sanskrit": "कार्यहेतोरिहायातः शकुनिर्वीर्यवान् महान्।\nगृध्रराजस्य सोदर्यः सम्पातिर्नाम गृध्रराट् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 5000374065, "chapter_id": 9374, "verse_number": "५-३५-६५", "content_sanskrit": "श्रुत्वा भ्रातृवधं कोपादिदं वचनमब्रवीत्।\nयवीयान् केन मे भ्राता हतः क्व च निपातितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 5000374066, "chapter_id": 9374, "verse_number": "५-३५-६६", "content_sanskrit": "एतदाख्यातुमिच्छामि भवद्भिर्वानरोत्तमाः।\nअङ्गदोऽकथयत् तस्य जनस्थाने महद्वधम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 5000374067, "chapter_id": 9374, "verse_number": "५-३५-६७", "content_sanskrit": "रक्षसा भीमरूपेण त्वामुद्दिश्य यथार्थतः।\nजटायोस्तु वधं श्रुत्वा दुःखितः सोऽरुणात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 5000374068, "chapter_id": 9374, "verse_number": "५-३५-६८", "content_sanskrit": "त्वामाह स वरारोहे वसन्तीं रावणालये।\nतस्य तद् वचनं श्रुत्वा सम्पातेः प्रीतिवर्धनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 5000374069, "chapter_id": 9374, "verse_number": "५-३५-६९", "content_sanskrit": "अङ्गदप्रमुखाः सर्वे ततः प्रस्थापिता वयम्।\nविन्ध्यादुत्थाय सम्प्राप्ताः सागरस्यान्तमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 5000374070, "chapter_id": 9374, "verse_number": "५-३५-७०", "content_sanskrit": "त्वद्दर्शने कृतोत्साहा हृष्टाः पुष्टाः प्लवङ्गमाः।\nअङ्गदप्रमुखाः सर्वे वेलोपान्तमुपागताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 5000374071, "chapter_id": 9374, "verse_number": "५-३५-७१", "content_sanskrit": "चिन्तां जग्मुः पुनर्भीमां त्वद्दर्शनसमुत्सुकाः।\nअथाहं हरिसैन्यस्य सागरं दृश्य सीदतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 5000374072, "chapter_id": 9374, "verse_number": "५-३५-७२", "content_sanskrit": "व्यवधूय भयं तीव्रं योजनानां शतं प्लुतः।\nलङ्का चापि मया रात्रौ प्रविष्टा राक्षसाकुला ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 5000374073, "chapter_id": 9374, "verse_number": "५-३५-७३", "content_sanskrit": "रावणश्च मया दृष्टस्त्वं च शोकनिपीडिता।\nएतत् ते सर्वमाख्यातं यथावृत्तमनिन्दिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 5000374074, "chapter_id": 9374, "verse_number": "५-३५-७४", "content_sanskrit": "अभिभाषस्व मां देवि दूतो दाशरथेरहम्।\nतन्मां रामकृतोद्योगं त्वन्निमित्तमिहागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 5000374075, "chapter_id": 9374, "verse_number": "५-३५-७५", "content_sanskrit": "सुग्रीवसचिवं देवि बुद्ध्यस्व पवनात्मजम्।\nकुशली तव काकुत्स्थः सर्वशस्त्रभृतां वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 5000374076, "chapter_id": 9374, "verse_number": "५-३५-७६", "content_sanskrit": "गुरोराराधने युक्तो लक्ष्मणः शुभलक्षणः।\nतस्य वीर्यवतो देवि भर्तुस्तव हिते रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 5000374077, "chapter_id": 9374, "verse_number": "५-३५-७७", "content_sanskrit": "अहमेकस्तु सम्प्राप्तः सुग्रीववचनादिह।\nमयेयमसहायेन चरता कामरूपिणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 5000374078, "chapter_id": 9374, "verse_number": "५-३५-७८", "content_sanskrit": "दक्षिणा दिगनुक्रान्ता त्वन्मार्गविचयैषिणा।\nदिष्ट्याहं हरिसैन्यानां त्वन्नाशमनुशोचताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 5000374079, "chapter_id": 9374, "verse_number": "५-३५-७९", "content_sanskrit": "अपनेष्यामि संतापं तवाधिगमशासनात्।\nदिष्ट्या हि न मम व्यर्थं सागरस्येह लङ्घनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 5000374080, "chapter_id": 9374, "verse_number": "५-३५-८०", "content_sanskrit": "प्राप्स्याम्यहमिदं देवि त्वद्दर्शनकृतं यशः।\nराघवश्च महावीर्यः क्षिप्रं त्वामभिपत्स्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 5000374081, "chapter_id": 9374, "verse_number": "५-३५-८१", "content_sanskrit": "सपुत्रबान्धवं हत्वा रावणं राक्षसाधिपम्।\nमाल्यवान् नाम वैदेहि गिरीणामुत्तमो गिरिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 5000374082, "chapter_id": 9374, "verse_number": "५-३५-८२", "content_sanskrit": "ततो गच्छति गोकर्णं पर्वतं केसरी हरिः।\nस च देवर्षिभिर्दिष्टः पिता मम महाकपिः।\nतीर्थे नदीपतेः पुण्ये शम्बसादनमुद्धरन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 5000374083, "chapter_id": 9374, "verse_number": "५-३५-८३", "content_sanskrit": "यस्याहं हरिणः क्षेत्रे जातो वातेन मैथिलि।\nहनूमानिति विख्यातो लोके स्वेनैव कर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 5000374084, "chapter_id": 9374, "verse_number": "५-३५-८४", "content_sanskrit": "विश्वासार्थं तु वैदेहि भर्तुरुक्ता मया गुणाः।\nअचिरात् त्वामितो देवि राघवो नयिता ध्रुवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 5000374085, "chapter_id": 9374, "verse_number": "५-३५-८५", "content_sanskrit": "एवं विश्वासिता सीता हेतुभिः शोककर्शिता।\nउपपन्नैरभिज्ञानैर्दूतं तमधिगच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 5000374086, "chapter_id": 9374, "verse_number": "५-३५-८६", "content_sanskrit": "अतुलं च गता हर्षं प्रहर्षेण तु जानकी।\nनेत्राभ्यां वक्रपक्ष्माभ्यां मुमोचानन्दजं जलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 5000374087, "chapter_id": 9374, "verse_number": "५-३५-८७", "content_sanskrit": "चारु तद् वदनं तस्यास्ताम्रशुक्लायतेक्षणम्।\nअशोभत विशालाक्ष्या राहुमुक्त इवोडुराट् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 5000374088, "chapter_id": 9374, "verse_number": "५-३५-८८", "content_sanskrit": "हनूमन्तं कपिं व्यक्तं मन्यते नान्यथेति सा।\nअथोवाच हनूमांस्तामुत्तरं प्रियदर्शनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 5000374089, "chapter_id": 9374, "verse_number": "५-३५-८९", "content_sanskrit": "एतत् ते सर्वमाख्यातं समाश्वसिहि मैथिलि।\nकिं करोमि कथं वा ते रोचते प्रतियाम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 5000374090, "chapter_id": 9374, "verse_number": "५-३५-९०", "content_sanskrit": "हतेऽसुरे संयति शम्बसादने\nकपिप्रवीरेण महर्षिचोदनात्।\nततोऽस्मि वायुप्रभवो हि मैथिलि\nप्रभावतस्तत्प्रतिमश्च वानरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 5000374091, "chapter_id": 9374, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये सुन्दरकाण्डे पञ्चत्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}]