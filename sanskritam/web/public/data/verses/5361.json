[{"id": 2204628, "chapter_id": 5361, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2204629, "chapter_id": 5361, "verse_number": "१", "content_sanskrit": "भगवन् सर्वभूतेश लोकनाथ वृषध्वज ।\nनास्त्यात्मा कर्मभोक्तेति मृतो जन्तुर्न जायते\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2204630, "chapter_id": 5361, "verse_number": "२", "content_sanskrit": "स्वभावाज्जायते सर्वं यथा वृक्षफलं तथा ।\nयथोर्मयः सम्भवन्ति तथैव जगदाकृतिः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2204631, "chapter_id": 5361, "verse_number": "३", "content_sanskrit": "तपोदानादि यत् कर्म तत्रात्मा दृश्यते वृथा ।\nनास्ति पौनर्भवं जन्म इति केचिद् व्यवस्थिताः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2204632, "chapter_id": 5361, "verse_number": "४", "content_sanskrit": "परोक्षवचनं श्रुत्वा न प्रत्यक्षस्य दर्शनात् ।\nतत्सर्वं नास्ति वाऽस्तीति संशयस्थास्तथा परे\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2204633, "chapter_id": 5361, "verse_number": "५", "content_sanskrit": "पक्षभेदान्तरे चास्मिंस्तत्वं मे वक्तुमर्हसि ।\nउक्तं भगवता यत्तु तत्तु लोकस्य संस्थितिः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2204634, "chapter_id": 5361, "verse_number": "६", "content_sanskrit": "प्रश्नमेतं तु पृच्छन्त्यां रुद्राण्यां परिषत् तदा ।\nकौतूहलयुता श्रोतुं समाहितमनाऽभवत्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2204635, "chapter_id": 5361, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2204636, "chapter_id": 5361, "verse_number": "७", "content_sanskrit": "नैतदस्ति महाभागे यद् वदन्तीह नास्तिकाः ।\nएतदेवाभिशस्तानां श्रुतिविद्वेषिणां मतम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2204637, "chapter_id": 5361, "verse_number": "८", "content_sanskrit": "असुरा राक्षसाश्चैव मन्यन्ते लोकनायकाः ।\nन पश्यन्ति च ते पापाः केवलं मांसभक्षकाः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2204638, "chapter_id": 5361, "verse_number": "९", "content_sanskrit": "प्रच्छादितं हि तत्सर्वं गुह्यकामा हि देवताः ।\nतदहं ते प्रवक्ष्यामि देवि गुह्यं पुरातनम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2204639, "chapter_id": 5361, "verse_number": "१०", "content_sanskrit": "आदिकाले प्रजाः सर्वाः कृत्वा कर्म शुभाशुभम् ।\nभुञ्जते पश्यमानास्ते वृत्तान्तं लोकयोर्द्वयोः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2204640, "chapter_id": 5361, "verse_number": "११", "content_sanskrit": "यथैवात्मकृतं कर्म देशान्तरगता नराः ।\nविद्युस्तथैवान्तकाले सुकृतं पौर्वदैहिकम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2204641, "chapter_id": 5361, "verse_number": "१२", "content_sanskrit": "एवं व्यवस्थिते लोके सर्वे धर्मरताऽभवन् ।\nअचिरेणैव कालेन स्वर्गः सम्पूरितस्तदा\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2204642, "chapter_id": 5361, "verse_number": "१३", "content_sanskrit": "देवानामपि सम्बाधं दृष्ट्वा ब्रह्माऽप्यचिन्तयत् ।\nसञ्चरन्ते कथं स्वर्गं मानुषाः प्रविशन्ति हि\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2204643, "chapter_id": 5361, "verse_number": "१४", "content_sanskrit": "इत्येवमनुचिन्त्यैव मानुषान् सममोहयत् ।\nतदाप्रभृति ते मर्त्या न विदुस्ते पुरातनम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2204644, "chapter_id": 5361, "verse_number": "१५", "content_sanskrit": "कामक्रोधौ तु तत्काले मानुषेषु न्यपातयत् ।\nताभ्यामभिहता मर्त्याः स्वर्गलोकं न पेदिरे\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2204645, "chapter_id": 5361, "verse_number": "१६", "content_sanskrit": "पुराकृतस्याविज्ञानात् कामक्रोधाभिपीडनात् ।\nनैतदस्तीति मन्वाना विकारांश्चक्रिरे पुनः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2204646, "chapter_id": 5361, "verse_number": "१७", "content_sanskrit": "अकार्यादीन् महादोषानारभन्तात्मकारणात् ।\nविस्मृत्य धर्मकार्याणि परलोकभयं तदा\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2204647, "chapter_id": 5361, "verse_number": "१८", "content_sanskrit": "एवं व्यवस्थिते लोके कश्मलं समपद्यत ।\nलोकानां चैव वेदानां क्षयायैव तदा प्रिये ।\nनरकाः पूरिताश्चासन् प्राणिभिः पापकारिभिः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2204648, "chapter_id": 5361, "verse_number": "१९", "content_sanskrit": "पुनरेव तु तद् दृष्ट्वा लोककर्ता पितामहः ।\nअचिन्तयत् तमेवार्थं लोकानां हितकारणात् ।\nसमत्वेन कथं लोको वर्तेतेति मुहुर्मुहुः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2204649, "chapter_id": 5361, "verse_number": "२०", "content_sanskrit": "चिन्तयित्वा तदा ब्रह्मा ज्ञानेन तपसा प्रिये ।\nअकरोज्ज्ञानदृश्यं तत् परलोकं न चक्षुषा\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2204650, "chapter_id": 5361, "verse_number": "२१", "content_sanskrit": "सर्वमर्थं श्रुतं दृष्टं यत् प्रागुक्तं मया तव ।\nतदाप्रभृति मर्त्यानां श्रुतमाश्रित्य पण्डिताः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2204651, "chapter_id": 5361, "verse_number": "२२", "content_sanskrit": "कामान् सञ्छिद्य परिघान् धृत्या वै परमासिना ।\nअभियान्त्येव ते स्वर्गं पश्यन्तः कर्मणः पलम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2204652, "chapter_id": 5361, "verse_number": "२३", "content_sanskrit": "एवं श्रद्धाफलं लोके परतः सुमहत् फलम् ।\nबुद्धिः श्रद्धा च विनयः कारणानि हितैषिणाम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2204653, "chapter_id": 5361, "verse_number": "२४", "content_sanskrit": "तस्मात् स्वर्गाभिगन्तारः कतिचित् त्वभवन् नराः ।\nअन्ये कारणहीनत्वान्नास्तिक्यं भावमाश्रिताः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2204654, "chapter_id": 5361, "verse_number": "२५", "content_sanskrit": "श्रुतविद्वेषिणो मूर्खा नास्तिका दृढनिश्चयाः ।\nनिष्क्रियास्तु निरन्नाद्याः पतन्त्येवाधमां गतिम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2204655, "chapter_id": 5361, "verse_number": "२६", "content_sanskrit": "नास्तीति वै पुनर्जन्म कवयोऽप्यत्र मोहिताः ।\nनाधिगच्छन्ति तन्नित्यं हेतुवादशतैरपि\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2204656, "chapter_id": 5361, "verse_number": "२७", "content_sanskrit": "एषा ब्रह्मकृता माया दुर्विज्ञेया सुरासुरैः ।\nकिम्पुनर्मानुषैर्लोके ज्ञातुकामैः कुबुद्धिभिः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2204657, "chapter_id": 5361, "verse_number": "२८", "content_sanskrit": "केवलं श्रद्धया देवि श्रुतिमात्रनिविष्टया ।\nतदस्तीऽत्येव मन्तव्यं तथा हि तमवाप्नुयात्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2204658, "chapter_id": 5361, "verse_number": "२९", "content_sanskrit": "वेदगुह्येषु चान्येषु हेतुर्देवि निरर्थकः ।\nबधिरान्धवदेवात्र वर्तितव्यं हितैषिणा\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2204659, "chapter_id": 5361, "verse_number": "३०", "content_sanskrit": "एतत्ते कथितं सर्वं देवगुह्यं प्रजाहितम् ।\nत्वत्प्रीत्यर्थमिदं गुह्यमवाच्यमपि भाषितम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2204660, "chapter_id": 5361, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2204661, "chapter_id": 5361, "verse_number": "३१", "content_sanskrit": "भगवन् मानुषाः केचिज्जातिस्मरणसंयुताः ।\nकिमर्थं तेऽभिजायन्ते जानन्तः पौर्वदैहिकम् ।\nएतन्मे तत्त्वतो देव मानुषेषु वदस्व भो\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2204662, "chapter_id": 5361, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2204663, "chapter_id": 5361, "verse_number": "३२", "content_sanskrit": "तदहं ते प्रवक्ष्यामि शृणु तत्वं समाहिता\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2204664, "chapter_id": 5361, "verse_number": "३३", "content_sanskrit": "ये मृताः सहसा मर्त्या जायन्ते सहसा पुनः ।\nतेषां पौराणिकोऽभ्यासः कञ्चित्कालं स तिष्ठति\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2204665, "chapter_id": 5361, "verse_number": "३४", "content_sanskrit": "तस्माज्जातिस्मरा लोके जायन्ते बोधसंयुताः ।\nतेषां विवर्धतां सञ्ज्ञा स्वप्नवत् सा प्रणश्यति ।\nपरलोकस्य चास्तित्वे मूढानां कारणं च तत्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2204666, "chapter_id": 5361, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2204667, "chapter_id": 5361, "verse_number": "३५", "content_sanskrit": "भगवन् मानुषाः केचिन्मृता भूत्वा हि सम्प्रति ।\nनिवर्तमाना दृश्यन्ते देहेष्वेव पुनर्नराः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2204668, "chapter_id": 5361, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2204669, "chapter_id": 5361, "verse_number": "३६", "content_sanskrit": "तदहं ते प्रवक्ष्यामि कारणं शृणु शोभने\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2204670, "chapter_id": 5361, "verse_number": "३७", "content_sanskrit": "प्राणैर्वियुज्यमानानां बहुत्वात् प्राणिनां वधे ।\nतथैव नामसामान्याद् यमदूता नृणां प्रति\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2204671, "chapter_id": 5361, "verse_number": "३८", "content_sanskrit": "वहन्ति ते क्वचिन्मोहादन्यांस्त इति यामिकाः ।\nनिर्विकारं हि तत्सर्वं यमो वेद कृताकृतम्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2204672, "chapter_id": 5361, "verse_number": "३९", "content_sanskrit": "तस्मात् संयमनीं प्राप्य यमेनैते विमोक्षिताः ।\nपुनरेव निवर्तन्ते शेषं भोक्तुं स्वकर्मणः ।\nस्वकर्मण्यसमाप्ते तु न म्रियन्ते हि मानवाः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2204673, "chapter_id": 5361, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2204674, "chapter_id": 5361, "verse_number": "४०", "content_sanskrit": "भगवन् सुप्तमात्रेण प्राणिनां स्वप्नदर्शनम् ।\nकिं तत् स्वभावमन्यद् वा तन्मे शंसितुमर्हसि\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2204675, "chapter_id": 5361, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2204676, "chapter_id": 5361, "verse_number": "४१", "content_sanskrit": "सुप्तानां तु मनश्चेष्टा स्वप्न इत्यभिधीयते ।\nअनागतमतिक्रान्तं पश्यते सञ्चरन्मनः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2204677, "chapter_id": 5361, "verse_number": "४२", "content_sanskrit": "निमित्तं च भवेत् तस्मात् प्राणिनां स्वप्नदर्शनम् ।\nएतत्ते कथितं सर्वं भूयः श्रोतुं किमिच्छसि\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2204678, "chapter_id": 5361, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे नास्तिक्यवादनिरासादिकथनं नाम द्वादशोत्तरद्विशततमोऽध्यायः ॥२१२॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]