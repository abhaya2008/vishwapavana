[{"id": 7002456000, "chapter_id": 22456, "verse_number": "१-११८-१", "content_sanskrit": "ब्रह्मोवाच ।\nदीपं प्रयच्छति नरो भानोरायतने तु यः ।\nतेजसा रविसंकाशः सर्वयज्ञफलं१ लभेत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002456001, "chapter_id": 22456, "verse_number": "१-११८-२", "content_sanskrit": "कार्त्तिके तु विशेषेण कौमारे मासि दीपकम् ।\nदत्वा फलमवाप्नोति यदन्येन न लभ्यते ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002456002, "chapter_id": 22456, "verse_number": "१-११८-३", "content_sanskrit": "कृष्णकृष्णात्र ते वच्मि संवादं पापनाशनम् ।\nभ्रातृभिः सह भद्रस्य ब्राह्मणस्य महात्मनः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002456003, "chapter_id": 22456, "verse_number": "१-११८-४", "content_sanskrit": "जगत्यस्मिन्पुरी रम्या नाम्ना माहिष्मती पुरा ।\nतस्यामासीद्द्विजः कृष्ण नागशर्मेति विश्रुतः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002456004, "chapter_id": 22456, "verse_number": "१-११८-५", "content_sanskrit": "तस्य पुत्रशतं जातं प्रसादाद्भास्करस्य च ।\nतेषां कनिष्ठो भद्रस्तु तत्पुत्राणां विचक्षणः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002456005, "chapter_id": 22456, "verse_number": "१-११८-६", "content_sanskrit": "स च नित्यं जगद्धातुर्देवदेवस्य भास्वतः ।\nदीपवर्तिपरस्तद्वत्तैलाद्याहरणोद्यतः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002456006, "chapter_id": 22456, "verse_number": "१-११८-७", "content_sanskrit": "भानोरायतने तस्य सहस्रं भार्गवीप्रिय ।\nप्रदीपानां तु जज्वाल दिवारात्रमनिन्दितम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002456007, "chapter_id": 22456, "verse_number": "१-११८-८", "content_sanskrit": "तस्य दीप्त्या पराभूतास्तस्य लावण्यधर्षिताः ।\nसर्वे ते भ्रातरो भद्रं पप्रच्छुरिदमादरात् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002456008, "chapter_id": 22456, "verse_number": "१-११८-९", "content_sanskrit": "भो भद्र वद वै भ्रातर्भद्रं तेस्तु सदा द्विज ।\nकौतूहलपराः सर्वे यत्पृच्छामस्तदुच्यताम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002456009, "chapter_id": 22456, "verse_number": "१-११८-१०", "content_sanskrit": "तेषां तद्वचनं श्रुत्वा भद्रो वचनमब्रवीत् ।\nविषये सति वक्तव्यं यन्मया तदिहोच्यताम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002456010, "chapter_id": 22456, "verse_number": "१-११८-११", "content_sanskrit": "नाहं मत्सरयुक्तो वै न च रागादिदूषितः ।\nभवन्तो मम सर्वे वै भ्रातरो गुरवस्तथा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002456011, "chapter_id": 22456, "verse_number": "१-११८-१२", "content_sanskrit": "कथं न कथयाम्येष भवतां पुत्रसम्मितः ।\nतस्माद्ब्रुवन्तु मां सर्वे भ्रातरो यद्विवक्षितम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002456012, "chapter_id": 22456, "verse_number": "१-११८-१३", "content_sanskrit": "भ्रातर ऊचुः ।\nन तथा पुष्पधूपेषु न तथा द्विजपूजने ।\nसुप्रयत्नं तु पश्यामो भानोरायतने परम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002456013, "chapter_id": 22456, "verse_number": "१-११८-१४", "content_sanskrit": "यथाहनि तथा रात्रौ यथा रात्रौ तथाहनि ।\nतव दीपप्रदानाय यथा भद्र सदोद्यमम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002456014, "chapter_id": 22456, "verse_number": "१-११८-१५", "content_sanskrit": "तत्त्वं तत्कथयास्माकं हंत कौतूहलं परम् ।\nयन्नाम दीपदानस्य भवता विदितं फलम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002456015, "chapter_id": 22456, "verse_number": "१-११८-१६", "content_sanskrit": "तदेतत्कथयास्माकं सविशेषं महाबल ।\nएवमुक्तस्ततस्तैस्तु भ्रातृभिश्चोदितो मुदा ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002456016, "chapter_id": 22456, "verse_number": "१-११८-१७", "content_sanskrit": "व्याजहार स भ्रातॄणां न किञ्चिदपि सुव्रत ।\nपुनः पुनरसौ तैस्तु भ्रातृभिश्चोदितो मुदा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002456017, "chapter_id": 22456, "verse_number": "१-११८-१८", "content_sanskrit": "दाक्षिण्यसारो भद्रस्तु कथयामास कृत्स्नशः ।\nभवतां कौतुकं चैतदतीवाल्पेऽपि वस्तुनि ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002456018, "chapter_id": 22456, "verse_number": "१-११८-१९", "content_sanskrit": "तदेष कथयाम्यद्य यद्व्रतं मम सुव्रत ।\nइक्ष्वाकुराज्ञस्तु पुरा वशिष्ठोऽभूत्पुरोहितः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002456019, "chapter_id": 22456, "verse_number": "१-११८-२०", "content_sanskrit": "तेन चायतनं भानोः कारितं सरयूतटे ।\nअहन्यहनि शुश्रूषां पुष्पधूपानुलेपनैः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002456020, "chapter_id": 22456, "verse_number": "१-११८-२१", "content_sanskrit": "दीपदानादिभिश्चैव चक्रे तत्र स वै द्विजः ।\nकार्तिके दीपको भक्त्या प्रदत्तस्तेन वै सदा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002456021, "chapter_id": 22456, "verse_number": "१-११८-२२", "content_sanskrit": "आसीन्निर्वाण एवासौ देवार्चापुरतो निशि ।\nदेवतायतने चाहमवसं व्यथितो भृशम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002456022, "chapter_id": 22456, "verse_number": "१-११८-२३", "content_sanskrit": "पूयशोणितनिष्पन्दं प्रावहन्कायतः सदा ।\nशीर्ण घ्राणो ह्यर्वरवो दुर्गंधपतितस्तथा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002456023, "chapter_id": 22456, "verse_number": "१-११८-२४", "content_sanskrit": "दुष्टबुद्ध्या सदा युक्तः सप्ताश्वं प्रति सुव्रत ।\nयदृच्छ्या दीपदानं वर्त्यादीनां विभावसौ ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002456024, "chapter_id": 22456, "verse_number": "१-११८-२५", "content_sanskrit": "तत्तद्भुक्त्वा सदा तुष्टिं व्रजामि द्विजसत्तमाः ।\nएकदा तु ततस्तस्मिन्भानोरायतने गतः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002456025, "chapter_id": 22456, "verse_number": "१-११८-२६", "content_sanskrit": "रात्रौ दृष्टा मया तत्र भक्ता जागरणागताः ।\nप्रतिश्रयं प्रार्थिताश्च तैश्च दत्तो दयान्वितः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002456026, "chapter_id": 22456, "verse_number": "१-११८-२७", "content_sanskrit": "व्याधितोऽयं सुदीनश्च इति कृत्वा मतिं शुभाम् ।\nततोऽहमग्निमाश्रित्य स्थितस्तेषां समीपतः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002456027, "chapter_id": 22456, "verse_number": "१-११८-२८", "content_sanskrit": "दुष्टां बुद्धिं समाश्रित्य हर्तुकामो विवस्वतः ।\nदिव्यमाभरणं भानोश्छिद्रान्वेषी द्विजोत्तमाः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002456028, "chapter_id": 22456, "verse_number": "१-११८-२९", "content_sanskrit": "स्थितोऽहं भोजका ह्यत्र यदि निद्रां व्रजन्ति ते ।\nयेनास्य वैरिवद्भानोर्हराम्याभरणं शुभम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002456029, "chapter_id": 22456, "verse_number": "१-११८-३०", "content_sanskrit": "अथ सुप्ता भोजकास्ते निद्रया मोहितास्तदा ।\nनिर्वाणाश्चापि दीपास्तु ततोऽहमुत्थितस्त्वरन् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002456030, "chapter_id": 22456, "verse_number": "१-११८-३१", "content_sanskrit": "मुदा परमया युक्तो गतो वैश्वानरं प्रति ।\nप्रज्वाल्यं पावकं यत्नाद्दीपवर्तिन्ततो मया ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002456031, "chapter_id": 22456, "verse_number": "१-११८-३२", "content_sanskrit": "योजयित्वा तु वै दीपे धृतो दीपोऽग्रतो रवेः ।\nहर्तुकामेनाभरणं भानोर्देवस्य सुव्रत ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002456032, "chapter_id": 22456, "verse_number": "१-११८-३३", "content_sanskrit": "अथ ते भोजकाः सर्वे वृद्धा देवस्य पुत्रकाः ।\nतैस्तु दृष्टो ह्यहं तत्र दीपहस्तो विभावसोः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002456033, "chapter_id": 22456, "verse_number": "१-११८-३४", "content_sanskrit": "पुरः स्थितो द्विजश्रेष्ठा गृहीतश्चापि तैरिह ।\nततोऽहं तेजसा मूढो भास्करस्य महात्मनः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002456034, "chapter_id": 22456, "verse_number": "१-११८-३५", "content_sanskrit": "विलपन्करुणं तेषां पादयोरवनिं गतः ।\nतैश्चापि करुणां कृत्वा मुक्तोऽहं भोजकैस्तदा ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002456035, "chapter_id": 22456, "verse_number": "१-११८-३६", "content_sanskrit": "गृहीतो राजपुरुषैः पृष्टश्चापि समन्ततः ।\nकिमिदं भवतारब्धं देवदेवस्य मंदिरे ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002456036, "chapter_id": 22456, "verse_number": "१-११८-३७", "content_sanskrit": "दीपं प्रज्वाल्य दुष्टात्मन्कथ्यतां मा चिरं कुरु ।\nइत्युक्त्वा तु ततस्तैस्तु शस्त्रहस्तैः समावृतः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002456037, "chapter_id": 22456, "verse_number": "१-११८-३८", "content_sanskrit": "ततोऽहं व्याधिना क्लिष्टो भयेन च द्विजोत्तमाः ।\nहित्वा प्राणान्गतो यत्र स्वयं देवो विभावसुः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002456038, "chapter_id": 22456, "verse_number": "१-११८-३९", "content_sanskrit": "स्थित्वा कल्पं ततस्तत्र युष्माकं भ्रातृतां गतः ।\nएष प्रभावो दीपस्य कार्तिके मासि सुव्रताः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002456039, "chapter_id": 22456, "verse_number": "१-११८-४०", "content_sanskrit": "दत्तस्यार्कस्य भवने यस्येयं व्युष्टिरुत्तमा ।\nदुष्टबुद्ध्या कृतं यत्तु मया दीपप्रवर्तनम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002456040, "chapter_id": 22456, "verse_number": "१-११८-४१", "content_sanskrit": "भगायतनदीपस्य तस्येदं भुज्यते फलम् ।\nक्षुधाभिभूतेन मया देवदेवस्य भूषणम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002456041, "chapter_id": 22456, "verse_number": "१-११८-४२", "content_sanskrit": "दीपश्च देवपुरतो ज्वालितो भास्करस्य तु ।\nततो जातिस्मृतिर्जन्म प्रान्तं ब्राह्मणवेश्मनि ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002456042, "chapter_id": 22456, "verse_number": "१-११८-४३", "content_sanskrit": "कुष्ठिना चापि शूद्रेण प्राप्तं ब्राह्मण्यमुत्तमम् ।\nनानाविधानि शास्त्राणि सांगं वेदं समाप्तवान् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002456043, "chapter_id": 22456, "verse_number": "१-११८-४४", "content_sanskrit": "दुष्टबुद्ध्या धृताद्दीपात्फलमेतन्महाद्भुतम् ।\nप्राप्तं मया द्विजश्रेष्ठाः किं पुनर्दीपदायिनाम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002456044, "chapter_id": 22456, "verse_number": "१-११८-४५", "content_sanskrit": "एतस्मात्कारणाद्दीपानहमेवमहर्निशम् ।\nप्रयच्छामि रवेर्धाम्नि ज्ञातमस्य हि यत्फलम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002456045, "chapter_id": 22456, "verse_number": "१-११८-४६", "content_sanskrit": "युष्माकमिदमुक्तं वै स्नेहात्सत्यं न संशयः ।\nएष प्रभावो दीपस्य कार्तिके मासि सुव्रताः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002456046, "chapter_id": 22456, "verse_number": "१-११८-४७", "content_sanskrit": "अर्कायतनदीपस्य भद्रोवोचद्यथा पुरा ।\nदिनेदिने जपन्नाम भास्करस्य समाहितः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002456047, "chapter_id": 22456, "verse_number": "१-११८-४८", "content_sanskrit": "ददाति कार्तिके यस्तु भगायतनदीपकम् ।\nजातिस्मरत्वं प्रज्ञां च प्राकाश्यं सर्वजन्तुषु ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002456048, "chapter_id": 22456, "verse_number": "१-११८-४९", "content_sanskrit": "अव्याहतेन्द्रियत्वं च समाप्नोति न संशयः ।\nसर्वकालं च चक्षुष्मान्मेधावी दीपदो नरः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002456049, "chapter_id": 22456, "verse_number": "१-११८-५०", "content_sanskrit": "जायते नरकं चापि तमः संज्ञं न पश्यति ।\nषष्ठीं वा सप्तमीं वापि प्रतिपक्षं च यो नरः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7002456050, "chapter_id": 22456, "verse_number": "१-११८-५१", "content_sanskrit": "दीपं ददाति यत्नाद्यत्फलं तस्य निबोध मे ।\nकाञ्चनं मणियुक्तं च मनोज्ञमतिशोभनम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7002456051, "chapter_id": 22456, "verse_number": "१-११८-५२", "content_sanskrit": "दीपमालाकुलं दिव्यं विमानमधिरोहति ।\nतस्मादायतने भानोर्दीपान्दद्यात्सदाच्युत ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7002456052, "chapter_id": 22456, "verse_number": "१-११८-५३", "content_sanskrit": "तांश्च दत्त्वा न हिंस्याच्च न च तैलवियोजितान् ।\nकुर्वीत दीपहर्ता तु मूषकोन्धश्च जायते ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7002456053, "chapter_id": 22456, "verse_number": "१-११८-५४", "content_sanskrit": "तस्माद्दद्यान्नाहरेद्वै श्रेयोऽर्थी दीपकं नरः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]