[{"id": 2195559, "chapter_id": 5161, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2195560, "chapter_id": 5161, "verse_number": "१", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nमद्रराजस्य संवादं व्यासस्य च महात्मनः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2195561, "chapter_id": 5161, "verse_number": "२", "content_sanskrit": "वैताने कर्मणि तते कुन्तीपुत्रस्य धीमतः ।\nउक्तो भगवान् यज्ञार्थे तेन तत्रानृणोऽभवत्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2195562, "chapter_id": 5161, "verse_number": "", "content_sanskrit": "मद्रराजः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2195563, "chapter_id": 5161, "verse_number": "३", "content_sanskrit": "कानि तीर्थानि भगवन् फलार्थाश्चेह के श्रमाः ।\nक इज्यते कश्च यज्ञः को यूपः क्रमते च कः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2195564, "chapter_id": 5161, "verse_number": "४", "content_sanskrit": "कश्चाध्वरे शस्यते गीतिशब्दैः\nकश्चाध्वरे गीयते वल्गुभाषैः ।\nको ब्रह्मशब्दैः स्तुतिभिः स्तूयते च\nकस्येह वै हविरध्वर्यवः कल्पयन्ति\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2195565, "chapter_id": 5161, "verse_number": "५", "content_sanskrit": "वर्ण्यो ग्रामे गोफले य(क)श्च सोमे\nकश्चोङ्कारः कश्च वेदार्थमार्गः ।\nपृष्टस्तन्मे ब्रूहि सर्वं महर्षे\nलोकज्येष्ठं कस्य विज्ञानमाहुः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2195566, "chapter_id": 5161, "verse_number": "", "content_sanskrit": "द्वैपायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2195567, "chapter_id": 5161, "verse_number": "६", "content_sanskrit": "लोकज्येष्ठं यस्य विज्ञानमाहु-\nर्योनिज्येष्ठं यस्य वदन्ति जन्म ।\nपूतात्मानो ब्राह्मणा वेदमुख्या\nअस्मिन् प्रश्नो दीयतां केशवाय\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2195568, "chapter_id": 5161, "verse_number": "", "content_sanskrit": "ब्राह्मणाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2195569, "chapter_id": 5161, "verse_number": "७", "content_sanskrit": "बालो जात्या क्षत्रधर्मार्थशीलो\nजातो देवक्यां शूरपुत्रेण वीरः ।\nवेत्तुं वेदानर्हते क्षत्रियो वै\nदाशार्हाणामुत्तमः पुष्कराक्षः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2195570, "chapter_id": 5161, "verse_number": "", "content_sanskrit": "वासुदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2195571, "chapter_id": 5161, "verse_number": "८", "content_sanskrit": "पाराशर्य ब्रूहि यद् ब्राह्मणेभ्यः\nप्रीतात्मा वै ब्रह्मकल्पः सुमेधाः ।\nपृष्टो यज्ञार्थं पाण्डवस्यातितेजा\nएतच्छ्रेयस्तस्य लोकस्य चैव\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2195572, "chapter_id": 5161, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2195573, "chapter_id": 5161, "verse_number": "९", "content_sanskrit": "उक्तं वाक्यं यद् भवान् मामवोचत्\nप्रश्नं चित्रं नाहमत्रोत्सहेऽद्य ।\nछेत्तुं विस्पष्टं तिष्ठति त्वद्विधे वै\nलोकज्येष्ठे विश्वरूपे सुनाभे\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2195574, "chapter_id": 5161, "verse_number": "", "content_sanskrit": "वासुदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2195575, "chapter_id": 5161, "verse_number": "१०", "content_sanskrit": "तत्त्वं वाक्यं ब्रूहि यत् त्वं महर्षे\nयस्मिन् कृष्णः प्रोच्यते वै यथावत् ।\nप्रीतस्तेऽहं ज्ञानशक्त्या यथावत्\nतस्मान्निर्देशे कर्मणां ब्रूहि सिद्धम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2195576, "chapter_id": 5161, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2195577, "chapter_id": 5161, "verse_number": "११", "content_sanskrit": "उक्तवाक्ये सत्तमे यादवानां\nकृष्णे व्यासः प्राञ्जलिर्वासुदेवम् ।\nविप्रैः सार्धं पूजयन् देवदेवं\nकृष्णं विष्णुं वासुदेवं बभाषे\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2195578, "chapter_id": 5161, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2195579, "chapter_id": 5161, "verse_number": "१२", "content_sanskrit": "आनन्त्यं ते विश्वकर्मंस्तवैवं\nरूपं पौराणं शाश्वतं च ध्रुवं च ।\nकस्ते बुद्ध्येद् वेदवादेषु चैत-\nल्लोके ह्यस्मिन् शासकस्त्वं पितेव\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2195580, "chapter_id": 5161, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि\nदानधर्मे वेदव्यासोदाहरणं नाम द्वादशोऽध्यायः ॥१२॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]