[{"id": 2185609, "chapter_id": 4939, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2185610, "chapter_id": 4939, "verse_number": "१", "content_sanskrit": "सर्वमेतत् तपोमूलं कवयः परिचक्षते ।\nन ह्यतप्ततपा मूढः क्रियाफलमवाप्नुते\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2185611, "chapter_id": 4939, "verse_number": "२", "content_sanskrit": "प्रजापतिरिदं सर्वं तपसैवासृजत् प्रभुः ।\nतथैव वेदानृषयस्तपसा प्रतिपेदिरे\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2185612, "chapter_id": 4939, "verse_number": "३", "content_sanskrit": "तपसो ह्यानुपूर्व्येण फलमूलानिलाशनाः ।\nत्रीन् लोकांस्तपसा सिद्धाः पश्यन्ति सुसमाहिताः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2185613, "chapter_id": 4939, "verse_number": "४", "content_sanskrit": "औषधान्यगदादीनि तिस्रो विद्याश्च संस्कृताः ।\nतपसैव हि सिध्यन्ति तपोमूलं हि साधनम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2185614, "chapter_id": 4939, "verse_number": "५", "content_sanskrit": "यद्दुरापं दुराम्नायं दुराधर्षं दुरुत्सहम् ।\nसर्वं तत्तपसा शक्यं तपो हि दुरतिक्रमम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2185615, "chapter_id": 4939, "verse_number": "६", "content_sanskrit": "सुरापोऽसम्मतादायी भ्रूणहा गुरुतल्पगः ।\nतपसैव सुतप्तेन नरः पापाद् विमुच्यते\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2185616, "chapter_id": 4939, "verse_number": "७", "content_sanskrit": "तपसो बहुरूपस्य तैस्तैर्द्वारैः प्रवर्ततः ।\nनिवृत्त्या वर्तमानस्य तपो नानशनात् परम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2185617, "chapter_id": 4939, "verse_number": "८", "content_sanskrit": "अहिंसा सत्यवचनं दानमिन्द्रियनिग्रहः ।\nएतेभ्यो हि महाराज तपो नानशनात् परम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2185618, "chapter_id": 4939, "verse_number": "९", "content_sanskrit": "न दुष्करतरं दानान्नातिमातरमाश्रमः ।\nत्रैविद्येभ्यः परं नास्ति संन्यासः परमं तपः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2185619, "chapter_id": 4939, "verse_number": "१०", "content_sanskrit": "इन्द्रियाणीह रक्षन्ति विप्रर्षिपितृदेवताः ।\nतस्मादर्थे च धर्मे च तपो नानशनात् परम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2185620, "chapter_id": 4939, "verse_number": "११", "content_sanskrit": "ऋषयः पितरो देवा मनुष्या मृगसत्तमाः ।\nयानि चान्यानि भूतानि स्थावराणि चराणि च\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2185621, "chapter_id": 4939, "verse_number": "१२", "content_sanskrit": "तपःपरायणाः सर्वे सिध्यन्ति तपसा च ते ।\nइत्येवं तपसा देवा महत्त्वं चाप्यवाप्नुवन्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2185622, "chapter_id": 4939, "verse_number": "१३", "content_sanskrit": "इमानीष्टविभागानि फलानि तपसः सदा ।\nतपसा शक्यते प्राप्तुं देवत्वमपि निश्चयात्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2185623, "chapter_id": 4939, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि आपद्धर्मे सप्तविंशोऽध्यायः ॥ २७ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]