[{"id": 7004823000, "chapter_id": 24823, "verse_number": "७-१-६-१", "content_sanskrit": "देव्युवाच ।\nअत्यद्भुतं महादेव माहात्म्यं कथितं मम ।\nअपूर्वं देवदेवेश कदाचिन्न श्रुतं मया ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004823001, "chapter_id": 24823, "verse_number": "७-१-६-२", "content_sanskrit": "ब्रह्मांडे यानि लिंगानि कीर्तितानि त्वया मम ।\nतेषां प्रभावेनाधिक्यं सोमेशे तत्कथं वद ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004823002, "chapter_id": 24823, "verse_number": "७-१-६-३", "content_sanskrit": "किं प्रभावो महादेव क्षेत्रस्य च सुरेश्वर ।\nतन्मे ब्रूहि सुरेशान याथातथ्यं ममाग्रतः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004823003, "chapter_id": 24823, "verse_number": "७-१-६-४", "content_sanskrit": "ईश्वर उवाच ।\nअतः परं प्रवक्ष्यामि रहस्यं परमं तव ।\nप्रभासक्षेत्रमाहात्म्यं सोमेशस्य वरानने ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004823004, "chapter_id": 24823, "verse_number": "७-१-६-५", "content_sanskrit": "तीर्थानां परमं तीर्थं व्रतानां परमं व्रतम् ।\nजाप्यानां परमं जाप्यं ध्यानानां ध्यानमुत्तमम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004823005, "chapter_id": 24823, "verse_number": "७-१-६-६", "content_sanskrit": "योगानां परमो योगो रहस्यं परमं महत् ।\nतत्तेहं संप्रवक्ष्यामि शृणु ह्येकमना प्रिये ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004823006, "chapter_id": 24823, "verse_number": "७-१-६-७", "content_sanskrit": "सोमेशं परमं स्थानं पंचवक्त्रसमन्वितम् ।\nएतल्लिंगं न मुंचामि सत्यंसत्यं मयोदितम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004823007, "chapter_id": 24823, "verse_number": "७-१-६-८", "content_sanskrit": "यच्च तत्परमं देवि ध्रुवमक्षयमव्ययम् ।\nसोमेशं तद्विजानीहि मा विकल्पमना भव ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004823008, "chapter_id": 24823, "verse_number": "७-१-६-९", "content_sanskrit": "निर्भयं निर्मलं नित्यं निरपेक्षं निराश्रयम् ।\nनिरंजनं निष्प्रपंचं निःसंगं निरुपद्रवम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004823009, "chapter_id": 24823, "verse_number": "७-१-६-१०", "content_sanskrit": "तल्लिंगमिति जानीहि प्रभासे संव्यवस्थितम् ।\nअपवर्गमविज्ञेयं मनोरम्यमनामयम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004823010, "chapter_id": 24823, "verse_number": "७-१-६-११", "content_sanskrit": "नित्यं च कारणं देवं मखघ्नं सर्वतोमुखम् ।\nशिवं सर्वात्मकं सूक्ष्ममनाद्यं यच्च दैवतम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004823011, "chapter_id": 24823, "verse_number": "७-१-६-१२", "content_sanskrit": "आत्मोपलब्धिविज्ञेयं चित्तचिंताविवर्जितम् ।\nगमागमविनिर्मुक्तं बहिरंतश्च केवलम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004823012, "chapter_id": 24823, "verse_number": "७-१-६-१३", "content_sanskrit": "आत्मोपलब्धिविषयं स्तुतिगोचरवर्जितम् ।\nनिष्कलं विमलात्मानं प्रकटं ज्ञानदीपकम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004823013, "chapter_id": 24823, "verse_number": "७-१-६-१४", "content_sanskrit": "तल्लिंगमिति जानीहि प्रभासे सुरसुंदरि ।\nनिरावकाशरहितं शब्दं शब्दांतगोचरम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004823014, "chapter_id": 24823, "verse_number": "७-१-६-१५", "content_sanskrit": "निष्कलं विमलं देवं देवदेवं सुरात्मकम् ।\nहेतुप्रमाणरहितं कल्पनाभाववर्जितम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004823015, "chapter_id": 24823, "verse_number": "७-१-६-१६", "content_sanskrit": "चित्तावलोकविषयं बहिरंतरसंस्थितम् ।\nप्रभासे तं विजानीहि प्रणवं लिंगरूपिणम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004823016, "chapter_id": 24823, "verse_number": "७-१-६-१७", "content_sanskrit": "अनिष्पंदं महात्मानं निरानंदावलोकनम् ।\nलोकावलोकमार्गस्थं विशुद्धज्ञानकेवलम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004823017, "chapter_id": 24823, "verse_number": "७-१-६-१८", "content_sanskrit": "विद्याविशेषमार्गस्थमनेकाकारसंज्ञितम् ।\nस्वभावभावनाग्राह्यं भावातीतमलक्षणम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004823018, "chapter_id": 24823, "verse_number": "७-१-६-१९", "content_sanskrit": "वाक्प्रपंचादिरहितं निष्प्रपञ्चात्मकं शिवम् ।\nज्ञानज्ञेयावलोकस्थं हेत्वाभासविवर्जितम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004823019, "chapter_id": 24823, "verse_number": "७-१-६-२०", "content_sanskrit": "अनाहतं शब्दगतं शब्दादिगणसंभवम् ।\nएवं सोमेश्वरं विद्धि प्रभासे लिंगरूपिणम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004823020, "chapter_id": 24823, "verse_number": "७-१-६-२१", "content_sanskrit": "शब्दब्रह्मगतं शान्तं स शब्दांतगमास्पदम् ।\nसर्वातिरिक्त विषयं सर्वध्यानपदे स्थितम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004823021, "chapter_id": 24823, "verse_number": "७-१-६-२२", "content_sanskrit": "अनादिमच्युतं दिव्यं प्रमाणातीत गोचरम् ।\nअधश्चोर्ध्वं गतं नित्यं जीवाख्यं देहसंस्थितम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004823022, "chapter_id": 24823, "verse_number": "७-१-६-२३", "content_sanskrit": "हृदादिद्वादशांतस्थं प्राणापानोदयास्तगम् ।\nअग्राह्यमिन्द्रियात्मानं निष्कलंकात्मकं विभुम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004823023, "chapter_id": 24823, "verse_number": "७-१-६-२४", "content_sanskrit": "स्वरादिव्यंजनातीतं वर्णादिपरिवर्जितम् ।\nवाचामवाच्यविषयमहंकारार्द्धरूपिणम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004823024, "chapter_id": 24823, "verse_number": "७-१-६-२५", "content_sanskrit": "अप्रतर्क्यमनुच्चार्यं कलनाकालवर्जितम् ।\nनिःशब्दं निश्चलं सौम्यं देहातीतं परात्परम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004823025, "chapter_id": 24823, "verse_number": "७-१-६-२६", "content_sanskrit": "भूतावग्रहरहितं भावाभावविवर्जितम् ।\nअविज्ञेयं परं सूक्ष्मं पञ्चपञ्चादिसंभवम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004823026, "chapter_id": 24823, "verse_number": "७-१-६-२७", "content_sanskrit": "अप्रमेयमनंताख्यमक्षयं कामरूपिणम् ।\nप्रभवं सर्वभूतानां बीजांकुरसमुद्भवम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004823027, "chapter_id": 24823, "verse_number": "७-१-६-२८", "content_sanskrit": "व्यापकं सर्वकामाख्यमक्षरं परमं महत् ।\nस्थूलसूक्ष्मविभागस्थं व्यक्ताव्यक्तं सनातनम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004823028, "chapter_id": 24823, "verse_number": "७-१-६-२९", "content_sanskrit": "कल्पकल्पान्तरहितमनादिनिधनं महत् ।\nमहाभूतं महाकायं शिवं निर्वाणभैरवम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004823029, "chapter_id": 24823, "verse_number": "७-१-६-३०", "content_sanskrit": "एवं सदाशिवं विद्धि प्रभासे लिंगरूपिणम् ।\nयोगक्रिया विनिर्मुक्तं मृत्युंजयमनादिमत् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004823030, "chapter_id": 24823, "verse_number": "७-१-६-३१", "content_sanskrit": "सर्वोपसर्गरहितं सर्वतोव्यापकं शिवम् ।\nअव्यक्तं परतो नित्यं केवलं द्वैतवर्जितम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004823031, "chapter_id": 24823, "verse_number": "७-१-६-३२", "content_sanskrit": "अनन्यतेजसाक्रांतं प्रभासक्षेत्रवासिनम् ।\nभूरिस्वयंप्रभप्रख्यं सर्वतेजोऽधिकं हरम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004823032, "chapter_id": 24823, "verse_number": "७-१-६-३३", "content_sanskrit": "शरण्यंदेवमीशानमोंकारं शिवरूपिणम् ।\nदेवदेवं महादेवं पंचवक्त्रं वृषध्वजम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004823033, "chapter_id": 24823, "verse_number": "७-१-६-३४", "content_sanskrit": "निर्मलं मानसातीतं भावग्राह्यमनूपमम् ।\nसदा शांतं विरूपाक्षं शूलहस्तं जटाधरम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004823034, "chapter_id": 24823, "verse_number": "७-१-६-३५", "content_sanskrit": "हृत्पद्मकोशमध्यस्थं शून्यरूपं निरञ्जनम् ।\nएवं सदाशिवं विद्धि प्रभासे लिङ्गरूपिणम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004823035, "chapter_id": 24823, "verse_number": "७-१-६-३६", "content_sanskrit": "योऽसौ परात्परो देवो हंसाख्यः परिकीर्तितः ।\nनादाख्यः सुव्रते देवि सोऽस्मिन्स्थाने स्थितः स्वयम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004823036, "chapter_id": 24823, "verse_number": "७-१-६-३७", "content_sanskrit": "एतदादिस्वरूपं च मया योगबलेन तु ।\nविज्ञातं देवि गदितं दिव्यमात्मानमात्मना ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004823037, "chapter_id": 24823, "verse_number": "७-१-६-३८", "content_sanskrit": "ऋग्वेदस्थस्तु पूर्वाह्णे मध्याह्ने यजुषि स्थितः ।\nअपराह्णे तु सामस्थो ह्यथर्वस्थो निशागमे ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004823038, "chapter_id": 24823, "verse_number": "७-१-६-३९", "content_sanskrit": "वेदाहमेतं पुरुषं महांतमादित्यवर्णं तमसः परस्तात् ।\nतमेव विदित्वा न भवेत्तु मृत्युर्नान्यः पंथा विद्यते वै जनानाम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004823039, "chapter_id": 24823, "verse_number": "७-१-६-४०", "content_sanskrit": "इतीरितस्ते तु महाप्रभावः सोमेशलिंगस्य कृतैकदेशः ।\nवृतं न चाब्दैर्बहुभिः सहस्रैर्वक्तुं च केनापि मुखैर्न शक्यम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004823040, "chapter_id": 24823, "verse_number": "७-१-६-४१", "content_sanskrit": "ब्राह्मणः क्षत्रियो वैश्यः शूद्रोऽपीदं पठेद्यदि ।\nनिर्मुक्तः सर्वपापेभ्यः सर्वान्कामानवाप्नुयात् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004823041, "chapter_id": 24823, "verse_number": "७-१-६-४२", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां सप्तमे प्रभासखण्डे प्रथमे प्रभासक्षेत्रमाहात्म्ये श्रीसोमेश्वरमहिमवर्णनं नाम षष्ठोऽध्यायः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]