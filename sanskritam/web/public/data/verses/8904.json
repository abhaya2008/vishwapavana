[{"id": 40003999, "chapter_id": 8904, "verse_number": "1", "content_sanskrit": "अनुरक्ता महात्मानं रामं सत्यपराक्रमम्। अनुजग्मुः प्रयान्तं तं वनवासाय मानवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40004000, "chapter_id": 8904, "verse_number": "2", "content_sanskrit": "निवर्तितेऽपि च बलात्सुहृद्वर्गे च राजनि। नैव ते संन्यवर्तन्त रामस्यानुगता रथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40004001, "chapter_id": 8904, "verse_number": "3", "content_sanskrit": "अयोध्यानिलयानां हि पुरुषाणां महायशाः। बभूव गुणसम्पन्नः पूर्णचन्द्र इव प्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40004002, "chapter_id": 8904, "verse_number": "4", "content_sanskrit": "स याच्यमानः काकुत्स्थः स्वाभिः प्रकृतिभिस्तदा। कुर्वाणः पितरं सत्यं वनमेवान्वपद्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40004003, "chapter_id": 8904, "verse_number": "5", "content_sanskrit": "अवेक्षमाणः सस्नेहं चक्षुषा प्रपिबन्निव। उवाच रामः स्नेहेन ताः प्रजाः स्वाः प्रजा इव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40004004, "chapter_id": 8904, "verse_number": "6", "content_sanskrit": "या प्रीतिर्बहुमानश्च मय्ययोध्यानिवासिनाम्। मत्प्रियार्थं विशेषेण भरते सा निवेश्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40004005, "chapter_id": 8904, "verse_number": "7", "content_sanskrit": "स हि कल्याणचारित्रः कैकेय्यानन्दवर्धनः। करिष्यति यथावद्वः प्रियाणि च हितानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40004006, "chapter_id": 8904, "verse_number": "8", "content_sanskrit": "ज्ञानवृद्धो वयोबालो मृदुर्वीर्यगुणान्वितः। अनुरूपः स वो भर्ता भविष्यति भयापहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40004007, "chapter_id": 8904, "verse_number": "9", "content_sanskrit": "स हि राजगुणैर्युक्तो युवराजः समीक्षितः। अपि चापि मया शिष्टैः कार्यं वो भर्तृशासनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40004008, "chapter_id": 8904, "verse_number": "10", "content_sanskrit": "न च सन्तप्येद्यथा चासौ वनवासं गते मयि। महाराजस्तथा कार्यो मम प्रियचिकीर्षया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40004009, "chapter_id": 8904, "verse_number": "11", "content_sanskrit": "यथा यथा दाशरथि र्धर्म एवास्थितोऽभवत्। तथा तथा प्रकृतयो रामं पतिमकामयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40004010, "chapter_id": 8904, "verse_number": "12", "content_sanskrit": "बाष्पेण पिहितं दीनं रामः सौमित्रिणा सह। चकर्षेव गुणैर्बद्ध्वा जनं पुरनिवासिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40004011, "chapter_id": 8904, "verse_number": "13", "content_sanskrit": "ते द्विजास्त्रिविधं वृद्धा ज्ञानेन वयसौजसा। वयः प्रकम्पशिरसो दूरादूचुरिदं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40004012, "chapter_id": 8904, "verse_number": "14", "content_sanskrit": "वहन्तो जवना रामं भो भो जात्यास्तुरङ्गमाः। निवर्तध्वं न गन्तव्यं हिता भवत भर्तरि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40004013, "chapter_id": 8904, "verse_number": "15", "content_sanskrit": "कर्णवन्ति हि भूतानि विशेषेण तुरङ्गमाः। यूयं तस्मान्निवर्तध्वं याचनां प्रतिवेदिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40004014, "chapter_id": 8904, "verse_number": "16", "content_sanskrit": "धर्मतः स विशुद्धात्मा वीरः शुभदृढव्रतः। उपवाह्यस्तु वो भर्ता नापवाह्यः पुराद्वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40004015, "chapter_id": 8904, "verse_number": "17", "content_sanskrit": "एवमार्तप्रलापांस्तान् वृद्धान् प्रलपतो द्विजान्। अवेक्ष्य सहसा रामो रथादवततार ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40004016, "chapter_id": 8904, "verse_number": "18", "content_sanskrit": "पद्भ्यामेव जगामाथ ससीत स्सहलक्ष्मणः। सन्निकृष्टपदन्यासो रामो वनपरायणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40004017, "chapter_id": 8904, "verse_number": "19", "content_sanskrit": "द्विजातींस्तु पदातींस्तान् रामश्चारित्रवत्सलः। न शशाक घृणाचक्षुः परिमोक्तुं रथेन सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40004018, "chapter_id": 8904, "verse_number": "20", "content_sanskrit": "गच्छन्तमेव तं दृष्ट्वा रामं सम्भ्रान्तचेतसः। ऊचुः परमसन्तप्ता रामं वाक्यमिदं द्विजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40004019, "chapter_id": 8904, "verse_number": "21", "content_sanskrit": "ब्राह्मण्यं सर्वमेतत्त्वां ब्रह्मण्यमनुगच्छति। द्विजस्कन्धाधिरूढास्त्वामग्नयोऽप्यनुयान्त्यमी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40004020, "chapter_id": 8904, "verse_number": "22", "content_sanskrit": "वाजपेयसमुत्थानि छत्राण्येतानि पश्य नः। पृष्ठतोऽनुप्रयातानि मेघानिव जलात्यये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40004021, "chapter_id": 8904, "verse_number": "23", "content_sanskrit": "अनवाप्तातपत्रस्य रश्मिसन्तापितस्य ते। एभिश्छायां करिष्यामः स्वैश्छत्रैर्वाजपेयिकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40004022, "chapter_id": 8904, "verse_number": "24", "content_sanskrit": "या हि नः सततं बुद्धिर्वेदमन्त्रानुसारिणी। त्वत्कृते सा कृता वत्स वनवासानुसारिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40004023, "chapter_id": 8904, "verse_number": "25", "content_sanskrit": "हृदयेष्वेव तिष्ठन्ति वेदा ये नः परं धनम्। वत्स्यन्त्यपि गृहेष्वेव दाराश्चारित्ररक्षिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40004024, "chapter_id": 8904, "verse_number": "26", "content_sanskrit": "न पुनर्निश्चयः कार्यस्त्वद्गतौ सुकृता मतिः। त्वयि धर्मव्यपेक्षे तु किं स्याद्धर्मपथे स्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40004025, "chapter_id": 8904, "verse_number": "27", "content_sanskrit": "याचितो नो निवर्तस्व हंसशुक्लशिरोरुहैः। शिरोभिर्निभृताचार महीपतनपांसुलैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40004026, "chapter_id": 8904, "verse_number": "28", "content_sanskrit": "बहूनां वितता यज्ञा द्विजानां य इहागताः। तेषां समाप्तिरायत्ता तव वत्स निवर्तने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40004027, "chapter_id": 8904, "verse_number": "29", "content_sanskrit": "भक्तिमन्ति हि भूतानि जङ्गमाजङ्गमानि च। याचमानेषु राम त्वं भक्तिं भक्तेषु दर्शय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40004028, "chapter_id": 8904, "verse_number": "30", "content_sanskrit": "अनुगन्तुमशक्ता स्त्वां मूलैरुद्धतवेगिनः। उन्नता वायुवेगेन विक्रोशन्तीव पादपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40004029, "chapter_id": 8904, "verse_number": "31", "content_sanskrit": "निश्चेष्टाहारसञ्चारा वृक्षैकस्थानविष्ठिताः। पक्षिणोऽपि प्रयाचन्ते सर्वभूतानुकम्पिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40004030, "chapter_id": 8904, "verse_number": "32", "content_sanskrit": "एवं विक्रोशतां तेषां द्विजातीनां निवर्तने। ददृशे तमसा तत्र वारयन्तीव राघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40004031, "chapter_id": 8904, "verse_number": "33", "content_sanskrit": "ततः सुमन्त्रोऽपि रथाद्विमुच्य श्रान्तान्हयान्सम्परिवर्त्य शीघ्रम्। पीतोदकांस्तोयपरिप्लुताङ्गा नचारयद्वै तमसाविदूरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]