[{"id": 7001721000, "chapter_id": 21721, "verse_number": "१-१०७-१", "content_sanskrit": "ब्रह्मोवाच ।\nअथ मात्स्यं पुराणं ते प्रवक्ष्ये द्विजसत्तम ।\nयत्रोक्तं सप्तकल्पानां वृत्तं संक्षिप्य भूतले ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001721001, "chapter_id": 21721, "verse_number": "१-१०७-२", "content_sanskrit": "व्यासेन वेदविदुषा नारसिंहोपवर्णने ।\nउपक्रम्य तदुद्दिष्टं चतुर्द्दशसहस्रकम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001721002, "chapter_id": 21721, "verse_number": "१-१०७-३", "content_sanskrit": "मनुमत्स्यसुसंवादो ब्रह्मांडकथनं ततः ।\nब्रह्मदेवासुरोत्पत्तिर्मारुतोत्पत्तिरेव च ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001721003, "chapter_id": 21721, "verse_number": "१-१०७-४", "content_sanskrit": "मदनद्वादशी तद्वल्लोकपालाभिपूजनम् ।\nमन्वन्तरसमुद्देशो वैश्यराज्याभिवर्णनम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001721004, "chapter_id": 21721, "verse_number": "१-१०७-५", "content_sanskrit": "सूर्यवैवस्वतोत्पत्तिर्बुधसंगमनं तथा ।\nपितृवंशानुकथनं श्रद्धाकालस्तथैव च ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001721005, "chapter_id": 21721, "verse_number": "१-१०७-६", "content_sanskrit": "पितृतीर्थप्रचारश्च सोमोत्पत्तिस्तथैव च ।\nकीर्तनं सोमवंशस्य ययातिचरितं तथा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001721006, "chapter_id": 21721, "verse_number": "१-१०७-७", "content_sanskrit": "पितृवंशानुकथनं सृष्टवंशानुकीर्तनम् ।\nभृगुशापस्तथा विष्णोर्दशधा जन्मने क्षितौ ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001721007, "chapter_id": 21721, "verse_number": "१-१०७-८", "content_sanskrit": "कीर्त्तनं पूरुवंशस्य वंशो हौताशनः परम् ।\nक्रियायोगस्ततः पश्चात्पुराणपरिकीर्तनम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001721008, "chapter_id": 21721, "verse_number": "१-१०७-९", "content_sanskrit": "व्रतं नक्षत्रपुरुषं मार्तण्डशयनं तथा ।\nकृष्णाष्टमीव्रतं तद्वद्रोहिणीचन्द्रसंज्ञितम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001721009, "chapter_id": 21721, "verse_number": "१-१०७-१०", "content_sanskrit": "तडागविधि माहात्म्यं पादपोत्सर्ग एव च ।\nसौभाग्यशयनं तद्वदगस्त्यव्रतमेव च ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001721010, "chapter_id": 21721, "verse_number": "१-१०७-११", "content_sanskrit": "तथानन्ततृतीयाया रसकल्याणिनीव्रतम् ।\nतथैवानं दकर्याश्च व्रतं सारस्वतं पुनः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001721011, "chapter_id": 21721, "verse_number": "१-१०७-१२", "content_sanskrit": "उपरागाभिषेकश्च सप्तमीशनं तथा ।\nभीमाख्या द्वादशी तद्वदनंगशयनं तथा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001721012, "chapter_id": 21721, "verse_number": "१-१०७-१३", "content_sanskrit": "अशून्यशयनं तद्वत्तथैवांगारकव्रतम् ।\nसप्तमीसप्तकं तद्वद्विशोकद्वादशीव्रतम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001721013, "chapter_id": 21721, "verse_number": "१-१०७-१४", "content_sanskrit": "मेरुप्रदानं दशधा ग्रहशांतिस्तथैव च ।\nग्रहस्वरूपकथनं तथा शिवचतुर्दशी ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001721014, "chapter_id": 21721, "verse_number": "१-१०७-१५", "content_sanskrit": "तथा सर्वफलत्यागः सूर्यवारव्रतं तथा ।\nसंक्रांतिस्नपनं तद्वद्विभूतिद्वादशीव्रतम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001721015, "chapter_id": 21721, "verse_number": "१-१०७-१६", "content_sanskrit": "षष्टीव्रतानां माहात्म्यं तथा स्नानविधिकमः ।\nप्रयागस्य तु माहात्म्यं द्वीपलोकानुवर्णनम् ॥१६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001721016, "chapter_id": 21721, "verse_number": "१-१०७-१७", "content_sanskrit": "तथांतरिक्षचारश्च ध्रुवमाहात्म्यमेव च ।\nभवनानि सुरेंद्राणां त्रिपुरोद्योतनं तथा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001721017, "chapter_id": 21721, "verse_number": "१-१०७-१८", "content_sanskrit": "पितृप्रवरमाहात्म्यं मन्वंतरविनिर्णयः ।\nचतुर्युगस्य संभूतिर्युगधर्मनिरूपणम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001721018, "chapter_id": 21721, "verse_number": "१-१०७-१९", "content_sanskrit": "वज्रांगस्य तु संभूति स्तारकोत्पत्तिरेव च ।\nतारकासुरमाहात्म्यं ब्रह्मदेवानुकीर्तनम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001721019, "chapter_id": 21721, "verse_number": "१-१०७-२०", "content_sanskrit": "पार्वतीसंभवस्तद्वत्तथा शिवतपोवनम् ।\nअनंगदेहदाहश्च रतिशोकस्तथैव च ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001721020, "chapter_id": 21721, "verse_number": "१-१०७-२१", "content_sanskrit": "गौरीतपोवनं तद्वच्छिवेनाथ प्रसादनम् ।\nपार्वतीऋषिसंवादस्तथैरोद्वाहमंगलम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001721021, "chapter_id": 21721, "verse_number": "१-१०७-२२", "content_sanskrit": "कुमारसंभवस्तद्वत्कुमारविजयस्तथा ।\nतारकस्य वधो घोरो नरसिंहोपवर्णनम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001721022, "chapter_id": 21721, "verse_number": "१-१०७-२३", "content_sanskrit": "पद्मोद्भवविसर्गस्तु तथैवांधकघातनम् ।\nवाराणस्यास्तु माहात्म्यं नर्मदायास्तथैव च ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001721023, "chapter_id": 21721, "verse_number": "१-१०७-२४", "content_sanskrit": "प्रवरानुक्रमस्तद्वत्पितृगाथानुकीर्तनम् ।\nतथोभयमुखीदानं दानं कृष्णाजिनस्य च ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001721024, "chapter_id": 21721, "verse_number": "१-१०७-२५", "content_sanskrit": "ततः सावित्र्युपाख्यानं राजधर्मास्तथैव च ।\nविविधोत्पातकथनं ग्रहणांतस्तथैव च ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001721025, "chapter_id": 21721, "verse_number": "१-१०७-२६", "content_sanskrit": "यात्रानिमित्तकथनं स्वप्नमंगलकीर्तने ।\nवामनस्य तु माहात्म्यं वाराहस्य ततः परम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001721026, "chapter_id": 21721, "verse_number": "१-१०७-२७", "content_sanskrit": "समुद्रमथनं तद्वत्कालकूटाभिशांतनम् ।\nदेवासुरविमर्दश्च वास्तुविद्या तथैव च ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001721027, "chapter_id": 21721, "verse_number": "१-१०७-२८", "content_sanskrit": "प्रतिमालक्षणं तद्वद्देवतायतनं तथा ।\nप्रासादलक्षणं तद्वन्मंडपान च लक्षणम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001721028, "chapter_id": 21721, "verse_number": "१-१०७-२९", "content_sanskrit": "भविष्यराज्ञामुद्देशो महादानानुकीर्तनम् ।\nकल्पानुकीर्तनं तद्वत्पुराणेऽस्मिन्प्रकीर्तितम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001721029, "chapter_id": 21721, "verse_number": "१-१०७-३०", "content_sanskrit": "पवित्रमेतत्कल्याणमायुः कीर्तिविवर्द्धनम् ।\nयः पठेच्छृणुयाद्वापि स याति भवनं हरेः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001721030, "chapter_id": 21721, "verse_number": "१-१०७-३१", "content_sanskrit": "लिखित्वैतत्तु यो दद्याद्धेममत्स्यगवान्वितम् ।\nविप्रायाभ्यर्च्य विषुवे स याति परमं पदम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]