[{"id": 2146779, "chapter_id": 4166, "verse_number": "", "content_sanskrit": "कण्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2146780, "chapter_id": 4166, "verse_number": "१", "content_sanskrit": "मातलिस्तु व्रजन् मार्गे नारदेन महर्षिणा ।\nवरुणं गच्छता द्रष्टुं समागच्छद् यदृच्छया\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2146781, "chapter_id": 4166, "verse_number": "२", "content_sanskrit": "नारदोऽथाब्रवीदेनं क्व भवान् गन्तुमुद्यतः ।\nस्वेन वा सूत कार्येण शासनाद्वा शतक्रतोः\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2146782, "chapter_id": 4166, "verse_number": "३", "content_sanskrit": "मातलिर्नारदेनैवं सम्पृष्टः पथि गच्छता ।\nयथावत् सर्वमाचष्ट स्वकार्यं नारदं प्रति\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2146783, "chapter_id": 4166, "verse_number": "४", "content_sanskrit": "तमुवाचाथ स मुनिर्गच्छावः सहिताविति\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2146784, "chapter_id": 4166, "verse_number": "५", "content_sanskrit": "सलिलेशदिदृक्षार्थमहमप्युद्यतो दिवः\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2146785, "chapter_id": 4166, "verse_number": "६", "content_sanskrit": "अहं ते सर्वमाख्यास्ये दर्शयन् वसुधातळे ।\nदृष्ट्वा तत्र वरं कञ्चिद् रोचयिष्याव मातले\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2146786, "chapter_id": 4166, "verse_number": "", "content_sanskrit": "कण्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2146787, "chapter_id": 4166, "verse_number": "७", "content_sanskrit": "अवगाह्य ततो भूमिमुभौ मातलिनारदौ ।\nददृशाते महात्मानौ लोकपालमपाम्पतिम्\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2146788, "chapter_id": 4166, "verse_number": "८", "content_sanskrit": "तत्र देवर्षिसदृशीं पूजां स प्राप नारदः ।\nमहेन्द्रसदृशीं चैव मातलिः प्रत्यपद्यत\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2146789, "chapter_id": 4166, "verse_number": "९", "content_sanskrit": "तावुभौ प्रीतमनसौ कार्यवन्तौ निवेद्य ह ।\nवरुणेनाभ्यनुज्ञातौ नागलोकं विचेरतुः\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2146790, "chapter_id": 4166, "verse_number": "१०", "content_sanskrit": "नारदः सर्वभूतानामन्तर्भूमिनिवासिनाम् ।\nजानंश्चकार व्याख्यानं यन्तुः सर्वमजानतः\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2146791, "chapter_id": 4166, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2146792, "chapter_id": 4166, "verse_number": "११", "content_sanskrit": "दृष्टस्ते वरुणः सूत पुत्रपौत्रसमावृतः ।\nपश्य तोयनिधेः स्थानं सर्वतोभद्रमृद्धिमत्\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2146793, "chapter_id": 4166, "verse_number": "१२", "content_sanskrit": "एष पुत्रो महाप्रज्ञो वरुणस्येह गोपतेः ।\nएष वै शीलवृत्तेन शौचेन च विशिष्यते\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2146794, "chapter_id": 4166, "verse_number": "१३", "content_sanskrit": "एषोऽस्य पुत्रोऽभिमतः पुष्करः पुष्करेक्षणः ।\nरूपवान् दर्शनीयश्च सोमपुत्र्या वृतः पतिः\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2146795, "chapter_id": 4166, "verse_number": "१४", "content_sanskrit": "ज्योत्स्नाकालीति यामाहुर्द्वितीयां रूपतः श्रियम् ।\nअदित्याश्चैव गोपुत्रो ज्येष्ठः पुत्रकृते कृतः\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2146796, "chapter_id": 4166, "verse_number": "१५", "content_sanskrit": "भवनं पश्य वारुण्यं यदेतत् सर्वकाञ्चनम् ।\nयां प्राप्य सुरतां प्राप्ताः सुराः सुरपतेः सखे\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2146797, "chapter_id": 4166, "verse_number": "१६", "content_sanskrit": "एतानि हृतराज्यानां दैतेयानां च मातले ।\nदीप्यमानानि दृश्यन्ते सर्वप्रहरणान्युत\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2146798, "chapter_id": 4166, "verse_number": "१७", "content_sanskrit": "अक्षयाणि किलैतानि प्रवर्तन्ते स्म मातले ।\nअनुभावप्रयुक्तानि सुरैरवजितानि ह\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2146799, "chapter_id": 4166, "verse_number": "१८", "content_sanskrit": "अत्र राक्षसजात्यश्च भूतयोन्यश्च मातले ।\nदिव्यप्रहरणाश्चासन् पूर्वदैवतनिर्मिताः\t ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2146800, "chapter_id": 4166, "verse_number": "१९", "content_sanskrit": "अग्निरेष महार्चिष्मान् जागर्ति वरुणह्रदे ।\nवैष्णवं चक्रमाविद्धं विधूमेन हविष्मता\t ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2146801, "chapter_id": 4166, "verse_number": "२०", "content_sanskrit": "एष गाण्डीवकश्चापो लोकसंहारसम्भवः ।\nरक्ष्यते दैवतैर्नित्यं यतस्तद् गाण्डिवं धनुः\t ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2146802, "chapter_id": 4166, "verse_number": "२१", "content_sanskrit": "एष कृत्ये समुत्पन्ने तत्तद् धारयते बलम् ।\nसहस्रशतसङ्ख्येन प्राणेन सततं ध्रुवः\t ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2146803, "chapter_id": 4166, "verse_number": "२२", "content_sanskrit": "अशिष्टानपि शास्त्येष रक्षोबन्धुषु राजसु ।\nसृष्टः प्रथमजो दण्डो ब्रह्मणा ब्रह्मवादिना\t ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2146804, "chapter_id": 4166, "verse_number": "२३", "content_sanskrit": "एतच्छस्त्रं नरेन्द्राणां महच्चक्रेण भूषितम् ।\nपुत्राः सलिलराजस्य धारयन्ति महोदयम्\t ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2146805, "chapter_id": 4166, "verse_number": "२४", "content_sanskrit": "एतत् सलिलराजस्य छत्रं छत्रगृहे स्थितम् ।\nसर्वतः सलिलं शीतं जीमूत इव वर्षति\t ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2146806, "chapter_id": 4166, "verse_number": "२५", "content_sanskrit": "एतच्छत्रात् परिभ्रष्टं सलिलं सोमनिर्मलम् ।\nतमसा मिश्रितं भाति येन नार्छति दर्शनम्\t ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2146807, "chapter_id": 4166, "verse_number": "२६", "content_sanskrit": "बहून्यद्भुतरूपाणि द्रष्टव्यानीह भूतळे ।\nतव कार्योपरोधः स्यात् तस्माद् गच्छाव माचिरम्\t ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2146808, "chapter_id": 4166, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि सप्तनवतितमोऽध्यायः ॥९७॥\nभगवद्यानपर्वणि अष्टाविंशोऽध्यायः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]