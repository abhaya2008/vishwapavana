  {
    "id": 20005888,
    "chapter_id": 6631,
    "verse_number": "1.34",
    "content_sanskrit": "निवेशयामासिथ हेलयोद्धृतं फणाभृतां छादनमेकमोकसः । जगतैकस्थपतिस्त्वमुच्चकैरहीश्वरस्तम्भशिरःसुभूतलम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
