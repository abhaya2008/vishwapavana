[
  {
    "id": 20005855,
    "chapter_id": 6631,
    "verse_number": "1.1",
    "content_sanskrit": "श्रियः पति श्रीमति शासितुं जगज्जगन्निवासो वसुदेवसद्मनि । वसन्ददर्शावतरन्तमम्बराद्धिरण्यगर्भाङ्गभुवं मुनिं हरिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "avatarnika": ""
  },
  {
    "id": 20005856,
    "chapter_id": 6631,
    "verse_number": "1.2",
    "content_sanskrit": "गतं तिरश्चीनमनूरुसारथेः प्रसिद्धमूर्ध्वज्वलनं हविर्भुजः । पतत्यधो धाम विसारि सर्वतः किमेतदित्याकुलमीक्षितं जनैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "avatarnika": ""
  },
  {
    "id": 20005857,
    "chapter_id": 6631,
    "verse_number": "1.3",
    "content_sanskrit": "चयस्त्विषामित्यवधारितं पुरा ततः शरीरीति विभाविताकृतिम् । विभुर्विभक्तावयवं पुमानिति क्रमादमुं नारद इत्यबोधि सः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "avatarnika": ""
  },
  {
    "id": 20005858,
    "chapter_id": 6631,
    "verse_number": "1.4",
    "content_sanskrit": "नवानधोऽधो बृहतः पयोधरान्समूढकर्पूरपरागपाण्डुरम् । क्षणं क्षणोत्क्षिप्तगजेन्द्रकृत्तिना स्फुटोपमं भूतिसितेन शम्भुना ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "avatarnika": ""
  },
  {
    "id": 20005859,
    "chapter_id": 6631,
    "verse_number": "1.5",
    "content_sanskrit": "दधानमम्भोरुहकेसरद्युतीर्जटाः शरच्चन्द्र मरीचिरोचिषम् । विपाकस्तुङ्गास्तुहिनस्थलीरुहो धरादरेन्द्रं व्रततीततीरिव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "avatarnika": ""
  },
  {
    "id": 20005860,
    "chapter_id": 6631,
    "verse_number": "1.6",
    "content_sanskrit": "पिशङ्गमौञ्जीयुजमर्जुनच्छविं वसानमेणाजिनमञ्नद्युति । सुवर्मसूत्राकलिताधराम्बरां विडम्बयन्तं शितिवाससस्तनुम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "avatarnika": ""
  },
  {
    "id": 20005861,
    "chapter_id": 6631,
    "verse_number": "1.7",
    "content_sanskrit": "विहङ्गराजाङ्गरुहैरिवायतैर्हिरण्मयोर्वीरुहवल्लितत्नुभिः । कृतोपवीतं हिमशुभ्रमुच्चकैर्घनं घनान्ते तटितां गणैरिव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "avatarnika": ""
  },
  {
    "id": 20005862,
    "chapter_id": 6631,
    "verse_number": "1.8",
    "content_sanskrit": "निसर्गचित्रोज्वलसूक्ष्मपक्ष्मणा लसद्बिसच्छेदसिताङ्गसङ्गिना । चकासतं चारुचमूरुचर्मणा कुथेन नागेन्द्रमिवेन्द्रवाहनम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "avatarnika": ""
  },
  {
    "id": 20005863,
    "chapter_id": 6631,
    "verse_number": "1.9",
    "content_sanskrit": "अजस्रमास्फालितवल्लकीगुणक्षतोज्वलाङ्गुष्ठनखांशुभिन्नया । पुरः प्रवालैरिव पूरितार्धया विभान्तमच्छस्फटिकाक्षमालया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "avatarnika": ""
  },
  {
    "id": 20005864,
    "chapter_id": 6631,
    "verse_number": "1.10",
    "content_sanskrit": "रणद्भिराघट्टनया नभस्वतः पृथग्विभिन्नश्रुतिमण्डलैः स्वरैः । स्फुटीभवद्ग्रामविशेषमूर्च्छनामवेक्षमाणं महतीं मुहुर्मुहुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "avatarnika": ""
  },
  {
    "id": 20005865,
    "chapter_id": 6631,
    "verse_number": "1.11",
    "content_sanskrit": "निवर्त्य सोऽनुव्रजतः कृतानतीनतीन्द्रयज्ञाननिधिर्नभः सदः । समासदत्सादितदैत्यसंपदः पदं महेन्द्रलायचारु चक्रिणः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "avatarnika": ""
  },
  {
    "id": 20005866,
    "chapter_id": 6631,
    "verse_number": "1.12",
    "content_sanskrit": "पतत्पतङ्गप्रतिमस्तपोनिधिः पुरोऽस्य यावन्न भुवि व्यलीयत । गिरेस्तडित्वानिव तावदुच्चकैर्जवेन पीठादुदतिष्ठदच्युतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "avatarnika": ""
  },
  {
    "id": 20005867,
    "chapter_id": 6631,
    "verse_number": "1.13",
    "content_sanskrit": "अथ प्रयत्नोन्नमितानत्फणैर्धृते कथञ्चित्फणिनां गणैरधः । न्यधायिषातामभि देवकीसुतं सुतेन धातुश्चरणौ भुवस्तले ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "avatarnika": ""
  },
  {
    "id": 20005868,
    "chapter_id": 6631,
    "verse_number": "1.14",
    "content_sanskrit": "तमर्घ्यमर्घ्यादिकयादिपुरुषः सपर्यया साधु स पर्यपूजयत् । गृहानुपैतुं प्रणयादभीप्सवो भवन्ति नापुण्यकृतां मनीषिणः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "avatarnika": ""
  },
  {
    "id": 20005869,
    "chapter_id": 6631,
    "verse_number": "1.15",
    "content_sanskrit": "न यावदेतावुदपश्यदुत्थितौ जनस्तुषाराञ्जनपर्वताविव । स्वहस्तदत्ते मुनिमासने मुनिश्चिरंस्तावदभिन्यवीविशत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "avatarnika": ""
  },
  {
    "id": 20005870,
    "chapter_id": 6631,
    "verse_number": "1.16",
    "content_sanskrit": "महामहानीलशिलारुचः पुरो निषेदिवान्कंसकृषः स विष्टरे । श्रितोदयाद्रेरभिसायमुच्चकैरचूचुरच्चन्द्रमसोऽभिरामताम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "avatarnika": ""
  },
  {
    "id": 20005871,
    "chapter_id": 6631,
    "verse_number": "1.17",
    "content_sanskrit": "विधाय तस्यापचितिं प्रसेदुषः प्रकाममप्रीयत यज्वनां प्रियः । ग्रहीतुमार्यान्परिचर्यया मुहुर्महानुभावा हि नितान्तमर्थिनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "avatarnika": ""
  },
  {
    "id": 20005872,
    "chapter_id": 6631,
    "verse_number": "1.18",
    "content_sanskrit": "अशेषतीर्थोपहृताः कमण्डलोर्निधाय पाणावृषीणाभ्युदीरिताः । अघौघविध्वंसविधौ पटीयसीर्नतेन मूर्द्ना हरिरग्रहीदापः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "avatarnika": ""
  },
  {
    "id": 20005873,
    "chapter_id": 6631,
    "verse_number": "1.19",
    "content_sanskrit": "स काञ्चने यत्र मुनेरनुज्ञया नवाम्बुदशयामवपुर्न्यविक्षत । जिगाय जम्बूजनितश्रियः श्रियं सुमेरुशृङ्गस्य तदा तदासनम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "avatarnika": ""
  },
  {
    "id": 20005874,
    "chapter_id": 6631,
    "verse_number": "1.20",
    "content_sanskrit": "स तप्ताकार्तस्वरभास्वराम्बरः कठोरधाराधिपलाञ्छनच्छविः । विदिद्युते बाडवजातवेदसः शिखाभिराश्लिष्ट इवाम्भसां निधिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "avatarnika": ""
  },
  {
    "id": 20005875,
    "chapter_id": 6631,
    "verse_number": "1.21",
    "content_sanskrit": "रथाङ्गपाणेः पटलेन रोचिषामृषित्विषः संवलिता विरेजिरे । चलत्पलाशान्तरगोचरस्तरोतुषारमूर्तेरिव नक्तमंशवः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "avatarnika": ""
  },
  {
    "id": 20005876,
    "chapter_id": 6631,
    "verse_number": "1.22",
    "content_sanskrit": "प्रफुल्लतापिच्छनिभैरभीषुभिः शुभैश्च सप्तच्छदपांसुपाण्डुभिः । परम्परेण च्छुरितामलच्छवी तदेकवर्णाविव तौ बभूवतुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "avatarnika": ""
  },
  {
    "id": 20005877,
    "chapter_id": 6631,
    "verse_number": "1.23",
    "content_sanskrit": "युगान्तकालमतिसंहृतात्मनो जगन्ति यस्यां सविकासमासत । तनौ ममुस्तत्र न कैटभद्विषस्तपोधनभ्यागमसंभवा मुदः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "avatarnika": ""
  },
  {
    "id": 20005878,
    "chapter_id": 6631,
    "verse_number": "1.24",
    "content_sanskrit": "निदाधधामानमिवाधिदीधितिं मुदाविकासं मुनिमभ्युपेयुषी । विलोचने बिभ्रदधिश्रितश्रिणी स पुण्डराकाक्ष इति स्फुटाभवत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "avatarnika": ""
  },
  {
    "id": 20005879,
    "chapter_id": 6631,
    "verse_number": "1.25",
    "content_sanskrit": "सितंसितिम्ना सुतरां मुनेर्वपुः विसारिभिः सौधमिवाथ लम्भयन् । द्विजावलिव्याजनिशाकरांशुभिः शुचिस्मितां वाचमवोचदच्युतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "avatarnika": ""
  },
  {
    "id": 20005880,
    "chapter_id": 6631,
    "verse_number": "1.26",
    "content_sanskrit": "हरत्यघं संप्रति हेतुरेष्यतः शुभस्य पूर्वाचरितै कृतर्ं शुभै । शरीरभाजां भवदीयदर्शनं व्यनक्ति कालत्रितयेऽपि योग्यताम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "avatarnika": ""
  },
  {
    "id": 20005881,
    "chapter_id": 6631,
    "verse_number": "1.27",
    "content_sanskrit": "जगत्पर्याप्तसहस्रभानुना न यन्नियन्तुं समभावि भानुना । प्रसह्य तेजोभिरसंख्यतां गतैरदस्त्वया नुन्नमनुत्तमं तमः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "avatarnika": ""
  },
  {
    "id": 20005882,
    "chapter_id": 6631,
    "verse_number": "1.28",
    "content_sanskrit": "कृतः प्रजाक्षेमकृता प्रजासृजा सुपात्रनिक्षेनिराकुलात्मना । सदोपयोगेऽपि गुरुस्त्वमक्षयो निधिः श्रुतीनां धनसंपदामिव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "avatarnika": ""
  },
  {
    "id": 20005883,
    "chapter_id": 6631,
    "verse_number": "1.29",
    "content_sanskrit": "विलोकनेनैव तवामुना मुने कृतः कृतार्थोस्मि निबर्हितांहसा । तथापिशुश्रूषुरहं गरीयसीर्गिरोऽथवा श्रेयसि केन वा तृप्यते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "avatarnika": ""
  },
  {
    "id": 20005884,
    "chapter_id": 6631,
    "verse_number": "1.30",
    "content_sanskrit": "गतस्पृहोऽप्यागमनप्रयोजनं वदेति वक्तुं व्यवसीयते यया । तनोति नस्तामुदित्मगौरवो गुरुस्तवैवागम एव धृष्यताम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "avatarnika": ""
  },
  {
    "id": 20005885,
    "chapter_id": 6631,
    "verse_number": "1.31",
    "content_sanskrit": "इतिब्रुवन्तंउवाच स व्रती न वाच्यमित्थं पुरुषोत्तम त्वया । त्वमेव साक्षात्करणीय इत्यतः किमस्ति कार्यं गुरु योगिनामपि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "avatarnika": ""
  },
  {
    "id": 20005886,
    "chapter_id": 6631,
    "verse_number": "1.32",
    "content_sanskrit": "उदीर्णरागप्रतिरोधकं जनैरभीक्ष्णमक्षुण्णतयातिदुर्गमम् । उपेयुषोमोक्षपथं मनस्विनस्त्वमग्रमूर्तिर्निरपायसंश्रया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "avatarnika": ""
  },
  {
    "id": 20005887,
    "chapter_id": 6631,
    "verse_number": "1.33",
    "content_sanskrit": "उदासितारं निग्रहीतमानसैर्गृहीतमध्यात्मदृशा कथञ्चन । बहिर्विकरं प्रकृतेः पृथग्विदुः पुरातनं त्वां पुरुषं पुराविदः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
