[{"id": 5000638000, "chapter_id": 9638, "verse_number": "७-१०३-१", "content_sanskrit": "कस्यचित्त्वथ कालस्य रामे धर्मपरे स्थिते ।\nकालस्तापसरूपेण राजद्वारमुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000638001, "chapter_id": 9638, "verse_number": "७-१०३-२", "content_sanskrit": "सो ऽब्रवील्लक्ष्मणं वाक्यं धृतिमन्तं यशश्विनम् ।\nमां निवेदय रामाय सम्प्राप्तं कार्यगौरवात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000638002, "chapter_id": 9638, "verse_number": "७-१०३-३", "content_sanskrit": "दूतो ऽस्म्यतिबलस्याहं महर्षेरमितौजसः ।\nरामं दिदृक्षुरायातः कार्येण हि महाबल ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000638003, "chapter_id": 9638, "verse_number": "७-१०३-४", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा सौमित्रिस्त्वरया ऽन्वितः ।\nन्यवेदयत रामाय तापसं तं समागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000638004, "chapter_id": 9638, "verse_number": "७-१०३-५", "content_sanskrit": "जयस्व राम धर्मेण उभौ लोकौ महाद्युते ।\nदूतस्त्वां द्रष्टुमायातस्तपसा भास्करप्रभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000638005, "chapter_id": 9638, "verse_number": "७-१०३-६", "content_sanskrit": "तद्वाक्यं लक्ष्मणेनोक्तं श्रुत्वा राम उवाच ह ।\nप्रवेश्यतां मुनिस्तात महौजास्तस्य वाक्यधृत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000638006, "chapter_id": 9638, "verse_number": "७-१०३-७", "content_sanskrit": "सौमित्रिस्तु तथेत्युक्त्वा प्रावेशयत तं मुनिम् ।\nज्वलन्तमेव तेजोभिः प्रदहन्तमिवांशुभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000638007, "chapter_id": 9638, "verse_number": "७-१०३-८", "content_sanskrit": "सो ऽभिगम्य रघुश्रेष्ठं दीप्यपानं स्वतेजसा ।\nऋषिर्मधुरया वाचा वर्धस्वेत्याह राघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000638008, "chapter_id": 9638, "verse_number": "७-१०३-९", "content_sanskrit": "तस्मै रामो महातेजाः पूजामर्घ्यपुरोगमाम् ।\nददौ कुशलमव्यग्रं प्रष्टुमेवोपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000638009, "chapter_id": 9638, "verse_number": "७-१०३-१०", "content_sanskrit": "पृष्टश्च कुशलं तेन रामेण वदतां वरः ।\nआसने काञ्चने दिव्ये निषसाद महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000638010, "chapter_id": 9638, "verse_number": "७-१०३-११", "content_sanskrit": "तमुवाच ततो रामः स्वागतं ते महामुने ।\nप्रापयास्य च वाक्यानि यतो दूतस्त्वमागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000638011, "chapter_id": 9638, "verse_number": "७-१०३-१२", "content_sanskrit": "चोदितो राजसिंहेन मुनिर्वाक्यमभाषत ।\nद्वन्द्वमेतत्प्रवक्तव्यं हितं वै यद्यपेक्षसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000638012, "chapter_id": 9638, "verse_number": "७-१०३-१३", "content_sanskrit": "यः शृणोति निरीक्षेद्वा स वध्यो भविता तव ।\nभवेद्वै मुनिमुख्यस्य वचनं यद्यपेक्षसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000638013, "chapter_id": 9638, "verse_number": "७-१०३-१४", "content_sanskrit": "स तथेति प्रतिज्ञाय रामो लक्ष्मणमब्रवीत् ।\nद्वारि तिष्ठ महाबाहो प्रतिहारं विसर्जय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000638014, "chapter_id": 9638, "verse_number": "७-१०३-१५", "content_sanskrit": "स मे वध्यः खलु भवेत् कथाद्वन्द्वं समीरितम् ।\nऋषेर्मम च सौमित्रे पश्येद्वा शृणुयाच्च यः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000638015, "chapter_id": 9638, "verse_number": "७-१०३-१६", "content_sanskrit": "ततो निक्षिप्य काकुत्स्थो लक्ष्मणं द्वारि सङ्ग्रहम् ।\nतमुवाच मुने वाक्यं कथयस्वेति राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000638016, "chapter_id": 9638, "verse_number": "७-१०३-१७", "content_sanskrit": "यत्ते मनीषितं वाक्यं येन वा ऽसि समाहितः ।\nकथयस्वाविशङ्कस्त्वं ममापि हृदि वर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000638017, "chapter_id": 9638, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे त्र्युत्तरशततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]