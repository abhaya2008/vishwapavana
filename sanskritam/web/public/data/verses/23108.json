[{"id": 7003108000, "chapter_id": 23108, "verse_number": "४-४४-१", "content_sanskrit": "श्रीकृष्ण उवाच ।\nवसिष्ठस्य वचः श्रुत्वा सगणोऽपि हिमालयः ।\nविस्मितो भार्यया सार्द्धं जहास पार्वती स्वयम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003108001, "chapter_id": 23108, "verse_number": "४-४४-२", "content_sanskrit": "अरुन्धती च तां मेनां बोधयामास कातराम् ।\nनिराहारां रुदन्तीं तां जहौ शोकं मुदा च सा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003108002, "chapter_id": 23108, "verse_number": "४-४४-३", "content_sanskrit": "अरुन्धतीं भोजयित्वा बुभुजे भोगमुत्तमम् ।\nसर्वं प्रहृष्टमनसा मङ्गलं च चकार ह ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003108003, "chapter_id": 23108, "verse_number": "४-४४-४", "content_sanskrit": "ततः संभृतसंभारो वसिष्ठस्याज्ञया प्रिये ।\nपत्रं प्रस्थापयामास नानास्थानं त्वरान्वितः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003108004, "chapter_id": 23108, "verse_number": "४-४४-५", "content_sanskrit": "ततः प्रस्थापयामास शिवं मङ्गलपत्रिकाम् ।\nनानाप्रकारद्रव्याणि बाह्यानि च चकार ह ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003108005, "chapter_id": 23108, "verse_number": "४-४४-६", "content_sanskrit": "तन्दुलानां च शैलान्वै पृथुकानां च सुन्दरि ।\nतैलानां च घृतानां च दध्नां वापीश्चकार ह ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003108006, "chapter_id": 23108, "verse_number": "४-४४-७", "content_sanskrit": "गुडानामासनानां च क्षीराणां च तथैव च ।\nअथो हैयंगवीनानां लवणानां परं मुने ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003108007, "chapter_id": 23108, "verse_number": "४-४४-८", "content_sanskrit": "लड्डुकानां शर्कराणां स्वस्तिकानां तथैव च ।\nयवचूर्णादिपिष्टानां घृतपक्वानि तानि च ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003108008, "chapter_id": 23108, "verse_number": "४-४४-९", "content_sanskrit": "नानाप्रकारवस्त्राणि वह्निशौचानि यानि च ।\nमहारत्नप्रवालानि सुवर्णरजतानि च ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003108009, "chapter_id": 23108, "verse_number": "४-४४-१०", "content_sanskrit": "द्रव्याण्येतानि शैलेन्द्र कृत्वा तु विधिपूर्वकम् ।\nमङ्गलं कर्तुमारेभे तत्रैव मङ्गले दिने ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003108010, "chapter_id": 23108, "verse_number": "४-४४-११", "content_sanskrit": "संस्कारं कारयामासुः पार्वतीं पर्वतस्त्रियः ।\nस्नापयित्वा वस्त्रयुग्मं धारयामासुराशु ताः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003108011, "chapter_id": 23108, "verse_number": "४-४४-१२", "content_sanskrit": "कारयित्वा सुवेषां च रत्नभूषणभूषिताम ।\nदर्पणं धारयामासुर्दूर्वाक्षतसमन्वितम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003108012, "chapter_id": 23108, "verse_number": "४-४४-१३", "content_sanskrit": "ददुश्चालक्तकं चारु पादांगुलिषु पादयोः ।\nगंडे पत्रावलीं रम्यां नेत्रे कज्जलमुज्ज्वलम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003108013, "chapter_id": 23108, "verse_number": "४-४४-१४", "content_sanskrit": "कबरीं कारयामासुर्मालतीमाल्यवेष्टिताम् ।\nपट्टसूत्रपिनद्धां तां वामवक्त्रां मनोहराम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003108014, "chapter_id": 23108, "verse_number": "४-४४-१५", "content_sanskrit": "एतस्मिन्नंतरे राधे समाजग्मुः सुरेश्वराः ।\nनीत्वा त्रिनेत्रं तत्रैव रत्नयानस्थमीश्वरम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003108015, "chapter_id": 23108, "verse_number": "४-४४-१६", "content_sanskrit": "शैलः संभृतसंभारान्संभाषयितुमीश्वरान् ।\nशैलान्प्रस्थापयामास ब्राह्मणानपि पूजितान् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003108016, "chapter_id": 23108, "verse_number": "४-४४-१७", "content_sanskrit": "प्राङ्गणं कारयामास रम्भास्तम्भैः समन्वितम् ।\nपट्टसूत्रसन्निबद्धरसालपल्लवान्वितैः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003108017, "chapter_id": 23108, "verse_number": "४-४४-१८", "content_sanskrit": "फलपल्लवसंयुक्तैः कलशैर्जलसंयुतैः ।\nचन्दनागुरुकस्तूरीसुचारुकुसुमान्वितैः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003108018, "chapter_id": 23108, "verse_number": "४-४४-१९", "content_sanskrit": "मालतीमाल्यसंयुक्तैः संयुक्तं सुमनोहरम् ।\nदेवेश्वरान्परो दृष्ट्वा प्रणनाम हिमालयः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003108019, "chapter_id": 23108, "verse_number": "४-४४-२०", "content_sanskrit": "रत्नसिंहासनं दातुं प्रेरयामास किङ्करान् ।\nनारायणो हि भगवानुवास पार्षदैः सह ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003108020, "chapter_id": 23108, "verse_number": "४-४४-२१", "content_sanskrit": "विनतानन्दनात्तूर्णमवरुह्य चतुर्भुजः ।\nचतुर्भुजैः पार्षदैश्च रत्नभूषणभूषितैः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003108021, "chapter_id": 23108, "verse_number": "४-४४-२२", "content_sanskrit": "रत्नमुष्टिनिबद्धैश्च सेवितः श्वेतचामरैः ।\nऋषिश्रेष्ठैः सुरश्रेष्ठैः स्तूयमानश्च संसदि ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003108022, "chapter_id": 23108, "verse_number": "४-४४-२३", "content_sanskrit": "ईषद्धास्यप्रसन्नास्यो भक्तानुग्रहकातरः ।\nउवास च तदभ्याशे ब्रह्मा देवगणैः सह ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003108023, "chapter_id": 23108, "verse_number": "४-४४-२४", "content_sanskrit": "ऋषयो मुनयश्चैव समूषुर्मङ्गले स्थले ।\nएतस्मिन्नन्तरे शम्भुरवरुह्य रथादहो ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003108024, "chapter_id": 23108, "verse_number": "४-४४-२५", "content_sanskrit": "रत्नासने समुत्तिष्ठन्ददर्श पर्वतालयम्।\nसमाजग्मुः शिवं द्रष्टुं शैलेन्द्रनगरस्त्रियः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003108025, "chapter_id": 23108, "verse_number": "४-४४-२६", "content_sanskrit": "वृद्धा बाला युवत्यश्च वस्त्राभरणभूषिताः।\nकाश्चित्कज्जलहस्ताश्च वस्त्रहस्ताश्च काश्चन ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003108026, "chapter_id": 23108, "verse_number": "४-४४-२७", "content_sanskrit": "काश्चित्सिन्दूरहस्ताश्च काश्चित्कंकतिहाकराः ।\nवेषार्धभूषिताः काश्चित्काश्चिन्नैवार्धभूषिताः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003108027, "chapter_id": 23108, "verse_number": "४-४४-२८", "content_sanskrit": "काश्चिन्निर्भूषिताः काश्चित्सर्वाभरणभूषिताः।\nसर्वा आगत्य संतस्थुः सस्मिता पर्वतालये ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003108028, "chapter_id": 23108, "verse_number": "४-४४-२९", "content_sanskrit": "ऋषिकन्या देवकन्या नागकन्या मनोहराः ।\nगन्धर्वशैलकन्याश्च राजकन्याः समागताः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003108029, "chapter_id": 23108, "verse_number": "४-४४-३०", "content_sanskrit": "सर्वा अप्सरसो दिव्या रम्भाद्या समुपस्थिताः ।\nमेना कन्यागणैः सार्द्धं ददर्श शंकरं वरम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003108030, "chapter_id": 23108, "verse_number": "४-४४-३१", "content_sanskrit": "चारुचम्पकवर्णाभमेकवक्त्रं त्रिलोचनम् ।\nईषद्धास्यप्रसन्नास्यं रत्नाभरणभूषितम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003108031, "chapter_id": 23108, "verse_number": "४-४४-३२", "content_sanskrit": "चन्दनागुरुकस्तूरीचारुकुङ्कुमभूषितम् ।\nमालतीमाल्यसंयुक्तं सद्रत्नमुकुटोज्ज्वलम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003108032, "chapter_id": 23108, "verse_number": "४-४४-३३", "content_sanskrit": "वह्निशौचेनातुलेन चातिसूक्ष्मेण चारुणा ।\nअमूल्यवस्त्रयुग्मेन विचित्रेणातिभूषितम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003108033, "chapter_id": 23108, "verse_number": "४-४४-३४", "content_sanskrit": "रत्नदर्पणहस्तं च कज्जलोज्ज्वललोचनम् ।\nसर्वया प्रभयाच्छन्नमतीव सुमनोहरम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003108034, "chapter_id": 23108, "verse_number": "४-४४-३५", "content_sanskrit": "अतीव तरुणं रम्यैर्भूषिताङ्गैश्च भूषितम् ।\nबिभ्रन्तं रूपमतुलं परं नारायणाज्ञया ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003108035, "chapter_id": 23108, "verse_number": "४-४४-३६", "content_sanskrit": "योगस्वरूपं योगेशं योगीन्द्राणां गुरोर्गुरुम् ।\nस्वेच्छामयं गुणातीतं ब्रह्म ज्योतिः सनातनम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003108036, "chapter_id": 23108, "verse_number": "४-४४-३७", "content_sanskrit": "गुणभेदाद्रूपभेदं धत्तेऽनन्तमरूपकम् ।\nतारणं तं भवस्थानां सृष्टिस्थित्यंतकारणम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003108037, "chapter_id": 23108, "verse_number": "४-४४-३८", "content_sanskrit": "सर्वाधारं सर्वबीजं सर्वेशं सर्वजीवनम् ।\nसाक्षिरूपं निरीहं च परमानन्दमक्षरम्  ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003108038, "chapter_id": 23108, "verse_number": "४-४४-३९", "content_sanskrit": "आद्यन्तमध्यरहितं सर्वाद्यं सर्वरूपकम् ।\nदृष्ट्वा जामातरं मेना जहौ शोकं मुदान्विता ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003108039, "chapter_id": 23108, "verse_number": "४-४४-४०", "content_sanskrit": "प्रशशंसुर्युवत्यश्च धन्या धन्या सतीति ताः ।\nदुर्गा भाग्यवतीत्येवमूचुः काश्चन कन्यकाः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003108040, "chapter_id": 23108, "verse_number": "४-४४-४१", "content_sanskrit": "कामेन काश्चित्कामिन्यो मौनीभूताश्च स्तम्भिताः ।\nन दृष्टो वर इत्येवमस्माभिर्ज्ञानगोचरे ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003108041, "chapter_id": 23108, "verse_number": "४-४४-४२", "content_sanskrit": "काश्चिन्निमेषरहिता मूर्च्छामापुश्च काश्चन ।\nनिनिन्दुः स्वपतिं काश्चित्स्वेच्छां चक्रुश्च काश्चन ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003108042, "chapter_id": 23108, "verse_number": "४-४४-४३", "content_sanskrit": "काश्चिद्भावेन रुरुदुः पुलकाञ्चितविग्रहाः ।\nजगुर्गन्धर्वपतयो ननृतुश्चाप्सरोगणाः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003108043, "chapter_id": 23108, "verse_number": "४-४४-४४", "content_sanskrit": "दृष्ट्वा शंकररूपं च प्रहृष्टाः सर्वदेवताः ।\nनानाप्रकारवाद्यानि चारूणि मधुराणि च ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003108044, "chapter_id": 23108, "verse_number": "४-४४-४५", "content_sanskrit": "वादका वादयामासुर्नानाशिल्पेन तत्र वै ।\nएतस्मिन्नन्तरे दुर्गा शैलान्तःपुरचारिका ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003108045, "chapter_id": 23108, "verse_number": "४-४४-४६", "content_sanskrit": "बहिश्चकार सद्रत्नासनस्थां रत्नवेदिकाम् ।\nकस्तूरीबिन्दुभिः सान्द्रसिन्दूरबिन्दुभूषिताम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003108046, "chapter_id": 23108, "verse_number": "४-४४-४७", "content_sanskrit": "चारुचन्दनचन्द्राभां नम्रभालस्थलोज्ज्वलाम् ।\nरत्नेन्द्रसारहारेण वक्षःस्थलविभूषिताम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003108047, "chapter_id": 23108, "verse_number": "४-४४-४८", "content_sanskrit": "त्रिनेत्रदत्तनेत्रां तामन्यवारितलोचनाम् ।\nअतीषद्धास्ययुक्तास्यां सकटाक्षां मनोहराम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003108048, "chapter_id": 23108, "verse_number": "४-४४-४९", "content_sanskrit": "रत्नकेयूरवलयरत्नकङ्कणमण्डिताम् ।\nरत्नपाशकसंसक्तां क्वणन्मञ्जीररंजिताम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003108049, "chapter_id": 23108, "verse_number": "४-४४-५०", "content_sanskrit": "अमूल्यातुल्यचित्राढ्यवस्त्रयुग्म सुशोभिताम्। ।\nसद्रत्नकुण्डलाभ्यां च  चारुगण्डस्थलोज्ज्वलाम् ॥५०।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003108050, "chapter_id": 23108, "verse_number": "४-४४-५१", "content_sanskrit": "सारप्रभामुष्टदन्तराजिविराजिताम् ॥४९। ।\nरत्नदर्पणहस्तां च क्रीडापद्मं विघूर्णतीम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003108051, "chapter_id": 23108, "verse_number": "४-४४-५२", "content_sanskrit": "चन्दनागुरुकस्तूरीकुङ्कुमेनाङ्गचर्चिताम्।\nमुदिता ददृशुः सर्वे जगदाद्यां जगत्प्रसूम् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003108052, "chapter_id": 23108, "verse_number": "४-४४-५३", "content_sanskrit": "त्रिनेत्रो नेत्रकोणेन तां ददर्श मुदाऽन्वितः ।\nसर्वां सत्याकृतिं दृष्ट्वा विजहौ विरहज्वरम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003108053, "chapter_id": 23108, "verse_number": "४-४४-५४", "content_sanskrit": "शिवः सर्वं विसस्मार दुर्गासन्यस्तमानसः ।\nपुलकांचितसर्वांगो हर्षाश्रुयुक्तलोचनः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003108054, "chapter_id": 23108, "verse_number": "४-४४-५५", "content_sanskrit": "एतस्मिन्नन्तरे शैलः प्रहृष्टः सपुरोहितः।\nतं वरं वरयामास वस्त्रचंदनभूषणैः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003108055, "chapter_id": 23108, "verse_number": "४-४४-५६", "content_sanskrit": "भक्त्या पाद्यादिभिर्माल्यैर्दिव्यगंधमनोहरैः ।\nततः शीघ्रं वेदमंत्रैः संप्रदानं चकार ताम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003108056, "chapter_id": 23108, "verse_number": "४-४४-५७", "content_sanskrit": "यौतुकानि ददौ तस्मै रत्नानि विविधानि च ।\nचारुरत्नविकारणि पात्राणि सुन्दराणि च ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003108057, "chapter_id": 23108, "verse_number": "४-४४-५८", "content_sanskrit": "गवां लक्षं गजेंद्राणां सहस्राणि च राधिके ।\nरत्नकंबलयुक्तानि सांकुशानि मुदान्वितः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003108058, "chapter_id": 23108, "verse_number": "४-४४-५९", "content_sanskrit": "त्रिंशल्लक्षं हयानां च सज्जितानामकातरः ।\nदासीनामनुरक्तानां लक्षं सद्रत्नभूषितम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003108059, "chapter_id": 23108, "verse_number": "४-४४-६०", "content_sanskrit": "शतं द्विजबटूनां च पार्वतीभ्रातृकल्पकम् ।\nरथानां च शतं रम्यं रत्नेन्द्रसारनिर्मितम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003108060, "chapter_id": 23108, "verse_number": "४-४४-६१", "content_sanskrit": "पार्वतीं वस्तुसहितां स्वस्तीत्युच्चार्य शंकरः ।\nजग्राहानंदमनसा यत्नाच्छैलसमर्पिताम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003108061, "chapter_id": 23108, "verse_number": "४-४४-६२", "content_sanskrit": "हिमालयः सुतां दत्त्वा परिहारं चकार तम् ।\nमाध्यंदिनोक्तस्तात्रेण तुष्टाव संपुटांजलिः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003108062, "chapter_id": 23108, "verse_number": "४-४४-६३", "content_sanskrit": "हिमालय उवाच ।\nप्रसीद दक्षयज्ञघ्न नरकार्णवतारक ।\nसर्वात्मरूप सर्वेश परमानंदविग्रह ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003108063, "chapter_id": 23108, "verse_number": "४-४४-६४", "content_sanskrit": "गुणार्णव गुणातीत गुणयुक्त गणेश्वर ।\nगुणबीज महाभाग प्रसीद गुणिनां वर ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003108064, "chapter_id": 23108, "verse_number": "४-४४-६५", "content_sanskrit": "योगाधार योगरूप योगज्ञ योगकारण ।\nयोगीश योगिनां बीज प्रसीद योगिनां गुरो ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003108065, "chapter_id": 23108, "verse_number": "४-४४-६६", "content_sanskrit": "प्रलयप्रलयाद्यैकभवप्रलयकारण ।\nप्रलयान्ते सृष्टिबीज प्रसीद परिपालक ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003108066, "chapter_id": 23108, "verse_number": "४-४४-६७", "content_sanskrit": "संहारकाले घोरे च सृष्टिसंहारकारण ।\nदुर्निवार्य दुराराध्य चाशुतोष प्रसीद मे ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003108067, "chapter_id": 23108, "verse_number": "४-४४-६८", "content_sanskrit": "कालस्वरूप कालेश काले च फलदायक ।\nकालबीजैककालघ्न प्रसीद कालपालक ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003108068, "chapter_id": 23108, "verse_number": "४-४४-६९", "content_sanskrit": "शिवस्वरूप शिवद शिवबीज शिवाश्रय ।\nशिवभूत शिवप्राण प्रसीद परमाश्रय ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003108069, "chapter_id": 23108, "verse_number": "४-४४-७०", "content_sanskrit": "इत्येवं स्तवनं कृत्वा विरराम हिमालयः ।\nप्रशशंसुः सुराः सर्वे मुनयश्च गिरीश्वरम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003108070, "chapter_id": 23108, "verse_number": "४-४४-७१", "content_sanskrit": "हिमालयकृतं स्तोत्रं संयतो यः पठेन्नरः ।\nप्रददाति शिवस्तस्मै वाञ्छितं राधिके ध्रुवम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}]