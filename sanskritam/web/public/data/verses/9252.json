[{"id": 40016710, "chapter_id": 9252, "verse_number": "1", "content_sanskrit": "तदुक्तमतिकायस्यबलिनोबाहुशालिनः । कुम्भकर्णस्यवचनंश्रुत्वोवाचमहोदरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40016711, "chapter_id": 9252, "verse_number": "2", "content_sanskrit": "कुम्भकर्णकुलेजातोधृष्टःप्राकृतदर्शनः । अवलिप्तो न शक्नोषिकृत्यंसर्वत्रवेदितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40016712, "chapter_id": 9252, "verse_number": "3", "content_sanskrit": "कुम्भकर्णकुलेजातोधृष्टःप्राकृतदर्शनः । अवलिप्तो न शक्नोषिकृत्यंसर्वत्रवेदितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40016713, "chapter_id": 9252, "verse_number": "4", "content_sanskrit": "स्थानंवृद्धिं च हानि च देशकालविभागवित् । आत्मनश्चपरेषां च बुध्यतेराक्षसर्षभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40016714, "chapter_id": 9252, "verse_number": "5", "content_sanskrit": "यत्तुशक्यंबलवताकर्तुंप्राकृतबुद्धिना । अनुपासितवृद्धेनकःकुर्यात्तादृशंनरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40016715, "chapter_id": 9252, "verse_number": "6", "content_sanskrit": "यांस्तुधर्मार्थकामांस्त्वंब्रवीषिपृथगाश्रयान् । अवबोद्धुंस्वभावेतान्नहिलक्षणमस्तितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40016716, "chapter_id": 9252, "verse_number": "7", "content_sanskrit": "कर्मचैवहिसर्वेषांकारणानांप्रयोजकम् । श्रेयःपापीयसांचात्रफलंभवतिकर्मणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40016717, "chapter_id": 9252, "verse_number": "8", "content_sanskrit": "निश्श्रेयसफलावेवधर्मार्थावितरावपि । अधर्मानर्थयोःप्राप्तिःफलं च प्रत्यवायिकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40016718, "chapter_id": 9252, "verse_number": "9", "content_sanskrit": "ऐहलौकिकपारक्यंकर्मपुम्भिर्निषेव्यते । कर्माण्यपितुकल्यानिलभतेकाममास्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40016719, "chapter_id": 9252, "verse_number": "10", "content_sanskrit": "तत्रक्लुप्तमिदंराज्ञाहृदिकार्यंमतं च नः । शत्रौहिसाहसंयत्स्यात्किमिवात्रापनीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40016720, "chapter_id": 9252, "verse_number": "11", "content_sanskrit": "एकस्यैवाभियानेतुहेतुर्यःकथितस्त्वया । तत्राप्यनुपपन्नंतेवक्ष्यामियदसाधु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40016721, "chapter_id": 9252, "verse_number": "12", "content_sanskrit": "येनपूर्वंजनस्थानेबहवोऽतिबलाहताः । राक्षसाराघवंतंत्वंकथमेकोजयिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40016722, "chapter_id": 9252, "verse_number": "13", "content_sanskrit": "येपुरानिर्जितास्तेनजनस्थानेमहौजसः । राक्षसांस्तान्पुरेसर्वान्भीतानद्यापिपश्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40016723, "chapter_id": 9252, "verse_number": "14", "content_sanskrit": "तंसिंहमिवसङ्क्रुद्धंरामंदशरथात्मजम् । सर्पंसुप्तमिवबुद्ध्यप्रबोधयितुमिच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40016724, "chapter_id": 9252, "verse_number": "15", "content_sanskrit": "ज्वलन्तंतेजसानित्यंक्रोधेन च दुरासदम् । कस्तंमृत्युमिवासह्यमासादयितुमर्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40016725, "chapter_id": 9252, "verse_number": "16", "content_sanskrit": "संशयस्थमिदंसर्वंशत्रोःप्रतिसमासने । एकस्यगमनंतत्र न हिमेरोचतेभृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40016726, "chapter_id": 9252, "verse_number": "17", "content_sanskrit": "हीनार्थस्तुसमृद्धार्थंकोरिपुंप्राकृतंयथा । निश्चित्यजीवितत्यागेवशमानेतुमिच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40016727, "chapter_id": 9252, "verse_number": "18", "content_sanskrit": "यस्यनास्तिमनुष्येषुसदृशोराक्षसोत्तम । कथमाशंससेयोद्धुंतुल्येनेन्द्रविवस्वतोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40016728, "chapter_id": 9252, "verse_number": "19", "content_sanskrit": "एवमुक्त्वातुसम्रब्दःकुम्भकर्णंमहोदरः । उवाचरक्षसांमध्येरावणंलोकरावणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40016729, "chapter_id": 9252, "verse_number": "20", "content_sanskrit": "लब्ध्वापुनस्त्वंवैदेहींकिमर्थंसम्प्रजल्पसि । यदीच्छसितदासीतावशगातेभविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40016730, "chapter_id": 9252, "verse_number": "21", "content_sanskrit": "दृष्टःकश्चदुपायोमेसीतोपस्थानकारकः । रुचितश्चेत्स्वयाबुध्याराक्षसेन्द्र तंशृणु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40016731, "chapter_id": 9252, "verse_number": "22", "content_sanskrit": "अहंद्विजिह्वस्सम्ह्रादीकुम्भकर्णोवितर्दनः । पञ्चरामवधायैतेनिर्यान्त्वित्यवघोषय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40016732, "chapter_id": 9252, "verse_number": "23", "content_sanskrit": "ततोगत्वावयंयुद्धंदास्यामस्तस्ययत्नतः । जेष्यामोयदितेशत्रून्नोपायैःकृत्यमस्तिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40016733, "chapter_id": 9252, "verse_number": "24", "content_sanskrit": "अथजीवतिनश्शत्रुर्वयं च कृतसम्युगाः । ततस्तदभिपत्स्यामोमनसायत्समीक्षितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40016734, "chapter_id": 9252, "verse_number": "25", "content_sanskrit": "वयंयुद्धादिहेष्यामोरुधिरेणसमुक्षिताः । विदार्यस्वतनुंबाणैरामनामाङ्कितैश्शितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40016735, "chapter_id": 9252, "verse_number": "26", "content_sanskrit": "भक्षितोराघवोऽस्माभिर्लक्ष्मणश्चेतिवादिनः । तवपादौग्रहीष्यामस्त्वंनःकामंप्रपूरय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40016736, "chapter_id": 9252, "verse_number": "27", "content_sanskrit": "ततोऽवघोषयपुरेगजस्कन्धेनपार्थिव । हतोरामस्सहभ्रात्राससैन्यइतिसर्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40016737, "chapter_id": 9252, "verse_number": "28", "content_sanskrit": "प्रीतोनामततोभूत्वाभृत्यानांत्वमरिन्दम । भोगांश्चपरिवारांश्चकामांश्चवसुदापय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40016738, "chapter_id": 9252, "verse_number": "29", "content_sanskrit": "ततोमाल्यानिवासांसिवीराणामनुलेपनम् । पेयं च बहुयोधेभ्यस्स्वयं च मुदितःपिब ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40016739, "chapter_id": 9252, "verse_number": "30", "content_sanskrit": "ततोऽस्मिन् बहुलीभूतेकौलीनेसर्वतोगते । भक्षितस्ससुहृद्रामोराक्षसैरितिविश्रुते ॥ प्रविश्याश्वास्यचापित्वंसीतांरहसिसान्त्वय । धनधान्यैश्चकामैश्चरत्नैश्चानांप्रलोभय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40016740, "chapter_id": 9252, "verse_number": "31", "content_sanskrit": "ततोऽस्मिन् बहुलीभूतेकौलीनेसर्वतोगते । भक्षितस्ससुहृद्रामोराक्षसैरितिविश्रुते ॥ प्रविश्याश्वास्यचापित्वंसीतांरहसिसान्त्वय । धनधान्यैश्चकामैश्चरत्नैश्चानांप्रलोभय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40016741, "chapter_id": 9252, "verse_number": "32", "content_sanskrit": "अनयोपधयाराजन् भयशोकानुबन्धया । अकामात्वद्वशंसीतानष्टनाथाभविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40016742, "chapter_id": 9252, "verse_number": "33", "content_sanskrit": "ञ्जनीयम्हिभर्तारंविनष्टमवगम्यसा । नैराश्यात् स्त्रीलघुत्वाच्चत्वद्वशंप्रतिपत्स्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40016743, "chapter_id": 9252, "verse_number": "34", "content_sanskrit": "सापुरासुखसम्वृद्धासुखार्हादुःखकर्शिता । त्वय्यधीनंसुखंज्ञात्वासर्वथोगमिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40016744, "chapter_id": 9252, "verse_number": "35", "content_sanskrit": "एतत्सुनीतंममदर्शनेनरामंहिदृष्टवैभवेदनर्धः । इहैवतेसेत्स्यतिमोत्सुकोभूर्महानयुद्धेनसुखस्यलाभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 40016745, "chapter_id": 9252, "verse_number": 