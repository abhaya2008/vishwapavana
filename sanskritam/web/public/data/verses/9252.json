[{"id": 5000252000, "chapter_id": 9252, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे षट्पञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000252001, "chapter_id": 9252, "verse_number": "३-५६-१", "content_sanskrit": "सा तथोक्ता तु वैदेही निर्भया शोककर्शिता।\nतृणमन्तरतः कृत्वा रावणं प्रत्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000252002, "chapter_id": 9252, "verse_number": "३-५६-२", "content_sanskrit": "राजा दशरथो नाम धर्मसेतुरिवाचलः।\nसत्यसंधः परिज्ञातो यस्य पुत्रः स राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000252003, "chapter_id": 9252, "verse_number": "३-५६-३", "content_sanskrit": "रामो नाम स धर्मात्मा त्रिषु लोकेषु विश्रुतः।\nदीर्घबाहुर्विशालाक्षो दैवतं स पतिर्मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000252004, "chapter_id": 9252, "verse_number": "३-५६-४", "content_sanskrit": "इक्ष्वाकूणां कुले जातः सिंहस्कन्धो महाद्युतिः।\nलक्ष्मणेन सह भ्रात्रा यस्ते प्राणान् वधिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000252005, "chapter_id": 9252, "verse_number": "३-५६-५", "content_sanskrit": "प्रत्यक्षं यद्यहं तस्य त्वया वै धर्षिता बलात्।\nशयिता त्वं हतः संख्ये जनस्थाने यथा खरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000252006, "chapter_id": 9252, "verse_number": "३-५६-६", "content_sanskrit": "य एते राक्षसाः प्रोक्ता घोररूपा महाबलाः।\nराघवे निर्विषाः सर्वे सुपर्णे पन्नगा यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000252007, "chapter_id": 9252, "verse_number": "३-५६-७", "content_sanskrit": "तस्य ज्याविप्रमुक्तास्ते शराः काञ्चनभूषणाः।\nशरीरं विधमिष्यन्ति गङ्गाकूलमिवोर्मयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000252008, "chapter_id": 9252, "verse_number": "३-५६-८", "content_sanskrit": "असुरैर्वा सुरैर्वा त्वं यद्यवध्योऽसि रावण।\nउत्पाद्य सुमहद् वैरं जीवंस्तस्य न मोक्ष्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000252009, "chapter_id": 9252, "verse_number": "३-५६-९", "content_sanskrit": "स ते जीवितशेषस्य राघवोऽन्तकरो बली।\nपशोर्यूपगतस्येव जीवितं तव दुर्लभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000252010, "chapter_id": 9252, "verse_number": "३-५६-१०", "content_sanskrit": "यदि पश्येत् स रामस्त्वां रोषदीप्तेन चक्षुषा।\nरक्षस्त्वमद्य निर्दग्धो यथा रुद्रेण मन्मथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000252011, "chapter_id": 9252, "verse_number": "३-५६-११", "content_sanskrit": "यश्चन्द्रं नभसो भूमौ पातयेन्नाशयेत वा।\nसागरं शोषयेद् वापि स सीतां मोचयेदिह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000252012, "chapter_id": 9252, "verse_number": "३-५६-१२", "content_sanskrit": "गतासुस्त्वं गतश्रीको गतसत्त्वो गतेन्द्रियः।\nलङ्का वैधव्यसंयुक्ता त्वत्कृतेन भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000252013, "chapter_id": 9252, "verse_number": "३-५६-१३", "content_sanskrit": "न ते पापमिदं कर्म सुखोदर्कं भविष्यति।\nयाहं नीता विनाभावं पतिपार्श्वात् त्वया बलात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000252014, "chapter_id": 9252, "verse_number": "३-५६-१४", "content_sanskrit": "स हि देवरसंयुक्तो मम भर्ता महाद्युतिः।\nनिर्भयो वीर्यमाश्रित्य शून्ये वसति दण्डके ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000252015, "chapter_id": 9252, "verse_number": "३-५६-१५", "content_sanskrit": "स ते वीर्यं बलं दर्पमुत्सेकं च तथाविधम्।\nअपनेष्यति गात्रेभ्यः शरवर्षेण संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000252016, "chapter_id": 9252, "verse_number": "३-५६-१६", "content_sanskrit": "यदा विनाशो भूतानां दृश्यते कालचोदितः।\nतदा कार्ये प्रमाद्यन्ति नराः कालवशं गताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000252017, "chapter_id": 9252, "verse_number": "३-५६-१७", "content_sanskrit": "मां प्रधृष्य स ते कालः प्राप्तोऽयं राक्षसाधम।\nआत्मनो राक्षसानां च वधायान्तःपुरस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000252018, "chapter_id": 9252, "verse_number": "३-५६-१८", "content_sanskrit": "न शक्या यज्ञमध्यस्था वेदिः स्रुग्भाण्डमण्डिता।\nद्विजातिमन्त्रसम्पूता चण्डालेनावमर्दितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000252019, "chapter_id": 9252, "verse_number": "३-५६-१९", "content_sanskrit": "तथाहं धर्मनित्यस्य धर्मपत्नी दृढव्रता।\nत्वया स्प्रष्टुं न शक्याहं राक्षसाधम पापिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000252020, "chapter_id": 9252, "verse_number": "३-५६-२०", "content_sanskrit": "क्रीडन्ती राजहंसेन पद्मषण्डेषु नित्यशः।\nहंसी सा तृणमध्यस्थं कथं द्रक्ष्येत मद्गुकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000252021, "chapter_id": 9252, "verse_number": "३-५६-२१", "content_sanskrit": "इदं शरीरं निःसंज्ञं बन्ध वा घातयस्व वा।\nनेदं शरीरं रक्ष्यं मे जीवितं वापि राक्षस ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000252022, "chapter_id": 9252, "verse_number": "३-५६-२२", "content_sanskrit": "न तु शक्यमपक्रोशं पृथिव्यां दातुमात्मनः।\nएवमुक्त्वा तु वैदेही क्रोधात् सुपरुषं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000252023, "chapter_id": 9252, "verse_number": "३-५६-२३", "content_sanskrit": "रावणं जानकी तत्र पुनर्नोवाच किंचन।\nसीताया वचनं श्रुत्वा परुषं रोमहर्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000252024, "chapter_id": 9252, "verse_number": "३-५६-२४", "content_sanskrit": "प्रत्युवाच ततः सीतां भयसंदर्शनं वचः।\nशृणु मैथिलि मद्वाक्यं मासान् द्वादश भामिनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000252025, "chapter_id": 9252, "verse_number": "३-५६-२५", "content_sanskrit": "कालेनानेन नाभ्येषि यदि मां चारुहासिनि।\nततस्त्वां प्रातराशार्थं सूदाश्छेत्स्यन्ति लेशशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000252026, "chapter_id": 9252, "verse_number": "३-५६-२६", "content_sanskrit": "इत्युक्त्वा परुषं वाक्यं रावणः शत्रुरावणः।\nराक्षसीश्च ततः क्रुद्ध इदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000252027, "chapter_id": 9252, "verse_number": "३-५६-२७", "content_sanskrit": "शीघ्रमेव हि राक्षस्यो विरूपा घोरदर्शनाः।\nदर्पमस्यापनेष्यन्तु मांसशोणितभोजनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000252028, "chapter_id": 9252, "verse_number": "३-५६-२८", "content_sanskrit": "वचनादेव तास्तस्य सुघोरा घोरदर्शनाः।\nकृतप्राञ्जलयो भूत्वा मैथिलीं पर्यवारयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000252029, "chapter_id": 9252, "verse_number": "३-५६-२९", "content_sanskrit": "स ताः प्रोवाच राजासौ रावणो घोरदर्शनाः।\nप्रचल्य चरणोत्कर्षैर्दारयन्निव मेदिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000252030, "chapter_id": 9252, "verse_number": "३-५६-३०", "content_sanskrit": "अशोकवनिकामध्ये मैथिली नीयतामिति।\nतत्रेयं रक्ष्यतां गूढं युष्माभिः परिवारिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000252031, "chapter_id": 9252, "verse_number": "३-५६-३१", "content_sanskrit": "तत्रैनां तर्जनैर्घोरैः पुनः सान्त्वैश्च मैथिलीम्।\nआनयध्वं वशं सर्वा वन्यां गजवधूमिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000252032, "chapter_id": 9252, "verse_number": "३-५६-३२", "content_sanskrit": "इति प्रतिसमादिष्टा राक्षस्यो रावणेन ताः।\nअशोकवनिकां जग्मुर्मैथिलीं परिगृह्य तु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000252033, "chapter_id": 9252, "verse_number": "३-५६-३३", "content_sanskrit": "सर्वकामफलैर्वृक्षैर्नानापुष्पफलैर्वृताम्।\nसर्वकालमदैश्चापि द्विजैः समुपसेविताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000252034, "chapter_id": 9252, "verse_number": "३-५६-३४", "content_sanskrit": "सा तु शोकपरीताङ्गी मैथिली जनकात्मजा।\nराक्षसीवशमापन्ना व्याघ्रीणां हरिणी यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000252035, "chapter_id": 9252, "verse_number": "३-५६-३५", "content_sanskrit": "शोकेन महता ग्रस्ता मैथिली जनकात्मजा।\nन शर्म लभते भीरुः पाशबद्धा मृगी यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000252036, "chapter_id": 9252, "verse_number": "३-५६-३६", "content_sanskrit": "न विन्दते तत्र तु शर्म मैथिली\nविरूपनेत्राभिरतीव तर्जिता।\nपतिं स्मरन्ती दयितं च देवरं\nविचेतनाभूद् भयशोकपीडिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000252037, "chapter_id": 9252, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे षट्पञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]