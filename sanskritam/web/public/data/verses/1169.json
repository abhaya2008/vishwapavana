[{"id": 2008737, "chapter_id": 1169, "verse_number": "१-१७०-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2008738, "chapter_id": 1169, "verse_number": "१-१७०-१", "content_sanskrit": "ततस्ते पाण्डवाः सर्वे शालिहोत्राश्रमे तदा।\nपूजितास्तेन वन्येन तमामन्त्र्य महामुनिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2008739, "chapter_id": 1169, "verse_number": "१-१७०-२", "content_sanskrit": "जटाः कृत्वाऽऽत्मनः सर्वे वल्कलाजिनवाससः।\nकुन्त्या सह महात्मानो बिभ्रतस्तापसं वपुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2008740, "chapter_id": 1169, "verse_number": "१-१७०-३", "content_sanskrit": "ब्राह्मं वेदमधीयाना वेदाङ्गानि च सर्वशः।\nनीतिशास्त्रं च धर्मज्ञा न्यायज्ञानं च पाण्डवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2008741, "chapter_id": 1169, "verse_number": "१-१७०-४", "content_sanskrit": "शालिहोत्रप्रसादेन लब्ध्वा प्रीतिमवाप्य च।\nते वनेन वनं गत्वा घ्नन्तो मृगगणान्बहून्।\nअपक्रम्य ययू राजंस्त्वरमाणा महारथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2008742, "chapter_id": 1169, "verse_number": "१-१७०-५", "content_sanskrit": "मत्स्यांस्त्रिगर्तान्पाञ्चालान्कीचकानन्तरेण च।\nरमणीयान्वनोद्देशान्प्रेक्षमाणाः सरांसि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2008743, "chapter_id": 1169, "verse_number": "१-१७०-६", "content_sanskrit": "क्वचिद्वहन्तो जननीं त्वरमाणा महारथाः।\nक्वचिच्छ्रान्ताश्च कान्तारे क्वचित्तिष्ठन्ति हर्षिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2008744, "chapter_id": 1169, "verse_number": "१-१७०-७", "content_sanskrit": "क्वचिच्छन्देन गच्छन्तस्ते जग्मुः प्रसभं पुनः।\nपथि द्वैपायन सर्वे ददृशुः स्वपितामहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2008745, "chapter_id": 1169, "verse_number": "१-१७०-८", "content_sanskrit": "तेऽभिवाद्य महात्मानं कृष्णद्वैपायनं तदा।\nतस्थुः प्राञ्जलयः सर्वे सह मात्रा परन्तपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2008746, "chapter_id": 1169, "verse_number": "१-१७०-९x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2008747, "chapter_id": 1169, "verse_number": "१-१७०-९", "content_sanskrit": "तदाश्रमान्निर्गमनं मया ज्ञातं नरर्षभाः।\nघटोत्कचस्य चोत्पत्तिं ज्ञात्वा प्रीतिरवर्धत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2008748, "chapter_id": 1169, "verse_number": "१-१७०-१०", "content_sanskrit": "इदं नगरमभ्याशे रमणीयं निरामयम्।\nवसतेह प्रतिच्छन्ना ममागमनकाङ्क्षिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2008749, "chapter_id": 1169, "verse_number": "१-१७०-११x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2008750, "chapter_id": 1169, "verse_number": "१-१७०-११", "content_sanskrit": "एवं स तान्समाश्वास्य व्यासः पार्तानरिन्दमान्।\nएकचक्रामभिगतां कुन्तीमाश्वासयत्प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2008751, "chapter_id": 1169, "verse_number": "१-१७०-१२x", "content_sanskrit": "श्रीव्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2008752, "chapter_id": 1169, "verse_number": "१-१७०-१२", "content_sanskrit": "कुर्यान्न केवलं धर्मं दुष्कृतं च तथान नरः।\nसुकृतं दुष्कृतं लोके न कर्ता नास्ति कश्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2008753, "chapter_id": 1169, "verse_number": "१-१७०-१३", "content_sanskrit": "अवश्यं लभते कर्ता फलं वै पुण्यपापयोः।\nदुष्कृतस्य फलेनैव प्राप्तं व्यसनमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2008754, "chapter_id": 1169, "verse_number": "१-१७०-१४", "content_sanskrit": "तस्मान्माधवि मानार्हे मा च शोके मनः कृथाः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2008755, "chapter_id": 1169, "verse_number": "१-१७०-१४x", "content_sanskrit": "वैशम्पायन उवाच।\nएवमुक्त्वा निवेश्यैनान्ब्राह्मणस्य निवेशने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2008756, "chapter_id": 1169, "verse_number": "१-१७०-१५", "content_sanskrit": "जगाम भगवान्व्यासो यताकाममृषिः प्रभुः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2008757, "chapter_id": 1169, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि हिडिम्बवधपर्वणि सप्तत्यधिकशततमोऽध्यायः॥ १७० ॥ ॥ समाप्तं हिडिम्बवधपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]