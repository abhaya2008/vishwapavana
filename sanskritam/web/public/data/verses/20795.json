[{"id": 7000795000, "chapter_id": 20795, "verse_number": "६-१३८-१", "content_sanskrit": "महादेव उवाच ।\nगणतीर्थं ततो गच्छेत्तीर्थयात्रापरायणः ।\nत्रिविष्टपमिति प्रोक्तं गणैस्तु चंदना तटे॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000795001, "chapter_id": 20795, "verse_number": "६-१३८-२", "content_sanskrit": "त्रिविष्टपे नरः स्नात्वा पूर्णमास्यां समाहितः ।\nसंशयो नात्र कर्त्तव्यो मुच्यते ब्रह्महत्यया॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000795002, "chapter_id": 20795, "verse_number": "६-१३८-३", "content_sanskrit": "चतुरो वार्षिकान्मासान्स्थितिर्यस्य त्रिविष्टपे ।\nसोऽपि पुण्यो महाभागे रुद्रलोके महीयते॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000795003, "chapter_id": 20795, "verse_number": "६-१३८-४", "content_sanskrit": "गणतीर्थे नरः स्नात्वा कृष्णाष्टम्यामुपोषितः ।\nबकुलासंगमे स्नात्वा स्वर्गं गच्छति मानवः॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000795004, "chapter_id": 20795, "verse_number": "६-१३८-५", "content_sanskrit": "तस्मिंस्तीर्थे नरः स्नात्वा बकुलेशं विलोक्य च ।\nगणेश्वरप्रसादेन गाणपत्यमवाप्नुयात्॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000795005, "chapter_id": 20795, "verse_number": "६-१३८-६", "content_sanskrit": "इदं पवित्रं परमं पुण्यायुष्यविवर्द्धनम् ।\nश्रुत्वा तु लभते पुण्यं गंगास्नानसमं नरः॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000795006, "chapter_id": 20795, "verse_number": "६-१३८-७", "content_sanskrit": "अत्र स्थित्वा निराहारो जितेंद्रिय समाहितः ।\nजपत्येवं परं देवं गणेश्वरं मनोरमम्॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000795007, "chapter_id": 20795, "verse_number": "६-१३८-८", "content_sanskrit": "संप्राप्नोत्यखिलान्भोगान्सत्यं सत्यं वरानने ।\nअत्र राजा सोमवंशी विश्वदत्तः स वीर्यवान्॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000795008, "chapter_id": 20795, "verse_number": "६-१३८-९", "content_sanskrit": "तेन तपो महत्तप्तं बहुकालं सुरेश्वरि ।\nगाणपत्यं तदा प्राप्तं श्रीगणेशप्रसादतः॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000795009, "chapter_id": 20795, "verse_number": "६-१३८-१०", "content_sanskrit": "वसिष्ठो वामदेवश्च होडः कौशीतको मुनिः ।\nभरद्वाजोंगिराश्चैव विश्वामित्रोऽथ वामनः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000795010, "chapter_id": 20795, "verse_number": "६-१३८-११", "content_sanskrit": "एते वै मुनयः सर्वे पुण्यरूपा महेश्वरि ।\nनित्यं सेवां प्रकुर्वंति श्रीगणेशप्रसादतः॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000795011, "chapter_id": 20795, "verse_number": "६-१३८-१२", "content_sanskrit": "अपुत्रो लभते पुत्रान्निर्द्धनो लभते धनम् ।\nअविद्यो लभते विद्यां मोक्षार्थी मोक्षमाप्नुयात्॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000795012, "chapter_id": 20795, "verse_number": "६-१३८-१३", "content_sanskrit": "किमन्यद्बहुनोक्तेन भूयोभूयो वरानने ।\nयोऽत्र स्नानं प्रकुर्वीत पूजनं वा करोति च॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000795013, "chapter_id": 20795, "verse_number": "६-१३८-१४", "content_sanskrit": "सर्वपापविनिर्मुक्तो याति विष्णोः परं पदम् ।\nशिवाय विष्णुरूपाय विष्णवे शिवरूपिणे॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000795014, "chapter_id": 20795, "verse_number": "६-१३८-१५", "content_sanskrit": "नांतरं देवि पश्यामि श्रीविष्णोश्च प्रसादतः॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]