[{"id": 2090947, "chapter_id": 2933, "verse_number": "१३-६३-१", "content_sanskrit": "युधिष्ठिर उवाच।\nइदं मे तत्त्वतो राजन्वक्तुमर्हसि भारत।\nअहिंसयित्वाऽपि कथं ब्रह्महत्या विधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2090948, "chapter_id": 2933, "verse_number": "१३-६३-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2090949, "chapter_id": 2933, "verse_number": "१३-६३-२", "content_sanskrit": "व्यासमामन्त्र्य राजेन्द्र पुरा यत्पृष्टवानहम्।\nतत्तेऽहं सम्प्रवक्ष्यामि तदिहैकमनाः शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2090950, "chapter_id": 2933, "verse_number": "१३-६३-३", "content_sanskrit": "चतुर्थस्त्वं वसिष्ठस्य तत्त्वमाख्याहि मे मुने।\nअहिंसयित्वा केनेह ब्रह्महत्या विधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2090951, "chapter_id": 2933, "verse_number": "१३-६३-४", "content_sanskrit": "इति पृष्टो मया राजन्पराशरशरीरजः।\nअब्रवीन्निपुणो धर्मे निःसंशयमनुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2090952, "chapter_id": 2933, "verse_number": "१३-६३-५", "content_sanskrit": "ब्राह्मणं स्वयमाहूय भिक्षार्थे कृशवृत्तिनम्।\nब्रूयान्नास्तीति यः पश्चात्तं विद्याद्ब्रह्मघातिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2090953, "chapter_id": 2933, "verse_number": "१३-६३-६", "content_sanskrit": "मध्यस्थस्येह विप्रस्य योऽनूचानस्य भारत।\nवृत्तिं हरति दुर्बुद्धिस्तं विद्याद्ब्रह्मघातिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2090954, "chapter_id": 2933, "verse_number": "१३-६३-७", "content_sanskrit": "गोकुलस्य तृषार्तस्य जलार्थमभिधावतः।\nउत्पादयति यो विघ्नं तं विद्या** ह्मघातिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2090955, "chapter_id": 2933, "verse_number": "१३-६३-८", "content_sanskrit": "यः प्रवृत्तां श्रुतिं सम्यकू शास्त्र वा मुनिभिः कृतम्।\nदूषयत्यनभिज्ञाय तं विद्याद्ब्रह्मघातिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2090956, "chapter_id": 2933, "verse_number": "१३-६३-९", "content_sanskrit": "आत्मजां रूपसम्पन्नां महतीं सदृशे वरे।\nन प्रयच्छति यः कन्यां तं विद्याद्ब्रह्मधातिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2090957, "chapter_id": 2933, "verse_number": "१३-६३-१०", "content_sanskrit": "अधर्मनिरतो मूढो मिथ्या यो वै द्विजातिषु।\nदद्यान्मर्मातिगं शोकं तं विद्याद्ब्रह्मघातिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2090958, "chapter_id": 2933, "verse_number": "१३-६३-११", "content_sanskrit": "चक्षुषा विप्रहीणस्य पङ्गुलस्य जडस्य वा।\nहरेत यो वै सर्वस्वं तं विद्या *** घातिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2090959, "chapter_id": 2933, "verse_number": "१३-६३-१२", "content_sanskrit": "आश्रमे वा वने वाऽपि ग्रामे वा यदि वा पुरे।\nअग्निं समुत्सृजेन्मोहात्तं विद्याद्ब्रह्मघातिनम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2090960, "chapter_id": 2933, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि त्रिषष्टितमोऽध्यायः॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]