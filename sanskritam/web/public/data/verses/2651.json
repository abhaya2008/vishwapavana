[{"id": 2077886, "chapter_id": 2651, "verse_number": "१२-१५६-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2077887, "chapter_id": 2651, "verse_number": "१२-१५६-१", "content_sanskrit": "पापस्य यदधिष्ठानं यतः पापं प्रवर्तते।\nएतदिच्छाम्यहं श्रोतुं तत्त्वेन भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2077888, "chapter_id": 2651, "verse_number": "१२-१५६-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2077889, "chapter_id": 2651, "verse_number": "१२-१५६-२", "content_sanskrit": "पापस्य यदधिष्ठानं तच्छृणुष्व नराधिप।\nएको लोभो महाग्राहो लोभात्पापं प्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2077890, "chapter_id": 2651, "verse_number": "१२-१५६-३", "content_sanskrit": "अतः पापमधर्मश्च तथा दुःखमनुत्तमम्।\nनिकृत्या मूलमेतद्धि येन पापकृतो जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2077891, "chapter_id": 2651, "verse_number": "१२-१५६-४", "content_sanskrit": "लोभात्क्रोधः प्रभवति लोभात्कामः प्रवर्तते।\nलोभान्मोहश्च माया च मानस्तम्भः परासुता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2077892, "chapter_id": 2651, "verse_number": "१२-१५६-५", "content_sanskrit": "अक्षमा ह्रीपरित्यागः श्रीनाशो धर्मसंक्षयः।\nअभिध्याऽप्रख्यता चैव सर्वं लोभात्प्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2077893, "chapter_id": 2651, "verse_number": "१२-१५६-६", "content_sanskrit": "अत्यागश्च कुतर्कश्च विकर्मसु च याः क्रियः।\nकुलविद्यामदश्चैव रूपैश्वर्यमदस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2077894, "chapter_id": 2651, "verse_number": "१२-१५६-७", "content_sanskrit": "सर्वभूतेष्वभिद्रोहः सर्वभूतेष्वसत्कृतिः।\nसर्वभूतेष्वविश्वासः सर्वभूतेष्वनार्जवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2077895, "chapter_id": 2651, "verse_number": "१२-१५६-८", "content_sanskrit": "हरणं परवित्तानां परदाराभिमर्शनम्।\nवाग्वेगो मनसो वेगो निन्दावेगस्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2077896, "chapter_id": 2651, "verse_number": "१२-१५६-९", "content_sanskrit": "उपस्थोदरयोर्वेगो मृत्युवेगश्च दारुणः।\nईर्ष्यावेगश्च बलवान्मिथ्यावेगश्च दुर्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2077897, "chapter_id": 2651, "verse_number": "१२-१५६-१०", "content_sanskrit": "रसवेगश्च दुर्वार्यः श्रोत्रवेगश्च दुःसह।\nकुत्सा विकत्था मात्सर्यं पापं दुष्कर्मकारिता।\nसाहसानां च सर्वेषामकार्याणां क्रियास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2077898, "chapter_id": 2651, "verse_number": "१२-१५६-११", "content_sanskrit": "आतौ बाल्ये च कौमारे यौवने चापि मानवाः।\nन त्यजन्त्यात्मकर्मैकं यन्न जीर्यति जीर्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2077899, "chapter_id": 2651, "verse_number": "१२-१५६-१२", "content_sanskrit": "यो न पूरयितुं शक्यो लोभः प्रीत्या कथंचन।\nनित्यं गम्भीरतोयाभिरापगाभिरिवोदधिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2077900, "chapter_id": 2651, "verse_number": "१२-१५६-१३", "content_sanskrit": "न प्रहृष्यति यो लोभैः कामैर्यश्च न तृप्यति।\nयो न देवैर्न गन्धर्वैर्नासुरैर्न महोरगैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2077901, "chapter_id": 2651, "verse_number": "१२-१५६-१४", "content_sanskrit": "ज्ञायते नृप तत्त्वेन सर्वैर्भूतगणैस्तथा।\nस लोभः सह मोहेन विजेतव्यो जितात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2077902, "chapter_id": 2651, "verse_number": "१२-१५६-१५", "content_sanskrit": "दम्भो द्रोहश्च निन्दा च पैशून्यं मत्सरस्तथा।\nभवन्त्येतानि कौरव्य लुब्धानामकृतात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2077903, "chapter_id": 2651, "verse_number": "१२-१५६-१६", "content_sanskrit": "सुमहान्त्यपि शास्त्राणि धारयन्तो बहुश्रुताः।\nछेत्तारः संशयानां च क्लिश्यन्तीहाल्पबुद्धयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2077904, "chapter_id": 2651, "verse_number": "१२-१५६-१७", "content_sanskrit": "द्वेपक्रोधप्रसक्ताश्च शिष्टाचारबहिष्कृताः।\nअन्तःक्षुरा वाङ्भधुराः कृपाश्छन्नास्तृणैरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2077905, "chapter_id": 2651, "verse_number": "१२-१५६-१८", "content_sanskrit": "धर्मवैतंसिकाः क्षुद्रा मुष्णन्ति ध्वजिनो जगत्।\nकुर्वते च बहून्मार्गांस्तान्हेतुबलमाश्रिताः।\nसर्वमार्गान्विलुम्पन्ति लोभज्ञानेष्ववस्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2077906, "chapter_id": 2651, "verse_number": "१२-१५६-१९", "content_sanskrit": "धर्मस्य ह्रियमाणस्य लोभग्रस्तैर्दुरात्मभिः।\nयाया विक्रियते संस्था ततः साऽपि प्रपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2077907, "chapter_id": 2651, "verse_number": "१२-१५६-२०", "content_sanskrit": "दर्पः बोधो मदः स्वप्नो हर्षः शोकोऽभिमानिता।\nएत हि कौरव्य दृश्यन्ते लुब्धबुद्धिषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2077908, "chapter_id": 2651, "verse_number": "१२-१५६-२१", "content_sanskrit": "एताना टान्बुद्धस्व नित्यं लोभसमन्वितान्।\nशिष्टांस्तु परिपृच्छेथा यान्वक्ष्यामि शुचिव्रतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2077909, "chapter_id": 2651, "verse_number": "१२-१५६-२२", "content_sanskrit": "येष्वावृत्तिभयं नास्ति परलोकभयं न च।\nनामिपेषु प्रसङ्गोऽस्ति न प्रियेष्वप्रियेषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2077910, "chapter_id": 2651, "verse_number": "१२-१५६-२३", "content_sanskrit": "शिष्टाचारः प्रियो येषु दमो येषु प्रतिष्ठितः।\nसुखं दुःखं समं येषां सत्यं येषां परायणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2077911, "chapter_id": 2651, "verse_number": "१२-१५६-२४", "content_sanskrit": "दातारो न ग्रहीतारो दयावन्तस्नथैव च।\nपितृदेवातिथेयाश्च नित्योद्युक्तास्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2077912, "chapter_id": 2651, "verse_number": "१२-१५६-२५", "content_sanskrit": "सर्वोपकारिणो वीराः सर्वधर्मानुपालकाः।\nसर्वभूतहिताश्चैव सर्वदेयाश्च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2077913, "chapter_id": 2651, "verse_number": "१२-१५६-२६", "content_sanskrit": "न ते चालयितुं शक्या धर्मव्याहारकारिणः।\nन तेषां भिद्यते वृत्तं यत्पुरा साधुभिः कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2077914, "chapter_id": 2651, "verse_number": "१२-१५६-२७", "content_sanskrit": "न त्रासिनो न चपला न रौद्राः सत्पथे स्थिताः।\nते सेव्याः साधुभिर्नित्यमसाधूंश्च विवर्जयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2077915, "chapter_id": 2651, "verse_number": "१२-१५६-२८", "content_sanskrit": "कामक्रोधव्यपेता ये निर्ममा निरहंकृताः।\nसुव्रताः स्थिरमर्यादास्तानुपास्व च पृच्छ च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2077916, "chapter_id": 2651, "verse_number": "१२-१५६-२९", "content_sanskrit": "न वागर्थं यशोर्थं वा धर्मस्तेपां युधिष्ठिर॥\nअवश्यं कार्य इत्येव शरीरस्य क्रियास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2077917, "chapter_id": 2651, "verse_number": "१२-१५६-३०", "content_sanskrit": "त भयं क्रोधचापल्ये न शोकस्तेषु विद्यते।\nन धर्मध्वजिनश्चैव न गुह्यं किंचिदास्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2077918, "chapter_id": 2651, "verse_number": "१२-१५६-३१", "content_sanskrit": "येष्वलोभस्तथाऽमोहो ये च सत्यार्जवे स्थिताः।\nतेषु कौन्तेय रज्येथा येषां न भ्रश्यते पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2077919, "chapter_id": 2651, "verse_number": "१२-१५६-३२", "content_sanskrit": "ये न हृष्यन्ति लाभेषु नालाभेषु व्यथन्ति च।\nनिर्ममा निरहंकाराः सत्वस्थाः समदर्शिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2077920, "chapter_id": 2651, "verse_number": "१२-१५६-३३", "content_sanskrit": "लाभालाभौ सुखदुःखे च तात\nप्रियाप्रिये मरणं जीवितं च।\nसमानि येषां स्थिरविक्रमाणां\nबुभुत्सतां सत्यपथे स्थितानाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2077921, "chapter_id": 2651, "verse_number": "१२-१५६-३४", "content_sanskrit": "धर्मप्रियांस्तान्सुमहानुभावान्\nदान्तोऽप्रमत्तश्च समर्चयेथाः।\nदैवात्सर्वे गुणवन्तो भवन्ति\nशुभाशुभे वाक्प्रलापास्तथाऽन्ये॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2077922, "chapter_id": 2651, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि आपद्धर्मपर्वणि षट्पञ्चाशदधिकशततमोऽध्यायः॥ १५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]