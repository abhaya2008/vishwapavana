[{"id": 2130999, "chapter_id": 3826, "verse_number": "", "content_sanskrit": "धनदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2131000, "chapter_id": 3826, "verse_number": "१", "content_sanskrit": "युधिष्ठिर धृतिर्दाक्ष्यं देशकालपराक्रमाः ।\nलोकतन्त्रविधानानामेष पञ्चविधो विधिः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2131001, "chapter_id": 3826, "verse_number": "२", "content_sanskrit": "धृतिमन्तश्च दक्षाश्च स्वे स्वे कर्मणि भारत ।\nपराक्रमविधानज्ञा नरा कृतयुगेऽभवन्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2131002, "chapter_id": 3826, "verse_number": "३", "content_sanskrit": "धृतिमान् देशकालज्ञः सर्वधर्मविधानवित् ।\nक्षत्रियः क्षत्रियश्रेष्ठ प्रशास्ति पृथिवीं चिरम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2131003, "chapter_id": 3826, "verse_number": "४", "content_sanskrit": "य एवं वर्तते पार्थ पुरुषः सर्वकर्मसु ।\nस लोके लभते वीर यशः प्रेत्य च सद्गतिम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2131004, "chapter_id": 3826, "verse_number": "५", "content_sanskrit": "देशकालान्तरप्रेप्सुः कृत्वा शक्रः पराक्रमम् ।\nसम्प्राप्तस्त्रिदिवे राज्यं वृत्रहा वसुभिः सह \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2131005, "chapter_id": 3826, "verse_number": "", "content_sanskrit": "यस्तु केवलसंरम्भात् प्रपातं न निरीक्षते ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2131006, "chapter_id": 3826, "verse_number": "६", "content_sanskrit": "पापात्मा पापबुद्धिर्यः पापमेवानुवर्तते ।\nकर्मणामविभागज्ञः प्रेत्य चेह विनश्यति\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2131007, "chapter_id": 3826, "verse_number": "७", "content_sanskrit": "अकालज्ञः सुदुर्मेधाः कार्याणामविशेषवित् ।\nवृथाऽऽचारसमारम्भः प्रेत्य चेह विनश्यति\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2131008, "chapter_id": 3826, "verse_number": "८", "content_sanskrit": "साहसे वर्तमानानां निकृतीनां दुरात्मनाम् ।\nसर्वसामर्थ्यलिप्सूनां पापो भवति निश्चयः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2131009, "chapter_id": 3826, "verse_number": "९", "content_sanskrit": "अधर्मज्ञोऽवलिप्तश्च बालबुद्धिरमर्षणः ।\nनिर्भयो भीमसेनोऽयं तं शाधि पुरुषर्षभ\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2131010, "chapter_id": 3826, "verse_number": "१०", "content_sanskrit": "आर्ष्टिषेणस्य राजर्षेः प्राप्य भूयस्त्वमाश्रमम् ।\nतामिस्रं प्रथमं पक्षं वीतशोकभयो वस\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2131011, "chapter_id": 3826, "verse_number": "११", "content_sanskrit": "अलकाः सह गन्धर्वैर्यक्षाश्च सह किन्नरैः ।\nगमिष्यामि महाबाहो त्वं चापि बदरीं व्रज\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2131012, "chapter_id": 3826, "verse_number": "१२", "content_sanskrit": "मन्नियुक्ता मनुष्येन्द्र सर्वे च गिरिवासिनः ।\nरक्षिष्यन्ति महाबाहो सहितं द्विजसत्तमैः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2131013, "chapter_id": 3826, "verse_number": "१३", "content_sanskrit": "साहसादनुसम्प्राप्तः प्रतिबुध्य वृकोदरः ।\nवार्यतां साध्वयं राजंस्त्वया धर्मभृतां वर\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2131014, "chapter_id": 3826, "verse_number": "१४", "content_sanskrit": "इतः परं च वो राजन् द्रक्ष्यन्ति वनगोचराः ।\nउपस्थास्यन्ति वो राजन् रक्षिष्यन्ते च वः सदा\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2131015, "chapter_id": 3826, "verse_number": "१५", "content_sanskrit": "तथैव चान्नपानानि स्वादूनि च बहूनि च ।\nआहरिष्यन्ति मत्प्रेष्याः सदा वः पुरुषर्षभाः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2131016, "chapter_id": 3826, "verse_number": "१६", "content_sanskrit": "यथा जिष्णुर्महेन्द्रस्य यथा वायोर्वृकोदरः ।\nधर्मस्य त्वं यथा तात योगोत्पन्नो निजः सुतः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2131017, "chapter_id": 3826, "verse_number": "१७", "content_sanskrit": "आत्मजावात्मसम्पन्नौ यमौ चोभौ यथाश्विनोः ।\nरक्ष्यास्तद्वन्ममापीह यूयं सर्वे युधिष्ठिर \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2131018, "chapter_id": 3826, "verse_number": "१८", "content_sanskrit": "अर्थतत्त्वविधानज्ञः सर्वधर्मविधानवित् ।\nभीमसेनादवरजः फल्गुनः कुशली दिवि\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2131019, "chapter_id": 3826, "verse_number": "१९", "content_sanskrit": "याः काश्चन मता लोके स्वर्ग्याः परमसम्पदः ।\nजन्मप्रभृति ताः सर्वाः स्थितास्तात धनञ्जये\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2131020, "chapter_id": 3826, "verse_number": "२०", "content_sanskrit": "दमो दानं बलं बुद्धिर्ह्रीर्धृतिस्तेज उत्तमम् ।\nएतान्यपि महासत्त्वे स्थितान्यमिततेजसि\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2131021, "chapter_id": 3826, "verse_number": "२१", "content_sanskrit": "न मोहात् कुरुते जिष्णुः कर्म पाण्डव गर्हितम् ।\nन पार्थस्य मृषोक्तानि कथयन्ति नरा नृषु\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2131022, "chapter_id": 3826, "verse_number": "२२", "content_sanskrit": "स देवपितृगन्धर्वैः कुरूणां कीर्तिवर्धनः ।\nमानितः कुरुतेऽस्त्राणि शक्रसद्मनि भारत\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2131023, "chapter_id": 3826, "verse_number": "२३", "content_sanskrit": "योऽसौ सर्वान् महीपालान् धर्मेण वशमानयत् ।\nस शन्तनुर्महातेजाः पितुस्तव पितामहः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2131024, "chapter_id": 3826, "verse_number": "२४", "content_sanskrit": "प्रीयते पार्थ पार्थेन दिवि गाण्डीवधन्वना ।\nसम्यक् चासौ महावीर्यः कुलधुर्येण पार्थिवः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2131025, "chapter_id": 3826, "verse_number": "२५", "content_sanskrit": "पितॄन् देवानृषीन् विप्रान् पूजयित्वा महातपाः ।\nसप्त मुख्यान् महामेधानाहरद् यमुनां प्रति\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2131026, "chapter_id": 3826, "verse_number": "२६", "content_sanskrit": "अधिराजः स राजंस्त्वां शन्तनुः प्रपितामहः ।\nस्वर्गजिच्छक्रलोकस्थः कुशलं परिपृच्छति\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2131027, "chapter_id": 3826, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2131028, "chapter_id": 3826, "verse_number": "२७", "content_sanskrit": "एतच्छ्रुत्वा तु वचनं धनदेन प्रभाषितम् ।\nपाण्डवाश्च ततस्तेन बभूवुः सम्प्रहर्षिताः ।\nअंसे प्राध्वत् नमश्चक्रे कुबेराय वृकोदरः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2131029, "chapter_id": 3826, "verse_number": "२८", "content_sanskrit": "ततोऽब्रवीद् धनाध्यक्षः शरण्यः शरणागतम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2131030, "chapter_id": 3826, "verse_number": "२९", "content_sanskrit": "मानहा भव शत्रूणां सुहृदां नन्दिवर्धनः ।\nविभयस्ताप शैलाग्रे वसानः सः बन्धुभिः \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2131031, "chapter_id": 3826, "verse_number": "३०", "content_sanskrit": "सुपर्णपितृदेवानां सततं मानकृद् भव ।\nऋजुं पश्यत मा वक्रं सत्यं वदत माऽनृतम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2131032, "chapter_id": 3826, "verse_number": "३१", "content_sanskrit": "दीर्घं पश्यत मा ह्रस्वं परं पश्यत माऽपरम् ।\nस्वेषु वेश्मसु रम्येषु वसतामित्रतापनाः ।\nकामान्न परिहास्यन्ति यक्षा वो भरतर्षभाः \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2131033, "chapter_id": 3826, "verse_number": "३२", "content_sanskrit": "शीघ्रमेव गुडाकेशः कृतास्त्रः पुनरेष्यति ।\nसाक्षान्मघवता सृष्टः सम्प्राप्स्यति धनञ्जयः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2131034, "chapter_id": 3826, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2131035, "chapter_id": 3826, "verse_number": "३३", "content_sanskrit": "एवमुत्तमकर्माणमनुशिष्य युधिष्ठिरम् ।\nअस्तं गिरिवरश्रेष्ठं प्रययौ गुह्यकाधिपः \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2131036, "chapter_id": 3826, "verse_number": "३४", "content_sanskrit": "तं परिस्तोमसङ्कीर्णैर्नानारत्नविभूषितैः ।\nयानैरनुययुर्यक्षा राक्षसाश्च सहस्रशः \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2131037, "chapter_id": 3826, "verse_number": "३५", "content_sanskrit": "पक्षिणामिव निर्घोषः कुबेरसदनं प्रति ।\nबभूव परमाश्वानामैरावणपथे यताम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2131038, "chapter_id": 3826, "verse_number": "३६", "content_sanskrit": "ते जग्मुस्तूर्णमाकाशं धनाधिपतिवाजिनः ।\nप्रकर्षन्त इवाभ्राणि पिबन्त इव मारुतम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2131039, "chapter_id": 3826, "verse_number": "३७", "content_sanskrit": "ततस्तानि शरीराणि गतसत्त्वानि रक्षसाम् ।\nअपाकृष्यन्त शैलाग्राद् धनाधिपतिशासनात्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2131040, "chapter_id": 3826, "verse_number": "३८", "content_sanskrit": "तेषां हि शापकालः स कृतोऽगस्त्येन धीमता ।\nसमरे निहतास्तस्माच्छापस्यान्तोऽभवत् तदा\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2131041, "chapter_id": 3826, "verse_number": "३९", "content_sanskrit": "पाण्डवाश्च महात्मानस्तेषु वेश्मसु ताः क्षपाः ।\nसुखमूषुर्गतोद्वेगाः पूजिताः सर्वराक्षसैः \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2131042, "chapter_id": 3826, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि अष्टपञ्चाशदधिकशततमोऽध्यायः ॥ १५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2131043, "chapter_id": 3826, "verse_number": "५", "content_sanskrit": "यक्षयुद्धपर्वणि पञ्चमोऽध्यायः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2131044, "chapter_id": 3826, "verse_number": "", "content_sanskrit": "* * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]