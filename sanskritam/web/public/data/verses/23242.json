[{"id": 7003242000, "chapter_id": 23242, "verse_number": "१-४५-१", "content_sanskrit": "ऋषय ऊचुः  ।\nसूत सुव्यक्तमखिलं कथितं शंकरस्य तु  ।\nसर्वात्मभावं रुद्रस्य स्वुरूपं वक्तुमर्हसि ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003242001, "chapter_id": 23242, "verse_number": "१-४५-२", "content_sanskrit": "सूत उवाच  ।\nभूर्भुवः स्वर्महश्चैव जनः साक्षात्तपस्तथा  ।\nसत्यलोकश्च पातालं नरकार्णवकोटयः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003242002, "chapter_id": 23242, "verse_number": "१-४५-३", "content_sanskrit": "तारकाग्रहसोमार्का ध्रुवः सप्तर्षयस्तथा  ।\nवैमानिकास्तथान्ये च तिष्ठंत्यस्य प्रसादतः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003242003, "chapter_id": 23242, "verse_number": "१-४५-४", "content_sanskrit": "अनेन निर्मितास्त्वेवं तदात्मानो द्विजर्षभाः  ।\nसमाष्टिरूपः सर्वात्मा संस्थितः सर्वदा शिवः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003242004, "chapter_id": 23242, "verse_number": "१-४५-५", "content_sanskrit": "सर्वात्मानं महात्मानं महादेवं महेश्वरम्  ।\nन विजानंति संमूढा मायया तस्य मोहिताः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003242005, "chapter_id": 23242, "verse_number": "१-४५-६", "content_sanskrit": "तस्य देवस्य रुद्रस्य शरीरं वै जगत्त्रयम्  ।\nतस्मात्प्रणम्य तं वक्ष्ये जगतां निर्णयं शुभम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003242006, "chapter_id": 23242, "verse_number": "१-४५-७", "content_sanskrit": "पुरा वः कथितं सर्वं मयाण्डस्य यथा कृतिः  ।\nभुवनानां स्वरूपं च ब्रह्माण्डे कथयाम्यहम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003242007, "chapter_id": 23242, "verse_number": "१-४५-८", "content_sanskrit": "पृथिवीचांतरिक्षं च स्वर्महर्जन एव च  ।\nतपः सत्यं च सप्तैते लोकास्त्वंडोद्भवाः शुभाः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003242008, "chapter_id": 23242, "verse_number": "१-४५-९", "content_sanskrit": "अधस्तादत्र चैतेषां द्विजाः सप्त तलानि तु  ।\nमहातलादयस्तेषां अधस्तान्नरकाः क्रमात् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003242009, "chapter_id": 23242, "verse_number": "१-४५-१०", "content_sanskrit": "महातलं हेमतलं सर्वरत्नोपशोभितम्  ।\nप्रासादैश्च विचित्रैश्च भवस्यायतनैस्तथा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003242010, "chapter_id": 23242, "verse_number": "१-४५-११", "content_sanskrit": "अनंतेन च संयुक्तं मुचुकुंदेन धीमता  ।\nनृपेण बलिना चैव पातालस्वर्गवासिना ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003242011, "chapter_id": 23242, "verse_number": "१-४५-१२", "content_sanskrit": "शैलं रसातलं विप्राः शार्करं हि तलातलम्  ।\nपीतं सुतलमित्युक्तं वितलं विद्रुमप्रभम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003242012, "chapter_id": 23242, "verse_number": "१-४५-१३", "content_sanskrit": "सितं हि अतलं तच्च तलं यच्च सितेतरम्  ।\nक्ष्मायास्तु यावद्विस्तारो ह्यधस्तेषां च सुव्रताः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003242013, "chapter_id": 23242, "verse_number": "१-४५-१४", "content_sanskrit": "तलानां चैव सर्वेषां तावत्संख्या समाहिता  ।\nसहस्रयोजनं व्योम दशसाहस्रमेव च ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003242014, "chapter_id": 23242, "verse_number": "१-४५-१५", "content_sanskrit": "लक्षं सप्तसहस्रं हि तलानां सघनस्य तु  ।\nव्योम्नः प्रमाणं मूलं तु त्रिंशत्साहस्रकेण तु ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003242015, "chapter_id": 23242, "verse_number": "१-४५-१६", "content_sanskrit": "सुवर्णेन मुनिश्रेष्ठास्तथा वासुकिना शुभम्  ।\nरसातलमति ख्यातं तथान्यैश्च निषोवितम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003242016, "chapter_id": 23242, "verse_number": "१-४५-१७", "content_sanskrit": "विरोचनहिरण्याक्षनरकाद्यैश्च सेवितम्  ।\nतलातलमिति ख्यातं सर्वशोभासमन्वितम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003242017, "chapter_id": 23242, "verse_number": "१-४५-१८", "content_sanskrit": "वैनावकादिभिश्चैव कालनेमिपुरोगमैः  ।\nपूर्वदेवैः समाकीर्णं सुतलं च तथापरैः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003242018, "chapter_id": 23242, "verse_number": "१-४५-१९", "content_sanskrit": "वितलं दानवाद्यैश्च तारकाग्निमुखैस्तथा  ।\nमहांत काद्यैर्नागैश्च प्रह्लादेनासुरेण च ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003242019, "chapter_id": 23242, "verse_number": "१-४५-२०", "content_sanskrit": "वितलं चात्र विख्यातं कंबलाश्वनिषेवितम्  ।\nमहाकुंभेन वीरेण हयग्रीवेण धीमता ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003242020, "chapter_id": 23242, "verse_number": "१-४५-२१", "content_sanskrit": "शंकुकर्णेन संभिन्नं तथा नमुचिपूर्वकैः  ।\nतथान्यैर्विविधैर्वीरैस्तलं चैव सुशोभितम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003242021, "chapter_id": 23242, "verse_number": "१-४५-२२", "content_sanskrit": "तलेषु तेषु सर्वेषु चांबया परमेश्वरः  ।\nस्कन्देन नंदिना सार्धं गणपैः सर्वतो वृतः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003242022, "chapter_id": 23242, "verse_number": "१-४५-२३", "content_sanskrit": "तलानां चैव सर्वेषामूर्ध्वतः सप्तसप्तमाः  ।\nक्ष्मातलानि धरा चापि सप्तधा कथयामि वः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]