[{"id": 2184717, "chapter_id": 4921, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2184718, "chapter_id": 4921, "verse_number": "१", "content_sanskrit": "उक्तो मन्त्रो महाबाहो न विश्वासोऽस्ति शत्रुषु ।\nकथं हि राजा वर्तेत यदि सर्वत्र नाश्वसेत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2184719, "chapter_id": 4921, "verse_number": "२", "content_sanskrit": "विश्वासाद्धि परं राज्ञो राजन्नुत्पद्यते भयम् ।\nकथं वै नाश्वसन् राजा शत्रून् जयति पार्थिव\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2184720, "chapter_id": 4921, "verse_number": "३", "content_sanskrit": "एतन्मे संशयं छिन्धि मनो मे सम्प्रमुह्यति ।\nअविश्वासकथामेतामुपश्रुत्य पितामह\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2184721, "chapter_id": 4921, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2184722, "chapter_id": 4921, "verse_number": "४", "content_sanskrit": "शृणु कौन्तेय यो वृत्तो ब्रह्मदत्तनिवेशने ।\nपूजन्या सह संवादो ब्रह्मदत्तस्य पार्थिव\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2184723, "chapter_id": 4921, "verse_number": "५", "content_sanskrit": "काम्पिल्ये ब्रह्मदत्तस्य अन्तःपुरनिवासिनी ।\nपूजनी नाम शकुनी दीर्घकालं सहोषिता\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2184724, "chapter_id": 4921, "verse_number": "६", "content_sanskrit": "रुतज्ञा सर्वभूतानां यथा वै जीवजीवकः ।\nसर्वज्ञा सर्वधर्मज्ञा तिर्यग्योनिगतापि सा\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2184725, "chapter_id": 4921, "verse_number": "७", "content_sanskrit": "अभिप्रजाता सा तत्र पुत्रमेकं सुवर्चसम् ।\nसमकालं च राज्ञोऽपि देव्याः पुत्रो व्यजायत\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2184726, "chapter_id": 4921, "verse_number": "८", "content_sanskrit": "समुद्रतीरं गत्वा सा त्वाजहार फलद्वयम् ।\nपुष्ट्यर्थं च स्वपुत्रस्य राजपुत्रस्य चैव ह\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2184727, "chapter_id": 4921, "verse_number": "९", "content_sanskrit": "फलमेकं सुतायादाद्राजपुत्राय चापरम् ।\nअमृतास्वादसदृशं बलतेजोविवर्धनम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2184728, "chapter_id": 4921, "verse_number": "११", "content_sanskrit": "तत्रागच्छत् परां वृद्धिं राजपुत्रः फलाशनात् ।\nधात्र्या हस्तगतश्चापि तेनाक्रीडत पक्षिणा \t॥१०॥\nशून्ये तु तमुपादाय पक्षिणं समजातकम् ।\nहत्वा ततः स राजेन्द्र धात्र्या हस्तमुपागमत्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2184729, "chapter_id": 4921, "verse_number": "१२", "content_sanskrit": "अथ सा शकुनी राजन्नागमत् फलहारिका ।\nअपश्यन्निहतं पुत्रं तेन बालेन भूतले\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2184730, "chapter_id": 4921, "verse_number": "१३", "content_sanskrit": "बाष्पपूर्णमुखी दीना दृष्ट्वा सा तु हतं सुतम् ।\nपूजनी दुःखसन्तप्ता रुदती वाक्यमब्रवीत्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2184731, "chapter_id": 4921, "verse_number": "१४", "content_sanskrit": "क्षत्रिये सङ्गतं नास्ति न प्रीतिर्न च सौहृदम् ।\nकारणे सम्भजन्तीह कृतार्थाः सन्त्यजन्ति च\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2184732, "chapter_id": 4921, "verse_number": "१५", "content_sanskrit": "क्षत्रियेषु न विश्वासः कार्यः सर्वोपघातिषु ।\nअपकृत्यापि सततं सान्त्वयन्ति निरर्थकम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2184733, "chapter_id": 4921, "verse_number": "१६", "content_sanskrit": "अहमस्य करोम्यद्य सदृशीं वैरयातनाम् ।\nकृतघ्नस्य नृशंसस्य भृशं विश्वासघातिनः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2184734, "chapter_id": 4921, "verse_number": "१७", "content_sanskrit": "सहसञ्जातवृद्धस्य तथैव सहभोजिनः ।\nशरणागतस्य च वधस्त्रिविधं ह्यस्य किल्बिषम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2184735, "chapter_id": 4921, "verse_number": "१८", "content_sanskrit": "इत्युक्त्वा चरणाभ्यां तु नेत्रे नृपसुतस्य सा ।\nभित्त्वा स्वस्था तत इदं पूजनी वाक्यमब्रवीत्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2184736, "chapter_id": 4921, "verse_number": "१९", "content_sanskrit": "इच्छयेह कृतं पापम् इच्छयैवोपसर्पति ।\nकृतप्रतिकृतं तेषां न नश्यति शुभाशुभम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2184737, "chapter_id": 4921, "verse_number": "२०", "content_sanskrit": "पापकर्मकृतं किञ्चिन्न तस्मिन् यदि विद्यते ।\nनिपात्यतेऽस्य पुत्रेषु न चेत् पौत्रेषु नप्तृषु\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2184738, "chapter_id": 4921, "verse_number": "२१", "content_sanskrit": "ब्रह्मदत्तः सुतं दृष्ट्वा पूजन्या हृतलोचनम् ।\nकृतप्रतिकृतं मत्वा पूजनीमिदमब्रवीत्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2184739, "chapter_id": 4921, "verse_number": "", "content_sanskrit": "ब्रह्मदत्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2184740, "chapter_id": 4921, "verse_number": "२२", "content_sanskrit": "अस्ति वै कृतमस्माभिरस्ति प्रतिकृतं त्वया ।\nउभयं तत् समीभूतं वस पूजनि मा गमः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2184741, "chapter_id": 4921, "verse_number": "", "content_sanskrit": "पूजनी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2184742, "chapter_id": 4921, "verse_number": "२३", "content_sanskrit": "सकृत् कृतापराधस्य तत्रैव परिलम्बतः ।\nन तद् बुधाः प्रशंसन्ति श्रेयस्तत्रापसर्पणम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2184743, "chapter_id": 4921, "verse_number": "२४", "content_sanskrit": "सान्त्वे प्रयुक्ते नृपते कृतवैरे न विश्वसेत् ।\nक्षिप्रं प्रबध्यते मूढो न हि वैरं प्रशाम्यति\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2184744, "chapter_id": 4921, "verse_number": "२५", "content_sanskrit": "अन्योन्यं कृतवैराणां पुत्रपौत्रं निगच्छति ।\nपुत्रे पौत्रे विनिर्माय परलोकं निगच्छति\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2184745, "chapter_id": 4921, "verse_number": "२६", "content_sanskrit": "सर्वेषां कृतवैराणामविश्वासः सुखावहः ।\nएकान्ततो न विश्वासः कार्यो विश्वासघातकः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2184746, "chapter_id": 4921, "verse_number": "२७", "content_sanskrit": "न विश्वसेदविश्वस्ते विश्वस्तेऽपि न विश्वसेत् ।\nकामं विश्वासयेदन्यान् परेषां तु न विश्वसेत्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2184747, "chapter_id": 4921, "verse_number": "२८", "content_sanskrit": "माता पिता बान्धवानां वरिष्ठौ\nभार्या जरा बीजमात्रं तु पुत्रः ।\nभ्राता शत्रुः क्लिन्नपाणिर्वयस्य\nआत्मा ह्येकः सुखदुःखस्य वेत्ता\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2184748, "chapter_id": 4921, "verse_number": "२९", "content_sanskrit": "अन्योन्यकृतवैराणां न सन्धिरुपपद्यते ।\nस च हेतुरतिक्रान्तो यदर्थमहमावसम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2184749, "chapter_id": 4921, "verse_number": "३०", "content_sanskrit": "पूजितस्यार्थमानाभ्यां जन्तोः पूर्वापकारिणः ।\nहृदयं तव विश्वस्तं कर्म त्रासयते बलात्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2184750, "chapter_id": 4921, "verse_number": "३१", "content_sanskrit": "पूर्वं सम्मानना यत्र पश्चाच्चैव विमानना ।\nजह्यात्तं सत्त्ववान् वासं सम्मानितविमानितः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2184751, "chapter_id": 4921, "verse_number": "३२", "content_sanskrit": "उषितास्मि तवागारे दीर्घकालमहिंसिता ।\nतदिदं वैरमुत्पन्नं सुखमास्स्व व्रजाम्यहम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2184752, "chapter_id": 4921, "verse_number": "", "content_sanskrit": "ब्रह्मदत्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2184753, "chapter_id": 4921, "verse_number": "३३", "content_sanskrit": "यत्कृते प्रतिकुर्याद्वै न स तत्रापराध्नुयात् ।\nअनृणस्तेन भवति वस पूजनि मा गमः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2184754, "chapter_id": 4921, "verse_number": "", "content_sanskrit": "पूजनी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2184755, "chapter_id": 4921, "verse_number": "३४", "content_sanskrit": "न कृतस्य न कर्तुश्च सख्यं सन्धीयते पुनः ।\nहृदयं तत्र जानाति कर्तुश्चैव कृतस्य च\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2184756, "chapter_id": 4921, "verse_number": "", "content_sanskrit": "ब्रह्मदत्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2184757, "chapter_id": 4921, "verse_number": "३५", "content_sanskrit": "कृतस्य चैव कर्तुश्च सख्यं सन्धीयते पुनः ।\nवैरस्योपशमो दृष्टः पापं नोपाश्नुते पुनः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2184758, "chapter_id": 4921, "verse_number": "", "content_sanskrit": "पूजनी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2184759, "chapter_id": 4921, "verse_number": "३६", "content_sanskrit": "नास्ति चैवमतिक्रान्तं नास्तिकोऽस्मीति नाश्वसेत् ।\nविश्वासाद् बध्यते बालस्तस्माच्छ्रेयो ह्यदर्शनम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2184760, "chapter_id": 4921, "verse_number": "३७", "content_sanskrit": "तरसा ये न शक्यन्ते शस्त्रैः सुनिशितैरपि ।\nसाम्ना ते विनिगृह्यन्ते गजा इव करेणुभिः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2184761, "chapter_id": 4921, "verse_number": "", "content_sanskrit": "ब्रह्मदत्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2184762, "chapter_id": 4921, "verse_number": "३८", "content_sanskrit": "संवासाज्जायते स्नेहो जीवितान्तकरेष्वपि ।\nअन्योन्यस्य च विश्वासः श्वानश्वपचयोरपि\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2184763, "chapter_id": 4921, "verse_number": "३९", "content_sanskrit": "अन्योन्यकृतवैराणां संवासान्मृदुतां गतम् ।\nनावतिष्ठति तद्वैरं पुष्करस्थमिवोदकम्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2184764, "chapter_id": 4921, "verse_number": "", "content_sanskrit": "पूजनी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2184765, "chapter_id": 4921, "verse_number": "४०", "content_sanskrit": "वैरं पञ्चसमुत्थानं तच्च बुध्यन्ति पण्डिताः ।\nस्वकृतं वास्तुजं वाग्जं स्वपत्नापराधजम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2184766, "chapter_id": 4921, "verse_number": "४१", "content_sanskrit": "तत्र दाता निहन्तव्यः क्षत्रियेण विशेषतः ।\nप्रकाशं वाप्रकाशं वा बुद्ध्वा देशबलादिकम्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2184767, "chapter_id": 4921, "verse_number": "४२", "content_sanskrit": "कृतपापस्य विश्वासः कार्यस्त्विह सुहृद्यपि ।\nछन्नं सन्तिष्ठते वैरं गूढोऽग्निरिव दारुषु\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2184768, "chapter_id": 4921, "verse_number": "४३", "content_sanskrit": "न वित्तेन न पारुष्यैर्न सान्त्वेन न च श्रुतैः ।\nवैराग्निः शाम्यते राजन्नौर्वाग्निरिव सागरे\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2184769, "chapter_id": 4921, "verse_number": "४४", "content_sanskrit": "न हि वैराग्निरुद्भूतः कर्म वाप्यपराधजम् ।\nशाम्यत्यदग्ध्वा नृपते विना ह्येकतरक्षयात्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2184770, "chapter_id": 4921, "verse_number": "४५", "content_sanskrit": "सत्कृतस्यार्थमानाभ्यां स्यात्तु पूर्वापकारिणः ।\nनैव शान्तिर्न विश्वासः कर्म त्रासयते बलात्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2184771, "chapter_id": 4921, "verse_number": "४६", "content_sanskrit": "नैवापकारे कस्मिंश्चिदहं त्वयि तथा भवान् ।\nविश्वासादुषिता पूर्वं नेदानीं विश्वसाम्यहम्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2184772, "chapter_id": 4921, "verse_number": "", "content_sanskrit": "ब्रह्मदत्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2184773, "chapter_id": 4921, "verse_number": "४७", "content_sanskrit": "कालेन क्रियते कार्यं तथैव विविधाः क्रियाः ।\nकालेनैव प्रवर्तन्ते कः कस्येहापराध्यति\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2184774, "chapter_id": 4921, "verse_number": "४८", "content_sanskrit": "तुल्यं चोभे प्रवर्तेते मरणं जन्म चैव ह ।\nकार्यते चैव कालेन तन्निमित्तं हि जीवति\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2184775, "chapter_id": 4921, "verse_number": "४९", "content_sanskrit": "बध्यन्ते युगपत् केचिदेकैकस्य न चापरे ।\nकालो दहति भूतानि सम्प्राप्याग्निरिवेन्धनम्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2184776, "chapter_id": 4921, "verse_number": "५०", "content_sanskrit": "नाहं प्रमाणं नैव त्वमन्योन्यकरणे शुभे ।\nकालो नित्यमुपाधत्ते सुखं दुःखं च देहिनाम्\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2184777, "chapter_id": 4921, "verse_number": "५१", "content_sanskrit": "एवं वसेह सस्नेहा यथाकालमहिंसिता ।\nयत्कृतं तच्च मे क्षान्तं त्वं चैव क्षम पूजनि\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2184778, "chapter_id": 4921, "verse_number": "", "content_sanskrit": "पूजनी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2184779, "chapter_id": 4921, "verse_number": "५२", "content_sanskrit": "यदि कालः प्रमाणं ते न वैरं कस्यचिद्भवेत् ।\nकस्मात्त्वपचितिं यान्ति बान्धवा बान्धवे हते\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2184780, "chapter_id": 4921, "verse_number": "५३", "content_sanskrit": "कस्माद् देवासुराः पूर्वमन्योन्यमभिजघ्निरे ।\nयदि कालेन निर्याणं सुखदुःखे भवाभवौ\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2184781, "chapter_id": 4921, "verse_number": "५४", "content_sanskrit": "भिषजो भेषजं कर्तुं कस्मादिच्छन्ति रोगिणे ।\nयदि कालेन पच्यन्ते भेषजैः किं प्रयोजनम्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2184782, "chapter_id": 4921, "verse_number": "५५", "content_sanskrit": "प्रलापः क्रियते कस्मात् सुमहान् शोकमूर्छितैः ।\nयदि कालः प्रमाणं ते कस्माद्धर्मोऽस्ति कर्तृषु\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2184783, "chapter_id": 4921, "verse_number": "५६", "content_sanskrit": "तव पुत्रो ममापत्यं हतवान् हिंसितो मया ।\nअनन्तरं त्वया चाहं बन्धनीया महीपते\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2184784, "chapter_id": 4921, "verse_number": "५७", "content_sanskrit": "अहं हि पुत्रशोकेन कृतपापा तवात्मजे ।\nतथा त्वया प्रहर्तव्यं मयि तत्त्वं च मे शृणु\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2184785, "chapter_id": 4921, "verse_number": "५८", "content_sanskrit": "भक्षार्थं क्रीडनार्थं वा नरा वाञ्छन्ति पक्षिणः ।\nतृतीयो नास्ति संयोगो वधबन्धादृते क्षमः\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2184786, "chapter_id": 4921, "verse_number": "५९", "content_sanskrit": "वधबन्धभयादेके मोक्षतन्त्रमुपागताः ।\nमरणोत्पातजं दुःखमाहुर्धर्मविदो जनाः\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2184787, "chapter_id": 4921, "verse_number": "६०", "content_sanskrit": "सर्वस्य दयिताः प्राणाः सर्वस्य दयिताः सुताः ।\nदुःखादुद्विजते सर्वः सर्वस्य सुखमीप्सितम्\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2184788, "chapter_id": 4921, "verse_number": "६१", "content_sanskrit": "दुःखं जरा ब्रह्मदत्त दुःखमर्थविपर्ययः ।\nदुःखं चानिष्टसंवासो दुःखमिष्टवियोगजम्\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2184789, "chapter_id": 4921, "verse_number": "६२", "content_sanskrit": "वैरबन्धकृतं दुःखं हिंसाजं स्त्रीकृतं तथा ।\nदुःखं सुखेन सततं जनान् विपरिवर्तते\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2184790, "chapter_id": 4921, "verse_number": "६३", "content_sanskrit": "न दुःखं परदुःखे वै केचिदाहुरबुद्धयः ।\nयो दुःखं नाभिजानाति स जल्पति महाजने\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2184791, "chapter_id": 4921, "verse_number": "६४", "content_sanskrit": "यस्तु शोचति दुःखार्तः स कथं वक्तुमुत्सहेत् ।\nरसज्ञः सर्वदुःखस्य यथात्मनि तथा परे\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2184792, "chapter_id": 4921, "verse_number": "६५", "content_sanskrit": "यत्कृतं ते मया राजंस्त्वया च मम यत्कृतम् ।\nन तद्वर्षशतैः शक्यं व्यपोहितुमरिंदम\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2184793, "chapter_id": 4921, "verse_number": "६६", "content_sanskrit": "आवयोः कृतमन्योन्यं तत्र सन्धिर्न विद्यते ।\nस्मृत्वा स्मृत्वा हि ते पुत्रं नवं वैरं भविष्यति\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2184794, "chapter_id": 4921, "verse_number": "६७", "content_sanskrit": "वैरमन्तिकमासज्य यः प्रीतिं कर्तुमिच्छति ।\nमृन्मयस्येव भग्नस्य तस्य सन्धिर्न विद्यते\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2184795, "chapter_id": 4921, "verse_number": "६८", "content_sanskrit": "निश्चितश्चार्थशास्त्रज्ञैरविश्वासः सुखोदयः ।\nउशनाश्चाथ गाथे द्वे प्रह्रादायाब्रवीत् पुरा\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2184796, "chapter_id": 4921, "verse_number": "६९", "content_sanskrit": "भिन्नक्रमा न सज्जन्ते शस्त्रैः सुनिशितैरपि ।\nसाम्ना तेऽपि निगृह्यन्ते गजा इव करेणुभिः \t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2184797, "chapter_id": 4921, "verse_number": "७०", "content_sanskrit": "ये वैरिणः श्रद्दधते सत्ये सत्येतरेऽपि वा ।\nते श्रद्दधाना वध्यन्ते मधु शुष्कतृणैर्यथा\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2184798, "chapter_id": 4921, "verse_number": "७१", "content_sanskrit": "न हि वैराणि शाम्यन्ति कुलेष्वा दशमाद्युगात् ।\nआख्यातारश्च विद्यन्ते कुले चेद्विद्यते पुमान्\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2184799, "chapter_id": 4921, "verse_number": "७२", "content_sanskrit": "उपगुह्य हि वैराणि सान्त्वयन्ति नराधिपाः ।\nअथैनं प्रतिपिंषन्ति पूर्णं घटमिवाश्मनि\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2184800, "chapter_id": 4921, "verse_number": "७३", "content_sanskrit": "सदा न विश्वसेद् राजन् पापं कृत्वेह कस्यचित् ।\nअपकृत्य परेषां हि विश्वासाद्दुःखमश्नुते\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2184801, "chapter_id": 4921, "verse_number": "", "content_sanskrit": "ब्रह्मदत्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2184802, "chapter_id": 4921, "verse_number": "७४", "content_sanskrit": "नाविश्वासाच्चिन्वतेऽर्थान्नेहन्ते चापि किञ्चन ।\nप्रयात्वेकतरं मित्रे कृतकृत्या भवत्विह\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2184803, "chapter_id": 4921, "verse_number": "", "content_sanskrit": "पूजनी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2184804, "chapter_id": 4921, "verse_number": "७५", "content_sanskrit": "यस्यैव व्रणिनौ पादौ पद्भ्यां च परिसर्पति ।\nक्षण्येते तस्य तौ पादौ सुगुप्तमभिधावतः\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2184805, "chapter_id": 4921, "verse_number": "७६", "content_sanskrit": "नेत्राभ्यां सरुजाभ्यां यः प्रतिवातमुदीक्षते ।\nतस्य वायुरुजात्यर्थं नेत्रयोर्भवति ध्रुवम्\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2184806, "chapter_id": 4921, "verse_number": "७७", "content_sanskrit": "दुष्टं पन्थानमाश्रित्य यो मोहादभिपद्यते ।\nआत्मनो बलमज्ञात्वा तदन्तं तस्य जीवितम्\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2184807, "chapter_id": 4921, "verse_number": "७८", "content_sanskrit": "यस्तु वर्षमविज्ञाय क्षेत्रं कृषति मानवः ।\nहीनः पुरुषकारेण सस्यं नैवाप्नुते पुनः\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2184808, "chapter_id": 4921, "verse_number": "७९", "content_sanskrit": "यश्च तिक्तं कषायं वाप्यास्वादविधुरं हितम् ।\nआहारं कुरुते नित्यं सोऽमृतत्वाय कल्पते\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2184809, "chapter_id": 4921, "verse_number": "८०", "content_sanskrit": "पथ्यं मुक्त्वा नरो लोभाद् योऽन्यदश्नाति भोजनम् ।\nपरिणाममविज्ञाय तदन्तं तस्य जीवितम्\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2184810, "chapter_id": 4921, "verse_number": "८१", "content_sanskrit": "दैवं पुरुषकारश्च स्थितावन्योन्यसंश्रयात् ।\nउदात्ता वै कर्म तत्र दैवं किं वा उपासते\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2184811, "chapter_id": 4921, "verse_number": "८२", "content_sanskrit": "कर्म चात्महितं कार्यं तीक्ष्णं वा यदि वा मृदु ।\nग्रस्यतेऽकर्मशीलस्तु सदानर्थैरकिञ्चनः\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2184812, "chapter_id": 4921, "verse_number": "८३", "content_sanskrit": "तस्मात् संशयितेऽप्यर्थे कार्य एव पराक्रमः ।\nसर्वस्वमपि सन्त्यज्य कार्यमात्महितं नरैः\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2184813, "chapter_id": 4921, "verse_number": "८४", "content_sanskrit": "विद्या शौर्यं च दाक्ष्यं च बलं धैर्यं च पञ्चमम् ।\nमित्राणि सहजान्याहुर्वर्तयन्तीह यैर्बुधाः\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2184814, "chapter_id": 4921, "verse_number": "८५", "content_sanskrit": "निवेशनं च कुप्यं च क्षेत्रं भार्या सुहृज्जनः ।\nएतान्युपचितान्याहुः सर्वत्र लभते पुमान्\t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2184815, "chapter_id": 4921, "verse_number": "८६", "content_sanskrit": "सर्वत्र रमते प्राज्ञः सर्वत्र च विरोचते ।\nन विभीषयते कञ्चिद्भीषितो न बिभेति च\t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2184816, "chapter_id": 4921, "verse_number": "८७", "content_sanskrit": "नित्यं बुद्धिमतो ह्यर्थः स्वल्पकोऽपि विवर्धते ।\nदाक्ष्येण कुरुते कर्म संयमात् प्रतितिष्ठति\t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2184817, "chapter_id": 4921, "verse_number": "८८", "content_sanskrit": "गृहस्नेहावबद्धानां नराणामल्पमेधसाम् ।\nकुस्त्री खादति मांसानि माघमा सेगवामिव\t॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2184818, "chapter_id": 4921, "verse_number": "८९", "content_sanskrit": "गृहं क्षेत्राणि मित्राणि स्वदेश इति चापरे ।\nइत्येवमवसीदन्ति नरा बुद्धिविपर्यये\t॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2184819, "chapter_id": 4921, "verse_number": "९०", "content_sanskrit": "उत्पतेत् सरुजाद् देशाद् व्याधिदुर्भिक्षपीडितात् ।\nअन्यत्र वस्तुं गच्छेद्वा वसेद्वा नित्यमानितः\t॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2184820, "chapter_id": 4921, "verse_number": "९१", "content_sanskrit": "तस्मादन्यत्र यास्यामि वस्तुं नाहमिहोत्सहे ।\nकृतमेतदनाहार्यं तव पुत्रेण पार्थिव\t॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2184821, "chapter_id": 4921, "verse_number": "९२", "content_sanskrit": "कुभार्यां च कुपुत्रं च कुराजानं कुसौहृदम् ।\nकुसम्बन्धं कुदेशं च दूरतः परिवर्जयेत्\t॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2184822, "chapter_id": 4921, "verse_number": "९३", "content_sanskrit": "कुमित्रे नास्ति विश्वासः कुभार्यायां कुतो रतिः ।\nकुराज्ये निर्वृतिर्नास्ति कुदेशे न प्रजीव्यते\t॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2184823, "chapter_id": 4921, "verse_number": "९४", "content_sanskrit": "कुमित्रे सङ्गतं नास्ति नित्यमस्थिरसौहृदे ।\nअवमानः कुसम्बन्धे भवत्यर्थविपर्यये\t॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2184824, "chapter_id": 4921, "verse_number": "९५", "content_sanskrit": "सा भार्या या प्रियं ब्रूते स पुत्रो यत्र निर्वृतिः ।\nतन्मित्रं यत्र विश्वासः स देशो यत्र जीव्यते\t॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2184825, "chapter_id": 4921, "verse_number": "९६", "content_sanskrit": "यत्र नास्ति बलात्कारः स राजा तीव्रशासनः ।\nयत्रैव ह्यभिसम्बन्धो दरिद्रं यो बुभूषति\t॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2184826, "chapter_id": 4921, "verse_number": "९७", "content_sanskrit": "भार्या देशोऽथ मित्राणि पुत्रसम्बन्धिबान्धवाः ।\nएतत् सर्वं गुणवति धर्मनेत्रे महीपतौ\t॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2184827, "chapter_id": 4921, "verse_number": "९८", "content_sanskrit": "अधर्मज्ञस्य विलयं प्रजा गच्छन्त्यनिग्रहात् ।\nराजा मूलं त्रिवर्गस्य अप्रमत्तोऽनुपालयन्\t॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2184828, "chapter_id": 4921, "verse_number": "९९", "content_sanskrit": "बलिषड्भागमुद्धृत्य बलिं तमुपयोजयेत् ।\nन रक्षति प्रजाः सम्यग्यः स पार्थिवतस्करः\t॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2184829, "chapter_id": 4921, "verse_number": "१००", "content_sanskrit": "दत्त्वाभयं यः स्वयमेव राजा\nन तत् प्रमाणं कुरुते यथावत् ।\nस सर्वलोकादुपलभ्य पाप-\nमधर्मबुद्धिर्निरयं प्रयाति\t॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2184830, "chapter_id": 4921, "verse_number": "१०१", "content_sanskrit": "दत्त्वाभयं यः स्म राजा प्रमाणं कुरुते सदा ।\nस सर्वसुखकृज्ज्ञेयः प्रजा धर्मेण पालयन्\t॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2184831, "chapter_id": 4921, "verse_number": "१०२", "content_sanskrit": "पिता माता गुरुर्गोप्ता वह्निर्वैश्रवणो यमः ।\nसप्त राज्ञो गुणानेतान् मनुराह प्रजापतिः\t॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2184832, "chapter_id": 4921, "verse_number": "१०३", "content_sanskrit": "पिता हि राजा राष्ट्रस्य प्रजानां योऽनुकम्पकः ।\nतस्मिन् मिथ्याप्रणीते हि तिर्यग्गच्छति मानवः\t॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2184833, "chapter_id": 4921, "verse_number": "१०४", "content_sanskrit": "सम्भावयति मातेव दीनमभ्यवपद्यते ।\nदहत्यग्निरिवानिष्टान् यमयन् भवते यमः\t॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2184834, "chapter_id": 4921, "verse_number": "१०५", "content_sanskrit": "इष्टेषु विसृजत्यर्थान् कुबेर इव कामदः ।\nगुरुर्धर्मोपदेशेन गोप्ता च परिपालनात्\t॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2184835, "chapter_id": 4921, "verse_number": "१०६", "content_sanskrit": "यस्तु रञ्जयते राजा पौरजानपदान्गुणैः ।\nन तस्य भ्रश्यते राज्यं गुणधर्मानुपालनात्\t॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2184836, "chapter_id": 4921, "verse_number": "१०७", "content_sanskrit": "स्वयं समुपजानन्हि पौरजानपदक्रियाः ।\nस सुखं मोदते भूप इह लोके परत्र च\t॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2184837, "chapter_id": 4921, "verse_number": "१०८", "content_sanskrit": "नित्योद्विग्नाः प्रजा यस्य करभारप्रपीडिताः ।\nअनर्थैर्विप्रलुप्यन्ते स गच्छति पराभवम्\t॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2184838, "chapter_id": 4921, "verse_number": "१०९", "content_sanskrit": "प्रजा यस्य विवर्धन्ते सरसीव महोत्पलम् ।\nस सर्वयज्ञफलभाग् राजा लोके महीयते\t॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2184839, "chapter_id": 4921, "verse_number": "११०", "content_sanskrit": "बलिना विग्रहो राजन्न कथञ्चित् प्रशस्यते ।\nबलिना विगृहीतस्य कुतो राज्यं कुतः सुखम्\t॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2184840, "chapter_id": 4921, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2184841, "chapter_id": 4921, "verse_number": "१११", "content_sanskrit": "सैवमुक्त्वा शकुनिका ब्रह्मदत्तं नराधिपम् ।\nराजानं समनुज्ञाप्य जगामाथेप्सितां दिशम्\t॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2184842, "chapter_id": 4921, "verse_number": "११२", "content_sanskrit": "एतत्ते ब्रह्मदत्तस्य पूजन्या सह भाषितम् ।\nमयोक्तं भरतश्रेष्ठ किमन्यच्छ्रोतुमिच्छसि\t॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 2184843, "chapter_id": 4921, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि आपद्धर्मे नवमोऽध्यायः ॥ ९ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}]