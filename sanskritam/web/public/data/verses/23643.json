[{"id": 7003643000, "chapter_id": 23643, "verse_number": "१-२-३०-१", "content_sanskrit": "नारद उवाच ।\nततः स्कन्दः सुरैः सार्धं श्वेतपर्वत मस्तकात् ।\nउत्तीर्य तारकं हन्तुं दक्षिणां स दिशं ययौ ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003643001, "chapter_id": 23643, "verse_number": "१-२-३०-२", "content_sanskrit": "ततः सरस्वतीतीरे यानि भूतानि नारद ।\nग्रहाश्चोपग्रहाश्चैव वेतालाः शाकिनी गणाः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003643002, "chapter_id": 23643, "verse_number": "१-२-३०-३", "content_sanskrit": "उन्मादा ये ह्यपस्माराः पलादाश्च पिशाचकाः ।\nदेवैस्तेषामाधिपत्ये सोऽभ्यषिच्यत पावकिः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003643003, "chapter_id": 23643, "verse_number": "१-२-३०-४", "content_sanskrit": "यथा ते नैव मर्यादां संत्यजंति दुराशयाः ।\nएतैस्तस्मात्समाक्रांतः शरण्यं पावकिं व्रजेत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003643004, "chapter_id": 23643, "verse_number": "१-२-३०-५", "content_sanskrit": "अप्रकीर्णेन्द्रियं दांतं शुचिं नित्यमतंद्रितम् ।\nआस्तिकं स्कन्दभक्तं च वर्जयंति ग्रहादिकाः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003643005, "chapter_id": 23643, "verse_number": "१-२-३०-६", "content_sanskrit": "महेश्वरं च ये भक्ता भक्ता नारायणं च ये ।\nतेषां दर्शनमात्रेण नश्यंते ते विदूरतः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003643006, "chapter_id": 23643, "verse_number": "१-२-३०-७", "content_sanskrit": "ततः सर्वैः सुरैः सार्धं महीतीरं ययौ गुहः ।\nतत्र देवैः प्रकथितं महीमाहात्म्यमुत्तमम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003643007, "chapter_id": 23643, "verse_number": "१-२-३०-८", "content_sanskrit": "श्रृण्वन्विसिष्मिये स्कन्दः प्रणनाम च तां नदीम् ।\nततो महीदक्षिणतस्तीरमाश्रित्य धिष्ठितम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003643008, "chapter_id": 23643, "verse_number": "१-२-३०-९", "content_sanskrit": "प्रणम्य शक्रप्रमुखा गुहं वचनमब्रुवन् ।\nअभिषिक्तं विना स्कन्द सेनापतिमकल्मषम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003643009, "chapter_id": 23643, "verse_number": "१-२-३०-१०", "content_sanskrit": "न शर्म लभते सेना तस्मात्त्वमभिषेचय ।\nमहीसागरसंभूतैः पुण्यैश्चापि शिवैर्जलैः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003643010, "chapter_id": 23643, "verse_number": "१-२-३०-११", "content_sanskrit": "अभिषेक्ष्यामहे त्वां च तत्र नो द्रष्टुमर्हसि ।\nयथा हस्तिपदे सर्वपदांतर्भाव इष्यते ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003643011, "chapter_id": 23643, "verse_number": "१-२-३०-१२", "content_sanskrit": "सर्वतीर्थान्तरस्थानं तथार्णवमहीजले ।\nसर्वभूतमयो यद्वत्र्यंबकः परिकीर्त्यते ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003643012, "chapter_id": 23643, "verse_number": "१-२-३०-१३", "content_sanskrit": "सर्वतीर्थमयस्तद्वन्महीसागरसंगमः ।\nअर्धनारीश्वरं रूपं यथा रुद्रस्य सर्वदम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003643013, "chapter_id": 23643, "verse_number": "१-२-३०-१४", "content_sanskrit": "तथा महीसमुद्रस्य स्नानं सर्वफलप्रदम् ।\nयेनात्र पितरः स्कन्द तर्पिता भक्तिभावतः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003643014, "chapter_id": 23643, "verse_number": "१-२-३०-१५", "content_sanskrit": "तेन सर्वेषु तीर्थेषु तर्पिता नात्र संशयः ।\nन चैतद्धृदि मंतव्यं क्षारमेतज्जलं हि यत् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003643015, "chapter_id": 23643, "verse_number": "१-२-३०-१६", "content_sanskrit": "यथा हि कटुतिक्तादि गवा ग्रस्तं हि क्षीरदम् ।\nएवमेतत्त्विदं तोयं पितॄणां तृप्ति दायकम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003643016, "chapter_id": 23643, "verse_number": "१-२-३०-१७", "content_sanskrit": "एवं ब्रुवत्सु देवेषु कपिलोऽपि मुनिर्जगौ ।\nसत्यमेतदुमापुत्र सर्वतीर्थमयी मही ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003643017, "chapter_id": 23643, "verse_number": "१-२-३०-१८", "content_sanskrit": "कर्दमो यस्त्वहमपि ज्ञात्वा तीर्थमहा गुणान् ।\nसर्वां भुवं परित्यज्य कृत्वा ह्यश्रममास्तितः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003643018, "chapter_id": 23643, "verse_number": "१-२-३०-१९", "content_sanskrit": "ततो महेश्वरः प्राह सत्यमेतत्सुरोदितम् ।\nब्रह्माद्यास्तं तथा प्राहुरत्र भूयोऽप्यथो गुरुः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003643019, "chapter_id": 23643, "verse_number": "१-२-३०-२०", "content_sanskrit": "अत्राभिषेकं ते वीर करिष्यामः समादिश ।\nततः सुविस्मितस्तत्र स्नात्वा स्कन्दो महामनाः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003643020, "chapter_id": 23643, "verse_number": "१-२-३०-२१", "content_sanskrit": "अभिषिञ्चन्तु मां देवा इति तानब्रवीद्वचः ।\nततोऽभिषेकसंभारान्सर्वान्संभृत्य शास्त्रतः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003643021, "chapter_id": 23643, "verse_number": "१-२-३०-२२", "content_sanskrit": "जुहुवुर्मंत्रपूतेऽग्नौ चत्वारो मुख्यऋत्विजः ।\nब्रह्मा च कपिलो जीवो विश्वामित्रश्चतुर्थकः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003643022, "chapter_id": 23643, "verse_number": "१-२-३०-२३", "content_sanskrit": "अन्ये च शतशस्तत्र मुनयो वेदपारगाः ।\nतत्राद्भुतं महादेवो दर्शयामास भारत ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003643023, "chapter_id": 23643, "verse_number": "१-२-३०-२४", "content_sanskrit": "यदग्निकुण्डमध्यस्थो लिंगमूर्तिर्व्यदृश्यत ।\nअहमेवाग्निमध्यस्थो हविर्गृह्णामि नित्यशः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003643024, "chapter_id": 23643, "verse_number": "१-२-३०-२५", "content_sanskrit": "एतत्संदर्शनार्थाय लिंगमूर्तिरभूद्विभुः ।\nतल्लिंगमतुलं देवा नमश्चक्रुर्मुदान्विताः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003643025, "chapter_id": 23643, "verse_number": "१-२-३०-२६", "content_sanskrit": "सर्वपापापहं पार्थ सर्वकामफलप्रदम् ।\nतत्र होमावसाने च दत्ते हिमवता शुभे ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003643026, "chapter_id": 23643, "verse_number": "१-२-३०-२७", "content_sanskrit": "दिव्यरत्नान्विते स्कन्दो निषण्णः परमासने ।\nसर्वमंगलसंभारैर्विधिमंत्रपुरस्कृतम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003643027, "chapter_id": 23643, "verse_number": "१-२-३०-२८", "content_sanskrit": "अभ्यषिंचंस्ततो देवाः कुमारं शंकरात्मजम् ।\nइंद्रो विष्णुर्महावीर्यो ब्रह्मरुद्रौ च फाल्गुन ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003643028, "chapter_id": 23643, "verse_number": "१-२-३०-२९", "content_sanskrit": "आदित्याद्य ग्रहाः सर्वे तथोभावनिलानलौ ।\nआदित्या वसवो रुद्राः साध्याश्चैवाश्विनावुभौ ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003643029, "chapter_id": 23643, "verse_number": "१-२-३०-३०", "content_sanskrit": "विश्वेदेवाश्च मरुतो गंधर्वाप्सरसस्तथा ।\nदेवब्रह्मर्षयश्चैव वालखिल्या मरीचिपाः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003643030, "chapter_id": 23643, "verse_number": "१-२-३०-३१", "content_sanskrit": "विद्याधरा योगसिद्धाः पुलस्त्यपुलहादयः ।\nपितरः कश्यपोऽत्रिश्च मरीचिर्भृगुरंगिराः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003643031, "chapter_id": 23643, "verse_number": "१-२-३०-३२", "content_sanskrit": "दक्षोऽथ मनवो ये च ज्योतींषि ऋतवस्तथा ।\nमूर्तिमत्यश्च सरितो महीप्रभृतिकास्तथा ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003643032, "chapter_id": 23643, "verse_number": "१-२-३०-३३", "content_sanskrit": "लवणाद्याः समुद्राश्च प्रभासाद्याश्च तीर्थकाः ।\nपृथिवी द्यौर्दिशश्चैव पादपाः पार्वतास्तथा ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003643033, "chapter_id": 23643, "verse_number": "१-२-३०-३४", "content_sanskrit": "आदित्याद्या मातरश्च कुर्वंत्यो गुहमंगलम् ।\nवासुकिप्रमुखा नागास्थथोभौ गरुडारुणौ ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003643034, "chapter_id": 23643, "verse_number": "१-२-३०-३५", "content_sanskrit": "वरुणो धनदश्चैव यमः सानुचरस्तथा ।\nराक्षसो निरृतिश्चैव भूतानि च पलाशनाः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003643035, "chapter_id": 23643, "verse_number": "१-२-३०-३६", "content_sanskrit": "धर्मो बृहस्पतिश्चैव कपिलो गाधिनंदनः ।\nबहुलत्वाच्च ये नोक्ता विविधा देवतागणाः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003643036, "chapter_id": 23643, "verse_number": "१-२-३०-३७", "content_sanskrit": "ते च सर्वे महीकूले ह्यभ्यषिंचन्मुदा गुहम् ।\nततो महास्वनामुग्रां देवदैत्यादिदर्पहाम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003643037, "chapter_id": 23643, "verse_number": "१-२-३०-३८", "content_sanskrit": "ददौ पशुपतिस्तस्मै सर्वभूतमहाचमूम् ।\nविष्णुर्ददौ वैजयंतीं मालां बलविवर्धिनीम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003643038, "chapter_id": 23643, "verse_number": "१-२-३०-३९", "content_sanskrit": "उमा ददौ चारजसी वाससी सूर्यसप्रभा ।\nगंगा कमंडलुं दिव्यममृतोद्भवमुत्तमम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003643039, "chapter_id": 23643, "verse_number": "१-२-३०-४०", "content_sanskrit": "मही महानदी तस्य चाक्षमालां ससागरा ।\nददौ मुदा कुमाराय दंडं चैव बृहस्पतिः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003643040, "chapter_id": 23643, "verse_number": "१-२-३०-४१", "content_sanskrit": "गरुडो दयितं पुत्रं मयूरं चित्रबर्हिणम् ।\nअरुणस्ताम्रचूडं च प्रददौ चरणायुधम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003643041, "chapter_id": 23643, "verse_number": "१-२-३०-४२", "content_sanskrit": "छागं च वरुणो राजा बलवीर्यसमन्वितम् ।\nकृष्णाजिनं तथा ब्रह्मा ब्रह्मण्याय ददौ जयम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003643042, "chapter_id": 23643, "verse_number": "१-२-३०-४३", "content_sanskrit": "चतुरोऽनुचरांश्चैव महावीर्यान्बलोत्कटान् ।\nनंदिसेनं लोहिताक्षं घण्टाकर्णं च मानसान् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003643043, "chapter_id": 23643, "verse_number": "१-२-३०-४४", "content_sanskrit": "चतुर्थं चाप्यतिबलं ख्यातं कुसुममालिनम् ।\nततः स्थाणुर्ददौ देवो महापारिषदं क्रतुम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003643044, "chapter_id": 23643, "verse_number": "१-२-३०-४५", "content_sanskrit": "स हि देवासुरे युद्धे दैत्यानां भीमकर्मणाम् ।\nजघान दोर्भ्यां संक्रुद्धः प्रयुतानि चतुर्दश ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003643045, "chapter_id": 23643, "verse_number": "१-२-३०-४६", "content_sanskrit": "यमः प्रादादनुचरौ यमकालोपमौ तदा ।\nउन्माथं च प्रमाथं च महावीर्यौ महाद्युती ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003643046, "chapter_id": 23643, "verse_number": "१-२-३०-४७", "content_sanskrit": "सुभ्राजौ भास्करस्यैव यौ सदा चानुयायिनौ ।\nतौ सूर्यः कार्तिकेयाय ददौ पार्थ मुदान्वितः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003643047, "chapter_id": 23643, "verse_number": "१-२-३०-४८", "content_sanskrit": "कैलासश्रृङ्गसंकाशौ श्वेतमाल्यानुलेपनौ ।\nसोमोऽप्यनुचरौ प्रादान्मणिं सुमणिमेव च ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003643048, "chapter_id": 23643, "verse_number": "१-२-३०-४९", "content_sanskrit": "ज्वालजिह्वं ज्योतिषं च ददावग्निर्महाबलौ ।\nपरिघं च बलं चैव भीमं च सुमहाबलम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003643049, "chapter_id": 23643, "verse_number": "१-२-३०-५०", "content_sanskrit": "स्कंदाय त्रीननुचरान्ददौ विष्णुरुरुक्रमः ।\nउत्क्रोशं पंचजं चैव वज्रदण्डधरावुभौ ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003643050, "chapter_id": 23643, "verse_number": "१-२-३०-५१", "content_sanskrit": "ददौ महेशपुत्राय वासवः परवीरहा ।\nतौ हि शत्रून्महेन्द्रस्य जघ्नतुः समरे बहून् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003643051, "chapter_id": 23643, "verse_number": "१-२-३०-५२", "content_sanskrit": "वर्धनं बंधनं चैव आयुर्वेदविशारदौ ।\nस्कन्दाय ददतुः प्रीतावश्विनौ भरतर्षभ ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003643052, "chapter_id": 23643, "verse_number": "१-२-३०-५३", "content_sanskrit": "बलं चातिबलं चैव महावक्त्रौ महाबलौ ।\nप्रददौ कार्तिकेयाय वायुश्चानुचरावुभौ ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003643053, "chapter_id": 23643, "verse_number": "१-२-३०-५४", "content_sanskrit": "घसं चातिघसं वीरौ वरुणश्च ददौ प्रभुः ।\nसुवर्चसं महात्मानं तथैवाप्यतिवर्चसम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003643054, "chapter_id": 23643, "verse_number": "१-२-३०-५५", "content_sanskrit": "हिमवान्प्रददौ पार्थ साक्षाद्दौहित्रकाय वै ।\nकांचनं च ददौ मेरुर्मेघमालिनमेव च ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003643055, "chapter_id": 23643, "verse_number": "१-२-३०-५६", "content_sanskrit": "उच्छ्रितं चातिशृंगं च महापाषाणयोधिनौ ।\nस्वाहेयाय ददौ प्रीतः स विंध्यः पार्षदौ शुभौ ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003643056, "chapter_id": 23643, "verse_number": "१-२-३०-५७", "content_sanskrit": "संग्रहं विग्रहं चैव समुद्रोऽपि गधाधरौ ।\nप्रददौ पार्षदौ विरौ महीनद्या समन्वितः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003643057, "chapter_id": 23643, "verse_number": "१-२-३०-५८", "content_sanskrit": "उन्मादं पुष्पदंतं च शंकुकर्णं तथैव च ।\nप्रददावग्निपुत्राय पार्वती शुभदर्शना ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003643058, "chapter_id": 23643, "verse_number": "१-२-३०-५९", "content_sanskrit": "जयं महाजयं चैव नागौ ज्वलनसूनवे ।\nप्रददुर्बलिनां श्रेष्ठौ सुपर्णः पार्षदावुभौ ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003643059, "chapter_id": 23643, "verse_number": "१-२-३०-६०", "content_sanskrit": "एवं साध्याश्च रुद्राश्च वसवः पितरस्तथा ।\nसर्वे जगति ये मुख्या ददुः स्कंदाय पार्षदान् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003643060, "chapter_id": 23643, "verse_number": "१-२-३०-६१", "content_sanskrit": "नानावीर्यान्महावीर्यान्नानायुधविभूषणान् ।\nबहुलत्वान्न शक्यंते संख्यातुं ते च फाल्गुन ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003643061, "chapter_id": 23643, "verse_number": "१-२-३०-६२", "content_sanskrit": "मातश्च ददुस्तस्मै तदा मातृगणान्प्रभो ।\nयाभिर्व्याप्तास्त्रयो लोकाः कल्याणीभिश्चराचराः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003643062, "chapter_id": 23643, "verse_number": "१-२-३०-६३", "content_sanskrit": "प्रभावती विशालाक्षी गोपाला गोनसा तथा ।\nअप्सुजाता बृहद्दंडी कालिका बहुपुत्रका ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003643063, "chapter_id": 23643, "verse_number": "१-२-३०-६४", "content_sanskrit": "भयंकरी च चक्रांगी तीर्थनेमिश्च माधवी ।\nगीतप्रिया अलाताक्षी चटुला शलभामुखी ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003643064, "chapter_id": 23643, "verse_number": "१-२-३०-६५", "content_sanskrit": "विद्युज्जिह्वा रुद्रकाली शतोलूखलमेखला ।\nशतघंटाकिंकिणिका चक्राक्षी चत्वरालया ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003643065, "chapter_id": 23643, "verse_number": "१-२-३०-६६", "content_sanskrit": "पूतना रोदना त्वामा कोटरा मेघवाहिनी ।\nऊर्ध्ववेणीधरा चैव जरायुर्जर्जरानना ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003643066, "chapter_id": 23643, "verse_number": "१-२-३०-६७", "content_sanskrit": "खटखेटी दहदहा तथा धमधमा जया ।\nबहुवेणी बहुशीरा बहुपादा बहुस्तनी ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003643067, "chapter_id": 23643, "verse_number": "१-२-३०-६८", "content_sanskrit": "शतोलूकमुखी कृष्णा कर्णप्रावरणा तथा ।\nशून्यालया धान्यवासा पशुदा धान्यदा सदा ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003643068, "chapter_id": 23643, "verse_number": "१-२-३०-६९", "content_sanskrit": "एताश्चान्याश्च बह्व्यश्च मातरो भरतर्षभ ।\nबहुलत्वादहं तासां न संख्यातुमिहोत्सहे ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003643069, "chapter_id": 23643, "verse_number": "१-२-३०-७०", "content_sanskrit": "वृक्षचत्वरवासिन्यश्चतुष्पथनिवेशनाः ।\nगुहास्मशानवासिन्यः शैलप्रस्रवणालयाः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003643070, "chapter_id": 23643, "verse_number": "१-२-३०-७१", "content_sanskrit": "नानाभरणवेषास्ता नानामूर्तिधरास्तथा ।\nनानाभाषायुधधराः परिवव्रुस्तदा गुहम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003643071, "chapter_id": 23643, "verse_number": "१-२-३०-७२", "content_sanskrit": "ततः स शुशुभे श्रीमान्गुहो गुह इवापरः ।\nसैनापत्ये चाभिषिक्तो देवैर्नानामुनीश्वरैः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003643072, "chapter_id": 23643, "verse_number": "१-२-३०-७३", "content_sanskrit": "ततः प्रणम्य सर्वांस्ता नेकैकत्वेन पावकिः ।\nव्रियतां वर इत्याह भवब्रह्मपुरोगमान् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}]