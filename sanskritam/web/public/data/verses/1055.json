[{"id": 2002528, "chapter_id": 1055, "verse_number": "१-५६-०x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2002529, "chapter_id": 1055, "verse_number": "१-५६-१", "content_sanskrit": "बालोऽप्ययं स्थविर इवावभाषते\nनायं बालः स्थविरोऽयं मतो मे।\nइच्छाम्यहं वरमस्मै प्रदातुं\nतन्मे विप्राः संविदध्वं यथावत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2002530, "chapter_id": 1055, "verse_number": "१-५६-२x", "content_sanskrit": "सदस्या ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2002531, "chapter_id": 1055, "verse_number": "१-५६-२", "content_sanskrit": "बालोऽपि विप्रो मान्य एवेह राज्ञा\nयश्चाविद्वान्यश्च विद्वान्यथावत्।\nप्रसादयैनं त्वरितो नरेन्द्र\nद्विजातिवर्यं सकलार्थसिद्धये।\nसर्वान्कामांस्त्वत्त एवार्हतेऽद्य\nयथा च नस्तक्षक एति शीघ्रम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2002532, "chapter_id": 1055, "verse_number": "१-५६-३x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2002533, "chapter_id": 1055, "verse_number": "१-५६-३", "content_sanskrit": "व्याहर्तुकामे वरदे नृपे द्विजं\nवरं वृणीष्वेति ततोऽब्युवाच।\nहोता वाक्यं नातिहृष्टान्तरात्मा\nकर्मण्यस्मिंस्तक्षको नैति तावत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2002534, "chapter_id": 1055, "verse_number": "१-५६-४x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2002535, "chapter_id": 1055, "verse_number": "१-५६-४", "content_sanskrit": "यथा चेदं कर्म समाप्यते मे\nयथा च वै तक्षक एति शीघ्रम्।\nतथा भवन्तः प्रयतन्तु सर्वे\nपरं शक्त्या स हि मे विद्विषाणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2002536, "chapter_id": 1055, "verse_number": "१-५६-५x", "content_sanskrit": "ऋत्विज ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2002537, "chapter_id": 1055, "verse_number": "१-५६-५", "content_sanskrit": "यथा शस्त्राणि नः प्राहुर्यथा शंसति पावकः।\nइन्द्रस्य भवने राजंस्तक्षको भयपीडितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2002538, "chapter_id": 1055, "verse_number": "१-५६-६", "content_sanskrit": "यथा सूतो लोहिताक्षो महात्मा\nपौराणिको वेदितवान्पुरस्तात्।\nस राजानं प्राह पृष्टस्तदानीं\nयथाहुर्विप्रास्तद्वदेतन्नृदेव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2002539, "chapter_id": 1055, "verse_number": "१-५६-७", "content_sanskrit": "पुराणमागम्य ततो ब्रवीम्यहं\nदत्तं तस्मै वरमिन्द्रेण राजन्।\nवसेह त्वं मत्सकाशे सुगुप्तो\nन पावकस्त्वां प्रदहिष्यतीति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2002540, "chapter_id": 1055, "verse_number": "१-५६-८", "content_sanskrit": "एतच्छ्रुत्वा दीक्षितस्तप्यमान\nआस्ते होतारं चोदयन्कर्म काले।\nइन्द्रेण सार्धं तक्षकं पातयध्वं\nविभावसौ न विमुच्येत नागः।\nहोता च यत्तोऽस्याजुहावाथ मन्त्रै-\nरथो महेन्द्रः स्वयमाजगाम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2002541, "chapter_id": 1055, "verse_number": "१-५६-९", "content_sanskrit": "आयातु चेन्द्रोऽपि सतक्षकः पते-\nद्विभावसौ नागराजेन तूर्णम्।\nजम्भस्य हन्तेति जुहाव होता\nतदा जगामाहिदत्ताभयः प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2002542, "chapter_id": 1055, "verse_number": "१-५६-१०", "content_sanskrit": "विमानमारुह्य महानुभावः\nसर्वैर्देवैः परिसंस्तूयमानः।\nबलाहकैश्चाप्यनुगम्यमानो\nविद्याधरैरप्सरसां गणैश्च\nनागस्य नाशो मम चैव नाशो\nभविष्यतीत्येव विचिन्तयानः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2002543, "chapter_id": 1055, "verse_number": "१-५६-११", "content_sanskrit": "तस्योत्तरीये निहितः स नागो\nभयोद्विग्नः शर्म नैवाभ्यगच्छत्।\nततो राजा मन्त्रविदोऽब्रवीत्पुनः\nक्रुद्धो वाक्यं तक्षकस्यान्तमिच्छन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2002544, "chapter_id": 1055, "verse_number": "१-५६-१२x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2002545, "chapter_id": 1055, "verse_number": "१-५६-१२", "content_sanskrit": "इन्द्रस्य भवने विप्रा यदि नागः स तक्षकः।\nतमिन्द्रेणैव सहितं पातयध्यं विभावसौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2002546, "chapter_id": 1055, "verse_number": "१-५६-१३x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2002547, "chapter_id": 1055, "verse_number": "१-५६-१३", "content_sanskrit": "जनमेजयेन राज्ञा तु नोदितस्तक्षकं प्रति।\nहोता जुहाव तत्रस्थं तक्षकं पन्नगं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2002548, "chapter_id": 1055, "verse_number": "१-५६-१४", "content_sanskrit": "हूयमाने तथा चैव तक्षकः सपुरन्दरः।\nआकाशे ददृशे तत्र क्षणेन व्यथितस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2002549, "chapter_id": 1055, "verse_number": "१-५६-१५", "content_sanskrit": "पुरन्दरस्तु तं यज्ञं दृष्ट्वोरुभयमाविशत्।\nहित्वा तु तक्षकं त्रस्तः स्वमेव भवनं ययौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2002550, "chapter_id": 1055, "verse_number": "१-५६-१६", "content_sanskrit": "इन्द्रे गते तु राजेन्द्र तक्षको भयमोहितः।\nमन्त्रशक्त्या पावकार्चिस्समीपमवशो गतः।\nतं दृष्ट्वा ऋत्विजस्तत्र वचनं चेदमब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2002551, "chapter_id": 1055, "verse_number": "१-५६-१७x", "content_sanskrit": "ऋत्विज ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2002552, "chapter_id": 1055, "verse_number": "१-५६-१७", "content_sanskrit": "अयमायाति तूर्णं स तक्षकस्ते वशं नृप।\nश्रूयतेऽस्य महान्नादो नदतो भैरवं रवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2002553, "chapter_id": 1055, "verse_number": "१-५६-१८", "content_sanskrit": "नूनं मुक्तो वज्रभृता स नागो\nभ्रष्टो नाकान्मन्त्रवित्रस्तकायः।\nघूर्णन्नाकाशे नष्टसंज्ञोऽभ्युपैति\nतीव्रान्निश्वासान्निश्वसन्पन्नगेन्द्रः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2002554, "chapter_id": 1055, "verse_number": "१-५६-१९", "content_sanskrit": "वर्तते तव राजेन्द्र कर्मैतद्विधिवत्प्रभो।\nअस्मै तु द्विजमुख्याय वरं त्वं दातुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2002555, "chapter_id": 1055, "verse_number": "१-५६-२०x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2002556, "chapter_id": 1055, "verse_number": "१-५६-२०", "content_sanskrit": "बालाभिरूपस्य तवाप्रमेय\nवरं प्रयच्छामि यथानुरूपम्।\nवृणीष्व यत्तेऽभिमतं हृदि स्थितं\nतत्ते प्रदास्याम्यपि चेददेयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2002557, "chapter_id": 1055, "verse_number": "१-५६-२१x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2002558, "chapter_id": 1055, "verse_number": "१-५६-२१", "content_sanskrit": "पतिष्यमाणे नागेन्द्रे तक्षके जातवेदसि।\nइदमन्तरमित्येवं तदास्तीकोऽभ्यचोदयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2002559, "chapter_id": 1055, "verse_number": "१-५६-२२x", "content_sanskrit": "आस्तीक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2002560, "chapter_id": 1055, "verse_number": "१-५६-२२", "content_sanskrit": "वरं ददासि चेन्मह्यं वृणोमि जनमेजय।\nसत्रं ते विरमत्वेतन्न पतेयुरिहोरगाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2002561, "chapter_id": 1055, "verse_number": "१-५६-२३", "content_sanskrit": "एवमुक्तस्तदा तेन ब्रह्मन्पारिक्षितस्तु सः।\nनातिहृष्टमनाश्चेदमास्तीकं वाक्यमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2002562, "chapter_id": 1055, "verse_number": "१-५६-२४", "content_sanskrit": "सुवर्णं रजतं गाश्च यच्चान्यन्मन्यसे विभो।\nतत्ते दद्यां वरं विप्र न निवर्तेत्क्रतुर्मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2002563, "chapter_id": 1055, "verse_number": "१-५६-२५x", "content_sanskrit": "आस्तीक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2002564, "chapter_id": 1055, "verse_number": "१-५६-२५", "content_sanskrit": "सुवर्णं रजतं गाश्च न त्वां राजन्वृणोम्यहम्।\nसत्रं ते विरमत्वेतत्स्वस्ति मातृकुलस्य नः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2002565, "chapter_id": 1055, "verse_number": "१-५६-२६x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2002566, "chapter_id": 1055, "verse_number": "१-५६-२६", "content_sanskrit": "आस्तीकेनैवमुक्तस्तु राजा पारिक्षितस्तदा।\nपुनःपुनरुवाचेदमास्तीकं वदतां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2002567, "chapter_id": 1055, "verse_number": "१-५६-२७", "content_sanskrit": "अन्यं वरय भद्रं ते वरं द्विज्वरोत्तम।\nअयाचत न चाप्यन्यं वरं स भृगुनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2002568, "chapter_id": 1055, "verse_number": "१-५६-२८", "content_sanskrit": "ततो वेदविदस्तात सदस्याः सर्व एव तम्।\nराजानमूचुः सहिता लभतां ब्राह्मणो वरम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2002569, "chapter_id": 1055, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि आस्तीकपर्वणि षट्पञ्चाशत्तमोऽध्यायः॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]