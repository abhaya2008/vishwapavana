[{"id": 6000004000, "chapter_id": 10004, "verse_number": null, "content_sanskrit": "अथ चतुर्थाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000004001, "chapter_id": 10004, "verse_number": "१-४-१", "content_sanskrit": "इति ब्रुवाणं संस्तूय मुनीनां दीर्घसत्रिणाम्।\nवृद्धः कुलपतिः सूतं बह्वृचः शौनकोऽब्रवीत्॥ १/४/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_004/BhP_01.004.001.m4a", "display_order": 2, "topics": [{"text": "शौनकेन सूतं प्रति श्रीव्यासेन भागवतकरणे कारणस्य, तद्देशकालयोः शुकपरीक्षित्समागमप्रकारस्य परीक्षित्-प्रायोपवेशहेतोश्‍च प्रश्नः", "range": "१–२"}]}, {"id": 6000004002, "chapter_id": 10004, "verse_number": null, "content_sanskrit": "शौनक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_004/BhP_01.004.002.m4a", "display_order": 3}, {"id": 6000004003, "chapter_id": 10004, "verse_number": "१-४-२", "content_sanskrit": "सूत सूत महाभाग वद नो वदतां वर।\nकथां भागवतीं पुण्यां यामाह भगवान् शुकः॥ १/४/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_004/BhP_01.004.003.m4a", "display_order": 4}, {"id": 6000004004, "chapter_id": 10004, "verse_number": "१-४-३", "content_sanskrit": "कस्मिन् युगे प्रवृत्तेयं स्थाने वा केन हेतुना।\nकुतः संचोदितः कृष्णः कृतवान् संहितां मुनिः॥ १/४/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_004/BhP_01.004.004.m4a", "display_order": 5}, {"id": 6000004005, "chapter_id": 10004, "verse_number": "१-४-४", "content_sanskrit": "तस्य पुत्रो महायोगी समदृक् निर्विकल्पकः।\nएकान्तगतिरुन्निद्रो गूढो मूढ इवेयते॥ १/४/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_004/BhP_01.004.005.m4a", "display_order": 6}, {"id": 6000004006, "chapter_id": 10004, "verse_number": "१-४-५", "content_sanskrit": "कथमालक्षितः पौरैः संप्राप्‍तः कुरुजाङ्गलम्।\nउन्मत्तमूकजडवद्विचरन् गजसाह्वये॥ १/४/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_004/BhP_01.004.006.m4a", "display_order": 7}, {"id": 6000004007, "chapter_id": 10004, "verse_number": "१-४-६", "content_sanskrit": "कथं वा पाण्डवेयस्य राजर्षेर्मुनिना सह।\nसंवादः समभूत्तात यत्रैषा सात्वती श्रुतिः॥ १/४/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_004/BhP_01.004.007.m4a", "display_order": 8}, {"id": 6000004008, "chapter_id": 10004, "verse_number": "१-४-७", "content_sanskrit": "स गोदोहनमात्रं हि गृहेषु गृहमेधिनाम्।\nअवेक्षते महाभागस्तीर्थीकुर्वंस्तदाश्रमम्॥ १/४/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_004/BhP_01.004.008.m4a", "display_order": 9}, {"id": 6000004009, "chapter_id": 10004, "verse_number": "१-४-८", "content_sanskrit": "अभिमन्युसुतं सूत प्राहुर्भागवतोत्तमम्।\nतस्य जन्म महाश्‍चर्यं कर्माणि च गृणीहि नः॥ १/४/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_004/BhP_01.004.009.m4a", "display_order": 10}, {"id": 6000004010, "chapter_id": 10004, "verse_number": "१-४-९", "content_sanskrit": "स सम्राट् कस्य वा हेतोः पाण्डूनां मानवर्धनः।\nप्रायोपविष्‍टो गङ्गायामनादृत्याधिराट्श्रियम्॥ १/४/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_004/BhP_01.004.010.m4a", "display_order": 11}, {"id": 6000004011, "chapter_id": 10004, "verse_number": "१-४-१०", "content_sanskrit": "नमन्ति यत्पादनिकेतमात्मनः शिवाय चानीय धनानि शत्रवः।\nकथं स धीरः श्रियमङ्ग दुस्त्यजामियेष चोत्स्नष्‍टुमहो सहासुभिः॥ १/४/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_004/BhP_01.004.011.m4a", "display_order": 12}, {"id": 6000004012, "chapter_id": 10004, "verse_number": "१-४-११", "content_sanskrit": "शिवाय लोकस्य भवाय भूतये य उत्तमश्लोकपरायणा जनाः।\nजीवन्ति नात्मार्थमसौ परां श्रियं मुमोच निर्विद्य कुतः कलेवरम्॥ १/४/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_004/BhP_01.004.012.m4a", "display_order": 13}, {"id": 6000004013, "chapter_id": 10004, "verse_number": "१-४-१२", "content_sanskrit": "तत्सर्वं नः समाचक्ष्व पृष्‍टो यदिह किञ्चन।\nमन्ये त्वां विषये वाचां स्नातमन्यत्र च्छान्दसात्॥ १/४/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_004/BhP_01.004.013.m4a", "display_order": 14}, {"id": 6000004014, "chapter_id": 10004, "verse_number": null, "content_sanskrit": "सूत उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_004/BhP_01.004.014.m4a", "display_order": 15}, {"id": 6000004015, "chapter_id": 10004, "verse_number": "१-४-१३", "content_sanskrit": "द्वापरे समनुप्राप्‍ते तृतीये युगपर्यये।\nजातः पराशराद्योगी वासव्यां कलया हरेः॥ १/४/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_004/BhP_01.004.015.m4a", "display_order": 16, "topics": [{"text": "सूतेन तत्प्रश्नानामुत्तरकथनोपक्रमः", "range": "१३"}]}, {"id": 6000004016, "chapter_id": 10004, "verse_number": "१-४-१४", "content_sanskrit": "स कदाचित्सरस्वत्या उपस्पृश्य जलं शुचिः।\nविविक्‍त एक आसीन उदिते रविमण्डले॥ १/४/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_004/BhP_01.004.016.m4a", "display_order": 17, "topics": [{"text": "सरस्वतीतीरे समासीने व्यासे स्वेन वेदविभजनपूर्वकं भारतप्रणयने कृतेऽप्यात्मनोऽकृतार्थत्वबुद्‌ध्या परिचिन्तयति सति नारदस्य समागमः", "range": "१४–३२"}]}, {"id": 6000004017, "chapter_id": 10004, "verse_number": "१-४-१५", "content_sanskrit": "परावरज्ञः स ऋषिः कालेनाव्यक्‍तरंहसा।\nयुगधर्मव्यतिकरं प्राप्‍तं भुवि युगे युगे॥ १/४/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_004/BhP_01.004.017.m4a", "display_order": 18}, {"id": 6000004018, "chapter_id": 10004, "verse_number": "१-४-१६", "content_sanskrit": "भौतिकानां च भावानां शक्‍तिह्रासं च तत्कृतम्।\nअश्रद्दधानान्निःसत्त्वान् दुर्मेधान् ह्रसितायुषः॥ १/४/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_004/BhP_01.004.018.m4a", "display_order": 19}, {"id": 6000004019, "chapter_id": 10004, "verse_number": "१-४-१७", "content_sanskrit": "दुर्भगांश्‍च जनान्वीक्ष्य मुनिर्दिव्येन चक्षुषा।\nसर्ववर्णाश्रमाणां यद् दध्यौ चिरममोघदृक्॥ १/४/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_004/BhP_01.004.019.m4a", "display_order": 20}, {"id": 6000004020, "chapter_id": 10004, "verse_number": "१-४-१८", "content_sanskrit": "चातुर्होत्रं कर्म शुद्धिं प्रजानां वीक्ष्य वैदिकम्।\nव्यदधाद्यज्ञसन्तत्यै वेदमेकं चतुर्विधम्॥ १/४/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_004/BhP_01.004.020.m4a", "display_order": 21}, {"id": 6000004021, "chapter_id": 10004, "verse_number": "१-४-१९", "content_sanskrit": "ऋग्यजुःसामाथर्वाख्या वेदाश्‍चत्वार उद्धृताः।\nइतिहासपुराणं च पञ्चमो वेद उच्यते॥ १/४/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_004/BhP_01.004.021.m4a", "display_order": 22}, {"id": 6000004022, "chapter_id": 10004, "verse_number": "१-४-२०", "content_sanskrit": "तत्रर्ग्वेदधरः पैलः सामगो जैमिनिः कविः।\nवैशम्पायन एवैको निष्णातो यजुषां ततः॥ १/४/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_004/BhP_01.004.022.m4a", "display_order": 23}, {"id": 6000004023, "chapter_id": 10004, "verse_number": "१-४-२१", "content_sanskrit": "अथर्वाङ्गिरसामासीत्सुमन्तुर्वारुणो मुनिः।\nइतिहासपुराणानां पिता मे रोमहर्षणः॥ १/४/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_004/BhP_01.004.023.m4a", "display_order": 24}, {"id": 6000004024, "chapter_id": 10004, "verse_number": "१-४-२२", "content_sanskrit": "त एव ऋषयो वेदं स्वं स्वं व्यस्यन्ननेकधा।\nशिष्यैः प्रशिष्यैस्तच्छिष्यैर्वेदास्ते शाखिनोऽभवन्॥ १/४/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_004/BhP_01.004.024.m4a", "display_order": 25}, {"id": 6000004025, "chapter_id": 10004, "verse_number": "१-४-२३", "content_sanskrit": "त एव वेदा दुर्मेधैर्धार्यन्ते पुरुषैर्यथा।\nएवं चकार भगवान् व्यासः कृपणवत्सलः॥ १/४/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_004/BhP_01.004.025.m4a", "display_order": 26}, {"id": 6000004026, "chapter_id": 10004, "verse_number": "१-४-२४", "content_sanskrit": "स्‍त्रीशूद्रद्विजबन्धूनां त्रयी न श्रुतिगोचरा। कर्मश्रेयसि मूढानां श्रेय एवं भवेदिह।\nइति भारतमाख्यानं कृपया मुनिना कृतम्॥ १/४/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_004/BhP_01.004.026.m4a", "display_order": 27}, {"id": 6000004027, "chapter_id": 10004, "verse_number": "१-४-२५", "content_sanskrit": "एवं प्रवृत्तस्य सदा भूतानां श्रेयसि द्विजाः।\nसर्वात्मकेनापि यदा नातुष्यद् हृदयं ततः॥ १/४/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_004/BhP_01.004.027.m4a", "display_order": 28}, {"id": 6000004028, "chapter_id": 10004, "verse_number": "१-४-२६", "content_sanskrit": "नातिप्रसन्नहृदयः सरस्वत्यास्तटे शुचौ।\nवितर्कयन्विविक्‍तस्थ इदं चोवाच धर्मवित्॥ १/४/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_004/BhP_01.004.028.m4a", "display_order": 29}, {"id": 6000004029, "chapter_id": 10004, "verse_number": "१-४-२७", "content_sanskrit": "धृतव्रतेन हि मया छन्दांसि गुरवोऽग्नयः।\nमानिता निर्व्यलीकेन गृहीतं चानुशासनम्॥ १/४/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_004/BhP_01.004.029.m4a", "display_order": 30}, {"id": 6000004030, "chapter_id": 10004, "verse_number": "१-४-२८", "content_sanskrit": "भारतव्यपदेशेन ह्याम्नायार्थः प्रदर्शितः।\nदृश्यते यत्र धर्मादि स्‍त्रीशूद्रादिभिरप्युत॥ १/४/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_004/BhP_01.004.030.m4a", "display_order": 31}, {"id": 6000004031, "chapter_id": 10004, "verse_number": "१-४-२९", "content_sanskrit": "अथापि बत मे दैह्यो ह्यात्मा चैवात्मना विभुः।\nअसंपन्न इवाभाति ब्रह्मवर्चस्विसत्तमः॥ १/४/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_004/BhP_01.004.031.m4a", "display_order": 32}, {"id": 6000004032, "chapter_id": 10004, "verse_number": "१-४-३०", "content_sanskrit": "किं वा भागवता धर्मा न प्रायेण निरूपिताः।\nप्रियाः परमहंसानां त एव ह्यच्युतप्रियाः॥ १/४/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_004/BhP_01.004.032.m4a", "display_order": 33}, {"id": 6000004033, "chapter_id": 10004, "verse_number": "१-४-३१", "content_sanskrit": "तस्यैवं खिन्नमात्मानं मन्यमानस्य खिद्यतः।\nकृष्णस्य नारदोऽभ्यागादाश्रमं प्रागुदाहृतम्॥ १/४/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_004/BhP_01.004.033.m4a", "display_order": 34}, {"id": 6000004034, "chapter_id": 10004, "verse_number": "१-४-३२", "content_sanskrit": "तमभिज्ञाय सहसा प्रत्युत्थायागतं मुनिम्।\nपूजयामास विधिवन्नारदं सुरपूजितम्॥ १/४/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_004/BhP_01.004.034.m4a", "display_order": 35}, {"id": 6000004035, "chapter_id": 10004, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां प्रथमस्कन्धे चतुर्थाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]