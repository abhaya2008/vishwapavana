[{"id": 2191500, "chapter_id": 5072, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2191501, "chapter_id": 5072, "verse_number": "१", "content_sanskrit": "कथं नु मुक्तः पृथिवीं चरेदस्मद्विधो नृपः ।\nनित्यं कैश्च गुणैर्युक्तः सङ्गपाशाद् विमुच्यते\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2191502, "chapter_id": 5072, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2191503, "chapter_id": 5072, "verse_number": "२", "content_sanskrit": "अत्र ते वर्तयिष्यामि इतिहासं पुरातनम् ।\nअरिष्टनेमिना प्रोक्तं सगरायानुपृच्छते\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2191504, "chapter_id": 5072, "verse_number": "", "content_sanskrit": "सगरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2191505, "chapter_id": 5072, "verse_number": "३", "content_sanskrit": "किं श्रेयः परमं ब्रह्मन्कृत्वेह सुखमश्नुते ।\nकथं न शोचेन्न क्षुभ्येदेतदिच्छामि वेदितुम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2191506, "chapter_id": 5072, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2191507, "chapter_id": 5072, "verse_number": "४", "content_sanskrit": "एवमुक्तस्तदा तार्क्ष्यः सर्वशास्त्रविशारदः ।\nविबुद्ध्य सम्पदं चाग्र्यां सद्वाक्यमिदमब्रवीत्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2191508, "chapter_id": 5072, "verse_number": "५", "content_sanskrit": "सुखं मोक्षसुखं लोके न च लोकोऽवगच्छति ।\nप्रसक्तः पुत्रपशुषु धनधान्यसमाकुलः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2191509, "chapter_id": 5072, "verse_number": "६", "content_sanskrit": "सक्तबुद्धिरशान्तात्मा न स शक्यश्चिकित्सितुम् ।\nस्नेहपाशसितो मूढो न स मोक्षाय कल्पते\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2191510, "chapter_id": 5072, "verse_number": "७", "content_sanskrit": "स्नेहजानिह ते पाशान् वक्ष्यामि शृणु तान् मम ।\nसकर्णकेन शिरसा शक्याः श्रोतुं विजानता\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2191511, "chapter_id": 5072, "verse_number": "८", "content_sanskrit": "सम्भाव्य पुत्रान् कालेन यौवनस्थान्निवेश्य च ।\nसमर्थान् जीवने ज्ञात्वा मुक्तश्चर यथासुखम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2191512, "chapter_id": 5072, "verse_number": "९", "content_sanskrit": "भार्यां पुत्रवतीं वृद्धां लालितां पुत्रवत्सलाम् ।\nज्ञात्वा प्रजहि काले त्वं परार्थमनुदृश्य च\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2191513, "chapter_id": 5072, "verse_number": "१०", "content_sanskrit": "सापत्यो निरपत्यो वा मुक्तश्चर यथासुखम् ।\nइन्द्रियैरिन्द्रियार्थांस्त्वमनुभूय यथाविधि\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2191514, "chapter_id": 5072, "verse_number": "११", "content_sanskrit": "कृतकौतूहलस्तेषु मुक्तश्चर यथासुखम् ।\nउपपत्त्योपलब्धेषु लाभेषु च समो भव\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2191515, "chapter_id": 5072, "verse_number": "१२", "content_sanskrit": "एष तावत् समासेन तव सङ्कीर्तितो मया ।\nमोक्षार्थो विस्तरेणापि भूयो वक्ष्यामि तच्छृणु\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2191516, "chapter_id": 5072, "verse_number": "१३", "content_sanskrit": "मुक्ता वीतभया लोके चरन्ति सुखिनो नराः ।\nसक्तभावा विनश्यन्ति नरास्तत्र न संशयः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2191517, "chapter_id": 5072, "verse_number": "१४", "content_sanskrit": "आहारसञ्चयाश्चैव तथा कीटपिपीलिकाः ।\nअसक्ताः सुखिनो लोके सक्ताश्चैव विनाशिनः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2191518, "chapter_id": 5072, "verse_number": "१५", "content_sanskrit": "स्वजने न च ते चिन्ता कर्तव्या मोक्षबुद्धिना ।\nइमे मया विनाभूता भविष्यन्ति कथं त्विति\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2191519, "chapter_id": 5072, "verse_number": "१६", "content_sanskrit": "स्वयमुत्पद्यते जन्तुः स्वयमेव विवर्धते ।\nसुखदुःखे तथा मृत्युं स्वयमेवाधिगच्छति\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2191520, "chapter_id": 5072, "verse_number": "१७", "content_sanskrit": "भोजनाच्छादने चैव मात्रा पित्रा च सङ्ग्रहम् ।\nस्वकृतेनाधिगच्छन्ति लोके नास्त्यकृतं पुरा\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2191521, "chapter_id": 5072, "verse_number": "१८", "content_sanskrit": "धात्रा विहितभक्ष्याणि सर्वभूतानि मेदिनीम् ।\nलोके विपरिधावन्ति रक्षितानि स्वकर्मभिः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2191522, "chapter_id": 5072, "verse_number": "१९", "content_sanskrit": "स्वयं मृत्पिण्डभूतस्य परतन्त्रस्य सर्वदा ।\nको हेतुः स्वजनं पोष्टुं रक्षितुं वादृढात्मनः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2191523, "chapter_id": 5072, "verse_number": "२०", "content_sanskrit": "स्वजनं हि यदा मृत्युर्हन्त्येव तव पश्यतः ।\nकृतेऽपि यत्ने महति तत्र बोद्धव्यमात्मना\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2191524, "chapter_id": 5072, "verse_number": "२१", "content_sanskrit": "जीवन्तमपि चैवैनं भरणे रक्षणे तथा ।\nअसमाप्ते परित्यज्य पश्चादपि मरिष्यसि\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2191525, "chapter_id": 5072, "verse_number": "२२", "content_sanskrit": "यदा मृतश्च स्वजनं न ज्ञास्यसि कथञ्चन ।\nसुखितं दुःखितं वापि ननु बोद्धव्यमात्मना\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2191526, "chapter_id": 5072, "verse_number": "२३", "content_sanskrit": "मृते वा त्वयि जीवे वा यदि भोक्ष्यति वै जनः ।\nस्वकृतं ननु बुद्ध्वैवं कर्तव्यं हितमात्मनः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2191527, "chapter_id": 5072, "verse_number": "२४", "content_sanskrit": "एवं विजानँल्लोकेऽस्मिन्कः कस्येत्यभिनिश्चितः ।\nमोक्षे निवेशय मनो भूयश्चाप्युपधारय\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2191528, "chapter_id": 5072, "verse_number": "", "content_sanskrit": "क्षुत्पिपासादयो भावा जिता यस्येह देहिनः ।\nक्रोधो लोभस्तथा मोहः सत्त्ववान् मुक्त एव सः\t॥२५ ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2191529, "chapter_id": 5072, "verse_number": "२६", "content_sanskrit": "द्यूते पाने तथा स्त्रीषु मृगयायां च यो नरः ।\nन प्रमाद्यति सम्मोहात् सततं मुक्त एव सः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2191530, "chapter_id": 5072, "verse_number": "२७", "content_sanskrit": "दिवसे दिवसे नाम रात्रौ रात्रौ सदा सदा ।\nभोक्तव्यमिति यः खिन्नो दोषबुद्धिः स उच्यते\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2191531, "chapter_id": 5072, "verse_number": "२८", "content_sanskrit": "आत्मभावं तथा स्त्रीषु मुक्तमेव पुनः पुनः ।\nयः पश्यति सदा युक्तो यथावन्मुक्त एव सः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2191532, "chapter_id": 5072, "verse_number": "", "content_sanskrit": "सम्भवं च विनाशं च भूतानां चेष्टितं तथा ।\nयस्तत्त्वतो विजानाति लोकेऽस्मिन् मुक्त एव सः\t॥२९", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2191533, "chapter_id": 5072, "verse_number": "३०", "content_sanskrit": "प्रस्थं वाहसहस्रेषु यात्रार्थं चैव कोटिषु ।\nप्रासादे मञ्चकस्थानं यः पश्यति स मुच्यते\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2191534, "chapter_id": 5072, "verse_number": "३१", "content_sanskrit": "मृत्युनाभ्याहतं लोकं व्याधिभिश्चोपपीडितम् ।\nअवृत्तिकर्शितं चैव यः पश्यति स मुच्यते\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2191535, "chapter_id": 5072, "verse_number": "३२", "content_sanskrit": "यः पश्यति सुखी तुष्टो नपश्यंश्च विहन्यते ।\nयश्चाप्यल्पेन सन्तुष्टो लोकेऽस्मिन् मुक्त एव सः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2191536, "chapter_id": 5072, "verse_number": "३३", "content_sanskrit": "अग्नीषोमाविदं सर्वमिति यश्चानुपश्यति ।\nन च संस्पृश्यते भावैरद्भुतैर्मुक्त एव सः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2191537, "chapter_id": 5072, "verse_number": "३४", "content_sanskrit": "पर्यङ्कशय्या भूमिश्च समाने यस्य देहिनः ।\nशालयश्च कदन्नं च यस्य स्यान्मुक्त एव सः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2191538, "chapter_id": 5072, "verse_number": "३५", "content_sanskrit": "क्षौमं च कुशचीरं च कौशेयं वल्कलानि च ।\nअविकं चर्म च समं यस्य स्यान्मुक्त एव सः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2191539, "chapter_id": 5072, "verse_number": "", "content_sanskrit": "पञ्चभूतसमुद्भूतं लोकं यश्चानुपश्यति ।\nतथा च वर्तते दृष्ट्वा लोकेऽस्मिन् मुक्त एव सः\t॥३६ ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2191540, "chapter_id": 5072, "verse_number": "३७", "content_sanskrit": "सुखदुःखे समे यस्य लाभालाभौ जयाजयौ ।\nइच्छाद्वेषौ भयोद्वेगौ सर्वथा मुक्त एव सः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2191541, "chapter_id": 5072, "verse_number": "३८", "content_sanskrit": "रक्तमूत्रपुरीषाणां दोषाणां सञ्चयं तथा ।\nशरीरं दोषबहुलं दृष्ट्वा चेदं विमुच्यते\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2191542, "chapter_id": 5072, "verse_number": "३९", "content_sanskrit": "वलीपलितसंयोगं कार्श्यं वैवर्ण्यमेव च ।\nकुब्जभावं च जरया यः पश्यति स मुच्यते\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2191543, "chapter_id": 5072, "verse_number": "४०", "content_sanskrit": "पुंस्त्वोपघातं कालेन दर्शनोपरमं तथा ।\nबाधिर्यं प्राणमन्दत्वं यः पश्यति स मुच्यते\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2191544, "chapter_id": 5072, "verse_number": "४१", "content_sanskrit": "गतानृषींस्तथा देवानसुरांश्च तथा गतान् ।\nलोकादस्मात् परं लोकं यः पश्यति स मुच्यते\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2191545, "chapter_id": 5072, "verse_number": "४२", "content_sanskrit": "प्रभावैरन्वितास्तैस्तैः पार्थिवेन्द्राः सहस्रशः ।\nये गताः पृथिवीं त्यक्त्वा इति ज्ञात्वा विमुच्यते\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2191546, "chapter_id": 5072, "verse_number": "४३", "content_sanskrit": "अर्थांश्च दुर्लभाँल्लोके क्लेशांश्च सुलभांस्तथा ।\nदुःखं चैव कुटुम्बार्थे यः पश्यति स मुच्यते\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2191547, "chapter_id": 5072, "verse_number": "४४", "content_sanskrit": "अपत्यानां च वैगुण्यं जनं विगुणमेव च ।\nपश्यन् भूयिष्ठशो लोके को मोक्षं नाभिपूजयेत्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2191548, "chapter_id": 5072, "verse_number": "४५", "content_sanskrit": "शास्त्राल्लोकाच्च यो बुद्धः सर्वं पश्यति मानवः ।\nअसारमिव मानुष्यं सर्वथा मुक्त एव सः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2191549, "chapter_id": 5072, "verse_number": "४६", "content_sanskrit": "एतच्छ्रुत्वा मम वचो भवांश्चरतु मुक्तवत् ।\nगार्हस्थ्ये यदि ते मोक्षे कृता बुद्धिरविक्लवा\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2191550, "chapter_id": 5072, "verse_number": "४७", "content_sanskrit": "तत्तस्य वचनं श्रुत्वा सम्यक्स पृथिवीपतिः ।\nमोक्षजैश्च गुणैर्युक्तः पालयामास च प्रजाः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2191551, "chapter_id": 5072, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे एकविंशोत्तरशततमोऽध्यायः ॥१२१॥\n॥ सगरारिष्टनेमिसंवादः समाप्तः ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]