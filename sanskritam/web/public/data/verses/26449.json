[{"id": 7006449000, "chapter_id": 26449, "verse_number": "२-१०९-१", "content_sanskrit": "वैशम्पायन उवाच\nअत्राश्चर्यात्मकं स्तोत्रमाह्निकं जयतां वर ।\nप्रद्युम्ने द्वारकां प्राप्ते हत्वा तं कालशम्बरम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006449001, "chapter_id": 26449, "verse_number": "२-१०९-२", "content_sanskrit": "बलदेवेन रक्षार्थं प्रोक्तमाह्निकमुच्यते ।\nयञ्जप्त्वा तु नृपश्रेष्ठ सायं पूतात्मतां व्रजेत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006449002, "chapter_id": 26449, "verse_number": "२-१०९-३", "content_sanskrit": "कीर्तितं बलदेवेन विष्णुना चैव कीर्तितम् ।\nधर्मकामैश्च मुनिभिर्ऋषिभिश्चापि कीर्तितम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006449003, "chapter_id": 26449, "verse_number": "२-१०९-४", "content_sanskrit": "कर्हिचिद् रुक्मिणीपुत्रो हलिना संयुतो गृहे ।\nउपविष्टः प्रणम्याथ तमुवाच कृताञ्जलिः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006449004, "chapter_id": 26449, "verse_number": "२-१०९-५", "content_sanskrit": "प्रद्युम्न उवाच\nकृष्णानुज महाभाग रोहिणीतनय प्रभो ।\nकिंचित्स्तोत्रं मम ब्रूहि यज्जप्त्वा निर्भयोऽभवम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006449005, "chapter_id": 26449, "verse_number": "२-१०९-६", "content_sanskrit": "श्रीबलदेव उवाच\nसुरासुरगुरुर्ब्रह्मा पातु मां जगतः पतिः ।\nअथोङ्कारवषट्कारौ सावित्री विधयस्त्रयः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006449006, "chapter_id": 26449, "verse_number": "२-१०९-७", "content_sanskrit": "ऋचो यजूंषि सामानि छन्दांस्याथर्वणानि च ।\nचत्वारस्त्वखिला वेदाः सरहस्याः सविस्तराः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006449007, "chapter_id": 26449, "verse_number": "२-१०९-८", "content_sanskrit": "पुराणमितिहासश्चाखिलान्युपखिलानि च ।\nअङ्गान्युपाङ्गानि तथा व्याख्यातानि च पान्तु माम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006449008, "chapter_id": 26449, "verse_number": "२-१०९-९", "content_sanskrit": "पृथिवी वायुराकाशमापो ज्योतिश्च पञ्चमम् ।\nइन्द्रियाणि मनो बुद्धिस्तथा सत्त्वं रजस्तमः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006449009, "chapter_id": 26449, "verse_number": "२-१०९-१०", "content_sanskrit": "व्यानोदानौ समानश्च प्राणोऽपानश्च पञ्चमः ।\nवायवः सप्त चैवान्ये येष्वायत्तमिदं जगत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006449010, "chapter_id": 26449, "verse_number": "२-१०९-११", "content_sanskrit": "मरीचिरङ्गिरात्रिश्च पुलस्त्यः पुलहः क्रतुः ।\nभृगुर्वसिष्ठो भगवान् पान्तु ते मां महर्षयः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006449011, "chapter_id": 26449, "verse_number": "२-१०९-१२", "content_sanskrit": "कश्यपाद्याश्च मुनयश्चतुर्दश दिशो दश ।\nनरनारायणौ देवौ सगणौ पान्तु मां सदा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006449012, "chapter_id": 26449, "verse_number": "२-१०९-१३", "content_sanskrit": "रुद्राश्चैकादश प्रोक्ता आदित्या द्वादशैव तु ।\nअष्टौ च वसवो देवा अश्विनौ द्वौ प्रकीर्तितौ ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006449013, "chapter_id": 26449, "verse_number": "२-१०९-१४", "content_sanskrit": "ह्रीःश्रीर्लक्ष्मीः स्वधा पुष्टिर्मेधा तुष्टिः स्मृतिर्धृतिः ।\nअदितिर्दितिर्दनुश्चैव सिंहिका दैत्यमातरः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006449014, "chapter_id": 26449, "verse_number": "२-१०९-१५", "content_sanskrit": "हिमवान् हेमकूटश्च निषधः श्वेतपर्वतः ।\nऋषभः पारियात्रश्च विन्ध्यो वैडूर्यपर्वतः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006449015, "chapter_id": 26449, "verse_number": "२-१०९-१६", "content_sanskrit": "सह्योदयश्च मलयो मेरुमन्दरदर्दुराः ।\nक्रौञ्चकैलासमैनाकाः पान्तु मां धरणीधराः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006449016, "chapter_id": 26449, "verse_number": "२-१०९-१७", "content_sanskrit": "शेषश्च वासुकिश्चैव विशालाक्षश्च तक्षकः ।\nएलापत्रः शुक्लवर्णः कम्बलाश्वतरावुभौ ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006449017, "chapter_id": 26449, "verse_number": "२-१०९-१८", "content_sanskrit": "हस्तिभद्रः पिटरकः कर्कोटकधनंजयौ ।\nतथा पूरणकश्चैव नागश्च करवीरकः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006449018, "chapter_id": 26449, "verse_number": "२-१०९-१९", "content_sanskrit": "सुमनास्यो दधिमुखस्तथा शृङ्गारपिण्डकः ।\nमणिनागश्च भगवांस्त्रिषु लोकेषु विश्रुतः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006449019, "chapter_id": 26449, "verse_number": "२-१०९-२०", "content_sanskrit": "नागराडधिकर्णश्च तथा हारिद्रकोऽपरः ।\nएते चान्ये च बहवो ये चान्ये नानुकीर्तिताः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006449020, "chapter_id": 26449, "verse_number": "२-१०९-२१", "content_sanskrit": "भूधराः सत्यधर्माणः पान्तु मां भुजगेश्वराः ।\nसमुद्राः पान्तु चत्वारो गङ्गा च सरितां वरा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006449021, "chapter_id": 26449, "verse_number": "२-१०९-२२", "content_sanskrit": "सरस्वती चन्द्रभागा शतद्रुर्देविका शिवा ।\nद्वारावती विपाशा च सरयूर्यमुना तथा ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006449022, "chapter_id": 26449, "verse_number": "२-१०९-२३", "content_sanskrit": "कल्माषी च रथोष्मा च बाहुदा च हिरण्यदा ।\nप्लक्षा चेक्षुमती चैव स्रवन्ती च बृहद्रथा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006449023, "chapter_id": 26449, "verse_number": "२-१०९-२४", "content_sanskrit": "ख्याता चर्मण्वती चैव पुण्या चैव वधूसरा ।\nएताश्चान्याश्च सरितो याश्चान्या नानुकीर्तिताः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006449024, "chapter_id": 26449, "verse_number": "२-१०९-२५", "content_sanskrit": "उत्तरापथगामिन्यः सलिलैः स्नपयन्तु माम् ।\nवेणी गोदावरी सीता कावेरी कौङ्कणावती ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006449025, "chapter_id": 26449, "verse_number": "२-१०९-२६", "content_sanskrit": "कृष्णा वेणा शुक्तिमती तमसा पुष्पवाहिनी ।\nताम्रपर्णी ज्योतिरथा उत्फलोदुम्बरावती ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006449026, "chapter_id": 26449, "verse_number": "२-१०९-२७", "content_sanskrit": "नदी वैतरणी पुण्या विदर्भा नर्मदा शुभा ।\nवितस्ता भीमरथ्या च ऐला चैव महानदी ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006449027, "chapter_id": 26449, "verse_number": "२-१०९-२८", "content_sanskrit": "कालिन्दी गोमती पुण्या नदः शोणश्च विश्रुतः ।\nएताश्चान्याश्च वै नद्यो याश्चान्या न तु कीर्तिताः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006449028, "chapter_id": 26449, "verse_number": "२-१०९-२९", "content_sanskrit": "दक्षिणापथवाहिन्यः सलिलैः स्नपयन्तु माम् ।\nक्षिप्रा चर्मण्वती पुण्या मही शुभ्रवती तथा ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006449029, "chapter_id": 26449, "verse_number": "२-१०९-३०", "content_sanskrit": "सिन्धुर्वेत्रवती चैव भोजान्ता वनमालिका ।\nपूर्वभद्रा पराभद्रा ऊर्मिला च परद्रुमा ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006449030, "chapter_id": 26449, "verse_number": "२-१०९-३१", "content_sanskrit": "ख्याता वेत्रवती चैव चापदासीति विश्रुता ।\nप्रस्थावती कुण्डनदी नदी पुण्या सरस्वती ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006449031, "chapter_id": 26449, "verse_number": "२-१०९-३२", "content_sanskrit": "चित्रघ्नी चेन्दुमाला च तथा मधुमती नदी ।\nउमा गुरुनदी चैव तापी च विमलोदका ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006449032, "chapter_id": 26449, "verse_number": "२-१०९-३३", "content_sanskrit": "विमला विमलोदा च मत्तगङ्गा पयस्विनी ।\nएताश्चान्याश्च वै नद्यो याश्चान्या नानुकीर्तिताः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006449033, "chapter_id": 26449, "verse_number": "२-१०९-३४", "content_sanskrit": "ता मां समभिषिञ्चन्तु पश्चिमामाश्रिता दिशम् ।\nभागीरथी पुण्यजला प्राच्यां दिशि समाश्रिता ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006449034, "chapter_id": 26449, "verse_number": "२-१०९-३५", "content_sanskrit": "सा तु दहतु मे पापं कीर्तिता शम्भुना धृता ।\nप्रभासं च प्रयागं च नैमिषं पुष्कराणि च ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006449035, "chapter_id": 26449, "verse_number": "२-१०९-३६", "content_sanskrit": "गङ्गातीर्थं कुरुक्षेत्रं श्रीकण्ठं गौतमाश्रमम् ।\nरामह्रदं विनशनं रामतीर्थं तथैव च ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006449036, "chapter_id": 26449, "verse_number": "२-१०९-३७", "content_sanskrit": "गङ्गाद्वारं कनखलं सोमो वै यत्र चोत्थितः ।\nकपालमोचनं तीर्थं जम्बूमार्गं च विश्रुतम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006449037, "chapter_id": 26449, "verse_number": "२-१०९-३८", "content_sanskrit": "सुवर्णबिन्दुं विख्यातं तथा कनकपिङ्गलम् ।\nदशाश्वमेधिकं चैव पुण्याश्रमविभूषितम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006449038, "chapter_id": 26449, "verse_number": "२-१०९-३९", "content_sanskrit": "बदरी चैव विख्याता नरनारायणाश्रमः ।\nविख्यातं फल्गुतीर्थं च तीर्थं चन्द्रवटं तथा ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006449039, "chapter_id": 26449, "verse_number": "२-१०९-४०", "content_sanskrit": "कोकामुखं पुण्यतमं गङ्गासागरमेव च ।\nमगधेषु तपोदश्च गङ्गोद्भेदश्च विश्रुतः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006449040, "chapter_id": 26449, "verse_number": "२-१०९-४१", "content_sanskrit": "तीर्थान्येतानि पुण्यानि सेवितानि महर्षिभिः ।\nमां प्लावयन्तु सलिलैः यानि मे कीर्तितानि वै ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006449041, "chapter_id": 26449, "verse_number": "२-१०९-४२", "content_sanskrit": "सूकरं योगमार्गं च श्वेतद्वीपं तथैव च ।\nब्रह्मतीर्थं रामतीर्थं वाजिमेधशतोपमम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006449042, "chapter_id": 26449, "verse_number": "२-१०९-४३", "content_sanskrit": "धारासम्पातसंयुक्ता गङ्गा किल्बिषनाशिनी ।\nगङ्गा वैकुण्ठकेदारं सूकरोदभेदनं परम् ।\nतच्छापमोचनं तीर्थं पुनन्त्वेतानि किल्बिषात् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006449043, "chapter_id": 26449, "verse_number": "२-१०९-४४", "content_sanskrit": "धर्मार्थकामविषयो यशःप्राप्तिः शमो दमः ।\nवरुणेशोऽथ धनदो यमो नियम एव च ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006449044, "chapter_id": 26449, "verse_number": "२-१०९-४५", "content_sanskrit": "कालो नयः संनतिश्च क्रोधो मोहः क्षमा धृतिः ।\nविद्युतोऽभ्राण्यथौषध्यः प्रमादोन्मादविग्रहाः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006449045, "chapter_id": 26449, "verse_number": "२-१०९-४६", "content_sanskrit": "यक्षाः पिशाचा गन्धर्वाः किन्नराः सिद्धचारणाः ।\nनक्तंचराः खेचरिणो दंष्ट्रिणः प्रियविग्रहाः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006449046, "chapter_id": 26449, "verse_number": "२-१०९-४७", "content_sanskrit": "लम्बोदराश्च बलिनः पिङ्गाक्षा विश्वरूपिणः ।\nमरुतः सहपर्जन्याः कलात्रुटिलवाः क्षणाः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006449047, "chapter_id": 26449, "verse_number": "२-१०९-४८", "content_sanskrit": "नक्षत्राणि ग्रहाश्चैव ऋतवः शिशिरादयः ।\nमासाहोरात्रयश्चैव सूर्याचन्द्रमसौ तथा ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006449048, "chapter_id": 26449, "verse_number": "२-१०९-४९", "content_sanskrit": "आमोदश्च प्रमोदश्च प्रहर्षः शोक एव च ।\nरजस्तमस्तपः सत्यं शुद्धिर्बुद्धिर्धृतिः श्रुतिः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006449049, "chapter_id": 26449, "verse_number": "२-१०९-५०", "content_sanskrit": "रुद्राणी भद्रकाली च भद्रा ज्येष्ठा तु वारुणी ।\nभासी च कालिका चैव शाण्डिली चेति विश्रुताः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006449050, "chapter_id": 26449, "verse_number": "२-१०९-५१", "content_sanskrit": "आर्या कुहूः सिनीवाली भीमा चित्ररथी रतिः ।\nएकानंशा च कूष्माण्डी देवी कात्यायनी च या ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006449051, "chapter_id": 26449, "verse_number": "२-१०९-५२", "content_sanskrit": "लोहित्या जनमाता च देवकन्यास्तु याः स्मृताः ।\nगोनन्दा देवपत्नी च मां रक्षन्तु सबान्धवम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006449052, "chapter_id": 26449, "verse_number": "२-१०९-५३", "content_sanskrit": "नानाभरणवेशाश्च नानारूपाङ्किताननाः ।\nनानादेशविचारिण्यो नानाशस्त्रोपशोभिताः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006449053, "chapter_id": 26449, "verse_number": "२-१०९-५४", "content_sanskrit": "मेदोमज्जाप्रियाश्चैव मद्यमांसवसाप्रियाः ।\nमार्जारद्वीपिवक्त्राश्च गजसिंहनिभाननाः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006449054, "chapter_id": 26449, "verse_number": "२-१०९-५५", "content_sanskrit": "कङ्कवायसगृध्राणां क्रौञ्चतुल्याननास्तथा ।\nव्यालयज्ञोपवीताश्च चर्मप्रावरणास्तद्या ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006449055, "chapter_id": 26449, "verse_number": "२-१०९-५६", "content_sanskrit": "क्षतजोक्षितवक्त्राश्च खरभेरीसमस्वनाः ।\nमत्सराः क्रोधनाश्चैव प्रासादा रुचिरालयाः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006449056, "chapter_id": 26449, "verse_number": "२-१०९-५७", "content_sanskrit": "मत्तोन्मत्तप्रमत्ताश्च प्रहरन्त्यश्च धिष्ठिताः ।\nपिङ्गाक्षाः पिङ्गकेशाश्च ततोऽन्या लूनमूर्धजाः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006449057, "chapter_id": 26449, "verse_number": "२-१०९-५८", "content_sanskrit": "ऊर्ध्वकेश्यः कृष्णकेश्यः श्वेतकेश्यस्तथावराः ।\nनागायुतबलाश्चैव वायुवेगास्तथापराः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006449058, "chapter_id": 26449, "verse_number": "२-१०९-५९", "content_sanskrit": "एकहस्ता एकपादा एकाक्षाः पिङ्गला मताः ।\nबहुपुत्राल्पपुत्राश्च द्विपुत्राः पुत्रमण्डिकाः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006449059, "chapter_id": 26449, "verse_number": "२-१०९-६०", "content_sanskrit": "मुखमण्डी बिडाली च पूतना गन्धपूतना ।\nशीतवातोष्णवेताली रेवती ग्रहसंज्ञिताः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006449060, "chapter_id": 26449, "verse_number": "२-१०९-६१", "content_sanskrit": "प्रियहास्याः प्रियक्रोधाः प्रियवासाः प्रियंवदाः ।\nसुखप्रदाश्चासुखदाः सदा द्विजजनप्रियाः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006449061, "chapter_id": 26449, "verse_number": "२-१०९-६२", "content_sanskrit": "नक्तंचराः सुखोदर्काः सदा पर्वणि दारुणाः ।\nमातरो मातृवत्पुत्रं रञ्जन्तु मम नित्यशः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006449062, "chapter_id": 26449, "verse_number": "२-१०९-६३", "content_sanskrit": "पितामहमुखोद्भूता रौद्रा रुद्राङ्गसम्भवाः ।\nकुमारस्वेदजाश्चैव ज्वरा वै वैष्णवादयः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006449063, "chapter_id": 26449, "verse_number": "२-१०९-६४", "content_sanskrit": "महाभीमा महावीर्या दर्पोदभूता महाबलाः ।\nक्रोधनाक्रोधनाः क्रूराः सुरविग्रहकारिणः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006449064, "chapter_id": 26449, "verse_number": "२-१०९-६५", "content_sanskrit": "नक्तंचराः केसरिणो दंष्ट्रिणः प्रियविग्रहाः ।\nलम्बोदरा जघनिनः पिङ्गाक्षा विश्वरूपिणः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006449065, "chapter_id": 26449, "verse_number": "२-१०९-६६", "content_sanskrit": "शक्त्यृष्टिशूलपरिघप्रासचर्मासिपाणयः ।\nपिनाकवज्रमुसलब्रह्मदण्डायुधप्रियाः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006449066, "chapter_id": 26449, "verse_number": "२-१०९-६७", "content_sanskrit": "दण्डिनः कुण्डिनः शूरा जटामुकुटधारिणः ।\nवेदवेदाङ्गकुशला नित्ययज्ञोपवीतिनः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006449067, "chapter_id": 26449, "verse_number": "२-१०९-६८", "content_sanskrit": "व्यालापीडाः कुण्डलिनो वीराः केयूरधारिणः ।\nनानावस्वनसंवीताश्चित्रमाल्यानुलेपनाः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006449068, "chapter_id": 26449, "verse_number": "२-१०९-६९", "content_sanskrit": "गजाश्वोष्ट्रर्क्षमार्जारसिंहव्याघ्रनिभाननाः ।\nवराहोलूकगोमायुमृगाखुमहिषाननाः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006449069, "chapter_id": 26449, "verse_number": "२-१०९-७०", "content_sanskrit": "वामना विकटाः कुब्जाः कराला लूनमूर्धजाः ।\nसहस्रशतशश्चान्ये सहस्रजटधारिणः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006449070, "chapter_id": 26449, "verse_number": "२-१०९-७१", "content_sanskrit": "श्वेताः कैलाससंकाशाः केचिद् दिनकरप्रभाः ।\nकेचिज्जलदवर्णाभा नीलाञ्जनचयोपमाः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006449071, "chapter_id": 26449, "verse_number": "२-१०९-७२", "content_sanskrit": "एकपादा द्विपादाश्च तथा द्विशिरसोऽपरे ।\nनिर्मांसाः स्थूलजंघाश्च व्यादितास्या भयङ्कराः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006449072, "chapter_id": 26449, "verse_number": "२-१०९-७३", "content_sanskrit": "वापीतडागकूपेषु समुद्रेषु सरित्सु च ।\nश्मशानशैलवृक्षेषु शून्यागारनिवासिनः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006449073, "chapter_id": 26449, "verse_number": "२-१०९-७४", "content_sanskrit": "एते ग्रहाश्च सततं रक्षन्तु मम सर्वतः ।\nमहागणपतिर्नन्दी महाकालो महाबलः ।\nमाहेश्वरो वैष्णवश्च ज्वरौ लोकभयावहौ ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006449074, "chapter_id": 26449, "verse_number": "२-१०९-७५", "content_sanskrit": "ग्रामणीश्चैव गोपालो भृङ्गरीटिर्गणेश्वरः ।\nदेवश्च वामदेवश्च घण्टाकर्णः करंधमः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006449075, "chapter_id": 26449, "verse_number": "२-१०९-७६", "content_sanskrit": "श्वेतमोदः कपाली च जम्भकः शत्रुतापनः ।\nमज्जनोन्मज्जनौ चोभौ संतापनविलापनौ ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7006449076, "chapter_id": 26449, "verse_number": "२-१०९-७७", "content_sanskrit": "निजघासोऽघसश्चैव स्थूणाकर्णः प्रशोषणः ।\nउल्कामाली धमधमो ज्वालामाली प्रमर्दनः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7006449077, "chapter_id": 26449, "verse_number": "२-१०९-७८", "content_sanskrit": "संघट्टनः संकुटनः काष्ठभूतः शिवंकरः ।\nकूष्माण्डः कुम्भमूर्धा च रोचनो वैकृतो ग्रहः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7006449078, "chapter_id": 26449, "verse_number": "२-१०९-७९", "content_sanskrit": "अनिकेतः सुरारिघ्नः शिवश्चाशिव एव च ।\nक्षेमकः पिशिताशी च सुरारिर्हरिलोचनः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7006449079, "chapter_id": 26449, "verse_number": "२-१०९-८०", "content_sanskrit": "भीमको ग्राहकश्चैव तथैवाग्रमयो ग्रहः ।\nउपग्रहोऽर्यकश्चैव तथा स्कन्दग्रहोऽपरः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7006449080, "chapter_id": 26449, "verse_number": "२-१०९-८१", "content_sanskrit": "चपलोऽसमवेतालस्तामसः सुमहाकपिः ।\nहृदयोद्वर्तनश्चैडः कुण्डाशी कङ्कणप्रियः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7006449081, "chapter_id": 26449, "verse_number": "२-१०९-८२", "content_sanskrit": "हरिश्मश्रुर्गरुत्मन्तो मनोमारुतरंहसः ।\nपार्वत्या रोषसम्भूताः सहस्राणि शतानि च ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7006449082, "chapter_id": 26449, "verse_number": "२-१०९-८३", "content_sanskrit": "शक्तिमन्तो धृतिमन्तो ब्रह्मण्याः सत्यसङ्गराः ।\nसर्वकामापहन्तारो द्विषतां च मृधेमृधे ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7006449083, "chapter_id": 26449, "verse_number": "२-१०९-८४", "content_sanskrit": "रात्रावहनि दुर्गेषु कीर्तिताः सकलैर्गुणैः ।\nतेषां गणानां पतयः सगणाः पान्तु मां सदा ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7006449084, "chapter_id": 26449, "verse_number": "२-१०९-८५", "content_sanskrit": "नारदः पर्वतश्चैव गन्धर्वाप्सरसां गणाः ।\nपितरः कारणं कार्यमाधयो व्याधयस्तथा ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7006449085, "chapter_id": 26449, "verse_number": "२-१०९-८६", "content_sanskrit": "अगस्त्यो गालवो गार्ग्यः शक्तिर्धीम्यः पराशरः ।\nकृष्णात्रेयश्च भगवानसितो देवलो बलः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7006449086, "chapter_id": 26449, "verse_number": "२-१०९-८७", "content_sanskrit": "बृहस्पतिरुतथ्यश्च मार्कण्डेयः श्रुतश्रवाः ।\nद्वैपायनो विदर्भश्च जैमिनिर्माठरः कठः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7006449087, "chapter_id": 26449, "verse_number": "२-१०९-८८", "content_sanskrit": "विश्वामित्रो वसिष्ठश्च लोमशश्च महामुनिः ।\nउत्तङ्कश्चैव रैभ्यश्च पौलोमश्च द्वितस्त्रितः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7006449088, "chapter_id": 26449, "verse_number": "२-१०९-८९", "content_sanskrit": "ऋषिर्वै कालवृक्षीयो मुनिर्मेधातिथिस्तथा ।\nसारस्वतो यवक्रीतिः कुशिको गौतमस्तथा ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7006449089, "chapter_id": 26449, "verse_number": "२-१०९-९०", "content_sanskrit": "संवर्त ऋष्यशृङ्गश्च स्वस्त्यात्रेयो विभाण्डकः ।\nऋचीको जमदग्निश्च तथौर्वस्तपसां निधिः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7006449090, "chapter_id": 26449, "verse_number": "२-१०९-९१", "content_sanskrit": "भरद्वाजः स्थूलशिराः कश्यपः पुलहः क्रतुः ।\nबृहदग्निर्हरिश्मश्रुर्विजयः कण्व एव च ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7006449091, "chapter_id": 26449, "verse_number": "२-१०९-९२", "content_sanskrit": "वैतण्डी दीर्घतापश्च वेदगाथोंऽशुमाञ्छिवः ।\nअष्टावक्रो दधीचिश्च श्वेतकेतुस्तथैव च ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7006449092, "chapter_id": 26449, "verse_number": "२-१०९-९३", "content_sanskrit": "उद्दालकः क्षीरपाणिः शृङ्गी गौरमुखस्तथा ।\nअग्निवेश्यः शमीकश्च प्रमुचुर्मुमुचुस्तथा ॥ ९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7006449093, "chapter_id": 26449, "verse_number": "२-१०९-९४", "content_sanskrit": "एते चान्ये च ऋषयो बहवः शंसितव्रताः ।\nमुनयः शंसितात्मानो ये चान्ये नानुकीर्तिताः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7006449094, "chapter_id": 26449, "verse_number": "२-१०९-९५", "content_sanskrit": "त्रयोऽग्नयस्त्रयो वेदास्त्रैविद्याः कौस्तुभो मणिः ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7006449095, "chapter_id": 26449, "verse_number": "२-१०९-९६", "content_sanskrit": "उच्चैःश्रवा हयः श्रीमान् वैद्यो धन्वन्तरिर्हरिः ।\nअमृतं गौः सुपर्णश्च दधि गौराश्च सर्षपाः ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7006449096, "chapter_id": 26449, "verse_number": "२-१०९-९७", "content_sanskrit": "शुक्लाः सुमनसः कन्याः श्वेतच्छत्रं यवाक्षताः ।\nदूर्वा हिरण्यं गन्धाश्च वालव्यजनमेव च ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7006449097, "chapter_id": 26449, "verse_number": "२-१०९-९८", "content_sanskrit": "तथाप्रतिहतं चक्रं महोक्षश्चन्दनं विषम् ।\nश्वेतो वृषः करी मत्तः सिंहो व्याघ्रो हयो गिरिः ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7006449098, "chapter_id": 26449, "verse_number": "२-१०९-९९", "content_sanskrit": "पृथिवी चोद्धृता लाजा ब्राह्मणा मधु पायसम् ।\nस्वस्तिको वर्द्धमानश्च नन्द्यावर्तः प्रियङ्गवः ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7006449099, "chapter_id": 26449, "verse_number": "२-१०९-१००", "content_sanskrit": "श्रीफलं गोमयं मत्स्यो दुन्दुभिः पटहस्वनः ।\nऋषिपत्न्यश्च कन्याश्च श्रीमद् भद्रासनं धनुः ।\nरोचना रुचकश्चैव नदीनां संगमोदकम् ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7006449100, "chapter_id": 26449, "verse_number": "२-१०९-१०१", "content_sanskrit": "सुपर्णाः शतपत्राश्च चकोरा जीवजीवकाः ।\nनन्दीमुखो मयूरश्च बद्धमुक्तामणिध्वजाः ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7006449101, "chapter_id": 26449, "verse_number": "२-१०९-१०२", "content_sanskrit": "आयुधानि प्रशस्तानि कार्यसिद्धिकराणि च ।\nपुण्यं वै विगतक्लेशं श्रीमद् वै मङ्गलान्वितम् ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7006449102, "chapter_id": 26449, "verse_number": "२-१०९-१०३", "content_sanskrit": "रामेणोदाहृतं पूर्वमायुःश्रीजयकाङ्क्षिणा ।\nय इदं श्रावयेद् विद्वांस्तथैव शृणुयान्नरः ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7006449103, "chapter_id": 26449, "verse_number": "२-१०९-१०४", "content_sanskrit": "मङ्गलाष्टशतं स्नातो जपन् पर्वणि पर्वणि ।\nवधबन्धपरिक्लेशं व्याधिशोकपराभवम् ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7006449104, "chapter_id": 26449, "verse_number": "२-१०९-१०५", "content_sanskrit": "न च प्राप्नोति वैकल्यं परत्रेह च शर्मदम् ।\nधन्यं यशस्यमायुष्यं पवित्रं वेदसम्मितम् ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7006449105, "chapter_id": 26449, "verse_number": "२-१०९-१०६", "content_sanskrit": "श्रीमत्स्वर्ग्यं सदा पुण्यमपत्यजननं शिवम् ।\nशुभं क्षेमकरं नॄणां मेधाजननमुत्तमम् ।\nसर्वरोगप्रशमनं स्वकीर्तिकुलवर्धनम् ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7006449106, "chapter_id": 26449, "verse_number": "२-१०९-१०७", "content_sanskrit": "श्रद्दधानो दयोपेतो यः पठेदात्मवान्नरः ।\nसर्वपापविशुद्धात्मा लभते च शुभां गतिम् ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}]