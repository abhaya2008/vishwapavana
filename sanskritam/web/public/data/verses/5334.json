[{"id": 2203329, "chapter_id": 5334, "verse_number": "", "content_sanskrit": "स्कन्दः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2203330, "chapter_id": 5334, "verse_number": "१", "content_sanskrit": "ममाप्यनुमतो धर्मस्तं शृणुध्वं समाहिताः ।\nनीलषण्डस्य शृङ्गाभ्यां गृहीत्वा मृत्तिकां तु यः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2203331, "chapter_id": 5334, "verse_number": "२", "content_sanskrit": "अभिषेकं त्र्यहं कुर्यात् तस्य धर्मं निबोधत ।\nशोधयेदशुभं सर्वमाधिपत्यं परत्र च\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2203332, "chapter_id": 5334, "verse_number": "३", "content_sanskrit": "यावच्च जायते मर्त्यस्तावच्छूरो भविष्यति ।\nइदं चाप्यपरं गुह्यं सरहस्यं निबोधत\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2203333, "chapter_id": 5334, "verse_number": "४", "content_sanskrit": "प्रगृह्यौदुम्बरं पात्रं पक्वान्नं मधुना सह ।\nसोमस्योत्तिष्ठमानस्य पौर्णमास्यां बलिं हरेत्\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2203334, "chapter_id": 5334, "verse_number": "५", "content_sanskrit": "तस्य धर्मफलं नित्यं श्रद्दधाना निबोधत ।\nसाध्या रुद्रास्तथाऽऽदित्या विश्वेदेवास्तथाऽश्विनौ\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2203335, "chapter_id": 5334, "verse_number": "६", "content_sanskrit": "मरुतो वसवश्चैव प्रतिगृह्णन्ति तं बलिम् ।\nसोमश्च वर्धते तेन समुद्रश्च महोदधिः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2203336, "chapter_id": 5334, "verse_number": "७", "content_sanskrit": "एष धर्मो मयोद्दिष्टः सरहस्यः सुखावहः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2203337, "chapter_id": 5334, "verse_number": "", "content_sanskrit": "विष्णुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2203338, "chapter_id": 5334, "verse_number": "८", "content_sanskrit": "धर्मगुह्यानि सर्वाणि देवतानां महात्मनाम् ।\nऋषीणां चैव गुह्यानि यः पठेदाह्निकं सदा\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2203339, "chapter_id": 5334, "verse_number": "९", "content_sanskrit": "शृणुयाद् वाऽनसूयुर्यः श्रद्दधानः समाहितः ।\nनास्य विघ्नः प्रभवति भयं चास्य न विद्यते\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2203340, "chapter_id": 5334, "verse_number": "१०", "content_sanskrit": "ये च धर्माः शुभाः पुण्याः सरहस्या उदाहृताः ।\nतेषां धर्मफलं तस्य यः पठेत जितेन्द्रियः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2203341, "chapter_id": 5334, "verse_number": "११", "content_sanskrit": "नास्य पापं प्रभवति न च पापेन लिप्यते ।\nपठेद् वा श्रावयेद् वाऽपि श्रुत्वा वा लभते फलम् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2203342, "chapter_id": 5334, "verse_number": "१२", "content_sanskrit": "भुञ्जते पितरो देवा हव्यं कव्यमथाक्षयम् ।\nश्रावयंश्चापि विप्रेन्द्रान् पर्वसु प्रयतो नरः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2203343, "chapter_id": 5334, "verse_number": "१३", "content_sanskrit": "ऋषीणां देवतानां च पितॄणां चैव नित्यदा ।\nभवत्यभिमतः श्रीमान् धर्मेषु प्रयतः सदा\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2203344, "chapter_id": 5334, "verse_number": "१४", "content_sanskrit": "कृत्वाऽपि पापकं कर्म महापातकवर्जितम् ।\nरहस्यधर्मं श्रुत्वेमं सर्वपापैः प्रमुच्यते\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2203345, "chapter_id": 5334, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2203346, "chapter_id": 5334, "verse_number": "१५", "content_sanskrit": "एतद् धर्मरहस्यं वै देवतानां नराधिप ।\nव्यासोद्दिष्टं मया प्रोक्तं सर्वदेवनमस्कृतम्\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2203347, "chapter_id": 5334, "verse_number": "१६", "content_sanskrit": "पृथिवी रत्नसम्पूर्णा ज्ञानं चेदमनुत्तमम् ।\nइदमेव ततः श्राव्यमिति मन्येत धर्मवित्\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2203348, "chapter_id": 5334, "verse_number": "१७", "content_sanskrit": "नाश्रद्दधानाय न नास्तिकाय न नष्टधर्माय न निर्गुणाय ।\nन हेतुदुष्टाय गुरुद्विषे वा नानात्मभूताय निवेद्यमेतत्\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2203349, "chapter_id": 5334, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे सर्वरहस्यं नाम पञ्चाशीत्युत्तरशततमोऽध्यायः ॥१८५॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]