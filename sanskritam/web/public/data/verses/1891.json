[{"id": 2040296, "chapter_id": 1891, "verse_number": "५-१३६-०x", "content_sanskrit": "मातोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2040297, "chapter_id": 1891, "verse_number": "५-१३६-१", "content_sanskrit": "नैव राज्ञा दरः कार्यो जातु कस्यांचिदापदि।\nअथ चेदपि दीर्णः स्यान्नैव वर्तेत दीर्णवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2040298, "chapter_id": 1891, "verse_number": "५-१३६-२", "content_sanskrit": "दीर्णं हि दृष्ट्वा राजानं सर्वमेवानुदीर्यते।\nराष्ट्रं बलममात्याश्च पृथक्कुर्वन्ति ते मतीः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2040299, "chapter_id": 1891, "verse_number": "५-१३६-३", "content_sanskrit": "शत्रुनेके प्रपद्यन्ते प्रजहत्यपरे पुनः ।\nअन्ये तु प्रजिहीर्षन्ति ये पुरस्ताद्विमानिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2040300, "chapter_id": 1891, "verse_number": "५-१३६-४", "content_sanskrit": "य एवात्यन्तसुहृदस्त एनं पर्युपासते।\nअशक्तयः स्वस्तिकामा बद्धवत्सा इला इव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2040301, "chapter_id": 1891, "verse_number": "५-१३६-५", "content_sanskrit": "शोचन्तमनुशोचन्ति पतितानिव बान्धवान् ।\nअपि ते पूजिताः पूर्वमपि ते सुहृदो मताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2040302, "chapter_id": 1891, "verse_number": "५-१३६-६", "content_sanskrit": "ये राष्ट्रमभिमन्यन्ते राज्ञो व्यसनमीयुषः ।\nमा दीदरस्त्वं सुहृदो मा त्वां दीर्णं प्रहासिषुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2040303, "chapter_id": 1891, "verse_number": "५-१३६-७", "content_sanskrit": "प्रभावं पौरुषं बुद्धिं जिज्ञासन्त्या मया तव।\nविदधत्या समाश्वासमुक्तं तेजोविवृद्धये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2040304, "chapter_id": 1891, "verse_number": "५-१३६-८", "content_sanskrit": "यदेतत्संविजानासि यदि सम्यग्ब्रवीम्यहम्।\nकृत्वा सौम्यमिवात्मानं जायायोत्तिष्ठ सञ्जय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2040305, "chapter_id": 1891, "verse_number": "५-१३६-९", "content_sanskrit": "अस्ति नः कोशनिचयो महानविदितस्तव।\nतमहं वेद नान्यस्तमुपसंपादयामि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2040306, "chapter_id": 1891, "verse_number": "५-१३६-१०", "content_sanskrit": "सन्ति नैकशता भूयः सुहृदस्तव सञ्जय ।\nसुखदुःखसहा वीर संग्रामादनिवर्तिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2040307, "chapter_id": 1891, "verse_number": "५-१३६-११", "content_sanskrit": "तादृशा हि सहाया वै पुरुषस्य बुभूषतः।\nइष्टं जिहीर्षतः किंचित्सचिवाः शत्रुकर्शन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2040308, "chapter_id": 1891, "verse_number": "५-१३६-१२", "content_sanskrit": "तस्यास्त्वीदृशकं वाक्यं श्रुत्वापि स्वल्पचेतसः ।\nतमस्त्वपागमत्तस्य सुचित्रार्थपदाक्षरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2040309, "chapter_id": 1891, "verse_number": "५-१३६-१३x", "content_sanskrit": "पुत्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2040310, "chapter_id": 1891, "verse_number": "५-१३६-१३", "content_sanskrit": "उदके नौरियं धार्या वक्तव्यं प्रवणे मया।\nयस्य मे भवती नेत्री भविष्यद्भूतिदर्शिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2040311, "chapter_id": 1891, "verse_number": "५-१३६-१४", "content_sanskrit": "अहं हि वचनं त्वत्तः शुश्रूषुरपरापरम् ।\nकिञ्चित्किञ्चित्प्रतिवदंस्तूष्णीमासं मुहुर्मुहुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2040312, "chapter_id": 1891, "verse_number": "५-१३६-१५", "content_sanskrit": "अतृप्यन्नमृतस्येव कृच्छ्राल्लब्धस्य बान्धवात्।\nउद्यच्छाम्येष शत्रूणां नियमार्थं जायय च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2040313, "chapter_id": 1891, "verse_number": "५-१३६-१६x", "content_sanskrit": "कुन्त्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2040314, "chapter_id": 1891, "verse_number": "५-१३६-१६", "content_sanskrit": "सदश्च इव स क्षिप्तः प्रणुन्नो वाक्यसायकैः।\nतच्चकार तथा सर्वं यथावदनुशासनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2040315, "chapter_id": 1891, "verse_number": "५-१३६-१७", "content_sanskrit": "इदमुद्धर्षणं भीमं तेजोवर्धनमुत्तमम् ।\nराजानं श्रावयेन्मन्त्री सीदन्तं शत्रुपीडितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2040316, "chapter_id": 1891, "verse_number": "५-१३६-१८", "content_sanskrit": "जयो नामेतिहासोऽयं श्रोतव्यो विजिगीषुणा।\nमहीं विजयते क्षिप्रं श्रुत्वा शत्रूंश्च मर्दति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2040317, "chapter_id": 1891, "verse_number": "५-१३६-१९", "content_sanskrit": "इदं पुंसवनं चैव वीराजननमेव च।\nअभीक्ष्णं गर्भिणी श्रुत्वा ध्रुवं वीरं प्रजायते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2040318, "chapter_id": 1891, "verse_number": "५-१३६-२०", "content_sanskrit": "विद्याशूरं तपःशूरं दानशूरं तपस्विनम् ।\nब्राह्मया श्रिया दीप्यमानं साधुवादे च संमतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2040319, "chapter_id": 1891, "verse_number": "५-१३६-२१", "content_sanskrit": "अर्चिष्मन्तं बलोपेतं महाभागं महारथम् ।\nधृतिमन्तमनाधृष्यं जेतारमपराजितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2040320, "chapter_id": 1891, "verse_number": "५-१३६-२२", "content_sanskrit": "नियन्तारमसाधूनां गोप्तारं धर्मचारिणाम् ।\nईदृशं क्षत्रिया सूते वीरं सत्यपराक्रमम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2040321, "chapter_id": 1891, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि षट्त्रिंशदधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]