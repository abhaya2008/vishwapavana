[{"id": 2138117, "chapter_id": 3992, "verse_number": "१", "content_sanskrit": "ततः कदाचिद् दुर्वासाः सुखासीनांस्तु पाण्डवान् ।\nभुक्त्वा चावस्थितां कृष्णां ज्ञात्वा तस्मिन् वने मुनिः ।\nअभ्यागच्छत् परिवृतः शिष्यैरयुतसम्मितैः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2138118, "chapter_id": 3992, "verse_number": "२", "content_sanskrit": "दृष्ट्वाऽऽयान्तं तमतिथिं स च राजा युधिष्ठिरः ।\nजगामाभिमुखः श्रीमान् सह भ्रातृभिरच्युतः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2138119, "chapter_id": 3992, "verse_number": "३", "content_sanskrit": "तस्मै बद्ध्वाञ्जलिं सम्यगुपवेश्य वरासने ।\nविधिवत् पूजयित्वा तमातिथ्येन न्यमन्त्रयत्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2138120, "chapter_id": 3992, "verse_number": "४", "content_sanskrit": "आह्निकं भगवन् कृत्वा शीघ्रमेहीति चाब्रवीत् ।\nजगाम च मुनिः सोऽपि स्नातुं शिष्यैः सहानघः ।\nभोजयेत् सहशिष्यं मां कथमित्यविचिन्तयन्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2138121, "chapter_id": 3992, "verse_number": "५", "content_sanskrit": "न्यमज्जत् सलिले चापि मुनिसङ्घः समाहितः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2138122, "chapter_id": 3992, "verse_number": "६", "content_sanskrit": "एतस्मिन्नन्तरे राजन् द्रौपदी योषितां वरा ।\nचिन्तामवाप परमामन्नहेतोः पतिव्रता\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2138123, "chapter_id": 3992, "verse_number": "७", "content_sanskrit": "सा चिन्तयन्ती च यदा नान्नहेतुमविन्दत ।\nमनसा चिन्तयामास कृष्णं कंसनिषूदनम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2138124, "chapter_id": 3992, "verse_number": "८", "content_sanskrit": "कृष्णकृष्ण महाबाहो देवकीनन्दनाव्यय ।\nवासुदेव जगन्नाथ प्रणतार्तिविनाशन\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2138125, "chapter_id": 3992, "verse_number": "९", "content_sanskrit": "विश्वात्मन् विश्वजनक विश्वहर्तः प्रभोऽव्यय ।\nप्रपन्नपाल गोपाल प्रजापाल परात्पर ।\nआकूतीनां च चित्तीनां प्रवर्तक नताऽस्मि ते\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2138126, "chapter_id": 3992, "verse_number": "१०", "content_sanskrit": "वरेण्य वरदानन्त अगतीनां गतिप्रद ।\nपुराणपुरुष प्राणमनोवृत्त्याद्यगोचर\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2138127, "chapter_id": 3992, "verse_number": "११", "content_sanskrit": "सर्वाध्यक्ष पराध्यक्ष त्वामहं शरणं गता ।\nपाहि मां कृपया देव शरणागतवत्सल\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2138128, "chapter_id": 3992, "verse_number": "१२", "content_sanskrit": "नीलोत्पलदलश्याम पद्मगर्भारुरेक्षण ।\nपीताम्बरपरीधान लसत् कौस्तुभभूषण\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2138129, "chapter_id": 3992, "verse_number": "१३", "content_sanskrit": "त्वमादिरन्तो भूतानां त्वमेव च परायणम् ।\nपरात्परतरं ज्योतिर्विश्वात्मा सर्वतोमुखः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2138130, "chapter_id": 3992, "verse_number": "१४", "content_sanskrit": "त्वामेवाहुः परं बीजं निधानं सर्वसम्पदाम् ।\nत्वया नाथेन देवेश सर्वापद्भ्यो भयं न हि\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2138131, "chapter_id": 3992, "verse_number": "१५", "content_sanskrit": "दुःशासनादहं पूर्वं सभायां मोचिता यथा ।\nतथैव सङ्कटादस्मान्मामुद्धर्तुमिहार्हसि\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2138132, "chapter_id": 3992, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2138133, "chapter_id": 3992, "verse_number": "१६", "content_sanskrit": "एवं स्तुतस्तदा देवः कृष्णया भक्तवत्सलः ।\nद्रौपद्याः सङ्कटं ज्ञात्वा देवदेवो जगत्पतिः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2138134, "chapter_id": 3992, "verse_number": "१७", "content_sanskrit": "पार्श्वस्थां शयने त्यक्त्वा रुग्मिणीं केशवः प्रभुः ।\nतत्राजगाम त्वरितो ह्यचिन्त्यगतिरीश्वरः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2138135, "chapter_id": 3992, "verse_number": "१८", "content_sanskrit": "ततस्तं द्रौपदी दृष्ट्वा प्रणम्य परया मुदा ।\nअब्रवीद् वासुदेवाय मुनेरागमनादिकम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2138136, "chapter_id": 3992, "verse_number": "१९", "content_sanskrit": "ततस्तामब्रवीत् कृष्णः क्षुधितोऽस्मि भृशातुरः ।\nशीघ्रं भोजय मां कृष्णे पश्चात् सर्वं करिष्यसि\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2138137, "chapter_id": 3992, "verse_number": "२०", "content_sanskrit": "निशम्य तद्वचः कृष्णा लज्जिता वाक्यमब्रवीत् ।\nस्थाल्यां भास्करदत्तायामन्नं मद्भोजनावधि\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2138138, "chapter_id": 3992, "verse_number": "२१", "content_sanskrit": "भुक्तवत्यस्म्यहं देव तस्मादन्नं न विद्यते ।\nततः प्रोवाच भगवान् कृष्णां कमललोचनः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2138139, "chapter_id": 3992, "verse_number": "२२", "content_sanskrit": "कृष्णे न नर्मकालोऽयं क्षुच्छ्रमेणातुरे मयि ।\nशीघ्रं गच्छ मम स्थालीमानयित्वा प्रदर्शय\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2138140, "chapter_id": 3992, "verse_number": "समाप्तिः", "content_sanskrit": "इति निर्बन्धतः स्थालीमानाय्य स यदूद्वहः ।\nस्थाल्यां कण्ठेऽथ संलग्नं शाकान्नं वीक्ष्य केशवः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2138141, "chapter_id": 3992, "verse_number": "२४", "content_sanskrit": "उपयुज्याब्रवीदेनामनेन हरिरीश्वरः ।\nविश्वात्मा प्रीयतां देवस्तुष्टश्चास्त्विति यज्ञभुक्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2138142, "chapter_id": 3992, "verse_number": "२५", "content_sanskrit": "आकारय मुनीन् शीघ्रं भोजनायेति चाब्रवीत् ।\nभीमसेनं महाबाहुः कृष्णः क्लेशविनाशनः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2138143, "chapter_id": 3992, "verse_number": "२६", "content_sanskrit": "ततो जगाम त्वरितो भीमसेनो महायशाः ।\nआकारितुं तु तान् सर्वान् भोजनार्थं नृपोत्तम ।\nस्नातुं गतान् देवनद्यां दुर्वासःप्रभृतीन् मुनीन्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2138144, "chapter_id": 3992, "verse_number": "२७", "content_sanskrit": "ते चावतीर्णाः सलिले कृतवन्तोऽघमर्षणम् ।\nदृष्ट्वोद्गारान् सान्नरसांस्तृप्त्या परमया युताः ।\nउत्तीर्य सलिलात् तस्माद् दृष्टवन्तः परस्परम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2138145, "chapter_id": 3992, "verse_number": "२८", "content_sanskrit": "दुर्वाससमभिप्रेक्ष्य ते सर्वे मुनयोऽब्रुवन् ।\nराज्ञा हि कारयित्वाऽन्नं वयं स्नातुं समागताः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2138146, "chapter_id": 3992, "verse_number": "२९", "content_sanskrit": "आकण्ठतृप्ता विप्रर्षे किंस्विद् भुञ्जामहे वयम् ।\nवृथा पाकः कृतोस्माभिस्तत्र किं करवामहे\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2138147, "chapter_id": 3992, "verse_number": "", "content_sanskrit": "दुर्वासा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2138148, "chapter_id": 3992, "verse_number": "३०", "content_sanskrit": "वृथा पाकेन राजर्षेरपराधः कृतो महान् ।\nमाऽस्मानधाक्षुर्दृष्ट्वैव पाण्डवाः क्रूरचक्षुषः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2138149, "chapter_id": 3992, "verse_number": "३१", "content_sanskrit": "स्मृत्वाऽनुभावं राजर्षेरम्बरीषस्य धीमतः ।\nबिभेमि सुतरां विप्रा हरिपादाश्रयात् जनात्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2138150, "chapter_id": 3992, "verse_number": "३२", "content_sanskrit": "पाण्डवाश्च महात्मानः सर्वे धर्मपरायणाः ।\nशूराश्च कृतविद्याश्च व्रतिनस्तपसि स्थिताः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2138151, "chapter_id": 3992, "verse_number": "३३", "content_sanskrit": "सदाचाररता नित्यं वासुदेवपरायणाः ।\nक्रुद्धास्ते निर्दहेयुर्वै तूलराशिमिवानलः ।\nततः एतानपृष्ट्वैव शिष्याः शीघ्रं पलायत\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2138152, "chapter_id": 3992, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2138153, "chapter_id": 3992, "verse_number": "३४", "content_sanskrit": "इत्युक्तास्ते द्विजाः सर्वे मुनिना गुरुणा तदा ।\nपाण्डवेभ्यो भृशं भीता दुद्रुवुस्ते दिशो दश\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2138154, "chapter_id": 3992, "verse_number": "३५", "content_sanskrit": "भीमसेनो देवनद्यामपश्यन् मुनिसत्तमान् ।\nतीर्थेष्वितस्ततस्तस्या विचचार गवेषयन्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2138155, "chapter_id": 3992, "verse_number": "३६", "content_sanskrit": "तत्रस्थेभ्यस्तापसेभ्यः श्रुत्वा तांश्चैव विद्रुतान् ।\nयुधिष्ठिरमथाभ्येत्य तं वृत्तान्तं न्यवेदयत्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2138156, "chapter_id": 3992, "verse_number": "३७", "content_sanskrit": "ततस्ते पाण्डवाः सर्वे प्रत्यागमनकाङ्क्षिणः ।\nप्रतीक्षन्तः कियत् कालं जितात्मानोऽवतस्थिरे\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2138157, "chapter_id": 3992, "verse_number": "३८", "content_sanskrit": "निशीथेऽभ्येत्य चाकस्मादस्मान् स च्छलयिष्यति ।\nकथं च निस्तरेमास्मात् कृच्छ्राद् दैवोपपादितात्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2138158, "chapter_id": 3992, "verse_number": "समाप्तिः", "content_sanskrit": "इति चिन्तापरान् दृष्ट्वा निःश्वसन्तो मुहुर्मुहुः ।\nउवाच वचनं श्रीमान् कृष्णः प्रत्यक्षतां गतः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2138159, "chapter_id": 3992, "verse_number": "४०", "content_sanskrit": "भवतामापदं ज्ञात्वा ऋषेः परमकोपनात् ।\nद्रौपद्या चिन्तितः पार्था अहं सत्वरमागतः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2138160, "chapter_id": 3992, "verse_number": "४१", "content_sanskrit": "न भयं विद्यते तस्मादृषेर्दुर्वाससोऽल्पकम् ।\nतेजसा भवतां भीतः पूर्वमेव पलायितः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2138161, "chapter_id": 3992, "verse_number": "४२", "content_sanskrit": "धर्मनित्यास्तु ये केचिन्न ते सीदन्ति कर्हिचित् ।\nआपृच्छे वो गमिष्यामि नियतं भद्रमस्तु वः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2138162, "chapter_id": 3992, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2138163, "chapter_id": 3992, "verse_number": "४३", "content_sanskrit": "श्रुत्वेरितं केशवस्य बभूवुः स्वस्थमानसाः ।\nद्रौपद्या सहिताः पार्थास्तमूचुर्विगतज्वराः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2138164, "chapter_id": 3992, "verse_number": "४४", "content_sanskrit": "त्वया नाथेन गोविन्द दुस्तरामापदं विभो ।\nतीर्णाः प्लवमिवासाद्य मज्जमाना महार्णवे\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2138165, "chapter_id": 3992, "verse_number": "४५", "content_sanskrit": "स्वस्ति साधय भद्रं ते इत्याज्ञातो ययौ पुरीम्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2138166, "chapter_id": 3992, "verse_number": "४६", "content_sanskrit": "पाण्डवाश्च महाभागा द्रौपद्या सहिताः प्रभो ।\nऊषुः प्रहृष्टमनसो विहरन्तो वनाद् वनम् ।\nइति तेऽभिहितं राजन् यत्पृष्टोऽहमिह त्वया\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2138167, "chapter_id": 3992, "verse_number": "४७", "content_sanskrit": "एवंविधान्यलीकानि धार्तराष्ट्रैर्दुरात्मभिः ।\nपाण्डवेषु वनस्थेषु प्रयुक्तानि वृथाऽभवन्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2138168, "chapter_id": 3992, "verse_number": "", "content_sanskrit": "॥ इति द्वितीयोऽध्यायः ॥\n******\n– – – – –", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2138169, "chapter_id": 3992, "verse_number": "", "content_sanskrit": "॥ श्री मध्वेशार्पणमस्तु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]