[{"id": 2093472, "chapter_id": 2997, "verse_number": "१३-१२७-१", "content_sanskrit": "शुक उवाच।\nकेन वर्णविभागेन विज्ञेया कपिला भवेत्।\nकति वा लक्षणान्यस्या दृष्टानि मुनिभिः पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2093473, "chapter_id": 2997, "verse_number": "१३-१२७-२x", "content_sanskrit": "श्रीव्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2093474, "chapter_id": 2997, "verse_number": "१३-१२७-२", "content_sanskrit": "शृणु तात यथा गोषु विज्ञेया कपिला भवेत्।\nनेत्रयोः शृङ्गयोश्चैव खुरेषु वृषणेषु च।\nकर्णतो घ्राणतश्चापि षड्विधाः कपिलाः स्मृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2093475, "chapter_id": 2997, "verse_number": "१३-१२७-३", "content_sanskrit": "एतेषां लक्षणानां तु यद्येकमपि दृश्यते।\nकपिलां तां विजानीयादेवमाहुर्मनीषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2093476, "chapter_id": 2997, "verse_number": "१३-१२७-४", "content_sanskrit": "आग्नेयी नेत्रकपिला खुरैर्माहेश्वरी भवेत्।\nग्रीवायां वैष्णवी ज्ञेया पूष्णो घ्राणादजायत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2093477, "chapter_id": 2997, "verse_number": "१३-१२७-५", "content_sanskrit": "कर्णतस्तु वसन्तेन स्वयोनिमभिजायते।\nगायत्र्याश्च वृषणयोरुत्पत्तिः षड्गुणा स्मृता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2093478, "chapter_id": 2997, "verse_number": "१३-१२७-६", "content_sanskrit": "एवं गावश्च विप्राश्च गायत्री सत्यमेव च।\nवसन्तश्च सुवर्णश्च एकतः समजायत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2093479, "chapter_id": 2997, "verse_number": "१३-१२७-७", "content_sanskrit": "नेत्रयोः कपिलां यस्तु वाहयेत दुहेत वा।\nस पापकर्मा नरकं प्रतिष्ठां प्रतिपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2093480, "chapter_id": 2997, "verse_number": "१३-१२७-८", "content_sanskrit": "नरकाद्विप्रमुक्तस्तु तिर्यग्योनिं निषेवते।\nयदा लभेत मानुष्यं जात्यन्धो जायते नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2093481, "chapter_id": 2997, "verse_number": "१३-१२७-९", "content_sanskrit": "शृङ्गयोः कपिलां यस्तु वाहयेत दुहेत वा।\nतिर्यग्योनिं स लभते जायमानः पुनः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2093482, "chapter_id": 2997, "verse_number": "१३-१२७-१०", "content_sanskrit": "खुरेषु कपिलां यस्तु वाहयेत दुहेत वा।\nतमस्यपारे मज्जेत धनहीनो नराधमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2093483, "chapter_id": 2997, "verse_number": "१३-१२७-११", "content_sanskrit": "कपिलां वालधानेषु वाहयेत दुहेत वा।\nनिराश्रयः सदा चैव जायते यदि चेत्कृमिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2093484, "chapter_id": 2997, "verse_number": "१३-१२७-१२", "content_sanskrit": "कर्णेन कपिलां यस्तु जानन्नप्युपजीवति।\nसहस्रशः शुचिर्भुत्वा मानुष्यं प्राप्नुयादथ।\nचण्डालः पापयोनिश्च जायते स नराधमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2093485, "chapter_id": 2997, "verse_number": "१३-१२७-१३", "content_sanskrit": "घ्राणेन कपिलां यस्तु प्रमादादुपजीवति।\nसोऽपि वर्षसहस्राणि तिर्यग्योनौ प्रजायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2093486, "chapter_id": 2997, "verse_number": "१३-१२७-१४", "content_sanskrit": "व्याधिग्रस्तो जडो रोगी भवेन्मानुष्यमागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2093487, "chapter_id": 2997, "verse_number": "१३-१२७-१५", "content_sanskrit": "मधुसर्पिस्सुगन्धास्तु कपिलाः शास्त्रतः स्मृताः।\nएताः समुपजीवेत सोऽपि तिर्यक्षु जायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2093488, "chapter_id": 2997, "verse_number": "१३-१२७-१६", "content_sanskrit": "स्थावरत्वमनुप्राप्तो यदि मानुष्यतां लभेत्।\nअल्पायुः स भवेज्जातो हीनवर्णकुलोद्भवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2093489, "chapter_id": 2997, "verse_number": "१३-१२७-१७", "content_sanskrit": "ये तु पापा ह्यसूयन्ते कपिलां वाहयन्ति च।\nनिरयेषु प्रतिष्ठन्ते यावदाभूतसम्प्लवम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2093490, "chapter_id": 2997, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि सप्तविंशत्यधिकशततमोऽध्यायः॥ १२७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]