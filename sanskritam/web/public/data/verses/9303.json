[{"id": 40019126, "chapter_id": 9303, "verse_number": "1", "content_sanskrit": "तेरावणवधंदृष्टवादेवगन्धर्वदानवाः । जग्मुस्स्वैस्वैर्विमानैस्तेकथयन्तश्शुभाःकथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40019127, "chapter_id": 9303, "verse_number": "2", "content_sanskrit": "रावणस्यवधंघोरंराघवस्यपराक्रमम् । सुयुद्धंवानराणां च सुग्रीवस्य च मन्त्रितम् ॥ अनुरागं च वीर्यं च सौमित्रेर्लक्ष्मणस्य च । पतिव्रतात्वंसीतायाहनूमतिपराक्रमम् ॥ कथयन्तोमहाभागाजग्मुर्हष्टायथागतम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40019128, "chapter_id": 9303, "verse_number": "3", "content_sanskrit": "रावणस्यवधंघोरंराघवस्यपराक्रमम् । सुयुद्धंवानराणां च सुग्रीवस्य च मन्त्रितम् ॥ अनुरागं च वीर्यं च सौमित्रेर्लक्ष्मणस्य च । पतिव्रतात्वंसीतायाहनूमतिपराक्रमम् ॥ कथयन्तोमहाभागाजग्मुर्हष्टायथागतम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40019129, "chapter_id": 9303, "verse_number": "4", "content_sanskrit": "राघवस्तुरथंदिव्यमिन्द्रदत्तंशिखिप्रभम् ॥ अनुज्ञायमहाभागोर्मातलिंप्रत्यपूजयत् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40019130, "chapter_id": 9303, "verse_number": "5", "content_sanskrit": "राघवेणाभ्यनुज्ञातोमातलिश्शक्रसारथिः ॥ दिव्यंतंरथमास्थायदिवमेवारूरोहसह ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40019131, "chapter_id": 9303, "verse_number": "6", "content_sanskrit": "तस्मिंस्तुदिवमारूढेसुसारथिसन्तमे ॥ राघवःपरमप्रीतस्सुग्रीवंपरिषस्वजे ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40019132, "chapter_id": 9303, "verse_number": "7", "content_sanskrit": "परिष्वज्य च सुग्रीवंलक्ष्मणेनाभिवादितः ॥ पूज्यमानोहरिगणैराजगामबलालयम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40019133, "chapter_id": 9303, "verse_number": "8", "content_sanskrit": "अथोवाच स काकुत्स्थस्समीपपरिवर्तिनम् ॥ सौमित्रिंसत्त्वसम्पन्नंलक्ष्मणंशुभलक्षणम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40019134, "chapter_id": 9303, "verse_number": "9", "content_sanskrit": "भीषणमिमंसौम्य लङ्कायामभिषेचय ॥ अनुरक्तं च भक्तं च तथापूर्वोपकारिणम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40019135, "chapter_id": 9303, "verse_number": "10", "content_sanskrit": "एषमेपरमःकामोयदिमंरावणानुजम् ॥ लङ्कायांसौम्य पश्येमभिषिक्तंविभीषणम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40019136, "chapter_id": 9303, "verse_number": "11", "content_sanskrit": "एवमुक्तस्तुसौमित्रीराघवेणमहात्मना ॥ तथेत्युक्त्वासुसम्हृष्टःसौवर्णंघटमाददे ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40019137, "chapter_id": 9303, "verse_number": "12", "content_sanskrit": "तम्घटंवानरेन्द्राणांहस्तेदत्त्वामनोजवान् ॥ व्यादिदेशमहासत्त्व: समुद्रसलिलंतदा ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40019138, "chapter_id": 9303, "verse_number": "13", "content_sanskrit": "अतिशीघ्रंततोगत्वावानरास्तेमनोजवाः ॥ आगतास्तुजलंगृह्यसमुद्राद्वानरोत्तमाः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40019139, "chapter_id": 9303, "verse_number": "14", "content_sanskrit": "ततःस्त्वेकंघटंगृह्यसम्स्थाप्यपरमासने ॥ घटेनतेनसौमित्रिरभ्यषिञ्चद्विभीषणम् । लङ्कायांरक्षसांमध्येराजानंरामशासनात् ॥ विधिनामन्त्रदृष्टेनसुहृद्गणसमावृतः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40019140, "chapter_id": 9303, "verse_number": "15", "content_sanskrit": "ततःस्त्वेकंघटंगृह्यसम्स्थाप्यपरमासने ॥ घटेनतेनसौमित्रिरभ्यषिञ्चद्विभीषणम् । लङ्कायांरक्षसांमध्येराजानंरामशासनात् ॥ विधिनामन्त्रदृष्टेनसुहृद्गणसमावृतः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40019141, "chapter_id": 9303, "verse_number": "16", "content_sanskrit": "अभ्यषिञ्चंस्तदासर्वेराक्षसावानरास्तथा ॥ प्रहर्षमतुलंगत्वातुष्टुवूराममवे ह ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40019142, "chapter_id": 9303, "verse_number": "17", "content_sanskrit": "तस्यामात्याजहृषिरेभक्तायेचास्यराक्षसाः ॥ दृष्टवाभिषिक्तंलङ्कायांराक्षसेन्द्रंविभीषणम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40019143, "chapter_id": 9303, "verse_number": "18", "content_sanskrit": "राघवःपरमांप्रीतिंजगामसहलक्ष्मणः ॥ स तद्राज्यंमहत्प्राप्यरामदत्तंविभीषणः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40019144, "chapter_id": 9303, "verse_number": "19", "content_sanskrit": "प्रकृतयस्सान्त्वयित्वा च ततोराममुपागमत् ॥ दध्यक्षतान्मोदकांश्चलाजास्सुमनसस्तथा । आजह्रुरथसन्तुष्टाःपौरास्तस्मैनिशाचराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40019145, "chapter_id": 9303, "verse_number": "20", "content_sanskrit": "प्रकृतयस्सान्त्वयित्वा च ततोराममुपागमत् ॥ दध्यक्षतान्मोदकांश्चलाजास्सुमनसस्तथा । आजह्रुरथसन्तुष्टाःपौरास्तस्मैनिशाचराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40019146, "chapter_id": 9303, "verse_number": "21", "content_sanskrit": "सःतान् गृहीत्वादुर्धर्षोराघवायन्यवेदयत् ॥ माङ्गल्यंमङ्गलंसर्वंलक्ष्मणाय च वीर्यवान् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40019147, "chapter_id": 9303, "verse_number": "22", "content_sanskrit": "कृतकार्यंसमृद्धार्थंदृष्टवारामोविभीषणम् ॥ प्रतिजग्राहतत्सर्वंतस्यैवप्रियकाम्यया ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40019148, "chapter_id": 9303, "verse_number": "23", "content_sanskrit": "ततःशैलोपमंवीरंप्राञ्जलिंप्रणतंस्थितम् ॥ उवाचेदंवचोरामोहनूमन्तंप्लवङ्गमम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40019149, "chapter_id": 9303, "verse_number": "24", "content_sanskrit": "अनुज्ञाप्यमहाराजमिमंसौम्य विभीषणम् ॥ प्रविश्यनगरींलङ्कांकौशलंब्रूहिमैथिलीम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40019150, "chapter_id": 9303, "verse_number": "25", "content_sanskrit": "वैदेह्यैमांकुशलिनंसुग्रीवं च सलक्ष्मणम् ॥ आचक्ष्ववदतांश्रेष्ठरावणं च हतंरणे ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]