[{"id": 5000303000, "chapter_id": 9303, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे किष्किन्धाकाण्डे एकत्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000303001, "chapter_id": 9303, "verse_number": "४-३१-१", "content_sanskrit": "स कामिनं दीनमदीनसत्त्वं\nशोकाभिपन्नं समुदीर्णकोपम्।\nनरेन्द्रसूनुर्नरदेवपुत्रं\nरामानुजः पूर्वजमित्युवाच ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000303002, "chapter_id": 9303, "verse_number": "४-३१-२", "content_sanskrit": "न वानरः स्थास्यति साधुवृत्ते\nन मन्यते कर्मफलानुषङ्गान्।\nन भोक्ष्यते वानरराज्यलक्ष्मीं\nतथा हि नातिक्रमतेऽस्य बुद्धिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000303003, "chapter_id": 9303, "verse_number": "४-३१-३", "content_sanskrit": "मतिक्षयाद् ग्राम्यसुखेषु सक्त-\nस्तव प्रसादात् प्रतिकारबुद्धिः।\nहतोऽग्रजं पश्यतु वीरवालिनं\nन राज्यमेवं विगुणस्य देयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000303004, "chapter_id": 9303, "verse_number": "४-३१-४", "content_sanskrit": "न धारये कोपमुदीर्णवेगं\nनिहन्मि सुग्रीवमसत्यमद्य।\nहरिप्रवीरैः सह वालिपुत्रो\nनरेन्द्रपुत्र्या विचयं करोतु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000303005, "chapter_id": 9303, "verse_number": "४-३१-५", "content_sanskrit": "तमात्तबाणासनमुत्पतन्तं\nनिवेदितार्थं रणचण्डकोपम्।\nउवाच रामः परवीरहन्ता\nस्ववीक्षितं सानुनयं च वाक्यम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000303006, "chapter_id": 9303, "verse_number": "४-३१-६", "content_sanskrit": "नहि वै त्वद्विधो लोके पापमेवं समाचरेत्।\nकोपमार्येण यो हन्ति स वीरः पुरुषोत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000303007, "chapter_id": 9303, "verse_number": "४-३१-७", "content_sanskrit": "नेदमत्र त्वया ग्राह्यं साधुवृत्तेन लक्ष्मण।\nतां प्रीतिमनुवर्तस्व पूर्ववृत्तं च संगतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000303008, "chapter_id": 9303, "verse_number": "४-३१-८", "content_sanskrit": "सामोपहितया वाचा रूक्षाणि परिवर्जयन्।\nवक्तुमर्हसि सुग्रीवं व्यतीतं कालपर्यये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000303009, "chapter_id": 9303, "verse_number": "४-३१-९", "content_sanskrit": "सोऽग्रजेनानुशिष्टार्थो यथावत् पुरुषर्षभः।\nप्रविवेश पुरीं वीरो लक्ष्मणः परवीरहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000303010, "chapter_id": 9303, "verse_number": "४-३१-१०", "content_sanskrit": "ततः शुभमतिः प्राज्ञो भ्रातुः प्रियहिते रतः।\nलक्ष्मणः प्रतिसंरब्धो जगाम भवनं कपेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000303011, "chapter_id": 9303, "verse_number": "४-३१-११", "content_sanskrit": "शक्रबाणासनप्रख्यं धनुः कालान्तकोपमम्।\nप्रगृह्य गिरिशृङ्गाभं मन्दरः सानुमानिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000303012, "chapter_id": 9303, "verse_number": "४-३१-१२", "content_sanskrit": "यथोक्तकारी वचनमुत्तरं चैव सोत्तरम्।\nबृहस्पतिसमो बुद्ध्या मत्वा रामानुजस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000303013, "chapter_id": 9303, "verse_number": "४-३१-१३", "content_sanskrit": "कामक्रोधसमुत्थेन भ्रातुः क्रोधाग्निना वृतः।\nप्रभञ्जन इवाप्रीतः प्रययौ लक्ष्मणस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000303014, "chapter_id": 9303, "verse_number": "४-३१-१४", "content_sanskrit": "सालतालाश्वकर्णांश्च तरसा पातयन् बलात्।\nपर्यस्यन् गिरिकूटानि द्रुमानन्यांश्च वेगितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000303015, "chapter_id": 9303, "verse_number": "४-३१-१५", "content_sanskrit": "शिलाश्च शकलीकुर्वन् पद्‍भ्यां गज इवाशुगः।\nदूरमेकपदं त्यक्त्वा ययौ कार्यवशाद् द्रुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000303016, "chapter_id": 9303, "verse_number": "४-३१-१६", "content_sanskrit": "तामपश्यद् बलाकीर्णां हरिराजमहापुरीम्।\nदुर्गामिक्ष्वाकुशार्दूलः किष्किन्धां गिरिसंकटे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000303017, "chapter_id": 9303, "verse_number": "४-३१-१७", "content_sanskrit": "रोषात् प्रस्फुरमाणोष्ठः सुग्रीवं प्रति लक्ष्मणः।\nददर्श वानरान् भीमान् किष्किन्धायां बहिश्चरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000303018, "chapter_id": 9303, "verse_number": "४-३१-१८", "content_sanskrit": "तं दृष्ट्वा वानराः सर्वे लक्ष्मणं पुरुषर्षभम्।\nशैलशृङ्गाणि शतशः प्रवृद्धांश्च महीरुहान्।\nजगृहुः कुञ्जरप्रख्या वानराः पर्वतान्तरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000303019, "chapter_id": 9303, "verse_number": "४-३१-१९", "content_sanskrit": "तान् गृहीतप्रहरणान् सर्वान् दृष्ट्वा तु लक्ष्मणः।\nबभूव द्विगुणं क्रुद्धो बह्विन्धन इवानलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000303020, "chapter_id": 9303, "verse_number": "४-३१-२०", "content_sanskrit": "तं ते भयपरीताङ्गा क्षुब्धं दृष्ट्वा प्लवंगमाः।\nकालमृत्युयुगान्ताभं शतशो विद्रुता दिशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000303021, "chapter_id": 9303, "verse_number": "४-३१-२१", "content_sanskrit": "ततः सुग्रीवभवनं प्रविश्य हरिपुंगवाः।\nक्रोधमागमनं चैव लक्ष्मणस्य न्यवेदयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000303022, "chapter_id": 9303, "verse_number": "४-३१-२२", "content_sanskrit": "तारया सहितः कामी सक्तः कपिवृषस्तदा।\nन तेषां कपिसिंहानां शुश्राव वचनं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000303023, "chapter_id": 9303, "verse_number": "४-३१-२३", "content_sanskrit": "ततः सचिवसंदिष्टा हरयो रोमहर्षणाः।\nगिरिकुञ्जरमेघाभा नगरान्निर्ययुस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000303024, "chapter_id": 9303, "verse_number": "४-३१-२४", "content_sanskrit": "नखदंष्ट्रायुधाः सर्वे वीरा विकृतदर्शनाः।\nसर्वे शार्दूलदंष्ट्राश्च सर्वे विवृतदर्शनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000303025, "chapter_id": 9303, "verse_number": "४-३१-२५", "content_sanskrit": "दशनागबलाः केचित् केचिद् दशगुणोत्तराः।\nकेचिन्नागसहस्रस्य बभूवुस्तुल्यवर्चसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000303026, "chapter_id": 9303, "verse_number": "४-३१-२६", "content_sanskrit": "ततस्तैः कपिभिर्व्याप्तां द्रुमहस्तैर्महाबलैः।\nअपश्यल्लक्ष्मणः क्रुद्धः किष्किन्धां तां दुरासदाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000303027, "chapter_id": 9303, "verse_number": "४-३१-२७", "content_sanskrit": "ततस्ते हरयः सर्वे प्राकारपरिखान्तरात्।\nनिष्क्रम्योदग्रसत्त्वास्तु तस्थुराविष्कृतं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000303028, "chapter_id": 9303, "verse_number": "४-३१-२८", "content_sanskrit": "सुग्रीवस्य प्रमादं च पूर्वजस्यार्थमात्मवान्।\nदृष्ट्वा क्रोधवशं वीरः पुनरेव जगाम सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000303029, "chapter_id": 9303, "verse_number": "४-३१-२९", "content_sanskrit": "स दीर्घोष्णमहोच्छ्वासः कोपसंरक्तलोचनः।\nबभूव नरशार्दूलः सधूम इव पावकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000303030, "chapter_id": 9303, "verse_number": "४-३१-३०", "content_sanskrit": "बाणशल्यस्फुरज्जिह्वः सायकासनभोगवान्।\nस्वतेजोविषसम्भूतः पञ्चास्य इव पन्नगः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000303031, "chapter_id": 9303, "verse_number": "४-३१-३१", "content_sanskrit": "तं दीप्तमिव कालाग्निं नागेन्द्रमिव कोपितम्।\nसमासाद्याङ्गदस्त्रासाद् विषादमगमत् परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000303032, "chapter_id": 9303, "verse_number": "४-३१-३२", "content_sanskrit": "सोऽङ्गदं रोषताम्राक्षः संदिदेश महायशाः।\nसुग्रीवः कथ्यतां वत्स ममागमनमित्युत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000303033, "chapter_id": 9303, "verse_number": "४-३१-३३", "content_sanskrit": "एष रामानुजः प्राप्तस्त्वत्सकाशमरिंदम।\nभ्रातुर्व्यसनसंतप्तो द्वारि तिष्ठति लक्ष्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000303034, "chapter_id": 9303, "verse_number": "४-३१-३४", "content_sanskrit": "तस्य वाक्यं यदि रुचिः क्रियतां साधु वानर।\nइत्युक्त्वा शीघ्रमागच्छ वत्स वाक्यमरिंदम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000303035, "chapter_id": 9303, "verse_number": "४-३१-३५", "content_sanskrit": "लक्ष्मणस्य वचः श्रुत्वा शोकाविष्टोऽङ्गदोऽब्रवीत्।\nपितुः समीपमागम्य सौमित्रिरयमागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000303036, "chapter_id": 9303, "verse_number": "४-३१-३६", "content_sanskrit": "अथाङ्गदस्तस्य सुतीव्रवाचा\nसम्भ्रान्तभावः परिदीनवक्त्रः।\nनिर्गत्य पूर्वं नृपतेस्तरस्वी\nततो रुमायाश्चरणौ ववन्दे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000303037, "chapter_id": 9303, "verse_number": "४-३१-३७", "content_sanskrit": "संगृह्य पादौ पितुरुग्रतेजा\nजग्राह मातुः पुनरेव पादौ।\nपादौ रुमायाश्च निपीडयित्वा\nनिवेदयामास ततस्तदर्थम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000303038, "chapter_id": 9303, "verse_number": "४-३१-३८", "content_sanskrit": "स निद्राक्लान्तसंवीतो वानरो न विबुद्धवान्।\nबभूव मदमत्तश्च मदनेन च मोहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000303039, "chapter_id": 9303, "verse_number": "४-३१-३९", "content_sanskrit": "ततः किलकिलां चक्रुर्लक्ष्मणं प्रेक्ष्य वानराः।\nप्रसादयन्तस्तं क्रुद्धं भयमोहितचेतसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000303040, "chapter_id": 9303, "verse_number": "४-३१-४०", "content_sanskrit": "ते महौघनिभं दृष्ट्वा वज्राशनिसमस्वनम्।\nसिंहनादं समं चक्रुर्लक्ष्मणस्य समीपतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000303041, "chapter_id": 9303, "verse_number": "४-३१-४१", "content_sanskrit": "तेन शब्देन महता प्रत्यबुध्यत वानरः।\nमदविह्वलताम्राक्षो व्याकुलः स्रग्विभूषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000303042, "chapter_id": 9303, "verse_number": "४-३१-४२", "content_sanskrit": "अथाङ्गदवचः श्रुत्वा तेनैव च समागतौ।\nमन्त्रिणौ वानरेन्द्रस्य सम्मतोदारदर्शनौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000303043, "chapter_id": 9303, "verse_number": "४-३१-४३", "content_sanskrit": "प्लक्षश्चैव प्रभावश्च मन्त्रिणावर्थधर्मयोः।\nवक्तुमुच्चावचं प्राप्तं लक्ष्मणं तौ शशंसतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000303044, "chapter_id": 9303, "verse_number": "४-३१-४४", "content_sanskrit": "प्रसादयित्वा सुग्रीवं वचनैः सार्थनिश्चितैः।\nआसीनं पर्युपासीनौ यथा शक्रं मरुत्पतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000303045, "chapter_id": 9303, "verse_number": "४-३१-४५", "content_sanskrit": "सत्यसंधौ महाभागौ भ्रातरौ रामलक्ष्मणौ।\nमनुष्यभावं सम्प्राप्तौ राज्यार्हौ राज्यदायिनौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000303046, "chapter_id": 9303, "verse_number": "४-३१-४६", "content_sanskrit": "तयोरेको धनुष्पाणिर्द्वारि तिष्ठति लक्ष्मणः।\nयस्य भीताः प्रवेपन्तो नादान् मुञ्चन्ति वानराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000303047, "chapter_id": 9303, "verse_number": "४-३१-४७", "content_sanskrit": "स एष राघवभ्राता लक्ष्मणो वाक्यसारथिः।\nव्यवसायरथः प्राप्तस्तस्य रामस्य शासनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000303048, "chapter_id": 9303, "verse_number": "४-३१-४८", "content_sanskrit": "अयं च तनयो राजंस्ताराया दयितोऽङ्गदः।\nलक्ष्मणेन सकाशं ते प्रेषितस्त्वरयानघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000303049, "chapter_id": 9303, "verse_number": "४-३१-४९", "content_sanskrit": "सोऽयं रोषपरीताक्षो द्वारि तिष्ठति वीर्यवान्।\nवानरान् वानरपते चक्षुषा निर्दहन्निव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000303050, "chapter_id": 9303, "verse_number": "४-३१-५०", "content_sanskrit": "तस्य मूर्ध्ना प्रणामं त्वं सपुत्रः सहबान्धवः।\nगच्छ शीघ्रं महाराज रोषो ह्यद्योपशाम्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000303051, "chapter_id": 9303, "verse_number": "४-३१-५१", "content_sanskrit": "यथा हि रामो धर्मात्मा तत्कुरुष्व समाहितः।\nराजंस्तिष्ठ स्वसमये भव सत्यप्रतिश्रवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000303052, "chapter_id": 9303, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे एकत्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]