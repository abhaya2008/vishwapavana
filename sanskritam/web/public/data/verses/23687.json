[{"id": 7003687000, "chapter_id": 23687, "verse_number": "१-३-८-१", "content_sanskrit": "गौतम उवाच ।\nशृणु देवि पुरावृत्तं कैलासे मेरुधन्विना ।\nआदिष्टस्तीर्थयात्रार्थमहं लिंगानि वीक्षितुम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003687001, "chapter_id": 23687, "verse_number": "१-३-८-२", "content_sanskrit": "रुद्रक्षेत्रे च केदारे तथा बदरिकाश्रमे ।\nकाश्यां पुण्येषु देशेषु तथा श्रीपर्वते शिवे ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003687002, "chapter_id": 23687, "verse_number": "१-३-८-३", "content_sanskrit": "कांचीमुख्यासु पुण्यासु पुरीष्वप्यगमं तदा ।\nऋषिभिर्विबुधैः सार्थैर्गणैर्योगिभिरुत्तमैः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003687003, "chapter_id": 23687, "verse_number": "१-३-८-४", "content_sanskrit": "स्थापितानि च लिंगानि स्वयंभूनि च दृष्टवान् ।\nतत्रतत्र महाभागे तीर्थानि शिवसन्निधौ ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003687004, "chapter_id": 23687, "verse_number": "१-३-८-५", "content_sanskrit": "सेवमानः सशिष्योऽहं पर्यटन्पृथिवीमिमाम् ।\nएवं तीर्थानि सर्वाणि गाहमानो व्रतान्वितः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003687005, "chapter_id": 23687, "verse_number": "१-३-८-६", "content_sanskrit": "तपांसि यज्ञकर्माणि कुर्वन्भूमिं समाचरन् ।\nशिवस्मरणसंयुक्तः शिवलिंगानि सन्नमन् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003687006, "chapter_id": 23687, "verse_number": "१-३-८-७", "content_sanskrit": "सर्वाणि भुवि पुण्यानि देशमेतमुपाश्रयम् ।\nअत्र देवं महादेवमविकेशं त्रियंबकम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003687007, "chapter_id": 23687, "verse_number": "१-३-८-८", "content_sanskrit": "अरुणाद्रिरितिख्यातं पर्वतं लिंगमैक्षिषि ।\nअत्र सिद्धा महात्मानो मुनयश्च दृढव्रताः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003687008, "chapter_id": 23687, "verse_number": "१-३-८-९", "content_sanskrit": "कंदमूलफलाहारा दृष्टाः शोणाद्रि सेवकाः ।\nअस्तौषमादिमं लिंगमरुणाद्रिमयं महत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003687009, "chapter_id": 23687, "verse_number": "१-३-८-१०", "content_sanskrit": "आद्येन ब्रह्मणा पूर्वमर्चितं दिव्यचक्षुषा ।\nअसौ यस्ताम्रो अरुण उत बभ्रुः सुमंगलः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003687010, "chapter_id": 23687, "verse_number": "१-३-८-११", "content_sanskrit": "इति वेदा स्तुवंति त्वामरुणाद्रीश संततम् ।\nनमस्ताम्राय चारुणाय शिवाय परमात्मने ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003687011, "chapter_id": 23687, "verse_number": "१-३-८-१२", "content_sanskrit": "सर्ववेदस्वरूपाय नित्यायामृतमूर्त्तये ।\nकालाय करुणार्द्राय दृष्टिपेयामृताब्धये ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003687012, "chapter_id": 23687, "verse_number": "१-३-८-१३", "content_sanskrit": "भक्तवात्सल्यपूर्णाय पुण्याय पुरभेदिने ।\nदर्शनं तव देवेश सर्वधर्मफलप्रदम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003687013, "chapter_id": 23687, "verse_number": "१-३-८-१४", "content_sanskrit": "भुवि लब्धवता भूयो नान्यत्कार्यं तपः क्वचित् ।\nभवता कर्मभूरेषा वर्ततेद्य निरोधिता ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003687014, "chapter_id": 23687, "verse_number": "१-३-८-१५", "content_sanskrit": "प्रार्थयते स्वयं वासान्देवाश्चात्र त्वदाश्रये ।\nकालसंग्रहसंजातं फलं लब्धं मयाधुना ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003687015, "chapter_id": 23687, "verse_number": "१-३-८-१६", "content_sanskrit": "अन्यत्कृतं तपः सर्वं त्वद्दर्शनफलं मम ।\nईदृशं तव देवेश रूपमत्यद्भुतोदयम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003687016, "chapter_id": 23687, "verse_number": "१-३-८-१७", "content_sanskrit": "एकमद्रिमयं लिंगं न क्वचिद्दृष्टवान्भुवि ।\nसूर्येंद्वग्निसुसंयुक्त कोणत्रयमनोहरम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003687017, "chapter_id": 23687, "verse_number": "१-३-८-१८", "content_sanskrit": "त्रिमूर्तिरूप देवेश दृश्यते ते वपुर्महत् ।\nशक्तित्रयस्वरूपेण कालत्रयविधानकम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003687018, "chapter_id": 23687, "verse_number": "१-३-८-१९", "content_sanskrit": "त्रिवेदात्मं त्रिकोणांगं लिंगं ते दृष्टमद्भुतम् ।\nत्रैलोक्यरक्षणार्थाय विततं रूपमास्थितः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003687019, "chapter_id": 23687, "verse_number": "१-३-८-२०", "content_sanskrit": "दृश्यते वसुधाभागे शोणाद्रिरिति विश्रुतः ।\nअजानतां च मर्त्यानां समालोकनमात्रतः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003687020, "chapter_id": 23687, "verse_number": "१-३-८-२१", "content_sanskrit": "वितरत्यखिलान्भोगान्व्याजकरुणानिधिः ।\nअर्चया रहितं लिंगमन्यं शून्यमुदाहृतम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003687021, "chapter_id": 23687, "verse_number": "१-३-८-२२", "content_sanskrit": "इदं तु पूजितं देवैः सदा सर्ववरप्रदम् ।\nप्रसीद करुणापूर्ण शोणाचल महेश्वर ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003687022, "chapter_id": 23687, "verse_number": "१-३-८-२३", "content_sanskrit": "त्रायस्व भवभीतं मां प्रपन्नं भक्तवत्सल ।\nद्रष्टव्यं द्रष्टमेतत्ते रूपमत्यद्भुतं महत् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003687023, "chapter_id": 23687, "verse_number": "१-३-८-२४", "content_sanskrit": "कृतार्थय कृपासिंधो शरण्य शरणागतम् ।\nइति संस्तूयमानो मे देवः शोणाचलेश्वरः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003687024, "chapter_id": 23687, "verse_number": "१-३-८-२५", "content_sanskrit": "अदर्शयत्परं रूपं दिव्यमेहीत्युवाच माम् ।\nप्रीतोऽस्मि भवतः स्तोत्रैर्भक्त्या च परया भृशम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003687025, "chapter_id": 23687, "verse_number": "१-३-८-२६", "content_sanskrit": "अत्रैव भवतो वासो नित्यमस्तु ममांतिके ।\nसंपूजय च मां नित्यं भुवि भोगैः सनातनैः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003687026, "chapter_id": 23687, "verse_number": "१-३-८-२७", "content_sanskrit": "तपसा तप सर्वेषां महत्त्वमिह दर्शय ।\nपूर्वं कैलासशिखरे वसंतं त्वां तपोन्वितम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003687027, "chapter_id": 23687, "verse_number": "१-३-८-२८", "content_sanskrit": "आदिशं पृथिवीभागं शोणाद्रौ पूजयेति माम् ।\nसप्तर्षिपूजिता पूजा दिवि मे संप्रकाशते ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003687028, "chapter_id": 23687, "verse_number": "१-३-८-२९", "content_sanskrit": "तथा नित्यार्चनायुक्त प्रकाशय धरातले ।\nसर्वेषामेव जंतूनां हिताय त्वं तपोऽधिकः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003687029, "chapter_id": 23687, "verse_number": "१-३-८-३०", "content_sanskrit": "भुवि मां पूजयार्चाभिरागमोक्ताभिरादरात् ।\nदिव्या मम महापूजा दृश्या हि दिवि दैवतैः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003687030, "chapter_id": 23687, "verse_number": "१-३-८-३१", "content_sanskrit": "प्रकाशनीया भवता पार्थिवी वसुधातले ।\nमाहात्म्यं पूर्वमेवोक्तं यथाहमरुणाचलः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003687031, "chapter_id": 23687, "verse_number": "१-३-८-३२", "content_sanskrit": "स्थितो वसुंधराभागे मया प्रीतं तु ते भृशम् ।\nये वा संपूजयंति स्म पूर्वं मां सुकृताधिकाः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003687032, "chapter_id": 23687, "verse_number": "१-३-८-३३", "content_sanskrit": "तेभ्यस्त्वमधिको भूमौ प्रकाशस्व शिवार्चनम् ।\nइत्यादिष्टो हि देवेशं प्रणम्य भवभक्तिमान् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003687033, "chapter_id": 23687, "verse_number": "१-३-८-३४", "content_sanskrit": "अन्वपृच्छं दयापूर्णमरुणाद्रीशमानमन् ।\nअनासाद्यमिदं रूपमग्निरूपं महेश्वरम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003687034, "chapter_id": 23687, "verse_number": "१-३-८-३५", "content_sanskrit": "कथमद्यार्चयाम्येनं मर्त्यलोकोचितार्चनैः ।\nआदेशमिममन्वर्थं कथं वा कल्पयाम्यहम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003687035, "chapter_id": 23687, "verse_number": "१-३-८-३६", "content_sanskrit": "उपायमादिश श्रीमन्नभिगम्यो यथा भवान् ।\nइति विज्ञापितो देवः श्रीमाञ्छोणाचलेश्वरः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003687036, "chapter_id": 23687, "verse_number": "१-३-८-३७", "content_sanskrit": "अन्वग्रहीदशेषात्मा प्रणतं मां दयानिधिः ।\nअहं तु सूक्ष्मलिंगानि प्रकाशिष्ये महीतले ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003687037, "chapter_id": 23687, "verse_number": "१-३-८-३८", "content_sanskrit": "आगमोक्तक्रियाभेदैः पूजां मे प्रतिपादय ।\nपंचावरणसंयुक्तं लिंगं मे सूक्ष्ममद्भुतम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003687038, "chapter_id": 23687, "verse_number": "१-३-८-३९", "content_sanskrit": "अरुणाद्रीश्वराभिख्यं संपूजय तपोबलैः ।\nइत्यादिश्य महादेवः स्वयंभु विमलं महत् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003687039, "chapter_id": 23687, "verse_number": "१-३-८-४०", "content_sanskrit": "रूपं मे दर्शयामास सूक्ष्मलिंगात्मना शिवः ।\nआलोक्य विमलं लिंगं सूक्ष्मं तत्स्वयमुच्छ्रितम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003687040, "chapter_id": 23687, "verse_number": "१-३-८-४१", "content_sanskrit": "अशेषाऽवरणोपेतं कृतार्थहृदयोऽभवम् ।\nपुनर्व्यज्ञापयं देवं शम्भुमाश्रितवत्सलम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003687041, "chapter_id": 23687, "verse_number": "१-३-८-४२", "content_sanskrit": "आगमोक्तप्रकाराणामनिरीक्ष्यत्वमागतम् ।\nकथं तु तव रूपाणां नामभेदान्वियोजितान् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003687042, "chapter_id": 23687, "verse_number": "१-३-८-४३", "content_sanskrit": "जानीयां करुणामूर्ते स्वयमीश्वर मत्प्रभो ।\nपूजकास्तव के वा स्युर्मंदिरं वात्र कीदृशम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003687043, "chapter_id": 23687, "verse_number": "१-३-८-४४", "content_sanskrit": "कथं स्तोत्रं कथं पूजा के वात्र परिचारकाः ।\nस्थानरक्षा कथं वा स्यात्के वात्मपरिरक्षकाः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003687044, "chapter_id": 23687, "verse_number": "१-३-८-४५", "content_sanskrit": "कथं वा मानुषी पूजा नित्या संवर्धते तव ।\nआगता बहवो देवाः श्रद्धेयं मनुजैः कथम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003687045, "chapter_id": 23687, "verse_number": "१-३-८-४६", "content_sanskrit": "प्रसीद परमेशान स्वयमाज्ञापयाखिलम् ।\nएवं विज्ञापितो देवः शोणाद्रीशः स्वयं प्रभुः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003687046, "chapter_id": 23687, "verse_number": "१-३-८-४७", "content_sanskrit": "आज्ञापयत्तदा देवो विश्वकर्माणमागतम् ।\nसृज त्वं नगरं दिव्यमरुणाख्यं गुणाधिकम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003687047, "chapter_id": 23687, "verse_number": "१-३-८-४८", "content_sanskrit": "मंदिरं मम दिव्यं च महामणिगणोज्ज्वलम् ।\nतौर्यत्रिकं सपर्यांगं तन्मे सर्वं प्रकल्पय ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003687048, "chapter_id": 23687, "verse_number": "१-३-८-४९", "content_sanskrit": "आबभाषे शिवः श्रीमान्नामभेदार्चनक्रमम् ।\nव्रतं च करुणामूर्त्तिररुणाद्रीश्वरः शिवः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003687049, "chapter_id": 23687, "verse_number": "१-३-८-५०", "content_sanskrit": "शृणु तन्मे च ये सृष्टा पूजार्थं परिचारकाः ।\nशृणु गौतम सर्वं मे मानुषं पूजनक्रमम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003687050, "chapter_id": 23687, "verse_number": "१-३-८-५१", "content_sanskrit": "य एष सर्वलोकानां क्षेमाय प्रथते भुवि ।\nइदं तेजोमयं लिंगमतुलं दृश्यते महत् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003687051, "chapter_id": 23687, "verse_number": "१-३-८-५२", "content_sanskrit": "अरुणाद्रीश्वराभिख्यं पूज्यतां सततं त्वया ।\nशक्तिर्ममोत्तरे भागे पूज्या नित्योदया मुदा ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003687052, "chapter_id": 23687, "verse_number": "१-३-८-५३", "content_sanskrit": "दधती स्थानमाहात्म्यमपीतकुचनामिका ।\nअरुणाचलराजोयमविभागः प्रियान्वितः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003687053, "chapter_id": 23687, "verse_number": "१-३-८-५४", "content_sanskrit": "उत्सवार्थो महादेवः पूज्यो भोगसुतावृतः ।\nबोधदो भक्तलोकस्य दत्ताभयकरः शिवः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003687054, "chapter_id": 23687, "verse_number": "१-३-८-५५", "content_sanskrit": "सारंगं परशुं विभ्रत्प्रसन्नवदनः सदा ।\nउमास्कन्देश्वरः शम्भुर्दिव्यरत्नविभूषणः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003687055, "chapter_id": 23687, "verse_number": "१-३-८-५६", "content_sanskrit": "आभया भासयंल्लोकानविकुण्ठश्रियान्वितः ।\nशक्तेरुत्सवभद्रे च संपूज्या सुंदरेश्वरी ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003687056, "chapter_id": 23687, "verse_number": "१-३-८-५७", "content_sanskrit": "सर्वभूषणसंयुक्ता शृङ्गाररसवर्द्धनी ।\nबालो गणपतिः पूज्यः पुरस्ताद्भूतिनन्दनः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003687057, "chapter_id": 23687, "verse_number": "१-३-८-५८", "content_sanskrit": "मदंतिकमलंकुर्वन्भक्ष्यैर्भोज्यैर्बहूदयैः ।\nमत्पार्श्वमविमुंचंती शोणरेखांचितेक्षणा ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003687058, "chapter_id": 23687, "verse_number": "१-३-८-५९", "content_sanskrit": "उत्सवार्था परा शक्तिरंतिकस्थैव पूज्यताम् ।\nमुखरांघ्रिपतिः श्रीमान्नृत्यंस्तांडवपण्डितः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003687059, "chapter_id": 23687, "verse_number": "१-३-८-६०", "content_sanskrit": "उत्सवार्थं समभ्यर्च्यश्चक्षुरग्रेऽमृतेश्वरः ।\nशक्तिश्चान्या महाभागा संपूज्या भूविनायका ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003687060, "chapter_id": 23687, "verse_number": "१-३-८-६१", "content_sanskrit": "द्वारे नन्दी महाकालः पुरस्तात्सूर्यसंनिभः ।\nभक्तानां मम सर्वेषां पूजनं चापि कल्प्यताम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003687061, "chapter_id": 23687, "verse_number": "१-३-८-६२", "content_sanskrit": "दक्षिणे मातरः पूज्या विघ्नशास्तृसमन्विताः ।\nसंपूज्यो नैरृते कोणे विघ्ननाशो विनायकाः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003687062, "chapter_id": 23687, "verse_number": "१-३-८-६३", "content_sanskrit": "स्कन्दः शक्तिधरश्चैवैशानकोणे समर्च्यताम् ।\nलिंगानि च मनोज्ञानि पूजनीयान्यनन्तरम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003687063, "chapter_id": 23687, "verse_number": "१-३-८-६४", "content_sanskrit": "मंदिरं मम संपूज्य दक्षिणामूर्ति दक्षिणम् ।\nपश्चिमे विष्णुरूपांकमग्निरूपान्वितं तथा ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003687064, "chapter_id": 23687, "verse_number": "१-३-८-६५", "content_sanskrit": "उत्तरे ब्रह्मरूपांकं पूर्वे सारंगभूयुतम् ।\nसर्वदेवगुणोपेतं सर्वशक्तिसमन्वितम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003687065, "chapter_id": 23687, "verse_number": "१-३-८-६६", "content_sanskrit": "अपीतकुचनाथायाः सर्वशक्तिसमन्वितम् ।\nमंदिरं गुरु संपूज्य दिक्पालकवधूवृतम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003687066, "chapter_id": 23687, "verse_number": "१-३-८-६७", "content_sanskrit": "मंदिरस्यावनार्थाय देवीर्वैभवनायकाः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003687067, "chapter_id": 23687, "verse_number": "१-३-८-६८", "content_sanskrit": "क्षेत्रपालं तु संपूज्य सर्वावरणसंयुतम् ।\nपुत्रस्य त्राणमायाता पूज्यारुणगिरीश्वरी ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003687068, "chapter_id": 23687, "verse_number": "१-३-८-६९", "content_sanskrit": "काली बहुविधाश्चान्या देवता विधिपालकाः ।\nउत्सवा विविधाः कल्प्याः प्रतिमासमहोदयाः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003687069, "chapter_id": 23687, "verse_number": "१-३-८-७०", "content_sanskrit": "सृजस्व कन्यका दिव्याः शिवदेवार्हणे रताः ।\nनृत्तगीतकलाभिज्ञा रूपसौभाग्यसंयुताः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003687070, "chapter_id": 23687, "verse_number": "१-३-८-७१", "content_sanskrit": "चारुविभ्रमसंयुक्ताः कामदा नित्यपावनाः ।\nशिष्यानादिश वेदज्ञान्सदाचारसमुज्ज्वलान् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003687071, "chapter_id": 23687, "verse_number": "१-३-८-७२", "content_sanskrit": "दिव्योपचारसंसिद्ध्यै सुभगाञ्छुद्धचेतसः ।\nदीक्षितान्विमलाञ्छुद्धाञ्छैवागमविशारदान् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003687072, "chapter_id": 23687, "verse_number": "१-३-८-७३", "content_sanskrit": "शैवाचारप्रसिद्ध्यर्थमादिशाभ्यर्चने मम ।\nमार्द्दलाञ्छांखिकान्वैणांस्तालिकान्वेणुवादकान् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003687073, "chapter_id": 23687, "verse_number": "१-३-८-७४", "content_sanskrit": "शौल्बिकान्सृज सद्विद्यांश्चतुर्विद्याविशारदान् ।\nक्षत्रियान्विविधान्वैश्याञ्छूद्रांश्च शिवसंमतान् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003687074, "chapter_id": 23687, "verse_number": "१-३-८-७५", "content_sanskrit": "चत्वारश्च मठाः कल्प्याश्चतुर्दिक्तीर्थवासिनाम् ।\nमुनीनां शिवभक्तानां निराशानां निवासतः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003687075, "chapter_id": 23687, "verse_number": "१-३-८-७६", "content_sanskrit": "तेषु स्थिता मुनींद्रा मे रक्षंतु शिवपूजनम् ।\nभिक्षमाणाः पुनः शैवा भक्ताः पाशुपता अपि ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003687076, "chapter_id": 23687, "verse_number": "१-३-८-७७", "content_sanskrit": "पालयंतु सदान्ये च युक्ताः कापालिका अपि ।\nसर्वेषां जायमानानां जातानां संभविष्यताम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003687077, "chapter_id": 23687, "verse_number": "१-३-८-७८", "content_sanskrit": "अव्याहताज्ञमारक्ष्यमिदं स्थानं महीभृताम् ।\nबकुलश्च महानत्र दृश्यते दिव्यभूरुहः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003687078, "chapter_id": 23687, "verse_number": "१-३-८-७९", "content_sanskrit": "अत्र भक्ता वितन्वन्तु शिवकार्यविनिश्चयम् ।\nअत्र मे दीयते द्रव्यमप्रेक्षितपराप्तये ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003687079, "chapter_id": 23687, "verse_number": "१-३-८-८०", "content_sanskrit": "यत्तदक्षय्यफलदमारक्ष्यं शिवसेवकैः ।\nभक्तैर्विज्ञापितं चार्थं श्रोष्यामि पुरतः स्थितैः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003687080, "chapter_id": 23687, "verse_number": "१-३-८-८१", "content_sanskrit": "सर्वं संपादयिष्यामि तेषां चित्तानुकूलकम् ।\nअपराधसहस्राणि क्षंस्ये मां स्वर्चतामहम् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003687081, "chapter_id": 23687, "verse_number": "१-३-८-८२", "content_sanskrit": "आगमोक्ता च पूजेयं मानुषी निर्मिता यतः ।\nग्रहीष्ये तामहं सर्वामर्चां सर्वागमोदिताम् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003687082, "chapter_id": 23687, "verse_number": "१-३-८-८३", "content_sanskrit": "संकल्पितं भवेत्कर्म प्रीतिकृन्मम सेवकैः ।\nआगमार्थानशेषांस्त्वमालोक्य समयोचितान् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003687083, "chapter_id": 23687, "verse_number": "१-३-८-८४", "content_sanskrit": "विधायाभ्यर्चनाभेदांल्लोकरक्षाकृते मुने ।\nकर्तव्या महती पूजा पौर्णमास्यां तु सादरम् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003687084, "chapter_id": 23687, "verse_number": "१-३-८-८५", "content_sanskrit": "सत्राणि विविधान्यत्र कर्तव्यानि सहस्रशः ।\nविविधानि च दानानि शक्त्या चैवास्य सन्निधौ ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003687085, "chapter_id": 23687, "verse_number": "१-३-८-८६", "content_sanskrit": "अव्युच्छिन्नप्रदीपस्य दातारो मम सन्निधौ ।\nतेजोमयमिदं रूपं मम यांति न संशयः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003687086, "chapter_id": 23687, "verse_number": "१-३-८-८७", "content_sanskrit": "जलजं तरुजं पुष्पं कक्षजं च लतोद्भवम् ।\nददते ये च भक्त्या मे ते भविष्यंति भूभृतः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003687087, "chapter_id": 23687, "verse_number": "१-३-८-८८", "content_sanskrit": "तेषां पुरोगतः साक्षादहं जेष्यामि विद्विषः ।\nयस्य यस्य तु देशस्य यो यो राजा तपोधिकः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003687088, "chapter_id": 23687, "verse_number": "१-३-८-८९", "content_sanskrit": "तत्तत्समर्द्धितं रम्यं संभवं ददतेऽत्र मे ।\nमत्संनिधिमुपागत्य दुरात्मानोऽपि भूमिपाः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003687089, "chapter_id": 23687, "verse_number": "१-३-८-९०", "content_sanskrit": "शिवभक्ता भृशं पूर्णा भविष्यंति न संशयः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003687090, "chapter_id": 23687, "verse_number": "१-३-८-९१", "content_sanskrit": "इति शंभुमुखोत्थितं वचः समुपश्रुत्य विधूतकल्मषः ।\nअहमानतवान्व्यजिज्ञपं कुतुकाच्छोणगिरीश्वरं शिवम् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003687091, "chapter_id": 23687, "verse_number": "१-३-८-९२", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां प्रथमे माहेश्वरखण्डेऽरुणाचलमाहात्म्ये पूर्वार्धेऽरुणेश्वराराधनामाहात्म्यवर्णनंनामाष्टमोऽध्यायः ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}]