[{"id": 2139549, "chapter_id": 4016, "verse_number": "", "content_sanskrit": "भीमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2139550, "chapter_id": 4016, "verse_number": "१", "content_sanskrit": "शृणु भद्रे वरारोहे क्रोधात् तत्र तु चिन्तितम् ।\nत्वां वै सभागतां दृष्ट्वा मत्स्यानां कदनं महत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2139551, "chapter_id": 4016, "verse_number": "२", "content_sanskrit": "कर्तुकामेन भद्रं ते वृक्षश्चावेक्षितो मया\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2139552, "chapter_id": 4016, "verse_number": "३", "content_sanskrit": "तत्र मां धर्मराजस्तु कटाक्षेण न्यवारयन्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2139553, "chapter_id": 4016, "verse_number": "४", "content_sanskrit": "तं ध्यात्वाऽवाङ्मुखस्तूष्णीमास्थितोऽस्मि महानसम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2139554, "chapter_id": 4016, "verse_number": "५", "content_sanskrit": "शृणुष्वान्यत् प्रतिज्ञातं यद् वदामीह भामिनि\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2139555, "chapter_id": 4016, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2139556, "chapter_id": 4016, "verse_number": "६", "content_sanskrit": "आश्वासयन् हि पाञ्चालीं भीमसेन उवाच ह ।\nधिगस्तु मे बाहुबलं गाण्डीवं फल्गुनस्य च ।\nयत् ते रक्तौ पराभूत्वा पाणी कृतकिणावुभौ\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2139557, "chapter_id": 4016, "verse_number": "७", "content_sanskrit": "तदद्य मां सुतपति यत् कृतं न मया पुरा\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2139558, "chapter_id": 4016, "verse_number": "८", "content_sanskrit": "सभायां स्म विराटस्य करोमि कदनं महत् ।\nतत्र मां धर्मराजस्तु कटाक्षेण न्यवारयत्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2139559, "chapter_id": 4016, "verse_number": "९", "content_sanskrit": "तदहं तस्य विज्ञाय स्थितवानस्मि शासनम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2139560, "chapter_id": 4016, "verse_number": "१०", "content_sanskrit": "यच्च राष्ट्रात् प्रच्यवनं कुरूणामवधश्च यः ।\nसुयोधनस्य कर्णस्य शकुनेः सौबलस्य च\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2139561, "chapter_id": 4016, "verse_number": "११", "content_sanskrit": "दुःशासनस्य पापस्य यन्मया न हृतं शिरः ।\nतन्मां दहति कल्याणि हृदि शल्यमिवार्पितम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2139562, "chapter_id": 4016, "verse_number": "१२", "content_sanskrit": "अपि चान्यद् वरारोहे स्मरिष्यसि वचो मम\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2139563, "chapter_id": 4016, "verse_number": "१३", "content_sanskrit": "पुण्ये तीरे सरस्वत्या यत् प्रतिष्ठाम सङ्गताः ।\nतत्राहमब्रवं कृष्णे सर्वक्लेशाननुस्मरन्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2139564, "chapter_id": 4016, "verse_number": "१४", "content_sanskrit": "न चाहमनुगच्छेयं धर्मराजं युधिष्ठिरम् ।\nधनञ्जयं च पाञ्चालि माद्रीपुत्रौ च भ्रातरौ\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2139565, "chapter_id": 4016, "verse_number": "१५", "content_sanskrit": "वृत्तैषां च मतिः कृष्णे युधिष्ठिरमगर्हयम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2139566, "chapter_id": 4016, "verse_number": "१६", "content_sanskrit": "परुषं वचनं श्रुत्वा मम धर्मात्मजस्तदा ।\nह्रीमान् वाक्यमहीनार्थं ब्रुवन् राजा युधिष्ठिरः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2139567, "chapter_id": 4016, "verse_number": "१७", "content_sanskrit": "सर्वानन्वनयद् भ्रातॄन् मुनेर्धौम्यस्य शासतः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2139568, "chapter_id": 4016, "verse_number": "१८", "content_sanskrit": "मा रोदी राज्ञि लोकानां सर्वागमगुणान्विते ।\nरक्षितव्यं सदाऽस्माभिः सत्यमप्रतिमं भुवि\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2139569, "chapter_id": 4016, "verse_number": "१९", "content_sanskrit": "अनुनीतेषु दारेषु अनुनीता त्वमप्यसि ।\nमाऽधर्मतो वचः कृष्णे क्रोधजं समुदाहर\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2139570, "chapter_id": 4016, "verse_number": "२०", "content_sanskrit": "इमं चोक्तमुपालम्भं त्वया राजा युधिष्ठिरः ।\nशृणुयाद् यदि कल्याणि कृत्स्नं जह्यात् स जीवितम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2139571, "chapter_id": 4016, "verse_number": "२१", "content_sanskrit": "धनञ्जयो वा सुश्रोणि यमौ चापि सुमध्यमे ।\nलोकान्तरगतेष्वेषु नाहं शक्ष्यामि जीवितुम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2139572, "chapter_id": 4016, "verse_number": "२२", "content_sanskrit": "धर्मं शृणुष्व पाञ्चालि यत् ते वक्ष्यामि भामिनि\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2139573, "chapter_id": 4016, "verse_number": "२३", "content_sanskrit": "दुहिता जनकस्यासीद् वैदेही यदि ते श्रुता ।\nपतिमन्वचरत् सीता महारण्यनिवासिनम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2139574, "chapter_id": 4016, "verse_number": "२४", "content_sanskrit": "वसन्ती च महारण्ये रामस्य महिषी प्रिया ।\nरावणेन हृता सीता राक्षसीभिश्च तर्जिता\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2139575, "chapter_id": 4016, "verse_number": "२५", "content_sanskrit": "सा क्लिश्यमाना सुश्रोणी राममेवान्वपद्यत\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2139576, "chapter_id": 4016, "verse_number": "२६", "content_sanskrit": "लोपामुद्रा तु वै देवि भर्तारमृषिसत्तमम् ।\nभगवन्तमगस्त्यं सा वनायैवान्वपद्यत\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2139577, "chapter_id": 4016, "verse_number": "२७", "content_sanskrit": "सुकन्या नाम शर्यातेर्भार्गवच्यवनं वने ।\nवल्मीकभूतं शाम्यन् तमन्वपद्यत भामिनी\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2139578, "chapter_id": 4016, "verse_number": "२८", "content_sanskrit": "नाळायनी चेन्द्रसेना रूपेणाप्रतिमा भुवि ।\nपतिमन्वचरद् वृद्धं पुरा वर्षसहस्रकम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2139579, "chapter_id": 4016, "verse_number": "२९", "content_sanskrit": "द्युमत्सेनसुतं वीरं सत्यवन्तमनिन्दिता ।\nसावित्र्यनुचचारैका यमलोकं मनस्विनी\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2139580, "chapter_id": 4016, "verse_number": "३०", "content_sanskrit": "यथैताः कीर्तिताः नार्यो रूपवत्यः पतिव्रताः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2139581, "chapter_id": 4016, "verse_number": "३१", "content_sanskrit": "नळं राजानमेवाथ दमयन्ती वनान्तरे ।\nअन्वगच्छत् पुरा कृष्णे यथा भर्तॄंस्त्वमन्वगाः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2139582, "chapter_id": 4016, "verse_number": "३२", "content_sanskrit": "तथा त्वमपि कल्याणि सर्वैः समुदिता गुणैः ।\nमा दीर्घं क्षम कालं त्वं त्रिंशद्रात्रमनिन्दिते\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2139583, "chapter_id": 4016, "verse_number": "३३", "content_sanskrit": "पूर्णे त्रयोदशे वर्षे राज्ञां राज्ञी भविष्यसि ।\nसत्येन ते शपे चाहं भविता नान्यथेति च\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2139584, "chapter_id": 4016, "verse_number": "३४", "content_sanskrit": "सर्वासां परमस्त्रीणां प्रामाण्यं कर्तुमर्हसि ।\nसर्वेषां च नरेन्द्राणां मूर्ध्नि स्थास्यसि भामिनि\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2139585, "chapter_id": 4016, "verse_number": "३५", "content_sanskrit": "पूर्णायां तु प्रतिज्ञायां महान्तं भोगमाप्नुयाः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2139586, "chapter_id": 4016, "verse_number": "३६", "content_sanskrit": "गुरुभर्तृकृतं ज्ञात्वा राज्ञां मूर्ध्नि स्थिता भवेः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2139587, "chapter_id": 4016, "verse_number": "", "content_sanskrit": "द्रौपदी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2139588, "chapter_id": 4016, "verse_number": "३७", "content_sanskrit": "आर्तयैतत् कृतं भीम मया भाषाप्रबोधनम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2139589, "chapter_id": 4016, "verse_number": "३८", "content_sanskrit": "अपारयन्त्या दुःखानि भीमसेन महाबल ।\nइदं तु दुःखं कौन्तेय ममासँह्यं निबोध तत्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2139590, "chapter_id": 4016, "verse_number": "३९", "content_sanskrit": "योऽयं राज्ञो विराटस्य सूतपुत्रः स कीचकः ।\nस्यालो नाम प्रवादेन भोजस्त्रैगर्तदेशतः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2139591, "chapter_id": 4016, "verse_number": "४०", "content_sanskrit": "त्यक्तधर्मो नृशंसश्च सर्वार्थेषु च वल्लभः ।\nनित्यमेवाह दुष्टात्मा भार्या मे भव शोभने\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2139592, "chapter_id": 4016, "verse_number": "४१", "content_sanskrit": "अविनीतः सुदुष्टात्मा मामनाथेति चिन्त्य सः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2139593, "chapter_id": 4016, "verse_number": "४२", "content_sanskrit": "किमुक्तेन व्यतीतेन भीमसेन महाबल ।\nप्रत्युपस्थितकालस्य दुःखस्यान्तकरो भव\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2139594, "chapter_id": 4016, "verse_number": "४३", "content_sanskrit": "ममैव भीम कैकेयी रूपाद्धि परिशङ्किता ।\nनित्यमुद्विजते राजा कथं नेयादिमामिति\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2139595, "chapter_id": 4016, "verse_number": "४४", "content_sanskrit": "तस्या विदित्वा तं भावं स्वयं चावृतदर्शनः ।\nकीचकोऽपि हि दुष्टात्मा पुनः प्रार्थयतीह माम्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2139596, "chapter_id": 4016, "verse_number": "४५", "content_sanskrit": "तमहं कुपिता भीम पुनः कोपं नियम्य च ।\nअब्रवं कामसम्मूढमात्मानं रक्ष कीचक\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2139597, "chapter_id": 4016, "verse_number": "४६", "content_sanskrit": "गन्धर्वाणामहं भार्या पञ्चानां महिषी प्रिया ।\nते त्वां निहन्युर्दुर्धर्षाः शूराः साहसकारिणः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2139598, "chapter_id": 4016, "verse_number": "४७", "content_sanskrit": "एवमुक्तस्तु पापात्मा कीचकः प्रत्युवाच ह ।\nनाहं बिभेमि सैरन्ध्रि गन्धर्वाणां शुचिस्मिते\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2139599, "chapter_id": 4016, "verse_number": "४८", "content_sanskrit": "शतं सहस्रमपि वा गन्धर्वाणामहं रणे ।\nसमागतान् हनिष्यामि त्वं भीरु कुरु मे क्षणम्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2139600, "chapter_id": 4016, "verse_number": "४९", "content_sanskrit": "इत्युक्ता चाब्रवं सूतं कामातुरमहं पुनः ।\nन त्वं प्रतिबलस्तेषां गन्धर्वाणां यशस्विनाम्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2139601, "chapter_id": 4016, "verse_number": "५०", "content_sanskrit": "धर्मे स्थिताऽस्मि सततं कुलशीलसमन्विता ।\nनेच्छामि किञ्चिद् वध्यं त्वां तस्माज्जीवसि कीचक\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2139602, "chapter_id": 4016, "verse_number": "५१", "content_sanskrit": "एवमुक्तस्तु दुष्टात्मा प्रहस्य स्वनवत् ततः ।\nन तिष्ठति स्म सन्मार्गे न च धर्मं बुभूषति\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2139603, "chapter_id": 4016, "verse_number": "५२", "content_sanskrit": "अथ मां तत्र कैकेयी प्रेषयत् प्रेषणेन तु ।\nतेनैव चोदिता पूर्वं भ्रातृप्रियचिकीर्षया ।\nसुरामानय सैरन्ध्रि कीचकस्य निवेशनात्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2139604, "chapter_id": 4016, "verse_number": "५३", "content_sanskrit": "सूतपुत्रस्तु मां दृष्ट्वा महत्सान्त्वमवर्तयत् ।\nसान्त्वे प्रतिहते क्रुद्धः परामर्शमनाऽभवत्\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2139605, "chapter_id": 4016, "verse_number": "५४", "content_sanskrit": "विदित्वा तस्य सङ्कल्पं कीचकस्य दुरात्मनः ।\nतथाहं राजशरणं जवेनैव प्रधाविता\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2139606, "chapter_id": 4016, "verse_number": "५५", "content_sanskrit": "सन्दर्शने तु मां राज्ञः सूतपुत्रः परामृशत् ।\nपातयित्वा तु दुष्टात्मा पदाऽहं तेन ताडिता\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2139607, "chapter_id": 4016, "verse_number": "५६", "content_sanskrit": "प्रेक्षते स्म विराटस्तु कङ्कश्च बहवो जनाः ।\nरथिनः पीठमर्दाश्च हस्त्यारोहाश्च नैगमाः\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2139608, "chapter_id": 4016, "verse_number": "५७", "content_sanskrit": "उपालब्धो मया राजा कङ्कश्चापि पुनः पुनः ।\nततो न वारितो राज्ञा न तस्याविनयः कृतः\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2139609, "chapter_id": 4016, "verse_number": "५८", "content_sanskrit": "योयं राज्ञो विराटस्य कीचको नाम सारथिः ।\nत्यक्तधर्मा नृशंसश्च तरस्वी सम्मतः प्रियः\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2139610, "chapter_id": 4016, "verse_number": "५९", "content_sanskrit": "शूरोभिमानी पापात्मा सर्वार्थेषु च मुग्धवान् ।\nदारामर्शी महाभाग लभतेऽर्थान् बहूनपि\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2139611, "chapter_id": 4016, "verse_number": "६०", "content_sanskrit": "हरेदपि च वित्तानि परेषां क्रोशतामपि\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2139612, "chapter_id": 4016, "verse_number": "६१", "content_sanskrit": "पापात्मा पापकारी च कामरागवशानुगः ।\nअविनीतश्च दुष्टात्मा प्रत्याख्यातः पुनः पुनः\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2139613, "chapter_id": 4016, "verse_number": "६२", "content_sanskrit": "दर्शने दर्शने दुःखं तदा जह्यां च जीवितम्\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2139614, "chapter_id": 4016, "verse_number": "६३", "content_sanskrit": "धर्मे प्रयतमानानां महान् धर्मो नशिष्यति ।\nसमयं रक्षमाणानां दाराभावो भविष्यति\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2139615, "chapter_id": 4016, "verse_number": "६४", "content_sanskrit": "भार्यायां रक्ष्यमाणायां प्रजा भवति रक्षिता ।\nप्रजायां रक्ष्यमाणायामात्मा भवति रक्षितः\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2139616, "chapter_id": 4016, "verse_number": "६५", "content_sanskrit": "आत्मा हि जायते तस्यां तेन जायां विदुर्बुधाः ।\nभर्ता तु भार्यया रक्ष्यः कथं जायान्ममोदरे\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2139617, "chapter_id": 4016, "verse_number": "६६", "content_sanskrit": "वदतां वर्णधर्मांश्च ब्राह्मणानामिति श्रुतम् ।\nक्षत्रियस्य सदा धर्मो नान्यो दस्युनिबर्हणात्\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2139618, "chapter_id": 4016, "verse_number": "६७", "content_sanskrit": "पश्यतो धर्मराजस्य कीचको मां पदाऽवधीत् ।\nतव चैव समक्षं वै भीमसेन महाबल\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2139619, "chapter_id": 4016, "verse_number": "६८", "content_sanskrit": "त्वया चाहं परित्राता तस्माद् भीम जटासुरात् ।\nजयद्रथं तथैव त्वमजैषीर्भ्रातृभिः सह\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2139620, "chapter_id": 4016, "verse_number": "६९", "content_sanskrit": "जहीममपि पापिष्ठं योऽसौ मामवमन्यते ।\nकीचको राजवन्नित्यं शोककृन्मम भारत\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2139621, "chapter_id": 4016, "verse_number": "७०", "content_sanskrit": "कीचकं कामसन्तप्तं भिन्धि कुम्भमिवाश्मनि ।\nयो निमित्तमनर्थानां बहूनां मम भारत\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2139622, "chapter_id": 4016, "verse_number": "७१", "content_sanskrit": "तं चेज्जीवन्तमादित्यः प्रातरभ्युदयिष्यति ।\nविषमालोड्य पास्यामि कीचको मां वशं नयेत्\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2139623, "chapter_id": 4016, "verse_number": "७२", "content_sanskrit": "श्रेयो हि मरणं मन्ये भीमसेन तवाग्रतः\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2139624, "chapter_id": 4016, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2139625, "chapter_id": 4016, "verse_number": "७३", "content_sanskrit": "इत्युक्त्वा प्रारुदत् कृष्णा भीमस्योरसि संश्रिता\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2139626, "chapter_id": 4016, "verse_number": "७४", "content_sanskrit": "भीमश्च तां परिष्वज्य महत् सान्त्वं प्रयुज्य च ।\nकीचकं मनसाऽगच्छत् सृक्विणी परिसंलिहन्\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2139627, "chapter_id": 4016, "verse_number": "७५", "content_sanskrit": "आश्वासयित्वा बहुशो भृशमार्तां सुमध्यमाम् ।\nहेतुतत्वार्थसंयुक्तैर्वचोभिर्द्रुपदात्मजाम्\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2139628, "chapter_id": 4016, "verse_number": "७६", "content_sanskrit": "प्रमृज्य पाणिना तस्य वदनं सुसमाकुलम् ।\nउवाच चैनां दुःखार्तां भीमः क्रोधसमन्वितः\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2139629, "chapter_id": 4016, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां विराटपर्वणि चतुर्विंशोऽध्यायः ॥२४॥ कीचकवधपर्वणि नवमोऽध्यायः ॥९॥\n* * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}]