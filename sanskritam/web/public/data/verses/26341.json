[{"id": 7006341000, "chapter_id": 26341, "verse_number": "१-५१-१", "content_sanskrit": "वैशम्पायन उवाच तच्छ्रुत्वा विष्णुगदितं ब्रह्मा लोकपितामहः ।\nउवाच परमं वाक्यं हितं सर्वदिवौकसाम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006341001, "chapter_id": 26341, "verse_number": "१-५१-२", "content_sanskrit": "नास्ति किंचिद्भयं विष्णो सुराणामसुरान्तक ।\nयेषां भवानभयदः कर्णधारो रणे रणे ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006341002, "chapter_id": 26341, "verse_number": "१-५१-३", "content_sanskrit": "शक्रे जयति देवेशे त्वयि चासुरसूदने ।\nधर्मे प्रयतमानानां मानवानां कुतो भयम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006341003, "chapter_id": 26341, "verse_number": "१-५१-४", "content_sanskrit": "सत्ये धर्मे च निरतान् मानवान् विगतज्वरान् ।\nनाकाले धर्मिणो मृत्युः शक्नोति प्रसमीक्षितुम्॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006341004, "chapter_id": 26341, "verse_number": "१-५१-५", "content_sanskrit": "मानवानां च पतयः पार्थिवाश्च परस्परम् ।\nषड्भागमुपभुञ्जाना न भयं कुर्वते मिथः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006341005, "chapter_id": 26341, "verse_number": "१-५१-६", "content_sanskrit": "ते प्रजानां शुभकराः करदैरविगर्हिताः ।\nसुकरैर्विप्रयुक्तार्थाः कोशमापूरयन्त्युत ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006341006, "chapter_id": 26341, "verse_number": "१-५१-७", "content_sanskrit": "स्फीताञ्जनपदान् सर्वान् पालयन्तः क्षमापराः ।\nअतीक्ष्णदण्डांश्चतुरो वर्णाञ्जुगुपुरञ्जसा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006341007, "chapter_id": 26341, "verse_number": "१-५१-८", "content_sanskrit": "नोद्वेजनीया भूतानां सचिवैः साधुपूजिताः ।\nचतुरङ्गबलैर्गुप्ताः षड्गुणानुपयुञ्जते ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006341008, "chapter_id": 26341, "verse_number": "१-५१-९", "content_sanskrit": "धनुर्वेदपराः सर्वे सर्वे वेदेषु निष्ठिताः ।\nयजन्ते च यथाकालं यज्ञैर्विपुलदक्षिणैः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006341009, "chapter_id": 26341, "verse_number": "१-५१-१०", "content_sanskrit": "वेदानधीत्य दीक्षाभिर्महर्षीन् ब्रह्मचर्यया ।\nश्राद्धैश्च मेध्यैः शतशस्तर्पयन्ति पितामहान् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006341010, "chapter_id": 26341, "verse_number": "१-५१-११", "content_sanskrit": "नैषामविदितं किंचित्त्रिविधं भुवि दृश्यते ।\nवैदिकं लौकिकं चैव धर्मशास्त्रोक्तमेव च ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006341011, "chapter_id": 26341, "verse_number": "१-५१-१२", "content_sanskrit": "ते परावरदृष्टार्था महर्षिसमतेजसः ।\nभूयः कृतयुगं कर्तुमुत्सहन्ते नराधिपाः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006341012, "chapter_id": 26341, "verse_number": "१-५१-१३", "content_sanskrit": "तेषामेव प्रभावेण शिवं वर्षति वासवः ।\nयथार्थं च ववुर्वाता विरजस्का दिशो दश ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006341013, "chapter_id": 26341, "verse_number": "१-५१-१४", "content_sanskrit": "निरुत्पाता च वसुधा सुप्रचाराश्च खे ग्रहाः ।\nचन्द्रमाश्च सनक्षत्रः सौम्यं चरति योगतः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006341014, "chapter_id": 26341, "verse_number": "१-५१-१५", "content_sanskrit": "अनुलोमकरः सूर्यस्त्वयने द्वे चचार ह ।\nहव्यैश्च विविधैस्तप्तः शुभगन्धो हुताशनः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006341015, "chapter_id": 26341, "verse_number": "१-५१-१६", "content_sanskrit": "एवं सम्यक् प्रवृत्तेषु विवृद्धेषु मखादिषु ।\nतर्पयत्सु महीं कृत्स्नां नृणां कालभयं कुतः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006341016, "chapter_id": 26341, "verse_number": "१-५१-१७", "content_sanskrit": "तेषां ज्वलितकीर्तीनामन्योन्यवशवर्तिनाम् ।\nराज्ञां बलैर्बलवता पीड्यते वसुधातलम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006341017, "chapter_id": 26341, "verse_number": "१-५१-१८", "content_sanskrit": "सेयं भारपरिश्रान्ता पीड्यमाना नराधिपैः ।\nपृथिवी समनुप्राप्ता नौरिवासन्नविप्लवा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006341018, "chapter_id": 26341, "verse_number": "१-५१-१९", "content_sanskrit": "युगान्तसदृशै रूपैः शैलोच्चलितबन्धना ।\nजलोत्पीडाकुला स्वेदं धारयन्ती मुहुर्मुहुः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006341019, "chapter_id": 26341, "verse_number": "१-५१-२०", "content_sanskrit": "क्षत्रियाणां वपुर्भिश्च तेजसा च बलेन च ।\nनृणां च राष्ट्रैर्विस्तीर्णैः श्राम्यतीव वसुन्धरा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006341020, "chapter_id": 26341, "verse_number": "१-५१-२१", "content_sanskrit": "पुरे पुरे नरपतिः कोटिसंख्यैर्बलैर्वृतः ।\nराष्ट्रे राष्ट्रे च बहवो ग्रामाः शतसहस्रशः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006341021, "chapter_id": 26341, "verse_number": "१-५१-२२", "content_sanskrit": "भूमिपानां सहस्रैश्च तेषां च बलिनां बलैः ।\nग्रामायुताढ्यै राष्ट्रैश्च भूमिर्निर्विवराकृता ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006341022, "chapter_id": 26341, "verse_number": "१-५१-२३", "content_sanskrit": "सेयं निरामयं कृत्वा निश्चेष्टा कालमग्रतः ।\nप्राप्ता ममालयं विष्णो भवांश्चास्याः परा गतिः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006341023, "chapter_id": 26341, "verse_number": "१-५१-२४", "content_sanskrit": "कर्मभूमिर्मनुष्याणां भूमिरेषा व्यथां गता ।\nयथा न सीदेत् तत् कार्यं जगत्येषा हि शाश्वती ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006341024, "chapter_id": 26341, "verse_number": "१-५१-२५", "content_sanskrit": "अस्या हि पीडने दोषो महान् स्यान्मधुसूदन ।\nक्रियालोपश्च लोकानां पीडितं च जगद् भवेत् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006341025, "chapter_id": 26341, "verse_number": "१-५१-२६", "content_sanskrit": "श्राम्यते व्यक्तमेवेयं पार्थिवौघप्रपीडिता ।\nसहजां या क्षमां त्यक्त्वा चलत्वमचला गता ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006341026, "chapter_id": 26341, "verse_number": "१-५१-२७", "content_sanskrit": "तदस्याः श्रुतवन्तः स्म तच्चापि भवता श्रुतम् ।\nभारावतरणार्थं  हि मन्त्रयाम सह त्वया ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006341027, "chapter_id": 26341, "verse_number": "१-५१-२८", "content_sanskrit": "सत्पथे हि स्थिताः सर्वे राजानो राष्ट्रवर्धनाः ।\nनराणां च त्रयो वर्णा ब्राह्मणाननुयायिनः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006341028, "chapter_id": 26341, "verse_number": "१-५१-२९", "content_sanskrit": "सर्वं सत्यपरं वाक्यं वर्णा धर्मपरास्तथा ।\nसर्वे वेदपरा विप्राः सर्वे विप्रपरा नराः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006341029, "chapter_id": 26341, "verse_number": "१-५१-३०", "content_sanskrit": "एवं जगति वर्तन्ते मनुष्या धर्मकारणात् ।\nयथा धर्मवधो न स्यात् तथा मन्त्रः प्रवर्त्यताम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006341030, "chapter_id": 26341, "verse_number": "१-५१-३१", "content_sanskrit": "सतां गतिरियं नान्या धर्मश्चास्याः  सुसाधनम् ।\nराज्ञां चैव वधः कार्यो धरण्या भारनिर्णये ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006341031, "chapter_id": 26341, "verse_number": "१-५१-३२", "content_sanskrit": "तदागच्छ महाभाग सह वै मन्त्रकारणात् ।\nव्रजामो मेरुशिखरं पुरस्कृत्य वसुंधराम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]