[{"id": 7001647000, "chapter_id": 21647, "verse_number": "१-३३-१", "content_sanskrit": "नारद उवाच ।\nभगवन्सर्वमाख्यातं यत्पृष्टं विदुषा त्वया ।\nसंसारपाशबद्धानां दुःखानि सुबहूनि च ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001647001, "chapter_id": 21647, "verse_number": "१-३३-२", "content_sanskrit": "अस्य संसारपाशस्य च्छेदकः कतमः स्मृतः ।\nयेनोपायेन मोक्षः स्यात्तन्मे ब्रूहि तपोधन ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001647002, "chapter_id": 21647, "verse_number": "१-३३-३", "content_sanskrit": "प्राणिभिः कर्मजालानि क्रियंते प्रत्यहं भृशम् ।\nभुज्यंते च मुनिश्रेष्ठ तेषां नाशः कथं भवेत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001647003, "chapter_id": 21647, "verse_number": "१-३३-४", "content_sanskrit": "कर्मणा देहमाप्नोति देही कामेन बध्यते ।\nकामाल्लोभाभिभूतः स्याल्लोभात्क्रोधपरायणाः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001647004, "chapter_id": 21647, "verse_number": "१-३३-५", "content_sanskrit": "क्रोधाञ्च धर्मनाशः स्याद्धर्मनाशान्मतिभ्रमः ।\nप्रनष्टबुद्धिर्मनुजः पुनः पापं करोति च ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001647005, "chapter_id": 21647, "verse_number": "१-३३-६", "content_sanskrit": "तस्माद्देहं पापमूलं पापकर्मरतं तथा ।\nयथा देहभ्रमत्यक्त्वा मोक्षभाक्स्यात्तथा वद ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001647006, "chapter_id": 21647, "verse_number": "१-३३-७", "content_sanskrit": "सनक उवाच ।\nसाधु साधु महाप्राज्ञ मतिस्ते विमलोर्जिता ।\nयस्मात्संसारदुःखान्नो मोक्षोपायमभीप्ससि ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001647007, "chapter_id": 21647, "verse_number": "१-३३-८", "content_sanskrit": "यस्याज्ञया जगत्सर्वं ब्रह्म्ना सृजति सुव्रत ।\nहरिश्च पालको रुद्रो नाशकः स हि मोक्षदः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001647008, "chapter_id": 21647, "verse_number": "१-३३-९", "content_sanskrit": "अहमादिविशेषांता जातायस्य प्रभावतगः ।\nतं विद्यान्मोक्षदं विष्णुं नारायणमनामयम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001647009, "chapter_id": 21647, "verse_number": "१-३३-१०", "content_sanskrit": "यस्याभिन्नमिदं सर्वं यच्चेंगद्यञ्च नेंगति ।\nतमुग्रमजरं देवं ध्यात्वा दुःखात्प्रमुच्यते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001647010, "chapter_id": 21647, "verse_number": "१-३३-११", "content_sanskrit": "अविकारमजं शुद्धं स्वप्रकाशं निरंजनम् ।\nज्ञानरुपं सदानंदं प्राहुर्वैमोक्षसाधनम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001647011, "chapter_id": 21647, "verse_number": "१-३३-१२", "content_sanskrit": "यस्यावताररुपाणि ब्रह्माद्या देवतागणाः ।\nसमर्चयंति तं विद्याच्छाश्वतस्थानदं हरिम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001647012, "chapter_id": 21647, "verse_number": "१-३३-१३", "content_sanskrit": "जितप्राणा जिताहाराः सदा ध्यानपरायणाः ।\nहृदि पश्यंति यं सत्यं तं जामीहि सुखावहम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001647013, "chapter_id": 21647, "verse_number": "१-३३-१४", "content_sanskrit": "निर्गुणोऽपि गुणाधारो लोकानुग्रहरुपधृक् ।\nआकाशमध्यगः पूर्णस्तं प्राहुर्मोक्षदं नृणाम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001647014, "chapter_id": 21647, "verse_number": "१-३३-१५", "content_sanskrit": "अध्यक्षः सर्वकार्याणां देहिनो हृदये स्थितः ।\nअनूपमोऽखिलाधारस्तां देवं शरणं व्रजेत् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001647015, "chapter_id": 21647, "verse_number": "१-३३-१६", "content_sanskrit": "सर्वं संगृह्य कल्पांते शेते यस्तु जले स्वयम् ।\nतं प्राहुर्मोक्षदं विष्णुं मुनयस्तत्त्वदर्शिनः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001647016, "chapter_id": 21647, "verse_number": "१-३३-१७", "content_sanskrit": "वेदार्थविद्भिः कर्मज्ञैरिज्यते विविधैर्मखैः ।\nस एव कर्मफलदो मोक्षदोऽकामकर्मणाम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001647017, "chapter_id": 21647, "verse_number": "१-३३-१८", "content_sanskrit": "हव्यकव्यादिदानेषु देवतापितृरूपधृक् ।\nभुंक्ते य ईश्वरोऽव्यक्तस्तं प्राहुर्मोक्षदं प्रभुम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001647018, "chapter_id": 21647, "verse_number": "१-३३-१९", "content_sanskrit": "ध्यातः प्रणमितो वापि पूजितो वापि भक्तितः ।\nददाति शाश्वतं स्थानं तं दयालुं समर्चयेत् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001647019, "chapter_id": 21647, "verse_number": "१-३३-२०", "content_sanskrit": "आधारः सर्वभूतानांमेको यः पुरुषः परः ।\nजरामरणनिर्मुक्तो मोक्षदः सोऽव्ययो हरिः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001647020, "chapter_id": 21647, "verse_number": "१-३३-२१", "content_sanskrit": "संपूज्य यस्य पादाब्जं देहिनोऽपि मुनीश्वर ।\nअमृतत्वं भजंत्याशु तं विदुः पुरुषोत्तमम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001647021, "chapter_id": 21647, "verse_number": "१-३३-२२", "content_sanskrit": "आनन्दमजरं ब्रह्म परं ज्योतिः सनातनम् ।\nपरात्परतरं यञ्च तद्विष्णोः परमं पदम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001647022, "chapter_id": 21647, "verse_number": "१-३३-२३", "content_sanskrit": "अद्वयं निगुणं नित्यमद्वितीयमनौपमम् ।\nपरिपूर्णं ज्ञानमयं विदुर्मोक्षप्रताधकम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001647023, "chapter_id": 21647, "verse_number": "१-३३-२४", "content_sanskrit": "एवंभूतं परं वस्तु योगमार्गविधानतः ।\nय उपास्ते सदा योगी स याति परमं पदम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001647024, "chapter_id": 21647, "verse_number": "१-३३-२५", "content_sanskrit": "परसर्वसंगपरित्यागी शमादिगुणसंयुतः ।\nकामर्द्यैवर्जितोयोगी लभते परमं पदम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001647025, "chapter_id": 21647, "verse_number": "१-३३-२६", "content_sanskrit": "नारद उवाच ।\nकर्मणा केन योगस्य सिद्धिर्भवति योगिनाम् ।\nतदुपायं यथातत्त्वं ब्रूहि मे वदतां वर ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001647026, "chapter_id": 21647, "verse_number": "१-३३-२७", "content_sanskrit": "सनक उवाच ।\nज्ञानलभ्यं परं मोक्षं प्राहुस्तत्त्वार्थचिंतकाः ।\nयज्ज्ञानं भक्तिमूलं च भक्तिः कर्मवतां तथा ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001647027, "chapter_id": 21647, "verse_number": "१-३३-२८", "content_sanskrit": "दानानि यज्ञा विविधास्तीर्थयात्रादयः कृताः ।\nयेन जन्मसहस्त्रेषु तस्य भक्तिर्भवेद्धरौ ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001647028, "chapter_id": 21647, "verse_number": "१-३३-२९", "content_sanskrit": "अक्षयः परमो धर्मो भक्तिलेशेन जायते ।\nश्रद्धया परया चैव सर्वं पापं प्रणश्यति ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001647029, "chapter_id": 21647, "verse_number": "१-३३-३०", "content_sanskrit": "सर्वपापेषु नष्टेषु बुद्धिर्भवति निर्मला ।\nसैव बुद्धिः समाख्याता ज्ञानशब्देन सूरिभिः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001647030, "chapter_id": 21647, "verse_number": "१-३३-३१", "content_sanskrit": "ज्ञानं च मोक्षदं प्राहुस्तज्ज्ञानं योगिनां भवेत् ।\nयोगस्तु द्विविधः प्रोक्तः कर्मज्ञानप्रभेदतः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001647031, "chapter_id": 21647, "verse_number": "१-३३-३२", "content_sanskrit": "क्रियायोगं विना नॄणां ज्ञानयोगो न सिध्यति ।\nक्रियायोगरतस्तस्माच्छ्रद्धया हरिमर्चयेत् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001647032, "chapter_id": 21647, "verse_number": "१-३३-३३", "content_sanskrit": "द्विजभूम्यग्निसूर्याम्बुधातुहृञ्चित्रसंज्ञिताः ।\nप्रतिमाः केशवस्यैता पूज्य एतासु भक्तितः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001647033, "chapter_id": 21647, "verse_number": "१-३३-३४", "content_sanskrit": "कर्मणा मनसा वाचा परिपीडापराङ्मुखः ।\nतस्मात्सर्वगतं विष्णुं पूजयेद्भक्तिसंयुतः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001647034, "chapter_id": 21647, "verse_number": "१-३३-३५", "content_sanskrit": "अहिंसा सत्यमक्रोधो ब्रह्मचर्यापरिग्रहौ ।\nअनीर्ष्या च दया चैव योगयोरूभयोः समाः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001647035, "chapter_id": 21647, "verse_number": "१-३३-३६", "content_sanskrit": "चराचरात्मकं विश्वं विष्णुरेव सनातनः ।\nइति निश्चित्य मनसा योगद्वितयमभ्यसेत् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001647036, "chapter_id": 21647, "verse_number": "१-३३-३७", "content_sanskrit": "आत्मवत्सर्वभूतानि ये मन्यंते मनीषिणः ।\nते जानंति परं भावं देवदेवस्य चक्रिणः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001647037, "chapter_id": 21647, "verse_number": "१-३३-३८", "content_sanskrit": "यदि क्रोधादिदुष्टात्मा पूजाध्यानपरो भवेत् ।\nन तस्य तुष्यते विष्णुर्यतो धर्मपतिः स्मृतः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001647038, "chapter_id": 21647, "verse_number": "१-३३-३९", "content_sanskrit": "यदि कामादिदुष्टात्मा देव पूजापरो भवेत् ।\nदंभाचारः स विज्ञेयः सर्वपातकिभिः समः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001647039, "chapter_id": 21647, "verse_number": "१-३३-४०", "content_sanskrit": "तपः पूजाध्यानपरोयस्त्वसूयारतो भवेत् ।\nतत्तपः सा च पूजा च तद्ध्यानं हि निरर्थकम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001647040, "chapter_id": 21647, "verse_number": "१-३३-४१", "content_sanskrit": "तस्मात्सर्वात्मकं विष्णुं शमादिगुणतत्परः ।\nमुक्तयर्थमर्चयेत्सम्यक् क्रियायोगपरो नरः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001647041, "chapter_id": 21647, "verse_number": "१-३३-४२", "content_sanskrit": "कर्मणा मनसा वाचा सर्वलोकहिते रतः ।\nसमर्चयति देवेशं क्रियायोगः स उच्यते ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001647042, "chapter_id": 21647, "verse_number": "१-३३-४३", "content_sanskrit": "नारायणं जगद्योनिं सर्वांतयर्यामिणं हरिम् ।\nस्तोत्राद्यैः स्तौति यो विष्णुं कर्मयोगी स उच्यते ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001647043, "chapter_id": 21647, "verse_number": "१-३३-४४", "content_sanskrit": "उपवासादिभिश्चैव पुराणश्रवणादिभिः ।\nपुष्पाद्यैश्चार्चनं विष्णोः क्रियायोग उदाहृतः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001647044, "chapter_id": 21647, "verse_number": "१-३३-४५", "content_sanskrit": "एवं भक्तिमतां विष्णौ क्रियायोगरतात्मनाम् ।\nसर्वपापानि नश्यंति पूर्वजन्मार्जितानि वै ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001647045, "chapter_id": 21647, "verse_number": "१-३३-४६", "content_sanskrit": "पापक्षयाच्छुद्वमतिर्वांछति ज्ञानमुत्तमम् ।\nज्ञानं हि मोक्षदं ज्ञेयं तदुपायं वदामि ते ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001647046, "chapter_id": 21647, "verse_number": "१-३३-४७", "content_sanskrit": "चराचरात्मके लोके नित्यं चानित्यमेव च ।\nसम्यग् विचारयेद्धीमान्सद्भिः शास्त्रार्थकोविदैः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001647047, "chapter_id": 21647, "verse_number": "१-३३-४८", "content_sanskrit": "अनित्यास्तु पदार्था वै नित्यमेको हरिः स्मृतः ।\nअनित्यानि परित्यज्य नित्यमेव समाश्रयेत् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001647048, "chapter_id": 21647, "verse_number": "१-३३-४९", "content_sanskrit": "इहामुत्र च भोगेषु विरक्तश्च तथा भवेत् ।\nअविरक्तो भवेद्यस्तु स संसारे प्रवर्तते ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001647049, "chapter_id": 21647, "verse_number": "१-३३-५०", "content_sanskrit": "अनित्येषु पदार्थेषु यस्तु रागी भवेन्नरः ।\nतस्य संसारविच्छित्तिः कदाचिन्नैव जायते ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001647050, "chapter_id": 21647, "verse_number": "१-३३-५१", "content_sanskrit": "शमादिगुणसंपन्नो मुमुक्षुर्ज्ञानमभ्यसेत् ।\nशमादिगुणहीनस्य ज्ञानं नैव च सिध्यति ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001647051, "chapter_id": 21647, "verse_number": "१-३३-५२", "content_sanskrit": "रागद्वेषविहीनो यः शमादिगुणसंयुतः ।\nहरिध्यानपरो नित्यं मुमुक्षुरभिधीयते ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001647052, "chapter_id": 21647, "verse_number": "१-३३-५३", "content_sanskrit": "चतुर्भिः साधनैरेभिर्विशुद्धमतिरुच्यते ।\nसर्वगं भावयेद्विष्णुं सर्वभूतदयापरः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001647053, "chapter_id": 21647, "verse_number": "१-३३-५४", "content_sanskrit": "क्षराक्षरात्मकं विश्वं व्याप्य नारायणः स्थितः ।\nइति जानाति यो विप्रतज्ज्ञानं योगजं विदुः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001647054, "chapter_id": 21647, "verse_number": "१-३३-५५", "content_sanskrit": "योगोपायमतो वक्ष्ये संसारविनिवर्त्तकम् ।\nयोगो ज्ञानं विशुद्धं स्यात्तज्ज्ञानं मोक्षदं विदुः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001647055, "chapter_id": 21647, "verse_number": "१-३३-५६", "content_sanskrit": "आत्मानं द्विविधं प्राहुः परापरविभेदतः ।\nद्वे ब्रह्मणी वेदितव्ये इति चाथर्वर्णी श्रुतिः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001647056, "chapter_id": 21647, "verse_number": "१-३३-५७", "content_sanskrit": "परस्तु निर्गुणः प्रोक्तो ह्यहंकारयुतोऽपरः ।\nतयोरभेदविज्ञानं योग इत्यभिधीयते ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001647057, "chapter_id": 21647, "verse_number": "१-३३-५८", "content_sanskrit": "पंचभूतात्मके देहे यः साक्षी हृदये स्थितः ।\nअपरः प्रोच्यते सद्भिः परमात्मा परः स्मृतः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001647058, "chapter_id": 21647, "verse_number": "१-३३-५९", "content_sanskrit": "शरीरं क्षेव्रमित्याहुस्तत्स्थः क्षेत्रज्ञ उच्यते ।\nअव्यक्तः परमः शुद्धः परिपूर्ण उदाहृतः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001647059, "chapter_id": 21647, "verse_number": "१-३३-६०", "content_sanskrit": "यदा त्वभेदविज्ञानं जीवात्मपरमात्मनोः ।\nभवेत्तदा मुनिश्रेष्ठ पाशच्छेदोऽपरात्मनः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001647060, "chapter_id": 21647, "verse_number": "१-३३-६१", "content_sanskrit": "एकः शुद्धोऽक्षरो नित्यः परमात्मा जगन्मयः ।\nनृणां विज्ञानभेदेन भेदवानिव लक्ष्यते ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001647061, "chapter_id": 21647, "verse_number": "१-३३-६२", "content_sanskrit": "एकमेवाद्वितीयं यत्परं ब्रह्म सनातनम् ।\nगीयमानं च वेदांतैस्तस्मान्नास्ति परं द्विज ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001647062, "chapter_id": 21647, "verse_number": "१-३३-६३", "content_sanskrit": "न तस्य कर्म कार्यं वा रुपं वर्णमथापि वा ।\nकर्त्तृत्वं वापि भोक्तृत्वं निर्गुणस्य परात्मनः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001647063, "chapter_id": 21647, "verse_number": "१-३३-६४", "content_sanskrit": "निदानं सर्वहेतूनां तेजो यत्तेजसां परम् ।\nकिमप्यन्यद्यतो नास्ति तज्ज्ञेयं मुक्तिहेतवे ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001647064, "chapter_id": 21647, "verse_number": "१-३३-६५", "content_sanskrit": "शब्दब्रह्ममयं यत्तन्महावाक्यादिकं द्विज ।\nतद्विचारोद्भवं ज्ञानं परं मोक्षस्य साधनम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001647065, "chapter_id": 21647, "verse_number": "१-३३-६६", "content_sanskrit": "सम्यग्ज्ञानविहीनानां दृश्यते विविधं जगतग् ।\nपरमज्ञानिनामेतत्परब्रह्मात्मकं द्विज ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001647066, "chapter_id": 21647, "verse_number": "१-३३-६७", "content_sanskrit": "एक एव परानन्दो निर्गुणः परतः परः ।\nभाति विज्ञानभेदेन बहुरुपधरोऽव्ययः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001647067, "chapter_id": 21647, "verse_number": "१-३३-६८", "content_sanskrit": "मायिनो मायया भेदं पश्यन्ति परमात्मनि ।\nतस्मान्मायां त्यजेद्योगान्मुमुक्षुर्द्विजसत्तम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001647068, "chapter_id": 21647, "verse_number": "१-३३-६९", "content_sanskrit": "नासद्रूपान सद्रूपा माया नैवोभयात्मिका ।\nअनिर्वाच्या ततो ज्ञेया भेदबुद्धिप्रदार्यिनी ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001647069, "chapter_id": 21647, "verse_number": "१-३३-७०", "content_sanskrit": "मायैव ज्ञानशब्देन बुद्ध्यते मुनिसत्तम ।\nतस्मादज्ञानविच्छेदो भवेद्रौजितमायिनाम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001647070, "chapter_id": 21647, "verse_number": "१-३३-७१", "content_sanskrit": "सनातनं परं ब्रह्म ज्ञानशब्देन कथ्यते ।\nज्ञानिनां परमात्मा वै हृदि भाति निरन्तरम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7001647071, "chapter_id": 21647, "verse_number": "१-३३-७२", "content_sanskrit": "अज्ञानं नाशयेद्योगी योगेन मुनिसत्तम ।\nअष्टांगैः सिद्ध्यते योगस्तानि वक्ष्यामि तत्त्वतः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7001647072, "chapter_id": 21647, "verse_number": "१-३३-७३", "content_sanskrit": "यमाश्च नियमाश्चैव आसनानि च सत्तम ।\nप्राणायामः प्रत्याहारो धारणा ध्यानमेव च ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7001647073, "chapter_id": 21647, "verse_number": "१-३३-७४", "content_sanskrit": "समाधिश्च मुनिश्रेष्ट योगाङ्गानि यथाक्रमम् ।\nएषां संक्षेपतो वक्ष्ये लक्षणानि मुनीश्वर ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7001647074, "chapter_id": 21647, "verse_number": "१-३३-७५", "content_sanskrit": "अहिंसा सत्यमस्तेयं ब्रह्मचर्यापरिग्रहौ ।\nअक्रोधस्चानसूया च प्रोक्ताः संक्षेपतो यमाः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7001647075, "chapter_id": 21647, "verse_number": "१-३३-७६", "content_sanskrit": "सर्वेषामेव भूतानामक्लेशजननं हि यत् ।\nअहिंसा कथिता सद्भिर्योगसिद्धिप्रदायिनी ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7001647076, "chapter_id": 21647, "verse_number": "१-३३-७७", "content_sanskrit": "यथार्थकथनं यञ्च धर्माधर्मविवेकतः ।\nसत्यं प्राहुर्मुनिश्रेष्ट अस्तेयं श्रृणु साम्प्रतम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7001647077, "chapter_id": 21647, "verse_number": "१-३३-७८", "content_sanskrit": "चौर्येण वा बलेनापि परस्वहरणं हि यत् ।\nस्तेयमित्युच्यते सद्भिरस्तेयं तद्विपर्ययम् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7001647078, "chapter_id": 21647, "verse_number": "१-३३-७९", "content_sanskrit": "सर्वत्र मैथुनत्यागो ब्रह्मचर्यं प्रकीर्त्तितम् ।\nब्रह्मचर्यपरित्यागाज्ज्ञानवानपि पातकी ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7001647079, "chapter_id": 21647, "verse_number": "१-३३-८०", "content_sanskrit": "सर्वसंगपरित्यागी मैथुनेयस्तु वर्त्तते ।\nस चंडालसमो ज्ञेयः सर्ववर्णबहिष्कृतः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7001647080, "chapter_id": 21647, "verse_number": "१-३३-८१", "content_sanskrit": "यस्तु योगरतो विप्र विषयेषु स्पृहान्वितः ।\nतत्संभाषणमात्रेण ब्रह्महत्या भवेन्नृणाम् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7001647081, "chapter_id": 21647, "verse_number": "१-३३-८२", "content_sanskrit": "सर्वसंगपरित्यागी पुनः संगी भवेद्यदि ।\nतत्संगसंगिनां संगान्महापातकदोषभाक् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7001647082, "chapter_id": 21647, "verse_number": "१-३३-८३", "content_sanskrit": "अनादानं हि द्रव्याणामापद्यपि मुनीश्वर ।\nअपरिग्रह इत्युक्तो योगसंसिद्धिकारकः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7001647083, "chapter_id": 21647, "verse_number": "१-३३-८४", "content_sanskrit": "आत्मनस्तु समुत्कर्षादतिनिष्ठुरभाषणम् ।\nक्रोधमाहुर्धर्मविदो ह्यक्रोधस्तद्विपर्ययः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7001647084, "chapter_id": 21647, "verse_number": "१-३३-८५", "content_sanskrit": "धनाद्यैरधिकं दृष्ट्वा भृशं मनसि तापनम् ।\nअसूया कीर्तिता सद्भिस्तत्त्यागो ह्यनसूयता ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7001647085, "chapter_id": 21647, "verse_number": "१-३३-८६", "content_sanskrit": "एवं संक्षेपतः प्रोक्ता यमा विबुधसत्तम ।\nनियमानपि वक्ष्यामितुभ्यं ताञ्छृणु नारद ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7001647086, "chapter_id": 21647, "verse_number": "१-३३-८७", "content_sanskrit": "तपःस्वाध्यायसंतोषाः शौचं च हरिपूजनम् ।\nसंध्योपासनमुख्याश्च नियमाः परिकीर्त्तिताः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7001647087, "chapter_id": 21647, "verse_number": "१-३३-८८", "content_sanskrit": "चांद्रायणादिभिर्यत्र शरीरस्य विशोषणम् ।\nतपो निगदितं सद्भिर्योगसाधनमुत्तमम् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7001647088, "chapter_id": 21647, "verse_number": "१-३३-८९", "content_sanskrit": "प्रणवस्योपनिषदां द्वादशार्णस्य च द्विज ।\nअष्टाक्षरस्य मंत्रस्य महावाक्यचयस्य च ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7001647089, "chapter_id": 21647, "verse_number": "१-३३-९०", "content_sanskrit": "जपः स्वाध्याय उदितो योगसाधनमुत्तमम् ।\nस्वाध्यायं यस्त्यजेन्मूढस्तस्य योगो न सिध्यति ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7001647090, "chapter_id": 21647, "verse_number": "१-३३-९१", "content_sanskrit": "योगं विनापि स्वाध्यायात्पापनाशो भवेन्नृणाम् ।\nस्वाध्यायैस्तोष्यमाणाश्च प्रसीदंति हि देवताः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7001647091, "chapter_id": 21647, "verse_number": "१-३३-९२", "content_sanskrit": "जपस्तु त्रिविधः प्रोक्तो वाचिकोपांशुमानसः ।\nत्रिविधेऽपि च विप्रेन्द्र पूर्वात्पूर्वात्परो वरः ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7001647092, "chapter_id": 21647, "verse_number": "१-३३-९३", "content_sanskrit": "मंत्रस्योच्चारणं सम्यक्स्फुटाक्षरपदं यथा ।\nजपस्तु वाचिकः प्रोक्तः सर्वयज्ञफलप्रदः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7001647093, "chapter_id": 21647, "verse_number": "१-३३-९४", "content_sanskrit": "मंत्रस्योच्चारणे किंचित्पदात्पदविवेचनम् ।\nस तूपांशुर्जपः प्रोक्तः पूर्वस्माद्द्विगुणोऽधिकः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7001647094, "chapter_id": 21647, "verse_number": "१-३३-९५", "content_sanskrit": "विधाय ह्यक्षरश्रेण्यां तत्तदर्थविचारणम् ।\nस जपोमानसः प्रोक्तो योगसिद्धिप्रदायकः ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7001647095, "chapter_id": 21647, "verse_number": "१-३३-९६", "content_sanskrit": "जपेन देवता नित्यं स्तुवतः संप्रसीदति ।\nतस्मात्स्वाध्यायसंपन्नो लभेत्सर्वान्मनोरथान् ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7001647096, "chapter_id": 21647, "verse_number": "१-३३-९७", "content_sanskrit": "यदृच्छालाभसंतुष्टिः संतोष इति गीयते ।\nसंतोषहीनः पुरुषो न लभेच्छर्म कुत्रचित् ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7001647097, "chapter_id": 21647, "verse_number": "१-३३-९८", "content_sanskrit": "न जातुकामः कामानामुपभोगेन शाम्यति ।\nइतोऽधिकं कदा लप्स्य इति कामस्तु वर्द्धते ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7001647098, "chapter_id": 21647, "verse_number": "१-३३-९९", "content_sanskrit": "तस्मात्कामं परित्यज्य देहसंशोषकारणम् ।\nयदृच्छालाभसंतुष्टो भवेद्धर्मपरायणः ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7001647099, "chapter_id": 21647, "verse_number": "१-३३-१००", "content_sanskrit": "बाह्याभ्यन्तरभेदेन शौचं तु द्विविधं स्मृतम् ।\nमृज्जलाभ्यां बहिः शुद्धिर्भावशुद्धिस्तथान्तरम् ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7001647100, "chapter_id": 21647, "verse_number": "१-३३-१०१", "content_sanskrit": "अन्तःशुद्धिविहीनैस्तु येऽध्वरा विविधाः कृताः ।\nन फलंति मुनीश्रेष्ट भस्मनि न्यस्तहव्यवत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7001647101, "chapter_id": 21647, "verse_number": "१-३३-१०२", "content_sanskrit": "भावशुद्धिविहीनानां समस्तं कर्मनिष्फलम् ।\nतस्माद्रागादिकं सर्वं परित्यज्य सुखी भवेत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7001647102, "chapter_id": 21647, "verse_number": "१-३३-१०३", "content_sanskrit": "मृदाभारसहस्त्रैस्तु कुम्भकोटिजलैस्तथा ।\nकृतशौचोऽपि दुष्टात्मा चंडालसदृशः स्मृतः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7001647103, "chapter_id": 21647, "verse_number": "१-३३-१०४", "content_sanskrit": "अंतःशुद्धिविहीनस्तु देवपूजापरो यदि ।\nतमेव दैवतं हंति नरकं च प्रपद्यते ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7001647104, "chapter_id": 21647, "verse_number": "१-३३-१०५", "content_sanskrit": "अंतःशुद्धिविहीनश्च बहिःशुद्धिं करोति यः ।\nअलंकृतः सुराभाण्ड इव शांतिं न गच्छति ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7001647105, "chapter_id": 21647, "verse_number": "१-३३-१०६", "content_sanskrit": "मनश्शुद्धिविहीना ये तीर्थयात्रां प्रकुर्वते ।\nन तान्पुंनति तीर्थानि सुराभांडमिवापगा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7001647106, "chapter_id": 21647, "verse_number": "१-३३-१०७", "content_sanskrit": "वाचा धर्मान्प्रवलदति मनसा पापमिच्छति ।\nजानीयात्तं मुनिश्रेष्ट महापातकिनां वरम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7001647107, "chapter_id": 21647, "verse_number": "१-३३-१०८", "content_sanskrit": "विशुद्धमानसा ये तु धर्ममात्रमनुत्तमम् ।\nकुर्वंति तत्फलं विद्यादक्षयं सुखदायकम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7001647108, "chapter_id": 21647, "verse_number": "१-३३-१०९", "content_sanskrit": "कर्मणा मनसा वाचा स्तुतिश्रवण पूजनैः ।\nहरिभक्तिर्दृढा यस्य हरिपूजेति गीयते ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7001647109, "chapter_id": 21647, "verse_number": "१-३३-११०", "content_sanskrit": "यमाश्च नियमाश्चैव संक्षेपेण प्रबोधिताः ।\nएभिर्विशुद्धमनसां मोक्षं हस्तगतं विदुः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7001647110, "chapter_id": 21647, "verse_number": "१-३३-१११", "content_sanskrit": "यमैश्च नियमैश्चैव स्थिरबुद्धिर्जितेन्द्रियः ।\nअभ्यसेदासनंसम्यग्योगसाधनमुत्तमम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7001647111, "chapter_id": 21647, "verse_number": "१-३३-११२", "content_sanskrit": "पद्मकं स्वस्तिकं पीठं सैंहं कौक्कुटकौंजरे ।\nकौर्मंवज्रासनं चैव वाराहं मृगचैलिकम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7001647112, "chapter_id": 21647, "verse_number": "१-३३-११३", "content_sanskrit": "क्रौञ्चं च नालिकं चैव सर्वतोभद्रमेव च ।\nवार्षभं नागमात्स्ये च वैयान्घं चार्द्धचंद्रकम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7001647113, "chapter_id": 21647, "verse_number": "१-३३-११४", "content_sanskrit": "दंडवातासनं शैलं स्वभ्रं मौद्गरमेव च ।\nमाकरं त्रैपथं काष्ठं स्थाणुं वैकर्णिकं तथा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7001647114, "chapter_id": 21647, "verse_number": "१-३३-११५", "content_sanskrit": "भौमं वीरासनं चैव योगसाधनकारणम् ।\nत्रिंशत्संख्यान्यासनानि मुनीन्द्रैः कथितानि वै ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7001647115, "chapter_id": 21647, "verse_number": "१-३३-११६", "content_sanskrit": "एषामेकतमं बद्धा गुरुभक्तिपरायणः ।\nउपासको जयेत्प्राणान्द्वन्द्वातीतो विमत्सरः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7001647116, "chapter_id": 21647, "verse_number": "१-३३-११७", "content_sanskrit": "प्राङ्मुखोदङ्मुखो वापि तथा प्रत्यङ्मुखोऽपि वा ।\nअभ्यासेन जयेत्प्राणान्निःशब्दे जनवर्जिते ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7001647117, "chapter_id": 21647, "verse_number": "१-३३-११८", "content_sanskrit": "प्राणो वायुः शरीरस्थ आयामस्तस्य निग्रहः ।\nप्राणायाम इति प्रोक्तो द्विविधः स प्रकीर्त्तितः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7001647118, "chapter_id": 21647, "verse_number": "१-३३-११९", "content_sanskrit": "अगर्भश्च सगर्भश्च द्वितीयस्तु तयोर्वरः ।\nजयध्यानं विनागर्भः सगर्भस्तत्समन्वितः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7001647119, "chapter_id": 21647, "verse_number": "१-३३-१२०", "content_sanskrit": "रेचकः पूरकश्चैव कुंभकः शून्यकस्तथा ।\nएवं चतुर्विधः प्रोक्तः प्राणायामो मनीषिभिः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7001647120, "chapter_id": 21647, "verse_number": "१-३३-१२१", "content_sanskrit": "जंतूनां दक्षिणा नाडी पिंगला परिकीर्तिता ।\nसूर्यदैवतका चैव पितृयोनिरिति श्रुता ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7001647121, "chapter_id": 21647, "verse_number": "१-३३-१२२", "content_sanskrit": "देवयोनिरिति ख्याता इडा नाडी त्वदक्षिणा ।\nतत्राधिदैवत चंद्रं जानीहि मुनिसत्तमं ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7001647122, "chapter_id": 21647, "verse_number": "१-३३-१२३", "content_sanskrit": "एतयोरुभयोर्मध्ये सुषुम्णा नाडिका स्मृता ।\nअतिसूक्ष्मा गुह्यतमा ज्ञेया सा ब्रह्मदैवता ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7001647123, "chapter_id": 21647, "verse_number": "१-३३-१२४", "content_sanskrit": "वामेन रेचयेद्वायुं रेचनाद्रेचकः स्मृतः ।\nपूरयेद्दक्षिणेनैव पूरणात्पूरकः स्मृतः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7001647124, "chapter_id": 21647, "verse_number": "१-३३-१२५", "content_sanskrit": "स्वदेहपूरितं वायं निगृह्य न विमृंचति ।\nसंपूर्णकुंभवत्तिष्टेत्कुम्भकः स हि विश्रुतः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7001647125, "chapter_id": 21647, "verse_number": "१-३३-१२६", "content_sanskrit": "न गृह्णाति न त्यजति वायुमंतर्बहिः स्थितम् ।\nविद्धि तच्छून्यकं नाम प्राणायामं यथास्थितम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7001647126, "chapter_id": 21647, "verse_number": "१-३३-१२७", "content_sanskrit": "शनैःशनैर्विजेतव्यः प्राणो मत्तगजेन्द्रवत् ।\nअन्यथा खलु जायन्ते महारोगा भयंकराः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7001647127, "chapter_id": 21647, "verse_number": "१-३३-१२८", "content_sanskrit": "क्रमेण योजयेद्वायुं योगी विगतकल्मषः ।\nस सर्वपापनिर्मुक्तो ब्रह्मणः पदमाप्नुयात् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7001647128, "chapter_id": 21647, "verse_number": "१-३३-१२९", "content_sanskrit": "विषयेषु प्रसक्तानि चेन्द्रियाणि मुनीश्वरः ।\nसमामाहृत्य निगृह्णाति प्रत्याहारस्तु स स्मृतः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7001647129, "chapter_id": 21647, "verse_number": "१-३३-१३०", "content_sanskrit": "जितेन्द्रिया महात्मानो ध्यानशून्या अपि द्विज ।\nप्रयान्ति परमं ब्रह्म पुनरावृत्तिदुर्लभम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7001647130, "chapter_id": 21647, "verse_number": "१-३३-१३१", "content_sanskrit": "अनिर्जितेंद्रियग्रामं यस्तु ध्यानपरो भवेत् ।\nमूढात्मानं च तं विद्याद्ध्यानं चास्य न सिध्यति ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7001647131, "chapter_id": 21647, "verse_number": "१-३३-१३२", "content_sanskrit": "यद्यत्पश्यति तत्सर्वं पश्येदात्मवदात्मनि ।\nप्रत्याहृतानीन्द्रियाणि धारयेत्सा तु धारणा ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7001647132, "chapter_id": 21647, "verse_number": "१-३३-१३३", "content_sanskrit": "योगाज्जितेंद्रियग्रामस्तानि हृत्वा दृढं हृदि ।\nआत्मानं परमं ध्यायेत्सर्वधातारमच्युतम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 7001647133, "chapter_id": 21647, "verse_number": "१-३३-१३४", "content_sanskrit": "सर्वविश्वात्मकं विष्णुं सर्वलोकैककारणम् ।\nविकसत्पद्यपत्राक्षं चारुकुण्डलभूषितम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 7001647134, "chapter_id": 21647, "verse_number": "१-३३-१३५", "content_sanskrit": "दीर्घबाहुमुदाराङ्गं सर्वालङ्कारभृषितम् ।\nपीताम्बरधरं देवं हेमयज्ञोपवीतिनम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 7001647135, "chapter_id": 21647, "verse_number": "१-३३-१३६", "content_sanskrit": "बिभ्रतं तुलसीमालां कौस्तुभेन विराजितम् ।\nश्रीवत्सवक्षसं देवं सुरासुरनमस्कृतम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 7001647136, "chapter_id": 21647, "verse_number": "१-३३-१३७", "content_sanskrit": "अष्टारे हृत्सरोजे तु द्वादशांगुलविस्तृते ।\nध्यायेदात्मानमव्यक्तं परात्परतरं विभुम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 7001647137, "chapter_id": 21647, "verse_number": "१-३३-१३८", "content_sanskrit": "ध्यानं सद्भिनिर्गदितं प्रत्ययस्यैकतानता ।\nध्यानं कृत्वा मुहुर्त्तं वा परं मोक्षं लभेन्नरः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 7001647138, "chapter_id": 21647, "verse_number": "१-३३-१३९", "content_sanskrit": "ध्यानात्पापानि नश्यन्ति ध्यानान्मोक्षं च विंदति ।\nध्यानात्प्रसीदति हरिद्धर्यानात्सर्वार्थसाधनम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 7001647139, "chapter_id": 21647, "verse_number": "१-३३-१४०", "content_sanskrit": "यद्यद्रूपं महाविष्णोस्तत्तद्ध्यायेत्समाहितम् ।\nतेन ध्यानेन तुष्टात्मा हरिर्मोक्षं ददाति वै ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 7001647140, "chapter_id": 21647, "verse_number": "१-३३-१४१", "content_sanskrit": "अचञ्चलं मनः कुर्याद्ध्येये वस्तुनि सत्तम ।\nध्यानं ध्येयं ध्यातृभावं यथा नश्यति निर्भरम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 7001647141, "chapter_id": 21647, "verse_number": "१-३३-१४२", "content_sanskrit": "ततोऽमृतत्वं भवति ज्ञानामृतनिषेवणात् ।\nभवेन्निरन्तरं ध्यानादभेदप्रतिपादनम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}, {"id": 7001647142, "chapter_id": 21647, "verse_number": "१-३३-१४३", "content_sanskrit": "सुषुत्पिवत्परानन्दयुक्तश्चोपरतेन्द्रियः ।\nनिर्वातदीपवत्संस्थः समाधिरभिधीयते ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143}, {"id": 7001647143, "chapter_id": 21647, "verse_number": "१-३३-१४४", "content_sanskrit": "योगी समाध्यवस्थायां न श्रृणोति न पश्यति ।\nन जिघ्रति न स्पृशति न किंचद्वक्ति सत्तम ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144}, {"id": 7001647144, "chapter_id": 21647, "verse_number": "१-३३-१४५", "content_sanskrit": "आत्मा तु निर्मलः शुद्धः सञ्चिदानन्दविग्रहः ।\nसर्वोपाधिविनिर्मुक्तो योगिनां भात्यचञ्चलः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 145}, {"id": 7001647145, "chapter_id": 21647, "verse_number": "१-३३-१४६", "content_sanskrit": "निर्गुणोऽपि परो देवो ह्यज्ञानाद्गुणवानिव ।\nविभात्यज्ञाननाशे तु यथापूर्वं व्यवस्थितम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 146}, {"id": 7001647146, "chapter_id": 21647, "verse_number": "१-३३-१४७", "content_sanskrit": "परं ज्योतिरमेयात्मा मायावानिव मायिनाम् ।\nतन्नाशे निर्मलं ब्रह्म प्रकाशयति पंडितं ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 147}, {"id": 7001647147, "chapter_id": 21647, "verse_number": "१-३३-१४८", "content_sanskrit": "एकमेवाद्वितीयं च परं ज्योतिर्निरंजनम् ।\nसर्वेषामेव भूतानामंतर्यामितया स्थितम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 148}, {"id": 7001647148, "chapter_id": 21647, "verse_number": "१-३३-१४९", "content_sanskrit": "अणोरणीयान्महतो महीयान्सनातनात्माखिलविश्वहेतुः ।\nपश्यंति यज्ज्ञानविदां वरिष्टाः परात्परस्मात्परमं पवित्रम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 149}, {"id": 7001647149, "chapter_id": 21647, "verse_number": "१-३३-१५०", "content_sanskrit": "अकारादिक्षकारांतवर्णभेदव्यवस्थितः ।\nपुराणपुरुषोऽनादिः शब्दब्रह्मेति गीयते ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 150}, {"id": 7001647150, "chapter_id": 21647, "verse_number": "१-३३-१५१", "content_sanskrit": "विशुद्दमक्षरं नित्यं पूर्णमाकाशमध्यगम् ।\nआनन्दं निर्मलशांतं परं ब्रह्मेति गीयते ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 151}, {"id": 7001647151, "chapter_id": 21647, "verse_number": "१-३३-१५२", "content_sanskrit": "योगिनो हृदि पश्यन्ति परात्मानं सनातनम् ।\nअविकारमजं शुद्धं परं ब्रह्मेति गीयते ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 152}, {"id": 7001647152, "chapter_id": 21647, "verse_number": "१-३३-१५३", "content_sanskrit": "ध्यानमन्यत्प्रवक्ष्यामि श्रृणुष्व मुनि सत्तम ।\nसंसारतापतप्तानां सुधावृष्टिसमं नृणाम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 153}, {"id": 7001647153, "chapter_id": 21647, "verse_number": "१-३३-१५४", "content_sanskrit": "नारायणं परानन्दं स्मरेत्प्रणवसंस्थितम् ।\nनादरुपमनौपम्यमर्द्धमात्रोपरिस्थितम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 154}, {"id": 7001647154, "chapter_id": 21647, "verse_number": "१-३३-१५५", "content_sanskrit": "अकारं ब्रह्मणो रुपमुकारं विष्णुरुपवत् ।\nमकारं रुद्ररुपं स्यादर्ध्दमात्रं परात्मकम्  ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 155}, {"id": 7001647155, "chapter_id": 21647, "verse_number": "१-३३-१५६", "content_sanskrit": "मात्रास्तिस्त्रः समाख्याता ब्रह्मविष्णु शिवाधिपाः ।\nतेषां समुच्चयं विप्र परब्रह्मप्रबोधकम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 156}, {"id": 7001647156, "chapter_id": 21647, "verse_number": "१-३३-१५७", "content_sanskrit": "वाच्यं तु परमं ब्रह्म वाचकः प्रणवः स्मृतः ।\nवाच्यवाचकसंबन्धो ह्युपचारात्तयोर्द्विजा ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 157}, {"id": 7001647157, "chapter_id": 21647, "verse_number": "१-३३-१५८", "content_sanskrit": "जपन्तः प्रणवं नित्यं मुच्यन्ते सर्वपातकैः ।\nतदभ्यासेन संयुक्ताः परं मोक्षं लभन्ति च ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 158}, {"id": 7001647158, "chapter_id": 21647, "verse_number": "१-३३-१५९", "content_sanskrit": "जपंश्च प्रणवं मन्त्रं ब्रह्मविष्णुशिवात्मकम् ।\nकोटिसूर्यसमं तेजो ध्यायेदात्मनि निर्मलम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 159}, {"id": 7001647159, "chapter_id": 21647, "verse_number": "१-३३-१६०", "content_sanskrit": "शालग्रामशिलारुपं प्रतिमारुपमेव वा ।\nयद्यत्पापहरं वस्तु तत्तद्वा चिन्तयेद्धृदि ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 160}, {"id": 7001647160, "chapter_id": 21647, "verse_number": "१-३३-१६१", "content_sanskrit": "यदेतद्दैष्णवं ज्ञानं कथितं ते मुनीश्वर ।\nएतद्विदित्वा योगीन्द्रो लभते मोक्षमुत्तमम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 161}, {"id": 7001647161, "chapter_id": 21647, "verse_number": "१-३३-१६२", "content_sanskrit": "यस्त्वेतच्छॄणुयाद्वापि पठेद्वापि समाहितः ।\nस सर्वपापनिर्मुक्तो हरिसालोक्यमान्पुयात् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 162}]