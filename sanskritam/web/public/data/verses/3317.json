[{"id": 2106690, "chapter_id": 3317, "verse_number": "१८-२-१", "content_sanskrit": "युधिष्ठिर उवाच।\nनेह पश्यामि विबुधा राधेयममितौजसम्।\nभ्रातरौ च महात्मानौ युधामन्यूत्तमौजसौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2106691, "chapter_id": 3317, "verse_number": "१८-२-२", "content_sanskrit": "जुहुवुर्ये शरीराणि रणवह्नौ महारथाः।\nराजानो राजपुत्राश्च ये मदर्थे हता रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2106692, "chapter_id": 3317, "verse_number": "१८-२-३", "content_sanskrit": "क्व ते महारथाः सर्वे शार्दूलसमविक्रमाः।\nतैरप्ययं जितो लोकः कच्चित्पुरुषसत्तमैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2106693, "chapter_id": 3317, "verse_number": "१८-२-४", "content_sanskrit": "यदि लोकानिमान्प्राप्तास्ते च सर्वे महारथाः।\nस्थितं वित्त हि मां देवाः सहितं तैर्महात्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2106694, "chapter_id": 3317, "verse_number": "१८-२-५", "content_sanskrit": "कच्चिन्न तैरवाप्तोऽयं नृपैर्लोकोऽक्षयः शुभः।\nन तैरहं विना वत्स्ये भ्रातृभिर्ज्ञातिभिस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2106695, "chapter_id": 3317, "verse_number": "१८-२-६", "content_sanskrit": "मातुर्हि वचनं श्रुत्वा तदा सलिलकर्मणि।\nकर्णस्य क्रियतां तोयमिति तप्यामि तेन वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2106696, "chapter_id": 3317, "verse_number": "१८-२-७", "content_sanskrit": "इदं च परितप्यामि पुनःपुनरहं सुराः।\nयन्मातुः सदृशौ पादौ तस्याहममितात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2106697, "chapter_id": 3317, "verse_number": "१८-२-८", "content_sanskrit": "दृष्ट्वैव तं नानुगतः कर्णं परबलार्दनम्।\nन ह्यस्मान्कर्णसहिताञ्जयेच्छक्रोऽपि संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2106698, "chapter_id": 3317, "verse_number": "१८-२-९", "content_sanskrit": "तमहं यत्रतत्रस्थं द्रष्टुमिच्छामि सूर्यजम्।\nअविज्ञातो मया योसौ घातितः सव्यसाचिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2106699, "chapter_id": 3317, "verse_number": "१८-२-१०", "content_sanskrit": "भीमं च भीमविक्रान्तं प्राणेभ्योऽपि प्रियं मम।\nअर्जुनं चेन्द्रसंकाशं यमौ चैव यमोपमौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2106700, "chapter_id": 3317, "verse_number": "१८-२-११", "content_sanskrit": "द्रष्टुमिच्छामि तां चाहं पाञ्चालीं धर्मचारिणीम्।\nन चेह स्थातुमिच्छामि सत्यमेवं ब्रवीमि वः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2106701, "chapter_id": 3317, "verse_number": "१८-२-१२", "content_sanskrit": "किं मे भ्रातृविहीनस्य स्वर्गेण सुरसत्तमाः।\nयत्र ते मम स स्वर्गो नायं स्वर्गो मतो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2106702, "chapter_id": 3317, "verse_number": "१८-२-१३x", "content_sanskrit": "देवा ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2106703, "chapter_id": 3317, "verse_number": "१८-२-१३", "content_sanskrit": "यदि वै तत्र ते श्रद्धा गम्यतां तत्र माचिरम्।\nप्रिये हि तव वर्तामो देवराजस्य शासनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2106704, "chapter_id": 3317, "verse_number": "१८-२-१४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2106705, "chapter_id": 3317, "verse_number": "१८-२-१४", "content_sanskrit": "इत्युक्त्वा तं ततो देवा देवदूतमुपादिशन्।\nयुधिष्ठिरस्य सुहृदो दर्शयेतदि परंतप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2106706, "chapter_id": 3317, "verse_number": "१८-२-१५", "content_sanskrit": "ततः कुन्तीसुतो राजा देवदूतश्च जग्मतुः।\nसहितौ राजशार्दूल यत्र ते पुरुषर्षभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2106707, "chapter_id": 3317, "verse_number": "१८-२-१६", "content_sanskrit": "अग्रतो देवदूतश्च ययौ राजा च पृष्ठतः।\nपन्थानमशुभं दुर्गं सेवितं पापकर्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2106708, "chapter_id": 3317, "verse_number": "१८-२-१७", "content_sanskrit": "तमसा संवृतं घोरं केशशैवलशाद्वलम्।\nयुक्तं पापकृतां गन्धैर्मासशोणितकर्दमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2106709, "chapter_id": 3317, "verse_number": "१८-२-१८", "content_sanskrit": "दंशोत्पातकभल्लूकमक्षिकामशकावृतम्।\nइतश्चेतश्च कुणपैः समन्तात्परिवारितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2106710, "chapter_id": 3317, "verse_number": "१८-२-१९", "content_sanskrit": "अस्थिकेशसमाकीर्णं कृमिकीटसमाकुलम्।\nज्वलनेन प्रदीप्तेन समन्तात्परिवेष्टितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2106711, "chapter_id": 3317, "verse_number": "१८-२-२०", "content_sanskrit": "अयोमुखैश्च काकाद्यैर्गृध्रैश्च समभिद्रुतम्।\nसूचीमुखैस्तथा प्रेतैर्विन्ध्यशैलोपमैर्वृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2106712, "chapter_id": 3317, "verse_number": "१८-२-२१", "content_sanskrit": "मेदोरुधिरयुक्तैश्च च्छिन्नबाहूरुपाणिभिः।\nनिकृत्तोदरपदैश्च तत्रतत्र प्रवेशितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2106713, "chapter_id": 3317, "verse_number": "१८-२-२२", "content_sanskrit": "स तत्कुणपदुर्गन्धमशिवं रोमहर्षणम्।\nजगाम राजा धर्मान्मा मध्ये बहु विचिन्तयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2106714, "chapter_id": 3317, "verse_number": "१८-२-२३", "content_sanskrit": "ददर्शोष्णोदकैः पूर्णां नदीं चापि सुदुर्गमाम्।\nअसिपत्रवनं चैव निशितं क्षुरसंवृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2106715, "chapter_id": 3317, "verse_number": "१८-२-२४", "content_sanskrit": "करम्भवालुकास्तप्ता आयसीश्चि शिलाः पृथक्।\nलोहकुंभीश्च तैलस्य क्वाथ्यमानाः समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2106716, "chapter_id": 3317, "verse_number": "१८-२-२५", "content_sanskrit": "कूटशाल्मलिकं तापि दुःस्पर्शं तीक्ष्णकण्टकम्।\nददर्शान्याश्च कौन्तेयो यातनाः पापकर्मिणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2106717, "chapter_id": 3317, "verse_number": "१८-२-२६", "content_sanskrit": "स तं दुर्गन्धमालक्ष्य देवदूतमुवाच ह।\nकियदध्वानमस्माभिर्गन्तव्यमिममीदृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2106718, "chapter_id": 3317, "verse_number": "१८-२-२७", "content_sanskrit": "क्व च ते भ्रातरो मह्यं तन्ममाख्यातुमर्हसि।\nदेशोऽयं कश्च देवानामेतदिच्छामि वेदितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2106719, "chapter_id": 3317, "verse_number": "१८-२-२८", "content_sanskrit": "स संनिववृते श्रुत्वा धर्मराजस्य भाषितम्।\nदेवदूतोऽब्रवीचैनमेतावद्गमनं तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2106720, "chapter_id": 3317, "verse_number": "१८-२-२९", "content_sanskrit": "निवर्तितव्यो हि मया तताऽस्म्युक्तो दिवौकसैः।\nयदि श्रान्तोसि राजेन्द्रि त्वमथागन्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2106721, "chapter_id": 3317, "verse_number": "१८-२-३०", "content_sanskrit": "युधिष्ठिरस्तु निर्विण्णस्तेनि गन्धेन मूर्छितः।\nनिवर्तने धृतमनाः पर्यावर्तत भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2106722, "chapter_id": 3317, "verse_number": "१८-२-३१", "content_sanskrit": "सं संनिवृत्तो धर्मात्मा दुःखशोकसमाहतः।\nशुश्राव तत्र वदतां दीना वाचः समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2106723, "chapter_id": 3317, "verse_number": "१८-२-३२", "content_sanskrit": "भोभो धर्मज राजर्षे पुण्याभिजन पाण्वन।\nअनुग्रहार्थमस्माकं तिष्ठ तावन्मुहूर्तकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2106724, "chapter_id": 3317, "verse_number": "१८-२-३३", "content_sanskrit": "आयाति त्वयि दुर्धर्षे वाति पुण्यः समीरणः।\nतव गन्धानुगस्तात येनास्मान्सुखमागमत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2106725, "chapter_id": 3317, "verse_number": "१८-२-३४", "content_sanskrit": "ते वयं पार्थ दीर्घस्य कालस्य पुरुषर्षभ।\nसुखमासादयिष्यामस्त्वां दृष्ट्वा राजसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2106726, "chapter_id": 3317, "verse_number": "१८-२-३५", "content_sanskrit": "संतिष्ठस्व महाबाहो मुहूर्तमिह भारत।\nत्वयि तिष्ठति कौरव्य यातनाऽस्मान्न बाधते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2106727, "chapter_id": 3317, "verse_number": "१८-२-३६", "content_sanskrit": "एवं बहुविधा वाचः कृपणा वेदनावताम्।\nतस्मिन्देशे स शुश्राव समन्ताद्वदतां नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2106728, "chapter_id": 3317, "verse_number": "१८-२-३७", "content_sanskrit": "तेषां तु वचनं श्रुत्वा दयावान्दीनभाषिणाम्।\nअहो कृच्छ्रमिति प्राह तस्थौ स च युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2106729, "chapter_id": 3317, "verse_number": "१८-२-३८", "content_sanskrit": "स ता गिरः पुरस्ताद्वै श्रुतपूर्वाः पुनःपुनः।\nग्लानानां दुःखितानां च नाभ्यजानत पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2106730, "chapter_id": 3317, "verse_number": "१८-२-३९", "content_sanskrit": "अबुध्यमानस्ता वाचो धर्मपुत्रो युधिष्ठिरः।\nउवाच के भवन्तो वै किमर्थमिह तिष्ठथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2106731, "chapter_id": 3317, "verse_number": "१८-२-४०", "content_sanskrit": "इत्युक्तास्ते ततः सर्वे समन्तादवभाषिरे।\nकर्णोऽहं भीमसेनोऽहमर्जुनोऽहमिति प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2106732, "chapter_id": 3317, "verse_number": "१८-२-४१", "content_sanskrit": "नकुलः सहदेवोऽहं धृष्टद्युम्नोऽहमित्युत।\nद्रौप्दी द्रौपदेयाश्चि इत्येवं ते विचुक्रुशुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2106733, "chapter_id": 3317, "verse_number": "१८-२-४२", "content_sanskrit": "ता वाचः स तदा श्रुत्वा तद्देशसदृशीर्नृप।\nततो विममृशे राजा किंत्विदं दैवकारितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2106734, "chapter_id": 3317, "verse_number": "१८-२-४३", "content_sanskrit": "किन्तु तत्कलुषं कर्म कृतमेभिर्महात्मभिः।\nकर्णेन द्रौपदेयैर्वा पाञ्चाल्या वा सुमध्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2106735, "chapter_id": 3317, "verse_number": "१८-२-४४", "content_sanskrit": "य इमे पापगन्धेऽस्मिन्देशे सन्ति सुदारुणे।\nनाहं जानामि सर्वेषां दुष्कृतं पुण्यकर्मणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2106736, "chapter_id": 3317, "verse_number": "१८-२-४५", "content_sanskrit": "किं कृत्वा धृतराष्ट्रस्य पुत्रो राजा सुयोधनः।\nतथा श्रिया युतः पापैः सहसर्वैः पदानुगैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2106737, "chapter_id": 3317, "verse_number": "१८-२-४६", "content_sanskrit": "महेन्द्रि इव लक्ष्मीवानास्ते परमपूजितः।\nकस्येदानीं विकारोऽयं य इमे नरकं गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2106738, "chapter_id": 3317, "verse_number": "१८-२-४७", "content_sanskrit": "सर्वे धर्मविदः शूराः सत्यागमपरायणाः।\nक्षत्रधर्मरताः सन्तो यज्वानो भूरिदक्षिणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2106739, "chapter_id": 3317, "verse_number": "१८-२-४८", "content_sanskrit": "किंनु सुप्तोस्मि जागर्मि चेतयामि न चेतये।\nअहो चित्तविकारोऽयं स्याद्वा मे चित्तविभ्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2106740, "chapter_id": 3317, "verse_number": "१८-२-४९", "content_sanskrit": "एवं बहुविधं राजा विममर्श युधिष्ठिरः।\nदुःखशोकसमाविष्टश्चिन्ताव्याकुलितेन्द्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2106741, "chapter_id": 3317, "verse_number": "१८-२-५०", "content_sanskrit": "क्रोधमाहारयच्चैव तीव्रं धर्मसुतो नृपः।\nदेवांश्च गर्हयामास धर्मं चैव युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2106742, "chapter_id": 3317, "verse_number": "१८-२-५१", "content_sanskrit": "स तीव्रशोकसंतप्तो देवदूतमुवाच ह।\nगम्यतां तत्र येषां त्वं दूतस्तेषामुपान्तिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2106743, "chapter_id": 3317, "verse_number": "१८-२-५२", "content_sanskrit": "न ह्यहं तत्र यास्यामि स्थितोस्मीति निवेद्यताम्।\nमत्संश्रयादिमे दूनाः सुखिनो भ्रातरो हि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2106744, "chapter_id": 3317, "verse_number": "१८-२-५३", "content_sanskrit": "इत्युक्तः स तदा दूतः पाण्डुपुत्रेण धीमता।\nजगामि तत्र यत्रास्ते देवराजः शतक्रतुःठ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2106745, "chapter_id": 3317, "verse_number": "१८-२-५४", "content_sanskrit": "निवेदयामास च तद्धर्मराजचिकीर्षितम्।\nयथोक्तं धर्मपुत्रेण सर्वमेव जनाधिप॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2106746, "chapter_id": 3317, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते स्वर्गारोहणपर्वणि द्वितीयोऽध्यायः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]