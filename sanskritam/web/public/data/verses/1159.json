[{"id": 2008203, "chapter_id": 1159, "verse_number": "१-१६०-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2008204, "chapter_id": 1159, "verse_number": "१-१६०-१", "content_sanskrit": "तांस्तु दृष्ट्वा सुमनसः परिसंवत्सरोषितान्।\nविश्वस्तानिव संलक्ष्य हर्षं चक्रे पुरोचनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2008205, "chapter_id": 1159, "verse_number": "१-१६०-२", "content_sanskrit": "स तु संचिन्तयामास प्रहृष्टेनान्तरात्मना।\nप्राप्तकालमिदं मन्ये पाण्डवानां विनाशने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2008206, "chapter_id": 1159, "verse_number": "१-१६०-३", "content_sanskrit": "तमस्यान्तर्गतं भावं विज्ञाय कुरुपुङ्गवः।\nचिन्तयामास मतिमान्धर्मपुत्रो युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2008207, "chapter_id": 1159, "verse_number": "१-१६०-४", "content_sanskrit": "पुरोचने तथा हृष्टे कौन्तेयोऽथ युधिष्ठिरः।\nभीमसेनार्जुनौ चोभौ यमौ प्रोवाच धर्मवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2008208, "chapter_id": 1159, "verse_number": "१-१६०-५", "content_sanskrit": "अस्मानयं सुविश्वस्तान्वेत्ति पापः पुरोचनः।\nवञ्चितोऽयं नृशंसात्मा कालं मन्ये पलायने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2008209, "chapter_id": 1159, "verse_number": "१-१६०-६", "content_sanskrit": "आयुधागारमादीप्य दग्ध्वा चैव पुरोचनम्।\nषट्प्राणिनो निधायेह द्रवामोऽनभिलक्षिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2008210, "chapter_id": 1159, "verse_number": "१-१६०-७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2008211, "chapter_id": 1159, "verse_number": "१-१६०-७", "content_sanskrit": "अथ दानापदेशेन कुन्ती ब्राह्मणभोजनम्।\nचक्रे निशि महाराज आजग्मुस्तत्र योषितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2008212, "chapter_id": 1159, "verse_number": "१-१६०-८", "content_sanskrit": "ता विहृत्य यथाकामं भुक्त्वा पीत्वा च भारत।\nजग्मुर्निशिं गृहानेव समनुज्ञाप्य माधवीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2008213, "chapter_id": 1159, "verse_number": "१-१६०-९", "content_sanskrit": "पुरोचनप्रणिहिता पृथां या सेवते सदा।\nनिषादी दुष्टहृदया नित्यमन्तरचारिणी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2008214, "chapter_id": 1159, "verse_number": "१-१६०-१०", "content_sanskrit": "निषादी पञ्चपुत्रा सा तस्मिन्भोज्ये यदृच्छया।\nपुराभ्यासकृतस्नेहा सखी कुन्त्याः सुतैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2008215, "chapter_id": 1159, "verse_number": "१-१६०-११", "content_sanskrit": "आनीय मधुमूलानि फलानि विविधानि च।\nअन्नार्थिनी समभ्यागात्सपुत्रा कालचोदिता।\nसुपापा पञ्चपुत्रा च सा पृथायाः सखी मता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2008216, "chapter_id": 1159, "verse_number": "१-१६०-१२", "content_sanskrit": "सा पीत्वा मदिरां मत्ता सपुत्रा मदविह्वला।\nसह सर्वैः सुतै राजंस्तस्मिन्नेव निवेशने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2008217, "chapter_id": 1159, "verse_number": "१-१६०-१३", "content_sanskrit": "सुष्वाप विगतज्ञाना मृतकल्पा नराधिप।\nअथ प्रवाते तुमुले निशि सुप्ते जने तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2008218, "chapter_id": 1159, "verse_number": "१-१६०-१४", "content_sanskrit": "तदुपादीपयद्भीमः शेते यत्र पुरोचनः।\nततो जतुगृहद्वारं दीपयामास पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2008219, "chapter_id": 1159, "verse_number": "१-१६०-१५", "content_sanskrit": "समन्ततो ददौ पश्चादग्निं तत्र निवेशने।\nपूर्वमेव गृहं शोध्य भीमसेनो महामतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2008220, "chapter_id": 1159, "verse_number": "१-१६०-१६", "content_sanskrit": "पाण्डवैः सहितां कुन्तीं प्रावेशयत तद्बिलम्।\nदत्त्वाग्निं सहसा भीमो गृहे तत्परितः सुधीः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2008221, "chapter_id": 1159, "verse_number": "१-१६०-१७", "content_sanskrit": "गृहस्थं द्रविणं गृह्य निर्जगाम बिलेन सः।\nज्ञात्वा तु तद्गृहं सर्वमादीप्तं पाण्डुनन्दनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2008222, "chapter_id": 1159, "verse_number": "१-१६०-१८", "content_sanskrit": "सुरङ्गां विविशुस्तूर्णं मात्रा सार्धमरिन्दमाः।\nततः प्रतापः सुमहाञ्छब्दश्चैव विभावसोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2008223, "chapter_id": 1159, "verse_number": "१-१६०-१९", "content_sanskrit": "प्रादुरासीत्तदा तेन बुबुधे स जनव्रजः।\nतदवेक्ष्य गृहं दीप्तमाहुः पौराः कृशाननाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2008224, "chapter_id": 1159, "verse_number": "१-१६०-२०", "content_sanskrit": "दुर्योधनप्रयुक्तेन पापेनाकृतबुद्धिना।\nगृहमात्मविनाशाय कारितं दाहितं च तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2008225, "chapter_id": 1159, "verse_number": "१-१६०-२१", "content_sanskrit": "अहो धिग्धृतराष्ट्रस्य बुद्धिर्नातिसमञ्जसा।\nयः शुचीन्पाण्डुदायादान्दाहयामास शत्रुवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2008226, "chapter_id": 1159, "verse_number": "१-१६०-२२", "content_sanskrit": "दिष्ट्या त्विदानीं पापात्मादग्ध्वा दग्धः पुरोचनः।\nअनागसः सुविश्वस्तान्यो ददाह नरोत्तमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2008227, "chapter_id": 1159, "verse_number": "१-१६०-२३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2008228, "chapter_id": 1159, "verse_number": "१-१६०-२३", "content_sanskrit": "एवं ते विलपन्ति स्म वारणावतका जनाः।\nपरिवार्य गृहं तच्च तस्थू रात्रौ समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2008229, "chapter_id": 1159, "verse_number": "१-१६०-२४", "content_sanskrit": "पाण्डवाश्चापि ते सर्वे सह मात्रा सुदुःखिताः।\nबिलेन तेन निर्गत्य जग्मुर्द्रुतमलक्षिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2008230, "chapter_id": 1159, "verse_number": "१-१६०-२५", "content_sanskrit": "तेन निद्रोपरोधेन साध्वसेन च पाण्डवाः।\nन शेकुः सहसा गन्तुं सह मात्रा परन्तपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2008231, "chapter_id": 1159, "verse_number": "१-१६०-२६", "content_sanskrit": "भीमसेनस्तु राजेन्द्र भीमवेगपराक्रमः।\nजगाम भ्रातॄनादाय सर्वान्मातरमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2008232, "chapter_id": 1159, "verse_number": "१-१६०-२७", "content_sanskrit": "स्कन्धमारोप्य जननीं यमावङ्केन वीर्यवान्।\nपार्थौ गृहीत्वा पाणिभ्यां भ्रातरौ सुमहाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2008233, "chapter_id": 1159, "verse_number": "१-१६०-२८", "content_sanskrit": "उरसा पादपान्भञ्जन्महीं पद्भ्यां विदारयन्।\nस जगामाशु तेजस्वी वातरंहा वृकोदरः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2008234, "chapter_id": 1159, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि जतुगृहपर्वणि षष्ट्यधिकशततमोऽध्यायः॥ १६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]