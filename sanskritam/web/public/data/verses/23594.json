[{"id": 7003594000, "chapter_id": 23594, "verse_number": "१-१-१६-१", "content_sanskrit": "लोमश उवाच ।\nततः शची तान्प्रोवाच वाचं धर्मार्थसंयुताम् ।\nमा चिंता क्रियतां देवा बृहस्पतिपुरोगमः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003594001, "chapter_id": 23594, "verse_number": "१-१-१६-२", "content_sanskrit": "गच्छत त्वरिताः सर्वे शक्रं द्रष्टुं विचक्षणाः ।\nब्रह्महत्याभिभूतोऽसौ यत्रास्ते सुरसत्तमः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003594002, "chapter_id": 23594, "verse_number": "१-१-१६-३", "content_sanskrit": "बहूनां कारणेनैव विश्वरूपे हि मंदधीः ।\nहतस्तेन महेंद्रेण सर्वैः सोऽपि निराकृतः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003594003, "chapter_id": 23594, "verse_number": "१-१-१६-४", "content_sanskrit": "तस्मात्सर्वैर्भवद्भिश्च गंतव्यं यत्र स प्रभुः ।\nअवज्ञा हि कृता पूर्वं महेंद्रेण तवानघ ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003594004, "chapter_id": 23594, "verse_number": "१-१-१६-५", "content_sanskrit": "अवज्ञामात्रक्षुबंधेन त्वया शप्तः पुरंदरः ।\nतथैव शापितश्चासि मया त्वं हि बृहस्पते ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003594005, "chapter_id": 23594, "verse_number": "१-१-१६-६", "content_sanskrit": "निरस्तोऽपि हि तस्मात्त्वमवसानपरो भव ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003594006, "chapter_id": 23594, "verse_number": "१-१-१६-७", "content_sanskrit": "यथा मदर्थमानीतौ शक्रे जीवति तावुभौ ।\nत्वयि जीवति भो ब्रहमन्कार्यं तव करिष्यति ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003594007, "chapter_id": 23594, "verse_number": "१-१-१६-८", "content_sanskrit": "कोऽपि सौभाग्यवांल्लोके तव क्षेत्रे जनिष्यति ।\nपुत्रं विख्यातनामानमत्रनैवास्ति संशयः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003594008, "chapter_id": 23594, "verse_number": "१-१-१६-९", "content_sanskrit": "गच्छ शीघ्रं सुरैःसार्द्धं शक्रमानय म चिरम् ।\nप्रयासि त्वरितो नो चेत्पुनः शापं ददामि ते ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003594009, "chapter_id": 23594, "verse_number": "१-१-१६-१०", "content_sanskrit": "शच्योक्तं वचनं श्रुत्वा सुरैः सार्द्धं जगाम सः ।\nपुरंदरं गताः सर्वे ब्रह्महत्याभिपीडितम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003594010, "chapter_id": 23594, "verse_number": "१-१-१६-११", "content_sanskrit": "सरसस्तीरमासाद्य ते शक्रं चाभ्यवादयन् ।\nदृष्टाः शक्रेम ते सर्वे तदा ह्यप्सु स्थितेन वै ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003594011, "chapter_id": 23594, "verse_number": "१-१-१६-१२", "content_sanskrit": "उवाच देवानेदेवेशः कस्माद्यूयमिहागताः ।\nअहं हि पातकग्रस्तो ब्रह्महत्यापरिप्सुतः ।\nअप्सु तिष्ठामि भो देवा एकाकी तपसान्वितः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003594012, "chapter_id": 23594, "verse_number": "१-१-१६-१३", "content_sanskrit": "तच्छ्रुत्वा वचनं तस्य सर्वे देवाः शतक्रतोः ।\nऊचुर्विह्वलिता एनं देवराजानमद्भुतम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003594013, "chapter_id": 23594, "verse_number": "१-१-१६-१४", "content_sanskrit": "एतादृशं न वाच्यं ते परेषामुपकारतः ।\nकृतं त्वयैव यत्कर्म विश्वरूपवधादिकम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003594014, "chapter_id": 23594, "verse_number": "१-१-१६-१५", "content_sanskrit": "विश्वकर्मसुतेनैव कृतं याजनमद्भुतम् ।\nयेन देवाः क्षयं यांति ऋषयोऽपि महाप्रभाः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003594015, "chapter_id": 23594, "verse_number": "१-१-१६-१६", "content_sanskrit": "तस्माद्वतस्त्वया देव परेषामुपकारतः ।\nततः सर्वे वयं प्राप्तास्त्वां नेतुममरावतीम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003594016, "chapter_id": 23594, "verse_number": "१-१-१६-१७", "content_sanskrit": "एवं विवदमानेषु देवेषु च तदाऽब्रवीत् ।\nब्रह्महत्या त्वरायुक्ता देवेंद्रं वरयाम्यहम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003594017, "chapter_id": 23594, "verse_number": "१-१-१६-१८", "content_sanskrit": "तदा बृहस्पतिर्वाक्यमुवाच सहसैव तु ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003594018, "chapter_id": 23594, "verse_number": "१-१-१६-१९", "content_sanskrit": "बृहस्पतिरुवाच ।\nवासार्थं च करिष्यामः स्थानानि तव सांप्रतम् ।\nप्रसांत्विता तदा हत्या देवैस्तत्कार्यगौरवात् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003594019, "chapter_id": 23594, "verse_number": "१-१-१६-२०", "content_sanskrit": "विमृश्य सर्वे विभजुश्चतुर्द्धा हत्यां सुरास्ते ऋषयो मनीषिणः ।\nयक्षाः पिशाचा उरगाः पतंगास्तथा च सर्वे सुरसिद्धचारणाः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003594020, "chapter_id": 23594, "verse_number": "१-१-१६-२१", "content_sanskrit": "आदौ क्षमां प्रति तदा ऊचुः सर्वे दिवौकसः ।\nहे क्षमेंऽशस्त्वया ग्राह्यो हत्यायाः कार्यसिद्धये ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003594021, "chapter_id": 23594, "verse_number": "१-१-१६-२२", "content_sanskrit": "सुराणां तद्वचः श्रुत्वा धरित्री कंपिताऽवदत् ।\nकथं ग्राह्ये मया ह्यंशो हत्यायास्तद्विमृश्यताम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003594022, "chapter_id": 23594, "verse_number": "१-१-१६-२३", "content_sanskrit": "अहं हि सर्वभूतानां धात्री विश्वं धराम्यहम् ।\nअपवित्रा भविष्यामि एनसा संवृता भृशम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003594023, "chapter_id": 23594, "verse_number": "१-१-१६-२४", "content_sanskrit": "पृथ्वयास्तद्वचनं श्रुत्वा बृहस्पतिरुवाच ताम् ।\nमा भौषीश्चारुसर्वांगि निष्पापासि न चान्यथा ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003594024, "chapter_id": 23594, "verse_number": "१-१-१६-२५", "content_sanskrit": "यदा यदुकुले श्रीमान्वासुदेवो भविष्यति ।\nतदा तत्पदविन्यासान्नष्पापा त्वं भविष्यसि ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003594025, "chapter_id": 23594, "verse_number": "१-१-१६-२६", "content_sanskrit": "कुरु वाक्यं त्वमस्माकं नात्र कार्या विचारणा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003594026, "chapter_id": 23594, "verse_number": "१-१-१६-२७", "content_sanskrit": "इत्युक्ता पृथिवी तेषां निष्पापा साकरोद्वचः ।\nततो वृक्षान्समाहूय सर्वे देवाऽब्रुवन्वचः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003594027, "chapter_id": 23594, "verse_number": "१-१-१६-२८", "content_sanskrit": "हत्यांशो हि ग्रहीतव्यो भवद्भिः कार्यसिद्धये ।\nएवमुक्ताऽब्रुवन्वबृक्षा देवान्सर्वे समागताः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003594028, "chapter_id": 23594, "verse_number": "१-१-१६-२९", "content_sanskrit": "वयं सर्वे तथा भूतास्तापसानां फलप्रदाः ।\nतदा हत्यान्विताः सर्वे भविष्यंति तपस्विनः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003594029, "chapter_id": 23594, "verse_number": "१-१-१६-३०", "content_sanskrit": "पापिनो हि महाभागास्तस्मात्सर्वं विमृश्यताम् ।\nतदा पुरोधसा चोक्ताः सर्वे वृक्षाः समागताः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003594030, "chapter_id": 23594, "verse_number": "१-१-१६-३१", "content_sanskrit": "मा चिंता क्रियतां सर्वैः प्रसादाच्च शतक्रतोः ।\nछेदिताश्चैव सर्वे वै ह्यनेकांशत्वमागताः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003594031, "chapter_id": 23594, "verse_number": "१-१-१६-३२", "content_sanskrit": "ततो विटपिनो नित्यं यूयं सर्वे भविष्यथ ।\nइत्युक्तास्ते तदा सर्वेगृह्णन्हत्यां विभागशः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003594032, "chapter_id": 23594, "verse_number": "१-१-१६-३३", "content_sanskrit": "ततो ह्यपः समाहूय ऊचुः सर्वे दिवौकसः ।\nअद्भिश्च गृह्यतामद्य हत्यांशः कार्यसिद्धये ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003594033, "chapter_id": 23594, "verse_number": "१-१-१६-३४", "content_sanskrit": "तदा ह्यापो मिलित्वाथ ऊचुः सर्वाः पुरोधसम् ।\nयानि कानि च पापानि तथा दुश्चरितानि च ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003594034, "chapter_id": 23594, "verse_number": "१-१-१६-३५", "content_sanskrit": "अस्मत्संपर्कसंबंधात्स्नानशौचाशनादिभिः ।\nपुनंति प्राणिनः सर्वे पापेन परिवेष्टिताः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003594035, "chapter_id": 23594, "verse_number": "१-१-१६-३६", "content_sanskrit": "तासां वचनमाकर्ण्य बृहस्पतिरुवाच ह ।\nमा भयं क्रियतामाप एनसा दुस्तरेण हि ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003594036, "chapter_id": 23594, "verse_number": "१-१-१६-३७", "content_sanskrit": "आपः पुनंतु सर्वेषां चराचरनिवासिनाम् ।\nतदा स्त्रियः समाहूय बृहस्पतिरुवाच ह ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003594037, "chapter_id": 23594, "verse_number": "१-१-१६-३८", "content_sanskrit": "अद्यैव ग्राह्ये हत्यांशः सर्वकार्यार्थसिद्धये ।\nनिशम्य तद्गुरोर्वाक्यमूचुः सर्वाश्चयोपितः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003594038, "chapter_id": 23594, "verse_number": "१-१-१६-३९", "content_sanskrit": "पापमाचरते योषा तेन पापेन नान्यथा ।\nलिप्यंते बहवः पक्षा इति वेदानुशासनम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003594039, "chapter_id": 23594, "verse_number": "१-१-१६-४०", "content_sanskrit": "श्रुतमस्ति न ते किंचिद्धेपुरोधो विमृश्यताम् ।\nयोषिद्भिः प्रोच्यमानोऽपि उवाचाथ बृहस्पतिः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003594040, "chapter_id": 23594, "verse_number": "१-१-१६-४१", "content_sanskrit": "मा भयं क्रियतां सर्वाः पापादस्मात्सुलोचनाः ।\nभविष्याणां तथान्येषां भविष्यति फलप्रदः ।\nहत्यांशो यो हि सर्वासां यथाकामित्वमेव च ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003594041, "chapter_id": 23594, "verse_number": "१-१-१६-४२", "content_sanskrit": "एवमंशाश्च त्यायाश्चत्वारः कल्पिताः सुरैः ।\nनिवासमकरोत्सद्यस्तेषुतेषु द्विजोत्तमाः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003594042, "chapter_id": 23594, "verse_number": "१-१-१६-४३", "content_sanskrit": "निष्पापो हि तदा जातो महेंद्रो ह्यभिषेचितः ।\nदेवपुर्यां सुरगणैस्तथैव ऋषभिः सह ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003594043, "chapter_id": 23594, "verse_number": "१-१-१६-४४", "content_sanskrit": "शच्या समेतो हि तदा पुरंदरो बभूव विश्वाधिपतिर्महात्मा ।\nदेवैः समेतो हि महानुभावैर्मुनीश्वरैः सिद्धगणैस्तदानीम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003594044, "chapter_id": 23594, "verse_number": "१-१-१६-४५", "content_sanskrit": "तदाग्नयः शोभना वायवश्च सर्वे ग्रहाः सुप्रभाः शांतियुक्ताः ।\nजाताः सद्यः पृथिवी शोभमाना तथाद्रयो मणिप्रभवा बभूवुः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003594045, "chapter_id": 23594, "verse_number": "१-१-१६-४६", "content_sanskrit": "प्रसन्नानि तथा ह्यासन्मनांसि च मनस्विनाम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003594046, "chapter_id": 23594, "verse_number": "१-१-१६-४७", "content_sanskrit": "नद्यश्चामृतवाहिन्यो वृक्षा ह्यासन्सदाफलाः ।\nअकृष्टपच्यौषधयो बभूवुश्चमृतोपमाः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003594047, "chapter_id": 23594, "verse_number": "१-१-१६-४८", "content_sanskrit": "ऐकपद्येन सर्वेषामिंद्रलोकनिवासिनाम् ।\nबभूव परमोत्साहो महामोदकरस्तथा ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003594048, "chapter_id": 23594, "verse_number": "१-१-१६-४९", "content_sanskrit": "लोमश उवाच ।\nएतस्मिन्नंतरे त्वष्टा दृष्ट्वा चेंद्रमहोत्सवम् ।\nबभूव रुषि तोऽतीव पुत्रशोकप्रपीडितः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003594049, "chapter_id": 23594, "verse_number": "१-१-१६-५०", "content_sanskrit": "जगाम निर्वेदपरस्तपस्तप्तुं सुदारुणम् ।\nतपसा तेन संतुष्टो ब्रह्मा लोकपितामहः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003594050, "chapter_id": 23594, "verse_number": "१-१-१६-५१", "content_sanskrit": "त्वष्टारमब्रवीत्तुष्टो वरं वरय सुव्रत ।\nतदा वव्रे वरं त्वष्टा सर्वलोकभयावहम् ।\nवरं पुत्रो हि दात्वोय देवानां हि भयावहः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003594051, "chapter_id": 23594, "verse_number": "१-१-१६-५२", "content_sanskrit": "तथेति च वरो दत्तो ब्रह्मणा परमेष्ठिना ।\nवरदानात्सद्य एव बभूव पुरुषस्तदा ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003594052, "chapter_id": 23594, "verse_number": "१-१-१६-५३", "content_sanskrit": "वृत्रनामांकितस्तत्र दैत्यो हि परमाद्भुतः ।\nधनुषां शतमात्रं हि प्रत्यहं ववृधेऽसुरः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003594053, "chapter_id": 23594, "verse_number": "१-१-१६-५४", "content_sanskrit": "पातालान्निर्गता दैत्या ये पुराऽमृतमंथने ।\nघातिताः सुरसंघैश्च भृगुणा जीवितास्त्वरात् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003594054, "chapter_id": 23594, "verse_number": "१-१-१६-५५", "content_sanskrit": "सर्वं महीतलं व्याप्तं तेनैकेन महात्मना ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003594055, "chapter_id": 23594, "verse_number": "१-१-१६-५६", "content_sanskrit": "तदा सर्वेऽपि ऋषयो वध्यमानास्तपस्विनः ।\nब्रह्माणं त्वरिताः सर्वे ऊचुर्व्यसनमागतम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003594056, "chapter_id": 23594, "verse_number": "१-१-१६-५७", "content_sanskrit": "तथा चेंद्रादयो देवा गंधर्वाः समरुद्गणाः ।\nब्रह्मणा कथितं सर्वं त्वष्टुश्चैतच्चिकीर्षितम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003594057, "chapter_id": 23594, "verse_number": "१-१-१६-५८", "content_sanskrit": "भवद्वधार्थं जनितस्तपसा परमेण तु ।\nवृत्त्रोनाम महातेजाः सर्वदैत्यापिधो महान् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003594058, "chapter_id": 23594, "verse_number": "१-१-१६-५९", "content_sanskrit": "तथापि यत्नः क्रियतां यथा वध्यो भवेदसौ ।\nनिशम्य ब्रह्मणो वाक्यमूचुर्द्देवाः सवासवाः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003594059, "chapter_id": 23594, "verse_number": "१-१-१६-६०", "content_sanskrit": "देवा ऊचुः ।\nयदा इंद्रो हि हत्याया विमुक्तः स्थापितो दिवि ।\nतदास्माभिरकार्यं वै कृतमस्ति दुरासदम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003594060, "chapter_id": 23594, "verse_number": "१-१-१६-६१", "content_sanskrit": "शस्त्राण्यस्त्राण्यनेकानि संक्षिप्तानि ह्यबुद्धितः ।\nदधीच स्याश्रमे ब्रह्मन्किं कार्यं करवामहे ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003594061, "chapter_id": 23594, "verse_number": "१-१-१६-६२", "content_sanskrit": "तच्छ्रुत्वा प्रहसन्वाक्यं देवान्ब्रह्मा तदाऽब्रवीत् ।\nचिरं स्थितानि विज्ञायागच्छध्वं तानि वै सुराः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003594062, "chapter_id": 23594, "verse_number": "१-१-१६-६३", "content_sanskrit": "गत्वा देवास्तदा सर्वे नापश्यन्स्वं स्वमायुधम् ।\nपप्रच्छुश्च दधीचिं ते सोऽवादीन्नैव वेद्भयहम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003594063, "chapter_id": 23594, "verse_number": "१-१-१६-६४", "content_sanskrit": "पुनर्ब्रह्माणमागात्य ऊचुः सर्वे मुनेर्वचः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003594064, "chapter_id": 23594, "verse_number": "१-१-१६-६५", "content_sanskrit": "ब्रह्मोवाच तदा देवान्सर्वेषां कार्यसिद्धये ।\nतस्यास्थीन्येव याचध्वं प्रदास्यति न संशयः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003594065, "chapter_id": 23594, "verse_number": "१-१-१६-६६", "content_sanskrit": "तच्छ्रुत्वा ब्राह्मणो वाक्यं शक्रो वचनमब्रवीत् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003594066, "chapter_id": 23594, "verse_number": "१-१-१६-६७", "content_sanskrit": "विश्वरूपो हतो देव देवानां कार्यसिद्धये ।\nएक एव तदा ब्रह्मन्पापिष्ठोऽहं कृतः सुरैः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003594067, "chapter_id": 23594, "verse_number": "१-१-१६-६८", "content_sanskrit": "तथा पुरोधसा चैव निःश्रीकस्तत्क्षणात्कृतः ।\nदिष्ट्या परमया चाहं प्रविष्टो निजमंदिरम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003594068, "chapter_id": 23594, "verse_number": "१-१-१६-६९", "content_sanskrit": "दधीचं घातयित्वा वै तस्यास्थीनि बहून्यपि ।\nअस्त्राणि तानि भगवन्कृतानि ह्यशुभानि वै ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003594069, "chapter_id": 23594, "verse_number": "१-१-१६-७०", "content_sanskrit": "त्वष्ट्रा हि जनितो यो वै वृत्रो नामैष दैत्यराट् ।\nकथं तं घातयाम्येवं सततं पापभीरुणा ।\nशक्रेणोक्तं निशम्याथ ब्रह्मा वाक्यमुवाच ह ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003594070, "chapter_id": 23594, "verse_number": "१-१-१६-७१", "content_sanskrit": "अर्थशास्त्रपरेणैव विधिना तमबोधयत् ।\nआततायिनमायांतं ब्राह्मणं वा तपस्विनम् ।\nहंतुकामं जिघांसीयान्न तेन ब्रह्महा भवेत् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003594071, "chapter_id": 23594, "verse_number": "१-१-१६-७२", "content_sanskrit": "इन्द्र उवाच ।\nदधीचस्य वधाद्ब्रह्मन्नहं भीतो न संशयः ।\nतस्माद्ब्रह्मवधात्सत्यं महदेनो भविष्यति ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003594072, "chapter_id": 23594, "verse_number": "१-१-१६-७३", "content_sanskrit": "अतो न कार्यमस्माभिर्ब्राह्मणानां तु हेलनम् ।\nहेलनाद्बहवो दोषा भविष्यंति न चान्यथा ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003594073, "chapter_id": 23594, "verse_number": "१-१-१६-७४", "content_sanskrit": "अदृष्टं परमं धर्म्यं विधिना परमेण हि ।\nकर्तव्यं मनसा चैवं पुरुषेण विजानता ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003594074, "chapter_id": 23594, "verse_number": "१-१-१६-७५", "content_sanskrit": "निःस्पृहं तस्य तद्वाक्यं श्रुत्वा ब्रह्मा ह्युवाच तम् ।\nशक्रस्वबुद्ध्यावर्तस्व दधीचिं गच्छ सत्वरम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003594075, "chapter_id": 23594, "verse_number": "१-१-१६-७६", "content_sanskrit": "याचस्व तस्य चास्थीनि दधीचेः कार्यगौरवात् ।\nगुरुणा सहितः शक्रो देवैः सह समन्वितः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003594076, "chapter_id": 23594, "verse_number": "१-१-१६-७७", "content_sanskrit": "तथेति गत्वा ते सर्वे दधीचस्याश्रमं शुभम् ।\nनानासत्त्वसमायुक्तं वैरबावविवर्जितम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003594077, "chapter_id": 23594, "verse_number": "१-१-१६-७८", "content_sanskrit": "मार्जारमूषकाश्चैव परस्परमुदान्विताः ।\nऐकपद्येन सिंहाश्च गजिन्यः कलभैः सह ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003594078, "chapter_id": 23594, "verse_number": "१-१-१६-७९", "content_sanskrit": "तथा जात्यश्च विविधाः क्रीडायुक्ताः परस्परम् ।\nनकुलैः सह सर्पाश्च क्रीडायुक्ताः परस्परम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003594079, "chapter_id": 23594, "verse_number": "१-१-१६-८०", "content_sanskrit": "एवंविधान्यनेकानि ह्यश्चर्याणि तदाश्रमे ।\nपश्यंतो विबुधाः सर्वे विस्मयं परमं ययुः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003594080, "chapter_id": 23594, "verse_number": "१-१-१६-८१", "content_sanskrit": "अथासने मुनिश्रेष्ठं ददृशुः परमास्थितम् ।\nतेजसा परमेणैव भ्राजमानं यथा रविम् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003594081, "chapter_id": 23594, "verse_number": "१-१-१६-८२", "content_sanskrit": "विभावसुं द्वितीयं वा सुवर्चसहितं तदा ।\nयथा ब्रह्मा हि सावित्र्या तथासौ मुनिसत्तमः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003594082, "chapter_id": 23594, "verse_number": "१-१-१६-८३", "content_sanskrit": "तं प्रणम्य ततो देवा वचनं चेदमब्रुवन् ।\nत्वं दाता त्रिषु लोकेषु त्वत्सकाशमिहगताः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003594083, "chapter_id": 23594, "verse_number": "१-१-१६-८४", "content_sanskrit": "निशम्य वचनं तेषां देवानां भुनिरब्रवीत् ।\nकिमर्थ मागताः सर्वे वदध्वं तत्सुरोत्तमाः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003594084, "chapter_id": 23594, "verse_number": "१-१-१६-८५", "content_sanskrit": "प्रयच्छामि न संदेहो नान्यथा मम भाषितम् ।\nतदोचुः सहिताः सर्वे दधीचिं स्वार्थकामुकाः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003594085, "chapter_id": 23594, "verse_number": "१-१-१६-८६", "content_sanskrit": "भयभीता वयं विप्र भवद्दर्शनकांक्षिणः ।\nत्रातारं त्वां समाकर्ण्य ब्रह्मणा नोदिता वयम् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003594086, "chapter_id": 23594, "verse_number": "१-१-१६-८७", "content_sanskrit": "सम्प्राप्ता विद्धि तत्सर्वं दातुमर्होऽथ सुव्रत ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003594087, "chapter_id": 23594, "verse_number": "१-१-१६-८८", "content_sanskrit": "निशम्य वचनं तेषां किं दातव्यं तदुच्यताम् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003594088, "chapter_id": 23594, "verse_number": "१-१-१६-८९", "content_sanskrit": "ततो देवाब्रुवन्विप्र दैत्यानां निधनायनः ।\nशस्त्रनिर्माणकार्यार्थं तवास्थीनि प्रयच्छ वै ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003594089, "chapter_id": 23594, "verse_number": "१-१-१६-९०", "content_sanskrit": "प्रहस्योवाच विप्रर्षिस्तिष्ठध्वं क्षणमेव हि ।\nस्वयमेव त्वहं देवास्त्यक्ष्याम्यद्य कलेवरम् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003594090, "chapter_id": 23594, "verse_number": "१-१-१६-९१", "content_sanskrit": "इत्युक्त्वा तानथो पत्नीं समाहूय सुवर्चसम् ।\nप्रोवाच स महातेजाः श्रृणु देवी शुचिस्मिते ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003594091, "chapter_id": 23594, "verse_number": "१-१-१६-९२", "content_sanskrit": "अस्थ्यर्थं याचितो देवैस्त्यजाम्येतत्कलेवरम् ।\nब्रह्मलोकं व्रजाम्यद्य परमेण समाधिना ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003594092, "chapter_id": 23594, "verse_number": "१-१-१६-९३", "content_sanskrit": "मयि याते ब्रह्मलोकं त्वं स्वधर्मेण तत्र माम् ।\nप्राप्स्यस्येव न संदेहो वृथा चिन्तां च मा कृथाः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003594093, "chapter_id": 23594, "verse_number": "१-१-१६-९४", "content_sanskrit": "इत्युक्त्वा तां स्वपत्नीं स प्रेषयामास चाश्रमम् ।\nततो देवाग्रतो विप्रः समाधिमगमत्तदा ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003594094, "chapter_id": 23594, "verse_number": "१-१-१६-९५", "content_sanskrit": "समाधिना परेणैव विसृज्य स्वं कलेवरम् ।\nब्रह्मलोकं गतः सद्यः पुनर्नावर्तते यतः ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003594095, "chapter_id": 23594, "verse_number": "१-१-१६-९६", "content_sanskrit": "दधीचिनामा मुनिवृंदवर्यः शिवप्रियः शिवदीक्षाभियुक्तः ।\nपरोपकारार्थमिदं कलेवरं शीघ्रं स विप्रोऽत्यजदात्मना तदा ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}]