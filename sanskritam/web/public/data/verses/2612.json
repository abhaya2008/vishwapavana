[{"id": 2076046, "chapter_id": 2612, "verse_number": "१२-११७-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2076047, "chapter_id": 2612, "verse_number": "१२-११७-१", "content_sanskrit": "व्याघ्रश्वोटजमूलस्थस्तृप्तः सुप्तो हतैर्मृगैः।\nनागभागात्तमुद्देशं मत्तो मेघ इवोत्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2076048, "chapter_id": 2612, "verse_number": "१२-११७-२", "content_sanskrit": "प्र--करटः प्रांशुः पझी विततकुम्भकः।\nसु--णो महाकायो मेघगम्भीरनिः स्वनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2076049, "chapter_id": 2612, "verse_number": "१२-११७-३", "content_sanskrit": "तं दृष्ट्वा कुञ्जरं मत्तमायान्तं बलगर्वितम्।\nव्या हस्तिभयान्त्रस्तस्तमृषिं शरणं ययौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2076050, "chapter_id": 2612, "verse_number": "१२-११७-४", "content_sanskrit": "ततोऽनयत्कुञ्जरत्वं व्याघ्रं तमृषिसत्तमः।\nमहमेघोपमं दृष्ट्वा स भीतो ह्यभवद्गजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2076051, "chapter_id": 2612, "verse_number": "१२-११७-५", "content_sanskrit": "ततः कमलषण़्डानि सल्लकीगहनानि च।\nव्य--रत्स मुदायुक्तः पझरेणुविभूषितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2076052, "chapter_id": 2612, "verse_number": "१२-११७-६", "content_sanskrit": "कदचिद्दममाणस्य हस्तिनः संमुखं तदा।\nऋषेस्तस्योटस्थस्य कालोऽगच्छद्दिवानिशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2076053, "chapter_id": 2612, "verse_number": "१२-११७-७", "content_sanskrit": "अथाजगाम तं देशं केसरी केसरारुणः।\nगिन्विन्दरजो भीमः सिंहो नागकुलान्तकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2076054, "chapter_id": 2612, "verse_number": "१२-११७-८", "content_sanskrit": "तं--- सिंहमायान्तं नागः सिंहभयार्दितः।\nऋषिं शरणमापेदे वेपमानो भयातुरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2076055, "chapter_id": 2612, "verse_number": "१२-११७-९", "content_sanskrit": "स त-ः सिंहतां नीतो गजेन्द्रो मुनिना तदा।\nतं च नागणयत्सिंहं तुल्यजातिसमन्वयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2076056, "chapter_id": 2612, "verse_number": "१२-११७-१०", "content_sanskrit": "दृष्ट्वा च सोऽभवत्सिंहो वन्यो हिंसन्नवाग्बलः।\nस चाश्रपेऽवसत्सिंहस्तस्मिन्नेव सुखी वने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2076057, "chapter_id": 2612, "verse_number": "१२-११७-११", "content_sanskrit": "न चान्ये क्षुद्रपशवस्तपोवनसमीपतः।\nव्यदृश्यन्त तदा त्रस्ता जीविताकाङ्क्षिणस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2076058, "chapter_id": 2612, "verse_number": "१२-११७-१२", "content_sanskrit": "कदाचित्कालयोगेन सर्वप्राणिविहिंसकः।\nबलवान्क्षतजाहारो नानासत्वभयंकरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2076059, "chapter_id": 2612, "verse_number": "१२-११७-१३", "content_sanskrit": "अष्टपादर्ध्वनयनः शरभो वनगोचरः।\nतं सिंहं हन्तुमागच्छन्मुनेस्तस्य निवेशने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2076060, "chapter_id": 2612, "verse_number": "१२-११७-१४", "content_sanskrit": "`तं दृष्ट्वा शरभं यान्तं सिंहः परभयान्वितः।\nऋषिं शरणमापेदे वेपमानः कृताञ्जलिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2076061, "chapter_id": 2612, "verse_number": "१२-११७-१५", "content_sanskrit": "सं मुनिः शरभं चक्रे बलोत्कटमरिंदम।\nततः स शरभो वन्यो मुनेः शरभमग्रतः।\nदृष्ट्वा बलिनमत्युग्रं द्रुतं संप्राद्रवद्वनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2076062, "chapter_id": 2612, "verse_number": "१२-११७-१६", "content_sanskrit": "स एवं शरभस्थाने न्यस्तो वै मुनिना तदा।\nमुनेः पार्श्वगतो नित्यं शरभः सुखमाप्तवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2076063, "chapter_id": 2612, "verse_number": "१२-११७-१७", "content_sanskrit": "ततः शरभसंत्रस्ताः सर्वे मृगगणा वनात्।\nदिशः संप्राद्रवत्राजन्भयाज्जीवितकाङ्क्षिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2076064, "chapter_id": 2612, "verse_number": "१२-११७-१८", "content_sanskrit": "शरभोऽप्यतिसंहृष्टो नित्यं प्राणिवधे रतः।\nफलमूलाशनं कर्तुं नैच्छत्स पिशिताशनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2076065, "chapter_id": 2612, "verse_number": "१२-११७-१९", "content_sanskrit": "ततः क्षुद्रसमाचारो बलेन च समन्वितः।\nइयेष तं मुनिं हन्तुमकृतज्ञः कृतान्वयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2076066, "chapter_id": 2612, "verse_number": "१२-११७-२०", "content_sanskrit": "`चिन्तयामास च तदा शरभः श्वानपूर्वकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2076067, "chapter_id": 2612, "verse_number": "१२-११७-२१", "content_sanskrit": "अस्य प्रभावात्संप्राप्तो वाङ्भात्रेणैव केवलम्।\nशरभत्वं सुदुष्प्रापं सर्वभूतभयंकरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2076068, "chapter_id": 2612, "verse_number": "१२-११७-२२", "content_sanskrit": "अन्येऽप्यत्र भयत्रस्ताः सन्ति सत्वा भयार्दिताः।\nमुनिमाश्रित्य जीवन्तो मृगाः पक्षिगणास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2076069, "chapter_id": 2612, "verse_number": "१२-११७-२३", "content_sanskrit": "तेषामपि कदाचिच्च शरभत्वं प्रयच्छति।\nसर्वसत्वोत्तमं लोके बलं यत्र प्रतिष्ठितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2076070, "chapter_id": 2612, "verse_number": "१२-११७-२४", "content_sanskrit": "पक्षिणामप्ययं दद्यात्कदाचिद्गारुडं बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2076071, "chapter_id": 2612, "verse_number": "१२-११७-२५", "content_sanskrit": "यावदन्यस्य संप्रीतः कारुण्यं तु समाश्रितः।\nन ददाति बलं तुष्टः सत्वस्यान्यस्य कस्यचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2076072, "chapter_id": 2612, "verse_number": "१२-११७-२६", "content_sanskrit": "तावदेनमहं विप्रं वधिष्यामि च शीघ्रतः।\nस्थातुं मया शक्यमिह मुनिघातान्न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2076073, "chapter_id": 2612, "verse_number": "१२-११७-२७", "content_sanskrit": "ततस्तेन तपःशक्त्या विदितो ज्ञानचक्षुषा।\nविज्ञाय च मुनिः प्राज्ञस्ततः शापं प्रयुक्तवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2076074, "chapter_id": 2612, "verse_number": "१२-११७-२८", "content_sanskrit": "`अहमग्निप्रभो नाम मुनिर्भृगुकुलान्वयः।\nमनसा निर्दहेयं च जगत्संधारयामि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2076075, "chapter_id": 2612, "verse_number": "१२-११७-२९", "content_sanskrit": "मम वश्यं जगत्सर्वं देवा यच्च चराचरम्।\nसन्ति देवाश्च ये भीताः स्वधर्मं न त्यजन्ति ये।\nस्वधर्माच्चलितान्सर्वान्वाङ्भात्रेणापि निर्दहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2076076, "chapter_id": 2612, "verse_number": "१२-११७-३०", "content_sanskrit": "किमङ्ग त्वं मया नीतः शरभत्वमनामयम्।\nक्रूरः स सर्वभूतेषु हीनश्चाशुचिरेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2076077, "chapter_id": 2612, "verse_number": "१२-११७-३१", "content_sanskrit": "श्वा त्वं द्वीपित्वमापन्नो द्वीपी व्याघ्रत्वमागतः।\nव्याघ्रान्नागो मदपटुर्नागः सिंहत्वमागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2076078, "chapter_id": 2612, "verse_number": "१२-११७-३२", "content_sanskrit": "सिंहस्त्वं बलमापन्नो भूयः शरभतां गतः।\nमया स्नेहपरीतेन विसृष्टो न कुलान्वयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2076079, "chapter_id": 2612, "verse_number": "१२-११७-३३", "content_sanskrit": "यस्मादेवमपापं मां पाप हिंसितुमिच्छसि।\nतस्मात्स्वयोनिमापन्नः पुनः श्वानो भविष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2076080, "chapter_id": 2612, "verse_number": "१२-११७-३४", "content_sanskrit": "ततो मुनिजनद्वेष्टा दुष्टात्मा प्राकृतोऽबुधः।\nऋषिणा शरभः शप्तस्तद्रूपं पुनराप्तवान्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2076081, "chapter_id": 2612, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि सप्तदशाधिकशततमोऽध्यायः॥ ११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]