[{"id": 2113628, "chapter_id": 3443, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2113629, "chapter_id": 3443, "verse_number": "१", "content_sanskrit": "पाण्डोरवभृथं कृत्वा देवकल्पा महर्षयः ।\nततो मन्त्रमकुर्वन्त ते समेत्य तपस्विनः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2113630, "chapter_id": 3443, "verse_number": "२", "content_sanskrit": "हित्वा राज्यं च भोगांश्च स महात्मा महायशाः ।\nअस्मिन् स्थाने तपस्तप्तुं तापसान् शरणं गतः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2113631, "chapter_id": 3443, "verse_number": "३", "content_sanskrit": "सञ्जातमात्रान् पुत्रांश्च दारांश्च भवतामिह ।\nप्रदायोपनिधिं राजा पाण्डुः स्वर्गमितो गतः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2113632, "chapter_id": 3443, "verse_number": "४", "content_sanskrit": "तस्मात् कृत्यं परीक्षध्वमिति होवाच धर्मवित् ।\nशुकः परमधर्मज्ञो महर्षिः संशितव्रतः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2113633, "chapter_id": 3443, "verse_number": "५", "content_sanskrit": "ते परस्परमामन्त्र्य सर्वभूतहिते रताः ।\nधर्मं चैव पुरस्कृत्य ज्येष्ठं मतिमकुर्वत \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2113634, "chapter_id": 3443, "verse_number": "६", "content_sanskrit": "कुरुक्षेत्रमितः कुन्तीं तां सपुत्रां नयामहे ।\nइत्युक्त्वा ते महात्मानो गमने चक्रिरे मनः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2113635, "chapter_id": 3443, "verse_number": "७", "content_sanskrit": "तस्मिन्नेव क्षणे सर्वे परिवार्य प्रतस्थिरे ।\nपाण्डोः पुत्रान् पुरस्कृत्य नगरं नागसाह्वयम् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2113636, "chapter_id": 3443, "verse_number": "८", "content_sanskrit": "उदारमनसः सिद्धा गमने चक्रिरे मनः ।\nभीष्माय पाण्डवान् दातुं धृतराष्ट्राय चैव हि \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2113637, "chapter_id": 3443, "verse_number": "९", "content_sanskrit": "तस्मिन्नेव क्षणे सर्वे तानादाय प्रतस्थिरे ।\nपाण्डोर्दारांश्च पुत्रांश्च शरीरे चैव तापसाः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2113638, "chapter_id": 3443, "verse_number": "१०", "content_sanskrit": "सुखिनी सा पुरा भूत्वा सततं पुत्रवत्सला ।\nप्रपन्ना दीर्घमध्वानं सङ्क्षिप्तं तममन्यत\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2113639, "chapter_id": 3443, "verse_number": "११", "content_sanskrit": "सा नदीर्घेण कालेन सम्प्राप्ता कुरुजाङ्गलम् ।\nवर्धमानपुरद्वारमाससाद यशस्विनी\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2113640, "chapter_id": 3443, "verse_number": "१२", "content_sanskrit": "तच्चारणसहस्रेण मुनीनां सङ्घमागतम् ।\nश्रुत्वा नागपुरेन्द्राणां विस्मयः समजायत\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2113641, "chapter_id": 3443, "verse_number": "१३", "content_sanskrit": "मुहूर्तोदित आदित्ये सर्वे भीष्मपुरोगमाः ।\nसदारास्तापसान् द्रष्टुं निर्ययुः पुरवासिनः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2113642, "chapter_id": 3443, "verse_number": "१४", "content_sanskrit": "स्त्रीसङ्घाः क्षत्रसङ्घाश्च यानसङ्घान् समाश्रिताः ।\nब्राह्मणैः सह निर्जग्मुर्ब्राह्मणाश्च सयोषितः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2113643, "chapter_id": 3443, "verse_number": "१४", "content_sanskrit": "तथा विट्च्छूद्रसङ्घानां महान् व्यतिकरोऽभवत् ।\nन कश्चिदकरोदीर्ष्यामभवन् धर्मबुद्धयः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2113644, "chapter_id": 3443, "verse_number": "१५", "content_sanskrit": "तथा भीष्मः शान्तनवः सोमदत्तोऽथ बाह्लिकः ।\nप्रज्ञाचक्षुश्च राजर्षिः क्षत्ता च विदुरः स्वयम् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2113645, "chapter_id": 3443, "verse_number": "१६", "content_sanskrit": "सा च सत्यवती देवी कौसल्या च यशस्विनी ।\nराजदारैः परिवृता गान्धारी चापि निर्ययौ\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2113646, "chapter_id": 3443, "verse_number": "१७", "content_sanskrit": "धृतराष्ट्रस्य दायादा दुर्योधनपुरोगमाः ।\nभूषिता भूषणैश्चित्रैः शतसङ्ख्या विनिर्ययुः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2113647, "chapter_id": 3443, "verse_number": "१८", "content_sanskrit": "तान् महर्षिगणान् सर्वान् शिरोभिरभिवाद्य च ।\nस्वागतं वचनं चोक्त्वा पाण्डोर्भवनमाविशन् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2113648, "chapter_id": 3443, "verse_number": "१९", "content_sanskrit": "उपोपविविशुः सर्वे कौरवस्य पुरोहिताः ।\nतथैव शिरसा भूमाभिवाद्य प्रसाद्य च \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2113649, "chapter_id": 3443, "verse_number": "२०", "content_sanskrit": "उपोपविविशुः सर्वे पौरजानपदा अपि ।\nतमकूजमिवाज्ञाय जनौघं सर्वशस्तदा \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2113650, "chapter_id": 3443, "verse_number": "२१", "content_sanskrit": "भीष्मो राज्यं च राष्ट्रं च महर्षिभ्यो न्यवेदयत् ।\nतेषां वृद्धतमः कश्चित् प्रत्युत्थाय जटाजिनी ।\nमहर्षिमतमाज्ञाय महर्षिरिदमब्रवीत् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2113651, "chapter_id": 3443, "verse_number": "", "content_sanskrit": "महर्षिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2113652, "chapter_id": 3443, "verse_number": "२२", "content_sanskrit": "यः स कौरव्यदायादः पाण्डुर्नाम नराधिपः ।\nहित्वा राष्ट्रं धनं सर्वं शतशृङ्गमितो गतः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2113653, "chapter_id": 3443, "verse_number": "२३", "content_sanskrit": "कामभोगान् परित्यज्य तपस्वी सम्बभूव ह ।\nस यथोक्तं तपस्तेपे पत्रमूलफलाशनः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2113654, "chapter_id": 3443, "verse_number": "२५", "content_sanskrit": "पत्नीभ्यां सह धर्मात्मा कञ्चित् कालमतन्द्रितः ।\nतेन वृत्तसमाचारैः तपसा च तपस्विनः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2113655, "chapter_id": 3443, "verse_number": "२६", "content_sanskrit": "तोषितास्तापसास्तत्र शतशृङ्गनिवासिनः ।\nस्वर्गलोकं गन्तुकामं तपसा विनिवार्य तम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2113656, "chapter_id": 3443, "verse_number": "२७", "content_sanskrit": "उद्यन्तं सह पत्नीभ्यां विप्रा वचनमब्रुवन् ।\nअनपत्यस्य राजेन्द्र पुण्यलोका न सन्ति ते\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2113657, "chapter_id": 3443, "verse_number": "२८", "content_sanskrit": "तस्माद्धर्मं च वायुं च महेन्द्रं च तथाऽश्विनौ ।\nआराधयस्व राजेन्द्र पत्नीभ्यां सह देवताः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2113658, "chapter_id": 3443, "verse_number": "२९", "content_sanskrit": "तृप्ताः पुत्रान् प्रयच्छन्ति ऋणमुक्तो भविष्यसि ।\nतपसा दिव्यचक्षुष्ट्वात् पश्यामस्ते तथा सुतान् \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2113659, "chapter_id": 3443, "verse_number": "३०", "content_sanskrit": "अस्माकं वचनं श्रुत्वा देवानाराधयत् तदा ।\nब्रह्मचर्यव्रतस्थस्य तस्य दिव्येन हेतुना\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2113660, "chapter_id": 3443, "verse_number": "३१", "content_sanskrit": "तस्माद् धर्मादयं पुत्रः कुन्त्यां जातो युधिष्ठिरः ।\nतथेमं बलिनां श्रेष्ठं तस्य राज्ञो महात्मनः \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2113661, "chapter_id": 3443, "verse_number": "३२", "content_sanskrit": "मातरिश्वा ददौ पुत्रं भीमं सत्त्ववतां वरम् ।\nपुरुहूतादयं जज्ञे कुन्त्यामेव धनञ्जयः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2113662, "chapter_id": 3443, "verse_number": "३३", "content_sanskrit": "अस्मिन् जाते महेष्वासे देवैरिन्द्रस्तथाऽब्रवीत् ।\nमत्प्रसादादयं जातः कुन्ति सत्यपराक्रमः \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2113663, "chapter_id": 3443, "verse_number": "३४", "content_sanskrit": "अजेयो युधि जेताऽरीन् देवतादीन् न संशयः ।\nयस्य कीर्तिर्महेष्वासान् सर्वान् नोऽभिभविष्यति \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2113664, "chapter_id": 3443, "verse_number": "३५", "content_sanskrit": "युधिष्ठिरो राजसूयं भ्रातृवीर्यादवाप्स्यति ।\nएष जेता मनुष्यांश्च सर्वान् गन्धर्वराक्षसान् \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2113665, "chapter_id": 3443, "verse_number": "३६", "content_sanskrit": "एष दुर्योधनं कीर्त्या भारतांश्च विजेष्यति ।\nवीरस्यैतस्य विक्रान्तैर्धर्मपुत्रो युधिष्ठिरः \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2113666, "chapter_id": 3443, "verse_number": "३७", "content_sanskrit": "यक्ष्यते राजसूयाद्यैर्धर्म एव परः सदा ।\nइन्द्रस्य वचनं श्रुत्वा पाण्डुः प्रीतिमवाप सः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2113667, "chapter_id": 3443, "verse_number": "३८", "content_sanskrit": "द्वन्द्वौ माद्री महेष्वासावसूत कुरुसत्तमौ ।\nअश्विभ्यां मनुजव्याघ्राविमौ तावपि तिष्ठतः \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2113668, "chapter_id": 3443, "verse_number": "३९", "content_sanskrit": "नकुलः सहदेवश्च तावप्यमिततेजसौ ।\nपाण्डवौ नरशार्दूलाविमावप्यपराजितौ\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2113669, "chapter_id": 3443, "verse_number": "४०", "content_sanskrit": "चरता धर्मनित्येन वनवासं यशस्विना ।\nएष पैतामहो वंशः पाण्डुना पुनरुद्धृतः \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2113670, "chapter_id": 3443, "verse_number": "४१", "content_sanskrit": "पुत्राणां जन्म वृद्धिं च वैदिकाध्ययनानि च ।\nपश्यतः सततं पाण्डोः शश्वत् प्रीतिरवर्धत\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2113671, "chapter_id": 3443, "verse_number": "४२", "content_sanskrit": "वर्तमानः सतां मार्गे पुत्रलाभमवाप्य च ।\nपितृलोकं गतः पाण्डुरितः सप्तदशेऽहनि\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2113672, "chapter_id": 3443, "verse_number": "४३", "content_sanskrit": "तं चितागतमासाद्य वैश्वानरमुखे हुतम् ।\nप्रविष्टा पावकं माद्री हित्वा जीवितमात्मनः \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2113673, "chapter_id": 3443, "verse_number": "४४", "content_sanskrit": "सा गता सह तेनैव पतिलोकमनुव्रता ।\nतस्यास्तस्य च यत् कार्यं क्रियतां तदनन्तरम् \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2113674, "chapter_id": 3443, "verse_number": "४५", "content_sanskrit": "पृथां च शरणं प्राप्तां पाण्डवांश्च यशस्विनः ।\nयथावदनुगृह्णन्तां धर्मो ह्येष सनातनः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2113675, "chapter_id": 3443, "verse_number": "४६", "content_sanskrit": "इमे तयोः शरीरे द्वे सुताश्चेमे तयोर्वराः ।\nक्रियाभिरनुगृह्णन्तां सह मात्रा परन्तपाः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2113676, "chapter_id": 3443, "verse_number": "४७", "content_sanskrit": "प्रेतकर्मणि निर्वृत्ते पितृमेघे च पाण्डवाः ।\nलभन्तां सर्वदायाद्यं पाण्डोः कुरुकुलोद्वहाः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2113677, "chapter_id": 3443, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2113678, "chapter_id": 3443, "verse_number": "४८", "content_sanskrit": "एवमुक्त्वा कुरून् सर्वान् कौरवाणां च पश्यताम् ।\nक्षणेनान्तर्हिताः सर्वे चारणा गुह्यकैः सह\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2113679, "chapter_id": 3443, "verse_number": "४९", "content_sanskrit": "ऋषिसिद्धगणान् दृष्ट्वा विस्मयं ते परं ययुः ।\nगन्धर्वनगराकारांस्तत्रैवान्तर्हितांस्तदा ।\nकौरवाः सहसोत्पत्य साधुसाध्विति विस्मिताः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2113680, "chapter_id": 3443, "verse_number": "१२२", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nद्वाविंशत्यधिकशततमोऽध्यायः ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2113681, "chapter_id": 3443, "verse_number": "७०", "content_sanskrit": "॥ इति सम्भवपर्वणि सप्ततितमोऽध्यायः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2113682, "chapter_id": 3443, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}]