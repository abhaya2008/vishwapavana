[{"id": 7006008000, "chapter_id": 26008, "verse_number": "१-१९१-१", "content_sanskrit": "हरिरुवाच ।\nपुनर्नवाया मूलञ्च श्वेतं पुष्ये समाहृतम् ।\nवारि पीतं तस्य पार्श्व भवनेषु न पन्नगाः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006008001, "chapter_id": 26008, "verse_number": "१-१९१-२", "content_sanskrit": "तार्क्ष्यमूर्तिं वहेद्यो वै भल्लूकदन्तनिर्मितम् ।\nस पन्नगैर्न दृश्येत यावज्जीवं वृषध्वज ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006008002, "chapter_id": 26008, "verse_number": "१-१९१-३", "content_sanskrit": "पिबेच्छल्मलिमूलं यः पुष्यर्क्षे रुद्र वारिणा। ।\nतस्मिन्नपास्तदशना नागाः स्युर्नात्र संशयः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006008003, "chapter_id": 26008, "verse_number": "१-१९१-४", "content_sanskrit": "पुष्ये लज्जालुकामूले हस्तबद्धे तु पन्नगान ।\nगृह्णीयाल्लेपतो वापि नात्र कार्या विचारणा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006008004, "chapter_id": 26008, "verse_number": "१-१९१-५", "content_sanskrit": "पुष्येश्वेतार्कमूलन्तु पीतं शीतेन वारिण ।\nनश्येतु दंशकविषं करवीरादिजं विषम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006008005, "chapter_id": 26008, "verse_number": "१-१९१-६", "content_sanskrit": "महाकालस्य वै मूलं पिष्टं तत्काञ्जिकेन वै ।\nवोड्राणां डुण्डुभानां च तल्लोपो हरते विषम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006008006, "chapter_id": 26008, "verse_number": "१-१९१-७", "content_sanskrit": "तण्डुलीयकमूलं च पिष्टं तण्डुलवारिणा ।\nघृतेन सह पीतन्तु हरेत्सर्वाविषाणि च ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006008007, "chapter_id": 26008, "verse_number": "१-१९१-८", "content_sanskrit": "नीलीलज्जालुकामूलं पिष्टं तण्डुलवारिणा ।\nपीतं तद्दंशकविषं नश्येदेकेन वोभयोः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006008008, "chapter_id": 26008, "verse_number": "१-१९१-९", "content_sanskrit": "कूष्माण्डकस्य स्वरसः सगुडः सहशर्करः ।\nपीतः सदुग्धो हन्याच्च दंशकस्यविषं च वै ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006008009, "chapter_id": 26008, "verse_number": "१-१९१-१०", "content_sanskrit": "तथा कोद्रवमूलस्य मोहस्य हर एव च ।\nयष्टीमधुसमायुक्ता तथा पीता च शर्करा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006008010, "chapter_id": 26008, "verse_number": "१-१९१-११", "content_sanskrit": "सदुग्धा च त्रिरात्रेण मूषकानां विषं हरत ।\nचुलुकत्रयपानाच्च वारिणः शीतलस्य वै ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006008011, "chapter_id": 26008, "verse_number": "१-१९१-१२", "content_sanskrit": "ताम्बूलदग्धमुखस्य लालास्त्रावो विनश्यति ।\nघृतं सशर्करं षीत्वा मद्यपानमदो न वै ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006008012, "chapter_id": 26008, "verse_number": "१-१९१-१३", "content_sanskrit": "कृष्णाङ्कोलस्य मूलेन पीतं सुक्वथितं जलम् ।\nततो नश्यद्गरविषं त्रिरात्रेण महेश्वर ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006008013, "chapter_id": 26008, "verse_number": "१-१९१-१४", "content_sanskrit": "उष्णं गव्यघृतं चैव सैन्धवेन समन्वितम। ।\nनाशयेत्तन्महादेव वेदनां वृश्चिकोद्भवाम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006008014, "chapter_id": 26008, "verse_number": "१-१९१-१५", "content_sanskrit": "कुसुभं कङ्कुमञ्चैव हरितालं मनः शिला ।\nकरञ्जं पिषितं चैव ह्यर्कमूलं च शङ्कर ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006008015, "chapter_id": 26008, "verse_number": "१-१९१-१६", "content_sanskrit": "विषंनृणां विनश्येत्तु एतेषां भक्षणाच्छिव ।\nदीपतैलप्रदानाच्च दंशैराकीटजैः शिव ।\nखर्जूरकविषं नश्येत्तदा वै नात्र संशयः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006008016, "chapter_id": 26008, "verse_number": "१-१९१-१७", "content_sanskrit": "दंशस्थानं वृश्चिकस्य शुण्ठी तगरसंयुता ।\nनश्येन्मधुमक्षिकाया एतेषां लेपतो विषम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006008017, "chapter_id": 26008, "verse_number": "१-१९१-१८", "content_sanskrit": "शतपुष्पा सैन्धवञ्च साज्यं वा तेन लेपयेत् ।\nशिरीषस्य तु बीजंवै सिद्ध क्षीरेण घर्षितम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006008018, "chapter_id": 26008, "verse_number": "१-१९१-१९", "content_sanskrit": "तल्लेपेन महादेव नश्येत्कुक्कुरजं विषम् ।\nज्वलिताग्निर्वारिसेको तथा दर्दुरजं विषम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006008019, "chapter_id": 26008, "verse_number": "१-१९१-२०", "content_sanskrit": "धत्तूरकरसोन्मिश्रं क्षीराद्यगुडपानतः ।\nशूनां विषं विनश्येत्तु शशाङ्काङ्कितशेखर ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006008020, "chapter_id": 26008, "verse_number": "१-१९१-२१", "content_sanskrit": "वटनिम्बशमीनाञ्च वल्कलैः क्वथितं जलम् ।\nतत्सेकान्मुखदन्तानां नश्येद्वै विषवेदना ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006008021, "chapter_id": 26008, "verse_number": "१-१९१-२२", "content_sanskrit": "लेपनाद्देवदारोश्च गैरिकस्य च लेपनात् ।\nनागेश्वरो दरिद्रे द्वे तथा मञ्जिष्ठकहर ।\nएभिर्लेपाद्विनश्येत्तु लूताविषमुमापते ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006008022, "chapter_id": 26008, "verse_number": "१-१९१-२३", "content_sanskrit": "करञ्जस्य तु बीजानि वरुणच्छदमेव च ।\nतिलाश्च सर्षपा हन्युर्विषं वै नात्र संशयः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006008023, "chapter_id": 26008, "verse_number": "१-१९१-२४", "content_sanskrit": "घृतं कुमारीपत्रं वै दत्तं सलवणं हर ।\nतुरङ्गमशरीराणां कण्डूर्नश्येद्दशाहतः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]