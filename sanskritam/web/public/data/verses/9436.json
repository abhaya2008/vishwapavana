[{"id": 5000436000, "chapter_id": 9436, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे एकोनत्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000436001, "chapter_id": 9436, "verse_number": "६-२९-१", "content_sanskrit": "शुकेन तु समादिष्टान् दृष्ट्वा स हरियूथपान्।\nलक्ष्मणं च महावीर्यं भुजं रामस्य दक्षिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000436002, "chapter_id": 9436, "verse_number": "६-२९-२", "content_sanskrit": "समीपस्थं च रामस्य भ्रातरं च विभीषणम्।\nसर्ववानरराजं च सुग्रीवं भीमविक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000436003, "chapter_id": 9436, "verse_number": "६-२९-३", "content_sanskrit": "अङ्गदं चापि बलिनं वज्रहस्तात्मजात्मजम्।\nहनूमन्तं च विक्रान्तं जाम्बवन्तं च दुर्जयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000436004, "chapter_id": 9436, "verse_number": "६-२९-४", "content_sanskrit": "सुषेणं कुमुदं नीलं नलं च प्लवगर्षभम्।\nगजं गवाक्षं शरभं मैन्दं च द्विविदं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000436005, "chapter_id": 9436, "verse_number": "६-२९-५", "content_sanskrit": "किंचिदाविग्नहृदयो जातक्रोधश्च रावणः।\nभर्त्सयामास तौ वीरौ कथान्ते शुकसारणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000436006, "chapter_id": 9436, "verse_number": "६-२९-६", "content_sanskrit": "अधोमुखौ तौ प्रणतावब्रवीच्छुकसारणौ।\nरोषगद‍्गदया वाचा संरब्धं परुषं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000436007, "chapter_id": 9436, "verse_number": "६-२९-७", "content_sanskrit": "न तावत् सदृशं नाम सचिवैरुपजीविभिः।\nविप्रियं नृपतेर्वक्तुं निग्रहे प्रग्रहे प्रभोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000436008, "chapter_id": 9436, "verse_number": "६-२९-८", "content_sanskrit": "रिपूणां प्रतिकूलानां युद्धार्थमभिवर्तताम्।\nउभाभ्यां सदृशं नाम वक्तुमप्रस्तवे स्तवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000436009, "chapter_id": 9436, "verse_number": "६-२९-९", "content_sanskrit": "आचार्या गुरवो वृद्धा वृथा वां पर्युपासिताः।\nसारं यद् राजशास्त्राणामनुजीव्यं न गृह्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000436010, "chapter_id": 9436, "verse_number": "६-२९-१०", "content_sanskrit": "गृहीतो वा न विज्ञातो भारोऽज्ञानस्य वाह्यते।\nईदृशैः सचिवैर्युक्तो मूर्खैर्दिष्ट्या धराम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000436011, "chapter_id": 9436, "verse_number": "६-२९-११", "content_sanskrit": "किं नु मृत्योर्भयं नास्ति मां वक्तुं परुषं वचः।\nयस्य मे शासतो जिह्वा प्रयच्छति शुभाशुभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000436012, "chapter_id": 9436, "verse_number": "६-२९-१२", "content_sanskrit": "अप्येव दहनं स्पृष्ट्वा वने तिष्ठन्ति पादपाः।\nराजदण्डपरामृष्टास्तिष्ठन्ते नापराधिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000436013, "chapter_id": 9436, "verse_number": "६-२९-१३", "content_sanskrit": "हन्यामहं त्विमौ पापौ शत्रुपक्षप्रशंसिनौ।\nयदि पूर्वोपकारैर्मे क्रोधो न मृदुतां व्रजेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000436014, "chapter_id": 9436, "verse_number": "६-२९-१४", "content_sanskrit": "अपध्वंसत नश्यध्वं संनिकर्षादितो मम।\nनहि वां हन्तुमिच्छामि स्मराम्युपकृतानि वाम्।\nहतावेव कृतघ्नौ द्वौ मयि स्नेहपराङ्मुखौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000436015, "chapter_id": 9436, "verse_number": "६-२९-१५", "content_sanskrit": "एवमुक्तौ तु सव्रीडौ तौ दृष्ट्वा शुकसारणौ।\nरावणं जयशब्देन प्रतिनन्द्याभिनिःसृतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000436016, "chapter_id": 9436, "verse_number": "६-२९-१६", "content_sanskrit": "अब्रवीच्च दशग्रीवः समीपस्थं महोदरम्।\nउपस्थापय मे शीघ्रं चारानिति निशाचरः।\nमहोदरस्तथोक्तस्तु शीघ्रमाज्ञापयच्चरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000436017, "chapter_id": 9436, "verse_number": "६-२९-१७", "content_sanskrit": "ततश्चाराः संत्वरिताः प्राप्ताः पार्थिवशासनात्।\nउपस्थिताः प्राञ्जलयो वर्धयित्वा जयाशिषः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000436018, "chapter_id": 9436, "verse_number": "६-२९-१८", "content_sanskrit": "तानब्रवीत् ततो वाक्यं रावणो राक्षसाधिपः।\nचारान् प्रत्यायिकान् शूरान् धीरान् विगतसाध्वसान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000436019, "chapter_id": 9436, "verse_number": "६-२९-१९", "content_sanskrit": "इतो गच्छत रामस्य व्यवसायं परीक्षितुम्।\nमन्त्रेष्वभ्यन्तरा येऽस्य प्रीत्या तेन समागताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000436020, "chapter_id": 9436, "verse_number": "६-२९-२०", "content_sanskrit": "कथं स्वपिति जागर्ति किमद्य च करिष्यति।\nविज्ञाय निपुणं सर्वमागन्तव्यमशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000436021, "chapter_id": 9436, "verse_number": "६-२९-२१", "content_sanskrit": "चारेण विदितः शत्रुः पण्डितैर्वसुधाधिपैः।\nयुद्धे स्वल्पेन यत्नेन समासाद्य निरस्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000436022, "chapter_id": 9436, "verse_number": "६-२९-२२", "content_sanskrit": "चारास्तु ते तथेत्युक्त्वा प्रहृष्टा राक्षसेश्वरम्।\nशार्दूलमग्रतः कृत्वा ततश्चक्रुः प्रदक्षिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000436023, "chapter_id": 9436, "verse_number": "६-२९-२३", "content_sanskrit": "ततस्तं तु महात्मानं चारा राक्षससत्तमम्।\nकृत्वा प्रदक्षिणं जग्मुर्यत्र रामः सलक्ष्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000436024, "chapter_id": 9436, "verse_number": "६-२९-२४", "content_sanskrit": "ते सुवेलस्य शैलस्य समीपे रामलक्ष्मणौ।\nप्रच्छन्ना ददृशुर्गत्वा ससुग्रीवविभीषणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000436025, "chapter_id": 9436, "verse_number": "६-२९-२५", "content_sanskrit": "प्रेक्षमाणाश्चमूं तां च बभूवुर्भयविह्वलाः।\nते तु धर्मात्मना दृष्टा राक्षसेन्द्रेण राक्षसाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000436026, "chapter_id": 9436, "verse_number": "६-२९-२६", "content_sanskrit": "विभीषणेन तत्रस्था निगृहीता यदृच्छया।\nशार्दूलो ग्राहितस्त्वेकः पापोऽयमिति राक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000436027, "chapter_id": 9436, "verse_number": "६-२९-२७", "content_sanskrit": "मोचितः सोऽपि रामेण वध्यमानः प्लवंगमैः।\nआनृशंस्येन रामेण मोचिता राक्षसाः परे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000436028, "chapter_id": 9436, "verse_number": "६-२९-२८", "content_sanskrit": "वानरैरर्दितास्ते तु विक्रान्तैर्लघुविक्रमैः।\nपुनर्लङ्कामनुप्राप्ताः श्वसन्तो नष्टचेतसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000436029, "chapter_id": 9436, "verse_number": "६-२९-२९", "content_sanskrit": "ततो दशग्रीवमुपस्थितास्ते\nचारा बहिर्नित्यचरा निशाचराः।\nगिरेः सुवेलस्य समीपवासिनं\nन्यवेदयन् रामबलं महाबलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000436030, "chapter_id": 9436, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे एकोनत्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]