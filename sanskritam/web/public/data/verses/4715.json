[{"id": 2175175, "chapter_id": 4715, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2175176, "chapter_id": 4715, "verse_number": "१", "content_sanskrit": "ब्रह्मयोनिभिराकीर्णो जगाम यदुनन्दनः ।\nयत्र दाल्भ्यो बको राजन् पश्वर्थं सुमहातपाः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2175177, "chapter_id": 4715, "verse_number": "२", "content_sanskrit": "जुहाव धृतराष्ट्रस्य राष्ट्रं कोपसमन्वितः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2175178, "chapter_id": 4715, "verse_number": "३", "content_sanskrit": "तपसा घोररूपेण कर्शयन् देहमात्मनः ।\nक्रोधेन महताऽऽविष्टो धर्मात्मा वै प्रतापवान्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2175179, "chapter_id": 4715, "verse_number": "४", "content_sanskrit": "पुरा हि नैमिशेयानां सत्रे द्वादशवार्षिके ।\nवृत्ते वैश्वजितोऽन्ते वै पाञ्चालानृषयोऽगमन् ।\nतत्रेश्वरमयाचन्त दक्षिणार्थे मनीषिणः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2175180, "chapter_id": 4715, "verse_number": "५", "content_sanskrit": "बलान्वितान् वत्सतरान् निर्व्याधीन् सप्तविंशतिम् ।\nतानब्रवीद् बको दाल्भ्यो विभजध्वं पशूनिति\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2175181, "chapter_id": 4715, "verse_number": "६", "content_sanskrit": "पशूनेतानहं त्यक्त्वा भिक्षिषे राजसत्तमम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2175182, "chapter_id": 4715, "verse_number": "७", "content_sanskrit": "एवमुक्त्वा बको राजन्नृषीन् सर्वान् प्रतापवान् ।\nजगाम धृतराष्ट्रस्य भवनं ब्राह्मणोत्तमः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2175183, "chapter_id": 4715, "verse_number": "८", "content_sanskrit": "स समीपं गतो भूत्वा धृतराष्ट्रं नरेश्वरम् ।\nअयाचत पशून् दाल्भ्यः स चैनं रुषितोऽब्रवीत्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2175184, "chapter_id": 4715, "verse_number": "९", "content_sanskrit": "यदृच्छया मृता दृष्ट्वा गास्तदा नृपसत्तम\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2175185, "chapter_id": 4715, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2175186, "chapter_id": 4715, "verse_number": "१०", "content_sanskrit": "एतान् पशून् नय क्षिप्रं ब्रह्मबन्धो यदिच्छसि\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2175187, "chapter_id": 4715, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2175188, "chapter_id": 4715, "verse_number": "११", "content_sanskrit": "ऋषिस्त्वथ बकः क्रुद्धः चिन्तयामास धर्मवित्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2175189, "chapter_id": 4715, "verse_number": "", "content_sanskrit": "बकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2175190, "chapter_id": 4715, "verse_number": "१२", "content_sanskrit": "अहो बत नृशंसं वै वाक्यमुक्तोऽस्मि संसदि\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2175191, "chapter_id": 4715, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2175192, "chapter_id": 4715, "verse_number": "१३", "content_sanskrit": "चिन्तयित्वा मुहूर्तेन रोषाविष्टो द्विजोत्तमः ।\nमतिं चक्रे विनाशाय धृतराष्ट्रस्य भारत\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2175193, "chapter_id": 4715, "verse_number": "१४", "content_sanskrit": "उत्कृत्य तु मृता गा वै मांसानि द्विजसत्तमः ।\nजुहाव धृतराष्ट्रस्य राष्ट्रं नरपतेः परम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2175194, "chapter_id": 4715, "verse_number": "१५", "content_sanskrit": "अवतीर्णः सरस्वत्याः तीर्थे प्रज्वाल्य पावकम् ।\nबको दाल्भ्यो महाराज परमं नियमं स्थितः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2175195, "chapter_id": 4715, "verse_number": "१६", "content_sanskrit": "स तैरेव जुहावाग्नौ राष्ट्रं मांसैर्महातपाः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2175196, "chapter_id": 4715, "verse_number": "१७", "content_sanskrit": "तस्मिंस्तु विधिवत् सत्रे वर्तमाने सुदारुणे ।\nअक्षीयत ततो राष्ट्रं धृतराष्ट्रस्य पार्थिव\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2175197, "chapter_id": 4715, "verse_number": "१८", "content_sanskrit": "छिद्यमानं यथा कान्तं वनं परशुना तथा ।\nबभूवापहृतं तच्च व्यवकीर्णमचेतनम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2175198, "chapter_id": 4715, "verse_number": "१९", "content_sanskrit": "दृष्ट्वा तदवकीर्णं तु राज्यं स मनुजाधिपः ।\nबभूव दुर्मना राजन् चिन्तया परयान्वितः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2175199, "chapter_id": 4715, "verse_number": "२०", "content_sanskrit": "मोक्षार्थमकरोद् यत्नं ब्राह्मणैः सहितः पुरा ।\nन च श्रेयोभ्यगच्छत्तु क्षीयते राष्ट्रमेव यत्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2175200, "chapter_id": 4715, "verse_number": "२१", "content_sanskrit": "अथासौ पार्थिवः खिन्नः ते च विप्रास्तदा नृप\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2175201, "chapter_id": 4715, "verse_number": "२२", "content_sanskrit": "यदा चापि न शक्नोति राष्ट्रं मोचयितुं नृपः ।\nअथ विप्रश्निकांस्तत्र पप्रच्छ जनमेजय\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2175202, "chapter_id": 4715, "verse_number": "२३", "content_sanskrit": "ततो विप्रश्निकाः प्राहुः पशुविप्रकृतस्त्वया ।\nमांसैरथ जुहोतीदं तव राष्ट्रं मुनिर्बकः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2175203, "chapter_id": 4715, "verse_number": "२४", "content_sanskrit": "तेन ते हूयमानस्य राष्ट्रस्यासीत् क्षयो महान् ।\nतस्य तत्तपसः कर्म येन ते ह्यनयो महान्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2175204, "chapter_id": 4715, "verse_number": "२५", "content_sanskrit": "यदीच्छसि महाबाहो शान्तिं राष्ट्रस्य भूमिप ।\nअपां कूले सरस्वत्याः तं प्रसादय पार्थिव\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2175205, "chapter_id": 4715, "verse_number": "२६", "content_sanskrit": "सरस्वतीं ततो गत्वा स राजा बकमब्रवीत् ।\nनिपत्य शिरसा भूमौ प्राञ्जलिर्भरतर्षभ\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2175206, "chapter_id": 4715, "verse_number": "", "content_sanskrit": "राजा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2175207, "chapter_id": 4715, "verse_number": "२७", "content_sanskrit": "प्रसादये त्वां भगवन्नपराधं क्षमस्व मे ।\nमम दीनस्य लुब्धस्य मौर्ख्येण हतचेतसः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2175208, "chapter_id": 4715, "verse_number": "२८", "content_sanskrit": "त्वं गतिस्त्वं च मे नाथः प्रसादं कर्तुमर्हसि\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2175209, "chapter_id": 4715, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2175210, "chapter_id": 4715, "verse_number": "२९", "content_sanskrit": "तं तथा विलपन्तं तु शोकोपहतचेतसम् ।\nदृष्ट्वा तस्य कृपा जज्ञे राष्ट्रं तस्य व्यमोचयत्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2175211, "chapter_id": 4715, "verse_number": "३०", "content_sanskrit": "ऋषिः प्रसन्नस्तस्यासीत् संरम्भं च विहाय सः ।\nमोक्षार्थं तस्य राष्ट्रस्य जुहाव पुनराहुतिम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2175212, "chapter_id": 4715, "verse_number": "३१", "content_sanskrit": "मोक्षयित्वा तदा राष्ट्रं प्रतिगृह्य तथा पशून् ।\nहृष्टात्मा नैमिषारण्यं जगाम पुनरेव ह\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2175213, "chapter_id": 4715, "verse_number": "३२", "content_sanskrit": "धृतराष्ट्रोऽपि धर्मात्मा स्वस्थचेता महामनाः ।\nस्वमेव नगरं राजन् प्रविवेश महर्द्धिमत्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2175214, "chapter_id": 4715, "verse_number": "३३", "content_sanskrit": "तत्र तीर्थे महाराज बृहस्पतिरुदारधीः ।\nअसुराणामभावाय भवाय च दिवौकसाम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2175215, "chapter_id": 4715, "verse_number": "३४", "content_sanskrit": "मांसैरभिजुहावेष्टिमक्षीयन्त ततोऽसुराः ।\nदैवतैरभिसम्भग्ना जितकाशिभिराहवे\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2175216, "chapter_id": 4715, "verse_number": "३५", "content_sanskrit": "तत्रापि विधिवद् दत्त्वा ब्राह्मणेभ्यो महायशाः ।\nवाजिनः कुञ्जरांश्चैव रथांश्चाश्वतरीयुतान्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2175217, "chapter_id": 4715, "verse_number": "३६", "content_sanskrit": "रत्नानि च महार्हाणि धनं धान्यं च पुष्कलम् ।\nययौ तीर्थं महाराज यायातं पृथिवीपते\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2175218, "chapter_id": 4715, "verse_number": "३७", "content_sanskrit": "यत्र यज्ञे ययातेस्तु महाराज सरस्वती ।\nसर्पिः पयश्च सुस्राव नाहुषस्य महात्मनः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2175219, "chapter_id": 4715, "verse_number": "३८", "content_sanskrit": "यत्रेष्ट्वा पुरुषव्याघ्र ययातिः पृथिवीपतिः ।\nआक्रामदूर्ध्वं त्वरितो लेभे कामांश्च पुष्कलान्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2175220, "chapter_id": 4715, "verse_number": "३९", "content_sanskrit": "ययातेर्यजमानस्य यत्र राजन् सरस्वती ।\nसघृता प्रययौ राजन् ब्राह्मणानां महात्मनाम्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2175221, "chapter_id": 4715, "verse_number": "४०", "content_sanskrit": "यत्र यत्र हि यो विप्रो यान् यान् कामानभीप्सति ।\nतत्र तत्र सरिच्छ्रेष्ठा ससर्ज सुबहून् रसान्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2175222, "chapter_id": 4715, "verse_number": "४१", "content_sanskrit": "तत्र देवाः सगन्धर्वाः प्रीता यज्ञस्य सम्पदा ।\nविस्मिता मानुषा ह्यासन् दृष्ट्वा तां यज्ञसम्पदम्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2175223, "chapter_id": 4715, "verse_number": "४२", "content_sanskrit": "ततस्तालकेतुर्महाधर्मसेतुः\nमहात्मा कृतात्मा महादाननित्यः ।\nवसिष्ठापवाहं महाभीमवेगं\nधृतात्मा जितात्मा समभ्याजगाम\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2175224, "chapter_id": 4715, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां गदापर्वणि त्रयोदशोऽध्यायः ॥१३॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]