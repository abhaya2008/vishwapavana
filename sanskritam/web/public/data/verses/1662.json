[{"id": 2030393, "chapter_id": 1662, "verse_number": "३-३००-०x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2030394, "chapter_id": 1662, "verse_number": "३-३००-१", "content_sanskrit": "तस्यां रात्र्यां व्यतीतायामुदिते सूर्यमण्डले।\nकृतपौर्वाह्णिकाः सर्वे समेयुस्ते तपोधनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2030395, "chapter_id": 1662, "verse_number": "३-३००-२", "content_sanskrit": "तदेव सर्वं सावित्र्या महाभाग्यं महर्षयः।\nद्युम्सेनाय नातृप्यन्कथयन्तः पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2030396, "chapter_id": 1662, "verse_number": "३-३००-३", "content_sanskrit": "ततः प्रकृतयः सर्वाः साल्वेभ्योऽभ्यागा नृपम्।\nआचख्युर्निहतं चैव स्वेनामात्येन तं द्विषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2030397, "chapter_id": 1662, "verse_number": "३-३००-४", "content_sanskrit": "तं मन्त्रिणा हतं प्रोच्य ससहायं सबान्धवम्।\nन्यवेदयन्यथावृत्तं विद्रुतं च द्विषद्बलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2030398, "chapter_id": 1662, "verse_number": "३-३००-५", "content_sanskrit": "ऐकमत्यं च सर्वस्य जनस्य स्वं नृपं प्रति।\nसचक्षुर्वाऽप्यचक्षुर्वा स नो राजा भवत्विति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2030399, "chapter_id": 1662, "verse_number": "३-३००-६", "content_sanskrit": "अनेन निश्चयेनेह वयं प्रस्थापिता नृप।\nप्राप्तानीमानि यानानि चतुरङ्गं च ते बलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2030400, "chapter_id": 1662, "verse_number": "३-३००-७", "content_sanskrit": "प्रयाहि राजन्भद्रं ते घुष्टस्ते नगरे जयः।\nअध्यास्स्व चिररात्राय पितृपैतामहं पदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2030401, "chapter_id": 1662, "verse_number": "३-३००-८x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2030402, "chapter_id": 1662, "verse_number": "३-३००-८", "content_sanskrit": "चक्षुष्मन्तं च तं दृष्ट्वा राजानं वपुषाऽन्वितम्।\nमूर्ध्ना निपतिताः सर्वेविस्मयोत्फुल्ललोचनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2030403, "chapter_id": 1662, "verse_number": "३-३००-९", "content_sanskrit": "तोऽभिवाद्य तान्वृद्धान्द्विजानाश्रमवासिनः।\nतैश्चाभिपूजितः सर्वैः प्रययौ नगरं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2030404, "chapter_id": 1662, "verse_number": "३-३००-१०", "content_sanskrit": "शैव्या च सह सावित्र्या स्वास्तीर्णेन सुवर्चसा।\nनरयुक्तेन यानेन प्रययौ सेनया वृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2030405, "chapter_id": 1662, "verse_number": "३-३००-११", "content_sanskrit": "ततोऽभिषिषिचुः प्रीत्या द्युमत्सेनं पुरोहिताः।\nपुत्रं चास्य महात्मानं यौवराज्येऽभ्यषेचयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2030406, "chapter_id": 1662, "verse_number": "३-३००-१२", "content_sanskrit": "ततः कालेन महता सावित्र्याः कीर्तिवर्धनम्।\nतद्वै पुत्रशतं जज्ञे शूराणामनिवर्तिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2030407, "chapter_id": 1662, "verse_number": "३-३००-१३", "content_sanskrit": "भ्रातृणां सोदराणां च तथैवास्याभवच्छतम्।\nमद्राधिपस्याश्वपतेर्मालव्यां सुमहाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2030408, "chapter_id": 1662, "verse_number": "३-३००-१४", "content_sanskrit": "एवमात्मा पिता माता श्वश्रूः श्वशुर एव च।\nभर्तुः कुलं च सावित्र्या सर्वं कृच्छ्रात्समुद्धृतं ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2030409, "chapter_id": 1662, "verse_number": "३-३००-१५", "content_sanskrit": "तथैवैषा हि कल्याणी द्रौपदी शीलसंमता।\nतारयिष्यति वः सर्वान्सावित्रीव कुलाङ्गना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2030410, "chapter_id": 1662, "verse_number": "३-३००-१६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2030411, "chapter_id": 1662, "verse_number": "३-३००-१६", "content_sanskrit": "एवं स पाण्डवस्तेन अनुनीतो महात्मना।\nविशोको विज्वरो राजन्काम्यके न्यवसत्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2030412, "chapter_id": 1662, "verse_number": "३-३००-१७", "content_sanskrit": "यश्चेदं शृणुयाद्भक्त्या सावित्र्याख्यानमुत्तमम्।\nस सुखी सर्वसिद्धार्थो न दुःखं प्राप्नुयान्नरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2030413, "chapter_id": 1662, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि पतिव्रतामाहात्म्यपर्वणि त्रिशततमोऽध्यायः ॥ ३०० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]