[{"id": 7003967000, "chapter_id": 23967, "verse_number": "३-१-३०-१", "content_sanskrit": "श्रीसूत उवाच ।\nविहिताभिषवो मर्त्यः सर्वतीर्थेऽतिपावने ।\nब्रह्महत्यादिपापघ्नीं धनुष्कोटिं ततो व्रजेत्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003967001, "chapter_id": 23967, "verse_number": "३-१-३०-२", "content_sanskrit": "यस्याः स्मरणमात्रेण मुक्तः स्यान्मानवो भुवि ।\nधनुष्कोटिं प्रपश्यंति स्नांति वा कथयंति ये॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003967002, "chapter_id": 23967, "verse_number": "३-१-३०-३", "content_sanskrit": "अष्टाविंशतिभेदांस्ते नरकान्नोपभुंजते ।\nतामिस्रमंधतामिस्रं महारौरवरौरवौ॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003967003, "chapter_id": 23967, "verse_number": "३-१-३०-४", "content_sanskrit": "कुम्भीपाकं कालसूत्रमसिपत्रवनं तथा ।\nकृमिभक्षोंऽधकूपश्च संदंशं शाल्मली तथा॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003967004, "chapter_id": 23967, "verse_number": "३-१-३०-५", "content_sanskrit": "सूर्मिर्वैतरणी प्राणरोधो विशसनं तथा ।\nलालाभक्षोऽप्यवीचिश्च सारमेयादनं तथा॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003967005, "chapter_id": 23967, "verse_number": "३-१-३०-६", "content_sanskrit": "तथैव वज्रकणकं क्षारकर्दमपातनम् ।\nरक्षोगणाशनं चापि शूलप्रोतं वितोदनम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003967006, "chapter_id": 23967, "verse_number": "३-१-३०-७", "content_sanskrit": "दंदशूकाशनं चापि पर्यावर्तनसंज्ञितम् ।\nतिरोधानाभिधं विप्रास्तथा सूचीमुखाभिधम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003967007, "chapter_id": 23967, "verse_number": "३-१-३०-८", "content_sanskrit": "पूयशोणितभक्षं च विषाग्निपरिपीडनम् ।\nअष्टाविंशतिसंख्याकमेवं नरकसंचयम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003967008, "chapter_id": 23967, "verse_number": "३-१-३०-९", "content_sanskrit": "न याति मनुजो विप्रा धनुष्कोटौ निमज्जनात् ।\nवित्तापत्यकलत्राणां योऽन्येषामपहारकः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003967009, "chapter_id": 23967, "verse_number": "३-१-३०-१०", "content_sanskrit": "स कालपाशनिर्बद्धो यमदूतैर्भयानकैः ।\nतामिस्रनरके घोरे पात्यते बहुवत्सरम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003967010, "chapter_id": 23967, "verse_number": "३-१-३०-११", "content_sanskrit": "स्नाति चेद्धनुषः कोटौ तस्मिन्नासौ निपात्यते ।\nयो निहत्य तु भर्तारं भुंक्ते तस्य धनादिकान्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003967011, "chapter_id": 23967, "verse_number": "३-१-३०-१२", "content_sanskrit": "पात्यते सोंऽधतामिस्रे महादुःखसमाकुले ।\nस्नाति चेद्धनुषः कोटौ तस्मिन्नासौ निपात्यते॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003967012, "chapter_id": 23967, "verse_number": "३-१-३०-१३", "content_sanskrit": "भूतद्रोहेण यो मर्त्यः पुष्णाति स्वकुटुंबकम् ।\nस तानिह विहायाशु रौरवे पात्यते ध्रुवम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003967013, "chapter_id": 23967, "verse_number": "३-१-३०-१४", "content_sanskrit": "विषोल्बणमहासर्पसंकुले यमपूरुषैः ।\nस्नाति चेद्धनुषः कोटौ तस्मिन्नासौ निपात्यते॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003967014, "chapter_id": 23967, "verse_number": "३-१-३०-१५", "content_sanskrit": "यः स्वदेहंभरो मर्त्यो भार्यापुत्रादिकं विना ।\nस महारौरवे घोरे पात्यते निजमांसभुक्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003967015, "chapter_id": 23967, "verse_number": "३-१-३०-१६", "content_sanskrit": "स्नाति चेद्धनुषः कोटौ तस्मि न्नासौ निपात्यते ।\nयः पशून्पक्षिणो वापि सप्राणान्निरुणद्धि वै॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003967016, "chapter_id": 23967, "verse_number": "३-१-३०-१७", "content_sanskrit": "कृपालेशविहीनं तं क्रव्यादैरपि निंदितम् ।\nकुंभीपाके तप्ततैले पात यंति यमानुगाः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003967017, "chapter_id": 23967, "verse_number": "३-१-३०-१८", "content_sanskrit": "स्नाति चेद्धनुषः कोटौ तस्मिन्नासौ निपात्यते ।\nमातरं पितरं विप्रान्यो द्वेष्टि पुरुषाधमः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003967018, "chapter_id": 23967, "verse_number": "३-१-३०-१९", "content_sanskrit": "स कालसूत्र नरके विस्तृतायुतयोजने ।\nअधस्तादग्निसंतप्त उपर्यर्कमरीचिभिः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003967019, "chapter_id": 23967, "verse_number": "३-१-३०-२०", "content_sanskrit": "खले ताम्रमये विप्राः पात्यते क्षुधयार्दितः ।\nस्नाति चेद्धनुषः कोटौ तस्मिन्नासौ निपात्यते॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003967020, "chapter_id": 23967, "verse_number": "३-१-३०-२१", "content_sanskrit": "यो वेदमार्गमुल्लंघ्य वर्तते कुपथे नरः ।\nसोऽसिपत्रवने घोरे पात्यते यमकिंकरैः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003967021, "chapter_id": 23967, "verse_number": "३-१-३०-२२", "content_sanskrit": "स्नाति चेद्धनुषः कोटौ तस्मिन्नासौ निपात्यते ।\nयो राजा राजभृत्यो वा ह्यदंड्ये दंडमाचरेत्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003967022, "chapter_id": 23967, "verse_number": "३-१-३०-२३", "content_sanskrit": "शरीरदंडं विप्रे वा स शूकरमुखे द्विजाः ।\nपात्यते नरके घोरे इक्षुवद्यंत्रपीडितः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003967023, "chapter_id": 23967, "verse_number": "३-१-३०-२४", "content_sanskrit": "स्नाति चेद्धनुषः कोटौ तस्मिन्नासौ निपात्यते ।\nईश्वराधीनवृत्तीनां हिंसां यः प्राणिनां चरेत्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003967024, "chapter_id": 23967, "verse_number": "३-१-३०-२५", "content_sanskrit": "तैरेव पीड्यमानोऽयं जंतुभिः स्वेन पीडितैः ।\nअंधकूपे महाभीमे पात्यते यमकिंकरैः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003967025, "chapter_id": 23967, "verse_number": "३-१-३०-२६", "content_sanskrit": "तत्रांधकारबहुले विनिद्रो निर्वृतश्चरेत् ।\nचेद्धनुषः कोटौ तस्मिन्नासौ निपात्यते॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003967026, "chapter_id": 23967, "verse_number": "३-१-३०-२७", "content_sanskrit": "योऽश्नाति पंक्तिभेदेन सस्यसूपादिकं नरः ।\nअकृत्वा पंचयज्ञं वा भुंक्ते मोहेन स द्विजाः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003967027, "chapter_id": 23967, "verse_number": "३-१-३०-२८", "content_sanskrit": "प्रपात्यते यमभटैर्नरके कृमिभोजने ।\nभक्ष्यमाणः कृमिशतैर्भक्षयन्कृमिसंच यान्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003967028, "chapter_id": 23967, "verse_number": "३-१-३०-२९", "content_sanskrit": "स्वयं च कृमिभूतः संस्तिष्ठेद्यावदघक्षयम् ।\nस्नाति चेद्धनुषः कोटौ तस्मिन्नासौ निपात्यते॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003967029, "chapter_id": 23967, "verse_number": "३-१-३०-३०", "content_sanskrit": "यो हरेद्विप्रवित्तानि स्तेयेन बलतोऽपि वा ।\nअन्येषामपि वित्तानि राजा तत्पुरुषोऽपि वा॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003967030, "chapter_id": 23967, "verse_number": "३-१-३०-३१", "content_sanskrit": "अयस्मयाग्निकुंडेषु संदंशैः सोऽतिपीडितः ।\nसंदंशे नरके घोरे पात्यते यमपूरुषैः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003967031, "chapter_id": 23967, "verse_number": "३-१-३०-३२", "content_sanskrit": "स्नाति चेद्धनुषः कोटौ तस्मिन्नासौ निपात्यते ।\nअगम्यां योभिगच्छेत स्त्रियं वै पुरुषाधमः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003967032, "chapter_id": 23967, "verse_number": "३-१-३०-३३", "content_sanskrit": "अगम्यं पुरुषं योषिदभिगच्छेत वा द्विजाः ।\nतावयस्मयनारीं च पुरुषं चाप्ययस्मयम्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003967033, "chapter_id": 23967, "verse_number": "३-१-३०-३४", "content_sanskrit": "तप्तावालिंग्य तिष्ठंतौ यावच्चंद्रदिवाकरौ ।\nसूर्म्याख्ये नरके घोरे पात्येते बहुकंटके॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003967034, "chapter_id": 23967, "verse_number": "३-१-३०-३५", "content_sanskrit": "स्नाति चेद्धनुषः कोटौ तस्मिन्नासौ निपात्यते ।\nबाधते सर्वजंतून्यो नानो पायैरुपद्रवैः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003967035, "chapter_id": 23967, "verse_number": "३-१-३०-३६", "content_sanskrit": "शाल्मलीनरके घोरे पात्यते बहुकंटके ।\nस्नाति चेद्धनुषः कोटौ तस्मिन्नासौ निपात्यते॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003967036, "chapter_id": 23967, "verse_number": "३-१-३०-३७", "content_sanskrit": "राजा वा राजभृत्यो वा यः पाषंडमनुव्रतः ।\nभेदको धर्मसेतूनां वैतरण्यां निपात्यते॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003967037, "chapter_id": 23967, "verse_number": "३-१-३०-३८", "content_sanskrit": "स्नानि चेद्धनुषः कोटौ तस्मिन्नासौ निपात्यते ।\nवृषलीसंगदुष्टो यः शौचाद्याचारवर्जितः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003967038, "chapter_id": 23967, "verse_number": "३-१-३०-३९", "content_sanskrit": "त्यक्तलज्जस्त्यक्तवेदः पशुचर्यारत स्तथा ।\nस पूयविष्ठामूत्रासृक्छ्लेष्मपित्तादिपूरिते॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003967039, "chapter_id": 23967, "verse_number": "३-१-३०-४०", "content_sanskrit": "अतिबीभत्सनरके पात्यते यमकिंकरैः ।\nस्नाति चेद्धनुषः कोटौ तस्मिन्नासौ निपात्यते॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003967040, "chapter_id": 23967, "verse_number": "३-१-३०-४१", "content_sanskrit": "अश्मभिर्मृगयुर्हन्याद्बाणै र्वा बाधते मृगान् ।\nस विध्यमानो बाणौघैः परत्र यमकिंकरैः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003967041, "chapter_id": 23967, "verse_number": "३-१-३०-४२", "content_sanskrit": "प्राणरोधाख्यनरके पात्यते यमकिंकरैः ।\nस्नाति चेद्धनुषः कोटौ तस्मिन्नासौ निपात्यते॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003967042, "chapter_id": 23967, "verse_number": "३-१-३०-४३", "content_sanskrit": "दांभिको यः पशून्यज्ञे विध्यनुष्ठानवर्जितः ।\nहंत्यसौ परलोकेषु वैशसे नरके द्विजाः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003967043, "chapter_id": 23967, "verse_number": "३-१-३०-४४", "content_sanskrit": "कृन्त्यमानो यमभटैः पात्यते दुःखसंकुले ।\nस्नाति चेद्धनुषः कोटौ तस्मिन्नासौ निपात्यते॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003967044, "chapter_id": 23967, "verse_number": "३-१-३०-४५", "content_sanskrit": "आत्मभार्यां सवर्णां यो रेतः पाययते तु सः ।\nपरत्र रेतःपायी सन्रेतःकुंडे निपात्यते॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003967045, "chapter_id": 23967, "verse_number": "३-१-३०-४६", "content_sanskrit": "स्नाति चेद्धनुषः कोटौ तस्मिन्नासौ निपात्यते ।\nयो दस्युमार्ग माश्रित्य गरदो ग्रामदाहकः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003967046, "chapter_id": 23967, "verse_number": "३-१-३०-४७", "content_sanskrit": "वणिग्द्रव्यापहारी च स परत्र द्विजोत्तमाः ।\nवज्रदंष्ट्राहिकाभिख्ये नरके पात्यते चिरम्॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003967047, "chapter_id": 23967, "verse_number": "३-१-३०-४८", "content_sanskrit": "स्नाति चेद्धनुषः कोटौ तस्मिन्नासौ निपात्यते ।\nविद्यंते यानि चान्यानि नरकाणि परत्र वै॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003967048, "chapter_id": 23967, "verse_number": "३-१-३०-४९", "content_sanskrit": "तानि नाप्नोति मनुजो धनुष्कोटिनिमज्जनात् ।\nधनुष्कोटौ सकृत्स्ना नादश्वमेधफलं लभेत्॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003967049, "chapter_id": 23967, "verse_number": "३-१-३०-५०", "content_sanskrit": "आत्मविद्या भवेत्साक्षान्मुक्तिश्चापि चतुर्विधा ।\nन पापे रमते बुद्धिर्न भवेद्दुःखमेव वा॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003967050, "chapter_id": 23967, "verse_number": "३-१-३०-५१", "content_sanskrit": "बुद्धेः प्रीति र्भवेत्सम्यग्धनुष्कोटौ निमज्जनात् ।\nतुलापुरुषदानेन यत्फलं लभ्यते नरैः॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003967051, "chapter_id": 23967, "verse_number": "३-१-३०-५२", "content_sanskrit": "तत्फलं लभ्यते पुंभिर्धनुष्कोटौ निमज्जनात् ।\nगोसहस्र प्रदानेन यत्पुण्यं हि भवेन्नृणाम्॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003967052, "chapter_id": 23967, "verse_number": "३-१-३०-५३", "content_sanskrit": "तत्पुण्यं लभते मर्त्यो धनष्कोटौ निमज्जनात् ।\nधर्मार्थकाममोक्षेषु यंयमिच्छति पूरुषः॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003967053, "chapter_id": 23967, "verse_number": "३-१-३०-५४", "content_sanskrit": "तंतं सद्यः समाप्नोति धनुष्कोटौ निमज्जनात् ।\nमहापातकयुक्तो वा युक्तो वा सर्वपातकैः॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003967054, "chapter_id": 23967, "verse_number": "३-१-३०-५५", "content_sanskrit": "सद्यः पूतो भवेद्विप्रा धनुष्कोटौ निमज्जनात् ।\nप्रज्ञालक्ष्मीर्यशः संपज्ज्ञानं धर्मो विरक्तता॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003967055, "chapter_id": 23967, "verse_number": "३-१-३०-५६", "content_sanskrit": "मनःशुद्धिर्भवेन्नॄणां धनुष्कोटिनिमज्जनात् ।\nब्रह्महत्यायुतं चापि सुरापानायुतं तथा॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003967056, "chapter_id": 23967, "verse_number": "३-१-३०-५७", "content_sanskrit": "अयुतं गुरुदाराणां गमनं पापकारणम् ।\nस्तेयायुतं सुवर्णानां तत्संसर्गश्च कोटिशः॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003967057, "chapter_id": 23967, "verse_number": "३-१-३०-५८", "content_sanskrit": "शीघ्रं विलयमाप्नोति धनुष्कोटौ निमज्जनात् ।\nब्रह्महत्यासमानानि सुरापानसमानि च॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003967058, "chapter_id": 23967, "verse_number": "३-१-३०-५९", "content_sanskrit": "गुरुस्त्रीगमनेनापि यानि तुल्यानि चास्तिकाः ।\nसुवर्णस्तेयतुल्यानि तत्संसर्गसमानि च॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003967059, "chapter_id": 23967, "verse_number": "३-१-३०-६०", "content_sanskrit": "तानि सर्वाणि नश्यंति धनुष्को टि निमज्जनात् ।\nउक्तेष्वेतेषु संदेहो न कर्तव्यः कदाचन॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003967060, "chapter_id": 23967, "verse_number": "३-१-३०-६१", "content_sanskrit": "जिह्वाग्रे परशुं तप्तं धारयामि न संशयः ।\nअर्थवादमिमं सर्वं ब्रुवन्वै नारकी भवेत्॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003967061, "chapter_id": 23967, "verse_number": "३-१-३०-६२", "content_sanskrit": "संकरः स हि विज्ञेयः सर्वकर्मबहिष्कृतः ।\nअहो मौर्ख्यमहो मौर्ख्यमहो मौर्ख्यं द्विजोत्तमाः॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003967062, "chapter_id": 23967, "verse_number": "३-१-३०-६३", "content_sanskrit": "धनुष्कोट्यभिधे तीर्थे सर्वपातकनाशने ।\nअद्वैतज्ञानदे पुंसां भुक्तिमुक्तिप्रदायिनि॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003967063, "chapter_id": 23967, "verse_number": "३-१-३०-६४", "content_sanskrit": "इष्टकाम्यप्रदे नित्यं तथैवाज्ञाननाशने ।\nस्थितेऽपि तद्विहायायं रमतेऽन्यत्र वै जनः॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003967064, "chapter_id": 23967, "verse_number": "३-१-३०-६५", "content_sanskrit": "अहो मोहस्य माहात्म्यं मया वक्तुं न शक्यते ।\nस्नातस्य धनुषः कोटौ नांतकाद्भयमस्ति वै॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003967065, "chapter_id": 23967, "verse_number": "३-१-३०-६६", "content_sanskrit": "धनुष्कोटिं प्रपश्यंति तत्र स्नांति च ये नराः ।\nस्तुवंति च प्रशंसंति स्पृशंति च नमंति च ।\nन पिबंति हि ते स्तन्यं मातॄणां द्विजपुंगवाः॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003967066, "chapter_id": 23967, "verse_number": "३-१-३०-६७", "content_sanskrit": "ऋषय ऊचुः ।\nधनुष्कोट्याभिधा तस्य कथं सूत समागता॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003967067, "chapter_id": 23967, "verse_number": "३-१-३०-६८", "content_sanskrit": "तत्सर्वं ब्रूहि तत्त्वेन विस्तरान्मुनिपुंगव ।\nइति पृष्टो नैमिषीयैराह सूतः पुनश्च तान्॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003967068, "chapter_id": 23967, "verse_number": "३-१-३०-६९", "content_sanskrit": "श्रीसूत उवाच ।\nरामेण निहते युद्धे रावणे लोककण्टके ।\nबिभीषणे च लंकायां राजनि स्थापिते ततः॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003967069, "chapter_id": 23967, "verse_number": "३-१-३०-७०", "content_sanskrit": "वैदेहीलक्ष्मणयुतो रामो दशरथा त्मजः ।\nसुग्रीवप्रमुखैर्वीरैर्वानरैरपि संवृतः॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003967070, "chapter_id": 23967, "verse_number": "३-१-३०-७१", "content_sanskrit": "सिद्धचारणगन्धर्वदेवविद्याधरर्षिभिः ।\nअप्सरोभिश्च सततं स्तूयमाननिजाद्भुतः॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003967071, "chapter_id": 23967, "verse_number": "३-१-३०-७२", "content_sanskrit": "लीलाविधृतकोदण्डस्त्रिपुरघ्नो यथा शिवः ।\nसर्वैः परिवृतो रामो गंधमादनमन्वगात्॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003967072, "chapter_id": 23967, "verse_number": "३-१-३०-७३", "content_sanskrit": "तत्र स्थितं महात्मानं राघवं रावणांतकम् ।\nप्रांजलिः प्रार्थयामास धर्मज्ञोऽथ विभीषणः॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003967073, "chapter_id": 23967, "verse_number": "३-१-३०-७४", "content_sanskrit": "सेतुनानेन ते राम राजानः सर्व एव हि ।\nबलोद्रिक्ताः समभ्येत्य पीडयेयुः पुरीं मम॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003967074, "chapter_id": 23967, "verse_number": "३-१-३०-७५", "content_sanskrit": "अतः सेतुमिमं भिंधि धनुष्कोट्या रघूद्वह ।\nइति संप्रार्थितस्तेन पौलस्त्येन स राघवः॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003967075, "chapter_id": 23967, "verse_number": "३-१-३०-७६", "content_sanskrit": "बिभेद धनुषः कोट्या स्वसेतुं रघुनं दनः ।\nअतो द्विजास्ततस्तीर्थं धनुष्कोटिरितिश्रुतम्॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003967076, "chapter_id": 23967, "verse_number": "३-१-३०-७७", "content_sanskrit": "श्रीरामधनुषः कोट्या यो रेखां पश्यते कृताम् ।\nअनेकक्लेशसंयुक्तं गर्भवासं न पश्यति॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003967077, "chapter_id": 23967, "verse_number": "३-१-३०-७८", "content_sanskrit": "धनुष्कोट्यां कृता रेखा रामेण लवणांबुधौ ।\nतद्दर्शनाद्भवेन्मुक्तिर्न जाने स्नानजं फलम्॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003967078, "chapter_id": 23967, "verse_number": "३-१-३०-७९", "content_sanskrit": "नर्मदारोधसि तपो महापातक नाशनम् ।\nगंगातीरे तु मरणमपवर्गफलप्रदम्॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003967079, "chapter_id": 23967, "verse_number": "३-१-३०-८०", "content_sanskrit": "दानं द्विजाः कुरुक्षेत्रे ब्रह्महत्यादिशोधकम् ।\nतपश्च मरणं दानं धनुष्कोटौ कृतं नरैः॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003967080, "chapter_id": 23967, "verse_number": "३-१-३०-८१", "content_sanskrit": "महापातकनाशाय मुक्त्यै चाभीष्टसिद्धये ।\nभवेत्समर्थं विप्रेंद्रा नात्र कार्या विचारणा॥ ८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003967081, "chapter_id": 23967, "verse_number": "३-१-३०-८२", "content_sanskrit": "तावत्संपीड्यते जंतुः पातकैश्चोपपा तकैः ।\nयावन्नालोक्यते राम धनुष्कोटिर्विमुक्तिदा॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003967082, "chapter_id": 23967, "verse_number": "३-१-३०-८३", "content_sanskrit": "भिद्यते हृदयग्रंथिश्छिद्यंते सर्वसंशयाः ।\nक्षीयंते पापकर्माणि धनुष्कोट्यवलो किनः॥ ८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003967083, "chapter_id": 23967, "verse_number": "३-१-३०-८४", "content_sanskrit": "दक्षिणांभोनिधौ सेतौ रामचन्द्रेण निर्मिता ।\nया रेखा धनुषः कोट्या विभीषणहिताय वै॥ ८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003967084, "chapter_id": 23967, "verse_number": "३-१-३०-८५", "content_sanskrit": "सैव कैलासपदवीं वैकुण्ठब्र ह्मलोकयोः ।\nमार्गः स्वर्गस्य लोकस्य नात्र कार्या विचारणा॥ ८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003967085, "chapter_id": 23967, "verse_number": "३-१-३०-८६", "content_sanskrit": "तुल्यं यज्ञफलैः पुण्यैर्धनुष्कोट्यवगाहनम् ।\nसर्वमंत्राधिकं पुण्यं सर्वदा नफलप्रदम्॥ ८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003967086, "chapter_id": 23967, "verse_number": "३-१-३०-८७", "content_sanskrit": "कायकलेशकरैः पुंसां किं तपोभिः किमध्वरैः ।\nकिं वेदैः किमु वा शास्त्रैर्धनुष्कोट्यवलोकिनः॥ ८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003967087, "chapter_id": 23967, "verse_number": "३-१-३०-८८", "content_sanskrit": "रामचंद्रधनुष्कोटौ स्नानं चेल्लभ्यते नृणाम् ।\nसितासितसरित्पुण्यवारिभिः किं प्रयोजनम्॥ ८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003967088, "chapter_id": 23967, "verse_number": "३-१-३०-८९", "content_sanskrit": "रामचंद्रधनुष्कोटिदर्शनं लभ्यते यदि ।\nकाश्यां तु मरणान्मुक्तिः प्रार्थ्यते किं वृथा नरैः॥ ८९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003967089, "chapter_id": 23967, "verse_number": "३-१-३०-९०", "content_sanskrit": "अनिमज्ज्य धनुष्कोटावनुपोष्य दिनत्रयम् ।\nअदत्त्वा कांचनं गां च दरिद्रः स्यान्न संशयः॥ ९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003967090, "chapter_id": 23967, "verse_number": "३-१-३०-९१", "content_sanskrit": "धनुष्कोट्य वगाहेन यत्फलं लभते नरः ।\nअग्निष्टोमादिभिर्यज्ञैरिष्ट्वापि बहुदक्षिणैः॥ ९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003967091, "chapter_id": 23967, "verse_number": "३-१-३०-९२", "content_sanskrit": "न तत्फलमवाप्नोति सत्यंसत्यं वदाम्यहम् ।\nधनुष्कोट्यभिधं तीर्थं सर्वतीर्थाधिकं विदुः॥ ९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003967092, "chapter_id": 23967, "verse_number": "३-१-३०-९३", "content_sanskrit": "दशकोटिसहस्राणि संति तीर्थानि भूतले ।\nतेषां सान्निध्यमस्त्यत्र धनुष्कोटौ द्विजोत्तमाः॥ ९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003967093, "chapter_id": 23967, "verse_number": "३-१-३०-९४", "content_sanskrit": "अष्टौ वसव आदित्या रुद्राश्च मरुतस्तथा ।\nसाध्याश्च सह गन्धर्वाः सिद्धविद्याधरास्तथा॥ ९४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003967094, "chapter_id": 23967, "verse_number": "३-१-३०-९५", "content_sanskrit": "एते चान्ये च ये देवाः सान्निध्यं कुर्वते सदा ।\nतीर्थेऽत्र धनुषः कोटौ नित्यमेव पितामहः॥ ९५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003967095, "chapter_id": 23967, "verse_number": "३-१-३०-९६", "content_sanskrit": "सन्निधत्ते शिवो विष्णुरुमा मा च सरस्वती ।\nधनुष्कोटौ तपस्तप्त्वा देवाश्च ऋषयस्तथा॥ ९६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003967096, "chapter_id": 23967, "verse_number": "३-१-३०-९७", "content_sanskrit": "विपुलां सिद्धिमगमंस्तत्फलेन मुनीश्वराः ।\nस्नायात्तत्र नरो यस्तु पितृदेवांश्च तर्पयेत्॥ ९७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7003967097, "chapter_id": 23967, "verse_number": "३-१-३०-९८", "content_sanskrit": "सर्वपापविनिर्मुक्तो ब्रह्मलोके महीयते ।\nअत्रैकं भोजयेद्विप्रं यो नरो भक्तिसंयुतः॥ ९८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7003967098, "chapter_id": 23967, "verse_number": "३-१-३०-९९", "content_sanskrit": "इह लोके परत्रापि सोनंतसुखमश्नुते ।\nशाकमूलफले वृत्तिं यो न वर्तयते नरः॥ ९९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7003967099, "chapter_id": 23967, "verse_number": "३-१-३०-१००", "content_sanskrit": "स नरो धनुषःकोटौ स्नायात्त त्फलसिद्धये ।\nअश्वमेधक्रतुं कर्तुं शक्तिर्यस्य न विद्यते॥ १०० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7003967100, "chapter_id": 23967, "verse_number": "३-१-३०-१०१", "content_sanskrit": "धनुष्कोटौ स हि स्नायात्तेन तत्फलमश्नुते ।\nब्राह्मणः क्षत्रियो वैश्यः शूद्रो वापि मुनी श्वराः॥ १०१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7003967101, "chapter_id": 23967, "verse_number": "३-१-३०-१०२", "content_sanskrit": "निंद्ययोनौ न जायंते धनुष्कोट्वगाहनात् ।\nमकरस्थे रवौ माघे धनुष्कोटौ तु यो नरः॥ १०२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7003967102, "chapter_id": 23967, "verse_number": "३-१-३०-१०३", "content_sanskrit": "स्नायात्पुण्यं निगदितुं तस्याहं न क्षमो द्विजाः ।\nमाघमासे धनुष्कोटाववगाहेत यो नरः॥ १०३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7003967103, "chapter_id": 23967, "verse_number": "३-१-३०-१०४", "content_sanskrit": "स स्नातः सर्वतीर्थेषु गंगादिषु मुनीश्वराः ।\nप्राप्नुयादक्षयांल्लोकान्मोक्षं चापि लभेत सः॥ १०४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7003967104, "chapter_id": 23967, "verse_number": "३-१-३०-१०५", "content_sanskrit": "जन्मप्रभृति यत्पापं स्त्रियो वा पुरुषस्य वा ।\nतत्सर्वं माघमासेऽत्र मज्जनाद्विलयं व्रजेत्॥ १०५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7003967105, "chapter_id": 23967, "verse_number": "३-१-३०-१०६", "content_sanskrit": "यथा सुराणां सर्वेषामुत्तमो रघुनंदनः ।\nतथैव च धनुष्कोटिः सर्वतीर्थोत्तमा स्मृता॥ १०६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7003967106, "chapter_id": 23967, "verse_number": "३-१-३०-१०७", "content_sanskrit": "तत्र स्नानं माघमासे सर्वाभीष्टप्रदायकम् ।\nत्रिंशद्दिनं माघमासे नियतोऽपि जितेंद्रियः॥ १०७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7003967107, "chapter_id": 23967, "verse_number": "३-१-३०-१०८", "content_sanskrit": "धनुष्कोटौ नरः स्नायादपुनर्भवसिद्धये ।\nएकभुक्तो जितक्रोधो माघमासेऽत्र यो नरः॥ १०८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7003967108, "chapter_id": 23967, "verse_number": "३-१-३०-१०९", "content_sanskrit": "स्नानं करोति विप्रेंद्रा मुच्यते ब्रह्महत्यया ।\nश्रीरामधनुषः कोटी माघमासे नरस्तु यः॥ १०९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7003967109, "chapter_id": 23967, "verse_number": "३-१-३०-११०", "content_sanskrit": "स्नात्वांते शिवरात्रौ च निराहारो जितेंद्रियः ।\nकृत्वा जागरणं रात्रौ प्रतियामं विशेषतः॥ ११० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7003967110, "chapter_id": 23967, "verse_number": "३-१-३०-१११", "content_sanskrit": "राम नाथं महादेवमभ्यर्च्य विधिपूर्वकम् ।\nपरेद्युरुदिते सूर्ये धनुष्कोटौ निमज्य च॥ १११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7003967111, "chapter_id": 23967, "verse_number": "३-१-३०-११२", "content_sanskrit": "अन्येष्वपि च तीर्थेषु स्नात्वा नियतमानसः ।\nनिर्वर्त्य नित्यकर्माणि रामनाथं निषेव्य च॥ ११२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7003967112, "chapter_id": 23967, "verse_number": "३-१-३०-११३", "content_sanskrit": "यथाशक्ति द्विजानन्नैर्भोजयित्वा द्विजोत्तमाः ।\nभूमिं गां च तिलान्धान्यं दत्त्वा वित्तं च शक्तितः॥ ११३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7003967113, "chapter_id": 23967, "verse_number": "३-१-३०-११४", "content_sanskrit": "ब्राह्मणैरप्यनुज्ञातः स्वयं भुंजति वाग्यतः ।\nएवं कृतवतः पुंसो रामनाथो महेश्वरः॥ ११४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7003967114, "chapter_id": 23967, "verse_number": "३-१-३०-११५", "content_sanskrit": "विमोच्य सर्वपापानि भुक्तिं मुक्तिं प्रयच्छति ।\nअतः सर्वप्रयत्नेन माघमासे मुनीश्वराः॥ ११५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7003967115, "chapter_id": 23967, "verse_number": "३-१-३०-११६", "content_sanskrit": "स्नातव्यं हि धनुष्कोटौ नरैरत्र मुमुक्षुभिः ।\nधनुष्कोटौ नरः स्नानं सेतावर्धोदये तु यः॥ ११६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7003967116, "chapter_id": 23967, "verse_number": "३-१-३०-११७", "content_sanskrit": "करोति तस्य पापानि नश्यंत्येव क्षणाद्द्विजाः ।\nस्नानं महोदये चात्र भुक्तिमुक्तिफलप्रदम्॥ ११७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7003967117, "chapter_id": 23967, "verse_number": "३-१-३०-११८", "content_sanskrit": "यः स्नायाद्धनुषः कोटावर्द्धोदयमहो दये ।\nतस्य वश्यास्त्रयो देवा ब्रह्मविष्णुमहेश्वराः॥ ११८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7003967118, "chapter_id": 23967, "verse_number": "३-१-३०-११९", "content_sanskrit": "धनुष्कोटौ द्विजाः स्नानमर्द्धोदयमहोदये ।\nविनाप्यद्वैतविज्ञानं सायुज्यप्राप्तिकारणम्॥ ११९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7003967119, "chapter_id": 23967, "verse_number": "३-१-३०-१२०", "content_sanskrit": "तत्र स्नानं द्विजाः पुंसामर्द्धोदयमहोदये ।\nमन्वाद्युक्तं विना सत्यं प्रायश्चित्तं हि पापिनाम्॥ १२० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7003967120, "chapter_id": 23967, "verse_number": "३-१-३०-१२१", "content_sanskrit": "अत्र सेतौ धनुष्कोटावर्धोदयमहो दये ।\nस्नाति चेन्मनुजो विप्राः सत्यं यज्ञं विनाप्ययम्॥ १२१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7003967121, "chapter_id": 23967, "verse_number": "३-१-३०-१२२", "content_sanskrit": "यज्ञानां फलमाप्नोति संपूर्णं नात्र संशयः ।\nचंद्रसूर्योपरागेषु यः स्नायादत्र मानवः॥ १२२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7003967122, "chapter_id": 23967, "verse_number": "३-१-३०-१२३", "content_sanskrit": "तस्य पुण्यफलं वक्तुं शेषेणापि न शक्यते ।\nचंद्रसूर्योपरागेषु धनुष्कोट्यवगाहनम्॥ १२३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7003967123, "chapter_id": 23967, "verse_number": "३-१-३०-१२४", "content_sanskrit": "ब्रह्महत्यादिपापानां प्रायश्चित्त मुदीरितम् ।\nश्रीरामधनुषः कोटौ चंद्रसूर्योपरागयोः॥ १२४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7003967124, "chapter_id": 23967, "verse_number": "३-१-३०-१२५", "content_sanskrit": "स्नानं सायुज्यदं प्रोक्तं सर्वतीर्थफलप्रदम् ।\nचंद्रसूर्योपरागेषु अर्धोदयमहोदये॥ ॥ १२५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7003967125, "chapter_id": 23967, "verse_number": "३-१-३०-१२६", "content_sanskrit": "स्नातव्यमत्र मनुजैर्भुक्तिमुक्तिफलेच्छुभिः ।\nअतः सर्वं परित्यज्य गच्छध्वं मुनिपुंगवाः॥ १२६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7003967126, "chapter_id": 23967, "verse_number": "३-१-३०-१२७", "content_sanskrit": "धनुष्कोटिं महापुण्यां भुक्तिमुक्तिफल प्रदाम् ।\nतत्र गत्वा पितृभ्यश्च कुरुध्वं पिंडदापनम्॥ १२७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7003967127, "chapter_id": 23967, "verse_number": "३-१-३०-१२८", "content_sanskrit": "आकल्पं पितृतृप्तिः स्यादत्र पिंडनिवापनात् ।\nपितॄणां तृप्तिदं स्थानत्रयं रामेण निर्मितम्॥ १२८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7003967128, "chapter_id": 23967, "verse_number": "३-१-३०-१२९", "content_sanskrit": "सेतुमूले धनुष्कोट्यां गंधमादनपर्वते ।\nपिंडं दत्त्वा पितृभ्योऽत्र ऋणान्मुक्तो भविष्यति॥ १२९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7003967129, "chapter_id": 23967, "verse_number": "३-१-३०-१३०", "content_sanskrit": "सेतुमूलं धनुष्कोटिं गंधमादनमेव च ।\nऋणमोक्ष इति ख्यातं त्रिस्थानं देवनिर्मितम्॥ १३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7003967130, "chapter_id": 23967, "verse_number": "३-१-३०-१३१", "content_sanskrit": "अतः सर्वप्रयत्नेन धनुष्कोटिर्निषेव्यताम् ।\nअत्रागत्य धनुष्कोटौ स्नात्वा नियमपूर्व कम्॥ १३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7003967131, "chapter_id": 23967, "verse_number": "३-१-३०-१३२", "content_sanskrit": "द्रोणाचार्यसुतः श्रीमानश्वत्थामा मुनीश्वराः ।\nसुप्तमारणदोषेण घोरेण मुमुचे क्षणात्॥ १३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7003967132, "chapter_id": 23967, "verse_number": "३-१-३०-१३३", "content_sanskrit": "एवं वः कथितं विप्रा धनुष्कोटेस्तु वैभवम् ।\nभुक्तिमुक्तिप्रदं नृणां सर्वपापनिबर्हणम्॥ १३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}]