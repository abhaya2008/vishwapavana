[{"id": 7001124000, "chapter_id": 21124, "verse_number": "२-२-१५-१", "content_sanskrit": "ब्रह्मोवाच ।\nअथैकदा पितुः पार्श्वे तिष्ठंतीं तां सतीमहम् ।\nत्वया सह मुनेद्राक्षं सारभूतां त्रिलोकके॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001124001, "chapter_id": 21124, "verse_number": "२-२-१५-२", "content_sanskrit": "पित्रा नमस्कृतं वीक्ष्य सत्कृतं त्वां च मां सती ।\nप्रणनाम मुदा भक्त्या लोकलीलानुसारिणी॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001124002, "chapter_id": 21124, "verse_number": "२-२-१५-३", "content_sanskrit": "प्रणामांते सतीं वीक्ष्य दक्षदत्तशुभासने ।\nस्थितोहं नारद त्वं च विनतामहमागदम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001124003, "chapter_id": 21124, "verse_number": "२-२-१५-४", "content_sanskrit": "त्वामेव यः कामयते यन्तु कामयसे सति ।\nतमाप्नुहि पतिं देवं सर्वज्ञं जगदीश्वरम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001124004, "chapter_id": 21124, "verse_number": "२-२-१५-५", "content_sanskrit": "यो नान्यां जगृहे नापि गृह्णाति न ग्रहीष्यति ।\nजायां स ते पतिर्भूयादनन्यसदृशश्शुभे॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001124005, "chapter_id": 21124, "verse_number": "२-२-१५-६", "content_sanskrit": "इत्युक्त्वा सुचिरं तां वै स्थित्वा दक्षालये पुनः ।\nविसृष्टौ तेन संयातौ स्वस्थानं तौ च नारद॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001124006, "chapter_id": 21124, "verse_number": "२-२-१५-७", "content_sanskrit": "दक्षोभवच्च सुप्रीतः तदाकर्ण्य गतज्वरः ।\nआददे तनयां स्वां तां मत्वा हि परमेश्वरीम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001124007, "chapter_id": 21124, "verse_number": "२-२-१५-८", "content_sanskrit": "इत्थं विहारै रुचिरैः कौमारैर्भक्तवत्सला ।\nजहाववस्थां कौमारीं स्वेच्छाधृतनराकृतिः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001124008, "chapter_id": 21124, "verse_number": "२-२-१५-९", "content_sanskrit": "बाल्यं व्यतीत्य सा प्राप किञ्चिद्यौवनतां सती॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001124009, "chapter_id": 21124, "verse_number": "२-२-१५-१०", "content_sanskrit": "अतीव तपसांगेन सर्वांगेषु मनोहरा॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001124010, "chapter_id": 21124, "verse_number": "२-२-१५-११", "content_sanskrit": "दक्षस्तां वीक्ष्य लोकेशः प्रोद्भिन्नांतर्वयस्थिताम् ।\nचिंतयामास भर्गाय कथं दास्य इमां सुताम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001124011, "chapter_id": 21124, "verse_number": "२-२-१५-१२", "content_sanskrit": "अथ सापि स्वयं भर्गं प्राप्तुमैच्छत्तदान्वहम् ।\nपितुर्मनोगतिं ज्ञात्वा मातुर्निकटमागमत्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001124012, "chapter_id": 21124, "verse_number": "२-२-१५-१३", "content_sanskrit": "पप्रच्छाज्ञां तपोहेतोश्शंकरस्य विनीतधीः ।\nमातुश्शिवाथ वैरिण्यास्सा सखी परमेश्वरी॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001124013, "chapter_id": 21124, "verse_number": "२-२-१५-१४", "content_sanskrit": "ततस्सती महेशानं पतिं प्राप्तुं दृढव्रता ।\nसा तमाराधयामास गृहे मातुरनुज्ञया॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001124014, "chapter_id": 21124, "verse_number": "२-२-१५-१५", "content_sanskrit": "आश्विने मासि नन्दायां तिथावानर्च भक्तितः ।\nगुडौदनैस्सलवणैर्हरं नत्वा निनाय तम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001124015, "chapter_id": 21124, "verse_number": "२-२-१५-१६", "content_sanskrit": "कार्तिकस्य चतुर्दश्यामपूपैः पायसैरपि ।\nसमाकीर्णैस्समाराध्य सस्मार परमेश्वरम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001124016, "chapter_id": 21124, "verse_number": "२-२-१५-१७", "content_sanskrit": "मार्गशीर्षेऽसिताष्टम्यां सतिलैस्सयवौदनैः ।\nपूजयित्वा हरं कीलैर्निनाय दिवसान् सती॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001124017, "chapter_id": 21124, "verse_number": "२-२-१५-१८", "content_sanskrit": "पौषे तु शुक्लसप्तम्यां कृत्वा जागरणं निशि ।\nअपूजयच्छिवं प्रातः कृशरान्नेन सा सती॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001124018, "chapter_id": 21124, "verse_number": "२-२-१५-१९", "content_sanskrit": "माघे तु पौर्णमास्यां स कृत्वा जागरणं निशि ।\nआर्द्रवस्त्रा नदीतीरेऽकरोच्छंकरपूजनम्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001124019, "chapter_id": 21124, "verse_number": "२-२-१५-२०", "content_sanskrit": "तपस्यसितभूतायां कृत्वा जागरणं निशि॥  ।\nविशेषतस्समानर्च शैलूषैस्सर्वयामसु॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001124020, "chapter_id": 21124, "verse_number": "२-२-१५-२१", "content_sanskrit": "चैत्रे शुक्लचतुर्दश्यां पलाशैर्दमनैश्शिवम् ।\nअपूजयद्दिवारात्रौ संस्मरन् सा निनाय तम्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001124021, "chapter_id": 21124, "verse_number": "२-२-१५-२२", "content_sanskrit": "राधशुक्लतृतीयायां तिलाहारयवौदनैः ।\nपूजयित्वा सती रुद्रं नव्यैर्मासं निनाय तम्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001124022, "chapter_id": 21124, "verse_number": "२-२-१५-२३", "content_sanskrit": "ज्येष्ठस्य पूर्णिमायां वै रात्रै संपूज्य शंकरम् ।\nवसनैर्बृहतीपुष्पैर्निराहारा निनाय तम्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001124023, "chapter_id": 21124, "verse_number": "२-२-१५-२४", "content_sanskrit": "आषाढस्य चतुर्दश्यां शुक्लायां कृष्णवाससा ।\nबृहतीकुसुमैः पूजा रुद्रस्याकारि वै तया॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001124024, "chapter_id": 21124, "verse_number": "२-२-१५-२५", "content_sanskrit": "श्रावणस्य सिताष्टम्यां चतुर्दश्यां च सा शिवम् ।\nयज्ञोपवीतैर्वासोभिः पवित्रैरप्यपूजयत्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001124025, "chapter_id": 21124, "verse_number": "२-२-१५-२६", "content_sanskrit": "भाद्रे कृष्णत्रयोदश्यां पुष्पैर्नानाविधैः फलैः ।\nसंपूज्य च चतुर्दश्यां चकार जलभो जनम्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001124026, "chapter_id": 21124, "verse_number": "२-२-१५-२७", "content_sanskrit": "नानाविधैः फलैः पुष्पैस्सस्यैस्तत्कालसंभवैः ।\nचक्रे सुनियताहारा जपन्मासे शिवार्चनम्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001124027, "chapter_id": 21124, "verse_number": "२-२-१५-२८", "content_sanskrit": "सर्वमासे सर्वदिने शिवार्चनरता सती ।\nदृढव्रताभवद्देवी स्वेच्छाधृतनराकृतिः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001124028, "chapter_id": 21124, "verse_number": "२-२-१५-२९", "content_sanskrit": "इत्थं नंदाव्रतं कृत्स्नं समाप्य सुसमाहिता ।\nदध्यौ शिवं सती प्रेम्णा निश्चलाभूदनन्यधीः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001124029, "chapter_id": 21124, "verse_number": "२-२-१५-३०", "content_sanskrit": "एतस्मिन्नंतरे देवा मुनयश्चाखिला मुने ।\nविष्णुं मां च पुरस्कृत्य ययुर्द्रष्टुं सतीतपः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001124030, "chapter_id": 21124, "verse_number": "२-२-१५-३१", "content_sanskrit": "दृष्टागत्य सती देवैर्मूर्ता सिद्धिरिवापरा ।\nशिवध्यानमहामग्ना सिद्धावस्थां गता तदा॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001124031, "chapter_id": 21124, "verse_number": "२-२-१५-३२", "content_sanskrit": "चक्रुः सर्वे सुरास्सत्ये मुदा सांजलयो नतिम् ।\nमुनयश्च नतस्कंधा विष्ण्वाद्याः प्रीतमानसाः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001124032, "chapter_id": 21124, "verse_number": "२-२-१५-३३", "content_sanskrit": "अथ सर्वे सुप्रसन्ना विष्ण्वाद्याश्च सुरर्षयः ।\nप्रशशंसुस्तपस्तस्यास्सत्यास्तस्मात्सविस्मयाः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001124033, "chapter_id": 21124, "verse_number": "२-२-१५-३४", "content_sanskrit": "ततः प्रणम्य तां देवीं पुनस्ते मुनयस्सुराः ।\nजग्मुर्गिरिवरं सद्यः कैलासं शिववल्लभम्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001124034, "chapter_id": 21124, "verse_number": "२-२-१५-३५", "content_sanskrit": "सावित्रीसहितश्चाहं सह लक्ष्म्या मुदान्वितः ।\nवासुदेवोपि भगवाञ्जगामाथ हरांतिकम्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001124035, "chapter_id": 21124, "verse_number": "२-२-१५-३६", "content_sanskrit": "गत्वा तत्र प्रभुं दृष्ट्वा सुप्रणम्य सुसंभ्रमाः ।\nतुष्टुवुर्विविधैः स्तोत्रैः करौ बद्ध्वा विनम्रकाः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001124036, "chapter_id": 21124, "verse_number": "२-२-१५-३७", "content_sanskrit": "देवा ऊचुः ।\nनमो भगवते तुभ्यं यत एतच्चराचरम् ।\nपुरुषाय महेशाय परेशाय महात्मने॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001124037, "chapter_id": 21124, "verse_number": "२-२-१५-३८", "content_sanskrit": "आदिबीजाय सर्वेषां चिद्रूपाय पराय च ।\nब्रह्मणे निर्विकाराय प्रकृतेः पुरुषस्य च॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001124038, "chapter_id": 21124, "verse_number": "२-२-१५-३९", "content_sanskrit": "य इदं प्रतिपंच्येदं येनेदं विचकास्ति हि ।\nयस्मादिदं यतश्चेदं यस्येदं त्वं च यत्नतः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001124039, "chapter_id": 21124, "verse_number": "२-२-१५-४०", "content_sanskrit": "योस्मात्परस्माच्च परो निर्विकारी महाप्रभुः ।\nईक्षते यस्स्वात्मनीदं तं नताः स्म स्वयंभुवम्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001124040, "chapter_id": 21124, "verse_number": "२-२-१५-४१", "content_sanskrit": "अविद्धदृक् परः साक्षी सर्वात्मा ऽनेकरूपधृक् ।\nआत्मभूतः परब्रह्म तपंतं शरणं गताः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001124041, "chapter_id": 21124, "verse_number": "२-२-१५-४२", "content_sanskrit": "न यस्य देवा ऋषयः सिद्धाश्च न विदुः पदम् ।\nकः पुनर्जंतुरपरो ज्ञातुमर्हति वेदितुम्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001124042, "chapter_id": 21124, "verse_number": "२-२-१५-४३", "content_sanskrit": "दिदृक्षवो यस्य पदं मुक्तसंगास्सुसाधवः ।\nचरितं सुगतिर्नस्त्वं सलोकव्रतमव्रणम्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001124043, "chapter_id": 21124, "verse_number": "२-२-१५-४४", "content_sanskrit": "त्वज्जन्मादिविकारा नो विद्यंते केपि दुःखदा ।\nतथापि मायया त्वं हि गृह्णासि कृपया च तान्॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001124044, "chapter_id": 21124, "verse_number": "२-२-१५-४५", "content_sanskrit": "तस्मै नमः परेशाय तुभ्यमाश्चर्यकर्मणे ।\nनमो गिरां विदूराय ब्रह्मणे परमात्मने॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001124045, "chapter_id": 21124, "verse_number": "२-२-१५-४६", "content_sanskrit": "अरूपायोरुरूपाय परायानंतशक्तये ।\nत्रिलोकपतये सर्वसाक्षिणे सर्वगाय च॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001124046, "chapter_id": 21124, "verse_number": "२-२-१५-४७", "content_sanskrit": "नम आत्मप्रदीपाय निर्वाणसुखसंपदे ।\nज्ञानात्मने नमस्तेऽस्तु व्यापकायेश्वराय च॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001124047, "chapter_id": 21124, "verse_number": "२-२-१५-४८", "content_sanskrit": "नैष्कर्म्येण सुलभ्याय कैवल्यपतये नमः ।\nपुरुषाय परेशाय नमस्ते सर्वदाय च॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001124048, "chapter_id": 21124, "verse_number": "२-२-१५-४९", "content_sanskrit": "क्षेत्रज्ञायात्मरूपाय सर्वप्रत्ययहेतवे॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001124049, "chapter_id": 21124, "verse_number": "२-२-१५-५०", "content_sanskrit": "सर्वाध्यक्षाय महते मूलप्रकृतये नमः ।\nपुरुषाय परेशाय नमस्ते सर्वदाय च॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001124050, "chapter_id": 21124, "verse_number": "२-२-१५-५१", "content_sanskrit": "त्रिनेत्रायेषुवक्त्राय सदाभासाय ते नमः ।\nसर्वेन्द्रियगुणद्रष्ट्रे निष्कारण नमोस्तु ते॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001124051, "chapter_id": 21124, "verse_number": "२-२-१५-५२", "content_sanskrit": "त्रिलोककारणायाथापवर्गाय नमोनमः ।\nअपवर्गप्रदायाशु शरणागततारिणे॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001124052, "chapter_id": 21124, "verse_number": "२-२-१५-५३", "content_sanskrit": "सर्वाम्नायागमानां चोदधये परमेष्ठिने ।\nपरायणाय भक्तानां गुणानां च नमोस्तु ते॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001124053, "chapter_id": 21124, "verse_number": "२-२-१५-५४", "content_sanskrit": "नमो गुणारणिच्छन्न चिदूष्माय महेश्वर ।\nमूढदुष्प्राप्तरूपाय ज्ञानिहृद्वासिने सदा॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001124054, "chapter_id": 21124, "verse_number": "२-२-१५-५५", "content_sanskrit": "पशुपाशविमोक्षाय भक्तसन्मुक्तिदाय च ।\nस्वप्रकाशाय नित्यायाऽव्ययायाजस्रसंविदे॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001124055, "chapter_id": 21124, "verse_number": "२-२-१५-५६", "content_sanskrit": "प्रत्यग्द्रष्ट्रैऽविकाराय परमैश्वर्य धारिणे ।\nयं भजन्ति चतुर्वर्गे कामयंतीष्टसद्गतिम् ।\nसोऽभूदकरुणस्त्वं नः प्रसन्नो भव ते नमः॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001124056, "chapter_id": 21124, "verse_number": "२-२-१५-५७", "content_sanskrit": "एकांतिनः कंचनार्थं भक्ता वांछंति यस्य न ।\nकेवलं चरितं ते ते गायंति परमंगलम्॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001124057, "chapter_id": 21124, "verse_number": "२-२-१५-५८", "content_sanskrit": "अक्षरं परमं ब्रह्मतमव्यक्ताकृतिं विभुम् ।\nअध्यात्मयोगगम्यं त्वां परिपूर्णं स्तुमो वयम्॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001124058, "chapter_id": 21124, "verse_number": "२-२-१५-५९", "content_sanskrit": "अतींद्रियमनाधारं सर्वाधारमहेतुकम् ।\nअनंतमाद्यं सूक्ष्मं त्वां प्रणमामोऽखिलेश्वरम्॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001124059, "chapter_id": 21124, "verse_number": "२-२-१५-६०", "content_sanskrit": "हर्यादयोऽखिला देवास्तथा लोकाश्चराचराः ।\nनामरूपविभेदेन फल्ग्व्या च कलया कृताः॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001124060, "chapter_id": 21124, "verse_number": "२-२-१५-६१", "content_sanskrit": "यथार्चिषोग्नेस्सवितुर्यांति निर्यांति वासकृत् ।\nगभस्तयस्तथायं वै प्रवाहो गौण उच्यते॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001124061, "chapter_id": 21124, "verse_number": "२-२-१५-६२", "content_sanskrit": "न त्वं देवो ऽसुरो मर्त्यो न तिर्यङ् न द्विजः प्रभो ।\nन स्त्री न षंढो न पुमान्सदसन्न च किंचन॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001124062, "chapter_id": 21124, "verse_number": "२-२-१५-६३", "content_sanskrit": "निषेधशेषस्सर्वं त्वं विश्वकृद्विश्व पालकः ।\nविश्वलयकृद्विश्वात्मा प्रणतास्स्मस्तमीश्वरम्॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001124063, "chapter_id": 21124, "verse_number": "२-२-१५-६४", "content_sanskrit": "योगरंधितकर्माणो यं प्रपश्यन्ति योगिनः ।\nयोगसंभाविते चित्ते योगेशं त्वां नता वयम्॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001124064, "chapter_id": 21124, "verse_number": "२-२-१५-६५", "content_sanskrit": "नमोस्तु तेऽसह्यवेग शक्तित्रय त्रयीमय ।\nनमः प्रसन्नपालाय नमस्ते भूरिशक्तये॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001124065, "chapter_id": 21124, "verse_number": "२-२-१५-६६", "content_sanskrit": "कदिंद्रियाणां दुर्गेशानवाप्य परवर्त्मने ।\nभक्तोद्धाररतायाथ नमस्ते गूढवर्चसे॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001124066, "chapter_id": 21124, "verse_number": "२-२-१५-६७", "content_sanskrit": "यच्छक्त्याहं धियात्मानं हंत वेद न मूढधी ।\nतं दुरत्ययमाहात्म्यं त्वां नतः स्मो महाप्रभुम्॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001124067, "chapter_id": 21124, "verse_number": "२-२-१५-६८", "content_sanskrit": "ब्रह्मोवाच ।\nइति स्तुत्वा महादेवं सर्वे विष्ण्वादिकास्सुराः ।\nतूष्णीमासन्प्रभोरग्रे सद्भक्तिनतकंधराः॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}]