[{"id": 50022579, "chapter_id": 11708, "verse_number": "1", "content_sanskrit": "शौनक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50022580, "chapter_id": 11708, "verse_number": "2", "content_sanskrit": "शुको यदाह भगवान् विष्णुराताय स्यन्दने। सौरे गणो मासिमासि नाना वसति सप्तकः॥ १२/११/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50022581, "chapter_id": 11708, "verse_number": "3", "content_sanskrit": "तेषां नामानि कर्माणि नियुक्तानामधीश्वरैः। ब्रूहि नः श्रद्धधानानां व्यूहं सूर्यात्मनो हरेः॥ १२/११/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50022582, "chapter_id": 11708, "verse_number": "4", "content_sanskrit": "सूत उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50022583, "chapter_id": 11708, "verse_number": "5", "content_sanskrit": "आनाद्यविद्यया विष्णोरात्मनः सर्वदेहिनाम्। निर्मितो लोकतन्त्रोऽयं लोकेषु परिवर्तते॥ १२/११/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50022584, "chapter_id": 11708, "verse_number": "6", "content_sanskrit": "एक एव हि लोकानां सूर्य आत्माऽऽदिकृद् हरिः। सर्ववेदक्रियामूलमृषिभिर्बहुधोदितः॥ १२/११/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50022585, "chapter_id": 11708, "verse_number": "7", "content_sanskrit": "कालो देशः क्रिया कर्ता करणं कार्यमागमः। द्रव्यं फलमिति ब्रह्मन् नवधोक्तोऽजया हरिः॥ १२/११/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50022586, "chapter_id": 11708, "verse_number": "8", "content_sanskrit": "मध्वादिषु द्वादशसु भगवान् कालरूपधृक्। लोकतन्त्राय चरति पृथग् द्वादशभिर्गुणैः॥ १२/११/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50022587, "chapter_id": 11708, "verse_number": "9", "content_sanskrit": "धाता कृतस्थली हेतिर्वासुका रथकृन्मुने। पुलस्त्यस्तुम्बुरुरिति मधुमासं नयन्त्यमी॥ १२/११/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50022588, "chapter_id": 11708, "verse_number": "10", "content_sanskrit": "अर्यमा पुलहाऽथौजाः प्रहेतिः पुञ्जकस्थली। नारदः कच्छनीरश्च नयन्त्येते स्म माधवम्॥ १२/११/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50022589, "chapter_id": 11708, "verse_number": "11", "content_sanskrit": "मित्रोऽत्रिः पौरुषेयोऽथ तक्षको मेनका हहा। रथस्वन इति ह्येते शुक्रमासं नयन्त्यमी॥ १२/११/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50022590, "chapter_id": 11708, "verse_number": "12", "content_sanskrit": "वसिष्ठो वरुणो रम्भा सहजन्यस्तथा हुहू। शुक्रश्चित्रस्वनश्चैव शुचिमासं नयन्त्यमी॥ १२/११/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50022591, "chapter_id": 11708, "verse_number": "13", "content_sanskrit": "इन्द्रो विश्वावसुः स्रोता एलापत्रस्तथाङ्गिराः। प्रम्लोचा राक्षसः स्वर्यो नभोमासं नयन्त्यमी॥ १२/११/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50022592, "chapter_id": 11708, "verse_number": "14", "content_sanskrit": "विवस्वानुग्रसेनश्च व्याघ्र आसारणो भृगुः। अनुम्लोचा शङ्घपालो नभस्याख्यं नयन्त्यमी॥ १२/११/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50022593, "chapter_id": 11708, "verse_number": "15", "content_sanskrit": "पूषा धनञ्जयो वातः सुषेणः सुरुचिस्तथा। घृताची गौतमश्चेति तपोमासं नयन्त्यमी॥ १२/११/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50022594, "chapter_id": 11708, "verse_number": "16", "content_sanskrit": "ऋतुर्वर्चा भरद्वाजः पर्जन्यः सेनजित् तथा। विश्व ऐरावतश्चैव तपस्याख्यं नयन्त्यमी॥ १२/११/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50022595, "chapter_id": 11708, "verse_number": "17", "content_sanskrit": "अथांशुः कश्यपस्ताक्र्ष्यो धृतसेनस्तथोर्वशी। विद्युच्छङ्कुर्महाशङ्खः सहोमासं नयन्त्यमी॥ १२/११/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50022596, "chapter_id": 11708, "verse_number": "18", "content_sanskrit": "भगः स्फूर्जोऽरिष्टनेमिरूर्ण आयुश्व पञ्चमः। कर्कोटकः पूर्वचित्तिः सहस्याख्यं नयन्त्यमी॥ १२/११/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50022597, "chapter_id": 11708, "verse_number": "19", "content_sanskrit": "त्वष्टा ऋचीकतनयः कम्बळश्च तिलोत्तमा। ब्रह्मरातोऽथ शतजिद् धृतराष्ट्र इषम्भराः॥ १२/११/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50022598, "chapter_id": 11708, "verse_number": "20", "content_sanskrit": "विष्णुरश्वतरो रम्भा सूर्यवर्चोऽश्वसत्यकौ। विश्वामित्रमुखा एत ऊर्जमासं नयन्त्यमी॥ १२/११/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50022599, "chapter_id": 11708, "verse_number": "21", "content_sanskrit": "एता विप्र समाख्याता आदित्यस्य विभूतयः। स्मरतां सन्ध्ययोर्नॄणां हरत्यंहो दिनेदिने॥ १२/११/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50022600, "chapter_id": 11708, "verse_number": "22", "content_sanskrit": "द्वादशस्वपि मासेषु देवोऽसौ षड्भिरस्य वै। चरन् समन्तात् तनुते परत्रेह च सन्मतिम्॥ १२/११/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50022601, "chapter_id": 11708, "verse_number": "23", "content_sanskrit": "सामर्ग्यजुभिस्तल्लिङ्गैऋर्षयः संस्तुवन्त्यमुम्। गन्धर्वास्तं प्रगायन्ति नृत्यन्त्यप्सरसोऽग्रतः॥ १२/११/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50022602, "chapter_id": 11708, "verse_number": "24", "content_sanskrit": "उन्नह्यन्ति रथं नागा ग्रामण्यो रथयोजकाः। चोदयन्ति रथं पृष्ठे नैऋर्ता बलशालिनः॥ १२/११/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50022603, "chapter_id": 11708, "verse_number": "25", "content_sanskrit": "बालखिल्याः सहस्राणि षष्टिर्ब्रह्मर्षयोऽमलाः। पुरतोऽभिमुखं यान्ति स्तुवन्तः स्तुतिभिर्विभुम्॥ १२/११/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 50022604, "chapter_id": 11708, "verse_number": "26", "content_sanskrit": "एवं ह्यनादिनिधनो भगवान् हरिरीश्वरः। कल्पेकल्पे स्वमात्मानं व्यूह्य लोकान् तपत्यजः॥ १२/११/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 50022605, "chapter_id": 11708, "verse_number": "27", "content_sanskrit": "इति श्रीमद्भागवते द्वादशस्कन्धे एकादशोऽध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]