[{"id": 7006336000, "chapter_id": 26336, "verse_number": "१-४६-१", "content_sanskrit": "वैशम्पायन उवाच एवमस्त्विति संहृष्टः शक्रस्त्रिदशवर्द्धनः ।\nसंदिदेशाग्रतः सोमं युद्धाय शिशिरायुधम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006336001, "chapter_id": 26336, "verse_number": "१-४६-२", "content_sanskrit": "शक्र उवाच गच्छ सोम सहायत्वं कुरु पाशधरस्य वै ।\nअसुराणां विनाशाय जयाय च दिवौकसाम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006336002, "chapter_id": 26336, "verse_number": "१-४६-३", "content_sanskrit": "त्वमप्रतिमवीर्यश्च ज्योतिषां चेश्वरेश्वरः ।\nत्वन्मयं सर्वलोकानां रसं रसविदो विदुः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006336003, "chapter_id": 26336, "verse_number": "१-४६-४", "content_sanskrit": "क्षयवृद्धी तवाव्यक्ते सागरस्येव मण्डले ।\nपरिवर्तस्यहोरात्रं कालं जगति योजयन्॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006336004, "chapter_id": 26336, "verse_number": "१-४६-५", "content_sanskrit": "लोकच्छायामयं लक्ष्म तवाङ्के शशसंज्ञितम् ।\nन विदुः सोम देवाऽपि ये च नक्षत्रयोगिनः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006336005, "chapter_id": 26336, "verse_number": "१-४६-६", "content_sanskrit": "त्वमादित्यपथादूर्ध्वं ज्योतिषां चोपरि स्थितः ।\nतमश्चोत्सार्य वपुषा भासयस्यखिलं जगत्॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006336006, "chapter_id": 26336, "verse_number": "१-४६-७", "content_sanskrit": "श्वेतभानुर्हिमतनुर्ज्योतिषामधिपः शशी ।\nअब्दकृत्कालयोगात्मा ईज्यो यज्ञ्ररसोऽव्ययः ॥७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006336007, "chapter_id": 26336, "verse_number": "१-४६-८", "content_sanskrit": "ओषधीशः क्रियायोनिरम्भोयोनिरनुष्णभाक् ।\nशीतांशुरमृताधारश्चपलः श्वेतवाहनः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006336008, "chapter_id": 26336, "verse_number": "१-४६-९", "content_sanskrit": "त्वं कान्तिः कान्तवपुषां त्वं सोमः सोमवृत्तिनाम्।\nसौम्यस्त्वं सर्वभूतानां तिमिरघ्नस्त्वमृक्षराट् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006336009, "chapter_id": 26336, "verse_number": "१-४६-१०", "content_sanskrit": "तद् गच्छ त्वं सहानेन वरुणेन वरूथिना ।\nशमयस्वासुरीं मायां यया दह्याम संगरे ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006336010, "chapter_id": 26336, "verse_number": "१-४६-११", "content_sanskrit": "सोम उवाच यन्मां वदसि युद्धार्थे देवराज जगत्पते ।\nएष वर्षामि शिशिरं दैत्यमायापकर्षणम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006336011, "chapter_id": 26336, "verse_number": "१-४६-१२", "content_sanskrit": "एतान्मच्छीतनिर्दग्धान्पश्य त्वं हिमवेष्टितान्।\nविमायान् विमदांश्चैव दानवांस्त्वं महामृधे ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006336012, "chapter_id": 26336, "verse_number": "१-४६-१३", "content_sanskrit": "वैशम्पायन उवाच ततो हिमकरोत्सृष्टाः सबाष्पा हिमवृष्टयः ।\nवेष्टयन्ति स्म तान्घोरान्दैत्यान् मेघगणा इव ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006336013, "chapter_id": 26336, "verse_number": "१-४६-१४", "content_sanskrit": "तौ पाशशुक्लांशुधरौ वरुणेन्दू महारणे।\nजघ्नतुर्हिमपातैश्च पाशघातैश्च दानवान् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006336014, "chapter_id": 26336, "verse_number": "१-४६-१५", "content_sanskrit": "द्वावम्बुनाथौ समरे तौ पाशहिमयोधिनौ ।\nमृधे चेरतुरम्भोभिः क्षुब्धाविव महार्णवौ ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006336015, "chapter_id": 26336, "verse_number": "१-४६-१६", "content_sanskrit": "ताभ्यामाप्लावितं सैन्यं तद् दानवमदृश्यत ।\nजगत् संवर्तकाम्भोदैः प्रवृष्टैरिव संवृतम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006336016, "chapter_id": 26336, "verse_number": "१-४६-१७", "content_sanskrit": "तावुद्यतांशुपाशौ द्वौ शशाङ्कवरुणौ रणे ।\nशमयामासतुर्मायां देवौ दैतेयनिर्मिताम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006336017, "chapter_id": 26336, "verse_number": "१-४६-१८", "content_sanskrit": "शीतांशुजयनिर्दग्धाः पाशैश्च प्रसिता रणे ।\nन शेकुश्चलितुं दैत्या विशिरस्का इवाद्रयः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006336018, "chapter_id": 26336, "verse_number": "१-४६-१९", "content_sanskrit": "शीतांशुनिहतास्ते तु पेतुर्दैत्या हिमार्दिताः ।\nहिमप्रावृतसर्वाङ्गा निरूष्माण इवाग्नयः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006336019, "chapter_id": 26336, "verse_number": "१-४६-२०", "content_sanskrit": "तेषां तु दिवि दैत्यानां विपरीतप्रभाणि च ।\nविमानानि विचित्राणि निपतन्त्युत्पतन्ति च ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006336020, "chapter_id": 26336, "verse_number": "१-४६-२१", "content_sanskrit": "तान् पाशहस्तग्रथिताञ्च्छादितान्हिमरश्मिना ।\nमयो ददर्श मायावी दानवान् दिवि दानवः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006336021, "chapter_id": 26336, "verse_number": "१-४६-२२", "content_sanskrit": "स शिलाजालविततां गण्डशैलाट्टहासिनीम् ।\nपादपोत्कटकूटाग्रां कन्दराकीर्णकाननाम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006336022, "chapter_id": 26336, "verse_number": "१-४६-२३", "content_sanskrit": "सिंहव्याघ्रगजाकीर्णां नदन्तीमिव यूथपैः ।\nईहामृगगणाकीर्णां पवनाघूर्णितद्रुमाम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006336023, "chapter_id": 26336, "verse_number": "१-४६-२४", "content_sanskrit": "निर्मितां स्वेन पुत्रेण क्रौञ्चेन दिविकामगाम् ।\nप्रथितां पार्वतीं मायां ससृजे दानवोत्तमः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006336024, "chapter_id": 26336, "verse_number": "१-४६-२५", "content_sanskrit": "सास्मशब्दैः शिलावर्षैः सम्पतद्भिश्च पादपैः ।\nनिजघ्ने देवसंघांस्तान् दानवांश्चाप्यजीवयत् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006336025, "chapter_id": 26336, "verse_number": "१-४६-२६", "content_sanskrit": "नैशाकरी वारुणी च मायेऽन्तर्दधतस्ततः ।\nअश्मभिश्चायसघनैः कीर्णा देवगणा रणे ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006336026, "chapter_id": 26336, "verse_number": "१-४६-२७", "content_sanskrit": "साश्मसंघातविषमा द्रुमपर्वतसंकटा ।\nअभवद् घोरसंचारा पृथिवी पर्वतैरिव ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006336027, "chapter_id": 26336, "verse_number": "१-४६-२८", "content_sanskrit": "नानाहतोऽश्मभिः कश्चिच्छिलाभिश्चाप्यताडितः ।\nनानिरुद्धो द्रुमगणैर्देवोऽदृश्यत संयुगे ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006336028, "chapter_id": 26336, "verse_number": "१-४६-२९", "content_sanskrit": "तदपभ्रष्टधनुषं भग्नप्रहरणाविलम् ।\nनिष्प्रयत्नं सुरानीकं वर्जयित्वा गदाधरम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006336029, "chapter_id": 26336, "verse_number": "१-४६-३०", "content_sanskrit": "स हि युद्धगतः श्रीमानीशो न स्म व्यकम्पत ।\nसहिष्णुत्वाज्जगत्स्वामी न चुक्रोध गदाधरः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006336030, "chapter_id": 26336, "verse_number": "१-४६-३१", "content_sanskrit": "कालज्ञः कालमेघाभः समैक्षत् कालमाहवे ।\nदेवासुरविमर्दं स द्रष्टुकामो जनार्दनः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006336031, "chapter_id": 26336, "verse_number": "१-४६-३२", "content_sanskrit": "ततो भगवताऽऽदिष्टौ रणे पावकमारुतौ ।\nशमनार्थं प्रवृद्धाया मायाया मयसृष्टया ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006336032, "chapter_id": 26336, "verse_number": "१-४६-३३", "content_sanskrit": "ततः प्रवृद्धावन्योन्यं प्रबुद्धौ ज्वालवाहिनौ ।\nचोदितौ विष्णुवाक्येन तां मायां व्यपकर्षताम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006336033, "chapter_id": 26336, "verse_number": "१-४६-३४", "content_sanskrit": "ताभ्यामुद्भ्रान्तवेगाभ्यां प्रवृद्धाभ्यां महाहवे ।\nदग्धा सा पार्वती माया भस्मीभूता ननाश ह ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006336034, "chapter_id": 26336, "verse_number": "१-४६-३५", "content_sanskrit": "सोऽनिलोऽनलसंयुक्तः सोऽनलश्चानिलाकुलः ।\nदैत्यसेनां ददहतुर्युगान्तेष्विव मूच्छितौ ॥३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006336035, "chapter_id": 26336, "verse_number": "१-४६-३६", "content_sanskrit": "वायुः प्रधावितस्तत्र पश्चादग्निश्च मारुतात् ।\nचेरतुर्दानवानीके क्रीडन्तावनलानिलौ ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006336036, "chapter_id": 26336, "verse_number": "१-४६-३७", "content_sanskrit": "भस्मावयवभूतेषु प्रपतच्छपतत्सु च ।\nदानवेषु विनष्टेषु कृतकर्मणि पावके ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006336037, "chapter_id": 26336, "verse_number": "१-४६-३८", "content_sanskrit": "वातस्कन्धापविद्धेषु विमानेषु समन्ततः ।\nमायाबन्धे विनिर्वृत्ते स्तूयमाने गदाधरे ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006336038, "chapter_id": 26336, "verse_number": "१-४६-३९", "content_sanskrit": "निष्प्रयत्नेषु दैत्येषु त्रैलोक्ये मुक्तबन्धने ।\nसम्प्रहृष्टेषु देवेषु साधु साध्विति सर्वशः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006336039, "chapter_id": 26336, "verse_number": "१-४६-४०", "content_sanskrit": "जये दशशताक्षस्य मयस्य च पराजये ।\nदिक्षु सर्वासु शुद्धासु प्रवृत्ते धर्मसंस्तरे ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006336040, "chapter_id": 26336, "verse_number": "१-४६-४१", "content_sanskrit": "अपावृत्ते चन्द्रपथे अयनस्थे दिवाकरे ।\nप्रकृतिस्थेषु लोकेषु नृषु चारित्रबन्धुषु ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006336041, "chapter_id": 26336, "verse_number": "१-४६-४२", "content_sanskrit": "अभिन्नबन्धने मृत्यौ हूयमाने हुताशने ।\nयज्ञभागिषु देवेषु स्वर्गार्थं दर्शयत्सु च ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006336042, "chapter_id": 26336, "verse_number": "१-४६-४३", "content_sanskrit": "लोकपालेषु सर्वेषु दिक्षु संयानवर्तिषु ।\nभावे तपसि शुद्धानामभावे दुष्टकर्मणाम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006336043, "chapter_id": 26336, "verse_number": "१-४६-४४", "content_sanskrit": "देवपक्षे प्रमुदिते दैत्यपक्षे विषीदति ।\nत्रिपादविग्रहे धर्मे अधर्मे पादविग्रहे ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006336044, "chapter_id": 26336, "verse_number": "१-४६-४५", "content_sanskrit": "अपावृतमहाद्वारे वर्तमाने च सत्पथे ।\nस्वधर्मस्थेषु वर्णेषु लोकेऽल्मिन्नाश्रमेषु च ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006336045, "chapter_id": 26336, "verse_number": "१-४६-४६", "content_sanskrit": "प्रजारक्षणयुक्तेषु भ्राजमानेषु राजसु ।\nगीयमानासु गाथासु देवसंस्तवनादिषु ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006336046, "chapter_id": 26336, "verse_number": "१-४६-४७", "content_sanskrit": "प्रशान्तकलुषे लोके शान्ते तपसि दारुणे ।\nअग्निमारुतयोस्तस्मिन् वृत्ते संग्रामकर्मणि ।\nतन्मया विमलालोकास्ताभ्यां जयकृतप्रियाः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006336047, "chapter_id": 26336, "verse_number": "१-४६-४८", "content_sanskrit": "पूर्वदेवभयं श्रुत्वा मारुताग्निकृतं महत् ।\nकालनेमिरिति ख्यातो दानवः प्रत्यदृश्यत ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006336048, "chapter_id": 26336, "verse_number": "१-४६-४९", "content_sanskrit": "भास्कराकारमुकुटः शिञ्जिताभरणाङ्गदः ।\nमन्दराचलसंकाशो महारजतसंवृतः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006336049, "chapter_id": 26336, "verse_number": "१-४६-५०", "content_sanskrit": "शतप्रहरणोदग्रः शतबाहुः शताननः ।\nशतशीर्षा स्थितः श्रीमाञ्छतशृङ्ग इवाचलः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006336050, "chapter_id": 26336, "verse_number": "१-४६-५१", "content_sanskrit": "कक्षे महति संवृद्धो हिमान्त इव पावकः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006336051, "chapter_id": 26336, "verse_number": "१-४६-५२", "content_sanskrit": "धूम्रकेशो हरिच्छ्मश्रुर्दंष्ट्रालोष्ठपुटाननः ।\nत्रैलोक्यान्तरविस्तारो धारयन् विपुलं वपुः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006336052, "chapter_id": 26336, "verse_number": "१-४६-५३", "content_sanskrit": "बाहुभिस्तुलयन् व्योम क्षिपन्पद्भ्यां महीधरान् ।\nईरयन् मुखनिःश्वासैर्वृष्टिमन्तो बलाहकान् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006336053, "chapter_id": 26336, "verse_number": "१-४६-५४", "content_sanskrit": "तिर्यगायतरक्ताक्षं मन्दरोश्ग्रवर्चसम् ।\nदिधक्षन्तमिवायान्तं सर्वान् देवगणान्मृधे ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006336054, "chapter_id": 26336, "verse_number": "१-४६-५५", "content_sanskrit": "तर्जयन्तं सुरगणांश्छादयन्तं दिशो दश ।\nसंवर्तकाले क्षुधितं दृप्तं मृत्युमिवोत्थितम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006336055, "chapter_id": 26336, "verse_number": "१-४६-५६", "content_sanskrit": "सुतलेनोच्छ्रितवता विपुलाङ्गुलिपर्वणा ।\nमाल्याभरणपूर्णेन किञ्चिच्चलितवर्मणा ॥५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006336056, "chapter_id": 26336, "verse_number": "१-४६-५७", "content_sanskrit": "उच्छ्रितेनाग्रहस्तेन दक्षिणेन वपुष्मता ।\nदानवान् देवनिहतानुत्तिष्ठध्वमिति ब्रुवन् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006336057, "chapter_id": 26336, "verse_number": "१-४६-५८", "content_sanskrit": "तं कालनेमिं समरे द्विषतां कालसंनिभम् ।\nवीक्षन्ति स्म सुराः सर्वे भयविक्लवमानसाः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006336058, "chapter_id": 26336, "verse_number": "१-४६-५९", "content_sanskrit": "तं स्म वीक्षन्ति भूतानि क्रमन्तं कालनेमिनम् ।\nत्रिविक्रमं विक्रमन्तं नारायणमिवापरम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006336059, "chapter_id": 26336, "verse_number": "१-४६-६०", "content_sanskrit": "सोच्छ्रयन् प्रथमं पादं मारुताघूर्णिताम्बरः ।\nप्राक्रामदसुरो युद्धे त्रासयन् सर्वदेवताः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006336060, "chapter_id": 26336, "verse_number": "१-४६-६१", "content_sanskrit": "स मयेनासुरेन्द्रेण परिष्वक्तः क्रमन् रणे ।\nकालनेमिर्बभौ दैत्यः विष्णुनेव पुरंदरः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006336061, "chapter_id": 26336, "verse_number": "१-४६-६२", "content_sanskrit": "अथ विव्यथिरे देवाः सर्वे शक्रपुरोगमाः ।\nदृष्ट्वा कालमिवायान्तं कालनेमिं भयावहम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}]