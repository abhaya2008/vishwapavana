[{"id": 7003506000, "chapter_id": 23506, "verse_number": "१४६-१", "content_sanskrit": "अथ रुरुक्षेत्रस्थहृषीकेशमाहात्म्यम् ।\nसूत उवाच ।\nशालग्रामस्य माहात्म्यं श्रुत्वा गुह्यं महौजसम् ।\nविस्मयं परमं गत्वा हृष्टा वचनमब्रवीत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003506001, "chapter_id": 23506, "verse_number": "१४६-२", "content_sanskrit": "धरण्युवाच ।\nअहो क्षेत्रस्य माहात्म्यं यत्त्वया भाषितं हरे ।\nएतच्छ्रुत्वा महाभाग जातास्मि विगतज्वरा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003506002, "chapter_id": 23506, "verse_number": "१४६-३", "content_sanskrit": "रुरुषण्डमिति प्रोक्तं यत्त्वया परमार्च्चितम् ।\nरुरुर्नाम कथं को वा आसीत्पूर्वं जनार्दन ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003506003, "chapter_id": 23506, "verse_number": "१४६-४", "content_sanskrit": "यन्नाम्ना परमं क्षेत्रं हृषीकेश त्वयाश्रितम् ।\nकथयस्व जगन्नाथ यद्यनुग्राह्यता मयि ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003506004, "chapter_id": 23506, "verse_number": "१४६-५", "content_sanskrit": "श्रीवराह उवाच ।\nआसीत्पुरा महाभागो देवदत्त इति द्विजः ।\nभृगुवंशे समुत्पन्नो वेदवेदाङ्गपारगः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003506005, "chapter_id": 23506, "verse_number": "१४६-६", "content_sanskrit": "यज्ञविद्यासु कुशलो व्रतनिष्ठोऽतिथिप्रियः ।\nतत्राश्रमपदं पुण्यं पुण्यद्रुमलतान्वितम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003506006, "chapter_id": 23506, "verse_number": "१४६-७", "content_sanskrit": "शान्तैर्मृगगणैः कीर्णं कन्दमूलफलान्वितम् ।\nतत्र तीव्रं तपोऽतप्यद्देवदत्तो मुनीश्वरः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003506007, "chapter_id": 23506, "verse_number": "१४६-८", "content_sanskrit": "वर्षाणामयुतं साग्रं तत इन्द्रो व्यचिन्तयत् ।\nकामं वसन्तसहितं गन्धर्वान् स सखीन्पुनः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003506008, "chapter_id": 23506, "verse_number": "१४६-९", "content_sanskrit": "उवाच मधुरं वाक्यं क्षुब्धेन्द्रियमनाः प्रभुः ।\nअहो सखायः किंचिन्मे महत्कार्यमुपस्थितम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003506009, "chapter_id": 23506, "verse_number": "१४६-१०", "content_sanskrit": "तस्य मे चिन्तयानस्य यूयमेव परा गतिः ।\nभवत्प्रसादात्स्वस्थोऽहं निर्भयस्तद्विचिन्त्यताम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003506010, "chapter_id": 23506, "verse_number": "१४६-११", "content_sanskrit": "तदिन्द्रस्य वचः श्रुत्वा ते काममलयानिलाः ।\nप्रत्यूचुर्देवराजानमाज्ञापय निजं प्रियम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003506011, "chapter_id": 23506, "verse_number": "१४६-१२", "content_sanskrit": "जितेन्द्रियस्यापि मनः कस्य संक्षोभयामहे ।\nकं वा सुतीव्रात्तपसो भ्रंशयामः सुपेशलम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003506012, "chapter_id": 23506, "verse_number": "१४६-१३", "content_sanskrit": "आज्ञाप्रसादं ते लब्ध्वा वद शीघ्रं सुखी भव ।\nइत्युक्तः शतमन्युर्वै प्रत्युवाचाऽथ मानयन् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003506013, "chapter_id": 23506, "verse_number": "१४६-१४", "content_sanskrit": "तदैव मे गता चिन्ता भवतां दर्शनं यदा ।\nजातमेवाऽखिलं कार्यं मम तच्छृणुताखिलाः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003506014, "chapter_id": 23506, "verse_number": "१४६-१५", "content_sanskrit": "हिमशैले महारम्ये हृषीकेशाश्रितो मुनिः ।\nदेवदत्त इति ख्यातस्तपस्यति महत्तपः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003506015, "chapter_id": 23506, "verse_number": "१४६-१६", "content_sanskrit": "जिघृक्षुर्मे पदं नूनं तत्तपो विनिवर्त्यताम् ।\nइत्युक्तास्ते तदाज्ञां वै गृहीत्वा शिरसा द्रुतम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003506016, "chapter_id": 23506, "verse_number": "१४६-१७", "content_sanskrit": "प्रस्थानाय मतिं चक्रुः कामदेवपुरःसराः ।\nप्रस्थाप्याग्रे वसन्तं च मलयानिलमेव च ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003506017, "chapter_id": 23506, "verse_number": "१४६-१८", "content_sanskrit": "ततः सुरपतिः शक्रः प्रम्लोचां नाम नामतः ।\nप्रशस्य प्रणयात्पूर्वं मानयन्निदमब्रवीत् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003506018, "chapter_id": 23506, "verse_number": "१४६-१९", "content_sanskrit": "गच्छ स्वस्तिमती देवि विजयाय मुनेर्भुवि ।\nयत्राश्रमपदं तस्य देवदत्तस्य वै मुनेः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003506019, "chapter_id": 23506, "verse_number": "१४६-२०", "content_sanskrit": "ललितैः स्वैर्विलासैस्तं मोहयित्वा वशं कुरु ।\nयथा मत्प्रीतिरतुला त्वं मे कार्यकरी सदा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003506020, "chapter_id": 23506, "verse_number": "१४६-२१", "content_sanskrit": "तथा कुरुष्व भद्रं ते हृषीकेशसमीपतः ।\nइन्द्रस्याज्ञां समादाय ययौ तस्याश्रमं प्रति ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003506021, "chapter_id": 23506, "verse_number": "१४६-२२", "content_sanskrit": "समीपोपवने रम्ये नानाद्रुमलताकुले ।\nमधुरालापबहुले कोकिलानां कलाकुले ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003506022, "chapter_id": 23506, "verse_number": "१४६-२३", "content_sanskrit": "रसालमञ्जरीव्याप्तरसामोदालिसंकुले ।\nगुंजन्मत्तालिसन्नादश्रुतिश्रुतिधरान्विते ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003506023, "chapter_id": 23506, "verse_number": "१४६-२४", "content_sanskrit": "गन्धर्वगीतसंमिश्रे मलयानिलशीतले ।\nसम्फुल्लपङ्कजवने सुनिर्मलजलाशये ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003506024, "chapter_id": 23506, "verse_number": "१४६-२५", "content_sanskrit": "मुनिप्रभावसन्त्यक्तक्रौर्यस्थलजलाशये ।\nमधुरामोदमधुरे चित्तक्षोभविधायिनि ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003506025, "chapter_id": 23506, "verse_number": "१४६-२६", "content_sanskrit": "प्रविश्य सा वरारोहा गीतं सुमधुरं जगौ ।\nयदा ध्यानादुपरतः समाधेर्विरताश्चिरात् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003506026, "chapter_id": 23506, "verse_number": "१४६-२७", "content_sanskrit": "गान्धर्वं प्रारभंस्ते तु गन्धर्वाः सुरसम्मताः ।\nतस्मिन्नेव क्षणे लब्ध्वाऽवसरं पंच सायकः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003506027, "chapter_id": 23506, "verse_number": "१४६-२८", "content_sanskrit": "विचकर्ष धनुः पौष्पं सायकान् समयूयुजत् ।\nसंलक्ष्य तं मुनिं शान्तं भाविदैवबलात्कृतम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003506028, "chapter_id": 23506, "verse_number": "१४६-२९", "content_sanskrit": "श्रुत्वा तन्मधुरं गीतं पञ्चमालापसुन्दरम् ।\nक्षुब्धचित्तः समभवत्स मुनिः संशितव्रतः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003506029, "chapter_id": 23506, "verse_number": "१४६-३०", "content_sanskrit": "चकर्ष च धनुः कामः पुनःपुनरतन्द्रितः ।\nदेवव्रतोऽपि स मुनिः क्षुब्धात्मा नियतोऽपि सन् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003506030, "chapter_id": 23506, "verse_number": "१४६-३१", "content_sanskrit": "विचचाराश्रमपदं पश्यन्सन्तुष्टमानसः ।\nदूराद्ददर्श तन्वङ्गीं क्रीडन्तीं कन्दुकेन ताम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003506031, "chapter_id": 23506, "verse_number": "१४६-३२", "content_sanskrit": "दृष्ट्वैव तां तु चार्वंगीं विद्धः कामेन पत्रिणा ।\nतस्याः समीपमगमत्स्मयमानो महामुनिः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003506032, "chapter_id": 23506, "verse_number": "१४६-३३", "content_sanskrit": "सापि दृष्ट्वा देवदत्तं सज्जन्ती हरिणेक्षणा ।\nकटाक्षयन्ती सहसा लज्जमाना विगूहति ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003506033, "chapter_id": 23506, "verse_number": "१४६-३४", "content_sanskrit": "करेण कन्दुकं घ्नन्ती चञ्चलाक्षी सुपेशला ।\nस्रंसता केशपासेन गलत्पुष्पेण राजता ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003506034, "chapter_id": 23506, "verse_number": "१४६-३५", "content_sanskrit": "मनो हरन्ती तस्यर्षेः ललितैर्विभ्रमोद्भवैः ।\nएतस्मिन्नन्तरे तस्या दक्षिणः पवनोऽहरत् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003506035, "chapter_id": 23506, "verse_number": "१४६-३६", "content_sanskrit": "वासः सूक्ष्मंगलन्नीवि कांचीदामगुणान्वितम् ।\nपुष्पबाणोऽप्यविध्यत्तं दृष्ट्वा ऽवसरमन्तिके ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003506036, "chapter_id": 23506, "verse_number": "१४६-३७", "content_sanskrit": "सम्मोहितः स तु मुनिर्गत्वान्तिकमथाब्रवीत् ।\nका त्वं कस्यासि सुभगे वनेऽस्मिन्किञ्चिकीर्षसि ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003506037, "chapter_id": 23506, "verse_number": "१४६-३८", "content_sanskrit": "मादृशान्किं मृगयसे बाहुपाशेन वा मृगान् ।\nबद्ध्वा गृहीत्वा वामोरु किं वाऽस्मान्कर्त्तुमिच्छसि ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003506038, "chapter_id": 23506, "verse_number": "१४६-३९", "content_sanskrit": "सर्वथाऽस्मांस्तवाधीनान् यद्यद्वा कारयिष्यति ।\nतत्तत्कुर्मो वयं नित्यं तदधीनाः स्म सर्वथा ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003506039, "chapter_id": 23506, "verse_number": "१४६-४०", "content_sanskrit": "अथ तां हसमानां च गृहीत्वा दक्षिणे करे ।\nसमालिङ्ग्य विषज्जंतीं रमयामास मोहितः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003506040, "chapter_id": 23506, "verse_number": "१४६-४१", "content_sanskrit": "रममाणस्तया सार्द्धं भुञ्जन्भोगान् मनोरमान् ।\nतपःप्रभावोपनतान्दिवारात्रमतंद्रितः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003506041, "chapter_id": 23506, "verse_number": "१४६-४२", "content_sanskrit": "बहूनहर्गणानेवं रममाणो यदृच्छया ।\nसुप्तोत्थित इवाकस्माद्विवकेन समन्वितः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003506042, "chapter_id": 23506, "verse_number": "१४६-४३", "content_sanskrit": "निर्वेदं प्राप्तवान्सद्यस्तदोवाच भृशातुरः ।\nअहो भागवती माया ययाहं भृशमोहितः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003506043, "chapter_id": 23506, "verse_number": "१४६-४४", "content_sanskrit": "जानन्नपि तपोभ्रंशं प्राप्तो दैवबलात्कृतः ।\nअग्निकुण्डसमा नारी घृतकुम्भसमः पुमान् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003506044, "chapter_id": 23506, "verse_number": "१४६-४५", "content_sanskrit": "इति प्रवादो मूर्खाणां विचारान्महदन्तरम् ।\nघृतकुम्भोऽग्नि योगेन द्रवते न तु दर्शनात् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003506045, "chapter_id": 23506, "verse_number": "१४६-४६", "content_sanskrit": "पुमांस्त्रीदर्शनादेव द्रवते यद्विमोहितः ।\nनापराधस्त्वतो नार्याः स्वयं यदजितेन्द्रियः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003506046, "chapter_id": 23506, "verse_number": "१४६-४७", "content_sanskrit": "इत्युक्त्वाऽसौ निवृत्तात्मा विससर्ज सुराङ्गनाम् ।\nप्रम्लोचा दैववशगो मनस्येतदचिन्तयत् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003506047, "chapter_id": 23506, "verse_number": "१४६-४८", "content_sanskrit": "उपसर्गो महानत्र तपसो भ्रंशकारकः ।\nत्यक्त्वाश्रममिमं चान्यत्स्थानं गत्वा समाहितः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003506048, "chapter_id": 23506, "verse_number": "१४६-४९", "content_sanskrit": "तपस्तीव्रं समास्थाय शोषयिष्ये कलेवरम् ।\nइति निश्चित्य मनसा गत्वा भृग्वाश्रमं प्रति ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003506049, "chapter_id": 23506, "verse_number": "१४६-५०", "content_sanskrit": "गण्डकीसंगमे स्नात्वा सन्तर्प्य पितृदेवताः ।\nविष्णुं शिवं च सम्पूज्य तपःस्थानं विचिंतयन् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003506050, "chapter_id": 23506, "verse_number": "१४६-५१", "content_sanskrit": "पश्यन्भृग्वाश्रमं रम्यमुत्तरं गतवान् शनैः ।\nगण्डक्याः पूर्वभागे तु विविक्तं विजनं शुभम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003506051, "chapter_id": 23506, "verse_number": "१४६-५२", "content_sanskrit": "दृष्ट्वा तीरेषु विश्रांतस्तपोभूमिमचिंतयत् ।\nभृगुतुंगं समासाद्य शङ्कराराधने रतः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003506052, "chapter_id": 23506, "verse_number": "१४६-५३", "content_sanskrit": "अतप्यत तपो घोरं शिवदर्शनलालसः ।\nअथ दीर्घेण कालेन सन्तुष्टः स महेश्वरः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003506053, "chapter_id": 23506, "verse_number": "१४६-५४", "content_sanskrit": "लिंगरूपधरः साक्षादुपर्यपि तथा ह्यधः ।\nतिर्यक् च जलधाराभिर्युक्तस्तत्तापशांतिकृत् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003506054, "chapter_id": 23506, "verse_number": "१४६-५५", "content_sanskrit": "उवाच च प्रसन्नात्मा मुने पश्य च मां शिवम् ।\nमामेवावेहि विष्णुं त्वं मा पश्यस्वांतरं मम ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003506055, "chapter_id": 23506, "verse_number": "१४६-५६", "content_sanskrit": "पूर्वमन्तरभावेन दृष्टवानसि यन्मम ।\nतेन विघ्नोऽभवद्येन गलितं त्वत्तपो महत् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003506056, "chapter_id": 23506, "verse_number": "१४६-५७", "content_sanskrit": "आवामेकेन भावेन पश्यंस्त्वं सिद्धिमाप्स्यसि ।\nतपःप्रभावाल्लिंगानि प्रादुर्भूतानि यत्र वै ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003506057, "chapter_id": 23506, "verse_number": "१४६-५८", "content_sanskrit": "समंगमिति विख्यातमेतत्स्थानं भविष्यति।\nस्नात्वाऽत्र गण्डकीतीर्थे मम लिंगानि योऽर्च्चयेत् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003506058, "chapter_id": 23506, "verse_number": "१४६-५९", "content_sanskrit": "तस्य योगफलं सम्यग्भविष्यति न संशयः ।\nइति दत्त्वा वरं शम्भुस्तत्रैवान्तरधीयत ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003506059, "chapter_id": 23506, "verse_number": "१४६-६०", "content_sanskrit": "देवदत्तोऽपि स मुनिः सम्प्राप्य ज्ञानमुत्तमम् ।\nशिवोपदिष्टमार्गेण सायुज्यं परमं गतः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003506060, "chapter_id": 23506, "verse_number": "१४६-६१", "content_sanskrit": "प्रम्लोचापि मुनेर्गर्भं सम्प्राप्याश्रममन्तिकात् ।\nप्रसूतां कन्यकां त्यक्त्वा स्वर्गमेव जगाम ह ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003506061, "chapter_id": 23506, "verse_number": "१४६-६२", "content_sanskrit": "पुनर्जातमिवात्मानं मन्यमाना शुचिस्मिता ।\nसापि कन्या मृगैस्तत्र रुरुभिर्वर्द्धिता सती ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003506062, "chapter_id": 23506, "verse_number": "१४६-६३", "content_sanskrit": "रुरुरित्वेव विख्याता पितुरेवाश्रमे स्थिता ।\nयुवभिः प्रार्थ्यमानापि चित्ते कञ्चन नाध्यगात् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003506063, "chapter_id": 23506, "verse_number": "१४६-६४", "content_sanskrit": "ततः सुनिश्चयं कृत्वा तपसे धृतमानसा ।\nचिन्तयन्ती जगन्नाथं भगवन्तं रमापतिम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003506064, "chapter_id": 23506, "verse_number": "१४६-६५", "content_sanskrit": "मासे सा प्रथमे बाला फलाहारपरायणा ।\nएकांतरं दिनं प्राप्य द्वितीये त्रिदिनान्तरे ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003506065, "chapter_id": 23506, "verse_number": "१४६-६६", "content_sanskrit": "तृतीये पंचम दिने चतुर्थे सप्तमांतरे ।\nपञ्चमे नवरात्रेण षष्ठे पञ्चदशाहके ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003506066, "chapter_id": 23506, "verse_number": "१४६-६७", "content_sanskrit": "मासेन सप्तमे चैव शीर्णपर्णाशनाष्टमे ।\nत्यक्त्वा तान्यपि सा बाला वाय्वाहारा बभूव ह ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003506067, "chapter_id": 23506, "verse_number": "१४६-६८", "content_sanskrit": "सैवं वर्षशतं स्थित्वा हरावेकाग्रमानसा ।\nसमाधिना समा भूत्वा स्थाणुवन्निश्लाऽभवत् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003506068, "chapter_id": 23506, "verse_number": "१४६-६९", "content_sanskrit": "द्वन्द्वानि   नाविदच्चापि आत्मभूतान्तरं विना ।\nपरां काष्ठां समापन्ना प्रकाशमयकांतिधृक् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003506069, "chapter_id": 23506, "verse_number": "१४६-७०", "content_sanskrit": "तत्तेजसा वृतं सर्वं तदा दृष्ट्वा वसुन्धरे ।\nअहं विस्मयमापन्नस्तस्याः प्रत्यक्षतां गतः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003506070, "chapter_id": 23506, "verse_number": "१४६-७१", "content_sanskrit": "सन्निरुद्धेन्द्रियग्रामा नाचक्षत बहिःस्थितम् ।\nतदा हृषीकाण्याविश्य संहृत्य स्वं हृदो बहिः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003506071, "chapter_id": 23506, "verse_number": "१४६-७२", "content_sanskrit": "स्थितोऽहं वसुधे देवि अक्ष्णोः प्रत्यक्षतां गतः ।\nहृषीकाणि नियम्याहं यतः प्रत्यक्षतां गतः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003506072, "chapter_id": 23506, "verse_number": "१४६-७३", "content_sanskrit": "हृषीकेश इति ख्यातो नाम्ना तत्रैव संस्थितः ।\nसा मां यदैव नापश्यदुन्मील्य नयने ततः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003506073, "chapter_id": 23506, "verse_number": "१४६-७४", "content_sanskrit": "बहिः स्थितं च मां दृष्ट्वा प्रणनाम कृताञ्जलिः ।\nगद्गदस्वरसंयुक्ता अश्रुक्लिन्नविलोचना ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003506074, "chapter_id": 23506, "verse_number": "१४६-७५", "content_sanskrit": "रोमांचिततनुश्चासीत्कदम्बमुकुलाकृतिः ।\nतथा भूतां तु तां दृष्ट्वा प्रावोचमहमङ्गनाम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003506075, "chapter_id": 23506, "verse_number": "१४६-७६", "content_sanskrit": "अयि बाले विशालाक्षि तुष्टोऽहं तपसस्तव ।\nवरं याचय मत्तस्त्वं यत्ते मनसि वर्त्तते ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003506076, "chapter_id": 23506, "verse_number": "१४६-७७", "content_sanskrit": "अदेयमपि ते दद्मि यदन्येषां सुदुर्ल्लभम् ।\nइति श्रुत्वा प्रभोर्वाक्यं प्रणम्य च पुनः पुनः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003506077, "chapter_id": 23506, "verse_number": "१४६-७८", "content_sanskrit": "स्तुत्वा तं देवदेवेशं प्रबद्धकरसंपुटा ।\nददासि चेद्वरं मह्यं देवदेव जगत्पते ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003506078, "chapter_id": 23506, "verse_number": "१४६-७९", "content_sanskrit": "अनेनैव स्वरूपेण भगवन्स्थातुमर्हसि ।\nस्थितोऽस्म्यत्रैव भद्रं ते अपरं वरयाशु मे ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003506079, "chapter_id": 23506, "verse_number": "१४६-८०", "content_sanskrit": "दुर्लभं ते वरं दद्मि तपसाहं प्रतोषितः ।\nइत्युक्त्वा मां प्रणम्याह रुरुः सा संशितव्रता ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003506080, "chapter_id": 23506, "verse_number": "१४६-८१", "content_sanskrit": "यदि प्रसन्नो देवेश तदा मां कुरु पावनीम् ।\nमन्नाम्ना क्षेत्रमेतच्च ख्यातं भवतु नान्यथा ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003506081, "chapter_id": 23506, "verse_number": "१४६-८२", "content_sanskrit": "तामहं देवि सुभगे प्रावोचं पुनरेव हि ।\nतीर्थानां परमं तीर्थं तव देहो भवत्वयम् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003506082, "chapter_id": 23506, "verse_number": "१४६-८३", "content_sanskrit": "तव नाम्नां च विख्यातमेतत्क्षेत्रं भविष्यति ।\nतव तीर्थे कृतस्नानस्त्रिरात्रोपोषितो नरः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003506083, "chapter_id": 23506, "verse_number": "१४६-८४", "content_sanskrit": "विलोक्य मां भवेत्पूतो मम वाक्यान्न संशयः ।\nब्रह्महत्यादि पापानि ज्ञात्वाऽज्ञात्वा कृतान्यपि ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003506084, "chapter_id": 23506, "verse_number": "१४६-८५", "content_sanskrit": "यास्यन्ति विलयं क्षिप्रमेवमेतन्न संशयः ।\nइति दत्त्वा वरांस्तस्यै तत्रैवान्तर्हितः स्थितः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003506085, "chapter_id": 23506, "verse_number": "१४६-८६", "content_sanskrit": "सापि कालेन सञ्जाता तीर्थभूता तथाऽभवत् ।\nएतत्ते कथितं देवि रुरुमाहात्म्यमुत्तमम् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003506086, "chapter_id": 23506, "verse_number": "१४६-८७", "content_sanskrit": "रुरुक्षेत्रस्य प्रभवमेतद्गुह्यं परं मम ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}]