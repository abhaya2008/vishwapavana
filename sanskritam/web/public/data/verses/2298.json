[{"id": 2060630, "chapter_id": 2298, "verse_number": "८-१९-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2060631, "chapter_id": 2298, "verse_number": "८-१९-१", "content_sanskrit": "युधिष्ठिरं महाराज विसृजन्तं शरान्बहून्।\nस्वयं दुर्योधनो राजा प्रत्यगृह्णादभीतवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2060632, "chapter_id": 2298, "verse_number": "८-१९-२", "content_sanskrit": "तमापतन्तं सहसा तव पुत्रं महारथम्।\nधर्मराजो द्रुतं विद्ध्वा तिष्ठतिष्ठेति चाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2060633, "chapter_id": 2298, "verse_number": "८-१९-३", "content_sanskrit": "स तु तं प्रतिविव्याध नवभिर्निशितैः शरैः।\nसारथिं चास्य भल्लेन भृशं क्रुद्धोऽभ्यताडयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2060634, "chapter_id": 2298, "verse_number": "८-१९-४", "content_sanskrit": "ततो युधिष्ठिरो राजन्स्वर्णपुङ्खाञ्शिलीमुखान्।\nदुर्योधनाय चिक्षेप त्रयोदश शिलाशितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2060635, "chapter_id": 2298, "verse_number": "८-१९-५", "content_sanskrit": "चतुर्भिश्चतुरो वाहांस्तस्य हत्वा महारथः।\nपञ्चमेन शिरः कायात्सारथेश्च समाक्षिपत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2060636, "chapter_id": 2298, "verse_number": "८-१९-६", "content_sanskrit": "षष्ठेन तु ध्वजं राज्ञः सप्तमेन तु कार्मुकम्।\nअष्टमेन तथा खङ्गं पातयामास भूतले।\nपञ्चभिर्नृपतिं चापि धर्मराजोऽर्दयद्भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2060637, "chapter_id": 2298, "verse_number": "८-१९-७", "content_sanskrit": "हताश्वात्तु रथात्तस्मादवप्लुत्य सुतस्तव।\nउत्तमं व्यसनं प्राप्तो भूमावेवावतिष्ठत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2060638, "chapter_id": 2298, "verse_number": "८-१९-८", "content_sanskrit": "तं तु कृच्छ्रगतं दृष्ट्वा कर्णद्रौणिकृपादयः।\nअभ्यवर्तन्त सहसा परीप्सन्तो नराधिपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2060639, "chapter_id": 2298, "verse_number": "८-१९-९", "content_sanskrit": "अथ पाण्डुसुताः सर्वे परिवार्य युधिष्ठिरम्।\nअन्वयुः समरे राजंस्ततो युद्धमवर्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2060640, "chapter_id": 2298, "verse_number": "८-१९-१०", "content_sanskrit": "ततस्तूर्यसहस्राणि प्रावाद्यन्त महामृधे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2060641, "chapter_id": 2298, "verse_number": "८-१९-११", "content_sanskrit": "क्ष्वेलाः किलकिलाशब्दाः प्रादुरासन्महीपते।\nयत्राभ्यगच्छन्समरे पाञ्चालाः कौरवैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2060642, "chapter_id": 2298, "verse_number": "८-१९-१२", "content_sanskrit": "नरा नरैः समाजग्मुर्वारणा वरवारणैः।\nरथाश्च रथिभिः सार्धं हयाश्च हयसादिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2060643, "chapter_id": 2298, "verse_number": "८-१९-१३", "content_sanskrit": "द्वन्द्वान्यासन्महाराज प्रेक्षणीयानि संयुगे।\nविविधान्यप्यचिन्त्यानि शस्त्रवन्त्युत्तमानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2060644, "chapter_id": 2298, "verse_number": "८-१९-१४", "content_sanskrit": "ते शूराः समरे सर्वे चित्रं लघु च सुष्ठु च।\nअयुध्यन्त महावेगाः परस्परवधैषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2060645, "chapter_id": 2298, "verse_number": "८-१९-१५", "content_sanskrit": "अन्योन्यं समरे जघ्नुर्योधव्रतमनुष्ठिताः।\nन हि ते समरं चक्रुः पृष्ठतो वै कथञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2060646, "chapter_id": 2298, "verse_number": "८-१९-१६", "content_sanskrit": "मुहूर्तमेव तद्युद्वमासीन्मधुरदर्शनम्।\nतत उन्मत्तवद्राजन्निर्मर्यादमवर्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2060647, "chapter_id": 2298, "verse_number": "८-१९-१७", "content_sanskrit": "रथी नागं समासाद्य दारयन्निशितैः शरैः।\nप्रेषयामास कालाय शरैः सन्नतपर्वभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2060648, "chapter_id": 2298, "verse_number": "८-१९-१८", "content_sanskrit": "नागा हयान्समासाद्य विक्षिपन्तो बहून्रणे।\nदारयामासुरत्युग्रं तत्रतत्र तदातदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2060649, "chapter_id": 2298, "verse_number": "८-१९-१९", "content_sanskrit": "हयारोहाश्च बहवः परिवार्य हयोत्तमान्।\nतलशब्दरवांश्चक्रुः सम्पतन्तस्ततस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2060650, "chapter_id": 2298, "verse_number": "८-१९-२०", "content_sanskrit": "धावमानांस्ततस्तांस्तु द्रवमाणान्महागजान्।\nपार्श्वतः पृष्ठतश्चैव निजघ्नुर्हयसादिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2060651, "chapter_id": 2298, "verse_number": "८-१९-२१", "content_sanskrit": "विद्राव्य च बहूनश्वान्नागा राजन्मदोत्कटाः।\nविषाणैश्चापरे जघ्नुर्ममृदुश्चापरे भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2060652, "chapter_id": 2298, "verse_number": "८-१९-२२", "content_sanskrit": "साश्वारोहांश्च तुरगान्विषामैर्विव्यधू रुषा।\nअपरे चिक्षिपुर्वेगात्प्रगृह्यातिबलास्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2060653, "chapter_id": 2298, "verse_number": "८-१९-२३", "content_sanskrit": "पादातैराहता नागा विवरेषु समन्ततः।\nचक्रुरार्तस्वरं घोरं दुद्रुवुश्च दिशो दश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2060654, "chapter_id": 2298, "verse_number": "८-१९-२४", "content_sanskrit": "पदातीनां तु सहसा प्रद्रुतानां महाहवे।\nउत्सृज्याभरणं तूर्णमववव्रू रणाजिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2060655, "chapter_id": 2298, "verse_number": "८-१९-२५", "content_sanskrit": "निमित्तं मन्यमानास्तु परिणाम्य महागजाः।\nजगृहुर्बिभिदुश्चैव चित्राण्याभरणानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2060656, "chapter_id": 2298, "verse_number": "८-१९-२६", "content_sanskrit": "तांस्तु तत्र प्रसक्तान्वै परिन्वार्य पदातयः।\nहस्त्यारोहान्निजघ्नुस्ते महावेगा बलोत्कटाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2060657, "chapter_id": 2298, "verse_number": "८-१९-२७", "content_sanskrit": "अपरे हस्तिभिर्हस्तैः खं विक्षिप्ता महाहवे।\nनिपतन्तो विषाणाग्रैर्भृशं विद्वाः सुशिक्षितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2060658, "chapter_id": 2298, "verse_number": "८-१९-२८", "content_sanskrit": "अपरे सहसा गृह्य विषाणैरेव सूदिताः।\nसेनान्तरं समासाद्य केचित्तत्र महागजैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2060659, "chapter_id": 2298, "verse_number": "८-१९-२९", "content_sanskrit": "क्षुण्णगात्रा महाराज विक्षिप्य च पुनःपुनः।\nअपरे व्यजनानीव विभ्राम्य निहता मृधे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2060660, "chapter_id": 2298, "verse_number": "८-१९-३०", "content_sanskrit": "पुरःसराश्च नागानामपरेषां विशाम्पते।\nशरीराण्यतिविद्वानि तत्रतत्र रणाजिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2060661, "chapter_id": 2298, "verse_number": "८-१९-३१", "content_sanskrit": "प्रतिमानेषु कुम्भेषु दन्तवेष्टेषु चापरे।\nनिगृहीता भृशं नागाः प्रासतोमरशक्तिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2060662, "chapter_id": 2298, "verse_number": "८-१९-३२", "content_sanskrit": "निगृह्य च गजाः केचित् पार्श्वस्थैर्भृशदारुणैः।\nरथाश्वसादिभिस्तत्र सम्भिन्ना न्यपतन्भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2060663, "chapter_id": 2298, "verse_number": "८-१९-३३", "content_sanskrit": "सहयाः सादिनस्तत्र तोमरेण महामृधे।\nभूमावमृद्रन्वेगेन सचर्माणं पदातिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2060664, "chapter_id": 2298, "verse_number": "८-१९-३४", "content_sanskrit": "चछा सावरणान्कांश्चित्तत्रतत्र विशाम्पते।\nरथान्नागाः समासाद्य परिगृह्य च मारिष।\nव्याक्षिपन्सहसा तत्र घोररूपे भयानके॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2060665, "chapter_id": 2298, "verse_number": "८-१९-३५", "content_sanskrit": "नाराचैर्निहताश्चापि गजाः पेतुर्महाबलाः।\nपर्वतस्येव शिखरं वज्ररुग्णं महीतले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2060666, "chapter_id": 2298, "verse_number": "८-१९-३६", "content_sanskrit": "योधा योधान्समासाद्य मुष्टिभिर्व्यहनन्युधि।\nकेशेष्वन्योन्यमाक्षिप्य चिक्षिपुर्बिभिदुश्च ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2060667, "chapter_id": 2298, "verse_number": "८-१९-३७", "content_sanskrit": "उद्यम्य च भुजानन्ये निक्षिप्य च महीतले।\nपदा चोरः समाक्रम्य स्फुरतोऽपाहरच्छिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2060668, "chapter_id": 2298, "verse_number": "८-१९-३८", "content_sanskrit": "पततश्चापरो राजन्विजहारासिना शिरः।\n`मृतमन्यो महाराज पदा ताडितवांस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2060669, "chapter_id": 2298, "verse_number": "८-१९-३९", "content_sanskrit": "जीवतश्च तथैवान्यः शस्त्रं काये न्यमज्जयत्।\nमुष्टियुद्धं महच्चासीद्योधानां तत्र भारत।\nतथा केशग्रहश्चोग्रो बाहुयुद्धं च भैरवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2060670, "chapter_id": 2298, "verse_number": "८-१९-४०", "content_sanskrit": "समासक्तस्य चान्येन अविज्ञातस्तथाऽपरः।\nजहार समरे प्राणान्नानाशस्तैरनेकधा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2060671, "chapter_id": 2298, "verse_number": "८-१९-४१", "content_sanskrit": "संसक्तेषु च योधेषु वर्तमाने च सङ्कुले।\nकबन्धान्युत्थितानि स्युः शतशोऽथ सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2060672, "chapter_id": 2298, "verse_number": "८-१९-४२", "content_sanskrit": "शोणितैः सिच्यमानानि शस्त्राणि कवचानि च।\nमहारागानुरक्तानि वस्त्राणीव चकाशिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2060673, "chapter_id": 2298, "verse_number": "८-१९-४३", "content_sanskrit": "एवमेतन्महद्युद्वं दारुणं शस्त्रसङ्कुलम्।\nउन्मत्तगङ्गाप्रतिमं शब्देनापूरयज्जगत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2060674, "chapter_id": 2298, "verse_number": "८-१९-४४", "content_sanskrit": "नैव स्वे न परे राजन्विज्ञायन्ते शरातुराः।\nयोद्वव्यमिति युध्यन्ते राजानो जयगृद्विनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2060675, "chapter_id": 2298, "verse_number": "८-१९-४५", "content_sanskrit": "स्वान्स्वे जघ्नुर्महराज परांश्चैव समागतान्।\nउभयोः सेनयोर्वीरैर्व्याकुलं समपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2060676, "chapter_id": 2298, "verse_number": "८-१९-४६", "content_sanskrit": "रथैर्भग्नैर्महाराज वारणैश्च निपातितैः।\nहयैश्च पतितैस्तत्र नरैश्च विनिपातितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2060677, "chapter_id": 2298, "verse_number": "८-१९-४७", "content_sanskrit": "अगम्यरूपा पृथिवी क्षणेन समपद्यत।\nक्षणेनासीन्महीपाल क्षतजौघप्रवर्तिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2060678, "chapter_id": 2298, "verse_number": "८-१९-४८", "content_sanskrit": "पाञ्चालानहतत्कर्णस्त्रिगर्तांश्च धनञ्जयः।\nभीमसेनः कुरून्राजन्हस्त्यनीकं च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2060679, "chapter_id": 2298, "verse_number": "८-१९-४९", "content_sanskrit": "एवमेष क्षयो वृत्तः कुरुपाण्डवसेनयोः।\nअपराह्णे गते सूर्ये काङ्क्षतां विपुलं यशः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2060680, "chapter_id": 2298, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि षोडशदिवसयुद्धे एकोनविंशोऽध्यायः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]