[{"id": 2035196, "chapter_id": 1762, "verse_number": "५-७-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2035197, "chapter_id": 1762, "verse_number": "५-७-१", "content_sanskrit": "पुरोहितं ते प्रस्थाप्य नगरं नागसाह्वयम्।\nदूतान्प्रस्थापयामासुः पार्थिवेभ्यस्ततस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2035198, "chapter_id": 1762, "verse_number": "५-७-२", "content_sanskrit": "प्रस्थाप्य दूतानन्यत्र द्वारकां पुरुषर्षभः ।\nस्वयं जगाम कौरव्यः कुन्तीपुत्रो धनञ्जयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2035199, "chapter_id": 1762, "verse_number": "५-७-३", "content_sanskrit": "गते द्वारवतीं कृष्ण बलदेवे च माधवे।\nसह वृष्ण्यन्धकैः सर्वैर्भोजैश्च शतशस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2035200, "chapter_id": 1762, "verse_number": "५-७-४", "content_sanskrit": "सर्वमागमयामास पाण्डवानां विचेष्टितम् ।\nधृतराष्ट्रात्मजो राजा गूढैः प्रणिहितैश्चरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2035201, "chapter_id": 1762, "verse_number": "५-७-५", "content_sanskrit": "स श्रुत्वा माधवं यान्तं सदश्वैरनिलोपमैः ।\nबलेन नातिमहता द्वारकामभ्ययात्पुरीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2035202, "chapter_id": 1762, "verse_number": "५-७-६", "content_sanskrit": "तमेव दिवसं चापि कौन्तेयः पाण्डुनन्दनः ।\nआनन्रतनगरीं रम्यां जगामाशु धनञ्जयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2035203, "chapter_id": 1762, "verse_number": "५-७-७", "content_sanskrit": "तौ यात्वा पुरुषव्याघ्रौ द्वारकां कुरुनन्दनौ ।\nसुप्तं ददृशतुः कृष्णं शयानं चाभिजग्मतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2035204, "chapter_id": 1762, "verse_number": "५-७-८", "content_sanskrit": "दुर्योधनस्तु प्रथमं वासुदेवमुपाश्रयत् ।\nउच्छीर्षतश्च कृष्णस्य निषसाद वरासने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2035205, "chapter_id": 1762, "verse_number": "५-७-९", "content_sanskrit": "ततः किरीटी तस्यानु प्रविवेश महामनाः ।\nपश्चार्धे तु स कृष्णस्य प्रह्वोऽतिष्ठत्कृताञ्जलिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2035206, "chapter_id": 1762, "verse_number": "५-७-१०", "content_sanskrit": "प्रतिबुद्धः स वार्ष्णेयो ददर्शाग्रे किरीटिनाम्।\nसिंहासनगतं पश्चात्परिवृत्य च दृष्टवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2035207, "chapter_id": 1762, "verse_number": "५-७-११", "content_sanskrit": "स तयोः स्वागतं कृत्वा यथावत्प्रतिपूज्य तौ ।\nतदागमनजं हेतुं पप्रच्छ मधुसूदनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2035208, "chapter_id": 1762, "verse_number": "५-७-१२", "content_sanskrit": "ततो दुर्योधनः कृष्णामुवाच प्रहसन्निव।\nविग्रहेऽस्मिन्भवान्साह्यं मम दातुमिहार्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2035209, "chapter_id": 1762, "verse_number": "५-७-१३", "content_sanskrit": "समं हि भवतः सख्यं मम चैवार्जुनेऽपि च।\nतथा संबन्धकं तुल्यमस्माकं त्वयि माधव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2035210, "chapter_id": 1762, "verse_number": "५-७-१४", "content_sanskrit": "अहं चाभिगतं सन्तो भजन्ते पूर्वसारिणः ॥\nत्वं च श्रेष्ठतमो लोके सतामद्य जनार्दन ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2035211, "chapter_id": 1762, "verse_number": "५-७-१५", "content_sanskrit": "सततं संमतश्चैव सद्वृत्तमनुपालय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2035212, "chapter_id": 1762, "verse_number": "५-७-१६x", "content_sanskrit": "कृष्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2035213, "chapter_id": 1762, "verse_number": "५-७-१६", "content_sanskrit": "भवानभिगतः पूर्वमत्र मे नास्ति संशयः।\nदृष्टस्तु प्रथमं राजन्मया पार्थो धनञ्जयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2035214, "chapter_id": 1762, "verse_number": "५-७-१७", "content_sanskrit": "तव पूर्वाभिगमनात्पूर्वं चाप्यस्य दर्शनात् ।\nसाहाय्यमुभयोरेव करिष्यामि सुयोधन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2035215, "chapter_id": 1762, "verse_number": "५-७-१८", "content_sanskrit": "प्रवारणं तु बालानां पूर्वं कार्यमिति श्रुतिः।\nतस्मात्प्रवारणं पूर्वमर्हः पार्थो धनञ्जयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2035216, "chapter_id": 1762, "verse_number": "५-७-१९", "content_sanskrit": "मत्संहननतुल्यानां गोपानामर्बुदं महत्।\nनारायणा इति ख्याताः सर्वे संग्रामयोधिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2035217, "chapter_id": 1762, "verse_number": "५-७-२०", "content_sanskrit": "ते वा युधि दुराधर्षा भवन्त्वेकस्य सैनिकाः ।\nअयुध्यमानः संग्रामे न्यस्तशस्त्रोऽहमेकतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2035218, "chapter_id": 1762, "verse_number": "५-७-२१", "content_sanskrit": "आभ्यामन्यतरं पार्थ यत्ते हृद्यतरं मतम्।\nतद्वृणीतां भवानग्रे प्रवार्यस्त्वं हि धर्मतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2035219, "chapter_id": 1762, "verse_number": "५-७-२२", "content_sanskrit": "` एतद्विदित्वा कौन्तेय विचार्य च पुनः पुनः ।\nतान्वा वरय साहाय्ये मां साचिव्येऽथवा पुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2035220, "chapter_id": 1762, "verse_number": "५-७-२३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2035221, "chapter_id": 1762, "verse_number": "५-७-२३", "content_sanskrit": "एवमुक्तस्तु कृष्णेन कुन्तीपुत्रे धनञ्जयः।\nअयुध्यमानं संग्रामे वरयामास केशवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2035222, "chapter_id": 1762, "verse_number": "५-७-२४", "content_sanskrit": "नारायणममिघ्नं कामाज्जातमजं नृषु ।\nसर्वक्षत्रस्य पुरतो देवदानवयोरपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2035223, "chapter_id": 1762, "verse_number": "५-७-२५", "content_sanskrit": "दुर्योधनस्तु तत्सैन्यं सर्वमावरयत्तदा ।\nसहस्राणां महस्रं तु योधानां प्राप्य भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2035224, "chapter_id": 1762, "verse_number": "५-७-२६", "content_sanskrit": "कृष्णं चापहृतं ज्ञात्वा संप्राप परमां मुदम् ।\nदुर्योधनस्तु तत्सैन्यं सर्वमादाय पार्थिवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2035225, "chapter_id": 1762, "verse_number": "५-७-२७", "content_sanskrit": "ततोऽभ्ययाद्भीमबलो रौहिणेयं महाबलम् ।\nसर्वं चागमने हेतुं स तस्मै संन्यवेदयत्।\nप्रत्युवाच ततः शौरिर्धार्तराष्ट्रमिदं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2035226, "chapter_id": 1762, "verse_number": "५-७-२८x", "content_sanskrit": "बलदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2035227, "chapter_id": 1762, "verse_number": "५-७-२८", "content_sanskrit": "विदितं ते नरव्याघ्र सर्वं भवितुमर्हति।\nयन्मयोक्तं विराटस्य पुरा वैवाहिके तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2035228, "chapter_id": 1762, "verse_number": "५-७-२९", "content_sanskrit": "निगृह्योक्तो हृषीकेशस्त्वदर्थं कुरुनन्दन।\nमया संबन्धकं तुल्यमिति राजन्पुनःपुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2035229, "chapter_id": 1762, "verse_number": "५-७-३०", "content_sanskrit": "न च तद्वाक्यमुक्तं वै केशवं प्रत्यपद्यत।\nन चाहमुत्सहे कृष्णं विना स्थातुमपि क्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2035230, "chapter_id": 1762, "verse_number": "५-७-३१", "content_sanskrit": "नाहं सहायः पार्थस्य नापि दुर्योधनस्य वै ।\nइति मे निश्चिता बुद्धिर्वासुदेवमवेक्ष्य ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2035231, "chapter_id": 1762, "verse_number": "५-७-३२", "content_sanskrit": "जातोऽसि भारते वंशे सर्वपार्थिवपूजिते ।\nगच्छ युध्यस्व धर्मेण क्षात्रेण पुरुषर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2035232, "chapter_id": 1762, "verse_number": "५-७-३३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2035233, "chapter_id": 1762, "verse_number": "५-७-३३", "content_sanskrit": "इत्येवमुक्तस्तु तदा परिष्वज्य हलायुधम्।\nकृष्णं चापि महाबाहुमामन्त्र्य भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2035234, "chapter_id": 1762, "verse_number": "५-७-३४", "content_sanskrit": "सोऽभ्ययात्कृतवर्माणं धृतराष्ट्रसुतो नृपः ।\nकृतवर्मा ददौ तस्य सेनामक्षौहिणीं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2035235, "chapter_id": 1762, "verse_number": "५-७-३५", "content_sanskrit": "स तेन सर्वसैन्येन भीमेन कुरुनन्दनः ।\nवृतः परिययौ हृष्टः सुहृदः संप्रहर्षयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2035236, "chapter_id": 1762, "verse_number": "५-७-३६", "content_sanskrit": "ततः पीताम्बरधरो जगत्स्रष्टा जनार्दनः ।\nगते दुर्योधने कृष्णः किरीटिनमथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2035237, "chapter_id": 1762, "verse_number": "५-७-३७", "content_sanskrit": "अयुध्यमानः कां बृद्धिमास्थायाहं वृतस्त्वया ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2035238, "chapter_id": 1762, "verse_number": "५-७-३७x", "content_sanskrit": "अर्जुन उवाच।\nभवान्समर्थस्तान्सर्वान्निहन्तुं नात्र संशयः ।\nनिहन्तुमहमष्येकः समर्थः पुरुषर्षभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2035239, "chapter_id": 1762, "verse_number": "५-७-३८", "content_sanskrit": "भवांस्तु कीर्तिमाँल्लोके तद्यशस्त्वां गमिष्यति।\nयशसां चाहमप्यर्थी तस्मादसि मया वृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2035240, "chapter_id": 1762, "verse_number": "५-७-३९", "content_sanskrit": "सारथ्यं तु त्वया कार्यमिति मे मानसं सदा।\nचिररात्रेप्सितं कामं तद्भवान्कर्तुमर्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2035241, "chapter_id": 1762, "verse_number": "५-७-४०x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2035242, "chapter_id": 1762, "verse_number": "५-७-४०", "content_sanskrit": "उपपन्नमिदं पार्थ यत्स्पर्धसि मया सह।\nसारथ्यं ते करिष्यामि कामः संपद्यतां तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2035243, "chapter_id": 1762, "verse_number": "५-७-४१x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2035244, "chapter_id": 1762, "verse_number": "५-७-४१", "content_sanskrit": "एवं प्रमुदितः पार्थः कुष्णेन सहितस्तदा।\nवृतो दाशार्हप्रवरैः पुनरायाद्युधिष्ठिरम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2035245, "chapter_id": 1762, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि सेनोद्योगपर्वणि सप्तमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]