[{"id": 2013687, "chapter_id": 1282, "verse_number": "२-२३-१", "content_sanskrit": "जनमेजय उवाच।\nकिमर्थं वैरिणावास्तामुभौ तौ कृष्णमागधौ।\nकथं च निर्जितः सङ्ख्ये जरासन्धेन माधवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2013688, "chapter_id": 1282, "verse_number": "२-२३-२", "content_sanskrit": "कश्च कंसो मागधस्य यस्य हेतोः स वैरवान्।\nएतदाचक्ष्व मे सर्वं वैशम्पायन तत्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2013689, "chapter_id": 1282, "verse_number": "२-२३-३x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2013690, "chapter_id": 1282, "verse_number": "२-२३-३", "content_sanskrit": "यादवानामन्ववाये वसुदेवो महामतिः।\nउदपद्यत वार्ष्णेयो ह्युग्रसेनस्य मन्त्रभृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2013691, "chapter_id": 1282, "verse_number": "२-२३-४", "content_sanskrit": "उग्रसेनस्य कंसस्तु बभूव बलवान्सुतः।\nज्येष्ठो बहूनां कौरव्य सर्वशस्त्रविशारदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2013692, "chapter_id": 1282, "verse_number": "२-२३-५", "content_sanskrit": "जरासन्धस्य दुहिता तस्य भार्याऽतिविश्रुता।\nराज्यशुक्लेन दत्ता सा जरासन्धेन धीमता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2013693, "chapter_id": 1282, "verse_number": "२-२३-६", "content_sanskrit": "तदर्थमुग्रसेनस्य मधुरायां सुतस्तदा।\nअभिषिक्तस्तदाऽमात्यैः स वै तीव्रपराक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2013694, "chapter_id": 1282, "verse_number": "२-२३-७", "content_sanskrit": "ऐश्वर्यबलमत्तस्तु स तदा बलमोहितः।\nनिगृह्य पितरं भुङ्क्ते तद्राज्यं मन्त्रिभिः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2013695, "chapter_id": 1282, "verse_number": "२-२३-८", "content_sanskrit": "वसुदेवस्य तत्कृत्यं न शृणोति स मन्दधीः।\nत तेन सह तद्राज्यं धर्मतः पर्यपालयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2013696, "chapter_id": 1282, "verse_number": "२-२३-९", "content_sanskrit": "प्रीतिमान्स तु दैत्येन्द्रो वसुदेवस्य देवकीम्।\nउवाह भार्या स तदा दुहिता देवकस्य या॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2013697, "chapter_id": 1282, "verse_number": "२-२३-१०", "content_sanskrit": "तस्यामुद्वाह्यमानायां रथेन जनमेजय।\nउपारुरोह वार्ष्णेयं कंसो भूमिपतिस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2013698, "chapter_id": 1282, "verse_number": "२-२३-११", "content_sanskrit": "ततोऽन्तरिक्षे वागासीद्देवदूतस्य कस्यचित्।\nवसुदेवश्च शुश्राव तां वाचं पार्थिवश्च सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2013699, "chapter_id": 1282, "verse_number": "२-२३-१२", "content_sanskrit": "यामेतां वहमानोऽद्य कंसोद्वहसि देवकीम्।\nअस्या यश्चाष्टमो गर्भः स ते मृत्युर्भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2013700, "chapter_id": 1282, "verse_number": "२-२३-१३", "content_sanskrit": "सोऽवतीर्य ततो राजा खड्गमुद्धृत्य निर्मलम्।\nइयेष तस्या मूर्धानं छेत्तुं परमदुर्मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2013701, "chapter_id": 1282, "verse_number": "२-२३-१४", "content_sanskrit": "सान्त्वयन्स तदा कंसं हसन्कोधवशानुगम्।\nराजन्ननुनयामास वसुदेवो महामतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2013702, "chapter_id": 1282, "verse_number": "२-२३-१५", "content_sanskrit": "अहिंस्यां प्रमदामाहुः सर्वधर्मेषु पार्थिव।\nअकस्मादबलां नारीं हन्तासीमामनागसीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2013703, "chapter_id": 1282, "verse_number": "२-२३-१६", "content_sanskrit": "यच्च तेऽत्र भयं राजञ्शक्यते बाधितुं त्वया।\nइयं शक्या पालयितुं समयं चैव रक्षितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2013704, "chapter_id": 1282, "verse_number": "२-२३-१७", "content_sanskrit": "अस्यास्त्वमष्टमं गर्भं जातमात्रं महीपते।\nविध्वंसय तदा प्राप्तमेवं परिहृतं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2013705, "chapter_id": 1282, "verse_number": "२-२३-१८", "content_sanskrit": "एवं स राजा कथितो वसुदेवेन भारत।\nतस्य तद्वचनं चके शूरसेनपतिस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2013706, "chapter_id": 1282, "verse_number": "२-२३-१९", "content_sanskrit": "ततस्तस्यां सम्बभूवुः कुमाराः सूर्यवर्चसः।\nजाताञ्चातांस्तु तान्सर्वाञ्जघान मधुरेश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2013707, "chapter_id": 1282, "verse_number": "२-२३-२०", "content_sanskrit": "अथ तस्यां समभवद्बलदेवस्तु सत्तमः।\nयाम्यता मायया तं तु यमो राजा विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2013708, "chapter_id": 1282, "verse_number": "२-२३-२१", "content_sanskrit": "देवक्या गर्भमतुलं रोहिण्या जठरेऽक्षिपत्।\nआकृष्य कर्षणात्सम्यक्सङ्कर्षणं इति स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2013709, "chapter_id": 1282, "verse_number": "२-२३-२२", "content_sanskrit": "बलश्रेष्ठतया तस्य बलदेव इति स्मृतः।\nपुनस्तस्यां समभवदष्टमो मधुमूदनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2013710, "chapter_id": 1282, "verse_number": "२-२३-२३", "content_sanskrit": "तस्य गर्भस्य रक्षां तु स चक्रेऽभ्यधिकं नृपः।\nततः काले रक्षणार्थं वसुदेवस्य तत्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2013711, "chapter_id": 1282, "verse_number": "२-२३-२४", "content_sanskrit": "उग्रः प्रयुक्तः कंसेन सचिवः क्रूरकर्मकृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2013712, "chapter_id": 1282, "verse_number": "२-२३-२५", "content_sanskrit": "जातमात्रं वासुदेवमथाकृष्य पिता ततः।\nउपजह्रे परिक्रीतां सुतां गोपस्य कस्यचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2013713, "chapter_id": 1282, "verse_number": "२-२३-२६", "content_sanskrit": "अमृष्यमाणस्तं शब्दं देवदूतस्य पार्थिवः।\nवासुदेवं महात्मानमर्पयामास गोकुले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2013714, "chapter_id": 1282, "verse_number": "२-२३-२७", "content_sanskrit": "वासुदेवोपि गोपेषु ववृधेऽब्जमिवाम्भसि।\nअज्ञायमानः कंसेन गूढोऽग्निरिव दारुषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2013715, "chapter_id": 1282, "verse_number": "२-२३-२८", "content_sanskrit": "विप्रचके तदा सर्वान्बल्लवान्मधुरेश्वरः।\nवर्धमानो महाबाहुस्तेजोबलसमन्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2013716, "chapter_id": 1282, "verse_number": "२-२३-२९", "content_sanskrit": "ततस्ते क्लिश्यमानास्तु पुण्डरीकाक्षमच्युतम्।\nभयेन कामादपरे गणशः पर्यवारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2013717, "chapter_id": 1282, "verse_number": "२-२३-३०", "content_sanskrit": "स तु लब्ध्वा बलं राजन्नुग्रसेनस्य संमतः।\nवसुदेवात्मजः सर्वैर्भ्रातृभिः सहितं पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2013718, "chapter_id": 1282, "verse_number": "२-२३-३१", "content_sanskrit": "निर्जित्य युधि भोजेन्द्रं हत्वा कंसं महाबलः।\nअभ्यषिञ्चत्ततो राज्य उग्रसेनं विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2013719, "chapter_id": 1282, "verse_number": "२-२३-३२", "content_sanskrit": "ततः श्रुत्वा जरासन्धो माधवेन हतं युधि।\nशूरसेनाधिपं चक्रे कंसपुत्रं तदा नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2013720, "chapter_id": 1282, "verse_number": "२-२३-३३", "content_sanskrit": "ससैन्यं महदुत्थाप्य वासुदेवं तदा नृप।\nअभ्यषिञ्चत्सुतं तत्र सुताया जनमेजय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2013721, "chapter_id": 1282, "verse_number": "२-२३-३४", "content_sanskrit": "उग्रसेनं च वृष्णींश्च महाबलसमन्वितः।\nस तत्र विप्रकुरुते जरासन्धः प्रतापवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2013722, "chapter_id": 1282, "verse_number": "२-२३-३५", "content_sanskrit": "एतद्वैरं कौरवेय जरासन्धस्य माधवे।\nआशासितार्थे राजेन्द्र संरुरोध विनिर्जितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2013723, "chapter_id": 1282, "verse_number": "२-२३-३६", "content_sanskrit": "पार्थिवैस्तैर्नृपतिभिर्यक्ष्यमाणः समृद्धिमान्।\nदेवश्रेष्ठं महादेवं कृत्तिवासं त्रियम्बकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2013724, "chapter_id": 1282, "verse_number": "२-२३-३७", "content_sanskrit": "एतत्सर्वं यथावृत्तं कथितं भरतर्षभ।\nयथा तु स हतो राजा भीमसेनेन तच्छृणु॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2013725, "chapter_id": 1282, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि जरासन्धवधपर्वणि त्रयोर्विंशोऽध्यायः॥ २३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]