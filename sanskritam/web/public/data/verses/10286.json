[{"id": 6000286000, "chapter_id": 10286, "verse_number": null, "content_sanskrit": "अथ नवतितमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000286001, "chapter_id": 10286, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_090/BhP_10.090.001.m4a", "display_order": 2}, {"id": 6000286002, "chapter_id": 10286, "verse_number": "१०-९०-१", "content_sanskrit": "बलभद्रः कुरुश्रेष्ठ भगवान् रथमास्थितः।\nसुहृद्दिदृक्षुरुत्कण्ठः प्रययौ नन्दगोकुलम्॥ १०/९०/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_090/BhP_10.090.002.m4a", "display_order": 3, "topics": [{"text": "बलरामस्य नन्दगोकुलयात्रा", "range": "१–२७"}]}, {"id": 6000286003, "chapter_id": 10286, "verse_number": "१०-९०-२", "content_sanskrit": "परिष्वक्तश्चिरोत्कण्ठैर्गोपैर्गोपीभिरेव च।\nरामोऽभिवाद्य पितरावाशीर्भिरभिनन्दितः॥ १०/९०/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_090/BhP_10.090.003.m4a", "display_order": 4}, {"id": 6000286004, "chapter_id": 10286, "verse_number": "१०-९०-३", "content_sanskrit": "चिरं नः पाहि दाशार्ह सानुगो जगदीश्वर।\nइत्यारोप्याङ्कमालिङ्ग्य नेत्रैः सिषिचतुर्जलैः॥ १०/९०/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_090/BhP_10.090.004.m4a", "display_order": 5}, {"id": 6000286005, "chapter_id": 10286, "verse_number": "१०-९०-४", "content_sanskrit": "गोपवृद्धाश्च विधिवद् यविष्ठैरभिवादितः।\nयथावयो यथासख्यं यथासम्बन्धमात्मनः॥ १०/९०/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_090/BhP_10.090.005.m4a", "display_order": 6}, {"id": 6000286006, "chapter_id": 10286, "verse_number": "१०-९०-५", "content_sanskrit": "समुपेत्याथ गोपाला हास्यहस्तग्रहादिभिः।\nविश्रान्तं सुखमासीनं पप्रच्छुः पर्युपासिताः॥ १०/९०/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_090/BhP_10.090.006.m4a", "display_order": 7}, {"id": 6000286007, "chapter_id": 10286, "verse_number": "१०-९०-६", "content_sanskrit": "पृष्टश्चाकथयत् स्वेषु प्रेमगद्गदया गिरा।\nकृष्णे कमलपत्राक्षे सन्न्यस्ताखिलराधसः॥ १०/९०/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_090/BhP_10.090.007.m4a", "display_order": 8}, {"id": 6000286008, "chapter_id": 10286, "verse_number": "१०-९०-७", "content_sanskrit": "कच्चिन्नो बान्धवा राम सर्वे कुशलमासते।\nकच्चित् स्मरथ नो राम यूयं दारसुतान्विताः॥ १०/९०/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_090/BhP_10.090.008.m4a", "display_order": 9}, {"id": 6000286009, "chapter_id": 10286, "verse_number": "१०-९०-८", "content_sanskrit": "दिष्ट्या कंसो हतः पापो दिष्ट्या मुक्ताः सुहृज्जनाः।\nनिहत्य निर्जित्य रिपून् दिष्ट्या दुर्गं समास्थिताः॥ १०/९०/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_090/BhP_10.090.009.m4a", "display_order": 10}, {"id": 6000286010, "chapter_id": 10286, "verse_number": "१०-९०-९", "content_sanskrit": "गोप्यो हसन्त्यः पप्रच्छू रामसन्दर्शनादृताः।\nकच्चिदास्ते सुखं कृष्णः पुरस्‍त्रीजनवल्लभः॥ १०/९०/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_090/BhP_10.090.010.m4a", "display_order": 11}, {"id": 6000286011, "chapter_id": 10286, "verse_number": "१०-९०-१०", "content_sanskrit": "कच्चित् स्मरति वा बन्धून् पितरं मातरं च सः।\nअपि वा स्मरतेऽस्माकमनुसेवां महाभुजः॥ १०/९०/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_090/BhP_10.090.011.m4a", "display_order": 12}, {"id": 6000286012, "chapter_id": 10286, "verse_number": "१०-९०-११", "content_sanskrit": "मातरं पितरं भ्रातॄन् पतीन् पुत्रान् स्वसॄरपि।\nयदर्थेऽहिन्म दाशार्ह दुस्त्यजान् स्वजनान् प्रभो॥ १०/९०/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_090/BhP_10.090.012.m4a", "display_order": 13}, {"id": 6000286013, "chapter_id": 10286, "verse_number": "१०-९०-१२", "content_sanskrit": "ता नः सद्यः परित्यज्य गतः सञ्छिन्नसौहृदः।\nकथं नु तादृशं स्‍त्रीभिर्न श्रद्धीयेत भाषितम्॥ १०/९०/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_090/BhP_10.090.013.m4a", "display_order": 14}, {"id": 6000286014, "chapter_id": 10286, "verse_number": "१०-९०-१३", "content_sanskrit": "कथं न गृह्णन्त्यनवस्थितात्मनो वचः कृतघ्नस्य मुधा परस्‍त्रियः।\nकृष्णस्य वैचित्रकथस्य सुन्दरस्मितावलोकोच्छ्वसितस्मरातुराः॥ १०/९०/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_090/BhP_10.090.014.m4a", "display_order": 15}, {"id": 6000286015, "chapter_id": 10286, "verse_number": "१०-९०-१४", "content_sanskrit": "किं नस्तत्कथया गोप्यः कथाः कथयतापराः।\nयात्यस्माभिर्विना कालो यदि तस्य तथैव नः॥ १०/९०/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_090/BhP_10.090.015.m4a", "display_order": 16}, {"id": 6000286016, "chapter_id": 10286, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_090/BhP_10.090.016.m4a", "display_order": 17}, {"id": 6000286017, "chapter_id": 10286, "verse_number": "१०-९०-१५", "content_sanskrit": "इति प्रहसितं शौरेर्जल्पितं चानुवीक्षितम्।\nगतिं प्रेमपरिष्वङ्गं स्मरन्त्यो रुरुदुः स्‍त्रियः॥ १०/९०/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_090/BhP_10.090.017.m4a", "display_order": 18}, {"id": 6000286018, "chapter_id": 10286, "verse_number": "१०-९०-१६", "content_sanskrit": "सङ्कर्षणस्ताः कृष्णस्य सन्देशैर्हृदयङ्गमैः।\nसान्त्वयामास भगवान् नानानुनयकोविदः॥ १०/९०/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_090/BhP_10.090.018.m4a", "display_order": 19}, {"id": 6000286019, "chapter_id": 10286, "verse_number": "१०-९०-१७", "content_sanskrit": "द्वौ मासौ तत्र चावात्सीन्मधुं माधवमेव च।\nरामः क्षपासु भगवान् गोपीनां रतिमावहन्॥ १०/९०/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_090/BhP_10.090.019.m4a", "display_order": 20}, {"id": 6000286020, "chapter_id": 10286, "verse_number": "१०-९०-१८", "content_sanskrit": "पूर्णचन्द्रकरामृष्टे कौमुदीगन्धवायुना।\nयमुनोपवने रेमे सेविते स्‍त्रीगणैर्वृतः॥ १०/९०/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_090/BhP_10.090.020.m4a", "display_order": 21}, {"id": 6000286021, "chapter_id": 10286, "verse_number": "१०-९०-२१", "content_sanskrit": "नेदुर्दुन्दुभयो व्योम्नि ववृषुः कुसुमैर्मुदा।\nगन्धर्वा मुनयो रामं तद्वीर्यैरीडिरे मुदा॥ १०/९०/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_090/BhP_10.090.021.m4a", "display_order": 22}, {"id": 6000286022, "chapter_id": 10286, "verse_number": "१०-९०-२२", "content_sanskrit": "उपगीयमानचरितो वनिताभिर्हलायुधः।\nवनेषु व्यचरत् क्षीबो माहेन्द्र इव वारणः॥ १०/९०/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_090/BhP_10.090.022.m4a", "display_order": 23}, {"id": 6000286023, "chapter_id": 10286, "verse_number": "१०-९०-२३", "content_sanskrit": "शुभैककुण्डलो मत्तो वैजयन्त्या च मालया।\nबिभ्रत् स्मितमुखाम्भोजं स्वेदप्रालेयभूषितम्॥ १०/९०/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_090/BhP_10.090.023.m4a", "display_order": 24}, {"id": 6000286024, "chapter_id": 10286, "verse_number": "१०-९०-२४", "content_sanskrit": "स चाजुहाव यमुनां जलक्रीडार्थमीश्वरः।\nनिजवाक्यमनादृत्य मत्त इत्यापगां बलः॥ १०/९०/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_090/BhP_10.090.024.m4a", "display_order": 25}, {"id": 6000286025, "chapter_id": 10286, "verse_number": "१०-९०-२५", "content_sanskrit": "अनागतां हलाग्रेण कुपितो विचकर्ष ह।\nपापे त्वं मामवज्ञाय यन्नायासि मयाऽऽहुता॥ १०/९०/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_090/BhP_10.090.025.m4a", "display_order": 26}, {"id": 6000286026, "chapter_id": 10286, "verse_number": "१०-९०-२६", "content_sanskrit": "नेष्ये त्वां लाङ्गलाग्रेण शतधा कामचारिणीम्।\nएवं निर्भर्त्सिता भीता यमुना यदुनन्दनम्॥ १०/९०/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_090/BhP_10.090.026.m4a", "display_order": 27}, {"id": 6000286027, "chapter_id": 10286, "verse_number": "१०-९०-२७", "content_sanskrit": "उवाच चकिता वाचं पतित्वा पादयोर्नृप॥ १०/९०/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_090/BhP_10.090.027.m4a", "display_order": 28}, {"id": 6000286028, "chapter_id": 10286, "verse_number": null, "content_sanskrit": "यमुनोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_090/BhP_10.090.028.m4a", "display_order": 29}, {"id": 6000286029, "chapter_id": 10286, "verse_number": "१०-९०-२८", "content_sanskrit": "रामराम महाबाहो न जाने तव विक्रमम्।\nयस्यैकांशेन विधृता जगती जगतां पते॥ १०/९०/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_090/BhP_10.090.029.m4a", "display_order": 30, "topics": [{"text": "गोपीभिः क्रीडा यमुनायाः कर्षणं च", "range": "२८–३४"}]}, {"id": 6000286030, "chapter_id": 10286, "verse_number": "१०-९०-२९", "content_sanskrit": "परं भावं भगवतो भगवन् मामजानतीम्।\nमोक्तुमर्हसि विश्वात्मन् प्रपन्नां भक्तवत्सल॥ १०/९०/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_090/BhP_10.090.030.m4a", "display_order": 31}, {"id": 6000286031, "chapter_id": 10286, "verse_number": "१०-९०-३०", "content_sanskrit": "ततो व्यमुञ्चत् करुणो याचितो यमुनां बलः।\nविजगाह जलं स्‍त्रीभिः करेणुभिरिवेभराट्॥ १०/९०/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_090/BhP_10.090.031.m4a", "display_order": 32}, {"id": 6000286032, "chapter_id": 10286, "verse_number": "१०-९०-३१", "content_sanskrit": "कामं विहृत्य सलिलादुत्तीर्णायासिताम्बरे।\nभूषणानि विचित्राणि ददौ कान्तिमतीं स्रजम्॥ १०/९०/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_090/BhP_10.090.032.m4a", "display_order": 33}, {"id": 6000286033, "chapter_id": 10286, "verse_number": "१०-९०-३२", "content_sanskrit": "वसित्वा वाससी नीले मालामाबद्ध्य काञ्चनीम्।\nरेजे स्वलङ्कृतस्ताभिर्माहेन्द्र इव वारणः॥ १०/९०/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_090/BhP_10.090.033.m4a", "display_order": 34}, {"id": 6000286034, "chapter_id": 10286, "verse_number": "१०-९०-३३", "content_sanskrit": "अद्यापि दृश्यते राजन् यमुनाऽऽकृष्टवर्त्मना।\nबलस्यानन्तवीर्यस्य वीर्यं सूचयतीव हि॥ १०/९०/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_090/BhP_10.090.034.m4a", "display_order": 35}, {"id": 6000286035, "chapter_id": 10286, "verse_number": "१०-९०-३४", "content_sanskrit": "एवं सर्वा निशा याता एकेव रमतो व्रजे।\nरामस्याक्षिप्तचित्तस्य माधुर्यैर्व्रजयोषिताम्॥ १०/९०/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_090/BhP_10.090.035.m4a", "display_order": 36}, {"id": 6000286036, "chapter_id": 10286, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्ध उत्तरार्धे नवतितमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]