[{"id": 7003518000, "chapter_id": 23518, "verse_number": "१५८-१", "content_sanskrit": "अथ मथुरातीर्थप्रादुर्भावः ।\nश्रीवराह उवाच ।\nविंशतिर्योजनानां तु माथुरं मम मण्डलम् ।\nयत्रतत्र नरः स्नातो मुच्यते सर्वकिल्बिषैः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003518001, "chapter_id": 23518, "verse_number": "१५८-२", "content_sanskrit": "वर्षाकाले तु स्थातव्यं यच्च स्थानं तु हर्षदम् ।\nपुण्यात्पुण्यतरं चैव माथुरे मम मण्डले ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003518002, "chapter_id": 23518, "verse_number": "१५८-३", "content_sanskrit": "सप्तद्वीपेषु तीर्थानि पुण्यान्यायतनानि च ।\nमथुरायां गमिष्यन्ति प्रसुप्ते तु सदा मयि ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003518003, "chapter_id": 23518, "verse_number": "१५८-४", "content_sanskrit": "सुप्तोत्थितं तु दृष्ट्वा मां मथुरायां वसुन्धरे ।\nते नरा मां प्रपश्यन्ति सर्वकालं न संशयः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003518004, "chapter_id": 23518, "verse_number": "१५८-५", "content_sanskrit": "सुप्तोत्थितं तु वसुधे दृष्ट्वा मे मुखपङ्कजम् ।\nसप्तजन्मकृतं पापं तत्क्षणादेव मुञ्चति ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003518005, "chapter_id": 23518, "verse_number": "१५८-६", "content_sanskrit": "मथुरावासिनो लोकाः सर्वे ते मुक्तिभाजनाः ।\nमथुरां समनुप्राप्य दृष्ट्वा देवं तु केशवम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003518006, "chapter_id": 23518, "verse_number": "१५८-७", "content_sanskrit": "स्नात्वा पुनस्तु कालिन्द्यां मम लोके महीयते ।\nस तत्फलमवाप्नोति राजसूयाश्वमेधयोः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003518007, "chapter_id": 23518, "verse_number": "१५८-८", "content_sanskrit": "प्रदक्षिणीकृतो येन मथुरायां तु केशवः ।\nप्रदक्षिणीकृता तेन सप्तद्वीपा वसुन्धरा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003518008, "chapter_id": 23518, "verse_number": "१५८-९", "content_sanskrit": "घृतपूर्णेन पात्रेण समग्रेण च वाससा ।\nकेशवस्याग्रतो दत्त्वा दीपकं तु वसुन्धरे ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003518009, "chapter_id": 23518, "verse_number": "१५८-१०", "content_sanskrit": "पंचयोजनविस्तारमायामं पंच विस्तरम् ।\nदीपमालासमाकीर्णं विमानं लभते नरः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003518010, "chapter_id": 23518, "verse_number": "१५८-११", "content_sanskrit": "सर्वकामसमृद्धं तदप्सरोगणसेवितम् ।\nरम्यमालासमाकीर्णं भोगाढ्यं सर्वकामिकम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003518011, "chapter_id": 23518, "verse_number": "१५८-१२", "content_sanskrit": "समारोहति वै नित्यं प्रभामण्डलमण्डितम् ।\nये देवा ये च गन्धर्वाः सिद्धाश्चारणपन्नगाः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003518012, "chapter_id": 23518, "verse_number": "१५८-१३", "content_sanskrit": "तं स्पृहन्ति सदा देवि पुण्यमस्ति कृतं भुवि ।\nयदि कालान्तरे पुण्यं हीयतेऽस्य पुरा कृतम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003518013, "chapter_id": 23518, "verse_number": "१५८-१४", "content_sanskrit": "सतां पुण्यगृहे देवि जायते मानवो हि सः ।\nधरण्युवाच ।\nक्षेत्रं हि रक्षते देव कस्त्विदं पापनाशनम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003518014, "chapter_id": 23518, "verse_number": "१५८-१५", "content_sanskrit": "पशुभूतपिशाचैश्च रक्षोभूतविनायकैः ।\nएवमादिभिराकृष्टं तत्क्षेत्रं फलदं भवेत् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003518015, "chapter_id": 23518, "verse_number": "१५८-१६", "content_sanskrit": "श्रीवराह उवाच ।\nमत्क्षेत्रं ते न पश्यन्ति मत्प्रभावात्कदाचन ।\nन विकुर्वन्ति ते दृष्ट्वा मत्पराणां  हि देहिनाम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003518016, "chapter_id": 23518, "verse_number": "१५८-१७", "content_sanskrit": "रक्षार्थं हि मया दत्ता दिक्पालास्तु वरानने ।\nलोकपालास्तु चत्वारस्तीर्थं रक्षन्ति ये सदा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003518017, "chapter_id": 23518, "verse_number": "१५८-१८", "content_sanskrit": "पूर्वां रक्षति इन्द्रस्तु यमो रक्षति दक्षिणाम् ।\nपश्चिमां रक्षते नित्यं वरुणः पाशभृत्स्वयम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003518018, "chapter_id": 23518, "verse_number": "१५८-१९", "content_sanskrit": "उत्तरां वै कुबेरस्तु महाबलपराक्रमः ।\nमध्यं तु रक्षते नित्यं शिवो देव उमापतिः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003518019, "chapter_id": 23518, "verse_number": "१५८-२०", "content_sanskrit": "मथुरायां गृहं यस्तु प्रासादं कुरुते नरः ।\nचतुर्भुजस्तु विज्ञेयो जीवन्मुक्तो न संशयः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003518020, "chapter_id": 23518, "verse_number": "१५८-२१", "content_sanskrit": "मथुराया महाभागे कुण्डे च विमलोदके ।\nगम्भीरे सर्वदा देवि तिष्ठते च चतुर्भुजः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003518021, "chapter_id": 23518, "verse_number": "१५८-२२", "content_sanskrit": "तत्र मुञ्चेत यः प्राणान् स्नानं कृत्वा वसुन्धरे ।\nवैष्णवं लोकमासाद्य क्रीडते स सुखादिव ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003518022, "chapter_id": 23518, "verse_number": "१५८-२३", "content_sanskrit": "तत्रैव तु सदाश्चर्यं कथ्यमानं मया शृणु ।\nयदुच्यते वै सुश्रोणि कुण्डे तु विमलोदके ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003518023, "chapter_id": 23518, "verse_number": "१५८-२४", "content_sanskrit": "हेमन्ते तु भवेच्चोष्णं शीतलं ग्रीष्मके भवेत् ।\nतेजसा मम सुश्रोणि तुषारतदृशोपमम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003518024, "chapter_id": 23518, "verse_number": "१५८-२५", "content_sanskrit": "न वर्द्धते च वर्षासु ग्रीष्मे चापि न हीयते ।\nएतच्च महदाश्चर्यं तस्मिन्कुण्डे परं मम ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003518025, "chapter_id": 23518, "verse_number": "१५८-२६", "content_sanskrit": "पदे पदे तीर्थफलं मथुरायां वसुंधरे ।\nतत्र तत्र नरः स्नातो मुच्यते सर्वपातकैः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003518026, "chapter_id": 23518, "verse_number": "१५८-२७", "content_sanskrit": "वर्षासु स्थूलतीर्थेषु स्नातव्यं तु प्रयत्नतः ।\nकूपे ह्रदे देवखाते गर्तेषु च नदीषु च ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003518027, "chapter_id": 23518, "verse_number": "१५८-२८", "content_sanskrit": "प्रवाहेषु च दिव्येषु नदीनां सङ्मेषु च ।\nवर्षासु सर्वतः स्नायाद्यदीच्छेत्परमां गतिम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003518028, "chapter_id": 23518, "verse_number": "१५८-२९", "content_sanskrit": "अस्ति  क्षेत्रं परं दिव्यं मुचुकुन्दं तु नामतः ।\nमुचुकुंदः स्वपित्यत्र दानवासुरपातनः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003518029, "chapter_id": 23518, "verse_number": "१५८-३०", "content_sanskrit": "तत्र कुण्डे नरः स्नात्वा प्राप्नोत्यभिमतं जलम् ।\nअथात्र मुञ्चते प्राणान्मम लोकं स गच्छति ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003518030, "chapter_id": 23518, "verse_number": "१५८-३१", "content_sanskrit": "27", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003518031, "chapter_id": 23518, "verse_number": "१५८-३२", "content_sanskrit": "इहजन्मकृतं  पापमन्यजन्मकृतं च यत् ।\nशीघ्रं नश्यति तत्सर्वं कीर्त्तनात्केशवस्य तु ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003518032, "chapter_id": 23518, "verse_number": "१५८-३३", "content_sanskrit": "किं तस्य बहुभिर्मंत्रैर्भक्तिर्यस्य जनार्दने।\nनरके पच्यमानस्य गतिर्देवि जनार्दनः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003518033, "chapter_id": 23518, "verse_number": "१५८-३४", "content_sanskrit": "कृत्वा प्रदक्षिणं देवि विश्रामं कुरुते तु यः ।\nनारायणसमीपे तु सोऽनन्तफलमश्नुते ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003518034, "chapter_id": 23518, "verse_number": "१५८-३५", "content_sanskrit": "सुप्तोत्थितं हरिं दृष्ट्वा मथुरायां वसुन्धरे ।\nन तस्य पुनरावृत्तिर्जायते स चतुर्भुजः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003518035, "chapter_id": 23518, "verse_number": "१५८-३६", "content_sanskrit": "कुमुदस्य तु मासस्य नवम्यां तु वसुन्धरे ।\nप्रदक्षिणीकृत्य भुवं सर्वपापैः प्रमुच्यते ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003518036, "chapter_id": 23518, "verse_number": "१५८-३७", "content_sanskrit": "ब्रह्मघ्नश्च सुरापश्च गोघ्नो भग्नव्रतस्तथा ।\nमथुरां तु परिक्रम्य पूतो भवति मानवः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003518037, "chapter_id": 23518, "verse_number": "१५८-३८", "content_sanskrit": "अष्टम्यां प्राप्य मथुरां दन्तधावनपूर्वकम् ।\nब्रह्मचर्येण तां रात्रिं कृतसंकल्पमानसः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003518038, "chapter_id": 23518, "verse_number": "१५८-३९", "content_sanskrit": "धौतवस्त्रस्तु सुस्नातो मौनव्रतपरायणः ।\nप्रदक्षिणं तु कुर्वीत सर्वपातक नाशनम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003518039, "chapter_id": 23518, "verse_number": "१५८-४०", "content_sanskrit": "प्रदक्षिणां प्रकुर्वाणमन्यो यः स्पृशते नरः ।\nसर्वान् कामानवाप्नोति नात्र कार्या विचारणा ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003518040, "chapter_id": 23518, "verse_number": "१५८-४१", "content_sanskrit": "मथुरायां नरो गत्वा दृष्ट्वा देवं स्वयम्भुवम् ।\nप्रदक्षिणायां यत्पुण्यं तत्पुण्यं लभते नरः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003518041, "chapter_id": 23518, "verse_number": "१५८-४२", "content_sanskrit": "देवस्याग्रे तु वसुधे कूपं तु विमलोदकम् ।\nपितरश्चाभिनन्दन्ति पानीयं पिण्डमेव च ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003518042, "chapter_id": 23518, "verse_number": "१५८-४३", "content_sanskrit": "चतुःसामुद्रिकं नाम त्रिषु लोकेषु विश्रुतम् ।\nतत्र स्नातो नरो भद्रे देवैश्च सह मोदते ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003518043, "chapter_id": 23518, "verse_number": "१५८-४४", "content_sanskrit": "तत्राथ मुञ्चते प्राणान्मम लोकं स गच्छति ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]