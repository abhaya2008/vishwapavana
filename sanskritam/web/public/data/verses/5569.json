[{"id": 2213831, "chapter_id": 5569, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2213832, "chapter_id": 5569, "verse_number": "१", "content_sanskrit": "कथं विनष्टा भगवन्नन्धका वृष्णिभिः सह ।\nपश्यतो वासुदेवस्य भोजाश्चैव महारथाः\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2213833, "chapter_id": 5569, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2213834, "chapter_id": 5569, "verse_number": "२", "content_sanskrit": "षट्त्रिंशेऽथ ततो वर्षे वृष्णीनामनयोऽभवत् ।\nअन्योन्यं मौसलैस्ते तु निजघ्नुः कालचोदिताः\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2213835, "chapter_id": 5569, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2213836, "chapter_id": 5569, "verse_number": "३", "content_sanskrit": "केनानुशप्तास्ते वीराः क्षयं वृष्ण्यन्धका गताः ।\nभोजाश्च द्विजवर्य त्वं विस्तरेण वदस्व मे\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2213837, "chapter_id": 5569, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2213838, "chapter_id": 5569, "verse_number": "४", "content_sanskrit": "विश्वामित्रं च कण्वं च नारदं च तपोधनम् ।\nसारणप्रमुखा वीरा ददृशुर्द्वारकां गतान्\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2213839, "chapter_id": 5569, "verse_number": "५", "content_sanskrit": "ते वै साम्बं पुरस्कृत्य भूषयित्वा स्त्रियं यथा ।\nअब्रुवन्नुपसङ्गम्य दैवदण्डनिपीडिताः\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2213840, "chapter_id": 5569, "verse_number": "६", "content_sanskrit": "इयं स्त्री पुत्रकामस्य बभ्रोरमिततेजसः ।\nऋषयः साधु जानीत किमियं जनयिष्यति\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2213841, "chapter_id": 5569, "verse_number": "७", "content_sanskrit": "इत्युक्तास्ते तदा राजन् विप्रलम्भप्रधर्षिताः ।\nप्रत्यब्रुवंस्तान् मुनयो यत्तच्छृणु नराधिप\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2213842, "chapter_id": 5569, "verse_number": "८", "content_sanskrit": "वृष्ण्यन्धकविनाशाय मुसलं घोरमायसम् ।\nवासुदेवस्य दायादः साम्बोऽयं जनयिष्यति\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2213843, "chapter_id": 5569, "verse_number": "९", "content_sanskrit": "येन यूयं सुदुर्वृत्ता नृशंसा जातमन्यवः ।\nउच्छेत्तारः कुलं कृत्स्नमृते रामजनार्दनौ\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2213844, "chapter_id": 5569, "verse_number": "१०", "content_sanskrit": "समुद्रं यास्यति श्रीमांस्त्यक्त्वा देहं हलायुधः ।\nजरः कृष्णं महात्मानं शयानं भुवि वेत्स्यति\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2213845, "chapter_id": 5569, "verse_number": "११", "content_sanskrit": "इत्यब्रुवंस्ततो राजन् प्रलब्धास्तैर्दुरात्मभिः ।\nमुनयः क्रोधरक्ताक्षाः समीक्ष्याथ परस्परम्\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2213846, "chapter_id": 5569, "verse_number": "१२", "content_sanskrit": "तथोक्त्वा मुनयस्ते तु यथागतमथो ययुः\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2213847, "chapter_id": 5569, "verse_number": "१३", "content_sanskrit": "अथाब्रवीत् तदा वृष्णीन् श्रुत्वैतन्मधुसूदनः ।\nअन्तज्ञो मतिमांस्तस्य भवितव्यं तथेति तान्\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2213848, "chapter_id": 5569, "verse_number": "१४", "content_sanskrit": "एवमुक्त्वा हृषीकेशः प्रविवेश पुरं तदा ।\nकृतान्तमन्यथा नैच्छत्कर्तुं स जगतः प्रभुः\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2213849, "chapter_id": 5569, "verse_number": "१५", "content_sanskrit": "श्वोभूतेऽथ ततः साम्बो मुसलं तदसूत वै ।\nयेन वृष्ण्यन्धककुले पुरुषा भस्मसात्कृताः\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2213850, "chapter_id": 5569, "verse_number": "१६", "content_sanskrit": "वृष्ण्यन्धकविनाशाय किङ्करप्रतिमं महत् ।\nअसूत शापजं घोरं तच्च राज्ञे न्यवेदयन्\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2213851, "chapter_id": 5569, "verse_number": "१७", "content_sanskrit": "विषण्णरूपस्तद् राजा सूक्ष्मं चूर्णमकारयत् ।\nतच्चूर्णं सागरे चापि प्राक्षिपन् पुरुषा नृप\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2213852, "chapter_id": 5569, "verse_number": "१८", "content_sanskrit": "अघोषयंश्च नगरे वचनादाहुकस्य ते ।\nजनार्दनस्य रामस्य बभ्रोश्चैव महात्मनः\t ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2213853, "chapter_id": 5569, "verse_number": "१९", "content_sanskrit": "अद्यप्रभृति सर्वेषु वृष्ण्यन्धककुलेष्विह ।\nसुरासवो न कर्तव्यः सर्वैर्नगरवासिभिः\t ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2213854, "chapter_id": 5569, "verse_number": "२०", "content_sanskrit": "यश्च नो विदितं कुर्यात् पेयं कश्चिन्नरः क्वचित् ।\nजीवन् स शूलमारोहेत्स्वयं कृत्वा सबान्धवः\t ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2213855, "chapter_id": 5569, "verse_number": "२१", "content_sanskrit": "ततो राजभयात् सर्वे नियमं चक्रिरे तदा ।\nनराः शासनमाज्ञाय तस्य राज्ञो महात्मनः\t ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2213856, "chapter_id": 5569, "verse_number": "२२", "content_sanskrit": "न कुर्वन्ति निषिद्धं च कर्म वै नृपसत्तम\t ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2213857, "chapter_id": 5569, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् मौसलपर्वणि\nसुरासवनिषेधो नाम द्वितीयोऽध्यायः ॥२॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]