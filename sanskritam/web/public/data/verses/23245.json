[{"id": 7003245000, "chapter_id": 23245, "verse_number": "१-४८-१", "content_sanskrit": "सूत उवाच  ।\nअस्य द्वीपस्य मध्ये तु मेरुर्नाम महागिरिः  ।\nनानारत्नमयैः श्रृंगै स्थितः स्थितिमतां वरः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003245001, "chapter_id": 23245, "verse_number": "१-४८-२", "content_sanskrit": "चतुराशीतिसाहस्रमुत्सेधेन प्रकीर्तितः  ।\nप्रविष्टः षोडशाधस्ताद्विंस्तृतः षोडशैव तु ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003245002, "chapter_id": 23245, "verse_number": "१-४८-३", "content_sanskrit": "शराववत्संस्थितत्वाद्वात्रिंशन्मूर्ध्नि विस्तृतः  ।\nविस्तारात्त्रिगुणश्चास्य परिणाहोनुमंडलः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003245003, "chapter_id": 23245, "verse_number": "१-४८-४", "content_sanskrit": "हैमीकृतो महेशस्य शुभांगस्पर्शनेन च  ।\nधत्तुरपुष्पसंकाशः सर्वदेवनिकेतनः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003245004, "chapter_id": 23245, "verse_number": "१-४८-५", "content_sanskrit": "क्रीडाभूमिश्च देवानामनेकाश्चर्यसंयुतः  ।\nलक्षयोजन आयामस्तस्यैवं तु महागिरेः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003245005, "chapter_id": 23245, "verse_number": "१-४८-६", "content_sanskrit": "ततः षोडशसाहस्रं योजनानि क्षितेरधः  ।\nशेषं चोपरि विप्रेन्दा धरायास्तस्य श्रृंगिणः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003245006, "chapter_id": 23245, "verse_number": "१-४८-७", "content_sanskrit": "मूलायामप्रमाणं तु विस्तारान्मूलतो गिरेः  ।\nऊचुर्विस्तारमस्यैव द्विगुणं मूलतो गिरेः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003245007, "chapter_id": 23245, "verse_number": "१-४८-८", "content_sanskrit": "पूर्वतः पद्मरागाभो दक्षिणे हेमसन्निभः  ।\nपश्चिमे नलिसंकाश उत्तरे विद्रुमप्रभः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003245008, "chapter_id": 23245, "verse_number": "१-४८-९", "content_sanskrit": "अमरावती पूर्वभागे नानाप्रासादसंकुला  ।\nनानादेवगणैः कीर्णा मणिजालसमावृता ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003245009, "chapter_id": 23245, "verse_number": "१-४८-१०", "content_sanskrit": "गोपुरैर्विविधाकारैर्हेमरत्नविभूषितैः  ।\nतोरणैर्हेमचित्रैस्तु मणिक्लृप्तैः पथि स्थितैः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003245010, "chapter_id": 23245, "verse_number": "१-४८-११", "content_sanskrit": "सँल्लापालापकुशलैः सर्वाभरणभूषितैः  ।\nस्तनभारविनम्रैश्च मदघूर्णितलोचनैः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003245011, "chapter_id": 23245, "verse_number": "१-४८-१२", "content_sanskrit": "स्त्रीसहस्रैः समाकीर्णा चाप्सरोभिः समंततः  ।\nदीर्घिकाभिर्विचित्राभिः फुल्लांभोरुहसंकुलैः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003245012, "chapter_id": 23245, "verse_number": "१-४८-१३", "content_sanskrit": "हेमसोपानसंयुक्तैर्हेमसैकतराशिभिः  ।\nनीलोत्पलैश्चोत्पलैश्च हैमैश्चापि सुगंधिभिः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003245013, "chapter_id": 23245, "verse_number": "१-४८-१४", "content_sanskrit": "एवंविधैस्तटाकैश्च नदीभिश्च नदैर्युता  ।\nविराजते पुरी शुभ्रा तयासौ पर्वतः शुभः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003245014, "chapter_id": 23245, "verse_number": "१-४८-१५", "content_sanskrit": "तेजस्विनी नामपुरी आग्नेय्यां पावकस्य तु  ।\nअमरावतीसमा दिव्या सर्वभोगसमन्विता ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003245015, "chapter_id": 23245, "verse_number": "१-४८-१६", "content_sanskrit": "वैवस्वती दक्षिणे तु यमस्य यमिनां वराः  ।\nभवनैरावृता दिव्यैर्जांबूनदमयैः शुभैः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003245016, "chapter_id": 23245, "verse_number": "१-४८-१७", "content_sanskrit": "नैर्ऋते कृष्णवर्णा च तथा शुद्धवती शुभा  ।\nतादृशी गंधवंती च वायव्यां दिशि शोभना ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003245017, "chapter_id": 23245, "verse_number": "१-४८-१८", "content_sanskrit": "महोदया चोत्तरे च एशान्यां तु यशोवती  ।\nपर्वतस्य दिगंतेषु शोभते दिवि सर्वदा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003245018, "chapter_id": 23245, "verse_number": "१-४८-१९", "content_sanskrit": "ब्रह्मविष्णुमहेशानां तथान्योषां निकेतनम्  ।\nसर्वभोगयुतं पुण्यं दीर्घिकाभिर्नगोत्तमम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003245019, "chapter_id": 23245, "verse_number": "१-४८-२०", "content_sanskrit": "सिद्धैर्यक्षैस्तु संपूर्णं गंधर्वैर्मुनिपुंगवैः  ।\nतथान्यैर्विविधाकारैर्भूतसंघैश्चतुर्विधैः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003245020, "chapter_id": 23245, "verse_number": "१-४८-२१", "content_sanskrit": "गिरेरुपरि विप्रेन्द्राः शुद्धस्फटिकसन्निभम्  ।\nसहस्रभौमं विस्तीर्णं विमानं वामनः स्थितम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003245021, "chapter_id": 23245, "verse_number": "१-४८-२२", "content_sanskrit": "तस्मिन्महाभुजः शर्वः सोमसूर्याग्निलोचनः  ।\nसिंहासने मणिमये देव्यास्ते षण्मुखेन च ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003245022, "chapter_id": 23245, "verse_number": "१-४८-२३", "content_sanskrit": "हरेस्तदर्धं विस्तीर्णं विमानं तत्र सोपि च  ।\nपद्मरागमयं दिव्यं पद्मजस्य च दक्षिणे ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003245023, "chapter_id": 23245, "verse_number": "१-४८-२४", "content_sanskrit": "तस्मिन् शक्रस्य विपुलं पुरं रम्यं यमस्य च  ।\nसोमस्य वरुणस्याथ निर्ऋतेः पावकस्य च ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003245024, "chapter_id": 23245, "verse_number": "१-४८-२५", "content_sanskrit": "वायोश्चैव तु रुद्रस्य शर्वालयसमन्ततः  ।\nतेषां तेषां विमानेषु दिव्येषु विविधेषु च ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003245025, "chapter_id": 23245, "verse_number": "१-४८-२६", "content_sanskrit": "ईशान्यामीश्वरक्षेत्रे नित्यार्चा च व्यवस्थिता  ।\nसिद्धेश्वरैश्च भगवांच्छैलादिः शिष्य संमतः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003245026, "chapter_id": 23245, "verse_number": "१-४८-२७", "content_sanskrit": "सनत्कुमारः सिद्धैस्तु सुखासीनः सुरेश्वरः  ।\nसनकश्च सनंदश्च सदृशाश्च सहस्रशः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003245027, "chapter_id": 23245, "verse_number": "१-४८-२८", "content_sanskrit": "योगभूमिः क्वचित्तस्मिन् भोगभूमिः क्वचित्क्वचित्  ।\nबालसूर्यप्रतीकाशं विमानं तत्र शोभनम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003245028, "chapter_id": 23245, "verse_number": "१-४८-२९", "content_sanskrit": "शैलादिनः शुभं चास्ति तस्मिन्नास्ते गणेश्वरः  ।\nषण्मुखस्य गणेशस्य गणानां तु सहस्रशः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003245029, "chapter_id": 23245, "verse_number": "१-४८-३०", "content_sanskrit": "सुयशायाः सुनेत्रायाः मातॄणां मदनस्य च  ।\nतस्य जंबूनदी नाम मूलमावेष्ट्य संस्थिता ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003245030, "chapter_id": 23245, "verse_number": "१-४८-३१", "content_sanskrit": "तस्य दक्षिणपार्श्वे तु जंबूवृक्षः सुशोभनः  ।\nअत्युच्छ्रितः सुविस्तीर्णः सर्वकालफलप्रदः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003245031, "chapter_id": 23245, "verse_number": "१-४८-३२", "content_sanskrit": "मेरोः समंताद्विस्तीर्णं शुभं वर्षमिलावृतम्  ।\nतत्र जंबूफलाहाराः केचिच्चामृतभोजनाः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003245032, "chapter_id": 23245, "verse_number": "१-४८-३३", "content_sanskrit": "जांबूनदसमप्रख्या नानावर्णाश्च भोगिनः  ।\nमेरुपादाश्रितो विप्रा द्वीपोयं मध्यमः शुभः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003245033, "chapter_id": 23245, "verse_number": "१-४८-३४", "content_sanskrit": "नववर्षान्वितश्चैव नदीनदगीरिश्वरैः  ।\nनववर्षं तु वक्ष्यामि जंबूद्वीपं यतातथम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003245034, "chapter_id": 23245, "verse_number": "१-४८-३५", "content_sanskrit": "विस्तारान्मंडलाच्चैव योजनैश्च निबोधत ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]