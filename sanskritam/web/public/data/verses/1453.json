[{"id": 2021863, "chapter_id": 1453, "verse_number": "३-९१-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2021864, "chapter_id": 1453, "verse_number": "३-९१-१", "content_sanskrit": "ततः प्रयान्तं कौन्तेयं ब्राह्मणा वनवासिनः।\nअभिगम्य तदा राजन्निदं वचनमब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2021865, "chapter_id": 1453, "verse_number": "३-९१-२", "content_sanskrit": "राजंस्तीर्थानि गन्तासि पुण्यानि भ्रातृभिः सह।\nदेवर्षिणा च सहितो लोमशेन महात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2021866, "chapter_id": 1453, "verse_number": "३-९१-३", "content_sanskrit": "अस्मानपि महाराज नेतुमर्हसि पाण्डव।\nअस्माभिर्हि न शक्यानि त्वदृते तानि कौरव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2021867, "chapter_id": 1453, "verse_number": "३-९१-४", "content_sanskrit": "श्वापरदैरुपसृष्टानि दुर्गाणि विषमाणि च।\nअगम्यानि नरैरल्पैस्तीर्थानि मनुजेश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2021868, "chapter_id": 1453, "verse_number": "३-९१-५", "content_sanskrit": "भवतो भ्रातरः शूरा धनुर्धरवराः सदा।\nभवद्भिः पालिताः शूरैर्गच्छामो वयमप्युत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2021869, "chapter_id": 1453, "verse_number": "३-९१-६", "content_sanskrit": "भवत्प्रसादाद्धि वयं प्राप्नुयामः सुखं फलम्।\nतीर्थानां पृथिवीपाल वनानां च विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2021870, "chapter_id": 1453, "verse_number": "३-९१-७", "content_sanskrit": "तव वीर्यपरित्राताः शुद्धास्तीर्थपरिप्लताः।\nभवेम धूतपाप्मानस्तीर्थसंदर्शनान्नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2021871, "chapter_id": 1453, "verse_number": "३-९१-८", "content_sanskrit": "भवानपि नरेन्द्रस्य कार्तवीर्यस्य भारत।\nअष्टकस्य च राजर्षेर्लोमपादस् चैव ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2021872, "chapter_id": 1453, "verse_number": "३-९१-९", "content_sanskrit": "भरतस्य च वीरस्य सार्वभौमस्य पार्तिव।\nध्रुवं प्राप्स्यति दुष्प्रापाँल्लोकांस्तीर्थपरिप्लुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2021873, "chapter_id": 1453, "verse_number": "३-९१-१०", "content_sanskrit": "प्रभासादीनि तीर्थानि महेन्द्रादींश्च पर्वतान्।\nगङ्गाद्याः सरितश्चैव प्लक्षादींश्च पर्वतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2021874, "chapter_id": 1453, "verse_number": "३-९१-११", "content_sanskrit": "त्वया सह महीपाल द्रष्टुमिच्छामहे वयम्।\n`भवद्भिः पालिताः शूरैस्तीर्थान्यायतनानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2021875, "chapter_id": 1453, "verse_number": "३-९१-१२", "content_sanskrit": "यदि ते ब्राह्मणेष्वस्ति काचित्प्रीतिर्जनाधिप।\nकुरुक्षिप्रं वचोऽस्माकं ततः श्रेयोऽभिपत्स्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2021876, "chapter_id": 1453, "verse_number": "३-९१-१३", "content_sanskrit": "तीर्तानि हि महाबाहो तपोविघ्नकरैः सदा।\nअनुकीर्णानि रक्षोभिस्तेभ्यो नस्त्रातुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2021877, "chapter_id": 1453, "verse_number": "३-९१-१४", "content_sanskrit": "तीर्थान्युक्तानि धौम्येन नारदेन च धीमता।\nयान्युवाच च देवर्षिर्लोमशः सुमहातपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2021878, "chapter_id": 1453, "verse_number": "३-९१-१५", "content_sanskrit": "विधिवत्तानि सर्वाणि पर्यटस्व नराधिप।\nधूतपाप्मा सहास्माभिर्लोमशेनाबिपालितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2021879, "chapter_id": 1453, "verse_number": "३-९१-१६", "content_sanskrit": "स राजा पूज्यमानस्तैर्हर्षादश्रुपरिप्लुतः।\nभीमसेनादिभिर्वीरैर्भ्रातृभिः परिवारितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2021880, "chapter_id": 1453, "verse_number": "३-९१-१७", "content_sanskrit": "बाढमित्यब्रवीत्सर्वांस्तानृषीन्पाण्डवर्षभः।\nलोमशं समनुज्ञाप्य धौम्यं चैव पुरोहितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2021881, "chapter_id": 1453, "verse_number": "३-९१-१८", "content_sanskrit": "ततः स पाण्डवश्रेष्ठो भ्रातृभिः सहितो वशी।\nद्रौपद्या चानवद्याङ्ग्या गमनाय मनो दधे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2021882, "chapter_id": 1453, "verse_number": "३-९१-१९", "content_sanskrit": "अथ व्यासो महाभागस्तथा पर्वतनारदौ।\nदाम्यके पाण्डवंद्रष्टुं समाजग्मुर्मनीषिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2021883, "chapter_id": 1453, "verse_number": "३-९१-२०", "content_sanskrit": "तेषां युधिष्ठिरो राजा पूजां चक्रे यथाविधि।\nसत्कृतास्ते महाभागा युधिष्ठिरमथाब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2021884, "chapter_id": 1453, "verse_number": "३-९१-२१", "content_sanskrit": "युधिष्ठिरयमौ भीम मनसा कुरुतार्जवम्।\nमनसा कृतशौचा वै शद्धास्तीर्थानि यास्यथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2021885, "chapter_id": 1453, "verse_number": "३-९१-२२", "content_sanskrit": "शरीरनियमं प्राहुर्ब्राह्मणा मानुषं व्रतम्।\nमनोविशुद्धां बुद्धिं च दैवमाहुर्व्रतं द्विजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2021886, "chapter_id": 1453, "verse_number": "३-९१-२३", "content_sanskrit": "मनो ह्यदुष्टं शौचाय पर्याप्तं वै नराधिप।\nमैत्रीं बुद्धिं समास्थाय शुद्धास्तीर्थानि गच्छत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2021887, "chapter_id": 1453, "verse_number": "३-९१-२४", "content_sanskrit": "ते यूयं मानसैः शुद्धाः शरीरनियमव्रतैः।\nदैवं व्रतं समास्थाय यथोक्तं फलमाप्स्यथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2021888, "chapter_id": 1453, "verse_number": "३-९१-२५", "content_sanskrit": "ते तथेति प्रतिज्ञाय कृष्णया सह पाण्डवाः।\nकृतस्वस्त्ययनाः सर्वे मुनिभिर्देवमानुषैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2021889, "chapter_id": 1453, "verse_number": "३-९१-२६", "content_sanskrit": "लोमशस्योपसंगृह्य पादौ द्वैपायनस् च।\nनारदस्य च राजेन्द्र देवर्षेः पर्वतस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2021890, "chapter_id": 1453, "verse_number": "३-९१-२७", "content_sanskrit": "धौम्येन सहिता वीरास्तथा तैर्वनवासिभिः।\nमार्गशीर्ष्यामतीतायां पुष्येण प्रययुस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2021891, "chapter_id": 1453, "verse_number": "३-९१-२८", "content_sanskrit": "कठिनानि समादाय चीराजिनजटाधराः।\nअभेद्यैः कवचैर्युक्तास्तीर्थान्यन्वचरंस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2021892, "chapter_id": 1453, "verse_number": "३-९१-२९", "content_sanskrit": "इन्द्रसेनादिभिर्भृत्यै रथैः परिचतुर्दशैः।\nमहानसव्यापृतैश्च तथाऽन्यैः परिचारकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2021893, "chapter_id": 1453, "verse_number": "३-९१-३०", "content_sanskrit": "सायुधा बद्धनिस्त्रिंशास्तूणवन्तः समार्गणाः।\nप्राङ्युखाः प्रययुर्वीराः पाण्डवा जनमेजय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2021894, "chapter_id": 1453, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्थयात्रापर्वणि एकनवतितमोऽध्यायः ॥ ९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]