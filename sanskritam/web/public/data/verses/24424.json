[{"id": 7004424000, "chapter_id": 24424, "verse_number": "५-३-११८-१", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nततो गच्छेत्तु राजेन्द्र तीर्थं परमशोभनम् ।\nइन्द्रतीर्थेतिविख्यातं नर्मदादक्षिणे तटे॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004424001, "chapter_id": 24424, "verse_number": "५-३-११८-२", "content_sanskrit": "युधिष्ठिर उवाच ।\nनर्मदादक्षिणे कूले इन्द्रतीर्थं कथं भवेत् ।\nश्रोतुमिच्छामि विप्रेन्द्र ह्यादिमध्यान्तविस्तरैः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004424002, "chapter_id": 24424, "verse_number": "५-३-११८-३", "content_sanskrit": "एतच्छ्रुत्वा तु वचनं धर्मपुत्रस्य धीमतः ।\nकथयामास तद्वत्तमितिहासं पुरातनम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004424003, "chapter_id": 24424, "verse_number": "५-३-११८-४", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nविश्वासयित्वा सुचिरं धर्मशत्रुं महाबलम् ।\nवृत्रं जित्वाथ हत्वा तु गच्छमानं शचीपतिम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004424004, "chapter_id": 24424, "verse_number": "५-३-११८-५", "content_sanskrit": "निष्क्राममाणं मार्गेण ब्रह्महत्या दुरासदा ।\nअहोरात्रमविश्रान्ता जगाम भुवनत्रयम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004424005, "chapter_id": 24424, "verse_number": "५-३-११८-६", "content_sanskrit": "यतोयतो ब्रह्महणं याति यानेन शोभनम् ।\nदिशो भागं सुरैः सार्द्धं ततो हत्या न मुञ्चति॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004424006, "chapter_id": 24424, "verse_number": "५-३-११८-७", "content_sanskrit": "ब्रह्महत्या सुरापानं स्तेयं गुर्वगनागमः ।\nपातकानां गतिर्दृष्टा न तु विश्वासघातिनाम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004424007, "chapter_id": 24424, "verse_number": "५-३-११८-८", "content_sanskrit": "पापकर्ममुखं दृष्ट्वा स्नानदानैर्विशुध्यति ।\nनारी वा पुरुषो वापि नैव विश्वासघातिनः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004424008, "chapter_id": 24424, "verse_number": "५-३-११८-९", "content_sanskrit": "एवमादीनि चान्यानि श्रुत्वा वाक्यानि देवराट् ।\nवचनं तद्विधैरुक्तं विषादमगमत्परम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004424009, "chapter_id": 24424, "verse_number": "५-३-११८-१०", "content_sanskrit": "त्यक्त्वा राज्यं सुरैः सार्धं जगाम तप उत्तमम् ।\nपुत्रदारगृहं राज्यं वसूनि विविधानि च॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004424010, "chapter_id": 24424, "verse_number": "५-३-११८-११", "content_sanskrit": "फलान्येतानि धर्मस्य शोभयन्ति जनेश्वरम् ।\nफलं धर्मस्य भुञ्जेति सुहृत्स्वजनबान्धवाः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004424011, "chapter_id": 24424, "verse_number": "५-३-११८-१२", "content_sanskrit": "पश्यतां सर्वमेतेषां पापमेकेन भुज्यते ।\nपरं हि सुखमुत्सृज्य कर्शयन्वै कलेवरम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004424012, "chapter_id": 24424, "verse_number": "५-३-११८-१३", "content_sanskrit": "देवराजो जगामासौ तीर्थान्यायतनानि च ।\nगङ्गातीर्थेषु सर्वेषु यामुनेषु तथैव च॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004424013, "chapter_id": 24424, "verse_number": "५-३-११८-१४", "content_sanskrit": "सारस्वतेषु सर्वेषु सामुद्रेषु पृथक्पृथक् ।\nनदीषु देवखातेषु तडागेषु सरःसु च॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004424014, "chapter_id": 24424, "verse_number": "५-३-११८-१५", "content_sanskrit": "पापं न मुञ्चते सर्वे पश्चाद्देवसमागमे ।\nरेवाप्रभवतीर्थेषु कूलयोरुभयोरपि॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004424015, "chapter_id": 24424, "verse_number": "५-३-११८-१६", "content_sanskrit": "पूजयन्वै महादेवं स्कन्दतीर्थं समासदत् ।\nतव स्थित्वोपवासैश्च कृच्छ्रचान्द्रायणादिभिः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004424016, "chapter_id": 24424, "verse_number": "५-३-११८-१७", "content_sanskrit": "कर्शयन्वै स्वकं देहं न लेभे शर्म वै क्वचित् ।\nग्रीष्मे पञ्चाग्निमध्यस्थो वर्षासु स्थण्डिलेशयः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004424017, "chapter_id": 24424, "verse_number": "५-३-११८-१८", "content_sanskrit": "आर्द्रवासास्तु हेमन्ते चचार विपुलं तपः ।\nएवं तु तपतस्तस्य इन्द्रस्य विदितात्मनः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004424018, "chapter_id": 24424, "verse_number": "५-३-११८-१९", "content_sanskrit": "वत्सराणां सहस्राणि गतानि दश भारत ।\nततस्त्वेकादशे प्राप्ते वर्षे तु नृपसत्तम॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004424019, "chapter_id": 24424, "verse_number": "५-३-११८-२०", "content_sanskrit": "सहसा भगवान्देवस्तु तुतोष परमेश्वरः ।\nतथा ब्रह्मर्षयः सिद्धा ब्रह्मविष्णुपुरोगमाः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004424020, "chapter_id": 24424, "verse_number": "५-३-११८-२१", "content_sanskrit": "तत्राजग्मुः सुराः सर्वे यत्र देवः शतक्रतुः ।\nदृष्ट्वा समागतान् देवानृषींश्चैव महामतिः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004424021, "chapter_id": 24424, "verse_number": "५-३-११८-२२", "content_sanskrit": "उवाच प्रणतो भूत्वा सर्वदेवपुरोहितः ।\nविदितं सर्वमेतेषां यथा वृत्रवधः कृतः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004424022, "chapter_id": 24424, "verse_number": "५-३-११८-२३", "content_sanskrit": "युष्माकं चाज्ञया पूर्वं ब्रह्मविष्णुमहेश्वराः ।\nतथाप्येवं ब्रह्महणं मत्वा पापस्य कारिणम्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004424023, "chapter_id": 24424, "verse_number": "५-३-११८-२४", "content_sanskrit": "भ्रमन्तं सर्वतीर्थेषु ब्रह्महत्या न मुञ्चति ।\nन नन्दति जगत्सर्वं त्रैलोक्यं सचराचरम्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004424024, "chapter_id": 24424, "verse_number": "५-३-११८-२५", "content_sanskrit": "यथा विहीनचन्द्रार्कं तथा राज्यमनायकम् ।\nतस्मात्सर्वे सुरश्रेष्ठा विज्ञाप्यं मम सम्प्रति॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004424025, "chapter_id": 24424, "verse_number": "५-३-११८-२६", "content_sanskrit": "कुर्वन्तु शक्रं निर्दोषं तथा सर्वे महर्षयः ।\nबृहस्पतिमुखोद्गीर्णं श्रुत्वा तद्वचनं शुभम्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004424026, "chapter_id": 24424, "verse_number": "५-३-११८-२७", "content_sanskrit": "ततः प्रोवाच भगवान्ब्रह्मा लोकपितामहः ।\nएतत्पापं महाघोरं ब्रह्महत्यासमुद्भवम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004424027, "chapter_id": 24424, "verse_number": "५-३-११८-२८", "content_sanskrit": "दैवतेभ्योऽथ भूतेभ्यश्चतुर्भागं क्षिपाम्यहम् ।\nएवं मुक्त्वा क्षिपच्चैनो जलोपरि महामतिः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004424028, "chapter_id": 24424, "verse_number": "५-३-११८-२९", "content_sanskrit": "अवगाह्य ततः पेया आपो वै नान्यथा बुधैः ।\nधरायामक्षिपद्भागं द्वितीयं पद्मसंभवः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004424029, "chapter_id": 24424, "verse_number": "५-३-११८-३०", "content_sanskrit": "अभक्ष्या तेन संजाता सदाकालं वसुंधरा ।\nतदार्धमर्द्धं नारीणां द्वितीयेऽह्नि युधिष्ठिर॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004424030, "chapter_id": 24424, "verse_number": "५-३-११८-३१", "content_sanskrit": "निक्षिप्य भगवान्देवः पुनरन्यज्जगाद ह ।\nअसंग्राह्या त्वसंग्राह्या तेन जाता रजस्वला॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004424031, "chapter_id": 24424, "verse_number": "५-३-११८-३२", "content_sanskrit": "चतुर्दिनानि सा प्राज्ञैः पापस्य महतो महात् ।\nचतुर्थं तु ततो भागं विभज्य परमेश्वरः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004424032, "chapter_id": 24424, "verse_number": "५-३-११८-३३", "content_sanskrit": "कृषिगोरक्ष्यवाणिज्यैः शूद्रसेवाकरे द्विजे ।\nततोऽभिनन्दयामासुः सर्वे देवा महर्षयः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004424033, "chapter_id": 24424, "verse_number": "५-३-११८-३४", "content_sanskrit": "देवेन्द्रं वाग्भिरिष्टाभिर्नर्मदाजलसंस्थितम् ।\nवरेण छन्दयामास ततस्तुष्टो महेश्वरः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004424034, "chapter_id": 24424, "verse_number": "५-३-११८-३५", "content_sanskrit": "वरं दास्यामि देवेश वरं वृणु यथेप्सितम्॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004424035, "chapter_id": 24424, "verse_number": "५-३-११८-३६", "content_sanskrit": "इन्द्र उवाच ।\nयदि तुष्टोऽसि देवेश यदि देयो वरो मम ।\nअत्र संस्थापयिष्यामि सदा संनिहितो भव॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004424036, "chapter_id": 24424, "verse_number": "५-३-११८-३७", "content_sanskrit": "एवमस्त्विति चोक्त्वा तं ब्रह्मविष्णुमहेश्वराः ।\nजग्मुराकाशमाविश्य स्तूयमाना महर्षिभिः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004424037, "chapter_id": 24424, "verse_number": "५-३-११८-३८", "content_sanskrit": "गतेषु देवदेवेषु देवराजः शतक्रतुः ।\nस्थापयित्वा महादेवं जगाम त्रिदशालयम्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004424038, "chapter_id": 24424, "verse_number": "५-३-११८-३९", "content_sanskrit": "इन्द्रतीर्थे तु यः स्नात्वा तर्पयेत्पितृदेवताः ।\nमहापातकयुक्तोऽपि मुच्यते सर्वपातकैः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004424039, "chapter_id": 24424, "verse_number": "५-३-११८-४०", "content_sanskrit": "इन्द्रतीर्थे तु यः स्नात्वा पूजयेत्परमेश्वरम् ।\nसोऽश्वमेधस्य यज्ञस्य पुष्कलं फलमश्नुते॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004424040, "chapter_id": 24424, "verse_number": "५-३-११८-४१", "content_sanskrit": "एतत्ते कथितं सर्वं तीर्थमाहात्म्यमुत्तमम् ।\nश्रुतमात्रेण येनैव मुच्यन्ते पातकैर्नराः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]