[{"id": 2117457, "chapter_id": 3530, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2117458, "chapter_id": 3530, "verse_number": "१", "content_sanskrit": "दुर्योधनस्य महिषी काशिराजसुता तदा ।\nधृतराष्ट्रस्य पुत्राणां वधूभिः सहिता तदा \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2117459, "chapter_id": 3530, "verse_number": "२", "content_sanskrit": "पाञ्चालीं प्रतिजग्राह द्रौपदीं श्रीमिवापराम् ।\nपूजयामास पूजार्हां शचीदेवीमिवागताम् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2117460, "chapter_id": 3530, "verse_number": "३", "content_sanskrit": "ववन्दे तत्र गान्धारीं माधवी कृष्णया सह ।\nआशिषश्च प्रयुक्त्वा तु द्रौपदीं परिषस्वजे \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2117461, "chapter_id": 3530, "verse_number": "४", "content_sanskrit": "परिष्वज्य च गान्धारी कृष्णां कमललोचनाम् ।\nपुत्राणां मम पाञ्चाली मृत्युरेवेत्यमन्यत \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2117462, "chapter_id": 3530, "verse_number": "५", "content_sanskrit": "सा चिन्त्य विदुरं प्राह युक्तितः सुबलात्मजा ।\nकुन्ती राजसुता क्षत्तः सवधूः सपरिच्छदा \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2117463, "chapter_id": 3530, "verse_number": "६", "content_sanskrit": "पाण्डोर्निवेशनं शीघ्रं नीयतां यदि रोचते ।\nकरणेन मुहूर्तेन नक्षत्रेण तिथौ शुभे ।\nयथा गृहागता कुन्ती रंस्यते स्वसुतैः सुखम् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2117464, "chapter_id": 3530, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2117465, "chapter_id": 3530, "verse_number": "७", "content_sanskrit": "तथेत्येव तदा क्षत्ता कारयामास तत् तदा ।\nपूजयामासुरत्यर्थं बान्धवाः पाण्डवांस्तदा \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2117466, "chapter_id": 3530, "verse_number": "८", "content_sanskrit": "श्रेणिमुख्याश्च नागराः पूजयन्ति स्म पाण्डवान् ।\nभीष्मो द्रोणस्तथा कर्णो बाह्लीकः ससुतस्तदा\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2117467, "chapter_id": 3530, "verse_number": "९", "content_sanskrit": "शासनाद् धृतराष्ट्रस्य अकुर्वन्नतिथिक्रियाम् ।\nएवं विहरतां तेषां पाण्डवानां महात्मनाम् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2117468, "chapter_id": 3530, "verse_number": "१०", "content_sanskrit": "नेता सर्वस्य कार्यस्य विदुरो राजशासनात् ।\nविश्रन्तास्ते महात्मानः कञ्चित् कालं सुखोषिताः ।\nआहूता धृतराष्ट्रेण राज्ञा शान्तनवेन च \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2117469, "chapter_id": 3530, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2117470, "chapter_id": 3530, "verse_number": "११", "content_sanskrit": "भ्रातृभिः सह कौन्तेय निबोध त्वं वचो मम ।\nपाण्डुना वर्धितं राज्यं पाण्डुना पालितं जगत् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2117471, "chapter_id": 3530, "verse_number": "१२", "content_sanskrit": "शासनान्मम कौन्तेय भ्राता मम महाबलः ।\nकृतवान् दुष्करं कर्म नित्यमेव विशाम्पते \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2117472, "chapter_id": 3530, "verse_number": "१३", "content_sanskrit": "तस्मात् त्वमपि कौन्तेय शासनं कुरु माचिरम् ।\nमम पुत्रा दुरात्मानो दर्पाहङ्कारसंयुताः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2117473, "chapter_id": 3530, "verse_number": "१४", "content_sanskrit": "शासनं न करिष्यन्ति मम नित्यं युधिष्टिर ।\nस्वकार्यनिरतैर्नित्यमवलिप्तैर्दुरात्मभिः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2117474, "chapter_id": 3530, "verse_number": "१५", "content_sanskrit": "पुनर्वै विग्रहो मा भूत् खाण्डवप्रस्थमाविश ।\nन च वो वसतस्तत्र कश्चिच्छक्तः प्रबाधितुम् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2117475, "chapter_id": 3530, "verse_number": "१६", "content_sanskrit": "संरक्ष्यमाणान् पार्थेन त्रिदशानिव वज्रिणा ।\nअर्धराज्यं तु सम्प्राप्य खाण्डवप्रस्थमाविश ।\nकेशवो यदि मन्येत तत् कर्तव्यमसंशयम् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2117476, "chapter_id": 3530, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2117477, "chapter_id": 3530, "verse_number": "१७", "content_sanskrit": "प्रतिगृह्य तु ते वाक्यं नृपं सर्वे प्रणम्य च ।\nवासुदेवेन सम्मन्त्र्य पाण्डवाः समुपाविशन् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2117478, "chapter_id": 3530, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2117479, "chapter_id": 3530, "verse_number": "१८", "content_sanskrit": "अभिषेकस्य सम्भारान् क्षत्तरानय माचिरम् ।\nअभिषिक्तं करिष्यामि अद्यैव कुरुनन्दनम् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2117480, "chapter_id": 3530, "verse_number": "१९", "content_sanskrit": "ब्राह्मणा आगमश्रेष्ठाः श्रेणिमुख्याश्च सर्वशः ।\nआहूयन्तां प्रकृतयो बान्धवाश्च विशेषतः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2117481, "chapter_id": 3530, "verse_number": "२०", "content_sanskrit": "पुण्याहं वाच्यतां तात गोसहस्रं च दीयताम् ।\nग्राममुख्याश्च विप्रेभ्यो दीयन्तां सहदक्षिणाः \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2117482, "chapter_id": 3530, "verse_number": "२१", "content_sanskrit": "अङ्गदे मकुटं क्षत्तर्हस्ताभरणमानय ।\nमुक्तावलीश्च हारं च निष्कादीन् कुण्डलानि च \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2117483, "chapter_id": 3530, "verse_number": "२२", "content_sanskrit": "कटिबन्धनसूत्रं च तथोदरनिबन्धनम् ।\nअष्टोत्तरसहस्रं तु ब्राह्मणाधिष्ठिता गजाः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2117484, "chapter_id": 3530, "verse_number": "२३", "content_sanskrit": "जाह्नवीसलिलं शीघ्रमानीयन्तां पुरोहितैः ।\nअभिषेकोदकक्लिन्नं सर्वाभरणभूषितम् \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2117485, "chapter_id": 3530, "verse_number": "२४", "content_sanskrit": "औपवाह्योपरिगतं दिव्यचामरवीजितम् ।\nसुवर्णमणिचित्रेण श्वेतच्छत्रेण शोभितम् \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2117486, "chapter_id": 3530, "verse_number": "२५", "content_sanskrit": "जयेति द्विजवाक्येन स्तूयमानं नृपैस्तथा ।\nदृष्ट्वा कुन्तीसुतं ज्येष्ठमाजमीढं युधिष्ठिरम् \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2117487, "chapter_id": 3530, "verse_number": "२६", "content_sanskrit": "प्रीताः प्रीतेन मनसा प्रशंसन्तु पुरे जनाः ।\nपाण्डोः कृतोपकारस्य राज्यं दत्वा ममैव च ।\nप्रतिक्रियाकृतमिदं भविष्यति न संशयः \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2117488, "chapter_id": 3530, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2117489, "chapter_id": 3530, "verse_number": "", "content_sanskrit": "भीष्मो द्रोणः कृपः क्षत्ता साधु साध्वित्यभाषताम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2117490, "chapter_id": 3530, "verse_number": "", "content_sanskrit": "श्रीवासुदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2117491, "chapter_id": 3530, "verse_number": "२७", "content_sanskrit": "युक्तमेतन्महाराज कौरवाणां यशस्करम् ।\nशीघ्रमद्यैव राजेन्द्र यथोक्तं कर्तुमर्हसि \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2117492, "chapter_id": 3530, "verse_number": "२८", "content_sanskrit": "इत्येवमुत्तवा वार्ष्णेयस्त्वरयामास तं तदा ।\nयथोक्तं धृतराष्ट्रश्च कारयामास कौरवः \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2117493, "chapter_id": 3530, "verse_number": "२९", "content_sanskrit": "तस्मिन् क्षणे महाराज कृष्णद्वैपायनस्तदा ।\nआगत्य कुरुभिः सर्वैः पूजितः ससुहृद्गणैः \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2117494, "chapter_id": 3530, "verse_number": "३०", "content_sanskrit": "मूर्धावसिक्तैः सहितो ब्राह्मणैर्वेदपारगैः ।\nकारयामास विधिवत् केशवानुमते तदा \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2117495, "chapter_id": 3530, "verse_number": "३१", "content_sanskrit": "कृपो द्रोणश्च भीष्मश्च धौम्यश्च व्यासकेशवौ ।\nबाह्लीकः सोमदत्तश्च चातुर्वेद्या पुरस्कृताः \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2117496, "chapter_id": 3530, "verse_number": "३२", "content_sanskrit": "अभिषेकं तदा चक्रुर्भद्रपीठे सुसंयतम् ।\nजित्वा तु पृथिवीं कृत्स्नां वशे कृत्वा नरर्षभान् \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2117497, "chapter_id": 3530, "verse_number": "३३", "content_sanskrit": "राजसूयादिभिर्यज्ञैः क्रतुभिर्भूरिदक्षिणैः ।\nस्नात्वा ह्यवभृथस्नानं मोदतां बान्धवैः सह \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2117498, "chapter_id": 3530, "verse_number": "३४", "content_sanskrit": "एवमुक्त्वा तु ते सर्वे आशीर्भिरभिपूजयन् ।\nमूर्धाभिषिक्तः कौरव्यः सर्वाभरणभूषितः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2117499, "chapter_id": 3530, "verse_number": "३५", "content_sanskrit": "जयेति संस्तुतो राजा प्रददौ धनमक्षयम् ।\nसर्वमूर्धावसिक्तैश्च पूजितः कुरुनन्दनः \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2117500, "chapter_id": 3530, "verse_number": "३६", "content_sanskrit": "औपवाह्यमथारुह्य दिव्यच्छत्रोपशोभितः ।\nरराजानुगतो राजा महेन्द्र इव दैवतैः \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2117501, "chapter_id": 3530, "verse_number": "३७", "content_sanskrit": "ततः प्रदक्षिणीकृत्य नगरं नागसाह्वयम् ।\nप्रविवेश ततो राजा नागरैः पूजितो भृशम् \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2117502, "chapter_id": 3530, "verse_number": "३८", "content_sanskrit": "मूर्धावसिक्तं कौन्तेयमभ्यनन्दन्त बान्धवाः ।\nगान्धारिपुत्राः शोचन्तः सर्वे ते सह बान्धवैः \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2117503, "chapter_id": 3530, "verse_number": "३९", "content_sanskrit": "ज्ञात्वा शोकं तु पुत्राणां धृतराष्ट्रोऽब्रवीन्नृपम् ।\nसमक्षं वासुदेवस्य कुरूणां च समक्षतः \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2117504, "chapter_id": 3530, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2117505, "chapter_id": 3530, "verse_number": "४०", "content_sanskrit": "अभिषेकं त्वया प्राप्तं दुष्प्रापमकृतात्मभिः ।\nगच्छ त्वमद्यैव नृप कृतकृत्योऽसि पौरव \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2117506, "chapter_id": 3530, "verse_number": "४१", "content_sanskrit": "आयुः पुरूरवा राजन् नहुषश्च ययातिना ।\nतत्रैव निवसन्ति स्म खाण्डवाख्ये नृपोत्तमाः \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2117507, "chapter_id": 3530, "verse_number": "४२", "content_sanskrit": "राजधानी तु सर्वेषां पौरवाणां महाभुज ।\nविनाशितं मुनिगणैर्लोभाद् बुधसुतस्य तु \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2117508, "chapter_id": 3530, "verse_number": "४३", "content_sanskrit": "तस्मात् त्वं खाण्डवप्रस्थं पुरं राष्ट्रं च वर्धय ।\nब्राह्मणाः क्षत्रिया वैश्याः शूद्राश्च कृतलक्षणाः \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2117509, "chapter_id": 3530, "verse_number": "४४", "content_sanskrit": "त्वद्भक्त्या जन्तवश्चान्ये भजन्त्येव पुरं शुभम् ।\nपुरं राष्ट्रं समृद्धं वै धनधान्यैः समावृतम् ।\nतस्माद् गच्छस्व कौन्तेय भ्रातृभिः सहितोऽनघ \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2117510, "chapter_id": 3530, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2117511, "chapter_id": 3530, "verse_number": "४५", "content_sanskrit": "प्रतिगृह्य तु ते वाक्यं नृपं सर्वे प्रणम्य च ।\nरथैर्नागैर्हयैश्चापि सहितास्तु पदातिभिः \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2117512, "chapter_id": 3530, "verse_number": "४६", "content_sanskrit": "प्रतस्थिरे ततो घोरं वनान्तं मनुजर्षभाः ।\nपाण्डवैः सहिता गन्तुं नार्हतेति च नागरान् \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2117513, "chapter_id": 3530, "verse_number": "४७", "content_sanskrit": "घोषयामास नगरे धार्तराष्ट्रः ससौबलः ।\nततस्ते पाण्डवास्तत्र गत्वा कृष्णपुरोगमाः \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2117514, "chapter_id": 3530, "verse_number": "४८", "content_sanskrit": "मण्डयाञ्चक्रिरे तद्वै पुरं स्वर्गवदच्युताः ।\nवासुदेवो जगन्नाथश्चिन्तयामास वासवम् \t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2117515, "chapter_id": 3530, "verse_number": "४९", "content_sanskrit": "महेन्द्रश्चिन्तितो राजन् विश्वकर्माणमादिशत् ।\nविश्वकर्मन् महाप्राज्ञ अद्यप्रभृति तत् पुरम् ।\nइन्द्रप्रस्थमिति ख्यातं दिव्यं रम्यं भविष्यति \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2117516, "chapter_id": 3530, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2117517, "chapter_id": 3530, "verse_number": "५०", "content_sanskrit": "महेन्द्रशासनाद् गत्वा विश्वकर्मा तु केशवम् ।\nप्रणम्य प्रणिपातार्हं किं करोमीत्यभाषत \t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2117518, "chapter_id": 3530, "verse_number": "५१", "content_sanskrit": "वासुदेवस्तु तच्छ्रुत्वा विश्वकर्माणमूचिवान् ।\nकुरुष्व कुरुराजाय महेन्द्रपुरसन्निभम् ।\nइन्द्रेण कृतनामानमिन्द्रप्रस्थं महापुरम्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2117519, "chapter_id": 3530, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2117520, "chapter_id": 3530, "verse_number": "५२", "content_sanskrit": "ततः पुण्ये शिवे देशे शान्तिं कृत्वा महारथाः ।\nस्वस्ति वाच्य यथान्यायमिन्द्रप्रस्थं भवत्विति \t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2117521, "chapter_id": 3530, "verse_number": "५३", "content_sanskrit": "नगरं मापयामासुर्द्वैपायनपुरोगमाः ।\nततस्तु विश्वकर्मा तु चकार पुरमुत्तमम्\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2117522, "chapter_id": 3530, "verse_number": "५४", "content_sanskrit": "सागरप्रतिरूपाभिः परिखाभिरलङ्कृतम् ।\nप्राकारेण च सम्पन्नं दिवमावृत्य विष्ठितम् \t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2117523, "chapter_id": 3530, "verse_number": "५५", "content_sanskrit": "पाण्डराभ्रप्रकाशेन वृतं शशिनिभेन च ।\nशुशुभे तत् पुरश्रेष्ठं नागैर्भोगवती यथा \t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2117524, "chapter_id": 3530, "verse_number": "५६", "content_sanskrit": "द्विपक्षगरुडप्रख्यैर्द्वारैर्घोरप्रदर्शनैः ।\nगुप्तमभ्रघनप्रख्यैर्गोपुरैर्मन्दरोपमैः \t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2117525, "chapter_id": 3530, "verse_number": "५७", "content_sanskrit": "विविधैरतिविस्तीर्णैः शस्त्रोपेतैः सुसंवृतैः ।\nशक्तिभिश्चावृतं तद्धि द्विजिह्वैरिव पन्नगैः \t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2117526, "chapter_id": 3530, "verse_number": "५८", "content_sanskrit": "तल्पैश्चाभ्यधिकैर्युक्तं शुशुभे योधरक्षितम् ।\nतीक्ष्णाभिश्च शतघ्नीभिर्यन्त्रजालैश्च शोभितम् \t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2117527, "chapter_id": 3530, "verse_number": "५९", "content_sanskrit": "आयसैश्च महाचक्रैः शुशुभे तत् पुरोत्तमम् ।\nसुविभक्तमहारथ्यं देवताबाधवर्जितम् \t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2117528, "chapter_id": 3530, "verse_number": "६०", "content_sanskrit": "विरोचमानं विविधैः पाण्डरैर्भवनोत्तमैः ।\nहर्म्यप्रासादसम्बाधं नानाऽऽपणविभूषितम् \t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2117529, "chapter_id": 3530, "verse_number": "६१", "content_sanskrit": "विस्पर्धयेव प्रासादा ह्यन्योन्याभ्युच्छ्रिताऽभवन् ।\nमण्डपाश्च सभाः शालाः प्रपाश्चैव समन्ततः \t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2117530, "chapter_id": 3530, "verse_number": "६२", "content_sanskrit": "तत् त्रिविष्टपसङ्काशमिन्द्रप्रस्थं व्यरोचत ।\nमेघबृन्दमिवाकाशे विद्युत्सौदामिनीवृतम् \t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2117531, "chapter_id": 3530, "verse_number": "६३", "content_sanskrit": "इन्द्रप्रस्थस्य मध्ये तु कौरवस्य निवेशनम् ।\nशुशुभे धनसम्पूर्णं धनाध्यक्षक्षयोपमम् \t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2117532, "chapter_id": 3530, "verse_number": "६४", "content_sanskrit": "गृहैरादर्शविमलैर्विविधैश्च लतागृहैः ।\nमनोहरैश्चित्रगृहैस्तथा जगतिपर्वतैः \t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2117533, "chapter_id": 3530, "verse_number": "६५", "content_sanskrit": "पुष्करिण्यश्च विविधाः पद्मोत्पलसमावृताः ।\nहंसकारण्डवाकीर्णाश्चक्रवाकोपशोभिताः \t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2117534, "chapter_id": 3530, "verse_number": "६६", "content_sanskrit": "रम्याश्च विविधास्तत्र वाप्यश्चैव समावृताः ।\nवेश्ममध्ये शुभं दिव्यमिन्द्रवासगृहोपमम् \t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2117535, "chapter_id": 3530, "verse_number": "६७", "content_sanskrit": "राज्ञो वासगृहं रम्यं विश्वकर्माऽत्यकारयत् ।\nसुवर्णमणिसोपानं सर्वरत्नविचित्रितम् \t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2117536, "chapter_id": 3530, "verse_number": "६८", "content_sanskrit": "विहारभूम्यो विविधाः कारिताः सुमनोहराः ।\nतथा प्रासादमालाश्च शोभन्ते स्म सहस्रशः \t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2117537, "chapter_id": 3530, "verse_number": "६९", "content_sanskrit": "निरन्तरा राजमार्गाः स्त्रीरत्नैः शोभिताः स्थिताः ।\nतत्रागच्छन् द्विजा राजन् सर्वे वेदविदां वराः \t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2117538, "chapter_id": 3530, "verse_number": "७०", "content_sanskrit": "निवासं रोचयन्ति स्म सर्वभाषाविदस्तथा ।\nवणिजश्चाभ्ययुस्तत्र देशेभ्योऽपि धनार्थिनः \t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2117539, "chapter_id": 3530, "verse_number": "७१", "content_sanskrit": "सर्वशिल्पविदश्चैव वासायाभ्यागमंस्तदा ।\nउद्यानानि च रम्याणि नगरस्य समीपतः\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2117540, "chapter_id": 3530, "verse_number": "७२", "content_sanskrit": "सहकाराम्रपनसैः कपित्थैरप्युदुम्बरैः ।\nनाळिकेरैश्च लिकुचैः क्रमुकैश्च समावृताः\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2117541, "chapter_id": 3530, "verse_number": "७३", "content_sanskrit": "अशोकैस्तिलकैर्लोध्रैर्नीलाशोकैश्च चम्पकैः ।\nकरवीरैः कर्णिकारैर्नागवृक्षैः सुपुष्पितैः \t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2117542, "chapter_id": 3530, "verse_number": "७४", "content_sanskrit": "पुन्नागैर्नागवृक्षैश्च मधूकैश्च सुपुष्पितैः ।\nसालताळकदम्बैश्च वकुलैश्च सकेतकैः \t॥ ७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2117543, "chapter_id": 3530, "verse_number": "७५", "content_sanskrit": "पुन्नागैः कदळीभिश्च पारिजातैः सुपुष्पितैः ।\nअन्यैश्च विविधैर्वृक्षैः फलभारावनामिभिः \t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2117544, "chapter_id": 3530, "verse_number": "७६", "content_sanskrit": "नित्यपुष्पफलोपेतैः शौभितास्ते गृहोत्तमाः ।\nतटाकानि च रम्याणि विविधानि समन्ततः \t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2117545, "chapter_id": 3530, "verse_number": "७७", "content_sanskrit": "नदी च नन्दिनी नाम सा पुरीमुपगूहते ।\nचातुर्वर्ण्यसमाकीर्णं मान्यैः शिल्पिभिरावृतम् \t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2117546, "chapter_id": 3530, "verse_number": "७८", "content_sanskrit": "उपभोगसमर्थैश्च सर्वद्रव्यैः समावृतम् ।\nनित्यमार्यजनोपेतं नरनारीगणैर्युतम् \t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2117547, "chapter_id": 3530, "verse_number": "७९", "content_sanskrit": "मत्तवारणसम्पूर्णं गोभिरुष्ट्रैः खरैरजैः ।\nसर्वदाऽभिसृतं सद्भिः कारितं विश्वकर्मणा\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2117548, "chapter_id": 3530, "verse_number": "८०", "content_sanskrit": "तत् त्रिविष्टपसङ्काशमिन्द्रप्रस्थं व्यरोचत ।\nपुरीं सर्वगुणोपेतां निर्मितां विश्वकर्मणा \t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2117549, "chapter_id": 3530, "verse_number": "८१", "content_sanskrit": "पौरवाणामधिपतिः कुन्तीपुत्रो युधिष्ठिरः ।\nकृतमङ्गलसत्कारो ब्राह्मणैर्वेदपारगैः \t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2117550, "chapter_id": 3530, "verse_number": "८२", "content_sanskrit": "द्वैपायनं पुरस्कृत्य धौम्यस्यानुमते स्थितः ।\nभ्रातृभिः सहितो राजन् केशवेन सहाभिभूः \t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2117551, "chapter_id": 3530, "verse_number": "८३", "content_sanskrit": "वर्धमानपुरद्वारं प्रविवेश महाद्युतिः ।\nशङ्खदुन्दुभिनिर्घोषाः श्रूयन्ते बहवो भृशम् \t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2117552, "chapter_id": 3530, "verse_number": "८४", "content_sanskrit": "जयेति ब्राह्मणा वाचः श्रूयन्ते स्म सहस्रशः ।\nसंस्तूयमानो मुनिभिः सूतमागधवन्दिभिः \t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2117553, "chapter_id": 3530, "verse_number": "८५", "content_sanskrit": "औपवाह्यगतो राजा राजमार्गमतीत्य च ।\nकृतमङ्गलसत्कारं प्रविवेश गृहोत्तमम् \t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2117554, "chapter_id": 3530, "verse_number": "८६", "content_sanskrit": "प्रविश्य भवनं राजा सत्कारैरभिपूजितः ।\nपूजयामास विप्रेन्द्रान् केशवेन यथाक्रमम् \t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2117555, "chapter_id": 3530, "verse_number": "८७", "content_sanskrit": "ततस्तु राष्ट्रं नगरं नरनारीगणायुतम् ।\nगोधनैश्च समाकीर्णं सस्यवृद्धिस्तदाऽभवत् \t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2117556, "chapter_id": 3530, "verse_number": "८८", "content_sanskrit": "येषां पुण्यजनोपेतं राष्ट्रमावसतां महत् ।\nपाण्डवानां महाराज शश्वत् प्रीतिरवर्धत \t॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2117557, "chapter_id": 3530, "verse_number": "८९", "content_sanskrit": "सौबलेन च कर्णेन धार्तराष्ट्रैः कृपेण च ।\nतथा भीष्मेण राज्ञा च धर्मप्रणयिनस्तदा \t॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2117558, "chapter_id": 3530, "verse_number": "९०", "content_sanskrit": "पाण्डवाः समपद्यन्त खाण्डवप्रस्थवासिनः ।\nपञ्चभिस्तैर्महेष्वासैरिन्द्रकल्पैः समावृतम् \t॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2117559, "chapter_id": 3530, "verse_number": "९१", "content_sanskrit": "शुशुभे तत् पुरश्रेष्ठं नागैर्भोगवती यथा ।\nततस्तु विश्वकर्माणं पूजयित्वा विसृज्य च \t॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2117560, "chapter_id": 3530, "verse_number": "९२", "content_sanskrit": "द्वैपायनं च सम्पूज्य विसृज्य च नराधिप ।\nवार्ष्णेयमब्रवीद् राजा गन्तुकामं कृतक्षणम् \t॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2117561, "chapter_id": 3530, "verse_number": "९३", "content_sanskrit": "तव प्रसादाद् वार्ष्णेय राज्यं प्राप्तं मयाऽनघ ।\nप्रसादादेव ते वीर शून्यं राष्ट्रं सुदुर्गमम् \t॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2117562, "chapter_id": 3530, "verse_number": "९४", "content_sanskrit": "तवैव तु प्रसादेन राज्यस्थाश्च महामते ।\nगतिस्त्वमन्तकाले च पाण्डवानां तु माधव \t॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2117563, "chapter_id": 3530, "verse_number": "९५", "content_sanskrit": "माताऽस्माकं पिता देवो न पाण्डुं विद्म वै वयम् ।\nज्ञात्वा तु कृत्यं कर्तव्यं कारयस्व भवान् हि नः ।\nयदिष्टमनुमन्तव्यं पाण्डवानां त्वयाऽनघ \t॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2117564, "chapter_id": 3530, "verse_number": "", "content_sanskrit": "श्रीवासुदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2117565, "chapter_id": 3530, "verse_number": "९६", "content_sanskrit": "त्वत्प्रसादान्महाराज राज्यं प्राप्तं स्वधर्मतः ।\nपितृपैतामहं राज्यं कथं न स्यात् तव प्रभो \t॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2117566, "chapter_id": 3530, "verse_number": "९७", "content_sanskrit": "धार्तराष्ट्रा दुराचाराः किं करिष्यन्ति पाण्डवान् ।\nयथेष्टं पालय महीं सदा धर्मधुरं वह \t॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2117567, "chapter_id": 3530, "verse_number": "९८", "content_sanskrit": "धर्मोपदेशं सङ्क्षेपाद् ब्राह्मणान् भर पौरव ।\nअद्यैव नारदः श्रीमानागमिष्यति सत्वरः ।\nआदृत्य तस्य वाक्यानि शासनं कुरु तस्य वै \t॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2117568, "chapter_id": 3530, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2117569, "chapter_id": 3530, "verse_number": "९९", "content_sanskrit": "एवमुक्त्वा ततः कुन्तीमभिवाद्य जनार्दनः ।\nउवाच श्लक्ष्णया वाचा गमिष्यामि नमोऽस्तु ते \t॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2117570, "chapter_id": 3530, "verse_number": "", "content_sanskrit": "कुन्ती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2117571, "chapter_id": 3530, "verse_number": "१००", "content_sanskrit": "जातुषं गृहमासाद्य मया प्राप्तं च केशव ।\nआर्येणापि तवाज्ञातं कुन्तिभोजेन वाऽनघ \t॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2117572, "chapter_id": 3530, "verse_number": "१०१", "content_sanskrit": "त्वया नाथेन गोविन्द सुखं प्राप्तं महत्तरम् ।\nत्वं हि नाथस्त्वनाथानां दरिद्राणां विशेषतः \t॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2117573, "chapter_id": 3530, "verse_number": "१०२", "content_sanskrit": "सर्वदुःखानि शाम्यन्ति तव सन्दर्शनान्मम ।\nस्मरस्वैनान् महाप्राज्ञ तेन जीवन्ति पाण्डवाः \t॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2117574, "chapter_id": 3530, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2117575, "chapter_id": 3530, "verse_number": "१०३", "content_sanskrit": "प्रसादमिति चामन्त्र्य अभिवाद्य पितृष्वसाम् ।\nगमनाय मतिं चक्रे वासुदेवः सहानुगः \t॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2117576, "chapter_id": 3530, "verse_number": "१०४", "content_sanskrit": "अनुज्ञाप्य ततो वीरः सह रामेण केशवः ।\nययौ द्वारवतीं राजन् पाण्डवानुमते तदा \t॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2117577, "chapter_id": 3530, "verse_number": "२०९", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nनवाधिकद्विशततमोऽध्यायः ॥२०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2117578, "chapter_id": 3530, "verse_number": "१", "content_sanskrit": "॥ इति राज्यलाभपर्वणि प्रथमोऽध्यायः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2117579, "chapter_id": 3530, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}]