[{"id": 2016260, "chapter_id": 1342, "verse_number": "२-८३-१", "content_sanskrit": "वैशम्पायन उवाच॥\nततः प्रायाद्विदुरोऽश्वैरुदारै-\nर्महाजवैर्बलिभिः साधु दान्तैः।\nबलान्नियुक्तो धृतराष्ट्रेण राज्ञा\nमनीषिणां पाण्डवानां सकाशे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2016261, "chapter_id": 1342, "verse_number": "२-८३-२", "content_sanskrit": "सोऽभिपत्य तदध्वानमासाद्य नृपतेः पुरम्।\nप्रविवेश महाबुद्धिः पूज्यमानो द्विजातिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2016262, "chapter_id": 1342, "verse_number": "२-८३-३", "content_sanskrit": "स राजगृहमासाद्य कुबेरभवनोपमम्।\nअभ्यागच्छत धर्मात्मा धर्मपुत्रं युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2016263, "chapter_id": 1342, "verse_number": "२-८३-४", "content_sanskrit": "तं वै राजा सत्यधृतिर्महात्मा\nअजातशत्रुर्विदुरं यथावत्।\nपूजापूर्वं प्रतिगृह्याजमीढ-\nस्ततोऽपृच्छद्धृतराष्ट्रं सपुत्रम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2016264, "chapter_id": 1342, "verse_number": "२-८३-५x", "content_sanskrit": "युधिष्ठिर उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2016265, "chapter_id": 1342, "verse_number": "२-८३-५", "content_sanskrit": "विज्ञायते ते मनसोऽप्रहर्षः\nकच्चित्क्षत्तः कुशलेनागतोऽसि।\nकच्चित्पुत्राः स्थविरस्यानुलोमा\nवशानुगाश्चापि विशोऽथ कच्चित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2016266, "chapter_id": 1342, "verse_number": "२-८३-६x", "content_sanskrit": "विदुर उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2016267, "chapter_id": 1342, "verse_number": "२-८३-६", "content_sanskrit": "राजा महात्मा कुशली सपुत्र\nआस्ते वृतो ज्ञातिभिरिन्द्रकल्पः।\nप्रीतो राजन्पुत्रगुणैर्विनीतो\nविशोक एवात्मरतिर्महात्मा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2016268, "chapter_id": 1342, "verse_number": "२-८३-७", "content_sanskrit": "इदं तु त्वां कुरुराजोऽभ्युवाच\nपूर्वं पृष्ट्वा कुशलं चाव्ययं च।\nइयं सभा त्वत्सभातुल्यरूपा\nभ्रातॄणां ते दृस्यतामेत्य पुत्र॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2016269, "chapter_id": 1342, "verse_number": "२-८३-८", "content_sanskrit": "समागम्य भ्रातृभिः पार्थ तस्यां\nसुहृद्द्यूतं क्रियतां रम्यतां च।\nप्रीयामहे भवतां सङ्गमेन\nसमागताः कुरवश्चापि सर्वे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2016270, "chapter_id": 1342, "verse_number": "२-८३-९", "content_sanskrit": "दुरोदरा विहिता ये तु तत्र\nमहात्मना धृतराष्ट्रेण राज्ञा।\nतान्द्रक्ष्यसे कितवान्सन्निविष्टा-\nनित्यागतोऽहं नृपते तज्जुषस्व॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2016271, "chapter_id": 1342, "verse_number": "२-८३-१०x", "content_sanskrit": "युधिष्ठर उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2016272, "chapter_id": 1342, "verse_number": "२-८३-१०", "content_sanskrit": "द्यूते क्षत्तः कलहो विद्यते नः\nको वै रोचतने बुध्यमानः।\nकिं वा भवान्मन्यते युक्तरूपं\nभवद्वाक्ये सर्व एव स्थिताः स्मः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2016273, "chapter_id": 1342, "verse_number": "२-८३-११x", "content_sanskrit": "विदुर उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2016274, "chapter_id": 1342, "verse_number": "२-८३-११", "content_sanskrit": "जानाम्यहं द्यूतमनर्थमूलं\nकृतश्च यत्नोऽस्य मया निवारणे।\nराजा च मां प्राहिमोत्त्वत्सकाशं\nश्रुत्वा विद्वञ्श्रेय इहाचरस्व॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2016275, "chapter_id": 1342, "verse_number": "२-८३-१२x", "content_sanskrit": "युधिष्ठिर उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2016276, "chapter_id": 1342, "verse_number": "२-८३-१२", "content_sanskrit": "के तत्रान्ये कितवा दीव्यमाना\nविना राज्ञो धृतराष्ट्रस्य पुत्रैः।\nपृच्छामि त्वां विदुर ब्रूहि नस्तान्\nयैर्दीव्यामः शतशः सन्निपत्य॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2016277, "chapter_id": 1342, "verse_number": "२-८३-१३x", "content_sanskrit": "विदुर उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2016278, "chapter_id": 1342, "verse_number": "२-८३-१३", "content_sanskrit": "गन्धारराजः शकुनिर्विशाम्पते\nराजाऽतिदेवी कृतहस्तो मताक्षः।\nविनिंशतिश्चित्रसेनश्च राजा\nसत्यव्रतः पुरुमित्रो जयश्च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2016279, "chapter_id": 1342, "verse_number": "२-८३-१४x", "content_sanskrit": "युधिष्ठिर उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2016280, "chapter_id": 1342, "verse_number": "२-८३-१४", "content_sanskrit": "महाभयाः कितवाः सन्निविष्टा\nमायोपधा देवितारोऽत्र सन्ति।\nधात्रा तु दिष्टस्य वशे किलेदं\nसर्वं जगत्तिष्ठति न स्वतन्त्रम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2016281, "chapter_id": 1342, "verse_number": "२-८३-१५", "content_sanskrit": "नाहं राज्ञो धृतराष्ट्रस्य शासना-\nन्न गन्तुमिच्छामि कवे दुरोदरम्।\nइष्टो हि पुत्रस्य पिता सदैव\nतदस्मि कर्ता विदुरात्थ मां यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2016282, "chapter_id": 1342, "verse_number": "२-८३-१६", "content_sanskrit": "न चाकामः शकुनिना देविताहं\nन चेन्मां जिष्णुराह्वयिता सभायाम्।\nआहूतोऽहं न निवर्ते कदाचित्\nतदाहितं शाश्वतं वै व्रतं मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2016283, "chapter_id": 1342, "verse_number": "२-८३-१७x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2016284, "chapter_id": 1342, "verse_number": "२-८३-१७", "content_sanskrit": "एवमुक्त्वा विदुरं धर्मराजः\nप्रायात्रिकं सर्वमाज्ञाप्य तूर्णम्।\nप्रायाच्छ्वोभूते सगणः सानुयात्रः\nसह स्त्रीभिर्दौपदामादि कृत्वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2016285, "chapter_id": 1342, "verse_number": "२-८३-१८", "content_sanskrit": "दैवं हि प्रज्ञां मुष्णाति चक्षुस्तेज इवापतत्।\nधातुश्च वशमन्वेति पाशैरिव नरः सितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2016286, "chapter_id": 1342, "verse_number": "२-८३-१९", "content_sanskrit": "इत्युक्त्वा प्रययौ राजा सह क्षत्र्रा युधिष्ठिरः।\nअमृष्यमाणस्तस्याथ समाह्वानमरिन्दमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2016287, "chapter_id": 1342, "verse_number": "२-८३-२०", "content_sanskrit": "बाह्लिकेन रथं यत्तमास्थाय परवीरहा।\nपरिच्छन्नो ययौ पार्थो भ्रातृभिः सह पाण्डवः।\nराजश्रिया दीप्यमानो ययौ ब्रह्मपुरः सरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2016288, "chapter_id": 1342, "verse_number": "२-८३-२१", "content_sanskrit": "सन्दिदेश ततः प्रेष्यानागतान्नगरं प्रति।\nततस्ते नृपशार्दूल चक्रुर्वै नृपशासनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2016289, "chapter_id": 1342, "verse_number": "२-८३-२२", "content_sanskrit": "ततो राजा महातेजाः संयम्य सपरिच्छदम्।\nब्राह्मणैः स्वस्ति वाच्याथ प्रययौ मन्दिराद्बहिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2016290, "chapter_id": 1342, "verse_number": "२-८३-२३", "content_sanskrit": "ब्राह्मणेभ्यो धनं दत्त्वा गत्यर्थं स यथाविधि।\nअन्येभ्यः स तु दत्त्वा च गन्तुमेवोपचक्रमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2016291, "chapter_id": 1342, "verse_number": "२-८३-२४", "content_sanskrit": "सर्वलक्षणसम्पन्नं राजहंसपरिच्छदम्।\nतमारुह्य महाराजो गजेन्द्रं षष्टिहायनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2016292, "chapter_id": 1342, "verse_number": "२-८३-२५", "content_sanskrit": "हारी किरीटी हेमाभः सर्वाभरणभूषितः।\nरराज राजन्पार्थो वै परया नृपशोभया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2016293, "chapter_id": 1342, "verse_number": "२-८३-२६", "content_sanskrit": "रुक्मवेदिगतः प्राज्यो ज्वलन्निव हुताशनः।\nततो जगाम राजा स प्रहृष्टनरवाहनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2016294, "chapter_id": 1342, "verse_number": "२-८३-२७", "content_sanskrit": "रथघोषेण महता पूरयन्वै नभः स्थलम्।\nसंस्तूयमानः स्तुतिभिः सूतमागधबन्दिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2016295, "chapter_id": 1342, "verse_number": "२-८३-२८", "content_sanskrit": "महासैन्येन सहितो यथादित्यः स्वरश्मिभिः।\nपाण्डुरेणातपत्रेण ध्रियमाणेन मूर्धनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2016296, "chapter_id": 1342, "verse_number": "२-८३-२९", "content_sanskrit": "बभौ युधिष्ठिरो राजा पौर्णमास्यामिवोडुराट्।\nचामरैर्हेमदण्डैश्च धूयमानः समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2016297, "chapter_id": 1342, "verse_number": "२-८३-३०", "content_sanskrit": "जयाशिषः प्रहृष्टानां नराणां पथि पाण्डवः।\nप्रत्यगृह्णाद्यथान्यायं यथआवद्भरतर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2016298, "chapter_id": 1342, "verse_number": "२-८३-३१", "content_sanskrit": "तथैव सैनिका राजन्राजानमनुयान्ति ये।\nतेषां हलहलाशब्दो दिवं स्तब्धः प्रतिष्ठितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2016299, "chapter_id": 1342, "verse_number": "२-८३-३२", "content_sanskrit": "नृपस्याग्ने ययौ राजन्भीमसेनो रथी बली।\nउभौ पार्श्वगतौ राज्ञः सतल्पौ वै सुकल्पितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2016300, "chapter_id": 1342, "verse_number": "२-८३-३३", "content_sanskrit": "अधिरूढौ यमौ चापि जग्मतुर्भरतर्षभ।\nशोभयन्तौ महासैन्यं तावुभौ रूपशालिनौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2016301, "chapter_id": 1342, "verse_number": "२-८३-३४", "content_sanskrit": "पृष्ठतोऽनुययौ जिष्णुर्वीरः शस्त्रभृतां वरः।\nश्वेताश्वो गाण्डिवं गृह्य अग्निदत्तं रथं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2016302, "chapter_id": 1342, "verse_number": "२-८३-३५", "content_sanskrit": "सैन्यमध्ये ययौ राजन्कुरुराजो युधिष्ठिरः।\nद्रौपदीप्रमुखा नार्यः सानुगाः सपरिच्छदाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2016303, "chapter_id": 1342, "verse_number": "२-८३-३६", "content_sanskrit": "आरुह्य ता विचित्राङ्ग्यो यानानि विविधानि च।\nमहत्या सेनया राजन्नग्रे यानानि विविधानि च।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2016304, "chapter_id": 1342, "verse_number": "२-८३-३७", "content_sanskrit": "समृद्धनरनागाश्वं सपताकरथध्वजम्।\nसंनद्धवरनिस्त्रिंशं पथि निर्घोषनिः स्वनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2016305, "chapter_id": 1342, "verse_number": "२-८३-३८", "content_sanskrit": "शङ्खदुन्दुभितालानां वेणुवीणानुवनादितम्।\nशुशुभे पाण्डवं सैन्यं प्रयास्यत्तत्तदा नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2016306, "chapter_id": 1342, "verse_number": "२-८३-३९", "content_sanskrit": "यथा कुबेरो लङ्कायां पुरा चात्यन्तशोभया।\nमहत्या सेनया सार्धं गुरुमिन्द्रं स गच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2016307, "chapter_id": 1342, "verse_number": "२-८३-४०", "content_sanskrit": "तथा ययौ स पार्थोऽपि असङ्ख्येयविभूतिना।\nसुसमृद्धेन सैन्येन यथा वैश्रवणस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2016308, "chapter_id": 1342, "verse_number": "२-८३-४१", "content_sanskrit": "स सरांसि नदीश्चैव वनान्युपवनानि च।\nअत्यक्रामन्महाराज पुरीं चाभ्यवपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2016309, "chapter_id": 1342, "verse_number": "२-८३-४२", "content_sanskrit": "स हास्तिनसमीपे तु कुरुराजो युधिष्ठिरः।\nचक्रे निवेशनं तत्र ततः स सहसैनिकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2016310, "chapter_id": 1342, "verse_number": "२-८३-४३", "content_sanskrit": "शिवे देशे समे चैव न्यवसत्पाण्डवस्तदा।\nततोराजन्समाहूय शोकविह्वलया गिरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2016311, "chapter_id": 1342, "verse_number": "२-८३-४४", "content_sanskrit": "एतद्वाक्यं च सर्वस्वं धृतराष्ट्रचिकीर्षितम्।\nआचचक्षे यथावृत्तं विदुरोऽथ नृपस्य ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2016312, "chapter_id": 1342, "verse_number": "२-८३-४५", "content_sanskrit": "तच्छ्रुत्वा भाषितं तेन धर्मराजोऽब्रवीदिदम्।\nन मर्षयाम्यहं क्षत्तः समाह्वानं व्रतं हि मे।\nस्वस्त्यस्तु लोके विप्राणां प्रजानां चैव सर्वदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2016313, "chapter_id": 1342, "verse_number": "२-८३-४६x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2016314, "chapter_id": 1342, "verse_number": "२-८३-४६", "content_sanskrit": "प्रविवेश ततो राजा नगरं नागसाह्वयम्।\nधृतराष्ट्रेण चाहूतः कालस्य समयेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2016315, "chapter_id": 1342, "verse_number": "२-८३-४७", "content_sanskrit": "स हास्तिनपुरं गत्वा धृतराष्ट्रगृहं ययौ।\nसमियाय च धर्मात्मा धृतराष्ट्रेण पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2016316, "chapter_id": 1342, "verse_number": "२-८३-४८", "content_sanskrit": "तथा भीष्मेण द्रोणेन कर्णेन च कृपेण च।\nसमियाय यथान्यायं द्रौणिना च विभुः सह", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2016317, "chapter_id": 1342, "verse_number": "२-८३-४९", "content_sanskrit": "समेत्य च महाबाहुः सोमदत्तेन चैव ह।\nदूर्योधनेन सभ्रात्रा सौबलेन च वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2016318, "chapter_id": 1342, "verse_number": "२-८३-५०", "content_sanskrit": "ये चान्ये तत्र राजानः पूर्वमेव समागताः।\nदुःशासनेन वीरेण सर्वैर्भ्रातृभिरेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2016319, "chapter_id": 1342, "verse_number": "२-८३-५१", "content_sanskrit": "जयद्रथेन च तथा कुरुभिश्चापि सर्वशः।\nततः सर्वैर्महाबाहुर्भ्रातृभिः पिरवारितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2016320, "chapter_id": 1342, "verse_number": "२-८३-५२", "content_sanskrit": "प्रविवेश गृहं राज्ञो धृतराष्ट्रस्य धीमतः।\nददर्श तत्र गान्धारीं देवीं पतिमनुव्रताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2016321, "chapter_id": 1342, "verse_number": "२-८३-५३", "content_sanskrit": "स्नुषाभिः संवृतां शश्वत्ताराभिरिव रोहिणीम्।\nअभिवाद्य स गान्धारीं तया च प्रतिनन्दितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2016322, "chapter_id": 1342, "verse_number": "२-८३-५४", "content_sanskrit": "ददर्श पितरं वृद्धं प्रज्ञाचक्षुषमीश्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2016323, "chapter_id": 1342, "verse_number": "२-८३-५५", "content_sanskrit": "राज्ञा मूर्धन्युपाघ्रातास्ते च कौरवनन्दनाः।\nचत्वारः पाण्डवा राजन्भीमसेनपुरोगमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2016324, "chapter_id": 1342, "verse_number": "२-८३-५६", "content_sanskrit": "ततो हर्षः समभवत्कौरवाणां विशाम्पते।\nतान्दृष्ट्वा पुरुषव्याघ्रान्पाण्डवान्प्रियदर्शनान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2016325, "chapter_id": 1342, "verse_number": "२-८३-५७", "content_sanskrit": "विविशुस्तेऽभ्यनुज्ञाता रत्नवन्ति गृहाणि च।\nददृशुश्चोपयातारो द्रोपदीप्रमुखाः स्त्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2016326, "chapter_id": 1342, "verse_number": "२-८३-५८", "content_sanskrit": "याज्ञसेन्याः परामृद्धिं दृष्ट्वा प्रज्वलितामिव।\nस्नुषास्ता धृतराष्ट्रस्य नातिप्रमनसोऽभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2016327, "chapter_id": 1342, "verse_number": "२-८३-५९", "content_sanskrit": "ततस्ते पुरुषव्याघ्रा ग्तवा स्त्रीभिस्तु संविदम्।\nकृत्वा व्यायामपूर्वाणि कृत्यानि प्रतिकर्म च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2016328, "chapter_id": 1342, "verse_number": "२-८३-६०", "content_sanskrit": "ततः कृताह्निकाः सर्वे दिव्यचन्दनभूषिताः।\nकल्याणमनसश्चैव ब्राह्मणान्स्वस्ति वाच्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2016329, "chapter_id": 1342, "verse_number": "२-८३-६१", "content_sanskrit": "मनोज्ञमशनं भुक्त्वा विविशुः शरणान्यथ।\nउपगीयमाना नारीभिरस्वपन्कुरुपुङ्गवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2016330, "chapter_id": 1342, "verse_number": "२-८३-६२", "content_sanskrit": "जगाम तेषां सा रात्रिः पुण्या रतिविहारिणाम्।\nस्तूयमानाश्च विश्रान्ताः काले निद्रामथात्यजन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2016331, "chapter_id": 1342, "verse_number": "२-८३-६३", "content_sanskrit": "मुखोषितास्ते रजनीं प्रातः सर्वे कृताह्निकाः।\nसभां रम्यां प्रविविशुः कितवैरभिनन्दिताः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2016332, "chapter_id": 1342, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि द्यूतपर्वणि व्यशीतितमोऽध्यायः॥८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}]