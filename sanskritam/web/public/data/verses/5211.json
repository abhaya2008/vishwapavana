[{"id": 2198127, "chapter_id": 5211, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2198128, "chapter_id": 5211, "verse_number": "१", "content_sanskrit": "पितामह महाप्राज्ञ सर्वशास्त्रविशारद ।\nत्वत्तोऽहं श्रोतुमिच्छामि धर्मं भरतसत्तम\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2198129, "chapter_id": 5211, "verse_number": "२", "content_sanskrit": "शरणागतं ये रक्षन्ति भूतग्रामं चतुर्विधम् ।\nकिं तस्य भरतश्रेष्ठ फलं भवति तत्त्वतः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2198130, "chapter_id": 5211, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2198131, "chapter_id": 5211, "verse_number": "३", "content_sanskrit": "इदं शृणु महाराज धर्मपुत्र महायशः ।\nइतिहासं पुरावृत्तं शरणार्थं महाफलम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2198132, "chapter_id": 5211, "verse_number": "४", "content_sanskrit": "प्रपात्यमानः श्येनेन कपोतः प्रियदर्शनः ।\nवृषदर्भं महाभागं नरेन्द्रं शरणं गतः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2198133, "chapter_id": 5211, "verse_number": "५", "content_sanskrit": "स तं दृष्ट्वा विशुद्धात्मा त्रासादङ्कमुपागतम् ।\nआश्वास्याश्वसिहीत्याह न तेऽस्ति भयमण्डज\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2198134, "chapter_id": 5211, "verse_number": "६", "content_sanskrit": "भयं ते सुमहत्कस्मात् कुत्र किं वा कृतं त्वया ।\nयेन त्वमिह सम्प्राप्तो विसञ्ज्ञो भ्रान्तचेतनः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2198135, "chapter_id": 5211, "verse_number": "७", "content_sanskrit": "नवनीलोत्पलापीड चारुवर्ण सुदर्शन ।\nदाडिमाशोकपुष्पाक्ष मा त्रसस्वाभयं तव\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2198136, "chapter_id": 5211, "verse_number": "८", "content_sanskrit": "मत्सकाशमनुप्राप्तं न त्वां कश्चित्समुत्सहेत् ।\nमनसा ग्रहणं कर्तुं रक्षाध्यक्षपुरस्कृतम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2198137, "chapter_id": 5211, "verse_number": "९", "content_sanskrit": "काशिराज्यं तवाद्येह त्वदर्थं जीवितं तथा ।\nत्यजेयं भव विस्रब्धः कपोत न भयं तव\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2198138, "chapter_id": 5211, "verse_number": "", "content_sanskrit": "श्येनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2198139, "chapter_id": 5211, "verse_number": "१०", "content_sanskrit": "ममैतद् विहितं भक्ष्यं न राजंस्त्रातुमर्हसि ।\nअतिक्रान्तं च प्राप्तं च प्रयत्नाच्चोपपादितम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2198140, "chapter_id": 5211, "verse_number": "११", "content_sanskrit": "मांसं च रुधिरं चास्य मज्जा मेदश्च मे हितम् ।\nपरितोषकरो ह्येष मम मास्याग्रतो भव\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2198141, "chapter_id": 5211, "verse_number": "१२", "content_sanskrit": "तृष्णा मे बाधतेऽत्युग्रा क्षुधा निर्दहतीव माम् ।\nमुञ्चैनं न हि शक्ष्यामि राजन् मन्दयितुं क्षुधाम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2198142, "chapter_id": 5211, "verse_number": "१३", "content_sanskrit": "मया ह्यनुसृतो ह्येष मत्पक्षनखविक्षतः ।\nकिञ्चिदुच्छ्वासनिश्वासं न राजन् गोप्तुमर्हसि\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2198143, "chapter_id": 5211, "verse_number": "१४", "content_sanskrit": "यदि स्वविषये राजन् प्रभुस्त्वं रक्षणे नृणाम् ।\nखेचरस्य तृषार्तस्य न त्वं प्रभुरथो मम\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2198144, "chapter_id": 5211, "verse_number": "१५", "content_sanskrit": "यदि वैरिषु भृत्येषु स्वजनव्यवहारयोः ।\nविषयेष्विन्द्रियाणां च आकाशे मा पराक्रम\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2198145, "chapter_id": 5211, "verse_number": "१६", "content_sanskrit": "प्रभुत्वं हि पराक्रम्य सम्यक् पक्षहरेषु ते ।\nयदि त्वमिह धर्मार्थी मामपि द्रष्टुमर्हसि\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2198146, "chapter_id": 5211, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2198147, "chapter_id": 5211, "verse_number": "१७", "content_sanskrit": "श्रुत्वा श्येनस्य तद्वाक्यं राजर्षिर्विस्मयं गतः ।\nसम्भाव्य चैनं तद्वाक्यं तदर्थी प्रत्यभाषत\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2198148, "chapter_id": 5211, "verse_number": "१८", "content_sanskrit": "गोवृषो वा वराहो वा मृगो वा महिषोऽपि वा ।\nत्वदर्थमद्य क्रियतां क्षुधाप्रशमनाय ते\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2198149, "chapter_id": 5211, "verse_number": "१९", "content_sanskrit": "शरणागतं न त्यजेयमिति मे व्रतमाहितम् ।\nन मुञ्चति ममाङ्गानि द्विजोऽयं पश्य वै द्विज\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2198150, "chapter_id": 5211, "verse_number": "", "content_sanskrit": "श्येनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2198151, "chapter_id": 5211, "verse_number": "२०", "content_sanskrit": "न वराहं न चोक्षाणं न चान्यान् विविधान् द्विजान् ।\nभक्षयामि महाराज किमन्नाद्येन तेन मे\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2198152, "chapter_id": 5211, "verse_number": "२१", "content_sanskrit": "यस्तु मे विहितो भक्षं स्वयं देवैः सनातनः ।\nश्येना कपोतान् खादन्ति स्थितिरेषा सनातनी\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2198153, "chapter_id": 5211, "verse_number": "२२", "content_sanskrit": "उशीनर कपोते तु यदि स्नेहस्तवानघ ।\nततस्त्वं मे प्रयच्छाद्य स्वमांसं तुलया धृतम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2198154, "chapter_id": 5211, "verse_number": "", "content_sanskrit": "राजा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2198155, "chapter_id": 5211, "verse_number": "२३", "content_sanskrit": "महाननुग्रहो मेऽद्य यस्त्वमेवमिहात्थ माम् ।\nबाढमेवं करिष्यामीत्युक्त्वाऽसौ राजसत्तम\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2198156, "chapter_id": 5211, "verse_number": "२४", "content_sanskrit": "उत्कृत्योत्कृत्य मांसानि तुलया समतोलयत्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2198157, "chapter_id": 5211, "verse_number": "२५", "content_sanskrit": "अन्तःपुरे ततस्तस्य स्त्रियो रत्नविभूषिताः ।\nहाहाभूता विनिष्क्रान्ताः श्रुत्वा परमदुःखिताः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2198158, "chapter_id": 5211, "verse_number": "२६", "content_sanskrit": "तासां रुदितशब्देन मन्त्रिभृत्यजनस्य च ।\nबभूव सुमहान् नादो मेघगम्भीरनिस्वनः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2198159, "chapter_id": 5211, "verse_number": "२७", "content_sanskrit": "निरुद्धं गगनं सर्वं शुभ्रं मेघैः समन्ततः ।\nमही प्रचलिता चासीत् तस्य सत्येन कर्मणा\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2198160, "chapter_id": 5211, "verse_number": "२८", "content_sanskrit": "स राजा पार्श्वतश्चैव बाहुभ्यामूरुतश्च यत् ।\nतानि मांसानि सञ्छिद्य तुलां पूरयते शनैः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2198161, "chapter_id": 5211, "verse_number": "२९", "content_sanskrit": "तथापि न समस्तेन कपोतेन बभूव ह ।\nअस्थिभूतो यदा राजा निर्मांसो रुधिरस्रवः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2198162, "chapter_id": 5211, "verse_number": "३०", "content_sanskrit": "तुलां ततः समारूढः स्वं मांसक्षयमुत्सृजन् ।\nततः सेन्द्रास्त्रयो लोकास्तं नरेन्द्रमुपस्थिताः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2198163, "chapter_id": 5211, "verse_number": "३१", "content_sanskrit": "भेर्यश्चाकाशगैस्तत्र वादिता देवदुन्दुभिः ।\nअमृतेनावसिक्तश्च वृषदर्भो नरेश्वरः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2198164, "chapter_id": 5211, "verse_number": "३२", "content_sanskrit": "दिव्यैश्च सुमुखैर्माल्यैरभिवृष्टः पुनः पुनः ।\nदेवगन्धर्वसङ्घातैरप्सरोभिश्च सर्वतः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2198165, "chapter_id": 5211, "verse_number": "३३", "content_sanskrit": "नृत्तश्चैवोपगीतश्च पितामह इव प्रभुः ।\nहेमप्रासादसम्बाधं मणिकाञ्चनतोरणम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2198166, "chapter_id": 5211, "verse_number": "३४", "content_sanskrit": "स वैदूर्यमणिस्तम्भविमानं समधिष्ठितः ।\nस राजर्षिर्गतः स्वर्गं कर्मणा तेन शाश्वतम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2198167, "chapter_id": 5211, "verse_number": "३५", "content_sanskrit": "शरणागतेषु चैवं त्वं कुरु सर्वं युधिष्ठिर ।\nभक्तानामनुरक्तानामाश्रितानां च रक्षिता\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2198168, "chapter_id": 5211, "verse_number": "३६", "content_sanskrit": "दयावान् सर्वभूतेषु परत्र सुखमेधते ।\nसाधुवृत्तो हि यो राजा सद्वृत्तमनुतिष्ठति\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2198169, "chapter_id": 5211, "verse_number": "३७", "content_sanskrit": "किं न प्राप्तं भवेत्तेन स्वव्याजेनेह कर्मणा ।\nस राजर्षिर्विशुद्धात्मा धीरः सत्यपराक्रमः ।\nकाशीनामीश्वरः ख्यातस्त्रिषु लोकेषु कर्मणा\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2198170, "chapter_id": 5211, "verse_number": "३८", "content_sanskrit": "योऽप्यन्यः कारयेदेवं शरणागतरक्षणम् ।\nसोऽपि गच्छेत तामेव गतिं भरतसत्तम\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2198171, "chapter_id": 5211, "verse_number": "३९", "content_sanskrit": "इदं वृत्तं हि राजर्षेर्वृषदर्भस्य कीर्तयन् ।\nपूतात्मा वै भवेल्लोके शृणुयाद् यश्च नित्यशः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2198172, "chapter_id": 5211, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि\nदानधर्मे श्येनकपोतीयं नाम द्विषष्टितमोऽध्यायः ॥६२॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]