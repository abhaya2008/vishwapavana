    "display_order": 103,
    "base_unit_id": "Ch_C01_S13_V03"
  },
  {
    "id": 16705104,
    "chapter_id": 6105,
    "verse_number": "1.104",
    "content_sanskrit": "दुग्धेऽस्मै वाग्दोहं यो वाचो दोहोऽन्नवानन्नादो भवति य एतामेवꣳसाम्ना मुपनिषदं वेदोपनिषदं वेदेति ॥ ४ ॥",
