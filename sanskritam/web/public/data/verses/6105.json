[
  {
    "id": 16705001,
    "chapter_id": 6105,
    "verse_number": "1.1",
    "content_sanskrit": "ओमित्येतदक्षरमुद्गीथमुपासीत । ओमिति ह्युद्गायति तस्योपव्याख्यानम् ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "base_unit_id": "Ch_C01_S01_V01"
  },
  {
    "id": 16705002,
    "chapter_id": 6105,
    "verse_number": "1.2",
    "content_sanskrit": "एषां भूतानां पृथिवी रसः पृथिव्या आपो रसः । अपामोषधयो रस ओषधीनां पुरुषो रसः पुरुषस्य वाग्रसो वाच ऋग्रस ऋचः साम रसः साम्न उद्गीथो रसः ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "base_unit_id": "Ch_C01_S01_V02"
  },
  {
    "id": 16705003,
    "chapter_id": 6105,
    "verse_number": "1.3",
    "content_sanskrit": "स एष रसानाꣳ रसतमः परमः परार्ध्योऽष्टमो यदुद्गीथः ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "base_unit_id": "Ch_C01_S01_V03"
  },
  {
    "id": 16705004,
    "chapter_id": 6105,
    "verse_number": "1.4",
    "content_sanskrit": "कतमा कतमर्क्कतमत्कतमत्साम कतमः कतम उद्गीथ इति विमृष्टं भवति ॥ ४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "base_unit_id": "Ch_C01_S01_V04"
  },
  {
    "id": 16705005,
    "chapter_id": 6105,
    "verse_number": "1.5",
    "content_sanskrit": "वागेवर्क्प्राणः सामोमित्येतदक्षरमुद्गीथः । तद्वा एतन्मिथुनं यद्वाक्च प्राणश्चर्क्च साम च ॥ ५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "base_unit_id": "Ch_C01_S01_V05"
  },
  {
    "id": 16705006,
    "chapter_id": 6105,
    "verse_number": "1.6",
    "content_sanskrit": "तदेतन्मिथुनमोमित्येतस्मिन्नक्षरे सं सृज्यते यदा वै मिथुनौ समागच्छत आपयतो वै तावन्योन्यस्य कामम् ॥ ६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "base_unit_id": "Ch_C01_S01_V06"
  },
  {
    "id": 16705007,
    "chapter_id": 6105,
    "verse_number": "1.7",
    "content_sanskrit": "आपयिता ह वै कामानां भवति य एतदेवं विद्वानक्षरमुद्गीथमुपास्ते ॥ ७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "base_unit_id": "Ch_C01_S01_V07"
  },
  {
    "id": 16705008,
    "chapter_id": 6105,
    "verse_number": "1.8",
    "content_sanskrit": "तद्वा एतदनुज्ञाक्षरं यद्धि किञ्चानुजानात्योमित्येव तदाहैषो एव समृद्धिर्यदनुज्ञा समर्धयिता ह वै कामानां भवति य एतदेवं विद्वानक्षरमुद्गीथमुपास्ते ॥ ८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "base_unit_id": "Ch_C01_S01_V08"
  },
  {
    "id": 16705009,
    "chapter_id": 6105,
    "verse_number": "1.9",
    "content_sanskrit": "तेनेयं त्रयीविद्या वर्तते ओमित्याश्रावयत्योमिति शं सत्योमित्युद्गायत्येतस्यैवाक्षरस्यापचित्यै महिम्ना रसेन ॥ ९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "base_unit_id": "Ch_C01_S01_V09"
  },
  {
    "id": 16705010,
    "chapter_id": 6105,
    "verse_number": "1.10",
    "content_sanskrit": "तेनोभौ कुरुतो यश्चैतदेवं वेद यश्च न वेद । नाना तु विद्या चाविद्या च यदेव विद्यया करोति श्रद्धयोपनिषदा तदेव वीर्यवत्तरं भवतीति खल्वेतस्यैवाक्षरस्योपव्याख्यानं भवति ॥ १० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "base_unit_id": "Ch_C01_S01_V10"
  },
  {
    "id": 16705011,
    "chapter_id": 6105,
    "verse_number": "1.11",
    "content_sanskrit": "देवासुरा ह वै यत्र संयेतिरे उभये प्राजापत्यास्तद्ध देवा उद्गीथमाजह्रुरनेनैनानभिभविष्याम इति ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "base_unit_id": "Ch_C01_S02_V01"
  },
  {
    "id": 16705012,
    "chapter_id": 6105,
    "verse_number": "1.12",
    "content_sanskrit": "ते ह नासिक्यं प्राणमुद्गीथमुपासाञ्चक्रिरे तꣳ हासुराः पाप्मना विविधुस्तस्मात्तेनोभयं जिघ्रति सुरभि च दुर्गन्धि च पाप्मना ह्येष विद्धः ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "base_unit_id": "Ch_C01_S02_V02"
  },
  {
    "id": 16705013,
    "chapter_id": 6105,
    "verse_number": "1.13",
    "content_sanskrit": "अथ ह वाचमुद्गीथमुपासाञ्चक्रिरे तां हासुराः पाप्मना विविधुस्तस्मात्तयोभयं वदति सत्यं चानृतं च पाप्मना ह्येषा विद्धा ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "base_unit_id": "Ch_C01_S02_V03"
  },
  {
    "id": 16705014,
    "chapter_id": 6105,
    "verse_number": "1.14",
    "content_sanskrit": "अथ ह चक्षुरुद्गीथमुपासाञ्चक्रिरे तद्धासुराः पाप्मना विविधुस्तस्मात्तेनोभयं पश्यति दर्शनीयं चादर्शनीयं च पाप्मना ह्येतद्विद्धम् ॥ ४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "base_unit_id": "Ch_C01_S02_V04"
  },
  {
    "id": 16705015,
    "chapter_id": 6105,
    "verse_number": "1.15",
    "content_sanskrit": "अथ ह श्रोत्रमुद्गीथमुपासाञ्चक्रिरे तद्धासुराः पाप्मना विविधुस्तस्मात्तेनोभयं शृणोति श्रवणीयं चाश्रवणीयं च पाप्मना ह्येतद्विद्धम् ॥ ५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "base_unit_id": "Ch_C01_S02_V05"
  },
  {
    "id": 16705016,
    "chapter_id": 6105,
    "verse_number": "1.16",
    "content_sanskrit": "अथ ह मन उद्गीथमुपासाञ्चक्रिरे तद्धासुराः पाप्मना विविधुस्तस्मात्तेनोभयं सङ्कल्पते सङ्कल्पनीयं चासङ्कल्पनीयं च पाप्मना ह्येतद्विद्धम् ॥ ६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "base_unit_id": "Ch_C01_S02_V06"
  },
  {
    "id": 16705017,
    "chapter_id": 6105,
    "verse_number": "1.17",
    "content_sanskrit": "अथ ह य एवायं मुख्यः प्राणस्तमुद्गीथमुपासाञ्चक्रिरे तꣳ हासुरा ऋत्वा विदध्वंसुर्यथाश्मानमाखणमृत्वा विध्वं सेतैवम् ॥ ७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "base_unit_id": "Ch_C01_S02_V07"
  },
  {
    "id": 16705018,
    "chapter_id": 6105,
    "verse_number": "1.18",
    "content_sanskrit": "यथाश्मानमाखणमृत्वा विध्वꣳ सत एवꣳ हैव स विध्वꣳ सते य एवंविदि पापं कामयते यश्चैनमभिदासति स एषोऽश्माखणः ॥ ८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "base_unit_id": "Ch_C01_S02_V08"
  },
  {
    "id": 16705019,
    "chapter_id": 6105,
    "verse_number": "1.19",
    "content_sanskrit": "नैवैतेन सुरभि न दुर्गन्धि विजानात्यपहतपाप्मा ह्येष तेन यदश्नाति यत्पिबति तेनेतरान्प्राणानवति एतमु एवान्ततोऽवित्त्वोत्क्रामति व्याददात्येवान्तत इति ॥ ९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "base_unit_id": "Ch_C01_S02_V09"
  },
  {
    "id": 16705020,
    "chapter_id": 6105,
    "verse_number": "1.20",
    "content_sanskrit": "तꣳ हाङ्गिरा उद्गीथमुपासाञ्चक्र एतमु एवाङ्गिरसं मन्यन्तेऽङ्गानां यद्रसः ॥ १० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "base_unit_id": "Ch_C01_S02_V10"
  },
  {
    "id": 16705021,
    "chapter_id": 6105,
    "verse_number": "1.21",
    "content_sanskrit": "तेन तꣳ ह बृहस्पतिरुद्गीथमुपासाञ्चक्र एतमु एव बृहस्पतिं मन्यन्ते वाग्घि बृहती तस्या एष पतिः ॥ ११ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "base_unit_id": "Ch_C01_S02_V11"
  },
  {
    "id": 16705022,
    "chapter_id": 6105,
    "verse_number": "1.22",
    "content_sanskrit": "तेन तꣳ हायास्य उद्गीथमुपासाञ्चक्र एतमु एवायास्यं मन्यन्त आस्याद्यदयते ॥ १२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "base_unit_id": "Ch_C01_S02_V12"
  },
  {
    "id": 16705023,
    "chapter_id": 6105,
    "verse_number": "1.23",
    "content_sanskrit": "तेन तꣳ ह बको दाल्भ्यो विदाञ्चकार । स ह नैमिशीयानामुद्गाता बभूव स ह स्मैभ्यः कामानागायति ॥ १३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "base_unit_id": "Ch_C01_S02_V13"
  },
  {
    "id": 16705024,
    "chapter_id": 6105,
    "verse_number": "1.24",
    "content_sanskrit": "आगाता ह वै कामानां भवति य एतदेवं विद्वानक्षरमुद्गीथमुपास्त इत्यध्यात्मम् ॥ १४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "base_unit_id": "Ch_C01_S02_V14"
  },
  {
    "id": 16705025,
    "chapter_id": 6105,
    "verse_number": "1.25",
    "content_sanskrit": "अथाधिदैवतं य एवासौ तपति तमुद्गीथमुपासीतोद्यन्वा एष प्रजाभ्य उद्गायति । उद्यं स्तमो भयमपहन्त्यपहन्ता ह वै भयस्य तमसो भवति य एवं वेद ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "base_unit_id": "Ch_C01_S03_V01"
  },
  {
    "id": 16705026,
    "chapter_id": 6105,
    "verse_number": "1.26",
    "content_sanskrit": "समान उ एवायं चासौ चोष्णोऽयमुष्णोऽसौ स्वर इतीममाचक्षते स्वर इति प्रत्यास्वर इत्यमुं तस्माद्वा एतमिमममुं चोद्गीथमुपासीत ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "base_unit_id": "Ch_C01_S03_V02"
  },
  {
    "id": 16705027,
    "chapter_id": 6105,
    "verse_number": "1.27",
    "content_sanskrit": "अथ खलु व्यानमेवोद्गीथमुपासीत यद्वै प्राणिति स प्राणो यदपानिति सोऽपानः । अथ यः प्राणापानयोः सन्धिः स व्यानो यो व्यानः सा वाक् । तस्मादप्राणन्ननपानन्वाचमभिव्याहरति ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "base_unit_id": "Ch_C01_S03_V03"
  },
  {
    "id": 16705028,
    "chapter_id": 6105,
    "verse_number": "1.28",
    "content_sanskrit": "या वाक्सर्क्तस्मादप्राणन्ननपानन्नृचमभिव्याहरति यर्क्तत्साम तस्मादप्राणन्ननपानन्साम गायति यत्साम स उद्गीथस्तस्मादप्राणन्ननपानन्नुद्गायति ॥ ४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "base_unit_id": "Ch_C01_S03_V04"
  },
  {
    "id": 16705029,
    "chapter_id": 6105,
    "verse_number": "1.29",
    "content_sanskrit": "अतो यान्यन्यानि वीर्यवन्ति कर्माणि यथाग्नेर्मन्थनमाजेः सरणं दृढस्य धनुष आयमनमप्राणन्ननपानं स्तानि करोत्येतस्य हेतोर्व्यानमेवोद्गीथमुपासीत ॥ ५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "base_unit_id": "Ch_C01_S03_V05"
  },
  {
    "id": 16705030,
    "chapter_id": 6105,
    "verse_number": "1.30",
    "content_sanskrit": "अथ खलूद्गीथाक्षराण्युपासीतोद्गीथ इति प्राण एवोत्प्राणेन ह्युत्तिष्ठति वाग्गीर्वाचो ह गिर इत्याचक्षतेऽन्नं थमन्ने हीदं सर्वं स्थितम् ॥ ६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "base_unit_id": "Ch_C01_S03_V06"
  },
  {
    "id": 16705031,
    "chapter_id": 6105,
    "verse_number": "1.31",
    "content_sanskrit": "द्यौरेवोदन्तरिक्षं गीः पृथिवी थमादित्य एवोद्वायुर्गीरग्निस्थं सामवेद एवोद्यजुर्वेदो गीर्‌ऋग्वेदस्थं दुग्धेऽस्मै वाग्दोहं यो वाचो दोहोऽन्नवानन्नादो भवति य एतान्येवं विद्वानुद्गीथाक्षराण्युपास्त उद्गीथ इति ॥ ७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "base_unit_id": "Ch_C01_S03_V07"
  },
  {
    "id": 16705032,
    "chapter_id": 6105,
    "verse_number": "1.32",
    "content_sanskrit": "अथ खल्वाशीःसमृद्धिरुपसरणानीत्युपासीत येन साम्ना स्तोष्यन्स्यात्तत्सामोपधावेत् ॥ ८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "base_unit_id": "Ch_C01_S03_V08"
  },
  {
    "id": 16705033,
    "chapter_id": 6105,
    "verse_number": "1.33",
    "content_sanskrit": "यस्यामृचि तामृचं यदार्षेयं तमृषिं यां देवतामभिष्टोष्यन्स्यात्तां देवतामुपधावेत् ॥ ९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 33,
    "base_unit_id": "Ch_C01_S03_V09"
  },
  {
    "id": 16705034,
    "chapter_id": 6105,
    "verse_number": "1.34",
    "content_sanskrit": "येन च्छन्दसा स्तोष्यन्स्यात्तच्छन्द उपधावेद्येन स्तोमेन स्तोष्यमाणः स्यात्तं स्तोममुपधावेत् ॥ १० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34,
    "base_unit_id": "Ch_C01_S03_V10"
  },
  {
    "id": 16705035,
    "chapter_id": 6105,
    "verse_number": "1.35",
    "content_sanskrit": "यां दिशमभिष्टोष्यन्स्यात्तां दिशमुपधावेत् ॥ ११ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 35,
    "base_unit_id": "Ch_C01_S03_V11"
  },
  {
    "id": 16705036,
    "chapter_id": 6105,
    "verse_number": "1.36",
    "content_sanskrit": "आत्मानमन्तत उपसृत्य स्तुवीत कामं ध्यायन्नप्रमत्तोऽभ्याशो ह यदस्मै स कामः समृध्येत यत्कामः स्तुवीतेति यत्कामः स्तुवीतेति ॥ १२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 36,
    "base_unit_id": "Ch_C01_S03_V12"
  },
  {
    "id": 16705037,
    "chapter_id": 6105,
    "verse_number": "1.37",
    "content_sanskrit": "ओमित्येतदक्षरमुद्गीथमुपासीतोमिति ह्युद्गायति तस्योपव्याख्यानम् ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 37,
    "base_unit_id": "Ch_C01_S04_V01"
  },
  {
    "id": 16705038,
    "chapter_id": 6105,
    "verse_number": "1.38",
    "content_sanskrit": "देवा वै मृत्योर्बिभ्यतस्त्रयीं विद्यां प्राविशꣳ स्ते छन्दोभिरच्छादयन्यदेभिरच्छादयꣳ स्तच्छन्दसां छन्दस्त्वम् ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 38,
    "base_unit_id": "Ch_C01_S04_V02"
  },
  {
    "id": 16705039,
    "chapter_id": 6105,
    "verse_number": "1.39",
    "content_sanskrit": "तानु तत्र मृत्युर्यथा मत्स्यमुदके परिपश्येदेवं पर्यपश्यदृचि साम्नि यजुषि । ते नु विदित्वोर्ध्वा ऋचः साम्नो यजुषः स्वरमेव प्राविशन् ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 39,
    "base_unit_id": "Ch_C01_S04_V03"
  },
  {
    "id": 16705040,
    "chapter_id": 6105,
    "verse_number": "1.40",
    "content_sanskrit": "यदा वा ऋचमाप्नोत्योमित्येवातिस्वरत्येवꣳ सामैवं यजुरेष उ स्वरो यदेतदक्षरमेतदमृतमभयं तत्प्रविश्य देवा अमृता अभया अभवन् ॥ ४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 40,
    "base_unit_id": "Ch_C01_S04_V04"
  },
  {
    "id": 16705041,
    "chapter_id": 6105,
    "verse_number": "1.41",
    "content_sanskrit": "स य एतदेवं विद्वानक्षरं प्रणौत्येतदेवाक्षरꣳ स्वरममृतमभयं प्रविशति तत्प्रविश्य यदमृता देवास्तदमृतो भवति ॥ ५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 41,
    "base_unit_id": "Ch_C01_S04_V05"
  },
  {
    "id": 16705042,
    "chapter_id": 6105,
    "verse_number": "1.42",
    "content_sanskrit": "अथ खलु य उद्गीथः स प्रणवो यः प्रणवः स उद्गीथ इत्यसौ वा आदित्य उद्गीथ एष प्रणव ओमिति ह्येष स्वरन्नेति ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 42,
    "base_unit_id": "Ch_C01_S05_V01"
  },
  {
    "id": 16705043,
    "chapter_id": 6105,
    "verse_number": "1.43",
    "content_sanskrit": "एतमु एवाहमभ्यगासिषं तस्मान्मम त्वमेकोऽसीति ह कौषीतकिः पुत्रमुवाच रश्मीꣳ स्त्वं पर्यावर्तयाद्बहवो वै ते भविष्यन्तीत्यधिदैवतम् ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 43,
    "base_unit_id": "Ch_C01_S05_V02"
  },
  {
    "id": 16705044,
    "chapter_id": 6105,
    "verse_number": "1.44",
    "content_sanskrit": "अथाध्यात्मं य एवायं मुख्यः प्राणस्तमुद्गीथमुपासीतोमिति ह्येष स्वरन्नेति ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 44,
    "base_unit_id": "Ch_C01_S05_V03"
  },
  {
    "id": 16705045,
    "chapter_id": 6105,
    "verse_number": "1.45",
    "content_sanskrit": "एतमु एवाहमभ्यगासिषं तस्मान्मम त्वमेकोऽसीति ह कौषीतकिः पुत्रमुवाच प्राणाꣳ स्त्वं भूमानमभिगायताद्बहवो वै मे भविष्यन्तीति ॥ ४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 45,
    "base_unit_id": "Ch_C01_S05_V04"
  },
  {
    "id": 16705046,
    "chapter_id": 6105,
    "verse_number": "1.46",
    "content_sanskrit": "अथ खलु य उद्गीथः स प्रणवो यः प्रणवः स उद्गीथ इति होतृषदनाद्धैवापि दुरुद्गीतमनुसमाहरतीत्यनुसमाहरतीति ॥ ५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 46,
    "base_unit_id": "Ch_C01_S05_V05"
  },
  {
    "id": 16705047,
    "chapter_id": 6105,
    "verse_number": "1.47",
    "content_sanskrit": "इयमेवर्गग्निः साम तदेतदेतस्यामृच्यध्यूढꣳ साम तस्मादृच्यध्यूढꣳ साम गीयत इयमेव साग्निरमस्तत्साम ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 47,
    "base_unit_id": "Ch_C01_S06_V01"
  },
  {
    "id": 16705048,
    "chapter_id": 6105,
    "verse_number": "1.48",
    "content_sanskrit": "अन्तरिक्षमेवर्ग्वायुः साम तदेतदेतस्यामृच्यध्यूढꣳ साम तस्मादृच्यध्यूढꣳ साम गीयतेऽन्तरिक्षमेव सा वायुरमस्तत्साम ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 48,
    "base_unit_id": "Ch_C01_S06_V02"
  },
  {
    "id": 16705049,
    "chapter_id": 6105,
    "verse_number": "1.49",
    "content_sanskrit": "द्यौरेवर्गादित्यः साम तदेतदेतस्यामृच्यध्यूढꣳ साम तस्मादृच्यध्यूढꣳ साम गीयते द्यौरेव सादित्योऽमस्तत्साम ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 49,
    "base_unit_id": "Ch_C01_S06_V03"
  },
  {
    "id": 16705050,
    "chapter_id": 6105,
    "verse_number": "1.50",
    "content_sanskrit": "नक्षत्राण्येवर्क्चन्द्रमाः साम तदेतदेतस्यामृच्यध्यूढꣳ साम तस्मादृच्यध्यूढꣳ साम गीयते नक्षत्राण्येव सा चन्द्रमा अमस्तत्साम ॥ ४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 50,
    "base_unit_id": "Ch_C01_S06_V04"
  },
  {
    "id": 16705051,
    "chapter_id": 6105,
    "verse_number": "1.51",
    "content_sanskrit": "अथ यदेतदादित्यस्य शुक्लं भाः सैवर्गथ यन्नीलं परः कृष्णं तत्साम तदेतदेतस्यामृच्यध्यूढꣳ साम तस्मादृच्यध्यूढꣳ साम गीयते ॥ ५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 51,
    "base_unit_id": "Ch_C01_S06_V05"
  },
  {
    "id": 16705052,
    "chapter_id": 6105,
    "verse_number": "1.52",
    "content_sanskrit": "अथ यदेवैतदादित्यस्य शुक्लं भाः सैव साथ यन्नीलं परः कृष्णं तदमस्तत्सामाथ य एषोऽन्तरादित्ये हिरण्मयः पुरुषो दृश्यते हिरण्यश्मश्रुर्हिरण्यकेश आप्रणखात्सर्व एव सुवर्णः ॥ ६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 52,
    "base_unit_id": "Ch_C01_S06_V06"
  },
  {
    "id": 16705053,
    "chapter_id": 6105,
    "verse_number": "1.53",
    "content_sanskrit": "तस्य यथा कप्यासं पुण्डरीकमेवमक्षिणी तस्योदिति नाम स एष सर्वेभ्यः पाप्मभ्य उदित उदेति ह वै सर्वेभ्यः पाप्मभ्यो य एवं वेद ॥ ७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 53,
    "base_unit_id": "Ch_C01_S06_V07"
  },
  {
    "id": 16705054,
    "chapter_id": 6105,
    "verse_number": "1.54",
    "content_sanskrit": "तस्यर्क्च साम च गेष्णौ तस्मादुद्गीथस्तस्मात्त्वेवोद्गातैतस्य हि गाता स एष ये चामुष्मात्पराञ्चो लोकास्तेषां चेष्टे देवकामानां चेत्यधिदैवतम् ॥ ८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 54,
    "base_unit_id": "Ch_C01_S06_V08"
  },
  {
    "id": 16705055,
    "chapter_id": 6105,
    "verse_number": "1.55",
    "content_sanskrit": "अथाध्यात्मं वागेवर्क्प्राणः साम तदेतदेतस्यामृच्यध्यूढꣳ साम तस्मादृच्यध्यूढꣳ साम गीयते । वागेव सा प्राणोऽमस्तत्साम ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 55,
    "base_unit_id": "Ch_C01_S07_V01"
  },
  {
    "id": 16705056,
    "chapter_id": 6105,
    "verse_number": "1.56",
    "content_sanskrit": "चक्षुरेवर्गात्मा साम तदेतदेतस्यामृच्यध्यूढꣳ साम तस्मादृच्यध्यूढꣳ साम गीयते । चक्षुरेव सात्मामस्तत्साम ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 56,
    "base_unit_id": "Ch_C01_S07_V02"
  },
  {
    "id": 16705057,
    "chapter_id": 6105,
    "verse_number": "1.57",
    "content_sanskrit": "श्रोत्रमेवर्ङ्मनः साम तदेतदेतस्यामृच्यध्यूढꣳ साम तस्मादृच्यध्यूढꣳ साम गीयते । श्रोत्रमेव सा मनोऽमस्तत्साम ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 57,
    "base_unit_id": "Ch_C01_S07_V03"
  },
  {
    "id": 16705058,
    "chapter_id": 6105,
    "verse_number": "1.58",
    "content_sanskrit": "अथ यदेतदक्ष्णः शुक्लं भाः सैवर्गथ यम्नीलं परः कृष्णं तत्साम तदेतदेतस्यामृच्यध्यूढꣳ साम तस्मादृच्यध्यूढꣳ साम गीयते । अथ यदेवैतदक्ष्णः शुक्लं भाः सैव साथ यन्नीलं परः कृष्णं तदमस्तत्साम ॥ ४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 58,
    "base_unit_id": "Ch_C01_S07_V04"
  },
  {
    "id": 16705059,
    "chapter_id": 6105,
    "verse_number": "1.59",
    "content_sanskrit": "अथ य एषोऽन्तरक्षिणि पुरुषो दृश्यते सैवर्क्तत्साम तदुक्थं तद्यजुस्तद्ब्रह्म तस्यैतस्य तदेव रूपं यदमुष्य रूपं यावमुष्य गेष्णौ तौ गेष्णौ यन्नाम तन्नाम ॥ ५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 59,
    "base_unit_id": "Ch_C01_S07_V05"
  },
  {
    "id": 16705060,
    "chapter_id": 6105,
    "verse_number": "1.60",
    "content_sanskrit": "स एष ये चैतस्मादर्वाञ्चो लोकास्तेषां चेष्टे मनुष्यकामानां चेति तद्य इमे वीणायां गायन्त्येतं ते गायन्ति तस्मात्ते धनसनयः ॥ ६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 60,
    "base_unit_id": "Ch_C01_S07_V06"
  },
  {
    "id": 16705061,
    "chapter_id": 6105,
    "verse_number": "1.61",
    "content_sanskrit": "अथ य एतदेवं विद्वान्साम गायत्युभौ स गायति सोऽमुनैव स एष ये चामुष्मात्पराञ्चो लोकास्ताꣳश्चाप्नोति देवकामाꣳश्च ॥ ७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 61,
    "base_unit_id": "Ch_C01_S07_V07"
  },
  {
    "id": 16705062,
    "chapter_id": 6105,
    "verse_number": "1.62",
    "content_sanskrit": "अथानेनैव ये चैतस्मादर्वाञ्चो लोकास्ताꣳश्चाप्नोति मनुष्यकामाꣳश्च तस्मादु हैवंविदुद्गाता ब्रूयात् ॥ ८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 62,
    "base_unit_id": "Ch_C01_S07_V08"
  },
  {
    "id": 16705063,
    "chapter_id": 6105,
    "verse_number": "1.63",
    "content_sanskrit": "कं ते काममागायानीत्येष ह्येव कामागानस्येष्टे य एवं विद्वान्साम गायति साम गायति ॥ ९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 63,
    "base_unit_id": "Ch_C01_S07_V09"
  },
  {
    "id": 16705064,
    "chapter_id": 6105,
    "verse_number": "1.64",
    "content_sanskrit": "त्रयो होद्गीथे कुशला बभूवुः शिलकः शालावत्यश्चैकितायनो दाल्भ्यः प्रवाहणो जैवलिरिति ते होचुरुद्गीथे वै कुशलाः स्मो हन्तोद्गीथे कथां वदाम इति ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 64,
    "base_unit_id": "Ch_C01_S08_V01"
  },
  {
    "id": 16705065,
    "chapter_id": 6105,
    "verse_number": "1.65",
    "content_sanskrit": "तथेति ह समुपविविशुः स ह प्रवाहणो जैवलिरुवाच भगवन्तावग्रे वदतां ब्राह्मणयोर्वदतोर्वाचꣳ श्रोष्यामीति ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 65,
    "base_unit_id": "Ch_C01_S08_V02"
  },
  {
    "id": 16705066,
    "chapter_id": 6105,
    "verse_number": "1.66",
    "content_sanskrit": "स ह शिलकः शालावत्यश्चैकितायनं दाल्भ्यमुवाच हन्त त्वा पृच्छानीति पृच्छेति होवाच ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 66,
    "base_unit_id": "Ch_C01_S08_V03"
  },
  {
    "id": 16705067,
    "chapter_id": 6105,
    "verse_number": "1.67",
    "content_sanskrit": "का साम्नो गतिरिति स्वर इति होवाच स्वरस्य का गतिरिति प्राण इति होवाच प्राणस्य का गतिरित्यन्नमिति होवाचान्नस्य का गतिरित्याप इति होवाच ॥ ४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 67,
    "base_unit_id": "Ch_C01_S08_V04"
  },
  {
    "id": 16705068,
    "chapter_id": 6105,
    "verse_number": "1.68",
    "content_sanskrit": "अपां का गतिरित्यसौ लोक इति होवाचामुष्य लोकस्य का गतिरिति न स्वर्गं लोकमति नयेदिति होवाच स्वर्गं वयं लोकं सामाभिसंस्थापयामः स्वर्गसꣳ स्तावꣳ हि सामेति ॥ ५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 68,
    "base_unit_id": "Ch_C01_S08_V05"
  },
  {
    "id": 16705069,
    "chapter_id": 6105,
    "verse_number": "1.69",
    "content_sanskrit": "तꣳ ह शिलकः शालावत्यश्चैकितायनं दाल्भ्यमुवाचाप्रतिष्ठितं वै किल ते दाल्भ्य साम यस्त्वेतर्हि ब्रूयान्मूर्धा ते विपतिष्यतीति मूर्धा ते विपतेदिति ॥ ६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 69,
    "base_unit_id": "Ch_C01_S08_V06"
  },
  {
    "id": 16705070,
    "chapter_id": 6105,
    "verse_number": "1.70",
    "content_sanskrit": "हन्ताहमेतद्भगवत्तो वेदानीति विद्धीति होवाचामुष्य लोकस्य का गतिरित्ययं लोक इति होवाचास्य लोकस्य का गतिरिति न प्रतिष्ठां लोकमति नयेदिति होवाच प्रतिष्ठां वयं लोकꣳ सामाभिसꣳ स्थापयामः प्रतिष्ठासꣳ स्तावꣳ हि सामेति ॥ ७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 70,
    "base_unit_id": "Ch_C01_S08_V07"
  },
  {
    "id": 16705071,
    "chapter_id": 6105,
    "verse_number": "1.71",
    "content_sanskrit": "तꣳ ह प्रवाहणो जैवलिरुवाचान्तवद्वै किल ते शालावत्य साम यस्त्वेतर्हि ब्रूयान्मूर्धा ते विपतिष्यतीति मूर्धा ते विपतेदिति हन्ताहमेतद्भगवत्तो वेदानीति विद्धीति होवाच ॥ ८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 71,
    "base_unit_id": "Ch_C01_S08_V08"
  },
  {
    "id": 16705072,
    "chapter_id": 6105,
    "verse_number": "1.72",
    "content_sanskrit": "अस्य लोकस्य का गतिरित्याकाश इति होवाच सर्वाणि ह वा इमानि भूतान्याकाशादेव समुत्पद्यन्त आकाशं प्रत्यस्तं यन्त्याकाशो ह्येवैभ्यो ज्यायानाकाशः परायणम् ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 72,
    "base_unit_id": "Ch_C01_S09_V01"
  },
  {
    "id": 16705073,
    "chapter_id": 6105,
    "verse_number": "1.73",
    "content_sanskrit": "स एष परोवरीयानुद्गीथः स एषोऽनन्तः परोवरीयो हास्य भवति परोवरीयसो ह लोकाञ्जयति य एतदेवं विद्वान्परोवरीयाꣳसमुद्गीथमुपास्ते ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 73,
    "base_unit_id": "Ch_C01_S09_V02"
  },
  {
    "id": 16705074,
    "chapter_id": 6105,
    "verse_number": "1.74",
    "content_sanskrit": "तꣳ हैतमतिधन्वा शौनक उदरशाण्डिल्यायोक्त्वोवाच यावत्त एनं प्रजायामुद्गीथं वेदिष्यन्ते परोवरीयो हैभ्यस्तावदस्मिंल्लोके जीवनं भविष्यति ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 74,
    "base_unit_id": "Ch_C01_S09_V03"
  },
  {
    "id": 16705075,
    "chapter_id": 6105,
    "verse_number": "1.75",
    "content_sanskrit": "तथामुष्मिंल्लोके लोक इति स य एतमेवं विद्वानुपास्ते परोवरीय एव हास्यास्मिंल्लोके जीवनं भवति तथामुष्मिंल्लोके लोक इति लोके लोक इति ॥ ४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 75,
    "base_unit_id": "Ch_C01_S09_V04"
  },
  {
    "id": 16705076,
    "chapter_id": 6105,
    "verse_number": "1.76",
    "content_sanskrit": "मटचीहतेषु कुरुष्वाचिक्या सह जाययोषस्तिर्ह चाक्रायण इभ्यग्रामे प्रद्राणक उवास ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 76,
    "base_unit_id": "Ch_C01_S10_V01"
  },
  {
    "id": 16705077,
    "chapter_id": 6105,
    "verse_number": "1.77",
    "content_sanskrit": "स हेभ्यं कुल्माषान्खादन्तं बिभिक्षे तꣳ होवाच । नेतोऽन्ये विद्यन्ते यच्च ये म इम उपनिहिता इति ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 77,
    "base_unit_id": "Ch_C01_S10_V02"
  },
  {
    "id": 16705078,
    "chapter_id": 6105,
    "verse_number": "1.78",
    "content_sanskrit": "एतेषां मे देहीति होवाच तानस्मै प्रददौ हन्तानुपानमित्युच्छिष्टं वै मे पीतꣳ स्यादिति होवाच ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 78,
    "base_unit_id": "Ch_C01_S10_V03"
  },
  {
    "id": 16705079,
    "chapter_id": 6105,
    "verse_number": "1.79",
    "content_sanskrit": "न स्विदेतेऽप्युच्छिष्टा इति न वा अजीविष्यमिमानखादन्निति होवाच कामो म उदपानमिति ॥ ४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 79,
    "base_unit_id": "Ch_C01_S10_V04"
  },
  {
    "id": 16705080,
    "chapter_id": 6105,
    "verse_number": "1.80",
    "content_sanskrit": "स ह खादित्वातिशेषाञ्जायाया आजहार साग्र एव सुभिक्षा बभूव तान्प्रतिगृह्य निदधौ ॥ ५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 80,
    "base_unit_id": "Ch_C01_S10_V05"
  },
  {
    "id": 16705081,
    "chapter_id": 6105,
    "verse_number": "1.81",
    "content_sanskrit": "स ह प्रातः सञ्जिहान उवाच यद्बतान्नस्य लभेमहि लभेमहि धनमात्राꣳ राजासौ यक्ष्यते स मा सर्वैरार्त्विज्यैर्वृणीतेति ॥ ६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 81,
    "base_unit_id": "Ch_C01_S10_V06"
  },
  {
    "id": 16705082,
    "chapter_id": 6105,
    "verse_number": "1.82",
    "content_sanskrit": "तं जायोवाच हन्त पत इम एव कुल्माषा इति तान्खादित्वामुं यज्ञं विततमेयाय ॥ ७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 82,
    "base_unit_id": "Ch_C01_S10_V07"
  },
  {
    "id": 16705083,
    "chapter_id": 6105,
    "verse_number": "1.83",
    "content_sanskrit": "तत्रोद्गातॄनास्तावे स्तोष्यमाणानुपोपविवेश स ह प्रस्तोतारमुवाच ॥ ८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 83,
    "base_unit_id": "Ch_C01_S10_V08"
  },
  {
    "id": 16705084,
    "chapter_id": 6105,
    "verse_number": "1.84",
    "content_sanskrit": "प्रस्तोतर्या देवता प्रस्तावमन्वायत्ता तां चेदविद्वान्प्रस्तोष्यसि मूर्धा ते विपतिष्यतीति ॥ ९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 84,
    "base_unit_id": "Ch_C01_S10_V09"
  },
  {
    "id": 16705085,
    "chapter_id": 6105,
    "verse_number": "1.85",
    "content_sanskrit": "एवमेवोद्गातारमुवाचोद्गातर्या देवतोद्गीथमन्वायत्ता तां चेदविद्वानुद्गास्यसि मूर्धा ते विपतिष्यतीति ॥ १० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 85,
    "base_unit_id": "Ch_C01_S10_V10"
  },
  {
    "id": 16705086,
    "chapter_id": 6105,
    "verse_number": "1.86",
    "content_sanskrit": "एवमेव प्रतिहर्तारमुवाच प्रतिहर्तर्या देवता प्रतिहारमन्वायत्ता तां चेदविद्वान्प्रतिहरिष्यसि मूर्धा ते विपतिष्यतीति ते ह समारतास्तूष्णीमासाञ्चक्रिरे ॥ ११ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 86,
    "base_unit_id": "Ch_C01_S10_V11"
  },
  {
    "id": 16705087,
    "chapter_id": 6105,
    "verse_number": "1.87",
    "content_sanskrit": "अथ हैनं यजमान उवाच भगवन्तं वा अहं विविदिषाणीत्युषस्तिरस्मि चाक्रायण इति होवाच ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 87,
    "base_unit_id": "Ch_C01_S11_V01"
  },
  {
    "id": 16705088,
    "chapter_id": 6105,
    "verse_number": "1.88",
    "content_sanskrit": "स होवाच भगवन्तं वा अहमेभिः सर्वैरार्त्विज्यैः पर्यैषिषं भगवतो वा अहमवित्त्यान्यानवृषि ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 88,
    "base_unit_id": "Ch_C01_S11_V02"
  },
  {
    "id": 16705089,
    "chapter_id": 6105,
    "verse_number": "1.89",
    "content_sanskrit": "भगवाꣳस्त्वेव मे सर्वैरार्त्विज्यैरिति तथेत्यथ तर्ह्येत एव समतिसृष्टाः स्तुवतां यावत्त्वेभ्यो धनं दद्यास्तावन्मम दद्या इति तथेति ह यजमान उवाच ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 89,
    "base_unit_id": "Ch_C01_S11_V03"
  },
  {
    "id": 16705090,
    "chapter_id": 6105,
    "verse_number": "1.90",
    "content_sanskrit": "अथ हैनं प्रस्तोतोपससाद प्रस्तोतर्या देवता प्रस्तावमन्वायत्ता तां चेदविद्वान्प्रस्तोष्यसि मूर्धा ते विपतिष्यतीति मा भगवानवोचत्कतमा सा देवतेति ॥ ४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 90,
    "base_unit_id": "Ch_C01_S11_V04"
  },
  {
    "id": 16705091,
    "chapter_id": 6105,
    "verse_number": "1.91",
    "content_sanskrit": "प्राण इति होवाच सर्वाणि ह वा इमानि भूतानि प्राणमेवाभिसंविशन्तिप्राणमभ्युज्जिहते सैषा देवता प्रस्तावमन्वायत्ता तां चेदविद्वान्प्रास्तोष्यो मूर्धा ते व्यपतिष्यत्तथोक्तस्य मयेति ॥ ५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 91,
    "base_unit_id": "Ch_C01_S11_V05"
  },
  {
    "id": 16705092,
    "chapter_id": 6105,
    "verse_number": "1.92",
    "content_sanskrit": "अथ हैनमुद्गातोपससादोद्गातर्या देवतोद्गीथमन्वायत्ता तां चेदविद्वानुद्गास्यसि मूर्धा ते विपतिष्यतीति मा भगवानवोचत्कतमा सा देवतेति ॥ ६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 92,
    "base_unit_id": "Ch_C01_S11_V06"
  },
  {
    "id": 16705093,
    "chapter_id": 6105,
    "verse_number": "1.93",
    "content_sanskrit": "आदित्य इति होवाच सर्वाणि ह वा इमानि भूतान्यादित्यमुच्चैः सन्तं गायन्ति सैषा देवतोद्गीथमन्वायत्ता तां चेतविद्वानुदगास्यो मूर्धा ते व्यपतिष्यत्तथोक्तस्य मयेति ॥ ७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 93,
    "base_unit_id": "Ch_C01_S11_V07"
  },
  {
    "id": 16705094,
    "chapter_id": 6105,
    "verse_number": "1.94",
    "content_sanskrit": "अथ हैनं प्रतिहर्तोपससाद प्रतिहर्तर्या देवता प्रतिहारमन्वायत्ता तां चेदविद्वान्प्रतिहरिष्यसि मूर्धा ते विपतिष्यतीति मा भगवानवोचत्कतमा सा देवतेति ॥ ८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 94,
    "base_unit_id": "Ch_C01_S11_V08"
  },
  {
    "id": 16705095,
    "chapter_id": 6105,
    "verse_number": "1.95",
    "content_sanskrit": "अन्नमिति होवाच सर्वाणि ह वा इमानि भूतान्यन्नमेव प्रतिहरमाणानि जीवन्ति सैषा देवता प्रतिहारमन्वायत्ता तां चेदविद्वान्प्रत्यहरिष्यो मूर्धा ते व्यपतिष्यत्तथोक्तस्य मयेति तथोक्तस्य मयेति ॥ ९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 95,
    "base_unit_id": "Ch_C01_S11_V09"
  },
  {
    "id": 16705096,
    "chapter_id": 6105,
    "verse_number": "1.96",
    "content_sanskrit": "अथातः शौव उद्गीथस्तद्ध बको दाल्भ्यो ग्लावो वा मैत्रेयः स्वाध्यायमुद्वव्राज ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 96,
    "base_unit_id": "Ch_C01_S12_V01"
  },
  {
    "id": 16705097,
    "chapter_id": 6105,
    "verse_number": "1.97",
    "content_sanskrit": "तस्मै श्वा श्वेतः प्रादुर्बभूव तमन्ये श्वान उपसमेत्योचुरन्नं नो भगवानागायत्वशनायामवा इति ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 97,
    "base_unit_id": "Ch_C01_S12_V02"
  },
  {
    "id": 16705098,
    "chapter_id": 6105,
    "verse_number": "1.98",
    "content_sanskrit": "तान्होवाचेहैव मा प्रातरुपसमीयातेति तद्ध बको दाल्भ्यो ग्लावो वा मैत्रेयः प्रतिपालयाञ्चकार ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 98,
    "base_unit_id": "Ch_C01_S12_V03"
  },
  {
    "id": 16705099,
    "chapter_id": 6105,
    "verse_number": "1.99",
    "content_sanskrit": "ते ह यथैवेदं बहिष्पवमानेन स्तोष्यमाणाः सꣳरब्धाः सर्पन्तीत्येवमाससृपुस्ते ह समुपविश्य हिं चक्रुः ॥ ४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 99,
    "base_unit_id": "Ch_C01_S12_V04"
  },
  {
    "id": 16705100,
    "chapter_id": 6105,
    "verse_number": "1.100",
    "content_sanskrit": "ओ३मदा३मों३ पिबा३मों३ देवो वरुणः प्रजापतिः सविता२न्नमहा२हरदन्नपते३ । न्नमिहा२हरा२हरो३मिति ॥ ५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 100,
    "base_unit_id": "Ch_C01_S12_V05"
  },
  {
    "id": 16705101,
    "chapter_id": 6105,
    "verse_number": "1.101",
    "content_sanskrit": "अयं वाव लोको हाउकारो वायुर्हाइकारश्चन्द्रमा अथकारः । आत्मेहकारोऽग्निरीकारः ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 101,
    "base_unit_id": "Ch_C01_S13_V01"
  },
  {
    "id": 16705102,
    "chapter_id": 6105,
    "verse_number": "1.102",
    "content_sanskrit": "आदित्य ऊकारो निहव एकारो विश्वेदेवा औहोयिकारः प्रजापतिर्हिङ्कारः प्राणः स्वरोऽन्नं या वाग्विराट् ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 102,
    "base_unit_id": "Ch_C01_S13_V02"
  },
  {
    "id": 16705103,
    "chapter_id": 6105,
    "verse_number": "1.103",
    "content_sanskrit": "अनिरुक्तस्त्रयोदशः स्तोभः सञ्चरो हुङ्कारः ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
