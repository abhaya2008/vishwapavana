[{"id": 2101095, "chapter_id": 3173, "verse_number": "१४-२९-१", "content_sanskrit": "ब्राह्मण उवाच।\nगन्धान्न जिघ्रामि रासान्न वेद्मि\nरूपं न पश्यामि न च स्पृशामि।\nन चापि शब्दान्विविधाञ्शृणोमि\nन चापि सङ्कल्पमुपैमि कञ्चित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2101096, "chapter_id": 3173, "verse_number": "१४-२९-२", "content_sanskrit": "अर्थानिष्टान्कामयते स्वभावः\nसर्वान्द्वेष्यान्प्रद्विषते स्वभावः।\nकामद्वेषानुद्भवतः स्वभावा-\nत्प्राणापानौ जन्तुदेहान्निवेश्य॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2101097, "chapter_id": 3173, "verse_number": "१४-२९-३", "content_sanskrit": "तेभ्यश्चान्यांस्तेषु नित्यांश्च भावा-\nन्भूतात्मानं अक्षयेऽहं शरीरे।\nतस्मिंस्तिष्ठन्नास्मि सक्तः कथंचि-\nत्कामक्रोधाभ्यां जरया मृत्युना च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2101098, "chapter_id": 3173, "verse_number": "१४-२९-४", "content_sanskrit": "अकामयानस्य च सर्वकामा-\nनविद्विषाणस्य च सर्वदोषान्।\nन मे स्वभावेषु भवन्ति लेपा-\nस्तोयस्य बिन्दोरिव पुष्करेषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2101099, "chapter_id": 3173, "verse_number": "१४-२९-५", "content_sanskrit": "नित्यस्य चैतस्य भवन्ति नित्या\nनिरीक्ष्यमाणस्य बहून्स्वभावान्।\nन सज्जते कर्मसु भोगजालं\nदिवीव सूर्यस्य मयूखजालम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2101100, "chapter_id": 3173, "verse_number": "१४-२९-६", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nअध्वर्युयतिसंवादं तं निबोध यशस्विनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2101101, "chapter_id": 3173, "verse_number": "१४-२९-७", "content_sanskrit": "प्रोक्ष्यमाणं पशुं दृष्ट्वा यज्ञकर्मण्यथाब्रवीत्।\nयतिरध्वर्युमासीनो हिंसोयमिति कुत्सयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2101102, "chapter_id": 3173, "verse_number": "१४-२९-८", "content_sanskrit": "तमध्वर्युः प्रत्युवाच नायं छागो विनश्यति।\nश्रेयसा योक्ष्यते जन्तुर्यज्ञाच्छ्रुतिरियं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2101103, "chapter_id": 3173, "verse_number": "१४-२९-९", "content_sanskrit": "यो ह्यस्य पार्थिवो भागः पृथिवीं स गमिष्यति।\nयदस्य वारिजं किञ्चिदपस्तत्सम्प्रवेक्ष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2101104, "chapter_id": 3173, "verse_number": "१४-२९-१०", "content_sanskrit": "सूर्यं चक्षुर्दिशः श्रोत्रे प्राणोऽस्य दिवमेव च।\nआगमे वर्तमानस्य नमे दोषोस्ति कश्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2101105, "chapter_id": 3173, "verse_number": "१४-२९-११x", "content_sanskrit": "यतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2101106, "chapter_id": 3173, "verse_number": "१४-२९-११", "content_sanskrit": "प्राणैर्वियोगे च्छागस्य यदि श्रेयः प्रपश्यसि।\nछागार्थे वर्तते यज्ञो भवतः किं प्रयोजनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2101107, "chapter_id": 3173, "verse_number": "१४-२९-१२", "content_sanskrit": "अनु त्वां मन्यते माता अनु त्वां मन्यते पिता।\nमन्त्रविज्ञानमुन्नीय परिवर्ते विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2101108, "chapter_id": 3173, "verse_number": "१४-२९-१३", "content_sanskrit": "एवमेवानुमन्येरंस्तान्भवान्द्रष्टुमर्हति।\nतेषामनुमतिं श्रुत्वा शक्या कर्तुं विचारणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2101109, "chapter_id": 3173, "verse_number": "१४-२९-१४x", "content_sanskrit": "अध्वर्युरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2101110, "chapter_id": 3173, "verse_number": "१४-२९-१४", "content_sanskrit": "प्राणा अप्यस्य च्छागस्य प्रापितास्ते स्वयोनिषु।\nशरीरं केवलं शिष्टं निश्चेष्टमिति मे मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2101111, "chapter_id": 3173, "verse_number": "१४-२९-१५", "content_sanskrit": "इन्धनस्य तु तुल्येन शरीरेणि विचेतसा।\nहिंसा हि यष्टुकामानामिन्धनं पशुसंज्ञितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2101112, "chapter_id": 3173, "verse_number": "१४-२९-१६", "content_sanskrit": "अहिंसा सर्वधर्माणामिति वृद्धानुशासनम्।\nयदहिंस्रं भवेत्कर्म तत्कार्यमिति विद्महे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2101113, "chapter_id": 3173, "verse_number": "१४-२९-१७", "content_sanskrit": "अहिंसेति प्रतिज्ञेयं यदि वक्ष्याम्यतः परम्।\nशक्यं बहुविधं वक्तुं भवता कार्यदूषणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2101114, "chapter_id": 3173, "verse_number": "१४-२९-१८", "content_sanskrit": "अहिंसा सर्वभूतानां नित्यमस्मासु रोचते।\nप्रत्यक्षतः साधयामो न परोक्षमुपास्महे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2101115, "chapter_id": 3173, "verse_number": "१४-२९-१९x", "content_sanskrit": "अध्वर्यरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2101116, "chapter_id": 3173, "verse_number": "१४-२९-१९", "content_sanskrit": "भूमेर्गन्धगुणान्भुङ्क्ष्व पिबस्यापोमयान्रसान्।\nज्योतिषां पश्यते रूपं स्पृशस्यनिलजान्गुणान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2101117, "chapter_id": 3173, "verse_number": "१४-२९-२०", "content_sanskrit": "शृणोष्याकाशजाञ्शब्दान्मनसा मन्यसे मतिम्।\nसर्वाण्येतानि भूतानि प्राणा इति च मन्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2101118, "chapter_id": 3173, "verse_number": "१४-२९-२१", "content_sanskrit": "प्राणादाने निवृत्तोसि हिंसायां वर्तते भवान्।\nनास्ति चेष्टा विना हिंसां किं वा त्वं मन्यसे द्विज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2101119, "chapter_id": 3173, "verse_number": "१४-२९-२२x", "content_sanskrit": "यतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2101120, "chapter_id": 3173, "verse_number": "१४-२९-२२", "content_sanskrit": "अक्षरं च क्षरं चैव द्वैधीभावोऽयमात्मनः।\nअक्षरं तत्र सद्भावः स्वभावः क्षर उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2101121, "chapter_id": 3173, "verse_number": "१४-२९-२३", "content_sanskrit": "प्राणो जिह्वा मनः सत्त्वं सद्भावो रजसा सह।\nभावैरेतैर्विमुक्तस्य निर्द्वन्द्वस्य निराशिषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2101122, "chapter_id": 3173, "verse_number": "१४-२९-२४", "content_sanskrit": "समस्य सर्वभूतेषु निर्ममस्य जितात्मनः।\nसमन्तात्परिमुक्तस्य न भयं विद्यते क्वचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2101123, "chapter_id": 3173, "verse_number": "१४-२९-२५x", "content_sanskrit": "अध्वर्युरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2101124, "chapter_id": 3173, "verse_number": "१४-२९-२५", "content_sanskrit": "सद्भिरेवेह संवादः कार्यो मतिमतांवर।\nभवतो हि मतं श्रुत्वा प्रतिभाति मतिर्मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2101125, "chapter_id": 3173, "verse_number": "१४-२९-२६", "content_sanskrit": "भगवन्भगवद्बुद्ध्या प्रतिबुद्धो ब्रवीम्यहम्।\nव्रतं मन्त्रकृतं कर्तुर्नापराधोस्ति मे द्विज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2101126, "chapter_id": 3173, "verse_number": "१४-२९-२७x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2101127, "chapter_id": 3173, "verse_number": "१४-२९-२७", "content_sanskrit": "उपपत्त्या यतिस्तूष्णीं वर्तमानस्ततः परम्।\nअध्वर्युरपि निर्मोहः प्रचचार महामखे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2101128, "chapter_id": 3173, "verse_number": "१४-२९-२८", "content_sanskrit": "एवमेतादृशं मोक्षं सुसूक्ष्मं ब्राह्मणा विदुः।\nविदित्वा चानुतिष्ठन्ति क्षेत्रज्ञेनार्थदर्शिना॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2101129, "chapter_id": 3173, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेदिकपर्वणि अनुगीतापर्वणि एकोनत्रिंशोऽध्यायः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]