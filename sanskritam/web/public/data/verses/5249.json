[{"id": 2199730, "chapter_id": 5249, "verse_number": "", "content_sanskrit": "नृगोपाख्यानम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2199731, "chapter_id": 5249, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2199732, "chapter_id": 5249, "verse_number": "१", "content_sanskrit": "अत्रैव कीर्त्यते सद्भिर्ब्राह्मणस्वाभिमर्शने ।\nनृगेण सुमहत् कृच्छ्रं यदवाप्तं कुरूद्वह\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2199733, "chapter_id": 5249, "verse_number": "२", "content_sanskrit": "निविशन्त्यां पुरा पार्थ द्वारवत्यामिति श्रुतिः ।\nअदृश्यत महाकूपस्तृणवीरुत्समावृतः\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2199734, "chapter_id": 5249, "verse_number": "३", "content_sanskrit": "प्रयत्नं तत्र कुर्वाणास्तस्मात् कूपाज्जलार्थिनः ।\nश्रमेण महता युक्तास्तस्मिंस्तोये सुसंवृते\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2199735, "chapter_id": 5249, "verse_number": "४", "content_sanskrit": "ददृशुस्ते महाकायं कृकलासमवस्थितम् ।\nतस्य चोद्धरणे यत्नमकुर्वंस्ते सहस्रशः\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2199736, "chapter_id": 5249, "verse_number": "५", "content_sanskrit": "प्रग्रहैश्चर्मपट्टैश्च तं बद्ध्वा पर्वतोपमम् ।\nनाशक्नुवन् समुद्धर्तुं ततो जग्मुर्जनार्दनम्\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2199737, "chapter_id": 5249, "verse_number": "६", "content_sanskrit": "खमावृत्योदपानस्य कृकलासः स्थितो महान् ।\nतस्य नास्ति समुद्धर्तेत्यथ कृष्णे न्यवेदयन्\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2199738, "chapter_id": 5249, "verse_number": "७", "content_sanskrit": "स वासुदेवेन समुद्धृतश्च\nपृष्टश्च कामान्निजगाद राजा ।\nनृगस्तदात्मानमथो न्यवेदयत्\nपुरातनं यज्ञसहस्रयाजिनम् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2199739, "chapter_id": 5249, "verse_number": "८", "content_sanskrit": "तथा ब्रुवाणं तु तमाह माधवः\nशुभं त्वया कर्म कृतं न पापकम् ।\nकथं भवान् दुर्गतिमीदृशीं गतो\nनरेन्द्र तद् ब्रूहि किमेतदीदृशम् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2199740, "chapter_id": 5249, "verse_number": "९", "content_sanskrit": "शतं सहस्राणि शतं गवां पुनः\nपुनः शतान्यष्ट शतायुतानि ।\nत्वया पुरा दत्तमितीह शुश्रुम\nनृप द्विजेभ्यः क्व नु तद् गतं तव \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2199741, "chapter_id": 5249, "verse_number": "१०", "content_sanskrit": "नृगस्ततोऽब्रवीत् कृष्णं ब्राह्मणस्याग्निहोत्रिणः ।\nप्रोषितस्य परिभ्रष्टा गौरेका मम गोधने\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2199742, "chapter_id": 5249, "verse_number": "११", "content_sanskrit": "गवां सहस्रे सङ्ख्याता तदा सा पशुपैर्मम ।\nसा ब्राह्मणाय मे दत्ता प्रेत्यार्थमभिकाङ्क्षता\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2199743, "chapter_id": 5249, "verse_number": "१२", "content_sanskrit": "अपश्यत् परिमार्गंश्च तां यां परगृहे द्विजः ।\nममेयमिति चोवाच ब्राह्मणो यस्य साऽभवत्\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2199744, "chapter_id": 5249, "verse_number": "१३", "content_sanskrit": "तावुभौ समनुप्राप्तौ विवदन्तौ भृशज्वरौ ।\nभवान् दाता भवान् हर्तेत्यथ तौ मां तदोचतुः\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2199745, "chapter_id": 5249, "verse_number": "१४", "content_sanskrit": "शतेन शतसङ्ख्येन गवां विनिमयेन वै ।\nयाचे प्रतिग्रहीतारं स तु मामब्रवीदिदम्\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2199746, "chapter_id": 5249, "verse_number": "१५", "content_sanskrit": "देशकालोपसम्पन्ना दोग्ध्री क्षान्ताऽतिवत्सला ।\nस्वादुक्षीरप्रदा धन्या मम नित्यं निवेशने\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2199747, "chapter_id": 5249, "verse_number": "१६", "content_sanskrit": "कृशं च भरते या गौर्मम पुत्रमपस्तनम् ।\nन सा शक्या मया हातुमित्युक्त्वा स जगाम ह\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2199748, "chapter_id": 5249, "verse_number": "१७", "content_sanskrit": "ततस्तमपरं विप्रं याचे विनिमयेन वै ।\nगवां शतसहस्रं वै तत्कृते गृह्यतामिति\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2199749, "chapter_id": 5249, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2199750, "chapter_id": 5249, "verse_number": "१८", "content_sanskrit": "न राज्ञां प्रतिगृह्णामि शक्तोऽहं स्वस्य मार्गणे ।\nसैव गौर्दीयतां शीघ्रं ममेति मधुसूदन\t ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2199751, "chapter_id": 5249, "verse_number": "१९", "content_sanskrit": "रुग्ममश्वांश्च ददतो रजतं स्यन्दनांस्तथा ।\nन जग्राह ययौ चापि तदा स ब्राह्मणर्षभः\t ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2199752, "chapter_id": 5249, "verse_number": "२०", "content_sanskrit": "एतस्मिन्नेव काले तु चोदितः कालधर्मणा ।\nपितृलोकमहं प्राप्य धर्मराजमुपागमम्\t ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2199753, "chapter_id": 5249, "verse_number": "२१", "content_sanskrit": "यमस्तु पूजयित्वा मां ततो वचनमब्रवीत् ।\nनान्तः सङ्ख्यायते राजंस्तव पुण्यस्य कर्मणः\t ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2199754, "chapter_id": 5249, "verse_number": "२२", "content_sanskrit": "अस्ति चैव कृतं पापमज्ञानात् तदपि त्वया ।\nचरस्व पापं पश्चाद्वा पूर्वं वा त्वं यथेच्छसि\t ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2199755, "chapter_id": 5249, "verse_number": "२३", "content_sanskrit": "रक्षितास्मीति चोक्तं ते प्रतिज्ञा चानृता तव ।\nब्राह्मणस्वस्य चादानं त्रिविधस्ते व्यतिक्रमः\t ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2199756, "chapter_id": 5249, "verse_number": "२४", "content_sanskrit": "पूर्वं कृच्छ्रं चरिष्येऽहं पश्चाच्छुभमिति प्रभो ।\nधर्मराजं ब्रुवन्नेवं पतितोऽस्मि महीतळे\t ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2199757, "chapter_id": 5249, "verse_number": "२५", "content_sanskrit": "अश्रौषं प्रच्युतश्चाहं यमस्योच्चैः प्रभाषतः ।\nवासुदेवः समुद्धर्ता भविता ते जनार्दनः\t ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2199758, "chapter_id": 5249, "verse_number": "२६", "content_sanskrit": "पूर्णे वर्षसहस्रान्ते क्षीणे कर्मणि दुष्कृते ।\nप्राप्स्यसे शाश्वताँल्लोकान् जितान् स्वेनैव कर्मणा\t ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2199759, "chapter_id": 5249, "verse_number": "२७", "content_sanskrit": "कूपेऽऽत्मानमधःशीर्षमपश्यं पतितं च ह ।\nतिर्यग्योनिमनुप्राप्तं न तु मामजहात् स्मृतिः\t ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2199760, "chapter_id": 5249, "verse_number": "२८", "content_sanskrit": "त्वया तु तारितोऽस्म्यद्य किमन्यत्र तपोबलात् ।\nअनुजानीहि मां कृष्ण गच्छेयं दिवमद्य वै\t ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2199761, "chapter_id": 5249, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2199762, "chapter_id": 5249, "verse_number": "२९", "content_sanskrit": "अनुज्ञातः स कृष्णेन नमस्कृत्य जनार्दनम् ।\nविमानं दिव्यमास्थाय ययौ दिवमरिन्दम\t ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2199763, "chapter_id": 5249, "verse_number": "३०", "content_sanskrit": "ततस्तस्मिन् दिवं प्राप्ते नृगे भरतसत्तम ।\nवासुदेव इमं श्लोकं जगाद कुरुनन्दन\t ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2199764, "chapter_id": 5249, "verse_number": "३१", "content_sanskrit": "ब्राह्मणस्वं न हर्तव्यं पुरुषेण विजानता ।\nब्राह्मणस्वं हृतं हन्ति नृगं ब्राह्मणगौरिव\t ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2199765, "chapter_id": 5249, "verse_number": "३२", "content_sanskrit": "सतां समागमः सद्भिर्नाफलः पार्थ विद्यते ।\nविमुक्तं नरकात् पश्य नृगं साधुसमागमात्\t ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2199766, "chapter_id": 5249, "verse_number": "३३", "content_sanskrit": "प्रदानं फलवत् तत्र द्रोहस्तत्र तथाऽफलः ।\nअपचारं गवां तस्माद् वर्जयेत युधिष्ठिर\t ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2199767, "chapter_id": 5249, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम्\nअनुशासनपर्वणि दानधर्मे नृगोपाख्यानं नाम शततमोऽध्यायः ॥१००॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]