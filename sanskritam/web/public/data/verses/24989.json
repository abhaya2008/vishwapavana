[{"id": 7004989000, "chapter_id": 24989, "verse_number": "७-१-१७२-१", "content_sanskrit": "ईश्वर उवाच ।\nततो गच्छेन्महा देवि लिंगं तद्भरतेश्वरम् ।\nतस्मादुत्तरकोणस्थं नातिदूरं व्यवस्थितम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004989001, "chapter_id": 24989, "verse_number": "७-१-१७२-२", "content_sanskrit": "भरतोनाम राजाऽभूदाग्नीध्रः प्रथितः क्षितौ ।\nयस्येदं भारतं वर्षं नाम्ना लोकेषु गीयते ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004989002, "chapter_id": 24989, "verse_number": "७-१-१७२-३", "content_sanskrit": "स च चक्रे तपो घोरं क्षेत्रेऽस्मिन्पार्वति प्रिये ।\nदिव्यं वर्षसहस्रं तु प्रतिष्ठाप्य महेश्वरम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004989003, "chapter_id": 24989, "verse_number": "७-१-१७२-४", "content_sanskrit": "पुत्रकामो नरश्रेष्ठः पूजयामास शंकरम् ।\nततस्तुष्टः स भगवान्वरं दातुं समुत्सुकः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004989004, "chapter_id": 24989, "verse_number": "७-१-१७२-५", "content_sanskrit": "अष्टौ पुत्रान्ददौ तस्मै कन्यां चैकां यशस्विनीम् ।\nस तु प्राप्याभिलषितं कृतकृत्यो नराधिपः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004989005, "chapter_id": 24989, "verse_number": "७-१-१७२-६", "content_sanskrit": "भारतं नवधा कृत्वा पुत्रेभ्यः प्रददौ पृथक् ।\nतेषां नामांकितान्येव ततो द्वीपानि जज्ञिरे ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004989006, "chapter_id": 24989, "verse_number": "७-१-१७२-७", "content_sanskrit": "इन्द्रद्वीपः कसेरुश्च ताम्रवर्णो गभस्तिमान् ।\nनागद्वीपस्तथा सौम्यो गान्धर्वस्त्वथ चारुणः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004989007, "chapter_id": 24989, "verse_number": "७-१-१७२-८", "content_sanskrit": "अयं तु नवमो द्वीपः कुमार्या संज्ञितः प्रिये ।\nअष्टौ द्वीपाः समुद्रेण प्लाविताश्च तथापरे ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004989008, "chapter_id": 24989, "verse_number": "७-१-१७२-९", "content_sanskrit": "ग्रामादिदेशसंयुक्ताः स्थिताः सागरमध्यगाः ।\nएक एव स्थितस्तेषां कुमार्याख्यस्तु सांप्रतम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004989009, "chapter_id": 24989, "verse_number": "७-१-१७२-१०", "content_sanskrit": "बिंदुसरः प्रभृत्येव सागराद्दक्षिणोत्तरम् ।\nयोजनानां सहस्रं तु एकं विस्तीर्ण एव तु ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004989010, "chapter_id": 24989, "verse_number": "७-१-१७२-११", "content_sanskrit": "योजनानां सहस्राणि नव दैर्घ्यं प्रकीर्तितम् ।\nतस्यैतज्जृम्भितं देवि भरतस्य महात्मनः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004989011, "chapter_id": 24989, "verse_number": "७-१-१७२-१२", "content_sanskrit": "षट्पञ्चाशदश्वमेधान्गंगामनु चकार यः ।\nयस्त्रिंशद्यमुनाप्रान्ते भरतो लोकपूजितः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004989012, "chapter_id": 24989, "verse_number": "७-१-१७२-१३", "content_sanskrit": "स चेश्वरप्रसादेन मोदते दिवि देववत् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004989013, "chapter_id": 24989, "verse_number": "७-१-१७२-१४", "content_sanskrit": "यस्तत्प्रतिष्ठितं लिंगं भारतं पूजयिष्यति ।\nस सर्वयज्ञदानानां फलं प्रापयिता धुवम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004989014, "chapter_id": 24989, "verse_number": "७-१-१७२-१५", "content_sanskrit": "कार्त्तिक्यां कृत्तिका योगे यस्तं पश्यति मानवः ।\nन स पश्यति स्वप्नेपि नरकं घोरदारुणम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004989015, "chapter_id": 24989, "verse_number": "७-१-१७२-१६", "content_sanskrit": "इति श्रीस्कान्दे महापुराण एकाशीतिसाहस्र्यां संहितायां सप्तमे प्रभासखण्डे प्रथमे प्रभासक्षेत्रमाहात्म्ये भरतेश्वरमाहात्म्यवर्णनंनाम द्विसप्तत्युत्तरशततमोऽध्यायः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]