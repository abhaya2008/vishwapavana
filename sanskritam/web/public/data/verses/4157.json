[{"id": 2146313, "chapter_id": 4157, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2146314, "chapter_id": 4157, "verse_number": "१", "content_sanskrit": "अथोपगम्य विदुरमपराह्णे जनार्दनः ।\nपितृष्वसारं स पृथामभ्यगच्छदरिन्दमः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2146315, "chapter_id": 4157, "verse_number": "२", "content_sanskrit": "सा दृष्ट्वा कृष्णमायान्तं प्रसन्नादित्यवर्चसम् ।\nकण्ठे गृहीत्वा प्राक्रोशत् स्मरन्ती तनयान् पृथा\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2146316, "chapter_id": 4157, "verse_number": "३", "content_sanskrit": "तेषां सत्ववतां मध्ये गोविन्दं सहचारिणम् ।\nचिरस्य दृष्ट्वा वार्ष्णेयं बाष्पमाहारयत् पृथा\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2146317, "chapter_id": 4157, "verse_number": "४", "content_sanskrit": "साऽब्रवीत् कृष्णमासीनं कृतातिथ्यं युधाम्पतिम् ।\nबाष्पगद्गदपूर्णेन मुखेन परिशुष्यता\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2146318, "chapter_id": 4157, "verse_number": "५", "content_sanskrit": "एते बाल्यात् प्रभृत्येव गुरुशुश्रूषणे रताः ।\nपरस्परस्य सुहृदः सम्मताः समचेतसः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2146319, "chapter_id": 4157, "verse_number": "६", "content_sanskrit": "निकृत्या भ्रंशिता राज्यात् जनार्हा निर्जनं गताः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2146320, "chapter_id": 4157, "verse_number": "७", "content_sanskrit": "विजितक्रोधहर्षाश्च ब्रह्मण्याः सत्यवादिनः ।\nत्यक्त्वा प्रियसुखे पार्था रुदतीमपहाय माम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2146321, "chapter_id": 4157, "verse_number": "८", "content_sanskrit": "अहार्षुश्च वनं यान्तः समूलं हृदयं मम\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2146322, "chapter_id": 4157, "verse_number": "९", "content_sanskrit": "अतदर्हा महात्मानः कथं केशव पाण्डवाः ।\nऊषुर्महावने तात सिंहव्याघ्रगजाकुले\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2146323, "chapter_id": 4157, "verse_number": "१०", "content_sanskrit": "बाला विहीनाः पित्रा मे मया सततलाळिताः ।\nअपश्यन्तश्च पितरौ कथमूषुर्महावने\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2146324, "chapter_id": 4157, "verse_number": "११", "content_sanskrit": "शङ्खदुन्दुभिनिर्घोषैर्मृदङ्गैर्वैणवैरपि ।\nपाण्डवाः समबोध्यन्त बाल्यात्प्रभृति केशव\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2146325, "chapter_id": 4157, "verse_number": "१२", "content_sanskrit": "ये स्म वारणशब्देन हयानां ह्रेषितेन च ।\nरथनेमिनिनादैश्च व्यबोध्यन्त सदा गृहे\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2146326, "chapter_id": 4157, "verse_number": "१३", "content_sanskrit": "पुण्याहघोषमिश्रैश्च पूज्यमाना द्विजातिभिः ।\nवस्त्रै रत्नैरलङ्कारैः पूजयन्तो द्विजन्मनः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2146327, "chapter_id": 4157, "verse_number": "१४", "content_sanskrit": "गीर्भिर्मङ्गलयुक्ताभिः ब्राह्मणानां महात्मनाम् ।\nअर्चितैरर्चनार्हैश्च स्तुवद्भिरभिनन्दिताः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2146328, "chapter_id": 4157, "verse_number": "१५", "content_sanskrit": "प्रासादाग्रेष्वबोध्यन्त राङ्कवाजिनशायिनः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2146329, "chapter_id": 4157, "verse_number": "१६", "content_sanskrit": "क्रूरं च निनदं श्रुत्वा श्वापदानां महावने ।\nन स्मोपयान्ति निद्रां ते नतदर्हा जनार्दन\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2146330, "chapter_id": 4157, "verse_number": "१७", "content_sanskrit": "भेरीमृदङ्गपणवैः शङ्खवैणवनिस्वनैः ।\nस्त्रीणां गीतिनिनादैश्च मधुरैर्मधुसूदन\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2146331, "chapter_id": 4157, "verse_number": "१८", "content_sanskrit": "वन्दिमागधसूतैश्च स्तुवद्भिर्बोधिताः कथम् ।\nमहावनेष्वबोध्यन्त श्वापदानां रुतैस्तु ते\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2146332, "chapter_id": 4157, "verse_number": "१९", "content_sanskrit": "ह्रीमान् सत्यधृतिर्दान्तो भूतानामनुकम्पिता ।\nकामद्वेषौ वशे कृत्वा सतां वर्त्मानुवर्तते\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2146333, "chapter_id": 4157, "verse_number": "२०", "content_sanskrit": "अम्बरीषस्य मान्धातुः ययातेर्नहुषस्य च ।\nभरतस्य दिलीपस्य शिबेरौशीनरस्य च\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2146334, "chapter_id": 4157, "verse_number": "२१", "content_sanskrit": "राजर्षीणां पुराणानां धुरं धुर्य इवोद्वहन् ।\nशीलवृत्तोपसम्पन्नो धर्मज्ञः सत्यसङ्गरः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2146335, "chapter_id": 4157, "verse_number": "२२", "content_sanskrit": "राजा सर्वगुणोपेतः त्रैलोक्यस्यापि यो भवेत् ।\nअजातशत्रुर्धर्मात्मा शुद्धजाम्बूनदप्रभः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2146336, "chapter_id": 4157, "verse_number": "२३", "content_sanskrit": "श्रेष्ठः कुरुषु सर्वेषु धर्मज्ञः श्रुतवित्तमः ।\nसुदर्शनो दीर्घबाहुः कथं कृष्ण युधिष्ठिरः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2146337, "chapter_id": 4157, "verse_number": "२४", "content_sanskrit": "यः स नागायुतप्राणो वातरंहा वृकोदरः ।\nसामर्षः पाण्डवो नित्यं प्रियो भ्रातुः प्रियङ्करः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2146338, "chapter_id": 4157, "verse_number": "२५", "content_sanskrit": "कीचकस्य तु सज्ञातेः यो हन्ता मधुसूदन ।\nशूरः क्रोधवशानां च हिडिम्बस्य बकस्य च\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2146339, "chapter_id": 4157, "verse_number": "२६", "content_sanskrit": "पराक्रमे शक्रसमो वायुवेगसमो जवे ।\nमहेश्वरसमः क्रोधे भीमः प्रहरतां वरः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2146340, "chapter_id": 4157, "verse_number": "२७", "content_sanskrit": "क्रोधं बलममर्षं च यो निधाय परन्तपः ।\nजितात्मा पाण्डवोऽमर्षी भ्रातुस्तिष्ठति शासने\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2146341, "chapter_id": 4157, "verse_number": "२८", "content_sanskrit": "तेजोराशिं महात्मानं बलौघममितौजसम् ।\nभीमं प्रदर्शनेनापि भीमसेनं जनार्दन\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2146342, "chapter_id": 4157, "verse_number": "२९", "content_sanskrit": "तं ममाचक्ष्व वार्ष्णेय कथमद्य वृकोदरः ।\nआस्ते परिघबाहुः स मध्यमः पाण्डवोऽच्युत\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2146343, "chapter_id": 4157, "verse_number": "३०", "content_sanskrit": "अर्जुनेनार्जुनो योऽसौ कृष्ण बाहुसहस्रिणा ।\nद्विबाहुः स्पर्धते नित्यमतीतेनापि केशव\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2146344, "chapter_id": 4157, "verse_number": "३१", "content_sanskrit": "क्षिपत्येकेन वेगेन पञ्चबाणशतानि यः ।\nइष्वस्त्रे सदृशो राज्ञः कार्तवीर्यस्य पाण्डवः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2146345, "chapter_id": 4157, "verse_number": "३२", "content_sanskrit": "तेजसाऽऽदित्यसदृशो महर्षिप्रतिमो दमे ।\nक्षमया पृथिवीतुल्यो महेन्द्रसमविक्रमः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2146346, "chapter_id": 4157, "verse_number": "३३", "content_sanskrit": "आधिराज्यं महद् दीप्तं पार्थिवं मधुसूदन ।\nआहृतं येन विक्रम्य कुरूणां सर्वराजसु\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2146347, "chapter_id": 4157, "verse_number": "३४", "content_sanskrit": "यस्य बाहुबलं घोरं कौरवाः पर्युपासते ।\nस सर्वरथिनां श्रेष्ठः पाण्डवः सत्यविक्रमः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2146348, "chapter_id": 4157, "verse_number": "३५", "content_sanskrit": "यं गत्वाऽभिमुखः सङ्खे न जीवन् कश्चिदाव्रजेत् ।\nयो जेता सर्वभूतानामजेयो जिष्णुरच्युत\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2146349, "chapter_id": 4157, "verse_number": "३६", "content_sanskrit": "योऽपाश्रयः पाण्डवानां देवानामिव वासवः ।\nस ते भ्राता सखा चैव कथमद्य धनञ्जयः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2146350, "chapter_id": 4157, "verse_number": "३७", "content_sanskrit": "दयावान् सर्वभूतेषु ह्रीनिषेवो महास्त्रवित् ।\nमृदुश्च सुकुमारश्च धार्मिकश्च प्रियश्च मे\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2146351, "chapter_id": 4157, "verse_number": "३८", "content_sanskrit": "सहदेवो महेष्वासः शूरः समितिशोभनः ।\nभ्रातॄणां कृष्ण शुश्रूषुः धर्मार्थकुशलो युवा\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2146352, "chapter_id": 4157, "verse_number": "३९", "content_sanskrit": "सदैव सहदेवस्य भ्रातरो मधुसूदन ।\nवृत्तं कल्याणवृत्तस्य पूजयन्ति महात्मनः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2146353, "chapter_id": 4157, "verse_number": "४०", "content_sanskrit": "ज्येष्ठोपचायिनं वीरं सहदेवं युधाम्पतिम् ।\nशुश्रूषुं मम वार्ष्णेय माद्रीपुत्रं प्रचक्ष्व मे\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2146354, "chapter_id": 4157, "verse_number": "४१", "content_sanskrit": "सुकुमारो युवा शूरो दर्शनीयश्च पाण्डवः ।\nभ्रातॄणां कृष्ण सर्वेषां प्रियः प्राणो बहिश्चरः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2146355, "chapter_id": 4157, "verse_number": "४२", "content_sanskrit": "चित्रयोधी च नकुलो महेष्वासो महाबलः ।\nकच्चित् स कुशली कृष्ण वत्सो मम सुखैधितः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2146356, "chapter_id": 4157, "verse_number": "४३", "content_sanskrit": "सुखोचितमदुःखार्हं सुकुमारं महारथम् ।\nअपि जातु महाबाहो पश्येयं नकुलं पुनः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2146357, "chapter_id": 4157, "verse_number": "४४", "content_sanskrit": "पक्ष्मसम्पातजे काले नकुलेन विनाकृता ।\nन लभामि सुखं वीर साऽद्य जीवामि पश्य माम्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2146358, "chapter_id": 4157, "verse_number": "४५", "content_sanskrit": "सर्वैः पुत्रैः प्रियतरा द्रौपदी मे जनार्दन ।\nकुलीना शीलसम्पन्ना सर्वैः समुदिता गुणैः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2146359, "chapter_id": 4157, "verse_number": "४६", "content_sanskrit": "पुत्री द्रुपदराजस्य विख्याता सत्यवादिनी ।\nपतिलोकान् पुत्रलोकान् वृण्वाना सत्यवादिनी\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2146360, "chapter_id": 4157, "verse_number": "४७", "content_sanskrit": "प्रियान् पुत्रान् परित्यज्य पाण्डवानन्ववर्तत\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2146361, "chapter_id": 4157, "verse_number": "४८", "content_sanskrit": "महाभिजनसम्पन्ना सर्वकामैः सुखैधिता ।\nईश्वरी सर्वकल्याणी द्रौपदी कथमच्युत\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2146362, "chapter_id": 4157, "verse_number": "४९", "content_sanskrit": "पतिभिः पञ्चभिः शूरैरग्निकल्पैः प्रहारिभिः ।\nउपपन्ना महेष्वासैः द्रौपदी दुःखभागिनी\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2146363, "chapter_id": 4157, "verse_number": "५०", "content_sanskrit": "चतुर्दशमिमं वर्षं यां न पश्याम्यरिन्दम ।\nपुत्रादिभिः परिद्यूनां द्रौपदीं सत्यवादिनीम्\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2146364, "chapter_id": 4157, "verse_number": "५१", "content_sanskrit": "न नूनं कर्मभिः शुक्लैरश्नुवन्ति स्त्रियः सुखम् ।\nदौपदी चेत् तथावृत्ता नाश्नुते सुखमव्ययम्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2146365, "chapter_id": 4157, "verse_number": "५२", "content_sanskrit": "न मे प्रिया द्रौपदेया न बीभत्सुयुधिष्ठिरौ ।\nन भीमसेनो न यमौ यदपश्यं सभागताम्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2146366, "chapter_id": 4157, "verse_number": "५३", "content_sanskrit": "न मे दुःखतरं किञ्चिद् भूतपूर्वं ततोऽधिकम्\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2146367, "chapter_id": 4157, "verse_number": "५४", "content_sanskrit": "स्त्रीधर्मिणीं द्रौपदीं चेत् श्वशुराणां समीपगाम् ।\nआनायितामनार्येण क्रोधलोभानुवर्तिना\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2146368, "chapter_id": 4157, "verse_number": "५५", "content_sanskrit": "सर्वे प्रैक्षन्त कुरव एकवस्त्रां सभागताम्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2146369, "chapter_id": 4157, "verse_number": "५६", "content_sanskrit": "तत्रैव धृतराष्ट्रस्य महाराजश्च बाह्लिकः ।\nकृपश्च सोमदत्तश्च निर्विण्णाः कुरवस्तथा\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2146370, "chapter_id": 4157, "verse_number": "५७", "content_sanskrit": "तस्यां संसदि सर्वेषां क्षत्तारं पूजयाम्यहम् ।\nवृत्तेन हि भवत्यार्यो न धनेन न विद्यया\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2146371, "chapter_id": 4157, "verse_number": "५८", "content_sanskrit": "तस्य कृष्ण महाबुद्धेः गम्भीरस्य महात्मनः ।\nक्षत्तुः शीलमलङ्कारो लोकान् विष्टभ्य तिष्ठति\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2146372, "chapter_id": 4157, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2146373, "chapter_id": 4157, "verse_number": "५९", "content_sanskrit": "सा शोकार्ता च हृष्टा च दृष्ट्वा गोविन्दमागतम् ।\nनानाविधानि दुःखानि सर्वाण्येवान्वकीर्तयन्\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2146374, "chapter_id": 4157, "verse_number": "६०", "content_sanskrit": "पूर्वैराचरितं यत्तत् कुराजभिररिन्दम ।\nअक्षद्यूतं मृगवधः कच्चिदेषां सुखावहम्\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2146375, "chapter_id": 4157, "verse_number": "६१", "content_sanskrit": "तन्मां दहति या कृष्णा सभायां कुरुसन्निधौ ।\nधार्तराष्ट्रैः परिक्लिष्टा यथा नकुलजा तथा\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2146376, "chapter_id": 4157, "verse_number": "६२", "content_sanskrit": "निर्वासनं च नगरात् प्रव्रज्या च परन्तप ।\nनानाविधानां दुःखानामावासोऽस्मि जनार्दन\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2146377, "chapter_id": 4157, "verse_number": "६३", "content_sanskrit": "अज्ञातचर्या बालानामवरोधश्च माधव ।\nन मे क्लेशतमं तत् स्यात् पुत्रैः सह परन्तप\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2146378, "chapter_id": 4157, "verse_number": "६४", "content_sanskrit": "दुर्योधनेन निकृता वर्षमद्य चतुर्दशम् ।\nदुःखादपि सुदुःखं स्याद् यदि पुण्यफलक्षयः\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2146379, "chapter_id": 4157, "verse_number": "६५", "content_sanskrit": "न मे विशेषो जात्वासीद् धार्तराष्ट्रेषु पाण्डवैः\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2146380, "chapter_id": 4157, "verse_number": "६६", "content_sanskrit": "तेन सत्येन कृष्ण त्वां हतामित्रं श्रिया वृतम् ।\nअस्माद् विमुक्तं सङ्ग्रामात् पश्येयं पाण्डवैः सह\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2146381, "chapter_id": 4157, "verse_number": "६७", "content_sanskrit": "नैवं शक्याः पराजेतुं सत्वं तेषां तथाविधम्\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2146382, "chapter_id": 4157, "verse_number": "६८", "content_sanskrit": "पितरं चैव गर्हामि नात्मानं न सुयोधनम् ।\nयेनाहं कुन्तिभोजाय धनं धूर्तैरिवार्पिता\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2146383, "chapter_id": 4157, "verse_number": "६९", "content_sanskrit": "बालां ममार्यकस्तुष्यन् क्रीडन्तीं कन्दुहस्तिकाम् ।\nअदात्तु कुन्तिभोजाय सखा सख्ये महात्मने\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2146384, "chapter_id": 4157, "verse_number": "७०", "content_sanskrit": "साऽहं पित्रा च निकृता श्वशुरैश्च परन्तप ।\nअत्यन्तदुःखिता कृष्ण किं जीवितफलं मम\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2146385, "chapter_id": 4157, "verse_number": "७१", "content_sanskrit": "यन्मां वागब्रवीन्नक्तं सूतके सव्यसाचिनः ।\nपुत्रस्ते पृथिवीं जेता यशश्चास्य दिवं स्पृशेत्\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2146386, "chapter_id": 4157, "verse_number": "७२", "content_sanskrit": "हत्वा कुरून् महाजन्ये राज्यं प्राप्य धनञ्जयः ।\nभ्रातृभिः सह कौन्तेयः त्रीन् मेधानाहरिष्यति\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2146387, "chapter_id": 4157, "verse_number": "७३", "content_sanskrit": "नाहं तामभ्यसूयामि नमो धर्माय वेधसे ।\nकृष्णाय महते नित्यं धर्मो धारयति प्रजाः\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2146388, "chapter_id": 4157, "verse_number": "७४", "content_sanskrit": "धर्मश्चेदस्ति वार्ष्णेय यथा वागभ्यभाषत ।\nत्वं चापि तत् तथा कृष्ण सर्वं सम्पादयिष्यसि\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2146389, "chapter_id": 4157, "verse_number": "७५", "content_sanskrit": "न मां माधव वैधव्यं नार्थनाशो न वैरिता ।\nतथा शोकाय दहति यथा पुत्रैर्विनाभवः\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2146390, "chapter_id": 4157, "verse_number": "७६", "content_sanskrit": "याऽहं गाण्डीवधन्वानं सर्वशस्त्रभृतां वरम् ।\nधनञ्जयं न पश्यामि का शान्तिर्हृदयस्य मे\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2146391, "chapter_id": 4157, "verse_number": "७७", "content_sanskrit": "इमं चतुर्दशं वर्षं यन्नापश्यं युधिष्ठिरम् ।\nधनञ्जयं च गोविन्द यमौ तं च वृकोदरम्\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2146392, "chapter_id": 4157, "verse_number": "७८", "content_sanskrit": "अर्थतस्ते मम मृताः तेषां चाहं जनार्दन\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2146393, "chapter_id": 4157, "verse_number": "७९", "content_sanskrit": "ब्रूया माधव राजानं धर्मात्मानं युधिष्ठिरम्\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2146394, "chapter_id": 4157, "verse_number": "८०", "content_sanskrit": "ब्रूयास्ते हीयते धर्मो मा पुत्रक वृथा कृथाः ।\nपराश्रया वासुदेव या जीवति धिगस्तु माम्\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2146395, "chapter_id": 4157, "verse_number": "८१", "content_sanskrit": "वृत्तेः कार्पण्यलब्धाया अप्रतिष्ठैव ज्यायसी ।\nअथो धनञ्जयं ब्रूया नित्योद्युक्तं वृकोदरम्\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2146396, "chapter_id": 4157, "verse_number": "८२", "content_sanskrit": "यदर्थं क्षत्रिया सूते तस्य कालोऽयमागतः\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2146397, "chapter_id": 4157, "verse_number": "८३", "content_sanskrit": "अस्मिंश्चेदागते काले कालो वोऽतिक्रमिष्यति ।\nलोकसम्भाविताः सन्तः आनृशंस्यं करिष्यथ\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2146398, "chapter_id": 4157, "verse_number": "८४", "content_sanskrit": "नृशंसेन च वो युक्तान् त्यजेयं शाश्वतीः समाः ।\nकाले हि समनुप्राप्ते त्यक्तव्यमपि जीवितम्\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2146399, "chapter_id": 4157, "verse_number": "८५", "content_sanskrit": "माद्रीपुत्रौ च वक्तव्यौ क्षत्रधर्मरतौ सदा\t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2146400, "chapter_id": 4157, "verse_number": "८६", "content_sanskrit": "विक्रमेणार्जिताँल्लोकान् वृणीतं जीवितादपि\t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2146401, "chapter_id": 4157, "verse_number": "८७", "content_sanskrit": "विक्रमाधिगता ह्यर्थाः क्षत्रधर्मेण जीवतः ।\nमनो मनुष्यस्य सदा प्रीणन्ति पुरुषोत्तम\t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2146402, "chapter_id": 4157, "verse_number": "८८", "content_sanskrit": "गत्वा ब्रूहि महाबाहो सर्वशस्त्रभृतां वरम् ।\nअर्जुनं पाण्डवं वीरं द्रौपद्याः पदवीं चर\t॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2146403, "chapter_id": 4157, "verse_number": "८९", "content_sanskrit": "विदितौ हि तवात्यन्तं क्रुद्धाविव यथाऽन्तकौ ।\nभीमार्जुनौ नयेतां हि देवानपि पराभवम्\t॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2146404, "chapter_id": 4157, "verse_number": "९०", "content_sanskrit": "तयोश्चैतदवज्ञातं यत् सा कृष्णा सभां गता\t॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2146405, "chapter_id": 4157, "verse_number": "९१", "content_sanskrit": "दुःशासनश्च कर्णश्च परुषाण्यभ्यभाषताम् ।\nदुर्योधनो भीमसेनमभ्यगर्जत् सभां गतम्\t॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2146406, "chapter_id": 4157, "verse_number": "९२", "content_sanskrit": "पश्यतां कुरुमुख्यानां तस्य द्रक्ष्यति यत् फलम्\t॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2146407, "chapter_id": 4157, "verse_number": "९३", "content_sanskrit": "न हि वैरं समासाद्य प्रशाम्यति वृकोदरः\t॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2146408, "chapter_id": 4157, "verse_number": "९४", "content_sanskrit": "सुचिरादपि भीमस्य न हि वैरं प्रशाम्यति ।\nयावदन्तं न नयति शात्रवान् शत्रुकर्शनः\t॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2146409, "chapter_id": 4157, "verse_number": "९५", "content_sanskrit": "न दुःखं राज्यहरणं न च द्यूते पराजयः ।\nप्रव्राजनं च पुत्राणां न मे तद् दुःखकारणम्\t॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2146410, "chapter_id": 4157, "verse_number": "९६", "content_sanskrit": "यत्तु सा बृहती श्यामा एकवस्त्रा सभागता ।\nअशृणोत् परुषा वाचः किं नु दुःखतरं ततः\t॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2146411, "chapter_id": 4157, "verse_number": "९७", "content_sanskrit": "स्त्रीधर्मिणी वरारोहा क्षत्रधर्मरता सदा ।\nनाध्यगच्छत् तदा नाथं कृष्णा नाथवती सती\t॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2146412, "chapter_id": 4157, "verse_number": "९८", "content_sanskrit": "यस्या मम सपुत्रायाः त्वं नाथो मधुसूदन ।\nरामश्च बलिनां श्रेष्ठः प्रद्युम्नश्च महारथः\t॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2146413, "chapter_id": 4157, "verse_number": "९९", "content_sanskrit": "साऽहमेवंविधं दुःखं सहेयं पुरुषोत्तम ।\nभीमे जीवति दुर्धर्षे विजये चापलायिनि\t॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2146414, "chapter_id": 4157, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि अष्टाशीतितमोऽध्यायः ॥८८॥\nभगवद्यानपर्वणि एकोनविंशोऽध्यायः ॥१९॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}]