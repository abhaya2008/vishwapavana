[{"id": 900009257, "chapter_id": 8739, "verse_number": "29.1", "content_sanskrit": "अथ ‘‘तन्मुख्यं ज्ञानशब्दयोः’’ इत्यनुप्रमाणेषु ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900009258, "chapter_id": 8739, "verse_number": "29.2", "content_sanskrit": "एतेन– मण्युक्तानि– अव्यभिचरितः सम्बन्ध इत्यस्य ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900009259, "chapter_id": 8739, "verse_number": "29.3", "content_sanskrit": "व्याप्तिग्रहोपायस्तु पदशक्तिप्रस्तावे दर्शितः ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900009260, "chapter_id": 8739, "verse_number": "29.4", "content_sanskrit": "एवं चेत्प्रमेयत्वाभिधेयत्वयोर्व्याप्तिं गृह्णतः सार्वज्ञ्यं स्यात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}]