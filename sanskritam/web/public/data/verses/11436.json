[{"id": 50010177, "chapter_id": 11436, "verse_number": "1", "content_sanskrit": "विप्रा ऊचुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50010178, "chapter_id": 11436, "verse_number": "2", "content_sanskrit": "अत्र तु प्रथमो राज्ञां पुमान् प्रथयिता यशः। पृथुर्नाम महाराजा भविष्यति पृथुश्रवाः॥ ४/१५/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50010179, "chapter_id": 11436, "verse_number": "3", "content_sanskrit": "इयं च देवी सुदती गुणभूषणभूषिता। अर्चिर्नाम वरारोहा पृथुमेवावरुन्धती॥ ४/१५/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50010180, "chapter_id": 11436, "verse_number": "4", "content_sanskrit": "एष साक्षाद्धरेरंशो जातो लोकरिरक्षया। इयं च परमा हि श्रीरनुजज्ञेऽनपायिनी॥ ४/१५/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50010181, "chapter_id": 11436, "verse_number": "5", "content_sanskrit": "मैत्रेय उवाच ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50010182, "chapter_id": 11436, "verse_number": "6", "content_sanskrit": "प्रशंसन्ति स्म तं विप्रा गन्धर्वप्रवरा जगुः। मुमुचुः सुमनोधाराः सिद्धा नृत्यन्ति तत्स्त्रियः॥ ४/१५/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50010183, "chapter_id": 11436, "verse_number": "7", "content_sanskrit": "शङ्खतूर्यमृदङ्गाद्या नेदुर्दुन्दुभयो दिवि। तत्र सर्व उपाजग्मुर्देवर्षिपितृणां गणाः॥ ४/१५/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50010184, "chapter_id": 11436, "verse_number": "8", "content_sanskrit": "ब्रह्मा जगद्गुरुर्देवः सहागत्य सुरेश्वरैः। वैन्यस्य दक्षिणे हस्ते दृष्ट्वा चिह्नं गदाभृतः॥ ४/१५/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50010185, "chapter_id": 11436, "verse_number": "9", "content_sanskrit": "पादयोररविन्दं च तस्मिन् मेने हरेः कलाम्। यस्याप्रतिहतं चक्रमंशस्य परमेष्ठिनः॥ ४/१५/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50010186, "chapter_id": 11436, "verse_number": "10", "content_sanskrit": "तस्याभिषेक आरब्धे ब्राह्मणैर्ब्रह्मवादिभिः। आभिषेचनिकान्यस्मै आजह्वुः सर्वतो जनाः॥ ४/१५/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50010187, "chapter_id": 11436, "verse_number": "11", "content_sanskrit": "सरित्समुद्रा गिरयो नागा गावः खगा मृगाः। द्यौः क्षितिः सर्वभूतानि समाजह्वुरुपायनम्॥ ४/१५/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50010188, "chapter_id": 11436, "verse_number": "12", "content_sanskrit": "सोऽभिषिक्तो महाराजः सुवासाः साध्वलङ्कृतः। पत्नयाऽर्चिषाऽलङ्कृतया विरेजेऽग्निरिवापरः॥ ४/१५/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50010189, "chapter_id": 11436, "verse_number": "13", "content_sanskrit": "तस्मै जहार धनदो हैमं वीर वरासनम्। वरुणः सलिलस्रावमातपत्रं शशिप्रभम्॥ ४/१५/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50010190, "chapter_id": 11436, "verse_number": "14", "content_sanskrit": "वायुश्च बालव्यजने धर्मः कार्तिमयीं स्रजम्। इन्द्रः किरीटमुत्कृष्टं दण्डं संयमनं यमः॥ ४/१५/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50010191, "chapter_id": 11436, "verse_number": "15", "content_sanskrit": "ब्रह्मा ब्रह्ममयं वर्म भारती हारमुत्तमम्। हरिः सुदर्शनं चक्रं तत्पत्नयव्याहतां श्रियम्॥ ४/१५/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50010192, "chapter_id": 11436, "verse_number": "16", "content_sanskrit": "दशचन्द्रमसिं रुद्रः शतचन्द्रं तथाऽम्बिका। सोमोऽमृतमयानश्वांस्त्वष्टा रूपाश्रयं रथम्॥ ४/१५/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50010193, "chapter_id": 11436, "verse_number": "17", "content_sanskrit": "अग्निराजगवं चापं सूर्यो रश्मिमयानिषून्। भूः पादुके योगमये द्यौः पुष्पबलिमन्वहम्॥ ४/१५/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50010194, "chapter_id": 11436, "verse_number": "18", "content_sanskrit": "नाट्यं सुगीतं वादित्रमन्तर्धानं च खेचराः। ऋषयश्चाशिषः सत्याः समुद्रः शङ्खमात्मजम्॥ ४/१५/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50010195, "chapter_id": 11436, "verse_number": "19", "content_sanskrit": "सिन्धवः पर्वता नद्यो रथवीथीर्महात्मनः। सूतोऽथ मागधो वन्दी संस्तोतुमुपतस्थिरे॥ ४/१५/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50010196, "chapter_id": 11436, "verse_number": "20", "content_sanskrit": "स्तावकांस्तानभिप्रेत्य पृथुर्वैन्यः प्रतापवान्। मेघनिर्ह्वादया वाचा प्रहसन्निदमब्रवीत्॥ ४/१५/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50010197, "chapter_id": 11436, "verse_number": "21", "content_sanskrit": "पृथुरुवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50010198, "chapter_id": 11436, "verse_number": "22", "content_sanskrit": "हे सूत हे मागध सौम्य वन्दिन् लोकेऽधुनाऽस्पष्टगुणस्य मे स्यात्। किमाश्रयो वः स्तव एष योज्यतां मा मय्यभूवन् वितथा गिरो वः॥ ४/१५/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50010199, "chapter_id": 11436, "verse_number": "23", "content_sanskrit": "तस्मात् परोक्षेऽस्मदुपाश्रितान्यलं करिष्यथ स्तोत्रमपीड्यवाचः। सत्युत्तमश्लोकगुणानुवादे जुगुप्सितं न स्तवयन्ति सभ्याः॥ ४/१५/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50010200, "chapter_id": 11436, "verse_number": "24", "content_sanskrit": "महद्गुणानात्मनि कर्तुमिच्छन् कः स्तावकैः स्तावयते सतोऽपि। स वै सुतोष्यैरतिविप्रलब्धो जनापहासं कुमतिर्न वेद॥ ४/१५/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50010201, "chapter_id": 11436, "verse_number": "25", "content_sanskrit": "प्रभवो ह्यात्मनः स्तोत्रं जुगुप्सन्त्यपि विश्रुताः। ह्वीमन्तः परमोदारा पौरुषं चाविगर्हितम्॥ ४/१५/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 50010202, "chapter_id": 11436, "verse_number": "26", "content_sanskrit": "वयं त्वविदिता लोके सूताद्यापि वरीमभिः। कर्मभिः कथमात्मानं गाययिष्याम बालवत्॥ ४/१५/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 50010203, "chapter_id": 11436, "verse_number": "27", "content_sanskrit": "इति श्रीमद्भागवते चतुर्थस्कन्धे पञ्चदशोऽध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]