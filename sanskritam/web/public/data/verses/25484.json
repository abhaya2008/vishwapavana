[{"id": 7005484000, "chapter_id": 25484, "verse_number": "२-१-१", "content_sanskrit": "ऋषय ऊचुः ।\nभवता कथितः सम्यक सर्गः स्वायम्भुवस्ततः ।\nब्रह्माण्डस्यास्य विस्तरो मन्वन्तरविनिश्चयः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005484001, "chapter_id": 25484, "verse_number": "२-१-२", "content_sanskrit": "तत्रेश्वरेश्वरो देवो वर्णिभिर्धर्मतपरैः ।\nज्ञानयोगरतैर्नित्यमाराध्यः कथितस्त्वया ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005484002, "chapter_id": 25484, "verse_number": "२-१-३", "content_sanskrit": "तद्वदाशेषसंसारदुख्हनाशमनुत्तमम ।\nज्ञानं ब्रह्मोकविषयं येन पश्येम तत्परम ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005484003, "chapter_id": 25484, "verse_number": "२-१-४", "content_sanskrit": "त्वं हि नारायणात साक्षात कृष्णद्वैपयानात प्रभो ।\nवाप्ताखिलविज्ञानस्तत्वां पूच्छामहे पुनः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005484004, "chapter_id": 25484, "verse_number": "२-१-५", "content_sanskrit": "श्रुत्वा मुनीनां तद वक्यं कृष्नद्वैपायनं प्रभुम ।\nसुतः पौराणिकःस्मृत्वा भाषितुं ह्मापचक्रमे ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005484005, "chapter_id": 25484, "verse_number": "२-१-६", "content_sanskrit": "अथास्मिन्नन्तरे व्यासः कृष्नद्वैपायनः स्वयम ।\nआजगम मुनिश्रेष्ठा यत्र सत्रं समासते ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005484006, "chapter_id": 25484, "verse_number": "२-१-७", "content_sanskrit": "तं दृष्टा वेद्विद्वासां कालमेघसमद्युतिम ।\nव्याम्स कमलपंत्राक्षं प्रणेमुद्विजपुंगवाः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005484007, "chapter_id": 25484, "verse_number": "२-१-८", "content_sanskrit": "पपात दण्दवद भूमौ दृश्टासौ रोमहर्षणः ।\nप्रदक्षिणीकृत्यं गुरुं प्रात्र्जलिः पार्श्वगोऽभवत ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005484008, "chapter_id": 25484, "verse_number": "२-१-९", "content_sanskrit": "पृष्टास्तेऽनामयं विप्राह शौनकाद्या महामुनिम ।\nसमाश्वस्यासन तस्मैं तदयोग्यं समकल्पयन ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005484009, "chapter_id": 25484, "verse_number": "२-१-१०", "content_sanskrit": "अथैतानब्रवीद वाक्य्हं प्राशरसुत प्रभुः ।\nकच्चिन्न तपसो हानिः स्वाध्यायस्य श्रुतस्य च ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005484010, "chapter_id": 25484, "verse_number": "२-१-११", "content_sanskrit": "ततः स सुतः स्वगुरुं प्रणम्याह महमुनिम ।\nज्ञानं तद ब्रह्माविषयं मुनीनां वक्तमर्हसि ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005484011, "chapter_id": 25484, "verse_number": "२-१-१२", "content_sanskrit": "इमें हि मुनयः शान्तास्तापसा धर्मतप्तराः ।\nशुश्रुषा जायतेः चैषां वक्तुमर्हसि तत्वतः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005484012, "chapter_id": 25484, "verse_number": "२-१-१३", "content_sanskrit": "ज्ञानं विमुक्तिदं दिव्यं यन्मे साक्षात त्वयोदितम ।\nमुनीनां व्याहृतं पुर्व विष्णुनां कूर्मरुपिणा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005484013, "chapter_id": 25484, "verse_number": "२-१-१४", "content_sanskrit": "श्रुत्वा सुतस्य वचनं मुनिः सत्यवतीसुतः ।\nप्रणम्य शिरसा रुद्रं वचः प्राह सुखावहम ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005484014, "chapter_id": 25484, "verse_number": "२-१-१५", "content_sanskrit": "व्यास उवाच ।\nवक्ष्ये देवो महादेवः पृष्टो योगीश्वरैः पुरा ।\nसनत्कुमारप्रमुखैःस्वयं यत समभाषत ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005484015, "chapter_id": 25484, "verse_number": "२-१-१६", "content_sanskrit": "सनत्कुमारः सनकस्तथैव च सनन्दनः ।\nअंगिरा रुद्रसहितो भॄगुः परमधर्मवित ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005484016, "chapter_id": 25484, "verse_number": "२-१-१७", "content_sanskrit": "कणादः कपिलो योगी वामदेवो महामुनिः ।\nशुक्रो वसिष्ठो भगवन सर्वे संयतमानसा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005484017, "chapter_id": 25484, "verse_number": "२-१-१८", "content_sanskrit": "परस्परं विचायैते सम्शयाविष्टचेतसह ।\nतप्तवन्तस्ततो घोरं पुण्यं बदरिकाश्रमे ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005484018, "chapter_id": 25484, "verse_number": "२-१-१९", "content_sanskrit": "अपश्यंस्ते महायोगमृषिं धर्मसुतं शुचिम ।\nनारायणमनाद्यन्तं नरेण सहितं तदा ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005484019, "chapter_id": 25484, "verse_number": "२-१-२०", "content_sanskrit": "संस्तुयं विविधैः स्तोत्रैः सर्वे वेदसमुद्भवैः ।\nप्रणेमुर्भक्तिसंयुक्त योगिनो योगवित्तमम ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005484020, "chapter_id": 25484, "verse_number": "२-१-२१", "content_sanskrit": "विज्ञाय वात्र्छितं तेषां भगवानपि सर्ववित ।\nप्राह गम्भीरया वाचा किमर्थ तप्यते तपः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005484021, "chapter_id": 25484, "verse_number": "२-१-२२", "content_sanskrit": "अबुवन हृष्टमनसो विश्वात्मानं सनातनम ।\nसाक्षान्नारायणं देवमागतं सिद्धिसुचकम ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005484022, "chapter_id": 25484, "verse_number": "२-१-२३", "content_sanskrit": "वयं संशयमापन्नाः सर्वे वै ब्रहमवादिनः ।\nभवन्तमेकं शरणं प्रपन्नाः पुरुषोत्तमम ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005484023, "chapter_id": 25484, "verse_number": "२-१-२४", "content_sanskrit": "त्वं हि तद वेत्थ परम सर्वज्ञो भगवानृषि ।\nनारायणः स्वयं साक्षात पुराणोऽव्यक्तिपुरुषः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005484024, "chapter_id": 25484, "verse_number": "२-१-२५", "content_sanskrit": "नह्रान्यो विद्यते वेत्ता त्वामृते परमेश्वर ।\nशुश्रुषास्माकमखिलं संशयं छेतुमर्हसि ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005484025, "chapter_id": 25484, "verse_number": "२-१-२६", "content_sanskrit": "किं कारणमिदं कृत्स्नं कोऽनुसंसरते सदा ।\nकश्चिदात्मा च का मुक्तिः संसारह किंनिमित्तकः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005484026, "chapter_id": 25484, "verse_number": "२-१-२७", "content_sanskrit": "कः संसारयतीशानः को वा सर्व प्रपश्यति ।\nकिं तत परतरं ब्रह्मा सर्व नो वक्तुमर्हसि ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005484027, "chapter_id": 25484, "verse_number": "२-१-२८", "content_sanskrit": "एवमुक्ते तु मुनयः प्रापश्यन पुरुषोत्तमम ।\nविहाय पापसं रुपं संस्थितं स्वेन तेजसा ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005484028, "chapter_id": 25484, "verse_number": "२-१-२९", "content_sanskrit": "विभ्राजमानं विमलं प्रभामण्डलमण्डितम ।\nश्रीवत्सवक्षसं देवं तप्तजाम्बुनदप्रभ्म ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005484029, "chapter_id": 25484, "verse_number": "२-१-३०", "content_sanskrit": "शंखचक्रगदापाणिं शार्गहस्तं श्रियावृतम ।\nन द्रुष्टस्तत्क्ष्णदेव नरस्वस्यैव तेजसा ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005484030, "chapter_id": 25484, "verse_number": "२-१-३१", "content_sanskrit": "तदन्तरे महादेवः शशाकाकिंतशेखरः ।\nप्रसादाभिमुखो रुद्रः प्रादुरासीन्महेश्वरः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005484031, "chapter_id": 25484, "verse_number": "२-१-३२", "content_sanskrit": "निरीक्ष्य ते जगन्नाथं त्रिनेत्रं चन्द्रभुषनम ।\nतुष्टुवुर्हृष्तमनसो भक्त्या तं परमेश्वरम ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005484032, "chapter_id": 25484, "verse_number": "२-१-३३", "content_sanskrit": "जयेश्वर महादेवजय भूतपते शिव ।\nजयाशेषमुनीशान तपासाभिप्रपुजित ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005484033, "chapter_id": 25484, "verse_number": "२-१-३४", "content_sanskrit": "सहस्त्रमुर्ते विश्वात्मान जगद्यन्त्रप्रवर्तक ।\nजयानन्त जगज्जन्मत्राणसंहारकारण ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005484034, "chapter_id": 25484, "verse_number": "२-१-३५", "content_sanskrit": "शस्त्रचरणेशान शम्भो योगीन्द्रवन्तित ।\nजयाम्भिकापते देव नमस्ते परमेश्वर ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7005484035, "chapter_id": 25484, "verse_number": "२-१-३६", "content_sanskrit": "संस्तुतो बह्गवानीशस्त्र्यम्बको भक्तवत्सलः ।\nसमालिंग्य हृशीकेशं प्राह गम्भीरया गिरा ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7005484036, "chapter_id": 25484, "verse_number": "२-१-३७", "content_sanskrit": "किमर्थक पुण्डरीकेशं मुनीन्द्रा ब्रह्मावादिनः ।\nइमं समागता देशं इं वा कार्यं मयाच्युतः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7005484037, "chapter_id": 25484, "verse_number": "२-१-३८", "content_sanskrit": "आकर्ण्य भगवदवाक्यं देवदेवो जनार्दनः ।\nप्राह देवो महादेवं प्रसादभिमुखं स्थितम ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7005484038, "chapter_id": 25484, "verse_number": "२-१-३९", "content_sanskrit": "इमें हि मुनयो देव तापसाः क्षीणकल्पषाः ।\nअभ्यागता मां शरणं सम्यग दर्शनकांगिणः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7005484039, "chapter_id": 25484, "verse_number": "२-१-४०", "content_sanskrit": "यदि प्रसन्नो भगवान मुनीनां भावितात्मनाम ।\nसंनिधौ मम तज्ज्ञानं दिव्यं वक्तुम्किहार्हसि ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7005484040, "chapter_id": 25484, "verse_number": "२-१-४१", "content_sanskrit": "त्वं हि वेत्थ स्वमात्मानं न ह्यान्यो विद्यते शिव ।\nततस्त्वमाम्तनाम्तानं मुनीन्द्रेभ्यः प्रदशयः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7005484041, "chapter_id": 25484, "verse_number": "२-१-४२", "content_sanskrit": "एवमुक्त्वा हृषीकेशः प्रोवाच मुनिपुंगवान ।\nप्रदर्शयन योगसिद्धे निरीक्ष्य वृषभध्वजम ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7005484042, "chapter_id": 25484, "verse_number": "२-१-४३", "content_sanskrit": "संदर्शनान्महेशस्य शंकरस्याथ शुलिनः ।\nकृतार्थ स्वयमात्मानं ज्ञातुमर्हथ तत्वतः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7005484043, "chapter_id": 25484, "verse_number": "२-१-४४", "content_sanskrit": "प्रष्टुमर्हथ विश्‍वेशं प्रत्यक्षं पुरतः स्थितम ।\nममैव संनिधावेष यथावद वक्तुमीश्वरः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7005484044, "chapter_id": 25484, "verse_number": "२-१-४५", "content_sanskrit": "निशम्य विष्णुवचनं प्रणम्य वृषभध्वजम ।\nसनत्कुमारप्रमुखाः पृच्छन्ति स्म महेश्वरम ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7005484045, "chapter_id": 25484, "verse_number": "२-१-४६", "content_sanskrit": "अथास्मिन्नन्तरे दिव्यामसनं विमलं शिवम ।\nकिमप्यचिन्यं गगनादीश्वरार्हं समुदबभौ ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7005484046, "chapter_id": 25484, "verse_number": "२-१-४७", "content_sanskrit": "तत्राससाद योगात्मा विष्णुनां सह विश्वकृत ।\nतेजसा पुरयन विश्वं भाति देवो महेश्वरः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7005484047, "chapter_id": 25484, "verse_number": "२-१-४८", "content_sanskrit": "तं ते देवादिदेवेशं शंकरं ब्रह्मवादिनः ।\nविभ्राजमानं विमले तस्मिन दद्रुशरासने ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7005484048, "chapter_id": 25484, "verse_number": "२-१-४९", "content_sanskrit": "यं प्रपश्यन्ति योगास्थाः स्वात्मन्यात्माननीश्वरम ।\nअनन्यतेजसं शान्तं शिवं दद्वशिरें किल ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7005484049, "chapter_id": 25484, "verse_number": "२-१-५०", "content_sanskrit": "यतः प्रसुतिर्भूताना यत्रैतत प्रविलीयते ।\nतमासनस्थं भूतानामीशं दद्वशिरे किल ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7005484050, "chapter_id": 25484, "verse_number": "२-१-५१", "content_sanskrit": "यदन्तरा सर्वमेतद यतोऽभिन्नमिदं जगत ।\nस वासुदेवमासीनंतमीशं ददृशुः किल ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7005484051, "chapter_id": 25484, "verse_number": "२-१-५२", "content_sanskrit": "प्रोवाच पुष्टो भागवान मुनीना परमेश्वरः ।\nनिरीक्ष्य पुण्डरीकाक्षं स्वात्मयोगमनुत्तमम ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7005484052, "chapter_id": 25484, "verse_number": "२-१-५३", "content_sanskrit": "तच्छृणुध्वं यथान्यायमुच्यमानं मयानघाः ।\nप्रशान्तमानसाः सर्व ज्ञानमीश्वरभाषितम ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]