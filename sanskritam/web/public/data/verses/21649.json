[{"id": 7001649000, "chapter_id": 21649, "verse_number": "१-३५-१", "content_sanskrit": "सनक उवाच ।\nपुनर्वक्ष्यामि माहात्म्यं देवदेवस्य चक्रिणः ।\nपठतां शृण्वतां सद्यः पापराशिः प्रणश्यति 1.35.॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001649001, "chapter_id": 21649, "verse_number": "१-३५-२", "content_sanskrit": "शान्ता जितारिषड्वर्गा योगेनाप्यनहङ्कृताः ।\nयजन्ति ज्ञानयोगेन ज्ञानरूपिणमव्ययम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001649002, "chapter_id": 21649, "verse_number": "१-३५-३", "content_sanskrit": "तीर्थस्नानैर्विशुद्धा ये व्रतदानतपोमखैः ।\nयजन्ति कर्मयोगेन सर्वधातारमच्युतम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001649003, "chapter_id": 21649, "verse_number": "१-३५-४", "content_sanskrit": "लुब्धा व्यसनिनोऽज्ञाश्च न यजन्ति जगत्पतिम् ।\nअजरामरवन्मूढास्तिष्ठन्ति नरकीटकाः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001649004, "chapter_id": 21649, "verse_number": "१-३५-५", "content_sanskrit": "तडिल्लेखाश्रिया मत्ता वृथाहङ्कारदूषिताः ।\nन यजन्ति जगन्नाथं सर्वश्रेयोविधायकम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001649005, "chapter_id": 21649, "verse_number": "१-३५-६", "content_sanskrit": "हरिधर्मरताः शान्ता हरिपादाब्जसेवकाः ।\nदैवात्केऽपीह जायन्ते लोकानुग्रहतत्पराः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001649006, "chapter_id": 21649, "verse_number": "१-३५-७", "content_sanskrit": "कर्मणा मनसा वाचा यो यजेद्भक्तितो हरिम् ।\nस याति परमं स्थानं सर्वलोकोत्तमोत्तमम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001649007, "chapter_id": 21649, "verse_number": "१-३५-८", "content_sanskrit": "अत्रैवोदाहरन्तीममितिहासं पुरातनम् ।\nपठतां शृण्वतां चैव सर्वपापप्रणाशनम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001649008, "chapter_id": 21649, "verse_number": "१-३५-९", "content_sanskrit": "तत्प्रवक्ष्यामि चरितं यज्ञमालिसुमालिनोः ।\nयस्य श्रवणमात्रेण वाजिमेधफलं लभेत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001649009, "chapter_id": 21649, "verse_number": "१-३५-१०", "content_sanskrit": "कश्चिदासीत्पुरा विप्र ब्राह्मणो रैवतेऽन्तरे ।\nवेदमालिरिति ख्यातो वेदवेदाङ्गपारगः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001649010, "chapter_id": 21649, "verse_number": "१-३५-११", "content_sanskrit": "सर्वभूतदयायुक्तो हरिपूजापरायणः ।\nपुत्रमित्रकलत्रार्थं धनार्जनपरोऽभवत् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001649011, "chapter_id": 21649, "verse_number": "१-३५-१२", "content_sanskrit": "अपण्यविक्रयं चक्रे तथा च रसविक्रयम् ।\nचण्डालाद्यैरपि तथा सम्भाषी तत्प्रतिग्रही ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001649012, "chapter_id": 21649, "verse_number": "१-३५-१३", "content_sanskrit": "तपसां विक्रयं चक्रे व्रतानां विक्रयं तथा ।\nपरार्थं तीर्थगमनं कलत्रार्थमकारयत् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001649013, "chapter_id": 21649, "verse_number": "१-३५-१४", "content_sanskrit": "कालेन गच्छता विप्र जातौ तस्य सुतावुभौ ।\nयज्ञमाली सुमाली च यमलावतिशोभनौ ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001649014, "chapter_id": 21649, "verse_number": "१-३५-१५", "content_sanskrit": "ततः पिता कुमारौ तावतिस्नेहसमन्वितः ।\nपोषयामास वात्सल्याद्बहुभिः साधनैस्तदा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001649015, "chapter_id": 21649, "verse_number": "१-३५-१६", "content_sanskrit": "वेदमालिर्बहूपायैर्धनं सम्पाद्य यत्नतः ।\nस्वधनं गणयामास कियत्स्यादिति वेदितुम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001649016, "chapter_id": 21649, "verse_number": "१-३५-१७", "content_sanskrit": "निधिकोटिसहस्राणां कोटिकोटिगुणान्वितम् ।\nविगणय्य स्वयं हृष्टो विस्मितश्चार्थचिन्तया ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001649017, "chapter_id": 21649, "verse_number": "१-३५-१८", "content_sanskrit": "असत्प्रतिग्रहैश्चैव अपण्यानां च विक्रयैः ।\nमया तपोविक्रयाद्यैरेतद्धनमुपार्जितम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001649018, "chapter_id": 21649, "verse_number": "१-३५-१९", "content_sanskrit": "नाद्यापि शान्तिमापन्ना मम तृष्णातिदुःसहा ।\nमेरुतुल्यसुवर्णानि ह्यसङ्ख्यातानि वाञ्छति ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001649019, "chapter_id": 21649, "verse_number": "१-३५-२०", "content_sanskrit": "अहो मन्ये महाकष्टं समस्तक्लेशसाधनम् ।\nसर्वान्कामानवाप्नोति पुनरन्यच्च कांक्षति ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001649020, "chapter_id": 21649, "verse_number": "१-३५-२१", "content_sanskrit": "जीर्यन्ति जीर्यतः केशाः दन्ताः जीर्यन्ति जीर्यतः ।\nचक्षुःश्रोत्रे च जोर्येते तृष्णैका तरुणायते ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001649021, "chapter_id": 21649, "verse_number": "१-३५-२२", "content_sanskrit": "ममेन्द्रि याणि सर्वाणि मन्दभावं व्रजन्ति च ।\nबलं हृतं च जरसा तृष्णा तरुणतां गता ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001649022, "chapter_id": 21649, "verse_number": "१-३५-२३", "content_sanskrit": "कष्टाशा वर्त्तते यस्य स विद्वानथ पण्डितः ।\nसुशान्तोऽपि प्रमन्युः स्याद्धीमानप्यतिमूढधीः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001649023, "chapter_id": 21649, "verse_number": "१-३५-२४", "content_sanskrit": "आशा भङ्गकरी पुंसामजेयारातिसन्निभा ।\nतस्मादाशां त्यजेत्प्राज्ञो यदीच्छेच्छाश्वतं सुखम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001649024, "chapter_id": 21649, "verse_number": "१-३५-२५", "content_sanskrit": "बलं तेजो यशश्चैव विद्यां मानं च वृद्धताम् ।\nतथैव सत्कुले जन्म आशा हन्त्यतिवेगतः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001649025, "chapter_id": 21649, "verse_number": "१-३५-२६", "content_sanskrit": "नृणामाशाभिभूतानामाश्चर्यमिदमुच्यते ।\nकिञ्चिद्दातापि चाण्डालस्तस्मादधिकतां गतः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001649026, "chapter_id": 21649, "verse_number": "१-३५-२७", "content_sanskrit": "आशाभिभूताः ये मर्त्या महामोहा महोद्धताः ।\nअवमानादिकं दुःखं न जानन्ति कदाप्यहो ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001649027, "chapter_id": 21649, "verse_number": "१-३५-२८", "content_sanskrit": "मयाप्येवं बहुक्लेशैरेतद्धनमुपार्जितम् ।\nशरीरमपि जीर्णं च जरसापहृतं बलम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001649028, "chapter_id": 21649, "verse_number": "१-३५-२९", "content_sanskrit": "इतः परं यतिष्यामि परलोकार्थमादरात् ।\nएवं निश्चित्य विप्रेन्द्र धर्ममार्गरतोऽभवत् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001649029, "chapter_id": 21649, "verse_number": "१-३५-३०", "content_sanskrit": "तदैव तद्धनं सर्वं चतुर्द्धा व्यभजत्तथा ।\nस्वयं तु भागद्वितयं स्वार्जितार्थादपाहरत् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001649030, "chapter_id": 21649, "verse_number": "१-३५-३१", "content_sanskrit": "शेषं च भागद्वितयं पुत्रयोरुभयोर्ददौ ।\nस्वेनार्जितानां पापानां नाशं कर्तुमनास्तदा ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001649031, "chapter_id": 21649, "verse_number": "१-३५-३२", "content_sanskrit": "प्रपातडागारामांश्च तथा देवगृहान्बहून् ।\nअन्नादीनां च दानानि गङ्गातीरे चकार सः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001649032, "chapter_id": 21649, "verse_number": "१-३५-३३", "content_sanskrit": "एवं धनमशेषं च विश्राण्य हरिभक्तिमान् ।\nनरनारायणस्थानं जगाम तपसे वनम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001649033, "chapter_id": 21649, "verse_number": "१-३५-३४", "content_sanskrit": "तत्रापश्यन्महारम्यमाश्रमं मुनिसेवितम् ।\nफलितैः पुष्पितैश्चैव शोभितं वृक्षसञ्चयैः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001649034, "chapter_id": 21649, "verse_number": "१-३५-३५", "content_sanskrit": "गृणद्भिः परमं ब्रह्म शास्त्रचिन्तापरैस्तथा ।\nपरिचर्यापरैर्वृद्धैर्मुनिभिः परिशोभितम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001649035, "chapter_id": 21649, "verse_number": "१-३५-३६", "content_sanskrit": "शिष्यैः परिवृतं तत्र मुनिं जानन्तिसंज्ञकम् ।\nगृणन्तं परमं ब्रह्म तेजोराशिं ददर्श ह ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001649036, "chapter_id": 21649, "verse_number": "१-३५-३७", "content_sanskrit": "शमादिगुणसंयुक्तं रागादिरहितं मुनिम् ।\nशीर्णपर्णाशनं दृष्ट्वा वेदमालिर्ननाम तम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001649037, "chapter_id": 21649, "verse_number": "१-३५-३८", "content_sanskrit": "तस्य जानन्तिरागन्तोः कल्पयामास चार्हणम् ।\nकन्दमूलफलाद्यैस्तु नारायणधिया मुने ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001649038, "chapter_id": 21649, "verse_number": "१-३५-३९", "content_sanskrit": "कृतातिथ्यक्रियस्तेन वेदमाली कृताञ्जलि ।\nविनयावनतो भूत्वा प्रोवाच वदतां वरम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001649039, "chapter_id": 21649, "verse_number": "१-३५-४०", "content_sanskrit": "भगवन्कृतकृत्योऽस्मि विगतं कल्मषं मम ।\nमामुद्धर महाभाग ज्ञानदानेन पण्डित ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001649040, "chapter_id": 21649, "verse_number": "१-३५-४१", "content_sanskrit": "एवमुक्तस्ततस्तेन जानन्तिर्मुनिसत्तमः ।\nप्रोवाच प्रहसन्वाग्मी वेदमालि गुणान्वितम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001649041, "chapter_id": 21649, "verse_number": "१-३५-४२", "content_sanskrit": "जानन्तिरुवाच ।\nशृणुष्व विप्रशार्दूल संसारोच्छेदकारणम् ।\nप्रवक्ष्यामि समासेन दुर्लभं त्वकृतात्मनाम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001649042, "chapter_id": 21649, "verse_number": "१-३५-४३", "content_sanskrit": "भज विष्णुं परं नित्यं स्मर नारायणं प्रभुम् ।\nपरापवादं पैशुन्यं कदाचिदपि मा कृथाः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001649043, "chapter_id": 21649, "verse_number": "१-३५-४४", "content_sanskrit": "परोपकारनिरतः सदा भव महामते ।\nहरिपूजापरश्चैव त्यज मूर्खसमागमम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001649044, "chapter_id": 21649, "verse_number": "१-३५-४५", "content_sanskrit": "कामं क्रोधं च लोभं च मोहं च मदमत्सरौ ।\nपरित्यज्यात्मवल्लोकं दृष्ट्वा शान्तिं गमिष्यसि ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001649045, "chapter_id": 21649, "verse_number": "१-३५-४६", "content_sanskrit": "असूयां परनिन्दा च कदाचिदपि मा कुरु ।\nदम्भाचारमहङ्कारं नैष्ठुर्यं च परित्यज ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001649046, "chapter_id": 21649, "verse_number": "१-३५-४७", "content_sanskrit": "दयां कुरुष्व भूतेषु शुश्रूषां च तथा सताम् ।\nत्वया कृतांश्च धर्मान्वै मा प्रकाशय पृच्छताम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001649047, "chapter_id": 21649, "verse_number": "१-३५-४८", "content_sanskrit": "अनाचारपरान्दृष्ट्वा नोपेक्षां कुरु शक्तितः ।\nपूजयस्वातिथिं नित्यं स्वकुटुम्बाविरोधतः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001649048, "chapter_id": 21649, "verse_number": "१-३५-४९", "content_sanskrit": "पत्रैः पुष्पैः फलैर्वापि दूर्वाभिः पल्लवैरथ ।\nपूजयस्व जगन्नाथं नारायणमकामतः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001649049, "chapter_id": 21649, "verse_number": "१-३५-५०", "content_sanskrit": "देवानृषीन्पितॄंश्चापि तर्पयस्व यथाविधि ।\nअग्नेश्च विधिवद्विप्र परिचर्यापरो भव ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001649050, "chapter_id": 21649, "verse_number": "१-३५-५१", "content_sanskrit": "देवतायतने नित्यं सम्मार्जनपरो भव ।\nतथोपलेपनं चैव कुरुष्व सुसमाहितः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001649051, "chapter_id": 21649, "verse_number": "१-३५-५२", "content_sanskrit": "शीर्णस्फुटितसम्धानं कुरु देवगृहे सदा ।\nमार्गशोभां च दीपं च विष्णोरायतने कुरु ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001649052, "chapter_id": 21649, "verse_number": "१-३५-५३", "content_sanskrit": "कन्दमूलफलैर्वापि सदा पूजय माधवम् ।\nप्रदक्षिणनमस्कारैः स्तोत्राणां पठनैस्तथा ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001649053, "chapter_id": 21649, "verse_number": "१-३५-५४", "content_sanskrit": "पुराणश्रवणं चैव पुराणपठनं तथा ।\nवेदान्तपठनं चैव प्रत्यहं कुरु शक्तितः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001649054, "chapter_id": 21649, "verse_number": "१-३५-५५", "content_sanskrit": "एवंस्थिते तव ज्ञानं भविष्यत्युत्तमोत्तमम् ।\nज्ञानात्समस्तपापानां मोक्षो भवति निश्चितम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001649055, "chapter_id": 21649, "verse_number": "१-३५-५६", "content_sanskrit": "एवं प्रबोधितस्तेन वेदमालिर्महामतिः ।\nतथा ज्ञानरतो नित्यं ज्ञानलेशमवाप्तवान् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001649056, "chapter_id": 21649, "verse_number": "१-३५-५७", "content_sanskrit": "वेदमालि कदाचित्तु ज्ञानलेशप्रचोदितः ।\nकोऽहं मम क्रिया केति स्वयमेव व्यचिन्तयत् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001649057, "chapter_id": 21649, "verse_number": "१-३५-५८", "content_sanskrit": "मम जन्म कथं जातं रूपं कीदृग्विधं मम ।\nएवं विचारणपरो दिवानिशमतन्द्रि तः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001649058, "chapter_id": 21649, "verse_number": "१-३५-५९", "content_sanskrit": "अनिश्चितमतिर्भूत्वा वेदमालिर्द्विजोत्तमः ।\nपुनर्जानन्तिमागम्य प्रणम्येदमुवाच ह ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001649059, "chapter_id": 21649, "verse_number": "१-३५-६०", "content_sanskrit": "वेदमालिरुवाच ।\nममचित्तमतिभ्रान्तं गुरो ब्रह्मविदां वर ।\nकोऽहं मम क्रिया का च मम जन्म कथं वद ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001649060, "chapter_id": 21649, "verse_number": "१-३५-६१", "content_sanskrit": "जानन्तिरुवाच ।\nसत्यं सत्यं महाभाग चित्तं भ्रान्तं सुनिश्चितम् ।\nअविद्यानिलयं चित्तं कथं सद्भावमेष्यति ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001649061, "chapter_id": 21649, "verse_number": "१-३५-६२", "content_sanskrit": "ममेति गदितं यत्तु तदपि भ्रान्तिरिष्यते ।\nअहङ्कारो मनोधर्म आत्मनो न हि पण्डित ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001649062, "chapter_id": 21649, "verse_number": "१-३५-६३", "content_sanskrit": "पुनश्च कोऽहंमित्युक्तं वेदमाले त्वया तु यत् ।\nमम जात्यादिशून्यस्य कथं नाम करोम्यहम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001649063, "chapter_id": 21649, "verse_number": "१-३५-६४", "content_sanskrit": "अनौपम्यस्वभावस्य निर्गुणस्य परात्मनः ।\nनिरूपस्याप्रमेस्य कथं नाम करोम्यहम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001649064, "chapter_id": 21649, "verse_number": "१-३५-६५", "content_sanskrit": "परं ज्योतिस्स्वरूपस्य परिपूर्णाव्ययात्मनः ।\nअविच्छिन्नस्वभावस्य कथ्यते च कथं क्रिया ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001649065, "chapter_id": 21649, "verse_number": "१-३५-६६", "content_sanskrit": "स्वप्रकाशात्मनो विप्र नित्यस्य परमात्मनः ।\nअनन्तस्य क्रिया चैव कथं जन्म च कथ्यते ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001649066, "chapter_id": 21649, "verse_number": "१-३५-६७", "content_sanskrit": "ज्ञानैकवेद्यमजरं परं ब्रह्म सनातनम् ।\nपरिपूर्णं परानन्दं तस्मान्नान्यदिह द्विज ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001649067, "chapter_id": 21649, "verse_number": "१-३५-६८", "content_sanskrit": "तत्त्वमस्यादिवाक्येभ्यो ज्ञानं मोक्षस्य साधनम् ।\nज्ञाने त्वनाहते सिद्धे सर्वं ब्रह्ममयं भवेत् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001649068, "chapter_id": 21649, "verse_number": "१-३५-६९", "content_sanskrit": "एवं प्रबोधितस्तेन वेदमालिर्मुनीश्वर ।\nमुमोद पश्यन्नात्मानमात्मन्येवाच्युतं प्रभुम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001649069, "chapter_id": 21649, "verse_number": "१-३५-७०", "content_sanskrit": "उपाधिरहितं ब्रह्म स्वप्रकाशं निरञ्जनम् ।\nअहमेवेति निश्चित्य परां शान्तिमवाप्तवान् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001649070, "chapter_id": 21649, "verse_number": "१-३५-७१", "content_sanskrit": "ततश्च व्यवहारार्थं वेदमालिर्मुनीश्वरम् ।\nगुरुं प्रणम्य जानन्तिं सदा ध्यानपरोऽभवत् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7001649071, "chapter_id": 21649, "verse_number": "१-३५-७२", "content_sanskrit": "गते बहुतिथे काले वेदमालिर्मुनीश्वर ।\nवाराणसीपुरं प्राप्य परं मोक्षमवाप्तवान् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7001649072, "chapter_id": 21649, "verse_number": "१-३५-७३", "content_sanskrit": "य इमं पठतेऽध्यायं शृणुयाद्वा समाहितः ।\nस कर्मपाशविच्छेदं प्राप्य सौख्यमवाप्नुयात् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}]