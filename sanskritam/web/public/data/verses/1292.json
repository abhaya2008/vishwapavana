[{"id": 2014164, "chapter_id": 1292, "verse_number": "२-३३-१", "content_sanskrit": "जनमेजय उवाच॥\nइच्छाम्यागमनं श्रोतुं हैडिम्बस्य द्विजोत्तम।\nलङ्कायां च गतिं ब्रह्मन्पौलस्त्यस्य च दर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2014165, "chapter_id": 1292, "verse_number": "२-३३-२", "content_sanskrit": "कावेरीदर्शनं चैव आनुपूर्व्या वदस्व मे।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2014166, "chapter_id": 1292, "verse_number": "२-३३-२x", "content_sanskrit": "वैशम्पायन उवाच।\nशृणु राजन्यथा वृत्तं सहेदवस्य साहसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2014167, "chapter_id": 1292, "verse_number": "२-३३-३", "content_sanskrit": "कालनद्वीपगांश्चैव तरसाऽजित्य चाहवे।\nदक्षिणां च दिशं जित्वा चोलस्य विषयं ययौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2014168, "chapter_id": 1292, "verse_number": "२-३३-४", "content_sanskrit": "ददर्श पुण्यतोयां वै कावेरीं सरितां वराम्।\nनाजापक्षिगणैर्जुष्टां तापसैरुपशोभिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2014169, "chapter_id": 1292, "verse_number": "२-३३-५", "content_sanskrit": "कदम्बैः सप्तपर्णैश्च कश्मर्यामलकैर्वृताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2014170, "chapter_id": 1292, "verse_number": "२-३३-६", "content_sanskrit": "न्यग्रोधैश्च महाशाखैः प्लक्षैरौदुम्बरैरपि।\nशमीपलाशवृक्षैश्च अश्वत्थैः खदिरैर्वृताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2014171, "chapter_id": 1292, "verse_number": "२-३३-७", "content_sanskrit": "बदरीभिश्च सञ्छन्नामश्वकर्णैश्च शोभिताम्।\nबूतैः पुण्ड्रकपत्रैश्च कदलीवनसंवृताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2014172, "chapter_id": 1292, "verse_number": "२-३३-८", "content_sanskrit": "चक्रवाकगणैः कीर्णं प्लवैश्च जलवायसैः।\nसमुद्रकाकैः क्रौञ्चैश्च नादितां जलकुक्कुटैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2014173, "chapter_id": 1292, "verse_number": "२-३३-९", "content_sanskrit": "एवं खगैश्च बहुभिः सङ्घुष्टां जलवासिभिः।\nआश्रमैर्बहुभिः सक्तां चैत्यवृक्षैश्च शोभिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2014174, "chapter_id": 1292, "verse_number": "२-३३-१०", "content_sanskrit": "शोभितां ब्राह्मणैः शुभ्रैर्वेदवेदाङ्गपारगैः।\nक्वचित्तीररुहैर्वृक्षैर्मालाभिरिव शोभिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2014175, "chapter_id": 1292, "verse_number": "२-३३-११", "content_sanskrit": "क्वचित्सुपुष्पितैर्वृक्षैः क्वचित्सौगन्धिकोत्पलैः।\nकह्लारकुमुदोत्फुल्लैः कमलैरुपशोभिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2014176, "chapter_id": 1292, "verse_number": "२-३३-१२", "content_sanskrit": "कावेरीं तादृशीं दृष्ट्वा प्रीतिमान्पाण्डवस्तदा।\nअस्मद्राष्ट्रे यथा गङ्गा कावेरी च तथा शुभा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2014177, "chapter_id": 1292, "verse_number": "२-३३-१३", "content_sanskrit": "सहदेवस्तु तां तीर्त्वा नदीमनुचरैः सह।\nदक्षिणं तीरभासाद्य गमनायोपचक्रमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2014178, "chapter_id": 1292, "verse_number": "२-३३-१४", "content_sanskrit": "आगतं पाण्डवं तत्र श्रुत्वा विषयवासिनः।\nदर्शनार्थं ययुस्ते तु कौतूहलसमन्विताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2014179, "chapter_id": 1292, "verse_number": "२-३३-१५", "content_sanskrit": "द्रमिडाः पुरुषा राजन्स्रियचश्च प्रियदर्शनाः।\nगत्वा पाण्डुसुतं तत्र ददृशुस्ते मुदाऽन्विताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2014180, "chapter_id": 1292, "verse_number": "२-३३-१६", "content_sanskrit": "सुकुमारं विशालाक्षं व्रजन्तं त्रिदशोपमम्।\nदर्शनीयतमं लोके नेत्रैरनिमिषैरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2014181, "chapter_id": 1292, "verse_number": "२-३३-१७", "content_sanskrit": "आश्चर्यभूतं ददृशुर्द्रमिडास्ते समागताः।\nमहासेनोपमं दृष्ट्वा पूजां चक्रुश्च तस्य वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2014182, "chapter_id": 1292, "verse_number": "२-३३-१८", "content_sanskrit": "रत्नैश्च विविधैरिष्टैर्भोगैरन्यैश्च संमतैः।\nगतिमङ्गलयुक्तार्भिः स्तुवन्तो नकुलानुजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2014183, "chapter_id": 1292, "verse_number": "२-३३-१९", "content_sanskrit": "सहदेवस्तु तान्दृष्ट्वा द्रमिलानागतान्मुदा।\nविसृज्य तान्महाबाहुः प्रस्थितो दक्षिणां दिशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2014184, "chapter_id": 1292, "verse_number": "२-३३-२०", "content_sanskrit": "दूतेन तरसा चोलं विजित्य द्रमिडेश्वरम्।\nततो रत्नान्युपादाय पाण्डस्य विषयं ययौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2014185, "chapter_id": 1292, "verse_number": "२-३३-२१", "content_sanskrit": "दर्शने सहदेवस्य न च तृप्ता नराः परे।\nगच्छन्तमनुगच्छन्तः प्राप्ताः कौतूहलान्विताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2014186, "chapter_id": 1292, "verse_number": "२-३३-२२", "content_sanskrit": "ततो माद्रीसुतों राजन्मृगसङ्घान्विलोकयन्।\nगजान्वनचरानन्यान्व्याघ्रान्कुष्णमृगान्बहून् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2014187, "chapter_id": 1292, "verse_number": "२-३३-२३", "content_sanskrit": "शुकान्मयूरान्दृष्ट्वा तु गृध्रानारण्यकुक्कुटान्।\nततो देशं समासाद्य श्वशुरस्य महीपतेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2014188, "chapter_id": 1292, "verse_number": "२-३३-२४", "content_sanskrit": "प्रेषयामास माद्रेयो दूतान्पाण्ड्याय वै तदा।\nप्रतिजग्राह तस्याज्ञां सम्प्रीत्या मलयध्वजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2014189, "chapter_id": 1292, "verse_number": "२-३३-२५", "content_sanskrit": "भार्या रूपवती जिष्णोः पाण्ड्यस्य तनया शुभा।\nचित्राङ्गदेति विख्याता द्रमिडी योषितां वरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2014190, "chapter_id": 1292, "verse_number": "२-३३-२६", "content_sanskrit": "आगतं सहदेवं तु सा श्रुत्वाऽन्तः पुरे पितुः।\nप्रेषयामास सम्प्रीत्या पूजारत्नं च वै बहु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2014191, "chapter_id": 1292, "verse_number": "२-३३-२७", "content_sanskrit": "पाण्ड्योऽपि बहुरत्नानि दूतैः सह मुमोच ह।\nमणिमुक्ताप्रवालानि सहदेवाय कीर्तिमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2014192, "chapter_id": 1292, "verse_number": "२-३३-२८", "content_sanskrit": "तां दृष्ट्वाऽप्रतिमां पूजां पाण्डवोऽपि मुदा नृप।\nभ्रातुः पुत्रे बहून्रत्नान्दत्वा वै बभ्रूवाहने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2014193, "chapter_id": 1292, "verse_number": "२-३३-२९", "content_sanskrit": "पाण्ड्यं द्रमिडराजानं श्वशुरं मलयध्वजम्।\nस दूतैस्तं वशे कृत्वा मणलूरेश्वरं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2014194, "chapter_id": 1292, "verse_number": "२-३३-३०", "content_sanskrit": "ततो रत्नान्युपादाय द्रमिडैरावृतो ययौ।\nअगस्त्यस्यालयं दिव्यं देवलोकसमं गिरिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2014195, "chapter_id": 1292, "verse_number": "२-३३-३१", "content_sanskrit": "स तं प्रदक्षिमं कृत्वा मलयं भरतर्षभ।\nलङ्घयित्वा तु माद्रेयस्ताम्रपणीं नदीं शुभाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2014196, "chapter_id": 1292, "verse_number": "२-३३-३२", "content_sanskrit": "प्रसन्नसलिलां दिव्यां सुशीतां च मनोहराम्।\nसमुद्रतीरमासाद्य न्यविशत्पाण्डुनन्दनः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2014197, "chapter_id": 1292, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि दिग्विजयपर्वणि त्रयस्त्रिंशोऽध्यायः॥ ३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]