[{"id": 2109060, "chapter_id": 3366, "verse_number": "", "content_sanskrit": "मन्त्रिणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2109061, "chapter_id": 3366, "verse_number": "१", "content_sanskrit": "ततः स राजा राजेन्द्र स्कन्धे तस्य भुजङ्गमम् ।\nमुनेः क्षुत्क्षाम आसज्य स्वपुरं पुनराययौ \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2109062, "chapter_id": 3366, "verse_number": "२", "content_sanskrit": "ऋषेस्तस्य तु पुत्रोऽभूद् भुवि जातो महायशाः ।\nशृङ्गी नाम महातेजाः तिग्मवीर्योऽतिकोपनः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2109063, "chapter_id": 3366, "verse_number": "३", "content_sanskrit": "ब्रह्माणं सोऽप्युपागम्य मुनिः पूजां चकार ह ।\nसोऽनुज्ञातो गतस्तत्र शृङ्गी शुश्राव तं तदा\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2109064, "chapter_id": 3366, "verse_number": "४", "content_sanskrit": "सख्युः सकाशात् पितरं पित्रा ते धर्षितं तदा ।\nमृतं सर्पं समासक्तं पित्रा ते जनमेजय\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2109065, "chapter_id": 3366, "verse_number": "५", "content_sanskrit": "वहन्तं कुरुशार्दूल स्कन्धेनानपकारिणम् ।\nतपस्विनं महात्मानं तं मुनिप्रवरं नृप\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2109066, "chapter_id": 3366, "verse_number": "६", "content_sanskrit": "जितेन्द्रियं विशुद्धं च स्थितं कर्मण्यथाद्भुते ।\nतपसा द्योतितात्मानं स्वेष्वङ्गेषु युतं तदा\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2109067, "chapter_id": 3366, "verse_number": "७", "content_sanskrit": "शुभाचारं शुभकथं सुस्थिरं तमलोलुपम् ।\nअक्षुद्रमनसूयं च वृद्धं मौनव्रते स्थितम्\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2109068, "chapter_id": 3366, "verse_number": "८", "content_sanskrit": "शरण्यं सर्वभूतानां पित्रा विप्रकृतं तव ।\nशशापाथ स तच्छ्रुत्वा पितरं ते रुषान्वितः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2109069, "chapter_id": 3366, "verse_number": "९", "content_sanskrit": "ऋषेः पुत्रो महातेजा बालोऽपि स्थविरैर्वरः ।\nस क्षिप्रमुदकं स्पृष्ट्वा रोषादिदमुवाच ह \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2109070, "chapter_id": 3366, "verse_number": "१०", "content_sanskrit": "पितरं तेऽभिसन्धाय तेजसा प्रज्वलन्निव ।\nअनागसि गुरौ यो मे मृतं सर्पमवासृजत् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2109071, "chapter_id": 3366, "verse_number": "११", "content_sanskrit": "तं नागस्तक्षकः क्रुद्धस्तेजसा सादयिष्यति ।\nसप्तरात्रादितः पापं पश्य मे तपसो बलम्\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2109072, "chapter_id": 3366, "verse_number": "१२", "content_sanskrit": "इत्युक्त्वा प्रययौ तत्र पिता यत्रास्य सोऽभवत् ।\nदृष्ट्वा च पितरं तस्मै शापं तं प्रत्यवेदयत् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2109073, "chapter_id": 3366, "verse_number": "१३", "content_sanskrit": "स चापि मुनिशार्दूलः प्रेषयामास ते पितुः ।\nशप्तोऽसि मम पुत्रेण यत्तो भव महीपते \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2109074, "chapter_id": 3366, "verse_number": "१४", "content_sanskrit": "तक्षकस्त्वां महाराज सप्तरात्रेण धक्ष्यति ।\nश्रुत्वा तु तद्वचो घोरं पिता ते जनमेजय \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2109075, "chapter_id": 3366, "verse_number": "१५", "content_sanskrit": "यत्तोऽभवत् परित्रस्तः तक्षकात् पन्नगोत्तमात् ।\nततस्तस्मिंस्तु दिवसे सप्तमे समुपस्थिते\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2109076, "chapter_id": 3366, "verse_number": "१६", "content_sanskrit": "राज्ञः समीपं ब्रह्मर्षिः काश्यपो गन्तुमैच्छत ।\nतं ददर्शाथ नागेन्द्रः तक्षकः काश्यपं तदा \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2109077, "chapter_id": 3366, "verse_number": "१७", "content_sanskrit": "तमब्रवीत् पन्नगेन्द्रः काश्यपं त्वरितं व्रजन् ।\nक्व भवांस्त्वरितो याति किं च कार्यं चिकीर्षति \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2109078, "chapter_id": 3366, "verse_number": "", "content_sanskrit": "काश्यपः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2109079, "chapter_id": 3366, "verse_number": "१८", "content_sanskrit": "यत्र राजा कुरुश्रेष्ठः परीक्षिन्नाम वै धृतः ।\nतक्षकेण भुजङ्गेन धक्ष्यते किल तत्र वै \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2109080, "chapter_id": 3366, "verse_number": "१९", "content_sanskrit": "गच्छाम्यहं तं त्वरितः सद्यः कर्तुमपज्वरम् ।\nमयाऽभिमन्त्रितं चापि न सर्पो धर्षयिष्यति \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2109081, "chapter_id": 3366, "verse_number": "", "content_sanskrit": "तक्षकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2109082, "chapter_id": 3366, "verse_number": "२०", "content_sanskrit": "किमर्थं तं मया दष्टं सञ्जीवयितुमिच्छसि ।\nब्रूहि काममहं तेऽद्य दद्मि स्वं वेश्म गम्यताम् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2109083, "chapter_id": 3366, "verse_number": "", "content_sanskrit": "मन्त्रिणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2109084, "chapter_id": 3366, "verse_number": "२१", "content_sanskrit": "धनलिप्सुरहं तत्र यामीत्युक्तश्च तेन सः ।\nतमुवाच महात्मानं वारयन् श्लक्ष्णया गिरा \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2109085, "chapter_id": 3366, "verse_number": "२२", "content_sanskrit": "यावद्धनं प्रार्थयसे राज्ञस्तस्मात् ततोऽधिकम् ।\nगृहाण मत्त एव त्वं सन्निवर्तस्व चानघ \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2109086, "chapter_id": 3366, "verse_number": "२३", "content_sanskrit": "स एवमुक्तो नागेन काश्यपो द्विपदां वरः ।\nलब्ध्वा वित्तं निववृते तक्षकाद् यावदीप्सितम् \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2109087, "chapter_id": 3366, "verse_number": "२४", "content_sanskrit": "तस्मिन् प्रतिगते विप्रे तक्षकः छद्मनाऽऽकृतः ।\nतं नृपं नृपतिश्रेष्ठं पितरं धार्मिकं तव \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2109088, "chapter_id": 3366, "verse_number": "२५", "content_sanskrit": "प्रासादस्थं क्षणेनैव दग्धवान् विषवह्निना ।\nततस्त्वं पुरुषव्याघ्र विजयायाभिषेचितः\t ॥ २५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2109089, "chapter_id": 3366, "verse_number": "२६", "content_sanskrit": "एतद् दृष्टं श्रुतं चापि यथावन्नृपसत्तम ।\nअस्माभिर्निखिलं वृत्तं कथितं तेऽतिदारुणम् \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2109090, "chapter_id": 3366, "verse_number": "२७", "content_sanskrit": "श्रुत्वा चैतन्नृपश्रेष्ठ पार्थिवस्य पराभवम् ।\nअस्य चर्षेरुदङ्कस्य विधत्स्व यदनन्तरम् \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2109091, "chapter_id": 3366, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2109092, "chapter_id": 3366, "verse_number": "२७", "content_sanskrit": "एतत्तु श्रोतुमिच्छामि ह्यटव्यां निर्जने वने ।\nसंवादः पन्नगेन्द्रस्य काश्यपस्य च यस्तदा \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2109093, "chapter_id": 3366, "verse_number": "२८", "content_sanskrit": "केन दृष्टः श्रुतश्चापि भवतां श्रोत्रमागतम् ।\nश्रुत्वाऽहं प्रविधास्यामि पन्नगान्तकरीं मतिम् \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2109094, "chapter_id": 3366, "verse_number": "", "content_sanskrit": "मन्त्रिणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2109095, "chapter_id": 3366, "verse_number": "२९", "content_sanskrit": "शृणु राजन् यथाऽस्माकं येनैतत् कथितं पुरा ।\nसमागमं द्विजेन्द्रस्य पन्नगेन्द्रस्य चाध्वनि\t ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2109096, "chapter_id": 3366, "verse_number": "३०", "content_sanskrit": "तस्मिन् वनेचरः कश्चिदिन्धनार्थाय पार्थिव ।\nविचिन्वन् पूर्वमारूढः शुष्कशाखं वनस्पतिम्\t ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2109097, "chapter_id": 3366, "verse_number": "३१", "content_sanskrit": "अबुध्यमानौ तत्रास्तां वृक्षस्थं पन्नगद्विजौ ।\nस तु तेनैव वृक्षेण भस्मीभूतोऽभवत् तदा \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2109098, "chapter_id": 3366, "verse_number": "३२", "content_sanskrit": "द्विजप्रभावाद् राजेन्द्र जीवितः सवनस्पतिः ।\nतेनागत्य नरश्रेष्ठ नगरेऽस्मिन् निवेदितम् \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2109099, "chapter_id": 3366, "verse_number": "३४", "content_sanskrit": "यथावृत्तं तु तत् सर्वं तक्षकस्य द्विजस्य च ।\nएतत् ते कथितं राजन् यथावृत्तं यथाश्रुतम् ।\nश्रुत्वा तु नृपशार्दूल प्रकुरुष्व यथेप्सितम् \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2109100, "chapter_id": 3366, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2109101, "chapter_id": 3366, "verse_number": "३५", "content_sanskrit": "मन्त्रिणां वचनं श्रुत्वा स राजा जनमेजयः ।\nपर्यतप्यत दुःखार्तः पर्यपिङ्क्षत् करे करम्\t ॥ ३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2109102, "chapter_id": 3366, "verse_number": "३६", "content_sanskrit": "निःश्वसन्नुष्णमसकृद् दीर्घं राजीवलोचनः ।\nमुमोचाश्रूणि च तदा नेत्राभ्यां प्ररुदन् नृपः \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2109103, "chapter_id": 3366, "verse_number": "३७", "content_sanskrit": "उवाच च महीपालो दुःखशोकसमन्वितः ।\nश्रुत्वैतद् भवतां वाक्यं पितुः स्वर्गगतिं प्रति \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2109104, "chapter_id": 3366, "verse_number": "३८", "content_sanskrit": "निश्चितेयं मम मतिर्या वै तां मे निबोधत ।\nअनन्तरमहं मन्ये तक्षकस्य दुरात्मनः\t ॥ ३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2109105, "chapter_id": 3366, "verse_number": "३९", "content_sanskrit": "प्रतिकर्तव्यमित्येवं येन मे हिंसितः पिता ।\nऋषेर्हि शृङ्गेर्वचनं कृत्वा दष्ट्वा च पार्थिवः\t ॥ ३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2109106, "chapter_id": 3366, "verse_number": "४०", "content_sanskrit": "यद्यागच्छेदसौ विप्रो ननु जीवेत् पिता मम ।\nपरिहीयेत किं तस्य  यदि जीवेत् स पार्थिवः \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2109107, "chapter_id": 3366, "verse_number": "४१", "content_sanskrit": "काश्यपस्य प्रयोगेण मन्त्रिणः सुनयेन च ।\nस च वारितवान् मोहात् काश्यपं द्विजसत्तमम् \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2109108, "chapter_id": 3366, "verse_number": "४२", "content_sanskrit": "सञ्जिजीवयिषुं प्राप्तं राजानमपराजितम्\nमहानतिक्रमो ह्येष तक्षकस्य दुरात्मनः \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2109109, "chapter_id": 3366, "verse_number": "४३", "content_sanskrit": "द्विजस्य योऽददाद् वित्तं मा नृपं जीवयेदिति ।\nउदङ्कस्य प्रियं कुर्वन् आत्मनश्च मनःप्रियम् ।\nभवतां चैव सर्वेषां यास्याम्यपचितिं पितुः \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2109110, "chapter_id": 3366, "verse_number": "४५", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nपञ्चचत्वारिंशोऽध्यायः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2109111, "chapter_id": 3366, "verse_number": "२३", "content_sanskrit": "॥ आस्तीकपर्वणि त्रयस्त्रिंशोऽध्यायः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]