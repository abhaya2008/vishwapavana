[{"id": 7005549000, "chapter_id": 25549, "verse_number": "२२-१", "content_sanskrit": "ऋषय ऊचुः ।\nकस्मिन्‌ काले च तच्छ्राद्धमनन्तफलदं भवेत् ।\nकस्मिन् वासरभागे तु श्राद्धकृच्छ्राद्धमाचरेत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005549001, "chapter_id": 25549, "verse_number": "२२-२", "content_sanskrit": "तीर्थेषु केषु च कृतं श्राद्धं बहुफलं भवेत् ।\nसूत उवाच ।\nअपराह्णे तु सम्प्राप्ते अभिजिद्रौहिणोदये ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005549002, "chapter_id": 25549, "verse_number": "२२-३", "content_sanskrit": "यत्किञ्चिद्दीयते तत्र तदक्षयमुदाहृतम् ।\nतीर्थानि कानि शस्तानि पितृणां वल्लभानि च ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005549003, "chapter_id": 25549, "verse_number": "२२-४", "content_sanskrit": "नामतस्तानि वक्ष्यामि सङ्क्षेपेण द्विजोत्तमाः! ।\nपितृतीर्थं गया नाम सर्वतीर्थवरं शुभम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005549004, "chapter_id": 25549, "verse_number": "२२-५", "content_sanskrit": "यत्रास्ते देवदेवेशः स्वयमेव पितामहः ।\nतत्रैषा पितृभिर्गीता गाथा भागमभीप्सुभिः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005549005, "chapter_id": 25549, "verse_number": "२२-६", "content_sanskrit": "एष्टव्या बहवः पुत्रा यद्येकोऽपि गयां व्रजेत् ।\nयजेत वाश्वमेधेन नीलं वा वृषमुत्सृजेत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005549006, "chapter_id": 25549, "verse_number": "२२-७", "content_sanskrit": "तथावाराणसी पुण्या पितॄणां वल्लभा सदा ।\nयत्राविमुक्तसान्निध्यं भुक्ति मुक्ति फलप्रदम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005549007, "chapter_id": 25549, "verse_number": "२२-८", "content_sanskrit": "पितॄणां वल्लभं तद्वत् पुण्यञ्च विमलेश्वरम् ।\nपितृतीर्थं प्रयागन्तु सर्वकाम फलप्रदम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005549008, "chapter_id": 25549, "verse_number": "२२-९", "content_sanskrit": "वटेश्वरस्तु भगवान् माधवेन समन्वितः ।\nयोगनिद्राशयस्तद्वत् सदा वसति केशवः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005549009, "chapter_id": 25549, "verse_number": "२२-१०", "content_sanskrit": "दशाश्वमेधिकं पुण्यं गङ्गा द्वारं तथैव च ।\nनन्दाथ ललिता तद्वत्तीर्थं मायापुरी शुभा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005549010, "chapter_id": 25549, "verse_number": "२२-११", "content_sanskrit": "तथा मित्रपदं नाम ततः केदारमुत्तमम् ।\nगङ्गा सागरमित्याहुः सर्वतीर्थमयं शुभम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005549011, "chapter_id": 25549, "verse_number": "२२-१२", "content_sanskrit": "तीर्थं ब्रह्मसरस्तद्वच्छतद्रु सलिले ह्रदे ।\nतीर्थन्तु नैमिषं नाम सर्वतीर्थफलप्रदम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005549012, "chapter_id": 25549, "verse_number": "२२-१३", "content_sanskrit": "गङ्गोद्भेदस्तु गोमत्यां यत्रोद्‌भूतः सनातनः ।\nतथा यज्ञवराहस्तु देवदेवश्च शूलभृत् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005549013, "chapter_id": 25549, "verse_number": "२२-१४", "content_sanskrit": "यत्र तत्काञ्चनं द्वारमष्टादशभुजो हरः ।\nनेमिस्तु हरिचक्रस्य शीर्णा यत्राभवत्पुरा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005549014, "chapter_id": 25549, "verse_number": "२२-१५", "content_sanskrit": "तदेतन्नैमिषारण्यं सर्वतीर्थनिषेवितम् ।\nदेवदेवस्य तत्रापि वाराहस्य तु दर्शनम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005549015, "chapter_id": 25549, "verse_number": "२२-१६", "content_sanskrit": "यः प्रयाति स पूतात्मा नारायणपदं व्रजेत् ।\nकृतशौचं महापुण्यं सर्वपापनिषूदनम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005549016, "chapter_id": 25549, "verse_number": "२२-१७", "content_sanskrit": "यत्रास्ते नारसिंहस्तु स्वयमेव जनार्दनः ।\nतीर्थमिक्षुमती नाम पितॄणां वल्लभं सदा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005549017, "chapter_id": 25549, "verse_number": "२२-१८", "content_sanskrit": "सङ्गमे यत्र तिष्ठन्ति गङ्गायाः पितरः सदा ।\nकुरुक्षेत्रं महापुण्यं सर्वतीर्थ समन्वितम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005549018, "chapter_id": 25549, "verse_number": "२२-१९", "content_sanskrit": "तथा च सरयूः पुण्या सर्वदेवनमस्कृता ।\nइरावती नदी तद्वत् पितृतीर्थाधिवासिनी ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005549019, "chapter_id": 25549, "verse_number": "२२-२०", "content_sanskrit": "यमुना देविका काली चन्द्रभागा दृषद्वती ।\nनदी वेणुमती पुण्या परा वेत्रवती तथा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005549020, "chapter_id": 25549, "verse_number": "२२-२१", "content_sanskrit": "पितॄणां वल्लभा ह्येताः श्राद्धे कोटिगुणा मताः ।\nजम्बूमार्गं महापुण्यं यत्र मार्गो हि लक्ष्यते ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005549021, "chapter_id": 25549, "verse_number": "२२-२२", "content_sanskrit": "अद्यापि पितृतीर्थं तत् सर्वकामफलप्रदम् ।\nनीलकुण्डमितिख्यातं पितृतीर्थं द्विजोत्तमाः! ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005549022, "chapter_id": 25549, "verse_number": "२२-२३", "content_sanskrit": "तथा रुद्रसरः पुण्यं सरोमानसमेव च ।\nमन्दाकिनी तथाच्छोदा विपाशाथ सरस्वती ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005549023, "chapter_id": 25549, "verse_number": "२२-२४", "content_sanskrit": "पूर्वे मित्रपदन्तद्वत् वैद्यनाथं महाफलम् ।\nक्षिप्रा नदी महाकालस्तथा कालञ्जरं शुभम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005549024, "chapter_id": 25549, "verse_number": "२२-२५", "content_sanskrit": "वंशोद्भेदं हरोद्भेदं गङ्गोद्भेदं महाफलम् ।\nभद्रेश्वरं विष्णुपदं नर्मदा द्वारमेव च॥. २५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005549025, "chapter_id": 25549, "verse_number": "२२-२६", "content_sanskrit": "गयापिण्डप्रदानेन समान्याहुर्महर्षयः ।\nएतानि पितृतीर्थानि सर्वपापहराणि च ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005549026, "chapter_id": 25549, "verse_number": "२२-२७", "content_sanskrit": "स्मरणादपि लोकानां किमु श्राद्धकृतां नृणाम् ।\nओङ्कारं पितृतीर्थञ्च कावेरी कपिलोदकम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005549027, "chapter_id": 25549, "verse_number": "२२-२८", "content_sanskrit": "सम्भेदश्चण्डवेगायास्तथैवामर कण्टकम् ।\nकुरुक्षेत्राच्छतगुणं तस्मिन् स्नानादिकं भवेत् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005549028, "chapter_id": 25549, "verse_number": "२२-२९", "content_sanskrit": "शुक्रतीर्थञ्च विख्यातं तीर्थं सोमेश्वरं परम् ।\nसर्वव्याधिहरं पुण्यं शतकोटि फलाधिकम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005549029, "chapter_id": 25549, "verse_number": "२२-३०", "content_sanskrit": "श्राद्धे दाने तथा होमे स्वाध्याये जलसन्निधौ ।\nकायावरोहणं नाम तथा चर्मण्वतीनदी ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005549030, "chapter_id": 25549, "verse_number": "२२-३१", "content_sanskrit": "गोमती वरुणा तद्वत्तीर्थमौशनसम्परम् ।\nभैरवं भृगुतुङ्गञ्च गौरीतीर्थमनुत्तमम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005549031, "chapter_id": 25549, "verse_number": "२२-३२", "content_sanskrit": "तीर्थं वैनायकं नाम भद्रेश्वरमतः परम् ।\nतथा पापहरं नाम पुण्याथ तपती नदी ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005549032, "chapter_id": 25549, "verse_number": "२२-३३", "content_sanskrit": "मूलतापीपयोष्णी च पयोष्णीसङ्गमस्तथा ।\nमहावोधिः पाटला च नागतीर्थमवन्तिका ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005549033, "chapter_id": 25549, "verse_number": "२२-३४", "content_sanskrit": "तथा वेणा नदी पुण्या महाशालं तथैव च ।\nमहारुद्रं महालिङ्गं दशार्णा च नदी शुभा ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005549034, "chapter_id": 25549, "verse_number": "२२-३५", "content_sanskrit": "शतरुद्रा शताह्वा च तथा विश्वपदं परम् ।\nअङ्गारवाहिका तद्वन्नदौ तौ शोणघर्घरौ ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7005549035, "chapter_id": 25549, "verse_number": "२२-३६", "content_sanskrit": "कालिका च नदी पुण्या वितस्ता च नदी तथा ।\nएतानि पितृतीर्थानि शस्यन्ते स्नानदानयोः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7005549036, "chapter_id": 25549, "verse_number": "२२-३७", "content_sanskrit": "श्राद्धमेतेषु यद्दत्तन्तदनन्तफलं स्मृतम् ।\nद्रोणी वाटनदी धारा सरित् क्षीरनदी तथा ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7005549037, "chapter_id": 25549, "verse_number": "२२-३८", "content_sanskrit": "गोकर्णं गजकर्णञ्च तथा च पुरुषोत्तमः ।\nद्वारका कृष्णतीर्थञ्च तथार्बुदसरस्वती ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7005549038, "chapter_id": 25549, "verse_number": "२२-३९", "content_sanskrit": "नदी मणिमती नाम तथा च गिरिकर्णिका ।\nधूतपापं तथा तीर्थं समुद्रो दक्षिणस्तथा ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7005549039, "chapter_id": 25549, "verse_number": "२२-४०", "content_sanskrit": "एतेषु पितृतीर्थेषु श्राद्धमानन्त्यमश्नुते ।\nतीर्थं मेघकरं नाम स्वयमेव जनार्दनः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7005549040, "chapter_id": 25549, "verse_number": "२२-४१", "content_sanskrit": "यत्र शार्ङ्गधरो विष्णुर्मेखलायामवस्थितः ।\nतथा मन्डोदरी तीर्थं तीर्थं चम्पा नदी शुभा ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7005549041, "chapter_id": 25549, "verse_number": "२२-४२", "content_sanskrit": "तथा सा मलनाथश्च महाशाल नदी तथा ।\nचक्रवाकं चर्म्मकोटं तथा जन्मेश्वरं महत् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7005549042, "chapter_id": 25549, "verse_number": "२२-४३", "content_sanskrit": "अर्जुनं त्रिपुरं चैव सिद्धेश्वरमतः परम् ।\nश्रीशैलं शाङ्करं तीर्थं नारसिंहमतः परम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7005549043, "chapter_id": 25549, "verse_number": "२२-४४", "content_sanskrit": "महेन्द्रञ्च तथा पुण्यमथ श्रीरङ्गसञ्ज्ञितम् ।\nएतेष्वपि सदा श्राद्धमनन्तफलदं स्मृतम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7005549044, "chapter_id": 25549, "verse_number": "२२-४५", "content_sanskrit": "दर्शनादपि चैतानि सद्यः पापहराणि वै ।\nतुङ्गभद्रा नदी पुण्या तथा भीमरथी सरित् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7005549045, "chapter_id": 25549, "verse_number": "२२-४६", "content_sanskrit": "भीमेश्वरं कृष्णवेणा कावेरी कुड्‌मलानदी ।\nनदी गोदावरी नाम त्रिसन्ध्या तीर्थमुत्तमम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7005549046, "chapter_id": 25549, "verse_number": "२२-४७", "content_sanskrit": "तीर्थं त्रैयम्बकं नाम सर्वतीर्थ नमस्कृतम् ।\nयत्रास्ते भगवानीशः स्वयमेव त्रिलोचनः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7005549047, "chapter_id": 25549, "verse_number": "२२-४८", "content_sanskrit": "श्राद्धमेतेषु सर्वेषु कोटिकोटिगुणं भवेत् ।\nस्मरणादपि पापानि नश्यन्ति शतधा द्विजः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7005549048, "chapter_id": 25549, "verse_number": "२२-४९", "content_sanskrit": "श्रीपर्णी ताम्रपर्णी च जया तीर्थमनुत्तमम् ।\nतथा मत्स्यनदी पुण्या शिवधारं तथैव च ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7005549049, "chapter_id": 25549, "verse_number": "२२-५०", "content_sanskrit": "भद्रतीर्थञ्च विख्यातं पम्पातीर्थञ्च शाश्वतम् ।\nपुण्यं रामेश्वरं तद्वदेलापुरमलं पुरम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7005549050, "chapter_id": 25549, "verse_number": "२२-५१", "content_sanskrit": "अङ्गभूतञ्च विख्यातमानन्दकमलं बुधम् ।\nआम्रातकेश्वरं तद्वदेकाम्भकमतः परम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7005549051, "chapter_id": 25549, "verse_number": "२२-५२", "content_sanskrit": "गोवर्धनं हरिश्चन्द्रं कृपुचन्द्रं पृथूदकम् ।\nसहस्राक्षं हिरण्याक्षं तथा च कदली नदी॥. ५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7005549052, "chapter_id": 25549, "verse_number": "२२-५३", "content_sanskrit": "रामाधिवासस्तत्रापि तथा सौमित्रिसङ्गमः ।\nइन्द्रकीलं महानादन्तथा च प्रियमेलकम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7005549053, "chapter_id": 25549, "verse_number": "२२-५४", "content_sanskrit": "एतान्यपि सदा श्राद्धे प्रशस्तान्यधिकानि तु ।\nएतेषु सर्वदेवानां सान्निध्यं द्रृश्यते यतः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7005549054, "chapter_id": 25549, "verse_number": "२२-५५", "content_sanskrit": "दानमेतेषु सर्वेषु दत्तं कोटिशताधिकम् ।\nबाहुदा च नदी पुण्या तथा सिद्धवनं शुभम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7005549055, "chapter_id": 25549, "verse_number": "२२-५६", "content_sanskrit": "तीर्थं पाशुपतं नाम नदी पार्वतिका शुभा ।\nश्राद्धमेतेषु सर्वेषु दत्तं कोटिशतोत्तरम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7005549056, "chapter_id": 25549, "verse_number": "२२-५७", "content_sanskrit": "तथैव पितृतीर्थन्तु यत्र गोदावरी नदी ।\nयुतालिङ्गसहस्रेण सर्वान्तरजलावहा ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7005549057, "chapter_id": 25549, "verse_number": "२२-५८", "content_sanskrit": "जामदग्न्यस्य तत्तीर्थं क्रमादायातमुत्तमम् ।\nप्रतीकस्य भयाद्भिन्नं यत्र गोदावरी नदी ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7005549058, "chapter_id": 25549, "verse_number": "२२-५९", "content_sanskrit": "तत्तीर्थं हव्यकव्यानामप्सरो युगसञ्ज्ञितम् ।\nश्राद्धाग्निकार्यदानेषु तथा कोटि शताधिकम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7005549059, "chapter_id": 25549, "verse_number": "२२-६०", "content_sanskrit": "तथा सहस्रलिङ्गञ्च राघवेश्वरमुत्तमम् ।\nसेन्द्रफेना नदी पुण्या यत्रेन्द्रः पतितः पुरा ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7005549060, "chapter_id": 25549, "verse_number": "२२-६१", "content_sanskrit": "निहत्य नमुचिं शक्रस्तपसा स्वर्गमाप्तवान् ।\nतत्र दत्तं नरैः श्राद्धमनन्तफलदं भवेत् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7005549061, "chapter_id": 25549, "verse_number": "२२-६२", "content_sanskrit": "तीर्थन्तु पुष्करं नाम शालग्रामं तथैव च ।\nसोमपानञ्च विख्यातं यत्र वैश्वानरालयम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7005549062, "chapter_id": 25549, "verse_number": "२२-६३", "content_sanskrit": "तीर्थं सारस्वतं नाम स्वामितीर्थं तथैव च ।\nमलन्दरा नदीपुण्या कोशिकी चन्द्रिका तथा ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7005549063, "chapter_id": 25549, "verse_number": "२२-६४", "content_sanskrit": "वैदर्भावाथ वैरा च पयोष्णी प्राङ्मुखापरा ।\nकावेरी चोत्तरापुण्या तथाजालन्धरो गिरिः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7005549064, "chapter_id": 25549, "verse_number": "२२-६५", "content_sanskrit": "एतेषु श्राद्धतीर्थेषु श्राद्धमानन्त्यमश्नुते ।\nलोहदण्डं तथा तीर्थं चित्रकूटस्तथैव च ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7005549065, "chapter_id": 25549, "verse_number": "२२-६६", "content_sanskrit": "विन्ध्ययोगश्च गङ्गायास्तथा नदीतटं शुभम् ।\nकुब्जाम्रन्तु तथा तीर्थं उर्वशी पुलिनं तथा ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7005549066, "chapter_id": 25549, "verse_number": "२२-६७", "content_sanskrit": "संसारमोचनं तीर्थं तथैव ऋणमोचनम् ।\nएतेषु पितृतीर्थेषु श्राद्धमानन्त्यमश्नुते ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7005549067, "chapter_id": 25549, "verse_number": "२२-६८", "content_sanskrit": "अट्टहासं तथा तीर्थं गौतमेश्वरमेव च ।\nतथा वशिष्ठं तीर्थन्तु हारितं तु ततः परम्॥. ६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7005549068, "chapter_id": 25549, "verse_number": "२२-६९", "content_sanskrit": "ब्रह्मावर्तं कुशावर्तं हयतीर्थं तथैव च ।\nपिण्डाारकञ्च विख्यातं शङ्खोद्धारं तथैव च ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7005549069, "chapter_id": 25549, "verse_number": "२२-७०", "content_sanskrit": "घण्टेाश्वरं बिल्वकञ्च नीलपर्वतमेव च ।\nतथा च धरणी तीर्थं रामतीर्थं तथैव च॥. ७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7005549070, "chapter_id": 25549, "verse_number": "२२-७१", "content_sanskrit": "अश्वतीर्थञ्च विख्यातमनन्तं श्राद्धदानयोः ।\nतीर्थं वेदशिरो नाम तथैवौघवती नदी ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7005549071, "chapter_id": 25549, "verse_number": "२२-७२", "content_sanskrit": "तीर्थं वसुप्रदं नाम च्छागलाण्डं तथैव च ।\nएतेषु श्राद्धदातारः प्रयान्ति परमं पदम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7005549072, "chapter_id": 25549, "verse_number": "२२-७३", "content_sanskrit": "तथा च बदरी तीर्थं गणतीर्थं तथैव च ।\nजयन्तं विजयञ्चैव शुक्रतीर्थं तथैव च ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7005549073, "chapter_id": 25549, "verse_number": "२२-७४", "content_sanskrit": "श्रीपतेश्च तथा तीर्थं तीर्थं रैवतकं तथा ।\nतथैव शारदा तीर्थं भद्रकालेश्वरं तथा ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7005549074, "chapter_id": 25549, "verse_number": "२२-७५", "content_sanskrit": "वैकुण्ठतीर्थञ्च परं भीमेश्वरमथापि वा ।\nएतेषु श्राद्धदातारः प्रयान्ति परमां गतिम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7005549075, "chapter_id": 25549, "verse_number": "२२-७६", "content_sanskrit": "तीर्थं मातृगृहं नाम करवीरपुरं तथा ।\nकुशेशरञ्च विख्यातं गौरी शिखरमेव च ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7005549076, "chapter_id": 25549, "verse_number": "२२-७७", "content_sanskrit": "नकुलेशस्य तीर्थञ्च कर्दमालं तथैव च ।\nदिण्डिपुण्यकरं तद्वत् पुण्डरीकपुरं तथा ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7005549077, "chapter_id": 25549, "verse_number": "२२-७८", "content_sanskrit": "सप्त गोदावरी तीर्थं सर्वतीर्थेश्वरेश्वरम् ।\nतत्र श्राद्धं प्रदातव्यमनन्तफलमीप्सुभिः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7005549078, "chapter_id": 25549, "verse_number": "२२-७९", "content_sanskrit": "एषतूद्देशतः प्रोक्तस्तीर्थानां सङ्ग्रहो मया ।\nवागीशोऽपि न शक्नोति विस्तरान् किमु मानुषः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7005549079, "chapter_id": 25549, "verse_number": "२२-८०", "content_sanskrit": "सत्यं तीर्थं दया तीर्थं तीर्थमिन्द्रियनिग्रहः ।\nवर्णाश्रमाणां गेहेऽपि तीर्थन्तु समुदाहृतम्॥. ८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7005549080, "chapter_id": 25549, "verse_number": "२२-८१", "content_sanskrit": "एतत्तीर्थेषु यच्छ्राद्धं तत्कोटि गुणमिष्यते ।\nयस्मात्तस्मात् प्रयत्नेन तीर्थे श्राद्धं समाचरेत्॥ २२ .८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7005549081, "chapter_id": 25549, "verse_number": "२२-८२", "content_sanskrit": "प्रातः कालो मुहूर्तांस्त्रीन् सङ्गवस्तावदेव तु ।\nमध्याह्न स्त्रिमुहूर्तस्यादपराह्णस्ततः परम् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7005549082, "chapter_id": 25549, "verse_number": "२२-८३", "content_sanskrit": "सायाह्नस्त्रिमुहूर्तः स्याच्छ्राद्धं तत्र न कारयेत् ।\nराक्षसी नाम सा वेला गर्हिता सर्वकर्मसु ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7005549083, "chapter_id": 25549, "verse_number": "२२-८४", "content_sanskrit": "अह्नो मुहूर्तो विख्याता दश पञ्च च सर्वदा ।\nतत्राष्टमो मुहूर्तो यः सकालः कुतपः स्मृतः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7005549084, "chapter_id": 25549, "verse_number": "२२-८५", "content_sanskrit": "मध्याह्ने सर्वदा यस्मान्मन्दीभवति भास्करः ।\nतस्मादनन्तफलद स्तदारम्भो भविष्यति ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7005549085, "chapter_id": 25549, "verse_number": "२२-८६", "content_sanskrit": "मध्याह्नखड्ग पात्रञ्च तथा नेपालकम्बलः ।\nरूप्यं दर्भास्तिला गावो दौहित्रश्चाष्टमः स्मृतः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7005549086, "chapter_id": 25549, "verse_number": "२२-८७", "content_sanskrit": "पापं कुत्सितमित्याहुस्तस्य सन्तापकारिणः ।\nअष्टावेतेयतस्तस्मात् कुतपा इति विश्रुता ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7005549087, "chapter_id": 25549, "verse_number": "२२-८८", "content_sanskrit": "ऊर्ध्वं मुहूर्तात् कुतपाद्यन्‌मुहूर्तचतुष्टयम् ।\nमुहूर्तपञ्चकञ्चैतत्‌ स्वधाभवनमिष्यते ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7005549088, "chapter_id": 25549, "verse_number": "२२-८९", "content_sanskrit": "विष्णोर्देहसमुद्‌भूताः कुशाः कृष्णास्तिलास्तथा ।\nश्राद्धस्य रक्षणायालमेतत् प्राहुर्दिवौकसः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7005549089, "chapter_id": 25549, "verse_number": "२२-९०", "content_sanskrit": "तिलोदकाञ्जलिर्देय जलस्थैस्तीर्थवासिभिः ।\nसदर्भहस्तेनैकेन श्राद्धमेवं विशिष्यते ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7005549090, "chapter_id": 25549, "verse_number": "२२-९१", "content_sanskrit": "श्राद्धसाधनकाले तु पाणिनैकेन दीयते ।\nतर्पणन्तू भयेनैव विधिरेष सदा स्मृतः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7005549091, "chapter_id": 25549, "verse_number": "२२-९२", "content_sanskrit": "पुण्यं पवित्रामायुष्यं सर्वपापविनाशनम् ।\nपुरा मत्स्येन कथितन्तीर्थश्राद्धानुकीर्तनम् ।\nश्रृणोति यः पठेद्वापि श्रीमान् सञ्जायते नरः ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7005549092, "chapter_id": 25549, "verse_number": "२२-९३", "content_sanskrit": "श्राद्धकाले च वक्तव्यं तथा तीर्थनिवासिभिः ।\nसर्वपापोपशान्त्यर्थमलक्ष्मीनाशनं परम् ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7005549093, "chapter_id": 25549, "verse_number": "२२-९४", "content_sanskrit": "इदं पवित्रं यशयो निधानमिदं महापापहरञ्च पुंसाम् ।\nब्रह्मार्करुद्रैरपि पूजितञ्च श्राद्धस्य माहात्म्यमुशन्ति तज्ज्ञाः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}]