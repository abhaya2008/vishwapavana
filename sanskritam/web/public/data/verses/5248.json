[{"id": 2199697, "chapter_id": 5248, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2199698, "chapter_id": 5248, "verse_number": "१", "content_sanskrit": "भूय एव कुरुश्रेष्ठ दानानां विधिमुत्तमम् ।\nकथयस्व महाप्राज्ञ भूमिदानं विशेषतः\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2199699, "chapter_id": 5248, "verse_number": "२", "content_sanskrit": "पृथिवीं क्षत्रियो दद्याद् ब्राह्मणस्तां स्वकर्मणा ।\nविधिवत् प्रतिगृह्णीयान्न त्वन्यो दातुमर्हति\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2199700, "chapter_id": 5248, "verse_number": "३", "content_sanskrit": "सर्ववर्णैस्तु यच्छक्यं प्रदातुं फलकाङ्क्षिभिः ।\nवेदे वा यत् समाम्नातं तन्मे व्याख्यातुमर्हसि\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2199701, "chapter_id": 5248, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2199702, "chapter_id": 5248, "verse_number": "४", "content_sanskrit": "तुल्यनामानि देयानि त्रीणि तुल्यफलानि च ।\nसर्वकामफलानीह गावः पृथ्वी सरस्वती\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2199703, "chapter_id": 5248, "verse_number": "५", "content_sanskrit": "यो ब्रूयाच्चापि शिष्याय धर्म्यां ब्राह्मीं सरस्वतीम् ।\nपृथिवीगोप्रदानाभ्यां स तुल्यं फलमश्नुते\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2199704, "chapter_id": 5248, "verse_number": "६", "content_sanskrit": "तथैव गाः प्रशंसन्ति न च देयं ततः परम् ।\nसन्निकृष्टफलास्ता हि लघ्वर्थाश्च युधिष्ठिर ।\nमातरः सर्वभूतानां गावः सर्वसुखप्रदाः\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2199705, "chapter_id": 5248, "verse_number": "७", "content_sanskrit": "वृद्धिमाकाङ्क्षता नित्यं गावः कार्याः प्रदक्षिणाः ।\nमङ्गलायतनं देव्यस्तस्मात् पूज्याः सदैव हि ।\nसन्ताड्या न तु पादेन गवां मध्ये च न व्रजेत्\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2199706, "chapter_id": 5248, "verse_number": "८", "content_sanskrit": "प्रचोदनं देवकृतं गवां कर्मसु वर्तताम् ।\nपूर्वमेवाक्षरं नान्यदभिधेयं कथञ्चन\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2199707, "chapter_id": 5248, "verse_number": "९", "content_sanskrit": "प्रचारे वा निपाने वा बुधो नोद्वेजयेत गाः ।\nतृषिता ह्यभिवीक्षन्त्यो नरं हन्युः सबान्धवम्\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2199708, "chapter_id": 5248, "verse_number": "१०", "content_sanskrit": "पितृसद्मानि सततं देवतायतनानि च ।\nपूयन्ते शकृता यासां पूतं किमधिकं ततः\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2199709, "chapter_id": 5248, "verse_number": "११", "content_sanskrit": "ग्रासमुष्टिं परगवे दद्यात् संवत्सरं तु यः ।\nअकृत्वा स्वयमाहारं व्रतं तत् सार्वकामिकम्\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2199710, "chapter_id": 5248, "verse_number": "१२", "content_sanskrit": "स हि पुत्रान् यशोर्थं च श्रियं चाप्यधिगच्छति ।\nनाशयत्यशुभं चैव दुःस्वप्नं च व्यपोहति\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2199711, "chapter_id": 5248, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2199712, "chapter_id": 5248, "verse_number": "१३", "content_sanskrit": "देयाः किंलक्षणा गावः काश्चापि परिवर्जयेत् ।\nकीदृशाय प्रदातव्या न देयाः कीदृशाय च\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2199713, "chapter_id": 5248, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2199714, "chapter_id": 5248, "verse_number": "१४", "content_sanskrit": "असद्वृत्ताय पापाय लुब्धायानृतवादिने ।\nहव्यकव्यव्यपेताय न देया गौः कथञ्चन\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2199715, "chapter_id": 5248, "verse_number": "१५", "content_sanskrit": "भिक्षवे बहुपुत्राय श्रोत्रियायाहिताग्नये ।\nदत्त्वा दशगवां दाता लोकानाप्नोत्यनुत्तमान्\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2199716, "chapter_id": 5248, "verse_number": "१६", "content_sanskrit": "यं चैव धर्मं कुरुते तस्य पुण्यफलं च यत् ।\nसर्वस्यैवांशभाग् दाता तन्निमित्तं प्रवृत्तयः\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2199717, "chapter_id": 5248, "verse_number": "१७", "content_sanskrit": "जुहोति यद् भोजयति यद् ददाति गवां रसैः ।\nअर्थस्य दशभाग् दाता तन्निवृत्तप्रवृत्तये\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2199718, "chapter_id": 5248, "verse_number": "१८", "content_sanskrit": "यश्चैनमुत्पादयति यश्चैनं त्रायते भयात् ।\nयश्चास्य कुरुते वृत्ति सर्वे ते पितरस्त्रयः\t ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2199719, "chapter_id": 5248, "verse_number": "१९", "content_sanskrit": "कल्मषं गुरुशुश्रूषा हन्ति मानो महद्यशः ।\nअपुत्रतां त्रयः पुत्रा अवृत्तिं दश धेनवः\t ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2199720, "chapter_id": 5248, "verse_number": "२०", "content_sanskrit": "वेदान्तनिष्ठस्य बहुश्रुतस्य\nप्रज्ञानतृप्तस्य जितेन्द्रियस्य ।\nशिष्टस्य दान्तस्य यतस्य चैव\nभूतेषु नित्यं प्रियवादिनश्च \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2199721, "chapter_id": 5248, "verse_number": "२१", "content_sanskrit": "यः क्षुद्भयाद्वै न विकर्म कुर्यात्\nमृदुर्दान्तश्चातिथेयश्च नित्यम् ।\nवृत्तिं विप्रायातिसृजेत तस्मै\nयस्तुल्यशीलश्च सपुत्रदारः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2199722, "chapter_id": 5248, "verse_number": "२२", "content_sanskrit": "शुभे पात्रे ये गुणा गोप्रदाने\nतावान् दोषो ब्राह्मणस्वापहारे ।\nसर्वावस्थं ब्राह्मणस्वापहारो\nदाराश्चैषां दूरतो वर्जनीयाः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2199723, "chapter_id": 5248, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2199724, "chapter_id": 5248, "verse_number": "२३", "content_sanskrit": "ब्राह्मणस्वापहारेण कियान् दोषो भवन्त्युत ।\nब्रह्मस्वमुच्यते किं वा तन्मे ब्रूहि पितामह\t ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2199725, "chapter_id": 5248, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2199726, "chapter_id": 5248, "verse_number": "२४", "content_sanskrit": "विप्रदारे परहृते विप्रस्वनिचये तथा ।\nपरित्रायन्ति शक्तास्तु नमस्तेभ्यो मृतास्तु वा\t ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2199727, "chapter_id": 5248, "verse_number": "२५", "content_sanskrit": "न पालयन्ति निहता ये तान् वैवस्वतो यमः ।\nदण्डयन् भर्त्सयन् नित्यं निरयेभ्यो न मुञ्चति\t ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2199728, "chapter_id": 5248, "verse_number": "२६", "content_sanskrit": "तथा गवां परित्राणे पीडने च शुभाशुभे ।\nविप्रगोषु विशेषेण रक्षितेषु हृतेषु वा\t ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2199729, "chapter_id": 5248, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम्\nअनुशासनपर्वणि दानधर्मे गोदानलक्षणकथनं नाम एकोनशततमोऽध्यायः ॥९९॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]