[{"id": 2105020, "chapter_id": 3263, "verse_number": "१५-१-१", "content_sanskrit": "श्रीवेदव्यासाय नमः।\nनारायणं नमस्कृत्य नरं चैव नरोत्तमम्।\nदेवीं सरस्वतीं व्यासं ततो जयमुदीरयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2105021, "chapter_id": 3263, "verse_number": "१५-१-१x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2105022, "chapter_id": 3263, "verse_number": "१५-१-१", "content_sanskrit": "षट्त्रिंशे त्वथ् संप्राप्ते वर्षे कौरवन्दनः।\nददर्श विपरीतानि निमित्तानि युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2105023, "chapter_id": 3263, "verse_number": "१५-१-२", "content_sanskrit": "ववुर्वाताश्च निर्घाता रूक्षाः शर्करवर्षिणः।\nअपसव्यानि शकुना मण्डलानि प्रचक्रिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2105024, "chapter_id": 3263, "verse_number": "१५-१-३", "content_sanskrit": "प्रत्यगूहुर्महानद्यो दिशो नीहारसंवृताः।\nउल्काश्चाङ्गारवर्षिण्यः प्रापतन्गगनाद्भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2105025, "chapter_id": 3263, "verse_number": "१५-१-४", "content_sanskrit": "आदित्यो रजसा राजन्समवच्छन्नगनाद्भुवि॥\nविरश्मिरुदये नित्यं कबन्धैः समलङ्कृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2105026, "chapter_id": 3263, "verse_number": "१५-१-५", "content_sanskrit": "परिवेषाश्च दृश्यन्ते दारुणाश्च द्रसूर्ययोः।\nत्रिवर्णाः श्यामरुक्षान्तास्तथा भस्मारुणप्रभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2105027, "chapter_id": 3263, "verse_number": "१५-१-६", "content_sanskrit": "एते चान्ये च बहव उत्पाता भयसंसिनः।\nदृश्यन्ते जगतो नाथ दिवमारोढुमिच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2105028, "chapter_id": 3263, "verse_number": "१५-१-७", "content_sanskrit": "`यस्य प्रसादाद्धर्मोऽयं कृते यद्वत्कलावपि।\nपाण्डवाश्च महाभाग युक्तास्तु यशसाऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2105029, "chapter_id": 3263, "verse_number": "१५-१-८", "content_sanskrit": "कस्य चित्त्वथ कालस्य कुरुराजो विशङ्कितः।\nशुश्राव वृष्णिचक्रस्य मुसलोत्सादनं कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2105030, "chapter_id": 3263, "verse_number": "१५-१-९", "content_sanskrit": "विमुक्तं वासुदेवं च श्रुत्वा रामं च पाण्डवः।\nसमानीयाब्रवीद्भ्रातृन्कि करिष्याम इत्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2105031, "chapter_id": 3263, "verse_number": "१५-१-१०", "content_sanskrit": "परस्परं समासाद्य ब्रह्मदण्डबलात्कृतान्।\nवृष्णिन्विनष्टास्ते श्रुत्वा व्यथिताः पाण्डवा भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2105032, "chapter_id": 3263, "verse_number": "१५-१-११", "content_sanskrit": "निधनं वासुदेवस्य समुद्रस्येव शोषणम्।\nवीरा न श्रद्दधुस्तस्य विनाशं शार्ङ्गधन्वनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2105033, "chapter_id": 3263, "verse_number": "१५-१-१२", "content_sanskrit": "मौसलं ते समाश्रित्य दुःखशोकसमन्विताः।\nविष्ण्णा हतसंकल्पाःकि पाण्डवाः समुपाविशन्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2105034, "chapter_id": 3263, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते मौसलपर्वणि प्रथमोऽध्यायः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]