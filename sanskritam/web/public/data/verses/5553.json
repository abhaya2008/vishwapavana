[{"id": 2213266, "chapter_id": 5553, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2213267, "chapter_id": 5553, "verse_number": "१", "content_sanskrit": "तत आज्ञापयामास सेनां भरतसत्तमः ।\nअर्जुनप्रमुखैर्गुप्तां लोकपालोपमैर्नरैः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2213268, "chapter_id": 5553, "verse_number": "२", "content_sanskrit": "योगो योग इति प्रीत्या ततः शब्दो महानभूत् ।\nक्रोशतां सादिनां तत्र युज्यतां युज्यतामिति\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2213269, "chapter_id": 5553, "verse_number": "३", "content_sanskrit": "केचिद्यानैर्जना जग्मुः केचिदश्वैर्मनोजवैः ।\nरथैश्च नगराकारैः प्रदीप्तज्वलनोपमैः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2213270, "chapter_id": 5553, "verse_number": "४", "content_sanskrit": "गजेन्द्रैर्गर्जितैः केचिद् केचिदुष्ट्रैर्नराधिप ।\nपदातयश्च पुरुषाः नखरप्रासयोधिनः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2213271, "chapter_id": 5553, "verse_number": "५", "content_sanskrit": "पौरजानपदाश्चैव यानैर्बहुविधैस्तथा ।\nअन्वयुः कुरुराजानं धृतराष्ट्रदिदृक्षया\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2213272, "chapter_id": 5553, "verse_number": "६", "content_sanskrit": "स चापि राजवचनाद् आचार्यो गौतमः कृपः ।\nसेनामादाय सेनानीः प्रययावाश्रमं प्रति\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2213273, "chapter_id": 5553, "verse_number": "७", "content_sanskrit": "ततो द्विजैर्वृतः श्रीमान् कुरुराजो युधिष्ठिरः ।\nसंस्तूयमानो मुनिभिः सूतमागधवन्दिभिः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2213274, "chapter_id": 5553, "verse_number": "८", "content_sanskrit": "पाण्डरेणातपत्रेण ध्रियमाणेन मूर्धनि ।\nरथानीकेन महता निर्ययौ कुरुनन्दनः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2213275, "chapter_id": 5553, "verse_number": "९", "content_sanskrit": "गजैश्चाचलसङ्काशैर्भीमकर्मा महाभुजः ।\nसज्जयन्त्रायुधोपेतैः प्रययौ मारुतात्मजः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2213276, "chapter_id": 5553, "verse_number": "१०", "content_sanskrit": "माद्रीपुत्रावपि तथा हयारोहौ सुसंवृतौ ।\nजग्मतुः शीघ्रगमनौ सन्नद्धकवचध्वजौ\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2213277, "chapter_id": 5553, "verse_number": "११", "content_sanskrit": "अर्जुनश्च महातेजा रथेनादित्यवर्चसा ।\nवशी श्वेतैर्हयैर्दिव्यैर्युक्तेनान्वगमन्नृपम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2213278, "chapter_id": 5553, "verse_number": "१२", "content_sanskrit": "द्रौपदीप्रमुखाश्चापि स्त्रीसङ्घाः शिबिकागताः ।\nस्त्र्यध्यक्षगुप्ताः प्रययुर्विसृजन्तोऽमितं वसु\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2213279, "chapter_id": 5553, "verse_number": "१३", "content_sanskrit": "समृद्धरथनागाश्वं वेणुवीणानुनादितम् ।\nशुशुभे पाण्डवं सैन्यं तत् तदा भरतर्षभ\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2213280, "chapter_id": 5553, "verse_number": "१४", "content_sanskrit": "नदीतीरेषु रम्येषु सरस्सु च विशाम्पते ।\nवासं कृत्वा क्रमेणाथ जग्मुस्ते कुरुपुङ्गवाः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2213281, "chapter_id": 5553, "verse_number": "१५", "content_sanskrit": "युयुत्सुश्च महातेजा धौम्यश्चैव पुरोहितः ।\nयुधिष्ठिरस्य वचनात् पुरगुप्तिं प्रचक्रतुः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2213282, "chapter_id": 5553, "verse_number": "१६", "content_sanskrit": "ततो युधिष्ठिरो राजा कुरुक्षेत्रमवातरत् ।\nक्रमेणोत्तीर्य यमुनां नदीं परमपावनीम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2213283, "chapter_id": 5553, "verse_number": "१७", "content_sanskrit": "स ददर्शाश्रमं दूराद् राजर्षेस्तस्य धीमतः ।\nशतयूपश्च कौरव्य धृतराष्ट्रस्य चैव हि\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2213284, "chapter_id": 5553, "verse_number": "१८", "content_sanskrit": "ततः प्रमुदितः सर्वो जनस्तद्वनमञ्जसा ।\nविवेश सुमहानादैरापूर्य भरतर्षभ\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2213285, "chapter_id": 5553, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्रमवासिकपर्वणि पाण्डवैः तपोवनप्रवेशो नाम एकोनत्रिंशोऽध्यायः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2213286, "chapter_id": 5553, "verse_number": "", "content_sanskrit": "आश्रमवासपर्वणि एकोनत्रिंशोऽध्यायः ॥२९॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]