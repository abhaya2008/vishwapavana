[{"id": 6000158000, "chapter_id": 10158, "verse_number": null, "content_sanskrit": "अथ पञ्चमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000158001, "chapter_id": 10158, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_005/BhP_08.005.001.m4a", "display_order": 2}, {"id": 6000158002, "chapter_id": 10158, "verse_number": "८-५-१", "content_sanskrit": "राजन्नुदितमेतत् ते हरेः कर्माघनाशनम्।\nगजेन्द्रमोक्षणं पुण्यं रैवतं त्वन्तरं शृृणु॥ ८/५/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_005/BhP_08.005.002.m4a", "display_order": 3, "topics": [{"text": "पञ्चमषष्ठमन्वन्तरनिरूपणम्", "range": "१–८"}]}, {"id": 6000158003, "chapter_id": 10158, "verse_number": "८-५-२", "content_sanskrit": "पञ्चमो रैवतो नाम मनुस्तापससोदरः।\nबलविन्ध्यादयस्तस्य सुता अर्जुनपूर्वकाः॥ ८/५/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_005/BhP_08.005.003.m4a", "display_order": 4}, {"id": 6000158004, "chapter_id": 10158, "verse_number": "८-५-३", "content_sanskrit": "विभुरिन्द्रः सुरगणा राजन् भूतरयादयः।\nहिरण्यरोमा वेदशिरा ऊर्ध्वबाह्वादयो द्विजाः॥ ८/५/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_005/BhP_08.005.004.m4a", "display_order": 5}, {"id": 6000158005, "chapter_id": 10158, "verse_number": "८-५-४", "content_sanskrit": "पत्नी विकुण्ठा शुभ्रस्य वैकुण्ठैः सुरसत्तमैः।\nतयोः स्वकलया जज्ञे वैकुण्ठो भगवान् स्वयम्॥ ८/५/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_005/BhP_08.005.005.m4a", "display_order": 6}, {"id": 6000158006, "chapter_id": 10158, "verse_number": "८-५-५", "content_sanskrit": "वैकुण्ठः कल्पितो येन लोको लोकनमस्कृतः।\nरमया प्रार्थ्यमानेन देव्या तत्प्रियकाम्यया॥ ८/५/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_005/BhP_08.005.006.m4a", "display_order": 7}, {"id": 6000158007, "chapter_id": 10158, "verse_number": "८-५-६", "content_sanskrit": "तस्यानुभावः कथितो गुणाश्च परमोदयाः।\nभौमान् रेणून् स विममे यो विष्णोर्वर्णयेद् गुणान्॥ ८/५/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_005/BhP_08.005.007.m4a", "display_order": 8}, {"id": 6000158008, "chapter_id": 10158, "verse_number": "८-५-७", "content_sanskrit": "षष्ठश्च चक्षुषः पुत्रश्चाक्षुषो नाम वै मनुः।\nपुरुः पुरुषसुद्युम्नप्रमुखाश्चाक्षुषात्मजाः॥ ८/५/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_005/BhP_08.005.008.m4a", "display_order": 9}, {"id": 6000158009, "chapter_id": 10158, "verse_number": "८-५-८", "content_sanskrit": "इन्द्रो मन्द्रद्युमस्तत्र देवा आप्यादयो गणाः।\nमुनयस्तत्र वैराजहरिमद्वीरकादयः॥ ८/५/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_005/BhP_08.005.009.m4a", "display_order": 10}, {"id": 6000158010, "chapter_id": 10158, "verse_number": "८-५-९", "content_sanskrit": "तत्रापि देवः सम्भूत्यां वैराजस्याभवत् सुतः।\nअजितो नाम भगवानंशेन जगतः पतिः॥ ८/५/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_005/BhP_08.005.010.m4a", "display_order": 11, "topics": [{"text": "अमृतमथनकथारम्भः", "range": "९–१४"}]}, {"id": 6000158011, "chapter_id": 10158, "verse_number": "८-५-१०", "content_sanskrit": "पयोब्धिं येन निर्मथ्य सुराणां साधिता सुधा।\nभ्रममाणोऽम्भसि धृतः कूर्मरूपेण मन्दरः॥ ८/५/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_005/BhP_08.005.011.m4a", "display_order": 12}, {"id": 6000158012, "chapter_id": 10158, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_005/BhP_08.005.012.m4a", "display_order": 13}, {"id": 6000158013, "chapter_id": 10158, "verse_number": "८-५-११", "content_sanskrit": "यथा भगवता ब्रह्मन् मथितः क्षीरसागरः।\nयदर्थं वा यतश्चाद्रिं दधाराम्बुचरात्मना॥ ८/५/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_005/BhP_08.005.013.m4a", "display_order": 14}, {"id": 6000158014, "chapter_id": 10158, "verse_number": "८-५-१२", "content_sanskrit": "यथाऽमृतं सुरैः प्राप्तं किमन्यदभवत् ततः।\nएतद् भगवतः कर्म वदस्व परमाद्भुतम्॥ ८/५/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_005/BhP_08.005.014.m4a", "display_order": 15}, {"id": 6000158015, "chapter_id": 10158, "verse_number": "८-५-१३", "content_sanskrit": "त्वयेत्थं कथ्यमानेन महिम्ना सात्वतां पतेः।\nनातितृप्यति मे चित्तं सुचिरं तापतापितम्॥ ८/५/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_005/BhP_08.005.015.m4a", "display_order": 16}, {"id": 6000158016, "chapter_id": 10158, "verse_number": null, "content_sanskrit": "सूत उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_005/BhP_08.005.016.m4a", "display_order": 17}, {"id": 6000158017, "chapter_id": 10158, "verse_number": "८-५-१४", "content_sanskrit": "सम्पृष्टो भगवानेवं द्वैपायनसुतो द्विजाः।\nअभिनन्द्य हरेर्वीर्यमभ्याचष्टुं प्रचक्रमे॥ ८/५/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_005/BhP_08.005.017.m4a", "display_order": 18}, {"id": 6000158018, "chapter_id": 10158, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_005/BhP_08.005.018.m4a", "display_order": 19}, {"id": 6000158019, "chapter_id": 10158, "verse_number": "८-५-१५", "content_sanskrit": "यदा युद्धेऽसुरैर्देवा बाध्यमानाः शितायुधैः।\nगतासवो निपतिता नोत्तिष्ठेरन् स्म भूयशः॥ ८/५/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_005/BhP_08.005.019.m4a", "display_order": 20, "topics": [{"text": "दुर्वाससः शापाद्दितिजपराजितैर्देवैः स्वपराजयं विरिञ्चये विज्ञाप्य तेन सह क्षीराब्धिगमनम्", "range": "१५–२५"}]}, {"id": 6000158020, "chapter_id": 10158, "verse_number": "८-५-१६", "content_sanskrit": "यदा दुर्वासशापेन सेन्द्रा लोकास्‍त्रयो नृप।\nनिःश्रीकाश्चाभवंस्तत्र नेशुरिज्यादिकाः क्रियाः॥ ८/५/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_005/BhP_08.005.020.m4a", "display_order": 21}, {"id": 6000158021, "chapter_id": 10158, "verse_number": "८-५-१७", "content_sanskrit": "निशाम्यैतत् सुरगणा महेन्द्रवरुणादयः।\nनाध्यगच्छन् स्वयं मन्त्रैर्मन्त्रयन्तो विनिश्चयम्॥ ८/५/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_005/BhP_08.005.021.m4a", "display_order": 22}, {"id": 6000158022, "chapter_id": 10158, "verse_number": "८-५-१८", "content_sanskrit": "ततो ब्रह्मसभां जग्मुर्मेरोर्मूर्धनि सर्वशः।\nसर्वं विज्ञापयाञ्चक्रुः प्रणताः परमेष्ठिने॥ ८/५/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_005/BhP_08.005.022.m4a", "display_order": 23}, {"id": 6000158023, "chapter_id": 10158, "verse_number": "८-५-१९", "content_sanskrit": "स विलोक्येन्द्रवाय्वादीन् निःसत्त्वान् विगतप्रभान्।\nलोकानमङ्गलप्रायान् सुरांश्चैव यथा विभुः॥ ८/५/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_005/BhP_08.005.023.m4a", "display_order": 24}, {"id": 6000158024, "chapter_id": 10158, "verse_number": "८-५-२०", "content_sanskrit": "समाहितेन मनसा संस्मरन् पुरुषं परम्।\nउवाचोत्फुल्लवदनो देवान् स भगवान् परः॥ ८/५/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_005/BhP_08.005.024.m4a", "display_order": 25}, {"id": 6000158025, "chapter_id": 10158, "verse_number": "८-५-२१", "content_sanskrit": "अहं भवो यूयमथो सुरादयो मनुष्यतिर्यग्द्रुमघर्मजादयः।\nयस्यावतारांशकलाविसर्जिता व्रजाम सर्वे शरणं तमव्ययम्॥ ८/५/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_005/BhP_08.005.025.m4a", "display_order": 26}, {"id": 6000158026, "chapter_id": 10158, "verse_number": "८-५-२२", "content_sanskrit": "न यस्य वध्यो न च रक्षणीयो नोपेक्षणीयादरणीयपक्षः।\nअथापि सर्गस्थितिसंयमार्थं धत्ते रजःसत्त्वतमांसि काले॥ ८/५/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_005/BhP_08.005.026.m4a", "display_order": 27}, {"id": 6000158027, "chapter_id": 10158, "verse_number": "८-५-२३", "content_sanskrit": "अयं तु तस्य स्थितिपालनक्षणः सत्त्वं जुषाणस्य भवाय देहिनाम्।\nतस्माद् व्रजामः शरणं जगद्गुरुं स्वानां स नो धास्यति शं सुरप्रियः॥ ८/५/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_005/BhP_08.005.027.m4a", "display_order": 28}, {"id": 6000158028, "chapter_id": 10158, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_005/BhP_08.005.028.m4a", "display_order": 29}, {"id": 6000158029, "chapter_id": 10158, "verse_number": "८-५-२४", "content_sanskrit": "इत्याभाष्य सुरान् वेधाः सह देवैररिन्दम।\nअजितस्य पदं साक्षाज्जगाम तमसः परम्॥ ८/५/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_005/BhP_08.005.029.m4a", "display_order": 30}, {"id": 6000158030, "chapter_id": 10158, "verse_number": "८-५-२५", "content_sanskrit": "तत्रादृष्टस्वरूपाय श्रुतपूर्वाय चाभ्यधात्।\nस्तुतिमद्भुतदैवीभिर्गीर्भिस्त्ववहितेन्द्रियः॥ ८/५/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_005/BhP_08.005.030.m4a", "display_order": 31}, {"id": 6000158031, "chapter_id": 10158, "verse_number": null, "content_sanskrit": "ब्रह्मोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_005/BhP_08.005.031.m4a", "display_order": 32}, {"id": 6000158032, "chapter_id": 10158, "verse_number": "८-५-२६", "content_sanskrit": "अविक्रियं सत्यमनन्तमाद्यं गुहाशयं निष्कलमप्रतर्क्यम्।\nमनोग्रयाणं वचसाऽनिरुक्तं नमामहे देववरं वरेण्यम्॥ ८/५/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_005/BhP_08.005.032.m4a", "display_order": 33, "topics": [{"text": "ब्रह्मणा भगवद्दर्शनाय तत्स्तुतिः", "range": "२६–५०"}]}, {"id": 6000158033, "chapter_id": 10158, "verse_number": "८-५-२७", "content_sanskrit": "विपश्चितं प्राणमनोधियात्मनाम् अर्थेन्द्रियाभासमनिद्रमव्रणम्।\nछायातपौ यत्र न गृध्रपक्षौ तमक्षरं खं त्रियुगं व्रजामहे॥ ८/५/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_005/BhP_08.005.033.m4a", "display_order": 34}, {"id": 6000158034, "chapter_id": 10158, "verse_number": "८-५-२८", "content_sanskrit": "अजस्य चक्रं त्वजयेर्यमाणं मनोमयं पञ्चदशारमाशु।\nत्रिनाभि विद्युद्बलमष्टनेमि यदक्षमाहुस्तमृतं प्रपद्ये॥ ८/५/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_005/BhP_08.005.034.m4a", "display_order": 35}, {"id": 6000158035, "chapter_id": 10158, "verse_number": "८-५-२९", "content_sanskrit": "यदेकवर्णं तमसः परं सदलोकमव्यक्तमनन्तपारम्।\nआसाञ्चकारोपसुपर्णपत्रमुपासते योगरथेन धीराः॥ ८/५/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_005/BhP_08.005.035.m4a", "display_order": 36}, {"id": 6000158036, "chapter_id": 10158, "verse_number": "८-५-३०", "content_sanskrit": "न यस्य कश्चातिपिपर्ति मायां यया जनो मुह्यति वेदनार्थम्।\nतं निर्जितात्मात्मगुणं परेशं नमामि भूतेषु समं चरन्तम्॥ ८/५/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_005/BhP_08.005.036.m4a", "display_order": 37}, {"id": 6000158037, "chapter_id": 10158, "verse_number": "८-५-३१", "content_sanskrit": "इमे वयं यत्कृपयैव ते तु सत्त्वेन सृष्टा बहिरन्तरं विभो।\nगतिं न सूक्ष्मामृषयश्च विद्महे कुतोऽसुराद्या इतरप्रधानाः॥ ८/५/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_005/BhP_08.005.037.m4a", "display_order": 38}, {"id": 6000158038, "chapter_id": 10158, "verse_number": "८-५-३२", "content_sanskrit": "पादौ महीयं स्वकृतैव यस्य चतुर्विधो यत्र हि भूतसर्गः।\nस वै महापूरुष आत्मतन्त्रः प्रसीदतां ब्रह्म महाविभूतिः॥ ८/५/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_005/BhP_08.005.038.m4a", "display_order": 39}, {"id": 6000158039, "chapter_id": 10158, "verse_number": "८-५-३३", "content_sanskrit": "अम्भस्तु यद्रेत उदारवीर्यं सिध्यन्ति जीवन्त्युत वर्धमानाः।\nलोकास्‍त्रयोऽथाखिललोकपालाः प्रसीदतां ब्रह्म महाविभूतिः॥ ८/५/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_005/BhP_08.005.039.m4a", "display_order": 40}, {"id": 6000158040, "chapter_id": 10158, "verse_number": "८-५-३४", "content_sanskrit": "सोमं मनो यस्य समामनन्ति दिवौकसां वै बलमन्ध आयुः।\nईशो नगानां प्रजनः प्रजानां प्रसीदतां नः स महाविभूतिः॥ ८/५/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_005/BhP_08.005.040.m4a", "display_order": 41}, {"id": 6000158041, "chapter_id": 10158, "verse_number": "८-५-३५", "content_sanskrit": "अग्निर्मुखं यस्य तु जातवेदा जातः क्रियाकाण्डनिमित्तजन्मा।\nअन्तः समुद्रे पचतः स्वधातून् प्रसीदतां नः स महाविभूतिः॥ ८/५/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_005/BhP_08.005.041.m4a", "display_order": 42}, {"id": 6000158042, "chapter_id": 10158, "verse_number": "८-५-३६", "content_sanskrit": "यच्चक्षुरासीत् तरणिर्देवयानं त्रयीमयो ब्रह्मण एष धिष्ण्यम्।\nद्वारं च मुक्तेरमृतस्य मृत्योः प्रसीदतां नः स महाविभूतिः॥ ८/५/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_005/BhP_08.005.042.m4a", "display_order": 43}, {"id": 6000158043, "chapter_id": 10158, "verse_number": "८-५-३७", "content_sanskrit": "प्राणादभूद् यस्य चराचराणां प्राणः सहो वै बलमोजश्च वायुः।\nअन्वास्म सम्राजमिवानुगा वयं प्रसीदतां नः स महाविभूतिः॥ ८/५/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_005/BhP_08.005.043.m4a", "display_order": 44}, {"id": 6000158044, "chapter_id": 10158, "verse_number": "८-५-३८", "content_sanskrit": "श्रोत्राद् दिशो यस्य हृदश्च खानि प्रजज्ञिरे खं पुरुषस्य नाभ्याः।\nप्राणेन्द्रियात्मा स्वशरीरबन्धुः प्रसीदतां नः स महाविभूतिः॥ ८/५/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_005/BhP_08.005.044.m4a", "display_order": 45}, {"id": 6000158045, "chapter_id": 10158, "verse_number": "८-५-३९", "content_sanskrit": "बलान्महेन्द्रस्‍त्रिदशाः प्रसादान्मन्योर्गिरीशोऽशरणाद्विरिञ्चः।\nखेभ्यश्च छन्दांस्यृषयस्तु मेढ्रतः प्रसीदतां नः स महाविभूतिः॥ ८/५/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_005/BhP_08.005.045.m4a", "display_order": 46}, {"id": 6000158046, "chapter_id": 10158, "verse_number": "८-५-४०", "content_sanskrit": "श्रीर्वक्षसः पितरश्छाययाऽसन् धर्मः स्तनादितरः पृष्ठतोऽभूत्।\nद्यौर्यस्य शीर्ष्णोऽप्सरसो विहारात् प्रसीदतां नः स महाविभूतिः॥ ८/५/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_005/BhP_08.005.046.m4a", "display_order": 47}, {"id": 6000158047, "chapter_id": 10158, "verse_number": "८-५-४१", "content_sanskrit": "विप्रो मुखाद् ब्रह्म च यस्य गुह्यं राजन्य आसीद् भुजयोर्बलं च।\nऊर्वोर्विडोजोऽङ्घ्रिरवेदशूद्रौ प्रसीदतां नः स महाविभूतिः॥ ८/५/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_005/BhP_08.005.047.m4a", "display_order": 48}, {"id": 6000158048, "chapter_id": 10158, "verse_number": "८-५-४२", "content_sanskrit": "लोभोऽधरात् प्रीतिरुपर्यभूद् द्युतिर्नस्तः पशव्यं स्पर्शेन कामः।\nभ्रुवोर्यमः पक्ष्मभवस्तु कालः प्रसीदतां नः स महाविभूतिः॥ ८/५/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_005/BhP_08.005.048.m4a", "display_order": 49}, {"id": 6000158049, "chapter_id": 10158, "verse_number": "८-५-४३", "content_sanskrit": "द्रव्यं वयः कर्म गुणाश्च शेषं यद्योगमायाविहताः पतन्ति।\nयद् दुर्विभाव्यं प्रबुधावबोधं प्रसीदतां नः स महाविभूतिः॥ ८/५/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_005/BhP_08.005.049.m4a", "display_order": 50}, {"id": 6000158050, "chapter_id": 10158, "verse_number": "८-५-४४", "content_sanskrit": "नमोऽस्तु तस्मा उपशान्तशक्तये स्वाराज्यलाभपरिपूरितात्मने।\nगुणेषु मायारचितेषु वृत्तिभिर्न सज्जमानाय नमः स्वभूतये॥ ८/५/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_005/BhP_08.005.050.m4a", "display_order": 51}, {"id": 6000158051, "chapter_id": 10158, "verse_number": "८-५-४५", "content_sanskrit": "स त्वं नो दर्शयात्मानमस्मत्करणगोचरः।\nप्रपन्नानां दिदृक्षूणां सस्मितं ते मुखाम्बुजम्॥ ८/५/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_005/BhP_08.005.051.m4a", "display_order": 52}, {"id": 6000158052, "chapter_id": 10158, "verse_number": "८-५-४६", "content_sanskrit": "तैस्तैः स्वेच्छाकृतै रूपैः काले काले स्वयं विभो।\nकर्म दुर्विषहं यन्नो भगवान् वै करोति हि॥ ८/५/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_005/BhP_08.005.052.m4a", "display_order": 53}, {"id": 6000158053, "chapter_id": 10158, "verse_number": "८-५-४७", "content_sanskrit": "क्लेशभूर्यल्पसाराणि कर्माणि विफलानि च।\nदेहिनां विषयार्तानां न तथैवार्पितं त्वयि॥ ८/५/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_005/BhP_08.005.053.m4a", "display_order": 54}, {"id": 6000158054, "chapter_id": 10158, "verse_number": "८-५-४८", "content_sanskrit": "नाधमः कर्मकल्पोऽपि विफलायेश्वरार्पितः।\nकल्पते पुरुषस्यैव स ह्यात्मा दयितो हितः॥ ८/५/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_005/BhP_08.005.054.m4a", "display_order": 55}, {"id": 6000158055, "chapter_id": 10158, "verse_number": "८-५-४९", "content_sanskrit": "यथा हि स्कन्धशाखानां तरोर्मूलावसेचनम्।\nएवमाराधनं विष्णोः सर्वेषामात्मनश्च हि॥ ८/५/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_005/BhP_08.005.055.m4a", "display_order": 56}, {"id": 6000158056, "chapter_id": 10158, "verse_number": "८-५-५०", "content_sanskrit": "नमस्तुभ्यमनन्ताय दुर्वितर्क्यात्मकर्मणे।\nनिर्गुणाय गुणेशाय सत्त्वस्थाय च साम्प्रतम्॥ ८/५/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_005/BhP_08.005.056.m4a", "display_order": 57}, {"id": 6000158057, "chapter_id": 10158, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायाम् अष्टमस्कन्धे पञ्चमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}]