[{"id": 6000329000, "chapter_id": 10329, "verse_number": null, "content_sanskrit": "अथ अष्टाविंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000329001, "chapter_id": 10329, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_028/BhP_11.028.001.m4a", "display_order": 2}, {"id": 6000329002, "chapter_id": 10329, "verse_number": "११-२८-१", "content_sanskrit": "परस्वभावकर्माणि न प्रशंसेन्न गर्हयेत्।\nविश्वमेकात्मकं पश्यन् प्रकृत्या पुरुषेण च॥ ११/२८/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_028/BhP_11.028.002.m4a", "display_order": 3, "topics": [{"text": "पूर्वोक्तस्य ज्ञानयोगस्यात्र संक्षेपतः पुनर्निरूपणम्", "range": "१–४५"}]}, {"id": 6000329003, "chapter_id": 10329, "verse_number": "११-२८-२", "content_sanskrit": "परस्वभावकर्माणि यः प्रशंसति निन्दति।\nस आशु भ्रंशते स्थानादसत्याभिनिवेशतः॥ ११/२८/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_028/BhP_11.028.003.m4a", "display_order": 4}, {"id": 6000329004, "chapter_id": 10329, "verse_number": "११-२८-३", "content_sanskrit": "तैजसे निद्रयाऽऽपन्ने पिण्डस्थो नष्टचेतनः।\nमायां प्राप्नोति मृत्युं वा तद्धि नानार्थदं मनः॥ ११/२८/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_028/BhP_11.028.004.m4a", "display_order": 5}, {"id": 6000329005, "chapter_id": 10329, "verse_number": "११-२८-४", "content_sanskrit": "किं भद्रं किमभद्रं वा द्वैतस्यावस्तुनः कियत्।\nवाचोदितं तदनृतं मनसा ध्यातमेव च॥ ११/२८/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_028/BhP_11.028.005.m4a", "display_order": 6}, {"id": 6000329006, "chapter_id": 10329, "verse_number": "११-२८-५", "content_sanskrit": "छायाप्रत्युदकाभासा ह्यसन्तोऽप्यर्थकारिणः।\nएवं देहादयो भावा यच्छन्त्यामृत्युतो भयम्॥ ११/२८/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_028/BhP_11.028.006.m4a", "display_order": 7}, {"id": 6000329007, "chapter_id": 10329, "verse_number": "११-२८-६", "content_sanskrit": "आत्मैव तदिदं विश्वं सृज्यते सृजति प्रभुः।\nत्रायते त्राति विश्वात्मा ह्रियते हरतीश्वरः॥ ११/२८/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_028/BhP_11.028.007.m4a", "display_order": 8}, {"id": 6000329008, "chapter_id": 10329, "verse_number": "११-२८-७", "content_sanskrit": "तस्मान्न ह्यात्मनोऽमुष्मादन्यो भावो निरूपितः।\nअनिरूपितेयं त्रिविधा निर्मूला मतिरात्मनि॥ ११/२८/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_028/BhP_11.028.008.m4a", "display_order": 9}, {"id": 6000329009, "chapter_id": 10329, "verse_number": "११-२८-८", "content_sanskrit": "इदं गुणमयं विद्धि त्रिविधं मायया कृतम्॥ ११/२८/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_028/BhP_11.028.009.m4a", "display_order": 10}, {"id": 6000329010, "chapter_id": 10329, "verse_number": "११-२८-९", "content_sanskrit": "एतद् विद्वान् मदुदितं ज्ञानविज्ञाननैपुणः।\nन निन्दति न च स्तौति लोके चरति सूर्यवत्॥ ११/२८/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_028/BhP_11.028.010.m4a", "display_order": 11}, {"id": 6000329011, "chapter_id": 10329, "verse_number": "११-२८-१०", "content_sanskrit": "प्रत्यक्षेणानुमानेन निगमेनात्मसंविदा।\nआद्यन्तवदसज्ज्ञात्वा निःसङ्गो विचरेदिह॥ ११/२८/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_028/BhP_11.028.011.m4a", "display_order": 12}, {"id": 6000329012, "chapter_id": 10329, "verse_number": null, "content_sanskrit": "उद्धव उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_028/BhP_11.028.012.m4a", "display_order": 13}, {"id": 6000329013, "chapter_id": 10329, "verse_number": "११-२८-११", "content_sanskrit": "नैवात्मनो न देहस्य संसृतिर्द्रष्टृदृश्ययोः।\nअनात्मस्वदृशोरीश कस्येयमुपलभ्यते॥ ११/२८/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_028/BhP_11.028.013.m4a", "display_order": 14}, {"id": 6000329014, "chapter_id": 10329, "verse_number": "११-२८-१२", "content_sanskrit": "आत्माऽव्ययोऽगुणः शुद्धः स्वयंज्योतिरनावृतः।\nअग्निवद् दारुवदपि देहः कस्येति संसृतिः॥ ११/२८/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_028/BhP_11.028.014.m4a", "display_order": 15}, {"id": 6000329015, "chapter_id": 10329, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_028/BhP_11.028.015.m4a", "display_order": 16}, {"id": 6000329016, "chapter_id": 10329, "verse_number": "११-२८-१३", "content_sanskrit": "यावद् देहेन्द्रियप्राणैरात्मनः सन्निकर्षणम्।\nसंसारः फलवांस्तावदपार्थोऽप्यविवेकिनः॥ ११/२८/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_028/BhP_11.028.016.m4a", "display_order": 17}, {"id": 6000329017, "chapter_id": 10329, "verse_number": "११-२८-१४", "content_sanskrit": "अर्थेऽप्यविद्यमानेऽपि संसृतिर्न निवर्तते।\nध्यायतो विषयानस्य स्वप्नेऽनर्थागमो यथा॥ ११/२८/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_028/BhP_11.028.017.m4a", "display_order": 18}, {"id": 6000329018, "chapter_id": 10329, "verse_number": "११-२८-१५", "content_sanskrit": "यथा ह्यप्रतिबुद्धस्य प्रस्वापो बह्वनर्थकृत्।\nस एव प्रतिबुद्धस्य न वै मोहाय कल्पते॥ ११/२८/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_028/BhP_11.028.018.m4a", "display_order": 19}, {"id": 6000329019, "chapter_id": 10329, "verse_number": "११-२८-१६", "content_sanskrit": "शोकहर्षभयक्रोधलोभमोहस्पृहादयः।\nअहङ्कारस्य दृश्यन्ते जन्म मृत्युश्च नात्मनः॥ ११/२८/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_028/BhP_11.028.019.m4a", "display_order": 20}, {"id": 6000329020, "chapter_id": 10329, "verse_number": "११-२८-१७", "content_sanskrit": "देहेन्द्रियप्राणमनोऽभिमानो जीवोऽन्तरात्मा गुणकर्ममूर्तिः।\nसूत्रं महानित्युरुधेह गीतः संसार आधावति कालतन्त्रः॥ ११/२८/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_028/BhP_11.028.020.m4a", "display_order": 21}, {"id": 6000329021, "chapter_id": 10329, "verse_number": "११-२८-१८", "content_sanskrit": "अमूलमेतद् बहुरूपरूपं मनोवचःप्राणशरीरकर्म।\nज्ञानासिनोपासनया शितेन च्छित्त्वा मुनिर्गां विचरत्यतृष्णः॥ ११/२८/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_028/BhP_11.028.021.m4a", "display_order": 22}, {"id": 6000329022, "chapter_id": 10329, "verse_number": "११-२८-१९", "content_sanskrit": "ज्ञानं विवेको निगमस्तपश्च प्रत्यक्षमैतिह्यमथानुमानम्।\nआद्यन्तयोरस्य यदेव केवलं कालश्च हेतुश्च तदेव मध्ये॥ ११/२८/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_028/BhP_11.028.022.m4a", "display_order": 23}, {"id": 6000329023, "chapter_id": 10329, "verse_number": "११-२८-२०", "content_sanskrit": "यथा हिरण्यं स्वकृतं पुरस्तात् पश्चाच्च सर्वस्य हिरण्मयस्य।\nतदेव मध्ये व्यवहार्यमाणं नानापदेशैरहमस्य तद्वत्॥ ११/२८/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_028/BhP_11.028.023.m4a", "display_order": 24}, {"id": 6000329024, "chapter_id": 10329, "verse_number": "११-२८-२१", "content_sanskrit": "विज्ञानमेतत् त्रिपदस्थमङ्ग गुणत्रयं कारणकार्यकर्तृ।\nसमन्वयेन व्यतिरेकतश्च येनैव तुर्येण तदेव सत्यम्॥ ११/२८/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_028/BhP_11.028.024.m4a", "display_order": 25}, {"id": 6000329025, "chapter_id": 10329, "verse_number": "११-२८-२२", "content_sanskrit": "न यत् पुरस्तादुत यन्न पश्चान्मध्ये च तन्न व्यपदेशमात्रम्।\nभूतं प्रसिद्धं च परेण यद्यत् तदेव सत् स्यादिति मे मनीषा॥ ११/२८/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_028/BhP_11.028.025.m4a", "display_order": 26}, {"id": 6000329026, "chapter_id": 10329, "verse_number": "११-२८-२३", "content_sanskrit": "अविद्यमानोऽप्यवभासते यो वैकारिको राजससर्ग एषः।\nब्रह्म स्वयंज्योतिरतो विभाति ब्रह्मेन्द्रियार्थात्मविकारचित्रम्॥ ११/२८/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_028/BhP_11.028.026.m4a", "display_order": 27}, {"id": 6000329027, "chapter_id": 10329, "verse_number": "११-२८-२४", "content_sanskrit": "एवं स्फुटं ब्रह्म विविच्य हेतुभिः परापवादेन विवेकबुद्ध्या।\nछित्वाऽऽत्मसन्देहमुपारमेत स्वानन्दतुष्टोऽखिलकामुकेभ्यः॥ ११/२८/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_028/BhP_11.028.027.m4a", "display_order": 28}, {"id": 6000329028, "chapter_id": 10329, "verse_number": "११-२८-२५", "content_sanskrit": "नात्मा वपुः पार्थिवमिन्द्रियाणि देवा ह्यसुर्वायुजलं हुताशः।\nमनोऽन्नमात्रं धिषणा च सत्त्वमहङ्कृतिः खं कृतिरर्थसाम्यम्॥ ११/२८/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_028/BhP_11.028.028.m4a", "display_order": 29}, {"id": 6000329029, "chapter_id": 10329, "verse_number": "११-२८-२६", "content_sanskrit": "समाहितैः कः करणैर्गुणात्मभिर्गुणो भवेत् तत्सुविविक्तधाम्नः।\nविक्षिप्यमाणैरुत किं नु दूषणं घनैरुपेतैर्विगतै रवेः किम्॥ ११/२८/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_028/BhP_11.028.029.m4a", "display_order": 30}, {"id": 6000329030, "chapter_id": 10329, "verse_number": "११-२८-२७", "content_sanskrit": "यथा नभो वाय्वनलाम्बुभूगुणैर्गतागतैर्वा त्रिगुणैर्न सज्जते।\nतथाऽक्षरं सत्त्वरजस्तमोमलैरसङ्गतं संसृतिहेतुभिः परम्॥ ११/२८/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_028/BhP_11.028.030.m4a", "display_order": 31}, {"id": 6000329031, "chapter_id": 10329, "verse_number": "११-२८-२८", "content_sanskrit": "तथापि सङ्गः परिवर्जनीयो गुणेषु मायारचितेषु तावत्।\nमद्भक्तियोगेन दृढेन यावद्रजो निरस्येत तमःकषायम्॥ ११/२८/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_028/BhP_11.028.031.m4a", "display_order": 32}, {"id": 6000329032, "chapter_id": 10329, "verse_number": "११-२८-२९", "content_sanskrit": "यथाऽमयोऽसाधुचिकित्सितो नृणां पुनः पुनः सन्तुदति प्ररोहन्।\nएवं मनोऽपक्‍वकषायकर्म कुयोगिनं विद्ध्यति सर्वसङ्गम्॥ ११/२८/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_028/BhP_11.028.032.m4a", "display_order": 33}, {"id": 6000329033, "chapter_id": 10329, "verse_number": "११-२८-३०", "content_sanskrit": "कुयोगिनो ये विहता ह्यन्तरायैर्मनुष्यभूतैस्त्रिदशोपसृष्टैः।\nते प्राक्तनाभ्यासबलेन भूयो युञ्जन्ति योगं न तु कर्मतन्त्रम्॥ ११/२८/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_028/BhP_11.028.033.m4a", "display_order": 34}, {"id": 6000329034, "chapter_id": 10329, "verse_number": "११-२८-३१", "content_sanskrit": "करोति कर्म क्रियते च जन्तुः केनाप्यसौ चोदित आनिपातात्।\nन तत्र विद्वान् प्रकृतौ स्थितोऽपि निवृत्ततृष्णः स्वसुखानुभूत्या॥ ११/२८/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_028/BhP_11.028.034.m4a", "display_order": 35}, {"id": 6000329035, "chapter_id": 10329, "verse_number": "११-२८-३२", "content_sanskrit": "तिष्ठन्तमासीनमुत व्रजन्तं शयानमुद्यन्तमदन्तमन्नम्।\nस्वभावमन्यत् किमपीहमानमात्मानमात्मस्थमतिर्न वेद॥ ११/२८/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_028/BhP_11.028.035.m4a", "display_order": 36}, {"id": 6000329036, "chapter_id": 10329, "verse_number": "११-२८-३३", "content_sanskrit": "यदि स्म पश्यत्यसदिन्द्रियार्थं नानानुमानेन विरुद्धमन्यत्।\nन मन्यते वस्तुतया मनीषी स्वप्नं यथोत्थाय तिरोदधानम्॥ ११/२८/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_028/BhP_11.028.036.m4a", "display_order": 37}, {"id": 6000329037, "chapter_id": 10329, "verse_number": "११-२८-३४", "content_sanskrit": "पूर्वं गृहीतं गुणकर्मचित्रमज्ञानमात्मन्यविविक्तमङ्ग।\nनिवर्तते तत् पुनरीक्षयैव न गृह्यते नापि विसृज्य आत्मा॥ ११/२८/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_028/BhP_11.028.037.m4a", "display_order": 38}, {"id": 6000329038, "chapter_id": 10329, "verse_number": "११-२८-३५", "content_sanskrit": "यथा हि भानोरुदयो नृचक्षुषां तमो निहन्यान्न तु संविधत्ते।\nएवं समीक्षा निपुणा सती मे हन्यात् तमिस्रं पुरुषस्य बुद्धेः॥ ११/२८/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_028/BhP_11.028.038.m4a", "display_order": 39}, {"id": 6000329039, "chapter_id": 10329, "verse_number": "११-२८-३६", "content_sanskrit": "एष स्वयंज्योतिरजोऽप्रमेयो महानुभूतिः सकलानुभूतिः।\nएकोऽद्वितीयो वचसां विरामो येनेरिता वाग्रचनाश्चरन्ति॥ ११/२८/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_028/BhP_11.028.039.m4a", "display_order": 40}, {"id": 6000329040, "chapter_id": 10329, "verse_number": "११-२८-३७", "content_sanskrit": "एतावानात्मसंमोहो यद् विकल्पस्तु केवले।\nआत्माऽमृते स्वमात्मानमचलं यन्न पश्यति॥ ११/२८/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_028/BhP_11.028.040.m4a", "display_order": 41}, {"id": 6000329041, "chapter_id": 10329, "verse_number": "११-२८-३८", "content_sanskrit": "यन्नामाकृतिभिर्ग्राह्यं पञ्चवर्णमबाधितम् ।\nव्यर्थो नाप्यर्थवादोऽयं द्वयं विन्दन्ति सूरयः॥ ११/२८/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_028/BhP_11.028.041.m4a", "display_order": 42}, {"id": 6000329042, "chapter_id": 10329, "verse_number": null, "content_sanskrit": "योगिनोऽपक्‍वयोगस्य युञ्जतः काल उत्थितैः।\nउपसर्गैर्विहन्येत तत्रायं विहितो विधिः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_028/BhP_11.028.042.m4a", "display_order": 43}, {"id": 6000329043, "chapter_id": 10329, "verse_number": "११-२८-४०", "content_sanskrit": "योगधारणया कांश्चिदासनैर्धारणान्वितैः।\nतपोमन्त्रौषधैः कांश्चिदुपसर्गान् विनिर्दहेत्॥ ११/२८/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_028/BhP_11.028.043.m4a", "display_order": 44}, {"id": 6000329044, "chapter_id": 10329, "verse_number": "११-२८-४१", "content_sanskrit": "कांश्चिन्ममानुध्यानेन नामसङ्कीर्तनादिभिः।\nयोगेश्वरानुवृत्त्या वा हन्यादशुभदान् शुभैः॥ ११/२८/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_028/BhP_11.028.044.m4a", "display_order": 45}, {"id": 6000329045, "chapter_id": 10329, "verse_number": "११-२८-४२", "content_sanskrit": "केचिद् देहमिमं धार्यं सुकल्पं वयसि स्थितम्।\nविधाय विविधोपायैरथ युञ्जन्ति सिद्धये॥ ११/२८/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_028/BhP_11.028.045.m4a", "display_order": 46}, {"id": 6000329046, "chapter_id": 10329, "verse_number": "११-२८-४३", "content_sanskrit": "इह वर्षशताशीत्या तदायासो ह्यपार्थकः।\nअन्तवत्त्वाच्छरीरस्य फलस्येव वनस्पतेः॥ ११/२८/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_028/BhP_11.028.046.m4a", "display_order": 47}, {"id": 6000329047, "chapter_id": 10329, "verse_number": "११-२८-४४", "content_sanskrit": "योगं निषेवतो नित्यं कायश्चेत् कल्पतामियात्।\nतच्छ्रद्दध्यान्न मतिमान् योगमुत्सृज्य मत्परः॥ ११/२८/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_028/BhP_11.028.047.m4a", "display_order": 48}, {"id": 6000329048, "chapter_id": 10329, "verse_number": "११-२८-४५", "content_sanskrit": "योगचर्यामिमां योगी विचरन् मदपाश्रयः।\nनान्तरायैर्विहन्येत निःस्पृहः स्वसुखानुभूः॥ ११/२८/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_028/BhP_11.028.048.m4a", "display_order": 49}, {"id": 6000329049, "chapter_id": 10329, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायाम् एकादशस्कन्धे अष्टाविंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]