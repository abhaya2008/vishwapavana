[{"id": 7003944000, "chapter_id": 23944, "verse_number": "३-१-७-१", "content_sanskrit": "श्रीसूत उवाच ।\nस्वसैन्यमवलोक्याथ महिषो दानवेश्वरः ।\nहतं देव्या महाक्रोधाच्चंडकोपमथाब्रवीत्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003944001, "chapter_id": 23944, "verse_number": "३-१-७-२", "content_sanskrit": "महिष उवाच ।\nचंडकोप महावीर्य युद्ध्यस्वैनां दुरात्मिकाम् ।\nतथास्त्विति स चोक्त्वाथ चंडकोपः प्रतापवान्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003944002, "chapter_id": 23944, "verse_number": "३-१-७-३", "content_sanskrit": "अवाकिरद्बाणवर्षैर्देवीं समरमूर्द्धनि ।\nबाणजालानि तस्याशु चंडकोपस्य लीलया॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003944003, "chapter_id": 23944, "verse_number": "३-१-७-४", "content_sanskrit": "छित्त्वा जघान शस्त्रेण चंडकोपस्य सांबिका ।\nचकर्त वाजिनोऽप्यस्य सारथिं च ध्वजं धनुः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003944004, "chapter_id": 23944, "verse_number": "३-१-७-५", "content_sanskrit": "उन्ममाथ रथं चापि तं बाणैर्हृद्यताडयत् ।\nस भग्नधन्वा विरथो हताश्वो हतसारथिः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003944005, "chapter_id": 23944, "verse_number": "३-१-७-६", "content_sanskrit": "चंडकोपस्ततो देवीं खड्गचर्मधरोऽभ्यगात् ।\nखड्गेन सिंहमाजघ्ने देव्या वाहं महासुरः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003944006, "chapter_id": 23944, "verse_number": "३-१-७-७", "content_sanskrit": "देवीमपि भुजे सव्ये खड्गेन प्रजघान सः ।\nखङ्गो देव्या भुजे सव्ये व्यशीर्यत सहस्रधा॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003944007, "chapter_id": 23944, "verse_number": "३-१-७-८", "content_sanskrit": "ततः शूले न महता चंडकोपं तदांबिका ।\nजघान हृदये सोऽपि पपात च ममार च॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003944008, "chapter_id": 23944, "verse_number": "३-१-७-९", "content_sanskrit": "चंडकोपे हते तस्मिन्महावीर्ये महाबले ।\nचित्रभानुर्गजारूढो देवीं तामभ्यधावत॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003944009, "chapter_id": 23944, "verse_number": "३-१-७-१०", "content_sanskrit": "दिव्यां शक्तिं ससर्जाथ महाघंटारवाकुलाम् ।\nन्यवारयत हुंकारैर्देवी शक्तिं निराकुलाम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003944010, "chapter_id": 23944, "verse_number": "३-१-७-११", "content_sanskrit": "ततः शूलेन सा देवी चित्रभानुं व्यदारयत् ।\nमृते तस्मिंस्ततो युद्धे करालो द्रुतमभ्यगात्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003944011, "chapter_id": 23944, "verse_number": "३-१-७-१२", "content_sanskrit": "करमुष्टिप्रहारेण सोऽपि देव्या निपातितः ।\nततो देवी मदोन्मत्तं गदया व्यसुमातनोत्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003944012, "chapter_id": 23944, "verse_number": "३-१-७-१३", "content_sanskrit": "बाष्कलं पट्टिशेनापि चक्रेणापि तथांतिकम् ।\nप्राहिणोद्यमलोकाय दुर्गा देवी द्विजोत्तमाः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003944013, "chapter_id": 23944, "verse_number": "३-१-७-१४", "content_sanskrit": "एवमन्यान्महाकायान्मंत्रिणो महिषस्य च ।\nशूलेन प्रोथयित्वाथ प्राहिणोद्यमसादनम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003944014, "chapter_id": 23944, "verse_number": "३-१-७-१५", "content_sanskrit": "आत्मसैन्ये हते त्वेवं दुर्गया महिषासुरः ।\nमाहिषेणाथ रूपेण गणान्देव्या अभक्षयत्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003944015, "chapter_id": 23944, "verse_number": "३-१-७-१६", "content_sanskrit": "तुण्डेन निजघानैकान्सुराघातैस्तथापरान् ।\nनिश्वासवायुभिश्चान्यान्पातयामास रोषितः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003944016, "chapter_id": 23944, "verse_number": "३-१-७-१७", "content_sanskrit": "देव्या भूतगणं त्वेवं निहत्य महिषासुरः ।\nसिंहं मारयितुं देव्याश्चुक्रोध च ननाद च॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003944017, "chapter_id": 23944, "verse_number": "३-१-७-१८", "content_sanskrit": "ततः सिंहोऽभवत्क्रुद्धो महावीर्यो महाबलः ।\nसुराभि घातनिर्भिन्नमहीतलमहीधरः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003944018, "chapter_id": 23944, "verse_number": "३-१-७-१९", "content_sanskrit": "महिषासुरमायांतं नखैरेनं व्यदारयत् ।\nचंडिकापि ततः क्रुद्धा वधे तस्याकरोन्मतिम्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003944019, "chapter_id": 23944, "verse_number": "३-१-७-२०", "content_sanskrit": "बबन्ध पाशैर्महिषं चंडिका कोपमूर्च्छिता ।\nमोचयित्वा ततः पाशांस्त्यक्तमाहिषवेषवान्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003944020, "chapter_id": 23944, "verse_number": "३-१-७-२१", "content_sanskrit": "सिंहवेषोऽभवद्दैत्यो महाबलपराक्रमः ।\nदेवी तस्य शिरोयावच्छेत्तुं बुद्धिमधारयत्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003944021, "chapter_id": 23944, "verse_number": "३-१-७-२२", "content_sanskrit": "तावत्स पुरुषो भूत्वा खड्गपाणिरदृश्यत ।\nअथ तं पुरुषं देवी खड्गहस्तं शरोत्करैः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003944022, "chapter_id": 23944, "verse_number": "३-१-७-२३", "content_sanskrit": "जघान तीक्ष्णधाराग्रैः परमर्मविदारणैः ।\nततः स पुरुषो विप्रा गजोऽभूद्धस्तदन्तवान्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003944023, "chapter_id": 23944, "verse_number": "३-१-७-२४", "content_sanskrit": "दुर्गाया वाहनं सिंहं करेण विचकर्ष च ।\nततः सिंहः करं तस्य विचकर्त नखांकुरैः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003944024, "chapter_id": 23944, "verse_number": "३-१-७-२५", "content_sanskrit": "भूयो महासुरो जातो माहिषं वेषमाश्रितः ।\nततः क्रुद्धा भद्रकाली महत्पानमसेवत॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003944025, "chapter_id": 23944, "verse_number": "३-१-७-२६", "content_sanskrit": "ततः पानवशा न्मत्ता जहासारुणलोचना ।\nमहिषः सोऽपि गर्वेण शृंगाभ्यां पर्वतोत्करान्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003944026, "chapter_id": 23944, "verse_number": "३-१-७-२७", "content_sanskrit": "चंडिकां प्रतिं चिक्षेप सा च तानच्छिनच्छरैः ।\nततो देवी जग न्माता महिषासुरमब्रवीत्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003944027, "chapter_id": 23944, "verse_number": "३-१-७-२८", "content_sanskrit": "देव्युवाच ।\nकुरु गर्वं क्षणं मूढ मधु यावत्पिबाम्यहम् ।\nनिवृत्तमधुपानाहं त्वां नयिष्ये यमक्षयम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003944028, "chapter_id": 23944, "verse_number": "३-१-७-२९", "content_sanskrit": "हते त्वयि दुराधर्षे मया दैवतकंटके ।\nस्वंस्वं स्थानं प्रपद्यंतां सिद्धा साध्या मरुद्गणाः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003944029, "chapter_id": 23944, "verse_number": "३-१-७-३०", "content_sanskrit": "उक्त्वैवं ताडयामास मुष्टिना महिषासुरम् ।\nताडितोऽयं ततो देव्या महिषो भृशविह्वलः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003944030, "chapter_id": 23944, "verse_number": "३-१-७-३१", "content_sanskrit": "दक्षिणस्योदधेस्तीरेप्रदुद्राव त्वरान्वितः ।\nअनुदुद्राव तं देवी सिंहमारुह्य वाहनम्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003944031, "chapter_id": 23944, "verse_number": "३-१-७-३२", "content_sanskrit": "अनुद्रुतस्ततो देव्या महिषो दानवेश्वरः ।\nधर्मपुष्कीरणीतोये दशयोजनमायते॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003944032, "chapter_id": 23944, "verse_number": "३-१-७-३३", "content_sanskrit": "प्रविश्यांतर्हितस्तस्थौ दुर्गाताडनविह्वलः ।\nततो दुर्गा समासाद्य धर्मपुष्करिणीतटम्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003944033, "chapter_id": 23944, "verse_number": "३-१-७-३४", "content_sanskrit": "नददर्शासुरं तत्र महिषं चंडिका तदा ।\nअशरीरा ततो वाणी दुर्गा देवीमभाषत॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003944034, "chapter_id": 23944, "verse_number": "३-१-७-३५", "content_sanskrit": "भद्रकालि महादेवि महिषो दानवस्त्वया ।\nताडितो मुष्टिना भद्रे धर्मपुष्करिणीजले॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003944035, "chapter_id": 23944, "verse_number": "३-१-७-३६", "content_sanskrit": "अस्मिन्नंतर्हितः शेते भयार्तो मारयस्व तम् ।\nयेनकेनाप्युपायेन चैनं प्राणैर्वियोजय॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003944036, "chapter_id": 23944, "verse_number": "३-१-७-३७", "content_sanskrit": "एवं वाचाऽशरी रिण्या कथिता चंडिका तदा ।\nप्राह स्ववाहनं सिंहमसुरेंद्रवधोद्यता॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003944037, "chapter_id": 23944, "verse_number": "३-१-७-३८", "content_sanskrit": "मृगेंद्र सिंहविक्रांत महावलपराक्रम ।\nधर्मपुष्कीरणीतोयं निःशेषं पीय तां त्वया॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003944038, "chapter_id": 23944, "verse_number": "३-१-७-३९", "content_sanskrit": "देव्यैवमुक्तः पंचास्यो धर्मपुष्करिणीजलम् ।\nनिःशेषं च पपौ विप्रा यथा पांसुर्भवेत्तथा॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003944039, "chapter_id": 23944, "verse_number": "३-१-७-४०", "content_sanskrit": "निरगान्महिषो दीनस्ततस्तस्मा ज्जलाशयात् ।\nआयांतमसुरं देवी पादेनाक्रम्य मूर्द्धनि॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003944040, "chapter_id": 23944, "verse_number": "३-१-७-४१", "content_sanskrit": "कंठं शूलेन तीक्ष्णेन पीडयामास कोपिता ।\nततो देव्यसिमादाय चकर्तास्य शिरो महत्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003944041, "chapter_id": 23944, "verse_number": "३-१-७-४२", "content_sanskrit": "एवं स महिषो विप्राः सभृत्यबलवाहनः ।\nदुर्गया निहतो भूमौ पपात च ममार च॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003944042, "chapter_id": 23944, "verse_number": "३-१-७-४३", "content_sanskrit": "ततो देवाः सगंधर्वाः सिद्धाश्च परमर्षयः ।\nस्तुत्वा देवीं ततः स्तोत्रैस्तुष्टा जहृषिरे तदा॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003944043, "chapter_id": 23944, "verse_number": "३-१-७-४४", "content_sanskrit": "अनुज्ञातास्ततो देव्या देवा जग्मुर्यथागतम् ।\nततो देवी जगन्माता स्व नाम्ना पुरमुत्तमम्॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003944044, "chapter_id": 23944, "verse_number": "३-१-७-४५", "content_sanskrit": "दक्षिणस्य समुद्रस्य तीरे चक्रे तदोत्तरे ।\nततो देव्यनुशिष्टास्ते देवाः शक्रपुरोगमाः॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003944045, "chapter_id": 23944, "verse_number": "३-१-७-४६", "content_sanskrit": "पूरयामासुरमृतैर्धर्मपुष्क रिणीं तदा ।\nततो ह्यमृततीर्थाख्यां लेभे तत्तीर्थमुत्तमम्॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003944046, "chapter_id": 23944, "verse_number": "३-१-७-४७", "content_sanskrit": "ततो देवी वरमदात्स्वपुरस्य मुदान्विता ।\nपशव्यं चापरोगं च पुरमेतद्भवत्विति॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003944047, "chapter_id": 23944, "verse_number": "३-१-७-४८", "content_sanskrit": "ददौ तीर्थाय च वरं स्नातानामत्र वै नृणाम् ।\nयथाभिलाषं सिद्धिः स्यादित्युक्त्वा सा दिवं ययौ॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003944048, "chapter_id": 23944, "verse_number": "३-१-७-४९", "content_sanskrit": "श्रीसूत उवाच ।\nयत्स्वनाम्ना चकारेदं देवी पुरमनुत्तमम् ।\nदेवीपत्तनमित्युक्तं तेन देव्याः पुरोत्तमम्॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003944049, "chapter_id": 23944, "verse_number": "३-१-७-५०", "content_sanskrit": "देवीपत्तनमारभ्य सुमुहूर्ते दिने द्विजाः ।\nविघ्नेश्वरं प्रणम्यादौ सलिलस्वामिनं तथा॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003944050, "chapter_id": 23944, "verse_number": "३-१-७-५१", "content_sanskrit": "महादेवाभ्यनुज्ञातो रामचंद्रोऽतिधार्मिकः ।\nस्थापयित्वा स्वहस्तेन पाषाणनवकं मुदा॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003944051, "chapter_id": 23944, "verse_number": "३-१-७-५२", "content_sanskrit": "सेतुमारब्धवान्विप्रा यावल्लंकामतंद्रितः ।\nसिंहासनं समारुह्य रामो नलकृतं शुभम्॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003944052, "chapter_id": 23944, "verse_number": "३-१-७-५३", "content_sanskrit": "वानरैः कारयामास सेतुमब्धौ नलादिभिः ।\nपर्वताञ्छाखिनोवृक्षान्दृषदः काष्ठसंचयान्॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003944053, "chapter_id": 23944, "verse_number": "३-१-७-५४", "content_sanskrit": "तृणानि च समाजह्रुर्वानरा वनमध्यतः॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003944054, "chapter_id": 23944, "verse_number": "३-१-७-५५", "content_sanskrit": "नलस्तानि समादाय चक्रे सेतुं महोदधौ ।\nपंचभिर्दिवसैः सेतुर्यावल्लंकासमीपतः॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003944055, "chapter_id": 23944, "verse_number": "३-१-७-५६", "content_sanskrit": "दशयोजनविस्तीर्णश्शतयोजनमायतः ।\nकृतः सेतुर्नलेनाब्धौ पुण्यः पापविनाशनः॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003944056, "chapter_id": 23944, "verse_number": "३-१-७-५७", "content_sanskrit": "देवीपुरस्य निकटे नवपाषाणरूपके ।\nसेतुमूले नरः स्नायात्स्वपापपरिशुद्धये॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003944057, "chapter_id": 23944, "verse_number": "३-१-७-५८", "content_sanskrit": "चक्रतीर्थे तथा स्नायाद्भजेत्सेत्वधिपं हरिम् ।\nदेवीपत्तनमारभ्य यत्कृतं सेतुबंधनम्॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003944058, "chapter_id": 23944, "verse_number": "३-१-७-५९", "content_sanskrit": "तत्सेतुमूलं विप्रेंद्रा यथार्थं परिकल्पितम् ।\nसेतोस्तु पश्चिमा कोटिर्दर्भशय्या प्रकीर्तिता॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003944059, "chapter_id": 23944, "verse_number": "३-१-७-६०", "content_sanskrit": "देवीपुरी च प्राक्कोटिरुभयं सेतुमूलकम् ।\nउभयं पुण्यमाख्यातं पवित्रं पापनाशनम्॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003944060, "chapter_id": 23944, "verse_number": "३-१-७-६१", "content_sanskrit": "यत्सेतुमूलं गच्छंति येन मार्गेण वै नराः ।\nतत्तन्मार्गगतास्ते ते तस्मिंस्तस्मिन्विमुक्तिदे॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003944061, "chapter_id": 23944, "verse_number": "३-१-७-६२", "content_sanskrit": "स्नात्वादौ सेतुमूले तु चक्रतीर्थे तथैव च ।\nसंकल्पपूर्वकं पश्चाद्गच्छेयुः सेतुबंधनम्॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003944062, "chapter_id": 23944, "verse_number": "३-१-७-६३", "content_sanskrit": "देवीपुरे तथा दर्भशय्यायामपि भूसुराः ।\nचक्रतीर्थे शिवे स्नानं पुण्यपापविनाशनम्॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003944063, "chapter_id": 23944, "verse_number": "३-१-७-६४", "content_sanskrit": "स्मरणादुभयत्रापि चक्रतीर्थस्य वै द्विजाः ।\nभस्मीभवंति पापानि लक्षजन्मकृतान्यपि॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003944064, "chapter_id": 23944, "verse_number": "३-१-७-६५", "content_sanskrit": "जन्मापि विलयं यायान्मुक्तिश्चापि करे स्थिता ।\nचक्रतीर्थसमं तीर्थं न भूतं न भविष्यति॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003944065, "chapter_id": 23944, "verse_number": "३-१-७-६६", "content_sanskrit": "भूलोके यानि तीर्थानि गंगादीनि द्विजोत्तमाः ।\nचक्रतीर्थस्य तान्यद्धा कलां नार्हंति षोडशीम्॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003944066, "chapter_id": 23944, "verse_number": "३-१-७-६७", "content_sanskrit": "आदौ तु नवपाषाणमध्येऽब्धौ स्नानमाचरेत् ।\nक्षेत्रपिंडे ततः कुर्याच्चक्रतीर्थे तथैव च॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003944067, "chapter_id": 23944, "verse_number": "३-१-७-६८", "content_sanskrit": "सेतुनाथं हरिं सेवेत्स्वपापपरिशुद्धये ।\nएवं हि दर्भशय्यायां कुर्युस्तन्मार्गतो गताः॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003944068, "chapter_id": 23944, "verse_number": "३-१-७-६९", "content_sanskrit": "आरूढं रामचंद्रेण यो नमस्कुरुते जनः ।\nसिंहासनं नलकृतं न तस्य नरकाद्भयम्॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003944069, "chapter_id": 23944, "verse_number": "३-१-७-७०", "content_sanskrit": "सेतुमादौ नमस्कुर्याद्रामं ध्यायन्हृदा तदा ।\nरघुवीरपदन्यास पवित्रीकृतपांसवे॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003944070, "chapter_id": 23944, "verse_number": "३-१-७-७१", "content_sanskrit": "दशकंठशिरश्छेदहेतवे सेतवे नमः ।\nकेतवे रामचंद्रस्य मोक्षमार्गैकहेतवे॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003944071, "chapter_id": 23944, "verse_number": "३-१-७-७२", "content_sanskrit": "सीताया मानसांभोजभानवे सेतवे नमः ।\nसाष्टांगं प्रणिपत्यादौ मंत्रेणानेन वै द्विजाः॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003944072, "chapter_id": 23944, "verse_number": "३-१-७-७३", "content_sanskrit": "ततो वेतालवरदं तीर्थं गच्छेन्महाबलम् ।\nतत्र स्नानादवाप्नोति सिद्धिं पारामिकां नरः॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003944073, "chapter_id": 23944, "verse_number": "३-१-७-७४", "content_sanskrit": "योऽध्यायमेनं पठते मनुष्यः शृणोति वा भक्तियुतो द्विजेंद्राः ।\nस्वर्गादयस्तस्य न दुर्लभाः स्युः कैवल्यमप्यस्य करस्थमेव॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}]