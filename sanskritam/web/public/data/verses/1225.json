[{"id": 2010997, "chapter_id": 1225, "verse_number": "१-२२६-०x", "content_sanskrit": "द्रुपद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2010998, "chapter_id": 1225, "verse_number": "१-२२६-१", "content_sanskrit": "एवमेतन्महाप्राज्ञ यथात्थ विदुराद्य माम्।\nममापि परमो हर्षः संबन्धेऽस्मिन्कृते प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2010999, "chapter_id": 1225, "verse_number": "१-२२६-२", "content_sanskrit": "गमनं चापि युक्तं स्याद्दृढमेषां महात्मनाम्।\nन तु तावन्मया युक्तमेतद्वक्तुं स्वयं गिरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2011000, "chapter_id": 1225, "verse_number": "१-२२६-३", "content_sanskrit": "यदा तु मन्यते वीरः कुन्तीपुत्रो युधिष्ठिरः।\nभीमसेनार्जुनौ चैव यमौ च पुरुषर्षभौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2011001, "chapter_id": 1225, "verse_number": "१-२२६-४", "content_sanskrit": "रामकृष्णौ च धर्मज्ञौ तदा गच्छन्तु पाण्डवाः।\nएतौ हि पुरुषव्याघ्रावेषां प्रियहिते रतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2011002, "chapter_id": 1225, "verse_number": "१-२२६-५x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2011003, "chapter_id": 1225, "verse_number": "१-२२६-५", "content_sanskrit": "परवन्तो वयं राजंस्त्वयि सर्वे सहानुगाः।\nयथा वक्ष्यसि नः प्रीत्या तत्करिष्यामहे वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2011004, "chapter_id": 1225, "verse_number": "१-२२६-६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2011005, "chapter_id": 1225, "verse_number": "१-२२६-६", "content_sanskrit": "ततोऽब्रवीद्वासुदेवो गमनं रोचते मम।\nयथा वा मन्यते राजा द्रुपदः सर्वधर्मवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2011006, "chapter_id": 1225, "verse_number": "१-२२६-७x", "content_sanskrit": "द्रुपद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2011007, "chapter_id": 1225, "verse_number": "१-२२६-७", "content_sanskrit": "यथैव मन्यते वीरो दाशार्हः पुरुषोत्तमः।\nप्राप्तकालं महाबाहुः सा बुद्धिर्निश्चिता मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2011008, "chapter_id": 1225, "verse_number": "१-२२६-८", "content_sanskrit": "यथैव हि महाभागाः कौन्तेया मम सांप्रतम्।\nतथैव वासुदेवस्य पाण्डुपुत्रा न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2011009, "chapter_id": 1225, "verse_number": "१-२२६-९", "content_sanskrit": "न तद्ध्यायति कौन्तेयः पाण्डुपुत्रो युधिष्ठिरः।\nयथैषां पुरुषव्याघ्रः श्रेयो ध्यायति केशवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2011010, "chapter_id": 1225, "verse_number": "१-२२६-१०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2011011, "chapter_id": 1225, "verse_number": "१-२२६-१०", "content_sanskrit": "पृथायास्तु ततो वेश्म प्रविवेश महामतिः।\nपादौ स्पृष्ट्वा पृथायास्तु शिरसा च महीं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2011012, "chapter_id": 1225, "verse_number": "१-२२६-११", "content_sanskrit": "दृष्ट्वा तु देवरं कुन्ती शुशोच च मुहुर्मुहुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2011013, "chapter_id": 1225, "verse_number": "१-२२६-११x", "content_sanskrit": "कुन्त्युवाच।\nवैचित्रवीर्य ते पुत्राः कथंचिज्जीवितास्त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2011014, "chapter_id": 1225, "verse_number": "१-२२६-१२", "content_sanskrit": "त्वत्प्रसादाज्जतुगृहे मृताः प्रत्यागतास्तथा।\nकूर्मी चिन्तयते पुत्रान्यत्र वा तत्र संमता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2011015, "chapter_id": 1225, "verse_number": "१-२२६-१३", "content_sanskrit": "चिन्तया वर्धिताः पुत्रा यथा कुशलिनस्तथा।\nतव पुत्रास्तु जीवन्ति त्वद्भक्त्या भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2011016, "chapter_id": 1225, "verse_number": "१-२२६-१४", "content_sanskrit": "यथा परभृतः पुत्रानरिष्टा वर्धयेत्सदा।\nतथैव पुत्रास्तु मम त्वया तात सुरक्षिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2011017, "chapter_id": 1225, "verse_number": "१-२२६-१५", "content_sanskrit": "क्लेशास्तु बहवः प्राप्तास्तथा प्राणान्तिका मया।\nअतः परं न जानामि कर्तव्यं ज्ञातुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2011018, "chapter_id": 1225, "verse_number": "१-२२६-१६x", "content_sanskrit": "विदुर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2011019, "chapter_id": 1225, "verse_number": "१-२२६-१६", "content_sanskrit": "न विनश्यन्ति लोकेषु तव पुत्रा महाबलाः।\nअचिरेणैव कालेन स्वराज्यस्था भवन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2011020, "chapter_id": 1225, "verse_number": "१-२२६-१७", "content_sanskrit": "बान्धवैः सहिताः सर्वे न शोकं कुरु माधवि।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2011021, "chapter_id": 1225, "verse_number": "१-२२६-१७x", "content_sanskrit": "वैशम्पायन उवाच।\nततस्ते समनुज्ञाता द्रुपदेन महात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2011022, "chapter_id": 1225, "verse_number": "१-२२६-१८", "content_sanskrit": "पाण्डवाश्चैव कृष्णश्च विदुरश्च महामतिः।\nआदाय द्रौपदीं कृष्णां कुन्तीं चैव यशस्विनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2011023, "chapter_id": 1225, "verse_number": "१-२२६-१९", "content_sanskrit": "सविहारं सुखं जग्मुर्नगरं नागसाह्वयम्।\nसुवर्णकक्ष्याग्रैवेयान्सुवर्णाङ्कुशभूषितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2011024, "chapter_id": 1225, "verse_number": "१-२२६-२०", "content_sanskrit": "जाम्बूनदपरिष्कारान्प्रभिन्नकरटामुखान्।\nअधिष्ठितान्महामात्रैः सर्वशस्त्रसमन्वितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2011025, "chapter_id": 1225, "verse_number": "१-२२६-२१", "content_sanskrit": "सहस्रं प्रददौ राजा गजानां वरवर्मिणाम्।\nरथानां च सहस्रं वै सुवर्णमणिचित्रितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2011026, "chapter_id": 1225, "verse_number": "१-२२६-२२", "content_sanskrit": "चतुर्युजां भानुमच्च पञ्चानां प्रददौ तदा।\nसुवर्णपरिबर्हाणां वरचामरमालिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2011027, "chapter_id": 1225, "verse_number": "१-२२६-२३", "content_sanskrit": "जात्यश्वानां च पञ्चाशत्सहस्रं प्रददौ नृपः।\nदासीनामयुतं राजा प्रददौ वरभूषणम्।\nततः सहस्रं दासानां प्रददौ वरधन्वनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2011028, "chapter_id": 1225, "verse_number": "१-२२६-२४", "content_sanskrit": "हैमानि शय्यासनबाजनानि\nद्रव्याणि चान्यानि च गोधनानि।\nपृथक्पृथक्वैव ददौ स कोटिं\nपाञ्चालराजः परमप्रहृष्टः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2011029, "chapter_id": 1225, "verse_number": "१-२२६-२५", "content_sanskrit": "शिबिकानां शतं पूर्णं वाहान्पञ्चशतं नरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2011030, "chapter_id": 1225, "verse_number": "१-२२६-२६", "content_sanskrit": "एवमेतानि पाञ्चालो जन्यार्थे प्रददौ धनम्।\nहरणं चापि पाञ्चाल्या ज्ञातिदेयं च सोमकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2011031, "chapter_id": 1225, "verse_number": "१-२२६-२७", "content_sanskrit": "धृष्टद्युम्नो ययौ तत्र भगिनीं गृह्य भारत।\nनानद्यमानो बहुशस्तूर्यघोषैः सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2011032, "chapter_id": 1225, "verse_number": "१-२२६-२८", "content_sanskrit": "श्रुत्वा चोपस्थितान्वीरान्धृतराष्ट्रोऽम्बिकासुतः।\nप्रतिग्रहाय पाण्डूनां प्रेषयामास कौरवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2011033, "chapter_id": 1225, "verse_number": "१-२२६-२९", "content_sanskrit": "विकर्णं च महेष्वासं चित्रसेनं च भारत।\nद्रोणं च परमेष्वासं गौतमं कृपमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2011034, "chapter_id": 1225, "verse_number": "१-२२६-३०", "content_sanskrit": "तैस्तैः परिवृताः शूरैः शोभमाना महारथाः।\nनगरं हास्तिनपुरं शनैः प्रविविशुस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2011035, "chapter_id": 1225, "verse_number": "१-२२६-३१", "content_sanskrit": "पाण्डवानागताञ्छ्रुत्वा नागरास्तु कुतूहलात्।\nमण्डयाञ्चक्रिरे तत्र नगरं नागसाह्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2011036, "chapter_id": 1225, "verse_number": "१-२२६-३२", "content_sanskrit": "मुक्तपुष्पावकीर्णं तु जलसिक्तं तु सर्वतः।\nधूपितं दिव्यधूपेन मङ्गलैश्चाभिसंवृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2011037, "chapter_id": 1225, "verse_number": "१-२२६-३३", "content_sanskrit": "पताकोच्छ्रितमाल्यं च पुरमप्रतिमं बभौ।\nशङ्खभेरीनिनादैश्च नानावादित्रनिस्वनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2011038, "chapter_id": 1225, "verse_number": "१-२२६-३४", "content_sanskrit": "कौतूहलेन नगरं पूर्यमाणमिवाभवत्।\nयत्र ते पुरुषव्याघ्राः शोकदुःखसमन्विताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2011039, "chapter_id": 1225, "verse_number": "१-२२६-३५", "content_sanskrit": "निर्गताश्च पुरात्पूर्वं धृतराष्ट्रप्रबाधिताः।\nपुनर्निवृत्ता दिष्ट्या वै सह मात्रा परन्तपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2011040, "chapter_id": 1225, "verse_number": "१-२२६-३६", "content_sanskrit": "इत्येवमीरिता वाचो जनैः प्रियचिकीर्षुभिः।\nतत उच्चावचा वाचः प्रियाः सर्वत्र भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2011041, "chapter_id": 1225, "verse_number": "१-२२६-३७", "content_sanskrit": "उदीरितास्तदाऽशृण्वन्पाण्डवा हृदयंगमाः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2011042, "chapter_id": 1225, "verse_number": "१-२२६-३७x", "content_sanskrit": "पौरा ऊचुः\nअयं स पुरुषव्याघ्रः पुनरायाति धर्मवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2011043, "chapter_id": 1225, "verse_number": "१-२२६-३८", "content_sanskrit": "यो नः स्वानिव दायादान्धर्मेण परिरक्षति।\nअद्य पाण्डुर्महाराजो वनादिव मनःप्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2011044, "chapter_id": 1225, "verse_number": "१-२२६-३९", "content_sanskrit": "आगतश्चैवमस्माकं चिकीर्षन्नात्र संशयः।\nकिं न्वद्य सुकृतं कर्म सर्वेषां नः प्रियं परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2011045, "chapter_id": 1225, "verse_number": "१-२२६-४०", "content_sanskrit": "यन्नः कुन्तीसुता वीरा भर्तारः पुनरागताः।\nयदि दत्तं यदि हुतं यदि वाप्यस्ति नस्तपः।\nतेन तिष्ठन्तु नगरे पाण्डवाः शरदां शतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2011046, "chapter_id": 1225, "verse_number": "१-२२६-४१", "content_sanskrit": "ततस्ते धृतराष्ट्रस्य भीष्मस्य च महात्मनः।\nअन्येषां च तदर्हाणां चक्रुः पादाभिवन्दनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2011047, "chapter_id": 1225, "verse_number": "१-२२६-४२", "content_sanskrit": "पृष्टास्तु कुशलप्रश्नं सर्वेण नगरेण ते।\nसमाविशन्त वेश्मानि धृतराष्ट्रस्य शासनात्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2011048, "chapter_id": 1225, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि विदुरागमनराज्यलाभपर्वणि षड्विंशत्यधिकद्विशततमोऽध्यायः॥ २२६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]