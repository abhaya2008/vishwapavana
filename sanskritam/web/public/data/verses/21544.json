[{"id": 7001544000, "chapter_id": 21544, "verse_number": "१-४१-१", "content_sanskrit": "॥सूत उवाच ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001544001, "chapter_id": 21544, "verse_number": "१-४१-२", "content_sanskrit": "विविक्तचारुशिखरं पत्रितं शङ्खवर्चसम् ।\nकैलासं देवभक्तानामालयं सुकृतात्मनाम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001544002, "chapter_id": 21544, "verse_number": "१-४१-३", "content_sanskrit": "तस्य कूटतटे रम्ये मध्यमे कुन्दसन्निभे ।\nयोजनानां शतायामे पञ्चाशच्च तथायतम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001544003, "chapter_id": 21544, "verse_number": "१-४१-४", "content_sanskrit": "सुवर्णमणिचित्राभि अनेकाभिरलंकृतम् ।\nमहाभवनमालाभिर्भूषितं नैकविस्तरम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001544004, "chapter_id": 21544, "verse_number": "१-४१-५", "content_sanskrit": "धनाध्यक्षस्य देवस्य कुबेरस्य महात्मनः ।\nनगरन्तदनाधृष्यमृद्धियुक्तं मुदायुतम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001544005, "chapter_id": 21544, "verse_number": "१-४१-६", "content_sanskrit": "तस्य मध्ये सभा रम्या नानाकनकमण्डिता ।\nविपुला नाम विख्याता विपुलस्तम्भतोरणा ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001544006, "chapter_id": 21544, "verse_number": "१-४१-७", "content_sanskrit": "तत्र तत्पुष्पकं नाम नानारत्नविभूषितम् ।\nमहाविमानं रुचिरं सर्वकामगुणैर्युतम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001544007, "chapter_id": 21544, "verse_number": "१-४१-८", "content_sanskrit": "मनोजवं कामगमं हेमजालविभूषितम् ।\nवाहनं यक्षराजस्य कुबेरस्य महात्मनः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001544008, "chapter_id": 21544, "verse_number": "१-४१-९", "content_sanskrit": "तत्रैकपिङ्गलो देवो महादेवसखः स्वयम् ।\nवसति स्म स यक्षेन्द्रः सर्वभूतनमस्कृतः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001544009, "chapter_id": 21544, "verse_number": "१-४१-१०", "content_sanskrit": "तत्राप्सरोगणैर्य्यक्षैर्गन्धर्वैः सिद्धचारणैः ।\nवसति स्म महात्माऽसौ कुबेरो देवसत्तमः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001544010, "chapter_id": 21544, "verse_number": "१-४१-११", "content_sanskrit": "तत्र पद्ममहापद्मौ तथा मकरकच्छपौ ।\nकुमुदः शङ्ख नीलौ च नन्दनो निधिसत्तमः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001544011, "chapter_id": 21544, "verse_number": "१-४१-१२", "content_sanskrit": "अष्टावेतेऽक्षया दिव्या धनेशस्य महात्मनः ।\nमहानिधानास्तिष्ठन्ति सभायां रत्नसञ्चिताः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001544012, "chapter_id": 21544, "verse_number": "१-४१-१३", "content_sanskrit": "तथेन्द्राग्नियमादीनां देवानामप्सरोगणैः ।\nतेषां कैलास आवासो यत्र यक्षेश्वरः प्रभुः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001544013, "chapter_id": 21544, "verse_number": "१-४१-१४", "content_sanskrit": "कृत्वा पूर्वमुपस्थानं यक्षेन्द्रस्य महात्मनः ।\nपश्चाद्गच्छन्ति ये यस्य विहिताः परिचारकाः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001544014, "chapter_id": 21544, "verse_number": "१-४१-१५", "content_sanskrit": "तत्र मन्दाकिनी नाम सुरम्या विपुलोदका ।\nसुवर्णमणिसोपाना नानापुष्पोत्कटोत्कटा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001544015, "chapter_id": 21544, "verse_number": "१-४१-१६", "content_sanskrit": "जाम्बूनदमयैः पद्मैर्गन्धस्पर्शगुणान्वितैः ।\nनीलवैदूर्य्यपत्रैश्च गन्धोपैतैर्महोत्पलैः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001544016, "chapter_id": 21544, "verse_number": "१-४१-१७", "content_sanskrit": "तथा कुमुदखण्डैश्च महापद्मैरलङ्कृता  ।\nयक्षगन्धर्वनारीभिरप्सरोभिश्च शोभिता ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001544017, "chapter_id": 21544, "verse_number": "१-४१-१८", "content_sanskrit": "देवदानवगन्धर्वैर्यक्षराक्षसपन्नगैः ।\nउपस्पृष्टजला रम्या वापी मन्दाकिनी तथा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001544018, "chapter_id": 21544, "verse_number": "१-४१-१९", "content_sanskrit": "तथा अलकनन्दा च नन्दा च सरितां वरा  ।\nएतैरेव गुणैर्युक्ता नद्यो देवर्षिसेविताः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001544019, "chapter_id": 21544, "verse_number": "१-४१-२०", "content_sanskrit": "तस्यैव शैलराजस्य पूर्वे कूटे परिश्रुताः ।\nसहस्रयोजनायामास्त्रिंशद्योजन विस्तराः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001544020, "chapter_id": 21544, "verse_number": "१-४१-२१", "content_sanskrit": "दश गन्धर्वनगराः समृद्ध्या परया युताः ।\nमहाभवनमालाभिरनेकाभिर्विभूषिताः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001544021, "chapter_id": 21544, "verse_number": "१-४१-२२", "content_sanskrit": "सुबाहुहरिकेशाद्या श्चित्रसेनजरादयः ।\nदश गन्धर्वराजानो दीप्तवह्निपराक्रमाः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001544022, "chapter_id": 21544, "verse_number": "१-४१-२३", "content_sanskrit": "तस्यैव पश्चिमे कूटे कुन्देन्दुसदृशप्रभे ।\nनानाधातुशतैश्चित्रैः सिद्ध देवर्षिसेविते॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001544023, "chapter_id": 21544, "verse_number": "१-४१-२४", "content_sanskrit": "अशीतियोजनायामं चत्वारिंशत्प्रविस्तरम् ।\nएकैकयक्षभवनं महाभवनमालिनम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001544024, "chapter_id": 21544, "verse_number": "१-४१-२५", "content_sanskrit": "महायक्षालयान्यत्र त्रिंशदाढ्यानि मे श्रृणु ।\nमुदाऽथ परमद्धर्या च संयुक्तानि समन्ततः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001544025, "chapter_id": 21544, "verse_number": "१-४१-२६", "content_sanskrit": "महामालिसुनेत्राद्यास्तथा मणिवरादयः ।\nउदीर्णा यक्षराजानस्तत्र त्रिंशत्सदा बभुः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001544026, "chapter_id": 21544, "verse_number": "१-४१-२७", "content_sanskrit": "इत्येते कथिता यक्षा वाय्वग्निसमतेजसः ।\nयेषामधिपतिर्देवः श्रीमान् वैश्रवणः प्रभुः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001544027, "chapter_id": 21544, "verse_number": "१-४१-२८", "content_sanskrit": "तस्यैव दक्षिणे पार्श्वे हिमवत्यचलोत्तमे ।\nनिकुञ्जनिर्झरगुहानैकसानुदरीतटे ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001544028, "chapter_id": 21544, "verse_number": "१-४१-२९", "content_sanskrit": "अर्णवादर्णवं यावत् पूर्वपश्चायतेऽचले ।\nकिन्नराणां पुरशतं निविष्टं वै व्कचित् व्कचित् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001544029, "chapter_id": 21544, "verse_number": "१-४१-३०", "content_sanskrit": "नैकश्रृङ्गकलापस्य शैलराजस्य कुक्षिषु ।\nनरनारीप्रमुदितं हृष्टपुष्टजनाकुलम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001544030, "chapter_id": 21544, "verse_number": "१-४१-३१", "content_sanskrit": "द्रुमसुग्रीवसैन्याद्या भगदत्तपुरःसराः  ।\nयत्र राजशतं तेषां दीप्तानां बलशालिनाम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001544031, "chapter_id": 21544, "verse_number": "१-४१-३२", "content_sanskrit": "विवाहो यत्र रुद्रस्य महादेव्योमया सह ।\nतपस्तप्तवती चैव यत्र देवी वराङ्गना ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001544032, "chapter_id": 21544, "verse_number": "१-४१-३३", "content_sanskrit": "किरातरूपिणा चैव यत्र रुद्रेण क्रीडितम् ।\nयत्र चैव कृतं ताभ्यां जम्बूद्वीपावलोकनम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001544033, "chapter_id": 21544, "verse_number": "१-४१-३४", "content_sanskrit": "यत्र ताः सम्मुदा युक्ता नानाभूतगणैर्युताः ।\nचित्रपुष्पफलोपेता रुद्रस्याक्रीडभूमयः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001544034, "chapter_id": 21544, "verse_number": "१-४१-३५", "content_sanskrit": "हृष्टा गिरिदरीवासाः कृशोदर्य्यो मनोरमाः ।\nकुन्दर्यो यत्र किन्नर्य्यो रमन्ते स्म सुलोचनाः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001544035, "chapter_id": 21544, "verse_number": "१-४१-३६", "content_sanskrit": "विशालाक्षास्तथा यक्षा अन्याश्चाप्सरसाङ्गणाः ।\nगन्धर्वाश्चाङ्गशालिन्यो यत्र तत्र मुदा युताः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001544036, "chapter_id": 21544, "verse_number": "१-४१-३७", "content_sanskrit": "तत्रैवोमावनं नाम सर्वलोकेषु विश्रुतम् ।\nअर्धनारीनरं रुपं धृतवान् यत्र शंकरः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001544037, "chapter_id": 21544, "verse_number": "१-४१-३८", "content_sanskrit": "तथा शरवणं नाम यत्र जातः षडाननः  ।\nयत्र चैव कृतोत्साहः क्रौञ्चशैलवनं प्रति ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001544038, "chapter_id": 21544, "verse_number": "१-४१-३९", "content_sanskrit": "ध्वजापताकिनञ्चैव किङ्किणीजालमालिनम् ।\nयत्र सिंहरथं युक्तं कार्तिकेयस्य धीमतः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001544039, "chapter_id": 21544, "verse_number": "१-४१-४०", "content_sanskrit": "चित्रपुष्पनिकुञ्जस्य क्रौञ्चस्य च गिरेस्तटे ।\nदेवारिस्कन्दनः स्कन्दो यत्र शक्तिं विमुक्तवान् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001544040, "chapter_id": 21544, "verse_number": "१-४१-४१", "content_sanskrit": "यत्राभिषिक्तश्च गुहः सेन्द्रोपेन्द्रैः सुरोत्तमैः ।\nसेनापत्ये च दैत्यारिर्द्वादशार्कप्रतापवान् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001544041, "chapter_id": 21544, "verse_number": "१-४१-४२", "content_sanskrit": "भूतसङ्घावकीर्णानि एतान्यन्यानि च द्विजाः ।\nतत्र तत्र कुमारस्य स्थानान्यायतनानि च ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001544042, "chapter_id": 21544, "verse_number": "१-४१-४३", "content_sanskrit": "तथा पाण्डुशिला नाम ह्याक्रीडा क्रौञ्चघातिनः ।\nनानाभूतगणाकीर्णे पृष्ठे हिमवतः शुभे ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001544043, "chapter_id": 21544, "verse_number": "१-४१-४४", "content_sanskrit": "तस्य पूर्वे तटे रम्ये सिद्धावासमुदाहृतम् ।\nकलापग्राममित्येवं नाम्ना ख्यातं मनीषिभिः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001544044, "chapter_id": 21544, "verse_number": "१-४१-४५", "content_sanskrit": "मृकण्डस्य वसिष्ठस्य भरतस्य नलस्य च ।\nविश्वामित्रस्य विप्रर्षेस्तथैवोद्दालकस्य च ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001544045, "chapter_id": 21544, "verse_number": "१-४१-४६", "content_sanskrit": "अन्येषाञ्चोग्रतपसामृषीणां भावितात्मनाम् ।\nहिमवत्याश्रमाणाञ्च सहस्राणि शतानि च ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001544046, "chapter_id": 21544, "verse_number": "१-४१-४७", "content_sanskrit": "नैकसिध्दगणावासं स्थानायतनमण्डितम् ।\nयक्षगन्धर्वचरितं नानाम्लेच्छगणैर्युतम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001544047, "chapter_id": 21544, "verse_number": "१-४१-४८", "content_sanskrit": "नानारत्नाकरापूर्णं नानासत्त्वनिषेवितम् ।\nनानानदीसहस्राणां सम्भवं वरपर्वतम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001544048, "chapter_id": 21544, "verse_number": "१-४१-४९", "content_sanskrit": "पश्चिमस्याचलेन्द्रस्य निषधस्य यथार्थवत् ।\nकीर्त्त्यमानमशेषेण विशेषं श्रृणुत द्विजाः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001544049, "chapter_id": 21544, "verse_number": "१-४१-५०", "content_sanskrit": "विस्तीर्णे मध्यमे कूटे हेमधा तुविबूषिते ।\nदीप्तमायतनं विष्णोः सिद्धर्षिगणसेवितम् ।\nयक्षाप्सरःसमाकीर्णं गन्धर्वगणसेवितम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001544050, "chapter_id": 21544, "verse_number": "१-४१-५१", "content_sanskrit": "तत्र साक्षान्महादेवः पीताम्बरधरो हरिः ।\nवरदः सेव्यते सिर्द्धैर्लोककर्त्ता सनातनः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001544051, "chapter_id": 21544, "verse_number": "१-४१-५२", "content_sanskrit": "तस्यैवाब्यन्तरे कूटे नानाधातुविभूषिते ।\nतटे निषधकूटस्य श्लक्ष्णचारुशिलातले ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001544052, "chapter_id": 21544, "verse_number": "१-४१-५३", "content_sanskrit": "रुक्मकाञ्चननिर्यूहं तप्तकाञ्चनतोरणम् ।\nअनेकवलभीकूटप्रलोलीशतसङ्कटम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001544053, "chapter_id": 21544, "verse_number": "१-४१-५४", "content_sanskrit": "हर्म्यप्रासादमतुलं तप्तकाञ्चनभूषितम् ।\nहर्म्यप्रासादबद्धञ्च मुदितञ्चातिविस्तरम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001544054, "chapter_id": 21544, "verse_number": "१-४१-५५", "content_sanskrit": "उद्यानमालाकलितं त्रिंशद्योजनमायतम् ।\nदुःप्रसह्यममित्रैस्तत् पूर्णमाशीविषोपमैः ।\nउलङ्घीनां प्रमुदितं रक्षसां राक्षसं पुरम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001544055, "chapter_id": 21544, "verse_number": "१-४१-५६", "content_sanskrit": "तस्यैव दक्षिणे पार्श्वे नैकदैत्यगणालये ।\nगुहाप्रवेशं नगरं शैलकुक्षौ दुरासदम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001544056, "chapter_id": 21544, "verse_number": "१-४१-५७", "content_sanskrit": "तथैव पश्चिमे कूटे पारिजातशिलोच्चये ।\nदेवदानवभागानां समृद्धानि पुराणि तु ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001544057, "chapter_id": 21544, "verse_number": "१-४१-५८", "content_sanskrit": "तत्र सोमशिला नाम गिरेस्तस्य महातटे ।\nसोमो यत्रावतरति सदा पर्वसु पर्वसु ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001544058, "chapter_id": 21544, "verse_number": "१-४१-५९", "content_sanskrit": "उपासतेऽत्र श्रीमन्तं तारा पतिमनिन्दितम् ।\nऋषिकिन्नरगन्धर्वाः साक्षाद्देवं तमोनुदम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001544059, "chapter_id": 21544, "verse_number": "१-४१-६०", "content_sanskrit": "तत्रैव चोत्तरे कूटे ब्रह्मपार्श्वमिति स्मृतम् ।\nस्थानं तत्र सुरेशस्य ब्रह्मणः प्रथितं दिवि ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001544060, "chapter_id": 21544, "verse_number": "१-४१-६१", "content_sanskrit": "इज्यापूजानमस्कारैस्तत्र सिद्धाः स्वयम्भुवम् ।\nउपासते महात्मानं यक्षगन्धर्वदानवाः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001544061, "chapter_id": 21544, "verse_number": "१-४१-६२", "content_sanskrit": "तथैवायतनं वह्नेः सर्वलोकेषु विश्रुतम् ।\nतत्र विग्रहवान् वाह्निः सेव्यते सिद्धचारणैः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001544062, "chapter_id": 21544, "verse_number": "१-४१-६३", "content_sanskrit": "तथैव चोत्तरे रम्ये त्रिश्रृङ्गे वरपर्वते ।\nऋषिसिद्धानुचरिते नानाभूतगणालये ।\nपुरं तत् त्रिषु लोकेषु हेमचित्रन्तु विश्रुतम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001544063, "chapter_id": 21544, "verse_number": "१-४१-६४", "content_sanskrit": "त्रयाणां देवमुख्यानां त्रीण्येवायतनानि च ।\nनारायणस्यायतनं पूर्वकूटे द्विजोत्तमाः  ।\nमध्यमे ब्रह्मणः स्थानं शङ्करस्य तु पश्चिमे ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001544064, "chapter_id": 21544, "verse_number": "१-४१-६५", "content_sanskrit": "दैत्यदानवगन्धर्वैर्यक्षराक्षसपन्नगैः ।\nइजाना अभिपूज्यन्ते देवदेवा महाबलाः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001544065, "chapter_id": 21544, "verse_number": "१-४१-६६", "content_sanskrit": "तथा पुराणि रम्याणि देशे चैव व्कचित् व्कचित् ।\nयक्षगन्धर्वनागानां त्रिश्रृङ्गे वरपर्वते ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001544066, "chapter_id": 21544, "verse_number": "१-४१-६७", "content_sanskrit": "तथैव चोत्तरे देशे चारुधौ देवपर्वते ।\nअनेकश्रृङ्गकलिते सिद्धसाधु निषेविते ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001544067, "chapter_id": 21544, "verse_number": "१-४१-६८", "content_sanskrit": "यक्षाणां किन्नराणाञ्च गन्धर्वाणां सहस्रशः ।\nनागानां राक्षसानाञ्च दैत्यानाञ्च महाबले ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001544068, "chapter_id": 21544, "verse_number": "१-४१-६९", "content_sanskrit": "कूटे तु मध्यमे तस्य सिद्धसङ्घ निषेविते ।\nरम्ये देवर्षिचरिते रत्नधातुविभूषिते ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001544069, "chapter_id": 21544, "verse_number": "१-४१-७०", "content_sanskrit": "पझोत्पलवनैः फुल्लैः सौगन्धिकवनैस्तथा ।\nतथा कुमुदखण्डैश्च विकचैरुपशोभिते ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001544070, "chapter_id": 21544, "verse_number": "१-४१-७१", "content_sanskrit": "विहङ्गसङ्घसंघुष्टं नानासत्वनिषेवितम् ।\nहंसकारण्डवाकीर्णं मत्तषट्‌पदसेवितम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7001544071, "chapter_id": 21544, "verse_number": "१-४१-७२", "content_sanskrit": "नानासत्वगणाकीर्णं विहङ्गैरुपशोभितम् ।\nचारुतीर्थसुसम्बाधं त्रिंशद्योजनमण्डलम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7001544072, "chapter_id": 21544, "verse_number": "१-४१-७३", "content_sanskrit": "सिद्धैरुपस्पृष्टजलं जलदोषविवर्जितम् ।\nतत्रानन्दजलन्नाम महापुण्यजलं सरः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7001544073, "chapter_id": 21544, "verse_number": "१-४१-७४", "content_sanskrit": "तत्र नागपति श्चण्ड श्चण्डो नाम दुरासदः ।\nशतशीर्षा महाभागो विष्णुचक्राङ्कचिह्नितः ।\nइत्येवमष्टौ विज्ञेया विचित्रा देवपर्वताः॥७३॥ ।\nपुरैरायतनैः पुण्यैः पुण्योदैश्च सरोवरैः ।\nसुवर्णपर्वतैर्नैकैस्तथा रजतपर्वतैः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7001544074, "chapter_id": 21544, "verse_number": "१-४१-७५", "content_sanskrit": "नानारत्नप्रभासैश्च नैकैश्च मणिपर्वतैः ।\nहरितालपर्वतैर्नैकैस्तथा हिङ्गुलकाञ्चनैः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7001544075, "chapter_id": 21544, "verse_number": "१-४१-७६", "content_sanskrit": "शुद्धैर्मनः शिलाजालैर्भास्वरैररुणप्रभैः  ।\nनानाधातुविचित्रैश्च नैकैश्च मणिपर्वतैः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7001544076, "chapter_id": 21544, "verse_number": "१-४१-७७", "content_sanskrit": "पूर्णा वसुमती सर्वा गिरिभिर्नैकविस्तरैः ।\nनदीकन्दरशैलाद्यैरनेकैश्चित्रसानुभिः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7001544077, "chapter_id": 21544, "verse_number": "१-४१-७८", "content_sanskrit": "इत्येवमचलैर्युक्तैर्दैत्यराक्षससाधुभिः ।\nकिन्नरोरगगन्धर्वैर्विचित्रैः सिद्धचारणैः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7001544078, "chapter_id": 21544, "verse_number": "१-४१-७९", "content_sanskrit": "गन्धर्वैरप्सरोभिश्च सेविता नैक विस्तराः ।\nपुण्यकृद्भिः समाकीर्णा केसराकृतयो नगाः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7001544079, "chapter_id": 21544, "verse_number": "१-४१-८०", "content_sanskrit": "गिरिजालन्तु तन्मेरोः सिद्धलोकमिति स्मृतम् ।\nचित्रं नानाश्रयोपेतं प्रचारं सुकृतात्मनाम् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7001544080, "chapter_id": 21544, "verse_number": "१-४१-८१", "content_sanskrit": "नात्युग्रकर्मसिद्धानां प्रतिमा मध्यमाः स्मृताः ।\nस हि स्वर्ग इति ख्यातः क्रमस्त्वेष प्रकीर्तितः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7001544081, "chapter_id": 21544, "verse_number": "१-४१-८२", "content_sanskrit": "चतुर्महाद्वीपवती सेयमुर्वी प्रकीर्तिता ॥\nनानावर्णप्रमाणैर्हि नानावर्णबलैस्तथा ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7001544082, "chapter_id": 21544, "verse_number": "१-४१-८३", "content_sanskrit": "नानाभक्ष्यान्नपानैश्च नानाच्छादनभूषणैः ।\nप्रजाविकारैर्विविधैश्चित्रैरध्युषितैः सह ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7001544083, "chapter_id": 21544, "verse_number": "१-४१-८४", "content_sanskrit": "चत्वारो नैकवर्णाद्या महाद्वीपाः परिश्रुताः ।\nभद्राश्च भरताश्चैव केतुमालाश्च पश्चिमाः ।\nउत्तराः कुरवश्चैव कृतपुण्यप्रतिश्रयाः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7001544084, "chapter_id": 21544, "verse_number": "१-४१-८५", "content_sanskrit": "सैषा चतुर्महाद्वीपा नानाद्वीपसमाकुला ।\nपृथिवी कीर्तिता कृत्स्ना पद्माकारा मया द्विजाः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7001544085, "chapter_id": 21544, "verse_number": "१-४१-८६", "content_sanskrit": "तदेषा सान्तरद्वीपा सशैलवनकानना ।\nपद्मेत्यभिहिता कृत्स्ना पृथिवी बहुविस्तरा ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7001544086, "chapter_id": 21544, "verse_number": "१-४१-८७", "content_sanskrit": "सब्रह्मसदनं लोकं सदेवासुरमानुषम् ।\nत्रिलोकमिति विख्यातं यत्सत्त्वैर्व्यवहार्यते ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7001544087, "chapter_id": 21544, "verse_number": "१-४१-८८", "content_sanskrit": "चन्द्रादित्यावतप्तं यत्तज्जगत् परिगीयते ।\nगन्धवर्णरसोपेतं शब्दस्पर्शगुणान्वितम् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7001544088, "chapter_id": 21544, "verse_number": "१-४१-८९", "content_sanskrit": "तं लोकपद्मं श्रुतिभिः पद्ममित्यभिधीयते ।\nएष सर्वपुराणेषु क्रमः सुपरिनिश्चितः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7001544089, "chapter_id": 21544, "verse_number": "१-४१-९०", "content_sanskrit": "इति श्रीमहापुराणे वायुप्रोक्ते भुवनविन्यासो नामैकचत्वारिंशोऽध्यायः ॥ ४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}]