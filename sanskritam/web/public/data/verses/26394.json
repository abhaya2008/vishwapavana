[{"id": 7006394000, "chapter_id": 26394, "verse_number": "२-५१-१", "content_sanskrit": "भीष्मक उवाच\nपुत्रो मे बाल भावेन भगिनीं दातुमिच्छति ।\nस्वयंवरे नरेन्द्राणां न चाहं दातुमुत्सहे ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006394001, "chapter_id": 26394, "verse_number": "२-५१-२", "content_sanskrit": "अतीव बालभावत्वाद् दातुमिच्छेन्मतिर्मम ।\nएका ह्येकं समालोक्य वरयिष्यति मे मतिः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006394002, "chapter_id": 26394, "verse_number": "२-५१-३", "content_sanskrit": "अतः प्रसादयिष्ये त्वां पुत्रदुर्नयहेतुना ।\nप्रसादं कुरु देवेश क्षन्तुमर्हसि मे प्रभो ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006394003, "chapter_id": 26394, "verse_number": "२-५१-४", "content_sanskrit": "श्रीकृष्ण उवाच\nबालभावेन पुत्रेण चालितं नृपमण्डलम् ।\nयदा भवति वै प्रौढः कीदृशोऽविनयो भवेत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006394004, "chapter_id": 26394, "verse_number": "२-५१-५", "content_sanskrit": "सूर्येन्दुसदृशाँल्लोकांस्तपसोपार्जितश्रियः ।\nलोकेऽस्मिन् नरदेवानां महाकुलसमुद्भवान् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006394005, "chapter_id": 26394, "verse_number": "२-५१-६", "content_sanskrit": "एकस्यापि नृपस्याग्रे मोहाद् यो वितथं वदेत् ।\nन स तिष्ठति लोकेऽस्मिन्निर्दहेद्दण्डवह्निना ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006394006, "chapter_id": 26394, "verse_number": "२-५१-७", "content_sanskrit": "एष धर्मो नरेन्द्राणामिति ते विदितं प्रभो ।\nलोकधर्मं पुरस्कृत्य पुरा गीतं स्वयम्भुवा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006394007, "chapter_id": 26394, "verse_number": "२-५१-८", "content_sanskrit": "कथं तव सुतस्तेषामग्रतो मनुजेश्वर ।\nवक्तुमर्हति राजेन्द्र वितथं राजसंसदि ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006394008, "chapter_id": 26394, "verse_number": "२-५१-९", "content_sanskrit": "तादृशं रङ्गमतुलं कारयंस्तनयस्तव ।\nकथं त्वया ह्यविज्ञात इति मे संशयो महान् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006394009, "chapter_id": 26394, "verse_number": "२-५१-१०", "content_sanskrit": "आगतानां नरेन्द्राणामनलार्केन्दुवर्चसाम् ।\nयथार्हेण तु सम्पूज्य आतिथ्यं कृतवानसि ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006394010, "chapter_id": 26394, "verse_number": "२-५१-११", "content_sanskrit": "रथाश्वनरनागानां विमर्दमतुलं तथा ।\nकथं न ज्ञातवान् राजंस्तव पुत्रस्य चेष्टितम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006394011, "chapter_id": 26394, "verse_number": "२-५१-१२", "content_sanskrit": "विषादो न भवेदत्र चतुरङ्गबलागमे ।\nकथं न ज्ञायते राजन्निति मे बुद्धिसंशयः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006394012, "chapter_id": 26394, "verse_number": "२-५१-१३", "content_sanskrit": "ममागमनमेवेह प्रायेण न हितं तव ।\nअतो न कृतमातिथ्यमपात्राय नरेश्वर ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006394013, "chapter_id": 26394, "verse_number": "२-५१-१४", "content_sanskrit": "पात्रेभ्यो दीयतां कन्या मामपास्य नरेश्वर ।\nममागमनदोषेण कथं कन्यां न दास्यसे ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006394014, "chapter_id": 26394, "verse_number": "२-५१-१५", "content_sanskrit": "कन्याविघ्नं च कुर्वाणो नरके परिपच्यते ।\nइति धर्मविदैर्गीतं मन्वादिभिर्नरोत्तमैः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006394015, "chapter_id": 26394, "verse_number": "२-५१-१६", "content_sanskrit": "अतोऽर्थं न प्रविष्टोऽहं रङ्गमध्ये विशाम्पते ।\nविदित्वा न कृतातिथ्यं नरदेव तवालयम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006394016, "chapter_id": 26394, "verse_number": "२-५१-१७", "content_sanskrit": "ह्रियाभिभूतो राजेन्द्र पार्थिवोऽहं नराधिप ।\nविदर्भनगरे राजन् बलविश्रामहेतुना ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006394017, "chapter_id": 26394, "verse_number": "२-५१-१८", "content_sanskrit": "आवाभ्यां कृतमातिथ्यं कैशिकस्तु प्रियातिथिः ।\nउषितौ च यथा स्वर्गे पुरा गरुडकेशवौ ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006394018, "chapter_id": 26394, "verse_number": "२-५१-१९", "content_sanskrit": "वैशम्पायन उवाच\nएवमेव ब्रुवाणं तु कृष्णं वाग्वज्रचोदितम् ।\nश्लक्ष्णवाचाम्बुनाऽऽसिच्य शमितोऽग्निरिव ज्वलन् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006394019, "chapter_id": 26394, "verse_number": "२-५१-२०", "content_sanskrit": "भीष्मक उवाच\nप्रसीद देवलोकेश पाहि मां लोकशासन ।\nअज्ञानतमसाविष्टं ज्ञानचक्षुःप्रदो भव ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006394020, "chapter_id": 26394, "verse_number": "२-५१-२१", "content_sanskrit": "मानुष्ये मांसचक्षुष्ट्वादसम्यग्विदिता वयम् ।\nन प्रसिद्ध्यन्ति कर्माणि क्रियतामविचारणात् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006394021, "chapter_id": 26394, "verse_number": "२-५१-२२", "content_sanskrit": "भवन्तं शरणं प्राप्य देवानामपि दैवतम् ।\nसम्यग् भवतु मे दृष्टिः सम्पश्यन्तु च मे क्रियाः॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006394022, "chapter_id": 26394, "verse_number": "२-५१-२३", "content_sanskrit": "अनिष्पन्नामपि क्रियां नयोपेतां विचक्षणाः ।\nफलदां हि प्रकुर्वन्ति महासेनापतिर्यथा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006394023, "chapter_id": 26394, "verse_number": "२-५१-२४", "content_sanskrit": "भवन्तं शरणं प्राप्य नाति बाधति मे भयम् ।\nयन्मया चिन्तितं कार्य तद् भवाञ्छ्रोतुमर्हति ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006394024, "chapter_id": 26394, "verse_number": "२-५१-२५", "content_sanskrit": "न दातुमिच्छे कन्यां वै पार्थिवेभ्यः स्वयंवरे ।\nप्रसादं कुरु देवेश न कोपं कर्तुमर्हसि ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006394025, "chapter_id": 26394, "verse_number": "२-५१-२६", "content_sanskrit": "श्रीकृष्ण उवाच\nवचनेन किमुक्तेन त्वया राजन् महामते ।\nस्वकन्यां दास्यसे नेति कोऽत्र नेता तवानघ ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006394026, "chapter_id": 26394, "verse_number": "२-५१-२७", "content_sanskrit": "मा देहीति न चाख्येयं ददस्वेति न मे वचः ।\nरुक्मिण्या दिव्यमूर्तित्वं सम्बन्धे कारणं मम ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006394027, "chapter_id": 26394, "verse_number": "२-५१-२८", "content_sanskrit": "मेरुकूटे पुरा देवैः कृतमंशावतारणम् ।\nतदा निसृष्टा श्रीः पूर्वं गच्छ त्वं पतिना सह ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006394028, "chapter_id": 26394, "verse_number": "२-५१-२९", "content_sanskrit": "मानुष्ये कुण्डिनगरे भीष्मकस्याङ्गनोदरे ।\nजायस्व विपुलश्रोणि प्रत्यवेक्ष्य च वासवम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006394029, "chapter_id": 26394, "verse_number": "२-५१-३०", "content_sanskrit": "तेनाहं वः प्रवक्ष्यामि राजन्नकृतकं वचः ।\nश्रुत्वा स्वयं विनिश्चित्य यद्युक्तं तत्करिष्यति ॥३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006394030, "chapter_id": 26394, "verse_number": "२-५१-३१", "content_sanskrit": "रुक्मिणी नाम ते कन्या न सा प्राकृतमानुषी ।\nश्रीरेषा ब्रह्मवाक्येन जाता केनापि हेतुना ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006394031, "chapter_id": 26394, "verse_number": "२-५१-३२", "content_sanskrit": "न च सा मनुजेन्द्राणां स्वयंवरविधिक्षमा ।\nएका त्वेकाय दातव्या इति धर्मो व्यवस्थितः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006394032, "chapter_id": 26394, "verse_number": "२-५१-३३", "content_sanskrit": "न च तां शक्यसे राजँल्लक्ष्मीं दातुं स्वयंवरे ।\nसदृशं वरमालोक्य दातुमर्हसि धर्मतः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006394033, "chapter_id": 26394, "verse_number": "२-५१-३४", "content_sanskrit": "अतोऽर्थं वैनतेयोऽयं विघ्नकारणहेतुना ।\nआगतः कुण्डिनगरे देवराजेन चोदितः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006394034, "chapter_id": 26394, "verse_number": "२-५१-३५", "content_sanskrit": "अहं चैवागतो राज्ञां द्रष्टुकामो महोत्सवम् ।\nतां च कन्यां वरारोहां पद्मेन रहितां श्रियम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006394035, "chapter_id": 26394, "verse_number": "२-५१-३६", "content_sanskrit": "क्षन्तव्यमिति यत् प्रोक्तं त्वया राजन् ममाग्रतः।\nयुक्तिपूर्वमहं मन्ये कलुषाय न पार्थिव ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006394036, "chapter_id": 26394, "verse_number": "२-५१-३७", "content_sanskrit": "पूर्वमेव मयाऽऽख्यातं येनास्मि विषये तव ।\nआगतः सौम्यरूपेण तेनैव क्षान्तवान् विभो ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006394037, "chapter_id": 26394, "verse_number": "२-५१-३८", "content_sanskrit": "क्षान्तेषु गुणबाहुल्यं दोषापहरणं क्षमा ।\nकथमस्मद्विधे राजन् कलुषो वसते हृदि ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006394038, "chapter_id": 26394, "verse_number": "२-५१-३९", "content_sanskrit": "कुलजे सत्त्वसम्पन्ने धर्मज्ञे सत्यवादिनि ।\nभवादृशे कथं राजन् कलुषो भुवि वर्तते ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006394039, "chapter_id": 26394, "verse_number": "२-५१-४०", "content_sanskrit": "क्षान्तोऽयमिति मन्तव्यं मम सेनासहागतम् ।\nन चाहं सेनया सार्द्धं यास्यामि रिपुवाहिनीम् ॥४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006394040, "chapter_id": 26394, "verse_number": "२-५१-४१", "content_sanskrit": "अक्षान्तश्चारिसेनायां यास्यामि द्विजवाहने ।\nस्थितः सोमार्कसंकाशान्यायुधानि करैर्वहन् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006394041, "chapter_id": 26394, "verse_number": "२-५१-४२", "content_sanskrit": "मान्योऽस्माकं त्वया राजन् वयसा च पिता समः ।\nपालयस्व पुरीं सम्यक्क्षत्रेषु पितृवद् वस ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006394042, "chapter_id": 26394, "verse_number": "२-५१-४३", "content_sanskrit": "कलुषो नाम राजेन्द्र वसेत् कापुरुषेषु वै ।\nशूरेषु शुद्धभावेषु कलुषो वसते कथम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006394043, "chapter_id": 26394, "verse_number": "२-५१-४४", "content_sanskrit": "जानीध्वमेषा मे वृत्तिः पुत्रेषु पितृवद् वयम् ।\nइमावपि च राजानौ विदर्भनगराधिपौ ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006394044, "chapter_id": 26394, "verse_number": "२-५१-४५", "content_sanskrit": "आतिथ्यकरणेऽस्माकं स्वराज्यं ददतावुभौ ।\nतेन दानफलेनास्य दशपूर्वा दिवं गताः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006394045, "chapter_id": 26394, "verse_number": "२-५१-४६", "content_sanskrit": "भविष्याश्चैव राजानः पुत्रपौत्रा दशावराः ।\nतेऽपि तत्रैव यास्यन्ति देवलोकं नराधिपाः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006394046, "chapter_id": 26394, "verse_number": "२-५१-४७", "content_sanskrit": "अनयोः सुचिरं कालं भुक्त्वा राज्यमकण्टकम् ।\nयदाभिलाषो मोक्षस्य यास्येते निर्वृतिं सुखम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006394047, "chapter_id": 26394, "verse_number": "२-५१-४८", "content_sanskrit": "नरेन्द्राश्च महाभागा येऽभिषेचितुमागताः ।\nकालेन तेऽपि यास्यन्ति देवलोकं त्रिविष्टपम् । ४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006394048, "chapter_id": 26394, "verse_number": "२-५१-४९", "content_sanskrit": "स्वस्ति वोऽस्तु गमिष्यामि वैनतेयसहायवान् ।\nनगरीं मथुरां रम्यां भोजराजेन पालिताम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006394049, "chapter_id": 26394, "verse_number": "२-५१-५०", "content_sanskrit": "वैशम्पायन उवाच\nएवमुक्त्वा तु राजानं भीष्मकं यदुनन्दनः ।\nराज्ञश्चैवमुपामन्त्र्य वैदर्भाभ्यां विशेषतः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006394050, "chapter_id": 26394, "verse_number": "२-५१-५१", "content_sanskrit": "सभान्निष्क्रम्य देवेशो जगाम रथमन्तिकम् ।\nततः प्रहृष्टो राजर्षिर्भीष्मकः किल केशवम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006394051, "chapter_id": 26394, "verse_number": "२-५१-५२", "content_sanskrit": "ते सर्वे च महीपाला विषण्णवदनाभवन् ।\nआद्यं स्वायम्भुवं रूपं सुरासुरनमस्कृतम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006394052, "chapter_id": 26394, "verse_number": "२-५१-५३", "content_sanskrit": "सहस्रपात्सहस्राक्षं सहस्रभुजविग्रहम् ।\nसहस्रशिरसं देवं सहस्रमुकुटोज्ज्वलम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006394053, "chapter_id": 26394, "verse_number": "२-५१-५४", "content_sanskrit": "दिव्यमाल्याम्बरधरं दिव्यगन्धानुलेपनम् ।\nदिव्याभरणसंयुक्तं दिव्यानेकोद्यतायुधम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006394054, "chapter_id": 26394, "verse_number": "२-५१-५५", "content_sanskrit": "कृष्णं रक्तारविन्दाक्षं चन्द्रसूर्याग्निलोचनम् ।\nदृष्ट्वा स राजा राजेन्द्रं प्रणिपत्य कृताञ्जलिः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006394055, "chapter_id": 26394, "verse_number": "२-५१-५६", "content_sanskrit": "वाङ्मनःकायसंयुक्तं स्तोतुमारब्धवांस्तदा ।\nभीष्मक उवाच\nदेवदेव नमस्तुभ्यमनादिनिधनाय वै ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006394056, "chapter_id": 26394, "verse_number": "२-५१-५७", "content_sanskrit": "शाश्वतायादिदेवाय नारायण परायण ।\nस्वयम्भुवे च विश्वाय स्थाणवे वेधसाय च ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006394057, "chapter_id": 26394, "verse_number": "२-५१-५८", "content_sanskrit": "पद्मनाभाय जटिने दण्डिने पिङ्गलाय च ।\nहंसप्रभाय हंसाय चक्ररूपाय वै नमः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006394058, "chapter_id": 26394, "verse_number": "२-५१-५९", "content_sanskrit": "वैकुण्ठाय नमस्तस्मै अजाय परमात्मने ।\nसदसद्भावयुक्ताय पुराणपुरुषाय च ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006394059, "chapter_id": 26394, "verse_number": "२-५१-६०", "content_sanskrit": "पुरुषोत्तमाय युक्ताय निर्गुणाय नमोऽस्तु ते ।\nवरदो भव मे नित्यं त्वद्भक्ताय सुरोत्तम ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006394060, "chapter_id": 26394, "verse_number": "२-५१-६१", "content_sanskrit": "लोकनाथोऽसि नाथ त्वं विष्णुस्त्वं विदितात्मनाम् ।\nवैशम्पायन उवाच\nएवं स्तुत्वा महादेवं नृपाणामग्रतो नृपः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006394061, "chapter_id": 26394, "verse_number": "२-५१-६२", "content_sanskrit": "महार्हमणिमुक्ताभिर्वज्रवैदूर्यहासिनम् ।\nशातकुम्भस्य निचयं कृष्णाय प्रददौ नृपः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006394062, "chapter_id": 26394, "verse_number": "२-५१-६३", "content_sanskrit": "पुनश्चक्रे नमस्कारं वैनतेये महाबले ।\nभीष्मक उवाच\nनमस्तस्मै खगेन्द्राय नमो मारुतरंहसे ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006394063, "chapter_id": 26394, "verse_number": "२-५१-६४", "content_sanskrit": "कामरूपाय दिव्याय काश्यपाय च वै नमः ।\nवैशम्पायन उवाच\nइति संक्षेपतः स्तुत्वा सत्कृत्य वरभूषणैः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006394064, "chapter_id": 26394, "verse_number": "२-५१-६५", "content_sanskrit": "ततो विसर्जयामास कृष्णं कमललोचनम् ।\nअनुजग्मुर्नृपाश्चैव प्रस्थितं वासवानुजम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006394065, "chapter_id": 26394, "verse_number": "२-५१-६६", "content_sanskrit": "प्रतिगृह्य च सत्कारं नृपानामन्त्र्य वीर्यवान् ।\nजगाम मथुरां कृष्णो द्योतयानो दिशो दश ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006394066, "chapter_id": 26394, "verse_number": "२-५१-६७", "content_sanskrit": "वैनतेयं पुरस्कृत्य सौम्यरूपं खगोत्तमम् ।\nमहता रथवृन्देन परिवार्य समन्ततः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006394067, "chapter_id": 26394, "verse_number": "२-५१-६८", "content_sanskrit": "भेरीपटहनादेन शङ्खदुन्दुभिनिःस्वनैः ।\nबृंहितेन च नागानां हयानां हेषितेन च ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006394068, "chapter_id": 26394, "verse_number": "२-५१-६९", "content_sanskrit": "सिंहनादेन शूराणां रथनेमिस्वनेन च ।\nतुमुलः सुमहानासीन्महामेघरवोपमः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006394069, "chapter_id": 26394, "verse_number": "२-५१-७०", "content_sanskrit": "गते कृष्णे महावीर्ये आदाय वरमासनम् ।\nसभामादाय देवाश्च प्रययुस्त्रिदशालयम् ॥७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006394070, "chapter_id": 26394, "verse_number": "२-५१-७१", "content_sanskrit": "महता चतुरङ्गेण बलेन परिवारिताः ।\nक्रोशमात्रमुपव्रज्य अनुज्ञाते जनार्दने ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006394071, "chapter_id": 26394, "verse_number": "२-५१-७२", "content_sanskrit": "प्रययुस्ते नृपाः सर्वे पुनरेव स्वयंवरम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}]