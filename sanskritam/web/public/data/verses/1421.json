[{"id": 2020105, "chapter_id": 1421, "verse_number": "३-५९-०x", "content_sanskrit": "बृहदश्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2020106, "chapter_id": 1421, "verse_number": "३-५९-१", "content_sanskrit": "`इत्युक्तः स तदा देव्या नलो वचनमब्रवीत्।\nयथा राज्यंतव पितुस्तथा मम नसंशयः।\nन तु तत्र गमिष्यामि विषमस्थः कथंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2020107, "chapter_id": 1421, "verse_number": "३-५९-२", "content_sanskrit": "कथं समृद्धो गत्वाऽहं तव हर्षविवर्धनः।\nपरिद्यूनो गमिष्यामि तव शोकविवर्धनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2020108, "chapter_id": 1421, "verse_number": "३-५९-३", "content_sanskrit": "इति ब्रुवन्नलो राजा दमयन्तीं पुनः पुनः।\nसान्खयामास कल्याणीं वाससोर्धेन संवृताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2020109, "chapter_id": 1421, "verse_number": "३-५९-४", "content_sanskrit": "तावेकवस्त्रसंवीतावटमानावितस्ततः।\nक्षुत्पिपासापरिश्रान्तौ सभां कांचिदुपेयतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2020110, "chapter_id": 1421, "verse_number": "३-५९-५", "content_sanskrit": "तां सभामुपसंप्राप्य तदा स निषधाधिपः।\nवैदर्भ्या सहितो राजा निषसाद महीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2020111, "chapter_id": 1421, "verse_number": "३-५९-६", "content_sanskrit": "स वै विवस्त्रो मलिनो विवर्णः पांसुगुण्ठितः।\nदमयन्त्या सह श्रान्तः सुष्वाप धरणीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2020112, "chapter_id": 1421, "verse_number": "३-५९-७", "content_sanskrit": "`ततः स्ववसनस्यान्तं दमयन्ती विशांपते।\nभूमावास्तीर्य सुष्वाप पतिमालिङ्ग्य शोभना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2020113, "chapter_id": 1421, "verse_number": "३-५९-८", "content_sanskrit": "दमयनत्यपि कल्याणी निद्रयाऽपहृता ततः।\nसहसा दुःखमासाद्य सुकुमारी तपस्विनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2020114, "chapter_id": 1421, "verse_number": "३-५९-९", "content_sanskrit": "सुप्तायां दमयन्त्यां तु नलो राजा विशांपते।\nशोकोन्मथितचित्तः सन्न स्म शेते यथा पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2020115, "chapter_id": 1421, "verse_number": "३-५९-१०", "content_sanskrit": "स तद्राज्यापहरणं सुहृत्त्यागं च सर्वशः।\nवने च तं परिध्वंसं प्रेक्ष्य चिन्तामुपेयिवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2020116, "chapter_id": 1421, "verse_number": "३-५९-११", "content_sanskrit": "किं नु मे स्यादिदं कृत्वा किंनु मे स्यादकुर्वतः।\nकिंनु मे मरणं श्रेयः परित्यागो जनस्य वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2020117, "chapter_id": 1421, "verse_number": "३-५९-१२", "content_sanskrit": "मामियं ह्यनुरक्तैवं दुःखमाप्नोति मत्कृते।\nमद्विहीना त्वियं गच्छेत्कदाचित्स्वजनं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2020118, "chapter_id": 1421, "verse_number": "३-५९-१३", "content_sanskrit": "मया निःसंशयं दुखमियं प्राप्स्यत्यनुव्रता।\nउत्सर्गेसंशयः स्यात्तु विन्देतापि सुखं क्वचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2020119, "chapter_id": 1421, "verse_number": "३-५९-१४x", "content_sanskrit": "बृहदश्च उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2020120, "chapter_id": 1421, "verse_number": "३-५९-१४", "content_sanskrit": "स विनिश्चित्य बहुधा विचार्य च पुनःपुनः।\nउत्सर्गेऽमन्यत श्रेयो दमयन्त्या नराधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2020121, "chapter_id": 1421, "verse_number": "३-५९-१५", "content_sanskrit": "न चैषा तेजसा शक्या कैश्चिद्धर्षयितुं पथि।\nयशस्विनी महाभागा मद्भक्तेयं पतिव्रता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2020122, "chapter_id": 1421, "verse_number": "३-५९-१६", "content_sanskrit": "एवं तस् तदा बुद्धिर्दमयन्त्यां न्यवर्तत।\nकलिना दुष्टभावेन दमयन्त्या विसर्जने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2020123, "chapter_id": 1421, "verse_number": "३-५९-१७", "content_sanskrit": "सोऽवस्त्रतामात्मनश्च तस्याश्चाप्येकवस्त्रताम्।\nचिन्तयित्वाऽध्यगाद्राजा वस्त्रार्धस्यावकर्तनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2020124, "chapter_id": 1421, "verse_number": "३-५९-१८", "content_sanskrit": "कथं वासो विकर्तेयं न च बुद्ध्येत मे प्रिया।\nविचिन्त्यैवं नलो राजा सभां पर्यचरत्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2020125, "chapter_id": 1421, "verse_number": "३-५९-१९", "content_sanskrit": "परिधावन्नथ नल इतश्चेतश्च भारत।\nआससाद सभोद्देशे विकोशं स्वङ्गमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2020126, "chapter_id": 1421, "verse_number": "३-५९-२०", "content_sanskrit": "तेनार्धं वाससश्छित्त्वा निवस् च परंतपः।\nसुप्तामुत्सृज्य वैदर्भीं प्राद्रवद्गतचेतनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2020127, "chapter_id": 1421, "verse_number": "३-५९-२१", "content_sanskrit": "ततो निबद्धहृदयः पुनरागम् तां सभाम्।\nदमयन्तीं तदा दृष्ट्वा रुरोद निषधाधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2020128, "chapter_id": 1421, "verse_number": "३-५९-२२", "content_sanskrit": "यां न वायुर्न चादित्यः पुरा पश्यति मे प्रियाम्।\nसेयमद्य सभामध्ये शेते भूमावनाथवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2020129, "chapter_id": 1421, "verse_number": "३-५९-२३", "content_sanskrit": "इयं वस्त्रावकर्तेन संवीता चारुहासिनी।\nउन्मत्तेव मया हीना कथं बुद्ध्वा भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2020130, "chapter_id": 1421, "verse_number": "३-५९-२४", "content_sanskrit": "कथमेका सती भमी मया विरहिता शुभा।\nचरिष्यति वने घोरे मृगव्यालनिषेविते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2020131, "chapter_id": 1421, "verse_number": "३-५९-२५", "content_sanskrit": "आदित्या वसवो रुद्रा अश्विनौ समरुद्गणौ।\nरक्षन्तु त्वां महाभागे धर्मेणासि समावृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2020132, "chapter_id": 1421, "verse_number": "३-५९-२६", "content_sanskrit": "एवमुक्त्वा प्रियां भार्यां रूपेणाप्रतिमां भुषि।\nकलिनाऽपहृतज्ञानो नलः प्रातिपष्ठदुद्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2020133, "chapter_id": 1421, "verse_number": "३-५९-२७", "content_sanskrit": "गत्वागत्वा नलो राजा पुनरेति सभां मुहुः।\nआकृष्यमाणः कलिना सौहृदेनावकृष्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2020134, "chapter_id": 1421, "verse_number": "३-५९-२८", "content_sanskrit": "द्विधेव हृदयं तस्य दुःखितस्याभवत्तदा।\nदोलेव मुहुरायाति याति चैव मुहुर्मुहुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2020135, "chapter_id": 1421, "verse_number": "३-५९-२९", "content_sanskrit": "अवकृष्टस्तु कलिना मोहितः प्राद्रवन्नलः।\nसुप्तामुत्सृज्य तां भार्यां विलप्य करुणं बहु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2020136, "chapter_id": 1421, "verse_number": "३-५९-३०", "content_sanskrit": "नष्टात्मा कलिनाऽऽविष्टस्तत्तद्विगणयन्मुहुः।\nजगामैकां वने शून्ये भार्यामुत्सृज्य मोहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2020137, "chapter_id": 1421, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि नलोपाख्यानपर्वणि एकोनषष्टितमोऽध्यायः ॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]