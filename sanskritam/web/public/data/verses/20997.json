[{"id": 7000997000, "chapter_id": 20997, "verse_number": "४-३-१", "content_sanskrit": "अतश्च मांधातुः पुत्रसंततिरभिधीयते ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000997001, "chapter_id": 20997, "verse_number": "४-३-२", "content_sanskrit": "अंबरीषस्य मांधातृतनयस्य युवनाश्वः पुत्रोऽभूत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000997002, "chapter_id": 20997, "verse_number": "४-३-३", "content_sanskrit": "तस्माद्धारीतः यतोंगिरसो हारीता ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000997003, "chapter_id": 20997, "verse_number": "४-३-४", "content_sanskrit": "रसातले मौनेया नाम गंधर्वा बभूवुष्षट्कोटिसंख्यातास्तैरशेषाणि नागकुलान्यपहृतप्रधानरत्नाधिपत्यान्यक्रियंत ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000997004, "chapter_id": 20997, "verse_number": "४-३-५", "content_sanskrit": "तैश्च गंधर्ववीर्यावभूतैरुरगेश्वरैस्तूयमानो भगवानशेषदेवेश आस्ते तच्छ्रवणोन्मीलितोन्निद्रपुंडरीकनयनो जलशयनो निद्रावसानप्रबुद्धः प्रणिपत्याभिहितः । भगवन्नस्माकमेतेभ्यो गंधर्वेभ्यो भयमुत्पन्नं कथमुपशममेष्यतीति ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000997005, "chapter_id": 20997, "verse_number": "४-३-६", "content_sanskrit": "आह च भगवाननादिनिधनपुरुषोत्तमो योसौ यौवनाश्वस्य मांधातुः पुरुकुत्सनामा पुत्रस्तमहमनुप्रविश्य तानशेषान् दुष्टगंधर्वानुपशमं नयिष्यामीति ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000997006, "chapter_id": 20997, "verse_number": "४-३-७", "content_sanskrit": "तदाकर्ण्य भगवते जलशायिने कृतप्रणामाः पुनर्नागलोकमागताः पन्नगाधिपतयो नर्मदां च पुरुकुत्सानयनाय चोदयामासुः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000997007, "chapter_id": 20997, "verse_number": "४-३-८", "content_sanskrit": "सा चैनं रसातलं नीतवती ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000997008, "chapter_id": 20997, "verse_number": "४-३-९", "content_sanskrit": "रसातलगतश्चासौ भगवत्तेजसाप्यायितात्मवीर्य्यस्सकलगंधर्वान्निजघान ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000997009, "chapter_id": 20997, "verse_number": "४-३-१०", "content_sanskrit": "पुनश्च स्वपुरमाजगाम ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000997010, "chapter_id": 20997, "verse_number": "४-३-११", "content_sanskrit": "सकलपन्नगाधिपतयश्च नर्मदायै वरं ददुः ।\nयत्तेनुस्मरणसमवेतं नामग्रहणं करिष्यति न तस्य सर्पविषभयं भविष्यतीति ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000997011, "chapter_id": 20997, "verse_number": "४-३-१२", "content_sanskrit": "अत्र च श्लोकः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000997012, "chapter_id": 20997, "verse_number": "४-३-१३", "content_sanskrit": "नर्मदायै नमः प्रातर्नर्मदायै नमो निशि ।\nनमोस्तु नर्मदे तुभ्यं त्राहि मां विषसर्पतः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000997013, "chapter_id": 20997, "verse_number": "४-३-१४", "content_sanskrit": "इत्युच्चार्याहर्निशमंधकारप्रवेशे वा सर्पैर्न दश्यते न चापि कृतानुस्मरणभुजो विषमपि भुक्तमुपघाताय भवति ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000997014, "chapter_id": 20997, "verse_number": "४-३-१५", "content_sanskrit": "पुरुकुत्साय संततिविच्छेदो न भविष्यतीत्युरगपतयो वरं ददुः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000997015, "chapter_id": 20997, "verse_number": "४-३-१६", "content_sanskrit": "पुरुकुत्सो नर्मदायां त्रसद्दस्युमजीजनत् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000997016, "chapter_id": 20997, "verse_number": "४-३-१७", "content_sanskrit": "त्रसद्दस्युतस्संभूतोऽनरण्यः यं रावणोदिग्विजये जघान ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000997017, "chapter_id": 20997, "verse_number": "४-३-१८", "content_sanskrit": "अनरण्यस्य पृषदश्वः पृषदश्वस्य हर्यश्वः पुत्रोऽभवत् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000997018, "chapter_id": 20997, "verse_number": "४-३-१९", "content_sanskrit": "तस्य च हस्तः पुत्रोऽभवत् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000997019, "chapter_id": 20997, "verse_number": "४-३-२०", "content_sanskrit": "ततश्च सुमनास्तस्यापि त्रिधन्वा त्रिधन्वनस्त्रय्यारुणिः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000997020, "chapter_id": 20997, "verse_number": "४-३-२१", "content_sanskrit": "त्रय्यारुणेस्सत्यव्रतः योऽसौ त्रिशंकुसंज्ञामवाप ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000997021, "chapter_id": 20997, "verse_number": "४-३-२२", "content_sanskrit": "स चंडालतामुपगतश्च ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000997022, "chapter_id": 20997, "verse_number": "४-३-२३", "content_sanskrit": "द्वादशवर्षिक्यामनावृष्ट्यां विश्वामित्रकलत्रापत्यपोषणार्थं चंडालप्रतिग्रहपरिहरणाय च जाह्नवीतीरन्यग्रोधे मृगमांसमनुदिनं बबंध ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000997023, "chapter_id": 20997, "verse_number": "४-३-२४", "content_sanskrit": "स तु परितुष्टेन विश्वामित्रेण सशरीरस्स्वर्गमारोपितः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000997024, "chapter_id": 20997, "verse_number": "४-३-२५", "content_sanskrit": "त्रिशंकोर्हरिश्चंद्र स्तस्माच्च रोहिताश्वस्ततश्च हरितो हरितस्य चंचुश्चंचोर्विजयवसुदेवौ रुरुको विजयाद्रु कस्य वृकः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000997025, "chapter_id": 20997, "verse_number": "४-३-२६", "content_sanskrit": "ततो वृकस्य बाहुः योऽसौ हैहयतालजंघादिभिः पराजितॐतर्वत्न्या महिष्या सह वनं प्रविवेश ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000997026, "chapter_id": 20997, "verse_number": "४-३-२७", "content_sanskrit": "तस्याश्चा सपत्न्या गर्भस्तंभनाय गरो दत्तः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000997027, "chapter_id": 20997, "verse_number": "४-३-२८", "content_sanskrit": "तेनास्य गर्भस्सप्तवर्षाणि जठर एव तस्थौ ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000997028, "chapter_id": 20997, "verse_number": "४-३-२९", "content_sanskrit": "स च बाहुर्वृद्धभावादौर्वाश्रमममीपे ममार ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000997029, "chapter_id": 20997, "verse_number": "४-३-३०", "content_sanskrit": "सा तस्य भार्या चितां कृत्वा तमारोप्यानुमरणकृतनिश्चयाऽभूत् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000997030, "chapter_id": 20997, "verse_number": "४-३-३१", "content_sanskrit": "अथैतामतीतानागतवर्त्तमानकालत्रयवेदी भगवानौर्वस्स्वाश्रमान्निर्गत्याब्रवीत् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000997031, "chapter_id": 20997, "verse_number": "४-३-३२", "content_sanskrit": "अलमलमनेनासद्ग्राहेणाखिलभूमं डलपतिरतिवीर्यपराक्रमो नैकयज्ञकृदरातिपक्षक्षयकर्त्ता तवोदरे चक्रवर्त्ती तिष्ठति ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000997032, "chapter_id": 20997, "verse_number": "४-३-३३", "content_sanskrit": "नैवमतिसाहसाध्यवसायिनी भवती भवेत्युक्ता सा तस्मादनुमरणनिर्बंधाद्विरराम ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000997033, "chapter_id": 20997, "verse_number": "४-३-३४", "content_sanskrit": "तेनैव च भगवता स्वाश्रममानीता ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000997034, "chapter_id": 20997, "verse_number": "४-३-३५", "content_sanskrit": "तत्र कतिपयदिनाभ्यंतरे च सहैव तेन गरेणातितेजस्वी बालको जज्ञे ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000997035, "chapter_id": 20997, "verse_number": "४-३-३६", "content_sanskrit": "तस्यौर्वो जातकर्मादिक्रिया निष्पाद्य सगर इति नाम चकार ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000997036, "chapter_id": 20997, "verse_number": "४-३-३७", "content_sanskrit": "कृतोपनयनं चैनमौर्वो वेदशास्त्राण्यस्त्रं चाग्नेयं भार्गवाख्यमध्यापयामास ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000997037, "chapter_id": 20997, "verse_number": "४-३-३८", "content_sanskrit": "उत्पन्नबुद्धिश्च मातरमब्रवीत् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000997038, "chapter_id": 20997, "verse_number": "४-३-३९", "content_sanskrit": "अंब कथयात्र वयं क्व तातोस्माकमित्येवमादिपृच्छंतं माता सर्वमेवावोचत् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000997039, "chapter_id": 20997, "verse_number": "४-३-४०", "content_sanskrit": "ततश्च पितृराज्यापहरणादमर्षितो हैहयतालजंघादिवधाय प्रतिज्ञामकरोत् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000997040, "chapter_id": 20997, "verse_number": "४-३-४१", "content_sanskrit": "प्रायशश्च हैहयतालजंघाञ्जघान ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000997041, "chapter_id": 20997, "verse_number": "४-३-४२", "content_sanskrit": "शकयवनकांभोजपारदपप्लवाः हन्यमानास्तत्कुलगुरुं वसिष्ठं शरणं जग्मुः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000997042, "chapter_id": 20997, "verse_number": "४-३-४३", "content_sanskrit": "अथैनान्वसिष्ठो जीवन्मृतकान् कृत्वा सगरमाह ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000997043, "chapter_id": 20997, "verse_number": "४-३-४४", "content_sanskrit": "वत्सालमेभिर्जीवन्मृतकैरनुमृतैः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000997044, "chapter_id": 20997, "verse_number": "४-३-४५", "content_sanskrit": "एते च मयैव त्वत्प्रतिज्ञापरिपालनाय निजधर्मद्विजसंगपरित्यागं कारिताः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000997045, "chapter_id": 20997, "verse_number": "४-३-४६", "content_sanskrit": "तथेति तद्गुरुवचनमभिनंद्य तेषां वेषान्यत्वमकारयत् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000997046, "chapter_id": 20997, "verse_number": "४-३-४७", "content_sanskrit": "यवनान्मुंडितशिरसोर्द्धमुंडिताञ्च्छकान् प्रलंबकेशान् पारदान् पप्लवाञ्श्मश्रुधरान् निस्स्वाध्यायवषट्कारानेतानन्यांश्च क्षत्रियांश्चकार ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000997047, "chapter_id": 20997, "verse_number": "४-३-४८", "content_sanskrit": "एते चात्मधर्मपरित्यागाद्ब्राह्मणैः परित्यक्ता म्लेच्छतां ययुः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000997048, "chapter_id": 20997, "verse_number": "४-३-४९", "content_sanskrit": "सगरोपि स्वमधिष्ठानमागम्य अस्खलितचक्रस्सप्तद्वीपवतीमिमामुर्वीं प्रशशास ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]