[{"id": 2183017, "chapter_id": 4883, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2183018, "chapter_id": 4883, "verse_number": "१", "content_sanskrit": "के लोका युद्ध्यमानानां शूराणामनिवर्तिनाम् ।\nभवन्ति निधनं प्राप्य तन्मे ब्रूहि पितामह\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2183019, "chapter_id": 4883, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2183020, "chapter_id": 4883, "verse_number": "२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nअम्बरीषस्य संवादमिन्द्रस्य च युधिष्ठिर\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2183021, "chapter_id": 4883, "verse_number": "३", "content_sanskrit": "अम्बरीषो हि नाभागः स्वर्गं गत्वा सुदुर्लभम् ।\nददर्श सुरलोकस्थं शक्रेण सचिवं सह\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2183022, "chapter_id": 4883, "verse_number": "४", "content_sanskrit": "सर्वतेजोमयं दिव्यं विमानवरमास्थितम् ।\nउपर्युपरि गच्छन्तं स्वं वै सेनापतिं प्रभुम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2183023, "chapter_id": 4883, "verse_number": "५", "content_sanskrit": "स दृष्ट्वोपरि गच्छन्तं सेनापतिमुदारधीः ।\nऋद्धिं दृष्ट्वा सुदेवस्य विस्मितः प्राह वासवम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2183024, "chapter_id": 4883, "verse_number": "६", "content_sanskrit": "सागरान्तां महीं कृत्स्नामनुशिष्य यथाविधि ।\nचातुर्वर्ण्ये यथाशास्त्रं प्रवृत्तो धर्मकाम्यया\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2183025, "chapter_id": 4883, "verse_number": "७", "content_sanskrit": "ब्रह्मचर्येण घोरेण आचार्यकुलसेवया ।\nवेदानधीत्य धर्मेण राजशास्त्रं च केवलम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2183026, "chapter_id": 4883, "verse_number": "८", "content_sanskrit": "अतिथीनन्नपानेन पितॄंश्च स्वधया तथा ।\nऋषीन् स्वाध्यायदीक्षाभिर्देवान् यज्ञैरनुत्तमैः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2183027, "chapter_id": 4883, "verse_number": "९", "content_sanskrit": "क्षत्रधर्मे स्थितो भूत्वा यथाशास्त्रं यथाविधि ।\nउदीक्षमाणः पृतनां जयामि युधि वासव\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2183028, "chapter_id": 4883, "verse_number": "१०", "content_sanskrit": "देवराज सुदेवोऽयं मम सेनापतिः पुरा ।\nआसीद् योधः प्रशान्तात्मा सोऽयं कस्मादतीव माम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2183029, "chapter_id": 4883, "verse_number": "११", "content_sanskrit": "नानेन क्रतुभिर्मुख्यैरिष्टं नैव द्विजातयः ।\nतर्पिता विधिवच्छक्र सोऽयं कस्मादतीव मे\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2183030, "chapter_id": 4883, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2183031, "chapter_id": 4883, "verse_number": "१२", "content_sanskrit": "यदनेन कृतं कर्म प्रत्यक्षं ते महीपते ।\nपुरा पालयतः सम्यक् पृथिवीं धर्मतो नृप\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2183032, "chapter_id": 4883, "verse_number": "१३", "content_sanskrit": "शत्रवो निर्जिताः सर्वे ये तवाहितकारिणः ।\nसंयमो विषमश्चैव सुयमश्च महाबलः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2183033, "chapter_id": 4883, "verse_number": "१४", "content_sanskrit": "राक्षसा दुर्जया लोके त्रयस्ते युद्धदुर्मदाः ।\nपुत्रास्ते शतशृङ्गस्य राक्षसस्य महीपतेः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2183034, "chapter_id": 4883, "verse_number": "१५", "content_sanskrit": "तथा तस्मिन् शुभे काले यज्ञे यज्ञं वितन्वतः ।\nअश्वमेधं महायागं देवानां हितकाम्यया\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2183035, "chapter_id": 4883, "verse_number": "१६", "content_sanskrit": "तस्य ते खलु विघ्नार्थमागता राक्षसास्त्रयः ।\nकोटीशतपरीवारां राक्षसानां महाचमूम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2183036, "chapter_id": 4883, "verse_number": "१७", "content_sanskrit": "परिगृह्य ततः सर्वाः प्रजा बन्दीकृतास्तव ।\nविह्वलाश्च प्रजाः सर्वाः सर्वे च तव सैनिकाः ।\nनिराकृतस्तया चासीत् सुदेवः सैन्यनायकः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2183037, "chapter_id": 4883, "verse_number": "१८", "content_sanskrit": "तत्रामात्यवचः श्रुत्वा निरस्तः सर्वकर्मसु ।\nश्रुत्वा तेषां वचो भूयः सोपधं वसुधाधिप\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2183038, "chapter_id": 4883, "verse_number": "१९", "content_sanskrit": "सर्वसैन्यसमायुक्तः सुदेवः प्रहितस्त्वया ।\nराक्षसानां वधार्थाय दुर्जयानां नराधिप\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2183039, "chapter_id": 4883, "verse_number": "२०", "content_sanskrit": "नाजित्वा राक्षसीं सेनां पुनरागमनं तव ।\nबन्दान्मोक्षमकृत्वा च न चागमनमिष्यते\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2183040, "chapter_id": 4883, "verse_number": "२१", "content_sanskrit": "सुदेवस्तद्वचः श्रुत्वा प्रस्थानमकरोन्नृप ।\nसम्प्राप्तश्च स तं देशं यत्र बन्दीकृताः प्रजाः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2183041, "chapter_id": 4883, "verse_number": "२२", "content_sanskrit": "पश्यति स्म महाघोरां राक्षसानां महाचमूम् ।\nदृष्ट्वा स चिन्तयामास सुदेवो वाहिनीपतिः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2183042, "chapter_id": 4883, "verse_number": "२३", "content_sanskrit": "नेयं शक्या चमूर्जेतुमपि सेन्द्रैः सुरासुरैः ।\nनाम्बरीषः कलामेकामेषां क्षपयितुं क्षमः ।\nदिव्यास्त्रबलभूयिष्ठः किमङ्गः पुनरीदृशः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2183043, "chapter_id": 4883, "verse_number": "२४", "content_sanskrit": "ततः सेनां पुनः सर्वां प्रेषयामस पार्थिव ।\nयच्च त्वं विजितः सर्वैर्मन्त्रिभिः सोपधैः सह\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2183044, "chapter_id": 4883, "verse_number": "२५", "content_sanskrit": "ततो रुद्रं महादेवं प्रपन्नो जगतः पतिम् ।\nश्मशाननिलयं देवं तुष्टाव वृषभध्वजम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2183045, "chapter_id": 4883, "verse_number": "२६", "content_sanskrit": "स्तुत्वा शस्त्रं समादाय स्वशिरश्छेत्तुमुद्यतः \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2183046, "chapter_id": 4883, "verse_number": "२७", "content_sanskrit": "कारुण्याद् देवदेवेन गृहीतस्तस्य दक्षिणः ।\nस पाणिः सह शस्त्रेण दृष्ट्वा चेदमुवाच ह\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2183047, "chapter_id": 4883, "verse_number": "२८", "content_sanskrit": "किमिदं साहसं पुत्र कर्तुकामो वदस्व मे ।\nस उवाच महादेवं शिरसा त्ववनीं गतः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2183048, "chapter_id": 4883, "verse_number": "२९", "content_sanskrit": "भगवन् वाहिनीमेनां राक्षसानां सुरेश्वर ।\nअशक्तोऽहं रणे जेतुं तस्मात् त्यक्ष्यामि जीवितम् ।\nगतिर्भव महादेव ममार्तस्य जगत्पते\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2183049, "chapter_id": 4883, "verse_number": "३०", "content_sanskrit": "नागन्तव्यमजित्वा च मामाह जगतीपतिः ।\nअम्बरीषो महादेवः क्षारितः सचिवैः सह\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2183050, "chapter_id": 4883, "verse_number": "३१", "content_sanskrit": "तमुवाच महादेवः सुदेवं पतितं क्षितौ ।\nअधोमुखं महात्मानं सत्त्वानां हितकाम्यया\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2183051, "chapter_id": 4883, "verse_number": "३२", "content_sanskrit": "धनुर्वेदं समाहूय सगणं सहविग्रहम् ।\nरथनागाश्वकलिलं दिव्यास्त्रसमलङ्कृतम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2183052, "chapter_id": 4883, "verse_number": "३३", "content_sanskrit": "रथं च सुमहाभागं येन तत् त्रिपुरं हतम् ।\nधनुः पिनाकं खड्गं च रौद्रमस्त्रं च शङ्करः ।\nनिजघानासुरान् सर्वान् येन देवस्त्रियम्बकः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2183053, "chapter_id": 4883, "verse_number": "३४", "content_sanskrit": "उवाच च महादेवः सुदेवं वाहिनीपतिम् ।\nरथादस्मात् सुदेव त्वं दुर्जयः स सुरासुरैः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2183054, "chapter_id": 4883, "verse_number": "३५", "content_sanskrit": "मायया मोहितो भूमौ न पदं कर्तुमर्हसि ।\nरथस्थस्त्रिदशान् सर्वान् जेष्यसि त्वं सदानवान्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2183055, "chapter_id": 4883, "verse_number": "३६", "content_sanskrit": "राक्षसाश्च पिशाचाश्च न शक्ता द्रष्टुमीदृशम् ।\nरथं सूर्यसहस्राभं किमु योद्धुं त्वया सह\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2183056, "chapter_id": 4883, "verse_number": "३७", "content_sanskrit": "स जित्वा राक्षसान् सर्वान् कृत्वा बन्दीविमोक्षणम् ।\nघातयित्वा च तान् सर्वान् बाहुयुद्धे त्वयं हतः ।\nविषमं प्राप्य भूपाल विषमश्च निपातितः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2183057, "chapter_id": 4883, "verse_number": "३८", "content_sanskrit": "एतस्य विततस्तात सुदेवस्य बभूव ह ।\nसङ्ग्रामयज्ञः सुमहान् यश्चान्यो युद्ध्यते नरः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2183058, "chapter_id": 4883, "verse_number": "३९", "content_sanskrit": "सन्नद्धो दीक्षितः सर्वो योधः प्राप्य चमूमुखम् ।\nयुद्धयज्ञाधिकारस्थो भवतीति विनिश्चयः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2183059, "chapter_id": 4883, "verse_number": "", "content_sanskrit": "अम्बरीषः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2183060, "chapter_id": 4883, "verse_number": "४०", "content_sanskrit": "कानि यज्ञे हवींष्यत्र किमाज्यं का च दक्षिणा ।\nऋत्विजश्चात्र के प्रोक्तास्तन्मे ब्रूहि शतक्रतो\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2183061, "chapter_id": 4883, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2183062, "chapter_id": 4883, "verse_number": "४१", "content_sanskrit": "ऋत्विजः कुञ्जरास्तत्र वाजिनोऽध्वर्यवस्तथा ।\nहवींषि परमांसानि रुधिरं त्वाज्यमेव च\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2183063, "chapter_id": 4883, "verse_number": "४२", "content_sanskrit": "सृगालगृध्रकाकोलाः सदस्यास्तत्र सत्रिणः ।\nआज्यशेषं पिबन्त्येते हविः प्राश्नन्ति चाध्वरे\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2183064, "chapter_id": 4883, "verse_number": "४३", "content_sanskrit": "प्रासतोमरसङ्घाताः खड्गशक्तिपरश्वधाः ।\nज्वलन्तो निशिताः पीताः स्रुचस्तस्याथ सत्रिणः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2183065, "chapter_id": 4883, "verse_number": "४४", "content_sanskrit": "चापवेगायतस्तीक्ष्णः परकायावदारणः ।\nऋजुः सुनिशितः पीतः सायकोऽस्य स्रुवो महान्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2183066, "chapter_id": 4883, "verse_number": "४५", "content_sanskrit": "द्वीपिचर्मावनद्धश्च नागदन्तकृतत्सरुः ।\nहस्तिहस्तगतः खड्गः स्फ्यो भवेत् तस्य संयुगे\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2183067, "chapter_id": 4883, "verse_number": "४६", "content_sanskrit": "ज्वलितैर्निशितैः पीतैः प्रासशक्तिपरश्वधैः ।\nशैक्यायसमयैस्तीक्ष्णैरभिघातो भवेद् वसु\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2183068, "chapter_id": 4883, "verse_number": "४७", "content_sanskrit": "आवेगाद् यत्तु रुधिरं संग्रामे स्यन्दते भुवि ।\nसाऽस्य पूर्णाहुतिर्होत्रे समृद्धा सर्वकामधुक्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2183069, "chapter_id": 4883, "verse_number": "४८", "content_sanskrit": "छिन्धि भिन्धीति यस्यैतच्छ्रूयते वाहिनीमुखे ।\nसामानि सामगास्तस्य गायन्ति यमसादने\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2183070, "chapter_id": 4883, "verse_number": "४९", "content_sanskrit": "हविर्धानं तु तस्याहुः परेषां वाहिनीमुखम् ।\nकुञ्जराणां हयानां च वर्मिणां च समुच्चयः ।\nअग्निः श्येनचितो नाम तस्य यज्ञे विधीयते\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2183071, "chapter_id": 4883, "verse_number": "५०", "content_sanskrit": "उत्तिष्ठति कबन्धोऽत्र सहस्रे निहते तु यः ।\nस यूपस्तस्य शूरस्य खादिरोऽष्टाश्रिरुच्यते\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2183072, "chapter_id": 4883, "verse_number": "५१", "content_sanskrit": "इहोपहूतं क्रोशन्ति कुञ्जरा अङ्कुशेरिताः ।\nव्याघुष्टतळनादेन वषट्कारेण पार्थिव ।\nउद्गाता तत्र सङ्ग्रामे त्रिसामा दुन्दुभिः स्मृतः\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2183073, "chapter_id": 4883, "verse_number": "५२", "content_sanskrit": "ब्रह्मस्वे ह्रियमाणे यः प्रियां युद्धे तनुं त्यजेत् ।\nआत्मानं यूपमुच्छ्रित्य स यज्ञोऽनन्तदक्षिणः\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2183074, "chapter_id": 4883, "verse_number": "५३", "content_sanskrit": "भर्तुरर्थे तु यः शूरो विक्रमेद् वाहिनीमुखे ।\nभयान्न च निवर्तेत तस्य लोका यथा मम\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2183075, "chapter_id": 4883, "verse_number": "५४", "content_sanskrit": "नीलचन्द्राकृतैः खड्गैर्बाहुभिः परिघोपमैः ।\nयस्य वेदिरुपस्तीर्णा तस्य लोका यथा मम\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2183076, "chapter_id": 4883, "verse_number": "५५", "content_sanskrit": "यस्तु नावेक्षते कञ्चित् सहायं विजये स्थितः ।\nविगाह्य वाहिनीमध्यं तस्य लोका यथा मम\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2183077, "chapter_id": 4883, "verse_number": "५६", "content_sanskrit": "यस्य तोमरसङ्घाटा भेरीमण्डूककच्छपा ।\nवीरास्थिशर्करा दुर्गा मांसशोणितकर्दमा\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2183078, "chapter_id": 4883, "verse_number": "५७", "content_sanskrit": "असिचर्मप्लवा सिन्धुः केशशैवलशाद्वला ।\nअश्वनागरथैश्चैव सम्भिन्नैः कृतसङ्क्रमा\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2183079, "chapter_id": 4883, "verse_number": "५८", "content_sanskrit": "पताकाध्वजवानीरा हतवाहनवाहिनी ।\nशोणितोदा सुसम्पूर्णा दुस्तरा पारगैर्नरैः\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2183080, "chapter_id": 4883, "verse_number": "५९", "content_sanskrit": "हतनागमहानक्रा परलोकवहाशिवा ।\nऋष्टिखड्गध्वजानूका गृध्रकङ्कवडप्लवा\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2183081, "chapter_id": 4883, "verse_number": "६०", "content_sanskrit": "पुरुषादानुचरिता भीरूणां कश्मलावहा ।\nनदी योधमहायज्ञे तदस्यावभृथं स्मृतम्\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2183082, "chapter_id": 4883, "verse_number": "६१", "content_sanskrit": "वेदी यस्य त्वमित्राणां शिरोभिरवकीर्यते ।\nअश्वस्कन्धैर्गजस्कन्धैस्तस्य लोका यथा मम\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2183083, "chapter_id": 4883, "verse_number": "६२", "content_sanskrit": "पत्नीशाला कृता यस्य परेषां वाहिनीमुखम् ।\nहविधार्नं स्ववाहिन्यस्तदस्याहुर्मनीषिणः\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2183084, "chapter_id": 4883, "verse_number": "६३", "content_sanskrit": "सदस्योत्तरयोधाग्निराग्नीध्रस्योत्तरां दिशम् ।\nशत्रुसेनाकलत्रस्य सर्वलोकानदूरतः\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2183085, "chapter_id": 4883, "verse_number": "६४", "content_sanskrit": "यदा तूभयतो व्यूहो भवत्याकाशमग्रतः ।\nसाऽस्य वेदी तथा यज्ञे तस्य वेदास्त्रयोऽग्नयः\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2183086, "chapter_id": 4883, "verse_number": "६५", "content_sanskrit": "यस्तु योधः परावृत्तः सन्त्रस्तो हन्यते परैः ।\nअप्रतिष्ठं स नरकं याति नास्त्यत्र संशयः\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2183087, "chapter_id": 4883, "verse_number": "६६", "content_sanskrit": "यस्य शोणितवेगेन नदी स्यात् समभिप्लुता ।\nकेशमांसास्थिसङ्कीर्णा स गच्छेत् परमां गतिम्\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2183088, "chapter_id": 4883, "verse_number": "६७", "content_sanskrit": "यस्तु सेनापतिं हत्वा तद्यानमधिरोहति ।\nस विष्णुविक्रमक्रामी बृहस्पतिसमः क्रतुः\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2183089, "chapter_id": 4883, "verse_number": "६८", "content_sanskrit": "नायकं वा प्रमाणं वा यो वा स्यात्तत्र पूजितः ।\nजीवग्राहं निगृह्णाति तस्य लोका यथा मम\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2183090, "chapter_id": 4883, "verse_number": "६९", "content_sanskrit": "आहवे निहतं शूरं न शोचेत कदाचन ।\nअशोच्यो हि हतः शूरः स्वर्गलोके महीयते\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2183091, "chapter_id": 4883, "verse_number": "७०", "content_sanskrit": "नह्यन्नं नोदकं तस्य न स्नानं नाप्यशौचकम् ।\nहतस्य कर्तुमिच्छन्ति तस्य लोकान् शृणुष्व मे\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2183092, "chapter_id": 4883, "verse_number": "७१", "content_sanskrit": "वराप्सरःसहस्राणि शूरमायोधने हतम् ।\nत्वरमाणा हि धावन्ति मम भर्ता भवेदिति\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2183093, "chapter_id": 4883, "verse_number": "७२", "content_sanskrit": "एतत् तपश्च पुण्यं च धर्मश्चैव सनातनः ।\nचत्वारश्चाश्रमास्तस्य यो युद्धे न पलायते\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2183094, "chapter_id": 4883, "verse_number": "७३", "content_sanskrit": "वृद्धबालौ न हन्तव्यौ नैव स्त्री नच वै द्विजः ।\nतृणपूर्णमुखश्चैव तवास्मीति च यो वदेत्\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2183095, "chapter_id": 4883, "verse_number": "७४", "content_sanskrit": "अहं वृत्रं बलं पाकं शतमायं विरोचनम् ।\nदुरावार्यं च नमुचिं नैकमायं च शम्बरम्\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2183096, "chapter_id": 4883, "verse_number": "७५", "content_sanskrit": "विप्रचित्तिं च दैतेयं दनोः पुत्रांश्च सर्वशः ।\nप्रह्लादं च निहत्याजौ ततो देवाधिपोऽभवम्\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2183097, "chapter_id": 4883, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2183098, "chapter_id": 4883, "verse_number": "७६", "content_sanskrit": "इत्येतच्छक्रवचनं निशम्य प्रतिगृह्य च ।\nयोधानामात्मनः सिद्धिमम्बरीषोऽभिपन्नवान्\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2183099, "chapter_id": 4883, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि राजधर्मे शततमोऽध्यायः ॥ १०० ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}]