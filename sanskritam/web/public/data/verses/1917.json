[{"id": 2041327, "chapter_id": 1917, "verse_number": "५-१६२-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2041328, "chapter_id": 1917, "verse_number": "५-१६२-१", "content_sanskrit": "उलूकस्त्वर्जुनं भूयो यथोक्तं वाक्यमब्रवीत्।\nआशीविषमिव क्रुद्धं तुदन्वाक्यशलाकया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2041329, "chapter_id": 1917, "verse_number": "५-१६२-२", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा रुषिताः पाण्डवा भृशम् ।\nप्रागेव भृशसंक्रुद्धाः कैतव्येनापि धर्षिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2041330, "chapter_id": 1917, "verse_number": "५-१६२-३", "content_sanskrit": "आसनेषूदतिष्ठन्त बाहूंश्चैव प्रचिक्षिपुः।\nआशीविषा इव क्रुद्धा वीक्षाञ्चक्रुः परस्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2041331, "chapter_id": 1917, "verse_number": "५-१६२-४", "content_sanskrit": "अवाक्छिरा भीमसेनः समुदैक्षत कैतवम्।\nनेत्राभ्यां लोहितान्ताभ्यामाशीविष इव श्वसन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2041332, "chapter_id": 1917, "verse_number": "५-१६२-५", "content_sanskrit": "आर्तं वातात्मजं दृष्ट्वा क्रोधेनाभिहतं भृशम् ।\nउत्स्मयन्निव दाशार्हः कैतव्यं प्रत्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2041333, "chapter_id": 1917, "verse_number": "५-१६२-६", "content_sanskrit": "प्रयाहि शीघ्रं कैतव्य ब्रूयाश्चैव सुयोधनम् ।\nश्रुतं वाक्यं गृहीतोर्थो मतं यत्ते तथास्तु तत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2041334, "chapter_id": 1917, "verse_number": "५-१६२-७", "content_sanskrit": "एवमुक्त्वा महाबाहुः केशवो राजसत्तम।\nपुनरेव महाप्राज्ञं युधिष्ठिरमुदैक्षत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2041335, "chapter_id": 1917, "verse_number": "५-१६२-८", "content_sanskrit": "सृञ्जयानां च सर्वेषां कृष्णस्य च यशस्विनः।\nद्रुपदस्य सपुत्रस्य विराटस्य च संनिधौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2041336, "chapter_id": 1917, "verse_number": "५-१६२-९", "content_sanskrit": "भूमिपानां च सर्वेषां मध्ये वाक्यं जगाद ह।\nउलूकोऽप्यर्जुनं भूयो यथोक्तं वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2041337, "chapter_id": 1917, "verse_number": "५-१६२-१०", "content_sanskrit": "आशीविषमिव क्रुद्धं तुदन्वाक्यशलाकया।\nकृष्णादींश्चैव तान्सर्वान्यथोक्तं वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2041338, "chapter_id": 1917, "verse_number": "५-१६२-११", "content_sanskrit": "उलूकस्य तु तद्वाक्यं पापं दारुणमीरितम् ।\nश्रुत्वा विचुक्षुभे पार्थो ललाटं चाप्यमार्जयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2041339, "chapter_id": 1917, "verse_number": "५-१६२-१२", "content_sanskrit": "तदवस्थं तदा दृष्ट्वा पार्थं सा समितिर्नृप ।\nनामृष्यत महाराज पाण्डवानां महारथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2041340, "chapter_id": 1917, "verse_number": "५-१६२-१३", "content_sanskrit": "अधिक्षेपेण कृष्णस्य पार्थस्य च महात्मनः।\nश्रुत्वा ते पुरुषव्याघ्राः क्रोधाञ्जज्वलुरच्युत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2041341, "chapter_id": 1917, "verse_number": "५-१६२-१४", "content_sanskrit": "धृष्टद्युम्नः शिखण्डी च सात्यकिश्च महारथः।\nकेकया भ्रातरः पञ्च राक्षसश्च घटोत्कचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2041342, "chapter_id": 1917, "verse_number": "५-१६२-१५", "content_sanskrit": "द्रौपदेयाभिमन्युश्च धृष्टकेतुश्च पार्थिवः ।\nभीमसेनश्च विक्रान्तो यमजौ च महारथौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2041343, "chapter_id": 1917, "verse_number": "५-१६२-१६", "content_sanskrit": "उत्पेतुरासनात्सर्वे क्रोधसंरक्तलोचनाः।\nबाहुन्प्रगृह्य रुचिरान्रक्तचन्दनरूषितान्।\nअङ्गदैः पारिहार्यैश्च केयूरैश्च विभूषितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2041344, "chapter_id": 1917, "verse_number": "५-१६२-१७", "content_sanskrit": "दन्तान्दन्तेषु निष्पिष्य सृक्किणी परिलेलिहन् ।\nतेषामाकारभावज्ञः कुन्तीपुत्रो वृकोदरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2041345, "chapter_id": 1917, "verse_number": "५-१६२-१८", "content_sanskrit": "उदतिष्ठत्स वेगेन क्रोधेन प्रज्वलन्निव।\nउद्वृत्य सहसा नेत्रे दन्तान्कटकटाय्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2041346, "chapter_id": 1917, "verse_number": "५-१६२-१९", "content_sanskrit": "हस्तं हस्तेन निष्पिष्य उलूकं वाक्यमब्रवीत्।\nअशक्तानामिवास्माकं प्रोत्साहननिमित्तकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2041347, "chapter_id": 1917, "verse_number": "५-१६२-२०", "content_sanskrit": "श्रुतं ते चवनं मूर्ख यत्त्वां दुर्योधनोऽब्रवीत्।\nतन्मे कथयतो मन्द श्रृणु वाक्यं दुरासदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2041348, "chapter_id": 1917, "verse_number": "५-१६२-२१", "content_sanskrit": "सर्वक्षत्रस्य मध्ये तं यद्वक्ष्यसि सुयोधनम् ।\nश्रृण्वतः सूतपुत्रस्य पितुश्च त्वं दुरात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2041349, "chapter_id": 1917, "verse_number": "५-१६२-२२", "content_sanskrit": "अस्माभिः प्रीतिकामैस्तु भ्रातुर्ज्येष्ठस्य नित्यशः।\nमर्षितं ते दुराचार तत्त्वं न बहु मन्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2041350, "chapter_id": 1917, "verse_number": "५-१६२-२३", "content_sanskrit": "प्रेषितश्च हृषीकेशः शमाकाङ्क्षी कुरून्प्रति ।\nकुलस्य हितकामेन धर्मराजेन धीमता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2041351, "chapter_id": 1917, "verse_number": "५-१६२-२४", "content_sanskrit": "त्वं कालचोदितो नूनं गन्तुकामो यमक्षयम् ।\nगच्छस्वाहवमस्माभिस्तच्च श्वो भविता ध्रुवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2041352, "chapter_id": 1917, "verse_number": "५-१६२-२५", "content_sanskrit": "मयापि च प्रतिज्ञातो वधः सभ्रातृकस्य ते।\nस तथा भविता पाप नात्र कार्या विचारणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2041353, "chapter_id": 1917, "verse_number": "५-१६२-२६", "content_sanskrit": "वेलामतिक्रमेत्सद्यः सागरो वरुणालयः ।\nपर्वताश्च विशीर्येयुर्मयोक्तं न मृषा भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2041354, "chapter_id": 1917, "verse_number": "५-१६२-२७", "content_sanskrit": "सहायस्ते यदि यमः कुबेरो रुद्र एव वा।\nयथाप्रतिज्ञं दुर्बुद्धे प्रकरिष्यन्ति पाण्डवाः ।\nदुःशासनस्य रुधिरं पाता चास्मि यथेप्सितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2041355, "chapter_id": 1917, "verse_number": "५-१६२-२८", "content_sanskrit": "यश्चेह प्रतिसंरब्धः क्षत्रियो माभियास्यति।\nअपि भीष्मं पुरुस्कृत्य तं नेष्यामि यमक्षयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2041356, "chapter_id": 1917, "verse_number": "५-१६२-२९", "content_sanskrit": "यच्चैतदुक्तं वचनं मया क्षत्रस्य संसदि।\nयथैतद्भविता सत्यं तथैवात्मानमालभे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2041357, "chapter_id": 1917, "verse_number": "५-१६२-३०", "content_sanskrit": "भीमसेनवचः श्रुत्वा सहदेवोऽप्यमर्षणः ।\nक्रोधसंरक्तनयनस्ततो वाक्यमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2041358, "chapter_id": 1917, "verse_number": "५-१६२-३१", "content_sanskrit": "शौटीरशूरसदृशमनीकजनसंसदि।\nश्रृणु पाप वचो मह्यं यद्वाच्यो हि पितात्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2041359, "chapter_id": 1917, "verse_number": "५-१६२-३२", "content_sanskrit": "नास्माकं भविता भेदः कदाचित्कुरुभिः सह ।\nधृतराष्ट्रस्य संबन्धो यदि न स्यात्त्वया सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2041360, "chapter_id": 1917, "verse_number": "५-१६२-३३", "content_sanskrit": "त्वं तु लोकविनाशाय धृतराष्ट्रकुलस्य च।\nउत्पन्नो वैरपुरुषः स्वकुलघ्नश्च पापकृत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2041361, "chapter_id": 1917, "verse_number": "५-१६२-३४", "content_sanskrit": "जन्मप्रभृति चास्माकं पिता ते पापपूरुषः ।\nअहितानि नृशंसानि नित्यशः कर्तुमिच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2041362, "chapter_id": 1917, "verse_number": "५-१६२-३५", "content_sanskrit": "तस्य वैरानुषङ्गस्य गन्तास्म्यन्तं सुदुर्गमम्।\nअहमादौ निहत्य त्वां शकुनेः संप्रपश्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2041363, "chapter_id": 1917, "verse_number": "५-१६२-३६", "content_sanskrit": "ततोऽस्मि शकुनिं हन्ता मिषतां सर्वधन्विनाम्।\nभीमस्य वचनं श्रुत्वा सहदेवस्य चोभयोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2041364, "chapter_id": 1917, "verse_number": "५-१६२-३७", "content_sanskrit": "उवाच फाल्गुनो वाक्यं भीमसेनं स्मयन्निव।\nभीमसेन न ते सन्ति येषां वैरं त्वया सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2041365, "chapter_id": 1917, "verse_number": "५-१६२-३८", "content_sanskrit": "मन्दा गृहेषु सुखिनो मृत्युपाशवशं गताः।\nउलूकश्च न ते वाच्यः परुषं पुरुषोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2041366, "chapter_id": 1917, "verse_number": "५-१६२-३९", "content_sanskrit": "दूताः किमपराध्यन्ते यथोक्तस्यानुभाषिणः ।\nएवमुक्त्वा महाबाहुर्भीमं भीमपराक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2041367, "chapter_id": 1917, "verse_number": "५-१६२-४०", "content_sanskrit": "धृष्टद्युम्नसुखान्वीरान्सुहृदः समभाषत।\nश्रुतं वस्तस्य पापस्य धार्तराष्ट्रस्य भाषितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2041368, "chapter_id": 1917, "verse_number": "५-१६२-४१", "content_sanskrit": "कुत्सनं वासुदेवस्य मम चैव विशेषतः।\nश्रुत्वा भवन्तः संरब्धा अस्माकं हितकाम्यया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2041369, "chapter_id": 1917, "verse_number": "५-१६२-४२", "content_sanskrit": "प्रभावाद्वासुदेवस्य भवतां च प्रयत्नतः।\nसमग्रं पार्थिवं क्षत्रं सर्वं न गणयाम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2041370, "chapter_id": 1917, "verse_number": "५-१६२-४३", "content_sanskrit": "भवद्भिः समनुज्ञातो वाक्यमस्य यदुत्तरम् ।\nउलूके प्रापयिष्यामि यद्वक्ष्यति सुयोधनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2041371, "chapter_id": 1917, "verse_number": "५-१६२-४४", "content_sanskrit": "श्वो भूते कत्थितस्यास्य प्रतिवाक्यं चमूमुखे।\nगाण्डीवेनाभिधास्याकमि क्लीबा हि वचनोत्तराः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2041372, "chapter_id": 1917, "verse_number": "५-१६२-४५", "content_sanskrit": "ततस्ते पार्थिवाः सर्वे प्रशशंसुर्धनञ्जयम् ।\nतेन वाक्योपचारेण विस्मिता राजसत्तमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2041373, "chapter_id": 1917, "verse_number": "५-१६२-४६", "content_sanskrit": "अनुनीय च तान्सर्वान्यथामान्यं यथावयः।\nधर्मराजं तदा वाक्यं तत्प्राप्यं प्रत्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2041374, "chapter_id": 1917, "verse_number": "५-१६२-४७", "content_sanskrit": "आत्मानमवमन्वानो न हि स्यात्पार्थिवोत्तमः ।\nतत्रोत्तरं प्रवक्ष्यामि तव शुश्रूषणे रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2041375, "chapter_id": 1917, "verse_number": "५-१६२-४८", "content_sanskrit": "उलूकं भरतश्रेष्ठ सामपूर्वमथोर्जितम् ।\nदुर्योधनस्य तद्वाक्यं निशम्य भरतर्षभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2041376, "chapter_id": 1917, "verse_number": "५-१६२-४९", "content_sanskrit": "अतिलोहितनेत्राभ्यामाशीविष इव श्वसन् ।\nस्मयमान इव क्रोधात्सृक्किणी परिसंलिहन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2041377, "chapter_id": 1917, "verse_number": "५-१६२-५०", "content_sanskrit": "जनार्दनमभिप्रेक्ष्य भ्रातॄंश्चैवेदमब्रवीत् ।\nअभ्यभाषत कैतव्यं प्रगृह्य विपुलं भुजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2041378, "chapter_id": 1917, "verse_number": "५-१६२-५१", "content_sanskrit": "उलूक गच्छ कैतव्य ब्रूहि तात सुयोधनम् ।\nकृतघ्नं वैरपुरुषं दुर्मतिं कुलपांसनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2041379, "chapter_id": 1917, "verse_number": "५-१६२-५२", "content_sanskrit": "पाण्डवेषु सदा पाप नित्यं जिह्मं प्रवर्तते।\nस्ववीर्याद्यः पराक्रम्य पाप आह्वयते परान्।\nअभीतः पूरयन्वाक्यमेष वैः क्षत्रियः पुमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2041380, "chapter_id": 1917, "verse_number": "५-१६२-५३", "content_sanskrit": "स पापः क्षत्रियो भूत्वा अस्मानाहूय संयुगे।\nमान्यामान्यान्पुरस्कृत्य युद्धं मा गाः कुलाधम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2041381, "chapter_id": 1917, "verse_number": "५-१६२-५४", "content_sanskrit": "आत्मवीर्यं समाश्रिकत्य भृत्यवीर्यं च कौरव ।\nआह्वयस्व रणे पार्थान्सर्वथा क्षत्रियो भव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2041382, "chapter_id": 1917, "verse_number": "५-१६२-५५", "content_sanskrit": "परवीर्यं समाश्रित्य यः समाह्वयते परान्।\nअशक्तः स्वयमादातुमेतदेव नपुंसकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2041383, "chapter_id": 1917, "verse_number": "५-१६२-५६", "content_sanskrit": "स त्वं परेषां वीर्येण आत्मानं बहुमन्यसे ।\nकथमेवमशक्तस्त्वमस्मान्समभिगर्जसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2041384, "chapter_id": 1917, "verse_number": "५-१६२-५७x", "content_sanskrit": "कृष्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2041385, "chapter_id": 1917, "verse_number": "५-१६२-५७", "content_sanskrit": "मद्वचश्चापि भूयस्ते वक्तव्यः स सुयोधनः।\nश्व इदानीं प्रपद्येथाः पुरुषो भव दुर्मते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2041386, "chapter_id": 1917, "verse_number": "५-१६२-५८", "content_sanskrit": "मन्यसे यच्च मूढ त्वं न योत्स्यति जनार्दनः।\nसारथ्येन वृतः पार्थैरिति त्वं न बिभेषि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2041387, "chapter_id": 1917, "verse_number": "५-१६२-५९", "content_sanskrit": "जघन्यकालमप्येतन्न भवेत्सर्वपार्थिवान्।\nनिर्दहेयमहं क्रोधात्तृणानीव हुताशनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2041388, "chapter_id": 1917, "verse_number": "५-१६२-६०", "content_sanskrit": "युधिष्ठिरनियोगात्तु फाल्गुनस्य महात्मनः ।\nकरिष्ये युध्यमानस्य सारथ्यं विजितात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2041389, "chapter_id": 1917, "verse_number": "५-१६२-६१", "content_sanskrit": "यद्युत्पतसि लोकांस्त्रीन्यद्याविशसि भूतलम् ।\nतत्रतत्रार्जुनरथं प्रभाते द्रक्ष्यसे पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2041390, "chapter_id": 1917, "verse_number": "५-१६२-६२", "content_sanskrit": "यच्चापि भीमसेनस्य मन्यसे मोघभाषितम् ।\nदुःशासनस्य रुधिरं पीतमद्यावधारय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2041391, "chapter_id": 1917, "verse_number": "५-१६२-६३", "content_sanskrit": "न त्वां समीक्षते पार्थो नापि राजा युधिष्ठिरः।\nन भीमसेनो न यमौ प्रतिकूलप्रभाषिणम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2041392, "chapter_id": 1917, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि उलूकदूतागमनपर्वणि द्विषष्ट्यधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}]