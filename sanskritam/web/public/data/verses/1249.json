[{"id": 2012227, "chapter_id": 1249, "verse_number": "१-२५०-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2012228, "chapter_id": 1249, "verse_number": "१-२५०-१", "content_sanskrit": "स तु नैराश्यमापन्नः सदा ग्लानिसमन्वितः।\nपितामहमुपागच्छत्संक्रुद्धो हव्यवाहनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2012229, "chapter_id": 1249, "verse_number": "१-२५०-२", "content_sanskrit": "तच्च सर्वं यथान्यायं ब्रह्मणे संन्यवेदयत्।\nउवाच चैवनं भगवान्मुहूर्तं स विचिन्त्य तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2012230, "chapter_id": 1249, "verse_number": "१-२५०-३", "content_sanskrit": "उपायः परिदृष्टो मे यथा त्वं धक्ष्यसेऽनघ।\nकालं च कंचित्क्षमतां ततस्तद्धक्ष्यते भवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2012231, "chapter_id": 1249, "verse_number": "१-२५०-४", "content_sanskrit": "भविष्यतः सहायौ ते नरनारायणौ तदा।\nताभ्यां त्वं सहितो दावं धक्ष्यसे हव्यवाहन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2012232, "chapter_id": 1249, "verse_number": "१-२५०-५", "content_sanskrit": "एवमस्त्विति तं वह्निर्ब्रह्माणं प्रत्यभाषत।\nसंभूतौ तौ विदित्वा तु नरनारायणावृषी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2012233, "chapter_id": 1249, "verse_number": "१-२५०-६", "content_sanskrit": "कालस्य महतो राजंस्तस्य वाक्यं स्वयंभुवः।\nअनुस्मृत्य जगामाथ पुनरेव पितामहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2012234, "chapter_id": 1249, "verse_number": "१-२५०-७", "content_sanskrit": "अब्रवीच्च तदा ब्रह्मा यथा त्वं धक्ष्यसेऽनल।\nखाण्डवं दावमद्यैव मिषतोऽस्य शचीपतेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2012235, "chapter_id": 1249, "verse_number": "१-२५०-८", "content_sanskrit": "नरनारायणौ यौ तौ पूर्वदेवौ विभावसो।\nसंप्राप्तौ मानुषे लोके कार्यार्थं हि दिवौकसाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2012236, "chapter_id": 1249, "verse_number": "१-२५०-९", "content_sanskrit": "अर्जुनं वासुदेवं च यौ तौ लोकोऽभिमन्यते।\nतावेतौ सहितावेहि खाण्डवस्य समीपतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2012237, "chapter_id": 1249, "verse_number": "१-२५०-१०", "content_sanskrit": "तौ त्वं याचस्व साहाय्ये दाहार्थं खाण्डवस्य च।\nततो धक्ष्यसि तं दावं रक्षितं त्रिदशैरपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2012238, "chapter_id": 1249, "verse_number": "१-२५०-११", "content_sanskrit": "तौ तु सत्वानि सर्वाणि यत्नतो वारयिष्यतः।\nदेवराजं च सहितौ तत्र मे नास्ति संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2012239, "chapter_id": 1249, "verse_number": "१-२५०-१२", "content_sanskrit": "एतच्छ्रुत्वा तु वचनं त्वरितो हव्यवाहनः।\nकृष्णपार्थावुपागम्य यमर्थं त्वभ्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2012240, "chapter_id": 1249, "verse_number": "१-२५०-१३", "content_sanskrit": "तं ते कथितवानस्मि पूर्वमेव नृपोत्तम।\nतच्छ्रुत्वा वचनं त्वग्नेर्बीभत्सुर्जातवेदसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2012241, "chapter_id": 1249, "verse_number": "१-२५०-१४", "content_sanskrit": "अब्रवीन्नृपशार्दूल तत्कालसदृशं वचः।\nदिधक्षुं खाण्डवं दावमकामस्य शतक्रतोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2012242, "chapter_id": 1249, "verse_number": "१-२५०-१५x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2012243, "chapter_id": 1249, "verse_number": "१-२५०-१५", "content_sanskrit": "उत्तमास्त्राणि मे सन्ति दिव्यानि च बहूनि च।\nयैरहं शक्नुयां योद्धुमपि वज्रधरान्बहून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2012244, "chapter_id": 1249, "verse_number": "१-२५०-१६", "content_sanskrit": "धनुर्मे नास्ति भगवन्बाहुवीर्येण संमितम्।\nकुर्वतः समरे यत्नं वेगं यद्विषहेन्मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2012245, "chapter_id": 1249, "verse_number": "१-२५०-१७", "content_sanskrit": "शरैश्च मेऽर्थो बहुभिरक्षयैः क्षिप्रमस्यतः।\nन हि वोढुं रथः शक्तः शरान्मम यथेप्सितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2012246, "chapter_id": 1249, "verse_number": "१-२५०-१८", "content_sanskrit": "अश्वांश्च दिव्यानिच्छेयं पाण्डुरान्वातरंहसः।\nरथं च मेघनिर्घोषं सूर्यप्रतिमतेजसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2012247, "chapter_id": 1249, "verse_number": "१-२५०-१९", "content_sanskrit": "तथा कृष्णस्य वीर्येण नायुधं विद्यते समम्।\nयेन नागान्पिशाचांश्च निहन्यान्माधवो रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2012248, "chapter_id": 1249, "verse_number": "१-२५०-२०", "content_sanskrit": "उपायं कर्मसिद्धौ च भघवन्वक्तुमर्हसि।\nनिवारयेयं येनेन्द्रं वर्षमाणं महावने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2012249, "chapter_id": 1249, "verse_number": "१-२५०-२१", "content_sanskrit": "पौरुषेण तु यत्कार्यं तत्कर्ताऽहं स्म पावक।\nकरणानि समर्थानि भगवन्दातुमर्हसि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2012250, "chapter_id": 1249, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि खाण्डवदाहपर्वणि पञ्चाशदधिकद्विशततमोऽध्यायः॥ २५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]