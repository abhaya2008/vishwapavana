[{"id": 2125936, "chapter_id": 3698, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2125937, "chapter_id": 3698, "verse_number": "१", "content_sanskrit": "ततो देवाः सगन्धर्वाः समादायार्घ्यमुत्तमम् ।\nशक्रस्य मतमाज्ञाय पार्थमानेमुरञ्जसा\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2125938, "chapter_id": 3698, "verse_number": "२", "content_sanskrit": "पाद्यमाचमनीयं च प्रतिगृह्य नृपात्मजम् ।\nप्रवेशयामासुरथो पुरन्दरनिवेशनम् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2125939, "chapter_id": 3698, "verse_number": "३", "content_sanskrit": "एवं सम्पूजितो जिष्णुरुवास भवने पितुः ।\nउपशिक्षन् महास्त्राणि ससंहाराणि पाण्डवः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2125940, "chapter_id": 3698, "verse_number": "४", "content_sanskrit": "शक्रस्य हस्ताद् दयितं वज्रमस्त्रं सुदारुणम् ।\nअशनीश्च महानादा मेघबर्हिणलक्षणाः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2125941, "chapter_id": 3698, "verse_number": "५", "content_sanskrit": "गृहीतास्त्रस्तु कौन्तेयो भ्रातॄन् सस्मार पाण्डवः ।\nपुरन्दरनियोगाच्च पञ्चाब्दमवसत् सुखी\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2125942, "chapter_id": 3698, "verse_number": "६", "content_sanskrit": "ततः शक्रोऽब्रवीत् पार्थं कृतास्त्रं काल आगते ।\nनृत्तं गीतं च कौन्तेय चित्रसेनादवाप्नुहि\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2125943, "chapter_id": 3698, "verse_number": "७", "content_sanskrit": "वादित्रं देवविहितं नृलोके यन्न विद्यते ।\nतदार्जयस्व कौन्तेय श्रेयो वै ते भविष्यति\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2125944, "chapter_id": 3698, "verse_number": "८", "content_sanskrit": "सखायं प्रददौ चास्य चित्रसेनं पुरन्दरः ।\nस तेन सह सङ्गम्य रेमे पार्थो निरामयः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2125945, "chapter_id": 3698, "verse_number": "९", "content_sanskrit": "कदाचित् स हि देवेन्द्रश्चित्रसेनं रहोऽब्रवीत् ।\nपार्थस्य तस्य विज्ञाय सक्तं चक्षुः प्रसङ्गतः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2125946, "chapter_id": 3698, "verse_number": "१०", "content_sanskrit": "गन्धर्वराजाद्य मया प्रहिताऽप्सरसां वरा ।\nकटाक्षेण च माधुर्यै रूपभावैः सविभ्रमैः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2125947, "chapter_id": 3698, "verse_number": "११", "content_sanskrit": "एषाद्य फल्गुनेनेह नृत्यन्ती प्रेषिता किल ।\nउर्वशी पुरुषव्याघ्रं उपतिष्ठतु फल्गुनम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2125948, "chapter_id": 3698, "verse_number": "१२", "content_sanskrit": "यथा च तामभिसृतां विद्यादस्मन्नियोगगाम् ।\nतथा त्वया विधातव्यं स्त्रीसंसर्गविशारद \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2125949, "chapter_id": 3698, "verse_number": "१३", "content_sanskrit": "एवमुक्तस्तथेत्युक्त्वा सोऽनुज्ञां प्राप्य वासवात् ।\nगन्धर्वराजोऽप्सरसमभ्यगादुर्वशीं वराम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2125950, "chapter_id": 3698, "verse_number": "१४", "content_sanskrit": "तां दृष्ट्वाऽविदिते हृष्टः स्वागतेनार्चितस्तया ।\nसुखासीनां सुखासीनः स्मितपूर्वं वचोऽब्रवीत्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2125951, "chapter_id": 3698, "verse_number": "१५", "content_sanskrit": "विदितं तेऽस्तु सुश्रोणि प्रेषितोऽहमुपागतः ।\nत्रिदिवस्यैकराजेन त्वत्प्रसादाभिनन्दिना \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2125952, "chapter_id": 3698, "verse_number": "१६", "content_sanskrit": "यः स देवमनुष्येषु प्रख्यातः सहजैर्गुणैः ।\nश्रिया शीलेन रूपेण श्रुतेन च बलेन च \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2125953, "chapter_id": 3698, "verse_number": "१७", "content_sanskrit": "प्रख्यातः शौर्यवीर्याभ्यां सम्पन्नः प्रतिभानवान् ।\nतेजस्वी सौम्यशीलश्च क्षमावान् जितमत्सरः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2125954, "chapter_id": 3698, "verse_number": "१८", "content_sanskrit": "साङ्गोपनिषदान् वेदान् गुरुशुश्रूषुरात्मवान् ।\nयोऽधीते चतुरः सर्वान् मेधावी गुणवानिह\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2125955, "chapter_id": 3698, "verse_number": "१९", "content_sanskrit": "ब्रह्मचर्येण दाक्ष्येण प्रश्रयैः स्वधिया च यः।\nएको हि रक्षिता चैव त्रिदशान् मघवानिव \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2125956, "chapter_id": 3698, "verse_number": "२०", "content_sanskrit": "अकत्थनो मानयिता स्थूलाक्षः प्रियवाक् सुहृत् ।\nसुहृदश्चान्नपानेन विविधेनाभिवर्षति\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2125957, "chapter_id": 3698, "verse_number": "२१", "content_sanskrit": "सत्यवागूर्जितो वक्ता रूपवाननहङ्कृतः ।\nभक्तानुकम्पी कान्तश्च प्रियोऽद्य स्थिरसङ्गरः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2125958, "chapter_id": 3698, "verse_number": "२२", "content_sanskrit": "श्लाघनीयो गुणगणैर्महेन्द्रवरुणोपमः ।\nविदितस्तेऽर्जुनो वीरः स स्वर्गफलमाप्तवान् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2125959, "chapter_id": 3698, "verse_number": "२३", "content_sanskrit": "तव शक्राभ्यनुज्ञाता पादावद्य प्रपद्यताम् ।\nतदेवं कुरु कल्याणि प्रपन्नस्त्वां धनञ्जयः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2125960, "chapter_id": 3698, "verse_number": "२४", "content_sanskrit": "एवमुक्ता स्मितं कृत्वा सन्मानं बहुमान्य च ।\nप्रत्युवाचोर्वशी प्रीता चित्रसेनमनिन्दिता\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2125961, "chapter_id": 3698, "verse_number": "२५", "content_sanskrit": "यस्तस्य कथितः सत्यो गुणोद्देशस्त्वयाऽनघ ।\nतं श्रुत्वाऽद्य प्रियं नारी वृणुयात् किमतोऽर्जुनम्\t ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2125962, "chapter_id": 3698, "verse_number": "२६", "content_sanskrit": "महेन्द्रस्य नियोगेन त्वत्तः सम्प्रेषणेन च ।\nतस्य चाहं गुणौघेन फल्गुने जातमन्मथा ।\nगच्छ त्वं हि यथाकाममागमिष्याम्यहं सखे \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2125963, "chapter_id": 3698, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2125964, "chapter_id": 3698, "verse_number": "२७", "content_sanskrit": "ततो विसृज्य गन्धर्वं कृतकृत्यं शुचिस्मिता ।\nउर्वशी साऽकरोन्मानं पार्थप्रार्थनलालसा\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2125965, "chapter_id": 3698, "verse_number": "२८", "content_sanskrit": "स्नानालङ्कारनैपथ्यैर्गन्धमाल्यैश्च शोभनैः ।\nधनञ्जयस्य रूपेण शक्रस्याभ्यर्थनेन च \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2125966, "chapter_id": 3698, "verse_number": "२९", "content_sanskrit": "वाक्यैश्च चित्रसेनस्य मन्मथेन च पीडिता ।\nदिव्यास्तरणसंस्तीर्णे विस्तीर्णे शयनोत्तमे\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2125967, "chapter_id": 3698, "verse_number": "३०", "content_sanskrit": "चित्तसङ्कल्पभावेन सुचित्ताऽनन्यमानसा ।\nमनोरथेन सम्प्राप्तं कामयत्येव फल्गुनम् \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2125968, "chapter_id": 3698, "verse_number": "३१", "content_sanskrit": "निशाम्य चन्द्रोदयनं विगाढे रजनीमुखे ।\nप्रस्थिता सा पृथुश्रोणी पार्थस्य भवनं प्रति\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2125969, "chapter_id": 3698, "verse_number": "३२", "content_sanskrit": "मृदुकुञ्चितदीर्घेण कुसुमोत्तमधारिणा ।\nकेशपाशेन ललना गच्छमाना व्यराजत\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2125970, "chapter_id": 3698, "verse_number": "३३", "content_sanskrit": "भ्रूक्षेपालापमाधुर्यैः कान्त्या सौम्यतयाऽपि च ।\nशशिनं वक्रचन्द्रेण आह्वयन्तीव गच्छती \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2125971, "chapter_id": 3698, "verse_number": "३४", "content_sanskrit": "दिव्याङ्गरागौ रुचिरौ दिव्यचन्दनरूषितौ ।\nगच्छन्त्या हारविकचौ स्तनौ तस्या ववल्गतुः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2125972, "chapter_id": 3698, "verse_number": "३५", "content_sanskrit": "स्तनोद्वहनसङ्क्षोभात् ताम्यमाना पदे पदे ।\nत्रिवलीदामचित्रेण मध्येनातीव शोभना\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2125973, "chapter_id": 3698, "verse_number": "३६", "content_sanskrit": "रथकूबरविस्तीर्णं नितम्बोन्नतपीवरम् ।\nमन्मथायतनं शुभ्ररशनादामशोभितम् \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2125974, "chapter_id": 3698, "verse_number": "३७", "content_sanskrit": "ऋषीणामपि दिव्यानां मनोव्याघातकारकम् ।\nसूक्ष्मवस्त्रावृतं भाति जघनं चानवद्यया\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2125975, "chapter_id": 3698, "verse_number": "३८", "content_sanskrit": "गूढगुल्फशिरौ पादौ ताम्रायततळाङ्गुली ।\nकूर्मपृष्ठोन्नतौ चास्याः शोभेते किङ्किणीकिणौ\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2125976, "chapter_id": 3698, "verse_number": "३९", "content_sanskrit": "शीधुपानेन चाल्पेन तुष्टा च मदनेन च ।\nविलासितैश्च विविधैः प्रेक्षणीयतराऽभवत्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2125977, "chapter_id": 3698, "verse_number": "४०", "content_sanskrit": "सिद्धचारणगन्धर्वैः साग्रैर्याति विलासिनी ।\nबह्वाश्चर्यपदे स्वर्गे साऽऽश्चर्यमिव दृश्यते\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2125978, "chapter_id": 3698, "verse_number": "४१", "content_sanskrit": "सुसूक्ष्मेणोत्तरीयेण मेघवर्णेन राजता ।\nतन्वभ्रप्रावृता व्योम्नि चन्द्रलेखेव गच्छति\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2125979, "chapter_id": 3698, "verse_number": "४२", "content_sanskrit": "ततः प्राप्ताऽतिदुष्प्रापा मनसाऽपि विकर्मभिः ।\nभवनं पाण्डुपुत्रस्य फल्गुनस्य गुणाधिका\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2125980, "chapter_id": 3698, "verse_number": "४३", "content_sanskrit": "तत्र द्वारमनुप्राप्ता द्वारस्थैश्च निवेदिता ।\nपरमाऽप्सरसां तत्र पार्थायायतलोचना\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2125981, "chapter_id": 3698, "verse_number": "४४", "content_sanskrit": "तां दृष्ट्वा पाण्डुतनयः शयनादुत्थितो बली ।\nअशङ्कितमना राजन् प्रत्यगच्छत तां निशि \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2125982, "chapter_id": 3698, "verse_number": "४५", "content_sanskrit": "दृष्ट्वैव चोर्वशीं पार्थो लज्जासंवृतलोचनः ।\nपादाभिवन्दनं कृत्वा गुरुपूजां प्रयुक्तवान्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2125983, "chapter_id": 3698, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2125984, "chapter_id": 3698, "verse_number": "४६", "content_sanskrit": "अभिवादये त्वां शिरसा प्रमदेऽप्सरसां वरे ।\nकिं चागमनकृत्यं ते ब्रूहि सर्वं यथातथम्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2125985, "chapter_id": 3698, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2125986, "chapter_id": 3698, "verse_number": "४७", "content_sanskrit": "अकामं फल्गुनं ज्ञात्वा इङ्गितज्ञा तदोर्वशी ।\nगन्धर्ववचनं सर्वं श्रावयामास फल्गुनम्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2125987, "chapter_id": 3698, "verse_number": "", "content_sanskrit": "उर्वशी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2125988, "chapter_id": 3698, "verse_number": "४८", "content_sanskrit": "यथा मे चित्रसेनेन कथितं मनुजोत्तम ।\nतत्ते सर्वं प्रवक्ष्यामि यथा चाहमिहागता\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2125989, "chapter_id": 3698, "verse_number": "४९", "content_sanskrit": "उपस्थाने महेन्द्रस्य वर्तमाने मनोरमे ।\nत्वदागमनतुष्ट्या च स्वर्गस्य परमोत्सवे\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2125990, "chapter_id": 3698, "verse_number": "५०", "content_sanskrit": "रुद्राणां चैव सान्निध्ये आदित्यानां च सर्वशः ।\nसमागमेऽश्विनोश्चापि वसूनां च नरोत्तम\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2125991, "chapter_id": 3698, "verse_number": "५१", "content_sanskrit": "महर्षीणां च सङ्घेषु राजर्षिप्रवरेषु च ।\nसिद्धचारणयक्षेषु महोरगगणेषु च \t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2125992, "chapter_id": 3698, "verse_number": "५२", "content_sanskrit": "उपविष्टेषु हृष्टेषु स्थानमानप्रभावतः ।\nऋद्ध्या प्रज्वलमानेषु अग्नीषोमार्कवर्ष्मसु\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2125993, "chapter_id": 3698, "verse_number": "५३", "content_sanskrit": "वीणासु वाद्यमानासु गन्धर्वैः शक्रनन्दन ।\nदिव्ये मनोरमे गीते प्रवृत्ते पृथुलोचन\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2125994, "chapter_id": 3698, "verse_number": "५४", "content_sanskrit": "सर्वाप्सरस्समस्यासु प्रवृत्तासु कुरूत्तम ।\nत्वं किलानिमिषः पार्थ मामेकां तत्र दृष्टवान्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2125995, "chapter_id": 3698, "verse_number": "५५", "content_sanskrit": "तत्र चावभृथे तस्मिन्नुपस्थाने दिवौकसाम् ।\nतव पित्राऽभ्यनुज्ञाता गताः स्वनिलयान् सुराः \t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2125996, "chapter_id": 3698, "verse_number": "५६", "content_sanskrit": "तथैवाप्सरसः सर्वा विसृष्टा निलयं गताः ।\nअहं चान्याश्च शत्रुघ्न तव पित्रा विसर्जिताः\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2125997, "chapter_id": 3698, "verse_number": "५७", "content_sanskrit": "ततः शक्रेण सन्दिष्टः चित्रसेनो ममान्तिकम् ।\nप्राप्तः कमलपत्राक्ष स च मामब्रवीदिदम्\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2125998, "chapter_id": 3698, "verse_number": "५८", "content_sanskrit": "त्वत्कृतेऽहं सुरेशेन प्रेषितो वरवर्णिनि ।\nप्रियं कुरु महेन्द्रस्य मम चैवात्मनश्च ह\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2125999, "chapter_id": 3698, "verse_number": "५९", "content_sanskrit": "शक्रतुल्यं रणे शूरं रूपौदार्यगुणान्वितम् ।\nपार्थं प्रार्थय सुश्रोणि त्वमित्येवं स माऽब्रवीत् \t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2126000, "chapter_id": 3698, "verse_number": "६०", "content_sanskrit": "ततोऽहं समनुज्ञाता तेन पित्रा च तेऽनघ ।\nतवान्तिकमनुप्राप्ता शुश्रूषितुमरिन्दम\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2126001, "chapter_id": 3698, "verse_number": "६१", "content_sanskrit": "न केवलं हि शक्रेण प्रेषिता चाहमागता ।\nचिराभिलषितो वीर ममाप्येष मनोरथः\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2126002, "chapter_id": 3698, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2126003, "chapter_id": 3698, "verse_number": "६२", "content_sanskrit": "तां तथा ब्रुवतीं श्रुत्वा भृशं लज्जान्वितोऽर्जुनः ।\nउवाच कर्णौ हस्ताभ्यां पिधाय त्रिदशोपमः\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2126004, "chapter_id": 3698, "verse_number": "६३", "content_sanskrit": "अश्रुतं मेऽस्तु सुभगे यन्मां वदसि भामिनि ।\nगुरुदारैः समाना हि देववारा वरानने\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2126005, "chapter_id": 3698, "verse_number": "६४", "content_sanskrit": "यच्चेक्षिता हि विस्पष्टं विशेषेण मया शुभे ।\nतच्च मे कारणं सर्वं शृणु सत्येन सुस्मिते\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2126006, "chapter_id": 3698, "verse_number": "६५", "content_sanskrit": "इयं पौरववंशस्य जननी सुदतीति ह ।\nत्वामहं दृष्टवांस्तत्र विस्मयोत्फुल्ललोचनः\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2126007, "chapter_id": 3698, "verse_number": "६६", "content_sanskrit": "न मामर्हसि कल्याणि अन्यथा मन्तुमङ्गने ।\nगुरोर्गुरुतरी मे त्वं मम वंशविवर्धिनी\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2126008, "chapter_id": 3698, "verse_number": "", "content_sanskrit": "उर्वशी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2126009, "chapter_id": 3698, "verse_number": "६७", "content_sanskrit": "अनावृता वयं सर्वा देववारा वरानन ।\nगुरुस्थाने न मां वीर नियोक्तुं त्वमिहार्हसि\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2126010, "chapter_id": 3698, "verse_number": "६८", "content_sanskrit": "पितरः सोदराः पुत्रा नप्तारो वाऽऽगता इह ।\nतपसा रमयन्त्यस्मान् न चास्त्येषां व्यतिक्रमः\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2126011, "chapter_id": 3698, "verse_number": "६९", "content_sanskrit": "तत् प्रसीद न मामार्तां विसर्जयितुमर्हसि ।\nहृच्छयेन सुसम्प्राप्तां भक्तां त्वं भज माऽनघ\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2126012, "chapter_id": 3698, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2126013, "chapter_id": 3698, "verse_number": "७०", "content_sanskrit": "शृणु सत्यं वरारोहे यत्त्वां वक्ष्याम्यनिन्दिते ।\nशृण्वन्तु मे दिशश्चैव विदिशश्च सदेवताः\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2126014, "chapter_id": 3698, "verse_number": "७१", "content_sanskrit": "यथा कुन्ती च माद्री च शची चैव समा इह ।\nतथा त्वं वंशजननी त्वं हि मेऽद्य गरीयसी\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2126015, "chapter_id": 3698, "verse_number": "७२", "content_sanskrit": "गच्छ मूर्ध्ना प्रपन्नोऽस्मि पादौ ते वरवर्णिनि ।\nत्वं हि मे मातृवत् पूज्या रक्ष्योऽहं पुत्रवत् त्वया\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2126016, "chapter_id": 3698, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2126017, "chapter_id": 3698, "verse_number": "७३", "content_sanskrit": "तथाऽवधूता पार्थेन उर्वशी क्रोधमूर्च्छिता ।\nवेपन्ती भ्रुकुटीः कृत्वा शशापाथ धनञ्जयम्\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2126018, "chapter_id": 3698, "verse_number": "७४", "content_sanskrit": "तव पित्राऽभ्यनुज्ञातां स्वयं च गृहमागताम् ।\nयस्मान्मां नाभिनन्देथाः कामबाणवशं गताम्\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2126019, "chapter_id": 3698, "verse_number": "७५", "content_sanskrit": "तस्मात्त्वं नर्तकः पार्थ स्त्रीमध्ये मानवर्जितः ।\nअपुमानिति विख्यातः षण्डवद् विचरिष्यसि\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2126020, "chapter_id": 3698, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2126021, "chapter_id": 3698, "verse_number": "७६", "content_sanskrit": "एवं दत्त्वाऽर्जुने शापं स्फुरितोष्ठी श्वसन्त्यपि ।\nपुनः प्रत्यागता शीघ्रमुर्वशी स्वं निवेशनम्\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2126022, "chapter_id": 3698, "verse_number": "७७", "content_sanskrit": "पार्थोऽपि लब्ध्वा शापं तं तां निशां दुःखितोऽवसत् ।\nविवक्षुश्चित्रसेनाय प्रातः सर्वमहृष्टवत्\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2126023, "chapter_id": 3698, "verse_number": "७८", "content_sanskrit": "ततः प्रभाते विमले गन्धर्वस्य यथातथम् ।\nनिवेदयामास तदा चित्रसेनस्य फल्गुनः \t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2126024, "chapter_id": 3698, "verse_number": "७९", "content_sanskrit": "तच्च सर्वं यथावृत्तं शापं चैव यथातथम् ।\nअवेदयच्च शक्रस्य चित्रसेनोऽपि सर्वशः\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2126025, "chapter_id": 3698, "verse_number": "८०", "content_sanskrit": "तदा त्वानाय्य तनयं विविक्ते हरिवाहनः ।\nसान्त्वयित्वा शुभैर्वाक्यैः स्मयमानोऽभ्यभाषत\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2126026, "chapter_id": 3698, "verse_number": "८१", "content_sanskrit": "सुपुत्राऽद्य पृथा तात त्वया पुरुषसत्तम ।\nऋषयोऽपि हि धैर्येण जिता वै ते महाभुज\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2126027, "chapter_id": 3698, "verse_number": "८२", "content_sanskrit": "यं च दत्तवती शापमुर्वशी तव मानद ।\nस चापि तेऽर्थकृत्तात साधकश्च भविष्यति\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2126028, "chapter_id": 3698, "verse_number": "८३", "content_sanskrit": "अज्ञातवासो वस्तव्यो भवद्भिर्भूतळेऽनघ ।\nवर्षे त्रयोदशे वीर तत्र त्वं गमयिष्यसि \t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2126029, "chapter_id": 3698, "verse_number": "८४", "content_sanskrit": "तेन नर्तकवेषेण अपुंसाऽऽत्म्येन वै भव ।\nवर्षमेकं विहृत्यैवं ततः पुंस्त्वमवाप्स्यसि\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2126030, "chapter_id": 3698, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2126031, "chapter_id": 3698, "verse_number": "८५", "content_sanskrit": "एवमुक्तस्तु शक्रेण फल्गुनः परवीरहा ।\nमुदं परमिकां लेभे न च शापमचिन्तयत्\t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2126032, "chapter_id": 3698, "verse_number": "८६", "content_sanskrit": "चित्रसेनेन सहितो गन्धर्वेण यशस्विना ।\nकृतवान् शक्रसदने पाण्डुपुत्रो धनञ्जयः ।\nनृत्तं गेयं च विविधं शिक्षयामास पाण्डवः\t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2126033, "chapter_id": 3698, "verse_number": "८७", "content_sanskrit": "य इमां शृणुयान्नित्यं धृतिं पाण्डुसुतस्य वै ।\nन तस्य कामः कामेषु पापकेषु प्रवर्तते\t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2126034, "chapter_id": 3698, "verse_number": "८८", "content_sanskrit": "य इदममरवरात्मजस्य घोरां\nधृतिमचलां च धनञ्जयस्य श्रुत्वा ।\nव्यपगतभयदम्भरागदोषाः\nत्रिदिवगता रमयन्ति मानवेन्द्राः\t॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2126035, "chapter_id": 3698, "verse_number": "३", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि चत्वारिंशोऽध्यायः ॥४०॥ इन्द्रलोकाभिगमनपर्वणि तृतीयोऽध्यायः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2126036, "chapter_id": 3698, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}]