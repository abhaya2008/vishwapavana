[{"id": 2092026, "chapter_id": 2958, "verse_number": "१३-८८-१", "content_sanskrit": "युधिष्ठिर उवाच।\nतस्मिन्नन्तर्हिते विप्रे राजा किमकरोत्तदा।\nभार्या चास्य महाभागा तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2092027, "chapter_id": 2958, "verse_number": "१३-८८-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2092028, "chapter_id": 2958, "verse_number": "१३-८८-२", "content_sanskrit": "अदृष्ट्वा स महीपालस्तमृषिं सह भार्यया।\nपरिश्रान्तो निववृते व्रीडितो नष्टचेतनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2092029, "chapter_id": 2958, "verse_number": "१३-८८-३", "content_sanskrit": "स प्रविश्य पुरीं दीनो नाभ्यभाषत किञ्चन।\nतदेव चिन्तयामास च्यवनस्य विचेष्टितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2092030, "chapter_id": 2958, "verse_number": "१३-८८-४", "content_sanskrit": "अथ शून्येन मनसा प्रविवेश गृहं नृपः।\nददर्श शयने तस्मिञ्शयानं भृगुनन्दनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2092031, "chapter_id": 2958, "verse_number": "१३-८८-५", "content_sanskrit": "विस्मितौ तमृषिं दृष्ट्वा तदाश्चर्यं विचिन्त्य च।\nदर्शनात्तस्य तु तदा विश्रान्तौ सम्बभूवतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2092032, "chapter_id": 2958, "verse_number": "१३-८८-६", "content_sanskrit": "यथास्थानं ततो गत्वा तत्पादौ संववाहतुः।\nअथापरेण पार्श्वेन सुष्वाप स महामुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2092033, "chapter_id": 2958, "verse_number": "१३-८८-७", "content_sanskrit": "तेनैव च स कालेन प्रत्यबुद्ध्यत वीर्यवान्।\nन च तौ चक्रतुः किञ्चिद्विकारं भयशङ्कितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2092034, "chapter_id": 2958, "verse_number": "१३-८८-८", "content_sanskrit": "प्रतिबुद्धस्तु स मुनिस्तौ प्रोवाच विशाम्पते।\nतैलाभ्यङ्गो दीयतां मे स्नास्येऽहमिति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2092035, "chapter_id": 2958, "verse_number": "१३-८८-९", "content_sanskrit": "तौ तथेति प्रतिश्रुत्य क्षुधितौ श्रमकर्शितौ।\nशतपाकेन तैलेन महार्हेणोपतस्थतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2092036, "chapter_id": 2958, "verse_number": "१३-८८-१०", "content_sanskrit": "ततः सुखासीनमृषिं वाग्यतौ संववाहतुः।\nन च पर्याप्तमित्याह भार्गवः सुमहातपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2092037, "chapter_id": 2958, "verse_number": "१३-८८-११", "content_sanskrit": "यदा तौ निर्विकारौ तु लक्षमायास भार्गवः।\nतत उत्थाय सहसा स्नानशालां विवेश ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2092038, "chapter_id": 2958, "verse_number": "१३-८८-१२", "content_sanskrit": "क्लृप्तमेव तु तत्रासीत्स्नानीयं पार्थिवोचितम्।\nअसत्कृत्य च तत्सर्वं तत्रैवान्तरधीयत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2092039, "chapter_id": 2958, "verse_number": "१३-८८-१३", "content_sanskrit": "स मुनिः पुनरेवाथ नृपतेः पश्यतस्तदा।\nनासूयां चक्रतुस्तौ च दम्पती भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2092040, "chapter_id": 2958, "verse_number": "१३-८८-१४", "content_sanskrit": "अथ स्नातः स भगवान्सिंहासनगतः प्रभुः।\nदर्शयामास कुशिकं सभार्यं कुरुनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2092041, "chapter_id": 2958, "verse_number": "१३-८८-१५", "content_sanskrit": "संहृष्टवदनो राजा सभार्यः कुशिको मुनिम्।\nसिद्धमन्नमिति प्रह्वो निर्विकारो न्यवेदयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2092042, "chapter_id": 2958, "verse_number": "१३-८८-१६", "content_sanskrit": "आनीयतामिति मुनिस्तं चोवाच नराधिपम्।\nस राजा समुपाजह्रे तदन्नं सह भार्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2092043, "chapter_id": 2958, "verse_number": "१३-८८-१७", "content_sanskrit": "मांसप्रकारान्विविधाञ्शाकानि विविधानि च।\nलेह्यपिष्टविकारांश्च पानकानि लघूनि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2092044, "chapter_id": 2958, "verse_number": "१३-८८-१८", "content_sanskrit": "रसालापूपकांश्चित्रान्मोदकानथ षड्रसान्।\nरसान्नानाप्रकारांश्च वन्यं च मुनिभोजनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2092045, "chapter_id": 2958, "verse_number": "१३-८८-१९", "content_sanskrit": "फलानि च विचित्राणि राजभोज्यानि भूरिशः।\nबदरेङ्गुदकाश्मर्यभल्लातकफलानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2092046, "chapter_id": 2958, "verse_number": "१३-८८-२०", "content_sanskrit": "गृहस्थानां च यद्भोज्यं यच्चापि वनवासिनाम्।\nसर्वमाहारयामास राजा शापभयान्मुनेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2092047, "chapter_id": 2958, "verse_number": "१३-८८-२१", "content_sanskrit": "अथ सर्वमुपन्यस्तमग्रतश्च्यवनस्य तत्।\nततः सर्वं समानीय तच्च शय्यासनं मुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2092048, "chapter_id": 2958, "verse_number": "१३-८८-२२", "content_sanskrit": "वस्त्रैः शुभैरवच्छाद्य भोजनोपस्करैः सह।\nसर्वमादीपयामास च्यवनो भृगुनन्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2092049, "chapter_id": 2958, "verse_number": "१३-८८-२३", "content_sanskrit": "न च तौ चक्रतुः क्रोधं दम्पती सुमहाव्रतौ।\nतयोः सम्प्रेक्षतोरेव पुनरन्तर्हितोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2092050, "chapter_id": 2958, "verse_number": "१३-८८-२४", "content_sanskrit": "तथैव च स राजर्षिस्तस्थौ तां रजनीं तदा।\nसभार्यो वाग्यतः श्रीमान्न चकोपं समाविशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2092051, "chapter_id": 2958, "verse_number": "१३-८८-२५", "content_sanskrit": "नित्यसंस्कृतमन्नं तु विविधं राजवेश्मनि॥\nशयनानि च मुख्यानि परिषेकाश्च पुष्कलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2092052, "chapter_id": 2958, "verse_number": "१३-८८-२६", "content_sanskrit": "वस्त्रं च विविधाकारमभवत्समुपार्जितम्।\nन शशाक ततो द्रष्टमन्तरं च्यवनस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2092053, "chapter_id": 2958, "verse_number": "१३-८८-२७", "content_sanskrit": "पुनरेव च विप्रर्षिः प्रोवाच कुशिकं नृपम्।\nसभार्यो मां रथेनाशु वह यत्र ब्रवीम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2092054, "chapter_id": 2958, "verse_number": "१३-८८-२८", "content_sanskrit": "तथेति च प्राह नृपो निर्विशङ्कस्तपोधनम्।\nक्रीडारथोस्तु भगवन्नुत साङ्ग्रामिको रथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2092055, "chapter_id": 2958, "verse_number": "१३-८८-२९", "content_sanskrit": "इत्युक्तः स मुनी राज्ञा तेन हृष्टेन तद्वचः।\nच्यवनः प्रत्युवाचेदं हृष्टः परपुरंजयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2092056, "chapter_id": 2958, "verse_number": "१३-८८-३०", "content_sanskrit": "सज्जीकुरु रथं क्षिप्रं यस्ते साङ्ग्रामिको मतः।\nसायुधः सपताकश्च शक्तीकनकयष्टिमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2092057, "chapter_id": 2958, "verse_number": "१३-८८-३१", "content_sanskrit": "किंकिणीस्वननिर्घोषो युक्तस्तोरणकल्पनैः।\nगदास्वङ्गनिबद्धश्च परमेषुशतान्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2092058, "chapter_id": 2958, "verse_number": "१३-८८-३२", "content_sanskrit": "ततः स तं तथेत्युक्त्वा कल्पयित्वा महारथम्।\nभार्यां वामे धुरि तदा चात्मानं दक्षिणे तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2092059, "chapter_id": 2958, "verse_number": "१३-८८-३३", "content_sanskrit": "त्रिदण्डं वज्रसूच्यग्रं प्रतोदं तत्र चादधत्।\nसर्वमेतत्तथा दत्त्वा नृपो वाक्यमऽथाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2092060, "chapter_id": 2958, "verse_number": "१३-८८-३४", "content_sanskrit": "भगवन्क्व रथो यातु ब्रवीतु भृगुनन्दन।\nयत्र वक्ष्यसि विप्रर्षे तत्र यास्यति ते रथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2092061, "chapter_id": 2958, "verse_number": "१३-८८-३५", "content_sanskrit": "एवमुक्तस्तु भगवान्प्रत्युवाचाथ तं नृपम्।\nइतः प्रभृति यातव्यं पदकम्पदकं शनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2092062, "chapter_id": 2958, "verse_number": "१३-८८-३६", "content_sanskrit": "श्रमो मम यथा न स्यात्तथा मच्छन्दचारिणौ।\nसुसुखं चैव वोढव्यो जनः सर्वश्च पश्यतु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2092063, "chapter_id": 2958, "verse_number": "१३-८८-३७", "content_sanskrit": "नोत्सार्याः पथिकाः केचित्तेभ्योदास्ये वसु ह्यहम्।\nब्राह्मणेभ्यश्च ये कामानर्थयिष्यन्तिमां पथि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2092064, "chapter_id": 2958, "verse_number": "१३-८८-३८", "content_sanskrit": "सर्वान्दास्याम्यशेषेण धनं रत्नानि चैव हि।\nक्रियतां निखिलेनैतन्मा विचारय पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2092065, "chapter_id": 2958, "verse_number": "१३-८८-३९", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा राजा भृत्यांस्तथाऽब्रवीत्।\nयद्यद्ब्रूयान्मुनिस्तत्तत्सर्वं देयमशङ्कितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2092066, "chapter_id": 2958, "verse_number": "१३-८८-४०", "content_sanskrit": "ततो रत्नान्यनेकानि स्त्रियो युग्यमजाविकम्।\nकृताकृतं च कनकं गजेन्द्राश्चाचलोपमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2092067, "chapter_id": 2958, "verse_number": "१३-८८-४१", "content_sanskrit": "अन्वगच्छन्त तमृषिं राजामात्याश्च सर्वशः।\nहाहाभूतं च तत्सर्वमासीन्नगरमार्तवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2092068, "chapter_id": 2958, "verse_number": "१३-८८-४२", "content_sanskrit": "तौ तीक्ष्णाग्रेण सहसा प्रतोदेन प्रतोदितौ।\nपृष्ठे विद्धौ कटे चैव निर्विकारौ तमूहतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2092069, "chapter_id": 2958, "verse_number": "१३-८८-४३", "content_sanskrit": "वेपमानौ निराहारौ पञ्चाशद्रात्रकर्शितौ।\nकथंचिदूहतुर्धैर्याद्दम्पती तं रथोत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2092070, "chapter_id": 2958, "verse_number": "१३-८८-४४", "content_sanskrit": "बहुशो भृशविद्धौ तौ क्षरमाणौ क्षतोद्भवम्।\nददृशाते महाराज पुष्पिताविव किंशुकौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2092071, "chapter_id": 2958, "verse_number": "१३-८८-४५", "content_sanskrit": "तौ दृष्ट्वा पौरवर्गस्तु भृशं शोकसमाकुलः।\nअभिशापभयत्रस्तो न तं किञ्चिदुवाच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2092072, "chapter_id": 2958, "verse_number": "१३-८८-४६", "content_sanskrit": "द्वन्द्वशश्चाब्रुवन्सर्वे पश्यध्वं तपसो बलम्।\nक्रुद्धा अपि मुनिश्रेष्ठं वीक्षितुं नेह शुक्नुमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2092073, "chapter_id": 2958, "verse_number": "१३-८८-४७", "content_sanskrit": "अहो भगवतो वीर्यं महर्षेर्भावितात्मनः।\nराज्ञश्चापि सभार्यस्य धैर्यं पश्यत यादृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2092074, "chapter_id": 2958, "verse_number": "१३-८८-४८", "content_sanskrit": "श्रान्तावपि हि कच्छ्रेण रथमेनं समूहतुः।\nन चैतयोर्विकारं वै ददर्शं भृगुनन्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2092075, "chapter_id": 2958, "verse_number": "१३-८८-४९x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2092076, "chapter_id": 2958, "verse_number": "१३-८८-४९", "content_sanskrit": "ततः स निर्विकारौ तु दृष्ट्वा भृगुकुलोद्वहः।\nवसु विश्राणयामास यथा वैश्रवणस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2092077, "chapter_id": 2958, "verse_number": "१३-८८-५०", "content_sanskrit": "तत्रापि राजा प्रीतात्मा यथादिष्टमथाकरोत्।\nततोऽस्य भगवान्प्रीतो बभूव मुनिसत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2092078, "chapter_id": 2958, "verse_number": "१३-८८-५१", "content_sanskrit": "अवतीर्य रथश्रेष्ठाद्दम्पती तौ मुमोच ह।\nविमोच्य चैतौ विधिवत्ततो वाक्यमुवाच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2092079, "chapter_id": 2958, "verse_number": "१३-८८-५२", "content_sanskrit": "स्निग्धगम्भीरया वाचा भार्गवः सुप्रसन्नया।\nददामि वां वरं श्रेष्ठं तं ब्रूतामिति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2092080, "chapter_id": 2958, "verse_number": "१३-८८-५३", "content_sanskrit": "सुकुमारौ च तौ विद्धौ कराभ्यां मुनिसत्तमः।\nपस्पर्शामृतकल्पाभ्यां स्नेहाद्भरतसतम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2092081, "chapter_id": 2958, "verse_number": "१३-८८-५४", "content_sanskrit": "अथाब्रवीन्नृपो वाक्यं श्रमो नास्त्यावयोरिह।\nविश्रान्तौ स्वः प्रभावात्ते ध्यानेनैवेह भार्गव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2092082, "chapter_id": 2958, "verse_number": "१३-८८-५५", "content_sanskrit": "अथ तौ भगवान्प्राह प्रहृष्टश्च्यनस्तदा।\nन वृथा व्याहृतं पूर्वं यन्मया तद्भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2092083, "chapter_id": 2958, "verse_number": "१३-८८-५६", "content_sanskrit": "रमणीयः समुद्देशो गङ्गातीरमिदं शुभम्।\nकिञ्चित्कालं व्रतपरो निवत्स्यामीह पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2092084, "chapter_id": 2958, "verse_number": "१३-८८-५७", "content_sanskrit": "गम्यतां स्वपुरं पुत्र विश्रान्तः पुनरेष्यसि।\nइहस्थं मां सभार्यस्त्वं द्रष्टासि श्वो नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2092085, "chapter_id": 2958, "verse_number": "१३-८८-५८", "content_sanskrit": "न च मन्युस्त्वया कार्यः श्रेयस्त्वां समुपस्थितम्।\nयत्काङ्क्षितं हृदिस्थं ते तत्सर्वं हि भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2092086, "chapter_id": 2958, "verse_number": "१३-८८-५९", "content_sanskrit": "इत्येवमुक्तः कुशिकः प्रहृष्टेनान्तरात्मना।\nप्रोवाच मुनिशार्दूलमिदं वचनमर्थवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2092087, "chapter_id": 2958, "verse_number": "१३-८८-६०", "content_sanskrit": "न मे मन्युर्महाभाग पूतौ स्वो भगवंस्त्वया।\nसंवृतौ यौवनस्थौ स्वो वपुष्मन्तौ बलान्वितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2092088, "chapter_id": 2958, "verse_number": "१३-८८-६१", "content_sanskrit": "प्रतोदेन व्रणा ये मे सभार्यस्य त्वया कृताः।\nतान्न पश्यामि गात्रेषु स्वस्थोस्मि सह भार्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2092089, "chapter_id": 2958, "verse_number": "१३-८८-६२", "content_sanskrit": "इमां च देवीं पश्यामि वपुषाऽप्सरसोपमाम्।\nश्रिया परमया युक्ता तथा दृष्टा पुरा मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2092090, "chapter_id": 2958, "verse_number": "१३-८८-६३", "content_sanskrit": "तव प्रसादसंवृत्तमिदं सर्वं महामुने।\nनैतच्चित्रं तु भगवंस्त्वयि सत्यपराक्रम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2092091, "chapter_id": 2958, "verse_number": "१३-८८-६४", "content_sanskrit": "इत्युक्तः प्रत्युवाचैनं कुशिकं च्यवनस्तदा।\nआगच्छेथाः सभार्यश्च त्वमिहेति नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2092092, "chapter_id": 2958, "verse_number": "१३-८८-६५", "content_sanskrit": "इत्युक्तः समनुज्ञातो राजर्षिरभिवाद्य तम्।\nप्रययौ वपुषा युक्तो नगरं देवराजवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2092093, "chapter_id": 2958, "verse_number": "१३-८८-६६", "content_sanskrit": "तत एनमुपाजग्मुरमात्याः सपुरोहिताः।\nबलस्था गणिकायुक्ताः सर्वाः प्रकृतयस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2092094, "chapter_id": 2958, "verse_number": "१३-८८-६७", "content_sanskrit": "तैर्वृतः कुशिको राजा श्रिया परमया ज्वलन्।\nप्रविवेश पुरं हृष्टः पूज्यमानोऽथ बन्दिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2092095, "chapter_id": 2958, "verse_number": "१३-८८-६८", "content_sanskrit": "ततः प्रविश्य नगरं कृत्वा पौर्वाह्णिकीः क्रियाः।\nभुक्त्वा सभार्यो रजनीमुवास स महाद्युतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2092096, "chapter_id": 2958, "verse_number": "१३-८८-६९", "content_sanskrit": "ततस्तु तौ नवमभिवीक्ष्य यौवनं\nपरस्परं विगतजराविवामरौ।\nननन्दतुः शयनगतौ वपुर्धरौ\nश्रिया युतौ द्विजवरदत्तया तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2092097, "chapter_id": 2958, "verse_number": "१३-८८-७०", "content_sanskrit": "अथाप्युषिर्भृगुकुलकीर्तिवर्धन-\nस्तपोधनो वनमभिराममृद्धिमत्।\nमनीषया बहुविधरत्नभूषितं\nससर्ज यन्न पुरि शतक्रतोरपि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2092098, "chapter_id": 2958, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि अष्टाशीष्टितमोऽध्यायः॥ ८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}]