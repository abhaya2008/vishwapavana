[{"id": 2011451, "chapter_id": 1234, "verse_number": "१-२३५-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2011452, "chapter_id": 1234, "verse_number": "१-२३५-१", "content_sanskrit": "कथयित्वा च तत्सर्वं ब्राह्मणेभ्यः स भारत।\nप्रययौ हिमवत्पार्श्वं ततो वज्रधरात्मजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2011453, "chapter_id": 1234, "verse_number": "१-२३५-२", "content_sanskrit": "अगस्त्यवटमासाद्य वसिष्ठस्य च पर्वतम्।\nभृगुतुङ्गे च कौन्तेयः कृतवाञ्शौचमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2011454, "chapter_id": 1234, "verse_number": "१-२३५-३", "content_sanskrit": "प्रददौ गोसहस्राणि सुबहूनि च भारत।\nनिवेशांश्च द्विजातिभ्यः सोऽददत्कुरुसत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2011455, "chapter_id": 1234, "verse_number": "१-२३५-४", "content_sanskrit": "हिरण्यबिन्दोस्तीर्थे च स्नात्वा पुरुषसत्तमः।\nदृष्टवान्पाण्डवश्रेष्ठः पुण्यान्यायतनानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2011456, "chapter_id": 1234, "verse_number": "१-२३५-५", "content_sanskrit": "अवतीर्य नरश्रेष्ठो ब्राह्मणैः सह भारत।\nप्राचीं दिशमभिप्रेप्सुर्जगाम भरतर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2011457, "chapter_id": 1234, "verse_number": "१-२३५-६", "content_sanskrit": "आनुपूर्व्येण तीर्थानि दृष्टवान्कुरुसत्तमः।\nनदीं चोत्पलिनीं रम्यामरण्यं नैमिषं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2011458, "chapter_id": 1234, "verse_number": "१-२३५-७", "content_sanskrit": "नन्दामपरनन्दां च कौशिकीं च यशस्विनीम्।\nमहानदीं गयां चैव गङ्गामपि च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2011459, "chapter_id": 1234, "verse_number": "१-२३५-८", "content_sanskrit": "एवं तीर्थानि सर्वाणि पश्यमानस्तथाश्रमान्।\nआत्मनः पावनं कुर्वन्ब्राह्मणेभ्यो ददौ च गाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2011460, "chapter_id": 1234, "verse_number": "१-२३५-९", "content_sanskrit": "अङ्गवङ्गकलिङ्गेषु यानि तीर्थानि कानिचित्।\nजगाम तानि सर्वाणि पुण्यान्यायतनानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2011461, "chapter_id": 1234, "verse_number": "१-२३५-१०", "content_sanskrit": "दृष्ट्वा च विधिवत्तानि धनं चापि ददौ ततः।\nकलिङ्गराष्ट्रद्वारेषु ब्राह्मणाः पाण्डवानुगाः।\nअभ्यनुज्ञाय कौन्तेयमुपावर्तन्त भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2011462, "chapter_id": 1234, "verse_number": "१-२३५-११", "content_sanskrit": "स तु तैरभ्यनुज्ञातः कुन्तीपुत्रो धनञ्जयः।\nसहायैरल्पकैः शूरः प्रययौ यत्र सागरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2011463, "chapter_id": 1234, "verse_number": "१-२३५-१२", "content_sanskrit": "स कलिङ्गानतिक्रम्य देशानायतनानि च।\nहर्म्याणि रमणीयानि प्रेक्षणाणो ययौ प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2011464, "chapter_id": 1234, "verse_number": "१-२३५-१३", "content_sanskrit": "महेन्द्रपर्वतं दृष्ट्वा तापसैरुपशोभितम्।\nगोदावर्यां ततः स्नात्वा तामतीत्य महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2011465, "chapter_id": 1234, "verse_number": "१-२३५-१४", "content_sanskrit": "कावेरीं तां समासाद्य सङ्गमे सागरस्य च।\nस्नात्वा संपूज्य देवांश्च पितॄंश्च मुनिभिः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2011466, "chapter_id": 1234, "verse_number": "१-२३५-१५", "content_sanskrit": "समुद्रतीरेण शनैर्मणलूरं जगाम ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2011467, "chapter_id": 1234, "verse_number": "१-२३५-१६", "content_sanskrit": "तत्र सर्वाणि तीर्थानि पुण्यान्यायतनानि च।\nअभिगम्य महाबाहुरभ्यगच्छन्महीपतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2011468, "chapter_id": 1234, "verse_number": "१-२३५-१७", "content_sanskrit": "मणलूरेश्वरं राजन्धर्मज्ञं चित्रवाहनम्।\nतस्य चित्राङ्गदा नाम दुहिता चारुदर्शना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2011469, "chapter_id": 1234, "verse_number": "१-२३५-१८", "content_sanskrit": "तां ददर्श पुरे तस्मिन्विचरन्तीं यदृच्छया।\nदृष्ट्वा च तां वरारोहां चकमे चैत्रवाहनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2011470, "chapter_id": 1234, "verse_number": "१-२३५-१९", "content_sanskrit": "अभिगम्य च राजानमवदत्स्वं प्रयोजनम्।\nदेहि मे खल्विमां राजन्क्षत्रियाय महात्मने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2011471, "chapter_id": 1234, "verse_number": "१-२३५-२०", "content_sanskrit": "तच्छ्रुत्वा त्वब्रवीद्राजा कस्य पुत्रोऽसि नाम किम्।\nउवाच तं पाण्डवोऽहं कुन्तीपुत्रो धनञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2011472, "chapter_id": 1234, "verse_number": "१-२३५-२१", "content_sanskrit": "तमुवाचाथ राजा स सान्त्वपूर्वमिदं वचः।\nराजा प्रभञ्जनो नाम कुलेऽस्मिन्संबभूव ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2011473, "chapter_id": 1234, "verse_number": "१-२३५-२२", "content_sanskrit": "अपुत्रः प्रसवेनार्थी तपस्तेपे स उत्तमम्।\nउग्रेण तपसा तेन देवदेवः पिनाकधृक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2011474, "chapter_id": 1234, "verse_number": "१-२३५-२३", "content_sanskrit": "ईश्वरस्तोषितः पार्थ देवदेवः उमापतिः।\nस तस्मै भघवान्प्रादादेकैकं प्रसवं कुले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2011475, "chapter_id": 1234, "verse_number": "१-२३५-२४", "content_sanskrit": "एकैकः प्रसवस्तस्माद्भवत्यस्मिन्कुले सदा।\nतेषां कुमाराः सर्वेषां पूर्वेषां मम जज्ञिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2011476, "chapter_id": 1234, "verse_number": "१-२३५-२५", "content_sanskrit": "एका च मम कन्येयं कुलस्योत्पादनी भृशम्।\nपुत्रो ममायमिति मे भावना पुरुषर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2011477, "chapter_id": 1234, "verse_number": "१-२३५-२६", "content_sanskrit": "पुत्रिकाहेतुविधिना संज्ञिता भरतर्षभ।\nतस्मादेकः सुतो योऽस्यां जायते भारत त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2011478, "chapter_id": 1234, "verse_number": "१-२३५-२७", "content_sanskrit": "एतच्छुल्कं भवत्वस्याः कुलकृज्जायतामिह।\nएतेन समयेनेमां प्रतिगृह्णीष्व पाण्डव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2011479, "chapter_id": 1234, "verse_number": "१-२३५-२८", "content_sanskrit": "स तथेति प्रतिज्ञाय तां कन्यां प्रतिगृह्य च।\nमासे त्रयोदशे पार्थः कृत्वा वैवाहिकीं क्रियाम्।\nउवास नगरे तस्मिन्मासांस्त्रीन्स तया सह॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2011480, "chapter_id": 1234, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि अर्जुनवनवासपर्वणि पञ्चत्रिंशदधिकद्विशततमोऽध्यायः॥ २३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]