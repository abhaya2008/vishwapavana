[{"id": 5000634000, "chapter_id": 9634, "verse_number": "७-९९-१", "content_sanskrit": "रजन्यां तु प्रभातायां समानीय महामुनीन् ।\nगीयतामविशङ्काभ्यां रामः पुत्रावुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000634001, "chapter_id": 9634, "verse_number": "७-९९-२", "content_sanskrit": "ततः समुपविष्टेषु ब्रह्मर्षिषु महात्मसु ।\nभविष्यदुत्तरं काव्यं जगतुस्तौ कुशीलवौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000634002, "chapter_id": 9634, "verse_number": "७-९९-३", "content_sanskrit": "प्रविष्टायां तु सीतायां भूतलं सत्यसम्पदा ।\nतस्यावसाने यज्ञस्य रामः परमदुर्मनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000634003, "chapter_id": 9634, "verse_number": "७-९९-४", "content_sanskrit": "अपश्यमानो वैदेहीं मेने शून्यमिदं जगत् ।\nशोकेन परमायस्तो न शान्तिं मनसा ऽगमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000634004, "chapter_id": 9634, "verse_number": "७-९९-५", "content_sanskrit": "विसृज्य पार्थिवान्सर्वानृक्षवानरराक्षसान् ।\nजनौघं विप्रमुख्यानां वित्तपूर्वं विसृज्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000634005, "chapter_id": 9634, "verse_number": "७-९९-६", "content_sanskrit": "एवं समाप्य यज्ञं तु विधिवत्स तु राघवः ।\nततो विसृज्य तान्सर्वान्रामो राजीवलोचनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000634006, "chapter_id": 9634, "verse_number": "७-९९-७", "content_sanskrit": "हृदि कृत्वा तदा सीतामयोध्यां प्रविवेश ह ।\nइष्टयज्ञो नरपतिः पुत्रद्वयसमन्वितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000634007, "chapter_id": 9634, "verse_number": "७-९९-८", "content_sanskrit": "न सीतायाः परां भार्यां वव्रे स रघुनन्दनः ।\nयज्ञे यज्ञे च पत्न्यर्थं जानकी काञ्चनी भवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000634008, "chapter_id": 9634, "verse_number": "७-९९-९", "content_sanskrit": "दशवर्षसहस्राणि वाजिमेघानथाकरोत् ।\nवाजपेयान्दशगुणांस्तथा बहुसुवर्णकान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000634009, "chapter_id": 9634, "verse_number": "७-९९-१०", "content_sanskrit": "अग्निष्टोमातिरात्राभ्यां गोसवैश्च महाधनैः ।\nईजे क्रतुभिरन्यैश्च स श्रीमानाप्तदक्षिणैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000634010, "chapter_id": 9634, "verse_number": "७-९९-११", "content_sanskrit": "एवं स कालः सुमहान्राज्यस्थस्य महात्मनः ।\nधर्मे प्रयतमानस्य व्यतीयाद्राघवस्य तु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000634011, "chapter_id": 9634, "verse_number": "७-९९-१२", "content_sanskrit": "अनुरञ्जन्ति राजानमहन्यहनि राघवम् ।\nऋक्षवानररक्षांसि स्थिता रामस्य शासने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000634012, "chapter_id": 9634, "verse_number": "७-९९-१३", "content_sanskrit": "काले वर्षति पर्जन्यः सुभिक्षं विमला दिशः ।\nहृष्टपुष्टजनाकीर्णं पुरं जनपदास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000634013, "chapter_id": 9634, "verse_number": "७-९९-१४", "content_sanskrit": "नाकाले म्रियते कश्चिन्न व्याधिः प्राणिनां तथा ।\nनानर्थो विद्यते कश्चिद्रामे राज्यं प्रशासति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000634014, "chapter_id": 9634, "verse_number": "७-९९-१५", "content_sanskrit": "अथ दीर्घस्य कालस्य राममाता यशस्विनी ।\nपुत्रपौत्रैः परिवृता कालधर्ममुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000634015, "chapter_id": 9634, "verse_number": "७-९९-१६", "content_sanskrit": "अन्वियाय सुमित्रा च कैकेयी च यशस्विनी ।\nधर्मं कृत्वा बहुविधं त्रिदिवे पर्यवस्थिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000634016, "chapter_id": 9634, "verse_number": "७-९९-१७", "content_sanskrit": "सर्वाः प्रमुदिताः स्वर्गे राज्ञा दशरथेन च ।\nसमागता महाभागाः सर्वधर्मं च लेभिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000634017, "chapter_id": 9634, "verse_number": "७-९९-१८", "content_sanskrit": "तासां रामो महादानं काले काले प्रयच्छति ।\nमातऽणामविशेषेण ब्राह्मणेषु तपस्विषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000634018, "chapter_id": 9634, "verse_number": "७-९९-१९", "content_sanskrit": "पित्र्याणि ब्रह्मरत्नानि यज्ञान्परमदुस्तरान् ।\nचकार रामो धर्मात्मा पितऽन्देवान्विवर्धयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000634019, "chapter_id": 9634, "verse_number": "७-९९-२०", "content_sanskrit": "एवं वर्षसहस्राणि बहून्यथ ययुः सुखम् ।\nयज्ञैर्बहुविधं धर्मं वर्धयानस्य सर्वदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000634020, "chapter_id": 9634, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे एकोनशततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]