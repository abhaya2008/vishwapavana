[{"id": 2004298, "chapter_id": 1085, "verse_number": "१-८६-०x", "content_sanskrit": "अष्टक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2004299, "chapter_id": 1085, "verse_number": "१-८६-१", "content_sanskrit": "कतरस्त्वनयोः पूर्वं देवानामेति साम्यताम्।\nउभयोर्धावतो राजन्सूर्याचन्द्रमसोरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2004300, "chapter_id": 1085, "verse_number": "१-८६-२x", "content_sanskrit": "ययातिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2004301, "chapter_id": 1085, "verse_number": "१-८६-२", "content_sanskrit": "अनिकेतो गृहस्थेषु कामवृत्तेषु संयतः।\nग्राम एव वसन्भिक्षुस्तयोः पूर्वतरं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2004302, "chapter_id": 1085, "verse_number": "१-८६-३", "content_sanskrit": "अप्राप्य दीर्घमायुस्तु यः प्राप्तो विकृतिं चरेत्।\nतप्यते यदि तत्कृत्वा चरेत्सोऽन्यत्तपस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2004303, "chapter_id": 1085, "verse_number": "१-८६-४", "content_sanskrit": "पापानां कर्मणां नित्यं बिभीयाद्यस्तु मानवः।\nसुखमप्याचरन्नित्यं सोऽत्यन्तं सुखमेधते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2004304, "chapter_id": 1085, "verse_number": "१-८६-५", "content_sanskrit": "यद्वै नृशंसं तदसत्यमाहु-\nर्यः सेवते धर्ममनर्थबुद्धिः।\nअस्वोऽप्यनीशश्च तथैव राजं-\nस्तदार्जवं स समाधिस्तदार्यम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2004305, "chapter_id": 1085, "verse_number": "१-८६-६x", "content_sanskrit": "अष्टक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2004306, "chapter_id": 1085, "verse_number": "१-८६-६", "content_sanskrit": "केनासि हूतः प्रहितोऽसि राज-\nन्युवा स्रग्वी दर्शनीयः सुवर्चाः।\nकुतऋ आयातः कतरस्यां दिशि त्व-\nमुताहोस्वित्पार्थिवं स्थानमस्ति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2004307, "chapter_id": 1085, "verse_number": "१-८६-७x", "content_sanskrit": "ययातिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2004308, "chapter_id": 1085, "verse_number": "१-८६-७", "content_sanskrit": "इमं भौमं नरकं क्षीणपुण्यः\nप्रवेष्टुमुर्वीं गगनाद्विप्रहीणः।\nविद्वांश्चैवं मतिमानार्यबुद्धि-\nर्ममाभवत्कर्मलोक्यं च सर्वम्।\nउक्त्वाऽहं वः प्रपतिष्याम्यनन्तरं\nत्वरन्ति मां लोकपा ब्राह्मणा ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2004309, "chapter_id": 1085, "verse_number": "१-८६-८", "content_sanskrit": "सतां सकाशे तु वृतः प्रपात-\nस्ते सङ्गता गुणवन्तश्च सर्वे।\nशक्राच्च लब्धो हि वरो मयैष\nपतिष्यता भूमितलं नरेन्द्र॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2004310, "chapter_id": 1085, "verse_number": "१-८६-९x", "content_sanskrit": "अष्टक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2004311, "chapter_id": 1085, "verse_number": "१-८६-९", "content_sanskrit": "पृच्छामि त्वां मा प्रपत प्रपातं\nयदि लोकाः पार्थिव सन्ति मेऽत्र।\nयद्यन्तरिक्षे यदि वा दिवि स्थिताः\nक्षेत्रज्ञं त्वां तस्य धर्मस्य मन्ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2004312, "chapter_id": 1085, "verse_number": "१-८६-१०x", "content_sanskrit": "ययातिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2004313, "chapter_id": 1085, "verse_number": "१-८६-१०", "content_sanskrit": "यावत्पृथिव्यां विहितं गवाश्वं\nसहारण्यैः पशुभिः पार्वतैश्च।\nतावल्लोका दिवि ते संस्थिता वै\nतथा विजानीहि नरेन्द्रसिंह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2004314, "chapter_id": 1085, "verse_number": "१-८६-११x", "content_sanskrit": "अष्टक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2004315, "chapter_id": 1085, "verse_number": "१-८६-११", "content_sanskrit": "तांस्ते ददामि मा प्रपत प्रपातं\nये मे लोका दिवि राजेन्द्र सन्ति।\nयद्यन्तरिक्षे यदि वा दिवि श्रिता-\nस्तानाक्रम क्षिप्रमपेतमोहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2004316, "chapter_id": 1085, "verse_number": "१-८६-१२x", "content_sanskrit": "ययातिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2004317, "chapter_id": 1085, "verse_number": "१-८६-१२", "content_sanskrit": "नास्मद्विधोऽब्राह्मणो ब्रह्मविच्च\nप्रतिग्रहे वर्तते राजमुख्य।\nयथा प्रदेयं सततं द्विजेभ्य-\nस्तथाऽददं पूर्वमहं नरेन्द्र॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2004318, "chapter_id": 1085, "verse_number": "१-८६-१३", "content_sanskrit": "नाब्राह्मणः कृपणो जातु जीवे-\nद्या चाप्यस्याऽब्राह्मणी वीरपत्नी।\nसोऽहं नैवाकृतपूर्वं चरेयं\nविधित्समानः किमु तत्र साधुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2004319, "chapter_id": 1085, "verse_number": "१-८६-१४x", "content_sanskrit": "प्रतर्दन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2004320, "chapter_id": 1085, "verse_number": "१-८६-१४", "content_sanskrit": "पृच्छामि त्वां स्पृहणीयरूप\nप्रतर्दनोऽहं यदि मे सन्ति लोकाः।\nयद्यन्तरिक्षे यदि वा दिवि श्रिताः\nक्षेत्रज्ञं त्वां तस्य धर्मस्य मन्ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2004321, "chapter_id": 1085, "verse_number": "१-८६-१५x", "content_sanskrit": "ययातिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2004322, "chapter_id": 1085, "verse_number": "१-८६-१५", "content_sanskrit": "सन्ति लोका बहवस्ते नरेन्द्र\nअप्येकैकः सप्तसप्ताप्यहानि।\nमधुच्युतो घृतपृक्ता विशोका-\nस्ते नान्तवन्तः प्रतिपालयन्ति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2004323, "chapter_id": 1085, "verse_number": "१-८६-१६x", "content_sanskrit": "प्रतर्दन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2004324, "chapter_id": 1085, "verse_number": "१-८६-१६", "content_sanskrit": "तांस्ते ददानि मा प्रपत प्रपातं\nये मे लोकास्तव ते वै भवन्तु।\nयद्यन्तरिक्षे यदि वा दिवि श्रिता-\nस्तानाक्रम क्षिप्रमपेतमोहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2004325, "chapter_id": 1085, "verse_number": "१-८६-१७x", "content_sanskrit": "ययातिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2004326, "chapter_id": 1085, "verse_number": "१-८६-१७", "content_sanskrit": "न तुल्यतेजाः सुकृतं कामयेत\nयोगक्षेमं पार्थिव पार्थिवः सन्।\nदैवादेशादापदं प्राप्य विद्वां-\nश्चरेन्नृशंसं न हि जातु राजा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2004327, "chapter_id": 1085, "verse_number": "१-८६-१८", "content_sanskrit": "धर्म्यं मार्गं यतमानो यशस्यं\nकुर्यान्नृपो धर्ममवेक्षमाणः।\nन मद्विधो धर्मबुद्धिः प्रजान-\nन्कुर्यादेवं कृपणं मां यथाऽत्थ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2004328, "chapter_id": 1085, "verse_number": "१-८६-१९", "content_sanskrit": "कुर्यादपूर्वं न कृतं यदन्यै-\nर्विधित्समानः किमु तत्र साधु।\nधर्माधर्मौ सुविनिश्चित्य सम्य-\nक्कार्याकार्येष्वप्रमत्तश्चरेद्यः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2004329, "chapter_id": 1085, "verse_number": "१-८६-२०", "content_sanskrit": "स वै धीमान्सत्यसन्धः कृतात्मा\nराजा भवेल्लोकपालो महिम्ना।\nयदा भवेत्संशयो धर्मकार्ये\nकामार्थौ वा यत्र विन्दन्ति सम्यक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2004330, "chapter_id": 1085, "verse_number": "१-८६-२१", "content_sanskrit": "कार्यं तत्र प्रथमं धर्मकार्यं\nयन्नो विरुध्यादर्थकामौ स धर्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2004331, "chapter_id": 1085, "verse_number": "१-८६-२१x", "content_sanskrit": "वैशम्पायन उवाच।\nब्रुवाणमेवं नृपतिं ययातिं\nनृपोत्तमो वसुमानब्रवीत्तम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2004332, "chapter_id": 1085, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि षडशीतितमोऽध्यायः॥ ८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]