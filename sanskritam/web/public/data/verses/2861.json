[{"id": 2087691, "chapter_id": 2861, "verse_number": "१२-३६६-०x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2087692, "chapter_id": 2861, "verse_number": "१२-३६६-१", "content_sanskrit": "अतिभारोद्यतस्यैव भारावतरणं महत्।\nपराश्वासकरं वाक्यमिदं मे भवतः श्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2087693, "chapter_id": 2861, "verse_number": "१२-३६६-२", "content_sanskrit": "अध्यक्लान्तस्य शयनं स्थानक्लान्तस्य चासनम्।\nतृषितस्येव पानीयं क्षुधार्तस्येव भोजनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2087694, "chapter_id": 2861, "verse_number": "१२-३६६-३", "content_sanskrit": "ईप्सितस्येव संप्राप्तिरर्थस्य समयेऽतिथे।\nएपितस्यात्मनः काले बृद्धस्यैव सुता यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2087695, "chapter_id": 2861, "verse_number": "१२-३६६-४", "content_sanskrit": "मनसा चिन्तितस्येव प्रीतिस्निग्धस्य दर्शनम्।\nप्रह्लादयति मां वाक्यं भवता यदुदीरितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2087696, "chapter_id": 2861, "verse_number": "१२-३६६-५", "content_sanskrit": "मनश्चक्षुरिवाकाशे पश्यामि विमृशामि च।\nप्रज्ञानवचनाद्योयमुपदेशो हि मे कृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2087697, "chapter_id": 2861, "verse_number": "१२-३६६-६", "content_sanskrit": "वाढमेवं करिष्यामि यथा मे भाषते भवान्।\nइमां हि रजनीं साधो निवसस्व मया सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2087698, "chapter_id": 2861, "verse_number": "१२-३६६-७", "content_sanskrit": "प्रभाते यास्यति चवान्पर्याश्वस्तः सुखोपितः।\nअसौ हि भगवान्सूर्यो मन्दरश्मिरवाङ्भुखः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2087699, "chapter_id": 2861, "verse_number": "१२-३६६-८x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2087700, "chapter_id": 2861, "verse_number": "१२-३६६-८", "content_sanskrit": "ततस्तेन कृतातिथ्यः सोऽनिथिः शत्रुसूदन।\nउवास किल तां रात्रिं सह तेन द्विजेन वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2087701, "chapter_id": 2861, "verse_number": "१२-३६६-९", "content_sanskrit": "तत्वं च धर्मसंयुक्तं तयोः कथयतोस्तदा।\nव्यतीता सा निशा कृत्स्ना सुखेन दिवसोपमा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2087702, "chapter_id": 2861, "verse_number": "१२-३६६-१०", "content_sanskrit": "ततः प्रभातसमये सोऽतिथिस्तेन पूजितः।\nब्राह्मणेन यथाशक्त्या स्वकार्यमभिकाङ्क्षता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2087703, "chapter_id": 2861, "verse_number": "१२-३६६-११", "content_sanskrit": "ततः स विप्रः कृतकर्मनिश्चयः\nकृताभ्यनुज्ञः स्वजनेन धर्मकृत्।\nयथोपदिष्टं भुजगेन्द्रसंश्रयं\nजगाम काले सुकृतैकनिश्चयः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2087704, "chapter_id": 2861, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि षट्ष्ट्यधिकत्रिशततमोऽध्यायः॥ ३६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]