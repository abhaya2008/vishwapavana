[{"id": 2168612, "chapter_id": 4615, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2168613, "chapter_id": 4615, "verse_number": "१", "content_sanskrit": "ततस्तथेति देवेशस्तैरुक्तो राजसत्तम ।\nअर्धमादाय सर्वेभ्यस्तेजसाभ्यधिकोऽभवत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2168614, "chapter_id": 4615, "verse_number": "२", "content_sanskrit": "स तु देवो बलेनासीत् सर्वेभ्यो बलवत्तरः ।\nमहादेव इति ख्यातस्तदाप्रभृति शङ्करः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2168615, "chapter_id": 4615, "verse_number": "३", "content_sanskrit": "ततोऽब्रवीन्महादेवो धनुर्बाणधरस्त्वहम् ।\nहनिष्यामि रथेनाजौ तान् रिपून् वै दिवौकसः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2168616, "chapter_id": 4615, "verse_number": "४", "content_sanskrit": "ते यूयं मे रथं चैव धनुर्बाणं तथैव च ।\nभवध्वं यावदद्यैतान् पातयामि महीतळे\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2168617, "chapter_id": 4615, "verse_number": "", "content_sanskrit": "देवाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2168618, "chapter_id": 4615, "verse_number": "५", "content_sanskrit": "मूर्तिसर्वस्वमादाय त्रैलोक्यस्य ततस्ततः ।\nरथं ते कल्पयिष्याम देवेश्वर महौजसम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2168619, "chapter_id": 4615, "verse_number": "६", "content_sanskrit": "तथैव बुद्ध्या विहितं विश्वकर्मकृतं शुभम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2168620, "chapter_id": 4615, "verse_number": "७", "content_sanskrit": "ततो विबुधशार्दूलास्तं रथं समकल्पयन्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2168621, "chapter_id": 4615, "verse_number": "८", "content_sanskrit": "विष्णुं सोमं हुताशं च तस्येषुं समकल्पयन् ।\nशृङ्गमग्निर्बभूवास्य भल्लः सोमो विशाम्पते ।\nकुड्मलश्चाभवद् विष्णुस्तस्मिन्निषुवरे तदा\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2168622, "chapter_id": 4615, "verse_number": "९", "content_sanskrit": "रथं वसुन्धरां देवीं विशालपुरमालिनीम् ।\nसपर्वतवनद्वीपां चक्रुर्भूतधरां तदा\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2168623, "chapter_id": 4615, "verse_number": "१०", "content_sanskrit": "मन्दरं पर्वतं चाक्षं जङ्घास्तस्य महानदीः ।\nदिशश्च प्रदिशश्चैव परिवारं रथस्य हि\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2168624, "chapter_id": 4615, "verse_number": "११", "content_sanskrit": "ईषा नक्षत्रवंशश्च युगः कृतयुगोऽभवत् ।\nकूबरश्च रथस्यासीद् वासुकिर्भुजगोत्तमः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2168625, "chapter_id": 4615, "verse_number": "१२", "content_sanskrit": "अपस्करमधिष्ठाने हिमवान् विन्ध्यपर्वतः ।\nउदयास्तावधिष्ठाने गिरी चक्रुः सुरोत्तमाः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2168626, "chapter_id": 4615, "verse_number": "१३", "content_sanskrit": "समुद्रमक्षमसृजन् दानवालयमुत्तमम् ।\nसप्तर्षिमण्डलं चैव रथस्यासीत् परिष्करः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2168627, "chapter_id": 4615, "verse_number": "१४", "content_sanskrit": "गङ्गा सरस्वती सिन्धुर्धुरमाकाशमेव च ।\nउपस्करो रथस्यासन्नापः सर्वांश्च निम्नगाः ।\nअहोरात्रं कलाश्चैव काष्ठाश्च ऋतवस्तथा\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2168628, "chapter_id": 4615, "verse_number": "१५", "content_sanskrit": "ओषधीर्विविधास्तत्र घण्टापुष्पफलोद्गमाः ।\nसूर्याचन्द्रमसौ कृत्वा चक्रे रथवरोत्तमे\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2168629, "chapter_id": 4615, "verse_number": "१६", "content_sanskrit": "अनुकर्षं ग्रहा दीप्ताः वरूथं चापि तारकाः ।\nधर्मार्थकामसंयुक्तं त्रिवेणुं चापि बन्धुरम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2168630, "chapter_id": 4615, "verse_number": "१७", "content_sanskrit": "पक्षौ पूर्वापरौ तत्र कृते रात्र्यहनी शुभे ।\nदश नागपतीनीषां धृतराष्ट्रमुखान् दृढाम् ।\nयोक्त्राणि चक्रुर्नागांश्च निःश्वसन्तो महोरगान्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2168631, "chapter_id": 4615, "verse_number": "१८", "content_sanskrit": "द्यां युगं युगचर्माणि संवर्तकबलाहकान्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2168632, "chapter_id": 4615, "verse_number": "१९", "content_sanskrit": "कालपृष्ठोऽथ नहुषः कर्कोटकधनञ्जयौ ।\nइतरे चाभवन्नागा हयानां बालबन्धनाः ।\nदिशश्च प्रदिशश्चैव रश्मयो रथवाजिनाम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2168633, "chapter_id": 4615, "verse_number": "२०", "content_sanskrit": "अश्वाश्च वेदाश्चत्वारः पुराणाङ्गविभूषिताः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2168634, "chapter_id": 4615, "verse_number": "२१", "content_sanskrit": "वषट्कारः प्रतोदोऽभूद् गायत्री शीर्षबन्धना ।\nयो यज्ञे विहितः पूर्वमीशानस्य महात्मनः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2168635, "chapter_id": 4615, "verse_number": "२२", "content_sanskrit": "संवत्सरो धनुस्तद्वै सावित्री ज्या महास्वना ।\nदिव्यं च वर्म विहितं महार्हं रत्नभूषितम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2168636, "chapter_id": 4615, "verse_number": "२३", "content_sanskrit": "अभेद्यं विरजस्कं वै कालचक्रं परिष्कृतम् ।\nध्वजयष्टिरभून्मेरुः श्रीमान् कनकपर्वतः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2168637, "chapter_id": 4615, "verse_number": "२४", "content_sanskrit": "पताकाश्चाभवन्मेघास्तडिद्भिः समलङ्कृताः ।\nरेजुरध्वर्युमध्यस्था ज्वलन्त इव पावकाः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2168638, "chapter_id": 4615, "verse_number": "२५", "content_sanskrit": "सन्ध्यां धृतिं च मेधां च स्थितिं सन्नतिमेव च ।\nग्रहनक्षत्रताराभिश्चर्म चित्रं नभस्तळम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2168639, "chapter_id": 4615, "verse_number": "२६", "content_sanskrit": "सुराम्बुप्रेतवित्तानां पतीक्त्रल्लोकेश्वरान् हयान् ।\nसिनीवालीमनुमतिं कुहूं राकां च सुव्रताम् ।\nयोक्त्राणि चक्रुर्वाहानां घण्टिकाश्चापि पन्नगान्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2168640, "chapter_id": 4615, "verse_number": "२७", "content_sanskrit": "धर्मः सत्यं तपोऽर्थश्च विहितास्तत्र रश्मयः ।\nअधिष्ठानं मनस्त्वासीत् परिरथ्या सरस्वती\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2168641, "chapter_id": 4615, "verse_number": "२८", "content_sanskrit": "नानावर्णाश्च चित्राश्च पताकाः पवनेरिताः ।\nविद्युदिन्द्रधनुर्नद्धं रथं दीप्तं व्यदीपयत्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2168642, "chapter_id": 4615, "verse_number": "२९", "content_sanskrit": "क्लृप्तं तु तं रथं दृष्ट्वा विस्मिता देवताभवन् ।\nसर्वलोकस्य तेजांसि दृष्ट्वैकस्थानि मारिष ।\nयुक्तं निवेदयामासुर्देवास्तस्मै महात्मने\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2168643, "chapter_id": 4615, "verse_number": "३०", "content_sanskrit": "एवं तस्मिन् महाराज कल्पिते रथसत्तमे ।\nदेवैर्मनुजशार्दूल द्विषतामभिमर्दने\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2168644, "chapter_id": 4615, "verse_number": "३१", "content_sanskrit": "स्वान्यायुधानि मुख्यानि न्यदधाच्छङ्करो रथे ।\nध्वजयष्टिं वियत्कृत्वा स्थापयामास गोवृषम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2168645, "chapter_id": 4615, "verse_number": "३२", "content_sanskrit": "ब्रह्मदण्डः कालदण्डो रुद्रदण्डस्तथा ज्वरः ।\nपरिस्कन्दा रथस्यास्य सर्वतोदिशमुद्यताः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2168646, "chapter_id": 4615, "verse_number": "३३", "content_sanskrit": "अथर्वाङ्गिरसावास्तां चक्ररक्षौ महात्मनः ।\nऋग्वेदः सामवेदश्च पुराणं च पुरस्सराः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2168647, "chapter_id": 4615, "verse_number": "समाप्तिः", "content_sanskrit": "इतिहासयजुर्वेदौ पृष्ठरक्षौ बभूवतुः ।\nदिव्या वाचश्च विद्याश्च परिपार्श्वचराः कृताः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2168648, "chapter_id": 4615, "verse_number": "३५", "content_sanskrit": "स्तोत्रादयश्च राजेन्द्र वषट्कारस्तथैव च ।\nओङ्कारश्च मुखे राजन्नतिशोभाकरोऽभवत्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2168649, "chapter_id": 4615, "verse_number": "३६", "content_sanskrit": "विचित्रमृतुभिः षड्भिः कृत्वा संवत्सरं धनुः ।\nछायामेवात्मनश्चक्रे धनुर्ज्यामक्षयां रणे ।\nकालो हि भगवान् रुद्रस्तस्य संवत्सरो धनुः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2168650, "chapter_id": 4615, "verse_number": "३७", "content_sanskrit": "तस्माद् रौद्री कालरात्रिर्ज्या कृता धनुषोऽजरा\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2168651, "chapter_id": 4615, "verse_number": "३८", "content_sanskrit": "इषुश्चाप्यभवद् विष्णुर्ज्वलनः सोम एव च ।\nअग्नीषोममयं सर्वं वैष्णवं चोच्यते जगत्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2168652, "chapter_id": 4615, "verse_number": "३९", "content_sanskrit": "विष्णुश्चात्मा भगवतो भवस्यामिततेजसः ।\nतस्माद्धनुर्ज्यासंस्पर्शं न विषेहुर्हरस्य ते\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2168653, "chapter_id": 4615, "verse_number": "४०", "content_sanskrit": "तस्मिन् शरे तिग्ममन्युर्मुमोचाविषहं प्रभुः ।\nभृग्वङ्गिरोमन्युभवं क्रोधाग्निमतिदुःसहम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2168654, "chapter_id": 4615, "verse_number": "४१", "content_sanskrit": "स नीललोहितो धूम्रः कृत्तिवासा भयङ्करः ।\nआदित्यायुतसङ्काशस्तेजोज्वालावृतो ज्वलन्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2168655, "chapter_id": 4615, "verse_number": "४२", "content_sanskrit": "दुश्च्यावश्च्यावनो जेता हन्ता ब्रह्मद्विषां हरः ।\nनित्यं त्राता च हन्ता च धर्माधर्माश्रितान् जनान्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2168656, "chapter_id": 4615, "verse_number": "४३", "content_sanskrit": "प्रमाथिभिर्घोररूपैर्भीमोदग्रैर्गणैर्वृतः ।\nविभाति भगवान् स्थाणुस्तैरेवात्मगुणैर्वृतः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2168657, "chapter_id": 4615, "verse_number": "४४", "content_sanskrit": "तस्याङ्गानि समाश्रित्य स्थितं विश्वमिदं जगत् ।\nजङ्गमाजङ्गमं राजन् शुशुभेऽद्भुतदर्शनम्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2168658, "chapter_id": 4615, "verse_number": "४५", "content_sanskrit": "दृष्ट्वा तु तं रथं दिव्यं कवची स शरासनी ।\nबाणमादाय तं दिव्यं सोमविष्ण्वग्निवातजम्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2168659, "chapter_id": 4615, "verse_number": "४६", "content_sanskrit": "तस्य वाजांस्ततो देवाः कल्पयाञ्चक्रिरे विभोः ।\nपुण्यगन्धवहं राजन् श्वसनं देवसत्तमम्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2168660, "chapter_id": 4615, "verse_number": "४७", "content_sanskrit": "तमादाय महादेवस्त्रासयन् सर्वदानवान् ।\nआरुरोह तदा यत्तः कम्पयन्निव रोदसी\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2168661, "chapter_id": 4615, "verse_number": "४८", "content_sanskrit": "तमारुरुक्षुं देवेशं तुष्टुवुः परमर्षयः ।\nगन्धर्वा देवसङ्घाश्च तथैवाप्सरसां गणाः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2168662, "chapter_id": 4615, "verse_number": "४९", "content_sanskrit": "महर्षिभिः स्तूयमानो वन्द्यमानश्च वन्दिभिः ।\nउपनृत्तश्चाप्सरसां गणैर्नृत्तविशारदैः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2168663, "chapter_id": 4615, "verse_number": "५०", "content_sanskrit": "स शोभमानो वरदः खड्गी वाणी शरासनी ।\nहसन्निवाब्रवीद् देवो सारथिः को भविष्यति\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2168664, "chapter_id": 4615, "verse_number": "५१", "content_sanskrit": "तमब्रुवन् देवगणा यं भवान् संनियोक्ष्यते ।\nस भविष्यति देवेश सारथिस्ते न संशयः\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2168665, "chapter_id": 4615, "verse_number": "५२", "content_sanskrit": "तानब्रवीत् पुनर्देवो मत्तः श्रेष्ठतरो हि यः ।\nतं सारथिं कुरुध्वं मे स्वयं सञ्चिन्त्य मा चिरम्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2168666, "chapter_id": 4615, "verse_number": "५३", "content_sanskrit": "एतच्छ्रुत्वा ततो देवा वाक्यमुक्तं महात्मना ।\nगत्वा पितामहं देवं प्रसाद्यैवं वचोऽब्रुवन्\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2168667, "chapter_id": 4615, "verse_number": "५४", "content_sanskrit": "देव त्वयेदं कथितं त्रिदशारिनिबर्हणम् ।\nतथा च कृतमस्माभिः प्रसन्नो वृषभध्वजः\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2168668, "chapter_id": 4615, "verse_number": "५५", "content_sanskrit": "रथश्च विहितोऽस्माभिर्विचित्रायुधसंवृतः ।\nसारथिं तु न जानीमः कः स्यात् तस्मिन् रथोत्तमे\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2168669, "chapter_id": 4615, "verse_number": "५६", "content_sanskrit": "तस्माद् विधीयतां कश्चित् सारथिर्देवसत्तम ।\nसफलां तां गिरं देव कर्तुमर्हसि नो विभो\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2168670, "chapter_id": 4615, "verse_number": "५७", "content_sanskrit": "एवमस्मासु हि पुरा भगवन्नुक्तवानसि ।\nहितं कर्तास्मि भवतामिति तत्कर्तुमर्हसि\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2168671, "chapter_id": 4615, "verse_number": "५८", "content_sanskrit": "स देव युक्तो रथसत्तमो नो\nदुरावरो द्रावणः शात्रवाणाम् ।\nपिनाकपाणिर्विहितोऽत्र योद्धा\nविभीषयन् दानवानुद्यतोऽसौ\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2168672, "chapter_id": 4615, "verse_number": "५९", "content_sanskrit": "तथैव वेदाश्चतुरो हयाग्र्या\nधरा सशैला च रथो महात्मन् ।\nनक्षत्रवंशोऽनुगतो वरूथे\nयस्मिन् योद्धा सारथिनाभिरक्ष्यः\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2168673, "chapter_id": 4615, "verse_number": "६०", "content_sanskrit": "तत्र सारथिरेष्टव्यः सर्वैरेतैर्विशेषवान् ।\nतत्प्रतिष्ठो रथो देव हया योद्धा तथैव च ।\nकवचानि च शस्त्राणि कार्मुकं च पितामह\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2168674, "chapter_id": 4615, "verse_number": "६१", "content_sanskrit": "त्वामृते सारथिं तत्र नान्यं पश्यामहे वयम् ।\nत्वं हि सर्वैर्गुणैर्युक्तो देवताभ्योऽधिकः प्रभो ।\nसारथ्ये तूर्णमारोह संयच्छ परमान् हयान्\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2168675, "chapter_id": 4615, "verse_number": "६२", "content_sanskrit": "जयाय त्रिदिवेशानां वधाय त्रिदशद्विषाम् \t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2168676, "chapter_id": 4615, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2168677, "chapter_id": 4615, "verse_number": "समाप्तिः", "content_sanskrit": "इति ते शिरसा नत्वा त्रिलोकेशं पितामहम् ।\nदेवाः प्रसादयामासुः सारथ्यायेति नः श्रुतम्\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2168678, "chapter_id": 4615, "verse_number": "", "content_sanskrit": "ब्रह्मा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2168679, "chapter_id": 4615, "verse_number": "६४", "content_sanskrit": "नात्र किञ्चिन्मृषा वाक्यं यदुक्तं वो दिवौकसः ।\nसंयच्छामि हयानेष युध्यतो वै कपर्दिनः\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2168680, "chapter_id": 4615, "verse_number": "६५", "content_sanskrit": "ततः स भगवान् देवो लोकस्रष्टा पितामहः ।\nसारथ्ये कल्पितो देवैरीशानस्य महात्मनः\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2168681, "chapter_id": 4615, "verse_number": "६६", "content_sanskrit": "आरुह्य भगवान् देवो दीप्यमानः स्वतेजसा \t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2168682, "chapter_id": 4615, "verse_number": "६७", "content_sanskrit": "अभीशून् हि त्रिलोकेशः सङ्गृह्य प्रपितामहः ।\nतानश्वांश्चोदयामास मनोमारुतरंहसः\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2168683, "chapter_id": 4615, "verse_number": "६८", "content_sanskrit": "ततोऽधिरूढे वरदे प्रयाते चासुरान् प्रति ।\nसाधु साध्विति विश्वेशः स्मयमानोऽभ्यभाषत\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2168684, "chapter_id": 4615, "verse_number": "६९", "content_sanskrit": "याहि देव यतो दैत्याश्चोदयाश्वानतन्द्रितः ।\nपश्य बाह्वोर्बलं मेऽद्य निघ्नतः शात्रवान् रणे\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2168685, "chapter_id": 4615, "verse_number": "७०", "content_sanskrit": "ततस्तांश्चोदयामास वायुवेगसमान् जवे ।\nपुराण्युद्दिश्य स्वस्थानि दानवानां तरस्विनाम्\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2168686, "chapter_id": 4615, "verse_number": "७१", "content_sanskrit": "पिबद्भिरिव चाकाशं तैर्हयैर्लोकपूजितैः ।\nजगाम भगवान् क्षिप्रं जयाय त्रिदिवौकसाम्\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2168687, "chapter_id": 4615, "verse_number": "७२", "content_sanskrit": "प्रयाते रथमास्थाय त्रिपुराभिमुखे भवे ।\nननाद सुमहानादं वृषभः पूरयन् दिशः \t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2168688, "chapter_id": 4615, "verse_number": "७३", "content_sanskrit": "वृषभस्यास्य निनदं श्रुत्वा भयकरं महत् ।\nविनाशमगमंस्तत्र तारकाः सुरशत्रवः\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2168689, "chapter_id": 4615, "verse_number": "७४", "content_sanskrit": "अपरेऽस्थितास्तत्र युद्धायाभिमुखास्तदा ।\nततः स्थाणुर्महाराज शूलधृक् क्रोधमूर्च्छितः \t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2168690, "chapter_id": 4615, "verse_number": "७५", "content_sanskrit": "त्रस्तानि सर्वभूतानि त्रैलोक्यं भूः प्रकम्पते ।\nनिमित्तानि च घोराणि तत्र सन्दधतः शरम्\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2168691, "chapter_id": 4615, "verse_number": "७६", "content_sanskrit": "तस्मिन् सोमाग्निविष्णूनां क्षोभेण ब्रह्मरुद्रयोः।\nस रथो धनुषः क्षोभादतीव ह्यवसीदति\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2168692, "chapter_id": 4615, "verse_number": "७७", "content_sanskrit": "ततो नारायणस्तस्मात् शरभागाद् विनिःसृतः ।\nवृषरूपं समास्थाय उज्जहार महारथम् \t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2168693, "chapter_id": 4615, "verse_number": "७८", "content_sanskrit": "सीदमाने रथे चैव नर्दमानेषु शत्रुषु ।\nस सम्भ्रमात् तु भगवान् नादं चक्रे महाबलः \t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2168694, "chapter_id": 4615, "verse_number": "७९", "content_sanskrit": "वृषभस्य स्थितो मूर्ध्नि हयपृष्ठे च मानद ।\nतदा स भगवान् रुद्रो निरैक्षद् दानवं पुरम् \t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2168695, "chapter_id": 4615, "verse_number": "८०", "content_sanskrit": "वृषभस्यास्थितो रुद्रो हयस्य च नरोत्तम ।\nस्तनांस्तदाऽशातयत खुरांश्चैव द्विधाऽकरोत्\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2168696, "chapter_id": 4615, "verse_number": "८१", "content_sanskrit": "ततःप्रभृति भद्रं ते गवां द्वैधीकृताः खुराः ।\nहयानां च स्तना राजंस्तदाप्रभृति नाभवन् ।\nपीडितानां बलवता रुद्रेणाद्भुतकर्मणा \t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2168697, "chapter_id": 4615, "verse_number": "८२", "content_sanskrit": "अथाधिज्यं धनुः कृत्वा शर्वः सन्धाय तं शरम् ।\nयुक्त्वा पाशुपतास्त्रेण त्रिपुरं समचिन्तयत्\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2168698, "chapter_id": 4615, "verse_number": "८३", "content_sanskrit": "तस्मिन् स्थिते तदा राजन् क्रुद्धे विधृतकार्मुके ।\nपुराणि तानि कालेन जग्मुरेवैकतां तदा\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2168699, "chapter_id": 4615, "verse_number": "८४", "content_sanskrit": "एकीभावं गते चैव त्रिपुरे समुपागते ।\nबभूव तुमुलो हर्षो दैवतानां महात्मनाम्\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2168700, "chapter_id": 4615, "verse_number": "८५", "content_sanskrit": "ततो देवगणाः सर्वे सिद्धाश्च परमर्षयः ।\nजयेति वाचो मुमुचुः संस्तुवन्तो मुदान्विताः\t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2168701, "chapter_id": 4615, "verse_number": "८६", "content_sanskrit": "ततोऽग्रतः प्रादुरभूत् त्रिपुरं निघ्नतोऽसुरान् ।\nअनिर्देश्योग्रवपुषो देवस्यासह्यतेजसः\t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2168702, "chapter_id": 4615, "verse_number": "८७", "content_sanskrit": "स तद्विकृष्य भगवान् दिव्यं लोकेश्वरो धनुः ।\nत्रैलोक्यसारं तमिषुं मुमोच त्रिपुरं प्रति\t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2168703, "chapter_id": 4615, "verse_number": "८८", "content_sanskrit": "एवं तत् त्रिपुरं दग्धं दानवाश्चाप्यशेषतः ।\nमहेश्वरेण क्रुद्धेन त्रैलोक्यस्य हितैषिणा\t॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2168704, "chapter_id": 4615, "verse_number": "८९", "content_sanskrit": "स चात्मक्रोधजो वह्निर्दहेत्युक्तो निवारितः ।\nमा कार्षीर्भस्मसाल्लोकानिति त्र्यक्षोऽब्रवीच्च तम्\t॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2168705, "chapter_id": 4615, "verse_number": "९०", "content_sanskrit": "ततः प्रकृतिमापन्ना देवा लोकास्तथर्षयः ।\nतुष्टुवुर्वाग्भिरर्थ्याभिः स्थाणुमप्रतिमौजसम्\t॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2168706, "chapter_id": 4615, "verse_number": "९१", "content_sanskrit": "तेऽनुज्ञाता भगवता जग्मुः सर्वे यथागतम् ।\nकृतकामाः प्रसन्नेन प्रजापतिमुखाः सुराः\t॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2168707, "chapter_id": 4615, "verse_number": "९२", "content_sanskrit": "यथैव भगवान् ब्रह्मा लोकधाता पितामहः ।\nसंयच्छ त्वं हयानस्य राधेयस्य महात्मनः\t॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2168708, "chapter_id": 4615, "verse_number": "९३", "content_sanskrit": "त्वं हि कृष्णाच्च कर्णाच्च फल्गुनाच्च विशेषतः ।\nविशिष्टो राजशार्दूल नास्ति तत्र विचारणा\t॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2168709, "chapter_id": 4615, "verse_number": "९४", "content_sanskrit": "युद्धे ह्ययं रुद्रकल्पस्त्वं च ब्रह्मसमो नये ।\nतस्माच्छक्तौ युवां जेतुं मच्छत्रूंस्ताविवासुरान्\t॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2168710, "chapter_id": 4615, "verse_number": "९५", "content_sanskrit": "यथा शल्याद्य कर्णोऽयं श्वेताश्वं कृष्णसारथिम् ।\nप्रमथ्य हन्यात् कौन्तेयं तथा शीघ्रं विधीयताम् ।\nत्वयि कर्णश्च राज्यं च वयं चैव प्रतिष्ठिताः\t॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2168711, "chapter_id": 4615, "verse_number": "९६", "content_sanskrit": "इमं चाप्यपरं भूय इतिहासं निबोध मे ।\nपितुर्मम सकाशे यं ब्राह्मणः प्राह धर्मवित्\t॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2168712, "chapter_id": 4615, "verse_number": "९७", "content_sanskrit": "श्रुत्वा चैतद् वचश्चित्रं हेतुकार्यार्थतत्ववित् ।\nकुरु शल्य विनिश्चित्य मा भूदत्र विचारणा\t॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2168713, "chapter_id": 4615, "verse_number": "९८", "content_sanskrit": "भार्गवाणां कुले जातो जमदग्निर्महातपाः ।\nतस्य रामेति विख्यातः पुत्रस्तेजोगुणान्वितः\t॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2168714, "chapter_id": 4615, "verse_number": "९९", "content_sanskrit": "स तीव्रं तप आस्थाय प्रसादयितवान् भवम् ।\nअस्त्रहेतोः प्रसन्नात्मा नियतः संयतेन्द्रियः\t॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2168715, "chapter_id": 4615, "verse_number": "१००", "content_sanskrit": "तस्य तुष्टो महादेवो भक्त्या च प्रशमेन च ।\nहृद्गतं चास्य विज्ञाय दर्शयामास शङ्करः\t॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2168716, "chapter_id": 4615, "verse_number": "", "content_sanskrit": "ईश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2168717, "chapter_id": 4615, "verse_number": "१०१", "content_sanskrit": "राम तुष्टोऽस्मि भद्रं ते विदितं मे तवेप्सितम् ।\nकुरुष्व पूतमात्मानं सर्वमेतदवाप्स्यसि\t॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2168718, "chapter_id": 4615, "verse_number": "१०२", "content_sanskrit": "दास्यामि ते तदास्त्राणि यदा पूतो भविष्यसि ।\nअपात्रमसमर्थं च दहन्त्यस्त्राणि भार्गव\t॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2168719, "chapter_id": 4615, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2168720, "chapter_id": 4615, "verse_number": "१०३", "content_sanskrit": "इत्युक्तो जामदग्न्यस्तु देवदेवेन शूलिना ।\nप्रत्युवाच महात्मानं शिरसावनतः प्रभुम्\t॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2168721, "chapter_id": 4615, "verse_number": "१०४", "content_sanskrit": "यदा जानासि देवेश पात्रं मामस्त्रधारणे ।\nतदा शिश्रूषवेऽस्त्राणि भवान् मे दातुमर्हति\t॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2168722, "chapter_id": 4615, "verse_number": "१०५", "content_sanskrit": "ततः स तपसा चैव दमेन नियमेन च ।\nपूजोपहारबलिभिर्होममन्त्रपुरस्कृतैः\t॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2168723, "chapter_id": 4615, "verse_number": "१०६", "content_sanskrit": "आराधयितवान् शर्वं बहून् वर्षगणांस्तदा ।\nप्रसन्नश्च महादेवो भार्गवस्य महात्मनः\t॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2168724, "chapter_id": 4615, "verse_number": "१०७", "content_sanskrit": "अब्रवीत् तस्य बहुशो गुणान् देव्याः समीपतः ।\nभक्तिमानेष सततं मयि रामो दृढव्रतः\t॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2168725, "chapter_id": 4615, "verse_number": "१०८", "content_sanskrit": "एवं तस्य गुणान् प्रीतो बहुशोऽकथयत् प्रभुः ।\nदेवतानां पितॄणां च समक्षमरिसूदनः\t॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2168726, "chapter_id": 4615, "verse_number": "१०९", "content_sanskrit": "एतस्मिन्नेव काले तु दैत्या आसन् महाबलाः ।\nतैस्तदा दर्पमोहान्धैरबाध्यन्त दिवौकसः\t॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2168727, "chapter_id": 4615, "verse_number": "११०", "content_sanskrit": "ततः सम्भूय विबुधास्तान् हन्तुं कृतनिश्चयाः ।\nचक्रुः शत्रुवधे यत्नं न शेकुर्जेतुमेव ते\t॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2168728, "chapter_id": 4615, "verse_number": "१११", "content_sanskrit": "अभिगम्य ततो देवा महेश्वरमथाब्रुवन् ।\nप्रसादयन्तस्तं भक्त्या जहि शत्रुगणानिति\t॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2168729, "chapter_id": 4615, "verse_number": "११२", "content_sanskrit": "प्रतिज्ञाय ततो देवो देवतानां रिपुक्षयम् ।\nरामं भार्गवमाहूय सोऽभ्यभाषत शङ्करः\t॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2168730, "chapter_id": 4615, "verse_number": "११३", "content_sanskrit": "रिपून् भार्गव देवानां जहि सर्वान् समागतान् ।\nलोकानां हितकामार्थं मत्प्रीत्यर्थं तथैव च\t॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2168731, "chapter_id": 4615, "verse_number": "", "content_sanskrit": "रामः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2168732, "chapter_id": 4615, "verse_number": "११४", "content_sanskrit": "अकृतास्त्रस्य देवेश का शक्तिर्मे महेश्वर ।\nनिहन्तुं दानवान् सर्वान् कृतास्त्रान् युद्धदुर्मदान्\t॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2168733, "chapter_id": 4615, "verse_number": "", "content_sanskrit": "ईश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2168734, "chapter_id": 4615, "verse_number": "११५", "content_sanskrit": "गच्छ त्वं मदनुज्ञातो निहनिष्यसि दानवान् ।\nविजित्य च रिपून् सर्वान् गुणान् प्राप्स्यसि पुष्कलान्\t॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2168735, "chapter_id": 4615, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2168736, "chapter_id": 4615, "verse_number": "११६", "content_sanskrit": "एतच्छ्रुत्वा च वचनं प्रतिगृह्य च सर्वशः ।\nरामः कृतस्वस्त्ययनः प्रययौ दानवान् प्रति\t॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2168737, "chapter_id": 4615, "verse_number": "११७", "content_sanskrit": "अवधीद् देवशत्रूंस्तान् मददर्पबलान्वितान् ।\nशक्राशनिसमस्पर्शैः प्रहारैरेव भार्गवः\t॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 2168738, "chapter_id": 4615, "verse_number": "११८", "content_sanskrit": "स दानवैः क्षततनुर्जामदग्न्यो द्विजोत्तमः ।\nसंहृष्टः स्थाणुमासाद्य निपुणः समजायत\t॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 2168739, "chapter_id": 4615, "verse_number": "११९", "content_sanskrit": "प्रीतश्च भगवान् देवः कर्मणा तेन तस्य वै ।\nवरान् प्रादाद् ब्रह्मविदे भार्गवाय महात्मने\t॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 2168740, "chapter_id": 4615, "verse_number": "१२०", "content_sanskrit": "उक्तश्च देवदेवेन प्रीतियुक्तेन शूलिना ।\nनिपातात् तव शस्त्राणां शरीरे मा भवद् रुजा\t॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 2168741, "chapter_id": 4615, "verse_number": "१२१", "content_sanskrit": "तया तेऽमानुषं कर्म नापोहद् भृगुनन्दन ।\nगृहाणास्त्राणि दिव्यानि मत्सकाशाद्यथेप्सितम् ।\nलब्ध्वा बहुविधान् रामः प्रणम्य शिरसा शिवम्\t॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 2168742, "chapter_id": 4615, "verse_number": "१२२", "content_sanskrit": "अनुज्ञां प्राप्य देवेशात् जगाम स महातपाः ।\nततोऽस्त्राणि समस्तानि वरांश्च मनसेप्सितान् \t॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 2168743, "chapter_id": 4615, "verse_number": "१२३", "content_sanskrit": "एवमेतत् पुरावृत्तं तदा कथितवानृषिः\t॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 2168744, "chapter_id": 4615, "verse_number": "१२४", "content_sanskrit": "भार्गवोऽप्यददात् सर्वं धनुर्वेदं महात्मने ।\nकर्णाय पुरुषव्याघ्र सुप्रीतेनान्तरात्मना\t॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 2168745, "chapter_id": 4615, "verse_number": "१२५", "content_sanskrit": "वृजिनं हि भवेत् किञ्चिद्यदि कर्णस्य पार्थिव ।\nनास्मै ह्यस्त्राणि दिव्याणि प्रादास्यद् भृगुनन्दनः\t॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 2168746, "chapter_id": 4615, "verse_number": "१२६", "content_sanskrit": "नापि सूतकुले जातं कर्णं मन्ये कथञ्चन ।\nदेवपुत्रमहं मन्ये क्षत्रियाणां कुलोद्भवम्\t॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 2168747, "chapter_id": 4615, "verse_number": "१२७", "content_sanskrit": "विसृष्टं नावबोधार्थं कुलस्येति मतिर्मम\t॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 2168748, "chapter_id": 4615, "verse_number": "१२८", "content_sanskrit": "सकुण्डलं सकवचं दीर्घबाहुं महारथम् ।\nकथमादित्यसदृशं मृगी व्याघ्रं जनिष्यति\t॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 2168749, "chapter_id": 4615, "verse_number": "१२९", "content_sanskrit": "पश्य ह्यस्य भुजौ पीनौ नागराजकरोपमौ ।\nवक्षः पश्य विशालं च सर्वशत्रुनिबर्हणम्\t॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 2168750, "chapter_id": 4615, "verse_number": "१३०", "content_sanskrit": "न त्वेष प्राकृतः कश्चित् कर्णे वैकर्तनो वृषः ।\nमहात्मा ह्येष राजेन्द्र रामशिष्यः प्रतापवान्\t॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 2168751, "chapter_id": 4615, "verse_number": "३५", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां कर्णपर्वणि पञ्चत्रिंशोऽध्यायः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 2168752, "chapter_id": 4615, "verse_number": "", "content_sanskrit": "––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}]