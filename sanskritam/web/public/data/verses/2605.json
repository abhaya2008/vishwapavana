[{"id": 2075789, "chapter_id": 2605, "verse_number": "१२-११०-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2075790, "chapter_id": 2605, "verse_number": "१२-११०-१", "content_sanskrit": "क्लिश्यमानेषु भूतेषु तैस्तैर्भावैः पृथक्पृथक्।\nदुर्गाण्यतितरेद्येन तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2075791, "chapter_id": 2605, "verse_number": "१२-११०-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2075792, "chapter_id": 2605, "verse_number": "१२-११०-२", "content_sanskrit": "आश्रमेषु यथोक्तेषु यथोक्तं ये द्विजातयः।\nवर्तन्ते संयतात्मानो दुर्गाण्यतितरन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2075793, "chapter_id": 2605, "verse_number": "१२-११०-३", "content_sanskrit": "ये दम्भान्नाचरन्ति स्म येषां वृत्तिश्च संयता।\nविषयांश्च निगृह्णन्ति दुर्गाण्यतितरन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2075794, "chapter_id": 2605, "verse_number": "१२-११०-४", "content_sanskrit": "प्रत्याहुर्नोच्यमाना ये न हिंसन्ति च हिंसिताः।\nप्रयच्छन्ति न याचन्ते दुर्गाण्यतितरन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2075795, "chapter_id": 2605, "verse_number": "१२-११०-५", "content_sanskrit": "वासयन्त्यतिथीन्नित्यं नित्यं ये चानसूयकाः।\nनित्यं स्वाध्यायशीलाश्च दुर्गाण्यतितरन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2075796, "chapter_id": 2605, "verse_number": "१२-११०-६", "content_sanskrit": "मातापित्रोश्च ये वृत्तिं वर्तन्ते धर्मकोविदाः।\nवर्जयन्ति दिवास्वप्नं दुर्गाण्यतितरन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2075797, "chapter_id": 2605, "verse_number": "१२-११०-७", "content_sanskrit": "ये वा पापं न कुर्वन्ति कर्मणा मनसा गिरा।\nनिक्षिप्तदण्डा भूतेषु दुर्गाण्यतितरन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2075798, "chapter_id": 2605, "verse_number": "१२-११०-८", "content_sanskrit": "ये न लोभान्नयन्त्यर्थान्राजानो रजसाऽन्विताः।\nविषयान्परिरक्षन्ति दुर्गाण्यतितरन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2075799, "chapter_id": 2605, "verse_number": "१२-११०-९", "content_sanskrit": "स्वेषु दारेषु वर्तन्ते न्यायलब्धेष्वृतावृतौ।\nअग्निहोत्रपराः सन्तो दुर्गाण्यतितरन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2075800, "chapter_id": 2605, "verse_number": "१२-११०-१०", "content_sanskrit": "आहवेषु च ये शूरास्त्यक्त्वा मृत्युकृतं भयम्।\nधर्मेण जयमिच्छन्ति दुर्गाण्यतितरन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2075801, "chapter_id": 2605, "verse_number": "१२-११०-११", "content_sanskrit": "ये वदन्तीह सत्यानि प्राणत्यागेऽप्युपस्थिते।\nप्रमाणभूता भूतानां दुर्गाण्यतितरन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2075802, "chapter_id": 2605, "verse_number": "१२-११०-१२", "content_sanskrit": "कर्माण्यकुत्सनार्थानि येषां वाचश्च सूनृताः।\nयेषामर्थाश्च साध्वर्था दुर्गाण्यतितरन्ति ते।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2075803, "chapter_id": 2605, "verse_number": "१२-११०-१३", "content_sanskrit": "अनध्यायेषु ये विप्राः स्वाध्यायं नैव कुर्वते।\nतपोनिष्ठाः सुतपसो दुर्गाण्यतितरन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2075804, "chapter_id": 2605, "verse_number": "१२-११०-१४", "content_sanskrit": "ये तपश्च तपस्यन्ति कौमारब्रह्मचारिणः।\nविद्या वेदव्रतस्नाता दुर्गाण्यतितरन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2075805, "chapter_id": 2605, "verse_number": "१२-११०-१५", "content_sanskrit": "ये च संशान्तरजसः संशान्ततमसश्च ये।\nसत्वे स्थिता महाभागा दुर्गाण्यतितरन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2075806, "chapter_id": 2605, "verse_number": "१२-११०-१६", "content_sanskrit": "येषां न कश्चित्रसति न त्रसन्ति हि कस्यचित्।\nयेषामात्मसमो लोको दुर्गाण्यतितरन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2075807, "chapter_id": 2605, "verse_number": "१२-११०-१७", "content_sanskrit": "परश्रिया न तप्यन्ति ये सन्तः पुरुषर्षभाः।\nग्राम्यादन्नान्निवृत्ताश्च दुर्गाण्यतितरन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2075808, "chapter_id": 2605, "verse_number": "१२-११०-१८", "content_sanskrit": "सर्वान्देवान्नमस्यन्ति सर्वधर्मांश्च शृण्वते।\nये श्रद्दधानाः शान्ताश्च दुर्गाण्यतितरन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2075809, "chapter_id": 2605, "verse_number": "१२-११०-१९", "content_sanskrit": "ये न मानित्वमिच्छन्ति मानयन्ति च ये परान्।\nमान्यमानान्नमस्यन्ति दुर्गाण्यतितरन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2075810, "chapter_id": 2605, "verse_number": "१२-११०-२०", "content_sanskrit": "ये च श्राद्धानि कुर्वन्ति तिथ्यांतिथ्यां प्रजार्थिनः।\nसुविशुद्धेन मनसा दुर्गाण्यतितरन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2075811, "chapter_id": 2605, "verse_number": "१२-११०-२१", "content_sanskrit": "ये क्रोधं संनियच्छन्ति क्रुद्धान्संशमयन्ति च।\nन च रुष्यन्ति भृत्यानां दुर्गाण्यतितरन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2075812, "chapter_id": 2605, "verse_number": "१२-११०-२२", "content_sanskrit": "मधु मांसं स्त्रियो नित्यं वर्जयन्तीह मानवाः।\nजन्मप्रभृति मद्यं च दुर्गाण्यतितरन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2075813, "chapter_id": 2605, "verse_number": "१२-११०-२३", "content_sanskrit": "यात्रार्थं भोजनं येषां संतानार्थं च मैथुनम्।\nवाक् सत्यवचनार्थं च दुर्गाण्यतितरन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2075814, "chapter_id": 2605, "verse_number": "१२-११०-२४", "content_sanskrit": "ईश्वरं सर्वभूतानां जगतः प्रभवाप्ययम्।\nभक्ता नारायणं देवं दुर्गाण्यतितरन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2075815, "chapter_id": 2605, "verse_number": "१२-११०-२५", "content_sanskrit": "य एष पझरक्ताक्षः पीतवासा महाभुजः।\nसुहृद्धाता च मित्रं च संबन्धी च तवाच्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2075816, "chapter_id": 2605, "verse_number": "१२-११०-२६", "content_sanskrit": "य इमान्सकलाँल्लोकांश्चर्मवत्परिवेष्टयेत्।\nइच्छन्प्रभुरचिन्त्यात्मा गोविन्दः पुरुषोत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2075817, "chapter_id": 2605, "verse_number": "१२-११०-२७", "content_sanskrit": "स्थितः प्रियहिते नित्यं स एष पुरुषोत्तमः।\nराजंस्तव यदुश्रेष्ठो वैकुण्ठः पुरुषर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2075818, "chapter_id": 2605, "verse_number": "१२-११०-२८", "content_sanskrit": "य एनं संश्रयन्तीह भक्त्या नारायणं हरिम्।\nते तरन्तीह दुर्गाणि न चात्रास्ति विचारणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2075819, "chapter_id": 2605, "verse_number": "१२-११०-२९", "content_sanskrit": "` अस्मिन्नर्पितकर्माणः सर्वभावेन भारत।\nकृष्णे कमलपत्राक्षे दुर्गाण्यतितरन्ति ते।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2075820, "chapter_id": 2605, "verse_number": "१२-११०-३०", "content_sanskrit": "लोकरक्षार्थमुत्पन्नमदित्यां कश्यपात्मजम्।\nदेवमिन्द्रं नमस्यन्ति दुर्गाण्यतितरन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2075821, "chapter_id": 2605, "verse_number": "१२-११०-३१", "content_sanskrit": "ब्रह्माणं लोककर्तारं ये नमस्यन्ति सत्पतिम्।\nयष्टव्यं क्रतुभिर्देवं दुर्गाण्यतितरन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2075822, "chapter_id": 2605, "verse_number": "१२-११०-३२", "content_sanskrit": "यं विष्णुरिन्द्रः शंभुश्च ब्रह्मा लोकपितामहः।\nस्तुवन्ति विविधैः स्तोत्रैर्देवदेवं महेश्वरम्।\nसमर्चयन्ति ये शश्वद्दुर्गाण्यतितरन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2075823, "chapter_id": 2605, "verse_number": "१२-११०-३३", "content_sanskrit": "दुर्गातितरणं ये च पठन्ति श्रावयन्ति च।\nकथयन्ति च विप्रेभ्यो दुर्गाण्यतितरन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2075824, "chapter_id": 2605, "verse_number": "१२-११०-३४", "content_sanskrit": "इति कृत्यसमुद्देशः कीर्तितस्ते मयाऽनघ।\nतरते येन दुर्गाणि परत्रेह च मानवः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2075825, "chapter_id": 2605, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि दशाधिकशततमोऽध्यायः॥ ११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]