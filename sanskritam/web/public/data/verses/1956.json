[{"id": 2042803, "chapter_id": 1956, "verse_number": "६-५-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2042804, "chapter_id": 1956, "verse_number": "६-५-१", "content_sanskrit": "नदीनां पर्वतानां च नामधेयानि संजय ।\nतथा जनपदानां च ये चान्ये भूमिमाश्रिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2042805, "chapter_id": 1956, "verse_number": "६-५-२", "content_sanskrit": "प्रमाणं च प्रमाणज्ञ पृथिव्या मम सर्वतः ।\nनिखिलेन समाचक्ष्व काननानि च संजय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2042806, "chapter_id": 1956, "verse_number": "६-५-३x", "content_sanskrit": "संजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2042807, "chapter_id": 1956, "verse_number": "६-५-३", "content_sanskrit": "पञ्चेमानि महाराज महाभूतानि संग्रहात्।\nजगतीस्थानि सर्वाणि समान्याहुर्मनीषिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2042808, "chapter_id": 1956, "verse_number": "६-५-४", "content_sanskrit": "भूमिरापस्तथा वायुरग्निराकाशमेव च।\nगुणोत्तराणि सर्वाणि तेषां भूमिः प्रधानतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2042809, "chapter_id": 1956, "verse_number": "६-५-५", "content_sanskrit": "शब्दः स्पर्शश्च रूपं च रसो गन्धश्च पञ्चमः।\nभूमेरेते गुणाः प्रोक्ता ऋषिभिस्तत्त्ववेदिभिःक ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2042810, "chapter_id": 1956, "verse_number": "६-५-६", "content_sanskrit": "चत्वारोऽप्सु गुणा राजन्गन्धस्तत्र न विद्यते।\nशब्दः स्पर्शश्च रूपं च तेजसोऽथ गुणास्त्रयः ।\nशब्दः स्पर्शश्च वायौ द्वौ अकाशे शब्द एव तु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2042811, "chapter_id": 1956, "verse_number": "६-५-७", "content_sanskrit": "एते पञ्च गुणा राजन्महाभूतेषु पञ्चसु।\nवर्तन्ते सर्वलोकेषु येषु भूताः प्रतिष्ठिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2042812, "chapter_id": 1956, "verse_number": "६-५-८", "content_sanskrit": "अन्योन्यं नाभिवर्तन्ते साम्यं भवति वै यदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2042813, "chapter_id": 1956, "verse_number": "६-५-९", "content_sanskrit": "यदा तु विषमीभावमाविशन्ति परस्परम् ।\nतदा देहैर्देहवन्तो व्यतिरोहन्ति नान्यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2042814, "chapter_id": 1956, "verse_number": "६-५-१०", "content_sanskrit": "आनुपूर्व्या विनश्यन्ति जायन्ते चानुपूर्वशः ।\nसर्वाम्यपरिमेयाणि तदेषां रूपमैश्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2042815, "chapter_id": 1956, "verse_number": "६-५-११", "content_sanskrit": "तत्रतत्र हि दृश्यन्ते धातवः पाञ्चभौतिकाः ।\nतेषां मनुष्यास्तर्केण प्रमाणानि प्रचक्षते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2042816, "chapter_id": 1956, "verse_number": "६-५-१२", "content_sanskrit": "अचिन्त्याः खलु ये भावा न तांस्तर्केण साधयेत्।\nप्रकृतिभ्यः परं यत्तु तदचिन्त्यस्य लक्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2042817, "chapter_id": 1956, "verse_number": "६-५-१३", "content_sanskrit": "सुदर्शनं प्रवक्ष्यामि द्वीपं तु कुरुनन्दन।\nपरिमण्डलो महाराज द्वीपोऽसौ चक्रसंस्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2042818, "chapter_id": 1956, "verse_number": "६-५-१४", "content_sanskrit": "नदीजालप्रतिच्छन्नः पर्वतैश्चाभ्रसन्निभैः ।\nपुरैश्च विविधाकारै रम्यैर्जनपदैस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2042819, "chapter_id": 1956, "verse_number": "६-५-१५", "content_sanskrit": "वृक्षैः पुष्पफलोपेतैः संपन्नधनधान्यवान् ।\nलवणेन समुद्रेण समन्तात्परिवारितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2042820, "chapter_id": 1956, "verse_number": "६-५-१६", "content_sanskrit": "यथा हि पुरुषः पश्येदादर्शे मुखमात्मनः ।\nएवं सुदर्शनद्वीपो दृश्यते चन्द्रमण्डले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2042821, "chapter_id": 1956, "verse_number": "६-५-१७", "content_sanskrit": "द्विरशस्तु ततः प्लक्षो द्विरंशः शाल्मलिर्महान् ।\nद्विरंशः पिप्पलस्तस्य द्विरंशश्च कुशो महान्।\nसर्वौषधिसमापन्नः पर्वतैः परिवारितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2042822, "chapter_id": 1956, "verse_number": "६-५-१८", "content_sanskrit": "आपस्ततोऽन्या विज्ञेयाः शेषः संक्षेप उच्यते।\nततोऽन्य उच्यते चायमेनं संक्षेपतः श्रृणु ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2042823, "chapter_id": 1956, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि जम्बूखण्डविनिर्माणपर्वणि पञ्चमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]