[{"id": 40006527, "chapter_id": 8981, "verse_number": "1", "content_sanskrit": "इत्युक्त्वा लक्ष्मणश्श्रीमान्विराधे प्रहसन्निव। कोभवान्वनमभ्येत्य चरिष्यसि यथासुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40006528, "chapter_id": 8981, "verse_number": "2", "content_sanskrit": "अथोवाच पुनर्वाक्यं विराधः पूरयन्वनम्। पृच्छतो मम हि ब्रूतं कौ युवां क्व गमिष्यथः।।3.3.2.।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40006529, "chapter_id": 8981, "verse_number": "3", "content_sanskrit": "तमुवाच ततो रामो राक्षसं ज्वलिताननम्। पृच्छन्तं सुमहातेजा इक्ष्वाकुकुलमात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40006530, "chapter_id": 8981, "verse_number": "4", "content_sanskrit": "क्षत्रियौ वृत्तसम्पन्नौ विद्धि नौ वनगोचरौ। त्वां तु वेदितुमिच्छावः कस्त्वं चरसि दण्डकान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40006531, "chapter_id": 8981, "verse_number": "5", "content_sanskrit": "तमुवाच विराधस्तु रामं सत्यपराक्रमम्। हन्त वक्ष्यामि ते राजन्निबोध मम राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40006532, "chapter_id": 8981, "verse_number": "6", "content_sanskrit": "पुत्रः किल जयस्याहं माता मम शतह्रदा। विराध इति मामाहुः पृथिव्यां सर्वराक्षसाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40006533, "chapter_id": 8981, "verse_number": "7", "content_sanskrit": "तपसा चाभिसम्प्राप्ता ब्रह्मणो हि प्रसादजा। शस्त्रेणावध्यता लोकेऽच्छेद्याभेद्यत्वमेव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40006534, "chapter_id": 8981, "verse_number": "8", "content_sanskrit": "उत्सृज्य प्रमदामेनामनपेक्षौ यथागतम्। त्वरमाणौ पलायेथां न वां जीवितमाददे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40006535, "chapter_id": 8981, "verse_number": "9", "content_sanskrit": "तं रामः प्रत्युवाचेदं कोपसंरक्तलोचनः। राक्षसं विकृताकारं विराधं पापचेतसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40006536, "chapter_id": 8981, "verse_number": "10", "content_sanskrit": "क्षुद्र धिक्त्वां तु हीनार्थं मृत्युमन्वेषसे ध्रुवम्। रणे प्राप्स्यसे सन्तिष्ठ न मे जीवन् गमिष्यासि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40006537, "chapter_id": 8981, "verse_number": "11", "content_sanskrit": "ततः सज्यं धनुः कृत्वा रामस्सुनिशिताञ्छरान्। सुशीघ्रमभिसन्धाय राक्षसं निजघान ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40006538, "chapter_id": 8981, "verse_number": "12", "content_sanskrit": "धनुषा ज्यागुणवता सप्त बाणान्मुमोच ह। रुक्मपुङ्खान्महावेगान्सुपर्णानिलतुल्यगान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40006539, "chapter_id": 8981, "verse_number": "13", "content_sanskrit": "ते शरीरं विराधस्य भित्त्वाबर्हिणवाससः। निपेतुश्शोणितादिग्धा धरण्यां पावकोपमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40006540, "chapter_id": 8981, "verse_number": "14", "content_sanskrit": "स विद्धो न्यस्य वैदेहीं शूलमुद्यम्य राक्षसः। अभ्यद्रवत्सुसङ्कृद्धस्तदा रामं सलक्ष्मणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40006541, "chapter_id": 8981, "verse_number": "15", "content_sanskrit": "स विनद्य महानादं शूलं शक्रध्वजोपमम्। प्रगृह्याशोभत तदा व्यात्तानन इवान्तकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40006542, "chapter_id": 8981, "verse_number": "16", "content_sanskrit": "अथ तौ भ्रातरौ दीप्तं शरवर्षं ववर्षतुः। विराधे राक्षसे तस्मिन् कालान्तकयमोपमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40006543, "chapter_id": 8981, "verse_number": "17", "content_sanskrit": "स प्रहस्य महारौद्रः स्थित्वाजृम्भत राक्षसः। जृम्भमाणस्य ते बाणाः कायान्निष्पेतुराशुगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40006544, "chapter_id": 8981, "verse_number": "18", "content_sanskrit": "स्पर्शात्तु वरदानेन प्राणान्सम्रोध्य राक्षसः। विराधः शूलमुद्यम्य राघवावभ्यधावत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40006545, "chapter_id": 8981, "verse_number": "19", "content_sanskrit": "तच्छूलं वज्रसङ्काशं गगने ज्वलनोपमम्। द्वाभ्यां शराभ्यां चिच्छेद रामः शस्त्रभृतांवरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40006546, "chapter_id": 8981, "verse_number": "20", "content_sanskrit": "तद्रामविशिखच्छिन्नं शूलं तस्यकराद्भुवि। पपाताशनिना छिन्नं मेरोरिव शिलातलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40006547, "chapter_id": 8981, "verse_number": "21", "content_sanskrit": "तौ खड्गौ क्षिप्रमुद्यम्य कृष्णसर्पोपमौशुभौ। तूर्णमापेततुस्तस्य तदा प्रहरतां बलात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40006548, "chapter_id": 8981, "verse_number": "22", "content_sanskrit": "स वध्यमानः सुभृशं भुजाभ्यां परिरभ्यतौ। अप्रकम्प्यौ नरव्याघ्रौ रौद्रः प्रस्थातुमैच्छत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40006549, "chapter_id": 8981, "verse_number": "23", "content_sanskrit": "तस्याभिप्रायमाज्ञाय रामो लक्ष्मणमब्रवीत्। वहत्वयमलं तावत्पथाऽनेन तु राक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40006550, "chapter_id": 8981, "verse_number": "24", "content_sanskrit": "यथा चेच्छति सौमित्रे तथा वहतु राक्षसः। अयमेव हि नः पन्था येन याति निशाचरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40006551, "chapter_id": 8981, "verse_number": "25", "content_sanskrit": "स तु स्वबलवीर्येण समुत्क्षिप्य निशाचरः। बालाविव स्कन्धगतौ चकारातिबलोद्धतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40006552, "chapter_id": 8981, "verse_number": "26", "content_sanskrit": "तावारोप्य ततः स्कन्धं राघवौ रजनीचरः। विराधो विनदन्घोरं जगामाभिमुखो वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]