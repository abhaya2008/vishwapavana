[{"id": 2035529, "chapter_id": 1768, "verse_number": "५-१३-०x", "content_sanskrit": "शल्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2035530, "chapter_id": 1768, "verse_number": "५-१३-१", "content_sanskrit": "अथ तामब्रवीद्दृष्ट्वा नहुषो देवराट् तदा।\nत्रयाणामपि लोकानामहमिन्द्रः शुचिस्मिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2035531, "chapter_id": 1768, "verse_number": "५-१३-२", "content_sanskrit": "भजस्व मां वरारोहे पतित्वे वरवर्णिनि।\nएवमुक्ता तु सा देवी नहुषेण पतिव्रता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2035532, "chapter_id": 1768, "verse_number": "५-१३-३", "content_sanskrit": "प्रावेपत भयोद्विग्ना प्रवाते कदली यथा।\nप्रणम्य सा हि ब्रह्माणं शिरसा तु कृताञ्जलिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2035533, "chapter_id": 1768, "verse_number": "५-१३-४", "content_sanskrit": "देवराजमथोवाच नहुषं घोरदर्शनम् ।\nकालमिच्छाम्यहं लब्धुं त्वत्तः कंचित्सुरेश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2035534, "chapter_id": 1768, "verse_number": "५-१३-५", "content_sanskrit": "न हि विज्ञायते शक्रः किं वा प्राप्तः क्व वा गतः।\nतत्त्वमेतत्तु विज्ञाय यदि न ज्ञायते प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2035535, "chapter_id": 1768, "verse_number": "५-१३-६", "content_sanskrit": "ततोऽहं त्वामुपस्थास्ये सत्यमेतद्ब्रवीमि ते।\nएवमुक्तः स इन्द्राण्या नहुषः प्रीतिमानभूत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2035536, "chapter_id": 1768, "verse_number": "५-१३-७x", "content_sanskrit": "नहुष उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2035537, "chapter_id": 1768, "verse_number": "५-१३-७", "content_sanskrit": "एवं भवतु सुश्रोणि यथा मामिह भाषसे।\nज्ञात्वा चागमनं कार्यं सत्यमेतदनुस्मरेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2035538, "chapter_id": 1768, "verse_number": "५-१३-८", "content_sanskrit": "नहुषेण विसृष्टा च निश्चक्राम ततः शुभा।\nबृहस्पतिनिकेतं च सा जगाम यशस्विनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2035539, "chapter_id": 1768, "verse_number": "५-१३-९", "content_sanskrit": "तस्याः संश्रुत्य च वचो देवाश्चाग्निपुरोगमाः ।\nचिन्तयामासुरेकाग्राः शक्रार्थं राजसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2035540, "chapter_id": 1768, "verse_number": "५-१३-१०", "content_sanskrit": "देवदेवेन शङ्गम्य विष्णुना प्रभविष्णुना।\nऊचुश्चैनं समुद्विग्ना वाक्यं वाक्यविशारदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2035541, "chapter_id": 1768, "verse_number": "५-१३-११", "content_sanskrit": "ब्रह्मवध्याभिभूतो वै शक्रः सुरगणेश्वरः ।\nगतिश्च नस्त्वं देवेश पूर्वजो जगतः प्रभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2035542, "chapter_id": 1768, "verse_number": "५-१३-१२", "content_sanskrit": "रक्षार्थं सर्वभूतानां विष्णुत्वमुपजग्मिवान्।\nत्वद्वीर्यनिहते वृत्रे वासवो ब्रह्महत्यया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2035543, "chapter_id": 1768, "verse_number": "५-१३-१३", "content_sanskrit": "वृतः सुरगणश्रेष्ठ मोक्षं तस्य विनिर्दिश।\nतेषां तद्वचनं श्रुत्वा देवानां विष्णुरब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2035544, "chapter_id": 1768, "verse_number": "५-१३-१४", "content_sanskrit": "मामेव यजतां शक्रः पावयिष्यामि वज्रिणम्।\nपुण्येन हयमेधेन मामिष्ट्वा पाकशासनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2035545, "chapter_id": 1768, "verse_number": "५-१३-१५", "content_sanskrit": "पुनरेष्यति देवानामिन्द्रत्वमकुतोभयः।\nस्वकर्मभिश्च नहुषो नाशं यास्यति दुर्मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2035546, "chapter_id": 1768, "verse_number": "५-१३-१६", "content_sanskrit": "किंचित्कालमिदं देवा मर्षयध्वमतन्द्रिताः।\nश्रुत्वा विष्णोः शुभां सत्यां वाणीं ताममृतोपमाम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2035547, "chapter_id": 1768, "verse_number": "५-१३-१७", "content_sanskrit": "ततः सर्वे सुरगणाः सोपाध्यायाः सहर्षिभिः ।\nयत्र शक्रो भयोद्विग्नस्तं देशमुपचक्रमुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2035548, "chapter_id": 1768, "verse_number": "५-१३-१८", "content_sanskrit": "तत्राश्वमेधः सुमहान्महेन्द्रस्य महात्मनः ।\nववृते पावनार्थं वै ब्रह्महत्यापहो नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2035549, "chapter_id": 1768, "verse_number": "५-१३-१९", "content_sanskrit": "विभज्य ब्रह्महत्यां तु वृक्षेषु च नदीषु च।\nपर्वतेषु पृथिव्यां च स्त्रीषु चैव युधिष्ठिर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2035550, "chapter_id": 1768, "verse_number": "५-१३-२०", "content_sanskrit": "संविभज्य च भूतेषु विसृज्य च सुरेश्वरः।\nविज्वरो धूतपाप्मा च वासवोऽभवदात्मवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2035551, "chapter_id": 1768, "verse_number": "५-१३-२१", "content_sanskrit": "अकम्प्यं नहुषं स्थानाद्दृष्ट्वा बलनिषूदनः।\nतेजोघ्नं सर्वभूतानां वरदानाच्च दुःसहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2035552, "chapter_id": 1768, "verse_number": "५-१३-२२", "content_sanskrit": "ततः शचीपतिर्देवः पुनरेव व्यनश्यत।\nअदृश्यः सर्वभूतानां कालाकाङ्क्षी चचार ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2035553, "chapter_id": 1768, "verse_number": "५-१३-२३", "content_sanskrit": "प्रनष्टे तु ततः शक्रे शची शोकसमन्विता ।\nहा शक्रेति तदा देवी विललाप सुदुःखिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2035554, "chapter_id": 1768, "verse_number": "५-१३-२४", "content_sanskrit": "यदि दत्तं यदि हुतं गुरवस्तोषिता यदि।\nएकभर्तृत्वमेवास्तु सत्यं यद्यस्ति वा मयि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2035555, "chapter_id": 1768, "verse_number": "५-१३-२५", "content_sanskrit": "पुण्यां चेमामहं दिव्यां प्रवृत्तामुत्तरायणे।\nदेवीं रात्रिं नमस्यामि सिध्यतां मे मनोरथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2035556, "chapter_id": 1768, "verse_number": "५-१३-२६", "content_sanskrit": "प्रयता च निशां देवीमुपातिष्ठत तत्र सा।\nपतिव्रतात्वात्सत्येन सोपश्रुतिमथाकरोत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2035557, "chapter_id": 1768, "verse_number": "५-१३-२७", "content_sanskrit": "यत्रास्ते देवराजोऽसौ तं देशं दर्शयस्व मे।\nइत्याहोपश्रुतिं देवीं सत्यं सत्येन दृश्यताम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2035558, "chapter_id": 1768, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि सेनोद्योगपर्वणि त्रयोदशोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]