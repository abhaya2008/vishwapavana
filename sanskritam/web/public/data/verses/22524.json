[{"id": 7002524000, "chapter_id": 22524, "verse_number": "१-१८६-१", "content_sanskrit": "भास्कर उवाच ।\nश्रावण्यां तु बलिः कार्यः सर्पाणां मंत्रपूर्वकः ।\nशयनारोहणे चैव कार्ये सुखमभीप्सता ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002524001, "chapter_id": 22524, "verse_number": "१-१८६-२", "content_sanskrit": "कार्यः प्रत्यवरोहस्तु मार्गशीर्ष्यां न संशयः ।\nफलं विना त्वनुष्ठानं नित्यानामिष्यते स्फुटम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002524002, "chapter_id": 22524, "verse_number": "१-१८६-३", "content_sanskrit": "काम्यानां सफलार्थं तु दोषप्राप्त्यर्थमेव च ।\nनैमित्तिकानां करणं त्रिविधं कर्मणां फलम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002524003, "chapter_id": 22524, "verse_number": "१-१८६-४", "content_sanskrit": "फलं केचिदुपात्तस्य दुरितस्य प्रचक्षते ।\nअनुत्पत्तिं तथा चान्ये प्रत्येत्याभ्युपमंत्र्य च ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002524004, "chapter_id": 22524, "verse_number": "१-१८६-५", "content_sanskrit": "नित्यक्रियं तथा चान्ये अनुषंगात्फलं श्रुतिः ।\nअग्न्याधेयं तथा दर्शं पौर्णमासं द्वितीयकम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002524005, "chapter_id": 22524, "verse_number": "१-१८६-६", "content_sanskrit": "चातुर्मास्यमग्निहोत्रं पशुबंधो निरूढकाः ।\nसौत्रामणी संस्थाः स्युर्हविषः श्रुतिनोदिताः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002524006, "chapter_id": 22524, "verse_number": "१-१८६-७", "content_sanskrit": "अग्निष्टोमोऽत्यग्निष्टोम उक्थ्यः संषोडशी तथा ।\nवाजपेयातिरात्रश्च आप्योर्यामः श्रुतौ श्रुतः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002524007, "chapter_id": 22524, "verse_number": "१-१८६-८", "content_sanskrit": "दया स्यात्सर्वभूतेषु अनसूयाथ मंगलम् ।\nक्षांतिर्दया त्वनायासः शौचमस्पृहता व्रतम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002524008, "chapter_id": 22524, "verse_number": "१-१८६-९", "content_sanskrit": "सम्यगुक्तास्तु संस्कारा ब्रह्मप्राप्तिनिमित्तकाः ।\nअनंतरं प्रवक्ष्यामि विप्राणां वृत्तयः शुभाः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002524009, "chapter_id": 22524, "verse_number": "१-१८६-१०", "content_sanskrit": "ऋतामृते च विप्राणामृतं प्रमृतमेव च ।\nप्रतिग्रहवणिज्यादि श्रेयसी नोत्तरोत्तरा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002524010, "chapter_id": 22524, "verse_number": "१-१८६-११", "content_sanskrit": "आजीविकावृत्तयस्तु इत्याद्याः संप्रवर्तिताः ।\nतासां कयापि जीवेत्तु अनुतिष्ठेद्यथाविधि ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002524011, "chapter_id": 22524, "verse_number": "१-१८६-१२", "content_sanskrit": "नित्यं शुचिः सुगंधश्च स्नानशीलः प्रियंवदः ।\nपूज्यश्च पूजयेद्देवान्कार्याणि स्वयमाचरेत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002524012, "chapter_id": 22524, "verse_number": "१-१८६-१३", "content_sanskrit": "नेक्षेतार्कं न नग्नां स्त्रीं न च संस्पृष्ट मैथुनम् ।\nनाप्सु मूत्रं पुरीषं वा नाशुची रात्रितारकाः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002524013, "chapter_id": 22524, "verse_number": "१-१८६-१४", "content_sanskrit": "शास्त्रोक्ता यंत्रणा या तु नानुक्तानि व्रतानि च ।\nस्वर्गार्थं साधयेत्तैश्च शक्तिमान्मनसा तथा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002524014, "chapter_id": 22524, "verse_number": "१-१८६-१५", "content_sanskrit": "नित्यानि केचिदिच्छंति काम्यानि च तथापरे ।\nकाम्याप्रवृत्तौ संगे च प्रायश्चित्तं विधीयते ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002524015, "chapter_id": 22524, "verse_number": "१-१८६-१६", "content_sanskrit": "व्रतानि मनसा त्विष्टसंकल्प इति मानसः ।\nअंतरानुफलं यत्तदृषिवादाः प्रकीर्तिताः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002524016, "chapter_id": 22524, "verse_number": "१-१८६-१७", "content_sanskrit": "अनध्यायं स्वयं सम्यग्वर्जयेत्फलसाधनम् ।\nआत्मा शुद्धस्तथा देशो ह्यसुहारः प्रजापदः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002524017, "chapter_id": 22524, "verse_number": "१-१८६-१८", "content_sanskrit": "अशुभानि निमित्तानि उत्पातो विकृतं तथा ।\nपर्वाणि मनसोऽशुद्धिरनध्याय इति स्मृतः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002524018, "chapter_id": 22524, "verse_number": "१-१८६-१९", "content_sanskrit": "अनध्यायाश्च दृष्टार्था अदृष्टार्थास्तथापरे ।\nवेदाध्ययनमेवेति त्रिधा मद्ध्यानदर्शनम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002524019, "chapter_id": 22524, "verse_number": "१-१८६-२०", "content_sanskrit": "अभक्ष्यं सर्ववर्णानां शावाशौचं खगाधिप ।\nद्रव्यशुद्धिस्तथैव स्यादन्यथा त्वसमंजसम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002524020, "chapter_id": 22524, "verse_number": "१-१८६-२१", "content_sanskrit": "जातिदुष्टं क्रियादुष्टं कालदुष्टं विभूषितम् ।\nसंसर्गाश्रयदुष्टं च सहृल्लेखं स्वभावतः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002524021, "chapter_id": 22524, "verse_number": "१-१८६-२२", "content_sanskrit": "लशुनं गृंजनं चैव पलांडुं कवकानि च ।\nवार्ताकं नालिकेरं तु मूलकं जातिदुष्टकम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002524022, "chapter_id": 22524, "verse_number": "१-१८६-२३", "content_sanskrit": "नो भुञ्जीत क्रियादुष्टं दुष्टं च पतितैः पृथक् ।\nकालदुष्टं तु विज्ञेयं हानिदं चिरसंस्थितम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002524023, "chapter_id": 22524, "verse_number": "१-१८६-२४", "content_sanskrit": "दधिभक्ष्यविकाराश्च मधुवर्ज्यास्तदिष्यते ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002524024, "chapter_id": 22524, "verse_number": "१-१८६-२५", "content_sanskrit": "सुरालशुनसंस्पृष्टं पेयूषादिसमन्वितम् ।\nसंसर्गदुष्टमेतद्धि शुनोच्छिष्टं खगेश्वर ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002524025, "chapter_id": 22524, "verse_number": "१-१८६-२६", "content_sanskrit": "शूद्रसक्तं खंडसक्तं ज्ञेयमाश्रयदूषितम् ।\nविचिकित्सा तु हृदये भक्ष्ये यस्मिन्त्सुजायते ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002524026, "chapter_id": 22524, "verse_number": "१-१८६-२७", "content_sanskrit": "सहृल्लेखं तु तज्ज्ञेयं पुरीषं तु स्वभावतः ।\nरसदुष्टे विकारोऽपि रसस्येति प्रदर्शितः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002524027, "chapter_id": 22524, "verse_number": "१-१८६-२८", "content_sanskrit": "पायसं क्षीरपाकादि तस्मिन्नेव दिने तथा ।\nयथाशास्त्रं खगश्रेष्ठ भक्ष्याभक्ष्ये निरूपयेत् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002524028, "chapter_id": 22524, "verse_number": "१-१८६-२९", "content_sanskrit": "प्राणात्यये प्रोक्षितं च श्राद्धे च द्विजकाम्यया ।\nपितॄन्देवांश्चार्पयित्वा भुंजन्मांसं न दोषभाक् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002524029, "chapter_id": 22524, "verse_number": "१-१८६-३०", "content_sanskrit": "प्रेताशुद्धिः सपिंडानां तस्मिन्नेव मृते सति ।\nदशाहं द्वादशाहं वा पक्षं मासं त्वशुद्धता ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002524030, "chapter_id": 22524, "verse_number": "१-१८६-३१", "content_sanskrit": "दशाहादित्रिके भागे वर्णशो न भवंति हि ।\nदशाहेन तु भोज्याः स्युः सूतकाशौचयोस्तथा ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002524031, "chapter_id": 22524, "verse_number": "१-१८६-३२", "content_sanskrit": "ऊर्ध्वं दशाहादेकाहश्रवणे सति जायते ।\nसंवत्सरे व्यतीते तु स्नानादेव विशुध्यति ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002524032, "chapter_id": 22524, "verse_number": "१-१८६-३३", "content_sanskrit": "समानोदकता प्रोक्ता जन्मनाम्नोरपर्यये ।\nसपिंडाः सप्तपुरुषाः श्रुतावेतन्निदर्शनम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002524033, "chapter_id": 22524, "verse_number": "१-१८६-३४", "content_sanskrit": "आ दंतजन्मनः सद्य आचूडान्नैष्ठिकी स्मृता ।\nत्रिरात्रमाव्रतादेशात्सपिंडेषु मृतेषु च ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002524034, "chapter_id": 22524, "verse_number": "१-१८६-३५", "content_sanskrit": "तेषामपि तदेकं स्याद्वयोवस्थाप्यपेक्ष्यते ।\nसमानोदकात्त्रिरात्रेण शुध्येद्वै मृत्युजन्मनोः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002524035, "chapter_id": 22524, "verse_number": "१-१८६-३६", "content_sanskrit": "गर्भस्रावे त्रिरात्रेण उदक्या शुध्यते तथा ।\nअनंतजन्म मरणे तच्छेषेण विशुध्यति ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002524036, "chapter_id": 22524, "verse_number": "१-१८६-३७", "content_sanskrit": "द्विजानां त्वेवमेव स्यात्पित्रर्थं मातुरेव वा ।\nअग्निहोत्रार्थं विज्ञेयं सद्यः शौचमिति स्थितिः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002524037, "chapter_id": 22524, "verse_number": "१-१८६-३८", "content_sanskrit": "असपिंडे तु निर्हारात्त्रिरात्रमपि मानवः ।\nतस्यैवानुगतौ ज्ञेयं सद्यः शौचं खगाधिप ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002524038, "chapter_id": 22524, "verse_number": "१-१८६-३९", "content_sanskrit": "शुध्येद्द्विजो दशाहेन जन्महानौ द्वियोनिषु ।\nषङ्भिस्त्रिभिरहै केन क्षत्रविट्शूद्रयोनिषु ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002524039, "chapter_id": 22524, "verse_number": "१-१८६-४०", "content_sanskrit": "उक्तशौचं यथान्यायं शारीरं तत्त्वदर्शिभिः ।\nद्रव्यशुद्धिविधानं तु यथावदभिधीयते ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002524040, "chapter_id": 22524, "verse_number": "१-१८६-४१", "content_sanskrit": "तैजसी मार्तिकी वीर वारिशुद्धिः स्मृता तथा ।\nनिर्लेपक्षालनेनैव स्पर्शे तु प्रोक्षणेन वै ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002524041, "chapter_id": 22524, "verse_number": "१-१८६-४२", "content_sanskrit": "अशुद्धं नैव किंचिद्धि द्रव्यमस्तीति खेचर ।\nवचनाच्छुद्ध्यशुद्धी तु द्रव्याणामिह खेचर ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002524042, "chapter_id": 22524, "verse_number": "१-१८६-४३", "content_sanskrit": "स्नानं शौचं च कर्तव्यं द्रव्यशौचादनंतरम् ।\nप्रातःस्नानं तु नित्यं स्याद्ग्रहणे काम्यमेव च ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002524043, "chapter_id": 22524, "verse_number": "१-१८६-४४", "content_sanskrit": "नैमित्तिकं क्षुराशौचं तेन पापाद्विशुध्यति ।\nउक्तं तु शौचं विज्ञेयं दोषक्षयकरं खग ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002524044, "chapter_id": 22524, "verse_number": "१-१८६-४५", "content_sanskrit": "कर्मांगं चेति विज्ञेयं षट्प्रकारा समासतः ।\nएवमाचमनं विद्याद्विशिष्टं तु द्विजन्मनाम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002524045, "chapter_id": 22524, "verse_number": "१-१८६-४६", "content_sanskrit": "तदा मृतानां तद्वत्स्यादन्येषां तु यथासुखम् ।\nकन्यानिवृत्तिं पुत्रैस्तु यथान्यायं समाचरेत् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002524046, "chapter_id": 22524, "verse_number": "१-१८६-४७", "content_sanskrit": "कलाशिल्पानिसर्वाणि गृह्रीयात्परितुष्टये ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002524047, "chapter_id": 22524, "verse_number": "१-१८६-४८", "content_sanskrit": "शुश्रूषेत पतिं भार्या परितोषं यथा व्रजेत् ।\nगुरूणां परितोषश्च धर्मः स्त्रीणां सनातनः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002524048, "chapter_id": 22524, "verse_number": "१-१८६-४९", "content_sanskrit": "वृद्धाऽपुत्रा यदि मृता तदभावे नृपस्य तु ।\nमृतापत्याप्यगर्भा च वृद्धापत्या पतिव्रता ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002524049, "chapter_id": 22524, "verse_number": "१-१८६-५०", "content_sanskrit": "कुर्यादनिर्वृतं भर्तुर्गते सन्निहितेपि वा ।\nएतां धर्म समां निष्ठां भर्तृलोकमवाप्नुयात् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7002524050, "chapter_id": 22524, "verse_number": "१-१८६-५१", "content_sanskrit": "स्त्री धर्मचारिणी साध्वी मृता दाह्या तथाग्निभिः ।\nविपरीताददाह्या तु पुनर्दारक्रिया तथा ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7002524051, "chapter_id": 22524, "verse_number": "१-१८६-५२", "content_sanskrit": "स्त्रीणां नियोगो विहितो मरणाद्ब्रह्मचारकम् ।\nप्राप्तव्यश्च यथाधर्मो दृष्टादृष्टफलप्रदः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7002524052, "chapter_id": 22524, "verse_number": "१-१८६-५३", "content_sanskrit": "तस्माद्धर्मं सदा कुर्यात्कुर्वती स्वर्गमाप्नुयात् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]