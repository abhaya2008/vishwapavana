[{"id": 2101383, "chapter_id": 3185, "verse_number": "१४-४१-१", "content_sanskrit": "ब्रह्मोवाच।\nअव्यक्तात्पूर्वमुत्पन्नो महानात्मा महामतिः।\nआदिर्गुणानां सर्वेषां प्रथमः सर्ग उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2101384, "chapter_id": 3185, "verse_number": "१४-४१-२", "content_sanskrit": "महानात्मा मतिर्विष्णुर्जिष्णुः शंभुश्च वीर्यवान्।\nबुद्धिः प्रज्ञोपलब्धिश्च तता ख्यातिर्धृतिःस्मृतिः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2101385, "chapter_id": 3185, "verse_number": "१४-४१-३", "content_sanskrit": "पर्यायवाचकैः शब्दैर्महानात्मा विभाव्यते।\nतं जानन्ब्राह्मणो विद्वान्प्रमोहं नाधिगच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2101386, "chapter_id": 3185, "verse_number": "१४-४१-४", "content_sanskrit": "सर्वतःपाणिपादं च सर्वतोक्षिशिरोमुखम्।\nसर्वतःश्रुतिमल्लोके सर्वं व्याप्यवतिष्ठति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2101387, "chapter_id": 3185, "verse_number": "१४-४१-५", "content_sanskrit": "महाप्रभावः पुरुषः सर्वस्य हृदि निष्ठितः।\nअणिमा लघिमा प्राप्तिरीशानो ज्योतिरव्ययः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2101388, "chapter_id": 3185, "verse_number": "१४-४१-६", "content_sanskrit": "तत्र बुद्धिमतां लोके सद्भावनिरताश्च ये।\nध्यानिनो नित्ययोगाश्च सत्यसन्धा जितेन्द्रियाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2101389, "chapter_id": 3185, "verse_number": "१४-४१-७", "content_sanskrit": "ज्ञानवन्तश्च ये केचिदलुब्धा जितमन्यवः।\nप्रसन्नमनसो धीरा निर्ममा निरहंक्रियाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2101390, "chapter_id": 3185, "verse_number": "१४-४१-८", "content_sanskrit": "विमुक्ताः सर्व एवैते महत्त्वमुपयान्त्युत।\nआत्मनो महतो वेद यः पुण्यां गतिमुत्तमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2101391, "chapter_id": 3185, "verse_number": "१४-४१-९", "content_sanskrit": "अहङ्कारात्प्रसूतानि महाभूतानि पञ्च वै।\nपृथिवी वायुराकाशमापो ज्योतिश्च पञ्चमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2101392, "chapter_id": 3185, "verse_number": "१४-४१-१०", "content_sanskrit": "तेषु भूतानि युज्यन्ते महाभूतेषु पञ्चसु।\nते शब्दस्पर्शरूपेषु रसगन्धक्रियासु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2101393, "chapter_id": 3185, "verse_number": "१४-४१-११", "content_sanskrit": "महाभूतविनाशान्ते प्रलये प्रत्युपस्थिते।\nसर्वप्राणभृतां धीरा महदुत्पद्यते भयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2101394, "chapter_id": 3185, "verse_number": "१४-४१-१२", "content_sanskrit": "स धीरः सर्वलोकेषु न मोहमधिगच्छति।\nविष्णुरेवादिसर्गेषु स्वयंभूर्भवति प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2101395, "chapter_id": 3185, "verse_number": "१४-४१-१३", "content_sanskrit": "एवं हि यो वेद गुहाशयं प्रभुं\nपरं पुराणं पुरुषं विश्वरूपम्।\nहिरण्मयं बुद्धिमतां परां गतिं\nस बुद्धिमान्बुद्धिमतीत्य तिष्ठति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2101396, "chapter_id": 3185, "verse_number": "१४-४१-१४", "content_sanskrit": "य उत्पन्नो महान्पूर्वमहङ्कारः स उच्यते।\nअहमित्येव सम्भूतो द्वितीयः सर्ग उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2101397, "chapter_id": 3185, "verse_number": "१४-४१-१५", "content_sanskrit": "अहङ्कारश्च भूतादिर्वैकारिक इति स्मृतः।\nतेजसश्चेतना धातुः प्रजासर्गः प्रजापतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2101398, "chapter_id": 3185, "verse_number": "१४-४१-१६", "content_sanskrit": "देवानां प्रभवो देवो मनसश्च त्रिलोककृत्।\nअहमित्येव तत्सर्वमभिमानः स उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2101399, "chapter_id": 3185, "verse_number": "१४-४१-१७", "content_sanskrit": "अध्यात्मज्ञानतृप्तानां मुनीनां भावितात्मनाम्।\nस्वाध्यायक्रतुसिद्धानामेष लोकः सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2101400, "chapter_id": 3185, "verse_number": "१४-४१-१८", "content_sanskrit": "अहङ्कारेणाहरतो गुणानिमा-\nन्भूतादिरेवं सृजते स भूतकृत्।\nवैकारिकः सर्वमिदं विचेष्टते\nस्वतेजसा रञ्जयते जगत्तथा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2101401, "chapter_id": 3185, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि एकचत्वारिंशोऽध्यायः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]