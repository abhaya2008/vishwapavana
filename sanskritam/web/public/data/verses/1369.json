[{"id": 2017805, "chapter_id": 1369, "verse_number": "३-७-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2017806, "chapter_id": 1369, "verse_number": "३-७-१", "content_sanskrit": "श्रुत्वा च विदुरं प्राप्तं राज्ञा च परिसान्त्वितम्।\nधृताराष्ट्रात्मजो राजा पर्यतप्यत दुर्मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2017807, "chapter_id": 1369, "verse_number": "३-७-२", "content_sanskrit": "स सौबलेयमानाय्य कर्णदुःशासनौ तथा।\nअब्रवीद्वचनं राजा प्रविश्याबुद्धिजं तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2017808, "chapter_id": 1369, "verse_number": "३-७-३", "content_sanskrit": "एष प्रत्यागतो मन्त्री धृतराष्ट्रस्य संमतः।\nविदुरः पाण्डुपुत्राणां सुहृद्विद्वान्हिते रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2017809, "chapter_id": 1369, "verse_number": "३-७-४", "content_sanskrit": "यावदस्य पुनर्बुद्धिं विदुरो नापकर्षति।\nपाण्डवानयने तावन्मन्त्रयध्वं हितं मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2017810, "chapter_id": 1369, "verse_number": "३-७-५", "content_sanskrit": "अथ पश्याम्यहं पार्थान्प्राप्तानिह कथंचन।\nपुनः शोषं गमिष्यामि निरसुर्निष्परिग्रहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2017811, "chapter_id": 1369, "verse_number": "३-७-६", "content_sanskrit": "विषमुद्बन्धनं चैव शस्त्रमग्निप्रवेशनम्।\nकरिष्ये न हि तानृद्धान्पुनर्द्रष्टुमिहोत्सहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2017812, "chapter_id": 1369, "verse_number": "३-७-७x", "content_sanskrit": "सुकुनिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2017813, "chapter_id": 1369, "verse_number": "३-७-७", "content_sanskrit": "किं बालिशमतिं राजन्नास्थितोसि विशांपते।\nगतास्ते समयं कृत्वा नैतदेवं भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2017814, "chapter_id": 1369, "verse_number": "३-७-८", "content_sanskrit": "सत्यवाक्येः स्विताः सर्वे पाण्डवा भरतषभ।\nपितुस्ते वचनं तात न ग्रहीष्यन्ति कर्हिचिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2017815, "chapter_id": 1369, "verse_number": "३-७-९", "content_sanskrit": "अथवा ते ग्रहीष्यन्ति पुनरेष्यन्ति वा पुरम्।\nनिरस्य समयं सर्वे पणोऽस्माकं भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2017816, "chapter_id": 1369, "verse_number": "३-७-१०", "content_sanskrit": "सर्वे भवामो मध्यस्था राज्ञश्छन्दानुवर्तिनः।\nछिद्रं बहु प्रपश्यन्तः पाण्डवानां सुसंवृताः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2017817, "chapter_id": 1369, "verse_number": "३-७-११x", "content_sanskrit": "दुःशासन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2017818, "chapter_id": 1369, "verse_number": "३-७-११", "content_sanskrit": "एवमेतन्महाप्राज्ञ यथा वदसि मातुल।\nनित्यं हि मे कथयतस्तव बुद्धिर्विरोचते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2017819, "chapter_id": 1369, "verse_number": "३-७-१२x", "content_sanskrit": "कर्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2017820, "chapter_id": 1369, "verse_number": "३-७-१२", "content_sanskrit": "काममीक्षामहे सर्वे दुर्योधन तवेप्सितम्।\nऐकमत्यं हि नो राजन्सर्वेषामेव लक्षये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2017821, "chapter_id": 1369, "verse_number": "३-७-१३", "content_sanskrit": "[नागमिष्यन्ति ते धीरा अकृत्वा कालसंविदम्।\nआगमिष्यन्ति चेन्मोहात्पुनर्द्यूतेन ताञ्जय ॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2017822, "chapter_id": 1369, "verse_number": "३-७-१४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2017823, "chapter_id": 1369, "verse_number": "३-७-१४", "content_sanskrit": "एवमुक्तस्तु कर्णेन राजा दुर्योधनस्तदा।\nनातिहृष्टमनाः क्षिप्रमभवत्स पराङ्मुखः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2017824, "chapter_id": 1369, "verse_number": "३-७-१५", "content_sanskrit": "उपलभ्य ततः कर्णो विवृत्य नयने शुभे।\nरोषाद्दुःशासनं चैव सौबलं च तमेव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2017825, "chapter_id": 1369, "verse_number": "३-७-१६", "content_sanskrit": "उवाच परमक्रुद्ध उद्यम्यात्मानमात्मना।\nअथो मम मतं यत्तु तन्निबोधत भूमिपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2017826, "chapter_id": 1369, "verse_number": "३-७-१७", "content_sanskrit": "प्रियं सर्वे करिष्यामो राज्ञः किं करवामहे।\nन चास्य शक्नुमः स्थातुं प्रिये सर्वे ह्यतन्द्रिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2017827, "chapter_id": 1369, "verse_number": "३-७-१८", "content_sanskrit": "वयं तु शस्त्राण्यादाय रथानास्थाय दंशिताः।\nगच्छामः सहिता हन्तुं पाण्डवान्वनगोचरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2017828, "chapter_id": 1369, "verse_number": "३-७-१९", "content_sanskrit": "तेषु सर्वेषु शान्तेषु गतेष्वविदितां गतिम्।\nनिर्विवादा भविष्यन्ति धार्तराष्ट्रास्तथा वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2017829, "chapter_id": 1369, "verse_number": "३-७-२०", "content_sanskrit": "यावदेव परिद्यूना यावच्छोकपरायणाः।\nयावन्मित्रविहीनाश्च तावद्गच्छाम माचिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2017830, "chapter_id": 1369, "verse_number": "३-७-२१", "content_sanskrit": "तस्यतद्वचनं श्रुत्वा पूजयन्तः पुनः पुनः।\nप्रहृष्टमनसः सर्वे प्रत्यूचुः सूतजं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2017831, "chapter_id": 1369, "verse_number": "३-७-२२", "content_sanskrit": "एवमुक्त्वा सुसंरब्धा रथैः सर्वे पृथक्पृथक्।\nनिर्ययुः पाण्डवान्हन्तुं सहिताः कृतनिश्चयाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2017832, "chapter_id": 1369, "verse_number": "३-७-२३", "content_sanskrit": "तान्प्रस्थितान्परिज्ञाय कृष्णद्वैपायनः प्रभुः।\nआजगाम विशुद्धात्मा दृष्ट्वा दिव्येन चक्षुषा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2017833, "chapter_id": 1369, "verse_number": "३-७-२४", "content_sanskrit": "प्रतिषिध्याथ तान्सर्वान्भगवाँल्लोकपूजितः।\nप्रज्ञाचक्षुषमासीनमुवाचाभ्येत्य सत्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2017834, "chapter_id": 1369, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि किर्मीरवधपर्वणि सप्तमोऽध्यायः ॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]