[{"id": 2073353, "chapter_id": 2550, "verse_number": "१२-५५-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2073354, "chapter_id": 2550, "verse_number": "१२-५५-१", "content_sanskrit": "प्रणिपत्य हृषीकेशमभिवाद्य पितामहम्।\nअनुमान्य गुरून्सर्वान्पर्यपृच्छद्युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2073355, "chapter_id": 2550, "verse_number": "१२-५५-२", "content_sanskrit": "राज्ञां वै परमो धर्म इति धर्मविदो विदुः।\nमहान्तमेतं भारं च मन्ये तद्ब्रूहि पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2073356, "chapter_id": 2550, "verse_number": "१२-५५-३", "content_sanskrit": "राजधर्मान्विशेषेण कथयस्य पितामह।\nसर्वस्य जीवलोकस्य राजधर्मः परायणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2073357, "chapter_id": 2550, "verse_number": "१२-५५-४", "content_sanskrit": "त्रिवर्गो हि समासक्तो राजधर्मेषु कौरव।\nमोक्षधर्मश्च विस्पष्टः सकलोऽत्र समाहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2073358, "chapter_id": 2550, "verse_number": "१२-५५-५", "content_sanskrit": "यथा हि रश्मयोऽश्वस्य द्विरदस्याङ्कुशो यथा।\nनरेन्द्रधर्मो लोकस्य तथा प्रग्रहणं स्मृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2073359, "chapter_id": 2550, "verse_number": "१२-५५-६", "content_sanskrit": "अत्र वै संप्रमूढे तु धर्मे राजर्षिसेविते।\nलोकस्य संस्था न भवेत्सर्वं च व्याकुलीभवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2073360, "chapter_id": 2550, "verse_number": "१२-५५-७", "content_sanskrit": "उदयन्हि यथा सूर्यो नाशयत्यशुभं तमः।\nराजधर्मस्तथा लोक्यामाक्षिपत्यशुभां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2073361, "chapter_id": 2550, "verse_number": "१२-५५-८", "content_sanskrit": "तदग्रे राजधर्मान्हि मदर्थे त्वं पितामह।\nप्रब्रूहि भरतश्रेष्ठ त्वं हि धर्मभूतां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2073362, "chapter_id": 2550, "verse_number": "१२-५५-९", "content_sanskrit": "आगमश्च परस्त्वत्तः सर्वेषां नः परन्तप।\nभवन्तं हि परं बुद्धौ वासुदेवोऽभिमन्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2073363, "chapter_id": 2550, "verse_number": "१२-५५-१०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2073364, "chapter_id": 2550, "verse_number": "१२-५५-१०", "content_sanskrit": "नमो धर्माय महते नमः कृष्णाय वेधसे।\nब्राह्मणेभ्यो नमस्कृत्य धर्मान्वक्ष्यामि शाश्वतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2073365, "chapter_id": 2550, "verse_number": "१२-५५-११", "content_sanskrit": "शृणु कार्त्स्न्येन मत्तस्त्वं राजधर्मान्युधिष्ठिर।\nनिरुच्यमानान्नियतो यच्चान्यदपि वाञ्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2073366, "chapter_id": 2550, "verse_number": "१२-५५-१२", "content_sanskrit": "आदावेव कुरुश्रेष्ठ राज्ञा रञ्जनमिच्छता।\nदेवतानां द्विजानां च वर्तितव्यं यथाविधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2073367, "chapter_id": 2550, "verse_number": "१२-५५-१३", "content_sanskrit": "दैवतान्यर्चयित्वा हि ब्राह्मणांश्च कुरूद्वह।\nआनृण्यं याति धर्मस्य लोकेन च समर्च्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2073368, "chapter_id": 2550, "verse_number": "१२-५५-१४", "content_sanskrit": "उत्थानेन सदा पुत्र प्रयतेथा युधिष्ठिर।\nन ह्युत्थानमृते दैवं राज्ञामर्थं प्रसाधयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2073369, "chapter_id": 2550, "verse_number": "१२-५५-१५", "content_sanskrit": "साधारणं द्वयं ह्येतद्दैवमुत्थानमेव च।\nपौरुषं हि परं मन्ये दैवं निश्चित्य मुह्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2073370, "chapter_id": 2550, "verse_number": "१२-५५-१६", "content_sanskrit": "विपन्ने च समारम्भे सन्तापं मा स्म वै कृथाः।\nघटेतैवं सदाऽऽत्मानं राज्ञामेष परो नयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2073371, "chapter_id": 2550, "verse_number": "१२-५५-१७", "content_sanskrit": "न हि सत्यादृते किंचिद्राज्ञां वै सिद्धिकारकम्।\nसत्ये हि राजा निरतः प्रेत्य चेह च नन्दति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2073372, "chapter_id": 2550, "verse_number": "१२-५५-१८", "content_sanskrit": "ऋषीणामपि राजेन्द्र सत्यमेव परं धनम्।\nतथा राज्ञां परं सत्यान्नान्यद्विश्वासकारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2073373, "chapter_id": 2550, "verse_number": "१२-५५-१९", "content_sanskrit": "गुणवाञ्शीलवान्दान्तो मृदुदण्डो जितेन्द्रियः।\nसुदर्शः स्थूललक्ष्यश्च न भ्रश्येत सदा श्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2073374, "chapter_id": 2550, "verse_number": "१२-५५-२०", "content_sanskrit": "आर्जवं सर्वकार्येषु श्रयेथाः कुरुनन्दन।\nपुनर्नयविचारेण त्रयीसंवरणेन च।\n`आर्जवेन समायुक्ता मोदन्ते ऋषयो दिवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2073375, "chapter_id": 2550, "verse_number": "१२-५५-२१", "content_sanskrit": "मृदुर्हि राजा सततं लङ्घ्यो भवति सर्वशः।\nतीक्ष्णाच्चोद्विजते लोकस्तस्मादुभयमाचरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2073376, "chapter_id": 2550, "verse_number": "१२-५५-२२", "content_sanskrit": "अदण्ड्याश्चैव ते पुत्र विप्राः स्युर्ददतां वर।\nभूतमेतत्परं लोके ब्राह्मणा नाम पाण्डव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2073377, "chapter_id": 2550, "verse_number": "१२-५५-२३", "content_sanskrit": "मनुना चात्र राजेन्द्र गीतौ श्लोकौ महात्मना।\nधर्मेषु स्वेषु कौरव्य हृदि तौ कर्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2073378, "chapter_id": 2550, "verse_number": "१२-५५-२४", "content_sanskrit": "अभ्द्योऽग्निर्ब्रह्मतः क्षत्रमश्मनो लोहमुत्थितम्।\nतेषां सर्वत्रगं तेजः स्वासु योनिषु शाम्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2073379, "chapter_id": 2550, "verse_number": "१२-५५-२५", "content_sanskrit": "अयो हन्ति यदाऽश्मानमग्निरापो निहन्ति च।\nब्रह्म च क्षत्रियो द्वेष्टि तदा सीदन्ति ते त्रयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2073380, "chapter_id": 2550, "verse_number": "१२-५५-२६", "content_sanskrit": "एवं कृत्वा महाराज नमस्या एव ते द्विजाः।\nभौमं ब्रह्म द्विजश्रेष्ठा धारयन्ति शमान्विताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2073381, "chapter_id": 2550, "verse_number": "१२-५५-२७", "content_sanskrit": "एवं चैव नरव्याघ्र लोकयात्राविघातकाः।\nनिग्राह्या एव बाहुभ्यां ब्राह्मणास्ते नरेश्वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2073382, "chapter_id": 2550, "verse_number": "१२-५५-२८", "content_sanskrit": "श्लोकौ चोशनसा गीतौ पुरा तात महर्षिणा।\nतौ निवोध महाराज त्वमेकाग्रमना नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2073383, "chapter_id": 2550, "verse_number": "१२-५५-२९", "content_sanskrit": "उद्यम्य शस्त्रमायान्तमपि वेदान्तगं रणे।\nनिगृह्णीयात्स्वधर्मेण धर्मापेक्षी नराधिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2073384, "chapter_id": 2550, "verse_number": "१२-५५-३०", "content_sanskrit": "विनश्यमानं धर्मं हि योऽभिरक्षेत्स धर्मवित्।\nन तेन धर्महा स स्यान्मन्युस्तन्मन्युमृच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2073385, "chapter_id": 2550, "verse_number": "१२-५५-३१", "content_sanskrit": "एवं चैव नरश्रेष्ठ रक्ष्या एव द्विजातयः।\nसापराधानपि हि तान्विषयान्ते समुत्सृजेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2073386, "chapter_id": 2550, "verse_number": "१२-५५-३२", "content_sanskrit": "अभिशस्तमपि ह्येषां पीडयेन्न विशांपते।\nब्रह्मघ्ने गुरुतल्पे च भ्रूणहत्ये तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2073387, "chapter_id": 2550, "verse_number": "१२-५५-३३", "content_sanskrit": "राजद्विष्टे च विप्रस्य विषयान्ते विवासनम्।\nविधीयते न शारीरं भयमेषां कदाचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2073388, "chapter_id": 2550, "verse_number": "१२-५५-३४", "content_sanskrit": "दयिताश्च नरास्ते स्युर्भक्तिमन्तो द्विजेषु ये।\nन शोकः परमा तुष्टी राज्ञां भवति संचयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2073389, "chapter_id": 2550, "verse_number": "१२-५५-३५", "content_sanskrit": "दुर्गेषु च महाराज षट्सु ये शास्त्रनिश्चिताः।\nसर्वदुर्गेषु मन्यन्ते नरदुर्गं सुदुर्गमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2073390, "chapter_id": 2550, "verse_number": "१२-५५-३६", "content_sanskrit": "तस्मान्नित्यं दया कार्या चातुर्वर्ण्ये विपश्चिता।\nधर्मात्मा सत्यवाक्चैव राजा रञ्जयति प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2073391, "chapter_id": 2550, "verse_number": "१२-५५-३७", "content_sanskrit": "न च क्षान्तेन ते नित्यं भाव्यं पुरुषसत्तम।\nअधर्मो हि मृद् राजा क्षमावानिव कुञ्जरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2073392, "chapter_id": 2550, "verse_number": "१२-५५-३८", "content_sanskrit": "वार्हस्पत्ये च शास्त्रे च श्लोकोऽयं नियतः प्रभो।\nअस्मिन्नर्थे निगदितस्तन्मे निगदतः शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2073393, "chapter_id": 2550, "verse_number": "१२-५५-३९", "content_sanskrit": "क्षममाणं नृपं नित्यं नीचः परिभवेञ्जनः।\nहस्तियन्ता गजस्येव शिर एवारुरुक्षति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2073394, "chapter_id": 2550, "verse_number": "१२-५५-४०", "content_sanskrit": "तस्मान्नैव मृदुर्नित्यं तीक्ष्णो वाऽपि भवेन्नृपः।\nवसन्तेऽर्क इव श्रीमान्न शीतो न च घर्मदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2073395, "chapter_id": 2550, "verse_number": "१२-५५-४१", "content_sanskrit": "प्रत्यक्षेणानुमानेन तथौपम्यागमैरपि।\nपरीक्ष्यास्ते महाराज स्वे परे चैव नित्यशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2073396, "chapter_id": 2550, "verse_number": "१२-५५-४२", "content_sanskrit": "व्यसनानि च सर्वाणि त्यजेथा भूरिदक्षिण।\nनचैतानि प्रयुञ्जीथाः सङ्गं तु परिवर्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2073397, "chapter_id": 2550, "verse_number": "१२-५५-४३", "content_sanskrit": "व्यसनी यस्तु लोकेऽस्मिन्परिभूतो भवत्युत।\nउद्वेजयति लोकं च योऽतिद्वेषी महीपतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2073398, "chapter_id": 2550, "verse_number": "१२-५५-४४", "content_sanskrit": "भवितव्यं सदा राज्ञा गर्भिणीसहधर्मिणा।\nकारणं च महाराज शृणु येनेदमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2073399, "chapter_id": 2550, "verse_number": "१२-५५-४५", "content_sanskrit": "यथा हि गर्भिणी हित्वा स्वं प्रियं मनसोऽनुगम्।\nगर्भस्य हितमाधत्ते तथा राज्ञाऽप्यसंशयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2073400, "chapter_id": 2550, "verse_number": "१२-५५-४६", "content_sanskrit": "वर्तितव्यं कुरुश्रेष्ठ सदा धर्मानुवर्तिना।\nस्वं प्रियं तु परित्यज्य यद्यल्लोकहितं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2073401, "chapter_id": 2550, "verse_number": "१२-५५-४७", "content_sanskrit": "न सन्त्याज्यं च ते धैर्यं कदाचिदपि पाण्डव।\nधीरस्य स्पष्टदण्डस्य न ह्याज्ञा प्रतिहन्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2073402, "chapter_id": 2550, "verse_number": "१२-५५-४८", "content_sanskrit": "परिहासश्च भृत्यैस्ते नात्यर्थं वदतां वर।\nकर्तव्यो राजशार्दूल दोषमत्र हि मे शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2073403, "chapter_id": 2550, "verse_number": "१२-५५-४९", "content_sanskrit": "अवमन्यन्ति भर्तारं सहर्षमुपजीविनः।\nस्वे स्थाने न च तिष्ठन्ति लङ्घ्यन्ति च तद्वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2073404, "chapter_id": 2550, "verse_number": "१२-५५-५०", "content_sanskrit": "प्रेष्यमाणा विकल्पन्ते गुह्यं चाप्यनुयुञ्जते।\nअयाच्यं चैव याचन्ते भोज्यान्याहारयन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2073405, "chapter_id": 2550, "verse_number": "१२-५५-५१", "content_sanskrit": "क्रुथ्यन्ति परिदीप्तन्ति भूमिपायाधितिष्ठते।\nउत्कोचैर्वञ्चनाभिश्च कार्याणि घ्नन्ति चास्य ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2073406, "chapter_id": 2550, "verse_number": "१२-५५-५२", "content_sanskrit": "जर्झरं चास्य विषयं कुर्वन्ति प्रतिरूपकैः।\nस्त्रीरक्षिभिश्च सज्जन्ते तुल्यवेषा भवन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2073407, "chapter_id": 2550, "verse_number": "१२-५५-५३", "content_sanskrit": "वान्तं निष्ठीवनं चैव कुर्वते चास्य सन्निधौ।\nनिर्लज्जा राजशार्दूल व्याहरन्ति च तद्वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2073408, "chapter_id": 2550, "verse_number": "१२-५५-५४", "content_sanskrit": "हयं वा दन्तिनं वाऽपि रथं वा नृपसंमतम्।\nअधिरोहन्त्यवज्ञाय सहर्षाः पार्थिवे मृदौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2073409, "chapter_id": 2550, "verse_number": "१२-५५-५५", "content_sanskrit": "इदं ते दुष्करं राजन्निदं ते दुर्विचेष्टितम्।\nइत्येवं सुहृदो नाम ब्रुवते परिपद्गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2073410, "chapter_id": 2550, "verse_number": "१२-५५-५६", "content_sanskrit": "क्रुद्धे चास्मिन्हसन्त्येव न च हृष्यन्ति पूजिताः।\nसङ्घर्षशीलाश्च तदा भवन्त्यन्योन्यकारणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2073411, "chapter_id": 2550, "verse_number": "१२-५५-५७", "content_sanskrit": "विस्रंसयन्ति मन्त्रं च विवृण्वन्ति च दुष्कृतम्।\nलीलया चैव कुर्वन्ति सावज्ञास्तस्य शासनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2073412, "chapter_id": 2550, "verse_number": "१२-५५-५८", "content_sanskrit": "अलङ्काराणि भोज्यं च तथा स्नानानुलेपने।\nहेलयाना नरव्याघ्र स्वस्थास्तस्योपभुञ्जये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2073413, "chapter_id": 2550, "verse_number": "१२-५५-५९", "content_sanskrit": "निन्दन्ते स्वानधीकारान्सन्त्यजन्ते च भारत।\nन वृत्त्या परितृष्यन्ति राजदेयं हरन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2073414, "chapter_id": 2550, "verse_number": "१२-५५-६०", "content_sanskrit": "क्रीडितुं तेन चेच्छन्ति ससूत्रेणेव पक्षिणा।\nअस्मत्प्रणेयो राजेति लोकांश्चैव वदन्त्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2073415, "chapter_id": 2550, "verse_number": "१२-५५-६१", "content_sanskrit": "एते चैवापरे चैव दोषाः प्रादुर्भवन्त्युत।\nनृपतौ मार्दवोपेते हर्षुले च युधिष्ठिर॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2073416, "chapter_id": 2550, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि पञ्चपञ्चाशोऽध्यायः॥ ५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}]