[{"id": 6000229000, "chapter_id": 10229, "verse_number": null, "content_sanskrit": "अथ त्रयस्‍त्रिंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000229001, "chapter_id": 10229, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_033/BhP_10.033.001.m4a", "display_order": 2}, {"id": 6000229002, "chapter_id": 10229, "verse_number": "१०-३३-१", "content_sanskrit": "गोप्यः कृष्णे वनं याते तमनुद्रुतचेतसः।\nकृष्णलीलां प्रगायन्त्यो निन्युर्दुःखेन वासरान्॥ १०/३३/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_033/BhP_10.033.002.m4a", "display_order": 3, "topics": [{"text": "वेणुगीता", "range": "१–२६"}]}, {"id": 6000229003, "chapter_id": 10229, "verse_number": null, "content_sanskrit": "गोप्य ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_033/BhP_10.033.003.m4a", "display_order": 4}, {"id": 6000229004, "chapter_id": 10229, "verse_number": "१०-३३-२", "content_sanskrit": "वामबाहुकृतवामकपोलो वल्गितभ्रुरधरार्पितवेणुम्।\nकोमलाङ्गुलिभिराश्रितमार्गं गोप्य ईरयति यत्र मुकुन्दः॥ १०/३३/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_033/BhP_10.033.004.m4a", "display_order": 5}, {"id": 6000229005, "chapter_id": 10229, "verse_number": "१०-३३-३", "content_sanskrit": "व्योमयानवनिताः सह सिद्धैर्विस्मितास्तदुपधार्य सलज्जाः।\nकाममार्गणसमर्पितचित्ताः कश्मलं ययुरपस्मृतनीव्यः॥ १०/३३/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_033/BhP_10.033.005.m4a", "display_order": 6}, {"id": 6000229006, "chapter_id": 10229, "verse_number": "१०-३३-४", "content_sanskrit": "हन्त चित्रमबलाः शृणुतेदं हारभास उरसि स्थितविद्युत्।\nनन्दसूनुरयमार्तजनानां शर्मदो यर्हि कूजितवेणुः॥ १०/३३/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_033/BhP_10.033.006.m4a", "display_order": 7}, {"id": 6000229007, "chapter_id": 10229, "verse_number": "१०-३३-५", "content_sanskrit": "वृन्दशो व्रजवृषो मृगगावो वेणुवाद्यहृतचेतस एत्य।\nदन्तदष्टकवला धृतकर्णा निद्रिता लिखितचित्रमिवासन्॥ १०/३३/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_033/BhP_10.033.007.m4a", "display_order": 8}, {"id": 6000229008, "chapter_id": 10229, "verse_number": "१०-३३-६", "content_sanskrit": "बर्हिणस्तबकधातुपलाशैर्बद्धमल्लपरिबर्हविडम्बः।\nकर्हिचित् सबल आलि स गोपैर्गाः समाह्वयति यत्र मुकुन्दः॥ १०/३३/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_033/BhP_10.033.008.m4a", "display_order": 9}, {"id": 6000229009, "chapter_id": 10229, "verse_number": "१०-३३-७", "content_sanskrit": "तर्हि भुग्नगतयः सरितो वै तत्पदाम्बुजरजोऽनिलनीतम्।\nआमृशन्पयसि वा बहुपुण्याः प्रेमवेपितभुजा हतवेगाः॥ १०/३३/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_033/BhP_10.033.009.m4a", "display_order": 10}, {"id": 6000229010, "chapter_id": 10229, "verse_number": "१०-३३-८", "content_sanskrit": "अनुचरैः समनुवर्णितवीर्य आदिपूरुष इवाचलभूतिः।\nवनचरो गिरितटेषु चरन्तीर्वेणुनाऽऽह्वयति गाः स यदा हि॥ १०/३३/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_033/BhP_10.033.010.m4a", "display_order": 11}, {"id": 6000229011, "chapter_id": 10229, "verse_number": "१०-३३-९", "content_sanskrit": "वनलतास्तरव आत्मनि विष्णुं व्यञ्जयन्त इव पुष्पफलाढ्याः।\nप्रणतभारविटपा मधुधाराः प्रेमहृष्टतनवः ससृजुः स्म॥ १०/३३/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_033/BhP_10.033.011.m4a", "display_order": 12}, {"id": 6000229012, "chapter_id": 10229, "verse_number": "१०-३३-१०", "content_sanskrit": "दर्शनीय विकचोत्पलमालादिव्यगन्धतुलसीमधुमत्तैः।\nअलिकुलैरलघुगीतमभीष्टमाद्रियद् यर्हि सन्धितवेणुः॥ १०/३३/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_033/BhP_10.033.012.m4a", "display_order": 13}, {"id": 6000229013, "chapter_id": 10229, "verse_number": "१०-३३-११", "content_sanskrit": "सरसि सारसहंसविहङ्गाश्चारुगीतहृतचेतस एत्य।\nहरिमुपासत ते यतचित्ता हन्त मीलितदृशो धृतमौनाः॥ १०/३३/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_033/BhP_10.033.013.m4a", "display_order": 14}, {"id": 6000229014, "chapter_id": 10229, "verse_number": "१०-३३-१२", "content_sanskrit": "सहबलः स्रगवतंसविलासः सानुषु क्षितिभृतो व्रजदेव्यः।\nआह्वयद् यर्हि वेणुरवेण जातहर्ष उपरम्भति विश्वम्॥ १०/३३/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_033/BhP_10.033.014.m4a", "display_order": 15}, {"id": 6000229015, "chapter_id": 10229, "verse_number": "१०-३३-१३", "content_sanskrit": "महदतिक्रमणशङ्कितचेता मन्दमन्दमनुगर्जति मेघः।\nसुहृदमभ्यवर्षत् सुमनोभिश्छायया च विदधे वितपत्रम्॥ १०/३३/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_033/BhP_10.033.015.m4a", "display_order": 16}, {"id": 6000229016, "chapter_id": 10229, "verse_number": "१०-३३-१४", "content_sanskrit": "विविधगोपचरणेषु विदग्धो वेणुवाद्यमधुरां निजशिक्षाम्।\nतव सुतः सति यदाऽधरबिम्बे दत्तवेणुरनयत् स्वरजातीः॥ १०/३३/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_033/BhP_10.033.016.m4a", "display_order": 17}, {"id": 6000229017, "chapter_id": 10229, "verse_number": "१०-३३-१५", "content_sanskrit": "सुमनसस्तदुपधार्य सुरेशाः शक्रशर्वपरमेष्ठिपुरोगाः।\nकवय आनतकन्धरगात्राः विस्मयं ययुरनिश्चिततत्त्वाः॥ १०/३३/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_033/BhP_10.033.017.m4a", "display_order": 18}, {"id": 6000229018, "chapter_id": 10229, "verse_number": "१०-३३-१६", "content_sanskrit": "निजपदाब्जदलैर्ध्वजवज्रनीरजाङ्कुशविचित्रललामैः।\nव्रजभुवः प्रशमयन् खुरतोदं वर्ष्म धुर्यगतिरीरितवेणुः॥ १०/३३/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_033/BhP_10.033.018.m4a", "display_order": 19}, {"id": 6000229019, "chapter_id": 10229, "verse_number": "१०-३३-१७", "content_sanskrit": "व्रजमितेन वयं सविलासवीक्षणार्पितमनोभववेगाः।\nव्रजगतिं गमिता न विदामः कश्मलेन कबरं वसनं वा॥ १०/३३/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_033/BhP_10.033.019.m4a", "display_order": 20}, {"id": 6000229020, "chapter_id": 10229, "verse_number": "१०-३३-१८", "content_sanskrit": "मणिधरः क्‍वचिदागमयन् गा मालया दयितगन्धतुलस्या।\nप्रणयिनोऽनुचरस्य कदांऽसे प्रक्षिपन् भुजमगायत यत्र॥ १०/३३/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_033/BhP_10.033.020.m4a", "display_order": 21}, {"id": 6000229021, "chapter_id": 10229, "verse_number": "१०-३३-१९", "content_sanskrit": "क्‍वणितवेणुमुप वञ्चितचित्ताः कृष्णमीयुरनु कृष्णगृहिण्यः।\nगुणगणार्णमनुगम्य हरिण्यो गोपिका इव विमुक्तगृहेशाः॥ १०/३३/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_033/BhP_10.033.021.m4a", "display_order": 22}, {"id": 6000229022, "chapter_id": 10229, "verse_number": "१०-३३-२०", "content_sanskrit": "कुन्ददामकृतकौतुकवेषो गोपगोधनवृतो यमुनायाम्।\nनन्दसूनुरनघे तव वत्सो नर्मदः प्रणयिनां विजहार॥ १०/३३/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_033/BhP_10.033.022.m4a", "display_order": 23}, {"id": 6000229023, "chapter_id": 10229, "verse_number": "१०-३३-२१", "content_sanskrit": "मन्दवायुरुपवात्यनुकूलं मानयन् मलयजस्पर्शेन।\nबन्दिनस्तमुपदेवगणा ये वाद्यगीतबलिभिः परिवव्रुः॥ १०/३३/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_033/BhP_10.033.023.m4a", "display_order": 24}, {"id": 6000229024, "chapter_id": 10229, "verse_number": "१०-३३-२२", "content_sanskrit": "वत्सलो व्रजगवां यदगाधो वन्द्यमानचरणः पथि वृद्धैः।\nकृत्स्नगोधनमपोह्य दिनान्ते गीतवेणुरनुगोद्धृतकीर्तिः॥ १०/३३/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_033/BhP_10.033.024.m4a", "display_order": 25}, {"id": 6000229025, "chapter_id": 10229, "verse_number": "१०-३३-२३", "content_sanskrit": "उत्सवं श्रममपोह्य दृशीनामुद्वहन् खुररजश्छुरितस्रक्।\nदित्सयैति सुहृदाशिष एष देवकीजठरभूरुडुराजः॥ १०/३३/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_033/BhP_10.033.025.m4a", "display_order": 26}, {"id": 6000229026, "chapter_id": 10229, "verse_number": "१०-३३-२४", "content_sanskrit": "मदविघूर्णितलोचन ईषन्मानदः स्वसुहृदां वनमाली।\nबदरपाण्डुवदनो मृदुगण्डं मण्डयन् कनककुण्डललक्ष्म्या॥ १०/३३/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_033/BhP_10.033.026.m4a", "display_order": 27}, {"id": 6000229027, "chapter_id": 10229, "verse_number": "१०-३३-२५", "content_sanskrit": "यदुपतिर्द्विरदराजविहारो यामिनीपतिरिवैष दिनान्ते।\nमुदितवक्त्र उपयाति दुरन्तं मोचयन् व्रजगवां दिनतापम्॥ १०/३३/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_033/BhP_10.033.027.m4a", "display_order": 28}, {"id": 6000229028, "chapter_id": 10229, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_033/BhP_10.033.028.m4a", "display_order": 29}, {"id": 6000229029, "chapter_id": 10229, "verse_number": "१०-३३-२६", "content_sanskrit": "एवं व्रजस्‍त्रियो राजन् कृष्णलीला नु गायतीः।\nरेमिरेऽहस्सु तच्चित्तास्तन्मनस्का महोदयाः॥ १०/३३/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_033/BhP_10.033.029.m4a", "display_order": 30}, {"id": 6000229030, "chapter_id": 10229, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्धपूर्वार्धे त्रयस्‍त्रिंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]