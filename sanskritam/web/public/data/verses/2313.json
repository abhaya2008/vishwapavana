[{"id": 2061393, "chapter_id": 2313, "verse_number": "८-३४-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2061394, "chapter_id": 2313, "verse_number": "८-३४-१", "content_sanskrit": "अधिक्षिप्तस्तु राधेयः शल्येनामिततेजसा।\nशल्यमाह सुसङ्क्रुद्धो वाक्शल्यमवधारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2061395, "chapter_id": 2313, "verse_number": "८-३४-२x", "content_sanskrit": "कर्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2061396, "chapter_id": 2313, "verse_number": "८-३४-२", "content_sanskrit": "गुणान्गुणवतां शल्य गुणवान्वेत्ति नागुणः।\nत्वं तु नित्यं गुणैर्हीनः किं ज्ञास्यसि गुणागुणान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2061397, "chapter_id": 2313, "verse_number": "८-३४-३", "content_sanskrit": "अर्जुनस्य महास्त्राणि क्रोधं वीर्यं धनुः शरान्।\nअहं शल्याभिजानामि न त्वं जानासि तत्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2061398, "chapter_id": 2313, "verse_number": "८-३४-४", "content_sanskrit": "तथा कृष्णस्य माहात्म्यमृषभस्य महीक्षिताम्।\nयथाहं शल्य जानामि न त्वं जानासि तत्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2061399, "chapter_id": 2313, "verse_number": "८-३४-५", "content_sanskrit": "एवमेवात्मनो वीर्यमहं वीर्यं च पाण्डवे।\nजानंस्तावाह्वये युद्धे शल्य नाग्निं पतङ्गवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2061400, "chapter_id": 2313, "verse_number": "८-३४-६", "content_sanskrit": "अस्ति चाऽयमिषुः शल्य सुपुङ्खो रक्तभोजनः।\nएकस्तूणीशयः पत्री सुधौतः समलङ्कृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2061401, "chapter_id": 2313, "verse_number": "८-३४-७", "content_sanskrit": "शेते चन्दनचूर्णेन पूजितो बहुलाः समाः।\nआहेयो विषवानुग्रो नराश्वद्विपसङ्घहा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2061402, "chapter_id": 2313, "verse_number": "८-३४-८", "content_sanskrit": "घोररूपो महारौद्रस्तनुत्रास्थिविदारणः।\nनिर्भिन्द्यां येन रुष्टोऽहमपि मेरुं महागिरिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2061403, "chapter_id": 2313, "verse_number": "८-३४-९", "content_sanskrit": "तमहं जातु नास्येयमन्यस्मिन्फल्गुनादृते।\nकृष्णाद्वा देवकीपुत्रात्सत्यं चापि शृणुष्व मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2061404, "chapter_id": 2313, "verse_number": "८-३४-१०", "content_sanskrit": "तेनाहमिषुणा शल्य वासुदेवधनञ्जयौ।\nयोत्स्ये परमसंरब्धौ तत्कर्म सदृशं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2061405, "chapter_id": 2313, "verse_number": "८-३४-११", "content_sanskrit": "सर्वेषां वृष्णिवीराणां कृष्णे लक्ष्मीः प्रतिष्ठिता।\nसर्वेषां पाण्डुपुत्राणां जयः पार्थे प्रतिष्ठितः।\nउभयं तु समासाद्य को निवर्तितुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2061406, "chapter_id": 2313, "verse_number": "८-३४-१२", "content_sanskrit": "तावेतौ पुरुषव्याघ्रौ समेतौ स्यन्दने स्थितौ।\nमामेकमभिसंयुद्धौ सुजातं पश्य शल्य मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2061407, "chapter_id": 2313, "verse_number": "८-३४-१३", "content_sanskrit": "पितृष्वसामातुलजौ भ्रातरावपराजितौ।\nमणी सूत्र इव प्रोतौ द्रष्टासि निहतौ मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2061408, "chapter_id": 2313, "verse_number": "८-३४-१४", "content_sanskrit": "अर्जुने गाण्डिवं कृष्णे चक्रं तार्क्ष्यकपिध्वजौ।\nभीरूणां त्रासजननं शल्य हर्षकरं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2061409, "chapter_id": 2313, "verse_number": "८-३४-१५", "content_sanskrit": "त्वं तु दुष्प्रकृतिर्मूढो महायुद्वेष्वकोविदः।\nभयावदीर्णः सन्त्रासादबद्धं बहुः भाषसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2061410, "chapter_id": 2313, "verse_number": "८-३४-१६", "content_sanskrit": "संस्तौषि तौ तु केनापि हेतुना त्वं कुदेशज।\nतौ हत्वा समरे हन्ता त्वामद्य सह बान्धवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2061411, "chapter_id": 2313, "verse_number": "८-३४-१७", "content_sanskrit": "पापदेशज दुर्बुद्धे क्षुद्र क्षत्रियपांसन।\nसुहृद्रूपो रिपुः किं मां कृष्णाभ्यां भीषयिष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2061412, "chapter_id": 2313, "verse_number": "८-३४-१८", "content_sanskrit": "तौ वा मामद्य हन्तारौ हनिष्ये वाऽपि तावहम्।\nनाहं बिभेमि कृष्णाभ्यां विजानन्नात्मनो बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2061413, "chapter_id": 2313, "verse_number": "८-३४-१९", "content_sanskrit": "वासुदेवसहस्रं वा फल्गुनानां शतानि वा।\nअहमेको हनिष्यामि जोषमास्स्व कुदेशज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2061414, "chapter_id": 2313, "verse_number": "८-३४-२०", "content_sanskrit": "स्त्रियो बालाश्च वृद्वाश्च प्रायः क्रीडागता जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2061415, "chapter_id": 2313, "verse_number": "८-३४-२१", "content_sanskrit": "या गाथाः सम्प्रगायन्ति कुर्वतोऽध्ययनं यथा।\nता गाथाः शृणु मे शल्य मद्रकेषु दुरात्मसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2061416, "chapter_id": 2313, "verse_number": "८-३४-२२", "content_sanskrit": "ब्राह्मणैः कथिताः पूर्वं यथावद्राजसन्निधौ।\nश्रुत्वा चैकमना मूढ मम वा ब्रूहि चोत्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2061417, "chapter_id": 2313, "verse_number": "८-३४-२३", "content_sanskrit": "मित्रध्रुङ्मद्रको नित्यं यो नो द्वेष्टि स मद्रकः।\nमद्रके सङ्गतं नास्ति क्षुद्रवाक्ये नराधमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2061418, "chapter_id": 2313, "verse_number": "८-३४-२४", "content_sanskrit": "दुरात्मा मद्रको नित्यं नित्यमानृतिकोऽनृजुः।\nयच्चान्यदपि दौरात्म्यं मद्रकेष्विति नः श्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2061419, "chapter_id": 2313, "verse_number": "८-३४-२५", "content_sanskrit": "पिता पुत्रश्च माता च श्वश्रूश्वशुरमातुलाः।\nभगिनी दुहिता भ्राता नप्ताऽन्ये ते च बान्धवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2061420, "chapter_id": 2313, "verse_number": "८-३४-२६", "content_sanskrit": "वयस्याभ्यागताश्चान्ये दासीदासाश्च सङ्गताः।\nपुम्भिर्विमिश्रा नार्यश्च ज्ञाताज्ञाताः स्वयेच्छया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2061421, "chapter_id": 2313, "verse_number": "८-३४-२७", "content_sanskrit": "येषां गृहेष्वशिष्टानां सक्तुमद्याशिनां सदा।\nपीत्वा शीधु सगोमांसं क्रन्दन्ति च हसन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2061422, "chapter_id": 2313, "verse_number": "८-३४-२८", "content_sanskrit": "गायन्ति चाप्यबद्धानि प्रवर्तन्ते च कामतः।\nकामप्रलापिनोऽन्योन्यं तेषु धर्मःकथं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2061423, "chapter_id": 2313, "verse_number": "८-३४-२९", "content_sanskrit": "मद्रकेष्ववलिप्तेषु प्रख्याताशुभकर्मसु।\nनापि वैरं न सौहार्दं मद्रकेण समाचरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2061424, "chapter_id": 2313, "verse_number": "८-३४-३०", "content_sanskrit": "मद्रके सङ्गतं नास्ति मद्रको हि सदा मलः।\nमद्रकेषु च संसृष्टं शौचं गान्धारकेषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2061425, "chapter_id": 2313, "verse_number": "८-३४-३१", "content_sanskrit": "राजयाजकयाज्ये हि यथा दत्तं हविर्नशेत्।\nशूद्रसंस्कारको विप्रो यथा याति पराभवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2061426, "chapter_id": 2313, "verse_number": "८-३४-३२", "content_sanskrit": "यथा ब्रह्मद्विषो नित्यं गच्छन्तीह पराभवम्।\nयथैव संगतं कृत्वा नरः पतति मद्रकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2061427, "chapter_id": 2313, "verse_number": "८-३४-३३", "content_sanskrit": "बालेष्वपि सदा न स्म धनं वृश्चिक ते विषम्।\nआथर्वणेन मन्त्रेण सर्वशान्तिः कृता मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2061428, "chapter_id": 2313, "verse_number": "८-३४-३४", "content_sanskrit": "इति वृश्चिकदष्टस्य विषवेगहतस्य च।\nकुर्वन्ति भेषजं प्राज्ञाः सत्यं तच्चापि दृश्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2061429, "chapter_id": 2313, "verse_number": "८-३४-३५", "content_sanskrit": "एवं विद्वञ्जोषमास्स्व ब्रूहि चात्रोत्तरं वचः।\nवासांस्युत्सृज्य नृत्यन्ति स्त्रियो मद्यविमोहिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2061430, "chapter_id": 2313, "verse_number": "८-३४-३६", "content_sanskrit": "मैथुनेऽसङ्गताश्चापि यथाकामवराश्च ताः।\nतासां पुत्र कथं धर्मं मद्रको वक्तुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2061431, "chapter_id": 2313, "verse_number": "८-३४-३७", "content_sanskrit": "यास्तिष्ठन्त्यः प्रमेहन्ति यथैवोष्ट्रदशेरकाः।\nतासां विभ्रष्टधर्माणां निर्लज्जानां ततस्ततः।\nत्वं पुत्रस्तादृशीनां हि धर्मं वक्तुमिहेच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2061432, "chapter_id": 2313, "verse_number": "८-३४-३८", "content_sanskrit": "सौवीरकं याच्यमाना मद्रिका कर्षति स्फिचौ।\nअदातुकामा वचनमिदं वदति दारुणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2061433, "chapter_id": 2313, "verse_number": "८-३४-३९", "content_sanskrit": "मा मां सौवीरकं कश्चिद्याचतां दयितं मम।\nपुत्रं दद्यां पतिं दद्यां न तु दद्यां सुवीरकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2061434, "chapter_id": 2313, "verse_number": "८-३४-४०", "content_sanskrit": "गौर्यो बृहत्यो निर्हीका मद्रिकाः कम्पलावृताः।\nघस्मरा नष्टशौचाश्च प्राय इत्यनुशुश्रुम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2061435, "chapter_id": 2313, "verse_number": "८-३४-४१", "content_sanskrit": "पमेहित्वा स्फिचौ भूमौ घर्षन्त्यो हीनशोधनाः।\nशुद्धा नाद्भिर्न मृद्भिश्च नित्योच्छिष्टा भवन्ति हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2061436, "chapter_id": 2313, "verse_number": "८-३४-४२", "content_sanskrit": "एवमादि मयाऽन्यैर्वा शक्यं वक्तुं भवेद्बहु।\nआकेशान्तान्नखाग्राच्च वक्तव्येषु कुकर्मसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2061437, "chapter_id": 2313, "verse_number": "८-३४-४३", "content_sanskrit": "मद्रकाः सिन्धुसौवीरा धर्मं विद्युः कथं त्विह।\nपापदेशोद्भवा म्लेच्छा धर्माणामविचक्षणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2061438, "chapter_id": 2313, "verse_number": "८-३४-४४", "content_sanskrit": "एष मुख्यतमो धर्मः क्षत्रियस्येति नः श्रुतम्।\nयदाजौ निहतः शेते सद्भिः समभिपूजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2061439, "chapter_id": 2313, "verse_number": "८-३४-४५", "content_sanskrit": "आयुधानां साम्पराये यन्मुञ्चेयमहं ततः।\nममैष प्रथमः कल्पो निधने स्वर्गमिच्छतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2061440, "chapter_id": 2313, "verse_number": "८-३४-४६", "content_sanskrit": "सोयं प्रियसखा चास्मि धार्तराष्ट्रस्य धीमतः।\nतदर्थे हि मम प्राणा यच्च मे विद्यते वसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2061441, "chapter_id": 2313, "verse_number": "८-३४-४७", "content_sanskrit": "व्यक्तं त्वमप्युपहितः पाण्डवैः पापदेशज।\nयथा चामित्रवत्सर्वं त्वमस्मासु प्रवर्तसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2061442, "chapter_id": 2313, "verse_number": "८-३४-४८", "content_sanskrit": "कामं न खलु शक्योऽहं त्वद्विधानां शतैरपि।\nसङ्ग्रामाद्विमुखः कर्तुं धर्मज्ञ इव नास्तिकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2061443, "chapter_id": 2313, "verse_number": "८-३४-४९", "content_sanskrit": "सारङ्ग इव घर्मार्तः कामं विलप शुष्य च।\nनाहं भीषयितुं शक्यः क्षत्रधर्मे व्यवस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2061444, "chapter_id": 2313, "verse_number": "८-३४-५०", "content_sanskrit": "तनुत्यजां नृसिंहानामाहवेष्वनिवर्तिनाम्।\nया गतिर्गुरुणा प्रोक्ता प्रेम्णा रामेण तां स्मरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2061445, "chapter_id": 2313, "verse_number": "८-३४-५१", "content_sanskrit": "स्वेषां त्राणार्थमुद्यन्तं वधार्थं द्विषतामपि।\nविद्धि मामास्थितं वृत्तं पौरूरवसमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2061446, "chapter_id": 2313, "verse_number": "८-३४-५२", "content_sanskrit": "न तद्भूतं प्रपश्यामि त्रिषु लोकेषु मद्रप।\nयो मामस्मादभिप्रायाद्वारयेदिति मे मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2061447, "chapter_id": 2313, "verse_number": "८-३४-५३", "content_sanskrit": "एवं विद्वञ्जोषमास्स्व त्रासात्किं बहु भाषसे।\nन त्वां हत्वा प्रदास्यामि क्रव्याद्भ्यो मद्रकाधम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2061448, "chapter_id": 2313, "verse_number": "८-३४-५४", "content_sanskrit": "मित्रप्रतीक्षया शल्य धृतराष्ट्रस्य चोभयोः।\nअपवादतितिक्षाभिस्त्रिभिरेतैर्हि जीवसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2061449, "chapter_id": 2313, "verse_number": "८-३४-५५", "content_sanskrit": "पुनश्चेदीदृशं वाक्यं मद्रराज वदिष्यसि।\nशिरस्ते पातयिष्यासि गदया वज्रकल्पया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2061450, "chapter_id": 2313, "verse_number": "८-३४-५६", "content_sanskrit": "श्रोतारस्त्विदमद्येह द्रष्टारो व्रा कुदेशज।\nकर्णं वा जघ्नतुः कृष्णौ कर्णो वा निजघान तौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2061451, "chapter_id": 2313, "verse_number": "८-३४-५७", "content_sanskrit": "एवमुक्त्वा तु राधेयः पुनरेव विशाम्पते।\nअब्रवीन्मद्रराजानं याहियाहीत्यसम्भ्रमम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2061452, "chapter_id": 2313, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि चतुस्त्रिंशोऽध्यायः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}]