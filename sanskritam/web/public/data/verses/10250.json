[{"id": 6000250000, "chapter_id": 10250, "verse_number": null, "content_sanskrit": "अथ चतुःपञ्चाशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000250001, "chapter_id": 10250, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.001.m4a", "display_order": 2}, {"id": 6000250002, "chapter_id": 10250, "verse_number": "१०-५४-१", "content_sanskrit": "तं विलोक्य विनिष्क्रान्तमुज्जिहानमिवोडुपम्।\nदर्शनीयतमं श्यामं पीतकौशेयवाससम्॥ १०/५४/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.002.m4a", "display_order": 3, "topics": [{"text": "निरायुधेन कृष्णेन कालयवनवञ्चनार्थं पलायनम्", "range": "१–६"}]}, {"id": 6000250003, "chapter_id": 10250, "verse_number": "१०-५४-२", "content_sanskrit": "श्रीवत्सवक्षसं भ्राजत्कौस्तुभामुक्तकन्धरम्।\nपृथुदीर्घचतुर्बाहुं नवकञ्जारुणेक्षणम्॥ १०/५४/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.003.m4a", "display_order": 4}, {"id": 6000250004, "chapter_id": 10250, "verse_number": "१०-५४-३", "content_sanskrit": "नित्यप्रमुदितं श्रीमत्सुकपोलं शुचिस्मितम्।\nमुखारविन्दं बिभ्राणं स्फुरन्मकरकुण्डलम्॥ १०/५४/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.004.m4a", "display_order": 5}, {"id": 6000250005, "chapter_id": 10250, "verse_number": "१०-५४-४", "content_sanskrit": "वासुदेवो ह्ययमिति पुमान् श्रीवत्सलाञ्छनः।\nचतुर्भुजोऽरविन्दाक्षो वनमाल्यतिसुन्दरः॥ १०/५४/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.005.m4a", "display_order": 6}, {"id": 6000250006, "chapter_id": 10250, "verse_number": "१०-५४-५", "content_sanskrit": "लक्षणैर्नारदप्रोक्तैर्नान्यो भवितुमर्हति।\nनिरायुधश्चलन् पद्भ्यां योत्स्येऽनेन निरायुधः॥ १०/५४/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.006.m4a", "display_order": 7}, {"id": 6000250007, "chapter_id": 10250, "verse_number": "१०-५४-६", "content_sanskrit": "इति निश्चित्य यवनः प्रद्रवन्तं पराङ्मुखम्।\nअन्वधावज्जिघृक्षुस्तं दुरापमपि योगिनाम्॥ १०/५४/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.007.m4a", "display_order": 8}, {"id": 6000250008, "chapter_id": 10250, "verse_number": "१०-५४-७", "content_sanskrit": "हस्तप्राप्तमिवात्मानं हरिणा स पदे पदे।\nनीतो दर्शयता दूरं यवनेशोऽद्रिकन्दरम्॥ १०/५४/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.008.m4a", "display_order": 9, "topics": [{"text": "मुचुकुन्दकथा", "range": "७–६५"}]}, {"id": 6000250009, "chapter_id": 10250, "verse_number": "१०-५४-८", "content_sanskrit": "पलायनं यदुकुले जातस्य तव नोचितम्।\nइति क्षिपन्ननुगतो नैनं प्रापाहताशुभः॥ १०/५४/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.009.m4a", "display_order": 10}, {"id": 6000250010, "chapter_id": 10250, "verse_number": "१०-५४-९", "content_sanskrit": "एवं क्षिप्तोऽपि भगवान् प्राविशद् गिरिकन्दरम्।\nसोऽपि प्रविष्टस्तत्रान्यं शयानं ददृशे नरम्॥ १०/५४/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.010.m4a", "display_order": 11}, {"id": 6000250011, "chapter_id": 10250, "verse_number": "१०-५४-१०", "content_sanskrit": "नन्वसौ दूरमानीय शेते मामिह साधुवत्।\nइति मत्वाऽच्युतं मूढस्तं पदा समताडयत्॥ १०/५४/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.011.m4a", "display_order": 12}, {"id": 6000250012, "chapter_id": 10250, "verse_number": "१०-५४-११", "content_sanskrit": "स उत्थाय चिरं सुप्तः शनैरुन्मील्य लोचने।\nदिशो विलोकयन् पार्श्वे तमद्राक्षीदवस्थितम्॥ १०/५४/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.012.m4a", "display_order": 13}, {"id": 6000250013, "chapter_id": 10250, "verse_number": "१०-५४-१२", "content_sanskrit": "स तावत् तस्य रुष्टस्य दृष्टिपातेन भारत।\nदेहजेनाग्निना दग्धो भस्मसादभवत् क्षणात्॥ १०/५४/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.013.m4a", "display_order": 14}, {"id": 6000250014, "chapter_id": 10250, "verse_number": null, "content_sanskrit": "राजोवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.014.m4a", "display_order": 15}, {"id": 6000250015, "chapter_id": 10250, "verse_number": "१०-५४-१३", "content_sanskrit": "को नाम स पुमान् ब्रह्मन् कस्य किं वीर्य एव वा।\nकस्माद् गुहाङ्गतः शिश्ये किंतेजा यवनार्दनः॥ १०/५४/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.015.m4a", "display_order": 16}, {"id": 6000250016, "chapter_id": 10250, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.016.m4a", "display_order": 17}, {"id": 6000250017, "chapter_id": 10250, "verse_number": "१०-५४-१४", "content_sanskrit": "स इक्ष्वाकुकुले जातो मान्धातृतनयो महान्।\nमुचुकुन्द इति ख्यातो ब्रह्मण्यः सत्यसङ्गरः॥ १०/५४/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.017.m4a", "display_order": 18}, {"id": 6000250018, "chapter_id": 10250, "verse_number": "१०-५४-१५", "content_sanskrit": "स याचितः सुरगणैरिन्द्राद्यैरात्मरक्षणे।\nअसुरेभ्यः परिभ्रष्टैस्तद्रक्षां सोऽकरोच्चिरम्॥ १०/५४/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.018.m4a", "display_order": 19}, {"id": 6000250019, "chapter_id": 10250, "verse_number": "१०-५४-१६", "content_sanskrit": "लब्ध्वा गृहांस्ते स्वःपालं मुचकुन्दमथाब्रुवन्।\nराजन् विरमतां कृच्छ्राद् भवान् नः परिपालनात्॥ १०/५४/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.019.m4a", "display_order": 20}, {"id": 6000250020, "chapter_id": 10250, "verse_number": "१०-५४-१७", "content_sanskrit": "नरलोकं परित्यज्य राज्यं निहतकण्टकम्।\nअस्मान् पालयतो वीर कामास्ते सर्व उज्झिताः॥ १०/५४/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.020.m4a", "display_order": 21}, {"id": 6000250021, "chapter_id": 10250, "verse_number": "१०-५४-१८", "content_sanskrit": "सुता महिष्यो भवतो ज्ञातयोऽमात्यमन्त्रिणः।\nप्रजाश्च तुल्यकालीना नाधुना सन्ति कालिताः॥ १०/५४/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.021.m4a", "display_order": 22}, {"id": 6000250022, "chapter_id": 10250, "verse_number": "१०-५४-१९", "content_sanskrit": "कालो बलीयान् बलिनां भगवानीश्वरोऽव्ययः।\nप्रजाः कालयते क्रीडन् पशुपालो यथा पशून्॥ १०/५४/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.022.m4a", "display_order": 23}, {"id": 6000250023, "chapter_id": 10250, "verse_number": "१०-५४-२०", "content_sanskrit": "वरं वृणीष्व भद्रं ते ऋते कैवल्यमात्मनः।\nएक एवेश्वरस्तस्य भगवान् विष्णुरव्ययः॥ १०/५४/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.023.m4a", "display_order": 24}, {"id": 6000250024, "chapter_id": 10250, "verse_number": "१०-५४-२१", "content_sanskrit": "एवमुक्तः स वै देवानभिवाद्य महायशाः।\nअयाचत गुहाविष्टो निद्रां तु बहुकालिकीम्॥ १०/५४/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.024.m4a", "display_order": 25}, {"id": 6000250025, "chapter_id": 10250, "verse_number": "१०-५४-२२", "content_sanskrit": "तथेत्युक्तस्तु तैर्देवैर्मुचुकुन्दो महामनाः।\nअशयिष्ट गुहाविष्टो निद्रया देवदत्तया॥ १०/५४/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.025.m4a", "display_order": 26}, {"id": 6000250026, "chapter_id": 10250, "verse_number": "१०-५४-२३", "content_sanskrit": "यवने भस्मसान्नीते भगवान् सात्त्वतर्षभः।\nआत्मानं दर्शयामास मुचुकुन्दाय धीमते॥ १०/५४/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.026.m4a", "display_order": 27}, {"id": 6000250027, "chapter_id": 10250, "verse_number": "१०-५४-२४", "content_sanskrit": "तमालोक्य घनश्यामं पीतकौशेयवाससम्।\nश्रीवत्सवक्षसं भ्राजत्कौस्तुभेन विराजितम्॥ १०/५४/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.027.m4a", "display_order": 28}, {"id": 6000250028, "chapter_id": 10250, "verse_number": "१०-५४-२५", "content_sanskrit": "चतुर्भुजं रोचमानं वैजयन्त्या च मालया।\nचारुप्रसन्नवदनं स्फुरन्मकरकुण्डलम्॥ १०/५४/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.028.m4a", "display_order": 29}, {"id": 6000250029, "chapter_id": 10250, "verse_number": "१०-५४-२६", "content_sanskrit": "प्रेक्षणीयं त्रिलोकस्य सानुरागस्मितेक्षणम्।\nआपीच्यवयसं मत्तमृगेन्द्रोदारविक्रमम्॥ १०/५४/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.029.m4a", "display_order": 30}, {"id": 6000250030, "chapter_id": 10250, "verse_number": "१०-५४-२७", "content_sanskrit": "पर्यपृच्छन्महाबुद्धिस्तेजसा तस्य विस्मितः।\nशङ्कितः शनकै राजा दुर्धर्षमतितेजसा॥ १०/५४/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.030.m4a", "display_order": 31}, {"id": 6000250031, "chapter_id": 10250, "verse_number": null, "content_sanskrit": "मुचुकुन्द उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.031.m4a", "display_order": 32}, {"id": 6000250032, "chapter_id": 10250, "verse_number": "१०-५४-२८", "content_sanskrit": "को भवानिह सम्प्राप्तो विपिने गिरिगह्वरे।\nपद्भ्यां पद्मपलाशाभ्यां विचरस्युरुकण्टके॥ १०/५४/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.032.m4a", "display_order": 33}, {"id": 6000250033, "chapter_id": 10250, "verse_number": "१०-५४-२९", "content_sanskrit": "किंस्वित्तेजस्विनां तेजो भगवांस्त्वं विभावसुः।\nसूर्यः सोमो महेन्द्रो वा लोकपालोऽपरोऽपि वा॥ १०/५४/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.033.m4a", "display_order": 34}, {"id": 6000250034, "chapter_id": 10250, "verse_number": "१०-५४-३०", "content_sanskrit": "मन्ये त्वां देवदेवानां त्रयाणां पुरुषर्षभम्।\nयद् भाससे गुहाध्वान्तं प्रदीपः प्रभया यथा॥ १०/५४/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.034.m4a", "display_order": 35}, {"id": 6000250035, "chapter_id": 10250, "verse_number": "१०-५४-३१", "content_sanskrit": "शुश्रूषतामव्यलीकमस्माकं नरपुङ्गव।\nस्वजन्म कर्म गोत्रं वा कथ्यतां यदि रोचते॥ १०/५४/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.035.m4a", "display_order": 36}, {"id": 6000250036, "chapter_id": 10250, "verse_number": "१०-५४-३२", "content_sanskrit": "वयं तु पुरुषव्याघ्र ऐक्ष्वाकाः क्षत्रबन्धवः।\nमुचुकुन्द इति प्रोक्तो यौवनाश्वात्मजः प्रभो॥ १०/५४/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.036.m4a", "display_order": 37}, {"id": 6000250037, "chapter_id": 10250, "verse_number": "१०-५४-३३", "content_sanskrit": "चिरप्रजागरश्रान्तो निद्रयोपहतेन्द्रियः।\nशयेऽस्मिन् विपिने कामं केनाप्युत्थापितोऽधुना॥ १०/५४/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.037.m4a", "display_order": 38}, {"id": 6000250038, "chapter_id": 10250, "verse_number": "१०-५४-३४", "content_sanskrit": "सोऽपि भस्मीकृतो नूनमात्मीयेनैव पाप्मना।\nअनन्तरं भवान् श्रीमान् लक्षितोऽमित्रशासनः॥ १०/५४/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.038.m4a", "display_order": 39}, {"id": 6000250039, "chapter_id": 10250, "verse_number": "१०-५४-३५", "content_sanskrit": "तेजसा तेऽविषह्येण भूरि द्रष्टुं न शक्नुमः।\nहतौजसो महाभाग माननीयोऽसि देहिनाम्॥ १०/५४/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.039.m4a", "display_order": 40}, {"id": 6000250040, "chapter_id": 10250, "verse_number": "१०-५४-३६", "content_sanskrit": "एवं सम्भाषितो राज्ञा भगवान् भूतभावनः।\nप्रत्याह प्रहसन् वाण्या मेघह्रादगभीरया॥ १०/५४/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.040.m4a", "display_order": 41}, {"id": 6000250041, "chapter_id": 10250, "verse_number": null, "content_sanskrit": "श्रीकृष्ण उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.041.m4a", "display_order": 42}, {"id": 6000250042, "chapter_id": 10250, "verse_number": "१०-५४-३७", "content_sanskrit": "जन्मकर्माभिधानानि सन्ति मेऽङ्ग सहस्रशः।\nन शक्यन्तेऽनुसङ्ख्यातुमनन्तत्वान्ममापि हि॥ १०/५४/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.042.m4a", "display_order": 43}, {"id": 6000250043, "chapter_id": 10250, "verse_number": "१०-५४-३८", "content_sanskrit": "कश्चिद्रजांसि विममे पार्थिवान्युरुजन्मभिः।\nगुणकर्माभिधानानि न मे जन्मानि कर्हिचित्॥ १०/५४/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.043.m4a", "display_order": 44}, {"id": 6000250044, "chapter_id": 10250, "verse_number": "१०-५४-३९", "content_sanskrit": "कालत्रयोपपन्नानि जन्मकर्माणि मे नृप।\nअनुक्रमन्तो नैवान्तं गच्छन्ति परमर्षयः॥ १०/५४/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.044.m4a", "display_order": 45}, {"id": 6000250045, "chapter_id": 10250, "verse_number": "१०-५४-४०", "content_sanskrit": "तथाप्यद्यतनान्यङ्ग शृणुष्व गदतो मम।\nप्रार्थितस्तु विरिञ्चेन पुराऽहं धर्मगुप्तये॥ १०/५४/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.045.m4a", "display_order": 46}, {"id": 6000250046, "chapter_id": 10250, "verse_number": "१०-५४-४१", "content_sanskrit": "भूमेर्भारायमाणानामसुराणां क्षयाय च।\nअवतीर्णो यदुकुले गृह आनकदुन्दुभेः॥ १०/५४/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.046.m4a", "display_order": 47}, {"id": 6000250047, "chapter_id": 10250, "verse_number": "१०-५४-४२", "content_sanskrit": "वदन्ति वासुदेवेति वसुदेवसुतेति माम्।\nकालनेमिर्हतः कंसः प्रलम्बाद्याश्च सद्द्विषः॥ १०/५४/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.047.m4a", "display_order": 48}, {"id": 6000250048, "chapter_id": 10250, "verse_number": "१०-५४-४३", "content_sanskrit": "अयं च यवनो दग्धो राजंस्ते तिग्मचक्षुषा।\nसोऽहं तवानुग्रहार्थं गुहामेतामुपागतः॥ १०/५४/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.048.m4a", "display_order": 49}, {"id": 6000250049, "chapter_id": 10250, "verse_number": "१०-५४-४४", "content_sanskrit": "प्रार्थितः प्रचुरं पूर्वं त्वयाऽहं भक्तवत्सलः।\nवरान् वृणीष्व राजर्षे सर्वान् कामान् ददामि ते॥ १०/५४/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.049.m4a", "display_order": 50}, {"id": 6000250050, "chapter_id": 10250, "verse_number": "१०-५४-४५", "content_sanskrit": "मां प्रपन्नो जनः कश्चिन्न भूयोऽर्हति शोचितुम्॥ १०/५४/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.050.m4a", "display_order": 51}, {"id": 6000250051, "chapter_id": 10250, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.051.m4a", "display_order": 52}, {"id": 6000250052, "chapter_id": 10250, "verse_number": "१०-५४-४६", "content_sanskrit": "इत्युक्तस्तं प्रणम्याह मुचुकुन्दो मुदान्वितः।\nज्ञात्वा नारायणं देवं गर्गवाक्यमनुस्मरन्॥ १०/५४/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.052.m4a", "display_order": 53}, {"id": 6000250053, "chapter_id": 10250, "verse_number": null, "content_sanskrit": "मुचुकुन्द उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.053.m4a", "display_order": 54}, {"id": 6000250054, "chapter_id": 10250, "verse_number": "१०-५४-४७", "content_sanskrit": "विमोहितोऽयं जन ईश मायया त्वदीयया त्वां न भजत्यनर्थदृक्।\nसुखाय दुःखप्रभवेषु सज्जते गृहेषु योषित् पुरुषश्च वञ्चितः॥ १०/५४/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.054.m4a", "display_order": 55}, {"id": 6000250055, "chapter_id": 10250, "verse_number": "१०-५४-४८", "content_sanskrit": "लब्ध्वा जनो दुर्लभमत्र मानुषं कथञ्चिदप्यङ्गमयत्नतोऽनघ।\nपादाम्बुजं ते न भजत्यसन्मतिर्गृहान्धकूपे पतितो यथा पशुः॥ १०/५४/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.055.m4a", "display_order": 56}, {"id": 6000250056, "chapter_id": 10250, "verse_number": "१०-५४-४९", "content_sanskrit": "ममैष कालोऽजित निष्फलो गतो राज्यश्रियोन्नद्धमदस्य भूपतेः।\nमर्त्यात्मबुद्धेः सुतदारकोशेष्वासज्जमानस्य दुरन्तचिन्तया॥ १०/५४/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.056.m4a", "display_order": 57}, {"id": 6000250057, "chapter_id": 10250, "verse_number": "१०-५४-५०", "content_sanskrit": "कलेवरेऽस्मिन् घटकुड्यसन्निभे निरूढमानो नरदेव इत्यहम्।\nवृतो रथेभाश्वपदात्यनीकपैर्गां पर्यटंस्त्वामगणय्य दुर्मदः॥ १०/५४/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.057.m4a", "display_order": 58}, {"id": 6000250058, "chapter_id": 10250, "verse_number": "१०-५४-५१", "content_sanskrit": "प्रमत्तमुच्चैरितिकृत्यचिन्तया प्रवृद्धलोभं विषयेषु लालसम्।\nत्वमप्रमत्तः सहसाऽभिपद्यसे क्षुल्लेलिहानोऽहिरिवाखुमन्तकृत्॥ १०/५४/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.058.m4a", "display_order": 59}, {"id": 6000250059, "chapter_id": 10250, "verse_number": "१०-५४-५२", "content_sanskrit": "पुरा रथैर्हेमपरिष्कृतैश्चरन् मतङ्गजैर्वा नरदेवसञ्ज्ञितः।\nस एव कालेन दुरत्ययेन कलेवरो विट्कृमिभस्मसञ्ज्ञितः॥ १०/५४/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.059.m4a", "display_order": 60}, {"id": 6000250060, "chapter_id": 10250, "verse_number": "१०-५४-५३", "content_sanskrit": "निर्जित्य दिक्चक्रमभूतविग्रहो परासनस्थः समराजवन्दितः।\nगृहेषु मैथुन्यपरेषु योषितां क्रीडामृगः पूरुष ईश गीयते॥ १०/५४/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.060.m4a", "display_order": 61}, {"id": 6000250061, "chapter_id": 10250, "verse_number": "१०-५४-५४", "content_sanskrit": "करोति कर्माणि तपः सुनिष्ठितो निवृत्तभोगस्तदपेक्षया ददत्।\nपुनश्च भूयाय महीश राधसे प्रवृद्धतर्षो न सुखाय कल्पते॥ १०/५४/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.061.m4a", "display_order": 62}, {"id": 6000250062, "chapter_id": 10250, "verse_number": "१०-५४-५५", "content_sanskrit": "भवापवर्गो भ्रमतो यदा भवेज्जनस्य तर्ह्यच्युत सत्समागमः।\nसत्सङ्गमो यर्हि तदैव तद्गतौ परावरेशे त्वयि जायते मतिः॥ १०/५४/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.062.m4a", "display_order": 63}, {"id": 6000250063, "chapter_id": 10250, "verse_number": "१०-५४-५६", "content_sanskrit": "मन्ये ममानुग्रह ईश ते कृतो राज्यानुबन्धापगमो यदृच्छया।\nयः प्रार्थ्यते साधुभिरेकचर्यया वनं विविक्षुद्भिरखण्डभूमिपैः॥ १०/५४/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.063.m4a", "display_order": 64}, {"id": 6000250064, "chapter_id": 10250, "verse_number": "१०-५४-५७", "content_sanskrit": "न कामयेऽन्यं तव पादसेवनादकिञ्चनप्रार्थ्यतमाद् वरं विभो।\nआराध्य कस्त्वां ह्यपवर्गदं हरे वृणीत आर्यो वरमात्मबन्धनम्॥ १०/५४/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.064.m4a", "display_order": 65}, {"id": 6000250065, "chapter_id": 10250, "verse_number": "१०-५४-५८", "content_sanskrit": "तस्माद् विसृज्याशिष ईश सर्वशो रजस्तमःसत्त्वगुणानुबन्धनाः।\nनिरञ्जनं निर्गुणमद्वयं परं त्वां ज्ञप्तिमात्रं पुरुषं व्रजाम्यहम्॥ १०/५४/५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.065.m4a", "display_order": 66}, {"id": 6000250066, "chapter_id": 10250, "verse_number": "१०-५४-५९", "content_sanskrit": "चिरमिह वृजिनार्तस्तप्यमानोऽनुतापैः अवितृष उरुकृच्छ्रेऽलब्धशान्तिः कथञ्चित्।\nशरणद समुपेतस्त्वत्पदाब्जं परात्मन् अभयमृतमशोकं पाहि मापन्नमीश॥ १०/५४/५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.066.m4a", "display_order": 67}, {"id": 6000250067, "chapter_id": 10250, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.067.m4a", "display_order": 68}, {"id": 6000250068, "chapter_id": 10250, "verse_number": "१०-५४-६०", "content_sanskrit": "सार्वभौम महाराज मतिस्ते विमलोर्जिता।\nवरैः प्रलोभितस्यापि न कामैर्विहता यतः॥ १०/५४/६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.068.m4a", "display_order": 69}, {"id": 6000250069, "chapter_id": 10250, "verse_number": "१०-५४-६१", "content_sanskrit": "प्रलोभितो वरैर्यत् त्वमप्रमादाय विद्धि तत्।\nन धीर्मय्येकभक्तानामाशीर्भिर्भिद्यते क्‍वचित्॥ १०/५४/६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.069.m4a", "display_order": 70}, {"id": 6000250070, "chapter_id": 10250, "verse_number": "१०-५४-६२", "content_sanskrit": "ज्ञानिनामेकभक्तानां प्राणायामादिभिर्मनः।\nन क्षीणवासनं राजन् दृश्यते क्‍वचिदुत्थितम्॥ १०/५४/६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.070.m4a", "display_order": 71}, {"id": 6000250071, "chapter_id": 10250, "verse_number": "१०-५४-६३", "content_sanskrit": "विचरस्व यथाकामं मय्यावेशितमानसः।\nअस्त्वेव नित्यदा तुभ्यं भक्तिर्मय्यनपायिनी॥ १०/५४/६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.071.m4a", "display_order": 72}, {"id": 6000250072, "chapter_id": 10250, "verse_number": "१०-५४-६४", "content_sanskrit": "क्षत्रजन्मस्थितो जन्तूनवधीर्मृगयादिभिः।\nसमाहितस्तत् तपसा जह्यघं मामुपाश्रितः॥ १०/५४/६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.072.m4a", "display_order": 73}, {"id": 6000250073, "chapter_id": 10250, "verse_number": "१०-५४-६५", "content_sanskrit": "जन्मन्यनन्तरे राजन् सर्वभूतसुहृत्तमः।\nभूत्वा द्विजवरस्त्वं वै मामुपेष्यसि केवलम्॥ १०/५४/६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_054/BhP_10.054.073.m4a", "display_order": 74}, {"id": 6000250074, "chapter_id": 10250, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्ध उत्तरार्धे चतुःपञ्चाशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}]