[{"id": 2024861, "chapter_id": 1532, "verse_number": "३-१७०-०x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2024862, "chapter_id": 1532, "verse_number": "३-१७०-१", "content_sanskrit": "कृतास्त्रमतिविश्वस्तमथ मां हरिवाहनः।\nरसंस्पृश्य मूर्ध्नि पाणिब्यामिदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2024863, "chapter_id": 1532, "verse_number": "३-१७०-२", "content_sanskrit": "न त्वमद्य युधा जेतुं शक्यः सुरगणैरपि।\nकिं पुनर्मानुषे लोके मानुषैरकृतात्मभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2024864, "chapter_id": 1532, "verse_number": "३-१७०-३", "content_sanskrit": "अप्रमेयोऽप्रधृष्यश्च युद्धेष्वप्रतिमस्तथा।\n`अजेयस्त्वं हि सङ्ग्रामे सर्वैरपिसुरासुरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2024865, "chapter_id": 1532, "verse_number": "३-१७०-४", "content_sanskrit": "अथाब्रवीत्पुनर्देवः संप्रहृष्टतनूरुहः।\nअस्त्रयुद्धे समो वीर न ते कश्चिद्भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2024866, "chapter_id": 1532, "verse_number": "३-१७०-५", "content_sanskrit": "अप्रमत्तः सदा दक्षः सत्यवादी जितेन्द्रियः।\nब्रह्मण्यश्चास्त्रविच्चासि शूरश्चासि कुरूद्वह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2024867, "chapter_id": 1532, "verse_number": "३-१७०-६", "content_sanskrit": "अस्त्राणि समवाप्तानि त्वया दश च पञ्च च।\nपञ्चभिर्विधिभिः पार्थ विद्यते न त्वया समः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2024868, "chapter_id": 1532, "verse_number": "३-१७०-७", "content_sanskrit": "प्रयोगमुपसंहारमावृत्तिं च धनञ्जय।\nप्रायश्चित्तं च वेत्थ त्वं प्रतीघातं च सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2024869, "chapter_id": 1532, "verse_number": "३-१७०-८", "content_sanskrit": "तव गुर्वर्थकालोऽयं समुत्पन्नः परंतप।\nप्रतिजानीष्व तं कर्तुं ततो वेत्स्याम्यहं परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2024870, "chapter_id": 1532, "verse_number": "३-१७०-९", "content_sanskrit": "ततोऽहमब्रवं राजन्देवराजमिदं वचः।\nविषह्यं यन्मया कर्तुं कृतमेव निबोध तत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2024871, "chapter_id": 1532, "verse_number": "३-१७०-१०", "content_sanskrit": "ततो मामब्रवीद्राजन्प्रहसन्बलवृत्रहा।\nनाविपह्यं तवाद्यास्ति त्रिषु लोकेषु किंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2024872, "chapter_id": 1532, "verse_number": "३-१७०-११", "content_sanskrit": "निवातकवचा नाम दानवा मम शत्रवः।\nसमुद्रकुक्षिमाश्रित्य दुर्गे प्रतिवसन्त्युत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2024873, "chapter_id": 1532, "verse_number": "३-१७०-१२", "content_sanskrit": "तिस्रः कोट्यः समाख्यातास्तुल्यरूपबलप्रभाः।\nतांस्तत्रजहि कौन्तेय गुर्वर्थस्ते भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2024874, "chapter_id": 1532, "verse_number": "३-१७०-१३", "content_sanskrit": "ततो मातलिसंयुक्तं मयूरसमरोमभिः।\nहयैरुपेतं प्रादान्मे रथं दिव्यं महाप्रभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2024875, "chapter_id": 1532, "verse_number": "३-१७०-१४", "content_sanskrit": "बबन्ध चैव मे मूर्ध्नि किरीटमिदमुत्तमम्।\nस्वरूपसदृशं चैव प्रादादङ्गविभूषणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2024876, "chapter_id": 1532, "verse_number": "३-१७०-१५", "content_sanskrit": "अभेद्यं कवचं चेदं स्पर्सरूपवदुत्तमम्।\nअजरां ज्यामिमां चापि गाण्डीवे समयोजयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2024877, "chapter_id": 1532, "verse_number": "३-१७०-१६", "content_sanskrit": "ततः प्रायामहं तेन स्यन्दनेन विराजता।\nयेनाजयद्देवपतिर्बलिं वैरोचनिं पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2024878, "chapter_id": 1532, "verse_number": "३-१७०-१७", "content_sanskrit": "ततो देवाः सर्व एव तेन घोषेण बोधिताः।\nमन्वाना देवराजं मां समाजग्मुर्विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2024879, "chapter_id": 1532, "verse_number": "३-१७०-१८", "content_sanskrit": "दृष्ट्वा च मामपृच्छन्त किं करिष्यसि फल्गुन।\nतानब्रुवं यथाभूतमिदं कर्ताऽस्मि संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2024880, "chapter_id": 1532, "verse_number": "३-१७०-१९", "content_sanskrit": "निवातकवचानां तु प्रस्थितं मां तधैपिणम्।\nनिबोधत महाभागा शिवं चाशास्त मेऽनघाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2024881, "chapter_id": 1532, "verse_number": "३-१७०-२०", "content_sanskrit": "`ततो वाग्भिः प्रशस्ताभिस्त्रिदशाः पृथिवीपते।\nतुष्टुवुर्मां प्रसन्नास्ते यथा देवं पुरंदरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2024882, "chapter_id": 1532, "verse_number": "३-१७०-२१", "content_sanskrit": "रथेनानेन मघवा जितवाञ्शम्बरं युधि।\nनमुचिं बलवृत्रौ च प्रह्लादनरकावपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2024883, "chapter_id": 1532, "verse_number": "३-१७०-२२", "content_sanskrit": "बहूनि च सहस्राणि प्रयुतान्यर्बुदान्यपि।\nरथेनानेन दैत्यानां जितवान्मघवा युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2024884, "chapter_id": 1532, "verse_number": "३-१७०-२३", "content_sanskrit": "न्वमप्यनेन कौन्तेय निबातकवचान्रणे।\nविजेता युधि विक्रम्य पुरेव मघवा वशी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2024885, "chapter_id": 1532, "verse_number": "३-१७०-२४", "content_sanskrit": "अयंच शङ्खप्रवरो येन जेतासि दानवान्।\nअनेन विजिता लोका शक्रेणापि महात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2024886, "chapter_id": 1532, "verse_number": "३-१७०-२५", "content_sanskrit": "प्रदीयमानं देवैस्तं देवदत्तं जलोद्भवम्।\nप्रत्यगृह्णां जयायैनं स्तूयमानस्तदाऽमरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2024887, "chapter_id": 1532, "verse_number": "३-१७०-२६", "content_sanskrit": "स शङ्खी कवची वाणी प्रगृहीतशरासनः।\nदानवालयमत्युग्रं प्रयातोस्मि युयुत्सया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2024888, "chapter_id": 1532, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि निवातकवचयुद्धपर्वणि सप्तत्यधिकशततमोऽध्यायः ॥ १७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]