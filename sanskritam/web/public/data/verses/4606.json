[{"id": 2168069, "chapter_id": 4606, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2168070, "chapter_id": 4606, "verse_number": "१", "content_sanskrit": "धृष्टद्युम्नं कृपो राजन् वारयामास संयुगे ।\nयथा दृप्तं वने सिंहं शरभो वारयेद् युधि\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2168071, "chapter_id": 4606, "verse_number": "२", "content_sanskrit": "निरुद्धः पार्षतस्तेन गौतमेन बलीयसा ।\nपदात् पदं विचलितुं नाशकत् तत्र भारत\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2168072, "chapter_id": 4606, "verse_number": "३", "content_sanskrit": "गौतमस्य रथं दृष्ट्वा धृष्टद्युम्नरथं प्रति ।\nवित्रेसुः सर्वभूतानि क्षयं प्राप्तं च मेनिरे\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2168073, "chapter_id": 4606, "verse_number": "४", "content_sanskrit": "तत्र जल्पन्ति पाण्डूनां रथिनः सादिनस्तथा\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2168074, "chapter_id": 4606, "verse_number": "", "content_sanskrit": "पाण्डुसैनिकाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2168075, "chapter_id": 4606, "verse_number": "५", "content_sanskrit": "द्रोणस्य निधनान्नूनं सङ्क्रुद्धो द्विपदां वरः ।\nशारद्वतो महातेजा दिव्यास्त्रविदुदारधीः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2168076, "chapter_id": 4606, "verse_number": "६", "content_sanskrit": "अपि स्वस्ति भवेदद्य धृष्टद्युम्नस्य गौतमात् ।\nअपीयं वाहिनी कृत्स्ना मुच्येत महतो भयात्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2168077, "chapter_id": 4606, "verse_number": "७", "content_sanskrit": "अप्ययं ब्राह्मणः सर्वान् न नो हन्यात् समागतान्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2168078, "chapter_id": 4606, "verse_number": "८", "content_sanskrit": "यादृशं दृश्यते रूपमन्तकप्रतिमं रणे ।\nगमिष्यत्यद्य पदवीं भारद्वाजस्य गौतमः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2168079, "chapter_id": 4606, "verse_number": "९", "content_sanskrit": "आचार्यः क्षिप्रहस्तश्च विजयी च सदा युधि ।\nअस्त्रवान् वीर्यसम्पन्नः क्रोधेन च समन्वितः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2168080, "chapter_id": 4606, "verse_number": "१०", "content_sanskrit": "पार्षतश्च महायुद्धे विमुखोऽद्यापि लक्ष्यते\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2168081, "chapter_id": 4606, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2168082, "chapter_id": 4606, "verse_number": "११", "content_sanskrit": "इत्येवं विविधा वाचो व्यश्रूयन्त रणाजिरे ।\nव्यश्रूयन्त महाराज तयोस्तत्र समागमे\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2168083, "chapter_id": 4606, "verse_number": "१२", "content_sanskrit": "विनिश्वस्य ततः क्रोधात् कृपः शारद्वतो नृप ।\nपार्षतं छादयामास निश्चेष्टं शरवृष्टिभिः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2168084, "chapter_id": 4606, "verse_number": "१३", "content_sanskrit": "स वध्यमानः समरे गौतमेन महात्मना ।\nकर्तव्यं नाभिजज्ञे वै मोहेन महता वृतः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2168085, "chapter_id": 4606, "verse_number": "१४", "content_sanskrit": "तमब्रवीत् ततो यन्ता कच्चित् क्षेमं नु मारिष ।\nईदृशं व्यसनं युद्धे न मे दृष्टं कदाचन\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2168086, "chapter_id": 4606, "verse_number": "१५", "content_sanskrit": "दैवयोगादिमे बाणा न जघ्नुर्मर्म चाहवे ।\nप्रेषिता द्विजमुख्येन मर्माण्युद्दिश्य सर्वशः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2168087, "chapter_id": 4606, "verse_number": "१६", "content_sanskrit": "व्यावर्तये तव रथं नदीवेगमिवाहवात् ।\nअवध्यं ब्राह्मणं मन्ये येन ते विक्रमो हतः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2168088, "chapter_id": 4606, "verse_number": "१७", "content_sanskrit": "धृष्टद्युम्नस्ततो राजन् शनकैरब्रवीद् वचः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2168089, "chapter_id": 4606, "verse_number": "", "content_sanskrit": "धृष्टद्युम्नः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2168090, "chapter_id": 4606, "verse_number": "१८", "content_sanskrit": "मुह्यते मे मनस्तात गात्रस्वेदश्च जायते ।\nवेपथुश्च क्लमश्चैव रोमहर्षश्च जायते\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2168091, "chapter_id": 4606, "verse_number": "१९", "content_sanskrit": "ब्राह्मणं वर्जयन् युद्धे शनैर्याहि यतोऽच्युतौ\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2168092, "chapter_id": 4606, "verse_number": "२०", "content_sanskrit": "अर्जुनं भीमसेनं वा समरे प्राप्य सारथे ।\nक्षेममद्य भवेन्मह्यमिति मे नैष्ठिकी मतिः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2168093, "chapter_id": 4606, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2168094, "chapter_id": 4606, "verse_number": "२१", "content_sanskrit": "ततः प्रायान्महाराज सारथिस्त्वरयन् हयान् ।\nयतो भीमो महेष्वासो युयुधे तव सैनिकैः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2168095, "chapter_id": 4606, "verse_number": "२२", "content_sanskrit": "प्रद्रुतं तु रथं दृष्ट्वा धृष्टद्युम्नस्य मारिष ।\nकिरन् शरशतान्येव गौतमोऽनुययौ तदा\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2168096, "chapter_id": 4606, "verse_number": "२३", "content_sanskrit": "शङ्खं च पूरयामास मुहुर्मुहुररिन्दमः ।\nपार्षतं द्रावयामास महेन्द्र इव शम्बरम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2168097, "chapter_id": 4606, "verse_number": "२४", "content_sanskrit": "शिखण्डिनं तु समरे भीष्ममृत्युं दुरासदम् ।\nहार्दिक्यो वारयामास स्मयन्निव मुहुर्मुहुः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2168098, "chapter_id": 4606, "verse_number": "२५", "content_sanskrit": "शिखण्डी तु समासाद्य हृदिकानां महारथम् ।\nपञ्चभिर्निशितैर्भल्लैर्जत्रुदेशे समर्पयत्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2168099, "chapter_id": 4606, "verse_number": "२६", "content_sanskrit": "कृतवर्मा तु सङ्क्रुद्धो विद्ध्वा षष्टिभिराशुगैः ।\nधनुरेकेन चिच्छेद स्मयन्निव महारथः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2168100, "chapter_id": 4606, "verse_number": "२७", "content_sanskrit": "अथान्यद् धनुरादाय द्रुपदस्यात्मजो बली ।\nतिष्ठ तिष्ठेति सङ्क्रुद्धः हार्दिक्यं प्रत्यभाषत\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2168101, "chapter_id": 4606, "verse_number": "२८", "content_sanskrit": "ततोऽस्य नवतिं बाणान् रुग्मपुङ्खान् सुतेजसः ।\nप्रेषयामास समरे तेऽस्याभ्रश्यन्त वर्मणा\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2168102, "chapter_id": 4606, "verse_number": "२९", "content_sanskrit": "वितथांस्तान् समालक्ष्य पतितांश्च महीतळे ।\nक्षुरप्रेण सुतीक्ष्णेन सोऽच्छिनत् कार्मुकं दृढम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2168103, "chapter_id": 4606, "verse_number": "३०", "content_sanskrit": "अथैनं छिन्नधन्वानं भग्नशृङ्गमिवर्षभम् ।\nअशीत्या मार्गणैः क्रुद्धो बाह्वोरुरसि चार्पयत्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2168104, "chapter_id": 4606, "verse_number": "३१", "content_sanskrit": "कृतवर्मा तु सङ्क्रुद्धो मार्गणैः क्षतविक्षतः ।\nसुस्राव रुधिरं गात्रैः कुम्भवक्त्रादिवोदकम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2168105, "chapter_id": 4606, "verse_number": "३२", "content_sanskrit": "रुधिरेण परिक्लिन्नः कृतवर्मा व्यरोचत ।\nवर्षेण क्लेदितो राजन् यथा गैरिकपर्वतः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2168106, "chapter_id": 4606, "verse_number": "३३", "content_sanskrit": "अथान्यद् धनुरादाय समार्गणगणं ततः ।\nशिखण्डिनं त्रिभिर्बाणैः स्कन्धदेशेऽभ्यताडयत्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2168107, "chapter_id": 4606, "verse_number": "३४", "content_sanskrit": "स्कन्धदेशे स्थितैर्बाणैः शिखण्डी तु व्यराजत ।\nशाखाप्रशाखैर्विमलैः सुमहान् वै यथा द्रुमः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2168108, "chapter_id": 4606, "verse_number": "३५", "content_sanskrit": "तावन्योन्यं रणे विद्ध्वा रुधिरेण समुक्षितौ ।\n(पोप्लयमानौ हि यथा महान्तौ शोणितौ ह्रदौ\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2168109, "chapter_id": 4606, "verse_number": "३६", "content_sanskrit": "तद्वद्विरेजतुर्वीरौ शोणितेन परिप्लुतौ ।\nयथा च किंशुकौ फुल्लौ पुष्पमासेऽभ्युपागते\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2168110, "chapter_id": 4606, "verse_number": "३७", "content_sanskrit": "रुधिरोक्षितसर्वाङ्गौ रक्तचन्दनरूषितौ ।\nभुजगाविव सङ्क्रुद्धौ रेजतुस्तौ नरोत्तमौ\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2168111, "chapter_id": 4606, "verse_number": "३८", "content_sanskrit": "तावुभौ शरनुन्नाङ्गौ परस्परशरक्षतौ ।\nअन्योन्यशृङ्गाभिहतौ रेजतुर्वृषभाविव\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2168112, "chapter_id": 4606, "verse_number": "३९", "content_sanskrit": "अन्योन्यस्य वधे यत्नं कुर्वाणौ तौ महारथौ ।)\nरथाभ्यां चेरतुस्तत्र मण्डलानि सहस्रशः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2168113, "chapter_id": 4606, "verse_number": "४०", "content_sanskrit": "कृतवर्मा महाराज पार्षतं निशितैः शरैः ।\nरणे विव्याध सप्तत्या स्वर्णपुङ्खैः शिलाशितैः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2168114, "chapter_id": 4606, "verse_number": "४१", "content_sanskrit": "ततोऽस्य समरे बाणं भोजः प्रहरतां वरः ।\nजीवितान्तकरं घोरं व्यसजृत् त्वरयाऽन्वितः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2168115, "chapter_id": 4606, "verse_number": "४२", "content_sanskrit": "स तेनाभिहतो राजन् मूर्च्छयाऽभिपरिप्लुतः ।\nध्वजयष्टिं च सहसा शिश्रिये कश्मलावृतः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2168116, "chapter_id": 4606, "verse_number": "४३", "content_sanskrit": "अपोवाह रणात् तं तु सारथी रथिनां वरम् ।\nहार्दिक्यशरसन्तप्तं निःश्वसन्तं पुनः पुनः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2168117, "chapter_id": 4606, "verse_number": "४४", "content_sanskrit": "पराजिते तत्र शूरे द्रुपदस्य सुते प्रभो ।\nप्राद्रवत् पाण्डवी सेना वध्यमाना समन्ततः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2168118, "chapter_id": 4606, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां कर्णपर्वणि षड्विंशोऽध्यायः ॥२६॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]