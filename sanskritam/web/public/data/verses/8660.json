[{"id": 900008630, "chapter_id": 8660, "verse_number": "41.1", "content_sanskrit": "पूर्वेणोक्ते समन्वयेऽनेन विरोधः परिह्रियत ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900008631, "chapter_id": 8660, "verse_number": "41.2", "content_sanskrit": "अन्ये तु", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900008632, "chapter_id": 8660, "verse_number": "41.3", "content_sanskrit": "अत्र लौकिकार्थविषयाऽऽप्तवाक्यरूपस्मृत्यविरोध उच्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900008633, "chapter_id": 8660, "verse_number": "41.4", "content_sanskrit": "पूर्वपक्षमाह", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900008634, "chapter_id": 8660, "verse_number": "41.5", "content_sanskrit": "सिद्धान्ते त्वयं भावः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900008635, "chapter_id": 8660, "verse_number": "41.6", "content_sanskrit": "यदुक्तमुभाभ्यां वेदान्तानां ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}]