[{"id": 2002100, "chapter_id": 1042, "verse_number": "१-४३-०x", "content_sanskrit": "तक्षक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2002101, "chapter_id": 1042, "verse_number": "१-४३-१", "content_sanskrit": "यदि दष्टं मयेह त्वं शक्तः किंचिच्चिकित्सितुम्।\nततो वृक्षं मया दष्टमिमं जीवय काश्यप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2002102, "chapter_id": 1042, "verse_number": "१-४३-२", "content_sanskrit": "परं मन्त्रबलं यत्ते तद्दर्शय यतस्व च।\nन्यग्रोधमेनं धक्ष्यामि पश्यतस्ते द्विजोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2002103, "chapter_id": 1042, "verse_number": "१-४३-३x", "content_sanskrit": "काश्यप उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2002104, "chapter_id": 1042, "verse_number": "१-४३-३", "content_sanskrit": "दश नागेन्द्र वृक्षं त्वं यद्येतदभिमन्यसे।\nअहमेनं त्वया दष्टं जीवयिष्ये भुजंगम।\nपश्य मन्त्रबलं मेऽद्य न्यग्रोधं दश पन्नग॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2002105, "chapter_id": 1042, "verse_number": "१-४३-४x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2002106, "chapter_id": 1042, "verse_number": "१-४३-४", "content_sanskrit": "एवमुक्तः स नागेन्द्रः काश्यपेन महात्मना।\nअदशद्वृक्षमभ्येत्य न्यग्रोधं पन्नगोत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2002107, "chapter_id": 1042, "verse_number": "१-४३-५", "content_sanskrit": "स वृक्षस्तेन दष्टस्तु पन्नगेन महात्मना।\nआशीविषविषोपेतः प्रजज्वाल समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2002108, "chapter_id": 1042, "verse_number": "१-४३-६", "content_sanskrit": "तं दग्ध्वा स नगं नागः काश्यपं पुनरब्रवीत्।\nकुरु यत्नं द्विजश्रेष्ठ जीवयैव वनस्पतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2002109, "chapter_id": 1042, "verse_number": "१-४३-७x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2002110, "chapter_id": 1042, "verse_number": "१-४३-७", "content_sanskrit": "भस्मीभूतं ततो वृक्षं पन्नगेन्द्रस्य तेजसा।\nभस्म सर्वं समाहृत्य काश्यपो वाक्यमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2002111, "chapter_id": 1042, "verse_number": "१-४३-८", "content_sanskrit": "विद्याबलं पन्नगेन्द्र पश्य मेऽद्य वनस्पतौ।\nअहं संजीवयाम्येनं पश्यतस्ते भुजंगम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2002112, "chapter_id": 1042, "verse_number": "१-४३-९", "content_sanskrit": "ततः स भगवान्विद्वान्काश्यपो द्विजसत्तमः।\nभस्मराशीकृतं वृक्षं विद्यया समजीवयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2002113, "chapter_id": 1042, "verse_number": "१-४३-१०", "content_sanskrit": "अङ्कुरं कृतवांस्तत्र ततः पर्णद्वयान्वितम्।\nपलाशिनं शाखिनं च तथा विटपिनं पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2002114, "chapter_id": 1042, "verse_number": "१-४३-११", "content_sanskrit": "तं दृष्ट्वा जीवितं वृक्षं काश्यपेन महात्मना।\nउवाच तक्षको ब्रह्मन्नैतदत्यद्भुतं त्वयि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2002115, "chapter_id": 1042, "verse_number": "१-४३-१२", "content_sanskrit": "द्विजेन्द्र यद्विषं हन्या मम वा मद्विधस्य वा।\nकं त्वमर्थमभिप्रेप्सुर्यासि तत्र तपोधन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2002116, "chapter_id": 1042, "verse_number": "१-४३-१३", "content_sanskrit": "यत्तेऽभिलषितं प्राप्तं फलं तस्मान्नृपोत्तमात्।\nअहमेव प्रदास्यामि तत्ते यद्यपि दुर्लभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2002117, "chapter_id": 1042, "verse_number": "१-४३-१४", "content_sanskrit": "विप्रशापाभिभूते च क्षीणायुषि नराधिपे।\nघटमानस्य ते विप्र सिद्धिः संशयिता भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2002118, "chapter_id": 1042, "verse_number": "१-४३-१५", "content_sanskrit": "ततो यशः प्रदीप्तं ते त्रिषु लोकेषु विश्रुतम्।\nनिरंशुरिव घर्मांशुरन्तर्धानमितो व्रजेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2002119, "chapter_id": 1042, "verse_number": "१-४३-१६x", "content_sanskrit": "काश्यप उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2002120, "chapter_id": 1042, "verse_number": "१-४३-१६", "content_sanskrit": "धनार्थी याम्यहं तत्र तन्मे देहि भुजंगम।\nततोऽहं विनिवर्तिष्ये स्वापतेयं प्रगृह्य वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2002121, "chapter_id": 1042, "verse_number": "१-४३-१७x", "content_sanskrit": "तक्षक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2002122, "chapter_id": 1042, "verse_number": "१-४३-१७", "content_sanskrit": "यावद्धनं प्रार्थयसे तस्माद्राज्ञस्ततोऽधिकम्।\nअहमेव प्रदास्यामि निवर्तस्व द्विजोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2002123, "chapter_id": 1042, "verse_number": "१-४३-१८x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2002124, "chapter_id": 1042, "verse_number": "१-४३-१८", "content_sanskrit": "तक्षकस्य वचः श्रुत्वा काश्यपो द्विजसत्तमः।\nप्रदध्यौ सुमहातेजाराजानं प्रति बुद्धिमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2002125, "chapter_id": 1042, "verse_number": "१-४३-१९", "content_sanskrit": "दिव्यज्ञानः स तेजस्वी ज्ञात्वा तं नृपतिं तदा।\nक्षीणायुषं पाण्डवेयमपावर्तत काश्यपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2002126, "chapter_id": 1042, "verse_number": "१-४३-२०", "content_sanskrit": "लब्ध्वा वित्तं मुनिवरस्तक्षकाद्यावदीप्सितम्।\nनिवृत्ते काश्यपे तस्मिन्समयेन महात्मनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2002127, "chapter_id": 1042, "verse_number": "१-४३-२१", "content_sanskrit": "जगाम तक्षकस्तूर्णं नगरं नागसाह्वयम्।\nअथ शुश्राव गच्छन्स तक्षको जगतीपतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2002128, "chapter_id": 1042, "verse_number": "१-४३-२२", "content_sanskrit": "मन्त्रैर्विषहरैर्दिव्यै रक्ष्यमाणं प्रयत्नतः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2002129, "chapter_id": 1042, "verse_number": "१-४३-२२x", "content_sanskrit": "सौतिरुवाच।\nस चिन्तयामास तदा मायायोगेन पार्थिवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2002130, "chapter_id": 1042, "verse_number": "१-४३-२३", "content_sanskrit": "मया वञ्चयितव्योऽसौ क उपायो भवेदिति।\nततस्तापसरूपेण प्राहिणोत्स भुजंगमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2002131, "chapter_id": 1042, "verse_number": "१-४३-२४", "content_sanskrit": "फलपत्रोदकं गृह्य राज्ञे नागोऽथ तक्षकः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2002132, "chapter_id": 1042, "verse_number": "१-४३-२४x", "content_sanskrit": "तक्षक उवाच।\nगच्छध्वं यूयमव्यग्रा राजानं कार्यवत्तया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2002133, "chapter_id": 1042, "verse_number": "१-४३-२५", "content_sanskrit": "फलपत्रोदकं नागाः प्रतिग्राहयितुं नृपम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2002134, "chapter_id": 1042, "verse_number": "१-४३-२५x", "content_sanskrit": "सौतिरुवाच।\nते तक्षकसमादिष्टास्तथा चक्रुर्भुजङ्गमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2002135, "chapter_id": 1042, "verse_number": "१-४३-२६", "content_sanskrit": "उपनिन्युस्तथा राज्ञे दर्भानम्भः फलानि च।\nतच्च सर्वं स राजेन्द्रः प्रतिजग्राह वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2002136, "chapter_id": 1042, "verse_number": "१-४३-२७", "content_sanskrit": "कृत्वा तेषां च कार्याणि गम्यतामित्युवाच तान्।\nगतेषु तेषु नागेषु तापसच्छद्मरूपिषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2002137, "chapter_id": 1042, "verse_number": "१-४३-२८", "content_sanskrit": "अमात्यान्सुहृदश्चैव प्रोवाच स नराधिपः।\nभक्षयन्तु भवन्तो वै स्वादूनीमानि सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2002138, "chapter_id": 1042, "verse_number": "१-४३-२९", "content_sanskrit": "तापसैरुपनीतानि फलानि सहिता मया।\nततो राजा ससचिवः फलान्यादातुमैच्छत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2002139, "chapter_id": 1042, "verse_number": "१-४३-३०", "content_sanskrit": "विधिना संप्रयुक्तो वै ऋषिवाक्येन तेन तु।\nयस्मिन्नेव फले नागस्तमेवाभक्षयत्स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2002140, "chapter_id": 1042, "verse_number": "१-४३-३१", "content_sanskrit": "ततो भक्षयतस्तस्य फलात्कृमिरभूदणुः।\nह्रस्वकः कृष्णनयनस्ताम्रवर्णोऽथ शौनक॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2002141, "chapter_id": 1042, "verse_number": "१-४३-३२", "content_sanskrit": "स तं गृह्य नृपश्रेष्ठः सचिवानिदमब्रवीत्।\nअस्तमभ्येति सविता विषादद्य न मे भयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2002142, "chapter_id": 1042, "verse_number": "१-४३-३३", "content_sanskrit": "सत्यवागस्तु स मुनिः कृमिर्मां दशतामयम्।\nतक्षको नाम भूत्वा वै तथा परिहृतं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2002143, "chapter_id": 1042, "verse_number": "१-४३-३४", "content_sanskrit": "ते चैनमन्ववर्तन्त मन्त्रिणः कालचोदिताः।\nएवमुक्त्वा स राजेन्द्रो ग्रीवायां सन्निवेश्यह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2002144, "chapter_id": 1042, "verse_number": "१-४३-३५", "content_sanskrit": "कृमिकं प्राहसत्तूर्णं मुमूर्षुर्नष्टचेतनः।\nप्रहसन्नेव भोगेन तक्षकेणाभिवेष्टितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2002145, "chapter_id": 1042, "verse_number": "१-४३-३६", "content_sanskrit": "तस्मात्फलाद्विनिष्क्रम्य यत्तद्राज्ञे निवेदितम्।\nवेष्टयित्वा च भोगेन विनद्य च महास्वनम्।\nअदशत्पृथिवीपालं तक्षकः पन्नगेश्वरः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2002146, "chapter_id": 1042, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि आस्तीकपर्वणि त्रिचत्वारिंशोऽध्यायः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]