[{"id": 7001288000, "chapter_id": 21288, "verse_number": "३-२०-१", "content_sanskrit": "नन्दीश्वर उवाच ।\nअतः परं श्रुणु प्रीत्या हनुमच्चरितम्मुने ।\nयथा चकाराशु हरो लीलास्तद्रूपतो वराः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001288001, "chapter_id": 21288, "verse_number": "३-२०-२", "content_sanskrit": "चकार सुहितं प्रीत्या रामस्य परमेश्वराः ।\nतत्सर्वं चरितं विप्र शृणु सर्वसुखावहम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001288002, "chapter_id": 21288, "verse_number": "३-२०-३", "content_sanskrit": "एकस्मिन्समये शम्भुरद्भुतोतिकरः प्रभुः ।\nददर्श मोहिनीरूपं विष्णोस्स हि वसद्गुणः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001288003, "chapter_id": 21288, "verse_number": "३-२०-४", "content_sanskrit": "चक्रे स्वं क्षुभितं शम्भुः कामबाणहतो यथा ।\nस्वम्वीर्यम्पातयामास रामकार्यार्थमीश्वरः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001288004, "chapter_id": 21288, "verse_number": "३-२०-५", "content_sanskrit": "तद्वीर्यं स्थापयामासुः पत्रे सप्तर्षयश्च ते ।\nप्रेरिता मनसा तेन रामकार्यार्थ मादरात॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001288005, "chapter_id": 21288, "verse_number": "३-२०-६", "content_sanskrit": "तैर्गौतमसुतायां तद्वीर्यं शम्भोर्महर्षिभिः ।\nकर्णद्वारा तथांजन्यां रामकार्यार्थमाहितम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001288006, "chapter_id": 21288, "verse_number": "३-२०-७", "content_sanskrit": "ततश्च समये तस्माद्धनूमा निति नामभाक् ।\nशम्भुर्जज्ञे कपितनुर्महाबलपराक्रमः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001288007, "chapter_id": 21288, "verse_number": "३-२०-८", "content_sanskrit": "हनूमान्स कपीशानः शिशुरेव महाबलः ।\nरविबिम्बं बभक्षाशु ज्ञात्वा लघुफलम्प्रगे॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001288008, "chapter_id": 21288, "verse_number": "३-२०-९", "content_sanskrit": "देवप्रार्थनया तं सोऽत्यजज्ज्ञात्वा महाबलम् ।\nशिवावतारं च प्राप वरान्दत्तान्सुरर्षिभिः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001288009, "chapter_id": 21288, "verse_number": "३-२०-१०", "content_sanskrit": "स्वजनन्यन्तिकम्प्रागादथ सोतिप्रहर्षितः ।\nहनूमान्सर्वमाचख्यौ तस्यै तद्वृत्तमादरात्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001288010, "chapter_id": 21288, "verse_number": "३-२०-११", "content_sanskrit": "तदाज्ञया ततो धीरस्सर्वविद्यामयत्नतः ।\nसूर्यात्पपाठ स कपिर्गत्वा नित्यं तदान्तिकम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001288011, "chapter_id": 21288, "verse_number": "३-२०-१२", "content_sanskrit": "सूर्याज्ञया तदंशत्य सुग्रीवस्यान्तिकं ययौ ।\nमातुराज्ञामनुप्राप्य रुद्रांशः कपिसत्तमः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001288012, "chapter_id": 21288, "verse_number": "३-२०-१३", "content_sanskrit": "ज्येष्ठभ्रात्रा वालिना हि स्वस्त्रीभोक्त्रा तिरस्कृतः ।\nऋष्यमृकगिरौ तेन न्यवसत्स हनूमता॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001288013, "chapter_id": 21288, "verse_number": "३-२०-१४", "content_sanskrit": "ततोऽभूत्स सुकण्ठस्य मन्त्री कपिवरस्सुधीः ।\nसर्वथा सुहितं चक्रे सुग्रीवस्य हरांशजः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001288014, "chapter_id": 21288, "verse_number": "३-२०-१५", "content_sanskrit": "तत्रागतेन सभ्रात्रा हृतभार्येण दुःखिना ।\nकारयामास रामेण तस्य सख्यं सुखावहम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001288015, "chapter_id": 21288, "verse_number": "३-२०-१६", "content_sanskrit": "घातयामास रामश्च वालिनं कपिकुञ्जरम् ।\nभ्रातृपत्न्याश्च भोक्तारं पापिनम्वीरमानिनम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001288016, "chapter_id": 21288, "verse_number": "३-२०-१७", "content_sanskrit": "ततो रामाऽऽज्ञया तात हनूमान्वानरेश्वरः ।\nस सीतान्वेषणञ्चक्रे बहुभिर्वानरैस्सुधीः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001288017, "chapter_id": 21288, "verse_number": "३-२०-१८", "content_sanskrit": "ज्ञात्वा लङ्कागतां सीतां गतस्तत्र कपीश्वरः ।\nद्रुतमुल्लंघ्य सिंधुन्तमनिस्तीर्य्यं परैस्स वै॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001288018, "chapter_id": 21288, "verse_number": "३-२०-१९", "content_sanskrit": "चक्रेऽद्भुतचरित्रं स तत्र विक्रमसंयुतम् ।\nअभिज्ञानन्ददौ प्रीत्या सीतायै स्वप्रभोर्वरम्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001288019, "chapter_id": 21288, "verse_number": "३-२०-२०", "content_sanskrit": "सीताशोकं जहाराशु स वीरः कपिनायकः ।\nश्रावयित्वा रामवृत्तं तत्प्राणावनकारकम्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001288020, "chapter_id": 21288, "verse_number": "३-२०-२१", "content_sanskrit": "तदभिज्ञानमादाय निवृत्तो रामसन्निधिम् ।\nरावणाऽऽराममाहत्य जघान बहुराक्षसान्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001288021, "chapter_id": 21288, "verse_number": "३-२०-२२", "content_sanskrit": "तदेव रावणसुतं हत्वा सबहुराक्षसम् ।\nस महोपद्रवं चक्रे महोतिस्तत्र निर्भयः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001288022, "chapter_id": 21288, "verse_number": "३-२०-२३", "content_sanskrit": "यदा दग्धो रावणेनावगुंठ्य वसनानि च ।\nतैलाभ्यक्तानि सुदृढं महाबलवता मुने॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001288023, "chapter_id": 21288, "verse_number": "३-२०-२४", "content_sanskrit": "उत्प्लुत्योत्प्लुत्य च तदा महादेवांशजः कपिः ।\nददाह लंकां निखिलां कृत्वा व्याजन्तमेव हि॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001288024, "chapter_id": 21288, "verse_number": "३-२०-२५", "content_sanskrit": "दग्ध्वा लंकां वंचयित्वा विभीषणगृहं ततः ।\nअपतद्वारिधौ वीरस्ततस्स कपिकुञ्जरः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001288025, "chapter_id": 21288, "verse_number": "३-२०-२६", "content_sanskrit": "स्वपुच्छ तत्र निर्वाप्य प्राप तस्य परन्तटम् ।\nअखिन्नस्स ययौ रामसन्निधिं गिरिशांशजः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001288026, "chapter_id": 21288, "verse_number": "३-२०-२७", "content_sanskrit": "अविलंबेन सुजवो हनूमान् कपिसत्तमः ।\nरामोपकण्ठमागत्य ददौ सीताशिरोमणिम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001288027, "chapter_id": 21288, "verse_number": "३-२०-२८", "content_sanskrit": "ततस्तदाज्ञया वीरस्सिन्धौ सेतुमबन्धयत् ।\nवानरस्स समानीय बहून्गिरिवरान्बली॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001288028, "chapter_id": 21288, "verse_number": "३-२०-२९", "content_sanskrit": "गत्वा तत्र ततो रामस्तर्तुकामो यथा ततः ।\nशिवलिंगं समानर्च प्रतिष्ठाप्य जयेप्सया॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001288029, "chapter_id": 21288, "verse_number": "३-२०-३०", "content_sanskrit": "तद्वरात्स जयं प्राप्य वरं तीर्त्वोदधिं ततः ।\nलंकामावृत्य कपिभी रणं चक्रे स राक्षसैः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001288030, "chapter_id": 21288, "verse_number": "३-२०-३१", "content_sanskrit": "जघानाथासुरान्वीरो रामसैन्यं ररक्ष सः ।\nशक्ति क्षतं लक्ष्मणं च संजीविन्या ह्यजीवयत्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001288031, "chapter_id": 21288, "verse_number": "३-२०-३२", "content_sanskrit": "सर्वथा सुखिनं चक्रे सरामं लक्ष्मणं हि सः ।\nसर्वसैन्यं ररक्षासौ महादेवात्मजः प्रभुः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001288032, "chapter_id": 21288, "verse_number": "३-२०-३३", "content_sanskrit": "रावणं परिवाराढ्यं नाशयामास विश्रमः ।\nसुखीचकार देवान्स महाबलग्रहः कपि॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001288033, "chapter_id": 21288, "verse_number": "३-२०-३४", "content_sanskrit": "महीरावणसंज्ञं स हत्वा रामं सलक्ष्मणम् ।\nतत्स्थानादानयामास स्वस्थानम्परिपाल्य च॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001288034, "chapter_id": 21288, "verse_number": "३-२०-३५", "content_sanskrit": "रामकार्यं चकाराशु सर्वथा कपिपुंगवः ।\nअसुरान्नमयामास नानालीलां चकार च॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001288035, "chapter_id": 21288, "verse_number": "३-२०-३६", "content_sanskrit": "स्थापयामास भूलोके रामभक्तिं कपीश्वरः ।\nस्वयं भक्तवरो भूत्वा सीतारामसुखप्रदः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001288036, "chapter_id": 21288, "verse_number": "३-२०-३७", "content_sanskrit": "लक्ष्मणप्राणदाता च सर्वदेवमदापहः ।\nरुद्रावतारो भगवान्भक्तोद्धारकरस्स वै॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001288037, "chapter_id": 21288, "verse_number": "३-२०-३८", "content_sanskrit": "हनुमान्स महावीरो रामकार्यकरस्सदा ।\nरामदूताभिधो लोके दैत्यघ्नो भक्तवत्सलः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001288038, "chapter_id": 21288, "verse_number": "३-२०-३९", "content_sanskrit": "इति ते कथितं तात हनुमच्चरितम्वरम् ।\nधन्यं यशस्यमायुष्यं सर्वकामफलप्रदम्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001288039, "chapter_id": 21288, "verse_number": "३-२०-४०", "content_sanskrit": "य इदं शृणुयाद्भक्त्या श्रावयेद्वा समाहितः ।\nस भुक्त्वेहाखिलान्कामानन्ते मोक्षं लभेत्परम्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]