[{"id": 2069385, "chapter_id": 2453, "verse_number": "१०-५-०x", "content_sanskrit": "कृप उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2069386, "chapter_id": 2453, "verse_number": "१०-५-१", "content_sanskrit": "शुश्रूषुरपि दुर्मेधाः पुरुषोऽनियतेन्द्रियः।\nनालं वेदयितुं कृत्स्नौ धर्मार्थाविति मे मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2069387, "chapter_id": 2453, "verse_number": "१०-५-२", "content_sanskrit": "तथैव तावन्मेधावी विनयं यो न शिक्षते।\nन च किञ्चन जानाति सोऽपि धर्मार्थनिश्चयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2069388, "chapter_id": 2453, "verse_number": "१०-५-३", "content_sanskrit": "[चिरं ह्यपि जडः शूरः पण्डितं पर्युपास्य ह।\nन स धर्मान्विजानाति दर्वी सूपरसानिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2069389, "chapter_id": 2453, "verse_number": "१०-५-४", "content_sanskrit": "मुहूर्तमपि तं प्राज्ञः पण्डितं पर्युपास्य हि।\nक्षिप्रं धर्मान्विजानाति जिह्वा सूपरसानिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2069390, "chapter_id": 2453, "verse_number": "१०-५-५", "content_sanskrit": "शुश्रूषुस्त्वेव मेधावी पुरुषो नियतेन्द्रियः।\nजानीयादागमान्सर्वान्ग्राह्यं च न विरोधयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2069391, "chapter_id": 2453, "verse_number": "१०-५-६", "content_sanskrit": "अनयस्त्ववमानी यो दुरात्मा पापपूरुषः।\nदिष्टमुत्सृज्य कल्याणं करोति बहुपातकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2069392, "chapter_id": 2453, "verse_number": "१०-५-७", "content_sanskrit": "नाथवन्तं तु सुहृदः प्रतिषेधन्ति पातकात्।\nनिवर्तते तु लक्ष्मीवान्नालक्ष्मीवान्निवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2069393, "chapter_id": 2453, "verse_number": "१०-५-८", "content_sanskrit": "यथा ह्युच्चावचैर्वाक्यैः क्षिप्तचित्तो नियम्यते।\nतथैव सुहृदा शक्यो नशक्यस्त्ववसीदति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2069394, "chapter_id": 2453, "verse_number": "१०-५-९", "content_sanskrit": "तथैव सुहृदोऽप्राज्ञान्कुर्वाणान्कर्म पापकम्।\nप्राज्ञाः सम्प्रतिषेधन्ति यथाशक्ति पुनःपुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2069395, "chapter_id": 2453, "verse_number": "१०-५-१०", "content_sanskrit": "स कल्याणे मनः कृत्वा नियम्यात्मानमात्मना।\nकुरु मे वचनं तात येन पश्चान्न तप्स्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2069396, "chapter_id": 2453, "verse_number": "१०-५-११", "content_sanskrit": "न वधः पूज्यते लोके सुप्तानामिह धर्मतः।\nतथैव न्यस्तशस्त्राणां विमुक्तरथवाजिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2069397, "chapter_id": 2453, "verse_number": "१०-५-१२", "content_sanskrit": "ये व ब्रूयुस्तवास्मीति ये च स्युः शरणागताः।\nविमुक्तमूर्धजा ये च ये चापि हतवाहनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2069398, "chapter_id": 2453, "verse_number": "१०-५-१३", "content_sanskrit": "अद्य स्वप्स्यन्ति पाञ्चाला विमुक्तकवचा विभो।\nविश्वस्ता रजनीं सर्वे प्रेता इव विचेतसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2069399, "chapter_id": 2453, "verse_number": "१०-५-१४", "content_sanskrit": "यस्तेषां तदवस्थानां द्रुह्येत पुरुषोऽनृजुः।\nव्यक्तं स नरके मज्जेदगाधे विपुलेऽप्लुवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2069400, "chapter_id": 2453, "verse_number": "१०-५-१५", "content_sanskrit": "सर्वास्त्रविदुषां लोके श्रेष्ठस्त्वमसि विश्रुतः।\nन च ते जातु लोकेऽस्मिन्सुसूक्ष्ममपि किल्बिषम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2069401, "chapter_id": 2453, "verse_number": "१०-५-१६", "content_sanskrit": "त्वं पुनः सूर्यसङ्काशः श्वोभूत उदिते रवौ।\nप्रकाशे सर्वभूतानां विजेता युधि शात्रवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2069402, "chapter_id": 2453, "verse_number": "१०-५-१७", "content_sanskrit": "असम्भावितरूपं हि त्वयि कर्म विगर्हितम्।\nशुक्ले रक्तमिव न्यस्तं भवेदिति मतिर्मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2069403, "chapter_id": 2453, "verse_number": "१०-५-१८x", "content_sanskrit": "अश्वत्थामोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2069404, "chapter_id": 2453, "verse_number": "१०-५-१८", "content_sanskrit": "एवमेव यथाऽऽत्थ त्वमनुशाससि मातुल।\nतैस्तु पूर्वमयं सेतुः समन्ताद्विह्वलीकृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2069405, "chapter_id": 2453, "verse_number": "१०-५-१९", "content_sanskrit": "प्रत्यक्षं भूमिपालानां भवतां चापि सन्निधौ।\nन्यस्तशस्त्रो मम पिता धृष्टद्युम्नेन पातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2069406, "chapter_id": 2453, "verse_number": "१०-५-२०", "content_sanskrit": "कर्णश्च पतिते चक्रे उत्थास्यन्रथिनां वरः।\nउत्तमे व्यसने मग्नो हतो गाण्डीवधन्वना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2069407, "chapter_id": 2453, "verse_number": "१०-५-२१", "content_sanskrit": "तथा शान्तनवो भीष्मो न्यस्तशस्त्रो निरायुधः।\nशिखण्डिनं पुरस्कृत्य हतो गाण्डीवधन्वना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2069408, "chapter_id": 2453, "verse_number": "१०-५-२२", "content_sanskrit": "भूरिश्रवा महेष्वासस्तथा प्रायगतो रणे।\nक्रोशतां बूमिपालानां युयुधानेन पातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2069409, "chapter_id": 2453, "verse_number": "१०-५-२३", "content_sanskrit": "दुर्योधनश्च भीमेन समेत्य गदया मृधे।\nपश्यतां भूमिपालानामधर्मेण निपातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2069410, "chapter_id": 2453, "verse_number": "१०-५-२४", "content_sanskrit": "एकाकी बहुभिस्तत्र परिवार्य महारथैः।\nअधर्मेण नरव्याघ्रो भीमसेनेन पातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2069411, "chapter_id": 2453, "verse_number": "१०-५-२५", "content_sanskrit": "विलापो भग्नसक्थस्य यो मे राज्ञः परिश्रुतः।\nवादिकानां कथयतां स मे मर्माणि कृन्तति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2069412, "chapter_id": 2453, "verse_number": "१०-५-२६", "content_sanskrit": "एवं चाधार्मिकाः पापाः पाञ्चाला भिन्नसतवः।\nतानेवं भिन्नमर्यादान्किं भवान्न विगर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2069413, "chapter_id": 2453, "verse_number": "१०-५-२७", "content_sanskrit": "पितृहन्तॄनहं हत्वा पाञ्चालान्निशि सौप्तिके।\nकामं कीटः पतङ्गो वा जन्म प्राप्य भवामि वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2069414, "chapter_id": 2453, "verse_number": "१०-५-२८", "content_sanskrit": "त्वरे चाहमनेनाद्य यदिदं मे चिकीर्षितम्।\nतस्य मे त्वरमाणस्य कुतो निद्रा कुतः सुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2069415, "chapter_id": 2453, "verse_number": "१०-५-२९", "content_sanskrit": "न स जातः पुमाँल्लोके कश्चिन्न स भविष्यति।\nयो मे व्यावर्तयेदेतां वधे तेषां कृतां मतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2069416, "chapter_id": 2453, "verse_number": "१०-५-३०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2069417, "chapter_id": 2453, "verse_number": "१०-५-३०", "content_sanskrit": "एवमुक्त्वा महाराज द्रोणपुत्रः प्रतापवान्।\nएकान्ते योजयित्वाऽश्वान्प्रायादभिमुखः परान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2069418, "chapter_id": 2453, "verse_number": "१०-५-३१", "content_sanskrit": "तमब्रूतां महात्मानौ भोजशारद्वतावुभौ।\nकिमयं स्यन्दनो युक्तः किं च कार्यं चिकीर्षितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2069419, "chapter_id": 2453, "verse_number": "१०-५-३२", "content_sanskrit": "एकसामर्थप्रयातौ स्वस्त्वया सह नरर्षभ।\nसमदुःखसुखौ चापि तस्माच्छंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2069420, "chapter_id": 2453, "verse_number": "१०-५-३३", "content_sanskrit": "अश्वत्थामा तुं सङ्क्रुद्धः पितुर्वधमनुस्मरन्।\nताभ्यां तथ्यं तथाऽऽचख्यौ यदस्यात्मचिकीर्षितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2069421, "chapter_id": 2453, "verse_number": "१०-५-३४", "content_sanskrit": "हत्वा शतसहस्राणि योधानां निशितैः शरैः।\nन्यस्तशस्त्रो मम पिता धृष्टद्युम्नेन पातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2069422, "chapter_id": 2453, "verse_number": "१०-५-३५", "content_sanskrit": "तं तथैव वधिष्यामि न्यस्तवर्माणमद्य वै।\nपुत्रं पाञ्चालराजस्य पापं पापेन कर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2069423, "chapter_id": 2453, "verse_number": "१०-५-३६", "content_sanskrit": "तथा विनिहतः पापः पाञ्चाल्यः पशुवन्मया।\nशस्त्रेण विजिताँल्लोकान्नाप्नुयादिति मे मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2069424, "chapter_id": 2453, "verse_number": "१०-५-३७", "content_sanskrit": "क्षिप्रं सन्नद्वकवचौ सखङ्गावात्तकार्मुकौ।\nमामेवाद्य प्रतीक्षेतां रथवर्यौ परन्तपौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2069425, "chapter_id": 2453, "verse_number": "१०-५-३८", "content_sanskrit": "इत्युक्त्वा रथमास्थाय प्रायादभिमुखः परान्।\nतमन्वगात्कृपो राजन्कृतवर्मा च सात्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2069426, "chapter_id": 2453, "verse_number": "१०-५-३९", "content_sanskrit": "ते प्रयाता व्यरोचन्त परानभिमुखास्त्रयः।\nहूयमाना यथा यज्ञे समिद्धा हव्यवाहनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2069427, "chapter_id": 2453, "verse_number": "१०-५-४०", "content_sanskrit": "ययुश्च शिबिरं तेषां सम्प्रसुप्तजनं विभो।\nद्वारदेशमनुप्राप्य द्रौणिस्तस्थौ महारथः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2069428, "chapter_id": 2453, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सौप्तिकपर्वणि पञ्चमोऽध्यायः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]