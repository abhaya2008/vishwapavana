[{"id": 2074018, "chapter_id": 2563, "verse_number": "१२-६८-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2074019, "chapter_id": 2563, "verse_number": "१२-६८-१", "content_sanskrit": "पार्थिवेन विशेषेण किं कार्यमवशिष्यते।\nकथं रक्ष्यो जनपदः कथं वध्याश्च शत्रवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2074020, "chapter_id": 2563, "verse_number": "१२-६८-२", "content_sanskrit": "कथं चारान्प्रयुञ्जीत वर्णान्विश्वासयेत्कथम्।\nकथं भृत्यान्कथं दारान्कथं पुत्रांश्च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2074021, "chapter_id": 2563, "verse_number": "१२-६८-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2074022, "chapter_id": 2563, "verse_number": "१२-६८-३", "content_sanskrit": "राजवृत्तं महाराज शृणुष्वावहितोऽखिलम्।\nयत्कार्यं पार्थिवेनादौ पार्थिवप्रकृतेन वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2074023, "chapter_id": 2563, "verse_number": "१२-६८-४", "content_sanskrit": "आत्मा जेयः सदा राज्ञा ततो जेयाश्च शत्रवः।\nअजितात्मा नरपतिर्विजयेत कथं रिपून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2074024, "chapter_id": 2563, "verse_number": "१२-६८-५", "content_sanskrit": "एतावानात्मविजयः पञ्चवर्गविनिग्रहः।\nजितेन्द्रियो नरपतिर्बाधितुं शक्नुयाद्रिपुन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2074025, "chapter_id": 2563, "verse_number": "१२-६८-६", "content_sanskrit": "न्यसेत गुल्मान्दुर्गेषु सन्धौ च कुरुनन्दन।\nनगरोपवने चैव पुरोद्याने तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2074026, "chapter_id": 2563, "verse_number": "१२-६८-७", "content_sanskrit": "संस्थानेषु च सर्वेषु पुटेषु नगरस्य च।\nमध्ये च नरशार्दूल तथा राजनिवेशने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2074027, "chapter_id": 2563, "verse_number": "१२-६८-८", "content_sanskrit": "प्रणिर्धीश्च ततः कुर्याज्जडान्धबधिराकृतीन्।\nपुंसः परीक्षितान्प्राज्ञान्क्षुत्पिपासाश्रमक्षमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2074028, "chapter_id": 2563, "verse_number": "१२-६८-९", "content_sanskrit": "अमात्येषु च सर्वेषु मित्रेषु त्रिविधेषु च।\nपुत्रेषु च महाराज प्रणिदध्यात्समाहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2074029, "chapter_id": 2563, "verse_number": "१२-६८-१०", "content_sanskrit": "पुरे जनपदे चैव तथा सामन्तराजसु।\nयथा न विद्युरन्योन्यं प्रणिधेयास्तथा हि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2074030, "chapter_id": 2563, "verse_number": "१२-६८-११", "content_sanskrit": "चारांश्च विद्यात्प्रहितान्परेण भरतर्षभ।\nआपणेषु विहारेषु समवायेषु वीथिषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2074031, "chapter_id": 2563, "verse_number": "१२-६८-१२", "content_sanskrit": "आरामेषु तथोद्याने पण्डितानां समागमे।\nवेशेषु चत्वरे चैव सभास्वावसथेषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2074032, "chapter_id": 2563, "verse_number": "१२-६८-१३", "content_sanskrit": "एवं विहन्याच्चारेण परचारं विचक्षणः।\nचारे च विहते सर्वं हतं भवति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2074033, "chapter_id": 2563, "verse_number": "१२-६८-१४", "content_sanskrit": "यदा तु हीनं नृपतिर्विद्यादात्मानमात्मना।\nअमात्यैः सह संमन्त्र्य कुर्यात्सन्धिं बलीयसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2074034, "chapter_id": 2563, "verse_number": "१२-६८-१५", "content_sanskrit": "`विद्वांसः क्षत्रिया वैश्या ब्राह्मणाश्च बहुश्रुताः।\nदण्डनीतौ तु निष्पन्ना मन्त्रिणः पृथिवीपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2074035, "chapter_id": 2563, "verse_number": "१२-६८-१६", "content_sanskrit": "प्रष्टव्यो ब्राह्मणः पूर्वं नीतिशास्त्रस्य तत्ववित्।\nपश्चात्पृच्छेत भूपालः क्षत्रियं नीतिकोविदम्।\nवैश्यशूद्रौ तथा भूयः शास्त्रज्ञौ हितकारिणौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2074036, "chapter_id": 2563, "verse_number": "१२-६८-१७", "content_sanskrit": "अज्ञायमाने हीनत्वे सन्धिं कुर्यात्परेण वै।\nलिप्सुर्वा कंचिदेवार्थं त्वरमाणो विचक्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2074037, "chapter_id": 2563, "verse_number": "१२-६८-१८", "content_sanskrit": "गुणवन्तो महोत्साहा धर्मज्ञाः साधवश्च ये।\nसन्दधीत नृपस्तैश्च राष्ट्रं धर्मेण पालयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2074038, "chapter_id": 2563, "verse_number": "१२-६८-१९", "content_sanskrit": "उच्छिद्यमानमात्मानं ज्ञात्वा राजा महामतिः।\nपूर्वापकारिणो हन्याल्लोकद्विष्टांश्च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2074039, "chapter_id": 2563, "verse_number": "१२-६८-२०", "content_sanskrit": "यो नोपकर्तुं शक्नोति नापकर्तुं महीपतिः।\nन शक्यरूपश्चोद्धर्तुमुपेक्ष्यस्तादृशो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2074040, "chapter_id": 2563, "verse_number": "१२-६८-२१", "content_sanskrit": "यात्रां यायादविज्ञातमनाक्रन्दमनन्तरम्।\nव्यासक्तं च प्रमत्तं च दुर्बलं च विचक्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2074041, "chapter_id": 2563, "verse_number": "१२-६८-२२", "content_sanskrit": "यात्रामाज्ञापयेद्वीरः कल्यः पुष्टबलः सुखी।\nपूर्वं कृत्वा विधानं च यात्रायां नगरे तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2074042, "chapter_id": 2563, "verse_number": "१२-६८-२३", "content_sanskrit": "न च पश्यो भवेदस्य नृपो यश्चातिवीर्यवान्।\nहीनश्च बलवीर्याभ्यां कर्षयंस्तत्परो वसेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2074043, "chapter_id": 2563, "verse_number": "१२-६८-२४", "content_sanskrit": "राष्ट्रं च पीडयेत्तस्य शस्त्राग्निविषमूर्च्छनैः।\nअमात्यवल्लभानां च विवादांस्तस्य कारयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2074044, "chapter_id": 2563, "verse_number": "१२-६८-२५", "content_sanskrit": "वर्जनीयं सदा युद्धं राज्यकामेन धीमता।\nउपायैस्त्रिभिरादानमर्थस्याह बृहस्पतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2074045, "chapter_id": 2563, "verse_number": "१२-६८-२६", "content_sanskrit": "सान्त्वेन तु प्रदानेन भेदेन च नराधिप।\nयमर्थं शक्नुयात्प्राप्तुं तेन तुष्येत पण्डितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2074046, "chapter_id": 2563, "verse_number": "१२-६८-२७", "content_sanskrit": "आददीत बलिं चापि प्रजाभ्यः कुरुनन्दन।\nषङ्भागममितप्रज्ञस्तासामेवाभिगुप्तये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2074047, "chapter_id": 2563, "verse_number": "१२-६८-२८", "content_sanskrit": "दशाधर्मगतेभ्यो यद्वसु बह्वल्पमेव वा।\nतन्नाददीत सहसा पौराणां रक्षणाय वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2074048, "chapter_id": 2563, "verse_number": "१२-६८-२९", "content_sanskrit": "यथा पुत्रास्तथा पौरा द्रष्टव्यास्ते न संशयः।\nभक्तिश्चैषु न कर्तव्या व्यवहारप्रदर्शने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2074049, "chapter_id": 2563, "verse_number": "१२-६८-३०", "content_sanskrit": "श्रोतुं चैव न्यसेद्राजा प्राज्ञान्सर्वार्थदर्शिनः।\nव्यवहारेषु सततं तत्र राज्यं प्रतिष्ठितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2074050, "chapter_id": 2563, "verse_number": "१२-६८-३१", "content_sanskrit": "आकरे लवणे शुल्के तरे नागबले तथा।\nन्यसेदमात्यान्नृपतिः स्वाप्तान्वा पुरुषान्हितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2074051, "chapter_id": 2563, "verse_number": "१२-६८-३२", "content_sanskrit": "सम्यग्दण्डधरो नित्यं राजा धर्ममवाप्नुयात्।\nनृपस्य सततं दण्डः सम्यग्धर्मः प्रशस्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2074052, "chapter_id": 2563, "verse_number": "१२-६८-३३", "content_sanskrit": "वेदवेदाङ्गवित्प्राज्ञः सुतपस्वी नृपो भवेत्।\nदानशीलश्च सततं यज्ञशीलश्च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2074053, "chapter_id": 2563, "verse_number": "१२-६८-३४", "content_sanskrit": "एते गुणाः समस्ताः स्युर्नृपस्य सततं स्थिराः।\nव्यवहारस्य लोपेन कुतः स्वर्गः कुतो यशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2074054, "chapter_id": 2563, "verse_number": "१२-६८-३५", "content_sanskrit": "यदा तु पीडितो राजा भवेद्राज्ञा बलीयसा।\n[तदाभिसंश्रयेद्दुर्गं बुद्धिमान्पृथिवीपतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2074055, "chapter_id": 2563, "verse_number": "१२-६८-३६", "content_sanskrit": "विधावाक्रम्य मित्राणि विधानमुपकल्पयेत्।\nसामभेदान्विरोधार्थं विधानमुपकल्पयेत्॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2074056, "chapter_id": 2563, "verse_number": "१२-६८-३७", "content_sanskrit": "`त्रिधा तु कृत्वा मित्राणि विधानमुपकल्पयेत्।\nघोषान्न्यसेत मार्गेषु ग्रामानुत्थापयेदपि।\nप्रवेशयेच्च तान्सर्वाञ्शाखानगरकेष्वपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2074057, "chapter_id": 2563, "verse_number": "१२-६८-३८", "content_sanskrit": "ये गुप्ताश्चैव दुर्गाश्च देशास्तेषु प्रवेशयेत्।\nधनिनो बलमुख्यांश्च सान्त्वयित्वा पुनः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2074058, "chapter_id": 2563, "verse_number": "१२-६८-३९", "content_sanskrit": "सस्याभिहारं कुर्वीत स्वयमेव नराधिपः।\nअसंभवे प्रवेशस्य दाहयेदग्निना भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2074059, "chapter_id": 2563, "verse_number": "१२-६८-४०", "content_sanskrit": "क्षेत्रस्थेषु च सस्येषु शत्रोरुपजपेन्नरान्।\nविनाशयेद्वा तत्सर्वं बलेनाथ स्वकेन वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2074060, "chapter_id": 2563, "verse_number": "१२-६८-४१", "content_sanskrit": "नदीमार्गेषु च तथा संक्रमानवसादयेत्।\nजलं विस्रावयेत्सर्वमविस्राव्यं च दूषयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2074061, "chapter_id": 2563, "verse_number": "१२-६८-४२", "content_sanskrit": "तदात्वेनायतीभिश्च निवसेद्भूम्यनन्तरम्।\nप्रतिघातं परस्याजौ युद्धकालेऽप्युपस्थिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2074062, "chapter_id": 2563, "verse_number": "१२-६८-४३", "content_sanskrit": "दुर्गाणां चाभितो राजा मूलच्छेदं प्रकारयेत्।\nसर्वेषां क्षुद्रवृक्षाणां चैत्यवृक्षान्विवर्जयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2074063, "chapter_id": 2563, "verse_number": "१२-६८-४४", "content_sanskrit": "प्रवृद्धानां च वृक्षाणां शाखां प्रच्छेदयेत्तथा।\nचैत्यानां सर्वथा त्याज्यमपि पत्रस्य पातनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2074064, "chapter_id": 2563, "verse_number": "१२-६८-४५", "content_sanskrit": "`देवानामाश्रयाश्चैत्या यक्षराक्षसभोगिनाम्।\nपिशाचपन्नगानां च गन्धर्वाप्सरसामपि।\nरौद्राणां चैव भूतानां तस्मात्तान्परिवर्जयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2074065, "chapter_id": 2563, "verse_number": "१२-६८-४६", "content_sanskrit": "श्रूयते हि निकुम्भेन सौदासस्य बलं हतम्।\nमहेश्वरगणेशेन वाराणस्यां नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2074066, "chapter_id": 2563, "verse_number": "१२-६८-४७", "content_sanskrit": "प्रगण्डीः कारयेत्सम्यगाकाशजननीस्तदा।\nआपूरयेच्च परिखां स्थाणुनक्रझषाकुलाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2074067, "chapter_id": 2563, "verse_number": "१२-६८-४८", "content_sanskrit": "सङ्कटद्वारकाणि स्युरुच्छ्वासार्थं पुरस्य च।\nतेषां च द्वारवद्गुप्तिः कार्या सर्वात्मना भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2074068, "chapter_id": 2563, "verse_number": "१२-६८-४९", "content_sanskrit": "द्वारेषु च गुरूण्येव यन्त्राणि स्थापयेत्सदा।\nआरापयेच्छतघ्नीश्च स्वाधीनानि च कारयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2074069, "chapter_id": 2563, "verse_number": "१२-६८-५०", "content_sanskrit": "काष्ठानि चाभिहार्याणि तथा कूपांश्च खानयेत्।\nसंशोधयेत्तथा कूपान्कृतान्पूर्वपयोर्थिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2074070, "chapter_id": 2563, "verse_number": "१२-६८-५१", "content_sanskrit": "तृणच्छन्नानि वेश्मानि पङ्केनाथ प्रलेपयेत्।\nनिर्हरेच्च तृणं मासि चैत्रे वह्निभयात्पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2074071, "chapter_id": 2563, "verse_number": "१२-६८-५२", "content_sanskrit": "नक्तमेव च भक्तानि पाचयेत नराधिपः।\nन दिवा ज्वालयेदग्निं वर्जयित्वाऽऽग्निहोत्रिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2074072, "chapter_id": 2563, "verse_number": "१२-६८-५३", "content_sanskrit": "`यथासंभवशैलानि चैष्टकानि च कारयेत्।\nमृण्मयानि च कुर्वीत ज्ञात्वा देशं बलाबलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2074073, "chapter_id": 2563, "verse_number": "१२-६८-५४", "content_sanskrit": "कर्मारारिष्टशालासु ज्वलेदग्निः सुरक्षितः।\nगृहाणि च प्रवेश्यान्तर्विधेयः स्याद्धुताशनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2074074, "chapter_id": 2563, "verse_number": "१२-६८-५५", "content_sanskrit": "महादण्डश्च तस्य स्याद्यस्याग्निर्वै दिवा भवेत्।\nप्रघोषयेदथैवं च रक्षणार्थं पुरस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2074075, "chapter_id": 2563, "verse_number": "१२-६८-५६", "content_sanskrit": "भिक्षुकांश्चाक्रिकांश्चैव क्लीबोन्मत्तान्कुशीलवान्।\nबाह्यान्कुर्यान्नरश्रेष्ठ दोषाय स्युर्हि ते शठाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2074076, "chapter_id": 2563, "verse_number": "१२-६८-५७", "content_sanskrit": "चत्वरेष्वथ तीर्थेषु सभास्वावसथेषु च।\nयथार्थवर्णं प्रणिधिं कुर्यात्सर्वत्र पार्थिवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2074077, "chapter_id": 2563, "verse_number": "१२-६८-५८", "content_sanskrit": "विशालान्राजमार्गांश्च कारयेत नराधिपः।\nप्रपाश्च विपणीश्चैव यथोद्देशं समादिशेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2074078, "chapter_id": 2563, "verse_number": "१२-६८-५९", "content_sanskrit": "भाण्डागारायुधागारान्धान्यागारांश्च सर्वशः।\nअश्वागारान्गजागारान्बलाधिकरणानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2074079, "chapter_id": 2563, "verse_number": "१२-६८-६०", "content_sanskrit": "परिखाश्चैव कौरव्य प्रतोलीसङ्कटानि च।\nन जातु कश्चित्पश्येत गुह्यमेतद्युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2074080, "chapter_id": 2563, "verse_number": "१२-६८-६१", "content_sanskrit": "अर्थसंनिचयं कुर्याद्राजा परबलार्दितः।\nतैलं मधु घृतं सस्यमौषधानि च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2074081, "chapter_id": 2563, "verse_number": "१२-६८-६२", "content_sanskrit": "अङ्गारकुशमुञ्जानां पलाशशरवर्णिनाम्।\nयवसेन्धनदिग्धानां कारयेत च संचयान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2074082, "chapter_id": 2563, "verse_number": "१२-६८-६३", "content_sanskrit": "आयुधानां च सर्वेषां शक्त्यृष्टिप्रासचर्मणाम्।\nसंचयानेवमादीनां कारयेत नराधिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2074083, "chapter_id": 2563, "verse_number": "१२-६८-६४", "content_sanskrit": "औषधानि च सर्वाणि मूलानि च फलानि च।\nचतुर्विधांश्च वैद्यान्वै संगृह्णीयाद्विशेषठः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2074084, "chapter_id": 2563, "verse_number": "१२-६८-६५", "content_sanskrit": "नटांश्च नर्तकांश्चैव मल्लान्मायाविनस्तथा।\nशोभयेयुः पुरवरं मोदयेयुश्च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2074085, "chapter_id": 2563, "verse_number": "१२-६८-६६", "content_sanskrit": "यतः शङ्का भवेच्चापि भृत्यतोऽथापि मन्त्रितः।\nपौरेभ्यो नृपतेर्वापि स्वाधीनान्कारयेत तान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2074086, "chapter_id": 2563, "verse_number": "१२-६८-६७", "content_sanskrit": "कृते कर्माणि राजा तान्पूजयेद्धनसंचयैः।\nमाननेन यथार्हेण सान्त्वेन विविधेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2074087, "chapter_id": 2563, "verse_number": "१२-६८-६८", "content_sanskrit": "निर्वेदयित्वा तु परं हत्वा वा कुरुनन्दन।\nगतानृण्यो भवेद्राजा यथा शास्त्रे निदर्शितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2074088, "chapter_id": 2563, "verse_number": "१२-६८-६९", "content_sanskrit": "राज्ञा सप्तैव रक्ष्याणि तानि चैव निबोध मे।\nआत्माऽमात्याश्च कोशाश्च दण्डो मित्राणि चैव हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2074089, "chapter_id": 2563, "verse_number": "१२-६८-७०", "content_sanskrit": "तथा जनपदाश्चैव पुरं च कुरुनन्दन।\nएतत्सप्तात्मकं राज्यं परिपाल्यं प्रयत्नतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2074090, "chapter_id": 2563, "verse_number": "१२-६८-७१", "content_sanskrit": "षाङ्गुण्यं च त्रिवर्गं च त्रिवर्गपरमं तथा।\nयो वेत्ति पुरुषव्याघ्र स भुङ्क्ते पृथिवीमिमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2074091, "chapter_id": 2563, "verse_number": "१२-६८-७२", "content_sanskrit": "षाङ्गुण्यमिति यत्प्रोक्तं तन्निबोध युधिष्ठिर।\nसन्धायासनमित्येव यात्रासन्धानमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2074092, "chapter_id": 2563, "verse_number": "१२-६८-७३", "content_sanskrit": "विगृह्यासनमित्येव यात्रां संपरिगृह्य च।\nद्वैधीभावस्तथाऽन्येषां संश्रयोऽथ परस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2074093, "chapter_id": 2563, "verse_number": "१२-६८-७४", "content_sanskrit": "त्रिवर्गश्चापि यः प्रोक्तस्तमिहैकमनाः शृणु।\nक्षयः स्थानं च वृद्धिश्च त्रिवर्गः परमस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2074094, "chapter_id": 2563, "verse_number": "१२-६८-७५", "content_sanskrit": "`धर्मश्चार्थश्च कामश्च त्रिवर्गो वै सनातनः।\nमन्त्रश्चैव प्रभावश्च उत्साहश्चैव तान्त्रिकः।\nशक्तित्रयं समाख्यातं त्रिवर्गस्य च तत्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2074095, "chapter_id": 2563, "verse_number": "१२-६८-७६", "content_sanskrit": "कार्यं च कारणं चैव कर्ता च परिकीर्तितः।\nएतत्परतरं विद्यान्त्रिवर्गादपि भारत।\nसर्वेपां च क्षये राजन्यस्त्रिवर्गः सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2074096, "chapter_id": 2563, "verse_number": "१२-६८-७७", "content_sanskrit": "सत्वं रजस्तमश्चैव त्रिवर्गकरणं स्मृतम्।\nतेनात्यन्तविमुक्तश्च मुक्तः पुरुष उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2074097, "chapter_id": 2563, "verse_number": "१२-६८-७८", "content_sanskrit": "कार्यस्य सर्वथा नाशो मोक्ष इत्यभिधीयते।\nतेन मोक्षपरश्चैव देवदेवः पितामहः।\nतुष्ट्यर्थस्य त्रिवर्गस्य रक्षामाह पितामहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2074098, "chapter_id": 2563, "verse_number": "१२-६८-७९", "content_sanskrit": "जगतो लौकिकी यात्रा यत्र नित्यं प्रतिष्ठिता।\nधर्मोऽर्थश्चैव कामश्च सेवितव्याः स्वकालतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2074099, "chapter_id": 2563, "verse_number": "१२-६८-८०", "content_sanskrit": "`सेवा धर्मस्य कर्तव्या सततं भूरिवत्सरैः।\nपुरुषैर्नरशार्दूल तन्मूलाः सर्वथा क्रियाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2074100, "chapter_id": 2563, "verse_number": "१२-६८-८१", "content_sanskrit": "धर्मेण च महीपालश्चिरं रक्षति मेदिनीम्।\n`यः कश्चिद्धार्मिको राजा स विपन्नोऽपि भूपतिः।\nअर्थकामविहीनोऽपि चिरं पालयते महीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2074101, "chapter_id": 2563, "verse_number": "१२-६८-८२", "content_sanskrit": "अस्मिन्नर्थे हि द्वौ श्लोकौ गीतावङ्गिरसा स्वयम्।\nयादवीपुत्र भद्रं ते श्रोतुमर्हसि तावपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2074102, "chapter_id": 2563, "verse_number": "१२-६८-८३", "content_sanskrit": "कृत्वा कार्याणि धर्मेण सम्यक्संपाल्य मेदिनीम्।\nपालयित्वा तथा पौरान्परत्र सुखमेधते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2074103, "chapter_id": 2563, "verse_number": "१२-६८-८४", "content_sanskrit": "किं तस्य तपसा राज्ञः किंच तस्याध्वरैः कृतैः।\nसुपालिताः प्रजा यस्य सर्वधर्मकृदेव सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2074104, "chapter_id": 2563, "verse_number": "१२-६८-८५", "content_sanskrit": "श्लोकाश्चोशनसा गीतास्तान्निबोध युधिष्ठिर।\nदण्डनीतेश्च यन्मूलं त्रिवर्गस्य च भूपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2074105, "chapter_id": 2563, "verse_number": "१२-६८-८६", "content_sanskrit": "भार्गवाङ्गिरसं कर्म षोडशाङ्गं च यद्बलम्।\nविषं माया च दैवं च पौरुषं चात्मसिद्धये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2074106, "chapter_id": 2563, "verse_number": "१२-६८-८७", "content_sanskrit": "प्रागुदक्प्रवणं दुर्गं समासाद्य महीपतिः।\nत्रिवर्गत्रयसंपूर्णमुपादाय तमुद्वहेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2074107, "chapter_id": 2563, "verse_number": "१२-६८-८८", "content_sanskrit": "षट्पञ्च च विनिर्जित्य दश चाष्टौ च भूपतिः।\nत्रिवर्गैर्दशभिर्युक्तः सुरैरपि न जीर्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2074108, "chapter_id": 2563, "verse_number": "१२-६८-८९", "content_sanskrit": "न बुद्धिं परिगृह्णीत स्त्रीणां मूर्खजनस्य च।\nदैवोपहतबुद्धीनां ये च वेदैर्विवर्जिताः।\nन तेषां शृणुयाद्राजा बुद्धिस्तेषां पराङ्भुखी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2074109, "chapter_id": 2563, "verse_number": "१२-६८-९०", "content_sanskrit": "स्त्रीप्रधानानि राज्यानि विद्वद्भिर्वर्जितानि च।\nमूर्खामात्याग्नितप्तानि शुष्यन्ते जलबिन्दुवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2074110, "chapter_id": 2563, "verse_number": "१२-६८-९१", "content_sanskrit": "विद्वांसः प्रथिता ये च ये चाप्ताः सर्वकर्मसु।\nबुद्धेषु दृष्टकर्माणि तेषां च शृणुयान्नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2074111, "chapter_id": 2563, "verse_number": "१२-६८-९२", "content_sanskrit": "दैवं पुरुषकारं च त्रिवर्गं च समाश्रितः।\nदैवतानि च विप्रांश्च प्रणम्य विजयी भवेत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2074112, "chapter_id": 2563, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि अष्टषष्टिमोऽध्यायः॥ ६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}]