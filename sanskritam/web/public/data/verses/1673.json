[{"id": 2030722, "chapter_id": 1673, "verse_number": "३-३११-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2030723, "chapter_id": 1673, "verse_number": "३-३११-१", "content_sanskrit": "देवराजमनुप्राप्तं ब्राह्मणच्छद्मनाऽऽवृतम्।\nदृष्ट्वास्वागतमित्याह न बुबोधास्य मानसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2030724, "chapter_id": 1673, "verse_number": "३-३११-२", "content_sanskrit": "हिरण्यकण्ठीः प्रमदा ग्रामान्वा बहुगोकुलान्।\nकिं ददानीति तं विप्रमुवाचाधिरथिस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2030725, "chapter_id": 1673, "verse_number": "३-३११-३x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2030726, "chapter_id": 1673, "verse_number": "३-३११-३", "content_sanskrit": "हिरण्यकण्ठ्यः प्रमदा यच्चान्यत्प्रीतिवर्धनम्।\nनाह दत्तमिहेच्छामि तदर्थिभ्यः प्रदीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2030727, "chapter_id": 1673, "verse_number": "३-३११-४", "content_sanskrit": "यदेतत्सहजं वर्म कुण्डले च तवानघ।\nएतदुत्कृत्य मे देहि यदि सत्यव्रतो भवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2030728, "chapter_id": 1673, "verse_number": "३-३११-५", "content_sanskrit": "एतदिच्छाम्यहं भिक्षां त्वया दत्तां परंतप।\nएष मे सर्वलाभानां लाभः परमको मतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2030729, "chapter_id": 1673, "verse_number": "३-३११-६x", "content_sanskrit": "कर्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2030730, "chapter_id": 1673, "verse_number": "३-३११-६", "content_sanskrit": "अवनिं प्रमदा गाश्च निर्वापं बहुवार्षिकम्।\nतत्ते विप्र प्रदास्यामि न तु वर्म सकुण्डलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2030731, "chapter_id": 1673, "verse_number": "३-३११-७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2030732, "chapter_id": 1673, "verse_number": "३-३११-७", "content_sanskrit": "एवं बहुविधैर्वाक्यैर्वार्यमाणः स तु द्विजः।\nरकर्णेन भरतश्रेष्ठ नान्यं वरमयाचत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2030733, "chapter_id": 1673, "verse_number": "३-३११-८", "content_sanskrit": "सान्त्वितश्च यथाशक्ति पूजितश्च यथाविधि।\nन चान्यं स द्विजश्रेष्ठः कामयामास वै वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2030734, "chapter_id": 1673, "verse_number": "३-३११-९", "content_sanskrit": "यदा नान्य प्रवृणुते वरं वै द्विजसत्तमः।\n`विनाऽस् सहजं वर्म कुण्डले च विशांपते।\nतदैनमब्रवीद्भूयो राधेयः प्रहसन्निव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2030735, "chapter_id": 1673, "verse_number": "३-३११-१०", "content_sanskrit": "सहजं वर्म मे विप्र कुण्डले चामृतोद्भवे।\nतेनावध्योस्मि लोकेषु ततो नैतज्जहाम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2030736, "chapter_id": 1673, "verse_number": "३-३११-११", "content_sanskrit": "विशालं पृथिवीराज्यं क्षेमं निहतकण्टकम्।\nप्रतिगृह्णीष्व मत्तस्त्वं साधु ब्राह्मणपुङ्गव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2030737, "chapter_id": 1673, "verse_number": "३-३११-१२", "content_sanskrit": "कुण्डलाभ्यां विमुक्तोऽहंवर्मणा सहजेन च।\nदमनीयो भविष्यामि शत्रूणां द्विजसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2030738, "chapter_id": 1673, "verse_number": "३-३११-१२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2030739, "chapter_id": 1673, "verse_number": "३-३११-१३", "content_sanskrit": "यदन्यं न वरं वव्रे भगवान्पाकशासनः।\nततः प्रहस् कर्णस्तं पुनरित्यब्रवीद्वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2030740, "chapter_id": 1673, "verse_number": "३-३११-१४", "content_sanskrit": "विदितो देवदेवेश प्रागेवासि मम प्रभो।\nन तु न्याय्यं मया दातुं तव शक्र वृथा वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2030741, "chapter_id": 1673, "verse_number": "३-३११-१५", "content_sanskrit": "त्वं हि देवेश्वरः साक्षात्त्वया देयो वरो मम।\nअन्येषां चैव भूतानामीश्वरो ह्यसि भूतकृत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2030742, "chapter_id": 1673, "verse_number": "३-३११-१६", "content_sanskrit": "यदि दास्यामि ते देव कुण्डले कवचं तथा।\nवध्यतामुपयास्यामि त्वं च शक्रावहास्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2030743, "chapter_id": 1673, "verse_number": "३-३११-१७", "content_sanskrit": "तस्माद्विनिमयं कृत्वा कुण्डलेवर्म चोत्तमम्।\nहरस्व शक्रकामं मे न दद्यामहमन्यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2030744, "chapter_id": 1673, "verse_number": "३-३११-१८x", "content_sanskrit": "शक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2030745, "chapter_id": 1673, "verse_number": "३-३११-१८", "content_sanskrit": "विदितोऽहं रवेः पूर्वमायानेव तवान्तिकम्।\nतेन ते सर्वमाख्यातमेवमेतन्न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2030746, "chapter_id": 1673, "verse_number": "३-३११-१९", "content_sanskrit": "काममस्तु तथा तात तव कर्ण यथेच्छसि।\nवर्जयित्वा तु मे वज्रं प्रवृणीष्व यथेच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2030747, "chapter_id": 1673, "verse_number": "३-३११-२०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2030748, "chapter_id": 1673, "verse_number": "३-३११-२०", "content_sanskrit": "ततः कर्णः प्रहृष्टस्तु उपसंगम्य वासवम्।\nअमोघां शक्तिमभ्येत्य वव्रे सम्पूर्णमानसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2030749, "chapter_id": 1673, "verse_number": "३-३११-२१x", "content_sanskrit": "क्रण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2030750, "chapter_id": 1673, "verse_number": "३-३११-२१", "content_sanskrit": "वर्मणा कुण्डलाभ्यां च शक्तिं मे देहि वासव।\nअमोघां शत्रुसङ्घानां घातिनीं पृथनामुखे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2030751, "chapter_id": 1673, "verse_number": "३-३११-२२", "content_sanskrit": "ततः सञ्चिन्त्य मनसा मुहूर्तमिव वासवः।\nशक्त्यर्थं पृथिवीपाल कर्णं वाक्यमथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2030752, "chapter_id": 1673, "verse_number": "३-३११-२३", "content_sanskrit": "कुण्डले मे प्रयच्छस्व वर्म चैव शरीरजम्।\nगृहाण कर्ण शक्तिं त्वमनेन समयेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2030753, "chapter_id": 1673, "verse_number": "३-३११-२४", "content_sanskrit": "अमोघा हन्ति शतशः शत्रून्मम करच्युता।\nपुनश्च पाणिमभ्येति मम दैत्यान्विनिघ्नतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2030754, "chapter_id": 1673, "verse_number": "३-३११-२५", "content_sanskrit": "सेयं तव करप्राप्ता हत्वैरकं रिपुमूर्जितम्।\nगर्जन्तं प्रतपन्तं च मामेवैष्यति सूतज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2030755, "chapter_id": 1673, "verse_number": "३-३११-२५x", "content_sanskrit": "कर्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2030756, "chapter_id": 1673, "verse_number": "३-३११-२६", "content_sanskrit": "एकमेवाहमिच्छामि रिपुं हन्तुं महाहवे।\nगर्जन्तंप्रतपन्तं च यतो मम भयं भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2030757, "chapter_id": 1673, "verse_number": "३-३११-२७x", "content_sanskrit": "इन्द्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2030758, "chapter_id": 1673, "verse_number": "३-३११-२७", "content_sanskrit": "एकं हनिष्यसि रिपुं गर्जन्तं बलिनं रणे।\nत्वं तु यं प्रार्थयस्येकं रक्ष्यते स महात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2030759, "chapter_id": 1673, "verse_number": "३-३११-२८", "content_sanskrit": "यमाहुर्वेदविद्वांसो वराहमपराजितम्।\nनारायणमचिन्त्यं च तेन कृष्णेन रक्ष्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2030760, "chapter_id": 1673, "verse_number": "३-३११-२९x", "content_sanskrit": "कर्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2030761, "chapter_id": 1673, "verse_number": "३-३११-२९", "content_sanskrit": "`एवमेतद्यथाऽऽत्थ त्वं दानवानां निषूदन।\nवधिष्यामि रणे शत्रुं यो मे स्थाता पुरस्सरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2030762, "chapter_id": 1673, "verse_number": "३-३११-३०", "content_sanskrit": "एवमप्यस्तु भगवन्नेकवीरवधे मम।\nअमोघां देहि मे शक्तिं यथा हन्यां प्रतापिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2030763, "chapter_id": 1673, "verse_number": "३-३११-३१", "content_sanskrit": "उत्कृत्य तु प्रदास्यामि कुण्डले कवचं च ते।\nनिकृत्तेषु तु गात्रेषु न मे बीभत्सता भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2030764, "chapter_id": 1673, "verse_number": "३-३११-३२x", "content_sanskrit": "इन्द्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2030765, "chapter_id": 1673, "verse_number": "३-३११-३२", "content_sanskrit": "न ते बीभत्सता कर्ण भविष्यति कथञ्चन।\nब्रणश्चैव न गात्रेषु यस्त्वं नानृतमिच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2030766, "chapter_id": 1673, "verse_number": "३-३११-३३", "content_sanskrit": "यादृशस्ते पितुर्वर्णस्तेजश्च वदतांवर।\nतादृशेनैव वर्णेन त्वं कर्ण भविता पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2030767, "chapter_id": 1673, "verse_number": "३-३११-३४", "content_sanskrit": "विद्यमानेषु शस्त्रेषु यद्यमोघामसंशये।\nप्रमत्तो मोक्ष्यसे चापि त्वय्येवैषा पतिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2030768, "chapter_id": 1673, "verse_number": "३-३११-३५x", "content_sanskrit": "कर्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2030769, "chapter_id": 1673, "verse_number": "३-३११-३५", "content_sanskrit": "संशयं परमं प्राप्य विमोक्ष्ये वासवीमिमाम्।\nयथा मामौत्थ शक्र त्वं सत्यमेतद्ब्रवीमि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2030770, "chapter_id": 1673, "verse_number": "३-३११-३६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2030771, "chapter_id": 1673, "verse_number": "३-३११-३६", "content_sanskrit": "ततः शक्तिं प्रज्वलितां प्रतिगृह् विशांपते।\nशस्त्रं गृहीत्वा निशितं सर्वगात्राण्यकृन्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2030772, "chapter_id": 1673, "verse_number": "३-३११-३७", "content_sanskrit": "ततो देवा मानवा दानवाश्च\nनिकृन्तन्तं कर्णमात्मानमेव।\nदृष्ट्वा सर्वे सिंहनादान्प्रणेदु-\nर्न ह्यस्यासीन्मुखजो वै विकारः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2030773, "chapter_id": 1673, "verse_number": "३-३११-३८", "content_sanskrit": "ततो दिव्या दुन्दुभयः प्रणेदुः\nपपातोच्चैः पुष्पवर्षं च दिव्यम्।\nदृष्ट्वा कर्णं शस्त्रसंकृत्तगात्रं\nमहुश्चापि स्मयमानं नृवीरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2030774, "chapter_id": 1673, "verse_number": "३-३११-३९", "content_sanskrit": "ततश्छित्त्वा कवचं दिव्यमङ्गा-\nत्तथैवार्द्रं प्रददौ वासवाय।\nतथोत्कृत्य प्रददौ कुण्डले ते\nकर्णात्तस्मात्कर्मणा तेन कर्णः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2030775, "chapter_id": 1673, "verse_number": "३-३११-४०", "content_sanskrit": "`ततो देवो मुदितो वज्रपाणि-\nर्दृष्ट्वा कर्णं शस्त्रनिकृत्तगात्रम्।\nततः शक्रः प्रहसन्वञ्चयित्वा\nकर्णं लोके यशसा योजयित्वा।\nकृतंकार्यं पाण्डवनां हि भेने\nततः पश्चाद्दिवमेवोत्पपात ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2030776, "chapter_id": 1673, "verse_number": "३-३११-४१", "content_sanskrit": "श्रुत्वा कर्णं मुषितं धार्तराष्ट्रा\nदीनाः सर्वे भग्नदर्पा इवासन्।\nतां रचावस्थां गमितं सूतपुत्रं\nश्रुत्वा पार्था जहृपुः काननस्थाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2030777, "chapter_id": 1673, "verse_number": "३-३११-४२x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2030778, "chapter_id": 1673, "verse_number": "३-३११-४२", "content_sanskrit": "क्वस्ता वीराः पाण्डवास्ते बभूवुः\nकुतश्चैते श्रुतवन्तः प्रियं तत्।\nकिं वाऽकार्षुर्द्वादशेऽब्दे व्यतीते\nतन्मे सर्वं भगवान्व्याकरोतु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2030779, "chapter_id": 1673, "verse_number": "३-३११-४३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2030780, "chapter_id": 1673, "verse_number": "३-३११-४३", "content_sanskrit": "लब्ध्वा कृष्णां सैन्धवं द्रावयित्वा\nविप्रैः सार्धं काम्यकादाश्रमात्ते।\nमार्कण्डेयाच्छ्रुतवन्तः पुराणं\nकदेवर्षीणआं चरितं विस्तरेण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2030781, "chapter_id": 1673, "verse_number": "३-३११-४४", "content_sanskrit": "`प्रत्याजग्मुः सरथाः सानुयात्राः\nसर्वैः सार्धं सूतपौरोगवैस्ते।\nततो ययुर्द्वैतवनं नृवीरा\nनिस्तीर्यैवं वनवासं समग्रम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2030782, "chapter_id": 1673, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि कुण्डलाहरणपर्वणि एकादशाधिकत्रिशततमोऽध्यायः ॥ ३११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}]