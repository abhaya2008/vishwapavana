    "audio_url": null,
    "display_order": 35,
    "avatarnika": ""
  },
  {
    "id": 20006917,
    "chapter_id": 6644,
    "verse_number": "14.36",
    "content_sanskrit": "स स्वहस्तकृतचिह्नशासनः पाकशासनसमानशासनः । आशशाङ्कतपनार्णवस्थितोर्विप्रसादकृत भूयसीर्भुवः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 36,
    "avatarnika": ""
  },
  {
    "id": 20006918,
    "chapter_id": 6644,
    "verse_number": "14.37",
    "content_sanskrit": "शुद्धमश्रुतिविरोधि बिभ्रतं शास्त्रमुज्ज्वलवर्णसङ्करैः । पुस्तकैः सममसौ गणं मुहुर्वाच्यमानमशृणोद्द्विजन्मनाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 37,
    "avatarnika": ""
  },
  {
    "id": 20006919,
    "chapter_id": 6644,
    "verse_number": "14.38",
    "content_sanskrit": "तत्प्रणीतमनसामुपेयुषां द्रष्टुमाहवनमग्रजन्मनाम् । आतिथेयमनिवारितातिथिः कर्तुमाश्रमगुरुः स नाश्रमत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 38,
    "avatarnika": ""
  },
  {
    "id": 20006920,
    "chapter_id": 6644,
    "verse_number": "14.39",
    "content_sanskrit": "मृग्यमाणमपि यद्दुरासदं भूरिसारमुपनीय तत्स्वयम् । आसतावसरकाङ्क्षिणो बहिस्तस्य रत्नमुपदीकृतं नृपाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 39,
    "avatarnika": ""
  },
  {
    "id": 20006921,
    "chapter_id": 6644,
    "verse_number": "14.40",
    "content_sanskrit": "एक एव वसु यद्ददौ नृपस्तत्समापकमतर्क्यत क्रतोः । त्यागशालिनि तपःसुते ययुः सर्वपार्थिवधनान्यपि क्षयम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 40,
    "avatarnika": ""
  },
  {
    "id": 20006922,
    "chapter_id": 6644,
    "verse_number": "14.41",
    "content_sanskrit": "प्रीतिरस्य ददतोऽभवत्तथा येन तत्प्रियचिकीर्षवो नृपाः । स्पर्शितैरधिकमागमन्मुदं नाधिवेश्म निहितैरुपायनैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 41,
    "avatarnika": ""
  },
  {
    "id": 20006923,
    "chapter_id": 6644,
    "verse_number": "14.42",
    "content_sanskrit": "यं लघुन्यपि लघूकृताहितः शिष्यभूतमशिषत्स कर्मणि । सस्पृहं नृपतिभिर्नृपोऽपरैर्गौरवेण ददृशेतरामसौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 42,
    "avatarnika": ""
  },
  {
    "id": 20006924,
    "chapter_id": 6644,
    "verse_number": "14.43",
    "content_sanskrit": "आद्यकोलतुलितां प्रकम्पनैः कम्पितां मुहुरनीदृगात्मनि । वाचिरोपितवतामुना महीं राजकाय विषया विभेजिरे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 43,
    "avatarnika": ""
  },
  {
    "id": 20006925,
    "chapter_id": 6644,
    "verse_number": "14.44",
    "content_sanskrit": "आगताद्व्यवसितेन चेतसा सत्त्वसम्पदविकारिमानसः । तत्र नाभवदसौ महाहवे शात्रवादिव पराङ्मुखोऽर्थिनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 44,
    "avatarnika": ""
  },
  {
    "id": 20006926,
    "chapter_id": 6644,
    "verse_number": "14.45",
    "content_sanskrit": "नैक्षतार्थिनमवज्ञया मुहुर्याचितस्तु न च कालमाक्षिपत् । नादिताल्पमथ न व्यकत्थयद्दत्तमिष्टमपि नान्वशेत सः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 45,
    "avatarnika": ""
  },
  {
    "id": 20006927,
    "chapter_id": 6644,
    "verse_number": "14.46",
    "content_sanskrit": "निर्गुणोऽपि विमुखो न भूपतेर्दानशौण्डमनसः पुरोऽभवत् । वर्षुकस्य किमपः कृतोन्नतेरम्बुदस्य परिहार्यमूषरम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 46,
    "avatarnika": ""
  },
  {
    "id": 20006928,
    "chapter_id": 6644,
    "verse_number": "14.47",
    "content_sanskrit": "प्रेम तस्य न गुणेषु नाधिकं न स्म वेद न गुणान्तरं च सः । दित्सया तदपि पार्थिवोऽर्थिनं गुण्यगुण्य इति न व्यजीगणत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 47,
    "avatarnika": ""
  },
  {
    "id": 20006929,
    "chapter_id": 6644,
    "verse_number": "14.48",
    "content_sanskrit": "दर्शनानुपदमेव कामतः स्वं वनीयकजनेऽधिगच्छति । प्रार्थनार्थरहितं तदाभवद्दीयतामिति वचोऽतिसर्जने ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 48,
    "avatarnika": ""
  },
  {
    "id": 20006930,
    "chapter_id": 6644,
    "verse_number": "14.49",
    "content_sanskrit": "नानवाप्तवसुनार्ऽथकाम्यता नाचिकित्सितगदेन रोगिणा । इच्छताशितुमनाशुषा न च प्रत्यगामि तदुपेयुषा सदः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 49,
    "avatarnika": ""
  },
  {
    "id": 20006931,
    "chapter_id": 6644,
    "verse_number": "14.50",
    "content_sanskrit": "स्वादयन्रसमनेकसंस्कृतप्राकृतैरकृतपात्रसङ्करैः । भावशुद्धिसहितैर्मुदं जनो नाटकैरिव बभार भोजनैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 50,
    "avatarnika": ""
  },
  {
    "id": 20006932,
    "chapter_id": 6644,
    "verse_number": "14.51",
    "content_sanskrit": "रक्षितारमिति तत्र कर्मणि न्यस्य दुष्टदमनक्षमं हरिम् । अक्षतानि निरवर्तयत्तदा दानहोमयजनानि भूपतिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 51,
    "avatarnika": ""
  },
  {
    "id": 20006933,
    "chapter_id": 6644,
    "verse_number": "14.52",
    "content_sanskrit": "एक एव सुसखैष सुन्वतां शौरिरित्यभिनयादिवोच्चकैः । यूपरूपकमनीनमद्भुजं भूश्चषालतुलिताङ्गुलीयकम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 52,
    "avatarnika": ""
  },
  {
    "id": 20006934,
    "chapter_id": 6644,
    "verse_number": "14.53",
    "content_sanskrit": "इत्थमत्र विततक्रमे क्रतौ वीक्ष्य धर्ममथ घर्मजन्मना । अर्घदानमनुचोदितो वचः सभ्यमभ्यधित शन्तनोः सुतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 53,
    "avatarnika": ""
  },
  {
    "id": 20006935,
    "chapter_id": 6644,
    "verse_number": "14.54",
    "content_sanskrit": "आत्मनैव गुणदोषकोविदः किं न वेत्सि करणीयवस्तुषु । यत्तथापि न गुरून्नपृच्छसि त्वं क्रमोऽयमिति तत्र कारणम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 54,
    "avatarnika": ""
  },
  {
    "id": 20006936,
    "chapter_id": 6644,
    "verse_number": "14.55",
    "content_sanskrit": "स्नातकं गुरुमभीष्टमृत्विजं संयुजा च सह मेदिनीपतिम् । अर्घभाज इति कीर्तयन्ति षट्ते च ते युगपदागताः सदः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 55,
    "avatarnika": ""
  },
  {
    "id": 20006937,
    "chapter_id": 6644,
    "verse_number": "14.56",
    "content_sanskrit": "शोभयन्ति परितः प्रतापिनो मन्त्रशक्तिविनिवारितापदः । त्वन्मखमुखभुवः स्वयम्भुवो भूभुजश्च परलोकजिष्णवः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 56,
    "avatarnika": ""
  },
  {
    "id": 20006938,
    "chapter_id": 6644,
    "verse_number": "14.57",
    "content_sanskrit": "आभजन्ति गुणिनः पृथक्पृथक्पार्थ सत्कृतिमकृत्रिमाममी । एक एव गुणवत्तमोऽथवापूज्य इत्ययमपीष्यते विधिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 57,
    "avatarnika": ""
  },
  {
    "id": 20006939,
    "chapter_id": 6644,
    "verse_number": "14.58",
    "content_sanskrit": "अत्र चैष सकलेऽपिभाति मां प्रत्यशेषगुणबन्धुरर्हति । भूमिदेवनरदेवसङ्गमे पूर्वदेवरिपुरर्हणां हरिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 58,
    "avatarnika": ""
  },
  {
    "id": 20006940,
    "chapter_id": 6644,
    "verse_number": "14.59",
    "content_sanskrit": "मर्त्यमात्रमवदीधरद्भवान्मैनमानमितदैत्यदानवम् । अंश एष जनतातिवर्तिनो वेधसः प्रतिजनं कृतस्थितेः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 59,
    "avatarnika": ""
  },
  {
    "id": 20006941,
    "chapter_id": 6644,
    "verse_number": "14.60",
    "content_sanskrit": "ध्येयमेकमपथे स्थितं धियः स्तुत्यमुत्तममतीतवाक्पथम् । आमनन्ति यमुपास्यमादराद्दूरवर्तिनमतीव योगिनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 60,
    "avatarnika": ""
  },
  {
    "id": 20006942,
    "chapter_id": 6644,
    "verse_number": "14.61",
    "content_sanskrit": "पद्मभूरिति सृजञ्जगद्रजः सत्वमच्युत इति स्थितिं नयन् । संहरन्हर इति श्रितस्तमस्रैधमेष भजति त्रिभिर्गुणैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 61,
    "avatarnika": ""
  },
  {
    "id": 20006943,
    "chapter_id": 6644,
    "verse_number": "14.62",
    "content_sanskrit": "सर्ववेदिनमनादिमास्थितं देहिनामनुजिघृक्षया वपुः । क्लेशकर्मफलभोगवर्जितं पुंविशेषममुमीश्वरंविदुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 62,
    "avatarnika": ""
  },
  {
    "id": 20006944,
    "chapter_id": 6644,
    "verse_number": "14.63",
    "content_sanskrit": "भक्तिमन्त इह भक्तवत्सले सन्ततस्मरणरीणकल्मषाः । यान्ति निर्वहणमस्य संसृतिक्लेशनाटकविडम्बनाविधेः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 63,
    "avatarnika": ""
  },
  {
    "id": 20006945,
    "chapter_id": 6644,
    "verse_number": "14.64",
    "content_sanskrit": "ग्राम्यभावमपहातुमिच्छवो योगमार्गपतितेन चेतसा । दुर्गमेकमपुनर्निवृत्तये यं विशन्ति वशिनं मुमुक्षवः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 64,
    "avatarnika": ""
  },
  {
    "id": 20006946,
    "chapter_id": 6644,
    "verse_number": "14.65",
    "content_sanskrit": "आदितामजननाय देहिनामन्ततां च दधतेऽनपायिने । बिभ्रते भुवमधः सदाथ च ब्रह्मणोऽप्युपरि तिष्ठते नमः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 65,
    "avatarnika": ""
  },
  {
    "id": 20006947,
    "chapter_id": 6644,
    "verse_number": "14.66",
    "content_sanskrit": "केवलं दधति कर्तृवाचिनः प्रत्ययानिह न जातु कर्मणि । धातवः सृजतिसंहृशास्तयः स्तौतिरत्र विपरीतकारकः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 66,
    "avatarnika": ""
  },
  {
    "id": 20006948,
    "chapter_id": 6644,
    "verse_number": "14.67",
    "content_sanskrit": "पूर्वमेष किल सृष्टवानपस्तासु वीर्यमनिवार्यमादधौ । तच्च कारणमभूद्धिरण्मयं ब्रह्मणोऽसृजदसाविदं जगत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 67,
    "avatarnika": ""
  },
  {
    "id": 20006949,
    "chapter_id": 6644,
    "verse_number": "14.68",
    "content_sanskrit": "मत्कुणाविव पुरा परिप्लवौ सिन्धुनाथशयने निषेदुषः । गच्छतः स्म मधुकैटभौ विभोर्यस्य नैद्रसुखविघ्नतां क्षणम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 68,
    "avatarnika": ""
  },
  {
    "id": 20006950,
    "chapter_id": 6644,
    "verse_number": "14.69",
    "content_sanskrit": "श्रौतमार्गसुखगानकोविदब्रह्मषट्चरणगर्भमुज्ज्वलम् । श्रीमुखेन्दुसविधेऽपि शोभते यस्य नाभिसरसीसरोरुहम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 69,
    "avatarnika": ""
  },
  {
    "id": 20006951,
    "chapter_id": 6644,
    "verse_number": "14.70",
    "content_sanskrit": "सत्यवृत्तमपि मायिनं जगद्वृद्धमप्युचितनिद्रमर्भकम् । जन्म बिभ्रतमजं नवं बुधा यं पुराणपुरुषं प्रचक्षते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 70,
    "avatarnika": ""
  },
  {
    "id": 20006952,
    "chapter_id": 6644,
    "verse_number": "14.71",
    "content_sanskrit": "स्कन्धधूननविसारिकेसरक्षिप्तसागरमहाप्लवामयम् । उद्धृतामिव मुहूर्तमैक्षत स्थूलनासिकवपुर्वसुन्धराम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 71,
    "avatarnika": ""
  },
  {
    "id": 20006953,
    "chapter_id": 6644,
    "verse_number": "14.72",
    "content_sanskrit": "दिव्यकेसरिवपुः सुरद्विषो नैव लब्धशममायुधैरपि । दुर्निवाररणकण्डु कोमलैर्वक्ष एष निरदारयन्नखैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 72,
    "avatarnika": ""
  },
  {
    "id": 20006954,
    "chapter_id": 6644,
    "verse_number": "14.73",
    "content_sanskrit": "वारिधेरिव कराग्रवीचिभिर्दिङ्मतङ्गजमुखान्यभिघ्नतः । यस्य चारुनखशुक्तयः स्फुरन्मौक्तिकप्रकरगर्भतां दधुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 73,
    "avatarnika": ""
  },
  {
    "id": 20006955,
    "chapter_id": 6644,
    "verse_number": "14.74",
    "content_sanskrit": "दीप्तिनिर्जितविरोचनादयं गां विरोचनसुतादभीप्सतः । आत्मभूरवरजाखिलप्रजः स्वर्पतेरवरजत्वमाययौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 74,
    "avatarnika": ""
  },
  {
    "id": 20006956,
    "chapter_id": 6644,
    "verse_number": "14.75",
    "content_sanskrit": "किं क्रमिष्यति किलैष वामनो यावदित्थमहसन्न दानवाः । तावदस्य न ममौ नभस्तले लङ्घितार्कशशिमण्डलः क्रमः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 75,
    "avatarnika": ""
  },
  {
    "id": 20006957,
    "chapter_id": 6644,
    "verse_number": "14.76",
    "content_sanskrit": "गच्छतापि गगनाग्रमुच्चकैर्यस्य भूधरगरीयसाङ्घ्रिणा । क्रान्तकन्धर इवाबलो बलिः स्वर्गभर्तुरगमत्सुबन्धताम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 76,
    "avatarnika": ""
  },
  {
    "id": 20006958,
    "chapter_id": 6644,
    "verse_number": "14.77",
    "content_sanskrit": "कामतोऽस्य ददृशुर्दिवौकसो दूरमूरुमलिनीलमायतम् । व्योम्नि दिव्यसरिदम्बुपद्धतिस्पर्धयेव यमुनौघमुत्थितम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 77,
    "avatarnika": ""
  },
  {
    "id": 20006959,
    "chapter_id": 6644,
    "verse_number": "14.78",
    "content_sanskrit": "यस्य किञ्चिदपकर्तुमक्षमः कायनिग्रहगृहीतविग्रहः । कान्तवक्त्रसदृशाकृतिं कृती राहुरिन्दुमधुनापि बाधते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 78,
    "avatarnika": ""
  },
  {
    "id": 20006960,
    "chapter_id": 6644,
    "verse_number": "14.79",
    "content_sanskrit": "सम्प्रदायविगमादुपेयुषीरेव नाशमविनाशिविग्रहः । स्मर्तुमप्रतिहतस्मृतिः श्रुतीर्दत्त इत्यभवदत्रिगोत्रजः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 79,
    "avatarnika": ""
  },
  {
    "id": 20006961,
    "chapter_id": 6644,
    "verse_number": "14.80",
    "content_sanskrit": "रेणुकातनयतामुपागतः शातितप्रचुरपत्रसंहति । लूनभूरिभुजशाखमुज्झितच्छायमर्जुनवनं व्यधादयम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 80,
    "avatarnika": ""
  },
  {
    "id": 20006962,
    "chapter_id": 6644,
    "verse_number": "14.81",
    "content_sanskrit": "एष दाशरथिभूयमेत्य च ध्वंसितोद्धतदशाननामपि । राक्षसीमकृत रक्षितप्रजस्तेजसाधिकविभीषणां पुरीम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 81,
    "avatarnika": ""
  },
  {
    "id": 20006963,
    "chapter_id": 6644,
    "verse_number": "14.82",
    "content_sanskrit": "निष्प्रहन्तुममरेशविद्विषामर्थितः स्वयमथ स्वयंभुवा । सम्प्रति श्रयति सूनुतामयं कश्यपस्य वसुदेवरूपिणः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 82,
    "avatarnika": ""
  },
  {
    "id": 20006964,
    "chapter_id": 6644,
    "verse_number": "14.83",
    "content_sanskrit": "तात नोदधिविलोडनं प्रति त्वद्विनाथ वयमुत्सहामहे । यः सुरैरिति सुरौघवल्लभो बल्लवैश्च जगदे जगत्पतिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 83,
    "avatarnika": ""
  },
  {
    "id": 20006965,
    "chapter_id": 6644,
    "verse_number": "14.84",
    "content_sanskrit": "नात्तगन्धमवधूय शत्रुभिश्छायया च शमितामरश्रमम् । योऽभिमानमिव वृत्रविद्विषः पारिजातमुदमूलयद्दिवः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 84,
    "avatarnika": ""
  },
  {
    "id": 20006966,
    "chapter_id": 6644,
    "verse_number": "14.85",
    "content_sanskrit": "यं समेत्य च ललाटलेखया बिभ्रतः सपदि शंभुविभ्रमम् । चण्डमारुतमिव प्रदीपवच्चेदिपस्य निरवाद्विलोचनम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 85,
    "avatarnika": ""
  },
  {
    "id": 20006967,
    "chapter_id": 6644,
    "verse_number": "14.86",
    "content_sanskrit": "यः कोलतां बल्लवतां च बिभ्रद्दंष्ट्रामुदस्याशु भुजां च गुर्वीम् । मग्नस्य तोयापदि दुस्तरायां गोमण्डलस्योद्धरणं चकार ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 86,
    "avatarnika": ""
  },
  {
    "id": 20006968,
    "chapter_id": 6644,
    "verse_number": "14.87",
    "content_sanskrit": "धन्योऽसि यस्य हरिरेष समक्ष एव दूरादपि क्रतुषु यज्वभिरिज्यते यः । दत्वार्घमत्रभवते भुवनेषु यावत्संसारमण्डलमवाप्नुहि साधुवादम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 87,
    "avatarnika": ""
  },
  {
    "id": 20006969,
    "chapter_id": 6644,
    "verse_number": "14.88",
    "content_sanskrit": "भीष्मोक्तं तदिति वचो निशम्य सम्यक्साम्राज्यश्रियमधिगच्छता नृपेण । दत्तेर्ऽधे महति महीभृतां पुरोऽपि त्रैलोक्ये मधुभिदभूदनर्घ एव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 88,
    "avatarnika": ""
  }
]