[
  {
    "id": 20006882,
    "chapter_id": 6644,
    "verse_number": "14.1",
    "content_sanskrit": "तं जगाद गिरमुद्गिरन्निव स्नेहमाहितविकासया दृशा । यज्ञकर्मणि मनः समादधद्वाग्विदां वरमकमद्वदो नृपः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "avatarnika": ""
  },
  {
    "id": 20006883,
    "chapter_id": 6644,
    "verse_number": "14.2",
    "content_sanskrit": "लज्जते न गदितः प्रियं परो वक्तुरेव भवति त्रपाधिका । व्रीडमेतिन तव प्रियं वदन्ह्रीमतात्रभवतैव भूयते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "avatarnika": ""
  },
  {
    "id": 20006884,
    "chapter_id": 6644,
    "verse_number": "14.3",
    "content_sanskrit": "तोषमेति वितथैः स्तवैः परस्ते च तस्य सुलभाः शरीरिभिः । अस्ति न स्तुतिवचोऽनृतं तव स्तोत्रयोग्यन च तेन तुष्यसि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "avatarnika": ""
  },
  {
    "id": 20006885,
    "chapter_id": 6644,
    "verse_number": "14.4",
    "content_sanskrit": "बह्वपि प्रियमयं तव ब्रुवन्न व्रजत्यनृतवादितां जनः । सम्भवन्ति यददोषदूषिते सार्व सर्वगुणसम्पदस्त्वयि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "avatarnika": ""
  },
  {
    "id": 20006886,
    "chapter_id": 6644,
    "verse_number": "14.5",
    "content_sanskrit": "सा विभूतिरनुभाव सम्पदां भूयसी तव यदायतायति । एतदूढगुरुभार भारतं वर्षमद्य मम वर्तते वशे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "avatarnika": ""
  },
  {
    "id": 20006887,
    "chapter_id": 6644,
    "verse_number": "14.6",
    "content_sanskrit": "सप्ततन्तुमधिगन्तुमिच्छतः कुर्वनुग्रहमनुज्ञया मम । मूलतामुपगते प्रभो त्वयि प्रापि धर्ममयवृक्षता मया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "avatarnika": ""
  },
  {
    "id": 20006888,
    "chapter_id": 6644,
    "verse_number": "14.7",
    "content_sanskrit": "सम्भृतोपकरणेन निर्मलां कर्तुमिष्टिमभिवाञ्छता मया । त्वं समीरण इव प्रतीक्षितः कर्षकेण वलजान्पुपूषता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "avatarnika": ""
  },
  {
    "id": 20006889,
    "chapter_id": 6644,
    "verse_number": "14.8",
    "content_sanskrit": "वीतविघ्नमनघेन भाविता सन्निधेस्तव मखेन मेऽधुना । को विहन्तुमलमास्थितोदये वासरश्रियमशीतदीधितौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "avatarnika": ""
  },
  {
    "id": 20006890,
    "chapter_id": 6644,
    "verse_number": "14.9",
    "content_sanskrit": "स्वापतेयमधिगम्य धर्मतः पर्यपालयमवीवृधं च यत् । तीर्थगामी करवै विधानतस्तज्जुषस्व जुहवानि चानले ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "avatarnika": ""
  },
  {
    "id": 20006891,
    "chapter_id": 6644,
    "verse_number": "14.10",
    "content_sanskrit": "पूर्वमङ्ग जुहुधि त्वमेव वा स्नातवत्यवभृथे ततस्त्वयि । सोमपायिनि भविष्यते मया वाञ्छितोत्तमवितानयाजिना ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "avatarnika": ""
  },
  {
    "id": 20006892,
    "chapter_id": 6644,
    "verse_number": "14.11",
    "content_sanskrit": "किं विधेयमनया विधीयतां त्वत्प्रसादजितयार्थसम्पदा । शाधि शासक जगत्त्रयस्य मामाश्रवोऽस्मि भवतः सहानुजः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "avatarnika": ""
  },
  {
    "id": 20006893,
    "chapter_id": 6644,
    "verse_number": "14.12",
    "content_sanskrit": "तं वदन्तमिति विष्टरश्रवाः श्रावयन्नथ समस्तभूभृतः । व्याजहार दशनांशुमण्डलव्याजहार शबलं दधद्वपुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "avatarnika": ""
  },
  {
    "id": 20006894,
    "chapter_id": 6644,
    "verse_number": "14.13",
    "content_sanskrit": "सादिताखिलनृपं महन्महः सम्प्रति स्वनयसंपदैव ते । किं परस्य स गुणः समश्नुते पथ्यवृत्तिरपि यद्यरोगिताम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "avatarnika": ""
  },
  {
    "id": 20006895,
    "chapter_id": 6644,
    "verse_number": "14.14",
    "content_sanskrit": "तत्सुराज्ञि भवति स्थिते पुनः कः क्रतुं यजतु राजलक्षणम् । उद्धृतौ भवति कस्य वा भुवः श्रीवराहमपहाय योग्यता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "avatarnika": ""
  },
  {
    "id": 20006896,
    "chapter_id": 6644,
    "verse_number": "14.15",
    "content_sanskrit": "शासनेऽपि गुरुणि व्यवस्थितं कृत्यवस्तुषु नियुङ्क्ष्व कामतः । त्वत्प्रयोजनघनं धनञ्जयादन्य एव इति मां च मावगाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "avatarnika": ""
  },
  {
    "id": 20006897,
    "chapter_id": 6644,
    "verse_number": "14.16",
    "content_sanskrit": "यस्तवेह सवने न भूपतिः कर्म कर्मकरवत्करिष्यति । तस्य नेष्यति वपुः कबन्धतां बन्धुरेव जगतां सुदर्शनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "avatarnika": ""
  },
  {
    "id": 20006898,
    "chapter_id": 6644,
    "verse_number": "14.17",
    "content_sanskrit": "इत्युदीरितगिरं नृपस्त्वयि श्रेयसि स्थितवति स्थिरा मम । सर्वसम्पदिति शौरिमुक्तवानुद्वहन्मुदमुदस्थित क्रतौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "avatarnika": ""
  },
  {
    "id": 20006899,
    "chapter_id": 6644,
    "verse_number": "14.18",
    "content_sanskrit": "आननेन शशिनः कलां दधद्दर्शनक्षयितकामविग्रहः । आप्लुतः स विमलैर्जलैरभूदष्टमूर्तिधरमूर्तिरष्टमी ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "avatarnika": ""
  },
  {
    "id": 20006900,
    "chapter_id": 6644,
    "verse_number": "14.19",
    "content_sanskrit": "तस्य सांख्यपुरुषेण तुल्यतां बिभ्रतः स्वयमकुर्वतः क्रियाः । कर्तृता तदुपलम्भतोऽभवद्वृत्तिभाजि करणे यथर्त्विजि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "avatarnika": ""
  },
  {
    "id": 20006901,
    "chapter_id": 6644,
    "verse_number": "14.20",
    "content_sanskrit": "शब्दितामनपशब्दमुच्चकैर्वाक्यलक्षणविदोऽनुवाक्यया । याज्यया यजनकर्मिणोऽत्यजन्द्रव्यजातमपदिश्य देवताम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "avatarnika": ""
  },
  {
    "id": 20006902,
    "chapter_id": 6644,
    "verse_number": "14.21",
    "content_sanskrit": "सप्तमभेदकरकल्पितस्वरं साम सामविदसङ्गमुज्जगौ । तत्र सूनृतगिरश्च सूरयः पुण्यमृग्यजुषमध्यगीषत ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "avatarnika": ""
  },
  {
    "id": 20006903,
    "chapter_id": 6644,
    "verse_number": "14.22",
    "content_sanskrit": "बद्धदर्भमयकाञ्चिदामया वीक्षितानि यजमानजायया । शुष्मणि प्रणयनादिसंस्कृते तैर्हवींषि जुहवांबभूविरे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "avatarnika": ""
  },
  {
    "id": 20006904,
    "chapter_id": 6644,
    "verse_number": "14.23",
    "content_sanskrit": "नाञ्ञ्जसा निगदितुं विभक्तिभिर्व्यक्तिभिश्च निखिलाभिरागमे । तत्र कर्मणि विपर्यणीनमन्मन्त्रमूहकुशलः प्रयोगिणः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "avatarnika": ""
  },
  {
    "id": 20006905,
    "chapter_id": 6644,
    "verse_number": "14.24",
    "content_sanskrit": "संशयाय दधतोः सरूपता दूरभिन्नफलयोः क्रियां प्रति । शब्दशासनविदः समासयोर्विग्रहं व्यवससुः स्वरेण ते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "avatarnika": ""
  },
  {
    "id": 20006906,
    "chapter_id": 6644,
    "verse_number": "14.25",
    "content_sanskrit": "लोलहेतिरसनाशतप्रभामण्डलेन लसता हसन्निव । प्राज्यमाज्यमसकृद्वषट्कृतं निर्मलीमसमलीढ पावकः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "avatarnika": ""
  },
  {
    "id": 20006907,
    "chapter_id": 6644,
    "verse_number": "14.26",
    "content_sanskrit": "तत्र मन्त्रपवितं हविः क्रतावश्नतो न वपुरेव केवलम् । वर्णसम्पदमतिस्फुटां दधन्नाम चोज्ज्वलमभूद्धविर्भुजः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "avatarnika": ""
  },
  {
    "id": 20006908,
    "chapter_id": 6644,
    "verse_number": "14.27",
    "content_sanskrit": "स्पर्शमुष्णमुचितं दधच्छिखी यद्ददाह हविरद्भुतं न तत् । गन्धतोऽपि हुतहव्यसम्भवाद्देहिनामदहदोघमंहसाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "avatarnika": ""
  },
  {
    "id": 20006909,
    "chapter_id": 6644,
    "verse_number": "14.28",
    "content_sanskrit": "उन्नमन्सपदि धूम्रयन्दिशः सान्द्रतां दधदधःकृताम्बुदः । द्यामियाय दहनस्य केतनः कीर्तयन्निव दिवौकसां प्रियम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "avatarnika": ""
  },
  {
    "id": 20006910,
    "chapter_id": 6644,
    "verse_number": "14.29",
    "content_sanskrit": "निर्जिताखिलमहार्णवौषधिस्यन्दसारममृतं ववल्गिरे । नाकिनः कथमपि प्रतीक्षितुं हूयमानमनले विषेहिरे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "avatarnika": ""
  },
  {
    "id": 20006911,
    "chapter_id": 6644,
    "verse_number": "14.30",
    "content_sanskrit": "तत्र नित्यविहितोपहूतिषु प्रोषितेषु पतिषु द्युयोषिताम् । गुम्फिताः शिरसि वेणयोऽभवन्न प्रफुल्लसुरपादपस्रजः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "avatarnika": ""
  },
  {
    "id": 20006912,
    "chapter_id": 6644,
    "verse_number": "14.31",
    "content_sanskrit": "प्राशुराशु हवनीयमत्र यत्तेन दीर्घममरत्वमध्यगुः । उद्धतानधिक मेधितौजसो दानवांश्च विबुधाः विजिग्यिरे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "avatarnika": ""
  },
  {
    "id": 20006913,
    "chapter_id": 6644,
    "verse_number": "14.32",
    "content_sanskrit": "नापचारमगमन्क्कच्चित्क्रियाः सर्वमत्र समपादि साधनम् । अत्यशेरत परस्परं धियः सत्त्रिणां नरपतेश्चसंपदः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "avatarnika": ""
  },
  {
    "id": 20006914,
    "chapter_id": 6644,
    "verse_number": "14.33",
    "content_sanskrit": "दक्षिणीयमवगम्य पङ्क्तिशः पङ्क्तिपावनमथ द्विजव्रजम् । दक्षिणः क्षितिपतिर्व्यशिश्रणद्दक्षिणाः सदसि राजसूयकीः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 33,
    "avatarnika": ""
  },
  {
    "id": 20006915,
    "chapter_id": 6644,
    "verse_number": "14.34",
    "content_sanskrit": "वारिपूर्वमखिलासु सत्क्रियालब्धशुद्धिषु धनानि बीजवत् । भावि बिभ्रति फलं महद्द्विजक्षेत्रभूमिषु नराधिपोऽवपत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34,
    "avatarnika": ""
  },
  {
    "id": 20006916,
    "chapter_id": 6644,
    "verse_number": "14.35",
    "content_sanskrit": "किं नु चित्रमधिवेदि भूपतिर्दक्षयन्द्विजगणानपूयत । राजतः पुपुविरे निरेनसः प्राप्य तेऽपि विमलं प्रतिग्रहम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
