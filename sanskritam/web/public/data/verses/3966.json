[{"id": 2136812, "chapter_id": 3966, "verse_number": "१", "content_sanskrit": "नात्मानमनुशोचामि नेमान् भ्रातॄन् महामुने ।\nहरणं चापि राज्यस्य यथेमां द्रुपदात्मजाम् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2136813, "chapter_id": 3966, "verse_number": "२", "content_sanskrit": "द्यूते दुरात्मभिः क्लिष्टाः कृष्णया तारिता वयम् ।\nजयद्रथेन च पुनर्वनाच्चापि हृता बलात् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2136814, "chapter_id": 3966, "verse_number": "३", "content_sanskrit": "अस्ति सीमन्तिनी काचिद् दृष्टपूर्वापि वा श्रुता ।\nपतिव्रता महाभागा यथेयं द्रुपदात्मजा \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2136815, "chapter_id": 3966, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2136816, "chapter_id": 3966, "verse_number": "४", "content_sanskrit": "शृणु राजन् कुलस्त्रीणां महाभाग्यं युधिष्ठिर ।\nसर्वमेतद् यथा प्राप्तं सावित्र्या राजकन्यया \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2136817, "chapter_id": 3966, "verse_number": "५", "content_sanskrit": "आसीन्मद्रेषु धर्मात्मा राजा परमधार्मिकः।\nब्रह्मण्यश्च महात्मा च सत्यसन्धो जितेन्द्रियः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2136818, "chapter_id": 3966, "verse_number": "६", "content_sanskrit": "यज्वा दानपतिर्दक्षः पौरजानपदप्रियः ।\nपार्थिवोऽश्वपतिर्नाम सर्वभूतहिते रतः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2136819, "chapter_id": 3966, "verse_number": "७", "content_sanskrit": "क्षमावाननपत्यश्च सत्यवाग् विजितेन्द्रियः ।\nअतिक्रान्तेन वयसा सन्तापमुपजग्मिवान् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2136820, "chapter_id": 3966, "verse_number": "८", "content_sanskrit": "अपत्योत्पादनार्थं च तीव्रं नियममास्थितः ।\nकाले परिमिताहारो ब्रह्मचारी जितेन्द्रियः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2136821, "chapter_id": 3966, "verse_number": "९", "content_sanskrit": "हुत्वा शतसहस्रं स सावित्र्या राजसत्तम ।\nषष्ठे षष्ठे तदा काले बभूव मितभोजनः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2136822, "chapter_id": 3966, "verse_number": "१०", "content_sanskrit": "एतेन नियमेनासीद् वर्षाण्यष्टादशैव तु ।\nपूर्णे त्वष्टादशे वर्षे सावित्री तुष्टिमभ्यगात् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2136823, "chapter_id": 3966, "verse_number": "११", "content_sanskrit": "रूपिणी तु तदा राजन् दर्शयामास तं नृपम् ।\nअग्निहोत्रात् समुत्थाय हर्षेण महतान्विता \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2136824, "chapter_id": 3966, "verse_number": "१२", "content_sanskrit": "उवाच चैनं वरदा वचनं पार्थिवं तदा ।\nसा तमश्वपतिं राजन् सावित्री नियमे स्थितम् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2136825, "chapter_id": 3966, "verse_number": "", "content_sanskrit": "सावित्री", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2136826, "chapter_id": 3966, "verse_number": "१३", "content_sanskrit": "ब्रह्मचर्येण शुद्धेन दमेन नियमेन च ।\nसर्वात्मना च भक्त्या च तुष्टास्मि तव पार्थिव \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2136827, "chapter_id": 3966, "verse_number": "१४", "content_sanskrit": "वरं वृणीष्वाश्वपते मद्रराज यदीप्सितम् ।\nन प्रमादश्च धर्मेषु कर्तव्यस्ते कथञ्चन \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2136828, "chapter_id": 3966, "verse_number": "", "content_sanskrit": "अश्वपतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2136829, "chapter_id": 3966, "verse_number": "१५", "content_sanskrit": "अपत्यार्थः समारम्भः कृतो धर्मेप्सया मया ।\nपुत्रा मे बहवो देवि भवेयुः कुलभाज(व)नाः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2136830, "chapter_id": 3966, "verse_number": "१६", "content_sanskrit": "तुष्टासि यदि मे देवि वरमेतं वृणोम्यहम् ।\nसन्तानं परमो धर्म इत्याहुर्मां द्विजातयः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2136831, "chapter_id": 3966, "verse_number": "", "content_sanskrit": "सावित्री", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2136832, "chapter_id": 3966, "verse_number": "१७", "content_sanskrit": "पूर्वमेव मया राजन्नभिप्रायमिमं तव ।\nज्ञात्वा पुत्रार्थमुक्तो वै भगवांस्ते पितामहः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2136833, "chapter_id": 3966, "verse_number": "१८", "content_sanskrit": "प्रसादाच्चैव तस्मात् ते स्वयम्भुविहिताद् भुवि ।\nकन्या तेजस्विनी सौम्य क्षिप्रमेव भविष्यति \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2136834, "chapter_id": 3966, "verse_number": "१९", "content_sanskrit": "उत्तरं च न ते किञ्चिद् व्याहर्तव्यं कथञ्चन ।\nपितामहनिसर्गेण तुष्टा ह्येतद् ब्रवीमि ते \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2136835, "chapter_id": 3966, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2136836, "chapter_id": 3966, "verse_number": "२०", "content_sanskrit": "स तथेति प्रतिज्ञाय सावित्र्या वचनं नृपः ।\nप्रसादयामास पुनः क्षिप्रमेतद् भविष्यति \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2136837, "chapter_id": 3966, "verse_number": "२१", "content_sanskrit": "अन्तर्हितायां सावित्र्यां जगाम स्वपुरं नृपः ।\nस्वराज्ये चावसद् वीरः प्रजा धर्मेण पालयन् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2136838, "chapter_id": 3966, "verse_number": "२२", "content_sanskrit": "कस्मिंश्चित् तु गते काले स राजा नियतव्रतः।\nज्येष्ठायां धर्मचारिण्यां महिष्यां गर्भमादधे \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2136839, "chapter_id": 3966, "verse_number": "२३", "content_sanskrit": "राजपुत्र्यास्तु गर्भः स मालव्या भरतर्षभ ।\nव्यवर्धत तदा शुक्ले तारापतिरिवाम्बरे \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2136840, "chapter_id": 3966, "verse_number": "२४", "content_sanskrit": "प्राप्ते काले तु सुषुवे कन्यां राजीवलोचनाम् ।\nक्रियाश्च तस्या मुदितश्चक्रे च नृपसत्तमः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2136841, "chapter_id": 3966, "verse_number": "२५", "content_sanskrit": "सावित्र्या प्रीतया दत्ता सावित्र्या हुतया ह्यपि ।\nसावित्रीत्येव नामास्याश्चक्रुर्विप्रास्तथा पिता \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2136842, "chapter_id": 3966, "verse_number": "२६", "content_sanskrit": "सा विग्रहवतीव श्रीर्व्यवर्धत नृपात्मजा ।\nकालेन चापि सा कन्या यौवनस्था बभूव ह \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2136843, "chapter_id": 3966, "verse_number": "२७", "content_sanskrit": "तां सुमध्यां पुथुश्रोणीं प्रतिमां काञ्चनीमिव ।\nप्राप्तेयं देवकन्येति दृष्ट्वा सम्मेनिरे जनाः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2136844, "chapter_id": 3966, "verse_number": "२८", "content_sanskrit": "तां तु पद्मपलाशाक्षीं ज्वलन्तीमिव तेजसा ।\nन कश्चिद् वरयामास तेजसा प्रतिवारितः \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2136845, "chapter_id": 3966, "verse_number": "२९", "content_sanskrit": "अथोपोष्य शिरःस्नाता देवतामभिगम्य सा ।\nहुत्वाग्निं विधिवद् विप्रान् वाऽर्चयामास पर्वणि \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2136846, "chapter_id": 3966, "verse_number": "३०", "content_sanskrit": "ततः सुमनसः शेषाः प्रतिगृह्य महात्मनः ।\nपितुः समीपमगमद् देवी श्रीरिव रूपिणी \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2136847, "chapter_id": 3966, "verse_number": "३१", "content_sanskrit": "साभिवाद्य पितुः पादौ शेषाः पूर्वं निवेद्य च ।\nकृताञ्जलिर्वरारोहा नृपतेः पार्श्वमास्थिता \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2136848, "chapter_id": 3966, "verse_number": "३२", "content_sanskrit": "यौवनस्थां तु तां दृष्ट्वा स्वां सुतां देवरूपिणीम् ।\nअयाच्यमानां च वरैर्नृपतिर्दुःखितोऽभवत् \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2136849, "chapter_id": 3966, "verse_number": "", "content_sanskrit": "राजा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2136850, "chapter_id": 3966, "verse_number": "३३", "content_sanskrit": "पुत्रि प्रदानकालस्ते न च कश्चिद् वृणोति माम् ।\nस्वयमन्विच्छ भर्तारं गुणैः सदृशमात्मनः \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2136851, "chapter_id": 3966, "verse_number": "३४", "content_sanskrit": "प्रार्थितः पुरुषो यश्च स निवेद्यस्त्वया मम ।\nविमृश्याहं प्रदास्यामि वरय त्वं यथेप्सितम् \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2136852, "chapter_id": 3966, "verse_number": "३५", "content_sanskrit": "श्रुतं हि धर्मशास्त्रेषु पठ्यमानं द्विजातिभिः ।\nतथा त्वमपि कल्याणि गदतो मे वचः शृणु \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2136853, "chapter_id": 3966, "verse_number": "३६", "content_sanskrit": "अप्रदाता पिता वाच्यो वाच्यश्चानुपयन् पतिः ।\nमृते भर्तरि पुत्रश्च वाच्यो मातुररक्षिता \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2136854, "chapter_id": 3966, "verse_number": "३७", "content_sanskrit": "इदं मे वचनं श्रुत्वा भर्तुरन्वेषणे त्वर ।\nदेवतानां यथा वाच्यो न भवेयं तथा कुरु \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2136855, "chapter_id": 3966, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2136856, "chapter_id": 3966, "verse_number": "३८", "content_sanskrit": "एवमुक्त्वा दुहितरं तथा वृद्धांश्च मन्त्रिणः ।\nव्यादिदेशानुयात्रं च गम्यतां चेत्यचोदयत् \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2136857, "chapter_id": 3966, "verse_number": "३९", "content_sanskrit": "साभिवाद्य पितुः पादौ व्रीडितेव मनस्विनी ।\nपितुर्वचनमाज्ञाय निर्जगामाविचारितम् \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2136858, "chapter_id": 3966, "verse_number": "४०", "content_sanskrit": "सा हैमं रथमास्थाय स्थविरैः सचिवैर्वृता ।\nतपोवनानि रम्याणि राजर्षीणां जगाम ह \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2136859, "chapter_id": 3966, "verse_number": "४१", "content_sanskrit": "मान्यानां तत्र वृद्धानां कृत्वा पादाभिवादनम् ।\nवनानि क्रमशस्तात सर्वाण्येवाभ्यगच्छत \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2136860, "chapter_id": 3966, "verse_number": "४२", "content_sanskrit": "एवं तीर्थेषु सर्वेषु धनोत्सर्गं नृपात्मजा ।\nकुर्वती द्विजमुख्यानां तं तं देशं जगाम ह \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2136861, "chapter_id": 3966, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nवनपर्वणि द्व्यशीत्यधिकद्विशततमोऽध्यायः ॥२८२॥\nपतिव्रतामाहात्म्यपर्वणि सावित्र्युपाख्याने प्रथमोऽध्यायः ॥१॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]