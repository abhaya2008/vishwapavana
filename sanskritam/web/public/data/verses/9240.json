[{"id": 5000240000, "chapter_id": 9240, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे चतुश्चत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000240001, "chapter_id": 9240, "verse_number": "३-४४-१", "content_sanskrit": "तथा तु तं समादिश्य भ्रातरं रघुनन्दनः।\nबबन्धासिं महातेजा जाम्बूनदमयत्सरुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000240002, "chapter_id": 9240, "verse_number": "३-४४-२", "content_sanskrit": "ततस्त्रिविनतं चापमादायात्मविभूषणम्।\nआबध्य च कपालौ द्वौ जगामोदग्रविक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000240003, "chapter_id": 9240, "verse_number": "३-४४-३", "content_sanskrit": "तं वन्यराजो राजेन्द्रमापतन्तं निरीक्ष्य वै।\nबभूवान्तर्हितस्त्रासात् पुनः संदर्शनेऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000240004, "chapter_id": 9240, "verse_number": "३-४४-४", "content_sanskrit": "बद्धासिर्धनुरादाय प्रदुद्राव यतो मृगः।\nतं स्म पश्यति रूपेण द्योतयन्तमिवाग्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000240005, "chapter_id": 9240, "verse_number": "३-४४-५", "content_sanskrit": "अवेक्ष्यावेक्ष्य धावन्तं धनुष्पाणिर्महावने।\nअतिवृत्तमिवोत्पाताल्लोभयानं कदाचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000240006, "chapter_id": 9240, "verse_number": "३-४४-६", "content_sanskrit": "शङ्कितं तु समुद्‍भ्रान्तमुत्पतन्तमिवाम्बरम्।\nदृश्यमानमदृश्यं च वनोद्देशेषु केषुचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000240007, "chapter_id": 9240, "verse_number": "३-४४-७", "content_sanskrit": "छिन्नाभ्रैरिव संवीतं शारदं चन्द्रमण्डलम्।\nमुहूर्तादेव ददृशे मुहुर्दूरात् प्रकाशते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000240008, "chapter_id": 9240, "verse_number": "३-४४-८", "content_sanskrit": "दर्शनादर्शनेनैव सोऽपाकर्षत राघवम्।\nस दूरमाश्रमस्यास्य मारीचो मृगतां गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000240009, "chapter_id": 9240, "verse_number": "३-४४-९", "content_sanskrit": "आसीत् क्रुद्धस्तु काकुत्स्थो विवशस्तेन मोहितः।\nअथावतस्थे सुश्रान्तश्छायामाश्रित्य शाद्वले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000240010, "chapter_id": 9240, "verse_number": "३-४४-१०", "content_sanskrit": "स तमुन्मादयामास मृगरूपो निशाचरः।\nमृगैः परिवृतोऽथान्यैरदूरात् प्रत्यदृश्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000240011, "chapter_id": 9240, "verse_number": "३-४४-११", "content_sanskrit": "ग्रहीतुकामं दृष्ट्वा तं पुनरेवाभ्यधावत।\nतत्क्षणादेव संत्रासात् पुनरन्तर्हितोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000240012, "chapter_id": 9240, "verse_number": "३-४४-१२", "content_sanskrit": "पुनरेव ततो दूराद् वृक्षखण्डाद् विनिःसृतः।\nदृष्ट्वा रामो महातेजास्तं हन्तुं कृतनिश्चयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000240013, "chapter_id": 9240, "verse_number": "३-४४-१३", "content_sanskrit": "भूयस्तु शरमुद‍्धृत्य कुपितस्तत्र राघवः।\nसूर्यरश्मिप्रतीकाशं ज्वलन्तमरिमर्दनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000240014, "chapter_id": 9240, "verse_number": "३-४४-१४", "content_sanskrit": "संधाय सुदृढे चापे विकृष्य बलवद‍्बली।\nतमेव मृगमुद्दिश्य श्वसन्तमिव पन्नगम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000240015, "chapter_id": 9240, "verse_number": "३-४४-१५", "content_sanskrit": "मुमोच ज्वलितं दीप्तमस्त्रं ब्रह्मविनिर्मितम्।\nशरीरं मृगरूपस्य विनिर्भिद्य शरोत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000240016, "chapter_id": 9240, "verse_number": "३-४४-१६", "content_sanskrit": "मारीचस्यैव हृदयं बिभेदाशनिसंनिभः।\nतालमात्रमथोत्प्लुत्य न्यपतत् स भृशातुरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000240017, "chapter_id": 9240, "verse_number": "३-४४-१७", "content_sanskrit": "व्यनदद् भैरवं नादं धरण्यामल्पजीवितः।\nम्रियमाणस्तु मारीचो जहौ तां कृत्रिमां तनुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000240018, "chapter_id": 9240, "verse_number": "३-४४-१८", "content_sanskrit": "स्मृत्वा तद्वचनं रक्षो दध्यौ केन तु लक्ष्मणम्।\nइह प्रस्थापयेत् सीता तां शून्ये रावणो हरेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000240019, "chapter_id": 9240, "verse_number": "३-४४-१९", "content_sanskrit": "स प्राप्तकालमाज्ञाय चकार च ततः स्वनम्।\nसदृशं राघवस्येव हा सीते लक्ष्मणेति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000240020, "chapter_id": 9240, "verse_number": "३-४४-२०", "content_sanskrit": "तेन मर्मणि निर्विद्धं शरेणानुपमेन हि।\nमृगरूपं तु तत् त्यक्त्वा राक्षसं रूपमास्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000240021, "chapter_id": 9240, "verse_number": "३-४४-२१", "content_sanskrit": "चक्रे स सुमहाकायं मारीचो जीवितं त्यजन्।\nतं दृष्ट्वा पतितं भूमौ राक्षसं भीमदर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000240022, "chapter_id": 9240, "verse_number": "३-४४-२२", "content_sanskrit": "रामो रुधिरसिक्ताङ्गं चेष्टमानं महीतले।\nजगाम मनसा सीतां लक्ष्मणस्य वचः स्मरन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000240023, "chapter_id": 9240, "verse_number": "३-४४-२३", "content_sanskrit": "मारीचस्य तु मायैषा पूर्वोक्तं लक्ष्मणेन तु।\nतत् तथा ह्यभवच्चाद्य मारीचोऽयं मया हतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000240024, "chapter_id": 9240, "verse_number": "३-४४-२४", "content_sanskrit": "हा सीते लक्ष्मणेत्येवमाक्रुश्य तु महास्वनम्।\nममार राक्षसः सोऽयं श्रुत्वा सीता कथं भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000240025, "chapter_id": 9240, "verse_number": "३-४४-२५", "content_sanskrit": "लक्ष्मणश्च महाबाहुः कामवस्थां गमिष्यति।\nइति संचिन्त्य धर्मात्मा रामो हृष्टतनूरुहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000240026, "chapter_id": 9240, "verse_number": "३-४४-२६", "content_sanskrit": "तत्र रामं भयं तीव्रमाविवेश विषादजम्।\nराक्षसं मृगरूपं तं हत्वा श्रुत्वा च तत्स्वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000240027, "chapter_id": 9240, "verse_number": "३-४४-२७", "content_sanskrit": "निहत्य पृषतं चान्यं मांसमादाय राघवः।\nत्वरमाणो जनस्थानं ससाराभिमुखं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000240028, "chapter_id": 9240, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे चतुश्चत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]