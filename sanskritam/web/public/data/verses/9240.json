[{"id": 40016063, "chapter_id": 9240, "verse_number": "1", "content_sanskrit": "धूम्राक्षंप्रेक्ष्यनिर्यान्तंराक्षसंभीमविक्रमम् । विनेदुर्वानरास्सर्वेप्रहृष्टायुद्धकाङ् क्षिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40016064, "chapter_id": 9240, "verse_number": "2", "content_sanskrit": "तेषांसुतुमुलंयुद्धंसञ्जज्ञेकपिरक्षसाम् । अन्योन्यंपादपैर्घोरंनिघ्नतांशूलमुद्गरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40016065, "chapter_id": 9240, "verse_number": "3", "content_sanskrit": "राक्षसैर्वानराघोराविनिकृत्तस्समन्ततः । वानरैराक्षसाश्चापिद्रुमैर्भूमिसमीकृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40016066, "chapter_id": 9240, "verse_number": "4", "content_sanskrit": "राक्षसास्त्वभिसङ्क्रुद्धावानरान्निशितैश्शरैः । विव्यथुर्घोरसङ्काशैःकङ्कपत्रैरजिह्मगैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40016067, "chapter_id": 9240, "verse_number": "5", "content_sanskrit": "तेगदाभिश्चभीमाभिःपट्टसै: कूटमुद्गरैः । घोरैश्चपरिघैश्चित्रैस्त्रिशूलैश्चापिसंश्रितैः ॥ विदार्यमाणारक्षोभिर्वानरास्तेमहाबलाः । अमर्षाज्जनितोद्धर्षाश्चक्रुःकर्माण्यभीतवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40016068, "chapter_id": 9240, "verse_number": "6", "content_sanskrit": "तेगदाभिश्चभीमाभिःपट्टसै: कूटमुद्गरैः । घोरैश्चपरिघैश्चित्रैस्त्रिशूलैश्चापिसंश्रितैः ॥ विदार्यमाणारक्षोभिर्वानरास्तेमहाबलाः । अमर्षाज्जनितोद्धर्षाश्चक्रुःकर्माण्यभीतवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40016069, "chapter_id": 9240, "verse_number": "7", "content_sanskrit": "शरनिर्भिन्नगात्रास्तेशूलनिर्भिन्नदेहिनः । जगृहुस्तेद्रुमांस्तत्रशिलाश्चहरियूथपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40016070, "chapter_id": 9240, "verse_number": "8", "content_sanskrit": "तेभीमवेगाहरयोनर्दमानास्ततस्ततः । ममन्थूराक्षसान्वीरान्नामानिचबभाषिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40016071, "chapter_id": 9240, "verse_number": "9", "content_sanskrit": "तद्भभूवाद्भुतंघोरंयुद्धंवानररक्षसाम् । शिलाभिर्विविधाभिश्चबहुभिश्चैवपादपैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40016072, "chapter_id": 9240, "verse_number": "10", "content_sanskrit": "राक्षसामथिताःकेचिद्वानरैर्जितकाशिभिः । ववमूरुधिरंकेचिन्मुखैरुधिरभोजनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40016073, "chapter_id": 9240, "verse_number": "11", "content_sanskrit": "पार्श्वेषुदारिताःकेचित्केचिद्राशीकृताद्रुमैः । शिलाभिश्चूर्णिताःकेचित्केचिद्धन्तैर्विदारिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40016074, "chapter_id": 9240, "verse_number": "12", "content_sanskrit": "ध्वजैर्विमथितैर्भग्नैःखङ्गैश्चविनिपातितैः । रथैर्विध्वंसितैश्चापिपतितैःरजनीचरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40016075, "chapter_id": 9240, "verse_number": "13", "content_sanskrit": "गजेन्द्रैःपर्वताकारैःपर्वताग्रैर्वनौकसाम् । मथितैर्वाजिभिःकीर्णंसारोहैर्वसुधातलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40016076, "chapter_id": 9240, "verse_number": "14", "content_sanskrit": "वानरैर्भीमविक्रान्स्सैराप्लुत्याऽप्लुत्यवेगितैः । राक्षसाःकरजैस्तीक्ष्णैर्मुखेषुविनिर्तिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40016077, "chapter_id": 9240, "verse_number": "15", "content_sanskrit": "विषण्णवदनाभूयोविप्रकीर्णशिरोरुहाः । मूढाश्शोणितगन्धेननिपेतुर्धरणीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40016078, "chapter_id": 9240, "verse_number": "16", "content_sanskrit": "अन्येतुपरमसङ्कृक्रुद्धाराक्षसाभीमनिश्वना: । तलैरेवाभिधावन्तिवज्रस्पर्शसमैर्हरीन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40016079, "chapter_id": 9240, "verse_number": "17", "content_sanskrit": "वानरैरापतन्तस्तेवेगितावेगवत्तरैः । मुष्टिभिश्चरणैर्दन्स्सैःपादपैश्चावपोथिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40016080, "chapter_id": 9240, "verse_number": "18", "content_sanskrit": "सैन्यंतुविद्रुतंदृष्टवाधूम्राक्षोराक्षसर्षभः । रोषेणकदनंचक्रेवानराणांयुयुत्सताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40016081, "chapter_id": 9240, "verse_number": "19", "content_sanskrit": "प्तासैःप्रमथिताःकेचिद्वानराश्शोणितस्रवाः । मुद्गरैराहताःकेचित्पातिताधरणीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40016082, "chapter_id": 9240, "verse_number": "20", "content_sanskrit": "परिघैर्मथिताःकेचिद्भिण्डिवालैर्विदारिताः । पट्टसैराहता: केचिद्विह्वलन्तोगतासवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40016083, "chapter_id": 9240, "verse_number": "21", "content_sanskrit": "केचिद्विनिहताश्शूलैरुधिरार्द्रावनौकसः । केचिद्विद्रावितानष्टाःसङ्क्रुद्धैराक्षसैर्युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40016084, "chapter_id": 9240, "verse_number": "22", "content_sanskrit": "विभिन्नहृदयाःकेचिदेकपार्श्वेनदारिताः । विदारितास्त्रिशूलैश्चकेचिदान्स्रैर्विनिःसृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40016085, "chapter_id": 9240, "verse_number": "23", "content_sanskrit": "तत्सुभीमंमहायुद्धंहरिराक्षससङ्कुलम् । प्रबभौशब्दबहुलंशिलापादपसङ्कुलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40016086, "chapter_id": 9240, "verse_number": "24", "content_sanskrit": "धनुर्ज्यातन्त्रिमधुरंहिक्कातालसमन्वितम् । मन्धस्न्तितसङ्गीतंतद्युद्धगान्धर्वमाबभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40016087, "chapter_id": 9240, "verse_number": "25", "content_sanskrit": "धूम्राक्षस्तुधनुष्पाणिर्वानरान्रणमूर्धनि । हसन्विद्रावयामासदिशस्तुशरवृष्टिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40016088, "chapter_id": 9240, "verse_number": "26", "content_sanskrit": "धूम्राक्षेणार्दितंसैन्यंव्यथितंप्रेक्ष्यमारुतिः । अभ्यवर्ततसङ्क्रुद्धःप्रगृह्यविपुलांशिलाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40016089, "chapter_id": 9240, "verse_number": "27", "content_sanskrit": "क्रोधाद् द्विद्द्विगुणताम्राक्षःपितृस्तुल्यपराक्रमः । शिलांतांपातयामासधूम्राक्षस्यरथंप्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40016090, "chapter_id": 9240, "verse_number": "28", "content_sanskrit": "आपततनींशिलांदृष्टवागदामुद्यम्यसम्भ्रमात् । रथादाप्लुत्यवेगेनवसुधायांव्यतिष्ठत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40016091, "chapter_id": 9240, "verse_number": "29", "content_sanskrit": "साप्रमथ्यरथंतस्यनिपपातशिलाभुवि । सचक्रकूबरसाश्वंसध्वजंसशरासनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40016092, "chapter_id": 9240, "verse_number": "30", "content_sanskrit": "सभङ् क्त्वातुरथंतस्यहनुमान् मारुतात्मजः । रक्षसांकदनंचक्रेसस्कन्धविटपैर्द्रुमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40016093, "chapter_id": 9240, "verse_number": "31", "content_sanskrit": "विभिन्नशिरसोभूत्वाराक्षसाश्शोणितोक्षिता: । द्रुमैःप्रमथिताश्चान्येनिपेतुर्धरणीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40016094, "chapter_id": 9240, "verse_number": "32", "content_sanskrit": "विद्राव्यराक्षसंसैन्यंहनुमान्मारुतात्मजः । गिरिशशिखरमादायधूम्राक्षमभिदुद्रुवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40016095, "chapter_id": 9240, "verse_number": "33", "content_sanskrit": "तमापतन्तंधूम्राक्षोगदामुद्यम्यवीर्यवान् । विनर्दमानःसहसाहनूमन्तमभिद्रवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40016096, "chapter_id": 9240, "verse_number": "34", "content_sanskrit": "तस्यक्रुद्धस्यरोषेणगदांतांबहुकण्टकाम् । पातयामासधूम्राक्षोमस्तकेऽथहनूमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40016097, "chapter_id": 9240, "verse_number": "35", "content_sanskrit": "ताडितःसतयातत्रगदयाभीमरूपया । सकपिर्मारुतबलस्तंप्रहारमचिन्तयन् ॥ धूम्राक्षस्यशिरोमध्येगिरिशृङ्गमपातयत् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 40016098, "chapter_id": 9240, "verse_number": "36", "content_sanskrit": "सविस्फारितसर्वाङ्गोगिरिशृङ्गेणताडितः । पपातसहसाभूमौविकीर्णइवपर्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 40016099, "chapter_id": 9240, "verse_number": "37", "content_sanskrit": "धूम्राक्षंनिहतंदृष्टवाहतशेषानिशाचराः ॥ त्रस्ताःप्रविविशुर्लङ्कांवध्यमानाःप्लवङ्गमैः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 40016100, "chapter_id": 9240, "verse_number": "38", "content_sanskrit": "सतुपवनसुतोनिहत्यशत्रून्क्षतजवहरिस्सरितश्चसन्निकीर्य । रिपुवधजनितश्रमोमहात्मामुदमगमत्कपिभिःसुपूज्यमानः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]