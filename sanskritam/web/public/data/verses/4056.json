[{"id": 2141701, "chapter_id": 4056, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2141702, "chapter_id": 4056, "verse_number": "१", "content_sanskrit": "कर्णं पराजितं दृष्ट्वा पार्थो वैराटिमब्रवीत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2141703, "chapter_id": 4056, "verse_number": "२", "content_sanskrit": "एतं मां प्रापयेदानीं रथबृन्दं प्रहारिणाम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2141704, "chapter_id": 4056, "verse_number": "३", "content_sanskrit": "यत्र शान्तनवो भीष्मः सर्वेषां नः पितामहः ।\nसुयुद्धं काङ्क्षमाणो वै रथे तिष्ठति दंसितः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2141705, "chapter_id": 4056, "verse_number": "४", "content_sanskrit": "ताळो वै काञ्चनो यत्र वज्रवैडूर्यभूषितः ।\nअतीव समरे भाति मातरिश्वप्रकम्पितः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2141706, "chapter_id": 4056, "verse_number": "५", "content_sanskrit": "दारुणं प्रहरिष्यामि रथबृन्दानि धन्विनाम् ।\nआदास्याम्यहमेतेषां धनुर्ज्यावेष्टनानि च\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2141707, "chapter_id": 4056, "verse_number": "६", "content_sanskrit": "अस्यन्तं दिव्यमस्त्राणि चित्रमुत्तर पश्यसि\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2141708, "chapter_id": 4056, "verse_number": "७", "content_sanskrit": "शतह्रदां जृम्भमाणां मेघस्थां प्रावृषीव च ।\nसुवर्णपृष्ठं गाण्डीवं पश्यन्तु कुरवो युधि\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2141709, "chapter_id": 4056, "verse_number": "८", "content_sanskrit": "दक्षिणेनाथ वामेन कतरेण स्विदस्यति ।\nइति मां शत्रवः सर्वे न विज्ञास्यन्ति सारथे\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2141710, "chapter_id": 4056, "verse_number": "९", "content_sanskrit": "अस्त्रोदकां शरावर्तां नागनक्रां रथह्रदाम् ।\nनदीं प्रस्कन्दयिष्यामि परलोकापहारिणीम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2141711, "chapter_id": 4056, "verse_number": "१०", "content_sanskrit": "पाणिपादशिरःपृष्ठबाहुस्कन्धचराचरम् ।\nवनं कुरूणां भेत्स्यामि भल्लैः सन्नतपर्वभिः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2141712, "chapter_id": 4056, "verse_number": "११", "content_sanskrit": "तूणीशयाः सुपुङ्खाग्रा निशिता दुन्दुभिस्वनाः ।\nमया प्रयुक्ताः सङ्ग्रामे कुरून् धक्ष्यन्ति सायकाः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2141713, "chapter_id": 4056, "verse_number": "१२", "content_sanskrit": "ध्वजवृक्षं शरतृणं नागाश्वश्वापदाकुलम् ।\nरथसिंहगणैर्युक्तं धनुर्वल्लिसमाकुलम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2141714, "chapter_id": 4056, "verse_number": "१३", "content_sanskrit": "वनमादीपयिष्यामि कुरूणामस्त्रतेजसा\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2141715, "chapter_id": 4056, "verse_number": "१४", "content_sanskrit": "जयतो भारतीं सेनामेकस्य मम संयुगे ।\nशतं मार्गा भविष्यन्ति पावकस्येव कानने\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2141716, "chapter_id": 4056, "verse_number": "१५", "content_sanskrit": "मया चक्रमिवाविद्धं सैन्यं द्रक्ष्यसि केवलम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2141717, "chapter_id": 4056, "verse_number": "१६", "content_sanskrit": "तानहं रथनीडेभ्यः परलोकाय शात्रवान् ।\nएकः प्रद्रावयिष्यामि चक्रपाणिरिवासुरान्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2141718, "chapter_id": 4056, "verse_number": "१७", "content_sanskrit": "असम्भ्रान्तो रथे तिष्ठन् समेषु विषमेषु च ।\nमार्गमावृत्य तिष्ठन्तमपि भेत्स्यामि पर्वतम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2141719, "chapter_id": 4056, "verse_number": "१८", "content_sanskrit": "अहमिन्द्रस्य सङ्ग्रामे द्विषतो बलदर्पितान् ।\nमातलिं सारथिं कृत्वा निवातकवचान् रणे\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2141720, "chapter_id": 4056, "verse_number": "१९", "content_sanskrit": "हतवान् सर्वतः सर्वान् धावतो युध्यतस्तदा\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2141721, "chapter_id": 4056, "verse_number": "२०", "content_sanskrit": "निवातकवचान् हत्वा गाण्डीवास्त्रैः सहस्रशः ।\nपरं पारे समुद्रस्य हिरण्यपुरमारुजम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2141722, "chapter_id": 4056, "verse_number": "२१", "content_sanskrit": "हत्वा षष्टिसहस्राणि रथानामुग्रधन्विनाम् ।\nपौलोमान् कालकेयांश्च सङ्ग्रामे भृशदारुणान्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2141723, "chapter_id": 4056, "verse_number": "२२", "content_sanskrit": "असुरानहनं रौद्रान् रौद्रेणास्त्रेण सारथे\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2141724, "chapter_id": 4056, "verse_number": "२३", "content_sanskrit": "अहमिन्द्राद् दृढां मुष्टिं ब्रह्मणः क्षिप्रहस्तताम् ।\nप्रगाढनिपुणं चित्रमतिविद्धं प्रजापतेः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2141725, "chapter_id": 4056, "verse_number": "२४", "content_sanskrit": "रौद्रं रुद्रादहं वेद्मि वारुणं वरुणादपि ।\nसौर्यं सूर्यादहं वेद्मि याम्यं दण्डधरादपि\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2141726, "chapter_id": 4056, "verse_number": "२५", "content_sanskrit": "अस्त्रमाग्नेयमग्नेश्च वायव्यं मातरिश्वनः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2141727, "chapter_id": 4056, "verse_number": "२६", "content_sanskrit": "वज्रादीनि तथास्त्राणि शक्रादहमवाप्तवान्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2141728, "chapter_id": 4056, "verse_number": "२७", "content_sanskrit": "अन्यैर्देवैरहं प्राप्तः को मां विषहते पुमान्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2141729, "chapter_id": 4056, "verse_number": "२८", "content_sanskrit": "अद्य गाण्डीवनिर्मुक्तैः शरौघै रोमहर्षणैः ।\nकुरूणां पातयिष्यामि रथबृन्दानि धन्विनाम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2141730, "chapter_id": 4056, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2141731, "chapter_id": 4056, "verse_number": "२९", "content_sanskrit": "एवमाश्वासितस्तेन वैराटिः सव्यसाचिना ।\nव्यगाहत रथानीकं भीष्मं भीष्मस्य वाजिभिः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2141732, "chapter_id": 4056, "verse_number": "३०", "content_sanskrit": "रथसिंहमनाक्षिप्य जिगीषन्तं परान् रणे ।\nअभ्यधावत् तदैवोग्रो ज्यां विकर्षन् धनञ्जयः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2141733, "chapter_id": 4056, "verse_number": "३१", "content_sanskrit": "दुःशासनोऽभ्ययात् तूर्णमर्जुनं भरतर्षभ\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2141734, "chapter_id": 4056, "verse_number": "३२", "content_sanskrit": "अन्येऽपि चित्राभरणा युवानो मृष्टकुण्डलाः ।\nअगच्छन् भीमधन्वानो मौर्वीं पर्यस्य बाहुभिः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2141735, "chapter_id": 4056, "verse_number": "३३", "content_sanskrit": "दुःशासनो विकर्णश्च वृषसेनो विविंशतिः ।\nअभीता भीमधन्वानं पाण्डवं पर्यवारयन्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2141736, "chapter_id": 4056, "verse_number": "३५", "content_sanskrit": "तस्य दुःशासनः षष्टिं वामे पार्श्वे समर्पयत् ।\nअस्यतः प्रतिसन्धाय कुन्तीपुत्रस्य धीमतः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2141737, "chapter_id": 4056, "verse_number": "३५", "content_sanskrit": "पुनश्चैव स भल्लेन विद्ध्वा वैराटिमुत्तरम् ।\nद्वितीयेनार्जुनं वीरं प्रत्यविध्यत् स्तनान्तरे\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2141738, "chapter_id": 4056, "verse_number": "३६", "content_sanskrit": "तस्य जिष्णुरुदावृत्य क्षुरधारेण कार्मुकम् ।\nप्राकृन्तद् गृध्रपत्रेण जातरूपपरिष्कृतम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2141739, "chapter_id": 4056, "verse_number": "३७", "content_sanskrit": "अथैनं पञ्चभिर्बाणैः प्रत्यविध्यत् स्तनान्तरे ।\nसोऽपयातो रथोपस्थात् पार्थबाणाभिपीडितः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2141740, "chapter_id": 4056, "verse_number": "३८", "content_sanskrit": "सर्वा दिशश्चाभ्यपतद् बीभत्सुरपराजितः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2141741, "chapter_id": 4056, "verse_number": "३९", "content_sanskrit": "तं विकर्णः शरैस्तीक्ष्णैः गृध्रपत्रैः शिलीमुखैः ।\nविव्याध परवीरघ्नमर्जुनं धृतराष्ट्रजः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2141742, "chapter_id": 4056, "verse_number": "४०", "content_sanskrit": "ततस्तमपि कौन्तेयः शरेण नतपर्वणा ।\nललाटेऽभ्यहनद् गाढं स विद्धः प्राद्रवद् भयात्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2141743, "chapter_id": 4056, "verse_number": "४१", "content_sanskrit": "ततः पार्थमभिद्रुत्य दुःसहः सविविंशतिः ।\nअवाकिरच्छरैस्तीक्ष्णैः परीप्सन् भारतं रणे\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2141744, "chapter_id": 4056, "verse_number": "४२", "content_sanskrit": "तावुभौ गृध्रपत्राभ्यां निशिताभ्यां धनञ्जयः ।\nविव्याध युगपद् व्यग्रः तयोर्वाहानसूदयत्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2141745, "chapter_id": 4056, "verse_number": "४३", "content_sanskrit": "तौ हताश्वौ प्रविद्धाङ्गौ धृतराष्ट्रात्मजावुभौ ।\nअभिपत्य रथैरन्यैरपनीतौ पदानुगैः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2141746, "chapter_id": 4056, "verse_number": "४४", "content_sanskrit": "व्यद्रावयदशेषांश्च धृतराष्ट्रात्मजांस्तदा ।\nविद्राव्य च रणे पार्थो रणभूमिं व्यराजयत्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2141747, "chapter_id": 4056, "verse_number": "४५", "content_sanskrit": "किरीटमाली कौन्तेयो लब्धलक्षः प्रतापवान् ।\nसर्वा दिशश्चाभ्यपतत् बीभत्सुरपराजितः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2141748, "chapter_id": 4056, "verse_number": "४६", "content_sanskrit": "पातयन्नुत्तमाङ्गानि बाहूंश्च परिघोपमान्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2141749, "chapter_id": 4056, "verse_number": "४७", "content_sanskrit": "अशेरत महावीराः शतशो रुग्ममालिनः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2141750, "chapter_id": 4056, "verse_number": "४८", "content_sanskrit": "कमलदिनकरेन्दुसन्निभैः\nसितदशनैः सुमुखाक्षिनासिकैः ।\nरुचिरमकुटकुण्डलैर्मही\nपुरुषशिरोभिरुपास्तृता बभौ\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2141751, "chapter_id": 4056, "verse_number": "४९", "content_sanskrit": "सुनसं चारुदीप्ताक्षं क्लृप्तश्मश्रु स्वलङ्कृतम् ।\nअदृश्यत शिरश्छिन्नमनेकं हेमकुण्डलम्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2141752, "chapter_id": 4056, "verse_number": "५०", "content_sanskrit": "एवं तत् प्रहतं सैन्यं समन्तात् प्रद्रुतं भयात्\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2141753, "chapter_id": 4056, "verse_number": "५१", "content_sanskrit": "क्षिपतो लघु चित्रं च सव्यं दक्षिणमस्यतः ।\nपार्थस्य विशिखा जग्मुः शतशोऽथ सहस्रशः\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2141754, "chapter_id": 4056, "verse_number": "५२", "content_sanskrit": "प्रमथन्नुत्तमाङ्गानि सोत्सेधानि धनुष्मताम् ।\nप्राहिणोत् त्रिशतं योधान् कुरूणामाततायिनाम्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2141755, "chapter_id": 4056, "verse_number": "५३", "content_sanskrit": "पातयन् रथनीडेभ्यः क्षत्रियान् क्षत्रियर्षभः ।\nप्रगाढधन्वा कौन्तेयो लब्धलक्षः प्रतापवान्\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2141756, "chapter_id": 4056, "verse_number": "५४", "content_sanskrit": "अथ दुर्योधनः कर्णः शकुनिः सौबलस्तदा ।\nद्रोणश्च द्रोणपुत्रश्च कृपश्चातिरथो रणे\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2141757, "chapter_id": 4056, "verse_number": "५५", "content_sanskrit": "सहिता विजयं तत्र योधयन्तो महारथाः ।\nविष्फारयन्तश्चापानि बलवन्ति महाबलाः\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2141758, "chapter_id": 4056, "verse_number": "५६", "content_sanskrit": "ततः स्वर्णपताकेन रथेनादित्यवर्चसा ।\nपुनरावृत्य मार्गस्थं ददृशुर्वानरध्वजम्\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2141759, "chapter_id": 4056, "verse_number": "५७", "content_sanskrit": "ते महास्त्रैर्महोत्साहाः परिवार्य धनञ्जयम् ।\nअभ्यवर्षन् सुसङ्क्रुद्धा मेघा इव महाचलम्\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2141760, "chapter_id": 4056, "verse_number": "५८", "content_sanskrit": "शरौघान् सम्यगस्यन्तो जीमूता इव वार्षिकाः ।\nयुद्धे तस्थुर्महावीर्याः प्रतपन्तं किरीटिनम्\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2141761, "chapter_id": 4056, "verse_number": "५९", "content_sanskrit": "इषुभिर्बहुभिस्तूर्णं निशितैर्लोमवापिभिः ।\nअदूरात् प्रत्यवस्थाय पाण्डवं समयोधयन्\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2141762, "chapter_id": 4056, "verse_number": "६०", "content_sanskrit": "ततः प्रहस्य बीभत्सुस्तदैन्द्रं पञ्चवार्षिकम् ।\nअस्त्रमादित्यसङ्काशं गाण्डीवे समयोजयत्\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2141763, "chapter_id": 4056, "verse_number": "६१", "content_sanskrit": "नाक्षाणां न च चक्राणां न रथानां न वाजिनाम् ।\nअङ्गुलाद् द्व्यङ्गुलाद्वापि विवृतं प्रत्यदृश्यत\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2141764, "chapter_id": 4056, "verse_number": "६२", "content_sanskrit": "मोहयित्वा च तान् सर्वान् स तत्र ह्यस्त्रतेजसा ।\nअर्दयामास तैर्बाणैरर्जुनः समितिञ्जयः\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2141765, "chapter_id": 4056, "verse_number": "६३", "content_sanskrit": "दुर्योधनं त्रिसप्तत्या शकुनिं पञ्चभिः शरैः ।\nद्रोणमेकेन बाणेन कृपं द्वाभ्यां महारथम्\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2141766, "chapter_id": 4056, "verse_number": "६४", "content_sanskrit": "अशीत्या सूतपुत्रं तु षष्ट्या द्रौणिं तथैव च ।\nदुःशासनमुखान् सर्वान् स तत्र ह्यस्त्रतेजसा ।\nअर्दयामास तैर्बाणैः पाण्डवोऽस्त्रभृतां वरः\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2141767, "chapter_id": 4056, "verse_number": "६५", "content_sanskrit": "यथा रश्मिभिरादित्यो वृणुते सर्वतो दिशम् ।\nएवं किरीटिना मुक्तं सर्वं प्राच्छादयज्जगत्\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2141768, "chapter_id": 4056, "verse_number": "६६", "content_sanskrit": "यथा बलाहके विद्युत् पावको वा शिलोच्चये ।\nतथा गाण्डीवमभवत् शतायुतमिवाद्भुतम्\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2141769, "chapter_id": 4056, "verse_number": "६७", "content_sanskrit": "यथा वर्षति पर्जन्यो विद्युत् पतति पर्वते ।\nविष्फूर्जितैः दिशः सर्वा ज्वलद्गाण्डीवमावृणोत्\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2141770, "chapter_id": 4056, "verse_number": "६८", "content_sanskrit": "त्रस्ताश्च रथिनः सर्वे चैन्द्रमस्त्रं विकुर्वति ।\nसर्वे शान्तिपरा योधाः स्वचित्तं नाभिजज्ञिरे\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2141771, "chapter_id": 4056, "verse_number": "६९", "content_sanskrit": "सहिता द्रोणभीष्माभ्यां प्रविमोहितचेतनाः\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2141772, "chapter_id": 4056, "verse_number": "७०", "content_sanskrit": "तानि सर्वाणि सैन्यानि भग्नानि भरतर्षभ ।\nप्राद्रवन्त दिशः सर्वा भयाद्वै सव्यसाचिनः\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2141773, "chapter_id": 4056, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां विराटपर्वणि चतुःषष्टितमोऽध्यायः ॥६४॥ गोग्रहणपर्वणि सप्तत्रिंशोऽध्यायः ॥३७॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}]