[{"id": 2149894, "chapter_id": 4248, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2149895, "chapter_id": 4248, "verse_number": "१", "content_sanskrit": "ततस्तृतीये दिवसे समे देशे व्यवस्थितः ।\nप्रेषयामास मे राजन् प्राप्तोऽस्मीति महाव्रतः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2149896, "chapter_id": 4248, "verse_number": "२", "content_sanskrit": "तमागतमहं श्रुत्वा विषयान्तं महाबलम् ।\nअभ्यगच्छं जवेनाशु प्रीत्या तेजोनिधिं प्रभुम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2149897, "chapter_id": 4248, "verse_number": "३", "content_sanskrit": "गां पुरस्कृत्य राजेन्द्र ब्राह्मणैः परिवारितः ।\nऋत्विग्भिर्देवकल्पैश्च तथैव च पुरोहितैः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2149898, "chapter_id": 4248, "verse_number": "४", "content_sanskrit": "स मामभिगतं दृष्ट्वा जामदग्न्यः प्रतापवान् ।\nप्रतिजग्राह तां पूजां वचनं चेदमब्रवीत्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2149899, "chapter_id": 4248, "verse_number": "५", "content_sanskrit": "भीष्म कां बुद्धिमास्थाय काशिराजसुता त्वया ।\nअकामेयमिहानीता पुनश्चैव विसर्जिता\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2149900, "chapter_id": 4248, "verse_number": "६", "content_sanskrit": "विभ्रंशिता त्वया हीयं धर्मादास्ते यशस्विनी ।\nपरामृष्टां त्वया हीमां को हि गन्तुमिहार्हति\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2149901, "chapter_id": 4248, "verse_number": "७", "content_sanskrit": "प्रत्याख्याता हि साल्वेन त्वया नीतेति भारत ।\nतस्मादिमां मन्नियोगात् प्रतिगृह्णीष्व भारत\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2149902, "chapter_id": 4248, "verse_number": "८", "content_sanskrit": "स्वधर्मं पुरुषव्याघ्र राजपुत्री लभत्वियम् ।\nन युक्तमवमानोऽयं राज्ञा कर्तुं त्वयाऽनघ\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2149903, "chapter_id": 4248, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2149904, "chapter_id": 4248, "verse_number": "९", "content_sanskrit": "ततस्तं वै विमनसमुदीक्ष्याहमथाब्रवम् ।\nनाहमेनां पुनर्दद्यां ब्रह्मन् भ्रात्रे कथञ्चन\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2149905, "chapter_id": 4248, "verse_number": "१०", "content_sanskrit": "साल्वस्याहमिति प्राह पुरा मामेव भार्गव ।\nमया चैवाभ्यनुज्ञाता गता सौभपुरं प्रति\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2149906, "chapter_id": 4248, "verse_number": "११", "content_sanskrit": "न भयान्नाप्यनुक्रोशान्न लोभान्नार्थकाम्यया ।\nक्षात्रं धर्ममहं जह्यामिति मे व्रतमाहितम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2149907, "chapter_id": 4248, "verse_number": "१२", "content_sanskrit": "अथ मामब्रवीद् रामः क्रोधपर्याकुलेक्षणः ।\nन करिष्यसि चेदेतद् वाक्यं मे नरपुङ्गव\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2149908, "chapter_id": 4248, "verse_number": "१३", "content_sanskrit": "हनिष्यामि सहामात्यं त्वामद्येति पुनः पुनः ।\nसंरम्भादब्रवीद् रामः क्रोधपर्याकुलेक्षणः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2149909, "chapter_id": 4248, "verse_number": "१४", "content_sanskrit": "तमहं गीर्भिरिष्टाभिः पुनः पुनररिन्दम ।\nअयाचं भृगुशार्दूलं न चैव प्रशशाम सः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2149910, "chapter_id": 4248, "verse_number": "१५", "content_sanskrit": "यदा प्रयाच्यमानोऽपि प्रसादं न करोति मे\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2149911, "chapter_id": 4248, "verse_number": "१६", "content_sanskrit": "प्रणम्य तमहं मूर्ध्ना भूयो ब्राह्मणसत्तमम् ।\nअब्रवं कारणं किं तद् यत् त्वं योद्धुमिहेच्छसि\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2149912, "chapter_id": 4248, "verse_number": "१७", "content_sanskrit": "इष्वस्त्रं मम बालस्य त्वया चैव चतुर्विधम् ।\nउपदिष्टं महाबाहो शिष्योऽस्मि तव भार्गव\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2149913, "chapter_id": 4248, "verse_number": "१८", "content_sanskrit": "ततो मामब्रवीद् रामः क्रोधसंरक्तलोचनः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2149914, "chapter_id": 4248, "verse_number": "१९", "content_sanskrit": "जानीषे मां गुरुं भीष्म न चेमां प्रतिगृह्णसे ।\nसुतां काश्यस्य कौरव्य मत्प्रियार्थं महीपते\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2149915, "chapter_id": 4248, "verse_number": "२०", "content_sanskrit": "न हि मे विद्यते शान्तिरन्यथा कुरुसत्तम ।\nगृहाणेमां महाबाहो रक्षस्व कुलमात्मनः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2149916, "chapter_id": 4248, "verse_number": "२१", "content_sanskrit": "त्वया विभ्रंशिता हीयं भर्तारं नाधिगच्छति\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2149917, "chapter_id": 4248, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2149918, "chapter_id": 4248, "verse_number": "२२", "content_sanskrit": "तथा ब्रुवन्तं तमहं रामं परपुरञ्जयम् ।\nनैतदेवं पुनर्भावि ब्रह्मर्षे किं श्रमेण ते\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2149919, "chapter_id": 4248, "verse_number": "२३", "content_sanskrit": "गुरुत्वं त्वयि सम्प्रेक्ष्य जामदग्न्य पुरातनम् ।\nप्रसादये त्वां भगवन् त्यक्तैषा तु पुरा मया\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2149920, "chapter_id": 4248, "verse_number": "२४", "content_sanskrit": "को जातु परभावां हि नारीं व्यालीमिव स्थिताम् ।\nवासयेत गृहे जानन् स्त्रीणां दोषान् महात्ययान्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2149921, "chapter_id": 4248, "verse_number": "२५", "content_sanskrit": "न भयाद् वासवस्यापि धर्मं जह्यां महाव्रत ।\nप्रसीद मा वा यद्वा ते कार्यं तत् कुरु मा चिरम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2149922, "chapter_id": 4248, "verse_number": "२६", "content_sanskrit": "अयं चापि विशुद्धात्मन् पुराणे श्रूयते विभो ।\nमरुत्तेन महाबुद्धे गीतः श्लोको महात्मना\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2149923, "chapter_id": 4248, "verse_number": "२७", "content_sanskrit": "गुरोरप्यवलिप्तस्य कार्याकार्यमजानतः ।\nउत्पथं प्रतिपन्नस्य कार्यं भवति शासनम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2149924, "chapter_id": 4248, "verse_number": "२८", "content_sanskrit": "स त्वं गुरुरिति प्रेम्णा मया सम्मानितो भृशम् ।\nगुरुवृत्तिं न जानीषे तस्माद् योत्स्यामि वै त्वया\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2149925, "chapter_id": 4248, "verse_number": "२९", "content_sanskrit": "गुरुं न हन्यां समरे ब्राह्मणं च विशेषतः ।\nविशेषतस्तपोवृद्धमेवं क्षान्तं मया तव\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2149926, "chapter_id": 4248, "verse_number": "३०", "content_sanskrit": "उद्यतेषुं रणे दृष्ट्वा ब्राह्मणं क्षत्रबन्धुवत् ।\nयो हन्यात् समरे क्रुद्धं युध्यन्तमपलायिनम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2149927, "chapter_id": 4248, "verse_number": "३१", "content_sanskrit": "ब्रह्महत्या न तस्य स्यादिति धर्मेषु निश्चयः ।\nक्षत्रियाणां स्थितो धर्मे क्षत्रियोऽस्मि तपोधन\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2149928, "chapter_id": 4248, "verse_number": "३२", "content_sanskrit": "यो यथा वर्तते यस्मिन् तथा तस्मिन् प्रवर्तते ।\nनाधर्मं समवाप्नोति नरः श्रेयश्च विन्दति\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2149929, "chapter_id": 4248, "verse_number": "३३", "content_sanskrit": "अर्थे वा यदि वा धर्मे समर्थो देशकालवित् ।\nअनर्थे संशयापन्नः श्रेयान् निःसंशयो नरः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2149930, "chapter_id": 4248, "verse_number": "३४", "content_sanskrit": "तस्मात् संशयितेऽप्यर्थे यथान्यायं प्रवर्तयेत् ।\nतस्माद् योत्स्यामि सहितस्त्वया राम महाहवे\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2149931, "chapter_id": 4248, "verse_number": "३५", "content_sanskrit": "पश्य मे बाहुवीर्यं च विक्रमं चातिमानुषम् ।\nएवं गतेऽपि तु मया यच्छक्यं भृगुनन्दन\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2149932, "chapter_id": 4248, "verse_number": "३६", "content_sanskrit": "तत् करिष्ये कुरुक्षेत्रे योत्स्ये विप्र त्वया सह\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2149933, "chapter_id": 4248, "verse_number": "३७", "content_sanskrit": "द्वन्द्वे राम यथेष्टं ते सज्जीभव महाद्युते\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2149934, "chapter_id": 4248, "verse_number": "३८", "content_sanskrit": "तत्र त्वं निहतो राम मया शरशतार्दितः ।\nप्राप्स्यसे निर्जिताँल्लोकान् शस्त्रपूतो मया रणे\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2149935, "chapter_id": 4248, "verse_number": "३९", "content_sanskrit": "सङ्गच्छ विनिवर्तस्व कुरुक्षेत्रं रणप्रिय ।\nसमाह्वय महाबाहो युद्धाय त्वं तपोधन\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2149936, "chapter_id": 4248, "verse_number": "४०", "content_sanskrit": "अपि यत्र त्वया राम कृतं शौचं पुरा पितुः ।\nतत्राहमपि हत्वा त्वां शौचं कर्तास्मि भार्गव\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2149937, "chapter_id": 4248, "verse_number": "४१", "content_sanskrit": "तत्र राम स गच्छ त्वं त्वरितं युद्धदुर्मदः ।\nव्यपनेष्यामि ते दर्पं पौराणं ब्राह्मणब्रुव\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2149938, "chapter_id": 4248, "verse_number": "४२", "content_sanskrit": "यच्चापि कत्थसे राम बहुशः परिषत्सु वै ।\nनिर्जिताः क्षत्रिया लोके मयैकेनेति तच्छृणु\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2149939, "chapter_id": 4248, "verse_number": "४३", "content_sanskrit": "न तदा जातवान् भीष्मः क्षत्रियोऽपि हि मद्विधः ।\nपश्चाज्जातानि तेजांसि तृणेषु ज्वलितं यथा\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2149940, "chapter_id": 4248, "verse_number": "४४", "content_sanskrit": "यस्ते युद्धगतं दर्पं कामं च व्यपनाशयेत् ।\nसोऽहं जातो महाबाहो भीष्मः परपुरञ्जयः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2149941, "chapter_id": 4248, "verse_number": "४५", "content_sanskrit": "व्यपनेष्यामि ते दर्पं युद्धे राम न संशयः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2149942, "chapter_id": 4248, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि एकोनाशीत्युत्तरशततमोऽध्यायः ॥१७९॥\nअम्बोपाख्यानपर्वणि नवमोऽध्यायः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]