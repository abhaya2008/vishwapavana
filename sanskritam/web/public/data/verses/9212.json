[{"id": 5000212000, "chapter_id": 9212, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे षोडशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000212001, "chapter_id": 9212, "verse_number": "३-१६-१", "content_sanskrit": "अथ पञ्चवटीं गच्छन्नन्तरा रघुनन्दनः।\nआससाद महाकायं गृध्रं भीमपराक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000212002, "chapter_id": 9212, "verse_number": "३-१६-२", "content_sanskrit": "तं दृष्ट्वा तौ महाभागौ वनस्थं रामलक्ष्मणौ।\nमेनाते राक्षसं पक्षिं ब्रुवाणौ को भवानिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000212003, "chapter_id": 9212, "verse_number": "३-१६-३", "content_sanskrit": "ततो मधुरया वाचा सौम्यया प्रीणयन्निव।\nउवाच वत्स मां विद्धि वयस्यं पितुरात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000212004, "chapter_id": 9212, "verse_number": "३-१६-४", "content_sanskrit": "स तं पितृसखं मत्वा पूजयामास राघवः।\nस तस्य कुलमव्यग्रमथ पप्रच्छ नाम च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000212005, "chapter_id": 9212, "verse_number": "३-१६-५", "content_sanskrit": "रामस्य वचनं श्रुत्वा कुलमात्मानमेव च।\nआचचक्षे द्विजस्तस्मै सर्वभूतसमुद्भवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000212006, "chapter_id": 9212, "verse_number": "३-१६-६", "content_sanskrit": "पूर्वकाले महाबाहो ये प्रजापतयोऽभवन्।\nतान् मे निगदतः सर्वानादितः शृणु राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000212007, "chapter_id": 9212, "verse_number": "३-१६-७", "content_sanskrit": "कर्दमः प्रथमस्तेषां विकृतस्तदनन्तरम्।\nशेषश्च संश्रयश्चैव बहुपुत्रश्च वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000212008, "chapter_id": 9212, "verse_number": "३-१६-८", "content_sanskrit": "स्थाणुर्मरीचरत्रिश्च क्रतुश्चैव महाबलः।\nपुलस्त्यश्चाङ्गिराश्चैव प्रचेताः पुलहस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000212009, "chapter_id": 9212, "verse_number": "३-१६-९", "content_sanskrit": "दक्षो विवस्वानपरोऽरिष्टनेमिश्च राघव।\nकश्यपश्च महातेजास्तेषामासीच्च पश्चिमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000212010, "chapter_id": 9212, "verse_number": "३-१६-१०", "content_sanskrit": "प्रजापतेस्तु दक्षस्य बभूवुरिति विश्रुताः।\nषष्टिर्दुहितरो राम यशस्विन्यो महायशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000212011, "chapter_id": 9212, "verse_number": "३-१६-११", "content_sanskrit": "कश्यपः प्रतिजग्राह तासामष्टौ सुमध्यमाः।\nअदितिं च दितिं चैव दनूमपि च कालकाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000212012, "chapter_id": 9212, "verse_number": "३-१६-१२", "content_sanskrit": "ताम्रां क्रोधवशां चैव मनुं चाप्यनलामपि।\nतास्तु कन्यास्ततः प्रीतः कश्यपः पुनरब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000212013, "chapter_id": 9212, "verse_number": "३-१६-१३", "content_sanskrit": "पुत्रांस्त्रैलोक्यभर्तॄन् वै जनयिष्यथ मत्समान्।\nअदितिस्तन्मना राम दितिश्च दनुरेव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000212014, "chapter_id": 9212, "verse_number": "३-१६-१४", "content_sanskrit": "कालका च महाबाहो शेषास्त्वमनसोऽभवन्।\nअदित्यां जज्ञिरे देवास्त्रयस्त्रिंशदरिंदम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000212015, "chapter_id": 9212, "verse_number": "३-१६-१५", "content_sanskrit": "आदित्या वसवो रुद्रा अश्विनौ च परंतप।\nदितिस्त्वजनयत् पुत्रान् दैत्यांस्तात यशस्विनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000212016, "chapter_id": 9212, "verse_number": "३-१६-१६", "content_sanskrit": "तेषामियं वसुमती पुराऽऽसीत् सवनार्णवा।\nदनुस्त्वजनयत् पुत्रमश्वग्रीवमरिंदम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000212017, "chapter_id": 9212, "verse_number": "३-१६-१७", "content_sanskrit": "नरकं कालकं चैव कालकापि व्यजायत।\nक्रौञ्चीं भासीं तथा श्येनीं धृतराष्ट्रीं तथा शुकीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000212018, "chapter_id": 9212, "verse_number": "३-१६-१८", "content_sanskrit": "ताम्रा तु सुषुवे कन्याः पञ्चैता लोकविश्रुताः।\nउलूकाञ्जनयत् क्रौञ्ची भासी भासान् व्यजायत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000212019, "chapter_id": 9212, "verse_number": "३-१६-१९", "content_sanskrit": "श्येनी श्येनांश्च गृध्रांश्च व्यजायत सुतेजसः।\nधृतराष्ट्री तु हंसांश्च कलहंसाश्च सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000212020, "chapter_id": 9212, "verse_number": "३-१६-२०", "content_sanskrit": "चक्रवाकांश्च भद्रं ते विजज्ञे सापि भामिनी।\nशुकी नतां विजज्ञे तु नतायां विनता सुता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000212021, "chapter_id": 9212, "verse_number": "३-१६-२१", "content_sanskrit": "दश क्रोधवशा राम विजज्ञेऽप्यात्मसंभवाः।\nमृगीं च मृगमन्दां च हरीं भद्रमदामपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000212022, "chapter_id": 9212, "verse_number": "३-१६-२२", "content_sanskrit": "मातङ्गीमथ शार्दूलीं श्वेतां च सुरभीं तथा।\nसर्वलक्षणसम्पन्नां सुरसां कद्रुकामपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000212023, "chapter_id": 9212, "verse_number": "३-१६-२३", "content_sanskrit": "अपत्यं तु मृगाः सर्वे मृग्या नरवरोत्तम।\nऋक्षाश्च मृगमन्दायाः सृमराश्चमरास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000212024, "chapter_id": 9212, "verse_number": "३-१६-२४", "content_sanskrit": "ततस्त्विरावतीं नाम जज्ञे भद्रमदा सुताम्।\nतस्यास्त्वैरावतः पुत्रो लोकनाथो महागजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000212025, "chapter_id": 9212, "verse_number": "३-१६-२५", "content_sanskrit": "हर्याश्च हरयोऽपत्यं वानराश्च तपस्विनः।\nगोलाङ्गूलाश्च शार्दूली व्याघ्रांश्चाजनयत् सुतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000212026, "chapter_id": 9212, "verse_number": "३-१६-२६", "content_sanskrit": "मातङ्ग्यास्त्वथ मातङ्गा अपत्यं मनुजर्षभ।\nदिशागजं तु काकुत्स्थ श्वेता व्यजनयत् सुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000212027, "chapter_id": 9212, "verse_number": "३-१६-२७", "content_sanskrit": "ततो दुहितरौ राम सुरभिर्द्वे व्यजायत।\nरोहिणीं नाम भद्रं ते गन्धर्वीं च यशस्विनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000212028, "chapter_id": 9212, "verse_number": "३-१६-२८", "content_sanskrit": "रोहिण्यजनयद् गावो गन्धर्वी वाजिनः सुतान्।\nसुरसाजनयन्नागान् राम कद्रूश्च पन्नगान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000212029, "chapter_id": 9212, "verse_number": "३-१६-२९", "content_sanskrit": "मनुर्मनुष्याञ्जनयत् कश्यपस्य महात्मनः।\nब्राह्मणान् क्षत्रियान् वैश्यान् शूद्रांश्च मनुजर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000212030, "chapter_id": 9212, "verse_number": "३-१६-३०", "content_sanskrit": "मुखतो ब्राह्मणा जाता उरसः क्षत्रियास्तथा।\nऊरुभ्यां जज्ञिरे वैश्याः पद्‍भ्यां शूद्रा इति श्रुतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000212031, "chapter_id": 9212, "verse_number": "३-१६-३१", "content_sanskrit": "सर्वान् पुण्यफलान् वृक्षाननलापि व्यजायत।\nविनता च शुकीपौत्री कद्रूश्च सुरसास्वसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000212032, "chapter_id": 9212, "verse_number": "३-१६-३२", "content_sanskrit": "कद्रूर्नागसहस्रं तु विजज्ञे धरणीधरान्।\nद्वौ पुत्रौ विनतायास्तु गरुडोऽरुण एव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000212033, "chapter_id": 9212, "verse_number": "३-१६-३३", "content_sanskrit": "तस्माज्जातोऽहमरुणात् सम्पातिश्च ममाग्रजः।\nजटायुरिति मां विद्धि श्येनीपुत्रमरिंदम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000212034, "chapter_id": 9212, "verse_number": "३-१६-३४", "content_sanskrit": "सोऽहं वाससहायस्ते भविष्यामि यदीच्छसि।\nइदं दुर्गं हि कान्तारं मृगराक्षससेवितम्।\nसीतां च तात रक्षिष्ये त्वयि याते सलक्ष्मणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000212035, "chapter_id": 9212, "verse_number": "३-१६-३५", "content_sanskrit": "जटायुषं तु प्रतिपूज्य राघवो\nमुदा परिष्वज्य च संनतोऽभवत् ।\nपितुर्हि शुश्राव सखित्वमात्मवा-\nञ्जटायुषा संकथितं पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000212036, "chapter_id": 9212, "verse_number": "३-१६-३६", "content_sanskrit": "स तत्र सीतां परिदाय मैथिलीं\nसहैव तेनातिबलेन पक्षिणा।\nजगाम तां पञ्चवटीं सलक्ष्मणो\nरिपून् दिधक्षन् शलभानिवानलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000212037, "chapter_id": 9212, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे षोडशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]