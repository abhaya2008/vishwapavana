[{"id": 2027555, "chapter_id": 1592, "verse_number": "३-२३०-०x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2027556, "chapter_id": 1592, "verse_number": "३-२३०-१", "content_sanskrit": "श्रिया जुष्टं महासेनं देवसेनापतीकृतम्।\nसप्तर्षिपत्नयः षड् देव्यस्तत्सकाशमथागमन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2027557, "chapter_id": 1592, "verse_number": "३-२३०-२", "content_sanskrit": "ऋषिभिः संपरित्यक्ता धर्मयुक्ता महाव्रताः।\nद्रुतमागम्य चोचुस्ता देवसेनापतिं प्रभुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2027558, "chapter_id": 1592, "verse_number": "३-२३०-३", "content_sanskrit": "वयं पुत्र परित्यक्तां भर्तृभिर्देवसंमितैः।\nअकारणाद्रुषा तैस्तु पुण्यस्थानात्परिच्युताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2027559, "chapter_id": 1592, "verse_number": "३-२३०-४", "content_sanskrit": "अस्माभिः किल जातस्त्वमिति केनाप्युदाहृतम्।\nतत्सत्यमेतत्संश्रुत्य तस्मान्नस्त्रातुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2027560, "chapter_id": 1592, "verse_number": "३-२३०-५", "content_sanskrit": "अक्षयश्च भवेत्स्वर्गस्त्वत्प्रसादाद्धि नः प्रभो।\nत्वां पुत्रं चाप्यभीप्सामः कृत्वैतदनृणो भव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2027561, "chapter_id": 1592, "verse_number": "३-२३०-६x", "content_sanskrit": "स्कन्द उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2027562, "chapter_id": 1592, "verse_number": "३-२३०-६", "content_sanskrit": "मातरो हि भवत्यो मे सुतो वोऽहमनिन्दिताः।\nयद्वापीच्छत तत्सर्वं संभविष्यति वस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2027563, "chapter_id": 1592, "verse_number": "३-२३०-७x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2027564, "chapter_id": 1592, "verse_number": "३-२३०-७", "content_sanskrit": "विवक्षन्तं ततः शक्रं किं कार्यमिति सोऽब्रवीत्।\nउक्तः स्कन्देन ब्रूहिति सोऽब्रवीद्वासवस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2027565, "chapter_id": 1592, "verse_number": "३-२३०-८", "content_sanskrit": "अभिजित्स्पर्धमाना तु रोहिण्या कन्यसी स्वसा।\nइच्छन्ती ज्येष्ठतां देवी तपस्तप्तुं वनं गता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2027566, "chapter_id": 1592, "verse_number": "३-२३०-९", "content_sanskrit": "तत्र मूढोस्मि भद्रं ते नक्षत्रं गगनाच्च्युतम्।\nकालं त्विमं परं स्कन्द ब्रह्मणा सह चिन्तय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2027567, "chapter_id": 1592, "verse_number": "३-२३०-१०", "content_sanskrit": "धनिष्ठादिस्तदा कालो ब्रह्मणा परिकल्पितः।\nरोहिणो ह्यभवत्पूर्वमेवं सङ्ख्या समाभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2027568, "chapter_id": 1592, "verse_number": "३-२३०-११", "content_sanskrit": "एवमुक्ते तु शक्रेण त्रिविदं कृत्तिका गताः।\nनक्षत्रं शकटाकारं भाति तद्वह्निदैवतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2027569, "chapter_id": 1592, "verse_number": "३-२३०-१२", "content_sanskrit": "विनता चाब्रवीत्स्कन्दं मम त्वं पिण्डदः सुतः।\nइच्छामि नित्यमेवाहं त्वया पुत्र सहासितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2027570, "chapter_id": 1592, "verse_number": "३-२३०-१३x", "content_sanskrit": "स्कन्द उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2027571, "chapter_id": 1592, "verse_number": "३-२३०-१३", "content_sanskrit": "एवमस्तु नमस्तेऽस्तु पुत्रस्नेहात्प्रशाधि माम्।\nस्नुषया पूज्यमाना वै देवि वत्स्यसि नित्यदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2027572, "chapter_id": 1592, "verse_number": "३-२३०-१४x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2027573, "chapter_id": 1592, "verse_number": "३-२३०-१४", "content_sanskrit": "अथ मातृगणः सर्वः स्कन्दं वचनमब्रवीत्।\nवयं सर्वस्य लोकस्य मातरः कविभिः स्तुताः।\nइच्छामो मातरस्तुभ्यं भवितुं पूजयस्व नः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2027574, "chapter_id": 1592, "verse_number": "३-२३०-१५", "content_sanskrit": "`तासां तु वचनं श्रुत्वास्कन्दो वचनमब्रवीत्।\nमातरो हि भवत्यो मे भवतीनामहं सुतः।\nउच्यतां यन्मया कार्यं भवतीनामथेप्सितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2027575, "chapter_id": 1592, "verse_number": "३-२३०-१६x", "content_sanskrit": "मातर ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2027576, "chapter_id": 1592, "verse_number": "३-२३०-१६", "content_sanskrit": "यास्तु ता मातरः पूर्वं लोकस्यास्य प्रकल्पिताः।\nअस्माकं तु भवेत्स्थानं तासां चैव न तद्भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2027577, "chapter_id": 1592, "verse_number": "३-२३०-१७", "content_sanskrit": "भवेम पूज्या लोकस्य न ताः पूज्याः सुरर्षभ।\nप्रजाऽस्माकं हृतास्ताभिस्त्वत्कृते ताः प्रयच्छ नः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2027578, "chapter_id": 1592, "verse_number": "३-२३०-१८x", "content_sanskrit": "स्कन्द उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2027579, "chapter_id": 1592, "verse_number": "३-२३०-१८", "content_sanskrit": "वृत्ताः प्रजा न ताः प्रक्या भवतीभिर्निषेवितुम्।\nअन्प्रां वः कां प्रयच्छामि प्रजां यां मनसेच्छथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2027580, "chapter_id": 1592, "verse_number": "३-२३०-१९x", "content_sanskrit": "मातर ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2027581, "chapter_id": 1592, "verse_number": "३-२३०-१९", "content_sanskrit": "इच्चाम तासां मातॄणां प्रजा भोक्तुं प्रयच्छ नः।\nत्वया सह पृथग्भूता ये च तासामथेश्वराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2027582, "chapter_id": 1592, "verse_number": "३-२३०-२०x", "content_sanskrit": "स्कन्द उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2027583, "chapter_id": 1592, "verse_number": "३-२३०-२०", "content_sanskrit": "प्रजा वो दद्मि कष्टं तु भवतीभिरुदाहृतम्।\nपरिरक्षत भद्रं वः प्रजा साधुनमस्कृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2027584, "chapter_id": 1592, "verse_number": "३-२३०-२१x", "content_sanskrit": "मातर ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2027585, "chapter_id": 1592, "verse_number": "३-२३०-२१", "content_sanskrit": "परिरक्षाम भद्रं ते प्रजाः स्कन्द यथेच्छसि।\nत्वया नो रोचते स्कन्द सहवासश्चिरंप्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2027586, "chapter_id": 1592, "verse_number": "३-२३०-२२x", "content_sanskrit": "स्कन्द उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2027587, "chapter_id": 1592, "verse_number": "३-२३०-२२", "content_sanskrit": "यावत्षोडश वर्षाणि भवन्ति तरुणाः प्रजाः।\nप्रबाधत मनुष्याणां तावद्रूपैः पृथग्विधैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2027588, "chapter_id": 1592, "verse_number": "३-२३०-२३", "content_sanskrit": "अहं च वः प्रदास्यामि रौद्रमात्मानमव्ययम्।\nपरमं तेन सहिताः सुखं वत्स्यथ पूजिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2027589, "chapter_id": 1592, "verse_number": "३-२३०-२३x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2027590, "chapter_id": 1592, "verse_number": "३-२३०-२४", "content_sanskrit": "ततः शरीरात्स्कन्दस्य परुषः पावकप्रभः।\nभोक्तुं प्रजाः स मर्त्यानां निष्पपात महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2027591, "chapter_id": 1592, "verse_number": "३-२३०-२५", "content_sanskrit": "अपतत्सहसा भूमौ विसंज्ञोऽथ क्षुधार्दितः।\nस्कन्देन सोऽभ्यनुज्ञातो रौद्ररूपोऽभवद्ग्रहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2027592, "chapter_id": 1592, "verse_number": "३-२३०-२६", "content_sanskrit": "स्कन्दापस्मार इत्याहुर्गृहं तं द्विजसत्तमाः।\nविनता तु महारौद्रा कथ्यते शकुनिग्रहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2027593, "chapter_id": 1592, "verse_number": "३-२३०-२७", "content_sanskrit": "मातॄणां राक्षसंप्राहुस्तं विद्यात्पूतनाग्रहम्।\nकष्टा दारुणरूपेण घोररूपा निशाचरी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2027594, "chapter_id": 1592, "verse_number": "३-२३०-२८", "content_sanskrit": "पशाची रदारुणाकारा कथ्यते शीतपूतना।\nगर्भान्सा मानुषीणां तु हरते घोरदर्शना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2027595, "chapter_id": 1592, "verse_number": "३-२३०-२९", "content_sanskrit": "अदितिं रेवतीं प्राहुर्ग्रहस्तस्यास्तु रैवतः।\nसोऽपि बालान्महागोरो बाधते वै महाग्रहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2027596, "chapter_id": 1592, "verse_number": "३-२३०-३०", "content_sanskrit": "दैत्यानां या दितिर्माता तामाहुर्मुखमण्डिकाम्।\nअत्यर्थं शिशुमांसेन संप्रहृष्टा दुरासदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2027597, "chapter_id": 1592, "verse_number": "३-२३०-३१", "content_sanskrit": "कुमाराश्च कुमार्यश् ये प्रोक्ताः स्कन्दसंभवाः।\nतेऽपि गर्भभुजः सर्वे कौरव्यसुमहाग्रहाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2027598, "chapter_id": 1592, "verse_number": "३-२३०-३२", "content_sanskrit": "तासामेव तु पत्नीनां पतयस्ते प्रकीर्तिताः।\nआजायमानान्गृह्णन्ति बालकान्रौद्रकर्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2027599, "chapter_id": 1592, "verse_number": "३-२३०-३३", "content_sanskrit": "गवां माता तु या प्राज्ञैः कथ्यते सुरभिर्नृप।\nशकुनिस्तामथारुह्यसह भुङ्क्ते शिशून्भुवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2027600, "chapter_id": 1592, "verse_number": "३-२३०-३४", "content_sanskrit": "सरमा नाम या माता शुनां देवी जनाधिप।\nसाऽपिगर्भान्समादत्ते मानुषीणां सदैव हि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2027601, "chapter_id": 1592, "verse_number": "३-२३०-३५", "content_sanskrit": "पादपानां च या माता करञ्जनिलया हि सा।\nवरदा सा हि सौम्या च नित्यं भूतानुकम्पिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2027602, "chapter_id": 1592, "verse_number": "३-२३०-३६", "content_sanskrit": "करञ्जे तां नमस्यन्ति तस्मात्पुत्रार्थिनो नराः।\nइमे त्वष्टादशान्ये वै ग्रहा मांसमधुप्रियाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2027603, "chapter_id": 1592, "verse_number": "३-२३०-३७", "content_sanskrit": "द्विपञ्चरात्रं तिष्ठन्ति सततं सूतिकागृहे।\nकद्रूः सूक्ष्मवपुर्भूत्वा गर्भिणीं प्रविशत्यथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2027604, "chapter_id": 1592, "verse_number": "३-२३०-३८", "content_sanskrit": "भुङ्क्ते सा तत्र तं गर्भं सा तु नागं प्रसूयते।\nगन्धर्वाणां तु या माता सा गर्भं गृह्य गच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2027605, "chapter_id": 1592, "verse_number": "३-२३०-३९", "content_sanskrit": "ततो विलीनगर्भा सा मानुषी भुवि दृश्यते।\nया जनित्री त्वप्सरसां गर्भमास्ते प्रगृह्य सा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2027606, "chapter_id": 1592, "verse_number": "३-२३०-४०", "content_sanskrit": "उपविष्टं ततो गर्भं कथयनति मनीषिणः।\nलोहितस्योदधेः कन्या धात्री स्कन्दस्य सा स्मृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2027607, "chapter_id": 1592, "verse_number": "३-२३०-४१", "content_sanskrit": "लोहितायनिरित्येवं कदम्बे सा हि पूज्यते।\nपुरुषे तु यथा रुद्रस्तथाऽऽर्या प्रमदास्वपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2027608, "chapter_id": 1592, "verse_number": "३-२३०-४२", "content_sanskrit": "आर्या माता कुमारस्य पृथक्कामार्थमिज्यते।\nएवमेते कुमाराणां मया प्रोक्ता महाग्रहाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2027609, "chapter_id": 1592, "verse_number": "३-२३०-४३", "content_sanskrit": "यावत्षोडश वर्षाणि शिशूनां ह्यशिवास्ततः।\nये च मातृगणाः प्रोक्ताः पुरुषाश्चैवये ग्रहाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2027610, "chapter_id": 1592, "verse_number": "३-२३०-४४", "content_sanskrit": "सर्वे स्कन्दग्रहा नाम ज्ञेया नित्यं शरीरिभिः।\nतेषां प्रशमनं कार्यं स्नानं धूपमथाञ्जनम्।\nबलिकार्गेपहाराश् स्कन्दस्येज्या विशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2027611, "chapter_id": 1592, "verse_number": "३-२३०-४५", "content_sanskrit": "एवमभ्यर्चिताः सर्वे प्रयच्छन्ति शुभं नृणाम्।\nआयुर्दीर्घं च राजेनद्रसम्यक्पूजानमस्कृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2027612, "chapter_id": 1592, "verse_number": "३-२३०-४६", "content_sanskrit": "ऊर्ध्वं तु षोडशाद्वर्षाद्ये भवन्ति ग्रहा नृणाम्।\nतानहं संप्रवक्ष्यामि नमस्कृत्य महेश्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2027613, "chapter_id": 1592, "verse_number": "३-२३०-४७", "content_sanskrit": "यः पश्यति नरो देवाञ्जाग्रद्वा शयितोपि वा।\nउन्माद्यति स तु क्षिप्रं तं तु देवग्रहं विदुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2027614, "chapter_id": 1592, "verse_number": "३-२३०-४८", "content_sanskrit": "आसीनश्च शयानश्च यः पश्यति नरः पितॄन्।\nउन्माद्यतिस तु क्षिप्रं स ज्ञेयस्तु पितृग्रहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2027615, "chapter_id": 1592, "verse_number": "३-२३०-४९", "content_sanskrit": "अवमन्यति यः सिद्धान्क्रुद्धाश्चापि शपन्ति यम्।\nउन्माद्यति स तु क्षिप्रं ज्ञेयः सिद्धग्रहस्तु सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2027616, "chapter_id": 1592, "verse_number": "३-२३०-५०", "content_sanskrit": "उपाघ्राति च यो गन्धान्रसांश्चापि पृथग्विधान्।\nउन्माद्यति स तु क्षिप्रं स ज्ञेयो राक्षसो ग्रहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2027617, "chapter_id": 1592, "verse_number": "३-२३०-५१", "content_sanskrit": "गन्धर्वाश्चापि यं दिव्याः संविशन्ति नरं भुवि।\nउन्माद्यति स तु क्षिप्रं ग्रहो गान्धर्व एव सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2027618, "chapter_id": 1592, "verse_number": "३-२३०-५२", "content_sanskrit": "अधिरोहन्ति यं नित्यं पिशाचाः पुरुषं प्रति।\nउन्माद्यति स तु क्षिप्रं ग्रहः पैशाच एव सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2027619, "chapter_id": 1592, "verse_number": "३-२३०-५३", "content_sanskrit": "आविशन्ति च यं यक्षाः पुरुषं कालपर्यये।\nउनमाद्यति स तु क्षिप्रं ज्ञेयो यक्षग्रहस्तु सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2027620, "chapter_id": 1592, "verse_number": "३-२३०-५४", "content_sanskrit": "यस् दोषैः प्रकुपितं चित्तं मुह्यति देहिनः।\nउनमाद्यति स तु क्षिप्रं साधनं तस्य शास्त्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2027621, "chapter_id": 1592, "verse_number": "३-२३०-५५", "content_sanskrit": "वैक्लव्याच्च भयाच्चैव घोराणां चापि दर्शनात्।\nउन्माद्यति स तु क्षिप्रं सान्त्वं तस्य तु साधनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2027622, "chapter_id": 1592, "verse_number": "३-२३०-५६", "content_sanskrit": "कश्चित्क्रीडितुकामो वै भोक्तुकामस्तथाऽपरः।\nअभिकामस्तथैवान्य इत्येष त्रिविधो ग्रहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2027623, "chapter_id": 1592, "verse_number": "३-२३०-५७", "content_sanskrit": "यावत्सप्ततिवर्षाणि भवन्त्येते ग्रहा नृणाम्।\nअतः परं देहिनां तु ग्रहतुल्या भवेञ्जरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2027624, "chapter_id": 1592, "verse_number": "३-२३०-५८", "content_sanskrit": "अप्रकीर्णेन्द्रियं दान्तं शुचिं नित्यमतन्द्रितम्।\nआस्तिकं श्रद्दधानं च वर्जयन्ति तदा ग्रहाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2027625, "chapter_id": 1592, "verse_number": "३-२३०-५९", "content_sanskrit": "इत्येष ते ग्रहोद्देशो मानुषाणां प्रकीर्तितः।\nन स्पृशन्ति ग्रहा भक्तान्नरान्देवं महेश्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2027626, "chapter_id": 1592, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि मार्कण्डेयसमास्यापर्वणि त्रिंसदधिकद्विशततमोऽध्यायः ॥ २३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}]