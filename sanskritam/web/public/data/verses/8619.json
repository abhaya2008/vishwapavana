[{"id": 900008119, "chapter_id": 8619, "verse_number": "10.1", "content_sanskrit": "न चोपाधिभेदमात्रेणेश्वरस्य दुःखाभावः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900008120, "chapter_id": 8619, "verse_number": "10.2", "content_sanskrit": "अतोऽनौपाधिकत्वादेव भेदस्य..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900008121, "chapter_id": 8619, "verse_number": "10.3", "content_sanskrit": "‘इदं ज्ञनमुपाश्रित्य मम..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900008122, "chapter_id": 8619, "verse_number": "10.4", "content_sanskrit": "एवं प्रत्यक्षानुमानागमविरुद्धत्वादभेदविषयवत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900008123, "chapter_id": 8619, "verse_number": "10.5", "content_sanskrit": "भेदाद्यनुभवस्य भ्रान्तित्वाङ्गीकारे..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900008124, "chapter_id": 8619, "verse_number": "10.6", "content_sanskrit": "एकजीववादपक्षे..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900008125, "chapter_id": 8619, "verse_number": "10.7", "content_sanskrit": "एकजीववादपक्षे..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900008126, "chapter_id": 8619, "verse_number": "10.8", "content_sanskrit": "एकजीववादपक्षे..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900008127, "chapter_id": 8619, "verse_number": "10.9", "content_sanskrit": "न चैकजीवाज्ञानपरिकल्पिताः..", "padaccheda": "", "anvaya": "", 