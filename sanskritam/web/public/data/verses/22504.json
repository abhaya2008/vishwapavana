[{"id": 7002504000, "chapter_id": 22504, "verse_number": "१-१६६-१", "content_sanskrit": "सुमंतुरुवाच ।\nसूर्यभक्ता तु या नारी ध्रुवं सा पुरुषो भवेत् ।\nस्त्री पुत्रमुत्तमं सा चेत्कांक्षते शृणु तद्व्रतम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002504001, "chapter_id": 22504, "verse_number": "१-१६६-२", "content_sanskrit": "निक्षुभार्काख्यमाख्यातं सदा प्रीतिविवर्धनम् ।\nअवियोगकरं वीर धर्मकामार्थसाधकम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002504002, "chapter_id": 22504, "verse_number": "१-१६६-३", "content_sanskrit": "सप्तम्यामथ षष्ठ्यां वा संक्रांतौ च रवेर्दिने ।\nहविषा हविर्होमं तु सोपवासः समाचरेत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002504003, "chapter_id": 22504, "verse_number": "१-१६६-४", "content_sanskrit": "निक्षुभां कांस्यनिष्पन्नां कृत्वा स्वर्णमयीं शुभाम् ।\nराजतीं वाथ वा वर्षं स्नापयेच्च घृतादिभिः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002504004, "chapter_id": 22504, "verse_number": "१-१६६-५", "content_sanskrit": "गंधमाल्यैरलंकृत्य वस्त्रयु ग्मैश्च शोभनैः ।\nभक्ष्यभोज्यैरशेषैश्च वितानध्वजचामरैः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002504005, "chapter_id": 22504, "verse_number": "१-१६६-६", "content_sanskrit": "भोजयेत्सूर्यभक्तांश्च शुक्लवस्त्रावगुण्ठितान् ।\nकृत्वायतनमध्ये तु प्रतिमामुपकल्पयेत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002504006, "chapter_id": 22504, "verse_number": "१-१६६-७", "content_sanskrit": "कृत्वा शिरसि तत्पात्रं वितानच्छत्रशोभितम् ।\nध्वजशंखादिविभवैर्भगस्यायतनं नयेत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002504007, "chapter_id": 22504, "verse_number": "१-१६६-८", "content_sanskrit": "निक्षुभार्कदिनेशस्य व्रतमेतन्निवेदयेत् ।\nतत्पिंड्यां स्थापयेत्पात्रमुपशोभासमन्वितम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002504008, "chapter_id": 22504, "verse_number": "१-१६६-९", "content_sanskrit": "प्रदक्षिणीकृत्य रविं प्रणिपत्य क्षमापयेत् ।\nसमाप्य तद्व्रतं पुण्यं शृणुयात्फ लमश्नुते ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002504009, "chapter_id": 22504, "verse_number": "१-१६६-१०", "content_sanskrit": "द्वादशादित्यसंकाशैर्महायानैर्नगोपमैः ।\nयथेष्टं भानवे लोके सौरैः सार्धं प्रमोदते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002504010, "chapter_id": 22504, "verse_number": "१-१६६-११", "content_sanskrit": "वर्षकोटिसहस्राणि वर्षकोटिशतानि च ।\nनंदतेऽसौ महाभाग विष्णुलोके महीयते ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002504011, "chapter_id": 22504, "verse_number": "१-१६६-१२", "content_sanskrit": "ततः कर्मविशेषेण सर्वकामसमन्वितम् ।\nब्रह्मलोकं समासाद्य परं सुखमवाप्नुयात् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002504012, "chapter_id": 22504, "verse_number": "१-१६६-१३", "content_sanskrit": "ब्रह्मलोकात्परिभ्रष्टः श्रीमान्त्सुरसुपूजितः ।\nप्रजापतिमवाप्नोति सुरासुरनमस्कृतः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002504013, "chapter_id": 22504, "verse_number": "१-१६६-१४", "content_sanskrit": "लोकानिह चिरं भुक्त्वा सोमलोके महीयते ।\nसोमादेंद्रं पुनर्लोकमासाद्येंद्रपतिर्भवेत् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002504014, "chapter_id": 22504, "verse_number": "१-१६६-१५", "content_sanskrit": "इंद्रलोकाच्च गंधर्वलोकं प्राप्य स मोदते ।\nततस्तद्धर्मशेषेण भवत्यादित्यभावितः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002504015, "chapter_id": 22504, "verse_number": "१-१६६-१६", "content_sanskrit": "स्वकर्मभावनोद्योगात्पुनः प्रारभते शुभम् ।\nशुभाच्च पुनरेत्येह स यात्यतिसहस्रशः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002504016, "chapter_id": 22504, "verse_number": "१-१६६-१७", "content_sanskrit": "यावन्नाप्नोति मरणं तावद्भ्रमति कर्मणा ।\nसुनिर्वेदात्सवैराग्यं वैराग्याज्ज्ञानसंभवः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002504017, "chapter_id": 22504, "verse_number": "१-१६६-१८", "content_sanskrit": "ज्ञानात्प्रवर्तते योगो योगाद्दुःखांतमाप्नुयात् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]