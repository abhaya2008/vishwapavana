[{"id": 2096536, "chapter_id": 3066, "verse_number": "१३-१९६-१", "content_sanskrit": "[महेश्वर उवाच।\nसारमुद्धृत्य युष्माभिः साधुधर्म उदाहृतः।\nधर्मगुह्यमिदं मत्तः शृणुध्वं सर्व एव ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2096537, "chapter_id": 3066, "verse_number": "१३-१९६-२", "content_sanskrit": "येषां धर्माश्रिता बुद्धिःक श्रद्दधानाश्च ये नराः।\nतेषां स्यादुपदेष्टव्यः सरहस्यो महाफलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2096538, "chapter_id": 3066, "verse_number": "१३-१९६-३", "content_sanskrit": "निरुद्विग्नस्तु यो दद्यान्मासमेकं गवाह्निकम्।\nएकभक्तं तथाऽश्नीयाच्छ्रूयतां तस्य यत्फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2096539, "chapter_id": 3066, "verse_number": "१३-१९६-४", "content_sanskrit": "इमा गावो महाभागाः पवित्रं परमं स्मृताः।\nत्रीन्लोकान्धानयन्ति स्म सदेवासुरमानुपान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2096540, "chapter_id": 3066, "verse_number": "१३-१९६-५", "content_sanskrit": "तासु चैव महापुण्यं शुश्रूषा च महाफलम्।\nअहन्यहनि धर्मेण युज्यते वै गवाह्निकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2096541, "chapter_id": 3066, "verse_number": "१३-१९६-६", "content_sanskrit": "मया ह्येता ह्यनुज्ञाताः पूर्वमासन्कृते युगे।\nततोऽहमनुनीतो वै ब्रह्मणा पद्मयोनिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2096542, "chapter_id": 3066, "verse_number": "१३-१९६-७", "content_sanskrit": "तस्माद्व्रजस्थानगतस्तिष्ठत्युपरि मे वृषः।\nरमेऽहं सह गोभिश्च तस्मात्पूज्याः सदैव ताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2096543, "chapter_id": 3066, "verse_number": "१३-१९६-८", "content_sanskrit": "महाप्रभावा वरदा वरं दद्युरुपासिताः।\nता गावोऽस्यानुमन्यन्ते सर्वकर्मसु युत्फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2096544, "chapter_id": 3066, "verse_number": "१३-१९६-९", "content_sanskrit": "तस्य तत्र चतुर्भागो यो ददाति गवाह्निकम्॥] ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2096545, "chapter_id": 3066, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि षण्णवत्यधिकशततमोऽध्यायः॥ १९६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}]