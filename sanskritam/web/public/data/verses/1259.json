[{"id": 2012604, "chapter_id": 1259, "verse_number": "१-२६०-०x", "content_sanskrit": "मन्दपाल उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2012605, "chapter_id": 1259, "verse_number": "१-२६०-१", "content_sanskrit": "युष्माकमपवर्गार्थं ती ज्वलनो मया।\nअग्निना च तथेत्येतिज्ञातं महात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2012606, "chapter_id": 1259, "verse_number": "१-२६०-२", "content_sanskrit": "अग्नेर्वचनमाज्ञाय धर्मज्ञतां च वः।\nभवतां च परं वीर्यं नाहमिहागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2012607, "chapter_id": 1259, "verse_number": "१-२६०-३", "content_sanskrit": "न सन्तापो हि वर्त्थः पुत्रका हृदि मां प्रति।\nऋषीन्वेद हुताशो ब्रह्म तद्विदितं च वः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2012608, "chapter_id": 1259, "verse_number": "१-२६०-४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2012609, "chapter_id": 1259, "verse_number": "१-२६०-४", "content_sanskrit": "एवमाश्वासितान्पुत्रान्भार्यामादाय स द्विजः।\nमन्दपालस्ततो देशादन्यं देशं जगाम ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2012610, "chapter_id": 1259, "verse_number": "१-२६०-५", "content_sanskrit": "भगवानापि तिग्मांशुः समिद्धः खाण्डवं ततः।\nददाह सह कृष्णाभ्यां जनयञ्जगतो हितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2012611, "chapter_id": 1259, "verse_number": "१-२६०-६", "content_sanskrit": "वसामेदोवहाः कुल्यास्तत्र पीत्वा च पावकः।\nजगाम दर्शयामास चार्जुनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2012612, "chapter_id": 1259, "verse_number": "१-२६०-७", "content_sanskrit": "ततोऽञन्तरिक्षाद्भगवानवतीर्य पुरन्दरः।\nमरुद्गणैर्वृतः पार्थं केशवं चेदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2012613, "chapter_id": 1259, "verse_number": "१-२६०-८", "content_sanskrit": "कृतं युवाभ्यां कर्मेदममरैरपि दुष्करम्।\nवरं वृणीतं तुष्टोऽस्मि दुर्लभं पुरुषेष्विह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2012614, "chapter_id": 1259, "verse_number": "१-२६०-९", "content_sanskrit": "पार्थस्तु वरयामास शक्रादस्त्राणि सर्वशः।\nप्रदातुं तच्च शक्रस्तु कालं चक्रे महाद्युतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2012615, "chapter_id": 1259, "verse_number": "१-२६०-१०", "content_sanskrit": "यदा प्रसन्नो भगवान्महादेवो भविष्यति।\nतदातुभ्यं प्रदास्यामि पाण्डवास्त्राणि सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2012616, "chapter_id": 1259, "verse_number": "१-२६०-११", "content_sanskrit": "अहमेव च तं कालं वेत्स्यामि कुरुनन्दन।\nतपसा महता चापि दास्यामि भवतोऽप्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2012617, "chapter_id": 1259, "verse_number": "१-२६०-१२", "content_sanskrit": "आग्नेयानि च सर्वाणि वायव्यानि च सर्वशः।\nमदीयानि च सर्वाणि ग्रहीष्यसि धनञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2012618, "chapter_id": 1259, "verse_number": "१-२६०-१३", "content_sanskrit": "वासुदेवोऽपि जग्राह प्रीतिं पार्थेन शाश्वतीम्।\nददौ सुरपतिश्चैव वरं कृष्णाय धीमते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2012619, "chapter_id": 1259, "verse_number": "१-२६०-१४", "content_sanskrit": "एवं दत्त्वा वरं ताभ्यां सह देवैर्मरुत्पतिः।\nहुताशनमनुज्ञाप्य जगामत्रिदिवं प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2012620, "chapter_id": 1259, "verse_number": "१-२६०-१५", "content_sanskrit": "पावकश्च तदा दावं दग्ध्वसमृगपक्षिणम्।\nअहोभिरेकविंशद्भिर्विरराग्सुतर्पितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2012621, "chapter_id": 1259, "verse_number": "१-२६०-१६", "content_sanskrit": "जग्ध्वा मांसानि पीत्वा चदांसि रुधिराणि च।\nयुक्तः परमया प्रीत्या तावुत्वाच्युतार्जुनौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2012622, "chapter_id": 1259, "verse_number": "१-२६०-१७", "content_sanskrit": "युवाभ्यां पुरुषाग्र्याभ्यां ततोऽस्मि यथासुखम्।\nअनुजानामि वां वीरौ चरतंत्र वाञ्छितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2012623, "chapter_id": 1259, "verse_number": "१-२६०-१८", "content_sanskrit": "गाण्डिवं च धनुर्दिव्यमक्षौ च महेषुधी।\nकपिध्वजो रथश्चायं तव द महामते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2012624, "chapter_id": 1259, "verse_number": "१-२६०-१९", "content_sanskrit": "अनेन धनुषा चैव रथेनाने भारत।\nविजेष्यसि रणे शत्रून्सदेवामानुषान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2012625, "chapter_id": 1259, "verse_number": "१-२६०-२०", "content_sanskrit": "एवं तौ समनुज्ञातौ पाववेमहात्मना।\nअर्जुनो वासुदेवश्च दानवश्चयस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2012626, "chapter_id": 1259, "verse_number": "१-२६०-२१", "content_sanskrit": "परिक्रम्य ततः सर्वे त्रयोऽभरतर्षभ।\nरमणीये नदीकूले सहितामुपाविशंन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2012627, "chapter_id": 1259, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसाहस्त्र्यां संहितायां वैयासिक्यां आदिपर्वणि मयपर्वणि षष्ट्यधिकद्विशततमोऽध्यायः॥ २६० ॥ ॥ समाप्तं मयदर्शनपर्वादिपर्व च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]