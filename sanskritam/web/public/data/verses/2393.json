[{"id": 2065908, "chapter_id": 2393, "verse_number": "९-११-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2065909, "chapter_id": 2393, "verse_number": "९-११-१", "content_sanskrit": "पतितं प्रेक्ष्य यन्तारं शल्यः शैक्यायसीं गदाम्।\nआदाय तरसा राजंस्तस्थौ गिरिरिवाचलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2065910, "chapter_id": 2393, "verse_number": "९-११-२", "content_sanskrit": "तं दीप्तमिव कालाग्निं पाशहस्तमिवान्तकम्।\nसशृङ्गमिव कैलासं सवज्रमिव वासवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2065911, "chapter_id": 2393, "verse_number": "९-११-३", "content_sanskrit": "सशूलमिव हर्यक्षं सचक्रमिव चक्रिणम्।\nसशक्तिमिव सेनान्यं वने मत्तमिव द्विपम्।\nजवेनाभ्यपतद्भीमः प्रगृह्य महतीं गदाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2065912, "chapter_id": 2393, "verse_number": "९-११-४", "content_sanskrit": "ततः शङ्खप्रणादश्च तूर्याणां च सहस्रशः।\nसिंहनादश्च सञ्जज्ञे शूराणां हर्षवर्धनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2065913, "chapter_id": 2393, "verse_number": "९-११-५", "content_sanskrit": "प्रैक्षन्त सर्वतस्तौ हि योधा मत्ताविव द्विपौ।\nतावकाश्चापरे चैव साधुसाध्वित्यपूजयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2065914, "chapter_id": 2393, "verse_number": "९-११-६", "content_sanskrit": "न हि मद्राधिपादन्यो रामाद्वा यदुनन्दनात्।\nसोढुमुत्सहते वेगं भीमसेनस्य संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2065915, "chapter_id": 2393, "verse_number": "९-११-७", "content_sanskrit": "तथा मद्राधिपस्यापि गदावेगं महात्मनः।\nसोढुमुत्सहते नान्यः पुमान्युधि वृकोदरात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2065916, "chapter_id": 2393, "verse_number": "९-११-८", "content_sanskrit": "तौ वृषाविव नर्दन्तौ मण्डलानि विचेरतुः।\nआवर्तितौ गदाहस्तौ मद्रराजवृकोदरौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2065917, "chapter_id": 2393, "verse_number": "९-११-९", "content_sanskrit": "मण्डलावर्तमार्गेषु गदाविहरणेषु च।\nनिर्विशेषमभूद्युद्धं तयोः पुरुषसिंहयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2065918, "chapter_id": 2393, "verse_number": "९-११-१०", "content_sanskrit": "तप्तहेममयैः शुभ्रैर्बभूव भयवर्धिनी।\nअग्निज्वालैरिवाबद्धा पट्टैः शल्यस्य सा गदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2065919, "chapter_id": 2393, "verse_number": "९-११-११", "content_sanskrit": "तथैव चरतो मार्गान्मण्डलेषु महात्मनः।\nविद्युदभ्रग्रतीकाशा भीमस्य शुशुभे गदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2065920, "chapter_id": 2393, "verse_number": "९-११-१२", "content_sanskrit": "ताडिता मद्रराजेन भीमस्य गदया गदा।\nदह्यमानेव खे राजन्साऽसृजत्पावकार्चिषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2065921, "chapter_id": 2393, "verse_number": "९-११-१३", "content_sanskrit": "तथा भीमेन शल्यस्य ताडिता गदया गदा।\nअङ्गारवर्षं मुमुचे तदद्भुतमिवाभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2065922, "chapter_id": 2393, "verse_number": "९-११-१४", "content_sanskrit": "दन्तैरिव महानागौ शृङ्गैरिव महर्षभौ।\nतौ विरेजतुरन्योन्यं गदाग्राभ्यां परिक्षतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2065923, "chapter_id": 2393, "verse_number": "९-११-१५", "content_sanskrit": "तौ गदाभिहतैर्गात्रैः क्षणेन रुधिरोक्षितौ।\nप्रेक्षणीयतरावास्तां पुष्पिताविव किंशुकौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2065924, "chapter_id": 2393, "verse_number": "९-११-१६", "content_sanskrit": "गदया मद्रराजस्य सव्यदक्षिणमाहतः।\nभीमसेनो महाबाहुर्न चचालाचलो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2065925, "chapter_id": 2393, "verse_number": "९-११-१७", "content_sanskrit": "तथा भीमगदावेगैस्ताड्यमानो मुहुर्मुहुः।\nशल्यो न विव्यथे राजन्दन्तिनेव महागिरिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2065926, "chapter_id": 2393, "verse_number": "९-११-१८", "content_sanskrit": "शुश्रुवे दिक्षु सर्वासु तयोः पुरुषसिंहयोः।\nगदानिपातसंहादो वज्रयोरिव निःस्वनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2065927, "chapter_id": 2393, "verse_number": "९-११-१९", "content_sanskrit": "निवृत्य तु महावीर्यौ समुच्छ्रितमहागदौ।\nपुनरन्तरमार्गस्थौ पण्डलानि विचेरतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2065928, "chapter_id": 2393, "verse_number": "९-११-२०", "content_sanskrit": "अथाभ्येत्य पदान्यष्टौ सन्निपातोऽभवत्तयोः।\nउद्यम्य लोहदण़्डाभ्यामतिमानुषकर्मणोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2065929, "chapter_id": 2393, "verse_number": "९-११-२१", "content_sanskrit": "पोथयन्तौ तदाऽन्योन्यं मण्डलानि विचेरतुः।\nक्रियाविशेषं कृतिनौ दर्शयामासतुस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2065930, "chapter_id": 2393, "verse_number": "९-११-२२", "content_sanskrit": "अभ्युद्यतगदौ वीरौ सशृङ्गाविव पर्वतौ।\nतावाजघ्नतुरन्योन्यं मण्डलानि विचेरतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2065931, "chapter_id": 2393, "verse_number": "९-११-२३", "content_sanskrit": "क्रियाविशेषकृतिनौ रणभूमितलेऽचलौ।\nतौ परस्परसंरम्भाद्गदाभ्यां सुभृशाहतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2065932, "chapter_id": 2393, "verse_number": "९-११-२४", "content_sanskrit": "युगपत्पेततुर्वीरावुभाविन्द्रबली इव।\nउभयः सेनयोर्योधास्तदा हाहाकृताभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2065933, "chapter_id": 2393, "verse_number": "९-११-२५", "content_sanskrit": "भृशं मर्मस्वभिहतावुभावास्तां सुविह्वलौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2065934, "chapter_id": 2393, "verse_number": "९-११-२६", "content_sanskrit": "ततः स्वरथमारोप्य मद्राणामृषभं रणे।\nअपोवाह कृपः शल्यं तूर्णमायोधनादथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2065935, "chapter_id": 2393, "verse_number": "९-११-२७", "content_sanskrit": "क्षीबवद्विह्वलत्वात्तु निमेषात्पुनरुत्थितः।\nभीमसेनो गदापाणिः समाह्वयत मद्रपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2065936, "chapter_id": 2393, "verse_number": "९-११-२८", "content_sanskrit": "ततस्तु तावकाः शूरा नानाशस्त्रसमायुताः।\nनानावादित्रशब्देन पाण्डुसेनामयोधयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2065937, "chapter_id": 2393, "verse_number": "९-११-२९", "content_sanskrit": "भुजावुच्छ्रित्य शस्त्रं च शब्देन महता ततः।\nअभ्यद्रवन्महाराज दुर्योधनपुरोगमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2065938, "chapter_id": 2393, "verse_number": "९-११-३०", "content_sanskrit": "तदनीकमभिप्रेक्ष्य ततस्ते पाण्डुनन्दनाः।\nप्रययुः सिंहनादेन दुर्योधनवधेप्सया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2065939, "chapter_id": 2393, "verse_number": "९-११-३१", "content_sanskrit": "तेषामापततां तूर्णं पुत्रस्ते भरतर्षभ।\nप्राप्तेन चेकितानं वै विव्याध हृदये भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2065940, "chapter_id": 2393, "verse_number": "९-११-३२", "content_sanskrit": "पपात रथोपस्थे तव पुत्रेण पातितः।\nरुधिरौघपरिक्लिन्नः प्रविश्य विपुलं तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2065941, "chapter_id": 2393, "verse_number": "९-११-३३", "content_sanskrit": "चेकितानं हतं दृष्ट्वा पाण्डवेया महारथाः।\nअसक्तमभ्यवर्षन्त शरवर्षाणि भागशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2065942, "chapter_id": 2393, "verse_number": "९-११-३४", "content_sanskrit": "तावकानामनीकेषु पाण्डवा जितकाशिनः।\nव्यचरन्त महाराज प्रेक्षणीयाः समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2065943, "chapter_id": 2393, "verse_number": "९-११-३५", "content_sanskrit": "कृपश्च कृतवर्मा च सौबलश्च महारथः।\nअयोधयन्धर्मराजं मद्रराजपुरस्कृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2065944, "chapter_id": 2393, "verse_number": "९-११-३६", "content_sanskrit": "भारद्वाजस्य हन्तारं भूरिवीर्यपराक्रमम्।\nदुर्योधनो महाराज धृष्टद्युम्नमयोधयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2065945, "chapter_id": 2393, "verse_number": "९-११-३७", "content_sanskrit": "त्रिसाहस्रास्तथा राजंस्तव पुत्रेण चोदिताः।\nअयोधयन्त विजयं जैगर्तानां महारथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2065946, "chapter_id": 2393, "verse_number": "९-११-३८", "content_sanskrit": "विजये धृतसङ्कल्पाः समरे त्यक्तजीविताः।\nप्राविशंस्तावका राजन्हंसा इव महत्सरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2065947, "chapter_id": 2393, "verse_number": "९-११-३९", "content_sanskrit": "ततो युद्धमभूद्धोरं परस्परवधैषिणाम्।\nअन्योन्यवधसंयुक्तमन्योन्यप्रीतिवर्धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2065948, "chapter_id": 2393, "verse_number": "९-११-४०", "content_sanskrit": "तस्मिन्प्रवृत्ते सङ्ग्रामे राजन्वीरवरक्षये।\nअनिलेनेरितं घोरमुत्तस्थौ पार्थिवं रजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2065949, "chapter_id": 2393, "verse_number": "९-११-४१", "content_sanskrit": "श्रवणान्नामधेयानां पार्थिवानां च कीर्तनात्।\nपरस्परं विजानीमस्तदायुध्यन्नभीतवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2065950, "chapter_id": 2393, "verse_number": "९-११-४२", "content_sanskrit": "तद्रजः पुरुषव्याघ्र शोणितेन प्रशामितम्।\nदिशश्च विमला जातास्तस्मिन्रजसि नाशिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2065951, "chapter_id": 2393, "verse_number": "९-११-४३", "content_sanskrit": "तथा प्रवृत्ते सङ्ग्रामे घोररूपे भयानके।\nतावकानां परेषां च नासीत्कश्चित्पराङ्मुखः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2065952, "chapter_id": 2393, "verse_number": "९-११-४४", "content_sanskrit": "ब्रह्मलोकपरा भूत्वा प्रार्थयन्तो जयं युधि।\nसुयुद्धेन पराक्रान्ता नराः स्वर्गमभीप्सवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2065953, "chapter_id": 2393, "verse_number": "९-११-४५", "content_sanskrit": "भर्तृपिण्डविमोक्षार्थं भर्तृकार्यविनिश्चिताः।\nस्वर्गसंसक्तमनसो योधा युयुधिरे तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2065954, "chapter_id": 2393, "verse_number": "९-११-४६", "content_sanskrit": "नानारूपाणि शस्त्राणि विसृजन्तो महारथाः।\nअन्योन्यमभिगर्जन्तः प्रहरन्तः परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2065955, "chapter_id": 2393, "verse_number": "९-११-४७", "content_sanskrit": "हत विध्यत गृह्णीत प्रहरध्वं निकृन्तत।\nइति स्म वाचः श्रूयन्ते तवतेषां च वै बले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2065956, "chapter_id": 2393, "verse_number": "९-११-४८", "content_sanskrit": "ततः शल्यो महाराज धर्मपुत्रं युधिष्ठिरम्।\nविव्याध निशितैर्बाणैर्हन्तुकामो महारथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2065957, "chapter_id": 2393, "verse_number": "९-११-४९", "content_sanskrit": "तस्य पार्थो महाराज नाराचान्वै चतुर्दश।\nमर्माण्युद्दिश्य मर्मज्ञो निचखान हसन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2065958, "chapter_id": 2393, "verse_number": "९-११-५०", "content_sanskrit": "आवार्य पाण्डवं बाणैर्हन्तुकामो महाबलः।\nविव्याध समरे क्रुद्धो बहुभिः कङ्कपत्रिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2065959, "chapter_id": 2393, "verse_number": "९-११-५१", "content_sanskrit": "अथ मद्रो महाराज शरेणानतपर्वणा।\nयुधिष्ठिरं समाजघ्ने सर्वसैन्यस्य पश्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2065960, "chapter_id": 2393, "verse_number": "९-११-५२", "content_sanskrit": "धर्मराजोऽपि सङ्क्रुद्धो मद्रराजं महाबलः।\nविव्याध निशितैर्बाणैः कङ्कबर्हिणवाजितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2065961, "chapter_id": 2393, "verse_number": "९-११-५३", "content_sanskrit": "चन्द्रसेनं च सप्तत्या सूतं च नवभिः शरैः।\nद्रुमसेनं चतुःषष्ट्या निजघान महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2065962, "chapter_id": 2393, "verse_number": "९-११-५४", "content_sanskrit": "चक्ररक्षे हते शल्यः पाण्डवेन महात्मना।\nनिजघान ततो राजंश्चेदीन्वै प़ञ्चविंशतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2065963, "chapter_id": 2393, "verse_number": "९-११-५५", "content_sanskrit": "सात्यकिं पञ्चविंशत्या भीमसेनं च पञ्चभिः।\nमाद्रीपुत्रौ शतेनाजौ विव्याध निशितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2065964, "chapter_id": 2393, "verse_number": "९-११-५६", "content_sanskrit": "एवं विचरतस्तस्य सङ्ग्रामे राजसत्तम।\nसम्प्रैषयच्छितान्पार्थः शरानाशीविषोपमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2065965, "chapter_id": 2393, "verse_number": "९-११-५७", "content_sanskrit": "ध्वजाघ्रं चास्य समरे कुन्तीपुत्रो युधिष्ठिरः।\nप्रमुखे वर्तमानस्य भल्लेनापाहरद्रथात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2065966, "chapter_id": 2393, "verse_number": "९-११-५८", "content_sanskrit": "पाण्डुपुत्रेण वै तस्य केतुं छिन्नं महात्मना।\nनिपतन्तमपश्याम गिरिशृङ्गमिवाहतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2065967, "chapter_id": 2393, "verse_number": "९-११-५९", "content_sanskrit": "ध्वजं निपतितं दृष्ट्वा पाण़्डवं च व्यवस्थितम्।\nसङ्क्रुद्धो मद्रराजोऽभूच्छरवर्षं मुमोच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2065968, "chapter_id": 2393, "verse_number": "९-११-६०", "content_sanskrit": "शल्यः सायकवर्षेण पर्जन्य इव वृष्टिमान्।\nअभ्यवर्षदमेयात्मा क्षत्रियान्क्षत्रियर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2065969, "chapter_id": 2393, "verse_number": "९-११-६१", "content_sanskrit": "सात्यकिं भीमसेनं च माद्रीपुत्रौ च पाण्डवौ।\nएकैकं प़ञ्चभिर्विद्ध्वा युधिष्ठिरमपीडयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2065970, "chapter_id": 2393, "verse_number": "९-११-६२", "content_sanskrit": "ततो बाणमयं जालं विततं पाण्डवोरसि।\nअपश्याम महाराज मेघजालमिवोद्गतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2065971, "chapter_id": 2393, "verse_number": "९-११-६३", "content_sanskrit": "तस्य शल्यो रणे क्रुद्धः शरैः सन्नतपर्वभिः।\nदिशः सञ्छादयामास प्रदिशश्च महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2065972, "chapter_id": 2393, "verse_number": "९-११-६४", "content_sanskrit": "ततो युधिष्ठिरो राजा बाणजालेन पीडितः।\nबभूव हृतविक्रान्तो जम्भो वृत्रहणा यथा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2065973, "chapter_id": 2393, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शल्यपर्वणि शल्यवधपर्वणि अष्टादशदिवसयुद्धे एकादशोऽध्यायः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}]