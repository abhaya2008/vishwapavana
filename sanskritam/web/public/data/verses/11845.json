[{"id": 50024277, "chapter_id": 11845, "verse_number": "1", "content_sanskrit": "॥ मेधातिथिः काण्वः। विश्वे देवाः। गायत्री॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50024278, "chapter_id": 11845, "verse_number": "2", "content_sanskrit": "ऐभि॑रग्ने॒ दुवो॒ गिरो॒ विश्वे॑भि॒ः सोम॑पीतये। दे॒वेभि॑र्याहि॒ यक्षि॑ च॥ १४/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50024279, "chapter_id": 11845, "verse_number": "3", "content_sanskrit": "आ त्वा॒ कण्वा॑ अहूषत गृ॒णन्ति॑ विप्र ते॒ धिय॑ः। दे॒वेभि॑रग्न॒ आ ग॑हि॥ १४/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50024280, "chapter_id": 11845, "verse_number": "4", "content_sanskrit": "इ॒न्द्र॒वा॒यू बृह॒स्पतिं॑ मि॒त्राग्निं पू॒षणं॒ भग॑म्। आ॒दि॒त्यान्मारु॑तं ग॒णम्॥ १४/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50024281, "chapter_id": 11845, "verse_number": "5", "content_sanskrit": "प्र वो॑ भ्रियन्त॒ इन्द॑वो मत्स॒रा मा॑दयि॒ष्णव॑ः। द्र॒प्सा मध्व॑श्चमू॒षद॑ः॥ १४/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50024282, "chapter_id": 11845, "verse_number": "6", "content_sanskrit": "ईळ॑ते॒ त्वाम॑व॒स्यव॒ः कण्वा॑सो वृ॒क्तब॑र्हिषः। ह॒विष्म॑न्तो अरं॒कृत॑ः॥ १४/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50024283, "chapter_id": 11845, "verse_number": "7", "content_sanskrit": "घृ॒तपृ॑ष्ठा मनो॒युजो॒ ये त्वा॒ वह॑न्ति॒ वह्न॑यः। आ दे॒वान्सोम॑पीतये॥ १४/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50024284, "chapter_id": 11845, "verse_number": "8", "content_sanskrit": "तान्यज॑त्राँ ऋता॒वृधोऽग्ने॒ पत्नी॑वतस्कृधि। मध्व॑ः सुजिह्व पायय॥ १४/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50024285, "chapter_id": 11845, "verse_number": "9", "content_sanskrit": "ये यज॑त्रा॒ य ईड्या॒स्ते ते॑ पिबन्तु जि॒ह्वया॑। मधो॑रग्ने॒ वष॑ट्कृति॥ १४/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50024286, "chapter_id": 11845, "verse_number": "10", "content_sanskrit": "आकीं॒ सूर्य॑स्य रोच॒नाद्विश्वा॑न्दे॒वाँ उ॑ष॒र्बुध॑ः। विप्रो॒ होते॒ह व॑क्षति॥ १४/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50024287, "chapter_id": 11845, "verse_number": "11", "content_sanskrit": "विश्वे॑भिः सो॒म्यं मध्वग्न॒ इन्द्रे॑ण वा॒युना॑। पिबा॑ मि॒त्रस्य॒ धाम॑भिः॥ १४/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50024288, "chapter_id": 11845, "verse_number": "12", "content_sanskrit": "त्वं होता॒ मनु॑र्हि॒तोऽग्ने॑ य॒ज्ञेषु॑ सीदसि। सेमं नो॑ अध्व॒रं य॑ज॥ १४/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50024289, "chapter_id": 11845, "verse_number": "13", "content_sanskrit": "यु॒क्ष्वा ह्यरु॑षी॒ रथे॑ ह॒रितो॑ देव रो॒हित॑ः। ताभि॑र्दे॒वाँ इ॒हा व॑ह॥ १४/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}]