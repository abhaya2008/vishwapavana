[{"id": 5000412000, "chapter_id": 9412, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे पञ्चमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000412001, "chapter_id": 9412, "verse_number": "६-५-१", "content_sanskrit": "सा तु नीलेन विधिवत्स्वारक्षा सुसमाहिता।\nसागरस्योत्तरे तीरे साधु सा विनिवेशिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000412002, "chapter_id": 9412, "verse_number": "६-५-२", "content_sanskrit": "मैन्दश्च द्विविदश्चोभौ तत्र वानरपुङ्गवौ।\nविचेरतुश्च तां सेनां रक्षार्थं सर्वतोदिशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000412003, "chapter_id": 9412, "verse_number": "६-५-३", "content_sanskrit": "निविष्टायां तु सेनायां तीरे नदनदीपतेः।\nपार्श्वस्थं लक्ष्मणं दृष्ट्वा रामो वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000412004, "chapter_id": 9412, "verse_number": "६-५-४", "content_sanskrit": "शोकश्च किल कालेन गच्छता ह्यपगच्छति।\nमम चापश्यतः कान्तामहन्यहनि वर्धते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000412005, "chapter_id": 9412, "verse_number": "६-५-५", "content_sanskrit": "न मे दुःखं प्रिया दूरे न मे दुःखं हृतेति च।\nएतदेवानुशोचामि वयोऽस्या ह्यतिवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000412006, "chapter_id": 9412, "verse_number": "६-५-६", "content_sanskrit": "वाहि वात यतः कान्ता तां स्पृष्ट्वा मामपि स्पृश।\nत्वयि मे गात्रसंस्पर्शश्चन्द्रे दृष्टिसमागमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000412007, "chapter_id": 9412, "verse_number": "६-५-७", "content_sanskrit": "तन्मे दहति गात्राणि विषं पीतमिवाशये।\nहा नाथेति प्रिया सा मां ह्रियमाणा यदब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000412008, "chapter_id": 9412, "verse_number": "६-५-८", "content_sanskrit": "तद्वियोगेन्धनवता तच्चिन्ताविमलार्चिषा।\nरात्रिंदिवं शरीरं मे दह्यते मदनाग्निना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000412009, "chapter_id": 9412, "verse_number": "६-५-९", "content_sanskrit": "अवगाह्यार्णवं स्वप्स्ये सौमित्रे भवता विना।\nएवं च प्रज्वलन् कामो न मा सुप्तं जले दहेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000412010, "chapter_id": 9412, "verse_number": "६-५-१०", "content_sanskrit": "बह्वेतत् कामयानस्य शक्यमेतेन जीवितुम्।\nयदहं सा च वामोरुरेकां धरणिमाश्रितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000412011, "chapter_id": 9412, "verse_number": "६-५-११", "content_sanskrit": "केदारस्येवाकेदारः सोदकस्य निरूदकः।\nउपस्नेहेन जीवामि जीवन्तीं यच्छृणोमि ताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000412012, "chapter_id": 9412, "verse_number": "६-५-१२", "content_sanskrit": "कदा नु खलु सुश्रोणीं शतपत्रायतेक्षणाम्।\nविजित्य शत्रून् द्रक्ष्यामि सीतां स्फीतामिव श्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000412013, "chapter_id": 9412, "verse_number": "६-५-१३", "content_sanskrit": "कदा सुचारुदन्तोष्ठं तस्याः पद्ममिवाननम्।\nईषदुन्नाम्य पास्यामि रसायनमिवातुरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000412014, "chapter_id": 9412, "verse_number": "६-५-१४", "content_sanskrit": "तौ तस्याः सहितौ पीनौ स्तनौ तालफलोपमौ।\nकदा न खलु सोत्कम्पौ श्लिष्यन्त्या मां भजिष्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000412015, "chapter_id": 9412, "verse_number": "६-५-१५", "content_sanskrit": "सा नूनमसितापाङ्गी रक्षोमध्यगता सती।\nमन्नाथा नाथहीनेव त्रातारं नाधिगच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000412016, "chapter_id": 9412, "verse_number": "६-५-१६", "content_sanskrit": "कथं जनकराजस्य दुहिता मम च प्रिया।\nराक्षसीमध्यगा शेते स्नुषा दशरथस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000412017, "chapter_id": 9412, "verse_number": "६-५-१७", "content_sanskrit": "अविक्षोभ्याणि रक्षांसि सा विधूयोत्पतिष्यति।\nविधूय जलदान् नीलान् शशिलेखा शरत्स्विव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000412018, "chapter_id": 9412, "verse_number": "६-५-१८", "content_sanskrit": "स्वभावतनुका नूनं शोकेनानशनेन च।\nभूयस्तनुतरा सीता देशकालविपर्ययात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000412019, "chapter_id": 9412, "verse_number": "६-५-१९", "content_sanskrit": "कदा नु राक्षसेन्द्रस्य निधायोरसि सायकान्।\nशोकं प्रत्याहरिष्यामि शोकमुत्सृज्य मानसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000412020, "chapter_id": 9412, "verse_number": "६-५-२०", "content_sanskrit": "कदा नु खलु मे साध्वी सीतामरसुतोपमा।\nसोत्कण्ठा कण्ठमालम्ब्य मोक्ष्यत्यानन्दजं जलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000412021, "chapter_id": 9412, "verse_number": "६-५-२१", "content_sanskrit": "कदा शोकमिमं घोरं मैथिलीविप्रयोगजम्।\nसहसा विप्रमोक्ष्यामि वासः शुक्लेतरं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000412022, "chapter_id": 9412, "verse_number": "६-५-२२", "content_sanskrit": "एवं विलपतस्तस्य तत्र रामस्य धीमतः।\nदिनक्षयान्मन्दवपुर्भास्करोऽस्तमुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000412023, "chapter_id": 9412, "verse_number": "६-५-२३", "content_sanskrit": "आश्वासितो लक्ष्मणेन रामः संध्यामुपासत।\nस्मरन् कमलपत्राक्षीं सीतां शोकाकुलीकृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000412024, "chapter_id": 9412, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे पञ्चमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]