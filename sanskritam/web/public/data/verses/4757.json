[{"id": 2177855, "chapter_id": 4757, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2177856, "chapter_id": 4757, "verse_number": "१", "content_sanskrit": "हते दुर्योधने चैव हते सैन्ये च सर्वशः ।\nधृतराष्ट्रो महाराजः श्रुत्वा किमकरोन्मुने\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2177857, "chapter_id": 4757, "verse_number": "२", "content_sanskrit": "तथैव कौरवो राजा धर्मपुत्रो महामनाः ।\nकृपप्रभृतयश्चैव किमकुर्वत ते त्रयः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2177858, "chapter_id": 4757, "verse_number": "३", "content_sanskrit": "अश्वत्थाम्नः श्रुतं कर्म शापश्चान्योन्यकारितः ।\nवृत्तान्तमुत्तरं ब्रूहि यदभाषत सञ्जयः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2177859, "chapter_id": 4757, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2177860, "chapter_id": 4757, "verse_number": "४", "content_sanskrit": "हते पुत्रशते दीनं छिन्नशाखमिव द्रुमम् ।\nपुत्रशोकाभिसन्तप्तं धृतराष्ट्रं महीपतिम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2177861, "chapter_id": 4757, "verse_number": "५", "content_sanskrit": "ध्यानमूकत्वमापन्नं चिन्तया समभिप्लुतम् ।\nसञ्जयो जयतां श्रेष्ठ राजानं वाक्यमब्रवीत्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2177862, "chapter_id": 4757, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2177863, "chapter_id": 4757, "verse_number": "६", "content_sanskrit": "किं शोचसि महाप्राज्ञ नास्ति शोके सहायता ।\nअक्षौहिण्यो हता ह्यष्टौ दश चैव विशाम्पते\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2177864, "chapter_id": 4757, "verse_number": "७", "content_sanskrit": "निर्जितेयं वसुमती शून्या स्थास्यति केवलम् ।\nनानादिग्भ्यः समागम्य नानाजात्या नराधिपाः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2177865, "chapter_id": 4757, "verse_number": "८", "content_sanskrit": "सहितास्तव पुत्रेण सर्वे वै निधनं गताः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2177866, "chapter_id": 4757, "verse_number": "९", "content_sanskrit": "पितॄणां पुत्रपौत्राणां ज्ञातीनां सुहृदां तथा ।\nगुरूणां चानुपूर्व्येण ये चान्येऽनुचरा हताः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2177867, "chapter_id": 4757, "verse_number": "१०", "content_sanskrit": "प्रेतकार्याणि सर्वाणि कारयस्व नराधिप\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2177868, "chapter_id": 4757, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2177869, "chapter_id": 4757, "verse_number": "११", "content_sanskrit": "तच्छ्रुत्वा करुणं वाक्यं पुत्रपौत्रवधार्दितः ।\nपपात भुवि दुर्धर्षो वाताहत इव द्रुमः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2177870, "chapter_id": 4757, "verse_number": "", "content_sanskrit": "धृतराष्टः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2177871, "chapter_id": 4757, "verse_number": "१२", "content_sanskrit": "हतपुत्रो हतामात्यो हतसर्वसुहृज्जनः ।\nदुःखं नूनं गमिष्यामि विचरन् पृथिवीमिमाम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2177872, "chapter_id": 4757, "verse_number": "१३", "content_sanskrit": "किं नु बन्धुविहीनस्य जीवितेन ममाद्य वै ।\nलूनपक्षस्य इव मे वैनतेयस्य सञ्जय\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2177873, "chapter_id": 4757, "verse_number": "१४", "content_sanskrit": "हृतराज्यो हतसुहृद्धतपुत्रश्च वै तथा ।\nन भ्राजामि महाप्राज्ञ क्षीणरश्मिरिवांशुमान्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2177874, "chapter_id": 4757, "verse_number": "१५", "content_sanskrit": "न कृतं सुहृदां वाक्यं जामदग्न्यस्य जल्पितम् ।\nनारदस्य च देवर्षेः कृष्णद्वैपायनस्य च\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2177875, "chapter_id": 4757, "verse_number": "१६", "content_sanskrit": "सभामध्ये तु कृष्णेन यच्छ्रेयोऽभिहितं मम ।\nअलं वैरेण ते राजन् पुत्रः सङ्गृह्यतामिति\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2177876, "chapter_id": 4757, "verse_number": "१७", "content_sanskrit": "तच्च तेषामकृत्वाऽद्य भृशं तप्स्यामि दुर्मतिः ।\nन हि श्रोष्यामि भीष्मस्य धर्मयुक्तं प्रभाषितम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2177877, "chapter_id": 4757, "verse_number": "१८", "content_sanskrit": "दुर्योधनस्य च तथा वृषभस्येव नर्दतः ।\nदुःशासनवधं श्रुत्वा कर्णस्य च विपर्ययम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2177878, "chapter_id": 4757, "verse_number": "१९", "content_sanskrit": "द्रोणसूर्योपरागं च हृदयं मे विदीर्यते\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2177879, "chapter_id": 4757, "verse_number": "२०", "content_sanskrit": "न स्मराम्यात्मनः किञ्चित् पुरा सञ्जय दुष्कृतम् ।\nयस्यैवं फलमद्येह मया मूढेन भुज्यते\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2177880, "chapter_id": 4757, "verse_number": "२१", "content_sanskrit": "नूनं ह्यपकृतं किञ्चिन्मया पूर्वेषु जन्मसु ।\nयेन मां दुःखभागेषु धाता कर्मसु युक्तवान्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2177881, "chapter_id": 4757, "verse_number": "२२", "content_sanskrit": "परिणामश्च वयसः सर्वबन्धुक्षयश्च मे ।\nसुहृन्मित्रविनाशश्च दैवयोगादुपागतः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2177882, "chapter_id": 4757, "verse_number": "२३", "content_sanskrit": "को न्वस्ति दुःखिततरो लोके मत्तः पुमानिह\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2177883, "chapter_id": 4757, "verse_number": "२४", "content_sanskrit": "तं मामद्यैव पश्यन्तु पाण्डवाः संशितव्रताः ।\nविस्तृतं ब्रह्मलोकस्य दीर्घमध्वानमास्थितम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2177884, "chapter_id": 4757, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2177885, "chapter_id": 4757, "verse_number": "२५", "content_sanskrit": "तस्य लालप्यमानस्य बहुशोकं विचिन्वतः ।\nशोकापहं नरेन्द्राय सञ्जयो वाक्यमब्रवीत्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2177886, "chapter_id": 4757, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2177887, "chapter_id": 4757, "verse_number": "२६", "content_sanskrit": "शोकं राजन् व्यपनुद श्रुतास्ते वेदनिश्चयाः ।\nशास्त्रागमाश्च विविधा वृद्धेभ्यो नृपसत्तम\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2177888, "chapter_id": 4757, "verse_number": "२७", "content_sanskrit": "सृञ्जये पुत्रशोकार्ते यदूचुर्मुनयः पुरा ।\nतथा यौवनकन्दर्पमास्थिते ते सुते नृप\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2177889, "chapter_id": 4757, "verse_number": "२८", "content_sanskrit": "न त्वया सुहृदां वाक्यं ब्रुवतामवधारितम् ।\nस्वार्थो न च कृतः कश्चिल्लुब्धेन फलगृध्नुना\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2177890, "chapter_id": 4757, "verse_number": "२९", "content_sanskrit": "असिनैवैकधारेण स्वबुद्ध्या भुवि चेष्टितम् ।\nप्रायशो वृत्तसम्पन्नाः सततं पर्युपासिताः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2177891, "chapter_id": 4757, "verse_number": "३०", "content_sanskrit": "तव दुःशासनो मन्त्री राधेयश्च दुरात्मवान् ।\nशकुनिश्चैव दुष्टात्मा चित्रसेनश्च दुर्मतिः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2177892, "chapter_id": 4757, "verse_number": "३१", "content_sanskrit": "अनल्पं येन वै सर्वं शल्यभूतमिदं जगत्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2177893, "chapter_id": 4757, "verse_number": "३२", "content_sanskrit": "कुरुवृद्धस्य भीष्मस्य गान्धार्या विदुरस्य च ।\nद्रोणस्य च महाराज कृपस्य च शरद्वतः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2177894, "chapter_id": 4757, "verse_number": "३३", "content_sanskrit": "कृष्णस्य च महाबाहो नारदस्य च धीमतः ।\nऋषीणां च तथाऽन्येषां व्यासस्यामिततेजसः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2177895, "chapter_id": 4757, "verse_number": "३४", "content_sanskrit": "न कृतं तेन वचनं पुत्रेण तव भारत\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2177896, "chapter_id": 4757, "verse_number": "३५", "content_sanskrit": "न धर्मः सत्कृतः कश्चित् नित्यं युद्धमभीप्सया\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2177897, "chapter_id": 4757, "verse_number": "३६", "content_sanskrit": "क्षपिताः क्षत्रियाः सर्वे शत्रूणां वर्धितं यशः ।\nमध्यस्थोऽपि त्वमप्यासीर्न क्षमं किञ्चिदुक्तवान्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2177898, "chapter_id": 4757, "verse_number": "३७", "content_sanskrit": "दुर्धरेण त्वया भारः तुलया न समो धृतः ।\nआदावेव मनुष्येण वर्तितव्यं यथाक्रमम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2177899, "chapter_id": 4757, "verse_number": "३८", "content_sanskrit": "यथा नातीतमर्थं वै पश्चात् तापेन युज्यते ।\nपुत्रगृद्ध्या त्वया राजन् प्रियं तस्य चिकीर्षितम्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2177900, "chapter_id": 4757, "verse_number": "३९", "content_sanskrit": "पश्चात् तापमिमं प्राप्तं न त्वं शोचितुमर्हसि\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2177901, "chapter_id": 4757, "verse_number": "४०", "content_sanskrit": "मधु यः केवलं दृष्ट्वा प्रपातं नानुपश्यति ।\nस भ्रष्टो मधुलोभेन शोचत्येव यथा भवान्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2177902, "chapter_id": 4757, "verse_number": "४१", "content_sanskrit": "अर्थं न शोचन् प्राप्नोति न शोचन् विन्दते सुखम् ।\nन शोचन् श्रियमाप्नोति न शोचन् विन्दते जयम्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2177903, "chapter_id": 4757, "verse_number": "४२", "content_sanskrit": "स्वयमुत्पादयित्वाऽग्निं परीतस्तेन योऽग्निना ।\nदह्यमानः पुनस्तापं भजते न स पण्डितः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2177904, "chapter_id": 4757, "verse_number": "४३", "content_sanskrit": "त्वयैव ससुतेनायं वाक्यवायुसमीरितः ।\nलोभाज्येन च संयुक्तो ज्वलितः पार्थपावकः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2177905, "chapter_id": 4757, "verse_number": "४४", "content_sanskrit": "तस्मिन् समिद्धे पतिताः शलभा इव ते सुताः ।\nतान् वै शराग्निनिर्दग्धान् न त्वं शोचितुमर्हसि\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2177906, "chapter_id": 4757, "verse_number": "४५", "content_sanskrit": "यच्चाश्रुपातकलिलं वदनं वहसे नृप ।\nअशास्त्रदृष्टमेतद्धि न प्रशंसन्ति पण्डिताः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2177907, "chapter_id": 4757, "verse_number": "४६", "content_sanskrit": "विष्फुलिङ्गा इवाग्नेस्तु दहन्ति किल मानवान् ।\nजहि मन्युं स्वबुद्ध्या वै धारयात्मानमात्मना\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2177908, "chapter_id": 4757, "verse_number": "४७", "content_sanskrit": "एषा वै सर्वसत्त्वानां लोकेश्वर परा गतिः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2177909, "chapter_id": 4757, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2177910, "chapter_id": 4757, "verse_number": "४८", "content_sanskrit": "तं समाश्वासितं तेन सञ्जयेन महात्मना ।\nविदुरो भूय एवाह बुद्धिपूर्वं परन्तपः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2177911, "chapter_id": 4757, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां स्त्रीपर्वणि\nधृतराष्ट्रविशोको नाम प्रथमोऽध्यायः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2177912, "chapter_id": 4757, "verse_number": "", "content_sanskrit": "जलप्रदानपर्वणि प्रथमोऽध्यायः ॥१॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}]