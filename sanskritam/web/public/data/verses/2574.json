[{"id": 2074529, "chapter_id": 2574, "verse_number": "१२-७९-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2074530, "chapter_id": 2574, "verse_number": "१२-७९-१", "content_sanskrit": "क्व समर्थाः कथंशीला ऋत्विजः स्युः पितामह।\nकथंविधाश्च राजेन्द्र तद्ब्रूहि वदतां वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2074531, "chapter_id": 2574, "verse_number": "१२-७९-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2074532, "chapter_id": 2574, "verse_number": "१२-७९-२", "content_sanskrit": "प्रतिकर्मपरा राजन्वृत्तिरस्य विधीयते।\nछन्दः सामादि विज्ञाय द्विजानां श्रुतमेवच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2074533, "chapter_id": 2574, "verse_number": "१२-७९-३", "content_sanskrit": "ये त्वेकरतयो नित्यं धीराश्च प्रियवादिनः।\nपरस्परस्य सुहृदः समन्तात्समदर्शिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2074534, "chapter_id": 2574, "verse_number": "१२-७९-४", "content_sanskrit": "आनृशंस्यं सत्यवाक्यमहिंसा दम आर्जवम्।\nअद्रोहोऽनभिमानश्च ह्रीस्तितिक्षा दमः शमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2074535, "chapter_id": 2574, "verse_number": "१२-७९-५", "content_sanskrit": "`यस्मिन्नेतानि दृश्यन्ते स पुरोहित उच्यते।\nधीमान्सत्यधृतिर्दान्तो भूतानामविहिंसकः।\nअकामद्वेषसंयुक्तस्त्रिभिः शुक्लैः समन्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2074536, "chapter_id": 2574, "verse_number": "१२-७९-६", "content_sanskrit": "अहिंसको ज्ञानतृप्तः स ब्रह्मासनमर्हति।\nएते महर्त्विजस्तात सर्वे मान्या यथार्हतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2074537, "chapter_id": 2574, "verse_number": "१२-७९-७x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2074538, "chapter_id": 2574, "verse_number": "१२-७९-७", "content_sanskrit": "यदिदं वेदवचनं दक्षिणासु विधीयते।\nइदं देयमिदं देयं न क्वचिव्द्यवतिष्ठते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2074539, "chapter_id": 2574, "verse_number": "१२-७९-८", "content_sanskrit": "देयं प्रतिधनं शास्त्रमापद्धर्मा न शास्त्रतः।\nआज्ञा शास्त्रस्य घोरे यं न शक्तिं समवेक्षते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2074540, "chapter_id": 2574, "verse_number": "१२-७९-९", "content_sanskrit": "श्रद्धामालम्ब्य यष्टव्यमित्येषा वैदिकी श्रुतिः।\nमिथ्योपेतस्य यज्ञस्य किमु श्रद्धा करिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2074541, "chapter_id": 2574, "verse_number": "१२-७९-१०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2074542, "chapter_id": 2574, "verse_number": "१२-७९-१०", "content_sanskrit": "न वेदानां परिभवान्न शाठ्येन न मायया।\nकश्चिन्महदवाप्नोति मा ते भूद्बुद्धिरीदृशी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2074543, "chapter_id": 2574, "verse_number": "१२-७९-११", "content_sanskrit": "यज्ञाङ्गं दक्षिणा तात मन्त्राणां परिबृंहणम्।\nन मन्त्रा दक्षिणाहीनास्तारयन्ति कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2074544, "chapter_id": 2574, "verse_number": "१२-७९-१२", "content_sanskrit": "शक्तिस्तु पूर्णपात्रेण संमिता नावमा भवेत्।\nअवश्यं तात यष्टव्यं त्रिभिर्वर्णैर्थथाबलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2074545, "chapter_id": 2574, "verse_number": "१२-७९-१३", "content_sanskrit": "सोमो राजा ब्राह्मणानामित्येषा वैदिकी श्रुतिः।\nतं च विक्रेतुमिच्छन्ति न तथा वृत्तिरिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2074546, "chapter_id": 2574, "verse_number": "१२-७९-१४", "content_sanskrit": "तेन क्रीतेन धर्मेण ततो यज्ञः प्रतायते।\nइत्येवं धर्ममाख्यातमृषिभिर्धर्मकोविदैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2074547, "chapter_id": 2574, "verse_number": "१२-७९-१५", "content_sanskrit": "पुमान्यज्ञश्च सोमश्च न्यायवृत्तो यदा भवेत्।\nअन्यायवृत्तः पुरुषो न परस्य न चात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2074548, "chapter_id": 2574, "verse_number": "१२-७९-१६", "content_sanskrit": "शरीरं यज्ञपात्राणि इत्येषा श्रूयते श्रुतिः।\nतानि सम्यक्प्रणीतानि ब्राह्मणानां महात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2074549, "chapter_id": 2574, "verse_number": "१२-७९-१७", "content_sanskrit": "तपो यज्ञादपि श्रेष्ठमित्येषा परमा श्रुतिः।\nतत्ते तपः प्रवक्ष्यामि विद्वंस्तदपि मे शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2074550, "chapter_id": 2574, "verse_number": "१२-७९-१८", "content_sanskrit": "अहिंसा सत्यवचनमानृशंस्यं दमो घृणा।\nएतत्तपो विदुर्धीरा न शरीरस्य शोषणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2074551, "chapter_id": 2574, "verse_number": "१२-७९-१९", "content_sanskrit": "अप्रामाण्यं च वेदानां शास्त्राणां चातिलङ्घनम्।\nअव्यवस्था च सर्वत्र तद्वै नाशनमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2074552, "chapter_id": 2574, "verse_number": "१२-७९-२०", "content_sanskrit": "निबोध दशहोतॄणां विधानं पार्थ यादृशम्।\nचित्तिः स्रुक् चित्तमाज्यं च पवित्रं ज्ञानमुत्तमम्।\n`न शाठ्यं न च जिह्यत्वं कालो देशश्च ते दश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2074553, "chapter_id": 2574, "verse_number": "१२-७९-२१", "content_sanskrit": "सर्वं दिह्नं मृत्युपदमार्जवं ब्रह्मणः पदम्।\nएतावाञ्ज्ञानविषयः किं प्रलापः करिष्यति॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2074554, "chapter_id": 2574, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि एकोनाशीतितमोऽध्यायः॥ ७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]