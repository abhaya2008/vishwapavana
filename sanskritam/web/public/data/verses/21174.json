[{"id": 7001174000, "chapter_id": 21174, "verse_number": "२-३-२२-१", "content_sanskrit": "ब्रह्मोवाच ।\nत्वयि देवमुने याते पार्वती हृष्टमानसा ।\nतपस्साध्यं हरं मेने तपोर्थं मन आदधे॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001174001, "chapter_id": 21174, "verse_number": "२-३-२२-२", "content_sanskrit": "ततः सख्यौ समादाय जयां च विजयां तथा ।\nमातरं पितरं चैव सखीभ्यां पर्यपृच्छत॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001174002, "chapter_id": 21174, "verse_number": "२-३-२२-३", "content_sanskrit": "प्रथमं पितरं गत्वा हिमवन्तं नगेश्वरम् ।\nपर्यपृच्छत्सुप्रणम्य विनयेन समन्विता॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001174003, "chapter_id": 21174, "verse_number": "२-३-२२-४", "content_sanskrit": "सख्यावूचतुः ।\nहिमवञ्च्छ्रूयतां पुत्री वचनं कथ्यतेऽधुना ।\nसा स्वयं चैव देहस्य रूपस्यापि तथा पुनः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001174004, "chapter_id": 21174, "verse_number": "२-३-२२-५", "content_sanskrit": "भवतो हि कुलस्यास्य साफल्यं कर्तुमिच्छति ।\nतपसा साधनीयोऽसौ नान्यथा दृश्यतां व्रजेत्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001174005, "chapter_id": 21174, "verse_number": "२-३-२२-६", "content_sanskrit": "तस्माच्च पर्वतश्रेष्ठ देह्याज्ञां भवताधुना ।\nतपः करोतु गिरिजा वनं गत्वेति सादरम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001174006, "chapter_id": 21174, "verse_number": "२-३-२२-७", "content_sanskrit": "ब्रह्मोवाच ।\nइत्येवं च तदा पृष्टस्सखीभ्यां मुनिसत्तम ।\nपार्वत्या सुविचार्याथ गिरिराजोऽब्रवीदिदम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001174007, "chapter_id": 21174, "verse_number": "२-३-२२-८", "content_sanskrit": "हिमालय उवाच ।\nमह्यं च रोचतेऽत्यर्थं मेनायै रुच्यतां पुनः ।\nयथेदं भवितव्यं च किमतः परमुत्तमम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001174008, "chapter_id": 21174, "verse_number": "२-३-२२-९", "content_sanskrit": "साफल्यं तु मदीयस्य कुलस्य च न संशयः ।\nमात्रे तु रुच्यते चेद्वै ततः शुभतरं नु किम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001174009, "chapter_id": 21174, "verse_number": "२-३-२२-१०", "content_sanskrit": "ब्रह्मोवाच ।\nइत्येवं वचनं पित्रा प्रोक्तं श्रुत्वा तु ते तदा ।\nजग्मतुर्मातरं सख्यौ तदाज्ञप्ते तया सह॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001174010, "chapter_id": 21174, "verse_number": "२-३-२२-११", "content_sanskrit": "गत्वा तु मातरं तस्याः पार्वत्यास्ते च नारद ।\nसुप्रणम्य करो बध्वोचतुर्वचनमादरात्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001174011, "chapter_id": 21174, "verse_number": "२-३-२२-१२", "content_sanskrit": "सख्यावूचतुः ।\nमातस्त्वं वचनं पुत्र्याः शृणु देवि नमोऽस्तु ते ।\nसुप्रसन्नतया तद्वै श्रुत्वा कर्तुमिहार्हसि॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001174012, "chapter_id": 21174, "verse_number": "२-३-२२-१३", "content_sanskrit": "तप्तुकामा तु ते पुत्री शिवार्थं परमं तपः ।\nप्राप्तानुज्ञा पितुश्चैव तुभ्यं च परिपृच्छति॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001174013, "chapter_id": 21174, "verse_number": "२-३-२२-१४", "content_sanskrit": "इयं स्वरूपसाफल्यं कर्तुकामा पतिव्रते ।\nत्वदाज्ञया यदि जायेत तप्यते च तथा तपः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001174014, "chapter_id": 21174, "verse_number": "२-३-२२-१५", "content_sanskrit": "॥ ब्रह्मोवाच  ।\nइत्युक्त्वा च ततस्सख्यौ तूष्णीमास्तां मुनीश्वर ।\nनांगीचकार मेना सा तद्वाक्यं खिन्नमानसा॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001174015, "chapter_id": 21174, "verse_number": "२-३-२२-१६", "content_sanskrit": "ततस्सा पार्वती प्राह स्वयमेवाथ मातरम् ।\nकरौ बद्ध्वा विनीतात्मा स्मृत्वा शिवपदांबुजम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001174016, "chapter_id": 21174, "verse_number": "२-३-२२-१७", "content_sanskrit": "पार्वत्युवाच ।\nमातस्तप्तुं गमिष्यामि प्रातः प्राप्तुं महेश्वरम् ।\nअनुजानीहि मां गंतुं तपसेऽद्य तपोवनम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001174017, "chapter_id": 21174, "verse_number": "२-३-२२-१८", "content_sanskrit": "॥ ब्रह्मोवाच  ।\nइत्याकर्ण्य वचः पुत्र्या मेना दुःख मुपागता ।\nसोपाहूय तदा पुत्रीमुवाच विकला सती॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001174018, "chapter_id": 21174, "verse_number": "२-३-२२-१९", "content_sanskrit": "मेनोवाच ।\nदुःखितासि शिवे पुत्री तपस्तप्तुं पुरा यदि ।\nतपश्चर गृहेऽद्य त्वं न बहिर्गच्छ पार्वति॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001174019, "chapter_id": 21174, "verse_number": "२-३-२२-२०", "content_sanskrit": "कुत्र यासि तपः कर्तुं देवास्संति गृहे मम ।\nतीर्थानि च समस्तानि क्षेत्राणि विविधानि च॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001174020, "chapter_id": 21174, "verse_number": "२-३-२२-२१", "content_sanskrit": "कर्तव्यो न हठः पुत्रि गंतव्यं न बहिः क्वचित् ।\nसाधितं किं त्वया पूर्वं पुनः किं साधयिष्यसि॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001174021, "chapter_id": 21174, "verse_number": "२-३-२२-२२", "content_sanskrit": "शरीरं कोमलं वत्से तपस्तु कठिनं महत् ।\nएवस्मात्तु त्वया कार्यं तपोऽत्र न बहिर्व्रज॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001174022, "chapter_id": 21174, "verse_number": "२-३-२२-२३", "content_sanskrit": "स्त्रीणां तपोवनगतिर्न श्रुता कामनार्थिनी ।\nतस्मात्त्वं पुत्रि मा कार्षीस्तपोर्थं गमनं प्रति॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001174023, "chapter_id": 21174, "verse_number": "२-३-२२-२४", "content_sanskrit": "॥ ब्रह्मोवाच  ।\nइत्येवं बहुधा पुत्री तन्मात्रा विनवारिता ।\nसंवेदे न सुखं किंचिद्विनाराध्य महेश्वरम्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001174024, "chapter_id": 21174, "verse_number": "२-३-२२-२५", "content_sanskrit": "तपोनिषिद्धा तपसे वनं गंतुं च मेनया ।\nहेतुना तेन सोमेति नाम प्राप शिवा तदा॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001174025, "chapter_id": 21174, "verse_number": "२-३-२२-२६", "content_sanskrit": "अथ तां दुखितां ज्ञात्वा मेना शैलप्रिया शिवाम् ।\nनिदेशं सा ददौ तस्याः पार्वत्यास्तपसे मुने॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001174026, "chapter_id": 21174, "verse_number": "२-३-२२-२७", "content_sanskrit": "मातुराज्ञां च संप्राप्य सुव्रता मुनिसत्तम ।\nततः स्वांते सुखं लेभे पार्वती स्मृतशंकरा॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001174027, "chapter_id": 21174, "verse_number": "२-३-२२-२८", "content_sanskrit": "मातरं पितरं साथ प्रणिपत्य मुदा शिवा ।\nसखीभ्यां च शिवं स्मृत्वा तपस्तप्तुं समुद्गता॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001174028, "chapter_id": 21174, "verse_number": "२-३-२२-२९", "content_sanskrit": "हित्वा मतान्यनेकानि वस्त्राणि विविधानि च ।\nवल्कलानि धृतान्याशु मौंजीं बद्ध्वा तु शोभनाम्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001174029, "chapter_id": 21174, "verse_number": "२-३-२२-३०", "content_sanskrit": "हित्वा हारं तथा चर्म्म मृगस्य परमं धृतम् ।\nजगाम तपसे तत्र गंगावतरणं प्रति॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001174030, "chapter_id": 21174, "verse_number": "२-३-२२-३१", "content_sanskrit": "शंभुना कुर्वता ध्यानं यत्र दग्धो मनोभवः ।\nगंगावतरणो नाम प्रस्थो हिमवतस्स च॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001174031, "chapter_id": 21174, "verse_number": "२-३-२२-३२", "content_sanskrit": "हरशून्योऽथ ददृशे स प्रस्थो हिमभूभृतः ।\nकाल्या तत्रेत्य भोस्तात पार्वत्या जगदम्बया॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001174032, "chapter_id": 21174, "verse_number": "२-३-२२-३३", "content_sanskrit": "यत्र स्थित्वा पुरा शंभुस्तप्तवान्दुस्तरं तपः ।\nतत्र क्षणं तु सा स्थित्वा बभूव विरहार्दिता॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001174033, "chapter_id": 21174, "verse_number": "२-३-२२-३४", "content_sanskrit": "हा हरेति शिवा तत्र रुदन्ती सा गिरेस्सुता ।\nविललापातिदुःखार्ता चिन्ताशोकसमन्विता॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001174034, "chapter_id": 21174, "verse_number": "२-३-२२-३५", "content_sanskrit": "ततश्चिरेण सा मोहं धैर्य्या त्संस्तभ्य पार्वती ।\nनियमायाऽभवत्तत्र दीक्षिता हिमवत्सुता॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001174035, "chapter_id": 21174, "verse_number": "२-३-२२-३६", "content_sanskrit": "तपश्चकार सा तत्र शृंगितीर्थे महोत्तमे ।\nगौरीशिखर नामासीत्तत्तपःकरणाद्धि तत्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001174036, "chapter_id": 21174, "verse_number": "२-३-२२-३७", "content_sanskrit": "सुंदराश्च द्रुमास्तत्र पवित्राश्शिवया मुने ।\nआरोपिताः परीक्षार्थं तपसः फलभागिनः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001174037, "chapter_id": 21174, "verse_number": "२-३-२२-३८", "content_sanskrit": "भूभिशुद्धिं ततः कृत्वा वेदीं निर्माय सुन्दरी ।\nतथा तपस्समारब्धं मुनीनामपि दुष्करम्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001174038, "chapter_id": 21174, "verse_number": "२-३-२२-३९", "content_sanskrit": "विगृह्य मनसा सर्वाणींद्रियाणि सहाशु सा ।\nसमुपस्थानिके तत्र चकार परमं तपः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001174039, "chapter_id": 21174, "verse_number": "२-३-२२-४०", "content_sanskrit": "ग्रीष्मे च परितो वह्निं प्रज्वलंतं दिवानिशम् ।\nकृत्वा तस्थौ च तन्मध्ये सततं जपती मनुम॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001174040, "chapter_id": 21174, "verse_number": "२-३-२२-४१", "content_sanskrit": "सततं चैव वर्षासु स्थंडिले सुस्थिरासना ।\nशिलापृष्ठे च संसिक्ता बभूव जलधारया॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001174041, "chapter_id": 21174, "verse_number": "२-३-२२-४२", "content_sanskrit": "शीते जलांतरे शश्वत्तस्थौ सा भक्तितत्परा ।\nअनाहारातपत्तत्र नीहारे निशासु च॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001174042, "chapter_id": 21174, "verse_number": "२-३-२२-४३", "content_sanskrit": "एवं तपः प्रकुर्वाणा पंचाक्षरजपे रता ।\nदध्यौ शिवं शिवा तत्र सर्वकामफलप्रदम्॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001174043, "chapter_id": 21174, "verse_number": "२-३-२२-४४", "content_sanskrit": "स्वारोपिताच्छुभान्वृक्षान्सखीभिस्सिंचती मुदा ।\nप्रत्यहं सावकाशे सा तत्रातिथ्यमकल्पयत्॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001174044, "chapter_id": 21174, "verse_number": "२-३-२२-४५", "content_sanskrit": "वातश्चैव तथा शीतवृष्टिश्च विविधा तथा ।\nदुस्सहोऽपि तथा घर्म्मस्तया सेहे सुचित्तया॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001174045, "chapter_id": 21174, "verse_number": "२-३-२२-४६", "content_sanskrit": "दुःखं च विविधं तत्र गणितं न तयागतम् ।\nकेवलं मन आधाय शिवे सासीत्स्थिता मुने॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001174046, "chapter_id": 21174, "verse_number": "२-३-२२-४७", "content_sanskrit": "प्रथमं फलभोगेन द्वितीयं पर्णभोजनैः ।\nतपः प्रकुर्वती देवी क्रमान्निन्येऽमिताः समाः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001174047, "chapter_id": 21174, "verse_number": "२-३-२२-४८", "content_sanskrit": "ततः पर्णान्यपि शिवा निरस्य हिमवत्सुता ।\nनिराहाराभवद्देवी तपश्चरणसंरता॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001174048, "chapter_id": 21174, "verse_number": "२-३-२२-४९", "content_sanskrit": "आहारे त्यक्तपर्णाभूद्यस्माद्धिमवतः सुतः ।\nतेन देवैरपर्णेति कथिता नामतः शिवा॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001174049, "chapter_id": 21174, "verse_number": "२-३-२२-५०", "content_sanskrit": "एका पादस्थिता सासीच्छिवं संस्मृत्य पार्वती ।\nपंचाक्षरं जपंती च मनुं तेपे तपो महत्॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001174050, "chapter_id": 21174, "verse_number": "२-३-२२-५१", "content_sanskrit": "चीरवल्कलसंवीता जटासंघातधारिणी ।\nशिवचिंतनसंसक्ता जिगाय तपसा मुनीम्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001174051, "chapter_id": 21174, "verse_number": "२-३-२२-५२", "content_sanskrit": "एवं तस्यास्तपस्यन्त्या चिंतयंत्या महेश्वरम् ।\nत्रीणि वर्ष सहस्राणि जग्मुः काल्यास्तपोवने॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001174052, "chapter_id": 21174, "verse_number": "२-३-२२-५३", "content_sanskrit": "षष्टिवर्षसहस्राणि यत्र तेपे तपो हरः ।\nतत्र क्षणमथोषित्वा चिंतयामास सा शिवा॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001174053, "chapter_id": 21174, "verse_number": "२-३-२२-५४", "content_sanskrit": "नियमस्थां महादेव किं मां जानासि नाधुना ।\nयेनाहं सुचिरं तेन नानुयाता तवोरता॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001174054, "chapter_id": 21174, "verse_number": "२-३-२२-५५", "content_sanskrit": "लोके वेदे च गिरिशो मुनिभिर्गीयते सदा ।\nशंकरस्य हि सर्वज्ञस्सर्वात्मा सर्वदर्शनः॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001174055, "chapter_id": 21174, "verse_number": "२-३-२२-५६", "content_sanskrit": "सर्वभूतिप्रदो देवस्सर्वभावानुभावनः ।\nभक्ताभीष्टप्रदो नित्यं सर्वक्लेशनिवारणः॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001174056, "chapter_id": 21174, "verse_number": "२-३-२२-५७", "content_sanskrit": "सर्वकामान्परित्यज्य यदि चाहं वृषध्वजे ।\nअनुरक्ता तदा सोत्र संप्रसीदतु शंकरः॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001174057, "chapter_id": 21174, "verse_number": "२-३-२२-५८", "content_sanskrit": "यदि नारद तत्रोक्तमंत्रो जप्तश्शराक्षरः ।\nसुभक्त्या विधिना नित्यं संप्रसीदतु शंकरः॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001174058, "chapter_id": 21174, "verse_number": "२-३-२२-५९", "content_sanskrit": "यदि भक्त्या शिवस्याहं निर्विकारा यथोदितम् ।\nसर्वेश्वरस्य चात्यंतं संप्रसीदतु शंकरः॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001174059, "chapter_id": 21174, "verse_number": "२-३-२२-६०", "content_sanskrit": "एवं चिंतयती नित्यं तेपे सा सुचिरं तपः ।\nअधोमुखी निर्विकारा जटावल्कलधारिणी॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001174060, "chapter_id": 21174, "verse_number": "२-३-२२-६१", "content_sanskrit": "तथा तया तपस्तप्तं मुनीनामपि दुष्करम् ।\nस्मृत्वा च पुरुषास्तत्र परमं विस्मयं गताः॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001174061, "chapter_id": 21174, "verse_number": "२-३-२२-६२", "content_sanskrit": "तत्तपोदर्शनार्थं हि समाजग्मुश्च तेऽखिलाः ।\nधन्यान्निजान्मन्यमाना जगदुश्चेति सम्मताः॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001174062, "chapter_id": 21174, "verse_number": "२-३-२२-६३", "content_sanskrit": "महतां धर्म्मवृद्धेषु गमनं श्रेय उच्यते ।\nप्रमाणं तपसो नास्ति मान्यो धर्म्मस्सदा बुधैः॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001174063, "chapter_id": 21174, "verse_number": "२-३-२२-६४", "content_sanskrit": "श्रुत्वा दृष्ट्वा तपोऽस्यास्तु किमन्यैः क्रियते तपः ।\nअस्मात्तपोऽधिकं लोके न भूतं न भविष्यति॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001174064, "chapter_id": 21174, "verse_number": "२-३-२२-६५", "content_sanskrit": "जल्पंत इति ते सर्वे सुप्रशस्य शिवातपः ।\nजग्मुः स्वं धाम मुदिताः कठिनांगाश्च ये ह्यपि॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001174065, "chapter_id": 21174, "verse_number": "२-३-२२-६६", "content_sanskrit": "अन्यच्छृणु महर्षे त्वं प्रभावं तपसोऽधुना ।\nपार्वत्या जगदम्बायाः पराश्चर्य्यकरं महत्॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001174066, "chapter_id": 21174, "verse_number": "२-३-२२-६७", "content_sanskrit": "तदाश्रमगता ये च स्वभावेन विरोधिनः ।\nतेप्यासंस्तत्प्रभावेण विरोधरहि तास्तदा॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001174067, "chapter_id": 21174, "verse_number": "२-३-२२-६८", "content_sanskrit": "सिंहा गावश्च सततं रागादिदोषसंयुताः ।\nतन्महिम्ना च ते तत्र नाबाधंत परस्परम्॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001174068, "chapter_id": 21174, "verse_number": "२-३-२२-६९", "content_sanskrit": "अथान्ये च मुनिश्रेष्ठ मार्ज्जारा मूषकादयः ।\nनिसर्गाद्वैरिणो यत्र विक्रियंते स्म न क्वचित्॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001174069, "chapter_id": 21174, "verse_number": "२-३-२२-७०", "content_sanskrit": "वृक्षाश्च सफलास्तत्र तृणानि विविधानि च ।\nपुष्पाणि च विचित्राणि तत्रासन्मुनिसत्तम॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001174070, "chapter_id": 21174, "verse_number": "२-३-२२-७१", "content_sanskrit": "तद्वनं च तदा सर्वं कैलासेनोपमान्वितम् ।\nजातं च तपस्तस्यास्सिद्धिरूपमभूत्तदा॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}]