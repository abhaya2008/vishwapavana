[{"id": 2071366, "chapter_id": 2506, "verse_number": "१२-११-०x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2071367, "chapter_id": 2506, "verse_number": "१२-११-१", "content_sanskrit": "अत्रैवोदाहरन्तीममितिहासं पुरातनम्।\nतापसैः सह संवादं शक्रस्य भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2071368, "chapter_id": 2506, "verse_number": "१२-११-२", "content_sanskrit": "`शक्यं पुनररण्येषु सुखमेतेन जीवितुम्।\nकेचिद्गृहान्परित्यज्य वनमभ्यागमन्द्विजाः।\nअजातश्मश्रवो मन्दाः कुले जाताः प्रवव्रजुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2071369, "chapter_id": 2506, "verse_number": "१२-११-३", "content_sanskrit": "धर्मोऽयमिति मन्वानाः समृद्धा धर्मचारिणः।\nत्यक्त्वा भ्रातॄन्पितॄंश्चैव तानिन्द्रोऽन्वकृपायत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2071370, "chapter_id": 2506, "verse_number": "१२-११-४", "content_sanskrit": "स तान्बभाषे मघवान्पक्षीभूत्वा हिरण्मयः।\nसुदुष्करं मनुष्यैस्तु यत्कृतं विघसाशिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2071371, "chapter_id": 2506, "verse_number": "१२-११-५", "content_sanskrit": "पुण्यं भवति कर्मैषां प्रशस्तं चैव जीवितम्।\nसिद्धार्थास्ते गतिं मुख्यां प्राप्ताः कर्मपरायणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2071372, "chapter_id": 2506, "verse_number": "१२-११-६x", "content_sanskrit": "ऋषय ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2071373, "chapter_id": 2506, "verse_number": "१२-११-६", "content_sanskrit": "अहो बतायं शकुनिर्विघसाशान्प्रशंसति।\nअस्मान्नूनमयं शास्ति वयं च विघसाशिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2071374, "chapter_id": 2506, "verse_number": "१२-११-७x", "content_sanskrit": "शकुनिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2071375, "chapter_id": 2506, "verse_number": "१२-११-७", "content_sanskrit": "नाहं युष्मान्प्रशंसामि पङ्कदिग्धान्रजस्वलान्।\nउच्छिष्टभोजिनो मन्दानन्ये वै विघसाशिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2071376, "chapter_id": 2506, "verse_number": "१२-११-८x", "content_sanskrit": "ऋषय ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2071377, "chapter_id": 2506, "verse_number": "१२-११-८", "content_sanskrit": "इदं श्रेयः परमिति वयमेवममंस्महि।\nशकुने ब्रूहि यच्छ्रेयो वयं ते श्रद्दधामहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2071378, "chapter_id": 2506, "verse_number": "१२-११-९x", "content_sanskrit": "शकुनिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2071379, "chapter_id": 2506, "verse_number": "१२-११-९", "content_sanskrit": "यदि मां नाभिशङ्कध्वं विभज्यात्मानमात्मना।\nततोऽहं वः प्रवक्ष्यामि याथातथ्यं हितं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2071380, "chapter_id": 2506, "verse_number": "१२-११-१०x", "content_sanskrit": "ऋषय ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2071381, "chapter_id": 2506, "verse_number": "१२-११-१०", "content_sanskrit": "शृणुमस्ते वचस्तात पन्थानो विदितास्तव।\nनियोगे चैव धर्मात्मन्स्थातुमिच्छाम शाधि नः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2071382, "chapter_id": 2506, "verse_number": "१२-११-११x", "content_sanskrit": "शकुनिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2071383, "chapter_id": 2506, "verse_number": "१२-११-११", "content_sanskrit": "चतुष्पदां गौः प्रवरा लोहानां काञ्चनं वरम्।\nशब्दानां प्रवरो मन्त्रो ब्राह्मणो द्विपदां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2071384, "chapter_id": 2506, "verse_number": "१२-११-१२", "content_sanskrit": "मन्त्रोऽयं जातकर्मादिर्ब्राह्मणस्य विधीयते।\nजीवतोऽपि यथाकालं श्मशाननिधनान्तकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2071385, "chapter_id": 2506, "verse_number": "१२-११-१३", "content_sanskrit": "कर्माणि वैदिकान्यस्य स्वर्ग्यः पन्थास्त्वनुत्तमः।\nअथ सर्वाणि कर्माणि मन्त्रसिद्धानि चक्षते।\nआम्नायदृढवादीनि तथा सिद्धिरिहेष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2071386, "chapter_id": 2506, "verse_number": "१२-११-१४", "content_sanskrit": "मासार्धमासा ऋतव आदित्यशशितारकम्।\nग्रसन्ते कर्म भूतानि तदिदं कर्मशंसिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2071387, "chapter_id": 2506, "verse_number": "१२-११-१५", "content_sanskrit": "सिद्धिक्षेत्रमिदं पुण्यमयमेवाश्रमो महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2071388, "chapter_id": 2506, "verse_number": "१२-११-१६", "content_sanskrit": "अथ ये कर्म निन्दन्तो मनुष्याः कापथं गताः।\nमूढानामर्थहीनानां तेषामेनस्तु विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2071389, "chapter_id": 2506, "verse_number": "१२-११-१७", "content_sanskrit": "देववंशान्पितृवंशान्ब्रह्मवंशांश्च शाश्चतान्।\nसंत्यज्य मूढा वर्तन्ते ततो यान्त्यशुचीन्पथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2071390, "chapter_id": 2506, "verse_number": "१२-११-१८", "content_sanskrit": "एतद्वोऽस्तु तपोयुक्तं ददामीत्यृषिचोदितम्।\nतस्मात्तदध्यावसतस्तपस्वित्वमिहोच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2071391, "chapter_id": 2506, "verse_number": "१२-११-१९", "content_sanskrit": "देववंशान्ब्रह्मवंशान्पितृवंशांश्च शाश्वतान्।\nसंविभज्य गुरोश्चर्यां तद्वै दुष्करमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2071392, "chapter_id": 2506, "verse_number": "१२-११-२०", "content_sanskrit": "देवा वै दुष्करं कृत्वा विभूतिं परमां गताः।\nतस्माद्गार्हस्थ्यमुद्वोढुं दुष्करं प्रब्रवीमि वः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2071393, "chapter_id": 2506, "verse_number": "१२-११-२१", "content_sanskrit": "तपः श्रेष्ठं प्रजानां हि मूलमेतन्न संशयः।\nकुटुम्वविधिनाऽनेन यस्मिन्सर्वं प्रतिष्ठितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2071394, "chapter_id": 2506, "verse_number": "१२-११-२२", "content_sanskrit": "एतद्विदुस्तपो विप्रा द्वन्द्वातीता विमत्सराः।\nएतस्माद्वनमध्ये तु लोकेषु तप उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2071395, "chapter_id": 2506, "verse_number": "१२-११-२३", "content_sanskrit": "दुराधर्षं पदं चैव गच्छन्ति विघसाशिनः।\nसायंप्रातर्विभज्यान्नं स्वकुटुम्बे यथाविधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2071396, "chapter_id": 2506, "verse_number": "१२-११-२४", "content_sanskrit": "दत्त्वाऽतिथिभ्यो देवेभ्यः पितृभ्यः स्वजनाय च।\nअवशिष्टानि येऽश्नन्ति तानाहुर्विघसाशिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2071397, "chapter_id": 2506, "verse_number": "१२-११-२५", "content_sanskrit": "तस्मात्स्वधर्ममास्थाय सुव्रताः सत्यवादिनः।\nलोकस्य गुरवो भूत्वा ते भवन्त्यनुपस्कृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2071398, "chapter_id": 2506, "verse_number": "१२-११-२६", "content_sanskrit": "त्रिदिवं प्राप्य शक्रस्य स्वर्गलोके विमत्सराः।\nवसन्ति शाश्वतान्वर्षाञ्जना दुष्करकारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2071399, "chapter_id": 2506, "verse_number": "१२-११-२७x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2071400, "chapter_id": 2506, "verse_number": "१२-११-२७", "content_sanskrit": "ततस्ते तद्वचः श्रुत्वा धर्मार्थसहितं हितम्।\nउत्सृज्य नास्तिकमतिं गार्हस्थ्यं धर्ममाश्रिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2071401, "chapter_id": 2506, "verse_number": "१२-११-२८", "content_sanskrit": "तस्मात्त्वमपि सर्वज्ञ धैर्यमालम्ब्य शाश्वतम्।\nप्रशाधि पृथिवीं कृत्स्नां हतामित्रां नरोत्तम॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2071402, "chapter_id": 2506, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि एकादशोऽध्यायः॥ ११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]