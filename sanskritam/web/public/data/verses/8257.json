[{"id": 900002180, "chapter_id": 8257, "verse_number": "2.1", "content_sanskrit": "आप्यायन्तु ममाङ्गानि वाक्प्राणश्चक्षुः ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900002181, "chapter_id": 8257, "verse_number": "2.2", "content_sanskrit": "पूर्णानन्दमहोदधिः परतमो नित्यः ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900002182, "chapter_id": 8257, "verse_number": "2.3", "content_sanskrit": "यस्य त्रीण्युदितानि वेदवचने रूपाणि दिव्यान्यलं ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900002183, "chapter_id": 8257, "verse_number": "2.4", "content_sanskrit": "हनशब्दो ज्ञानवाची हनूमान् मतिशब्दितः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}]