[{"id": 2091328, "chapter_id": 2941, "verse_number": "१३-७१-१", "content_sanskrit": "भीष्म उवाच।\nअत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nशक्रशम्बरसंवादं तन्निवोध युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2091329, "chapter_id": 2941, "verse_number": "१३-७१-२", "content_sanskrit": "शक्रो ह्यज्ञातरूपेण जटी भूत्वा सुवारुणः।\nविप्ररूपं समास्थाय प्रश्नं पप्रच्छ शम्बरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2091330, "chapter_id": 2941, "verse_number": "१३-७१-३", "content_sanskrit": "केन शम्बर वृत्तेन स्वजात्यानधितिष्ठसि।\nश्रेष्ठं त्वां केन मन्यन्ते तद्वै प्रब्रूहि तत्त्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2091331, "chapter_id": 2941, "verse_number": "१३-७१-४x", "content_sanskrit": "शम्बर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2091332, "chapter_id": 2941, "verse_number": "१३-७१-४", "content_sanskrit": "नासूयामि सदा विप्रान्ब्राह्ममेव च मे मतम्।\nशास्त्राणि वदतो विप्रान्संमन्यामि यथासुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2091333, "chapter_id": 2941, "verse_number": "१३-७१-५", "content_sanskrit": "श्रुत्वा च नावजानामि नापराध्यामि कर्हिचित्।\nअभ्यर्च्याभ्यनुपृच्छामि पादौ गृह्णामि धीमताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2091334, "chapter_id": 2941, "verse_number": "१३-७१-६", "content_sanskrit": "ते विस्रब्धाः प्रभाषन्ते संयच्छन्ति च मां सदा।\nप्रमत्तेष्वप्रमत्तोऽस्मि सदा सुप्तेषु जागृमि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2091335, "chapter_id": 2941, "verse_number": "१३-७१-७", "content_sanskrit": "ते मां शास्त्रपथे युक्तं ब्रह्मण्यमनसूयकम्।\nसमासिञ्चति शास्तारः क्षौद्रं मध्विव मक्षिकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2091336, "chapter_id": 2941, "verse_number": "१३-७१-८", "content_sanskrit": "यच्च भाषन्ति संतुष्टास्तच्च गृह्णाम्यमायया।\nसमाधिमात्मनो नित्यमनुलोममचिन्तयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2091337, "chapter_id": 2941, "verse_number": "१३-७१-९", "content_sanskrit": "सोहं वागग्रमृष्टानां रसानामवलेहकः।\nस्वजात्यानधितिष्ठामि नक्षत्राणीव चन्द्रमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2091338, "chapter_id": 2941, "verse_number": "१३-७१-१०", "content_sanskrit": "एतत्पृथिव्याममृतमेतच्चक्षुरनुत्तमम्।\nयद्ब्राह्मणमुखाच्छास्त्रमिह श्रुत्वा प्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2091339, "chapter_id": 2941, "verse_number": "१३-७१-११", "content_sanskrit": "एतत्कारणमाज्ञाय दृष्ट्वा देवासुरं पुरा।\nयुद्धं पिता मे हृष्टात्मा विस्मितः समपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2091340, "chapter_id": 2941, "verse_number": "१३-७१-१२", "content_sanskrit": "दृष्ट्वा च ब्राह्मणानां तु महिमानं महात्मनाम्।\nपर्यपृच्छत्कथममी सिद्धा इति निशाकरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2091341, "chapter_id": 2941, "verse_number": "१३-७१-१३x", "content_sanskrit": "सोम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2091342, "chapter_id": 2941, "verse_number": "१३-७१-१३", "content_sanskrit": "ब्राह्मणास्तपसा सर्वे सिध्यन्ते वाग्बलाः सदा।\nभुजवीर्याश्च राजानो वागस्त्राश्च द्विजातयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2091343, "chapter_id": 2941, "verse_number": "१३-७१-१४", "content_sanskrit": "प्रवसन्वाप्यधीयीत ब्राह्मीर्दुर्वसतीर्वसन्।\nनिर्मन्युरपि निर्वाणो यतिः स्यात्समदर्शनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2091344, "chapter_id": 2941, "verse_number": "१३-७१-१५", "content_sanskrit": "अपि च ज्ञानसम्पन्नः सर्वान्वेदान्पितुर्गृहे।\nश्लाघमान इवाधीयाद्ग्राम्य इत्येव तं विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2091345, "chapter_id": 2941, "verse_number": "१३-७१-१६", "content_sanskrit": "भूमिरेतौ निगिरति सर्पो बिलशयानिव।\nराजानं चाप्ययोद्धारं ब्राह्मणं चाप्रवासिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2091346, "chapter_id": 2941, "verse_number": "१३-७१-१७", "content_sanskrit": "अभिमानः श्रियं हन्ति पुरुषस्याल्पमेधसः।\nगर्भेण दुष्यते कन्या गृहवासेन च द्विजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2091347, "chapter_id": 2941, "verse_number": "१३-७१-१८", "content_sanskrit": "`विद्याविदो लोकविदस्तपोदमसमन्विताः।\nनित्यपूज्याश्च वन्द्याश्च द्विजा लोकद्वयेच्छुभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2091348, "chapter_id": 2941, "verse_number": "१३-७१-१९", "content_sanskrit": "इत्येतन्मे पिता श्रुत्वा सोमादद्भुतदर्शनात्।\nब्राह्मणान्पूजयामास तथैवाहं महाव्रतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2091349, "chapter_id": 2941, "verse_number": "१३-७१-२०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2091350, "chapter_id": 2941, "verse_number": "१३-७१-२०", "content_sanskrit": "श्रुत्वैतद्वचनं शक्रो दानवेन्द्रमुखाच्च्युतम्।\nद्विजान्संम्पूजयामास महेन्द्रत्वमवाप च॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2091351, "chapter_id": 2941, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि एकसप्ततितमोऽध्यायः॥१३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]