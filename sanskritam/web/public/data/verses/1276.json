[{"id": 2013420, "chapter_id": 1276, "verse_number": "२-१७-१", "content_sanskrit": "वासुदेव उवाच॥\nजातस्य भारते वंशे तथा कुन्त्याः सुतस्य च।\nया वै युक्ता मतिः सेयमर्जुनेन प्रदर्शिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2013421, "chapter_id": 1276, "verse_number": "२-१७-२", "content_sanskrit": "न स्म मृत्युं वयं विद्म रात्रौ वा यदि वा दिवा।\nन चापि कञ्चिदमरमयुद्धेनानुशुश्रुम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2013422, "chapter_id": 1276, "verse_number": "२-१७-३", "content_sanskrit": "एतावदेव पुरुषैः कार्यं हृदयतोषणम्।\nनयेन विधिदृष्टेन यदुपक्रमते परान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2013423, "chapter_id": 1276, "verse_number": "२-१७-४", "content_sanskrit": "सुनयस्यानपायस्य संयोगे परमः क्रमः।\nसङ्गत्या जायतेऽसाम्यं साम्यं च न भवेद्द्वयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2013424, "chapter_id": 1276, "verse_number": "२-१७-५", "content_sanskrit": "अनयस्यानुपायस्य संयुगे परमः क्षयटः।\nसंशयो जायते साम्याज्जयश्च न भवेद्द्वयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2013425, "chapter_id": 1276, "verse_number": "२-१७-६", "content_sanskrit": "ते वयं नयमास्थाय शत्रुदेशसमीपगाः।\nकथमन्तं न गच्छेम वृक्षस्येव नदीरयाः॥\nपररन्ध्रे पराक्रान्ताः स्वरन्ध्रावरणे स्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2013426, "chapter_id": 1276, "verse_number": "२-१७-७", "content_sanskrit": "व्यूढानीकैरतिबलैर्न युद्व्येदरिभिः सह।\nइति बुद्धिमतां नीतिस्तन्ममापीह रोचते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2013427, "chapter_id": 1276, "verse_number": "२-१७-८", "content_sanskrit": "अनवद्या ह्यसम्बुद्धाः प्रविष्टाः शत्रुसद्म तत्।\nशत्रुदेशमुपाक्रम्य तं कामं प्राप्नुयामहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2013428, "chapter_id": 1276, "verse_number": "२-१७-९", "content_sanskrit": "एको ह्येव श्रियं नित्यं बिभर्ति पुरुषर्षभः।\nअन्तरात्मेव भूतानां तत्क्षयं नैव लक्षये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2013429, "chapter_id": 1276, "verse_number": "२-१७-१०", "content_sanskrit": "अथवैनं निहत्याजौ शेषेणापि समाहताः।\nप्राप्नुयाम ततः स्वर्गं ज्ञातित्राणपरायणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2013430, "chapter_id": 1276, "verse_number": "२-१७-११x", "content_sanskrit": "युधिष्ठिर उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2013431, "chapter_id": 1276, "verse_number": "२-१७-११", "content_sanskrit": "कृष्ण कोऽयं जरासन्धः किंवीर्यः किम्पराक्रमः।\nयस्त्वां स्पृष्ट्वाऽग्निसदृशं न दग्धः शलभो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2013432, "chapter_id": 1276, "verse_number": "२-१७-१२x", "content_sanskrit": "कृष्ण उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2013433, "chapter_id": 1276, "verse_number": "२-१७-१२", "content_sanskrit": "शृणु राजञ्जरासन्धो यद्वीर्यो यत्पराक्रमः।\nयथा चोपेक्षितोऽस्माभिर्बहुशः कृतविप्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2013434, "chapter_id": 1276, "verse_number": "२-१७-१३", "content_sanskrit": "अक्षौहिणीनां तिसृणां पतिः समरदर्पितः।\nराजा बृहद्रथो नाम मगधाधिपतिर्बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2013435, "chapter_id": 1276, "verse_number": "२-१७-१४", "content_sanskrit": "रूपवान्वीर्यसम्पन्नः श्रीमानतुलविक्रमः।\nनित्यं दीक्षाङ्किततनुः शतक्रतुरिवापरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2013436, "chapter_id": 1276, "verse_number": "२-१७-१५", "content_sanskrit": "तेजसा सूर्यसङ्काशः क्षमया पृथिवीसमः।\nयश्चान्तकसमः क्रोधे श्रिया वैश्रवणोपमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2013437, "chapter_id": 1276, "verse_number": "२-१७-१६", "content_sanskrit": "स्वराज्यं कारयामास मगधेषु गिरिव्रजे।\nतस्याभिजनसंयुक्तैर्गणैर्भरतसत्तम।\nव्याप्तेयं पृथिवी सर्वा सूर्यस्येव गभस्तिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2013438, "chapter_id": 1276, "verse_number": "२-१७-१७", "content_sanskrit": "स काशिराजस्य सुते यमजे भरतर्षभः।\nउपयेमे महावीर्यो रूपद्रविणसंयुते। २-१७-१७cतयोश्चकार समयं मिथः स पुरुषर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2013439, "chapter_id": 1276, "verse_number": "२-१७-१८", "content_sanskrit": "नातिवर्तिष्य इत्येवं पत्नीभ्यां सन्निधौ तदा।\nस ताभ्यां शुशुभे राजा पत्नीभ्यां वसुधाधिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2013440, "chapter_id": 1276, "verse_number": "२-१७-१९", "content_sanskrit": "प्रियाम्भामनुरूपाभ्यां करेणुभ्यामिव द्विपः।\nतयोर्मध्यगतश्चापि रराज वसुधाधिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2013441, "chapter_id": 1276, "verse_number": "२-१७-२०", "content_sanskrit": "गङ्गायमुनयोर्मध्ये मूर्तिमानिव सागरः।\nविषयेषु निमग्रस्य तस्य यौवनमत्यगात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2013442, "chapter_id": 1276, "verse_number": "२-१७-२१", "content_sanskrit": "न च वंशकरः पुत्रस्तस्याजायत कश्चन।\nमङ्गलैर्बभिर्होमैः पुत्रकामाभिरिष्टिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2013443, "chapter_id": 1276, "verse_number": "२-१७-२२", "content_sanskrit": "नाससाद नृपश्रेष्ठः पुत्रं कुलविवर्धनम्।\nस भार्याभ्यां च सहितो निर्वेदमगमद्धृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2013444, "chapter_id": 1276, "verse_number": "२-१७-२३", "content_sanskrit": "राज्यं चापि परित्यज्य तपोवनमथाश्रयत्।\nवार्यमाणः प्रकृतिभिर्नृपभक्त्या विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2013445, "chapter_id": 1276, "verse_number": "२-१७-२४", "content_sanskrit": "अथ काक्षीवतः पुत्रं गौतमस्य महात्मनः॥\nशुश्राव तपसि श्रेष्ठमुदारं चण्डकौशिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2013446, "chapter_id": 1276, "verse_number": "२-१७-२५", "content_sanskrit": "यदृच्छयाऽऽगतं तं तु वृक्षमूलमुपाश्रितम्।\nपत्नीभ्यां सहितो राजा सर्वयत्नैरतोषयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2013447, "chapter_id": 1276, "verse_number": "२-१७-२६", "content_sanskrit": "बृहद्रथं च स ऋषिर्यथावच्चाभ्यनन्दत।\nउपविष्टः स तेनाथ अनुज्ञातो महात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2013448, "chapter_id": 1276, "verse_number": "२-१७-२७", "content_sanskrit": "तमपृच्छत्तदा विप्रः किमागमनमित्यथ।\nविप्रैरनुगतस्यैव पत्नीभ्यां सहितस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2013449, "chapter_id": 1276, "verse_number": "२-१७-२८", "content_sanskrit": "स उवाच मुनिं राजा भगवन्नास्ति मे सुतः।\nअपुत्रस्य तु राज्येन वृद्धत्वे किं प्रयोजनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2013450, "chapter_id": 1276, "verse_number": "२-१७-२९", "content_sanskrit": "सोऽहं तपश्चरिष्यामि पत्नीभ्यां सहितो वने।\nनाप्रजस्य मुने किर्तिः स्वधा चैवाक्षया भवेत्।\nएवमुक्तः स राज्ञा तु मुनिः कारुण्यमागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2013451, "chapter_id": 1276, "verse_number": "२-१७-३०", "content_sanskrit": "तमब्रवीत्सत्यधृतिः सत्यवागृषिसत्तमः।\nपरितुष्टोऽस्मि राजेन्द्र वरं वरय सुव्रत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2013452, "chapter_id": 1276, "verse_number": "२-१७-३१", "content_sanskrit": "ततः सभार्यः प्रणतस्तमुवाच बृहद्रथः।\nपुत्रदर्शननैराश्याद्बाष्पसन्दिग्धया गिरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2013453, "chapter_id": 1276, "verse_number": "२-१७-३२x", "content_sanskrit": "राजोवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2013454, "chapter_id": 1276, "verse_number": "२-१७-३२", "content_sanskrit": "भगवन् राज्यमुत्सृज्य प्रस्थितस्य तपोवनम्।\nकिं वरेणाल्पभाग्यस्य किं राज्येनाप्रजस्य मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2013455, "chapter_id": 1276, "verse_number": "२-१७-३३x", "content_sanskrit": "कृष्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2013456, "chapter_id": 1276, "verse_number": "२-१७-३३", "content_sanskrit": "एतच्छ्रुत्वा मुनिर्ध्यानमगमन्क्षुभितेन्द्रियः।\nतस्यैव चाम्रवृक्षस्य छायायां समुपाविशत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2013457, "chapter_id": 1276, "verse_number": "२-१७-३४", "content_sanskrit": "तस्योपविष्टस्य मुनेरुत्सङ्गे निपपात ह।\nअवानमशुकादष्टमेकमाम्रफलं किल॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2013458, "chapter_id": 1276, "verse_number": "२-१७-३५", "content_sanskrit": "तत्प्रगृह्य मुनिश्रेष्ठो हृदयेनाभिमन्त्र्य च।\nराज्ञे ददावप्रतिमं पुत्रसम्प्राप्तिकारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2013459, "chapter_id": 1276, "verse_number": "२-१७-३६", "content_sanskrit": "उवाच च महाप्राज्ञस्तं राजानं महामुनिः।\nगच्छ राजन्कृतार्थोऽसि निवर्तस्व नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2013460, "chapter_id": 1276, "verse_number": "२-१७-३७", "content_sanskrit": "एष ते तनयो राजन्मा तपेह तपोवने।\nप्रजाः पालय धर्मेण एव धर्मो महीक्षिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2013461, "chapter_id": 1276, "verse_number": "२-१७-३८", "content_sanskrit": "यजस्व विविधैर्यज्ञैरिन्द्रं तर्पय चेन्दुना।\nपुत्रं राज्ये प्रतिष्ठाप्य तत आश्रममाव्रज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2013462, "chapter_id": 1276, "verse_number": "२-१७-३९", "content_sanskrit": "अष्टौ वरान्प्रयच्छामि तव पुत्रस्य पार्थिव।\nब्रह्मण्यत्वमजेयत्वं युद्धेषु च तथा मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2013463, "chapter_id": 1276, "verse_number": "२-१७-४०", "content_sanskrit": "प्रियातिथेयतां चैव दीनानामन्ववेक्षणम्।\nतथा बलं च सुभहल्लोके कीर्ति च शाश्वतीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2013464, "chapter_id": 1276, "verse_number": "२-१७-४१", "content_sanskrit": "अनुरागं प्रजानां चेत्येवमष्टौ वरान्नृप।\nगच्छ त्वं कृतकृत्योऽसि निवर्तस्व जनाधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2013465, "chapter_id": 1276, "verse_number": "२-१७-४२", "content_sanskrit": "अनुज्ञातः स ऋषिणा पत्नीभ्यां सहितो नृपः।\nपौरैरनुगतश्चापि विवेश स्वपुरं ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2013466, "chapter_id": 1276, "verse_number": "२-१७-४३", "content_sanskrit": "यथासमयमाज्ञाय तदा स नृपसत्तमः।\nद्वाभ्यामेकं फलं प्रादात्पत्नीभ्यां भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2013467, "chapter_id": 1276, "verse_number": "२-१७-४४", "content_sanskrit": "मुनेश्च बहुमानेन कालस्य च विपर्ययात्।\nते तदाम्रं द्विधा कृत्वा भक्षयामासतुः शुभे।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2013468, "chapter_id": 1276, "verse_number": "२-१७-४५", "content_sanskrit": "तयोः समभवद्गर्भः फलप्राशनसम्भवः।\nते च दृष्ट्वा स नृपतिः परां मुदमवाप ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2013469, "chapter_id": 1276, "verse_number": "२-१७-४६", "content_sanskrit": "अथ काले महाप्राज्ञ यथासमयमागते।\nप्रजायेतामुभे राजञ्शरीरशकले तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2013470, "chapter_id": 1276, "verse_number": "२-१७-४७", "content_sanskrit": "एकाक्षिबाहुचरणे अर्धोदरमुखस्फिचे।\nदृष्ट्वा शरीरशकले प्रवेपतुरुभे भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2013471, "chapter_id": 1276, "verse_number": "२-१७-४८", "content_sanskrit": "उद्विग्रे सह संमन्त्र्य ते भगित्यौ तदाऽबले।\nसजीवे प्राणिशकले तत्यजाते सुदुःखिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2013472, "chapter_id": 1276, "verse_number": "२-१७-४९", "content_sanskrit": "तयोर्धात्र्यौ सुसंवीते कृत्वा ते गर्भसम्प्लवे।\nनिर्गम्यान्तः पुरद्वारात्समुत्सृज्याभिजग्मतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2013473, "chapter_id": 1276, "verse_number": "२-१७-५०", "content_sanskrit": "दुकूलाभ्यां सुसञ्छन्ने पाण्डराभ्यामुभे तदा।\nअज्ञाते कस्यचित्ते तु जहतुस्ते चतुष्पथे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2013474, "chapter_id": 1276, "verse_number": "२-१७-५१", "content_sanskrit": "ततो विविशतुर्धात्र्यौ पुनरन्तः पुरं तदा।\nकथयामासतुरुभे देवीभ्यां तु पृथक्पृथक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2013475, "chapter_id": 1276, "verse_number": "२-१७-५२", "content_sanskrit": "ते चतुष्पथनिक्षिप्ते जरा नामाथ राक्षसी।\nजग्राह मनुजव्याघ्र मांसशोणितभोजना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2013476, "chapter_id": 1276, "verse_number": "२-१७-५३", "content_sanskrit": "कर्तुकामा सुखवहे शकले सा तु राक्षसी।\nसंयोजयामास तदा विधानबलचोदिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2013477, "chapter_id": 1276, "verse_number": "२-१७-५४", "content_sanskrit": "ते समानीतमात्रे तु शकले पुरुषर्षभ।\nएकमूर्तिधरो वीरः कुमारः समपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2013478, "chapter_id": 1276, "verse_number": "२-१७-५५", "content_sanskrit": "ततः सा राक्षसी राजन्विस्मयोत्फुल्ललोचना।\nन शशाक समुद्वोदुं वज्रसारमयं शिशुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2013479, "chapter_id": 1276, "verse_number": "२-१७-५६", "content_sanskrit": "बालस्ताम्रतलं मुष्टिं कृत्वा चास्ये निधाय सः।\nप्राक्रोशदतिसंरब्धः सतोय इव तोयदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2013480, "chapter_id": 1276, "verse_number": "२-१७-५७", "content_sanskrit": "तेन शब्देन सम्भ्रान्तः सहसाऽन्तः पुरे जनः।\nनिर्जगाम नरव्याघ्र राज्ञा सह परन्तप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2013481, "chapter_id": 1276, "verse_number": "२-१७-५८", "content_sanskrit": "ते चाबले परिम्लाने पयः पूर्णपयोधरे।\nनिराशे पुत्रलाभाय सहसैवाब्यगच्छताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2013482, "chapter_id": 1276, "verse_number": "२-१७-५९", "content_sanskrit": "ते च दृष्ट्वा तथाभूते राजानं चेष्टसंततिम्।\nतं च बालं सुबलिनं चिन्तयामास राक्षसी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2013483, "chapter_id": 1276, "verse_number": "२-१७-६०", "content_sanskrit": "नार्हामि विषये राज्ञो वसन्ती पुत्रगृद्धिनः।\nबालं पुत्रमिमं हन्तुं धार्मिकस्य महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2013484, "chapter_id": 1276, "verse_number": "२-१७-६१", "content_sanskrit": "सा तं बालमुपादाय मेघलेखेन भास्करम्।\nकृत्वा च मानुषं रूपमुवाच वसुधाधिपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2013485, "chapter_id": 1276, "verse_number": "२-१७-६२", "content_sanskrit": "बृहद्रथ सुतस्तेऽयं मया दत्तः प्रगृह्यताम्।\nतव पत्नीद्वये जातो द्विजातिवरशासनात्।\nधात्रीजनपरित्यक्तो मयाऽयं परिरक्षितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2013486, "chapter_id": 1276, "verse_number": "२-१७-६३x", "content_sanskrit": "कृष्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2013487, "chapter_id": 1276, "verse_number": "२-१७-६३", "content_sanskrit": "ततस्ते भरतश्रेष्ठ काशिराजसुते शुभे।\nतं बालमभिपद्याशु प्रस्रवैरभ्यषिञ्जताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2013488, "chapter_id": 1276, "verse_number": "२-१७-६४", "content_sanskrit": "ततः स राजा संहृष्टः सर्वं तदुपलभ्य च।\nअपृच्छद्धेमगर्भाभां राक्षसीं तामराक्षसीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2013489, "chapter_id": 1276, "verse_number": "२-१७-६५", "content_sanskrit": "कात्वं कमलगर्भाभे मम पुत्रप्रदायिनी।\nकामं मा ब्रूहि कल्याणि देवता प्रतिभासि मे॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2013490, "chapter_id": 1276, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि मन्त्रपर्वणि सप्तदशोऽध्यायः॥ १७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}]