[{"id": 5000478000, "chapter_id": 9478, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे एकसप्ततितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000478001, "chapter_id": 9478, "verse_number": "६-७१-१", "content_sanskrit": "स्वबलं व्यथितं दृष्ट्वा तुमुलं लोमहर्षणम्।\nभ्रातॄंश्च निहतान् दृष्ट्वा शक्रतुल्यपराक्रमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000478002, "chapter_id": 9478, "verse_number": "६-७१-२", "content_sanskrit": "पितृव्यौ चापि संदृश्य समरे संनिपातितौ।\nयुद्धोन्मत्तं च मत्तं च भ्रातरौ राक्षसोत्तमौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000478003, "chapter_id": 9478, "verse_number": "६-७१-३", "content_sanskrit": "चुकोप च महातेजा ब्रह्मदत्तवरो युधि।\nअतिकायोऽद्रिसंकाशो देवदानवदर्पहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000478004, "chapter_id": 9478, "verse_number": "६-७१-४", "content_sanskrit": "स भास्करसहस्रस्य संघातमिव भास्वरम्।\nरथमारुह्य शक्रारिरभिदुद्राव वानरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000478005, "chapter_id": 9478, "verse_number": "६-७१-५", "content_sanskrit": "स विस्फार्य तदा चापं किरीटी मृष्टकुण्डलः।\nनाम संश्रावयामास ननाद च महास्वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000478006, "chapter_id": 9478, "verse_number": "६-७१-६", "content_sanskrit": "तेन सिंहप्रणादेन नामविश्रावणेन च।\nज्याशब्देन च भीमेन त्रासयामास वानरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000478007, "chapter_id": 9478, "verse_number": "६-७१-७", "content_sanskrit": "ते दृष्ट्वा देहमाहात्म्यं कुम्भकर्णोऽयमुत्थितः।\nभयार्ता वानराः सर्वे संश्रयन्ते परस्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000478008, "chapter_id": 9478, "verse_number": "६-७१-८", "content_sanskrit": "ते तस्य रूपमालोक्य यथा विष्णोस्त्रिविक्रमे।\nभयाद् वानरयोधास्ते विद्रवन्ति ततस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000478009, "chapter_id": 9478, "verse_number": "६-७१-९", "content_sanskrit": "तेऽतिकायं समासाद्य वानरा मूढचेतसः।\nशरण्यं शरणं जग्मुर्लक्ष्मणाग्रजमाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000478010, "chapter_id": 9478, "verse_number": "६-७१-१०", "content_sanskrit": "ततोऽतिकायं काकुत्स्थो रथस्थं पर्वतोपमम्।\nददर्श धन्विनं दूराद् गर्जन्तं कालमेघवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000478011, "chapter_id": 9478, "verse_number": "६-७१-११", "content_sanskrit": "स तं दृष्ट्वा महाकायं राघवस्तु सुविस्मितः।\nवानरान् सान्त्वयित्वा च विभीषणमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000478012, "chapter_id": 9478, "verse_number": "६-७१-१२", "content_sanskrit": "कोऽसौ पर्वतसंकाशो धनुष्मान् हरिलोचनः।\nयुक्ते हयसहस्रेण विशाले स्यन्दने स्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000478013, "chapter_id": 9478, "verse_number": "६-७१-१३", "content_sanskrit": "य एष निशितैः शूलैः सुतीक्ष्णैः प्रासतोमरैः।\nअर्चिष्मद्भिर्वृतो भाति भूतैरिव महेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000478014, "chapter_id": 9478, "verse_number": "६-७१-१४", "content_sanskrit": "कालजिह्वाप्रकाशाभिर्य एषोऽभिविराजते।\nआवृतो रथशक्तीभिर्विद्युद्भिरिव तोयदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000478015, "chapter_id": 9478, "verse_number": "६-७१-१५", "content_sanskrit": "धनूंषि चास्य सज्जानि हेमपृष्ठानि सर्वशः।\nशोभयन्ति रथश्रेष्ठं शक्रचापमिवाम्बरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000478016, "chapter_id": 9478, "verse_number": "६-७१-१६", "content_sanskrit": "य एष रक्षःशार्दूलो रणभूमिं विराजयन्।\nअभ्येति रथिनां श्रेष्ठो रथेनादित्यवर्चसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000478017, "chapter_id": 9478, "verse_number": "६-७१-१७", "content_sanskrit": "ध्वजशृङ्गप्रतिष्ठेन राहुणाभिविराजते।\nसूर्यरश्मिप्रभैर्बाणैर्दिशो दश विराजयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000478018, "chapter_id": 9478, "verse_number": "६-७१-१८", "content_sanskrit": "त्रिनतं मेघनिर्ह्रादं हेमपृष्ठमलंकृतम्।\nशतक्रतुधनुःप्रख्यं धनुश्चास्य विराजते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000478019, "chapter_id": 9478, "verse_number": "६-७१-१९", "content_sanskrit": "सध्वजः सपताकश्च सानुकर्षो महारथः।\nचतुःसादिसमायुक्तो मेघस्तनितनिःस्वनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000478020, "chapter_id": 9478, "verse_number": "६-७१-२०", "content_sanskrit": "विंशतिर्दश चाष्टौ च तूणास्य रथमास्थिताः।\nकार्मुकाणि च भीमानि ज्याश्च काञ्चनपिङ्गलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000478021, "chapter_id": 9478, "verse_number": "६-७१-२१", "content_sanskrit": "द्वौ च खड्गौ च पार्श्वस्थौ प्रदीप्तौ पार्श्वशोभितौ।\nचतुर्हस्तत्सरुयुतौ व्यक्तहस्तदशायतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000478022, "chapter_id": 9478, "verse_number": "६-७१-२२", "content_sanskrit": "रक्तकण्ठगुणो धीरो महापर्वतसंनिभः।\nकालः कालमहावक्त्रो मेघस्थ इव भास्करः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000478023, "chapter_id": 9478, "verse_number": "६-७१-२३", "content_sanskrit": "काञ्चनाङ्गदनद्धाभ्यां भुजाभ्यामेष शोभते।\nशृङ्गाभ्यामिव तुङ्गाभ्यां हिमवान् पर्वतोत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000478024, "chapter_id": 9478, "verse_number": "६-७१-२४", "content_sanskrit": "कुण्डलाभ्यामुभाभ्यां च भाति वक्त्रं सुभीषणम्।\nपुनर्वस्वन्तरगतं परिपूर्णो निशाकरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000478025, "chapter_id": 9478, "verse_number": "६-७१-२५", "content_sanskrit": "आचक्ष्व मे महाबाहो त्वमेनं राक्षसोत्तमम्।\nयं दृष्ट्वा वानराः सर्वे भयार्ता विद्रुता दिशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000478026, "chapter_id": 9478, "verse_number": "६-७१-२६", "content_sanskrit": "स पृष्टो राजपुत्रेण रामेणामिततेजसा।\nआचचक्षे महातेजा राघवाय विभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000478027, "chapter_id": 9478, "verse_number": "६-७१-२७", "content_sanskrit": "दशग्रीवो महातेजा राजा वैश्रवणानुजः।\nभीमकर्मा महात्मा हि रावणो राक्षसेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000478028, "chapter_id": 9478, "verse_number": "६-७१-२८", "content_sanskrit": "तस्यासीद् वीर्यवान् पुत्रो रावणप्रतिमो बले।\nवृद्धसेवी श्रुतिधरः सर्वास्त्रविदुषां वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000478029, "chapter_id": 9478, "verse_number": "६-७१-२९", "content_sanskrit": "अश्वपृष्ठे नागपृष्ठे खड्गे धनुषि कर्षणे।\nभेदे सान्त्वे च दाने च नये मन्त्रे च सम्मतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000478030, "chapter_id": 9478, "verse_number": "६-७१-३०", "content_sanskrit": "यस्य बाहुं समाश्रित्य लङ्का भवति निर्भया।\nतनयं धान्यमालिन्या अतिकायमिमं विदुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000478031, "chapter_id": 9478, "verse_number": "६-७१-३१", "content_sanskrit": "एतेनाराधितो ब्रह्मा तपसा भावितात्मना।\nअस्त्राणि चाप्यवाप्तानि रिपवश्च पराजिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000478032, "chapter_id": 9478, "verse_number": "६-७१-३२", "content_sanskrit": "सुरासुरैरवध्यत्वं दत्तमस्मै स्वयंभुवा।\nएतच्च कवचं दिव्यं रथश्च रविभास्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000478033, "chapter_id": 9478, "verse_number": "६-७१-३३", "content_sanskrit": "एतेन शतशो देवा दानवाश्च पराजिताः।\nरक्षितानि च रक्षांसि यक्षाश्चापि निषूदिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000478034, "chapter_id": 9478, "verse_number": "६-७१-३४", "content_sanskrit": "वज्रं विष्टम्भितं येन बाणैरिन्द्रस्य धीमता।\nपाशः सलिलराजस्य युद्धे प्रतिहतस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000478035, "chapter_id": 9478, "verse_number": "६-७१-३५", "content_sanskrit": "एषोऽतिकायो बलवान् राक्षसानामथर्षभः।\nस रावणसुतो धीमान् देवदानवदर्पहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000478036, "chapter_id": 9478, "verse_number": "६-७१-३६", "content_sanskrit": "तदस्मिन् क्रियतां यत्नः क्षिप्रं पुरुषपुङ्गव।\nपुरा वानरसैन्यानि क्षयं नयति सायकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000478037, "chapter_id": 9478, "verse_number": "६-७१-३७", "content_sanskrit": "ततोऽतिकायो बलवान् प्रविश्य हरिवाहिनीम्।\nविस्फारयामास धनुर्ननाद च पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000478038, "chapter_id": 9478, "verse_number": "६-७१-३८", "content_sanskrit": "तं भीमवपुषं दृष्ट्वा रथस्थं रथिनां वरम्।\nअभिपेतुर्महात्मानः प्रधाना ये वनौकसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000478039, "chapter_id": 9478, "verse_number": "६-७१-३९", "content_sanskrit": "कुमुदो द्विविदो मैन्दो नीलः शरभ एव च।\nपादपैर्गिरिशृङ्गैश्च युगपत् समभिद्रवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000478040, "chapter_id": 9478, "verse_number": "६-७१-४०", "content_sanskrit": "तेषां वृक्षांश्च शैलांश्च शरैः कनकभूषणैः।\nअतिकायो महातेजाश्चिच्छेदास्त्रविदां वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000478041, "chapter_id": 9478, "verse_number": "६-७१-४१", "content_sanskrit": "तांश्चैव सर्वान् स हरीन् शरैः सर्वायसैर्बली।\nविव्याधाभिमुखान् संख्ये भीमकायो निशाचरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000478042, "chapter_id": 9478, "verse_number": "६-७१-४२", "content_sanskrit": "तेऽर्दिता बाणवर्षेण भिन्नगात्राः पराजिताः।\nन शेकुरतिकायस्य प्रतिकर्तुं महाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000478043, "chapter_id": 9478, "verse_number": "६-७१-४३", "content_sanskrit": "तत् सैन्यं हरिवीराणां त्रासयामास राक्षसः।\nमृगयूथमिव क्रुद्धो हरिर्यौवनदर्पितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000478044, "chapter_id": 9478, "verse_number": "६-७१-४४", "content_sanskrit": "स राक्षसेन्द्रो हरियूथमध्ये\nनायुध्यमानं निजघान कंचित्।\nउत्पत्य रामं स धनुःकलापी\nसगर्वितं वाक्यमिदं बभाषे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000478045, "chapter_id": 9478, "verse_number": "६-७१-४५", "content_sanskrit": "रथे स्थितोऽहं शरचापपाणि-\nर्न प्राकृतं कंचन योधयामि।\nयस्यास्ति शक्तिर्व्यवसाययुक्तो\nददातु मे शीघ्रमिहाद्य युद्धम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000478046, "chapter_id": 9478, "verse_number": "६-७१-४६", "content_sanskrit": "तत् तस्य वाक्यं ब्रुवतो निशम्य\nचुकोप सौमित्रिरमित्रहन्ता।\nअमृष्यमाणश्च समुत्पपात\nजग्राह चापं च ततः स्मयित्वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000478047, "chapter_id": 9478, "verse_number": "६-७१-४७", "content_sanskrit": "क्रुद्धः सौमित्रिरुत्पत्य तूणादाक्षिप्य सायकम्।\nपुरस्तादतिकायस्य विचकर्ष महद्धनुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000478048, "chapter_id": 9478, "verse_number": "६-७१-४८", "content_sanskrit": "पूरयन् स महीं सर्वामाकाशं सागरं दिशः।\nज्याशब्दो लक्ष्मणस्योग्रस्त्रासयन् रजनीचरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000478049, "chapter_id": 9478, "verse_number": "६-७१-४९", "content_sanskrit": "सौमित्रेश्चापनिर्घोषं श्रुत्वा प्रतिभयं तदा।\nविसिस्मिये महातेजा राक्षसेन्द्रात्मजो बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000478050, "chapter_id": 9478, "verse_number": "६-७१-५०", "content_sanskrit": "तदातिकायः कुपितो दृष्ट्वा लक्ष्मणमुत्थितम्।\nआदाय निशितं बाणमिदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000478051, "chapter_id": 9478, "verse_number": "६-७१-५१", "content_sanskrit": "बालस्त्वमसि सौमित्रे विक्रमेष्वविचक्षणः।\nगच्छ किं कालसंकाशं मां योधयितुमिच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000478052, "chapter_id": 9478, "verse_number": "६-७१-५२", "content_sanskrit": "नहि मद‍्बाहुसृष्टानां बाणानां हिमवानपि।\nसोढुमुत्सहते वेगमन्तरिक्षमथो मही ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000478053, "chapter_id": 9478, "verse_number": "६-७१-५३", "content_sanskrit": "सुखप्रसुप्तं कालाग्निं विबोधयितुमिच्छसि।\nन्यस्य चापं निवर्तस्व प्राणान्न जहि मद‍्गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000478054, "chapter_id": 9478, "verse_number": "६-७१-५४", "content_sanskrit": "अथवा त्वं प्रतिस्तब्धो न निवर्तितुमिच्छसि।\nतिष्ठ प्राणान् परित्यज्य गमिष्यसि यमक्षयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000478055, "chapter_id": 9478, "verse_number": "६-७१-५५", "content_sanskrit": "पश्य मे निशितान् बाणान् रिपुदर्पनिषूदनान्।\nईश्वरायुधसंकाशांस्तप्तकाञ्चनभूषणान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 5000478056, "chapter_id": 9478, "verse_number": "६-७१-५६", "content_sanskrit": "एष ते सर्पसंकाशो बाणः पास्यति शोणितम्।\nमृगराज इव क्रुद्धो नागराजस्य शोणितम्।\nइत्येवमुक्त्वा संक्रुद्धः शरं धनुषि संदधे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 5000478057, "chapter_id": 9478, "verse_number": "६-७१-५७", "content_sanskrit": "श्रुत्वातिकायस्य वचः सरोषं\nसगर्वितं संयति राजपुत्रः।\nस संचुकोपातिबलो मनस्वी\nउवाच वाक्यं च ततो महार्थम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 5000478058, "chapter_id": 9478, "verse_number": "६-७१-५८", "content_sanskrit": "न वाक्यमात्रेण भवान् प्रधानो\nन कत्थनात् सत्पुरुषा भवन्ति।\nमयि स्थिते धन्विनि बाणपाणौ\nनिदर्शयस्वात्मबलं दुरात्मन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 5000478059, "chapter_id": 9478, "verse_number": "६-७१-५९", "content_sanskrit": "कर्मणा सूचयात्मानं न विकत्थितुमर्हसि।\nपौरुषेण तु यो युक्तः स तु शूर इति स्मृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 5000478060, "chapter_id": 9478, "verse_number": "६-७१-६०", "content_sanskrit": "सर्वायुधसमायुक्तो धन्वी त्वं रथमास्थितः।\nशरैर्वा यदि वाप्यस्त्रैर्दर्शयस्व पराक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 5000478061, "chapter_id": 9478, "verse_number": "६-७१-६१", "content_sanskrit": "ततः शिरस्ते निशितैः पातयिष्याम्यहं शरैः।\nमारुतः कालसम्पक्वं वृन्तात् तालफलं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 5000478062, "chapter_id": 9478, "verse_number": "६-७१-६२", "content_sanskrit": "अद्य ते मामका बाणास्तप्तकाञ्चनभूषणाः।\nपास्यन्ति रुधिरं गात्राद् बाणशल्यान्तरोत्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 5000478063, "chapter_id": 9478, "verse_number": "६-७१-६३", "content_sanskrit": "बालोऽयमिति विज्ञाय न चावज्ञातुमर्हसि।\nबालो वा यदि वा वृद्धो मृत्युं जानीहि संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 5000478064, "chapter_id": 9478, "verse_number": "६-७१-६४", "content_sanskrit": "बालेन विष्णुना लोकास्त्रयः क्रान्तास्त्रिविक्रमैः।\nलक्ष्मणस्य वचः श्रुत्वा हेतुमत् परमार्थवत्।\nअतिकायः प्रचुक्रोध बाणं चोत्तममाददे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 5000478065, "chapter_id": 9478, "verse_number": "६-७१-६५", "content_sanskrit": "ततो विद्याधरा भूता देवा दैत्या महर्षयः।\nगुह्यकाश्च महात्मानस्तद् युद्धं द्रष्टुमागमन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 5000478066, "chapter_id": 9478, "verse_number": "६-७१-६६", "content_sanskrit": "ततोऽतिकायः कुपितश्चापमारोप्य सायकम्।\nलक्ष्मणाय प्रचिक्षेप संक्षिपन्निव चाम्बरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 5000478067, "chapter_id": 9478, "verse_number": "६-७१-६७", "content_sanskrit": "तमापतन्तं निशितं शरमाशीविषोपमम्।\nअर्धचन्द्रेण चिच्छेद लक्ष्मणः परवीरहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 5000478068, "chapter_id": 9478, "verse_number": "६-७१-६८", "content_sanskrit": "तं निकृत्तं शरं दृष्ट्वा कृत्तभोगमिवोरगम्।\nअतिकायो भृशं क्रुद्धः पञ्च बाणान् समादधे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 5000478069, "chapter_id": 9478, "verse_number": "६-७१-६९", "content_sanskrit": "तान् शरान् सम्प्रचिक्षेप लक्ष्मणाय निशाचरः।\nतानप्राप्तान् शितैर्बाणैश्चिच्छेद भरतानुजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 5000478070, "chapter_id": 9478, "verse_number": "६-७१-७०", "content_sanskrit": "स तान् छित्त्वा शितैर्बाणैर्लक्ष्मणः परवीरहा।\nआददे निशितं बाणं ज्वलन्तमिव तेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 5000478071, "chapter_id": 9478, "verse_number": "६-७१-७१", "content_sanskrit": "तमादाय धनुःश्रेष्ठे योजयामास लक्ष्मणः।\nविचकर्ष च वेगेन विससर्ज च सायकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 5000478072, "chapter_id": 9478, "verse_number": "६-७१-७२", "content_sanskrit": "पूर्णायतविसृष्टेन शरेण नतपर्वणा।\nललाटे राक्षसश्रेष्ठमाजघान स वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 5000478073, "chapter_id": 9478, "verse_number": "६-७१-७३", "content_sanskrit": "स ललाटे शरो मग्नस्तस्य भीमस्य रक्षसः।\nददृशे शोणितेनाक्तः पन्नगेन्द्र इवाचले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 5000478074, "chapter_id": 9478, "verse_number": "६-७१-७४", "content_sanskrit": "राक्षसः प्रचकम्पेऽथ लक्ष्मणेषु प्रपीडितः।\nरुद्रबाणहतं घोरं यथा त्रिपुरगोपुरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 5000478075, "chapter_id": 9478, "verse_number": "६-७१-७५", "content_sanskrit": "चिन्तयामास चाश्वास्य विमृश्य च महाबलः।\nसाधु बाणनिपातेन श्लाघनीयोऽसि मे रिपुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 5000478076, "chapter_id": 9478, "verse_number": "६-७१-७६", "content_sanskrit": "विधायैवं विदार्यास्यं नियम्य च महाभुजौ।\nस रथोपस्थमास्थाय रथेन प्रचचार ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 5000478077, "chapter_id": 9478, "verse_number": "६-७१-७७", "content_sanskrit": "एवं त्रीन् पञ्च सप्तेति सायकान् राक्षसर्षभः।\nआददे संदधे चापि विचकर्षोत्ससर्ज च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 5000478078, "chapter_id": 9478, "verse_number": "६-७१-७८", "content_sanskrit": "ते बाणाः कालसंकाशा राक्षसेन्द्रधनुश्च्युताः।\nहेमपुङ्खा रविप्रख्याश्चक्रुर्दीप्तमिवाम्बरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 5000478079, "chapter_id": 9478, "verse_number": "६-७१-७९", "content_sanskrit": "ततस्तान् राक्षसोत्सृष्टान् शरौघान् राघवानुजः।\nअसम्भ्रान्तः प्रचिच्छेद निशितैर्बहुभिः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 5000478080, "chapter_id": 9478, "verse_number": "६-७१-८०", "content_sanskrit": "तान् शरान् युधि सम्प्रेक्ष्य निकृत्तान् रावणात्मजः।\nचुकोप त्रिदशेन्द्रारिर्जग्राह निशितं शरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 5000478081, "chapter_id": 9478, "verse_number": "६-७१-८१", "content_sanskrit": "स संधाय महातेजास्तं बाणं सहसोत्सृजत्।\nतेन सौमित्रिमायान्तमाजघान स्तनान्तरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 5000478082, "chapter_id": 9478, "verse_number": "६-७१-८२", "content_sanskrit": "अतिकायेन सौमित्रिस्ताडितो युधि वक्षसि।\nसुस्राव रुधिरं तीव्रं मदं मत्त इव द्विपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 5000478083, "chapter_id": 9478, "verse_number": "६-७१-८३", "content_sanskrit": "स चकार तदात्मानं विशल्यं सहसा विभुः।\nजग्राह च शरं तीक्ष्णमस्त्रेणापि समाददे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 5000478084, "chapter_id": 9478, "verse_number": "६-७१-८४", "content_sanskrit": "आग्नेयेन तदास्त्रेण योजयामास सायकम्।\nस जज्वाल तदा बाणो धनुष्यस्य महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 5000478085, "chapter_id": 9478, "verse_number": "६-७१-८५", "content_sanskrit": "अतिकायोऽतितेजस्वी रौद्रमस्त्रं समाददे।\nतेन बाणं भुजङ्गाभं हेमपुङ्खमयोजयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 5000478086, "chapter_id": 9478, "verse_number": "६-७१-८६", "content_sanskrit": "तदस्त्रं ज्वलितं घोरं लक्ष्मणः शरमाहितम्।\nअतिकायाय चिक्षेप कालदण्डमिवान्तकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 5000478087, "chapter_id": 9478, "verse_number": "६-७१-८७", "content_sanskrit": "आग्नेयास्त्राभिसंयुक्तं दृष्ट्वा बाणं निशाचरः।\nउत्ससर्ज तदा बाणं रौद्रं सूर्यास्त्रयोजितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 5000478088, "chapter_id": 9478, "verse_number": "६-७१-८८", "content_sanskrit": "तावुभावम्बरे बाणावन्योन्यमभिजघ्नतुः।\nतेजसा सम्प्रदीप्ताग्रौ क्रुद्धाविव भुजङ्गमौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 5000478089, "chapter_id": 9478, "verse_number": "६-७१-८९", "content_sanskrit": "तावन्योन्यं विनिर्दह्य पेततुः पृथिवीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 5000478090, "chapter_id": 9478, "verse_number": "६-७१-९०", "content_sanskrit": "निरर्चिषौ भस्मकृतौ न भ्राजेते शरोत्तमौ।\nतावुभौ दीप्यमानौ स्म न भ्राजेते महीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 5000478091, "chapter_id": 9478, "verse_number": "६-७१-९१", "content_sanskrit": "ततोऽतिकायः संक्रुद्धस्त्वाष्ट्रमैषीकमुत्सृजत्।\nततश्चिच्छेद सौमित्रिरस्त्रमैन्द्रेण वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 5000478092, "chapter_id": 9478, "verse_number": "६-७१-९२", "content_sanskrit": "ऐषीकं निहतं दृष्ट्वा कुमारो रावणात्मजः।\nयाम्येनास्त्रेण संक्रुद्धो योजयामास सायकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 5000478093, "chapter_id": 9478, "verse_number": "६-७१-९३", "content_sanskrit": "ततस्तदस्त्रं चिक्षेप लक्ष्मणाय निशाचरः।\nवायव्येन तदस्त्रेण निजघान स लक्ष्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 5000478094, "chapter_id": 9478, "verse_number": "६-७१-९४", "content_sanskrit": "अथैनं शरधाराभिर्धाराभिरिव तोयदः।\nअभ्यवर्षत संक्रुद्धो लक्ष्मणो रावणात्मजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 5000478095, "chapter_id": 9478, "verse_number": "६-७१-९५", "content_sanskrit": "तेऽतिकायं समासाद्य कवचे वज्रभूषिते।\nभग्नाग्रशल्याः सहसा पेतुर्बाणा महीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 5000478096, "chapter_id": 9478, "verse_number": "६-७१-९६", "content_sanskrit": "तान्मोघानभिसम्प्रेक्ष्य लक्ष्मणः परवीरहा।\nअभ्यवर्षत बाणानां सहस्रेण महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 5000478097, "chapter_id": 9478, "verse_number": "६-७१-९७", "content_sanskrit": "स वृष्यमाणो बाणौघैरतिकायो महाबलः।\nअवध्यकवचः संख्ये राक्षसो नैव विव्यथे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 5000478098, "chapter_id": 9478, "verse_number": "६-७१-९८", "content_sanskrit": "शरं चाशीविषाकारं लक्ष्मणाय व्यपासृजत्।\nस तेन विद्धः सौमित्रिर्मर्मदेशे शरेण ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 5000478099, "chapter_id": 9478, "verse_number": "६-७१-९९", "content_sanskrit": "मुहूर्तमात्रं निःसंज्ञो ह्यभवच्छत्रुतापनः।\nततः संज्ञामुपालभ्य चतुर्भिः सायकोत्तमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 5000478100, "chapter_id": 9478, "verse_number": "६-७१-१००", "content_sanskrit": "निजघान हयान् संख्ये सारथिं च महाबलः।\nध्वजस्योन्मथनं कृत्वा शरवर्षैररिंदमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 5000478101, "chapter_id": 9478, "verse_number": "६-७१-१०१", "content_sanskrit": "असम्भ्रान्तः स सौमित्रिस्तान् शरानभिलक्षितान्।\nमुमोच लक्ष्मणो बाणान् वधार्थं तस्य रक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 5000478102, "chapter_id": 9478, "verse_number": "६-७१-१०२", "content_sanskrit": "न शशाक रुजं कर्तुं युधि तस्य नरोत्तमः।\nअथैनमभ्युपागम्य वायुर्वाक्यमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 5000478103, "chapter_id": 9478, "verse_number": "६-७१-१०३", "content_sanskrit": "ब्रह्मदत्तवरो ह्येष अवध्यकवचावृतः।\nब्राह्मेणास्त्रेण भिन्ध्येनमेष वध्यो हि नान्यथा।\nअवध्य एष ह्यन्येषामस्त्राणां कवची बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 5000478104, "chapter_id": 9478, "verse_number": "६-७१-१०४", "content_sanskrit": "ततस्तु वायोर्वचनं निशम्य\nसौमित्रिरिन्द्रप्रतिमानवीर्यः।\nसमादधे बाणमथोग्रवेगं\nतद‍्ब्राह्ममस्त्रं सहसा नियुज्य ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 5000478105, "chapter_id": 9478, "verse_number": "६-७१-१०५", "content_sanskrit": "तस्मिन् वरास्त्रे तु नियुज्यमाने\nसौमित्रिणा बाणवरे शिताग्रे।\nदिशश्च चन्द्रार्कमहाग्रहाश्च\nनभश्च तत्रास ररास चोर्वी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 5000478106, "chapter_id": 9478, "verse_number": "६-७१-१०६", "content_sanskrit": "तं ब्रह्मणोऽस्त्रेण नियुज्य चापे\nशरं सपुङ्खं यमदूतकल्पम्।\nसौमित्रिरिन्द्रारिसुतस्य तस्य\nससर्ज बाणं युधि वज्रकल्पम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 5000478107, "chapter_id": 9478, "verse_number": "६-७१-१०७", "content_sanskrit": "तं लक्ष्मणोत्सृष्टविवृद्धवेगं\nसमापतन्तं श्वसनोग्रवेगम्।\nसुपर्णवज्रोत्तमचित्रपुङ्खं\nतदातिकायः समरे ददर्श ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 5000478108, "chapter_id": 9478, "verse_number": "६-७१-१०८", "content_sanskrit": "तं प्रेक्षमाणः सहसातिकायो\nजघान बाणैर्निशितैरनेकैः।\nस सायकस्तस्य सुपर्णवेग-\nस्तथातिवेगेन जगाम पार्श्वम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 5000478109, "chapter_id": 9478, "verse_number": "६-७१-१०९", "content_sanskrit": "तमागतं प्रेक्ष्य तदातिकायो\nबाणं प्रदीप्तान्तककालकल्पम्।\nजघान शक्त्यृष्टिगदाकुठारैः\nशूलैः शरैश्चाप्यविपन्नचेष्टः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 5000478110, "chapter_id": 9478, "verse_number": "६-७१-११०", "content_sanskrit": "तान्यायुधान्यद्भुतविग्रहाणि\nमोघानि कृत्वा स शरोऽग्निदीप्तः।\nप्रगृह्य तस्यैव किरीटजुष्टं\nतदातिकायस्य शिरो जहार ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 5000478111, "chapter_id": 9478, "verse_number": "६-७१-१११", "content_sanskrit": "तच्छिरः सशिरस्त्राणं लक्ष्मणेषुप्रमर्दितम्।\nपपात सहसा भूमौ शृङ्गं हिमवतो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 5000478112, "chapter_id": 9478, "verse_number": "६-७१-११२", "content_sanskrit": "तं भूमौ पतितं दृष्ट्वा विक्षिप्ताम्बरभूषणम्।\nबभूवुर्व्यथिताः सर्वे हतशेषा निशाचराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 5000478113, "chapter_id": 9478, "verse_number": "६-७१-११३", "content_sanskrit": "ते विषण्णमुखा दीनाः प्रहारजनितश्रमाः।\nविनेदुरुच्चैर्बहवः सहसा विस्वरैः स्वरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 5000478114, "chapter_id": 9478, "verse_number": "६-७१-११४", "content_sanskrit": "ततस्तत्परितं याता निरपेक्षा निशाचराः।\nपुरीमभिमुखा भीता द्रवन्तो नायके हते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 5000478115, "chapter_id": 9478, "verse_number": "६-७१-११५", "content_sanskrit": "प्रहर्षयुक्ता बहवस्तु वानराः\nप्रफुल्लपद्मप्रतिमाननास्तदा।\nअपूजयँल्लक्ष्मणमिष्टभागिनं\nहते रिपौ भीमबले दुरासदे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 5000478116, "chapter_id": 9478, "verse_number": "६-७१-११६", "content_sanskrit": "अतिबलमतिकायमभ्रकल्पं\nयुधि विनिपात्य स लक्ष्मणः प्रहृष्टः।\nत्वरितमथ तदा स रामपार्श्वं\nकपिनिवहैश्च सुपूजितो जगाम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 5000478117, "chapter_id": 9478, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे एकसप्ततितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}]