[{"id": 2108873, "chapter_id": 3361, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2108874, "chapter_id": 3361, "verse_number": "१", "content_sanskrit": "एतस्मिन्नेव काले तु जरत्कारुर्महातपाः ।\nचचार पृथिवीं कृत्स्नां यत्रसायङ्गृहो मुनिः\t ॥ १॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2108875, "chapter_id": 3361, "verse_number": "२", "content_sanskrit": "चरन् दीक्षां महातेजा दुश्चरामकृतात्मभिः ।\nतीर्थेष्वायतनं कुर्वन् पुण्येषु विचचार ह \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2108876, "chapter_id": 3361, "verse_number": "३", "content_sanskrit": "वायुभक्षो निराहारः शुष्यन्नहरहर्मुनिः ।\nस ददर्श पितॄन् गर्ते लम्बमानानधोमुखान्\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2108877, "chapter_id": 3361, "verse_number": "४", "content_sanskrit": "एकतन्त्ववशिष्टान् वै वीरणस्तम्बमाश्रितान् ।\nतं तन्तुं च शनैराखुमाददानं बिलेशयम् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2108878, "chapter_id": 3361, "verse_number": "५", "content_sanskrit": "निराहारान् कृशान् जीर्णान् गर्तेऽस्मिन् त्राणमिच्छतः ।\nउपसृत्य स तान् दीनाननुरूपोऽभ्यभाषत\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2108879, "chapter_id": 3361, "verse_number": "", "content_sanskrit": "जरत्कारुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2108880, "chapter_id": 3361, "verse_number": "६", "content_sanskrit": "के भवन्तोऽवलम्बन्ते वीरणस्तम्बमाश्रिताः ।\nदुर्बलं खादितं मूले ह्याखुना बिलवासिना \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2108881, "chapter_id": 3361, "verse_number": "७", "content_sanskrit": "वीरणस्तम्बके मूलं यदप्येकमिह स्थितम् ।\nतदप्ययं शनैराखुरादत्ते दशनैः शितैः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2108882, "chapter_id": 3361, "verse_number": "८", "content_sanskrit": "छिद्यतेऽल्पावशिष्टत्वादेतदप्यचिरादिव ।\nततः सम्पतितारो वै गर्ते ह्यस्मिन्नधोमुखाः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2108883, "chapter_id": 3361, "verse_number": "९", "content_sanskrit": "तेन मे दुःखमुत्पन्नं दृष्ट्वा युष्मानधोमुखान् ।\nकृच्छ्रामापदमापन्नान् प्रियं किं करवाणि वः\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2108884, "chapter_id": 3361, "verse_number": "१०", "content_sanskrit": "तपसोऽस्य चतुर्थेन तृतीयेनापि वा पुनः ।\nअर्धेन वापि सन्तर्तुम् आपदं ब्रूत मा चिरम् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2108885, "chapter_id": 3361, "verse_number": "११", "content_sanskrit": "अथवाऽपि समग्रेण तरन्तु तपसा मम ।\nभवन्तः सर्व एवास्मात् काममेवाभिधीयताम् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2108886, "chapter_id": 3361, "verse_number": "", "content_sanskrit": "पितरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2108887, "chapter_id": 3361, "verse_number": "१२", "content_sanskrit": "वृद्धो भवान् ब्रह्मचारी यो नस्त्रातुमिहेच्छति ।\nन तु विप्राग्य्र तपसा शक्यमेतद् व्यपोहितुम् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2108888, "chapter_id": 3361, "verse_number": "१३", "content_sanskrit": "अस्ति नस्तात तपसः फलं प्रवदतां वर ।\nसन्तानप्रक्षयाद् ब्रह्मन् पताम निरयेऽशुभे \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2108889, "chapter_id": 3361, "verse_number": "१४", "content_sanskrit": "लम्बतामिह नस्तात न ज्ञानं प्रतिभाति वै ।\nतेन त्वां नाभिजानीमो लोके विख्यातपौरुषम् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2108890, "chapter_id": 3361, "verse_number": "१५", "content_sanskrit": "वृद्धो भवान् महायोगी यो नः शोच्यान् सुदुःखितान् ।\nशोचस्युपेत्य कारुण्याच्छ्रुणु ये वै वयं द्विज \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2108891, "chapter_id": 3361, "verse_number": "१६", "content_sanskrit": "शोच्यान् सुदुःखितानस्मान् कस्माद् वेदविदां वर ।\nयायावरा नाम वयम् ऋषयः संशितव्रताः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2108892, "chapter_id": 3361, "verse_number": "१७", "content_sanskrit": "लोकात् पुण्यादिह भ्रष्टाः सन्तानप्रक्षयान्विताः ।\nप्रणष्टं नस्तपः पुण्यं न हि नस्तन्तुरस्ति वै \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2108893, "chapter_id": 3361, "verse_number": "१८", "content_sanskrit": "अस्ति त्वेकोऽद्य नस्तन्तुः सोऽपि नास्ति यथा तथा ।\nमन्दभाग्योऽल्पभाग्यानां बन्धुः स किल नः कुलम् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2108894, "chapter_id": 3361, "verse_number": "१९", "content_sanskrit": "जरत्कारुरिति ख्यातो वेदवेदाङ्गपारगः ।\nनियतात्मा महात्मा च सुव्रतः सुमहातपाः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2108895, "chapter_id": 3361, "verse_number": "२०", "content_sanskrit": "तेन स्म तपसो लोभात् कृच्छ्रमापादिता वयम् ।\nन तस्य भार्या पुत्रो वा बान्धवो वाऽपि कश्चन \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2108896, "chapter_id": 3361, "verse_number": "२१", "content_sanskrit": "तस्माल्लम्बामहे गर्ते नष्टसञ्ज्ञा ह्यनाथवत् ।\nस वक्तव्यस्त्वया दृष्ट्वा ह्यस्माकं नाथवत्तया\t ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2108897, "chapter_id": 3361, "verse_number": "२२", "content_sanskrit": "पितरस्तेऽवलम्बन्ते गर्ते दीना अधोमुखाः ।\nसाधु दारान् कुरुष्वेति प्रजायस्वेति चाभिभो \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2108898, "chapter_id": 3361, "verse_number": "२३", "content_sanskrit": "कुलतन्तुर्हि नः शिष्टः स एकस्तु तपोधनः ।\nयं तु पश्यसि नो ब्रह्मन् वीरणस्तम्बमाश्रितान् \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2108899, "chapter_id": 3361, "verse_number": "२५", "content_sanskrit": "एषोऽस्माकं कुलस्तम्ब आसीत् स कुलवर्धनः ।\nयानि पश्यसि वै ब्रह्मन् मूलानीहास्य वीरुधः \t॥२४॥\nएते नस्तन्तवस्तात कालेन परिभक्षिताः ।\nयत्त्वेकं पश्यसि ब्रह्मन् मूलमस्यार्धभक्षितम् \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2108900, "chapter_id": 3361, "verse_number": "२६", "content_sanskrit": "तस्य लम्बामहे सर्वे सोऽप्येकस्तप आस्थितः ।\nयमाखुं पश्यसि ब्रह्मन् काल एव महाबलः \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2108901, "chapter_id": 3361, "verse_number": "२७", "content_sanskrit": "जरत्कारुं तपोलुब्धं मन्दात्मानमचेतसम् ।\nन हि नस्तत्तपस्तस्य तारयिष्यति सत्तम\t ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2108902, "chapter_id": 3361, "verse_number": "२८", "content_sanskrit": "छिन्नमूलान् परिभ्रष्टान् कालोपहतचेतसः ।\nअप्रतिष्ठान् प्रपश्यास्मान् यथा दुष्कृतिनस्तथा \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2108903, "chapter_id": 3361, "verse_number": "२९", "content_sanskrit": "अस्मासु पतितेष्वत्र सह पूर्वैः पितामहैः ।\nछिन्नः कालेन सोऽप्यत्र गन्ता वै नरकं ततः \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2108904, "chapter_id": 3361, "verse_number": "३०", "content_sanskrit": "तपो वाऽप्यथ वा यज्ञो यच्चान्यत्पावनं महत् ।\nतत्सर्वं न समं तात सन्तत्यैतत् सतां मतम्\t ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2108905, "chapter_id": 3361, "verse_number": "३१", "content_sanskrit": "स तात दृष्ट्वा ब्रूयास्त्वं जरत्कारुं तपस्विनम् ।\nयथा दृष्टमिदं चाद्य त्वयाऽऽख्येयमशेषतः\t ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2108906, "chapter_id": 3361, "verse_number": "३२", "content_sanskrit": "यथा दारान् प्रकुर्यात् स पुत्रांश्चोत्पादयेद् यथा ।\nतथा ब्रह्मंस्त्वया वाच्यः सोऽस्माकं नाथवत्तया \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2108907, "chapter_id": 3361, "verse_number": "४०", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nचत्वारिंशोऽध्यायः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2108908, "chapter_id": 3361, "verse_number": "२८", "content_sanskrit": "॥ आस्तीकपर्वणि अष्टाविंशोऽध्यायः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]