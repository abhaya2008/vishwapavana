[{"id": 2059979, "chapter_id": 2285, "verse_number": "८-६-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2059980, "chapter_id": 2285, "verse_number": "८-६-१", "content_sanskrit": "श्रिया कुलेन यशसा तपसा च श्रुतेन च।\nत्वामद्य सन्तो मन्यन्ते ययातिमिव नाहुषम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2059981, "chapter_id": 2285, "verse_number": "८-६-२", "content_sanskrit": "श्रुते महर्षिप्रतिमः कृतकृत्योऽसि पार्थिव।\nपर्यवस्थापयात्मानं मा विषादे मनः कृथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2059982, "chapter_id": 2285, "verse_number": "८-६-३x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2059983, "chapter_id": 2285, "verse_number": "८-६-३", "content_sanskrit": "दैवमेव परं मन्ये धिक्पौरुषमनर्थकम्।\nयत्र सालप्रतीकाशः कर्णोऽहन्यत संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2059984, "chapter_id": 2285, "verse_number": "८-६-४", "content_sanskrit": "हत्वा युधिष्ठिरानीकं पाञ्चालानां रथव्रजान्।\nप्रताप्य शरवर्षेण दिशः सर्वा महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2059985, "chapter_id": 2285, "verse_number": "८-६-५", "content_sanskrit": "मोहियित्वा रणे पार्थान्वज्नहस्त इवासुरान्।\nस कथं निहतः शेते वायुरुग्ण इव द्रुमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2059986, "chapter_id": 2285, "verse_number": "८-६-६", "content_sanskrit": "शोकस्यान्तं न पश्यामि पारं जलनिधेरिव।\nचिन्ता मे वर्धतेऽतीव मुमूर्षा चापि जायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2059987, "chapter_id": 2285, "verse_number": "८-६-७", "content_sanskrit": "कर्णस्य निधनं श्रुत्वा विजयं फल्गुनस्य च।\nअश्रद्धेयमहं मन्ये वधं कर्णस्य सञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2059988, "chapter_id": 2285, "verse_number": "८-६-८", "content_sanskrit": "वज्रसारमिदं नूनं हृदयं दुर्भिदं मम।\nयच्छ्रुत्वा पुरुषव्याघ्रं हतं कर्णं न दीर्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2059989, "chapter_id": 2285, "verse_number": "८-६-९", "content_sanskrit": "आर्युर्नूनं सुदीर्घं मे विहितं दैवतैः पुरा।\nयत्र कर्णं हतं श्रुत्वा जीवामीह सुदुःखितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2059990, "chapter_id": 2285, "verse_number": "८-६-१०", "content_sanskrit": "धिग्जीवितमिदं चैव सुहृद्वीनस्य सञ्जय।\nअद्य चाहं दशामेतां गतः सञ्जय गर्हिताम्।\nकृपणं वर्तयिष्यामि शोच्यः सर्वस्य मन्दधीः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2059991, "chapter_id": 2285, "verse_number": "८-६-११", "content_sanskrit": "अहमेव पुरा भूत्वा सर्वलोकस्य सत्कृतः।\nपरिभूतः कथं सूत परैः शक्ष्यामि जीवितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2059992, "chapter_id": 2285, "verse_number": "८-६-१२", "content_sanskrit": "दुःखाद्दुःखतरं भन्ये प्राप्तवानस्मि सञ्जय।\nभीष्मद्रोणवधेनैव कर्णस्य च महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2059993, "chapter_id": 2285, "verse_number": "८-६-१३", "content_sanskrit": "नावशेषं प्रपश्यामि सूतपुत्रे हते युधि।\nसहि पारं महानासीत्पुत्राणां मम सञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2059994, "chapter_id": 2285, "verse_number": "८-६-१४", "content_sanskrit": "युद्धे हि निहतः शूरो विसृजन्सायकान्बहून्।\nको हि मे जीवितेनार्थस्तमृते पुरुषर्षभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2059995, "chapter_id": 2285, "verse_number": "८-६-१५", "content_sanskrit": "रथादाधिरथिर्नूनं न्यपतत्सायकार्दितः।\nपर्वतस्येव शिखरं व ज्रपाताद्विदारितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2059996, "chapter_id": 2285, "verse_number": "८-६-१६", "content_sanskrit": "स शेते पृथिवीं नूनं शोभयन्रुधिरोक्षितः।\nमातङ्ग इव मत्तेन मताङ्गेन निपातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2059997, "chapter_id": 2285, "verse_number": "८-६-१७", "content_sanskrit": "यो बलं धार्तराष्ट्राणां पाण्डवानां यतो भयम्।\nसोऽर्जुनेन हतः कर्णः प्रतिमानं धनुष्मताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2059998, "chapter_id": 2285, "verse_number": "८-६-१८", "content_sanskrit": "स हि वीरो महेष्वासो मित्राणामभयङ्करः।\nशेते विनिहतो वीरः शक्रेणेव पुरा बलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2059999, "chapter_id": 2285, "verse_number": "८-६-१९", "content_sanskrit": "पङ्गोरिवाध्वगमनं दरिद्रस्येव कामितम्।\nदुर्योधनस्य लोभश्च समान्येतानि सञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2060000, "chapter_id": 2285, "verse_number": "८-६-२०", "content_sanskrit": "अन्यथा चिन्तितं कार्यमन्यथा तत्तु जायते।\nअहो नु बलवद्दैवं कालश्च दुरतिक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2060001, "chapter_id": 2285, "verse_number": "८-६-२१", "content_sanskrit": "पलायमानः कृपणो दीनात्मा दीनपौरुषः।\nकच्चिद्विनिहतः सूत पुत्रो दुःशासनो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2060002, "chapter_id": 2285, "verse_number": "८-६-२२", "content_sanskrit": "कच्चिन्न दीनाचरितं कृतवांस्तात संयुगे।\nकच्चिन्न निहतः शूरा यथाऽन्ये क्षत्रियर्षभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2060003, "chapter_id": 2285, "verse_number": "८-६-२३", "content_sanskrit": "युधिष्ठिरस्य वचनं मा युद्धमिति सर्वदा।\nदुर्योधनो नाभ्यगृह्णान्मूढः पथ्यमिवौषधम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2060004, "chapter_id": 2285, "verse_number": "८-६-२४", "content_sanskrit": "शतल्पे शयानेन भीष्मेण सुमहात्मना।\nपानीयं याचितः पार्थः सोविध्यन्मेदिनीतलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2060005, "chapter_id": 2285, "verse_number": "८-६-२५", "content_sanskrit": "जलस्य धारां जनितां दृष्ट्वा पाण्डुसुतेन च।\nअब्रवीत्स महाबाहुस्तात संशाम्य पाण्डवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2060006, "chapter_id": 2285, "verse_number": "८-६-२६", "content_sanskrit": "प्रशमाद्वि भवेच्छान्तिर्मदन्तं युद्धमस्तु वः।\nभ्रातृभावेन पृथिवीं भुङ्क्ष्व पाण्डुसुतैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2060007, "chapter_id": 2285, "verse_number": "८-६-२७", "content_sanskrit": "अकुर्वन्वचनं तस्य नूनं शोचति पुत्रकः।\nतदिदं समनुप्राप्त वचनं दीर्घदर्शिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2060008, "chapter_id": 2285, "verse_number": "८-६-२८", "content_sanskrit": "अहं तु निहतामात्यो हतपुत्रश्च सञ्जय।\nद्यूततः कृच्छ्रमापन्नो लूनपक्ष इव द्विजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2060009, "chapter_id": 2285, "verse_number": "८-६-२९", "content_sanskrit": "यथा हि शकुनिं गृह्य छित्त्वा पक्षौ च सञ्जय।\nविसर्जयन्ति संहृष्टाः क्रीडमानाः कुमारकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2060010, "chapter_id": 2285, "verse_number": "८-६-३०", "content_sanskrit": "लूनपक्षतया तस्य गमनं नोपपद्यते।\nतथाहमपि सम्प्राप्तो लूनपक्ष इव द्विजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2060011, "chapter_id": 2285, "verse_number": "८-६-३१", "content_sanskrit": "क्षीणः सर्वार्थहीनश्च निर्ज्ञातिर्बन्धुवर्जितः।\nकां दिशं प्रतिपत्स्यामि दीनः शत्रुवशं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2060012, "chapter_id": 2285, "verse_number": "८-६-३२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2060013, "chapter_id": 2285, "verse_number": "८-६-३२", "content_sanskrit": "इत्येवं धृतराष्ट्रोऽथ विलप्य बहुदुःखितः।\nप्रोवाच सञ्जयं भूयः सोकव्याकुलमानसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2060014, "chapter_id": 2285, "verse_number": "८-६-३३x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2060015, "chapter_id": 2285, "verse_number": "८-६-३३", "content_sanskrit": "योऽजयत्सर्वकाम्भोजानम्बष्ठान्कैकयैः सह।\nगान्धारांश्च विदेहांश्च जित्वा कार्यार्थमाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2060016, "chapter_id": 2285, "verse_number": "८-६-३४", "content_sanskrit": "दुर्योधनस्य वृद्ध्यर्थं योऽजयत्पृथिवीं प्रभुः।\nस जितः पाण्डवैः शूरैः समरे वाहुशालिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2060017, "chapter_id": 2285, "verse_number": "८-६-३५", "content_sanskrit": "तस्मिन्हते महेष्वासे कर्णे युधि किरीटिना।\nके वीराः पर्यतिष्ठन्त तन्ममाचक्ष्व सञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2060018, "chapter_id": 2285, "verse_number": "८-६-३६", "content_sanskrit": "कच्चिन्नैकः परित्यक्तः पाण्डवैर्निहतो रणे।\nउक्तं त्वया पुरा तात यथा वीरो निपातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2060019, "chapter_id": 2285, "verse_number": "८-६-३७", "content_sanskrit": "भीष्ममप्रतियुध्यन्तं शिखम्डी सायकोत्तमैः।\nपातयामास समरे सर्वशस्त्रभृतां वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2060020, "chapter_id": 2285, "verse_number": "८-६-३८", "content_sanskrit": "तथा द्रौपदिना द्रोणो न्यस्तसर्वायुधो युधि।\n`धर्मराजवचः श्रुत्वा अश्वत्थामा हतस्त्विति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2060021, "chapter_id": 2285, "verse_number": "८-६-३९", "content_sanskrit": "युक्तयोगो महेष्वासः शरैर्बहुभिराचितः।\nनिहतः खङ्गमुद्यम्य धृष्टद्युम्नेन सञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2060022, "chapter_id": 2285, "verse_number": "८-६-४०", "content_sanskrit": "अन्तरेण हतावेतौ छलेन च विशेषतः।\nअश्रौषमहमेतद्वै भीष्मद्रोणौ निपातितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2060023, "chapter_id": 2285, "verse_number": "८-६-४१", "content_sanskrit": "भीष्मद्रोणौ हि समरे न हन्याद्वज्रभृत्स्वयम्।\nन्यायेन युध्यन्समरे तद्वै सत्यं ब्रवीमि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2060024, "chapter_id": 2285, "verse_number": "८-६-४२", "content_sanskrit": "कर्णं त्वस्यन्तमस्त्राणि दिव्यानि च बहूनि च।\nकथमिन्द्रोपमं वीरं मृत्युर्युद्वे समस्पृशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2060025, "chapter_id": 2285, "verse_number": "८-६-४३", "content_sanskrit": "यस्य विद्युत्प्रभां शक्तिं दिव्यां कनकभूषणाम्।\nप्रायच्छद्द्विषतां हन्त्रीं कुण्डलाभ्यां पुरन्दरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2060026, "chapter_id": 2285, "verse_number": "८-६-४४", "content_sanskrit": "यस्य सर्पमुखो दिव्यः शरः काञ्चनभूषणः।\nअशेत निशितः पत्री समरेष्वरिसूदनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2060027, "chapter_id": 2285, "verse_number": "८-६-४५", "content_sanskrit": "भीष्मद्रोणमुखान्वीरान्योऽवमत्य महारथान्।\nजामदग्न्यान्महाघोरं ब्राह्ममस्त्रमशिक्षत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2060028, "chapter_id": 2285, "verse_number": "८-६-४६", "content_sanskrit": "यश्च द्रोणमुखान्दृष्ट्वा विमुखानर्दिताञ्शरैः।\nसौभद्रस्य महाबाहुर्व्यधमत्कार्मुकं शितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2060029, "chapter_id": 2285, "verse_number": "८-६-४७", "content_sanskrit": "यश्च नागायुतप्राणां वज्ररंहसमच्युतम्।\nविरथं सहसा कृत्वा भीमसेनमपाहसत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2060030, "chapter_id": 2285, "verse_number": "८-६-४८", "content_sanskrit": "सहदेवं च निर्जित्य शरैः सन्नतपर्वभिः।\nकृपया विरथं कृत्वा नाहनद्धर्मचिन्तया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2060031, "chapter_id": 2285, "verse_number": "८-६-४९", "content_sanskrit": "यश्च मायासहस्राणि विकुर्वाणं जयैषिणम्।\nघटोत्कचं राक्षसेन्द्रं शक्रशक्त्या निजघ्निवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2060032, "chapter_id": 2285, "verse_number": "८-६-५०", "content_sanskrit": "एवांश्च दिवसान्यस्य युद्धे भीतो धनञ्जयः।\nनागमद्द्वैरथं वीरः स कथं निहतो रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2060033, "chapter_id": 2285, "verse_number": "८-६-५१", "content_sanskrit": "[संशप्तकानां योधा ये आह्वयन्त सदाऽन्यतः।\nएतान्हत्वा हनिष्यामि पश्चाद्वैकर्तनं रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2060034, "chapter_id": 2285, "verse_number": "८-६-५२", "content_sanskrit": "इति व्यपदिशन्पार्थो वर्जयन्सूतजं रणे।\nस कथं निहतो वीरः पार्थेन परवीरहा॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2060035, "chapter_id": 2285, "verse_number": "८-६-५३", "content_sanskrit": "रथभह्गो न चेत्तस्य धनुर्वा न व्यशीर्यत।\nन चेदस्त्राणि नष्टानि स कथं निहतः परैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2060036, "chapter_id": 2285, "verse_number": "८-६-५४", "content_sanskrit": "को हि शक्तो रणे कर्णं विधुन्वानं महद्धनुः।\nविमुञ्चन्तं शरान्घोरान्दिव्यान्यस्त्राणि चाहवे।\nजेतुं पुरुषशार्दूलं शार्दूलमिव वेगिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2060037, "chapter_id": 2285, "verse_number": "८-६-५५", "content_sanskrit": "ध्रवं तस्य धनुश्छिन्नं रथो वाऽपि महीं गतः।\nअस्त्राणि वा प्रनष्टानि यथा शंससि मे हतम्।\nन ह्यन्यदपि पश्यामि कारणं तस्य नाशने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2060038, "chapter_id": 2285, "verse_number": "८-६-५६", "content_sanskrit": "न हिन्मि फल्गुनं यावत्तावत्पादौ न धावये।\nइति यस्य महाघोरं व्रतमासीन्महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2060039, "chapter_id": 2285, "verse_number": "८-६-५७", "content_sanskrit": "यस्य भीतो रमे निद्रां धर्मराजो युधिष्ठिरः।\nत्रयोदशसमा नित्यं नाभजत्पुरुषर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2060040, "chapter_id": 2285, "verse_number": "८-६-५८", "content_sanskrit": "यस्य वीर्यवतो वीर्यमुपाश्रित्य महात्मनः।\nमम पुत्रः सभां भार्यां पाण्डूनां नीतवान्बलात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2060041, "chapter_id": 2285, "verse_number": "८-६-५९", "content_sanskrit": "तत्रापि च सभामध्ये पाण्डवानां च पश्यताम्।\nदासभार्येति पाञ्चालीमब्रवीत्कुरुसन्निधौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2060042, "chapter_id": 2285, "verse_number": "८-६-६०", "content_sanskrit": "[न सन्ति तपयः कृष्णे सर्वे षण्डतिलैः समाः।\nउपतिष्ठस्व भर्तारमन्यं वा वरवर्णिनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2060043, "chapter_id": 2285, "verse_number": "८-६-६१", "content_sanskrit": "इत्येवं यः पुरा वाचो रूक्षाः संश्रावयन्रुषा।\nसभायां सूतजः कृष्णां स कथं निहतः परैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2060044, "chapter_id": 2285, "verse_number": "८-६-६२", "content_sanskrit": "यदि भीष्मो रणश्लाघी द्रोणो वा युधि दुर्मदः।\nन हनिष्यति कौन्तेयान्पक्षपातात्सुयोधन।\nसर्वानेव हनिष्यामि व्येतु ते मानसो ज्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2060045, "chapter_id": 2285, "verse_number": "८-६-६३", "content_sanskrit": "किं करिष्यति गाण्डीवमक्षय्यौ च महेषुधी।\nस्निग्धचन्दनदिग्धस्य मच्छरस्याभिधावतः।\nस नूनमृषभस्कन्धो ह्यर्जुनेन कथं हतः॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2060046, "chapter_id": 2285, "verse_number": "८-६-६४", "content_sanskrit": "यश्च गाण्डीवमुक्तानां स्पर्शमुग्रमचिन्तयन्।\nअपतिर्ह्यसि कृष्णेति ब्रुवन्पार्थानवैक्षत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2060047, "chapter_id": 2285, "verse_number": "८-६-६५", "content_sanskrit": "यस्य नासीद्भयं पार्थात्सपुत्रात्सजनार्दनात्।\nस्वबाहुबलमाश्रित्य मुहूर्तमपि सञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2060048, "chapter_id": 2285, "verse_number": "८-६-६६", "content_sanskrit": "तस्य नाऽहं वधं मन्ये देवैरपि सवासवैः।\nप्रतीपमभिघावद्भिः किं पुनस्तात पाण्डवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2060049, "chapter_id": 2285, "verse_number": "८-६-६७", "content_sanskrit": "न हि ज्यां संसम्पृशानस्य तलत्रे वाऽपि गृह्णतः।\nपुमानाधिरथेः स्थातुं कश्चित्प्रमुखतोऽर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2060050, "chapter_id": 2285, "verse_number": "८-६-६८", "content_sanskrit": "अपि स्यान्मेदिनी हीना सोमसूर्यप्रभांशुभिः।\nन वध- पुरुषेन्द्रस्य संयुगेष्वपलायिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2060051, "chapter_id": 2285, "verse_number": "८-६-६९", "content_sanskrit": "येन मन्दः सहायेन भ्रात्रा दुःशासनेन च।\nवासुदेवस्य दुर्बुद्धिः प्रत्याख्यानमरोचत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2060052, "chapter_id": 2285, "verse_number": "८-६-७०", "content_sanskrit": "स नूनं वृषभस्कन्धं कर्णं दृष्ट्वा निपातितम्।\nदुःशासनं च निहतं मन्ये शोचति पुत्रकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2060053, "chapter_id": 2285, "verse_number": "८-६-७१", "content_sanskrit": "हतं वैकर्तनं दृष्ट्वा द्वैरथे सव्यसाचिना।\nजयतः पाण्डवान्दृष्ट्वा किंस्विद्दुर्योधनोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2060054, "chapter_id": 2285, "verse_number": "८-६-७२", "content_sanskrit": "[दुर्मर्षणं हतं दृष्ट्वा वृषसेनं च संयुगे।\nप्रभग्रं च बलं दृष्ट्वा वध्यमानं महारथैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2060055, "chapter_id": 2285, "verse_number": "८-६-७३", "content_sanskrit": "पराङ्मुखांश्च राज्ञस्तु पलायनपरायणान्।\nविद्रुतान्रथिनो दृष्ट्वा मन्ये शोचति पुत्रकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2060056, "chapter_id": 2285, "verse_number": "८-६-७४", "content_sanskrit": "अनेयश्चाभिमानी च दुर्बुद्धिरजितेन्द्रियः।\nहतोत्साहं बलं दृष्ट्वा किंस्विदुर्योधनोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2060057, "chapter_id": 2285, "verse_number": "८-६-७५", "content_sanskrit": "स्वयं वैरं महत्कृत्वा वार्यमाणः सुहृद्गणैः।\nप्रधने हतभूयिष्ठैः किंस्विद्दुर्योधनोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2060058, "chapter_id": 2285, "verse_number": "८-६-७६", "content_sanskrit": "भ्रातरं निहतं दृष्ट्वा भीमसेनेन संयुगे।\nरुधिरे पीयमाने च किंस्विद्द्रुर्योधनोऽब्रवीत्॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2060059, "chapter_id": 2285, "verse_number": "८-६-७७", "content_sanskrit": "सह गान्धारराजेन सभायां यदभाषत।\nकर्णोऽर्जुनं रणे हन्ता हते तस्मिन्किमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2060060, "chapter_id": 2285, "verse_number": "८-६-७८", "content_sanskrit": "द्यूतं कृत्वा पुरा हृष्ठो वञ्चयित्वा च पाण़्डवान्।\nशकुनिः सौबलस्तात हते कर्णे किमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2060061, "chapter_id": 2285, "verse_number": "८-६-७९", "content_sanskrit": "कृतवर्मा महेष्वासः सात्वतानां महारथः।\nहतं वैकर्तनं दृष्ट्वा हार्दिक्यः किमभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2060062, "chapter_id": 2285, "verse_number": "८-६-८०", "content_sanskrit": "ब्राह्मणाः क्षत्रिया वैश्या यस्य शिक्षामुपासते।\nधनुर्वेदं चिकीर्षन्तो द्रोणपुत्रस्य धीमतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2060063, "chapter_id": 2285, "verse_number": "८-६-८१", "content_sanskrit": "युवा रूपेण सम्पन्नो दर्शनीयो महायशाः।\nअश्वत्थामा हते कर्णे किमभाषत सञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2060064, "chapter_id": 2285, "verse_number": "८-६-८२", "content_sanskrit": "आचार्यो यो धनुर्वेदे गौतमो रथसत्तमः।\nकृपः शारद्वतस्तात हते कर्णे किमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2060065, "chapter_id": 2285, "verse_number": "८-६-८३", "content_sanskrit": "मद्रराजो महेष्वासः शल्यः समितिशोभनः।\nदृष्ट्वा विनिहतं कर्णं सारथ्ये रथिनां वरः।\nकिमभाषत सौवीरो मद्राणामधिपो बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2060066, "chapter_id": 2285, "verse_number": "८-६-८४", "content_sanskrit": "दृष्ट्वा विनिहतं सर्वे योधा वारणदुर्जयाः।\nये च केन राजानः पृथिव्यां योद्वुमागताः।\nवैकर्तनं हतं दृष्टवा कान्यभाषन्त सञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2060067, "chapter_id": 2285, "verse_number": "८-६-८५", "content_sanskrit": "द्रोणे तु निहते वीरे रथव्याघ्रे नरर्षभे।\nके वा मुखमनीकानामासन्सञ्जय भागशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2060068, "chapter_id": 2285, "verse_number": "८-६-८६", "content_sanskrit": "मद्रराजः कथं शल्यो नियुक्तो रथिनां वरः।\nवैकर्तनस्य सारथ्ये तन्ममाचक्ष्व सञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2060069, "chapter_id": 2285, "verse_number": "८-६-८७", "content_sanskrit": "केऽरक्षन्दक्षिणं चक्रं सूतपुत्रस्य युध्यतः।\nवामं चक्रं ररक्षुर्वा के वा वीरस्य पृष्ठतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2060070, "chapter_id": 2285, "verse_number": "८-६-८८", "content_sanskrit": "के कर्णं न जहुः शूराः के क्षुद्राः प्राद्रवंस्ततः।\nकथं च वः समेतानां हतः कर्णो महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2060071, "chapter_id": 2285, "verse_number": "८-६-८९", "content_sanskrit": "पाण्डवाश्च स्वयं शूराः प्रत्युदीयुर्महारथाः।\nसृजन्तः शरवर्षाणि वारिधारा इवाम्बुदाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2060072, "chapter_id": 2285, "verse_number": "८-६-९०", "content_sanskrit": "स च सर्पमुखो दिव्यो महेषुप्रवरस्तदा।\nव्यर्थः कथं समभवत्तन्ममाचक्ष्व स़ञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2060073, "chapter_id": 2285, "verse_number": "८-६-९१", "content_sanskrit": "मामकस्यास्य सैन्यस्य हतोत्सेधस्य सञ्जय।\nअवशेषं न पश्यामि ककुदे मृदिते सति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2060074, "chapter_id": 2285, "verse_number": "८-६-९२", "content_sanskrit": "तौ हि वीरौ महेष्वासौ मदर्थे त्यक्तजीवीतौ।\nभीष्मद्रोणौ हतौ श्रुत्वा को न्वर्थो जीवितेन मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2060075, "chapter_id": 2285, "verse_number": "८-६-९३", "content_sanskrit": "पुनः पुनर्न मृष्यामि वधं कर्णस्य पाण्डवैः।\nयस्य बाह्वोर्बलं तुल्यं कुञ्जराणां शतं शतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2060076, "chapter_id": 2285, "verse_number": "८-६-९४", "content_sanskrit": "द्रोणे हते च यद्वृत्तं कौरवाणां परैः सह।\nसङ्घामे नरवीराणां तन्ममाचक्ष्व सञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2060077, "chapter_id": 2285, "verse_number": "८-६-९५", "content_sanskrit": "यथा कर्णश्च कौन्तेयैः सह युद्धमयोजयत्।\nतथा च द्विषतां हन्ता रणे शान्तस्तदुच्यताम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2060078, "chapter_id": 2285, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि षष्ठोऽध्यायः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}]