[{"id": 2057531, "chapter_id": 2246, "verse_number": "७-१७३-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2057532, "chapter_id": 2246, "verse_number": "७-१७३-१", "content_sanskrit": "विद्रुतं स्वबलं दृष्ट्वा वध्यमानं महात्मभिः।\nक्रोधेन महताऽविष्टः पुत्रस्तव विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2057533, "chapter_id": 2246, "verse_number": "७-१७३-२", "content_sanskrit": "अभ्येत्य सहसा कर्णं द्रोणं च जयतां वरम्।\nअमर्षवशमापन्नो वाक्यज्ञो वाक्यमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2057534, "chapter_id": 2246, "verse_number": "७-१७३-३", "content_sanskrit": "भवद्ध्भामिह सङ्ग्रामः क्रुद्धाभ्यां सम्प्रवर्तितः।\nआहवे निहतं दृष्ट्वा सैन्धवं सव्यसाचिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2057535, "chapter_id": 2246, "verse_number": "७-१७३-४", "content_sanskrit": "निहन्यमानां पाण़्डूनां बलेन मम वाहिनीम्।\nभूत्वा तद्विजये शक्तावशक्ताविव पश्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2057536, "chapter_id": 2246, "verse_number": "७-१७३-५", "content_sanskrit": "यद्यहं भवतोस्त्याज्यो न वाच्योऽस्मि तदैव हि।\nआवां पाण्डुसुतान्सङ्ख्ये जेष्याव इति मानदौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2057537, "chapter_id": 2246, "verse_number": "७-१७३-६", "content_sanskrit": "तदैवाहं वचः श्रुत्वा भवद्ध्यामनुसम्पतम्।\nनाकरिष्यमिदं पार्थैर्वैरं योधविनाशनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2057538, "chapter_id": 2246, "verse_number": "७-१७३-७", "content_sanskrit": "यदि नाहं परित्याज्यो भवद्भ्यां पुरुषर्षभौ॥\nयुध्यतामनुरूपेण विक्रमेण सुविक्रमौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2057539, "chapter_id": 2246, "verse_number": "७-१७३-८", "content_sanskrit": "वाक्प्रतोदेन तौ वीरौ प्रणुन्नौ तनयेन ते।\nप्रावर्तयेतां सङ्ग्रामं घट्टिताविव पन्नगौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2057540, "chapter_id": 2246, "verse_number": "७-१७३-९", "content_sanskrit": "ततस्तौ रथिनां श्रेष्ठौ सर्वलोकधनुर्धरौ।\nशैनेयप्रमुखान्पार्थानभिदुद्रुवत् रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2057541, "chapter_id": 2246, "verse_number": "७-१७३-१०", "content_sanskrit": "तथैव सहिताः पार्थाः सर्वसैन्येन संवृताः।\nअभ्यवर्तन्त तौ वीरौ नर्दमानौ मुहुर्मुहुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2057542, "chapter_id": 2246, "verse_number": "७-१७३-११", "content_sanskrit": "अथ द्रोणो महेष्वासो दशभिः शिनिपुङ्गवम्।\nअविध्यत्त्वरितं क्रुद्धः सर्वशस्त्रभृतां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2057543, "chapter_id": 2246, "verse_number": "७-१७३-१२", "content_sanskrit": "कर्णश्च दशभिर्बाणैः पुत्रश्च तव सप्तभिः।\nदशभिर्वृषसेनश्च सौबलश्चापि सप्तभिः।\nएते कौरव सङ्क्रन्दे शैनेयं पर्यवाकिरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2057544, "chapter_id": 2246, "verse_number": "७-१७३-१३", "content_sanskrit": "दृष्ट्वा च समरे द्रोणं निघ्नन्तं पाण्डवीं चमूम्।\nविव्यधुः सोमकास्तूर्णं समन्ताच्छरवृष्टिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2057545, "chapter_id": 2246, "verse_number": "७-१७३-१४", "content_sanskrit": "तत्र द्रोणोऽहरत्प्राणान्क्षत्रियाणां विशाम्पते।\nरश्मिभिर्भास्करो राजंस्तमांसीव समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2057546, "chapter_id": 2246, "verse_number": "७-१७३-१५", "content_sanskrit": "द्रोणेन वध्यमानानां पाञ्चालानां विशाम्पते।\nशुश्रुवे तुमुलः शब्दः क्रोशतामितरेतरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2057547, "chapter_id": 2246, "verse_number": "७-१७३-१६", "content_sanskrit": "पुत्रानन्ये पितॄनन्ये भ्रातॄनन्ये च मातुलान्।\nभागिनेयान्वयस्यांश्च तथा सम्बन्धिबान्धवान्।\nउत्सृज्योत्सृज्य गच्छन्ति त्वरिता जीवितेप्सवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2057548, "chapter_id": 2246, "verse_number": "७-१७३-१७", "content_sanskrit": "अपरे मोहिता मोहात्तमेवाभिमुखा ययुः।\nपाण्डवानां रणे योधाः परलोकं गताः परे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2057549, "chapter_id": 2246, "verse_number": "७-१७३-१८", "content_sanskrit": "सा तथा पाण़्वी सेना पीड्यमाना महात्मना।\nनिशि सम्प्राद्रवद्राजन्नुत्सृज्योल्काः सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2057550, "chapter_id": 2246, "verse_number": "७-१७३-१९", "content_sanskrit": "पश्यतो भीमसेनस्य विजयस्याच्युतस्य च।\nययमोर्धर्मपुत्रस्य पार्षतस्य च पश्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2057551, "chapter_id": 2246, "verse_number": "७-१७३-२०", "content_sanskrit": "तमसा संवृते लोके न प्राज्ञायत किञ्चन।\nकौरवाणां प्रकाशेन दृश्यन्ते विद्रुताः परे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2057552, "chapter_id": 2246, "verse_number": "७-१७३-२१", "content_sanskrit": "द्रवमाणं तु तत्सैन्यं द्रोणकर्णौ महारथौ।\nजघ्नतुः पृष्ठतो राजन्किरन्तौ सायकान्बहून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2057553, "chapter_id": 2246, "verse_number": "७-१७३-२२", "content_sanskrit": "पाञ्चालेषु प्रभग्नेषु क्षीयमाणेषु सर्वतः।\nजनार्दनो दीनमानाः प्रत्यभाषत फल्गुनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2057554, "chapter_id": 2246, "verse_number": "७-१७३-२३", "content_sanskrit": "द्रोणकर्णौ महेष्वासावेतौ पार्षतसात्यकी।\nपाञ्चालांश्चैव सहितौ जघ्नतुः सायकैर्भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2057555, "chapter_id": 2246, "verse_number": "७-१७३-२४", "content_sanskrit": "एतयोः शरवर्षेण प्रभग्ना नो महारथाः।\nवार्यमाणापि कौन्तेय पृतना नावतिष्ठते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2057556, "chapter_id": 2246, "verse_number": "७-१७३-२५", "content_sanskrit": "तां तु विद्रवतीं दृष्ट्वा ऊचतुः केशवार्जुनौ।\nमा विद्रवत वित्रस्ता भयं त्यजत पाण्डवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2057557, "chapter_id": 2246, "verse_number": "७-१७३-२६", "content_sanskrit": "तावावां सर्वसैन्यैश्च व्यूहैः सम्यगुदायुधैः।\nद्रोणं च सूतपुत्रं च प्रयतावः प्रबाधितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2057558, "chapter_id": 2246, "verse_number": "७-१७३-२७", "content_sanskrit": "एतौ हि बलिनौ शूरौ कृतास्त्रौ जितकाशिनौ।\nउपेक्षितौ बलं तूर्णं नाशयेतां निशामिमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2057559, "chapter_id": 2246, "verse_number": "७-१७३-२८", "content_sanskrit": "सञ्जय उवाच।\nतयोः संवदतोरेवं भीमकर्मा महाबलः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2057560, "chapter_id": 2246, "verse_number": "७-१७३-२९", "content_sanskrit": "आयाद्वृकोदरः शीघ्रं पुनरावर्त्य वाहिनीम्॥\nवृकोदरमथायान्तं दृष्ट्वा तत्र जनार्दनः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2057561, "chapter_id": 2246, "verse_number": "७-१७३-३०", "content_sanskrit": "पुनरेवाब्रवीद्राजन्हर्षयन्निव पाण्डवम्॥\nएष भीमो रणश्लाघी वृतः सोमकपाण्डवैः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2057562, "chapter_id": 2246, "verse_number": "७-१७३-३१", "content_sanskrit": "अभ्यवर्तत वेगेन द्रोणकर्णौ महारथौ॥\nएतेन सहितो युद्ध्य पाञ्चालैश्च महारथैः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2057563, "chapter_id": 2246, "verse_number": "७-१७३-३२", "content_sanskrit": "आश्वासनार्थं सैन्यानां सर्वेषां पाण़्डुनन्दन॥\nततस्तौ पुरुषव्याघ्रावुभौ माधवपाण्डवौ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2057564, "chapter_id": 2246, "verse_number": "७-१७३-३३", "content_sanskrit": "द्रोणकर्णौ समासाद्य धिष्ठितौ रणमूर्धनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2057565, "chapter_id": 2246, "verse_number": "७-१७३-३३x", "content_sanskrit": "सञ्जय उवाच।\nततस्तत्पुनरावृत्तं युधिष्ठिरबलं महत्।\nततो द्रोणश्च कर्णश्च परान्ममृदतुर्युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2057566, "chapter_id": 2246, "verse_number": "७-१७३-३४", "content_sanskrit": "स सम्प्रहारस्तुमुलो निशि प्रत्यभवन्महान्।\nयथा सागरयो राजंश्चन्द्रोदयविरुद्धयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2057567, "chapter_id": 2246, "verse_number": "७-१७३-३५", "content_sanskrit": "तत उत्सृज्य पाणिभ्यां प्रदीपांस्तव वाहिनी।\nयुयुधे पाण्डवैः सार्धमुन्मत्तवदसङ्कुला॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2057568, "chapter_id": 2246, "verse_number": "७-१७३-३६", "content_sanskrit": "रजसा तमसा चैव संवृते भृशदारुणे।\nकेवलं नामगोत्रेण प्रायुध्यन्त जयैषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2057569, "chapter_id": 2246, "verse_number": "७-१७३-३७", "content_sanskrit": "अश्रूयन्त हि नामानि श्राव्यमाणानि पार्थिवैः।\nप्रहरद्भिर्महाराज स्वयंवर इवाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2057570, "chapter_id": 2246, "verse_number": "७-१७३-३८", "content_sanskrit": "निःशब्दमासीत्सहसा पुनः शब्दो महानभूत्।\nक्रुद्धानां युध्यमानानां जीयतां जयतामपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2057571, "chapter_id": 2246, "verse_number": "७-१७३-३९", "content_sanskrit": "यत्रयत्र स्म दृश्यन्ते प्रदीपाः कुरुसत्तम।\nतत्रतत्र स्म शूरास्ते निपतन्ति पतङ्गवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2057572, "chapter_id": 2246, "verse_number": "७-१७३-४०", "content_sanskrit": "तथा संयुध्यमानानां विगाढाऽऽसीन्महानिशा।\nपाण्डवानां च राजेन्द्र कौरवाणां च सर्वशः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2057573, "chapter_id": 2246, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि घटोत्कचवधपर्वणि चतुर्दशरात्रियुद्धे त्रिसप्तत्यधिकशततमोऽध्यायः॥ १७३ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-१७३-८ घट्टितौ मर्दितौ॥ ५-१७३-१२ सङ्क्रन्दे युद्धे॥ ५-१७३-२३ सात्यकी इति द्वितीयान्तम्॥ ५-१७३-१७३ त्रिसप्तत्यधिकशततमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]