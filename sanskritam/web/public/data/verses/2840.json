[{"id": 2086555, "chapter_id": 2840, "verse_number": "१२-३४५-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2086556, "chapter_id": 2840, "verse_number": "१२-३४५-१", "content_sanskrit": "यदा भक्तो भगवति आसीद्राजा महान्वसुः।\nकिमर्थं स परिभ्रष्टो विवेश विवरं भुवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2086557, "chapter_id": 2840, "verse_number": "१२-३४५-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2086558, "chapter_id": 2840, "verse_number": "१२-३४५-२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nऋषीणां चैव संवादं त्रिदशानां च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2086559, "chapter_id": 2840, "verse_number": "१२-३४५-३", "content_sanskrit": "`इयं वै कर्मभूमिः स्यात्स्वर्गो भोगाय कल्पितः।\nतस्मादिन्द्रो महीं प्राप्य यजनाप तु दीक्षितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2086560, "chapter_id": 2840, "verse_number": "१२-३४५-४", "content_sanskrit": "सवनीयपशोः काल आगते तु बृहस्पतिः।\nपिष्टमानीयतामत्र पश्वर्थमिति भाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2086561, "chapter_id": 2840, "verse_number": "१२-३४५-५", "content_sanskrit": "तच्छ्रुत्वा देवताः सर्वा इदमूचुर्द्विजोत्तमम्।\nबृहस्पतिं मांसगृद्धाः पृथक्पृथगिदं पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2086562, "chapter_id": 2840, "verse_number": "१२-३४५-६", "content_sanskrit": "अजेन यष्टव्यमिति प्राहुर्देवा द्विजोत्तमान्।\nस च छागोप्यजो ज्ञेयो नान्यः पशुरिति स्थितिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2086563, "chapter_id": 2840, "verse_number": "१२-३४५-७x", "content_sanskrit": "ऋषय ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2086564, "chapter_id": 2840, "verse_number": "१२-३४५-७", "content_sanskrit": "बीजैर्यज्ञेषु यष्टव्यमिति वै वैदिकी श्रुतिः।\nअजसंज्ञानि बीजानि च्छागं नो हन्तुमर्हथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2086565, "chapter_id": 2840, "verse_number": "१२-३४५-८", "content_sanskrit": "नैष धर्मः सतां देवा यत्र बध्येत वै पशुः।\nइदं कृतयुगं श्रेष्ठं कथं वध्येत वै पशुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2086566, "chapter_id": 2840, "verse_number": "१२-३४५-९x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2086567, "chapter_id": 2840, "verse_number": "१२-३४५-९", "content_sanskrit": "तेषां संवदतामेवमृषीणां विबुधैः सह।\nमार्गागतो नृपश्रेष्ठस्तं देशं प्राप्तवान्वसुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2086568, "chapter_id": 2840, "verse_number": "१२-३४५-१०", "content_sanskrit": "अन्तरिक्षचरः श्रीमान्सहस्रबलवाहनः।\nतं दृष्ट्वा सहसाऽऽयान्तं वसुं ते त्वन्तरिक्षगम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2086569, "chapter_id": 2840, "verse_number": "१२-३४५-११", "content_sanskrit": "ऊचुर्द्विजातयो देवानेष च्छेत्स्यति संशयम्।\nयज्वा दानपतिः श्रेष्ठः सर्वभूतहितप्रियः।\nकथंस्विदन्यथा ब्रूयादेष वाक्यं महान्वसुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2086570, "chapter_id": 2840, "verse_number": "१२-३४५-१२", "content_sanskrit": "एवं ते संविदं कृत्वा विबुधा ऋषयस्तथा।\nअपृच्छन्सहिताऽभ्येत्य वसुं राजानमन्तिकात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2086571, "chapter_id": 2840, "verse_number": "१२-३४५-१३", "content_sanskrit": "भो राजन्केन यष्टव्यमजेनाहोस्विदौषधैः।\nएतन्नः संशयं छिन्धि प्रमाणं नो भवान्मतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2086572, "chapter_id": 2840, "verse_number": "१२-३४५-१४", "content_sanskrit": "स तान्कृताञ्जलिर्भूत्वा परिपप्रच्छ वै वसुः।\nकस्य वै को मतः पक्षो ब्रूत सत्यं द्विजोत्तमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2086573, "chapter_id": 2840, "verse_number": "१२-३४५-१५x", "content_sanskrit": "ऋषय ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2086574, "chapter_id": 2840, "verse_number": "१२-३४५-१५", "content_sanskrit": "धान्यैर्यष्टव्यमित्येव पक्षोऽस्माकं नराधिप।\nदेवानां तु पशुः पक्षो मतो राजन्वदस्व नः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2086575, "chapter_id": 2840, "verse_number": "१२-३४५-१६x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2086576, "chapter_id": 2840, "verse_number": "१२-३४५-१६", "content_sanskrit": "देवानां तु मतं ज्ञात्वा वसुना पक्षसंश्रयात्।\nछागेनाजेन यष्टव्यमेवमुक्तं वचस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2086577, "chapter_id": 2840, "verse_number": "१२-३४५-१७", "content_sanskrit": "कुपितास्ते ततः सर्वे मुनयः सूर्यवर्चसः।\nऊचुर्वसुं विमानस्थं देवपक्षार्थवादिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2086578, "chapter_id": 2840, "verse_number": "१२-३४५-१८", "content_sanskrit": "सुरपक्षो गृहीतस्ते यस्मात्तस्माद्दिवः पत।\nअद्यप्रभृति ते राजन्नाकाशे विहता गतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2086579, "chapter_id": 2840, "verse_number": "१२-३४५-१९", "content_sanskrit": "अस्माच्छापाभिघातेन महीं भित्त्वा प्रवेक्ष्यसि।\n` विरुद्धं वेदसूत्राणामुक्तं यदि भवेन्नृप।\nवयं विरुद्धवचना यदि तत्र पतामहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2086580, "chapter_id": 2840, "verse_number": "१२-३४५-२०", "content_sanskrit": "ततस्तस्मिन्मुहूर्तेऽथ राजोपरिचरस्तदा।\nअधो वै संबभूवाशु भूमेर्विवरगो नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2086581, "chapter_id": 2840, "verse_number": "१२-३४५-२१", "content_sanskrit": "स्मृतिस्त्वेवं न विजहौ तदा नारायणाज्ञया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2086582, "chapter_id": 2840, "verse_number": "१२-३४५-२२", "content_sanskrit": "देवास्तु सहिताः सर्वे वमोः शापविमोक्षणम्।\nचिन्तयामासुरव्यग्राः सुकृतं हि नृपस्य तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2086583, "chapter_id": 2840, "verse_number": "१२-३४५-२३", "content_sanskrit": "अनेनास्मत्कृते राज्ञा शापः प्राप्तो महात्मना।\nअस्य प्रतिप्रियं कार्यं सहितैर्नो दिवौकसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2086584, "chapter_id": 2840, "verse_number": "१२-३४५-२४", "content_sanskrit": "इति बुद्ध्या व्यवस्याशु गत्वा निश्चयमीश्वराः।\nऊचुः संहृष्टमनसो राजोपरिचरं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2086585, "chapter_id": 2840, "verse_number": "१२-३४५-२५", "content_sanskrit": "ब्रह्मण्य देवभक्तस्त्वं सुरासुरगुरुर्हरिः।\nकामं स तव तुष्टात्मा कुर्याच्छापविभोक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2086586, "chapter_id": 2840, "verse_number": "१२-३४५-२६", "content_sanskrit": "मानना तु द्विजातीनां कर्तव्या वै महात्मनाम्।\nअवश्यं तपसा तेषां फलितव्यं नृपोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2086587, "chapter_id": 2840, "verse_number": "१२-३४५-२७", "content_sanskrit": "यतस्त्वं सहसा भ्रष्ट आकाशान्मेदिनीतलम्।\n`विरुद्धं वेदसूत्राणां न वक्तव्यं हितार्थिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2086588, "chapter_id": 2840, "verse_number": "१२-३४५-२८", "content_sanskrit": "अस्मत्पक्षनिमित्तेन व्यसनं प्राप्तमीदृशम्।\nएकं त्वनुग्रहं तुभ्यं दद्मो वै नृप्रसत्तम।\nयावत्त्वं शापदोषेण कालमासिप्यसेऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2086589, "chapter_id": 2840, "verse_number": "१२-३४५-२९", "content_sanskrit": "भूमेर्विवरगो भूत्वा तावत्त्वं कालमाप्स्यसि।\nयज्ञेषु सुहुतां विप्रैर्वसोर्धारां समाहितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2086590, "chapter_id": 2840, "verse_number": "१२-३४५-३०", "content_sanskrit": "प्राप्स्यसेऽस्मदनुध्यानान्मा च त्वां ग्लानिराविशेत्।\nन क्षुत्पिपासे राजेन्द्र भूमेश्छिद्रे भविष्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2086591, "chapter_id": 2840, "verse_number": "१२-३४५-३१", "content_sanskrit": "वसोर्धारामिपीतत्वात्तेजसाऽऽप्यायितेन च।\nस देवोऽस्मद्वरात्प्रीतो ब्रह्मलोकं हि नेष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2086592, "chapter_id": 2840, "verse_number": "१२-३४५-३२", "content_sanskrit": "एवं दत्त्वा वरं राज्ञे सर्वे ते च दिवौकसः।\nऋतुं समाप्य पिष्टेन मुनीनां वचनात्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2086593, "chapter_id": 2840, "verse_number": "१२-३४५-३३", "content_sanskrit": "गताः धमवनं देवा ऋषगश्च तपोधनाः।\n`गृहीत्वा दक्षिणां सर्वे गतः स्वानाश्रमान्पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2086594, "chapter_id": 2840, "verse_number": "१२-३४५-३४", "content_sanskrit": "वसुं विचिन्त्य शक्रश्च प्रविनेशामरावतीम्।\nवसुर्विवरगस्तत्र व्यलीकस्य फलं गुरोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2086595, "chapter_id": 2840, "verse_number": "१२-३४५-३५", "content_sanskrit": "चक्रे वसुस्ततः पूजां विष्वक्सेनाय भारत।\nजप्यं जगौ च सततं नारायणमुखोद्गवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2086596, "chapter_id": 2840, "verse_number": "१२-३४५-३६", "content_sanskrit": "तत्रापि पञ्चभिर्यज्ञैः पञ्चकालानरिंदम्।\nअयजद्धरिं सुरपतिं भूमेर्विवरगोऽपि सन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2086597, "chapter_id": 2840, "verse_number": "१२-३४५-३७", "content_sanskrit": "ततोऽस्य तुष्टो भगवान्भक्त्या नारायणो हरिः।\nअनन्यभक्तस्य सतस्तत्परस्य जितात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2086598, "chapter_id": 2840, "verse_number": "१२-३४५-३८", "content_sanskrit": "वरदो भगवान्विष्णुः समीपस्थं द्विजोत्तमम्।\nगरुत्मन्तं महावेगमावभाषेऽप्सितं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2086599, "chapter_id": 2840, "verse_number": "१२-३४५-३९", "content_sanskrit": "द्विजोत्तम महाभाग पश्यतां वचनान्मम।\nसम्राड्राजा वसुर्नाम धर्मात्मा संशितव्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2086600, "chapter_id": 2840, "verse_number": "१२-३४५-४०", "content_sanskrit": "ब्राह्मणानां प्रकोपेन प्रविष्टो वसुधातलम्।\nमानितास्ते तु विप्रेन्द्रास्त्वं तु गच्छ द्विजोत्तम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2086601, "chapter_id": 2840, "verse_number": "१२-३४५-४१", "content_sanskrit": "भूमेर्विवरसंगुप्तं गरुडेह ममाज्ञया।\nअधश्चरं नृपश्रेष्ठं खेचरं कुरु माचिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2086602, "chapter_id": 2840, "verse_number": "१२-३४५-४२", "content_sanskrit": "गरुत्मानथ विक्षिप्य पक्षौ मारुतवेगवान्।\nविवेश विवरं भूमेर्यत्रास्ते वाग्यतो वसुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2086603, "chapter_id": 2840, "verse_number": "१२-३४५-४३", "content_sanskrit": "तत एनं समुत्क्षिप्य सहसा विनतासुतः।\nउत्पपात नभस्तूर्णं तत्र चैनममुञ्चत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2086604, "chapter_id": 2840, "verse_number": "१२-३४५-४४", "content_sanskrit": "अस्मिन्मुहुर्ते संजज्ञे राजोपरिचरः पुनः।\nसशरीरो गतश्चैव ब्रह्मलोकं नृपोत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2086605, "chapter_id": 2840, "verse_number": "१२-३४५-४५", "content_sanskrit": "एवं तेनापि कौन्तेय वाग्दोषाद्देवताज्ञया।\nप्राप्ता गतिरधस्तात्तु द्विजशापान्महात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2086606, "chapter_id": 2840, "verse_number": "१२-३४५-४६", "content_sanskrit": "केवलं पुरुषस्तेन सेवितो हरिरीश्वरः।\nततः शीघ्रं जहौ शापं ब्रह्मलोकमवाप च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2086607, "chapter_id": 2840, "verse_number": "१२-३४५-४७x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2086608, "chapter_id": 2840, "verse_number": "१२-३४५-४७", "content_sanskrit": "एतत्ते सर्वमाख्यातं संभूता मानवा यथा।\nनारदोऽपि यथा श्वेतं द्वीपं स गतवानृषिः।\nतत्ते सर्वं प्रवक्ष्यामि शृणुष्वैकमना नृप॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2086609, "chapter_id": 2840, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि पञ्चचत्वारिंशदधिकत्रिशततमोऽध्यायः॥ ३४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}]