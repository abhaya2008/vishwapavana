[{"id": 2014637, "chapter_id": 1304, "verse_number": "२-४५-१", "content_sanskrit": "भीष्म उवाच॥\nप्रादुर्भावसहस्राणि समतीतान्यनेकशः।\nयथाशक्ति तु वक्ष्यामि शृणु तान्कुरुनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2014638, "chapter_id": 1304, "verse_number": "२-४५-२", "content_sanskrit": "पुरा कमलनाभस्य स्वपतः सागराम्भसि।\nपुष्करे यत्र सम्भूता देवा ऋषिगणैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2014639, "chapter_id": 1304, "verse_number": "२-४५-३", "content_sanskrit": "एष पौष्करिको नाम प्रादुर्भावः प्रकीर्तितः।\nपुराणैः कथ्यते यत्र वेदश्रुतिसमाहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2014640, "chapter_id": 1304, "verse_number": "२-४५-४", "content_sanskrit": "वाराहस्तु श्रुतिसुखः प्रादुर्भावो महात्मनः।\nयत्र विष्णुः सुरश्रेष्ठो वाराहं रूपमास्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2014641, "chapter_id": 1304, "verse_number": "२-४५-५", "content_sanskrit": "उज्जहार महीं तोयात्सशैलवनकाननाम्।\nवेदपादो यूपदंष्ट्रः क्रतुर्दन्तश्चितीमुखः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2014642, "chapter_id": 1304, "verse_number": "२-४५-६", "content_sanskrit": "अग्निजिह्वो दर्भरोमा ब्रह्मशीर्षो महातपाः।\nअहोरात्रेक्षणो दिव्यो वेदाङ्गः श्रुतिभूषणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2014643, "chapter_id": 1304, "verse_number": "२-४५-७", "content_sanskrit": "आज्यनासः स्रुवं तुण्डं सामघोषस्वनो महान्।\nधर्मसत्यमयः श्रीमान्कर्मविक्रमसत्कृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2014644, "chapter_id": 1304, "verse_number": "२-४५-८", "content_sanskrit": "प्रायश्चित्तमुखो धीरः पशुजानुर्महावृषः।\nऔद्गात्रहोमलिङ्गोऽसौ पशुबीजमहौषधिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2014645, "chapter_id": 1304, "verse_number": "२-४५-९", "content_sanskrit": "बाह्यन्तरात्मा मन्त्रास्थिविकृतः सौम्यदर्शनः।\nवेदिस्कन्धो हविर्गन्धो हव्यकव्याभिवेगवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2014646, "chapter_id": 1304, "verse_number": "२-४५-१०", "content_sanskrit": "प्राग्वंशकायो द्युतिमान्नानादीक्षाभिरूर्जितः।\nदक्षिणाहृदयो योगी महाशास्त्रमयो महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2014647, "chapter_id": 1304, "verse_number": "२-४५-११", "content_sanskrit": "उपाकर्मोष्ठरुचकः प्रावर्ग्यावर्तभूषणः।\nशालापत्नीसहायो वै मणिशृङ्गसमुच्छ्रितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2014648, "chapter_id": 1304, "verse_number": "२-४५-१२", "content_sanskrit": "एवं यज्ञवराहो वै भूत्वा विष्णुः सनातनः।\nमहीं सागरपर्यन्तां सशैलवनकाननाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2014649, "chapter_id": 1304, "verse_number": "२-४५-१३", "content_sanskrit": "एकार्णवजले भ्रष्टामेकार्णवगतः प्रभुः।\nमज्जन्तीं सलिले तस्मिन्स्वदेवीं पृथिवीं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2014650, "chapter_id": 1304, "verse_number": "२-४५-१४", "content_sanskrit": "उज्जहार विषाणेन मार्गण्डेयस्य पश्यतः।\nशृङ्गेण यः समुद्धृत्य लोकानां हितकाम्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2014651, "chapter_id": 1304, "verse_number": "२-४५-१५", "content_sanskrit": "सहस्रशीर्षो देवेशो निर्ममे जगतीं प्रभुः।\nएवं यज्ञवराहेण भूतभव्यभात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2014652, "chapter_id": 1304, "verse_number": "२-४५-१६", "content_sanskrit": "उद्धृता पृथिवी देवी पूज्या वै सागराम्बरा।\nनिहता दानवाः सर्वे देवदेवेन विष्णुना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2014653, "chapter_id": 1304, "verse_number": "२-४५-१७", "content_sanskrit": "वाराहः कथितो ह्येष नारसिंहमतो शृणु।\nयत्र भूत्वा मृगेन्द्रेण हिरण्यकशिपुर्हतः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2014654, "chapter_id": 1304, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि अर्घाहरणपर्वणि पञ्चचत्वारिंशोऽध्यायः॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]