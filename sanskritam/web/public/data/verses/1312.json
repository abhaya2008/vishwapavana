[{"id": 2014963, "chapter_id": 1312, "verse_number": "२-५३-१", "content_sanskrit": "भीष्ण उवाच।\nततः कदचिद्गोविन्दो ज्येष्ठं सङ्कर्षणं विना।\nचचार तद्वनं रम्यं सुस्वरूपो वराननः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2014964, "chapter_id": 1312, "verse_number": "२-५३-२", "content_sanskrit": "काकपक्षधरः श्रीमाञ्छ्यामः पद्मनिभेक्षणः।\nश्रीवत्सेनोरसा युक्तः शशाङ्क इव लक्ष्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2014965, "chapter_id": 1312, "verse_number": "२-५३-३", "content_sanskrit": "रज्जुयज्ञोपवीती स पीताम्बरधरो युवा।\nश्वेतचन्द्रनलिप्राङ्गो नीलकुञ्चितमूर्धजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2014966, "chapter_id": 1312, "verse_number": "२-५३-४", "content_sanskrit": "राजता बर्हिपत्रेण मन्दमारुतकम्पिना।\nक्वचिद्गायन्क्वञ्चित्क्रीडन्क्वचिन्नृत्यन्क्वचिद्धसन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2014967, "chapter_id": 1312, "verse_number": "२-५३-५", "content_sanskrit": "गोपवेणुं सुमधुरं कामं तदपि वादयन्।\nप्रह्लादनार्थं च गवां क क्वचिद्वनगतो युवा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2014968, "chapter_id": 1312, "verse_number": "२-५३-६", "content_sanskrit": "गोकुले मेघकाले तु चचार द्युतिमान्प्रभुः।\nबहुरम्येषु देशेषु वनस्य वनराजिपु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2014969, "chapter_id": 1312, "verse_number": "२-५३-७", "content_sanskrit": "तासु कृष्णो मुदा युक्तः क्रीडयन्भरतर्षभ।\nस कदाचिद्वने तस्मिन्गोभिः सह परिव्रजन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2014970, "chapter_id": 1312, "verse_number": "२-५३-८", "content_sanskrit": "भाण्डीरं नाम दृष्ट्वाऽथ न्यग्रोधं केशवो महान्।\nतच्छायायां मतिं चक्रे निवासाय तदा प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2014971, "chapter_id": 1312, "verse_number": "२-५३-९", "content_sanskrit": "स तत्र वयसा तुल्यैर्बत्सपालैस्तदाऽनघ।\nरेमे स दिवसं कृष्णः पुरा स्वर्गगतो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2014972, "chapter_id": 1312, "verse_number": "२-५३-१०", "content_sanskrit": "तं क्रीडमानं गोपालाः कृष्णं भाण्डीरवासिनः।\nरमयन्ति स्म बहवो मान्यैः क्रीडनकैस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2014973, "chapter_id": 1312, "verse_number": "२-५३-११", "content_sanskrit": "अन्ये स्म परिगायन्ति गोपा मुदितमानसाः।\nगोपालकृष्णमेवान्ये गायन्ति स्म वनप्रियाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2014974, "chapter_id": 1312, "verse_number": "२-५३-१२", "content_sanskrit": "तेषां सङ्गायतामेव वादयामास केशवः।\nपर्णवाद्यान्तरे वेणुं तुम्बवीणां च तत्र वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2014975, "chapter_id": 1312, "verse_number": "२-५३-१३", "content_sanskrit": "एवं क्रीडान्तरैः कृष्णो गोपालैर्विजहार सः।\nतेन बालेन कौन्तेय कृतं लोकहितं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2014976, "chapter_id": 1312, "verse_number": "२-५३-१४", "content_sanskrit": "पश्यतां सर्वभूतानां वासुदेवेन भारत।\nह्रदे निपातता तत्र क्रीडितं नागमूर्धनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2014977, "chapter_id": 1312, "verse_number": "२-५३-१५", "content_sanskrit": "शासयित्वा तु कालीयं सर्वलोकस्य पश्यतः।\nविजहार ततः कृष्णो बलेदवसहायवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2014978, "chapter_id": 1312, "verse_number": "२-५३-१६", "content_sanskrit": "धेनुको दारुणो राजन्दैत्यो रासभविग्रहः।\nतदा तालवने राजन्बलदेवेन वै हतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2014979, "chapter_id": 1312, "verse_number": "२-५३-१७", "content_sanskrit": "ततः कदाचित्कौन्तेय रामकृष्णौ वनं गतौ।\nचारयन्तौ प्रवृद्धानि गोधनानि शुभाननौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2014980, "chapter_id": 1312, "verse_number": "२-५३-१८", "content_sanskrit": "विहरन्तौ मुदा युक्तौ वीक्षमाणौ वनानि वै।\nश्वेलयन्तौ प्रगायन्तौ विचिन्वन्तौ च पादपान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2014981, "chapter_id": 1312, "verse_number": "२-५३-१९", "content_sanskrit": "नामभिर्व्याहरन्तौ च वत्सान्गाश्च परन्तपौ।\nचेरतुर्लोकसिद्धाभिः क्रीडाभिरपराजितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2014982, "chapter_id": 1312, "verse_number": "२-५३-२०", "content_sanskrit": "तौ देवौ मानुषीं दीक्षां वहन्तौ सुरपूजितौ।\nतज्जातिगुणयुक्ताभिः क्रीडाभिश्चेरतुर्वनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2014983, "chapter_id": 1312, "verse_number": "२-५३-२१", "content_sanskrit": "एवं बाल्येऽपि गोपालैः क्रीडाभिश्च विजह्रतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2014984, "chapter_id": 1312, "verse_number": "२-५३-२२", "content_sanskrit": "ततः कृष्णो महातेजास्तदा गत्वा तु गोव्रजम्।\nगिरियज्ञं तमेवैष प्रवृत्तं गोपदारकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2014985, "chapter_id": 1312, "verse_number": "२-५३-२३", "content_sanskrit": "बुभुजे पायसं शौरिरीश्वरः सर्वभूतकृत्।\nतं दृष्ट्वा गोपकाः सर्वे कृष्णमेव समर्चयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2014986, "chapter_id": 1312, "verse_number": "२-५३-२४", "content_sanskrit": "पूज्यमानस्तदा देवैर्दिव्यं वपुरधारयत्।\nधृतो गोवर्धनो नाम सप्ताहं पर्वतो धृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2014987, "chapter_id": 1312, "verse_number": "२-५३-२५", "content_sanskrit": "शिशुना वासुदेवेन गवार्थमरिमर्दन।\nक्रीडमानस्तदा कृष्णः कृतवान्कर्म दुष्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2014988, "chapter_id": 1312, "verse_number": "२-५३-२६", "content_sanskrit": "तदद्भुतमतीवासीत्सर्वलोकस्य भारत।\nदेवदेवः क्षितं गत्वा कृष्णं नत्वा मुदान्वितः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2014989, "chapter_id": 1312, "verse_number": "२-५३-२७", "content_sanskrit": "गोविन्द इति तं ह्युक्त्वा ह्यभ्यषिञ्चत्पुरन्दरः।\nइत्युक्त्वाश्लिष्य गोविन्दं पुरुहूतोभ्ययाद्दिवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2014990, "chapter_id": 1312, "verse_number": "२-५३-२८", "content_sanskrit": "अथारिष्ट इति ख्यातं दैत्यं वृषभविग्रहम्।\nजघान तरसा कृष्णः पशूनां हितकाम्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2014991, "chapter_id": 1312, "verse_number": "२-५३-२९", "content_sanskrit": "केशिनामा ततो दैत्यो राजंस्तुरगविग्रहः।\nतथा वनगतं पार्थ गजायुतबलं हयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2014992, "chapter_id": 1312, "verse_number": "२-५३-३०", "content_sanskrit": "कराम्भोरुहवज्रेण जघान मधुसूदनः।\nअथ मल्लं तु चाणूरं निजघान महाऽसुरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2014993, "chapter_id": 1312, "verse_number": "२-५३-३१", "content_sanskrit": "सुदामानममित्रघ्न सर्वसैन्यपुरस्कृतम्।\nबालरूपेण गोविन्दो निजघान च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2014994, "chapter_id": 1312, "verse_number": "२-५३-३२", "content_sanskrit": "बलदेवेन चायत्नात्समाजे मुष्टिको हतः।\nताडितश्च सहामात्यः कंसः कृष्णेन भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2014995, "chapter_id": 1312, "verse_number": "२-५३-३३", "content_sanskrit": "हत्वा कंसममित्रघ्नः सर्वेषां पश्यतां तदा।\nअभिषिच्योग्रसेनं तं पित्रोः पादमवन्दत।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2014996, "chapter_id": 1312, "verse_number": "२-५३-३४", "content_sanskrit": "एवमादीनि कर्माणि कृतवान्वै जनार्दनः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2014997, "chapter_id": 1312, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि अर्घाहरणपर्वणि त्रिपञ्चाशोऽध्यायः॥५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]