[{"id": 2042361, "chapter_id": 1945, "verse_number": "५-१९०-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2042362, "chapter_id": 1945, "verse_number": "५-१९०-१", "content_sanskrit": "एवमुक्तस्य दूतेन द्रुपदस्य तदा नृप।\nचोरस्येव गृहीतस्य न प्रावर्तत भारती ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2042363, "chapter_id": 1945, "verse_number": "५-१९०-२", "content_sanskrit": "स यत्नमकरोत्तीव्रं संबन्धिन्युनुमानने ।\nदूतैर्मधुरसंभाषैर्न तदस्तीति संदिशन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2042364, "chapter_id": 1945, "verse_number": "५-१९०-३", "content_sanskrit": "स राजा भूय एवाथ ज्ञात्वा तत्त्वमथागमत् ।\nकन्येति पाञ्चालसुतां त्वरमाणो विनिर्ययौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2042365, "chapter_id": 1945, "verse_number": "५-१९०-४", "content_sanskrit": "ततः संप्रेषकयामास मित्रांणाममितौजसाम् ।\nदुहितुर्विप्रलम्भं तं धात्रीणां वचनात्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2042366, "chapter_id": 1945, "verse_number": "५-१९०-५", "content_sanskrit": "ततः समुदयं कृत्वा बलानां राजसत्तमः ।\nअभियाने मतिं चक्रे द्रुपदं प्रति भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2042367, "chapter_id": 1945, "verse_number": "५-१९०-६", "content_sanskrit": "ततः संमन्त्रयामास मन्त्रिभिः स महीपतिः ।\nहिरण्यवर्मा राजेन्द्र पाञ्चाल्यं पार्थिवं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2042368, "chapter_id": 1945, "verse_number": "५-१९०-७", "content_sanskrit": "तत्र वै निश्चितं तेषामभूद्राज्ञां महात्मनाम् ।\nतथ्यं भवति चेदेतत्कन्या राजञ्शिखण्डिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2042369, "chapter_id": 1945, "verse_number": "५-१९०-८", "content_sanskrit": "बद्ध्वा पाञ्चालराजानमानयिष्यामहे गृहम् ।\nअन्यं राजानमाधाय पाञ्चालेषु नरेश्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2042370, "chapter_id": 1945, "verse_number": "५-१९०-९", "content_sanskrit": "घातयिष्याम नृपतिं पाञ्चालं सशिखण्डिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2042371, "chapter_id": 1945, "verse_number": "५-१९०-१०", "content_sanskrit": "स तदा द्रुतमाज्ञाय पुनर्दूतान्नराधिपः।\nप्रास्थापयत्पार्षतया निहन्मीति स्थिरो भव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2042372, "chapter_id": 1945, "verse_number": "५-१९०-११x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2042373, "chapter_id": 1945, "verse_number": "५-१९०-११", "content_sanskrit": "स हि प्रकृत्या वै भीतः किल्बिषी च नराधिपः ।\nभयं तीव्रमनुप्राप्तो द्रुपदः पृथिवीपतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2042374, "chapter_id": 1945, "verse_number": "५-१९०-१२", "content_sanskrit": "विसृज्य दूतान्दाशार्णे द्रुपदः शोकमूर्च्छितः ।\nसमेत्य भार्यां रहिते वाक्यमाह नराधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2042375, "chapter_id": 1945, "verse_number": "५-१९०-१३", "content_sanskrit": "भयेन महताऽऽविष्टो हृदि शोकेन चाहतः ।\nपाञ्चालराजो दयितां मातरं वै शिखण्डिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2042376, "chapter_id": 1945, "verse_number": "५-१९०-१४", "content_sanskrit": "अभियास्यति मां कोपात्संबन्धी सुमहाबलः ।\nहिरण्यवर्मा नृपतिः कर्षमाणो वरूथिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2042377, "chapter_id": 1945, "verse_number": "५-१९०-१५", "content_sanskrit": "किमिदानीं करिष्यावो मूढौ कन्यामिमां प्रति।\nशिखण्डी किल पुत्रस्ते कन्येति परिशङ्कितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2042378, "chapter_id": 1945, "verse_number": "५-१९०-१६", "content_sanskrit": "इति संचिन्त्य यत्नेन समित्रः सबलानुगः ।\nवञ्चितोऽस्मीति मन्वानो मां किलोद्धर्तुमिच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2042379, "chapter_id": 1945, "verse_number": "५-१९०-१७", "content_sanskrit": "किमत्र तथ्यं सुश्रोणि मिथ्या किं ब्रूहि शोभने ।\nश्रुत्वा त्वत्तः शुभं वाक्यं संविधास्याम्यहं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2042380, "chapter_id": 1945, "verse_number": "५-१९०-१८", "content_sanskrit": "अहं हि संशयप्राप्तो बाला चेयं शिखण्डिनी ।\nत्वं च राज्ञि महत्कृच्छ्रं संप्राप्ता वरवर्णिनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2042381, "chapter_id": 1945, "verse_number": "५-१९०-१९", "content_sanskrit": "सा त्वं सर्वविमोक्षाय तत्त्वमाख्याहि पृच्छतः।\nतथा विदध्यां सुश्रोणि कृत्यमाशु शुचिस्मिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2042382, "chapter_id": 1945, "verse_number": "५-१९०-२०", "content_sanskrit": "शिखण्डिनि च मा भैस्त्वं विधास्ये तत्र तत्त्वतः ।\nकृपयाहं वरारोहे वञ्चितः पुत्रधर्मतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2042383, "chapter_id": 1945, "verse_number": "५-१९०-२१", "content_sanskrit": "मया दाशार्णको राजा वञ्चितः स महीपतिः ।\nतदाचक्ष्व महाभागे विधास्ये तत्र यद्धितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2042384, "chapter_id": 1945, "verse_number": "५-१९०-२२", "content_sanskrit": "जनाता ह नरेन्द्रेण ख्यापनार्थं परस्य वै ।\nप्रकाशं चोदिता देवी प्रत्युवाच महीपतिम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2042385, "chapter_id": 1945, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि अम्बोपाख्यानपर्वणि नवत्यधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]