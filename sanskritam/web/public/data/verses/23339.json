[{"id": 7003339000, "chapter_id": 23339, "verse_number": "२-३४-१", "content_sanskrit": "सनत्कुमार उवाच  ।\nगणेशेशं प्रवक्ष्यामि दानं पूर्वोक्तमंडपे ।\nसंपूज्य देवदेवेसं लोकपालसमावृतम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003339001, "chapter_id": 23339, "verse_number": "२-३४-२", "content_sanskrit": "विश्वेश्वरान्यथाशास्त्रं सर्वाभरणसंयुतान् ।\nदशनिष्केण वै कृत्वा संपूज्य च विधानतः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003339002, "chapter_id": 23339, "verse_number": "२-३४-३", "content_sanskrit": "अष्टदक्ष्वष्टकुंडेषु पूर्ववद्धोममाचरेत् ।\nपंचावरणमार्गेण पारंपर्यक्रमेण च ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003339003, "chapter_id": 23339, "verse_number": "२-३४-४", "content_sanskrit": "सप्तविप्रान्समभ्यर्च्य कन्यामेकां तथोत्तरे ।\nदापयेत्सर्वमंत्राणि स्वैःस्वैर्मंत्रैरनुक्रमात् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003339004, "chapter_id": 23339, "verse_number": "२-३४-५", "content_sanskrit": "दत्त्वैवं सर्वपापेभ्यो मुच्यते नात्र संशयः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}]