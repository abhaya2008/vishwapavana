[{"id": 5000122000, "chapter_id": 9122, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अयोध्याकाण्डे पञ्चचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000122001, "chapter_id": 9122, "verse_number": "२-४५-१", "content_sanskrit": "अनुरक्ता महात्मानं रामं सत्यपराक्रमम्।\nअनुजग्मुः प्रयान्तं तं वनवासाय मानवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000122002, "chapter_id": 9122, "verse_number": "२-४५-२", "content_sanskrit": "निवर्तितेऽतीव बलात् सुहृद्धर्मेण राजनि।\nनैव ते संन्यवर्तन्त रामस्यानुगता रथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000122003, "chapter_id": 9122, "verse_number": "२-४५-३", "content_sanskrit": "अयोध्यानिलयानां हि पुरुषाणां महायशाः।\nबभूव गुणसम्पन्नः पूर्णचन्द्र इव प्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000122004, "chapter_id": 9122, "verse_number": "२-४५-४", "content_sanskrit": "स याच्यमानः काकुत्स्थस्ताभिः प्रकृतिभिस्तदा।\nकुर्वाणः पितरं सत्यं वनमेवान्वपद्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000122005, "chapter_id": 9122, "verse_number": "२-४५-५", "content_sanskrit": "अवेक्षमाणः सस्नेहं चक्षुषा प्रपिबन्निव।\nउवाच रामः सस्नेहं ताः प्रजाः स्वाः प्रजा इव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000122006, "chapter_id": 9122, "verse_number": "२-४५-६", "content_sanskrit": "या प्रीतिर्बहुमानश्च मय्ययोध्यानिवासिनाम्।\nमत्प्रियार्थं विशेषेण भरते सा विधीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000122007, "chapter_id": 9122, "verse_number": "२-४५-७", "content_sanskrit": "स हि कल्याणचारित्रः कैकेय्यानन्दवर्धनः।\nकरिष्यति यथावद् वः प्रियाणि च हितानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000122008, "chapter_id": 9122, "verse_number": "२-४५-८", "content_sanskrit": "ज्ञानवृद्धो वयोबालो मृदुर्वीर्यगुणान्वितः।\nअनुरूपः स वो भर्ता भविष्यति भयापहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000122009, "chapter_id": 9122, "verse_number": "२-४५-९", "content_sanskrit": "स हि राजगुणैर्युक्तो युवराजः समीक्षितः।\nअपि चापि मया शिष्टैः कार्यं वो भर्तृशासनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000122010, "chapter_id": 9122, "verse_number": "२-४५-१०", "content_sanskrit": "न संतप्येद् यथा चासौ वनवासं गते मयि।\nमहाराजस्तथा कार्यो मम प्रियचिकीर्षया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000122011, "chapter_id": 9122, "verse_number": "२-४५-११", "content_sanskrit": "यथा यथा दाशरथिर्धर्ममेवाश्रितो भवेत्।\nतथा तथा प्रकृतयो रामं पतिमकामयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000122012, "chapter_id": 9122, "verse_number": "२-४५-१२", "content_sanskrit": "बाष्पेण पिहितं दीनं रामः सौमित्रिणा सह।\nचकर्षेव गुणैर्बद्धं जनं पुरनिवासिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000122013, "chapter_id": 9122, "verse_number": "२-४५-१३", "content_sanskrit": "ते द्विजास्त्रिविधं वृद्धा ज्ञानेन वयसौजसा।\nवयःप्रकम्पशिरसो दूरादूचुरिदं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000122014, "chapter_id": 9122, "verse_number": "२-४५-१४", "content_sanskrit": "वहन्तो जवना रामं भो भो जात्यास्तुरंगमाः।\nनिवर्तध्वं न गन्तव्यं हिता भवत भर्तरि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000122015, "chapter_id": 9122, "verse_number": "२-४५-१५", "content_sanskrit": "कर्णवन्ति हि भूतानि विशेषेण तुरङ्गमाः।\nयूयं तस्मान्निवर्तध्वं याचनां प्रतिवेदिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000122016, "chapter_id": 9122, "verse_number": "२-४५-१६", "content_sanskrit": "धर्मतः स विशुद्धात्मा वीरः शुभदृढव्रतः।\nउपवाह्यस्तु वो भर्ता नापवाह्यः पुराद् वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000122017, "chapter_id": 9122, "verse_number": "२-४५-१७", "content_sanskrit": "एवमार्तप्रलापांस्तान् वृद्धान् प्रलपतो द्विजान्।\nअवेक्ष्य सहसा रामो रथादवततार ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000122018, "chapter_id": 9122, "verse_number": "२-४५-१८", "content_sanskrit": "पद‍्भ्यामेव जगामाथ ससीतः सहलक्ष्मणः।\nसंनिकृष्टपदन्यासो रामो वनपरायणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000122019, "chapter_id": 9122, "verse_number": "२-४५-१९", "content_sanskrit": "द्विजातीन् हि पदातींस्तान् रामश्चारित्रवत्सलः।\nन शशाक घृणाचक्षुः परिमोक्तुं रथेन सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000122020, "chapter_id": 9122, "verse_number": "२-४५-२०", "content_sanskrit": "गच्छन्तमेव तं दृष्ट्वा रामं सम्भ्रान्तमानसाः।\nऊचुः परमसंतप्ता रामं वाक्यमिदं द्विजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000122021, "chapter_id": 9122, "verse_number": "२-४५-२१", "content_sanskrit": "ब्राह्मण्यं कृत्स्नमेतत् त्वां ब्रह्मण्यमनुगच्छति।\nद्विजस्कन्धाधिरूढास्त्वामग्नयोऽप्यनुयान्त्वमी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000122022, "chapter_id": 9122, "verse_number": "२-४५-२२", "content_sanskrit": "वाजपेयसमुत्थानि च्छत्राण्येतानि पश्य नः।\nपृष्ठतोऽनुप्रयातानि मेघानिव जलात्यये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000122023, "chapter_id": 9122, "verse_number": "२-४५-२३", "content_sanskrit": "अनवाप्तातपत्रस्य रश्मिसंतापितस्य ते।\nएभिश्छायां करिष्यामः स्वैश्छत्रैर्वाजपेयकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000122024, "chapter_id": 9122, "verse_number": "२-४५-२४", "content_sanskrit": "या हि नः सततं बुद्धिर्वेदमन्त्रानुसारिणी।\nत्वत्कृते सा कृता वत्स वनवासानुसारिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000122025, "chapter_id": 9122, "verse_number": "२-४५-२५", "content_sanskrit": "हृदयेष्ववतिष्ठन्ते वेदा ये नः परं धनम्।\nवत्स्यन्त्यपि गृहेष्वेव दाराश्चारित्ररक्षिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000122026, "chapter_id": 9122, "verse_number": "२-४५-२६", "content_sanskrit": "पुनर्न निश्चयः कार्यस्त्वद्‍गतौ सुकृता मतिः।\nत्वयि धर्मव्यपेक्षे तु किं स्याद् धर्मपथे स्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000122027, "chapter_id": 9122, "verse_number": "२-४५-२७", "content_sanskrit": "याचितो नो निवर्तस्व हंसशुक्लशिरोरुहैः।\nशिरोभिर्निभृताचार महीपतनपांसुलैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000122028, "chapter_id": 9122, "verse_number": "२-४५-२८", "content_sanskrit": "बहूनां वितता यज्ञा द्विजानां य इहागताः।\nतेषां समाप्तिरायत्ता तव वत्स निवर्तने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000122029, "chapter_id": 9122, "verse_number": "२-४५-२९", "content_sanskrit": "भक्तिमन्तीह भूतानि जङ्गमाजङ्गमानि च।\nयाचमानेषु तेषु त्वं भक्तिं भक्तेषु दर्शय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000122030, "chapter_id": 9122, "verse_number": "२-४५-३०", "content_sanskrit": "अनुगन्तुमशक्तास्त्वां मूलैरुद्धतवेगिनः।\nउन्नता वायुवेगेन विक्रोशन्तीव पादपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000122031, "chapter_id": 9122, "verse_number": "२-४५-३१", "content_sanskrit": "निश्चेष्टाहारसंचारा वृक्षैकस्थाननिश्चिताः।\nपक्षिणोऽपि प्रयाचन्ते सर्वभूतानुकम्पिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000122032, "chapter_id": 9122, "verse_number": "२-४५-३२", "content_sanskrit": "एवं विक्रोशतां तेषां द्विजातीनां निवर्तने।\nददृशे तमसा तत्र वारयन्तीव राघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000122033, "chapter_id": 9122, "verse_number": "२-४५-३३", "content_sanskrit": "ततः सुमन्त्रोऽपि रथाद् विमुच्य\nश्रान्तान् हयान् सम्परिवर्त्य शीघ्रम्।\nपीतोदकांस्तोयपरिप्लुताङ्गा-\nनचारयद् वै तमसाविदूरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000122034, "chapter_id": 9122, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अयोध्याकाण्डे पञ्चचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]