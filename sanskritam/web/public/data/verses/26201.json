[{"id": 7006201000, "chapter_id": 26201, "verse_number": "२-२९-१", "content_sanskrit": "वसिष्ठ उवाच जमदग्निस्ततो भूयस्तमुवाच रुषान्वितः ।\nब्रह्मस्वं नापहर्त्तव्यं पुरुषेण विजानता ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006201001, "chapter_id": 26201, "verse_number": "२-२९-२", "content_sanskrit": "प्रसह्य गां मे हरतो पापमाप्स्यसि दुर्मते ।\nआयुर्जाने परिक्षीणं न चेदेतत्करिष्यति ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006201002, "chapter_id": 26201, "verse_number": "२-२९-३", "content_sanskrit": "बलादिच्छसि यन्नेतुं तन्न शक्यं कथञ्चन ।\nस्वयं वा यदि सायुच्येद्विनशिष्यति पार्थिवः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006201003, "chapter_id": 26201, "verse_number": "२-२९-४", "content_sanskrit": "दानं विनापहरणं ब्राह्मणानां तपस्विनाम् ।\nशतायुषोर्ऽजुनादन्यः को न्विच्छति जिजीविषुः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006201004, "chapter_id": 26201, "verse_number": "२-२९-५", "content_sanskrit": "इत्युक्तस्तेन संक्रुद्धः स मन्त्रीकालचोदितः ।\nबद्ध्वा तां गां दृढैः पाशैर्विचकर्ष बलान्वितः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006201005, "chapter_id": 26201, "verse_number": "२-२९-६", "content_sanskrit": "जमदग्निरथ क्रोधाद्भाविकर्मप्रचोदितः ।\nरुरोध तं यथाशक्ति विकर्षन्तं पायस्विनीम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006201006, "chapter_id": 26201, "verse_number": "२-२९-७", "content_sanskrit": "जीवन्न प्रतिमोक्ष्यामि गामेनामित्यमर्षितः ।\nजग्राह सुदृढं कण्ठे वाहुभ्यां तां महामुनिः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006201007, "chapter_id": 26201, "verse_number": "२-२९-८", "content_sanskrit": "ततः क्रोधपरीतात्मा चन्द्रगुप्तोऽतिनिर्घृणः ।\nउत्सारयध्वमित्येनमादिदेश स्वसैनिकान् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006201008, "chapter_id": 26201, "verse_number": "२-२९-९", "content_sanskrit": "अप्रधृष्यतमं लोके तमृषिं राजकिङ्कराः ।\nभर्त्राज्ञया प्रसह्यैनं परिवव्रुः समन्ततः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006201009, "chapter_id": 26201, "verse_number": "२-२९-१०", "content_sanskrit": "दण्डैः कशाभिर्लकुडैर्विनिघ्नन्तश्च मुष्टिभिः ।\nते समुत्सारयन् धेनोः सुदूरतरमन्तिकात् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006201010, "chapter_id": 26201, "verse_number": "२-२९-११", "content_sanskrit": "स तथा हन्यमोनोऽपि व्यथितःक्षमयान्वितः ।\nन चुक्रोधाक्रोधनत्वं सतो हि परमं धनम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006201011, "chapter_id": 26201, "verse_number": "२-२९-१२", "content_sanskrit": "स च शक्तः स्वतपसा संहर्त्तुमपि रक्षितुम् ।\nजगत्सर्वं क्षयं तस्य चिन्तयन्न प्रचुक्रुधे ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006201012, "chapter_id": 26201, "verse_number": "२-२९-१३", "content_sanskrit": "सपूर्वं क्रोधनोऽत्यर्थं मातुरर्थे प्रसादितः ।\nरामेणाभूत्ततो नित्यं शान्त एव महातपाः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006201013, "chapter_id": 26201, "verse_number": "२-२९-१४", "content_sanskrit": "स हन्यमानः सुभृशं चूर्णिताङ्गास्थिवन्धनः ।\nनिपपात महातेजा धरण्यां गतचेतनः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006201014, "chapter_id": 26201, "verse_number": "२-२९-१५", "content_sanskrit": "तस्मिन्मुनौ निपतिते स दुरात्मा विशङ्कितः ।\nकिङ्करानादिशच्छीघ्रं धेनोरानयने बलात् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006201015, "chapter_id": 26201, "verse_number": "२-२९-१६", "content_sanskrit": "ततः सवत्सां ता धेनुं बद्ध्वा पाशैर्दृढैर्नृपः ।\nकशाभिरभिहन्यन्त चकृषुश्च निनीषया ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006201016, "chapter_id": 26201, "verse_number": "२-२९-१७", "content_sanskrit": "आकृष्यमाणा बहुभिः कशाभिर्लगुडैरपि ।\nहन्यमाना भृशं तैश्च चुक्रुधे च पयस्विनी ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006201017, "chapter_id": 26201, "verse_number": "२-२९-१८", "content_sanskrit": "व्यथितातिकशापातैः क्रोधेन महातान्विता ।\nआकृष्य पाशान् सुदृढान् कृत्वात्मानममोचयत् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006201018, "chapter_id": 26201, "verse_number": "२-२९-१९", "content_sanskrit": "विमुक्तपाशवन्धासा सर्वतोऽभिवृता बलैः ।\nहुंहारवं प्रकुर्वाणा सर्वतोऽह्यपतद्रुषा ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006201019, "chapter_id": 26201, "verse_number": "२-२९-२०", "content_sanskrit": "विषाणखुरपुच्छाग्रैरभिहत्य समन्ततः ।\nराजमन्त्रिबलं सर्वं व्यद्रावयदमर्षिता ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006201020, "chapter_id": 26201, "verse_number": "२-२९-२१", "content_sanskrit": "विद्राव्य किङ्करान्सर्वांस्तरसैव पयस्विनी ।\nपश्यतां सर्वभूतानां गगनं प्रत्यपद्यत ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006201021, "chapter_id": 26201, "verse_number": "२-२९-२२", "content_sanskrit": "ततस्ते भग्नसंकल्पाः संभग्नक्षतविग्रहाः ।\nप्रसह्य बद्ध्वा तद्वत्सं जग्मुरेवातिनिर्घृणाः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006201022, "chapter_id": 26201, "verse_number": "२-२९-२३", "content_sanskrit": "पयस्विनीं विना वत्सं गृहीत्वा किङ्करैः सह ।\nस पापस्तरसा राज्ञः सन्निधिं समुपागमत् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006201023, "chapter_id": 26201, "verse_number": "२-२९-२४", "content_sanskrit": "गत्वा समीपं नृपतेः प्रणम्यास्मै प्रशंसकृत् ।\nतद्व्रत्तान्तमशेषेण व्याचचक्षे ससाध्वसः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]