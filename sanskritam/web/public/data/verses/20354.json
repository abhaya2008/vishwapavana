[{"id": 7000354000, "chapter_id": 20354, "verse_number": "२-२६-१", "content_sanskrit": "सूत उवाच ।\nतं पुत्रं निहतं श्रुत्वा सा दितिर्दुःखपीडिता ।\nपुत्रशोकेन तेनैव संदग्धा द्विजसत्तमाः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000354001, "chapter_id": 20354, "verse_number": "२-२६-२", "content_sanskrit": "पुनरूचे महात्मानं कश्यपं मुनिपुंगवम् ।\nइंद्रस्यापि सुदुष्टस्य वधार्थं द्विजसत्तम॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000354002, "chapter_id": 20354, "verse_number": "२-२६-३", "content_sanskrit": "ब्रह्मतेजोमयं तीव्रं दुःसहं सर्वदैवतैः ।\nपुत्रैकं दीयतां कांत सुप्रियाहं यदा विभो॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000354003, "chapter_id": 20354, "verse_number": "२-२६-४", "content_sanskrit": "कश्यप उवाच ।\nनिहतौ बलवृत्रौ च मम पुत्रौ महाबलौ ।\nअघमाश्रित्य देवेन इंद्रेणापि दुरात्मना॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000354004, "chapter_id": 20354, "verse_number": "२-२६-५", "content_sanskrit": "तस्यैव च वधार्थाय पुत्रमेकं ददाम्यहम् ।\nवर्षाणां तु शतैकं त्वं शुचिर्भव यशस्विनि॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000354005, "chapter_id": 20354, "verse_number": "२-२६-६", "content_sanskrit": "एवमुक्त्वा स योगींद्रो हस्तं शिरसि वै तदा ।\nदत्त्वादित्या सहैवासौ गतो मेरुं तपोवनम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000354006, "chapter_id": 20354, "verse_number": "२-२६-७", "content_sanskrit": "तपस्तताप सा देवी तपोवननिवासिनी ।\nशुचिष्मती सदा भूत्वा पुत्रार्था द्विजसत्तम॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000354007, "chapter_id": 20354, "verse_number": "२-२६-८", "content_sanskrit": "ततो देवः सहस्राक्षो ज्ञात्वा उद्यममेव च ।\nदित्याश्चैव महाभाग अंतरप्रेक्षकोऽभवत्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000354008, "chapter_id": 20354, "verse_number": "२-२६-९", "content_sanskrit": "पंचविंशाब्दिको भूत्वा देवराड्दैवतोपमः ।\nब्राह्मणस्य च रूपेण तस्याश्चांतिकमागतः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000354009, "chapter_id": 20354, "verse_number": "२-२६-१०", "content_sanskrit": "स तां प्रणम्य धर्मात्मा मातरं तपसान्विताम् ।\nतयोक्तस्तु सहस्राक्षो भवान्को द्विजसत्तम॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000354010, "chapter_id": 20354, "verse_number": "२-२६-११", "content_sanskrit": "तामुवाच सहस्राक्षः पुत्रोऽहं तव शोभने ।\nब्राह्मणो वेदविद्वांश्च धर्मं जानामि भामिनि॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000354011, "chapter_id": 20354, "verse_number": "२-२६-१२", "content_sanskrit": "तपसस्तव साहाय्यं करिष्ये नात्र संशयः ।\nशुश्रूषति स तां देवीं मातरं तपसान्विताम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000354012, "chapter_id": 20354, "verse_number": "२-२६-१३", "content_sanskrit": "तमिंद्रं सा न जानाति आगतं दुष्टकारिणम् ।\nधर्मपुत्रं विजानाति शुश्रूषंतं दिने दिने॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000354013, "chapter_id": 20354, "verse_number": "२-२६-१४", "content_sanskrit": "अंगं संवाहयेद्देव्याः पादौ प्रक्षालयेत्ततः ।\nपत्रं मूलं फलं तत्र वल्कलाजिनमेव च॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000354014, "chapter_id": 20354, "verse_number": "२-२६-१५", "content_sanskrit": "ददात्येवं स धर्मात्मा तस्यै दित्यै सदैव हि ।\nभक्त्या संतोषिता तस्य संतुष्टा तमभाषत॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000354015, "chapter_id": 20354, "verse_number": "२-२६-१६", "content_sanskrit": "पुत्रे जाते महापुण्ये इंद्रे च निहते सति ।\nकुरु राज्यं महाभाग पुत्रेण मम दैवकम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000354016, "chapter_id": 20354, "verse_number": "२-२६-१७", "content_sanskrit": "एवमस्तु महाभागे ते प्रसादाद्भविष्यति ।\nतस्याश्चैवांतरं प्रेप्सुरभवत्पाकशासनः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000354017, "chapter_id": 20354, "verse_number": "२-२६-१८", "content_sanskrit": "ऊने वर्षशते चास्या ददर्शांतरमच्युतः ।\nअकृत्वा पादयोः शौचं दितिः शयनमाविशत्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000354018, "chapter_id": 20354, "verse_number": "२-२६-१९", "content_sanskrit": "शय्यांते सा शिरः कृत्वा मुक्तकेशातिविह्वला ।\nनिद्रामाहारयामास तस्याः कुक्षिं प्रविश्य ह॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000354019, "chapter_id": 20354, "verse_number": "२-२६-२०", "content_sanskrit": "वज्रपाणिस्ततो गर्भं सप्तधा तं न्यकृंतत ।\nवज्रेण तीक्ष्णधारेण रुरोद उदरे स्थितः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000354020, "chapter_id": 20354, "verse_number": "२-२६-२१", "content_sanskrit": "स गर्भस्तत्र विप्रेंद्रा इंद्रहस्तगतेन वै ।\nरोदमानं महागर्भं तमुवाच पुनः पुनः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000354021, "chapter_id": 20354, "verse_number": "२-२६-२२", "content_sanskrit": "शतक्रतुर्महातेजा मा रोदीरित्यभाषत ।\nसप्तधा कृतवाञ्छक्रस्तं गर्भं दितिजं पुनः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000354022, "chapter_id": 20354, "verse_number": "२-२६-२३", "content_sanskrit": "एकैकं सप्तधा च्छित्त्वा रुदमानं स देवराट् ।\nएवं वै मरुतो जातास्ते तु देवा महौजसः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000354023, "chapter_id": 20354, "verse_number": "२-२६-२४", "content_sanskrit": "यथा इंद्रेण ते प्रोक्ता बभूवुर्नामभिस्ततः ।\nअतिवीर्य महाकायास्तीव्र तेजः पराक्रमाः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000354024, "chapter_id": 20354, "verse_number": "२-२६-२५", "content_sanskrit": "एकोना वै बभूवुस्ते पंचाशन्मरुतस्ततः ।\nमरुतो नाम ते ख्याता इंद्रमेव समाश्रिताः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000354025, "chapter_id": 20354, "verse_number": "२-२६-२६", "content_sanskrit": "भूतानामेव सर्वेषां रोचयंति गणं महत् ।\nनिकायेषु निकायेषु हरिः प्रादात्प्रजापतिः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000354026, "chapter_id": 20354, "verse_number": "२-२६-२७", "content_sanskrit": "क्रमशस्तानि राज्यानि पृथुपूर्वाणि तानि वै ।\nस देवः पुरुषः कृष्णः सर्वव्यापी जगद्गुरुः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000354027, "chapter_id": 20354, "verse_number": "२-२६-२८", "content_sanskrit": "तपोजिष्णुर्महातेजाः सर्व एकः प्रजापतिः ।\nपर्जन्यः पावकः पुण्यः सर्वात्मा सर्व एव हि॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000354028, "chapter_id": 20354, "verse_number": "२-२६-२९", "content_sanskrit": "तस्य सर्वमिदं पुण्यं जगत्स्थावरजंगमम् ।\nभूतसर्गमिमं सम्यग्जानतो द्विजसत्तम॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000354029, "chapter_id": 20354, "verse_number": "२-२६-३०", "content_sanskrit": "नावृत्तिभयमस्तीह परलोकभयं कुतः ।\nइमां सृष्टिं महापुण्यां सर्वपापहरां शुभाम्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000354030, "chapter_id": 20354, "verse_number": "२-२६-३१", "content_sanskrit": "यः शृणोति नरो भक्त्या सर्वपापैः प्रमुच्यते ।\nस हि धन्यश्च पुण्यश्च स हि सत्यसमन्वितः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000354031, "chapter_id": 20354, "verse_number": "२-२६-३२", "content_sanskrit": "यः शृणोति इमां सृष्टिं स याति परमां गतिम् ।\nसर्वपापविशुद्धात्मा विष्णुलोकं स गच्छति॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]