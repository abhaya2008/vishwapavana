[{"id": 7004022000, "chapter_id": 24022, "verse_number": "३-२-३३-१", "content_sanskrit": "राम उवाच ।\nजीर्णोद्धारं करिष्यामि श्रीमातुर्वचनादहम् ।\nआज्ञा प्रदीयतां मह्यं यथादानं ददामि वः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004022001, "chapter_id": 24022, "verse_number": "३-२-३३-२", "content_sanskrit": "पात्रे दानं प्रदातव्यं कृत्वा यज्ञवरं द्विजाः ।\nनापात्रे दीयते किंचिद्दत्तं न तु सुखावहम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004022002, "chapter_id": 24022, "verse_number": "३-२-३३-३", "content_sanskrit": "सुपात्रं नौरिव सदा तारयेदुभयोरपि ।\nलोहपिंडोपमं ज्ञेयं कुपात्रं भञ्जनात्मकम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004022003, "chapter_id": 24022, "verse_number": "३-२-३३-४", "content_sanskrit": "जातिमात्रेण विप्रत्वं जायते न हि भो द्विजाः ।\nक्रिया बलवती लोके क्रियाहीने कुतः फलम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004022004, "chapter_id": 24022, "verse_number": "३-२-३३-५", "content_sanskrit": "पूज्यास्तस्मात्पूज्यतमा ब्राह्मणाः सत्यवादिनः ।\nयज्ञकार्ये समुत्पन्ने कृपां कुर्वंतु सर्वदा॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004022005, "chapter_id": 24022, "verse_number": "३-२-३३-६", "content_sanskrit": "ब्रह्मोवाच ।\nततस्तु मिलिताः सर्वे विमृश्य च परस्परम् ।\nकेचिदूचुस्तदा रामं वयं शिलोंछजीविकाः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004022006, "chapter_id": 24022, "verse_number": "३-२-३३-७", "content_sanskrit": "संतोषं परमास्थाय स्थिता धर्मपरायणाः ।\nप्रतिग्रहप्रयोगेण न चास्माकं प्रयोजनम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004022007, "chapter_id": 24022, "verse_number": "३-२-३३-८", "content_sanskrit": "दशसूनासमश्चक्री दशचक्रिसमो ध्वजः ।\nदशध्वजसमा वेश्या दशवेश्यासमो नृपः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004022008, "chapter_id": 24022, "verse_number": "३-२-३३-९", "content_sanskrit": "राजप्रतिग्रहो घोरो राम सत्यं न संशयः ।\nतस्माद्वयं न चेच्छामः प्रतिग्रहं भया वहम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004022009, "chapter_id": 24022, "verse_number": "३-२-३३-१०", "content_sanskrit": "एकाहिका द्विजाः केचित्केचित्स्वामृतवृत्तयः ।\nकुम्भीधान्या द्विजाः केचित्केचित्षट्कर्मतत्पराः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004022010, "chapter_id": 24022, "verse_number": "३-२-३३-११", "content_sanskrit": "त्रिमूर्तिस्थापिताः सर्वे पृथग्भावाः पृथग्गुणाः ।\nकेचिदेवं वदंति स्म त्रिमूर्त्याज्ञां विना वयम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004022011, "chapter_id": 24022, "verse_number": "३-२-३३-१२", "content_sanskrit": "प्रतिग्रहस्य स्वीकारं कथं कुर्याम ह द्विजाः ।\nन तांबूलं स्त्रीकृतं नो ह्यद्मो दानेन भषितम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004022012, "chapter_id": 24022, "verse_number": "३-२-३३-१३", "content_sanskrit": "विमृश्य स तदा रामो वसिष्ठेन महात्मना ।\nब्रह्मविष्णुशिवादीनां सस्मार गुरुणा सह ॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004022013, "chapter_id": 24022, "verse_number": "३-२-३३-१४", "content_sanskrit": "स्मृतमात्रास्ततो देवास्तं देशं समुपागमन् ।\nसूर्यकोटिप्रतीकाशीवमानावलिसंवृताः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004022014, "chapter_id": 24022, "verse_number": "३-२-३३-१५", "content_sanskrit": "रामेण ते यथान्यायं पूजिताः परया मुदा ।\nनिवेदितं तु तत्सर्वं रामेणातिसुबुद्धिना॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004022015, "chapter_id": 24022, "verse_number": "३-२-३३-१६", "content_sanskrit": "अधिदेव्या वचनतो जीर्णोद्धारं करोम्यहम् ।\nधर्मारण्ये हरिक्षेत्रे धर्मकूपसमीपतः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004022016, "chapter_id": 24022, "verse_number": "३-२-३३-१७", "content_sanskrit": "ततस्ते वाडवाः सर्वे त्रिमूर्त्तीः प्रणिपत्य च ।\nमहता हर्षवृंदेन पूर्णाः प्राप्तमनोरथाः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004022017, "chapter_id": 24022, "verse_number": "३-२-३३-१८", "content_sanskrit": "अर्घ्यपाद्यादिविधिना श्रद्धया तानपूजयन् ।\nक्षणं विश्रम्य ते देवा ब्रह्मविष्णुशिवादयः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004022018, "chapter_id": 24022, "verse_number": "३-२-३३-१९", "content_sanskrit": "ऊचू रामं महाशक्तिं विनयात्कृतसंपुटम्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004022019, "chapter_id": 24022, "verse_number": "३-२-३३-२०", "content_sanskrit": "देवा ऊचुः ।\nदेवद्रुहस्त्वया राम ये हता रावणादयः ।\nतेन तुष्टा वयं सर्वे भानुवंशविभूषण॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004022020, "chapter_id": 24022, "verse_number": "३-२-३३-२१", "content_sanskrit": "उद्धरस्व महास्थानं महतीं कीर्तिमाप्नुहि॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004022021, "chapter_id": 24022, "verse_number": "३-२-३३-२२", "content_sanskrit": "लब्ध्वा स तेषामाज्ञां तु प्रीतो दशरथात्मजः ।\nजीर्णोद्धारेऽनंतगुणं फलमिच्छन्निलापतिः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004022022, "chapter_id": 24022, "verse_number": "३-२-३३-२३", "content_sanskrit": "देवानां संनिधौ तेषां कार्यारंभमथाकरोत् ।\nस्थंडिलं पूर्वतः कृत्वा महागिरि समं शुभम्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004022023, "chapter_id": 24022, "verse_number": "३-२-३३-२४", "content_sanskrit": "तस्योपरि बहिःशाला गृहशाला ह्यनेकशः ।\nब्रह्मशालाश्च बहुशो निर्ममे शोभनाकृतीः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004022024, "chapter_id": 24022, "verse_number": "३-२-३३-२५", "content_sanskrit": "निधानैश्च समायुक्ता गृहोपकरणै र्वृताः ।\nसुवर्णकोटिसंपूर्णा रसवस्त्रादिपूरिताः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004022025, "chapter_id": 24022, "verse_number": "३-२-३३-२६", "content_sanskrit": "धनधान्यसमृद्धाश्च सर्वधातुयुतास्तथा ।\nएतत्सर्वं कारयित्वा ब्राह्मणेभ्यस्तदा ददौ॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004022026, "chapter_id": 24022, "verse_number": "३-२-३३-२७", "content_sanskrit": "एकैकशो दशदश ददौ धेनूः पयस्विनीः ।\nचत्वारिंशच्छतं प्रादाद्ग्रामाणां चतुराधिकम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004022027, "chapter_id": 24022, "verse_number": "३-२-३३-२८", "content_sanskrit": "त्रैविद्यद्विजविप्रेभ्यो रामो दशरथात्मजः ।\nकाजेशेन त्रयेणैव स्थापिता द्विजसत्तमाः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004022028, "chapter_id": 24022, "verse_number": "३-२-३३-२९", "content_sanskrit": "तस्मात्त्रयीविद्य इति ख्यातिर्लोके बभूव ह ।\nएवंविधं द्विजेभ्यः स दत्त्वा दानं महाद्भुतम्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004022029, "chapter_id": 24022, "verse_number": "३-२-३३-३०", "content_sanskrit": "आत्मानं चापि मेने स कृतकृत्यं नरेश्वरः ।\nब्रह्मणा स्थापिताः पूर्वं विष्णुना शंकरेण ये॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004022030, "chapter_id": 24022, "verse_number": "३-२-३३-३१", "content_sanskrit": "ते पूजिता राघवेण जीर्णोद्धारे कृते सति ।\nषट्त्रिंशच्च सहस्राणि गोभुजा ये वणिग्वराः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004022031, "chapter_id": 24022, "verse_number": "३-२-३३-३२", "content_sanskrit": "शुश्रूषार्थं प्रदत्ता वै देवैर्हरिहरादिभिः ।\nसंतुष्टेन तु शर्वेण तेभ्यो दत्तं तु चेत नम्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004022032, "chapter_id": 24022, "verse_number": "३-२-३३-३३", "content_sanskrit": "श्वेताश्वचामरौ दत्तौ खङ्गं दत्तं सुनिर्मलम् ।\nतदा प्रबोधितास्ते च द्विजशुश्रूषणाय वै॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004022033, "chapter_id": 24022, "verse_number": "३-२-३३-३४", "content_sanskrit": "विवाहादौ सदा भाव्यं चामरै मंगलं वरम् ।\nखङ्गं शुभं तदा धार्य्यं मम चिह्नं करे स्थितम्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004022034, "chapter_id": 24022, "verse_number": "३-२-३३-३५", "content_sanskrit": "गुरुपूजा सदा कार्या कुलदेव्याः पुनःपुनः ।\nवृद्ध्यागमेषु प्राप्तेषु वृद्धि दायकदक्षिणा॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004022035, "chapter_id": 24022, "verse_number": "३-२-३३-३६", "content_sanskrit": "एकादश्यां शनेर्वारे दानं देयं द्विजन्मने ।\nप्रदेयं बालवृद्धेभ्यो मम रामस्य शासनात्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004022036, "chapter_id": 24022, "verse_number": "३-२-३३-३७", "content_sanskrit": "मंडलेषु च ये शुद्धा वणिग्वृत्तिरताः पराः ।\nसपादलक्षास्ते दत्ता रामशासनपालकाः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004022037, "chapter_id": 24022, "verse_number": "३-२-३३-३८", "content_sanskrit": "मांडलीकास्तु ते ज्ञेया राजानो मंडलेश्वराः ।\nद्विज शुश्रूषणे दत्ता रामेण वणिजां वराः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004022038, "chapter_id": 24022, "verse_number": "३-२-३३-३९", "content_sanskrit": "चामरद्वितयं रामो दत्तवान्खड्गमेव च ।\nकुलस्य स्वामिनं सूर्यं प्रतिष्ठाविधिपूर्वकम्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004022039, "chapter_id": 24022, "verse_number": "३-२-३३-४०", "content_sanskrit": "ब्रह्माणं स्थापयामास चतुर्वेदसमन्वितम् ।\nश्रीमातरं महाशक्तिं शून्यस्वामिहरिं तथा॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004022040, "chapter_id": 24022, "verse_number": "३-२-३३-४१", "content_sanskrit": "विघ्नापध्वंसनार्थाय दक्षिणद्वारसंस्थितम् ।\nगणं संस्थापयामास तथान्याश्चैव देवताः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004022041, "chapter_id": 24022, "verse_number": "३-२-३३-४२", "content_sanskrit": "कारितास्तेन वीरेण प्रासादाः सप्तभूमिकाः ।\nयत्किं चित्कुरुते कार्यं शुभं मांगल्यरूपकम्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004022042, "chapter_id": 24022, "verse_number": "३-२-३३-४३", "content_sanskrit": "पुत्रे जाते जातके वान्नाशने मुंडनेऽपि वा ।\nलक्षहोमे कोटिहोमे तथा यज्ञक्रियासु च॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004022043, "chapter_id": 24022, "verse_number": "३-२-३३-४४", "content_sanskrit": "वास्तुपूजाग्रहशांत्योः प्राप्ते चैव महोत्सवे ।\nयत्किंचित्कुरुते दानं द्रव्यं वा धान्यमुत्तमम्॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004022044, "chapter_id": 24022, "verse_number": "३-२-३३-४५", "content_sanskrit": "वस्त्रं वा धेनवो नाथ हेम रूप्यं तथैव च ।\nविप्राणामथ शूद्राणां दीनानाथांधकेषु च॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004022045, "chapter_id": 24022, "verse_number": "३-२-३३-४६", "content_sanskrit": "प्रथमं बकुलार्कस्य श्रीमातुश्चैव मानवः ।\nभागं दद्याच्च निर्विघ्नकार्यसिद्ध्यै निरन्तरम्॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004022046, "chapter_id": 24022, "verse_number": "३-२-३३-४७", "content_sanskrit": "वचनं मे समुल्लंघ्य कुरुते योऽन्यथा नरः ।\nतस्य तत्कर्मणो विघ्नं भविष्यति न संशयः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004022047, "chapter_id": 24022, "verse_number": "३-२-३३-४८", "content_sanskrit": "एवमुक्त्वा ततो रामः प्रहृष्टेनांतरात्मना ।\nदेवानामथ वापीश्च प्राकारांस्तु सुशोभनान्॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004022048, "chapter_id": 24022, "verse_number": "३-२-३३-४९", "content_sanskrit": "दुर्गोपकरणैर्युक्तान्प्रतोलीश्च सुविस्तृताः ।\nनिर्ममे चैव कुंडानि सरांसि सरसीस्तथा॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004022049, "chapter_id": 24022, "verse_number": "३-२-३३-५०", "content_sanskrit": "धर्मवापीश्च कूपांश्च तथान्यान्देवनिर्मितान् ।\nएतत्सर्वं च विस्तार्य धर्मारण्ये मनोरमे॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004022050, "chapter_id": 24022, "verse_number": "३-२-३३-५१", "content_sanskrit": "ददौ त्रैविद्यमुख्येभ्यः श्रद्धया परया पुनः ।\nताम्रपट्टस्थितं रामशासनं लोपयेत्तु यः॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004022051, "chapter_id": 24022, "verse_number": "३-२-३३-५२", "content_sanskrit": "पूर्वजास्तस्य नरके पतंत्यग्रे न संततिः ।\nवायुपुत्रं समाहूय ततो रामोऽब्रवीद्वचः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004022052, "chapter_id": 24022, "verse_number": "३-२-३३-५३", "content_sanskrit": "वायुपुत्र महावीर तव पूजा भविष्यति ।\nअस्य क्षेत्रस्य रक्षायै त्वमत्र स्थितिमाचर॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004022053, "chapter_id": 24022, "verse_number": "३-२-३३-५४", "content_sanskrit": "आंजनेयस्तु तद्वाक्यं प्रणम्य शिरसादधौ ।\nजीर्णोद्धारं तदा कृत्वा कृतकृत्यो बभूव ह॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004022054, "chapter_id": 24022, "verse_number": "३-२-३३-५५", "content_sanskrit": "श्रीमातरं तदाभ्यर्च्य प्रसन्नेनांतरात्मना ।\nश्रीमातरं नमस्कृत्य तीर्थान्यन्यानि राघवः॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004022055, "chapter_id": 24022, "verse_number": "३-२-३३-५६", "content_sanskrit": "तेऽपि देवाः स्वकं स्थानं ययुर्बह्मपुरोगमाः॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004022056, "chapter_id": 24022, "verse_number": "३-२-३३-५७", "content_sanskrit": "दत्त्वाशिषं तु रामाय वांछितं ते भविष्यति ।\nरम्यं कृतं त्वया राम विप्राणां स्थापनादिकम्॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004022057, "chapter_id": 24022, "verse_number": "३-२-३३-५८", "content_sanskrit": "अस्माकमपि वात्सल्यं कृतं पुण्यवता त्वया ।\nइति स्तुवंतस्ते देवाः स्वानि स्थानानि भेजिरे॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}]