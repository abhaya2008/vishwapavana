[{"id": 5000414000, "chapter_id": 9414, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे सप्तमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000414001, "chapter_id": 9414, "verse_number": "६-७-१", "content_sanskrit": "इत्युक्ता राक्षसेन्द्रेण राक्षसास्ते महाबलाः।\nऊचुः प्राञ्जलयः सर्वे रावणं राक्षसेश्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000414002, "chapter_id": 9414, "verse_number": "६-७-२", "content_sanskrit": "द्विषत्पक्षमविज्ञाय नीतिबाह्यास्त्वबुद्धयः।\nराजन् परिघशक्त्यृष्टिशूलपट्टिशकुन्तलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000414003, "chapter_id": 9414, "verse_number": "६-७-३", "content_sanskrit": "सुमहन्नो बलं कस्माद् विषादं भजते भवान्।\nत्वया भोगवतीं गत्वा निर्जिताः पन्नगा युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000414004, "chapter_id": 9414, "verse_number": "६-७-४", "content_sanskrit": "कैलासशिखरावासी यक्षैर्बहुभिरावृतः।\nसुमहत्कदनं कृत्वा वश्यस्ते धनदः कृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000414005, "chapter_id": 9414, "verse_number": "६-७-५", "content_sanskrit": "स महेश्वरसख्येन श्लाघमानस्त्वया विभो।\nनिर्जितः समरे रोषाल्लोकपालो महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000414006, "chapter_id": 9414, "verse_number": "६-७-६", "content_sanskrit": "विनिपात्य च यक्षौघान् विक्षोभ्य विनिगृह्य च।\nत्वया कैलासशिखराद् विमानमिदमाहृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000414007, "chapter_id": 9414, "verse_number": "६-७-७", "content_sanskrit": "मयेन दानवेन्द्रेण त्वद्भयात् सख्यमिच्छता।\nदुहिता तव भार्यार्थे दत्ता राक्षसपुङ्गव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000414008, "chapter_id": 9414, "verse_number": "६-७-८", "content_sanskrit": "दानवेन्द्रो महाबाहो वीर्योत्सिक्तो दुरासदः।\nविगृह्य वशमानीतः कुम्भीनस्याः सुखावहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000414009, "chapter_id": 9414, "verse_number": "६-७-९", "content_sanskrit": "निर्जितास्ते महाबाहो नागा गत्वा रसातलम्।\nवासुकिस्तक्षकः शङ्खो जटी च वशमाहृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000414010, "chapter_id": 9414, "verse_number": "६-७-१०", "content_sanskrit": "अक्षया बलवन्तश्च शूरा लब्धवराः पुनः।\nत्वया संवत्सरं युद्‍ध्वा समरे दानवा विभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000414011, "chapter_id": 9414, "verse_number": "६-७-११", "content_sanskrit": "स्वबलं समुपाश्रित्य नीता वशमरिंदम।\nमायाश्चाधिगतास्तत्र बह्व्यो वै राक्षसाधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000414012, "chapter_id": 9414, "verse_number": "६-७-१२", "content_sanskrit": "शूराश्च बलवन्तश्च वरुणस्य सुता रणे।\nनिर्जितास्ते महाभाग चतुर्विधबलानुगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000414013, "chapter_id": 9414, "verse_number": "६-७-१३", "content_sanskrit": "मृत्युदण्डमहाग्राहं शाल्मलीद्रुममण्डितम्।\nकालपाशमहावीचिं यमकिंकरपन्नगम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000414014, "chapter_id": 9414, "verse_number": "६-७-१४", "content_sanskrit": "महाज्वरेण दुर्धर्षं यमलोकमहार्णवम्।\nअवगाह्य त्वया राजन् यमस्य बलसागरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000414015, "chapter_id": 9414, "verse_number": "६-७-१५", "content_sanskrit": "जयश्च विपुलः प्राप्तो मृत्युश्च प्रतिषेधितः।\nसुयुद्धेन च ते सर्वे लोकस्तत्र सुतोषिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000414016, "chapter_id": 9414, "verse_number": "६-७-१६", "content_sanskrit": "क्षत्रियैर्बहुभिर्वीरैः शक्रतुल्यपराक्रमैः।\nआसीद् वसुमती पूर्णा महद्भिरिव पादपैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000414017, "chapter_id": 9414, "verse_number": "६-७-१७", "content_sanskrit": "तेषां वीर्यगुणोत्साहैर्न समो राघवो रणे।\nप्रसह्य ते त्वया राजन् हताः समरदुर्जयाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000414018, "chapter_id": 9414, "verse_number": "६-७-१८", "content_sanskrit": "तिष्ठ वा किं महाराज श्रमेण तव वानरान्।\nअयमेको महाबाहुरिन्द्रजित् क्षपयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000414019, "chapter_id": 9414, "verse_number": "६-७-१९", "content_sanskrit": "अनेन च महाराज माहेश्वरमनुत्तमम्।\nइष्ट्वा यज्ञं वरो लब्धो लोके परमदुर्लभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000414020, "chapter_id": 9414, "verse_number": "६-७-२०", "content_sanskrit": "शक्तितोमरमीनं च विनिकीर्णान्त्रशैवलम्।\nगजकच्छपसम्बाधमश्वमण्डूकसंकुलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000414021, "chapter_id": 9414, "verse_number": "६-७-२१", "content_sanskrit": "रुद्रादित्यमहाग्राहं मरुद्वसुमहोरगम्।\nरथाश्वगजतोयौघं पदातिपुलिनं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000414022, "chapter_id": 9414, "verse_number": "६-७-२२", "content_sanskrit": "अनेन हि समासाद्य देवानां बलसागरम्।\nगृहीतो दैवतपतिर्लङ्कां चापि प्रवेशितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000414023, "chapter_id": 9414, "verse_number": "६-७-२३", "content_sanskrit": "पितामहनियोगाच्च मुक्तः शम्बरवृत्रहा।\nगतस्त्रिविष्टपं राजन् सर्वदेवनमस्कृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000414024, "chapter_id": 9414, "verse_number": "६-७-२४", "content_sanskrit": "तमेव त्वं महाराज विसृजेन्द्रजितं सुतम्।\nयावद् वानरसेनां तां सरामां नयति क्षयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000414025, "chapter_id": 9414, "verse_number": "६-७-२५", "content_sanskrit": "राजन्नापदयुक्तेयमागता प्राकृताज्जनात्।\nहृदि नैव त्वया कार्या त्वं वधिष्यसि राघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000414026, "chapter_id": 9414, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे सप्तमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]