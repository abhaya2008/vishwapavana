[{"id": 40022910, "chapter_id": 9414, "verse_number": "1", "content_sanskrit": "रामो बहून्यहान्येवं तद्गीतं परमं शुभम् । शुश्राव मुनिभिः सार्धं पार्थिवैः सह वानरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40022911, "chapter_id": 9414, "verse_number": "2", "content_sanskrit": "तस्मिन्गीते तु विज्ञाय सीतापुत्रौ कुशीलवौ । तस्याः परिषदो मध्ये रामो वचनमब्रवीत् । दूताञ्छुद्धसमाचारानाहूयात्ममनीषया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40022912, "chapter_id": 9414, "verse_number": "3", "content_sanskrit": "मद्वचो ब्रूत गच्छध्वमितो भगवतो ऽन्तिकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40022913, "chapter_id": 9414, "verse_number": "4", "content_sanskrit": "परिषदो मध्ये रामो वचनमब्रवीत् । यदि शुद्धसमाचारा यदि वा वीतकल्मषा । करोत्विहात्मनः शुद्धिमनुमान्य महामुनिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40022914, "chapter_id": 9414, "verse_number": "5", "content_sanskrit": "छन्दं मुनेश्च विज्ञाय सीतायाश्च मनोगतम् । प्रत्ययं दातुकामायास्ततः शंसत मे लघु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40022915, "chapter_id": 9414, "verse_number": "6", "content_sanskrit": "श्वः प्रभाते तु शपथं मैथिली जनकात्मजा । करोतु परिषन्मध्ये शोधनार्थं ममैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40022916, "chapter_id": 9414, "verse_number": "7", "content_sanskrit": "श्रुत्वा तु ऱागवस्यैतद्वचः परममद्भुतम् । दूताः सम्प्रययुर्बाटं यत्रास्ते मुनिपुङ्गवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40022917, "chapter_id": 9414, "verse_number": "8", "content_sanskrit": "ते प्रणम्य महात्मानं ज्वलन्तममितप्रभम् । ऊचुस्ते रामवाक्यानि मृदूनि मधुराणि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40022918, "chapter_id": 9414, "verse_number": "9", "content_sanskrit": "तेषां तद्व्याहृतं श्रुत्वा रामस्य च मनोगतम् । विज्ञाय सुमहातेजा मुनिर्वाक्यमथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40022919, "chapter_id": 9414, "verse_number": "10", "content_sanskrit": "एवं भवतु भद्रं वो यथा वदति राघवः । तथा करिष्यते सीता दैवतं हि पतिः स्त्रियाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40022920, "chapter_id": 9414, "verse_number": "11", "content_sanskrit": "तथोक्ता मुनिना सर्वे राजदूता महौजसम् । प्रत्येत्य राघवं क्षिप्रं मुनिवाक्यं बभाषिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40022921, "chapter_id": 9414, "verse_number": "12", "content_sanskrit": "ततः प्रहृष्टः काकुत्स्थः श्रुत्वा वाक्यं महात्मनः । ऋषींस्तत्र समेतांश्च राज्ञश्चैवाभ्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40022922, "chapter_id": 9414, "verse_number": "13", "content_sanskrit": "भगवन्तः सशिष्या वै सानुगाश्च नराधिपाः । पश्यन्तु सीताशपथं यश्चैवान्यो ऽपि काङ्क्षते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40022923, "chapter_id": 9414, "verse_number": "14", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा राघवस्य महात्मनः । सर्वेषामृषिमुख्यानां साधुवादो महानभूत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40022924, "chapter_id": 9414, "verse_number": "15", "content_sanskrit": "राजानश्च महात्मानः प्रशंसन्ति स्म राघवम् । उपपन्नं नरश्रेष्ठ त्वय्येव भुवि नान्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40022925, "chapter_id": 9414, "verse_number": "16", "content_sanskrit": "एवं विनिश्चयं कृत्वा श्वोभूत इति राघवः । विसर्जयामास तदा सर्वांस्ताञ्छत्रुसूदनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40022926, "chapter_id": 9414, "verse_number": "17", "content_sanskrit": "इति सम्प्रविचार्य राजसिंहः श्वोभूते शपथस्य निश्चयं वै । विससर्ज मुनीन्नृपांश्च सर्वान्स महात्मा महतो महानुभावः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]