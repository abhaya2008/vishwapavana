[{"id": 2139778, "chapter_id": 4018, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2139779, "chapter_id": 4018, "verse_number": "१", "content_sanskrit": "तस्मिन् काले समागम्य सर्वे तस्यात्र बान्धवाः ।\nरुरुदुः कीचकं दृष्ट्वा परिवार्य समन्ततः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2139780, "chapter_id": 4018, "verse_number": "२", "content_sanskrit": "सर्वे संहृष्टरोमाणः सन्त्रस्ताः प्रेक्ष्य कीचकम् ।\nतथा सर्वाङ्गसम्भुग्नं कूर्मं स्थल इवोद्धृतम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2139781, "chapter_id": 4018, "verse_number": "३", "content_sanskrit": "तं हतं भीमसेनेन महेन्द्रेणेव दानवम् ।\nकीचकं बलसम्मत्तं दुर्धर्षं येन केनचित्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2139782, "chapter_id": 4018, "verse_number": "४", "content_sanskrit": "गन्धर्वेण हतं श्रुत्वा कीचकं पुरुषर्षभम् ।\nसंस्कारयितुमिच्छन्तो बहिर्नेतुं प्रचक्रमुः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2139783, "chapter_id": 4018, "verse_number": "५", "content_sanskrit": "अपश्यन्नन्तिके कृष्णां सूतपुत्राः समागताः ।\nअदूरादनवद्याङ्गीं स्तम्भमालम्ब्य तिष्ठतीम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2139784, "chapter_id": 4018, "verse_number": "६", "content_sanskrit": "समवेतेषु सर्वेषु तानुवाचोपकीचकः ।\nहसन्निव तदाऽमर्षान्निर्दहन्निव चक्षुषा\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2139785, "chapter_id": 4018, "verse_number": "७", "content_sanskrit": "हन्यतां शीघ्रमसती यत्कृते कीचको हतः ।\nअथवा नैव हन्तव्या दह्यतां कामिना सह\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2139786, "chapter_id": 4018, "verse_number": "८", "content_sanskrit": "मृतस्यापि प्रियं कार्यं सूतपुत्रस्य सर्वथा ।\nइयं हि दुष्टचारित्रा मम भ्रातुरमित्रिणी\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2139787, "chapter_id": 4018, "verse_number": "९", "content_sanskrit": "यत्कृते मरणं प्राप्तो नेयं जीवितुमर्हति ।\nसहेयं दह्यतां सूता आपृच्छ्य च जनाधिपम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2139788, "chapter_id": 4018, "verse_number": "१०", "content_sanskrit": "हतस्यापि च गन्धर्वैः कीचकस्य प्रियं भवेत्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2139789, "chapter_id": 4018, "verse_number": "११", "content_sanskrit": "ततो विराटमासाद्य सूताः प्राञ्जलयोऽब्रुवन्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2139790, "chapter_id": 4018, "verse_number": "१२", "content_sanskrit": "कीचकोऽयं हतः शेते गन्धर्वैः कामरूपिभिः ।\nसैरन्ध्य्रा सहितं रात्रौ तं दहेम सहानया\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2139791, "chapter_id": 4018, "verse_number": "१३", "content_sanskrit": "मानिताः स्मस्त्वया राजन् तदनुज्ञातुमर्हसि\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2139792, "chapter_id": 4018, "verse_number": "१४", "content_sanskrit": "पराक्रमं तु सूतानां ज्ञात्वा राजाऽन्वमोदत ।\nसैरन्ध्य्राः सूतपुत्रेण सह दाहं जनाधिपः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2139793, "chapter_id": 4018, "verse_number": "१५", "content_sanskrit": "ततस्ते समनुज्ञाताः सर्वे तत्रास्य बान्धवाः ।\nरुरुदुः कीचकं दृष्ट्वा परिवार्याभितः स्थिताः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2139794, "chapter_id": 4018, "verse_number": "१६", "content_sanskrit": "तां समासाद्य वित्रस्तां कृष्णां कमललोचनाम् ।\nमोमुह्यमानां ते तत्र जगृहुः कीचका भृशम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2139795, "chapter_id": 4018, "verse_number": "", "content_sanskrit": "आरोप्य कृष्णामथ कीचकेन निबध्य केशेषु च पादयोश्च ।\nते चापि सूता वचनैरवोचन् उद्दिश्य सर्वे ह्यभिवीक्ष्य चैनाम्\t १७", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2139796, "chapter_id": 4018, "verse_number": "१८", "content_sanskrit": "यस्याः कृतेऽयं निहतो महात्मा \tतस्मात् तु सा कीचकमार्गमेतु ।\nअवार्यसत्वेन सहाद्य गन्त्री गतासुना सुन्दरि कीचकेन\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2139797, "chapter_id": 4018, "verse_number": "१९", "content_sanskrit": "साऽशेत कृष्णा शयने निबद्धा मनस्विनी चैव यशस्विनी च ।\nनिवेपमाना विवशा हि दुष्टैः तमेव पर्यङ्कतळे शुभाङ्गी\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2139798, "chapter_id": 4018, "verse_number": "२०", "content_sanskrit": "ततस्तु तां समारोप्य निबध्य च सुमध्यमाम् ।\nजग्मुरुद्यम्य ते सर्वे श्मशानाभिमुखास्तदा\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2139799, "chapter_id": 4018, "verse_number": "२१", "content_sanskrit": "ह्रियमाणाऽथ सुश्रोणी सूतपुत्रैरनिन्दिता ।\nप्राक्रोशन्नाथमिच्छन्ती कृष्णा नाथवती सती\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2139800, "chapter_id": 4018, "verse_number": "२२", "content_sanskrit": "जयो जयेशो विजयो जयत्सेनो जयद्बलः ।\nते मे वाचं विजानन्तु सूतपुत्रा नयन्ति माम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2139801, "chapter_id": 4018, "verse_number": "२३", "content_sanskrit": "येषां दुन्दुभिनिर्घोषो ज्याघोषः श्रूयते महान् ।\nते मे वाचं विजानन्तु सूतपुत्रा नयन्ति माम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2139802, "chapter_id": 4018, "verse_number": "२४", "content_sanskrit": "येषां ज्यातळनिर्घोषो विष्फूर्जितमिवाशनेः ।\nअश्रूयत महान् युद्धे भीमघोषस्तरस्विनाम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2139803, "chapter_id": 4018, "verse_number": "२५", "content_sanskrit": "रथघोषश्च बलवान् गन्धर्वाणां तरस्विनाम् ।\nते मे वाचं विजानन्तु सूतपुत्रा नयन्ति माम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2139804, "chapter_id": 4018, "verse_number": "२६", "content_sanskrit": "येषां वीर्यमतुल्यं तु शक्रस्येव बलं यशः ।\nराजसिंहा इवाग्र्यास्ते मां जानन्तु सुदुःखिताम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2139805, "chapter_id": 4018, "verse_number": "२७", "content_sanskrit": "स तस्याः कृपणा वाचः कृष्णायाः परिदेवितम् ।\nश्रुत्वैवाभ्युत्थितो भीमः शयनादविचारयन्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2139806, "chapter_id": 4018, "verse_number": "२८", "content_sanskrit": "अहं सैरन्ध्रि ते वाचः शृणोमि तव भाषितम् ।\nतस्मात् ते सूतपुत्रेभ्यो भयं जातु न विद्यते\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2139807, "chapter_id": 4018, "verse_number": "२९", "content_sanskrit": "इत्युक्त्वा स महाबाहुर्विजजृम्भे जिघांसया\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2139808, "chapter_id": 4018, "verse_number": "३०", "content_sanskrit": "ततः स व्यायतं बद्ध्वा वस्त्रं च परिवेष्ट्य च ।\nअद्वारेणाभ्यवस्कन्द्य निर्जगाम बहिस्तदा\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2139809, "chapter_id": 4018, "verse_number": "३१", "content_sanskrit": "चितासमीपं गत्वा तु तत्रापश्यन्महाबलः ।\nताळमात्रं महास्कन्धं संशुष्कं वै वनस्पतिम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2139810, "chapter_id": 4018, "verse_number": "३२", "content_sanskrit": "तं नागवदुपक्रम्य बाहुभ्यां परिरभ्य च ।\nवृक्षमुत्पाटयामास भीमो भीमपराक्रमः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2139811, "chapter_id": 4018, "verse_number": "३३", "content_sanskrit": "ततो वृक्षं दशव्यामं निष्पत्रमकरोत् तदा ।\nस्कन्धमारोपयामास सस्कन्धविटपं बली\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2139812, "chapter_id": 4018, "verse_number": "३४", "content_sanskrit": "तं महासालमुद्यम्य भ्रामयित्वा च वेगतः ।\nप्रगृह्याभ्यपतत् सूतान् दण्डपाणिरिवान्तकः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2139813, "chapter_id": 4018, "verse_number": "३५", "content_sanskrit": "ऊरुवेगेन तस्याथ न्यग्रोधाश्वत्थकिंशुकाः ।\nभूमौ निपतिता वृक्षा सङ्घशस्तत्र शेरते\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2139814, "chapter_id": 4018, "verse_number": "३६", "content_sanskrit": "तं सिंहमिव सङ्क्रुद्धं गन्धर्वं प्रेक्ष्य ते तदा ।\nवित्रेसुः सर्वतः सूता विषादभयपीडिताः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2139815, "chapter_id": 4018, "verse_number": "३७", "content_sanskrit": "तमन्तकमिव क्रुद्धं गन्धर्वभयशङ्किताः ।\nदिधक्षन्तस्तथा ज्येष्ठं भ्रातरं चापि कीचकाः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2139816, "chapter_id": 4018, "verse_number": "३८", "content_sanskrit": "परस्परमथोचुस्ते विषादभयमोहिताः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2139817, "chapter_id": 4018, "verse_number": "३९", "content_sanskrit": "गन्धर्वो बलवानेति क्रुद्ध उद्यम्य पादपम् ।\nप्रबुद्धाः सुमहाभागा गन्धर्वाः सूर्यवर्चसः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2139818, "chapter_id": 4018, "verse_number": "४०", "content_sanskrit": "सैरन्ध्री मुच्यतां शीघ्रं भयं नो महदागतम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2139819, "chapter_id": 4018, "verse_number": "४१", "content_sanskrit": "तेऽथ दृष्ट्वा तमाविद्धं भीमसेनेन पादपम् ।\nविमुच्य द्रौपदीं त्रस्ताः प्राद्रवन् नगरं प्रति\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2139820, "chapter_id": 4018, "verse_number": "४२", "content_sanskrit": "द्रवतस्तांश्च सम्प्रेक्ष्य स वज्री दानवानिव ।\nशतं पञ्चाधिकं भीमः प्राहिणोद् यमसादनम्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2139821, "chapter_id": 4018, "verse_number": "४३", "content_sanskrit": "वायुवेगसमः श्रीमान् सर्वान् सूतानशेषतः ।\nतान् निहत्य महाबाहुर्भीमसेनो महाबलः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2139822, "chapter_id": 4018, "verse_number": "४४", "content_sanskrit": "आश्वासयंस्ततः कृष्णां प्रविमुच्य च बन्धनात्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2139823, "chapter_id": 4018, "verse_number": "४५", "content_sanskrit": "उवाच च महाबाहुः पाञ्चालीं भरतर्षभः ।\nअश्रुपूर्णमुखीं भीताम् उद्धरन् स वृकोदरः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2139824, "chapter_id": 4018, "verse_number": "४६", "content_sanskrit": "एवं ते भीरु वध्यन्ते ये त्वां हिंसन्ति मानवाः ।\nगच्छ त्वं नगरं कृष्णे न भयं विद्यते तव\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2139825, "chapter_id": 4018, "verse_number": "४७", "content_sanskrit": "अन्येन त्वं पथा गच्छ सुदेष्णाया निवेशनम् ।\nअन्येनाहं गमिष्यामि विराटस्य महानसम्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2139826, "chapter_id": 4018, "verse_number": "४८", "content_sanskrit": "यथा नौ नावबुद्ध्येरन् रात्रावेवं व्यवस्थितौ\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2139827, "chapter_id": 4018, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2139828, "chapter_id": 4018, "verse_number": "४९", "content_sanskrit": "साऽगच्छन्नगरं कृष्णा भीमेनाश्वासिता सती ।\nकृतकृत्या सुदेष्णाया भवनं शुभलक्षणा\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2139829, "chapter_id": 4018, "verse_number": "५०", "content_sanskrit": "शचीव नहुषे शप्ते प्रविवेश त्रिविष्टपम्\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2139830, "chapter_id": 4018, "verse_number": "५१", "content_sanskrit": "भीमोऽप्यमितवीर्यस्तु बलवानरिमर्दनः ।\nसर्वांस्तान् कीचकान् हत्वा तत्र धर्मात्मजानुजः\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2139831, "chapter_id": 4018, "verse_number": "५२", "content_sanskrit": "निःशेषं कीचकान् कृत्वा रामो रात्रिचरानिव ।\nहतशत्रुरमेयात्मा प्रविवेश पुरं ततः\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2139832, "chapter_id": 4018, "verse_number": "५३", "content_sanskrit": "पञ्चाधिकं शतं तत्र निहतं तेन भारत ।\nमहावनमिव च्छिन्नं शिश्ये विगळितद्रुमम्\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2139833, "chapter_id": 4018, "verse_number": "५४", "content_sanskrit": "एवं ते निहता राजन् शतं पञ्चोपकीचकाः ।\nस च सेनापतिः सूत इत्येतत् सूतषट्शतम्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2139834, "chapter_id": 4018, "verse_number": "५५", "content_sanskrit": "न गन्धर्वभयाच्छेकुर्वक्तुं कीचकबान्धवाः ।\nअशक्नुवन्तस्तां तत्र भयादप्यभिवीक्षितुम्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2139835, "chapter_id": 4018, "verse_number": "५६", "content_sanskrit": "विराटनगरे चापि सर्वे मत्स्याः समागताः ।\nकल्यं पञ्चशतं चैतान् अपश्यन् सारथीन् हतान्\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2139836, "chapter_id": 4018, "verse_number": "५७", "content_sanskrit": "तान् दृष्ट्वा महदाश्चर्यं नरा नार्यश्च नागराः ।\nविस्मयं परमं गत्वा नोचुः किञ्चन भारत\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2139837, "chapter_id": 4018, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां विराटपर्वणि षड्विंशोऽध्यायः ॥२६॥ कीचकवधपर्वणि एकादशोऽध्यायः ॥११॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}]