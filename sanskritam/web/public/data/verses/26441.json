[{"id": 7006441000, "chapter_id": 26441, "verse_number": "२-१०१-१", "content_sanskrit": "श्रीकृष्ण उवाच\nभवतां पुण्यकीर्तीनां तपोबलसमाधिभिः ।\nअपध्यानाच्च पापात्मा भौमः स नरको हतः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006441001, "chapter_id": 26441, "verse_number": "२-१०१-२", "content_sanskrit": "मोक्षितं बन्धनाद् गुप्तं कन्यान्तःपुरमुत्तमम् ।\nमणिपर्वतमुत्पाट्य शिखरं चैतदाहृतम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006441002, "chapter_id": 26441, "verse_number": "२-१०१-३", "content_sanskrit": "अयं धनौघः सुमहान् किङ्करैराहृतो मम ।\nईशा भवन्तो द्रव्यस्य तानुक्त्वा विरराम ह ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006441003, "chapter_id": 26441, "verse_number": "२-१०१-४", "content_sanskrit": "तच्छ्रुत्वा वासुदेवस्य भोजवृष्ण्यन्धका वचः ।\nजहृषुर्हृष्टरोमाणः पूजयन्तो जनार्दनम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006441004, "chapter_id": 26441, "verse_number": "२-१०१-५", "content_sanskrit": "ऊचुश्चैनं नृवीरास्ते कृताञ्जलिपुटास्ततः ।\nनैतच्चित्रं महाबाहो त्वयि देवकिनन्दने ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006441005, "chapter_id": 26441, "verse_number": "२-१०१-६", "content_sanskrit": "यत्कृत्वा दुष्करं कर्म देवैरपि दुरासदम् ।\nलालयेः स्वजनान् भोगै रत्नैश्च स्वयमर्जितैः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006441006, "chapter_id": 26441, "verse_number": "२-१०१-७", "content_sanskrit": "ततः सर्वदशार्हाणामाहुकस्य च याः स्त्रियः ।\nप्रीयमाणाः समाजग्मुर्वासुदेवदिदृक्षया ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006441007, "chapter_id": 26441, "verse_number": "२-१०१-८", "content_sanskrit": "देवकीसप्तमा देव्यो रोहिणी च शुभानना ।\nददृशुः कृष्णमासीनं रामं चैव महाभुजम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006441008, "chapter_id": 26441, "verse_number": "२-१०१-९", "content_sanskrit": "तौ तु पूर्वमतिक्रम्य रोहिणीमभिवाद्य च ।\nअभिवादयतां देवीं देवकीं रामकेशवौ ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006441009, "chapter_id": 26441, "verse_number": "२-१०१-१०", "content_sanskrit": "सा ताभ्यामृषभाक्षाभ्यां पुत्राभ्यां शुशुभेऽम्बिका ।\nअदितिर्देवमातेव मित्रेण वरुणेन च ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006441010, "chapter_id": 26441, "verse_number": "२-१०१-११", "content_sanskrit": "ततः प्राप्ता नराग्र्यौ तु तस्याः सा दुहिता तदा ।\nएकानंशेति यामाहुर्नरा वै कामरूपिणीम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006441011, "chapter_id": 26441, "verse_number": "२-१०१-१२", "content_sanskrit": "तथा क्षणमुहूर्ताभ्यां यथा जज्ञे सुरेश्वरः ।\nयत्कृते सगणं कंसं जघान पुरुषोत्तमः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006441012, "chapter_id": 26441, "verse_number": "२-१०१-१३", "content_sanskrit": "सा कन्या ववृधे तत्र वृष्णिसद्मनि पूजिता ।\nपुत्रवत् पाल्यमाना वै वासुदेवाज्ञया तदा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006441013, "chapter_id": 26441, "verse_number": "२-१०१-१४", "content_sanskrit": "एकानंशेति यामाहुरुत्पन्ना मानवा भुवि ।\nयोगकन्यां दुराधर्षां रक्षार्थं केशवस्य ह ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006441014, "chapter_id": 26441, "verse_number": "२-१०१-१५", "content_sanskrit": "यां चं सर्वे सुमनसः पूजयन्ति स्म यादवाः ।\nदेववद् दिव्यपुरुषः कृष्णः संरक्षितो यया ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006441015, "chapter_id": 26441, "verse_number": "२-१०१-१६", "content_sanskrit": "तां च तत्रोपसंगम्य प्रियामिव सखीं स्वसाम् ।\nदक्षिणेन कराग्रेण परिजग्राह माधवः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006441016, "chapter_id": 26441, "verse_number": "२-१०१-१७", "content_sanskrit": "तथैव रामोऽतिबलः सम्परिष्वज्य भाविनीम् ।\nमूर्ध्न्युपाघ्राय सव्येन प्रतिजग्राह पाणिना ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006441017, "chapter_id": 26441, "verse_number": "२-१०१-१८", "content_sanskrit": "ददृशुस्ताः स्त्रियो मध्ये भगिनीं रामकृष्णयोः ।\nरुक्मपद्मव्यग्रकरां स्त्रियं पद्मालयामिव ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006441018, "chapter_id": 26441, "verse_number": "२-१०१-१९", "content_sanskrit": "तथाक्षतमहावृष्ट्या पुष्पैश्च विविधैः शुभैः ।\nअवकीर्य च लाजैस्ताः स्त्रियो जग्मुर्यथालयम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006441019, "chapter_id": 26441, "verse_number": "२-१०१-२०", "content_sanskrit": "ततस्ते यादवाः सर्वे पूजयन्तो जनार्दनम् ।\nउपोपविविशुः प्रीताः प्रशंसन्तोऽद्भुतं कृतम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006441020, "chapter_id": 26441, "verse_number": "२-१०१-२१", "content_sanskrit": "पूज्यमानो महाबाहुः पौराणां रतिवर्धनः ।\nविरराज महाकीतिर्देवैरिव स तैः सह ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006441021, "chapter_id": 26441, "verse_number": "२-१०१-२२", "content_sanskrit": "समासीनेषु सर्वेषु यादवेषु जनार्दनम् ।\nनियोगात्त्रिदशेन्द्रस्य नारदोऽभ्यागमत् सभाम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006441022, "chapter_id": 26441, "verse_number": "२-१०१-२३", "content_sanskrit": "सोऽथ सम्पूजितः पूज्यः शूरैस्तैर्यदुपुङ्गवैः ।\nकरं संस्पृश्य स हरेर्विवेश परमासने ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006441023, "chapter_id": 26441, "verse_number": "२-१०१-२४", "content_sanskrit": "सुखोपविष्टस्तान् वृष्णीनुपविष्टानुवाच ह ।\nसम्प्राप्तं शक्रवचनाज्जानीध्वं मां नरर्षभाः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006441024, "chapter_id": 26441, "verse_number": "२-१०१-२५", "content_sanskrit": "शृणुध्वं राजशार्दूलाः कृष्णस्यास्य पराक्रमम् ।\nयानि कर्माणि कृतवान् बाल्यात्प्रभृति केशवः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006441025, "chapter_id": 26441, "verse_number": "२-१०१-२६", "content_sanskrit": "उग्रसेनसुतः कंसः सर्वान् निर्मथ्य यादवान् ।\nराज्यं जग्राह दुर्बुद्धिर्बद्ध्वा पितरमाहुकम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006441026, "chapter_id": 26441, "verse_number": "२-१०१-२७", "content_sanskrit": "समाश्रित्य जरासंधं श्वशुरं कुलपांसनः ।\nभोजवृष्ण्यन्धकान् सर्वानवमन्यत दुर्मतिः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006441027, "chapter_id": 26441, "verse_number": "२-१०१-२८", "content_sanskrit": "ज्ञातिकार्यं चिकीर्षुश्च वसुदेवः प्रतापवान् ।\nउग्रसेनस्य रक्षार्थं स्वपुत्रं पर्यरक्षत ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006441028, "chapter_id": 26441, "verse_number": "२-१०१-२९", "content_sanskrit": "स गोपः सह धर्मात्मा मथुरोपवने स्थितः ।\nअत्यद्भुतानि कर्माणि कृतवान् मधुसूदनः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006441029, "chapter_id": 26441, "verse_number": "२-१०१-३०", "content_sanskrit": "प्रत्यक्षं शूरसेनानां श्रूयते महदद्भुतम् ।\nउत्तानेन शयानेन शकटान्तरचारिणा ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006441030, "chapter_id": 26441, "verse_number": "२-१०१-३१", "content_sanskrit": "राक्षसी निहता रौद्रा शकुनीवेषधारिणी ।\nपूतना नाम घोरा सा महाकाया महाबला ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006441031, "chapter_id": 26441, "verse_number": "२-१०१-३२", "content_sanskrit": "विषदिग्धं स्तनं रौद्रं प्रयच्छन्ती जनार्दने ।\nददृशुर्निहतां तां ते राक्षसीं वनगोचराः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006441032, "chapter_id": 26441, "verse_number": "२-१०१-३३", "content_sanskrit": "पुनर्जातोऽयमित्याहुरुक्तस्तस्मादधोक्षजः ।\nअत्यद्भुतमिदं चासीद् यच्छिशुः पुरुषोत्तमः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006441033, "chapter_id": 26441, "verse_number": "२-१०१-३४", "content_sanskrit": "पादाङ्गुष्ठेन शकटं क्रीडमानो व्यलोडयत् ।\nदाम्ना चोलूखले बद्धो विप्रकुर्वन् कुमारकम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006441034, "chapter_id": 26441, "verse_number": "२-१०१-३५", "content_sanskrit": "बभञ्जार्जुनवृक्षौ द्वौ ख्यातो दामोदरस्तदा ।\nकालियश्च महानागो दुराधर्षो महाबलः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006441035, "chapter_id": 26441, "verse_number": "२-१०१-३६", "content_sanskrit": "क्रीडता वासुदेवेन निर्जितो यमुनाह्रदे ।\nअक्रूरस्य समक्षं च यन्नागभवने विभुः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006441036, "chapter_id": 26441, "verse_number": "२-१०१-३७", "content_sanskrit": "पूज्यमानं तदा नागैर्दिव्यं वपुरधारयत् ।\nशीतवातार्दिता गाश्च दृष्ट्वा कृष्णेन धीमता ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006441037, "chapter_id": 26441, "verse_number": "२-१०१-३८", "content_sanskrit": "धृतो गोवर्धनः शैलः सप्तरात्रं महात्मना ।\nशिशुना वासुदेवेन गवां त्राणार्थमिच्छताम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006441038, "chapter_id": 26441, "verse_number": "२-१०१-३९", "content_sanskrit": "तथोक्षदुष्टोऽतिबलो महाकायो नरान्तकृत् ।\nगोपतिर्वासुदेवेन हतोऽरिष्टो महासुरः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006441039, "chapter_id": 26441, "verse_number": "२-१०१-४०", "content_sanskrit": "धेनुकः स महाकायो दानवः सुमहाबलः ।\nनिहतो वासुदेवेन गवां त्राणाय दुर्मतिः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006441040, "chapter_id": 26441, "verse_number": "२-१०१-४१", "content_sanskrit": "सुनामानममित्रघ्नः सर्वसैन्यपुरस्कृतम् ।\nवृकैविद्रावयामास ग्रहीतुं समुपस्थितम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006441041, "chapter_id": 26441, "verse_number": "२-१०१-४२", "content_sanskrit": "रौहिणेयेन संगम्य वने विचरता पुनः ।\nगोपवेषधरेणैव कंसस्य भयमाहितम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006441042, "chapter_id": 26441, "verse_number": "२-१०१-४३", "content_sanskrit": "तथा व्रजगतः शौरिर्दृष्ट्वा युद्धबलं हयम् ।\nप्रग्रहं भोजराजस्य जघान पुरुषोत्तमः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006441043, "chapter_id": 26441, "verse_number": "२-१०१-४४", "content_sanskrit": "प्रलम्बश्च महाकायो रौहिणेयेन धीमता ।\nदानवो मुष्टिनैकेन कंसामात्यो निपातितः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006441044, "chapter_id": 26441, "verse_number": "२-१०१-४५", "content_sanskrit": "एतौ हि वसुदेवस्य पुत्रौ सुरसुतोपमौ ।\nववृधाते महावीर्यौ ब्रह्मगार्ग्येण संस्कृतौ ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006441045, "chapter_id": 26441, "verse_number": "२-१०१-४६", "content_sanskrit": "जन्मप्रभृति चाप्येतौ गार्ग्येण परमर्षिणा ।\nयाथातथ्येन विज्ञाप्य संस्कारं प्रतिपादितौ ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006441046, "chapter_id": 26441, "verse_number": "२-१०१-४७", "content_sanskrit": "यदा त्विमौ नरश्रेष्ठौ स्थितौ यौवनसम्मुखे ।\nसिंहशावाविवोदीर्णौ मत्तौ हैमवतौ यथा ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006441047, "chapter_id": 26441, "verse_number": "२-१०१-४८", "content_sanskrit": "ततो मनांसि गोपीनां हरमाणौ महाबलौ ।\nआस्तां गोष्ठवरौ वीरौ देवपुत्रोपमद्युती ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006441048, "chapter_id": 26441, "verse_number": "२-१०१-४९", "content_sanskrit": "एतौ जये वा युद्धे वा क्रीडासु विविधासु च ।\nनन्दगोपस्य गोपाला न शेकुः प्रसमीक्षितुम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006441049, "chapter_id": 26441, "verse_number": "२-१०१-५०", "content_sanskrit": "व्यूढोरस्कौ महाबाहू शालस्कन्धाविवोद्गतौ ।\nश्रुत्वासौ व्यथितः कंसो मन्त्रिभिः सहितोऽभवत् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006441050, "chapter_id": 26441, "verse_number": "२-१०१-५१", "content_sanskrit": "नाशकच्च यदा कंसो ग्रहीतुं बलकेशवौ ।\nनिजग्राह ततः क्रोधाद् वसुदेवं सबान्धवम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006441051, "chapter_id": 26441, "verse_number": "२-१०१-५२", "content_sanskrit": "सहोग्रसेनेन तदा चोरवद् गाढबन्धनम् ।\nकालं महान्तमनयत् कृच्छ्रमानकदुन्दुभिः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006441052, "chapter_id": 26441, "verse_number": "२-१०१-५३", "content_sanskrit": "कंसस्तु पितरं बद्ध्वा शूरसेनाञ्शशास ह ।\nजरासंधं समाश्रित्य तथैवाह्वृतिभीष्मकौ ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006441053, "chapter_id": 26441, "verse_number": "२-१०१-५४", "content_sanskrit": "कस्यचित्त्वथ कालस्य मथुरायां महोत्सवम् ।\nपिनाकिनं समुद्दिश्य चक्रे कंसो नराधिपः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006441054, "chapter_id": 26441, "verse_number": "२-१०१-५५", "content_sanskrit": "तत्र मल्लाः समाजग्मुर्नानादेश्या विशाम्पते ।\nनर्तना गायनाश्चैव कुशला नृत्यकर्मसु ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006441055, "chapter_id": 26441, "verse_number": "२-१०१-५६", "content_sanskrit": "ततः कंसो महातेजा रङ्गवाटं महाधनम् ।\nकुशलैः कारयामास शिल्पिभिः साधुनिष्ठितैः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006441056, "chapter_id": 26441, "verse_number": "२-१०१-५७", "content_sanskrit": "तत्र मञ्चसहस्राणि पौरजानपदैर्जनैः ।\nसमाकीर्णानि दृश्यन्ते ज्योतींषि गगने यथा ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006441057, "chapter_id": 26441, "verse_number": "२-१०१-५८", "content_sanskrit": "भोजराजः श्रिया जुष्टं रङ्गवाटं महर्द्धिमत् ।\nआरुरोह ततः कंसो विमानं सुकृती यथा ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006441058, "chapter_id": 26441, "verse_number": "२-१०१-५९", "content_sanskrit": "रङ्गवाटे गजं मत्तं प्रभूतायुधकल्पितम् ।\nयदाशूरैरधिष्ठितं कंसः स्थापयामास वीर्यवान् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006441059, "chapter_id": 26441, "verse_number": "२-१०१-६०", "content_sanskrit": "यदा हि स महातेजा रामकृष्णौ समागतौ ।\nशुश्राव पुरुषव्याघ्रौ सूर्याचन्द्रमसाविव ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006441060, "chapter_id": 26441, "verse_number": "२-१०१-६१", "content_sanskrit": "तदाप्रभृति यत्नोऽभूद् रक्षां प्रति नराधिप ।\nन च शिश्ये सुखं रात्रौ रामकृष्णौ विचिन्तयन् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006441061, "chapter_id": 26441, "verse_number": "२-१०१-६२", "content_sanskrit": "श्रुत्वा तु रामः कृष्णश्च तं समाजमनुत्तमम् ।\nउभौ विविशतुर्वीरौ शार्दूलौ गोव्रजं यथा ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006441062, "chapter_id": 26441, "verse_number": "२-१०१-६३", "content_sanskrit": "ततः प्रवेशे संरुद्धौ रक्षिभिः पुरुषर्षभौ ।\nहत्वा कुवलयापीडं ससादिनमरिंदमौ ।\nअवमृद्य दुराधर्षौ रङ्गं विविशतुस्तदा ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006441063, "chapter_id": 26441, "verse_number": "२-१०१-६४", "content_sanskrit": "चाणूरान्ध्रौ विनिष्पिष्य केशवेन बलेन च ।\nऔग्रसेनिः सुदुष्टात्मा सानुजो विनिपातितः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006441064, "chapter_id": 26441, "verse_number": "२-१०१-६५", "content_sanskrit": "यत्कृतं यदुसिंहेन देवैरपि सुदुष्करम् ।\nकर्म तत्केशवादन्यः कर्तुमर्हति कः पुमान् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006441065, "chapter_id": 26441, "verse_number": "२-१०१-६६", "content_sanskrit": "यद्धि नाधिगतं पूर्वैः प्रह्लादबलिशम्बरैः ।\nतदिदं प्रापितं वित्तं शौरिणा भवतां कृते ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006441066, "chapter_id": 26441, "verse_number": "२-१०१-६७", "content_sanskrit": "एतेन मुरुमाक्रम्य दैत्यं पञ्चजनं तथा ।\nनिष्क्रम्य शैलसंघातान्निसुन्दः सगणो हतः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006441067, "chapter_id": 26441, "verse_number": "२-१०१-६८", "content_sanskrit": "नरकश्च हतो भौमः कुण्डले चाहृते शुभे ।\nप्राप्तं च दिवि देवेषु केशवेन महद्यशः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006441068, "chapter_id": 26441, "verse_number": "२-१०१-६९", "content_sanskrit": "वीतशोकभयाबाधाः कृष्णबाहुबलाश्रयाः ।\nयजध्वं विविधैर्यज्ञैर्यादवा वीतमत्सराः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006441069, "chapter_id": 26441, "verse_number": "२-१०१-७०", "content_sanskrit": "देवानां सुमहत्कार्यं कृतं कृष्णेन धीमता ।\nप्रियमावेदयाम्येष भवतां भद्रमस्तु वः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006441070, "chapter_id": 26441, "verse_number": "२-१०१-७१", "content_sanskrit": "यदिष्टं वो यदुश्रेष्ठाः कर्तास्मि तदतन्द्रितः ।\nभवतामस्मि यूयं च मम युष्मास्वहं स्थितः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006441071, "chapter_id": 26441, "verse_number": "२-१०१-७२", "content_sanskrit": "इति सम्बोधयन् कृष्णमब्रवीत् पाकशासनः ।\nस मां प्रैषीत्सुरश्रेष्ठः प्रीतस्तुष्टास्तथा वयम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006441072, "chapter_id": 26441, "verse_number": "२-१०१-७३", "content_sanskrit": "यत्र धीः श्रीः स्थिता तत्र यत्र श्रीस्तत्र संनतिः ।\nसंनतिर्धीस्तथा श्रीश्च नित्यं कृष्णे महात्मनि ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}]