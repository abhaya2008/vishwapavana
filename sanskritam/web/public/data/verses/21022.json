[{"id": 7001022000, "chapter_id": 21022, "verse_number": "५-४-१", "content_sanskrit": "कंसस्ततोद्रिग्रमनाः प्राह सव्वीन महासुरान् ।\nप्रलम्बकेशिप्रमुखानाहूयासुरपुङ्गवान् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001022001, "chapter_id": 21022, "verse_number": "५-४-२", "content_sanskrit": "हे प्रलम्ब! महाबाहो! केशिन् !धेनुक!पूतने!\nअरिष्टाद्यस्तथा चान्यैः श्रूयतां वचनं मम ॥2॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001022002, "chapter_id": 21022, "verse_number": "५-४-३", "content_sanskrit": "मां हन्तुममरैर्यत्रः कृतः किल दुरात्मभिः ।\nमद्रीर्य्यतापितैवींरो न त्वेतान् गणयाम्यहम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001022003, "chapter_id": 21022, "verse_number": "५-४-४", "content_sanskrit": "किमिन्द्रणाल्पवीर्य्येण किं हरेणैकचारिणा ।\nहरिणा वापि किं साध्यं छिद्रष्वसुरघातिना ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001022004, "chapter_id": 21022, "verse_number": "५-४-५", "content_sanskrit": "किमादित्यैः किं वसुभिरल्पवीय्यैः किमग्रिभिः ।\nकिञ्चान्यैरमरैः सर्व्वैर्मदूबाहुबलनिर्ज्जितैः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001022005, "chapter_id": 21022, "verse_number": "५-४-६", "content_sanskrit": "किं न दृष्टोऽमरपतिर्मया संयुगमेत्य सः ।\nपृष्ठेनैव वहन् वाणानपागच्छन्न वक्षसा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001022006, "chapter_id": 21022, "verse_number": "५-४-७", "content_sanskrit": "मद्राष्ट्रे वारिता वृष्टिर्यदा शक्रेणा किं तदा ।\nमद्राणभिन्नैर्जलदैरापोऽमुक्ता यथेप्सिताः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001022007, "chapter_id": 21022, "verse_number": "५-४-८", "content_sanskrit": "किमुर्व्ब्यामवनीपाला मद्रबाहुबलभीरवः ।\nन सर्व्वे सन्नतिं याता जरासन्धमृते गुरुम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001022008, "chapter_id": 21022, "verse_number": "५-४-९", "content_sanskrit": "अमरेषु च मेऽवज्ञा जायते दैत्यपुङ्गवाः ।\nहास्यं मे जायते बींरास्तेषु यत्रपरेष्वपि ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001022009, "chapter_id": 21022, "verse_number": "५-४-१०", "content_sanskrit": "तथापि खलु दुष्टानां तेषामभ्यधिकं मया ।\nअपकाराय देत्येन्द्रा यतनीयं दुरात्मनाम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001022010, "chapter_id": 21022, "verse_number": "५-४-११", "content_sanskrit": "तदू ये यशस्विनः केचित् पृथिव्यां ये च यज्विनः ।\nकार्य्यो देबापकाराय तेषां सर्व्वात्मना वधः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001022011, "chapter_id": 21022, "verse_number": "५-४-१२", "content_sanskrit": "उत्पन्नश्वापि मृत्युर्मे भूतपूर्व्वः स वै किल ।\nइत्येतदू बालिका प्राह देवकीगर्भसम्भवा ॥१2॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001022012, "chapter_id": 21022, "verse_number": "५-४-१३", "content_sanskrit": "तस्मादू बालेषु परमो यत्रः कार्य्यो महीतले ।\nयत्रोद्रिक्तं बलं बाले स हन्तव्यः प्रयत्रतः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001022013, "chapter_id": 21022, "verse_number": "५-४-१४", "content_sanskrit": "इत्याज्ञाप्यासुरान् कंसः प्रविश्यात्मगृहं ततः ।\nमुमोच वसुदेवञ्च देवकीञ्च निरोधतः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001022014, "chapter_id": 21022, "verse_number": "५-४-१५", "content_sanskrit": "युवयोर्घातिता गर्भा वृथैवैते मयाधुना ।\nकोऽप्यन्य एव नाशाय बालो मम समुदूगतः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001022015, "chapter_id": 21022, "verse_number": "५-४-१६", "content_sanskrit": "तदलं परितापेन नूनं तद्भाविनो हि ते ।\nअर्भका युवयोर्दोषाच्चायुषो यद्रियोजिताः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001022016, "chapter_id": 21022, "verse_number": "५-४-१७", "content_sanskrit": "इत्याश्वास्य विमुक्त्वां च कंसस्तौ परिशङ्कितः ।\nअन्तर्गहं द्रिजश्वेष्ठ प्रविवेश पुनः स्वकम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]