[{"id": 7004481000, "chapter_id": 24481, "verse_number": "५-३-१७५-१", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nउत्तरे नर्मदाकूले भृगुक्षेत्रस्य मध्यतः ।\nकपिलेश्वरं तु विख्यातं विशेषात्पापनाशनम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004481001, "chapter_id": 24481, "verse_number": "५-३-१७५-२", "content_sanskrit": "योऽसौ सनातनो देवः पुराणे परिपठ्यते ।\nवासुदेवो जगन्नाथः कपिलत्वमुपागतः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004481002, "chapter_id": 24481, "verse_number": "५-३-१७५-३", "content_sanskrit": "पातालं सुतलं नाम तस्यैव नितलं ह्यधः ।\nगभस्तिगं च तस्याधो ह्यन्धतामिस्रमेव च॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004481003, "chapter_id": 24481, "verse_number": "५-३-१७५-४", "content_sanskrit": "पातालं सप्तमं यच्च ह्यधस्तात्संस्थितं महत् ।\nवसते तत्र वै देवः पुराणः परमेश्वरः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004481004, "chapter_id": 24481, "verse_number": "५-३-१७५-५", "content_sanskrit": "स ब्रह्मा स महादेवः स देवो गरुडध्वजः ।\nपूज्यमानः सुरैः सिद्धैस्तिष्ठते ब्रह्मवादिभिः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004481005, "chapter_id": 24481, "verse_number": "५-३-१७५-६", "content_sanskrit": "वसतस्तस्य राजेन्द्र कपिलस्य जगद्गुरोः ।\nविनाशं चाग्रतः प्राप्ताः क्षणेन सगरात्मजाः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004481006, "chapter_id": 24481, "verse_number": "५-३-१७५-७", "content_sanskrit": "भस्मीभूतांस्तु तान्दृष्ट्वा कपिलो मुनिसत्तमः ।\nजगाम परमं शोकं चिन्त्यमानोऽथ किल्बिषम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004481007, "chapter_id": 24481, "verse_number": "५-३-१७५-८", "content_sanskrit": "सर्वसङ्गपरित्यागे चित्ते निर्विषयीकृते ।\nअयुक्तं षष्टिसहस्राणां कर्तं मम विनाशनम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004481008, "chapter_id": 24481, "verse_number": "५-३-१७५-९", "content_sanskrit": "कृतस्य करणं नास्ति तस्मात्पापविनाशनम् ।\nगत्वा तु कापिलं तीर्थं मोचयाम्यघमात्मनः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004481009, "chapter_id": 24481, "verse_number": "५-३-१७५-१०", "content_sanskrit": "पातालं तु ततो मुक्त्वा कपिलो मुनिसत्तमः ।\nतपश्चचार सुमहन्नर्मदातटमास्थितः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004481010, "chapter_id": 24481, "verse_number": "५-३-१७५-११", "content_sanskrit": "व्रतोपवासैर्विविधैः स्नानदानजपादिकैः ।\nपरं निर्वाणमापन्नः पूजयन्रुद्रमव्ययम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004481011, "chapter_id": 24481, "verse_number": "५-३-१७५-१२", "content_sanskrit": "तत्र तीर्थे तु यः स्नात्वा पूजयेत्परमेश्वरम् ।\nगोसहस्रफलं तस्य लभते नात्र संशयः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004481012, "chapter_id": 24481, "verse_number": "५-३-१७५-१३", "content_sanskrit": "ज्येष्ठमासे तु सम्प्राप्ते शुक्लपक्षे चतुर्दशी ।\nतत्र स्नात्वा विधानेन भक्त्या दानं प्रयच्छति॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004481013, "chapter_id": 24481, "verse_number": "५-३-१७५-१४", "content_sanskrit": "पात्रभूताय विप्राय स्वल्पं वा यदि वा बहु ।\nअक्षयं तत्फलं प्रोक्तं शिवेन परमेष्ठिना॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004481014, "chapter_id": 24481, "verse_number": "५-३-१७५-१५", "content_sanskrit": "अङ्गारकदिने प्राप्ते चतुर्थ्यां नवमीषु च ।\nस्नानं करोति पुरुषो भक्त्योपोष्य वराङ्गना॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004481015, "chapter_id": 24481, "verse_number": "५-३-१७५-१६", "content_sanskrit": "रूपमैश्वर्यमतुलं सौभाग्यं संततिं पराम् ।\nलभते सप्तजन्मानि नित्यं नित्यं पुनः पुनः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004481016, "chapter_id": 24481, "verse_number": "५-३-१७५-१७", "content_sanskrit": "पौर्णमास्याममावास्यां स्नात्वा पिण्डं प्रयच्छति ।\nतस्य ते द्वादशाब्दानि तृप्ता यान्ति सुरालयम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004481017, "chapter_id": 24481, "verse_number": "५-३-१७५-१८", "content_sanskrit": "तत्र तीर्थे तु यो भक्त्या दद्याद्दीपं सुशोभनम् ।\nजायते तस्य राजेन्द्र महादीप्तिः शारीरजा॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004481018, "chapter_id": 24481, "verse_number": "५-३-१७५-१९", "content_sanskrit": "तत्र तीर्थे मृतानां तु जन्तूनां सर्वदा किल ।\nअनिवर्तिका भवेत्तेषां गतिस्तु शिवमन्दिरात्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]