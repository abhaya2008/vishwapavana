[{"id": 6000152000, "chapter_id": 10152, "verse_number": null, "content_sanskrit": "अथ चतुर्दशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000152001, "chapter_id": 10152, "verse_number": null, "content_sanskrit": "युधिष्ठिर उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_014/BhP_07.014.001.m4a", "display_order": 2}, {"id": 6000152002, "chapter_id": 10152, "verse_number": "७-१४-१", "content_sanskrit": "गृहस्थ एतां पदवीं विधिना येन चाञ्जसा।\nयायाद् देवऋषे ब्रूहि मादृशो गृहमूढधीः॥ ७/१४/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_014/BhP_07.014.002.m4a", "display_order": 3, "topics": [{"text": "गृहस्थाश्रमधर्मकथनम्", "range": "१–१०"}]}, {"id": 6000152003, "chapter_id": 10152, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_014/BhP_07.014.003.m4a", "display_order": 4}, {"id": 6000152004, "chapter_id": 10152, "verse_number": "७-१४-२", "content_sanskrit": "साधु पृष्टं महाभाग लोकानामनुगृह्णता।\nतत्त्वेन तदहं वक्ष्ये नैष्कर्म्यं येन कर्मणाम्॥ ७/१४/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_014/BhP_07.014.004.m4a", "display_order": 5}, {"id": 6000152005, "chapter_id": 10152, "verse_number": "७-१४-३", "content_sanskrit": "गृहेष्ववस्थितो राजन् क्रियाः कुर्वन् गृहोचिताः।\nवासुदेवार्पणं साक्षादुपासीत महामुनीन्॥ ७/१४/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_014/BhP_07.014.005.m4a", "display_order": 6}, {"id": 6000152006, "chapter_id": 10152, "verse_number": "७-१४-४", "content_sanskrit": "शृृण्वन् भगवतोऽभीक्ष्णमवतारकथामृतम्।\nश्रद्दधानो यथाकालमुपशान्तजनादृतम्॥ ७/१४/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_014/BhP_07.014.006.m4a", "display_order": 7}, {"id": 6000152007, "chapter_id": 10152, "verse_number": "७-१४-५", "content_sanskrit": "तत्सङ्गाच्छनकैः सङ्गमात्मजायात्मजादिषु।\nविमुञ्चेन्मुञ्चमानेषु स्वयं स्वप्नवदुत्थितः॥ ७/१४/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_014/BhP_07.014.007.m4a", "display_order": 8}, {"id": 6000152008, "chapter_id": 10152, "verse_number": "७-१४-६", "content_sanskrit": "यावदर्थ उपासीनो देहे गेहे च पण्डितः।\nविरक्तो रक्तवत् तत्र नृलोके नरतां न्यसेत्॥ ७/१४/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_014/BhP_07.014.008.m4a", "display_order": 9}, {"id": 6000152009, "chapter_id": 10152, "verse_number": "७-१४-७", "content_sanskrit": "ज्ञातयः पितरौ पुत्रा भ्रातरः सुहृदोऽपरे।\nयद् वदन्ति यदिच्छन्ति अनुमोदेत निर्ममः॥ ७/१४/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_014/BhP_07.014.009.m4a", "display_order": 10}, {"id": 6000152010, "chapter_id": 10152, "verse_number": "७-१४-८", "content_sanskrit": "दिव्यं भौमं चान्तरिक्षं वित्तमच्युतनिर्मितम्।\nतत्सर्वमुपभुञ्जीरन् न स्वीकुर्यात् स्वतो बुधः॥ ७/१४/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_014/BhP_07.014.010.m4a", "display_order": 11}, {"id": 6000152011, "chapter_id": 10152, "verse_number": "७-१४-९", "content_sanskrit": "यावद् भ्रियेत जठरं तावत् स्वत्वं हि देहिनाम्।\nअधिकं योऽभिमन्येत स स्तेनो दण्डमर्हति॥ ७/१४/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_014/BhP_07.014.011.m4a", "display_order": 12}, {"id": 6000152012, "chapter_id": 10152, "verse_number": "७-१४-१०", "content_sanskrit": "नृगोखराश्वमर्कांस्तु सरीसृपविमक्षिकान्।\nआत्मनः पुत्रवत् पश्येत् तैरेषामन्तरं कियत्॥ ७/१४/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_014/BhP_07.014.012.m4a", "display_order": 13}, {"id": 6000152013, "chapter_id": 10152, "verse_number": "७-१४-११", "content_sanskrit": "त्रिवर्गं नातिकृच्छ्रेण भजेत गृहमेध्यपि।\nयथादेशं यथाकालं यावत् दैवोपपादितम्॥ ७/१४/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_014/BhP_07.014.013.m4a", "display_order": 14, "topics": [{"text": "महत्सेवाया अवश्यकर्तव्यत्वे प्रथमम् उपबर्हणनामकगन्धर्वस्य स्वस्य महदवज्ञानेन शूद्रजन्मप्राप्तेः, तस्मिन् जन्मनि महत्सेवया ब्रह्मपुत्रत्वप्राप्तेश्च कथनम्", "range": "११–४३"}]}, {"id": 6000152014, "chapter_id": 10152, "verse_number": "७-१४-१२", "content_sanskrit": "आश्वाघान्तेवसायिभ्यः कामान् संविभजेद् यथा।\nआप्त्वैतान् महतो दारान् नृणां सत्त्वग्रहो यतः॥ ७/१४/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_014/BhP_07.014.014.m4a", "display_order": 15}, {"id": 6000152015, "chapter_id": 10152, "verse_number": "७-१४-१३", "content_sanskrit": "जह्याद् यदर्थे स्वान् प्राणान् हन्याद् वा पितरं गुरुम्।\nतस्यां स्वत्वं स्‍त्रियां जह्याद् यस्तेन ह्यजितो जितः॥ ७/१४/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_014/BhP_07.014.015.m4a", "display_order": 16}, {"id": 6000152016, "chapter_id": 10152, "verse_number": "७-१४-१४", "content_sanskrit": "क्रिमिविड्भस्मनिष्ठान्तं क्‍वेदं तुच्छं कलेवरम्।\nक्‍व तदीयरतिर्भार्या क्‍वायमात्मा नभश्छदिः॥ ७/१४/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_014/BhP_07.014.016.m4a", "display_order": 17}, {"id": 6000152017, "chapter_id": 10152, "verse_number": "७-१४-१५", "content_sanskrit": "सिद्धैर्यज्ञावशिष्टार्थैः कल्पयेद् वृत्तिमात्मनः।\nशेषे स्वत्वं त्यजेत् प्राज्ञः पदवीं महतामियात्॥ ७/१४/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_014/BhP_07.014.017.m4a", "display_order": 18}, {"id": 6000152018, "chapter_id": 10152, "verse_number": "७-१४-१६", "content_sanskrit": "देवानृषींश्च भूतानि पितॄनात्मानमन्वहम्।\nस्ववृत्त्याऽगतवित्तेन यजेत पुरुषं पृथक्॥ ७/१४/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_014/BhP_07.014.018.m4a", "display_order": 19}, {"id": 6000152019, "chapter_id": 10152, "verse_number": "७-१४-१७", "content_sanskrit": "यर्ह्यात्मनोऽधिकारोऽस्ति सर्वाः स्युर्यज्ञसम्पदः।\nवैतानिकेन विधिना अग्निहोत्रादिना यजेत्॥ ७/१४/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_014/BhP_07.014.019.m4a", "display_order": 20}, {"id": 6000152020, "chapter_id": 10152, "verse_number": "७-१४-१८", "content_sanskrit": "न ह्यग्निमुखतोऽयं वै भगवान् सर्वयज्ञभुक्।\nइज्येत हविषा राजन् यथा विप्रमुखे हुतैः॥ ७/१४/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_014/BhP_07.014.020.m4a", "display_order": 21}, {"id": 6000152021, "chapter_id": 10152, "verse_number": "७-१४-१९", "content_sanskrit": "तस्माद् ब्राह्मणदेवेषु मर्त्यादिषु यथार्हतः।\nतैस्तैः कामैर्यजेदेनं क्षेत्रज्ञं ब्राह्मणाननम्॥ ७/१४/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_014/BhP_07.014.021.m4a", "display_order": 22}, {"id": 6000152022, "chapter_id": 10152, "verse_number": "७-१४-२०", "content_sanskrit": "कुर्यादपरपक्षीयं मासि प्रोष्ठपदे द्विजः।\nश्राद्धं पित्रोर्यथावित्तं तद्बन्धूनां च वित्तवान्॥ ७/१४/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_014/BhP_07.014.022.m4a", "display_order": 23}, {"id": 6000152023, "chapter_id": 10152, "verse_number": "७-१४-२१", "content_sanskrit": "अयने विषुवे कुह्वां व्यतीपाते दिनक्षये।\nचन्द्रादित्योपरागे च द्वादश्यां श्रवणेषु च॥ ७/१४/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_014/BhP_07.014.023.m4a", "display_order": 24}, {"id": 6000152024, "chapter_id": 10152, "verse_number": "७-१४-२२", "content_sanskrit": "तृतीयायां शुक्लपक्षे नवम्यामथ कार्तिके।\nचतसृष्वप्यष्टकासु हेमन्ते शिशिरे तथा॥ ७/१४/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_014/BhP_07.014.024.m4a", "display_order": 25}, {"id": 6000152025, "chapter_id": 10152, "verse_number": "७-१४-२३", "content_sanskrit": "माघे च सितसप्तम्यां मघाराकासमागमे।\nराकया वाऽनुमत्या वा मासर्क्षाणि युतान्यपि॥ ७/१४/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_014/BhP_07.014.025.m4a", "display_order": 26}, {"id": 6000152026, "chapter_id": 10152, "verse_number": "७-१४-२४", "content_sanskrit": "द्वादश्यामनुराधा स्यात् श्रवणस्तिस्र उत्तराः।\nतिसृष्वेकादशी चासु जन्मर्क्षं सौम्ययोगयुक्॥ ७/१४/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_014/BhP_07.014.026.m4a", "display_order": 27}, {"id": 6000152027, "chapter_id": 10152, "verse_number": "७-१४-२५", "content_sanskrit": "त एते श्रेयसः काला नृणां श्रेयोविवर्धनाः।\nकुर्यात् सर्वात्मनैतेषु श्रेयोऽमोघं तदायुषः॥ ७/१४/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_014/BhP_07.014.027.m4a", "display_order": 28}, {"id": 6000152028, "chapter_id": 10152, "verse_number": "७-१४-२६", "content_sanskrit": "येषु स्नानं जपो होमो व्रतं देवद्विजार्चनम्।\nपितृदेवनृभूतेभ्यो यद् दत्तं तद्ध्यनश्वरम्॥ ७/१४/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_014/BhP_07.014.028.m4a", "display_order": 29}, {"id": 6000152029, "chapter_id": 10152, "verse_number": "७-१४-२७", "content_sanskrit": "संस्कारकालो जायाया अपत्यस्यात्मनस्तथा।\nप्रेतसंस्था मृताहश्च कर्मण्यभ्युदये नृप॥ ७/१४/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_014/BhP_07.014.029.m4a", "display_order": 30}, {"id": 6000152030, "chapter_id": 10152, "verse_number": "७-१४-२८", "content_sanskrit": "अथ देशान् प्रवक्ष्यामि धर्मादिश्रेयआवहान्।\nस वै पुण्यतमो देशः सत्पात्रं यत्र लभ्यते॥ ७/१४/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_014/BhP_07.014.030.m4a", "display_order": 31}, {"id": 6000152031, "chapter_id": 10152, "verse_number": "७-१४-२९", "content_sanskrit": "विश्वं भागवतो यत्र जगदेतच्चराचरम्।\nयत्र ह ब्राह्मणकुलं तपोविद्यादयान्वितम्॥ ७/१४/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_014/BhP_07.014.031.m4a", "display_order": 32}, {"id": 6000152032, "chapter_id": 10152, "verse_number": "७-१४-३०", "content_sanskrit": "यत्र यत्र हरेरर्चा स देशः श्रेयसां पदम्।\nयत्र गङ्गादयो नद्यः पुराणेषु च विश्रुताः॥ ७/१४/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_014/BhP_07.014.032.m4a", "display_order": 33}, {"id": 6000152033, "chapter_id": 10152, "verse_number": "७-१४-३१", "content_sanskrit": "सरांसि पुष्करादीनि क्षेत्राण्यर्हाश्रितान्युत।\nकुरुक्षेत्रं गयशिरः प्रयागः पुलहाश्रमः॥ ७/१४/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_014/BhP_07.014.033.m4a", "display_order": 34}, {"id": 6000152034, "chapter_id": 10152, "verse_number": "७-१४-३२", "content_sanskrit": "नैमिषं फल्गुनं सेतुः प्रभासोऽथ कुशस्थली।\nवाराणसी मधुपुरी पम्पा बिन्दुसरस्तथा॥ ७/१४/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_014/BhP_07.014.034.m4a", "display_order": 35}, {"id": 6000152035, "chapter_id": 10152, "verse_number": "७-१४-३३", "content_sanskrit": "नारायणाश्रमो नन्दासीतारामाश्रमादयः।\nसर्वे कुलाचला राजन् महेन्द्रमलयादयः॥ ७/१४/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_014/BhP_07.014.035.m4a", "display_order": 36}, {"id": 6000152036, "chapter_id": 10152, "verse_number": "७-१४-३४", "content_sanskrit": "एते पुण्यतमा देशा हरेरर्चाश्रिताः पुनः।\nएतान् देशान् निषेवेत श्रेयस्कामो ह्यभीक्ष्णशः॥ ७/१४/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_014/BhP_07.014.036.m4a", "display_order": 37}, {"id": 6000152037, "chapter_id": 10152, "verse_number": "७-१४-३५", "content_sanskrit": "धर्मो ह्यत्रोदितः पुंसां सहस्राधिफलोदयः।\nपात्रं चात्र निरुक्तं वै कविभिः पात्रवित्तमैः॥ ७/१४/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_014/BhP_07.014.037.m4a", "display_order": 38}, {"id": 6000152038, "chapter_id": 10152, "verse_number": "७-१४-३६", "content_sanskrit": "हरिरेवैक उर्वीश यन्मयं च चराचरम्। देवर्ष्यर्हत्सु वै सत्सु तत्र ब्रह्मात्मजादिषु।\nराजन् यदग्रपूजायां मतः पात्रतयाऽच्युतः॥ ७/१४/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_014/BhP_07.014.038.m4a", "display_order": 39}, {"id": 6000152039, "chapter_id": 10152, "verse_number": "७-१४-३७", "content_sanskrit": "जीवराशिभिराकीर्ण आण्डकोशाङ्घ्रिपो महान्।\nतन्मूलत्वादच्युतेज्या सर्वजीवात्मतर्पणम्॥ ७/१४/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_014/BhP_07.014.039.m4a", "display_order": 40}, {"id": 6000152040, "chapter_id": 10152, "verse_number": "७-१४-३८", "content_sanskrit": "पुराण्यनेन सृष्टानि नृतिर्यगृषिदेवताः।\nशेते जीवेन रूपेण पुरेषु पुरुषो ह्यसौ॥ ७/१४/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_014/BhP_07.014.040.m4a", "display_order": 41}, {"id": 6000152041, "chapter_id": 10152, "verse_number": "७-१४-३९", "content_sanskrit": "तेष्वीशो भगवान् राजन् तारतम्येन वर्तते।\nतस्मात् पात्रं हि पुरुषो यावानात्मा यथेयते॥ ७/१४/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_014/BhP_07.014.041.m4a", "display_order": 42}, {"id": 6000152042, "chapter_id": 10152, "verse_number": "७-१४-४०", "content_sanskrit": "दृष्ट्वा तेषां मिथो नॄणामवज्ञामात्मनो नृप।\nत्रेतादिषु हरेरर्चा क्रियायै कविभिः कृता॥ ७/१४/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_014/BhP_07.014.042.m4a", "display_order": 43}, {"id": 6000152043, "chapter_id": 10152, "verse_number": "७-१४-४१", "content_sanskrit": "ततोऽर्चायां हरिं केचिच्छ्रद्धया च सपर्यया।\nउपासते उपासा हि नार्थदा पुरुषद्विषाम्॥ ७/१४/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_014/BhP_07.014.043.m4a", "display_order": 44}, {"id": 6000152044, "chapter_id": 10152, "verse_number": "७-१४-४२", "content_sanskrit": "पुरुषेष्वपि राजेन्द्र सुपात्रं ब्राह्मणं विदुः।\nतपसा विद्यया तुष्ट्या धत्ते वेदं हरेस्तनुम्॥ ७/१४/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_014/BhP_07.014.044.m4a", "display_order": 45}, {"id": 6000152045, "chapter_id": 10152, "verse_number": "७-१४-४३", "content_sanskrit": "तन्वोऽस्य ब्राह्मणा राजन् कृष्णस्य जगदात्मनः।\nपुनन्तः पादरजसा त्रिलोकीं दैवतं महत्॥ ७/१४/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_014/BhP_07.014.045.m4a", "display_order": 46}, {"id": 6000152046, "chapter_id": 10152, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां सप्तमस्कन्धे चतुर्दशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]