[{"id": 7002860000, "chapter_id": 22860, "verse_number": "९-१४५-१", "content_sanskrit": "श्रीकृष्ण उवाच ।\nअग्निहोत्रे सुखासीनं गर्गः पृच्छति कौशिकम् ।\nबंधने संनिरोधेङ्गा व्याधीनां संप्रपीडने ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002860001, "chapter_id": 22860, "verse_number": "९-१४५-२", "content_sanskrit": "कथं मोक्षो भवेत्तस्य साध्यासाध्यं ब्रवीहि मे ।\nगर्गेण कौशिकः पृष्ट इदं वचनमब्रवीत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002860002, "chapter_id": 22860, "verse_number": "९-१४५-३", "content_sanskrit": "आधाने जन्मनक्षत्रे नैधनप्रत्ययेषु च ।\nव्याधिरुत्पद्यते यस्य क्लेशाय मरणाय च ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002860003, "chapter_id": 22860, "verse_number": "९-१४५-४", "content_sanskrit": "कृत्तिकासु यदा कश्चिद्व्याधिं संप्रतिपद्यते ।\nनवरात्रं भवेत्पीडा त्रिरात्रं रोहिणीषु च ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002860004, "chapter_id": 22860, "verse_number": "९-१४५-५", "content_sanskrit": "मृगशीर्षे पञ्चरात्रमार्द्रा प्राणवियोजिनी ।\nपुनर्वसौ च पुष्ये च सप्तरात्रं विधीयते ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002860005, "chapter_id": 22860, "verse_number": "९-१४५-६", "content_sanskrit": "नवरात्रं तथाश्लेषा श्मशानांतं मघासु च ।\nद्वौ मासौ फाल्गुनी चैव उत्तरासु त्रिपक्षकम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002860006, "chapter_id": 22860, "verse_number": "९-१४५-७", "content_sanskrit": "हस्ते च तनु दृश्येत चित्रायां त्वर्द्धमास कम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002860007, "chapter_id": 22860, "verse_number": "९-१४५-८", "content_sanskrit": "मासद्वयं तथा स्वातौ विशाखा विंशतिर्दिनाः ।\nमैत्रे चैव दशाहं तु ज्येष्ठा चैवार्द्धमासिका ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002860008, "chapter_id": 22860, "verse_number": "९-१४५-९", "content_sanskrit": "मूलेन जायते मोक्षश्चाषाढासु त्रिपञ्चकम् ।\nउत्तरादिनविंशत्या द्वौ मासौ श्रवणेन तु ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002860009, "chapter_id": 22860, "verse_number": "९-१४५-१०", "content_sanskrit": "धनिष्ठायामर्द्धमासं वारुणे तु दशाहकैः ।\nनव भाद्रपदाऋक्ष उत्तरासु त्रिपंचकम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002860010, "chapter_id": 22860, "verse_number": "९-१४५-११", "content_sanskrit": "रेवती दशरात्रं तु अहोरात्रं तथाश्विनी ।\nप्राणैर्वियोजयेन्नित्यं गर्ग नास्त्यत्र संशयः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002860011, "chapter_id": 22860, "verse_number": "९-१४५-१२", "content_sanskrit": "कौशिकेन समादिष्टो नक्षत्रव्याधिसंभवः ।\nदैवज्ञेनापि ज्ञातव्यं नक्षत्रमथ जन्मना ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002860012, "chapter_id": 22860, "verse_number": "९-१४५-१३", "content_sanskrit": "क्षीरवृक्षस्य समिधो जुहुयादश्वदैवते ।\nतिलान्मधुप्लुतान्याम्ये यवमेवाग्निदैवते ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002860013, "chapter_id": 22860, "verse_number": "९-१४५-१४", "content_sanskrit": "प्राजापत्ये तु जुहुयाद्भोग्यबीजकरं बकम् ।\nसौम्ये प्रियंगवो रौद्रे सर्पिर्मांससमन्वितम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002860014, "chapter_id": 22860, "verse_number": "९-१४५-१५", "content_sanskrit": "आदित्ये च प्रयत्नेन घृताक्ताः सिततंडुलाः ।\nपयसा सर्पिषा साकं बृहस्पत्यधिदैवते ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002860015, "chapter_id": 22860, "verse_number": "९-१४५-१६", "content_sanskrit": "ग्राम्योषधैर्वटपत्रैः सर्पिः सर्पाधिदैवते ।\nहोमः प्रोक्तः प्रियंगूनां नक्षत्रे यामदैवते ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002860016, "chapter_id": 22860, "verse_number": "९-१४५-१७", "content_sanskrit": "सावित्रे दधिहोमोत्र त्वाष्ट्रं चित्रौदनं हविः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002860017, "chapter_id": 22860, "verse_number": "९-१४५-१८", "content_sanskrit": "यवान्सहाज्येन हुनेद्रौद्रेऽग्नौ तु पयोदनम् ।\nमैत्रेणाथ तु मंत्रेण मैत्रे कटकमिश्रितम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002860018, "chapter_id": 22860, "verse_number": "९-१४५-१९", "content_sanskrit": "नैरृत्ये तिलहोमः स्यादव्यक्ते च हुताशने ।\nअब्दैवत्ये शालिबीजैर्वैश्वदेवं तु कारयेत् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002860019, "chapter_id": 22860, "verse_number": "९-१४५-२०", "content_sanskrit": "रक्ताश्च तंडुलाश्चैव होतव्या विष्णुदैवते ।\nवारुणे पारिजातानां पुष्पाणां होम इष्यते ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002860020, "chapter_id": 22860, "verse_number": "९-१४५-२१", "content_sanskrit": "अजैकपादे नक्षत्रे प्राजापत्येन तत्समम् ।\nआहिर्बुध्न्ये तु नक्षत्रे वैश्वदेवं तु कारयेत् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002860021, "chapter_id": 22860, "verse_number": "९-१४५-२२", "content_sanskrit": "रक्ताश्च तण्डुलाश्चैव होतव्या विष्णुदैवते ।\nपौषे फलान्यखंडानि जुहुयादष्टोत्तरं शतम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002860022, "chapter_id": 22860, "verse_number": "९-१४५-२३", "content_sanskrit": "सावित्री होममेकं तु ब्रह्माभिहितवान्पुरा ।\nसर्वज्वरप्रशमनं सद्यो ज्वरहरं परम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]