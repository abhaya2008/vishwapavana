[{"id": 7002153000, "chapter_id": 22153, "verse_number": "१९८-१", "content_sanskrit": "मासव्रतानि ।\nअग्निरुवाच ।\nमासव्रतकमाख्यास्ये भुक्तिमुक्तिप्रदायकं ।\nआषाढादिचतुर्मासमभ्यङ्गं वर्जयेत्सुधीः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002153001, "chapter_id": 22153, "verse_number": "१९८-२", "content_sanskrit": "वैशाखे पुष्पलवणन्त्यक्त्वा गोदो नृपो भवेत् ।\nगोदो मासोपवासी च भीमव्रतकरो हरिः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002153002, "chapter_id": 22153, "verse_number": "१९८-३", "content_sanskrit": "आषाढादिचतुर्मासं प्रातःस्नायी च विष्णुगः ।\nमाघे मास्यथ चैत्रे वा गुडधेनुप्रदो भवेत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002153003, "chapter_id": 22153, "verse_number": "१९८-४", "content_sanskrit": "गुडव्रतस्तृतीयायां गौरीशः स्यान्महाव्रती ।\nमार्गशीर्षादिमासेषु नक्तकृद्विष्णुलोकभाक् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002153004, "chapter_id": 22153, "verse_number": "१९८-५", "content_sanskrit": "एकभक्तव्रती तद्वद्द्वादशीव्रतकं पृठक् ।\nफलव्रती चतुर्मासं फलं त्यक्त्वा प्रदापयेत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002153005, "chapter_id": 22153, "verse_number": "१९८-६", "content_sanskrit": "श्रावणादिचतुर्मासं व्रतैः सर्वं लभेद्व्रती ।\nआषाढस्य सिते पक्षे एकादश्यामुपोषितः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002153006, "chapter_id": 22153, "verse_number": "१९८-७", "content_sanskrit": "चातुर्मास्यव्रतानान्तु कुर्वीत परिकल्पनं ।\nआषाढ्याञ्चाथ सङ्क्रान्तौ कर्कटस्य हरिं यजेत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002153007, "chapter_id": 22153, "verse_number": "१९८-८", "content_sanskrit": "इदं व्रतं मया देव गृहीतं पुरतस्तव ।\nनिर्विघ्नां सिद्धिमायातु प्रसन्ने त्वयि केशव ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002153008, "chapter_id": 22153, "verse_number": "१९८-९", "content_sanskrit": "गृहीतेऽस्मिन् व्रते देव यद्यपूर्णे म्रिये ह्यहं ।\nतन्मे भवतु सम्पूर्णं त्वत्प्रसादाज्जनार्दन ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002153009, "chapter_id": 22153, "verse_number": "१९८-१०", "content_sanskrit": "मांसादि त्यक्त्वा विप्रः स्यात्तैलत्यागी हरिं यजेत् ।\nएकान्तरोपवासी च त्रिरात्रं विष्णुलोकभाक् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002153010, "chapter_id": 22153, "verse_number": "१९८-११", "content_sanskrit": "चान्द्रायणी विष्णुलोकी मौनी स्यान्मुक्तिभाजनं ।\nप्राजापत्यव्रती स्वर्गी शक्तुयावकभक्षकः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002153011, "chapter_id": 22153, "verse_number": "१९८-१२", "content_sanskrit": "गुग्धाद्याहारवान् स्वर्गी पञ्चगव्याम्बुभ्क्तथा ।\nशाकमूलफलाहारी नरो विष्णुपुरीं व्रजेत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002153012, "chapter_id": 22153, "verse_number": "१९८-१३", "content_sanskrit": "मांसवर्जी यवाहारो रसवर्जी हरिं व्रजेत् ।\nकौमुदव्रतमाख्यास्ये आश्विने समुपोषितः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002153013, "chapter_id": 22153, "verse_number": "१९८-१४", "content_sanskrit": "द्वादश्यां पूजयेद्विष्णुं प्रलिप्याब्जोत्पलादिभिः ।\nघृतेन तिलतैलेन दीपनैवेद्यमर्पयेत् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002153014, "chapter_id": 22153, "verse_number": "१९८-१५", "content_sanskrit": "ॐ नमो वासुदेवाय मालत्या मालया यजेत् ।\nधर्मकामार्थमोक्षांश्च प्राप्नुयात्कौमुदव्रती ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]