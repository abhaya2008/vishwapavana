[{"id": 7003328000, "chapter_id": 23328, "verse_number": "२-२३-१", "content_sanskrit": "शैलादिरुवाच  ।\nअथ ते संप्रवक्ष्यामि शिवार्चनमनुत्तमम् ।\nत्रिसंध्यर्चयेदीशमग्निकार्यं च शक्तितः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003328001, "chapter_id": 23328, "verse_number": "२-२३-२", "content_sanskrit": "शिवस्नानं पुरा कृत्वा तत्त्वशुद्धिं च पूर्ववत् ।\nपुष्पहस्तः प्रविश्याथ पूजास्थानं समाहितः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003328002, "chapter_id": 23328, "verse_number": "२-२३-३", "content_sanskrit": "प्राणायामत्रयं कृत्वा दाहनाप्लावनानि च ।\nगंधादिवासितकरो महामुद्रां प्रविन्यसेत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003328003, "chapter_id": 23328, "verse_number": "२-२३-४", "content_sanskrit": "विज्ञानेन तनुं कृत्वा ब्रह्माग्नेरपि यत्नतः ।\nअव्यक्तबुद्ध्यहंकारतन्मात्रासंभवां तनुम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003328004, "chapter_id": 23328, "verse_number": "२-२३-५", "content_sanskrit": "शिवामृतेन संपूतं शिवस्य च यथातथम् ।\nअधोनिष्ठ्या वितस्त्यां तु नाभ्यामुपरि तिष्ठति ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003328005, "chapter_id": 23328, "verse_number": "२-२३-६", "content_sanskrit": "हृदयं तद्विजानीयाद्विश्वस्यायतनं महत् ।\nहृत्पद्मकर्णिकायां तु देवं साक्षात्सदाशिवम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003328006, "chapter_id": 23328, "verse_number": "२-२३-७", "content_sanskrit": "पंचवक्त्रं दशभुजं सर्वाभरणभूषितम् ।\nप्रतिवक्त्रं त्रिनेत्रं च शशांककृतशेखरम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003328007, "chapter_id": 23328, "verse_number": "२-२३-८", "content_sanskrit": "बद्धपद्मासनासीनं शुद्धस्फटिकसन्निभम् ।\nऊर्ध्वं वक्त्रं सितं ध्यायेत्पूर्वं कुंकुमसन्निभम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003328008, "chapter_id": 23328, "verse_number": "२-२३-९", "content_sanskrit": "नीलाभं दक्षिणं वक्त्रमतिरक्तं तथोत्तरम् ।\nगोक्षीरधवलं दिव्यं पश्चिमं परमेष्ठिनः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003328009, "chapter_id": 23328, "verse_number": "२-२३-१०", "content_sanskrit": "शूलं परशुखङ्गं च वज्रं शक्तिं च दक्षिणे ।\nवामे पाशांकुशं घंटां नागं नाराचमुत्तमम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003328010, "chapter_id": 23328, "verse_number": "२-२३-११", "content_sanskrit": "वरदाभयहस्तं वा शेषं पूर्ववदेव तु ।\nसर्वाभरणसंयुक्तं चित्रांबरधरं शिवम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003328011, "chapter_id": 23328, "verse_number": "२-२३-१२", "content_sanskrit": "ब्रह्मांगविग्रहं देवं सर्वदेवोत्तमोत्तमम् ।\nपूजयेत्सर्वभावेन ब्रह्मांगैर्ब्रह्मणः पतिम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003328012, "chapter_id": 23328, "verse_number": "२-२३-१३", "content_sanskrit": "उक्तानि पंच ब्रह्माणि शिवांगानि श्रृणुष्व मे ।\nशक्तिभूतानि च तथा हृदयादीनि सुव्रत ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003328013, "chapter_id": 23328, "verse_number": "२-२३-१४", "content_sanskrit": "ॐ ईशानः सर्वविद्यानां हृदयाय शक्तिबीजाय नमः ।\nॐ ईश्वरः सर्वभूतानाममृताय शिरसेनमः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003328014, "chapter_id": 23328, "verse_number": "२-२३-१५", "content_sanskrit": "ॐ ब्रह्माधिपतये कालाग्निरुपाय शिखायै नमः ।\nॐ ब्रह्मणोधिपतये कालचंडमारुताय कवचाय नमः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003328015, "chapter_id": 23328, "verse_number": "२-२३-१६", "content_sanskrit": "ॐ ब्रह्मणे बृंहणाय ज्ञानमूर्तये नेत्राय नमः ।\nॐ शिवाय सदाशिवाय पाशुपतास्राय अप्रतिहताय फट्फट् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003328016, "chapter_id": 23328, "verse_number": "२-२३-१७", "content_sanskrit": "ॐ सद्योजाताय भवेभवेनाति भवे भवस्य मां भवोद्भवाय शिवमूर्तये नमः ।\nॐ हंसशिखाय विद्यादेहाय आत्मस्वरूपाय परापराय शिवाय शिवतमाय नमः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003328017, "chapter_id": 23328, "verse_number": "२-२३-१८", "content_sanskrit": "कथितानि शिवांगानि मूर्तिविद्या च तस्य वै ।\nब्रह्मांगमूर्ति विद्यांगसहितां शिवशासने ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003328018, "chapter_id": 23328, "verse_number": "२-२३-१९", "content_sanskrit": "सौराणि च प्रवक्ष्यामि बाष्कलाद्यानि सुव्रत ।\nअंगानि सर्ववेदेषु सारभूतानि सुव्रत ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003328019, "chapter_id": 23328, "verse_number": "२-२३-२०", "content_sanskrit": "ॐभूः ॐभुवः ॐ स्वः ॐमहः ॐजनः ॐतपः ॐसत्यम् ॐऋतम् ॐब्रह्मानवाक्षरमयं मंत्रं बाष्कलं परिकीर्तितम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003328020, "chapter_id": 23328, "verse_number": "२-२३-२१", "content_sanskrit": "न क्षरतीति लोकेऽस्मिंस्ततो ह्यक्षरमुच्यते ।\nसत्यक्षरमित्युक्तं प्रणवादनमोंतकम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003328021, "chapter_id": 23328, "verse_number": "२-२३-२२", "content_sanskrit": "ॐभूर्भुवः स्वः तत्सवितुर्वरेण्यं भर्गो देवस्य धीमहि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003328022, "chapter_id": 23328, "verse_number": "२-२३-२३", "content_sanskrit": "धियो यो नः प्रचोदयात् ।\nनमः सूर्याय खखोल्काय नमः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003328023, "chapter_id": 23328, "verse_number": "२-२३-२४", "content_sanskrit": "मूलमंत्रमिति प्रोक्तं भास्करस्य महात्मनः ।\nनवाक्षरेण दीप्ताद्य मूलमंत्रेण भास्करम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003328024, "chapter_id": 23328, "verse_number": "२-२३-२५", "content_sanskrit": "पूजयेदंगमंत्राणि कथयामि समासतः ।\nवेदादिभिः प्रभूताद्यं प्रणवेन तु मध्यमम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003328025, "chapter_id": 23328, "verse_number": "२-२३-२६", "content_sanskrit": "ॐभूः ब्रह्मणे हृदयाय नमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003328026, "chapter_id": 23328, "verse_number": "२-२३-२७", "content_sanskrit": "ॐभुवः विष्णवे शिरसे नमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003328027, "chapter_id": 23328, "verse_number": "२-२३-२८", "content_sanskrit": "ॐस्वः रुद्राय शिखायै नमः ॐभूर्भुवः स्वः ज्वालामानिन्यै देवाय नमः ॐमहः महेश्वराय कवचाय नमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003328028, "chapter_id": 23328, "verse_number": "२-२३-२९", "content_sanskrit": "ॐजनः शिवाय नेत्रेभ्यो नमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003328029, "chapter_id": 23328, "verse_number": "२-२३-३०", "content_sanskrit": "ॐतपस्तापनाय अस्त्राय नमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003328030, "chapter_id": 23328, "verse_number": "२-२३-३१", "content_sanskrit": "एवं प्रसंगादेवेह सौराणि कथितानि ह ।\nशैवानि च समासेन न्यासयोगेन सुव्रत ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003328031, "chapter_id": 23328, "verse_number": "२-२३-३२", "content_sanskrit": "इत्थं मंत्रमयं देवं पूजयेद्धृदयांबुजे ।\nनाभौ होमं तु कर्तव्यं जनयित्वा यथाक्रमम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003328032, "chapter_id": 23328, "verse_number": "२-२३-३३", "content_sanskrit": "मनसा सर्वकार्याणि शिवाग्नौ देवमीश्वरम् ।\nपंचब्रह्मांगसंभूतं शिवमूर्तिं सदाशिवम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003328033, "chapter_id": 23328, "verse_number": "२-२३-३४", "content_sanskrit": "रक्तपद्मासनासीनं सकलीकृत्य यत्नतः ।\nमूलेन मूर्तिमंत्रेण ब्रह्मांगाद्यैस्तू सुव्रत ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003328034, "chapter_id": 23328, "verse_number": "२-२३-३५", "content_sanskrit": "समिदाज्याहुतीर्हुत्वा मनसा चंद्रमंडलात् ।\nचंद्रस्थानात्समुत्पन्नां पूर्णधारामनुस्मरेत् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003328035, "chapter_id": 23328, "verse_number": "२-२३-३६", "content_sanskrit": "पूर्णाहुतिविधानेन ज्ञानिनां शिवशासने ।\nशिवं वक्त्रगतं ध्यायेत्तेजोमात्रं च शांकरम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003328036, "chapter_id": 23328, "verse_number": "२-२३-३७", "content_sanskrit": "ललाटे देवदेवेशं भ्रमध्ये वा स्मरेत्पुनः ।\nयच्च हृत्कमले सर्वं समाप्य विधिविस्तरम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003328037, "chapter_id": 23328, "verse_number": "२-२३-३८", "content_sanskrit": "शुद्धदीपशिखाकारं भावयेद्भवनाशनम् ।\nलिंगे च पूजयेद्देवं स्थंडिले वा सदाशिवम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]