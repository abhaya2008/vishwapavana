[{"id": 7003183000, "chapter_id": 23183, "verse_number": "४-११९-१", "content_sanskrit": "अथैकोनविंशत्यधिकशततमोऽध्यायः ।\nनारायण उवाच ।\nपार्वतीवचनं श्रुत्वा गमेशश्च शिवः स्वयम् ।\nकार्तिकेयश्च काली च तां प्रशंसां चकार ह ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003183001, "chapter_id": 23183, "verse_number": "४-११९-२", "content_sanskrit": "उवाच भगवाञ्शंभुर्जगतां मातरं पराम् ।\nज्योतिः स्वरूपां परमां मूलप्रकृतिमीश्वरीम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003183002, "chapter_id": 23183, "verse_number": "४-११९-३", "content_sanskrit": "महादेव उवाच ।\nत्वया यधक्तं देवेशि सर्व वेदोक्तमीप्सितम् ।\nअयुक्तमुपहास्यं व समरं परमात्मना ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003183003, "chapter_id": 23183, "verse_number": "४-११९-४", "content_sanskrit": "बाणो ददातु कन्यां दां स्वर्णभूषणभूषिताम् ।\nसामञ्जस्यं यशस्यं च शुभदं सर्वकर्मसु ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003183004, "chapter_id": 23183, "verse_number": "४-११९-५", "content_sanskrit": "न ददाति यदा बाणो हिरण्यकशिपोः प्रजा ।\nयुद्धे पराङ्मुखो भीतो भगवत्ययशस्करः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003183005, "chapter_id": 23183, "verse_number": "४-११९-६", "content_sanskrit": "बाणो गच्छतु संनाही रणशास्रविशारदः ।\nपश्चाच्चा ऽऽगमनं कुर्मो वयं सांनाहिकाः शिवे ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003183006, "chapter_id": 23183, "verse_number": "४-११९-७", "content_sanskrit": "उवाच बाणं तां दातुं स च न स्वीचकार ह ।\nदुर्गा तं बोधयामास न बुबोध च सद्वचः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003183007, "chapter_id": 23183, "verse_number": "४-११९-८", "content_sanskrit": "एतस्मिन्नन्तरे तां च सभामेव महोरमाम् ।\nआजगाम महाधर्मो बलिश्च वैष्णवाग्रणीः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003183008, "chapter_id": 23183, "verse_number": "४-११९-९", "content_sanskrit": "रथं लत्नेन्द्रनिर्माणं समारुह्य महाबलः ।\nप्रतप्तैः सप्तभिर्दैत्यैः सेवितः श्वेतचामरैः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003183009, "chapter_id": 23183, "verse_number": "४-११९-१०", "content_sanskrit": "दैत्येन्द्राणां सप्तलक्षैरावृतः परमास्त्रवित् ।\nअवरुह्य रथात्तूर्णं गणेशं च शिवां शिवाम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003183010, "chapter_id": 23183, "verse_number": "४-११९-११", "content_sanskrit": "प्रणम्य कार्तिकेयं च स उवास च संसदि ।\nउत्तस्थुरारात्तं दृष्ट्वा ते सर्वे शंकरं विना ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003183011, "chapter_id": 23183, "verse_number": "४-११९-१२", "content_sanskrit": "तमुवाच महादेवः संभाष्य प्रियभाषणम्  ।\nमहादेव उवाच ।\nभगवंश्चतुरस्त्वं च प्रदाता सर्वसंपदाम् ।\nअयं हि परमो लाभो वैष्णवानां समागमः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003183012, "chapter_id": 23183, "verse_number": "४-११९-१३", "content_sanskrit": "तीर्थान्यपि च पूतानि वैष्णवस्पर्शमात्रतः ।\nसर्वेषामाश्रमाणां च पूजितो ब्राह्मणः शुचिः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003183013, "chapter_id": 23183, "verse_number": "४-११९-१४", "content_sanskrit": "ततोऽधिकः पूजितोऽपि ब्राह्मणो यदि वैष्णवः ।\nन हि पूतं च पश्यमि वैष्णवब्राह्मणात्परम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003183014, "chapter_id": 23183, "verse_number": "४-११९-१५", "content_sanskrit": "स पूतः पवनादेव स पूतश्च हुताशानात् ।\nतीर्थेम्योऽपि च सर्वेभ्यो बिभेति च ततः सुरः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003183015, "chapter_id": 23183, "verse_number": "४-११९-१६", "content_sanskrit": "न हि पापानि तद्देहे वह्नौ शुष्कतृणादिवत् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003183016, "chapter_id": 23183, "verse_number": "४-११९-१७", "content_sanskrit": "बलिरुवाच ।\nकथं स्तौषि जगन्नाथ भृत्यमस्तव्यमीश्वरः ।\nप्रदत्तं परमेश्वर्य त्वया नाथ सुदुल्रभम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003183017, "chapter_id": 23183, "verse_number": "४-११९-१८", "content_sanskrit": "अधुना स्थापितो दैवात्सर्वाधः सुतलेऽपि च ।\nइन्द्राय दत्तमैश्वर्य मत्तो भक्तात्सुरेश्वर ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003183018, "chapter_id": 23183, "verse_number": "४-११९-१९", "content_sanskrit": "त्वया वामनरूपेण सर्वरूपोऽसि सर्वतः ।\nबाणं बोधय भद्रं च मम प्राणात्मजं परम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003183019, "chapter_id": 23183, "verse_number": "४-११९-२०", "content_sanskrit": "आत्मना सह युद्धं च देवेष्वपि विगर्हितम् ।\nइत्युक्त्वा च शिवं नत्वा शिरसा प्रणनाम तम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003183020, "chapter_id": 23183, "verse_number": "४-११९-२१", "content_sanskrit": "सामवेदोक्तस्तोत्रेण तुष्टाव परमेश्वरम् ।\nपुलकाञ्चितसर्वाङ्गः साश्रुनेत्रोऽतिविह्वलः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003183021, "chapter_id": 23183, "verse_number": "४-११९-२२", "content_sanskrit": "ध्यायमानश्च नित्यं यो हृत्पद्मे सुमनोहरे ।\nशुक्रेण दत्तं मन्त्रं च जप्त्वा चैकादशाक्षरम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003183022, "chapter_id": 23183, "verse_number": "४-११९-२३", "content_sanskrit": "बलिरुवाच ।\nअदित्याः प्रार्थनेनैव मातुर्देव्या व्रतेन च ।\nपुरा वामनरूपेण त्वयाऽहं वञ्चितः प्रभो ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003183023, "chapter_id": 23183, "verse_number": "४-११९-२४", "content_sanskrit": "संपद्रूपा महालक्ष्मीर्दत्ता भक्ताय भक्तितः ।\nशक्राय मत्तो भक्ताय भ्रात्रे पुण्यवते ध्रुवम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003183024, "chapter_id": 23183, "verse_number": "४-११९-२५", "content_sanskrit": "अधुना मम पुत्रोऽयं बाणः शंकरकिंकरः ।\nआराच्च रक्षितः सोऽपि तेनैव भक्तबन्धुना ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003183025, "chapter_id": 23183, "verse_number": "४-११९-२६", "content_sanskrit": "परिपुष्टश्च पार्वत्या यथा मात्रा सुतस्तथा ।\nगृहीतवांश्च तत्कन्यां बलेन युवतीं सतीम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003183026, "chapter_id": 23183, "verse_number": "४-११९-२७", "content_sanskrit": "समुद्यतश्च तं हन्तुं कार्तिकेनापि वारितः ।\nआगतोऽसि पुनर्हन्तुं पौत्रस्य दमने क्षमः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003183027, "chapter_id": 23183, "verse_number": "४-११९-२८", "content_sanskrit": "सर्वात्मनश्च सर्वत्र समभावः श्रुतौ श्रुतः ।\nकरोषि जगतां नाथ कथमेवं व्यतिक्रमः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003183028, "chapter_id": 23183, "verse_number": "४-११९-२९", "content_sanskrit": "त्वया च निहतो यो हि तस्य को रक्षिता भुवि ।\nसुदर्शनस्य तेजो हि सूर्यकोटिनिभं परम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003183029, "chapter_id": 23183, "verse_number": "४-११९-३०", "content_sanskrit": "केषां सुराणामस्त्रेण तदेव च निवारितम् ।\nयथा सुदर्शनं चैवमस्त्राणां प्रवरं वरम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003183030, "chapter_id": 23183, "verse_number": "४-११९-३१", "content_sanskrit": "तथा भवांश्च देवानां सर्वेषामीश्वरः परः ।\nयथा भवांस्तथा कृष्णो विधाता वेधसामपि ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003183031, "chapter_id": 23183, "verse_number": "४-११९-३२", "content_sanskrit": "विष्णुः सत्त्वगुणाधारः शिवः सत्त्वाश्रयस्तथा ।\nस्वयं विधाता रजसः सृष्टिकर्ता पितामहः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003183032, "chapter_id": 23183, "verse_number": "४-११९-३३", "content_sanskrit": "कालाग्निरुद्रो भगवान्विश्वचसंहारकारकः ।\nतमसश्चाऽऽश्रयः सोऽपि रुद्राणां प्रवरो महान् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003183033, "chapter_id": 23183, "verse_number": "४-११९-३४", "content_sanskrit": "स एव शंकरांशश्चाप्यन्ये रुद्राश्च तत्कलाः ।\nभवांश्च निर्गुणस्तेषां प्रकृतेश्च परस्तथा ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003183034, "chapter_id": 23183, "verse_number": "४-११९-३५", "content_sanskrit": "सर्वेषां परमात्मा वै प्रणा विष्णुस्वरूपिणः ।\nमानसं च स्वयं ब्रह्मा स्वयं ज्ञानात्मकः शिवः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003183035, "chapter_id": 23183, "verse_number": "४-११९-३६", "content_sanskrit": "प्रवरा सर्वशक्तीनां बुद्धिः प्रकृतिरीश्वरी ।\nस्वात्मनः प्रतिबिभ्बस्ते जीवः सर्वेषु देहिषु ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003183036, "chapter_id": 23183, "verse_number": "४-११९-३७", "content_sanskrit": "जीवः स्वकर्मणां भोगी स्वयं साक्षी भवांस्तथा ।\nसर्वे यान्ति त्वयि गते नरदेवे यथाऽनुगाः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003183037, "chapter_id": 23183, "verse_number": "४-११९-३८", "content_sanskrit": "सद्यः पतति देहश्च शवोऽस्पृश्यस्त्वया विना ।\nबुद्धाः सन्तो न जानन्ति वञ्चितास्तव मायया ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003183038, "chapter_id": 23183, "verse_number": "४-११९-३९", "content_sanskrit": "त्वां भजन्त्येव ये सन्तो मायामेतां तरन्ति ते ।\nत्रिगुणा प्रकृतिर्दुर्गा वैष्णवी च सनातनी ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003183039, "chapter_id": 23183, "verse_number": "४-११९-४०", "content_sanskrit": "परा नारायणीशानी तव माया दुरत्यया ।\nत्वदंशाः प्रतिविश्वेषु ब्रह्मविष्णुशिवात्मकाः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003183040, "chapter_id": 23183, "verse_number": "४-११९-४१", "content_sanskrit": "सर्वेषामपि विश्वेषामाश्रयो यो महान्विराट् ।\nस सेते च जले योगाद्विश्वेशो गोकुले यथा ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003183041, "chapter_id": 23183, "verse_number": "४-११९-४२", "content_sanskrit": "स एव वासुर्भगवांस्तस्य देवो भवान्परः ।\nवासुदेव इति ख्यातः पुराविद्भिः प्रकीर्तितः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003183042, "chapter_id": 23183, "verse_number": "४-११९-४३", "content_sanskrit": "त्वमेव कलया सूर्यस्त्वमेव कलया शशी ।\nकलया च हुताशश्च कलया पवनः स्वयम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003183043, "chapter_id": 23183, "verse_number": "४-११९-४४", "content_sanskrit": "कलया वरुणश्चैव कुबेरश्च यमस्तथा ।\nकलया त्वं महेन्द्रश्च कलया धर्म एव च ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003183044, "chapter_id": 23183, "verse_number": "४-११९-४५", "content_sanskrit": "त्वमेव कलया शेष ईशानो नैऋंतिस्तथा ।\nमुनयो मनवश्चैव ग्रहाश्च फलदायकः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003183045, "chapter_id": 23183, "verse_number": "४-११९-४६", "content_sanskrit": "कलाकलायाश्चांशेन सर्वे जीवाश्चराचराः ।\nत्वं ब्रह्म परमं ज्योतिर्ध्यायन्ते योगिनः सदा ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003183046, "chapter_id": 23183, "verse_number": "४-११९-४७", "content_sanskrit": "तं त्चाऽऽद्रियन्ते भक्तास्ते ध्यायन्ते य तदन्तरे ।\nनवीननीरदश्यामं पीतकौशेयवाससम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003183047, "chapter_id": 23183, "verse_number": "४-११९-४८", "content_sanskrit": "ईषद्धास्यप्रसन्नास्यं भक्तेशं भक्तवत्सलम् ।\nचन्दनोक्षितसर्वाङ्गं द्विभुजं मुरलीधरम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003183048, "chapter_id": 23183, "verse_number": "४-११९-४९", "content_sanskrit": "मयूरपिच्छचूडं च मालतीमाल्यभूषितम् ।\nअमूल्यरत्ननिर्माणकेयूरवलयाविन्तम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003183049, "chapter_id": 23183, "verse_number": "४-११९-५०", "content_sanskrit": "मणिकुण्डलयुग्मेन गण्डस्थलविराजितम् ।\nरत्नसाराङ्गलीयं च क्वणन्मञ्जीररञ्जितम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003183050, "chapter_id": 23183, "verse_number": "४-११९-५१", "content_sanskrit": "कोटिकन्दर्पलीलाभं शरत्कमललोचनम् ।\nशरत्पूर्णैन्दुनिन्दास्यं चन्द्रकोटिसमप्रभम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003183051, "chapter_id": 23183, "verse_number": "४-११९-५२", "content_sanskrit": "वीक्षितं सस्मिताभिश्च गोपीनां कोटिकोटिभिः ।\nवयस्यैः पार्षदैर्गोपैः सेवितं श्वेतचामरैः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003183052, "chapter_id": 23183, "verse_number": "४-११९-५३", "content_sanskrit": "गोपबालकवेषं च राधावक्षः स्थलस्थितम् ।\nध्यानासाध्यं दुराराध्यं ब्रह्मेशशेषवन्दितम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003183053, "chapter_id": 23183, "verse_number": "४-११९-५४", "content_sanskrit": "सिन्द्धेन्द्रैश्च मुनीन्द्रैश्च योगीन्द्रैः प्रणतं स्तुतम् ।\nवेदानिर्वचनीयं च परं स्वेच्छामयं विभुम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003183054, "chapter_id": 23183, "verse_number": "४-११९-५५", "content_sanskrit": "स्थूलस्थूलतमं रूपं सूक्ष्मात्सूक्ष्मतमं परम् ।\nसत्यं नित्यं प्रशस्तं च प्रकृतेः परमीश्वरम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003183055, "chapter_id": 23183, "verse_number": "४-११९-५६", "content_sanskrit": "निर्लिप्तं च निरीहं च भगवन्तं सनातनम् ।\nएवं ध्यात्वा च ते पूताः स्निग्धदूर्वाक्षता जलम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003183056, "chapter_id": 23183, "verse_number": "४-११९-५७", "content_sanskrit": "पद्मापद्मार्चिते पादपद्मे च दातुमुत्सुकाः ।\nवेदाःस्तोतुमशक्तास्त्वामशक्ता सा सरस्वती ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003183057, "chapter_id": 23183, "verse_number": "४-११९-५८", "content_sanskrit": "शेषः स्तोतुमशक्तश्च स्वयंभूः शंभुरीश्वरः ।\nगणेशश्च दिनेशश्च महेन्द्रश्चन्द्र एव च ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003183058, "chapter_id": 23183, "verse_number": "४-११९-५९", "content_sanskrit": "स्तोतुं नालं धनेशश्च किमन्ये जड्बुद्धयः ।\nगुणातीतमनीहं च किं स्तौमि निर्गुणं परम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003183059, "chapter_id": 23183, "verse_number": "४-११९-६०", "content_sanskrit": "अपण्डितोऽयमसुरो न सुरः क्षन्तुमर्हसि ।\nबलेस्तद्वचनं श्रुत्वा तमुवाच जगत्पतिः ।\nपरिपूर्णतमः श्रीमान्भक्तं च भक्तवत्सलः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003183060, "chapter_id": 23183, "verse_number": "४-११९-६१", "content_sanskrit": "श्रीभगवानुवाच ।\nमा भैर्वत्स गृहं गच्छ सुतलं रक्षितं मया ।\nमद्वरेण प्रसादेन त्वत्पुत्रोऽप्यजरामरः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003183061, "chapter_id": 23183, "verse_number": "४-११९-६२", "content_sanskrit": "दर्पहानिं करिष्यामि तस्य मूर्खस्य दर्पिणः ।\nप्रह्लादाय वरो दत्तो भक्ताय च तपस्विने ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003183062, "chapter_id": 23183, "verse_number": "४-११९-६३", "content_sanskrit": "ममावध्यश्च त्वद्वंशश्चेति प्रीतेन चेतसा ।\nतव पुत्राय दास्यामि ज्ञानं मृत्युंजयं परम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003183063, "chapter_id": 23183, "verse_number": "४-११९-६४", "content_sanskrit": "त्वया कृतिमिदं स्तोत्रं सामवेदोक्तमीप्सितम् ।\nपुरा सनत्कुमाराराय प्रदत्तं ब्रह्मणा तथा ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003183064, "chapter_id": 23183, "verse_number": "४-११९-६५", "content_sanskrit": "सिद्धाश्रमे पुण्यतमे प्रशस्ते सूर्यपर्वणि ।\nगौतमाय प्रदत्तं च गौर्या मन्दाकिनीतटे ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003183065, "chapter_id": 23183, "verse_number": "४-११९-६६", "content_sanskrit": "शंकरेण च शिष्याय भक्ताय च दयालुना ।\nब्रह्मणे च मया दत्तं शिवाय विरजातटे ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003183066, "chapter_id": 23183, "verse_number": "४-११९-६७", "content_sanskrit": "भृगवे च पुरा दत्तं कुमारेण च धीमता ।\nत्वं च दास्यसि बाणाय बाणः स्तोष्यत्यनेन माम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003183067, "chapter_id": 23183, "verse_number": "४-११९-६८", "content_sanskrit": "इदं स्तोत्रं महापुण्यमुबदिश्य गुरोर्मुखात् ।\nवृतस्य पूजितस्यापि वस्त्रभूषणचन्दनैः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003183068, "chapter_id": 23183, "verse_number": "४-११९-६९", "content_sanskrit": "सुस्नातो यः पठेन्नित्यं पूजाकाले च भक्तितः ।\nकोटिजन्मार्जितात्पापान्मुच्यते नात्र संशयः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003183069, "chapter_id": 23183, "verse_number": "४-११९-७०", "content_sanskrit": "विपदां खण्डनं स्तोत्रं कारणं सर्वसंपदाम् ।\nवारणं दुःखशोकानां भवाब्धिधोरतारणम् ॥७०", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003183070, "chapter_id": 23183, "verse_number": "४-११९-७१", "content_sanskrit": "खण्डनं गर्भवासानां जरामृत्युहरं परम् ।बन्धनानां च रोगाणां खण्डनं भक्तमण्डनम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003183071, "chapter_id": 23183, "verse_number": "४-११९-७२", "content_sanskrit": "स स्नातः सर्वतीर्थेषु सर्वयज्ञेषु दीक्षितः ।\nव्रती व्रतेषु सर्वेषु तपस्वी च तपःसु च ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003183072, "chapter_id": 23183, "verse_number": "४-११९-७३", "content_sanskrit": "स स्तयं सर्वदानानां फलं च लभते ध्रुवम् ।\nलक्षधा स्तोत्रपाठेन स्तोत्रसिद्धिर्भवेन्नृणाम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003183073, "chapter_id": 23183, "verse_number": "४-११९-७४", "content_sanskrit": "सर्वसिद्धिं च लभते सिद्धिस्तोत्रो भवेद्यदि ।\nइहलोके देवतुल्योऽप्यन्ते याति हरेः पदम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}]