[{"id": 2060286, "chapter_id": 2290, "verse_number": "८-११-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2060287, "chapter_id": 2290, "verse_number": "८-११-१", "content_sanskrit": "श्रुतकर्मा ततो राजंश्चित्रसेनं महीपतिम्।\nआजघ्ने समरे क्रुद्धः पञ्चाशद्भिः शिलीमुखैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2060288, "chapter_id": 2290, "verse_number": "८-११-२", "content_sanskrit": "चित्रसेनस्तु तं राजन्नवभिर्नतपर्वभिः।\nश्रुतकर्माणमाहत्य सूतं विव्याध पञ्चभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2060289, "chapter_id": 2290, "verse_number": "८-११-३", "content_sanskrit": "श्रुतकर्मा ततः क्रुद्धश्चित्रसेनं चमूमुखे।\nनाराचेन सुतीक्ष्णेन मर्मदेशे समार्पयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2060290, "chapter_id": 2290, "verse_number": "८-११-४", "content_sanskrit": "सोऽतिविद्धो महाराज नाराचेन महात्मना।\nमूर्च्छामभिययौ वीरः कश्मलं चाविवेश ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2060291, "chapter_id": 2290, "verse_number": "८-११-५", "content_sanskrit": "एतस्मिन्नन्तरे चैनं श्रुतकीर्तिर्महायशाः।\nनवत्या जगतीपालं छादयामास पत्रिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2060292, "chapter_id": 2290, "verse_number": "८-११-६", "content_sanskrit": "प्रतिलभ्य ततः संज्ञां चित्रसेनो महारथः।\nधनुश्चिच्छेद भल्लेन तं च विव्याध सप्तभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2060293, "chapter_id": 2290, "verse_number": "८-११-७", "content_sanskrit": "सोऽन्यत्कार्मुकमादाय वेगघ्नं रुक्मभूषितम्।\nचित्ररूपधरं चक्रे चित्रसेनं शरोर्मिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2060294, "chapter_id": 2290, "verse_number": "८-११-८", "content_sanskrit": "स शरैश्चित्रितो राजा चित्रमाल्यधरो युवा।\nअशोभत महारङ्गे श्वाविच्छललो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2060295, "chapter_id": 2290, "verse_number": "८-११-९", "content_sanskrit": "श्रुतकर्माणमथ वै नाराचेन स्तनान्तरे।\nबिभेद तरसा शूरस्तिष्ठतिष्ठेति चाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2060296, "chapter_id": 2290, "verse_number": "८-११-१०", "content_sanskrit": "श्रुतकर्माणि समरे नाराचेन समर्पितः।\nसुस्राव रुधिरं तत्र गैरिकाम्बु यथाऽचलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2060297, "chapter_id": 2290, "verse_number": "८-११-११", "content_sanskrit": "ततः स रुधिराक्ताङ्गो रुधिरेण कृतच्छविः।\nरराज समरे वीरः सपुष्प इव किंशुकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2060298, "chapter_id": 2290, "verse_number": "८-११-१२", "content_sanskrit": "श्रुतकर्मा ततो राजञ्शत्रुणा समभिद्रुतः।\nशत्रुसंवारणं क्रुद्धो द्विधा चिच्छेद कार्मुकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2060299, "chapter_id": 2290, "verse_number": "८-११-१३", "content_sanskrit": "अथैनं छिन्नधन्वानं नाराचानां शतैस्त्रिभिः।\nछादयन्समरे राजन्विव्याध च सुपत्रिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2060300, "chapter_id": 2290, "verse_number": "८-११-१४", "content_sanskrit": "ततोऽपरेण भल्लेन तीक्ष्णेन निशितेन च।\nजहार सशिरस्त्राणं शिरस्तस्य महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2060301, "chapter_id": 2290, "verse_number": "८-११-१५", "content_sanskrit": "तच्छिरो न्यपतद्भूमौ चित्रसेनस्य दीप्तिमत्।\nयदृच्छया यथा चन्द्रश्च्युतः स्वर्गान्महीतलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2060302, "chapter_id": 2290, "verse_number": "८-११-१६", "content_sanskrit": "राजानं निहतं दृष्ट्वा तेऽभिसारं तु मारिष।\nअभ्यद्रवन्त वेगेन चित्रसेनस्य सैनिकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2060303, "chapter_id": 2290, "verse_number": "८-११-१७", "content_sanskrit": "ततः क्रुद्धो महेष्वासस्तत्सैन्यं प्राद्रवच्छरैः।\nअन्तकाले यथा क्रुद्धः सर्वभूतानि प्रेतराट्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2060304, "chapter_id": 2290, "verse_number": "८-११-१८", "content_sanskrit": "ते वध्यमानाः समरे तव पौत्रेण धन्विना।\nव्यद्रवन्त दिशस्तूर्णं दावदग्धा इव द्विपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2060305, "chapter_id": 2290, "verse_number": "८-११-१९", "content_sanskrit": "तांस्तु विद्रवतो दृष्ट्वा निरुत्साहान्द्विषज्जये।\nद्रावयन्निषुभिस्तीक्ष्णैः श्रुतकर्मा व्यरोचत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2060306, "chapter_id": 2290, "verse_number": "८-११-२०", "content_sanskrit": "प्रतिविन्ध्यस्ततश्चित्रं भित्त्वा पञ्चभिराशुगैः।\nसारथिं च त्रिभिर्विद्व्वा ध्वजमेकेषुणापि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2060307, "chapter_id": 2290, "verse_number": "८-११-२१", "content_sanskrit": "तं चित्रो नवभिर्भल्लैर्बाह्वोरुरसि चार्पयत्।\nस्वर्णपुङ्खैः प्रसन्नाग्नैः कङ्कबर्हिणवाजितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2060308, "chapter_id": 2290, "verse_number": "८-११-२२", "content_sanskrit": "प्रतिविन्ध्यो धनुश्छित्त्वा तस्य बारत सायकेः।\nपञ्चभिर्निशितैर्बाणैरथैनं स हि जघ्निवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2060309, "chapter_id": 2290, "verse_number": "८-११-२३", "content_sanskrit": "ततः शक्तिं महाराज स्वर्णघण्टां दुरासदाम्।\nप्राहिणोत्प्रतिविन्ध्याय विचिन्वन्तीमसूनिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2060310, "chapter_id": 2290, "verse_number": "८-११-२४", "content_sanskrit": "तामापतन्ती सहसा शक्तिमुल्कामिवाम्बरे।\nद्विधा चिच्छेद समरे प्रतिविन्ध्यो हसन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2060311, "chapter_id": 2290, "verse_number": "८-११-२५", "content_sanskrit": "सा पपात द्विधा छिन्ना प्रतिविन्ध्यशरैः शितैः।\nयुगान्ते सर्वभूतानि त्रासयन्ती यथाऽशनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2060312, "chapter_id": 2290, "verse_number": "८-११-२६", "content_sanskrit": "शक्तिं तां प्रहतां दृष्ट्वा चित्रो गृह्य महागदाम्।\nप्रतिविन्ध्याय चिक्षेप रुक्मजालविभूषिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2060313, "chapter_id": 2290, "verse_number": "८-११-२७", "content_sanskrit": "सा जघान हयांस्तस्य सारथिं च महारणे।\nरथं प्रमृद्य वेगेन धरमीमन्वपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2060314, "chapter_id": 2290, "verse_number": "८-११-२८", "content_sanskrit": "एतस्मिन्नेव काले तु रथादाप्लुत्य भारत।\nशक्तिं चिक्षेप चित्राय स्वर्णदण्डामलङ्कृताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2060315, "chapter_id": 2290, "verse_number": "८-११-२९", "content_sanskrit": "तामापतन्तीं जग्राह चित्रो राजन्महामनाः।\nततस्तामेव चिक्षेप प्रतिविन्ध्याय पार्थिवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2060316, "chapter_id": 2290, "verse_number": "८-११-३०", "content_sanskrit": "समासाद्य रणे शूरं प्रतिविन्ध्यं महाप्रभा।\nनिर्भिद्य दक्षिणं बाहुं निपपात महीतले।\nपतिताऽभासयश्चैव तं देशमशनिर्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2060317, "chapter_id": 2290, "verse_number": "८-११-३१", "content_sanskrit": "प्रतिविन्ध्यस्ततो राजंस्तोमरं हेमभूषितम्।\nप्रेषयामास सङ्क्रुद्धश्चित्रस्य वधकाङ्क्षया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2060318, "chapter_id": 2290, "verse_number": "८-११-३२", "content_sanskrit": "स तस्य गात्रावरणं भित्त्वा हृदयमेव च।\nजगाम धरणीं तूर्णं महोरग इवाशयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2060319, "chapter_id": 2290, "verse_number": "८-११-३३", "content_sanskrit": "स पपात तदा राजा तोमरेण समाहतः।\nप्रसार्य विपुलौ बाहू पीनौ पिघसन्निभौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2060320, "chapter_id": 2290, "verse_number": "८-११-३४", "content_sanskrit": "चित्रं सम्प्रेक्ष्य निहतं तावका रणशोभिनः।\nअभ्यद्रवन्त वेगेन प्रतिविन्ध्यं समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2060321, "chapter_id": 2290, "verse_number": "८-११-३५", "content_sanskrit": "सृजन्तो विविधान्बाणाञ्शतघ्नीश्च सकिङ्किणीः।\nतमवच्छादयामासुः सूर्यमभ्रगणा इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2060322, "chapter_id": 2290, "verse_number": "८-११-३६", "content_sanskrit": "तान्विधम्य महाबाहुः शरजालेन संयुगे।\nव्यद्रावयत्तव चमूं वज्रहस्त इवासुरीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2060323, "chapter_id": 2290, "verse_number": "८-११-३७", "content_sanskrit": "ते वध्यमानाः समरे तावकाः पाण्डवैर्नृप।\nविप्रकीर्यन्त सहसा वातनुन्ना घना इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2060324, "chapter_id": 2290, "verse_number": "८-११-३८", "content_sanskrit": "विप्रद्रुते बले तस्मिन्वध्यमाने समन्ततः।\nद्रौणिरेकोऽभ्ययात्तूर्णं भीमसेनं महाबलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2060325, "chapter_id": 2290, "verse_number": "८-११-३९", "content_sanskrit": "तः समागमो घोरो बभूव सहसा तयोः।\nयथा दैवासुरे युद्धे वृत्रवासवयोरिव॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2060326, "chapter_id": 2290, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि षोडशदिवसयुद्धे एकादशोऽध्यायः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]