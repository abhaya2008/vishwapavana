[{"id": 2198772, "chapter_id": 5228, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2198773, "chapter_id": 5228, "verse_number": "१", "content_sanskrit": "ब्रूहि पुत्रान् कुरुश्रेष्ठ वर्णानां त्वं पृथक्पृथक् ।\nकीदृश्यां कीदृशाश्चापि पुत्राः कस्य च के च ते\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2198774, "chapter_id": 5228, "verse_number": "२", "content_sanskrit": "विप्रवादाः सुबहुशः श्रूयन्ते पुत्रकारिताः ।\nअत्र नो मुह्यतां राजन् संशयं छेत्तुमर्हसि\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2198775, "chapter_id": 5228, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2198776, "chapter_id": 5228, "verse_number": "३", "content_sanskrit": "आत्मा पुत्रस्तु विज्ञेयः प्रथमो बहुधा परे ।\nस्वे क्षेत्रे संस्कृते यस्तु पुत्रमुत्पादयेत् स्वयम् ।\nतमौरसं विजानीयात् पुत्रं प्रथमकल्पितम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2198777, "chapter_id": 5228, "verse_number": "४", "content_sanskrit": "अग्निं प्रजापतिं चेष्ट्वा वराय प्रतिपादिता ।\nपुत्रिका स्याद् दुहितरि सङ्कल्पेनापि वा सुतः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2198778, "chapter_id": 5228, "verse_number": "५", "content_sanskrit": "तल्पे जातः प्रमीतस्य क्लीबस्य पतितस्य वा ।\nस्वधर्मेण नियुक्तो यः स पुत्रः क्षेत्रजः स्मृतः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2198779, "chapter_id": 5228, "verse_number": "६", "content_sanskrit": "माता पिता च दद्यातां यमद्भिः पुत्रमापदि ।\nसदृशं प्रीतिसंयुक्तौ विज्ञेयो दत्तकः सुतः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2198780, "chapter_id": 5228, "verse_number": "७", "content_sanskrit": "सदृशं तु प्रकुर्याद् यं गुणदोषविचक्षणम् ।\nपुत्रं पुत्रगुणैर्युक्तं विज्ञेयस्तु स कृत्रिमः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2198781, "chapter_id": 5228, "verse_number": "८", "content_sanskrit": "उत्पद्यते यस्तु गूढं न च ज्ञायेत कस्यचित् ।\nस भवेद् गूढजो नाम तस्य स्याद् यस्य तल्पतः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2198782, "chapter_id": 5228, "verse_number": "९", "content_sanskrit": "मातापितृभ्यामुत्सृष्टः तयोरन्यतरेण वा ।\nयं पुत्रं प्रतिगृह्णीयादपविद्धः स उच्यते\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2198783, "chapter_id": 5228, "verse_number": "१०", "content_sanskrit": "पितृवेश्मनि कन्या तु यं पुत्रं जनयेद् रहः ।\nकानीनं तं वदेन्नाम्ना वोढुः कन्यासमुद्भवः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2198784, "chapter_id": 5228, "verse_number": "११", "content_sanskrit": "या गर्भिणी संस्क्रियते ज्ञाताऽज्ञातापि वा सती ।\nवोढुः स गर्भो भवति सहोढ इति चोच्यते\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2198785, "chapter_id": 5228, "verse_number": "१२", "content_sanskrit": "या पत्या परित्यक्ता अथवा स्वेच्छयाऽपि वा ।\nउत्पादयेदक्षता या स पौनर्भव उच्यते\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2198786, "chapter_id": 5228, "verse_number": "१३", "content_sanskrit": "मातापितृविहीनो वा त्य(स)क्तो वा स्यादकारणात् ।\nआत्मानं स्पर्शयेद् यस्तु स्वयंदत्तः स उच्यते\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2198787, "chapter_id": 5228, "verse_number": "१४", "content_sanskrit": "क्रीणीयाद् यस्त्वपत्यार्थं मातापित्रोर्यमन्तिकात् ।\nस सुतस्तस्य सदृशः क्रीतो नाम बुधैः स्मृतः ।\nद्वादशैते परे प्राहुरेवं धर्मस्य पालकाः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2198788, "chapter_id": 5228, "verse_number": "१५", "content_sanskrit": "आत्मा पुत्रस्तु विज्ञेयस्तस्यानन्तरजश्च यः ।\nनियुक्तजश्च विज्ञेयः सुतः प्रसृतजस्तथा\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2198789, "chapter_id": 5228, "verse_number": "१६", "content_sanskrit": "पतितस्य च भार्यायां भर्त्रा सुसमवेतया ।\nतथा दत्तकृतौ पुत्रावध्यूढश्च तथापरः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2198790, "chapter_id": 5228, "verse_number": "१७", "content_sanskrit": "षडपध्वंसजाश्चापि कानीनापशदास्तथा ।\nइत्येते ते समाख्यातास्तान् विजानीहि भारत\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2198791, "chapter_id": 5228, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2198792, "chapter_id": 5228, "verse_number": "१८", "content_sanskrit": "षडपध्वंसजाः के स्युः के वाप्यपशदास्तथा ।\nएतत्सर्वं यथातत्त्वं व्याख्यातुं मे त्वमर्हसि\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2198793, "chapter_id": 5228, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2198794, "chapter_id": 5228, "verse_number": "१९", "content_sanskrit": "त्रिषु वर्णेषु ये पुत्रा ब्राह्मणस्य युधिष्ठिर ।\nवर्णयोश्च द्वयोः स्यातां यौ राजन्यस्य भारत\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2198795, "chapter_id": 5228, "verse_number": "२०", "content_sanskrit": "एको विड्वर्ण एवाथ तथात्रैवोपलक्षितः ।\nषडपध्वंसजास्ते हि तथैवापशदान् शृणु\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2198796, "chapter_id": 5228, "verse_number": "२१", "content_sanskrit": "चण्डालो व्रात्यवेनौ च ब्राह्मण्यां क्षत्रियासु च ।\nवैश्यायां चैव शूद्रस्य लक्ष्यन्तेऽपशदास्त्रयः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2198797, "chapter_id": 5228, "verse_number": "२२", "content_sanskrit": "मागधो वामकश्चैव द्वौ वैश्यस्योपलक्षितौ ।\nब्राह्मण्यां क्षत्रियायां च क्षत्रियस्यैक एव तु\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2198798, "chapter_id": 5228, "verse_number": "२३", "content_sanskrit": "ब्राह्मण्यां लक्ष्यते सूत इत्येतेऽपशदाः स्मृताः ।\nपुत्ररेतो न शक्यं हि मिथ्या कर्तुं नराधिप\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2198799, "chapter_id": 5228, "verse_number": "२४", "content_sanskrit": "शूद्रस्य प्रतिलोमेन चण्डालाः क्रमशोऽधमाः ।\nत्रयस्ते द्वौ तु वैश्यस्य क्षत्रियस्यैक एव च \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2198800, "chapter_id": 5228, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2198801, "chapter_id": 5228, "verse_number": "२५", "content_sanskrit": "क्षेत्रजं केचिदेवाहुः सुतं केचित्तु शुक्लजम् ।\nतुल्यावेतौ सुतौ कस्य तन्मे ब्रूहि पितामह\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2198802, "chapter_id": 5228, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2198803, "chapter_id": 5228, "verse_number": "२६", "content_sanskrit": "रेतजो वा भवेत् पुत्रस्त्यक्तो वा क्षेत्रजो भवेत् ।\nअध्यूढः समयं भित्त्वेत्येतदेव निबोध मे\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2198804, "chapter_id": 5228, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2198805, "chapter_id": 5228, "verse_number": "२७", "content_sanskrit": "रेतोजं विद्म वै पुत्रं क्षेत्रजस्यागमः कथम् ।\nअध्यूढं विद्म वै पुत्रं भित्त्वा च समयं कथम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2198806, "chapter_id": 5228, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2198807, "chapter_id": 5228, "verse_number": "२८", "content_sanskrit": "आत्मजं पुत्रमुत्पाद्य यस्त्यजेत् कारणान्तरे ।\nन तत्र कारणं रेतः स क्षेत्रस्वामिनो भवेत्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2198808, "chapter_id": 5228, "verse_number": "२९", "content_sanskrit": "पुत्रकामो हि पुत्रार्थे यां वृणीते विशाम्पते ।\nतत्र क्षेत्रं प्रमाणं स्यान्न वै तत्रात्मजः सुतः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2198809, "chapter_id": 5228, "verse_number": "३०", "content_sanskrit": "अन्यस्तु क्षेत्रजः पुत्रो लक्ष्यते भरतर्षभ ।\nन ह्यात्मा शक्यते हन्तुं दृष्टान्तोपगतो ह्यसौ\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2198810, "chapter_id": 5228, "verse_number": "३१", "content_sanskrit": "कश्चिच्च कृतकः पुत्रः सङ्ग्रहादेव लक्ष्यते ।\nन तत्र रेतः क्षेत्रं वा प्रमाणं स्याद् युधिष्ठिर\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2198811, "chapter_id": 5228, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2198812, "chapter_id": 5228, "verse_number": "३२", "content_sanskrit": "कीदृशः कृतकः पुत्रः सङ्ग्रहादेव लक्ष्यते ।\nशुक्रं क्षेत्रं प्रमाणं वा यत्र लक्ष्येत भारत\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2198813, "chapter_id": 5228, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2198814, "chapter_id": 5228, "verse_number": "३३", "content_sanskrit": "मातापितृभ्यां सन्त्यक्तं पथि यं तु प्रलक्षयेत् ।\nन चास्य मातापितरौ ज्ञायेते स हि कृत्रिमः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2198815, "chapter_id": 5228, "verse_number": "३४", "content_sanskrit": "अस्वामिकस्य स्वामित्वं यस्मिन् सम्प्रतिलक्षयेत् ।\nसवर्णस्तं च पोषेत सवर्णस्तस्य जायते\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2198816, "chapter_id": 5228, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2198817, "chapter_id": 5228, "verse_number": "३५", "content_sanskrit": "कथमस्य प्रयोक्तव्यः संस्कारः कस्य वा कथम् ।\nदेया कन्या कथं चेति तन्मे ब्रूहि पितामह\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2198818, "chapter_id": 5228, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2198819, "chapter_id": 5228, "verse_number": "३६", "content_sanskrit": "आत्मवत्तस्य कुर्वीत संस्कारं स्वामिवत् तथा ।\nत्यक्तो मातापितृभ्यां यः सवर्णं प्रतिपद्यते ।\nतद्गोत्रवर्णतस्तस्य कुर्यात् संस्कारमच्युत\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2198820, "chapter_id": 5228, "verse_number": "३७", "content_sanskrit": "अथ देया तु कन्या स्यात् तद्वर्णेन युधिष्ठिर ।\nसंस्कर्तुं मातृगोत्रं च मातृवर्णविनिश्चये\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2198821, "chapter_id": 5228, "verse_number": "३८", "content_sanskrit": "कानीनाध्यूढजौ चापि विज्ञेयौ पुत्रकिल्बिषौ ।\nतावपि स्वाविव सुतौ संस्कार्याविति निश्चयः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2198822, "chapter_id": 5228, "verse_number": "३९", "content_sanskrit": "क्षेत्रजो वाप्यपशदो येऽध्यूढास्तेषु चाप्यथ ।\nआत्मवद् वै प्रयुञ्जीरन् संस्कारं ब्राह्मणादयः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2198823, "chapter_id": 5228, "verse_number": "४०", "content_sanskrit": "धर्मशास्त्रेषु वर्णानां निश्चयोऽयं प्रदृश्यते ।\nएतत् ते सर्वमाख्यातं किं भूयः श्रोतुमिच्छसि\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2198824, "chapter_id": 5228, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम्\nअनुशासनपर्वणि दानधर्मे पुत्रभेदकथनं नाम एकोनाशीतितमोऽध्यायः ॥७९॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]