[{"id": 7006476000, "chapter_id": 26476, "verse_number": "३-१५-१", "content_sanskrit": "जनमेजयेन महाभारतवर्णितस्य चरित्रस्य प्रशंसा जनमेजय उवाच श्रुतं नः परमं ब्रह्मन् स्ववंशचरितं महत् ।\nदिव्यमन्योन्यसम्भूतं मानितं बहुभिर्गुणैः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006476001, "chapter_id": 26476, "verse_number": "३-१५-२", "content_sanskrit": "छन्दोभिर्वृत्तसंजातैः समासैश्च सविस्तरैः ।\nलघुभिर्मधुराभाषैर्ग्रथितं पदविग्रहैः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006476002, "chapter_id": 26476, "verse_number": "३-१५-३", "content_sanskrit": "त्रिवर्गेणाभिसम्पन्नं धर्मेणार्थेन भोगिनाम् ।\nकामेन बहुरूपेण शरीरान्तर्गतेन च ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006476003, "chapter_id": 26476, "verse_number": "३-१५-४", "content_sanskrit": "ब्राह्मणानां प्रभावैश्च योधानां च पराक्रमैः ।\nवैरनिर्यातनैश्चैव प्रतिज्ञानां च पारगैः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006476004, "chapter_id": 26476, "verse_number": "३-१५-५", "content_sanskrit": "रिपुस्तवसुसम्पन्नैर्नानुबन्धः प्रचोदितः ।\nवंशयोर्निर्विनाशाय नृपेण द्विज विग्रहात् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006476005, "chapter_id": 26476, "verse_number": "३-१५-६", "content_sanskrit": "ये च तस्मिन् महारौद्रे संग्रामे निहता नृपाः ।\nतेषां सर्वाणि राष्ट्राणि पुत्राः सर्वे प्रपेदिरे ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006476006, "chapter_id": 26476, "verse_number": "३-१५-७", "content_sanskrit": "कौरवः प्रथितो राजा भगवच्छासनानुगः ।\nधर्मश्च बहुधा प्रोक्तस्त्रयाणां वर्णसम्पदाम् ।\nशूराणामपि विख्यातः स्वर्गहेतुर्द्विजर्षभ ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006476007, "chapter_id": 26476, "verse_number": "३-१५-८", "content_sanskrit": "अनुग्रहार्थं भूतानां नोत्सेकाय कथंचन ।\nचतुर्णां वर्णसंज्ञानां पृयक्पृथगनेकधा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006476008, "chapter_id": 26476, "verse_number": "३-१५-९", "content_sanskrit": "गर्भवासं पतन्तश्च भूतानां सम्प्रबोधिताः ।\nपृच्छन्तो देवसंचारं क्षीणे पुण्ये च कर्मणि ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006476009, "chapter_id": 26476, "verse_number": "३-१५-१०", "content_sanskrit": "दाने यश्चापि संयोगः स चापि बहुधा कृतः ।\nद्वयोः संयोगविहितं मधु वाग्वचनं तयोः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006476010, "chapter_id": 26476, "verse_number": "३-१५-११", "content_sanskrit": "न तच्छक्यं मयाऽऽख्यातुं भारताध्ययनं महत् ।\nएकाहेन महान् ब्रह्मन्नपि दिव्येन चक्षुषा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006476011, "chapter_id": 26476, "verse_number": "३-१५-१२", "content_sanskrit": "ब्रह्मणोऽह्नस्तु विस्तारं संक्षेपं च सुसंग्रहम् ।\nश्रोतुमिच्छामि भगवन्महत्कौतूहलं हि मे ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}]