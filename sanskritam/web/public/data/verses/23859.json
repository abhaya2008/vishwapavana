[{"id": 7003859000, "chapter_id": 23859, "verse_number": "२-५-१०-१", "content_sanskrit": "ब्रह्मोवाच ।\nनैवेद्यानंतरं तात किं कर्तव्यं नृभिः प्रभो ।\nयत्कर्तव्यं सहोमासे तत्सर्वं ब्रूहि तत्त्वतः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003859001, "chapter_id": 23859, "verse_number": "२-५-१०-२", "content_sanskrit": "श्रीभगवानुवाच ।\nअथ भुक्तवते दत्त्वा जलैः कर्पूरवासितैः ।\nआचमनं च तांबूलं चंदनं करमार्जनम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003859002, "chapter_id": 23859, "verse_number": "२-५-१०-३", "content_sanskrit": "पुष्पांजलिं ततः कुर्याद्भक्त्याऽदर्शं प्रदर्शयेत् ।\nनीराजनं ततः कार्यं कार्पूरं विभवे सति ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003859003, "chapter_id": 23859, "verse_number": "२-५-१०-४", "content_sanskrit": "समर्प्य मुकुटादीनि भूषणानि विचक्षणः ।\nततः पश्चान्महाभाग प्रकल्प्य च्छत्रचामरे ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003859004, "chapter_id": 23859, "verse_number": "२-५-१०-५", "content_sanskrit": "प्रसादसुमुखं ध्यात्वा श्यामसुंदरविग्रहम् ।\nजपेदष्टोत्तरशतं स्तुवीत स्तुतिभिः प्रभुम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003859005, "chapter_id": 23859, "verse_number": "२-५-१०-६", "content_sanskrit": "शंखरौप्यमयी माला कांचनी च विशेषतः ।\nपद्माक्षैश्चैव सुभगैर्विद्रुमैर्मणिमौक्तिकैः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003859006, "chapter_id": 23859, "verse_number": "२-५-१०-७", "content_sanskrit": "रचितेंद्राक्षकैर्माला तथैवांगुलिपर्वभिः ।\nपुत्रजीवमयी माला शस्ता वै जपकर्मणि ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003859007, "chapter_id": 23859, "verse_number": "२-५-१०-८", "content_sanskrit": "न च क्रमन्न च हसन्न पार्श्वमवलोकयन् ।\nन पदा पदमाक्राम्य करप्राप्तशिरास्तथा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003859008, "chapter_id": 23859, "verse_number": "२-५-१०-९", "content_sanskrit": "नोत्तिष्ठन्मन्मनुं विद्वान्न जपेद्व्यग्रमानसः ।\nजपकाले न भाषेत व्रतहोमार्चनादिषु ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003859009, "chapter_id": 23859, "verse_number": "२-५-१०-१०", "content_sanskrit": "गृहेष्वेकगुणंजाप्यं गोष्ठे दशगुणं भवेत् ।\nनदीतीरे शतं विद्यादग्न्यगारे दशाऽधिकम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003859010, "chapter_id": 23859, "verse_number": "२-५-१०-११", "content_sanskrit": "तीर्थादिषु सहस्रं स्यादनंतं मम सन्निधौ ।\nएवं कृत्वा सहोमासे यः कुर्याच्च प्रदक्षिणाम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003859011, "chapter_id": 23859, "verse_number": "२-५-१०-१२", "content_sanskrit": "सप्तद्वीपवतीपुण्यं लभते स पदेपदे ।\nपठन्नामसहस्रं तु अथवा नाम केवलम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003859012, "chapter_id": 23859, "verse_number": "२-५-१०-१३", "content_sanskrit": "एका प्रदक्षिणा भक्त्या दहेत्पापं सदाऽह्निकम् ।\nप्रदक्षिणीकृता तेन सप्तद्वीपा वसुन्धरा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003859013, "chapter_id": 23859, "verse_number": "२-५-१०-१४", "content_sanskrit": "दिनसप्तोद्भवं पापं मम तिस्रः प्रदक्षिणाः ।\nतत्क्षणान्नाशयंत्येव पापं देहे दशाऽह्निकम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003859014, "chapter_id": 23859, "verse_number": "२-५-१०-१५", "content_sanskrit": "कृताः प्रदक्षिणा येन एकविंशति भक्तितः ।\nभ्रूणहत्यादिपापानि नाशमायांति तत्क्षणात् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003859015, "chapter_id": 23859, "verse_number": "२-५-१०-१६", "content_sanskrit": "अष्टोत्तरशतं येन कृता भक्त्या प्रदक्षिणाः ।\nतेनेष्टं क्रतुभिः सर्वैः समाप्तवरदक्षिणैः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003859016, "chapter_id": 23859, "verse_number": "२-५-१०-१७", "content_sanskrit": "प्रदक्षिणीकृता तेन तावद्वारं वसुन्धरा ।\nमातुः प्रदक्षिणास्तद्वद्भूतधात्रीप्रदक्षिणाः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003859017, "chapter_id": 23859, "verse_number": "२-५-१०-१८", "content_sanskrit": "शालिग्रामशिलायाश्च सममेतत्त्रयं स्मृतम् ।\nएको दंडप्रपातश्च सहे सप्तप्रदक्षिणाः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003859018, "chapter_id": 23859, "verse_number": "२-५-१०-१९", "content_sanskrit": "सममेतद्द्वयं नो वा दंडपातो विशिष्यते ।\nप्रदक्षिणे दंडपातं यः करोति सदा मम ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003859019, "chapter_id": 23859, "verse_number": "२-५-१०-२०", "content_sanskrit": "सहोमासे विशेषेण आकल्पं स वसेद्दिवि ।\nकल्पादनंतरं तात चक्रवर्ती प्रजायते ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003859020, "chapter_id": 23859, "verse_number": "२-५-१०-२१", "content_sanskrit": "चिरायुर्धनवान्भोगी दानवान्धर्मवत्सलः ।\nसहस्रनामपठनात्पापं नश्येत्त्रिधा कृतम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003859021, "chapter_id": 23859, "verse_number": "२-५-१०-२२", "content_sanskrit": "अथ किं बहुनोक्तेन शृणु गुह्यं च मे सुत ।\nदामोदरेति नाम्ना वै भवेत्प्रीतिर्ममाऽतुला ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003859022, "chapter_id": 23859, "verse_number": "२-५-१०-२३", "content_sanskrit": "गुणसंबंधि मन्नाम कृतं मात्रा यशोदया ।\nयदा मे दधिभांडस्य स्फोटनं गोकुले कृतम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003859023, "chapter_id": 23859, "verse_number": "२-५-१०-२४", "content_sanskrit": "तदा यशोदया गाढं बद्धो दाम्ना ह्युलूखले ।\nततः प्रभृति मे नाम ख्यातं दामोदरेति च ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003859024, "chapter_id": 23859, "verse_number": "२-५-१०-२५", "content_sanskrit": "नमो दामोदरायेति जपेद्यः सुसमाहितः ।\nसूर्योदये शुचिर्भूत्वा त्रिसहस्रं दिनेदिने ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003859025, "chapter_id": 23859, "verse_number": "२-५-१०-२६", "content_sanskrit": "सार्द्धलक्षत्रयं यावत्तत उद्यापयेद्बुधः ।\nतर्पणं हवनं चैव ब्रह्मभोज्यं दशांशतः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003859026, "chapter_id": 23859, "verse_number": "२-५-१०-२७", "content_sanskrit": "एवं यः कुरुते भक्त्या तस्य यच्छामि वांछितम् ।\nधनं धान्यं तथा दारान्पुत्रांश्चान्यच्च वांछितम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003859027, "chapter_id": 23859, "verse_number": "२-५-१०-२८", "content_sanskrit": "त्रिसत्येन मया चोक्तं श्रद्धत्स्व त्वं महामते ।\nमंत्रराजमिमं पुत्र कृपया मे प्रकाशितम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003859028, "chapter_id": 23859, "verse_number": "२-५-१०-२९", "content_sanskrit": "दामोदरायेति पठन्नित्यं कुर्यात्प्रदक्षिणम् ।\nदंडपातं तथा पुत्र अष्टांगेन समन्वितम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003859029, "chapter_id": 23859, "verse_number": "२-५-१०-३०", "content_sanskrit": "पद्भ्यां कराभ्यां जानुभ्यामुरसा शिरसा तथा ।\nमनसा वचसा दृष्टवा प्रणामोष्टांग उच्यते ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003859030, "chapter_id": 23859, "verse_number": "२-५-१०-३१", "content_sanskrit": "शिरो मत्पादयोः कृत्वा बाहुभ्यां च परस्परम् ।\nप्रपन्नं पाहि मामीश भीतं मृत्युग्रहाऽर्णवात् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003859031, "chapter_id": 23859, "verse_number": "२-५-१०-३२", "content_sanskrit": "पश्चाच्छेषां मया दत्तां शिरस्याधाय सादरम् ।\nएवं ब्रूयात्ततो वत्स मम पूजाप्रपूर्त्तये ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003859032, "chapter_id": 23859, "verse_number": "२-५-१०-३३", "content_sanskrit": "मंत्रहीनं क्रियाहीनं भक्तिहीनं जनार्दन ।\nयत्पूजितं मया देव परिपूर्णं तदस्तु मे ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003859033, "chapter_id": 23859, "verse_number": "२-५-१०-३४", "content_sanskrit": "मृदंगवाद्येन समं प्रणवेन सुसंयुतम् ।\nएवं कार्यं सहोमासे नृत्यं पुण्यप्रदं नृणाम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003859034, "chapter_id": 23859, "verse_number": "२-५-१०-३५", "content_sanskrit": "गीतं वाद्यं च नृत्यं च तथा पुस्तकवाचनम् ।\nपूजाकाले चतुर्वक्त्र सर्वदा मम च प्रियम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003859035, "chapter_id": 23859, "verse_number": "२-५-१०-३६", "content_sanskrit": "गीतवाद्याद्यभावे च मम नामसहस्रकम् ।\nस्तवराजं तथा पुत्र गजेंद्रस्य च मोक्षणम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003859036, "chapter_id": 23859, "verse_number": "२-५-१०-३७", "content_sanskrit": "अनुस्मृतिश्च गीता च स्तवनं पंचधा मतम् ।\nपंचस्तवं महाभाग मम प्रीतिकरं परम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003859037, "chapter_id": 23859, "verse_number": "२-५-१०-३८", "content_sanskrit": "पादोदकं पिबेद्यो वै शालिग्रामसमुद्भवम् ।\nपंचगव्यसहस्रैस्तु प्राशितैः किं प्रयोजनम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003859038, "chapter_id": 23859, "verse_number": "२-५-१०-३९", "content_sanskrit": "शालिग्रामशिलातोयं यः पिबेद्बिंदुना समम् ।\nमातुः स्तन्यं पुनर्नैव स पिबेन्मुक्तिभाग्नरः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003859039, "chapter_id": 23859, "verse_number": "२-५-१०-४०", "content_sanskrit": "आशौचं नैव विद्येत सूतके मृतकेऽपि च ।\nयेषां पादोदकं मूर्ध्नि प्राशनं ये प्रकुर्वते ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003859040, "chapter_id": 23859, "verse_number": "२-५-१०-४१", "content_sanskrit": "अंतकालेऽपि यस्येदं दीयते पादयोर्जलम् ।\nसोऽपि सद्गतिमाप्नोति सदाचारबहिष्कृतः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003859041, "chapter_id": 23859, "verse_number": "२-५-१०-४२", "content_sanskrit": "अपेयं पिबते यस्तु भुंक्ते यद्यप्यभोजनम् ।\nअगम्यागमनो यो वै पापाचारश्च यो नरः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003859042, "chapter_id": 23859, "verse_number": "२-५-१०-४३", "content_sanskrit": "सोऽपि पूतो भवत्याशु सद्यः पादांबुधारणात् ।\nचांद्रायणात्पादकृच्छ्रादधिकं पादयोर्जलम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003859043, "chapter_id": 23859, "verse_number": "२-५-१०-४४", "content_sanskrit": "अगुरुं कुंकुमं वाऽपि कर्पूरं चाऽनुलेपनम् ।\nमम पादांबुसंस्पृष्टं तद्वै पावनपावनम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003859044, "chapter_id": 23859, "verse_number": "२-५-१०-४५", "content_sanskrit": "दृष्टिपूतं तु यत्तोयं भवेद्वै विप्रसत्तम ।\nतद्वै पापहरं नृणां किं पुनः पादयोर्जलम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003859045, "chapter_id": 23859, "verse_number": "२-५-१०-४६", "content_sanskrit": "प्रियस्त्वं मेऽग्रजः पुत्रो विशेषेण च मत्प्रियः ।\nतदर्थं कथितं सर्वं रहस्यं यच्च मे स्थितम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003859046, "chapter_id": 23859, "verse_number": "२-५-१०-४७", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां द्वितीये वैष्णवखंडे ब्रह्मविष्णुसंवादे मार्गशीर्षमाहात्म्ये पूजाविधिसमापनं तदुद्यापनं तत्फलकथनयोगोनाम दशमोऽध्यायः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]