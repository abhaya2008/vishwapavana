[{"id": 6000277000, "chapter_id": 10277, "verse_number": null, "content_sanskrit": "अथ एकाशीतितमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000277001, "chapter_id": 10277, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_081/BhP_10.081.001.m4a", "display_order": 2}, {"id": 6000277002, "chapter_id": 10277, "verse_number": "१०-८१-१", "content_sanskrit": "इत्युदीरितमाकर्ण्य देवर्षेरुद्धवोऽब्रवीत्।\nसभ्यानां मतमाज्ञाय कृष्णस्य च महामतिः॥ १०/८१/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_081/BhP_10.081.002.m4a", "display_order": 3, "topics": [{"text": "उद्धववचनेन राजदूतं समाश्वास्य प्रेषणम्", "range": "१–११"}]}, {"id": 6000277003, "chapter_id": 10277, "verse_number": null, "content_sanskrit": "उद्धव उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_081/BhP_10.081.003.m4a", "display_order": 4}, {"id": 6000277004, "chapter_id": 10277, "verse_number": "१०-८१-२", "content_sanskrit": "यदुक्तं ऋषिणा देव साचिव्यं यक्ष्यतस्त्वया।\nकार्यं पैतृष्वसेयस्य रक्षा च शरणैषिणाम्॥ १०/८१/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_081/BhP_10.081.004.m4a", "display_order": 5}, {"id": 6000277005, "chapter_id": 10277, "verse_number": "१०-८१-३", "content_sanskrit": "यष्टव्यं राजसूयेन दिक्चक्रजयिना विभो।\nअतो जरासुतवध उभयार्थो मतो हि मे॥ १०/८१/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_081/BhP_10.081.005.m4a", "display_order": 6}, {"id": 6000277006, "chapter_id": 10277, "verse_number": "१०-८१-४", "content_sanskrit": "अस्माकं च महानर्थो ह्येतेनैव भविष्यति।\nयशश्च तव गोविन्द राज्ञो बन्धाद् विमुच्यतः॥ १०/८१/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_081/BhP_10.081.006.m4a", "display_order": 7}, {"id": 6000277007, "chapter_id": 10277, "verse_number": "१०-८१-५", "content_sanskrit": "सर्वैर्दुर्विषहो राजा नागायुतसमो बले।\nबलिनामपि चान्येषां भीमसेनबलं विना॥ १०/८१/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_081/BhP_10.081.007.m4a", "display_order": 8}, {"id": 6000277008, "chapter_id": 10277, "verse_number": "१०-८१-६", "content_sanskrit": "द्वैरथे स तु जेतव्यो न शताक्षौहिणीयुतः।\nब्रह्मण्योऽभ्यर्थितो विप्रैर्न प्रत्याख्याति कर्हिचित्॥ १०/८१/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_081/BhP_10.081.008.m4a", "display_order": 9}, {"id": 6000277009, "chapter_id": 10277, "verse_number": "१०-८१-७", "content_sanskrit": "ब्रह्मवेषधरो भूत्वा तं भिक्षेत वृकोदरः।\nहनिष्यति न सन्देहो द्वैरथे तव सन्निधौ॥ १०/८१/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_081/BhP_10.081.009.m4a", "display_order": 10}, {"id": 6000277010, "chapter_id": 10277, "verse_number": "१०-८१-८", "content_sanskrit": "निमित्तमात्रमीशस्य विश्वसर्गनिरोधयोः।\nहिरण्यगर्भः शर्वश्च कालाख्यारूपिणस्तव॥ १०/८१/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_081/BhP_10.081.010.m4a", "display_order": 11}, {"id": 6000277011, "chapter_id": 10277, "verse_number": "१०-८१-९", "content_sanskrit": "गायन्ति ते विशदकर्म गृहेषु देव्यो राज्ञां स्वशत्रुवधमात्मविमोक्षणं च।\nगोप्यश्च कुञ्जरपतेर्जनकात्मजायाः पित्रोश्च लब्धशरणा मुनयो वयं च॥ १०/८१/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_081/BhP_10.081.011.m4a", "display_order": 12}, {"id": 6000277012, "chapter_id": 10277, "verse_number": "१०-८१-१०", "content_sanskrit": "जरासन्धवधः कृष्ण भूर्यर्थायोपकल्प्यते।\nप्रायः कालविपाकेनतव चाभिमतः क्रतुः॥ १०/८१/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_081/BhP_10.081.012.m4a", "display_order": 13}, {"id": 6000277013, "chapter_id": 10277, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_081/BhP_10.081.013.m4a", "display_order": 14}, {"id": 6000277014, "chapter_id": 10277, "verse_number": "१०-८१-११", "content_sanskrit": "इत्युद्धववचो राजन् सर्वतोभद्रमच्युतः।\nदेवर्षिर्यदुवृद्धाश्च रामश्च प्रत्यपूजयन्॥ १०/८१/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_081/BhP_10.081.014.m4a", "display_order": 15}, {"id": 6000277015, "chapter_id": 10277, "verse_number": "१०-८१-१२", "content_sanskrit": "अथादिशत् प्रयाणाय भगवान् देवकीसुतः।\nभृत्यान् दारुकजैत्रादीननुज्ञाप्य गुरून् विभुः॥ १०/८१/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_081/BhP_10.081.015.m4a", "display_order": 16, "topics": [{"text": "इन्द्रप्रस्थगमनं युधिष्ठिरादिपूजास्वीकारश्च", "range": "१२–४४"}]}, {"id": 6000277016, "chapter_id": 10277, "verse_number": "१०-८१-१३", "content_sanskrit": "स निर्गम्यावरोधान् स्वान् ससुतान् सपरिच्छदान्। सङ्कर्षणमनुज्ञाप्य यदुराजं च शत्रुहा।\nसूतोपनीतं स्वरथमारुहद् गरुडध्वजम्॥ १०/८१/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_081/BhP_10.081.016.m4a", "display_order": 17}, {"id": 6000277017, "chapter_id": 10277, "verse_number": "१०-८१-१४", "content_sanskrit": "ततो रथद्विपभटसादिनायकैः करालया परिवृत आत्मसेनया।\nमृदङ्गभेर्यानकशङ्खगोमुखैः सङ्घुष्टया वै ककुभो निराक्रमत्॥ १०/८१/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_081/BhP_10.081.017.m4a", "display_order": 18}, {"id": 6000277018, "chapter_id": 10277, "verse_number": "१०-८१-१५", "content_sanskrit": "प्रियाश्च काश्चन शिबिकाभिरच्युतं सहात्मजाः पतिमनु सुव्रता ययुः।\nवराम्बराभरणविलेपनस्रजः सुसंवृता नृभिरसिचर्मपाणिभिः॥ १०/८१/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_081/BhP_10.081.018.m4a", "display_order": 19}, {"id": 6000277019, "chapter_id": 10277, "verse_number": "१०-८१-१६", "content_sanskrit": "नरोष्ट्रगोमहिषखराश्वतर्यनःकरेणुभिः परिजनवारयोषितः।\nस्वलङ्कृताः पटकुटिकम्बलाम्बराद्युपस्करा ययुरधियुज्य सर्वशः॥ १०/८१/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_081/BhP_10.081.019.m4a", "display_order": 20}, {"id": 6000277020, "chapter_id": 10277, "verse_number": "१०-८१-१७", "content_sanskrit": "बलं बृहद्ध्वजपटच्छत्रचामरैर्वरायुधाभरणकिरीटवर्मभिः।\nदिवांऽशुभिस्तुमुलरवं बभौ रवेर्यथाऽर्णवः क्षुभिततिमिङ्गिलोर्मिभिः॥ १०/८१/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_081/BhP_10.081.020.m4a", "display_order": 21}, {"id": 6000277021, "chapter_id": 10277, "verse_number": "१०-८१-१८", "content_sanskrit": "अथो मुनिर्यदुपतिना सभाजितः प्रणम्य तं हृदि निदधद् विहायसा।\nनिशम्यागाद् व्यवसितमाहृतार्हणो मुकुन्दसन्दर्शननिर्वृतेन्द्रियः॥ १०/८१/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_081/BhP_10.081.021.m4a", "display_order": 22}, {"id": 6000277022, "chapter_id": 10277, "verse_number": "१०-८१-१९", "content_sanskrit": "राज्ञां दूतमुवाचेदं भगवान् प्रेमया गिरा।\nमा भैष्ट दूत भद्रं वो घातयिष्यामि मागधम्॥ १०/८१/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_081/BhP_10.081.022.m4a", "display_order": 23}, {"id": 6000277023, "chapter_id": 10277, "verse_number": "१०-८१-२०", "content_sanskrit": "इत्युक्तः प्रस्थितो दूतो यथावदवदन्नृपान्।\nतेऽपि सन्दर्शनं शौरेः प्रत्यैक्षन्त मुमुक्षवः॥ १०/८१/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_081/BhP_10.081.023.m4a", "display_order": 24}, {"id": 6000277024, "chapter_id": 10277, "verse_number": "१०-८१-२१", "content_sanskrit": "आनर्तसौवीरमरूंस्तीर्त्वा विनशनं हरिः।\nनदीर्गिरीनतीयाय पुरग्रामव्रजाकरान्॥ १०/८१/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_081/BhP_10.081.024.m4a", "display_order": 25}, {"id": 6000277025, "chapter_id": 10277, "verse_number": "१०-८१-२२", "content_sanskrit": "ततो दृषद्वतीं तीर्त्वा मुकुन्दोऽथ सरस्वतीम्।\nपाञ्चालानथ मत्स्यांश्च शक्रप्रस्थमथागमत्॥ १०/८१/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_081/BhP_10.081.025.m4a", "display_order": 26}, {"id": 6000277026, "chapter_id": 10277, "verse_number": "१०-८१-२३", "content_sanskrit": "तमुपागतमाकर्ण्य प्रीतो दुर्दर्शनं नृणाम्।\nअजातशत्रुर्निरगात् सोपाध्यायः सुहृद्वृतः॥ १०/८१/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_081/BhP_10.081.026.m4a", "display_order": 27}, {"id": 6000277027, "chapter_id": 10277, "verse_number": "१०-८१-२४", "content_sanskrit": "गीतवादित्रघोषेण ब्रह्मघोषेण भूयसा।\nअभ्ययात् स हृषीकेशं प्राणाः प्राणमिवागतम्॥ १०/८१/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_081/BhP_10.081.027.m4a", "display_order": 28}, {"id": 6000277028, "chapter_id": 10277, "verse_number": "१०-८१-२५", "content_sanskrit": "दृष्ट्वा विक्लिन्नहृदयः कृष्णस्नेहेन पाण्डवः।\nचिराद् दृष्टं प्रियतमं सस्वजे स्म पुनः पुनः॥ १०/८१/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_081/BhP_10.081.028.m4a", "display_order": 29}, {"id": 6000277029, "chapter_id": 10277, "verse_number": "१०-८१-२६", "content_sanskrit": "दोर्भ्यां परिष्वज्य रमालयालयं मुकुन्दगात्रं नृपतिर्हताशुभः।\nलेभे परां निर्वृतिमश्रुलोचनो हृष्यत्तनुर्विस्मृतलोकविभ्रमः॥ १०/८१/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_081/BhP_10.081.029.m4a", "display_order": 30}, {"id": 6000277030, "chapter_id": 10277, "verse_number": "१०-८१-२७", "content_sanskrit": "तं मातुलेयं परिरभ्य निर्वृतो भीमः स्मयन् प्रेमजलाकुलेन्द्रियः।\nयमौ किरीटी च सुहृत्तमं मुदा प्रवृद्धबाष्पाः परिरेभिरेऽच्युतम्॥ १०/८१/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_081/BhP_10.081.030.m4a", "display_order": 31}, {"id": 6000277031, "chapter_id": 10277, "verse_number": "१०-८१-२८", "content_sanskrit": "अर्जुनेन परिष्वक्तो यमाभ्यामभिवन्दितः।\nब्राह्मणेभ्यो नमस्कृत्य वृद्धेभ्यश्च यथार्हतः॥ १०/८१/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_081/BhP_10.081.031.m4a", "display_order": 32}, {"id": 6000277032, "chapter_id": 10277, "verse_number": "१०-८१-२९", "content_sanskrit": "मानिनो मानयामास कुरुसृञ्जयकेकयान्।\nसूतमागधगन्धर्वा बन्दिनश्चोपमन्त्रिणः॥ १०/८१/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_081/BhP_10.081.032.m4a", "display_order": 33}, {"id": 6000277033, "chapter_id": 10277, "verse_number": "१०-८१-३०", "content_sanskrit": "मृदङ्गशङ्खपटहवीणापणववेणुभिः।\nब्राह्मणाश्चारविन्दाक्षं तुष्टुवुर्ननृतुर्जगुः॥ १०/८१/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_081/BhP_10.081.033.m4a", "display_order": 34}, {"id": 6000277034, "chapter_id": 10277, "verse_number": "१०-८१-३१", "content_sanskrit": "एवं सुहृद्भिः पर्यस्तः पुण्यश्लोकशिखामणिः।\nसंस्तूयमानो भगवान् विवेशालङ्कृतं पुरम्॥ १०/८१/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_081/BhP_10.081.034.m4a", "display_order": 35}, {"id": 6000277035, "chapter_id": 10277, "verse_number": "१०-८१-३२", "content_sanskrit": "संसिक्तवर्त्म करिणां मदगन्धतोयैश्चित्रध्वजैः कनकतोरणपूर्णकुम्भैः।\nमृष्टात्मभिर्वरदुकूलविभूषणस्रग्गन्धैर्नृभिर्युवतिभिश्च विराजमानम्॥ १०/८१/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_081/BhP_10.081.035.m4a", "display_order": 36}, {"id": 6000277036, "chapter_id": 10277, "verse_number": "१०-८१-३३", "content_sanskrit": "उद्दीप्तदीपावलिभिः प्रतिसद्मजालनिर्यातधूपरुचिरं विलसत्पताकम्।\nमूर्धन्यहेमकलशै रजतोरुशृङ्गैर्जुष्टं ददर्श भवनैः कुरुराजधाम॥ १०/८१/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_081/BhP_10.081.036.m4a", "display_order": 37}, {"id": 6000277037, "chapter_id": 10277, "verse_number": "१०-८१-३४", "content_sanskrit": "प्राप्तं निशम्य नरलोचनपानपात्रमौत्सुक्यविश्लथितकेशदुकूलबन्धाः।\nसद्यो विसृज्य गृहकर्म पतीन् स्वतल्पे द्रष्टुं ययुर्युवतयः स्म नरेन्द्रमार्गे॥ १०/८१/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_081/BhP_10.081.037.m4a", "display_order": 38}, {"id": 6000277038, "chapter_id": 10277, "verse_number": "१०-८१-३५", "content_sanskrit": "तस्मिन् ससङ्कुल इभाश्वरथद्विपद्भिः कृष्णं सभार्यमुपलभ्य गृहाधिरूढाः।\nनार्यो विकीर्य कुसुमैर्मनसोपगुह्य सुस्वागतं विदधुरुच्छ्रितवीक्षितेन॥ १०/८१/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_081/BhP_10.081.038.m4a", "display_order": 39}, {"id": 6000277039, "chapter_id": 10277, "verse_number": "१०-८१-३६", "content_sanskrit": "ऊचुः स्‍त्रियः पथि निरीक्ष्य मुकुन्दपत्नीस्तारा यथोडुपसहाः किमकार्यमूभिः।\nयच्चक्षुषां पुरुषमौलिरुदारहासलीलावलोककलयोत्सवमातनोति॥ १०/८१/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_081/BhP_10.081.039.m4a", "display_order": 40}, {"id": 6000277040, "chapter_id": 10277, "verse_number": "१०-८१-३७", "content_sanskrit": "तत्र तत्रोपसङ्गम्य पौरा मङ्गलपाणयः।\nचक्रुः सपर्यां कृष्णाय श्रेणीमुख्या हतैनसः॥ १०/८१/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_081/BhP_10.081.040.m4a", "display_order": 41}, {"id": 6000277041, "chapter_id": 10277, "verse_number": "१०-८१-३८", "content_sanskrit": "अन्तःपुरजनैः प्रीत्या मुकुन्दः फुल्ललोचनैः।\nससम्भ्रमैरभ्युपेतः प्राविशद् राजमन्दिरम्॥ १०/८१/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_081/BhP_10.081.041.m4a", "display_order": 42}, {"id": 6000277042, "chapter_id": 10277, "verse_number": "१०-८१-३९", "content_sanskrit": "पृथा विलोक्य भ्रात्रेयं कृष्णं त्रिभुवनेश्वरम्।\nप्रीतात्मोत्थाय पर्यङ्कात् सस्नुषा परिषस्वजे॥ १०/८१/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_081/BhP_10.081.042.m4a", "display_order": 43}, {"id": 6000277043, "chapter_id": 10277, "verse_number": "१०-८१-४०", "content_sanskrit": "गोविन्दं गृहमानीय देवदेवेशमादृतः।\nपूजायां नाविदत् कृत्यं प्रमोदोपहतो नृपः॥ १०/८१/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_081/BhP_10.081.043.m4a", "display_order": 44}, {"id": 6000277044, "chapter_id": 10277, "verse_number": "१०-८१-४१", "content_sanskrit": "पितृष्वसुर्गुरुस्‍त्रीणां कृष्णश्चक्रेऽभिवादनम्।\nस्वयं च कृष्णया राजन् भगिन्या चाभिवादितः॥ १०/८१/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_081/BhP_10.081.044.m4a", "display_order": 45}, {"id": 6000277045, "chapter_id": 10277, "verse_number": "१०-८१-४२", "content_sanskrit": "श्वश्व्रा सञ्चोदिता कृष्णा कृष्णपत्नीः सुवर्चसः।\nआनर्च रुग्मिणीं सत्यां भद्रां जाम्बवतीं तथा॥ १०/८१/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_081/BhP_10.081.045.m4a", "display_order": 46}, {"id": 6000277046, "chapter_id": 10277, "verse_number": "१०-८१-४३", "content_sanskrit": "कालिन्दीं मित्रविन्दां च शैब्यां नाग्नजितीं सतीम्।\nअन्याश्चाभ्यागता यास्ता वासःस्रङ्मण्डनादिभिः॥ १०/८१/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_081/BhP_10.081.046.m4a", "display_order": 47}, {"id": 6000277047, "chapter_id": 10277, "verse_number": "१०-८१-४४", "content_sanskrit": "सुखं निवासयामास धर्मराजो जनार्दनम्।\nससैन्यं सानुगामात्यं सभार्यं च नवं नवम्॥ १०/८१/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_081/BhP_10.081.047.m4a", "display_order": 48}, {"id": 6000277048, "chapter_id": 10277, "verse_number": "१०-८१-४५", "content_sanskrit": "तर्पयित्वा खाण्डवेन वह्निं पाण्डवसंयुतः।\nमोचयित्वा मयं येन राज्ञो दिव्या सभाऽऽहृता॥ १०/८१/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_081/BhP_10.081.048.m4a", "display_order": 49}, {"id": 6000277049, "chapter_id": 10277, "verse_number": "१०-८१-४६", "content_sanskrit": "उवास कतिचिन्मासान् राज्ञः प्रियचिकीर्षया।\nविहरन् रथमारुह्य फल्गुनेन भटैर्वृतः॥ १०/८१/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_081/BhP_10.081.049.m4a", "display_order": 50}, {"id": 6000277050, "chapter_id": 10277, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्ध उत्तरार्ध एकाशीतितमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]