[{"id": 900001426, "chapter_id": 8234, "verse_number": "8.1", "content_sanskrit": "कोऽयमात्मेति वयमुपास्महे", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900001427, "chapter_id": 8234, "verse_number": "8.2", "content_sanskrit": "यत् एतत्, हृदयं, मनः, च..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900001428, "chapter_id": 8234, "verse_number": "8.3", "content_sanskrit": "अविस्मृतित्वान्मेधा स दृष्टिर्दर्शनरूपतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900001429, "chapter_id": 8234, "verse_number": "8.4", "content_sanskrit": "एष ब्रह्मा, एष इन्द्रः, एष प्रजापतिः..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900001430, "chapter_id": 8234, "verse_number": "8.5", "content_sanskrit": "स एतेन प्रज्ञेनात्मनाऽस्माल्लोकादुत्क्रम्य ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900001431, "chapter_id": 8234, "verse_number": "8.6", "content_sanskrit": "जानन्त्याऽपि देव्या लोकानुग्रहार्थं विशेषज्ञानार्थं ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900001432, "chapter_id": 8234, "verse_number": "8.7", "content_sanskrit": "यत्प्रेरणादयं जीवो दर्शनादीन् करोति च", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900001433, "chapter_id": 8234, "verse_number": "8.8", "content_sanskrit": "प्रजापतिः शिवः, लिङ्गाभिमानित्वात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900001434, "chapter_id": 8234, "verse_number": "8.9", "content_sanskrit": "क्षुद्रमिश्राणीव बीजानि शाल्यादिबीजवत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900001435, "chapter_id": 8234, "verse_number": "8.10", "content_sanskrit": "प्रज्ञानेत्रोऽलोक इति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900001436, "chapter_id": 8234, "verse_number": "8.11", "content_sanskrit": "'स एतेने 'त्यलोकशब्दोक्तो मुक्तः परामृश्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900001437, "chapter_id": 8234, "verse_number": "8.12", "content_sanskrit": "अनारब्धफलानां च प्रारब्धानां च सर्वशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}]