[{"id": 2186445, "chapter_id": 4959, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2186446, "chapter_id": 4959, "verse_number": "१", "content_sanskrit": "कुतः सृष्टमिदं विश्वं जगत्स्थावरजङ्गमम् ।\nप्रलये च कमभ्येति तन्मे ब्रूहि पितामह\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2186447, "chapter_id": 4959, "verse_number": "२", "content_sanskrit": "ससागरः सगगनः सशैलः सबलाहकः ।\nसभूमिः साग्निपवनो लोकोऽयं केन निर्मितः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2186448, "chapter_id": 4959, "verse_number": "३", "content_sanskrit": "कथं सृष्टानि भूतानि कथं वर्णविभक्तयः ।\nशौचाशौचं कथं तेषां धर्माधर्मावथो कथम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2186449, "chapter_id": 4959, "verse_number": "४", "content_sanskrit": "कीदृशो जीवतां जीवः क्व वा गच्छन्ति ये मृताः ।\nअस्माल्लोकादमुं लोकं सर्वं शंसतु नो भवान्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2186450, "chapter_id": 4959, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2186451, "chapter_id": 4959, "verse_number": "५", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nभृगुणाभिहितं श्रेष्ठं भरद्वाजाय पृच्छते\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2186452, "chapter_id": 4959, "verse_number": "६", "content_sanskrit": "कैलासशिखरे दृष्ट्वा दीप्यमानमिवौजसा ।\nभृगुं महर्षिमासीनं भरद्वाजोऽन्वपृच्छत\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2186453, "chapter_id": 4959, "verse_number": "७", "content_sanskrit": "ससागरः सगगनः सशैलः सबलाहकः ।\nसभूमिः साग्निपवनो लोकोऽयं केन निर्मितः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2186454, "chapter_id": 4959, "verse_number": "८", "content_sanskrit": "कथं सृष्टानि भूतानि कथं वर्णविभक्तयः ।\nशौचाशौचं कथं तेषां धर्माधर्मावथो कथम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2186455, "chapter_id": 4959, "verse_number": "९", "content_sanskrit": "कीदृशो जीवतां जीवः क्व वा गच्छन्ति ये मृताः ।\nपरलोकमिमं चापि सर्वं शंसतु नो भवान्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2186456, "chapter_id": 4959, "verse_number": "१०", "content_sanskrit": "एवं स भगवान् पृष्टो भरद्वाजेन संशयम् ।\nमहर्षिर्ब्रह्मसङ्काशः सर्वं तस्मै ततोऽब्रवीत्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2186457, "chapter_id": 4959, "verse_number": "११", "content_sanskrit": "मानसो नाम विख्यातः श्रुतपूर्वो महर्षिभिः ।\nअनादिनिधनो देवस्तथाभेद्योऽजरामरः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2186458, "chapter_id": 4959, "verse_number": "१२", "content_sanskrit": "अव्यक्त इति विख्यातः शाश्वतोऽथाक्षरोऽव्ययः ।\nयतः सृष्टानि भूतानि जायन्ते च म्रियन्ति च\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2186459, "chapter_id": 4959, "verse_number": "१३", "content_sanskrit": "सोऽसृजत् प्रथमं देवो महान्तं नाम नामतः ।\nआकाशमिति विख्यातं सर्वभूतधरः प्रभुः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2186460, "chapter_id": 4959, "verse_number": "१४", "content_sanskrit": "आकाशादभवद्वारि सलिलादग्निमारुतौ ।\nअग्निमारुतसंयोगात्ततः समभवन्मही\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2186461, "chapter_id": 4959, "verse_number": "१५", "content_sanskrit": "ततस्तेजोमयं दिव्यं पद्मं सृष्टं स्वयम्भुवा ।\nतस्मात् पद्मात् समभवद्ब्रह्मा वेदमयो निधिः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2186462, "chapter_id": 4959, "verse_number": "१६", "content_sanskrit": "अहङ्कार इति ख्यातः सर्वभूतात्मभूतकृत् ।\nब्रह्मा वै सुमहातेजा य एते पञ्च धातवः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2186463, "chapter_id": 4959, "verse_number": "१७", "content_sanskrit": "शैलास्तस्यास्थिसञ्ज्ञास्तु मेदो मांसं च मेदिनी ।\nसमुद्रास्तस्य रुधिरमाकाशमुदरं तथा\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2186464, "chapter_id": 4959, "verse_number": "१८", "content_sanskrit": "पवनश्चैव निःश्वासस्तेजोऽग्निर्निम्नगाः सिराः ।\nअग्नीषोमौ तु चन्द्रार्कौ नयने तस्य विश्रुते\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2186465, "chapter_id": 4959, "verse_number": "१९", "content_sanskrit": "नभश्चोर्ध्वं शिरस्तस्य क्षितिः पादौ दिशो भुजौ ।\nदुर्विज्ञेयो ह्यनन्तत्वात् सिद्धैरपि न संशयः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2186466, "chapter_id": 4959, "verse_number": "२०", "content_sanskrit": "स एव भगवान् विष्णुरनन्त इति विश्रुतः ।\nसर्वभूतात्मभूतस्थो दुर्विज्ञेयोऽकृतात्मभिः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2186467, "chapter_id": 4959, "verse_number": "२१", "content_sanskrit": "अहङ्कारस्य यः स्रष्टा सर्वभूतभवाय वै ।\nयतः समभवद् विश्वं पृष्टोऽहं यदिह त्वया\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2186468, "chapter_id": 4959, "verse_number": "", "content_sanskrit": "भरद्वाजः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2186469, "chapter_id": 4959, "verse_number": "२२", "content_sanskrit": "गगनस्य दिशां चैव भूतलस्यानिलस्य च ।\nकान्यत्र परिमाणानि संशयं छिन्धि मेऽर्थतः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2186470, "chapter_id": 4959, "verse_number": "", "content_sanskrit": "भृगुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2186471, "chapter_id": 4959, "verse_number": "२३", "content_sanskrit": "अनन्तमेतदाकाशं सिद्धचारणसेवितम् ।\nरम्यं नानाश्रयाकीर्णं यस्यान्तो नाधिगम्यते\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2186472, "chapter_id": 4959, "verse_number": "२४", "content_sanskrit": "ऊर्ध्वं गतेरधस्तात्तु चन्द्रादित्यौ न दृश्यतः ।\nतत्र देवाः स्वयं दीप्ता भास्वराश्चाग्निवर्चसः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2186473, "chapter_id": 4959, "verse_number": "२५", "content_sanskrit": "ते चाप्यन्तं न पश्यन्ति नभसः प्रथितौजसः ।\nदुर्गमत्वादनन्तत्वादिति मे विद्धि मानद\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2186474, "chapter_id": 4959, "verse_number": "२६", "content_sanskrit": "उपरिष्टोपरिष्टात्तु प्रज्वलद्भिः स्वयम्प्रभैः ।\nनिरुद्धमेतदाकाशमप्रमेयं सुरैरपि\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2186475, "chapter_id": 4959, "verse_number": "२७", "content_sanskrit": "पृथिव्यन्ते समुद्रास्तु समुद्रान्ते तमः स्मृतम् ।\nतमसोऽन्ते जलं प्राहुर्जलस्यान्तेऽग्निरेव च\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2186476, "chapter_id": 4959, "verse_number": "२८", "content_sanskrit": "रसातलान्ते सलिलं जलान्ते पन्नगाधिपः ।\nतदन्ते पुनराकाशमाकाशान्ते पुनर्जलम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2186477, "chapter_id": 4959, "verse_number": "२९", "content_sanskrit": "एवमन्तं भगवतः प्रमाणं सलिलस्य च ।\nअग्निमारुततोयेभ्यो दुर्ज्ञेयं दैवतैरपि\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2186478, "chapter_id": 4959, "verse_number": "३०", "content_sanskrit": "अग्निमारुततोयानां वर्णाः क्षितितलस्य च ।\nआकाशसदृशा ह्येते भिद्यन्ते तत्त्वदर्शनात्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2186479, "chapter_id": 4959, "verse_number": "३१", "content_sanskrit": "पठन्ति चैव मुनयः शास्त्रेषु विविधेषु च ।\nत्रैलोक्ये सागरे चैव प्रमाणं विहितं यथा ।\nअदृश्याय त्वगम्याय कः प्रमाणमुदाहरेत्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2186480, "chapter_id": 4959, "verse_number": "३२", "content_sanskrit": "सिद्धानां देवतानां च यदा परिमिता गतिः ।\nतदा गौणमनन्तस्य नामानन्तेति विश्रुतम् ।\nनामधेयानुरूपस्य मानसस्य महात्मनः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2186481, "chapter_id": 4959, "verse_number": "३३", "content_sanskrit": "यदा तु दिव्यं तद्रूपं ह्रसते वर्धते पुनः ।\nकोऽन्यस्तद्वेदितुं शक्तो योऽपि स्यात्तद्विधोऽपरः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2186482, "chapter_id": 4959, "verse_number": "३४", "content_sanskrit": "ततः पुष्करतः सृष्टः सर्वज्ञो मूर्तिमान् प्रभुः ।\nब्रह्मा धर्ममयः पूर्वः प्रजापतिरनुत्तमः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2186483, "chapter_id": 4959, "verse_number": "", "content_sanskrit": "भरद्वाजः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2186484, "chapter_id": 4959, "verse_number": "३५", "content_sanskrit": "पुष्कराद् यदि सम्भूतो ज्येष्ठं भवति पुष्करम् ।\nब्रह्माणं पूर्वजं चाह भवान् संदेह एव मे\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2186485, "chapter_id": 4959, "verse_number": "", "content_sanskrit": "भृगुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2186486, "chapter_id": 4959, "verse_number": "३६", "content_sanskrit": "मानसस्येह या मूर्तिर्ब्रह्मत्वं समुपागता ।\nतस्यासनविधानार्थं पृथिवी पद्ममुच्यते \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2186487, "chapter_id": 4959, "verse_number": "३७", "content_sanskrit": "कर्णिका तस्य पद्मस्य मेरुर्गगनमुच्छ्रितः ।\nतस्य मध्ये स्थितो लोकान् सृजते जगतः प्रभुः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2186488, "chapter_id": 4959, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे अष्टमोऽध्यायः ॥ ८ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]