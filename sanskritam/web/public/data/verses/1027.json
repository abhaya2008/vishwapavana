[{"id": 2001523, "chapter_id": 1027, "verse_number": "१-२८-०x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2001524, "chapter_id": 1027, "verse_number": "१-२८-१", "content_sanskrit": "इत्युक्तो गरुडः सर्पैस्ततो मातरमब्रवीत्।\nगच्छाम्यमृतमाहर्तुं भक्ष्यमिच्छामि वेदितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2001525, "chapter_id": 1027, "verse_number": "१-२८-२x", "content_sanskrit": "विनतोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2001526, "chapter_id": 1027, "verse_number": "१-२८-२", "content_sanskrit": "समुद्रकुक्षावेकान्ते निषादालयमुत्तमम्।\nभवनानि निषादानां तत्र सन्ति द्विजोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2001527, "chapter_id": 1027, "verse_number": "१-२८-३", "content_sanskrit": "पापिनां नष्टलोकानां निर्घृणानां दुरात्मनाम्।\nनिषादानां सहस्राणि तान्भुक्त्वाऽमृतमानय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2001528, "chapter_id": 1027, "verse_number": "१-२८-४", "content_sanskrit": "न च ते ब्राह्मणं हन्तुं कार्या बुद्धिः कथंचन।\nअवध्यः सर्वभूतानां ब्राह्मणो ह्यनलोपमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2001529, "chapter_id": 1027, "verse_number": "१-२८-५", "content_sanskrit": "अग्निरर्को विषं शस्त्रं विप्रो भवति कोपितः।\nगुरुर्हि सर्वभूतानां ब्राह्मणः परिकीर्तितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2001530, "chapter_id": 1027, "verse_number": "१-२८-६", "content_sanskrit": "एवमादिस्वरूपैस्तु सतां वै ब्राह्मणो मतः।\nस ते तात न हन्तव्यः संक्रुद्धेनापि सर्वथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2001531, "chapter_id": 1027, "verse_number": "१-२८-७", "content_sanskrit": "ब्राह्मणानामभिद्रोहो न कर्तव्यः कथंचन।\nन ह्येवमग्निर्नादित्यो भस्म कुर्यात्तथानघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2001532, "chapter_id": 1027, "verse_number": "१-२८-८", "content_sanskrit": "यथा कुर्यादभिक्रुद्धो ब्राह्मणः संशितव्रतः।\nतदेतैर्विविधैर्लिङ्गैस्त्वं विद्यास्तं द्विजोत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2001533, "chapter_id": 1027, "verse_number": "१-२८-९", "content_sanskrit": "भूतानामग्रभूर्विप्रो वर्णश्रेष्ठः पिता गुरुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2001534, "chapter_id": 1027, "verse_number": "१-२८-९x", "content_sanskrit": "गरुड उवाच।\nकिंरूपो ब्राह्मणो मातः किंशीलः किंपराक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2001535, "chapter_id": 1027, "verse_number": "१-२८-१०", "content_sanskrit": "किंस्विदग्निनिभो भाति किंस्वित्सौम्यप्रदर्शनः।\nयथाहमभिजानीयां ब्राह्मणं लक्षणैः शुभैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2001536, "chapter_id": 1027, "verse_number": "१-२८-११", "content_sanskrit": "तन्मे कारणतो मातः पृच्छतो वक्तुमर्हसि।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2001537, "chapter_id": 1027, "verse_number": "१-२८-११x", "content_sanskrit": "विनतोवाच।\nयस्ते कण्ठमनुप्राप्तो निगीर्णं बडिशं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2001538, "chapter_id": 1027, "verse_number": "१-२८-१२", "content_sanskrit": "दहेदङ्गारवत्पुत्रं तं विद्याद्ब्राह्मणर्षभम्।\nविप्रस्त्वया न हन्तव्यः संक्रुद्धेनापि सर्वदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2001539, "chapter_id": 1027, "verse_number": "१-२८-१३", "content_sanskrit": "प्रोवाच चैन विनता पुत्रहार्दादिदं वचः।\nजठरे न च जीर्येद्यस्तं जानीहि द्विजोत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2001540, "chapter_id": 1027, "verse_number": "१-२८-१४", "content_sanskrit": "पुनः प्रोवाच विनता पुत्रहार्दादिदं वचः।\nजानन्त्यप्यतुलं वीर्यमाशीर्वादपरायणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2001541, "chapter_id": 1027, "verse_number": "१-२८-१५", "content_sanskrit": "प्रीता परमदुःखार्ता नागैर्विप्रकृता सती।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2001542, "chapter_id": 1027, "verse_number": "१-२८-१५x", "content_sanskrit": "विनतोवाच।\nपक्षौ ते मारुतः पातु चन्द्रसूर्यौ च पृष्ठतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2001543, "chapter_id": 1027, "verse_number": "१-२८-१६", "content_sanskrit": "शिरश्च पातु वह्निस्ते वसवः सर्वतस्तनुम्।\nविष्णुः सर्वगतः सर्वमह्गानि तव चैव ह।\nअहं च ते सदा पुत्र शान्तिस्वस्तिपरायणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2001544, "chapter_id": 1027, "verse_number": "१-२८-१७", "content_sanskrit": "इहासीना भविष्यामि स्वस्तिकारे रता सदा।\nअरिष्टं व्रज पन्थानं पुत्र कार्यार्थसिद्धये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2001545, "chapter_id": 1027, "verse_number": "१-२८-१८x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2001546, "chapter_id": 1027, "verse_number": "१-२८-१८", "content_sanskrit": "ततः स मातुर्वचनं निशम्य\nवितत्य पक्षौ नभ उत्पपात।\nततो निषादान्बलवानुपागतो\nबुभुक्षितः काल इवान्तकोऽपरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2001547, "chapter_id": 1027, "verse_number": "१-२८-१९", "content_sanskrit": "स तान्निषादानुपसंहरंस्तदा\nरजः समुद्धूय नभःस्पृशं महत्।\nसमुद्रकुक्षौ च विशोषयन्पयः\nसमीपजान्भूधरजान्विचालयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2001548, "chapter_id": 1027, "verse_number": "१-२८-२०", "content_sanskrit": "ततः स चक्रे महदाननं तदा\nनिषादमार्गं प्रतिरुध्य पक्षिराट्।\nततो निषादास्त्वरिताः प्रवव्रजु-\nर्यतो मुखं तस्य भुजंगभोजिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2001549, "chapter_id": 1027, "verse_number": "१-२८-२१", "content_sanskrit": "तदाननं विवृतमतिप्रमाणव-\nत्समभ्ययुर्गगनमिवार्दिताः खगाः।\nसहस्रशः पवनजोविमोहिता\nयथा।ञनिलप्रचलितपादपे वने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2001550, "chapter_id": 1027, "verse_number": "१-२८-२२", "content_sanskrit": "ततः खगो वदनममित्रतापनः\nसमाहरत्परिचपलो मत्बलाः।\nनिषूदयन्बहुविधमत्स्यजीविनो\nबभुक्षितो गगनचरेश्वरस्तदा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2001551, "chapter_id": 1027, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि आस्तीकपर्वणि अष्टाविंशोऽध्यायः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]