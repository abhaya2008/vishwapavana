[{"id": 2068191, "chapter_id": 2431, "verse_number": "९-४९-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2068192, "chapter_id": 2431, "verse_number": "९-४९-१", "content_sanskrit": "ततस्तीर्थवरं रामो ययौ बदरपाचनाम्।\nतपस्विसिद्धचरितं यत्र कन्या धृतव्रता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2068193, "chapter_id": 2431, "verse_number": "९-४९-२", "content_sanskrit": "भरद्वाजस्य दुहिता रुपेणाप्रतिमा भुवि।\nश्रुतावती नाम विभो कुमारी ब्रह्मचारिणी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2068194, "chapter_id": 2431, "verse_number": "९-४९-३", "content_sanskrit": "तपश्चचार सात्युग्रं नियमैर्बहुभिर्वृता।\nभर्ता मे देवराजः स्यादिति निश्चित्य भामिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2068195, "chapter_id": 2431, "verse_number": "९-४९-४", "content_sanskrit": "समास्तस्या व्यतिक्रान्ता बह्व्यः कुरुकुलोद्वह।\nचरन्त्या नियमांस्तांस्तांस्त्रीभिस्तीव्रान्सुदुश्चरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2068196, "chapter_id": 2431, "verse_number": "९-४९-५", "content_sanskrit": "तस्यास्तु तेन वृत्तेन तपसा च विशाम्पते।\nभक्त्या च भगवान्प्रीतः परया पाकशासनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2068197, "chapter_id": 2431, "verse_number": "९-४९-६", "content_sanskrit": "आजगामाश्रमं तस्यास्त्रिदशाधिपतिः प्रभुः।\nआस्थाय रूपं विप्रर्षेर्वसिष्ठस्य महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2068198, "chapter_id": 2431, "verse_number": "९-४९-७", "content_sanskrit": "सा तं दृष्ट्वोग्रतपसं वसिष्ठं तपतां वरम्।\nआचारैर्मुनिभिर्दृष्टैः पूजयामास भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2068199, "chapter_id": 2431, "verse_number": "९-४९-८", "content_sanskrit": "उवाच नियमज्ञा च कल्याणी सा प्रियंवदा।\nभगवन्मुनिशार्दूल किमाज्ञापयसि प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2068200, "chapter_id": 2431, "verse_number": "९-४९-९", "content_sanskrit": "सर्वमद्य यथाशक्ति तव दास्यामि सुव्रत।\nशक्त्रभक्त्या च ते पाणिं न दास्यामि कथञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2068201, "chapter_id": 2431, "verse_number": "९-४९-१०", "content_sanskrit": "व्रतैश्च नियमैश्चैव तपसा च तपोधन।\nशक्रस्तोषयितव्यो वै मया त्रिभुवनेश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2068202, "chapter_id": 2431, "verse_number": "९-४९-११", "content_sanskrit": "इत्युक्तो भगवान्देवः स्मयन्निव निरीक्ष्य ताम्।\nउवाच नियमं ज्ञात्वा सांत्वयन्निव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2068203, "chapter_id": 2431, "verse_number": "९-४९-१२", "content_sanskrit": "उग्रं तपश्चरसि वै विदिता मेऽसि सुव्रते।\nयदर्थमयमारम्भस्तव कल्याणि हृद्गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2068204, "chapter_id": 2431, "verse_number": "९-४९-१३", "content_sanskrit": "तच्च सर्वं यथाभूतं भविष्यति वरानने।\nतपसा लभ्यते सर्वं यथाभूतं भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2068205, "chapter_id": 2431, "verse_number": "९-४९-१४", "content_sanskrit": "यथा स्थानानि दिव्यानि विबुधानां शुभानने।\nतपसा तानि प्राप्याणि तपोमूलं महात्सुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2068206, "chapter_id": 2431, "verse_number": "९-४९-१५", "content_sanskrit": "इति कृत्वा तपो घोरं देहं सन्न्यस्य मानवाः।\nदेवत्वं यान्ति कल्याणि शृणुष्वैकं वचो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2068207, "chapter_id": 2431, "verse_number": "९-४९-१६", "content_sanskrit": "प़ञ्च चैतानि सुभगे बदराणि शुभव्रते।\nपचेत्युक्त्वा तु भगवाञ्जगाम बलसूदनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2068208, "chapter_id": 2431, "verse_number": "९-४९-१७", "content_sanskrit": "आमन्त्र्य तां तु कल्याणीं ततो जप्यं जजाप सः।\nअविदूरे ततस्तस्मादाश्रमात्तीर्थमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2068209, "chapter_id": 2431, "verse_number": "९-४९-१८", "content_sanskrit": "तच्च तीर्थं महाराज यत्र जप्यं जजाप सः।\nइन्द्रतीर्थेतिविख्यातं त्रिषु लोकेषु मानद॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2068210, "chapter_id": 2431, "verse_number": "९-४९-१९", "content_sanskrit": "तस्य जिज्ञासनार्थं स भगवान्पाकशासनः।\nबदराणामपचनं चकार विबुधाधिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2068211, "chapter_id": 2431, "verse_number": "९-४९-२०", "content_sanskrit": "ततः प्रतप्ता सा राजन्वाग्यता विगतक्लमा।\nतत्परा शुचिसंवीता पावके समधिश्रयत्।\nअपचद्राजशार्दूल बदराणि महाव्रता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2068212, "chapter_id": 2431, "verse_number": "९-४९-२१", "content_sanskrit": "तस्याः पचन्त्याः सुमहान्कालोऽगात्पुरुषर्षभ।\nन च स्म तान्यपच्यन्त दिनं च क्षयमभ्यगात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2068213, "chapter_id": 2431, "verse_number": "९-४९-२२", "content_sanskrit": "हुताशनेन दग्धश्च यस्तस्याः काष्ठसञ्चयः।\nअकाष्ठमग्निं सा दृष्ट्वा स्वशरीरमथादहत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2068214, "chapter_id": 2431, "verse_number": "९-४९-२३", "content_sanskrit": "पादौ प्रक्षिप्य सा पूर्वं पावके चारुदर्शना।\nदग्धौ दग्धौ पुनः पादावुपावर्तयतानघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2068215, "chapter_id": 2431, "verse_number": "९-४९-२४", "content_sanskrit": "चरणे दह्यमाने च नाचिन्तयदनिन्दिता।\nदुःखं कमलपत्राक्षी महर्षिप्रियकाम्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2068216, "chapter_id": 2431, "verse_number": "९-४९-२५", "content_sanskrit": "न वैमनस्यं तस्यास्तु मुखभेदोऽथवाऽभवत्।\nशरीरमग्निना दीप्य जलमध्ये यथा स्थिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2068217, "chapter_id": 2431, "verse_number": "९-४९-२६", "content_sanskrit": "तच्चास्याः पचने यत्नं न न्यवर्तत भारत।\nसर्वथा बदराण्येव पक्तव्यानीति कन्यका॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2068218, "chapter_id": 2431, "verse_number": "९-४९-२७", "content_sanskrit": "सा तन्मनसि कृत्वैव महर्षेर्वचनं शुभा।\nअपचद्बदराण्येव न चापच्यन्त भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2068219, "chapter_id": 2431, "verse_number": "९-४९-२८", "content_sanskrit": "तस्यास्तु चरणौ वह्निर्ददाह भगवान्स्वयम्।\nन च तस्या मनोदुःखं स्वल्पमप्यभवत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2068220, "chapter_id": 2431, "verse_number": "९-४९-२९", "content_sanskrit": "अथ तत्कर्म दृष्ट्वाऽस्याः प्रीतस्त्रिभुवनेश्वरः।\nततः सन्दर्शयामास कन्यायै रूपमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2068221, "chapter_id": 2431, "verse_number": "९-४९-३०", "content_sanskrit": "उवाच च सुरश्रेष्ठस्तां कन्यां सुदृढव्रताम्।\nप्रीतोऽस्मि ते शुभे भक्त्या तपसा नियमेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2068222, "chapter_id": 2431, "verse_number": "९-४९-३१", "content_sanskrit": "तस्माद्योऽभिमतः कामः स ते सम्पत्स्यते शुभे।\nदेहं त्यक्त्वा महाभागे त्रिदिवे मयि वत्स्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2068223, "chapter_id": 2431, "verse_number": "९-४९-३२", "content_sanskrit": "इदं च ते तीर्थवरं स्थिरं लोके भविष्यति।\nसर्वपापापहं सुभ्रु नाम्ना बदरपाचनम्।\nविख्यातं त्रिषु लोकेषु ब्रह्मर्षिभिरभिप्लुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2068224, "chapter_id": 2431, "verse_number": "९-४९-३३", "content_sanskrit": "अस्मिन्खलु महाभागे शुभे तीर्थवरेऽनघे।\nत्यक्त्वा सप्तर्षयो जग्मुर्हिमवन्तमरुन्धतीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2068225, "chapter_id": 2431, "verse_number": "९-४९-३४", "content_sanskrit": "ततस्ते वै महाभागा गत्वा तत्र सुसंशिताः।\nवृत्त्यर्थं फलमूलानि समाहर्तुं ययुः किल॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2068226, "chapter_id": 2431, "verse_number": "९-४९-३५", "content_sanskrit": "तेषां वृत्त्यर्थिनां तत्र वसतां हिमवद्वने।\nअनावृष्टिरनुप्राप्ता तदा द्वादशवार्षिकी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2068227, "chapter_id": 2431, "verse_number": "९-४९-३६", "content_sanskrit": "ते कृत्वा चाश्रमं तत्र न्यवसन्त तपस्विनः।\nअरुन्धत्यपि कल्याणी तपोनित्याऽभवत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2068228, "chapter_id": 2431, "verse_number": "९-४९-३७", "content_sanskrit": "अरुन्धतीं ततो दृष्ट्वा तीव्रं नियममास्थिताम्।\nअथागमत्त्रिनयनः सुप्रीतो वरदस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2068229, "chapter_id": 2431, "verse_number": "९-४९-३८", "content_sanskrit": "ब्राह्मं रूपं ततः कृत्वा महादेवो महायशाः।\nतामभ्येत्याब्रवीद्देवो भिक्षामिच्छाम्यहं शुभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2068230, "chapter_id": 2431, "verse_number": "९-४९-३९", "content_sanskrit": "प्रत्युवाच ततः सा तं ब्राह्मणं चारुदर्शना।\nक्षीणोऽन्नसञ्चयो विप्र बदराणीह भक्षय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2068231, "chapter_id": 2431, "verse_number": "९-४९-४०", "content_sanskrit": "ततोऽब्रवीन्महादेवः पचस्वैतानि सुव्रते।\nइत्युक्ता साऽपचत्तानि ब्राह्मणप्रियकाम्यया।\nअधिश्रित्य समिद्धेऽग्नौ बदराणि यशस्विनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2068232, "chapter_id": 2431, "verse_number": "९-४९-४१", "content_sanskrit": "दिव्या मनोरमाः पुण्याः कथाः शुश्राव सा तदा।\nअतीता सा त्वनावृष्टिर्घोरा द्वादशवार्षिकी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2068233, "chapter_id": 2431, "verse_number": "९-४९-४२", "content_sanskrit": "अनश्नन्त्याः पचन्त्याश्च शृण्वन्त्याश्च कथाः शुभाः।\nदिनोपमः स तस्याथ कालोऽतीतः सुदारुणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2068234, "chapter_id": 2431, "verse_number": "९-४९-४३", "content_sanskrit": "ततस्तु मुनयः प्राप्ताः फलान्यादाय पर्वतात्।\nततः स भगवान्प्रीतः प्रोवाचारुन्धतीं ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2068235, "chapter_id": 2431, "verse_number": "९-४९-४४", "content_sanskrit": "उपसर्पस्व धर्मज्ञे यथापूर्वमिमानृषीन्।\nप्रीतोऽस्मि तव धर्मज्ञे तपसा नियमेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2068236, "chapter_id": 2431, "verse_number": "९-४९-४५", "content_sanskrit": "ततः सन्दर्शयामास स्वरूपं भगवान्हरः।\nततोऽब्रवीत्तदा तेभ्यस्तस्याश्च चरितं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2068237, "chapter_id": 2431, "verse_number": "९-४९-४६", "content_sanskrit": "भवद्भिर्हिमवत्पृष्ठे यत्तपः समुपार्जितम्।\nअस्यास्च यत्तपो विप्रा न समं तन्मतं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2068238, "chapter_id": 2431, "verse_number": "९-४९-४७", "content_sanskrit": "अनया हि तपस्विन्या तपस्तप्तं सुदुश्चरम्।\nअनश्नन्त्या पचन्त्या च समा द्वादश पारिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2068239, "chapter_id": 2431, "verse_number": "९-४९-४८", "content_sanskrit": "ततः प्रोवाच भगवांस्तामेवारुन्धतीं पुनः।\nवरं वृणीष्व कल्याणि यत्तेऽभिलषितं हृदि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2068240, "chapter_id": 2431, "verse_number": "९-४९-४९", "content_sanskrit": "साऽब्रवीत्पृथुताम्राक्षी देवं सप्तर्षिसंसदि।\nभगवान्यदि मे प्रीतस्तीर्थं स्यादिदमद्भुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2068241, "chapter_id": 2431, "verse_number": "९-४९-५०", "content_sanskrit": "सिद्धदेवर्षिदयितं नाम्ना बदरपाचनम्।\nतथाऽस्मिन्देवदेवेश त्रिरात्रमुषितः शुचिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2068242, "chapter_id": 2431, "verse_number": "९-४९-५१", "content_sanskrit": "प्राप्नुयादुपवासेन फलं द्वादशवार्षिकम्।\nएवमस्त्विति तां देवः प्रत्युवाच तपस्विनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2068243, "chapter_id": 2431, "verse_number": "९-४९-५२", "content_sanskrit": "सप्तर्षिभिः स्तुतो देवस्ततो लोकं ययौ तदा।\nऋषयो विस्मयं जग्मुस्तां दृष्ट्वा चाप्यरुन्धतीम्।\nअश्रान्तां चाविवर्णां च क्षुत्पिपासाऽसमायुताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2068244, "chapter_id": 2431, "verse_number": "९-४९-५३", "content_sanskrit": "एवं सिद्धिः परा प्राप्ता अरुन्धत्या विशुद्धया।\nयथा त्वया महाभागे मदर्थे संशितव्रते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2068245, "chapter_id": 2431, "verse_number": "९-४९-५४", "content_sanskrit": "विशेषो हि त्वया भद्रे व्रते ह्यस्मिन्समर्पितः।\nतथा चेदं ददाम्यद्य नियमेन सुतोषितः।\nविशेषं तव कल्याणि प्रयच्छामि वरं वरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2068246, "chapter_id": 2431, "verse_number": "९-४९-५५", "content_sanskrit": "अरुन्धत्या वरस्तस्या यो दत्तो वै महात्मना।\nतस्य चाहं प्रभावेन तव कल्याणि तेजसा।\nप्रवक्ष्यामि परं भूयो वरमत्र यथाविधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2068247, "chapter_id": 2431, "verse_number": "९-४९-५६", "content_sanskrit": "यस्त्वेकां रजनीं तीर्थे वत्स्यते सुसमाहितः।\nसस्नात्वा प्राप्स्यते लोकान्देहन्यासात्सुदुर्लभान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2068248, "chapter_id": 2431, "verse_number": "९-४९-५७", "content_sanskrit": "इत्युक्त्वा भगवान्देवः सहस्राक्षः प्रतापवान्।\nश्रुतावतीं ततः पुण्यां जगाम त्रिदिवं पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2068249, "chapter_id": 2431, "verse_number": "९-४९-५८", "content_sanskrit": "गते वज्रधरे राजंस्तत्र वर्षं पपात ह।\nपुष्पाणां भरतश्रेष्ठ दिव्यानां पुण्यगन्धिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2068250, "chapter_id": 2431, "verse_number": "९-४९-५९", "content_sanskrit": "दवदुन्दुभयश्चापि नेदुस्तत्र महास्वनाः।\nमारुतश्च ववौ पुण्यः पुण्यगन्धो विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2068251, "chapter_id": 2431, "verse_number": "९-४९-६०", "content_sanskrit": "उत्सृज्य तु शुभा देहं जगामास्य च भार्यताम्।\nतपसोग्रेण तं लब्ध्वा तेन रेमे सहाच्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2068252, "chapter_id": 2431, "verse_number": "९-४९-६१x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2068253, "chapter_id": 2431, "verse_number": "९-४९-६१", "content_sanskrit": "का तस्या भगवन्माता क्व संवृद्धा च शोभना।\nश्रोतुमिच्छाम्यहं विप्र परं कौतूहलं हि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2068254, "chapter_id": 2431, "verse_number": "९-४९-६२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2068255, "chapter_id": 2431, "verse_number": "९-४९-६२", "content_sanskrit": "भरद्वाजस्य विप्रर्षेः स्कन्नं रेतो महात्मनः।\nदृष्ट्वाऽप्सरसमायान्ती घृताचीं पृथलोचनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2068256, "chapter_id": 2431, "verse_number": "९-४९-६३", "content_sanskrit": "स तु जग्राह तद्रेतः करेण जपतां वरः।\nतदाऽपतत्पर्णपुटे तत्र सा सम्भवत्सुता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2068257, "chapter_id": 2431, "verse_number": "९-४९-६४", "content_sanskrit": "तस्यास्तु जातकर्मादि कृत्वा सर्वं तपोधनः।\nनाम चास्याः स कृतवान्भरद्वाजो महामुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2068258, "chapter_id": 2431, "verse_number": "९-४९-६५", "content_sanskrit": "श्रुतावतीति धर्मात्मा देवर्षिगणसंसदि।\nस्वे च तामाश्रमे न्यस्य जगाम हिमवद्वनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2068259, "chapter_id": 2431, "verse_number": "९-४९-६६", "content_sanskrit": "तत्राप्युपस्पृश्य महानुभावो\nवसूनि दत्त्वा च महाद्विजेभ्यः।\nजगाम तीर्थं सुसमाहितात्मा\nशक्रस्य वृष्णिप्रवरस्तदानीम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2068260, "chapter_id": 2431, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शल्यपर्वणि ह्रदप्रवेशपर्वणि एकोनपञ्चाशोऽध्यायः॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}]