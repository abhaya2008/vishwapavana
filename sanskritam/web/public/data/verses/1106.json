[{"id": 2005357, "chapter_id": 1106, "verse_number": "१-१०७-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2005358, "chapter_id": 1106, "verse_number": "१-१०७-१", "content_sanskrit": "स राजा शान्तनुर्धीमान्देवराजर्षिसत्कृतः।\nधर्मात्मा सर्वलोकेषु सत्यवागिति विश्रुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2005359, "chapter_id": 1106, "verse_number": "१-१०७-२", "content_sanskrit": "शान्तनोः कीर्तयिष्यामि सर्वानेव गुणानहम्।\nदमो दानं क्षमा बुद्धिर्ह्रीर्धृतिस्तेज उत्तमम्।\nनित्यान्यासन्महासत्वे शान्तनौ पुरुषर्षभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2005360, "chapter_id": 1106, "verse_number": "१-१०७-३", "content_sanskrit": "एवं स गुणसंपन्नो धर्मार्थकुशलो नृपः।\nआसीद्भरतवंशस्य गोप्ता सर्वजनस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2005361, "chapter_id": 1106, "verse_number": "१-१०७-४", "content_sanskrit": "कम्बुग्रीवः पृथुव्यंसो मत्तवारणविक्रमः।\nअन्वितः परिपूर्णार्थैः सर्वैर्नृपतिलक्षणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2005362, "chapter_id": 1106, "verse_number": "१-१०७-५", "content_sanskrit": "तस्य कीर्तिमतो वृत्तमवेक्ष्य सततं नराः।\nधर्म एव परः कामादर्थाच्चेति व्यवस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2005363, "chapter_id": 1106, "verse_number": "१-१०७-६", "content_sanskrit": "एवमासीन्महासत्वः शान्तनुर्भरतर्षभ।\nन चास्य सदृशः कश्चिद्धर्मतः पार्थिवोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2005364, "chapter_id": 1106, "verse_number": "१-१०७-७", "content_sanskrit": "वर्तमानं हि धर्मेषु सर्वधर्मभृतां वरम्।\nतं महीपा महीपालं राजराज्येऽभ्यषेचयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2005365, "chapter_id": 1106, "verse_number": "१-१०७-८", "content_sanskrit": "वीतशोकभयाबाधाः सुखस्वप्ननिबोधनाः।\nपतिं भारतगोप्तारं समपद्यन्त भूमिपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2005366, "chapter_id": 1106, "verse_number": "१-१०७-९", "content_sanskrit": "तेन कीर्तिमता शिष्टाः शक्रप्रतिमतेजसा।\nयज्ञदानक्रियाशीलाः समपद्यन्त भूमिपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2005367, "chapter_id": 1106, "verse_number": "१-१०७-१०", "content_sanskrit": "शान्तनुप्रमुखैर्गुप्ते लोके नृपतिभिस्तदा।\nनियमात्सर्ववर्णानां धर्मोत्तरमवर्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2005368, "chapter_id": 1106, "verse_number": "१-१०७-११", "content_sanskrit": "ब्रह्म पर्यचरत्क्षत्रं विशः क्षत्रमनुव्रताः।\nब्रह्मक्षत्रानुरक्ताश्च शूद्राः पर्यचरन्विशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2005369, "chapter_id": 1106, "verse_number": "१-१०७-१२", "content_sanskrit": "स हास्तिनपुरे रम्ये कुरूणां पुटभेदने।\nवसन्सागरपर्यन्तामन्वशासद्वसुन्धराम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2005370, "chapter_id": 1106, "verse_number": "१-१०७-१३", "content_sanskrit": "स देवराजसदृशो धर्मज्ञः सत्यवागृजुः।\nदानधर्मतपोयोगाच्छ्रिया परमया युतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2005371, "chapter_id": 1106, "verse_number": "१-१०७-१४", "content_sanskrit": "अरागद्वेषसंयुक्तः सोमवत्प्रियदर्शनः॥\nतेजसा सूर्यकल्पोऽभूद्वायुवेगसमो जवे।\nअन्तकप्रतिमः कोपे क्षमया पृथिवीसमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2005372, "chapter_id": 1106, "verse_number": "१-१०७-१५", "content_sanskrit": "वधः पशुवराहाणां तथैव मृगपक्षिणाम्।\nशान्तनौ पृथिवीपाले नावर्तत तथा नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2005373, "chapter_id": 1106, "verse_number": "१-१०७-१६", "content_sanskrit": "ब्रह्मधर्मोत्तरे राज्ये शान्तनुर्विनयात्मवान्।\nसमं शशास भूतानि कामरागविवर्जितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2005374, "chapter_id": 1106, "verse_number": "१-१०७-१७", "content_sanskrit": "चकोरनेत्रस्ताम्रास्यः सिंहर्षभगतिर्युवा।\nगुणैरनुपमैर्युक्तः समस्तैराभिगामिकैः।\nगम्भीरः सत्वसंपन्नः पूर्णचन्द्रनिभाननः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2005375, "chapter_id": 1106, "verse_number": "१-१०७-१८", "content_sanskrit": "देवर्षिपितृयज्ञार्थमारभ्यन्त तदा क्रियाः।\nन चाधर्मेण केषांचित्प्राणिनामभवद्वधः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2005376, "chapter_id": 1106, "verse_number": "१-१०७-१९", "content_sanskrit": "असुखानामनाथानां तिर्यग्योनिषु वर्तताम्।\nस एव राजा सर्वेषां भूतानामभवत्पिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2005377, "chapter_id": 1106, "verse_number": "१-१०७-२०", "content_sanskrit": "तस्मिन्कुरुपतिश्रेष्ठे राजराजेश्वरे सति।\nश्रिता वागभवत्सत्यं दानधर्माश्रितं मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2005378, "chapter_id": 1106, "verse_number": "१-१०७-२१", "content_sanskrit": "यज्ञार्थं पशवः सृष्टाः संतानार्थं च मैथुनम्।\nस समाः षोडशाष्टौ च चतस्रोऽष्टौ तथाऽपराः।\nरतिमप्राप्नुवन्स्त्रीषु बभूव वनगोचरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2005379, "chapter_id": 1106, "verse_number": "१-१०७-२२", "content_sanskrit": "तथारूपस्तथाचारस्तथावृत्तस्तथाश्रुतः।\nगाङ्गेयस्तस्य पुत्रोऽभून्नाम्ना देवव्रतो वसुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2005380, "chapter_id": 1106, "verse_number": "१-१०७-२३", "content_sanskrit": "सर्वास्त्रेषु स निष्णातः पार्थिवेष्वितरेषु च।\nमहाबलो महासत्वो महावीर्यो महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2005381, "chapter_id": 1106, "verse_number": "१-१०७-२४", "content_sanskrit": "स कदाचिन्मृगं विद्ध्वा गङ्गामनुसरन्नदीम्।\nभागीरथीमल्पजलां शान्तनुर्दृष्टवान्नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2005382, "chapter_id": 1106, "verse_number": "१-१०७-२५", "content_sanskrit": "तां दृष्ट्वा चिन्तयामास शान्तनुः पुरुषर्षभः।\nस्यन्दते किं न्वियं नाद्य सरिच्छ्रेष्ठा यथा पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2005383, "chapter_id": 1106, "verse_number": "१-१०७-२६", "content_sanskrit": "ततो निमित्तमन्विच्छन्ददर्श स महामनाः।\nकुमारं रूपसंपन्नं बृहन्तं चारुदर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2005384, "chapter_id": 1106, "verse_number": "१-१०७-२७", "content_sanskrit": "दिव्यमस्त्रं विकुर्वाणं यथा देवं पुरन्दरम्।\nकृत्स्नां गङ्गां समावृत्य शरैस्तीक्ष्णैरवस्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2005385, "chapter_id": 1106, "verse_number": "१-१०७-२८", "content_sanskrit": "तां शरैराचितां दृष्ट्वा नदीं गङ्गां तदन्तिके।\nअभवद्विस्मितो राजा दृष्ट्वा कर्मातिमानुषम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2005386, "chapter_id": 1106, "verse_number": "१-१०७-२९", "content_sanskrit": "जातमात्रं पुरा दृष्टं तं पुत्रं शान्तनुस्तदा।\nनोपलेभे स्मृतिं धीमानभिज्ञातुं तमात्मजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2005387, "chapter_id": 1106, "verse_number": "१-१०७-३०", "content_sanskrit": "स तु तं पितरं दृष्ट्वा मोहयामास मायया।\nसंमोह्य तु ततः क्षिप्रं तत्रैवान्तरधीयत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2005388, "chapter_id": 1106, "verse_number": "१-१०७-३१", "content_sanskrit": "तदद्बुतं ततो दृष्ट्वा तत्र राजा स शान्तनुः।\nसङ्कमानः सुतं गङ्गामब्रवीद्दर्शयेति ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2005389, "chapter_id": 1106, "verse_number": "१-१०७-३२", "content_sanskrit": "दर्शयामास तं गङ्गा बिभ्रती रूपमुत्तमम्।\nगृहीत्वा दक्षिणे पाणौ तं कुमारमलङ्कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2005390, "chapter_id": 1106, "verse_number": "१-१०७-३३", "content_sanskrit": "अलङ्कृतामाभरणैर्विरजोम्बरधारिणीम्।\nदृष्टपूर्वामपि स तां नाभ्यजानात्स शान्तनुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2005391, "chapter_id": 1106, "verse_number": "१-१०७-३४x", "content_sanskrit": "गङ्गोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2005392, "chapter_id": 1106, "verse_number": "१-१०७-३४", "content_sanskrit": "यं पुत्रमष्टमं राजंस्त्वं पुरा मय्यविन्दथाः।\nस चायं पुरुषव्याघ्र सर्वास्त्रविदनुत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2005393, "chapter_id": 1106, "verse_number": "१-१०७-३५", "content_sanskrit": "गृहाणेमं महाराज मया संवर्धितं सुतम्।\nआदाय पुरुषव्याघ्र नयस्वैनं गृहं विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2005394, "chapter_id": 1106, "verse_number": "१-१०७-३६", "content_sanskrit": "वेदानधिजगे साङ्गान्वसिष्ठादेष वीर्यवान्।\nकृतास्त्रः परमेष्वासो देवराजसमो युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2005395, "chapter_id": 1106, "verse_number": "१-१०७-३७", "content_sanskrit": "सुराणां संमतो नित्यमसुराणां च भारत।\nउशा वेद यच्छास्त्रमयं तद्वेद सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2005396, "chapter_id": 1106, "verse_number": "१-१०७-३८", "content_sanskrit": "तथैवाङ्गिरसः पुत्रः सुरसुरनमस्कृतः।\nयद्वेद शास्त्रं तच्चापि कृत्स्नमस्मिन्प्रतिष्ठितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2005397, "chapter_id": 1106, "verse_number": "१-१०७-३९", "content_sanskrit": "तव पुत्रे महाबाहौ साङ्गोपाङ्गं महात्मनि।\nऋषिः परैरनाधृष्यो जामदग्न्यः प्रतापवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2005398, "chapter_id": 1106, "verse_number": "१-१०७-४०", "content_sanskrit": "यदस्त्रं वेद राभश्च तदेतस्मिन्प्रतिष्ठितम्।\nमहेष्वासमिमं राजन्राजधर्मार्थकोविदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2005399, "chapter_id": 1106, "verse_number": "१-१०७-४१", "content_sanskrit": "मया दत्तं निजं पुत्रं वीरं वीर गृहं नय।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2005400, "chapter_id": 1106, "verse_number": "१-१०७-४१x", "content_sanskrit": "वैशम्पायन उवाच।\nइत्युक्त्वा सा महाभागा तत्रैवान्तरधीयत।\nतयैवं समनुज्ञातः पुत्रमादाय शान्तनुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2005401, "chapter_id": 1106, "verse_number": "१-१०७-४२", "content_sanskrit": "भ्राजमानं यथाऽदित्यमाययौ स्वपुरं प्रति।\nपौरवस्तु पुरीं गत्वा पुरन्दरपुरोपमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2005402, "chapter_id": 1106, "verse_number": "१-१०७-४३", "content_sanskrit": "सर्वकामसमृद्धार्थं मेने सोत्मानमात्मना।\nपौरवेषु ततः पुत्रं राज्यार्थमभयप्रदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2005403, "chapter_id": 1106, "verse_number": "१-१०७-४४", "content_sanskrit": "गुणवन्तं महात्मानं यौवराज्येऽभ्यषेचयत्।\nपौरवाञ्शान्तनोः पुत्रः पितरं च महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2005404, "chapter_id": 1106, "verse_number": "१-१०७-४५", "content_sanskrit": "राष्ट्रं च रञ्जयामास वृत्तेन भरतर्षभ।\nस तथा सह पुत्रेण रममाणो महीपतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2005405, "chapter_id": 1106, "verse_number": "१-१०७-४६", "content_sanskrit": "वर्तयामास वर्षाणि चत्वार्यमितविक्रमः।\nस कदाचिद्वनं यातो यमुनामभितो नदीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2005406, "chapter_id": 1106, "verse_number": "१-१०७-४७", "content_sanskrit": "महीपतिरनिर्देश्यमाजिघ्रद्गन्धमुत्तमम्।\nतस्य प्रभवमन्विच्छन्विचचार समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2005407, "chapter_id": 1106, "verse_number": "१-१०७-४८", "content_sanskrit": "स ददर्श तदा कन्यां दाशानां देवरूपिणीम्।\nतामपृच्छत्स दृष्ट्वैव कन्यामसितलोचनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2005408, "chapter_id": 1106, "verse_number": "१-१०७-४९", "content_sanskrit": "कस्य त्वमसि का चासि किं च भीरु चिकीर्षसि।\nसाऽब्रवीद्दाशकन्याऽस्मि धर्मार्थं वाहये तरिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2005409, "chapter_id": 1106, "verse_number": "१-१०७-५०", "content_sanskrit": "पितुर्नियोगाद्भद्रं ते दाशराज्ञो महात्मनः।\nरूपमाधुर्यगन्धैस्तां संयुक्तां देवरूपिणीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2005410, "chapter_id": 1106, "verse_number": "१-१०७-५१", "content_sanskrit": "समीक्ष्य राजा दाशेयीं कामयामास शान्तनुः।\nस गत्वा पितरं तस्या वरयामास तां तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2005411, "chapter_id": 1106, "verse_number": "१-१०७-५२", "content_sanskrit": "पर्यपृच्छत्ततस्तस्याः पितरं सोत्मकारणात्।\nस च तं प्रत्युवाचेदं दाशराजो महीपतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2005412, "chapter_id": 1106, "verse_number": "१-१०७-५३", "content_sanskrit": "जातमात्रैव मे देया वराय वरवर्णिनी।\nहृदि कामस्तु मे कश्चित्तं निबोध जनेश्वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2005413, "chapter_id": 1106, "verse_number": "१-१०७-५४", "content_sanskrit": "यदीमां धर्मपत्नीं त्वं मत्तः प्रार्थयसेऽनघ।\nसत्यवागसि सत्येन समयं कुरु मे ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2005414, "chapter_id": 1106, "verse_number": "१-१०७-५५", "content_sanskrit": "समयेन प्रदद्यां ते कन्यामहमिमां नृप।\nन हि मे त्वत्समः कश्चिद्वरो जातु भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2005415, "chapter_id": 1106, "verse_number": "१-१०७-५६x", "content_sanskrit": "शान्तनुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2005416, "chapter_id": 1106, "verse_number": "१-१०७-५६", "content_sanskrit": "श्रुत्वा तव वरं दाश व्यवस्येयमहं तव।\nदातव्यं चेत्प्रदास्यामि न त्वदेयं कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2005417, "chapter_id": 1106, "verse_number": "१-१०७-५७x", "content_sanskrit": "दाश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2005418, "chapter_id": 1106, "verse_number": "१-१०७-५७", "content_sanskrit": "अस्यां जायेत यः पुत्रः स राजा पृथिवीपते।\nत्वदूर्ध्वमभिषेक्तव्यो नान्यः कश्चन पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2005419, "chapter_id": 1106, "verse_number": "१-१०७-५८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2005420, "chapter_id": 1106, "verse_number": "१-१०७-५८", "content_sanskrit": "नाकामयत तं दातुं वरं दाशाय शान्तनुः।\nशरीरजेन तीव्रेण दह्यमानोऽपि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2005421, "chapter_id": 1106, "verse_number": "१-१०७-५९", "content_sanskrit": "स चिन्तयन्नेव तदा दाशकन्यां महीपतिः।\nप्रत्ययाद्धास्तिनपुरं कामोपहतचेतनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2005422, "chapter_id": 1106, "verse_number": "१-१०७-६०", "content_sanskrit": "ततः कदाचिच्छोचन्तं शान्तनुं ध्यानमास्थितम्।\nपुत्रो देवव्रतोऽभ्येत्य पितरं वाक्यमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2005423, "chapter_id": 1106, "verse_number": "१-१०७-६१", "content_sanskrit": "सर्वतो भवतः क्षेमं विधेयाः सर्वपार्थिवाः।\nतत्किमर्थमिहाभीक्ष्णं परिशोचसि दुःखितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2005424, "chapter_id": 1106, "verse_number": "१-१०७-६२", "content_sanskrit": "ध्यायन्निव च मां राजन्नाभिभाषसि किंचन।\nन चाश्वेन विनिर्यासि विवर्णो हरिणः कृशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2005425, "chapter_id": 1106, "verse_number": "१-१०७-६३", "content_sanskrit": "व्याधिमिच्छामि ते ज्ञातुं प्रतिकुर्यां हि तत्र वै।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2005426, "chapter_id": 1106, "verse_number": "१-१०७-६३x", "content_sanskrit": "वैशम्पायन उवाच।\nस तं काममवाच्यं वै दाशकन्यां प्रतीदृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2005427, "chapter_id": 1106, "verse_number": "१-१०७-६४", "content_sanskrit": "विवर्तुं नाशकत्तस्मै पिता पुत्रस्य शान्तनुः।\nएवमुक्तः स पुत्रेण शान्तनुः प्रत्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2005428, "chapter_id": 1106, "verse_number": "१-१०७-६५", "content_sanskrit": "असंशयं ध्यानपरो यथा वत्स तथा शृणु।\nअपत्यं नस्त्वमेवैकः कुले महति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2005429, "chapter_id": 1106, "verse_number": "१-१०७-६६", "content_sanskrit": "शस्त्रनित्यश्च सततं पौरुषे पर्यवस्थितः।\nअनित्यतां च लोकानामनुशोचामि पुत्रक॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2005430, "chapter_id": 1106, "verse_number": "१-१०७-६७", "content_sanskrit": "कथंचित्तव गाङ्गेय विपत्तौ नास्ति नः कुलम्।\nअसंशयं त्वमेवैकः शतादपि वरः सुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2005431, "chapter_id": 1106, "verse_number": "१-१०७-६८", "content_sanskrit": "न चाप्यहं वृथा भूयो दारान्कर्तुमिहोत्सहे।\nसंतानस्याविनाशाय कामये भद्रमस्तु ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2005432, "chapter_id": 1106, "verse_number": "१-१०७-६९", "content_sanskrit": "अनपत्यतैकपुत्रत्वमित्याहुर्धर्मवादिनः।\nचक्षुरेकं च पुत्रश्च अस्ति नास्ति च भारत।\nचक्षुर्नाशे तनोर्नाशः पुत्रनाशे कुलक्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2005433, "chapter_id": 1106, "verse_number": "१-१०७-७०", "content_sanskrit": "अग्निहोत्रं त्रयी विद्या यज्ञाश्च सहदक्षिणाः।\nसर्वाण्येतान्यपत्यस्य कलां नार्हन्ति षोडशीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2005434, "chapter_id": 1106, "verse_number": "१-१०७-७१", "content_sanskrit": "एवमेतन्मनुष्येषु तच्च सर्वं प्रजास्विति।\nयदपत्यं महाप्राज्ञ तत्र मे नास्ति संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2005435, "chapter_id": 1106, "verse_number": "१-१०७-७२", "content_sanskrit": "अपत्येनानृणो लोके पितॄणां नास्ति संशयः।\nएषा त्रयी पुराणानां देवतानां च शाश्वती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2005436, "chapter_id": 1106, "verse_number": "१-१०७-७३", "content_sanskrit": "अपत्यं कर्म विद्या च त्रीणि ज्योतींषि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2005437, "chapter_id": 1106, "verse_number": "१-१०७-७४", "content_sanskrit": "त्वं च शूरः सदाऽमर्षी शस्त्रनित्यश्च भारत।\nनान्यत्र युद्धात्तस्मात्ते निधनं विद्यते क्वचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2005438, "chapter_id": 1106, "verse_number": "१-१०७-७५", "content_sanskrit": "सोऽस्मि संशयमापन्नस्त्वयि शान्ते कथं भवेत्।\nइति ते कारणं तात दुःखस्योक्तमशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2005439, "chapter_id": 1106, "verse_number": "१-१०७-७६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2005440, "chapter_id": 1106, "verse_number": "१-१०७-७६", "content_sanskrit": "ततस्तत्कारणं राज्ञो ज्ञात्वा सर्वमशेषतः।\nदेवव्रतो महाबुद्धिः प्रज्ञया चान्वचिन्तयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2005441, "chapter_id": 1106, "verse_number": "१-१०७-७७", "content_sanskrit": "अपत्यफलसंयुक्तमेतच्छ्रुत्वा पितुर्वचः।\nसूतं भूयोऽपि संतप्त आह्वयामास वै पितुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2005442, "chapter_id": 1106, "verse_number": "१-१०७-७८", "content_sanskrit": "सूतस्तु कुरुमुख्यस्य उपयातस्तदाज्ञया।\nतमुवाच महाप्राज्ञो भीष्मो वै सारथिं पितुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2005443, "chapter_id": 1106, "verse_number": "१-१०७-७९", "content_sanskrit": "त्वं सारथे पितुर्मह्यं सखासि रथधूर्गतः।\nअपि जानासि यदि वै कस्यां भावो नृपस्य तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2005444, "chapter_id": 1106, "verse_number": "१-१०७-८०", "content_sanskrit": "तदाचक्ष्व भवान्पृष्टः करिष्ये न तदन्यथा।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2005445, "chapter_id": 1106, "verse_number": "१-१०७-८०x", "content_sanskrit": "सूत उवाच।\nदाशकन्या कुरुश्रेष्ठ तत्र भावः पितुर्गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2005446, "chapter_id": 1106, "verse_number": "१-१०७-८१", "content_sanskrit": "वृतः स नरदेवेन तदा वचनमब्रवीत्।\nयोऽस्यां पुमान्भवेज्जातः स राजा त्वदनन्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2005447, "chapter_id": 1106, "verse_number": "१-१०७-८२", "content_sanskrit": "नाकामयत तं दातुं पिता तव वरं तदा।\nस चापि निश्चयस्तस्य न च दद्यां ततोऽन्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2005448, "chapter_id": 1106, "verse_number": "१-१०७-८३", "content_sanskrit": "एतत्ते कथितं वीर कुरुष्व यदनन्तरम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2005449, "chapter_id": 1106, "verse_number": "१-१०७-८३x", "content_sanskrit": "वैशम्पायन उवाच।\nततः स पितुराज्ञाय मतं सम्यगवेक्ष्य च।\nज्ञात्वा च मानसं पुत्रः प्रययौ यमुनां प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2005450, "chapter_id": 1106, "verse_number": "१-१०७-८४", "content_sanskrit": "क्षत्रियैः सह धर्मात्मा पुराणैर्धर्मचारिभिः।\nउच्चैश्श्रवसमागम्य कन्यां वव्रे पितुः स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2005451, "chapter_id": 1106, "verse_number": "१-१०७-८५", "content_sanskrit": "तं दाशः प्रतिजग्राह विधिवत्प्रतिपूज्य च।\nअब्रवीच्चैनमासीनं राजसंसदि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2005452, "chapter_id": 1106, "verse_number": "१-१०७-८६", "content_sanskrit": "राज्यशुल्का प्रदातव्या कन्येयं याचतां वर।\nअपत्यं यद्भवेदस्याः स राजाऽस्तु पितुः परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2005453, "chapter_id": 1106, "verse_number": "१-१०७-८७", "content_sanskrit": "त्वमेवात्र महाबाहो शान्तनोर्वंशवर्धनः।\nपुत्रः शस्त्रभृतां श्रेष्ठः किं नु वक्ष्यामि ते वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2005454, "chapter_id": 1106, "verse_number": "१-१०७-८८", "content_sanskrit": "कुमारिकायाः शुल्कार्थं किंचिद्वक्ष्यामि भारत।\nकोहि संबन्धखं श्लाघ्यमीप्सितं यौनमीदृशम्।\nअतिक्रामन्न तप्येत साक्षादपि शतक्रतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2005455, "chapter_id": 1106, "verse_number": "१-१०७-८९", "content_sanskrit": "अपत्यं चैतदार्यस्य यो युष्माकं समो गुणैः।\nयस्य शुक्रात्सत्यवती संभूता वरवर्णिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2005456, "chapter_id": 1106, "verse_number": "१-१०७-९०", "content_sanskrit": "तेन मे बहुशस्तात पिता ते परिकीर्तितः।\nअर्हः सत्यवतीं वोढुं धर्मज्ञः स नराधिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2005457, "chapter_id": 1106, "verse_number": "१-१०७-९१", "content_sanskrit": "इयं सत्यवती देवी पितरं तेऽब्रवीत्तथा।\nअर्थितश्चापिराजर्षिः प्रत्याख्यातः पुरा मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2005458, "chapter_id": 1106, "verse_number": "१-१०७-९२", "content_sanskrit": "कन्यापितृत्वात्किंचित्तु वक्ष्यामि त्वां नराधिप।\nबलवत्सपत्नतामत्र दोषं पश्यामि केवलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2005459, "chapter_id": 1106, "verse_number": "१-१०७-९३", "content_sanskrit": "भूयांसं त्वयि पश्यामि तद्दोषमपराजित।\nयस्य हि त्वं सपत्नः स्या गन्धर्वस्यासुरस्य वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2005460, "chapter_id": 1106, "verse_number": "१-१०७-९४", "content_sanskrit": "न स जातु चिरं जीवेत्त्वयि क्रुद्धे परन्तप।\nएतावानत्र दोषो हि नान्यः कश्चन पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2005461, "chapter_id": 1106, "verse_number": "१-१०७-९५", "content_sanskrit": "एतज्जानीहि भद्रं ते दानादाने परन्तप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2005462, "chapter_id": 1106, "verse_number": "१-१०७-९६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2005463, "chapter_id": 1106, "verse_number": "१-१०७-९६", "content_sanskrit": "एवमुक्तस्तु गाङ्गेयस्तद्युक्तं प्रत्यभाषत।\nशृण्वतां भूमिपालानां पितुरर्थाय भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2005464, "chapter_id": 1106, "verse_number": "१-१०७-९७", "content_sanskrit": "इदं वचनमाधत्स्व नास्ति वक्तास्य मत्समः।\nअन्यो जातो न जनिता न च कश्चन संप्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2005465, "chapter_id": 1106, "verse_number": "१-१०७-९८", "content_sanskrit": "एवमेतत्करिष्यामि यथा त्वमनुभाषसे।\nयोऽस्यां जनिष्यते पुत्रः स नो राजा भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2005466, "chapter_id": 1106, "verse_number": "१-१०७-९९", "content_sanskrit": "इत्युक्तः पुनरेव स्म तं दाशः प्रत्यभाषत।\nचिकीर्षुर्दुष्करं कर्म राज्यार्थे भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2005467, "chapter_id": 1106, "verse_number": "१-१०७-१००", "content_sanskrit": "त्वमेव नाथः संप्राप्तः शान्तनोरमितद्युते।\nकन्यायाश्चैव धर्मात्मन्प्रभुर्दानाय चेश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2005468, "chapter_id": 1106, "verse_number": "१-१०७-१०१", "content_sanskrit": "इदं तु वचनं सौम्य कार्यं चैव निबोध मे।\nकौमारिकाणां शीलेन वक्ष्याम्यहमरिन्दम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2005469, "chapter_id": 1106, "verse_number": "१-१०७-१०२", "content_sanskrit": "यत्त्वया सत्यवत्यर्थे सत्यधर्मपरायण।\nराजमध्ये प्रतिज्ञातमनुरूपं तवैव तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2005470, "chapter_id": 1106, "verse_number": "१-१०७-१०३", "content_sanskrit": "नान्यथा तन्महाबाहो संशयोऽत्र न कश्चन।\nतवापत्यं भवेद्यत्तु तत्र नः संशयो महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2005471, "chapter_id": 1106, "verse_number": "१-१०७-१०४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2005472, "chapter_id": 1106, "verse_number": "१-१०७-१०४", "content_sanskrit": "तस्यैतन्मतमाज्ञाय सत्यधर्मपरायणः।\nप्रत्यजानात्तदा राजन्पितुः प्रियचिकीर्षया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2005473, "chapter_id": 1106, "verse_number": "१-१०७-१०५x", "content_sanskrit": "गाङ्गेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2005474, "chapter_id": 1106, "verse_number": "१-१०७-१०५", "content_sanskrit": "उच्चैश्श्रवः समाधत्स्व प्रतिज्ञां जनसंसदि।\nऋषयो वाथ वा देवा भूतान्यन्तर्हितानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2005475, "chapter_id": 1106, "verse_number": "१-१०७-१०६", "content_sanskrit": "यानि यानीह शृण्वन्तु नास्ति वक्तास्य मत्समः।\nदाशराज निबोधेदं वचनं मे नृपोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2005476, "chapter_id": 1106, "verse_number": "१-१०७-१०७", "content_sanskrit": "शृण्वतां भूमिपालानां यद्ब्रवीमि पितुः कृते।\nराज्यं तावत्पूर्वमेव मया त्यक्तं नराधिपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2005477, "chapter_id": 1106, "verse_number": "१-१०७-१०८", "content_sanskrit": "अपत्यहेतोरपि च करिष्येऽद्य विनिश्चयम्।\nअद्यप्रभृति मे दाश ब्रह्मचर्यं भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2005478, "chapter_id": 1106, "verse_number": "१-१०७-१०९", "content_sanskrit": "अपुत्रस्यापि मे लोका भविष्यन्त्यक्षया दिवि।\nन हि जन्मप्रभृत्युक्तं मया किंचिदिहानृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2005479, "chapter_id": 1106, "verse_number": "१-१०७-११०", "content_sanskrit": "यावत्प्राणा ध्रियन्ते वै मम देहं समाश्रिताः।\nतावन्न जनयिष्यामि पित्रे कन्यां प्रयच्छ मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2005480, "chapter_id": 1106, "verse_number": "१-१०७-१११", "content_sanskrit": "परित्यजाम्यहं राज्यं मैथुनं चापि सर्वशः।\nऊर्ध्वरेता भविष्यामि दाश सत्यं ब्रवीमि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2005481, "chapter_id": 1106, "verse_number": "१-१०७-११२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2005482, "chapter_id": 1106, "verse_number": "१-१०७-११२", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा संप्रहृष्टतनूरुहः।\nददानीत्येव तं दाशो धर्मात्मा प्रत्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 2005483, "chapter_id": 1106, "verse_number": "१-१०७-११३", "content_sanskrit": "ततोन्तरिक्षेऽप्सरसो देवाः सर्षिगणास्तदा।\nतद्दृष्टा दुष्करं कर्म प्रशशंसुश्च पार्थिवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 2005484, "chapter_id": 1106, "verse_number": "१-१०७-११४", "content_sanskrit": "अभ्यवर्षन्त कुसुमैर्भीष्मोऽयमिति चाब्रुवन्।\nततः स पितुरर्थाय तामुवाच यशस्विनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 2005485, "chapter_id": 1106, "verse_number": "१-१०७-११५", "content_sanskrit": "अधिरोह रथं मातर्गच्छावः स्वगृहानिति।\nएवमुक्त्वा तु भीष्मस्तां रथमारोप्य भामिनीं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 2005486, "chapter_id": 1106, "verse_number": "१-१०७-११६", "content_sanskrit": "आगम्य हास्तिनपुरं शान्तनोः संन्यवेदयत्।\nतस्य तद्दुष्करं कर्म प्रशशंसुर्नाराधिपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 2005487, "chapter_id": 1106, "verse_number": "१-१०७-११७", "content_sanskrit": "समेताश्च पृथक्चैव भीष्मोयमिति चाब्रुवन्।\nतच्छ्रुत्वा दुष्करं कर्म कृतं भीष्मेण शान्तनुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 2005488, "chapter_id": 1106, "verse_number": "१-१०७-११८", "content_sanskrit": "बभूव दुःखितो राजा चिररात्राय भारत।\nस तेन कर्मणा सूनोः प्रीतस्तस्मै वरं ददौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 2005489, "chapter_id": 1106, "verse_number": "१-१०७-११९", "content_sanskrit": "स्वच्छन्दमरणं तुष्टो ददौ तस्मै महात्मने।\nन ते मृत्युः प्रभविता यावज्जीवितुमिच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 2005490, "chapter_id": 1106, "verse_number": "१-१०७-१२०", "content_sanskrit": "त्वत्तो ह्यनुज्ञां संप्राप्य मृत्युः प्रभविताऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 2005491, "chapter_id": 1106, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि सप्ताधिकशततमोऽध्यायः॥ १०७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}]