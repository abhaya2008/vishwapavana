[{"id": 2136698, "chapter_id": 3964, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2136699, "chapter_id": 3964, "verse_number": "१", "content_sanskrit": "स हत्वा रावणं क्षुद्रं राक्षसेन्द्रं सुरद्विषम् ।\nबभूव हृष्टः ससुहृद् रामः सौमित्रिणा सह \t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2136700, "chapter_id": 3964, "verse_number": "२", "content_sanskrit": "ततो हते दशग्रीवे देवाः सर्षिपुरोगमाः ।\nआशीर्भिर्जययुक्ताभिरानर्चुस्तं महाभुजम् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2136701, "chapter_id": 3964, "verse_number": "३", "content_sanskrit": "रामं कमलपत्राक्षं तुष्टुवुः सर्वदेवताः ।\nगन्धर्वाः पुष्पवर्षाश्च वाग्भिश्च त्रिदशालयाः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2136702, "chapter_id": 3964, "verse_number": "४", "content_sanskrit": "पूजयित्वा यथा रामं प्रतिजग्मुर्यथागतम् ।\nतन्महोत्सवसङ्काशमासीदाकाशमच्युत \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2136703, "chapter_id": 3964, "verse_number": "५", "content_sanskrit": "ततो हत्वा दशग्रीवं लङ्कां रामो महायशाः ।\nविभीषणाय प्रददौ प्रभुः परपुरञ्जयः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2136704, "chapter_id": 3964, "verse_number": "६", "content_sanskrit": "ततः सीतां पुरस्कृत्य विभीषणपुरस्कृताम् ।\nअविन्ध्यो नाम सुप्रज्ञो वृद्धामात्यो विनिर्ययौ \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2136705, "chapter_id": 3964, "verse_number": "७", "content_sanskrit": "उवाच च महात्मानं काकुत्स्थं दैन्यमास्थितः ।\nप्रतीच्छ देवीं सद्वृत्तां महात्मञ्जानकीमिति \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2136706, "chapter_id": 3964, "verse_number": "८", "content_sanskrit": "एतच्छ्रुत्वा वचस्तस्मादवतीर्य रथोत्तमात् ।\nबाष्पेणापिहितां सीतां ददर्शेक्ष्वाकुनन्दनः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2136707, "chapter_id": 3964, "verse_number": "९", "content_sanskrit": "तां दृष्ट्वा चारुसर्वाङ्गीं यानस्थां शोककर्शिताम् ।\nमलोपचितसर्वाङ्गीं जटिलां कृष्णवाससम् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2136708, "chapter_id": 3964, "verse_number": "", "content_sanskrit": "उवाच रामो वैदेहीं परामर्शविशङ्कितः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2136709, "chapter_id": 3964, "verse_number": "", "content_sanskrit": "श्रीरामः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2136710, "chapter_id": 3964, "verse_number": "१०", "content_sanskrit": "गच्छ वैदेहि मुक्ता त्वं यत्कार्यं तन्मया कृतम् ।\nलक्षयित्वेङ्गितं सर्वं प्रियं तस्यै निवेद्य सः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2136711, "chapter_id": 3964, "verse_number": "११", "content_sanskrit": "मामासाद्य पतिं भद्रे न त्वं राक्षसवेश्मनि ।\nजरां व्रजेथा इति मे निहतोऽसौ निशाचरः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2136712, "chapter_id": 3964, "verse_number": "१२", "content_sanskrit": "कथं ह्यस्मद्विधो जातु जानन् धर्मविनिश्चयम् ।\nपरहस्तगतां नारीं मुहूर्तमपि धारयेत् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2136713, "chapter_id": 3964, "verse_number": "१३", "content_sanskrit": "सुवृत्तामसुवृत्तां वाऽप्यहं त्वामद्य मैथिलि ।\nनोत्सहे परिभोगाय श्वावलीढं हविर्यथा \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2136714, "chapter_id": 3964, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2136715, "chapter_id": 3964, "verse_number": "१४", "content_sanskrit": "ततः सा सहसा बाला तच्छ्रुत्वा दारुणं वचः ।\nपपात देवी व्यथिता निकृत्ता कदळी यथा \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2136716, "chapter_id": 3964, "verse_number": "१५", "content_sanskrit": "योऽप्यस्या हर्षसम्भूतो मुखरागस्तदाभवत् ।\nक्षणेन स पुनर्नष्टो निःश्वास इव दर्पणे \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2136717, "chapter_id": 3964, "verse_number": "१६", "content_sanskrit": "ततस्ते हरयः सर्वे तच्छ्रुत्वा रामभाषितम् ।\nगतासुकल्पा निश्चेष्टा बभूवुः सहलक्ष्मणाः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2136718, "chapter_id": 3964, "verse_number": "१७", "content_sanskrit": "ततो देवो विशुद्धात्मा विमानेन चतुर्मुखः ।\nपद्मयोनिर्जगत्स्रष्टा दर्शयामास राघवम् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2136719, "chapter_id": 3964, "verse_number": "१८", "content_sanskrit": "शक्रश्चाग्निश्च वायुश्च यमो वरुण एव च ।\nयक्षाधिपश्च भगवांस्तथा सप्तर्षयोऽमलाः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2136720, "chapter_id": 3964, "verse_number": "१९", "content_sanskrit": "राजा दशरथश्चैव दिव्यभास्वरमूर्तिमान् ।\nविमानेन महार्हेण हंसयुक्तेन भास्वता \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2136721, "chapter_id": 3964, "verse_number": "२०", "content_sanskrit": "ततोऽन्तरिक्षं तत्सर्वं देवगन्धर्वसङ्कुलम् ।\nशुशुभे तारकाचित्रं शरदीव नभस्तलम् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2136722, "chapter_id": 3964, "verse_number": "२१", "content_sanskrit": "तत उत्थाय वैदही तेषां मध्ये यशस्विनी ।\nउवाच वाक्यं कल्याणी रामं पृथुलवक्षसम् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2136723, "chapter_id": 3964, "verse_number": "", "content_sanskrit": "सीता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2136724, "chapter_id": 3964, "verse_number": "२२", "content_sanskrit": "राजपुत्र न ते दोषं करोमि विदिता हि ते ।\nगतिः स्त्रीणां नराणां च शृणु चेदं वचो मम \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2136725, "chapter_id": 3964, "verse_number": "२३", "content_sanskrit": "अन्तश्चरति भूतानां मातरिश्वा सदागतिः ।\nस मे विमुञ्चतु प्राणान् यदि पापं चराम्यहम् \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2136726, "chapter_id": 3964, "verse_number": "२४", "content_sanskrit": "अग्निरापस्तथाऽकाशं पृथिवी वायुरेव च ।\nविमुञ्चन्तु मम प्राणान् यदि पापं चराम्यहम् \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2136727, "chapter_id": 3964, "verse_number": "२५", "content_sanskrit": "यथाहं त्वदृते वीर नान्यं स्वप्नेऽप्यचिन्तयम् ।\nतथा मे देवनिर्दिष्टस्त्वमेव हि पतिर्भव \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2136728, "chapter_id": 3964, "verse_number": "२६", "content_sanskrit": "ततोऽन्तरिक्षे वागासीत् सुभगा लोकसाक्षिणी ।\nपुण्या संहर्षणी तेषां वानराणां महात्मनाम् \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2136729, "chapter_id": 3964, "verse_number": "", "content_sanskrit": "वायुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2136730, "chapter_id": 3964, "verse_number": "२७", "content_sanskrit": "भो भो राघव सत्यं वै वायुरस्मि सदागतिः।\nअपापा मैथिली राजन् सङ्गच्छ सह भार्यया \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2136731, "chapter_id": 3964, "verse_number": "", "content_sanskrit": "अग्निः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2136732, "chapter_id": 3964, "verse_number": "२८", "content_sanskrit": "अहमन्तःशरीरस्थो भूतानां रघुनन्दन ।\nसुसूक्ष्ममपि काकुत्स्थ मैथिली नापराध्यति \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2136733, "chapter_id": 3964, "verse_number": "", "content_sanskrit": "वरुणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2136734, "chapter_id": 3964, "verse_number": "२९", "content_sanskrit": "रसा वै मत्प्रसूता हि भूतदेहेषु राघव ।\nअहं वै त्वां प्रब्रवीमि मैथिली प्रतिगृह्यताम् \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2136735, "chapter_id": 3964, "verse_number": "३०", "content_sanskrit": "धर्मोऽहमस्मि काकुत्स्थ साक्षी लोकस्य कर्मणाम् ।\nशुभाशुभानां सीतेयमपापा प्रतिगृह्यताम् \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2136736, "chapter_id": 3964, "verse_number": "", "content_sanskrit": "ब्रह्मा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2136737, "chapter_id": 3964, "verse_number": "३१", "content_sanskrit": "पुत्र नैतदिहाश्चर्यं त्वयि राजर्षिधर्मणि ।\nसाधो सद्वृत्त काकुत्स्थ शृणु चेदं वचो मम \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2136738, "chapter_id": 3964, "verse_number": "३२", "content_sanskrit": "शत्रुरेष त्वया वीर देवगन्धर्वभोगिनाम् ।\nयक्षाणां दानवानां च महर्षीणां च पातितः \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2136739, "chapter_id": 3964, "verse_number": "३३", "content_sanskrit": "अवध्यः सर्वभूतानां मत्प्रसादात् पुराऽभवत् ।\nकस्माच्चित् कारणात् पापः कञ्चित् कालमुपेक्षितः \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2136740, "chapter_id": 3964, "verse_number": "३४", "content_sanskrit": "वधार्थमात्मनस्तेन हृता सीता दुरात्मना ।\nनलकूबरशापेन रक्षा चास्याः कृता मया \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2136741, "chapter_id": 3964, "verse_number": "३५", "content_sanskrit": "यदि ह्यकामां सेवेत स्त्रियमन्यामपि ध्रुवम् ।\nशतधास्य फलेन्मूर्धा इत्युक्तः सोऽभवत् पुरा \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2136742, "chapter_id": 3964, "verse_number": "३६", "content_sanskrit": "नात्र शङ्का त्वया कार्या प्रतीच्छेमां महाद्युते ।\nकृतं त्वया महत्कार्यं देवानाममरप्रभ \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2136743, "chapter_id": 3964, "verse_number": "", "content_sanskrit": "दशरथः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2136744, "chapter_id": 3964, "verse_number": "३७", "content_sanskrit": "प्रीतोऽस्मि वत्स भद्रं ते पिता दशरथोऽस्मि ते ।\nअनुजानामि राज्यं च प्रशाधि पुरुषोत्तम \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2136745, "chapter_id": 3964, "verse_number": "", "content_sanskrit": "रामः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2136746, "chapter_id": 3964, "verse_number": "३८", "content_sanskrit": "अभिवादये त्वां राजेन्द्र यदि त्वं जनको मम ।\nगमिष्यामि पुरीं रम्यामयोध्यां शासनात् तव \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2136747, "chapter_id": 3964, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2136748, "chapter_id": 3964, "verse_number": "३९", "content_sanskrit": "तमुवाच पिता भूयः प्रहृष्टो भरतर्षभ ।\nगच्छायोध्यां प्रशाधीति रामं रक्तान्तलोचनम् \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2136749, "chapter_id": 3964, "verse_number": "४०", "content_sanskrit": "सम्पूर्णानीह वर्षाणि चतुर्दश महाद्युते \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2136750, "chapter_id": 3964, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2136751, "chapter_id": 3964, "verse_number": "४१", "content_sanskrit": "ततो देवान् नमस्कृत्य सुहृद्भिरभिनन्दितः ।\nमहेन्द्र इव पौलोम्या भार्यया स समेयिवान् \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2136752, "chapter_id": 3964, "verse_number": "४२", "content_sanskrit": "ततो वरं ददौ तस्मै ह्यविन्ध्याय परन्तपः ।\nत्रिजटां चार्थमानाभ्यां योजयामास राक्षसीम् \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2136753, "chapter_id": 3964, "verse_number": "", "content_sanskrit": "तमुवाच ततो ब्रह्मा देवैः शक्रपुरोगमैः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2136754, "chapter_id": 3964, "verse_number": "", "content_sanskrit": "ब्रह्मा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2136755, "chapter_id": 3964, "verse_number": "४३", "content_sanskrit": "कौसल्यामातरिष्टांस्ते वरानद्य ददानि कान् \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2136756, "chapter_id": 3964, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2136757, "chapter_id": 3964, "verse_number": "४४", "content_sanskrit": "वव्रे रामः स्थितिं धर्मे शत्रुभिश्चापराजयम् ।\nराक्षसैर्निहतानां च वानराणां समुद्भवम् \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2136758, "chapter_id": 3964, "verse_number": "४५", "content_sanskrit": "ततस्ते ब्रह्मणा प्रोक्ते तथेति वचने तदा ।\nसमुत्तस्थुर्महाराज वानरा लब्धचेतसः \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2136759, "chapter_id": 3964, "verse_number": "", "content_sanskrit": "सीता चापि महाभागा वरं हनुमते ददौ ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2136760, "chapter_id": 3964, "verse_number": "", "content_sanskrit": "सीता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2136761, "chapter_id": 3964, "verse_number": "४६", "content_sanskrit": "रामकीर्त्या समं पुत्र जीवितं ते भविष्यति \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2136762, "chapter_id": 3964, "verse_number": "४७", "content_sanskrit": "दिव्यास्त्वामुपभोगाश्च मत्प्रसादकृताः सदा ।\nउपस्थास्यन्ति हनुमन्निति स्म हरिलोचन \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2136763, "chapter_id": 3964, "verse_number": "४८", "content_sanskrit": "ततस्ते प्रेक्षमाणानां तेषामक्लिष्टकर्मणाम् ।\nअन्तर्धानं ययुर्देवाः सर्वे शक्रपुरोगमाः \t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2136764, "chapter_id": 3964, "verse_number": "४९", "content_sanskrit": "दृष्ट्वा रामं तु जानक्या सङ्गतं शक्रसारथिः ।\nउवाच परमप्रीतः सुहृन्मध्य इदं वचः \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2136765, "chapter_id": 3964, "verse_number": "", "content_sanskrit": "मातलिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2136766, "chapter_id": 3964, "verse_number": "५०", "content_sanskrit": "देवगन्धर्वयक्षाणां मानुषासुरभोगिनाम् ।\nअपनीतं त्वया दुःखमिदं सत्यपराक्रम \t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2136767, "chapter_id": 3964, "verse_number": "५१", "content_sanskrit": "सदेवासुरगन्धर्वा यक्षराक्षसपन्नगाः ।\nकथयिष्यन्ति लोकास्त्वां यावद् भूमिर्धरिष्यति \t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2136768, "chapter_id": 3964, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2136769, "chapter_id": 3964, "verse_number": "५२", "content_sanskrit": "इत्येवमुक्त्वानुज्ञाप्य रामं शस्त्रभृतां वरम् ।\nसम्पूज्यापाक्रमत्तेन रथेनादित्यवर्चसा \t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2136770, "chapter_id": 3964, "verse_number": "५३", "content_sanskrit": "ततः सीतां पुरस्कृत्य रामः सौमित्रिणा सह ।\nसुग्रीवप्रमुखैश्चैव सहितः सर्ववानरैः \t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2136771, "chapter_id": 3964, "verse_number": "५४", "content_sanskrit": "विधाय रक्षां लङ्कायां विभीषणपुरस्कृतः ।\nसन्ततार पुनस्तेन सेतुना मकरालयम् \t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2136772, "chapter_id": 3964, "verse_number": "५५", "content_sanskrit": "पुष्पकेण विमानेन खेचरेण विराजता ।\nकामगेन यथामुख्यैरमात्यैः संवृतो वशी\t ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2136773, "chapter_id": 3964, "verse_number": "५६", "content_sanskrit": "ततस्तीरे समुद्रस्य यत्र शिश्ये स पार्थिवः ।\nतत्रैवोवास धर्मात्मा सहितः सर्ववानरैः \t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2136774, "chapter_id": 3964, "verse_number": "५७", "content_sanskrit": "अथैनान् राघवः काले समानीयाभिपूज्य च ।\nविसर्जयामास तदा रत्नैः सन्तोष्य सर्वशः \t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2136775, "chapter_id": 3964, "verse_number": "५८", "content_sanskrit": "गतेषु तेषु सर्वेषु(वानरेन्द्रेषु) गोपुच्छर्क्षेषु तेषु च ।\nसुग्रीवसहितो रामः किष्किन्धां पुनरागमत् \t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2136776, "chapter_id": 3964, "verse_number": "५९", "content_sanskrit": "विभीषणेनानुगतः सुग्रीवसहितस्तदा ।\nपुष्पकेण विमानेन वैदेह्या दर्शयन्वनम् \t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2136777, "chapter_id": 3964, "verse_number": "६०", "content_sanskrit": "किष्किन्धां तु समासाद्य रामः प्रहरतां वरः ।\nअङ्गदं कृतकर्माणं यौवराज्येऽभ्यषेचयत् \t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2136778, "chapter_id": 3964, "verse_number": "६१", "content_sanskrit": "ततस्तैरेव सहितो रामः सौमित्रिणा सह ।\nयथागतेन मार्गेण प्रययौ स्वपुरं प्रति \t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2136779, "chapter_id": 3964, "verse_number": "६२", "content_sanskrit": "अयोध्यां स समासाद्य पुरीं राष्ट्रपतिस्ततः ।\nभरताय हनूमन्तं दूतं प्रास्थापयत् तदा \t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2136780, "chapter_id": 3964, "verse_number": "६३", "content_sanskrit": "लक्षयित्वेङ्गितं सर्वं प्रियं तस्मै निवेद्य वै ।\nवायुपुत्रे पुनः प्राप्ते नन्दिग्राममुपागमत् \t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2136781, "chapter_id": 3964, "verse_number": "६४", "content_sanskrit": "स तत्र मलदिग्धाङ्गं भरतं चीरवाससम् ।\nनन्दिग्रामगतं रामः सशत्रुघ्नं स राघवः ।\nअग्रतः पादुके कृत्वा ददर्शासीनमासने \t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2136782, "chapter_id": 3964, "verse_number": "६५", "content_sanskrit": "सङ्गतो भरतेनाथ शत्रुघ्नेन च वीर्यवान् ।\nराघवः सहसौमित्रिर्मुमुदे भरतर्षभ \t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2136783, "chapter_id": 3964, "verse_number": "६६", "content_sanskrit": "ततो भरतशुत्रुघ्नौ समेतौ गुरुणा तदा ।\nवैदेह्या दर्शनेनोभौ प्रहर्षं समवापतुः \t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2136784, "chapter_id": 3964, "verse_number": "६७", "content_sanskrit": "तस्मै तद् भरतो राज्यमागतायातिसत्कृतम् ।\nन्यासं निर्यातयामास युक्तः परमया मुदा \t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2136785, "chapter_id": 3964, "verse_number": "६८", "content_sanskrit": "ततस्तं वैष्णवे शूरं नक्षत्रेऽभिमतेऽहनि ।\nवसिष्ठो वामदेवश्च सहितावभ्यषिञ्चताम् \t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2136786, "chapter_id": 3964, "verse_number": "६९", "content_sanskrit": "सोऽभिषिक्तः कपिश्रेष्ठं सुग्रीवं ससुहृज्जनम् ।\nविभीषणं च पौलस्त्यमन्वजानाद् गृहान् प्रति \t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2136787, "chapter_id": 3964, "verse_number": "७०", "content_sanskrit": "अभ्यर्च्य विविधैर्भोगैः प्रीतियुक्तौ मुदा युतौ ।\nसमाधायेतिकर्तव्यं दुःखेन विससर्ज ह \t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2136788, "chapter_id": 3964, "verse_number": "७१", "content_sanskrit": "पुष्पकं च विमानं तत्पूजयित्वा स राघवः ।\nप्रादाद् वैश्रवणायैव प्रीत्या स रघुनन्दनः \t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2136789, "chapter_id": 3964, "verse_number": "७२", "content_sanskrit": "ततो देवर्षिसहितः सरितं गोमतीमनु ।\nदशाश्वमेधानाजह्रे जारूथ्यान् स निरर्गलान् \t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2136790, "chapter_id": 3964, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि रामोपाख्यानपर्वणि श्रीरामाभिषेके अशीत्यधिकद्विशततमोऽध्यायः ॥२८०॥\nरामोपाख्यानपर्वणि विंशोऽध्यायः ॥२०॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}]