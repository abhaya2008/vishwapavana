[{"id": 2207116, "chapter_id": 5415, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2207117, "chapter_id": 5415, "verse_number": "१", "content_sanskrit": "कच्चित् सुखं स्वपिषि त्वं बृहस्पते\nकच्चिन्मनोज्ञाः परिचारकास्ते ।\nकच्चिद्देवानां सुखकामोऽसि विप्र\nकच्चिदेवास्त्वां सुभृशं पालयन्ति\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2207118, "chapter_id": 5415, "verse_number": "", "content_sanskrit": "बृहस्पतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2207119, "chapter_id": 5415, "verse_number": "२", "content_sanskrit": "सुखं शयेऽहं शयने महेन्द्र\nतथा मनोज्ञाः परिचारका मे ।\nतथा देवानां सुखकामोऽस्मि शक्र\nदेवाश्च मां सुभृशं पालयन्ति\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2207120, "chapter_id": 5415, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2207121, "chapter_id": 5415, "verse_number": "३", "content_sanskrit": "कुतो दुःखं मानसं देहजं वा\nपाण्डुर्विवर्णश्च कुतस्त्वमद्य ।\nआचक्ष्व मे तद् द्विजवर्य यावत्\nनिहन्मि सर्वांस्तव दुःखकर्तॄन्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2207122, "chapter_id": 5415, "verse_number": "", "content_sanskrit": "बृहस्पतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2207123, "chapter_id": 5415, "verse_number": "४", "content_sanskrit": "मरुत्तमाहुर्मघवन् यक्ष्यमाणं\nमहायज्ञेनोत्तमदक्षिणेन ।\nतं संवर्तो याजयतीति मे श्रुतं\nतदिच्छामि नः स न तं याजयेत\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2207124, "chapter_id": 5415, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2207125, "chapter_id": 5415, "verse_number": "५", "content_sanskrit": "सर्वान् कामाननुजानासि विप्र\nत्वं देवानां मन्त्रयसे पुरोधाः ।\nउभौ च ते जन्ममृत्यू व्यतीतौ\nकिं संवर्तस्तव कर्ताऽद्य विप्र\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2207126, "chapter_id": 5415, "verse_number": "", "content_sanskrit": "बृहस्पतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2207127, "chapter_id": 5415, "verse_number": "६", "content_sanskrit": "देवैः सह त्वमसुरान् सम्प्रणुद्य\nजिघांससे चाप्युत सानुबन्धान् ।\nयं यं समृद्धं पश्यसि यत्र तत्र\nदुःखं सपत्नेषु समृद्धभावः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2207128, "chapter_id": 5415, "verse_number": "७", "content_sanskrit": "अतोऽस्मि देवेन्द्र विवर्णरूपः\nसपत्नो मे वर्धते तन्निशम्य ।\nसर्वोपायैर्मघवंस्त्वं नियच्छ\nसंवर्तं वा पार्थिवं वा मरुत्तम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2207129, "chapter_id": 5415, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2207130, "chapter_id": 5415, "verse_number": "८", "content_sanskrit": "एहि गच्छ प्रहितो जातवेदो\nबृहस्पतिं परिदातुं मरुत्ते ।\nअयं वै त्वां याजयिता बृहस्पतिः\nतथाऽमरं चैव करिष्यतीति\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2207131, "chapter_id": 5415, "verse_number": "", "content_sanskrit": "अग्निः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2207132, "chapter_id": 5415, "verse_number": "९", "content_sanskrit": "अहं गच्छामि तव शक्राद्य दूतो\nबृहस्पतिं परिदातुं मरुत्ते ।\nवाचं सत्यां ते पुरुहूत कर्तुं\nबृहस्पतेश्चापचितिं चिकीर्षन्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2207133, "chapter_id": 5415, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2207134, "chapter_id": 5415, "verse_number": "१०", "content_sanskrit": "ततः प्रायाद् धूमकेतुर्महात्मा\nवनस्पतीन् वीरुधश्चावमृद्नन् ।\nकामाद्धिमान्ते परिवर्धमानः\nकाष्ठामृतौ मातरिश्वेव मृद्नन्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2207135, "chapter_id": 5415, "verse_number": "", "content_sanskrit": "मरुत्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2207136, "chapter_id": 5415, "verse_number": "११", "content_sanskrit": "आश्चर्यमद्य पश्यामि रूपिणं वह्निमागतम् ।\nआसनं सलिलं पाद्यं गां चोपानय वै मुने\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2207137, "chapter_id": 5415, "verse_number": "", "content_sanskrit": "अग्निः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2207138, "chapter_id": 5415, "verse_number": "१२", "content_sanskrit": "आसनं सलिलं पाद्यं प्रतिनन्दामि तेऽनघ ।\nइण्द्रेण तु समादिष्टं विद्धि मां दूतमागतम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2207139, "chapter_id": 5415, "verse_number": "", "content_sanskrit": "मरुत्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2207140, "chapter_id": 5415, "verse_number": "१३", "content_sanskrit": "कच्चिच्छ्रीमान् देवराजः सुखी नः\nकच्चिच्चास्माभिः प्रीयते धूमकेतो ।\nकच्चिद्देवाश्चास्य वशे यथावत्\nतद् ब्रूहि त्वं मम कार्त्स्न्येन देव\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2207141, "chapter_id": 5415, "verse_number": "", "content_sanskrit": "अग्निः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2207142, "chapter_id": 5415, "verse_number": "१४", "content_sanskrit": "शक्रो भृशं स सुखी पार्थिवेन्द्र\nप्रीतिं चेच्छत्यजरां देवराजः ।\nदेवाश्च सर्वे वशगास्तस्य राजन्\nसन्देशं तु शृणु मे देवराज्ञः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2207143, "chapter_id": 5415, "verse_number": "१५", "content_sanskrit": "यदर्थं वै प्राहिणोत् त्वत्सकाशं\nबृहस्पतिं परिदातुं मरुत्ते ।\nअयं गुरुर्याजयतां नृप त्वां\nमर्त्यं सन्तममरं त्वां करोतु\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2207144, "chapter_id": 5415, "verse_number": "", "content_sanskrit": "मरुत्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2207145, "chapter_id": 5415, "verse_number": "१६", "content_sanskrit": "संवर्तो मे याजयिता द्विजोत्तमो\nबृहस्पतेरञ्जलिरेष तस्य ।\nनासौ देवं याजयित्वा महेन्द्रं\nमर्त्यं सन्तं याजयन्नद्य शोभेत्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2207146, "chapter_id": 5415, "verse_number": "", "content_sanskrit": "अग्निः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2207147, "chapter_id": 5415, "verse_number": "१७", "content_sanskrit": "ये ये लोका देवलोके महान्तः\nसम्प्राप्स्यसे देवराजप्रसादात् ।\nत्वां चेदसौ याजयेद् वै बृहस्पतिः\nनूनं स्वर्गं त्वं जयेः कीर्तियुक्तः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2207148, "chapter_id": 5415, "verse_number": "१८", "content_sanskrit": "तथा लोका मानुषा ये च दिव्याः\nप्रजापतेश्चापि ये वै महान्तः\nएते च ते देवराज्यं च कृत्स्नं\nबृहस्पतिश्चेद् याजयेत् त्वां नरेन्द्र\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2207149, "chapter_id": 5415, "verse_number": "", "content_sanskrit": "संवर्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2207150, "chapter_id": 5415, "verse_number": "१९", "content_sanskrit": "मा स्मैव त्वं पुनरागाः कथञ्चिद्\nबृहस्पतिं परिदातुं मरुत्ते ।\nमा त्वा धक्ष्ये चक्षुषा दारुणेन\nसङ्क्रुद्धोऽहं पावक तन्निबोध\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2207151, "chapter_id": 5415, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2207152, "chapter_id": 5415, "verse_number": "२०", "content_sanskrit": "ततो देवानागमद् धूमकेतुः\nदाहाद् भीतो व्यथितोऽश्वत्थपर्णवत् ।\nतं वै दृष्ट्वा प्राह शक्रो महात्मा\nबृहस्पतेः सन्निधौ हव्यवाहम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2207153, "chapter_id": 5415, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2207154, "chapter_id": 5415, "verse_number": "२१", "content_sanskrit": "यत् त्वं गतः प्रहितो जातवेदो\nबृहस्पतिं परिदातुं मरुत्ते ।\nतत् किं प्राह स नृपो यक्ष्यमाणः\nकच्चिद् वचः प्रतिगृह्णाति तच्च\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2207155, "chapter_id": 5415, "verse_number": "", "content_sanskrit": "अग्निः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2207156, "chapter_id": 5415, "verse_number": "२२", "content_sanskrit": "न ते वाक्यं रोचयते मरुत्तो\nबृहस्पतेरञ्जलिं प्राहिणोत् सः ।\nसंवर्तो मां याजयितेत्यभीक्ष्णं\nपुनः पुनः स मया प्रोच्यमानः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2207157, "chapter_id": 5415, "verse_number": "२३", "content_sanskrit": "उवाचेदं मानुषा ये च दिव्याः\nप्रजापतेर्य च लोका महान्तः ।\nतांश्चेल्लभेयं संविदं तेन कृत्वा\nतथाऽपि नेच्छेयमिति प्रतीतः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2207158, "chapter_id": 5415, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2207159, "chapter_id": 5415, "verse_number": "२४", "content_sanskrit": "पुनर्भवान् पार्थिवं त्वं समेत्य\nवाक्यं मदीयं प्रापयस्वार्थयुक्तम् ।\nपुनर्यदुक्तो न करिष्यते वचः\nततो वज्रं सम्प्रहर्तास्मि तस्मै\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2207160, "chapter_id": 5415, "verse_number": "", "content_sanskrit": "अग्निः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2207161, "chapter_id": 5415, "verse_number": "२५", "content_sanskrit": "गन्धर्वराड् यात्वयं तत्र दूतो\nबिभेम्यहं वासव तत्र गन्तुम् ।\nसंरब्धो मामुक्तवांस्तीक्ष्णरोषः\nसंवर्तो वाक्यं चरितब्रह्मचर्यः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2207162, "chapter_id": 5415, "verse_number": "२६", "content_sanskrit": "यद्यागच्छेः पुनरेवं कथञ्चिद्\nबृहस्पतिं परिदातुं मरुत्ते ।\nदहेयं त्वां चक्षुषा दारुणेन\nसङ्क्रुद्ध इत्येतदवेहि शक्र\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2207163, "chapter_id": 5415, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2207164, "chapter_id": 5415, "verse_number": "२७", "content_sanskrit": "त्वमेवान्यान् दहसे जातवेदो\nन च त्वदन्यो विद्यते भस्मकर्ता ।\nत्वत्संस्पर्शात् सर्वलोको बिभेति\nन श्रद्धेयं भाषसे हव्यवाह\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2207165, "chapter_id": 5415, "verse_number": "", "content_sanskrit": "अग्निः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2207166, "chapter_id": 5415, "verse_number": "२८", "content_sanskrit": "दिवं देवेन्द्र पृथिवीं च सर्वां\nसंवेष्टयेस्त्वं स्वबलेनैव शक्र ।\nएवंविधस्येह स यस्तवासौ\nकथं वृत्रस्त्रिदिवं प्राग्जहार\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2207167, "chapter_id": 5415, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2207168, "chapter_id": 5415, "verse_number": "२९", "content_sanskrit": "नादण्डको दण्डयानोऽस्म्यलिङ्गान्\nन कारुसोमं प्रपिबामि वह्ने ।\nन कारुर्वै विसृजामि वज्रं\nको मेऽसुखाय प्रहरेन्मनुष्यः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2207169, "chapter_id": 5415, "verse_number": "३०", "content_sanskrit": "प्रव्राजयेयं कालकेयान् पृथिव्याम्\nअपाकर्षन् दानवानन्तरिक्षात् ।\nदिवः प्रह्लादं व्यथमानं नयेत\nको मेऽसुखाय प्रहरेताद्य मर्त्यः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2207170, "chapter_id": 5415, "verse_number": "", "content_sanskrit": "अग्निः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2207171, "chapter_id": 5415, "verse_number": "३१", "content_sanskrit": "यत्र शर्यातिं च्यवनो याजयिष्यन्\nसहाश्विभ्यां सोममेकोऽप्यगृह्णात् ।\nन त्वं क्रुद्धः प्रत्यषेधीः पुरस्तात्\nशर्यातियज्ञं स्मर तं महेन्द्र\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2207172, "chapter_id": 5415, "verse_number": "३२", "content_sanskrit": "वज्रं गृहीत्वा च पुरन्दर त्वं\nसम्प्रहार्षीश्च्यवनस्यातिघोरम् ।\nस ते विप्रः सह वज्रेण बाहुम्\nअपागृह्णात् तपसा जातमन्युः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2207173, "chapter_id": 5415, "verse_number": "३३", "content_sanskrit": "ततो रोषात् सर्वतो घोररूपं\nसंवर्तं ते जनयामास भूयः ।\nमदं नाम्ना चासुरं विश्वरूपं\nयं त्वं दृष्ट्वा चक्षुषी सन्न्यमील्यः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2207174, "chapter_id": 5415, "verse_number": "३४", "content_sanskrit": "हनुरेका जगतीस्था तथैका\nदिवं गता महतो दानवस्य ।\nसहस्रं दन्तानां शतयोजनानां\nसुतीक्ष्णानां घोररूपं बभूव\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2207175, "chapter_id": 5415, "verse_number": "३५", "content_sanskrit": "वृत्ताः स्थूला राजतस्तम्भवर्णा\nदंष्ट्राश्चतस्रो द्वे शते योजनानाम् ।\nस त्वां दन्तान् विदशन्नभ्यधावन्\nजिघांसया शूलमुद्यम्य घोरम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2207176, "chapter_id": 5415, "verse_number": "३६", "content_sanskrit": "तं नापश्यस्त्वं तदा घोररूपं\nसर्वे त्वदन्ये ददृशुर्दर्शनीयम् ।\nयस्माद् भीतः प्राञ्जलिस्त्वं महर्षिं\nगच्छेः शीघ्रं शरणं दानवघ्न\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2207177, "chapter_id": 5415, "verse_number": "३७", "content_sanskrit": "क्षात्रादेव ब्रह्मबलं गरीयो\nन ब्रह्मतः किञ्चिदन्यद् गरीयः ।\nसोऽहं जानन् ब्रह्मतेजो यथावत्\nन संवर्तं गन्तुमिच्छामि शक्र\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2207178, "chapter_id": 5415, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्याम् आश्वमेधिकपर्वणि अग्निशक्रसंवादो नाम नवमोऽध्यायः ॥९॥\nअश्वमेधपर्वणि नवमोऽध्यायः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}]