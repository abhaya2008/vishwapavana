[{"id": 7003670000, "chapter_id": 23670, "verse_number": "१-२-५७-१", "content_sanskrit": "नारद उवाच ।\nततो विप्रा नारदश्च समाराध्य महेश्वरम् ।\nमहीनगरके पुण्ये स्थापयामास शंकरम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003670001, "chapter_id": 23670, "verse_number": "१-२-५७-२", "content_sanskrit": "लोकानां च हितार्थाय केदारं लिंगमुत्तमम् ।\nअत्रीशादुत्तरे भागे महापातकनाशनम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003670002, "chapter_id": 23670, "verse_number": "१-२-५७-३", "content_sanskrit": "अत्रिकुण्डे नरः स्नात्वा श्राद्धं कृत्वा यथाविधि ।\nअत्रीशं च नमस्कृत्य केदारं यः प्रपश्यति ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003670003, "chapter_id": 23670, "verse_number": "१-२-५७-४", "content_sanskrit": "मातुः स्तन्यं पुनर्नैव स पिबेन्मुक्तिभाग्भवेत् ।\nततो रुद्रो नीलकंठं नारदाय महात्मने ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003670004, "chapter_id": 23670, "verse_number": "१-२-५७-५", "content_sanskrit": "स्वयं दत्त्वा स्वयं तस्थौ महीनगरके शुभे ।\nकोटितीर्थे नरः स्नात्वा नीलकंठं प्रपश्यति ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003670005, "chapter_id": 23670, "verse_number": "१-२-५७-६", "content_sanskrit": "जयादित्यं नमस्कृत्य रुद्रलोकमवाप्नुयात् ।\nजयादित्यं पूजयंति कूपे स्नात्वा नरोत्तमाः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003670006, "chapter_id": 23670, "verse_number": "१-२-५७-७", "content_sanskrit": "न तेषां वंशनाशोऽस्ति जयादित्यप्रसादतः ।\nइदं ते कथितं पार्थ महीनगरकस्य च ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003670007, "chapter_id": 23670, "verse_number": "१-२-५७-८", "content_sanskrit": "आख्यानं सकलं श्रुत्वा सर्वपापैः प्रमुच्यते ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003670008, "chapter_id": 23670, "verse_number": "१-२-५७-९", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां प्रथमे माहेश्वरखण्डे कौमारिकाखंडे नीलकंठमाहात्म्यवर्णनंनाम सप्तपञ्चाशत्तमोऽध्यायः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}]