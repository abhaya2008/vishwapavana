[{"id": 7001228000, "chapter_id": 21228, "verse_number": "२-५-१-१", "content_sanskrit": "ॐ ।\nनमस्समस्तसंसारचक्रभ्रमणहेतवे ।\nगौरीकुचतटद्वन्द्वकुंकुमांकितवक्षसे॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001228001, "chapter_id": 21228, "verse_number": "२-५-१-२", "content_sanskrit": "सूत उवाच ।\nउक्त्वा भगवतो लब्धप्रसादादुपमन्युना ।\nनियमादुत्थितो वायुर्मध्ये प्राप्ते दिवाकरे॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001228002, "chapter_id": 21228, "verse_number": "२-५-१-३", "content_sanskrit": "ऋषयश्चापि ते सर्वे नैमिषारण्यवासिनः ।\nअथायमर्थः प्रष्टव्य इति कृत्वा विनिश्चयम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001228003, "chapter_id": 21228, "verse_number": "२-५-१-४", "content_sanskrit": "कृत्वा यथा स्वकं कृत्यं प्रत्यहं ते यथा पुरा ।\nभगवंतमुपायांतं समीक्ष्य समुपाविशन्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001228004, "chapter_id": 21228, "verse_number": "२-५-१-५", "content_sanskrit": "अथासौ नियमस्यांते भगवानम्बरोद्भवः ।\nमध्ये मुनिसभायास्तु भेजे कॢप्तं वरासनम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001228005, "chapter_id": 21228, "verse_number": "२-५-१-६", "content_sanskrit": "सुखासनोपविष्टश्च वायुर्लोकनमस्कृतः ।\nश्रीमद्विभूतिमीशस्य हृदि कृत्वेदमब्रवीत्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001228006, "chapter_id": 21228, "verse_number": "२-५-१-७", "content_sanskrit": "तं प्रपद्ये महादेवं सर्वज्ञमपराजितम् ।\nविभूतिस्सकलं यस्य चराचरमिदं जगत्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001228007, "chapter_id": 21228, "verse_number": "२-५-१-८", "content_sanskrit": "इत्याकर्ण्य शुभां वाणीमृषयः क्षीणकल्मषाः ।\nविभूतिविस्तरं श्रोतुमूचुस्ते परमं वचः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001228008, "chapter_id": 21228, "verse_number": "२-५-१-९", "content_sanskrit": "ऋषय ऊचुः ।\nउक्तं भगवता वृत्तमुपमन्योर्महात्मनः ।\nक्षीरार्थेनापि तपसा यत्प्राप्तं परमेश्वरात्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001228009, "chapter_id": 21228, "verse_number": "२-५-१-१०", "content_sanskrit": "दृष्टो ऽसौ वासुदेवेन कृष्णेनाक्लिष्टकर्मणा ।\nधौम्याग्रजस्ततस्तेन कृत्वा पाशुपतं व्रतम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001228010, "chapter_id": 21228, "verse_number": "२-५-१-११", "content_sanskrit": "प्राप्तं च परमं ज्ञानमिति प्रागेव शुश्रुम ।\nकथं स लब्धवान् कृष्णो ज्ञानं पाशुपतं परम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001228011, "chapter_id": 21228, "verse_number": "२-५-१-१२", "content_sanskrit": "वायुरुवाच ।\nस्वेच्छया ह्यवतीर्णोपि वासुदेवस्सनातनः ।\nनिंदयन्निव मानुष्यं देहशुद्धिं चकार सः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001228012, "chapter_id": 21228, "verse_number": "२-५-१-१३", "content_sanskrit": "पुत्रार्थं हि तपस्तप्तुं गतस्तस्य महामुनेः ।\nआश्रमं मुनिभिर्दृष्टं दृष्टवांस्तत्र वै मुनिम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001228013, "chapter_id": 21228, "verse_number": "२-५-१-१४", "content_sanskrit": "भस्मावदातसर्वांगं त्रिपुंड्रांकितमस्तकम् ।\nरुद्राक्षमालाभरणं जटामंडलमंडितम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001228014, "chapter_id": 21228, "verse_number": "२-५-१-१५", "content_sanskrit": "तच्छिष्यभूतैर्मुनिभिश्शास्त्रैर्वेदमिवावृतम् ।\nशिवध्यानरतं शांतमुपमन्युं महाद्युतिम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001228015, "chapter_id": 21228, "verse_number": "२-५-१-१६", "content_sanskrit": "नमश्चकार तं दृष्ट्वा हृष्टसर्वतनूरुहः ।\nबहुमानेन कृष्णो ऽसौ त्रिः कृत्वा तु प्रदक्षिणाम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001228016, "chapter_id": 21228, "verse_number": "२-५-१-१७", "content_sanskrit": "स्तुतिं चकार सुप्रीत्या नतस्कंधः कृताञ्जलिः ।\nतस्यावलोकनादेव मुनेः कृष्णस्य धीमतः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001228017, "chapter_id": 21228, "verse_number": "२-५-१-१८", "content_sanskrit": "नष्टमासीन्मलं सर्वं मायाजं कार्ममेव च ।\nतपःक्षीणमलं कृष्णमुपमन्युर्यथाविधिः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001228018, "chapter_id": 21228, "verse_number": "२-५-१-१९", "content_sanskrit": "भस्मनोद्धूल्य तं मन्त्रैरग्निरित्यादिभिः क्रमात् ।\nअथ पाशुपतं साक्षाद्व्रतं द्वादशमासिकम्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001228019, "chapter_id": 21228, "verse_number": "२-५-१-२०", "content_sanskrit": "कारयित्वा मुनिस्तस्मै प्रददौ ज्ञानमुत्तमम् ।\nतदाप्रभृति तं कृष्णं मुनयश्शंसितव्रताः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001228020, "chapter_id": 21228, "verse_number": "२-५-१-२१", "content_sanskrit": "दिव्याः पाशुपताः सर्वे परिवृत्योपतस्थिरे ।\nततो गुरुनियोगाद्वै कृष्णः परमशक्तिमान्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001228021, "chapter_id": 21228, "verse_number": "२-५-१-२२", "content_sanskrit": "तपश्चकार पुत्रार्थं सांबमुद्दिश्य शंकरम् ।\nतपसो तेन वर्षांते दृष्टो ऽसौ परमेश्वरः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001228022, "chapter_id": 21228, "verse_number": "२-५-१-२३", "content_sanskrit": "श्रिया परमया युक्तस्सांबश्च सगणश्शिवः ।\nवरार्थमाविर्भूतस्य हरस्य सुभगाकृतेः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001228023, "chapter_id": 21228, "verse_number": "२-५-१-२४", "content_sanskrit": "स्तुतिं चकार नत्वासौ कृष्णः सम्यक्कृतांजलिः ।\nसांबं समगणव्यग्रो लब्धवान्पुत्रमात्मनः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001228024, "chapter_id": 21228, "verse_number": "२-५-१-२५", "content_sanskrit": "तपसा तुष्टचित्तेन दत्तं विष्णोश्शिवेन वै ।\nयस्मात्सांबो महादेवः प्रददौ पुत्रमात्मनः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001228025, "chapter_id": 21228, "verse_number": "२-५-१-२६", "content_sanskrit": "तस्माज्जांबवतीसूनुं सांबं चक्रे स नामतः ।\nतदेतत्कथितं सर्वं कृष्णस्यामितकर्मणः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001228026, "chapter_id": 21228, "verse_number": "२-५-१-२७", "content_sanskrit": "महर्षेर्ज्ञानलाभश्च पुत्रलाभश्च शंकरात् ।\nय इदं कीर्तयेन्नित्यं शृणुयाच्छ्रावयेत्तथा॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001228027, "chapter_id": 21228, "verse_number": "२-५-१-२८", "content_sanskrit": "स विष्णोर्ज्ञानमासाद्य तेनैव सह मोदते॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]