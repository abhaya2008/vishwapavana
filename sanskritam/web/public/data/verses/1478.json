[{"id": 2022610, "chapter_id": 1478, "verse_number": "३-११६-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2022611, "chapter_id": 1478, "verse_number": "३-११६-१", "content_sanskrit": "स तत्र तामुषित्वैकां रजनीं पृथिवीपतिः।\nतापसानां परं चक्रे सत्कारं भ्रातृभिः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2022612, "chapter_id": 1478, "verse_number": "३-११६-२", "content_sanskrit": "लोमशस्तस्य तान्सर्वानाचख्यौ तत्र तापसान्।\nभृगूनङ्गिरसश्चैव वसिष्ठानथ काश्यपान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2022613, "chapter_id": 1478, "verse_number": "३-११६-३", "content_sanskrit": "तान्समेत्य सा राजर्षिरभिवाद्य कृताञ्जलिः।\nरामस्यानुचरं वीरमपृच्छदकृतव्रणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2022614, "chapter_id": 1478, "verse_number": "३-११६-४", "content_sanskrit": "कदा नु रामो भगवांस्तापसो दर्शयिष्यति।\nतमहं तपसा युक्तं द्रष्टुमिच्छामि भार्गवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2022615, "chapter_id": 1478, "verse_number": "३-११६-५x", "content_sanskrit": "अकृतव्रण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2022616, "chapter_id": 1478, "verse_number": "३-११६-५", "content_sanskrit": "आयानेवासि विदितो रामस्य विदितात्मनः।\nप्रीतिस्त्वयि च रामस्य क्षिप्रं त्वां दर्शयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2022617, "chapter_id": 1478, "verse_number": "३-११६-६", "content_sanskrit": "चतुर्दशीमष्टमीं च रामं पश्यन्ति तापसाः।\nअस्यां रात्र्यां व्यतीतायां भवित्री श्वश्चतुर्दशी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2022618, "chapter_id": 1478, "verse_number": "३-११६-७", "content_sanskrit": "`ततो द्रक्ष्यसि रामं त्वं कृष्णाजिनजटाधरम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2022619, "chapter_id": 1478, "verse_number": "३-११६-७x", "content_sanskrit": "युधिष्ठिर उवाच।\nभवाननुगतो रामं जामदग्न्यं महाबलम्।\nप्रत्यक्षदर्शी सर्वस्य पूर्ववृत्तस्य कर्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2022620, "chapter_id": 1478, "verse_number": "३-११६-८", "content_sanskrit": "स भवान्कथयत्वद्य यथा रामेण निर्जिताः।\nआहवे क्षत्रियाः सर्वे कथं केन च हेतुना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2022621, "chapter_id": 1478, "verse_number": "३-११६-९x", "content_sanskrit": "अकृतव्रण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2022622, "chapter_id": 1478, "verse_number": "३-११६-९", "content_sanskrit": "[हन्त ते कथयिष्यामि महदाख्यानमुत्तमम्।\nभृगूणां राजशार्दूल वंशे जातस्य भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2022623, "chapter_id": 1478, "verse_number": "३-११६-१०", "content_sanskrit": "रामस्य जामदग्न्यस्य चरितं देवसंमितम्।\nहैहयाधिपतेश्चैव कार्तवीर्यस् भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2022624, "chapter_id": 1478, "verse_number": "३-११६-११", "content_sanskrit": "रामेण चार्जुनो नाम हैहयाधिपतिर्हतिः।\nतस्य बाहुशतान्यासंस्त्रीणि सप्त च पाण्डव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2022625, "chapter_id": 1478, "verse_number": "३-११६-१२", "content_sanskrit": "दत्तात्रेयप्रसादेन विमानं काञ्चनं तथा।\nऐश्वर्यं सर्वभूतेषु पृथिव्यां पृथिवीपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2022626, "chapter_id": 1478, "verse_number": "३-११६-१३", "content_sanskrit": "अव्घाहतगतिश्चैव रथस्तस्य महात्मनः।\nरथेन तेन तु सदावरदानेन वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2022627, "chapter_id": 1478, "verse_number": "३-११६-१४", "content_sanskrit": "ममर्द देवान्यक्षांश्च ऋषींश्चैव समन्ततः।\nभूतांश्चैव स सर्वांस्तु पीडयामास सर्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2022628, "chapter_id": 1478, "verse_number": "३-११६-१५", "content_sanskrit": "ततो देवाः समेत्याहुर्ऋषयश्च महाव्रताः।\nदेवदेवं सुरारिघ्नं विष्णुं सत्यपराक्रमम्।\nभगवन्भूतरार्थमर्जुनं जहि वै प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2022629, "chapter_id": 1478, "verse_number": "३-११६-१६", "content_sanskrit": "विमानेन च दिव्येन हैहयाधिपतिः प्रभुः।\nशचीसहायं क्रीडन्तं धर्षयामास वासवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2022630, "chapter_id": 1478, "verse_number": "३-११६-१७", "content_sanskrit": "ततस्तु भगवान्देवः शक्रेण सहितस्तदा।\nकार्तवीर्यविनाशार्थं मन्त्रयामास भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2022631, "chapter_id": 1478, "verse_number": "३-११६-१८", "content_sanskrit": "यत्तद्भूतहितं कार्यं सुरेन्द्रेण निवेदितम्।\nसंप्रतिश्रुत्य तत्सर्वं भगवाँल्लोकपूजितः।\nजगाम बदरीं रम्यां स्वमेवाश्रममण्डलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2022632, "chapter_id": 1478, "verse_number": "३-११६-१९", "content_sanskrit": "एतस्मिन्नेव काले तु पृथिव्यां पृथिवीपतिः।]\nकान्यकुब्जे महानासीत्पार्थिवः सुमहाबलः।\nगाधीति विश्रुतो लोके वनवासं जगाम ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2022633, "chapter_id": 1478, "verse_number": "३-११६-२०", "content_sanskrit": "वने तु तस्य वसतः कन्या जज्ञेऽप्सरःसमा।\nऋचीको भार्गवस्तां च वरयामास भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2022634, "chapter_id": 1478, "verse_number": "३-११६-२१", "content_sanskrit": "तमुवाच ततो गाधिर्ब्राह्मणं संशितव्रतम्।\nउचितं नः कुले किंचित्पूर्वैर्यत्संप्रवर्तितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2022635, "chapter_id": 1478, "verse_number": "३-११६-२२", "content_sanskrit": "एकतः श्यामकर्णानां पाण्डुराणां तरस्विनाम्।\nसहस्रं वाजिनां शुक्लमिति विद्धि द्विजोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2022636, "chapter_id": 1478, "verse_number": "३-११६-२३", "content_sanskrit": "न चापि भगवान्वाच्योदीयतामिति भार्गव।\nदेया मे दुहिता चैव त्वद्विधाय महात्मने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2022637, "chapter_id": 1478, "verse_number": "३-११६-२४x", "content_sanskrit": "ऋचीक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2022638, "chapter_id": 1478, "verse_number": "३-११६-२४", "content_sanskrit": "एकतः श्यामकर्णानां पाण्डुराणां तरस्विनाम्।\nदास्याम्यश्वसहस्रं ते मम भार्या सुताऽस्तु ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2022639, "chapter_id": 1478, "verse_number": "३-११६-२५x", "content_sanskrit": "`गाधिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2022640, "chapter_id": 1478, "verse_number": "३-११६-२५", "content_sanskrit": "ददास्यश्वसहस्रं मे तव भार्या सुताऽस्तु मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2022641, "chapter_id": 1478, "verse_number": "३-११६-२६x", "content_sanskrit": "अकृतव्रण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2022642, "chapter_id": 1478, "verse_number": "३-११६-२६", "content_sanskrit": "स तथेति प्रतिज्ञाय राजन्वरुणमब्रवीत्।\nएकतः श्यामकर्णानां पाण्डुराणां तरस्विनाम्।\nसहस्रं वाजिनामेकं शुल्कार्थं प्रतिदीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2022643, "chapter_id": 1478, "verse_number": "३-११६-२७", "content_sanskrit": "तस्मै प्रादात्सहस्रं वै वाजिनां वरुणस्तदा।\nतदश्वतीर्थं विख्यातमुत्थिता यत्र ते हयाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2022644, "chapter_id": 1478, "verse_number": "३-११६-२८", "content_sanskrit": "गङ्गायां कान्यकुब्जे वै ददौ सत्यवतीं तदा।\nततो गाधिः सुतां चास्मै जन्याश्चासन्सुरास्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2022645, "chapter_id": 1478, "verse_number": "३-११६-२९", "content_sanskrit": "लब्धं हयसहस्रं तु तां च दृष्ट्वा दिवौकसः।\n`विस्मयं परमं जग्मुस्तमेव दिवि संस्तुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2022646, "chapter_id": 1478, "verse_number": "३-११६-३०", "content_sanskrit": "धर्मेण लब्ध्वा तां भार्यामृचीको द्विजसत्तमः।\nयथाकामं यथाजोषं तया रेमे सुमध्यया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2022647, "chapter_id": 1478, "verse_number": "३-११६-३१", "content_sanskrit": "तं विवाहे कृतेराजन्सभार्यमवलोककः।\nआजगाम भृगुश्रेष्ठः पुत्रं दृष्ट्वा ननन्द च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2022648, "chapter_id": 1478, "verse_number": "३-११६-३२", "content_sanskrit": "भार्यापती तमासीनं भृगुं सुरगणार्चितम्।\nअर्चित्वा पर्युपासीनौ प्राञ्जली तस्थतुस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2022649, "chapter_id": 1478, "verse_number": "३-११६-३३", "content_sanskrit": "ततः स्नुषां स भगवान्प्रहृष्टो भृगुरब्रवीत्।\nवरं वृणीष्व सुभगे दाता ह्यस्मि तवेप्सितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2022650, "chapter_id": 1478, "verse_number": "३-११६-३४", "content_sanskrit": "सा वै प्रसादयाभास तं गुरुं पुत्रकारणात्।\nआत्मनश्चैव मातुश्च प्रसादं च चकार सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2022651, "chapter_id": 1478, "verse_number": "३-११६-३५x", "content_sanskrit": "भृगुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2022652, "chapter_id": 1478, "verse_number": "३-११६-३५", "content_sanskrit": "ऋतौ त्वं चैव माता च स्नाते पुंसवनाय वै।\nआलिङ्गेतां पृथग्वृक्षौ साऽस्वत्थं त्वमुदुम्बरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2022653, "chapter_id": 1478, "verse_number": "३-११६-३६", "content_sanskrit": "चरुद्वयमिदं भद्रे जनन्याश्च तवैव च।\nविश्वमावर्तयित्वा तु मया यत्नेन साधितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2022654, "chapter_id": 1478, "verse_number": "३-११६-३७", "content_sanskrit": "प्राशितव्यं प्रयत्नेन तेत्युक्त्वाऽदर्शनं गतः।\nआलिङ्गने चरौ चैव चक्रतुस्ते विपर्ययम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2022655, "chapter_id": 1478, "verse_number": "३-११६-३८", "content_sanskrit": "ततः पुन स भगवान्काले बहुतिथे गते।\nदिव्यज्ञानाद्विदित्वा तु भगवानागतः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2022656, "chapter_id": 1478, "verse_number": "३-११६-३९", "content_sanskrit": "अथोवाच महातेजा भृगुः सत्यवतीं श्नुषाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2022657, "chapter_id": 1478, "verse_number": "३-११६-४०", "content_sanskrit": "उपयुक्तश्चरुर्भद्रे वृक्षे चालिङ्गनं कृतम्।\nविपरीतेन ते सुभ्रूर्मात्रा चैवासि वञ्चिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2022658, "chapter_id": 1478, "verse_number": "३-११६-४१", "content_sanskrit": "क्षत्रियो ब्राह्मणाचारो मातुस्तव सुतो महान्।\nभविष्यति महावीर्यः साधूनां मार्गमास्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2022659, "chapter_id": 1478, "verse_number": "३-११६-४२", "content_sanskrit": "ततः प्रसादयामास श्वशुरं सा पुनःपुनः।\nन मे पुत्रो भवेदीदृक्कामं पौत्रो भवेदिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2022660, "chapter_id": 1478, "verse_number": "३-११६-४३", "content_sanskrit": "एवमस्त्विति सा तेन पाण्डव प्रतिनन्दिता।\nक्रालं प्रतीक्षती गर्भं धारयामास यत्नतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2022661, "chapter_id": 1478, "verse_number": "३-११६-४४", "content_sanskrit": "जमदग्निं ततः पुत्रं जज्ञे सा काल आगते।\nतेजसा वर्चसा चैव युक्तं भार्गवनन्दनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2022662, "chapter_id": 1478, "verse_number": "३-११६-४५", "content_sanskrit": "स वर्धमानस्तेजस्वी वेदस्याध्ययनेन च।\nबहूनृषीन्महातेजाः पाण्डवेयात्यवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2022663, "chapter_id": 1478, "verse_number": "३-११६-४६", "content_sanskrit": "तं तु कृत्स्नो धनुर्वेदः प्रत्यभाद्भरतर्षभ।\nचतुर्विधानि चास्त्राणि भास्करोपमवर्चसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2022664, "chapter_id": 1478, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्थयात्रापर्वणि षोडशाधिकशततमोऽध्यायः ॥ ११६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}]