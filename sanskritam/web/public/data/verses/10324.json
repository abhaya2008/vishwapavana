[{"id": 6000324000, "chapter_id": 10324, "verse_number": null, "content_sanskrit": "अध्यायः २३", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000324001, "chapter_id": 10324, "verse_number": null, "content_sanskrit": "अथ त्रयोविंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.001.m4a", "display_order": 2}, {"id": 6000324002, "chapter_id": 10324, "verse_number": null, "content_sanskrit": "श्री शुक उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.002.m4a", "display_order": 3}, {"id": 6000324003, "chapter_id": 10324, "verse_number": "११-२३-१", "content_sanskrit": "स एवमाशंसित उद्धवेन भागवतमुख्येन दशार्हवर्यः।\nसभाजयन् भृत्यवचो मुकुन्दस्तमावभाषे श्रवणीयवीर्यः॥ ११/२३/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.003.m4a", "display_order": 4, "topics": [{"text": "आवन्त्यद्विजस्य कथा", "range": "१–६"}]}, {"id": 6000324004, "chapter_id": 10324, "verse_number": "११-२३-२", "content_sanskrit": "बाह्यान्तर्भजनो ह्यत्र साधुर्वै दुर्जनेरितैः।\nदुरुक्तैर्भिन्नमात्मानं यः समाधातुमीश्वरः॥ ११/२३/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.004.m4a", "display_order": 5}, {"id": 6000324005, "chapter_id": 10324, "verse_number": "११-२३-३", "content_sanskrit": "न तथा तप्यते विद्धः पुमान् बाणैर्हि मर्मगैः।\nयथा तुदन्ति मर्मस्था असतां परुषेषवः॥ ११/२३/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.005.m4a", "display_order": 6}, {"id": 6000324006, "chapter_id": 10324, "verse_number": "११-२३-४", "content_sanskrit": "कथयन्ति महापुण्यमितिहासमिहोद्धव।\nतमहं वर्णयिष्यामि निबोध सुसमाहितः॥ ११/२३/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.006.m4a", "display_order": 7}, {"id": 6000324007, "chapter_id": 10324, "verse_number": "११-२३-५", "content_sanskrit": "केनचिद् भिक्षुणा गीतं परिभूतेन दुर्जनैः।\nस्मरता धृतियुक्तेन विपाकं निजकर्मणः॥ ११/२३/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.007.m4a", "display_order": 8}, {"id": 6000324008, "chapter_id": 10324, "verse_number": "११-२३-६", "content_sanskrit": "अवन्तीषु द्विजः कश्चिदासीदाढ्यतमः श्रिया।\nवार्तावृत्तिः कदर्यस्तु कामी लुब्धोऽतिकोपनः॥ ११/२३/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.008.m4a", "display_order": 9}, {"id": 6000324009, "chapter_id": 10324, "verse_number": "११-२३-७", "content_sanskrit": "ज्ञातयोऽतिथयस्तस्य वाङ्मात्रेणाप्यनर्चिताः।\nशून्यावसथ आत्माऽपि काले कामैरनर्चितः॥ ११/२३/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.009.m4a", "display_order": 10, "topics": [{"text": "बहुधनार्जनम्", "range": "६–८"}]}, {"id": 6000324010, "chapter_id": 10324, "verse_number": "११-२३-८", "content_sanskrit": "दुःशीलस्य कदर्यस्य द्रुह्यतः पुत्रबान्धवान्।\nदारा दुहितरो भृत्या विषण्णा नाचरन् प्रियम्॥ ११/२३/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.010.m4a", "display_order": 11}, {"id": 6000324011, "chapter_id": 10324, "verse_number": "११-२३-९", "content_sanskrit": "तस्यैवं यक्षवित्तस्य च्युतस्योभयलोकतः।\nधर्मकामविहीनस्य चुक्रुधुः पञ्चभागिनः॥ ११/२३/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.011.m4a", "display_order": 12, "topics": [{"text": "वार्धक्ये पुत्रादिभिः तस्य परित्यागः", "range": "८–११"}]}, {"id": 6000324012, "chapter_id": 10324, "verse_number": "११-२३-१०", "content_sanskrit": "तदवध्यानविस्रस्तपुण्यस्कन्धस्य भूरिद।\nअर्थोऽप्यगच्छन्निधनं बह्वायासपरिष्कृतः॥ ११/२३/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.012.m4a", "display_order": 13}, {"id": 6000324013, "chapter_id": 10324, "verse_number": "११-२३-११", "content_sanskrit": "ज्ञातयो जगृहुः किञ्चित् किञ्चिद् दस्यव उद्धव।\nदैवतः कालतः किञ्चिद् ब्रह्मबन्धोर्नृपार्थिवात्॥ ११/२३/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.013.m4a", "display_order": 14}, {"id": 6000324014, "chapter_id": 10324, "verse_number": "११-२३-१२", "content_sanskrit": "स एवं द्रविणे नष्टे धर्मकामविवर्जितः।\nउपेक्षितश्च स्वजनैश्चिन्तामाप दुरत्ययाम्॥ ११/२३/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.014.m4a", "display_order": 15, "topics": [{"text": "तस्य भिक्षावृत्तिः", "range": "१२–४२"}]}, {"id": 6000324015, "chapter_id": 10324, "verse_number": "११-२३-१३", "content_sanskrit": "तस्यैवं ध्यायतो दीर्घमगादायुस्तपस्विनः।\nखिद्यतो बाष्पकण्ठस्य निर्वेदः सुमहानभूत्॥ ११/२३/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.015.m4a", "display_order": 16}, {"id": 6000324016, "chapter_id": 10324, "verse_number": "११-२३-१४", "content_sanskrit": "स चाहेदमहो कष्टं वृथाऽऽत्मा मे सुतापितः।\nन धर्माय न कामाय यस्यार्थायास ईदृशः॥ ११/२३/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.016.m4a", "display_order": 17}, {"id": 6000324017, "chapter_id": 10324, "verse_number": "११-२३-१५", "content_sanskrit": "प्रायेणार्थः कदर्याणां न सुखाय कदाचन।\nइह चात्मोपतापाय मृतस्य नरकाय च॥ ११/२३/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.017.m4a", "display_order": 18}, {"id": 6000324018, "chapter_id": 10324, "verse_number": "११-२३-१६", "content_sanskrit": "यशो यशस्विनां शुद्धं श्लाघ्या ये गुणिनां गुणाः।\nलोभः स्वल्पोऽपि तान् हन्ति श्वित्रो रूपमिवेप्सितम्॥ ११/२३/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.018.m4a", "display_order": 19}, {"id": 6000324019, "chapter_id": 10324, "verse_number": "११-२३-१७", "content_sanskrit": "अर्थस्य साधने सिद्ध उत्कर्षे रक्षणे व्यये।\nनाशोपभोग आयासस्त्रासश्चिन्ते भ्रमो नृणाम्॥ ११/२३/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.019.m4a", "display_order": 20}, {"id": 6000324020, "chapter_id": 10324, "verse_number": "११-२३-१८", "content_sanskrit": "स्तेयं हिंसाऽनृतं दम्भः कामः क्रोधः स्मयो मदः।\nभेदो वैरमविश्वासः संस्पर्धा व्यसनानि च॥ ११/२३/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.020.m4a", "display_order": 21}, {"id": 6000324021, "chapter_id": 10324, "verse_number": "११-२३-१९", "content_sanskrit": "एते पञ्चदशानर्था ह्यर्थमूला मता नृणाम्।\nतस्मादनर्थमर्थाख्यं श्रेयोऽर्थी दूरतस्त्यजेत्॥ ११/२३/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.021.m4a", "display_order": 22}, {"id": 6000324022, "chapter_id": 10324, "verse_number": "११-२३-२०", "content_sanskrit": "भिद्यन्ते भ्रातरो दाराः पितरः सुहृदस्तथा।\nएकयाऽर्थेच्छया सद्यः सर्वे चाप्यरयः कृताः॥ ११/२३/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.022.m4a", "display_order": 23}, {"id": 6000324023, "chapter_id": 10324, "verse_number": "११-२३-२१", "content_sanskrit": "अर्थेनाल्पीयसा ह्येते संरब्धा दीप्तमन्यवः।\nत्यजन्त्यसून् वृथा घ्नन्ति सहसोत्सृज्य सौहृदम्॥ ११/२३/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.023.m4a", "display_order": 24}, {"id": 6000324024, "chapter_id": 10324, "verse_number": "११-२३-२२", "content_sanskrit": "लब्ध्वा जन्मान्तरैः प्रार्थ्यं मानुष्यं तद् द्विजाग्य्रताम्।\nतदनादृत्य ये सर्वं घ्नन्ति यान्त्यशुभां गतिम्॥ ११/२३/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.024.m4a", "display_order": 25}, {"id": 6000324025, "chapter_id": 10324, "verse_number": "११-२३-२३", "content_sanskrit": "स्वर्गापवर्गयोर्द्वारं प्राप्य लोकमिमं पुमान्।\nद्रविणे कोऽनुषज्जेत मर्त्योऽनर्थस्य धामनि॥ ११/२३/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.025.m4a", "display_order": 26}, {"id": 6000324026, "chapter_id": 10324, "verse_number": "११-२३-२४", "content_sanskrit": "देवर्षिपितृभूतानि ज्ञातीनन्यांश्च भागिनः।\nअसंविभज्य चात्मानं यक्षवित्तः पतत्यधः॥ ११/२३/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.026.m4a", "display_order": 27}, {"id": 6000324027, "chapter_id": 10324, "verse_number": "११-२३-२५", "content_sanskrit": "व्यर्थयाऽर्थेहया वित्तं प्रमत्तस्य वयो बलम्।\nकुशलाय न सिध्यन्ति जरठः किन्नु साधयेत्॥ ११/२३/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.027.m4a", "display_order": 28}, {"id": 6000324028, "chapter_id": 10324, "verse_number": "११-२३-२६", "content_sanskrit": "तस्मात् संक्लिश्यतेऽविद्वान् व्यर्थयाऽर्थेहयाऽसकृत्।\nकस्यचिन्मायया नूनं लोकोऽयं सुविमोहितः॥ ११/२३/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.028.m4a", "display_order": 29}, {"id": 6000324029, "chapter_id": 10324, "verse_number": "११-२३-२७", "content_sanskrit": "किं धनैर्धनदैर्वा किं कामैर्वा कामदैरुत।\nमृत्युना ग्रस्यमानस्य कर्मभिर्वोत जन्मदैः॥ ११/२३/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.029.m4a", "display_order": 30}, {"id": 6000324030, "chapter_id": 10324, "verse_number": "११-२३-२८", "content_sanskrit": "नूनं मे भगवांस्तुष्टः सर्वदेवमयो हरिः।\nयेन नीतो दशामेतां निर्वेदश्चात्मनः प्लवः॥ ११/२३/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.030.m4a", "display_order": 31}, {"id": 6000324031, "chapter_id": 10324, "verse_number": "११-२३-२९", "content_sanskrit": "सोऽहं कालावशेषेण शोषयिष्येऽङ्गमात्मनः।\nअप्रमत्तोऽखिलार्थेषु यदि स्यां सिद्ध आत्मनि॥ ११/२३/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.031.m4a", "display_order": 32}, {"id": 6000324032, "chapter_id": 10324, "verse_number": "११-२३-३०", "content_sanskrit": "तत्र मामनुमोदेरन् देवास्त्रिभुवनेश्वराः।\nमुहूर्तेन ब्रह्मलोकं खट्वाङ्गः समसाधयत्॥ ११/२३/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.032.m4a", "display_order": 33}, {"id": 6000324033, "chapter_id": 10324, "verse_number": "११-२३-३१", "content_sanskrit": "इत्यभिप्रेत्य मनसा ह्यावन्त्यो द्विजसत्तमः।\nउन्मुच्य हृदयग्रन्थिं शान्तो भिक्षुरभून्मुनिः॥ ११/२३/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.033.m4a", "display_order": 34}, {"id": 6000324034, "chapter_id": 10324, "verse_number": "११-२३-३२", "content_sanskrit": "स चचार महीमेतां संयतात्मेन्द्रियानलः।\nभिक्षार्थं नगरग्रामानसङ्गोऽलक्षितोऽविशत्॥ ११/२३/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.034.m4a", "display_order": 35}, {"id": 6000324035, "chapter_id": 10324, "verse_number": "११-२३-३३", "content_sanskrit": "तं वै प्रवयसं भिक्षुमवधूतमसज्जनाः।\nदृप्ताः पर्यभवन् भद्र बह्वीभिः परिभूतिभिः॥ ११/२३/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.035.m4a", "display_order": 36}, {"id": 6000324036, "chapter_id": 10324, "verse_number": "११-२३-३४", "content_sanskrit": "केचित् त्रिवेणुं जगृहुरेके पात्रं कमण्डलुम्।\nपीठं चैकेऽक्षसूत्रं च कन्थां चीराणि केचन॥ ११/२३/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.036.m4a", "display_order": 37}, {"id": 6000324037, "chapter_id": 10324, "verse_number": "११-२३-३५", "content_sanskrit": "प्रदाय च पुनस्तानि दर्शितान्याददुर्मुनेः।\nअन्नं च भैक्षसम्पन्नं भुञ्जानस्य सरित्तटे॥ ११/२३/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.037.m4a", "display_order": 38}, {"id": 6000324038, "chapter_id": 10324, "verse_number": "११-२३-३६", "content_sanskrit": "मूत्रयन्ति च पापिष्ठा निष्ठीवन्त्यस्य मूर्धनि।\nयतवाचं वाचयन्ति ताडयन्ति न वक्ति चेत्॥ ११/२३/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.038.m4a", "display_order": 39}, {"id": 6000324039, "chapter_id": 10324, "verse_number": "११-२३-३७", "content_sanskrit": "तर्जयन्त्यपरे वाग्भिः स्तेनोऽयमिति वादिनः।\nबध्नन्ति रज्ज्वा तं केचिद् बध्यतां वध्यतामिति॥ ११/२३/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.039.m4a", "display_order": 40}, {"id": 6000324040, "chapter_id": 10324, "verse_number": "११-२३-३८", "content_sanskrit": "क्षिपन्त्येकेऽवजानन्त एष धर्मध्वजः शठः।\nक्षीणवृत्त इमां वृत्तिमगृहीत् स्वजनोज्झितः॥ ११/२३/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.040.m4a", "display_order": 41}, {"id": 6000324041, "chapter_id": 10324, "verse_number": "११-२३-३९", "content_sanskrit": "अहो एष महासारो धृतिमान् गिरिराडिव।\nमौनेन साधयत्यर्थं बकवद् दृढनिश्चयः॥ ११/२३/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.041.m4a", "display_order": 42}, {"id": 6000324042, "chapter_id": 10324, "verse_number": "११-२३-४०", "content_sanskrit": "इत्येके विहसन्त्येनमेके दौर्वादयन्ति च।\nतं बबन्धुर्निरुरुधुर्यथा क्रीडनकं द्विजम्॥ ११/२३/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.042.m4a", "display_order": 43}, {"id": 6000324043, "chapter_id": 10324, "verse_number": "११-२३-४१", "content_sanskrit": "एवं स भौतिकं दुःखं दैविकं दैहिकं च यत्।\nभोक्तव्यमात्मनो दिष्टं प्राप्तं प्राप्तमबुध्यत॥ ११/२३/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.043.m4a", "display_order": 44}, {"id": 6000324044, "chapter_id": 10324, "verse_number": "११-२३-४२", "content_sanskrit": "परिभूत इमां गाथामगायत नराधमैः।\nपातयद्भिः स्वधर्मस्थो धृतिमास्थाय सात्विकीम्॥ ११/२३/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.044.m4a", "display_order": 45}, {"id": 6000324045, "chapter_id": 10324, "verse_number": null, "content_sanskrit": "भिक्षुरुवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.045.m4a", "display_order": 46}, {"id": 6000324046, "chapter_id": 10324, "verse_number": "११-२३-४३", "content_sanskrit": "नायं जनो मे सुखदुःखहेतुर्न देवतात्मा ग्रहकर्मकालाः।\nमनः परं कारणमामनन्ति संसारचक्रं परिवर्तयेद् यत्॥ ११/२३/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.046.m4a", "display_order": 47, "topics": [{"text": "भिक्षुगीता", "range": "४३–६१"}]}, {"id": 6000324047, "chapter_id": 10324, "verse_number": "११-२३-४४", "content_sanskrit": "मनो गुणान् वै सृजते बलीयस्ततश्च कर्माणि विलक्षणानि।\nशुक्लानि कृष्णान्यथ लोहितानि तेभ्यः सवर्णा गतयो भवन्ति॥ ११/२३/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.047.m4a", "display_order": 48}, {"id": 6000324048, "chapter_id": 10324, "verse_number": "११-२३-४५", "content_sanskrit": "अनीह आत्मा मनसः समीहितं हिरण्मयो मत्सख उद्विचष्टे।\nमनः स्वलिङ्गं परिगृह्य कामान् जुषन् निबद्धो गुणसङ्गतोऽसौ॥ ११/२३/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.048.m4a", "display_order": 49}, {"id": 6000324049, "chapter_id": 10324, "verse_number": "११-२३-४६", "content_sanskrit": "दानं स्वधर्मो नियमो यमश्च श्रुतानि कर्माणि च सद्व्रतानि।\nसर्वे मनोनिग्रहलक्षणान्ताः परो हि योगो मनसः समाधिः॥ ११/२३/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.049.m4a", "display_order": 50}, {"id": 6000324050, "chapter_id": 10324, "verse_number": "११-२३-४७", "content_sanskrit": "समाहितं यस्य मनः प्रशान्तं दानादिभिः किं वद तस्य कृत्यम्।\nअसंयतं यस्य मनो विनश्येद् दानादिभिश्चेदपरं किमेभिः॥ ११/२३/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.050.m4a", "display_order": 51}, {"id": 6000324051, "chapter_id": 10324, "verse_number": "११-२३-४८", "content_sanskrit": "मनोवशेऽन्ये हि भवन्ति देवा मनश्च नान्यस्य वशं समेति।\nभीमो हि देवः सहसः सहीयान्नात्याविशत् तत् स हि देवदेवः॥ ११/२३/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.051.m4a", "display_order": 52}, {"id": 6000324052, "chapter_id": 10324, "verse_number": "११-२३-४९", "content_sanskrit": "तं दुर्जयं शत्रुमसह्यवेगमरुन्तुदं तन्न विजित्य केचित्।\nकुर्वन्त्यसद्विग्रहमत्र मर्त्यैर्मित्रैरुदासीनरिपुं विमूढाः॥ ११/२३/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.052.m4a", "display_order": 53}, {"id": 6000324053, "chapter_id": 10324, "verse_number": "११-२३-५०", "content_sanskrit": "देहं मनोमात्रमिदं गृहीत्वा ममाहमित्यन्धधियो मनुष्याः।\nएषोऽहमन्योऽयमिति भ्रमेण दुरन्तपारे तमसि भ्रमन्ति॥ ११/२३/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.053.m4a", "display_order": 54}, {"id": 6000324054, "chapter_id": 10324, "verse_number": "११-२३-५१", "content_sanskrit": "जनोऽस्य हेतुः सुखदुःखयोश्चेत् किमात्मनश्चात्र हि भौमयोस्तत्।\nजिह्वां क्‍वचित् सन्दशति स्वदद्भिस्तद्वेदनायां कतमाय कुप्येत्॥ ११/२३/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.054.m4a", "display_order": 55}, {"id": 6000324055, "chapter_id": 10324, "verse_number": "११-२३-५२", "content_sanskrit": "दुःखस्य हेतुर्यदि देवताऽस्तु किमात्मनस्तत्र विकारयोस्तत्।\nयदङ्गमङ्गेन विहन्यते क्‍वचित् क्रुध्येत कस्मै पुरुषः स्वदेहे॥ ११/२३/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.055.m4a", "display_order": 56}, {"id": 6000324056, "chapter_id": 10324, "verse_number": "११-२३-५३", "content_sanskrit": "आत्मा यदि स्यात् सुखदुःखहेतुः किमन्यतस्तत्र निजः स्वभावः।\nन ह्यात्मनोऽन्यद् यदि तन्मृषा स्याद् क्रुध्येत कस्मै न सुखं न दुःखम्॥ ११/२३/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.056.m4a", "display_order": 57}, {"id": 6000324057, "chapter_id": 10324, "verse_number": "११-२३-५४", "content_sanskrit": "ग्रहा निमित्तं सुखदुःखयोश्चेत् किमात्मनोऽजस्य जनस्य ते वै।\nग्रहैर्ग्रहस्यैव भवन्ति पीडाः क्रुध्येत कस्मै पुरुषस्ततोऽन्यः॥ ११/२३/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.057.m4a", "display_order": 58}, {"id": 6000324058, "chapter_id": 10324, "verse_number": "११-२३-५५", "content_sanskrit": "कर्माऽस्तु हेतुः सुखदुःखयोर्वै किमात्मनस्तद् हि जडेऽजडत्वे।\nदेहे स्ववित् पुरुषोऽयं सुपर्णः क्रुध्येत कस्मै न हि कर्म मूलम्॥ ११/२३/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.058.m4a", "display_order": 59}, {"id": 6000324059, "chapter_id": 10324, "verse_number": "११-२३-५६", "content_sanskrit": "कालोऽस्तु हेतुः सुखदुःखयोश्चेत् किमात्मनस्तत्र तदात्मनोऽसौ।\nनाग्नेर्हि तापो न हिमस्य तत् स्यात् क्रुध्येत कस्मै न परस्य बोद्धुः॥ ११/२३/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.059.m4a", "display_order": 60}, {"id": 6000324060, "chapter_id": 10324, "verse_number": "११-२३-५७", "content_sanskrit": "न केनचित् क्‍वापि कथञ्चनास्य द्वन्द्वोपरागः परतः परस्य।\nयथाऽत्मनः संसृतिरूपिणः स्यादेवं प्रबुद्धो न बिभेति भूतैः॥ ११/२३/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.060.m4a", "display_order": 61}, {"id": 6000324061, "chapter_id": 10324, "verse_number": "११-२३-५८", "content_sanskrit": "एतां समास्थाय परात्मनिष्ठामध्यासितां पूर्वतनैर्महर्षिभिः।\nअहं तरिष्यामि दुरन्तपारं तमो मुकुन्दाङ्घ्रिनिषेवयैव॥ ११/२३/५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.061.m4a", "display_order": 62}, {"id": 6000324062, "chapter_id": 10324, "verse_number": "११-२३-५९", "content_sanskrit": "निर्विद्य नष्टद्रविणो गतक्लमः प्रव्रज्य गां पर्यटमान इत्थम्।\nनिराकृतोऽसद्भिरपि स्वधर्मादकम्पितोऽसौ मुनिराह गाथाम्॥ ११/२३/५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.062.m4a", "display_order": 63}, {"id": 6000324063, "chapter_id": 10324, "verse_number": "११-२३-६०", "content_sanskrit": "सुखदुःखप्रदो नान्यः पुरुषस्यात्मविभ्रमः।\nमित्रोदासीनरिपवः संसारः स्वमनस्ततः॥ ११/२३/६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.063.m4a", "display_order": 64}, {"id": 6000324064, "chapter_id": 10324, "verse_number": "११-२३-६१", "content_sanskrit": "तस्मात् सर्वात्मना तात निगृहाण मनो धिया।\nमय्यावेशितया युक्त एतावान् योगसङ्ग्रहः॥ ११/२३/६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.064.m4a", "display_order": 65}, {"id": 6000324065, "chapter_id": 10324, "verse_number": "११-२३-६२", "content_sanskrit": "य एतां भिक्षुणा गीतां ब्रह्मनिष्ठां समाहितः।\nधारयन् श्रावयन् शृण्वन् द्वन्द्वैर्नैवाभिभूयते॥ ११/२३/६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_023/BhP_11.023.065.m4a", "display_order": 66}, {"id": 6000324066, "chapter_id": 10324, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायाम् एकादशस्कन्धे त्रयोविंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}]