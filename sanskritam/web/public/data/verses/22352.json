[{"id": 7002352000, "chapter_id": 22352, "verse_number": "१-१४-१", "content_sanskrit": "ब्रह्मोवाच ।\nप्रेषिते मण्डनं स्त्रीणां पत्यौ मङ्गलमात्रकम् ।\nनिष्पादनं च यत्नेन तदारब्धस्य कर्मणः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002352001, "chapter_id": 22352, "verse_number": "१-१४-२", "content_sanskrit": "शय्यामुपार्जनमर्थानां व्ययानां परिहापणम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002352002, "chapter_id": 22352, "verse_number": "१-१४-३", "content_sanskrit": "व्रतोपवासतात्पर्यं तद्वार्तापरिमार्गणम् ।\nदैवज्ञेक्षणिकप्रश्नो देवानामुपयाचनम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002352003, "chapter_id": 22352, "verse_number": "१-१४-४", "content_sanskrit": "नित्यं तस्यागमाशंसा क्षेमार्थं देवपूजनम् ।\nन चात्युज्ज्वलवेषत्वं न सदा तैलधारणम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002352004, "chapter_id": 22352, "verse_number": "१-१४-५", "content_sanskrit": "ज्ञातिवेश्म न गन्तव्यं सकामगमनेन च ।\nगुरूणामाज्ञया यावद्भर्तुराप्तजनैः सह ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002352005, "chapter_id": 22352, "verse_number": "१-१४-६", "content_sanskrit": "तत्रापि न चिरं तिष्ठेत्स्नानादीन्वापि नाचरेत् ।\nयावदर्थं क्षणं स्थित्वा ततः शीघ्रं समाचरेत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002352006, "chapter_id": 22352, "verse_number": "१-१४-७", "content_sanskrit": "आगते प्रकृतिस्थैव कृत्वा तात्कालिकं विधिम् ।\nमुक्तप्रवासने पथ्ये स्नाते भुक्तवति प्रिये ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002352007, "chapter_id": 22352, "verse_number": "१-१४-८", "content_sanskrit": "आत्मानं समलङ्कृत्य सविशेषं मुदान्विता ।\nदेवपूजोपहारादीन्दद्यात्प्रागुपपादितान् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002352008, "chapter_id": 22352, "verse_number": "१-१४-९", "content_sanskrit": "कनिष्ठामातृवज्ज्येष्ठां तदपत्यानि चात्मवत् ।\nपश्येत्तत्परिवर्गं तु नित्यं स्वपरिवर्गवत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002352009, "chapter_id": 22352, "verse_number": "१-१४-१०", "content_sanskrit": "तत्पुरोनासने तिष्ठेत्पतिं नामंत्रयेत च ।\nतदभिप्रायतः कुर्यात्प्रवृत्तिं सर्वकर्मसु ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002352010, "chapter_id": 22352, "verse_number": "१-१४-११", "content_sanskrit": "न संसृजेत तद्द्विष्टैः सख्यं कुर्वीत तत्प्रियैः ।\nजनमाप्ततमं तस्य सदाभर्तुश्च मानयेत् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002352011, "chapter_id": 22352, "verse_number": "१-१४-१२", "content_sanskrit": "पैतृकात्समुपानीतं वसुसौगंधिकादिकम् ।\nतस्मै निवेद्यात्मतया तदा तदुपयोजयेत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002352012, "chapter_id": 22352, "verse_number": "१-१४-१३", "content_sanskrit": "सोपि तत्प्रीतये किंचिदादद्यादल्पमूल्यकम् ।\nसंगोप्य मातृवत्स्थेयं तत्तथैवोपयोजयेत् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002352013, "chapter_id": 22352, "verse_number": "१-१४-१४", "content_sanskrit": "तत्प्रीत्यर्थं गृहीतं यद्वैलक्ष्यादिनिवृत्तये ।\nसविशेषं प्रसंगेन तस्यैतत्प्रतिपादयेत् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002352014, "chapter_id": 22352, "verse_number": "१-१४-१५", "content_sanskrit": "स्त्रीणां यदेतत्सापत्न्यं परं मात्सर्यकारणम् ।\nतस्मात्तत्परिहर्तव्यं परमोदारचर्यया२ ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002352015, "chapter_id": 22352, "verse_number": "१-१४-१६", "content_sanskrit": "तथा कल्पितनेपथ्या भर्तुः पर्यायवासरे ।\nह्रियमादयमानेव३ पतिं गच्छेद्विसर्जिता ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002352016, "chapter_id": 22352, "verse_number": "१-१४-१७", "content_sanskrit": "गत्वा रहसि भर्तारं तत्कालोचितसंभ्रमैः ।\nतद्भावानुगतैस्तैस्तैः सविशेषमुपाचरेत् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002352017, "chapter_id": 22352, "verse_number": "१-१४-१८", "content_sanskrit": "प्रतिबुध्य ततः काले सविशेषं त्रपान्विता ।\nज्येष्ठाय वसतिं गच्छेद्विशेषेण तथा पुनः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002352018, "chapter_id": 22352, "verse_number": "१-१४-१९", "content_sanskrit": "अप्रातिकूल्यं ज्येष्ठाया हितमन्यत्र योषितः ।\nततः शनैस्त्ववच्छिद्य पतिं स्ववशमानयेत् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002352019, "chapter_id": 22352, "verse_number": "१-१४-२०", "content_sanskrit": "बहिष्पाकादियोगेन चतुःषष्ट्या रहोगतम् ।\nज्येष्ठामतिशयानेव भर्तारमुपरञ्जयेत् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002352020, "chapter_id": 22352, "verse_number": "१-१४-२१", "content_sanskrit": "प्रागल्भ्यं रहसि स्त्रीणां लज्जाधिक्यं ततोऽन्यदा ।\nचित्तज्ञानानुवृत्तिश्च पत्यौ संसेवनं परम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002352021, "chapter_id": 22352, "verse_number": "१-१४-२२", "content_sanskrit": "एवमाराध्य भर्तारं गृहमाक्रम्य च क्रमात् ।\nगौरवं प्रतिपत्तिं वा ज्येष्ठादिषु न हापयेत् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002352022, "chapter_id": 22352, "verse_number": "१-१४-२३", "content_sanskrit": "गृहव्यापारदानेषु पतिं गुढं तधा वदेत् ।\nअधिकुर्यादनिच्छन्ती ज्येष्ठैवेनां यथा बलात् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002352023, "chapter_id": 22352, "verse_number": "१-१४-२४", "content_sanskrit": "सापि विज्ञाय भर्तारं कनिष्ठाकृष्टमानसम् ।\nविश्रामं प्रार्थयेदेनामधिकुर्यात्सुतामिव ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002352024, "chapter_id": 22352, "verse_number": "१-१४-२५", "content_sanskrit": "मत्वा भर्तुरभिप्रेतं रक्षन्ती निजगौरवम् ।\nकृतं भर्त्रनुकूलं स्यात्तदिष्टायानुमोदयेत् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002352025, "chapter_id": 22352, "verse_number": "१-१४-२६", "content_sanskrit": "स्थानिनो यदभिप्रेतं भृत्यैः किं क्रियतेऽन्यथा ।\nक्लिश्यते तत्र मूढात्मा परतन्त्रो वृथा जनः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002352026, "chapter_id": 22352, "verse_number": "१-१४-२७", "content_sanskrit": "तस्मात्सर्वास्ववस्थासु मनोवाक्कायकर्मभिः ।\nहितं स्वाम्यनुकूलत्वं नारीणां तु विशेषतः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002352027, "chapter_id": 22352, "verse_number": "१-१४-२८", "content_sanskrit": "सापि ज्येष्ठापतिं चैव गृहतन्त्रं च सर्वदा ।\nसमावर्ज्य गुणैर्धीरा प्रागवस्थां न विस्मरेत् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002352028, "chapter_id": 22352, "verse_number": "१-१४-२९", "content_sanskrit": "न सौभाग्यमदं कुर्यान्न चौद्धत्यादिविक्रियाम् ।\nनितरामानतिं गच्छेत्सदानार्यभयादिव ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002352029, "chapter_id": 22352, "verse_number": "१-१४-३०", "content_sanskrit": "यथा योग्यतया पत्यौ सौभाग्यमभिवर्धते ।\nस्पर्धयेच्य कुलस्त्रीणां प्रश्रयोपाधिकं तथा ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002352030, "chapter_id": 22352, "verse_number": "१-१४-३१", "content_sanskrit": "एवमाराध्य भर्तारं तत्कार्येष्वप्रमादिनी ।\nपूज्यानां पूजने नित्यं भृत्यानां भरणेषु च ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002352031, "chapter_id": 22352, "verse_number": "१-१४-३२", "content_sanskrit": "गुणानामर्जने नित्यं शीलवत्परिरक्षणे ।\nप्रेत्य चेह च निर्द्वन्द्वं सुखमाप्नोत्यनुत्तमम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]