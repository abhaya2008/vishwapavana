[{"id": 2146925, "chapter_id": 4172, "verse_number": "", "content_sanskrit": "कण्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2146926, "chapter_id": 4172, "verse_number": "१", "content_sanskrit": "मातलेर्वचनं श्रुत्वा नारदो मुनिसत्तमः ।\nअब्रवीन्नागराजानमार्यकं कुरुनन्दन\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2146927, "chapter_id": 4172, "verse_number": "२", "content_sanskrit": "सूतोऽयं मातलिर्नाम शक्रस्य दयितः सुहृत् ।\nशुचिः शीलगुणोपेतः तेजस्वी वीर्यवान् बली\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2146928, "chapter_id": 4172, "verse_number": "३", "content_sanskrit": "शक्रस्यायं सखा चैव मन्त्री सारथिरेव च ।\nअल्पान्तरप्रभावश्च वासवेन समो रणे\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2146929, "chapter_id": 4172, "verse_number": "४", "content_sanskrit": "अयं हरिसहस्रेण युक्तं चैन्द्रं रथोत्तमम् ।\nदेवासुरेषु युद्धेषु मनसैव नियच्छति\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2146930, "chapter_id": 4172, "verse_number": "५", "content_sanskrit": "अनेन विजितानश्वैः दोर्भ्यां जयति वासवः ।\nअनेन प्रहृते पूर्वं बलभित् प्रहरत्युत\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2146931, "chapter_id": 4172, "verse_number": "६", "content_sanskrit": "अस्य कन्या वरारोहा रूपेणासदृशी भुवि ।\nसत्वशीलगुणोपेता गुणकेशीति विश्रुता\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2146932, "chapter_id": 4172, "verse_number": "७", "content_sanskrit": "तस्यास्य यत्नाच्चरतः त्रैलोक्यममरद्युतेः ।\nसुमुखो भवतः पौत्रो रोचते दुहितुः पतिः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2146933, "chapter_id": 4172, "verse_number": "८", "content_sanskrit": "यदि ते रोचते सौम्य भुजगोत्तम माचिरम् ।\nक्रियतामार्यक क्षिप्रं बुद्धिः कन्यापरिग्रहे\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2146934, "chapter_id": 4172, "verse_number": "९", "content_sanskrit": "यथा विष्णुकुले लक्ष्मीः यथा स्वाहा विभावसौ ।\nकुले तव तथैवास्तु गुणकेशी सुमध्यमा\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2146935, "chapter_id": 4172, "verse_number": "१०", "content_sanskrit": "पौत्रस्यार्थे भवांस्तस्माद् गुणकेशीं प्रतीच्छतु ।\nसदृशीं प्रतिरूपस्य वासवस्य शचीमिव\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2146936, "chapter_id": 4172, "verse_number": "११", "content_sanskrit": "पितृहीनमपि ह्येनं गुणतो वरयामहे ।\nबहुमानाच्च भवतः तथैवैरावतस्य च\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2146937, "chapter_id": 4172, "verse_number": "१२", "content_sanskrit": "सुमुखस्य गुणैश्चैव शीलशौचदमादिभिः ।\nअभिगम्य स्वयं कन्यामयं दातुं समुद्यतः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2146938, "chapter_id": 4172, "verse_number": "१३", "content_sanskrit": "मातलेस्तस्य सम्मानं कतुमर्हो भवानपि\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2146939, "chapter_id": 4172, "verse_number": "", "content_sanskrit": "कण्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2146940, "chapter_id": 4172, "verse_number": "१४", "content_sanskrit": "स तु दीनः प्रहृष्टश्च प्राह नारदमार्यकः ।\nव्रियमाणे तथा पौत्रे पुत्रे च निधनं गते\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2146941, "chapter_id": 4172, "verse_number": "१५", "content_sanskrit": "न मे नैतद् बहुमतं महर्षे वचनं तव ।\nसखा शक्रस्य संयुक्तः कस्यायं नेप्सितो भवेत्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2146942, "chapter_id": 4172, "verse_number": "१६", "content_sanskrit": "कारणस्य तु दौर्बल्यात् चिन्तयामि महामुने\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2146943, "chapter_id": 4172, "verse_number": "१७", "content_sanskrit": "अस्य देहकरस्तात मम पुत्रो महामुने ।\nभक्षितो वैनतेयेन दुःखार्तास्तेन वै वयम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2146944, "chapter_id": 4172, "verse_number": "१८", "content_sanskrit": "पुनरेव च तेनोक्तं वैनतेयेन गच्छता ।\nमासेनान्येन सुमुखं भक्षयिष्य इति प्रभो\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2146945, "chapter_id": 4172, "verse_number": "१९", "content_sanskrit": "ध्रुवं तथा तद् भविता जानीमस्तस्य निश्चयम् ।\nतेन हर्षः प्रनष्टो मे सुपर्णवचनेन च\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2146946, "chapter_id": 4172, "verse_number": "", "content_sanskrit": "कण्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2146947, "chapter_id": 4172, "verse_number": "२०", "content_sanskrit": "आर्यकस्य वचः श्रुत्वा गरुडं प्रति भाषितम् ।\nमातलिस्त्वब्रवीदेनं बुद्धिरत्र कृता मया\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2146948, "chapter_id": 4172, "verse_number": "२१", "content_sanskrit": "जामातृभावेन वृतः सुमुखस्तव पुत्रजः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2146949, "chapter_id": 4172, "verse_number": "२२", "content_sanskrit": "सोऽयं मया च सहितो नारदेन च पन्नगः ।\nत्रिलोकेशं सुरपतिं गत्वा पश्यतु वासवम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2146950, "chapter_id": 4172, "verse_number": "२३", "content_sanskrit": "शेषेणैवास्य कार्यस्य प्राप्तं स्यान्महदायुषः ।\nसुपर्णस्य विघाते च प्रयतिष्यामि सत्तम\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2146951, "chapter_id": 4172, "verse_number": "२४", "content_sanskrit": "सुमुखश्च मया सार्धं देवेशमभिगच्छतु ।\nकार्यसंसाधनार्थाय स्वस्ति तेऽस्तु भुजङ्गम\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2146952, "chapter_id": 4172, "verse_number": "२५", "content_sanskrit": "आर्यकेणाभ्यनुज्ञाता गम्यतामिति भारत\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2146953, "chapter_id": 4172, "verse_number": "२६", "content_sanskrit": "ततस्ते सुमुखं गृह्य सर्व एव महौजसः ।\nददृशुः शक्रमासीनं देवराजं महाद्युतिम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2146954, "chapter_id": 4172, "verse_number": "२७", "content_sanskrit": "सङ्गत्या तत्र भगवान् विष्णुरासीच्चतुर्भुजः ।\nततस्तत् सर्वमाचख्यौ नारदो मातलिं प्रति\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2146955, "chapter_id": 4172, "verse_number": "२८", "content_sanskrit": "ततः पुरन्दरं विष्णुरुवाच भुवनेश्वरम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2146956, "chapter_id": 4172, "verse_number": "२९", "content_sanskrit": "अमृतं दीयतामस्मै क्रियताममरैः समः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2146957, "chapter_id": 4172, "verse_number": "३०", "content_sanskrit": "मातलिर्नारदश्चैव सुमुखश्चैव वासव ।\nलभन्तां भवतः कामात् काममेतं यथेप्सितम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2146958, "chapter_id": 4172, "verse_number": "", "content_sanskrit": "कण्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2146959, "chapter_id": 4172, "verse_number": "३१", "content_sanskrit": "पुरन्दरोऽथ सञ्चित्य वैनतेयपराक्रमम् ।\nविष्णुमेवाब्रवीदेनं भवानेव ददात्विति\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2146960, "chapter_id": 4172, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2146961, "chapter_id": 4172, "verse_number": "३२", "content_sanskrit": "ईशस्त्वं सर्वलोकानां चराणामचराश्च ये ।\nत्वया दत्तमदत्तं कः कर्तुमुत्सहते विभो\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2146962, "chapter_id": 4172, "verse_number": "", "content_sanskrit": "कण्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2146963, "chapter_id": 4172, "verse_number": "३३", "content_sanskrit": "प्रादाच्छक्रस्ततस्तस्मै पन्नगायायुरुत्तमम् ।\nन त्वेनममृतप्राशं चकार बलवृत्रहा\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2146964, "chapter_id": 4172, "verse_number": "३४", "content_sanskrit": "लब्ध्वा वरं तु सुमुखः सुमुखः सम्बभूव ह ।\nकृतदारो यथाकामं जगाम च गृहान् प्रति\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2146965, "chapter_id": 4172, "verse_number": "३५", "content_sanskrit": "नारदस्त्वार्यकश्चैव कृतकार्यौ मुदा युतौ ।\nप्रतिजग्मतुरभ्यर्च्य देवराजं महाद्युतिम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2146966, "chapter_id": 4172, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि त्र्यधिकशततमोऽध्यायः ॥१०३॥\nभगवद्यानपर्वणि चतुस्त्रिंशोऽध्यायः ॥३४॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]