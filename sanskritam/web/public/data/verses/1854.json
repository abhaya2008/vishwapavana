[{"id": 2039065, "chapter_id": 1854, "verse_number": "५-९९-०x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2039066, "chapter_id": 1854, "verse_number": "५-९९-१", "content_sanskrit": "एतत्तु नागलोकस्य नाभिस्थाने स्थितं पुरम्।\nपातालमिति विख्यातं दैत्यदानवसेवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2039067, "chapter_id": 1854, "verse_number": "५-९९-२", "content_sanskrit": "इदमद्भिः समं प्राप्ता ये केचिद्भुवि जङ्गमाः।\nप्रविशन्तो महानादं नदन्ति भयपीडिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2039068, "chapter_id": 1854, "verse_number": "५-९९-३", "content_sanskrit": "अत्रासुरोऽग्निः सततं दीप्यते वारिभोजनः।\nव्यापारेण धृतात्मानं निबद्धं समबुध्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2039069, "chapter_id": 1854, "verse_number": "५-९९-४", "content_sanskrit": "अत्रामृतं सुरैः पीत्वा निहितं निहतारिभिः ॥\nअतः सोमस्य हानिश्च वृद्धिश्चैव प्रदृश्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2039070, "chapter_id": 1854, "verse_number": "५-९९-५", "content_sanskrit": "अत्रादित्यो हयशिराः काले पर्वणि पर्वणि ।\nउत्तिष्ठति सुवर्णाख्यो वाग्भिरापूरयञ्जगत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2039071, "chapter_id": 1854, "verse_number": "५-९९-६", "content_sanskrit": "यस्मादलं समस्तास्ताः पतन्ति जलमूर्तयः ।\nतस्मात्पातालमित्येव ख्यायते पुरमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2039072, "chapter_id": 1854, "verse_number": "५-९९-७", "content_sanskrit": "ऐरावणोऽस्मात्सलिलं गृहीत्वा जगतो हितः ।\nमेघेष्वामुञ्चते शीतं यन्महेन्द्रः प्रवर्षति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2039073, "chapter_id": 1854, "verse_number": "५-९९-८", "content_sanskrit": "ऐरावतो नागराजो वामनः कुमुदोऽञ्जनः ।\nप्रसूताः सुप्रतीकस्य वंशे वारणसत्तमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2039074, "chapter_id": 1854, "verse_number": "५-९९-९", "content_sanskrit": "अत्र नानाविधाकारास्तिमयो नैकरूपिणः ।\nअप्सु सोमप्रभां पीत्वा वसन्ति जलचारिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2039075, "chapter_id": 1854, "verse_number": "५-९९-१०", "content_sanskrit": "अत्र सूर्यांशुभिर्भिन्नाः पातालतलमाश्रिताः ।\nमृता हि दिवसे सूत पुनर्जीवन्ति वै निशि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2039076, "chapter_id": 1854, "verse_number": "५-९९-११", "content_sanskrit": "उदयन्नित्यशश्चात्र चन्द्रमा रश्मिबाहुभिः ।\nअमृतं स्पृश्य संस्पर्शात्संजीवयतिदेहिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2039077, "chapter_id": 1854, "verse_number": "५-९९-१२", "content_sanskrit": "अत्र तेऽधर्मनिरता बद्धाः कालेन पीडिताः ।\nदैतेया निवसन्ति स्म वासवेन हृतश्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2039078, "chapter_id": 1854, "verse_number": "५-९९-१३", "content_sanskrit": "अत्र भूतपतिर्नाम सर्वभूतमहेश्वरः ।\nभूतये सर्वभूतानामचरत्तप उत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2039079, "chapter_id": 1854, "verse_number": "५-९९-१४", "content_sanskrit": "अत्र गोव्रतिनो विप्राः स्वाध्यायाम्नायकर्शिताः ।\nत्यक्तप्राणा जितस्वर्गा निवसन्ति महर्षयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2039080, "chapter_id": 1854, "verse_number": "५-९९-१५", "content_sanskrit": "यत्रतत्रशयो नित्यं येनकेनचिदाशितः।\nयेनकेनचिदाच्छन्नः स गोव्रत इहोच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2039081, "chapter_id": 1854, "verse_number": "५-९९-१६", "content_sanskrit": "पश्य यद्यत्र ते कश्चिद्रोचते गुणतो वरः ।\nवरयिष्यामि तं गत्वा यत्नमास्थाय मातले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2039082, "chapter_id": 1854, "verse_number": "५-९९-१७", "content_sanskrit": "अण्डमेतञ्जले न्यस्तं दीप्यमानमिव श्रिया ।\nआप्रजानां निसर्गाद्वै नोद्भिद्यति न सर्पति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2039083, "chapter_id": 1854, "verse_number": "५-९९-१८", "content_sanskrit": "नास्य जातिं निसर्गं वा कथ्यमानं श्रृणोमि वै।\nपितरं मातरं चापि नास्य जानाति कश्चन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2039084, "chapter_id": 1854, "verse_number": "५-९९-१९", "content_sanskrit": "अतः किल महानग्निरन्तकाले समुत्थितः।\nधक्ष्यते मातले सर्वं त्रैलोक्यं सचराचरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2039085, "chapter_id": 1854, "verse_number": "५-९९-२०", "content_sanskrit": "मातलिस्त्वब्रवीच्छ्रुत्वा नारदस्याथ भाषितम् ।\nन मेऽत्र रोचते कश्चिदन्यतो व्रज माचिरम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2039086, "chapter_id": 1854, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि ऊनशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]