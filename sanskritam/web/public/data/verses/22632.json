[{"id": 7002632000, "chapter_id": 22632, "verse_number": "६-१०-१", "content_sanskrit": "सूत उवाच ।\nवैतालस्तु महाभाग राजानमिदमब्रवीत् ।\nगौडदेशे महाराज वर्धनं नाम वै पुरम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002632001, "chapter_id": 22632, "verse_number": "६-१०-२", "content_sanskrit": "गुणशेखर आख्यातो भूपालस्तत्र धर्मवान् ।\nतन्मन्त्री निर्भयानन्दो जैनधर्मपरा यणः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002632002, "chapter_id": 22632, "verse_number": "६-१०-३", "content_sanskrit": "कदाचिद्भूपतिर्यातो मन्दिरे गिरिजापतेः ।\nपूजयामास तं देवं सर्वव्यापिनमीश्वरम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002632003, "chapter_id": 22632, "verse_number": "६-१०-४", "content_sanskrit": "वृश्चिकस्तत्र संप्राप्य ददंश नृपतिं रुषा ।\nतत्कष्टेन स भूपालो मूर्छितः पतितो भुवि ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002632004, "chapter_id": 22632, "verse_number": "६-१०-५", "content_sanskrit": "तदा तु निर्भयानन्दो विषमुत्तार्य तस्य वै ।\nभूपतिं वर्णयामास जैनधर्म परायणः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002632005, "chapter_id": 22632, "verse_number": "६-१०-६", "content_sanskrit": "शृणु राजन्महाभाग शत्रून्षण्मानसाधमान् ।\nकामः क्रोधस्तथा लोभो रतिर्हिंसा च तृष्णिका ।\nरजोगुणाच्च ते जातास्तेषां भेदाः पृथक्पृथक् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002632006, "chapter_id": 22632, "verse_number": "६-१०-७", "content_sanskrit": "मोहो दंभो मदश्चैव ममताशा च गर्हणा ।\nतमोगुणाच्च ते जातास्तैरिदं पूरितं जगत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002632007, "chapter_id": 22632, "verse_number": "६-१०-८", "content_sanskrit": "कामी विष्णुस्तथा रुद्रः क्रोधी लोभी विधिस्तथा ।\nदंभी शक्रो यमो मोही मदी यक्षपतिः स्वयम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002632008, "chapter_id": 22632, "verse_number": "६-१०-९", "content_sanskrit": "माया वश्याश्च ते सर्वे तर्हि तत्पूजनेन किम् ।\nषट्शत्रुभिर्जितो यो वै स जिनो मुनिभिः स्मृतः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002632009, "chapter_id": 22632, "verse_number": "६-१०-१०", "content_sanskrit": "न जितः स जिनो ज्ञेयोऽद्वैतवादी निरंजनः ।\nतस्य ध्यानेन भावेन मोक्षवंतो नराः सदा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002632010, "chapter_id": 22632, "verse_number": "६-१०-११", "content_sanskrit": "तत्प्रसादाय यो धर्मः शृणु मे वसुधाधिप ।\nगोपूजनेन ते देवास्तुष्टिं यान्ति सदैव हि ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002632011, "chapter_id": 22632, "verse_number": "६-१०-१२", "content_sanskrit": "अतो गोपूजनं शुद्धं हिंसा सर्वत्र वर्जिता ।\nमदपानेन सर्वात्मा जिनः क्लेशं समाप्नुयात् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002632012, "chapter_id": 22632, "verse_number": "६-१०-१३", "content_sanskrit": "तस्मान्मांसं च पानं च वर्जितं सर्वदैव हि ।\nन्यायेनोपार्जितं वित्तं भोजयेच्च बुभुक्षितान् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002632013, "chapter_id": 22632, "verse_number": "६-१०-१४", "content_sanskrit": "रविरात्मा जिनस्यैव तत्प्रकाशे हि भोजयेत् ।\nइत्येवं वर्णयित्वैनं मंत्री गेहमुपाययौ ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002632014, "chapter_id": 22632, "verse_number": "६-१०-१५", "content_sanskrit": "तथैव मत्वा स नृपो जिनधर्मं गृहीतवान् ।\nकियता चैव कालेन वेदमार्गो हि लंघितः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002632015, "chapter_id": 22632, "verse_number": "६-१०-१६", "content_sanskrit": "तदा तु दुःखिता राज्ञी शिवस्य शरणं ययौ ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002632016, "chapter_id": 22632, "verse_number": "६-१०-१७", "content_sanskrit": "वरदानेन रुद्रस्य पुत्रो जातो महोत्तमः ।\nधर्मराज इति ख्यातो वेदव्रतपरायणः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002632017, "chapter_id": 22632, "verse_number": "६-१०-१८", "content_sanskrit": "गुणशेखर एवासौ पंचत्वे निरयं ययौ ।\nधर्मराजस्तदा राज्यं कृतवान्धर्मतः स्वयम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002632018, "chapter_id": 22632, "verse_number": "६-१०-१९", "content_sanskrit": "तस्य धर्मप्रभावेण तत्पिता स्वर्गमाप्तवान् ।\nत्रयः पत्न्योभवंस्तस्यगुणरूपा महोत्तमा ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002632019, "chapter_id": 22632, "verse_number": "६-१०-२०", "content_sanskrit": "वसंतसमये राजा ताभिः सह वनांतरे ।\nसंयातो रमयामास पुष्पभ्रमरनादिते ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002632020, "chapter_id": 22632, "verse_number": "६-१०-२१", "content_sanskrit": "श्रमितः स तु भूपालो राज्ञीभिः सह मोदितः ।\nसरोवरे स्नापितवान्मदाघूर्णितलोचनः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002632021, "chapter_id": 22632, "verse_number": "६-१०-२२", "content_sanskrit": "गृहीत्वा कुसुमं पाद्मं करे राज्ञ्यै समार्पयत् ।\nपदि हीनत्वमायाता पतता कुसुमेन वै ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002632022, "chapter_id": 22632, "verse_number": "६-१०-२३", "content_sanskrit": "दुःखितः स तु भूपालो राज्ञीं तामचिकित्सयत् ।\nरात्रौ प्राप्ते द्वितीया तु चन्द्रशीलेन मोहिता ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002632023, "chapter_id": 22632, "verse_number": "६-१०-२४", "content_sanskrit": "अपतद्व्याकुलीभूत्वा शुद्धं पादमभूत्ततः ।\nपतितायाश्च शब्देन तृतीया ज्वरिताऽभवत् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002632024, "chapter_id": 22632, "verse_number": "६-१०-२५", "content_sanskrit": "तस्या मूर्च्छा तदा क्षीणा द्वितीयाया अजायत ।\nनृपस्पर्शेन सा सुभ्रूर्ज्वरतापं विहाय च ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002632025, "chapter_id": 22632, "verse_number": "६-१०-२६", "content_sanskrit": "प्रभाते सुंदरे जाते स ताभिर्गृहमाययौ ।\nइत्युक्त्वा स तु वैतालो भूपतिं प्राह नम्रधीः ।\nआसां मध्ये महाराज का श्रेष्ठा सुकुमारिका ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002632026, "chapter_id": 22632, "verse_number": "६-१०-२७", "content_sanskrit": "राजोवाच ।\nतृतीया सुकुमारी च तासां मध्ये महोत्तमा ।\nवायुप्रकृतितश्चासौ पद्मपुष्पेण खंजिता ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002632027, "chapter_id": 22632, "verse_number": "६-१०-२८", "content_sanskrit": "शीतांशुना द्वितीया तु मूर्च्छिता कफभावतः ।\nशब्दमात्रेण संतापो यस्यां जातो हि सोत्तमा ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002632028, "chapter_id": 22632, "verse_number": "६-१०-२९", "content_sanskrit": "विहस्याह पुनर्देवो भवभक्तं महीपतिम् ।\nजैनधर्मः प्रधानो हि वेदधर्मोथ वा वद ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002632029, "chapter_id": 22632, "verse_number": "६-१०-३०", "content_sanskrit": "स होवाच प्रधानोऽसौ वेदधर्मः सनातनः ।\nअष्टौ श्रेण्यो हि तस्यैव ब्रह्मणोव्यक्तरूपिणः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002632030, "chapter_id": 22632, "verse_number": "६-१०-३१", "content_sanskrit": "शूद्रो वैश्यस्तथा क्षत्री ब्राह्मणो ब्रह्मचर्यकृत् ।\nगेही वन्यो यतिश्चैव क्रमाच्छ्रेष्ठाः प्रकीर्तिताः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002632031, "chapter_id": 22632, "verse_number": "६-१०-३२", "content_sanskrit": "यः कृत्वा दारसंसर्गं यतिवद्वर्तते गृही ।\nस पापी नरकं याति यावदाभूतसंप्लवम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002632032, "chapter_id": 22632, "verse_number": "६-१०-३३", "content_sanskrit": "गृहेषु यतिवद्धर्मो जैनशास्त्रे प्रकीर्तितः ।\nपाखण्डः स स्मृतः प्राज्ञैर्वर्जनीयो हि सर्वदा ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]