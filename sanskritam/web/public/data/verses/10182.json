[{"id": 6000182000, "chapter_id": 10182, "verse_number": null, "content_sanskrit": "अथ सप्तमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000182001, "chapter_id": 10182, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.001.m4a", "display_order": 2}, {"id": 6000182002, "chapter_id": 10182, "verse_number": "९-७-१", "content_sanskrit": "विरूपः केतुमाञ्छम्भुरम्बरीषसुतास्‍त्रयः।\nविरूपात् पृषदश्वोऽभूत् तत्पुत्रस्तु रथीतरः॥ ९/७/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.002.m4a", "display_order": 3, "topics": [{"text": "अम्बरीषस्य वंशे राथीतरापरनामकानामाङ्गिरसानां ब्राह्मणानां जननम्", "range": "१–२"}]}, {"id": 6000182003, "chapter_id": 10182, "verse_number": "९-७-२", "content_sanskrit": "रथीतरस्याप्रजस्य भार्यायां तन्तवेऽर्थितः।\nअङ्गिरा जनयामास ब्रह्मवर्चस्विनः सुतान्॥ ९/७/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.003.m4a", "display_order": 4}, {"id": 6000182004, "chapter_id": 10182, "verse_number": "९-७-३", "content_sanskrit": "एते क्षत्रप्रसूता वै पुनश्चाङ्गिरसः स्मृताः।\nरथीतराणां प्रवराः क्षत्रोपेता द्विजातयः॥ ९/७/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.004.m4a", "display_order": 5, "topics": [{"text": "मनोर्ज्येष्ठपुत्रस्य इक्ष्वाकोर्वंशे शशादादिमान्धातृपर्यन्तानां राज्ञां कथाकथनम्", "range": "३–३७"}]}, {"id": 6000182005, "chapter_id": 10182, "verse_number": "९-७-४", "content_sanskrit": "क्षुवतस्तु मनोर्जज्ञे इक्ष्वाकुर्घ्राणतः सुतः।\nतस्य पुत्रशतं ज्येष्ठा विकुक्षिनिमिदण्डकाः॥ ९/७/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.005.m4a", "display_order": 6}, {"id": 6000182006, "chapter_id": 10182, "verse_number": "९-७-५", "content_sanskrit": "तेषां पुरस्तादभवन् आर्यावर्ते नृपा नृप।\nपञ्चविंशति पश्चाच्च त्रयो मध्येऽपरेऽन्यतः॥ ९/७/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.006.m4a", "display_order": 7}, {"id": 6000182007, "chapter_id": 10182, "verse_number": "९-७-६", "content_sanskrit": "स एकदाऽष्टकाश्राद्ध इक्ष्वाकुः सुतमादिशत्।\nमांसमानीयतां मेध्यं विकुक्षे गच्छ मा चिरम्॥ ९/७/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.007.m4a", "display_order": 8}, {"id": 6000182008, "chapter_id": 10182, "verse_number": "९-७-७", "content_sanskrit": "तथेति सवनं गत्वा मृगान् हत्वा क्रियार्हणान्।\nश्रान्तो बुभुक्षितो वीरः शशमाददपस्मृतिः॥ ९/७/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.008.m4a", "display_order": 9}, {"id": 6000182009, "chapter_id": 10182, "verse_number": "९-७-८", "content_sanskrit": "शेषं निवेदयामास पित्रे तेन च तद्गुरुः।\nचोदितः प्रोक्षणायाह दुष्टमेतदकर्मकम्॥ ९/७/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.009.m4a", "display_order": 10}, {"id": 6000182010, "chapter_id": 10182, "verse_number": "९-७-९", "content_sanskrit": "ज्ञात्वा पुत्रस्य तत्कर्म गुरुणाऽभिहितं नृपः।\nदेशान्निस्सारयामास सुतं त्यक्तविधिं रुषा॥ ९/७/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.010.m4a", "display_order": 11}, {"id": 6000182011, "chapter_id": 10182, "verse_number": "९-७-१०", "content_sanskrit": "स तु विप्रेण संवादं जापकेन समाचरन्।\nत्यक्त्वा कलेवरं योगी स तेनावाप यत्परम्॥ ९/७/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.011.m4a", "display_order": 12}, {"id": 6000182012, "chapter_id": 10182, "verse_number": "९-७-११", "content_sanskrit": "पितर्युपरतेऽभ्येत्य विकुक्षिः पृथिवीमिमाम्।\nअशासदीजे स हरिं यज्ञैः पुष्कलदक्षिणैः॥ ९/७/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.012.m4a", "display_order": 13}, {"id": 6000182013, "chapter_id": 10182, "verse_number": "९-७-१२", "content_sanskrit": "पुरञ्जयस्तस्य सुत इन्द्रवाह इतीरितः।\nककुत्स्थ इति वाप्युक्तः शृणु नामानि कर्मभिः॥ ९/७/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.013.m4a", "display_order": 14}, {"id": 6000182014, "chapter_id": 10182, "verse_number": "९-७-१३", "content_sanskrit": "कृतान्त आसीत् समरे देवानां सह दानवैः।\nपार्ष्णिग्राहो वृतो वीरो देवैर्दैत्यपराजितैः॥ ९/७/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.014.m4a", "display_order": 15}, {"id": 6000182015, "chapter_id": 10182, "verse_number": "९-७-१४", "content_sanskrit": "वचनाद्देवदेवस्य विष्णोर्विश्वात्मनः प्रभोः।\nवाहनत्वे वृतस्तस्य बभूवेन्द्रो महावृषः॥ ९/७/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.015.m4a", "display_order": 16}, {"id": 6000182016, "chapter_id": 10182, "verse_number": "९-७-१५", "content_sanskrit": "स सन्नद्धो धनुर्दिव्यमादाय विशिखान् शितान्।\nस्तूयमानस्तमारुह्य युयुत्सुः ककुदि स्थितः॥ ९/७/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.016.m4a", "display_order": 17}, {"id": 6000182017, "chapter_id": 10182, "verse_number": "९-७-१६", "content_sanskrit": "तेजसा व्यापितो विष्णोः पुरुषस्य परात्मनः।\nप्रतीच्यां दिशि दैत्यानां न्यरुणत् त्रिदशैः पुरम्॥ ९/७/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.017.m4a", "display_order": 18}, {"id": 6000182018, "chapter_id": 10182, "verse_number": "९-७-१७", "content_sanskrit": "तैस्तस्य ह्यभवद् राजन् सङ्ग्रामो रोमहर्षणः।\nयमाय भल्लैरनयद् दैत्यान् ये युयुधुर्मृधे॥ ९/७/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.018.m4a", "display_order": 19}, {"id": 6000182019, "chapter_id": 10182, "verse_number": "९-७-१८", "content_sanskrit": "तस्येषुपाताभिमुखं युगान्ताग्निमिवोल्बणम्।\nविसृज्य दुद्रुवुर्दैत्या हन्यमानाः स्वमालयम्॥ ९/७/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.019.m4a", "display_order": 20}, {"id": 6000182020, "chapter_id": 10182, "verse_number": "९-७-१९", "content_sanskrit": "जित्वा पुरं धनं सर्वं सश्रीकं वज्रपाणये।\nप्रत्ययच्छत् स राजर्षिरिति नामभिराहुतः॥ ९/७/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.020.m4a", "display_order": 21}, {"id": 6000182021, "chapter_id": 10182, "verse_number": "९-७-२०", "content_sanskrit": "पुरञ्जयस्य पुत्रोऽभूदनेनास्तत्सुतः पृथुः।\nविश्वगन्धिस्ततश्चन्द्रो युवनाश्वस्तु तत्सुतः॥ ९/७/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.021.m4a", "display_order": 22}, {"id": 6000182022, "chapter_id": 10182, "verse_number": "९-७-२१", "content_sanskrit": "शावस्तिस्तत्सुतो येन शावस्ती निर्मिता पुरी।\nबृहदश्वस्तु शावस्तेस्ततः कुवलयाश्वकः॥ ९/७/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.022.m4a", "display_order": 23}, {"id": 6000182023, "chapter_id": 10182, "verse_number": "९-७-२२", "content_sanskrit": "यः प्रियार्थमुदङ्कस्य धुन्धुनामासुरं बली।\nसुतानामेकविंशत्या सहस्रैरहनद् वृतः॥ ९/७/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.023.m4a", "display_order": 24}, {"id": 6000182024, "chapter_id": 10182, "verse_number": "९-७-२३", "content_sanskrit": "धुन्धुमार इति ख्यातस्तत्सुतास्ते प्रजज्वलुः।\nधुन्धोर्मुखाग्निना सर्वे त्रय एवावशेषिताः॥ ९/७/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.024.m4a", "display_order": 25}, {"id": 6000182025, "chapter_id": 10182, "verse_number": "९-७-२४", "content_sanskrit": "दृढाश्वः कपिलाश्वश्च भद्राश्व इति भारत।\nदृढाश्वपुत्रो हर्यश्वो निकुम्भस्तत्सुतः स्मृतः॥ ९/७/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.025.m4a", "display_order": 26}, {"id": 6000182026, "chapter_id": 10182, "verse_number": "९-७-२५", "content_sanskrit": "बर्हणाश्वो निकुम्भस्य कृशाश्वोऽथास्य सेनजित्।\nयुवनाश्वोऽभवत् तस्य सोऽनपत्यो वनं गतः॥ ९/७/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.026.m4a", "display_order": 27}, {"id": 6000182027, "chapter_id": 10182, "verse_number": "९-७-२६", "content_sanskrit": "भार्याशतेन निर्विण्ण ऋषयोऽस्य कृपालवः।\nइष्टिं स्म वर्तयाञ्चक्रुरैन्द्रीं ते सुसमाहिताः॥ ९/७/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.027.m4a", "display_order": 28}, {"id": 6000182028, "chapter_id": 10182, "verse_number": "९-७-२७", "content_sanskrit": "राजा तद्यज्ञसदनं प्रविष्टो निशि तर्षितः।\nदृष्ट्वा शयानान् विप्रांस्तान् पपौ मन्त्रजलं स्वयम्॥ ९/७/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.028.m4a", "display_order": 29}, {"id": 6000182029, "chapter_id": 10182, "verse_number": "९-७-२८", "content_sanskrit": "उत्थितास्ते निशाम्याथ व्युदकं कलशं प्रभो।\nपप्रच्छुः कस्य कर्मेदं पीतं पुंसवनं जलम्॥ ९/७/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.029.m4a", "display_order": 30}, {"id": 6000182030, "chapter_id": 10182, "verse_number": "९-७-२९", "content_sanskrit": "राज्ञा पीतं विदित्वाऽथ ईश्वरप्रहितेन ते।\nईश्वराय नमश्चक्रुरहो दैवबलं बलम्॥ ९/७/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.030.m4a", "display_order": 31}, {"id": 6000182031, "chapter_id": 10182, "verse_number": "९-७-३०", "content_sanskrit": "ततः काल उपावृत्ते कुक्षिं निर्भिद्य दक्षिणम्।\nयुवनाश्वस्य तनयश्चक्रवर्ती जजान ह॥ ९/७/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.031.m4a", "display_order": 32}, {"id": 6000182032, "chapter_id": 10182, "verse_number": "९-७-३१", "content_sanskrit": "कं धास्यति कुमारोऽयं स्तन्यो रोरूयते भृशम्।\nमान्धातर्वत्स मा रोदीरितीन्द्रो देशिनीमदात्॥ ९/७/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.032.m4a", "display_order": 33}, {"id": 6000182033, "chapter_id": 10182, "verse_number": "९-७-३२", "content_sanskrit": "न ममार पिता तस्य विप्रदेवप्रसादतः।\nयुवनाश्वोऽथ तत्रैव तपसा सिद्धिमन्वगात्॥ ९/७/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.033.m4a", "display_order": 34}, {"id": 6000182034, "chapter_id": 10182, "verse_number": "९-७-३३", "content_sanskrit": "त्रसद्दस्युरितीन्द्रोऽङ्ग विदधे नाम तस्य वै।\nयस्मात् त्रसन्ति ह्युद्विग्ना दस्यवो रावणादयः॥ ९/७/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.034.m4a", "display_order": 35}, {"id": 6000182035, "chapter_id": 10182, "verse_number": "९-७-३४", "content_sanskrit": "यौवनाश्वोऽथ मान्धाता चक्रवर्त्यवनीं प्रभुः।\nसप्तद्वीपवतीमेकः शशासाच्युततेजसा॥ ९/७/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.035.m4a", "display_order": 36}, {"id": 6000182036, "chapter_id": 10182, "verse_number": "९-७-३५", "content_sanskrit": "ईजे च यज्ञं क्रतुभिरात्मविद् भूरिदक्षिणैः।\nसर्वदेवमयं देवं सर्वात्मकमतीन्द्रियम्॥ ९/७/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.036.m4a", "display_order": 37}, {"id": 6000182037, "chapter_id": 10182, "verse_number": "९-७-३६", "content_sanskrit": "द्रव्यं मन्त्रो विधिर्यज्ञो यजमानस्तथर्त्विजः।\nधर्मो देशश्च कालश्च सर्वमेतद् यदात्मकम्॥ ९/७/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.037.m4a", "display_order": 38}, {"id": 6000182038, "chapter_id": 10182, "verse_number": "९-७-३७", "content_sanskrit": "यावत् सूर्य उदेति स्म यावच्चन्द्रः प्रतिष्ठति।\nसर्वं तद् यौवनाश्वस्य मान्धातुः क्षेत्रमुच्यते॥ ९/७/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.038.m4a", "display_order": 39}, {"id": 6000182039, "chapter_id": 10182, "verse_number": "९-७-३८", "content_sanskrit": "शशबिन्दोर्दुहितरि बिन्दुमत्यामधान्नृपः। पुरुकुत्समम्बरीषं मुचुकुन्दं च योगिनम्।\nतेषां स्वसारः पञ्चाशत् सौभरिं वव्रिरे पतिम्॥ ९/७/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.039.m4a", "display_order": 40, "topics": [{"text": "प्रसङ्गान्मान्धातृजामातुः सौभरिऋषेः कथा", "range": "३८–५५"}]}, {"id": 6000182040, "chapter_id": 10182, "verse_number": "९-७-३९", "content_sanskrit": "यमुनान्तर्जले मग्नस्तप्यमानः परंतपः।\nनिर्वृतिं मीनराजस्य वीक्ष्य मैथुनधर्मिणः॥ ९/७/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.040.m4a", "display_order": 41}, {"id": 6000182041, "chapter_id": 10182, "verse_number": "९-७-४०", "content_sanskrit": "जातस्पृहो नृपं विप्रः कन्यामेकामयाचत।\nसोऽप्याह गृह्यतां ब्रह्मन् कामं कन्यां स्वयम्वरे॥ ९/७/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.041.m4a", "display_order": 42}, {"id": 6000182042, "chapter_id": 10182, "verse_number": "९-७-४१", "content_sanskrit": "स विचिन्त्याप्रियः स्‍त्रीणां जरठोऽयमसम्मतः।\nवलीपलित एजत्क इत्यहं प्रत्युदाहृतः॥ ९/७/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.042.m4a", "display_order": 43}, {"id": 6000182043, "chapter_id": 10182, "verse_number": "९-७-४२", "content_sanskrit": "साधयिष्ये तथाऽऽत्मानं सुरस्‍त्रीणामभीप्सितम्।\nकिं पुनर्मनुजस्‍त्रीणामिति व्यवसितः प्रभुः॥ ९/७/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.043.m4a", "display_order": 44}, {"id": 6000182044, "chapter_id": 10182, "verse_number": "९-७-४३", "content_sanskrit": "मुनिः प्रवेशितः क्षत्त्रा कन्यान्तःपुरमृद्धिमत्।\nवृतश्च राजकन्याभिरेकः पञ्चाशता वरः॥ ९/७/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.044.m4a", "display_order": 45}, {"id": 6000182045, "chapter_id": 10182, "verse_number": "९-७-४४", "content_sanskrit": "तासां कलिरभूद् भूयांस्तदर्थेऽपोह्य सौहृदम्।\nममानुरूपो नायं व इति तद्गतचेतसाम्॥ ९/७/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.045.m4a", "display_order": 46}, {"id": 6000182046, "chapter_id": 10182, "verse_number": "९-७-४५", "content_sanskrit": "स बह्वृचस्ताभिरवारणीयश्रिया विराजत्सपरिच्छदेषु।\nगृहेषु नानोपवनामलाम्भःप्रसूनसौगन्धिककाननेषु॥ ९/७/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.046.m4a", "display_order": 47}, {"id": 6000182047, "chapter_id": 10182, "verse_number": "९-७-४६", "content_sanskrit": "महार्हशय्यासनवस्‍त्रभूषणस्नानानुलेपाभ्यवहारमाल्यकैः।\nस्वलङ्कृतस्‍त्रीपुरुषेषु नित्यदा रेमेऽनुगायद्द्विजवृन्दबन्दिषु॥ ९/७/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.047.m4a", "display_order": 48}, {"id": 6000182048, "chapter_id": 10182, "verse_number": "९-७-४७", "content_sanskrit": "यद्गार्हस्थ्यं तुं संवीक्ष्य सप्तद्वीपवतीपतिः।\nविस्मितः स्तम्भमजहात् सार्वभौमश्रियाऽ न्वितः॥ ९/७/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.048.m4a", "display_order": 49}, {"id": 6000182049, "chapter_id": 10182, "verse_number": "९-७-४८", "content_sanskrit": "एवं गृहेष्वभिरतो विषयान् विविधैः सुखैः।\nसेवमानो न चातुष्यदाज्यस्तोकैरिवानलः॥ ९/७/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.049.m4a", "display_order": 50}, {"id": 6000182050, "chapter_id": 10182, "verse_number": "९-७-४९", "content_sanskrit": "स कदाचिदुपासीन आत्मापह्नवमात्मना।\nददर्श बह्वृचाचार्यो मीनसङ्गसमुत्थितम्॥ ९/७/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.050.m4a", "display_order": 51}, {"id": 6000182051, "chapter_id": 10182, "verse_number": "९-७-५०", "content_sanskrit": "अहो इमं पश्यत मे विनाशं तपस्विनः सच्चरितव्रतस्य।\nअन्तर्जले वारिचरप्रसङ्गात् प्रस्रावितं ब्रह्म चिरं धृतं यत्॥ ९/७/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.051.m4a", "display_order": 52}, {"id": 6000182052, "chapter_id": 10182, "verse_number": "९-७-५१", "content_sanskrit": "सङ्गं त्यजेत मिथुनव्रजिनान्मुमुक्षुः सर्वात्मना न विसृजेद् बहिरिन्द्रियाणि।\nएकश्चरन् रहसि चित्तमनन्त ईशे युञ्जीत तद्रतिषु साधुषु चेत् प्रसङ्गः॥ ९/७/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.052.m4a", "display_order": 53}, {"id": 6000182053, "chapter_id": 10182, "verse_number": "९-७-५२", "content_sanskrit": "एकस्तपस्व्यहमथाम्भसि मत्स्यसङ्गात् पञ्चाशताऽथ सुतपञ्चसहस्रसङ्गः।\nनान्तं व्रजाम्युभयकृत्यमनोरथानां मायागुणैर्हृतमतिर्विषयेऽर्थभावः॥ ९/७/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.053.m4a", "display_order": 54}, {"id": 6000182054, "chapter_id": 10182, "verse_number": "९-७-५३", "content_sanskrit": "एवं वसन् गृहे कालं विरक्तो न्यासमाश्रितः।\nवनं जगामानुययुस्तत्पत्न्यः पतिदेवताः॥ ९/७/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.054.m4a", "display_order": 55}, {"id": 6000182055, "chapter_id": 10182, "verse_number": "९-७-५४", "content_sanskrit": "तत्र तप्त्वा तपस्तीक्ष्णमात्मकर्शनमात्मवित्।\nसहैवाग्निभिरात्मानं युयोज परमात्मनि॥ ९/७/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.055.m4a", "display_order": 56}, {"id": 6000182056, "chapter_id": 10182, "verse_number": "९-७-५५", "content_sanskrit": "ताः स्वपत्युर्महाराज निरीक्ष्याध्यात्मिकीं गतिम्।\nअन्वीयुस्तत्प्रभावेण शान्तमग्निमिवार्चिषः॥ ९/७/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.056.m4a", "display_order": 57}, {"id": 6000182057, "chapter_id": 10182, "verse_number": "९-७-५६", "content_sanskrit": "मान्धातृपुत्रप्रवरो योऽम्बरीषः प्रकीर्तितः।\nमातामहेन प्रवृतो युवनाश्वस्तु तत्सुतः॥ ९/७/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.057.m4a", "display_order": 58, "topics": [{"text": "मान्धातृवंशे पुरुकुत्सस्य त्रिशङ्कोः हरिश्चन्द्रस्य च कथाः", "range": "५६–८१"}]}, {"id": 6000182058, "chapter_id": 10182, "verse_number": "९-७-५७", "content_sanskrit": "हरितस्तस्य पुत्रोऽभून्मान्धातृप्रवरा इमे।\nनर्मदा भ्रातृभिर्दत्ता पुरुकुत्साय चोरगैः॥ ९/७/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.058.m4a", "display_order": 59}, {"id": 6000182059, "chapter_id": 10182, "verse_number": "९-७-५८", "content_sanskrit": "तया रसातलं नीतो भुजगेन्द्रप्रयुक्तया।\nगन्धर्वान् सोऽवधीत् तत्र वध्र्यश्वान् विष्णुशक्तिधृक्॥ ९/७/५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.059.m4a", "display_order": 60}, {"id": 6000182060, "chapter_id": 10182, "verse_number": "९-७-५९", "content_sanskrit": "नागाल्लब्धवरः सर्पादभयं स्मरतामिमम्।\nत्रसद्दस्युः पौरुकुत्सो योऽनरण्यस्य देहकृत्॥ ९/७/५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.060.m4a", "display_order": 61}, {"id": 6000182061, "chapter_id": 10182, "verse_number": "९-७-६०", "content_sanskrit": "हर्यश्वस्तत्सुतस्तस्मादरुणोऽथ त्रिबन्धुरः।\nतस्य सत्यव्रतः पुत्रस्‍त्रिशङ्कुरिति विश्रुतः॥ ९/७/६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.061.m4a", "display_order": 62}, {"id": 6000182062, "chapter_id": 10182, "verse_number": "९-७-६१", "content_sanskrit": "प्राप्तश्चण्डालतां शापाद् गुरोः कौशिकतेजसा।\nसशरीरो गतः स्वर्गमद्यापि दिवि दृश्यते॥ ९/७/६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.062.m4a", "display_order": 63}, {"id": 6000182063, "chapter_id": 10182, "verse_number": "९-७-६२", "content_sanskrit": "पतितोऽर्वाक्शिरा देवैस्तेनैव स्तम्भितो बलात्।\nत्रैशङ्कवो हरिश्चन्द्रो विश्वामित्रवसिष्ठयोः॥ ९/७/६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.063.m4a", "display_order": 64}, {"id": 6000182064, "chapter_id": 10182, "verse_number": "९-७-६३", "content_sanskrit": "यन्निमित्तमभूद् युद्धं पक्षिणोर्बहुवार्षिकम्।\nसोऽनपत्यो विषण्णात्मा नारदस्योपदेशतः॥ ९/७/६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.064.m4a", "display_order": 65}, {"id": 6000182065, "chapter_id": 10182, "verse_number": "९-७-६४", "content_sanskrit": "वरुणं शरणं यातः पुत्रो मे जायतां प्रभो।\nयदि वीरो महाराज तेनैव त्वां यजे इति॥ ९/७/६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.065.m4a", "display_order": 66}, {"id": 6000182066, "chapter_id": 10182, "verse_number": "९-७-६५", "content_sanskrit": "तथेति वरुणेनोक्ते पुत्रो जातस्तु रोहितः।\nजातः सुतो ह्यनेनाङ्ग मां यजस्वेति सोऽब्रवीत्॥ ९/७/६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.066.m4a", "display_order": 67}, {"id": 6000182067, "chapter_id": 10182, "verse_number": "९-७-६६", "content_sanskrit": "यदा पशुर्निर्दशः स्यादथ मेध्यो भवेदिति।\nनिर्दशे च समागत्य यजस्वेत्याह सोऽब्रवीत्॥ ९/७/६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.067.m4a", "display_order": 68}, {"id": 6000182068, "chapter_id": 10182, "verse_number": "९-७-६७", "content_sanskrit": "दन्ताः पशोर्यज्जायेरन्नथ मेध्यो भवेदिति।\nजाता दन्ता यजस्वेति स प्रत्याहाथ सोऽब्रवीत्॥ ९/७/६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.068.m4a", "display_order": 69}, {"id": 6000182069, "chapter_id": 10182, "verse_number": "९-७-६८", "content_sanskrit": "यदा पतन्त्यस्य दन्ता अथ मेध्यो भवेदिति।\nपशोर्निपतिता दन्ता यजस्वेत्याह सोऽब्रवीत्॥ ९/७/६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.069.m4a", "display_order": 70}, {"id": 6000182070, "chapter_id": 10182, "verse_number": "९-७-६९", "content_sanskrit": "यदा पशोः पुनर्दन्ता जायन्तेऽथ पशुः शुचिः।\nपुनर्जाता यजस्वेति स प्रत्याहाथ सोऽब्रवीत्॥ ९/७/६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.070.m4a", "display_order": 71}, {"id": 6000182071, "chapter_id": 10182, "verse_number": "९-७-७०", "content_sanskrit": "सान्नाहुको यदा राजन् राजन्योऽथ पशुः शुचिः। इति पुत्रानुरागेण स्नेहयन्त्रितचेतसा।\nकालं वञ्चयता तं तमुक्तो देवस्तमैक्षत॥ ९/७/७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.071.m4a", "display_order": 72}, {"id": 6000182072, "chapter_id": 10182, "verse_number": "९-७-७१", "content_sanskrit": "रोहितस्तदभिज्ञाय पितुः कर्म चिकीर्षितम्।\nप्राणप्रेप्सुर्धनुष्पाणिररण्यं प्रत्यपद्यत॥ ९/७/७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.072.m4a", "display_order": 73}, {"id": 6000182073, "chapter_id": 10182, "verse_number": "९-७-७२", "content_sanskrit": "पितरं वरुणग्रस्तं श्रुत्वा जातमहोदरम्।\nरोहितो ग्राममेयाय तमिन्द्रः प्रत्यषेधत॥ ९/७/७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.073.m4a", "display_order": 74}, {"id": 6000182074, "chapter_id": 10182, "verse_number": "९-७-७३", "content_sanskrit": "भूमेः पर्यटनं पुण्यं तीर्थक्षेत्रनिषेवणैः।\nरोहितायाऽदिशच्छक्रः सोऽप्यरण्येऽचरत् समाः॥ ९/७/७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.074.m4a", "display_order": 75}, {"id": 6000182075, "chapter_id": 10182, "verse_number": "९-७-७४", "content_sanskrit": "एवं द्वितीये तृतीये चतुर्थे पञ्चमे तथा।\nअभ्येत्याभ्येत्य स्थविरो विप्रो भूत्वाऽऽह वृत्रहा॥ ९/७/७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.075.m4a", "display_order": 76}, {"id": 6000182076, "chapter_id": 10182, "verse_number": "९-७-७५", "content_sanskrit": "षष्ठं संवत्सरं तत्र चरित्वा रोहितः पुरीम्। उपव्रजन्नजीगर्तादक्रीणान्मध्यमं सुतम्।\nशुनःशेपं पशुं पित्रे प्रदाय समवन्दत॥ ९/७/७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.076.m4a", "display_order": 77}, {"id": 6000182077, "chapter_id": 10182, "verse_number": "९-७-७६", "content_sanskrit": "ततः पुरुषमेधेन हरिश्चन्द्रो महायशाः।\nमुक्तोदरो यजन् देवान् वरुणादीन् महाक्रतौ॥ ९/७/७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.077.m4a", "display_order": 78}, {"id": 6000182078, "chapter_id": 10182, "verse_number": "९-७-७७", "content_sanskrit": "विश्वामित्रोऽभवत् तस्मिन् होताध्वर्युरथात्मवान्।\nजमदग्निरभूद् ब्रह्मा वसिष्ठोऽयास्यसामगः॥ ९/७/७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.078.m4a", "display_order": 79}, {"id": 6000182079, "chapter_id": 10182, "verse_number": "९-७-७८", "content_sanskrit": "तस्मै तुष्टो ददाविन्द्रः शातकुम्भमयं रथम्।\nशुनःशेपस्य माहात्म्यमुपरिष्टात् प्रचक्ष्यते॥ ९/७/७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.079.m4a", "display_order": 80}, {"id": 6000182080, "chapter_id": 10182, "verse_number": "९-७-७९", "content_sanskrit": "सत्यसारं धृतिं दृष्ट्वा सभार्यस्य च भूपतेः।\nविश्वामित्रो भृशं प्रीतो ददावविहतां गतिम्॥ ९/७/७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.080.m4a", "display_order": 81}, {"id": 6000182081, "chapter_id": 10182, "verse_number": "९-७-८०", "content_sanskrit": "मनः पृथिव्यां तामद्भिस्तेजसाम्भोऽनिलेन तत्।\nखे वायुं धारयंस्तं च शब्दादौ तन्महात्मनि॥ ९/७/८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.081.m4a", "display_order": 82}, {"id": 6000182082, "chapter_id": 10182, "verse_number": "९-७-८१", "content_sanskrit": "तस्मिन् ज्ञानकलां ध्यात्वा तया ज्ञानं विनिर्दहन्। हित्वा तां स्वेन भावेन निर्वाणसुखसंविदा।\nअनिर्देश्याप्रतर्क्येण तस्थौ विध्वस्तबन्धनः॥ ९/७/८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_007/BhP_09.007.082.m4a", "display_order": 83}, {"id": 6000182083, "chapter_id": 10182, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां नवमस्कन्धे सप्तमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}]