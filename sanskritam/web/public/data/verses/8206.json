[{"id": 900001052, "chapter_id": 8206, "verse_number": "5.1", "content_sanskrit": "तदेतदक्षरं ब्रह्म स प्राणस्तदु वाङ् मनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900001053, "chapter_id": 8206, "verse_number": "5.2", "content_sanskrit": "धनुर्गृहीत्वौपनिषदं महास्त्रं शरं ह्युपासानिशितं सन्दधीत", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900001054, "chapter_id": 8206, "verse_number": "5.3", "content_sanskrit": "एतज्जानथ सदसद्वरेण्यं परं विज्ञानाद् यद्वरिष्ठं प्रजानाम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}]