[{"id": 2141894, "chapter_id": 4059, "verse_number": "", "content_sanskrit": "अर्जुनेन पुनः षण्डवेषस्वीकारः । नगरे उत्तरस्य जयघोषचोदना ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2141895, "chapter_id": 4059, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2141896, "chapter_id": 4059, "verse_number": "१", "content_sanskrit": "ततो विजित्य सङ्ग्रामे कुरून् गोवृषभेक्षणः ।\nसमानयामास तदा विराटस्य धनं महत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2141897, "chapter_id": 4059, "verse_number": "२", "content_sanskrit": "गतेषु च प्रभग्नेषु धार्तराष्ट्रेषु सर्वशः ।\nवनान्निष्क्रम्य गहनाद् बहवः कुरुसैनिकाः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2141898, "chapter_id": 4059, "verse_number": "३", "content_sanskrit": "भयात् सन्त्रस्तमनसः समाजग्मुस्ततस्ततः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2141899, "chapter_id": 4059, "verse_number": "४", "content_sanskrit": "मुक्तकेशाः प्रदृश्यन्त स्थिताः प्राञ्जलयस्तदा ।\nक्षुत्पिपासापरिश्रान्ता विदेशस्था विचेतसः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2141900, "chapter_id": 4059, "verse_number": "५", "content_sanskrit": "ऊचुः प्राञ्जलयः सर्वे ब्रूहि किं करवामहे\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2141901, "chapter_id": 4059, "verse_number": "६", "content_sanskrit": "प्राणानन्तर्मनोयातान् प्रयाचिष्यामहे वयम् ।\nवयं चार्जुन ते दासा ह्यनुरक्ष्या ह्यनाथकाः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2141902, "chapter_id": 4059, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2141903, "chapter_id": 4059, "verse_number": "७", "content_sanskrit": "अनाथान् दुःखितान् दीनान् कृशान् वृद्धान् पराजितान् ।\nन्यस्तशस्त्रान् निराशांश्च नाहं हन्मि कृताञ्जलीन्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2141904, "chapter_id": 4059, "verse_number": "८", "content_sanskrit": "भवन्तो यान्तु विस्रब्धा निर्भया ह्यकुतोभयाः ।\nमम पादरजोरक्ष्या जीवन्तु सुचिरं भुवि\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2141905, "chapter_id": 4059, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2141906, "chapter_id": 4059, "verse_number": "९", "content_sanskrit": "तस्य तामभयां वाचं श्रुत्वा योधाः समागताः ।\nआयुःकीर्तियशोभिस्ते तमाशीर्भिरपूजयन्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2141907, "chapter_id": 4059, "verse_number": "१०", "content_sanskrit": "स कर्म कृत्वा परमार्यकर्मा\nनिहत्य शत्रून् द्विषतां निहन्ता ।\nयातो महामेघ इवातपान्ते\nविद्राव्य पार्थः कुरुसैन्यमेकः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2141908, "chapter_id": 4059, "verse_number": "११", "content_sanskrit": "तं मात्स्यपुत्रं द्विषतां निहन्ता\nवचोऽब्रवीत् सम्परिगृह्य राजन्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2141909, "chapter_id": 4059, "verse_number": "१२", "content_sanskrit": "पितुःसकाशे तव तात सर्वे\nवसन्ति पार्था विदितं त्वयेति ।\nतान् मा स्म शंसीर्नगरं प्रविश्य\nभीतः प्रणश्येत् स च मत्स्यराजः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2141910, "chapter_id": 4059, "verse_number": "१३", "content_sanskrit": "मया जिता सा ध्वजिनी कुरूणां\nमया हि गावो विजिता द्विषद्भ्यः ।\nएवं तु कामं नगरं प्रविश्य\nत्वमात्मना कर्म कृतं ब्रवीहि\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2141911, "chapter_id": 4059, "verse_number": "", "content_sanskrit": "उत्तरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2141912, "chapter_id": 4059, "verse_number": "१४", "content_sanskrit": "यत् ते कृतं कर्म नवारणीयं\nतत्कर्म कर्तुं न ममास्ति शक्तिः ।\nन त्वां प्रवक्ष्यामि पितुःसकाशे\nयावन्न मां वक्ष्यसि सव्यसाचिन्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2141913, "chapter_id": 4059, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2141914, "chapter_id": 4059, "verse_number": "१५", "content_sanskrit": "स शत्रुसेनां तरसा विजित्य\nआच्छिद्य सर्वं च धनं कुरूणाम् ।\nश्मशानमागम्य पुनः शमीं ताम्\nअभ्येत्य तस्थौ शरविक्षताङ्गः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2141915, "chapter_id": 4059, "verse_number": "१६", "content_sanskrit": "ततः स वह्निप्रतिमो महाकपिः\nसहैव भूतैर्दिवमुत्पपात ।\nतथैव माया विहिता बभूव\nध्वजं च सिंहं युयुजे रथे पुनः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2141916, "chapter_id": 4059, "verse_number": "१७", "content_sanskrit": "निधाय तच्चायुधमाजिमर्दनः\nकुरूत्तमानामिषुधीन् ध्वजांस्तदा ।\nप्रायात् स मात्स्यो नगरं प्रवेष्टुं\nकिरीटिना सारथिना महात्मा\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2141917, "chapter_id": 4059, "verse_number": "१८", "content_sanskrit": "पार्थश्च कृत्वा परमार्यकर्म\nनिहत्य शत्रून् द्विषतां निहन्ता ।\nविधाय भूयश्च तथैव वेषं\nजग्राह रश्मीन् पुनरुत्तरस्य\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2141918, "chapter_id": 4059, "verse_number": "१९", "content_sanskrit": "बृहन्नळावेषमथो विधाय\nप्रायात् स मात्स्यं नगरं प्रवेष्टुम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2141919, "chapter_id": 4059, "verse_number": "२०", "content_sanskrit": "यथामार्गं च दुःखार्ता जग्मुस्ते हृतवाससः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2141920, "chapter_id": 4059, "verse_number": "२१", "content_sanskrit": "यतो निवृत्ताः कुरवः प्रभग्ना शममास्थिताः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2141921, "chapter_id": 4059, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2141922, "chapter_id": 4059, "verse_number": "२२", "content_sanskrit": "राजपुत्र प्रपद्यस्व समानीतानि सर्वशः ।\nगोकुलानि महाबाहो वीर गोपालकैः सह\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2141923, "chapter_id": 4059, "verse_number": "२३", "content_sanskrit": "ततोऽपराह्णे यास्यामो विराटनगरं प्रति ।\nआश्वास्य पाययित्वा च परिप्लाव्य च वाजिनः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2141924, "chapter_id": 4059, "verse_number": "२४", "content_sanskrit": "गच्छन्तु त्वरितं दूता गोपालाः प्रेषितास्त्वया ।\nनगरे प्रियमाख्यातुं घोषयन्तु च ते जयम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2141925, "chapter_id": 4059, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2141926, "chapter_id": 4059, "verse_number": "२५", "content_sanskrit": "उत्तरस्त्वरमाणोऽथ दूतानाज्ञापयत् तदा ।\nवचनादर्जुनस्यैव व्याचक्षध्वं जयं मम \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2141927, "chapter_id": 4059, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां विराटपर्वणि सप्तषष्टितमोऽध्यायः ॥६७॥ गोग्रहणपर्वणि चत्वारिंशोऽध्यायः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]