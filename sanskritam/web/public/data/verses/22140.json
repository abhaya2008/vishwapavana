[{"id": 7002140000, "chapter_id": 22140, "verse_number": "१८५-१", "content_sanskrit": "अथ नवमीव्रतानि ।\nअग्निरुवाच ।\nनवमीव्रतकं वक्ष्ये भुक्तिमुक्त्यादिसिद्धिदं ।\nदेवी पूज्याश्विने शुक्ले गौर्याख्यानवमीव्रतं ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002140001, "chapter_id": 22140, "verse_number": "१८५-२", "content_sanskrit": "पिष्टकाख्या तु नवमी पिष्टाशी देवपूजनात् ।\nअष्टम्यामाश्विने शुक्ले कन्यार्कमूलभे यदा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002140002, "chapter_id": 22140, "verse_number": "१८५-३", "content_sanskrit": "अघार्दना सर्वदा वै महती नवमी स्मृता ।\nदुर्गा तु नवगेहस्था एकागारस्थिताथवा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002140003, "chapter_id": 22140, "verse_number": "१८५-४", "content_sanskrit": "पूजिताष्टादशभुजा शेषाः षोडशसत्कराः ।\nशेषाः षोडशहस्ताः स्युरञ्जनं डमरुं तथा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002140004, "chapter_id": 22140, "verse_number": "१८५-५", "content_sanskrit": "रुद्रचण्डा प्रचण्डा च चण्डोग्रा चण्डनायिका ।\nचण्डा चण्डवती पूज्या चण्डरूपातिचण्डिका ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002140005, "chapter_id": 22140, "verse_number": "१८५-६", "content_sanskrit": "क्रमान्मध्ये चोग्रचण्डा दुर्गा महिषमर्दिनी ।\nॐ दुर्गे दुर्गरक्षणि स्वाहा दशाक्षरो मन्त्रः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002140006, "chapter_id": 22140, "verse_number": "१८५-७", "content_sanskrit": "दीर्घाकारादिमन्त्रादिर्नवनेत्रो नमोऽन्तकः ।\nषड्भिः पदैर्नमःस्वधा वषट्कारहृदादिकं ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002140007, "chapter_id": 22140, "verse_number": "१८५-८", "content_sanskrit": "अङ्गुष्ठादिकनिष्ठान्तं न्यस्याङ्गानि जपेच्छिवां ।\nएवं जपति यो गुह्यं नासौ केनापि बाध्यते ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002140008, "chapter_id": 22140, "verse_number": "१८५-९", "content_sanskrit": "कपालं खेटकं घण्टां दर्पणं तर्ज्जनीं धनुः ।\nध्वजं डमरुकं पाशं वामहस्तेषु बिभ्रतीम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002140009, "chapter_id": 22140, "verse_number": "१८५-१०", "content_sanskrit": "शक्तिमुद्गरशूलानि वज्रं खड्गञ्च कुन्तकं ।\nशङ्खं चक्रं शलाकां च आयुधानि च पूजयेत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002140010, "chapter_id": 22140, "verse_number": "१८५-११", "content_sanskrit": "पशुञ्च काली कालीति जप्त्वा खड्गेन घातयेत् ।\nकालि कालि वज्रेश्वरि लौहदण्डायै नमः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002140011, "chapter_id": 22140, "verse_number": "१८५-१२", "content_sanskrit": "तदुत्थं रुधिरं मांसं पूतनायै च नैरृते ।\nवायव्यां पापराक्षस्यै चरक्यै नम ईश्वरे ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002140012, "chapter_id": 22140, "verse_number": "१८५-१३", "content_sanskrit": "विदारिकायै चाग्नेय्यां महाकौशिकमग्नये ।\nतस्याग्रतो नृपः स्नायाच्छत्रुं पिष्टमयं हरेत् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002140013, "chapter_id": 22140, "verse_number": "१८५-१४", "content_sanskrit": "दद्यात्स्कन्दविशाखाभ्यां ब्राह्म्याद्या निशि ता यजेत् ।\nजयन्ती मङ्गला काली भद्रकाली कपालिनी ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002140014, "chapter_id": 22140, "verse_number": "१८५-१५", "content_sanskrit": "दुर्गा शिवा क्षमा धात्री स्वाहा स्वधा नमोऽस्तु ते ।\nदेवीं पञ्चामृतैः स्नाप्य पूजयेच्चार्हणादिना ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]