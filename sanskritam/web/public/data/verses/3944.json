[{"id": 2135754, "chapter_id": 3944, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2135755, "chapter_id": 3944, "verse_number": "१", "content_sanskrit": "जयद्रथस्तु सम्प्रेक्ष्य भ्रातरावुद्यतावुभौ ।\nप्राधावत् तूर्णमव्यग्रो जीवितेप्सुः सुदुःखितः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2135756, "chapter_id": 3944, "verse_number": "२", "content_sanskrit": "लताभिः संवृते कक्षे किरीटं रत्नभास्वरम् ।\nअपविध्य प्रधावन्तं निलीयन्तं वनान्तरे\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2135757, "chapter_id": 3944, "verse_number": "३", "content_sanskrit": "भीमसेनस्तु तं कक्षे नीयमानं भयाकुलम् ।\nमार्गमाणोऽवतीर्याशु रथाद् रत्नविभूषितात्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2135758, "chapter_id": 3944, "verse_number": "४", "content_sanskrit": "तं भीमसेनो धावन्तमवतीर्य रथाद् बली ।\nअभिद्रुत्य निजग्राह केशपक्षे ह्यमर्षणः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2135759, "chapter_id": 3944, "verse_number": "५", "content_sanskrit": "समुद्यम्य च तं भीमो निष्पिपेष महीतळे ।\nशिरो गृहीत्वा राजानं ताडयामास चैव हि \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2135760, "chapter_id": 3944, "verse_number": "६", "content_sanskrit": "पुनः सञ्जीवमानस्य तस्योत्पतितुमिच्छतः ।\nपदा मूर्घ्नि महाबाहुः प्राहरद् विलपिष्यतः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2135761, "chapter_id": 3944, "verse_number": "७", "content_sanskrit": "तस्य जानू ददौ भीमो जघ्ने चैनमरत्निना ।\nस मोहमगमद् राजा प्रहारवरपीडितः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2135762, "chapter_id": 3944, "verse_number": "८", "content_sanskrit": "सरोषं भीमसेनं तु वारयामास फल्गुनः।\nदुःशलायाः कृते राजा यत् तदाहेति कौरवः(व) \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2135763, "chapter_id": 3944, "verse_number": "", "content_sanskrit": "भीमसेनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2135764, "chapter_id": 3944, "verse_number": "९", "content_sanskrit": "नायं पापसमाचारो मत्तो जीवितुमर्हति ।\nकृष्णायास्तदनर्हायाः परिक्लेष्टा नराधमः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2135765, "chapter_id": 3944, "verse_number": "१०", "content_sanskrit": "किं नु शक्यं मया कर्तुं यद् राजा सततं घृणी ।\nत्वं च बालिशया बुद्ध्या सदैवास्मान् प्रबाधसे \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2135766, "chapter_id": 3944, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2135767, "chapter_id": 3944, "verse_number": "११", "content_sanskrit": "एवमुक्त्वा सटास्तस्य पञ्च चक्रे वृकोदरः ।\nअर्धचन्द्रेण बाणेन किञ्चिदब्रुवतस्तदा ।\nविकल्पयित्वा राजानं ततः प्राह वृकोदरः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2135768, "chapter_id": 3944, "verse_number": "", "content_sanskrit": "भीमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2135769, "chapter_id": 3944, "verse_number": "१२", "content_sanskrit": "जीवितुं चेच्छसे मूढ हेतुं मे गदतः शृणु \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2135770, "chapter_id": 3944, "verse_number": "१३", "content_sanskrit": "तं तथा न विचेष्टन्तमबुध्वाप वृकोदरः ।\nदासोऽस्मीति तथा वाच्यं संसत्सु च सभासु च ।\nएवं चेज्जीवितं दद्यां एष युद्धजितो विधिः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2135771, "chapter_id": 3944, "verse_number": "", "content_sanskrit": "वैशम्पायनः-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2135772, "chapter_id": 3944, "verse_number": "१४", "content_sanskrit": "एवमस्त्विति तं राजा कृष्यमाणो जयद्रथः ।\nप्रोवाच पुरुषव्याघ्रं भीममाहवशोभिनम् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2135773, "chapter_id": 3944, "verse_number": "१५", "content_sanskrit": "तत एनं विचेष्टन्तं बद्ध्वा पार्थो वृकोदरः ।\nरथमारोपयामास विसञ्ज्ञं पांसुगुण्ठितम् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2135774, "chapter_id": 3944, "verse_number": "१६", "content_sanskrit": "ततस्तं रथमास्थाय भीमः पार्थानुगस्तदा ।\nअभ्येत्याश्रममध्यस्थमभ्यगच्छद् युधिष्ठिरम् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2135775, "chapter_id": 3944, "verse_number": "१७", "content_sanskrit": "दर्शयामास भीमस्तु तदवस्थं जयद्रथम् ।\nस(तं) राजा प्राहसद् दृष्ट्वा मुच्यतामिति चाब्रवीत्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2135776, "chapter_id": 3944, "verse_number": "१८", "content_sanskrit": "राजानं चाब्रवीद् भीमो द्रौपद्याः कथ्यतामिति ।\nदासभावगतो ह्येष पाण्डूनां पापचेतनः ।\nतमुवाच ततो ज्येष्ठो भ्राता सप्रणयं वचः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2135777, "chapter_id": 3944, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2135778, "chapter_id": 3944, "verse_number": "", "content_sanskrit": "मुञ्चैनमधमाचारं प्रमाणा यदि ते वयम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2135779, "chapter_id": 3944, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2135780, "chapter_id": 3944, "verse_number": "१९", "content_sanskrit": "द्रौपदी चाब्रवीद् भीममभिप्रेक्ष्य युधिष्ठिरम् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2135781, "chapter_id": 3944, "verse_number": "", "content_sanskrit": "द्रौपदी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2135782, "chapter_id": 3944, "verse_number": "२०", "content_sanskrit": "दासोऽयं मुच्यतां राज्ञस्त्वया पञ्चसटः कृतः ।\nएवमुक्तः स भीमस्तु भ्रात्रा चैव च कृष्णया ।\nमुमोच तं महापापं जयद्रथमचेतसम् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2135783, "chapter_id": 3944, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2135784, "chapter_id": 3944, "verse_number": "२१", "content_sanskrit": "स मुक्तोऽभ्येत्य राजानमभिवाद्य युधिष्ठिरम् ।\nववन्दे विह्वलो राजंस्तांश्च दृष्ट्वा मुनींस्तदा \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2135785, "chapter_id": 3944, "verse_number": "२२", "content_sanskrit": "तमुवाच घृणी राजा धर्मपुत्रो युधिष्ठिरः ।\nतथा जयद्रथं दृष्ट्वा गृहीतं सव्यसाचिना \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2135786, "chapter_id": 3944, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2135787, "chapter_id": 3944, "verse_number": "२३", "content_sanskrit": "अदासो गच्छ मुक्तोऽसि मैवं कार्षीः पुनः क्वचित् ।\nस्त्रीकामुक धिगस्तु त्वां क्षुद्रः क्षुद्रसहायवान् \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2135788, "chapter_id": 3944, "verse_number": "२४", "content_sanskrit": "एवंविधं हि कः कुर्यात् त्वदन्यः पुरुषाधमः ।\nकर्म धर्मविरुद्धं वै लोकदुष्टं च दुर्मते(कर्म ते) \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2135789, "chapter_id": 3944, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2135790, "chapter_id": 3944, "verse_number": "२५", "content_sanskrit": "गतसत्त्वमिव ज्ञात्वा कर्तारमशुभस्य तम् ।\nत(स)म्प्रेक्ष्य भरतश्रेष्ठः कृपां चक्रे नराधिपः \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2135791, "chapter_id": 3944, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2135792, "chapter_id": 3944, "verse_number": "२६", "content_sanskrit": "धर्मे ते वर्धतां बुद्धिः क्षुद्रधर्मे मनः कृथाः ।\nसाश्वः सरथपादातः स्वस्ति गच्छ जयद्रथ \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2135793, "chapter_id": 3944, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2135794, "chapter_id": 3944, "verse_number": "२७", "content_sanskrit": "एवमुक्तस्तु सव्रीळं तूष्णीं किञ्चिदवाङ्मुखः।\nजगाम राजन् दुःखार्तो गङ्गाद्वाराय भारत \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2135795, "chapter_id": 3944, "verse_number": "२८", "content_sanskrit": "स देवं शरणं गत्वा विरूपाक्षमुमापतिम् ।\nनिराहारो जितक्रोधः पादाङ्गुष्ठाग्रविष्ठितः ।\nतपश्चचार विपुलं तस्य प्रीतो वृषध्वजः \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2135796, "chapter_id": 3944, "verse_number": "२९", "content_sanskrit": "बलिं स्वयं प्रत्यगृह्णात् प्रीयमाणस्त्रिलोचनः ।\nवरं चास्मै ददौ देवः स जग्राह च तच्छ्रुणु \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2135797, "chapter_id": 3944, "verse_number": "", "content_sanskrit": "जयद्रथः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2135798, "chapter_id": 3944, "verse_number": "३०", "content_sanskrit": "समस्तान् सरथान् पञ्च जयेयं युधि पाण्डवान् \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2135799, "chapter_id": 3944, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2135800, "chapter_id": 3944, "verse_number": "समाप्तिः", "content_sanskrit": "इति राजाऽब्रवीद् देवं नेति देवस्तमब्रवीत् \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2135801, "chapter_id": 3944, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2135802, "chapter_id": 3944, "verse_number": "३२", "content_sanskrit": "अजय्यांश्चाप्यवध्यांश्च वारयिष्यसि तान् युधि ।\nऋतेऽर्जुनं महाबाहुं नरं नाम सुरेश्वरम् \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2135803, "chapter_id": 3944, "verse_number": "३३", "content_sanskrit": "अजितं सर्वलोकानां देवैरपि दुरासदम् ।\nमया दत्तं पाशुपतं दिव्यमप्रतिमं शरम् ।\nअवाप लोकपालेभ्यो वज्रादीन् स महाशरान् \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2135804, "chapter_id": 3944, "verse_number": "३४", "content_sanskrit": "देवदेवो ह्यनन्तात्मा विष्णुः सुरगुरुः प्रभुः ।\nप्रधानपुरुषोऽव्यक्तो विश्वात्मा विश्वमूर्तिमान् \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2135805, "chapter_id": 3944, "verse_number": "३५", "content_sanskrit": "युगान्तकाले सम्प्राप्ते कालाग्निर्दहते जगत् ।\nसपर्वतार्णवद्वीपं सशैलवनकाननम् \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2135806, "chapter_id": 3944, "verse_number": "३६", "content_sanskrit": "निर्दहन्नागलोकांश्च पाताळतळचारिणः ।\nअथान्तरिक्षे सुमहन्नानावर्णाः पयोधराः \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2135807, "chapter_id": 3944, "verse_number": "३७", "content_sanskrit": "घोरस्वरा विनदिनस्तडिन्मालावलम्बिनः ।\nसमुत्तिष्ठन् दिशः सर्वा विवर्षन्तः समन्ततः \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2135808, "chapter_id": 3944, "verse_number": "३८", "content_sanskrit": "ततोऽग्निं नाशयामासुः संवर्ताग्निनियामकाः ।\nअक्षमात्रैश्च धाराभिस्तिष्ठन्त्यापूर्य सर्वशः \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2135809, "chapter_id": 3944, "verse_number": "३९", "content_sanskrit": "एकार्णवे तदा तस्मिन्नुपशान्तचराचरे ।\nनष्टचन्द्रार्कपवने ग्रहनक्षत्रवर्जिते \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2135810, "chapter_id": 3944, "verse_number": "४०", "content_sanskrit": "चतुर्युगसहस्रान्ते सलिलेनाप्लुता मही ।\nततो नारायणाख्यस्तु सहस्राक्षः सहस्रपात् \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2135811, "chapter_id": 3944, "verse_number": "४१", "content_sanskrit": "सहस्रशीर्षा पुरुषः स्वप्तुकामस्त्वतीन्द्रियः ।\nफटासहस्रविकटं शेषं पर्यङ्कभाजनम् \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2135812, "chapter_id": 3944, "verse_number": "४२", "content_sanskrit": "सहस्रमिव तिग्मांशुसङ्घातममितद्युतिम् ।\nकुन्देन्दुहारगोक्षीरमृणालकुमुदप्रभम् \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2135813, "chapter_id": 3944, "verse_number": "४३", "content_sanskrit": "तत्रासौ भगवान् देवः स्वपन् जलनिधौ तदा ।\nनैशेन तमसा व्याप्तां स्वां रात्रिं कुरुते विभुः \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2135814, "chapter_id": 3944, "verse_number": "४४", "content_sanskrit": "सत्त्वोद्रेकात् प्रबुद्धस्तु शून्यं लोकमपश्यत ।\nइमं चोदाहरन्त्यत्र श्लोकं नारायणं प्रति \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2135815, "chapter_id": 3944, "verse_number": "४५", "content_sanskrit": "आपो नारास्तु(स्त)त्तनव इत्यपां नाम शुश्रुम ।\nअयनं तेन चैवास्ते तेन नारायणः स्मृतः \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2135816, "chapter_id": 3944, "verse_number": "४६", "content_sanskrit": "प्रध्यानसमकालं तु प्रजाहेतोः सनातनः ।\nध्यातमात्रे तु भगवन्नाभ्यां पद्मः समुत्थितः \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2135817, "chapter_id": 3944, "verse_number": "४७", "content_sanskrit": "तत्तश्चतुर्मुखो ब्रह्मा नाभिपद्माद् विनिःसृतः ।\nतत्रोपविष्टः सहसा पद्मे लोकपितामहः \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2135818, "chapter_id": 3944, "verse_number": "४८", "content_sanskrit": "शून्यं दृष्ट्वा जगत्कृत्स्नं मानसानात्मनः समान् ।\nततो मरीचिप्रमुखान् महर्षीनसृजन्नव \t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2135819, "chapter_id": 3944, "verse_number": "४९", "content_sanskrit": "ते भूत्वा सर्वभूतानि त्रस्थानि स्थावराणि च ।\nयक्षराक्षसभूतानि पिशाचोरगमानुषान् \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2135820, "chapter_id": 3944, "verse_number": "५०", "content_sanskrit": "सृज्यते बह्ममूर्तिस्तु रक्षते पौरुषी तनुः ।\nरौद्रीभावेन शमयेत्तिस्रोऽवस्थाः प्रजापतेः \t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2135821, "chapter_id": 3944, "verse_number": "५१", "content_sanskrit": "न श्रुतं ते सिन्धुपते विष्णोरद्भुतकर्मणः ।\nकथ्यमानानि मुनिभिर्ब्राह्मणैर्वेदपारगैः \t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2135822, "chapter_id": 3944, "verse_number": "५२", "content_sanskrit": "जलेन समनुप्राप्ते सर्वतः पृथिवीतळे ।\nतदा चैकार्णवे तस्मिन्नेकाकाशे प्रभुश्चरन् \t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2135823, "chapter_id": 3944, "verse_number": "५३", "content_sanskrit": "निशायामिव खद्योतः प्रावृट्काले समन्ततः ।\nप्रतिष्ठानाय पृथिवीं मार्गमाणस्तदाभवत् \t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2135824, "chapter_id": 3944, "verse_number": "५४", "content_sanskrit": "जले निमग्नां गां दृष्ट्वा चोद्धर्तुं मनसेच्छति ।\nकिं नु रूपमहं कृत्वा सलिलादुद्धरे महीम् \t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2135825, "chapter_id": 3944, "verse_number": "५५", "content_sanskrit": "एवं सञ्चिन्त्य मनसा दृष्ट्वा दिव्येन चक्षुषा ।\nजलक्रीडाभिरुचितं वाराहं रूपमस्मरत् \t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2135826, "chapter_id": 3944, "verse_number": "५६", "content_sanskrit": "कृत्वा वराहवपुषं वाङ्मयं वेदसम्मितम् ।\nदशयोजनविस्तीर्णमायतं शतयोजनम् \t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2135827, "chapter_id": 3944, "verse_number": "५७", "content_sanskrit": "महापर्वतवर्ष्माभं तीक्ष्णदंष्ट्रं प्रदीप्तिमत् ।\nमहामेघौघनिर्घोषं नीलजीमूतसंनिभम् \t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2135828, "chapter_id": 3944, "verse_number": "५८", "content_sanskrit": "भूत्वा यज्ञवराहो वै अपः सम्प्राविशत् प्रभुः ।\nदंष्ट्रेणैकेन चोद्धृत्य स्वे स्थाने न्यविशन्महीम् \t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2135829, "chapter_id": 3944, "verse_number": "५९", "content_sanskrit": "पुनरेव महाबाहुरपूर्वां तनुमाश्रितः ।\nनरस्य कृत्वार्धतनुं सिंहस्यार्धतनुं प्रभुः \t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2135830, "chapter_id": 3944, "verse_number": "६०", "content_sanskrit": "दैत्येन्द्रस्य सभां गत्वा पाणिं संस्पृश्य पाणिना ।\nदैत्यानामादिपुरुषः सुरारिर्दितिनन्दनः \t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2135831, "chapter_id": 3944, "verse_number": "६१", "content_sanskrit": "दृष्ट्वा चापूर्वपुरुषं क्रोधात् संरक्तलोचनः ।\nशूलोद्यतकरः स्रग्वी हिरण्यकशिपुस्तदा \t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2135832, "chapter_id": 3944, "verse_number": "६२", "content_sanskrit": "मेघस्तनितनिर्घोषो नीलाभ्रचयसंनिभः ।\nदेवारिर्दितिजो वीरो नृसिंहं समुपाद्रवत् \t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2135833, "chapter_id": 3944, "verse_number": "६३", "content_sanskrit": "समुपेत्य ततस्तीक्ष्णैर्मृगेन्द्रेण बलीयसा ।\nनारसिंहेन वपुषा दारितः करजैर्भृशम् \t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2135834, "chapter_id": 3944, "verse_number": "६४", "content_sanskrit": "एवं निहत्य भगवान् दैत्येन्द्रं रिपुघातिनम् ।\nभूयोऽन्यः पुण्डरीकाक्षः प्रभुर्लोकहिताय च \t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2135835, "chapter_id": 3944, "verse_number": "६५", "content_sanskrit": "कश्यपस्यात्मजः श्रीमानदित्या गर्भधारितः ।\nपूर्णे वर्षसहस्रे तु प्रसूता गर्भमुत्तमम् \t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2135836, "chapter_id": 3944, "verse_number": "६६", "content_sanskrit": "दुर्दिनाम्भोदसदृशो दीप्ताक्षो वामनाकृतिः ।\nदण्डी कमण्डलुधरः श्रीवत्सोरसि भूषितः \t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2135837, "chapter_id": 3944, "verse_number": "६७", "content_sanskrit": "जटी यज्ञोपवीती च भगवान् बालरूपधृक् ।\nयज्ञवाटं गतः श्रीमान्दानवेन्द्रस्य वै तदा \t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2135838, "chapter_id": 3944, "verse_number": "६८", "content_sanskrit": "बृहस्पतिसहायोऽसौ प्रविष्टो बलिनो मखे ।\nतं दृष्ट्वा वामनतनुं प्रहृष्टो बलिरब्रवीत् \t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2135839, "chapter_id": 3944, "verse_number": "६९", "content_sanskrit": "प्रीतोऽस्मि दर्शने विप्र ब्रूहि त्वं किं ददानि ते ।\nएवमुक्तस्तु बलिना वामनः प्रत्युवाच ह \t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2135840, "chapter_id": 3944, "verse_number": "७०", "content_sanskrit": "स्वस्तीत्युक्त्वा बलिं देवः स्मयमानोऽभ्यभाषत ।\nमेदिनीं दानवपते देहि मे विक्रमत्रयम् \t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2135841, "chapter_id": 3944, "verse_number": "७१", "content_sanskrit": "बलिर्ददौ प्रसन्नात्मा विप्रायामिततेजसे ।\nततो दिव्याद्भुततमं रूपं विक्रमतो हरेः \t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2135842, "chapter_id": 3944, "verse_number": "७२", "content_sanskrit": "विक्रमैस्त्रिभिरक्षोभ्यो जहाराशु स मेदिनीम् ।\nददौ शक्राय च महीं विष्णुर्देवः सनातनः \t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2135843, "chapter_id": 3944, "verse_number": "७३", "content_sanskrit": "एष ते वामनो नाम प्रादुर्भावः प्रकीर्तितः ।\nतेन देवाः प्रादुरासन् वैष्णवं चोच्यते जगत् \t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2135844, "chapter_id": 3944, "verse_number": "७४", "content_sanskrit": "असतां निग्रहार्थाय धर्मसंरक्षणाय च ।\nअवतीर्णो मनुष्याणामजायत यदुक्षये \t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2135845, "chapter_id": 3944, "verse_number": "७५", "content_sanskrit": "स एवं भगवान् विष्णुः कृष्णेति परिकीर्त्यते ।\nअनाद्यन्तमजं देवं प्रभुं लोकनमस्कृतम् \t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2135846, "chapter_id": 3944, "verse_number": "७६", "content_sanskrit": "यं देवं विदुषो गान्ति तस्य कर्माणि सैन्धव ।\nयमाहुरजितं कृष्णं शङ्खचक्रगदाधरम्\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2135847, "chapter_id": 3944, "verse_number": "७७", "content_sanskrit": "श्रीवत्सधारिणं देवं पीतकौशेयवाससम् ।\nप्रधानः सोऽस्त्रविदुषां तेन कृष्णेन रक्ष्यते \t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2135848, "chapter_id": 3944, "verse_number": "७८", "content_sanskrit": "सहायः पुण्डरीकाक्षः श्रीमानतुलविक्रमः ।\nसमानस्यन्दने पार्थमास्थाय परवीरहा\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2135849, "chapter_id": 3944, "verse_number": "७९", "content_sanskrit": "न शक्यते तेन जेतुं त्रिदशैरपि दुःसहः ।\nकः पुनर्मानुषो भावो रणे पार्थं विजेष्यति\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2135850, "chapter_id": 3944, "verse_number": "८०", "content_sanskrit": "तमेकं वर्जयित्वा तु सर्वं यौधिष्ठिरं बलम् ।\nचतुरः पाण्डवान् राजन्दिनेकं जेष्यसे रिपून् \t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2135851, "chapter_id": 3944, "verse_number": "८१", "content_sanskrit": "तस्मात् त्वं पार्थरहितान् पाण्डवान् वारयिष्यसि ।\nएकदा पुरुषव्याघ्र मया दत्तं वरं तव\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2135852, "chapter_id": 3944, "verse_number": "८२", "content_sanskrit": "सहायः पुण्डरीकाक्षः श्रीमानतुलविक्रमः ।\nसमानस्यन्दने पार्थमास्थाय परवीरहा\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2135853, "chapter_id": 3944, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2135854, "chapter_id": 3944, "verse_number": "८३", "content_sanskrit": "इत्येवमुक्त्वा नृपतिं सर्वपापहरो हरः ।\nउमापतिः पशुपतिर्यज्ञहा त्रिपुरार्दनः\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2135855, "chapter_id": 3944, "verse_number": "८४", "content_sanskrit": "वामनैर्विकटैः कुब्जैरुग्रश्रवणदर्शनैः ।\nवृतः पारिषदैर्घोरैर्नानाप्रहरणोद्यनः(तैः)\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2135856, "chapter_id": 3944, "verse_number": "८५", "content_sanskrit": "त्र्यम्बको राजशार्दूल भगनेत्रनिपातनः ।\nउमासहायो भगवांस्तत्रैवान्तरधीयत\t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2135857, "chapter_id": 3944, "verse_number": "८६", "content_sanskrit": "जयद्रथोऽपि मन्दात्मा स्वमेव भवनं ययौ ।\nपाण्डवाश्च वने तस्मिन् न्यवसन् काम्यके तथा ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2135858, "chapter_id": 3944, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि जयद्रथविमोक्षणपर्वणि षष्ट्यधिकद्विशततमोऽध्यायः ॥२६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2135859, "chapter_id": 3944, "verse_number": "९", "content_sanskrit": "द्रौपदीहरणपर्वणि नवमोऽध्यायः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2135860, "chapter_id": 3944, "verse_number": "", "content_sanskrit": "॥ समाप्तं द्रौपदीहरणपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2135861, "chapter_id": 3944, "verse_number": "", "content_sanskrit": "––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}]