[{"id": 2061795, "chapter_id": 2320, "verse_number": "८-४१-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2061796, "chapter_id": 2320, "verse_number": "८-४१-१", "content_sanskrit": "ततः परानीकभिदं व्यूहमप्रतिमं महत्।\nसमीक्ष्य कर्णः पार्थानां धृष्टद्युम्नाभिरक्षितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2061797, "chapter_id": 2320, "verse_number": "८-४१-२", "content_sanskrit": "प्रययौ रथघोषेण सिंहनादरवेण च।\nवादित्राणां च निनदैः कम्पयन्निव मेदिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2061798, "chapter_id": 2320, "verse_number": "८-४१-३", "content_sanskrit": "वेपमान इव क्रोधाद्युद्वशौण्डः परन्तपः।\nप्रतिव्यूह्य महातेजा यथावद्भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2061799, "chapter_id": 2320, "verse_number": "८-४१-४", "content_sanskrit": "व्यधमत्पाण्डवीं सेनामासुरीं मघवानिव।\nयुधिष्ठिरं चाभ्यहनदपसव्यं चकारह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2061800, "chapter_id": 2320, "verse_number": "८-४१-५", "content_sanskrit": "कर्णस्य रथघोषेण मौर्वीनिष्पेषणेन च।\nसुसङ्ग्राहेण रश्मीनां समकम्पन्त सृञ्जयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2061801, "chapter_id": 2320, "verse_number": "८-४१-६", "content_sanskrit": "तानि सर्वाणि सैन्यानि कर्ण दृष्ट्वा विशाम्पते।\nबभूवुः सम्प्रहृष्टानि तावकानि युयुत्सया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2061802, "chapter_id": 2320, "verse_number": "८-४१-७", "content_sanskrit": "अश्रूयन्त ततो वाचस्तावकानां विशाम्पते।\nकर्णार्जुनमहायुद्धमेतदद्य भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2061803, "chapter_id": 2320, "verse_number": "८-४१-८", "content_sanskrit": "अद्य दुर्योधनो राजा हतामित्रो भविष्यति।\nअद्य कर्णं रणे दृष्ट्वा फल्गुनो विद्रविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2061804, "chapter_id": 2320, "verse_number": "८-४१-९", "content_sanskrit": "अद्य तावद्वयं युद्धे कर्णस्यैवानुगामिनः।\nकर्णबाणमयं भीमं युद्धं द्रक्ष्याम संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2061805, "chapter_id": 2320, "verse_number": "८-४१-१०", "content_sanskrit": "चिरकालेप्सितमिदमद्येदानीं भविष्यति।\nअद्य द्रक्ष्याम सङ्ग्रामं घोरं देवासुरोपमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2061806, "chapter_id": 2320, "verse_number": "८-४१-११", "content_sanskrit": "अद्येदानीं महद्युद्धं भविष्यति भयानकम्।\nअद्येदानीं जयो नित्यमेकस्यैकस्य वा रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2061807, "chapter_id": 2320, "verse_number": "८-४१-१२", "content_sanskrit": "अर्जुनं किल राधेयो वधिष्यति महारणे।\nअथवा कं नरं लोके न स्पृशन्ति मनोरथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2061808, "chapter_id": 2320, "verse_number": "८-४१-१३", "content_sanskrit": "इत्युक्त्वा विविधा वाचः कुरवः कुरुनन्दन।\nआजघ्नुः पटहांश्चैव तूर्यांश्चैव सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2061809, "chapter_id": 2320, "verse_number": "८-४१-१४", "content_sanskrit": "भेरीनादांश्च विविधान्सिंहनादांश्च पुष्कलान्।\nमुरजानां महाशब्दानानकानां महारवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2061810, "chapter_id": 2320, "verse_number": "८-४१-१५", "content_sanskrit": "नृत्यमानाश्च बहुशस्तर्जमानाश्च मारिष।\nअन्योन्यमभ्ययुर्युद्धे युद्धरङ्गगता नराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2061811, "chapter_id": 2320, "verse_number": "८-४१-१६", "content_sanskrit": "तेषां पदाता नागानां पादरक्षाः समन्ततः।\nपट्टसासिधराः शूराश्चापबाणमुसुण्ठिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2061812, "chapter_id": 2320, "verse_number": "८-४१-१७", "content_sanskrit": "भिण्डिपालधराश्चैव शूरलहस्ताः सुचक्रिणः।\nतेषां समागमो घोरो देवासुररणोपमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2061813, "chapter_id": 2320, "verse_number": "८-४१-१८x", "content_sanskrit": "धृतराष्ट्रं उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2061814, "chapter_id": 2320, "verse_number": "८-४१-१८", "content_sanskrit": "कथं सञ्जय राधेयः प्रत्यव्यूहत पाण्डवान्।\nधृष्टद्युम्नमुखान्सङ्ख्ये भीमसेनाभिरक्षितान्।\nसर्वानेव महेष्वासानजय्यानमरैरपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2061815, "chapter_id": 2320, "verse_number": "८-४१-१९", "content_sanskrit": "के च प्रपक्षौ पक्षौ वा मम सैन्यस्य सञ्जय।\nप्रविभज्य यथान्यायमवतस्थुः सुदंशिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2061816, "chapter_id": 2320, "verse_number": "८-४१-२०", "content_sanskrit": "कथं पाण्डुसुताश्चापि प्रत्यव्यूहन्त मामकान्।\nकथं चैतन्महद्युद्धं प्रावर्तत सुदारुणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2061817, "chapter_id": 2320, "verse_number": "८-४१-२१", "content_sanskrit": "क्व च बीभत्सुरभवद्यत्कर्णोऽयाद्युधिष्ठिरम्।\nको ह्यर्जुनस्य सान्निध्ये शक्तो जेतुं युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2061818, "chapter_id": 2320, "verse_number": "८-४१-२२", "content_sanskrit": "सर्वभूतानि यो ह्येकः खाण्डवे जितबान्पुरा।\nकस्तमन्यस्तु राधेयात्प्रतियुध्येज्जिजीविषुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2061819, "chapter_id": 2320, "verse_number": "८-४१-२३x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2061820, "chapter_id": 2320, "verse_number": "८-४१-२३", "content_sanskrit": "शृणु व्यूहस्य रचनामर्जुनश्च यथा गतः।\nपरिवार्य नृपान्सर्वान्सङ्ग्रामश्चाभवद्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2061821, "chapter_id": 2320, "verse_number": "८-४१-२४", "content_sanskrit": "कृपः शारद्वतो राजन्मागधाश्च तरस्विनः।\nसात्वतः कृतवर्मा च दक्षिणं पक्षमाश्रिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2061822, "chapter_id": 2320, "verse_number": "८-४१-२५", "content_sanskrit": "तेषां प्रपक्षे शकुनिरुलूकश्च महारथः।\nसादिभिर्विमलप्रासैस्तदानीमभ्यरक्षताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2061823, "chapter_id": 2320, "verse_number": "८-४१-२६", "content_sanskrit": "गान्धारैश्चाप्यसम्भ्रान्तैः पार्वतीयैश्च दुर्जयैः।\nशलभानामिव व्रातैः पिशाचैरिव दुर्दृशैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2061824, "chapter_id": 2320, "verse_number": "८-४१-२७", "content_sanskrit": "चतुर्विंशत्सहस्राणि रथानामनिवर्तिनाम्।\nसंशप्तका युद्वशौण्डा वामपाश्वमपालयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2061825, "chapter_id": 2320, "verse_number": "८-४१-२८", "content_sanskrit": "समन्वितास्तव सुतैः कृष्णार्जुनजिघांसवः।\nतेषां प्रपक्षाः काम्भोजाः शकाश्च यवनैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2061826, "chapter_id": 2320, "verse_number": "८-४१-२९", "content_sanskrit": "निदेशात्सूतपुत्रस्य सरथाश्वेभपत्तयः।\nआह्वयन्तोऽर्जुनं तस्थुः केशवं च महाबलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2061827, "chapter_id": 2320, "verse_number": "८-४१-३०", "content_sanskrit": "ततः सेनामुखे कर्णोऽप्यवातिष्ठत दंशितः।\nचित्रवर्माङ्गदः स्रग्वी पालयन्वाहिनीमुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2061828, "chapter_id": 2320, "verse_number": "८-४१-३१", "content_sanskrit": "रक्षमाणैः सुसंरब्धैः पुत्रैः शस्त्रभृतां वरः।\nवाहिनीं प्रमुखे वीरः सम्प्रकर्षन्नशोभत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2061829, "chapter_id": 2320, "verse_number": "८-४१-३२", "content_sanskrit": "अशोकस्तु महाबाहुः सूर्यवैश्वानरप्रभः।\nमहाद्विपस्कन्धगतः पिङ्गाक्षः प्रियदर्शनः।\nदुःशासनो वृतः सैन्यैः स्थितो व्यूहस्य पृष्ठतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2061830, "chapter_id": 2320, "verse_number": "८-४१-३३", "content_sanskrit": "तन्मध्ये स महाबाहुः स्वयं दुर्योधनो नृपः।\nचित्राश्वैश्चित्रसन्नाहैः सोदर्यैरभिरक्षितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2061831, "chapter_id": 2320, "verse_number": "८-४१-३४", "content_sanskrit": "रक्ष्यमाणो महावीर्यैः सहितैर्मद्रकेकयैः।\nअशोभत महाराज देवैरिव शतक्रतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2061832, "chapter_id": 2320, "verse_number": "८-४१-३५", "content_sanskrit": "अश्वत्थामा कुरूणां च ये प्रवीरा महारथाः।\nनित्यमत्ताश्च मातङ्गाः शूरैर्म्लेच्छैः समन्विताः।\nअन्वयुस्तद्रथानीकं क्षरन्त इव तोयदाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2061833, "chapter_id": 2320, "verse_number": "८-४१-३६", "content_sanskrit": "ते ध्वजैर्वैजयन्तीभिर्ज्वलद्भिः परमायुधैः।\nसादिभिश्चास्थिता रेजुर्द्रुमवन्त इवाचलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2061834, "chapter_id": 2320, "verse_number": "८-४१-३७", "content_sanskrit": "तेषां पदातिनागानां पादरक्षाः सहस्रशः।\nपट्टसासिधराः शूरा बभूवुरनिवर्तिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2061835, "chapter_id": 2320, "verse_number": "८-४१-३८", "content_sanskrit": "सादिभिः स्यन्दनैर्नागैरधिकं समलङ्कृतैः।\nस व्यूहराजो विबभौ देवासुरचमूपमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2061836, "chapter_id": 2320, "verse_number": "८-४१-३९", "content_sanskrit": "बार्हस्पत्यः सुविहितो नायकेन विपश्चिता।\nनृत्यतीव महाव्यूहः परेषां भयमादधत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2061837, "chapter_id": 2320, "verse_number": "८-४१-४०", "content_sanskrit": "तस्य पक्षप्रपक्षेभ्यो निष्पतन्ति युयुत्सवः।\nहस्त्यश्वरथमातङ्गाः प्रावृषीव बलाहकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2061838, "chapter_id": 2320, "verse_number": "८-४१-४१", "content_sanskrit": "ततः सेनामुखे कर्णं दृष्ट्वा राजा युधिष्ठिरः।\nधनञ्जयममित्रघ्नमेकवीरमुवाच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2061839, "chapter_id": 2320, "verse_number": "८-४१-४२", "content_sanskrit": "पश्यार्जुन महाव्यूहं कर्णेन विहितं रणे।\nयुक्तं पक्षैः प्रपक्षैश्च परानीकं प्रकाशते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2061840, "chapter_id": 2320, "verse_number": "८-४१-४३", "content_sanskrit": "तत्समीपगतं ह्येतत्प्रत्यमित्रं महद्बूलम्।\nयथा नाभिभवत्यस्मांस्तथा नीतिर्विधीयताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2061841, "chapter_id": 2320, "verse_number": "८-४१-४४x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2061842, "chapter_id": 2320, "verse_number": "८-४१-४४", "content_sanskrit": "एवमुक्तोऽर्जुनो राज्ञा प्राञ्जलिर्नृपमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2061843, "chapter_id": 2320, "verse_number": "८-४१-४५", "content_sanskrit": "यथा यथा भवानाह तत्तथा न तदन्यथा।\nयत्तस्य विहितं कार्यं तत्करिष्यामि सुव्रत।\nप्रधानमथ चैवास्य विनाशं च करोम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2061844, "chapter_id": 2320, "verse_number": "८-४१-४६", "content_sanskrit": "तस्मात्त्वं जहि राधेयं भीमसेनः सुयोधनम्।\nवृषसेनं च नकुलः सहदेवोऽपि सौबलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2061845, "chapter_id": 2320, "verse_number": "८-४१-४७", "content_sanskrit": "दुःशानं शतानीको हार्दिक्यं शिनिपुङ्गवः।\nधृष्टद्युम्नो द्रोणसुतं स्वयं योत्स्याम्यहं कृपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2061846, "chapter_id": 2320, "verse_number": "८-४१-४८", "content_sanskrit": "द्रौपदेया धार्तराष्ट्राञ्शिष्टान्सह शिखण्डिना।\nते ते च तांस्तानहितानस्माकं घ्न्तु मामकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2061847, "chapter_id": 2320, "verse_number": "८-४१-४९x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2061848, "chapter_id": 2320, "verse_number": "८-४१-४९", "content_sanskrit": "इत्युक्तो धर्मराजेन तथेत्युक्त्वा धनञ्जयः।\nव्यादिदेश स्वसैन्यानि स्वयं चागाच्चमूमुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2061849, "chapter_id": 2320, "verse_number": "८-४१-५०", "content_sanskrit": "धनञ्जयो महाराज दक्षिणं पक्षमास्थितः।\nभीमसेनो महाबाहुर्वामं पक्षमुपाश्रितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2061850, "chapter_id": 2320, "verse_number": "८-४१-५१", "content_sanskrit": "सात्यकिर्द्रौपदेयाश्च स्वयं राजा च पाण्डवः।\nव्यूहस्य प्रमुखे तस्थुः स्वेनानीकेन संवृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2061851, "chapter_id": 2320, "verse_number": "८-४१-५२", "content_sanskrit": "स्वबलेनारिसैन्यं तत्प्रत्यवस्थाप्य पाण्डवः।\nप्रत्यव्यूहत्पुरस्कृत्य धृष्टद्युम्नशिखण्डिनौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2061852, "chapter_id": 2320, "verse_number": "८-४१-५३", "content_sanskrit": "तत्सादिनागकलिलं पदातिरथसङ्कुलम्।\nधृष्टद्युम्नमुखं घोरमशोभत महद्बलम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2061853, "chapter_id": 2320, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि एकचत्वारिंशोऽध्यायः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]