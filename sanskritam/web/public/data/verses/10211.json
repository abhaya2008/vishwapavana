[{"id": 6000211000, "chapter_id": 10211, "verse_number": null, "content_sanskrit": "अथ पञ्चदशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000211001, "chapter_id": 10211, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_015/BhP_10.015.001.m4a", "display_order": 2}, {"id": 6000211002, "chapter_id": 10211, "verse_number": "१०-१५-१", "content_sanskrit": "नागालयं रमणकं कस्मात् तत्याज कालियः।\nकृतं किं वा सुपर्णस्य तेनैकेनासमञ्जसम्॥ १०/१५/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_015/BhP_10.015.002.m4a", "display_order": 3, "topics": [{"text": "सर्वैः सर्पैः स्वरक्षणार्थं गरुडाय प्रतिमासं कॢप्तस्य बलेः दृप्तेन कालियेन स्वयं भोजनम्", "range": "१–४"}]}, {"id": 6000211003, "chapter_id": 10211, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_015/BhP_10.015.003.m4a", "display_order": 4}, {"id": 6000211004, "chapter_id": 10211, "verse_number": "१०-१५-२", "content_sanskrit": "उपहार्यैः सर्पजनैर्मासि मासीह यो बलिः।\nवानस्पत्यो महाबाहो नागानां प्राङ् निरूपितः॥ १०/१५/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_015/BhP_10.015.004.m4a", "display_order": 5}, {"id": 6000211005, "chapter_id": 10211, "verse_number": "१०-१५-३", "content_sanskrit": "स्वं स्वं भागं प्रयच्छन्ति नागाः पर्वणिपर्वणि।\nगोपीथायात्मनः सर्वे सुपर्णाय महात्मने॥ १०/१५/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_015/BhP_10.015.005.m4a", "display_order": 6}, {"id": 6000211006, "chapter_id": 10211, "verse_number": "१०-१५-४", "content_sanskrit": "विषवीर्यमदाविष्टः काद्रवेयस्तु कालियः।\nकदर्थीकृत्य गरुडं स्वयं तां बुभुजे बलिम्॥ १०/१५/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_015/BhP_10.015.006.m4a", "display_order": 7}, {"id": 6000211007, "chapter_id": 10211, "verse_number": "१०-१५-५", "content_sanskrit": "तच्छ्रुत्वा कुपितो राजन् भगवान् भगवत्प्रियः।\nविजिघांसुर्महावीर्यं कालियं समुपाद्रवत्॥ १०/१५/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_015/BhP_10.015.007.m4a", "display_order": 8, "topics": [{"text": "तत्कर्मणा क्रुद्धेन गरुडेन ताडितस्य कालियस्य सौभरिऋषिशापात्सुपर्णागम्ये कालिन्दीह्रदे प्रवेशः, पूर्वं रमणद्वीपस्थस्य कालियस्य कालिन्दीह्रदागमने कारणकथनम्", "range": "५–१८"}]}, {"id": 6000211008, "chapter_id": 10211, "verse_number": "१०-१५-६", "content_sanskrit": "तमापतन्तं तरसा विषायुधः प्रत्यभ्ययादुद्धृतनैकमस्तकः।\nदद्भिः सुपर्णं व्यदशद् ददायुधः करालजिह्वोच्छ्वसितोग्रलोचनः॥ १०/१५/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_015/BhP_10.015.008.m4a", "display_order": 9}, {"id": 6000211009, "chapter_id": 10211, "verse_number": "१०-१५-७", "content_sanskrit": "तं तार्क्ष्यपुत्रः स निरस्य मन्युमान् प्रचण्डवेगो मधुसूदनासनः।\nपक्षेण सव्येन हिरण्यरोचिषा जघान कद्रूसुतमुग्रविक्रमः॥ १०/१५/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_015/BhP_10.015.009.m4a", "display_order": 10}, {"id": 6000211010, "chapter_id": 10211, "verse_number": "१०-१५-८", "content_sanskrit": "सुपर्णपक्षाभिहतः कालियोऽतीव विह्वलः।\nह्रदं विवेश कालिन्द्यास्तदगम्यं दुरासदम्॥ १०/१५/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_015/BhP_10.015.010.m4a", "display_order": 11}, {"id": 6000211011, "chapter_id": 10211, "verse_number": "१०-१५-९", "content_sanskrit": "तत्रैकदा जलचरं गरुडो भक्ष्यमीप्सितम्।\nनिवारितः सौभरिणा प्रसह्य क्षुधितोऽहरत्॥ १०/१५/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_015/BhP_10.015.011.m4a", "display_order": 12}, {"id": 6000211012, "chapter_id": 10211, "verse_number": "१०-१५-१०", "content_sanskrit": "मीनान् सुदुःखितान् दृष्ट्वा दीनान् मीनपतौ हते।\nकृपया सौभरिः प्राह तत्र तत्क्षेममाचरन्॥ १०/१५/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_015/BhP_10.015.012.m4a", "display_order": 13}, {"id": 6000211013, "chapter_id": 10211, "verse_number": "१०-१५-११", "content_sanskrit": "अत्र प्रविश्य गरुडो यदि मत्स्यान् स खादति।\nसद्यः प्राणैर्वियुज्येत सत्यमेतद् ब्रवीम्यहम्॥ १०/१५/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_015/BhP_10.015.013.m4a", "display_order": 14}, {"id": 6000211014, "chapter_id": 10211, "verse_number": "१०-१५-१२", "content_sanskrit": "तत् कालियः परं वेद नान्यः कश्चित् स लेलिहा।\nअवात्सीद् गरुडाद् भीतः कृष्णेन च विवासितः॥ १०/१५/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_015/BhP_10.015.014.m4a", "display_order": 15}, {"id": 6000211015, "chapter_id": 10211, "verse_number": "१०-१५-१३", "content_sanskrit": "कृष्णं ह्रदाद् विनिष्क्रान्तं दिव्यस्रग्गन्धमण्डितम्।\nमहामणिगणाकीर्णं जाम्बूनदपरिष्कृतम्॥ १०/१५/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_015/BhP_10.015.015.m4a", "display_order": 16}, {"id": 6000211016, "chapter_id": 10211, "verse_number": "१०-१५-१४", "content_sanskrit": "उपलभ्योत्थिताः सर्वे लब्धप्राणा इव प्रजाः।\nप्रमोदनिभृतात्मानो गोपाः प्रीत्याऽभिरेमिरे॥ १०/१५/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_015/BhP_10.015.016.m4a", "display_order": 17}, {"id": 6000211017, "chapter_id": 10211, "verse_number": "१०-१५-१५", "content_sanskrit": "यशोदा रोहिणी नन्दो गोपा गोप्यश्च कौरव।\nकृष्णं समेत्य लब्धेहा आसंल्लब्धमनोरथाः॥ १०/१५/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_015/BhP_10.015.017.m4a", "display_order": 18}, {"id": 6000211018, "chapter_id": 10211, "verse_number": "१०-१५-१६", "content_sanskrit": "रामश्चाच्युतमालिङ्ग्य जहासास्यानुभाववित्।\nनरा गावो वृषा वत्सा लेभिरे परमामुदम्॥ १०/१५/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_015/BhP_10.015.018.m4a", "display_order": 19}, {"id": 6000211019, "chapter_id": 10211, "verse_number": "१०-१५-१७", "content_sanskrit": "नन्दं विप्राः समागम्य गुरवः सकलत्रकाः।\nऊचुस्ते कालियग्रस्तो दिष्ट्या मुक्तस्तवात्मजः॥ १०/१५/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_015/BhP_10.015.019.m4a", "display_order": 20}, {"id": 6000211020, "chapter_id": 10211, "verse_number": "१०-१५-१८", "content_sanskrit": "यशोदा च महाभागा नष्टलब्धप्रजा सती।\nपरिष्वज्याङ्कमारोप्य मुमोचाश्रुकणान् बहून्॥ १०/१५/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_015/BhP_10.015.020.m4a", "display_order": 21}, {"id": 6000211021, "chapter_id": 10211, "verse_number": "१०-१५-१९", "content_sanskrit": "ततश्चास्तंगते भानौ कृष्णो वासमकल्पयत्।\nसरामः सह गोपालैर्मात्रा पित्रा सगोधनैः॥ १०/१५/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_015/BhP_10.015.021.m4a", "display_order": 22, "topics": [{"text": "कृष्णेन दावाग्नेर्नन्दादिमोचनम्", "range": "१९–२६"}]}, {"id": 6000211022, "chapter_id": 10211, "verse_number": "१०-१५-२०", "content_sanskrit": "तां रात्रिं तत्र राजेन्द्र क्षुत्तृड्भ्यां श्रमकर्शिताः।\nऊषुर्व्रजौकसो गावः कालिन्द्या उपकूलतः॥ १०/१५/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_015/BhP_10.015.022.m4a", "display_order": 23}, {"id": 6000211023, "chapter_id": 10211, "verse_number": "१०-१५-२१", "content_sanskrit": "एतस्मिन्नेव काले तु व्रजे कौरवसत्तम। घोरः शुचिबलोद्भूतो दावाग्निः सर्वतो वृतः।\nसुप्तान् निशीथ आवृत्य प्रदग्धुमुपचक्रमे॥ १०/१५/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_015/BhP_10.015.023.m4a", "display_order": 24}, {"id": 6000211024, "chapter_id": 10211, "verse_number": "१०-१५-२२", "content_sanskrit": "तत उत्थाय सम्भ्रान्ता दह्यमाना व्रजौकसः।\nकृष्णं ययुस्ते शरणं मायामनुजमीश्वरम्॥ १०/१५/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_015/BhP_10.015.024.m4a", "display_order": 25}, {"id": 6000211025, "chapter_id": 10211, "verse_number": "१०-१५-२३", "content_sanskrit": "कृष्ण कृष्ण महाभाग हे रामामितविक्रम।\nएष तीव्रतमो वह्निस्तावकान् ग्रसते हि नः॥ १०/१५/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_015/BhP_10.015.025.m4a", "display_order": 26}, {"id": 6000211026, "chapter_id": 10211, "verse_number": "१०-१५-२४", "content_sanskrit": "सुदुस्तरान्नः स्वान् पाहि कालाग्नेः सुहृदः प्रभो।\nन शक्नुमस्त्वच्चरणं सन्त्यक्तुमकुतोभयम्॥ १०/१५/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_015/BhP_10.015.026.m4a", "display_order": 27}, {"id": 6000211027, "chapter_id": 10211, "verse_number": "१०-१५-२५", "content_sanskrit": "इत्थं स्वजनवैक्लव्यं निरीक्ष्य जगदीश्वरः।\nतमग्निमपिबत् तीव्रमनन्तोऽनन्तशक्तिधृक्॥ १०/१५/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_015/BhP_10.015.027.m4a", "display_order": 28}, {"id": 6000211028, "chapter_id": 10211, "verse_number": "१०-१५-२६", "content_sanskrit": "अथ कृष्णः परिवृतो ज्ञातिभिर्मुदितात्मभिः।\nअनुगीयमानो न्यविशद् व्रजं गोकुलमण्डितम्॥ १०/१५/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_015/BhP_10.015.028.m4a", "display_order": 29}, {"id": 6000211029, "chapter_id": 10211, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्धपूर्वार्धे पञ्चदशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]