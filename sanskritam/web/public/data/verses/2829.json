[{"id": 2085935, "chapter_id": 2829, "verse_number": "१२-३३४-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2085936, "chapter_id": 2829, "verse_number": "१२-३३४-१", "content_sanskrit": "ततः स राजा जनको मन्त्रिभिः सह भारत।\nपुरोहितं पुरस्कृत्य सर्वाण्यन्तः पुराणि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2085937, "chapter_id": 2829, "verse_number": "१२-३३४-२", "content_sanskrit": "आसनं च पुरस्कृत्य रत्नानि विविधानि च।\nशिरसा चार्ध्यमादाय गुरुपुत्रं समभ्यगात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2085938, "chapter_id": 2829, "verse_number": "१२-३३४-३", "content_sanskrit": "स तदासनमादाय बहुरत्नविभूषितम्।\nस्पर्ध्यास्तरणसंस्तीर्णं सर्वतोभद्रमृद्धिमत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2085939, "chapter_id": 2829, "verse_number": "१२-३३४-४", "content_sanskrit": "पुरोधसा संगृहीतं हस्तेनालभ्य पार्थिवः।\nप्रददौ गुरुपुत्राय शुकाय परमार्चितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2085940, "chapter_id": 2829, "verse_number": "१२-३३४-५", "content_sanskrit": "तत्रोपविष्टं तं कार्ष्णि शास्त्रतः प्रतिपूज्य च।\nपाद्यं निवेद्य प्रथममर्ध्यं गां च न्यवेदयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2085941, "chapter_id": 2829, "verse_number": "१२-३३४-६", "content_sanskrit": "स च तां मन्त्रवत्पूजां प्रत्यगृह्णाद्यथाविधि।\nप्रतिगृह्य तु तां पूजां जनकाद्द्विजसत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2085942, "chapter_id": 2829, "verse_number": "१२-३३४-७", "content_sanskrit": "गां चैव समनुज्ञाय राजानमनुमान्य च।\nपर्यपृच्छन्महातेजा राज्ञः कुशलमव्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2085943, "chapter_id": 2829, "verse_number": "१२-३३४-८", "content_sanskrit": "अनामयं च राजेन्द्र शुकः सानुचरस्य ह।\nअनुज्ञातः स तेनाथ निषसाद सहानुगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2085944, "chapter_id": 2829, "verse_number": "१२-३३४-९", "content_sanskrit": "कुशलं चाव्ययं चैव पृष्ट्वा वैयासकिं नृपः।\nकिमागमनमित्येवं पर्यपृच्छत पार्थिवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2085945, "chapter_id": 2829, "verse_number": "१२-३३४-१०x", "content_sanskrit": "शुक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2085946, "chapter_id": 2829, "verse_number": "१२-३३४-१०", "content_sanskrit": "पित्राऽहमुक्तो भद्रं ते मोक्षधर्मार्थकोविदः।\nविदेहराजो याज्यो मे जनको नाम विश्रुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2085947, "chapter_id": 2829, "verse_number": "१२-३३४-११", "content_sanskrit": "तत्र गच्छस्व वै तूर्णं यदि ते हृदि संशयः।\nप्रवृत्तौ वा निवृत्तौ वा स ते च्छेत्स्यति संशयं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2085948, "chapter_id": 2829, "verse_number": "१२-३३४-१२", "content_sanskrit": "सोहं पितुर्नियोगात्त्वामुपप्रष्टुमिहागतः।\nतन्मे धर्मभृतां श्रेष्ठ यथावद्वक्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2085949, "chapter_id": 2829, "verse_number": "१२-३३४-१३", "content_sanskrit": "किं कार्यं ब्राह्मणेनेह मोक्षार्थश्च किमात्मकः।\nकथं च मोक्षः प्राप्तव्यो ज्ञानेन तपसाऽथवा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2085950, "chapter_id": 2829, "verse_number": "१२-३३४-१४x", "content_sanskrit": "जनक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2085951, "chapter_id": 2829, "verse_number": "१२-३३४-१४", "content_sanskrit": "यत्कार्यं ब्राह्मणेनेह जन्मप्रभृति तच्छृणु।\nकृतोपनयनस्तात भवेद्वेदपरायणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2085952, "chapter_id": 2829, "verse_number": "१२-३३४-१५", "content_sanskrit": "तपसा गुरुवृत्त्या च ब्रह्मचर्येण चाभिभो।\nदेवतानामृषीणां चाप्यनृणो ह्यनसूयकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2085953, "chapter_id": 2829, "verse_number": "१२-३३४-१६", "content_sanskrit": "वेदानधीत्य नियतो दक्षिणामपवर्ज्य च।\nअभ्यनुज्ञामथ प्राप्य समावर्तेत वै द्विजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2085954, "chapter_id": 2829, "verse_number": "१२-३३४-१७", "content_sanskrit": "समावृत्तश्च गार्हस्थ्ये स्वदारनिरतो वसेत्।\nअनसूयुर्यथान्यायमाहिताग्निरनावृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2085955, "chapter_id": 2829, "verse_number": "१२-३३४-१८", "content_sanskrit": "उत्पाद्य पुत्रं पौत्रं तु वन्याश्रमपदे वसेत्।\nतानेवाग्नीन्यथाशास्त्रमर्चयन्नतिथिप्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2085956, "chapter_id": 2829, "verse_number": "१२-३३४-१९", "content_sanskrit": "स वनेऽग्नीन्यथान्यायमात्मन्यारोप्य धर्मवित्।\nनिर्द्वन्द्वो बीतरागात्मा ब्रह्माश्रमपदे वसेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2085957, "chapter_id": 2829, "verse_number": "१२-३३४-२०x", "content_sanskrit": "शुक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2085958, "chapter_id": 2829, "verse_number": "१२-३३४-२०", "content_sanskrit": "उत्पन्ने ज्ञानविज्ञाने प्रत्यक्षे हृदि शाश्वते।\nकिमवश्यं निवस्तव्यमाश्रमेषु वनेषु वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2085959, "chapter_id": 2829, "verse_number": "१२-३३४-२१", "content_sanskrit": "एतद्भवन्तं पृच्छामि तद्भवान्वक्तुमर्हति।\nयथा वेदार्थतत्त्वेन ब्रूहि मे त्वं जनाधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2085960, "chapter_id": 2829, "verse_number": "१२-३३४-२२x", "content_sanskrit": "जनक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2085961, "chapter_id": 2829, "verse_number": "१२-३३४-२२", "content_sanskrit": "न विना ज्ञानविज्ञाने मोक्षस्याधिगमो भवेत्।\nन विना गुरुसंबन्धं ज्ञानस्याधिगमः स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2085962, "chapter_id": 2829, "verse_number": "१२-३३४-२३", "content_sanskrit": "गुरुः प्लावयिता तस्य ज्ञानं प्लव इहोच्यते।\nविज्ञाय कृतकृत्यस्तु तीर्णस्तदुभयं त्यजेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2085963, "chapter_id": 2829, "verse_number": "१२-३३४-२४", "content_sanskrit": "अनुच्छेदाय लोकानामनुच्छेदाय कर्मणाम्।\nपूर्वैराचरितो धर्मश्चातुराश्रम्यसंश्रितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2085964, "chapter_id": 2829, "verse_number": "१२-३३४-२५", "content_sanskrit": "अनेन क्रमयोगेन बहुजातिषु कर्मणाम्।\nकृत्वा शुभाशुभं कर्म मोक्षो नामेह लभ्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2085965, "chapter_id": 2829, "verse_number": "१२-३३४-२६", "content_sanskrit": "भावितैः करणैश्चायं बहुसंसारयोनिषु।\nआसादयति शुद्धात्मा मोक्षं वै प्रथमाश्रमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2085966, "chapter_id": 2829, "verse_number": "१२-३३४-२७", "content_sanskrit": "तमासाद्य तु मुक्तस्य दृष्टार्थस्य विपश्चितः।\nत्रिष्वाश्रमेषु कोऽन्वर्थो भवेत्परमभीप्सतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2085967, "chapter_id": 2829, "verse_number": "१२-३३४-२८", "content_sanskrit": "राजसांस्तामसांश्चैव नित्यं दोषान्विवर्जयेत्।\nसात्विकं मार्गमास्थाय पश्येदात्मानमात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2085968, "chapter_id": 2829, "verse_number": "१२-३३४-२९", "content_sanskrit": "सर्वभूतेषु चात्मानं सर्वभूतानि चात्मनि।\nसंपश्यन्नोपलिप्येत जले वारिचरो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2085969, "chapter_id": 2829, "verse_number": "१२-३३४-३०", "content_sanskrit": "पक्षिवत्प्रायणादूर्ध्वममुत्रानन्त्यमश्नुते।\nविहाय देहान्निर्मुक्तो निर्द्वन्द्वः प्रशमं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2085970, "chapter_id": 2829, "verse_number": "१२-३३४-३१", "content_sanskrit": "अत्र गाथाः पुरा गीताः शृणु राज्ञा ययातिना।\nधार्यन्तो या द्विजैस्तात मोक्षशास्त्रविशारदैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2085971, "chapter_id": 2829, "verse_number": "१२-३३४-३२", "content_sanskrit": "ज्योतिरात्मनि नान्यत्र सर्वजन्तुषु तत्समम्।\nस्वयं च शक्यते द्रष्टुं सुसमाहितचेतसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2085972, "chapter_id": 2829, "verse_number": "१२-३३४-३३", "content_sanskrit": "न बिभेति परो यस्मान्न बिभेति पराच्च यः।\nयश्च नेच्छति न द्वेष्टि ब्रह्म संपद्यते तु सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2085973, "chapter_id": 2829, "verse_number": "१२-३३४-३४", "content_sanskrit": "यदा भावं न कुरुते सर्वभूतेषु पापकम्।\nकर्मणा मनसा वाचा ब्रह्म संपद्यते तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2085974, "chapter_id": 2829, "verse_number": "१२-३३४-३५", "content_sanskrit": "संयोज्य मनसाऽऽत्मानमीर्ष्यामुत्सृज्य मोहनीम्।\nत्यक्त्वा कामं च मोहं च ततो ब्रह्मत्वमश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2085975, "chapter_id": 2829, "verse_number": "१२-३३४-३६", "content_sanskrit": "यदा श्राव्ये च दृश्ये च सर्वभूतेषु चाप्ययम्।\nसमो भवति निर्द्वन्द्वो ब्रह्म संपद्यते तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2085976, "chapter_id": 2829, "verse_number": "१२-३३४-३७", "content_sanskrit": "यदा स्तुतिं च निन्दां च समत्वेनैव पश्यति।\nकाञ्चनं चायसं चैव सुखं दुःखं तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2085977, "chapter_id": 2829, "verse_number": "१२-३३४-३८", "content_sanskrit": "शीतमुष्णं तथैवार्थमनर्थं प्रियमप्रियम्।\nजीवितं मरणं चैव ब्रह्म संपद्यते तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2085978, "chapter_id": 2829, "verse_number": "१२-३३४-३९", "content_sanskrit": "प्रसार्येह यथाङ्गानि कूर्मः संहरते पुनः।\nतथेन्द्रियाणि मनसा संयन्तव्यानि भिक्षुणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2085979, "chapter_id": 2829, "verse_number": "१२-३३४-४०", "content_sanskrit": "तमः परिगतं वेश्म यथा दीपेन दृश्यते।\nतथा बुद्धिप्रदीपेन शक्य आत्मा निरीक्षितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2085980, "chapter_id": 2829, "verse_number": "१२-३३४-४१", "content_sanskrit": "एतत्सर्वं च पश्यामि त्वयि बुद्धिमतां वर।\nयच्चान्यदपि नोक्तं मे तत्त्वतो वेद तद्भवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2085981, "chapter_id": 2829, "verse_number": "१२-३३४-४२", "content_sanskrit": "ब्रह्मर्षे विदितश्चासि विषयान्तमुपागतः।\nगुरोस्तव प्रसादेन तव चैवोपशिक्षया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2085982, "chapter_id": 2829, "verse_number": "१२-३३४-४३", "content_sanskrit": "तस्यैव च प्रसादेन प्रादुर्भूतं महात्मनः।\nज्ञानं दिव्यं ममापीदं तेनासि विदितो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2085983, "chapter_id": 2829, "verse_number": "१२-३३४-४४", "content_sanskrit": "अधिकं तव विज्ञानमधिका च गतिस्तव।\nअधिकं तव चैश्वर्यं तच्च त्वं नावबुध्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2085984, "chapter_id": 2829, "verse_number": "१२-३३४-४५", "content_sanskrit": "बाल्याद्वा संशयाद्वापि भयाद्वाऽप्यविमोक्षणात्।\nउत्पन्ने चापि विज्ञाने नाधिगच्छति तां गतिं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2085985, "chapter_id": 2829, "verse_number": "१२-३३४-४६", "content_sanskrit": "व्यवसायेन शुद्धेन मद्विधैश्छिन्नसंशयः।\nविमुच्य हृदयग्रन्थीनासादयति तां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2085986, "chapter_id": 2829, "verse_number": "१२-३३४-४७", "content_sanskrit": "भवांश्चोत्पन्नविज्ञानः स्थिरबुद्धिरलोलुपः।\nव्यवसायादृते ब्रह्मन्नासादयति तत्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2085987, "chapter_id": 2829, "verse_number": "१२-३३४-४८", "content_sanskrit": "नास्ति ते सुखदुःखेषु विशेषो नास्ति लोलुपः।\nनौत्सुक्यं नृत्यगीतेषु न राग उपजायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2085988, "chapter_id": 2829, "verse_number": "१२-३३४-४९", "content_sanskrit": "न बन्धुष्वनुबन्धस्ते न भयेष्वस्ति ते भयम्।\nपश्यामि त्वां महाभाग तुल्यलोष्टाश्मकाञ्चनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2085989, "chapter_id": 2829, "verse_number": "१२-३३४-५०", "content_sanskrit": "अहं त्वामनुपश्यामि ये चाप्यन्ते मनीषिणः।\nआस्थितं परमं मार्गमक्षयं तमनामयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2085990, "chapter_id": 2829, "verse_number": "१२-३३४-५१", "content_sanskrit": "यत्फलं ब्राह्मणस्येह मोक्षार्थश्च यदात्मकः।\nतस्मिन्वै वर्तसे विप्र किमन्यत्परिपृच्छसि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2085991, "chapter_id": 2829, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि चतुस्त्रिंशदधिकत्रिशततमोऽध्यायः॥ ३३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]