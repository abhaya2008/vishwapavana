[{"id": 2105169, "chapter_id": 3268, "verse_number": "१५-६-१", "content_sanskrit": "वैशम्पाय उवाच।\nदारुकोपि कुरून्गत्वा दृष्ट्वा पार्थान्महारथान्।\nआचष्ट मौसले वृष्णीनन्योन्येनोपसंहृतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2105170, "chapter_id": 3268, "verse_number": "१५-६-२", "content_sanskrit": "श्रुत्वा विनष्टान्वार्ष्णेयान्सभोजान्धककौकुरान्।\nपाण्डवाः शोकसंतप्ता वित्रस्तमनसोऽभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2105171, "chapter_id": 3268, "verse_number": "१५-६-३", "content_sanskrit": "ततोऽर्जुनस्तानामन्त्र्य केशवस्य प्रियः सखा।\nप्रययौ मातुलं द्रष्टुं नेदमस्तीति चाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2105172, "chapter_id": 3268, "verse_number": "१५-६-४", "content_sanskrit": "स वृष्णिनिलयं गत्वा दारुकेण सह प्रभो।\nददर्श द्वारकां वीरो मृतनाथामिव स्त्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2105173, "chapter_id": 3268, "verse_number": "१५-६-५", "content_sanskrit": "याः स्म ता लोकनाथेन नाथवत्यः पुराऽभवन्।\nतास्त्वनाथास्तदा नाथं पार्थं दृष्ट्वा विचुक्रुशुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2105174, "chapter_id": 3268, "verse_number": "१५-६-६", "content_sanskrit": "षोडश स्त्रीसहस्राणि वासुदेवपरिग्रहाः।\nतासामासीन्महान्नादो दृष्ट्वैवार्जुनमागतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2105175, "chapter_id": 3268, "verse_number": "१५-६-७", "content_sanskrit": "तास्तु दृष्ट्वैव कौरव्यो बाष्पेणापिहितेक्षणः।\nहीनाः कृष्णेन पुत्रैश्च नाशकत्सोभिवीक्षितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2105176, "chapter_id": 3268, "verse_number": "१५-६-८", "content_sanskrit": "स तां वृष्ण्यन्धकजलां हयमीनां रथोडुपाम्।\nवादित्ररथघोषौघां वेश्मतीर्थमहाग्रहाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2105177, "chapter_id": 3268, "verse_number": "१५-६-९", "content_sanskrit": "रत्नशैवलसंघातां वज्रप्राकारमालिनीम्।\nरथ्यास्रोतोजलावर्तां चत्वरस्तिमितह्रदाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2105178, "chapter_id": 3268, "verse_number": "१५-६-१०", "content_sanskrit": "रामकृष्णमहाग्राहां द्वारकां सरितं तदा।\nकालपाशग्रहां भीमां नदीं वैतरणीमिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2105179, "chapter_id": 3268, "verse_number": "१५-६-११", "content_sanskrit": "ददर्श वासविर्धीमान्विहीनां वृष्णिपुङ्गवैः।\nगतश्रियं विरानन्दां पद्मिनीं शिशिरे यथा।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2105180, "chapter_id": 3268, "verse_number": "१५-६-१२", "content_sanskrit": "तां दृष्ट्वा द्वारकां पार्थस्ताश्च कृष्णस्य योषितः।\nसस्वनं बाष्पमुत्सृज्य निपात महीतले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2105181, "chapter_id": 3268, "verse_number": "१५-६-१३", "content_sanskrit": "सात्राजिती ततः सत्या रुक्मिणी च विशांपते।\nअभिपत्य प्ररुरुदुः परिवार्य धनंजयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2105182, "chapter_id": 3268, "verse_number": "१५-६-१४", "content_sanskrit": "ततस्तं काञ्चने पीठे समुत्ताप्योपवेश्य च।\nअभिनन्द्य महात्मानं परिवार्योपतस्थिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2105183, "chapter_id": 3268, "verse_number": "१५-६-१५", "content_sanskrit": "ततः संस्तूय गोविन्दं कथयित्वा च पाण्डवः।\nआश्वास्य ताः स्त्रियश्चापि मातुलं द्रष्टुमभ्यगात्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2105184, "chapter_id": 3268, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते मौसलपर्वणि षष्ठोऽध्यायः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]