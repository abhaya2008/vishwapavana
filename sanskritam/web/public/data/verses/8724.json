[{"id": 900009106, "chapter_id": 8724, "verse_number": "14.1", "content_sanskrit": "पदार्थस्तु व्यक्तिरेव", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900009107, "chapter_id": 8724, "verse_number": "14.2", "content_sanskrit": "ननु व्यक्तौ शक्त्यभावे कथं शब्दात्तद्धीरिति चेत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900009108, "chapter_id": 8724, "verse_number": "14.3", "content_sanskrit": "उच्यते– येन रूपेणोपस्थिते सम्बन्धिनि ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900009109, "chapter_id": 8724, "verse_number": "14.4", "content_sanskrit": "किं चैवं व्यक्त्यंशे शक्तिज्ञानत्वेन कारणता..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900009110, "chapter_id": 8724, "verse_number": "14.5", "content_sanskrit": "किं च मुण्डिते गोत्वे न शक्तिग्रहः..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900009111, "chapter_id": 8724, "verse_number": "14.6", "content_sanskrit": "अपि च पूर्वमानयेति मुख्यप्रयोगेऽपरस्यापि ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900009112, "chapter_id": 8724, "verse_number": "14.7", "content_sanskrit": "किञ्चोक्तन्यायेन व्यक्तिविशेषणकगोत्वे शक्तिर्ज्ञातेति..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}]