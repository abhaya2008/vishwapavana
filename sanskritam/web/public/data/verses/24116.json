[{"id": 7004116000, "chapter_id": 24116, "verse_number": "४-६५-१", "content_sanskrit": "स्कंद उवाच ।\nज्येष्ठेश्वरस्य परितो यानि लिंगानि कुंभज ।\nतानि पंचसहस्राणि मुनीनां सिद्धिदान्यलम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004116001, "chapter_id": 24116, "verse_number": "४-६५-२", "content_sanskrit": "पराशरेश्वरं लिंगं ज्येष्ठेशादुत्तरे महत् ।\nतस्य दर्शनमात्रेण निर्मलं ज्ञानमाप्यते ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004116002, "chapter_id": 24116, "verse_number": "४-६५-३", "content_sanskrit": "तत्रैव सिद्धिदं लिंगं मांडव्येश्वरसंज्ञितम् ।\nन तस्य दर्शनाज्जातु दुर्बुद्धिं प्राप्नुयान्नरः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004116003, "chapter_id": 24116, "verse_number": "४-६५-४", "content_sanskrit": "लिंगं च शंकरेशाख्यं तत्रैव शुभदं सदा ।\nभृगुनारायणस्तत्र भक्तानां सर्वसिद्धिदः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004116004, "chapter_id": 24116, "verse_number": "४-६५-५", "content_sanskrit": "जाबालीश्वर संज्ञं च लिंगं तत्रातिसिद्धिदम् ।\nतस्य संदर्शनाज्जातु न जंतुर्दुर्गतिं व्रजेत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004116005, "chapter_id": 24116, "verse_number": "४-६५-६", "content_sanskrit": "सुमंतु मुनिना श्रेष्ठस्तत्रादित्यः प्रतिष्ठितः ।\nतस्य संदर्शनादेव कुष्ठव्याधिः प्रशाम्यति ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004116006, "chapter_id": 24116, "verse_number": "४-६५-७", "content_sanskrit": "भैरेवी भीषणा नाम तत्र भीषणरूपिणी ।\nक्षेत्रस्य भीषणं सर्वं नाशयेद्भावतोर्चिता ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004116007, "chapter_id": 24116, "verse_number": "४-६५-८", "content_sanskrit": "तत्रोपजंघने लिंगं कर्मबंधविमोक्षणम् ।\nनृभिः संसेवितं भक्त्या षण्मासात्सिद्धिदं परम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004116008, "chapter_id": 24116, "verse_number": "४-६५-९", "content_sanskrit": "भारद्वाजेश्वरं लिंगं लिंगं माद्रीश्वरं वरम् ।\nएकत्र संस्थिते द्वे तु द्रष्टव्ये सुकृतात्मना ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004116009, "chapter_id": 24116, "verse_number": "४-६५-१०", "content_sanskrit": "अरुणि स्थापितं लिंगं तत्रैव कलशोद्भव ।\nतस्य लिंगस्य सेवातः सर्वामृद्धिमवाप्नुयात् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004116010, "chapter_id": 24116, "verse_number": "४-६५-११", "content_sanskrit": "लिंगं वाजसनेयाख्यं तत्रास्त्यतिमनोहृरम् ।\nतस्य संदर्शनात्पुंसां वाजपेयफलं भवेत् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004116011, "chapter_id": 24116, "verse_number": "४-६५-१२", "content_sanskrit": "कण्वेश्वरं शुभं लिंगं लिंगं कात्यायनेश्वरम् ।\nवामदेवेश्वरं लिंगमौतथ्येश्वरमेव च ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004116012, "chapter_id": 24116, "verse_number": "४-६५-१३", "content_sanskrit": "हारीतेश्वरसंज्ञं च लिंगं वै गालवेश्वरम् ।\nकुंभेर्लिंगं महापुण्यं तथा वै कौसुमेश्वरम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004116013, "chapter_id": 24116, "verse_number": "४-६५-१४", "content_sanskrit": "अग्निवर्णेश्वरं चैव नैध्रुवेश्वरमेव च ।\nवत्सेश्वरं महालिंगं पर्णादेश्वरमेव च ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004116014, "chapter_id": 24116, "verse_number": "४-६५-१५", "content_sanskrit": "सक्तुप्रस्थेश्वरं लिंगं कणादेशं तथैव च ।\nअन्यत्तत्र महालिंगं मांडूकाय निरूपितम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004116015, "chapter_id": 24116, "verse_number": "४-६५-१६", "content_sanskrit": "वाभ्रवेयेश्वरं लिंगं शिलावृत्तीश्वरं तथा ।\nच्यवनेश्वर लिंगं च शालंकायनकेश्वरम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004116016, "chapter_id": 24116, "verse_number": "४-६५-१७", "content_sanskrit": "कलिंदमेश्वरं लिंगं लिंगमक्रोधनेश्वरम् ।\nलिंगं कपोतवृत्तीशं कंकेशं कुंतलेश्वरम ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004116017, "chapter_id": 24116, "verse_number": "४-६५-१८", "content_sanskrit": "कंठेश्वरं कहोलेशं लिंगं तुंबुरुपूजितम् ।\nमतगेशं मरुत्तेशं मगधेयेश्वरं तथा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004116018, "chapter_id": 24116, "verse_number": "४-६५-१९", "content_sanskrit": "जातूकर्णेश्वरं लिंगं जंबूकेश्वरमेव च ।\nजारुधीशं जलेशं च जाल्मेशं जालकेश्वरम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004116019, "chapter_id": 24116, "verse_number": "४-६५-२०", "content_sanskrit": "एवमादीनि लिंगानि अयुतार्धानि कुंभज ।\nस्मरणाद्दर्शनात्स्पर्शादर्चनान्नमनात्स्तुतेः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004116020, "chapter_id": 24116, "verse_number": "४-६५-२१", "content_sanskrit": "न जातु जायते जंतोः कलुषस्य समुद्भवः ।\nएतेषां शुभलिंगानां ज्येष्ठस्थानेति पावने ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004116021, "chapter_id": 24116, "verse_number": "४-६५-२२", "content_sanskrit": "स्कंद उवाच ।\nएकदा तत्र यद्वृत्तं ज्येष्ठस्थाने महामुने ।\nतदहं ते प्रवक्ष्यामि शृणुष्वाघविनाशनम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004116022, "chapter_id": 24116, "verse_number": "४-६५-२३", "content_sanskrit": "स्वैरं विहरतस्तत्र ज्येष्ठस्थाने महेशितुः ।\nकौतुकेनैव चिक्रीड शिवा कंदुकलीलया ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004116023, "chapter_id": 24116, "verse_number": "४-६५-२४", "content_sanskrit": "उदंच न्न्यंचदंगानां लाघवं परितन्वती ।\nनिःश्वासामोदमुदित भ्रमराकुलितेक्षणा ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004116024, "chapter_id": 24116, "verse_number": "४-६५-२५", "content_sanskrit": "भ्रश्यद्ध म्मिल्लसन्माल्य स्थपुटीकृत भूमिका ।\nस्विद्यत्कपोलपत्राली स्रवदंबुकणोज्ज्वला ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004116025, "chapter_id": 24116, "verse_number": "४-६५-२६", "content_sanskrit": "स्फुटच्चोलांशुकपथनिर्यदंगप्रभावृता ।\nउल्लसत्कंदुकास्फालातिशोणितकरांबुजा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004116026, "chapter_id": 24116, "verse_number": "४-६५-२७", "content_sanskrit": "कंदुकानुग सदृष्टि नर्तित भ्रूचलतांचला ।\nमृडानी किल खेलंती ददृशे जगदंबिका ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004116027, "chapter_id": 24116, "verse_number": "४-६५-२८", "content_sanskrit": "अंतरिक्षचराभ्यां च दितिजाभ्यां मनोहरा ।\nकटाक्षिताभ्यामिव वै समुपस्थितमृत्युना ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004116028, "chapter_id": 24116, "verse_number": "४-६५-२९", "content_sanskrit": "विदलोत्पल संज्ञाभ्यां दृप्ताभ्यां वरतो विधेः ।\nतृणीकृतत्रिजगती पुरुषाभ्यां स्वदोर्बलात् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004116029, "chapter_id": 24116, "verse_number": "४-६५-३०", "content_sanskrit": "देवीं परिजिहीर्षू तौ विषमेषु प्रपीडितौ ।\nदिवोवतेरतुः क्षिप्रं मायां स्वीकृत्य शांबरीम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004116030, "chapter_id": 24116, "verse_number": "४-६५-३१", "content_sanskrit": "धृत्वा पारषदीं मूर्तिमायातावंबिकांतिकम् ।\nतावत्यंतं सुदुर्वृत्तावतिचंचलमानसा ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004116031, "chapter_id": 24116, "verse_number": "४-६५-३२", "content_sanskrit": "सर्वज्ञेन परिज्ञातौ चांचल्याल्लोचनोद्भवात् ।\nकटाक्षिताथ देवेन दुर्गादुर्गारिघातिनी ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004116032, "chapter_id": 24116, "verse_number": "४-६५-३३", "content_sanskrit": "विज्ञाय नेत्रसंज्ञां तु सर्वज्ञार्ध शरीरिणी ।\nतेनैव कंदुकेनाथ युगपन्निजघान तौ ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004116033, "chapter_id": 24116, "verse_number": "४-६५-३४", "content_sanskrit": "महाबलौ महादेव्या कंदुकेन समाहतौ ।\nपरिभ्रम्य परिभ्रम्य तौ दुष्टौ विनिपेततुः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004116034, "chapter_id": 24116, "verse_number": "४-६५-३५", "content_sanskrit": "वृंतादिव फले पक्वे तालादनिललोलिते ।\nदंभोलिना परिहते शृंगेइव महागिरेः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004116035, "chapter_id": 24116, "verse_number": "४-६५-३६", "content_sanskrit": "तौ निपात्य महादैत्यावकार्यकरणोद्यतौ ।\nततः परिणतिं यातो लिंगरूपेण कंदुकः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004116036, "chapter_id": 24116, "verse_number": "४-६५-३७", "content_sanskrit": "कंदुकेश्वरसंज्ञं च तल्लिंगमभवत्तदा ।\nज्येष्ठेश्वर समीपे तु सर्वदुष्टनिवारणम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004116037, "chapter_id": 24116, "verse_number": "४-६५-३८", "content_sanskrit": "कंदुकेश समुत्पत्तिं यः श्रोष्यति मुदान्वितः ।\nपूजयिष्यति यो भक्तस्तस्य दुःखभयं कुतः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004116038, "chapter_id": 24116, "verse_number": "४-६५-३९", "content_sanskrit": "कंदुकेश्वर भक्तानां मानवानां निरेनसाम् ।\nयोगक्षेमं सदा कुर्याद्भवानी भयनाशिनी ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004116039, "chapter_id": 24116, "verse_number": "४-६५-४०", "content_sanskrit": "मृडानी तस्य लिंगस्य पूजां कुर्यात्सदैव हि ।\nतत्रैव देव्या सान्निध्यं पार्वत्या भक्तसिद्धिदम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004116040, "chapter_id": 24116, "verse_number": "४-६५-४१", "content_sanskrit": "कंदुकेशं महालिंगं काश्यां यैर्न समर्चितम् ।\nकथं तेषां भवनीशौ स्यातां सर्वेप्सितप्रदौ ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004116041, "chapter_id": 24116, "verse_number": "४-६५-४२", "content_sanskrit": "द्रष्टव्यं च प्रयत्नेन तल्लिंगं कंदुकेश्वरम् ।\nसर्वोपसर्गसंघातविघातकरणं परम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004116042, "chapter_id": 24116, "verse_number": "४-६५-४३", "content_sanskrit": "कंदुकेश्वर नामापि श्रुत्वा वृजिनसंततिः ।\nक्षिप्रं क्षयमवाप्नोति तमः प्राप्योष्णगुं यथा ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004116043, "chapter_id": 24116, "verse_number": "४-६५-४४", "content_sanskrit": "स्कंद उवाच ।\nसंशृणुष्व महाभाग ज्येष्ठेश्वर समीपतः ।\nयद्वृत्तांतमभूद्विप्र परमाश्चर्यकृद्ध्रुवम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004116044, "chapter_id": 24116, "verse_number": "४-६५-४५", "content_sanskrit": "दंडखाते महातीर्थे देवर्षिपितृतृप्तिदे ।\nतप्यमानेषु विप्रेषु निष्कामं परमं तपः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004116045, "chapter_id": 24116, "verse_number": "४-६५-४६", "content_sanskrit": "दैत्यो दुंदुभिनिर्ह्रादो दुष्टः प्रह्लादमातुलः ।\nदेवाः कथं सुजेयाः स्युरित्युपायमचिंतयत् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004116046, "chapter_id": 24116, "verse_number": "४-६५-४७", "content_sanskrit": "किं बलाश्च किमाहाराः किमाधारा हि देवताः ।\nविचार्य बहुशो दैत्यस्तत्त्वं विज्ञाय निश्चितम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004116047, "chapter_id": 24116, "verse_number": "४-६५-४८", "content_sanskrit": "अवश्यमग्रजन्मानो हेतवोत्र विचारतः ।\nब्राह्मणान्हंतुमसकृत्कृतवानुद्यमं ततः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004116048, "chapter_id": 24116, "verse_number": "४-६५-४९", "content_sanskrit": "यतः क्रतुभुजो देवाः क्रतवो वेदसंभवाः ।\nते वेदा ब्राह्मणाधीनास्ततो देवबलं द्विजाः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004116049, "chapter_id": 24116, "verse_number": "४-६५-५०", "content_sanskrit": "निश्चितं ब्राह्मणाधाराः सर्वे वेदाः सवासवाः ।\nगीर्वाणा ब्राह्मणबला नात्र कार्या विचारणा ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004116050, "chapter_id": 24116, "verse_number": "४-६५-५१", "content_sanskrit": "ब्राह्मणा यदि नष्टाः स्युर्वेदा नष्टास्ततः स्वयम् ।\nआम्नायेषु प्रणष्टेषु विनष्टाः शततंतवः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004116051, "chapter_id": 24116, "verse_number": "४-६५-५२", "content_sanskrit": "यज्ञेषु नाशं गच्छत्सु हृताहारास्ततः सुराः ।\nनिर्बलाः सुखजेयाः स्युर्जितेषु त्रिदशेष्वथ ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004116052, "chapter_id": 24116, "verse_number": "४-६५-५३", "content_sanskrit": "अहमेव भविष्यामि मान्यस्त्रिजगतीपतिः ।\nआहरिष्यामि देवानामक्षयाः सर्वसंपदः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004116053, "chapter_id": 24116, "verse_number": "४-६५-५४", "content_sanskrit": "निर्वेक्ष्यामि सुखान्येव राज्ये निहतकंटके ।\nइति निश्चित्य दुर्बुद्धिः पुनश्चिंतितवान्मुने ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004116054, "chapter_id": 24116, "verse_number": "४-६५-५५", "content_sanskrit": "द्विजाः क्व संति भूयांसो ब्रह्मतेजोतिबृंहिताः ।\nश्रुत्यध्ययन संपन्नास्तपोबल समन्विताः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004116055, "chapter_id": 24116, "verse_number": "४-६५-५६", "content_sanskrit": "भूयसां ब्राह्मणानां तु स्थानं वाराणसी भवेत् ।\nतानादावुपसंहृत्य यामि तीर्थांतरं ततः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004116056, "chapter_id": 24116, "verse_number": "४-६५-५७", "content_sanskrit": "यत्रयत्र हि तीर्थेषु यत्रयत्राश्रमेषु च ।\nसंति सर्वेऽग्रजन्मानस्ते मयाद्याः समंततः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004116057, "chapter_id": 24116, "verse_number": "४-६५-५८", "content_sanskrit": "इति दुंदुभिनिर्ह्रादो मतिं कृत्वा कुलोचिताम् ।\nप्राप्यापि काशीं दुर्वृत्तो मायावी न्यवधीद्द्विजान् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004116058, "chapter_id": 24116, "verse_number": "४-६५-५९", "content_sanskrit": "समित्कुशान्समादातुं यत्र यांति द्धिजोत्तमाः ।\nअरण्ये तत्र तान्सर्वान्स भक्षयति दुर्मतिः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004116059, "chapter_id": 24116, "verse_number": "४-६५-६०", "content_sanskrit": "यथा कोपि न वेत्त्येव तथाच्छन्नोऽभवत्पुनः ।\nवने वनेचरो भूत्वा यादोरूपी जलाशये ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004116060, "chapter_id": 24116, "verse_number": "४-६५-६१", "content_sanskrit": "अदृश्यरूपी मायावी देवानामप्यगोचरः ।\nदिवाध्यानपरस्तिष्ठेन्मुनिवन्मुनिमध्यगः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004116061, "chapter_id": 24116, "verse_number": "४-६५-६२", "content_sanskrit": "प्रवेशमुटजानां च निर्गमं च विलोकयन् ।\nयामिन्यां व्याघ्ररूपेण ब्राह्मणान्भक्षयेद्बहून् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004116062, "chapter_id": 24116, "verse_number": "४-६५-६३", "content_sanskrit": "निःशब्दमेव नयति नत्यजेदपि कीकसम् ।\nइत्थं निपातिता विप्रास्तेन दुष्टेन भूरिशः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004116063, "chapter_id": 24116, "verse_number": "४-६५-६४", "content_sanskrit": "एकदा शिवरात्रौ तु भक्तस्त्वेको निजोटजे ।\nसपर्यां देवदेवस्य कृत्वा ध्यानस्थितोभवत् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004116064, "chapter_id": 24116, "verse_number": "४-६५-६५", "content_sanskrit": "स च दुंदुभिनिर्ह्राद दैत्येंद्रो बलदर्पितः ।\nव्याघ्र रूपं समास्थाय तमादातुं मतिं दधे ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004116065, "chapter_id": 24116, "verse_number": "४-६५-६६", "content_sanskrit": "तं भक्तं ध्यानमापन्नं दृढचित्तं शिवेक्षणे ।\nकृतास्त्रमंत्रविन्यासं तं क्रांतुमशकन्न सः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004116066, "chapter_id": 24116, "verse_number": "४-६५-६७", "content_sanskrit": "अथ सर्वगतः शंभुर्ज्ञात्वा तस्याशयं हरः ।\nदैत्यस्य दुष्टरूपस्य वधाय विदधे धियम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004116067, "chapter_id": 24116, "verse_number": "४-६५-६८", "content_sanskrit": "यावदादित्सति व्याघ्रस्तावदाविरभूद्धरः ।\nजगद्रक्षामणिस्त्र्यक्षो भक्तरक्षण दक्षधीः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004116068, "chapter_id": 24116, "verse_number": "४-६५-६९", "content_sanskrit": "रुद्रमायांतमालोक्य तद्भक्तार्चित लिंगतः ।\nदैत्यस्तेनैव रूपेण ववृधे भूधरोपमः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004116069, "chapter_id": 24116, "verse_number": "४-६५-७०", "content_sanskrit": "सावज्ञमथसर्वज्ञं यावत्पश्यति दानवः ।\nतावदायांतमादाय कक्षायंत्रे न्यपीडयत् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004116070, "chapter_id": 24116, "verse_number": "४-६५-७१", "content_sanskrit": "पंचास्यस्त्वथ पंचास्यं मुष्ट्या मूर्धन्यताडयत् ।\nस च तेनैव रूपेण कक्षानिष्पेषणेन च ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004116071, "chapter_id": 24116, "verse_number": "४-६५-७२", "content_sanskrit": "अत्यार्तमरटद्व्याघ्रो रोदसी परिपूरयन् ।\nतेन नादेन सहसा सं प्रवेपितमानसाः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004116072, "chapter_id": 24116, "verse_number": "४-६५-७३", "content_sanskrit": "तपोधनाः समाजग्मुर्निशि शब्दानुसारतः ।\nतत्रेश्वरं समालोक्य कक्षीकृत मृगेश्वरम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004116073, "chapter_id": 24116, "verse_number": "४-६५-७४", "content_sanskrit": "तुष्टुवुः प्रणता सर्वे शर्वं जयजयाक्षरैः ।\nपरित्राता जगत्त्रातः प्रत्यूहाद्दारुणादितः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004116074, "chapter_id": 24116, "verse_number": "४-६५-७५", "content_sanskrit": "अनुग्रहं कुरुध्वेश तिष्ठात्रैव जगद्गुरो ।\nअनेनैव हि रूपेण व्याघ्रेश इति नामतः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004116075, "chapter_id": 24116, "verse_number": "४-६५-७६", "content_sanskrit": "कुरु रक्षां महादेव ज्येष्ठस्थानस्य सर्वदा ।\nअन्येभ्योप्युपसर्गेभ्यो रक्ष नस्तीर्थवासिनः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004116076, "chapter_id": 24116, "verse_number": "४-६५-७७", "content_sanskrit": "इति श्रुत्वा वचस्तेषां देवश्चंद्रविभूषणः ।\nतथेत्युक्त्वा पुनः प्राह शृणुध्वं द्विजपुंगवाः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004116077, "chapter_id": 24116, "verse_number": "४-६५-७८", "content_sanskrit": "यो मामनेन रूपेण द्रक्ष्यति श्रद्धयात्र वै ।\nतस्योपसर्गसंघातं घातयिष्याम्यसंशयम् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004116078, "chapter_id": 24116, "verse_number": "४-६५-७९", "content_sanskrit": "एतल्लिंगं समभ्यर्च्य यो याति पथि मानवः ।\nचौरव्याघ्रादिसंभूत भयं तस्य कुतो भवेत् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004116079, "chapter_id": 24116, "verse_number": "४-६५-८०", "content_sanskrit": "मच्चरित्रमिदं श्रुत्वा स्मृत्वा लिंगमिदं हृदि ।\nसंग्रामे प्रविशन्मर्त्यो जयमाप्नोति नान्यथा ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004116080, "chapter_id": 24116, "verse_number": "४-६५-८१", "content_sanskrit": "इत्युक्त्वा देवदेवशस्तस्मिंल्लिंगे लयं ययौ ।\nसविस्मयास्ततो विप्राः प्रातर्याता यथागतम् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004116081, "chapter_id": 24116, "verse_number": "४-६५-८२", "content_sanskrit": "स्कन्द उवाच ।\nतदा प्रभृति कुंभोत्थ लिंगं व्याघ्रेश्वराभिधम् ।\nज्येष्ठेशादुत्तरेभागे दृष्टं स्पृष्टं भयापहम् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7004116082, "chapter_id": 24116, "verse_number": "४-६५-८३", "content_sanskrit": "व्याघ्रेश्वरस्य ये भक्तास्तेभ्यो बिभ्यति किंकराः ।\nयामा अपि महाक्रूरा जयजीवेति वादिनः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7004116083, "chapter_id": 24116, "verse_number": "४-६५-८४", "content_sanskrit": "पराशरेश्वरादीनां लिंगानामिह संभवम् ।\nश्रुत्वा नरो न लिप्येत महापातककर्दमैः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7004116084, "chapter_id": 24116, "verse_number": "४-६५-८५", "content_sanskrit": "कंदुकेश समुत्पत्तिं व्याघ्रे शाविर्भवं तथा ।\nसमाकर्ण्य नरो जातु नोपसर्गैः प्रदूयते ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7004116085, "chapter_id": 24116, "verse_number": "४-६५-८६", "content_sanskrit": "उटजेश्वर लिंगं तु व्याघ्रेशात्पश्चिमे स्थितम् ।\nभक्तरक्षार्थमुद्भूतं स्यात्समभ्यर्च्य निर्भयः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7004116086, "chapter_id": 24116, "verse_number": "४-६५-८७", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीति साहस्र्यां संहितायां चतुर्थे काशीखण्डे उत्तरार्धे पराशरेश्वरादिलिंगसंभवोनाम पंचषष्टितमोऽध्यायः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}]