[{"id": 2078302, "chapter_id": 2661, "verse_number": "१२-१६६-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2078303, "chapter_id": 2661, "verse_number": "१२-१६६-१", "content_sanskrit": "पितामह महाप्राज्ञ कुरूणां प्रीतिवर्धन।\nप्रश्नं कंचित्प्रवक्ष्यामि तन्मे व्याख्यातुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2078304, "chapter_id": 2661, "verse_number": "१२-१६६-२", "content_sanskrit": "कीदृशा मानवाः सेव्याः कै प्रीति परमा भवेत्।\nआयत्यां च तदात्वे च के क्षमास्तान्वदस्व मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2078305, "chapter_id": 2661, "verse_number": "१२-१६६-३", "content_sanskrit": "न हि तत्र धनं स्फीतं न च संबन्धिबान्धवाः।\nतिष्ठन्ति यत्र सुहृदस्तिष्ठन्तीति मतिर्मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2078306, "chapter_id": 2661, "verse_number": "१२-१६६-४", "content_sanskrit": "दुर्लभो हि सुहृच्छ्रोता दुर्लभश्च हितः सुहृत्।\nएतद्धर्मभृतां श्रेष्ठ सर्वं व्याख्यातुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2078307, "chapter_id": 2661, "verse_number": "१२-१६६-५x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2078308, "chapter_id": 2661, "verse_number": "१२-१६६-५", "content_sanskrit": "सन्धेयान्पुरुषान्राजन्नसन्धेयांश्च तत्त्वतः।\nवदतो मे निबोध त्वं निखिलेन युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2078309, "chapter_id": 2661, "verse_number": "१२-१६६-६", "content_sanskrit": "लुब्धः क्रूरस्त्यक्तधर्मा निकृतिः शठ एव च।\nक्षुद्रः पापसमाचारः सर्वशङ्की तथाऽलसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2078310, "chapter_id": 2661, "verse_number": "१२-१६६-७", "content_sanskrit": "दीर्घसूत्रोऽनृजुः क्रुष्टो गुरुदारप्रधर्पकः।\nव्यसने यः परित्यागी दुरात्मा निरपत्रपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2078311, "chapter_id": 2661, "verse_number": "१२-१६६-८", "content_sanskrit": "सर्वतः पापदर्शी च नास्तिको वेदनिन्दकः।\nसंप्रकीर्णेन्दियो लोके यः कालनिरतश्चरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2078312, "chapter_id": 2661, "verse_number": "१२-१६६-९", "content_sanskrit": "असभ्यो लोकविद्विष्टः समये चानवस्थितः।\nपिशुनोऽथाकृतप्रज्ञो मत्सरी पापनिश्चयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2078313, "chapter_id": 2661, "verse_number": "१२-१६६-१०", "content_sanskrit": "दुःशीलोऽथाकृतात्मा च नृशंसः कितवस्तथा।\nमित्रैरपकृतिर्नित्यमटतेऽर्थं धनेप्सया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2078314, "chapter_id": 2661, "verse_number": "१२-१६६-११", "content_sanskrit": "ददतश्च यथाशक्ति यो न तुष्यति मन्दधीः।\nअधैर्यमपि यो युङ्क्ते सदा मित्रं नराधमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2078315, "chapter_id": 2661, "verse_number": "१२-१६६-१२", "content_sanskrit": "अस्थानक्रोधनो यश्च अकस्माच्च विरज्यते।\nसुहृदश्चैव कल्याणानाशु त्यजति किल्बिपी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2078316, "chapter_id": 2661, "verse_number": "१२-१६६-१३", "content_sanskrit": "अल्पेऽप्यपकृते मूढे न संस्मरनि यत्कृतम्।\nकार्यसेवी च मित्रेषु मित्रद्वेषी नराधिप।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2078317, "chapter_id": 2661, "verse_number": "१२-१६६-१४", "content_sanskrit": "शत्रुर्मित्रमुखो यश्च जिह्नप्रेक्षी विलोचनः।\nन तुष्यति च कल्याणे यम्त्यजेत्तादृशं नरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2078318, "chapter_id": 2661, "verse_number": "१२-१६६-१५", "content_sanskrit": "पानपो द्वेषणः क्रोधी निर्घृणः परुपस्तथा।\nपरोपतापी मित्रध्रुक् तथा प्राणिवधे रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2078319, "chapter_id": 2661, "verse_number": "१२-१६६-१६", "content_sanskrit": "कृतघ्नश्चाधमो लोके न सन्धेयः कथंचन।\nमित्रद्वेषी ह्यसंधेयः सन्धेयानपि मे शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2078320, "chapter_id": 2661, "verse_number": "१२-१६६-१७", "content_sanskrit": "कुलीना वाक्यसंपन्ना ज्ञानविज्ञानकोविदाः।\nरूपवन्तो गुणोपेतास्तथाऽलुब्धा जितश्रमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2078321, "chapter_id": 2661, "verse_number": "१२-१६६-१८", "content_sanskrit": "सन्मित्राश्च कृतज्ञाश्च सर्वज्ञा लोभवर्जिताः।\nमाधुर्यगुणसंपन्नाः सत्यसन्धा जितेन्द्रियाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2078322, "chapter_id": 2661, "verse_number": "१२-१६६-१९", "content_sanskrit": "व्यायामशीलाः सततं भृत्यपुत्राः कुलोद्वहाः।\nदोषैः प्रमुक्ताः प्रथितास्ते ग्राह्याः पार्थिवैर्नराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2078323, "chapter_id": 2661, "verse_number": "१२-१६६-२०", "content_sanskrit": "यथाशक्ति समाचाराः संप्रतुष्यन्ति हि प्रभो।\nनास्थाने क्रोधवन्तश्च न चाकस्माद्विरागिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2078324, "chapter_id": 2661, "verse_number": "१२-१६६-२१", "content_sanskrit": "विरक्ताश्च न दुष्यन्ति मनसाऽप्यर्थकोविदाः।\nआत्मानं पीडयित्वाऽपि सुहृत्कार्यपरायणाः।\nविरज्यन्ति न मित्रेभ्यो वासो रक्तमिवाविकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2078325, "chapter_id": 2661, "verse_number": "१२-१६६-२२", "content_sanskrit": "दोषांश्च लोभमोहादीनर्थेषु युवतीपु च।\nन दर्शयन्ति सुहृदो विश्वस्ता बन्धुवत्सलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2078326, "chapter_id": 2661, "verse_number": "१२-१६६-२३", "content_sanskrit": "लोष्टकाञ्चनतुल्यार्थाः सुहृत्सु दृढबुद्धयः।\nये चरन्त्यनभीमाना निसृष्टार्थविभूषणाः।\nसंगृह्णन्तः परिजनं स्वाम्यर्थपरमाः सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2078327, "chapter_id": 2661, "verse_number": "१२-१६६-२४", "content_sanskrit": "ईदृशैः पुरुषश्रेष्ठैर्यः सन्धिं कुरुते नृपः।\nतस्य विस्तीर्यते राज्यं ज्योत्स्ना ग्रहपतेरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2078328, "chapter_id": 2661, "verse_number": "१२-१६६-२५", "content_sanskrit": "सत्ववन्तो जितक्रोधा बलवन्तो रणे सदा।\nजन्मशीलगुणोपेताः सन्धेयाः पुरुषोत्तमाः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2078329, "chapter_id": 2661, "verse_number": "१२-१६६-२६", "content_sanskrit": "ये च दोपसमायुक्ता नराः प्रोक्ता मयाऽन।\nतेषामप्यधमा राजन्कृतघ्ना मित्रघातकाः।\nत्यक्तव्यास्तु दुराचाराः सर्वेषामिति निश्चयः। ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2078330, "chapter_id": 2661, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि आपद्धर्मपर्वणि षट्षष्ट्यधिकशततमोऽध्यायः॥ १६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]