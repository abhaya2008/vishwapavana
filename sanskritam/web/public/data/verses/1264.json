[{"id": 2012803, "chapter_id": 1264, "verse_number": "२-५-१", "content_sanskrit": "वैशम्पायन उवाच।\nअथ तत्रोपविष्टेषु पाण्डवेषु महात्मसु।\nमहत्सु चोपविष्टेषु गन्धर्वेषु च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2012804, "chapter_id": 1264, "verse_number": "२-५-२", "content_sanskrit": "वेदोपनिषदां वेत्ता ऋषिः सुरगणार्चितः।\nइतिहासपुराणज्ञः क्रियाकल्पविशेषवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2012805, "chapter_id": 1264, "verse_number": "२-५-३", "content_sanskrit": "स्तुतस्तोमग्रहस्तोभपदक्रमविभागवित्।\nशिक्षाक्षरविभागज्ञः पुराकल्पविशेषवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2012806, "chapter_id": 1264, "verse_number": "२-५-४", "content_sanskrit": "आदिकल्पार्थवेत्ता च कल्पसूत्रार्थतत्त्ववित्।\nब्रह्मचर्यव्रतपर ऊहापोहविशारदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2012807, "chapter_id": 1264, "verse_number": "२-५-५", "content_sanskrit": "नृत्तगान्धर्वसेवी च सर्वत्राप्रतिमस्तथा।\nअष्टादशानां विद्यानां कोशभूतो महाद्युतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2012808, "chapter_id": 1264, "verse_number": "२-५-६", "content_sanskrit": "न्यायविद्धर्मतत्त्वज्ञः षडङ्गविदनुत्तमः।\nऐक्यसंयोगनानात्वसमवायविशारदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2012809, "chapter_id": 1264, "verse_number": "२-५-७", "content_sanskrit": "वक्ता प्रगल्भो मेधावी स्मृतिमान्नयवित्कविः।\nपरापरविभागज्ञः प्रमाणकृतनिश्चयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2012810, "chapter_id": 1264, "verse_number": "२-५-८", "content_sanskrit": "पञ्चावयवयुक्तस्य वाक्यस्य गुणदोषवित्।\nउत्तरोत्तरवक्ता च वदतोपि बृहस्पतेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2012811, "chapter_id": 1264, "verse_number": "२-५-९", "content_sanskrit": "धर्मकामार्थमोक्षेषु यथावत्कृतनिश्चयः।\nतथा भुवनकोशस्य सर्वस्यास्य महामतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2012812, "chapter_id": 1264, "verse_number": "२-५-१०", "content_sanskrit": "प्रत्यक्षदर्शी लोकस्य तिर्यगूर्ध्वमधस्तथा।\nसाङ्ख्ययोगविभागज्ञो निर्विवित्सुः सुरासुरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2012813, "chapter_id": 1264, "verse_number": "२-५-११", "content_sanskrit": "सन्धिविग्रहतत्त्वज्ञस्त्वनुमानविभागवित्।\nषाङ्गुण्यविधियुक्तश्च सर्वशास्त्रविशारदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2012814, "chapter_id": 1264, "verse_number": "२-५-१२", "content_sanskrit": "युद्धगान्धर्वसेवी च सर्वत्राप्रतिघस्तथा।\nएतैश्चान्यैश्च बहुभिर्युक्तो गुणगणैर्मुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2012815, "chapter_id": 1264, "verse_number": "२-५-१३", "content_sanskrit": "लोकाननुचरन्सर्वानागमत्तां सभां नृप।\nनारदः सुमहातेजा ऋषिभिः सहितस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2012816, "chapter_id": 1264, "verse_number": "२-५-१४", "content_sanskrit": "पारिजातेन राजेन्द्र पर्वतेन च धीमता।\nसुमुखेन च सौम्येन देवर्षिरमितद्युतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2012817, "chapter_id": 1264, "verse_number": "२-५-१५", "content_sanskrit": "सभास्थान्पाण्डवान्द्रष्टुं प्रीयमाणो मनोजवः।\nजयाशीर्भिस्तु तं विप्रो धर्मराजानमार्चयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2012818, "chapter_id": 1264, "verse_number": "२-५-१६", "content_sanskrit": "तमागतमृषिं दृष्ट्वा नारदं सर्वधर्मवित्।\nसहसा पाण्डवश्रेष्ठः प्रत्युत्थायानुजैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2012819, "chapter_id": 1264, "verse_number": "२-५-१७", "content_sanskrit": "अभ्यवादयत प्रीत्या विनयावनतस्तदा।\nतदर्हमासनं तस्मै सम्प्रदाय यथाविधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2012820, "chapter_id": 1264, "verse_number": "२-५-१८", "content_sanskrit": "गां चैव मधुपर्कं च सम्प्रदायार्घ्यमेव च।\nअर्चयामास रत्नैश्च सर्वकामैश्च धर्मवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2012821, "chapter_id": 1264, "verse_number": "२-५-१९", "content_sanskrit": "तुतोष च यथावच्च पूजां प्राप्य युधिष्ठिरात्।\nसोऽर्चितः पाण्डवैः सर्वैर्महर्षिर्वेदपारगः।\nधर्मकामार्थसंयुक्तं पप्रच्छेदं युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2012822, "chapter_id": 1264, "verse_number": "२-५-२०x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2012823, "chapter_id": 1264, "verse_number": "२-५-२०", "content_sanskrit": "कच्चिदर्थाश्च कल्पन्ते धर्मे च रमते मनः।\nसुखानि चानुभूयन्ते मनश्च न विहन्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2012824, "chapter_id": 1264, "verse_number": "२-५-२१", "content_sanskrit": "कच्चिदाचरितां पूर्वैर्नरदेवपितामहैः।\nवर्तसे वृत्तिमक्षुद्रां धर्मार्थसहितां त्रिषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2012825, "chapter_id": 1264, "verse_number": "२-५-२२", "content_sanskrit": "कच्चिदर्थेन वा धर्मं धर्मेणार्थमथापि वा।\nउभौ वा प्रीतिसारेण न कामेन प्रबाधसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2012826, "chapter_id": 1264, "verse_number": "२-५-२३", "content_sanskrit": "कच्चिदर्थं च धर्मं च कामं च जयतां वर।\nविभज्य काले कालज्ञः सदा वरद सेवसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2012827, "chapter_id": 1264, "verse_number": "२-५-२४", "content_sanskrit": "कच्चिद्राजगुणैः षड्भिः सप्तोपायांस्तथाऽनघ।\nबलाबलं तथा सम्यक्वतुर्दश परीक्षसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2012828, "chapter_id": 1264, "verse_number": "२-५-२५", "content_sanskrit": "कच्चिदात्सानमर्न्वाक्ष्य परांश्च जयतां वर।\nतथा सन्धाय कर्माणि अष्टौ भारत सेवसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2012829, "chapter_id": 1264, "verse_number": "२-५-२६", "content_sanskrit": "कच्चित्प्रकृतयः सप्त न लुप्ता भरतर्षभ।\nआढ्यास्तथा व्यसनिनः स्वनुरक्ताश्च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2012830, "chapter_id": 1264, "verse_number": "२-५-२७", "content_sanskrit": "कच्चिन्न कृतकैर्दूतैर्ये चाप्यपरिशङ्किताः।\nत्वत्तो वा तव चामात्यैर्भिद्यते मन्त्रितं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2012831, "chapter_id": 1264, "verse_number": "२-५-२८", "content_sanskrit": "मित्रोदासीनशत्रूणां कच्चिद्वेत्सि चिकीर्षितम्।\nकच्चित्सन्धिं यथाकालं विग्रहं चोपसेवसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2012832, "chapter_id": 1264, "verse_number": "२-५-२९", "content_sanskrit": "कच्चिद्वृत्तिमुदासीने मध्यमे चानुमन्यसे।\nकच्चिदात्मसमा वृद्धाः शुद्धाः सम्बोधनक्षमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2012833, "chapter_id": 1264, "verse_number": "२-५-३०", "content_sanskrit": "कुलीनाश्चानुरक्ताश्च कृतास्ते वीरमन्त्रिणः।\nविजयो मन्त्रमूलो हि राज्ञो भवति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2012834, "chapter_id": 1264, "verse_number": "२-५-३१", "content_sanskrit": "कच्चित्संवृतमन्त्रैस्ते अमात्यैः शास्त्रकोविदैः।\nराष्ट्रं सुरक्षितं तात शत्रुभिर्न विलुप्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2012835, "chapter_id": 1264, "verse_number": "२-५-३२", "content_sanskrit": "कच्चिन्निद्रावशं नैषि कच्चित्काले विबुद्ध्यसे।\nकच्चिच्चापररात्रेषु चिन्तयस्यर्थमर्थवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2012836, "chapter_id": 1264, "verse_number": "२-५-३३", "content_sanskrit": "कच्चिन्मन्त्रयसे नैकः कच्चिन्न बहुभिः सह।\nकच्चित्ते मन्त्रितो मन्त्रो न राष्ट्रं परिधावति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2012837, "chapter_id": 1264, "verse_number": "२-५-३४", "content_sanskrit": "कच्चिदर्थान्विनिश्चित्य लघुमूलान्महोदयान्।\nक्षिप्रमारभसे कर्तुं न विघ्नयसि तादृशान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2012838, "chapter_id": 1264, "verse_number": "२-५-३५", "content_sanskrit": "कच्चिन्न स्रवे कर्मान्ताः परोक्षास्ते विशङ्किताः।\nसर्वे वा पुनरुत्सृष्टाः संसृष्टं चात्र कारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2012839, "chapter_id": 1264, "verse_number": "२-५-३६", "content_sanskrit": "आप्तैरलुब्धैः क्रमिकैस्ते च कच्चिदनुष्ठिताः।\nकच्चिद्राजन्कृतान्येव कृतप्रायाणि वा पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2012840, "chapter_id": 1264, "verse_number": "२-५-३७", "content_sanskrit": "विदुस्ते वीर कर्माणि नानवाप्तानि कानिचित्।\nकच्चित्कारणिका धर्मे सर्वशास्त्रेषु कोविदाः।\nकारयन्ति कुमारांश्च योधमुख्यांश्च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2012841, "chapter_id": 1264, "verse_number": "२-५-३८", "content_sanskrit": "कच्चित्सहस्रैर्मूर्खाणामेकं क्रीणासि पण्डितम्।\nपण्डितो ह्यर्थकृच्छ्रेषु कुर्यान्नः श्रेयसं परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2012842, "chapter_id": 1264, "verse_number": "२-५-३९", "content_sanskrit": "कच्चिद्दुर्गाणि सर्वाणि धनधान्यायुधोदकैः।\nयन्त्रैश्च परिपूर्णानि तथा शिल्पिधनुर्धरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2012843, "chapter_id": 1264, "verse_number": "२-५-४०", "content_sanskrit": "एकोप्यमात्यो मेधावी शूरो दान्तो विचक्षणः।\nराजानं राजपुत्रं वा प्रापयेन्महतीं श्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2012844, "chapter_id": 1264, "verse_number": "२-५-४१", "content_sanskrit": "कच्चिदष्टादशान्येषु स्वपक्षे दश पञ्च च।\nत्रिभिस्त्रिभिरविज्ञातैर्वेत्सि तीर्थानि चारकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2012845, "chapter_id": 1264, "verse_number": "२-५-४२", "content_sanskrit": "कच्चिद्द्विषामविदितः प्रतिपन्नश्च सरवदा।\nनित्ययुक्तो रिपून्सर्वान्वीक्षसे रिपुसूदन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2012846, "chapter_id": 1264, "verse_number": "२-५-४३", "content_sanskrit": "कच्चिद्विनयसम्पन्नः कुलपुत्रो बहुश्रुतः।\nअनसूयुरनुप्रष्टा सत्कृतस्ते पुरोहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2012847, "chapter_id": 1264, "verse_number": "२-५-४४", "content_sanskrit": "कच्चिदग्निषु ते युक्तो विधिज्ञो मतिमानृजुः।\nहुतं च होष्यमाणं च काले वेदयते सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2012848, "chapter_id": 1264, "verse_number": "२-५-४५", "content_sanskrit": "कच्चिदङ्गेषु निष्णातो ज्योतिपः प्रतिपादकः।\nउत्पातेषु च सर्वेषु दैवज्ञः कुशलस्तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2012849, "chapter_id": 1264, "verse_number": "२-५-४६", "content_sanskrit": "कच्चिन्मुख्या महत्स्वेव मध्यमेषु च मध्यमाः।\nजघन्याश्च जघन्येषु भृत्याः कर्मसु योजिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2012850, "chapter_id": 1264, "verse_number": "२-५-४७", "content_sanskrit": "अमात्यानुपधातीतान्पितृपैतामहाञ्शुचीन्।\nश्रेष्ठाञ्श्रेष्ठेषु कच्चित्त्वं नियोजयसि कर्मसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2012851, "chapter_id": 1264, "verse_number": "२-५-४८", "content_sanskrit": "कच्चिन्नोग्रेण दण्डेन भृशमुद्विजसे प्रजाः।\nराष्ट्रं तवानुशासन्ति मन्त्रिणो भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2012852, "chapter_id": 1264, "verse_number": "२-५-४९", "content_sanskrit": "कच्चित्त्वां नावजानन्ति याजकाः पतितं यथा।\nउग्रप्रतिग्रहीतारं कामयानमिव स्त्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2012853, "chapter_id": 1264, "verse_number": "२-५-५०", "content_sanskrit": "कच्चिद्धृष्टश्च शूरश्च मतिमान्धृतिमाञ्शुचिः।\nकुलीनश्चानुरक्तश्च दक्षः सेनापतिस्तथा।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2012854, "chapter_id": 1264, "verse_number": "२-५-५१", "content_sanskrit": "कच्चिद्बलस्य ते मुख्याः सर्वयुद्धविशारदाः।\nधृष्टावदाता विक्रान्तास्त्वया सत्कृत्य मानिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2012855, "chapter_id": 1264, "verse_number": "२-५-५२", "content_sanskrit": "कच्चिद्वलस्य भक्तं च वेतनं च यथोचितम्।\nसम्प्राप्तकाले दातव्यं ददासि न विकर्षसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2012856, "chapter_id": 1264, "verse_number": "२-५-५३", "content_sanskrit": "कालातिक्रमणादेते भक्तवेतनयोर्भृताः।\nभर्तुः कुप्यन्ति दौर्गत्यात्सोऽनर्थः सुमहान्स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2012857, "chapter_id": 1264, "verse_number": "२-५-५४", "content_sanskrit": "कच्चित्सर्वेऽनुरक्तास्त्वां कुलपुत्राः प्रधानतः।\nकच्चित्प्राणांस्तवार्थेषु सन्त्यजन्ति सदा युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2012858, "chapter_id": 1264, "verse_number": "२-५-५५", "content_sanskrit": "कच्चिन्नैको बहूनर्थान्सर्वशः साम्परायिकान्।\nअनुशास्ति यथाकामं कामात्मा शासनातिगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2012859, "chapter_id": 1264, "verse_number": "२-५-५६", "content_sanskrit": "कच्चित्पुरुषकारेण पुरुषः कर्म शोभयन्।\nलभते मानमधिकं भूयो वा भक्तवेतनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2012860, "chapter_id": 1264, "verse_number": "२-५-५७", "content_sanskrit": "कच्चिद्विद्याविनीतांश्च नराञ्ज्ञानविशारदान्।\nयथार्हं गुणतश्चैव दानेनाभ्युपपद्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2012861, "chapter_id": 1264, "verse_number": "२-५-५८", "content_sanskrit": "कच्चिद्दारान्मनुष्याणां तवार्थे मृत्युमीयुषाम्।\nव्यसनं चाभ्युपेतानां बिभर्षि भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2012862, "chapter_id": 1264, "verse_number": "२-५-५९", "content_sanskrit": "कच्चिद्भयादुपगतं क्षीणं वा रिपुमागतम्।\nयुद्धे वा विजितं पार्थ पुत्रवत्परिरक्षसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2012863, "chapter_id": 1264, "verse_number": "२-५-६०", "content_sanskrit": "कच्चित्त्वमेव सर्वस्याः पृथिव्याः पृथिवीपते।\nसमश्चानभिशङ्क्यश्च यथा माता यथा पिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2012864, "chapter_id": 1264, "verse_number": "२-५-६१", "content_sanskrit": "कच्चिद्व्यसनिनं शत्रुं निशम्य भरतर्षभ।\nअभियासि जवेनैव समीक्ष्य त्रिविधं बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2012865, "chapter_id": 1264, "verse_number": "२-५-६२", "content_sanskrit": "यात्रामारभसे दिष्ट्या प्राप्तकालमरिन्दम।\nपार्ष्णिमूलं च विज्ञाय व्यवसायं पराजयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2012866, "chapter_id": 1264, "verse_number": "२-५-६३", "content_sanskrit": "बलस्य च महाराज दत्त्वा वेतनमग्रतः।\nकच्चिच्च बलमुख्येभ्यः परराष्ट्रे परन्तप।\nउपच्छन्नानि रत्नानि प्रयच्छसि यथार्हतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2012867, "chapter_id": 1264, "verse_number": "२-५-६४", "content_sanskrit": "कच्चिदात्मानमेवाग्रे विजित्य विजितेन्द्रियः।\nपारञ्जिगीषसे पार्थ प्रमत्तानजितेन्द्रियान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2012868, "chapter_id": 1264, "verse_number": "२-५-६५", "content_sanskrit": "कच्चित्ते यास्यतः शत्रून्पर्वं यान्ति स्वनुष्ठिताः।\nसाम दानं च भेदश्च दण्डश्च विधिवद्गुणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2012869, "chapter_id": 1264, "verse_number": "२-५-६६", "content_sanskrit": "तांश्च विक्रमसे जेतुं जित्वा च परिरक्षसि॥\nकच्चिदष्टाङ्गसंयुक्ता चतुर्विधबला चमूः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2012870, "chapter_id": 1264, "verse_number": "२-५-६७", "content_sanskrit": "बलमुख्यैः सुनीता ते द्विषतां प्रतिवर्धिनी ॥\nकच्चिल्लवं च मुष्टिं च परराष्ट्रे परन्तप।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2012871, "chapter_id": 1264, "verse_number": "२-५-६८", "content_sanskrit": "अविहाय महाराज निहंसि समरे रिपून्॥\nकच्चित्स्वपरराष्ट्रेषु बहवोऽधिकृतास्तव।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2012872, "chapter_id": 1264, "verse_number": "२-५-६९", "content_sanskrit": "अर्थान्समधितिष्ठन्ति रक्षन्ति च परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2012873, "chapter_id": 1264, "verse_number": "२-५-७०", "content_sanskrit": "कच्चिदभ्यवहार्याणि गात्रसंस्पर्शनानि च।\nघ्रेयाणि च महाराज रक्षन्त्यनुमतास्तव।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2012874, "chapter_id": 1264, "verse_number": "२-५-७१", "content_sanskrit": "कच्चित्कोशश्च कोष्ठं च वाहनं द्वारमायुधम्॥\nआयश्च कृतकल्याणैस्तव भक्तैरनुष्ठितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2012875, "chapter_id": 1264, "verse_number": "२-५-७२", "content_sanskrit": "कच्चिदाभ्यन्तरेभ्यश्च बाह्येभ्यश्च विशाम्पते॥\nरक्षस्यात्मानमेवाग्रे तांश्च स्वेभ्यो मिथश्च तान्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2012876, "chapter_id": 1264, "verse_number": "२-५-७३", "content_sanskrit": "कच्चिन्न पाने द्यूते वा क्रीडासु प्रमदासु च।\nप्रतिजानन्ति पूर्वाह्णे व्ययं व्यसनजं तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2012877, "chapter_id": 1264, "verse_number": "२-५-७४", "content_sanskrit": "कच्चिदायस्य चार्धेन चतुर्भागेन वा पुनः।\nपादभागैस्त्रिभिर्वापि व्ययः संशुद्ध्यते तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2012878, "chapter_id": 1264, "verse_number": "२-५-७५", "content_sanskrit": "कच्चिज्ज्ञातीन्गुरून्वृद्धा-\nन्वणिजः शिल्पिनः श्रितान्।\nअभीक्ष्णमनुगृहाणिसि\nधनधान्येन दुर्गतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2012879, "chapter_id": 1264, "verse_number": "२-५-७६", "content_sanskrit": "कच्चिच्चायव्यये युक्ताः सर्वे गणकलेखकाः।\nअनुतिष्ठन्ति पूर्वाह्णे नित्यमायं व्ययं तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2012880, "chapter_id": 1264, "verse_number": "२-५-७७", "content_sanskrit": "कच्चिदर्थेषु सम्प्रौढान्हितकामाननुप्रियान्।\nनापकर्षसि कर्मभ्यः पूर्वमप्राप्य किल्बिषम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2012881, "chapter_id": 1264, "verse_number": "२-५-७८", "content_sanskrit": "कच्चिद्विदित्वा पुरुषानुत्तमाधममध्यमान्।\nत्वं कर्मस्वनुरूपेषु नियोजयसि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2012882, "chapter_id": 1264, "verse_number": "२-५-७९", "content_sanskrit": "कच्चिन्न लुब्धाश्चौरा वा वैरिणो वा विशाम्पते।\nअप्राप्तव्यवहारा वा तव कर्मस्वनुष्ठिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2012883, "chapter_id": 1264, "verse_number": "२-५-८०", "content_sanskrit": "कच्चिन्न चौरैर्लुब्धैर्वा कुमारैः स्त्रीबलेन वा।\nत्वया वा पीड्यते राष्ट्रं कच्चित्तुष्टाः कृषीवलाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2012884, "chapter_id": 1264, "verse_number": "२-५-८१", "content_sanskrit": "कच्चिद्राष्ट्रे तटाकानि पूर्णानि च बृहन्ति च।\nभागशो विनिविष्टानि न कृषिर्देवमातृका॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2012885, "chapter_id": 1264, "verse_number": "२-५-८२", "content_sanskrit": "कच्चिन्नं भक्तं बीजं च कर्षकस्यावसीदति।\nप्रत्येकं च शतं वृद्ध्या ददास्यृणमनुग्रहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2012886, "chapter_id": 1264, "verse_number": "२-५-८३", "content_sanskrit": "कच्चित्स्वनुष्ठिता तात वार्ता ते साधुभिर्जनैः।\nवार्तायां संश्रितस्तात लोकोऽयं सुखमेधते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2012887, "chapter_id": 1264, "verse_number": "२-५-८४", "content_sanskrit": "कच्चिच्छूराः कृतप्रज्ञाः पञ्चपञ्च स्वनुष्ठिताः।\nक्षेमं कुर्वन्ति संहत्य राजञ्जनपदे तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2012888, "chapter_id": 1264, "verse_number": "२-५-८५", "content_sanskrit": "कच्चिन्नगरगुप्त्यर्थं ग्रामा नगरवत्कृताः।\nग्रामवच्च कृताः प्रान्तास्ते च सर्वे त्वदर्पणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2012889, "chapter_id": 1264, "verse_number": "२-५-८६", "content_sanskrit": "कच्चिद्बलेनानुगताः समानि विषमाणि च।\nपुराणि चौरान्निघ्नन्तश्चरन्ति विषये तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2012890, "chapter_id": 1264, "verse_number": "२-५-८७", "content_sanskrit": "कच्चित्स्रियः सान्त्वयसि कच्चित्ताश्च सुरक्षिताः।\nकच्चिन्न श्रद्दधास्यासां कच्चिद्गुह्यं न भाषसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2012891, "chapter_id": 1264, "verse_number": "२-५-८८", "content_sanskrit": "कच्चिदात्ययिकं श्रुत्वा तदर्थमनुचिन्त्य च।\nप्रियाण्यनुभवञ्शेषे न त्वमन्तः पुरे नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2012892, "chapter_id": 1264, "verse_number": "२-५-८९", "content_sanskrit": "कच्चिद्द्वौ प्रथमौ यामौ रात्रेः सुप्त्वा विशाम्पते।\nसञ्चिन्तयसि धर्मार्थौ याम उत्थाय पश्चिमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2012893, "chapter_id": 1264, "verse_number": "२-५-९०", "content_sanskrit": "कच्चिद्दर्शयसे नित्यं मनुष्यान्समलङ्कृतः।\nउत्थाय काले कालज्ञैः सह पाण्डव मन्त्रिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2012894, "chapter_id": 1264, "verse_number": "२-५-९१", "content_sanskrit": "कच्चिद्रक्ताम्बरधराः खड्गहस्ताः स्वलङ्कृताः।\nउपासते त्वामभितो रक्षणार्थमरिन्दम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2012895, "chapter_id": 1264, "verse_number": "२-५-९२", "content_sanskrit": "कच्चिद्दण्ड्येषु यमवत्पूज्येषु च विशाम्पते।\nपरीक्ष्य वर्तसे सम्यगप्रियेषु प्रियेषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2012896, "chapter_id": 1264, "verse_number": "२-५-९३", "content_sanskrit": "कच्चिच्छारीरमाबाधमौषधैर्नियमेन वा।\nमानसं वृद्धसेवाभिः सदा पार्थापकर्षसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2012897, "chapter_id": 1264, "verse_number": "२-५-९४", "content_sanskrit": "कच्चिद्वैद्याश्चिकित्सायामष्टाङ्गायां विशारदाः।\nसुहृदश्चानुरक्ताश्च शरीरे ते हिताः सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2012898, "chapter_id": 1264, "verse_number": "२-५-९५", "content_sanskrit": "कच्चिन्न लोभान्मोहाद्वा मानाद्वापि विशाम्पते।\nअर्थिप्रत्यर्थिनः प्राप्तान्नापास्यसि कथञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2012899, "chapter_id": 1264, "verse_number": "२-५-९६", "content_sanskrit": "कच्चिन्न लोभान्मोहाद्वा विश्रम्भात्प्रणयेन वा।\nआश्रितानां मनुष्याणां वृत्तिं त्वं संरुणात्सि वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2012900, "chapter_id": 1264, "verse_number": "२-५-९७", "content_sanskrit": "कच्चित्पौरा न सहिता ये च ते राष्ट्रवासिनः।\nत्वया सह विरुध्यन्ते परैः क्रीताः कथञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2012901, "chapter_id": 1264, "verse_number": "२-५-९८", "content_sanskrit": "कच्चिन्न दुर्बलः शत्रुर्बलेन परिपीडितः।\nमन्त्रेण बलवान्कश्चिदुभाभ्यां च कथञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2012902, "chapter_id": 1264, "verse_number": "२-५-९९", "content_sanskrit": "कच्चित्सर्वेऽनुरक्तास्त्वां भूमिपालाः प्रधानतः।\nकच्चित्प्राणांस्त्वदर्थेषु सन्त्यजन्ति त्वया हृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2012903, "chapter_id": 1264, "verse_number": "२-५-१००", "content_sanskrit": "कच्चित्ते सर्वविद्यासु गुणतोऽर्चा प्रवर्तते।\nब्राह्मणानां च साधूनां तव नैः श्रेयसी शुभा।\nदक्षिणास्त्वं ददास्येषां नित्यं स्वर्गापवर्गदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2012904, "chapter_id": 1264, "verse_number": "२-५-१०१", "content_sanskrit": "कच्चिद्धर्मे त्रयीमूले पूर्वैराचरिते जनैः।\nयतमानस्तथा कर्तुं तस्मिन्कर्मणि वर्तसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2012905, "chapter_id": 1264, "verse_number": "२-५-१०२", "content_sanskrit": "कच्चित्तव गृहेऽन्नानि स्वादून्यश्रन्ति वै द्विजाः।\nगुणवन्ति गुणोपेतास्तवाध्यक्षं सदक्षिणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2012906, "chapter_id": 1264, "verse_number": "२-५-१०३", "content_sanskrit": "कच्चित्क्रतूनेकचित्तो वाजपेयांश्च सर्वशः।\nपौण्डरीकांश्च कार्त्स्न्येन यतसे कर्तुमात्मवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2012907, "chapter_id": 1264, "verse_number": "२-५-१०४", "content_sanskrit": "कच्चिज्ज्ञातीन्गुरून्वृद्धान्दैवतांस्तापसानपि।\nचैत्यांश्च वृक्षान्कल्याणान्ब्राह्मणांश्च नमस्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2012908, "chapter_id": 1264, "verse_number": "२-५-१०५", "content_sanskrit": "कच्चिच्छोको न मन्युर्वा त्वया प्रोत्पाद्यतेऽनघ।\nअपि मङ्गलहस्तश्च जनः पार्श्वे न तिष्ठति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2012909, "chapter_id": 1264, "verse_number": "२-५-१०६", "content_sanskrit": "कच्चिदेषा च ते बुद्धिर्वृत्तिरेषा च तेऽनघ।\nआयुष्या च यशस्या च धर्मकामार्थदर्शिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2012910, "chapter_id": 1264, "verse_number": "२-५-१०७", "content_sanskrit": "एतया वर्तमानस्य बुद्ध्या राष्ट्रं न सीदति।\nविजित्य च महीं राजा सोत्यन्तं सुखमेधते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2012911, "chapter_id": 1264, "verse_number": "२-५-१०८", "content_sanskrit": "कच्चिदार्यो विशुद्धात्मा क्षारितश्चौरकर्मणि।\nअदृष्टशास्त्रकुशलैर्न लोभाद्वध्यते शुचि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2012912, "chapter_id": 1264, "verse_number": "२-५-१०९", "content_sanskrit": "दुष्टो गृहीतस्तत्कारितज्ज्ञैर्दृष्टः सकारणः।\nकच्चिन्न मुच्यते स्तेनो द्रव्यलोभान्नरर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2012913, "chapter_id": 1264, "verse_number": "२-५-११०", "content_sanskrit": "उत्पन्नानकच्चिदाढ्यस्य दरिद्रस्य च भारत।\nअर्थान्न मिथ्या पश्यन्ति तवामात्या हृता धनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2012914, "chapter_id": 1264, "verse_number": "२-५-१११", "content_sanskrit": "नास्तिक्यमनृतं क्रोधं प्रमादं दीर्घसूत्रताम्।\nअदर्शनं ज्ञानवतामालस्यं पञ्चवृत्तिताम्।\nएकचिन्तनमर्थानामनर्थज्ञैश्च चिन्तनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2012915, "chapter_id": 1264, "verse_number": "२-५-११२", "content_sanskrit": "निश्चितानामनारम्भं मन्त्रस्यापरिरक्षणम्।\nमङ्गलाद्यप्रयोगं च प्रत्युत्थानं च सर्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2012916, "chapter_id": 1264, "verse_number": "२-५-११३", "content_sanskrit": "कच्चित्त्वं वर्जयस्येतान्राजदोषांश्चतुर्दश।\nप्रायशोयैर्विनश्यन्ति कृतमूलापि पार्थिवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2012917, "chapter_id": 1264, "verse_number": "२-५-११४", "content_sanskrit": "कच्चित्ते सफला वेदाः कच्चित्ते सफळं धनम्।\nकच्चित्ते सफला दाराः कच्चित्ते सफलं श्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2012918, "chapter_id": 1264, "verse_number": "२-५-११५x", "content_sanskrit": "युधिष्ठिर उवाच ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2012919, "chapter_id": 1264, "verse_number": "२-५-११५", "content_sanskrit": "कथं वै सफला वेदाः कथं वै सफलं धनम्।\nकथं वै सफला दाराः कथं वै सफलं श्रुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2012920, "chapter_id": 1264, "verse_number": "२-५-११६x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2012921, "chapter_id": 1264, "verse_number": "२-५-११६", "content_sanskrit": "अग्निहोत्रफला वेदा दत्तभुक्तफलं धनम्।\nरतिपुत्रफला दाराः शीलवृत्तफलं श्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2012922, "chapter_id": 1264, "verse_number": "२-५-११७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2012923, "chapter_id": 1264, "verse_number": "२-५-११७", "content_sanskrit": "एतदाख्याय स मुनिर्नारदो वै महातपाः।\nपप्रच्छानन्तरमिदं धर्मात्मानं युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2012924, "chapter_id": 1264, "verse_number": "२-५-११८x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2012925, "chapter_id": 1264, "verse_number": "२-५-११८", "content_sanskrit": "कच्चिदभ्यागता दूराद्वणिजो लाभकारणात्।\nयथोक्तमवहार्यन्ते शुल्कं शुल्कोपजीविभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2012926, "chapter_id": 1264, "verse_number": "२-५-११९", "content_sanskrit": "कच्चित्ते पुरुषा राजन्पुरे राष्ट्रे च मानिताः।\nउपानयन्ति पण्यानि उपाधाभिरवञ्चिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2012927, "chapter_id": 1264, "verse_number": "२-५-१२०", "content_sanskrit": "कच्चिच्छृणोषि वृद्धानां धर्मार्थसहिता गिरः।\nनित्यमर्थविदां तात यथाधर्मार्थदर्शिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2012928, "chapter_id": 1264, "verse_number": "२-५-१२१", "content_sanskrit": "कच्चित्ते कृषितन्त्रेषु गोषु पुष्पफलेषु च।\nधर्मार्थं च द्विजातिभ्यो दीयेते मधुसर्पिषी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 2012929, "chapter_id": 1264, "verse_number": "२-५-१२२", "content_sanskrit": "द्रव्योपकरणं किञ्चित्सर्वदा सर्वशिल्पिनाम्।\nचातुर्मास्यावरं सम्यङ्नियतं सम्प्रयच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 2012930, "chapter_id": 1264, "verse_number": "२-५-१२३", "content_sanskrit": "कच्चित्कृतं विजानीषे कर्तारं च प्रशंससि।\nसतां मध्ये महाराज सत्करोषि च पूजयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 2012931, "chapter_id": 1264, "verse_number": "२-५-१२४", "content_sanskrit": "कच्चित्सूत्राणि सर्वाणि गृह्णासि भरतर्षभ।\nहस्तिसूत्राश्वसूत्राणि रथसूत्राणि वा विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 2012932, "chapter_id": 1264, "verse_number": "२-५-१२५", "content_sanskrit": "कच्चिदभ्यस्यते सम्यग्गृहे ते भरतर्षभ।\nधनुर्वेदस्य सूत्रं वै यन्त्रसूत्रं च नागरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 2012933, "chapter_id": 1264, "verse_number": "२-५-१२६", "content_sanskrit": "कच्चिदस्त्राणि सर्वाणि ब्रह्मदण्डश्च तेऽनघ।\nविषयोगास्तथा सर्वे विदिताः शत्रुनाशनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 2012934, "chapter_id": 1264, "verse_number": "२-५-१२७", "content_sanskrit": "कच्चिदग्निभयाच्चैव सर्वं व्यालभयात्तथा।\nरोगरक्षोभयाच्चैव राष्ट्रं स्वं परिरक्षशि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 2012935, "chapter_id": 1264, "verse_number": "२-५-१२८", "content_sanskrit": "कच्चिदन्धांश्च मूकांश्च पङ्गून्व्यङ्गानबान्धवान्।\nपितेव पासि धर्मज्ञ तथा प्रव्रजितानपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 2012936, "chapter_id": 1264, "verse_number": "२-५-१२९", "content_sanskrit": "षडवर्था महाराज कच्चित्ते पृष्ठतः कृताः।\nनिद्राऽऽलस्यं भयं क्रोधो मार्दवं दीर्घसूत्रता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 2012937, "chapter_id": 1264, "verse_number": "२-५-१३०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 2012938, "chapter_id": 1264, "verse_number": "२-५-१३०", "content_sanskrit": "ततः कुरूणामृषभो महात्मा\nश्रुत्वा गिरो ब्राह्मणसत्तमस्य।\nप्रणम्य पादावभिवाद्य तुष्टो\nराजाऽब्रवीन्नारदं देवरूपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 2012939, "chapter_id": 1264, "verse_number": "२-५-१३१", "content_sanskrit": "एवं करिष्यामि यथा त्वयोक्तं\nप्रज्ञा हि मे भूय एवाभिवृद्धा।\nउक्त्वा तथा चैव चकार राजा\nलेभे महीं सागरमेखलां च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 2012940, "chapter_id": 1264, "verse_number": "२-५-१३२x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 2012941, "chapter_id": 1264, "verse_number": "२-५-१३२", "content_sanskrit": "एवं यो वर्तते राजा चातुर्वर्ण्यस्य रक्षणे।\nस विहृत्येह सुसुखी शुक्रस्यैति सलोकताम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 2012942, "chapter_id": 1264, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि पञ्चमोऽध्यायः॥ ५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}]