[{"id": 6000043000, "chapter_id": 10043, "verse_number": null, "content_sanskrit": "अथ त्रयोदशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000043001, "chapter_id": 10043, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_013/BhP_03.013.001.m4a", "display_order": 2}, {"id": 6000043002, "chapter_id": 10043, "verse_number": "३-१३-१", "content_sanskrit": "इति ते वर्णितः क्षत्तः कालाख्यः परमात्मनः।\nमहिमा वेदगर्भोऽथ यदस्राक्षीन्निबोध मे॥ ३/१३/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_013/BhP_03.013.002.m4a", "display_order": 3, "topics": [{"text": "ब्रह्मणा अविद्यासृष्टिः", "range": "१–२"}]}, {"id": 6000043003, "chapter_id": 10043, "verse_number": "३-१३-२", "content_sanskrit": "ससर्जाग्रेऽन्धतामिस्रमथ तामिस्रमादिकृत्।\nमहामोहं च मोहं च तमश्चाज्ञानवृत्तयः॥ ३/१३/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_013/BhP_03.013.003.m4a", "display_order": 4}, {"id": 6000043004, "chapter_id": 10043, "verse_number": "३-१३-३", "content_sanskrit": "दृष्ट्वा पापीयसीं सृष्टिं नाऽत्मानं बह्वमन्यत।\nभगवद्ध्यानपूतेन मनसाऽन्यांस्ततोऽसृजत्॥ ३/१३/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_013/BhP_03.013.004.m4a", "display_order": 5, "topics": [{"text": "सनकादीनां रुद्रमरीच्यादीनां च सर्जनम्", "range": "३–३३"}]}, {"id": 6000043005, "chapter_id": 10043, "verse_number": "३-१३-४", "content_sanskrit": "सनकं च सनन्दं च सनातनमथाऽत्मभूः।\nसनत्कुमारं च मुनिं निष्क्रियानूर्ध्वरेतसः॥ ३/१३/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_013/BhP_03.013.005.m4a", "display_order": 6}, {"id": 6000043006, "chapter_id": 10043, "verse_number": "३-१३-५", "content_sanskrit": "तान् बभाषे स्वभूः पुत्रान् प्रजाः सृजत पुत्रकाः।\nतन्नैच्छन् मोक्षधर्माणो वासुदेवपरायणाः॥ ३/१३/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_013/BhP_03.013.006.m4a", "display_order": 7}, {"id": 6000043007, "chapter_id": 10043, "verse_number": "३-१३-६", "content_sanskrit": "सोऽवज्ञातः सुतैरेवं प्रत्याख्यातानुशासनैः।\nक्रोधं दुर्विषहं जातं नियन्तुमुपचक्रमे॥ ३/१३/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_013/BhP_03.013.007.m4a", "display_order": 8}, {"id": 6000043008, "chapter_id": 10043, "verse_number": "३-१३-७", "content_sanskrit": "धिया निगृह्यमाणोऽपि भ्रुवोर्मर्ध्यात् प्रजापतेः।\nसद्योऽजायत तन्मन्युः कुमारो नीललोहितः॥ ३/१३/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_013/BhP_03.013.008.m4a", "display_order": 9}, {"id": 6000043009, "chapter_id": 10043, "verse_number": "३-१३-८", "content_sanskrit": "स वै रुरोद देवानां पूर्वजो भगवान् भवः।\nनामानि कुरु मे धातः स्थानानि च जगद्गुरो॥ ३/१३/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_013/BhP_03.013.009.m4a", "display_order": 10}, {"id": 6000043010, "chapter_id": 10043, "verse_number": "३-१३-९", "content_sanskrit": "इति तस्य वचः पाद्मो भगवान् परिपालयन्।\nअभ्यधाद् भद्रया वाचा मा रोदीस्तत् करोमि ते॥ ३/१३/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_013/BhP_03.013.010.m4a", "display_order": 11}, {"id": 6000043011, "chapter_id": 10043, "verse_number": "३-१३-१०", "content_sanskrit": "यदरोदीः सुरश्रेष्ठ सोद्वेग इव बालकः।\nततस्त्वामभिधास्यन्ति नाम्ना रुद्र इति प्रजाः॥ ३/१३/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_013/BhP_03.013.011.m4a", "display_order": 12}, {"id": 6000043012, "chapter_id": 10043, "verse_number": "३-१३-११", "content_sanskrit": "हृदिन्द्रियाण्यसुर्व्योम वायुरग्निर्जलं मही।\nसूर्यश्चन्द्रस्तपश्चैव स्थानान्येकादशैव ते॥ ३/१३/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_013/BhP_03.013.012.m4a", "display_order": 13}, {"id": 6000043013, "chapter_id": 10043, "verse_number": "३-१३-१२", "content_sanskrit": "मन्युर्मनुर्महानासो महाञ्छिव ऋतध्वजः।\nमरुरेता भवः कालो वामदेवो धृतव्रतः॥ ३/१३/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_013/BhP_03.013.013.m4a", "display_order": 14}, {"id": 6000043014, "chapter_id": 10043, "verse_number": "३-१३-१३", "content_sanskrit": "धीर्वृत्तिरचलोमा च नियुत् सर्पिरिलाम्बिका।\nइरावती सुधा दीक्षा रुद्राण्यो रुद्र ते स्‍त्रियः॥ ३/१३/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_013/BhP_03.013.014.m4a", "display_order": 15}, {"id": 6000043015, "chapter_id": 10043, "verse_number": "३-१३-१४", "content_sanskrit": "गृहाणैतानि नामानि स्थानानि च सपोषणम्।\nआभिः सृज प्रजा बह्वीः प्रजानामसि यत् पतिः॥ ३/१३/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_013/BhP_03.013.015.m4a", "display_order": 16}, {"id": 6000043016, "chapter_id": 10043, "verse_number": "३-१३-१५", "content_sanskrit": "इत्यादिष्टः स गुरुणा भगवान् नीललोहितः।\nसत्त्वाकृतिस्वभावेन ससर्जात्मसमाः प्रजाः॥ ३/१३/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_013/BhP_03.013.016.m4a", "display_order": 17}, {"id": 6000043017, "chapter_id": 10043, "verse_number": "३-१३-१६", "content_sanskrit": "रुद्राणां रुद्रसृष्टानां समन्ताद् ग्रसतां जगत्।\nनिशाम्यासंख्यशो यूथान् प्रजापतिरशङ्कत॥ ३/१३/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_013/BhP_03.013.017.m4a", "display_order": 18}, {"id": 6000043018, "chapter_id": 10043, "verse_number": "३-१३-१७", "content_sanskrit": "अलं प्रजाभिः सृष्टाभिरीदृशीभिः सुरोत्तम।\nत्वया सह दहन्तीभिर्दिशश्चक्षुर्भिरुल्बणैः॥ ३/१३/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_013/BhP_03.013.018.m4a", "display_order": 19}, {"id": 6000043019, "chapter_id": 10043, "verse_number": "३-१३-१८", "content_sanskrit": "तप आतिष्ठ भद्रं ते सर्वभूतसुखावहम्।\nतपसैव यथापूर्वं स्रष्टा विश्वमिदं भवान्॥ ३/१३/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_013/BhP_03.013.019.m4a", "display_order": 20}, {"id": 6000043020, "chapter_id": 10043, "verse_number": "३-१३-१९", "content_sanskrit": "तपसैव परंज्योतिर्भगवन्तमधोक्षजम्।\nसर्वभूतगुहावासमञ्जसा विन्दते पुमान्॥ ३/१३/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_013/BhP_03.013.020.m4a", "display_order": 21}, {"id": 6000043021, "chapter_id": 10043, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_013/BhP_03.013.021.m4a", "display_order": 22}, {"id": 6000043022, "chapter_id": 10043, "verse_number": "३-१३-२०", "content_sanskrit": "एवमात्मभुवाऽऽदिष्टः परिक्रम्य गिरां पतिम्।\nबाढमित्यमुमामन्त्र्य विवेश तपसे वनम्॥ ३/१३/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_013/BhP_03.013.022.m4a", "display_order": 23}, {"id": 6000043023, "chapter_id": 10043, "verse_number": "३-१३-२१", "content_sanskrit": "अथाभिध्यायतः सर्गं दश पुत्राः प्रजज्ञिरे।\nभगवच्छक्तियुक्तस्य लोकसन्तानहेतवः॥ ३/१३/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_013/BhP_03.013.023.m4a", "display_order": 24}, {"id": 6000043024, "chapter_id": 10043, "verse_number": "३-१३-२२", "content_sanskrit": "मरीचिरत्र्यङ्गिरसौ पुलस्त्यः पुलहः क्रतुः।\nभृगुर्वसिष्ठो दक्षश्च दशमस्तत्र नारदः॥ ३/१३/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_013/BhP_03.013.024.m4a", "display_order": 25}, {"id": 6000043025, "chapter_id": 10043, "verse_number": "३-१३-२३", "content_sanskrit": "उत्सङ्गान्नारदो जज्ञे दक्षोऽङ्गुष्ठात् स्वयम्भुवः।\nप्राणाद् वसिष्ठः सञ्जातो भृगुस्त्वचि करात् क्रतुः॥ ३/१३/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_013/BhP_03.013.025.m4a", "display_order": 26}, {"id": 6000043026, "chapter_id": 10043, "verse_number": "३-१३-२४", "content_sanskrit": "पुलहो नाभितो जज्ञे पुलस्त्यः कर्णयोर्ऋषिः।\nअङ्गिरा मुखतोऽक्ष्णोऽत्रिर्मरीचिर्मनसोऽभवत्॥ ३/१३/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_013/BhP_03.013.026.m4a", "display_order": 27}, {"id": 6000043027, "chapter_id": 10043, "verse_number": "३-१३-२५", "content_sanskrit": "धर्मः स्तनाद् दक्षिणतो यत्र नारायणः स्वयम्।\nअधर्मः पृष्ठतो यस्मान्मृत्युर्लोकभयङ्करः॥ ३/१३/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_013/BhP_03.013.027.m4a", "display_order": 28}, {"id": 6000043028, "chapter_id": 10043, "verse_number": "३-१३-२६", "content_sanskrit": "हृदि कामो भ्रुवोः क्रोधो लोभश्चाधरदच्छदात्।\nआस्याद् वाक् सिन्धवो मेढ्रान्निर्ऋतिः पायोरघाश्रयः॥ ३/१३/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_013/BhP_03.013.028.m4a", "display_order": 29}, {"id": 6000043029, "chapter_id": 10043, "verse_number": "३-१३-२७", "content_sanskrit": "छायायाः कर्दमो जज्ञे देवहूत्याः पतिः प्रभुः।\nमनसो देहतश्चेदं जज्ञे विश्वकृतो जगत्॥ ३/१३/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_013/BhP_03.013.029.m4a", "display_order": 30}, {"id": 6000043030, "chapter_id": 10043, "verse_number": "३-१३-२८", "content_sanskrit": "वाचं दुहितरं तन्वीं स्वयम्भूर्हरतीं मनः।\nअकामां चकमे क्षत्तः सकाम इति नः श्रुतम्॥ ३/१३/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_013/BhP_03.013.030.m4a", "display_order": 31}, {"id": 6000043031, "chapter_id": 10043, "verse_number": "३-१३-२९", "content_sanskrit": "तमधर्मे कृतमतिं विलोक्य पितरं सुताः।\nमरीचिमुख्या मुनयो विस्रम्भात् प्रत्यषेधयन्॥ ३/१३/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_013/BhP_03.013.031.m4a", "display_order": 32}, {"id": 6000043032, "chapter_id": 10043, "verse_number": "३-१३-३०", "content_sanskrit": "नैतत् पूर्वैः कृतं त्वद्य न करिष्यन्ति येऽपरे।\nयः स्वां दुहितरं गच्छेदनिगृह्याङ्गजं प्रभुः॥ ३/१३/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_013/BhP_03.013.032.m4a", "display_order": 33}, {"id": 6000043033, "chapter_id": 10043, "verse_number": "३-१३-३१", "content_sanskrit": "तेजीयसामपि ह्येतन्न सुश्लोक्यं जगद्गुरो।\nयद्वृत्तमनुतिष्ठन् वै लोकः क्षेमाय कल्प्यते॥ ३/१३/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_013/BhP_03.013.033.m4a", "display_order": 34}, {"id": 6000043034, "chapter_id": 10043, "verse_number": "३-१३-३२", "content_sanskrit": "तस्मै नमो भगवते य इदं स्वेन रोचिषा।\nआत्मस्थं व्यञ्जयामास स धर्मं पातुमर्हति॥ ३/१३/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_013/BhP_03.013.034.m4a", "display_order": 35}, {"id": 6000043035, "chapter_id": 10043, "verse_number": "३-१३-३३", "content_sanskrit": "स इत्थं गृणतः पुत्रान् पुरो दृष्ट्वा प्रजापतीन्।\nप्रजापतिपतिस्तन्वीं तत्याज व्रीडितस्तदा॥ ३/१३/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_013/BhP_03.013.035.m4a", "display_order": 36}, {"id": 6000043036, "chapter_id": 10043, "verse_number": "३-१३-३४", "content_sanskrit": "तां दिशो जगृहुर्घोरां नीहारं यद् विदुस्तमः।\nकदाचिद् ध्यायतः स्रष्टुर्वेदा आसंश्चतुर्मुखात्॥ ३/१३/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_013/BhP_03.013.036.m4a", "display_order": 37, "topics": [{"text": "ऋगादिवेदचतुष्टयसर्जनम्", "range": "३४"}]}, {"id": 6000043037, "chapter_id": 10043, "verse_number": "३-१३-३५", "content_sanskrit": "कथं स्रक्ष्याम्यहं लोकान् समवेतान् यथा पुरा। चातुर्होत्रं कर्मतन्त्रमुपवेदनयैः सह।\nधर्मस्य पादाश्चत्वारस्तथैवाश्रमवृत्तयः॥ ३/१३/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_013/BhP_03.013.037.m4a", "display_order": 38}, {"id": 6000043038, "chapter_id": 10043, "verse_number": null, "content_sanskrit": "विदुर उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_013/BhP_03.013.038.m4a", "display_order": 39}, {"id": 6000043039, "chapter_id": 10043, "verse_number": "३-१३-३६", "content_sanskrit": "स वै विश्वसृजामीशो वेदादीन् मुखतोऽसृजत्।\nयद् यद् येनासृजद् देवस्तन्मे ब्रूहि तपोधन॥ ३/१३/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_013/BhP_03.013.039.m4a", "display_order": 40}, {"id": 6000043040, "chapter_id": 10043, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_013/BhP_03.013.040.m4a", "display_order": 41}, {"id": 6000043041, "chapter_id": 10043, "verse_number": "३-१३-३७", "content_sanskrit": "ऋग्यजुःसामाथर्वाख्यान् वेदान् पूर्वादिभिर्मुखैः।\nशस्‍त्रमिज्यां स्तुतिस्तोमं प्रायश्चित्तं व्यधात् क्रमात्॥ ३/१३/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_013/BhP_03.013.041.m4a", "display_order": 42}, {"id": 6000043042, "chapter_id": 10043, "verse_number": "३-१३-३८", "content_sanskrit": "आयुर्वेदं धनुर्वेदं गान्धर्वं वेदमात्मनः।\nस्थापत्यं चासृजद् वेदं क्रमाद् पूर्वादिभिर्मुखैः॥ ३/१३/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_013/BhP_03.013.042.m4a", "display_order": 43}, {"id": 6000043043, "chapter_id": 10043, "verse_number": "३-१३-३९", "content_sanskrit": "इतिहासपुराणं च पञ्चमं वेदमीश्वरः।\nसर्वेभ्य एव वक्त्रेभ्यः ससृजे सर्वदर्शनः॥ ३/१३/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_013/BhP_03.013.043.m4a", "display_order": 44}, {"id": 6000043044, "chapter_id": 10043, "verse_number": "३-१३-४०", "content_sanskrit": "षोडश्युक्थौ पूर्ववक्त्रात् पुरीष्याग्निष्टुतावथ।\nआप्तोर्यामातिरात्रौ च वाजपेयं सगोसवम्॥ ३/१३/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_013/BhP_03.013.044.m4a", "display_order": 45}, {"id": 6000043045, "chapter_id": 10043, "verse_number": "३-१३-४१", "content_sanskrit": "तपः शौचं दया सत्यं धर्मस्येति पदानि च।\nआश्रमांश्च यथासंख्यमसृजत् सह वृत्तिभिः॥ ३/१३/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_013/BhP_03.013.045.m4a", "display_order": 46}, {"id": 6000043046, "chapter_id": 10043, "verse_number": "३-१३-४२", "content_sanskrit": "सावित्रं प्राजापत्यं च ब्राह्मं चाथ बृहत् तथा।\nवार्ताऽसञ्चयशालीनं शिलोञ्छ इति वै गृहे॥ ३/१३/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_013/BhP_03.013.046.m4a", "display_order": 47}, {"id": 6000043047, "chapter_id": 10043, "verse_number": "३-१३-४३", "content_sanskrit": "वैखानसा वालखिल्योदम्बराः फेनपा वने।\nन्यासे कुटीचकः पूर्वं बहूदो हंसनिष्क्रियौ॥ ३/१३/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_013/BhP_03.013.047.m4a", "display_order": 48}, {"id": 6000043048, "chapter_id": 10043, "verse_number": "३-१३-४४", "content_sanskrit": "आन्वीक्षिकी त्रयी वार्ता दण्डनीतिस्तथैव च।\nएवं व्याहृतयश्चासन् प्रणवेनास्पदं गताः॥ ३/१३/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_013/BhP_03.013.048.m4a", "display_order": 49}, {"id": 6000043049, "chapter_id": 10043, "verse_number": "३-१३-४५", "content_sanskrit": "तस्योष्णिगासील्लोमभ्यो गायत्री च त्वचो विभोः। त्रिष्टुप् मांसात् स्नुतोऽनुष्टुब् जगत्यस्थ्नः प्रजापतेः।\nमज्जायाः पङ्क्तिरुत्पन्ना बृहती प्राणतोऽभवत्॥ ३/१३/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_013/BhP_03.013.049.m4a", "display_order": 50}, {"id": 6000043050, "chapter_id": 10043, "verse_number": "३-१३-४६", "content_sanskrit": "स्पर्शास्तस्याभवन् जीवात् स्वरो देह उदाहृतः।\nऊष्माण इन्द्रियाण्याहुरन्तःस्था बलमात्मनः॥ ३/१३/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_013/BhP_03.013.050.m4a", "display_order": 51}, {"id": 6000043051, "chapter_id": 10043, "verse_number": "३-१३-४७", "content_sanskrit": "स्वराः सप्त विहारेण भवन्ति स्म प्रजापतेः।\nशब्दब्रह्मात्मनस्तात व्यक्ताव्यक्तात्मनः प्रभोः॥ ३/१३/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_013/BhP_03.013.051.m4a", "display_order": 52}, {"id": 6000043052, "chapter_id": 10043, "verse_number": "३-१३-४८", "content_sanskrit": "ब्रह्मानुभावविततो नानाशक्त्युपबृंहितः।\nततोऽपरामुपादाय स सर्गाय मनो दधे॥ ३/१३/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_013/BhP_03.013.052.m4a", "display_order": 53, "topics": [{"text": "स्वायंभुवमनोः शतरूपायाश्चोत्पत्तिः", "range": "४८–५५"}]}, {"id": 6000043053, "chapter_id": 10043, "verse_number": "३-१३-४९", "content_sanskrit": "ऋषीणां भूरिवीर्याणामपि सर्गमविस्तृतम्।\nज्ञात्वा तद् हृदये भूयश्चिन्तयामास कौरव॥ ३/१३/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_013/BhP_03.013.053.m4a", "display_order": 54}, {"id": 6000043054, "chapter_id": 10043, "verse_number": "३-१३-५०", "content_sanskrit": "अहो अद्भुतमेतन्मे व्यापृतस्यापि नित्यदा।\nन ह्येधन्ते प्रजा नूनं दैवमत्र विघातकम्॥ ३/१३/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_013/BhP_03.013.054.m4a", "display_order": 55}, {"id": 6000043055, "chapter_id": 10043, "verse_number": "३-१३-५१", "content_sanskrit": "एवं युक्तिमतस्तस्य दैवं चावेक्षतस्तदा।\nकस्य रूपमभूद् द्वेधा यत् कायमभिचक्षते॥ ३/१३/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_013/BhP_03.013.055.m4a", "display_order": 56}, {"id": 6000043056, "chapter_id": 10043, "verse_number": "३-१३-५२", "content_sanskrit": "ताभ्यां रूपविभागाभ्यां मिथुनं समपद्यत।\nयस्तु तत्र पुमान् सोऽभून्मनुः स्वायम्भुवः स्वराट्॥ ३/१३/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_013/BhP_03.013.056.m4a", "display_order": 57}, {"id": 6000043057, "chapter_id": 10043, "verse_number": "३-१३-५३", "content_sanskrit": "स्‍त्रीर्याऽऽसीच्छतरूपाख्या महिष्यस्य महात्मनः।\nतदा मैथुनधर्मेण प्रजा एधाम्बभूविरे॥ ३/१३/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_013/BhP_03.013.057.m4a", "display_order": 58}, {"id": 6000043058, "chapter_id": 10043, "verse_number": "३-१३-५४", "content_sanskrit": "स चापि शतरूपायां पञ्चापत्यान्यजीजनत्।\nप्रियव्रतोत्तानपादौ तिस्रः कन्याश्च भारत॥ ३/१३/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_013/BhP_03.013.058.m4a", "display_order": 59}, {"id": 6000043059, "chapter_id": 10043, "verse_number": "३-१३-५५", "content_sanskrit": "आकूतिर्देवहूतिश्च प्रसूतिरिति सत्तम। आकूतिं रुचये प्रादात् कर्दमाय तु मध्यमाम्।\nदक्षायादात् प्रसूतिं च यत आपूरितं जगत्॥ ३/१३/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_013/BhP_03.013.059.m4a", "display_order": 60}, {"id": 6000043060, "chapter_id": 10043, "verse_number": null, "content_sanskrit": "इति श्रीमद्भागवते वैयासिक्यां संहितायां तृतीयस्कन्धे त्रयोदशाध्यायः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}]