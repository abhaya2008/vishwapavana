[{"id": 7004797000, "chapter_id": 24797, "verse_number": "६-२५९-१", "content_sanskrit": "गालव उवाच ।\nतस्मिंस्तु पतिते लिंगे योजनायामविस्तृते ।\nविषादार्त्ता ऋषिगणास्तत्राजग्मुः सहस्रशः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004797001, "chapter_id": 24797, "verse_number": "६-२५९-२", "content_sanskrit": "व्यलोकयन्त सर्वत्र दृष्ट्वा तत्र महेश्वरम् ।\nनासौ दृष्टिपथे तेषां बभूव भयविह्वलः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004797002, "chapter_id": 24797, "verse_number": "६-२५९-३", "content_sanskrit": "वीर्यं वर्षसहस्राणि बहून्यपि सुसंचितम् ।\nपृथिवीं सकलां व्याप्य स्थितं ददृशिरे द्विजाः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004797003, "chapter_id": 24797, "verse_number": "६-२५९-४", "content_sanskrit": "तद्दृष्ट्वा सुमहल्लिंगं रुधिराक्तं जलैः प्लुतम् ।\nब्राह्मणाः संशयगता दह्यमाना वसुन्धरा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004797004, "chapter_id": 24797, "verse_number": "६-२५९-५", "content_sanskrit": "तल्लिंगं तत्र संस्थाप्य चक्रुस्तां नर्मदां नदीम् ।\nतज्जलं नर्मदारूपं ल्लिंगं चामरकण्टकम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004797005, "chapter_id": 24797, "verse_number": "६-२५९-६", "content_sanskrit": "नरकं वारयत्येतत्सेवितं नरकापहम् ।\nभूतग्रहाश्च सर्वेऽपि यास्यंति विलयं ध्रुवम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004797006, "chapter_id": 24797, "verse_number": "६-२५९-७", "content_sanskrit": "तत्र स्नात्वा जलं पीत्वा संतर्प्य च पितॄंस्तथा ।\nसर्वान्कामानवाप्नोति मनुष्यो भुवि दुर्लभान् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004797007, "chapter_id": 24797, "verse_number": "६-२५९-८", "content_sanskrit": "लिंगानि नार्मदेयानि पूजयिष्यंति ये नराः ।\nतेषां रुद्रमयो देहो भविष्यति न संशयः ।\nचातुर्मास्ये विशेषेण लिंगपूजा महाफला ।\nचातुर्मास्ये रुद्रजपं हरपूजा शिवे रतिः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004797008, "chapter_id": 24797, "verse_number": "६-२५९-९", "content_sanskrit": "पंचामृतेन स्नपनं न तेषांगर्भवेदना ।\nये करिष्यंति मधुना सेचनं लिंगमस्तके ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004797009, "chapter_id": 24797, "verse_number": "६-२५९-१०", "content_sanskrit": "तेषां दुःखसहस्राणि यास्यंति विलयं ध्रुवम् ।\nदीपदानं कृतं येन चातु र्मास्ये शिवाग्रतः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004797010, "chapter_id": 24797, "verse_number": "६-२५९-११", "content_sanskrit": "कुलकोटिं समुद्धृत्य स्वेच्छया शिवलोकभाक् ।\nचन्दनागुरुधूपैश्च सुश्वेतकुसुमैरपि ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004797011, "chapter_id": 24797, "verse_number": "६-२५९-१२", "content_sanskrit": "नर्मदाजललिंगं ये ह्यर्च यिष्यंति ते शिवाः ।\nशिला हरत्वमापन्नाः प्राणिनामपि का कथा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004797012, "chapter_id": 24797, "verse_number": "६-२५९-१३", "content_sanskrit": "तत्संभूतं महालिंगं जलधारणसंयुतम् ।\nपूजयित्वा विधानेन चातुर्मास्ये शिवो भवेत् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004797013, "chapter_id": 24797, "verse_number": "६-२५९-१४", "content_sanskrit": "चातुर्मास्ये ये मनुजा नर्मदाऽमरकण्टके ।\nतीर्थे स्नास्यंति नियतास्तेषां वासस्त्रिविष्टपे ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004797014, "chapter_id": 24797, "verse_number": "६-२५९-१५", "content_sanskrit": "ब्रह्मोवाच ।\nइत्युक्त्वा ते द्विजास्तत्र स्थाप्य लिंगं यथाविधि ।\nअमरकण्टकतीर्थे नर्मदां च महानदीम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004797015, "chapter_id": 24797, "verse_number": "६-२५९-१६", "content_sanskrit": "पुनश्चिन्तापरा जाता विश्वस्य क्षोभकारणे ।\nपद्मासनगता भूत्वा प्राणायामपरायणाः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004797016, "chapter_id": 24797, "verse_number": "६-२५९-१७", "content_sanskrit": "चिन्तयामासुरव्यग्रं हृदयस्थं महे श्वरम् ।\nततो देवा महेंद्राद्याः संप्राप्यामरकण्टकम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004797017, "chapter_id": 24797, "verse_number": "६-२५९-१८", "content_sanskrit": "ब्राह्मणानां स्तुतिं चक्रुर्विनयानतकन्धराः ।\nनमोऽस्तु वो द्विजातिभ्यो ब्रह्मविद्भ्यो महेश्वराः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004797018, "chapter_id": 24797, "verse_number": "६-२५९-१९", "content_sanskrit": "भूसुरेभ्यो गुरुभ्यश्च विमुक्तेभ्यश्च वंधनात् ।\nयूयं गुणत्रयातीता गुणरूपा गुणाकराः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004797019, "chapter_id": 24797, "verse_number": "६-२५९-२०", "content_sanskrit": "गुणत्रयमयैर्भावैः सततं प्राणबुद्बुदाः ।\nयेषां वाक्यजलेनैव पापिष्ठा अपि शुद्धताम् ।\nप्रयांति पापपुंजाश्च भस्मसाद्यांति पापिनाम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004797020, "chapter_id": 24797, "verse_number": "६-२५९-२१", "content_sanskrit": "शस्त्रं लोहमयं येषां वागेव तत्समन्विताः ।\nपापैः पराभिभूतानां तेषां लोकोत्तरं बलम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004797021, "chapter_id": 24797, "verse_number": "६-२५९-२२", "content_sanskrit": "क्षमया पृथिवीतुल्याः कोपे वैश्वानरप्रभाः ।\nपातनेऽनेकशक्तीनां समर्था यूयमेव हि ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004797022, "chapter_id": 24797, "verse_number": "६-२५९-२३", "content_sanskrit": "स्वर्गादीनां तथा याने भवन्तो गतयो ध्रुवम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004797023, "chapter_id": 24797, "verse_number": "६-२५९-२४", "content_sanskrit": "सत्कर्मकारकाश्चैव सत्कर्मनिरताः सदा ।\nसत्कर्मफलदातारः सत्कर्मेभ्यो मुमुक्षवः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004797024, "chapter_id": 24797, "verse_number": "६-२५९-२५", "content_sanskrit": "सावित्रीमंत्रनिरता ये भवंतोऽघनाशनाः ।\nआत्मानं यजमानं च तारयंति न संशयः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004797025, "chapter_id": 24797, "verse_number": "६-२५९-२६", "content_sanskrit": "वह्नयश्च तथा विप्रास्तर्पिताः कार्यसाधकाः ।\nचातुर्मास्ये विशेषेण तेषां पूजा महाफला ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004797026, "chapter_id": 24797, "verse_number": "६-२५९-२७", "content_sanskrit": "कोपिताः सर्वदेहस्य नाशनाय भवंति हि ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004797027, "chapter_id": 24797, "verse_number": "६-२५९-२८", "content_sanskrit": "तावन्न वज्रमिंद्रस्य शूलं नैव पिनाकिनः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004797028, "chapter_id": 24797, "verse_number": "६-२५९-२९", "content_sanskrit": "दण्डो यमस्य तावन्नो यावच्छापो द्विजोद्भवः ।\nअग्निना ज्वाल्यते दृश्यं शापोद्दिष्टानपि स्वयम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004797029, "chapter_id": 24797, "verse_number": "६-२५९-३०", "content_sanskrit": "हंति जातानजातांश्च तस्माद्विप्रं न कोपयेत् ।\nविप्रकोपाग्निना दग्धो नरकान्नैव मुच्यते ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004797030, "chapter_id": 24797, "verse_number": "६-२५९-३१", "content_sanskrit": "शस्त्रक्षतोऽपि नरकान्मुच्यते नात्र संशयः ।\nदेवानां मधुधान्यानां सामर्थ्यं भेदनेन हि ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004797031, "chapter_id": 24797, "verse_number": "६-२५९-३२", "content_sanskrit": "वाङ्मात्रेण हि विप्रस्य भिद्यते सकलं जगत् ।\nते यूयं गुरवोऽस्माकं विश्वकारणकारकाः ।\nप्रसादपरमा नित्यं भवंतु भुवनेश्वराः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004797032, "chapter_id": 24797, "verse_number": "६-२५९-३३", "content_sanskrit": "ईश्वरेण विना सर्वे वयं लोकाश्च दुःखिताः ।\nतत्कथ्यतां स भगवान्कुत्रास्ते परमेश्वरः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004797033, "chapter_id": 24797, "verse_number": "६-२५९-३४", "content_sanskrit": "गालव उवाच ।\nज्ञात्वा मुनिभयत्रस्तं देवेशं शूलपाणिनम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004797034, "chapter_id": 24797, "verse_number": "६-२५९-३५", "content_sanskrit": "सुरभीगर्भसंभूतं देवानूचुर्महर्षयः ।\nस्वागतं देवदेवेभ्यो ज्ञातो वै स महेश्वरः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004797035, "chapter_id": 24797, "verse_number": "६-२५९-३६", "content_sanskrit": "तत्र गच्छंतु देवेशा यत्र देवः सनातनः ।\nइत्युक्त्वा ते महात्मानः सह देवैर्ययुस्तदा ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004797036, "chapter_id": 24797, "verse_number": "६-२५९-३७", "content_sanskrit": "गोलोकं देवमार्गेण यत्र पायसकर्दमाः ।\nघृतनद्योमधु ह्रदा नदीनां यत्र संघशः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004797037, "chapter_id": 24797, "verse_number": "६-२५९-३८", "content_sanskrit": "पूर्वजानां गणाः सर्वे दधिपीयूषपाणयः ।\nमरीचिपाः सोमपाश्च सिद्धसंघास्तथा परे ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004797038, "chapter_id": 24797, "verse_number": "६-२५९-३९", "content_sanskrit": "घृतपाश्चैव साध्याश्च यत्र देवाः सनातनाः ।\nते तत्र गत्वा मुनयो ददृशुः सुरभीसुतम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004797039, "chapter_id": 24797, "verse_number": "६-२५९-४०", "content_sanskrit": "तेजसा भास्करं चैव नीलनामेति विश्रुतम् ।\nइतस्ततोऽभिधावंतं गवां संघातमध्यगम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004797040, "chapter_id": 24797, "verse_number": "६-२५९-४१", "content_sanskrit": "नंदा सुमनसा चैव सुरूपा च सुशीलका ।\nकामिनी नंदिनी चैव मेध्या चैव हिरण्यदा ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004797041, "chapter_id": 24797, "verse_number": "६-२५९-४२", "content_sanskrit": "धनदा धर्मदा चैव नर्मदा सकलप्रिया ।\nवामनालंबिका कृष्णा दीर्घशृंगा सुपिच्छिका ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004797042, "chapter_id": 24797, "verse_number": "६-२५९-४३", "content_sanskrit": "तारा तरेयिका शांता दुर्विषह्या मनोरमा ।\nसुनासा दीर्घनासा च गौरा गौरमुखीह या ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004797043, "chapter_id": 24797, "verse_number": "६-२५९-४४", "content_sanskrit": "हरिद्रवर्णा नीला च शंखिनी पंचवर्णका ।\nविनताभिनताचैव भिन्नवर्णा सुपत्रिका ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004797044, "chapter_id": 24797, "verse_number": "६-२५९-४५", "content_sanskrit": "जयाऽरुणा च कुण्डोध्नी सुदती चारुचंपका ।\nएतासां मध्यगं नीलं दृष्ट्वा ता मुनिदेवताः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004797045, "chapter_id": 24797, "verse_number": "६-२५९-४६", "content_sanskrit": "विचरंति सुरूपं तं संजातविस्मयोन्मुखाः ।\nमुनीश्वराः कृपाविष्टा इन्द्राद्या हृष्टमानसाः ।\nस्तुतिमारेभिरे कर्त्तुं तेजसा तस्य तोषिताः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004797046, "chapter_id": 24797, "verse_number": "६-२५९-४७", "content_sanskrit": "शूद्र उवाच ।\nकथं नीलेति नामासौ जातोयमद्भुताकृतिः ।\nकिमस्तुवन्प्रसन्नास्ते ब्राह्मणा विश्वकारणम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004797047, "chapter_id": 24797, "verse_number": "६-२५९-४८", "content_sanskrit": "गालव उवाच ।\nलोहितो यस्तु वर्णेन मुखे पुच्छे च पांडुरः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004797048, "chapter_id": 24797, "verse_number": "६-२५९-४९", "content_sanskrit": "श्वेतः खुरविषाणेषु स नीलो वृषभः स्मृतः ।\nचतुष्पादो धर्मरूपो नील लोहितचिह्नकः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004797049, "chapter_id": 24797, "verse_number": "६-२५९-५०", "content_sanskrit": "कपिलः खुरचिह्नेषु स नीलो वृषभः स्मृतः ।\nयोऽसौ महेश्वरो देवो वृषश्चापि स एव हि ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004797050, "chapter_id": 24797, "verse_number": "६-२५९-५१", "content_sanskrit": "चतुष्पादो धर्मरूपो नीलः पंचमुखो हरः ।\nयस्य संदर्शनादेव वाजपेयफलं लभेत् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004797051, "chapter_id": 24797, "verse_number": "६-२५९-५२", "content_sanskrit": "नीले च पूजिते यस्मिन्पूजितं सकलं जगत् ।\nस्निग्धग्रासप्रदानेन जगदाप्यायितं भवेत् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004797052, "chapter_id": 24797, "verse_number": "६-२५९-५३", "content_sanskrit": "यस्य देहे सदा श्रीमान्विश्वव्यापी जनार्दनः ।\nनित्यमर्चयते योऽसौ वेदमन्त्रैः सनातनैः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004797053, "chapter_id": 24797, "verse_number": "६-२५९-५४", "content_sanskrit": "ऋषय ऊचुः ।\nत्वं देवः सर्वगोप्तॄणां विश्वगोप्ता सनातनः ।\nविघ्नहर्ता ज्ञानदश्च धर्मरूपश्च मोक्षदः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004797054, "chapter_id": 24797, "verse_number": "६-२५९-५५", "content_sanskrit": "त्वमेव धनदः श्रीदः सर्वव्याधिनिषूदनः ।\nजगतां शर्मकरणे प्रवृत्तः कनकप्रदः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004797055, "chapter_id": 24797, "verse_number": "६-२५९-५६", "content_sanskrit": "तेजसां धाम सर्वेषां सौरभेय महाबल ।\nशृंगाग्रे धृतकैलासः पार्वतीसहितस्त्वया ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004797056, "chapter_id": 24797, "verse_number": "६-२५९-५७", "content_sanskrit": "३३ स्तुत्यो वेदमयो वेदात्मा वेदवित्तमः ।\nवेदवेद्यो वेदयानो वेदरूपो गुणाकरः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004797057, "chapter_id": 24797, "verse_number": "६-२५९-५८", "content_sanskrit": "गुणत्रयेभ्योऽपि परो याथात्म्यं वेद कस्तव ।\nवृषस्त्वं भगवान्देव यस्तुभ्यं कुरुते त्वघम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004797058, "chapter_id": 24797, "verse_number": "६-२५९-५९", "content_sanskrit": "वृषलः स तु विज्ञेयो रौरवादिषु पच्यते ।\nयदा स्पृष्टः स तु नरो नरकादिषु यातनाः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004797059, "chapter_id": 24797, "verse_number": "६-२५९-६०", "content_sanskrit": "सेवते पापनिचयैर्निगाढप्रायबन्धनैः ।\nक्षुत्क्षामं च तृषाक्रांतं महाभारसमन्वितम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004797060, "chapter_id": 24797, "verse_number": "६-२५९-६१", "content_sanskrit": "निर्दया ये प्रशोष्यंति मतिस्तेषां न शाश्वती ।\nचतुर्भिः सहितं मर्त्या विवाहविधिना तु ये ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004797061, "chapter_id": 24797, "verse_number": "६-२५९-६२", "content_sanskrit": "विवाहं नीलरूपस्य ये करिष्यंति मानवाः ।\nपितॄनुद्दिश्य तेषां वै कुले नैवास्ति नारकी ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004797062, "chapter_id": 24797, "verse_number": "६-२५९-६३", "content_sanskrit": "त्वं गतिः सर्वलोकानां त्वपिता परमेश्वरः ।\nत्वया विना जगत्सर्वं तत्क्षणादेव नश्यति ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004797063, "chapter_id": 24797, "verse_number": "६-२५९-६४", "content_sanskrit": "परा चैव तु पश्यंती मध्यमा वैखरी तथा ।\nचतुर्विधानां वचसामीश्वरं त्वां विदुर्बुधाः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004797064, "chapter_id": 24797, "verse_number": "६-२५९-६५", "content_sanskrit": "चतुःशृंगं चतुष्पादं द्विशीर्षसप्तहस्तकम् ।\nत्रिधा बद्धं धर्ममयं त्वामेव वृषभं विदुः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004797065, "chapter_id": 24797, "verse_number": "६-२५९-६६", "content_sanskrit": "तृप्तिदं सर्वभूतानां विश्वव्यापकमोजसा ।\nब्रह्म धर्ममयं नित्यं त्वामात्मानं विदुर्जनाः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004797066, "chapter_id": 24797, "verse_number": "६-२५९-६७", "content_sanskrit": "अच्छेद्यस्त्वमभेद्यस्त्वमप्रमेयोमहा यशाः ।\nअशोच्यस्त्वमदाह्योऽसि विदुः पौराणिका जनाः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004797067, "chapter_id": 24797, "verse_number": "६-२५९-६८", "content_sanskrit": "त्वदाधारमिदं सर्वं त्वदाधारमिदं जगत् ।\nत्वदाधाराश्च देवाश्च त्वदाधारं तथा मृतम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004797068, "chapter_id": 24797, "verse_number": "६-२५९-६९", "content_sanskrit": "जीवरूपेण लोकांस्त्रीन्व्याप्य तिष्ठसि नित्यदा ।\nएवं स संस्तुतो नीलो विप्रैस्तैः सोमपायिभिः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004797069, "chapter_id": 24797, "verse_number": "६-२५९-७०", "content_sanskrit": "प्रसन्नवदनो भूत्वा विप्रा न्प्रणतितत्परः ।\nपुनरेव वचः प्रोचुर्विप्राः कृतशिवागसः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004797070, "chapter_id": 24797, "verse_number": "६-२५९-७१", "content_sanskrit": "वरं ददुर्महेशस्य नीलरूपस्य धर्मतः ।\nएकादशाहे प्रेतस्य यस्य नोत्सृज्यते वृषः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004797071, "chapter_id": 24797, "verse_number": "६-२५९-७२", "content_sanskrit": "प्रेतत्वं सुस्थिरं तस्य दत्तैः श्राद्धशतैरपि ।\nपुनरेव सुसर्पंतं दृष्ट्वा नीलं महावृषम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004797072, "chapter_id": 24797, "verse_number": "६-२५९-७३", "content_sanskrit": "स्वल्पक्रोधसमाविष्टं द्विजाश्चक्रुस्तमं कितम् ।\nचक्रं च वामभागेषु शूलं पार्श्वे च दक्षिणे ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004797073, "chapter_id": 24797, "verse_number": "६-२५९-७४", "content_sanskrit": "उत्ससृजुर्गवां मध्ये तं देवैर्गोपितं तदा ।\nततो देवगणाः सर्वे महर्षीणां गणाः पुनः ।\nस्वानि स्थानानि ते जग्मुर्मुनयो वीतमत्सराः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004797074, "chapter_id": 24797, "verse_number": "६-२५९-७५", "content_sanskrit": "एवमृषीणां दयितासु सक्तः कामार्त्तचित्तो मुनिपुंगवानाम् ।\nशापं समासाद्य शिवोऽपि भक्त्या रेवाजलेऽगात्सुशिलामयत्वम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}]