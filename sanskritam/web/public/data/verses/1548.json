[{"id": 2025486, "chapter_id": 1548, "verse_number": "३-१८६-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2025487, "chapter_id": 1548, "verse_number": "३-१८६-१", "content_sanskrit": "तं विवक्षन्तमालक्ष्यकुरुराजो महामुनिम्।\nकथासंजननार्थाय चोदयामास पाण्डवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2025488, "chapter_id": 1548, "verse_number": "३-१८६-२", "content_sanskrit": "भवान्दैवतदैत्यानामृषीणां च महात्मनाम्।\nराजर्षीणां च सर्वेषां चरितज्ञः पुरातनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2025489, "chapter_id": 1548, "verse_number": "३-१८६-३", "content_sanskrit": "सेव्यश्चोपासितव्यश् मतो नः काङ्क्षितश्चिरम्।\nअयं च देवकीपुत्रः प्राप्तोऽस्मानवलोककः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2025490, "chapter_id": 1548, "verse_number": "३-१८६-४", "content_sanskrit": "भ्रमत्येव हि मे बुद्धिर्दृष्ट्वाऽऽत्मानं सुखाच्च्युतम्।\nधार्तराष्ट्रांश्च रदुर्त्तानृद्ध्यतः प्रेक्ष्य सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2025491, "chapter_id": 1548, "verse_number": "३-१८६-५", "content_sanskrit": "कर्मणः पुरुषः कर्ता शुभस्याप्यशुभस्य वा।\nस्वफलं तदुपाश्नापि कथं कर्ता स्विदीश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2025492, "chapter_id": 1548, "verse_number": "३-१८६-६", "content_sanskrit": "अथवा सुखदुःखेषु नृणां ब्रह्मविदांवर।\nइह वा कृतमन्वेति परदेहेऽथवा पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2025493, "chapter_id": 1548, "verse_number": "३-१८६-७", "content_sanskrit": "देही च देहं संत्यज्य मृग्यमाणः शुभाशुभैः।\nकथं संयुज्यतेप्रेत्य इह वा द्विजसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2025494, "chapter_id": 1548, "verse_number": "३-१८६-८", "content_sanskrit": "ऐहलौकिकमेवैतदुताहो पारलौकिकम्।\nक्व वा कर्माणि तिष्ठन्ति जन्तोः प्रेतस्य भार्गव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2025495, "chapter_id": 1548, "verse_number": "३-१८६-९x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2025496, "chapter_id": 1548, "verse_number": "३-१८६-९", "content_sanskrit": "त्वद्युक्तोऽयमनुप्रश्नो यथावद्वदतांवर।\nविदितं वेदितव्यं ते स्थित्यर्थं त्वं तु पृच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2025497, "chapter_id": 1548, "verse_number": "३-१८६-१०", "content_sanskrit": "अत्र ते कथयिष्यामि तदिहैकमनाः शृणु।\nयथेहामुत्र च नर सुखदुःखमुपाश्नुते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2025498, "chapter_id": 1548, "verse_number": "३-१८६-११", "content_sanskrit": "निर्मलानि शरीराणि विशुद्धानि शरीरिणाम्।\nससर्ज धऱ्मतन्त्राणि पूर्वोत्पन्नः प्रजापतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2025499, "chapter_id": 1548, "verse_number": "३-१८६-१२", "content_sanskrit": "अमोघफलसंकल्पाः सुव्रताः सत्यवादिनः।\nब्रह्मभूता नराः पुण्याः पुराणाः कुरुसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2025500, "chapter_id": 1548, "verse_number": "३-१८६-१३", "content_sanskrit": "सर्वे देवैः समायान्ति स्वच्छन्देन नभस्तलम्।\nततश्च पुनरायान्ति सर्वे स्वच्छन्दचारिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2025501, "chapter_id": 1548, "verse_number": "३-१८६-१४", "content_sanskrit": "स्वच्चन्दमरणाश्चासन्नराः स्वच्छन्दजीविनः।\nअल्पबाधा निरातङ्काः सिद्धार्था निरुपद्रवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2025502, "chapter_id": 1548, "verse_number": "३-१८६-१५", "content_sanskrit": "द्रष्टारोदेवसङ्घानामृषीणां च महात्मनाम्।\nप्रत्यक्षाः सर्वधर्माणां दान्ता विगतमत्सराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2025503, "chapter_id": 1548, "verse_number": "३-१८६-१६", "content_sanskrit": "आसन्वर्षसहस्राणि तथा पुत्रसहस्रिणः।\nततः कालान्तरे तस्मिन्पृथिवीतलचारिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2025504, "chapter_id": 1548, "verse_number": "३-१८६-१७", "content_sanskrit": "कामक्रोधाभिभूतास्ते मायाव्याजोपजीविनः।\nलोभमोहाभिभूताश्च त्यक्ता देवैस्ततो नराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2025505, "chapter_id": 1548, "verse_number": "३-१८६-१८", "content_sanskrit": "अशुभैः कर्मभिः पापास्तिर्यङ्गिरयगामिनः।\nसंसारेषु विचित्रेषु पच्यमानाः पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2025506, "chapter_id": 1548, "verse_number": "३-१८६-१९", "content_sanskrit": "मोघेष्टा मोघसंकल्पा मोघज्ञाना विचेतसः।\n`काङ्क्षिणः सर्वकामानां नास्तिका भिन्नसेतवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2025507, "chapter_id": 1548, "verse_number": "३-१८६-२०", "content_sanskrit": "सर्वाभिशङ्खिनश्चैव संवृत्ताः क्लेदायिनः।\nअशुभैः कर्मभिश्चापि प्रायशः परिचिह्निताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2025508, "chapter_id": 1548, "verse_number": "३-१८६-२१", "content_sanskrit": "दौष्कुल्या व्याधिबहुला दुरात्मानोऽभितापिनः।\nभवन्त्यल्पायुषः पापा रौद्रकर्मफलोदयाः।\nनाथन्तः सर्वकामानां नास्तिका भिन्नचेतसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2025509, "chapter_id": 1548, "verse_number": "३-१८६-२२", "content_sanskrit": "जन्तोः प्रेतस्य कौन्तेय गतिः स्वैरिह कर्मभिः।\nप्राज्ञस्य हीनबुद्धेश्च कर्मकोशः क्व तिष्ठति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2025510, "chapter_id": 1548, "verse_number": "३-१८६-२३", "content_sanskrit": "क्वस्थस्तत्समुपाश्नाति सुकृतं यदि वेतरत्।\nइति ते दर्शनं यच्च तत्राप्यनुनयं शृणु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2025511, "chapter_id": 1548, "verse_number": "३-१८६-२४", "content_sanskrit": "अयमादिशरीरेण देवसृष्टेन मानवः।\nशुभानामशुभानां च कुरुते संचयं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2025512, "chapter_id": 1548, "verse_number": "३-१८६-२५", "content_sanskrit": "आयुषोऽन्ते प्रहायेदं क्षीणप्रायं कलेबरम्।\nसंभवत्येव युगपद्योनौ नास्त्यन्तराऽभवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2025513, "chapter_id": 1548, "verse_number": "३-१८६-२६", "content_sanskrit": "तत्रास्य स्वकृतं कर्म च्छायेवानुगतं सदा।\nफलत्यथ सुखार्हो वा दुःखार्होवाऽथ जायते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2025514, "chapter_id": 1548, "verse_number": "३-१८६-२७", "content_sanskrit": "कृतान्तविधिसंयुक्तः स जन्तुर्लक्षणैः शुभैः।\nअशुभैर्वा निरादानो लक्ष्यते ज्ञानदृष्टिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2025515, "chapter_id": 1548, "verse_number": "३-१८६-२८", "content_sanskrit": "एषा तावदबुद्धीनां गतिरुक्ता युधिष्ठिर।\nअतः परं ज्ञानवतां निबोध गतिमुत्तमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2025516, "chapter_id": 1548, "verse_number": "३-१८६-२९", "content_sanskrit": "मनुष्यास्तप्ततपसः सर्वागमपरायणाः।\nस्थिरव्रताः सत्यपरा गुरुशुश्रूषणे रताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2025517, "chapter_id": 1548, "verse_number": "३-१८६-३०", "content_sanskrit": "सुशीलाः शुक्लजातीयाः क्षान्ता दान्ताः सुतेजसः।\nशुचियोन्यन्तरगताः प्रायशः शुभलक्षणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2025518, "chapter_id": 1548, "verse_number": "३-१८६-३१", "content_sanskrit": "जितेनद्रियत्वाद्वशिनः सत्कृत्यान्मन्दरागिणः।\nअल्पाबाधपरित्रासा भवन्ति निरुपद्रवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2025519, "chapter_id": 1548, "verse_number": "३-१८६-३२", "content_sanskrit": "च्यवन्तं जायमानं च गर्भस्यं चैव सर्वशः।\nस्वमात्मानं परं चैव बुध्यन्ते ज्ञानचक्षुषः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2025520, "chapter_id": 1548, "verse_number": "३-१८६-३३", "content_sanskrit": "ऋषयस्ते महात्मानः प्रत्यक्षागमबुद्धयः।\nकर्मभूमिमिमां प्राप्य पुनर्यान्ति सुरालयम्।\n`कृत्वा शुभानि कर्माणि ज्ञानेन भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2025521, "chapter_id": 1548, "verse_number": "३-१८६-३४", "content_sanskrit": "किंचिद्दैवाद्धठात्किंचित्किंचिदेव स्वकर्मभिः।\nप्राप्नुवन्ति नरा राजन्मा तेऽस्त्वन्याविचारणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2025522, "chapter_id": 1548, "verse_number": "३-१८६-३५", "content_sanskrit": "इमामत्रोपमां चापि निबोध वदतांवर।\nमनुष्यलोके यच्छ्रेयः परंमन्ये युधिष्ठिर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2025523, "chapter_id": 1548, "verse_number": "३-१८६-३६", "content_sanskrit": "इहैवैकस्य नामुत्र अमुत्रैकस्य नो इह।\nइह चामुत्र चैकस् नामुत्रैकस्य नो इह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2025524, "chapter_id": 1548, "verse_number": "३-१८६-३७", "content_sanskrit": "धनानि येषां विपुलानि सन्ति\nनित्यंरमन्ते सुविभूषिताङ्गाः।\nतेषामयं शत्रुवरघ्नलोको\nनासौ सदा ग्राम्यसुखे रतानाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2025525, "chapter_id": 1548, "verse_number": "३-१८६-३८", "content_sanskrit": "ये योगयुक्तास्तपसि प्रसक्ताः\nस्वाध्यायशीला जरयन्ति देहान्।\nजितेन्द्रिया भूतहिते निविष्टा\nस्तेषामसौ नायमरिघ्नलोकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2025526, "chapter_id": 1548, "verse_number": "३-१८६-३९", "content_sanskrit": "ये धर्ममेव प्रथमं चरन्ति\nधर्मेण लब्ध्वा च धनानि काले।\nदारानवाप्य क्रतुभिर्यजन्ते\nतेषामयं चैव परश्च लोकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2025527, "chapter_id": 1548, "verse_number": "३-१८६-४०", "content_sanskrit": "ये नैव विद्यां न तपो न दानं\nन चापि मूढाः प्रजने यतन्ते।\nन चापिगच्छन्ति शुभान्यभाग्या-\nस्तेषामयं चैव परश्च नास्ति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2025528, "chapter_id": 1548, "verse_number": "३-१८६-४१", "content_sanskrit": "सर्वे भवन्तस्त्वतिवीर्यसत्वा\nदिव्यौजसः संहननोपपन्नाः।\nलोकादमुष्मादवनिं प्रपन्नाः\nस्वधीतविद्याः सुरकार्यहेतोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2025529, "chapter_id": 1548, "verse_number": "३-१८६-४२", "content_sanskrit": "कृत्वैव कर्माणइ महान्ति शूरा-\nस्तपोदमाचारविहारशीलाः।\nदेवानृषीन्प्रेतगतांसच् सर्वा-\nन्संतर्पयित्वा विधिना परेण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2025530, "chapter_id": 1548, "verse_number": "३-१८६-४३", "content_sanskrit": "स्वर्गं परं पुण्यकृतां निवासं\nक्रमेण संप्राप्स्यथ कर्मभिः स्वैः।\nमाभूद्विशङ्का तव कौरवेन्द्र\nदृष्ट्वाऽऽत्मनः क्लेशमिमं सुखार्थम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2025531, "chapter_id": 1548, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि मार्कण्डेयसमास्यापर्वणि षडशीत्यधिकशततमोऽध्यायः ॥ १८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]