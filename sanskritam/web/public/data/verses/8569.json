[{"id": 900007528, "chapter_id": 8569, "verse_number": "150.1", "content_sanskrit": "ॐ परेण च शब्दस्य ताद्विध्यं भूयस्त्वात्त्वनुबन्धः ॐ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900007529, "chapter_id": 8569, "verse_number": "150.2", "content_sanskrit": "भक्तिश्चैव हरावेव मुख्याऽन्यत्र यथाक्रमम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900007530, "chapter_id": 8569, "verse_number": "150.3", "content_sanskrit": "अनुवर्तते च सा भक्तिर्मुक्तावानन्दरूपिणी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900007531, "chapter_id": 8569, "verse_number": "150.4", "content_sanskrit": "तत्पूर्विकोपासनैवं कर्तव्या मुक्तये गुणैः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}]