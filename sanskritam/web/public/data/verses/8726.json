[{"id": 900009119, "chapter_id": 8726, "verse_number": "16.1", "content_sanskrit": "नैयायिकास्तु– जात्याकृतिविशिष्टा व्यक्तिः पदार्थः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900009120, "chapter_id": 8726, "verse_number": "16.2", "content_sanskrit": "किं च गवादिपदैर्जात्याकृतिवत्सर्षपादिपदैः..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900009121, "chapter_id": 8726, "verse_number": "16.3", "content_sanskrit": "किं चाकृतेरपि गोशब्दार्थत्वे गौः सास्नादिमतीत्यत्र ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900009122, "chapter_id": 8726, "verse_number": "16.4", "content_sanskrit": "किं च जात्याकृत्योर्मध्ये एकविशेषितमपरं प्रवृत्तिनिमित्तं..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900009123, "chapter_id": 8726, "verse_number": "16.5", "content_sanskrit": "अपि चोभयोर्निमित्तत्वेऽनुगताननुगताभ्यां ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900009124, "chapter_id": 8726, "verse_number": "16.6", "content_sanskrit": "तस्माज्जात्याकृतिविशिष्टव्यक्तेः पदार्थत्वे..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}]