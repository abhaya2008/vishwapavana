[{"id": 5000265000, "chapter_id": 9265, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे अष्टषष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000265001, "chapter_id": 9265, "verse_number": "३-६८-१", "content_sanskrit": "रामः प्रेक्ष्य तु तं गृध्रं भुवि रौद्रेण पातितम्।\nसौमित्रिं मित्रसम्पन्नमिदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000265002, "chapter_id": 9265, "verse_number": "३-६८-२", "content_sanskrit": "ममायं नूनमर्थेषु यतमानो विहंगमः।\nराक्षसेन हतः संख्ये प्राणांस्त्यजति मत्कृते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000265003, "chapter_id": 9265, "verse_number": "३-६८-३", "content_sanskrit": "अतिखिन्नः शरीरेऽस्मिन् प्राणो लक्ष्मण विद्यते।\nतथा स्वरविहीनोऽयं विक्लवं समुदीक्षते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000265004, "chapter_id": 9265, "verse_number": "३-६८-४", "content_sanskrit": "जटायो यदि शक्नोषि वाक्यं व्याहरितुं पुनः।\nसीतामाख्याहि भद्रं ते वधमाख्याहि चात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000265005, "chapter_id": 9265, "verse_number": "३-६८-५", "content_sanskrit": "किंनिमित्तो जहारार्यां रावणस्तस्य किं मया।\nअपराधं तु यं दृष्ट्वा रावणेन हृता प्रिया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000265006, "chapter_id": 9265, "verse_number": "३-६८-६", "content_sanskrit": "कथं तच्चन्द्रसंकाशं मुखमासीन्मनोहरम्।\nसीतया कानि चोक्तानि तस्मिन् काले द्विजोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000265007, "chapter_id": 9265, "verse_number": "३-६८-७", "content_sanskrit": "कथंवीर्यः कथंरूपः किंकर्मा स च राक्षसः।\nक्व चास्य भवनं तात ब्रूहि मे परिपृच्छतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000265008, "chapter_id": 9265, "verse_number": "३-६८-८", "content_sanskrit": "तमुद्वीक्ष्य स धर्मात्मा विलपन्तमनाथवत्।\nवाचा विक्लवया राममिदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000265009, "chapter_id": 9265, "verse_number": "३-६८-९", "content_sanskrit": "सा हृता राक्षसेन्द्रेण रावणेन दुरात्मना।\nमायामास्थाय विपुलां वातदुर्दिनसंकुलाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000265010, "chapter_id": 9265, "verse_number": "३-६८-१०", "content_sanskrit": "परिक्लान्तस्य मे तात पक्षौ छित्त्वा निशाचरः।\nसीतामादाय वैदेहीं प्रयातो दक्षिणामुखः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000265011, "chapter_id": 9265, "verse_number": "३-६८-११", "content_sanskrit": "उपरुध्यन्ति मे प्राणा दृष्टिर्भ्रमति राघव।\nपश्यामि वृक्षान् सौवर्णानुशीरकृतमूर्धजान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000265012, "chapter_id": 9265, "verse_number": "३-६८-१२", "content_sanskrit": "येन याति मुहूर्तेन सीतामादाय रावणः।\nविप्रणष्टं धनं क्षिप्रं तत्स्वामी प्रतिपद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000265013, "chapter_id": 9265, "verse_number": "३-६८-१३", "content_sanskrit": "विन्दो नाम मुहूर्तोऽसौ न च काकुत्स्थ सोऽबुधत् ।\nत्वत्प्रियां जानकीं हृत्वा रावणो राक्षसेश्वरः।\nझषवद् बडिशं गृह्य क्षिप्रमेव विनश्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000265014, "chapter_id": 9265, "verse_number": "३-६८-१४", "content_sanskrit": "न च त्वया व्यथा कार्या जनकस्य सुतां प्रति।\nवैदेह्या रंस्यसे क्षिप्रं हत्वा तं रणमूर्धनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000265015, "chapter_id": 9265, "verse_number": "३-६८-१५", "content_sanskrit": "असम्मूढस्य गृध्रस्य रामं प्रत्यनुभाषतः।\nआस्यात् सुस्राव रुधिरं म्रियमाणस्य सामिषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000265016, "chapter_id": 9265, "verse_number": "३-६८-१६", "content_sanskrit": "पुत्रो विश्रवसः साक्षाद् भ्राता वैश्रवणस्य च।\nइत्युक्त्वा दुर्लभान् प्राणान् मुमोच पतगेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000265017, "chapter_id": 9265, "verse_number": "३-६८-१७", "content_sanskrit": "ब्रूहि ब्रूहीति रामस्य ब्रुवाणस्य कृताञ्जलेः।\nत्यक्त्वा शरीरं गृध्रस्य प्राणा जग्मुर्विहायसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000265018, "chapter_id": 9265, "verse_number": "३-६८-१८", "content_sanskrit": "स निक्षिप्य शिरो भूमौ प्रसार्य चरणौ तथा।\nविक्षिप्य च शरीरं स्वं पपात धरणीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000265019, "chapter_id": 9265, "verse_number": "३-६८-१९", "content_sanskrit": "तं गृध्रं प्रेक्ष्य ताम्राक्षं गतासुमचलोपमम्।\nरामः सुबहुभिर्दुःखैर्दीनः सौमित्रिमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000265020, "chapter_id": 9265, "verse_number": "३-६८-२०", "content_sanskrit": "बहूनि रक्षसां वासे वर्षाणि वसता सुखम्।\nअनेन दण्डकारण्ये विशीर्णमिह पक्षिणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000265021, "chapter_id": 9265, "verse_number": "३-६८-२१", "content_sanskrit": "अनेकवार्षिको यस्तु चिरकालसमुत्थितः।\nसोऽयमद्य हतः शेते कालो हि दुरतिक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000265022, "chapter_id": 9265, "verse_number": "३-६८-२२", "content_sanskrit": "पश्य लक्ष्मण गृध्रोऽयमुपकारी हतश्च मे।\nसीतामभ्यवपन्नो हि रावणेन बलीयसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000265023, "chapter_id": 9265, "verse_number": "३-६८-२३", "content_sanskrit": "गृध्रराज्यं परित्यज्य पितृपैतामहं महत्।\nमम हेतोरयं प्राणान् मुमोच पतगेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000265024, "chapter_id": 9265, "verse_number": "३-६८-२४", "content_sanskrit": "सर्वत्र खलु दृश्यन्ते साधवो धर्मचारिणः।\nशूराः शरण्याः सौमित्रे तिर्यग्योनिगतेष्वपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000265025, "chapter_id": 9265, "verse_number": "३-६८-२५", "content_sanskrit": "सीताहरणजं दुःखं न मे सौम्य तथागतम्।\nयथा विनाशो गृध्रस्य मत्कृते च परंतप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000265026, "chapter_id": 9265, "verse_number": "३-६८-२६", "content_sanskrit": "राजा दशरथः श्रीमान् यथा मम महायशाः।\nपूजनीयश्च मान्यश्च तथायं पतगेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000265027, "chapter_id": 9265, "verse_number": "३-६८-२७", "content_sanskrit": "सौमित्रे हर काष्ठानि निर्मथिष्यामि पावकम्।\nगृध्रराजं दिधक्ष्यामि मत्कृते निधनं गतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000265028, "chapter_id": 9265, "verse_number": "३-६८-२८", "content_sanskrit": "नाथं पतगलोकस्य चितिमारोपयाम्यहम्।\nइमं धक्ष्यामि सौमित्रे हतं रौद्रेण रक्षसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000265029, "chapter_id": 9265, "verse_number": "३-६८-२९", "content_sanskrit": "या गतिर्यज्ञशीलानामाहिताग्नेश्च या गतिः।\nअपरावर्तिनां या च या च भूमिप्रदायिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000265030, "chapter_id": 9265, "verse_number": "३-६८-३०", "content_sanskrit": "मया त्वं समनुज्ञातो गच्छ लोकाननुत्तमान्।\nगृध्रराज महासत्त्व संस्कृतश्च मया व्रज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000265031, "chapter_id": 9265, "verse_number": "३-६८-३१", "content_sanskrit": "एवमुक्त्वा चितां दीप्तामारोप्य पतगेश्वरम्।\nददाह रामो धर्मात्मा स्वबन्धुमिव दुःखितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000265032, "chapter_id": 9265, "verse_number": "३-६८-३२", "content_sanskrit": "रामोऽथ सहसौमित्रिर्वनं गत्वा स वीर्यवान्।\nस्थूलान् हत्वा महारोहीननुतस्तार तं द्विजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000265033, "chapter_id": 9265, "verse_number": "३-६८-३३", "content_sanskrit": "रोहिमांसानि चोद‍्धृत्य पेशीकृत्वा महायशाः।\nशकुनाय ददौ रामो रम्ये हरितशाद्वले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000265034, "chapter_id": 9265, "verse_number": "३-६८-३४", "content_sanskrit": "यत् तत् प्रेतस्य मर्त्यस्य कथयन्ति द्विजातयः।\nतत् स्वर्गगमनं पित्र्यं तस्य रामो जजाप ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000265035, "chapter_id": 9265, "verse_number": "३-६८-३५", "content_sanskrit": "ततो गोदावरीं गत्वा नदीं नरवरात्मजौ।\nउदकं चक्रतुस्तस्मै गृध्रराजाय तावुभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000265036, "chapter_id": 9265, "verse_number": "३-६८-३६", "content_sanskrit": "शास्त्रदृष्टेन विधिना जलं गृध्राय राघवौ।\nस्नात्वा तौ गृध्रराजाय उदकं चक्रतुस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000265037, "chapter_id": 9265, "verse_number": "३-६८-३७", "content_sanskrit": "स गृध्रराजः कृतवान् यशस्करं\nसुदुष्करं कर्म रणे निपातितः।\nमहर्षिकल्पेन च संस्कृतस्तदा\nजगाम पुण्यां गतिमात्मनः शुभाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000265038, "chapter_id": 9265, "verse_number": "३-६८-३८", "content_sanskrit": "कृतोदकौ तावपि पक्षिसत्तमे\nस्थिरां च बुद्धिं प्रणिधाय जग्मतुः।\nप्रवेश्य सीताधिगमे ततो मनो\nवनं सुरेन्द्राविव विष्णुवासवौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000265039, "chapter_id": 9265, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे अष्टषष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]