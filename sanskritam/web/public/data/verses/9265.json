[{"id": 40017644, "chapter_id": 9265, "verse_number": "1", "content_sanskrit": "निकुम्भोभ्रातरंदृष्टवासुग्रीवेणनिपातितम् । प्रदहन्निवकोपेनवानरेन्द्रमवैक्षत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40017645, "chapter_id": 9265, "verse_number": "2", "content_sanskrit": "ततस्स्रग्दामसन्नद्धंदत्तपञ्चाङ्गुलंशुभम् । आददेपरिघंवीरोमहेन्द्रशिखरोपमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40017646, "chapter_id": 9265, "verse_number": "3", "content_sanskrit": "हेमपट्टपरिक्षिप्तंवज्रविद्रुमभूषितम् । यमदण्डोपमंभीमंरक्षसांभयनाशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40017647, "chapter_id": 9265, "verse_number": "4", "content_sanskrit": "तमाविध्यमहातेजाश्शक्रध्वजसमंतदा । निननादविवृत्तास्योनिकुम्भोभीमविक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40017648, "chapter_id": 9265, "verse_number": "5", "content_sanskrit": "उरोगतेननिष्केणभुजस्थैरङ्गदैरपि । कुण्डलाभ्यां च चित्राभ्यांमालया च विचित्रया ॥ निकुम्भोभूषणैर्भातितेनस्मपरिघेण च । यथेन्द्रधनुषामेघस्सविद्युत्स्तनयित्नुमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40017649, "chapter_id": 9265, "verse_number": "6", "content_sanskrit": "उरोगतेननिष्केणभुजस्थैरङ्गदैरपि । कुण्डलाभ्यां च चित्राभ्यांमालया च विचित्रया ॥ निकुम्भोभूषणैर्भातितेनस्मपरिघेण च । यथेन्द्रधनुषामेघस्सविद्युत्स्तनयित्नुमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40017650, "chapter_id": 9265, "verse_number": "7", "content_sanskrit": "परिघाग्रेणपुष्पोटवातग्रथनिर्महात्मनः । प्रजज्वालसघोषश्चविधूमइवपावकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40017651, "chapter_id": 9265, "verse_number": "8", "content_sanskrit": "नगर्याविटपावत्यागन्धर्वभवनोत्तमैः । सतारग्रहनक्षत्रंसचन्द्रंसमहाग्रहम् ॥ निकुम्भपरिघाघूर्णंभ्रमतीवनभस्थ्सलम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40017652, "chapter_id": 9265, "verse_number": "9", "content_sanskrit": "दुरासदश्चसञ्जज्ञेपरिघाभरणप्रभः ॥ कपीनांसनिकुम्भाग्निर्युगान्ताग्निरिवोत्थितः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40017653, "chapter_id": 9265, "verse_number": "10", "content_sanskrit": "राक्षसावानराश्चापि न शेकुस्स्पन्दितुंभयात् ॥ हनूमांस्तुविवृत्योरस्तस्थौतस्याग्रतोबली ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40017654, "chapter_id": 9265, "verse_number": "11", "content_sanskrit": "परिघोपमबाहुस्तुपरिघंभास्करप्रभम् ॥ बलीबलवतस्तस्यपातयामासवक्षसि ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40017655, "chapter_id": 9265, "verse_number": "12", "content_sanskrit": "स्थिरेतस्योरसिव्यूढेपरिघश्शतधाकृतः ॥ विकीर्यमाणस्सहसाउल्काशतमिवाम्बरे ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40017656, "chapter_id": 9265, "verse_number": "13", "content_sanskrit": "स तुतेनप्रहारेणविचचालमहाकपिः ॥ परिघेणसमाधूतोयथाभूमिचलेऽचलः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40017657, "chapter_id": 9265, "verse_number": "14", "content_sanskrit": "तथाभिहतस्तेनहनुमान् प्लवगोत्तमः ॥ मुष्टिंसम्वर्तयामासबलेनातिमहाबलः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40017658, "chapter_id": 9265, "verse_number": "15", "content_sanskrit": "तमुद्यम्यमहातेजानिकुम्भोरसिवीर्यवान् ॥ अभिचिक्षेपवेगेनवेगवान् वायुविक्रमः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40017659, "chapter_id": 9265, "verse_number": "16", "content_sanskrit": "ततःपुस्फोटचर्मास्यप्रसुस्राव च शोणितम् ॥ मुष्टिनातेनसञ्जज्ञेमेघेविद्युदिवोत्थिता ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40017660, "chapter_id": 9265, "verse_number": "17", "content_sanskrit": "सःतुतेनप्रहारेणनिकुम्भोविचचाल ह ॥ स्वस्थश्चापिनिजग्राहहनूमन्तंमहाबलम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40017661, "chapter_id": 9265, "verse_number": "18", "content_sanskrit": "चुक्रुशुस्तदासङ्ख्येभीमंलङ्कानिवासिनः ॥ निकुम्भेनोद्यतंदृष्टवाहनूमन्तंमहाबलम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40017662, "chapter_id": 9265, "verse_number": "19", "content_sanskrit": "तदाह्रियमाणोऽपिकुम्भकर्णात्मजेन ह ॥ आजघानानिलसुतोवज्रकल्पेनमुष्टिना ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40017663, "chapter_id": 9265, "verse_number": "20", "content_sanskrit": "आत्मानंमोक्षयित्वाथक्षितावभ्यवपद्यत ॥ हनूमानुन्ममाथाशुनिकुम्भंमारुतात्मजः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40017664, "chapter_id": 9265, "verse_number": "21", "content_sanskrit": "निक्षिप्यपरमायत्तोनिकुम्भंनिष्पिपेष ह ॥ उत्पत्यचास्यवेगेनपपातोरसिवीर्यवान् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40017665, "chapter_id": 9265, "verse_number": "22", "content_sanskrit": "परिगृह्य च बाहुभ्यांपरिवृत्यशिरोधराम् ॥ उत्पाटयामानशिरोभैरवंनदतोमहत् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40017666, "chapter_id": 9265, "verse_number": "23", "content_sanskrit": "अथनिनदतिसादितेनिकुम्भेपवनसुतेनरणेबभूवयुद्धम् । दशरथसुतराक्षसेन्द्रसून्वोर्भृशतरमागतरोषयोस्सुभीमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]