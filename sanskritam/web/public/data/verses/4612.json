[{"id": 2168392, "chapter_id": 4612, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2168393, "chapter_id": 4612, "verse_number": "१", "content_sanskrit": "(एवमुक्तो महाराज तव पुत्रः प्रतापवान् ।\nमद्रेश्वरं प्रति रणे परसैन्यभयङ्करम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2168394, "chapter_id": 4612, "verse_number": "२", "content_sanskrit": "सर्वं तथाऽकरोत् तूर्णं राधेयस्तद्यथाऽब्रवीत्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2168395, "chapter_id": 4612, "verse_number": "३", "content_sanskrit": "मद्रराजं च समरे प्रणम्य च महारथम् ।\nविनयेनोपसङ्गम्य प्रणयाद् वाक्यमब्रवीत्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2168396, "chapter_id": 4612, "verse_number": "", "content_sanskrit": "पुत्रस्तव महाराज मद्रराजं महारथम्\t॥४॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2168397, "chapter_id": 4612, "verse_number": "५", "content_sanskrit": "सत्यव्रत महाभाग द्विषतां तापवर्धन ।\nमद्रेश्वर रणे शूर परसैन्यभयङ्कर\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2168398, "chapter_id": 4612, "verse_number": "६", "content_sanskrit": "(मत्प्रियार्थं हितार्थं च तथा पार्थवधाय च ।)\nश्रुतवानसि कर्णस्य ब्रुवतो वदतां वर\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2168399, "chapter_id": 4612, "verse_number": "७", "content_sanskrit": "यथा नृपतिसिंहानां मध्ये त्वां वरये स्वयम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2168400, "chapter_id": 4612, "verse_number": "८", "content_sanskrit": "तत्त्वामप्रतिवीर्याद्य शत्रुपक्षक्षयावह ।\nमद्रेश्वर प्रयाचेऽहं शिरसा विनयेन च\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2168401, "chapter_id": 4612, "verse_number": "", "content_sanskrit": "तस्मात् पार्थविनाशार्थं हितार्थं मम चैव हि ।\n(त्वं पाहि सर्वतः कर्णं भवं ब्रह्मेव सुव्रत\t॥९॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2168402, "chapter_id": 4612, "verse_number": "१०", "content_sanskrit": "सारथ्यं रथिनां श्रेष्ठ प्रणयात् कर्तुमर्हसि ।\nत्वयि यन्तरि राधेयो विद्विषो मे विजेष्यते\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2168403, "chapter_id": 4612, "verse_number": "११", "content_sanskrit": "अभीषूणां हि कर्णस्य ग्रहीतान्यो न विद्यते ।\nऋते हि त्वां महाभाग वासुदेवसमं युधि\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2168404, "chapter_id": 4612, "verse_number": "१२", "content_sanskrit": "लोकेऽभीषुग्रहीता हि नान्योस्ति भवता समः ।\nस पाहि सर्वथा कर्णं यथा ब्रह्मा महेश्वरम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2168405, "chapter_id": 4612, "verse_number": "१३", "content_sanskrit": "पार्थस्य सचिवः कृष्णो यथा भीषुवरग्रहः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2168406, "chapter_id": 4612, "verse_number": "१४", "content_sanskrit": "यथा च सर्वथाऽऽपत्सु वार्ष्णेयः पाति पाण्डवम् ।\nतथा मद्रेश्वराद्य त्वं राधेयं प्रतिपालय\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2168407, "chapter_id": 4612, "verse_number": "१५", "content_sanskrit": "भीष्मो द्रोणः कृपः कर्णो भवान् भोजश्च वीर्यवान् ।\nशकुनिः सौबलो द्रौणिरहमेव च नो बलम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2168408, "chapter_id": 4612, "verse_number": "१६", "content_sanskrit": "एवमेष कृतो भागो नवधा पृथिवीपते ।\nन च भागोऽत्र भीष्मस्य द्रोणस्य च महात्मनः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2168409, "chapter_id": 4612, "verse_number": "१७", "content_sanskrit": "ताभ्यामतीत्य तौ भागौ निहता मम शत्रवः ।\nवृद्धौ हि तौ महेष्वासौ छलेन निहतौ युधि\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2168410, "chapter_id": 4612, "verse_number": "१८", "content_sanskrit": "कृत्वा चासुकरं कर्म गतौ स्वर्गमितोऽनघ ।\nतथाऽन्ये पुरुषव्याघ्राः परैर्विनिहता युधि\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2168411, "chapter_id": 4612, "verse_number": "१९", "content_sanskrit": "अस्मदीयाश्च बहवः स्वर्गाय गमिताः परैः ।\nत्यक्त्वा प्राणान् यथाशक्ति चेष्टां कृत्वा च पुष्कलाम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2168412, "chapter_id": 4612, "verse_number": "२०", "content_sanskrit": "तदिदं हतभूयिष्ठं बलं मम नराधिप ।\nपूर्वमप्यल्पकैः पार्थैर्हतं किमुत साम्प्रतम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2168413, "chapter_id": 4612, "verse_number": "२१", "content_sanskrit": "बलवन्तो महात्मानः कौन्तेयाः सत्यविक्रमाः ।\nबलं शेषं न हन्युर्मे यथा तत्कुरु पार्थिव\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2168414, "chapter_id": 4612, "verse_number": "२२", "content_sanskrit": "हतवीरमिदं सैन्यं पाण्डवैः समरे विभो ।\nकर्णो ह्येको महाबाहुरस्मत्प्रियहिते रतः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2168415, "chapter_id": 4612, "verse_number": "२३", "content_sanskrit": "भवांश्च पुरुषव्याघ्र सर्वलोकमहारथः ।\nशल्य कर्णोर्ऽजुनेनाद्य योद्धुमिच्छति संयुगे\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2168416, "chapter_id": 4612, "verse_number": "२४", "content_sanskrit": "तस्मिन् जयाशा विपुला मद्रराज नराधिप ।\nतस्याभीषुग्रहवरो नान्योऽस्ति भुवि कश्चन\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2168417, "chapter_id": 4612, "verse_number": "२५", "content_sanskrit": "पार्थस्य समरे कृष्णो यथाऽभीषुग्रहो वरः ।\nतथा त्वमपि कर्णस्य रथेऽभीषुग्रहो भव\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2168418, "chapter_id": 4612, "verse_number": "२६", "content_sanskrit": "तेन युक्तो रणे पार्थो रक्ष्यमाणश्च पार्थिव ।\nयानि कर्माणि कुरुते प्रत्यक्षाणि तथैव च\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2168419, "chapter_id": 4612, "verse_number": "२७", "content_sanskrit": "पूर्वं न समरे ह्येवमवधीदर्जुनो रिपून् ।\nइदानीं विक्रमो ह्यस्य कृष्णेन सहितस्य च\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2168420, "chapter_id": 4612, "verse_number": "२८", "content_sanskrit": "कृष्णेन सहितः पार्थो धार्तराष्ट्रीं महाचमूम् ।\nअहन्यहनि मद्रेश द्रावयन् दृश्यते युधि\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2168421, "chapter_id": 4612, "verse_number": "२९", "content_sanskrit": "भागोऽवशिष्टः कर्णस्य तव चैव महाद्युते ।\nतं भागं सह कर्णेन युगपन्नाशयाद्य हि\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2168422, "chapter_id": 4612, "verse_number": "३०", "content_sanskrit": "अरुणेन यथा सार्धं तमः सूर्यो व्यपोहति ।\nतथा कर्णेन सहितो जहि पार्थं महाहवे\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2168423, "chapter_id": 4612, "verse_number": "३१", "content_sanskrit": "उद्यन्नेव यथा सूर्यौ बालसूर्यसमप्रभौ ।\nकर्णशल्यौ रणे दृष्ट्वा विद्रवन्तु महारथाः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2168424, "chapter_id": 4612, "verse_number": "३२", "content_sanskrit": "सूर्यारुणौ यथा दृष्ट्वा तमो नश्यति मारिष ।\nतथा नश्यन्तु कौन्तेयाः सपाञ्चालाः ससृञ्जयाः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2168425, "chapter_id": 4612, "verse_number": "३३", "content_sanskrit": "रथिनां प्रवरः कर्णो यन्तॄणां प्रवरो भवान् ।\nसंयोगो युवयोर्लोके नाभून्न च भविष्यति\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2168426, "chapter_id": 4612, "verse_number": "३४", "content_sanskrit": "यथा सर्वास्ववस्थासु वार्ष्णेयः पाति पाण्डवम् ।\nतथा भवान् परित्रातु कर्णं वैकर्तनं रणे\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2168427, "chapter_id": 4612, "verse_number": "३५", "content_sanskrit": "(सारथ्यं क्रियतां तस्य युध्यमानस्य संयुगे\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2168428, "chapter_id": 4612, "verse_number": "", "content_sanskrit": "यथा च समरे कृष्णो रक्षते सर्वतोऽर्जुनम् ।\nतथा त्वमपि राधेयं रक्षस्व च महारणे\t॥३६॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2168429, "chapter_id": 4612, "verse_number": "३७", "content_sanskrit": "त्वया सारथिना ह्येष अप्रधृष्यो भविष्यति ।\nदेवतानामपि रणे सशक्राणां महीपते\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2168430, "chapter_id": 4612, "verse_number": "३८", "content_sanskrit": "किं पुनः पाण्डवेयानां मा विशङ्कीर्वचो मम\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2168431, "chapter_id": 4612, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2168432, "chapter_id": 4612, "verse_number": "", "content_sanskrit": "दुर्योधनवचः श्रुत्वा शल्यः क्रोधसमन्वितः ।\n(धार्तराष्ट्रमथोवाच सृक्विणी परिलेलिहन्\t॥३९॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2168433, "chapter_id": 4612, "verse_number": "४०", "content_sanskrit": "त्रिशिखां भ्रुकुटिं कृत्वा धुन्वन् हस्तौ पुनः पुनः ।\nक्रोधरक्ते महानेत्रे परिवृत्य महाभुजः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2168434, "chapter_id": 4612, "verse_number": "४१", "content_sanskrit": "कुलैश्वर्यश्रुतबलैर्दृप्तः शल्योऽब्रवीदिदम्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2168435, "chapter_id": 4612, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2168436, "chapter_id": 4612, "verse_number": "४२", "content_sanskrit": "अवमन्यस्ये मां गान्धारे ध्रुवं मां परिशङ्कसे ।\nयन्मां ब्रवीषि विस्रब्धः सारथ्यं क्रियतामिति\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2168437, "chapter_id": 4612, "verse_number": "४३", "content_sanskrit": "अस्मत्तोऽभ्यधिके कर्णं मन्वानस्तं प्रशंससि ।\nन चाहं युधि राधेयं गणये तुल्यमात्मनः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2168438, "chapter_id": 4612, "verse_number": "४४", "content_sanskrit": "आदिश्यतामभ्यधिको ममांशः पृथिवीपते ।\nतमहं समरे हत्वा गमिष्यामि यथागतम्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2168439, "chapter_id": 4612, "verse_number": "४५", "content_sanskrit": "अथवाप्येक एवाहं योत्स्यामि तव शत्रुभिः ।\nपश्य वीर्यं ममाद्य त्वं सङ्ग्रामे दहतो रिपून्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2168440, "chapter_id": 4612, "verse_number": "४६", "content_sanskrit": "तवातिकामं कौरव्य निधाय हृदये पुमान् ।\nअस्मद्विधः प्रवर्तेत मा मा त्वमतिशङ्किथाः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2168441, "chapter_id": 4612, "verse_number": "४७", "content_sanskrit": "अपि चाप्यवमानो मे न कर्तव्यः कथञ्चन ।\nपश्य भीमौ मम भुजौ वज्रसंहननौ दृढौ\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2168442, "chapter_id": 4612, "verse_number": "४८", "content_sanskrit": "धनुः पश्य च मे चित्रं शरांश्चाशीविषोपमान् ।\nरथं च पश्य मे क्लृप्तं सदश्वैर्वातवेगिभिः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2168443, "chapter_id": 4612, "verse_number": "४९", "content_sanskrit": "गदां च पश्य गान्धारे हेमपट्टविभूषिताम् ।\nदारयेयं महीं क्रुद्धो विकिरेयं च पर्वतान्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2168444, "chapter_id": 4612, "verse_number": "५०", "content_sanskrit": "शोषयेयं समुद्रांश्च पातयेयं च भास्करम्\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2168445, "chapter_id": 4612, "verse_number": "५१", "content_sanskrit": "तं मामेवंविधं राजन् समर्थमरिनिग्रहे ।\nकस्माद्युनङ्क्षि सारथ्ये सूतस्याधिरथेस्तु माम्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2168446, "chapter_id": 4612, "verse_number": "५२", "content_sanskrit": "न चापि मम राधेयः कलामर्हति षोडशीम्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2168447, "chapter_id": 4612, "verse_number": "५३", "content_sanskrit": "सकर्णा ये त्रयो लोकाः सार्जुनाः सजनार्दनाः ।\nनिबद्धांस्तान् रणे राजन्न गणेयं कथञ्चन\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2168448, "chapter_id": 4612, "verse_number": "५४", "content_sanskrit": "न चाहं प्राकृतः कश्चिन्न चास्म्यधिगतः स्वयम् \t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2168449, "chapter_id": 4612, "verse_number": "५५", "content_sanskrit": "न मामर्हसि राजेन्द्र नियोक्तुं कर्मणीदृशे ।\nन हि पापीयसः श्रेयान् प्रेष्यत्वं कर्तुमर्हति\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2168450, "chapter_id": 4612, "verse_number": "५६", "content_sanskrit": "यो ह्यभ्युपगतं मित्रं गरीयांसं विशेषतः ।\nवशे पापीयसो धत्ते तत्कार्यमधरोत्तरम्\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2168451, "chapter_id": 4612, "verse_number": "५७", "content_sanskrit": "ब्रह्मणा ब्राह्मणाः सृष्टा मुखात् क्षत्रं च बाहुतः ।\nऊरूभ्यामथ वैश्या वै शूद्राः पद्भ्यामिति श्रुतिः\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2168452, "chapter_id": 4612, "verse_number": "५८", "content_sanskrit": "तेभ्यो वर्णविशेषाश्च प्रतिलोमानुलोमजाः ।\nअथान्योन्यस्य संयोगाच्चातुर्वर्ण्यस्य भारत\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2168453, "chapter_id": 4612, "verse_number": "५९", "content_sanskrit": "गोप्तारः सङ्गृहीतारो दातारः क्षत्रियाः स्मृताः\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2168454, "chapter_id": 4612, "verse_number": "६०", "content_sanskrit": "याजनाध्यापनैर्विप्रा विशुद्धैश्च प्रतिग्रहैः ।\nलोकस्यानुग्रहार्थाय स्थापिता ब्राह्मणा भुवि\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2168455, "chapter_id": 4612, "verse_number": "६१", "content_sanskrit": "कृषिश्च पाशुपाल्यं च विशां दानं च धर्मतः ।\nब्रह्मक्षत्रविशां शूद्रा विहिताः परिचारकाः\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2168456, "chapter_id": 4612, "verse_number": "६२", "content_sanskrit": "ब्रह्मक्षत्रस्य विहिताः सूता वै परिचारकाः ।\nन क्षत्रियो वै सूतानां शृणु चेदं वचो मम\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2168457, "chapter_id": 4612, "verse_number": "६३", "content_sanskrit": "अहं मूर्धाभिषिक्तो हि राजर्षिकुलजो नृपः ।\nमहारथसमाख्यातः सेव्यः स्तुत्यश्च वन्दिनाम्\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2168458, "chapter_id": 4612, "verse_number": "६४", "content_sanskrit": "सोऽहमेतादृशो भूत्वा नेहारिबलसूदनः ।\nसूतपुत्रस्य सङ्ग्रामे सारथ्यं कर्तुमुत्सहे\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2168459, "chapter_id": 4612, "verse_number": "६५", "content_sanskrit": "अवमन्यसे मां गान्धारे ध्रुवं चाप्यतिशङ्कसे ।\nअयं चाप्यवमानो मे न कर्तव्यः कथञ्चन\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2168460, "chapter_id": 4612, "verse_number": "६६", "content_sanskrit": "आपृच्छे त्वाद्य गान्धारे यास्यामि विषयं प्रति ।\nन चाहं सूतपुत्रस्य सारथ्यमुपजग्मिवान्\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2168461, "chapter_id": 4612, "verse_number": "६७", "content_sanskrit": "अवमानमहं प्राप्य न योत्स्यामि कथञ्चन ।\nआपृच्छे त्वाऽद्य गान्धारे गमिष्यामि गृहाय वै\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2168462, "chapter_id": 4612, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2168463, "chapter_id": 4612, "verse_number": "६८", "content_sanskrit": "एवमुक्त्वा महाराज शल्यः समितिशोभनः ।\nउत्थाय प्रययौ तूर्णं राजमध्यादमर्षितः\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2168464, "chapter_id": 4612, "verse_number": "६९", "content_sanskrit": "प्रणयाद् बहुमानाच्च तं निगृह्य सुतस्तव ।\nअब्रवीन्मधुरं वाक्यं साम्ना सर्वार्थसाधकम्\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2168465, "chapter_id": 4612, "verse_number": "७०", "content_sanskrit": "यथा शल्य त्वमात्थेदमेवमेतदसंशयम् ।\nअभिप्रायस्तु मे कश्चित्तं निबोध जनेश्वर\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2168466, "chapter_id": 4612, "verse_number": "७१", "content_sanskrit": "न कर्णोऽभ्यधिकस्त्वत्तो न चान्ये चैव पार्थिवाः ।\nन च मद्रेश्वर त्वां वै कर्णः सोढुं च शक्ष्यति\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2168467, "chapter_id": 4612, "verse_number": "७२", "content_sanskrit": "ऋतमेव हि पूर्वास्ते वदन्ति पुरुषोत्तमाः ।\nतस्मादार्तायनिः प्रोक्तो भवानिति मतिर्मम\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2168468, "chapter_id": 4612, "verse_number": "७३", "content_sanskrit": "शल्यभूतस्तु शत्रूणां यस्मात्त्वं युधि मानद ।\nतस्माच्छल्येति ते नाम कथ्यते पृथिवीतळे\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2168469, "chapter_id": 4612, "verse_number": "७४", "content_sanskrit": "यदेतद्व्याहृतं पूर्वं भवता भूरिदक्षिण ।\nतदेव कुरु धर्मज्ञ मदर्थं यद्यदुच्यसे\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2168470, "chapter_id": 4612, "verse_number": "७५", "content_sanskrit": "न च त्वत्तो हि राधेयो न चाहमपि वीर्यवान् ।\nवृणेऽहं त्वां हयाग्र्याणां यन्तारमिह संयुगे\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2168471, "chapter_id": 4612, "verse_number": "७६", "content_sanskrit": "मन्ये चाभ्यधिकं शल्य गुणैः कर्णं धनञ्जयात् ।\nभवन्तं वासुदेवाच्च लोकोऽयमतिमन्यते\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2168472, "chapter_id": 4612, "verse_number": "७७", "content_sanskrit": "कर्णो ह्यभ्यधिकः पार्थादस्त्रैरेव नरर्षभ ।\nभवानभ्यधिकः कृष्णादश्वज्ञाने बले तथा\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2168473, "chapter_id": 4612, "verse_number": "७८", "content_sanskrit": "यथाऽश्वहृदयं वेद वासुदेवो महामनाः ।\nद्विगुणं त्वं तथा वेत्सि मद्रराजेश्वरात्मज\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2168474, "chapter_id": 4612, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2168475, "chapter_id": 4612, "verse_number": "७९", "content_sanskrit": "यन्मां ब्रवीषि गान्धारे मध्ये सैन्यस्य कौरव ।\nविशिष्टं देवकीपुत्रात् प्रीतिमानस्म्यहं त्वयि\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2168476, "chapter_id": 4612, "verse_number": "८०", "content_sanskrit": "एष सारथ्यमातिष्ठे राधेयस्य यशस्विनः ।\nयुध्यतः पाण्डवाग्र्येण यथा त्वं वीर मन्यसे\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2168477, "chapter_id": 4612, "verse_number": "८१", "content_sanskrit": "समयश्च हि मे वीर कश्चिद्वैकर्तनं प्रति ।\nउत्सृजेयं यथाश्रद्धमहं वाचोऽस्य सन्निधौ\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2168478, "chapter_id": 4612, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2168479, "chapter_id": 4612, "verse_number": "८२", "content_sanskrit": "तथेति राजन् पुत्रस्ते सह कर्णेन भारत ।\nअब्रवीन्मद्रराजस्य मतं भरतसत्तम\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2168480, "chapter_id": 4612, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां कर्णपर्वणि\nशल्यसारथ्यनिर्णयो नाम द्वात्रिंशोऽध्यायः ॥३२॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}]