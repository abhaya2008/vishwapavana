[{"id": 2009333, "chapter_id": 1184, "verse_number": "१-१८५-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2009334, "chapter_id": 1184, "verse_number": "१-१८५-१", "content_sanskrit": "गते भगवति व्यासे पाण्डवा हृष्टमानसाः।\nते प्रयाता नरव्याघ्रा मात्रा सह परन्तपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2009335, "chapter_id": 1184, "verse_number": "१-१८५-२", "content_sanskrit": "ब्राह्मणान्गच्छतो पश्यन्पाञ्चालान्सगणान्पथि।\nअथ ते ब्राह्मणा ऊचुः पाण्डवान्ब्रह्मचारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2009336, "chapter_id": 1184, "verse_number": "१-१८५-३", "content_sanskrit": "क्व भवन्तो गमिष्यन्ति कुतो वाऽऽगच्छथेति ह।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2009337, "chapter_id": 1184, "verse_number": "१-१८४-३x", "content_sanskrit": "युधिष्ठिर उवाच।\nप्रयातानेकचक्रायाः सोदर्यान्देवदर्शिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2009338, "chapter_id": 1184, "verse_number": "१-१८५-४", "content_sanskrit": "भवन्तो नोऽभिजानन्तु सहितान्ब्रह्मचारिणः।\nगच्छतो नस्तु पाञ्चालान्द्रुपदस्य पुरं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2009339, "chapter_id": 1184, "verse_number": "१-१८५-५", "content_sanskrit": "इच्छामो भवतो ज्ञातुं परं कौतूहलं हि नः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2009340, "chapter_id": 1184, "verse_number": "१-१८५-६x", "content_sanskrit": "ब्राह्मणा ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2009341, "chapter_id": 1184, "verse_number": "१-१८५-६", "content_sanskrit": "एते सार्धं प्रयाताः स्मो वयमप्यत्र गामिनः।\nतत्राप्यद्भुतसङ्काश उत्सवो भविता महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2009342, "chapter_id": 1184, "verse_number": "१-१८५-७", "content_sanskrit": "ततस्तु यज्ञसेनस्य द्रुपदस्य महात्मनः।\nयासावयोनिजा कन्या स्थास्यते सा स्वयंवरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2009343, "chapter_id": 1184, "verse_number": "१-१८५-८", "content_sanskrit": "दर्शनीयाऽनवद्याङ्गी सुकुमारी यशस्विनी।\nधृष्टद्युम्नस्य भगिनी द्रोणशत्रोः प्रतापिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2009344, "chapter_id": 1184, "verse_number": "१-१८५-९", "content_sanskrit": "जातो यः पावकाच्छूरः सशरः सशरासनः।\nसुसमिद्धान्महाभागः सोमकानां महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2009345, "chapter_id": 1184, "verse_number": "१-१८५-१०", "content_sanskrit": "यस्मिन्संजायमाने हि वागुवाचाशरीरिणी।\nएष मृत्युश्च शिष्यश्च भारद्वाजस्य जायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2009346, "chapter_id": 1184, "verse_number": "१-१८५-११", "content_sanskrit": "स्वसा तस्य तु वेद्याश्च जाता तस्मिन्महामखे।\nस्त्रीरत्नमसितापाङ्गी श्यामा नीलोत्पलद्युतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2009347, "chapter_id": 1184, "verse_number": "१-१८५-१२", "content_sanskrit": "तां यज्ञसेनस्य सुतां द्रौपदीं परमां स्त्रियम्।\nगच्छामस्तत्र वै द्रष्टुं तं चैवास्याः स्वयंवरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2009348, "chapter_id": 1184, "verse_number": "१-१८५-१३", "content_sanskrit": "राजानो राजपुत्राश्च यज्वानो भूरिदक्षिणाः।\nस्वाध्यायवन्तः शुचयो महात्मानो धृतव्रताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2009349, "chapter_id": 1184, "verse_number": "१-१८५-१४", "content_sanskrit": "तरुणा दर्शनीयाश्च बलवन्तो दुरासदाः।\nमहारथाः कृतास्त्राश्च समेष्यन्तीह भूमिपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2009350, "chapter_id": 1184, "verse_number": "१-१८५-१५", "content_sanskrit": "ते तत्र विविधं दानं विजयार्थं नरेश्वराः।\nप्रदास्यन्ति धनं गाश्च भक्ष्यभोज्यानि सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2009351, "chapter_id": 1184, "verse_number": "१-१८५-१६", "content_sanskrit": "प्रतिलप्स्यामहे सर्वं दृष्ट्वा कृष्णां स्वयंवरे।\nयं च सा क्षत्रियं रङ्गे कुमारी वरयिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2009352, "chapter_id": 1184, "verse_number": "१-१८५-१७", "content_sanskrit": "तदा वैतालिकाश्चैव नर्तकाः सूतमागधाः।\nनिबोधकाश्च देशेभ्यः समेष्यन्ति महाबलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2009353, "chapter_id": 1184, "verse_number": "१-१८५-१८", "content_sanskrit": "एतत्कौतूहलं तत्र दृष्ट्वा वै प्रतिगृह्य च।\nसहास्माभिर्महात्मानो मात्रा सह निवत्स्यथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2009354, "chapter_id": 1184, "verse_number": "१-१८५-१९", "content_sanskrit": "दर्शनीयांश्च वः सर्वानेकरूपानवस्थितान्।\nसमीक्ष्य कृष्मा वरयेत्संगत्यान्यतमं पतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2009355, "chapter_id": 1184, "verse_number": "१-१८५-२०", "content_sanskrit": "अयमेकश्च वो भ्राता दर्शनीयो महाभुजः।\nनियुध्यमानो विजयेत्संगत्य द्रविणं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2009356, "chapter_id": 1184, "verse_number": "१-१८५-२१x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2009357, "chapter_id": 1184, "verse_number": "१-१८५-२१", "content_sanskrit": "परमं भो गमिष्यामो द्रष्टुं तत्र स्वयंवरम्।\nद्रौपदीं यज्ञसेनस्य कन्यां तस्यास्तथोत्सवम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2009358, "chapter_id": 1184, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि चैत्ररथपर्वणि पञ्चाशीत्यधिकशततमोऽध्यायः॥ १८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]