[{"id": 7003145000, "chapter_id": 23145, "verse_number": "४-८१-१", "content_sanskrit": "श्रीकृष्ण उवाय ।\nएतस्मिन्नन्तरे शुक्रः सुरश्रेणीं ददर्श सः ।\nआकाशमार्गादायान्तीं रणशस्त्रास्त्रधारिणीम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003145001, "chapter_id": 23145, "verse_number": "४-८१-२", "content_sanskrit": "पताकानां त्रिकोटिश्च शतकोटिर्महारथाः ।\nशतकोटिर्गजेन्द्राणां रथानां तच्चतुर्गुणम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003145002, "chapter_id": 23145, "verse_number": "४-८१-३", "content_sanskrit": "अश्वानां तत्छतगुणं समूहं च सुदारुणम् ।\nपदातीनां समूहं च तुरङ्गेभ्यश्च षड्गुणम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003145003, "chapter_id": 23145, "verse_number": "४-८१-४", "content_sanskrit": "दुंदूभीवाद्यभाण्डानां पञ्चलक्षं तथैव च ।\nपटहानां त्रिलक्षं च डिण्डिमानां द्विलक्षकम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003145004, "chapter_id": 23145, "verse_number": "४-८१-५", "content_sanskrit": "ऐरावते महेन्द्रं च श्वेताश्वे धर्ममेव च ।\nकुबेरं वरुणं वह्निं रथस्थं पवनं तथा ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003145005, "chapter_id": 23145, "verse_number": "४-८१-६", "content_sanskrit": "महिषस्थं यमं चैव स्यन्दनस्थं दिवाकरम् ।\nईशानं च वृषेन्द्रस्थमनन्तं नागवाहम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003145006, "chapter_id": 23145, "verse_number": "४-८१-७", "content_sanskrit": "आदित्यांश्च वसून्रुद्रान्सिद्धगन्धर्वाकिन्नरान् ।\nजीवन्मुक्तमुनीनां च समीहं सूर्यवर्चसम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003145007, "chapter_id": 23145, "verse_number": "४-८१-८", "content_sanskrit": "तान्दृष्ट्वा निर्भयः शुक्रः समाश्वास्य निशाकरम् ।\nसुराणां द्विगुणं सैन्यमाजुहाव व्रजेश्वर ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003145008, "chapter_id": 23145, "verse_number": "४-८१-९", "content_sanskrit": "रत्नमालानदीतीरे हुताशनप्रियाश्रमे ।\nतत्र तस्थौ दैत्यसैन्यं पुण्यक्षीरोदधेस्तटे ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003145009, "chapter_id": 23145, "verse_number": "४-८१-१०", "content_sanskrit": "एतस्मिन्नन्तरे शुक्रः समीपे सरसस्तटे ।\nपुण्याश्रमेऽक्षयवटे सुरसैन्यात्समागतम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003145010, "chapter_id": 23145, "verse_number": "४-८१-११", "content_sanskrit": "ददर्श वृषभस्थं च शंकरं सर्वंशंकरम् ।\nत्रिशूलपट्टीशधरं व्याघ्रचर्माम्बरं वरम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003145011, "chapter_id": 23145, "verse_number": "४-८१-१२", "content_sanskrit": "तेजःस्वरूपं परमं भक्तानुग्रहविग्रहम् ।\nसर्दसंपत्प्रदातारं सर्वज्ञं सर्वकारणम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003145012, "chapter_id": 23145, "verse_number": "४-८१-१३", "content_sanskrit": "सर्वेश्वरं सर्वपूज्यं सर्वहूपं सनातनम् ।\nशरणागतदीनार्तं परित्राणपरायणम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003145013, "chapter_id": 23145, "verse_number": "४-८१-१४", "content_sanskrit": "सस्मितं परमात्मानं ज्वलन्तं ब्रह्मतेजसा ।\nसंत्रस्तः सहसोत्थाय प्रणनाम पदाम्बुजे ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003145014, "chapter_id": 23145, "verse_number": "४-८१-१५", "content_sanskrit": "ददौ शुभाशिषं तस्मै सुप्रसन्नः परात्परः ।\nरत्नसिंहासने तं च वासयामास सादरम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003145015, "chapter_id": 23145, "verse_number": "४-८१-१६", "content_sanskrit": "अथ तत्रान्तरे विप्रं पुरतस्तं ददर्श सः ।\nशान्तं स्वयं विधातारं रत्नस्यन्दनमुन्दरम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003145016, "chapter_id": 23145, "verse_number": "४-८१-१७", "content_sanskrit": "वह्निशुद्धांशुकाधानं रत्नमालाविभूषितम् ।\nप्रसन्नं सुस्मितं शुद्धं जगतामीश्वरं परम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003145017, "chapter_id": 23145, "verse_number": "४-८१-१८", "content_sanskrit": "कर्मणां फलदातारं तपोरूपं तपश्विनाम् ।\nवेदानां जनकं वेदप्रसूं कान्तं मनोहरम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003145018, "chapter_id": 23145, "verse_number": "४-८१-१९", "content_sanskrit": "पुटाञ्जलिस्तदा त्रस्तः प्रणनाम सुरेश्वरम् ।\nरत्नसिंहासने रम्ये वासयामास भक्तितः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003145019, "chapter_id": 23145, "verse_number": "४-८१-२०", "content_sanskrit": "पूजां चकार भक्त्या च तयोश्चरणपङ्कजे ।\nनोचितं कुशलप्रश्नं तयोः कल्याणमेव च ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003145020, "chapter_id": 23145, "verse_number": "४-८१-२१", "content_sanskrit": "विधाता जगतां नन्द शकाचार्यं पुरस्थितम् ।\nसुनीतिं कथयामास यत्नतः शंमुसंमतः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003145021, "chapter_id": 23145, "verse_number": "४-८१-२२", "content_sanskrit": "श्रृणु शुक्र प्रवक्ष्यामि तुर्नीतिं शशिनः सुत ।\nलज्जाकारं त्रिजगतां कर्म वेदबहिष्कृतम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003145022, "chapter_id": 23145, "verse_number": "४-८१-२३", "content_sanskrit": "स्नात्वा गृहोन्मुखीं तारां गुरुपत्नीं पतिव्रताम् ।\nगृहीत्वा शरणापन्नस्त्वयि पापश्च संप्रतम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003145023, "chapter_id": 23145, "verse_number": "४-८१-२४", "content_sanskrit": "प्रस्तुतं देवसैन्यं च पश्य वत्स रणोद्यतम् ।\nअहं शंभुस्त्वत्समीपं तदर्थं च समागतौ ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003145024, "chapter_id": 23145, "verse_number": "४-८१-२५", "content_sanskrit": "शंभुरुवाच ।\nचन्द्रमानय हे विप्र यद्यात्मशिवमिच्छसि ।\nसंहरिष्ये सिरस्तस्य त्रिशूरेन च पापिनः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003145025, "chapter_id": 23145, "verse_number": "४-८१-२६", "content_sanskrit": "अन्यथा संहरिष्यामि सर्वदैत्यान्क्षणेन च ।\nमयि रुष्टे रक्षिता को दैत्यानां च भवेद्द्विज ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003145026, "chapter_id": 23145, "verse_number": "४-८१-२७", "content_sanskrit": "सद्यः पाशुपतेनैव वाय्वस्त्रेण च र्सांप्रतम् ।\nसुराणां रिपुवर्गं च हरिष्यामि च लीलया ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003145027, "chapter_id": 23145, "verse_number": "४-८१-२८", "content_sanskrit": "दुर्वाससो मदंशस्य गुरुस्तस्याङ्गिरा सुनिः ।\nपरस्पराच्च संबन्धाद्गुरुपुत्रो गुरुर्मम ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003145028, "chapter_id": 23145, "verse_number": "४-८१-२९", "content_sanskrit": "बृहस्पतिश्च तेजस्वी तं भस्मीकर्तुमीश्वरः ।\nन चकार कृपालुश्चेत्प्रियशिष्येण हेतुना ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003145029, "chapter_id": 23145, "verse_number": "४-८१-३०", "content_sanskrit": "उतथ्यपत्नीं दृष्ट्वा स पुरा रेमे स्वकामतः ।\nतत्पतेः शापतोऽस्यैव परग्रस्ता प्रिया सती ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003145030, "chapter_id": 23145, "verse_number": "४-८१-३१", "content_sanskrit": "पत्नीं मद्गुरुपुत्रस्य देहि तार्रां मनोहराम् ।\nमद्वैरिणं च चन्द्रं च भ्रादृभार्यापहारिणम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003145031, "chapter_id": 23145, "verse_number": "४-८१-३२", "content_sanskrit": "शरणागतदीनार्तं न हि रक्षेद्यदीश्वरः ।\nपच्यते निरये तावद्यावदिन्दाश्चतुदर्श ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003145032, "chapter_id": 23145, "verse_number": "४-८१-३३", "content_sanskrit": "अत्र नास्ति विचारो मे पापिष्ठे शरणागते ।\nपापी यं शरणं याति स पापी च न संशयः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003145033, "chapter_id": 23145, "verse_number": "४-८१-३४", "content_sanskrit": "देहि तं विप्रशार्दूल पापिनं मातृगामिनम् ।\nबहिष्कृत्य स्वाश्रमाच्च तारासाध्वीसमन्वितम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003145034, "chapter_id": 23145, "verse_number": "४-८१-३५", "content_sanskrit": "शुक्र उवाच ।\nसुराणामसुराणां च सर्वेषां जगतामपि ।\nत्वमेव शास्ता भगवान्को वा शास्ति सुरेऽसुरे ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003145035, "chapter_id": 23145, "verse_number": "४-८१-३६", "content_sanskrit": "कृत्वा सुराणां साहाय्यं कथं दैत्यान्हनिष्यसि ।\nसंहर्तुः सर्वजगतां दैत्यौधे किं च पौरुषम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003145036, "chapter_id": 23145, "verse_number": "४-८१-३७", "content_sanskrit": "त्वं जयोतिः परमं ब्रह्म सगुणो निर्गुणः स्वयम् ।\nगुणभेदान्मूर्तिभेदो ब्रह्मविष्णुशिवात्मकः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003145037, "chapter_id": 23145, "verse_number": "४-८१-३८", "content_sanskrit": "बलिद्वारे गदापाणिः स्वयमेव भवान्प्रभो ।\nस्वयं प्रदत्ता शक्राय तस्मै श्रीरपि लीलया ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003145038, "chapter_id": 23145, "verse_number": "४-८१-३९", "content_sanskrit": "क्षमस्व भगञ्छंभो हर क्रोधं च संहर ।\nकिं पौरुषं च भवतो ब्रह्मणस्यापि हिंसया ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003145039, "chapter_id": 23145, "verse_number": "४-८१-४०", "content_sanskrit": "अहं जीवञ्छरीरेण न दास्यामि निशाकरम् ।\nशरणागतदीनार्तं लज्जिर्वं पापसंयुतम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003145040, "chapter_id": 23145, "verse_number": "४-८१-४१", "content_sanskrit": "अहं च त्वत्पदाम्भोजे शरणं यामि शंकर ।\nयथोचितं कुरु विभो जगत्सर्वं तथैव च ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003145041, "chapter_id": 23145, "verse_number": "४-८१-४२", "content_sanskrit": "शुक्रस्य वचनं श्रुत्वा प्रसन्नो भगवाञ्छिवः ।\nइत्युवाच निशानाथं समानय शुभं भवेत् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003145042, "chapter_id": 23145, "verse_number": "४-८१-४३", "content_sanskrit": "एतस्मिन्नन्तरे ब्रह्मा बोधयित्वा कविं विभुः ।\nसमानीय निशानाथं तारकासहितं व्रज ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003145043, "chapter_id": 23145, "verse_number": "४-८१-४४", "content_sanskrit": "शंभोश्च चरणाम्भोजे चकार च समर्पणम् ।\nशंभुस्तं प्रीतियुक्तश्च वासयामास वक्षसि ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003145044, "chapter_id": 23145, "verse_number": "४-८१-४५", "content_sanskrit": "दत्तवा तस्मै पादरेणुं निष्पापं च चकार सः ।\nदत्तवा तन्मस्तके हस्तं कृपालुरभयं ददौ ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003145045, "chapter_id": 23145, "verse_number": "४-८१-४६", "content_sanskrit": "क्षीरोदे स्नापयित्वा च प्रायश्चित्तेन शंकरः ।\nचकार चन्द्रं निष्पापं ब्रह्मणा सहितः शुचिम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003145046, "chapter_id": 23145, "verse_number": "४-८१-४७", "content_sanskrit": "योगेन चन्द्रं योगीन्द्रो द्विखण्डं तं चकार सः ।\nररक्षार्धं ललाटे च सोऽप्यर्धं ब्रह्मणः पुरः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003145047, "chapter_id": 23145, "verse_number": "४-८१-४८", "content_sanskrit": "अत एव महादेवो बभूव चन्द्रशेखरः ।\nमृगाङ्को लज्जितस्तत्र कलङ्कीं देवसंसदि ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003145048, "chapter_id": 23145, "verse_number": "४-८१-४९", "content_sanskrit": "लज्जया च स्वयोगेन देहत्यागं चकार सः ।\nतच्छरीरं च क्षीरोदे ब्रह्मणा च समर्पितम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003145049, "chapter_id": 23145, "verse_number": "४-८१-५०", "content_sanskrit": "रुरोदात्रिश्च कृबया शुचा क्षीरोदधेस्तटे ।\nअत्रेश्चक्षुर्जलं तस्य पपात च जले व्रज ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003145050, "chapter_id": 23145, "verse_number": "४-८१-५१", "content_sanskrit": "तस्माद्बभूव चन्द्रश्च निष्पापो देवसंसदि ।\nब्रह्मा च भगवाञ्छंभुरभिषेकं चकार तम् ।\nउवाच तं महादेवो निर्भयं देवसंसदि ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003145051, "chapter_id": 23145, "verse_number": "४-८१-५२", "content_sanskrit": "महादेव उवाच ।\nस्वस्थानं गच्छ पुत्र त्वं कुरुष्व विषयं मुदा ।\nपश्चात्तस्याश्च शापेनयक्ष्मग्रस्तोभविष्यसि ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003145052, "chapter_id": 23145, "verse_number": "४-८१-५३", "content_sanskrit": "व्यर्थं पतिव्रताशापं कर्तुमीशश्चको भुवि ।\nमदाशिषा यक्ष्मणश्च प्रतीकारो भविष्यति ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003145053, "chapter_id": 23145, "verse_number": "४-८१-५४", "content_sanskrit": "यस्माद्भाद्रचतुर्थ्यां तु गुरुपत्नीक्षतिः कृता ।\nतस्मात्तस्मिन्दिने वत्स पापदृश्यो युगे युगे ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003145054, "chapter_id": 23145, "verse_number": "४-८१-५५", "content_sanskrit": "नाभुक्तं क्षीयते कर्म कल्पकोटिशतैरपि ।\nअवश्यमेव भोक्तव्यं कृतं कर्म शुभाशुभम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003145055, "chapter_id": 23145, "verse_number": "४-८१-५६", "content_sanskrit": "देहत्यागेन हे वत्स कर्मभोगो न नश्यति ।\nप्रायश्चित्तान्न संदेहो ङ्यस्तमेव भविष्यति ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003145056, "chapter_id": 23145, "verse_number": "४-८१-५७", "content_sanskrit": "ताराबहरणावत्स कलङ्कश्चन्द्रमण्डले ।\nमृगाकृतिर्विलग्नश्च भविष्यति युगे युगे ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003145057, "chapter_id": 23145, "verse_number": "४-८१-५८", "content_sanskrit": "शृणु वाक्यमिहाऽऽगच्छ तारके च पतिव्रते ।\nसत्यं ब्रूहि कस्य गर्भंत्यक्त्वा शुद्धाभव प्रिये ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003145058, "chapter_id": 23145, "verse_number": "४-८१-५९", "content_sanskrit": "अकामतो बलात्साध्वी न स्त्री जारेण दुष्यति ।\nकामतो नरकं याति यावच्चन्द्रदिवाकरौ ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003145059, "chapter_id": 23145, "verse_number": "४-८१-६०", "content_sanskrit": "उवाच तारा ब्रह्माणं गर्भं चन्द्रस्य सस्मितम् ।\nजहसुर्देवताः सर्वाः शंभुश्च मुनिसंघकाः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003145060, "chapter_id": 23145, "verse_number": "४-८१-६१", "content_sanskrit": "ददौ तारां च गुरवे लज्जिताय व्रजेश्वर ।\nबृहस्पतिर्ययौ गेहं गृहीत्वा च पतिव्रताम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003145061, "chapter_id": 23145, "verse_number": "४-८१-६२", "content_sanskrit": "तया प्रसूतं पुत्रं च सुन्दरं कनकप्रभम् ।\nगृहीत्वाप्रययौ चन्दौनमस्कृत्य विधिं शिवाम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003145062, "chapter_id": 23145, "verse_number": "४-८१-६३", "content_sanskrit": "ययुर्देवाश्च मुनयः शंभुश्च कमलोद्भवः ।\nप्रययौ स्वगृहं शुक्रौ दैत्ययुक्तौ मुदाऽन्वितः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003145063, "chapter_id": 23145, "verse_number": "४-८१-६४", "content_sanskrit": "एतत्ते कथितं नन्द ह्याख्यानं पुण्यदं शुभम् ।\nएतच्छ्रु त्वा तु निष्पापो निष्कलङ्की नरो भवेत् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003145064, "chapter_id": 23145, "verse_number": "४-८१-६५", "content_sanskrit": "धन्यं यशस्यमायुष्यं सर्वसंपत्करं परम् ।\nशोकापनोदनं हर्षकरं मर्वत्र मङ्गलम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003145065, "chapter_id": 23145, "verse_number": "४-८१-६६", "content_sanskrit": "त्यज शोकं सदा नन्द गृहं व्रज व्रजेश्वर ।\nब्रूहि सर्वं यशोदां च मत्प्रसूं गोपिकागणम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003145066, "chapter_id": 23145, "verse_number": "४-८१-६७", "content_sanskrit": "बोधयिष्यसि सर्वां तां स्त्रीजातिं शोकसंयुताम् ।\nसदीयज्ञानदत्तेन हर्षयुक्तः सदा भव ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}]