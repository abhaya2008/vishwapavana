[{"id": 2177956, "chapter_id": 4759, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2177957, "chapter_id": 4759, "verse_number": "१", "content_sanskrit": "सुभाषितैर्महाप्राज्ञ शोको मेऽपगतः प्रभो ।\nभूय एव तु वाक्यानि श्रोतुमिच्छामि तत्वतः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2177958, "chapter_id": 4759, "verse_number": "२", "content_sanskrit": "अनिष्टानां च संसर्गाद् इष्टानां च निवर्तनात् ।\nकथं वै मानसं दुःखं विप्रयुज्यन्ति पण्डिताः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2177959, "chapter_id": 4759, "verse_number": "", "content_sanskrit": "विदुरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2177960, "chapter_id": 4759, "verse_number": "३", "content_sanskrit": "यतो यतो मनो दुःखाद् सुखाद् वा विप्रमुच्यते ।\nततस्ततः शमं लब्ध्वा सुगतिं विन्दते बुधः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2177961, "chapter_id": 4759, "verse_number": "४", "content_sanskrit": "अशाश्वतमिदं सर्वं चिन्त्यमानं नरर्षभ ।\nकदळीसन्निभो लोकः सारो ह्यस्य न विद्यते\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2177962, "chapter_id": 4759, "verse_number": "५", "content_sanskrit": "यदा प्राज्ञाश्च मूढाश्च धनवन्तोऽथ निर्धनाः ।\nसर्वे पितृवनं प्राप्य स्वपन्ति विगतज्वराः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2177963, "chapter_id": 4759, "verse_number": "६", "content_sanskrit": "निर्मांसैरस्थिभूयिष्ठैर्गात्रैः स्नायुनिबन्धिभिः ।\nकिं विशेषं प्रपश्यन्ति तत्र तेषां परे जनाः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2177964, "chapter_id": 4759, "verse_number": "७", "content_sanskrit": "येन प्रत्यवगच्छेयुः कुलरूपविशेषणम् ।\nकस्मादन्योन्यमिच्छन्ति विप्रलब्धधियो नराः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2177965, "chapter_id": 4759, "verse_number": "८", "content_sanskrit": "गृहाण्येव हि मर्त्यानामाहुर्देहान् हि पण्डिताः ।\nकालेन विनियुज्यन्ते सत्यमेषां तु शोभनम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2177966, "chapter_id": 4759, "verse_number": "९", "content_sanskrit": "यथा जीर्णमजीर्णं वा वस्त्रं त्यक्त्वाऽथ पूरुषः ।\nअन्यद् रोचयते वस्त्रम् एवं देहः शरीरिणाम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2177967, "chapter_id": 4759, "verse_number": "१०", "content_sanskrit": "वैचित्रवीर्य सत्यं हि दुःखं वा यदि वा सुखम् ।\nप्राप्नुवन्ति हि भूतानि स्वकृतेनैव कर्मणा\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2177968, "chapter_id": 4759, "verse_number": "११", "content_sanskrit": "कर्मणा प्राप्यते स्वर्गः सुखं दुःखं च भारत ।\nततो वहति तं भारमवशः स्ववशोऽपि वा ।\nयथा च मृण्मयं भाण्डं चक्रारूढं विपद्यते\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2177969, "chapter_id": 4759, "verse_number": "१२", "content_sanskrit": "किञ्चित् प्रक्रियमाणं वा कृतमात्रमथापि वा ।\nभिन्नं वाऽप्यवरोप्यं वा अवतीर्णमथापि वा\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2177970, "chapter_id": 4759, "verse_number": "१३", "content_sanskrit": "आर्द्रं वाऽप्यथवा शुष्कं पच्यमानमथापि वा ।\nअवतार्यन्तमापाकाद् उद्धृतं वाऽपि भारत\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2177971, "chapter_id": 4759, "verse_number": "१४", "content_sanskrit": "अथवा परिभज्यन्ते एवं देहः शरीरिणाम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2177972, "chapter_id": 4759, "verse_number": "१५", "content_sanskrit": "गर्भस्थो वा प्रसूतो वाप्यथवा दशरात्रिकः ।\nअर्धमासगतो वाऽपि मासत्रयगतोऽपि वा\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2177973, "chapter_id": 4759, "verse_number": "१६", "content_sanskrit": "संवत्सरगतो वाऽपि द्विसंवत्सर एव वा ।\nयौवनस्थो विमध्यस्थो वृद्धो वाऽपि विपद्यते\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2177974, "chapter_id": 4759, "verse_number": "१७", "content_sanskrit": "प्राक्कर्मभिस्तु भूतानि विपद्यन्ते भवन्ति च ।\nएवं संवर्धिते लोके किमर्थमनुतप्यसे\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2177975, "chapter_id": 4759, "verse_number": "१८", "content_sanskrit": "यथा तु सलिले राजन् क्रीडार्थमनुसञ्चरन् ।\nउन्मज्जेच्च निमज्जेच्च चेष्टते हि नराधिप\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2177976, "chapter_id": 4759, "verse_number": "१९", "content_sanskrit": "एवं संसारगहनाद् उन्मज्जननिमज्जनात् ।\nकर्मयोगेन बध्यन्ते क्लिश्यन्ते स्वल्पबुद्धयः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2177977, "chapter_id": 4759, "verse_number": "२०", "content_sanskrit": "ये तु प्राज्ञाः स्थिता मध्ये संसारान्तर्गतैषिणः ।\nसमागमज्ञा भूतानां ते यान्ति परमां गतिम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2177978, "chapter_id": 4759, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां स्त्रीपर्वणि\nतृतीयोऽध्यायः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2177979, "chapter_id": 4759, "verse_number": "", "content_sanskrit": "जलप्रदानपर्वणि तृतीयोऽध्यायः ॥३॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]