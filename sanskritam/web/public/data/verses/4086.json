[{"id": 2143166, "chapter_id": 4086, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2143167, "chapter_id": 4086, "verse_number": "१", "content_sanskrit": "ततः शक्रः स्तूयमानो गन्धर्वाप्सरसां गणैः ।\nऐरावतं समारुह्य द्विपेन्द्रं लक्षणैर्युतम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2143168, "chapter_id": 4086, "verse_number": "२", "content_sanskrit": "पावकः सुमहातेजा महर्षिश्च बृहस्पतिः ।\nयमश्च वरुणश्चैव कुबेरश्च धनेश्वरः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2143169, "chapter_id": 4086, "verse_number": "३", "content_sanskrit": "सर्वैर्देवैः परिवृतः शक्रो वृत्रनिषूदनः ।\nगन्धर्वैरप्सरोभिश्च प्रयातस्त्रिदिवं प्रभुः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2143170, "chapter_id": 4086, "verse_number": "४", "content_sanskrit": "स समेत्य महेन्द्राण्या देवराजः शतक्रतुः ।\nमुदा परमया युक्तः पालयामास देवराट्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2143171, "chapter_id": 4086, "verse_number": "५", "content_sanskrit": "ततः स भगवांस्तत्र अङ्गिराः समदृश्यत ।\nअथर्ववेदमन्त्रैश्च देवेन्द्रं समपूजयत्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2143172, "chapter_id": 4086, "verse_number": "६", "content_sanskrit": "ततस्तु भगवानिन्द्रः प्रहृष्टः समपद्यत ।\nवरं च प्रददौ तस्मा अथर्वाङ्गिरसे तदा\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2143173, "chapter_id": 4086, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2143174, "chapter_id": 4086, "verse_number": "७", "content_sanskrit": "अथर्वाङ्गिरसो नाम वेदेऽस्मिन् वै भविष्यति ।\nउदाहरणमेतद्धि यज्ञभागं च लप्स्यसे\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2143175, "chapter_id": 4086, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2143176, "chapter_id": 4086, "verse_number": "८", "content_sanskrit": "एवं सम्पूज्य भगवान् अथर्वाङ्गिरसं तथा ।\nव्यसर्जयन् महाराज देवराजः शतक्रतुः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2143177, "chapter_id": 4086, "verse_number": "९", "content_sanskrit": "सम्पूज्य सर्वांस्त्रिदशान् ऋषींश्चापि तपोधनान् ।\nइन्द्रः प्रमुदितो राजन् धर्मेणापालयत् प्रजाः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2143178, "chapter_id": 4086, "verse_number": "१०", "content_sanskrit": "एवं दुःखमनुप्राप्तमिन्द्रेण सह भार्यया ।\nअज्ञातवासश्च कृतः शत्रूणां वधकाङ्क्षया\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2143179, "chapter_id": 4086, "verse_number": "११", "content_sanskrit": "नात्र मन्युस्त्वया कार्यो यत् क्लिष्टोऽसि महावने ।\nद्रौपद्या सह राजेन्द्र भ्रातृभिश्च महात्मभिः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2143180, "chapter_id": 4086, "verse_number": "१२", "content_sanskrit": "एवं त्वमपि राजेन्द्र राज्यं प्राप्स्यसि भारत ।\nवृत्रं हत्वा यथा प्राप्तः शक्रः कौरवनन्दन\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2143181, "chapter_id": 4086, "verse_number": "१३", "content_sanskrit": "दुराचारश्च नहुषो ब्रह्मद्विट् पापचेतनः ।\nअगस्त्यशापाभिहतो विनष्टः शाश्वतीः समाः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2143182, "chapter_id": 4086, "verse_number": "१४", "content_sanskrit": "एवं तव दुरात्मानः शत्रवः शत्रुसूदन ।\nक्षिप्रं नाशं गमिष्यन्ति कर्णदुर्योधनादयः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2143183, "chapter_id": 4086, "verse_number": "१५", "content_sanskrit": "ततः सागरपर्यन्तां भोक्ष्यसे पृथिवीमिमाम् ।\nभ्रातृभिः सहितो वीर द्रौपद्या च सहानया\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2143184, "chapter_id": 4086, "verse_number": "१६", "content_sanskrit": "उपाख्यानमिदं शक्रविजयं वेदसम्मितम् ।\nराज्ञा व्यूढेष्वनीकेषु श्रोतव्यं जयमिच्छता\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2143185, "chapter_id": 4086, "verse_number": "१७", "content_sanskrit": "तस्मात् संश्रावयामि त्वां विजयं जयतां वर ।\nसंस्तूयमाना वर्धन्ते महात्मानो युधिष्ठिर\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2143186, "chapter_id": 4086, "verse_number": "१८", "content_sanskrit": "क्षत्रियाणामभावोऽयं युधिष्ठिर महात्मनाम् ।\nदुर्योधनापराधेन भीमार्जुनबलेन च\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2143187, "chapter_id": 4086, "verse_number": "१९", "content_sanskrit": "आख्यानमिन्द्रविजयं य इदं नियतः पठेत् ।\nधूतपाप्मा जितस्वर्गः परत्रेह च मोदते\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2143188, "chapter_id": 4086, "verse_number": "२०", "content_sanskrit": "न चारिजं भयं तस्य नापुत्रो वा भवेन्नरः ।\nनापदं प्राप्नुयात् काञ्चिद् दीर्घमायुश्च विन्दति\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2143189, "chapter_id": 4086, "verse_number": "२१", "content_sanskrit": "सर्वत्र जयमाप्नोति न कदाचित् पराजयम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2143190, "chapter_id": 4086, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2143191, "chapter_id": 4086, "verse_number": "२२", "content_sanskrit": "एवमाश्वासितो राजा शल्येन भरतर्षभ ।\nपूजयामास विधिवत् शल्यं धर्मभृतां वरः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2143192, "chapter_id": 4086, "verse_number": "२३", "content_sanskrit": "श्रुत्वा तु शल्यवचनं कुन्तीपुत्रो युधिष्ठिरः ।\nप्रत्युवाच महाबाहुर्मद्रराजमिदं वचः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2143193, "chapter_id": 4086, "verse_number": "२४", "content_sanskrit": "भवान् कर्णस्य सारथ्यं करिष्यति न संशयः ।\nतत्र तेजोवधः कार्यः कर्णस्यार्जुनसंस्तवे\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2143194, "chapter_id": 4086, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2143195, "chapter_id": 4086, "verse_number": "२५", "content_sanskrit": "एवमेतत् करिष्यामि यथा मां सम्प्रभाषसे ।\nयच्चान्यदपि शक्ष्यामि तत् करिष्याम्यहं तव\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2143196, "chapter_id": 4086, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2143197, "chapter_id": 4086, "verse_number": "२६", "content_sanskrit": "ततस्त्वामन्त्र्य कौन्तेयान् शल्यो मद्राधिपस्तदा ।\nजगाम सबलः श्रीमान् दुर्योधनमरिन्दमः \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2143198, "chapter_id": 4086, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि अष्टादशोऽध्यायः ॥१८॥ सेनोद्योगपर्वणि अष्टादशोऽध्यायः ॥१८॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]