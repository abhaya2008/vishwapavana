[{"id": 7001320000, "chapter_id": 21320, "verse_number": "४-१०-१", "content_sanskrit": "सूत उवाच ।\nश्रीमतीक्ष्वाकुवंशे हि राजा परमधार्मिकः ।\nआसीन्मित्रसहो नाम श्रेष्ठस्सर्वधनुष्मताम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001320001, "chapter_id": 21320, "verse_number": "४-१०-२", "content_sanskrit": "तस्य राज्ञः सुधर्मिष्ठा मदयन्ती प्रिया शुभा ।\nदमयन्ती नलस्येव बभूव विदिता सती॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001320002, "chapter_id": 21320, "verse_number": "४-१०-३", "content_sanskrit": "स एकदा हि मृगयास्नेही मित्रसहो नृपः ।\nमहद्बलेन संयुक्तो जगाम गहनं वनम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001320003, "chapter_id": 21320, "verse_number": "४-१०-४", "content_sanskrit": "विहरंस्तत्र स नृपः कमठाह्वं निशाचरम् ।\nनिजघान महादुष्टं साधुपीडाकरं खलम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001320004, "chapter_id": 21320, "verse_number": "४-१०-५", "content_sanskrit": "अथ तस्यानुजः पापी जयेयं छद्मनैव तम् ।\nमत्वा जगाम नृपतेरन्तिक च्छद्मकारकः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001320005, "chapter_id": 21320, "verse_number": "४-१०-६", "content_sanskrit": "तं विनम्राकृतिं दृष्ट्वा भृत्यतां कर्तुमागतम् ।\nचक्रे महानसाध्यक्षमज्ञानात्स महीपतिः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001320006, "chapter_id": 21320, "verse_number": "४-१०-७", "content_sanskrit": "अथ तस्मिन्वने राजा कियत्कालं विहृत्य सः ।\nनिवृत्तो मृगयां हित्वा स्वपुरीमाययौ मुदा॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001320007, "chapter_id": 21320, "verse_number": "४-१०-८", "content_sanskrit": "पितुः क्षयाहे सम्प्राप्ते निमंत्र्य स्वगुरुं नृपः ।\nवसिष्ठं गृहमानिन्ये भोजयामास भक्तितः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001320008, "chapter_id": 21320, "verse_number": "४-१०-९", "content_sanskrit": "रक्षसा सूदरूपेण संमिश्रितनरामिषम् ।\nशाकामिषं पुरः क्षिप्तं दृष्ट्वा गुरुरथाब्रवीत्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001320009, "chapter_id": 21320, "verse_number": "४-१०-१०", "content_sanskrit": "गुरुरुवाच ।\nधिक् त्वां नरामिषं राजंस्त्वयैतच्छद्मकारिणा ।\nखलेनोपहृतं मह्यं ततो रक्षो भविष्यसि॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001320010, "chapter_id": 21320, "verse_number": "४-१०-११", "content_sanskrit": "रक्षःकृतं च विज्ञाय तदैवं स गुरुस्तदा ।\nपुनर्विमृश्य तं शापं चकार द्वादशाब्दिकम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001320011, "chapter_id": 21320, "verse_number": "४-१०-१२", "content_sanskrit": "स राजानुचितं शापं विज्ञाय क्रोधमूर्छितः ।\nजलांजलिं समादाय गुरुं शप्तुं समुद्यतः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001320012, "chapter_id": 21320, "verse_number": "४-१०-१३", "content_sanskrit": "तदा च तत्प्रिया साध्वी मदयन्ती सुधर्मिणी ।\nपतित्वा पादयोस्तस्य शापं तं हि न्यवारयत्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001320013, "chapter_id": 21320, "verse_number": "४-१०-१४", "content_sanskrit": "ततो निवृत्तशापस्तु तस्या वचनगौरवात् ।\nतत्याज पादयोरंभः पादौ कल्मषतां गतौ॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001320014, "chapter_id": 21320, "verse_number": "४-१०-१५", "content_sanskrit": "ततःप्रभृति राजाभूत्स लोकेस्मिन्मुनीश्वराः ।\nकल्मषांघ्रिरिति ख्यातः प्रभावात्तज्जलस्य हि॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001320015, "chapter_id": 21320, "verse_number": "४-१०-१६", "content_sanskrit": "राजा मित्रसहः शापाद्गुरो ऋषिवरस्य हि ।\nबभूव राक्षसो घोरो हिंसको वनगोचरः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001320016, "chapter_id": 21320, "verse_number": "४-१०-१७", "content_sanskrit": "स बिभ्रद्राक्षसं रूपं कालान्तकयमोपमम् ।\nचखाद विविधाञ्जंतून्मानुषादीन्वनेचरः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001320017, "chapter_id": 21320, "verse_number": "४-१०-१८", "content_sanskrit": "स कदाचिद्वने क्वापि रममाणौ किशोरकौ ।\nअपश्यदन्तकाकारो नवोढौ मुनिदम्पती॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001320018, "chapter_id": 21320, "verse_number": "४-१०-१९", "content_sanskrit": "राक्षसः स नराहारः किशोरं मुनिनन्दनम् ।\nजग्धुं जग्राह शापार्त्तो व्याघ्रो मृगशिशुं यथा॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001320019, "chapter_id": 21320, "verse_number": "४-१०-२०", "content_sanskrit": "कुक्षौ गृहीतं भर्तारं दृष्ट्वा भीता च तत्प्रिया ।\nसा चक्रे प्रार्थनं तस्मै वदंती करुणं वचः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001320020, "chapter_id": 21320, "verse_number": "४-१०-२१", "content_sanskrit": "प्रार्थ्यमानोऽपि बहुशः पुरुषादः स निर्घृणः ।\nचखाद शिर उत्कृत्य विप्रसूनोर्दुराशयः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001320021, "chapter_id": 21320, "verse_number": "४-१०-२२", "content_sanskrit": "अथ साध्वी च सा दीना विलप्य भृशदुःखिता ।\nआहृत्य भर्तुरस्थीनि चितां चक्रे किलोल्बणाम्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001320022, "chapter_id": 21320, "verse_number": "४-१०-२३", "content_sanskrit": "भर्तारमनुगच्छन्ती संविशंती हुताशनम् ।\nराजानं राक्षसाकारं सा शशाप द्विजाङ्गना॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001320023, "chapter_id": 21320, "verse_number": "४-१०-२४", "content_sanskrit": "अद्यप्रभृति नारीषु यदा त्वं संगतो भवेः ।\nतदा मृतिस्तवेत्युक्त्वा विवेश ज्वलनं सती॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001320024, "chapter_id": 21320, "verse_number": "४-१०-२५", "content_sanskrit": "सोपि राजा गुरोश्शापमनुभूय कृतावधिम् ।\nपुनः स्वरूपमास्थाय स्वगृहं मुदितो ययौ॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001320025, "chapter_id": 21320, "verse_number": "४-१०-२६", "content_sanskrit": "ज्ञात्वा विप्रसतीशापं मदयन्ती रतिप्रियम् ।\nपतिं निवारयामास वैधव्यादतिबिभ्यती॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001320026, "chapter_id": 21320, "verse_number": "४-१०-२७", "content_sanskrit": "अनपत्यो विनिर्विण्णो राज्यभोगेषु पार्थिवः ।\nविसृज्य सकलां लक्ष्मीं वनमेव जगाम ह॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001320027, "chapter_id": 21320, "verse_number": "४-१०-२८", "content_sanskrit": "स्वपृष्ठतः समायान्तीं ब्रह्महत्यां सुदुःखदाम् ।\nददर्श विकटाकारां तर्जयन्ती मुहुर्मुहुः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001320028, "chapter_id": 21320, "verse_number": "४-१०-२९", "content_sanskrit": "तस्या निर्भद्रमन्विच्छन् राजा निर्विण्णमानसः ।\nचकार नानोपायान्स जपव्रतमखादिकान्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001320029, "chapter_id": 21320, "verse_number": "४-१०-३०", "content_sanskrit": "नानोपायैर्यदा राज्ञस्तीर्थस्नानादिभिर्द्विजाः ।\nन निवृत्ता ब्रह्महत्या मिथिलां स ययौ तदा॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001320030, "chapter_id": 21320, "verse_number": "४-१०-३१", "content_sanskrit": "बाह्योद्यानगतस्तस्याश्चितया परयार्दितः ।\nददर्श मुनिमायान्तं गौतमं पार्थिवश्च सः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001320031, "chapter_id": 21320, "verse_number": "४-१०-३२", "content_sanskrit": "अभिसृत्य स राजेन्द्रो गौतमं विमलाशयम् ।\nतद्दर्शनाप्तकिंचित्कः प्रणनाम मुहुर्मुहुः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001320032, "chapter_id": 21320, "verse_number": "४-१०-३३", "content_sanskrit": "अथ तत्पृष्टकुशलो दीर्घमुष्णं च निश्वसन् ।\nतत्कृपादृष्टिसंप्राप्तसुख प्रोवाच तं नृपः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001320033, "chapter_id": 21320, "verse_number": "४-१०-३४", "content_sanskrit": "राजोवाच ।\nमुने मां बाधते ह्येषा ब्रह्महत्या दुरत्यया ।\nअलक्षिता परैस्तात तर्जयंती पदेपदे॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001320034, "chapter_id": 21320, "verse_number": "४-१०-३५", "content_sanskrit": "यन्मया शापदग्धेन विप्रपुत्रश्च भक्षितः ।\nतत्पापस्य न शान्तिर्हि प्रायश्चित्तसहस्रकैः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001320035, "chapter_id": 21320, "verse_number": "४-१०-३६", "content_sanskrit": "नानोपायाः कृता मे हि तच्छान्त्यै भ्रमता मुने ।\nन निवृत्ता ब्रह्महत्या मम पापात्मनः किमु॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001320036, "chapter_id": 21320, "verse_number": "४-१०-३७", "content_sanskrit": "अद्य मे जन्मसाफल्यं संप्राप्तमिव लक्षये ।\nयतस्त्वद्दर्शनादेव ममानन्दभरोऽभवत्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001320037, "chapter_id": 21320, "verse_number": "४-१०-३८", "content_sanskrit": "अद्य मे तवपादाब्ज शरणस्य कृतैनसः ।\nशांतिं कुरु महाभाग येनाहं सुखमाप्नुयाम्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001320038, "chapter_id": 21320, "verse_number": "४-१०-३९", "content_sanskrit": "सूत उवाच ।\nइति राज्ञा समादिष्टो गौतमः करुणार्द्रधीः ।\nसमादिदेश घोराणामघानां साधु निष्कृतिम्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001320039, "chapter_id": 21320, "verse_number": "४-१०-४०", "content_sanskrit": "गौतम उवाच ।\nसाधु राजेन्द्र धन्योसि महाघेभ्यो भयन्त्यज ।\nशिवे शास्तरि भक्तानां क्व भयं शरणैषिणाम्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001320040, "chapter_id": 21320, "verse_number": "४-१०-४१", "content_sanskrit": "शृणु राजन्महाभाग क्षेत्रमन्यत्प्रतिष्ठितम् ।\nमहापातकसंहारि गोकर्णाख्यं शिवालयम्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001320041, "chapter_id": 21320, "verse_number": "४-१०-४२", "content_sanskrit": "तत्र स्थितिर्न पापानां महद्भ्यो महतामपि ।\nमहाबलाभिधानेन शिवः संनिहितः स्वयम्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001320042, "chapter_id": 21320, "verse_number": "४-१०-४३", "content_sanskrit": "सर्वेषां शिवलिंगानां सार्वभौमो महाबलः ।\nचतुर्युगे चतुर्वर्णस्सर्वपापापहारकः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001320043, "chapter_id": 21320, "verse_number": "४-१०-४४", "content_sanskrit": "पश्चिमाम्बुधितीरस्थं गोकर्णं तीर्थमुत्तमम् ।\nतत्रास्ति शिवलिंगं तन्महापातकनाशकम्॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001320044, "chapter_id": 21320, "verse_number": "४-१०-४५", "content_sanskrit": "तत्र गत्वा महापापाः स्नात्वा तीर्थेषु भूरिशः ।\nमहाबलं च संपूज्य प्रयाताश्शांकरम्पदम्॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001320045, "chapter_id": 21320, "verse_number": "४-१०-४६", "content_sanskrit": "तथा त्वमपि राजेन्द्र गोकर्ण गिरिशालयम् ।\nगत्वा सम्पूज्य तल्लिंगं कृतकृत्यत्वमाप्नुयाः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001320046, "chapter_id": 21320, "verse_number": "४-१०-४७", "content_sanskrit": "तत्र सर्वेषु तीर्थेषु स्नात्वाभ्यर्च्य महाबलम् ।\nसर्वपापविनिर्मुक्तः शिवलोकन्त्वमाप्नुयाः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001320047, "chapter_id": 21320, "verse_number": "४-१०-४८", "content_sanskrit": "सूत उवाच ।\nइत्यादिष्टः स मुनिना गौतमेन महात्मना ।\nमहाहृष्टमना राजा गोकर्णं प्रत्यपद्यत॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001320048, "chapter_id": 21320, "verse_number": "४-१०-४९", "content_sanskrit": "तत्र तीर्थेषु सुस्नात्वा समभ्यर्च्य महाबलम् ।\nनिर्धूताशेषपापौघोऽलभच्छंभोः परम्पदम्॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001320049, "chapter_id": 21320, "verse_number": "४-१०-५०", "content_sanskrit": "य इमां शृणुयान्नित्यं महाबलकथां प्रियाम् ।\nत्रिसप्तकुलजैस्सार्द्धं शिवलोके व्रजत्यसौ॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]