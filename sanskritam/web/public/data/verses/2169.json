[{"id": 2052952, "chapter_id": 2169, "verse_number": "७-९६-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2052953, "chapter_id": 2169, "verse_number": "७-९६-१", "content_sanskrit": "राजन्सङ्ग्राममाश्चर्यं शृणु कीर्तयतो मम।\nकुरूणां पाण्डवानां च यथा युद्धमवर्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2052954, "chapter_id": 2169, "verse_number": "७-९६-२", "content_sanskrit": "भारद्वाजं समासाद्य व्यूहस्य प्रमुखे स्थितम्।\nअयोधयन्रणे पार्था द्रोणानीकं बिभित्सवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2052955, "chapter_id": 2169, "verse_number": "७-९६-३", "content_sanskrit": "रक्षमाणः स्वथं व्यूहं द्रोणोऽपि सह सैनिकैः।\nअयोधयद्रणे पार्थान्प्रार्थयानो महद्यशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2052956, "chapter_id": 2169, "verse_number": "७-९६-४", "content_sanskrit": "विन्दानुविन्दावावन्त्यौ विराटं दशभिः शरैः।\nअयोधयद्रणे पार्थान्प्रार्थयानो महद्यशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2052957, "chapter_id": 2169, "verse_number": "७-९६-५", "content_sanskrit": "विन्दानुविन्दावावन्त्यौ विराटं दशभिः शरैः।\nपराक्रान्तौ पराक्रम्य योधयामास सानुगौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2052958, "chapter_id": 2169, "verse_number": "७-९६-६", "content_sanskrit": "तेषां युद्धं समभवद्दारुणं शोणितोदकम्।\nसिंहस्य द्विपमुख्याभ्यां प्रभिन्नाभ्यां यथा वने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2052959, "chapter_id": 2169, "verse_number": "७-९६-७", "content_sanskrit": "बाह्लीकं रभसं युद्धे याज्ञसेनिर्महाबलः।\nआजघ्ने विशिखैस्तीक्ष्णैर्घोरैर्मर्मास्थिभेदिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2052960, "chapter_id": 2169, "verse_number": "७-९६-८", "content_sanskrit": "बाह्लीको याज्ञसेनिं तु हेमपुङ्खैः शिलाशितैः।\nआजघान भृशं क्रुद्धो नवभिर्नतपर्वभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2052961, "chapter_id": 2169, "verse_number": "७-९६-९", "content_sanskrit": "तद्युद्धमभवद्धोरं शरशक्तिसमाकुलम्।\nभीरूणां त्रासजननं शूराणां हर्षवर्धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2052962, "chapter_id": 2169, "verse_number": "७-९६-१०", "content_sanskrit": "ताभ्यां तत्र शरैर्मुक्तैरन्तरिक्षं दिशस्तथा।\nअभवत्संवृतं सर्वं न प्राज्ञायत किञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2052963, "chapter_id": 2169, "verse_number": "७-९६-११", "content_sanskrit": "शैब्यो गोवासनो युद्धे काश्यपुत्रं महारथम्।\nससैन्यो योधयामास गजः प्रतिगजं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2052964, "chapter_id": 2169, "verse_number": "७-९६-१२", "content_sanskrit": "बाह्लीकराजः सङ्क्रुद्धो द्रौपदेयान्महारथान्।\nमनः पञ्चेन्द्रियाणीव शुशुभे योधयन्रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2052965, "chapter_id": 2169, "verse_number": "७-९६-१३", "content_sanskrit": "अयोधयंस्ते सुभृशं तं शरौघैः समन्ततः।\nइन्द्रियाणि यथा देहं शश्वद्देहवतां वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2052966, "chapter_id": 2169, "verse_number": "७-९६-१४", "content_sanskrit": "वार्ष्णेयं सात्यकिं युद्धे पुत्रो दुःशासनस्तव।\nआजघ्ने सायकैस्तीक्ष्णैर्नवभिर्नतपर्वभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2052967, "chapter_id": 2169, "verse_number": "७-९६-१५", "content_sanskrit": "सोऽतिविद्धो बलवता महेष्वासेन धन्विना।\nईषन्मूर्च्छां जगामाशु सात्यकिः सत्यविक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2052968, "chapter_id": 2169, "verse_number": "७-९६-१६", "content_sanskrit": "समाश्वस्तस्तु वार्ष्णेयस्तव पुत्रं महारथम्।\nविव्याध दशभिस्तूर्णं सायकैः कङ्कपत्रिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2052969, "chapter_id": 2169, "verse_number": "७-९६-१७", "content_sanskrit": "तावन्योन्यं दृढं विद्धावन्योन्यशरपीडितौ।\nरजेतुः समरे राजन्पुष्पिताविव किंशुकौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2052970, "chapter_id": 2169, "verse_number": "७-९६-१८", "content_sanskrit": "अलम्बुसस्तु सङ्क्रुद्धः कृन्तिभोजशरार्दितः।\nअशोभत भृशं लक्ष्म्या पुष्पाढ्य इव किंशुकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2052971, "chapter_id": 2169, "verse_number": "७-९६-१९", "content_sanskrit": "कुन्तिभोजं ततो रक्षो विद्ध्वा बहुभिरायसैः।\nअनदद्भैरवं नादं वाहिन्याः प्रमुखे तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2052972, "chapter_id": 2169, "verse_number": "७-९६-२०", "content_sanskrit": "ततस्तौ समरे शूरौ योधयन्तौ परस्परम्।\nददृशुः सर्वसैन्यानि शक्रजम्भौ यथा पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2052973, "chapter_id": 2169, "verse_number": "७-९६-२१", "content_sanskrit": "शकुनिं रभसं युद्धे कृतवैरं च भारत।\nमाद्रीपुत्रौ च संरब्धौ शरैश्चार्दयतां भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2052974, "chapter_id": 2169, "verse_number": "७-९६-२२", "content_sanskrit": "तुमुलः स महान्राजन्प्रावर्तत जनक्षयः।\nत्वया सञ्जनितोऽत्यर्थं कर्णेन च विवर्धितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2052975, "chapter_id": 2169, "verse_number": "७-९६-२३", "content_sanskrit": "रक्षितस्तव पुत्रैश्च क्रोधमूलो हुताशनः।\nय इमां पृथिवीं राजन्दग्धुं सर्वां समुद्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2052976, "chapter_id": 2169, "verse_number": "७-९६-२४", "content_sanskrit": "शकुनिः पाण्डुपुत्राभ्यां कृतः स विमुखः शरैः।\nन स्म जानाति कर्तव्यं युद्धे किञ्चित्पराक्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2052977, "chapter_id": 2169, "verse_number": "७-९६-२५", "content_sanskrit": "विमुखं चैनमालोक्य माद्रीपुत्रौ महारथौ।\nववर्षतुः पुनर्बाणैर्यथा मेघौ महागिरिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2052978, "chapter_id": 2169, "verse_number": "७-९६-२६", "content_sanskrit": "स वध्यमानो बहुभिः शरैः सन्नतपर्वभिः।\nसम्प्रायाज्जवनैरश्वैर्द्रोणानीकाय सौबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2052979, "chapter_id": 2169, "verse_number": "७-९६-२७", "content_sanskrit": "घटोत्कचस्तथा शूरं राक्षसं तमलामुधम्।\nअभ्ययाद्रभसं युद्धे वेगमास्थाय मध्यमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2052980, "chapter_id": 2169, "verse_number": "७-९६-२८", "content_sanskrit": "तयोर्युद्धं महाराज चित्ररूपमिवाभवत्।\nयादृशं हि पुरावृत्तं रामरावणयोर्मृधे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2052981, "chapter_id": 2169, "verse_number": "७-९६-२९", "content_sanskrit": "ततो युधिष्ठिरो राजा मद्रराजानमाहवे।\nविद्ध्वा पञ्चाशता बाणैः पुनर्विव्याध सप्तभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2052982, "chapter_id": 2169, "verse_number": "७-९६-३०", "content_sanskrit": "ततः प्रववृते युद्धं तयोरत्यद्भुतं नृप।\nयथा पूर्वं महद्युद्धं शम्बरामरराजयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2052983, "chapter_id": 2169, "verse_number": "७-९६-३१", "content_sanskrit": "विविंशतिश्चित्रसेनो विकर्णश्च तवात्मजः।\nअयोधयन्भीमसेनं महत्या सेनया वृताः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2052984, "chapter_id": 2169, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि जयद्रथवधपर्वणि चतुर्दशदिवसयुद्धे षण्णवतितमोऽध्यायः॥ ९६ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-९६-२३ हुताशनः प्रावर्ततेत्यनुषज्यते॥ ५-९६-९६ षण्णवतितमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]