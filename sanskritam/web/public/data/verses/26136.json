[{"id": 7006136000, "chapter_id": 26136, "verse_number": "१-१-२-१", "content_sanskrit": "प्रत्यवोचन्पुनः सूतमृषयस्ते तपोधनाः ।\nकुत्र सत्रं समभत्तेवषामद्भुतकर्मणाम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006136001, "chapter_id": 26136, "verse_number": "१-१-२-२", "content_sanskrit": "कियन्तं चैव तत्कालं कथं च समवर्त्तत ।\nआचचक्षे पुराणं च कथं तत्सप्रभञ्जनः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006136002, "chapter_id": 26136, "verse_number": "१-१-२-३", "content_sanskrit": "आचख्यौ विस्तरेणैव पर कौतूहलं हि नः ।\nइति संचोदितः सूतः प्रत्युवाच शुभं वचः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006136003, "chapter_id": 26136, "verse_number": "१-१-२-४", "content_sanskrit": "शृणुध्वं यत्र ते धीरा मेनिरे मन्त्रमुत्तमम् ।\nयावन्तं चाभवत्कालं यथा च समवर्तत ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006136004, "chapter_id": 26136, "verse_number": "१-१-२-५", "content_sanskrit": "सिसृक्षमाणो विश्वं हि यजते विसृजत्पुरा ।\nसत्रं हि तेऽतिपुण्यं च सहस्रपरिवत्सरान् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006136005, "chapter_id": 26136, "verse_number": "१-१-२-६", "content_sanskrit": "तपोगृहपतेर्यत्र ब्रह्मा चैवाभवत्स्वयम् ।\nइडाया यत्र पत्नीत्वं शामित्रं यत्र बुद्धिमान् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006136006, "chapter_id": 26136, "verse_number": "१-१-२-७", "content_sanskrit": "मृत्युश्चके महातेजास्तस्मिन्सत्रे महात्मनाम् ।\nविबुधाश्चोषिरे तत्र सहस्रपरिवत्सरान् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006136007, "chapter_id": 26136, "verse_number": "१-१-२-८", "content_sanskrit": "भ्रमतो धर्मचक्रस्य यत्र नेमिरशीर्यत ।\nकर्मणा तेन विख्यातं नैमिषं मुनिपूजितम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006136008, "chapter_id": 26136, "verse_number": "१-१-२-९", "content_sanskrit": "यत्र सा गोमती पुण्या सिद्धचारणसेविता ।\nरोहिणी स सुता तत्र गोमती साभवत्क्षणात् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006136009, "chapter_id": 26136, "verse_number": "१-१-२-१०", "content_sanskrit": "शक्तिर्ज्येष्ठा समभवद्वसिष्ठस्य महात्मनः ।\nरुन्धत्याः सुतायात्रादानमुत्तमतेजसः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006136010, "chapter_id": 26136, "verse_number": "१-१-२-११", "content_sanskrit": "कल्माषपादो नृपतिर्यत्र शक्रश्च शक्तिना ।\nयत्र वैरं समभवद्विश्वामित्रवसिष्ठयोः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006136011, "chapter_id": 26136, "verse_number": "१-१-२-१२", "content_sanskrit": "अदृश्यन्त्यां समभवन्मुनिर्यत्र पराशरः ।\nपराभवो वसिष्ठस्य यस्य ज्ञाने ह्यवर्त्तयत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006136012, "chapter_id": 26136, "verse_number": "१-१-२-१३", "content_sanskrit": "तत्र ते मेनिरे शैलं नैमिषे ब्रह्मवादिनः ।\nनैमिषं जज्ञिरे यस्मान्नैमिषीयास्ततः स्मृताः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006136013, "chapter_id": 26136, "verse_number": "१-१-२-१४", "content_sanskrit": "तत्सत्रमभवत्तेषां समा द्वादश धीमताम् ।\nपुरूरवसि विक्रान्ते प्रशासति वसुंधराम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006136014, "chapter_id": 26136, "verse_number": "१-१-२-१५", "content_sanskrit": "अष्टादश समुद्रस्य द्वीपानश्रन् पुरूरवाः ।\nतुतोष नैव रत्नानां लोभादिति हि नः श्रुतम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006136015, "chapter_id": 26136, "verse_number": "१-१-२-१६", "content_sanskrit": "उर्वशी चकमे तं च देवदूतप्रचोदिता ।\nआजहार च तत्सत्रमुर्वश्या सह संगतः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006136016, "chapter_id": 26136, "verse_number": "१-१-२-१७", "content_sanskrit": "तस्मिन्नरपतौ सत्रे नैमिषीयाः प्रचक्रिरे ।\nयं गर्भं सुषुवे गङ्गा पावकाद्दीप्ततेजसम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006136017, "chapter_id": 26136, "verse_number": "१-१-२-१८", "content_sanskrit": "तत्तुल्यं पर्वते न्यस्तं हिरण्यं समपद्यत ।\nहिरण्मयं ततश्चके यज्ञवाटं महात्मनाम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006136018, "chapter_id": 26136, "verse_number": "१-१-२-१९", "content_sanskrit": "विश्वकर्मा स्वयन्देवो भावनो लोकभावनः ।\nस प्रविश्य ततः सत्रे तेषाममिततेजसाम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006136019, "chapter_id": 26136, "verse_number": "१-१-२-२०", "content_sanskrit": "ऐडः पुरूरवा भेजे तं देशं मृगयां चरन् ।\nतं दृष्ट्वा महादाश्वर्यं यज्ञवाटं हिरण्मयम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006136020, "chapter_id": 26136, "verse_number": "१-१-२-२१", "content_sanskrit": "लोभेन हतविज्ञानस्तदादातुमुपाक्रमत् ।\nनैमिषेयास्ततस्तस्य चुक्रुधुर्नृपतिं भृशम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006136021, "chapter_id": 26136, "verse_number": "१-१-२-२२", "content_sanskrit": "निजघ्नुश्चापि तं क्रुद्धाः कुशवज्रैर्मनीषिणः ।\nतपोनिष्ठाश्च राजानं मुनयो देवचोदिताः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006136022, "chapter_id": 26136, "verse_number": "१-१-२-२३", "content_sanskrit": "कुशवज्रौर्विनिष्पिष्टः स राजा व्यजहात्तनुम् ।\nऔर्वशेयैस्ततस्तस्य युद्धं चक्रे नृपो भुवि ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006136023, "chapter_id": 26136, "verse_number": "१-१-२-२४", "content_sanskrit": "नहुषस्य महात्मानं पितरं यं प्रचक्षते ।\nस तेष्ववभृथेष्वेव धर्म्मशीलो महीपतिः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006136024, "chapter_id": 26136, "verse_number": "१-१-२-२५", "content_sanskrit": "आयुरायभवायाग्र्यमस्मिन् सत्रे नरोत्तमः ।\nशान्तयित्वा तु राजानं तदा ब्रह्मविदस्तथा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006136025, "chapter_id": 26136, "verse_number": "१-१-२-२६", "content_sanskrit": "सत्रमारेभिरे कर्त्तुं पृथ्वीवत्सा त्ममूर्तयः ।\nबभूव सत्रे तेषां तु ब्रह्मचर्यं महात्मनाम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006136026, "chapter_id": 26136, "verse_number": "१-१-२-२७", "content_sanskrit": "विश्वं सिसृक्षमाणानां पुरा विस्वसृजामिव ।\nवैखानसैः प्रियसखैर्वाल खिल्यैर्मरीचिभिः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006136027, "chapter_id": 26136, "verse_number": "१-१-२-२८", "content_sanskrit": "अजैश्च मुनिभिर्जातं सूर्यवैश्वानरप्रभः ।\nवितृदेवाप्सरःसिद्धैर्गन्धर्वोरगचारणैः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006136028, "chapter_id": 26136, "verse_number": "१-१-२-२९", "content_sanskrit": "भारतैः शुशुभे राजा देवैरिन्द्रसमो यथा ।\nस्तोत्रशस्त्रैर्गृहैर्देवान्पितॄन्पित्र्यैश्च कर्मभिः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006136029, "chapter_id": 26136, "verse_number": "१-१-२-३०", "content_sanskrit": "आनर्चुःस्म यथाजाति गन्धर्वादीन् यथाविधि ।\nआराधने स सस्मार ततः कर्मान्तरेषु च ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006136030, "chapter_id": 26136, "verse_number": "१-१-२-३१", "content_sanskrit": "जगुः सामानि गन्धर्वा ननृतुश्चाप्सरोगणाः ।\nव्याजह्रुर्मुनयो वाचं चित्राक्षरपदां शुभाम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006136031, "chapter_id": 26136, "verse_number": "१-१-२-३२", "content_sanskrit": "मन्त्रादि तत्र विद्वांसो जजपुश्च परस्परम् ।\nवितण्डावचनैश्चैव निजघ्नुः प्रतिवादिनः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006136032, "chapter_id": 26136, "verse_number": "१-१-२-३३", "content_sanskrit": "ऋषयश्चैव विद्वांसः शब्दार्थन्यायकोविदाः ।\nन तत्र हारितं किञ्चिद्विविशुर्ब्रह्मराक्षसाः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006136033, "chapter_id": 26136, "verse_number": "१-१-२-३४", "content_sanskrit": "नैव यज्ञहरा दैत्या नैव वाजमुखास्त्रिणः ।\nप्रायश्चित्तं दरिद्रं च न तत्र समजायत ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006136034, "chapter_id": 26136, "verse_number": "१-१-२-३५", "content_sanskrit": "शक्तिप्रज्ञाक्रियायेगैर्विधिराशीष्वनुष्टितः ।\nएवं च ववृधे सत्रं द्वादशाब्दं मनीषिणाम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006136035, "chapter_id": 26136, "verse_number": "१-१-२-३६", "content_sanskrit": "ऋषीणां नैमिषीयाणां तदभूदिव वज्रिणः ।\nवृद्धाद्या ऋत्विजो वीरा ज्योतिष्टोमान् पृथक्पृथक् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006136036, "chapter_id": 26136, "verse_number": "१-१-२-३७", "content_sanskrit": "चक्रिरे पृष्ठगमनाः सर्वानयुतदक्षिणान् ।\nसमाप्तयज्ञो यत्रास्ते वासुदेवं महाधिपम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006136037, "chapter_id": 26136, "verse_number": "१-१-२-३८", "content_sanskrit": "पप्रच्छुरमितात्मानं भवद्भिर्यदहं द्विजः ।\nप्रचोदितः स्ववंशार्थं स च तानब्रवीत्प्रभुः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006136038, "chapter_id": 26136, "verse_number": "१-१-२-३९", "content_sanskrit": "शिष्यःस्वयंभुवो देवः सर्वं प्रत्यक्षदृग्वशी ।\nअणिमादिभिरष्टाभिः सूक्ष्मैरङ्गैः समन्वितः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006136039, "chapter_id": 26136, "verse_number": "१-१-२-४०", "content_sanskrit": "तिर्यग्वातादिभिर्वर्षैः सर्वां ल्लोकान्बिभर्ति यः ।\nसप्तस्कन्धा भृताः शाखाः सर्वतोयाजराजरान् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006136040, "chapter_id": 26136, "verse_number": "१-१-२-४१", "content_sanskrit": "विषयैर्मरुतो यस्य संस्थिताः सप्तसप्तकाः ।\nव्यूहत्रयाणां सूतानां कुर्वन् सत्रं महाबलः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006136041, "chapter_id": 26136, "verse_number": "१-१-२-४२", "content_sanskrit": "तेजसश्वाप्युपायानां दधातीह शरीरिणः ।\nप्राणाद्या वृत्तयः पञ्च धारणानां स्ववृत्तिभिः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006136042, "chapter_id": 26136, "verse_number": "१-१-२-४३", "content_sanskrit": "पूर्यमाणः शरीराणां धारणं यस्य कुर्वते ।\nआकाशयोनिर्द्विगुणः शब्दस्पर्शसमन्वितः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006136043, "chapter_id": 26136, "verse_number": "१-१-२-४४", "content_sanskrit": "वाचोरणिः समाख्याता शब्दशास्त्रविचक्षणैः ।\nभारत्याः श्लक्ष्णया सर्वान्मुनीन्प्रह्लादयन्निव ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006136044, "chapter_id": 26136, "verse_number": "१-१-२-४५", "content_sanskrit": "पुराणज्ञाः सुमनसः पुराणाश्रययुक्तया ।\nपुराणनियता विप्राः कथामकथयद्विभुः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006136045, "chapter_id": 26136, "verse_number": "१-१-२-४६", "content_sanskrit": "एतत्सर्वं यथावृत्तमाख्यानं द्विजसत्तमाः ।\nऋषीणां च परं चैतल्लोकतत्त्वमनुत्तमम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006136046, "chapter_id": 26136, "verse_number": "१-१-२-४७", "content_sanskrit": "ब्रह्मणा यत्पुरा प्रोक्तं पुराणं ज्ञानमुत्तमम् ।\nदेवतानामृषीणां च सर्वपापप्रमोचनम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006136047, "chapter_id": 26136, "verse_number": "१-१-२-४८", "content_sanskrit": "विस्तरेणानुपूर्व्या च तस्य वक्ष्याम्यनुक्रमम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]