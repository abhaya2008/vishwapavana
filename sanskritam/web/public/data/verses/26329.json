[{"id": 7006329000, "chapter_id": 26329, "verse_number": "१-३९-१", "content_sanskrit": "वैशम्पायन उवाच यत्तत् सत्राजिते कृष्णो मणिरत्नं स्यमन्तकम् ।\nअदात् तद्धारयामास बभ्रुर्वै शतधन्वना ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006329001, "chapter_id": 26329, "verse_number": "१-३९-२", "content_sanskrit": "सदा हि प्रार्थयामास सत्यभामामनिन्दिताम् ।\nअक्रूरोऽन्तरमन्विच्छन् मणिं चैव स्यमन्तकम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006329002, "chapter_id": 26329, "verse_number": "१-३९-३", "content_sanskrit": "सत्राजितं ततो हत्वा शतधन्वा महाबलः ।\nरात्रौ तं मणिमादाय ततोऽक्रूराय दत्तवान् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006329003, "chapter_id": 26329, "verse_number": "१-३९-४", "content_sanskrit": "अक्रूरस्तु ततो रत्नमादाय भरतर्षभ ।\nसमयं कारयांचक्रे नावेद्योऽहं त्वयेत्युत ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006329004, "chapter_id": 26329, "verse_number": "१-३९-५", "content_sanskrit": "वयमभ्युपयास्यामः कृष्णेन त्वामभिद्रुतम् ।\nममाद्य द्वारका सर्वा वशे तिष्ठत्यसंशयम्  ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006329005, "chapter_id": 26329, "verse_number": "१-३९-६", "content_sanskrit": "हते पितरि दुःखार्ता सत्यभामा यशस्विनी ।\nप्रययौ रथमारुह्य नगरं वारणावतम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006329006, "chapter_id": 26329, "verse_number": "१-३९-७", "content_sanskrit": "सत्यभामा तु तद्वृत्तं भोजस्य शतधन्वनः ।\nभर्तुर्निवेद्य दुःखार्ता पार्श्वस्थाश्रूण्यवर्तयत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006329007, "chapter_id": 26329, "verse_number": "१-३९-८", "content_sanskrit": "पाण्डवानां तु दग्धानां हरिः कृत्वोदकक्रियाम् ।\nकुल्यार्थे चापि पाण्डूनां न्ययोजयत सात्यकिम्॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006329008, "chapter_id": 26329, "verse_number": "१-३९-९", "content_sanskrit": "ततस्त्वरितमागत्य द्वारकां मधुसूदनः ।\nपूर्वजं हलिनं श्रीमानिदं वचनमब्रवीत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006329009, "chapter_id": 26329, "verse_number": "१-३९-१०", "content_sanskrit": "हतः प्रसेनः सिंहेन सत्राजिच्छतधन्वना ।\nस्यमन्तकः स मद्गामी तस्य प्रभुरहं विभो ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006329010, "chapter_id": 26329, "verse_number": "१-३९-११", "content_sanskrit": "तदारोह रथं शीघ्रं भोजं हत्वा महाबलम् ।\nस्यमन्तको महाबाहो ह्यस्माकं स भविष्यति ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006329011, "chapter_id": 26329, "verse_number": "१-३९-१२", "content_sanskrit": "ततः प्रववृते युद्धं तुमुलं भोजकृष्णयोः ।\nशतधन्वा ततोऽक्रूरमवैक्षत् सर्वतो दिशम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006329012, "chapter_id": 26329, "verse_number": "१-३९-१३", "content_sanskrit": "संरब्धौ तावुभौ दृष्ट्वा तत्र भोजजनार्दनौ ।\nशक्तोऽपि शाठ्याद्धार्दिक्यमक्रूरो नाभ्यपद्यत ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006329013, "chapter_id": 26329, "verse_number": "१-३९-१४", "content_sanskrit": "अपयाने ततो बुद्धिं भोजश्चक्रे भयार्दितः ।\nयोजनानां शतं साग्रं हयया प्रत्यपद्यत ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006329014, "chapter_id": 26329, "verse_number": "१-३९-१५", "content_sanskrit": "विख्याता हृदया 'नाम शतयोजनगामिनी ।\nभोजस्य वडवा राजन् यया कृष्णमयोधयत् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006329015, "chapter_id": 26329, "verse_number": "१-३९-१६", "content_sanskrit": "क्षीणां जवन च हयामध्वनः शतयोजने ।\nदृष्ट्वा रथस्य ता वृद्धिं शतधन्वा समत्यजत् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006329016, "chapter_id": 26329, "verse_number": "१-३९-१७", "content_sanskrit": "ततस्तस्या हयायास्तु श्रमात् खेदाच्च भारत ।\nखमुत्पेतुरथ प्राणाः कृष्णो राममथाब्रवीत् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006329017, "chapter_id": 26329, "verse_number": "१-३९-१८", "content_sanskrit": "तिष्ठस्वेह महाबाहो दृष्टदोषा हया मया ।\nपद्भ्यां गत्वा हरिष्यामि मणिरत्नं स्यमन्तकम्॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006329018, "chapter_id": 26329, "verse_number": "१-३९-१९", "content_sanskrit": "पद्भ्यामेव ततो गत्वा शतधन्वानमच्युतः ।\nमिथिलामभितो राजन् जघान परमास्त्रवित् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006329019, "chapter_id": 26329, "verse_number": "१-३९-२०", "content_sanskrit": "स्यमन्तकं च नापश्यद्धत्वा भोजं महाबलम् ।\nनिवृत्तं चाब्रवीत् कृष्णं रत्नं देहीति लाङ्गली ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006329020, "chapter_id": 26329, "verse_number": "१-३९-२१", "content_sanskrit": "नास्तीति कृष्णश्चोवाच ततो रामो रुषान्वितः ।\nधिक्छब्दमसकृत्कृत्वा प्रत्युवाच जनार्दनम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006329021, "chapter_id": 26329, "verse_number": "१-३९-२२", "content_sanskrit": "भ्रातृत्वान्मर्षयाम्येष स्वस्ति तेऽस्तु व्रजाम्यहम् ।\nकृत्यं न मे द्वारकया न त्वया न च वृष्णिभिः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006329022, "chapter_id": 26329, "verse_number": "१-३९-२३", "content_sanskrit": "प्रविवेश ततो रामो मिथिलामरिमर्दनः ।\nसर्वकामैरुपहृतैमैथिलेनाभिपूजितः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006329023, "chapter_id": 26329, "verse_number": "१-३९-२४", "content_sanskrit": "एतस्मिन्नेव काले तु बभ्रुर्मतिमतां वरः ।\nनानारूपान् क्रतून् सर्वानाजहार निरर्गलान् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006329024, "chapter_id": 26329, "verse_number": "१-३९-२५", "content_sanskrit": "दीक्षामयं स कवचं रक्षार्थं प्रविवेश ह ।\nस्यमन्तककृते प्राज्ञो गान्दीपुत्रो महायशाः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006329025, "chapter_id": 26329, "verse_number": "१-३९-२६", "content_sanskrit": "अथ रत्नानि चाग्र्याणि द्रव्याणि विविधानि च ।\nषष्टिं वर्षाणि धर्मात्मा यज्ञेषु विनियोजयत् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006329026, "chapter_id": 26329, "verse_number": "१-३९-२७", "content_sanskrit": "अक्रूरयज्ञा इति ते ख्यातास्तस्य महात्मनः ।\nबह्वन्नदक्षिणाः सर्वे सर्वकामप्रदायिनः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006329027, "chapter_id": 26329, "verse_number": "१-३९-२८", "content_sanskrit": "अथ दुर्योधनो राजा गत्वा तु मिथिलां प्रभुः ।\nगदाशिक्षां ततो दिव्यां बलभद्रादवाप्तवान् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006329028, "chapter_id": 26329, "verse_number": "१-३९-२९", "content_sanskrit": "प्रसाद्य तु ततो रामो वृष्ण्यन्धकमहारथैः ।\nआनीतो द्वारकामेव कृष्णेन च महात्मना ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006329029, "chapter_id": 26329, "verse_number": "१-३९-३०", "content_sanskrit": "अक्रूरस्त्वन्धकैः सार्धमपायाद् भरतर्षभ ।\nहत्वा सत्राजितं सुप्तं सहबन्धुं महाबलम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006329030, "chapter_id": 26329, "verse_number": "१-३९-३१", "content_sanskrit": "ज्ञातिभेदभयात् कृष्णस्तमुपेक्षितवानथ ।\nअपयाते तथाक्रूरे नावर्षत् पाकशासनः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006329031, "chapter_id": 26329, "verse_number": "१-३९-३२", "content_sanskrit": "अनावृष्ट्या यदा राज्यमभवद् बहुधा कृशम् ।\nततः प्रसादयामासुरक्रूरं कुकुरान्धकाः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006329032, "chapter_id": 26329, "verse_number": "१-३९-३३", "content_sanskrit": "पुनर्द्वारवतीं प्राप्ते तस्मिन् दानपतौ ततः ।\nप्रववर्ष सहस्राक्षः कच्छे जलनिधेस्तदा ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006329033, "chapter_id": 26329, "verse_number": "१-३९-३४", "content_sanskrit": "कन्यां च वासुदेवाय स्वसारं शीलसम्मताम् ।\nअक्रूरः प्रददौ धीमान् प्रीत्यर्थं कुरुनन्दन ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006329034, "chapter_id": 26329, "verse_number": "१-३९-३५", "content_sanskrit": "अथ विज्ञाय योगेन कृष्णो बभ्रूगतं मणिम् ।\nसभामध्ये गतं प्राह तमक्रूरं जनार्दनः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006329035, "chapter_id": 26329, "verse_number": "१-३९-३६", "content_sanskrit": "यत् तद् रत्नं मणिवरं तव हस्तगतं विभो ।\nतत् प्रयच्छस्व मानार्ह मयि मानार्यकं कृथाः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006329036, "chapter_id": 26329, "verse_number": "१-३९-३७", "content_sanskrit": "षष्टिवर्षे गते काले यद्रोषोऽभून्ममानघ ।\nस संरूढोऽसकृत्प्राप्तस्ततः कालात्ययो महान्॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006329037, "chapter_id": 26329, "verse_number": "१-३९-३८", "content_sanskrit": "ततः कृष्णस्य वचनात् सर्वसात्त्वतसंसदि ।\nप्रददौ तं मणिं बभ्रुरक्लेशेन महामतिः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006329038, "chapter_id": 26329, "verse_number": "१-३९-३९", "content_sanskrit": "ततस्तमार्जवप्राप्तं बभ्रोर्हस्तादरिंदमः ।\nददौ हृष्टमनाः कृष्णस्तं मणिं बभ्रवे पुनः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006329039, "chapter_id": 26329, "verse_number": "१-३९-४०", "content_sanskrit": "स कृष्णहस्तात्सम्प्राप्तं मणिरन्तं स्यमन्तकम् ।\nआबद्ध्य गान्दिनीपुत्रो विरराजांशुमानिव ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006329040, "chapter_id": 26329, "verse_number": "१-३९-४१", "content_sanskrit": "यस्त्वेवं शृणुयान्नित्यं शुचिर्भूत्वा समाहितः ।\nसुखानां सकलानां च फलभागीह जायते ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006329041, "chapter_id": 26329, "verse_number": "१-३९-४२", "content_sanskrit": "आ ब्रह्मभुवनाश्चापि यशःख्यातिर्न संशयः ।\nभविष्यति नृपश्रेष्ठ सत्यमेतद् ब्रवीमि ते ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]