[{"id": 2029353, "chapter_id": 1641, "verse_number": "३-२७९-०x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2029354, "chapter_id": 1641, "verse_number": "३-२७९-१", "content_sanskrit": "मारीचस्त्वथ संभ्रान्तो दृष्ट्वा रावणमागतम्।\nपूजयामास सत्कारैः फलमूलादिभिस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2029355, "chapter_id": 1641, "verse_number": "३-२७९-२", "content_sanskrit": "विश्रान्तं चैनमासीनमन्वासीनः स राक्षसः।\nउवाच प्रश्रितं वाक्यं वाक्यज्ञो वाक्यकोविदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2029356, "chapter_id": 1641, "verse_number": "३-२७९-३", "content_sanskrit": "न ते प्रकृतिमान्वर्णः कच्चित्क्षेमं पुरे तव।\nकच्चित्प्रकृतयः सर्वा भजन्ते त्वां यथा पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2029357, "chapter_id": 1641, "verse_number": "३-२७९-४", "content_sanskrit": "किमिहागमने चापि कार्यं ते राक्षसेश्वर।\nकृतमित्येव तद्विद्धि यद्यपि स्यात्सुदुष्करम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2029358, "chapter_id": 1641, "verse_number": "३-२७९-५", "content_sanskrit": "शशंस रावणस्तस्मै तत्सर्वं रामचेष्टितम्।\nसमासेनैव कार्याणि क्रोधामर्षसमन्वितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2029359, "chapter_id": 1641, "verse_number": "३-२७९-६", "content_sanskrit": "मारीचस्त्वब्रवीच्छ्रत्वा समासेनैव रावणम्।\nअलं ते राममासाद्य वीर्यज्ञो ह्यस्मि तस्य वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2029360, "chapter_id": 1641, "verse_number": "३-२७९-७", "content_sanskrit": "बाणवेगं हि कस्तस्य शक्तः सोढुं महात्मनः।\nप्रव्रज्यायां हि मे हेतुः स एव पुरुषर्षभः।\nविनाशमुखमेतत्ते केनाख्यातं दुरात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2029361, "chapter_id": 1641, "verse_number": "३-२७९-८", "content_sanskrit": "तमुवाचाथ सक्रोधो रावणः परिभर्त्सयन्।\nअकुर्वतोऽस्मद्वचनं स्यान्मृत्युरपि ते ध्रुवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2029362, "chapter_id": 1641, "verse_number": "३-२७९-९", "content_sanskrit": "मरीचश्चिन्तयामास विशिष्टान्मरणं वरम्।\nअवश्यं मरणे प्राप्ते करिष्याम्यस्य यन्मतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2029363, "chapter_id": 1641, "verse_number": "३-२७९-१०", "content_sanskrit": "ततस्तं प्रत्युवाचाथ मारीचो रक्षसांवरम्।\nकिं ते साह्यां मया कार्यं करिष्याम्यवशोपि तत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2029364, "chapter_id": 1641, "verse_number": "३-२७९-११", "content_sanskrit": "तमब्रवीद्दशग्रीवो गच्छ सीतां प्रलोभय।\nरत्नशृङ्गो मृगो भूत्वा रत्नचित्रतनूरुहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2029365, "chapter_id": 1641, "verse_number": "३-२७९-१२", "content_sanskrit": "ध्रुवं सीता समालक्ष्यत्वां रामं चोदयिष्यति।\nअपक्रान्ते च काकुत्स्थे सीता वश्या भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2029366, "chapter_id": 1641, "verse_number": "३-२७९-१३", "content_sanskrit": "तामादायापनेष्यामि ततः स नभविष्यति।\nभार्यावियोगाद्दुर्बुद्धिरेतत्साह्यं कुरुष्व मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2029367, "chapter_id": 1641, "verse_number": "३-२७९-१४", "content_sanskrit": "इत्येवमुक्तोमारीचः कृत्वोदकमथात्मनः।\nरावणं पुरतो यान्तमन्वगच्छत्सुदुःखितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2029368, "chapter_id": 1641, "verse_number": "३-२७९-१५", "content_sanskrit": "ततस्तस्याश्रमं गत्वारामस्याक्लिष्टकर्मणः।\nचक्रतुस्तद्यथा सर्वमुभौ यत्पूर्वमन्त्रितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2029369, "chapter_id": 1641, "verse_number": "३-२७९-१६", "content_sanskrit": "रावणस्तु यतिर्भूत्वा मुण्डः कुण्डीत्रिदण्डधृत्।\nमृगश्चभूत्वामारीचस्तं देशमुपजग्मतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2029370, "chapter_id": 1641, "verse_number": "३-२७९-१७", "content_sanskrit": "दर्शयामास मारीचो वैदेहीं मृगरूपधृत्।\nचोदयामास तस्यार्थे सा रामं विधिचोदिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2029371, "chapter_id": 1641, "verse_number": "३-२७९-१८", "content_sanskrit": "रामस्तस्याः प्रियं कुर्वन्धनुरादाय सत्वरः।\nरक्षार्थे लक्ष्मणं न्यस्य प्रययौ मृगलिप्सया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2029372, "chapter_id": 1641, "verse_number": "३-२७९-१९", "content_sanskrit": "स धन्वी बद्धतूणीरः खङ्गगोधाङ्गुलित्रवान्।\nअन्वधावन्मृगं रामो रुद्रस्तारामृगं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2029373, "chapter_id": 1641, "verse_number": "३-२७९-२०", "content_sanskrit": "सोऽन्तर्हितः पुनस्तस्य दर्शनं राक्षसो व्रजन्।\nचकर्ष महदध्वानं रामस्तं वुबुधे ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2029374, "chapter_id": 1641, "verse_number": "३-२७९-२१", "content_sanskrit": "निशाचरं विदित्वा तं राघवः प्रतिभानवान्।\nअमोघं शरमादाय जघान मृगरूपिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2029375, "chapter_id": 1641, "verse_number": "३-२७९-२२", "content_sanskrit": "स रामवाणाभिहतः कृत्वा रामस्वरं तदा।\nहा सीते लक्ष्मणेत्येवं चुक्रोशार्तस्वरेण ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2029376, "chapter_id": 1641, "verse_number": "३-२७९-२३", "content_sanskrit": "शुश्राव तस्य वैदेही ततस्तां करुणां गिरम्।\nसाप्रापतत्ततः सीता तामुवाचाथ लक्ष्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2029377, "chapter_id": 1641, "verse_number": "३-२७९-२४", "content_sanskrit": "अलं ते शङ्कया भीरु को रामं प्रहरिष्यति।\nमुहूर्ताद्द्रक्ष्यसे रामं भर्तारं त्वं शुचिस्मितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2029378, "chapter_id": 1641, "verse_number": "३-२७९-२५", "content_sanskrit": "इत्युक्ता सा प्ररुदती पर्यशङ्कत लक्ष्मणम्।\nहता वै स्त्रीस्वभावेन शुद्धचारित्रभूषणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2029379, "chapter_id": 1641, "verse_number": "३-२७९-२६", "content_sanskrit": "सा तं परुषमारब्धा वक्तुं साध्वी पतिव्रता।\nनैष कामो भवेन्मूढ यं त्वं प्रार्थयसे हृदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2029380, "chapter_id": 1641, "verse_number": "३-२७९-२७", "content_sanskrit": "अप्यहंशस्त्रमादाय हन्यामात्मानमात्मना।\nपतेयं गिरिशृङ्गाद्वा विशेयं वा हुताशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2029381, "chapter_id": 1641, "verse_number": "३-२७९-२८", "content_sanskrit": "रामं भर्तारमुत्सुज्यन त्वहं त्वां कथञ्चन।\nनिहीनमुपतिष्ठेयं शार्दूली क्रोष्टुकं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2029382, "chapter_id": 1641, "verse_number": "३-२७९-२९", "content_sanskrit": "एतादृशं वचः श्रुत्वा लक्ष्मणः प्रियराघ्नव।\nपिधायकर्णौ सद्वृत्तः प्रस्थितो येन राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2029383, "chapter_id": 1641, "verse_number": "३-२७९-३०", "content_sanskrit": "स रामस्य पदंगृह्य प्रससार धनुर्धरः।\nअवीक्षमाणो विम्बोष्ठीं प्रययौ लक्ष्मणस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2029384, "chapter_id": 1641, "verse_number": "३-२७९-३१", "content_sanskrit": "एतस्मिन्नन्तरे रक्षो रावणः प्रत्यदृश्यत।\nअभव्यो भव्यरूपेण भस्मच्छन्न इवानलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2029385, "chapter_id": 1641, "verse_number": "३-२७९-३२", "content_sanskrit": "यतिवेपप्रतिच्छन्नो जिहीर्षुस्तामनिन्दिताम्।\n`उपागच्छत्स वैदेहीं रावणः पापनिश्चयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2029386, "chapter_id": 1641, "verse_number": "३-२७९-३३", "content_sanskrit": "सा तमालक्ष्यसंप्राप्तं धर्मज्ञा जनकात्मजा।\nनिमन्त्रयामास तदा फलमूलाशनादिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2029387, "chapter_id": 1641, "verse_number": "३-२७९-३४", "content_sanskrit": "अवमत्यततः सर्वं स्वं रूपं प्रत्यपद्यत।\nसान्त्वयामास वैदेहीं कामी राक्षसपुङ्गवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2029388, "chapter_id": 1641, "verse_number": "३-२७९-३५", "content_sanskrit": "सीते राक्षसराजोऽहंरावणो नाम विश्रुतः।\nमम लङ्कापुरी नाम्ना रम्या पारे महोदधेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2029389, "chapter_id": 1641, "verse_number": "३-२७९-३६", "content_sanskrit": "तत्र त्वं नरनारीषु शोभिष्यसि मया सह।\nभार्या मे भव सुश्रोणि तापसं त्यज राघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2029390, "chapter_id": 1641, "verse_number": "३-२७९-३७", "content_sanskrit": "एवमादीनि वाक्यानि श्रुत्वा तस्याथ जानकी।\nपिधाय कर्णौ सुश्रोणी मैवमित्यब्रवीद्वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2029391, "chapter_id": 1641, "verse_number": "३-२७९-३८", "content_sanskrit": "प्रपतेद्द्यौः सनक्षत्रा पृथिवी शकलीभवेत्।\n`शुष्येत्तोयनिधौ तोयं चन्द्रः शीतांशुतां त्यजेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2029392, "chapter_id": 1641, "verse_number": "३-२७९-३९", "content_sanskrit": "उष्णांशुत्वमथो जह्यादादित्यो वह्निरुष्णताम्।\nत्यक्त्वाशैत्यं भजेन्नाहं त्यजेयंरघुनन्दनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2029393, "chapter_id": 1641, "verse_number": "३-२७९-४०", "content_sanskrit": "कथं हि भिन्नकरटं पद्मिनं वनगोचरम्।\nउपस्थाय महानागं करेणुः सूकरं स्पृशेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2029394, "chapter_id": 1641, "verse_number": "३-२७९-४१", "content_sanskrit": "कथं हि पीत्वा माध्वीकं पीत्वा च मधुमाधवीम्।\nलोभं सौवीरके कुर्यान्नारी काचिदिति स्मरेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2029395, "chapter_id": 1641, "verse_number": "३-२७९-४२", "content_sanskrit": "इति सा तं समाभाष्य प्रविवेशाश्रमं ततः।\nक्रोधात्प्रस्फुरमाणौष्ठी विधुन्वाना करौ मुहुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2029396, "chapter_id": 1641, "verse_number": "३-२७९-४३", "content_sanskrit": "तामधिद्रुत्य सुश्रोणीं रावणः प्रत्यषेधयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2029397, "chapter_id": 1641, "verse_number": "३-२७९-४४", "content_sanskrit": "भर्त्सयित्वातु रूक्षेण स्वरेण गतचेतनाम्।\nमूर्धजेषु निजग्राह ऊर्ध्वमाचक्रमे ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2029398, "chapter_id": 1641, "verse_number": "३-२७९-४५", "content_sanskrit": "तां ददर्श ततो गृध्रो जटायुर्गिरिगोचरः।\nरुदतीं रामरामेति हियमाणां तपस्विनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2029399, "chapter_id": 1641, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि रामोपाख्यानपर्वणि एकोनाशीत्यधिकद्विशततमोऽध्यायः ॥ २७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]