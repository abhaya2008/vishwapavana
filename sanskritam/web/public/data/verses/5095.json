[{"id": 2192545, "chapter_id": 5095, "verse_number": "", "content_sanskrit": "याज्ञवल्क्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2192546, "chapter_id": 5095, "verse_number": "१", "content_sanskrit": "तत्त्वानां सर्गसङ्ख्या च कालसङ्ख्या तथैव च ।\nमया प्रोक्तानुपूर्व्येणसंहारमपि मे शृणु\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2192547, "chapter_id": 5095, "verse_number": "२", "content_sanskrit": "यथा संहरते जन्तून् ससर्ज च पुनः पुनः ।\nअनादिनिधनो ब्रह्मा नित्यश्चाक्षर एव च\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2192548, "chapter_id": 5095, "verse_number": "३", "content_sanskrit": "अहःक्षयमथो बुद्ध्वा निशि स्वप्नमनास्तथा ।\nचोदयामास भगवानव्यक्तोऽहङ्कृतं नरम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2192549, "chapter_id": 5095, "verse_number": "४", "content_sanskrit": "ततः शतसहस्रांशुरव्यक्तेनाभिचोदितः ।\nकृत्वा द्वादशधात्मानमादित्यो ज्वलदग्निवत्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2192550, "chapter_id": 5095, "verse_number": "५", "content_sanskrit": "चतुर्विधं प्रजाजालंनिर्दहत्याशु तेजसा ।\nजराय्वण्डस्वेदजातमुद्भिज्जं च नराधिप\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2192551, "chapter_id": 5095, "verse_number": "६", "content_sanskrit": "एतदुन्मेषमात्रेण विनिष्टं स्थाणुजङ्गमम् ।\nकूर्मपृष्ठसमा भूमिर्भवत्यथ समन्ततः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2192552, "chapter_id": 5095, "verse_number": "७", "content_sanskrit": "जगद्दग्ध्वामितबलः केवलं जगतीं ततः ।\nअम्भसा बलिना क्षिप्रमापूर्यतसमन्ततः॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2192553, "chapter_id": 5095, "verse_number": "८", "content_sanskrit": "ततः कालाग्निमासाद्य तदम्भो याति सङ्क्षयम् ।\nविनष्टेऽम्भसि राजेन्द्र जाज्वलीत्यनलो महान्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2192554, "chapter_id": 5095, "verse_number": "९", "content_sanskrit": "तमप्रमेयोऽतिबलं ज्वलमानं विभावसुम् ।\nऊष्माणं सर्वभूतानां सप्तार्चिषमथाञ्जसा॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2192555, "chapter_id": 5095, "verse_number": "१०", "content_sanskrit": "भक्षयामास बलवान् वायुरष्टात्मको बली ।\nविचरन्नमितप्राणस्तिर्यगूर्ध्वमधस्तथा\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2192556, "chapter_id": 5095, "verse_number": "११", "content_sanskrit": "तमप्रतिबलं भीममाकाशं ग्रसतेऽऽत्मना।\nआकाशमप्यतिनदन्मनो ग्रसति चारिकम्॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2192557, "chapter_id": 5095, "verse_number": "१२", "content_sanskrit": "मनो ग्रसति सर्वात्मा सोऽहङ्कारः प्रजापतिः ।\nअहङ्कारं महानात्मा भूतभव्यभविष्यवित्॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2192558, "chapter_id": 5095, "verse_number": "१३", "content_sanskrit": "तमप्यनुपमात्मानं विश्वं शम्भुः प्रजापतिः।\nअणिमा लघिमा प्राप्तिरीशानो ज्योतिरव्ययः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2192559, "chapter_id": 5095, "verse_number": "१४", "content_sanskrit": "सर्वतःपाणिपादान्तःसर्वतोक्षिशिरोमुखः ।\nसर्वतःश्रुतिमाँल्लोके सर्वमावृत्य तिष्ठति\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2192560, "chapter_id": 5095, "verse_number": "१५", "content_sanskrit": "हृदयं सर्वभूतानां पर्वणोऽङ्गुष्ठमात्रकः ।\nअनुग्रसत्यनन्तं हि महात्मा विश्वमीश्वरः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2192561, "chapter_id": 5095, "verse_number": "१६", "content_sanskrit": "ततः समभवत् सर्वमक्षयाव्ययमव्रणम् ।\nभूतभव्यमनुष्याणां स्रष्टारमनघं तथा\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2192562, "chapter_id": 5095, "verse_number": "१७", "content_sanskrit": "एषोऽप्ययस्ते राजेन्द्र यथावत् परिभाषितः।\nअध्यात्ममधिभूतं च अधिदैवं च श्रूयताम्॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2192563, "chapter_id": 5095, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे चतुश्चत्वारिंशोत्तरशततमोऽध्यायः ॥१४४॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]