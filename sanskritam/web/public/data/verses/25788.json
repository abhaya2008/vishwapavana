[{"id": 7005788000, "chapter_id": 25788, "verse_number": "२६१-१", "content_sanskrit": "नानादेवप्रतिमाप्रमाणवर्णनम् ।\nसूत उवाच ।\nप्रभाकरस्य प्रतिमामिदानीं श्रुणुत द्विजाः! ।\nरथस्थं कारयेद्देवं पद्महस्तं सुलोचनम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005788001, "chapter_id": 25788, "verse_number": "२६१-२", "content_sanskrit": "सप्ताश्वञ्चैक चक्रञ्च रथं तस्य प्रकल्पयेत् ।\nमुकुटेन विचित्रेण पद्मगर्भसमप्रभम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005788002, "chapter_id": 25788, "verse_number": "२६१-३", "content_sanskrit": "नानाभरणभूषाभ्यां भुजाभ्यां धृतपुष्करम् ।\nस्कन्धस्थे पुष्करे ते तु लीलयैव धृते सदा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005788003, "chapter_id": 25788, "verse_number": "२६१-४", "content_sanskrit": "चोलकच्छन्नवपुषं क्वचिच्चित्रेषु दर्शयेत् ।\nवस्त्रयुग्मसमोपेतं चरणौ तेजसावृतौ ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005788004, "chapter_id": 25788, "verse_number": "२६१-५", "content_sanskrit": "प्रतिहारौ च कर्तव्यौ पार्श्वयोर्दण्डिपिङ्गलौ ।\nकर्तव्यौ खड्गहस्तौ तौ पार्श्वयोः पुरुषावुभौ ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005788005, "chapter_id": 25788, "verse_number": "२६१-६", "content_sanskrit": "लोखनीकृतहस्तञ्च पार्श्वे धातारमव्ययम् ।\nनानादेवगणैर्युक्तमेवं कुर्याद्दिवाकरम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005788006, "chapter_id": 25788, "verse_number": "२६१-७", "content_sanskrit": "अरुणः सारथिश्चास्य पद्मिनीपत्रसन्निभः ।\nअश्वौ सुवलयग्रीवावन्तस्थौ तस्य पार्श्वयोः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005788007, "chapter_id": 25788, "verse_number": "२६१-८", "content_sanskrit": "भुजङ्गरज्जुभिर्बद्धाः सप्ताश्वा रश्मिसंयुताः ।\nपद्मस्थं वाहनस्थं वा पद्महस्तं प्रकल्पयेत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005788008, "chapter_id": 25788, "verse_number": "२६१-९", "content_sanskrit": "वह्नेस्तु लक्षणं वक्ष्ये सर्वकामफलप्रदम् ।\nदीप्तं सुवर्णवपुषमर्धचन्द्रासने स्थितम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005788009, "chapter_id": 25788, "verse_number": "२६१-१०", "content_sanskrit": "बालार्कसदृशं तस्य वदनञ्चापि दर्शयेत् ।\nयज्ञोपवीतिनं देवं लम्बकूर्चधरं तथा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005788010, "chapter_id": 25788, "verse_number": "२६१-११", "content_sanskrit": "कमण्डलुं वामकरे दक्षिणे त्वक्षसूत्रकम् ।\nज्वालावितानसंयुक्तमजवाहनमुज्वलम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005788011, "chapter_id": 25788, "verse_number": "२६१-१२", "content_sanskrit": "कुण्डस्थं वापि कुर्वीत मूर्ध्नि सप्तशिखान्वितम् ।\nतथा यमं प्रवक्ष्यामि दण्डपाशधरं विंभुम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005788012, "chapter_id": 25788, "verse_number": "२६१-१३", "content_sanskrit": "महामहिषमारूढं कृष्णाञ्जनचयोपमम् ।\nसिंहासनगतञ्चापि दीप्ताग्निसमलोचनम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005788013, "chapter_id": 25788, "verse_number": "२६१-१४", "content_sanskrit": "महिषश्चित्रगुप्तश्च करालाः किङ्करास्तथा ।\nसमन्ताद्दर्शयेत्तस्य सौम्या सौम्यान् सुरासुरान् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005788014, "chapter_id": 25788, "verse_number": "२६१-१५", "content_sanskrit": "राक्षसेन्द्रं तथा वक्ष्ये लोकपालञ्च नैर्ऋतम् ।\nनरारूढं महामायं रक्षोभिर्बहुभिर्वृतम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005788015, "chapter_id": 25788, "verse_number": "२६१-१६", "content_sanskrit": "खड्गहस्तं महानीलं कज्जलाचलसन्निभम् ।\nनरयुक्तविमानस्थं पीताभरणभूषितम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005788016, "chapter_id": 25788, "verse_number": "२६१-१७", "content_sanskrit": "वरुणाञ्च प्रवक्ष्यामि पाशहस्तं महाबलम्‌ ।\nशङ्खस्फटिकवर्णाभं सितहाराम्बरावृतम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005788017, "chapter_id": 25788, "verse_number": "२६१-१८", "content_sanskrit": "झषासनगतं शान्तं किरीटाङ्गदधारिणम् ।\nवायुरूपं प्रवक्ष्यामि धूम्रन्तु मृगवाहनम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005788018, "chapter_id": 25788, "verse_number": "२६१-१९", "content_sanskrit": "चित्राम्बरधरं शान्तं युवानं कुञ्चितभ्रुवम् ।\nमृगाधिरूढं वरदं पताकाध्वजसंयुतम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005788019, "chapter_id": 25788, "verse_number": "२६१-२०", "content_sanskrit": "कुबेरञ्च प्रवक्ष्यामि कुण्डलाभ्यामलंकृतम् ।\nमहोदरं महाकायं निध्यष्टकसमन्वितम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005788020, "chapter_id": 25788, "verse_number": "२६१-२१", "content_sanskrit": "गुह्यकैर्बहुभिर्युक्तं धनव्ययकरैस्तथा ।\nहारकेयूररचितं सिताम्बरधरं सदा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005788021, "chapter_id": 25788, "verse_number": "२६१-२२", "content_sanskrit": "गदाधरञ्च कर्तव्यं वरदं मुकुटान्वितम् ।\nनरयुक्तविमानस्थं एवं रीत्या च कारयेत् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005788022, "chapter_id": 25788, "verse_number": "२६१-२३", "content_sanskrit": "तथैवेशं प्रवक्ष्यामि धवलं धवलेक्षणम् ।\nत्रिशूलपाणिनं देवं त्र्यक्षं वृषगतं प्रभुम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005788023, "chapter_id": 25788, "verse_number": "२६१-२४", "content_sanskrit": "मातृणां लक्षणं वक्ष्ये यथावदनुपूर्वशः ।\nब्रह्माणी ब्रह्मसदृशी चतुर्वक्त्रा चतुर्भुजा ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005788024, "chapter_id": 25788, "verse_number": "२६१-२५", "content_sanskrit": "हंसाधिरूढ़ां कर्तव्या साक्षसूत्रकमण्डलुः ।\nमहेश्वरस्य रूपेण तथा माहेश्वरी मता ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005788025, "chapter_id": 25788, "verse_number": "२६१-२६", "content_sanskrit": "जटा मुकुटसंयुक्ता वृषस्था चन्द्रशेखरा ।\nकपालशूलखट्वाङ्ग वरदाढ्या चतुर्भुजा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005788026, "chapter_id": 25788, "verse_number": "२६१-२७", "content_sanskrit": "कुमाररूपा कौमरी मयूरवरवाहना ।\nरक्तवस्त्राधरा तद्वच्छूलशक्तिधरा मता ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005788027, "chapter_id": 25788, "verse_number": "२६१-२८", "content_sanskrit": "हारकेयूरसम्पन्ना कृकवाकुधरा तथा ।\nवैष्णवी विष्णुसदृशा गरुडे समुपस्थिता ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005788028, "chapter_id": 25788, "verse_number": "२६१-२९", "content_sanskrit": "चतुर्बाहुश्च वरदा शङ्कचक्रगदाधरा ।\nसिंहासनगता वापि बालकेन समन्विता ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005788029, "chapter_id": 25788, "verse_number": "२६१-३०", "content_sanskrit": "वाराहीञ्च प्रवक्ष्यामि महिषोपरि संस्थिताम् ।\nवराहसदृशी देवी शिरश्चामरधारिणी ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005788030, "chapter_id": 25788, "verse_number": "२६१-३१", "content_sanskrit": "गदाचक्रधरा तद्वद्दानवेन्द्रविनाशिनी ।\nइन्द्राणीमिन्द्रसदृशीं वज्रशूलगदाधराम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005788031, "chapter_id": 25788, "verse_number": "२६१-३२", "content_sanskrit": "गजासनगतां देवीं लोचनैर्बहुभिर्वृताम् ।\nतप्तकाञ्चनवर्णाभां दिव्याभरणभूषिताम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005788032, "chapter_id": 25788, "verse_number": "२६१-३३", "content_sanskrit": "तीक्ष्मखड्गधरां तद्वद् वक्ष्ये योगेश्वरीमिमाम् ।\nदीर्घजिह्वामूर्ध्वकेशीमस्थिखण्डैश्च मण्डिताम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005788033, "chapter_id": 25788, "verse_number": "२६१-३४", "content_sanskrit": "दंष्ट्राकरालवदनां कुर्य्याच्चैव कृशोदरीम्  ।\nकपालमालिनीं देवीं मुण्डमालाविभूषिताम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005788034, "chapter_id": 25788, "verse_number": "२६१-३५", "content_sanskrit": "कपालं वामहस्ते तु मांसशोणितपूरितम् ।\nमस्तिष्काक्तञ्च विभ्राणां शक्तिकां दक्षिणे करे ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7005788035, "chapter_id": 25788, "verse_number": "२६१-३६", "content_sanskrit": "गृध्रस्था वायसस्था वा निर्मांसा विनतोदरी ।\nकरालवदना तद्वत् कर्तव्या सा त्रिलोचना ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7005788036, "chapter_id": 25788, "verse_number": "२६१-३७", "content_sanskrit": "चामुण्डा बद्धघण्टा वा द्वीपिचर्मधरा शुभा ।\nदिग्वासाः कालिका तद्वद्रासभस्था कपालिनी ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7005788037, "chapter_id": 25788, "verse_number": "२६१-३८", "content_sanskrit": "सुरक्तपुष्पाभरणा वर्धनी ध्वजसंयुता ।\nविनायकञ्च कुर्वीत मातॄणामन्तिके सदा ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7005788038, "chapter_id": 25788, "verse_number": "२६१-३९", "content_sanskrit": "वीरेश्वरश्च भगवान् वृषारूढो जटाधरः ।\nवीणाहस्तत्रिशूली च मातॄणामग्रतो भवेत् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7005788039, "chapter_id": 25788, "verse_number": "२६१-४०", "content_sanskrit": "श्रियं देवीं प्रवक्ष्यामि नवे वयसि संस्थिताम् ।\nसुयौवनां पीतगण्डां रक्तोष्ठीं कुञ्चितभ्रुवम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7005788040, "chapter_id": 25788, "verse_number": "२६१-४१", "content_sanskrit": "पीनोन्नतस्तनतटां मणिकुण्डलधारिणीम् ।\nसुमण्डलं मुखं तस्याः शिरः सीमन्तभूषणम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7005788041, "chapter_id": 25788, "verse_number": "२६१-४२", "content_sanskrit": "पद्मस्वस्तिकशङ्खैर्वा भूषितां कुण्डलालकैः ।\nकञ्चुकाबद्धगात्रौ च हारभूषौ पयोधरौ ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7005788042, "chapter_id": 25788, "verse_number": "२६१-४३", "content_sanskrit": "नागहस्तोपमौ बाहू केयूरकटकोज्ज्वलौ ।\nपद्मं हस्ते प्रदातव्यं श्रीफलं दक्षिणे भुजे ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7005788043, "chapter_id": 25788, "verse_number": "२६१-४४", "content_sanskrit": "मेखलाभरणं तद्वत्तप्तकाञ्चनसप्रभाम् ।\nनानाभरणसम्पन्नां शोभनाम्वरधारिणीम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7005788044, "chapter_id": 25788, "verse_number": "२६१-४५", "content_sanskrit": "पार्श्वे तस्याः स्त्रियः कार्य्या श्चामरव्यग्रपाणयः ।\nपद्मासनोपविष्टा तु पद्मसिंहासनम्थिता ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7005788045, "chapter_id": 25788, "verse_number": "२६१-४६", "content_sanskrit": "करिभ्यां स्नाप्यमानासौ भृङ्गराभ्यामनेकशः ।\nप्रक्षालयन्तौ करिणौ भृङ्गाराभ्यां तथापरौ ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7005788046, "chapter_id": 25788, "verse_number": "२६१-४७", "content_sanskrit": "स्तूयमाना च लोकेशैस्तथा गन्धर्वगुह्यकैः ।\nतथैव यक्षिणी कार्या सिद्धासुरनिषेविता ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7005788047, "chapter_id": 25788, "verse_number": "२६१-४८", "content_sanskrit": "पार्श्वयोः कलशौ तस्यास्तोरणे देवदानवाः ।\nनागाश्चैव तु कर्तव्याः खड्गखेटकधारिणः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7005788048, "chapter_id": 25788, "verse_number": "२६१-४९", "content_sanskrit": "अधस्तात्प्रकृतिस्तेषां नाभेरूर्ध्वन्तु पौरुषी ।\nफणाश्च मूर्ध्नि कर्तव्याद्विजिह्वा बहवः समाः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7005788049, "chapter_id": 25788, "verse_number": "२६१-५०", "content_sanskrit": "पिशाचा राक्षसाश्चैव भूतवेतालजातयः ।\nनिर्मांसाश्चैव ते सर्वे रौद्रा विकृतरूपिणः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7005788050, "chapter_id": 25788, "verse_number": "२६१-५१", "content_sanskrit": "क्षेत्रपालश्च कर्तव्यो जटिलो विकृताननः ।\nदिग्वासा जटिलस्वद्वच्छ्वागोमायु निषेवितः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7005788051, "chapter_id": 25788, "verse_number": "२६१-५२", "content_sanskrit": "कपालं वामहस्ते तु शिरः केशैः समावृतम् ।\nदक्षिणे शक्तिकां दद्यादसुरक्षयकारिणीम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7005788052, "chapter_id": 25788, "verse_number": "२६१-५३", "content_sanskrit": "अथातः सम्प्रवक्ष्यामि द्विभुजं कुसुमायुधम् ।\nपार्श्वे चाश्वमुखं तस्य मकरध्वजसंयुतम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7005788053, "chapter_id": 25788, "verse_number": "२६१-५४", "content_sanskrit": "दक्षिणे पुष्पबाणञ्च वामे पुष्पमयं धनुः ।\nप्रीतिः स्याद्दक्षिणे तस्य भोजनोपस्करान्विता ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7005788054, "chapter_id": 25788, "verse_number": "२६१-५५", "content_sanskrit": "रतिश्च वामपार्श्वेतु शयनं सारसान्वितम् ।\nपटश्च पटहश्चैव खरः कामातुरस्तथा ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7005788055, "chapter_id": 25788, "verse_number": "२६१-५६", "content_sanskrit": "पार्श्वतो जलवापी च वनं नन्दनमेव च ।\nसुशोभनश्च कर्तव्यो भगवान् कुसुमायुधः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7005788056, "chapter_id": 25788, "verse_number": "२६१-५७", "content_sanskrit": "संस्थानमीषद्वक्त्रं स्याद्विस्मितवक्त्रकम्  ।\nएतदुद्देशतः प्रोक्तं प्रतिमालक्षणं मया ।\nविस्तरेण न शक्नोति बृहस्पतिरपि द्विजाः ! ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]