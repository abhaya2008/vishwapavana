[{"id": 7004984000, "chapter_id": 24984, "verse_number": "७-१-१६७-१", "content_sanskrit": "ईश्वर उवाच ।\nततो गच्छेन्महादेवि तत्रस्थां भूतमातृकाम् ।\nसावित्र्या वारूणे भागे शतधन्वंतरे स्थिताम् ।\nनवकोटि गणैर्युक्तां प्रेतभूतसमाकुलाम् ।\nपूजितां सिद्धगंधर्वैर्देवादिभिरनेकशः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004984001, "chapter_id": 24984, "verse_number": "७-१-१६७-२", "content_sanskrit": "देव्युवाच ।\nभूतमातेति संहृष्टा ग्रामेग्रामे पुरेपुरे ।\nगायन्नृत्यन्हसंल्लोकः सर्वतः परिधावति ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004984002, "chapter_id": 24984, "verse_number": "७-१-१६७-३", "content_sanskrit": "उन्मत्तवत्प्रलपते क्षितौ पतति मत्तवत् ।\nक्रुद्धवद्धावति परान्मृतवत्कृष्यते हि सः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004984003, "chapter_id": 24984, "verse_number": "७-१-१६७-४", "content_sanskrit": "सुखभंगांश्च कुरुते लोको वातगृहीतवत् ।\nभूतवद्भस्ममूत्रांबुकर्दमानवगाहते ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004984004, "chapter_id": 24984, "verse_number": "७-१-१६७-५", "content_sanskrit": "किमेष शास्त्रनिर्दिष्टो मार्गः किमुत लौकिकः ।\nमुह्यते मे मनो देव तेन त्वं वक्तुमर्हसि ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004984005, "chapter_id": 24984, "verse_number": "७-१-१६७-६", "content_sanskrit": "कथं सा पुरुषैः पूज्या प्रभासक्षेत्रवासिभिः ।\nकस्मात्तत्र गता देवी कस्मिन्काले समागता ।\nकस्मिन्दिने तु मासे तु तस्याः कार्यो महोत्सवः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004984006, "chapter_id": 24984, "verse_number": "७-१-१६७-७", "content_sanskrit": "ईश्वर उवाच ।\nशृणु देवि प्रवक्ष्यामि यत्ते किंचिन्मनोगतम् ।\nआस्तिकाः श्रद्दधानाश्च भवन्तीति मतिर्मम ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004984007, "chapter_id": 24984, "verse_number": "७-१-१६७-८", "content_sanskrit": "चाक्षुषस्यान्तरेऽतीते प्राप्ते वैवस्वतेऽन्तरे ।\nदक्षापमानात्संजाता तदा पर्वतपुत्रिका ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004984008, "chapter_id": 24984, "verse_number": "७-१-१६७-९", "content_sanskrit": "द्वापरे तु द्वितीये वै दत्ता त्वं पर्वतेन मे ।\nविवाहे चैव संजाते सर्वदेवमनोरमे ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004984009, "chapter_id": 24984, "verse_number": "७-१-१६७-१०", "content_sanskrit": "त्वया च सहितः पूर्वं मन्दरे चारुकंदरे ।\nअक्रीडं च मुदा युक्तो दिव्यक्रीडनकैः प्रिये ।\nपीनोन्नतनितंबेन भ्राजमाना कुचोन्नताम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004984010, "chapter_id": 24984, "verse_number": "७-१-१६७-११", "content_sanskrit": "सिताब्जवदनां हृष्टां दृष्ट्वाऽहं त्वां महाप्रभाम् ।\nदग्धकामतरोः कन्दकंदलीमिव निःसृताम् ।\nमहार्हशयनस्थां त्वां तदा कामितवानहम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004984011, "chapter_id": 24984, "verse_number": "७-१-१६७-१२", "content_sanskrit": "सुरते तव संजातं दिव्यं वर्षशतं यदा ।\nतदा देवि समुत्थाय निरोधान्निर्गता बहिः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004984012, "chapter_id": 24984, "verse_number": "७-१-१६७-१३", "content_sanskrit": "तवोदकात्समुत्तस्थौ नार्येका गह्वरोदरा ।\nकृष्णा करालवदना पिंगाक्षी मुक्तमूर्धजा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004984013, "chapter_id": 24984, "verse_number": "७-१-१६७-१४", "content_sanskrit": "कपालमालाभरणा बद्धमुण्डार्धपिंडका ।\nखट्वांगकंकालधरा रुण्डमुंडकरा शिवा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004984014, "chapter_id": 24984, "verse_number": "७-१-१६७-१५", "content_sanskrit": "द्वीपिचर्माम्बरधरा रणत्किंकिणिमेखला ।\nडमड्डमरुकारा च फेत्कारपूरिताम्बरा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004984015, "chapter_id": 24984, "verse_number": "७-१-१६७-१६", "content_sanskrit": "तस्याश्च पार्श्वगा अन्यास्तासां नामानि मे शृणु ।\nसख्यो ब्राह्मणराक्षस्यस्तासां चैव सुदर्शनाः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004984016, "chapter_id": 24984, "verse_number": "७-१-१६७-१७", "content_sanskrit": "दशकोटिप्रभेदेन धरां व्याप्य सुसंस्थिताः ।\nमुख्यास्तत्र चतस्रो वै महाबलपराक्रमाः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004984017, "chapter_id": 24984, "verse_number": "७-१-१६७-१८", "content_sanskrit": "रक्तवर्णा महाजिह्वाऽक्षया वै पापकारिणी ।\nएतासामन्वये जाताः पृथिव्यां ब्रह्मराक्षसाः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004984018, "chapter_id": 24984, "verse_number": "७-१-१६७-१९", "content_sanskrit": "श्लेष्मातकतरौ ह्येते प्रायशः सुकृतालयाः ।\nउत्तालतालचपला नृत्यंति च हसंति च ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004984019, "chapter_id": 24984, "verse_number": "७-१-१६७-२०", "content_sanskrit": "विज्ञेया इह लोकेऽस्मिन्भूतानां मूलनायकाः ।\nअतिकृष्णा भवन्त्येते व्यंतरान्तरचारिणः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004984020, "chapter_id": 24984, "verse_number": "७-१-१६७-२१", "content_sanskrit": "वृक्षाग्रमात्रमाकाशं ते चरंति न संशयः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004984021, "chapter_id": 24984, "verse_number": "७-१-१६७-२२", "content_sanskrit": "तथैव मम वीर्यात्तु मद्रूपाभरणः पुमान् ।\nकपालखट्वांगधरो जातश्चर्मविगुण्ठितः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004984022, "chapter_id": 24984, "verse_number": "७-१-१६७-२३", "content_sanskrit": "अनुगम्यमानो बहुभिर्भूतैरपि भयंकरः ।\nसिंहशार्दूलवदनैर्वदनोल्लिखितांबरैः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004984023, "chapter_id": 24984, "verse_number": "७-१-१६७-२४", "content_sanskrit": "एवं देवि तदा जातः क्षुधाक्रान्तो बभाष माम् ।\nअतोऽहं क्षुधितं दृष्ट्वा वरं हीमं च दत्तवान् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004984024, "chapter_id": 24984, "verse_number": "७-१-१६७-२५", "content_sanskrit": "युवयोर्हस्तसंस्पर्शान्नक्तमेवास्तु सर्वशः ।\nनक्तं चैव बलीयांसौ दिवा नातिबलावुभौ ।\nपुत्रवद्रक्षतं लोकान्धर्मश्चैवानुपाल्यताम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004984025, "chapter_id": 24984, "verse_number": "७-१-१६७-२६", "content_sanskrit": "इत्युक्तौ तौ मया तत्र भूतमातृगणौ प्रिये ।\nएकीभूतौ क्षणेनैव तौ भवानीभवोद्भवौ ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004984026, "chapter_id": 24984, "verse_number": "७-१-१६७-२७", "content_sanskrit": "दृष्ट्वा हृष्टमनाश्चाहमवोचं त्वां शुचिस्मिते ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004984027, "chapter_id": 24984, "verse_number": "७-१-१६७-२८", "content_sanskrit": "कल्याणि पश्यपश्यैतौ ममांशाच्च समुद्भवौ ।\nबीभत्साद्भुतशृंगारधारिणौ हास्यकारिणौ ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004984028, "chapter_id": 24984, "verse_number": "७-१-१६७-२९", "content_sanskrit": "भ्रातृभांडा भूतमाता तथैवोदकसेविता ।\nसंज्ञात्रयं स्मृतं देवि लोके विख्यातपौरुषम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004984029, "chapter_id": 24984, "verse_number": "७-१-१६७-३०", "content_sanskrit": "पुनः कृतांजलिपुटौ दृष्ट्वा मामूचतुस्तदा ।\nआवयोर्भगवन्कुत्र स्थाने वासो भविष्यति ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004984030, "chapter_id": 24984, "verse_number": "७-१-१६७-३१", "content_sanskrit": "इत्युक्तवन्तौ तौ तत्र वरेण च्छन्दितौ मया ।\nअस्ति सौराष्ट्रविषये भारते क्षेत्रमुत्तमम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004984031, "chapter_id": 24984, "verse_number": "७-१-१६७-३२", "content_sanskrit": "प्रभासेति समाख्यातं तत्र क्षेमं मम प्रियम् ।\nकूर्मस्य नैरृते भागे स्थितं वै दक्षिणे परे ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004984032, "chapter_id": 24984, "verse_number": "७-१-१६७-३३", "content_sanskrit": "स्वाती विशाखा मैत्रं च यत्र ऋक्षत्रयं स्मृतम् ।\nतस्मिन्स्थाने सदा स्थेयं यावन्मन्वन्तरावधि ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004984033, "chapter_id": 24984, "verse_number": "७-१-१६७-३४", "content_sanskrit": "अन्यदा जीविकं वच्मि तव भूतप्रिये सदा ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004984034, "chapter_id": 24984, "verse_number": "७-१-१६७-३५", "content_sanskrit": "यत्र कण्टकिनो वृक्षा यत्र निष्पाववल्लरी ।\nभार्या पुनर्भूर्वल्मीकस्तास्ते वसतयश्चिरम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004984035, "chapter_id": 24984, "verse_number": "७-१-१६७-३६", "content_sanskrit": "यस्मिन्गृहे नराः पञ्च स्त्रीत्रयं तावतीश्च गाः ।\nअन्धकारेंधनाग्निश्च तद्गृहे वसतिस्तव ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004984036, "chapter_id": 24984, "verse_number": "७-१-१६७-३७", "content_sanskrit": "भूतैः प्रेतैः पिशाचैश्च यत्स्थानं समधिष्ठितम् ।\nएकावि चाष्टबालेयं त्रिगवं पञ्चमाहिषम् ।\nषडश्वं सप्तमातंगं तद्गृहे वसतिस्तव ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004984037, "chapter_id": 24984, "verse_number": "७-१-१६७-३८", "content_sanskrit": "उद्दालकान्नपिटकं तद्वत्स्थाल्यादिभाजनम् ।\nयत्र तत्रैव क्षिप्तं च तव तच्च प्रतिश्रयम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004984038, "chapter_id": 24984, "verse_number": "७-१-१६७-३९", "content_sanskrit": "मुशलोलूखले स्त्रीणामास्या तद्वदुदुंबरे ।\nभाषणं कटुकं चैव तत्र देवि स्थितिस्तव ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004984039, "chapter_id": 24984, "verse_number": "७-१-१६७-४०", "content_sanskrit": "खाद्यन्ते यत्र धान्यानि पक्वापक्वानि वेश्मनि ।\nतद्वच्छाखाश्च तत्र त्वं भूतैः सह चरिष्यसि ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004984040, "chapter_id": 24984, "verse_number": "७-१-१६७-४१", "content_sanskrit": "स्थालीपिधाने यत्राग्निं ददते विकला नराः ।\nगृहे तत्र दुरिष्टानामशेषाणां समाश्रयः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004984041, "chapter_id": 24984, "verse_number": "७-१-१६७-४२", "content_sanskrit": "मानुष्यास्थि गृहे यत्र अहोरात्रे व्यवस्थितम् ।\nतत्रायं भूतनिवहो यथेष्टं विचरिष्यति ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004984042, "chapter_id": 24984, "verse_number": "७-१-१६७-४३", "content_sanskrit": "सर्वस्मादधिकं ये न प्रवदन्ति पिनाकिनम् ।\nसाधारणं वदंत्येनं तत्र भूतैः समाविश ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004984043, "chapter_id": 24984, "verse_number": "७-१-१६७-४४", "content_sanskrit": "कन्या च यत्र वै वल्ली रोहीनाम जटी गृहे ।\nअगस्त्य पादपो वापि बंधुजीवो गृहेषु वै ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004984044, "chapter_id": 24984, "verse_number": "७-१-१६७-४५", "content_sanskrit": "करवीरो विशेषेण नंद्यावर्तस्तथैव च ।\nमल्लिका वा गृहे येषां भूतयोग्यं गृहं हि तत् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004984045, "chapter_id": 24984, "verse_number": "७-१-१६७-४६", "content_sanskrit": "तालं तमालं भल्लातं तिंतिणीखंडमेव वा ।\nबकुलं कदलीखंडं कदंबः खदिरोऽपि वा ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004984046, "chapter_id": 24984, "verse_number": "७-१-१६७-४७", "content_sanskrit": "न्यग्रोधो हि गृहे येषामश्वत्थं चूत एव वा ।\nउदुंबरश्च पनसः सर्वभूत प्रियं हि तत् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004984047, "chapter_id": 24984, "verse_number": "७-१-१६७-४८", "content_sanskrit": "यत्र काकगृहं वै स्यादारामे वा गृहेऽपि वा ।\nभिक्षुबिंबं च वै यत्र गृहे दक्षिणके तथा ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004984048, "chapter_id": 24984, "verse_number": "७-१-१६७-४९", "content_sanskrit": "बिंबमूर्ध्वं च यत्रस्थं तत्र भूतनिवेशनम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004984049, "chapter_id": 24984, "verse_number": "७-१-१६७-५०", "content_sanskrit": "लिंगार्चनं न यत्रैव यत्र नास्ति जपादिकम् ।\nयत्र भक्तिविहीना वै भूतानां तान्गृहान्वदेत् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004984050, "chapter_id": 24984, "verse_number": "७-१-१६७-५१", "content_sanskrit": "मलिनास्यास्तु ये मर्त्या मलिनांबर धारिणः ।\nमलदंता गृहस्था ये गृहं तेषां समाविश ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004984051, "chapter_id": 24984, "verse_number": "७-१-१६७-५२", "content_sanskrit": "अगम्यनिरता ये तु मैथुने व्यभिचारतः ।\nसंध्यायां मैथुनं यांति गृहं तेषां समाविश ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004984052, "chapter_id": 24984, "verse_number": "७-१-१६७-५३", "content_sanskrit": "बहुना किं प्रलापेन नित्यकर्मबहिष्कृताः ।\nरुद्रभक्तिविहीना ये गृहं तेषां समाविश ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004984053, "chapter_id": 24984, "verse_number": "७-१-१६७-५४", "content_sanskrit": "अदत्त्वा भुंजते योऽन्नं बंधुभ्योऽन्नं तथोदकम् ।\nसपिण्डान्सोदकांश्चैव तत्कालात्तान्नरान्भज ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004984054, "chapter_id": 24984, "verse_number": "७-१-१६७-५५", "content_sanskrit": "यत्र भार्या च भर्ता च परस्परविरोधिनौ ।\nसह भूतैर्गृहं तस्य विश त्वं भयवर्ज्जिता ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004984055, "chapter_id": 24984, "verse_number": "७-१-१६७-५६", "content_sanskrit": "वासुदेवे रतिर्नास्ति यत्र नास्ति सदा हरिः ।\nजपहोमादिकं नास्ति भस्म नास्ति गृहे नृणाम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004984056, "chapter_id": 24984, "verse_number": "७-१-१६७-५७", "content_sanskrit": "पर्वस्वप्यर्चनं नास्ति चतुर्दश्यां विशेषतः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004984057, "chapter_id": 24984, "verse_number": "७-१-१६७-५८", "content_sanskrit": "कृष्णाष्टम्यां च ये मर्त्याः संध्यायां भस्मवर्जिताः ।\nपंचदश्यां महादेवं न यजंति च यत्र वै ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004984058, "chapter_id": 24984, "verse_number": "७-१-१६७-५९", "content_sanskrit": "पौरजानपदैर्यत्र प्राक्प्रसिद्धा महोत्सवाः ।\nक्रियते पूर्ववन्नैव तद्गृहं वसतिस्तव ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004984059, "chapter_id": 24984, "verse_number": "७-१-१६७-६०", "content_sanskrit": "वेदघोषो न यत्रास्ति गुरुपूजादिकं न च ।\nपितृकर्मविहीनं च तद्भूतस्य गृहं स्मृतम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004984060, "chapter_id": 24984, "verse_number": "७-१-१६७-६१", "content_sanskrit": "रात्रौरात्रौ गृहे यस्मिन्कलहो जायते मिथः ।\nबालानां प्रेक्षमाणानां यत्र वृद्धश्च पूर्वतः ।\nभक्षयेत्तत्र वै हृष्टा भूतैः सह समाविश ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004984061, "chapter_id": 24984, "verse_number": "७-१-१६७-६२", "content_sanskrit": "कस्मिन्मासे दिने चापि भवित्री लोकपूजिता ।\nइत्युक्तोऽहं तया देवि तामवोचं पुनः प्रिये ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004984062, "chapter_id": 24984, "verse_number": "७-१-१६७-६३", "content_sanskrit": "अमा या माधवे मासि तस्मिन्या च चतुर्दशी ।\nतस्यां महोत्सवस्तत्र भविता ते चिरंतनः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004984063, "chapter_id": 24984, "verse_number": "७-१-१६७-६४", "content_sanskrit": "याः स्त्रियस्तां च यक्ष्यंति तस्मिन्काले महोत्सवे ।\nबलिभिः पुष्पधूपैश्च मा तासां त्वं गृहे विश ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004984064, "chapter_id": 24984, "verse_number": "७-१-१६७-६५", "content_sanskrit": "नारायण हृषीकेश पुण्डरीकाक्ष माधव ।\nअच्युतानंत गोविंद वासुदेव जनार्दन ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004984065, "chapter_id": 24984, "verse_number": "७-१-१६७-६६", "content_sanskrit": "नृसिंह वामनाचिंत्य केशवेति च ये जनाः ।\nरुद्र रुद्रेति रुद्रेति शिवाय च नमोनमः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004984066, "chapter_id": 24984, "verse_number": "७-१-१६७-६७", "content_sanskrit": "वक्ष्यंति सततं हृष्टास्तेषां धनगृहादिषु ।\nआरामे चैव गोष्ठे च मा विशेथाः कथंचन ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004984067, "chapter_id": 24984, "verse_number": "७-१-१६७-६८", "content_sanskrit": "देशाचाराञ्ज्ञा तिधर्माञ्जपं होमं च मंगलम् ।\nदैवतेज्यां विधानेन शौचं कुर्वंति ये जनाः ।\nलोकापवादभीता ये पुमांसस्तेषु मा विश ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004984068, "chapter_id": 24984, "verse_number": "७-१-१६७-६९", "content_sanskrit": "देव्युवाच ।\nकदा पूजा प्रकर्तव्या भूतमातुः सुखार्थिभिः ।\nपुरुषैर्देवदेवेश एतन्मे वक्तुमर्हसि ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004984069, "chapter_id": 24984, "verse_number": "७-१-१६७-७०", "content_sanskrit": "ईश्वर उवाच ।\nसर्वत्रैषा भगवती बालानां हितकारिणी ।\nनामभेदैः कालभेदैः क्रियाभेदैश्च पूज्यते ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004984070, "chapter_id": 24984, "verse_number": "७-१-१६७-७१", "content_sanskrit": "प्रतिपत्प्रभृति वैशाखे यावच्चतुर्दशीतिथिः ।\nतावत्पूजा प्रकर्तव्या प्रेरणीप्रेक्षणीयकैः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004984071, "chapter_id": 24984, "verse_number": "७-१-१६७-७२", "content_sanskrit": "भग्नामपि गतां चैनां जरत्तरुतले स्थिताम् ।\nसेचयिष्यंति ये भक्त्या जलसंपूर्णगंडुकैः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004984072, "chapter_id": 24984, "verse_number": "७-१-१६७-७३", "content_sanskrit": "ग्रीवासूत्रकसिन्दूरैः पुष्पैर्धूपैस्तथार्चयेत् ।\nतत्र सिद्धवटः पूज्यः शाखां चास्य विनिक्षिपेत् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004984073, "chapter_id": 24984, "verse_number": "७-१-१६७-७४", "content_sanskrit": "पूजितां तां नरैर्यत्नादवलोक्य शुभेप्सुभिः ।\nभोजयेत्क्षिप्रासंयावकृशरापूपपायसैः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004984074, "chapter_id": 24984, "verse_number": "७-१-१६७-७५", "content_sanskrit": "एवं विधिं यः कुरुते पुरुषो भक्तिभावतः ।\nस पुत्रपशुवृद्धिं च शरीरारोग्यमाप्नुयात् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004984075, "chapter_id": 24984, "verse_number": "७-१-१६७-७६", "content_sanskrit": "न शाकिन्यो गृहे तस्य न पिशाचा न राक्षसाः ।\nपीडां कुर्वन्ति शिशवो यान्ति वृद्धिमनामयाम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004984076, "chapter_id": 24984, "verse_number": "७-१-१६७-७७", "content_sanskrit": "अथ देवि प्रवक्ष्यामि प्रतिपत्प्रभृति क्रमात् ।\nयथोत्सवो नरैः कार्यः प्रेरणीप्रेक्षणीयकैः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004984077, "chapter_id": 24984, "verse_number": "७-१-१६७-७८", "content_sanskrit": "विकर्मफलनिर्द्देशैः पाखंडानां विटंबनैः ।\nप्रदर्श्यते हास्यपरैर्नरैरद्भुतचेष्टितैः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004984078, "chapter_id": 24984, "verse_number": "७-१-१६७-७९", "content_sanskrit": "पञ्चम्यां तु विशेषेण रात्रौ कोलाहलः शुभे ।\nजागरं तत्र कुर्वीत देवीं पूज्य प्रयत्नतः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004984079, "chapter_id": 24984, "verse_number": "७-१-१६७-८०", "content_sanskrit": "विश्वस्य धनलोभेन स्वाध्यायो निहतः पतिः ।\nआरोप्यमाणं शूलाग्रमेनं पश्यत भो जनाः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004984080, "chapter_id": 24984, "verse_number": "७-१-१६७-८१", "content_sanskrit": "दृष्टो भवद्भिर्दुष्टः स परदारावमर्शकः ।\nछित्त्वा हस्तौ च खड्गेन खरारूढस्तु गच्छति ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004984081, "chapter_id": 24984, "verse_number": "७-१-१६७-८२", "content_sanskrit": "शीर्णश्चैवासिपत्रेण अस्याभरणभूषितः ।\nसुखासन समारूढः सुकृती यात्यसौ सुखम् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7004984082, "chapter_id": 24984, "verse_number": "७-१-१६७-८३", "content_sanskrit": "हे जनाः किं न पश्यध्वं स्वामिद्रोहकरं परम् ।\nकरपत्रैर्विदार्यंतमुच्छलच्छोणितान्तरम् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7004984083, "chapter_id": 24984, "verse_number": "७-१-१६७-८४", "content_sanskrit": "चौरः किलायं संप्राप्तः सर्वोद्वेगकरः परः ।\nदंडप्रहाराभिहतो नीयते दंडपाशकैः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7004984084, "chapter_id": 24984, "verse_number": "७-१-१६७-८५", "content_sanskrit": "प्रेक्षकैश्चेष्टितः शश्वदारटन्विविधैः स्वरैः ।\nसंयम्य नीयते हन्तुं लज्जितोऽधोमुखो जनाः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7004984085, "chapter_id": 24984, "verse_number": "७-१-१६७-८६", "content_sanskrit": "सितकेशं सितश्मश्रुं सितांबरधरध्वजम् ।\nविटंकाद्यैश्च चेटीभिर्हन्यमानं न पश्यथि ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7004984086, "chapter_id": 24984, "verse_number": "७-१-१६७-८७", "content_sanskrit": "गृहान्निष्क्राम्य मां रंडां गृहं नीत्वाऽकरोद्रतिम् ।\nकस्मादसौ न कुरुते मूढो भरणपोषणम् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7004984087, "chapter_id": 24984, "verse_number": "७-१-१६७-८८", "content_sanskrit": "भैरवाभरणो नेता सदा घूर्णितलोचनः ।\nप्रवृत्ततंद्रवन्मूढो वध्यश्चासावितस्ततः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7004984088, "chapter_id": 24984, "verse_number": "७-१-१६७-८९", "content_sanskrit": "निर्वेदेकोऽस्य हृदये धनक्षेत्रादिसंभवः ।\nगृहीतं यदनेनाद्य बालेनापि महाव्रतम् ।\nरक्ताक्षं काककृष्णांगं सत्वरं किं न पश्यथि ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7004984089, "chapter_id": 24984, "verse_number": "७-१-१६७-९०", "content_sanskrit": "तरुकोटरगान्बद्ध्वा अन्याञ्छृंखलया तथा ।\nशरौघैः काष्ठकैश्चैव बहुभिः शकलीकृतान् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7004984090, "chapter_id": 24984, "verse_number": "७-१-१६७-९१", "content_sanskrit": "विमुक्तहक्काहुंकारा न्सुप्रहारान्निरीक्षत ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7004984091, "chapter_id": 24984, "verse_number": "७-१-१६७-९२", "content_sanskrit": "इमां कृष्णार्धवदनां ग्रहीष्यसि दुरात्मिकाम् ।\nविमुक्तकेशां नृत्यन्तीं पश्यध्वं योगिनीमिव ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7004984092, "chapter_id": 24984, "verse_number": "७-१-१६७-९३", "content_sanskrit": "गम्भीर नूपुरध्वानप्रवृद्धोद्धततांडवा ।\nउन्मत्तनेत्रचरणा यात्येषा डिम्भमण्डली ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7004984093, "chapter_id": 24984, "verse_number": "७-१-१६७-९४", "content_sanskrit": "कटीतटस्थपिटिकोल्लसत्कंबलधारिणी ।\nअटते नटती ह्युर्वी परितश्च गृहाद्गृहम् ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7004984094, "chapter_id": 24984, "verse_number": "७-१-१६७-९५", "content_sanskrit": "इत्येवमादिभिर्नित्यं प्रेरणीप्रेक्षणीयकैः ।\nप्रेरयेत्तान्महानित्थं पुत्रभ्रातृसुहृद्वृतः ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7004984095, "chapter_id": 24984, "verse_number": "७-१-१६७-९६", "content_sanskrit": "एकादश्यां नवम्यां वा दीपं प्रज्वाल्य कुण्डकम् ।\nमुखबिंबानि तत्रैव लेपदारुकृतानि वै ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7004984096, "chapter_id": 24984, "verse_number": "७-१-१६७-९७", "content_sanskrit": "विचित्राणि महार्हाणि रौद्रशान्तानि कारयेत् ।\nमातृणां चण्डिकादीनां राक्षसानां तथैव च ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7004984097, "chapter_id": 24984, "verse_number": "७-१-१६७-९८", "content_sanskrit": "भूतप्रेतपिशाचानां शाकिनीनां तथैव च ।\nमुखानि कारयेत्तत्र हावभावकृतानि च ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7004984098, "chapter_id": 24984, "verse_number": "७-१-१६७-९९", "content_sanskrit": "रक्षिभिर्बहुभिर्गुप्तं तिर्य ग्ध्वनिपुरःसरम् ।\nअमावास्यां महादेवि क्षिपेत्पूजाक्रमैर्नरः ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7004984099, "chapter_id": 24984, "verse_number": "७-१-१६७-१००", "content_sanskrit": "ततः प्रदोषसमये यत्र देवी जनैर्वृता ।\nतत्र गच्छेन्महारावैः फेत्कारा कुलकीर्तनैः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7004984100, "chapter_id": 24984, "verse_number": "७-१-१६७-१०१", "content_sanskrit": "वीरचर्याविधानेन नगरे भ्रामयेन्निशि ।\nवीरचर्या स कथितो दीपः सर्वार्थसाधकः ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7004984101, "chapter_id": 24984, "verse_number": "७-१-१६७-१०२", "content_sanskrit": "नित्यं निष्क्रामयेद्दीपं याव त्पञ्चदशी तिथिः ।\nपञ्चदश्यां प्रकुर्वीत भूतमातुर्महोत्सवम् ।\nतस्य गृहेश्वरं यावद्गृहे विघ्नं न जायते ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7004984102, "chapter_id": 24984, "verse_number": "७-१-१६७-१०३", "content_sanskrit": "अथ कालान्तरेऽतीते भूतमातुः शरीरतः ।\nजाताः प्रस्वेदबिन्दुभ्यः पिशाचाः पञ्चकोटयः ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7004984103, "chapter_id": 24984, "verse_number": "७-१-१६७-१०४", "content_sanskrit": "सर्वे ते क्रूरवदना जिह्वाज्वालाकृशोदराः ।\nपाणिपात्राः पिशाचास्ते निसृष्टबलिभोजनाः ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7004984104, "chapter_id": 24984, "verse_number": "७-१-१६७-१०५", "content_sanskrit": "धमनीसंतताः शुष्काः श्मश्रुलाश्चर्मवाससः ।\nउलूखलैराभरणैः शूर्पच्छत्रासनांबराः ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7004984105, "chapter_id": 24984, "verse_number": "७-१-१६७-१०६", "content_sanskrit": "नक्तं ज्वलितकेशाढ्या अंगारानुद्गिरंति वै ।\nअंगारकाः पिशाचास्ते मातृमार्गानुसारिणः ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7004984106, "chapter_id": 24984, "verse_number": "७-१-१६७-१०७", "content_sanskrit": "आकर्णदारितास्याश्च लंबभ्रूस्थूलनासिकाः ।\nबलाढ्यास्ते पिशाचा वै सूतिकागृहवासिनः ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7004984107, "chapter_id": 24984, "verse_number": "७-१-१६७-१०८", "content_sanskrit": "पृष्ठतः पाणिपादाश्च पृष्ठगा वातरंहसा ।\nविषादनाः पिशाचास्ते संग्रामे पिशिताशनाः ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7004984108, "chapter_id": 24984, "verse_number": "७-१-१६७-१०९", "content_sanskrit": "एवंविधान्पिशाचांस्तु दृष्ट्वा दीनानुकम्पया ।\nतेभ्योऽहमवदं किञ्चित्कारुण्यादल्पचेतसाम् ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7004984109, "chapter_id": 24984, "verse_number": "७-१-१६७-११०", "content_sanskrit": "अन्तर्धानं प्रजादेहे कामरूपित्वमेव च ।\nउभयोः संध्ययोश्चारं स्थानान्याजीवितं तथा ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7004984110, "chapter_id": 24984, "verse_number": "७-१-१६७-१११", "content_sanskrit": "गृहाणि यानि नग्नानि शून्यान्यायतनानि च ।\nविध्वस्तानि च यानि स्यू रचनारोषितानि च ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7004984111, "chapter_id": 24984, "verse_number": "७-१-१६७-११२", "content_sanskrit": "राजमार्गोपरथ्याश्च चत्वराणि त्रिकाणि च ।\nद्वाराण्यट्टालकांश्चैव निर्गमान्संक्रमांस्तथा ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7004984112, "chapter_id": 24984, "verse_number": "७-१-१६७-११३", "content_sanskrit": "पथो नदीश्च तीर्थानि चैत्यवृक्षान्महापथान् ।\nस्थानानि तु पिशाचानां निवासायाददां प्रिये ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7004984113, "chapter_id": 24984, "verse_number": "७-१-१६७-११४", "content_sanskrit": "अधार्मिका जनास्तेषामा जीवो विहितः पुरा ।\nवर्णाश्रमाचारहीनाः कारुशिल्पिजनास्तथा ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7004984114, "chapter_id": 24984, "verse_number": "७-१-१६७-११५", "content_sanskrit": "अनुतापाश्च साधूनां चौरा विश्वासघातिनः ।\nएतैरन्यैश्च बहुभिरन्यायोपार्जितैर्धनैः ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7004984115, "chapter_id": 24984, "verse_number": "७-१-१६७-११६", "content_sanskrit": "आरभ्यते क्रिया यास्तु पिशाचास्तत्र देवताः ।\nमधुमासदिने दध्ना तिलचूर्णसुरासवैः ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7004984116, "chapter_id": 24984, "verse_number": "७-१-१६७-११७", "content_sanskrit": "पूपैर्हारिद्रकृशरैस्तिलैरिक्षुगुडौदनैः ।\nकृष्णानि चैव वासांसि धूम्राः सुमनसस्तथा ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7004984117, "chapter_id": 24984, "verse_number": "७-१-१६७-११८", "content_sanskrit": "सर्वभूतपिशाचानां कृता देवी मया शुभा ।\nएवंविधा भूतमाता सर्वभूतगणैर्वृता ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7004984118, "chapter_id": 24984, "verse_number": "७-१-१६७-११९", "content_sanskrit": "प्रभासे संस्थिता देवी समुद्रादुत्तरेण तु ।\nय एतां वेद वै देव्या उत्पत्तिं पापनाशिनीम् ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7004984119, "chapter_id": 24984, "verse_number": "७-१-१६७-१२०", "content_sanskrit": "कुत्सिता संतति स्तस्य न भवेच्च कदाचन ।\nभूतप्रेतपिशाचानां न दोषैः परिभूयते ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7004984120, "chapter_id": 24984, "verse_number": "७-१-१६७-१२१", "content_sanskrit": "सर्वपापविनिर्मुक्तः सर्वसौभाग्यसंयुतः ।\nसर्वान्कामानवाप्नोति नारीहृदयनंदनः ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7004984121, "chapter_id": 24984, "verse_number": "७-१-१६७-१२२", "content_sanskrit": "ये मानयंति निजहासकलैर्विलासैः संसेवया अभयदा भवभूतमाताम् ।\nते भ्रातृभृत्यसुतबंधुजनैर्युताश्च सर्वोपसर्ग रहिताः सुखिनो भवन्ति ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7004984122, "chapter_id": 24984, "verse_number": "७-१-१६७-१२३", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां सप्तमे प्रभासखण्डे प्रथमे प्रभासक्षेत्रमाहात्म्ये भूत मातृकामाहात्म्यवर्णनंनाम सप्तषष्ट्युत्तरशततमोऽध्यायः ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}]