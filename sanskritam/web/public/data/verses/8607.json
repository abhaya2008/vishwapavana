[{"id": 900007942, "chapter_id": 8607, "verse_number": "188.1", "content_sanskrit": "ॐ अत एव चानन्याधिपतिः ॐ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900007943, "chapter_id": 8607, "verse_number": "188.2", "content_sanskrit": "एतेऽपि चान्याधिपतित्वयुक्ता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900007944, "chapter_id": 8607, "verse_number": "188.3", "content_sanskrit": "मुक्तस्वकीयावरयन्तृतास्ति मुक्तावपि ब्रह्मपुरःसराणाम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900007945, "chapter_id": 8607, "verse_number": "188.4", "content_sanskrit": "लोकाधिपत्यं च विधातुरेव सर्वात्मना", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900007946, "chapter_id": 8607, "verse_number": "188.5", "content_sanskrit": "लोका इतीहापि तु लोकिनां वचो", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900007947, "chapter_id": 8607, "verse_number": "188.6", "content_sanskrit": "तद्गास्तु मुक्ता इह लोकशब्दा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900007948, "chapter_id": 8607, "verse_number": "188.7", "content_sanskrit": "अलोकशब्देन विमुक्तिभाजो वाच्याः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900007949, "chapter_id": 8607, "verse_number": "188.8", "content_sanskrit": "लोकाभिधाश्चापि यतो हि मुक्ताः प्रकाशरूपाः सततं च सर्वे", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900007950, "chapter_id": 8607, "verse_number": "188.9", "content_sanskrit": "ब्रह्मैव लोकाधिपतिर्विमुक्तो भवेदिति प्राह तुरश्रुतिश्च", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900007951, "chapter_id": 8607, "verse_number": "188.10", "content_sanskrit": "न चेह विज्ञानफलं समुक्तं लोकाधिपत्यं", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900007952, "chapter_id": 8607, "verse_number": "188.11", "content_sanskrit": "भेदोऽमुनेत्यादि च सम्यगुक्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900007953, "chapter_id": 8607, "verse_number": "188.12", "content_sanskrit": "त्वप्रत्ययं चाप्यतिहाय नैव रूपेण तेनेति भवेदिहार्थः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900007954, "chapter_id": 8607, "verse_number": "188.13", "content_sanskrit": "भवत्यसावित्यणुशब्दमत्र विहाय वाक्यानि बहूनि दोषः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900007955, "chapter_id": 8607, "verse_number": "188.14", "content_sanskrit": "अतो जगद्व्यापृतिमन्त एव ब्रह्मादयः पूर्णगुणाः क्रमेण", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]