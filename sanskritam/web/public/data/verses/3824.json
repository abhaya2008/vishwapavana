[{"id": 2130921, "chapter_id": 3824, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2130922, "chapter_id": 3824, "verse_number": "१", "content_sanskrit": "श्रुत्वा बहुविधैः शब्दैर्नाद्यमानां गिरेर्गुहाम् ।\nअजातशत्रुः कौन्तेयो माद्रीपुत्रावुभावपि\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2130923, "chapter_id": 3824, "verse_number": "२", "content_sanskrit": "धौम्यः कृष्णा च विप्राश्च सर्वे च सुहृदस्तथा ।\nभीमसेनमपश्यन्तः सर्वे विमनसोऽभवन्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2130924, "chapter_id": 3824, "verse_number": "३", "content_sanskrit": "द्रौपदीमार्ष्टिषेणाय सम्प्रधार्य महारथाः ।\nसहिताः सायुधाः शूराः शैलमारुरुहुस्तदा\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2130925, "chapter_id": 3824, "verse_number": "४", "content_sanskrit": "ततः सम्प्राप्य शैलाग्रं वीक्षमाणा महारथाः ।\nददृशुस्ते महेष्वासा भीमसेनमरिन्दमाः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2130926, "chapter_id": 3824, "verse_number": "५", "content_sanskrit": "स्फुरतश्च महाकायान् गतसत्त्वांश्च राक्षसान् ।\nमहाबलान् महासत्त्वान् भीमसेनेन पातितान्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2130927, "chapter_id": 3824, "verse_number": "६", "content_sanskrit": "शुशुभे स महाबाहुर्गदाखड्गधनुर्धरः ।\nनिहत्य समरे सर्वान् दानवान् मघवानिव \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2130928, "chapter_id": 3824, "verse_number": "७", "content_sanskrit": "ततस्ते भ्रातरं दृष्ट्वा परिष्वज्य महारथाः ।\nतत्रोपविविशुः पार्थाः प्राप्ता गतिमनुत्तमाम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2130929, "chapter_id": 3824, "verse_number": "८", "content_sanskrit": "तैश्चतुर्भिर्महेष्वासैर्गिरिशृङ्गमशोभत ।\nलोकपालैर्महाभागैर्दिवं देववरैरिव \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2130930, "chapter_id": 3824, "verse_number": "९", "content_sanskrit": "कुबेरसदनं दृष्ट्वा राक्षसांश्च निपातितान् ।\nभ्राता भ्रातरमासीनमब्रवीत् पृथिवीपतिः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2130931, "chapter_id": 3824, "verse_number": "१०", "content_sanskrit": "साहसाद् यदि वा मोहाद् भीम पापमिदं कृतम् ।\nनैतत् ते सदृशं वीर मुनेरिव मृषा वधः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2130932, "chapter_id": 3824, "verse_number": "११", "content_sanskrit": "राजद्विष्टं न कर्तव्यमिति धर्मविदो विदुः ।\nत्रिदशानामिदं द्विष्टं भीमसेन त्वया कृतम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2130933, "chapter_id": 3824, "verse_number": "१२", "content_sanskrit": "अर्थधर्मावनादृत्य यः पापे कुरुते मनः ।\nकर्मणां पार्थ पापानां स फलं विन्दते ध्रुवम् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2130934, "chapter_id": 3824, "verse_number": "१३", "content_sanskrit": "साहसं बत भद्रं ते देवानामपि चाप्रियम् ।\nपुनरेवं न कर्तव्यं मम चेदिच्छसि प्रियम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2130935, "chapter_id": 3824, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2130936, "chapter_id": 3824, "verse_number": "१४", "content_sanskrit": "एवमुक्त्वा स धर्मात्मा भ्राता भ्रातरमच्युतम् ।\nभीमसेनं महाबाहुमप्रधृष्यपराक्रमम् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2130937, "chapter_id": 3824, "verse_number": "१५", "content_sanskrit": "अर्थतत्त्वविभागज्ञः कुन्तीपुत्रो युधिष्ठिरः ।\nविरराम महातेजास्तमेवार्थं विचिन्तयन्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2130938, "chapter_id": 3824, "verse_number": "१६", "content_sanskrit": "ततस्ते हतशिष्टा ये भीमसेनेन राक्षसाः ।\nसहिताः प्रत्यपद्यन्त कुबेरसदनं प्रति\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2130939, "chapter_id": 3824, "verse_number": "१७", "content_sanskrit": "ते जवेन महावेगाः प्राप्य वैश्रवणालयम् ।\nभीममार्तस्वरं चक्रुर्भीमसेनभयार्दिताः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2130940, "chapter_id": 3824, "verse_number": "१८", "content_sanskrit": "न्यस्तशस्त्रायुधाः क्लान्ताः शोणिताक्ततनुच्छदाः ।\nप्रकीर्णमूर्धजा राजन् यक्षाधिपतिमब्रुवन्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2130941, "chapter_id": 3824, "verse_number": "१९", "content_sanskrit": "गदापरिघनिस्त्रिंशतोमरप्रासयोधिनः ।\nराक्षसा निहताः सर्वे तव देव पुरःसराः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2130942, "chapter_id": 3824, "verse_number": "२०", "content_sanskrit": "प्रमृद्य तरसा शैलं मानुषेण धनेश्वर ।\nएकेन सहिताः सङ्खे रणे क्रोधवशाः गणाः \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2130943, "chapter_id": 3824, "verse_number": "२१", "content_sanskrit": "प्रवरा राक्षसेन्द्राणां यक्षाणां च नराधिप ।\nशेरते निहता देव गतसत्त्वाः परासवः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2130944, "chapter_id": 3824, "verse_number": "२२", "content_sanskrit": "भग्नः शैलो वयं मुक्ता मणिमांस्ते सखा हतः ।\nमानुषेण कृतं कर्म विधत्स्व यदनन्तरम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2130945, "chapter_id": 3824, "verse_number": "२३", "content_sanskrit": "स तच्छ्रुत्वा तु सङ्क्रुद्धः सर्वयक्षगणाधिपः ।\nकोपसंरक्तनयनः कथमित्यब्रवीद् वचः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2130946, "chapter_id": 3824, "verse_number": "२४", "content_sanskrit": "द्वितीयमपराध्यन्तं भीमं श्रुत्वा धनेश्वरः ।\nचुक्रोध यक्षाधिपतिर्युज्यतामिति चाब्रवीत्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2130947, "chapter_id": 3824, "verse_number": "२५", "content_sanskrit": "अथाभ्रघनसङ्काशं गिरिशृङ्गमिवोच्छ्रितम् ।\nरथं संयोजयामासुर्गन्धर्वैर्हेममालिभिः \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2130948, "chapter_id": 3824, "verse_number": "२६", "content_sanskrit": "तस्य सर्वगुणोपेता विमलाक्षा हयोत्तमाः ।\nतेजोबलगुणोपेता नानारत्नविभूषिताः ।\nशोभमाना रथे युक्तास्तरिष्यन्त इवाशुगाः \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2130949, "chapter_id": 3824, "verse_number": "२७", "content_sanskrit": "ततस्ते तु महायक्षाः क्रुद्धं दृष्ट्वा धनेश्वरम् ।\nहर्षयामासुरन्योन्यम् इङ्गितैर्विजयावहैः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2130950, "chapter_id": 3824, "verse_number": "२८", "content_sanskrit": "स तमास्थाय भगवान् राजराजो महारथम् ।\nप्रययौ देवगन्धर्वैः स्तूयमानो महाद्युतिः \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2130951, "chapter_id": 3824, "verse_number": "२९", "content_sanskrit": "तं प्रयान्तं महात्मानं सर्वे यक्षा धनाधिपम्।\nअनुजग्मुर्महात्मानं धनदं घोरदर्शनाः \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2130952, "chapter_id": 3824, "verse_number": "३०", "content_sanskrit": "रक्ताक्षा हेमसङ्काशा महाकाया महाबलाः ।\nसायुधा बद्धनिस्त्रिंशा यक्षा दशशतावराः \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2130953, "chapter_id": 3824, "verse_number": "३१", "content_sanskrit": "ते जवेन महावेगाः प्लवमाना विहायसा।\nगन्धमादनमाजग्मुः प्रकर्षन्त इवाम्बरम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2130954, "chapter_id": 3824, "verse_number": "३२", "content_sanskrit": "सायुधा बद्धनिस्त्रिंशा यक्षा दशशतायुताः ।\nजवेन महता वीराः परिवार्योपतस्थिरे\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2130955, "chapter_id": 3824, "verse_number": "३३", "content_sanskrit": "कुबेरं च महात्मानं यक्षरक्षोगणावृतम् ।\nददृशुर्हृष्टरोमाणः पाण्डवाः प्रियदर्शनम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2130956, "chapter_id": 3824, "verse_number": "३४", "content_sanskrit": "कुबेरस्तु महासत्त्वान् पाण्डोः पुत्रान् महारथान् ।\nआत्तकार्मुकनिस्त्रिंशान् दृष्ट्वा प्रीतोऽभवत् तदा\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2130957, "chapter_id": 3824, "verse_number": "३५", "content_sanskrit": "सर्वे चेमे नरव्याघ्राः पुरन्दरसमौजसः ।\nदेवकार्यं चिकीर्षन् स हृदयेन तुतोष ह \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2130958, "chapter_id": 3824, "verse_number": "३६", "content_sanskrit": "ते पक्षिण इवापेतुर्गिरिशृङ्गं महाजवाः ।\nतस्थुस्तेषां समभ्याशे धनेश्वरपुरःसराः \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2130959, "chapter_id": 3824, "verse_number": "३७", "content_sanskrit": "ततस्तं हृष्टमनसं पाण्डवान् प्रति भारत ।\nसमीक्ष्य यक्षगन्धर्वा निर्विकारमवस्थिताः \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2130960, "chapter_id": 3824, "verse_number": "३८", "content_sanskrit": "पाण्डवाश्च महात्मानः प्रणम्य धनदं प्रभुम् ।\nनकुलः सहदेवश्च धर्मपुत्रश्च धर्मवित्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2130961, "chapter_id": 3824, "verse_number": "३९", "content_sanskrit": "अपराद्धमिवात्मानं मन्यमाना महारथाः ।\nतस्थुः प्राञ्जलयः सर्वे परिवार्य धनेश्वरम्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2130962, "chapter_id": 3824, "verse_number": "४०", "content_sanskrit": "स ह्यासनवरं श्रीमत् पुष्पकं विश्वकर्मणा ।\nविहितं चित्रपर्यन्तमातिष्ठत धनाधिपः \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2130963, "chapter_id": 3824, "verse_number": "४१", "content_sanskrit": "तमासीनं महाकायाः शङ्कुकर्णा महाजवाः ।\nउपोपविविशुर्यक्षा राक्षसाश्च सहस्रशः \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2130964, "chapter_id": 3824, "verse_number": "४२", "content_sanskrit": "शतशश्चापि गन्धर्वास्तथैवाप्सरसां गणाः ।\nपरिवार्योपतिष्ठन्ति यथा देवाः शतक्रतुम्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2130965, "chapter_id": 3824, "verse_number": "४३", "content_sanskrit": "काञ्चनीं शिरसा बिभ्रद् भीमसेनः स्रजं शुभाम् ।\nपाशखड्गधनुष्पाणिरुदैक्षत धनाधिपम्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2130966, "chapter_id": 3824, "verse_number": "४४", "content_sanskrit": "भीमसेनस्य न ग्लानिर्विक्षतस्यापि राक्षसैः ।\nआसीत् तस्यामवस्थायां कुबेरमपि पश्यतः \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2130967, "chapter_id": 3824, "verse_number": "४५", "content_sanskrit": "आददानं शितान् बाणान् योद्धुकाममवस्थितम्।\nदृष्ट्वा भीमं धर्मसुतमब्रवीन्नरवाहनः \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2130968, "chapter_id": 3824, "verse_number": "४६", "content_sanskrit": "विदुस्त्वां सर्वभूतानि पार्थ भूतहिते रतम् ।\nनिर्भयश्चापि शैलाग्रे वस त्वं भ्रातृभिः सह \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2130969, "chapter_id": 3824, "verse_number": "४७", "content_sanskrit": "न च मन्युस्त्वया कार्यो भीमसेनस्य पाण्डव ।\nकालेनैते हताः पूर्वं निमित्तमनुजस्तव \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2130970, "chapter_id": 3824, "verse_number": "४८", "content_sanskrit": "व्रीडा चात्र न कर्तव्या साहसं यदिदं कृतम् ।\nदृष्टश्चापि सुरैः पूर्वं विनाशो यक्षरक्षसाम्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2130971, "chapter_id": 3824, "verse_number": "४९", "content_sanskrit": "न भीमसेने कोपो मे प्रीतोऽस्मि भरतर्षभ ।\nकर्मणा भीमसेनस्य मम तुष्टिरभूत् पुरा\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2130972, "chapter_id": 3824, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2130973, "chapter_id": 3824, "verse_number": "५०", "content_sanskrit": "एवमुक्त्वा तु राजानं भीमसेनमभाषत \t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2130974, "chapter_id": 3824, "verse_number": "५१", "content_sanskrit": "नैतन्मनसि मे तात वर्तते कुरुसत्तम ।\nयदिदं साहसं भीम कृष्णार्थे कृतवानसि\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2130975, "chapter_id": 3824, "verse_number": "५२", "content_sanskrit": "मामनादृत्य देवांश्च विनाशं यक्षरक्षसाम् ।\nस्वबाहुबलमाश्रित्य तेनाहं प्रीतिमांस्त्वयि ।\nशापादद्य विनिर्मुक्तो घोरादस्मि वृकोदर\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2130976, "chapter_id": 3824, "verse_number": "५३", "content_sanskrit": "अहं पूर्वमगस्त्येन क्रुद्धेन परमर्षिणा ।\nशप्तोऽपराधे कस्मिंश्चित् तस्यैषा निष्कृतिः कृता\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2130977, "chapter_id": 3824, "verse_number": "५४", "content_sanskrit": "दृष्टो हि मम सङ्क्लेशः पुरा पाण्डवनन्दन ।\nन तवात्रापराधोऽस्ति कथञ्चिदपि पाण्डव \t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2130978, "chapter_id": 3824, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2130979, "chapter_id": 3824, "verse_number": "५५", "content_sanskrit": "कथं शप्तोऽसि भगवन्नगस्त्येन महात्मना ।\nश्रोतुमिच्छाम्यहं देव तवैतच्छापकारणम्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2130980, "chapter_id": 3824, "verse_number": "५६", "content_sanskrit": "इदं चाश्चर्यभूतं मे यत् क्रोधात् तस्य धीमतः ।\nतदैव त्वं न निर्दग्धः सबलः सपदानुगः\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2130981, "chapter_id": 3824, "verse_number": "", "content_sanskrit": "धनेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2130982, "chapter_id": 3824, "verse_number": "५७", "content_sanskrit": "देवतानामभून्मन्त्रः कुशवत्यां नरेश्वर\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2130983, "chapter_id": 3824, "verse_number": "५८", "content_sanskrit": "वृतस्तत्राहमगमं महापद्मशतैस्त्रिभिः ।\nयक्षाणां घोररूपाणां विविधायुधधारिणाम् ।\nअध्वन्यहमथापश्यमगस्त्यमृषिसत्तमम् \t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2130984, "chapter_id": 3824, "verse_number": "५९", "content_sanskrit": "उग्रं तपस्तप्यमानं यमुनातीरमाश्रितम् ।\nनानापक्षिगणाकीर्णं पुष्पितद्रुमशोभितम् \t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2130985, "chapter_id": 3824, "verse_number": "६०", "content_sanskrit": "तमूर्ध्वबाहुं दृष्ट्वैव सूर्यस्याभिमुखे स्थितम् ।\nतेजोराशि दीप्यमानं हुताशनमिवैधितम्\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2130986, "chapter_id": 3824, "verse_number": "६१", "content_sanskrit": "राक्षसाधिपतिः श्रीमान् मणिमान्नाम मे सखा ।\nमौर्ख्यादज्ञानभावाच्च दर्पान्मोहाच्च पार्थिव \t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2130987, "chapter_id": 3824, "verse_number": "६२", "content_sanskrit": "न्यष्ठीवदाकाशगतो महर्षेस्तस्य मूर्धनि ।\nततः क्रुद्धः स भगवानुवाचेदं तपोधनः \t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2130988, "chapter_id": 3824, "verse_number": "६३", "content_sanskrit": "मामवज्ञाय दुष्टात्मा यस्मादेष सखा तव ।\nधर्षणां कृतवानेतां पश्यतस्ते धनेश्वर\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2130989, "chapter_id": 3824, "verse_number": "६४", "content_sanskrit": "तस्मात् सहैभिः सैन्यैस्ते वधं प्राप्स्यति मानुषात् ।\nत्वं चाप्येभिर्हतैः सैन्यैः क्लेशं प्राप्येह दुर्मतिः \t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2130990, "chapter_id": 3824, "verse_number": "६५", "content_sanskrit": "तमेव मानुषं दृष्ट्वा किल्बिषाद् विप्रमोक्ष्यसे\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2130991, "chapter_id": 3824, "verse_number": "६६", "content_sanskrit": "सैन्यानां तु तवैतेषां पुत्रपौत्रबलान्वितम् ।\nन शापं प्राप्स्यते घोरं तत्तवाज्ञां करिष्यति\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2130992, "chapter_id": 3824, "verse_number": "", "content_sanskrit": "कुबेरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2130993, "chapter_id": 3824, "verse_number": "६७", "content_sanskrit": "एष शापो मया प्राप्तः प्राक्तस्मादृषिसत्तमात् ।\nस भीमेन महाराज भ्रात्रा तव विमोक्षितः \t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2130994, "chapter_id": 3824, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि सप्तपञ्चाशदधिकशततमोऽध्यायः ॥ १५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2130995, "chapter_id": 3824, "verse_number": "४", "content_sanskrit": "यक्षयुद्धपर्वणि चतुर्थोऽध्यायः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}]