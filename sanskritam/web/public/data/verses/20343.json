[{"id": 7000343000, "chapter_id": 20343, "verse_number": "२-१५-१", "content_sanskrit": "सोमशर्मोवाच ।\nपापिनां मरणं भद्रे कीदृशैर्लक्षणैर्युतम् ।\nतन्मे त्वं विस्तराद्ब्रूहि यदि जानासि भामिनि॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000343001, "chapter_id": 20343, "verse_number": "२-१५-२", "content_sanskrit": "सुमनोवाच ।\nश्रूयतामभिधास्यामि तस्मात्सिद्धाच्छ्रुतं मया ।\nपापिनां मरणे कांत यादृशं लिंगमेव च॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000343002, "chapter_id": 20343, "verse_number": "२-१५-३", "content_sanskrit": "महापातकिनां चैव स्थानं चेष्टां वदाम्यहम् ।\nविण्मूत्रामेध्यसंयुक्तां भूमिं पापसमन्विताम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000343003, "chapter_id": 20343, "verse_number": "२-१५-४", "content_sanskrit": "सतां प्राप्य सुदुष्टात्मा प्राणान्दुःखेन मुंचति ।\nचांडालभूमिं संप्राप्य मरणं याति दुःस्थितः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000343004, "chapter_id": 20343, "verse_number": "२-१५-५", "content_sanskrit": "गर्दभाचरितां भूमिं वेश्यागेहं समाश्रितः ।\nकल्पपालगृहं गत्वा निधनायोपगच्छति॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000343005, "chapter_id": 20343, "verse_number": "२-१५-६", "content_sanskrit": "अस्थिचर्मनखैः पूर्णमाश्रितं पापकिल्बिषैः ।\nतां प्राप्य च स दुष्टात्मा मृत्युं याति सुनिश्चितम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000343006, "chapter_id": 20343, "verse_number": "२-१५-७", "content_sanskrit": "अन्यां पापसमाचारां प्राप्य मृत्युं स गच्छति ।\nअथ चेष्टां प्रवक्ष्यामि दूतानां तु तमिच्छताम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000343007, "chapter_id": 20343, "verse_number": "२-१५-८", "content_sanskrit": "भैरवान्दारुणान्घोरानतिकृष्णान्महोदरान् ।\nपिंगाक्षान्पीतनीलांश्च अतिश्वेतान्महोदरान्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000343008, "chapter_id": 20343, "verse_number": "२-१५-९", "content_sanskrit": "अत्युच्चान्विकरालांश्च शुष्कमांसवसोपमान् ।\nरौद्रदंष्ट्रान्करालांश्च सिंहास्यान्सर्पहस्तकान्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000343009, "chapter_id": 20343, "verse_number": "२-१५-१०", "content_sanskrit": "सतान्दृष्ट्वा प्रकंपेत खिद्यते च मुहुर्मुहुः ।\nशिवासंनादवद्घोरान्महारावान्महामते॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000343010, "chapter_id": 20343, "verse_number": "२-१५-११", "content_sanskrit": "मुंचंति दूतकाः सर्वे कर्णमूले तु तस्य हि ।\nगले पाशैः प्रबद्ध्वा ते कटिं बद्ध्वा तथोदरे॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000343011, "chapter_id": 20343, "verse_number": "२-१५-१२", "content_sanskrit": "समाधृष्य निपात्यंते हाहेति वदते मुहुः ।\nम्रियमाणस्य या चेष्टा तामेवं प्रवदाम्यहम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000343012, "chapter_id": 20343, "verse_number": "२-१५-१३", "content_sanskrit": "परद्रव्यापहरणं परभार्याविडंबनम् ।\nऋणं परस्य सर्वस्वं गृहीतं यत्तु पापिभिः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000343013, "chapter_id": 20343, "verse_number": "२-१५-१४", "content_sanskrit": "पुनर्नैव प्रदत्तं हि लोभास्वादविमोहतः ।\nअन्यदेवं महापापं कुप्रतिग्रहमेव च॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000343014, "chapter_id": 20343, "verse_number": "२-१५-१५", "content_sanskrit": "कंठमायांति ते सर्वे म्रियमाणस्य तस्य च ।\nयानिकानि च पापानि पूर्वमेव कृतानि च॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000343015, "chapter_id": 20343, "verse_number": "२-१५-१६", "content_sanskrit": "आयांति कंठमूलं ते महापापस्य नान्यथा ।\nदुःखमुत्पादयंत्येते कफबंधेन दारुणम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000343016, "chapter_id": 20343, "verse_number": "२-१५-१७", "content_sanskrit": "पीडाभिर्दारुणाभिस्तु कंठो घुरघुरायते ।\nरोदते कंपतेऽत्यर्थं मातरं पितरं पुनः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000343017, "chapter_id": 20343, "verse_number": "२-१५-१८", "content_sanskrit": "स्मरते भ्रातरं तत्र भार्यां पुत्रान्पुनःपुनः ।\nपुनर्विस्मरणं याति महापापेन मोहितः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000343018, "chapter_id": 20343, "verse_number": "२-१५-१९", "content_sanskrit": "तस्य प्राणान गच्छंति बहुपीडासमाकुलाः ।\nपतते कंपते चैव मूर्च्छते च पुनःपुनः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000343019, "chapter_id": 20343, "verse_number": "२-१५-२०", "content_sanskrit": "एवं पीडासमायुक्तो दुःखं भुंक्तेति मोहितः ।\nतस्य प्राणाः सुदुःखेन महाकष्टैः प्रचालिताः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000343020, "chapter_id": 20343, "verse_number": "२-१५-२१", "content_sanskrit": "अपानमार्गमाश्रित्य शृणु कांत प्रयांति ते ।\nएवं प्राणी महामुग्धो लोभमोहसमन्वितः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000343021, "chapter_id": 20343, "verse_number": "२-१५-२२", "content_sanskrit": "नीयते यमदूतैस्तु तस्य दुःखं वदाम्यहम्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]