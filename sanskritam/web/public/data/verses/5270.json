[{"id": 2200432, "chapter_id": 5270, "verse_number": "", "content_sanskrit": "कपिलगवां श्रेष्ठ्यै निमित्तकथनम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2200433, "chapter_id": 5270, "verse_number": "", "content_sanskrit": "शुकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2200434, "chapter_id": 5270, "verse_number": "१", "content_sanskrit": "नानावर्णैरुपेतानां गवां किं मुनिसत्तम ।\nकपिलाः सर्ववर्णेषु वरिष्ठत्वमवाप्नुवन्\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2200435, "chapter_id": 5270, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2200436, "chapter_id": 5270, "verse_number": "२", "content_sanskrit": "शृणु पुत्र यथा गोषु वरिष्ठाः कपिलाः स्मृताः ।\nकपिलत्वं च सम्प्राप्ताः पूज्याश्च सततं नृषु\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2200437, "chapter_id": 5270, "verse_number": "३", "content_sanskrit": "अग्निः पुराऽपचक्राम देवेभ्य इति नः श्रुतम् ।\nदेवेभ्यो मां छादयत शरण्याः शरणं गतम्\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2200438, "chapter_id": 5270, "verse_number": "४", "content_sanskrit": "ऊचुस्ताः सहितास्तत्र स्वागतं तव पावक ।\nइह गुप्तस्त्वमस्माभिर्न देवैरुपलप्स्यसे\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2200439, "chapter_id": 5270, "verse_number": "५", "content_sanskrit": "अथ देवा विवित्सन्तः पावकं परिचक्रमुः ।\nगोषु गुप्तं च विज्ञाय ताः क्षिप्रमुपतस्थिरे\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2200440, "chapter_id": 5270, "verse_number": "६", "content_sanskrit": "युष्मासु निवसत्यग्निरिति गाः समचूचुदन् ।\nप्रकाश्यतां हुतवहो लोकान् न च्छेत्तुमर्हथ\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2200441, "chapter_id": 5270, "verse_number": "७", "content_sanskrit": "एवमस्त्वित्यनुज्ञाय पावकं समदर्शयन्\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2200442, "chapter_id": 5270, "verse_number": "८", "content_sanskrit": "अधिगम्य पावकं तुष्टास्ते देवाः सद्य एव तु ।\nअग्निं प्रचोदयामासुः क्रियतां गोष्वनुग्रहः\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2200443, "chapter_id": 5270, "verse_number": "९", "content_sanskrit": "गवां तु यासां गात्रेषु पावकः समवस्थितः ।\nकपिलत्वमनुप्राप्ताः सर्वश्रेष्ठत्वमेव च ।\nमहाफलत्वं लोके च ददौ तासां हुताशनः\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2200444, "chapter_id": 5270, "verse_number": "१०", "content_sanskrit": "तस्माद्धि सर्ववर्णानां कपिलां गां प्रदापय ।\nश्रोत्रियाय प्रशान्ताय प्रयतायाग्निहोत्रिणे\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2200445, "chapter_id": 5270, "verse_number": "११", "content_sanskrit": "यावन्ति रोमाणि भवन्ति धेन्वा\nयुगानि तावन्ति पुनाति दातॄन् ।\nप्रतिग्रहीतॄंश्च पुनाति दत्ता\nशिष्टे तु गौर्वै प्रतिपादनेन \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2200446, "chapter_id": 5270, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे कपिलाश्रैष्ठ्यकथनं नाम एकविंशत्यधिकशततमोऽध्यायः ॥१२१॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]