[{"id": 5000209000, "chapter_id": 9209, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे त्रयोदशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000209001, "chapter_id": 9209, "verse_number": "३-१३-१", "content_sanskrit": "राम प्रीतोऽस्मि भद्रं ते परितुष्टोऽस्मि लक्ष्मण।\nअभिवादयितुं यन्मां प्राप्तौ स्थः सह सीतया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000209002, "chapter_id": 9209, "verse_number": "३-१३-२", "content_sanskrit": "अध्वश्रमेण वां खेदो बाधते प्रचुरश्रमः।\nव्यक्तमुत्कण्ठते वापि मैथिली जनकात्मजा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000209003, "chapter_id": 9209, "verse_number": "३-१३-३", "content_sanskrit": "एषा च सुकुमारी च खेदैश्च न विमानिता।\nप्राज्यदोषं वनं प्राप्ता भर्तृस्नेहप्रचोदिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000209004, "chapter_id": 9209, "verse_number": "३-१३-४", "content_sanskrit": "यथैषा रमते राम इह सीता तथा कुरु।\nदुष्करं कृतवत्येषा वने त्वामभिगच्छती ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000209005, "chapter_id": 9209, "verse_number": "३-१३-५", "content_sanskrit": "एषा हि प्रकृतिः स्त्रीणामासृष्टे रघुनन्दन।\nसमस्थमनुरज्यन्ते विषमस्थं त्यजन्ति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000209006, "chapter_id": 9209, "verse_number": "३-१३-६", "content_sanskrit": "शतह्रदानां लोलत्वं शस्त्राणां तीक्ष्णतां तथा।\nगरुडानिलयोः शैघ्र्यमनुगच्छन्ति योषितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000209007, "chapter_id": 9209, "verse_number": "३-१३-७", "content_sanskrit": "इयं तु भवतो भार्या दोषैरेतैर्विवर्जिता।\nश्लाघ्या च व्यपदेश्या च यथा देवीष्वरुन्धती ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000209008, "chapter_id": 9209, "verse_number": "३-१३-८", "content_sanskrit": "अलंकृतोऽयं देशश्च यत्र सौमित्रिणा सह।\nवैदेह्या चानया राम वत्स्यसि त्वमरिंदम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000209009, "chapter_id": 9209, "verse_number": "३-१३-९", "content_sanskrit": "एवमुक्तस्तु मुनिना राघवः संयताञ्जलिः।\nउवाच प्रश्रितं वाक्यमृषिं दीप्तमिवानलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000209010, "chapter_id": 9209, "verse_number": "३-१३-१०", "content_sanskrit": "धन्योऽस्म्यनुगृहीतोऽस्मि यस्य मे मुनिपुंगवः।\nगुणैः सभ्रातृभार्यस्य गुरुर्नः परितुष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000209011, "chapter_id": 9209, "verse_number": "३-१३-११", "content_sanskrit": "किं तु व्यादिश मे देशं सोदकं बहुकाननम्।\nयत्राश्रमपदं कृत्वा वसेयं निरतः सुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000209012, "chapter_id": 9209, "verse_number": "३-१३-१२", "content_sanskrit": "ततोऽब्रवीन्मुनिश्रेष्ठः श्रुत्वा रामस्य भाषितम्।\nध्यात्वा मुहूर्तं धर्मात्मा ततोवाच वचः शुभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000209013, "chapter_id": 9209, "verse_number": "३-१३-१३", "content_sanskrit": "इतो द्वियोजने तात बहुमूलफलोदकः।\nदेशो बहुमृगः श्रीमान् पञ्चवट्यभिविश्रुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000209014, "chapter_id": 9209, "verse_number": "३-१३-१४", "content_sanskrit": "तत्र गत्वाऽऽश्रमपदं कृत्वा सौमित्रिणा सह।\nरमस्व त्वं पितुर्वाक्यं यथोक्तमनुपालयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000209015, "chapter_id": 9209, "verse_number": "३-१३-१५", "content_sanskrit": "विदितो ह्येष वृत्तान्तो मम सर्वस्तवानघ।\nतपसश्च प्रभावेण स्नेहाद् दशरथस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000209016, "chapter_id": 9209, "verse_number": "३-१३-१६", "content_sanskrit": "हृदयस्थं च ते च्छन्दो विज्ञातं तपसा मया।\nइह वासं प्रतिज्ञाय मया सह तपोवने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000209017, "chapter_id": 9209, "verse_number": "३-१३-१७", "content_sanskrit": "अतश्च त्वामहं ब्रूमि गच्छ पञ्चवटीमिति।\nस हि रम्यो वनोद्देशो मैथिली तत्र रंस्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000209018, "chapter_id": 9209, "verse_number": "३-१३-१८", "content_sanskrit": "स देशः श्लाघनीयश्च नातिदूरे च राघव।\nगोदावर्याः समीपे च मैथिली तत्र रंस्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000209019, "chapter_id": 9209, "verse_number": "३-१३-१९", "content_sanskrit": "प्राज्यमूलफलैश्चैव नानाद्विजगणैर्युतः।\nविविक्तश्च महाबाहो पुण्यो रम्यस्तथैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000209020, "chapter_id": 9209, "verse_number": "३-१३-२०", "content_sanskrit": "भवानपि सदाचारः शक्तश्च परिरक्षणे।\nअपि चात्र वसन् राम तापसान् पालयिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000209021, "chapter_id": 9209, "verse_number": "३-१३-२१", "content_sanskrit": "एतदालक्ष्यते वीर मधूकानां महावनम्।\nउत्तरेणास्य गन्तव्यं न्यग्रोधमपि गच्छता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000209022, "chapter_id": 9209, "verse_number": "३-१३-२२", "content_sanskrit": "ततः स्थलमुपारुह्य पर्वतस्याविदूरतः।\nख्यातः पञ्चवटीत्येव नित्यपुष्पितकाननः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000209023, "chapter_id": 9209, "verse_number": "३-१३-२३", "content_sanskrit": "अगस्त्येनैवमुक्तस्तु रामः सौमित्रिणा सह।\nसत्कृत्यामन्त्रयामास तमृषिं सत्यवादिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000209024, "chapter_id": 9209, "verse_number": "३-१३-२४", "content_sanskrit": "तौ तु तेनाभ्यनुज्ञातौ कृतपादाभिवन्दनौ।\nतमाश्रमं पञ्चवटीं जग्मतुः सह सीतया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000209025, "chapter_id": 9209, "verse_number": "३-१३-२५", "content_sanskrit": "गृहीतचापौ तु नराधिपात्मजौ\nविषक्ततूणी समरेष्वकातरौ।\nयथोपदिष्टेन पथा महर्षिणा\nप्रजग्मतुः पञ्चवटीं समाहितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000209026, "chapter_id": 9209, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे त्रयोदशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]