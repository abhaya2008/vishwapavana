[{"id": 40018919, "chapter_id": 9299, "verse_number": "1", "content_sanskrit": "अथसंस्मारयामासमातलिराघवंतदा । अजानन्निवकिंवीरत्वमेनमनुवर्तसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40018920, "chapter_id": 9299, "verse_number": "2", "content_sanskrit": "विसृजास्मैवधायत्वमस्त्रंपैतामहंप्रभो । विनाशकालःकथितोःयःसुरैःसोऽद्यवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40018921, "chapter_id": 9299, "verse_number": "3", "content_sanskrit": "ततःसंस्मारितोरामस्तेनवाक्येनमातलेः । जग्राह स शरंदीप्तंनिःश्वसन्तमिवोरगम् ॥ यंतस्मैप्रथमंप्रादादगस्त्योभगवानृषिः । ब्रह्मदत्तंमहाबाणममोघंयुधिवीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40018922, "chapter_id": 9299, "verse_number": "4", "content_sanskrit": "ततःसंस्मारितोरामस्तेनवाक्येनमातलेः । जग्राह स शरंदीप्तंनिःश्वसन्तमिवोरगम् ॥ यंतस्मैप्रथमंप्रादादगस्त्योभगवानृषिः । ब्रह्मदत्तंमहाबाणममोघंयुधिवीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40018923, "chapter_id": 9299, "verse_number": "5", "content_sanskrit": "ब्रह्मणानिर्मितंपूर्वमिन्द्रार्थममितौजसा । दत्तंसुरपतेःपूर्वंत्रिलोकजयकाङ्क्षिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40018924, "chapter_id": 9299, "verse_number": "6", "content_sanskrit": "यस्यवाजेषुपवनःफलेपावकभास्करौ । शरीरमाकाशमयंगौरवेमेरुमन्दरौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40018925, "chapter_id": 9299, "verse_number": "7", "content_sanskrit": "जाज्वल्यमानंवपुषासुपुङ्खंहेमभूषितम् । तेजसासर्वभूतानांकृतंभास्करवर्चसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40018926, "chapter_id": 9299, "verse_number": "8", "content_sanskrit": "सधूममिवकालानगिंदीप्तमाशीविषोपमम् । नरनागाश्ववृद्धानांभेदनंक्षिप्रकारिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40018927, "chapter_id": 9299, "verse_number": "9", "content_sanskrit": "द्वाराणांपरिघाणां च गिरीणांचापिभेदनम् । नानारुधिरदिग्धाङ्गंमेदोदिग्धंसुदारुणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40018928, "chapter_id": 9299, "verse_number": "10", "content_sanskrit": "वज्रसारंमहानादंनानासमितिदारणम् । सर्ववित्रासनंभीमंश्वसन्तमिवपन्नगम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40018929, "chapter_id": 9299, "verse_number": "11", "content_sanskrit": "कङ्कगृध्रबकानां च गोमायुगणरक्षसाम् । नित्यंभक्षप्रदंयुद्धेयमरूपंभयापहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40018930, "chapter_id": 9299, "verse_number": "12", "content_sanskrit": "नन्दनंवानरेन्द्राणांरक्षसामवसादनम् । वाजितंविविधैर्वाजैश्चारुचित्रैर्गरुत्मतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40018931, "chapter_id": 9299, "verse_number": "13", "content_sanskrit": "तमुत्तमेषुंलोकानामिक्ष्वाकुभयनाशनम् । द्विषतांकीर्तिहरणंप्रहर्षकरमात्मनः ॥ अभिम्नत्यततोरामस्तंमहेषुंमहाबलः । वेदप्रोक्तेनविधिनासन्दधेकार्मुकेबली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40018932, "chapter_id": 9299, "verse_number": "14", "content_sanskrit": "तमुत्तमेषुंलोकानामिक्ष्वाकुभयनाशनम् । द्विषतांकीर्तिहरणंप्रहर्षकरमात्मनः ॥ अभिम्नत्यततोरामस्तंमहेषुंमहाबलः । वेदप्रोक्तेनविधिनासन्दधेकार्मुकेबली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40018933, "chapter_id": 9299, "verse_number": "15", "content_sanskrit": "तस्मिन् सधनीयमानेतुराघवेणशरोत्तमे । सर्वभूतानिसन्त्रेसुश्चचाल च वसुन्धरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40018934, "chapter_id": 9299, "verse_number": "16", "content_sanskrit": "स रावणायसङ्रुद्धोभृशमायम्यकार्मुकम् । चिक्षेपपरमायत्तःशरंमर्मविदारणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40018935, "chapter_id": 9299, "verse_number": "17", "content_sanskrit": "स वज्रइवदुर्धर्षोवज्रिबाहुविसर्जितः । कृतान्तइवचावार्योन्यपतद्रावणोरसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40018936, "chapter_id": 9299, "verse_number": "18", "content_sanskrit": "स विसृष्टोमहावेगश्शरीरान्तकरश्शरः । चिच्छेदहृदयंतस्यरावणस्यदुरात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40018937, "chapter_id": 9299, "verse_number": "19", "content_sanskrit": "रुधिराक्तस्सवेगेनशरीरान्तकरःशरः । रावणस्यहरन्प्राणान्विवेशधरणीतलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40018938, "chapter_id": 9299, "verse_number": "20", "content_sanskrit": "स शरोरावणंहत्वारुधिरार्द्रीकृतच्छविः । कृतकर्मानिभृतवत्स्वतूणींपुनराविशत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40018939, "chapter_id": 9299, "verse_number": "21", "content_sanskrit": "तस्यहस्ताद्धतस्याशुकार्मुकं च ससायकम् । निपपातसहप्राणैर्भ्रश्यमानस्यजीवितात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40018940, "chapter_id": 9299, "verse_number": "22", "content_sanskrit": "गतासुर्भीमवेगस्तुनैरृतेन्द्रोमहाद्युतिः । पपातस्यन्दनाद्भूमौवृत्रोवज्रहतोयथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40018941, "chapter_id": 9299, "verse_number": "23", "content_sanskrit": "तंदृष्टवापतितंभूमौहतशेषानिशाचराः । हतनाधाभयत्रस्तास्सर्वतस्सम्प्रदुद्रुवुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40018942, "chapter_id": 9299, "verse_number": "24", "content_sanskrit": "सर्वतश्चाभिपेतुस्तान्वानराद्रुमयोधिनः । दशग्रीववधंदृष्टवावानराजितकाशिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40018943, "chapter_id": 9299, "verse_number": "25", "content_sanskrit": "अर्दितावानरैर्भ्रष्टालङ्कामभ्यपतन् भयात् । हताश्रयात्वात्करुणैर्भाष्पप्रस्रवणैर्मुखैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40018944, "chapter_id": 9299, "verse_number": "26", "content_sanskrit": "ततोविनेदुःसम्हृष्टावानराःजितकाशिनः । वदन्तोराघवजयंरावणस्य ज तद्वधम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40018945, "chapter_id": 9299, "verse_number": "27", "content_sanskrit": "अथान्तरिक्षेव्यनदत्सौम्यस्त्रिदशदुन्धुभिः । दिव्यगन्धशहस्तत्रमारुतस्सुसुकोववौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40018946, "chapter_id": 9299, "verse_number": "28", "content_sanskrit": "निपपातान्तरिक्षाच्चपुष्पवृष्टिस्तदाभुवि । किरन्तीराघवरथंदुरवापामनोहरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40018947, "chapter_id": 9299, "verse_number": "29", "content_sanskrit": "राघवस्तवसंयुक्तागगने च विशुश्रुवे । साधुसाध्वितिवागग्य्रादेवतानांमहात्मनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40018948, "chapter_id": 9299, "verse_number": "30", "content_sanskrit": "अविवेशमहान् हर्षोदेवानांचारणैःसह । रावणेनिहतेरौद्रेसर्वलोकभयङ्करे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40018949, "chapter_id": 9299, "verse_number": "31", "content_sanskrit": "ततःसकामंसुग्रीवमङ्गदं च विभीषणम् । चकारराघवःप्रीतोहत्वाराक्षसपुङ्गवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40018950, "chapter_id": 9299, "verse_number": "32", "content_sanskrit": "ततःप्रजग्मुःप्रशमंमरुद्गणादिशःप्रसेदुर्विमलंनभोऽभवत् । महीचकम्पे न च मारुतोववौस्थिरप्रभश्चाप्यभवद्दिवाकरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40018951, "chapter_id": 9299, "verse_number": "33", "content_sanskrit": "ततस्तुसुग्रीवविभीषणाङ्गदाःसुहृद्विशिष्टास्सहलक्ष्मणास्तदा । समेत्यहृष्टाविजयेनराघवंरणेऽभिरामंविधिनाभ्यपूजयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]