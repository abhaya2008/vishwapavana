[{"id": 5000299000, "chapter_id": 9299, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे किष्किन्धाकाण्डे सप्तविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000299001, "chapter_id": 9299, "verse_number": "४-२७-१", "content_sanskrit": "अभिषिक्ते तु सुग्रीवे प्रविष्टे वानरे गुहाम्।\nआजगाम सह भ्रात्रा रामः प्रस्रवणं गिरिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000299002, "chapter_id": 9299, "verse_number": "४-२७-२", "content_sanskrit": "शार्दूलमृगसंघुष्टं सिंहैर्भीमरवैर्वृतम्।\nनानागुल्मलतागूढं बहुपादपसंकुलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000299003, "chapter_id": 9299, "verse_number": "४-२७-३", "content_sanskrit": "ऋक्षवानरगोपुच्छैर्मार्जारैश्च निषेवितम्।\nमेघराशिनिभं शैलं नित्यं शुचिकरं शिवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000299004, "chapter_id": 9299, "verse_number": "४-२७-४", "content_sanskrit": "तस्य शैलस्य शिखरे महतीमायतां गुहाम्।\nप्रत्यगृह्णीत वासार्थं रामः सौमित्रिणा सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000299005, "chapter_id": 9299, "verse_number": "४-२७-५", "content_sanskrit": "कृत्वा च समयं रामः सुग्रीवेण सहानघः।\nकालयुक्तं महद्वाक्यमुवाच रघुनन्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000299006, "chapter_id": 9299, "verse_number": "४-२७-६", "content_sanskrit": "विनीतं भ्रातरं भ्राता लक्ष्मणं लक्ष्मिवर्धनम्।\nइयं गिरिगुहा रम्या विशाला युक्तमारुता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000299007, "chapter_id": 9299, "verse_number": "४-२७-७", "content_sanskrit": "अस्यां वत्स्याम सौमित्रे वर्षरात्रमरिंदम।\nगिरिशृङ्गमिदं रम्यमुत्तमं पार्थिवात्मज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000299008, "chapter_id": 9299, "verse_number": "४-२७-८", "content_sanskrit": "श्वेताभिः कृष्णताम्राभिः शिलाभिरुपशोभितम्।\nनानाधातुसमाकीर्णं नदीदर्दुरसंयुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000299009, "chapter_id": 9299, "verse_number": "४-२७-९", "content_sanskrit": "विविधैर्वृक्षषण्डैश्च चारुचित्रलतायुतम्।\nनानाविहगसंघुष्टं मयूरवरनादितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000299010, "chapter_id": 9299, "verse_number": "४-२७-१०", "content_sanskrit": "मालतीकुन्दगुल्मैश्च सिन्दुवारैः शिरीषकैः।\nकदम्बार्जुनसर्जैश्च पुष्पितैरुपशोभितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000299011, "chapter_id": 9299, "verse_number": "४-२७-११", "content_sanskrit": "इयं च नलिनी रम्या फुल्लपङ्कजमण्डिता।\nनातिदूरे गुहाया नौ भविष्यति नृपात्मज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000299012, "chapter_id": 9299, "verse_number": "४-२७-१२", "content_sanskrit": "प्रागुदक्प्रवणे देशे गुहा साधु भविष्यति।\nपश्चाच्चैवोन्नता सौम्य निवातेयं भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000299013, "chapter_id": 9299, "verse_number": "४-२७-१३", "content_sanskrit": "गुहाद्वारे च सौमित्रे शिला समतला शिवा।\nकृष्णा चैवायता चैव भिन्नाञ्जनचयोपमा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000299014, "chapter_id": 9299, "verse_number": "४-२७-१४", "content_sanskrit": "गिरिशृङ्गमिदं तात पश्य चोत्तरतः शुभम्।\nभिन्नाञ्जनचयाकारमम्भोधरमिवोदितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000299015, "chapter_id": 9299, "verse_number": "४-२७-१५", "content_sanskrit": "दक्षिणस्यामपि दिशि स्थितं श्वेतमिवाम्बरम्।\nकैलासशिखरप्रख्यं नानाधातुविराजितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000299016, "chapter_id": 9299, "verse_number": "४-२७-१६", "content_sanskrit": "प्राचीनवाहिनीं चैव नदीं भृशमकर्दमाम्।\nगुहायाः परतः पश्य त्रिकूटे जाह्नवीमिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000299017, "chapter_id": 9299, "verse_number": "४-२७-१७", "content_sanskrit": "चन्दनैस्तिलकैः सालैस्तमालैरतिमुक्तकैः।\nपद्मकैः सरलैश्चैव अशोकैश्चैव शोभिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000299018, "chapter_id": 9299, "verse_number": "४-२७-१८", "content_sanskrit": "वानीरैस्तिमिदैश्चैव बकुलैः केतकैरपि।\nहिन्तालैस्तिनिशैर्नीपैर्वेतसैः कृतमालकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000299019, "chapter_id": 9299, "verse_number": "४-२७-१९", "content_sanskrit": "तीरजैः शोभिता भाति नानारूपैस्ततस्ततः।\nवसनाभरणोपेता प्रमदेवाभ्यलंकृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000299020, "chapter_id": 9299, "verse_number": "४-२७-२०", "content_sanskrit": "शतशः पक्षिसङ्घैश्च नानानादविनादिता।\nएकैकमनुरक्तैश्च चक्रवाकैरलंकृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000299021, "chapter_id": 9299, "verse_number": "४-२७-२१", "content_sanskrit": "पुलिनैरतिरम्यैश्च हंससारससेविता।\nप्रहसन्त्येव भात्येषा नानारत्नसमन्विता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000299022, "chapter_id": 9299, "verse_number": "४-२७-२२", "content_sanskrit": "क्वचिन्नीलोत्पलैश्छन्ना भातिरक्तोत्पलैः क्वचित्।\nक्वचिदाभाति शुक्लैश्च दिव्यैः कुमुदकुड्मलैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000299023, "chapter_id": 9299, "verse_number": "४-२७-२३", "content_sanskrit": "पारिप्लवशतैर्जुष्टा बर्हिक्रौञ्चविनादिता।\nरमणीया नदी सौम्य मुनिसङ्घनिषेविता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000299024, "chapter_id": 9299, "verse_number": "४-२७-२४", "content_sanskrit": "पश्य चन्दनवृक्षाणां पङ्‍क्तिः सुरुचिरा इव।\nककुभानां च दृश्यन्ते मनसैवोदिताः समम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000299025, "chapter_id": 9299, "verse_number": "४-२७-२५", "content_sanskrit": "अहो सुरमणीयोऽयं देशः शत्रुनिषूदन।\nदृढं रंस्याव सौमित्रे साध्वत्र निवसावहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000299026, "chapter_id": 9299, "verse_number": "४-२७-२६", "content_sanskrit": "इतश्च नातिदूरे सा किष्किन्धा चित्रकानना।\nसुग्रीवस्य पुरी रम्या भविष्यति नृपात्मज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000299027, "chapter_id": 9299, "verse_number": "४-२७-२७", "content_sanskrit": "गीतवादित्रनिर्घोषः श्रूयते जयतां वर।\nनदतां वानराणां च मृदङ्गाडम्बरैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000299028, "chapter_id": 9299, "verse_number": "४-२७-२८", "content_sanskrit": "लब्ध्वा भार्यां कपिवरः प्राप्य राज्यं सुहृद्‍वृतः।\nध्रुवं नन्दति सुग्रीवः सम्प्राप्य महतीं श्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000299029, "chapter_id": 9299, "verse_number": "४-२७-२९", "content_sanskrit": "इत्युक्त्वा न्यवसत् तत्र राघवः सहलक्ष्मणः।\nबहुदृश्यदरीकुञ्जे तस्मिन् प्रस्रवणे गिरौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000299030, "chapter_id": 9299, "verse_number": "४-२७-३०", "content_sanskrit": "सुसुखे हि बहुद्रव्ये तस्मिन् हि धरणीधरे।\nवसतस्तस्य रामस्य रतिरल्पापि नाभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000299031, "chapter_id": 9299, "verse_number": "४-२७-३१", "content_sanskrit": "हृतां हि भार्यां स्मरतः प्राणेभ्योऽपि गरीयसीम्।\nउदयाभ्युदितं दृष्ट्वा शशाङ्कं च विशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000299032, "chapter_id": 9299, "verse_number": "४-२७-३२", "content_sanskrit": "आविवेश न तं निद्रा निशासु शयनं गतम्।\nतत्समुत्थेन शोकेन बाष्पोपहतचेतनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000299033, "chapter_id": 9299, "verse_number": "४-२७-३३", "content_sanskrit": "तं शोचमानं काकुत्स्थं नित्यं शोकपरायणम्।\nतुल्यदुःखोऽब्रवीद्‍भ्राता लक्ष्मणोऽनुनयं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000299034, "chapter_id": 9299, "verse_number": "४-२७-३४", "content_sanskrit": "अलं वीर व्यथां गत्वा न त्वं शोचितुमर्हसि।\nशोचतो ह्यवसीदन्ति सर्वार्था विदितं हि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000299035, "chapter_id": 9299, "verse_number": "४-२७-३५", "content_sanskrit": "भवान् क्रियापरो लोके भवान् देवपरायणः।\nआस्तिको धर्मशीलश्च व्यवसायी च राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000299036, "chapter_id": 9299, "verse_number": "४-२७-३६", "content_sanskrit": "न ह्यव्यवसितः शत्रुं राक्षसं तं विशेषतः।\nसमर्थस्त्वं रणे हन्तुं विक्रमे जिह्मकारिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000299037, "chapter_id": 9299, "verse_number": "४-२७-३७", "content_sanskrit": "समुन्मूलय शोकं त्वं व्यवसायं स्थिरीकुरु।\nततः सपरिवारं तं राक्षसं हन्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000299038, "chapter_id": 9299, "verse_number": "४-२७-३८", "content_sanskrit": "पृथिवीमपि काकुत्स्थ ससागरवनाचलाम्।\nपरिवर्तयितुं शक्तः किं पुनस्तं हि रावणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000299039, "chapter_id": 9299, "verse_number": "४-२७-३९", "content_sanskrit": "शरत्कालं प्रतीक्षस्व प्रावृट्कालोऽयमागतः।\nततः सराष्ट्रं सगणं रावणं तं वधिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000299040, "chapter_id": 9299, "verse_number": "४-२७-४०", "content_sanskrit": "अहं तु खलु ते वीर्यं प्रसुप्तं प्रतिबोधये।\nदीप्तैराहुतिभिः काले भस्मच्छन्नमिवानलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000299041, "chapter_id": 9299, "verse_number": "४-२७-४१", "content_sanskrit": "लक्ष्मणस्य हि तद् वाक्यं प्रतिपूज्य हितं शुभम्।\nराघवः सुहृदं स्निग्धमिदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000299042, "chapter_id": 9299, "verse_number": "४-२७-४२", "content_sanskrit": "वाच्यं यदनुरक्तेन स्निग्धेन च हितेन च।\nसत्यविक्रमयुक्तेन तदुक्तं लक्ष्मण त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000299043, "chapter_id": 9299, "verse_number": "४-२७-४३", "content_sanskrit": "एष शोकः परित्यक्तः सर्वकार्यावसादकः।\nविक्रमेष्वप्रतिहतं तेजः प्रोत्साहयाम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000299044, "chapter_id": 9299, "verse_number": "४-२७-४४", "content_sanskrit": "शरत्कालं प्रतीक्षिष्ये स्थितोऽस्मि वचने तव।\nसुग्रीवस्य नदीनां च प्रसादमनुपालयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000299045, "chapter_id": 9299, "verse_number": "४-२७-४५", "content_sanskrit": "उपकारेण वीरस्तु प्रतिकारेण युज्यते।\nअकृतज्ञोऽप्रतिकृतो हन्ति सत्त्ववतां मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000299046, "chapter_id": 9299, "verse_number": "४-२७-४६", "content_sanskrit": "तदेव युक्तं प्रणिधाय लक्ष्मणः\nकृताञ्जलिस्तत् प्रतिपूज्य भाषितम्।\nउवाच रामं स्वभिरामदर्शनं\nप्रदर्शयन् दर्शनमात्मनः शुभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000299047, "chapter_id": 9299, "verse_number": "४-२७-४७", "content_sanskrit": "यथोक्तमेतत् तव सर्वमीप्सितं\nनरेन्द्र कर्ता नचिरात् तु वानरः।\nशरत्प्रतीक्षः क्षमतामिमं भवान्\nजलप्रपातं रिपुनिग्रहे धृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000299048, "chapter_id": 9299, "verse_number": "४-२७-४८", "content_sanskrit": "नियम्य कोपं परिपाल्यतां शरत्\nक्षमस्व मासांश्चतुरो मया सह।\nवसाचलेऽस्मिन् मृगराजसेविते\nसंवर्तयन् शत्रुवधे समर्थः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000299049, "chapter_id": 9299, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे सप्तविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]