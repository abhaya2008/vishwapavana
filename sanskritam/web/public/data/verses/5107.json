[{"id": 2193165, "chapter_id": 5107, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2193166, "chapter_id": 5107, "verse_number": "१", "content_sanskrit": "स लब्ध्वा परमं देवाद्वरं सत्यवतीसुतः ।\nअरणीं त्वथ सङ्गृह्यममन्थाग्निचिकीर्षया\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2193167, "chapter_id": 5107, "verse_number": "२", "content_sanskrit": "अथ रूपं परं राजन् बभ्रतीं स्वेन तेजसा ।\nघृताचीं नामाप्सरसमपश्यद्भगवानृषिः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2193168, "chapter_id": 5107, "verse_number": "३", "content_sanskrit": "ऋषिरप्सरसं दृष्ट्वासहसा काममोहितः ।\nअभवद् भगवान् व्यासो वने तस्मिन् युधिष्ठिर\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2193169, "chapter_id": 5107, "verse_number": "४", "content_sanskrit": "सा च कृत्वातदा व्यासं कामसंविग्नमानसम् ।\nशुकी भूत्वामहाराज घृताची समुपागमत्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2193170, "chapter_id": 5107, "verse_number": "५", "content_sanskrit": "स तामप्सरसं दृष्ट्वा रूपेणान्येन संवृताम् ।\nशरीरजेनानुगतः सर्वगात्रातिगेनह\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2193171, "chapter_id": 5107, "verse_number": "६", "content_sanskrit": "स तु धैर्येण महता निगृह्णन् हृच्छयं मुनिः ।\nन शशाक नियन्तुं तद् व्यासः प्रविसृतंमनः॥\nभावित्वाच्चैव भावस्य घृताच्या वपुषा हृतः॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2193172, "chapter_id": 5107, "verse_number": "७", "content_sanskrit": "यत्नान्नियच्छतस्तस्य मुनेरग्निचिकीर्षया ।\nअरण्यामेव सहसा तस्य शुक्रमवापतत्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2193173, "chapter_id": 5107, "verse_number": "८", "content_sanskrit": "सोऽविशङ्केन मनसा तथैव द्विजसत्तमः ।\nअरणीं ममन्थ ब्रह्मर्षिस्तस्यां जज्ञे शुको नृप॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2193174, "chapter_id": 5107, "verse_number": "९", "content_sanskrit": "शुक्रेनिर्मथ्यमाने तु शुको जज्ञेमहातपाः ।\nपरमर्षिर्महायोगी अरणीगर्भसम्भवः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2193175, "chapter_id": 5107, "verse_number": "१०", "content_sanskrit": "यथाध्वरे समिद्धोऽग्निर्भाति हव्यमुपात्तवान् ।\nतथारूपः शुको जज्ञे प्रज्वलन्निव तेजसा\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2193176, "chapter_id": 5107, "verse_number": "११", "content_sanskrit": "बिभ्रत्पितुश्च कौरव्य रूपवर्णमनुत्तमम् ।\nबभौ तदा भावितात्मा विधूमोऽग्निरिव ज्वलन्॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2193177, "chapter_id": 5107, "verse_number": "१२", "content_sanskrit": "तं गङ्गा सरितां श्रेष्ठा मेरुपृष्ठे जनेश्वर ।\nस्वरूपिणी तदाभ्येत्य स्नापयामास वारिणा\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2193178, "chapter_id": 5107, "verse_number": "१३", "content_sanskrit": "अन्तरिक्षाच्च कौरव्य दण्डः कृष्णाजिनं च ह ।\nपपात भुविराजेन्द्र शुकस्यार्थे महात्मनः॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2193179, "chapter_id": 5107, "verse_number": "१४", "content_sanskrit": "जेगीयन्ते स्म गन्धर्वा ननृतुश्चाप्सरोगणाः ।\nदेवदुन्दुभयश्चैव प्रावाद्यन्त महास्वनाः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2193180, "chapter_id": 5107, "verse_number": "१५", "content_sanskrit": "विश्वावसुश्च गन्धर्वस्तथा तुम्बुरुनारदौ ।\nहाहाहूहू च गन्धर्वौ तुष्टुवुःशुकसम्भवम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2193181, "chapter_id": 5107, "verse_number": "१६", "content_sanskrit": "तत्र शक्रपुरोगाश्च लोकपालाः समागताः ।\nदेवा देवर्षयश्चैव तथा ब्रह्मर्षयोऽपि च॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2193182, "chapter_id": 5107, "verse_number": "१७", "content_sanskrit": "दिव्यानि सर्वपुष्पाणि प्रववर्षात्र मारुतः ।\nजङ्गमं स्थावरं चैव प्रहृष्टमभवज्जगत्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2193183, "chapter_id": 5107, "verse_number": "१८", "content_sanskrit": "तं महात्मा स्वयं प्रीत्या देव्या सह महाद्युतिः ।\nजातमात्रंमुनेः पुत्रं विधिनोपानयत्तदा\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2193184, "chapter_id": 5107, "verse_number": "१९", "content_sanskrit": "तस्य देवेश्वरः शक्रो दिव्यमद्भुतदर्शनम् ।\nददौ कमण्डलुं प्रीत्या देववासांसि चाभिभो\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2193185, "chapter_id": 5107, "verse_number": "२०", "content_sanskrit": "हंसाश्च शतपत्राश्च सारसाश्च सहस्रशः ।\nप्रदक्षिणमवर्तन्त शुकाश्चाषाश्च भारत॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2193186, "chapter_id": 5107, "verse_number": "२१", "content_sanskrit": "आरणेयस्तथा दिव्यं प्राप्य जन्म महाद्युतिः ।\nतत्रैवोवास मेधावी व्रतचारीसमाहितः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2193187, "chapter_id": 5107, "verse_number": "२२", "content_sanskrit": "उत्पन्नमात्रं तं वेदाः सरहस्याः ससङ्ग्रहाः ।\nउपतस्थुर्महाराज यथास्य पितरं तथा॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2193188, "chapter_id": 5107, "verse_number": "२३", "content_sanskrit": "बृहस्पतिं तु वव्रे स वेदवेदाङ्गभाष्यवित्।\nउपाध्यायं महाराज धर्ममेवानुचिन्तयन्॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2193189, "chapter_id": 5107, "verse_number": "२४", "content_sanskrit": "सोऽधीत्य वेदानखिलान् सरहस्यान् ससङ्ग्रहान्।\nइतिहासं च कार्त्स्न्येन राजशास्त्राणि चाभिभो॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2193190, "chapter_id": 5107, "verse_number": "२५", "content_sanskrit": "गुरवे दक्षिणां दत्त्वा समावृत्तो महामुनिः ।\nउग्रं तपः समारेभेब्रह्मचारी समाहितः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2193191, "chapter_id": 5107, "verse_number": "२६", "content_sanskrit": "देवतानामृषीणां च बाल्येऽपि स महातपाः ।\nसम्मन्त्रणीयोमान्यश्च ज्ञानेन तपसा तथा\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2193192, "chapter_id": 5107, "verse_number": "२७", "content_sanskrit": "न त्वस्य रमते बुद्धिराश्रमेषु नराधिप ।\nत्रिषु गार्हस्थ्यमूलेषु मोक्षधर्मानुदर्शिनः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2193193, "chapter_id": 5107, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे षट्पञ्चाशोत्तरशततमोऽध्यायः ॥१५६॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]