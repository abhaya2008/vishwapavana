[{"id": 2005765, "chapter_id": 1113, "verse_number": "१-११४-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2005766, "chapter_id": 1113, "verse_number": "१-११४-१", "content_sanskrit": "पुनर्भरतवंशस्य हेतुं सन्तानवृद्धये।\nवक्ष्यामि नियतं मातस्तन्मे निगदतः शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2005767, "chapter_id": 1113, "verse_number": "१-११४-२", "content_sanskrit": "ब्राह्मणो गुणवान्कश्चिद्धनेनोपनिमन्त्र्यताम्।\nविचित्रवीर्यक्षेत्रेषु यः समुत्पादयेत्प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2005768, "chapter_id": 1113, "verse_number": "१-११४-३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2005769, "chapter_id": 1113, "verse_number": "१-११४-३", "content_sanskrit": "भीष्मस्य तु वचः श्रुत्वा धर्महेत्वर्थसंहितम्।\nमाता सत्यवती भीष्मं पुनरेवाभ्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2005770, "chapter_id": 1113, "verse_number": "१-११४-४", "content_sanskrit": "औचथ्यमधिकृत्येदमङ्गं च यदुदाहृतम्।\nपौराणी श्रुतिरित्येषा प्राप्तकालमिदं कुरु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2005771, "chapter_id": 1113, "verse_number": "१-११४-५", "content_sanskrit": "त्वं हि पुत्र कुलस्यास्य ज्येष्ठः श्रेष्ठश्च भारत।\nयथा च ते पितुर्वाक्यं मम कार्यं तथाऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2005772, "chapter_id": 1113, "verse_number": "१-११४-६", "content_sanskrit": "मम पुत्रस्तव भ्राता यवीयान्सुप्रियश्च ते।\nबाल एव गतः स्वर्गं भारतो भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2005773, "chapter_id": 1113, "verse_number": "१-११४-७", "content_sanskrit": "इमे महिष्यौ तस्येह काशिराजसुते उभे।\nरूपयौवनसंपन्ने पुत्रकामे च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2005774, "chapter_id": 1113, "verse_number": "१-११४-८", "content_sanskrit": "धर्म्यमेतत्परं ज्ञात्वा सन्तानाय कुलस्य च।\nआभ्यां मम नियोगात्तु धर्मं चरितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2005775, "chapter_id": 1113, "verse_number": "१-११४-९x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2005776, "chapter_id": 1113, "verse_number": "१-११४-९", "content_sanskrit": "असंशयं परो धर्मस्त्वयाः मातः प्रकीर्तितः।\nत्वमप्येतां प्रतिज्ञां तु वेत्थ या मयि वर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2005777, "chapter_id": 1113, "verse_number": "१-११४-१०", "content_sanskrit": "अमरत्वस्य वा हेतोस्त्रैलोक्यसदनस्य वा।\nउत्सृजेयमहं प्राणान्न तु सत्यं कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2005778, "chapter_id": 1113, "verse_number": "१-११४-११x", "content_sanskrit": "सत्यवत्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2005779, "chapter_id": 1113, "verse_number": "१-११४-११", "content_sanskrit": "जानामि त्वयि धर्मज्ञ सत्यं सत्यपराक्रम।\nइच्छंस्त्वमिह लोकांस्त्रीन्सृजेरन्यानरिन्दम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2005780, "chapter_id": 1113, "verse_number": "१-११४-१२", "content_sanskrit": "यथा तु नः कुलं चैव धर्मश्च न पराभवेत्।\nसुहृदश्च प्रहृष्टाः स्युस्तथा त्वं कर्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2005781, "chapter_id": 1113, "verse_number": "१-११४-१३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2005782, "chapter_id": 1113, "verse_number": "१-११४-१३", "content_sanskrit": "त्वमेव कुलवृद्धासि गौरवं तु परं त्वयि।\nसोपायं कुलसन्ताने वक्तुमर्हसि नः परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2005783, "chapter_id": 1113, "verse_number": "१-११४-१४", "content_sanskrit": "स्त्रियो हि परमं गुह्यं धारयन्ति सदा कुले।\nपुरुषांश्चैव मायाभिर्बह्वीभिरुपगृह्णते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2005784, "chapter_id": 1113, "verse_number": "१-११४-१५", "content_sanskrit": "सा सत्यवति संपश्य धर्मं सत्यपरायणे।\nयथा न जह्यां सत्यं च न सीदेच्च कुलं हि नः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2005785, "chapter_id": 1113, "verse_number": "१-११४-१६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2005786, "chapter_id": 1113, "verse_number": "१-११४-१६", "content_sanskrit": "ततः सत्यवती भीष्मं वाचा संसज्जमानया।\nविहसन्तीव सव्रीडमिदं वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2005787, "chapter_id": 1113, "verse_number": "१-११४-१७", "content_sanskrit": "सत्यमेतन्महाबाहो यथा वदसि भारत।\nविश्वासात्ते प्रवक्ष्यामि सन्तानाय कुलस्य नः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2005788, "chapter_id": 1113, "verse_number": "१-११४-१८", "content_sanskrit": "न ते शक्यमनाख्यातुमापद्धर्मं तथाविधम्।\nत्वमेव नः कुले धर्मस्त्वं सत्यं त्वं परा गतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2005789, "chapter_id": 1113, "verse_number": "१-११४-१९", "content_sanskrit": "यत्त्वं वक्ष्यसि तत्कार्यमस्माभिरिति मे मतिः।\nतस्मान्निशम्य सत्यं मे कुरुष्व यदनन्तरम्।\nशृणु भीष्म वचो मह्यं धर्मार्थसहितं हितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2005790, "chapter_id": 1113, "verse_number": "१-११४-२०", "content_sanskrit": "न च विस्रम्भकथितं भवान्सूचितुमर्हति।\nयस्तु राजा वसुर्नाम श्रुतस्ते भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2005791, "chapter_id": 1113, "verse_number": "१-११४-२१", "content_sanskrit": "तस्य शुक्लादहं मत्स्या धृता कुक्षौ पुरा किल।\nमातरं मे जलाद्धृत्वा दाशः परमधर्मवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2005792, "chapter_id": 1113, "verse_number": "१-११४-२२", "content_sanskrit": "मां तु स्वगृहमानीय दुहितृत्वेऽभ्यकल्पयत्।\nधर्मयुक्तः स धर्मेण पिता चासीत्ततो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2005793, "chapter_id": 1113, "verse_number": "१-११४-२३", "content_sanskrit": "धर्मयुक्तस्य धर्मार्थं पितुरासीत्तरी मम।\nसा कदाचिदहं तत्र गता प्रथमयौवनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2005794, "chapter_id": 1113, "verse_number": "१-११४-२४", "content_sanskrit": "अथ धर्मविदां श्रेष्ठः परमर्षिः पराशरः।\nआजगाम तरीं धीमांस्तरिष्यन्यमुनां नदीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2005795, "chapter_id": 1113, "verse_number": "१-११४-२५", "content_sanskrit": "स तार्यमाणो यमुनां मामुपेत्याब्रवीत्तदा।\nसान्त्वपूर्वं मुनिश्रेष्ठः कामार्तो मधुरं वचः।\nउक्त्वा जन्म कुलं मह्यं नासि दाशसुतेति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2005796, "chapter_id": 1113, "verse_number": "१-११४-२६", "content_sanskrit": "तमहं शापभीता च पितुर्भीता च भारत।\nवरैरसुलभैरुक्ता न प्रत्याख्यातुमुत्सहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2005797, "chapter_id": 1113, "verse_number": "१-११४-२७", "content_sanskrit": "प्रेक्ष्य तांस्तु महाभागान्पारावारे ऋषीन्स्थितान्।\nयमुनातीरविन्यस्तान्प्रदीप्तानिव पावकान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2005798, "chapter_id": 1113, "verse_number": "१-११४-२८", "content_sanskrit": "पुरस्तादरुणश्चैव तरुणः संप्रकाशते।\nयेनैषा ताम्रवस्त्रेव द्यौः कृता प्रविजृम्भिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2005799, "chapter_id": 1113, "verse_number": "१-११४-२९", "content_sanskrit": "उक्तमात्रो मया तत्र नीहारमसृजत्प्रभुः।\nपराशरः सत्यधृतिर्द्वीपे च यमुनाम्भसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2005800, "chapter_id": 1113, "verse_number": "१-११४-३०", "content_sanskrit": "अभिभूय स मां बालां तेजसा वशमानयत्।\nतमसा लोकमावृत्य नौगतामेव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2005801, "chapter_id": 1113, "verse_number": "१-११४-३१", "content_sanskrit": "मत्स्यगन्धो महानासीत्पुरा मम जुगुप्सितः।\nतमपास्य शुभं गन्धमिमं प्रादात्स मे मुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2005802, "chapter_id": 1113, "verse_number": "१-११४-३२", "content_sanskrit": "ततो मामाह स मुनिर्गर्भमुत्सृज्य मामकम्।\nद्वोपेऽस्या एव सरितः कन्यैव त्वं भविष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2005803, "chapter_id": 1113, "verse_number": "१-११४-३३", "content_sanskrit": "कन्यात्वं च ददौ प्रीतः पुनर्विद्वांस्तपोधनः।\nतस्य वीर्यमहं दृष्ट्वा तथा युक्तं महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2005804, "chapter_id": 1113, "verse_number": "१-११४-३४", "content_sanskrit": "विस्मिता व्यथिता चैव प्रादामात्मानमेव च।\nततस्तदा महात्मा स कन्यायां मयि भारत।\nप्रहृष्टोऽजनयत्पुत्रं द्वीप एव पराशरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2005805, "chapter_id": 1113, "verse_number": "१-११४-३५", "content_sanskrit": "पाराशर्यो महायोगी स बभूव महानृषिः।\nकन्यापुत्रो मम पुरा द्वैपायन इति श्रुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2005806, "chapter_id": 1113, "verse_number": "१-११४-३६", "content_sanskrit": "यो व्यस्य वेदांश्चतुरस्तपसा भगवानृषिः।\nलोके व्यासत्वमापेदे कार्ष्ण्यात्कृष्णत्वमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2005807, "chapter_id": 1113, "verse_number": "१-११४-३७", "content_sanskrit": "सत्यवादी शमपरस्तपस्वी दग्धकिल्बिषः।\nसद्योत्पन्नः स तु महान्सह पित्रा ततो गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2005808, "chapter_id": 1113, "verse_number": "१-११४-३८", "content_sanskrit": "स नियुक्तो मया व्यक्तं त्वया चाप्रतिमद्युतिः।\nभ्रातुः क्षेत्रेषु कल्याणमपत्यं जनयिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2005809, "chapter_id": 1113, "verse_number": "१-११४-३९", "content_sanskrit": "स हि मामुक्तवांस्तत्र स्मरेः कृच्छ्रेषु मामिति।\nतं स्मरिष्ये महाबाहो यदि भीष्म त्वमिच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2005810, "chapter_id": 1113, "verse_number": "१-११४-४०", "content_sanskrit": "तव ह्यनुमते भीष्म नियतं स महातपाः।\nविचित्रवीर्यक्षेत्रेषु पुत्रानुत्पादयिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2005811, "chapter_id": 1113, "verse_number": "१-११४-४१x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2005812, "chapter_id": 1113, "verse_number": "१-११४-४१", "content_sanskrit": "महर्षेः कीर्तने तस्य भीष्मः प्राञ्जलिरब्रवीत्।\nदेशकालौ च जानासि क्रियतामर्थसिद्धये।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2005813, "chapter_id": 1113, "verse_number": "१-११४-४१x", "content_sanskrit": "धर्ममर्थं च कामं च त्रीनेतान्योनुपश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2005814, "chapter_id": 1113, "verse_number": "१-११४-४२", "content_sanskrit": "अर्थमर्थानुबन्धं च धर्मं धर्मानुबन्धनम्।\nकामं कामानुबन्धं च विपरीतान्पृथक्पृथक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2005815, "chapter_id": 1113, "verse_number": "१-११४-४३", "content_sanskrit": "यो विचिन्त्य धिया धीरो व्यवस्यति स बुद्धिमान्।\nतदिदं धर्मयुक्तं च हितं चैव कुलस्य नः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2005816, "chapter_id": 1113, "verse_number": "१-११४-४४", "content_sanskrit": "उक्तं भवत्या यच्छ्रेयस्तन्मह्यं रोचते भृशम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2005817, "chapter_id": 1113, "verse_number": "१-११४-४४x", "content_sanskrit": "वैशम्पायन उवाच।\nततस्तस्मिन्प्रतिज्ञाते भीष्मेण कुरुनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2005818, "chapter_id": 1113, "verse_number": "१-११४-४५", "content_sanskrit": "कृष्णद्वैपायनं काली चिन्तयामास वै मुनिम्।\nस वेदान्विब्रुवन्धीमान्मातुर्विज्ञाय चिन्तितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2005819, "chapter_id": 1113, "verse_number": "१-११४-४६", "content_sanskrit": "प्रादुर्बभूवाविदितः क्षणेन कुरुनन्दन।\nतस्मै पूजां ततः कृत्वा सुताय विधिपूर्वकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2005820, "chapter_id": 1113, "verse_number": "१-११४-४७", "content_sanskrit": "परिष्वज्य च बाहुभ्यां प्रस्रवैरभ्यषिञ्चत।\nमुमोच बाष्पं दाशेयी पुत्रं दृष्ट्वा चिरस्य तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2005821, "chapter_id": 1113, "verse_number": "१-११४-४८", "content_sanskrit": "तामद्भिः परिषिच्यार्तां महर्षिरभिवाद्य च।\nमातरं पूर्वजः पुत्रो व्यासो वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2005822, "chapter_id": 1113, "verse_number": "१-११४-४९", "content_sanskrit": "भवत्या यदभिप्रेतं तदहं कर्तुमागतः।\nशाधि मां धर्मतत्त्वज्ञे करवाणि प्रियं तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2005823, "chapter_id": 1113, "verse_number": "१-११४-५०", "content_sanskrit": "तस्मै पूजां ततोऽकार्षीत्पुरोधाः परमर्षये।\nस च तां प्रतिजग्राह विधिमन्मन्त्रपूर्वकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2005824, "chapter_id": 1113, "verse_number": "१-११४-५१", "content_sanskrit": "पूजितो मन्त्रपूर्वं तु विधिवत्प्रीतिमाप सः।\nतमासनगतं माता पृष्ट्वा कुशलमव्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2005825, "chapter_id": 1113, "verse_number": "१-११४-५२", "content_sanskrit": "सत्यवत्यथ वीक्ष्यैनमुवाचेदमनन्तरम्।\nमातापित्रोः प्रजायन्ते पुत्राः साधारणाः कवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2005826, "chapter_id": 1113, "verse_number": "१-११४-५३", "content_sanskrit": "तेषां पिता यथा स्वीमी तथा माता न संशयः।\nविधानविहितः स त्वं यथा मे प्रथमः सुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2005827, "chapter_id": 1113, "verse_number": "१-११४-५४", "content_sanskrit": "विचित्रवीर्यो ब्रह्मर्षे तथा मेऽवरजः सुतः।\nयथैव पितृतो भीष्मस्तथा त्वमपि मातृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2005828, "chapter_id": 1113, "verse_number": "१-११४-५५", "content_sanskrit": "भ्राता विचित्रवीर्यस्य यथा वा पुत्र मन्यसे।\nअयं शान्तनवः सत्यं पालयन्सत्यविक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2005829, "chapter_id": 1113, "verse_number": "१-११४-५६", "content_sanskrit": "बुद्धिं न कुरुतेऽपत्ये तथा राज्याऽनुशासने।\nस त्वं व्यपेक्षया भ्रातुः सन्तानाय कुलस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2005830, "chapter_id": 1113, "verse_number": "१-११४-५७", "content_sanskrit": "भीष्मस्य चास्य वचनान्नियोगाच्च ममानघ।\nअनुक्रोशाच्च भूतानां सर्वेषां रक्षणाय च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2005831, "chapter_id": 1113, "verse_number": "१-११४-५८", "content_sanskrit": "आनृशंस्याच्च यद्ब्रूयां तच्छ्रुत्वा कर्तुमर्हसि।\nयवीयसस्व भ्रातुर्भार्ये सुरसुतोपमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2005832, "chapter_id": 1113, "verse_number": "१-११४-५९", "content_sanskrit": "रूपयौवनसंपन्ने पुत्रकामे च धर्मतः।\nतयोरुत्पादयापत्यं समर्थो ह्यसि पुत्रक॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2005833, "chapter_id": 1113, "verse_number": "१-११४-६०", "content_sanskrit": "अनुरूपं कुलस्यास्य संतत्याः प्रसवस्य च।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2005834, "chapter_id": 1113, "verse_number": "१-११४-६०x", "content_sanskrit": "व्यास उवाच।\nवेत्थ धर्मं सत्यवति परं चापरमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2005835, "chapter_id": 1113, "verse_number": "१-११४-६१", "content_sanskrit": "तथा तव महाप्राज्ञे धर्मे प्रणिहिता मतिः।\nतस्मादहं त्वन्नियोगाद्धर्ममुद्दिश्य कारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2005836, "chapter_id": 1113, "verse_number": "१-११४-६२", "content_sanskrit": "ईप्सितं ते करिष्यामि दृष्टं ह्येतत्सनातनम्।\nभ्रातुः पुत्रान्प्रदास्यामि मित्रावरुणयोः समान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2005837, "chapter_id": 1113, "verse_number": "१-११४-६३", "content_sanskrit": "व्रतं चरेतां ते देव्यौ निर्दिष्टमिह यन्मया।\nसंवत्सरं यथान्यायं ततः शुद्धे भविष्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2005838, "chapter_id": 1113, "verse_number": "१-११४-६४", "content_sanskrit": "नहि मामव्रतोपेता उपेयात्काचिदङ्गना।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2005839, "chapter_id": 1113, "verse_number": "१-११४-६४x", "content_sanskrit": "सत्यवत्युवाच।\nसद्यो यथा प्रपद्येते देव्यौ गर्भं तथा कुरु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2005840, "chapter_id": 1113, "verse_number": "१-११४-६५", "content_sanskrit": "अराजकेषु राष्ट्रेषु प्रजाऽनाथा विनश्यति।\nनश्यन्ति च क्रियाः सर्वा नास्ति वृष्टिर्न देवता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2005841, "chapter_id": 1113, "verse_number": "१-११४-६६", "content_sanskrit": "कथं चाराजकं राष्ट्रं शक्यं धारयितुं प्रभो।\nतस्माद्गर्भं समाधत्स्व भीष्मः संवर्धयिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2005842, "chapter_id": 1113, "verse_number": "१-११४-६७x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2005843, "chapter_id": 1113, "verse_number": "१-११४-६७", "content_sanskrit": "यदि पुत्रः प्रदातव्यो मया भ्रातुरकालिकः।\nविरूपतां मे सहतां तयोरेतत्परं व्रतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2005844, "chapter_id": 1113, "verse_number": "१-११४-६८", "content_sanskrit": "यदि मे सहते गन्धं रूपं वेषं तथा वपुः।\nअद्यैव गर्भं कौसल्या विशिष्टं प्रतिपद्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2005845, "chapter_id": 1113, "verse_number": "१-११४-६९", "content_sanskrit": "तस्यापि च शतं पुत्रा भवितारो न संशयः।\nगोप्तारः कुरुवंशस्य भवत्याः शोकनाशनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2005846, "chapter_id": 1113, "verse_number": "१-११४-७०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2005847, "chapter_id": 1113, "verse_number": "१-११४-७०", "content_sanskrit": "एवमुक्त्वा महातेजा व्यासः सत्यवतीं तदा।\nशयने सा च कौसल्या शुचिवस्त्रा ह्यलङ्कृता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2005848, "chapter_id": 1113, "verse_number": "१-११४-७१", "content_sanskrit": "समागमनमाकाङ्क्षेदिति सोऽन्तर्हितो मुनिः।\nततोऽभिगम्य सा देवी स्नुषां रहसि संगताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2005849, "chapter_id": 1113, "verse_number": "१-११४-७२", "content_sanskrit": "धर्म्यमर्थसमायुक्तमुवाच वचनं हितम्।\nकौसल्ये धर्मतन्त्रं त्वां यद्ब्रवीमि निबोध तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2005850, "chapter_id": 1113, "verse_number": "१-११४-७३", "content_sanskrit": "भरतानां समुच्छेदो व्यक्तं मद्भाग्यसंक्षयात्।\nव्यथितां मां च संप्रेक्ष्य पितृवंशं च पीडितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2005851, "chapter_id": 1113, "verse_number": "१-११४-७४", "content_sanskrit": "भीष्मो बुद्धिमदान्मह्यं कुलस्यास्य विवृद्धये।\nसा च बुद्धिस्त्वय्यधीना पुत्रि प्रापय मां तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2005852, "chapter_id": 1113, "verse_number": "१-११४-७५", "content_sanskrit": "नष्टं च भारतं वंशं पुनरेव समुद्धऱ।\nपुत्रं जनय सुश्रोणि देवराजसमप्रभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2005853, "chapter_id": 1113, "verse_number": "१-११४-७६", "content_sanskrit": "स हि राज्यधुरं गुर्वीमुद्वक्ष्यति कुलस्य नः।\nएवमुक्त्वा तु सा देवी स्नुषां सत्यवती तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2005854, "chapter_id": 1113, "verse_number": "१-११४-७७", "content_sanskrit": "सा धर्मतोऽनुनीयैनां कथंचिद्धर्मचारिणीम्।\nभोजयामास विप्रांश्च देवर्षीनतिथींस्तथा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2005855, "chapter_id": 1113, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि चतुर्दशाधिकशततमोऽध्यायः॥ ११४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}]