[{"id": 2013075, "chapter_id": 1269, "verse_number": "२-१०-१", "content_sanskrit": "नारद उवाच।\nसभा वैश्रवणी राजञ्शतयोजनमायता।\nविस्तीर्णा सप्ततिश्चैव योजनानि सितप्रभा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2013076, "chapter_id": 1269, "verse_number": "२-१०-२", "content_sanskrit": "तपसा निर्जिता राजन्स्वयं वैश्रवणेन सा।\nशशिप्रभा प्रावरणा कैलासशिखरोपमा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2013077, "chapter_id": 1269, "verse_number": "२-१०-३", "content_sanskrit": "गुह्यकैरुह्यमाना सा खे विषक्तेव शोभते।\nदिव्या हेममयैरुच्चैः प्रासादैरुपशोभिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2013078, "chapter_id": 1269, "verse_number": "२-१०-४", "content_sanskrit": "महारत्नवती चित्रा दिव्यगन्धा मनोरमा।\nसिताभ्रशिखराकारा प्लवमानेव दृश्यते।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2013079, "chapter_id": 1269, "verse_number": "२-१०-५", "content_sanskrit": "दिव्या हेममयै रङ्गैर्विद्युद्भिरिव चित्रिता।\nतस्यां वैश्रवणो राजा विचित्राभरणाम्बरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2013080, "chapter_id": 1269, "verse_number": "२-१०-६", "content_sanskrit": "स्त्रीसहस्रैर्वृतः श्रीमानास्ते ज्वलितकुण्डलः।\nसह पत्न्या महाराज ऋद्ध्या सह विराजते।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2013081, "chapter_id": 1269, "verse_number": "२-१०-७", "content_sanskrit": "सर्वाभरणभूषिण्या वपुष्मत्या धनेश्वरः।\nदिवाकरनिभे पुण्ये दिव्यास्तरणसंवृते।\nदिव्यपादोपधाने च निषण्णः परमासने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2013082, "chapter_id": 1269, "verse_number": "२-१०-८", "content_sanskrit": "मन्दाराणामुदाराणां वनानि परिलोडयन्।\nसौगन्धीकवनानां च गन्धं गन्धवहो वहन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2013083, "chapter_id": 1269, "verse_number": "२-१०-९", "content_sanskrit": "नलिन्याश्चालकाख्याया नन्दनस्य वनस्य च।\nशीतो हृदयसंह्लादी वायुस्तमुपसेवते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2013084, "chapter_id": 1269, "verse_number": "२-१०-१०", "content_sanskrit": "तत्र देवाः सगन्धर्वा गणैरप्सरसां वृताः।\nदिव्यतानैर्महाराज गायन्तिस्म सभागताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2013085, "chapter_id": 1269, "verse_number": "२-१०-११", "content_sanskrit": "मिश्रकेशी च रम्भा च चित्रसेना शुचिस्मिता।\nचारुनेत्रा घृताची च मेनका पुञ्जिकस्थला॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2013086, "chapter_id": 1269, "verse_number": "२-१०-१२", "content_sanskrit": "विश्वाची सहजन्या च प्रम्लोचा उर्वशी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2013087, "chapter_id": 1269, "verse_number": "२-१०-१३", "content_sanskrit": "वर्गा च सौरभेयी च समीची बुद्बुदा लता।\nएताः सहस्रशश्चान्या नृत्तगीतविशारदाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2013088, "chapter_id": 1269, "verse_number": "२-१०-१४", "content_sanskrit": "उपतिष्ठन्ति धनदं गन्धर्वाप्सरसां गणाः।\nअनिशं दिव्यवादित्रैर्नृत्तगीतैश्च स सभा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2013089, "chapter_id": 1269, "verse_number": "२-१०-१५", "content_sanskrit": "अशून्या रुचिरा भाति गन्धर्वाप्सरसां गणैः।\nकिन्नरा नाम गन्धर्वा नरा नाम तथाऽपरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2013090, "chapter_id": 1269, "verse_number": "२-१०-१६", "content_sanskrit": "माणिभद्रोऽथ धनदः श्वेतभद्रश्च गुह्यकः।\nकशेरको गण्डकण्डूः प्रद्योतश्च महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2013091, "chapter_id": 1269, "verse_number": "२-१०-१७", "content_sanskrit": "कुस्तम्बरुः पिशाचश्च गजकर्णो विशालकः।\nवराहकर्णस्ताम्रौष्ठः फलकक्षः फलोदकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2013092, "chapter_id": 1269, "verse_number": "२-१०-१८", "content_sanskrit": "हंसचूडः शइखावर्तो हेमनेत्रो विभीषणः।\nपुष्पाननः पिङ्गलकः शोणितोदः प्रवालकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2013093, "chapter_id": 1269, "verse_number": "२-१०-१९", "content_sanskrit": "वृक्षवास्यनिकेतश्च चीरवासाश्च भारत।\nएते चान्ये च बहवो यक्षाः शतसहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2013094, "chapter_id": 1269, "verse_number": "२-१०-२०", "content_sanskrit": "सदा भगवती लक्ष्मीस्तत्रैव नलकूबरः।\nअहं च बहुशस्तस्यां भवन्त्यन्ये च मद्विधाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2013095, "chapter_id": 1269, "verse_number": "२-१०-२१", "content_sanskrit": "ब्रह्मर्षयो भवन्त्यत्र तथा देवर्षयोऽपरे।\nक्रव्यादाश्च तथैवान्ये गन्धर्वाश्च महाबलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2013096, "chapter_id": 1269, "verse_number": "२-१०-२२", "content_sanskrit": "उपासते महात्मानं तस्यां धनदमीश्वरम्।\nभगवान्भूतसङ्घैश्च वृतः शतसहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2013097, "chapter_id": 1269, "verse_number": "२-१०-२३", "content_sanskrit": "उमापतिः पशुपतिः शूलभृद्भगनेत्रहा।\nत्र्यम्बको राजशार्दूल देवी च विगतक्लमा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2013098, "chapter_id": 1269, "verse_number": "२-१०-२४", "content_sanskrit": "वामनैर्विकटैः कुब्जैः क्षतजाक्षैर्महारवैः।\nमेदोमांसाशनैरुग्रैरुग्रधन्वा महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2013099, "chapter_id": 1269, "verse_number": "२-१०-२५", "content_sanskrit": "नानाप्रहरणैरुग्रैर्वातैरिव महाजवैः।\nवृतः सखायमन्वास्ते सदैव धनदं नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2013100, "chapter_id": 1269, "verse_number": "२-१०-२६", "content_sanskrit": "प्रहृष्टाः शतशश्चान्ये बहुशः सपरिच्छदाः।\nगन्धर्वाणां च पतयो विश्वावसुर्हहा हुहूः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2013101, "chapter_id": 1269, "verse_number": "२-१०-२७", "content_sanskrit": "तुम्बुरुः प्रवतश्चैव शैलूषश्च तथाऽपरः।\nचित्रसेनश्च गीतज्ञस्तथा चित्ररथोपि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2013102, "chapter_id": 1269, "verse_number": "२-१०-२८", "content_sanskrit": "एते चान्ये च गन्धर्वा धनेश्वरमुपासते।\nविद्याधराधिपश्चैव चक्रधर्मा सहानुजैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2013103, "chapter_id": 1269, "verse_number": "२-१०-२९", "content_sanskrit": "उपाचरति तत्र स्म धनानामीश्वरं प्रभुम्।\nकिन्नराः शतशस्तत्र धनानामीश्वरं प्रभुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2013104, "chapter_id": 1269, "verse_number": "२-१०-३०", "content_sanskrit": "आसते चापि राजानो भगदत्तपुरोगमाः।\nद्रुमः किम्पुरुषेशश्च उपास्ते धनदेश्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2013105, "chapter_id": 1269, "verse_number": "२-१०-३१", "content_sanskrit": "राक्षसाधिपतिश्चैव महेन्द्रो गन्धमादनः।\nसह यक्षैः सगन्धर्वैः सह सर्वैर्निशाचरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2013106, "chapter_id": 1269, "verse_number": "२-१०-३२", "content_sanskrit": "विभीषणश्च धर्मिष्ठ उपास्ते भ्रातरं प्रभुम्।\nहिमवान्पारियात्रश्च विन्ध्यकैलासमन्दराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2013107, "chapter_id": 1269, "verse_number": "२-१०-३३", "content_sanskrit": "मलयो दर्दुरश्चैव महेन्द्रो गन्धमादनः।\nइन्द्रकीलः सुनाभश्च तथा दिव्यौ च पर्वतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2013108, "chapter_id": 1269, "verse_number": "२-१०-३४", "content_sanskrit": "एते चान्ये च बहवः सर्वे मेरुपुरोगमाः।\nउपासते महात्मानं धनानामीश्वरं प्रभुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2013109, "chapter_id": 1269, "verse_number": "२-१०-३५", "content_sanskrit": "न्दीश्वरश्च भगवान्महाकालस्तथैव च।\nशङ्कुकर्णमुखाः सर्वे दिव्याः पारिषदास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2013110, "chapter_id": 1269, "verse_number": "२-१०-३६", "content_sanskrit": "काष्ठः कुटी मुखो दन्ती विजयश्च तपोधिकः।\nश्वेतश्च वृषभस्तत्र नर्दन्नास्ते महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2013111, "chapter_id": 1269, "verse_number": "२-१०-३७", "content_sanskrit": "धनदं राक्षसाश्चान्ये पिशाचाश्च उपासते।\nपारिषदैः परिवृतमुपायान्तं महेश्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2013112, "chapter_id": 1269, "verse_number": "२-१०-३८", "content_sanskrit": "सदा हि देवदेवेशं शिवं त्रैलोक्यभावनम्।\nप्रणम्य मूर्ध्ना पौलस्त्यो बहुरूपमुमापतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2013113, "chapter_id": 1269, "verse_number": "२-१०-३९", "content_sanskrit": "ततोऽभ्यनुज्ञां सम्प्राप्य महादेवाद्धनेश्वरः।\nआस्ते कदाचिद्भगवान्भवो धनपतेः सखा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2013114, "chapter_id": 1269, "verse_number": "२-१०-४०", "content_sanskrit": "निधिप्रवरमुख्यौ च शङ्खपद्मौ धनेश्वरौ।\nसर्वान्निधीन्प्रगृह्याथ उपास्तां वै धनेश्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2013115, "chapter_id": 1269, "verse_number": "२-१०-४१", "content_sanskrit": "सा सभा तादृशी रम्या मया दृष्टान्तरिक्षगा।\nपितामहसभां राजन्कीर्तयिष्ये निबोध ताम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2013116, "chapter_id": 1269, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि मन्त्रपर्वणि दशमोऽध्यायः॥ १०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]