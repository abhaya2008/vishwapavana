[{"id": 2017849, "chapter_id": 1371, "verse_number": "३-९-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2017850, "chapter_id": 1371, "verse_number": "३-९-१", "content_sanskrit": "भगवन्नाहमप्येतद्रोचये द्यूतसंभवम्।\nमन्ये तद्विधिनाऽऽकृष्य कारितोस्मीति वै मुने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2017851, "chapter_id": 1371, "verse_number": "३-९-२", "content_sanskrit": "नैतद्रोचयते भीष्मो न द्रोणो विदुरो न च।\nगान्धार्या नेष्यते द्यूतं तत्र मोहात्प्रवर्तितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2017852, "chapter_id": 1371, "verse_number": "३-९-३", "content_sanskrit": "परित्यक्तुं न शक्नोमि दुर्योधनमचेतनम्।\nपुत्रस्नेहेन भगवञ्जानन्नपि यतव्रत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2017853, "chapter_id": 1371, "verse_number": "३-९-४x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2017854, "chapter_id": 1371, "verse_number": "३-९-४", "content_sanskrit": "वैचित्रवीर्य नृपते सत्यमाह यथा भवान्।\nदृढं विझः परं पुत्रं परं पुत्रान्न विद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2017855, "chapter_id": 1371, "verse_number": "३-९-५", "content_sanskrit": "इन्द्रोप्यश्रुनिपातेन सुरभ्या प्रतिबोधितः।\nअन्यैः समृद्धैरप्यर्थैर्न सुतानमन्यते परम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2017856, "chapter_id": 1371, "verse_number": "३-९-६", "content_sanskrit": "अत्र ते वर्तयिष्यामि गहदाख्यानमुत्तमम्।\nसुरभ्याश्चैव संवादमिन्द्रस्य च विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2017857, "chapter_id": 1371, "verse_number": "३-९-७", "content_sanskrit": "त्रिविष्टपगता राजन्सुरभी प्रारुदत्किल।\nगवां माता पुरा तात तामिन्द्रोऽन्वकृपायत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2017858, "chapter_id": 1371, "verse_number": "३-९-८x", "content_sanskrit": "इन्द्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2017859, "chapter_id": 1371, "verse_number": "३-९-८", "content_sanskrit": "किमिदं रोदिषि शुभे कच्चित्क्षेमं दिवौकसाम्।\nमनुष्येष्वथवा गोषु नैतदल्पं भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2017860, "chapter_id": 1371, "verse_number": "३-९-९x", "content_sanskrit": "सुरभिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2017861, "chapter_id": 1371, "verse_number": "३-९-९", "content_sanskrit": "विनिपातो न वः कश्चिद्दृश्यते त्रिदशाधिप।\nअहं तु पुत्रं शोचामि तेन रोदिमि कौशिक ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2017862, "chapter_id": 1371, "verse_number": "३-९-१०", "content_sanskrit": "पश्यैनं कर्षकं क्षुद्रं दुर्बलं मम पुत्रकम्।\nप्रतोदेनाभिनिघ्नन्तं लाङ्गलेन च पीडितम्।\nनिषीदमानं सोत्कण्ठं वध्यमानं सुराधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2017863, "chapter_id": 1371, "verse_number": "३-९-११", "content_sanskrit": "`एनं दृष्ट्वा भृशं श्रान्तं वध्यमानं सुराधिप।\nकृपाविष्टाऽस्मि देवेन्द्र मनश्चोद्वेपते मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2017864, "chapter_id": 1371, "verse_number": "३-९-१२", "content_sanskrit": "एकस्तत्रबलोपेतो धुरमुद्वहतेऽधिकाम्।\nअपरोप्यबलप्राणः कृशो धमनिसंततः।\nकृच्छ्रादुद्वहते भारं तं वै शोचामि वासव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2017865, "chapter_id": 1371, "verse_number": "३-९-१३", "content_sanskrit": "वध्यमानः प्रतोदेन तुद्यमानः पुनः पुनः।\nनैव शक्नोति तं भारमुद्वोढुं पश्य वासव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2017866, "chapter_id": 1371, "verse_number": "३-९-१४", "content_sanskrit": "ततोऽहं तस्य शोकार्ता विरौमि भृशदुःखिता।\nअश्रूण्यावर्तयन्ती च नेत्राभ्यां करुणायती ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2017867, "chapter_id": 1371, "verse_number": "३-९-१५x", "content_sanskrit": "शक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2017868, "chapter_id": 1371, "verse_number": "३-९-१५", "content_sanskrit": "तव पुत्रसहस्रेषु पीड्यमानेषु शोभने।\nकिं कृपायितवत्यत्र पुत्र एको निपीड्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2017869, "chapter_id": 1371, "verse_number": "३-९-१६x", "content_sanskrit": "सुरभिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2017870, "chapter_id": 1371, "verse_number": "३-९-१६", "content_sanskrit": "यदि पुत्रसहस्राणि सर्वत्रसमतैव मे।\nदीनस्य तु सतः शक्र पुत्रस्याभ्यधिकाकृपा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2017871, "chapter_id": 1371, "verse_number": "३-९-१७x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2017872, "chapter_id": 1371, "verse_number": "३-९-१७", "content_sanskrit": "तदिन्द्रः सुरभेर्वाक्यं निशम्य भृशविस्मितः।\nजीवितेनापि कौरव्य मेनेऽभ्यधिकमात्मजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2017873, "chapter_id": 1371, "verse_number": "३-९-१८", "content_sanskrit": "प्रववर्ष च तत्रैव सहसा तोयमुल्वणम्।\nकर्षकस्याचरन्विघ्नं भगवान्पाकशासनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2017874, "chapter_id": 1371, "verse_number": "३-९-१९", "content_sanskrit": "तद्यथा सुरभिः प्राह सममेवास्तु ते तथा।\nसुतेषु राजन्सर्वेषु हीनेष्वभ्यधिका कृपा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2017875, "chapter_id": 1371, "verse_number": "३-९-२०", "content_sanskrit": "यादृशो मे सुतः पाण्डुस्तादृशो मेऽसि पुत्रक।\nविदुरश्च महाप्राज्ञः स्नेहादेतद्ब्रवीम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2017876, "chapter_id": 1371, "verse_number": "३-९-२१", "content_sanskrit": "चिराय तव पुत्राणां शतमेकश्च भारत।\nपाण्डौः पञ्चैव लक्ष्यन्ते तेऽपि मन्दाःसुदुःखिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2017877, "chapter_id": 1371, "verse_number": "३-९-२२", "content_sanskrit": "कथं जीवेयुरत्यन्तं कथं वर्धेयुरित्यपि।\nइति दीनेषु पार्थेषु मनो मे परितप्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2017878, "chapter_id": 1371, "verse_number": "३-९-२३", "content_sanskrit": "यदि पार्थिव कौख्याञ्जीवमानानिहेच्छसि।\nदुर्योधनस्तव सुतः शमं गच्छतु पाण्डवैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2017879, "chapter_id": 1371, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि किर्मीरवधपर्वणि नवमोऽध्यायः ॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]