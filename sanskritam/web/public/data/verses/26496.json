[{"id": 7006496000, "chapter_id": 26496, "verse_number": "३-३५-१", "content_sanskrit": "वैशम्पायन उवाच तस्योपरि जलौघस्य महती नौरिव स्थिता ।\nविततत्वात्तु देहस्य न ययौ सम्प्लवं मही ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006496001, "chapter_id": 26496, "verse_number": "३-३५-२", "content_sanskrit": "ततः स चिन्तयामास प्रविभागं क्षितेर्विभुः ।\nसमुच्छ्रयं च सर्वेषां पर्वतानां नदीषु च ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006496002, "chapter_id": 26496, "verse_number": "३-३५-३", "content_sanskrit": "विलेखनं प्रमाणं च गतिं प्रस्रवमेव च ।\nमाहात्म्यं च विशेषं च नदीनामन्वचिन्तयत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006496003, "chapter_id": 26496, "verse_number": "३-३५-४", "content_sanskrit": "चतुरन्तां धरां कृत्वा तथा चैव महार्णवम् ।\nमध्ये पृथिव्याः सौवर्णमकरोन्मेरुपर्वतम्॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006496004, "chapter_id": 26496, "verse_number": "३-३५-५", "content_sanskrit": "प्राचीं दिशमथो गत्वा चकारोदयपर्वतम् ।\nशतयोजनविस्तारं सहस्रं च समुच्छ्रयम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006496005, "chapter_id": 26496, "verse_number": "३-३५-६", "content_sanskrit": "जातरूपमयैः शृङ्गैस्तरुणादित्यसन्निभैः ।\nआत्मतेजोगुणमयैर्वेदिकाभोगकल्पितम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006496006, "chapter_id": 26496, "verse_number": "३-३५-७", "content_sanskrit": "विविधांश्च महास्कन्धान् काञ्चनान् पुष्करेक्षणः ।\nनित्यपुष्पफलान् वृक्षान् कृतवांस्तत्र पर्वते ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006496007, "chapter_id": 26496, "verse_number": "३-३५-८", "content_sanskrit": "शतयोजनविस्तारं ततस्त्रिगुणमायतम् ।\nचकार स महादेवः पुनः सौमनसं गिरिम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006496008, "chapter_id": 26496, "verse_number": "३-३५-९", "content_sanskrit": "नानारत्नसहस्राणां कृत्वा तत्र सुसंचयम् ।\nवेदिकां बहुवर्णां च संध्याभ्राभामकल्पयत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006496009, "chapter_id": 26496, "verse_number": "३-३५-१०", "content_sanskrit": "सहस्रशृङ्गं च गिरिं नानामणिशिलातलम् ।\nकृतवान् वृक्षगहनं षष्टियोजनमुच्छ्रितम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006496010, "chapter_id": 26496, "verse_number": "३-३५-११", "content_sanskrit": "आसनं तत्र परमं सर्वभूतनमस्कृतम् ।\nकृतवानात्मनः स्थानं विश्वकर्मा प्रजापतिः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006496011, "chapter_id": 26496, "verse_number": "३-३५-१२", "content_sanskrit": "शिशिरं च महाशैलं तुषारचयसंनिभम् ।\nचकार दुर्गगहनं कन्दरान्तरमण्डितम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006496012, "chapter_id": 26496, "verse_number": "३-३५-१३", "content_sanskrit": "शिशिरप्रभवां चैव नदीं द्विजगणायुताम् ।\nचकार पुलिनोपेतां वसुधारामिति श्रुतिः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006496013, "chapter_id": 26496, "verse_number": "३-३५-१४", "content_sanskrit": "सा नदी निखिलां प्राचीं पुण्यां मुखशतैश्चिताम् ।\nशोभयत्यमृतप्रख्यैर्मुक्ताशङ्खविभूषितैः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006496014, "chapter_id": 26496, "verse_number": "३-३५-१५", "content_sanskrit": "नित्यपुष्पफलोपेतैश्छादयद्भिः सुसंवृतैः ।\nभूषिताभ्यधिकैः कान्तैः सा नदी तीरजैर्द्रुमैः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006496015, "chapter_id": 26496, "verse_number": "३-३५-१६", "content_sanskrit": "कृत्वा प्राचीविभागं च दक्षिणायामथो दिशि ।\nचकार पर्वतं दिव्यं सर्वकाञ्चनराजतम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006496016, "chapter_id": 26496, "verse_number": "३-३५-१७", "content_sanskrit": "एकतः सूर्यसंकाशमेकतः शशिसंनिभम् ।\nस बिभ्रच्छुशुभेऽतीव द्वौ वर्णौ पर्वतोत्तमः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006496017, "chapter_id": 26496, "verse_number": "३-३५-१८", "content_sanskrit": "तेजसा युगपद् व्याप्तं सूर्याचन्द्रमसाविव ।\nवपुष्मन्तमथो तत्र भानुमन्तं महागिरिम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006496018, "chapter_id": 26496, "verse_number": "३-३५-१९", "content_sanskrit": "सर्वकामफलैर्वृक्षैर्वृतं रम्यैर्मनोरमैः ।\nचकार कुञ्जरं चैव कुञ्जरप्रतिमाकृतिम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006496019, "chapter_id": 26496, "verse_number": "३-३५-२०", "content_sanskrit": "सर्वतः काञ्चनगुहं बहुयोजनविस्तृतम् ।\nऋषभप्रतिमं चैव ऋषभं नाम पर्वतम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006496020, "chapter_id": 26496, "verse_number": "३-३५-२१", "content_sanskrit": "हेमकाञ्चनवृक्षाढ्यं पुष्पहासं स सृष्टवान् ।\nमहेन्द्रमथ शैलेन्द्रं शतयोजनमुच्छ्रितम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006496021, "chapter_id": 26496, "verse_number": "३-३५-२२", "content_sanskrit": "जातरूपमयैः शृङ्गैः सपुष्पितमदाद्रुमम् ।\nमेदिन्यां कृतवान् देवः प्रतिक्षोभमिवाचलम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006496022, "chapter_id": 26496, "verse_number": "३-३५-२३", "content_sanskrit": "नानारत्नसमाकीर्णं सूर्येन्दुसदृशप्रभम् ।\nचकार मलयं चाद्रिं चित्रपुष्पितपादपम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006496023, "chapter_id": 26496, "verse_number": "३-३५-२४", "content_sanskrit": "मैनाकं च महाशैलं शिलाजालसमावृतम् ।\nदक्षिणस्यां दिशि शुभं चकाराचलमायतम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006496024, "chapter_id": 26496, "verse_number": "३-३५-२५", "content_sanskrit": "सहस्रशिरसं विन्ध्यं नानाद्रुमलताकुलम् ।\nनदीं च विपुलावर्तां पुलिनश्रोणिभूषिताम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006496025, "chapter_id": 26496, "verse_number": "३-३५-२६", "content_sanskrit": "क्षीरसंकाशसलिलां पयोधारामिति श्रुतिः ।\nसुरम्यां तोयकलिलां विहितां दक्षिणां दिशम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006496026, "chapter_id": 26496, "verse_number": "३-३५-२७", "content_sanskrit": "दिव्यां तीर्थशतोपेतां प्लावयन्तीं शुभाम्भसा ।\nदिशं याम्यां प्रतिष्ठाप्य प्रतीचीं दिशमागमत् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006496027, "chapter_id": 26496, "verse_number": "३-३५-२८", "content_sanskrit": "अकरोत् तत्र शैलेन्द्रं शतयोजनमुच्छ्रितम् ।\nशोभितं शिखरैश्चित्रैः सुप्रवृद्धैर्हिरण्मयैः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006496028, "chapter_id": 26496, "verse_number": "३-३५-२९", "content_sanskrit": "काञ्चनीभिः शिलाभिश्च गुहाभिश्चविभूषितम् ।\nसमाकुलं सूर्यनिभैः शालैस्तालैश्च भास्वरैः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006496029, "chapter_id": 26496, "verse_number": "३-३५-३०", "content_sanskrit": "शुशुभे जातरूपैश्च श्रीमद्भिश्चित्रवेदिकैः ।\nषष्टिं गिरिसहस्राणि तत्रासौ संन्यवेशयत् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006496030, "chapter_id": 26496, "verse_number": "३-३५-३१", "content_sanskrit": "मेरुप्रतिमरूपाणि वपुषा प्रभया सह ।\nसहस्रजलधारं च पर्वतं मेरुसंनिभम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006496031, "chapter_id": 26496, "verse_number": "३-३५-३२", "content_sanskrit": "पुण्यतीर्थगुणोपेतं भगवान् संन्यवेशयत् ।\nषष्टियोजनविस्तारं तावदेव समुच्छ्रितम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006496032, "chapter_id": 26496, "verse_number": "३-३५-३३", "content_sanskrit": "आत्मरूपोपमं तत्र वाराहं नाम नामतः ।\nनिवेशयामास गिरिं दिव्यं वैदूर्यपर्वतम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006496033, "chapter_id": 26496, "verse_number": "३-३५-३४", "content_sanskrit": "राजताः काञ्चनाश्चैव यत्र दिव्याः शिलोच्चयाः ।\nतत्रैव चक्रसदृशं चक्रवन्तं महाबलम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006496034, "chapter_id": 26496, "verse_number": "३-३५-३५", "content_sanskrit": "सहस्रकूटं विपुलं भगवान् संन्यवेशयत् ।\nशङ्खप्रतिमरूपं च राजतं पर्वतोत्तमम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006496035, "chapter_id": 26496, "verse_number": "३-३५-३६", "content_sanskrit": "सितद्रुमसमाकीर्णं शङ्खं नाम न्यवेशयत् ।\nसुवर्णं रत्नसम्भूतं पारिजातं महाद्रुमम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006496036, "chapter_id": 26496, "verse_number": "३-३५-३७", "content_sanskrit": "महतः पर्वतस्याग्रे पुष्पहासं न्यवेशयत् ।\nशुभामतिरसां चैव घृतधारामिति श्रुतिः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006496037, "chapter_id": 26496, "verse_number": "३-३५-३८", "content_sanskrit": "वराहः सरितं पुण्यां प्रतीच्यामकरोत् प्रभुः ।\nप्रतीच्यां संविधिं कृत्वा पर्वतान्काञ्चनोज्ज्वलान् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006496038, "chapter_id": 26496, "verse_number": "३-३५-३९", "content_sanskrit": "गुणोत्तरानुत्तरस्यां संन्यवेशयदग्रतः ।\nततः सौम्यगिरिं सौम्यमन्तरिक्षप्रमाणतः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006496039, "chapter_id": 26496, "verse_number": "३-३५-४०", "content_sanskrit": "रुक्मधातुप्रतिच्छन्नमकरोद् भास्करोपमम् ।\nस तु देशो विसूर्योऽपि तस्य भासा प्रकाशते ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006496040, "chapter_id": 26496, "verse_number": "३-३५-४१", "content_sanskrit": "तस्य लक्ष्म्यधिकं भाति तपसा रविणा यथा ।\nसूक्ष्मलक्षणविज्ञेयस्तपतीव दिवाकरः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006496041, "chapter_id": 26496, "verse_number": "३-३५-४२", "content_sanskrit": "सहस्रशिखरं चैव नानातीर्थसमाकुलम् ।\nचकार रत्नसंकीर्णं भूयोऽस्तं नाम पर्वतम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006496042, "chapter_id": 26496, "verse_number": "३-३५-४३", "content_sanskrit": "मनोहरगुणोपेतं मन्दरं चाचलोत्तमम् ।\nउद्दामपुष्पगन्धं च पर्वतं गन्धमादनम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006496043, "chapter_id": 26496, "verse_number": "३-३५-४४", "content_sanskrit": "चकार तस्य शृङ्गेषु सुवर्णरससम्भवम् जम्बूं जाम्बूनदमयीमनन्ताद्भुतदर्शनाम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006496044, "chapter_id": 26496, "verse_number": "३-३५-४५", "content_sanskrit": "गिरिं त्रिशिखरं चैव तथा पुष्करपर्वतम् ।\nशुभ्रं पाण्डुरमेघाभं कैलासं च नगोत्तमम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006496045, "chapter_id": 26496, "verse_number": "३-३५-४६", "content_sanskrit": "हिमवन्तं च शैलेन्द्रं दिव्यधातुविभूषितम् ।\nनिवेशयामास हरिर्वाराहीं तनुमास्थितः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006496046, "chapter_id": 26496, "verse_number": "३-३५-४७", "content_sanskrit": "नदीं सर्वगुणोपेतामुत्तरस्यां दिशि प्रभुः ।\nमधुधारां स कृतवान् दिव्यामृषिशताकुलाम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006496047, "chapter_id": 26496, "verse_number": "३-३५-४८", "content_sanskrit": "सर्वे चैव क्षितिधराः सपक्षाः कामरूपिणः ।\nतदा कृता भगवता विचित्राः परमेष्ठिना ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006496048, "chapter_id": 26496, "verse_number": "३-३५-४९", "content_sanskrit": "स कृत्वा प्रविभागं तु पृथिव्या लोकभावनः ।\nदेवासुराणामुत्पत्तौ कृतवान् बुद्धिमक्षयाम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006496049, "chapter_id": 26496, "verse_number": "३-३५-५०", "content_sanskrit": "सर्वासु दिक्षु क्षतजोपमाक्ष- श्चकार शैलान्विविधाभिधानान् ।\nहिताय लोकस्य स लोकनाथः पुण्याश्च नद्यः सलिलोपगूढाः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]