[{"id": 5000459000, "chapter_id": 9459, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे द्विपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000459001, "chapter_id": 9459, "verse_number": "६-५२-१", "content_sanskrit": "धूम्राक्षं प्रेक्ष्य निर्यान्तं राक्षसं भीमविक्रमम्।\nविनेदुर्वानराः सर्वे प्रहृष्टा युद्धकाङ्क्षिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000459002, "chapter_id": 9459, "verse_number": "६-५२-२", "content_sanskrit": "तेषां सुतुमुलं युद्धं संजज्ञे कपिरक्षसाम्।\nअन्योन्यं पादपैर्घोरैर्निघ्नतां शूलमुद‍्गरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000459003, "chapter_id": 9459, "verse_number": "६-५२-३", "content_sanskrit": "राक्षसैर्वानरा घोरा विनिकृत्ताः समन्ततः।\nवानरै राक्षसाश्चापि द्रुमैर्भूमिसमीकृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000459004, "chapter_id": 9459, "verse_number": "६-५२-४", "content_sanskrit": "राक्षसास्त्वभिसंक्रुद्धा वानरान् निशितैः शरैः।\nविव्यधुर्घोरसंकाशैः कङ्कपत्रैरजिह्मगैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000459005, "chapter_id": 9459, "verse_number": "६-५२-५", "content_sanskrit": "ते गदाभिश्च भीमाभिः पट्टिशैः कूटमुद‍्गरैः।\nघोरैश्च परिघैश्चित्रैस्त्रिशूलैश्चापि संश्रितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000459006, "chapter_id": 9459, "verse_number": "६-५२-६", "content_sanskrit": "विदार्यमाणा रक्षोभिर्वानरास्ते महाबलाः।\nअमर्षजनितोद्धर्षाश्चक्रुः कर्माण्यभीतवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000459007, "chapter_id": 9459, "verse_number": "६-५२-७", "content_sanskrit": "शरनिर्भिन्नगात्रास्ते शूलनिर्भिन्नदेहिनः।\nजगृहुस्ते द्रुमांस्तत्र शिलाश्च हरियूथपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000459008, "chapter_id": 9459, "verse_number": "६-५२-८", "content_sanskrit": "ते भीमवेगा हरयो नर्दमानास्ततस्ततः।\nममन्थू राक्षसान् वीरान् नामानि च बभाषिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000459009, "chapter_id": 9459, "verse_number": "६-५२-९", "content_sanskrit": "तद् बभूवाद्भुतं घोरं युद्धं वानररक्षसाम्।\nशिलाभिर्विविधाभिश्च बहुशाखैश्च पादपैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000459010, "chapter_id": 9459, "verse_number": "६-५२-१०", "content_sanskrit": "राक्षसा मथिताः केचिद् वानरैर्जितकाशिभिः।\nप्रवेमू रुधिरं केचिन्मुखै रुधिरभोजनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000459011, "chapter_id": 9459, "verse_number": "६-५२-११", "content_sanskrit": "पार्श्वेषु दारिताः केचित् केचिद् राशीकृता द्रुमैः।\nशिलाभिश्चूर्णिताः केचित् केचिद् दन्तैर्विदारिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000459012, "chapter_id": 9459, "verse_number": "६-५२-१२", "content_sanskrit": "ध्वजैर्विमथितैर्भग्नैः खड्गैश्च विनिपातितैः।\nरथैर्विध्वंसितैः केचिद् व्यथिता रजनीचराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000459013, "chapter_id": 9459, "verse_number": "६-५२-१३", "content_sanskrit": "गजेन्द्रैः पर्वताकारैः पर्वताग्रैर्वनौकसाम्।\nमथितैर्वाजिभिः कीर्णं सारोहैर्वसुधातलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000459014, "chapter_id": 9459, "verse_number": "६-५२-१४", "content_sanskrit": "वानरैर्भीमविक्रान्तैराप्लुत्योत्प्लुत्य वेगितैः।\nराक्षसाः करजैस्तीक्ष्णैर्मुखेषु विनिदारिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000459015, "chapter_id": 9459, "verse_number": "६-५२-१५", "content_sanskrit": "विषण्णवदना भूयो विप्रकीर्णशिरोरुहाः।\nमूढाः शोणितगन्धेन निपेतुर्धरणीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000459016, "chapter_id": 9459, "verse_number": "६-५२-१६", "content_sanskrit": "अन्ये तु परमक्रुद्धा राक्षसा भीमविक्रमाः।\nतलैरेवाभिधावन्ति वज्रस्पर्शसमैर्हरीन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000459017, "chapter_id": 9459, "verse_number": "६-५२-१७", "content_sanskrit": "वानरैः पातयन्तस्ते वेगिता वेगवत्तरैः।\nमुष्टिभिश्चरणैर्दन्तैः पादपैश्चावपोथिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000459018, "chapter_id": 9459, "verse_number": "६-५२-१८", "content_sanskrit": "सैन्यं तु विद्रुतं दृष्ट्वा धूम्राक्षो राक्षसर्षभः।\nरोषेण कदनं चक्रे वानराणां युयुत्सताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000459019, "chapter_id": 9459, "verse_number": "६-५२-१९", "content_sanskrit": "प्रासैः प्रमथिताः केचिद् वानराः शोणितस्रवाः।\nमुद‍्गरैराहताः केचित् पतिता धरणीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000459020, "chapter_id": 9459, "verse_number": "६-५२-२०", "content_sanskrit": "परिघैर्मथिताः केचिद् भिन्दिपालैश्च दारिताः।\nपट्टिशैर्मथिताः केचिद् विह्वलन्तो गतासवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000459021, "chapter_id": 9459, "verse_number": "६-५२-२१", "content_sanskrit": "केचिद् विनिहता भूमौ रुधिरार्द्रा वनौकसः।\nकेचिद् विद्राविता नष्टाः संक्रुद्धै राक्षसैर्युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000459022, "chapter_id": 9459, "verse_number": "६-५२-२२", "content_sanskrit": "विभिन्नहृदयाः केचिदेकपार्श्वेन शायिताः।\nविदारितास्त्रिशूलैश्च केचिदान्त्रैर्विनिःसृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000459023, "chapter_id": 9459, "verse_number": "६-५२-२३", "content_sanskrit": "तत् सुभीमं महद्युद्धं हरिराक्षससंकुलम्।\nप्रबभौ शस्त्रबहुलं शिलापादपसंकुलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000459024, "chapter_id": 9459, "verse_number": "६-५२-२४", "content_sanskrit": "धनुर्ज्यातन्त्रिमधुरं हिक्कातालसमन्वितम्।\nमन्दस्तनितगीतं तद् युद्धगान्धर्वमाबभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000459025, "chapter_id": 9459, "verse_number": "६-५२-२५", "content_sanskrit": "धूम्राक्षस्तु धनुष्पाणिर्वानरान् रणमूर्धनि।\nहसन् विद्रावयामास दिशस्ताञ्छरवृष्टिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000459026, "chapter_id": 9459, "verse_number": "६-५२-२६", "content_sanskrit": "धूम्राक्षेणार्दितं सैन्यं व्यथितं प्रेक्ष्य मारुतिः।\nअभ्यवर्तत संक्रुद्धः प्रगृह्य विपुलां शिलाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000459027, "chapter_id": 9459, "verse_number": "६-५२-२७", "content_sanskrit": "क्रोधाद् द्विगुणताम्राक्षः पितुस्तुल्यपराक्रमः।\nशिलां तां पातयामास धूम्राक्षस्य रथं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000459028, "chapter_id": 9459, "verse_number": "६-५२-२८", "content_sanskrit": "आपतन्तीं शिलां दृष्ट्वा गदामुद्यम्य सम्भ्रमात्।\nरथादाप्लुत्य वेगेन वसुधायां व्यतिष्ठत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000459029, "chapter_id": 9459, "verse_number": "६-५२-२९", "content_sanskrit": "सा प्रमथ्य रथं तस्य निपपात शिला भुवि।\nसचक्रकूबरं साश्वं सध्वजं सशरासनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000459030, "chapter_id": 9459, "verse_number": "६-५२-३०", "content_sanskrit": "स भङ्‍क्त्वा तु रथं तस्य हनूमान् मारुतात्मजः।\nरक्षसां कदनं चक्रे सस्कन्धविटपैर्द्रुमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000459031, "chapter_id": 9459, "verse_number": "६-५२-३१", "content_sanskrit": "विभिन्नशिरसो भूत्वा राक्षसा रुधिरोक्षिताः।\nद्रुमैः प्रमथिताश्चान्ये निपेतुर्धरणीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000459032, "chapter_id": 9459, "verse_number": "६-५२-३२", "content_sanskrit": "विद्राव्य राक्षसं सैन्यं हनूमान् मारुतात्मजः।\nगिरेः शिखरमादाय धूम्राक्षमभिदुद्रुवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000459033, "chapter_id": 9459, "verse_number": "६-५२-३३", "content_sanskrit": "तमापतन्तं धूम्राक्षो गदामुद्यम्य वीर्यवान्।\nविनर्दमानः सहसा हनूमन्तमभिद्रवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000459034, "chapter_id": 9459, "verse_number": "६-५२-३४", "content_sanskrit": "तस्य क्रुद्धस्य रोषेण गदां तां बहुकण्टकाम्।\nपातयामास धूम्राक्षो मस्तकेऽथ हनूमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000459035, "chapter_id": 9459, "verse_number": "६-५२-३५", "content_sanskrit": "ताडितः स तया तत्र गदया भीमवेगया।\nस कपिर्मारुतबलस्तं प्रहारमचिन्तयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000459036, "chapter_id": 9459, "verse_number": "६-५२-३६", "content_sanskrit": "धूम्राक्षस्य शिरोमध्ये गिरिशृङ्गमपातयत्।\nस विस्फारितसर्वाङ्गो गिरिशृङ्गेण ताडितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000459037, "chapter_id": 9459, "verse_number": "६-५२-३७", "content_sanskrit": "पपात सहसा भूमौ विकीर्ण इव पर्वतः।\nधूम्राक्षं निहतं दृष्ट्वा हतशेषा निशाचराः।\nत्रस्ताः प्रविविशुर्लङ्कां वध्यमानाः प्लवंगमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000459038, "chapter_id": 9459, "verse_number": "६-५२-३८", "content_sanskrit": "स तु पवनसुतो निहत्य शत्रून्\nक्षतजवहाः सरितश्च संविकीर्य।\nरिपुवधजनितश्रमो महात्मा\nमुदमगमत् कपिभिः सुपूज्यमानः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000459039, "chapter_id": 9459, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे द्विपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]