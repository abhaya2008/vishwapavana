[{"id": 2021803, "chapter_id": 1451, "verse_number": "३-८९-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2021804, "chapter_id": 1451, "verse_number": "३-८९-१", "content_sanskrit": "एवं संभाषमाणे तु धौम्ये कौरवनन्दन।\nलोमशः स महातेजा ऋषिस्तत्राजगाम ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2021805, "chapter_id": 1451, "verse_number": "३-८९-२", "content_sanskrit": "तं पाण्डवाग्रजो राजा सगणो ब्राह्मणाश्च ते।\nउपातिष्ठन्महाभागं दिवि शक्रमिवामराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2021806, "chapter_id": 1451, "verse_number": "३-८९-३", "content_sanskrit": "समभ्यर्च्य यथान्यायं धर्मपुत्रो युधिष्ठिरः।\nपप्रच्छागमने हेतुमटने च प्रयोजनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2021807, "chapter_id": 1451, "verse_number": "३-८९-४", "content_sanskrit": "स पृष्टः पाण्डुपुत्रेण प्रीयमाणो महामनाः।\nउवाच श्लक्ष्णया वाचा हर्षयन्निव पाण्डवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2021808, "chapter_id": 1451, "verse_number": "३-८९-५", "content_sanskrit": "संचरन्नस्मि कौन्तेय सर्वांल्लोकान्यदृच्छया।\nगतः शक्रस्य भवनं तत्रापश्यं सुरेश्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2021809, "chapter_id": 1451, "verse_number": "३-८९-६", "content_sanskrit": "तव च भ्रातरं वीरमपश्यं सव्यसाचिनम्।\nशक्रस्यार्धासनगतं तत्र मे विस्मयो महान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2021810, "chapter_id": 1451, "verse_number": "३-८९-७", "content_sanskrit": "आसीत्पुरुषशार्दूल दृष्ट्वा पार्थं तथागतम्।\nआह मां तत्र देवेशो गच्छ पाण्डुसुतान्प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2021811, "chapter_id": 1451, "verse_number": "३-८९-८", "content_sanskrit": "सोऽहमभ्यागतः क्षिप्रं दिदृक्षस्त्वां सहानुजम्।\nवचनात्पुरुहूतस्य पार्थस् च महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2021812, "chapter_id": 1451, "verse_number": "३-८९-९", "content_sanskrit": "आख्यास्ये ते प्रियं तात महत्पाण्डवनन्दन।\nभ्रातृभिः सहितो राजन्कृष्णया चैव तच्छृणु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2021813, "chapter_id": 1451, "verse_number": "३-८९-१०", "content_sanskrit": "यत्त्वयोक्तो महाबाहुरस्त्रार्थं भरतर्षभ।\nतदस्त्रमाप्तं पार्थेन रुद्रादप्रतिमं विभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2021814, "chapter_id": 1451, "verse_number": "३-८९-११", "content_sanskrit": "यत्तद्ब्रह्मशिरो नाम तपसा रुद्रमागमत्।\nअमृतादुत्थितं रौद्रं तल्लब्धं सव्यसाचिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2021815, "chapter_id": 1451, "verse_number": "३-८९-१२", "content_sanskrit": "तत्समन्त्रं ससंहारं सप्रायश्चित्तमङ्गलम्।\nवज्रमस्त्राणि चान्यानि दण्डादीनि युधिष्ठिर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2021816, "chapter_id": 1451, "verse_number": "३-८९-१३", "content_sanskrit": "यमात्कुबेराद्वरुणादिन्द्राच्च कुरुनन्दन।\nअस्त्राण्यधीतवान्पार्थो दिव्यान्यमितविक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2021817, "chapter_id": 1451, "verse_number": "३-८९-१४", "content_sanskrit": "विश्वावसोस्तु तनयाद्गीतं नृत्यं च साम च।\nवादित्रं च यथान्यायं प्रत्यविन्दद्यथाविधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2021818, "chapter_id": 1451, "verse_number": "३-८९-१५", "content_sanskrit": "एवं कृतास्त्रः कौन्तेयो गान्धर्वं वेदमात्मवान्।\nसुखं वसति बीभत्सुरनुजस्यानुजस्तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2021819, "chapter_id": 1451, "verse_number": "३-८९-१६", "content_sanskrit": "यदर्थं मां सुरश्रेष्ठ इदं वचनमब्रवीत्।\nतच्च ते कथयिष्यामि युधिष्ठिर निबोध मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2021820, "chapter_id": 1451, "verse_number": "३-८९-१७", "content_sanskrit": "भवान्मनुष्यलोकेऽपि गमिष्यति न संशयः।\nब्रूयाद्युधिष्ठिरं तत्रवचनान्मे द्विजोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2021821, "chapter_id": 1451, "verse_number": "३-८९-१८", "content_sanskrit": "आगमिष्यति ते भ्राता कृतास्त्रः क्षिप्रमर्जुनः।\nसुरकार्यं महत्कृत्वा यदशक्यं दिवौकसैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2021822, "chapter_id": 1451, "verse_number": "३-८९-१९", "content_sanskrit": "तपसाऽपि त्वमात्मानं योजय भ्रातृभिः सह।\nतपसो हि परं नास्ति तपसा विन्दते महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2021823, "chapter_id": 1451, "verse_number": "३-८९-२०", "content_sanskrit": "अहं च कर्णं जानामि यथावद्भरतर्षभ।\nसत्यसन्धं महोत्साहं महावीर्यं महाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2021824, "chapter_id": 1451, "verse_number": "३-८९-२१", "content_sanskrit": "महाहवेष्वप्रतिमं महायुद्धविशारदम्।\nमहाधनुर्धरं वीरं महास्त्रं वरवर्णिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2021825, "chapter_id": 1451, "verse_number": "३-८९-२२", "content_sanskrit": "महेश्वरसुतप्रख्यमादित्यतनयं प्रभुम्।\nतथाऽर्जुनमतिस्कन्धं सहजोल्वणपौरुणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2021826, "chapter_id": 1451, "verse_number": "३-८९-२३", "content_sanskrit": "न स पार्तस्य संग्रामे कलामर्हति षोडशीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2021827, "chapter_id": 1451, "verse_number": "३-८९-२४", "content_sanskrit": "यच्चापि ते भयं कर्णान्मनसिस्थमरिंदम।\nतच्चाप्यपहरिष्यामि सव्यसाचिन्युपागते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2021828, "chapter_id": 1451, "verse_number": "३-८९-२५", "content_sanskrit": "यच्च ते मानसं वीर तीर्थयात्रामिमां प्रति।\nस महर्षिर्लोमशस्ते कथयिष्यत्यसंशयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2021829, "chapter_id": 1451, "verse_number": "३-८९-२६", "content_sanskrit": "यच्च किंचित्तपोयुक्तं फलं तीर्थेषु भारत।\nब्रह्मर्षिरेष ब्रूयात्ते न तच्छ्रद्धेयमन्यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2021830, "chapter_id": 1451, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्तयात्रापर्वणि एकोननवतितमोऽध्यायः ॥ ८९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]