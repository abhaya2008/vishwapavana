[{"id": 2083677, "chapter_id": 2784, "verse_number": "१२-२८९-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2083678, "chapter_id": 2784, "verse_number": "१२-२८९-१", "content_sanskrit": "पितामह महाप्राज्ञ सर्वशास्त्रविशारद।\nअस्मिन्वृत्रवधे तात विवक्षा मम जायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2083679, "chapter_id": 2784, "verse_number": "१२-२८९-२", "content_sanskrit": "ज्वरेण मोहितो वृत्रः कथितस्ते जनाधिप।\nनिहतो वासवेनेह वज्रेणेति ममानघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2083680, "chapter_id": 2784, "verse_number": "१२-२८९-३", "content_sanskrit": "कथमेष महाप्राज्ञ ज्वरः प्रादुर्बभूव ह।\nज्वरोत्पत्तिं निपुणतः श्रोतुमिच्छाम्यहं प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2083681, "chapter_id": 2784, "verse_number": "१२-२८९-४x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2083682, "chapter_id": 2784, "verse_number": "१२-२८९-४", "content_sanskrit": "शृणु राजञ्ज्वरस्येमं संभवं लोकविश्रुतम्।\nविस्तरं चास्य वक्ष्यामि यादृशश्चैव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2083683, "chapter_id": 2784, "verse_number": "१२-२८९-५", "content_sanskrit": "पुरा मेरोर्महाराज शृङ्गं त्रैलोक्यविश्रुतम्।\nज्योतिष्कं नाम सावित्रं सर्वरत्नविभूषितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2083684, "chapter_id": 2784, "verse_number": "१२-२८९-६", "content_sanskrit": "अप्रमेयमनाधृष्यं सर्वलोकेषु भारत।\nतत्र देवो गिरितटे हेमधातुविभूषिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2083685, "chapter_id": 2784, "verse_number": "१२-२८९-७", "content_sanskrit": "पर्यङ्क इव विभ्राजन्नुपविष्टो बभूव ह।\nशैलराजसुता चास्य नित्यं पार्श्वे स्थिता बभौ।\nतथा देवा महात्मानो वसवश्चामितौजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2083686, "chapter_id": 2784, "verse_number": "१२-२८९-८", "content_sanskrit": "तथैव च महात्मानावश्विनौ भिषजां वरौ।\nतथा वैश्रवणो राजा गुह्यकैरभिसंवृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2083687, "chapter_id": 2784, "verse_number": "१२-२८९-९", "content_sanskrit": "यक्षाणामीश्वरः श्रीमान्कैलासनिलयः प्रभुः।\n`शङ्खपद्मनिधिभ्यां च लक्ष्म्या परमया सह।\nउपासन्त महात्मानमुशना च महाकविः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2083688, "chapter_id": 2784, "verse_number": "१२-२८९-१०", "content_sanskrit": "सनत्कुमारप्रमुखास्तथैव च महर्षयः।\nअङ्गिरः प्रमुखाश्चैव तथा देवर्षयोऽपरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2083689, "chapter_id": 2784, "verse_number": "१२-२८९-११", "content_sanskrit": "विश्वावसुश्च गन्धर्वस्तथा नारदपर्वतौ।\nअप्सरोगणसङ्घाश्च समाजग्मुरनेकशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2083690, "chapter_id": 2784, "verse_number": "१२-२८९-१२", "content_sanskrit": "ववौ सुखः शिवो वायुर्नानागन्धवहः शुचिः।\nसर्वर्तुकुसुमोपेताः पुष्पवन्तो द्रुमास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2083691, "chapter_id": 2784, "verse_number": "१२-२८९-१३", "content_sanskrit": "तथा विद्याधराश्चैव सिद्धाश्चैव तपोधनाः।\nमहादेवं पशुपतिं पर्युपासन्त भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2083692, "chapter_id": 2784, "verse_number": "१२-२८९-१४", "content_sanskrit": "भूतानि च महाराज नानारूपधराण्यथ।\nराक्षसाश्च महारौद्राः पिशाचाश्च महाबलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2083693, "chapter_id": 2784, "verse_number": "१२-२८९-१५", "content_sanskrit": "बहुरूपधरा हृष्टा नानाप्रहरणोद्यताः।\nदेवस्यानुचरास्तत्र तस्थिरे चानलोपमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2083694, "chapter_id": 2784, "verse_number": "१२-२८९-१६", "content_sanskrit": "नन्दी च भगवांस्तत्र देवस्यानुमते स्थितः।\nप्रगृह्य ज्वलितं शूलं दीप्यमानं स्वतेजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2083695, "chapter_id": 2784, "verse_number": "१२-२८९-१७", "content_sanskrit": "गङ्गा च सरितां श्रेष्ठा सर्वतीर्थजलोद्भवा।\nपर्युपासत तं देव रूपिणी कुरुनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2083696, "chapter_id": 2784, "verse_number": "१२-२८९-१८", "content_sanskrit": "स एवं भगवांस्तत्र पूज्यमानः सुरर्षिभिः।\nदेवैश्च सुमहातेजा महादेवो व्यतिष्ठत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2083697, "chapter_id": 2784, "verse_number": "१२-२८९-१९", "content_sanskrit": "कस्यचित्त्वथ कालस्य दक्षो नाम प्रजापतिः।\nपूर्वोक्तेन विधानेन यक्ष्यमाणोऽन्वपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2083698, "chapter_id": 2784, "verse_number": "१२-२८९-२०", "content_sanskrit": "ततस्तस्य मखं देवाः सर्वे शक्रपुरोगमाः।\nगमनाय समागम्य बुद्धिमापेदिरे तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2083699, "chapter_id": 2784, "verse_number": "१२-२८९-२१", "content_sanskrit": "ते विमानैर्महात्मानो ज्वलनार्कसमप्रभैः।\nदेवस्यानुमतेऽगच्छन्गङ्गाद्वारमिति श्रुतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2083700, "chapter_id": 2784, "verse_number": "१२-२८९-२२", "content_sanskrit": "प्रस्थिता देवता दृष्ट्वा शैलराजसुता तदा।\nउवाच वचनं साध्वी देवं पशुपतिं पतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2083701, "chapter_id": 2784, "verse_number": "१२-२८९-२३", "content_sanskrit": "भगवन्क्वनु यान्त्येते देवाः शक्रपुरोगमाः।\nब्रूहि तत्त्वेन तत्त्वज्ञ संशयो मे महानयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2083702, "chapter_id": 2784, "verse_number": "१२-२८९-२४x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2083703, "chapter_id": 2784, "verse_number": "१२-२८९-२४", "content_sanskrit": "दक्षो नाम महाभागे प्रजानां पतिरुत्तमः।\nहयमेधेन जयते तत्र यान्ति दिवौकसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2083704, "chapter_id": 2784, "verse_number": "१२-२८९-२५x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2083705, "chapter_id": 2784, "verse_number": "१२-२८९-२५", "content_sanskrit": "यज्ञमेतं महादेव किमर्थं नाधिगच्छति।\nकेन वा प्रतिषेधेन गमनं ते न विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2083706, "chapter_id": 2784, "verse_number": "१२-२८९-२६x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2083707, "chapter_id": 2784, "verse_number": "१२-२८९-२६", "content_sanskrit": "सुरैरेव महाभागे पूर्वमेतदनुष्ठितम्।\nयज्ञेषु सर्वेषु मम न भाग उपकल्पितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2083708, "chapter_id": 2784, "verse_number": "१२-२८९-२७", "content_sanskrit": "पूर्वोपायोपपन्नेन मार्गेण वरवर्णिनि।\nन मे सुराः प्रयच्छन्ति भागं यज्ञस्य धर्मतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2083709, "chapter_id": 2784, "verse_number": "१२-२८९-२८x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2083710, "chapter_id": 2784, "verse_number": "१२-२८९-२८", "content_sanskrit": "भगवन्सर्वभूतेषु प्रभावाभ्यधिको गुणैः।\nअजय्यश्चाप्यधृष्यश्च तेजसा यशसा श्रिया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2083711, "chapter_id": 2784, "verse_number": "१२-२८९-२९", "content_sanskrit": "अनेन ते महाभाग प्रतिषेधेन भागतः।\nअतीव दुःखमुत्पन्नं वेपथुश्च ममानघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2083712, "chapter_id": 2784, "verse_number": "१२-२८९-३०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2083713, "chapter_id": 2784, "verse_number": "१२-२८९-३०", "content_sanskrit": "एवमुक्त्वा तु सा देवी देवं पशुपतिं पतिम्।\nतुष्णींभूताऽभवद्राजन्दह्यमानेन चेतसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2083714, "chapter_id": 2784, "verse_number": "१२-२८९-३१", "content_sanskrit": "अथ देव्या मतं ज्ञात्वा हृद्गतं यच्चिकीर्षितम्।\nस समाज्ञापयामास तिष्ठ त्वमिति नन्दिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2083715, "chapter_id": 2784, "verse_number": "१२-२८९-३२", "content_sanskrit": "ततो योगबलं कृत्वा सर्वयोगेश्वरेश्वरः।\nतं यज्ञं स महातेजा भीमैरनुचरैस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2083716, "chapter_id": 2784, "verse_number": "१२-२८९-३३", "content_sanskrit": "सहसा घातयामास देवदेवः पिनाकधृत्।\nकेचिन्नादानमुञ्चन्त केचिद्धासांश्च चक्रिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2083717, "chapter_id": 2784, "verse_number": "१२-२८९-३४", "content_sanskrit": "रुधिरेणापरे राजंस्तत्राग्निं समवाकिरन्।\nकेचिद्यूपान्समुत्पाट्य व्याक्षिपन्विकृताननाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2083718, "chapter_id": 2784, "verse_number": "१२-२८९-३५", "content_sanskrit": "आस्यैरन्ये चाग्रसन्त तथैव परिचारकान्।\nततः स यज्ञो नृपतेर्वध्यमानः समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2083719, "chapter_id": 2784, "verse_number": "१२-२८९-३६", "content_sanskrit": "आस्थाय मृगरूपं वै स्वमेवाभ्यगमत्तदा।\nतं तु यज्ञं तथारूपं गच्छन्तमुपलभ्य सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2083720, "chapter_id": 2784, "verse_number": "१२-२८९-३७", "content_sanskrit": "धनुरादाय बाणेन तदान्वसरत प्रभुः।\nततस्तस्य सुरेशस्य क्रोधादमिततेजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2083721, "chapter_id": 2784, "verse_number": "१२-२८९-३८", "content_sanskrit": "ललाटात्प्रसृतो घोरः स्वेदबिन्दुर्बभूव ह।\nतस्मिन्यतितमात्रे च स्वेदबिन्दौ तदा भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2083722, "chapter_id": 2784, "verse_number": "१२-२८९-३९", "content_sanskrit": "प्रादुर्बभूव सुमहानग्निः कालानलोपमः।\nतत्र चाजायत तदा पुरुषः पुरुषर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2083723, "chapter_id": 2784, "verse_number": "१२-२८९-४०", "content_sanskrit": "ह्रस्वोऽतिमात्रं रक्ताक्षो हरिश्मश्रुर्विभीषणः।\nऊर्ध्वकेशोऽतिरोमाङ्गः श्येनोलूकस्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2083724, "chapter_id": 2784, "verse_number": "१२-२८९-४१", "content_sanskrit": "करालकृष्णवर्णश्च रक्तवासास्तथैव च।\nतं यज्ञं सुमहासत्वोऽदहत्कक्षमिवानलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2083725, "chapter_id": 2784, "verse_number": "१२-२८९-४२", "content_sanskrit": "व्यचरत्सर्वतो देवान्प्राद्रवत्स ऋषींस्तथा।\nदेवाश्चाप्याद्रवन्सर्वे ततो भीता दिशो दश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2083726, "chapter_id": 2784, "verse_number": "१२-२८९-४३", "content_sanskrit": "तेन तस्मिन्विचरता पुरुषेण विशांपते।\nपृथिवी ह्यचलद्राजन्नतीव भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2083727, "chapter_id": 2784, "verse_number": "१२-२८९-४४", "content_sanskrit": "हाहाभूतं जगत्सर्वमुपलक्ष्य तदा प्रभुः।\nपितामहो महादेवं दर्शयन्प्रत्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2083728, "chapter_id": 2784, "verse_number": "१२-२८९-४५x", "content_sanskrit": "ब्रह्मोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2083729, "chapter_id": 2784, "verse_number": "१२-२८९-४५", "content_sanskrit": "भवतोपि सुराः सर्वे भागं दास्यन्ति वै प्रभो।\nक्रियतां प्रतिसंहारः सर्वदेवेश्वर त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2083730, "chapter_id": 2784, "verse_number": "१२-२८९-४६", "content_sanskrit": "इमा हि देवताः सर्वा ऋषयश्च परंतप।\nतव क्रोधान्महादेव न शान्तिमुपलेभिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2083731, "chapter_id": 2784, "verse_number": "१२-२८९-४७", "content_sanskrit": "यश्चैष पुरुषो जातः स्वेदात्ते विबुधोत्तम।\nज्वरो नामैष धर्मज्ञ लोकेषु प्रचरिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2083732, "chapter_id": 2784, "verse_number": "१२-२८९-४८", "content_sanskrit": "एकीभूतस्य न त्वस्य धारणे तेजसः प्रभो।\nसमर्था सकला पृथ्वी बहुधा सृज्यतामयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2083733, "chapter_id": 2784, "verse_number": "१२-२८९-४९", "content_sanskrit": "इत्युक्तो ब्रह्मणा देवो भागे चापि प्रकल्पिते।\nभगवन्तं तथेत्याह ब्रह्माणममितौजसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2083734, "chapter_id": 2784, "verse_number": "१२-२८९-५०", "content_sanskrit": "परां च प्रीतिमगमदुत्स्मयंश्च पिनाकधृत्।\nअवाप च तदा भागं यथोक्तं ब्रह्मणा भवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2083735, "chapter_id": 2784, "verse_number": "१२-२८९-५१", "content_sanskrit": "ज्वरं च सर्वधर्मज्ञो बहुधा व्यसृजत्तदा।\nशान्त्यर्थं सर्वभूतानां शृणु तच्चापि पुत्रक॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2083736, "chapter_id": 2784, "verse_number": "१२-२८९-५२", "content_sanskrit": "शीर्षाभितापो नागानां पर्वतानां शिलाजतु।\nअपां तु नीलिकां विद्धि निर्मोकं भुजगेषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2083737, "chapter_id": 2784, "verse_number": "१२-२८९-५३", "content_sanskrit": "खोरकः सौरभेयाणामूषरं पृथिवीतले।\nपशूनामपि धर्मज्ञ दृष्टिप्रत्यवरोधनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2083738, "chapter_id": 2784, "verse_number": "१२-२८९-५४", "content_sanskrit": "रन्ध्रागतमथाश्वानां शिखोद्भेदश्च बर्हिणाम्।\nनेत्ररोगः कोकिलानां ज्वरः प्रोक्तो महात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2083739, "chapter_id": 2784, "verse_number": "१२-२८९-५५", "content_sanskrit": "अवीनां पित्तभेदश्च सर्वेषामिति नः श्रुतम्।\nशुकानामपि सर्वेषां हिक्किका प्रोच्यते ज्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2083740, "chapter_id": 2784, "verse_number": "१२-२८९-५६", "content_sanskrit": "शार्दूलष्वथ धर्मज्ञ श्रमो ज्वर इहोच्यते।\nमानुषेषु तु धर्मज्ञ ज्वरो नामैष विश्रुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2083741, "chapter_id": 2784, "verse_number": "१२-२८९-५७", "content_sanskrit": "मरणे जन्मनि तथा मध्ये चाविशते नरम्।\nएतन्माहेश्वरं तेजो ज्वरो नाम सुदारुणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2083742, "chapter_id": 2784, "verse_number": "१२-२८९-५८", "content_sanskrit": "नमस्यश्चैव मान्यश्च सर्वप्राणिभिरीश्वरः।\nअनेन हि समाविष्टो वृत्रो धर्मभूतां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2083743, "chapter_id": 2784, "verse_number": "१२-२८९-५९", "content_sanskrit": "व्यजृम्भत ततः शक्रस्तस्मै वज्रमवासृजत्।\nप्रविश्य बज्रं वृत्रं च दारयामासं भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2083744, "chapter_id": 2784, "verse_number": "१२-२८९-६०", "content_sanskrit": "दारितश्च स वज्रेण महायोगी महासुरः।\nजगाम परमं स्थानं विष्णोरमिततेजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2083745, "chapter_id": 2784, "verse_number": "१२-२८९-६१", "content_sanskrit": "विष्णुभक्त्या हि तेनेदं जगद्व्याप्तमभूत्पुरा।\nतस्माच्च निहतो युद्धे विष्णोः स्थानमवाप्तवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2083746, "chapter_id": 2784, "verse_number": "१२-२८९-६२", "content_sanskrit": "इत्येष वृत्रमाश्रित्य ज्वरस्य महतो मया।\nविस्तरः कथितः पुत्र किमन्यत्प्रब्रवीमि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2083747, "chapter_id": 2784, "verse_number": "१२-२८९-६३", "content_sanskrit": "इमां ज्वरोत्पत्तिमदीनमानसः\nपठेत्सदा यः सुसमाहितो नरः।\nविमुक्तरोगः स सुखी मुदा युतो\nलभेत कामान्स यथा मनीषितान्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2083748, "chapter_id": 2784, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि एकोननवत्यधिकद्विशततमोऽध्यायः॥ २८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}]