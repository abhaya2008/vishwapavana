[{"id": 7004098000, "chapter_id": 24098, "verse_number": "४-४७-१", "content_sanskrit": "स्कंद उवाच ।\nअथोत्तरस्यामाशायां कुंडमर्काख्यमुत्तमम् ।\nतत्र नाम्नोत्तरार्केण रश्मिमाली व्यवस्थितः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004098001, "chapter_id": 24098, "verse_number": "४-४७-२", "content_sanskrit": "तापयन्दुःखसंघातं साधूनाप्याययन्रविः ।\nउत्तरार्को महातेजाः काशीं रक्षति सर्वदा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004098002, "chapter_id": 24098, "verse_number": "४-४७-३", "content_sanskrit": "तत्रेतिहासो यो वृत्तस्तं निशामय सुव्रत ।\nविप्रः प्रियव्रतो नाम कश्चिदात्रेय वंशजः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004098003, "chapter_id": 24098, "verse_number": "४-४७-४", "content_sanskrit": "आसीत्काश्यां शुभाचारः सदातिथिजनप्रियः ।\nभार्या शुभव्रता तस्य बभूवातिमनोहरा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004098004, "chapter_id": 24098, "verse_number": "४-४७-५", "content_sanskrit": "भर्तृशुश्रूषणरता गृहकर्मसुपेशला ।\nतस्यां स जनयामास कन्यामेकां सुलक्षणाम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004098005, "chapter_id": 24098, "verse_number": "४-४७-६", "content_sanskrit": "मूलर्क्षप्रथमेपादे तथा केंद्रे बृहस्पतौ ।\nववृधे सा गृहे पित्रोः शुक्ले पक्षे यथा शशी ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004098006, "chapter_id": 24098, "verse_number": "४-४७-७", "content_sanskrit": "सुरूपा विनयाचारा पित्रोश्च प्रियकारिणी ।\nअतीव निपुणा जाता गृहोपस्करमार्जने ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004098007, "chapter_id": 24098, "verse_number": "४-४७-८", "content_sanskrit": "यथायथा समैधिष्ट सा कन्या पितृमंदिरे ।\nतथातथा पितुस्तस्याश्चिंता संववृधेतराम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004098008, "chapter_id": 24098, "verse_number": "४-४७-९", "content_sanskrit": "कस्मै देया वरा कन्या सुरम्येयं सुलक्षणा ।\nअस्या अनुगुणो लभ्यः क्व मया वर उत्तमः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004098009, "chapter_id": 24098, "verse_number": "४-४७-१०", "content_sanskrit": "कुलेन वयसा चापि शीलेनापि श्रुतेन च ।\nरूपेणार्थेनसंयुक्तः कस्मै दत्ता सुखं लभेत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004098010, "chapter_id": 24098, "verse_number": "४-४७-११", "content_sanskrit": "इति चिंतयतस्तस्य ज्वरोभूदतिदारुणः ।\nयश्चिंताख्यो ज्वरः पुंसामौषधैर्नापि शाम्यति ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004098011, "chapter_id": 24098, "verse_number": "४-४७-१२", "content_sanskrit": "तन्मूलर्क्षविपाकेन चिंताख्येन ज्वरेण च ।\nस विप्रः पंचतां प्राप्तस्त्यक्त्वा सर्वं गृहादिकम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004098012, "chapter_id": 24098, "verse_number": "४-४७-१३", "content_sanskrit": "पितर्युपरते तस्याः कन्यायाः सा जनन्यपि ।\nशुभव्रता परित्यज्य तां कन्यां पतिमन्वगात् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004098013, "chapter_id": 24098, "verse_number": "४-४७-१४", "content_sanskrit": "धर्मोयं सहचारिण्या जीवताजीवतापि वा ।\nपत्या सहैव स्थातव्यं पतिव्रतयुजा सदा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004098014, "chapter_id": 24098, "verse_number": "४-४७-१५", "content_sanskrit": "नापत्यं पाति नो माता न पिता नैव बांधवाः ।\nपत्युश्चरणशुश्रूषा पायाद्वै केवलं स्त्रियम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004098015, "chapter_id": 24098, "verse_number": "४-४७-१६", "content_sanskrit": "सुलक्षणापि दुःखार्ता पित्रोः पंचत्वमाप्तयोः ।\nऔर्ध्वदैहिकमापाद्य दशाहं विनिवर्त्य च ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004098016, "chapter_id": 24098, "verse_number": "४-४७-१७", "content_sanskrit": "चिंतामवाप महतीमनाथा दैन्यमागता ।\nकथमेकाकिनी पित्रा मात्राहीना भवांबुधेः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004098017, "chapter_id": 24098, "verse_number": "४-४७-१८", "content_sanskrit": "दुस्तरं पारमाप्स्यामि स्त्रीत्वं सर्वाभिभावि यत् ।\nन कस्मैचिद्वरायाहं पितृभ्यां प्रतिपादिता ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004098018, "chapter_id": 24098, "verse_number": "४-४७-१९", "content_sanskrit": "तददत्ता कथं स्वैरमहमन्यं वरं वृणे ।\nवृतोपि न कुलीनश्चेद्गुणवान्न च शीलवान् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004098019, "chapter_id": 24098, "verse_number": "४-४७-२०", "content_sanskrit": "स्वाधीनोपि न तत्तेन वृतेनापि हि किं भवेत् ।\nइति संचिंतयंती सा रूपौदार्यगुणान्विता ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004098020, "chapter_id": 24098, "verse_number": "४-४७-२१", "content_sanskrit": "युवभिर्बहुभिर्नित्यं प्रार्थितापि मुहुर्मुहुः ।\nन कस्यापि ददौ बाला प्रवेशं निज मानसे ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004098021, "chapter_id": 24098, "verse_number": "४-४७-२२", "content_sanskrit": "पित्रोरुपरतिं दृष्ट्वा वात्सल्यं च तथाविधम् ।\nनिनिंद बहुधात्मानं संसारं च निनिंद ह ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004098022, "chapter_id": 24098, "verse_number": "४-४७-२३", "content_sanskrit": "याभ्यामुत्पादिता चाहं याभ्यां च परिपालिता ।\nपितरौ कुत्र तौ यातौ देहिनो धिगनित्यताम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004098023, "chapter_id": 24098, "verse_number": "४-४७-२४", "content_sanskrit": "अहो देहोप्यहोंगत्वं यथा पित्रोः पुरो मम ।\nइति निश्चित्य सा बाला विजितेंद्रिय मानसा ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004098024, "chapter_id": 24098, "verse_number": "४-४७-२५", "content_sanskrit": "ब्रह्मचर्यं दृढं कृत्वा तप उग्रं चचार ह ।\nउत्तरार्कस्य देवस्य समीपे स्थिरमानसा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004098025, "chapter_id": 24098, "verse_number": "४-४७-२६", "content_sanskrit": "तस्यां तपस्यमानायामेकाच्छागी लघीयसी ।\nतत्र प्रत्यहमागत्य तिष्ठेत्तत्पुरतोऽचला ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004098026, "chapter_id": 24098, "verse_number": "४-४७-२७", "content_sanskrit": "तृणपर्णादिकं किंचित्सायमभ्यवहृत्य सा ।\nतत्कुंडपीतपानीया स्वस्वामिसदनं व्रजेत् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004098027, "chapter_id": 24098, "verse_number": "४-४७-२८", "content_sanskrit": "तत इत्थं व्यतीतासु पंचषा सुसमासु च ।\nलीलया विचरन्देवस्तत्र देव्या सहागतः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004098028, "chapter_id": 24098, "verse_number": "४-४७-२९", "content_sanskrit": "सन्निधावुत्तरार्कस्य तपस्यतीं सुलक्षणाम् ।\nस्थाणुवन्निश्चलां स्थाणुरद्राक्षीत्तपसा कृशाम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004098029, "chapter_id": 24098, "verse_number": "४-४७-३०", "content_sanskrit": "ततो गिरिजया शंभुर्विज्ञप्तः करुणात्मना ।\nवरेणानुगृहाणेमां बंधुहीनां सुमध्यमाम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004098030, "chapter_id": 24098, "verse_number": "४-४७-३१", "content_sanskrit": "शर्वाणीगिरमाकर्ण्य ततः शर्वः कृपानिधिः ।\nसमाधिमीलिताक्षीं तामुवाच वरदो हरः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004098031, "chapter_id": 24098, "verse_number": "४-४७-३२", "content_sanskrit": "सुलक्षणे प्रसन्नोस्मि वरं वरय सुव्रते ।\nचिरं खिन्नासि तपसा कस्तेऽस्तीह मनोरथः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004098032, "chapter_id": 24098, "verse_number": "४-४७-३३", "content_sanskrit": "सापि शंभोर्गिरं श्रुत्वा मुखपीयूषवर्षिणीम् ।\nमहासंतापशमनीं लोचने उदमीलयत् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004098033, "chapter_id": 24098, "verse_number": "४-४७-३४", "content_sanskrit": "त्र्यक्षं प्रत्यक्षमावीक्ष्य वरदानोन्मुखं पुरः ।\nदेवीं च वामभागस्थां प्रणनाम कृतांजलिः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004098034, "chapter_id": 24098, "verse_number": "४-४७-३५", "content_sanskrit": "किं वृणे यावदित्थं सा चिंतयेच्चारुमध्यमा ।\nतावत्तयानिरैक्षिष्ट वराकी बर्करी पुरः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004098035, "chapter_id": 24098, "verse_number": "४-४७-३६", "content_sanskrit": "आत्मार्थं जीवलोकेस्मिन्को न जीवति मानवः ।\nपरं परोपकारार्थं यो जीवति स जीवति ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004098036, "chapter_id": 24098, "verse_number": "४-४७-३७", "content_sanskrit": "अनया मत्तपोवृत्ति साक्षिण्या बह्वनेहसम् ।\nअसेव्यहं तदेतस्यै वरयामि जगत्पतिम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004098037, "chapter_id": 24098, "verse_number": "४-४७-३८", "content_sanskrit": "परामृश्य मनस्येतत्प्राह त्र्यक्षं सुलक्षणा ।\nकृपानिधे महादेव यदि देयो वरो मम ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004098038, "chapter_id": 24098, "verse_number": "४-४७-३९", "content_sanskrit": "अजशावी वराक्येषा तर्हि प्रागनुगृह्यताम् ।\nवक्तुं पशुत्वान्नोवेत्ति किंचिन्मद्भक्तिपेशला ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004098039, "chapter_id": 24098, "verse_number": "४-४७-४०", "content_sanskrit": "इति वाचं निशम्येशः परोपकृतिशालिनीम् ।\nसुलक्षणाया नितरां तुतोष प्रणतार्तिहा ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004098040, "chapter_id": 24098, "verse_number": "४-४७-४१", "content_sanskrit": "देवदवस्ततः प्राह देवि पश्य गिरींद्रजे ।\nसाधूनामीदृशी बुद्धिः परोपकरणोर्जिता ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004098041, "chapter_id": 24098, "verse_number": "४-४७-४२", "content_sanskrit": "ते धन्याः सर्वलोकेषु सर्वधर्माश्रयाश्च ते ।\nयतंते सर्वभावेन परोपकरणाय ये ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004098042, "chapter_id": 24098, "verse_number": "४-४७-४३", "content_sanskrit": "संचयाः सर्ववस्तूनां चिरं तिष्ठति नो क्वचित् ।\nसुचिरं तिष्ठते चैकं परोपकरणं प्रिये ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004098043, "chapter_id": 24098, "verse_number": "४-४७-४४", "content_sanskrit": "धन्या सुलक्षणा चैषा योग्याऽनुग्रहकर्मणि ।\nब्रूहि देवि वरो देयः कोऽस्यैच्छाग्यै च कः प्रिये ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004098044, "chapter_id": 24098, "verse_number": "४-४७-४५", "content_sanskrit": "श्रीदेव्युवाच ।\nसर्वसृष्टिकृतां कर्तः सर्वज्ञप्रणतार्तिहन् ।\nसुलक्षणा शुभाचारा सखी मेस्तु शुभोद्यमा ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004098045, "chapter_id": 24098, "verse_number": "४-४७-४६", "content_sanskrit": "यथा जया च विजया यथा चैव जयंतिका ।\nशुभानंदा सुनंदा च कौमुदी च यथोर्मिला ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004098046, "chapter_id": 24098, "verse_number": "४-४७-४७", "content_sanskrit": "यथा चंपकमाला च यथा मलयवासिनी ।\nकर्पूरलतिका यद्वद्गंधधारा यथा शुभा ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004098047, "chapter_id": 24098, "verse_number": "४-४७-४८", "content_sanskrit": "अशोका च विशोका च यथा मलयगंधिनी ।\nयथा चंदननिःश्वासा यथा मृगमदोत्तमा ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004098048, "chapter_id": 24098, "verse_number": "४-४७-४९", "content_sanskrit": "यथा च कोकिलालापा यथा मधुरभाषिणी ।\nगद्यपद्यनिधिर्यद्वदनुक्तज्ञा यथा च सा ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004098049, "chapter_id": 24098, "verse_number": "४-४७-५०", "content_sanskrit": "दृगंचलेंगितज्ञा च यथा कृतमनोरथा ।\nगानचित्तहरा यद्वत्तथास्त्वेषा सुलक्षणा ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004098050, "chapter_id": 24098, "verse_number": "४-४७-५१", "content_sanskrit": "अतिप्रिया भवित्री मे यद्बाल ब्रह्मचारिणी ।\nअनेनैव शरीरेण दिव्यावयवभूषणा ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004098051, "chapter_id": 24098, "verse_number": "४-४७-५२", "content_sanskrit": "दिव्यांबरा दिव्यगंधा दिव्यज्ञानसमन्विता ।\nसमया मां सदैवास्तां चंचच्चामरधारिणी ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004098052, "chapter_id": 24098, "verse_number": "४-४७-५३", "content_sanskrit": "एषापि काशिराजस्य कुमार्यस्त्विह बर्करी ।\nअत्रैव भोगान्संप्राप्य मुक्तिं प्राप्स्यत्यनुत्तमाम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004098053, "chapter_id": 24098, "verse_number": "४-४७-५४", "content_sanskrit": "अनया त्वर्ककुंडेस्मिन्पुष्ये मासि रवेर्दिने ।\nस्नातं त्वनुदिते सूर्ये शीतादक्षुब्धचित्तया ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004098054, "chapter_id": 24098, "verse_number": "४-४७-५५", "content_sanskrit": "राजपुत्री ततः पुण्यादस्त्वेषा शुभलोचना ।\nवरदानप्रभावेण तव विश्वेश्वर प्रभो ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004098055, "chapter_id": 24098, "verse_number": "४-४७-५६", "content_sanskrit": "बर्करीकुंडमित्याख्या त्वर्ककुंडस्य जायताम् ।\nएतस्याः प्रतिमा पूज्या भविष्यत्यत्र मानवैः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004098056, "chapter_id": 24098, "verse_number": "४-४७-५७", "content_sanskrit": "उत्तरार्कस्य देवस्य पुष्ये मासि रवेर्दिने ।\nकार्या सा वत्सरीयात्रा न तैः काशीफलेप्सुभिः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004098057, "chapter_id": 24098, "verse_number": "४-४७-५८", "content_sanskrit": "मृडान्याभिहि तं सर्वं कृत्वैतद्विश्वगो विभुः ।\nविश्वनाथो विवेशाथ प्रासादं स्वमतर्कितः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004098058, "chapter_id": 24098, "verse_number": "४-४७-५९", "content_sanskrit": "स्कंद उवाच ।\nलोलार्कस्य च माहात्म्यमुत्तरार्कस्य च द्विज ।\nकथितं ते महाभाग सांबादित्यं निशामय ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004098059, "chapter_id": 24098, "verse_number": "४-४७-६०", "content_sanskrit": "श्रुत्वैतत्पुण्यमाख्यानं शुभं लोलोत्तरार्कयोः ।\nव्याधिभिर्नाभिभूयेत न दारिद्र्येण बाध्यते ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004098060, "chapter_id": 24098, "verse_number": "४-४७-६१", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां चतुर्थे काशीखंडे पूर्वार्द्धे उत्तरार्कवर्णनं नाम सप्तचत्वारिंशोध्यायः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}]