[{"id": 2150814, "chapter_id": 4274, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2150815, "chapter_id": 4274, "verse_number": "१", "content_sanskrit": "नदीनां पर्वतानां च नामधेयानि सञ्जय ।\nतथा जनपदानां च ये चान्ये भूमिमाश्रिताः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2150816, "chapter_id": 4274, "verse_number": "२", "content_sanskrit": "प्रमाणं च प्रमाणज्ञ पृथिव्या अपि सर्वशः ।\nनिखिलेन समाचक्ष्व काननानि च सञ्जय ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2150817, "chapter_id": 4274, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2150818, "chapter_id": 4274, "verse_number": "३", "content_sanskrit": "पञ्चेमानि महाराज महाभूतानि सङ्ग्रहात् ।\nजगत्स्थितानि सर्वाणि समान्याहुर्मनीषिणः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2150819, "chapter_id": 4274, "verse_number": "४", "content_sanskrit": "भूमिरापस्तथा वायुरग्निराकाशमेव च ।\nगुणोत्तराणि सर्वाणि तेषां भूमिः प्रधानतः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2150820, "chapter_id": 4274, "verse_number": "५", "content_sanskrit": "शब्दः स्पर्शश्च रूपं च रसो गन्धश्च पञ्चमः ।\nभूमेरेते गुणाः प्रोक्ता ऋषिभिस्तत्त्ववेदिभिः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2150821, "chapter_id": 4274, "verse_number": "६", "content_sanskrit": "चत्वारोऽप्सु गुणा राजन् गन्धस्तत्र न विद्यते ।\nशब्दः स्पर्शश्च रूपं च तेजसोऽथ गुणास्त्रयः ।\nशब्दः स्पर्शश्च वायोस्तु आकाशे शब्द एव च ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2150822, "chapter_id": 4274, "verse_number": "७", "content_sanskrit": "एते पञ्च गुणा राजन् महाभूतेषु पञ्चसु ।\nवर्तन्ते सर्वलोकेषु येषु लोकाः प्रतिष्ठिताः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2150823, "chapter_id": 4274, "verse_number": "८", "content_sanskrit": "अन्योन्यं नाभिवर्तन्ते साम्यं भवति वै यदा ।\nयदा तु विषमीभावमाविशन्ति परस्परम् ।\nतदा देहैर्देहवन्तो व्यतिरोहन्ति नान्यथा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2150824, "chapter_id": 4274, "verse_number": "९", "content_sanskrit": "आनुपूर्व्याद् विनश्यन्ति जायन्ते चानुपूर्वशः ।\nसर्वाण्यपरिमेयानि तदेषां रूपमैश्वरम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2150825, "chapter_id": 4274, "verse_number": "१०", "content_sanskrit": "तत्र तत्र हि दृश्यन्ते धातवः पाञ्चभौतिकाः ।\nतेषां मनुष्यास्तर्केण प्रमाणानि प्रचक्षते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2150826, "chapter_id": 4274, "verse_number": "११", "content_sanskrit": "अचिन्त्याः खलु ये भावा न तांस्तर्केण साधयेत् ।\nप्रकृतिभ्यः परं यत् तु तदचिन्त्यस्य लक्षणम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2150827, "chapter_id": 4274, "verse_number": "१२", "content_sanskrit": "सुदर्शनं प्रवक्ष्यामि द्वीपं ते कुरुनन्दन ।\nपरिमण्डलो महाराज द्वीपोऽसौ चक्रसंस्थितः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2150828, "chapter_id": 4274, "verse_number": "१३", "content_sanskrit": "नदीजलप्रतिच्छन्नः पर्वतैश्चाभ्रसन्निभैः ।\nपुरैश्च विविधाकारै रम्यैर्जनपदैस्तथा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2150829, "chapter_id": 4274, "verse_number": "१४", "content_sanskrit": "वृक्षैः पुष्पफलोपेतैः सम्पन्नधनधान्यवान् ।\nलावणेन समुद्रेण समन्तात् परिवारितः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2150830, "chapter_id": 4274, "verse_number": "१५", "content_sanskrit": "यथा च पुरुषः पश्येदादर्शे मुखमात्मनः ।\nएवं सुदर्शनद्वीपो दृश्यते चन्द्रमण्डले ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2150831, "chapter_id": 4274, "verse_number": "१६", "content_sanskrit": "द्विरंशः पिप्पलस्तत्र द्विरंशश्च शशो महान् ।\nसर्वौषधिसमावापैः सर्वतः परिबृंहितः ।\nआपस्ततोऽन्या विज्ञेया एष सङ्क्षेप उच्यते ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2150832, "chapter_id": 4274, "verse_number": "६", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां भीष्मपर्वणि षष्ठोऽध्यायः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2150833, "chapter_id": 4274, "verse_number": "", "content_sanskrit": "॥ इति जम्बूखण्डनिर्माणपर्वणि षष्ठोऽध्यायः ॥६॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]