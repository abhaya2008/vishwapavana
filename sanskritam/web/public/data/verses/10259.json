[{"id": 6000259000, "chapter_id": 10259, "verse_number": null, "content_sanskrit": "अथ त्रिषष्टितमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000259001, "chapter_id": 10259, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_063/BhP_10.063.001.m4a", "display_order": 2}, {"id": 6000259002, "chapter_id": 10259, "verse_number": "१०-६३-१", "content_sanskrit": "यथा हतो भगवता भौमो नीता यथा स्‍त्रियः।\nनिरुद्धा यास्तदाचक्ष्व विक्रमं शार्ङ्गधन्वनः॥ १०/६३/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_063/BhP_10.063.002.m4a", "display_order": 3, "topics": [{"text": "कृष्ण-नरकासुरयुद्धम्", "range": "१–२६"}]}, {"id": 6000259003, "chapter_id": 10259, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_063/BhP_10.063.003.m4a", "display_order": 4}, {"id": 6000259004, "chapter_id": 10259, "verse_number": "१०-६३-२", "content_sanskrit": "द्वारवत्यां महाभागे निवसत्यच्युते नृप।\nदीनेनोद्विग्नचित्तेन समागम्य त्रिविष्टपात्॥ १०/६३/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_063/BhP_10.063.004.m4a", "display_order": 5}, {"id": 6000259005, "chapter_id": 10259, "verse_number": "१०-६३-३", "content_sanskrit": "हृतच्छत्रेण शक्रेण हृतकुण्डलबन्धुना।\nहृतामराद्रिस्थानेन ज्ञापितो भौमचेष्टितम्॥ १०/६३/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_063/BhP_10.063.005.m4a", "display_order": 6}, {"id": 6000259006, "chapter_id": 10259, "verse_number": "१०-६३-४", "content_sanskrit": "इन्द्रमाश्वास्य गोविन्दः सुसम्पूज्य विसृज्य च।\nसभार्यो गरुडारूढः प्राग्ज्योतिषपुरं ययौ॥ १०/६३/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_063/BhP_10.063.006.m4a", "display_order": 7}, {"id": 6000259007, "chapter_id": 10259, "verse_number": "१०-६३-५", "content_sanskrit": "हिमाद्रौ तुङ्गशिखरे जलाग्न्यनिलदुर्गमम्।\nगिरिदुर्गं शस्‍त्रदुर्गैर्मुरपाशायुतैर्वृतम्॥ १०/६३/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_063/BhP_10.063.007.m4a", "display_order": 8}, {"id": 6000259008, "chapter_id": 10259, "verse_number": "१०-६३-६", "content_sanskrit": "स सम्प्राप्य भटैर्गुप्तं दानवेन्द्रपुरं महत्।\nगदया निर्बिभेदाद्रिं प्राकाराकारसंस्थितम्॥ १०/६३/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_063/BhP_10.063.008.m4a", "display_order": 9}, {"id": 6000259009, "chapter_id": 10259, "verse_number": "१०-६३-७", "content_sanskrit": "तन्निर्भिद्य प्रविश्यान्तः शस्‍त्रदुर्गाणि सायकैः।\nचकर्त, मौरवं पाशं चक्रेणामन्दमच्छिनत्॥ १०/६३/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_063/BhP_10.063.009.m4a", "display_order": 10}, {"id": 6000259010, "chapter_id": 10259, "verse_number": "१०-६३-८", "content_sanskrit": "क्षुरमालां तथा घोरां निचकर्तासिना हरिः।\nवायव्यास्‍त्रेण सलिलं वारुणास्‍त्रेण पावकम्॥ १०/६३/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_063/BhP_10.063.010.m4a", "display_order": 11}, {"id": 6000259011, "chapter_id": 10259, "verse_number": "१०-६३-९", "content_sanskrit": "हरिर्निमिषमात्रेण नाशयामास भारत।\nशङ्खनादेन तीव्रेण मनांसि च मनस्विनाम्॥ १०/६३/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_063/BhP_10.063.011.m4a", "display_order": 12}, {"id": 6000259012, "chapter_id": 10259, "verse_number": "१०-६३-१०", "content_sanskrit": "पाञ्चजन्यध्वनिं श्रुत्वा युगान्ताशनिभीषणम्।\nमुरः शयान उत्तस्थौ दैत्यः पञ्चशिरा जलात्॥ १०/६३/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_063/BhP_10.063.012.m4a", "display_order": 13}, {"id": 6000259013, "chapter_id": 10259, "verse_number": "१०-६३-११", "content_sanskrit": "त्रिशूलमुद्यम्य सुदुर्निरीक्ष्यो युगान्तसूर्यानलरोचिरुज्ज्वलः।\nग्रसंस्‍त्रिलोकानिव पञ्चभिर्मुखैरभ्यद्रवत् तार्क्ष्यसुतं यथोरगः॥ १०/६३/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_063/BhP_10.063.013.m4a", "display_order": 14}, {"id": 6000259014, "chapter_id": 10259, "verse_number": "१०-६३-१२", "content_sanskrit": "आविध्य शूलं तरसा गरुत्मतेे निरस्य वक्त्रैर्व्यनदन् स पञ्चभिः।\nखं रोदसी सर्वदिशोऽन्तरं महानापूरयन्नण्डकटाहमावृणोत्॥ १०/६३/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_063/BhP_10.063.014.m4a", "display_order": 15}, {"id": 6000259015, "chapter_id": 10259, "verse_number": "१०-६३-१३", "content_sanskrit": "तमापतन्तं त्रिशिखं गरुत्मते चकर्त बाणद्वितयेन केशवः।\nमुखेषु तस्यापि शरान् समर्पयत् पुनर्गदां सोऽप्यमुचन्मधुद्विषे॥ १०/६३/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_063/BhP_10.063.015.m4a", "display_order": 16}, {"id": 6000259016, "chapter_id": 10259, "verse_number": "१०-६३-१४", "content_sanskrit": "तामापतन्तीं गदया गदाग्रजो गदां मृधे निर्बिभिदे सहस्रधा।\nउद्यम्य बाहूनभिधावतो रिपोः शिरांसि चक्रेण जहार लीलया॥ १०/६३/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_063/BhP_10.063.016.m4a", "display_order": 17}, {"id": 6000259017, "chapter_id": 10259, "verse_number": "१०-६३-१५", "content_sanskrit": "व्यसुः पपाताम्भसि कृत्तकन्धरो निकृत्तशृङ्गोऽद्रिरिवेन्द्रतेजसा।\nपपात विष्णोः शिरसि प्रमोदिनी प्रसूनवृष्टिर्निहते मुरेऽसुरे॥ १०/६३/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_063/BhP_10.063.017.m4a", "display_order": 18}, {"id": 6000259018, "chapter_id": 10259, "verse_number": "१०-६३-१६", "content_sanskrit": "तस्यात्मजाः सप्त पितुर्वधातुराश्चिकीर्षवस्तस्य रणे प्रतिक्रियाम्।\nध्रुवश्चरिष्णुः श्रवणो विभावसुर्नभो वसुस्वानरुणश्च सप्त॥ १०/६३/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_063/BhP_10.063.018.m4a", "display_order": 19}, {"id": 6000259019, "chapter_id": 10259, "verse_number": "१०-६३-१७", "content_sanskrit": "रथान् समारुह्य वृषप्रयुक्तान् भौमप्रयुक्ता भवनान्निराक्रमन्।\nप्रयुञ्जतासज्य शरासनान् भटाः शक्त्यर्ष्टिशूलानमिते रुषोल्बणान्॥ १०/६३/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_063/BhP_10.063.019.m4a", "display_order": 20}, {"id": 6000259020, "chapter_id": 10259, "verse_number": "१०-६३-१८", "content_sanskrit": "तच्छस्‍त्रकूटं भगवान् स्वमार्गणैरमोघवीर्यस्तिलशश्चकर्त।\nतान् योद्धुमिच्छूननयद् यमक्षयं निकृत्तशीर्षोरुभुजाङ्घ्रिकार्मुकान्॥ १०/६३/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_063/BhP_10.063.020.m4a", "display_order": 21}, {"id": 6000259021, "chapter_id": 10259, "verse_number": "१०-६३-१९", "content_sanskrit": "ततो द्रुततरं गत्वा भटा राजपुरं महत्।\nहतान् मुरसुतान् सर्वान् नरकाय न्यवेदयन्॥ १०/६३/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_063/BhP_10.063.021.m4a", "display_order": 22}, {"id": 6000259022, "chapter_id": 10259, "verse_number": "१०-६३-२०", "content_sanskrit": "स्वानीकपानच्युतचक्रसायकैर्हतान् निशम्याशु चुकोप भूमिजः।\nनिरीक्ष्य दुर्मर्षण आस्रवन्मदैर्गजैः पयोब्धिप्रभवैर्निराक्रमत्॥ १०/६३/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_063/BhP_10.063.022.m4a", "display_order": 23}, {"id": 6000259023, "chapter_id": 10259, "verse_number": "१०-६३-२१", "content_sanskrit": "रथैरनेकसाहस्रैर्गजैश्च बहुभिर्वृतः।\nमहत्या सेनया युक्तश्चायादायोधनं बली॥ १०/६३/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_063/BhP_10.063.023.m4a", "display_order": 24}, {"id": 6000259024, "chapter_id": 10259, "verse_number": "१०-६३-२२", "content_sanskrit": "दृष्ट्वा सभार्यं गरुडोपरिस्थितं सूर्योपरिष्टात् सतडिद्घनं यथा।\nगृहीतकोदण्डमुदारशङ्खकौमोदकीचक्रधरं चतुर्भुजम्॥ १०/६३/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_063/BhP_10.063.024.m4a", "display_order": 25}, {"id": 6000259025, "chapter_id": 10259, "verse_number": "१०-६३-२३", "content_sanskrit": "नीलजीमूतसङ्काशं दृष्ट्वा तं गजवाहनम्।\nशङ्खमाध्माय गोविन्दः सिंहनादं व्यनीनदत्॥ १०/६३/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_063/BhP_10.063.025.m4a", "display_order": 26}, {"id": 6000259026, "chapter_id": 10259, "verse_number": "१०-६३-२४", "content_sanskrit": "वरूथिनी दैत्यपतेः सुघोरान् शरान् ववर्षाच्युतमूर्ध्नि दुर्जया।\nकृष्णे स भौमो व्यसृजच्छतघ्नीं लोहायसीं तेन भृशं स विव्यथे॥ १०/६३/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_063/BhP_10.063.026.m4a", "display_order": 27}, {"id": 6000259027, "chapter_id": 10259, "verse_number": "१०-६३-२५", "content_sanskrit": "अनेकबाणान् निर्मुक्तान् नरकेण स्मयन्निव।\nचकर्त बाणैर्युगपत् तदद्भुतमिवाभवत्॥ १०/६३/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_063/BhP_10.063.027.m4a", "display_order": 28}, {"id": 6000259028, "chapter_id": 10259, "verse_number": "१०-६३-२६", "content_sanskrit": "ततोऽनु सैन्यं भगवान् गदाग्रजो विचित्रपत्रैर्निशितैः शरौघैः।\nनिकृत्तबाहूरुशिरोङ्घ्रिविग्रहं चकार तूर्णं नृप साश्वकुञ्जरम्॥ १०/६३/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_063/BhP_10.063.028.m4a", "display_order": 29}, {"id": 6000259029, "chapter_id": 10259, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्ध उत्तरार्धे त्रिषष्टितमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]