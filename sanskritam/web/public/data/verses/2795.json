[{"id": 2084309, "chapter_id": 2795, "verse_number": "१२-३००-०x", "content_sanskrit": "पराशर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2084310, "chapter_id": 2795, "verse_number": "१२-३००-१", "content_sanskrit": "प्रतिग्रहार्जिता विप्रे क्षत्रिये युधि निर्जिताः।\nवैश्ये न्यायार्जिताश्चैव शूद्रे शुश्रूषयार्जिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2084311, "chapter_id": 2795, "verse_number": "१२-३००-२", "content_sanskrit": "स्वल्पाऽप्यर्थाः प्रशस्यन्ते धर्मस्यार्थे महाफलाः।\nनित्यं त्रयाणां वर्णानां शुश्रूषुः शूद्र उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2084312, "chapter_id": 2795, "verse_number": "१२-३००-३", "content_sanskrit": "क्षत्रधर्मा वैश्यधर्मा नावृत्तिः पतते द्विजः।\nशूद्रधर्मा यदा तु स्यात्तदा पतति वै द्विजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2084313, "chapter_id": 2795, "verse_number": "१२-३००-४", "content_sanskrit": "वाणिज्यं पाशुपाल्यं च तथा शिल्पोपजिवनम्।\nसूद्रस्यापि विधीयन्ते यदा वृत्तिर्न जायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2084314, "chapter_id": 2795, "verse_number": "१२-३००-५", "content_sanskrit": "रङ्गावतरणं चैव तथा रूपोपजीवनम्।\nमद्यमांसोपजीव्यं च विक्रयं लोहचर्मणोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2084315, "chapter_id": 2795, "verse_number": "१२-३००-६", "content_sanskrit": "अपूर्विणा न कर्तव्यं कर्म लोके विगर्हितम्।\nकृतपूर्विणस्तु त्यजतो महान्धर्म इति श्रूतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2084316, "chapter_id": 2795, "verse_number": "१२-३००-७", "content_sanskrit": "संसिद्धः पुरुषो लोके यदाचरति पापकम्।\nमदेनाभिप्लुतमनास्तच्च न ग्राह्यमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2084317, "chapter_id": 2795, "verse_number": "१२-३००-८", "content_sanskrit": "श्रूयन्ते हि पुराणेषु प्रजा धिग्दण्डशासनाः।\nदान्ता धर्मप्रधानाश्च न्यायधर्मानुवृत्तिकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2084318, "chapter_id": 2795, "verse_number": "१२-३००-९", "content_sanskrit": "धर्म एव सदा नॄणामिह राजन्प्रशस्यते।\nधर्मवृद्धा गुणानेव सेवन्ते हि नरा भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2084319, "chapter_id": 2795, "verse_number": "१२-३००-१०", "content_sanskrit": "तं धर्ममसुरास्तात नामृष्यन्त नराधिप।\nविवर्धमानाः क्रमशस्तत्र तेऽन्वाविशन्प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2084320, "chapter_id": 2795, "verse_number": "१२-३००-११", "content_sanskrit": "तासां दर्पः समभवत्प्रजानां धर्मनाशनः।\nदर्पात्मनां ततः पश्चात्क्रोधस्तासामजायत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2084321, "chapter_id": 2795, "verse_number": "१२-३००-१२", "content_sanskrit": "ततः क्रोधाभिभूतानां वृत्तं लज्जासमन्वितम्।\nह्रीश्चैवाप्यनशद्राजंस्ततो मोहो व्यजायत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2084322, "chapter_id": 2795, "verse_number": "१२-३००-१३", "content_sanskrit": "ततो मोहपरीतास्ता नापश्यन्त यथा पुरा।\nपरस्परावमर्देन वर्धयन्त्यो यथासुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2084323, "chapter_id": 2795, "verse_number": "१२-३००-१४", "content_sanskrit": "ताः प्राप्य तु स धिग्दण्डो न कारणमतो भवत्।\nततोऽभ्यगच्छन्देवांश्च ब्राह्मणांश्चावमन्य ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2084324, "chapter_id": 2795, "verse_number": "१२-३००-१५", "content_sanskrit": "एतस्मिन्नेव काले तु देवा देववरं शिवम्।\nअगच्छञ्शरणं धीरं बहुरूपं गुणाधिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2084325, "chapter_id": 2795, "verse_number": "१२-३००-१६", "content_sanskrit": "तेन स्म ते गगनगाः सपुराः पातिताः क्षितौ।\nत्रिधाऽप्येकेन बाणेन देवाप्यायिततेजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2084326, "chapter_id": 2795, "verse_number": "१२-३००-१७", "content_sanskrit": "तेषामधिपतिस्त्वासीद्भीमो भीमपराक्रमः।\nदेवतानां भयकरः स हतः शूलपाणिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2084327, "chapter_id": 2795, "verse_number": "१२-३००-१८", "content_sanskrit": "तस्मिन्हतेऽथ स्वं भावं प्रत्यपद्यन्त मानवाः।\nप्रावर्तन्त च वै वेदाः शास्त्राणि च यथा पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2084328, "chapter_id": 2795, "verse_number": "१२-३००-१९", "content_sanskrit": "ततोऽभिषिच्य राज्येन देवानां दिवि वासवम्।\nसप्तर्षयश्चान्वयुञ्जन्नराणां दण्डधारणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2084329, "chapter_id": 2795, "verse_number": "१२-३००-२०", "content_sanskrit": "सप्तर्षीणामथोर्ध्वं च विपृथुर्नाम पार्थिवः।\nराजानः क्षत्रियाश्चैव मण्डलेषु पृथक्पृथक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2084330, "chapter_id": 2795, "verse_number": "१२-३००-२१", "content_sanskrit": "महाकुलेषु ये जाता वृद्धाः पूर्वतराश्च ये।\nतेषामप्यासुरो भावो हृदयान्नापसर्पति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2084331, "chapter_id": 2795, "verse_number": "१२-३००-२२", "content_sanskrit": "तस्मात्तेनैव भावेन सानुषङ्गेण पार्थिवाः।\nआसुराण्येव कर्माणि न्यसेवन्भीमविक्रमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2084332, "chapter_id": 2795, "verse_number": "१२-३००-२३", "content_sanskrit": "प्रत्यतिष्ठंश्च तेष्वेव तान्येव स्थापयन्त्यपि।\nभजन्ते तानि चाद्यापि ये बालिशतरा नराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2084333, "chapter_id": 2795, "verse_number": "१२-३००-२४", "content_sanskrit": "तस्मादहं ब्रवीमि त्वां राजन्संचिन्त्य शास्त्रतः।\nसंसिद्धावागमं कुर्यात्कर्म हिंसात्मकं त्यजेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2084334, "chapter_id": 2795, "verse_number": "१२-३००-२५", "content_sanskrit": "न संकरेण द्रविणं प्रचिन्वीयाद्विचक्षणः।\nधर्मार्थं न्यायमुत्सृज्य न तत्कल्याणमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2084335, "chapter_id": 2795, "verse_number": "१२-३००-२६", "content_sanskrit": "स त्वमेवंविधो दान्तः क्षत्रियः प्रियबान्धवः।\nप्रजा भृत्यांश्च पुत्रांश्च स्वधर्मेणानुपालय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2084336, "chapter_id": 2795, "verse_number": "१२-३००-२७", "content_sanskrit": "इष्टानिष्टसमायोगे वैरं सौहार्दमेव च।\nअथ जातिसहस्राणि बहूनि परिवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2084337, "chapter_id": 2795, "verse_number": "१२-३००-२८", "content_sanskrit": "तस्माद्गुणेषु रज्येथा मा दोषेषु कथंचन।\nनिर्गुणोऽपि हि दुर्बुद्धिरात्मनः सोतिरिच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2084338, "chapter_id": 2795, "verse_number": "१२-३००-२९", "content_sanskrit": "मानुषेषु महाराज धर्माधर्मौ प्रवर्ततः।\nन तथाऽन्येषु भूतेषु मनुष्यरहितेष्विह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2084339, "chapter_id": 2795, "verse_number": "१२-३००-३०", "content_sanskrit": "धर्मशीलो नरो विद्वानीहकोऽनीहकोपि वा।\nआत्मभूतः सदा लोके चरेद्भूतान्यहिंसया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2084340, "chapter_id": 2795, "verse_number": "१२-३००-३१", "content_sanskrit": "यदा व्यपेतहृल्लेखं मनो भवति तस्य वै।\nनानृतं चैव भवति तदा कल्याणमृच्छति॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2084341, "chapter_id": 2795, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि त्रिशततमोऽध्यायः॥ ३००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]