[{"id": 2009615, "chapter_id": 1190, "verse_number": "१-१९१-०x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2009616, "chapter_id": 1190, "verse_number": "१-१९१-१", "content_sanskrit": "किंनिमित्तमभूद्वैरं विश्वामित्रवसिष्ठयोः।\nवसतोराश्रमे दिव्ये शंस नः सर्वमेव तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2009617, "chapter_id": 1190, "verse_number": "१-१९१-२x", "content_sanskrit": "गन्धर्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2009618, "chapter_id": 1190, "verse_number": "१-१९१-२", "content_sanskrit": "इदं वासिष्ठमाख्यानं पुराणं परिचक्षते।\nपार्थ सर्वेषु लोकेषु यथावत्तन्निबोध मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2009619, "chapter_id": 1190, "verse_number": "१-१९१-३", "content_sanskrit": "कान्यकुब्जे महानासीत्पार्थिवो भरतर्षभ।\nगाधीति विश्रुतो लोके कुशिकस्यात्मसंभवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2009620, "chapter_id": 1190, "verse_number": "१-१९१-४", "content_sanskrit": "तस्य धर्मात्मनः पुत्रः समृद्धबलवाहनः।\nविश्वामित्र इति ख्यतो बभूव रिपुमर्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2009621, "chapter_id": 1190, "verse_number": "१-१९१-५", "content_sanskrit": "स चचार सहामात्यो मृगयां गहने वने।\nमृगान्विध्यन्वराहांश्च रम्येषु मरुधन्वसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2009622, "chapter_id": 1190, "verse_number": "१-१९१-६", "content_sanskrit": "व्यायामकर्शितः सोऽथ मृगलिप्सुः पिपासितः।\nआजगाम नरश्रेष्ठ वसिष्ठस्याश्रमं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2009623, "chapter_id": 1190, "verse_number": "१-१९१-७", "content_sanskrit": "तमागतमभिप्रेक्ष्य वसिष्ठः श्रेष्ठभागृषिः।\nविश्वामित्रं नरश्रेष्ठं प्रतिजग्राह पूजया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2009624, "chapter_id": 1190, "verse_number": "१-१९१-८", "content_sanskrit": "पाद्यार्घ्याचमनीचैस्तं स्वागतेन च भारत।\nतथैव परिजग्राह वन्येन हविषा तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2009625, "chapter_id": 1190, "verse_number": "१-१९१-९", "content_sanskrit": "तस्याथ कामधुग्धेनुर्वसिष्ठस्य महात्मनः।\nउक्ता कामान्प्रयच्छेति सा कामान्दुदुहे ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2009626, "chapter_id": 1190, "verse_number": "१-१९१-१०", "content_sanskrit": "बाष्पाढ्यस्योदनस्यैव राशयः पर्वतोपमाः।\nनिष्ठानानि च सूपांश्च दधिकुल्यास्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2009627, "chapter_id": 1190, "verse_number": "१-१९१-११", "content_sanskrit": "कूपांश्च घृतसंपूर्णान्गौड्यान्नानि सहस्रशः।\nइक्षून्मधूनि लाजांश्च मैरेयांश्च वरासवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2009628, "chapter_id": 1190, "verse_number": "१-१९१-१२", "content_sanskrit": "ग्राम्यारण्याश्चौषधीश्च दुदुहे पय एव च।\nषड्रसं चामृतनिभं रसायनमनुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2009629, "chapter_id": 1190, "verse_number": "१-१९१-१३", "content_sanskrit": "भोजनीयानि पेयानि भक्ष्याणि विविधानि च।\nलेह्यान्यमृतकल्पानि चोष्याणि च तथार्जुना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2009630, "chapter_id": 1190, "verse_number": "१-१९१-१४", "content_sanskrit": "रत्नानि च महार्हाणि वासांसि विविधानि च।\nतैः कामैः सर्वसंपूर्णैः पूजितश्च महिपतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2009631, "chapter_id": 1190, "verse_number": "१-१९१-१५", "content_sanskrit": "सामात्यः सबलश्चैव तुतोष स भृशं तदा।\nषडुन्नतां सुपार्श्वोरुं पृथुपञ्चसमावृताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2009632, "chapter_id": 1190, "verse_number": "१-१९१-१६", "content_sanskrit": "मण्डूकनेत्रां स्वाकारां पीनोधसमनिन्दिताम्।\nसुवालघिं शङ्कुकर्णां चारुशृङ्गां मनोरमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2009633, "chapter_id": 1190, "verse_number": "१-१९१-१७", "content_sanskrit": "पुष्टायतशिरोग्रीवां विस्मितः सोऽभिवीक्ष्यताम्।\nअभिनन्द्य स तां राजा नन्दिनीं गाधिनन्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2009634, "chapter_id": 1190, "verse_number": "१-१९१-१८", "content_sanskrit": "अब्रवीच्च भृशं तुष्टः स राजा तमृषिं तदा।\nअर्बुदेन गवां ब्रह्मन्मम राज्येन वा पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2009635, "chapter_id": 1190, "verse_number": "१-१९१-१९", "content_sanskrit": "नन्दिनीं संप्रयच्छस्व भुङ्क्ष्व राज्यं महामुने।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2009636, "chapter_id": 1190, "verse_number": "१-१९१-१९x", "content_sanskrit": "वसिष्ठ उवाच।\nदेवतातिथिपित्रर्थं याज्यार्थं च पयस्विनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2009637, "chapter_id": 1190, "verse_number": "१-१९१-२०", "content_sanskrit": "अदेया नन्दिनीयं वै राज्येनापि तवानघ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2009638, "chapter_id": 1190, "verse_number": "१-१९१-२०x", "content_sanskrit": "विश्वामित्र उवाच।\nरत्नं हि भगवन्नेतद्रत्नहारी च पार्थिवः।\nक्षत्रियोऽहं भवान्विप्रस्तपःस्वाध्यायसाधनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2009639, "chapter_id": 1190, "verse_number": "१-१९१-२१", "content_sanskrit": "ब्राह्णेषु कुतो वीर्यं प्रशान्तेषु धृतात्मसु।\nअर्बुदेन गवां यस्त्वं न ददासि ममेप्सितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2009640, "chapter_id": 1190, "verse_number": "१-१९१-२२", "content_sanskrit": "स्वधर्मं न प्रहास्यामि नेष्यामि च बलेन गाम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2009641, "chapter_id": 1190, "verse_number": "१-१९१-२२x", "content_sanskrit": "वसिष्ठ उवाच।\nबलस्थश्चासि राजा च बाहुवीर्यश्च क्षत्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2009642, "chapter_id": 1190, "verse_number": "१-१९१-२३", "content_sanskrit": "यथेच्छसि तथा क्षिप्रं कुरु मा त्वं विचारय।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2009643, "chapter_id": 1190, "verse_number": "१-१९१-२३x", "content_sanskrit": "गन्धर्व उवाच।\nएवमुक्तस्तथा पार्थ विश्वामित्रो बलादिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2009644, "chapter_id": 1190, "verse_number": "१-१९१-२४", "content_sanskrit": "हंसचन्द्रप्रतीकाशां नन्दिनीं तां जहार गाम्।\nसा तदा ह्रियमाणा च विश्वामित्रबलैर्बलात्।\nकशादण्डप्रणुदिता काल्यमाना इतस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2009645, "chapter_id": 1190, "verse_number": "१-१९१-२५", "content_sanskrit": "हंभायमाना कल्याणी वसिष्ठस्याथ नन्दिनी।\nआगम्याभिमुखी पार्थ तस्थौ भगवदुन्मुखी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2009646, "chapter_id": 1190, "verse_number": "१-१९१-२६", "content_sanskrit": "भृशं च ताड्यमाना वै न जगामाश्रमात्ततः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2009647, "chapter_id": 1190, "verse_number": "१-१९१-२६x", "content_sanskrit": "वसिष्ठ उवाच।\nशृणोमि ते रवं भद्रे विनदन्त्याः पुनः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2009648, "chapter_id": 1190, "verse_number": "१-१९१-२७", "content_sanskrit": "ह्रियसे त्वं बलाद्भद्रे विश्वामित्रेण नन्दिनि।\nकिं कर्तव्यं मया तत्र क्षमावान्ब्राह्मणो ह्यहम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2009649, "chapter_id": 1190, "verse_number": "१-१९१-२८x", "content_sanskrit": "गन्धर्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2009650, "chapter_id": 1190, "verse_number": "१-१९१-२८", "content_sanskrit": "सा भयान्नन्दिनी तेषां बलानां भरतर्षभ।\nविश्वामित्रभयोद्विग्ना वसिष्ठं समुपागमत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2009651, "chapter_id": 1190, "verse_number": "१-१९१-२९x", "content_sanskrit": "गौरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2009652, "chapter_id": 1190, "verse_number": "१-१९१-२९", "content_sanskrit": "कशाग्रदण्डाभिहतां क्रोशन्तीं मामनाथवत्।\nविश्वामित्रबलैर्घोरैर्भगवन् किमुपेक्षसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2009653, "chapter_id": 1190, "verse_number": "१-१९१-३०x", "content_sanskrit": "गन्धर्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2009654, "chapter_id": 1190, "verse_number": "१-१९१-३०", "content_sanskrit": "एवं तस्यां तदा पार्थ धर्षितायां महामुनिः।\nन चुक्षुभे तदा धैर्यान्न चचाल धृतव्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2009655, "chapter_id": 1190, "verse_number": "१-१९१-३१x", "content_sanskrit": "वसिष्ठ उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2009656, "chapter_id": 1190, "verse_number": "१-१९१-३१", "content_sanskrit": "क्षत्रियाणां बलं तेजो ब्राह्मणानां क्षमा बलम्।\nक्षमा मां भजते यस्माद्गम्यतां यदि रोचते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2009657, "chapter_id": 1190, "verse_number": "१-१९१-३२x", "content_sanskrit": "नन्दिन्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2009658, "chapter_id": 1190, "verse_number": "१-१९१-३२", "content_sanskrit": "किं नु त्यक्ताऽस्मि भगवन्यदेवं त्वं प्रभाषसे।\nअत्यक्ताऽहं त्वया ब्रह्मन्नेतुं शक्या न वै बलात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2009659, "chapter_id": 1190, "verse_number": "१-१९१-३३x", "content_sanskrit": "वसिष्ठ उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2009660, "chapter_id": 1190, "verse_number": "१-१९१-३३", "content_sanskrit": "न त्वां त्यजामि कल्याणि स्थीयतां यदि शक्यते।\nदृढेन दाम्ना बद्ध्वैष वत्सस्ते हियते बलात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2009661, "chapter_id": 1190, "verse_number": "१-१९१-३४x", "content_sanskrit": "गन्धर्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2009662, "chapter_id": 1190, "verse_number": "१-१९१-३४", "content_sanskrit": "स्थीयतामिति तच्छ्रुत्वा वसिष्ठस्य पयस्विनी।\nऊर्ध्वाञ्चितशिरोग्रीवा प्रबभौ रौद्रदर्शना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2009663, "chapter_id": 1190, "verse_number": "१-१९१-३५", "content_sanskrit": "क्रोधरक्तेक्षणा सा गौर्हंभारवघनस्वना।\nविश्वामित्रस्य तत्सैन्यं व्यद्रावयत सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2009664, "chapter_id": 1190, "verse_number": "१-१९१-३६", "content_sanskrit": "कशाग्रदण्डाभिहता काल्यमाना ततस्ततः।\nक्रोधरक्तेक्षणा क्रोधं भूय एव समाददे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2009665, "chapter_id": 1190, "verse_number": "१-१९१-३७", "content_sanskrit": "आदित्य इव मध्याह्ने क्रोधदीप्तवपुर्बभौ।\nअङ्गारवर्षं मुञ्चन्ती मुहुर्वालधितो महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2009666, "chapter_id": 1190, "verse_number": "१-१९१-३८", "content_sanskrit": "असृजत्पह्लवान्पुच्छात्प्रस्रवाद्द्राविडाञ्छकान्।\nयोनिदेशाच्च यवानाञ्शकृतः शबरान्बहून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2009667, "chapter_id": 1190, "verse_number": "१-१९१-३९", "content_sanskrit": "मूत्रतश्चासृजत्कांश्चिच्छबरांश्चैव पार्श्वतः।\nपौण्ड्रान्किरातान्यवनान्सिंहलान्बर्बरान्खसान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2009668, "chapter_id": 1190, "verse_number": "१-१९१-४०", "content_sanskrit": "चिबुकांश्च पुलिन्दांश्च चीनान्हूणान्सकेरलान्।\nससर्ज फेनतः सा गौर्म्लेच्छान्बहुविधानपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2009669, "chapter_id": 1190, "verse_number": "१-१९१-४१", "content_sanskrit": "तैर्विसृष्टैर्महासैन्यैर्नानाम्लेच्छगणैस्तदा।\nनानावरणसंछन्नैर्नानायुधधरैस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2009670, "chapter_id": 1190, "verse_number": "१-१९१-४२", "content_sanskrit": "अवाकीर्यत संरब्धैर्विश्वामित्रस्य पश्यतः।\nएकैकश्च तदा योधः पञ्चभिः सप्तभिर्वृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2009671, "chapter_id": 1190, "verse_number": "१-१९१-४३", "content_sanskrit": "अस्त्रवर्षेण महता वध्यमानं बलं तदा।\nप्रभग्नं सर्वतस्त्रस्तं विश्वामित्रस्य पश्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2009672, "chapter_id": 1190, "verse_number": "१-१९१-४४", "content_sanskrit": "तस्य तच्चतुरङ्गं वै बलं परमदुःसहम्।\nप्रभग्नं सर्वतो घोरं पयस्विन्या विनिर्जितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2009673, "chapter_id": 1190, "verse_number": "१-१९१-४५", "content_sanskrit": "न च प्राणैर्वियुज्यन्ते केचित्तत्रास्य सैनिकाः।\nविश्वामित्रस्य संक्रुद्धैर्वासिष्ठैर्भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2009674, "chapter_id": 1190, "verse_number": "१-१९१-४६", "content_sanskrit": "सा गौस्तत्सकलं सैन्यं कालयामास दूरतः।\nविश्वामित्रस्य तत्सैन्यं काल्यमानं त्रियोजनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2009675, "chapter_id": 1190, "verse_number": "१-१९१-४७", "content_sanskrit": "क्रोशमानं भयोद्विग्नं त्रातारं नाध्यगच्छत।\nविश्वामित्रस्ततो दृष्ट्वा क्रोधाविष्टः स रोदसी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2009676, "chapter_id": 1190, "verse_number": "१-१९१-४८", "content_sanskrit": "ववर्ष शरवर्षाणि वसिष्ठे मुनिसत्तमे।\nघोररूपांश्च नाराचान्क्षुरान्भल्लान्महामुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2009677, "chapter_id": 1190, "verse_number": "१-१९१-४९", "content_sanskrit": "विश्वामित्रप्रयुक्तांस्तान्वैणवेन व्यमोचयत्।\nवसिष्ठस्य तदा दृष्ट्वा कर्मकौशलमाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2009678, "chapter_id": 1190, "verse_number": "१-१९१-५०", "content_sanskrit": "विश्वामित्रोऽपि कोपेन भूयः शत्रुनिपातनः।\nदिव्यास्त्रवर्षं तस्मै स प्राहिणोन्मुनये रुषा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2009679, "chapter_id": 1190, "verse_number": "१-१९१-५१", "content_sanskrit": "आग्नेयं वारुणं चैन्द्रं याम्यं वायव्यमेव च।\nविससर्ज महाभागे वसिष्ठे ब्रह्मणः सुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2009680, "chapter_id": 1190, "verse_number": "१-१९१-५२", "content_sanskrit": "अस्त्राणि सर्वतो ज्वालां विसृजन्ति प्रपेदिरे।\nयुगान्तसमये घोराः पतङ्गस्येव रश्मयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2009681, "chapter_id": 1190, "verse_number": "१-१९१-५३", "content_sanskrit": "वसिष्ठोऽपि महातेजा ब्रह्मशक्तिप्रयुक्तया।\nयष्ट्या निवारयामास सर्वाण्यस्त्राणि स स्मयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2009682, "chapter_id": 1190, "verse_number": "१-१९१-५४", "content_sanskrit": "ततस्ते भस्मसाद्भूताः पतन्ति स्म महीतले।\nअपोह्य दिव्यान्यस्त्राणि वसिष्ठो वाक्यमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2009683, "chapter_id": 1190, "verse_number": "१-१९१-५५", "content_sanskrit": "निर्जितोऽसि महाराज दुरात्मन्गाधिनन्दन।\nयदि तेऽस्ति परं शौर्यं तद्दर्शय मयि स्थिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2009684, "chapter_id": 1190, "verse_number": "१-१९१-५६x", "content_sanskrit": "गन्धर्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2009685, "chapter_id": 1190, "verse_number": "१-१९१-५६", "content_sanskrit": "विश्वामित्रस्तथा चोक्तो वसिष्ठेन नराधिपः।\nनोवाच किंचिद्व्रीडाढ्यो विद्रावितमहाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2009686, "chapter_id": 1190, "verse_number": "१-१९१-५७", "content_sanskrit": "दृष्ट्वा तन्महदाश्चर्यं ब्रह्मतेजोभवं तदा।\nविश्वामित्रः क्षत्रभावान्निर्विण्णो वाक्यमब्रवीत्।\nधिग्बलं क्षत्रियबलं ब्रह्मतेजोबलं बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2009687, "chapter_id": 1190, "verse_number": "१-१९१-५८", "content_sanskrit": "बलाबले विनिश्चित्य तप एव परं बलम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2009688, "chapter_id": 1190, "verse_number": "१-१९१-५८x", "content_sanskrit": "गन्धर्व उवाच।\nस राज्यं स्फीतमुत्सृज्य तां च दीप्तां नृपश्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2009689, "chapter_id": 1190, "verse_number": "१-१९१-५९", "content_sanskrit": "भोगांश्च पृष्ठतः कृत्वा तपस्येव मनो दधे।\nस गत्वा तपसा सिद्धिं लोकान्विष्टभ्य तेजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2009690, "chapter_id": 1190, "verse_number": "१-१९१-६०", "content_sanskrit": "तताप सर्वान्दीप्तौजा ब्राह्मणत्वमवाप्तवान्।\nअपिबच्च ततः सोममिन्द्रेण सह कौशिकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2009691, "chapter_id": 1190, "verse_number": "१-१९१-६१", "content_sanskrit": "एवंवीर्यस्तु राजर्षिर्विप्रर्षिः संबभूव ह॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2009692, "chapter_id": 1190, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि चैत्ररथपर्वमि एकनवत्यधिकशततमोऽध्यायः॥ १९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}]