[{"id": 7006373000, "chapter_id": 26373, "verse_number": "२-२९-१", "content_sanskrit": "वैशम्पायन उवाच\nतस्मिन्नहनि निर्वृत्ते द्वितीये समुपस्थिते ।\nआपूर्यत महारङ्गः पौरैर्युद्धदिदृक्षुभिः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006373001, "chapter_id": 26373, "verse_number": "२-२९-२", "content_sanskrit": "सचित्राष्टास्त्रिचरणाः सार्गलद्वारवेदिकाः ।\nसगवाक्षार्धचन्द्राश्च सुतल्पोत्तमभूषिताः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006373002, "chapter_id": 26373, "verse_number": "२-२९-३", "content_sanskrit": "प्राङ्मुखैश्चारुनिर्मुक्तैर्माल्यदामावतंसितैः ।\nअलंकृतैर्विराजद्भिः शारदैरिव तोयदैः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006373003, "chapter_id": 26373, "verse_number": "२-२९-४", "content_sanskrit": "मञ्चागारैः सुनिर्युक्तैर्युद्धाय सुविभूषितैः ।\nसमाजवाटः शुशुभे समेघौघ इवार्णवः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006373004, "chapter_id": 26373, "verse_number": "२-२९-५", "content_sanskrit": "स्वकर्मद्रव्ययुक्ताभिः पताकाभिर्निरन्तरम् ।\nश्रेणीनां च गणानां च मञ्चा भान्त्यचलोपमाः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006373005, "chapter_id": 26373, "verse_number": "२-२९-६", "content_sanskrit": "अन्तःपुरचराणां च प्रेक्षागाराण्यनेकशः ।\nरेजुः काञ्चनचित्राणि रत्नज्वालाकुलानि च ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006373006, "chapter_id": 26373, "verse_number": "२-२९-७", "content_sanskrit": "तानि रत्नौघक्लृप्तानि ससानुप्रग्रहाणि च ।\nरेजुर्जवनिकाक्षेपैः सपक्षा इव खे नगाः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006373007, "chapter_id": 26373, "verse_number": "२-२९-८", "content_sanskrit": "तत्र चामरहारैश्च भूषणानां च सिञ्जितैः ।\nमणीनां च विचित्राणां विचित्राश्चेरुरर्चिषः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006373008, "chapter_id": 26373, "verse_number": "२-२९-९", "content_sanskrit": "गणिकानां पृथङ्मञ्चाः शुभैरास्तरणाम्बरैः ।\nशोभिता वारमुख्याभिर्विमानप्रतिमौजसः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006373009, "chapter_id": 26373, "verse_number": "२-२९-१०", "content_sanskrit": "तत्रासनानि ख्यातानि पर्यङ्काश्च हिरण्मयाः ।\nप्रकीर्णाश्च कुथाश्चित्राः सपुष्पस्तबकैर्वृताः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006373010, "chapter_id": 26373, "verse_number": "२-२९-११", "content_sanskrit": "सौवर्णाः पानकुम्भाश्च पानभूम्यश्च शोभिताः ।\nफलावदंशपूर्णाश्च चाङ्गेर्यः पानयोजिताः ॥ ११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006373011, "chapter_id": 26373, "verse_number": "२-२९-१२", "content_sanskrit": "अन्ये च मञ्चा बहवः काष्ठसंचयबन्धनाः ।\nरेजुः प्रस्तरणास्तत्र शतशोऽथ सहस्रशः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006373012, "chapter_id": 26373, "verse_number": "२-२९-१३", "content_sanskrit": "उत्तमागारिकाश्चैव सूक्ष्मजालावलोकिनः ।\nस्त्रीणां प्रेक्षागृहा भान्ति राजहंसा इवाम्बरे ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006373013, "chapter_id": 26373, "verse_number": "२-२९-१४", "content_sanskrit": "प्राङ्मुखश्चारुनिर्मुक्तो मेरुशृङ्गसमप्रभः ।\nरुक्मपत्रनिभस्तम्भश्चित्रनिर्योगशोभितः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006373014, "chapter_id": 26373, "verse_number": "२-२९-१५", "content_sanskrit": "प्रेक्षागारः स कंसस्य प्रचकाशेऽधिकं श्रिया ।\nशोभितो माल्यदामैश्च निवासकृतलक्षणः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006373015, "chapter_id": 26373, "verse_number": "२-२९-१६", "content_sanskrit": "तस्मिन् नानाजनाकीर्णे जनौघप्रतिनादिते ।\nसमाजवाटे संस्तब्धे कम्पमानार्णवप्रभे ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006373016, "chapter_id": 26373, "verse_number": "२-२९-१७", "content_sanskrit": "राजा कुवलयापीडः समाजद्वारि कुञ्जरः ।\nतिष्ठत्विति समाज्ञाप्य प्रेक्षागारमुपाययौ ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006373017, "chapter_id": 26373, "verse_number": "२-२९-१८", "content_sanskrit": "स शुक्ले वाससी बिभ्रच्छवेतव्यजनचामरः ।\nशुशुभे श्वेतमुकुटः श्वेताभ्र इव चन्द्रमाः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006373018, "chapter_id": 26373, "verse_number": "२-२९-१९", "content_sanskrit": "तस्य सिंहासनस्थस्य सुखासीनस्य धीमतः ।\nरूपमप्रतिमं दृष्ट्वा पौराः प्रोचुर्जयाशिषः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006373019, "chapter_id": 26373, "verse_number": "२-२९-२०", "content_sanskrit": "ततः प्रविविशुर्मल्ला रङ्गमावलिताम्बराः ।\nतिस्रश्च भागशः कक्षाः प्राविशन् बलशालिनः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006373020, "chapter_id": 26373, "verse_number": "२-२९-२१", "content_sanskrit": "ततस्तूर्यनिनादेन क्ष्वेडितास्फोटितेन च ।\nवसुदेवसुतौ हृष्टौ रङ्गद्वारमुपस्थितौ ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006373021, "chapter_id": 26373, "verse_number": "२-२९-२२", "content_sanskrit": "बल्लवौ वस्त्रसंवीतौ सुरचन्दनभूषितौ ।\nऊर्ध्वपीडौ स्रगापीडौ बाहुशस्त्रकृतौ यमौ ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006373022, "chapter_id": 26373, "verse_number": "२-२९-२३", "content_sanskrit": "आस्फोटयन्तावन्योन्यं बाहू चैवार्गलोपमौ ।\nतावापतन्तौ त्वरितौ प्रतिषिद्धौ वराननौ ।\nतेन मत्तेन नागेन चोद्यमानेन वै भृशम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006373023, "chapter_id": 26373, "verse_number": "२-२९-२४", "content_sanskrit": "स मत्तहस्ती दुष्टात्मा कृत्वा कुण्डलिनं करम् ।\nचकार चोदितो यत्नं निहन्तुं बलकेशवौ ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006373024, "chapter_id": 26373, "verse_number": "२-२९-२५", "content_sanskrit": "ततः प्रहसितः कृष्णस्त्रास्यमानो गजेन वै ।\nकंसस्य तन्मतं चैव जगर्हे स दुरात्मनः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006373025, "chapter_id": 26373, "verse_number": "२-२९-२६", "content_sanskrit": "त्वरते खलु कंसोऽय गन्तुं वैवस्वतक्षयम् ।\nयो मामनेन नागेन प्रधर्षयितुमिच्छति ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006373026, "chapter_id": 26373, "verse_number": "२-२९-२७", "content_sanskrit": "संनिकृष्टे ततो नागे गर्जमाने यथा घने ।\nसहसोत्पत्य गोविन्दश्चक्रे तालस्वनं प्रभुः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006373027, "chapter_id": 26373, "verse_number": "२-२९-२८", "content_sanskrit": "क्ष्वेडितास्फोटितरवं कृत्वा नागस्य चाग्रतः ।\nकरं ससीकरं तस्य प्रतिजग्राह वक्षसा ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006373028, "chapter_id": 26373, "verse_number": "२-२९-२९", "content_sanskrit": "विषाणान्तरगो भूत्वा पुनश्चरणमध्यगः ।\nबबाधे तं गजं कृष्णः पवनस्तोयदं यथा ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006373029, "chapter_id": 26373, "verse_number": "२-२९-३०", "content_sanskrit": "स हस्ताग्राद् विनिष्क्रान्तो विषाणाग्राच्च दन्तिनः ।\nविमुक्तः पदमध्याच्च कृष्णो द्विपमपोथयत् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006373030, "chapter_id": 26373, "verse_number": "२-२९-३१", "content_sanskrit": "सोऽतिकायस्तु सम्मूढो हन्तुं कृष्णमशक्नुवन् ।\nगजः स्वेष्वेव गात्रेषु मथ्यमानो ररास ह ॥ ३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006373031, "chapter_id": 26373, "verse_number": "२-२९-३२", "content_sanskrit": "पपात भूमौ जानुभ्यां दशनाभ्यां तुतोद च ।\nमदं सुस्राव रोषाच्च घर्मापाये यथा घनः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006373032, "chapter_id": 26373, "verse_number": "२-२९-३३", "content_sanskrit": "कृष्णस्तु तेन नागेन क्रीडित्वा शिशुलीलया ।\nनिधनाय मतिं चक्रे कंसद्विष्टेन चेतसा ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006373033, "chapter_id": 26373, "verse_number": "२-२९-३४", "content_sanskrit": "स तस्य प्रमुखे पादं कृत्वा कुम्भादनन्तरम् ।\nदोर्भ्यां विषाणमुत्पाट्य तैनैव प्राहरत् तदा ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006373034, "chapter_id": 26373, "verse_number": "२-२९-३५", "content_sanskrit": "स तेन वज्रकल्पेन स्वेन दन्तेन कुञ्जरः ।\nहन्यमानः शकृन्मूत्रं मुमोचार्तो ररास ह ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006373035, "chapter_id": 26373, "verse_number": "२-२९-३६", "content_sanskrit": "कृष्णजर्जरिताङ्गस्य कुञ्जरस्यार्तचेतसः ।\nकटाभ्यामति सुस्राव वेगवद् भूरि शोणितम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006373036, "chapter_id": 26373, "verse_number": "२-२९-३७", "content_sanskrit": "लाङ्गूलं चास्य वेगेन निश्चकर्ष हलायुधः ।\nशैलपृष्ठार्धसंलीनं वैनतेय इवोरगम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006373037, "chapter_id": 26373, "verse_number": "२-२९-३८", "content_sanskrit": "तेनैव गजदन्तेन कृष्णो हत्वा तु दन्तिनम् ।\nजघानैकप्रहारेण गजारोहणमुल्बणम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006373038, "chapter_id": 26373, "verse_number": "२-२९-३९", "content_sanskrit": "सोऽऽर्तनादं महत् कृत्वा विदन्तो दन्तिनां वरः ।\nपपात समहामात्रो वज्रभिन्न इवाचलः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006373039, "chapter_id": 26373, "verse_number": "२-२९-४०", "content_sanskrit": "ततस्तौ तोरणाङ्गानि प्रगृह्य रणकर्कशौ ।\nगजस्य पादरक्षांश्च जघ्नतुः पुरुषर्षभौ ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006373040, "chapter_id": 26373, "verse_number": "२-२९-४१", "content_sanskrit": "तांश्च हत्वा विविशतुर्मध्यं रङ्गस्य तावुभौ ।\nनासत्यावश्विनौ स्वर्गादवतीर्णाविवेच्छया ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006373041, "chapter_id": 26373, "verse_number": "२-२९-४२", "content_sanskrit": "वृष्ण्यन्धकाश्च भोजाश्च ददृशुर्वनमालिनौ ।\nक्ष्वेडितोत्क्रुष्टनादेन बाह्वोरास्फोटितेन च ।\nसिंहनादैश्च तालैश्च हर्षयामासतुर्जनम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006373042, "chapter_id": 26373, "verse_number": "२-२९-४३", "content_sanskrit": "तौ दृष्ट्वा भोजराजस्तु विषसाद वृथामतिः ।\nपौराणामनुरागं च हर्ष चालक्ष्य भारत ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006373043, "chapter_id": 26373, "verse_number": "२-२९-४४", "content_sanskrit": "तं हत्वा पुण्डरीकाक्षो नदन्तं दन्तिनां वरम् ।\nअवतीर्णोऽर्णवाकारं समाजं सहपूर्वजः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]