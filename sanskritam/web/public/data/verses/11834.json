[{"id": 50024149, "chapter_id": 11834, "verse_number": "1", "content_sanskrit": "॥ मधुच्छन्दा वैश्वामित्रः। १-३ अश्विनौ, ४-६ इन्द्रः, ७-९ विश्वेदेवाः, १०-१२ सरस्वती। गायत्री॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50024150, "chapter_id": 11834, "verse_number": "2", "content_sanskrit": "अश्वि॑ना॒ यज्व॑री॒रिषो॒ द्रव॑त्पाणी॒ शुभ॑स्पती। पुरु॑भुजा चन॒स्यत॑म्॥ ३/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50024151, "chapter_id": 11834, "verse_number": "3", "content_sanskrit": "अश्वि॑ना॒ पुरु॑दंससा॒ नरा॒ शवी॑रया धि॒या। धिष्ण्या॒ वन॑तं॒ गिर॑ः॥ ३/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50024152, "chapter_id": 11834, "verse_number": "4", "content_sanskrit": "दस्रा॑ यु॒वाक॑वः सु॒ता नास॑त्या वृ॒क्तब॑र्हिषः। आ या॑तं रुद्रवर्तनी॥ ३/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50024153, "chapter_id": 11834, "verse_number": "5", "content_sanskrit": "इन्द्रा या॑हि चित्रभानो सु॒ता इ॒मे त्वा॒यव॑ः। अण्वी॑भि॒स्तना॑ पू॒तास॑ः॥ ३/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50024154, "chapter_id": 11834, "verse_number": "6", "content_sanskrit": "इन्द्रा या॑हि धि॒येषि॒तो विप्र॑जूतः सु॒ताव॑तः। उप॒ ब्रह्मा॑णि वा॒घत॑ः॥ ३/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50024155, "chapter_id": 11834, "verse_number": "7", "content_sanskrit": "इन्द्रा या॑हि॒ तूतु॑जान॒ उप॒ ब्रह्मा॑णि हरिवः। सु॒ते द॑धिष्व न॒श्चन॑ः॥ ३/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50024156, "chapter_id": 11834, "verse_number": "8", "content_sanskrit": "ओमा॑सश्चर्षणीधृतो॒ विश्वे॑ देवास॒ आ ग॑त। दा॒श्वांसो॑ दा॒शुष॑ः सु॒तम्॥ ३/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50024157, "chapter_id": 11834, "verse_number": "9", "content_sanskrit": "विश्वे॑ दे॒वासो॑ अ॒प्तुर॑ः सु॒तमा ग॑न्त॒ तूर्ण॑यः। उ॒स्रा इ॑व॒ स्वस॑राणि॥ ३/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50024158, "chapter_id": 11834, "verse_number": "10", "content_sanskrit": "विश्वे॑ दे॒वासो॑ अ॒स्रिध॒ एहि॑मायासो अ॒द्रुह॑ः। मेधं॑ जुषन्त॒ वह्न॑यः॥ ३/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50024159, "chapter_id": 11834, "verse_number": "11", "content_sanskrit": "पा॒व॒का न॒ः सर॑स्वती॒ वाजे॑भिर्वा॒जिनी॑वती। य॒ज्ञं व॑ष्टु धि॒याव॑सुः॥ ३/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50024160, "chapter_id": 11834, "verse_number": "12", "content_sanskrit": "चो॒द॒यि॒त्री सू॒नृता॑नां॒ चेत॑न्ती सुमती॒नाम्। य॒ज्ञं द॑धे॒ सर॑स्वती॥ ३/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50024161, "chapter_id": 11834, "verse_number": "13", "content_sanskrit": "म॒हो अर्ण॒ः सर॑स्वती॒ प्र चे॑तयति के॒तुना॑। धियो॒ विश्वा॒ वि रा॑जति॥ ३/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50024162, "chapter_id": 11834, "verse_number": "14", "content_sanskrit": "॥ सूक्तादिस्वरूपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]