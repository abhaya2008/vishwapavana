[{"id": 7006054000, "chapter_id": 26054, "verse_number": "१-२३८-१", "content_sanskrit": "श्रीभगवानुवाच ।\nयमश्च नियम.पार्थ आसनं प्राणसंयमः ।\nप्रत्याहारस्तथा ध्यानं धारणार्जुन सप्तमी ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006054001, "chapter_id": 26054, "verse_number": "१-२३८-२", "content_sanskrit": "समाधिरिति चाष्टाङ्गो योग उक्तो विमुक्तये। ।\nकर्मणा मनसा वाचा सर्वभूतेषु सर्वदा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006054002, "chapter_id": 26054, "verse_number": "१-२३८-३", "content_sanskrit": "हिंसाविरामको धर्मो ह्याहिंसा परमं सुखम् ।\nविधिना या भवेद्धिंसा सा त्वहिंसा प्रकीर्तिता ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006054003, "chapter_id": 26054, "verse_number": "१-२३८-४", "content_sanskrit": "सत्यं ब्रूयात्प्रियं ब्रूयान्न ब्रूयात्सत्यप्रियम् ।\nप्रियं च नानृतं ब्रूयादेष धर्मः सनातनः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006054004, "chapter_id": 26054, "verse_number": "१-२३८-५", "content_sanskrit": "यच्चद्रव्यापहरणं चौर्याद्वाथ बलेन वा। ।\nस्तेयं तस्यानाचरणमस्तेयं धर्मसाधनम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006054005, "chapter_id": 26054, "verse_number": "१-२३८-६", "content_sanskrit": "कर्मणा मनसा वाचा सर्वावस्थासु सर्वदा ।\nसर्वत्र मैथुनत्यागं ब्रह्मचर्यं प्रचक्षते ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006054006, "chapter_id": 26054, "verse_number": "१-२३८-७", "content_sanskrit": "द्रव्याणामप्यनादानमापत्स्वपि तथेच्छया ।\nअपरिग्रहमित्याहुस्तं प्रयत्नेन वर्जयेत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006054007, "chapter_id": 26054, "verse_number": "१-२३८-८", "content_sanskrit": "द्विधा शौचं मृज्जलाभ्यां बाह्य भावादथान्तरात ।\nयदृच्छालाभतस्तुष्टिः सन्तोषः सुखलक्षणम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006054008, "chapter_id": 26054, "verse_number": "१-२३८-९", "content_sanskrit": "मनसश्चैन्द्रियाणां च ऐकाग्र्यं परमं पः ।\nशरीरशोषणं वापि कृच्छ्रचान्द्रायणादिभिः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006054009, "chapter_id": 26054, "verse_number": "१-२३८-१०", "content_sanskrit": "वेदान्तशतरुद्रीयप्रणवादिजप बुधाः ।\nसत्त्वशुद्धिकरं पुंसां स्वाध्यायं परिचक्षते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006054010, "chapter_id": 26054, "verse_number": "१-२३८-११", "content_sanskrit": "स्तुतिस्मरणपूजादिवाङ्मनः कायकर्मभिः ।\nअनिश्चला हरौ भक्तिरेतदीश्वरचिन्तनम् ।\nआसनं स्वस्तिकं प्रोक्तं पद्ममर्धासनं तथा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006054011, "chapter_id": 26054, "verse_number": "१-२३८-१२", "content_sanskrit": "प्राणः स्वदेहजो वायुरायामस्तन्निरोधनम् ।\nइन्द्रियाणां विचरतां विषयेषु त्वसत्स्विव ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}]