[{"id": 7000582000, "chapter_id": 20582, "verse_number": "५-४१-१", "content_sanskrit": "शेष उवाच ।\nयुद्धाय ते सुसंनद्धाः शत्रुघ्नस्य महाबलाः ।\nययुर्वीरमणेः सैन्यमध्ये शौर्यसमन्विताः॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000582001, "chapter_id": 20582, "verse_number": "५-४१-२", "content_sanskrit": "शरान्विमुंचमानास्ते भिंदंतः सैनिकान्बहून् ।\nव्यदृश्यंत रणांतःस्थाः शरासनधरा नराः॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000582002, "chapter_id": 20582, "verse_number": "५-४१-३", "content_sanskrit": "अनेके निहतास्तत्र गजा मणिमया रथाः ।\nभग्ना वाहसमेताश्च दृश्यंते रणमंडले॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000582003, "chapter_id": 20582, "verse_number": "५-४१-४", "content_sanskrit": "विहितं कदनं तेषां श्रुत्वा रुक्मांगदो बली ।\nरथे मणिमये तिष्ठन्ययौ योद्धुं ससैनिकान्॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000582004, "chapter_id": 20582, "verse_number": "५-४१-५", "content_sanskrit": "शरासने शरान्धास्यन्निषुधी अक्षयौ दधत् ।\nशोणनेत्रांतरो भीमो महाकोपसमन्वितः॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000582005, "chapter_id": 20582, "verse_number": "५-४१-६", "content_sanskrit": "अनेकबाणसंविग्नान्कुर्वञ्छूरान्सहस्रशः ।\nहाहाकारं कारयंस्तद्ययौ रुक्मांगदो बली॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000582006, "chapter_id": 20582, "verse_number": "५-४१-७", "content_sanskrit": "राजपुत्रः स्वसदृशं बलेन यशसाश्रिया ।\nआह्वयामास शत्रुघ्नं भारतिं पुष्कलं बली॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000582007, "chapter_id": 20582, "verse_number": "५-४१-८", "content_sanskrit": "रुक्मांगद उवाच ।\nआगच्छ वीरकर्मा त्वं महाबलपराक्रम ।\nमया योद्धुं तु बलिना राजपुत्रेण भास्वता॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000582008, "chapter_id": 20582, "verse_number": "५-४१-९", "content_sanskrit": "किमन्यैस्त्रासितैर्वीर निहतैः कोटिभिर्नरैः ।\nमया समं महायुद्धं विधाय जयमाप्नुहि॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000582009, "chapter_id": 20582, "verse_number": "५-४१-१०", "content_sanskrit": "इत्युक्तवं तं तरसा प्रहसन्पुष्कलो बली ।\nजघान विपुले मध्ये वक्षसस्तीक्ष्णपर्वभिः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000582010, "chapter_id": 20582, "verse_number": "५-४१-११", "content_sanskrit": "तदमृष्यन्राजपुत्रो महाचापे दधच्छरान् ।\nजघान दशभिर्वीरं पुष्कलं वक्षसोंऽतरे॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000582011, "chapter_id": 20582, "verse_number": "५-४१-१२", "content_sanskrit": "उभौ समरसंरब्धावुभावपि जयैषिणौ ।\nरेजाते समरे तौ हि कुमारतारकौ यथा॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000582012, "chapter_id": 20582, "verse_number": "५-४१-१३", "content_sanskrit": "बाणान्धनुषि संधाय दशसंख्यान्महाशितान् ।\nअकरोत्पुष्कलो वीरो विरथं राजपुत्रकम्॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000582013, "chapter_id": 20582, "verse_number": "५-४१-१४", "content_sanskrit": "चतुर्भिश्चतुरोवाहान्द्वाभ्यां सूतमपातयत् ।\nएकेन ध्वजमेतस्य द्वाभ्यां स्यंदनरक्षकौ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000582014, "chapter_id": 20582, "verse_number": "५-४१-१५", "content_sanskrit": "एकेन हृदि विव्याध राजपुत्रस्य वेगवान् ।\nतदद्भुतं कर्म दृष्ट्वा सर्वे वीराः प्रतोषिताः॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000582015, "chapter_id": 20582, "verse_number": "५-४१-१६", "content_sanskrit": "सच्छिन्नधन्वा विरथो हताश्वो हतसारथिः ।\nअत्यंतं कोपमापन्नः स्यंदनं परमाविशत्॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000582016, "chapter_id": 20582, "verse_number": "५-४१-१७", "content_sanskrit": "स स्थित्वा स्यंदनवरे हयरत्नेन भूषिते ।\nशरासनं महद्धृत्वा सुदृढं गुणपूरितम्॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000582017, "chapter_id": 20582, "verse_number": "५-४१-१८", "content_sanskrit": "उवाच पुष्कलं वीरं रुक्मांगद इदं वचः ।\nमहत्पराक्रमं कृत्वा क्व यास्यसि परंतप॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000582018, "chapter_id": 20582, "verse_number": "५-४१-१९", "content_sanskrit": "पश्य मेऽद्यपराक्रांतिं यद्बलेन विनिर्मिताम् ।\nयत्नात्तिष्ठस्व भो वीर नयामि त्वद्रथं नभः॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000582019, "chapter_id": 20582, "verse_number": "५-४१-२०", "content_sanskrit": "इत्युक्त्वा शरमत्युग्रं दधार स्वशरासने ।\nमंत्रयित्वा ततश्चास्त्रं भ्रामकं पौष्कले रथे॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000582020, "chapter_id": 20582, "verse_number": "५-४१-२१", "content_sanskrit": "मुमोच निशितं बाणं स्वर्णपंखैकशोभितम् ।\nतेन बाणेन नीतोऽस्य रथो योजनमात्रकम्॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000582021, "chapter_id": 20582, "verse_number": "५-४१-२२", "content_sanskrit": "धृतः कृच्छ्रेण सूतेन रथो बभ्राम भूतले ।\nकृच्छ्रेण प्राप्य स्वस्थानं पुष्कलः परमास्त्रवित्॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000582022, "chapter_id": 20582, "verse_number": "५-४१-२३", "content_sanskrit": "जगाद वचनं तं वै बाणं बिभ्रच्छरासने ।\nस्वर्गं प्राप्नुहि वीराग्र्य सर्वदेवैश्च सेवितम्॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000582023, "chapter_id": 20582, "verse_number": "५-४१-२४", "content_sanskrit": "त्वादृशाः पृथिवीयोग्या न भवंति नृपोत्तम ।\nशतक्रतुसभायोग्यास्तद्गच्छ त्वं सुरालयम्॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000582024, "chapter_id": 20582, "verse_number": "५-४१-२५", "content_sanskrit": "इत्युक्त्वा स मुमोचास्त्रमाकाशप्रापकं महत् ।\nतेन बाणेन सरथो ययौ खमनुलोमतः॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000582025, "chapter_id": 20582, "verse_number": "५-४१-२६", "content_sanskrit": "सर्वांल्लोकानतिक्रामन्ययौ सूर्यस्य मंडलम् ।\nतज्ज्वालया रथो दग्धो हयसूतसमन्वितः॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000582026, "chapter_id": 20582, "verse_number": "५-४१-२७", "content_sanskrit": "तत्करैर्दग्धभूयिष्ठ कलेवरः सुदुःखितः ।\nपपात चंद्रचूडं स धृत्वा हृद्यसुखार्दनम्॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000582027, "chapter_id": 20582, "verse_number": "५-४१-२८", "content_sanskrit": "भूमौ निपतितस्तत्र करदग्धकलेवरः ।\nअत्यंतं दुःखमापन्नो मुमूर्च्छ रणमंडले॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000582028, "chapter_id": 20582, "verse_number": "५-४१-२९", "content_sanskrit": "तस्मिन्निपतिते भूमौ मूर्च्छिते राजपुत्रके ।\nहाहाकारो महानासीत्तत्र संग्राममूर्धनि॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000582029, "chapter_id": 20582, "verse_number": "५-४१-३०", "content_sanskrit": "वैरिणो जयलक्ष्मीं ते प्रापुः पुष्कलमुख्यकाः ।\nपलायनपरा जाता वैरिणो हयरक्षकाः॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000582030, "chapter_id": 20582, "verse_number": "५-४१-३१", "content_sanskrit": "तदा पुत्रस्य वै मूर्च्छां दृष्ट्वा वीरमणिर्नृपः ।\nप्रायात्समरमध्यस्थं पुष्कलं कोपपूरितः॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000582031, "chapter_id": 20582, "verse_number": "५-४१-३२", "content_sanskrit": "तदा भूमिश्चचालेयं सपर्वतवनोत्तमा ।\nशूरा वै हर्षमापन्नाः कातरा भयपीडिताः॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000582032, "chapter_id": 20582, "verse_number": "५-४१-३३", "content_sanskrit": "चापं महद्दधानः स इषुधी अक्षयावपि ।\nरोषान्निःश्वासमामुंचन्नाह्वयामास वैरिणम्॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]