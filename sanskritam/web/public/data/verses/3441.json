[{"id": 2113495, "chapter_id": 3441, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2113496, "chapter_id": 3441, "verse_number": "१", "content_sanskrit": "कस्मिन् वयसि सम्प्राप्ताः पाण्डवा गजसाह्वयम् ।\nसमपद्यन्त देवेभ्यस्तेषामायुश्च किं परम् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2113497, "chapter_id": 3441, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2113498, "chapter_id": 3441, "verse_number": "२", "content_sanskrit": "पाण्डवानां तथाऽऽयुष्यं शृणु कौरवनन्दन ।\nजगाम हस्तिनपुरं षोडशाब्दो युधिष्ठिरः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2113499, "chapter_id": 3441, "verse_number": "३", "content_sanskrit": "पञ्चदशाब्दो भीमस्तु बीभत्सुर्वै चतुर्दशः ।\nत्रयोदशाब्दौ च यमौ जग्मतुर्गजसाह्वयम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2113500, "chapter_id": 3441, "verse_number": "४", "content_sanskrit": "तत्र त्रयोदशाब्दानि धार्तराष्ट्रैः सहोषिताः ।\nषट् च मासाञ्जतुगृहान्मुक्ता जातो घटोत्कचः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2113501, "chapter_id": 3441, "verse_number": "५", "content_sanskrit": "षण्मासानेकचक्रायां वर्षं पाञ्चालके पुरे ।\nधार्तराष्ट्रैः सहोषित्वा पञ्च वर्षाणि भारत \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2113502, "chapter_id": 3441, "verse_number": "६", "content_sanskrit": "इन्द्रप्रस्थे वसन्तस्ते त्रीणि वर्षाणि विंशतिम् ।\nद्वादशाब्दान् तथैकं च बभ्रमुर्द्यूतकर्शिताः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2113503, "chapter_id": 3441, "verse_number": "७", "content_sanskrit": "भुक्त्वा षट्त्रिंशतं राज्यं सागरान्तां वसुन्धराम् ।\nमासैः षड्भिर्महात्मानः सर्वे कृष्णपरायणाः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2113504, "chapter_id": 3441, "verse_number": "८", "content_sanskrit": "राज्ये परीक्षितं स्थाप्य इष्टां गतिमवाप्नुवन् ।\nएवं युधिष्ठिरस्यापि आयुरष्टोत्तरं शतम् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2113505, "chapter_id": 3441, "verse_number": "९", "content_sanskrit": "अर्जुनात् केशवो ज्येष्ठः त्रिभिर्मासैर्महाभुजः ।\nकृष्णात् सङ्कर्षणो ज्येष्ठः त्रिभिर्मासैर्महाबलः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2113506, "chapter_id": 3441, "verse_number": "१२०", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nविंशत्यधिकशततमोऽध्यायः ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2113507, "chapter_id": 3441, "verse_number": "६८", "content_sanskrit": "॥ इति सम्भवपर्वणि अष्टषष्टितमोऽध्यायः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2113508, "chapter_id": 3441, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]