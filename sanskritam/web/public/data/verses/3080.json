[{"id": 2097010, "chapter_id": 3080, "verse_number": "१३-२१०-१", "content_sanskrit": "उमोवाच।\nभगवन्देवदेवेश तेषां कर्मफलं प्रभो।\nश्रोतुमिच्छाम्यहं देव प्रसादात्ते वरप्रद॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2097011, "chapter_id": 3080, "verse_number": "१३-२१०-२x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2097012, "chapter_id": 3080, "verse_number": "१३-२१०-२", "content_sanskrit": "वानप्रस्थगतं सर्वं फलपाकं शृणु प्रिये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2097013, "chapter_id": 3080, "verse_number": "१३-२१०-३", "content_sanskrit": "अग्नियोगं व्रजन्ग्रीष्मे ततो द्वादशवार्षिकम्।\nरुद्रलोकेऽभिजायेत विधिदृष्टेन कर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2097014, "chapter_id": 3080, "verse_number": "१३-२१०-४", "content_sanskrit": "उपवासव्रतं कुर्वन्वर्षाकाले दृढव्रतः।\nसोमलोकेऽभिजायेत नरो द्वादशवार्षिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2097015, "chapter_id": 3080, "verse_number": "१३-२१०-५", "content_sanskrit": "काष्ठवन्मौनमास्थाय नरो द्वादशवार्षिकम्।\nमरुतां लोकमास्थाय तत्र भोगैश्च युज्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2097016, "chapter_id": 3080, "verse_number": "१३-२१०-६", "content_sanskrit": "कुशशर्करसंयुक्ते स्थण्डिले संविशन्मुनिः।\nयक्षलोकेऽभिजायेत सहस्राणि चतुर्दश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2097017, "chapter_id": 3080, "verse_number": "१३-२१०-७", "content_sanskrit": "वर्षाणां भोगसंयुक्तो नरो द्वादशवार्षिकम्।\nवीरासनगतो यस्तु कण्टकाफलकाश्रितः।\nगन्धर्वेष्वभिजायेत नरो द्वादशवार्षिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2097018, "chapter_id": 3080, "verse_number": "१३-२१०-८", "content_sanskrit": "वीरस्थायी चोर्ध्वबाहुर्नरो द्वादशवार्षिकम्।\nदेवलोकेऽभिजायेत दिव्यभोगसमन्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2097019, "chapter_id": 3080, "verse_number": "१३-२१०-९", "content_sanskrit": "पादाङ्गुष्ठेन यस्तिष्ठेदूर्ध्वबाहुर्जितेन्द्रियः।\nइन्द्रलोकेऽभिजायेत सहस्राणि चतुर्दश।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2097020, "chapter_id": 3080, "verse_number": "१३-२१०-१०", "content_sanskrit": "आहारनियमं कृत्वा मुनिर्द्वादशवार्षिकम्।\nनागलोकेऽभिजायेत संवत्सरगणान्बहून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2097021, "chapter_id": 3080, "verse_number": "१३-२१०-११", "content_sanskrit": "एवं दृढव्रता देवि वानप्रस्थाश्च कर्मभिः।\nस्थानेषु तत्र तिष्ठन्ति तत्तद्भोगसमन्विताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2097022, "chapter_id": 3080, "verse_number": "१३-२१०-१२", "content_sanskrit": "तेभ्यो भ्रष्टाः पुनर्देवि जायन्ते नृषु भोगिनः।\nवर्णोत्तमकुलेष्वेव धनधान्यसमन्विताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2097023, "chapter_id": 3080, "verse_number": "१३-२१०-१३", "content_sanskrit": "एतत्ते कथितं देवि किं भूयः श्रोतुमिच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2097024, "chapter_id": 3080, "verse_number": "१३-२१०-१४x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2097025, "chapter_id": 3080, "verse_number": "१३-२१०-१४", "content_sanskrit": "एषां यथा वराणां तु धर्ममिच्छामि मानद।\nकृपया परयाऽऽविष्टस्तन्मे ब्रूहि महेश्वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2097026, "chapter_id": 3080, "verse_number": "१३-२१०-१५x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2097027, "chapter_id": 3080, "verse_number": "१३-२१०-१५", "content_sanskrit": "धर्मं यथा वराणां त्वं शृणु भामिनि तत्परा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2097028, "chapter_id": 3080, "verse_number": "१३-२१०-१६", "content_sanskrit": "व्रतोपवासशुद्धाङ्गास्तीर्थस्नानपरायणाः।\nधृतिमन्तःक क्षमायुक्ताः सत्यव्रतपरायणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2097029, "chapter_id": 3080, "verse_number": "१३-२१०-१७", "content_sanskrit": "पक्षमासोपवासैश्च कर्शिता धर्मदर्शिनः।\nवर्षैः शीतातपैश्चैव कुर्वन्तः परमं तपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2097030, "chapter_id": 3080, "verse_number": "१३-२१०-१८", "content_sanskrit": "कालयोगेन गच्छन्ति शक्रलोकं शुचिस्मिते।\nतत्र ते भोगसंयुक्ता दिव्यगन्धसमन्विताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2097031, "chapter_id": 3080, "verse_number": "१३-२१०-१९", "content_sanskrit": "दिव्यभूषणसंयुक्ता विमानवरसंयुताः।\nविचरन्ति यथाकामं दिव्यस्त्रीगणसंयुताः।\nएतत्ते कथितं देवि किं भूयः श्रोतुमिच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2097032, "chapter_id": 3080, "verse_number": "१३-२१०-२०x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2097033, "chapter_id": 3080, "verse_number": "१३-२१०-२०", "content_sanskrit": "तेषां चक्रचराणां च धर्ममिच्छामि वै प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2097034, "chapter_id": 3080, "verse_number": "१३-२१०-२१x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2097035, "chapter_id": 3080, "verse_number": "१३-२१०-२१", "content_sanskrit": "हन्त ते कथयिष्यामि शृणु शाकटिकं शुभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2097036, "chapter_id": 3080, "verse_number": "१३-२१०-२२", "content_sanskrit": "संवहन्तो धुरं दानैः शकटानां तु सर्वदा।\nप्रार्थयन्ते यथाकालं शकटैर्भैक्षचर्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2097037, "chapter_id": 3080, "verse_number": "१३-२१०-२३", "content_sanskrit": "तपोर्जनपरा धीरास्तपसा क्षीणकल्मषाः।\nपर्यटन्तो दिशः सर्वाः कामक्रोधविवर्जिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2097038, "chapter_id": 3080, "verse_number": "१३-२१०-२४", "content_sanskrit": "तेनैव कालयोगेन त्रिदिवं यान्ति शोभने।\nतत्र प्रमुदिता भोगैर्विचरन्ति यथासुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2097039, "chapter_id": 3080, "verse_number": "१३-२१०-२५", "content_sanskrit": "एतत्ते कथितं देवि किं भूयः श्रोतुमिच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2097040, "chapter_id": 3080, "verse_number": "१३-२१०-२६x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2097041, "chapter_id": 3080, "verse_number": "१३-२१०-२६", "content_sanskrit": "वैखानसानां वै धर्मं श्रोतुमिच्छाम्यहं प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2097042, "chapter_id": 3080, "verse_number": "१३-२१०-२७x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2097043, "chapter_id": 3080, "verse_number": "१३-२१०-२७", "content_sanskrit": "ते वै वैखानसा नाम वानप्रस्थाः शुभेक्षणे।\nतीव्रेण तपसा युक्ता दीप्तिमन्तः स्वतेजसा।\nसत्यव्रतपरा धीरास्तेषां निष्कल्मषं तपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2097044, "chapter_id": 3080, "verse_number": "१३-२१०-२८", "content_sanskrit": "अश्मकुट्टास्तथाऽन्ये च दन्तोलूखलिनस्तथा।\nशीर्णपर्णाशिनश्चान्ये उञ्छवृत्तास्तथा परे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2097045, "chapter_id": 3080, "verse_number": "१३-२१०-२९", "content_sanskrit": "कपोतवृत्तयश्चान्ये कापोतीं वृत्तिमाश्रिताः।\nपशुप्रचारनिरताः फेनपाश्च तथा परे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2097046, "chapter_id": 3080, "verse_number": "१३-२१०-३०", "content_sanskrit": "मृगवन्मृगचर्यायां सञ्चरन्ति तथा परे।\nअब्भक्षा वायुभक्षाश्च निराहारास्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2097047, "chapter_id": 3080, "verse_number": "१३-२१०-३१", "content_sanskrit": "केचिच्चरन्ति सद्विष्णोः पादपूजनमुत्तमम्।\nसञ्चरन्ति तपो घोरं व्याधिमृत्युविवर्जिताः।\nस्ववशादेव ते मृत्युं भीषयन्ति च नित्यशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2097048, "chapter_id": 3080, "verse_number": "१३-२१०-३२", "content_sanskrit": "इन्द्रलोके तथा तेषां निर्मिता भोगसञ्चयाः।\nअमरैः समतां यान्ति देववद्भोगसंयुताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2097049, "chapter_id": 3080, "verse_number": "१३-२१०-३३", "content_sanskrit": "वराप्सरोभिः संयुक्ताश्चिरकालमनिन्दिते।\nएतत्ते कथितं देवि भूयः श्रोतुं किमिच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2097050, "chapter_id": 3080, "verse_number": "१३-२१०-३४x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2097051, "chapter_id": 3080, "verse_number": "१३-२१०-३४", "content_sanskrit": "भगवञ्श्रोतुमिच्छामि वालखिल्यांस्तपोधनान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2097052, "chapter_id": 3080, "verse_number": "१३-२१०-३५x", "content_sanskrit": "महेस्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2097053, "chapter_id": 3080, "verse_number": "१३-२१०-३५", "content_sanskrit": "धर्मचर्यां तथा देवि वालखिल्यगतां शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2097054, "chapter_id": 3080, "verse_number": "१३-२१०-३६", "content_sanskrit": "मृगनिर्मोकवसना निर्द्वन्द्वास्ते तपोधनाः।\nअङ्गुष्ठमात्राः सुश्रोणि तेष्वेवाङ्गेषु संश्रिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2097055, "chapter_id": 3080, "verse_number": "१३-२१०-३७", "content_sanskrit": "उद्यन्तं सततं सूर्यं स्तुवन्तो विविधैः स्तवैः।\nभास्करस्येव किरणैः सहसा यान्ति नित्यदा।\nद्योतयन्तो दिशः सर्वा धर्मज्ञाः सत्यवादिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2097056, "chapter_id": 3080, "verse_number": "१३-२१०-३८", "content_sanskrit": "तेष्वेव निर्मलं सत्यं लोकार्थं तु प्रतिष्ठितम्।\nलोकोऽयं धार्यते देवि तेषामेव तपोबलात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2097057, "chapter_id": 3080, "verse_number": "१३-२१०-३९", "content_sanskrit": "महात्मनां तु तपसा सत्येन च शुचिस्मिते।\nक्षमया च महाभागे भूतानां संस्थितिं विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2097058, "chapter_id": 3080, "verse_number": "१३-२१०-४०", "content_sanskrit": "प्रजार्थमपि लोकार्थं महद्भिः क्रियते तपः।\nतपसा प्राप्यते सर्वं तपसा प्राप्यते फलम्।\nदुष्प्रापमपि यल्लोके तपसा प्राप्यते हि तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2097059, "chapter_id": 3080, "verse_number": "१३-२१०-४१", "content_sanskrit": "पञ्चभूतार्थतत्वे च लोकसृष्टिविर्धनम्।\nएतत्सर्वं समासेन तपोयोगाद्विनिर्मितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2097060, "chapter_id": 3080, "verse_number": "१३-२१०-४२", "content_sanskrit": "तस्मादयं त्वृषिगणस्तपस्तप इति प्रिये।\nधर्मान्वेषी तपः कर्तुं यतते सततं प्रिये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2097061, "chapter_id": 3080, "verse_number": "१३-२१०-४३", "content_sanskrit": "अमरत्वं शिवत्वं च तपसा प्रापयेत्सदा।\nएतत्ते कथितं सर्वं शृण्वन्त्यास्ते श्रुतं प्रिये।\nप्रियार्थमृषिसङ्घस्य प्रजानां हितकाम्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2097062, "chapter_id": 3080, "verse_number": "१३-२१०-४४x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2097063, "chapter_id": 3080, "verse_number": "१३-२१०-४४", "content_sanskrit": "एवं ब्रुवन्तं देवेशमृषयश्चापि तुष्टुवुः।\nभूयः परतरं यत्तु तदाप्रभृति चक्रिरे॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2097064, "chapter_id": 3080, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि दशाधिकद्विशततमोऽध्यायः॥ २१० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}]