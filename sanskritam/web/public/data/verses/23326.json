[{"id": 7003326000, "chapter_id": 23326, "verse_number": "२-२१-१", "content_sanskrit": "सूत उवाच  ।\nपरीक्ष्य भूमिं विधिवद्गंधवर्णरसादिभिः ।\nअलंकृत्य वितानाद्यैरीश्वरावाहनक्षमाम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003326001, "chapter_id": 23326, "verse_number": "२-२१-२", "content_sanskrit": "एकहस्तप्रमाणेन मंडलं परिकल्पयेत् ।\nआलिखेत्कमलं मध्ये पंचरत्नसमन्वितम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003326002, "chapter_id": 23326, "verse_number": "२-२१-३", "content_sanskrit": "चूर्णैरष्टदलं वृत्तं सितं वा रक्तमेव च ।\nपरिवारेण संयुक्तं बहुशोभासमन्वितम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003326003, "chapter_id": 23326, "verse_number": "२-२१-४", "content_sanskrit": "आवाह्य कर्णिकायां तु शिवं परमकारणम् ।\nअर्चयेत्सर्वयत्नेन यथाविभवविस्तरम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003326004, "chapter_id": 23326, "verse_number": "२-२१-५", "content_sanskrit": "दलेषु सिद्धयः प्रोक्ताः कर्णिकायां महामुने ।\nवैराग्यज्ञाननालं च धर्मकंदं मनोरमम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003326005, "chapter_id": 23326, "verse_number": "२-२१-६", "content_sanskrit": "वामा ज्येष्ठा च रौद्री च काली विकरणी तथा ।\nबलविकरणीचैव बलप्रमथिनी क्रमात् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003326006, "chapter_id": 23326, "verse_number": "२-२१-७", "content_sanskrit": "सर्वभूतस्य दमनी केसरेषु च शक्तयः ।\nमनोन्मनी महामाय कर्णिकायां शिवासने ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003326007, "chapter_id": 23326, "verse_number": "२-२१-८", "content_sanskrit": "वामदेवादिभिः सार्धं द्वंद्वन्यायेन विन्यसेत् ।\nमनोन्मनं महादेवं मनोन्मन्याथ मध्यतः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003326008, "chapter_id": 23326, "verse_number": "२-२१-९", "content_sanskrit": "सूर्यसोमाग्निसंबंधात्प्रणवाख्यं शिवात्मकम् ।\nपुरुषं विन्यसेद्वक्त्रं पूर्वे पत्रे रविप्रभम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003326009, "chapter_id": 23326, "verse_number": "२-२१-१०", "content_sanskrit": "अघोरं दक्षिणे नीलांजनचयोपमम् ।\nउत्तरे वामदेवाख्यं जपाकुसुमसन्निभम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003326010, "chapter_id": 23326, "verse_number": "२-२१-११", "content_sanskrit": "सद्यं पश्चिमपत्रे तु गोक्षीरधवलं न्यसेन् ।\nईशानं कर्णिकायां तु शुद्धस्फटिकसन्निभम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003326011, "chapter_id": 23326, "verse_number": "२-२१-१२", "content_sanskrit": "चंद्रमंडलसंकाशं हृदयायेति मंत्रतः ।\nवाह्नेये रुद्रदिग्भागे शिरसे धूम्रवर्चसे ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003326012, "chapter_id": 23326, "verse_number": "२-२१-१३", "content_sanskrit": "शिखायै च नमश्चोति रक्ताभे नैर्ऋते दले ।\nकवचायांजनाभाय इति वायुदलेन्यसेत् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003326013, "chapter_id": 23326, "verse_number": "२-२१-१४", "content_sanskrit": "अस्त्रायाग्निसिखाभाय इति दिक्षु प्रविन्यसेत् ।\nनेत्रेभ्यश्चेति चैशान्यां पिंगलेभ्यः प्रविन्येसत् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003326014, "chapter_id": 23326, "verse_number": "२-२१-१५", "content_sanskrit": "शिवं सदा शिवं देवं महेश्वरमतः परम् ।\nरुद्रं विष्णुं विरिंचिं च सृष्टिन्यायेन भावयेत् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003326015, "chapter_id": 23326, "verse_number": "२-२१-१६", "content_sanskrit": "शिवाय रुद्ररूपाय शांत्यतीताय शंभवे ।\nशांताय शांतदैत्याय नमश्चंद्रमसे तथा ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003326016, "chapter_id": 23326, "verse_number": "२-२१-१७", "content_sanskrit": "वेद्याय विद्याधाराय वह्नये वह्निवर्चसे ।\nकालायै च प्रतिष्ठायै तारकायांतकाय च ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003326017, "chapter_id": 23326, "verse_number": "२-२१-१८", "content_sanskrit": "निवृत्त्यै धनदेवाय धारायै धारणाय च ।\nमंत्रैरेतैर्महाभूतविग्रहं च सदाशिवम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003326018, "chapter_id": 23326, "verse_number": "२-२१-१९", "content_sanskrit": "ईशानमुकुटं देवं पुरुषास्यं पुरातनम् ।\nअघोर हृदयं हृष्टं वामगुह्यं महेश्वरम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003326019, "chapter_id": 23326, "verse_number": "२-२१-२०", "content_sanskrit": "सद्यमूर्ति स्मरेद्देवं सदसद्व्यक्तिकारणम् ।\nपंचवक्त्रं दशभुजमष्टत्रिंशत्कलामयम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003326020, "chapter_id": 23326, "verse_number": "२-२१-२१", "content_sanskrit": "सद्यमष्टप्रकारेण प्रभिद्य च कलामयम् ।\nवामं त्रयोदशविधौर्विभिद्य विततं प्रभुम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003326021, "chapter_id": 23326, "verse_number": "२-२१-२२", "content_sanskrit": "अघोरमष्टधा कृत्वा कलारूपेण संस्थितम् ।\nपुरुषं च चतुर्धा वै विभज्य च कलामयम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003326022, "chapter_id": 23326, "verse_number": "२-२१-२३", "content_sanskrit": "ईशानं पंचधा कृत्वा पंचमूर्त्या व्यवस्थितम् ।\nहंसहंसेति मंत्रेण शिवभक्त्या समन्वितम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003326023, "chapter_id": 23326, "verse_number": "२-२१-२४", "content_sanskrit": "ओंकारमात्रमोंकारमकारं समरूपिणम् ।\nआ ई ऊ ए तथा अंबानुक्रमेणात्मरूपिणम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003326024, "chapter_id": 23326, "verse_number": "२-२१-२५", "content_sanskrit": "प्रधानसहितं देवं प्रलयोत्पत्तिवर्जितम् ।\nअणोरणीयांसमजं महतोऽपि महत्तमम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003326025, "chapter_id": 23326, "verse_number": "२-२१-२६", "content_sanskrit": "उर्ध्वरेतसमीशानं विरूपाक्षमुमापतिम् ।\nसहस्रशिरसं देवं सहस्राक्षं सनातनम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003326026, "chapter_id": 23326, "verse_number": "२-२१-२७", "content_sanskrit": "सहस्रहस्तचरणं नादांतं नादविग्रहम् ।\nखद्योतसदृशाकारं चंद्ररेखाकृति प्रभुम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003326027, "chapter_id": 23326, "verse_number": "२-२१-२८", "content_sanskrit": "द्वादशांते भ्रुवोर्मध्ये तालुमध्ये गले क्रमात् ।\nहृद्देशेऽवस्थितं देवं स्वानंदममृतं शिवम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003326028, "chapter_id": 23326, "verse_number": "२-२१-२९", "content_sanskrit": "विद्युद्वलयसंकाशं विद्युत्कोटिसमप्रभम् ।\nश्यामं रक्तं कलाकारं शक्तित्रयकृतासनम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003326029, "chapter_id": 23326, "verse_number": "२-२१-३०", "content_sanskrit": "सदाशिवं स्मरेद्देवं तत्त्वत्रयसमन्वितम् ।\nविद्यामूर्तिमयं देव पूजयेच्च यथाक्रमात् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003326030, "chapter_id": 23326, "verse_number": "२-२१-३१", "content_sanskrit": "लोकपालांस्तथास्त्रेण पूर्वाद्यान्पूजयेत् पृथक् ।\nचरुं च विधिनासाद्य शिवाय विनिवेदयेत् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003326031, "chapter_id": 23326, "verse_number": "२-२१-३२", "content_sanskrit": "अर्धं शिवाय दत्त्वैव शेषर्धेन तु होमयेत् ।\nअघोरेणाथ शिष्याय दापयेद्भोक्तुमुत्तमम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003326032, "chapter_id": 23326, "verse_number": "२-२१-३३", "content_sanskrit": "उपस्पृश्य शुचिर्भूत्वा पुरुषं विधिना यजेत् ।\nपंचगव्यं ततः प्राश्य ईशानेनाभिमंत्रितम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003326033, "chapter_id": 23326, "verse_number": "२-२१-३४", "content_sanskrit": "वामदेवेन भस्मांगी भस्मनोद्धूलयेत्क्रमात् ।\nकर्णयोश्च जपेद्देवीं गायत्रीं रुद्रदेवताम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003326034, "chapter_id": 23326, "verse_number": "२-२१-३५", "content_sanskrit": "ससूत्रं सपिधानं च वस्त्रयुग्मेन वेष्टितम् ।\nतत्पूर्वं हेमरत्नौघैर्वासितं वै हिरण्मयम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003326035, "chapter_id": 23326, "verse_number": "२-२१-३६", "content_sanskrit": "कलशान्विन्यसेत्पंच पंचभिर्ब्राह्मणैस्ततः।। होमं च चरुणा कुर्याद्यथाविभवविस्तरम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003326036, "chapter_id": 23326, "verse_number": "२-२१-३७", "content_sanskrit": "शिष्यं च वासयेद्भक्तं दक्षिणे मंडलस्य तु ।\nदर्भशय्यासमारूढं शिवध्यानपरायणम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003326037, "chapter_id": 23326, "verse_number": "२-२१-३८", "content_sanskrit": "अघोरेण यथान्यायमष्टोत्तरशतं पुनः।। घृतेन हुत्वा दुःस्वप्नं प्रभाते शोधयेन्मलम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003326038, "chapter_id": 23326, "verse_number": "२-२१-३९", "content_sanskrit": "एवं चोपोषितं शिष्यं स्नातं भूषितविग्रहम् ।\nनववस्त्रोत्तरीयं च सोष्णीषं कृतमंगलम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003326039, "chapter_id": 23326, "verse_number": "२-२१-४०", "content_sanskrit": "दुकूलाद्येन वस्त्रेण नेत्रं बद्ध्वा प्रवेशयेत् ।\nसुवर्णपुष्पसंमिश्रं यताविभवविस्तरम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003326040, "chapter_id": 23326, "verse_number": "२-२१-४१", "content_sanskrit": "ईशानेन च मंत्रेण कुर्यात्पुष्पांजलिं प्रभोः ।\nप्रदक्षिणात्रयं कृत्वा रुद्राध्यायेन वा पुनः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003326041, "chapter_id": 23326, "verse_number": "२-२१-४२", "content_sanskrit": "केवलं प्रणवेनाथ शिवध्यानपरायणः ।\nध्यात्वा तु देवदेवेशमीशाने संक्षिपेत्स्वयम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003326042, "chapter_id": 23326, "verse_number": "२-२१-४३", "content_sanskrit": "यस्मिन्मंत्रे पतेत्पुष्पं तन्मंत्रस्तस्य सिध्यति ।\nशिवांभसा तु संस्पृश्य अवोरेण च भस्मना ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003326043, "chapter_id": 23326, "verse_number": "२-२१-४४", "content_sanskrit": "शिष्यमूर्धनि विन्यस्य गंधाद्यैः शिष्यमर्चयेत् ।\nवारुणं परमं श्रेष्ठं द्वारं वै सर्ववर्णिनाम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003326044, "chapter_id": 23326, "verse_number": "२-२१-४५", "content_sanskrit": "क्षत्त्रियाणां विशेषेण द्वारं वै पश्चिमं स्मृतम् ।\nनेत्रावरणमुन्मुच्य मंडलं दर्शयेत्ततः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003326045, "chapter_id": 23326, "verse_number": "२-२१-४६", "content_sanskrit": "कुशासेन तु संस्थाप्य दक्षिणामूर्तिमास्थितः ।\nतत्त्वशुद्धिं ततः कुर्यात्पंचतत्त्वप्रकारतः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003326046, "chapter_id": 23326, "verse_number": "२-२१-४७", "content_sanskrit": "निवृत्त्या रुद्रपर्यंतमंडमंजोद्भवात्मज ।\nप्रतिष्ठया तदूर्ध्वं च यावदव्यक्तगोचरम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003326047, "chapter_id": 23326, "verse_number": "२-२१-४८", "content_sanskrit": "विश्वेश्वरांतं वै विद्या कलामात्रेण सुव्रत ।\nतदूर्ध्वमार्गं संशोध्य शिवभक्त्या शिवं नयेत् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003326048, "chapter_id": 23326, "verse_number": "२-२१-४९", "content_sanskrit": "समर्चनाय तत्त्वस्य तस्य भोगेश्वरस्य वै ।\nतत्त्वत्रयप्रभेदेन चतुर्भिरुत वा तथा ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003326049, "chapter_id": 23326, "verse_number": "२-२१-५०", "content_sanskrit": "होमयेदंगमंत्रभेण शांत्यतीरतं सदाशिवम् ।\nसद्यादिभिस्तु शांत्यंतं चतुर्भिः कलया पृथक् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003326050, "chapter_id": 23326, "verse_number": "२-२१-५१", "content_sanskrit": "शांत्यतीतं मुनिश्रेष्ठ ईशानेनाथवा पुनः ।\nप्रत्येकमष्टोत्तरशतं दिशाहोमं तु कारयेत् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003326051, "chapter_id": 23326, "verse_number": "२-२१-५२", "content_sanskrit": "ईशान्यां पंचमोनाथ प्रधानं परिगीयते ।\nसमिदाज्यचरूँल्लाजान्सर्षपांश्च यवांस्तिलान् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003326052, "chapter_id": 23326, "verse_number": "२-२१-५३", "content_sanskrit": "द्रव्याणि सप्त होतव्यं स्वाहांतं प्रणवादिकम् ।\nतेषां पूर्णाहुतिर्विप्र ईशानेन विधीयते ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003326053, "chapter_id": 23326, "verse_number": "२-२१-५४", "content_sanskrit": "सहंसेन यथान्यायं प्रणवाद्येन सुव्रत ।\nअघोरेण च मंत्रेण प्रायश्चित्तं विधीयते ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003326054, "chapter_id": 23326, "verse_number": "२-२१-५५", "content_sanskrit": "जयादिस्विष्टपर्यंतमग्निकार्यं क्रमेण तु ।\nगुणसंख्याप्रकारेण प्रधानेन च योजयेत् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003326055, "chapter_id": 23326, "verse_number": "२-२१-५६", "content_sanskrit": "भूतानि ब्रह्मभिर्वापि मौनी बीजादिभिस्तथा ।\nअथ प्रधानमात्रेण प्राणापानौ नियम्य च ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003326056, "chapter_id": 23326, "verse_number": "२-२१-५७", "content_sanskrit": "षष्ठेन भेदयेदात्मप्रणवांतं कुलाकुलम् ।\nअन्योऽन्यमुपसंहृत्य ब्रह्माणं केशवं हरम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003326057, "chapter_id": 23326, "verse_number": "२-२१-५८", "content_sanskrit": "रुद्रे रुद्रं तमीशाने शिवे देवं महेश्वरम् ।\nतस्मात्सृष्टिप्रकारेम भावयेद्भवनाशनम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003326058, "chapter_id": 23326, "verse_number": "२-२१-५९", "content_sanskrit": "स्थाप्यात्मनममुं जीवं ताडनं द्वारदर्शनम् ।\nदीपनं ग्रहणं चैव बंधनं पूजया सह ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003326059, "chapter_id": 23326, "verse_number": "२-२१-६०", "content_sanskrit": "अमृतीकरणं चैव कारयेद्विधिपूर्वकम् ।\nपष्ठांतं सद्यसंयुक्तं तृतीयेन समन्वितम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003326060, "chapter_id": 23326, "verse_number": "२-२१-६१", "content_sanskrit": "फडंतं संहृतिः प्रोक्ता पंचभूतप्रकारतः ।\nसद्याद्यषष्ठसहितं शिखांतं सफडंतकम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003326061, "chapter_id": 23326, "verse_number": "२-२१-६२", "content_sanskrit": "ताडनं कथितं द्वारं तत्त्वानामपि योगिनः ।\nप्रधानं संपुटीकृत्य तृतीयेन च दीपनम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003326062, "chapter_id": 23326, "verse_number": "२-२१-६३", "content_sanskrit": "आद्येन संपुटीकृत्य प्रधानं ग्रहणं स्मृतम् ।\nप्रधानं प्रधानं प्रथमेनैव संपुटीकृत्य पूर्ववत् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003326063, "chapter_id": 23326, "verse_number": "२-२१-६४", "content_sanskrit": "&nbsp;बंधनं परिपूर्णेन प्लावनं चामृतेन च।। शांत्य तीता ततः शांतिर्विद्या नाम कलामला ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003326064, "chapter_id": 23326, "verse_number": "२-२१-६५", "content_sanskrit": "प्रतिष्ठा च निवृत्तिश्च कलासंक्रमणं स्मृता ।\nतत्त्ववर्णकलायुक्तं भुवनेन यथाक्रमम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003326065, "chapter_id": 23326, "verse_number": "२-२१-६६", "content_sanskrit": "मंत्रैः पादैः स्तवं कुर्याद्विशोध्य च यथाविधि ।\nआद्येन योनिबीजेन कल्पयित्वा च पूर्ववत् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003326066, "chapter_id": 23326, "verse_number": "२-२१-६७", "content_sanskrit": "पूजासंप्रोक्षणं विद्धि ताडनं हरणं तथा ।\nसंहतस्य च संयोगं विक्षेपं च यथाक्रमम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003326067, "chapter_id": 23326, "verse_number": "२-२१-६८", "content_sanskrit": "अर्चना च तथा गर्भधारणं जननं पुनः ।\nअधिकारो भवेद्भानोर्लयश्चैव विशेषतः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003326068, "chapter_id": 23326, "verse_number": "२-२१-६९", "content_sanskrit": "उत्तमाद्यं तथांत्येन योनिबीजेन सुव्रत ।\nउद्दारे प्रोक्षणे चैव ताडने च महामुने ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003326069, "chapter_id": 23326, "verse_number": "२-२१-७०", "content_sanskrit": "अघोरेण फडंतेन संसृतिश्च न संशयः ।\nप्रतितत्त्वं क्रमो ह्येष योगमार्गेण सुव्रत ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003326070, "chapter_id": 23326, "verse_number": "२-२१-७१", "content_sanskrit": "मुष्टिना चैव यावच्च तावत्कालं नयेत्क्रमात् ।\nविषुवेण तु योगेन निवृत्त्यादि शिवांतिकम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003326071, "chapter_id": 23326, "verse_number": "२-२१-७२", "content_sanskrit": "एकत्र समतां याति नान्यथा तु पृथक्पृथक् ।\nनासाग्रे द्वादशांतेन पृष्ठेन सह योगिनाम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003326072, "chapter_id": 23326, "verse_number": "२-२१-७३", "content_sanskrit": "क्षंतव्यमिति विप्रेंद्र देवदेवस्य शासनम् ।\nहेमराजतताम्राद्यैर्विधिना कल्पितेन च ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003326073, "chapter_id": 23326, "verse_number": "२-२१-७४", "content_sanskrit": "सकूर्चेन सवस्त्रेण तंतुना वेष्टितेन च ।\nतीर्थांबुपूरितेनैव रत्नगर्भेण सुव्रत ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003326074, "chapter_id": 23326, "verse_number": "२-२१-७५", "content_sanskrit": "संहितामांत्रितेनैव रुद्राध्यायस्तुतेन च ।\nसेचयेच्च ततः शिष्यं शिवभक्तं च धार्मिकम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003326075, "chapter_id": 23326, "verse_number": "२-२१-७६", "content_sanskrit": "सोऽपि शिष्यः शिवस्याग्रे सुरोरग्रे च सादरम् ।\nवह्नेश्च दीक्षां कुर्वीत दीक्षितश्च तथाचरेत् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003326076, "chapter_id": 23326, "verse_number": "२-२१-७७", "content_sanskrit": "वरं प्राणपरित्यागश्छेदनं शिरसोऽपि वा ।\nन त्वनभ्यर्च्य भुंजीयाद्भगवंतं सदाशिवम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003326077, "chapter_id": 23326, "verse_number": "२-२१-७८", "content_sanskrit": "एवं दीक्षा प्रकर्तव्या पूजा चैव यताक्रमम् ।\nत्रिकालमेककालं वा पूजयेत्परमेश्वरम् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003326078, "chapter_id": 23326, "verse_number": "२-२१-७९", "content_sanskrit": "अग्निहोत्रं च वेदाश्च यज्ञाश्च बहुदक्षिणाः ।\nशिवलिंगार्चनस्यैते कलांशेनापि नो समाः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003326079, "chapter_id": 23326, "verse_number": "२-२१-८०", "content_sanskrit": "सदा यजति यज्ञेन सदा दानं प्रयच्छति ।\nसदा च वायुभक्षश्च सकृद्योऽभ्यर्चयेच्छिवम् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003326080, "chapter_id": 23326, "verse_number": "२-२१-८१", "content_sanskrit": "एककालं द्विकालं वा त्रिकालं नित्यमेव वा ।\nयोऽर्चयांति महादेवं ते रुद्रा नात्र संशयः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003326081, "chapter_id": 23326, "verse_number": "२-२१-८२", "content_sanskrit": "नारुद्रस्तु स्पृसेद्रुद्रं नारुद्रो रुद्रमर्चयेत् ।\nनारुद्रः कीर्तयेद्रूद्रं नारुद्रो रुद्रमाप्नुयात् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003326082, "chapter_id": 23326, "verse_number": "२-२१-८३", "content_sanskrit": "एवं संक्षेपतः प्रोक्तो ह्यधिकारिविधिक्रमः ।\nशिवार्चनार्थं धर्मार्थकाममोक्षफलप्रदः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}]