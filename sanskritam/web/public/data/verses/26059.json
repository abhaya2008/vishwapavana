[{"id": 7006059000, "chapter_id": 26059, "verse_number": "२-३-१", "content_sanskrit": "सूत उवाच ।\nएवमुत्साहितः पक्षी स्वरूपं निरयस्य तु ।\nपप्रच्छनरकाण्येवं श्रुत्वा चोत्कूलितान्तरः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006059001, "chapter_id": 26059, "verse_number": "२-३-२", "content_sanskrit": "गरुड उवाच ।\nनरकाणां स्वरूपं मे वद येषु विकर्मिणः ।\nपात्यन्ते दुः खभूयिष्ठास्तेषां भेदांश्च कीर्तय ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006059002, "chapter_id": 26059, "verse_number": "२-३-३", "content_sanskrit": "श्रीभगवानुवाच ।\nनरकाणां सहस्राणि वर्तन्ते ह्यरुणानुज ।\nशक्यं विस्तरतो नैव वक्तुं प्राधान्यतो ब्रुवे ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006059003, "chapter_id": 26059, "verse_number": "२-३-४", "content_sanskrit": "रौरवं नाम नरकं मुख्यं तद्वैनिबोध मे ।\nरौरवे कूटसाक्षी तु याति यश्चानृती नरः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006059004, "chapter_id": 26059, "verse_number": "२-३-५", "content_sanskrit": "योजनानां सहस्रे द्वे रौरवो हि प्रमाणतः ।\nजानुमात्रप्रमाणं तु तत्र गर्तं सुदुस्तरम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006059005, "chapter_id": 26059, "verse_number": "२-३-६", "content_sanskrit": "तत्राङ्गारचयौघेन कृतं तद्धरणीसमम् ।\nतत्राग्निना सुतीव्रेण तापिताङ्गारभूमिना ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006059006, "chapter_id": 26059, "verse_number": "२-३-७", "content_sanskrit": "तन्मध्ये पापकर्माणं विमुञ्चन्ति यमानुगाः ।\nस दह्यमानस्तीव्रेण वह्निना परिधावति ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006059007, "chapter_id": 26059, "verse_number": "२-३-८", "content_sanskrit": "पदेपदे च पादोऽस्य स्फुट्यते शीर्यते पुनः ।\nअहोरात्रेणोद्धरणं पादन्यासेन गच्छति ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006059008, "chapter_id": 26059, "verse_number": "२-३-९", "content_sanskrit": "एवं सहस्रं विस्तीर्णं योजनानां विमुच्यते ।\nततोऽन्यत्पापशुद्ध्यर्थं तादृङ्निरयमृच्छति ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006059009, "chapter_id": 26059, "verse_number": "२-३-१०", "content_sanskrit": "रौरवस्ते समाख्यातः प्रथमो नरको मया ।\nमहारौरवसंज्ञं तु शृणुष्व नरकं खग ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006059010, "chapter_id": 26059, "verse_number": "२-३-११", "content_sanskrit": "योजनानां सहस्राणि सन्ति पञ्च समन्ततः ।\nतत्र ताम्रमयी भूमिरधस्तस्या हुताशनः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006059011, "chapter_id": 26059, "verse_number": "२-३-१२", "content_sanskrit": "तया तपन्त्या सा सर्वा प्रोद्यद्विद्युत्समप्रभा ।\nविभाव्यते महारौद्रा पापिनां दर्शनादिषु ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006059012, "chapter_id": 26059, "verse_number": "२-३-१३", "content_sanskrit": "तस्यां बद्धकराभ्यां च पद्भ्यां चैव यमानुगैः ।\nमुच्यते पापकृन्मध्ये लुण्ठमानः स गच्छति ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006059013, "chapter_id": 26059, "verse_number": "२-३-१४", "content_sanskrit": "काकैर्बकैर्वृकोलूकैर्मशकैर्वृश्चिकैस्तथा ।\nभक्ष्यमाणैस्तथा रौद्रैर्गतो मार्गे विकृष्यते ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006059014, "chapter_id": 26059, "verse_number": "२-३-१५", "content_sanskrit": "दह्यमानो गतमतिर्भ्रान्तस्तातेति चाकुलः ।\nवदत्यसकृदुद्वग्नो न शान्तिमधिगच्छति ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006059015, "chapter_id": 26059, "verse_number": "२-३-१६", "content_sanskrit": "एवं तस्मान्नरैर्मोक्षस्त्वतिक्रान्तैरवाप्यते ।\nवर्षायुतायुतैः पापं यैः कृतं दुष्टबुद्धिभिः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006059016, "chapter_id": 26059, "verse_number": "२-३-१७", "content_sanskrit": "तथान्यस्तु ततो नाम सोऽतिशीतः स्वभावतः ।\nमहारौरववद्दीर्घस्तथान्धतमसा वृतः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006059017, "chapter_id": 26059, "verse_number": "२-३-१८", "content_sanskrit": "शीतार्तास्तत्र बध्यन्ते नरास्तमसि दारुणे ।\nपरस्परं समासाद्य परिरभ्याश्रयन्ति ते ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006059018, "chapter_id": 26059, "verse_number": "२-३-१९", "content_sanskrit": "दन्तास्तेषां च भज्यन्ते शीतार्तिपरिकम्पिताः ।\nक्षुतृषातिबलाः पक्षिन्नथ तत्राप्युपदवाः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006059019, "chapter_id": 26059, "verse_number": "२-३-२०", "content_sanskrit": "हिमखण्डवहो वायुभिनत्त्यस्थीनि दारुणः ।\nमज्जासृगस्थिगलितमश्रन्त्यत्र क्षुधान्विताः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006059020, "chapter_id": 26059, "verse_number": "२-३-२१", "content_sanskrit": "आलिङ्ग्यमाना भ्राम्यन्ते परस्परसमागमे ।\nएवं तत्रापि सुमहान्क्लेशस्तमसि मानवैः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006059021, "chapter_id": 26059, "verse_number": "२-३-२२", "content_sanskrit": "प्राप्यते शकुनिश्रेष्ठ यो बहूकृतसञ्चयः ।\nनिकृन्तन इति ख्यातस्ततोऽन्यो नरकोत्तमः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006059022, "chapter_id": 26059, "verse_number": "२-३-२३", "content_sanskrit": "कुलालचक्राणि तत्र भ्राम्यन्त्यविरतं खग ।\nतेष्वापाष्ये निकृष्यन्ते कालसूत्रेण मानवाः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006059023, "chapter_id": 26059, "verse_number": "२-३-२४", "content_sanskrit": "यमानुमाङ्गुलिस्थेन आपादतलमस्तकम् ।\nन चैषां जीवितभ्रंशो जायते पक्षिसत्तम ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006059024, "chapter_id": 26059, "verse_number": "२-३-२५", "content_sanskrit": "छिन्नानि तेषां शतशः खण्डान्यैक्यं व्रजन्ति हि ।\nएवं वर्षसहस्राणि भ्राम्यन्ते पापकर्मिणः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006059025, "chapter_id": 26059, "verse_number": "२-३-२६", "content_sanskrit": "तावद्यावदशेषं च तत्पापं संक्षयं गतम् ।\nअप्रातष्ठं च नरकं शृणुष्व गदतो मम ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006059026, "chapter_id": 26059, "verse_number": "२-३-२७", "content_sanskrit": "तत्रस्थैर्नारकैर्दुः खमसह्यमनुभूयते ।\nतान्येव तत्र चक्राणि घटीयन्त्राणि चान्यतः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006059027, "chapter_id": 26059, "verse_number": "२-३-२८", "content_sanskrit": "दुः खस्य हेतुभूतानि पापकर्मकृतां नृणाम् ।\nचक्रेष्वारोपिताः केचिद्भाम्यन्ते तत्र मानवाः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006059028, "chapter_id": 26059, "verse_number": "२-३-२९", "content_sanskrit": "यावद्वर्षसहस्राणि न तेषां स्थितिरन्तरा ।\nघटीयन्त्रेषु बद्वा ये बद्धा तोयवटी यथा ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006059029, "chapter_id": 26059, "verse_number": "२-३-३०", "content_sanskrit": "भ्राम्यन्ते मानवा रक्तमुद्गिरन्तः पुनः पुनः ।\nअन्त्रैर्मुखविनिष्क्रान्तैर्नेत्रैरन्त्रावलम्बिभैः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006059030, "chapter_id": 26059, "verse_number": "२-३-३१", "content_sanskrit": "दुः खानि प्राप्नुवन्तीह यान्यसह्यानि जन्तुभिः ।\nअसिपत्रवनं नाम नरकं शृणु चापरम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006059031, "chapter_id": 26059, "verse_number": "२-३-३२", "content_sanskrit": "योजनानां सहस्रं यो ज्वलत्यग्न्याशृतावनिः ।\nसप्ततीव्रकराश्चैण्डर्यत्र तीव्र सुदारुणे ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006059032, "chapter_id": 26059, "verse_number": "२-३-३३", "content_sanskrit": "प्रतपन्ति सदा तत्र प्राणिनो नरकौकसः ।\nतन्मध्ये चरणं शीतस्निग्धपत्रं विभाष्यते ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006059033, "chapter_id": 26059, "verse_number": "२-३-३४", "content_sanskrit": "पत्राणि यत्र खण्डानि फलानां पक्षिसत्तम ।\nश्वानश्च तत्र सुबलाश्चरन्त्यामिषभोजनाः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006059034, "chapter_id": 26059, "verse_number": "२-३-३५", "content_sanskrit": "महावक्त्रा महादंष्ट्रा व्याघ्रा इव महाबलाः ।\nततश्च वनमालोक्य शिशिरच्छायमग्रतः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006059035, "chapter_id": 26059, "verse_number": "२-३-३६", "content_sanskrit": "प्रयान्ति प्राणिनस्तत्र क्षुत्तापपरिपीडिताः ।\nमातर्भ्रातस्तात इति क्रन्दमानाः सुदुः खिताः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006059036, "chapter_id": 26059, "verse_number": "२-३-३७", "content_sanskrit": "दह्यमानाङ्घ्रियुगला धरणिस्थेन वह्निना ।\nतेषां गतानां तत्रापि अति शीतिः समीरणः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006059037, "chapter_id": 26059, "verse_number": "२-३-३८", "content_sanskrit": "प्रवाति तेन पात्यन्ते तेषां खड्गास्तथोपरि ।\nछिन्नाः पतन्ति ते भूमौ ज्वलत्पावकसंचये ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006059038, "chapter_id": 26059, "verse_number": "२-३-३९", "content_sanskrit": "लेलिह्यमाने चान्यत्र तप्ताशेषमहीतले ।\nसारमेयाश्च ते शीघ्रं शातयन्ति शरीरतः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006059039, "chapter_id": 26059, "verse_number": "२-३-४०", "content_sanskrit": "तेषां खण्डान्यनेकानि रुदतामतिभीषणे ।\nअसिपत्रवनं तात मयैतत्परिकीर्तितम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006059040, "chapter_id": 26059, "verse_number": "२-३-४१", "content_sanskrit": "अतः परं भीमतरं तप्तकुंभं निबोध मे ।\nसमन्ततस्तप्तकुम्भा वह्निज्वालासमन्विताः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006059041, "chapter_id": 26059, "verse_number": "२-३-४२", "content_sanskrit": "ज्वलदग्निचयास्तप्ततैलायश्चूर्णपूरिताः ।\nएषु दुष्कृतकर्माणो याम्यैः क्षिप्ता ह्यधोमुखाः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006059042, "chapter_id": 26059, "verse_number": "२-३-४३", "content_sanskrit": "क्वाथ्यन्ते विस्फुटद्गात्रा गलन्मज्जाजलान्विताः ।\nस्फुटत्कपालेनत्रास्थिच्छिद्यमाना विभीषणैः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006059043, "chapter_id": 26059, "verse_number": "२-३-४४", "content_sanskrit": "गृध्रैरुत्पाट्य मुच्यन्ते पुनस्तेष्वेव वेगितैः ।\nपुनश्चिमचिमायन्ते तैलनैक्यं व्रजन्ति च ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006059044, "chapter_id": 26059, "verse_number": "२-३-४५", "content_sanskrit": "द्रवीभूतैः शिरोगात्रैः स्नायुमांसत्वगास्थिभिः ।\nततो याम्यैर्नरैराशु दर्व्याघट्टनघट्टिताः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006059045, "chapter_id": 26059, "verse_number": "२-३-४६", "content_sanskrit": "कृतावर्ते महातैले क्वाथ्यन्ते पापकर्मिणः ।\nएष ते विस्तरेणोक्तस्तप्तकुम्भो मया खग ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006059046, "chapter_id": 26059, "verse_number": "२-३-४७", "content_sanskrit": "आदिमो रौरवः प्रोक्तो महारौरवकोऽपरः ।\nअतिशीतस्तृतीयस्तु चतुर्थो हि निकृन्तनः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006059047, "chapter_id": 26059, "verse_number": "२-३-४८", "content_sanskrit": "अप्रतिष्ठः पञ्चमः स्यादसिपत्रवनोऽपरः ।\nसप्तमस्तप्तकुम्भस्तु सप्तैते नरका मताः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006059048, "chapter_id": 26059, "verse_number": "२-३-४९", "content_sanskrit": "श्रूयन्तेन्यान्यपि तथा नरकाणि नराधमाः ।\nकर्मणां तारतम्येन तेषुतेषु पतन्ति हि ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006059049, "chapter_id": 26059, "verse_number": "२-३-५०", "content_sanskrit": "तथा हि नरको रोधः शूकरस्ताल एव च ।\nतप्तकुम्भो महाज्वालः शबलोऽथ विमोहनः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006059050, "chapter_id": 26059, "verse_number": "२-३-५१", "content_sanskrit": "क्रिमिश्च क्रिमभक्षश्च लालाभक्षो विषञ्जनः ।\nअधः शिराः पूयवहो रुधिरान्धश्च विड्रभुजः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006059051, "chapter_id": 26059, "verse_number": "२-३-५२", "content_sanskrit": "तथा वैतरणी सू (मू) मसिपत्रवनं तथा ।\nअग्निज्वालो महाघोरः सन्दंशो वाप्यभोजनः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006059052, "chapter_id": 26059, "verse_number": "२-३-५३", "content_sanskrit": "तमश्च कालसूत्रं च लोहश्चाप्यभिदस्तथा ।\nअप्रतिष्ठोऽप्यवीचिश्च नरका एवमादयः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006059053, "chapter_id": 26059, "verse_number": "२-३-५४", "content_sanskrit": "तामसा नरकाः सर्वे यमस्य विषये स्थिताः ।\nयेषु दुष्कृतकर्माणः पतन्ति हि पृथक्पृथक् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006059054, "chapter_id": 26059, "verse_number": "२-३-५५", "content_sanskrit": "भूमेरधस्तात्ते सर्वे रौरवाद्याः प्रकीर्तिताः ।\nरोघो गोघ्नो भ्रूणहा च अग्निदाता नरः पतेत् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006059055, "chapter_id": 26059, "verse_number": "२-३-५६", "content_sanskrit": "सूकरे ब्रह्महा मज्जेत्सुरापः स्वर्णतस्करः ।\nताले पतेत्क्षत्त्रहन्ता हत्वा वैश्यं च दुर्गतिः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006059056, "chapter_id": 26059, "verse_number": "२-३-५७", "content_sanskrit": "ब्रह्महत्यां च यः कुर्याद्यश्च स्याद्गुरुतल्पगः ।\nस्वसृगामी तप्तकुम्भी तथा राजभटोऽनृती ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006059057, "chapter_id": 26059, "verse_number": "२-३-५८", "content_sanskrit": "तप्तलोहैश्च विक्रेता तथा बन्धनरक्षिता ।\nमाध्वी विक्रयकर्तां च यस्तु भक्तं परित्यजेत् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006059058, "chapter_id": 26059, "verse_number": "२-३-५९", "content_sanskrit": "महाज्वाली दुहितरं स्नुषां गच्छति यस्तु वै ।\nवेदो विक्रीयते यैश्च वेदं दूषयते तु यः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006059059, "chapter_id": 26059, "verse_number": "२-३-६०", "content_sanskrit": "गुरुं चैवावमन्यन्ते वाक्शरैस्ताडयन्ति च ।\nअगम्यागामी च नरो नरकं शबलं व्रजेत् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006059060, "chapter_id": 26059, "verse_number": "२-३-६१", "content_sanskrit": "विमोहे पतते शूरे मर्यादां यो भिनत्ति वै ।\nदुरिष्टं कुरुते यस्तु कृमिभक्षं प्रपद्यते ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006059061, "chapter_id": 26059, "verse_number": "२-३-६२", "content_sanskrit": "देवब्राह्मणविद्वेष्टा लालाभक्षे पतत्यपि ।\nकुण्डकर्ता कुलालश्च न्यासहर्ता चिकित्सकः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006059062, "chapter_id": 26059, "verse_number": "२-३-६३", "content_sanskrit": "आरामेष्वग्निदाता च एते यान्ति विषञ्जने ।\nअसत्प्रतिग्रही यस्तु तथैवायाज्ययाजकः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006059063, "chapter_id": 26059, "verse_number": "२-३-६४", "content_sanskrit": "न क्षत्त्रैर्जोवते यस्तु नरो गच्छेदधोमुखम् ।\nक्षीरं सुरां च मासं लाक्षां गन्धं रसं तिलान् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006059064, "chapter_id": 26059, "verse_number": "२-३-६५", "content_sanskrit": "एवमादीनि विक्रीणन् घोरे पूयवहे पतेत् ।\nयः कुक्कुटान्निबध्नाति मार्जारान् सूकरांश्च तान् ।\nपक्षिणश्च मृगांश्छा गान्सोऽप्येवं नरकं व्रजेत् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006059065, "chapter_id": 26059, "verse_number": "२-३-६६", "content_sanskrit": "आजाविको माहिषिकस्तथा चक्री ध्वजी च यः ।\nरङ्गोपजीविको विप्रः शाकुनिर्ग्रामयाजकः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006059066, "chapter_id": 26059, "verse_number": "२-३-६७", "content_sanskrit": "अगारदाही गरदः कुण्डाशी सोमविक्रयी ।\nसुरापो मांसभक्षी च तथा च पशुघातकः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006059067, "chapter_id": 26059, "verse_number": "२-३-६८", "content_sanskrit": "रुधिरान्धे पतन्त्येते पतन्त्येते एवमाहुर्मनीषिणः ।\nउपविष्टन्त्वेकपङ्क्त्यां विषं सम्भोजयन्ति ये ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006059068, "chapter_id": 26059, "verse_number": "२-३-६९", "content_sanskrit": "पतन्ति निरये घोरे विड्भुजे नात्र संशयः ।\nमधुग्राहो वैतरणीमाक्रोशी मूत्रसंज्ञके ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006059069, "chapter_id": 26059, "verse_number": "२-३-७०", "content_sanskrit": "असिपत्रवनेऽसौची क्रोधनश्च एतेदपि ।\nअग्निज्वालां मृगव्याधो भोज्यते यत्र वायसैः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006059070, "chapter_id": 26059, "verse_number": "२-३-७१", "content_sanskrit": "इज्यायां व्रतलोपाच्च सन्दंशे नरके पतेत् ।\nस्कन्दन्ते यदि वा स्वप्ने यतिनो ब्रह्मचारिणः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006059071, "chapter_id": 26059, "verse_number": "२-३-७२", "content_sanskrit": "पुत्रैरध्यापिता ये च पुत्रैराज्ञापिताश्च ये ।\nते सर्वे नरकं यान्ति निरयं चाप्यभोजनम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006059072, "chapter_id": 26059, "verse_number": "२-३-७३", "content_sanskrit": "वर्णाश्रमविरुद्धानि क्रोधहर्षसमन्विताः ।\nकर्माणि ये तु कुर्वन्ति सर्वे निरयवासिनः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006059073, "chapter_id": 26059, "verse_number": "२-३-७४", "content_sanskrit": "उपरिष्टात्स्थितो घोर उष्णात्मा रौरवो महान् ।\nसुदारुणः सुशीतात्मा तस्या धस्तामसः स्मृतः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006059074, "chapter_id": 26059, "verse_number": "२-३-७५", "content_sanskrit": "एवमादिक्रमेणैव सर्वेऽधोऽधः परिस्थिताः ।\nदुः खोत्कर्षश्च सर्वेषु कर्मस्वपि निमित्ततः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006059075, "chapter_id": 26059, "verse_number": "२-३-७६", "content_sanskrit": "सुखोत्कर्षश्च सर्वत्र धर्मस्येहनिमिततः ।\nपश्यन्तिनरकान्देवा ह्यधोवक्त्रान्सुदारुणान् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7006059076, "chapter_id": 26059, "verse_number": "२-३-७७", "content_sanskrit": "नारकाश्चापि ते देवान्सर्वान्पश्यन्ति ऊर्ध्वगान् ।\nएतान्यान्यानि शतशो नरकाणि वियद्गते ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7006059077, "chapter_id": 26059, "verse_number": "२-३-७८", "content_sanskrit": "दिनेदिने तु नरके पच्यते दह्यतेन्यतः ।\nशीर्यते भिद्यतेऽन्यत्र चूर्यते क्लिद्यतेन्यतः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7006059078, "chapter_id": 26059, "verse_number": "२-३-७९", "content_sanskrit": "क्वथ्यते दीप्यतेऽन्यत्र तथा वातहतोऽन्यतः ।\nएकं दिनं वर्षशतप्रमाणं नरके भवेत् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7006059079, "chapter_id": 26059, "verse_number": "२-३-८०", "content_sanskrit": "ततः सर्वेषु निस्तीर्णः पापी तिर्यक्त्वमश्नते ।\nकृमिकीटपतङ्गेषु स्थावरैकशफेषु च ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7006059080, "chapter_id": 26059, "verse_number": "२-३-८१", "content_sanskrit": "गत्वा वनगजाढ्येषु गोष्वषु तथैव च ।\nखरोऽश्वोऽश्वतरो गौरः शरभश्चमरी तथा ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7006059081, "chapter_id": 26059, "verse_number": "२-३-८२", "content_sanskrit": "एते चैकशफाः षट्च शृणु पञ्चनखानतः ।\nअन्यासु बहुपापासु दुः खदासु च यो निषु ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7006059082, "chapter_id": 26059, "verse_number": "२-३-८३", "content_sanskrit": "मानुष्यं प्राप्यते कुब्जो कुत्सितो वामनोऽपि वा ।\nचण्डालपुक्कसाद्यासु नरयोनिषु जायते ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7006059083, "chapter_id": 26059, "verse_number": "२-३-८४", "content_sanskrit": "मुहुर्गर्भे वसन्त्येव म्रियन्ते च मुहुर्मुहुः ।\nअवशिष्टेन पापेन पुण्येन च समन्वितः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7006059084, "chapter_id": 26059, "verse_number": "२-३-८५", "content_sanskrit": "ततश्चारोहिणीं योनिं शूद्रवैश्यनृपादिकम् ।\nविप्रदेवेन्द्रतां चापि कदाचिदधिरोहति ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7006059085, "chapter_id": 26059, "verse_number": "२-३-८६", "content_sanskrit": "एवं तु पापकर्माणो निरयेषु पतन्त्यधः ।\nयथा पुण्यकृतो यान्ति तन्मे निगदतः शृणु ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7006059086, "chapter_id": 26059, "verse_number": "२-३-८७", "content_sanskrit": "ते यमेन विनिर्दिष्टां योनिं पुण्यगतिं नराः ।\nप्रगीतगन्धर्वगणा नृत्योत्सवसमाकुलाः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7006059087, "chapter_id": 26059, "verse_number": "२-३-८८", "content_sanskrit": "हारनूपुरमाधुर्यैः शोभितान्यमलानि तु ।\nप्रयान्त्याशु विमानानि दिव्यगन्धस्रगुज्ज्वलाः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7006059088, "chapter_id": 26059, "verse_number": "२-३-८९", "content_sanskrit": "तस्माच्च प्रच्युता राज्ञामन्येषां च महात्मनाम् ।\nजायन्ते नीरुजां गेहे स द्वृत्तिपीरपालकाः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7006059089, "chapter_id": 26059, "verse_number": "२-३-९०", "content_sanskrit": "भोगान्सम्प्राप्नुवन्त्युग्रांस्ततो यान्त्यूर्ध्वमन्यथा ।\nअवरोहिणीं सम्प्राप्य पूर्ववद्यन्ति मानवाः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7006059090, "chapter_id": 26059, "verse_number": "२-३-९१", "content_sanskrit": "जातस्य मृत्युलोके वै प्राणिनो मरणं ध्रुवम् ।\nपापिष्ठानामदोमार्गाज्जीवो निष्क्रमते ध्रुवम् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7006059091, "chapter_id": 26059, "verse_number": "२-३-९२", "content_sanskrit": "पृथिव्यां लीयते पृथ्वी आपश्चैव तथाप्सु च ।\nतेजस्तेजसि लीयते समीरे च समीरणः ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7006059092, "chapter_id": 26059, "verse_number": "२-३-९३", "content_sanskrit": "आकाशे च तथाकाशं सर्वव्यापि निशाकरे ।\nतत्र कामस्तथा क्रोधः काये पञ्चेन्द्रियाणि च ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7006059093, "chapter_id": 26059, "verse_number": "२-३-९४", "content_sanskrit": "एते तार्क्ष्य समाख्याता देहे तिष्ठन्ति तस्कराः ।\nकामः क्रोधो ह्यहङ्कारो मनस्तत्रैव नायकः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7006059094, "chapter_id": 26059, "verse_number": "२-३-९५", "content_sanskrit": "संहारश्चैव कालोऽसौ पुण्यपापेन संयुतः ।\nपञ्चेन्द्रियसमायुक्तः सकलैर्विबुधैः सह ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7006059095, "chapter_id": 26059, "verse_number": "२-३-९६", "content_sanskrit": "प्रविशेत्स नवे देहे पृहे दरधे गुही यथा ।\nशरीरे ये समासीनाः सर्वे वै सप्त धातवः ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7006059096, "chapter_id": 26059, "verse_number": "२-३-९७", "content_sanskrit": "षाट्कौशिको ह्ययं कायः सर्वे वाताश्च देहिनाम् ।\nमूत्रं पुरीषं तद्योगाद्ये चान्ये व्याधयस्तथा ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7006059097, "chapter_id": 26059, "verse_number": "२-३-९८", "content_sanskrit": "पित्तं श्लेष्मा तथा मज्जा मांसं वै मेद एव च ।\nअस्थि शुक्रं तथा स्नायुर्देहेन सह दह्यति ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7006059098, "chapter_id": 26059, "verse_number": "२-३-९९", "content_sanskrit": "एष ते कथितस्तार्क्ष्य विनासः सर्वदेहिनम् ।\nकथयामि पुनस्तेषां शरीरं च यथा भवेत् ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7006059099, "chapter_id": 26059, "verse_number": "२-३-१००", "content_sanskrit": "एकस्तम्बंस्नायुबद्धं स्थूणात्रयविभूषणम् ।\nइन्द्रियैश्च समायुक्तं नवद्वारं शरीरकम् ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7006059100, "chapter_id": 26059, "verse_number": "२-३-१०१", "content_sanskrit": "विषयैश्च समाक्रान्तं कामक्रोधसमाकुलम् ।\nरागद्वेषसमाकीर्णं तृष्णादुर्गमतस्करम् ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7006059101, "chapter_id": 26059, "verse_number": "२-३-१०२", "content_sanskrit": "लोभजालपरिच्छिन्नं मोहवस्त्रेण वेष्टितम् ।\nसुबद्धं मायया चैतल्लोभेनाधिष्ठितं पुरम् ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7006059102, "chapter_id": 26059, "verse_number": "२-३-१०३", "content_sanskrit": "एतद्गुणसमाकीर्णं शरीरं सर्वदेहिनाम् ।\nआत्मानं ये न जानन्ति ते नराः पशवः स्मृताः ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7006059103, "chapter_id": 26059, "verse_number": "२-३-१०४", "content_sanskrit": "एवमेव समाख्यातं शरीरं ते चतुर्विधम् ।\nचतुरशीतिलक्षाणि निर्मिता योनयः पुरा ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7006059104, "chapter_id": 26059, "verse_number": "२-३-१०५", "content_sanskrit": "उद्भिज्जाः स्वेदजाश्चैव अण्डजाश्च जरायुजाः ।\nएतत्ते सर्वमाख्यातं निरयस्य प्रपञ्चतः ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7006059105, "chapter_id": 26059, "verse_number": "२-३-१०६", "content_sanskrit": "अथयामि क्रमप्राप्तं प्रष्टु वा वर्तते स्पृहा ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}]