[{"id": 7005440000, "chapter_id": 25440, "verse_number": "१-१०-१", "content_sanskrit": "श्रीकूर्म उवाच ।\nगते महेश्वरे देवे सोधिवासं पितामहः ।\nतदेव सुमहत्पद्मं भेजे नाभिसमुत्थितम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005440001, "chapter_id": 25440, "verse_number": "१-१०-२", "content_sanskrit": "अथ दीर्घेण कालेन तत्राप्रतिमपौरुषौ ।\nमहासुरौ समायातौ भ्रातरौ मधुकैटभौ ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005440002, "chapter_id": 25440, "verse_number": "१-१०-३", "content_sanskrit": "क्रोधेन महताविष्टौ महापर्वतविग्रहौ ।\nकर्णान्तरसमुद्‌भूतौ देवदेवस्य शार्ङ्गिणः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005440003, "chapter_id": 25440, "verse_number": "१-१०-४", "content_sanskrit": "तावागतौ समीक्ष्याह नारायणमजो विभुः ।\nत्रैलोक्यकण्टकावेतावसुरौ हन्तुमर्हसि ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005440004, "chapter_id": 25440, "verse_number": "१-१०-५", "content_sanskrit": "तदस्य वचनं श्रुत्वा हरिर्नारायणः प्रभुः ।\nआज्ञापयामास तयोर्वधार्थं पुरुषावुभौ ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005440005, "chapter_id": 25440, "verse_number": "१-१०-६", "content_sanskrit": "तदाज्ञया महद्युद्धं तयोस्ताभ्यामभूद् द्विजाः ।\nव्यजयत् कैटभं जिष्णुः विष्णुश्च व्यजयन्मधुम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005440006, "chapter_id": 25440, "verse_number": "१-१०-७", "content_sanskrit": "ततः पद्मासनासीनं जगन्नाथं पितामहम् ।\nबभाषे मधुरं वाक्यं स्नेहाविष्टमना हरिः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005440007, "chapter_id": 25440, "verse_number": "१-१०-८", "content_sanskrit": "अस्मान्मयोह्यमानस्त्वं पद्मादवतर प्रभो ।\nनाहं भवन्तं शक्नोमि वोढुं तेजोमयं गुरुम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005440008, "chapter_id": 25440, "verse_number": "१-१०-९", "content_sanskrit": "ततोऽवतीर्य विश्वात्मा देहमाविश्य चक्रिणः ।\nअवाच वैष्णवीं निद्रामेकीभूतोऽथ विष्णुना ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005440009, "chapter_id": 25440, "verse_number": "१-१०-१०", "content_sanskrit": "सहस्त्रशीर्षनयनः शङ्खचक्रगदाधरः ।\nब्रह्मा नारायणाख्योऽसौ सुष्वाप सलिले तदा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005440010, "chapter_id": 25440, "verse_number": "१-१०-११", "content_sanskrit": "सोऽनुभूय चिरं कालमानन्दं परमात्मनः ।\nअनाद्यनन्तमद्वैतं स्वात्मानं ब्रह्मसंज्ञितम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005440011, "chapter_id": 25440, "verse_number": "१-१०-१२", "content_sanskrit": "ततः प्रभाते योगात्मा भूत्वा देवश्चतुर्मुखः ।\nससर्ज सृष्टिं तद्रूपां वैष्णवं भावमाश्रितः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005440012, "chapter_id": 25440, "verse_number": "१-१०-१३", "content_sanskrit": "पुरस्तादसृजद्देवः सनन्दं सनकं तथा ।\nऋभुं सनत्कुमारं च पुर्वजं तं सनातनम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005440013, "chapter_id": 25440, "verse_number": "१-१०-१४", "content_sanskrit": "ते द्वन्द्वमोहनिर्मुक्ताः परं वैराग्यमास्थिताः ।\nविदित्वा परमं भावं न सृष्टौ दधिरे मतिम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005440014, "chapter_id": 25440, "verse_number": "१-१०-१५", "content_sanskrit": "तेष्वेवं निरपेक्षेषु लोकसृष्टौ पितामहः ।\nबभूव नष्टचेता वै मायया परमेष्ठिनः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005440015, "chapter_id": 25440, "verse_number": "१-१०-१६", "content_sanskrit": "ततः पुराणपुरुषो जगन्मूर्ति सनातनः ।\nव्याजहारात्मनः पुत्रं मोहनाशाय पद्मजम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005440016, "chapter_id": 25440, "verse_number": "१-१०-१७", "content_sanskrit": "विष्णुरुवाच ।\nकच्चिन्न विस्मृतो देवः शूलपाणिः सनातनः ।\nयदुक्तवानात्मनोऽसौ पुत्रत्वे तव शंकरः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005440017, "chapter_id": 25440, "verse_number": "१-१०-१८", "content_sanskrit": "प्रयुक्तवान् मनो योऽसौ पुत्रत्वेन तु शङ्कर ।\nअवाप संज्ञां गोविन्दात् पद्मयोनिः पितामहः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005440018, "chapter_id": 25440, "verse_number": "१-१०-१९", "content_sanskrit": "प्रजाः स्त्रष्टुमनास्तेपे तपः परमदुश्चरम् ।\nतस्यैवं तप्यमानस्य न किञ्चित् समवर्तत ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005440019, "chapter_id": 25440, "verse_number": "१-१०-२०", "content_sanskrit": "ततो दीर्घेण कालेन दुःखात्क्रोधोऽभ्यजायत ।\nक्रोधाविष्टस्य नेत्राभ्यां प्रापतन्नश्रुबिन्दवः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005440020, "chapter_id": 25440, "verse_number": "१-१०-२१", "content_sanskrit": "ततस्तेभ्योऽश्रुबिन्दुभ्य भूताः प्रेतास्तथाभवन् ।\nसर्वांस्तान्ग्रतो दृष्ट्वा ब्रह्मात्मानमनिन्दत ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005440021, "chapter_id": 25440, "verse_number": "१-१०-२२", "content_sanskrit": "जहौ प्राणांश्च भगवान् क्रोधाविष्टः प्रजापतिः ।\nतदा प्राणमयो रुद्रः प्रादुरसीत् प्रभोर्मुखात् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005440022, "chapter_id": 25440, "verse_number": "१-१०-२३", "content_sanskrit": "सहस्त्रादित्यसंकाशो युगान्तदहनोपमः ।\nरुरोद सुस्वरं घोरं देवदेवः स्वयं शिवः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005440023, "chapter_id": 25440, "verse_number": "१-१०-२४", "content_sanskrit": "रोदमानं ततो ब्रह्मा मा रोदीरित्यभाषत ।\nरोदनाद् रुद्र इत्येवं लोके ख्यातिं गमिष्यसि ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005440024, "chapter_id": 25440, "verse_number": "१-१०-२५", "content_sanskrit": "अन्यानि सप्त नामानि पत्नीः पुत्रांश्चशाश्वतान् ।\nस्थानानि तेषामष्टानां ददौ लोकपितामहः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005440025, "chapter_id": 25440, "verse_number": "१-१०-२६", "content_sanskrit": "भवः शर्वस्तथेशानः पशूनां पतिरेव च ।\nभीमश्चोग्रो महादेवस्तानि नामानि सप्त वै ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005440026, "chapter_id": 25440, "verse_number": "१-१०-२७", "content_sanskrit": "सूर्यो जलं मही वह्निर्वायुराकाशमेव च ।\nदीक्षितो ब्राह्मणश्चन्द्र इत्येता अष्टमूर्त्तयः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005440027, "chapter_id": 25440, "verse_number": "१-१०-२८", "content_sanskrit": "स्थानेष्वेतेषु ये रुद्रान् ध्यायन्ति प्रणमन्ति च ।\nतेषामष्टतनुर्देवो ददाति परमं पदम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005440028, "chapter_id": 25440, "verse_number": "१-१०-२९", "content_sanskrit": "सुवर्चला तथैवोमा विकेशी च शिवा तथा ।\nस्वाहा दिशश्च दीक्षा च रोहिणी चेति पत्नयः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005440029, "chapter_id": 25440, "verse_number": "१-१०-३०", "content_sanskrit": "शनैश्चरस्तथा शुक्रो लोहिताङ्गो मनोजवः ।\nस्कन्दः सर्गोऽथ सन्तानो बुधश्चैषां सुताः स्मृताः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005440030, "chapter_id": 25440, "verse_number": "१-१०-३१", "content_sanskrit": "एवंप्रकारो भगवान् देवदेवो महेश्वरः ।\nप्रजाधर्मं च काम च त्यक्त्वा वैराग्यमाश्रितः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005440031, "chapter_id": 25440, "verse_number": "१-१०-३२", "content_sanskrit": "आत्मन्याधाय चात्मानमैश्वरं भावमास्थितः ।\nपीत्वा तदक्षरं ब्रह्म शाश्वतं परमामृतम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005440032, "chapter_id": 25440, "verse_number": "१-१०-३३", "content_sanskrit": "प्रजाः सृजति चादिष्टो ब्रह्मणा नीललोहितः ।\nस्वात्मना सदृशान् रुद्रान् ससर्ज मनसा शिवः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005440033, "chapter_id": 25440, "verse_number": "१-१०-३४", "content_sanskrit": "कपरछ्दिनो निरातङ्कान् नीलकण्ठान् पिनाकिनः ।\nत्रिशूलहस्तानुद्रिक्तान् महानन्दांस्त्रिलोचनान् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005440034, "chapter_id": 25440, "verse_number": "१-१०-३५", "content_sanskrit": "जरामरणनिर्मुक्तान् महावृषभवाहनान् ।\nवीतरागांश्च सर्वज्ञान् कोटिकोटिशतान्प्रभुः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7005440035, "chapter_id": 25440, "verse_number": "१-१०-३६", "content_sanskrit": "तान्दृष्ट्वा विविधान्रुद्रान्निर्मलान्नीललोहितान् ।\nजरामरणनिर्मुक्तान् व्याजहर हरं गुरुः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7005440036, "chapter_id": 25440, "verse_number": "१-१०-३७", "content_sanskrit": "मा स्राक्षीरीदृशीर्देव प्रजा मृत्युविवर्जिताः ।\nअन्याः सृजस्व भूतेश जन्ममृत्युसमन्विताः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7005440037, "chapter_id": 25440, "verse_number": "१-१०-३८", "content_sanskrit": "ततस्तमाह भगवान् कपर्दी कामशासनः ।\nनास्ति मे तादृशः सर्गः सृज त्वमशुभाः प्रजाः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7005440038, "chapter_id": 25440, "verse_number": "१-१०-३९", "content_sanskrit": "ततः प्रभृति देवोऽसौ न प्रसूतेऽशुभाः प्रजाः ।\nस्वात्मजैरेव तै रुद्रैर्निवृत्तात्मा ह्यतिष्ठत ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7005440039, "chapter_id": 25440, "verse_number": "१-१०-४०", "content_sanskrit": "स्थाणुत्वं तेन तस्यासीद् देवदेवस्य शूलिनः ।\nज्ञानं वैराग्यमैश्वर्यं तपः सत्यं क्षमा धृतिः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7005440040, "chapter_id": 25440, "verse_number": "१-१०-४१", "content_sanskrit": "द्रष्टृत्वमात्मसंबोधो ह्यधिष्ठातृत्वमेव च ।\nअव्ययानि दशैतानि नित्यं तिष्ठन्ति शंकरे ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7005440041, "chapter_id": 25440, "verse_number": "१-१०-४२", "content_sanskrit": "एवं स शंकरः साक्षात्पिनाकी परमेश्वरः ।\nततः स भगवान् ब्रह्मा वीक्ष्य देवं त्रिलोचनम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7005440042, "chapter_id": 25440, "verse_number": "१-१०-४३", "content_sanskrit": "सहैव मानसैः रुद्रैः प्रीतिविस्फारलोचनः ।\nज्ञात्वा परतरं भावमैश्वरं ज्ञानचक्षुषा ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7005440043, "chapter_id": 25440, "verse_number": "१-१०-४४", "content_sanskrit": "तुष्टाव जगतामीशं कृत्वा शिरसि चाञ्जलिम् ।\nब्रह्मोवाच ।\nनमस्तेऽस्तु महादेव नमस्ते परमेश्वर ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7005440044, "chapter_id": 25440, "verse_number": "१-१०-४५", "content_sanskrit": "नमः शिवाय देवाय नमस्ते ब्रह्मरूपिणे ।\nनमोऽस्तु ते महेशाय नमः शान्ताय हेतवे ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7005440045, "chapter_id": 25440, "verse_number": "१-१०-४६", "content_sanskrit": "प्रधानपुरुषेशाय योगाधिपतये नमः ।\nनमः कालाय रुद्राय महाग्रासाय शूलिने ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7005440046, "chapter_id": 25440, "verse_number": "१-१०-४७", "content_sanskrit": "नमः पिनाकहस्ताय त्रिनेत्राय नमो नमः ।\nनमस्त्रिमूर्त्तये तुभ्यं ब्रह्मणो जनकाय ते ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7005440047, "chapter_id": 25440, "verse_number": "१-१०-४८", "content_sanskrit": "ब्रह्मविद्याधिपतये ब्रह्मविद्याप्रदायिने ।\nनमो वेदरहस्याय कालकालाय ते नमः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7005440048, "chapter_id": 25440, "verse_number": "१-१०-४९", "content_sanskrit": "वेदान्तसारसाराय नमो वेदात्ममूर्त्तये ।\nनमो बुद्धाय शुद्धाय योगिनां गुरवे नमः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7005440049, "chapter_id": 25440, "verse_number": "१-१०-५०", "content_sanskrit": "प्रहीणशोकैर्विविधैर्भूतैः वरिवृताय ते ।\nनमो ब्रह्मण्यदेवाय ब्रह्माधिपतये नमः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7005440050, "chapter_id": 25440, "verse_number": "१-१०-५१", "content_sanskrit": "त्र्यम्बकायदिदेवाय नमस्ते परमेष्ठिने ।\nनमो दिग्वाससे तुभ्यं नमो मुण्डाय दण्डिने ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7005440051, "chapter_id": 25440, "verse_number": "१-१०-५२", "content_sanskrit": "अनादिमलहीनाय ज्ञानगम्याय ते नमः ।\nनमस्ताराय तीर्थाय नमो योगर्द्धिहेतवे ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7005440052, "chapter_id": 25440, "verse_number": "१-१०-५३", "content_sanskrit": "नमो धर्माधिगम्याय योगगम्याय ते नमः ।\nनमस्ते निष्प्रपञ्चाय निराभासाय ते न५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7005440053, "chapter_id": 25440, "verse_number": "१-१०-५४", "content_sanskrit": "ब्रह्मणे विश्वरूपाय नमस्ते परमात्मने ।\nत्वयैव सृष्टमखिलं त्वय्येव सकलं स्थितम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7005440054, "chapter_id": 25440, "verse_number": "१-१०-५५", "content_sanskrit": "त्वया संह्रियते विश्वं प्रधानाद्यं जगन्मय ।\nत्वमीश्वरो महादेवः परं ब्रह्म महेश्वरः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7005440055, "chapter_id": 25440, "verse_number": "१-१०-५६", "content_sanskrit": "परमेष्ठी शिवः शान्तः पुरुषो निष्कलो हरः ।\nत्वमक्षरं परं ज्योतिस्त्वं कालः परमेश्वरः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7005440056, "chapter_id": 25440, "verse_number": "१-१०-५७", "content_sanskrit": "त्वमेव पुरुषोऽनन्तः प्रधानं प्रकृतिस्तथा ।\nभूमिरापोऽनलो वायुर्व्योमाहङ्कार एव च ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7005440057, "chapter_id": 25440, "verse_number": "१-१०-५८", "content_sanskrit": "यस्य रूपं नमस्यामि भवन्तं ब्रह्मसंज्ञितम् ।\nयस्य द्यौरभवन्मूर्द्धा पादौ पृथ्वी दिशो भुजाः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7005440058, "chapter_id": 25440, "verse_number": "१-१०-५९", "content_sanskrit": "आकाशमुदरं तस्मै विराजे प्रणमाम्यहम् ।\nसंतापयति यो नित्यं स्वभाभिर्भासयन् दिशः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7005440059, "chapter_id": 25440, "verse_number": "१-१०-६०", "content_sanskrit": "ब्रह्मतेजोमयं वश्वं तस्मै सूर्यात्मने नमः ।\nहव्यं वहति यो नित्यं रौद्री तेजोमयी तनुः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7005440060, "chapter_id": 25440, "verse_number": "१-१०-६१", "content_sanskrit": "कव्यं पितृगणानां च तस्मै वह्न्यात्मने नमः ।\nआप्यायति यो नित्यं स्वधाम्ना सकलं जगत् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7005440061, "chapter_id": 25440, "verse_number": "१-१०-६२", "content_sanskrit": "पीयते देवतासङ्‌घैस्तस्मै सोमात्मने नमः ।\nविभर्त्त्यशेषभूतानि यान्तश्चरति सर्वदा ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7005440062, "chapter_id": 25440, "verse_number": "१-१०-६३", "content_sanskrit": "शक्तिर्माहेश्चरी तुभ्यं तस्मै वाय्वात्मने नमः ।\nसृजत्यशेषमेवेदं यः स्वकर्मानुरूपतः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7005440063, "chapter_id": 25440, "verse_number": "१-१०-६४", "content_sanskrit": "आत्मन्यवस्थितस्तस्मै चतुर्वक्त्रात्मने नमः ।\nयः शते शेषशयने विश्वमावृत्य मायया ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7005440064, "chapter_id": 25440, "verse_number": "१-१०-६५", "content_sanskrit": "स्वात्मानुभूतियोगेन तस्मै विश्वात्मने नमः ।\nविभर्त्ति शिरसा नित्यं द्विसप्तभुवनात्मकम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7005440065, "chapter_id": 25440, "verse_number": "१-१०-६६", "content_sanskrit": "ब्रह्माण्डं योऽखिलाधारस्तस्मै शेषात्मने नमः ।\nयः परान्ते परानन्दं पीत्वा देव्यैकसाक्षिकम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7005440066, "chapter_id": 25440, "verse_number": "१-१०-६७", "content_sanskrit": "नृत्यत्यनन्तमहिमा तस्मै रुद्रात्मने नमः ।\nयोऽन्तरा सर्वभूतानां नियन्ता तिष्ठतीश्वरः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7005440067, "chapter_id": 25440, "verse_number": "१-१०-६८", "content_sanskrit": "यस्य केशेषु जीमूताः नद्यः सर्वांगसन्धिषु ।\nकुक्षौ समुद्रश्चत्वारस्तस्मै तोयात्मने न६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7005440068, "chapter_id": 25440, "verse_number": "१-१०-६९", "content_sanskrit": "तं सर्वसाक्षिणं देवं नमस्ये विश्वतस्तनुम् ।\nयं विनिन्द्रा जितश्वासाः संतुष्टाः समदर्शिनः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7005440069, "chapter_id": 25440, "verse_number": "१-१०-७०", "content_sanskrit": "ज्योतिः पश्यन्ति युञ्जानास्तस्मै योगात्मने नमः ।\nयया संतरते मायां योगी संक्षीणकल्मषः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7005440070, "chapter_id": 25440, "verse_number": "१-१०-७१", "content_sanskrit": "अपारतरपर्यन्तां तस्मै विद्यात्मने नमः ।\nयस्य भासा विभातीदमद्वयं तमसः परम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7005440071, "chapter_id": 25440, "verse_number": "१-१०-७२", "content_sanskrit": "प्रपद्ये तत् परं तत्त्वं तद्रूपं पारमेश्वरम् ।\nनित्यानन्दं निराधारं निष्कलं परमं शिवम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7005440072, "chapter_id": 25440, "verse_number": "१-१०-७३", "content_sanskrit": "प्रपद्ये परमात्मानं भवन्तं परमेश्वरम् ।\nएवं स्तुत्वा महादेवं ब्रह्मा तद्भावभावितः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7005440073, "chapter_id": 25440, "verse_number": "१-१०-७४", "content_sanskrit": "प्राञ्जलिः प्रणतस्तस्थौ गृणन् ब्रह्म सनातनम् ।\nततस्तस्मै महादेवो दिव्यं योगमनुत्तमम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7005440074, "chapter_id": 25440, "verse_number": "१-१०-७५", "content_sanskrit": "ऐश्वरं ब्रह्मसद्भावं वैराग्यं च ददौ हरः ।\nकराभ्यां कोमलाभ्यां च संस्पृश्य प्रणतार्तिहा ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7005440075, "chapter_id": 25440, "verse_number": "१-१०-७६", "content_sanskrit": "व्याजहरा स्वयं देवः सोऽनुगृह्य पितामहम् ।\nयत्त्वयाऽभ्यर्थितं ब्रह्मन् पुत्रत्वे भवता मम ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7005440076, "chapter_id": 25440, "verse_number": "१-१०-७७", "content_sanskrit": "कृतं मया तत्सकलं सृजस्व विविधं जगत् ।\nत्रिधा भिन्नोऽस्म्यहं ब्रह्मन् ब्रह्मविष्णुहराख्यया ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7005440077, "chapter_id": 25440, "verse_number": "१-१०-७८", "content_sanskrit": "सर्गरक्षालयगुणैर्निष्कलः परमेश्वरः ।\nस त्वं ममाग्रजः पुत्रः सृष्टिहेतोर्विनिर्मितः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7005440078, "chapter_id": 25440, "verse_number": "१-१०-७९", "content_sanskrit": "ममैव दक्षिणादङ्गाद् वामाङ्गात् पुरुषोत्तमः ।\nतस्य देवादिदेवस्य शंभोर्हृदयदेशतः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7005440079, "chapter_id": 25440, "verse_number": "१-१०-८०", "content_sanskrit": "संबभूवाथ रुद्रो वा सोहं तस्य परा तनुः ।\nब्रह्मविष्णुशिवा ब्रह्मन् सर्गस्थित्यन्तहेतवः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7005440080, "chapter_id": 25440, "verse_number": "१-१०-८१", "content_sanskrit": "विभज्यात्मानमेकोऽपि स्वेच्छया शंकरः स्थितः ।\nतथान्यानि च रूपाणि मम मायाकृतानि च ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7005440081, "chapter_id": 25440, "verse_number": "१-१०-८२", "content_sanskrit": "निरूपः केवलः स्वच्छो महादेवः स्वभावतः ।\nएभ्यः परतरो देवस्त्रिमूर्तिः परमा तनुः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7005440082, "chapter_id": 25440, "verse_number": "१-१०-८३", "content_sanskrit": "माहेश्वरी त्रिनयना योगिनां शान्तिदा सदा ।\nतस्या एव परां मूर्ति मामवेहि पितामह ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7005440083, "chapter_id": 25440, "verse_number": "१-१०-८४", "content_sanskrit": "शाश्वतैश्वर्यविज्ञानतेजोयोगसमन्विताम् ।\nसोऽहं ग्रसामि सकलमधिष्ठाय तमोगुणम् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7005440084, "chapter_id": 25440, "verse_number": "१-१०-८५", "content_sanskrit": "कालो भूत्वा न मनसा मामन्योऽभिभविष्यति ।\nयदा यदा हि मां नित्यं विचिन्तयसि पद्मज ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7005440085, "chapter_id": 25440, "verse_number": "१-१०-८६", "content_sanskrit": "तदा तदा मे सान्निध्यं भविष्यति तवानघ ।\nएतावदुक्त्वा ब्रह्माणं सोऽभिवन्द्य गुरुं हरः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7005440086, "chapter_id": 25440, "verse_number": "१-१०-८७", "content_sanskrit": "सहैव मानसैः पुत्रैः क्षणादन्तरधीयत ।\nसोऽपि योगं समास्थाय ससर्ज विविधं जगत् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7005440087, "chapter_id": 25440, "verse_number": "१-१०-८८", "content_sanskrit": "नारायणाख्यो भगवान् यथापूर्वं प्रिजापतिः ।\nमरीचिभृग्वङ्गिरसः पुलस्त्यं पुलहं क्रतुम् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7005440088, "chapter_id": 25440, "verse_number": "१-१०-८९", "content_sanskrit": "दक्षमत्रिं वसिष्ठं च सोऽसृजद् योगविद्यया ।\nनव ब्रह्माण इत्येते पुराणे निश्चयं गताः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7005440089, "chapter_id": 25440, "verse_number": "१-१०-९०", "content_sanskrit": "सर्वे ते ब्रह्मणा तुल्याः साधका ब्रह्मवादिनः ।\nसंकल्पंचैव धर्मंच युगधर्मांश्च शाश्वतान् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7005440090, "chapter_id": 25440, "verse_number": "१-१०-९१", "content_sanskrit": "स्थानाभिमानिनः सर्वान्यथा ते कथितं पुरा । ।\nइति श्रीकूर्मपुराणे षट्‌साहस्त्र्यां संहितायां पू॥१०॥॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}]