[{"id": 5000560000, "chapter_id": 9560, "verse_number": "७-२५-१", "content_sanskrit": "स तु दत्त्वा दशग्रीवो वनं घोरं स्वरस्य तत् ।\nभगिनीं च समाश्वास्य हृष्टः स्वस्थतरो ऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000560001, "chapter_id": 9560, "verse_number": "७-२५-२", "content_sanskrit": "ततो निकुम्भिला नाम लङ्कोपवनमुत्तमम् ।\nतद्राक्षसेन्द्रो बलवान्प्रविवेश सहानुगः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000560002, "chapter_id": 9560, "verse_number": "७-२५-३", "content_sanskrit": "ततो यूपशताकीर्णं सौम्यचैत्योपशोभितम् ।\nददर्श विष्ठितं यज्ञं श्रिया सम्प्रज्वलन्निव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000560003, "chapter_id": 9560, "verse_number": "७-२५-४", "content_sanskrit": "ततः कृष्णाजिनधरं कमण्डलुशिखाध्वजम् ।\nददर्श स्वसुतं तत्र मेघनादं भयावहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000560004, "chapter_id": 9560, "verse_number": "७-२५-५", "content_sanskrit": "तं समासाद्य लङ्केशः परिष्वज्वाथ बाहुभिः ।\nअब्रवीत्किमिदं वत्स वर्तसे ब्रूहि तत्त्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000560005, "chapter_id": 9560, "verse_number": "७-२५-६", "content_sanskrit": "उशना त्वब्रवीत्तत्र यज्ञसम्पत्समृद्धये ।\nरावणं राक्षसश्रेष्ठं द्विजश्रेष्ठो महातपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000560006, "chapter_id": 9560, "verse_number": "७-२५-७", "content_sanskrit": "अहमाख्यामि ते राजञ्छ्रूयतां सर्वमेव तत् ।\nयज्ञास्ते सप्त पुत्रेण प्राप्तास्सुबहुविस्तराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000560007, "chapter_id": 9560, "verse_number": "७-२५-८", "content_sanskrit": "अग्निष्टोमो ऽश्वमेधश्च यज्ञो बहुसुवर्णकः ।\nराजसूयस्तथा यज्ञो गोमेधो वैष्णवस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000560008, "chapter_id": 9560, "verse_number": "७-२५-९", "content_sanskrit": "माहेश्वरे प्रवृत्ते तु यज्ञे पुम्भिः सुदुर्लभे ।\nवरांस्ते लब्धवान्पुत्रः साक्षात्पशुपतेरिह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000560009, "chapter_id": 9560, "verse_number": "७-२५-१०", "content_sanskrit": "कामगं स्यन्दनं दिव्यमन्तरिक्षचरं ध्रुवम् ।\nमायां च तामसीं नाम यया सम्पद्यते तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000560010, "chapter_id": 9560, "verse_number": "७-२५-११", "content_sanskrit": "एतया किल सङ्ग्रामे मायया राक्षसेश्वर ।\nप्रयुक्तया गतिः शक्या नहि ज्ञातुं सुरासुरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000560011, "chapter_id": 9560, "verse_number": "७-२५-१२", "content_sanskrit": "अक्षयाविषुधी बाणैश्चापं चापि सुदुर्जयम् ।\nअस्त्रं च बलवद्राजञ्छत्रुविध्वंसनं रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000560012, "chapter_id": 9560, "verse_number": "७-२५-१३", "content_sanskrit": "एतान्सर्वान्वरांल्लब्ध्वा पुत्रस्ते ऽयं दशानन ।\nअद्य यज्ञसमाप्तौ च त्वां दिदृक्षुस्स्थितो ह्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000560013, "chapter_id": 9560, "verse_number": "७-२५-१४", "content_sanskrit": "ततो ऽब्रवीदृशग्रीवो न शोभनमिदं कृतम् ।\nपूजिताः शत्रवो यस्माद्द्रव्यैरिन्द्रपुरोगमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000560014, "chapter_id": 9560, "verse_number": "७-२५-१५", "content_sanskrit": "एहीदानीं कृतं विद्धि सुकृतं तन्न संशयः ।\nआगच्छ सौम्य गच्छामः स्वमेव भवनं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000560015, "chapter_id": 9560, "verse_number": "७-२५-१६", "content_sanskrit": "ततो गत्वा दशग्रीवः सपुत्रः सविभीषणः ।\nस्त्रियो ऽवतारयामास सर्वास्ता बाष्पगद्गदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000560016, "chapter_id": 9560, "verse_number": "७-२५-१७", "content_sanskrit": "लक्षिण्यो रत्नभूताश्च देवदानवरक्षसाम् ।\nतस्य तासु मतिं ज्ञात्वा धर्मत्मा वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000560017, "chapter_id": 9560, "verse_number": "७-२५-१८", "content_sanskrit": "ईदृशैस्त्वं समाचारैर्यशोर्थकुलनाशनैः ।\nधर्षणं ज्ञातिनां ज्ञात्वा स्वमतेन विचेष्टसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000560018, "chapter_id": 9560, "verse_number": "७-२५-१९", "content_sanskrit": "ज्ञातींस्तान्धर्षयित्वेमास्त्वया ऽ ऽनीता वराङ्गनाः ।\nत्वामतिक्रम्य मधुना राजन्कुम्भीनसी हृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000560019, "chapter_id": 9560, "verse_number": "७-२५-२०", "content_sanskrit": "रावणस्त्वब्रवीद्वाक्यं नावगच्छामि किं त्विदम् ।\nको ऽयं यस्तु त्वया ऽ ऽख्यातो मधुरित्येव नामतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000560020, "chapter_id": 9560, "verse_number": "७-२५-२१", "content_sanskrit": "विभीषणस्तु सङ्क्रुद्धो भ्रातरं वाक्यमब्रवीत् ।\nश्रूयतामस्य पापस्य कर्मणः फलमागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000560021, "chapter_id": 9560, "verse_number": "७-२५-२२", "content_sanskrit": "मातामहस्य यो भ्राता ज्येष्ठो भ्राता सुमालिनः ।\nमाल्यवानिति विख्यातो वृद्धः प्राज्ञो निशाचरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000560022, "chapter_id": 9560, "verse_number": "७-२५-२३", "content_sanskrit": "पिता ज्येष्ठो जनन्या नो ह्यस्माकं चार्यको ऽभवत् ।\nतस्य कुम्भीनसी नाम दुहितुर्दुहिता ऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000560023, "chapter_id": 9560, "verse_number": "७-२५-२४", "content_sanskrit": "मातृष्वसुरथास्माकं सा च कन्या ऽनलोद्भवा ।\nभवत्यस्माकमेवैषा भ्रातृणां धर्मतः स्वसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000560024, "chapter_id": 9560, "verse_number": "७-२५-२५", "content_sanskrit": "सा हृता, मधुना राजन्राक्षसेन बलीयसा ।\nयज्ञप्रवृत्ते पुत्रे तु मयि चान्तर्जलोषिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000560025, "chapter_id": 9560, "verse_number": "७-२५-२६", "content_sanskrit": "कुम्भकर्णे महाराज निद्रामनुभवत्यथ ।\nनिहत्य राक्षसश्रेष्ठानमात्यानिह सम्मतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000560026, "chapter_id": 9560, "verse_number": "७-२५-२७", "content_sanskrit": "धर्षयित्वा हृता सा तु सुप्ताप्यन्तःपुरे तव ।\nश्रुत्वा ऽपि तन्महाराज क्षान्तमेव हतो न सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000560027, "chapter_id": 9560, "verse_number": "७-२५-२८", "content_sanskrit": "यस्मादवश्यं दातव्या कन्या भर्त्रे हि भ्रातृभिः ।\nतदेतत्कर्मणो ह्यस्य फलं पापस्य दुर्मते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000560028, "chapter_id": 9560, "verse_number": "७-२५-२९", "content_sanskrit": "अस्मिन्नेवाभिसम्प्राप्तं लोके विदितमस्तु ते ।\nविभीषणवचः श्रुत्वा राक्षसेन्द्रः स रावणः ।\nदौरात्म्येनात्मनोद्धूतस्तप्ताम्भ इव सागरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000560029, "chapter_id": 9560, "verse_number": "७-२५-३०", "content_sanskrit": "ततो ऽब्रवीदृशग्रीवः क्रुद्धः संरक्तलोचनः ।\nकल्प्यतां मे रथः शीघ्रं शूराः सज्जीभवन्तु नः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000560030, "chapter_id": 9560, "verse_number": "७-२५-३१", "content_sanskrit": "भ्राता मे कुम्भकर्णश्च ये च मुख्या निशाचराः ।\nवाहनान्यधिरोहन्तु नानाप्रहरणायुधाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000560031, "chapter_id": 9560, "verse_number": "७-२५-३२", "content_sanskrit": "अद्य तं समरे हत्वा मधुं रावणनिर्भयम् ।\nसुरलोकं गमिष्यामि युद्धकाङ्क्षी सुहृद्वृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000560032, "chapter_id": 9560, "verse_number": "७-२५-३३", "content_sanskrit": "अक्षौहिणीसहस्राणि चत्वार्यग्र्याणि रक्षसाम् ।\nनानाप्रहरणान्याशु निर्ययुर्युद्धकाङ्क्षिणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000560033, "chapter_id": 9560, "verse_number": "७-२५-३४", "content_sanskrit": "इन्द्रजित्त्वग्रतः (अग्रतः) सैन्यात्सैनिकान्परिगृह्य च ।\nजगाम रावणो मध्ये कुम्भकर्णश्च पृष्ठतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000560034, "chapter_id": 9560, "verse_number": "७-२५-३५", "content_sanskrit": "विभीषणश्च धर्मात्मा लङ्कायां धर्मामाचरत् ।\nशोषाः सर्वे महाभागा ययुर्मधुपुरं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000560035, "chapter_id": 9560, "verse_number": "७-२५-३६", "content_sanskrit": "खरैरुष्ट्रैर्हयैर्दीप्तैः शिंशुमारैर्महोरगैः ।\nराक्षसाः प्रययुः सर्वे कृत्वा ऽ ऽकाशं निरन्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000560036, "chapter_id": 9560, "verse_number": "७-२५-३७", "content_sanskrit": "दैत्याश्च शतशस्तत्र कृतवैराश्च दैवतैः ।\nरावणं प्रेक्ष्य गच्छन्तमन्वगच्छन्हि पृष्ठतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000560037, "chapter_id": 9560, "verse_number": "७-२५-३८", "content_sanskrit": "स तु गत्वा मधुपुरं प्रविश्य च दशाननः ।\nन ददर्श मधुं तत्र भगिनीं तत्र दृष्टवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000560038, "chapter_id": 9560, "verse_number": "७-२५-३९", "content_sanskrit": "सा च प्रह्वाञ्जलिर्भूत्वा शिरसा चरणौ गता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000560039, "chapter_id": 9560, "verse_number": "७-२५-४०", "content_sanskrit": "तस्य राक्षसराजस्य त्रस्ता कुम्भीनसी तदा ।\nतां समुत्थापयामास न भेतव्यमिति ब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000560040, "chapter_id": 9560, "verse_number": "७-२५-४१", "content_sanskrit": "रावणो राक्षसश्रेष्ठः किं चापि करवाणि ते ।\nसाब्रवीद्यदि मे राजन्प्रसन्नस्त्वं महाभुज ।\nभर्तारं न ममेहाद्य हन्तुर्महसि मानद ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000560041, "chapter_id": 9560, "verse_number": "७-२५-४२", "content_sanskrit": "न हीदृशं भयं किञ्चित्कुलस्त्रीणामिहोच्यते ।\nभयानामपि सर्वेषां वैधव्यं व्यसनं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000560042, "chapter_id": 9560, "verse_number": "७-२५-४३", "content_sanskrit": "सत्यवाग्भव राजेन्द्र मामवेक्षस्व याचतीम् ।\nत्वयाप्युक्तं महाराज न भेतव्यमिति स्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000560043, "chapter_id": 9560, "verse_number": "७-२५-४४", "content_sanskrit": "रावणस्त्वब्रवीद्धृष्टः स्वसारं तत्र संस्थिताम् ।\nक्व चासौ तव भर्ता वै मम शीघ्रं निवेद्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000560044, "chapter_id": 9560, "verse_number": "७-२५-४५", "content_sanskrit": "सह तेन गमिष्यामि सुरलोकं जयावहे ।\nतव कारुण्यसौहार्दान्निवृत्तो ऽस्मि मधोर्वधात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000560045, "chapter_id": 9560, "verse_number": "७-२५-४६", "content_sanskrit": "इत्युक्ता सा समुत्थाप्य प्रसुप्तं तं निशाचरम् ।\nअब्रवीत्सम्प्रहृष्टेव राक्षसी सा पतिं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000560046, "chapter_id": 9560, "verse_number": "७-२५-४७", "content_sanskrit": "एष प्राप्तो दशग्रीवो मम भ्राता महाबलः ।\nसुरलोकजयाकाङ्क्षी साहाय्ये त्वां वृणोति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000560047, "chapter_id": 9560, "verse_number": "७-२५-४८", "content_sanskrit": "तदस्य त्वं सहायार्थं सबन्धुर्गच्छ राक्षस ।\nस्निग्धस्य भजमानस्य युक्तमर्थाय कल्पितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000560048, "chapter_id": 9560, "verse_number": "७-२५-४९", "content_sanskrit": "तस्यास्तद्वचनं श्रुत्वा तथेत्याह मधुर्वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000560049, "chapter_id": 9560, "verse_number": "७-२५-५०", "content_sanskrit": "ददर्श राक्षसश्रेष्ठं यथान्यायमुपेत्य सः ।\nपूजयमास धर्मेण रावणं राक्षसाधिपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000560050, "chapter_id": 9560, "verse_number": "७-२५-५१", "content_sanskrit": "प्राप्य पूजां दशग्रीवो मधुवेश्मानि वीर्यवान् ।\nतत्र चैकां निशामुष्य गमनायोपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000560051, "chapter_id": 9560, "verse_number": "७-२५-५२", "content_sanskrit": "ततः कैलासमासाद्य शैलं वैश्रवणालयम् ।\nराक्षसेन्द्रो महेन्द्राभः सेनामुपनिवेशयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000560052, "chapter_id": 9560, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे पञ्चविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]