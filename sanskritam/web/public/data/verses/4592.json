[{"id": 2167280, "chapter_id": 4592, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2167281, "chapter_id": 4592, "verse_number": "१", "content_sanskrit": "ते सेनेऽन्योन्यमासाद्य प्रहृष्टाश्वनरद्विपे ।\nबृहत्यौ सम्प्रजह्राते देवासुरचमूसमे\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2167282, "chapter_id": 4592, "verse_number": "२", "content_sanskrit": "ततो वररथाश्वेभाः पत्तयश्च महाहवे ।\nसम्प्रहारं महच्चक्रुर्देहपाप्मविनाशनम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2167283, "chapter_id": 4592, "verse_number": "३", "content_sanskrit": "पूर्णचन्द्रार्कपद्मानां कान्तित्विड्गन्धतः समैः ।\nउत्तमाङ्गैर्नृसिंहानाम् आवृता पतितैर्मही\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2167284, "chapter_id": 4592, "verse_number": "४", "content_sanskrit": "अर्धचन्द्रैस्तथा भल्लैः क्षुरप्रैरसिपट्टसैः ।\nपरश्वधैस्त्वपाकृन्तन्नुत्तमाङ्गानि युध्यताम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2167285, "chapter_id": 4592, "verse_number": "५", "content_sanskrit": "व्यायतायतबाहूनां व्यायतायतबाहुभिः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2167286, "chapter_id": 4592, "verse_number": "६", "content_sanskrit": "बाहवः पतिता रेजुः साङ्गदा रुधिरोक्षिताः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2167287, "chapter_id": 4592, "verse_number": "७", "content_sanskrit": "तैः स्फुरद्भिर्मही भाति रक्ताङ्गुलितलैस्तथा ।\nगरुडप्रहारतो रुग्णैः पञ्चास्यैरिव पन्नगैः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2167288, "chapter_id": 4592, "verse_number": "८", "content_sanskrit": "द्विरदस्यन्दनाश्वेभ्यः पेतुर्वीरा द्विषद्धताः ।\nविमानेभ्यो यथा पुण्ये क्षीणे स्वर्गसदस्तथा\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2167289, "chapter_id": 4592, "verse_number": "९", "content_sanskrit": "गदाभिरन्ये गुर्वीभिर्यष्टिभिर्मुसलैरपि\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2167290, "chapter_id": 4592, "verse_number": "१०", "content_sanskrit": "पोथिताः शतधा पेतुर्वीरा वरशितैः शरैः ।\nरथा रथैर्विनिहताः पातिताश्च द्विपैर्द्विपाः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2167291, "chapter_id": 4592, "verse_number": "११", "content_sanskrit": "सादिभिः सादिनश्चैव तस्मिन् परमसङ्कुले\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2167292, "chapter_id": 4592, "verse_number": "१२", "content_sanskrit": "रथैर्नरा रथा नागैरश्वारोहाश्च पत्तिभिः ।\nअश्वारोहैः पदाताश्च निहता युधि शेरते\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2167293, "chapter_id": 4592, "verse_number": "१३", "content_sanskrit": "रथाश्वपत्तयो नागैरश्वैर्नागैश्च पत्तयः ।\nरथपत्तिद्विपाश्चाश्वैर्नृभिश्चाश्वरथद्विपाः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2167294, "chapter_id": 4592, "verse_number": "१४", "content_sanskrit": "रथाश्वेभनराणां तु रथाश्वेभनरैः कृतम् ।\nपाणिपादैश्च शस्त्रैश्च रथैश्च कदनं महत्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2167295, "chapter_id": 4592, "verse_number": "१५", "content_sanskrit": "तथा तस्मिन् बले शूरैर्वध्यमाने हतेऽपि च ।\nअस्मानभ्याययुः पार्था वृकोदरपुरोगमाः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2167296, "chapter_id": 4592, "verse_number": "१६", "content_sanskrit": "धृष्टद्युम्नः शिखण्डी च द्रौपदेयाः प्रभद्रकाः ।\nसात्यकिश्चेकितानश्च द्रमिळैः सैनिकैः सह\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2167297, "chapter_id": 4592, "verse_number": "१७", "content_sanskrit": "भृता व्यूहेन महता पाण्ड्याश्चोलाः सकेरलाः ।\nव्यूढोरस्का दीर्घभुजाः प्रांशवः पृथुलोचनाः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2167298, "chapter_id": 4592, "verse_number": "१८", "content_sanskrit": "आपीडिनो रक्तदन्ता मत्तमातङ्गविक्रमाः ।\nनानाविरागवसना गन्धचूर्णावचूर्णिताः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2167299, "chapter_id": 4592, "verse_number": "१९", "content_sanskrit": "बद्धासयः पाशहस्ताः वारणप्रतिवारणाः ।\nसमानमृत्यवो राजन् प्रसक्ताश्च परस्परम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2167300, "chapter_id": 4592, "verse_number": "२०", "content_sanskrit": "कलापिनश्चापहस्ता दीर्घकेशाः प्रियंवदाः ।\nपत्तयः सायकैर्विद्धा घोररूपा भयावहाः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2167301, "chapter_id": 4592, "verse_number": "२१", "content_sanskrit": "अथापरे पुनः शूराश्चेदिपाञ्चालकेकयाः ।\nकारूशाः कोसला वङ्गा मागधाश्चापि दुद्रुवुः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2167302, "chapter_id": 4592, "verse_number": "२२", "content_sanskrit": "तेषां रथाश्च नागाश्च प्रवराश्चापि पत्तयः ।\nनानावाद्यधरैर्हृष्टा नृत्यन्ति च हसन्ति च\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2167303, "chapter_id": 4592, "verse_number": "२३", "content_sanskrit": "तस्य सैन्यस्य महतो महामात्रशतैर्वृतः ।\nमध्ये वृकोदरोऽभ्यायान्नागप्रवरधूर्गतः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2167304, "chapter_id": 4592, "verse_number": "२४", "content_sanskrit": "स नागप्रवरो ह्युग्रो विधिवत् कल्पितो बभौ ।\nउदयाग्राद्रिभवनं यथाऽभ्युदितभास्करम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2167305, "chapter_id": 4592, "verse_number": "२५", "content_sanskrit": "तस्यायसं वर्मवरं वररत्नविभूषितम् ।\nतारोद्भासस्य नभसः शारदस्य समं त्विषा\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2167306, "chapter_id": 4592, "verse_number": "२६", "content_sanskrit": "स तोमरप्रासकरः चारुमौळिः स्वलङ्कृतः ।\nशरन्मध्यन्दिनार्काभस्तेजसा प्रादहद् रिपून्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2167307, "chapter_id": 4592, "verse_number": "२७", "content_sanskrit": "तं दृष्ट्वा द्विरदं दूरात् क्षेमधूर्तिः स्थितो द्विपे ।\nआह्वयानोऽभिदुद्राव प्रहसन् पृतनामुखे\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2167308, "chapter_id": 4592, "verse_number": "२८", "content_sanskrit": "तयोः समभवद् युद्धं द्विपयोरुग्ररूपयोः ।\nयदृच्छया द्रुमवतोर्महापर्वतयोरिव\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2167309, "chapter_id": 4592, "verse_number": "२९", "content_sanskrit": "संसक्तनागौ तौ वीरौ तोमरैरितरेतरम् ।\nबलवत् सूर्यरश्म्याभैर्भित्त्वा भित्त्वा विनेदतुः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2167310, "chapter_id": 4592, "verse_number": "३०", "content_sanskrit": "व्यतिसृत्य च नागाभ्यां मण्डलानि विचेरतुः ।\nप्रगृह्य चोभौ धनुषी जघ्नतुर्वै परस्परम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2167311, "chapter_id": 4592, "verse_number": "३१", "content_sanskrit": "क्ष्वेळितास्फोटितरवैः बाणशब्दैश्च सर्वशः ।\nतौ जनान् हर्षयन्तौ च सिंहनादं प्रचक्रतुः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2167312, "chapter_id": 4592, "verse_number": "३२", "content_sanskrit": "समुद्यतकराभ्यां तौ द्विपाभ्यां कृतिनावुभौ ।\nवातोद्धूतपताकाभ्यां युयुधाते महाबलौ\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2167313, "chapter_id": 4592, "verse_number": "३३", "content_sanskrit": "तावन्योन्यस्य धनुषी पुनश्छित्वा विनेदतुः ।\nशक्तितोमरवर्षेण प्रावृण्मेघाविवाम्बुभिः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2167314, "chapter_id": 4592, "verse_number": "३४", "content_sanskrit": "क्षेमधूर्तिस्तदा भीमं तोमरेण स्तनान्तरे ।\nनिर्बिभेदाशु वेगेन षड्भिश्चाप्यपरैर्नदन्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2167315, "chapter_id": 4592, "verse_number": "३५", "content_sanskrit": "स भीमसेनः शुशुभे तोमरैरङ्गसंश्रितैः ।\nक्रोधदीप्तवपुर्मेघैः सप्तसप्तिरिवांशुमान्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2167316, "chapter_id": 4592, "verse_number": "३६", "content_sanskrit": "ततो भास्कररश्म्याभमञ्जोगतिमयस्मयम् ।\nससर्ज तोमरं भीमः प्रत्यमित्राय यत्नवान्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2167317, "chapter_id": 4592, "verse_number": "३७", "content_sanskrit": "ततः कुलूताधिपतिश्चापमायम्य सायकैः ।\nदशभिस्तोमरं भित्त्वा षष्ठ्या विव्याध पाण्डवम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2167318, "chapter_id": 4592, "verse_number": "३८", "content_sanskrit": "अथ कार्मुकमादाय महाजलदनिःस्वनम् ।\nरिपोरभ्यर्दयन्नागमुन्नदन् पाण्डवः शरैः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2167319, "chapter_id": 4592, "verse_number": "३९", "content_sanskrit": "स शराभ्यर्दितो नागो भीमसेनेन संयुगे ।\nनिगृह्यमाणो नातिष्ठद् वातध्वस्त इवाम्बुदः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2167320, "chapter_id": 4592, "verse_number": "४०", "content_sanskrit": "तमभ्यधावद् द्विरदं भीमसेनस्य नागराट् ।\nमहावातेरितं मेघं वातोद्धूत इवाम्बुदः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2167321, "chapter_id": 4592, "verse_number": "४१", "content_sanskrit": "स निवर्त्यात्मनो नागं क्षेमधूर्तिः प्रयत्नतः ।\nविव्याधाभिद्रुतं बाणैर्भीमसेनं सकुञ्जरम्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2167322, "chapter_id": 4592, "verse_number": "४२", "content_sanskrit": "ततः साधुविसृष्टेन क्षुरेणानतपर्वणा ।\nछित्त्वा शरासनं शत्रोर्नागं चापि प्रमार्दयत्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2167323, "chapter_id": 4592, "verse_number": "४३", "content_sanskrit": "ततः क्रुद्धो रणे भीमं क्षेमधूर्तिः पराभिनत् ।\nजघान तस्य द्विरदं नाराचैः सर्वमर्मसु\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2167324, "chapter_id": 4592, "verse_number": "४४", "content_sanskrit": "ततः पपात नागेन्द्रो भीमसेनस्य मारिष ।\nपुरा नागस्य पतनात् सोऽवप्लुत्य स्थितो महीम्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2167325, "chapter_id": 4592, "verse_number": "४५", "content_sanskrit": "भीमसेनोऽपि तन्नागं गदया समपोथयत् ।\nतस्मात् प्रमथितान्नागात् क्षेमधूर्तिरवप्लुतः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2167326, "chapter_id": 4592, "verse_number": "४६", "content_sanskrit": "(उद्धृत्य खड्गं निशितमभ्यधावत् स पाण्डवम् ।)\nउद्यतासिमुपायान्तं गदयाऽहन् वृकोदरः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2167327, "chapter_id": 4592, "verse_number": "४७", "content_sanskrit": "स पपात हतः सासिर्व्यसुस्तमभितो द्विपम् ।\nवज्रप्ररुग्णमचलं सिंहो वज्रहतो यथा\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2167328, "chapter_id": 4592, "verse_number": "४८", "content_sanskrit": "तं हतं नृपतिं दृष्ट्वा करूशानां यशस्करम् ।\nप्राद्रवद् व्यथिता सेना त्वदीया भरतर्षभ\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2167329, "chapter_id": 4592, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां कर्णपर्वणि\nक्षेमधूर्तिपतनं नाम द्वादशोऽध्यायः ॥१२॥\n* * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]