[{"id": 2077417, "chapter_id": 2638, "verse_number": "१२-१४३-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2077418, "chapter_id": 2638, "verse_number": "१२-१४३-१", "content_sanskrit": "पितामह महाप्राज्ञ सर्वशास्त्रविशारद।\nशरणागतं पालयतो यो धर्मस्तं ब्रवीहि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2077419, "chapter_id": 2638, "verse_number": "१२-१४३-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2077420, "chapter_id": 2638, "verse_number": "१२-१४३-२", "content_sanskrit": "महान्धर्मो महाराज शरणागतपालने।\nअर्हः प्रष्टुं भवांश्चैनं प्रश्नं भरतसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2077421, "chapter_id": 2638, "verse_number": "१२-१४३-३", "content_sanskrit": "शिबिप्रभृतयो राजन्राजानः शरणं गतान्।\nपरिपाल्य महात्मानः संसिद्धिं परमां गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2077422, "chapter_id": 2638, "verse_number": "१२-१४३-४", "content_sanskrit": "श्रूयते च कपोतेन शत्रुः शरणमागतः।\nपूजितश्च यथान्यायं स्वैश्च मांसैर्निमन्त्रितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2077423, "chapter_id": 2638, "verse_number": "१२-१४३-५x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2077424, "chapter_id": 2638, "verse_number": "१२-१४३-५", "content_sanskrit": "कथं कपोतेन पुरा शत्रुः शरणमागतः।\nस्वमांसं भोजितः कां च गतिं लेभे स भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2077425, "chapter_id": 2638, "verse_number": "१२-१४३-६x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2077426, "chapter_id": 2638, "verse_number": "१२-१४३-६", "content_sanskrit": "शृणु राजन्कथां दिव्यां सर्वपापप्रणाशिनीम्।\nनृपतेर्मुचुकुन्दस्य कथितां भार्गवेण वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2077427, "chapter_id": 2638, "verse_number": "१२-१४३-७", "content_sanskrit": "इममर्थं पुरा पार्थ मुचुकुन्दो नराधिपः।\nभार्गवं परिपप्रच्छ प्रणतः पुरुषर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2077428, "chapter_id": 2638, "verse_number": "१२-१४३-८", "content_sanskrit": "तस्मै शुश्रूषमाणाय भार्गवोऽकथयत्कथाम्।\nइमां यथा कपोतेन सिद्धिः प्राप्ता नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2077429, "chapter_id": 2638, "verse_number": "१२-१४३-९x", "content_sanskrit": "उशनोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2077430, "chapter_id": 2638, "verse_number": "१२-१४३-९", "content_sanskrit": "धर्मिश्चयसंयुक्तां कामार्थसहितां कथाम्।\nशृणुष्वावहितो राजन्गदतो मे महाभुजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2077431, "chapter_id": 2638, "verse_number": "१२-१४३-१०", "content_sanskrit": "कश्चित्क्षुद्रसमाचारः पृथिव्यां कालसंमितः।\nचचार पृथिवीपाल घोरः शकुनिलुब्धकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2077432, "chapter_id": 2638, "verse_number": "१२-१४३-११", "content_sanskrit": "काकोल इव कृष्णाङ्गो रूक्षः पापसमाहितः।\nयवमध्यः कृशग्रीवो ह्रस्वपादो महाहनुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2077433, "chapter_id": 2638, "verse_number": "१२-१४३-१२", "content_sanskrit": "नैव तस्य सुहृत्कश्चिन्न संबन्धी न बान्धवाः।\nबान्धवैः संपरित्यक्तस्तेन रौद्रेण कर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2077434, "chapter_id": 2638, "verse_number": "१२-१४३-१३", "content_sanskrit": "नरः पापसमाचारस्त्यक्तव्यो दूरतो बुधैः।\nआत्मानं यो न संधत्ते सोन्यस्य स्यात्कथं हितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2077435, "chapter_id": 2638, "verse_number": "१२-१४३-१४", "content_sanskrit": "ये नृशंसा दुरात्मानः प्राणिप्राणहरा नराः।\nउद्वेजनीया भूतानां व्याला इव भवन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2077436, "chapter_id": 2638, "verse_number": "१२-१४३-१५", "content_sanskrit": "स वै क्षारकमादाय वने हत्वा च पक्षिणः।\nचकार विक्रयं तेषां पतङ्गानां जनाधिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2077437, "chapter_id": 2638, "verse_number": "१२-१४३-१६", "content_sanskrit": "एवं तु वर्तमानस्य तस्य वृत्तिं दुरात्मनः।\nअगमत्सुमहान्कालो न चाधर्ममबुध्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2077438, "chapter_id": 2638, "verse_number": "१२-१४३-१७", "content_sanskrit": "तस्य भार्यासहायस्य रममाणस्य शाश्वतम्।\nदैवयोगविमूढस्य नान्या वृत्तिररोचत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2077439, "chapter_id": 2638, "verse_number": "१२-१४३-१८", "content_sanskrit": "ततः कदाचित्तस्याथ वनस्थस्य समन्ततः।\nपातयन्निव वृक्षांस्तान्सुमहान्वातसंभ्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2077440, "chapter_id": 2638, "verse_number": "१२-१४३-१९", "content_sanskrit": "मेघसंकुलमाकाशं विद्युन्मण्डलमण्डितम्।\nसंछन्नस्तु मुहूर्तेन नौसार्थैरिव सागरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2077441, "chapter_id": 2638, "verse_number": "१२-१४३-२०", "content_sanskrit": "वारिधारासमूहेन संप्रहृष्टः शतक्रतुः।\nक्षणेन पूरयामास सलिलेन वसुंधराम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2077442, "chapter_id": 2638, "verse_number": "१२-१४३-२१", "content_sanskrit": "ततो धाराकुले लोके संभ्रमन्नष्टचेतनः।\nशीतार्तस्तद्वनं सर्वमाकुलेनान्तरात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2077443, "chapter_id": 2638, "verse_number": "१२-१४३-२२", "content_sanskrit": "नैव निम्नं स्थलं वाऽपि सोऽविन्दत विहंगहा।\nपूरितो हि जलौघेनन तस्य मार्गो वनस्य तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2077444, "chapter_id": 2638, "verse_number": "१२-१४३-२३", "content_sanskrit": "पक्षिणं वर्षवेगेन हता लीनास्तु पादपात्।\nमृगसिहवराहाश्च ये चान्ये तत्र पक्षिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2077445, "chapter_id": 2638, "verse_number": "१२-१४३-२४", "content_sanskrit": "महता वातवर्षेण त्रासितास्ते वनौकसः।\nभयार्ताश्च क्षुधार्ताश्च बभ्रमुः सहिता वने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2077446, "chapter_id": 2638, "verse_number": "१२-१४३-२५", "content_sanskrit": "स तु शीतहतैर्गात्रैर्जगामैव न तस्थिवान्।\nददर्श पतितां भूमौ कपोतीं शीतविह्वलाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2077447, "chapter_id": 2638, "verse_number": "१२-१४३-२६", "content_sanskrit": "दृष्टवाऽऽर्तोपि हि पापात्मा स तां पञ्जरकेऽक्षिपत्।\nस्वयं दुःखाभिभूतोऽपि दुःखमेवाकरोत्परे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2077448, "chapter_id": 2638, "verse_number": "१२-१४३-२७", "content_sanskrit": "पापात्मा पापकारित्वत्पापमेव चकार सः।\nसोऽपश्यत्तरुषण्डेषु मेघनीलं वनस्पतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2077449, "chapter_id": 2638, "verse_number": "१२-१४३-२८", "content_sanskrit": "सेव्यमानं विहंगौघैश्छायावासफलार्थिभिः।\nधात्रा परोपकाराय स साधुरिव निर्मितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2077450, "chapter_id": 2638, "verse_number": "१२-१४३-२९", "content_sanskrit": "अथाभवत्क्षणेनैव वियद्विमलतारकम्।\nमहत्सर इवोत्फुल्लं कुमुदच्छुरितोदकम्।\nकुसुमाकारताराढ्यमाकाशं निर्मलं बहु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2077451, "chapter_id": 2638, "verse_number": "१२-१४३-३०", "content_sanskrit": "घनैर्मुक्तं नभो दृष्ट्वा लुब्धकः शीतविह्वलः।\nदिशो विलोकयामास वेलां च सुदुरात्मवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2077452, "chapter_id": 2638, "verse_number": "१२-१४३-३१", "content_sanskrit": "दूरे ग्रामनिवेशश्च तस्मात्स्थानादिति प्रभो।\nकृतबुद्धिर्द्रुमे तस्मिन्वस्तुं तां रजनीं ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2077453, "chapter_id": 2638, "verse_number": "१२-१४३-३२", "content_sanskrit": "साञ्जलिः प्रणतिं कृत्वा वाक्यमाह वनस्पतिम्।\nशरणं यामि यान्यस्मिन्दैवतानीति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2077454, "chapter_id": 2638, "verse_number": "१२-१४३-३३", "content_sanskrit": "स शिलायां शिरः कृत्वा पर्णान्यास्तीर्य भूतले।\nदुःखेन महताऽऽविष्टस्ततः सुष्वाप पक्षिहा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2077455, "chapter_id": 2638, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि आपद्धर्मपर्वणि त्रिचत्वारिंशदधिकशततमोऽध्यायः॥ १४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]