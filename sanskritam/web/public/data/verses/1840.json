[{"id": 2038472, "chapter_id": 1840, "verse_number": "५-८५-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2038473, "chapter_id": 1840, "verse_number": "५-८५-१", "content_sanskrit": "तदा दूतैः समाज्ञाय आयान्तं मधुसूदनम्।\nधृतराष्ट्रोऽब्रवीद्भीष्ममर्चयित्वा महाभुजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2038474, "chapter_id": 1840, "verse_number": "५-८५-२", "content_sanskrit": "द्रोणं च सञ्जयं चैव विदुरं च महामतिम् ।\nदुर्योदनं सहामात्यं हृष्टरोमाऽब्रवीदिदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2038475, "chapter_id": 1840, "verse_number": "५-८५-३", "content_sanskrit": "अद्भुतं महादाश्चर्यं श्रूयते कुरुनन्दन ।\nस्त्रियो बालाश्च वृद्धाश्च कथयन्ति गृहेगृहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2038476, "chapter_id": 1840, "verse_number": "५-८५-४", "content_sanskrit": "सत्कृत्याचक्षते चान्ये तथैवान्ये समागताः ।\nपृथग्वादाश्च वर्तन्ते चत्वरेषु सभासु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2038477, "chapter_id": 1840, "verse_number": "५-८५-५", "content_sanskrit": "उपायास्यति दाशार्हः पाण्डवार्थे पराक्रमी ।\nस नो मान्यश्च पूज्यश्च सर्वथा मधुसूदनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2038478, "chapter_id": 1840, "verse_number": "५-८५-६", "content_sanskrit": "तस्मिन्हि यात्रा लोकस्य भूतानामीश्वरोऽहि सः।\nतस्मिन्धृतिश्च वीर्यं च प्रज्ञा चौजश्च माधवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2038479, "chapter_id": 1840, "verse_number": "५-८५-७", "content_sanskrit": "स मान्यतां नरश्रेष्ठः स हि धर्मः सनातनः ।\nपूजितो हि सुखाय स्यादसुखः स्यादपूजितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2038480, "chapter_id": 1840, "verse_number": "५-८५-८", "content_sanskrit": "स चेत्तुप्यति दाशार्ह उपचरैररिन्दमः ।\nकृष्णात्सर्वानभिप्रायान्प्राप्स्यामः सर्वराजसु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2038481, "chapter_id": 1840, "verse_number": "५-८५-९", "content_sanskrit": "तस्य पूजार्थमद्यैव संविधस्त्व परन्तप ।\nसभाः पथि विधीयन्तां सर्वकामसमन्विताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2038482, "chapter_id": 1840, "verse_number": "५-८५-१०", "content_sanskrit": "यथा प्रीतिर्महाबाहो त्वयि जायेत तस्य वै ।\nतथा कुरुष्व गान्धारे कथं वा भीष्म मन्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2038483, "chapter_id": 1840, "verse_number": "५-८५-११x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2038484, "chapter_id": 1840, "verse_number": "५-८५-११", "content_sanskrit": "ततो भीष्मादयः सर्वे धृतराष्ट्रं जनाधिपम्।\nऊचुःक परममित्येवं पूजयन्तोऽस्य तद्वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2038485, "chapter_id": 1840, "verse_number": "५-८५-१२", "content_sanskrit": "तेषामनुमतं ज्ञात्वा राजा दुर्योधनस्तदा।\nसभावास्तूनि रम्याणि प्रदेष्टुमुपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2038486, "chapter_id": 1840, "verse_number": "५-८५-१३", "content_sanskrit": "ततो देशेषु देशेषु रमणीयेषु भागशः ।\nसर्वरत्नसमाकीर्णाः सभाश्चक्रुरनेकशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2038487, "chapter_id": 1840, "verse_number": "५-८५-१४", "content_sanskrit": "आसनानि विचित्राणि युतानि विविधैर्गुणैः ।\nस्त्रियो गन्धानलङ्कानारान्सूक्ष्माणि वसनानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2038488, "chapter_id": 1840, "verse_number": "५-८५-१५", "content_sanskrit": "गुणवन्त्यन्नपानानि भोज्यानि विविधानि च।\nमाल्यानि च सुगन्धीनि तानि राजा ददौ ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2038489, "chapter_id": 1840, "verse_number": "५-८५-१६", "content_sanskrit": "विशेवतश्च वासार्थं सभां ग्रामे वृकस्थले।\nविदधे कौरवो राजा बहुरत्नां मनोरमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2038490, "chapter_id": 1840, "verse_number": "५-८५-१७", "content_sanskrit": "एतद्विधाय वै सर्वं देवार्हमतिमानुषम् ।\nआचख्यौ धृतराष्ट्राय राजा दुर्योधनस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2038491, "chapter_id": 1840, "verse_number": "५-८५-१८", "content_sanskrit": "ताः सभाः केशवः सर्वा रत्नानि विविधानि च।\nअसमीक्ष्यैव दाशार्ह उपायात्कुरुसद्म तत् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2038492, "chapter_id": 1840, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि पञ्चशीतितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]