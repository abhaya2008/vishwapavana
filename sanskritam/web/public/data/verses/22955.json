[{"id": 7002955000, "chapter_id": 22955, "verse_number": "२-२-१", "content_sanskrit": "नारद उवाच ।\nसमासेन श्रुतं सर्वं देवीनां चरितं विभो ।\nविबोधनार्थं बोधस्य व्यासतो वक्तुमर्हसि ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002955001, "chapter_id": 22955, "verse_number": "२-२-२", "content_sanskrit": "सृष्टेराद्या सृष्टिविधौ कथमाविर्बभूव ह ।\nकथं वा पञ्चधा भूता वद वेदविदां वर ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002955002, "chapter_id": 22955, "verse_number": "२-२-३", "content_sanskrit": "भूता या याश्च कलया तया त्रिगुणया भवे ।\nव्यासेन तासां चरितं श्रोतुमिच्छामि साम्प्रतम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002955003, "chapter_id": 22955, "verse_number": "२-२-४", "content_sanskrit": "तासां जन्मानुकथनं ध्यानं पूजाविधिं परम् ।\nस्तोत्रं कवचमैश्वर्य्यं शौर्यं वर्णय मङ्गलम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002955004, "chapter_id": 22955, "verse_number": "२-२-५", "content_sanskrit": "श्रीनारायण उवाच ।\nनित्यात्मा च नभो नित्यं कालो नित्यो दिशो यथा ।\nविश्वेषां गोकुलं नित्यं नित्यो गोलोक एव च ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002955005, "chapter_id": 22955, "verse_number": "२-२-६", "content_sanskrit": "तदेकदेशो वैकुण्ठो लम्बभागः स नित्यकः ।\nतथैव प्रकृतिर्नित्या ब्रह्मलीना सनातनी ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002955006, "chapter_id": 22955, "verse_number": "२-२-७", "content_sanskrit": "यथाऽग्नौ दाहिका चन्द्रे पद्मे शोभा प्रभा रवौ ।\nशश्वद्युक्ता न भिन्ना सा तथा प्रकृतिरात्मनि ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002955007, "chapter_id": 22955, "verse_number": "२-२-८", "content_sanskrit": "विना स्वर्णं स्वर्णकारः कुण्डलं कर्तुमक्षमः ।\nविना मृदा कुलालो हि घटं कर्तुं न हीश्वरः॥ ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002955008, "chapter_id": 22955, "verse_number": "२-२-९", "content_sanskrit": "नहि क्षमस्तथा ब्रह्मा सृष्टिं स्रष्टुं तया विना ।\nसर्वशक्तिस्वरूपा सा तया स्याच्छक्तिमान्सदा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002955009, "chapter_id": 22955, "verse_number": "२-२-१०", "content_sanskrit": "ऐश्वर्य्यवचनः शक् च तिः पराक्रमवाचकः ।\nतत्स्वरूपा तयोर्दात्री या सा शक्तिः प्रकीर्तिता ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002955010, "chapter_id": 22955, "verse_number": "२-२-११", "content_sanskrit": "समृद्धिबुद्धिसम्पत्तियशसां वचनो भगः ।\nतेन शक्तिर्भगवती भगरूपा च सा सदा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002955011, "chapter_id": 22955, "verse_number": "२-२-१२", "content_sanskrit": "तया युक्तः सदाऽऽत्मा च भगवांस्तेन कथ्यते ।\nस च स्वेच्छामयः कृष्णः साकारश्च निराकृतिः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002955012, "chapter_id": 22955, "verse_number": "२-२-१३", "content_sanskrit": "तेजोरूपं निराकारं ध्यायन्ते योगिनः सदा ।\nवदन्ति ते परं ब्रह्म परमात्मानमीश्वरम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002955013, "chapter_id": 22955, "verse_number": "२-२-१४", "content_sanskrit": "अदृश्यं सर्व द्रष्टारं सर्वज्ञं सर्वकारणम् ।\nसर्वदं सर्वरूपान्तमरूपं सर्वपोषकम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002955014, "chapter_id": 22955, "verse_number": "२-२-१५", "content_sanskrit": "वैष्णवास्ते न मन्यन्ते तद्भक्ताः सूक्ष्मदर्शिनः ।\nवदन्ति कस्य तेजस्ते इति तेजस्विनं विना ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002955015, "chapter_id": 22955, "verse_number": "२-२-१६", "content_sanskrit": "तेजोमण्डलमध्यस्थं ब्रह्म तेजस्विनं परम् ।\nस्वेच्छामयं सर्वरूपं सर्वकारणकारणम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002955016, "chapter_id": 22955, "verse_number": "२-२-१७", "content_sanskrit": "अतीवसुन्दरं रूपं बिभ्रतं सुमनोहरम् ।\nकिशोरवयसं शान्तं सर्वकान्तं परात्परम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002955017, "chapter_id": 22955, "verse_number": "२-२-१८", "content_sanskrit": "नवीननीरदाभासं रासैकश्यामसुन्दरम् ।\nशरन्मध्याह्नपद्मौघशोभामोचकलोचनम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002955018, "chapter_id": 22955, "verse_number": "२-२-१९", "content_sanskrit": "मुक्तासारमहास्वच्छदन्तपङ्क्तिमनोहरम् ।\nमयूरपुच्छचूडं च मालतीमाल्यमण्डितम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002955019, "chapter_id": 22955, "verse_number": "२-२-२०", "content_sanskrit": "सुनासं सस्मितं शश्वद्भक्तानुग्रहकारकम् ।\nज्वलदग्निविशुद्धैकपीतांशुकसुशोभितम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002955020, "chapter_id": 22955, "verse_number": "२-२-२१", "content_sanskrit": "द्विभुजं मुरलीहस्तं रत्नभूषणभूषितम् ।\nसर्वाधारं च सर्वेशं सर्वशक्तियुतं विभुम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002955021, "chapter_id": 22955, "verse_number": "२-२-२२", "content_sanskrit": "सर्वैश्वर्य्यप्रदं सर्वं स्वतन्त्रं सर्वमङ्गलम् ।\nपरिपूर्णतमं सिद्धं सिद्धि दं सिद्धिकारणम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002955022, "chapter_id": 22955, "verse_number": "२-२-२३", "content_sanskrit": "ध्यायन्ते वैष्णवाः शश्वदेवंरूपं सनातनम् ।\nजन्ममृत्युजराव्याधिशोकभीतिहरं परम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002955023, "chapter_id": 22955, "verse_number": "२-२-२४", "content_sanskrit": "ब्रह्मणो वयसा यस्य निमेष उपचार्य्यते ।\nस चात्मा परमं ब्रह्म कृष्ण इत्यभिधीयते ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002955024, "chapter_id": 22955, "verse_number": "२-२-२५", "content_sanskrit": "कृषिस्तद्भक्तिवचनो नश्च तद्दास्यकारकः ।\nभक्तिदास्यप्रदाता यः स कृष्णः परिकीर्तितः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002955025, "chapter_id": 22955, "verse_number": "२-२-२६", "content_sanskrit": "कृषिश्च सर्ववचनो नकारो बीजवाचकः ।\nसर्वबीजं परं ब्रह्म कृष्ण इत्यभिधीयते ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002955026, "chapter_id": 22955, "verse_number": "२-२-२७", "content_sanskrit": "असंख्यब्रह्मणा पाते कालेऽतीतेऽपि नारद ।\nयद्गुणानां नास्ति नाशस्तत्समानो गुणेन च ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002955027, "chapter_id": 22955, "verse_number": "२-२-२८", "content_sanskrit": "स कृष्णः सर्वसृष्ट्यादौ सिसृक्षुस्त्वेक एव च ।\nसृष्ट्युन्मुखस्तदंशेन कालेन प्रेरितः प्रभुः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002955028, "chapter_id": 22955, "verse_number": "२-२-२९", "content_sanskrit": "स्वेच्छामयः स्वेच्छया च द्विधारूपो बभूव ह ।\nस्त्रीरूपा वामभागांशाद्दक्षिणांशः पुमान्स्मृतः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002955029, "chapter_id": 22955, "verse_number": "२-२-३०", "content_sanskrit": "तां ददर्श महाकामी कामाधारः सनातनः ।\nअतीव कमनीयां च चारुचम्पकसन्निभाम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002955030, "chapter_id": 22955, "verse_number": "२-२-३१", "content_sanskrit": "पूर्णेन्दुबिम्बसदृशनितम्वयुगलां पराम् ।\nसुचारुकदलीस्तम्भसदृशश्रोणिसुन्दरीम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002955031, "chapter_id": 22955, "verse_number": "२-२-३२", "content_sanskrit": "श्रीयुक्तश्रीफलाकारस्तनयुग्ममनोरमाम् ।\nपुष्ट्या युक्तां सुललितां मध्यक्षीणां मनोहराम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002955032, "chapter_id": 22955, "verse_number": "२-२-३३", "content_sanskrit": "अतीव सुन्दरीं शान्तां सस्मितां वक्रलोचनाम् ।\nवह्निशुद्धांशुकाधानां रत्नभूषणभूषिताम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002955033, "chapter_id": 22955, "verse_number": "२-२-३४", "content_sanskrit": "शश्वच्चक्षुश्चकोराभ्यां पिबन्तीं सन्ततं मुदा ।\nकृष्णस्य सुन्दरमुखं चन्द्रकोटिविनिन्दकम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002955034, "chapter_id": 22955, "verse_number": "२-२-३५", "content_sanskrit": "कस्तूरीबिन्दुभिः सार्द्धमधश्चन्दनबिन्दुना ।\nसमं सिन्दूरबिन्दुं च भालमध्ये च बिभ्रतीम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002955035, "chapter_id": 22955, "verse_number": "२-२-३६", "content_sanskrit": "सुवक्रकबरीभारं मालतीमाल्यभूषितम् ।\nरत्नेन्द्रसारहारं च दधतीं कान्तकामुकीम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002955036, "chapter_id": 22955, "verse_number": "२-२-३७", "content_sanskrit": "कोटिचन्द्रप्रभाजुष्टपुष्टशोभासमन्विताम् ।\nगमने राजहंसीं तां दृष्ट्या खञ्जनगञ्जनीम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002955037, "chapter_id": 22955, "verse_number": "२-२-३८", "content_sanskrit": "अतिमात्रं तया सार्द्धं रासेशो रासमण्डले ।\nरासोल्लासेषु रहसि रासक्रीडां चकार ह ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002955038, "chapter_id": 22955, "verse_number": "२-२-३९", "content_sanskrit": "नानाप्रकारशृंगारं शृङ्गारो मूर्त्तिमानिव ।\nचकार सुखसम्भोगं यावद्वै ब्रह्मणो वयः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002955039, "chapter_id": 22955, "verse_number": "२-२-४०", "content_sanskrit": "ततः स च परिश्रान्तस्तस्या योनौ जगत्पिता ।\nचकार वीर्य्याधानं च नित्यानन्दः शुभक्षणे ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002955040, "chapter_id": 22955, "verse_number": "२-२-४१", "content_sanskrit": "गात्रतो योषितस्तस्याः सुरतान्ते च सुव्रत ।\nनिस्ससार श्रमजलं श्रान्तायास्तेजसा हरेः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002955041, "chapter_id": 22955, "verse_number": "२-२-४२", "content_sanskrit": "महासुरतखिन्नाया निश्वासश्च बभूव ह ।\nतदाधारश्रमजलं तत्सर्वं विश्वगोलकम् ॥४२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002955042, "chapter_id": 22955, "verse_number": "२-२-४३", "content_sanskrit": "स च निःश्वासवायुश्च सर्वाधारो बभूव ह ।\nनिश्श्वासवायुः सर्वेषां जीविनां च भवेषु च ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002955043, "chapter_id": 22955, "verse_number": "२-२-४४", "content_sanskrit": "बभूव मूर्त्तिमद्वायोर्वामाङ्गात्प्राणवल्लभा ।\nतत्पत्नी सा च तत्पुत्राः प्राणाः पञ्च च जीविनाम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002955044, "chapter_id": 22955, "verse_number": "२-२-४५", "content_sanskrit": "प्राणोऽपानः समानश्चैवोदानो व्यान एव च ।\nबभूवुरेव तत्पुत्रा अधःप्राणाश्च पञ्च च ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002955045, "chapter_id": 22955, "verse_number": "२-२-४६", "content_sanskrit": "घर्मतोयाधिदेवश्च बभूव वरुणो महान् ।\nतद्वामाङ्गाच्च तत्पत्नी वरुणानी बभूव सा ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002955046, "chapter_id": 22955, "verse_number": "२-२-४७", "content_sanskrit": "अथ सा कृष्णशक्तिश्च कृष्णाद्गर्भं दधार ह ।\nशतमन्वन्तरं यावज्ज्वलन्तो(ती?) ब्रह्मतेजसा ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002955047, "chapter_id": 22955, "verse_number": "२-२-४८", "content_sanskrit": "कृष्णप्राणाधिदेवी सा कृष्णप्राणाधिकप्रिया ।\nकृष्णस्य सङ्गिनी शश्वत्कृष्णवक्षस्थलस्थिता ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002955048, "chapter_id": 22955, "verse_number": "२-२-४९", "content_sanskrit": "शतमन्वन्तरातीते काले परमसुन्दरी ।\nसुषावाण्डं सुवर्णाभं विश्वाधारालयं परम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002955049, "chapter_id": 22955, "verse_number": "२-२-५०", "content_sanskrit": "दृष्ट्वा चाण्डं हि सा देवी हृदयेन विदूयता ।\nउत्ससर्ज च कोपेन तदण्डं गोलके जले ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7002955050, "chapter_id": 22955, "verse_number": "२-२-५१", "content_sanskrit": "दृष्ट्वा कृष्णश्च तत्त्यागं हाहाकारं चकार द ।\nशशाप देवीं देवेशस्तत्क्षणं च यथोचितम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7002955051, "chapter_id": 22955, "verse_number": "२-२-५२", "content_sanskrit": "यतोऽपत्यं त्वया त्यक्तं कोपशीले सुनिष्ठुरे ।\nभव त्वमनपत्याऽपि चाद्यप्रभृति निश्चितम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7002955052, "chapter_id": 22955, "verse_number": "२-२-५३", "content_sanskrit": "या यास्त्वदंशरूपाश्च भविष्यन्ति सुरस्त्रियः ।\nअनपत्याश्च ताः सर्वास्त्वत्समा नित्ययौवनाः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7002955053, "chapter_id": 22955, "verse_number": "२-२-५४", "content_sanskrit": "एतस्मिन्नन्तरे देवी जिह्वाग्रात्सहसा ततः ।\nआविर्बभूव कन्यैका शुक्लवर्णा मनोहरा ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7002955054, "chapter_id": 22955, "verse_number": "२-२-५५", "content_sanskrit": "पीतवस्त्रपरीधाना वीणापुस्तकधारिणी ।\nरत्नभूषणभूषाढ्या सर्वशास्त्राधिदेवता ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7002955055, "chapter_id": 22955, "verse_number": "२-२-५६", "content_sanskrit": "अथ कालान्तरे सा च द्विधारूपा बभूव ह ।\nवामार्द्धाङ्गा च कमला दक्षिणार्द्धा च राधिका ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7002955056, "chapter_id": 22955, "verse_number": "२-२-५७", "content_sanskrit": "एतस्मिन्नन्तरे कृष्णो द्विधारूपो बभूव ह ।\nदक्षिणार्द्धस्स्याद्द्विभुजो वामार्द्धश्च चतुर्भुजः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7002955057, "chapter_id": 22955, "verse_number": "२-२-५८", "content_sanskrit": "उवाच वाणीं श्रीकृष्णस्त्वमस्य भव कामिनी ।\nअत्रैव मानिनी राधा नैव भद्रं भविष्यति ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7002955058, "chapter_id": 22955, "verse_number": "२-२-५९", "content_sanskrit": "एवं लक्ष्मीं संप्रदौ तुष्टो नारायणाय वै ।\nसंजगाम च वैकुण्ठं ताभ्यां सार्द्धं जगत्पतिः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7002955059, "chapter_id": 22955, "verse_number": "२-२-६०", "content_sanskrit": "अनपत्ये च ते द्वे च यतो राधांशसम्भवे ।\nनारायणाङ्गादभवन्पार्षदाश्च चतुर्भुजाः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7002955060, "chapter_id": 22955, "verse_number": "२-२-६१", "content_sanskrit": "तेजसा वयसा रूपगुणाभ्यां च समा हरेः ।\nबभूवुः कमलाङ्गाच्च दासीकोट्यश्च तत्समाः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7002955061, "chapter_id": 22955, "verse_number": "२-२-६२", "content_sanskrit": "अथ गोलोकनाथस्य लोमाविवरतो मुने ।\nआसन्नसंख्यगोपाश्च वयसा तेजसा समाः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7002955062, "chapter_id": 22955, "verse_number": "२-२-६३", "content_sanskrit": "रूपेण सुगुणेनैव वेषाद्वा विक्रमेण च ।\nप्राणतुल्याः प्रियाः सर्वे बभूवुः पार्षदा विभोः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7002955063, "chapter_id": 22955, "verse_number": "२-२-६४", "content_sanskrit": "राधाङ्गलोमकूपेभ्यो बभूवुर्गोपकन्यकाः ।\nराधातुल्याश्च सर्वास्ता नान्यतुल्याः प्रियंवदाः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7002955064, "chapter_id": 22955, "verse_number": "२-२-६५", "content_sanskrit": "रत्नभूषणभूषाढ्याः शश्वत्सुस्थिरयौवनाः ।\nअनपत्याश्च ताः सर्वाः पुंसः शापेन सन्ततम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7002955065, "chapter_id": 22955, "verse_number": "२-२-६६", "content_sanskrit": "एतस्मिन्नन्तरे विप्र सहसा कृष्णदेहतः ।\nआविर्बभूव सा दुर्गा विष्णुमाया सनातनी ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7002955066, "chapter_id": 22955, "verse_number": "२-२-६७", "content_sanskrit": "देवी नारायणीशाना सर्वशक्तिस्वरूपिणी ।\nबुद्ध्यधिष्ठातृदेवी सा कृष्णस्य परमात्मनः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7002955067, "chapter_id": 22955, "verse_number": "२-२-६८", "content_sanskrit": "देवीनां बीजरूपा च मूलप्रकृतिरीश्वरी ।\nपरिपूर्णतमा तेजःस्वरूपा त्रिगुणात्मिका ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7002955068, "chapter_id": 22955, "verse_number": "२-२-६९", "content_sanskrit": "तप्तकाञ्चनवर्णाभा सूर्य्यकोटिसमप्रभा ।\nईषद्धासप्रसन्नास्या सहस्रभुजसंयुता ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7002955069, "chapter_id": 22955, "verse_number": "२-२-७०", "content_sanskrit": "नानाशस्त्रास्त्रनिकरं बिभ्रती सा त्रिलोचना ।\nवह्निशुद्धांशुकाधाना रत्नभूषणभूषिता ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7002955070, "chapter_id": 22955, "verse_number": "२-२-७१", "content_sanskrit": "यस्याश्चांशांशकलया बभूवुः सर्वयोषितः ।\nसर्वविश्वस्थिता लोका मोहिता मायया यया ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7002955071, "chapter_id": 22955, "verse_number": "२-२-७२", "content_sanskrit": "सर्वैश्वर्य्यप्रदात्री च कामिनां गृहमेधिनाम् ।\nकृष्णभक्ति प्रदात्री च वैष्णवानां च वैष्णवी ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7002955072, "chapter_id": 22955, "verse_number": "२-२-७३", "content_sanskrit": "मुमुक्षूणां मोक्षदात्री सुखिनां सुखदायिनी ।\nस्वर्गेषु स्वर्गलक्ष्मीः सा गृहलक्ष्मीर्गृहेष्वसौ॥ ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7002955073, "chapter_id": 22955, "verse_number": "२-२-७४", "content_sanskrit": "तपस्विषु तपस्या च श्रीरूपा सा नृपेषु च ।\nया चाग्नौ दाहिकारूपा प्रभारूपा च भास्करे ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7002955074, "chapter_id": 22955, "verse_number": "२-२-७५", "content_sanskrit": "शोभास्वरूपा चन्द्रे च पद्मेषु च सुशोभना ।\nसर्वशक्तिस्वरूपा या श्रीकृष्णे परमात्मनि ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7002955075, "chapter_id": 22955, "verse_number": "२-२-७६", "content_sanskrit": "यया च शक्तिमानात्मा यया वै शक्तिमज्जगत् ।\nयया विना जगत्सर्वं जीवन्मृतमिव स्थितम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7002955076, "chapter_id": 22955, "verse_number": "२-२-७७", "content_sanskrit": "या च संसारवृक्षस्य बीजरूपा सनातनी ।\nस्थितिरूपा बुद्धिरूपा फलरूपा च नारद ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7002955077, "chapter_id": 22955, "verse_number": "२-२-७८", "content_sanskrit": "क्षुत्पिपासा दया श्रद्धा निद्रा तन्द्रा क्षमा धृतिः ।\nशान्तिर्लज्जातुष्टिपुष्टिभ्रान्तिकान्त्यादिरूपिणी ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7002955078, "chapter_id": 22955, "verse_number": "२-२-७९", "content_sanskrit": "सा च संस्तूय सर्वेशं तत्पुरः समुपस्थिता ।\nरत्नसिंहासनं तस्यै प्रददौ राधिकेश्वरः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7002955079, "chapter_id": 22955, "verse_number": "२-२-८०", "content_sanskrit": "एतस्मिन्नन्तरे तत्र सस्त्रीकश्च चतुर्मुखः ।\nपद्मनाभो नाभिपद्मान्निस्ससार पुमान्मुने ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7002955080, "chapter_id": 22955, "verse_number": "२-२-८१", "content_sanskrit": "कमण्डलुधरः श्रीमांस्तपस्वी ज्ञानिनां वरः ।\nचतुर्मुखस्तं तुष्टाव प्रज्वलन्ब्रह्मतेजसा ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7002955081, "chapter_id": 22955, "verse_number": "२-२-८२", "content_sanskrit": "सुदती सुन्दरी श्रेष्ठा शतचन्द्रसमप्रभा ।\nवह्निशुद्धांशुकाधाना रत्नभूषणभूषिता ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7002955082, "chapter_id": 22955, "verse_number": "२-२-८३", "content_sanskrit": "रत्नसिंहासने रम्ये स्तुता वै सर्वकारणम् ।\nउवास स्वामिना सार्द्ध कृष्णस्य पुरतो मुदा ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7002955083, "chapter_id": 22955, "verse_number": "२-२-८४", "content_sanskrit": "एतस्मिन्नन्तरे कृष्णो द्विधारूपो बभूव सः ।\nवामार्द्धांगो महादेवो दक्षिणो गोपिकापतिः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7002955084, "chapter_id": 22955, "verse_number": "२-२-८५", "content_sanskrit": "शुद्धस्फटिकसङ्काशः शतकोटिरविप्रभः ।\nत्रिशूलपट्टिशधरो व्याघ्रचर्मधरो हरः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7002955085, "chapter_id": 22955, "verse_number": "२-२-८६", "content_sanskrit": "तप्तकाञ्चनवर्णाभ जटाभारधरः परः ।\nभस्मभूषणगात्रश्च सस्मितश्चन्द्रशेखरः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7002955086, "chapter_id": 22955, "verse_number": "२-२-८७", "content_sanskrit": "दिगम्बरो नीलकण्ठः सर्प भूषणभूषितः ।\nबिभ्रद्दक्षिणहस्तेन रत्नमालां सुसंस्कृताम् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7002955087, "chapter_id": 22955, "verse_number": "२-२-८८", "content_sanskrit": "प्रजपन्पञ्चवक्त्रेण ब्रह्मज्योतिः सनातनम् ।\nसत्यस्वरूपं श्रीकृष्णं परमात्मानमीश्वरम् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7002955088, "chapter_id": 22955, "verse_number": "२-२-८९", "content_sanskrit": "कारणं कारणानां च सर्वमङ्गलमङ्गलम् ।\nजन्ममृत्युजराव्याधिशोकभीतिहरं परम् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7002955089, "chapter_id": 22955, "verse_number": "२-२-९०", "content_sanskrit": "संस्तूय मृत्योर्मृत्युं तं जातो मृत्युञ्जयाभिधः ।\nरत्नसिंहासने रम्ये समुवास हरेः पुरः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}]