[{"id": 6000035000, "chapter_id": 10035, "verse_number": null, "content_sanskrit": "अथ पञ्चमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1, "topics": [{"text": "इत आरभ्य चतुर्थस्कन्धसमाप्त्यवधि विदुर-मैत्रेययोः", "range": null}, {"text": "संवादः कथ्यते", "range": null}]}, {"id": 6000035001, "chapter_id": 10035, "verse_number": null, "content_sanskrit": "शुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_005/BhP_03.005.001.m4a", "display_order": 2}, {"id": 6000035002, "chapter_id": 10035, "verse_number": "३-५-१", "content_sanskrit": "द्वारि द्युनद्या ऋषभः कुरूणां मैत्रेयमासीनमगाधबोधम्।\nक्षत्ताऽभिसृत्याच्युतभावशुद्धः पप्रच्छ सौशील्यगुणातितृप्तम्॥ ३/५/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_005/BhP_03.005.002.m4a", "display_order": 3, "topics": [{"text": "विदुरेण गङ्गाद्वारमेत्य मैत्रेयं प्रति स्वस्य ज्ञानोपदेशप्रार्थना", "range": "१–१६"}]}, {"id": 6000035003, "chapter_id": 10035, "verse_number": null, "content_sanskrit": "विदुर उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_005/BhP_03.005.003.m4a", "display_order": 4}, {"id": 6000035004, "chapter_id": 10035, "verse_number": "३-५-२", "content_sanskrit": "सुखाय कर्माणि करोति लोको न तैः सुखं नान्यदुपारमं वा।\nविन्देत भूयस्तत एव दुःखं यदत्र युक्तं भगवान् वदेन्नः॥ ३/५/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_005/BhP_03.005.004.m4a", "display_order": 5}, {"id": 6000035005, "chapter_id": 10035, "verse_number": "३-५-३", "content_sanskrit": "जनस्य कृष्णाद् विमुखस्य दैवाद् अधर्मशीलस्य सुदुःखितस्य।\nअनुग्रहायेह चरन्ति नूनं भूतानि भव्यानि जनार्दनस्य॥ ३/५/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_005/BhP_03.005.005.m4a", "display_order": 6}, {"id": 6000035006, "chapter_id": 10035, "verse_number": "३-५-४", "content_sanskrit": "तत् साधुवर्यादिश शर्मवर्त्म संराधितो भगवान् येन पुंसाम्।\nहृदि स्थितो यच्छति भक्तिपूते ज्ञानं स्वसत्ताधिगमं पुराणम्॥ ३/५/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_005/BhP_03.005.006.m4a", "display_order": 7}, {"id": 6000035007, "chapter_id": 10035, "verse_number": "३-५-५", "content_sanskrit": "करोति कर्माणि कृतावतारो यान्यात्मतन्त्रो भगवांस्‍त्र्यधीशः।\nयथा ससर्जाग्र इदं निरीहः संस्थाप्य वृत्तिं जगतो विधत्ते॥ ३/५/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_005/BhP_03.005.007.m4a", "display_order": 8}, {"id": 6000035008, "chapter_id": 10035, "verse_number": "३-५-६", "content_sanskrit": "यथा पुनः स्वे ख इदं निवेश्य शेते गुहायां स निवृत्तवृत्तिः।\nयोगेश्वराधीश्वर एक एतदनुप्रविष्टो बहुधा यथाऽऽसीत्॥ ३/५/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_005/BhP_03.005.008.m4a", "display_order": 9}, {"id": 6000035009, "chapter_id": 10035, "verse_number": "३-५-७", "content_sanskrit": "क्रीडन् विधत्ते द्विजगोसुराणां क्षेमाय कर्माण्यवतारभेदैः।\nमनो न तृप्यत्यपि शृृण्वतां नः सुश्लोकमौलेश्चरितामृतानि॥ ३/५/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_005/BhP_03.005.009.m4a", "display_order": 10}, {"id": 6000035010, "chapter_id": 10035, "verse_number": "३-५-८", "content_sanskrit": "यैस्तत्त्वभेदैरधिलोकनाथो लोकानलोकान् सह लोकपालान्।\nअचीक्लृपद् यत्र हि सर्वसत्त्वनिकायभेदोऽधिकृतः प्रतीतः॥ ३/५/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_005/BhP_03.005.010.m4a", "display_order": 11}, {"id": 6000035011, "chapter_id": 10035, "verse_number": "३-५-९", "content_sanskrit": "येन प्रजानामुत आत्मकर्मरूपाभिधानेन भिदां व्यधत्त।\nनारायणो विश्वसृगात्मयोनिरेतच्च नो वर्णय विप्रवर्य॥ ३/५/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_005/BhP_03.005.011.m4a", "display_order": 12}, {"id": 6000035012, "chapter_id": 10035, "verse_number": "३-५-१०", "content_sanskrit": "परावरेषां भगवन् कृतानि श्रुतानि मे व्यासमुखादभीक्ष्णम्।\nन तृप्नुमः कर्णसुखावहानां तेषामृते कृष्णकथामृतौघात्॥ ३/५/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_005/BhP_03.005.012.m4a", "display_order": 13}, {"id": 6000035013, "chapter_id": 10035, "verse_number": "३-५-११", "content_sanskrit": "कस्तृप्नुयात् तीर्थपदोऽभिधानात् सत्रेषु वः सूरिभिरीड्यमानात्।\nयः कर्णनाडीं पुरुषस्य यातो भयप्रदां गेहरतिं छिनत्ति॥ ३/५/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_005/BhP_03.005.013.m4a", "display_order": 14}, {"id": 6000035014, "chapter_id": 10035, "verse_number": "३-५-१२", "content_sanskrit": "मुनिर्विवक्षुर्भगवद्गुणानां सखाऽपि ते भारतमाह कृष्णः।\nयस्मिन् नृणां ग्राम्यसुखानुवादैर्मतिर्गृहीता न हरेः कथायाम्॥ ३/५/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_005/BhP_03.005.014.m4a", "display_order": 15}, {"id": 6000035015, "chapter_id": 10035, "verse_number": "३-५-१३", "content_sanskrit": "सा श्रद्धधानस्य विवर्धमाना विरक्तिमन्यत्र करोति पुंसः।\nहरेः सदाऽनुस्मृतिनिर्वृतस्य समस्तदुःखाप्ययमाशु धत्ते॥ ३/५/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_005/BhP_03.005.015.m4a", "display_order": 16}, {"id": 6000035016, "chapter_id": 10035, "verse_number": "३-५-१४", "content_sanskrit": "ताञ्छोच्यशोच्यानविदोऽनुशोचे हरेः कथायां विमुखानघेन।\nक्षिणोति देवोऽनिमिषस्तु तेषामायुर्वृथावादगतिस्मृतीनाम्॥ ३/५/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_005/BhP_03.005.016.m4a", "display_order": 17}, {"id": 6000035017, "chapter_id": 10035, "verse_number": "३-५-१५", "content_sanskrit": "तदस्य कौषारव शर्मदातुर्हरेः कथामेव कथासु सारम्।\nउद्धृत्य पुष्पेभ्य इवार्तबन्धो शिवाय नः कीर्तय तीर्थकीर्तेः॥ ३/५/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_005/BhP_03.005.017.m4a", "display_order": 18}, {"id": 6000035018, "chapter_id": 10035, "verse_number": "३-५-१६", "content_sanskrit": "स विश्वजन्मस्थितिसंयमार्थे कृतावतारः प्रगृहीतशक्तिः।\nचकार कर्माण्यतिपौरुषाणि यानीश्वरः कीर्तय तानि मह्यम्॥ ३/५/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_005/BhP_03.005.018.m4a", "display_order": 19}, {"id": 6000035019, "chapter_id": 10035, "verse_number": null, "content_sanskrit": "शुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_005/BhP_03.005.019.m4a", "display_order": 20}, {"id": 6000035020, "chapter_id": 10035, "verse_number": "३-५-१७", "content_sanskrit": "स एवं भगवान् पृष्टः क्षत्त्रा कौषारविर्मुनिः।\nपुंसां निःश्रेयसार्थाय तमाह बहुमानयन्॥ ३/५/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_005/BhP_03.005.020.m4a", "display_order": 21, "topics": [{"text": "विदुरजिज्ञासोपशमाय लोकोपकाराय च प्रपञ्चसृष्ट्यादिविषयोपपादनस्य उपक्रमः", "range": "१७–२२"}]}, {"id": 6000035021, "chapter_id": 10035, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_005/BhP_03.005.021.m4a", "display_order": 22}, {"id": 6000035022, "chapter_id": 10035, "verse_number": "३-५-१८", "content_sanskrit": "साधु पृष्टं त्वया साधो लोकान् साध्वनुगृह्णता।\nकीर्तिं वितन्वता लोके आत्मनोऽधोक्षजात्मनः॥ ३/५/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_005/BhP_03.005.022.m4a", "display_order": 23}, {"id": 6000035023, "chapter_id": 10035, "verse_number": "३-५-१९", "content_sanskrit": "नैतच्चित्रं त्वयि क्षत्तर्बादरायणवीर्यजे।\nगृहीतोऽनन्यभावेन यत् त्वया हरिरीश्वरः॥ ३/५/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_005/BhP_03.005.023.m4a", "display_order": 24}, {"id": 6000035024, "chapter_id": 10035, "verse_number": "३-५-२०", "content_sanskrit": "माण्डव्यशापाद् भगवान् प्रजासंयमनो यमः।\nभ्रातुः क्षेत्रे भुजिष्यायां जातः सत्यवतीसुतात्॥ ३/५/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_005/BhP_03.005.024.m4a", "display_order": 25}, {"id": 6000035025, "chapter_id": 10035, "verse_number": "३-५-२१", "content_sanskrit": "भवान् भगवतो नित्यं सम्मतः सानुगस्य हि।\nज्ञानोपदेशाय च मामादिशद् भगवान् व्रजन्॥ ३/५/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_005/BhP_03.005.025.m4a", "display_order": 26}, {"id": 6000035026, "chapter_id": 10035, "verse_number": "३-५-२२", "content_sanskrit": "अथ ते भगवल्लीला योगमायोपबृंहिताः।\nविश्वस्थित्युद्भवान्तार्था वर्णयाम्यनुपूर्वशः॥ ३/५/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_005/BhP_03.005.026.m4a", "display_order": 27}, {"id": 6000035027, "chapter_id": 10035, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां तृतीयस्कन्धे पञ्चमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]