[{"id": 2062274, "chapter_id": 2327, "verse_number": "८-४८-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2062275, "chapter_id": 2327, "verse_number": "८-४८-१", "content_sanskrit": "वर्तमाने तथा युद्धे क्षत्रियाणां निमज्जने।\nगाण्डीवस्य महाघोषः श्रूयते युधि मारिष॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2062276, "chapter_id": 2327, "verse_number": "८-४८-२", "content_sanskrit": "संशप्तकानामकरोत्कदनं यत्र पाण्डवः।\nकोसलानां तथा राजन्नारायणबलस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2062277, "chapter_id": 2327, "verse_number": "८-४८-३", "content_sanskrit": "संशप्तकास्तु समरे शरवृष्टिः समन्ततः।\nअपातयन्पार्थमूर्ध्नि जयगृद्धाः प्रमन्यवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2062278, "chapter_id": 2327, "verse_number": "८-४८-४", "content_sanskrit": "तां शस्त्रवृष्टिमायान्तीमुरसा धारयन्प्रभुः।\nव्यगाहत परान्पार्थो विनिघ्नन्रथिनां वरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2062279, "chapter_id": 2327, "verse_number": "८-४८-५", "content_sanskrit": "विक्षोभ्य तु रथानीकं कङ्कपत्रैः शिलाशितैः।\nआससाद ततः पार्थः सुशर्माणं महारथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2062280, "chapter_id": 2327, "verse_number": "८-४८-६", "content_sanskrit": "स तस्य शरवर्षाणि ववर्ष रथिनां वरः।\nतथा संशप्तकाश्चैव पार्थस्य समरे स्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2062281, "chapter_id": 2327, "verse_number": "८-४८-७", "content_sanskrit": "सुशर्मा तु ततः पार्थं विद्ध्वा दशभिराशुगैः।\nजनार्दनं त्रिभिर्बाणैरहनद्दक्षिणे भुजे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2062282, "chapter_id": 2327, "verse_number": "८-४८-८", "content_sanskrit": "ततोऽपरेण भल्लेन केतुं पार्थस्य मारिष।\nविव्याध समरे राजन्सुशर्मा क्रोधमूर्च्छितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2062283, "chapter_id": 2327, "verse_number": "८-४८-९", "content_sanskrit": "स वानरवरो राजन्विश्वकर्मकृतो महान्।\nननाद सुमहानादं नृत्यन्निव विभीषयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2062284, "chapter_id": 2327, "verse_number": "८-४८-१०", "content_sanskrit": "कपेस्तु निनदं श्रुत्वा सन्त्रस्ता तव वाहिनी।\nभयं विपुलमासाद्य निश्चेष्टा समपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2062285, "chapter_id": 2327, "verse_number": "८-४८-११", "content_sanskrit": "ततः सा शुशुभे सेना निश्चेष्टाऽवस्थिता नृप।\nनानापुष्पसमाकीर्णं यथा चित्रीकृतं वनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2062286, "chapter_id": 2327, "verse_number": "८-४८-१२", "content_sanskrit": "प्रतिलभ्य ततः संज्ञां योधास्ते कुरुसत्तम।\nअर्जुनं सिषिचुर्बाणैः पर्वतं जलदा इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2062287, "chapter_id": 2327, "verse_number": "८-४८-१३", "content_sanskrit": "सञ्छाद्य समरे पार्थं परिवव्रुः समन्ततः।\nते हयान्रथचक्रे तु रथेषां चापि मारिष।\nग्रहीतुं प्रचक्रमुश्चैव क्रोधाविष्टाः समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2062288, "chapter_id": 2327, "verse_number": "८-४८-१४", "content_sanskrit": "निगृह्य तु रथं तस्य योधास्ते तु सहस्रशः।\nरथबन्धं प्रचक्रुर्हि पाण्डवस्यामितौजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2062289, "chapter_id": 2327, "verse_number": "८-४८-१५", "content_sanskrit": "रथमारुरुहुः केचित्कृष्णपार्थौ जिघृक्षवः।\nसंशप्तकानां योधास्ते सिंहनादांश्च नेदिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2062290, "chapter_id": 2327, "verse_number": "८-४८-१६", "content_sanskrit": "अपरे जगृहुश्चैव केशवस्य महाभुजौ।\nपार्थं चैके महाराज रथस्थं जगृहुर्मुदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2062291, "chapter_id": 2327, "verse_number": "८-४८-१७", "content_sanskrit": "अच्युतः स महाबाहुर्विधुन्वन्रणमूर्धनि।\nपातयामास तान्सर्वान्दुष्टहस्तीव हस्तिपान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2062292, "chapter_id": 2327, "verse_number": "८-४८-१८", "content_sanskrit": "स रथस्तैर्गृहीतस्तु पाण्डवस्य महात्मनः।\nस्पन्दितुं नाशकद्राजंस्तदद्भुतमिवाभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2062293, "chapter_id": 2327, "verse_number": "८-४८-१९", "content_sanskrit": "ततः पार्थो महाबाहुः संवृतः स्तैर्महारथैः।\nनिगृहीतं रथं दृष्ट्वा तांश्चाप्याद्रवतो बहून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2062294, "chapter_id": 2327, "verse_number": "८-४८-२०", "content_sanskrit": "रथारूढांश्च सुबहून्पदाऽऽक्षिप्य न्यपातयत्।\nअपातयदसम्भ्रान्तः शरैरासन्नयोधिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2062295, "chapter_id": 2327, "verse_number": "८-४८-२१", "content_sanskrit": "तांस्तापयित्वा समरे पार्थः परपुरञ्जयः।\nस्मयन्निव महाबाहुः केशवं वाक्यमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2062296, "chapter_id": 2327, "verse_number": "८-४८-२२", "content_sanskrit": "पश्य कृष्ण महाबाहो संशप्तकगणान्बहून्।\nकुर्वतोऽसुकरं कर्म मुमूर्षून्कालचोदितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2062297, "chapter_id": 2327, "verse_number": "८-४८-२३", "content_sanskrit": "रथबन्धमिमं प्राप्य पृथिव्यां नास्ति कश्चन।\nयः सहेत पुमाँल्लोके मदन्यः क्षत्रियर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2062298, "chapter_id": 2327, "verse_number": "८-४८-२४", "content_sanskrit": "पश्यैततानद्य समरे मत्प्रयुक्तैः सुतेजनैः।\nपात्यमानान्रणे कृष्ण शरैराशीविषोपमैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2062299, "chapter_id": 2327, "verse_number": "८-४८-२५", "content_sanskrit": "इत्येवमुक्त्वा बीभत्सुः शङ्खप्रवरमुत्तमम्।\nव्यनादयदमेयात्मा देवदत्तं महामृधे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2062300, "chapter_id": 2327, "verse_number": "८-४८-२६", "content_sanskrit": "देवदत्तस्वनं श्रुत्वा केशवोऽपि महायशाः।\nपाञ्चजन्यस्वनं चक्रे पूरयन्निव रोदसी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2062301, "chapter_id": 2327, "verse_number": "८-४८-२७", "content_sanskrit": "तयोः शङ्खस्वनं श्रुत्वा संशप्तकवरूथिनी।\nसञ्चचाल महाराज वित्रस्ता चाद्रवद्भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2062302, "chapter_id": 2327, "verse_number": "८-४८-२८", "content_sanskrit": "नागमस्त्रं ततः पार्थः प्रादुश्चक्रे हसन्निव।\nपादबन्धं स तेषां वै चक्रे तेन महास्त्रवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2062303, "chapter_id": 2327, "verse_number": "८-४८-२९", "content_sanskrit": "यानुद्दिश्य रणे पार्थः पादबन्धं चकार ह।\nते बद्धाः पादबन्धेन योधाः संशप्तकास्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2062304, "chapter_id": 2327, "verse_number": "८-४८-३०", "content_sanskrit": "निर्विचेष्टास्तदाऽभूवन्पाण्डवस्यास्त्रतेजसा।\nनिर्विचेष्टांस्ततो योधानवधीत्पाण्डुनन्दनः।\nयथेन्द्रः समरे दैत्यांस्तारकस्य वधे पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2062305, "chapter_id": 2327, "verse_number": "८-४८-३१", "content_sanskrit": "ते वध्यमानाः समरे मुमुचुस्तं रथोत्तमम्।\nआयुधानि च सर्वाणि विस्रष्टुमुपचक्रमुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2062306, "chapter_id": 2327, "verse_number": "८-४८-३२", "content_sanskrit": "ततः सुशर्मा राजेन्द्र गृहीतां वीक्ष्य वाहिनीम्।\nसौपर्णमस्त्रं त्वरितः प्रादुश्चक्रे महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2062307, "chapter_id": 2327, "verse_number": "८-४८-३३", "content_sanskrit": "ततः सुपर्णाः सम्पेतुर्भक्षयन्तो भुजङ्गमान्।\nततो विदुद्रुवुर्नागास्तान्दृष्ट्वा खेचरान्नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2062308, "chapter_id": 2327, "verse_number": "८-४८-३४", "content_sanskrit": "तद्विमुक्तं बलं रेजे पादबन्धाद्विशाम्पते।\nमेघबन्धाद्यथा मुक्तो भास्करस्तापयन्प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2062309, "chapter_id": 2327, "verse_number": "८-४८-३५", "content_sanskrit": "विप्रमुक्ताः स्वका योधाः फल्गुनस्य रथं प्रति।\nससृजुः शरसङ्घांश्च शस्त्रसङ्घांश्च मारिष॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2062310, "chapter_id": 2327, "verse_number": "८-४८-३६", "content_sanskrit": "तां महास्त्रमयीं वृष्टिं शरैः सञ्छिद्य भारत।\nअवधीत्सततो योधान्वासविः परवीरहा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2062311, "chapter_id": 2327, "verse_number": "८-४८-३७", "content_sanskrit": "सुशर्मा तु ततो राजन्बाणेन नतपर्वणा।\nअर्जुनं हृदये विद्ध्वा विव्याधान्यैस्त्रिसप्तभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2062312, "chapter_id": 2327, "verse_number": "८-४८-३८", "content_sanskrit": "स गाढविद्धो व्यथितो रथोपस्थ उपाविशतत्।\nतत उच्चुक्रुशुः सर्वे हतः पार्थ इति ब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2062313, "chapter_id": 2327, "verse_number": "८-४८-३९", "content_sanskrit": "ततः शङ्खनिनादाश्च भेरीशब्दाश्च पुष्कलाः।\nनानावादित्रनिनदाः सिंहनादाश्च जज्ञिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2062314, "chapter_id": 2327, "verse_number": "८-४८-४०", "content_sanskrit": "प्रतिलभ्य ततः संज्ञां श्वेताश्वः कृष्णसारथिः।\nसोऽतिविद्धो महेष्वासः शरैराशीविपोपमैः।\nसुशर्माणं महाराज क्रोधाविष्टो महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2062315, "chapter_id": 2327, "verse_number": "८-४८-४१", "content_sanskrit": "ततः शरशतैः पार्थः सञ्छाद्यैनं क्षणाद्रणे।\nदिशस्तु वारयामास बाणैस्तत्र महास्त्रवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2062316, "chapter_id": 2327, "verse_number": "८-४८-४२", "content_sanskrit": "विमुखीकृत्य समरे सुशर्माणं धनञ्जयः।\nऐन्द्रमस्त्रममेयात्मा प्रादुश्चक्रे हसन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2062317, "chapter_id": 2327, "verse_number": "८-४८-४३", "content_sanskrit": "ततो बाणसहस्राणि तदुत्सृष्टानि मारिष।\nसर्वदिक्षु व्यदृश्यन्त सूदयन्ति रथद्विपान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2062318, "chapter_id": 2327, "verse_number": "८-४८-४४", "content_sanskrit": "हयान्पत्तींश्च समरे शस्त्रैः शतसहस्रशः।\nरराज समरे राजञ्शक्रो निघ्नन्निवासुरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2062319, "chapter_id": 2327, "verse_number": "८-४८-४५", "content_sanskrit": "वध्यमाने ततः सैन्ये भयं सुमहदाविशत्।\nसंशप्तकगणानां च गोपालानां च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2062320, "chapter_id": 2327, "verse_number": "८-४८-४६", "content_sanskrit": "न हि तत्र पुमान्कश्चिद्योऽर्जुनं प्रतिबुध्यते।\nपश्यतां तत्र वीराणामहन्यत बलं तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2062321, "chapter_id": 2327, "verse_number": "८-४८-४७", "content_sanskrit": "हन्यमानं च तदभून्निश्चेष्टं च पराक्रमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2062322, "chapter_id": 2327, "verse_number": "८-४८-४८", "content_sanskrit": "अयुतं तत्र योधानां हत्वा पाण्डुसुतो रणे।\nव्यभ्राजत महाराज विधूमोऽग्निरिव ज्वलन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2062323, "chapter_id": 2327, "verse_number": "८-४८-४९", "content_sanskrit": "चतुर्दशसहस्राणि यानि दृष्टनि भारत।\nरथानामयुतं चैव त्रिसहस्राश्च दन्तिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2062324, "chapter_id": 2327, "verse_number": "८-४८-५०", "content_sanskrit": "ततः संशप्तका भूयः परिवव्रुर्धनञ्जयम्।\nमर्तव्यमिति निश्चित्य जयं वाप्यनिवर्तनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2062325, "chapter_id": 2327, "verse_number": "८-४८-५१", "content_sanskrit": "तत्र युद्धं महच्चासीत्तावकानां विशाम्पते।\nशूरेण बलिना सार्धं पाण्डवेन किरीटिना।\nजित्वा तान्न्यहनत्पार्थः शत्रूञ्शक्र इवासुरान्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2062326, "chapter_id": 2327, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि सप्तदशदिवसयुद्धे अष्टचत्वारिंशोऽध्यायः॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]