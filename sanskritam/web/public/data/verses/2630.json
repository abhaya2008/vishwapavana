[{"id": 2076745, "chapter_id": 2630, "verse_number": "१२-१३५-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2076746, "chapter_id": 2630, "verse_number": "१२-१३५-१", "content_sanskrit": "अत्राप्युदाहन्तीममितिहासं पुरातनम्।\nयथा दस्युः समर्यादो दस्युत्वात्सिद्धिमाप्तवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2076747, "chapter_id": 2630, "verse_number": "१२-१३५-२", "content_sanskrit": "प्रहर्ता मतिमाञ्शूरः श्रुतवान्सुनृशंसवान्।\nअक्षन्नाश्रमिणां धर्मं ब्रह्मण्यो गुरुपूजकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2076748, "chapter_id": 2630, "verse_number": "१२-१३५-३", "content_sanskrit": "अनिषाद्यां क्षत्रियाज्जातः क्षत्रधर्मानुपालकः।\nकापच्यो नाम नैषादिर्दस्युत्वात्सिद्धिमाप्तवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2076749, "chapter_id": 2630, "verse_number": "१२-१३५-४", "content_sanskrit": "अरण्ये सायं पूर्वाह्णे मृगयूथप्रकोपिता।\nवेधिज्ञो मृगजातीनां नैषादानां च कोविदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2076750, "chapter_id": 2630, "verse_number": "१२-१३५-५", "content_sanskrit": "सर्वकाननदेशज्ञः पारियात्रचरः सदा।\nधर्मज्ञः सर्ववर्णानाममोघेषुर्दृढायुधः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2076751, "chapter_id": 2630, "verse_number": "१२-१३५-६", "content_sanskrit": "अप्यनेकशतां सेनामेक एव जिगाय सः।\nस वृद्धावम्बपितरौ महारण्येऽभ्यपूजयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2076752, "chapter_id": 2630, "verse_number": "१२-१३५-७", "content_sanskrit": "मधुमांसैर्मूलफलैरन्नैरुच्चावचैरपि।\nसत्कृत्य भोजयामास सम्यक्परिचचार ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2076753, "chapter_id": 2630, "verse_number": "१२-१३५-८", "content_sanskrit": "आरण्यकान्प्रव्रजितान्ब्राह्मणान्परिपालयन्।\nअपि तेभ्यो मृगान्हत्वा निनाय सततं वने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2076754, "chapter_id": 2630, "verse_number": "१२-१३५-९", "content_sanskrit": "येऽस्मान्न प्रतिगृह्णन्ति दस्युभोजनशङ्कया।\nतेषामासज्य गेहेषु कल्य एव स गच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2076755, "chapter_id": 2630, "verse_number": "१२-१३५-१०", "content_sanskrit": "तं बहूनि सहस्राणि ग्रामणीत्वेऽभिवव्रिरे।\nनिर्मर्यादानि दस्यूनां निरनुक्रोशवर्तिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2076756, "chapter_id": 2630, "verse_number": "१२-१३५-११x", "content_sanskrit": "दस्यव ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2076757, "chapter_id": 2630, "verse_number": "१२-१३५-११", "content_sanskrit": "मुहूर्तदेशकालज्ञः प्राज्ञः शूरो दृढव्रतः।\nग्रामणीर्भव नो मुख्यः सर्वेपामेव संमतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2076758, "chapter_id": 2630, "verse_number": "१२-१३५-१२", "content_sanskrit": "यथायथा वक्ष्यसि नः करिष्यामस्तथातथा।\nपालयास्मान्यथान्यायं यथा माता यथा पिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2076759, "chapter_id": 2630, "verse_number": "१२-१३५-१३x", "content_sanskrit": "कापच्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2076760, "chapter_id": 2630, "verse_number": "१२-१३५-१३", "content_sanskrit": "मा वधीस्त्वं स्त्रियं भीरुं मा शिशुं मा तपस्विनम्।\nनायुध्यमानो हन्तव्यो न च ग्राह्या बलात्स्त्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2076761, "chapter_id": 2630, "verse_number": "१२-१३५-१४", "content_sanskrit": "सर्वथा स्त्री न हन्तव्या सर्वसत्वेषु बुध्यत।\nनित्यं गोब्राह्मणे स्वस्ति योद्धव्यं च तदर्थतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2076762, "chapter_id": 2630, "verse_number": "१२-१३५-१५", "content_sanskrit": "सत्यं च नापि हर्तव्यं सारविघ्नं च मा कृथाः।\nपूज्यन्ते यत्र देवाश्च पितरोऽतिथयश्च ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2076763, "chapter_id": 2630, "verse_number": "१२-१३५-१६", "content_sanskrit": "सर्वभूतेष्वपि वरो ब्राह्मणो मोक्षमर्हति।\nकार्या चापचितिस्तेषां सर्वस्वेनापि भावयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2076764, "chapter_id": 2630, "verse_number": "१२-१३५-१७", "content_sanskrit": "यस्य त्वेते संप्रदुष्टास्तस्य विद्यात्पराभवम्।\nन तस्य त्रिषु लोकेषु त्राता भवति कस्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2076765, "chapter_id": 2630, "verse_number": "१२-१३५-१८", "content_sanskrit": "यो ब्राह्मणान्परिभवेद्विनाशं चापि रोचयेत्।\nसूर्योदय इव ध्वान्ते ध्रुवं तस्य पराभवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2076766, "chapter_id": 2630, "verse_number": "१२-१३५-१९", "content_sanskrit": "इहैव फलमासीनः प्रत्याकाङ्क्षेत सर्वशः।\nयेये नो न प्रदास्यन्ति तांस्तांस्तेनाभियास्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2076767, "chapter_id": 2630, "verse_number": "१२-१३५-२०", "content_sanskrit": "शिष्ट्यर्थं विहितो दण्डो न वधार्थं विधीयते।\nये च शिष्टान्प्रबाधन्ते धर्मस्तेषां वधः स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2076768, "chapter_id": 2630, "verse_number": "१२-१३५-२१", "content_sanskrit": "ये च राष्ट्रोपरोधेन वृद्धिं कुर्वन्ति केचन।\nतानेवानुम्रियेरंस्ते कुणपं कृमयो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2076769, "chapter_id": 2630, "verse_number": "१२-१३५-२२", "content_sanskrit": "ये पुनर्धर्मशास्त्रेण वर्तेरन्निह दस्यवः।\nअपि ते दस्यवो भूत्वा क्षिप्रं सिद्धिमवाप्नुयुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2076770, "chapter_id": 2630, "verse_number": "१२-१३५-२३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2076771, "chapter_id": 2630, "verse_number": "१२-१३५-२३", "content_sanskrit": "ते सर्वमेवानुचक्रुः कापच्यस्यानुशासनम्।\nवृद्धिं च लेभिरे सर्वे पापेभ्यश्चाप्युपारमन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2076772, "chapter_id": 2630, "verse_number": "१२-१३५-२४", "content_sanskrit": "कापच्यः कर्मणा तेन महतीं सिद्धिमाप्तवान्।\nसाधूनामाचरन्क्षेमं दस्यून्पापान्निवर्तयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2076773, "chapter_id": 2630, "verse_number": "१२-१३५-२५", "content_sanskrit": "इदं कापच्यचरितं यो नित्यमनुचिन्तयेत्।\nनारण्येभ्योऽपि भूतेभ्यो भयमृच्छेत्कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2076774, "chapter_id": 2630, "verse_number": "१२-१३५-२६", "content_sanskrit": "न भयं तस्य मर्त्येभ्यो नामर्त्येभ्यः कथंचन।\nन सतो नासतो राजन्स ह्यरण्येषु गोपतिः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2076775, "chapter_id": 2630, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि आपद्धर्मपर्वणि पञ्चत्रिंशदधिकशततमोऽध्यायः॥ १३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]