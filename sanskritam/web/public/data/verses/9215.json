[{"id": 5000215000, "chapter_id": 9215, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे एकोनविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000215001, "chapter_id": 9215, "verse_number": "३-१९-१", "content_sanskrit": "तां तथा पतितां दृष्ट्वा विरूपां शोणितोक्षिताम्।\nभगिनीं क्रोधसंतप्तः खरः पप्रच्छ राक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000215002, "chapter_id": 9215, "verse_number": "३-१९-२", "content_sanskrit": "उत्तिष्ठ तावदाख्याहि प्रमोहं जहि सम्भ्रमम्।\nव्यक्तमाख्याहि केन त्वमेवंरूपा विरूपिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000215003, "chapter_id": 9215, "verse_number": "३-१९-३", "content_sanskrit": "कः कृष्णसर्पमासीनमाशीविषमनागसम्।\nतुदत्यभिसमापन्नमङ्गुल्यग्रेण लीलया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000215004, "chapter_id": 9215, "verse_number": "३-१९-४", "content_sanskrit": "कालपाशं समासज्य कण्ठे मोहान्न बुध्यते।\nयस्त्वामद्य समासाद्य पीतवान् विषमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000215005, "chapter_id": 9215, "verse_number": "३-१९-५", "content_sanskrit": "बलविक्रमसम्पन्ना कामगा कामरूपिणी।\nइमामवस्थां नीता त्वं केनान्तकसमागता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000215006, "chapter_id": 9215, "verse_number": "३-१९-६", "content_sanskrit": "देवगन्धर्वभूतानामृषीणां च महात्मनाम्।\nकोऽयमेवं महावीर्यस्त्वां विरूपां चकार ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000215007, "chapter_id": 9215, "verse_number": "३-१९-७", "content_sanskrit": "नहि पश्याम्यहं लोके यः कुर्यान्मम विप्रियम्।\nअमरेषु सहस्राक्षं महेन्द्रं पाकशासनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000215008, "chapter_id": 9215, "verse_number": "३-१९-८", "content_sanskrit": "अद्याहं मार्गणैः प्राणानादास्ये जीवितान्तगैः।\nसलिले क्षीरमासक्तं निष्पिबन्निव सारसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000215009, "chapter_id": 9215, "verse_number": "३-१९-९", "content_sanskrit": "निहतस्य मया संख्ये शरसंकृत्तमर्मणः।\nसफेनं रुधिरं कस्य मेदिनी पातुमिच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000215010, "chapter_id": 9215, "verse_number": "३-१९-१०", "content_sanskrit": "कस्य पत्ररथाः कायान्मांसमुत्कृत्य संगताः।\nप्रहृष्टा भक्षयिष्यन्ति निहतस्य मया रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000215011, "chapter_id": 9215, "verse_number": "३-१९-११", "content_sanskrit": "तं न देवा न गन्धर्वा न पिशाचा न राक्षसाः।\nमयापकृष्टं कृपणं शक्तास्त्रातुं महाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000215012, "chapter_id": 9215, "verse_number": "३-१९-१२", "content_sanskrit": "उपलभ्य शनैः संज्ञां तं मे शंसितुमर्हसि।\nयेन त्वं दुर्विनीतेन वने विक्रम्य निर्जिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000215013, "chapter_id": 9215, "verse_number": "३-१९-१३", "content_sanskrit": "इति भ्रातुर्वचः श्रुत्वा क्रुद्धस्य च विशेषतः।\nततः शूर्पणखा वाक्यं सबाष्पमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000215014, "chapter_id": 9215, "verse_number": "३-१९-१४", "content_sanskrit": "तरुणौ रूपसम्पन्नौ सुकुमारौ महाबलौ।\nपुण्डरीकविशालाक्षौ चीरकृष्णाजिनाम्बरौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000215015, "chapter_id": 9215, "verse_number": "३-१९-१५", "content_sanskrit": "फलमूलाशनौ दान्तौ तापसौ ब्रह्मचारिणौ।\nपुत्रौ दशरथस्यास्तां भ्रातरौ रामलक्ष्मणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000215016, "chapter_id": 9215, "verse_number": "३-१९-१६", "content_sanskrit": "गन्धर्वराजप्रतिमौ पार्थिवव्यञ्जनान्वितौ।\nदेवौ वा दानवावेतौ न तर्कयितुमुत्सहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000215017, "chapter_id": 9215, "verse_number": "३-१९-१७", "content_sanskrit": "तरुणी रूपसम्पन्ना सर्वाभरणभूषिता।\nदृष्टा तत्र मया नारी तयोर्मध्ये सुमध्यमा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000215018, "chapter_id": 9215, "verse_number": "३-१९-१८", "content_sanskrit": "ताभ्यामुभाभ्यां सम्भूय प्रमदामधिकृत्य ताम्।\nइमामवस्थां नीताहं यथानाथासती तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000215019, "chapter_id": 9215, "verse_number": "३-१९-१९", "content_sanskrit": "तस्याश्चानृजुवृत्तायास्तयोश्च हतयोरहम्।\nसफेनं पातुमिच्छामि रुधिरं रणमूर्धनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000215020, "chapter_id": 9215, "verse_number": "३-१९-२०", "content_sanskrit": "एष मे प्रथमः कामः कृतस्तत्र त्वया भवेत्।\nतस्यास्तयोश्च रुधिरं पिबेयमहमाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000215021, "chapter_id": 9215, "verse_number": "३-१९-२१", "content_sanskrit": "इति तस्यां ब्रुवाणायां चतुर्दश महाबलान्।\nव्यादिदेश खरः क्रुद्धो राक्षसानन्तकोपमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000215022, "chapter_id": 9215, "verse_number": "३-१९-२२", "content_sanskrit": "मानुषौ शस्त्रसम्पन्नौ चीरकृष्णाजिनाम्बरौ।\nप्रविष्टौ दण्डकारण्यं घोरं प्रमदया सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000215023, "chapter_id": 9215, "verse_number": "३-१९-२३", "content_sanskrit": "तौ हत्वा तां च दुर्वृत्तामुपावर्तितुमर्हथ।\nइयं च भगिनी तेषां रुधिरं मम पास्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000215024, "chapter_id": 9215, "verse_number": "३-१९-२४", "content_sanskrit": "मनोरथोऽयमिष्टोऽस्या भगिन्या मम राक्षसाः।\nशीघ्रं सम्पाद्यतां गत्वा तौ प्रमथ्य स्वतेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000215025, "chapter_id": 9215, "verse_number": "३-१९-२५", "content_sanskrit": "युष्माभिर्निहतौ दृष्ट्वा तावुभौ भ्रातरौ रणे।\nइयं प्रहृष्टा मुदिता रुधिरं युधि पास्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000215026, "chapter_id": 9215, "verse_number": "३-१९-२६", "content_sanskrit": "इति प्रतिसमादिष्टा राक्षसास्ते चतुर्दश।\nतत्र जग्मुस्तया सार्धं घना वातेरिता इव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000215027, "chapter_id": 9215, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे एकोनविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]