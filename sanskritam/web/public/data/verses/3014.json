[{"id": 2094290, "chapter_id": 3014, "verse_number": "१३-१४४-१", "content_sanskrit": "युधिष्ठिर उवाच।\nयदिदं श्राद्धकृत्येषु दीयते भरतर्षभ।\nछत्रं चोपानहौ चैव केनैतत्सम्प्रवर्तितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2094291, "chapter_id": 3014, "verse_number": "१३-१४४-२", "content_sanskrit": "कथं चैतत्समुत्पन्नं किमर्थं चैव दीयते।\nन केवलं श्राद्धकृत्ये पुण्यकेष्वपि दीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2094292, "chapter_id": 3014, "verse_number": "१३-१४४-३", "content_sanskrit": "बहुष्वपि निमित्तेषु पुण्यमाश्रित्य दीयते।\nएतद्विस्तरतो ब्रह्मञ्श्रोतुमिच्छामि तत्त्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2094293, "chapter_id": 3014, "verse_number": "१३-१४४-४x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2094294, "chapter_id": 3014, "verse_number": "१३-१४४-४", "content_sanskrit": "शृणु राजन्नवहितश्छत्रोपानहविस्तरम्।\nयथैतत्प्रथितं लोके यथा चैतत्प्रवर्तितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2094295, "chapter_id": 3014, "verse_number": "१३-१४४-५", "content_sanskrit": "यथा चाक्षय्यतां प्राप्तं पुण्यतां च यथागतम्।\nसर्वमेतदशेषेण प्रवक्ष्यामि नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2094296, "chapter_id": 3014, "verse_number": "१३-१४४-६", "content_sanskrit": "`इतिहासं पुरावृत्तमिदं शृणु नराधिप।\nजमदग्नेश्च संवादं सूर्यस्य च महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2094297, "chapter_id": 3014, "verse_number": "१३-१४४-७", "content_sanskrit": "पुरा स भगवान्साक्षाद्धनुषा क्रीडति प्रभो।\nसन्धायसन्धाय शरांश्चिक्षेप किल भार्गवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2094298, "chapter_id": 3014, "verse_number": "१३-१४४-८", "content_sanskrit": "तान्क्षिप्तान्रेणुका सर्वांस्तस्येषून्दीप्ततेजसः।\nआनीय सा तदा तस्मै प्रादादसकृदच्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2094299, "chapter_id": 3014, "verse_number": "१३-१४४-९", "content_sanskrit": "अथ तेन स शब्देनि ज्यायाश्चैव शरस्य च।\nप्रहृष्टः सम्प्रचिक्षेप सा च प्रत्याजहार तान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2094300, "chapter_id": 3014, "verse_number": "१३-१४४-१०", "content_sanskrit": "ततो मध्याह्नमारूढे ज्येष्ठामूले दिवाकरे।\nस सायकान्द्विजो मुक्त्वा रेणुकामिदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2094301, "chapter_id": 3014, "verse_number": "१३-१४४-११", "content_sanskrit": "गच्छानय विशालाक्षि शरानेतान्धनुश्च्युतान्।\nयावदेतान्पुनः सुभ्रु क्षिपामीति जनाधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2094302, "chapter_id": 3014, "verse_number": "१३-१४४-१२", "content_sanskrit": "सा गच्छन्त्यन्तरा छायां वृक्षमाश्रित्य भामिनी।\nतस्थौ तस्या हि सन्तप्तं शिरः पादौ तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2094303, "chapter_id": 3014, "verse_number": "१३-१४४-१३", "content_sanskrit": "स्थिता सा तु मूहूर्तं वै भर्तुः शापभयाच्छुभा।\nययावानयितुं भूयः सायकानसितेक्षणा।\nप्रत्याजगाम च शरांस्तानादाय यशस्विनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2094304, "chapter_id": 3014, "verse_number": "१३-१४४-१४", "content_sanskrit": "सा वै प्रस्विन्नसर्वाङ्गी पद्भ्यां दुःखं नियच्छती।\nउपाजगाम भर्तारं भयाद्भर्तुः प्रवेपती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2094305, "chapter_id": 3014, "verse_number": "१३-१४४-१५", "content_sanskrit": "स तामृषिस्तदा क्रुद्धो वाक्यमाह शुभाननाम्।\nरेणुके किं चिरेण त्वमागतेति पुनःपुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2094306, "chapter_id": 3014, "verse_number": "१३-१४४-१६x", "content_sanskrit": "रेणुकोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2094307, "chapter_id": 3014, "verse_number": "१३-१४४-१६", "content_sanskrit": "शिरस्तप्तं प्रदीप्तौ मे पादौ चैव तपोधन।\nसूर्यतेजोनिरुद्धाऽहं वृक्षच्छायां समाश्रिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2094308, "chapter_id": 3014, "verse_number": "१३-१४४-१७", "content_sanskrit": "एतस्मात्कारणाद्ब्रह्मंश्चिरायैतत्कृतं मया।\nएतच्छ्रुत्वा मम विभो मा क्रुधस्त्वं पतोधन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2094309, "chapter_id": 3014, "verse_number": "१३-१४४-१८x", "content_sanskrit": "जमदग्निरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2094310, "chapter_id": 3014, "verse_number": "१३-१४४-१८", "content_sanskrit": "अद्यैनं दीप्तकिरणं रेणुके तव दुःखदम्।\nशरैर्निपातयिष्यामि सूर्यमस्त्राग्नितेजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2094311, "chapter_id": 3014, "verse_number": "१३-१४४-१९x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2094312, "chapter_id": 3014, "verse_number": "१३-१४४-१९", "content_sanskrit": "स विष्फार्य धनुर्दिव्यं गृहीत्वा च शरान्बहूंन्।\nअतिष्ठत्सूर्यमभितो यतो याति ततोमुखः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2094313, "chapter_id": 3014, "verse_number": "१३-१४४-२०", "content_sanskrit": "अथ तं प्रेक्ष्य सन्नद्धं सूर्योऽभ्येत्य वचोऽब्रवीत्।\nद्विजरूपेण कौन्तेय किं ते सूर्योऽपराध्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2094314, "chapter_id": 3014, "verse_number": "१३-१४४-२१", "content_sanskrit": "आदत्ते रश्मिभिः सूर्यो दिवि तिष्ठंस्ततस्ततः।\nरसं हृतं वै वर्षासु प्रवर्षति दिवाकरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2094315, "chapter_id": 3014, "verse_number": "१३-१४४-२२", "content_sanskrit": "ततोऽन्नं जायते विप्र मनुष्याणां सुखावहम्।\nअन्नं प्राणा इति यथा वेदेषु परिपठ्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2094316, "chapter_id": 3014, "verse_number": "१३-१४४-२३", "content_sanskrit": "अथाऽभ्रेषु निगूढश्च रश्मिभिः परिवारितः।\nसप्तद्वीपानिमान्ब्रह्मन्वर्षेणाभिप्रवर्षति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2094317, "chapter_id": 3014, "verse_number": "१३-१४४-२४", "content_sanskrit": "ततस्तदौषधीनां च वीरुधां पुष्पपत्रजम्।\nसर्वं वर्षाभिनिर्वृत्तमन्नं सम्भवति प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2094318, "chapter_id": 3014, "verse_number": "१३-१४४-२५", "content_sanskrit": "जातकर्माणि सर्वाणि व्रतोपनयनानि च।\nगोदानानि विवाहाश्च तथा यज्ञसमृद्धयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2094319, "chapter_id": 3014, "verse_number": "१३-१४४-२६", "content_sanskrit": "सत्राणि दानानि तथा संयोगा वित्तसञ्चयाः।\nअन्नतः सम्प्रवर्तन्ते यथा त्वं वेत्थ भार्गव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2094320, "chapter_id": 3014, "verse_number": "१३-१४४-२७", "content_sanskrit": "रमणीयानि यावन्ति यावदारम्भिकाणि च।\nसर्वमन्नात्प्रभवति विदितं कीर्तयामि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2094321, "chapter_id": 3014, "verse_number": "१३-१४४-२८", "content_sanskrit": "सर्वं हि वेत्थ विप्र त्वं यदेतत्कीर्तितं मया।\nप्रसादये त्वां विप्रर्षे किं ते सूर्यो निपात्यते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2094322, "chapter_id": 3014, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि चतुश्चत्वारिंशदधिकशततमोऽध्यायः॥ १४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]