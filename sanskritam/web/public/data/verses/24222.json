[{"id": 7004222000, "chapter_id": 24222, "verse_number": "५-१-७१-१", "content_sanskrit": "व्यास उवाच ।\nभगव न्भवता सर्वं कथितं देवमूर्तिना ।\nअवंतीतीर्थमाहात्म्यं पवित्रं वेदसंमितम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004222001, "chapter_id": 24222, "verse_number": "५-१-७१-२", "content_sanskrit": "भूयस्तु श्रोतुमिच्छामि त्वत्तो ब्रह्मविदां वर ।\nमहाकालवने रम्ये अवंत्यां भुवि सत्तम ।\nतीर्थानि कतिसंख्यानि विद्यंते ह्यत्र सुव्रत॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004222002, "chapter_id": 24222, "verse_number": "५-१-७१-३", "content_sanskrit": "सनत्कुमार उवाच ।\nश्रूयतां भो द्विजश्रेष्ठ कथां पापहरां पराम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004222003, "chapter_id": 24222, "verse_number": "५-१-७१-४", "content_sanskrit": "उमामहेश्वरसंवादं नारदस्य च धीमतः ।\nनारदेन पुरा पृष्टं प्रश्नमेतद्द्विजोत्तम॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004222004, "chapter_id": 24222, "verse_number": "५-१-७१-५", "content_sanskrit": "नारद उवाच ।\nभगवञ्च्छ्रोतुमिच्छामि महाकाल वने शुभे ।\nतीर्थानि यानि वर्तंते तानि नो वद विस्तरात्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004222005, "chapter_id": 24222, "verse_number": "५-१-७१-६", "content_sanskrit": "इति पृष्टस्तदा विप्र नारदेन पुराऽनघ ।\nउवाच श्लक्ष्णया वाचा उमया सहितो हरः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004222006, "chapter_id": 24222, "verse_number": "५-१-७१-७", "content_sanskrit": "श्रीमहादेव उवाच ।\nशृणुष्व भो ऋषिश्रेष्ठ महाकालवने शुभे ।\nतीर्थानि यानि तिष्ठंति तानि वक्ष्यामि सुव्रत॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004222007, "chapter_id": 24222, "verse_number": "५-१-७१-८", "content_sanskrit": "पुष्कराद्यानि तीर्थानि यानि कानि महीतले ।\nतानि सर्वाणि वर्तंते महाकालवनोत्तमे॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004222008, "chapter_id": 24222, "verse_number": "५-१-७१-९", "content_sanskrit": "असंख्यातसहस्राणि कोटिकोटीनि सत्तम ।\nरुद्रसरे निमज्जंति कोटितीर्थं तथोच्यते॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004222009, "chapter_id": 24222, "verse_number": "५-१-७१-१०", "content_sanskrit": "नीहारकणिकावृष्टिं गिरौ वर्षंति किन्नराः ।\nहेमंते चैव दृश्यंते तीर्थे पैशाचमोचने॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004222010, "chapter_id": 24222, "verse_number": "५-१-७१-११", "content_sanskrit": "न हि संख्यां विजानामि तीर्थानां भुवि सत्तम ।\nकियन्ति संति तीर्थानि लिंगानि च तथैव च॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004222011, "chapter_id": 24222, "verse_number": "५-१-७१-१२", "content_sanskrit": "तथाऽपि च प्राधान्येन कथयिष्यामि सत्तम ।\nसंवत्सरस्य यावंति अहानि च द्विजोत्तम॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004222012, "chapter_id": 24222, "verse_number": "५-१-७१-१३", "content_sanskrit": "तावंति प्रापणीयानि प्रसिद्धानि परंतप ।\nवत्सरे परिपूर्णे च जायतेऽवंतियात्रिका॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004222013, "chapter_id": 24222, "verse_number": "५-१-७१-१४", "content_sanskrit": "विधिवत्कुरुते यस्तु साक्षाच्छंभुर्भवेच्च सः ।\nमन्वंतरसहस्रेषु काशीवासे च यत्फलम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004222014, "chapter_id": 24222, "verse_number": "५-१-७१-१५", "content_sanskrit": "तत्फलं जायतेऽवंत्यां वैशाखे पंचभिर्दिनैः ।\nअवंती यात्रा कर्तव्या प्रयत्नेन मुमुक्षुणा॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004222015, "chapter_id": 24222, "verse_number": "५-१-७१-१६", "content_sanskrit": "माधवेऽपि विशेषेण ह्यवंतीस्नानमाचरेत् ।\nयो हि वैशाखमासाद्य अवंत्यां व्यास मानवः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004222016, "chapter_id": 24222, "verse_number": "५-१-७१-१७", "content_sanskrit": "संवत्सरव्रती स्नातस्तीर्थेतींर्थे यथाविधि ।\nदत्त्वा दानानि सर्वाणि समूलं फलमश्नुते॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004222017, "chapter_id": 24222, "verse_number": "५-१-७१-१८", "content_sanskrit": "भुक्त्वा भोगान्सुविपुलाञ्छिवलोके महीयते॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004222018, "chapter_id": 24222, "verse_number": "५-१-७१-१९", "content_sanskrit": "माहात्म्यमेतच्छिवभक्तिवर्द्धनं यशस्करं पुण्यविवर्द्धनं च ।\nयः श्रावयेद्वा शृणुयाच्च भक्त्या कुलं समुद्धृत्य हरः पदं व्रजेत्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]