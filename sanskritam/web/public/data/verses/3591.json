[{"id": 2120993, "chapter_id": 3591, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2120994, "chapter_id": 3591, "verse_number": "१", "content_sanskrit": "ततः समुदिता मुख्यैर्गुणैर्गुणवतां वराः ।\nबहवो भावितात्मानः पृथक् पृथगरिन्दम\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2120995, "chapter_id": 3591, "verse_number": "२", "content_sanskrit": "आत्मकृत्यमिति ज्ञात्वा पाञ्चालास्तत्र सर्वशः ।\nसमीयुर्वृष्णयश्चैव तदानीं कार्यकारिणः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2120996, "chapter_id": 3591, "verse_number": "३", "content_sanskrit": "सदाराः सजनामात्या वहन्तो रत्नसञ्चयान् ।\nविकृष्टत्वाच्च देशस्य गुरुभारतयैव ते ।\nययुः प्रमुदिताः पश्चाद् राजभिर्न समं ययुः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2120997, "chapter_id": 3591, "verse_number": "४", "content_sanskrit": "भगवान् सर्वभूतानां भास्यन्नमिततेजसा ।\nविशन्नन्तर्यज्ञभूमिं सितस्यावरजो विभुः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2120998, "chapter_id": 3591, "verse_number": "५", "content_sanskrit": "तेजोराशिमृषिं दृश्यमदृश्यमविजानताम् ।\nवयोतिगानां वृद्धानां मार्गमावृत्य तिष्ठताम् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2120999, "chapter_id": 3591, "verse_number": "६", "content_sanskrit": "जगतस्तस्थुषश्चैव प्रभवाप्ययमच्युतम् ।\nअनन्तमन्तं शत्रूणाममित्रगणमर्दनम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2121000, "chapter_id": 3591, "verse_number": "७", "content_sanskrit": "प्रभवं सर्वभूतानामापत्स्वाश्रयमच्युतम् ।\nभविष्यं भावनं भूतं द्वारवत्यामरिन्दमम् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2121001, "chapter_id": 3591, "verse_number": "८", "content_sanskrit": "ऋजुं चक्रायुधं शौरिममित्रगणमर्दनम् ।\nबलाधिकारं निक्षिप्य सम्मान्यानकदुन्दुभिम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2121002, "chapter_id": 3591, "verse_number": "९", "content_sanskrit": "बलशेषं समुदितं परिगृह्य समन्ततः ।\nसम्प्रायाद् यादवश्रेष्ठो यजमाने युधिष्ठिरे\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2121003, "chapter_id": 3591, "verse_number": "१०", "content_sanskrit": "उच्चावचमुपादाय धर्मराजाय माधवः ।\nधनौघं पुरतः कृत्वा खाण्डवप्रस्थमाययौ\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2121004, "chapter_id": 3591, "verse_number": "११", "content_sanskrit": "तत्र यज्ञागतान् सर्वान् चैद्यवक्रपुरोगमान् ।\nभूमिपालगणान् सर्वान् सप्रभानिव तोयदान्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2121005, "chapter_id": 3591, "verse_number": "१२", "content_sanskrit": "मेघकायान् निश्श्वसतो यूथपानिव यूथपः ।\nबलिनः सिंहसङ्काशान् महीमावृत्य तिष्ठतः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2121006, "chapter_id": 3591, "verse_number": "१३", "content_sanskrit": "ततो रत्नौघसम्बाधं राजसागरमव्ययम् ।\nनादयन् रथघोषेणाभ्युपायान्मधुसूदनः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2121007, "chapter_id": 3591, "verse_number": "१४", "content_sanskrit": "असूर्यमिव सूर्येण निवातमिव वायुना ।\nकृष्णेन समवेतेन जहर्षे भारतं पुरम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2121008, "chapter_id": 3591, "verse_number": "१५", "content_sanskrit": "ब्राह्मणक्षत्रियाणां हि पूजार्थं ह्यर्थधर्मवित् ।\nसहदेवो विशेषज्ञो माद्रीपुत्रः कृतोऽभवत्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2121009, "chapter_id": 3591, "verse_number": "१६", "content_sanskrit": "स दृष्ट्वा विष्णुमायान्तं प्रतिपूज्यामितौजसम् ।\nयथार्हं केशवे वृत्तिं प्रत्यपद्यत पाण्डवः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2121010, "chapter_id": 3591, "verse_number": "१७", "content_sanskrit": "ज्यैष्ठ्यकानिष्ठ्यसंयोगं सम्प्रधार्य गुणागुणैः ।\nआरिराधयिषुर्धर्मः पूजयित्वा द्विजोत्तमान् ।\nमहदादित्यसङ्काशमासनं च जगत्पतेः ।\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2121011, "chapter_id": 3591, "verse_number": "१८", "content_sanskrit": "ततो भीष्मोऽब्रवीद् राजन् धर्मराजं युधिष्ठिरम् ।\nक्रियतामर्हणं राज्ञां यथार्हमिह भारत\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2121012, "chapter_id": 3591, "verse_number": "१९", "content_sanskrit": "आचार्यमृत्विजं चैव संयुक्तं तु युधिष्ठिर ।\nस्नातकं च प्रियं चाहुः षडर्घार्हान् नृपं तथा\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2121013, "chapter_id": 3591, "verse_number": "२०", "content_sanskrit": "एतानर्हानधिगतान् बहुसंवत्सरोषितान्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2121014, "chapter_id": 3591, "verse_number": "२१", "content_sanskrit": "त इमे कालपूगस्य महतोऽस्मानुपागताः ।\nएषामेकैकशो राजन्नर्घ्यमानीयतामिति ।\nअथ चैषां वरिष्ठो यस्तस्यार्घमुपकल्प्यताम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2121015, "chapter_id": 3591, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2121016, "chapter_id": 3591, "verse_number": "२२", "content_sanskrit": "कस्मै भवान् मन्यतेर्घ्यमेकस्मै कुरुनन्दन ।\nआनीयमानं युक्तं च तन्मे ब्रूहि पितामह\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2121017, "chapter_id": 3591, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2121018, "chapter_id": 3591, "verse_number": "२३", "content_sanskrit": "ततो भीष्मः शान्तनवो बुद्ध्या निश्चित्य भारत ।\nवार्ष्णेयं मन्यते कृष्णमर्हणीयमरिन्दम\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2121019, "chapter_id": 3591, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2121020, "chapter_id": 3591, "verse_number": "२४", "content_sanskrit": "एष ह्येषां समेतानां तेजोबलपराक्रमैः ।\nमध्ये तपन्निवाभाति ज्योतिषां रविरंशुमान्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2121021, "chapter_id": 3591, "verse_number": "२५", "content_sanskrit": "असूर्यमिव सूर्येण निवातमिव वायुना ।\nभासितं ह्लादितं चैव कृष्णेनेदं सदो हि नः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2121022, "chapter_id": 3591, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2121023, "chapter_id": 3591, "verse_number": "२६", "content_sanskrit": "तस्मै भीष्माभ्यनुज्ञातः सहदेवः प्रतापवान् ।\nउपजह्रे च विधिवद् वार्ष्णेयायार्घ्यमुत्तमम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2121024, "chapter_id": 3591, "verse_number": "२७", "content_sanskrit": "गामर्घ्यं मधुपर्कं च ह्यानीयोपाहरत् तदा ।\nचरणावस्पृशन्नाम्ना सहदेवो विशाम्पते\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2121025, "chapter_id": 3591, "verse_number": "२८", "content_sanskrit": "केशवश्चाप्युपाघ्राय मूर्ध्नि शास्त्रविदां वरः ।\nसहदेवमथोवाच कच्चिद्वः कुशलं गृहे \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2121026, "chapter_id": 3591, "verse_number": "२९", "content_sanskrit": "तां दृष्ट्वा क्षत्रियाः सर्वे पूजां कृष्णस्य भूयसीम् ।\nसम्प्रेक्ष्यान्योन्यमासीना हृदयैस्तामधारयन्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2121027, "chapter_id": 3591, "verse_number": "३०", "content_sanskrit": "प्रतिजग्राह तां कृष्णः शास्त्रदृष्टेन कर्मणा ।\nशिशुपालस्तु तां पूजां वासुदेवे न चक्षमे\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2121028, "chapter_id": 3591, "verse_number": "३१", "content_sanskrit": "उपालभ्य स भीष्मं च धर्मराजं च संसदि ।\nअवाक्षिपद् वासुदेवं चेदिराजो महाबलः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2121029, "chapter_id": 3591, "verse_number": "३२", "content_sanskrit": "तेषामाकारभावज्ञः सहदेवो न चक्षमे ।\nमानिनां बलिनां राज्ञां पुरस्सन्दर्शिते पदे ।\nपुष्पवृष्टिर्महत्यासीत् सहदेवस्य मूर्धनि\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2121030, "chapter_id": 3591, "verse_number": "३३", "content_sanskrit": "जन्मप्रभृति वृष्णीनां सुनीथः शत्रुरब्रवीत् ।\nप्रष्टा वियोनिजो राजा प्रतिवक्ता नदीसुतः ।\nप्रतिग्रहीता गोपालः प्रदाता च वियोनिजः ।\nसदस्या मूकवत् सर्वे आसतेऽत्र किमुच्यते\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2121031, "chapter_id": 3591, "verse_number": "३४", "content_sanskrit": "अति पश्यसि वा सर्वान् न वा पश्यसि पाण्डव ।\nसत्स्वेवान्येषु पूज्येषु कृष्णं नार्चितुमर्हसि\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2121032, "chapter_id": 3591, "verse_number": "३५", "content_sanskrit": "एते चैवोभये तात कार्यस्य तु विनाशके ।\nअतिदृष्टिरदृष्टिर्वा तयोः किं त्वं समास्थितः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2121033, "chapter_id": 3591, "verse_number": "२", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nसभापर्वणि त्रयस्त्रिंशोऽध्यायः ॥३३॥ ॥ अर्घाभिहरणपर्वणि द्वितीयोऽध्यायः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2121034, "chapter_id": 3591, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]