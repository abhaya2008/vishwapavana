[{"id": 2134217, "chapter_id": 3898, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2134218, "chapter_id": 3898, "verse_number": "१", "content_sanskrit": "श्रिया जुष्टं महासेनं देवसेनापतिं कृतम् ।\nसप्तर्षिपत्न्यः षड्देव्यस्तत्सकाशमथागमन् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2134219, "chapter_id": 3898, "verse_number": "२", "content_sanskrit": "ऋषिभिः सम्परित्यक्ता धर्मयुक्ता महाव्रताः ।\nद्रुतमागम्य चोचुस्ता देवसेनापतिं प्रभुम् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2134220, "chapter_id": 3898, "verse_number": "", "content_sanskrit": "देव्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2134221, "chapter_id": 3898, "verse_number": "३", "content_sanskrit": "वयं पुत्र परित्यक्ता भर्तृभिर्देवसम्मितैः ।\nअकारणाद् रुषा तैस्तु पुण्यस्थानात् परिच्युताः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2134222, "chapter_id": 3898, "verse_number": "४", "content_sanskrit": "अस्माभिः किल जातस्त्वमिति केनाप्युदाहृतम् ।\nतत् सत्यमेतत् संश्रुत्य तस्मान्नस्त्रातुमर्हसि \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2134223, "chapter_id": 3898, "verse_number": "५", "content_sanskrit": "अक्षयश्च भवेत् स्वर्गस्त्वत्प्रसादाद्धि नः प्रभो ।\nत्वां पुत्रं चाप्यभीप्सामः कृत्वैतदनृणो भव \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2134224, "chapter_id": 3898, "verse_number": "", "content_sanskrit": "स्कन्दः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2134225, "chapter_id": 3898, "verse_number": "६", "content_sanskrit": "मातरो हि भवत्यो मे सुतो वोऽहमनिन्दिताः ।\nयद्वापीच्छत तत्सर्वं सम्भविष्यति वस्तथा \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2134226, "chapter_id": 3898, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2134227, "chapter_id": 3898, "verse_number": "७", "content_sanskrit": "एवमुक्ते ततः शक्रं किं कार्यमिति सोऽब्रवीत् ।\nउक्तः स्कन्देन ब्रूहीति सोऽब्रवीत् वासवस्ततः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2134228, "chapter_id": 3898, "verse_number": "८", "content_sanskrit": "अभिजित् स्पर्धमाना तु रोहिण्या कन्यसी स्वसा ।\nइच्छन्ती ज्येष्ठतां देवी तपस्तप्तुं वनं गता \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2134229, "chapter_id": 3898, "verse_number": "९", "content_sanskrit": "तत्र मूढोऽस्मि भद्रं ते नक्षत्रं गगनाच्च्युतम् ।\nकालं त्विमं परं स्कन्द ब्रह्मणा सह चिन्तय \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2134230, "chapter_id": 3898, "verse_number": "१०", "content_sanskrit": "धनिष्ठादिस्तदा कालो ब्रह्मणा परिकीर्तितः ।\nरोहिणी ह्यभवत् पूर्वमेवं सङ्ख्या समाभवत् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2134231, "chapter_id": 3898, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2134232, "chapter_id": 3898, "verse_number": "११", "content_sanskrit": "एवमुक्ते तु शक्रेण त्रिदिवं कृत्तिकागता ।\nनक्षत्र शकटाकारं भाति तद् वह्निदैवतम् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2134233, "chapter_id": 3898, "verse_number": "१२", "content_sanskrit": "विनता चाब्रवीत् स्कन्दं मम त्वं पिण्डदः सुतः ।\nइच्छामि नित्यमेवाहं त्वया पुत्र सहासितुम् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2134234, "chapter_id": 3898, "verse_number": "", "content_sanskrit": "स्कन्दः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2134235, "chapter_id": 3898, "verse_number": "१३", "content_sanskrit": "एवमस्तु नमस्तेऽस्तु पुत्रस्नेहात् प्रशाधि माम् ।\nस्नुषया पूज्यमाना वै देवि वत्स्यसि नित्यदा \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2134236, "chapter_id": 3898, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2134237, "chapter_id": 3898, "verse_number": "१४", "content_sanskrit": "अथ मातृगणः सर्वः स्कन्दं वचनमब्रवीत् ।\nवयं सर्वस्य लोकस्य मातरः कविभिः स्तुताः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2134238, "chapter_id": 3898, "verse_number": "१५", "content_sanskrit": "इच्छाम मातरस्तुभ्यं भवितुं पूजयस्व नः ।\nतासां तु वचनं श्रुत्वा स्कन्दो वचनमब्रवीत् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2134239, "chapter_id": 3898, "verse_number": "१६", "content_sanskrit": "मातरो हि भवत्यो मे भवतीनामहं सुतः ।\nउच्यतां यन्मया कार्यं भवतीनामथेप्सितम् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2134240, "chapter_id": 3898, "verse_number": "", "content_sanskrit": "मातरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2134241, "chapter_id": 3898, "verse_number": "१७", "content_sanskrit": "यास्तु ता मातरः पूर्वं लोकस्यास्य प्रकल्पिताः ।\nअस्माकं तु भवेत् स्थानं तासां चैव न तद् भवेत् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2134242, "chapter_id": 3898, "verse_number": "१८", "content_sanskrit": "भवेम पूज्या लोकस्य न ताः पूज्याः सुरर्षभ ।\nअस्मत्प्रजा हृतास्ताभिस्त्वत्कृते ताः प्रयच्छ नः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2134243, "chapter_id": 3898, "verse_number": "", "content_sanskrit": "स्कन्दः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2134244, "chapter_id": 3898, "verse_number": "१९", "content_sanskrit": "दत्ताः प्रजा न ताः शक्या भवतीभिर्निषेवितुम् ।\nअन्यां वः कां प्रयच्छामि प्रजां यां मनसेच्छथ \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2134245, "chapter_id": 3898, "verse_number": "", "content_sanskrit": "मातरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2134246, "chapter_id": 3898, "verse_number": "२०", "content_sanskrit": "इच्छाम तासां मातॄणां प्रजा भोक्तुं प्रयच्छ नः ।\nत्वया सह पृथग्भूता ये च तासामधीश्वराः \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2134247, "chapter_id": 3898, "verse_number": "", "content_sanskrit": "स्कन्दः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2134248, "chapter_id": 3898, "verse_number": "२१", "content_sanskrit": "प्रजा वो दद्मि कष्टं तु भवतीभिरुदाहृतम् ।\nपरिरक्षत भद्रं वः प्रजाः साधु नमस्कृताः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2134249, "chapter_id": 3898, "verse_number": "", "content_sanskrit": "मातरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2134250, "chapter_id": 3898, "verse_number": "२२", "content_sanskrit": "परिरक्षाम भद्रं ते प्रजाः स्कन्द यथे(दी)च्छसि ।\nत्वया नो रोचते स्कन्द सहवासश्चिरं प्रभो \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2134251, "chapter_id": 3898, "verse_number": "", "content_sanskrit": "स्कन्दः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2134252, "chapter_id": 3898, "verse_number": "२३", "content_sanskrit": "यावत् षोडश वर्षाणि भवन्ति तरुणाः प्रजाः ।\nप्रबाधत मनुष्याणां तावद् रूपैः पृथग्विधैः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2134253, "chapter_id": 3898, "verse_number": "२४", "content_sanskrit": "अहं च वः प्रदास्यामि रौद्रमात्मानमव्ययम् ।\nपरमं तेन सहिताः सुखं वत्स्यथ पूजिताः\t ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2134254, "chapter_id": 3898, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2134255, "chapter_id": 3898, "verse_number": "२५", "content_sanskrit": "ततः शरीरात् स्कन्दस्य पुरुषः पावकप्रभः ।\nभोक्तुं प्रजाः स मर्त्यानां निष्पपात महाप्रभः \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2134256, "chapter_id": 3898, "verse_number": "२६", "content_sanskrit": "अपतत् सहसा भूमौ विसञ्ज्ञोऽथ क्षुधाऽर्दितः ।\nस्कन्देन सोऽभ्यनुज्ञातो रौद्ररूपोऽभवद् ग्रहः \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2134257, "chapter_id": 3898, "verse_number": "२७", "content_sanskrit": "स्कन्दापस्मारमित्याहुर्ग्रहं तं द्विजसत्तमाः ।\nविनता तु महारौद्रा कथ्यते शकुनिग्रहः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2134258, "chapter_id": 3898, "verse_number": "२८", "content_sanskrit": "पूतनां राक्षसीं प्राहुस्तं विद्यात् पूतनाग्रहम् ।\nकष्टा दारुणरूपेण घोररूपा निशाचरी \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2134259, "chapter_id": 3898, "verse_number": "२९", "content_sanskrit": "पिशाची दारुणाकारा कथ्यते शीतपूतना ।\nगर्भान् सा मानुषीणां तु हरते घोरदर्शना \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2134260, "chapter_id": 3898, "verse_number": "३०", "content_sanskrit": "अदितिं रेवतीं प्राहुर्ग्रहस्तस्यास्तु रैवतः ।\nसोऽपि बालान् महाघोरो बाधते वै महाप्रभः \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2134261, "chapter_id": 3898, "verse_number": "३१", "content_sanskrit": "दैत्यानां या दितिर्माता तामाहुर्मुखमण्डिकाम् ।\nअत्यर्थं शिशुमांसेन सम्प्रहृष्टा दुरासदा \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2134262, "chapter_id": 3898, "verse_number": "३२", "content_sanskrit": "कुमाराश्च कुमार्यश्च ये प्रोक्ताः स्कन्दसम्भवाः ।\nतेऽपि गर्भभुजः सर्वे कौरव्य सुमहाग्रहाः \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2134263, "chapter_id": 3898, "verse_number": "३३", "content_sanskrit": "तासामेव तु पत्नीनां पतयस्ते प्रकीर्तिताः ।\nआजायमानान् गृह्णन्ति बालकान् रौद्रकर्मिणः \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2134264, "chapter_id": 3898, "verse_number": "३४", "content_sanskrit": "गवां माता तु या प्राज्ञैः कथ्यते सुरभिर्नृप ।\nशकुनिस्तामथारुह्य सह भुङ्क्ते शिशून् भुवि \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2134265, "chapter_id": 3898, "verse_number": "३५", "content_sanskrit": "सरमा नाम या माता शुनां देवी जनाधिप।\nसाऽपि गर्भान् समादत्ते मानुषीणां सदैव हि \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2134266, "chapter_id": 3898, "verse_number": "३६", "content_sanskrit": "पादपानां च या माता करञ्जनिलया हि सा ।\nवरदा सा हि सौम्या च नित्यं भूतानुकम्पिनी \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2134267, "chapter_id": 3898, "verse_number": "३७", "content_sanskrit": "करञ्जे तां नमस्यन्ति तस्मात्पुत्रार्थिनो नराः ।\nइमे त्वष्टादशान्ये वै ग्रहा मांसमधुप्रियाः \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2134268, "chapter_id": 3898, "verse_number": "३८", "content_sanskrit": "द्विपञ्चरात्रं तिष्ठन्ति सततं सूतिकाग्रहे \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2134269, "chapter_id": 3898, "verse_number": "३९", "content_sanskrit": "कद्रूः सूक्ष्मवपुर्भूत्वा गर्भिणीं प्रविशेत् तदा ।\nभुङ्क्ते सा तत्र तं गर्भं सा तु नागं प्रसूयते \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2134270, "chapter_id": 3898, "verse_number": "४०", "content_sanskrit": "गन्धर्वाणां तु या माता सा गर्भं गृह्य गच्छति ।\nअज्ञातहारिणी या तु सा गर्भं विशति प्रभो ।\nततो विलीनगर्भा सा मानुषी भुवि दृश्यते \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2134271, "chapter_id": 3898, "verse_number": "४१", "content_sanskrit": "या जनित्री त्वप्सरसां गर्भमास्ते प्रगृह्य सा।\nउपनष्टं ततो गर्भं कथयन्ति मनीषिणः \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2134272, "chapter_id": 3898, "verse_number": "४२", "content_sanskrit": "लोहितस्योदधेः कन्या धात्री स्कन्दस्य सा स्मृता ।\nलोहितायनिरित्येवं कदम्बे सा हि पूज्यते \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2134273, "chapter_id": 3898, "verse_number": "४३", "content_sanskrit": "पुरुषेषु यथा रुद्रस्तथाऽऽर्या प्रमदास्वपि ।\nआर्या माता कुमारस्य पृथक्कार्यार्थमिज्यते \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2134274, "chapter_id": 3898, "verse_number": "४४", "content_sanskrit": "एवमेते कुमाराणां मया प्रोक्ता महाग्रहाः ।\nयावत् षोडश वर्षाणि शिशूनां ह्यशिवास्तदा\t ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2134275, "chapter_id": 3898, "verse_number": "४५", "content_sanskrit": "ये च मातृगणाः प्रोक्ताः पुरुषाश्चैव ये ग्रहाः ।\nसर्वे स्कन्दग्रहा नाम ज्ञेया नित्यं शरीरिभिः \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2134276, "chapter_id": 3898, "verse_number": "४६", "content_sanskrit": "तेषां प्रशमनं कार्यं स्नानं धूपमथाञ्ज(र्च)नम् ।\nबलिकर्मोपहाराश्च स्कन्दस्येज्याविशेषतः \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2134277, "chapter_id": 3898, "verse_number": "४७", "content_sanskrit": "एवमभ्यर्चिताः सर्वे प्रयच्छन्ति शुभं नृणाम् ।\nआयुर्वीर्यं च राजेन्द्र सम्यक्पूजानमस्कृताः \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2134278, "chapter_id": 3898, "verse_number": "४८", "content_sanskrit": "ऊर्ध्वं तु षोडशाद् वर्षाद् ये भवन्ति ग्रहा नृणाम् ।\nतानहं सम्प्रवक्ष्यामि नमस्कृत्य महेश्वरम्\t ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2134279, "chapter_id": 3898, "verse_number": "४९", "content_sanskrit": "यः पश्यति नरो देवान् जाग्रद्वा शयितोऽपि वा ।\nउन्माद्यति स तु क्षिप्रं तं तु देवग्रहं विदुः \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2134280, "chapter_id": 3898, "verse_number": "५०", "content_sanskrit": "आसीनश्च शयानश्च यः पश्यति नरः पितॄन् ।\nउन्माद्यति स तु क्षिप्रं स ज्ञेयस्तु पितृग्रहः \t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2134281, "chapter_id": 3898, "verse_number": "५१", "content_sanskrit": "अवमन्यति यः सिद्धान् क्रुद्ध्यत्यभिशपत्यपि ।\nउन्माद्यति स तु क्षिप्रं ज्ञेयः सिद्धग्रहस्तु सः \t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2134282, "chapter_id": 3898, "verse_number": "५२", "content_sanskrit": "यस्य दोषैः प्रकुपितं चित्तं मुह्यति देहिनः ।\nउपघ्राति च यो गन्धान् रसांश्चापि पृथग्विधान् ।\nउन्माद्यति स तु क्षिप्रं स ज्ञेयो राक्षसो ग्रहः \t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2134283, "chapter_id": 3898, "verse_number": "५३", "content_sanskrit": "गन्धर्वाश्चापि यं दिव्याः संविशन्ति नरं भुवि ।\nउन्माद्यति स तु क्षिप्रं ग्रहो गान्धर्व एव सः \t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2134284, "chapter_id": 3898, "verse_number": "५४", "content_sanskrit": "अधिरोहन्ति यं नित्यं पिशाचाः पुरुषं क्वचित् ।\nउन्माद्यति स तु क्षिप्रं ग्रहः पैशाच एव सः \t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2134285, "chapter_id": 3898, "verse_number": "५५", "content_sanskrit": "आविशन्ति च यं यक्षाः पुरुषं कालपर्यये ।\nउन्माद्यति स तु क्षिप्रं ज्ञेयो यक्षग्रहस्तु सः \t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2134286, "chapter_id": 3898, "verse_number": "५६", "content_sanskrit": "यस्य दोषैः प्रकुपितं चित्तं मुह्यति देहिनः ।\nउन्माद्यति स तु क्षिप्रं साधनं तस्य शास्त्रतः \t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2134287, "chapter_id": 3898, "verse_number": "५७", "content_sanskrit": "वैक्लव्याच्च भयाच्चैव घोराणां चापि दर्शनात् ।\nउन्माद्यति स तु क्षिप्रं सत्वं तस्य तु साधनम् \t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2134288, "chapter_id": 3898, "verse_number": "५८", "content_sanskrit": "कश्चित् क्रीडितुकामो वै भोक्तुकामस्तथाऽपरः ।\nअभिकामस्तथैवान्य इत्येष त्रिविधो ग्रहः \t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2134289, "chapter_id": 3898, "verse_number": "५९", "content_sanskrit": "यावत् सप्ततिवर्षाणि भवन्त्येते ग्रहा नृणाम् ।\nअतः परं देहिनां तु ग्रहतुल्यो भवेज्ज्वरः \t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2134290, "chapter_id": 3898, "verse_number": "६०", "content_sanskrit": "अप्रकीर्णेन्द्रियं दान्तं शुचिं नित्यमतन्द्रितम् ।\nआस्तिकं श्रद्दधानं च वर्जयन्ति सदा ग्रहाः \t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2134291, "chapter_id": 3898, "verse_number": "६१", "content_sanskrit": "इत्येष ते ग्रहोद्देशो मानुषाणां प्रकीर्तितः ।\nन स्पृशन्ति ग्रहा भक्तान् नरान् देवे महेश्वरे \t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2134292, "chapter_id": 3898, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि एकोनविंशाधिकद्विशततमोऽध्यायः ॥२१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2134293, "chapter_id": 3898, "verse_number": "", "content_sanskrit": "॥ मार्कण्डेयसमास्यापर्वणि आङ्गिरसे स्कन्दोपाख्याने चतुश्चत्वारिंशोऽध्यायः ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}]