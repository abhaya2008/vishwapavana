[{"id": 2059943, "chapter_id": 2284, "verse_number": "८-५-०x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2059944, "chapter_id": 2284, "verse_number": "८-५-१", "content_sanskrit": "श्रुत्वा कर्णं हतं युद्वे पुत्रांश्चैव पलायिनः।\nनरेन्द्रः किञ्चिदाश्वस्तो द्विजश्रेष्ठ किमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2059945, "chapter_id": 2284, "verse_number": "८-५-२", "content_sanskrit": "प्राप्तवान्परमं दुःखं पुत्रव्यसनजं महत्।\nतस्मिन्यदुक्तवान्काले तन्ममाचक्ष्व पृच्छतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2059946, "chapter_id": 2284, "verse_number": "८-५-३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2059947, "chapter_id": 2284, "verse_number": "८-५-३", "content_sanskrit": "श्रुत्वा कर्णस्य निधनमश्रद्वेयमिवाद्भुतम्।\nभूतसम्मोहनं भीमं मेरोः संसर्पणं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2059948, "chapter_id": 2284, "verse_number": "८-५-४", "content_sanskrit": "चित्तमोहमिवायुक्तं भार्गवस्य महामतेः।\nपराजयमिवेन्द्रस्य द्विषद्ध्यो भीमकर्मणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2059949, "chapter_id": 2284, "verse_number": "८-५-५", "content_sanskrit": "दिवः प्रपतनं भानोरुरव्यामिव महाद्युतेः।\nसंशोषणमिवाचिन्त्यं समुद्रस्याक्षयाम्भसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2059950, "chapter_id": 2284, "verse_number": "८-५-६", "content_sanskrit": "महीवियद्दिगम्बूनां सर्वनाशमिवाद्भुतम्।\nकर्मणोरिव वैफल्यमुभयोः पुण्यपापयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2059951, "chapter_id": 2284, "verse_number": "८-५-७", "content_sanskrit": "सञ्चिन्त्य निपुणं बुद्ध्या धृतराष्ट्रो जनेश्वरः।\nनेदमस्तीति सञ्चिन्त्य कर्णस्य समरे वधम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2059952, "chapter_id": 2284, "verse_number": "८-५-८", "content_sanskrit": "प्राणिनामेवमात्मत्वात्स्यादपीति विचार्य च।\nशोकाग्निना दह्यमानो धम्यमान इवाशये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2059953, "chapter_id": 2284, "verse_number": "८-५-९", "content_sanskrit": "विस्रस्ताङ्गः श्वसन्दीनो हाहेत्युक्त्वा सुदुःखितः।\nविललाप महाराज धृतराष्ट्रोऽम्बिकासुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2059954, "chapter_id": 2284, "verse_number": "८-५-१०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2059955, "chapter_id": 2284, "verse_number": "८-५-१०", "content_sanskrit": "सञ्जयाधिरथिर्वीरः सिंहद्विरदविक्रमः।\nवृषभप्रतिमस्कन्धो वृषभाक्षगतिस्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2059956, "chapter_id": 2284, "verse_number": "८-५-११", "content_sanskrit": "वृषभो वृषभस्येव यो युद्धे न निवर्तते।\nशत्रोरपि महेन्द्रस्य वज्रसंहननो युवा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2059957, "chapter_id": 2284, "verse_number": "८-५-१२", "content_sanskrit": "यस्य ज्यातलशब्देन शरवृष्टिरवेण च।\nरथाश्वनरमातङ्गा नावतिष्ठन्ति संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2059958, "chapter_id": 2284, "verse_number": "८-५-१३", "content_sanskrit": "यमाश्रित्य महाबाहुं द्विषत्सङ्घघ्नमच्युतम्।\nदुर्योधनोऽकरोद्वैरं पाण्डुपुत्रैर्महारथैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2059959, "chapter_id": 2284, "verse_number": "८-५-१४", "content_sanskrit": "स कथं रथिनां श्रेष्ठः कर्णः पार्थेन संयुगे।\nनिहतः पुरुषव्याघ्रः प्रसह्यासह्यविक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2059960, "chapter_id": 2284, "verse_number": "८-५-१५", "content_sanskrit": "यो नामन्यत वै नित्यमच्युतं च धनञ्जयम्।\nन वृष्मीन्सहितानन्यान्स्वबाहुबलदर्पितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2059961, "chapter_id": 2284, "verse_number": "८-५-१६", "content_sanskrit": "शार्ङ्गगाण्डीवधन्वानौ सहितावपराजितौ।\nअहं दिव्याद्रथादेकः पातयिष्यामि संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2059962, "chapter_id": 2284, "verse_number": "८-५-१७", "content_sanskrit": "इति यः सततं मन्दमवोचल्लोभमोहितम्।\nदुर्योधनमवाचीनं राज्यकामुकमातुरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2059963, "chapter_id": 2284, "verse_number": "८-५-१८", "content_sanskrit": "योऽजयत्सर्वकाम्भोजानावन्त्यान्केकयैः सह।\nगान्धारान्मद्रकान्मात्स्यांस्त्रिगर्तांस्तङ्कणाञ्शकान्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2059964, "chapter_id": 2284, "verse_number": "८-५-१९", "content_sanskrit": "पाञ्चालांश्च विदेहांश्च कुलिन्दान्काशिकोसलान्\nसूह्मानङ्गांश्च वङ्गांश्च निषादान्पुण्ड्रकीकटान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2059965, "chapter_id": 2284, "verse_number": "८-५-२०", "content_sanskrit": "वत्सान्कलिङ्गान्दरदानश्मकानृषिकानपि।\n`शबरान्हारहूणांश्च प्रघूणान्सरलानपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2059966, "chapter_id": 2284, "verse_number": "८-५-२१", "content_sanskrit": "म्लेच्छराष्ट्राधिपांश्चैव दुर्गानाटविकांस्तथा।\nजित्वैतान्समरे वीरः प्रदीप्तैः कङ्कपत्रिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2059967, "chapter_id": 2284, "verse_number": "८-५-२२", "content_sanskrit": "करमाहारयामास जित्वा सर्वानरींस्तथा।\nदुर्योधनस्य वृद्ध्यर्थं राधेयो रथिनां वरः।\nदिव्यास्त्रविमन्हातेजाः कर्णो वैकर्तनो वृषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2059968, "chapter_id": 2284, "verse_number": "८-५-२३", "content_sanskrit": "सेनागोपश्च स कथं शत्रुभिः परमास्त्रवित्।\nघातितः पाण्डवैः शूरैः समरे वीर्यशालिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2059969, "chapter_id": 2284, "verse_number": "८-५-२४", "content_sanskrit": "वृषो महेन्द्रो देवेषु वृषः कर्णो नरेष्वपि।\nतृतीयमन्यं लोकेषु वृषं नैवानुशुश्रुम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2059970, "chapter_id": 2284, "verse_number": "८-५-२५", "content_sanskrit": "उच्चैः श्रवा वरोऽश्वानां राज्ञां वैश्रवणो वरः।\nवरो महेन्द्रो देवानां कर्णः प्रहरतां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2059971, "chapter_id": 2284, "verse_number": "८-५-२६", "content_sanskrit": "योऽजितः पार्थिवैः शूरैः समर्थैर्वीर्यशालिभिः।\nदुर्योधनस्य वृद्ध्यर्थं कृत्स्नामुर्वीमथाजयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2059972, "chapter_id": 2284, "verse_number": "८-५-२७", "content_sanskrit": "यं लब्ध्वा मागधो राजा सांत्वमानोऽथ सौहृदैः।\nअरौत्सीत्पार्थिवं क्षत्रमृते यादवकौरवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2059973, "chapter_id": 2284, "verse_number": "८-५-२८", "content_sanskrit": "तं श्रुत्वा निहतं कर्णं द्वैरथे सव्यसाचिना।\nशोकार्णवे निमग्नोऽहं भिन्ना नौरिव सागरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2059974, "chapter_id": 2284, "verse_number": "८-५-२९", "content_sanskrit": "तं वृषं निहतं श्रुत्वा द्वैरथे रथिनां वरम्।\nशोकार्णवे निमग्नोऽहमप्लुवः सागरे यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2059975, "chapter_id": 2284, "verse_number": "८-५-३०", "content_sanskrit": "ईदृशैर्यद्यहं दुःखैर्न विनश्यामि सञ्जय।\nवज्राद्दृढतरं मन्ये हृदयं मम दुर्भिदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2059976, "chapter_id": 2284, "verse_number": "८-५-३१", "content_sanskrit": "ज्ञातिसंबन्धिमित्राणामिमं श्रुत्वा पराभवम्।\nको मदन्यः पुमाँल्लोके न जह्यात्सूत जीवितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2059977, "chapter_id": 2284, "verse_number": "८-५-३२", "content_sanskrit": "विषमग्निं प्रपातं च पर्वताग्रादहं वृणे।\n`महाप्रस्थानगमनं जलं प्रायोपवेशनम्।\nन हि शक्ष्यामि दुःखानि सोढुं कष्टानि सञ्जय॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2059978, "chapter_id": 2284, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि पञ्चमोऽध्यायः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]