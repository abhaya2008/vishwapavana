[{"id": 7004184000, "chapter_id": 24184, "verse_number": "५-१-३३-१", "content_sanskrit": "सनत्कुमार उवाच ।\nनारायणोऽपि संस्थाप्य शंखं दध्मौ प्रयत्नतः ।\nतुष्टाव प्रयतो भूत्वा स्तोत्रेणा नेन भास्करम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004184001, "chapter_id": 24184, "verse_number": "५-१-३३-२", "content_sanskrit": "श्रीकृष्ण उवाच ।\nआदित्यं भास्करं भानुं रविं सूर्यं दिवाकरम् ।\nदिवाकरं दिवानाथं तपनं तपतां वरम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004184002, "chapter_id": 24184, "verse_number": "५-१-३३-३", "content_sanskrit": "वरेण्यं वरदं विष्णुमनघं वासवानुजम् ।\nबलवीर्यं सहस्रांशुं सहस्रकिरणद्युतिम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004184003, "chapter_id": 24184, "verse_number": "५-१-३३-४", "content_sanskrit": "मयूखमालिनं विश्वं मार्तंडं चंडरोचिषम् ।\nसदातीतं सुभास्वंतं सप्तसप्तिं सुखोदयम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004184004, "chapter_id": 24184, "verse_number": "५-१-३३-५", "content_sanskrit": "देवदेवमहिर्बुध्न्यं धाम्नां निधिमनुत्तमम् ।\nतपोब्रह्ममयालोकं लोकपालमपांपतिम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004184005, "chapter_id": 24184, "verse_number": "५-१-३३-६", "content_sanskrit": "जगत्प्रबोधजनकं जगद्बीजं जगत्प्रभुम् ।\nअर्कं निःश्रेयसपरं कारणं श्रेयसां परम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004184006, "chapter_id": 24184, "verse_number": "५-१-३३-७", "content_sanskrit": "इनं प्रभाविणं पुण्यं पतंगं पवगेश्वरम् ।\nदातारं वांछितार्थानां दृष्टादृष्टफलप्रदम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004184007, "chapter_id": 24184, "verse_number": "५-१-३३-८", "content_sanskrit": "गृहं गृहकरं हंसं हरिदश्वं हुताशनम् ।\nमंगल्यं मंगलं गेयं ध्रुवं धर्मप्रबोधनम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004184008, "chapter_id": 24184, "verse_number": "५-१-३३-९", "content_sanskrit": "भवसंभावित भावं भूतभव्यभवात्मकम् ।\nदुर्गमं दुर्गतिहरं हरनेत्रं त्रयीमयम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004184009, "chapter_id": 24184, "verse_number": "५-१-३३-१०", "content_sanskrit": "त्रैलोक्यतिलकं तीर्थं तरणिं सर्वतोमुखम् ।\nतेजोराशिसुनिर्वाणं विश्वेशं धाम सांप्रतम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004184010, "chapter_id": 24184, "verse_number": "५-१-३३-११", "content_sanskrit": "कल्पं कल्पानलं कालं कालचक्रं क्रतुप्रियम् ।\nभूषणं मरुतं सूर्यं मणिरत्नं सुलोचनम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004184011, "chapter_id": 24184, "verse_number": "५-१-३३-१२", "content_sanskrit": "त्वष्टारं विष्टरं विश्वं सदसत्कर्मसाक्षिकम् ।\nसवितारं सहस्राक्षं प्रजापालमधोक्षजम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004184012, "chapter_id": 24184, "verse_number": "५-१-३३-१३", "content_sanskrit": "ब्रह्माणं वासरारंभे रक्तवर्णं महाद्युतिम् ।\nशुक्लं मध्यंदिने रुद्रं श्यामं विष्णुं दिनक्षये॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004184013, "chapter_id": 24184, "verse_number": "५-१-३३-१४", "content_sanskrit": "नाम्नामष्टशतं दिव्यं विष्णुना समुदाहृतम् ।\nय इदं प्रयतो भूत्वा पठेद्भक्त्या समाहितः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004184014, "chapter_id": 24184, "verse_number": "५-१-३३-१५", "content_sanskrit": "न तस्य विपदः क्वापि सर्वत्रापि शुभा गतिः ।\nधनधान्यसुखावाप्तिः पुत्रलाभश्च जायते॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004184015, "chapter_id": 24184, "verse_number": "५-१-३३-१६", "content_sanskrit": "तेजः प्रज्ञां परं लाभं ज्ञानं च लभते गतिम् ।\nएतच्छ्रुत्वा जगन्नाथो जगामादर्शनं ततः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004184016, "chapter_id": 24184, "verse_number": "५-१-३३-१७", "content_sanskrit": "केशवार्कमुखं दृष्ट्वा पद्मरागसमप्रभम् ।\nविमुक्तः सर्वपापेभ्यः सूर्यलोके महीयते॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004184017, "chapter_id": 24184, "verse_number": "५-१-३३-१८", "content_sanskrit": "केशवार्कसमीपे तु रेणुतीर्थं प्रचक्षते ।\nतद्दृष्ट्वा सर्वपापेभ्यो मुच्यते नात्र संशयः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]