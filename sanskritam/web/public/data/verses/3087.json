[{"id": 2097443, "chapter_id": 3087, "verse_number": "१३-२१७-१", "content_sanskrit": "उमोवाच।\nभगवन्भगनेत्रघ्न कालसूदन शङ्कर।\nइमे वर्णाश्च चत्वारो विहिताः स्वस्वभावतः।\nउताहो क्रियया वर्णाः सम्भवन्ति महेश्वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2097444, "chapter_id": 3087, "verse_number": "१३-२१७-२", "content_sanskrit": "एवं मे संशयप्रश्नस्तं मे छेत्तुं त्वमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2097445, "chapter_id": 3087, "verse_number": "१३-२१७-३x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2097446, "chapter_id": 3087, "verse_number": "१३-२१७-३", "content_sanskrit": "स्वभावादेव विद्यन्ते चत्वारो ब्राह्मणादयः।\nएकजात्या सुदुष्प्रापमन्यवर्णत्वमागतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2097447, "chapter_id": 3087, "verse_number": "१३-२१७-४", "content_sanskrit": "तच्च कर्मविशेषेण पुनर्जन्मनि जायते।\nतस्मात्तेषां प्रवक्ष्यामि तत्सर्वं कर्मपाकजम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2097448, "chapter_id": 3087, "verse_number": "१३-२१७-५", "content_sanskrit": "ब्राह्मणस्तु नरो भूत्वा स्वजातिमनुपालयन्।\nदृढं ब्राह्मणकर्माणि वेदोक्तानि समाचरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2097449, "chapter_id": 3087, "verse_number": "१३-२१७-६", "content_sanskrit": "सत्यार्जवपरो भूत्वा दानयज्ञपरस्तथा।\nसत्यां जात्यां समुदितो जातिधर्मान्न हापयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2097450, "chapter_id": 3087, "verse_number": "१३-२१७-७", "content_sanskrit": "एवं संवर्तमानस्तु कालधर्मं गतः पुनः।\nस्वर्गलोके हि जायेत स्वर्गभोगाय भामिनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2097451, "chapter_id": 3087, "verse_number": "१३-२१७-८", "content_sanskrit": "तत्क्षये ब्राह्मणो भूत्वा तथैव नृषु जायते।\nएवंस्वकर्मणा मर्त्यः स्वजातिं लभते पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2097452, "chapter_id": 3087, "verse_number": "१३-२१७-९", "content_sanskrit": "अपरस्तु तथा कश्चिद्ब्रह्मयोनिसमुद्भवः।\nअवमत्यैव तां जातिमज्ञानतमसा वृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2097453, "chapter_id": 3087, "verse_number": "१३-२१७-१०", "content_sanskrit": "अन्यथा वर्तमानस्तु जातिकर्माणि वर्जयेत्।\nशूद्रवद्विचरेल्लोके शूद्रकर्माभिलाषवान्।\nशूद्रैः सह चरन्नित्यं शौचमङ्गलवर्जितः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2097454, "chapter_id": 3087, "verse_number": "१३-२१७-११", "content_sanskrit": "स चापि कालधर्मस्थो यमलोके सुदण्डितः।\nयदि जायेत मर्त्येषु शूद्र एवाभिजायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2097455, "chapter_id": 3087, "verse_number": "१३-२१७-१२", "content_sanskrit": "शूद्र एव भवेद्देवि ब्राह्मणोऽपि स्वकर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2097456, "chapter_id": 3087, "verse_number": "१३-२१७-१३", "content_sanskrit": "तथैव शूद्रस्त्वपरः शूद्रकर्माणि वर्जयेत्।\nसत्यार्जवपरो भूत्वा दानधर्मपरस्तथा।\nमन्त्रब्राह्मणसत्कर्ता मनसा ब्राह्मणप्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2097457, "chapter_id": 3087, "verse_number": "१३-२१७-१४", "content_sanskrit": "एवं युक्तसमाचारः शूद्रोपि मरणं गतः।\nस्वर्गलोके हि जायेत तत्क्षये नृषु जायते।\nब्राह्मणानां कुले मुख्ये वेदस्वाध्यायसंयुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2097458, "chapter_id": 3087, "verse_number": "१३-२१७-१५", "content_sanskrit": "एवमेव सदा लोके शूद्रो ब्राह्मण्यमाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2097459, "chapter_id": 3087, "verse_number": "१३-२१७-१६", "content_sanskrit": "एवं क्षत्रियवैश्याश्च जातिधर्मेण संयुताः।\nस्वकर्मणैव जायन्ते विशिष्टेष्वधमेषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2097460, "chapter_id": 3087, "verse_number": "१३-२१७-१७", "content_sanskrit": "एवं जातिविपर्यासः प्रेत्यभावे भवेन्नृणाम्।\nअन्यथा तु न शक्यं तल्लोकसंस्थितिकारणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2097461, "chapter_id": 3087, "verse_number": "१३-२१७-१८", "content_sanskrit": "तस्माज्जातिं विशिष्टां तु कथंचित्प्राप्य पण्डितः।\nसर्वथा तां तथा रक्षेन्न पुनर्भ्रश्यते यथा।\nइति ते कथितं देवि भूयः श्रोतुं किमिच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2097462, "chapter_id": 3087, "verse_number": "१३-२१७-१९x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2097463, "chapter_id": 3087, "verse_number": "१३-२१७-१९", "content_sanskrit": "जन्मप्रभृति कः शुद्धो लभेज्जन्मफलं नरः।\nशोभनाशोभनं सर्वमधइकारवशात्स्वकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2097464, "chapter_id": 3087, "verse_number": "१३-२१७-२०x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2097465, "chapter_id": 3087, "verse_number": "१३-२१७-२०", "content_sanskrit": "कर्म कुर्वन्न लिप्येत आर्जवेन समाचरेत्।\nआत्मैव तच्छुभं कुर्यादशुभे योजयेत्परान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2097466, "chapter_id": 3087, "verse_number": "१३-२१७-२१", "content_sanskrit": "शठेषु शठवत्कुर्योदार्यष्वार्यवदाचरेत्।\nआपत्सु नावसीदेच्च घोरान्सङ्ग्रामयेत्परात्।\nसाम्नैव सर्वकार्याणि कर्तुं पूर्वं समारभेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2097467, "chapter_id": 3087, "verse_number": "१३-२१७-२२", "content_sanskrit": "अनर्थाधर्मशोकानां यथा न प्राप्नुयात्स्वयम्।\nप्रीयते तत्तथा कर्तुमेतद्वृत्तं समासतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2097468, "chapter_id": 3087, "verse_number": "१३-२१७-२३", "content_sanskrit": "एवं वृत्तं समासाद्य गृहमाश्रित्य मानवाः।\nनिराहारा निरुद्वेगाः प्राप्नुवन्त्युत्तमां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2097469, "chapter_id": 3087, "verse_number": "१३-२१७-२४", "content_sanskrit": "एतज्जन्मफलं नित्यं सर्वेषां गृहवासिनाम्।\nएवं गृहस्थितैर्नित्यं वर्तितव्यमिति स्थितिः।\nएतत्सर्वं मया प्रोक्तं किं भूयः श्रोतुमिच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2097470, "chapter_id": 3087, "verse_number": "१३-२१७-२५x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2097471, "chapter_id": 3087, "verse_number": "१३-२१७-२५", "content_sanskrit": "सुरासुरपते देव वरद प्रीतिवर्धन।\nमानुषेष्वेव ये के चिदाढ्याः क्लेशविवर्जिताः।\nभुञ्जाना विविधान्भोगान्दृश्यन्ते निरुपद्रवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2097472, "chapter_id": 3087, "verse_number": "१३-२१७-२६", "content_sanskrit": "अपरे क्लेशसंयुक्ता दरिद्रा भोगवर्जिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2097473, "chapter_id": 3087, "verse_number": "१३-२१७-२७", "content_sanskrit": "किमर्थं मानुषे लोके न समत्वेन कल्पिताः।\nएतच्छ्रोतुं महादेव कौतूहलमतीव मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2097474, "chapter_id": 3087, "verse_number": "१३-२१७-२८x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2097475, "chapter_id": 3087, "verse_number": "१३-२१७-२८", "content_sanskrit": "न्यायतस्त्वं महाभागे श्रोतुकामासि भामिनि।\nशृणु तत्सर्वमखिलं मानुषाणां हितं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2097476, "chapter_id": 3087, "verse_number": "१३-२१७-२९", "content_sanskrit": "आदिसर्गे पुरा ब्रह्मा समत्वेनासृजत्प्रजाः।\nनित्यं न भवतो ह्यस्य रागद्वेषौ प्रजापतेः।\nतदा तस्मात्सुराः सर्वे बभूवुः समतो नराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2097477, "chapter_id": 3087, "verse_number": "१३-२१७-३०", "content_sanskrit": "एवं संवर्तमाने तु युगे कालविपर्ययात्।\nकेचित्प्रपेदिरे तत्र विषमं बुद्धिमोहिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2097478, "chapter_id": 3087, "verse_number": "१३-२१७-३१", "content_sanskrit": "तेषां हानिं ततो दृष्ट्वा तुल्यानामेव भामिनि।\nब्राह्मणास्ते समाजग्मुस्तत्तत्कारणवेदकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2097479, "chapter_id": 3087, "verse_number": "१३-२१७-३२", "content_sanskrit": "कर्तुं नार्हसि देवेश पक्षपातं त्वमीदृशम्।\nपुत्रभावे समे देव किमर्थं नो भवेत्कलिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2097480, "chapter_id": 3087, "verse_number": "१३-२१७-३३", "content_sanskrit": "एवमेतैरुपालब्धो ब्रह्मा वचनमब्रवीत्।\nयूयं मा ब्रूत मे दोषं स्वकृतं स्मरथ प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2097481, "chapter_id": 3087, "verse_number": "१३-२१७-३४", "content_sanskrit": "युष्माभिरेव युष्माकं ग्रथितं हि शुभाशुभम्।\nयादृशं कुरुते कर्म तादृशं फलमश्नुते।\nस्वकृतस्य फलं भुङ्क्ते नान्यस्तद्बोक्तुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2097482, "chapter_id": 3087, "verse_number": "१३-२१७-३५", "content_sanskrit": "एवं संबोधितास्तेन कालकर्त्रा स्वयंभुवा।\nपुनर्विवृत्य कर्माणि शुभान्येव प्रपेदिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2097483, "chapter_id": 3087, "verse_number": "१३-२१७-३६", "content_sanskrit": "एवं विज्ञाततत्वास्ते दानधर्मपरायणाः।\nशुभानि विधिवत्कृत्वा कालधर्मगताः पुनः।\nतानि दानफलान्येव भुञ्जते सुखभोगिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2097484, "chapter_id": 3087, "verse_number": "१३-२१७-३७", "content_sanskrit": "स्वकृतं तु नरस्तस्मात्स्वयमेव प्रपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2097485, "chapter_id": 3087, "verse_number": "१३-२१७-३८", "content_sanskrit": "अपरे धर्मकामेभ्यो निवृत्ताश्च शुभेक्षणे।\nकदर्या निरनुक्रोशाः प्रायेणात्मपरायणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2097486, "chapter_id": 3087, "verse_number": "१३-२१७-३९", "content_sanskrit": "तादृशा मरणं प्राप्ताः पुनर्जन्मनि शोभने।\nदरिद्राः क्लेशभूयिष्ठा भवन्त्येव न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2097487, "chapter_id": 3087, "verse_number": "१३-२१७-४०x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2097488, "chapter_id": 3087, "verse_number": "१३-२१७-४०", "content_sanskrit": "मानुषेष्वथ ये केचिद्धनधान्यसमन्विताः।\nभोगहीनाः प्रदृश्यन्ते सर्वभोगेषु सत्स्वपि।\nन भुञ्जते किमर्थं ते तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2097489, "chapter_id": 3087, "verse_number": "१३-२१७-४१x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2097490, "chapter_id": 3087, "verse_number": "१३-२१७-४१", "content_sanskrit": "परैः संचोदिता धर्मं कुर्वते न स्वकामतः।\nस्वयं श्रद्धां बहिष्कृत्य कुर्वन्ति च रुदन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2097491, "chapter_id": 3087, "verse_number": "१३-२१७-४२", "content_sanskrit": "तादृशा मरणं प्राप्ताः पुनर्जन्मनि शोभने।\nफलानि तानि सम्प्राप्य भुञ्जते न कदाचन।\nरक्षन्तो वर्धयन्तश्च आसते निधिपालवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2097492, "chapter_id": 3087, "verse_number": "१३-२१७-४३x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2097493, "chapter_id": 3087, "verse_number": "१३-२१७-४३", "content_sanskrit": "केचिद्धनवियुक्ताश्च भोगयुक्ता महेश्वर।\nमानुषाः सम्प्रदृश्यन्ते तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2097494, "chapter_id": 3087, "verse_number": "१३-२१७-४४x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2097495, "chapter_id": 3087, "verse_number": "१३-२१७-४४", "content_sanskrit": "आनृशंस्यपरा ये तु धर्मकामाश्चि दुर्गताः।\nपरोपकारं कुर्वन्ति दीनानुग्रहकारणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2097496, "chapter_id": 3087, "verse_number": "१३-२१७-४५", "content_sanskrit": "प्रतिपद्युः परधनं नष्टं वाऽन्यैर्नरैर्हृतम्।\nनित्यं ये दातुमनसो नरा वित्तेष्वसत्स्वपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2097497, "chapter_id": 3087, "verse_number": "१३-२१७-४६", "content_sanskrit": "कालधर्मवशं प्राप्ताः पुनर्जन्मनि ते नराः।\nएते धनविहीनाश्च भोगयुक्ता भवन्त्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2097498, "chapter_id": 3087, "verse_number": "१३-२१७-४७", "content_sanskrit": "धर्मदानोपदेशं वा कर्तव्यमिति निश्चयः।\nइति ते कथितं देवि किं भूयः श्रोतुमिच्छसि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2097499, "chapter_id": 3087, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि सप्तदशाधिकद्विशततमोऽध्यायः॥ २१७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]