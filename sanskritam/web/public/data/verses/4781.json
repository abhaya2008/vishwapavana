[{"id": 2178708, "chapter_id": 4781, "verse_number": "", "content_sanskrit": "गान्धारी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2178709, "chapter_id": 4781, "verse_number": "१", "content_sanskrit": "काम्भोजं पश्य दुर्धर्षं काम्भोजास्तरणोचितम् ।\nशयानमृषभस्कन्धं हतं पांसुषु माधव\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2178710, "chapter_id": 4781, "verse_number": "२", "content_sanskrit": "अस्य क्षतजसन्दिग्धौ बाहू चन्दनरूषितौ ।\nअवेक्ष्य कृपणं भार्या विलपत्यतिदुःखिता\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2178711, "chapter_id": 4781, "verse_number": "", "content_sanskrit": "काम्भोजभार्या", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2178712, "chapter_id": 4781, "verse_number": "३", "content_sanskrit": "इमौ तौ परिघप्रख्यौ बाहू शुभतलाङ्गुली ।\nययोर्विवरमापन्नां मां रतिर्मा पुराऽजहत्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2178713, "chapter_id": 4781, "verse_number": "४", "content_sanskrit": "कां गतिं तु गमिष्यामि त्वया हीना नरेश्वर ।\nदूरबन्धुरनाथाऽद्य ह्यतीव मधुरस्वरा\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2178714, "chapter_id": 4781, "verse_number": "", "content_sanskrit": "गान्धारी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2178715, "chapter_id": 4781, "verse_number": "५", "content_sanskrit": "आतपे क्लाम्यमानानां विविधानामिव स्रजाम् ।\nक्लान्तानामपि नारीणां जहाति श्रीर्न वै तनुम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2178716, "chapter_id": 4781, "verse_number": "६", "content_sanskrit": "शयानमभितः शूरं कलिङ्गं मधुसूदन ।\nपश्य दीप्ताङ्गदयुगप्रतिनद्धं महाभुजम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2178717, "chapter_id": 4781, "verse_number": "७", "content_sanskrit": "मागधानामधिपतिं जयत्सेनं जनार्दन ।\nपरिवार्य प्ररुदिता मागध्यः पश्य योषितः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2178718, "chapter_id": 4781, "verse_number": "८", "content_sanskrit": "हरिण्यायतनेत्राणां सुस्वराणां जनार्दन ।\nमम श्रुतिहरो नादो मनो मोहयतीव मे\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2178719, "chapter_id": 4781, "verse_number": "९", "content_sanskrit": "प्रकीर्णसर्वाभरणा रुदन्त्यः शोककर्शिताः ।\nस्वास्तीर्णशयनोपेता मागध्यः शेरते भुवि\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2178720, "chapter_id": 4781, "verse_number": "१०", "content_sanskrit": "कोसलानामधिपतिं राजपुत्रं बृहद्बलम् ।\nभर्तारं परिवार्यैताः पृथक् प्ररुदिताः स्त्रियः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2178721, "chapter_id": 4781, "verse_number": "११", "content_sanskrit": "अस्य गात्रगतान् बाणान् कार्ष्णिबाहुबलेरितान् ।\nउद्धरन्त्यसुखाविष्टा मूर्च्छमानाः पुनः पुनः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2178722, "chapter_id": 4781, "verse_number": "१२", "content_sanskrit": "आसां सर्वानवद्यानामातपेन परिक्लमात् ।\nप्रम्लाननलिनाभानि भान्ति वक्त्राणि माधव\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2178723, "chapter_id": 4781, "verse_number": "१३", "content_sanskrit": "द्रोणेन निहताः शूराः शेरते रुधिरोक्षिताः ।\nधृष्टद्युम्नसुताः सर्वे भ्रातरो हेममालिनः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2178724, "chapter_id": 4781, "verse_number": "१४", "content_sanskrit": "रथाश्ववायुं चापार्चिं शरशक्तिगदेन्धनम् ।\nद्रोणमासाद्य निर्दग्धाः शलभा इव पावकम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2178725, "chapter_id": 4781, "verse_number": "१५", "content_sanskrit": "तथैव निहताः शूराः शेरते रुचिराङ्गदाः ।\nद्रोणेनाभिहताः सङ्खे भ्रातरः पञ्च केकयाः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2178726, "chapter_id": 4781, "verse_number": "१६", "content_sanskrit": "तप्तकाञ्चनवर्णाभाः ताम्रध्वजरथव्रजाः ।\nभासयन्ति महीं भासा ज्वलिता इव पावकाः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2178727, "chapter_id": 4781, "verse_number": "१७", "content_sanskrit": "द्रोणेन द्रुपदं सङ्खे पश्य माधव पातितम् ।\nमहाद्विपमिवारण्ये सिंहेन महता हतम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2178728, "chapter_id": 4781, "verse_number": "१८", "content_sanskrit": "पाञ्चालराज्ञो विमलं पुण्डरीकाक्ष पाण्डरम् ।\nआतपत्रं समाभाति शरदीव दिवाकरः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2178729, "chapter_id": 4781, "verse_number": "१९", "content_sanskrit": "एतास्तु द्रुपदं वृद्धं स्नुषा भार्याश्च दुःखिताः ।\nदग्ध्वा गच्छन्ति पाञ्चालराजानमपसव्यतः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2178730, "chapter_id": 4781, "verse_number": "२०", "content_sanskrit": "धृष्टकेतुं महेष्वासं चेदिपुङ्गवमङ्गनाः ।\nद्रोणेन निहतं शूरं हरन्ति हृतचेतसः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2178731, "chapter_id": 4781, "verse_number": "२१", "content_sanskrit": "द्रोणास्त्रमभिहत्यैव विमर्दे मधुसूदन ।\nमहेष्वासो हतः शेते वज्राहत इव द्रुमः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2178732, "chapter_id": 4781, "verse_number": "२२", "content_sanskrit": "एष चेदिपतिः शूरो धृष्टकेतुर्महारथः ।\nशेते विनिहतः सङ्खे हत्वा शत्रून् सहस्रशः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2178733, "chapter_id": 4781, "verse_number": "२३", "content_sanskrit": "वितुद्यमानं विहगैस्तं भार्याः प्रत्युपस्थिताः ।\nचेदिराजं हृषीकेश हतं सबलबान्धवम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2178734, "chapter_id": 4781, "verse_number": "२४", "content_sanskrit": "दाशार्हीपुत्रजं वीरं शयानं सत्यविक्रमम् ।\nआदायाङ्के रुदन्त्येता चेदिराजवराङ्गनाः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2178735, "chapter_id": 4781, "verse_number": "२५", "content_sanskrit": "अस्य पुत्रं हृषीकेश सुवक्त्रं चारुकुण्डलम् ।\nद्रोणेन समरे पश्य निकृत्तं बहुभिः शरैः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2178736, "chapter_id": 4781, "verse_number": "२६", "content_sanskrit": "पितरं नूनमाजिस्थं युध्यमानं परैः सह ।\nनाजहात् पितरं वीरमद्यापि मधुसूदन\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2178737, "chapter_id": 4781, "verse_number": "२७", "content_sanskrit": "एवं ममापि पुत्रस्य पुत्रः पितरमन्वगात् ।\nदुर्योधनं महाबाहो लक्ष्म(क्ष)णः परवीरहा\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2178738, "chapter_id": 4781, "verse_number": "२८", "content_sanskrit": "विन्दानुविन्दावावन्त्यौ पतितौ पश्य माधव ।\nवनेषु पुष्पितौ सालौ मरुता गलिताविव\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2178739, "chapter_id": 4781, "verse_number": "२९", "content_sanskrit": "काञ्चनाङ्गदवर्माणौ बाणखड्गधनुर्धरौ ।\nऋषभप्रतिरूपाक्षौ शयानौ विमलस्रजौ\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2178740, "chapter_id": 4781, "verse_number": "३०", "content_sanskrit": "अवध्याः पाण्डवाः कृष्ण सर्व एव त्वया सह ।\nये मुक्ता द्रोणभीष्माभ्यां कर्णाद् वैकर्तनात् कृपात्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2178741, "chapter_id": 4781, "verse_number": "३१", "content_sanskrit": "दुर्योधनाद् द्रोणसुतान् सैन्धवाच्च जयद्रथात् ।\nसौमदत्तेर्विकर्णाच्च शूराच्च कृतवर्मणः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2178742, "chapter_id": 4781, "verse_number": "३२", "content_sanskrit": "ये हन्युः शस्त्रवेगेन देवानपि नरर्षभाः ।\nत इमे निहताः सर्वे पश्य कालस्य पर्ययम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2178743, "chapter_id": 4781, "verse_number": "३३", "content_sanskrit": "नातिभारोऽस्ति दैवस्य ध्रुवं माधव कश्चन ।\nयत्रेमे निहताः शूराः क्षत्रियाः क्षत्रियैः सह\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2178744, "chapter_id": 4781, "verse_number": "३४", "content_sanskrit": "शूराश्च कृतविद्याश्च मम पुत्रा मनस्विनः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2178745, "chapter_id": 4781, "verse_number": "३५", "content_sanskrit": "तदैव निहताः कृष्ण मम पुत्रा यशस्विनः ।\nयदैवाकृतकामस्त्वमुपप्लाव्यं गतः पुनः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2178746, "chapter_id": 4781, "verse_number": "३५", "content_sanskrit": "शन्तनोश्चैव पुत्रेण प्राज्ञेन विदुरेण च ।\nतदैवोक्तास्मि मा स्नेहं कुरुष्वात्मसुतेष्विति\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2178747, "chapter_id": 4781, "verse_number": "३७", "content_sanskrit": "न तयोर्वचनं तात मिथ्या भवितुमर्हति ।\nअचिरेणैव मे पुत्रा भस्मीभूता जनार्दन\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2178748, "chapter_id": 4781, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2178749, "chapter_id": 4781, "verse_number": "३८", "content_sanskrit": "इत्युक्त्वा न्यपतद् भूमौ गान्धारी शोककर्शिता ।\nदुःखोपहतविज्ञाना धैर्यमुत्सृज्य भारत\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2178750, "chapter_id": 4781, "verse_number": "३९", "content_sanskrit": "ततः कोपपरीताङ्गी दुःखशोकपरिप्लुता ।\nजगाद शौरिं रोषेण गान्धारी व्यथितेन्द्रिया\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2178751, "chapter_id": 4781, "verse_number": "", "content_sanskrit": "गान्धारी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2178752, "chapter_id": 4781, "verse_number": "४०", "content_sanskrit": "पाण्डवा धार्तराष्ट्राश्च क्रुद्धाः कृष्ण परस्परम् ।\nउपेक्षिता विनश्यन्तः त्वया कस्माज्जनार्दन\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2178753, "chapter_id": 4781, "verse_number": "४१", "content_sanskrit": "शक्तेन बहुभृत्येन विपुले तिष्ठता बले\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2178754, "chapter_id": 4781, "verse_number": "४२", "content_sanskrit": "उभयत्र समत्वेन श्रुतवाक्येन चैव हि ।\nइच्छतोपेक्षितो नाशः कुरूणां मधुसूदन\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2178755, "chapter_id": 4781, "verse_number": "४३", "content_sanskrit": "यस्मात् त्वया महाबाहो फलं तस्मादवाप्नुहि\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2178756, "chapter_id": 4781, "verse_number": "४४", "content_sanskrit": "पतिशुश्रूषया यन्मे तपः किञ्चिदुपार्जितम् ।\nतेन त्वां दुरवापेन शपे चक्रगदाधर\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2178757, "chapter_id": 4781, "verse_number": "४५", "content_sanskrit": "यस्मात् परस्परं घ्नन्तो ज्ञातयः कुरुपाण्डवाः ।\nउपेक्षितास्ते गोविन्द तस्माज्ज्ञातीन् वधिष्यसि\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2178758, "chapter_id": 4781, "verse_number": "४६", "content_sanskrit": "त्वमप्युपस्थिते वर्षे षट्त्रिंशे मधुसूदन ।\nहतज्ञातिर्हतामात्यो हतपुत्रो वनेचरः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2178759, "chapter_id": 4781, "verse_number": "४७", "content_sanskrit": "अनाथवदभिज्ञातो लोकेष्वनभिलक्षितः ।\nकुत्सितेनाभ्युपायेन निधनं समवाप्स्यसि\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2178760, "chapter_id": 4781, "verse_number": "४८", "content_sanskrit": "तवाप्येवं हतसुता निहतज्ञातिबान्धवाः ।\nस्त्रियः परिपतिष्यन्ति यथेमा भरतस्त्रियः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2178761, "chapter_id": 4781, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2178762, "chapter_id": 4781, "verse_number": "४९", "content_sanskrit": "तच्छ्रुत्वा वचनं घोरं वासुदेवो महामनाः ।\nउवाच देवीं गान्धारीमिदमभ्युत्स्मयन्निव\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2178763, "chapter_id": 4781, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2178764, "chapter_id": 4781, "verse_number": "५०", "content_sanskrit": "संहर्ता वृष्णिचक्रस्य नान्योऽस्मद् विद्यते शुभे ।\nजानेऽहमेतदप्येवं चीर्णं चरसि क्षत्रिये\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2178765, "chapter_id": 4781, "verse_number": "५१", "content_sanskrit": "अवध्यास्ते नरैरन्यैरपि वा देवदानवैः ।\nपरस्परकृतं नाशमतः प्राप्स्यन्ति यादवाः\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2178766, "chapter_id": 4781, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2178767, "chapter_id": 4781, "verse_number": "५२", "content_sanskrit": "इत्युक्तवति दाशार्हे पाण्डवास्त्रस्तमानसाः ।\nबभूवुर्भृशसंविग्ना निराशास्तेऽपि जीविते\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2178768, "chapter_id": 4781, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां स्त्रीपर्वणि\nवासुदेवशापो नाम पञ्चविंशोऽध्यायः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2178769, "chapter_id": 4781, "verse_number": "१०", "content_sanskrit": "स्त्रीपर्वणि दशमोऽध्यायः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2178770, "chapter_id": 4781, "verse_number": "", "content_sanskrit": "॥ समाप्तं स्त्रीविलापपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2178771, "chapter_id": 4781, "verse_number": "", "content_sanskrit": "* * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}]