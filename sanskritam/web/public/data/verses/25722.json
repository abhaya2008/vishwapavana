[{"id": 7005722000, "chapter_id": 25722, "verse_number": "१९५-१", "content_sanskrit": "सूत उवाच ।\nइत्याकर्ण्य स राजेन्द्र ओङ्कारस्याभि वर्णनम् ।\nततः पप्रच्छ देवेशं मत्स्यरूपं जलार्णवे ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005722001, "chapter_id": 25722, "verse_number": "१९५-२", "content_sanskrit": "ऋषीणां नाम गोत्राणि वंशावतरणं तथा ।\nप्रवराणां तथा साम्यमसाम्यं विस्तराद् वद ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005722002, "chapter_id": 25722, "verse_number": "१९५-३", "content_sanskrit": "महादेवेन ऋषयः शप्ताः स्वायम्भुवान्तरे ।\nतेषां वैवस्वते प्राप्ते सम्भवं मम कीर्त्तय ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005722003, "chapter_id": 25722, "verse_number": "१९५-४", "content_sanskrit": "दाक्षायणी न च तथा प्रजाः कीर्तय मे प्रभो ।\nऋषीणां च तथा वंशं भृगुवंशविवर्धनम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005722004, "chapter_id": 25722, "verse_number": "१९५-५", "content_sanskrit": "मत्स्य उवाच ।\nमन्वन्तरेऽस्मिन् संप्राप्ते पूर्वं वैवस्वते तथा ।\nचरित्रं कथयते राजन्! ब्रह्मणः परमेष्ठिनः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005722005, "chapter_id": 25722, "verse_number": "१९५-६", "content_sanskrit": "महादेवस्य शापेन त्यक्त्वा देहं स्वयं तथा ।\nऋषयश्च समुद्भूताश्च्युते शुक्रे महात्मनः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005722006, "chapter_id": 25722, "verse_number": "१९५-७", "content_sanskrit": "देवानां मातरो दृष्ट्वा देवपत्न्यस्तथैव च ।\nस्कन्नं शुक्रं महाराज! ब्रह्मणः परमेष्ठिनः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005722007, "chapter_id": 25722, "verse_number": "१९५-८", "content_sanskrit": "तज्जुहाव ततो ब्रह्मा ततो जाता हुताशनात् ।\nततो जातो महातेजा भृगुश्च तपसं निधिः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005722008, "chapter_id": 25722, "verse_number": "१९५-९", "content_sanskrit": "अङ्गरेष्वङ्गिरा जातो ह्यर्चिभ्योऽत्रिस्तथैव च ।\nमरीचिभ्यो मरीचिस्तु ततो जातो महातपाः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005722009, "chapter_id": 25722, "verse_number": "१९५-१०", "content_sanskrit": "केशैस्तु कपिशो जातः पुलस्त्यश्च महातपाः ।\nकेशैः प्रलम्बैः पुलहस्ततो जातो महातपाः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005722010, "chapter_id": 25722, "verse_number": "१९५-११", "content_sanskrit": "वसुमध्यात् समुत्पन्नो वसिष्ठस्तु तपोधनः ।\nभृगुः पुलोम्नस्तु सुतां दिव्यां भार्यामविन्दत ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005722011, "chapter_id": 25722, "verse_number": "१९५-१२", "content_sanskrit": "यस्यामस्य सुता जाता देवा द्वादशयाज्ञिकाः ।\nभुवनो भौवनश्चैव सुजन्यः सुजनस्तथा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005722012, "chapter_id": 25722, "verse_number": "१९५-१३", "content_sanskrit": "शुचिक्रतुश्च मूर्धा च त्याज्यश्च वसुदश्च ह ।\nप्रभवश्चाव्ययश्चैव दक्षोऽथ द्वादशस्तथा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005722013, "chapter_id": 25722, "verse_number": "१९५-१४", "content_sanskrit": "इत्येते भृगवो नाम देवा द्वादश कीर्तिताः ।\nपौलोम्यां जनयन् विप्रान् देवानां तु कनीयसः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005722014, "chapter_id": 25722, "verse_number": "१९५-१५", "content_sanskrit": "च्यवनन्तु महाभागमाप्नुवानं तथैव च ।\nआप्नुवानात्मजश्चौर्वो जमदग्निस्तदात्मजः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005722015, "chapter_id": 25722, "verse_number": "१९५-१६", "content_sanskrit": "और्वो गोत्रकरस्तेषां भार्गवाणां महात्मनाम् ।\nतत्र गोत्रकरास्त्वन्ये भृगोर्वै दीप्ततेजसः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005722016, "chapter_id": 25722, "verse_number": "१९५-१७", "content_sanskrit": "भृगुश्च च्यवनश्चैव आप्नुवानस्तथैव च ।\nऔर्वश्च जमदग्निश्च वात्स्यो दण्डिर्नडायनः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005722017, "chapter_id": 25722, "verse_number": "१९५-१८", "content_sanskrit": "वैगायनो वीतिहव्यः पैलश्चैवात्र शौनकः ।\nशौनकायन जीवन्ति रावेदः कार्पणिस्तथा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005722018, "chapter_id": 25722, "verse_number": "१९५-१९", "content_sanskrit": "वैहीनरिर्विरूपाक्षो रौहित्यायनिरेव च ।\nवैश्वानरिस्तथा नीलो लुब्धः सावर्णिकश्च सः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005722019, "chapter_id": 25722, "verse_number": "१९५-२०", "content_sanskrit": "विष्णुः पौरोऽपि वालाकि रैलिकोऽनन्तभागिनः ।\nभृतभार्गेयमार्कण्डजविनो वीतिनस्तथा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005722020, "chapter_id": 25722, "verse_number": "१९५-२१", "content_sanskrit": "मण्डमाण्डव्यमाण्डूकफेनपास्तनितस्तथा ।\nस्थलपिण्डः शिखावर्णः शार्कराक्षिस्तथैव च ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005722021, "chapter_id": 25722, "verse_number": "१९५-२२", "content_sanskrit": "जालधिः सौधिकः क्षुभ्यः कुत्सन्यो मौद्गलायनः ।\nकर्मायनो देवपतिः पाण्डुरोचिः सगालवः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005722022, "chapter_id": 25722, "verse_number": "१९५-२३", "content_sanskrit": "साङ्कृत्यश्चातकिः सार्पिर्यज्ञपिण्डायनस्तथा ।\nगार्ग्यायनो गायनश्च ऋषिर्गार्हायनस्तथा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005722023, "chapter_id": 25722, "verse_number": "१९५-२४", "content_sanskrit": "गोष्ठायनो वात्यायनो वैशम्पायन एव च ।\nवैकर्णिनिः शाङ्करवो याज्ञेयिर्भ्राष्ट्रकायनिः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005722024, "chapter_id": 25722, "verse_number": "१९५-२५", "content_sanskrit": "लालाटिर्नाकुलिश्चैव लौक्षिण्योपरिमण्डलौ ।\nआलुकिः सौचकिः कौत्सस्तथान्यः पैङ्गलायनिः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005722025, "chapter_id": 25722, "verse_number": "१९५-२६", "content_sanskrit": "सात्यायनिर्मालायनिः कौटिलिः कौचहस्तिकः ।\nसौहसोक्तिः सकौवाक्षिः कौसिश्चान्द्रमसिस्तथा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005722026, "chapter_id": 25722, "verse_number": "१९५-२७", "content_sanskrit": "नैकजिह्वो जिह्मकश्च व्याधाद्यो लोहवैरिणः ।\nशारद्वतिकनेतिष्यौ लोलाक्षिश्चलकुण्डलः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005722027, "chapter_id": 25722, "verse_number": "१९५-२८", "content_sanskrit": "वागायनिश्चानुमतिः पूर्णमागतिकोऽसकृत् ।\nसामान्येन यथा तेषां पञ्चैते प्रवरामताः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005722028, "chapter_id": 25722, "verse_number": "१९५-२९", "content_sanskrit": "भृगुश्च च्यवनश्चैव आप्नुवानस्तथैव च ।\nऔर्वश्च जमदग्निश्च पञ्चैते प्रवरा मताः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005722029, "chapter_id": 25722, "verse_number": "१९५-३०", "content_sanskrit": "अतः परं प्रवक्ष्यामि श्रृणु त्वन्यान् भृगूद्वहान् ।\nजमदग्निर्विदश्चैव पौलस्त्यो वैजभृत्तथा ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005722030, "chapter_id": 25722, "verse_number": "१९५-३१", "content_sanskrit": "ऋषिश्चोभयजातश्च कायनिः शाकटायनः ।\nऔर्वेया मारुताश्चैव सर्वेषां प्रवराः शुभाः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005722031, "chapter_id": 25722, "verse_number": "१९५-३२", "content_sanskrit": "भृगुश्च च्यवनश्चैव आप्नुवानस्तथैव च ।\nपरस्परमवैवाह्या ऋषयः परिकीर्तिताः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005722032, "chapter_id": 25722, "verse_number": "१९५-३३", "content_sanskrit": "भृगुदासो मार्गपथो ग्राम्यायनिकटायनी ।\nआपस्तम्बिस्तथा बिल्विर्नैकशिः कपिरेव च ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005722033, "chapter_id": 25722, "verse_number": "१९५-३४", "content_sanskrit": "आर्ष्टिषेणो गार्दभिश्च कार्दमायनिरेव च ।\nआश्वयनिस्तथारूपिर्ये चार्षेयाः प्रकीर्तिताः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005722034, "chapter_id": 25722, "verse_number": "१९५-३५", "content_sanskrit": "भृगुश्च च्यवनश्चैव आप्नुवानस्तथैव च ।\nआर्ष्टिषेणस्तथारूपिः प्रवराः पञ्चकीर्तिताः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7005722035, "chapter_id": 25722, "verse_number": "१९५-३६", "content_sanskrit": "परस्परमवैवाह्या ऋषयः परिकीर्तिताः ।\nयास्को वा वीतिहव्यो वा मथितस्तु तथादमः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7005722036, "chapter_id": 25722, "verse_number": "१९५-३७", "content_sanskrit": "जैवन्त्यायनिमौञ्चश्च पिलिश्चैव चलिस्तथा ।\nभागिलो बागवित्तिश्च कौशापिस्त्वथ काश्यपिः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7005722037, "chapter_id": 25722, "verse_number": "१९५-३८", "content_sanskrit": "बालपिः श्रमदागोपिः सौरस्तिथिस्तथैव च ।\nगार्गीयस्त्वथ जाबालिस्तथा पौष्ण्यायनो ह्यृषिः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7005722038, "chapter_id": 25722, "verse_number": "१९५-३९", "content_sanskrit": "ग्रामदश्च तथैतेषामार्षेयाः प्रवरा मताः ।\nभृगुश्च वीतहव्यश्च तथा रैवसवैवसौ ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7005722039, "chapter_id": 25722, "verse_number": "१९५-४०", "content_sanskrit": "परस्परमवैवाह्या ऋषयः परिकीर्तिताः ।\nशालायनिः शाकटाक्षो मैत्रेयः खाण्डवस्तथा ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7005722040, "chapter_id": 25722, "verse_number": "१९५-४१", "content_sanskrit": "द्रौणायनो रौक्मायना पिशली चापि कायनिः ।\nहंसजिह्वस्तथैतेषामार्षेयाः प्रवरा मताः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7005722041, "chapter_id": 25722, "verse_number": "१९५-४२", "content_sanskrit": "भृगुश्चैवाथ वध्य्रश्वो दिवोदासस्तथैव च ।\nपरस्परमवैवाह्या ऋषयः परिकीर्तिताः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7005722042, "chapter_id": 25722, "verse_number": "१९५-४३", "content_sanskrit": "एकायनो याज्ञपतिर्मत्स्यगन्धस्तथैव च ।\nप्रत्यूहश्च तथा सौरिश्चौक्षिर्वै कार्दमायनिः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7005722043, "chapter_id": 25722, "verse_number": "१९५-४४", "content_sanskrit": "तथा गृत्समदो राजन्! सनकश्च महान् ऋषिः ।\nप्रवरास्तु तथोक्तानामार्षेयाः परिकीर्तिताः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7005722044, "chapter_id": 25722, "verse_number": "१९५-४५", "content_sanskrit": "भृगुर्गृत्समदश्चैव आर्षावेतौ प्रकीर्त्तितौ ।\nपरस्परमवैवाह्या ऋषी वै परिकीर्तितौ ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7005722045, "chapter_id": 25722, "verse_number": "१९५-४६", "content_sanskrit": "एते तवोक्ता भृगुवंशजाता महानुभावा नृप गोत्रकाराः ।\nएषां तु नाम्ना परिकीर्तितेन पापं समग्रं विजहाति जन्तुः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]