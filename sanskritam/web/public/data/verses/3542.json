[{"id": 2118064, "chapter_id": 3542, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2118065, "chapter_id": 3542, "verse_number": "१", "content_sanskrit": "चारैः सञ्चारिते तस्मिन्ननुज्ञातो धनञ्जयः ।\nगतां रैवतके कन्यां विदित्वा जनमेजय \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2118066, "chapter_id": 3542, "verse_number": "२", "content_sanskrit": "वासुदेवाभ्यनुज्ञातः कथयित्वेतिकृत्यताम् ।\nकृष्णस्य मतमाज्ञाय प्रययौ भरतर्षभः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2118067, "chapter_id": 3542, "verse_number": "३", "content_sanskrit": "वृत्तोत्सवा रैवतके वृष्णयोऽप्यगमन् पुरीम् ।\nसुभद्राऽप्यथ शैलेन्द्रमभ्यर्च्य सह रैवतम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2118068, "chapter_id": 3542, "verse_number": "४", "content_sanskrit": "दैवतानि च सर्वाणि ब्राह्मणान् स्वस्ति वाच्य च ।\nप्रदक्षिणं गिरिं कृत्वा प्रययौ द्वारकां प्रति \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2118069, "chapter_id": 3542, "verse_number": "५", "content_sanskrit": "गतां रैवतकात् कन्यां प्रविष्टां द्वारकां प्रति ।\nचिन्तयानस्ततो भद्रामुपविष्टः शिलातळे \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2118070, "chapter_id": 3542, "verse_number": "६", "content_sanskrit": "रमणीये वनोद्देशे बहुपादपसंवृते ।\nसालतालाश्वकर्णैश्च बकुलैरर्जुनैस्तथा \t॥ ६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2118071, "chapter_id": 3542, "verse_number": "७", "content_sanskrit": "चम्पकाशोकपुन्नागैः केतकैः पाटलैस्तथा ।\nकर्णिकारैरशोकैश्च अङ्कोलैरतिमुक्तकैः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2118072, "chapter_id": 3542, "verse_number": "८", "content_sanskrit": "एवमादिभिरन्यैश्च संवृते स शिलातळे ।\nपुनः पुनश्चिन्तयानः सुभद्रां भद्रभाषिणीम् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2118073, "chapter_id": 3542, "verse_number": "८", "content_sanskrit": "यदृच्छया चोपपन्नान् वृष्णिवीरान् ददर्श ह ।\nबलदेवं च हार्दिक्यं साम्बं सारणमेव च \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2118074, "chapter_id": 3542, "verse_number": "९", "content_sanskrit": "प्रद्युम्नं च गदं चैव चारुदेष्णं विडूरथम् ।\nभानुं च निशठं चैव विपृथुं पृथुमेव च \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2118075, "chapter_id": 3542, "verse_number": "१०", "content_sanskrit": "तथाऽन्यांश्च बहून् पश्यन् हृदि शोकमधारयत् ।\nततस्ते सहिताः सर्वे यतिं दृष्ट्वा समुत्सुकाः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2118076, "chapter_id": 3542, "verse_number": "११", "content_sanskrit": "वृष्णयो विनयोपेताः परिवार्योपतस्थिरे ।\nततोऽर्जुनः प्रीतमनाः स्वागतं व्याजहार सः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2118077, "chapter_id": 3542, "verse_number": "१२", "content_sanskrit": "आस्यतामास्यतां सर्वै रमणीये शिलातळे ।\nइत्येवमुक्ता यतिना प्रीतास्ते यादवर्षभाः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2118078, "chapter_id": 3542, "verse_number": "१३", "content_sanskrit": "उपोपविविशुः सर्वे सुस्वागतमिति स्म ह ।\nपल्लवेषु निविष्टेषु वृष्णिवीरेषु पाण्डवः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2118079, "chapter_id": 3542, "verse_number": "१४", "content_sanskrit": "आकारं गूहमानस्तु कुशलप्रश्नमब्रवीत् ।\nसर्वत्र कुशलं चोक्त्वा बलदेवोऽब्रवीदिदम् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2118080, "chapter_id": 3542, "verse_number": "१५", "content_sanskrit": "प्रसादं कुरु मे विप्र कुतस्त्वं चागतो ह्यसि ।\nत्वया दृष्टानि पुण्यानि वदस्व वदतां वर ।\nपर्वतांश्चैव तीर्थानि वनान्यायतनानि च \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2118081, "chapter_id": 3542, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2118082, "chapter_id": 3542, "verse_number": "१६", "content_sanskrit": "तीर्थानां दर्शनं चैव पर्वतानां च भारत ।\nआपगानां वनानां च कथयामास यादवे \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2118083, "chapter_id": 3542, "verse_number": "१७", "content_sanskrit": "ताः कथाः कथयन्नेव कथान्ते जनमेजय ।\nकथां धर्मार्थसंयुक्तां वृष्णिवीरे न्यवेदयत् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2118084, "chapter_id": 3542, "verse_number": "१८", "content_sanskrit": "श्रुत्वा धर्मकथां पुण्यां वृष्णिवीरोऽभ्यपूजयत् ।\nततस्तु यादवाः सर्वे मन्त्रयन्ति स्म भारत \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2118085, "chapter_id": 3542, "verse_number": "१९", "content_sanskrit": "अयं देशातिथिः श्रीमान् यतिलिङ्गधरो द्विजः ।\nआवासं कमुपाश्रित्य वसेत निरुपद्रवः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2118086, "chapter_id": 3542, "verse_number": "२०", "content_sanskrit": "इत्येवं कथयन्तस्ते रौहिणेयेन यादवाः ।\nददृशुः कृष्णमायान्तं सर्वे यादवनन्दनम् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2118087, "chapter_id": 3542, "verse_number": "२१", "content_sanskrit": "एहि केशव तातेति रौहिणेयोऽब्रवीदिदम् ।\nयतिलिङ्गधरो विद्वान् देशातिथिरयं द्विजः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2118088, "chapter_id": 3542, "verse_number": "२२", "content_sanskrit": "वर्षरात्रनिवासार्थमागतो नगरं प्रति ।\nस्थाने यस्मिन् निवसति तन्मे ब्रूहि जनार्दन \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2118089, "chapter_id": 3542, "verse_number": "", "content_sanskrit": "भगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2118090, "chapter_id": 3542, "verse_number": "२३", "content_sanskrit": "त्वयि स्थिते महाभाग परवानस्मि धर्मतः ।\nस्वयं तु रुचिरे स्थाने वासयामुं हि मानद\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2118091, "chapter_id": 3542, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2118092, "chapter_id": 3542, "verse_number": "२४", "content_sanskrit": "सुप्रीतस्तेन वाक्येन परिष्वज्य जनार्दनम् ।\nबलदेवोऽब्रवीद् वाक्यं चिन्तयित्वा महाबलः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2118093, "chapter_id": 3542, "verse_number": "", "content_sanskrit": "बलदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2118094, "chapter_id": 3542, "verse_number": "२५", "content_sanskrit": "आरामे तु वसेद् धीमांश्चतुरो वर्षमासकान् ।\nकन्यापुरे सुभद्राया भुक्त्वा भोजनमिष्टतः \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2118095, "chapter_id": 3542, "verse_number": "२६", "content_sanskrit": "लतागृहेषु वसतामिति मे धीयते मतिः ।\nलब्धानुज्ञास्त्वया तत्र मन्यन्ते सर्वयादवाः \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2118096, "chapter_id": 3542, "verse_number": "", "content_sanskrit": "वासुदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2118097, "chapter_id": 3542, "verse_number": "२७", "content_sanskrit": "बलवान् दर्शनीयश्च वाग्मी श्रीमान् बहुश्रुतः ।\nकन्यापुरसमीपे तु न युक्तमिति मे मतिः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2118098, "chapter_id": 3542, "verse_number": "२८", "content_sanskrit": "गुरुः शास्ता च नेता च शास्त्रज्ञो धर्मवित्तमः ।\nत्वयोक्तं न विरुध्येऽहं करिष्यामि वचस्तव ।\nशुभाशुभस्य विज्ञाने नान्योऽस्ति भुवि कश्चन \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2118099, "chapter_id": 3542, "verse_number": "", "content_sanskrit": "बलदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2118100, "chapter_id": 3542, "verse_number": "२९", "content_sanskrit": "अयं देशातिथिः श्रीमान् सर्वधर्मविशारदः ।\nधृतिमान् विनयोपेतः सत्यवान् विजितेन्द्रियः \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2118101, "chapter_id": 3542, "verse_number": "३०", "content_sanskrit": "यतिलिङ्गधरो ह्येष को विजानाति मानसम् ।\nत्वमिमं पुण्डरीकाक्ष नीत्वा कन्यापुरं शुभम् \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2118102, "chapter_id": 3542, "verse_number": "३१", "content_sanskrit": "निवेदय सुभद्रायै मद्वाक्यपरिचोदितः ।\nभक्ष्यैर्भोज्यैश्च पानैश्च अन्यैरिष्टैश्च पूजय \t॥ ३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2118103, "chapter_id": 3542, "verse_number": "२२१", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nएकविंशत्यधिकद्विशततमोऽध्यायः ॥२२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2118104, "chapter_id": 3542, "verse_number": "२", "content_sanskrit": "॥ इति सुभद्राहरणपर्वणि द्वितीयोऽध्यायः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2118105, "chapter_id": 3542, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]