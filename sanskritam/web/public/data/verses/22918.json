[{"id": 7002918000, "chapter_id": 22918, "verse_number": "९-२०३-१", "content_sanskrit": "श्रीकृष्ण उवाच ।\nअतः परं प्रवक्ष्यामि रौप्याचलमनुत्तमम् ।\nयत्प्रदानान्नरो याति सोमलोकं नरोत्तम ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002918001, "chapter_id": 22918, "verse_number": "९-२०३-२", "content_sanskrit": "सहस्रेण पलानां तु उत्तमो रजताचलः ।\nपंचभिर्मध्यमः प्रोक्तस्तदर्द्धेनावरः स्मृतः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002918002, "chapter_id": 22918, "verse_number": "९-२०३-३", "content_sanskrit": "अशक्तो विंशतेरूर्ध्वं कारयेद्भक्तितः सदा ।\nविष्कंभपर्वतांस्तद्वत्तुरीयांशेन कल्पयेत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002918003, "chapter_id": 22918, "verse_number": "९-२०३-४", "content_sanskrit": "पूर्ववद्राजतान्कुर्यान्मंदरादीन्विधानतः ।\nकलधौतमयांस्तद्वल्लोकेशान्कारयेन्नृप ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002918004, "chapter_id": 22918, "verse_number": "९-२०३-५", "content_sanskrit": "ब्रह्मविष्णुशिवादींश्च नितंबोऽत्र हिरण्मयः ।\nराजतं स्याद्यदन्येषां सर्वं तदिह कांचनम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002918005, "chapter_id": 22918, "verse_number": "९-२०३-६", "content_sanskrit": "शेषं च पूर्ववत्कृत्वा होमजागरणादिकम् ।\nदद्यात्तद्वत्प्रभाते तु गुरवे रौप्यपर्वतम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002918006, "chapter_id": 22918, "verse_number": "९-२०३-७", "content_sanskrit": "विष्कंभशैलानृत्विग्भ्यः पूजयेच्च विभूषणैः ।\nइमं मंत्रं पठन्दद्याद्दर्भपाणिर्विमत्सरः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002918007, "chapter_id": 22918, "verse_number": "९-२०३-८", "content_sanskrit": "पितॄणां वल्लभं यस्माच्छर्मदं शंकरस्य च ।\nरजतं पाहि तस्मान्नो घोरात्संसारसागरात् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002918008, "chapter_id": 22918, "verse_number": "९-२०३-९", "content_sanskrit": "इत्थं निवेश्य यो दद्याद्रजताचलमुत्तमम् ।\nगवामयुतदानस्य फलं प्राप्नोति मानवः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002918009, "chapter_id": 22918, "verse_number": "९-२०३-१०", "content_sanskrit": "सोमलोके सगंधर्वकिंनराप्सरसां गणैः ।\nपूज्यमानो वसेद्विद्वान्यावदाभूतसंप्लवम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002918010, "chapter_id": 22918, "verse_number": "९-२०३-११", "content_sanskrit": "राजेश राजतगिरिं कनकोपलालीच्छन्नं प्रसन्नसलिले सहितं सरोभिः ।\nयच्छंति ये सुकृतिनो विरजो वि शोकं गच्छंति ते गतमला नृप सोमलोकम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}]