[{"id": 5000491000, "chapter_id": 9491, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे चतुरशीतितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000491001, "chapter_id": 9491, "verse_number": "६-८४-१", "content_sanskrit": "राममाश्वासमाने तु लक्ष्मणे भ्रातृवत्सले।\nनिक्षिप्य गुल्मान् स्वस्थाने तत्रागच्छद् विभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000491002, "chapter_id": 9491, "verse_number": "६-८४-२", "content_sanskrit": "नानाप्रहरणैर्वीरैश्चतुर्भिरभिसंवृतः।\nनीलाञ्जनचयाकारैर्मातंगैरिव यूथपैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000491003, "chapter_id": 9491, "verse_number": "६-८४-३", "content_sanskrit": "सोऽभिगम्य महात्मानं राघवं शोकलालसम्।\nवानरांश्चापि ददृशे बाष्पपर्याकुलेक्षणान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000491004, "chapter_id": 9491, "verse_number": "६-८४-४", "content_sanskrit": "राघवं च महात्मानमिक्ष्वाकुकुलनन्दनम्।\nददर्श मोहमापन्नं लक्ष्मणस्याङ्कमाश्रितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000491005, "chapter_id": 9491, "verse_number": "६-८४-५", "content_sanskrit": "व्रीडितं शोकसंतप्तं दृष्ट्वा रामं विभीषणः।\nअन्तर्दुःखेन दीनात्मा किमेतदिति सोऽब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000491006, "chapter_id": 9491, "verse_number": "६-८४-६", "content_sanskrit": "विभीषणमुखं दृष्ट्वा सुग्रीवं तांश्च वानरान्।\nलक्ष्मणोवाच मन्दार्थमिदं बाष्पपरिप्लुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000491007, "chapter_id": 9491, "verse_number": "६-८४-७", "content_sanskrit": "हता इन्द्रजिता सीता इति श्रुत्वैव राघवः।\nहनूमद्वचनात् सौम्य ततो मोहमुपाश्रितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000491008, "chapter_id": 9491, "verse_number": "६-८४-८", "content_sanskrit": "कथयन्तं तु सौमित्रिं संनिवार्य विभीषणः।\nपुष्कलार्थमिदं वाक्यं विसंज्ञं राममब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000491009, "chapter_id": 9491, "verse_number": "६-८४-९", "content_sanskrit": "मनुजेन्द्रार्तरूपेण यदुक्तस्त्वं हनूमता।\nतदयुक्तमहं मन्ये सागरस्येव शोषणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000491010, "chapter_id": 9491, "verse_number": "६-८४-१०", "content_sanskrit": "अभिप्रायं तु जानामि रावणस्य दुरात्मनः।\nसीतां प्रति महाबाहो न च घातं करिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000491011, "chapter_id": 9491, "verse_number": "६-८४-११", "content_sanskrit": "याच्यमानः सुबहुशो मया हितचिकीर्षुणा।\nवैदेहीमुत्सृजस्वेति न च तत् कृतवान् वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000491012, "chapter_id": 9491, "verse_number": "६-८४-१२", "content_sanskrit": "नैव साम्ना न दानेन न भेदेन कुतो युधा।\nसा द्रष्टुमपि शक्येत नैव चान्येन केनचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000491013, "chapter_id": 9491, "verse_number": "६-८४-१३", "content_sanskrit": "वानरान् मोहयित्वा तु प्रतियातः स राक्षसः।\nमायामयीं महाबाहो तां विद्धि जनकात्मजाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000491014, "chapter_id": 9491, "verse_number": "६-८४-१४", "content_sanskrit": "चैत्यं निकुम्भिलामद्य प्राप्य होमं करिष्यति।\nहुतवानुपयातो हि देवैरपि सवासवैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000491015, "chapter_id": 9491, "verse_number": "६-८४-१५", "content_sanskrit": "दुराधर्षो भवत्येष संग्रामे रावणात्मजः।\nतेन मोहयता नूनमेषा माया प्रयोजिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000491016, "chapter_id": 9491, "verse_number": "६-८४-१६", "content_sanskrit": "विघ्नमन्विच्छता तत्र वानराणां पराक्रमे।\nससैन्यास्तत्र गच्छामो यावत्तन्न समाप्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000491017, "chapter_id": 9491, "verse_number": "६-८४-१७", "content_sanskrit": "त्यजैनं नरशार्दूल मिथ्या संतापमागतम्।\nसीदते हि बलं सर्वं दृष्ट्वा त्वां शोककर्शितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000491018, "chapter_id": 9491, "verse_number": "६-८४-१८", "content_sanskrit": "इह त्वं स्वस्थहृदयस्तिष्ठ सत्त्वसमुच्छ्रितः।\nलक्ष्मणं प्रेषयास्माभिः सह सैन्यानुकर्षिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000491019, "chapter_id": 9491, "verse_number": "६-८४-१९", "content_sanskrit": "एष तं नरशार्दूलो रावणिं निशितैः शरैः।\nत्याजयिष्यति तत्कर्म ततो वध्यो भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000491020, "chapter_id": 9491, "verse_number": "६-८४-२०", "content_sanskrit": "तस्यैते निशितास्तीक्ष्णाः पत्रिपत्राङ्गवाजिनः।\nपतत्त्रिण इवासौम्याः शराः पास्यन्ति शोणितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000491021, "chapter_id": 9491, "verse_number": "६-८४-२१", "content_sanskrit": "तत् संदिश महाबाहो लक्ष्मणं शुभलक्षणम्।\nराक्षसस्य विनाशाय वज्रं वज्रधरो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000491022, "chapter_id": 9491, "verse_number": "६-८४-२२", "content_sanskrit": "मनुजवर न कालविप्रकर्षो\nरिपुनिधनं प्रति यत्क्षमोऽद्य कर्तुम्।\nत्वमतिसृज रिपोर्वधाय वज्रं\nदिविजरिपोर्मथने यथा महेन्द्रः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000491023, "chapter_id": 9491, "verse_number": "६-८४-२३", "content_sanskrit": "समाप्तकर्मा हि स राक्षसर्षभो\nभवत्यदृश्यः समरे सुरासुरैः।\nयुयुत्सता तेन समाप्तकर्मणा\nभवेत् सुराणामपि संशयो महान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000491024, "chapter_id": 9491, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमद्युद्धकाण्डे चतुरशीतितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]