[{"id": 2112269, "chapter_id": 3422, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2112270, "chapter_id": 3422, "verse_number": "१", "content_sanskrit": "हते चित्राङ्गदे भीष्मो बाले भ्रातरि चानधे ।\nपालयामास तद्राज्यं सत्यवत्या मते स्थितः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2112271, "chapter_id": 3422, "verse_number": "२", "content_sanskrit": "तथा विचित्रवीर्यं तु वर्तमानं सुखेऽतुले ।\nसम्प्राप्तयौवनं पश्यन् भ्रातरं घीमतां वरम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2112272, "chapter_id": 3422, "verse_number": "३", "content_sanskrit": "भीष्मो विचित्रवीर्यस्य विवाहायोपचक्रमे ।\nततः काशीपतेर्भीष्मः कन्यास्तिस्रोऽप्सरःसमाः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2112273, "chapter_id": 3422, "verse_number": "४", "content_sanskrit": "शुश्राव सहिता राजन् वृण्वन्तीर्वै स्वयंवरे ।\nततः स रथिनां श्रेष्ठो रथेनैकेन धर्मभृत् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2112274, "chapter_id": 3422, "verse_number": "५", "content_sanskrit": "जगामानुमते मातुः पुरीं वाराणसीं प्रति ।\nतत्र राज्ञः समुदितान् सर्वतः समुपागतान् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2112275, "chapter_id": 3422, "verse_number": "६", "content_sanskrit": "ददर्श कन्यास्ताश्चैव भीष्मः शन्तनुनन्दनः ।\nतासां कामेन सम्मत्ताः सहिताः काशिकोसलाः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2112276, "chapter_id": 3422, "verse_number": "७", "content_sanskrit": "वङ्गाः पुण्ड्राः कलिङ्गाश्च ते जग्मुस्तां पुरीं प्रति ।\nकीर्त्यमानेषु राज्ञां तु नामधेयेषु भारत \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2112277, "chapter_id": 3422, "verse_number": "८", "content_sanskrit": "एकाकिनं तदा भीष्मं वृद्धं शन्तनुनन्दनम् ।\nसोद्वेगा इव तं दृष्ट्वा कन्याः परमशोभनाः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2112278, "chapter_id": 3422, "verse_number": "९", "content_sanskrit": "अपाक्रामन्त ताः सर्वा वृद्व इत्येव चिन्तया ।\nवृद्धः परमधर्मात्मा वलीपलितदारुणः ।\nकिं कारणमिहायातो निर्लज्जो भारतर्षभः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2112279, "chapter_id": 3422, "verse_number": "१०", "content_sanskrit": "मिथ्यावृत्तो हि लोकेषु किं वदिष्यति भारतम् ।\nव्रह्मचारीति भीष्मो हि वृथैव प्रथितो भुवि \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2112280, "chapter_id": 3422, "verse_number": "११", "content_sanskrit": "इत्येवं प्रब्रुवन्तस्ते हसन्ति स्म नृपोत्तमाः ।\nक्षत्रियाणां वचः श्रुत्वा भीष्मश्चुक्रोध भारत \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2112281, "chapter_id": 3422, "verse_number": "१२", "content_sanskrit": "भीष्मस्तदा स्वयं कन्या वरयामास ताः प्रभुः ।\nउवाच च महीपालान् राजन् जलदनिस्वनः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2112282, "chapter_id": 3422, "verse_number": "१३", "content_sanskrit": "रथमारोप्य ताः कन्या भीष्मो भीमपराक्रमः ।\nआहूय दानं कन्यानां गुणवद्भ्यः स्मृतं बुधैः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2112283, "chapter_id": 3422, "verse_number": "१५", "content_sanskrit": "अलङ्कृत्य यथाशक्ति प्रदाय च धनान्युत ।\nप्रयच्छन्त्यपरे कन्यां मिथुनेन गवामपि \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2112284, "chapter_id": 3422, "verse_number": "१६", "content_sanskrit": "वित्तेन कथितेनान्ये बलादन्येऽनुमान्य च ।\nप्रमत्तामुपयान्त्यन्ये स्वयं गृह्णन्ति चापरे \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2112285, "chapter_id": 3422, "verse_number": "१७", "content_sanskrit": "अष्टमं तु मिथोवृत्तं विवाहं कविभिः स्मृतम् ।\nस्वयंवरं तु राजन्याः प्रशंसन्त्युपयान्ति च\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2112286, "chapter_id": 3422, "verse_number": "१८", "content_sanskrit": "सम्प्रमथ्य हृतामाहुर्ज्यायसीं धर्मचारिणः ।\nता इमाः पृथिवीपाला जिहीर्षामि प्रसँह्य वः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2112287, "chapter_id": 3422, "verse_number": "१९", "content_sanskrit": "ते यतध्वं यथाकामं विजयायेतराय वा ।\nस्थितोऽहं पृथिवीपाला युद्धाय कृतनिश्चयः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2112288, "chapter_id": 3422, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2112289, "chapter_id": 3422, "verse_number": "२०", "content_sanskrit": "एवमुक्त्वा महीपालान् काशिराजं च वीर्यवान् ।\nसर्वाः कन्याः स कौरव्यो रथमारोपयत् स्वकम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2112290, "chapter_id": 3422, "verse_number": "२१", "content_sanskrit": "आमन्त्र्य प्रययौ क्षिप्रं भीष्मो वै जनमेजय ।\nततस्ते पार्थिवाः सर्वे समुत्पेतुरमर्षिताः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2112291, "chapter_id": 3422, "verse_number": "२३", "content_sanskrit": "संस्पृशन्तः स्वकान् बाहून् सन्दश्य दशनच्छदान् ।\nतेषामाभरणान्याशु कवचानि महान्ति च \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2112292, "chapter_id": 3422, "verse_number": "२४", "content_sanskrit": "आमुञ्चतां च वर्माणि सम्भ्रमः समपद्यत ।\nताराणामिव सम्पातो बभूव जनमेजय \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2112293, "chapter_id": 3422, "verse_number": "२५", "content_sanskrit": "भूषणानां च हैमानां कवचानां च सर्वशः ।\nवर्मभिर्भूषणैर्मुख्यैः प्रज्वलद्भिः समन्ततः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2112294, "chapter_id": 3422, "verse_number": "२६", "content_sanskrit": "सक्रोधामर्षजिह्वास्याः कषन्तो दशनांस्तदा ।\nसूतोपक्लृप्तान् सुदृढान् सततोद्यतधूर्वहान् \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2112295, "chapter_id": 3422, "verse_number": "२७", "content_sanskrit": "रथानास्थाय ते वीराः सर्वोपकरणान्विताः ।\nप्रयान्तमेकं कौरव्यमनुसस्रुरुदायुधाः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2112296, "chapter_id": 3422, "verse_number": "२८", "content_sanskrit": "ततः समभवद् युद्धं तेषां तस्य च भारत ।\nएकस्य च बहूनां च तुमुलं रोमहर्षणम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2112297, "chapter_id": 3422, "verse_number": "२९", "content_sanskrit": "ते त्विषून् दशसाहस्रांस्तस्मै युगपदक्षिपन् ।\nअप्राप्तान् सोऽच्छिनत् सर्वांस्तदद्भुतमिवाभवत् \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2112298, "chapter_id": 3422, "verse_number": "२९", "content_sanskrit": "ततस्ते पार्थिवाः सर्वे सर्वतः पर्यवारयन् ।\nमहता शरवर्षेण वर्षेणेवाम्बुदा गिरिम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2112299, "chapter_id": 3422, "verse_number": "३०", "content_sanskrit": "तत् तु बाणमयं वर्षं स तेषामावृणोच्छरैः ।\nतांश्च सर्वान् महीपालान् प्रत्यविध्यत् त्रिभिस्त्रिभिः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2112300, "chapter_id": 3422, "verse_number": "३१", "content_sanskrit": "तस्यातिलाघवं कर्म पौरुषं लघुकारिणः ।\nरक्षणं चात्मनः सर्वे शत्रवो ह्मभ्यपूजयन्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2112301, "chapter_id": 3422, "verse_number": "३२", "content_sanskrit": "अक्षतः क्षपयित्वाऽन्यान् असङ्ख्येयपराक्रमः ।\nआनिनाय स काश्यस्य सुताः सागरगासुतः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2112302, "chapter_id": 3422, "verse_number": "३३", "content_sanskrit": "तान् निहत्य रणे सर्वान् सर्वशस्त्रविशारदः ।\nकन्याभिः सहितो यातो भारतो भारतान् प्रति \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2112303, "chapter_id": 3422, "verse_number": "३४", "content_sanskrit": "ततस्तं पृष्ठतो राजा साल्वानामीश्वरः प्रभुः ।\nअभ्यागमदमेयात्मा भीष्मं शान्तनवं रणे \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2112304, "chapter_id": 3422, "verse_number": "३५", "content_sanskrit": "कुञ्जरं जघने निघ्नन् दन्ताभ्यामपरो यथा ।\nवासितासमये यत्तो यूथपो बलिनां वरः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2112305, "chapter_id": 3422, "verse_number": "३६", "content_sanskrit": "स्त्रीकाम तिष्ठ तिष्ठेति साल्वश्चाह स पार्थिवः ।\nसाल्वेनैवं महाबाहुरमर्षेणाभिचोदितः \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2112306, "chapter_id": 3422, "verse_number": "३७", "content_sanskrit": "ततः स पुरुषव्याघ्रो भीष्मः परबलार्दनः ।\nसाल्वराजं सुसङ्क्रुद्धो न्यवर्तत परन्तपः \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2112307, "chapter_id": 3422, "verse_number": "३८", "content_sanskrit": "क्रोधेन सम्प्रज्वलितो विधूम इव पावकः ।\nदहन् यथा कृष्णगतिः कक्षं वातेरितः प्रभुः \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2112308, "chapter_id": 3422, "verse_number": "३९", "content_sanskrit": "क्षत्रधर्मं समास्थाय अभीतो राजसत्तमः ।\nनिवर्तयामास रथं भीष्मः प्रहरतां वरः \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2112309, "chapter_id": 3422, "verse_number": "४०", "content_sanskrit": "निवृत्तं तेन तं दृष्ट्वा हतशेषा हि पार्थिवाः ।\nप्रेक्षकाः समपद्यन्त भीष्मसाल्वसमागमे \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2112310, "chapter_id": 3422, "verse_number": "४१", "content_sanskrit": "गोवृषाविव नर्दन्तौ बलिनौ वासितान्तरे ।\nअन्योन्यमभ्यवर्तेतां बलविक्रमशालिनौ\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2112311, "chapter_id": 3422, "verse_number": "४२", "content_sanskrit": "ततः क्रुद्धं शान्तनवो दृष्ट्वा तं नृपमागतम् ।\nसाल्वेश्वरं स राजानं हयान् क्रुद्धोऽभ्यचोदयत्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2112312, "chapter_id": 3422, "verse_number": "४३", "content_sanskrit": "संस्पृशंश्च धनुश्श्रेष्ठं सज्यं कृत्वा नरर्षभः ।\nसमुपस्थाय दुर्धर्षः सशरः सशरासनः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2112313, "chapter_id": 3422, "verse_number": "४४", "content_sanskrit": "अभ्यद्रवत् साल्वपतिं युद्धार्थी कुरुपुङ्गवः ।\nकवची बद्धनिस्त्रिंशस्तलबन्धः प्रतापवान् \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2112314, "chapter_id": 3422, "verse_number": "४५", "content_sanskrit": "तिष्ठतिष्ठेति राजानं साल्वं शान्तनवोऽब्रवीत् ।\nयुद्धार्थी वै ततः साल्वं प्रावर्तत महाबलः \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2112315, "chapter_id": 3422, "verse_number": "४६", "content_sanskrit": "ततस्तु युद्धमभवत् तदा राजन् स्वयंवरे ।\nभीष्मस्य चैव राजर्षेः साल्वस्य च महीपतेः \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2112316, "chapter_id": 3422, "verse_number": "४७", "content_sanskrit": "ततो भीष्मं शान्तनवं शरैरावारयत् दिशः ।\nसाल्वराजो नरश्रेष्ठ बह्वशोभत भारत \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2112317, "chapter_id": 3422, "verse_number": "४८", "content_sanskrit": "विव्याध च तथा भीष्मं वामपार्श्वे स्तनान्तरे ।\nत्वरमाणस्त्वराकाले क्षत्रियर्षभसत्तमः \t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2112318, "chapter_id": 3422, "verse_number": "४९", "content_sanskrit": "दृष्ट्वा तु भीष्मं व्रणिनं राज्ञा साल्वेन ते नृपाः ।\nविस्मिताः समपद्यन्त साधुसाध्विति चाब्रुवन्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2112319, "chapter_id": 3422, "verse_number": "५०", "content_sanskrit": "लाघवं तस्य ते दृष्ट्वा पृथिव्यां सर्वपार्थिवाः ।\nसाल्वं सम्पूजयामासुर्वाग्भिर्नृपतिपुङ्गवम् \t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2112320, "chapter_id": 3422, "verse_number": "५१", "content_sanskrit": "क्षत्रियाणां तु ताः श्रुत्वा वाचः परपुरञ्जयः ।\nक्रुद्धः शान्तनवः साल्वं तिष्ठतिष्ठेति चाब्रवीत्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2112321, "chapter_id": 3422, "verse_number": "५२", "content_sanskrit": "सारथिं चाब्रवीद् भीष्मो याहि यत्रैष पार्थिवः ।\nयावदेनं निहन्म्यद्य भुजङ्गमिव पक्षिराट्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2112322, "chapter_id": 3422, "verse_number": "५३", "content_sanskrit": "तदस्त्रं दारुणं सम्यग् योजयामास पार्थिवः ।\nतेनाश्वांश्चतुरोऽमृद्नात् साल्वराजस्य पार्थिवः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2112323, "chapter_id": 3422, "verse_number": "५४", "content_sanskrit": "अस्त्रैरस्त्राणि संवार्य भीष्मस्तस्य परन्तपः ।\nततो नृपतिशार्दूलो न्यहनत् तस्य सारथिम्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2112324, "chapter_id": 3422, "verse_number": "५५", "content_sanskrit": "अस्त्रेण चास्य साल्वस्य न्यहनत् तुरगोत्तमान् ।\nसाल्वस्तु विरथो राजन् हताश्वो हतसारथिः \t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2112325, "chapter_id": 3422, "verse_number": "५६", "content_sanskrit": "निक्षिप्य च धनुः श्रीमान् भूमौ तिष्ठदवाङ्मुखः ।\nकन्याहेतोर्विजित्यैनं भीष्मः शान्तनवस्तदा\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2112326, "chapter_id": 3422, "verse_number": "५७", "content_sanskrit": "विसर्जयामास नृपं जीवन्तं तं नराधिपः ।\nततो विजित्य ताः कन्यास्तिस्रो रूपगुणान्विताः \t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2112327, "chapter_id": 3422, "verse_number": "५८", "content_sanskrit": "प्रययौ हस्तिनपुरं भीष्मः शान्तनवस्तदा ।\nययौ पुण्यं कुरुक्षेत्रं यत्र राजा स कौरवः \t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2112328, "chapter_id": 3422, "verse_number": "५९", "content_sanskrit": "साल्वोऽपि राजा स्वं राष्ट्रं सम्प्राप्तो नचिरादिव ।\nराजानस्तत्र ये चासन् स्वयंवरदिदृक्षवः \t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2112329, "chapter_id": 3422, "verse_number": "६०", "content_sanskrit": "तेऽपि स्वान्येव राष्ट्राणि हतशेषाः प्रचक्रमुः ।\nते वनानि च रम्याणि शैलांश्च सरितस्तथा \t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2112330, "chapter_id": 3422, "verse_number": "६१", "content_sanskrit": "अतिक्रम्य च राजानः स्वंस्वं राज्यं प्रचक्रमुः ।\nभीष्मः स्वयंवरे कन्या विजित्य कुरुसत्तमः \t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2112331, "chapter_id": 3422, "verse_number": "६२", "content_sanskrit": "वनानि सरितश्चापि शैलांश्च विविधद्रुमान् ।\nअक्षतः क्षपयित्वाऽरींस्तानसङ्ख्येयविक्रमः \t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2112332, "chapter_id": 3422, "verse_number": "६३", "content_sanskrit": "सोऽचिरेणैव कालेन समतिक्रम्य बुद्धिमान् ।\nआनयामास काश्यस्य सुताः सागरगासुतः \t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2112333, "chapter_id": 3422, "verse_number": "६४", "content_sanskrit": "ताः स्नुषा इव धर्मात्मा भगिनीरनुजा इव ।\nपिता यथा च दुहितॄः प्रगृह्म प्रययौ कुरून्\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2112334, "chapter_id": 3422, "verse_number": "६५", "content_sanskrit": "स तु धर्मेण धर्मज्ञो कर्म कृत्वाऽतिमानुषम् ।\nताः सर्वा गुणसम्पन्ना भ्राता भ्रात्रे यवीयसे \t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2112335, "chapter_id": 3422, "verse_number": "६६", "content_sanskrit": "भीष्मो विचित्रवीर्याय विक्रम्य मुदितो ददौ ।\nस तु धर्मेण धर्मज्ञो विधिदृष्टेत कर्मणा\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2112336, "chapter_id": 3422, "verse_number": "६७", "content_sanskrit": "भ्रातुर्विचित्रवीर्यस्य विवाहमुपचक्रमे ।\nसत्यवत्याः समीपेऽथ कृत्वा निश्चयमात्मवान् \t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2112337, "chapter_id": 3422, "verse_number": "६८", "content_sanskrit": "विवाहं कारयिष्यन्तं भीष्मं काशीपतेः सुता ।\nज्येष्ठा तासामिदं वाक्यमब्रवीज्जनसंसदि \t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2112338, "chapter_id": 3422, "verse_number": "६९", "content_sanskrit": "मया साल्वपतिः पूर्वं मनसा हि वृतः पतिः ।\nतेन चास्मि वृता राजंस्तथाकामश्च मे पतिः\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2112339, "chapter_id": 3422, "verse_number": "७०", "content_sanskrit": "मया वरयितव्योऽसौ साल्वस्तस्मिन् स्वयंवरे ।\nएतद् विज्ञाय धर्मज्ञ धर्मतस्त्वं समाचर \t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2112340, "chapter_id": 3422, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2112341, "chapter_id": 3422, "verse_number": "७१", "content_sanskrit": "एवमुक्तस्ततो भीष्मः कन्यया विप्रसंसदि ।\nचिन्तामभ्यगमद् वीरो युक्तां तस्यैव कर्मणः \t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2112342, "chapter_id": 3422, "verse_number": "७२", "content_sanskrit": "अन्यासक्ता त्वियं कन्या ज्येष्ठा क्षत्रे मयाऽऽर्जिता ।\nवाचा दत्ता मनोदत्ता कृतमङ्गलवाचना\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2112343, "chapter_id": 3422, "verse_number": "७३", "content_sanskrit": "निर्दिष्टा तु परस्यैव सा वर्ज्या परचिन्तनी ।\nइत्युक्त्वा चानुमान्यैव भ्रातरं स्ववशानुगम् \t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2112344, "chapter_id": 3422, "verse_number": "७४", "content_sanskrit": "स विनिश्चित्य तैः सार्धं ब्राह्मणैर्धर्मकोविदैः ।\nअनुजज्ञे ततो ज्येष्ठामम्बां काशीपतेः सुताम्\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2112345, "chapter_id": 3422, "verse_number": "७५", "content_sanskrit": "अम्बिकाम्बालिके भार्ये प्रादाद् भ्रात्रे यवीयसे ।\nभीष्मो विचित्रवीर्याय विधिदृष्टेन कर्मणा \t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2112346, "chapter_id": 3422, "verse_number": "७६", "content_sanskrit": "तयोः पाणी गृहीत्वा स रूपयौवनदर्पितः ।\nविचित्रवीर्यो धर्मात्मा नैनामैच्छत् कथञ्चन ।\nअम्बामन्यस्य कीर्त्यन्तीम् अब्रवीच्चारुदर्शनाम्\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2112347, "chapter_id": 3422, "verse_number": "", "content_sanskrit": "विचित्रवीर्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2112348, "chapter_id": 3422, "verse_number": "७७", "content_sanskrit": "प्रत्यक्षफल एवैष कामोऽसाधुर्निरर्थकः ।\nपरतन्त्रोपभोगे मामार्य नाऽऽयोक्तुमर्हसि \t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2112349, "chapter_id": 3422, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2112350, "chapter_id": 3422, "verse_number": "७८", "content_sanskrit": "प्रतिष्ठितः शन्तनोर्वंशे तात यस्य त्वमन्वये ।\nअकामवृत्तो धर्मात्मा साधु मन्ये व्रतं तव \t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2112351, "chapter_id": 3422, "verse_number": "७९", "content_sanskrit": "इत्युक्त्वाऽम्बां समालोक्य विधिवद् वाक्यमब्रवीत् ।\nविसृष्टा ह्मसि गच्छ त्वं यथाकाममनिन्दिते \t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2112352, "chapter_id": 3422, "verse_number": "८०", "content_sanskrit": "माऽनियोज्ये समर्थोऽहं नियोक्तुं भ्रातरं प्रियम् ।\nअन्यभावगतां चापि को नारीं वासयेद् गृहे \t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2112353, "chapter_id": 3422, "verse_number": "८१", "content_sanskrit": "अतस्त्वां न नियोक्ष्यामि अन्यकामाऽसि गम्यताम् ।\nअहमप्यूर्ध्वरेता वै निवृत्तो दारकर्मणि ।\nन सम्बन्धस्तदावाभ्यां भविता वै कथञ्चन \t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2112354, "chapter_id": 3422, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2112355, "chapter_id": 3422, "verse_number": "८२", "content_sanskrit": "इत्युक्ता सा गता तत्र सखीभिः परिपालिता ।\nनिर्दिष्टा हि शनै राजन् साल्वराजपुरं प्रति\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2112356, "chapter_id": 3422, "verse_number": "८३", "content_sanskrit": "अथाम्बा साल्वमागम्य साऽब्रवीन्मनसा वृता ।\nपुरा निर्दिष्टभावा त्वामागतास्मि वरानन \t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2112357, "chapter_id": 3422, "verse_number": "८४", "content_sanskrit": "देवव्रतं समुत्सृज्य सानुजं पुरुषर्षभ ।\nप्रतिगृह्णीष्व भद्रं ते विधिवन्मां समुद्यताम्\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2112358, "chapter_id": 3422, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2112359, "chapter_id": 3422, "verse_number": "८५", "content_sanskrit": "एवमुक्तस्तु साल्वोऽपि प्रहसन्निदमब्रवीत् ।\nनिर्जितासीह भीष्मेण मां विनिर्जित्य राजसु \t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2112360, "chapter_id": 3422, "verse_number": "८६", "content_sanskrit": "अन्येन निर्जितां भद्रे विसृष्टां तेन चालयात् ।\nन गृह्णामि वरारोहे तत्र चैव तु गम्यताम्\t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2112361, "chapter_id": 3422, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2112362, "chapter_id": 3422, "verse_number": "८७", "content_sanskrit": "इत्युक्ता सा समागम्य भीष्मं पुनरथाब्रवीत् ।\nभीष्म त्वयाऽहं सहसा हृता तस्मिन् स्वयंवरे \t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2112363, "chapter_id": 3422, "verse_number": "८८", "content_sanskrit": "क्षत्रधर्ममवेक्षस्व भर्ता त्वं मम धर्मतः ।\nऊर्ध्वरेताऽस्म्यहमिति प्रत्युवाच पुनःपुनः\t॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2112364, "chapter_id": 3422, "verse_number": "८९", "content_sanskrit": "भीष्मः सा चाब्रवीद् भीष्मं यथाऽजैषीस्तथा कुरु ।\nऊर्ध्वरेतास्त्वहं भद्रे विवाहविमुखोऽभवम् \t॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2112365, "chapter_id": 3422, "verse_number": "९०", "content_sanskrit": "तत्त्वेन साल्वं गच्छ त्वं यः पुरा मनसा वृतः ।\nअन्यसक्तां किमर्थं त्वमात्मानमवदः पुरा \t॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2112366, "chapter_id": 3422, "verse_number": "९१", "content_sanskrit": "अन्यसक्तां वधूं कन्यां वासयेत् स्वगृहे नहि ।\nनाहमुद्वाहयिष्ये त्वा मम भ्रात्रे यवीयसे \t॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2112367, "chapter_id": 3422, "verse_number": "९२", "content_sanskrit": "विचित्रवीर्याय शुभे यथेष्टं गम्यतामिति ।\nभूयः साल्वं समभ्येत्य राजन् गृह्णीष्व मामिति \t॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2112368, "chapter_id": 3422, "verse_number": "९३", "content_sanskrit": "नाहं गृह्णाम्यन्यजितामिति साल्वनिराकृताम् ।\nऊर्ध्वरेतास्त्वहमिति प्रत्युवाच पुनःपुनः \t॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2112369, "chapter_id": 3422, "verse_number": "९४", "content_sanskrit": "पुनः सा चाब्रवीद् भीष्मं यथाऽजैषीस्तथा कृरु ।\nअम्बा भीष्मं पुनः साल्वं भीष्मं साल्वं पुनः पुनः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2112370, "chapter_id": 3422, "verse_number": "९५", "content_sanskrit": "एवमन्वगमद् भीष्मं षट् समाः पुष्करेक्षणा ।\nअश्रुभिर्भूमिमुक्षन्ती तपन्ती च मनस्विनी \t॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2112371, "chapter_id": 3422, "verse_number": "९६", "content_sanskrit": "ततोऽन्या द्वादश समा बाहुदामभितो नदीम् ।\nपार्श्वे हिमवतो रम्ये तपो घोरं समाददे \t॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2112372, "chapter_id": 3422, "verse_number": "९७", "content_sanskrit": "सङ्क्षिप्तकरणा तत्र तप आस्थाय सुव्रता ।\nपादाङ्गुष्ठेन साऽतिष्ठदकम्पन्त ततः सुराः \t॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2112373, "chapter_id": 3422, "verse_number": "९८", "content_sanskrit": "तस्यास्तीव्रं तपो दृष्ट्वा सुराणां क्षोभकारणम् ।\nविस्मितश्चैव हृष्टश्च तस्यानुग्रहबुद्धिना \t॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2112374, "chapter_id": 3422, "verse_number": "९९", "content_sanskrit": "अनन्तसेनो भगवान् कुमारः सर्वतः प्रभुः ।\nमानयन् राजपुर्त्री तां ददौ तस्यै शुभां स्रजम्\t॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2112375, "chapter_id": 3422, "verse_number": "१००", "content_sanskrit": "एषा पुष्करिणी दिव्या यथावत् समुपस्थिता ।\nअम्बे त्वच्छोकशमनी माला भुवि भविष्यति\t॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2112376, "chapter_id": 3422, "verse_number": "१०१", "content_sanskrit": "एतां चैव मया दत्तां यो मालां धारयिष्यति ।\nसोऽस्य भीष्मस्य निधने कारणं वै भविष्यति\t॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2112377, "chapter_id": 3422, "verse_number": "१०१", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nएकोत्तरशततमोऽध्यायः ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2112378, "chapter_id": 3422, "verse_number": "४९", "content_sanskrit": "॥ इति सम्भवपर्वणि एकोनपञ्चाशोऽध्यायः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2112379, "chapter_id": 3422, "verse_number": "", "content_sanskrit": "* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}]