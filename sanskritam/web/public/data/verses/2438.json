[{"id": 2068531, "chapter_id": 2438, "verse_number": "९-५६-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2068532, "chapter_id": 2438, "verse_number": "९-५६-१", "content_sanskrit": "रामसान्निध्यमागम्य पुत्रो दुर्योधनस्तव।\nयोद्धुकामो महाबाहुः समहृष्यत वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2068533, "chapter_id": 2438, "verse_number": "९-५६-२", "content_sanskrit": "दृष्ट्वा लाङ्गलिनं राजा प्रत्युत्थाय च भारत।\nप्रीत्या* परमया युक्तो युधिष्ठिरमथाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2068534, "chapter_id": 2438, "verse_number": "९-५६-३x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2068535, "chapter_id": 2438, "verse_number": "९-५६-३", "content_sanskrit": "समन्तपञ्चकं पुण्यमितो याम विशाम्पते।\nप्रथितोत्तरवेदी सा देवलोके प्रजापतेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2068536, "chapter_id": 2438, "verse_number": "९-५६-४", "content_sanskrit": "तस्मिन्महापुण्यतमे त्रैलोक्यस्य सनातने।\nसङ्ग्रामे निधनं प्राप्य ध्रुवं स्वर्गं गमिष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2068537, "chapter_id": 2438, "verse_number": "९-५६-५", "content_sanskrit": "तथेत्युक्त्वा महाराज कुन्तीपुत्रो युधिष्ठिरः।\nसमन्तपञ्चकं वीरः प्रायादभिमुखः प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2068538, "chapter_id": 2438, "verse_number": "९-५६-६", "content_sanskrit": "ततो दुर्योधनो राजा प्रगृह्य महतीं गदाम्।\nपद्ध्याममर्षी द्युतिमानगच्छत्पाण्डवैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2068539, "chapter_id": 2438, "verse_number": "९-५६-७", "content_sanskrit": "तथा यान्तं गदाहस्तं वर्मणा चापि दंशितम्।\nअन्तरिक्षचरा देवाः साधुसाध्वित्यपूजयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2068540, "chapter_id": 2438, "verse_number": "९-५६-८", "content_sanskrit": "वादकाश्च नरास्तत्र दृष्ट्वा ते हर्षमागताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2068541, "chapter_id": 2438, "verse_number": "९-५६-९", "content_sanskrit": "स पाण्डवैः परिवृतः कुरुराजस्तवात्मजः।\nमत्तस्येव गजेन्द्रस्य गतिमास्थाय सोऽव्रजत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2068542, "chapter_id": 2438, "verse_number": "९-५६-१०", "content_sanskrit": "ततः शङ्खनिनादैश्च भेरीणां च महास्वनैः।\nसिंहनादैश्च शूराणां दिशः सर्वाः प्रपूरिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2068543, "chapter_id": 2438, "verse_number": "९-५६-११", "content_sanskrit": "ततस्ते तु कुरुक्षेत्रं प्राप्ता नरवरोत्तमाः।\nप्रतीच्यभिमुखं देशं यथोद्दिष्टं सुतेन ते।\nदक्षिणेन सरस्वत्याः स्वयनं तीर्थमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2068544, "chapter_id": 2438, "verse_number": "९-५६-१२", "content_sanskrit": "तस्मिन्देशे त्वनिरिणे ते तु युद्धमरोचयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2068545, "chapter_id": 2438, "verse_number": "९-५६-१३", "content_sanskrit": "ततो भीमो महाकोटिं गदां गृह्याथ वर्मभृत्।\nबिभ्रद्रूपं महाराज सदृशं हि गरुत्मतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2068546, "chapter_id": 2438, "verse_number": "९-५६-१४", "content_sanskrit": "अवबद्धशिरस्त्राणः शुद्धकाञ्चनवर्मभृत्।\nरराज राजन्पुत्रस्ते काञ्चनः शैलराडिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2068547, "chapter_id": 2438, "verse_number": "९-५६-१५", "content_sanskrit": "तौ तथा सङ्गतौ वीरौ भीमदुर्योधनावुभौ।\nसंयुगे सम्प्रकाशेते संरब्धाविव कुञ्जरौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2068548, "chapter_id": 2438, "verse_number": "९-५६-१६", "content_sanskrit": "रथमण्डलमध्यस्थौ भ्रातरौ तौ नरर्षभौ।\nअशोभेतां महाराज चन्द्रसूर्याविवोदितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2068549, "chapter_id": 2438, "verse_number": "९-५६-१७", "content_sanskrit": "तावन्योन्यं निरीक्षेतां क्रुद्धाविव महोरगौ।\nदहन्तौ लोचनै राजन्परस्परवधैषिणौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2068550, "chapter_id": 2438, "verse_number": "९-५६-१८", "content_sanskrit": "संप्रहृष्टमना राजन्गदामादाय कौरवः।\nसृक्विणी संलिहन्राजन्क्रोधरक्तेक्षणः श्वसन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2068551, "chapter_id": 2438, "verse_number": "९-५६-१९", "content_sanskrit": "ततो दुर्योधनो राजन्गदामादाय वीर्यवान्।\nभीमसेनमभिप्रेक्ष्य गजो गजमिवाह्वयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2068552, "chapter_id": 2438, "verse_number": "९-५६-२०", "content_sanskrit": "अद्रिसारमयीं भीमस्तथैवादाय वीर्यवान्।\nआह्वयामास नृपतिं सिंहः सिंहं यथा वने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2068553, "chapter_id": 2438, "verse_number": "९-५६-२१", "content_sanskrit": "तावुद्यतगदापाणी दुर्योधनवृकोदरौ।\nसंयुगे सम्प्रकाशेतां गिरी सशिखराविव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2068554, "chapter_id": 2438, "verse_number": "९-५६-२२", "content_sanskrit": "तावुभौ समतिक्रुद्धावुभौ भीमपराक्रमौ।\nउभौ शिष्यौ गदायुद्धे रौहिणेयस्य धीमतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2068555, "chapter_id": 2438, "verse_number": "९-५६-२३", "content_sanskrit": "उभौ सदृशकर्माणौ वरुणस्य महाबलौ।\nवासुदेवस्य रामस्य तथा वैश्रवणस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2068556, "chapter_id": 2438, "verse_number": "९-५६-२४", "content_sanskrit": "सदृशौ तौ महाराज मधुकैटभयोरपि।\nउभौ सदृशकर्माणौ तथा सुन्दोपसुन्दयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2068557, "chapter_id": 2438, "verse_number": "९-५६-२५", "content_sanskrit": "[रामरावणयोश्चैव वालिसुग्रीवयोस्तथा]।\nतथैव कालस्य समौ मृत्योश्चैव परन्तपौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2068558, "chapter_id": 2438, "verse_number": "९-५६-२६", "content_sanskrit": "अन्योन्यमभिधावन्तौ मत्ताविव महाद्विपौ।\nवासितासङ्गमे दृप्तौ शरदीव मदोत्कटौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2068559, "chapter_id": 2438, "verse_number": "९-५६-२७", "content_sanskrit": "उभौ क्रोधविषं दीप्तं वमन्तावुरगाविव।\nअन्योन्यमभिसंरब्धौ प्रेक्षमाणावरिन्दमौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2068560, "chapter_id": 2438, "verse_number": "९-५६-२८", "content_sanskrit": "उभौ भरतशार्दूलौ विक्रमेण समन्वितौ।\nसिंहाविव दुराधर्षौ गदायुद्धविशारदौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2068561, "chapter_id": 2438, "verse_number": "९-५६-२९", "content_sanskrit": "नखदंष्ट्रायुधौ वीरौ व्याघ्राविव दुरुत्सहौ।\nप्रजासंहरणे क्षुब्धौ समुद्राविव दुस्तरौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2068562, "chapter_id": 2438, "verse_number": "९-५६-३०", "content_sanskrit": "लोहिताङ्गाविव क्रुद्धौ प्रतपन्तौ महारथौ।\n[पूर्वपश्चिमजौ मेघौ प्रेक्षमाणावरिन्दमौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2068563, "chapter_id": 2438, "verse_number": "९-५६-३१", "content_sanskrit": "गर्जमानौ सुविषमं क्षरन्तौ प्रावृषीव हि।\nरश्मियुक्तौ महात्मानौ दीप्तिमन्तौ महाबलौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2068564, "chapter_id": 2438, "verse_number": "९-५६-३२", "content_sanskrit": "ददृशाते कुरुश्रेष्ठौ कालसूर्याविवोदितौ।\nव्याघ्राविव सुसंरब्धौ गर्जन्ताविवतोयदौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2068565, "chapter_id": 2438, "verse_number": "९-५६-३३", "content_sanskrit": "जहृषाते महाबाहु सिंहकेसरिणाविव।\nगजाविव सुसंरब्धौ ज्वलिताविव पावकौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2068566, "chapter_id": 2438, "verse_number": "९-५६-३४", "content_sanskrit": "ददृशाते महात्मानौ सशृङ्गाविव पर्वतौ।\nरोषात्प्रस्फुरमाणोष्ठौ निरीक्षन्तौ परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2068567, "chapter_id": 2438, "verse_number": "९-५६-३५", "content_sanskrit": "तौ समेतौ महात्मानौ गदाहस्तौ नरोत्तमौ।]\nउभौ परमसंहृष्टावुभौ परमसम्मतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2068568, "chapter_id": 2438, "verse_number": "९-५६-३६", "content_sanskrit": "सदश्वाविव हेषन्तौ बृंहन्ताविव कुञ्जरौ।\nवृषभाविव गर्जन्तौ दुर्योधनवृकोदरौ।\nदैत्याविव बलोन्मत्तौ रेजतुस्तौ नरोत्तमौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2068569, "chapter_id": 2438, "verse_number": "९-५६-३७", "content_sanskrit": "ततो दुर्योधनो राजन्निदमाह युधिष्ठिरम्।\nसृञ्जयैः सह तिष्ठन्तं तपन्तमिव भास्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2068570, "chapter_id": 2438, "verse_number": "९-५६-३८", "content_sanskrit": "इदं व्यवसितं युद्धं मम भीमस्य चोभयोः।\nउपोपविष्टाः पश्यध्वं विमर्दं नृपसत्तमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2068571, "chapter_id": 2438, "verse_number": "९-५६-३९", "content_sanskrit": "ततः समुपविष्टं तत्सुमहद्राजमण्डलम्।\nविराजमानं ददृशे दिवीवादित्यमण्डलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2068572, "chapter_id": 2438, "verse_number": "९-५६-४०", "content_sanskrit": "तेषां मध्ये महाबाहुः श्रीमान्केशवपूर्वजः।\nउपविष्टो महाराज पूज्यमानः समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2068573, "chapter_id": 2438, "verse_number": "९-५६-४१", "content_sanskrit": "शुशुभे राजमध्यस्थो नीलवासाः सितप्रभः।\nनक्षत्रैरिव सम्पूर्णो वृतो निशि निशाकरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2068574, "chapter_id": 2438, "verse_number": "९-५६-४२", "content_sanskrit": "तौ तथा तु महाराज गदाहस्तौ सुदुःसहौ।\nअन्योन्यं वाग्भिरुग्राभिस्तक्षमाणौ व्यवस्थितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2068575, "chapter_id": 2438, "verse_number": "९-५६-४३", "content_sanskrit": "अप्रियाणि ततोऽन्योन्यमुक्त्वा तौ कुरुसत्तमौ।\nउदीक्षन्तौ स्थितौ तत्र वृत्रशक्रौ यथाऽऽहवे॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2068576, "chapter_id": 2438, "verse_number": "९-५६-१", "content_sanskrit": "इति श्रीमन्महाभारते शल्यपर्वणि गयादुद्धपर्वणि षट्पञ्चाशत्तमोऽध्यायः॥ ५६ ॥ *एतच्छ्लोकस्य स्थाने झ.पुस्तके अधोलिखिताः पञ्च श्लोका वर्तन्ते। ते च।\nप्रीत्या परमया युक्ताः समभ्यर्च्य यथाविधि।\nआसनं च ददौ तस्मै पर्यपृच्छदनामयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2068577, "chapter_id": 2438, "verse_number": "९-५६-२", "content_sanskrit": "ततो युधिष्ठिरं रामो वाक्यमेतदुवाच ह।\nमधुरं धर्मसंयुक्तं शूराणां हितमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2068578, "chapter_id": 2438, "verse_number": "९-५६-३", "content_sanskrit": "मया श्रुतं कथयतामृषीणां राजसत्तम।\nकुरुक्षेत्रं परं पुण्यं पावनं स्वर्ग्यमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2068579, "chapter_id": 2438, "verse_number": "९-५६-४", "content_sanskrit": "देवतैर्ऋषिभिर्जुष्टं ब्राह्मणैश्च महात्मभिः।\nतत्र वै योत्स्यमाना ये देहं त्यक्ष्यन्ति मानवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2068580, "chapter_id": 2438, "verse_number": "", "content_sanskrit": "तेषां स्वर्गे ध्रुवो वासः शक्रेण सह मारिष।\nतस्मात्समन्तपञ्चकमितो याम द्रुतं नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]