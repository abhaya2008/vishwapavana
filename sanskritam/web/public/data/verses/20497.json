[{"id": 7000497000, "chapter_id": 20497, "verse_number": "३-४४-१", "content_sanskrit": "मार्कंडेय उवाच ।\nशृणु राजन्प्रयागस्य माहात्म्यं पुनरेव तु ।\nयच्छ्रुत्वा सर्वपापेभ्यो मुच्यते नात्र संशयः॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000497001, "chapter_id": 20497, "verse_number": "३-४४-२", "content_sanskrit": "मानसं नाम तत्तीर्थं गंगायामुत्तरे तटे ।\nत्रिरात्रोपोषितो भूत्वा सर्वान्कामानवाप्नुयात्॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000497002, "chapter_id": 20497, "verse_number": "३-४४-३", "content_sanskrit": "गोभूहिरण्यदानेन यत्फलं प्राप्नुयान्नरः ।\nएतत्फलमवाप्नोति तत्तीर्थं स्मरते पुनः॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000497003, "chapter_id": 20497, "verse_number": "३-४४-४", "content_sanskrit": "अकामो वा सकामो वा गंगायां यो विपद्यते ।\nमृतस्तु भवति स्वर्गे नरकं न च पश्यति॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000497004, "chapter_id": 20497, "verse_number": "३-४४-५", "content_sanskrit": "अप्सरोगणसंगीतैः सुप्तोऽसौ प्रतिबुध्यते ।\nहंससारसयुक्तेन विमानेन स गच्छति॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000497005, "chapter_id": 20497, "verse_number": "३-४४-६", "content_sanskrit": "बहुवर्षाणि राजेन्द्र षट्सहस्राणि भुंजते ।\nततः स्वर्गात्परिभ्रष्टः क्षीणकर्मा दिवश्च्युतः॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000497006, "chapter_id": 20497, "verse_number": "३-४४-७", "content_sanskrit": "सुवर्णमणिमुक्ताढ्ये जायते स महाकुले ।\nषष्टितीर्थसहस्राणि षष्टितीर्थशतानि च॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000497007, "chapter_id": 20497, "verse_number": "३-४४-८", "content_sanskrit": "माघेमासि गमिष्यंति गंगायमुनसंगमे ।\nगवां शतसहस्रस्य सम्यग्दत्तस्य यत्फलम्॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000497008, "chapter_id": 20497, "verse_number": "३-४४-९", "content_sanskrit": "प्रयागे माघमासे तु त्र्यहंस्नानस्य तत्फलम् ।\nगंगायमुनयोर्मध्ये पंचाग्निं यस्तु साधयेत्॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000497009, "chapter_id": 20497, "verse_number": "३-४४-१०", "content_sanskrit": "अहीनांगो ह्यरोगश्च पंचेन्द्रियसमन्वितः ।\nयावंति रोमकूपाणि तस्य गात्रस्य देहिनः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000497010, "chapter_id": 20497, "verse_number": "३-४४-११", "content_sanskrit": "तावद्वर्षसहस्राणि स्वर्गलोके महीयते ।\nततः स्वर्गात्परिभ्रष्टो जंबूद्वीपपतिर्भवेत्॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000497011, "chapter_id": 20497, "verse_number": "३-४४-१२", "content_sanskrit": "स भुक्त्वा विपुलान्भोगांस्तत्तीर्थं भजते नरः ।\nजलप्रवेशं यः कुर्यात्संगमे लोकविश्रुते॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000497012, "chapter_id": 20497, "verse_number": "३-४४-१३", "content_sanskrit": "राहुग्रस्तो यथा सोमो विमुक्तः सर्वपातकैः ।\nसोमलोकमवाप्नोति सोमेन सह मोदते॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000497013, "chapter_id": 20497, "verse_number": "३-४४-१४", "content_sanskrit": "षष्टिवर्षसहस्राणि षष्टिवर्षशतानि च ।\nस्वर्गलोकमवाप्नोति ऋषिगंधर्वसेवितः॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000497014, "chapter_id": 20497, "verse_number": "३-४४-१५", "content_sanskrit": "परिभ्रष्टस्तु राजेंद्र समृद्धे जायते कुले ।\nअधःशिरास्तु यो ज्वालामूर्ध्वपादः पिबेन्नरः॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000497015, "chapter_id": 20497, "verse_number": "३-४४-१६", "content_sanskrit": "शतं वर्षसहस्राणि स्वर्गलोके महीयते ।\nपरिभ्रष्टस्तु राजेंद्र अग्निहोत्री भवेन्नरः॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000497016, "chapter_id": 20497, "verse_number": "३-४४-१७", "content_sanskrit": "भुक्त्वा तु विपुलान्भोगांस्तत्तीर्थं भजते नरः ।\nयस्तु देहं विकर्तित्वा शकुनिभ्यः प्रयच्छति॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000497017, "chapter_id": 20497, "verse_number": "३-४४-१८", "content_sanskrit": "विहंगैरुपभुक्तस्य शृणु तस्यापि यत्फलम् ।\nशतं वर्षसहस्राणां सोमलोके महीयते॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000497018, "chapter_id": 20497, "verse_number": "३-४४-१९", "content_sanskrit": "ततः स्वर्गात्परिभ्रष्टो राजा भवति धार्मिकः ।\nगुणवान्रूपसंपन्नो विद्वान्सुप्रियदेहवान्॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000497019, "chapter_id": 20497, "verse_number": "३-४४-२०", "content_sanskrit": "भुक्त्वा तु विपुलान्भोगांस्तत्तीर्थं भजते पुनः ।\nयामुने चोत्तरे कूले प्रयागस्य तु दक्षिणे॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000497020, "chapter_id": 20497, "verse_number": "३-४४-२१", "content_sanskrit": "ऋणप्रमोचनं नाम तीर्थं तत्परमं स्मृतम् ।\nएकरात्रोषितो भूत्वा ऋणैः सर्वैः प्रमुच्यते॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000497021, "chapter_id": 20497, "verse_number": "३-४४-२२", "content_sanskrit": "सूर्यलोकमवाप्नोति अनृणी च सदा भवेत्॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]