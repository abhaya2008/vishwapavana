[{"id": 7002430000, "chapter_id": 22430, "verse_number": "१-९२-१", "content_sanskrit": "ब्रह्मोवाच ।\nयस्त्वादित्यग्रहस्यास्य वारो देवस्य सुव्रत ।\nशस्यः प्रोक्तः प्रियो लोके ख्यातो गोश्रुतिभूषणः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002430001, "chapter_id": 22430, "verse_number": "१-९२-२", "content_sanskrit": "यस्तु पूजयते तस्मिन्पतङ्गं पतगप्रियम् ।\nगन्धपुष्पोपहारैस्तु सूर्यलोकं स गच्छति ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002430002, "chapter_id": 22430, "verse_number": "१-९२-३", "content_sanskrit": "सोपवासो गणश्रेष्ठ आदित्यग्रहणे शुचिः ।\nजपमानो महाश्वेतां खपोषमथ वा शिवम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002430003, "chapter_id": 22430, "verse_number": "१-९२-४", "content_sanskrit": "पूजयेज्जगतामीशं तमोनाशनमाशुगम् ।\nपूजयित्वा खपोषं तु महाश्वेतां ततो जपेत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002430004, "chapter_id": 22430, "verse_number": "१-९२-५", "content_sanskrit": "पूजयित्वा महाश्वेतां रविं देवं समर्चयेत् ।\nमहाश्वेतां प्रतिष्ठाप्य गन्धपुष्पैः सुपूजिताम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002430005, "chapter_id": 22430, "verse_number": "१-९२-६", "content_sanskrit": "तस्या एव बहिः२ कार्यं स्थण्डिलं सुसमाहितः ।\nशुचौ भूमिविभागे तु वीरं संस्थाप्य यत्नतः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002430006, "chapter_id": 22430, "verse_number": "१-९२-७", "content_sanskrit": "कुर्याद्धोमं तिलैः स्नातः सर्पिषा च विशेषतः ।\nआदित्यग्रहवेलायां जपेञ्छ्वेतां महामते ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002430007, "chapter_id": 22430, "verse_number": "१-९२-८", "content_sanskrit": "मुक्ते दिनकरे पश्चात्स्नानं कृत्वा समाहितः ।\nपूजयित्वा महाश्वेतां खगोल्कं३ च ग्रहाधिपम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002430008, "chapter_id": 22430, "verse_number": "१-९२-९", "content_sanskrit": "ब्राह्मणान् वाचयित्वा च ततो भुञ्जीत वाग्यतः ।\nआदित्यग्रहयुक्तेऽस्मिन्वारे त्रिपुरसूदन ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002430009, "chapter_id": 22430, "verse_number": "१-९२-१०", "content_sanskrit": "यत्कर्म क्रियते पुण्यं तत्सर्वं शुभदं भवेत् ।\nस्नानदानजपादीनां कर्मणां गोवृषध्वज ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002430010, "chapter_id": 22430, "verse_number": "१-९२-११", "content_sanskrit": "अनन्तं हि फलं तेषां भवत्यस्मिन्न संशयः ।\nकृतानां तु गणश्रेष्ठा भास्करस्य वचो यथा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002430011, "chapter_id": 22430, "verse_number": "१-९२-१२", "content_sanskrit": "तस्माद्द्विजगणैः कार्यं पुण्यकर्मविचक्षणैः ।\nएकभक्तं च नक्तं च उपवासं गणाधिप ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002430012, "chapter_id": 22430, "verse_number": "१-९२-१३", "content_sanskrit": "ये वादित्यदिने कुर्युस्ते यान्ति परमं पदम् ।\nधर्म्यं पुण्यं यशस्यं च पुत्रीयं कामदं तथा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002430013, "chapter_id": 22430, "verse_number": "१-९२-१४", "content_sanskrit": "तस्मिन्दानमपूपस्य गोदानेन समं भवेत् ।\nद्वादशैते महाबाहो वीरभानोर्महात्मनः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002430014, "chapter_id": 22430, "verse_number": "१-९२-१५", "content_sanskrit": "तुष्टिदाः कथितास्तुभ्यं सर्वपापभयापहाः ।\nपठतां शृण्वतां तात कुर्वतां च विशेषतः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002430015, "chapter_id": 22430, "verse_number": "१-९२-१६", "content_sanskrit": "कृत्वैकमेषां विधिवद्वारं वृषभवाहन ।\nवृषादित्रितयं प्राप्य चात्रिजामचलां तथा ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002430016, "chapter_id": 22430, "verse_number": "१-९२-१७", "content_sanskrit": "ततो याति परं लोकं वृषकेतो महात्मनः ।\nतेजसाम्बुजसंकाशः प्रभयाण्डजसन्निभः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002430017, "chapter_id": 22430, "verse_number": "१-९२-१८", "content_sanskrit": "पत्रिहेतिसमो वीर्ये कान्त्या चन्द्रसमप्रभः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]