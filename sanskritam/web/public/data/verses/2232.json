[{"id": 2056736, "chapter_id": 2232, "verse_number": "७-१५९-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2056737, "chapter_id": 2232, "verse_number": "७-१५९-१", "content_sanskrit": "उदीर्यमाणं तद्दृष्ट्वा पाण्डवानां महद्बलम्।\nअविषह्यं च मन्वानः कर्णं दुर्योधनोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2056738, "chapter_id": 2232, "verse_number": "७-१५९-२", "content_sanskrit": "अयं स कालः सम्प्राप्तो मित्राणां मित्रवत्सल।\nत्रायस्व समरे कर्ण सर्वान्योधान्महारथान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2056739, "chapter_id": 2232, "verse_number": "७-१५९-३", "content_sanskrit": "पाञ्चालैर्मत्स्यकैकेयैः पाण्डवैश्च महारथैः।\nवृतान्समन्तात्सह्क्रुद्धैर्निः श्वसद्भिरिवोरगैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2056740, "chapter_id": 2232, "verse_number": "७-१५९-४", "content_sanskrit": "एते नदन्ति संहृष्टाः पाण्डवा जितकाशिनः।\nशक्रोपमाश्च बहवः पाञ्चालानां रथव्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2056741, "chapter_id": 2232, "verse_number": "७-१५९-५x", "content_sanskrit": "कर्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2056742, "chapter_id": 2232, "verse_number": "७-१५९-५", "content_sanskrit": "परित्रातुमिह प्राप्तो यदि पार्थं पुरन्दरः।\nतमप्याशु पराजित्य ततो हन्ताऽस्मि पाण्डवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2056743, "chapter_id": 2232, "verse_number": "७-१५९-६", "content_sanskrit": "सत्यं ते प्रतिजानामि समाश्वसिहि भारत।\nहन्तास्मि पाण्डुतनयान्पाञ्चालांश्च समागतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2056744, "chapter_id": 2232, "verse_number": "७-१५९-७", "content_sanskrit": "जयं ते प्रतिदास्यामि वासवस्येव पावकिः।\nप्रियं तव मया कार्यमिति जीवामि पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2056745, "chapter_id": 2232, "verse_number": "७-१५९-८", "content_sanskrit": "सर्वेषामेव पार्थानां फल्गुनो बलवत्तरः।\nतस्यामोघां विमोक्ष्यामिशक्तिं शक्रविनिर्मितां॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2056746, "chapter_id": 2232, "verse_number": "७-१५९-९", "content_sanskrit": "तस्मिन्हते महेष्वासे भ्रातरस्तस्य मानद।\nतव वश्या भविष्यन्ति वनं यास्यन्ति वा पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2056747, "chapter_id": 2232, "verse_number": "७-१५९-१०", "content_sanskrit": "मयि जीवति कौरव्य विषादं मा कृथाः क्वचित्।\nअहं जेष्यामि समरे सहितान्सर्वपाण्डवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2056748, "chapter_id": 2232, "verse_number": "७-१५९-११", "content_sanskrit": "पाञ्चालान्केकयांश्चैव वृष्णींश्चापि समागतान्।\nबाणौघैः शकलीकृत्य तव दास्यामि मेदिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2056749, "chapter_id": 2232, "verse_number": "७-१५९-१२x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2056750, "chapter_id": 2232, "verse_number": "७-१५९-१२", "content_sanskrit": "एवं ब्रुवाणं कर्णं तु कृपः शारद्वतोऽब्रवीत्।\nस्मयन्निव महाबाहुः सूतपुत्रमिदं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2056751, "chapter_id": 2232, "verse_number": "७-१५९-१३", "content_sanskrit": "शोभनं शोभनं कर्ण सनाथः कुरुपुङ्गवः।\nत्वया नाथेन राधेय वचसा यदि सिध्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2056752, "chapter_id": 2232, "verse_number": "७-१५९-१४", "content_sanskrit": "बहुशः कत्थसे कर्ण कौरवस्य समीपतः।\nन तु ते विक्रमः कश्चिद्दृश्यते फलमेव वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2056753, "chapter_id": 2232, "verse_number": "७-१५९-१५", "content_sanskrit": "समागमः पाण्डुसुतैर्दृष्टस्ते बहुशो युधि।\nसर्वत्र निर्जितश्चासि पाण्डवैः सूतनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2056754, "chapter_id": 2232, "verse_number": "७-१५९-१६", "content_sanskrit": "हियमाणे तदा कर्ण गन्धर्वैर्धृतराष्ट्रजे।\nतदाऽयुध्यन्त सैन्यानि त्वमेकोऽग्रेऽपलायिथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2056755, "chapter_id": 2232, "verse_number": "७-१५९-१७", "content_sanskrit": "विराटनगरे चापि समेताः सर्वकौरवाः।\nपार्थेन निर्जिता युद्धे त्वं च कर्ण सहानुजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2056756, "chapter_id": 2232, "verse_number": "७-१५९-१८", "content_sanskrit": "एकस्याप्यसमर्थस्त्वं फल्गुनस्य रणाजिरे।\nकथमुत्सहसे जेतुं सकृष्णान्सर्वपाण्डवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2056757, "chapter_id": 2232, "verse_number": "७-१५९-१९", "content_sanskrit": "अब्रुवन्कर्ण युध्यस्व कत्थसे बहु सूतज।\nअनुक्त्वा विक्रमेद्यस्तु तद्वै सत्पुरुषव्रतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2056758, "chapter_id": 2232, "verse_number": "७-१५९-२०", "content_sanskrit": "गर्जित्वा सूतपुत्र त्वं शारदाभ्र इवाजलः।\nनिष्फलो दृश्यसे कर्ण तच्च राजा न बुध्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2056759, "chapter_id": 2232, "verse_number": "७-१५९-२१", "content_sanskrit": "तावद्गर्जस्व राधेय यावत्पार्थं न पश्यसि।\nआरात्पार्थं हि ते दृष्ट्वा दुर्लभं गर्जितं पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2056760, "chapter_id": 2232, "verse_number": "७-१५९-२२", "content_sanskrit": "त्वमनासाद्य तान्बाणान्फल्गुनस्य विगर्जसि।\nपार्थसायकविंद्धस्य दुर्लभं गर्जितं तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2056761, "chapter_id": 2232, "verse_number": "७-१५९-२३", "content_sanskrit": "बाहुभिः क्षत्रियाः शूरा वाग्भिः शूरा द्विजातयः।\nधनुषा फल्गुनः शूरः कर्णः शूरो मनोरथैः।\nतोषितो येन रुद्रोऽपि कः पार्थं प्रतिघातयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2056762, "chapter_id": 2232, "verse_number": "७-१५९-२४", "content_sanskrit": "एवं संरुषितस्तेन तदा शारद्वतेन ह।\nकर्णः प्रहरतां श्रेष्ठः कृपं वाक्यमथाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2056763, "chapter_id": 2232, "verse_number": "७-१५९-२५", "content_sanskrit": "शूरा गर्जन्ति सततं प्रावृषीव वलाहकाः।\nफलं चाशु प्रयच्छन्ति बीजमुप्तमनूषरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2056764, "chapter_id": 2232, "verse_number": "७-१५९-२६", "content_sanskrit": "दोषमत्र न पश्यामि शूराणां रणमूर्धनि।\nतत्तद्विकत्थमानानां भारं चोद्वहतां मृधे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2056765, "chapter_id": 2232, "verse_number": "७-१५९-२७", "content_sanskrit": "यं भारं पुरुषो वोढुं मनसा हि व्यवस्यति।\nदैवमस्य ध्रुवं तत्र साहाय्यायोपपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2056766, "chapter_id": 2232, "verse_number": "७-१५९-२८", "content_sanskrit": "व्यवसायद्वितीयोऽहं मनसा भारमुद्वहन्।\nहत्वा पाण्डुसुतानाजौ सकृष्णान्सहसात्वतान्।\nगर्जामि यद्यहं विप्र तव किं तत्र नश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2056767, "chapter_id": 2232, "verse_number": "७-१५९-२९", "content_sanskrit": "वृथा शूरा न गर्जन्ति सजला इव तोयदाः।\nसामर्थ्यमात्मनो ज्ञात्वा ततो गर्जन्ति पण्डिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2056768, "chapter_id": 2232, "verse_number": "७-१५९-३०", "content_sanskrit": "सोऽहमद्य रणे यत्तौ सहितौ कृष्मपाण्डवौ।\nउत्सहामि रणे जेतुं ततो गर्जामि गौतम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2056769, "chapter_id": 2232, "verse_number": "७-१५९-३१", "content_sanskrit": "पश्य त्वं गर्जितस्यास्य फलं मे विप्र सानुगान्।\nहत्वा पाण्डुसुतानाजौ सहकृष्णान्ससात्वतान्।\nदुर्योधनाय दास्यामि पृथिवीं हतकण्टकाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2056770, "chapter_id": 2232, "verse_number": "७-१५९-३२x", "content_sanskrit": "कृप उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2056771, "chapter_id": 2232, "verse_number": "७-१५९-३२", "content_sanskrit": "मनोरथप्रलापा मे न ग्राह्यास्तव सूतज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2056772, "chapter_id": 2232, "verse_number": "७-१५९-३३", "content_sanskrit": "सदा क्षिपसि वै कृष्णौ धर्मराजं च पाण्डवम्।\nध्रुवस्तत्र जयः कर्ण यत्र युद्धविशारदौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2056773, "chapter_id": 2232, "verse_number": "७-१५९-३४", "content_sanskrit": "देवगन्धर्वयक्षाणां मनुष्योरगरक्षसाम्।\nदंशितानामपि रणे अजेयौ कृष्णपाण्डवौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2056774, "chapter_id": 2232, "verse_number": "७-१५९-३५", "content_sanskrit": "ब्रह्मण्यः सत्यवाग्दान्तो गुरुदैवतपूजकः।\nनित्यं धर्मरतश्चैव कृतास्त्रश्च विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2056775, "chapter_id": 2232, "verse_number": "७-१५९-३६", "content_sanskrit": "धृतिमांश्च कृतज्ञश्च धर्मपुत्रो युधिष्ठिरः।\nभ्रातरश्चास्य बलिनः सर्वास्त्रेषु कृतश्रमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2056776, "chapter_id": 2232, "verse_number": "७-१५९-३७", "content_sanskrit": "गुरुवृत्तिरताः प्राज्ञा धर्मनित्या यशस्विनः।\nसम्बन्धिनश्चेन्द्रवीर्याः स्वनुर्ताः प्रहारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2056777, "chapter_id": 2232, "verse_number": "७-१५९-३८", "content_sanskrit": "धृष्टद्युम्नः शिखण्डी च दौर्मुखिर्जनमेजयः।\nचन्द्रसेनो रुद्रसेनः कीर्तिधर्मा ध्रुवो धरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2056778, "chapter_id": 2232, "verse_number": "७-१५९-३९", "content_sanskrit": "वसुचन्द्रो दामचन्द्रः सिंहचन्द्रः सुतेजनः।\nद्रुपदस्य तथा पुत्रा द्रुपदश्च महास्त्रवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2056779, "chapter_id": 2232, "verse_number": "७-१५९-४०", "content_sanskrit": "येषामर्थाय संयत्तो मत्स्यराजः सहानुजः।\nशतानीकः सूर्यदत्तः श्रुतानीकः श्रुतध्वजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2056780, "chapter_id": 2232, "verse_number": "७-१५९-४१", "content_sanskrit": "बलानीको जयानीको जयाश्वो रथवाहनः।\nचन्द्रोदयः समरथो विराटभ्रातरः शुभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2056781, "chapter_id": 2232, "verse_number": "७-१५९-४२", "content_sanskrit": "यमौ च द्रौपदेयाश्च राक्षसश्च घटोत्कचः।\nयेषामर्थाय युध्यन्ते न तेषां विद्यते क्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2056782, "chapter_id": 2232, "verse_number": "७-१५९-४३", "content_sanskrit": "एते चान्ये च बहवो गणाः पाण्डुसुतस्य वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2056783, "chapter_id": 2232, "verse_number": "७-१५९-४४", "content_sanskrit": "कामं खलु जगत्सर्वं सदेवासुरमानुषम्।\nसयक्षराक्षसगणं सभूतभुजगद्विपम्।\nनिःशेषमस्त्रवीर्येण कुर्वाते भीमफल्गुनौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2056784, "chapter_id": 2232, "verse_number": "७-१५९-४५", "content_sanskrit": "युधिष्ठिरश्च पृथिवीं निर्दहेद्धोरचक्षुषा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2056785, "chapter_id": 2232, "verse_number": "७-१५९-४६", "content_sanskrit": "अप्रमेयबलः शौरिर्येषामर्थे च दंशितः।\nकथं तान्संयुगे कर्ण जेतुमुत्सहसे परान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2056786, "chapter_id": 2232, "verse_number": "७-१५९-४७", "content_sanskrit": "महानपनयस्त्वेष नित्यं हि तव सूतज।\nयस्त्वमुत्सहसे योद्धुं समरे शौरिणा सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2056787, "chapter_id": 2232, "verse_number": "७-१५९-४८x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2056788, "chapter_id": 2232, "verse_number": "७-१५९-४८", "content_sanskrit": "एवमुक्तस्तु राधेयः प्रहसन्भरतर्षभ।\nअब्रवीच्च तदा कर्णो गुरं शारद्वतं कृपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2056789, "chapter_id": 2232, "verse_number": "७-१५९-४९", "content_sanskrit": "सत्यमुक्तं त्वया ब्रह्मन्पाण्डवान्प्रति यद्वचः।\nएते चान्ये च बहवो गुणाः पाण्डुसुतेषु वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2056790, "chapter_id": 2232, "verse_number": "७-१५९-५०", "content_sanskrit": "अजय्याश्च रणे पार्था देवैरपि सवासवैः।\nसदैत्ययक्षगन्धर्वैः पिशाचोरगराक्षसैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2056791, "chapter_id": 2232, "verse_number": "७-१५९-५१", "content_sanskrit": "तथापि पार्थाञ्जेष्यामि शक्त्या वासवदत्तया।\nमम ह्यमोघा दत्तेयं शक्तिः शक्रेण वै द्विज।\nएतया निहनिष्यामि सव्यसाचिनमाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2056792, "chapter_id": 2232, "verse_number": "७-१५९-५२", "content_sanskrit": "हते तु पाण्डवे कृष्णे भ्रातरश्चास्य सोदराः।\nअनर्जुना न शक्ष्यन्ति महीं भोक्तुं कथञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2056793, "chapter_id": 2232, "verse_number": "७-१५९-५३", "content_sanskrit": "तेषु नष्टेषु सर्वेषु पृथिवीयं ससागरा।\nअयत्नात्कौरवेन्द्रस्य वशे स्थास्यति गौतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2056794, "chapter_id": 2232, "verse_number": "७-१५९-५४", "content_sanskrit": "सुनीतैरिह सर्वार्थाः सिध्यन्ते नात्र संशयः।\nएतमर्थमहं ज्ञात्वा ततो गर्जामि गौतम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2056795, "chapter_id": 2232, "verse_number": "७-१५९-५५", "content_sanskrit": "त्वं तु विप्रश्च वृद्धश्च अशक्तश्चापि संयुगे।\nकृतस्नेहश्च पार्थेषु मोहान्मामवमन्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2056796, "chapter_id": 2232, "verse_number": "७-१५९-५६", "content_sanskrit": "यद्येवं वक्ष्यसे भूयो ममाप्रियमिह द्विज।\nततस्ते खङ्गमुद्यम्य जिह्वां छेत्स्यामि दुर्मते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2056797, "chapter_id": 2232, "verse_number": "७-१५९-५७", "content_sanskrit": "यच्चापि पाण्डवान्विप्र स्तोतुमिच्छसि संयुगे।\nभीषयन्सर्वसैन्यानि कौरवेयांश्च दुर्मते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2056798, "chapter_id": 2232, "verse_number": "७-१५९-५८", "content_sanskrit": "अत्रापि शृणु मे वाक्यं यथावद्ब्रुवतो द्विज।\nदुर्योधनश्च द्रोणश्च शकुनिर्दुर्मुखो जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2056799, "chapter_id": 2232, "verse_number": "७-१५९-५९", "content_sanskrit": "दुःशासनो वृषसेनो मद्राजस्त्वमेव च।\nसोमदत्तश्च भूरिश्च तथा द्रौणिर्विविंशतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2056800, "chapter_id": 2232, "verse_number": "७-१५९-६०", "content_sanskrit": "तिष्ठेयुर्दंशिता यत्रा सर्वे युद्धविशारदाः।\nजयेदेतान्नरः को नु शक्रतुल्यबलोऽप्यरिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2056801, "chapter_id": 2232, "verse_number": "७-१५९-६१", "content_sanskrit": "शूराश्च हि कृतास्त्राश्च बलिनः स्वर्गलिप्सवः।\nधर्मज्ञा युद्धकुशला हन्युर्युद्धे सुरानपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2056802, "chapter_id": 2232, "verse_number": "७-१५९-६२", "content_sanskrit": "एते स्थास्यन्ति सङ्ग्रामे पाण्डवानां वधार्थिनः।\nजयमाकाङ्क्षमाणा हि कौरवेयस्य दंशिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2056803, "chapter_id": 2232, "verse_number": "७-१५९-६३", "content_sanskrit": "दैवायत्तमहं मन्ये जयं सुबलिनामपि।\nयत्र भीष्मो महाबाहुः शेते शरशताचितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2056804, "chapter_id": 2232, "verse_number": "७-१५९-६४", "content_sanskrit": "विकर्णश्चित्रसेनश्च बाह्लीकोऽथ जयद्रथः।\nभूरिश्रवा जयश्चैव जलसन्धः सुदक्षिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2056805, "chapter_id": 2232, "verse_number": "७-१५९-६५", "content_sanskrit": "शलश्च रथिनां श्रेष्ठो भगदत्तश्च वीर्यवान्।\nएते चान्ये च राजानो देवैरपि सुदुर्जयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2056806, "chapter_id": 2232, "verse_number": "७-१५९-६६", "content_sanskrit": "निहताः समरे शूराः पाण्डवैर्बलवत्तराः।\nकिमन्यद्दैवसंयोगान्मन्यसे पुरुषाधम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2056807, "chapter_id": 2232, "verse_number": "७-१५९-६७", "content_sanskrit": "यांश्च तांस्तौषि सततं दुर्योधनरिपून्द्विज।\nतेषामपि हताः शूराः शतशोऽथ सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2056808, "chapter_id": 2232, "verse_number": "७-१५९-६८", "content_sanskrit": "क्षीयन्ते सर्वसैन्यानि कुरूणां पाण्डवैः सह।\nप्रभावं नात्र पाश्यामि पाण्डवानां कथञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2056809, "chapter_id": 2232, "verse_number": "७-१५९-६९", "content_sanskrit": "यस्तान्बलवतो नित्यं मन्यसे त्वं द्विजाधम।\nयतिष्येऽहं यथाशक्ति योद्धुं तैः सह संयुगे।\nदुर्योधनहितार्थाय जयो दैवे प्रतिष्ठितः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2056810, "chapter_id": 2232, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि घटोत्कचवधपर्वणि चतुर्दशरात्रियुद्धे एकोनषष्ट्यधिकशततमोऽध्यायः॥ १५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}]