[{"id": 2103790, "chapter_id": 3246, "verse_number": "१४-१०२-१", "content_sanskrit": "भगवानुवाच।\nअतः परं प्रवक्ष्यामि भूमिदानमनुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2103791, "chapter_id": 3246, "verse_number": "१४-१०२-२", "content_sanskrit": "यः प्रयच्छति विप्राय भूमिं रम्यां सदक्षिणाम्।\nश्रोत्रियाय दरिद्राय साग्निहोत्राय पाण्डव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2103792, "chapter_id": 3246, "verse_number": "१४-१०२-३", "content_sanskrit": "स सर्वकामतृप्तात्मा सर्वरत्नविभूषितः।\nसर्वपापविनिर्मुक्तो दीप्यमानोऽर्कवत्सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2103793, "chapter_id": 3246, "verse_number": "१४-१०२-४", "content_sanskrit": "बालसूर्यप्रकाशेन विचित्रध्वजशोभिना।\nयाति यानेन दिव्येन मम लोकं महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2103794, "chapter_id": 3246, "verse_number": "१४-१०२-५", "content_sanskrit": "तत्र दिव्याङ्गनाभिस्तु सेव्यमानो यथासुखम्।\nकामगः कामरूपी च क्रीडत्यप्सरसांगणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2103795, "chapter_id": 3246, "verse_number": "१४-१०२-६", "content_sanskrit": "यावद्बिभर्ति लोकान्वै भूमिः कुरुकुलोद्वह।\nतावद्भूमिप्रदः काले मम लोके महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2103796, "chapter_id": 3246, "verse_number": "१४-१०२-७", "content_sanskrit": "न हि भूमिप्रदानाद्वै दानमन्यद्विशिष्यते।\nन चापि भूमिहरणात्पापमान्यद्विशिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2103797, "chapter_id": 3246, "verse_number": "१४-१०२-८", "content_sanskrit": "दानान्यन्यानि हीयन्ते कालेन कुरुपुङ्गव।\nभूमिदानस्य पुण्यस्य क्षयो नैवोपपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2103798, "chapter_id": 3246, "verse_number": "१४-१०२-९", "content_sanskrit": "ब्राह्मणाय दरिद्राय भूमिं दत्तां तु यो नरः।\nन हिंसति नरव्याघ्र तस्य पुण्यफलं शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2103799, "chapter_id": 3246, "verse_number": "१४-१०२-१०", "content_sanskrit": "सप्तद्वीपसमुद्रान्ता रत्नसंचयसंकुला।\nसशैलवनदुर्गाढ्या तेन दत्ता मही भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2103800, "chapter_id": 3246, "verse_number": "१४-१०२-११", "content_sanskrit": "भूमिं दृष्ट्वा दीयमानां श्रोत्रियायाग्निहोत्रिणे।\nसर्वभूतानि मन्यन्ते मां ददातीति हर्षवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2103801, "chapter_id": 3246, "verse_number": "१४-१०२-१२", "content_sanskrit": "सुवर्णमणिरत्नानि धनानि च वसूनि च।\nसर्वदानानि वै राजन्ददाति वसुधां ददत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2103802, "chapter_id": 3246, "verse_number": "१४-१०२-१३", "content_sanskrit": "सागरान्सरितः शैलान्समानि विषमाणि च।\nसर्वगन्धरसांश्चैव ददाति वसुधां ददत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2103803, "chapter_id": 3246, "verse_number": "१४-१०२-१४", "content_sanskrit": "ओषधीः फलसंपन्ना नानापुष्पसमन्विताः।\nकमलोत्पलषण्डांश्च ददाति वसुधां ददत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2103804, "chapter_id": 3246, "verse_number": "१४-१०२-१५", "content_sanskrit": "धर्मं कामं तथा चार्थं वेदान्यज्ञांस्तथैव च।\nस्वर्गमार्गगतिं चैव ददाति वसुधां ददत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2103805, "chapter_id": 3246, "verse_number": "१४-१०२-१६", "content_sanskrit": "अग्निष्टोमादिभिर्यज्ञैर्ये यजन्ते सदक्षिणैः।\nन तत्फलं लभन्ते ते भूमिदानस्य यत्फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2103806, "chapter_id": 3246, "verse_number": "१४-१०२-१७", "content_sanskrit": "श्रोत्रिया महीं दत्त्वा यो न हिंसति पाण्डव।\nतद्दानं कथयिष्यन्ति यावल्लोकाः प्रतिष्ठिताः।\nतावत्स्वर्गोपभोगानां भोक्तारः पाण्डुनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2103807, "chapter_id": 3246, "verse_number": "१४-१०२-१८", "content_sanskrit": "सस्यपूर्णां महीं यस्तु श्रोत्रियाय प्रयच्छति।\nपितरस्तस्य तृप्ययन्ति यावदाभूतसंप्लुवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2103808, "chapter_id": 3246, "verse_number": "१४-१०२-१९", "content_sanskrit": "मम रुद्रस्य सवितुस्त्रिदशानां तथैव च।\nप्रीतये विद्धि राजेन्द्र भूमिर्दत्ता द्विजाय वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2103809, "chapter_id": 3246, "verse_number": "१४-१०२-२०", "content_sanskrit": "तेन पुण्येन पूतात्मा दाता भूमेर्युधिष्ठिर।\nमम सालोक्यमाप्नोति नात्र कार्या विचाराणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2103810, "chapter_id": 3246, "verse_number": "१४-१०२-२१", "content_sanskrit": "यत्किंचित्कुरुते पापं पुरुषे वृत्तिकर्शितः।\nस च गोकर्णमात्रेण भूमिदानेन शुध्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2103811, "chapter_id": 3246, "verse_number": "१४-१०२-२२", "content_sanskrit": "मासोपवासे यत्पुण्यं कृच्छ्रे चान्द्रायणेऽपि च।\nभूमिगोकर्णमात्रेण तत्पुण्यं तु विधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2103812, "chapter_id": 3246, "verse_number": "१४-१०२-२३", "content_sanskrit": "सर्वतीर्थाभिषेके च यत्पुण्यं समुदाहृतम्।\nभूमिगोकर्णमात्रेण तत्पुण्यं तु विधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2103813, "chapter_id": 3246, "verse_number": "१४-१०२-२४x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2103814, "chapter_id": 3246, "verse_number": "१४-१०२-२४", "content_sanskrit": "देवदेव नमस्तेऽस्तदु वासुदेव सुरेश्वर।\nगोकर्णस्य प्रमाणं वै वक्तुमर्हसि तत्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2103815, "chapter_id": 3246, "verse_number": "१४-१०२-२५x", "content_sanskrit": "भगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2103816, "chapter_id": 3246, "verse_number": "१४-१०२-२५", "content_sanskrit": "शृणु गोकर्णमात्रस्य प्रमाणं पाण्डुनन्दन।\nत्रिंशद्दण्डप्रमाणेन प्रमितं सर्वतो दिशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2103817, "chapter_id": 3246, "verse_number": "१४-१०२-२६", "content_sanskrit": "प्रत्यक्प्रागपि राजेन्द्र तत्तथा दक्षिणोत्तरम्।\nगोकर्णं तद्विदः प्राहुः प्रमाणं धरणेर्नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2103818, "chapter_id": 3246, "verse_number": "१४-१०२-२७", "content_sanskrit": "सवृषं गोशतं यत्र सुखं तिष्ठत्ययन्त्रितम्।\nसवत्सं कुरुशार्दूल तच्च गोकर्णमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2103819, "chapter_id": 3246, "verse_number": "१४-१०२-२८", "content_sanskrit": "किंकरा मृत्युदण्डाश्च कुंभीपाकाश्च दारुणाः।\nघोराश्च वारुणाः पाशा नोपसर्पन्ति भूमिदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2103820, "chapter_id": 3246, "verse_number": "१४-१०२-२९", "content_sanskrit": "निरया रौरवाद्याश्च तथा वैतरणी नदी।\nतीव्राश्च यातनाः कृष्टा नोपसर्पन्ति भूमिदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2103821, "chapter_id": 3246, "verse_number": "१४-१०२-३०", "content_sanskrit": "चित्रगुप्ताः कलिः कालः कृतान्तो मृत्युरेव च।\nयमश्च भगवान्साक्षात्पूजयन्ति महीप्रदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2103822, "chapter_id": 3246, "verse_number": "१४-१०२-३१", "content_sanskrit": "रुद्रः प्रजापतिः शक्रः सुरा ऋषिगणास्तथा।\nअहं च प्रीतिमान्राजन्पूजयामो महीप्रदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2103823, "chapter_id": 3246, "verse_number": "१४-१०२-३२", "content_sanskrit": "कृशभृत्यस्य कृशगोः कृशाश्वस्य कृतातिथेः।\nभूमिर्देया नरश्रेष्ठ स निधइः पारलौकिकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2103824, "chapter_id": 3246, "verse_number": "१४-१०२-३३", "content_sanskrit": "सीदमानकुटुंबाय श्रोत्रियायाग्निहोत्रिणे।\nव्रस्थाय दरिद्राय भूमिर्देया नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2103825, "chapter_id": 3246, "verse_number": "१४-१०२-३४", "content_sanskrit": "यथा हि धात्री क्षीरेण पुत्रं वर्धयति स्वयम्।\nदातारमनुगृह्णाति दत्ता ह्येवं वसुंधरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2103826, "chapter_id": 3246, "verse_number": "१४-१०२-३५", "content_sanskrit": "यथा बिभर्ति गौर्वत्सं सृजन्ती क्षीरमात्मनः।\nतथा सर्वगुणोपेता भूमिर्वहति भूमिदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2103827, "chapter_id": 3246, "verse_number": "१४-१०२-३६", "content_sanskrit": "यथा बीजनि रोहन्ति जलसिक्तानि भूपते।\nतथा कामाः प्ररोहन्ति भूमिदस्य दिनेदिने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2103828, "chapter_id": 3246, "verse_number": "१४-१०२-३७", "content_sanskrit": "यथा तेजस्तु सूर्यस्य तमः सर्वं व्यपोहति।\nतथा पापं नरस्येह भूमिदानं व्यपोहति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2103829, "chapter_id": 3246, "verse_number": "१४-१०२-३८", "content_sanskrit": "दाता दशानुगृह्णाति यो हरेद्दश हन्ति च।\nअतीतान्यागतानीह कुलानि कुरुपुङ्गव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2103830, "chapter_id": 3246, "verse_number": "१४-१०२-३९", "content_sanskrit": "आश्रुत्य भूमिदानं तु दत्त्वा यो वा हरेन्पुनः।\nस बद्धो वारुणैः पाशैः क्षिप्यते पूयशोणिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2103831, "chapter_id": 3246, "verse_number": "१४-१०२-४०", "content_sanskrit": "स्वदत्तां परदत्तां वा यो हरेत् वसुंधराम्।\nन तस्य नरकाद्धोराद्विद्यते निष्कृतिः क्वचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2103832, "chapter_id": 3246, "verse_number": "१४-१०२-४१", "content_sanskrit": "ब्राह्म्णस्य हृते क्षेत्रे हन्याद्द्वादश पूर्वजान्।\nस गच्छेत्कृमियोनिं च न च मुच्येत जातु सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2103833, "chapter_id": 3246, "verse_number": "१४-१०२-४२", "content_sanskrit": "दत्त्वा भूमिं द्विजेन्द्राय यस्तामेवोपजीवति।\nगवां शतसहस्रस्य हन्तुः स लभते फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2103834, "chapter_id": 3246, "verse_number": "१४-१०२-४३", "content_sanskrit": "सोधश्शिरास्तु पापात्मा कुंभीपाकेषु पच्यते।\nदिव्यैर्वर्षसहस्रैस्तु कुंभीपाकाद्विजनिस्सृतः।\nइह लोके भवेत्स श्वा रातजन्मनि पाण्डव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2103835, "chapter_id": 3246, "verse_number": "१४-१०२-४४", "content_sanskrit": "दत्त्वा भूमि द्विजेन्द्राणां यस्तामेवोपजीवति।\nस मूढो याति दुष्टात्मा नरकानेकविंशतिम्।\nनरकेभ्यो विनिर्मुक्तः शुनां योनिं स गच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2103836, "chapter_id": 3246, "verse_number": "१४-१०२-४५", "content_sanskrit": "हलकृष्टा मही देया सबीजा सस्यमालिनी।\nअथवा सोदका देया दरिद्राय द्विजातये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2103837, "chapter_id": 3246, "verse_number": "१४-१०२-४६", "content_sanskrit": "एवं दत्ता मही राजन्प्रहृष्टेनान्तरात्मना।\nसर्वान्कामानवाप्नोति मनसा चिन्तितानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2103838, "chapter_id": 3246, "verse_number": "१४-१०२-४७", "content_sanskrit": "बहुभिर्वसुधा दत्ता दीयते च नराधिपैः।\nयस्य यस्य यदा भूमिस्तस्य तस्य तदा फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2103839, "chapter_id": 3246, "verse_number": "१४-१०२-४८", "content_sanskrit": "यः प्रयच्छति कन्यां वै सुरूपां श्रोत्रियाय वै।\nस ब्रह्मदेयो राजेन्द्र तस्य पुण्यफलं शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2103840, "chapter_id": 3246, "verse_number": "१४-१०२-४९", "content_sanskrit": "बलीवर्दसहस्राणां दत्तानां धुर्यवाहिनाम्।\nयत्पुण्यं लभते राजन्कन्यादानेन तत्फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2103841, "chapter_id": 3246, "verse_number": "१४-१०२-५०", "content_sanskrit": "गवां शतसहस्रस्य सम्यग्धत्तस्थ यत्फलम्।\nतत्फलं समवाप्नोतिः यः प्रयच्छति कन्यकाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2103842, "chapter_id": 3246, "verse_number": "१४-१०२-५१", "content_sanskrit": "यावन्ति चैव रोमाणि कन्यायाः कुरुपुङ्गव।\nतावद्वर्षसहस्राणि मम लोके महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2103843, "chapter_id": 3246, "verse_number": "१४-१०२-५२", "content_sanskrit": "ततश्चापि च्युतः कालादिह लोके स जायते।\nषडङ्गविच्चतुर्वेदी सर्वलोकार्चितो द्विजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2103844, "chapter_id": 3246, "verse_number": "१४-१०२-५३", "content_sanskrit": "यः सुवर्णं दरिद्राय ब्राह्मणाय प्रयच्छति।\nश्रोत्रियाय सुवृत्ताय बहुपुत्राय पाण्डव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2103845, "chapter_id": 3246, "verse_number": "१४-१०२-५४", "content_sanskrit": "स मुक्तः सर्वपापेभ्यो बालसूर्यसमप्रभः।\nविमानं दिव्यामारूढः कामगः कामभोगवान्॥\nवर्षकोटिं महातेजा मम लोके महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2103846, "chapter_id": 3246, "verse_number": "१४-१०२-५५", "content_sanskrit": "ततः कालावतीर्णश्च सोस्मिँल्लोके हि जायते।\nवेदवेदाङ्गविद्विप्रः कोटीधनपतिर्भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2103847, "chapter_id": 3246, "verse_number": "१४-१०२-५६", "content_sanskrit": "यश्च रूप्यं प्रयच्छेद्वै दरिद्राय द्विजातये।\nकृशवृत्तेः कृशगवे स मुक्तः सर्वकिल्बिषैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2103848, "chapter_id": 3246, "verse_number": "१४-१०२-५७", "content_sanskrit": "पूर्णचन्द्रप्रकाशेन विमानेन विराजता।\nकामरूपि यथाकामं स्वर्गलोके महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2103849, "chapter_id": 3246, "verse_number": "१४-१०२-५८", "content_sanskrit": "ततोऽवतीर्णः कालेन लोके चास्मिन्महायशाः।\nसर्वलोकार्चितः श्रीमान्राजा भवति वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2103850, "chapter_id": 3246, "verse_number": "१४-१०२-५९", "content_sanskrit": "तिलपर्वतकं यस्तु श्रोत्रियाय प्रयच्छति।\nविशेषेण दरिद्राय तस्यापि शृणु यत्फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2103851, "chapter_id": 3246, "verse_number": "१४-१०२-६०", "content_sanskrit": "पुण्यं वृषायुतोत्सर्गे यत्प्रोक्तं पाण्डुनन्दन।\nतत्पुण्यं समनुप्राप्य तत्क्षणाद्विरजा भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2103852, "chapter_id": 3246, "verse_number": "१४-१०२-६१", "content_sanskrit": "यथा त्वचं भुजङ्गो वै त्यक्त्वा शुद्धतनुर्भवेत्।\nतता तिलप्रदानाद्वै पापं त्यक्त्वा विसुद्ध्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2103853, "chapter_id": 3246, "verse_number": "१४-१०२-६२", "content_sanskrit": "तिलषण्डं प्रयुञ्जानो जांबूनदविभूषितम्।\nविमानं दिव्यमारूढः पितृलोके महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2103854, "chapter_id": 3246, "verse_number": "१४-१०२-६३", "content_sanskrit": "षष्टिं वर्षसहस्राणि कामरूपी महायशाः।\nतिलप्रदाता रमते पितृलोके यथासुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2103855, "chapter_id": 3246, "verse_number": "१४-१०२-६४", "content_sanskrit": "यः प्रयच्छति विप्राय तिलधेनुं नराधिप।\nश्रोत्रियाय दरिद्राय शृणु तस्यापि यत्फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2103856, "chapter_id": 3246, "verse_number": "१४-१०२-६५", "content_sanskrit": "गोसहस्रप्रदानेन यत्पुण्यं समुदाहृतम्।\nतत्पुण्यफलामाप्नोति तिलधेनुप्रदो नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2103857, "chapter_id": 3246, "verse_number": "१४-१०२-६६", "content_sanskrit": "तिलानां कुडवैर्यस्तु तिलधेनुं प्रयच्छति।\nतावत्कोटिसमा राजन्स्वर्गलोके महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2103858, "chapter_id": 3246, "verse_number": "१४-१०२-६७", "content_sanskrit": "अष्टाढकतिलैः कृत्वा तिलधेनु नराधिप।\nद्वात्रिंशन्निष्कसंयुक्तं विषुवे यः प्रयच्छति।\nमद्भक्त्या मद्गतात्मा वै तस्य पुण्यफलं शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2103859, "chapter_id": 3246, "verse_number": "१४-१०२-६८", "content_sanskrit": "कन्यादानसहस्रस्य विधिदत्तस्य यत्फलम्।\nतत्पुण्यं समनुप्राप्तो मम लोके महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2103860, "chapter_id": 3246, "verse_number": "१४-१०२-६९", "content_sanskrit": "मम लोकावतीर्णश्च सोस्मिँल्लोकेऽभिजायते।\nऋग्यजुस्सामवेदानां पारगो ब्राह्मणर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2103861, "chapter_id": 3246, "verse_number": "१४-१०२-७०", "content_sanskrit": "गां तु यस्तु दरिद्राय श्रोत्रियाय प्रयच्छति।\nप्रसन्नां क्षीरिणीं पुण्यां सवत्सां कांस्यदोहिनीं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2103862, "chapter_id": 3246, "verse_number": "१४-१०२-७१", "content_sanskrit": "यत्किंचिद्दुष्कृतं कर्म तस्य पूर्वकृतं नृपः।\nतत्सर्वं तत्क्षणादेव विनश्यति न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2103863, "chapter_id": 3246, "verse_number": "१४-१०२-७२", "content_sanskrit": "यानं च वृषसंयुक्तं दीप्यमानं स्वलङ्कृतम्।\nआरूढः कामगं दिव्यं गोलोकमधिगच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2103864, "chapter_id": 3246, "verse_number": "१४-१०२-७३", "content_sanskrit": "यावन्ति चैव रोमाणि तस्या गोस्तु नराधिप।\nतावद्वर्षसहस्राणि गवां लोके महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2103865, "chapter_id": 3246, "verse_number": "१४-१०२-७४", "content_sanskrit": "गोलोकादवतीर्णस्तु लोकेऽस्मिन्ब्राह्मणो भवेत्।\nसत्रयाजी वदन्यश्च सर्वराजभिरर्चितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2103866, "chapter_id": 3246, "verse_number": "१४-१०२-७५", "content_sanskrit": "तिलं गावः सुवर्णं चाप्यन्नं कन्या वसुंधरा।\nतारयन्तीह दत्तानि ब्राह्मणेभ्यो महाभुज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2103867, "chapter_id": 3246, "verse_number": "१४-१०२-७६", "content_sanskrit": "ब्राह्मणं वृत्तसंपन्नमाहिताग्निमलोलुपम्।\nतर्पयेद्विधिवद्राजन्स निधिः पारलौकिकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2103868, "chapter_id": 3246, "verse_number": "१४-१०२-७७", "content_sanskrit": "आहिताग्नि दरिद्रं च श्रोत्रियं च जितेन्द्रियम्।\nशूद्रान्नवर्जितं चैव द्विजं यत्नेन पूजयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2103869, "chapter_id": 3246, "verse_number": "१४-१०२-७८", "content_sanskrit": "आहिताग्निः सदा पात्रमह्निहोत्री च वेदवित्।\nपात्राणामपि तत्पात्रं शूद्रान्नं यस्य नोदरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2103870, "chapter_id": 3246, "verse_number": "१४-१०२-७९", "content_sanskrit": "यच्च वेदमयं पात्रं यच्च पात्रं तपोमयम्।\nअसंकीर्णं च यत्पात्रं तत्पात्रं तारयिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2103871, "chapter_id": 3246, "verse_number": "१४-१०२-८०", "content_sanskrit": "नित्यस्वाध्यायनिरतास्त्वसंकीर्णेन्द्रियाश्च ये।\nपञ्चयज्ञपरा नित्यं पूजितास्तारयन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2103872, "chapter_id": 3246, "verse_number": "१४-१०२-८१", "content_sanskrit": "ये क्षान्तिदान्ताः श्रुतिपूर्णकर्णा\nजितेन्द्रियाः प्राणिवधै निवृत्ताः।\nप्रतिग्रहे संकुचिता गृहस्था-\nस्ते ब्राह्मणास्तारयितुं समर्थाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2103873, "chapter_id": 3246, "verse_number": "१४-१०२-८२", "content_sanskrit": "नित्योदकी नित्ययज्ञोपवीती\nनित्यस्वाध्यायी वृषलान्नवर्जी।\nक्रतौ गच्छन्विधिवच्चापि जुह्व-\nत्स ब्राह्मणस्तारयितुं समर्थः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2103874, "chapter_id": 3246, "verse_number": "१४-१०२-८३", "content_sanskrit": "ब्राह्मणो यस्तु मद्भक्तो मद्रागी मत्परायणः।\nमयि संन्यस्तकर्मा च स विप्रस्तारयेद्ध्रुवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2103875, "chapter_id": 3246, "verse_number": "१४-१०२-८४", "content_sanskrit": "द्वादशाक्षरतत्वज्ञश्चतुर्व्यूहविभागवित्।\nअच्छिद्रपञ्चकालज्ञःक स विप्रस्तारयिष्यति॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2103876, "chapter_id": 3246, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि वैष्णवधर्मपर्वणि द्व्यधिकशततमोऽध्यायः॥ १०२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}]