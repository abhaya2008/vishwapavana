[{"id": 2147969, "chapter_id": 4201, "verse_number": "", "content_sanskrit": "कुन्ती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2147970, "chapter_id": 4201, "verse_number": "१", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nविदुलायाश्च संवादं पुत्रस्य च परन्तप\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2147971, "chapter_id": 4201, "verse_number": "२", "content_sanskrit": "ततः श्रेयश्च भूयश्च यथावद् वक्तुमर्हति\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2147972, "chapter_id": 4201, "verse_number": "३", "content_sanskrit": "यशस्विनी मन्युमती कुलजाता विभाविनी ।\nक्षत्रधर्मरता नित्यं विदुला दीर्घदर्शिनी\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2147973, "chapter_id": 4201, "verse_number": "४", "content_sanskrit": "विश्रुता राजसंसत्सु श्रुतवाक्या बहुश्रुता\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2147974, "chapter_id": 4201, "verse_number": "५", "content_sanskrit": "विदुला नाम सा साध्वी जगर्हे पुत्रमौरसम् ।\nनिर्जितं सिन्धुराजेन शयानं दीनचेतसम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2147975, "chapter_id": 4201, "verse_number": "६", "content_sanskrit": "अनन्दनमधर्मज्ञं द्विषतां हर्षवर्धनम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2147976, "chapter_id": 4201, "verse_number": "", "content_sanskrit": "विदुला", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2147977, "chapter_id": 4201, "verse_number": "७", "content_sanskrit": "कुनन्दन क्व वा जातो द्विषतां हर्षवर्धन ।\nन मया त्वं न पित्रा च जातः क्वाभ्यागतो ह्यसि\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2147978, "chapter_id": 4201, "verse_number": "८", "content_sanskrit": "निर्मन्युश्चाप्यसङ्ख्येयः पुरुषः क्लीबसाधनः ।\nयावज्जीवं निराशोऽसि कल्याणाय धुरं वह\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2147979, "chapter_id": 4201, "verse_number": "९", "content_sanskrit": "माऽऽत्मानमवमन्यस्व मैवमल्पेन भीभरः ।\nमनः कृत्वा सुकल्याणं मा भैस्त्वं प्रतिसंहर\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2147980, "chapter_id": 4201, "verse_number": "१०", "content_sanskrit": "उत्तिष्ठ हे कापुरुष मा शेष्वैवं पराजितः ।\nअमित्रान् नन्दयन् सर्वान् मित्राणां चापि शोकदः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2147981, "chapter_id": 4201, "verse_number": "११", "content_sanskrit": "सुपूरा वै कुनदिका सुपूरो मूषिकाञ्जलिः ।\nसुसन्तोषः कापुरुषः स्वल्पकेनैव तुष्यति\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2147982, "chapter_id": 4201, "verse_number": "१२", "content_sanskrit": "अप्यहेरारुजन् दंष्ट्रां मा चैव निधनं व्रज ।\nअपि वा संशयं प्राप्य जीवितेऽपि पराक्रमेः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2147983, "chapter_id": 4201, "verse_number": "१३", "content_sanskrit": "अप्यरेः श्येनवच्छिद्रं पश्येस्त्वं विपरिक्रमम् ।\nविनदन् वाऽथवा तूष्णीं व्योम्नि वा परिशङ्कितः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2147984, "chapter_id": 4201, "verse_number": "१४", "content_sanskrit": "त्वमेवं प्रेतवच्छेषे कस्माद् वज्रहतो यथा ।\nउत्तिष्ठ हे कापुरुष मा स्वाप्सीः शत्रुनिर्जितः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2147985, "chapter_id": 4201, "verse_number": "१५", "content_sanskrit": "माऽस्तं गमस्त्वं कृपणो विश्रूयस्व स्वकर्मणा ।\nमा मध्ये मा जघन्ये त्वं माऽधो भूस्तिष्ठ चोर्जितः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2147986, "chapter_id": 4201, "verse_number": "१६", "content_sanskrit": "अलातं तिन्दुकस्येव मुहूर्तमपि विज्वल ।\nमा तुषाग्निरिवानर्चिः धूमायेत नरश्चिरम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2147987, "chapter_id": 4201, "verse_number": "१७", "content_sanskrit": "मुहूर्तं ज्वलितं श्रेयो न च धूमायितं चिरम् ।\nमा ह स्म कस्यचिद् गेहे जनि राज्ञः खरी मृदुः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2147988, "chapter_id": 4201, "verse_number": "१८", "content_sanskrit": "कृत्वा मानुष्यकं कर्म धृष्टात्मा यावदुत्तरम् ।\nधर्मस्यानृण्यमाप्नोति न चात्मानं विगर्हयेत्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2147989, "chapter_id": 4201, "verse_number": "१९", "content_sanskrit": "अलब्ध्वा यदि वा लब्ध्वा नानुशोचन्ति पण्डिताः ।\nआनन्तर्यं चारभन्ते न प्राणपरिरक्षणाम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2147990, "chapter_id": 4201, "verse_number": "२०", "content_sanskrit": "उद्भावयस्व वीर्यं वा तां वा गच्छ ध्रुवां गतिम् ।\nधर्मं पुत्राग्रतः कृत्वा किन्निमित्तं हि जीवसि\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2147991, "chapter_id": 4201, "verse_number": "२१", "content_sanskrit": "इष्टापूर्तं च ते क्लीब कीर्तिश्च सकला हता ।\nविच्छिन्नं भोगमूलं ते किन्निमित्तं हि जीवसि\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2147992, "chapter_id": 4201, "verse_number": "२२", "content_sanskrit": "शत्रुर्निमज्जता ग्राह्यो जङ्घायां प्रपतिष्यता ।\nविपरिच्छिन्नमूलेन न विषीदेत् कथञ्चन\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2147993, "chapter_id": 4201, "verse_number": "२३", "content_sanskrit": "उद्यम्य धुरमुत्कर्षेद् आजानेयकृतं स्मरन् ।\nकुरु सत्वं च मानं च विद्धि पौरुषमात्मनः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2147994, "chapter_id": 4201, "verse_number": "२४", "content_sanskrit": "उद्भावय कुलं मग्नं त्वत्कृते स्वयमेव च\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2147995, "chapter_id": 4201, "verse_number": "२५", "content_sanskrit": "यस्य वृत्तं न जल्पन्ति मानवा महदद्भुतम् ।\nराशिवर्धनमात्रं स नैव स्त्री न पुनः पुमान्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2147996, "chapter_id": 4201, "verse_number": "२६", "content_sanskrit": "दाने तपसि शौर्ये वा यस्य न प्रथितं यशः ।\nविद्यायामर्थलाभे वा मातुरुच्चार एव सः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2147997, "chapter_id": 4201, "verse_number": "२७", "content_sanskrit": "श्रुतेन तपसा वाऽपि श्रिया वा विक्रमेण वा ।\nजनान् योऽभिभवत्यन्यान् कर्मणा हि स वै पुमान्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2147998, "chapter_id": 4201, "verse_number": "२८", "content_sanskrit": "न त्वेव जाल्मीं कापालीं वृत्तिमेषितुमर्हसि ।\nनृशंस्यामयशस्यां च दुःखां कापुरुषोचिताम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2147999, "chapter_id": 4201, "verse_number": "२९", "content_sanskrit": "यदेनमभिनन्देयुरमित्राः पुरुषं कृशम् ।\nलोकस्य समवज्ञातं निहीनाशनवाससम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2148000, "chapter_id": 4201, "verse_number": "३०", "content_sanskrit": "अहो लोभकरं हीनम् अल्पजीवनमल्पकम् ।\nनेदृशं बन्धुमासाद्य बान्धवः सुखमेधते\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2148001, "chapter_id": 4201, "verse_number": "३१", "content_sanskrit": "अवृत्त्यैव विपत्स्यामो वयं राष्ट्रात् प्रवासिताः ।\nसर्वकामरसैर्हीना स्थानभ्रष्टा अकिञ्चनाः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2148002, "chapter_id": 4201, "verse_number": "३२", "content_sanskrit": "अवर्णकारिणं सत्सु कुलवंशस्य नाशनम् ।\nकलिं पुत्रप्रवादेन सृञ्जय त्वामजीजनम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2148003, "chapter_id": 4201, "verse_number": "३३", "content_sanskrit": "निरमर्षं निरुत्साहं निर्वीर्यमरिनन्दनम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2148004, "chapter_id": 4201, "verse_number": "३४", "content_sanskrit": "मा स्म सीमन्तिनी काचित् जनयेत् पुत्रमीदृशम् ।\nमा धूमाय ज्वलात्यन्तमाक्रम्य जहि शात्रवान्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2148005, "chapter_id": 4201, "verse_number": "३५", "content_sanskrit": "ज्वल मूर्धन्यमित्राणां मुहूर्तमपि वा क्षणम् ।\nएतावानेव पुरुषो यदमर्षी यदक्षमी\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2148006, "chapter_id": 4201, "verse_number": "३६", "content_sanskrit": "क्षमावान् निरमर्षश्च नैव स्त्री न पुनः पुमान् ।\nसन्तोषो वै श्रियं हन्ति तथाऽनुक्रोश एव च\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2148007, "chapter_id": 4201, "verse_number": "३७", "content_sanskrit": "अनुत्थानभये चोभे निरीहो नाश्नुते महत् ।\nएभ्यो निकृतिपाशेभ्यः प्रमुञ्चात्मानमात्मना\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2148008, "chapter_id": 4201, "verse_number": "३८", "content_sanskrit": "आयसं हृदयं कृत्वा मृगयस्व पुरं स्वकम् ।\nपुरं विषहते यस्मात् तस्मात् पुरुष उच्यते\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2148009, "chapter_id": 4201, "verse_number": "३९", "content_sanskrit": "तमाहुर्व्यर्थनामानं स्त्रीवद् य इह जीवति\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2148010, "chapter_id": 4201, "verse_number": "४०", "content_sanskrit": "शूरस्योर्जितसत्वस्य सिंहविक्रान्तचारिणः ।\nदिष्टभावं गतस्यापि विषये मोदते प्रजा\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2148011, "chapter_id": 4201, "verse_number": "४१", "content_sanskrit": "य आत्मनः प्रियसुखे हित्वा मृगयतेऽसुखम् ।\nअमित्राणामथो हर्षमादधात्यचिरेण सः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2148012, "chapter_id": 4201, "verse_number": "", "content_sanskrit": "सृञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2148013, "chapter_id": 4201, "verse_number": "४२", "content_sanskrit": "किन्नु ते मामपश्यन्त्याः पृथिव्याऽपि च सर्वया ।\nकिमाभरणकृत्यं ते किं भोगैर्जीवितेन वा\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2148014, "chapter_id": 4201, "verse_number": "", "content_sanskrit": "विदुला", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2148015, "chapter_id": 4201, "verse_number": "४३", "content_sanskrit": "परैर्विहन्यमानस्य जीवितेनापि किं फलम् ।\nनिर्मन्युकानां ये लोका द्विषन्तस्तानवाप्नुयुः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2148016, "chapter_id": 4201, "verse_number": "४४", "content_sanskrit": "ये वा धृतात्मनां लोकाः सुहृदस्तान् व्रजन्तु नः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2148017, "chapter_id": 4201, "verse_number": "४५", "content_sanskrit": "भृत्यैर्विहीयमानानां परपिण्डोपजीविनाम् ।\nकृपणानामनाथानां मा वृत्तिमनुवर्तिथाः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2148018, "chapter_id": 4201, "verse_number": "४६", "content_sanskrit": "अनु त्वां तात जीवन्तु ब्राह्मणाः सुहृदस्तथा ।\nपर्जन्यमिव भूतानि देवा इव शतक्रतुम्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2148019, "chapter_id": 4201, "verse_number": "४७", "content_sanskrit": "यमाजीवन्ति पुरुषं सर्वभूतानि सृञ्जय ।\nपक्वं द्रुममिवासाद्य तस्य जीवितमर्थवत्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2148020, "chapter_id": 4201, "verse_number": "४८", "content_sanskrit": "यस्य शूरस्य विक्रान्तैर्वर्धन्ते बान्धवाः सुखम् ।\nत्रिदशा इव शक्रस्य साधु तस्येह जीवितम्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2148021, "chapter_id": 4201, "verse_number": "४९", "content_sanskrit": "स्वबाहुबलमाश्रित्य यो हि जीवति मानवः ।\nस लोके लभते कीर्तिं परत्र च शुभां गतिम्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2148022, "chapter_id": 4201, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि द्वात्रिंशोत्तरशततमोऽध्यायः ॥१३२॥\nभगवद्यानपर्वणि त्रिषष्टितमोऽध्यायः ॥६३॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]