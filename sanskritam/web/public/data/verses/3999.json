[{"id": 2138499, "chapter_id": 3999, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2138500, "chapter_id": 3999, "verse_number": "१", "content_sanskrit": "स राजधानीं सम्प्राप्य पार्थिवोऽर्जुनमब्रवीत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2138501, "chapter_id": 3999, "verse_number": "२", "content_sanskrit": "इमानि पुरुषव्याघ्र आयुधानि परन्तप ।\nकस्मिन् न्यासयितव्यानि गुप्तिश्चैषां कथं भवेत्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2138502, "chapter_id": 3999, "verse_number": "३", "content_sanskrit": "सायुधा हि वयं तात प्रवेक्ष्यामः पुरं यदि ।\nसमुद्वेगं जनस्यास्य करिष्यामो न संशयः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2138503, "chapter_id": 3999, "verse_number": "४", "content_sanskrit": "गाण्डीवं हि नरव्याघ्र त्रिषु लोकेषु विश्रुतम् ।\nकथं नाविष्कृताः स्यामो धार्तराष्ट्रस्य मारिष\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2138504, "chapter_id": 3999, "verse_number": "५", "content_sanskrit": "यदीदं धनुरादाय चरेम सजने पुरे ।\nक्षिप्रं नः प्रतिजानीयुर्मनुष्या नात्र संशयः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2138505, "chapter_id": 3999, "verse_number": "६", "content_sanskrit": "एकस्मिन्नपि विज्ञाते समयं नव्यतीत्य च ।\nभूयो द्वादश वर्षाणि प्रविशेम वनं वयम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2138506, "chapter_id": 3999, "verse_number": "७", "content_sanskrit": "तस्मात् सर्वाणि शस्त्राणि प्रच्छन्नं न्यस्य कुत्रचित् ।\nप्रविशेम पुरश्रेष्ठं तदा सम्यक् कृतं भवेत्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2138507, "chapter_id": 3999, "verse_number": "८", "content_sanskrit": "अजातशत्रोर्वचनं श्रुत्वा चैव महायशाः ।\nउवाच धर्मपुत्रं तमर्जुनः परवीरहा\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2138508, "chapter_id": 3999, "verse_number": "९", "content_sanskrit": "इयं वने मनुष्येन्द्र महती दृश्यते शमी ।\nभीमशाखा दुरारोहा श्मशानस्य समीपतः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2138509, "chapter_id": 3999, "verse_number": "१०", "content_sanskrit": "विपुलाकीर्णशाखा च वायसैरुपसेविता ।\nसमीपे च श्मशानस्य गृहं नास्य विशेषतः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2138510, "chapter_id": 3999, "verse_number": "११", "content_sanskrit": "समासज्यायुधान्यस्यां गच्छामो नगरं प्रति\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2138511, "chapter_id": 3999, "verse_number": "१२", "content_sanskrit": "उत्पथेनापि जातेयममनुष्यनिषेविते ।\nन चास्यां सञ्चरिष्यन्ति मनुष्याः पार्थ केचन\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2138512, "chapter_id": 3999, "verse_number": "१३", "content_sanskrit": "धनुर्भिः पुरुषं कृत्वा चर्मकोशास्थिसंवृतम् ।\nउद्बन्धमिव कृष्णं च धनूंष्यावह संवृतम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2138513, "chapter_id": 3999, "verse_number": "१४", "content_sanskrit": "अस्यामायुधमासज्य गच्छेम नगरं वयम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2138514, "chapter_id": 3999, "verse_number": "१५", "content_sanskrit": "एवं परिहरिष्यन्ति मनुष्या वनचारिणः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2138515, "chapter_id": 3999, "verse_number": "१६", "content_sanskrit": "अत्रैवं नावबुद्ध्यन्ते मनुष्याः केचिदायुधम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2138516, "chapter_id": 3999, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2138517, "chapter_id": 3999, "verse_number": "१७", "content_sanskrit": "एवमुक्त्वा स राजानं धर्मात्मानं धनञ्जयः ।\nप्रचक्रमे निधानाय शस्त्राणां भरतर्षभ\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2138518, "chapter_id": 3999, "verse_number": "१८", "content_sanskrit": "तानि सर्वाणि सन्नह्य पञ्च पञ्चाचलोपमाः ।\nआयुधानि कलापांश्च निस्त्रिंशांश्चातुलप्रभान्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2138519, "chapter_id": 3999, "verse_number": "१९", "content_sanskrit": "ततो युधिष्ठिरो राजा सहदेवमुवाच ह ।\nआरुह्येमां शमीं वीर निधत्स्वेहायुधानि नः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2138520, "chapter_id": 3999, "verse_number": "समाप्तिः", "content_sanskrit": "इति सन्दिश्य तं पार्थः पुनरेव धनञ्जयम् ।\nअब्रवीदायुधानीह निधातुं भरतर्षभ\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2138521, "chapter_id": 3999, "verse_number": "२१", "content_sanskrit": "येन देवान् मनुष्यांश्च पिशाचोरगराक्षसान् ।\nनिवातकवचांश्चापि पौलोमांश्च परन्तप\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2138522, "chapter_id": 3999, "verse_number": "२२", "content_sanskrit": "कालकेयांश्च दुर्धर्षान् सर्वांश्चैकरथोऽजयत् ।\nस्फीतान् जनपदांश्चान्यानजयत् कुरुनन्दनः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2138523, "chapter_id": 3999, "verse_number": "२३", "content_sanskrit": "एतदुग्रं महाघोरं सपत्नगणसूदनम् ।\nअसज्यमकरोत् पार्थो गाण्डीवमभयङ्करम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2138524, "chapter_id": 3999, "verse_number": "२४", "content_sanskrit": "येन वीरः कुरुक्षेत्रमभ्यरक्षत् परन्तपः ।\nजृम्भिते च धनुःश्रेष्ठे न्यासार्थं नृपसत्तमः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2138525, "chapter_id": 3999, "verse_number": "२५", "content_sanskrit": "धर्मपुत्रो महातेजाः सर्वलोकवशङ्करम् ।\nभुजङ्गभोगसदृशं मणिकाञ्चनभूषणम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2138526, "chapter_id": 3999, "verse_number": "२६", "content_sanskrit": "वित्रासनं दानवानां राक्षसानां च नित्यशः ।\nधनूरत्नं महातेजा जृम्भयामास पाण्डवः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2138527, "chapter_id": 3999, "verse_number": "२७", "content_sanskrit": "पाञ्चालान् येन सङ्ग्रामे भीमसेनोऽजयत् प्रभुः ।\nप्रत्यषेधद् बहूनेकः सपत्नांश्चापि दिग्जये\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2138528, "chapter_id": 3999, "verse_number": "२८", "content_sanskrit": "निशम्य यस्य विष्फारं विद्रवन्ति रणे परे ।\nपर्वतस्येव दीर्णस्य विस्फोटमशनेरिव\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2138529, "chapter_id": 3999, "verse_number": "२९", "content_sanskrit": "सैन्धवं येन राजानं जित्वा क्रुद्धः परामृशत् ।\nयेन क्रोधवशान् जघ्ने राक्षसान् गन्धमादने\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2138530, "chapter_id": 3999, "verse_number": "३०", "content_sanskrit": "दिव्यं सौगन्धिकं पुष्पं येनाजैषीत् स पाण्डवः ।\nत्रिगर्तान् येन सङ्ग्रामे जित्वा त्रैगर्तमानयत्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2138531, "chapter_id": 3999, "verse_number": "३१", "content_sanskrit": "इन्द्रायुधसमस्पर्शं वज्रहाटकभूषितम् ।\nज्यापाशं धनुषस्तस्य भीमसेनोऽवतारयत्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2138532, "chapter_id": 3999, "verse_number": "३२", "content_sanskrit": "नकुलं पुनराहूय धर्मराजो युधिष्ठिरः ।\nउवाच चैनं सङ्ग्रामे सर्वान् शत्रून् जिघांससि\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2138533, "chapter_id": 3999, "verse_number": "३३", "content_sanskrit": "सुराष्ट्रान् जितवान् येन शार्ङ्गगाण्डीवसन्निभम् ।\nसुवर्णविकृतं सारमिन्द्रायुधनिभं वरम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2138534, "chapter_id": 3999, "verse_number": "३४", "content_sanskrit": "तवानुरूपं सुदृढं चापमेतदलङ्कृतम् ।\nतत् स्रंसयित्वा ज्यापाशं निधातुं धनुराहर\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2138535, "chapter_id": 3999, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2138536, "chapter_id": 3999, "verse_number": "३५", "content_sanskrit": "माद्रीपुत्रो महाबाहुस्ताम्रास्यो मितभाषिता ।\nकुले नास्ति समो रूपे यस्येति नकुलः स्मृतः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2138537, "chapter_id": 3999, "verse_number": "३६", "content_sanskrit": "अजयत् पश्चिमामाशां धनुषा येन पाण्डवः ।\nसुवर्णविकृतं सारमिन्द्रायुधवरोपमम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2138538, "chapter_id": 3999, "verse_number": "३७", "content_sanskrit": "तत् स्रंसयित्वा ज्यापाशं निधातुं धनुराहरत्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2138539, "chapter_id": 3999, "verse_number": "३८", "content_sanskrit": "सहदेवं च सम्प्रेक्ष्य पुनर्धर्मसुतोऽब्रवीत्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2138540, "chapter_id": 3999, "verse_number": "३९", "content_sanskrit": "कळिङ्गान् दाक्षिणात्यांश्च मगधांश्चापि दिग्जये ।\nयेनैव शत्रून् समरेष्वधाक्षीररिमर्दन\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2138541, "chapter_id": 3999, "verse_number": "४०", "content_sanskrit": "तत् स्रंसयित्वा ज्यापाशं निधातुं धनुराहर\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2138542, "chapter_id": 3999, "verse_number": "४१", "content_sanskrit": "अजयद् दक्षिणामाशां धनुषा येन पाण्डवः ।\nतत् स्रंसयित्वा ज्यापाशं निधातुं धनुराहरत्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2138543, "chapter_id": 3999, "verse_number": "४२", "content_sanskrit": "दीर्घांश्च खड्गान् सुदृढान् निशितान् कनकत्सरून् ।\nविविधान् क्षुरनाराचान् निस्त्रिंशांश्च शरानपि\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2138544, "chapter_id": 3999, "verse_number": "४३", "content_sanskrit": "आयुधानि कलापांश्च गदाश्च निदधुः सह ।\nअथाब्रवीद् धर्मराजः सहदेवं परन्तपः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2138545, "chapter_id": 3999, "verse_number": "४४", "content_sanskrit": "आयुधानि कलापांश्च गदाश्च विपुलास्तथा ।\nतानि सर्वाणि सन्नह्य वासोभिः परिवेष्ट्य च\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2138546, "chapter_id": 3999, "verse_number": "४५", "content_sanskrit": "आरोह यावदेतानि निधातुं विहगैर्वृताम् ।\nशमीमारुह्य महतीं निक्षिपाद्यायुधानि नः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2138547, "chapter_id": 3999, "verse_number": "४६", "content_sanskrit": "इदं गोमृगमभ्याशे गतसत्त्वमचेतनम् ।\nहार्यमुत्कृत्य वै वीर धनूंषि परिवेष्टय\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2138548, "chapter_id": 3999, "verse_number": "४७", "content_sanskrit": "एवमुक्तो महाबाहुः सहदेवो यथोक्तवत् ।\nशमीमारुह्य त्वरितो धनूंषि परिवेष्टयत्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2138549, "chapter_id": 3999, "verse_number": "४८", "content_sanskrit": "शीतवातातपभयाद् वर्षत्राणाय दुर्जयः ।\nतानि वीरयशोज्ञाननिराबाधानि सर्वशः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2138550, "chapter_id": 3999, "verse_number": "४९", "content_sanskrit": "पुनः पुनः सुसंवेष्ट्य कृत्वा सुदृढमावरम्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2138551, "chapter_id": 3999, "verse_number": "५०", "content_sanskrit": "अथापरमदूरस्थमुञ्छवृत्तिकलेबरम् ।\nप्रायोपवेशादुच्छुष्कं स्नायुचर्मास्थिसंयुतम्\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2138552, "chapter_id": 3999, "verse_number": "५१", "content_sanskrit": "तच्चानीय धनुर्मध्ये निबबन्धुश्च पाण्डवाः ।\nउपायकुशलाः सर्वे सप्रहासमथाब्रुवन्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2138553, "chapter_id": 3999, "verse_number": "५२", "content_sanskrit": "अस्य बद्धस्य दौर्गन्ध्यान्मनुष्या वनचारिणः ।\nदूरात् परिहरिष्यन्ति ससत्त्वेयं शमीति ह\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2138554, "chapter_id": 3999, "verse_number": "५३", "content_sanskrit": "अथाब्रवीन्महाराजो धर्मात्मा स युधिष्ठिरः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2138555, "chapter_id": 3999, "verse_number": "५४", "content_sanskrit": "रज्जुभिः सुकृतं प्राज्ञ विनिर्बध्नीहि पाण्डव\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2138556, "chapter_id": 3999, "verse_number": "५५", "content_sanskrit": "यानि चात्र विशालानि रूढमूलानि मन्यसे ।\nतेषामुपरि बध्नीहि इदं विप्रकलेबरम्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2138557, "chapter_id": 3999, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2138558, "chapter_id": 3999, "verse_number": "५६", "content_sanskrit": "तच्छ्रुत्वा सहदेवस्तु पर्यबध्नत तच्छवम्\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2138559, "chapter_id": 3999, "verse_number": "५७", "content_sanskrit": "सह धर्मेण धर्मात्मा भ्रातृभिश्च विवित्सता ।\nअरणीग्रहणे काले वरान् दत्तः परन्तपः\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2138560, "chapter_id": 3999, "verse_number": "५८", "content_sanskrit": "तान्यायुधान्युपाधाय प्रोवाच मधुराक्षरम् ।\nयुधिष्ठिरः शुचिर्भूत्वा मनसाऽभिप्रणम्य च\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2138561, "chapter_id": 3999, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2138562, "chapter_id": 3999, "verse_number": "५९", "content_sanskrit": "ब्रह्माणमिन्द्रं वरदं कुबेरं वरुणानिलौ ।\nरुद्रं यमं च विष्णुं च सोमार्कौ धर्ममेव च\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2138563, "chapter_id": 3999, "verse_number": "६०", "content_sanskrit": "पृथिवीमन्तरिक्षं च दिशश्चोपदिशस्तथा ।\nवसूंश्च मरुतश्चैव ज्वलनं चातितेजसम्\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2138564, "chapter_id": 3999, "verse_number": "६१", "content_sanskrit": "दिवाचरा रात्रिचराणि वाऽपि\nयानीह भूतान्यनुकीर्तितानि ।\nतेभ्यो नमस्कृत्य च सुव्रतेभ्यः\nप्रणम्य तेषां शरणं गतोऽहम्\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2138565, "chapter_id": 3999, "verse_number": "६२", "content_sanskrit": "सर्वायुधानीह महाबलानि\nन्यासं महादेवसमीपतो वै ।\nन्यस्याम्यहं वायुसमीपतश्च\nवनस्पतीनां च सपर्वतानाम्\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2138566, "chapter_id": 3999, "verse_number": "६३", "content_sanskrit": "एष न्यासो मया न्यस्तः सूर्यसोमानिलान्तिके ।\nमह्यं पार्थाय वा देयं पूर्णे वर्षे त्रयोदशे\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2138567, "chapter_id": 3999, "verse_number": "६४", "content_sanskrit": "नेदं भीमाय दातव्यमयं क्रुद्धो वृकोदरः\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2138568, "chapter_id": 3999, "verse_number": "६५", "content_sanskrit": "अमर्षात् नित्यसङ्क्रुद्धो धृतराष्ट्रसुतान् प्रति ।\nअपूर्णकाले प्रहरेत् क्रोधसञ्जातमत्सरः\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2138569, "chapter_id": 3999, "verse_number": "६६", "content_sanskrit": "पुनः प्रवेशो नः स्यात् तु वनवासाय सर्वदा ।\nसमये परिपूर्णे तु धार्तराष्ट्रान् निहन्महि\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2138570, "chapter_id": 3999, "verse_number": "६७", "content_sanskrit": "एष चार्थश्च धर्मश्च कामः कीर्तिः कुलं यशः ।\nममायत्तमिदं सर्वं जीवितं च न संशयः\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2138571, "chapter_id": 3999, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2138572, "chapter_id": 3999, "verse_number": "६८", "content_sanskrit": "दैवतेभ्यो नमस्कृत्य शमीं कृत्वा प्रदक्षिणम् ।\nनगरं गन्तुमायाताः सर्वे ते भ्रातरः सह\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2138573, "chapter_id": 3999, "verse_number": "६९", "content_sanskrit": "आगोपालविपालेभ्यः कर्षकेभ्यः परन्तपाः ।\nआजग्मुर्नगराभ्याशं श्रावयन्तः पुनः पुनः\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2138574, "chapter_id": 3999, "verse_number": "७०", "content_sanskrit": "अशीतिशतवर्षेयं माताऽस्माकमिहान्तिके ।\nहन्त कालपरीणामा मृत्योस्तु वशमेयुषी\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2138575, "chapter_id": 3999, "verse_number": "७१", "content_sanskrit": "न चाग्निसंस्कारमियं प्रापिता कुलधर्मतः\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2138576, "chapter_id": 3999, "verse_number": "७२", "content_sanskrit": "यः समासाद्यते कश्चित् तस्मिन् देशे यदृच्छया ।\nअचिरात् तस्य मरणं भविष्यति न संशयः\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2138577, "chapter_id": 3999, "verse_number": "७३", "content_sanskrit": "तदैवमूचुस्ते तत्र कुलधर्मो न ईदृशः\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2138578, "chapter_id": 3999, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2138579, "chapter_id": 3999, "verse_number": "७४", "content_sanskrit": "विश्रावयन्तस्ते सर्वे दिशः सर्वा व्यनादयन् ।\nस्वर्गतेयमिहास्माकं जननी शोकविह्वला\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2138580, "chapter_id": 3999, "verse_number": "७५", "content_sanskrit": "वने विचरमाणानां लुब्धानां वनचारिणाम् ।\nकुलधर्मोऽयमस्माकं पूर्वैराचरितः पुरा\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2138581, "chapter_id": 3999, "verse_number": "७६", "content_sanskrit": "एवं ते समयं कृत्वा समन्तादवघुष्य च ।\nभीमसेनार्जुनौ चैव माद्रीपुत्रावुभावपि\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2138582, "chapter_id": 3999, "verse_number": "७७", "content_sanskrit": "युधिष्ठिरश्च कृष्णा च राजपुत्री सुमध्यमा ।\nततो यथासमाज्ञप्तं नगरं प्राविशंस्तदा\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2138583, "chapter_id": 3999, "verse_number": "७८", "content_sanskrit": "मत्स्यराज्ञो विराटस्य समीपं वस्तुमञ्जसा ।\nअज्ञातचर्यां चरितुं वर्षं राष्ट्रे त्रयोदशम्\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2138584, "chapter_id": 3999, "verse_number": "७९", "content_sanskrit": "अथ च्छन्नानि नामानि चकारैषां युधिष्ठिरः ।\nजयो जयेशो विजयो जयत्सेनो जयद्बलः\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2138585, "chapter_id": 3999, "verse_number": "८०", "content_sanskrit": "आपत्सु नामभिस्त्वेतैः समाहूताः परस्परम्\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2138586, "chapter_id": 3999, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां विराटपर्वणि सप्तमोऽध्यायः ॥७॥\nवैराटपर्वणि विराटनगरप्रवेशो नाम सप्तमोऽध्यायः ॥७॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}]