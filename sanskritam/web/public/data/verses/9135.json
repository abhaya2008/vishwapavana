[{"id": 5000135000, "chapter_id": 9135, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अयोध्याकाण्डे अष्टपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000135001, "chapter_id": 9135, "verse_number": "२-५८-१", "content_sanskrit": "प्रत्याश्वस्तः यदा राजा मोहात् प्रत्यागतः पुनः ।\nथाजुहाव तम् सूतम् राम वृत्त अन्त कारणात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000135002, "chapter_id": 9135, "verse_number": "२-५८-२", "content_sanskrit": "तदा सूतो महाराज कृताञ्जलिरुपस्थितः।\nराममेव अनुशोचन्तं दुःखशोकसमन्वितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000135003, "chapter_id": 9135, "verse_number": "२-५८-३", "content_sanskrit": "वृद्धम् परम सम्तप्तम् नव ग्रहम् इव द्विपम् ।\nविनिःश्वसन्तम् ध्यायन्तम् अस्वस्थम् इव कुन्जरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000135004, "chapter_id": 9135, "verse_number": "२-५८-४", "content_sanskrit": "राजा तु रजसा सूतम् ध्वस्त अङ्गम् समुपस्थितम् ।\nअश्रु पूर्ण मुखम् दीनम् उवाच परम आर्तवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000135005, "chapter_id": 9135, "verse_number": "२-५८-५", "content_sanskrit": "क्व नु वत्स्यति धर्म आत्मा वृक्ष मूलम् उपाश्रितः ।\nसो अत्यन्त सुखितः सूत किम् अशिष्यति राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000135006, "chapter_id": 9135, "verse_number": "२-५८-६", "content_sanskrit": "दुःखस्यानुचितो दुःखम् सुमन्त्र शयनोचितः ।\nभूमि पाल आत्मजो भूमौ शेते कथम् अनाथवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000135007, "chapter_id": 9135, "verse_number": "२-५८-७", "content_sanskrit": "यम् यान्तम् अनुयान्ति स्म पदाति रथ कुण्Jजराः ।\nस वत्स्यति कथम् रामः विजनम् वनम् आश्रितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000135008, "chapter_id": 9135, "verse_number": "२-५८-८", "content_sanskrit": "व्याLऐः मृगैः आचरितम् कृष्ण सर्प निषेवितम् ।\nकथम् कुमारौ वैदेह्या सार्धम् वनम् उपस्थितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000135009, "chapter_id": 9135, "verse_number": "२-५८-९", "content_sanskrit": "सुकुमार्या तपस्विन्या सुमन्त्र सह सीतया ।\nराज पुत्रौ कथम् पादैः अवरुह्य रथात् गतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000135010, "chapter_id": 9135, "verse_number": "२-५८-१०", "content_sanskrit": "सिद्ध अर्थः खलु सूत त्वम् येन दृष्टौ मम आत्मजौ ।\nवन अन्तम् प्रविशन्तौ ताव् अश्विनाव् इव मन्दरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000135011, "chapter_id": 9135, "verse_number": "२-५८-११", "content_sanskrit": "किम् उवाच वचो रामः किम् उवाच च लक्ष्मणः ।\nसुमन्त्र वनम् आसाद्य किम् उवाच च मैथिली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000135012, "chapter_id": 9135, "verse_number": "२-५८-१२", "content_sanskrit": "आसितम् शयितम् भुक्तम् सूत रामस्य कीर्तय ।\nजीविष्याम्यहमेतेन ययातिरिव साधुषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000135013, "chapter_id": 9135, "verse_number": "२-५८-१३", "content_sanskrit": "इति सूतः नर इन्द्रेण चोदितः सज्जमानया ।\nउवाच वाचा राजानम् स बाष्प परिर्बद्धया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000135014, "chapter_id": 9135, "verse_number": "२-५८-१४", "content_sanskrit": "अब्रवीन् माम् महा राज धर्मम् एव अनुपालयन् ।\nअन्जलिम् राघवः कृत्वा शिरसा अभिप्रणम्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000135015, "chapter_id": 9135, "verse_number": "२-५८-१५", "content_sanskrit": "सूत मद्वचनात् तस्य तातस्य विदित आत्मनः ।\nशिरसा वन्दनीयस्य वन्द्यौ पादौ महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000135016, "chapter_id": 9135, "verse_number": "२-५८-१६", "content_sanskrit": "सर्वम् अन्तः पुरम् वाच्यम् सूत मद्वचनात्त्वया ।\nआरोग्यम् अविशेषेण यथा अर्हम् च अभिवादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000135017, "chapter_id": 9135, "verse_number": "२-५८-१७", "content_sanskrit": "माता च मम कौसल्या कुशलम् च अभिवादनम् ।\nअप्रमादम् च वक्तव्या ब्रूयाश्चैमिदम् वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000135018, "chapter_id": 9135, "verse_number": "२-५८-१८", "content_sanskrit": "धर्मनित्या यथाकालमग्न्यगारपरा भव ।\nदेवि देवस्य पादौ च देववत् परिपालय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000135019, "chapter_id": 9135, "verse_number": "२-५८-१९", "content_sanskrit": "अभिमानम् च मानम् च त्यक्त्वा वर्तस्व मातृषु ।\nअनु राजान मार्याम् च कैकेयीमम्ब कारय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000135020, "chapter_id": 9135, "verse_number": "२-५८-२०", "content_sanskrit": "कुमारे भरते वृत्तिर्वर्तितव्याच राजवत् ।\nअर्थज्येष्ठा हि राजानो राजधर्ममनुस्मर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000135021, "chapter_id": 9135, "verse_number": "२-५८-२१", "content_sanskrit": "भरतः कुशलम् वाच्यो वाच्यो मद् वचनेन च ।\nसर्वास्व एव यथा न्यायम् वृत्तिम् वर्तस्व मातृषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000135022, "chapter_id": 9135, "verse_number": "२-५८-२२", "content_sanskrit": "वक्तव्यः च महा बाहुर् इक्ष्वाकु कुल नन्दनः ।\nपितरम् यौवराज्यस्थो राज्यस्थम् अनुपालय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000135023, "chapter_id": 9135, "verse_number": "२-५८-२३", "content_sanskrit": "अतिक्रान्तवया राजा मास्मैनम् व्यवरोरुधः ।\nकुमारराज्ये जीव त्वम् तस्यैवाज्ञ्प्रवर्तनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000135024, "chapter_id": 9135, "verse_number": "२-५८-२४", "content_sanskrit": "अब्रवीच्चापि माम् भूयो भृशमश्रूणि वर्तयन् ।\nमातेव मम माता ते द्रष्टव्या पुत्रगर्धिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000135025, "chapter_id": 9135, "verse_number": "२-५८-२५", "content_sanskrit": "इति एवम् माम् महाराज बृवन्न् एव महा यशाः ।\nरामः राजीव ताम्र अक्षो भृशम् अश्रूणि अवर्तयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000135026, "chapter_id": 9135, "verse_number": "२-५८-२६", "content_sanskrit": "लक्ष्मणः तु सुसम्क्रुद्धो निह्श्वसन् वाक्यम् अब्रवीत् ।\nकेन अयम् अपराधेन राज पुत्रः विवासितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000135027, "chapter_id": 9135, "verse_number": "२-५८-२७", "content_sanskrit": "राज्ञा तु खलु कैकेय्या लघु त्वाश्रित्य शासनम् ।\nकृतम् कार्यमकार्यम् वा वयम् येनाभिपीडिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000135028, "chapter_id": 9135, "verse_number": "२-५८-२८", "content_sanskrit": "यदि प्रव्राजितः रामः लोभ कारण कारितम् ।\nवर दान निमित्तम् वा सर्वथा दुष्कृतम् कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000135029, "chapter_id": 9135, "verse_number": "२-५८-२९", "content_sanskrit": "इदम् तावद्यथाकाममीश्वरस्य कृते कृतम् ।\nरामस्य तु परित्यागे न हेतुम् उपलक्षये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000135030, "chapter_id": 9135, "verse_number": "२-५८-३०", "content_sanskrit": "असमीक्ष्य समारब्धम् विरुद्धम् बुद्धि लाघवात् ।\nजनयिष्यति सम्क्रोशम् राघवस्य विवासनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000135031, "chapter_id": 9135, "verse_number": "२-५८-३१", "content_sanskrit": "अहम् तावन् महा राजे पितृत्वम् न उपलक्षये ।\nभ्राता भर्ता च बन्धुः च पिता च मम राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000135032, "chapter_id": 9135, "verse_number": "२-५८-३२", "content_sanskrit": "सर्व लोक प्रियम् त्यक्त्वा सर्व लोक हिते रतम् ।\nसर्व लोको अनुरज्येत कथम् त्वा अनेन कर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000135033, "chapter_id": 9135, "verse_number": "२-५८-३३", "content_sanskrit": "सर्वप्रजाभिरामम् हि रामम् प्रव्राज्य धार्मिकम् ।\nसर्वलोकम् विरुध्येमम् कथम् राजा भविष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000135034, "chapter_id": 9135, "verse_number": "२-५८-३४", "content_sanskrit": "जानकी तु महा राज निःश्वसन्ती तपस्विनी ।\nभूत उपहत चित्ता इव विष्ठिता वृष्मृता स्थिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000135035, "chapter_id": 9135, "verse_number": "२-५८-३५", "content_sanskrit": "अदृष्ट पूर्व व्यसना राज पुत्री यशस्विनी ।\nतेन दुह्खेन रुदती न एव माम् किम्चित् अब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000135036, "chapter_id": 9135, "verse_number": "२-५८-३६", "content_sanskrit": "उद्वीक्षमाणा भर्तारम् मुखेन परिशुष्यता ।\nमुमोच सहसा बाष्पम् माम् प्रयान्तम् उदीक्ष्य सा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000135037, "chapter_id": 9135, "verse_number": "२-५८-३७", "content_sanskrit": "तथैव रामः अश्रु मुखः कृत अन्जलिः ।\nस्थितः अभवल् लक्ष्मण बाहु पालितः स्थितः ।\nतथैव सीता रुदती तपस्विनी ।\nनिरीक्षते राज रथम् तथैव माम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000135038, "chapter_id": 9135, "verse_number": null, "content_sanskrit": "इति वाल्मीकि रामायणे आदि काव्ये अयोध्याकाण्डे अष्टपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]