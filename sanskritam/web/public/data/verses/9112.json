[{"id": 5000112000, "chapter_id": 9112, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अयोध्याकाण्डे पञ्चत्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000112001, "chapter_id": 9112, "verse_number": "२-३५-१", "content_sanskrit": "ततो निधूय सहसा शिरो निःश्वस्य चासकृत्।\nपाणिं पाणौ विनिष्पिष्य दन्तान् कटकटाय्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000112002, "chapter_id": 9112, "verse_number": "२-३५-२", "content_sanskrit": "लोचने कोपसंरक्ते वर्णं पूर्वोचितं जहत्।\nकोपाभिभूतः सहसा संतापमशुभं गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000112003, "chapter_id": 9112, "verse_number": "२-३५-३", "content_sanskrit": "मनः समीक्षमाणश्च सूतो दशरथस्य च।\nकम्पयन्निव कैकेय्या हृदयं वाक्शरैः शितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000112004, "chapter_id": 9112, "verse_number": "२-३५-४", "content_sanskrit": "वाक्यवज्रैरनुपमैर्निर्भिन्दन्निव चाशुभैः।\nकैकेय्याः सर्वमर्माणि सुमन्त्रः प्रत्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000112005, "chapter_id": 9112, "verse_number": "२-३५-५", "content_sanskrit": "यस्यास्तव पतिस्त्यक्तो राजा दशरथः स्वयम्।\nभर्ता सर्वस्य जगतः स्थावरस्य चरस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000112006, "chapter_id": 9112, "verse_number": "२-३५-६", "content_sanskrit": "नह्यकार्यतमं किंचित्तव देवीह विद्यते।\nपतिघ्नीं त्वामहं मन्ये कुलघ्नीमपि चान्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000112007, "chapter_id": 9112, "verse_number": "२-३५-७", "content_sanskrit": "यन्महेन्द्रमिवाजय्यं दुष्प्रकम्प्यमिवाचलम्।\nमहोदधिमिवाक्षोभ्यं संतापयसि कर्मभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000112008, "chapter_id": 9112, "verse_number": "२-३५-८", "content_sanskrit": "मावमंस्था दशरथं भर्तारं वरदं पतिम्।\nभर्तुरिच्छा हि नारीणां पुत्रकोट्या विशिष्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000112009, "chapter_id": 9112, "verse_number": "२-३५-९", "content_sanskrit": "यथावयो हि राज्यानि प्राप्नुवन्ति नृपक्षये।\nइक्ष्वाकुकुलनाथेऽस्मिंस्तं लोपयितुमिच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000112010, "chapter_id": 9112, "verse_number": "२-३५-१०", "content_sanskrit": "राजा भवतु ते पुत्रो भरतः शास्तु मेदिनीम्।\nवयं तत्र गमिष्यामो यत्र रामो गमिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000112011, "chapter_id": 9112, "verse_number": "२-३५-११", "content_sanskrit": "न च ते विषये कश्चिद् ब्राह्मणो वस्तुमर्हति।\nतादृशं त्वममर्यादमद्य कर्म करिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000112012, "chapter_id": 9112, "verse_number": "२-३५-१२", "content_sanskrit": "नूनं सर्वे गमिष्यामो मार्गं रामनिषेवितम्।\nत्यक्ता या बान्धवैः सर्वैर्ब्राह्मणैः साधुभिः सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000112013, "chapter_id": 9112, "verse_number": "२-३५-१३", "content_sanskrit": "का प्रीती राज्यलाभेन तव देवि भविष्यति।\nतादृशं त्वममर्यादं कर्म कर्तुं चिकीर्षसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000112014, "chapter_id": 9112, "verse_number": "२-३५-१४", "content_sanskrit": "आश्चर्यमिव पश्यामि यस्यास्ते वृत्तमीदृशम्।\nआचरन्त्या न विवृता सद्यो भवति मेदिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000112015, "chapter_id": 9112, "verse_number": "२-३५-१५", "content_sanskrit": "महाब्रह्मर्षिसृष्टा वा ज्वलन्तो भीमदर्शनाः।\nधिग्वाग्दण्डा न हिंसन्ति रामप्रव्राजने स्थिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000112016, "chapter_id": 9112, "verse_number": "२-३५-१६", "content_sanskrit": "आम्रं छित्त्वा कुठारेण निम्बं परिचरेत् तु कः।\nयश्चैनं पयसा सिञ्चेन्नैवास्य मधुरो भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000112017, "chapter_id": 9112, "verse_number": "२-३५-१७", "content_sanskrit": "आभिजात्यं हि ते मन्ये यथा मातुस्तथैव च।\nन हि निम्बात् स्रवेत् क्षौद्रं लोके निगदितं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000112018, "chapter_id": 9112, "verse_number": "२-३५-१८", "content_sanskrit": "तव मातुरसद्‍ग्राहं विद्म पूर्वं यथा श्रुतम्।\nपितुस्ते वरदः कश्चिद् ददौ वरमनुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000112019, "chapter_id": 9112, "verse_number": "२-३५-१९", "content_sanskrit": "सर्वभूतरुतं तस्मात् संजज्ञे वसुधाधिपः।\nतेन तिर्यग्गतानां च भूतानां विदितं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000112020, "chapter_id": 9112, "verse_number": "२-३५-२०", "content_sanskrit": "ततो जृम्भस्य शयने विरुताद् भूरिवर्चसः।\nपितुस्ते विदितो भावः स तत्र बहुधाहसत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000112021, "chapter_id": 9112, "verse_number": "२-३५-२१", "content_sanskrit": "तत्र ते जननी क्रुद्धा मृत्युपाशमभीप्सती।\nहासं ते नृपते सौम्य जिज्ञासामीति चाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000112022, "chapter_id": 9112, "verse_number": "२-३५-२२", "content_sanskrit": "नृपश्चोवाच तां देवीं हासं शंसामि ते यदि।\nततो मे मरणं सद्यो भविष्यति न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000112023, "chapter_id": 9112, "verse_number": "२-३५-२३", "content_sanskrit": "माता ते पितरं देवि पुनः केकयमब्रवीत्।\nशंस मे जीव वा मा वा न मां त्वं प्रहसिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000112024, "chapter_id": 9112, "verse_number": "२-३५-२४", "content_sanskrit": "प्रियया च तथोक्तः स केकयः पृथिवीपतिः।\nतस्मै तं वरदायार्थं कथयामास तत्त्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000112025, "chapter_id": 9112, "verse_number": "२-३५-२५", "content_sanskrit": "ततः स वरदः साधू राजानं प्रत्यभाषत।\nम्रियतां ध्वंसतां वेयं मा शंसीस्त्वं महीपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000112026, "chapter_id": 9112, "verse_number": "२-३५-२६", "content_sanskrit": "स तच्छ्रुत्वा वचस्तस्य प्रसन्नमनसो नृपः।\nमातरं ते निरस्याशु विजहार कुबेरवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000112027, "chapter_id": 9112, "verse_number": "२-३५-२७", "content_sanskrit": "तथा त्वमपि राजानं दुर्जनाचरिते पथि।\nअसद्‍ग्राहमिमं मोहात् कुरुषे पापदर्शिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000112028, "chapter_id": 9112, "verse_number": "२-३५-२८", "content_sanskrit": "सत्यश्चात्र प्रवादोऽयं लौकिकः प्रतिभाति मा।\nपितॄन् समनुजायन्ते नरा मातरमङ्गनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000112029, "chapter_id": 9112, "verse_number": "२-३५-२९", "content_sanskrit": "नैवं भव गृहाणेदं यदाह वसुधाधिपः।\nभर्तुरिच्छामुपास्वेह जनस्यास्य गतिर्भव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000112030, "chapter_id": 9112, "verse_number": "२-३५-३०", "content_sanskrit": "मा त्वं प्रोत्साहिता पापैर्देवराजसमप्रभम्।\nभर्तारं लोकभर्तारमसद्धर्ममुपादध ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000112031, "chapter_id": 9112, "verse_number": "२-३५-३१", "content_sanskrit": "नहि मिथ्या प्रतिज्ञातं करिष्यति तवानघः।\nश्रीमान् दशरथो राजा देवि राजीवलोचनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000112032, "chapter_id": 9112, "verse_number": "२-३५-३२", "content_sanskrit": "ज्येष्ठो वदान्यः कर्मण्यः स्वधर्मस्यापि रक्षिता।\nरक्षिता जीवलोकस्य बली रामोऽभिषिच्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000112033, "chapter_id": 9112, "verse_number": "२-३५-३३", "content_sanskrit": "परिवादो हि ते देवि महाँल्लोके चरिष्यति।\nयदि रामो वनं याति विहाय पितरं नृपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000112034, "chapter_id": 9112, "verse_number": "२-३५-३४", "content_sanskrit": "स्वराज्यं राघवः पातु भव त्वं विगतज्वरा।\nनहि ते राघवादन्यः क्षमः पुरवरे वसन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000112035, "chapter_id": 9112, "verse_number": "२-३५-३५", "content_sanskrit": "रामे हि यौवराज्यस्थे राजा दशरथो वनम्।\nप्रवेक्ष्यति महेष्वासः पूर्ववृत्तमनुस्मरन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000112036, "chapter_id": 9112, "verse_number": "२-३५-३६", "content_sanskrit": "इति सान्त्वैश्च तीक्ष्णैश्च कैकेयीं राजसंसदि।\nभूयः संक्षोभयामास सुमन्त्रस्तु कृताञ्जलिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000112037, "chapter_id": 9112, "verse_number": "२-३५-३७", "content_sanskrit": "नैव सा क्षुभ्यते देवी न च स्म परिदूयते।\nन चास्या मुखवर्णस्य लक्ष्यते विक्रिया तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000112038, "chapter_id": 9112, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अयोध्याकाण्डे पञ्चत्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]