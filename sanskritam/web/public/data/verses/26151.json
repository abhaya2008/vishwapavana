[{"id": 7006151000, "chapter_id": 26151, "verse_number": "१-२-१२-१", "content_sanskrit": "ऋषय ऊचुः ।\nयच्च किंपुरुषं वर्षं हरिवर्षं तथैव च ।\nआचक्ष्व नो यथातत्त्वं कीर्त्तितं भारतं त्वया ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006151001, "chapter_id": 26151, "verse_number": "१-२-१२-२", "content_sanskrit": "सूत उवाच ।\nशुश्रूषा यत्र वो विप्रास्तच्छृणुध्वमतंद्रिताः ।\nप्लक्षखंडः किंपुरुषे सुमहान्नंदनोपमः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006151002, "chapter_id": 26151, "verse_number": "१-२-१२-३", "content_sanskrit": "दशवर्षसहस्राणि स्थितिः किंपुरुषे स्मृता ।\nसुवर्णवर्णाः पुरुषाः स्त्रियश्चाप्सरसो पमाः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006151003, "chapter_id": 26151, "verse_number": "१-२-१२-४", "content_sanskrit": "अनामया अशोकाश्च नित्यं मुदितमानसाः ।\nजायन्ते मानवास्तत्र निस्तप्तकनकप्रभाः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006151004, "chapter_id": 26151, "verse_number": "१-२-१२-५", "content_sanskrit": "वर्षे किंपुरुषे पुण्ये वृक्षो मधुवहः शुभः ।\nतस्य किंपुरुषाः सर्वेऽपिबन् हि रसमुत्तमम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006151005, "chapter_id": 26151, "verse_number": "१-२-१२-६", "content_sanskrit": "ततः परं किंपुरुषो हरिवर्षः प्रचक्षते ।\nमहारजतसंकाशा जायन्ते तत्र मानवाः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006151006, "chapter_id": 26151, "verse_number": "१-२-१२-७", "content_sanskrit": "देवलोकच्युताः सर्वे देवानूकाश्च सर्वेशः ।\nहरिवर्षे नराः सर्वे पिबंतीक्षुरसं शुफम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006151007, "chapter_id": 26151, "verse_number": "१-२-१२-८", "content_sanskrit": "एकादश सहस्राणि वर्षाणां तु निरामयाः ।\nहरिवर्षे तु जीवंति सर्वे मुदितमानसाः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006151008, "chapter_id": 26151, "verse_number": "१-२-१२-९", "content_sanskrit": "न जरा बाधते तत्र न म्रियंते च तेऽचिरात् ।\nमध्यमं यन्मया प्रोक्तं नाम्ना वर्षमिलावृतम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006151009, "chapter_id": 26151, "verse_number": "१-२-१२-१०", "content_sanskrit": "न तत्र सूर्यस्तपति न तु जीर्यंति मानवाः ।\nचंद्रसूर्यै सनक्षत्रौ न प्रकाशाविला वृते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006151010, "chapter_id": 26151, "verse_number": "१-२-१२-११", "content_sanskrit": "पद्मप्रभाः पद्बवर्णास्तथा पद्बनिभेक्षणाः ।\nपद्मपत्रसुगंधाश्च जायन्ते तत्र मानवाः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006151011, "chapter_id": 26151, "verse_number": "१-२-१२-१२", "content_sanskrit": "जंबूफलरसाहारा अनिष्यंदाः सुगन्धिनः ।\nमनस्विनो भुक्तभोगाः सत्कर्मफलभोगिनः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006151012, "chapter_id": 26151, "verse_number": "१-२-१२-१३", "content_sanskrit": "देवलोकच्यताश्चैव महारजतवाससः ।\nत्रयोदशसहस्राणि वर्षाणां ते नरोत्तमाः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006151013, "chapter_id": 26151, "verse_number": "१-२-१२-१४", "content_sanskrit": "आयुः प्रमाणं जीवंति ये तु वर्ष इलावृते ।\nमेरोः प्रतिदिशं यच्च नवसाहस्रविस्तृतम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006151014, "chapter_id": 26151, "verse_number": "१-२-१२-१५", "content_sanskrit": "योजनानां सहस्राणि षट्त्रिंशत्तस्य विस्तरः ।\nयतुरस्रं समंताच्च शरावाकारसंस्थितम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006151015, "chapter_id": 26151, "verse_number": "१-२-१२-१६", "content_sanskrit": "मेरोः पश्चिमभागे तु नवसाहस्रसम्मिते ।\nचतुस्त्रिंशत्सहस्राणि गंधमादनपर्वतः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006151016, "chapter_id": 26151, "verse_number": "१-२-१२-१७", "content_sanskrit": "उदग्दक्षिणतश्चैव आनीलनिषधायतः ।\nचत्वारिंशत्सहस्राणि परिवृद्धो महीतलात् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006151017, "chapter_id": 26151, "verse_number": "१-२-१२-१८", "content_sanskrit": "सहस्रमवगाढश्च तावदेव च विस्तृतः ।\nपूर्वेण माल्यवाञ्छैलस्तत्प्रमाणः प्रकीर्त्तितः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006151018, "chapter_id": 26151, "verse_number": "१-२-१२-१९", "content_sanskrit": "दक्षिणेन तु नीलश्च निषधश्चोत्तरेण तु ।\nतेषां मध्ये महामेरुः स्वैः प्रमाणैः प्रतिष्ठितः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006151019, "chapter_id": 26151, "verse_number": "१-२-१२-२०", "content_sanskrit": "सर्वेषामेव शैलानामवगाढो यथा भवेत् ।\nविस्तरस्तत्प्रमाणः स्यादायामो नियुतं स्मृतः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006151020, "chapter_id": 26151, "verse_number": "१-२-१२-२१", "content_sanskrit": "वृत्तभावास्समुद्रस्य महीमंडलभावतः ।\nआयामाः परिहीयन्ते चतुरस्रसमाः स्मृताः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006151021, "chapter_id": 26151, "verse_number": "१-२-१२-२२", "content_sanskrit": "इलावृतं चतुष्कोणं भिंदंती मध्यभागतः ।\nप्रभिन्नांजनसंकाशा जम्बूरसवती नदी ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006151022, "chapter_id": 26151, "verse_number": "१-२-१२-२३", "content_sanskrit": "मेरोस्तु दक्षिणे पार्श्वे निषधस्योत्तरेण च ।\nसुदर्शनो नाम महाञ्जम्बूवृक्षः सनातनः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006151023, "chapter_id": 26151, "verse_number": "१-२-१२-२४", "content_sanskrit": "नित्यपुष्पफलोपेतः सिद्धचारणसेवितः ।\nतस्य नाम्ना समा ख्यातो जम्बूद्वीपो वनस्पतेः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006151024, "chapter_id": 26151, "verse_number": "१-२-१२-२५", "content_sanskrit": "योजनानां सहस्रं च शतं चान्यन्महात्मनः ।\nउत्सेधो वृक्षराजस्य दिवं स्पृशति सर्वतः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006151025, "chapter_id": 26151, "verse_number": "१-२-१२-२६", "content_sanskrit": "अरत्नीनां शतान्यष्टावेकषष्ट्यधिकानि तु ।\nफलप्रमाणं संख्यातमृषिभिस्तत्त्वदर्शिभिः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006151026, "chapter_id": 26151, "verse_number": "१-२-१२-२७", "content_sanskrit": "पतमानानि तान्युर्व्यां कुर्वंति विपुलं स्वनम् ।\nतस्या जम्ब्वाः फलरसो नदी भूत्वा प्रसर्प्पति ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006151027, "chapter_id": 26151, "verse_number": "१-२-१२-२८", "content_sanskrit": "मेरुं प्रदक्षिणं कृत्वा जम्बूमूलं विशत्यधः ।\nतं पिबंति सदा त्दृष्टा जंबूरसमिलावृते ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006151028, "chapter_id": 26151, "verse_number": "१-२-१२-२९", "content_sanskrit": "जंबूफलरसे पीते न जरा बाधते तु तान् ।\nन क्षुधा न श्रमश्चापि न मृत्युर्न च तंद्रि तम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006151029, "chapter_id": 26151, "verse_number": "१-२-१२-३०", "content_sanskrit": "तत्र जांबूनदं नाम कनकं देवभूषमम् ।\nइंद्रगोपकसंकाशं जायते भास्वरं तु तत् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006151030, "chapter_id": 26151, "verse_number": "१-२-१२-३१", "content_sanskrit": "सर्वेषां वर्षवृक्षाणां शुभः फलरसः स्तुतः ।\nस्कन्नं भवति तच्छुभ्रं कनकं देवभूषणम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006151031, "chapter_id": 26151, "verse_number": "१-२-१२-३२", "content_sanskrit": "तेषां मूत्रं पुरीषं च दिक्षु सर्वासु सर्वशः ।\nईश्वरानुग्रहाद्भूमिर्मृताश्च ग्रसते तु तान् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006151032, "chapter_id": 26151, "verse_number": "१-२-१२-३३", "content_sanskrit": "रक्षःपिशाचयक्षाश्च सर्वे हैमवतः स्मृताः ।\nहेमकूटे तु गंधर्वा विज्ञेयाः साप्सरोगणाः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006151033, "chapter_id": 26151, "verse_number": "१-२-१२-३४", "content_sanskrit": "सर्वे नागस्तु निषधे शेषवासुकितक्षकाः ।\nमहामेरौ त्रयस्त्रिंशत्क्रीडंते यज्ञियाः सुराः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006151034, "chapter_id": 26151, "verse_number": "१-२-१२-३५", "content_sanskrit": "नीले तु वैदूर्यमये सिद्धा ब्रह्मर्षयोऽमलाः ।\nदैत्यानां दानवानां च श्र्वेतः पर्वत उच्यते ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006151035, "chapter_id": 26151, "verse_number": "१-२-१२-३६", "content_sanskrit": "श्रृंगवान्पर्वतश्रेष्ठः पितॄणां प्रतिसंचरः ।\nनवस्वेतेषु वर्षेषु यथाभागं स्थितेषु वै ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006151036, "chapter_id": 26151, "verse_number": "१-२-१२-३७", "content_sanskrit": "भूतान्युपनिविष्टानि गतिमंति ध्रुवाणि च ।\nतेषां विवृद्धिर्बहुधा दृश्यते दिव्यमानुषी ।\nन संख्या परिसंख्यातुं श्रद्धेया तु बुभूषताम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]