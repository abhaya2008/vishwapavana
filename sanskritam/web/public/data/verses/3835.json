[{"id": 2131360, "chapter_id": 3835, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2131361, "chapter_id": 3835, "verse_number": "१", "content_sanskrit": "ततो निवातकवचाः सर्वे वेगेन भारत ।\nअभ्यद्रवन् मां सहिताः प्रगृहीतायुधा रणे\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2131362, "chapter_id": 3835, "verse_number": "२", "content_sanskrit": "आच्छाद्य रथपन्थानमुत्क्रोशन्तो महारथाः ।\nआवृत्य सर्वतस्ते मां शरवर्षैरवाकिरन्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2131363, "chapter_id": 3835, "verse_number": "३", "content_sanskrit": "ततोऽपरे महावीर्याः शूलपट्टिसपाणयः ।\nशूलानि च भुशुण्डीश्च मुमुचुर्दानवा मयि\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2131364, "chapter_id": 3835, "verse_number": "४", "content_sanskrit": "तच्छूलवर्षं सुमहद् गदाशक्तिसमाकुलम् ।\nअनिशं सृज्यमानं तैरपतन् मद्रथोपरि\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2131365, "chapter_id": 3835, "verse_number": "५", "content_sanskrit": "अन्ये मामभ्यधावन्त निवातकवचा युधि ।\nशितशस्त्रायुधा रौद्राः कालरूपाः प्रहारिणः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2131366, "chapter_id": 3835, "verse_number": "६", "content_sanskrit": "तानहं विविधैर्बाणैर्वेगवद्भिरजिह्मगैः ।\nगाण्डीवमुक्तैरभ्यघ्नमेकैकं दशभिर्मृधे \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2131367, "chapter_id": 3835, "verse_number": "७", "content_sanskrit": "ते कृता विमुखाः सर्वे मत्प्रयुक्तैः शिलाशितैः ।\nततो मातलिना तूर्णं हयास्ते सम्प्रचोदिताः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2131368, "chapter_id": 3835, "verse_number": "८", "content_sanskrit": "मार्गान् बहुविधांस्तत्र विचेरुर्वातरंहसः ।\nसुसंयता मातलिना प्रामथ्नन्त दितेः सुतान्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2131369, "chapter_id": 3835, "verse_number": "९", "content_sanskrit": "शतं शतास्ते हरयस्तस्मिन् युक्ता महारथे ।\nतदा मातलिना यत्ता व्यचरन्नल्पका इव \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2131370, "chapter_id": 3835, "verse_number": "१०", "content_sanskrit": "तेषां चरणपातेन रथनेमिस्वनेन च ।\nमम बाणनिपातैश्च हतास्ते शतशोऽसुराः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2131371, "chapter_id": 3835, "verse_number": "११", "content_sanskrit": "गतासवस्तथैवान्ये प्रगृहीतशरासनाः ।\nहतसारथयस्तत्र व्यकृष्यन्त तुरङ्गमैः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2131372, "chapter_id": 3835, "verse_number": "१२", "content_sanskrit": "ते दिशो विदिशः सर्वे प्रतिरुध्य प्रहारिणः ।\nअभ्यघ्नन् विविधैः शस्त्रैस्ततो मे व्यथितं मनः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2131373, "chapter_id": 3835, "verse_number": "१३", "content_sanskrit": "ततोऽहं मातलेर्वीर्यमपश्यं परमाद्भुतम् ।\nअश्वांस्तथा वेगवतो यदयत्नादधारयत्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2131374, "chapter_id": 3835, "verse_number": "१४", "content_sanskrit": "ततोऽहं लघुभिश्चित्रैरस्त्रैस्तानसुरान् रणे ।\nचिच्छेद सायुधान् राजन् शतशोऽथ सहस्रशः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2131375, "chapter_id": 3835, "verse_number": "१५", "content_sanskrit": "एवं मे चरतस्तत्र सर्वयत्नेन शत्रुहन् ।\nप्रीतिमानभवद् वीरो मातलिः शक्रसारथिः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2131376, "chapter_id": 3835, "verse_number": "१६", "content_sanskrit": "वध्यमानास्ततस्तैस्तु हयैस्तेन रथेन च ।\nअगमन् प्रक्षयं केचिन्न्यवर्तन्त तथा परे\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2131377, "chapter_id": 3835, "verse_number": "१७", "content_sanskrit": "स्पर्धमाना इवास्माभिर्निवातकवचा रणे।\nशरवर्षैः शरार्तं मां महद्भिः प्रत्यवारयन्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2131378, "chapter_id": 3835, "verse_number": "१८", "content_sanskrit": "ततोऽहं लघुभिश्चित्रैर्ब्रह्मास्त्रपरिमन्त्रितैः ।\nव्यधमं सायकैराशु शतशोऽथ सहस्रशः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2131379, "chapter_id": 3835, "verse_number": "१९", "content_sanskrit": "ततः सम्पीड्यमानास्ते क्रोधाविष्टा महासुराः ।\nअपीडयन् मां सहिताः शरशूलासिवृष्टिभिः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2131380, "chapter_id": 3835, "verse_number": "२०", "content_sanskrit": "ततोऽहमस्त्रमातिष्ठं परमं तिग्मतैजसम् ।\nदयितं देवराजस्य माधवं नाम भारत\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2131381, "chapter_id": 3835, "verse_number": "२१", "content_sanskrit": "ततः खड्गांस्त्रिशूलांश्च तोमरांश्च सहस्रशः ।\nअस्त्रवीर्येण शतधा तैर्मुक्तानहमच्छिदम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2131382, "chapter_id": 3835, "verse_number": "२२", "content_sanskrit": "छित्त्वा प्रहरणान्येषां ततस्तानपि सर्वशः ।\nप्रत्यविध्यमहं रोषाद् दशभिर्दशभिः शरैः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2131383, "chapter_id": 3835, "verse_number": "२३", "content_sanskrit": "गाण्डीवाद्धि तदा सङ्खे यथा भ्रमरपङ्कयः ।\nनिष्पतन्ति महाबाणास्तन्मातलिरपूजयत्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2131384, "chapter_id": 3835, "verse_number": "२४", "content_sanskrit": "तेषामपि तु बाणास्ते बहुत्वाच्छलभा इव ।\nअवाकिरन्मां बलवत् तानहं व्यधमं शरैः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2131385, "chapter_id": 3835, "verse_number": "२५", "content_sanskrit": "वध्यमानास्ततस्ते तु निवातकवचाः पुनः ।\nशरवर्षैर्महद्भिर्मां समन्तात् पर्यवारयन्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2131386, "chapter_id": 3835, "verse_number": "२६", "content_sanskrit": "शरवेगान्निहत्याहमस्त्रैरस्त्रविघातिभिः ।\nज्वलद्भिः परमैः शीघ्रैस्तानविध्यं सहस्रशः \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2131387, "chapter_id": 3835, "verse_number": "२७", "content_sanskrit": "तेषां छिन्नानि गात्राणि विसृजन्ति स्म शोणितम् ।\nप्रावृषीवाभिवृष्टानि शृङ्गाण्यथ धराभृताम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2131388, "chapter_id": 3835, "verse_number": "२८", "content_sanskrit": "इन्द्राशनिसमस्पर्शैर्वेगवद्भिरजिह्मगैः ।\nमद्बाणैर्वध्यमानास्ते समुद्विग्नाः स्म दानवाः \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2131389, "chapter_id": 3835, "verse_number": "२९", "content_sanskrit": "शतधा भिन्नदेहास्ते क्षीणप्रहरणौजसः ।\nततो निवातकवचा मामयुध्यन्त मायया\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2131390, "chapter_id": 3835, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि निवातकवचयुद्धपर्वणि पञ्चषष्ट्यधिकशततमोऽध्यायः ॥१६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2131391, "chapter_id": 3835, "verse_number": "", "content_sanskrit": "यक्षयुद्धपर्वणि द्वादशोऽध्यायः ॥१२॥\n* * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]