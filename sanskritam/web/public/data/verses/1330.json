[{"id": 2015681, "chapter_id": 1330, "verse_number": "२-७१-१", "content_sanskrit": "वैशम्पायन उवाच॥\nततः प्रववृते यज्ञो धर्मराजस्य धीमतः।\nशान्तविघ्नार्हणक्षोभो महर्षिगणसङ्कुलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2015682, "chapter_id": 1330, "verse_number": "२-७१-२", "content_sanskrit": "तं तु यज्ञं महाबाहुरासमाप्तेर्जनार्दनः।\nररक्ष भगवाञ्छौरिः शार्ङ्गचक्रगदाधरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2015683, "chapter_id": 1330, "verse_number": "२-७१-३", "content_sanskrit": "तस्मिन्यज्ञे प्रवृत्ते तु वाग्मिनो हेतुवादिनः।\nहेतुवादान्बहून्प्राहुः परपक्षजिगीषवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2015684, "chapter_id": 1330, "verse_number": "२-७१-४", "content_sanskrit": "ददृशुस्ते नृपतयो यज्ञस्य विधिमुत्तमम्।\nउपेन्द्रस्येव विहितं सहदेवेन भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2015685, "chapter_id": 1330, "verse_number": "२-७१-५", "content_sanskrit": "तद्यज्ञे न्यवसन्राजन्ब्राह्मणा भृशमुत्सुकाः।\nकथयन्तः कथाः पुण्याः पश्यन्तो नटनर्तकान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2015686, "chapter_id": 1330, "verse_number": "२-७१-६", "content_sanskrit": "ददृशुस्तोरणान्यत्र हेमतालमयानि च।\nदीप्तभास्करतुल्यानि प्रदीप्तानीव तेजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2015687, "chapter_id": 1330, "verse_number": "२-७१-७", "content_sanskrit": "स यज्ञस्तोरणैस्तत्र ग्रहैर्द्योरिव सम्बभौ।\nशय्यासनविहारांश्च सुबहून्रत्नसंवृतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2015688, "chapter_id": 1330, "verse_number": "२-७१-८", "content_sanskrit": "घटान्पात्रीकटाहानि कलशानि समन्ततः।\nन ते किञ्चिदसौवर्णमपश्यंस्तत्र पार्थिवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2015689, "chapter_id": 1330, "verse_number": "२-७१-९", "content_sanskrit": "भुञ्जानानां च विप्राणां स्वादुभोज्यैः पृथग्विधैः।\nअनिशं श्रूयते तत्र मुदितानां महात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2015690, "chapter_id": 1330, "verse_number": "२-७१-१०", "content_sanskrit": "दीयतां दीयतामेषां भुज्यतां भुज्यतामिति।\nएवम्प्रकाराः सञ्जल्पाः श्रूयन्ते तत्र नित्यशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2015691, "chapter_id": 1330, "verse_number": "२-७१-११", "content_sanskrit": "ओदनानां विकाराणि स्वादूनि च बहूनि च।\nविविधआनि च भक्ष्याणि पेयानि मधुराणि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2015692, "chapter_id": 1330, "verse_number": "२-७१-१२", "content_sanskrit": "ददुर्द्विजानां सततं राजप्रेष्या महाध्वरे।\nपूर्णे शतसहस्रे तु विप्राणां भुञ्जतां तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2015693, "chapter_id": 1330, "verse_number": "२-७१-१३", "content_sanskrit": "स्थापितस्तत्र सञ्ज्ञार्थं शङ्खोऽध्मायत नित्यशः।\nमुहुर्मुहुः प्रणादस्तु तस्य शङ्खस्य भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2015694, "chapter_id": 1330, "verse_number": "२-७१-१४", "content_sanskrit": "उत्तमः श्रूयते शब्दः श्रुत्वा विस्मयमागमन्।\nएवं प्रवृत्ते यज्ञे तु तुष्टपुष्टजनायुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2015695, "chapter_id": 1330, "verse_number": "२-७१-१५", "content_sanskrit": "अन्नस्य बहुशो राजन्नुत्सेधाः पर्वतोपमाः।\nदधिकुल्याश्च ददृशुः सर्पिषश्च ह्रदाञ्जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2015696, "chapter_id": 1330, "verse_number": "२-७१-१६", "content_sanskrit": "जम्बूद्वीपो हि सकलो नानाजनपदायुतः।\nराजन्नदृश्यतैकस्थो राज्ञस्तस्मिन्महाक्रतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2015697, "chapter_id": 1330, "verse_number": "२-७१-१७", "content_sanskrit": "तत्र राजसहस्राणि पुरुषाणां ततस्ततः।\nगृहीत्वा धनमाजग्मुस्तस्य राज्ञो महाक्रतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2015698, "chapter_id": 1330, "verse_number": "२-७१-१८", "content_sanskrit": "राजानः स्रग्विणश्चैव संमृष्टमणिकुण्डलाः।\nतान्परीविविषुर्विप्राञ्छतशोऽथ सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2015699, "chapter_id": 1330, "verse_number": "२-७१-१९", "content_sanskrit": "विविधान्यन्नपानानि लेह्यानि विविधानि च।\nतेषां नृपोपभोग्यानि ब्राह्मणेभ्यो ददुः स्म ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2015700, "chapter_id": 1330, "verse_number": "२-७१-२०", "content_sanskrit": "नानाविधानि भक्ष्याणि स्वादुपुष्पफलानि च।\nगुलानि स्वादुक्षौद्राणि ददुस्ते ब्राह्मणेषु वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2015701, "chapter_id": 1330, "verse_number": "२-७१-२१", "content_sanskrit": "एतानि सततं भुक्त्वा तस्मिन्यज्ञे द्विजातयः।\nपरां प्रीतिं ययुः सर्वे मोदमानास्ततस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2015702, "chapter_id": 1330, "verse_number": "२-७१-२२", "content_sanskrit": "एवं प्रमुदितं सर्वं बहुशो धनधान्यवत्।\nयज्ञवाटं नृपा दृष्ट्वा विस्मयं परमं ययुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2015703, "chapter_id": 1330, "verse_number": "२-७१-२३", "content_sanskrit": "यथाबद्धूयमानाग्निं राजसूयं महाक्रतुम्।\nपाण्डवस्य यथाशास्त्रं जुहुवुः सर्वयाजकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2015704, "chapter_id": 1330, "verse_number": "२-७१-२४", "content_sanskrit": "व्यासधौम्यादयः सर्वे विधिवत्षोडशर्त्विजः।\nस्वस्वकर्माणि चक्रुस्ते पाण्डवस्य महाक्रतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2015705, "chapter_id": 1330, "verse_number": "२-७१-२५", "content_sanskrit": "नाषडङ्गविदत्रासीत्सदस्यो नाबहुश्रुतः।\nनाव्रतो नानुपाध्यायो न पापो नाक्षमो द्विजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2015706, "chapter_id": 1330, "verse_number": "२-७१-२६", "content_sanskrit": "न तत्र कृपणः कश्चिद्दरिद्रो न बभूव ह।\nक्षुधितो दुःखितो वापि प्राकृतो वापि मानुषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2015707, "chapter_id": 1330, "verse_number": "२-७१-२७", "content_sanskrit": "भोजनं भोजनार्थिभ्यो दापयामास सर्वदा।\nसहदेवो महातेजाः सततं राजशासनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2015708, "chapter_id": 1330, "verse_number": "२-७१-२८", "content_sanskrit": "संस्तरे कुशलाश्चापि सर्वकर्माणि याजकाः।\nदिवस दिवसे चक्रुर्यथाशास्त्रार्थचक्षुषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2015709, "chapter_id": 1330, "verse_number": "२-७१-२९", "content_sanskrit": "ब्राह्मणा देवशास्त्रज्ञः कथाश्चक्रुश्च सर्वतः।\nरेमिरे च कथान्ते तु सर्वे तस्मिन्महाक्रतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2015710, "chapter_id": 1330, "verse_number": "२-७१-३०", "content_sanskrit": "सा वेदिर्वेदसम्पन्नैर्देवद्विजमहर्षिभिः।\nआबभासे तदा कीर्णा नक्षत्रैर्द्यौरिवामला॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2015711, "chapter_id": 1330, "verse_number": "२-७१-३१", "content_sanskrit": "पाण्डित्यदर्शनार्थाय केचन द्विजसत्तमाः।\nतर्कार्थमागताः केचित्केचिद्विद्याभिमानिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2015712, "chapter_id": 1330, "verse_number": "२-७१-३२", "content_sanskrit": "केचिद्दिदृक्षया केचिद्भीत्या राज्ञः प्रतापिनः।\nसर्वेऽप्यवभृथस्नाता याजकाः केचन द्विजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2015713, "chapter_id": 1330, "verse_number": "२-७१-३३", "content_sanskrit": "ततो वै हेमयूपांश्च सर्वरत्नसमाचितान्।\nशोभार्थं कारयामास सहदेवो महाद्युतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2015714, "chapter_id": 1330, "verse_number": "२-७१-३४", "content_sanskrit": "ददृशुस्तोरणान्यत्र हेमतालमयानि च।\nस यज्ञस्तोरणैस्तैश्च ग्रहैर्द्योरिव सम्बभौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2015715, "chapter_id": 1330, "verse_number": "२-७१-३५", "content_sanskrit": "तालानां तोरणैर्हैमैर्दान्तैरिव दिशागजैः।\nदिक्षु सर्वासु विन्यस्तैस्तेजोभिर्भास्करैर्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2015716, "chapter_id": 1330, "verse_number": "२-७१-३६", "content_sanskrit": "सकिरीटैर्नृपैश्चैव शुशुभे तत्सदस्तदा।\nदेवैर्दिव्यैश्च यक्षैश्च उरगैर्दिव्यमानुषैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2015717, "chapter_id": 1330, "verse_number": "२-७१-३७", "content_sanskrit": "विद्याधरगणैः कीर्णः पाण्डवस्य महात्मनः।\nस राजसूयः शुशुभे धर्मराजस्य धीमतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2015718, "chapter_id": 1330, "verse_number": "२-७१-३८", "content_sanskrit": "गन्धर्वगणसङ्कीर्णः शोभितोऽप्सरसां गणैः।\nदेवैर्मुनिगणैर्यक्षैर्देवलोक इवापरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2015719, "chapter_id": 1330, "verse_number": "२-७१-३९", "content_sanskrit": "स किम्पुरुषगीतैश्च किन्नरैरुपशोभितः।\nनारदश्च जगौ तत्र तुम्बुरुश्च महाद्युतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2015720, "chapter_id": 1330, "verse_number": "२-७१-४०", "content_sanskrit": "विश्वासुश्चित्रसेनस्तथाऽन्ये गीतकोविदाः।\nरमयन्ति स्म तान्सर्वान्यज्ञकर्मान्तरेष्वथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2015721, "chapter_id": 1330, "verse_number": "२-७१-४१", "content_sanskrit": "तत्र चाप्सरसः सर्वाः सुन्दर्यः प्रियदर्शनाः।\nननृतुश्च जगुश्चात्र नित्यं कर्मान्तरेष्वथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2015722, "chapter_id": 1330, "verse_number": "२-७१-४२", "content_sanskrit": "इतिहासपुराणानि आख्यानानि च सर्वशः।\nऊचुर्वै शब्दशास्त्रज्ञा नित्यं कर्मान्तरेष्वथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2015723, "chapter_id": 1330, "verse_number": "२-७१-४३", "content_sanskrit": "भेर्यश्च मुरजाश्चैव मड्डुका गोमुखाश्च ये।\nशृङ्गवंशाम्बुजा वीणाः श्रूयन्ते स्म सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2015724, "chapter_id": 1330, "verse_number": "२-७१-४४", "content_sanskrit": "लोकेऽस्मिन्सर्वविप्राश्च वैश्याः शूद्रा नृपादयः।\nसर्वे म्लेच्छाः सर्वगणास्त्वादिमध्यान्तजास्तथा।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2015725, "chapter_id": 1330, "verse_number": "२-७१-४५", "content_sanskrit": "नानादेशसमुद्भूतैर्नानाजातिभिरागतैः।\nपर्याप्त इव लोकोऽयं युधिष्ठिरनिवेशने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2015726, "chapter_id": 1330, "verse_number": "२-७१-४६", "content_sanskrit": "भीष्मद्रोणादयः सर्वे कुरवः ससुयोधनाः।\nवृष्णयश्च समग्राश्च पाञ्चालाश्चापि सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2015727, "chapter_id": 1330, "verse_number": "२-७१-४७", "content_sanskrit": "यज्ञेऽस्मिन्सर्वकर्माणि चक्रुर्दासा इव क्रतौ।\nएवं प्रवृत्तो यज्ञः स धर्मराजस्य धीमतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2015728, "chapter_id": 1330, "verse_number": "२-७१-४८", "content_sanskrit": "शुशुभे च महाबाहो सोमस्येव क्रतुर्यथा।\nवस्त्राणि कम्बलांश्चैव प्रावारांश्चैव सर्वदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2015729, "chapter_id": 1330, "verse_number": "२-७१-४९", "content_sanskrit": "निष्कहेमजभाण्डानि भूषणानि च सर्वशः।\nप्रददौ तत्र विप्राणां धर्मराजो युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2015730, "chapter_id": 1330, "verse_number": "२-७१-५०", "content_sanskrit": "यानि तत्र महीपालैर्लब्धवान्भरतर्षभः।\nतानि सर्वाणि रत्नानि ब्राह्मणानां ददौ तदा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2015731, "chapter_id": 1330, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि शिशुपालवधपर्वणि एकसप्ततितमोऽध्यायः॥७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]