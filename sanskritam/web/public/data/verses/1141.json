[{"id": 2007261, "chapter_id": 1141, "verse_number": "१-१४२-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2007262, "chapter_id": 1141, "verse_number": "१-१४२-१", "content_sanskrit": "प्रतिजग्राह तं भीष्मो गुरुं पाण्डुसुतैः सह।\nपौत्रानादाय तान्सर्वान्वसूनि विविधानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2007263, "chapter_id": 1141, "verse_number": "१-१४२-२", "content_sanskrit": "शिष्य इति ददौ राजन्द्रोणाय विधिपूर्वकम्।\nतदा द्रोणोऽब्रवीद्वाक्यं भीष्मं बुद्धिमतां वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2007264, "chapter_id": 1141, "verse_number": "१-१४२-३", "content_sanskrit": "कृपस्तिष्ठति चाचार्यः शस्त्रज्ञः प्राज्ञसंमतः।\nमयि तिष्ठति चेद्विप्रो वैमनस्यं गमिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2007265, "chapter_id": 1141, "verse_number": "१-१४२-४", "content_sanskrit": "युष्मान्किंचिच्च याचित्वा धनं संगृह्य हर्षितः।\nस्वमाश्रमपदं राजन्गमिष्यामि यथागतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2007266, "chapter_id": 1141, "verse_number": "१-१४२-५", "content_sanskrit": "एवमुक्ते तु विप्रेन्द्रं भीष्मः प्रहरतां वरः।\nअब्रवीद्द्रोणमाचार्यमुख्यं शस्त्रविदां वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2007267, "chapter_id": 1141, "verse_number": "१-१४२-६", "content_sanskrit": "कृपस्तिष्ठतु पूज्यश्च भर्तव्यश्च मया सदा।\nत्वं गुरुर्भव पौत्राणामाचार्यस्त्वं मतो मम।\nप्रतिगृह्णीष्व पुत्रांस्त्वमस्त्रज्ञान्कुरु वै सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2007268, "chapter_id": 1141, "verse_number": "१-१४२-७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2007269, "chapter_id": 1141, "verse_number": "१-१४२-७", "content_sanskrit": "ततः संपूजितो द्रोणो भीष्मेण द्विपदां वरः।\nविशश्राम महातेजाः पूजितः कुरुवेश्मनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2007270, "chapter_id": 1141, "verse_number": "१-१४२-८", "content_sanskrit": "विश्रान्तेऽथ गुरौ तस्मिन्पौत्रानादाय कौरवान्।\nशिष्यत्वेन ददौ भीष्मो वसूनि विविधानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2007271, "chapter_id": 1141, "verse_number": "१-१४२-९", "content_sanskrit": "गृहं च सुपरिच्छन्नं धनधान्यसमाकुलम्।\nभारद्वाजाय सुप्रीतः प्रत्यपादयत प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2007272, "chapter_id": 1141, "verse_number": "१-१४२-१०", "content_sanskrit": "स ताञ्शिष्यान्महेष्वासः प्रतिजग्राह कौरवान्।\nपाण्डवान्धार्तराष्ट्रांश्च द्रोणो मुदितमानसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2007273, "chapter_id": 1141, "verse_number": "१-१४२-११", "content_sanskrit": "प्रतिगृह्य च तान्सर्वान्द्रोणो वचनमब्रवीत्।\nरहस्येकः प्रतीतात्मा कृतोपसदनांस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2007274, "chapter_id": 1141, "verse_number": "१-१४२-१२x", "content_sanskrit": "द्रोण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2007275, "chapter_id": 1141, "verse_number": "१-१४२-१२", "content_sanskrit": "कार्यं मे काङ्क्षितं किंचिद्धृदि संपरिवर्तते।\nकृतास्त्रैस्तत्प्रदेयं मे तदेतद्वदतानघाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2007276, "chapter_id": 1141, "verse_number": "१-१४२-१३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2007277, "chapter_id": 1141, "verse_number": "१-१४२-१३", "content_sanskrit": "तच्छ्रुत्वा कौरवेयास्ते तूष्णीमासन्विशांपते।\nअर्जुनस्तु ततः सर्वं प्रतिजज्ञे परन्तप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2007278, "chapter_id": 1141, "verse_number": "१-१४२-१४", "content_sanskrit": "ततोऽर्जुनं तदा मूर्ध्नि समाघ्राय पुनः पुनः।\nप्रीतिपूर्वं परिष्वज्य प्ररुरोद मुदा तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2007279, "chapter_id": 1141, "verse_number": "१-१४२-१५", "content_sanskrit": "अश्वत्थामानमाहूय द्रोणो वचनमब्रवीत्।\nसखायं विद्धि ते पार्थं मया दत्तः प्रगृह्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2007280, "chapter_id": 1141, "verse_number": "१-१४२-१६", "content_sanskrit": "साधुसाध्विति तं पार्थः परिष्वज्येदमब्रवीत्।\nअद्यप्रभृति विप्रेन्द्र परवानस्मि धर्मतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2007281, "chapter_id": 1141, "verse_number": "१-१४२-१७", "content_sanskrit": "शिष्योऽहं त्वत्प्रसादेन जीवामि द्विजसत्तम।\nइत्युक्त्वा तु तदा पार्थः पादौ जग्राह पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2007282, "chapter_id": 1141, "verse_number": "१-१४२-१८", "content_sanskrit": "ततो द्रोणः पाण्डुपुत्रानस्त्राणि विविधानि च।\nग्राहयामास दिव्यानि मानुषाणि च वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2007283, "chapter_id": 1141, "verse_number": "१-१४२-१९", "content_sanskrit": "राजपुत्रास्तथा चान्ये समेत्य भरतर्षभ।\nअभिजग्मुस्ततो द्रोणमस्त्रार्थे द्विजसत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2007284, "chapter_id": 1141, "verse_number": "१-१४२-२०", "content_sanskrit": "वृष्णयश्चान्धकाश्चैव नानादेश्याश्च पार्थिवाः।\nसूतपुत्रश्च राधेयो गुरुं द्रोणमियात्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2007285, "chapter_id": 1141, "verse_number": "१-१४२-२१", "content_sanskrit": "स्पर्धमानस्तु पार्थेन सूतपुत्रोऽत्यमर्षणः।\nदुर्योधनं समाश्रित्य सोऽवमन्यत पाण्डवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2007286, "chapter_id": 1141, "verse_number": "१-१४२-२२", "content_sanskrit": "अभ्ययात्स ततो द्रोणं धनुर्वेदचिकीर्षया।\nशिक्षाभुजवलोद्योगैस्तेषु सर्वेषु पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2007287, "chapter_id": 1141, "verse_number": "१-१४२-२३", "content_sanskrit": "अस्त्रविद्यानुरागाच्च विशिष्टोऽभवदर्जुनः।\nतुल्येष्वस्त्रप्रयोगेषु लाघवे सौष्टवेषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2007288, "chapter_id": 1141, "verse_number": "१-१४२-२४", "content_sanskrit": "सर्वेषामेव शिष्याणां बभूवाभ्यधिकोऽर्जुनः।\nऐन्द्रिमप्रतिमं द्रोण उपदेशेष्वमन्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2007289, "chapter_id": 1141, "verse_number": "१-१४२-२५", "content_sanskrit": "एवं सर्वकुमाराणामिष्वस्त्रं प्रत्यपादयत्।\nकमण्डलुं च सर्वेषां प्रायच्छच्चिरकारणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2007290, "chapter_id": 1141, "verse_number": "१-१४२-२६", "content_sanskrit": "पुत्राय च ददौ कुम्भमविलम्बनकारणात्।\nयावत्ते नोपगच्छ्ति तावदस्मै परां क्रियाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2007291, "chapter_id": 1141, "verse_number": "१-१४२-२७", "content_sanskrit": "द्रोण आचष्ट पुत्राय कर्म तज्जिष्णुरौहत।\nततः स वारुणास्त्रेण पूरयित्वा कमण्डलुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2007292, "chapter_id": 1141, "verse_number": "१-१४२-२८", "content_sanskrit": "सममाचार्यपुत्रेण गुरुमभ्येति फाल्गुनः।\nआचार्यपुत्रात्तस्मात्तु विशेषोपचयेऽपृथक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2007293, "chapter_id": 1141, "verse_number": "१-१४२-२९", "content_sanskrit": "न व्यहीयत मेधावी पार्थोऽप्यस्त्रविदां वरः।\nअर्जुनः परमं यत्नमातिष्ठद्गुरुपूजने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2007294, "chapter_id": 1141, "verse_number": "१-१४२-३०", "content_sanskrit": "अस्त्रे च परमं योगं प्रियो द्रोणस्य चाभवत्।\nतं दृष्ट्वा नित्यमुद्युक्तमिष्वस्त्रं प्रति फाल्गुनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2007295, "chapter_id": 1141, "verse_number": "१-१४२-३१", "content_sanskrit": "आहूय वचनं द्रोणो रहः सूदमभाषत।\nअन्धकारेऽर्जुनायान्नं न देयं ते कदाचन।\nन चाख्येयमिदं चापि मद्वाक्यं विजयेत्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2007296, "chapter_id": 1141, "verse_number": "१-१४२-३२", "content_sanskrit": "ततः कदाचिद्भुञ्जाने प्रववौ वायुरर्जुने।\nतेन तत्र प्रदीपः स दीप्यमानो विलोपितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2007297, "chapter_id": 1141, "verse_number": "१-१४२-३३", "content_sanskrit": "भुक्त एव तु कौन्तेयो नास्यादन्यत्र वर्तते।\nहस्तस्तेजस्विनस्तस्य अनुग्रहणकारणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2007298, "chapter_id": 1141, "verse_number": "१-१४२-३४", "content_sanskrit": "तदभ्यासकृतं मत्वा रात्रावपि स पाण्डवः।\nयोग्यां चक्रे महाबाहुर्धनुषा पाण्डुनन्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2007299, "chapter_id": 1141, "verse_number": "१-१४२-३५", "content_sanskrit": "तस्य ज्यातलनिर्घोषं द्रोणः शुश्राव भारत।\nउपेत्य चैनमुत्थाय परिष्वज्येदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2007300, "chapter_id": 1141, "verse_number": "१-१४२-३६x", "content_sanskrit": "द्रोण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2007301, "chapter_id": 1141, "verse_number": "१-१४२-३६", "content_sanskrit": "प्रयतिष्ये तथा कर्तुं यथा नान्यो धनुर्धरः।\nत्वत्समो भविता लोके सत्यमेतद्ब्रवीमि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2007302, "chapter_id": 1141, "verse_number": "१-१४२-३७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2007303, "chapter_id": 1141, "verse_number": "१-१४२-३७", "content_sanskrit": "ततो द्रोणोऽर्जुनं भूयो हयेषु च गजेषु च।\nरथेषु भूमावपि च रणशिक्षामशिक्षयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2007304, "chapter_id": 1141, "verse_number": "१-१४२-३८", "content_sanskrit": "गदायुद्धेऽसिचर्यायां तोमरप्रासशक्तिषु।\nद्रोणः संकीर्णयुद्धे च शिक्षयामास कौरवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2007305, "chapter_id": 1141, "verse_number": "१-१४२-३९", "content_sanskrit": "तस्य तत्कौशलं श्रुत्वा धनुर्वेदजिघृक्षवः।\nसजानो राजपुत्राश्च समाजग्मुः सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2007306, "chapter_id": 1141, "verse_number": "१-१४२-४०", "content_sanskrit": "तान्सर्वाञ्शिक्षयामास द्रोणः शस्त्रभृतां वरः।\nततो निषादराजस्य हिरण्यधनुषः सुतः।\nएकलव्यो महाराज द्रोणमभ्याजगाम ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2007307, "chapter_id": 1141, "verse_number": "१-१४२-४१", "content_sanskrit": "न स तं प्रतिजग्राह नैषादिरिति चिन्तयन्।\nशिष्यं धनुषि धर्मज्ञस्तेषामेवान्ववेक्षया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2007308, "chapter_id": 1141, "verse_number": "१-१४२-४२x", "content_sanskrit": "द्रोण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2007309, "chapter_id": 1141, "verse_number": "१-१४२-४२", "content_sanskrit": "शिष्योऽसि मम नैषादे प्रयोगे बलत्तरः।\nनिवर्तस्व गृहानेव अनुज्ञातोऽसि नित्यशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2007310, "chapter_id": 1141, "verse_number": "१-१४२-४३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2007311, "chapter_id": 1141, "verse_number": "१-१४२-४३", "content_sanskrit": "स तु द्रोणस्य शिरसा पादौ गृह्य परन्तपः।\nअरण्यमनुसंप्राप्य कृत्वा द्रोणं महीमयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2007312, "chapter_id": 1141, "verse_number": "१-१४२-४४", "content_sanskrit": "तस्मिन्नाचार्यवृत्तिं च परमामास्थितस्तदा।\nइष्वस्त्रे योगमातस्थे परं नियममास्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2007313, "chapter_id": 1141, "verse_number": "१-१४२-४५", "content_sanskrit": "परया श्रद्धयोपेतो योगेन परमेण च।\nविमोक्षादानसन्धाने लघुत्वं परमाप सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2007314, "chapter_id": 1141, "verse_number": "१-१४२-४६", "content_sanskrit": "लाघवं चास्त्रयोगं च नचिरात्प्रत्यपद्यत।\nअथ द्रोणाभ्यनुज्ञाताः कदाचित्कुरुपाण्डवाः।\nरथैर्विनिर्ययुः सर्वे मृगयामरिमर्दनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2007315, "chapter_id": 1141, "verse_number": "१-१४२-४७", "content_sanskrit": "तत्रोपकरणं गृह्य नरः कश्चिद्यदृच्छया।\nराजन्ननुजगामैकः श्वानमादाय पाण्डवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2007316, "chapter_id": 1141, "verse_number": "१-१४२-४८", "content_sanskrit": "तेषां विचरतां तत्र तत्तत्कर्मचिकीर्षया।\nश्वाचरन्स पथा क्रीडन्नैषादिं प्रति जग्मिवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2007317, "chapter_id": 1141, "verse_number": "१-१४२-४९", "content_sanskrit": "स कृष्णमलदिग्धाङ्गं कृष्णाजिनजटाघरम्।\nनैषादिं श्वा समालक्ष्य भषंस्तस्थौ तदन्तिके॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2007318, "chapter_id": 1141, "verse_number": "१-१४२-५०", "content_sanskrit": "तदा तस्याथ भषतः शुनः सप्त शरान्मुखे।\nलाघवं दर्शन्नस्त्रे मुमोच युगपद्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2007319, "chapter_id": 1141, "verse_number": "१-१४२-५१", "content_sanskrit": "स तु श्वा शरपूर्णास्यः पाण्डवानाजगाम ह।\nतं दृष्ट्वा पाण्डवा वीराः परं विस्मयमागताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2007320, "chapter_id": 1141, "verse_number": "१-१४२-५२", "content_sanskrit": "लाघवं शब्धवेधित्वं दृष्ट्वा तत्परमं तदा।\nप्रेक्ष्य तं व्रीडिताश्चासन्प्रशशंसुश्च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2007321, "chapter_id": 1141, "verse_number": "१-१४२-५३", "content_sanskrit": "तं ततोऽन्वेषमाणास्ते वने वननिवासिनम्।\nददृशुः पाण्डवा राजन्नस्यन्तमनिशं शरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2007322, "chapter_id": 1141, "verse_number": "१-१४२-५४", "content_sanskrit": "न चैनमभ्यजानंस्ते तदा विकृतदर्शनम्।\nतथैनं परिपप्रच्छ्रुः को भवान्कस्य वेत्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2007323, "chapter_id": 1141, "verse_number": "१-१४२-५५x", "content_sanskrit": "एकलव्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2007324, "chapter_id": 1141, "verse_number": "१-१४२-५५", "content_sanskrit": "निषादाधिपतेर्वीरा हिरण्यधनुषः सुतम्।\nद्रोणशिष्यं च मां वित्त धुर्वेदकृतश्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2007325, "chapter_id": 1141, "verse_number": "१-१४२-५६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2007326, "chapter_id": 1141, "verse_number": "१-१४२-५६", "content_sanskrit": "ते तमाज्ञाय तत्त्वेन पुनरागम्य पाण्डवाः।\nयथा वृत्तं वने सर्वं द्रोणायाचख्युरद्भुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2007327, "chapter_id": 1141, "verse_number": "१-१४२-५७", "content_sanskrit": "कौन्तेयस्त्वर्जुनो राजन्नेकलव्यमनुस्मरन्।\nरहो द्रोणं समासाद्य प्रणयादिदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2007328, "chapter_id": 1141, "verse_number": "१-१४२-५८", "content_sanskrit": "नन्वहं परिरभ्यैकः प्रीतिपूर्वमिदं वचः।\nभवतोक्तो न मे शिष्यस्त्वद्विशिष्टो भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2007329, "chapter_id": 1141, "verse_number": "१-१४२-५९", "content_sanskrit": "अथ कस्मान्मद्विशिष्टो लोकादपि च वीर्यवान्।\nअन्योऽस्ति भवतः शिष्यो निषादाधिपतेः सुतः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2007330, "chapter_id": 1141, "verse_number": "१-१४२-६०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2007331, "chapter_id": 1141, "verse_number": "१-१४२-६०", "content_sanskrit": "मुहूर्तमिव तं द्रोणश्चिन्तयित्वा विनिश्चयम्।\nसव्यसाचिनमादाय नैषादिं प्रति जग्मिवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2007332, "chapter_id": 1141, "verse_number": "१-१४२-६१", "content_sanskrit": "ददर्श मलदिग्धाङ्गं जटिलं चीरवाससम्।\nएकलव्यं धनुष्पाणिमस्यन्तमनिशं शरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2007333, "chapter_id": 1141, "verse_number": "१-१४२-६२", "content_sanskrit": "एकलव्यस्तु तं दृष्ट्वा द्रोणमायान्तमन्तिकात्।\nअभिगम्योपसंगृह्य जगाम शिरसा महीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2007334, "chapter_id": 1141, "verse_number": "१-१४२-६३", "content_sanskrit": "पूजयित्वा ततो द्रोणं विधिवत्स निषादजः।\nनिवेद्य शिष्यमात्मानं तस्थौ प्राञ्जलिरग्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2007335, "chapter_id": 1141, "verse_number": "१-१४२-६४", "content_sanskrit": "ततो द्रोणोऽब्रवीद्राजन्नेकलव्यमिदं वचः।\nयदि शिष्योऽसि मे वीर वेतनं दीयतां मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2007336, "chapter_id": 1141, "verse_number": "१-१४२-६५", "content_sanskrit": "एकलव्यस्तु तच्छ्रुत्वा प्रीयमाणोऽब्रवीदिदम्।\nकिं प्रयच्छामि भगवन्नाज्ञापयतु मां गुरुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2007337, "chapter_id": 1141, "verse_number": "१-१४२-६६", "content_sanskrit": "न हि किंचिददेयं मे गुरवे ब्रह्मवित्तम।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2007338, "chapter_id": 1141, "verse_number": "१-१४२-६६x", "content_sanskrit": "वैशम्पायन उवाच।\nतमब्रवीत्त्वयाङ्गुष्ठो दक्षिणो दीयतामिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2007339, "chapter_id": 1141, "verse_number": "१-१४२-६७", "content_sanskrit": "एकलव्यस्तु तच्छ्रुत्वा वचो द्रोणस्य दारुणम्।\nप्रतिज्ञामात्मनो रक्षन्सत्ये च नियतः सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2007340, "chapter_id": 1141, "verse_number": "१-१४२-६८", "content_sanskrit": "तथैव हृष्टवदनस्तथैवादीनमानसः।\nछित्त्वाऽविचार्य तं प्रादाद्द्रोणायाङ्गुष्ठमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2007341, "chapter_id": 1141, "verse_number": "१-१४२-६९", "content_sanskrit": "ततः शरं तु नैषादिरङ्गुलीभिर्व्यकर्षत।\nन तथा च स शीघ्रोऽभूद्यथा पूर्वं नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2007342, "chapter_id": 1141, "verse_number": "१-१४२-७०", "content_sanskrit": "ततोऽर्जुनः प्रीतमना बभूव विगतज्वरः।\nद्रोणश्च सत्यवागासीन्नान्योऽभिभविताऽर्जुनं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2007343, "chapter_id": 1141, "verse_number": "१-१४२-७१", "content_sanskrit": "द्रोणस्य तु तदा शिष्यौ गदायोग्यौ बभूवतुः।\nदुर्योधनश्च भीमश्च सदा संरब्धणानसौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2007344, "chapter_id": 1141, "verse_number": "१-१४२-७२", "content_sanskrit": "अश्वत्थामा रहस्येषु सर्वेष्वभ्यधिकोऽभवत्।\nतथाऽतिपुरुषानन्यान्त्सारुकौ यमजावुभौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2007345, "chapter_id": 1141, "verse_number": "१-१४२-७३", "content_sanskrit": "युधिष्ठिरो रथश्रेष्ठः सर्वत्र तु धनञ्जयः।\nप्रथितः सागरान्तायां रथयूथपयूथपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2007346, "chapter_id": 1141, "verse_number": "१-१४२-७४", "content_sanskrit": "बुद्धियोगबलोत्साहः सर्वास्त्रेषु च निष्ठितः।\nअस्त्रे गुर्वनुरागे च विशिष्टोऽभवदर्जुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2007347, "chapter_id": 1141, "verse_number": "१-१४२-७५", "content_sanskrit": "तुल्येष्वस्त्रोपदेशेषु सौष्ठवेन च वीर्यवान्।\nएकः सर्वकुमाराणां बभूवातिरथोऽर्जुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2007348, "chapter_id": 1141, "verse_number": "१-१४२-७६", "content_sanskrit": "प्राणाधिकं भीमसेनं कृतविद्यं धनञ्जयम्।\nधार्तराष्ट्रा दुरात्मानो नामृष्यन्त परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2007349, "chapter_id": 1141, "verse_number": "१-१४२-७७", "content_sanskrit": "तांस्तु सर्वान्समानीय सर्वविद्यास्त्रशिक्षितान्।\nद्रोणः प्रहरणज्ञाने जिज्ञासुः पुरुषर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2007350, "chapter_id": 1141, "verse_number": "१-१४२-७८", "content_sanskrit": "कृत्रिमं भासमारोप्य वृक्षाग्रे शिल्पिभिः कृतम्।\nअविज्ञातं कुमाराणां लक्ष्यभूतमुपादिशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2007351, "chapter_id": 1141, "verse_number": "१-१४२-७९x", "content_sanskrit": "द्रोण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2007352, "chapter_id": 1141, "verse_number": "१-१४२-७९", "content_sanskrit": "शीघ्रं भन्तः सर्वेऽपि धनूंष्यादाय सर्वशः।\nभासमेतं समुद्दिश्य तिष्ठध्वं सन्धितेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2007353, "chapter_id": 1141, "verse_number": "१-१४२-८०", "content_sanskrit": "मद्वाक्यसमकालं तु शिरोऽस्य विनिपात्यताम्।\nएकैकशो नियोक्ष्यामि तथा कुरुत पुत्रकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2007354, "chapter_id": 1141, "verse_number": "१-१४२-८१x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2007355, "chapter_id": 1141, "verse_number": "१-१४२-८१", "content_sanskrit": "ततो युधिष्ठिरं पूर्वमुवाचाङ्गिरसां वरः।\nसंधत्स्व बामं दुर्धर्ष मद्वाक्यान्ते विमुञ्चतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2007356, "chapter_id": 1141, "verse_number": "१-१४२-८२", "content_sanskrit": "ततो युधिष्ठिरः पूर्वं धनुर्गृह्य परन्तपः।\nतस्थौ भासं समुद्दिश्य गुरुवाक्यप्रचोदितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2007357, "chapter_id": 1141, "verse_number": "१-१४२-८३", "content_sanskrit": "ततो विततधन्वानं द्रोणस्तं कुरुनन्दनम्।\nस मुहूर्तादुवाचेदं वचनं भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2007358, "chapter_id": 1141, "verse_number": "१-१४२-८४", "content_sanskrit": "पश्यसि त्वं द्रुमाग्रस्थं भासं नरवरात्मज।\nपश्यामीत्येवमाचार्यं प्रत्युवाच युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2007359, "chapter_id": 1141, "verse_number": "१-१४२-८५", "content_sanskrit": "स मुहूर्तादिव पुनर्द्रोणस्तं प्रत्यभाषत।\nअथ वृक्षमिमं मां वा भ्रातॄन्वाऽपि प्रपश्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2007360, "chapter_id": 1141, "verse_number": "१-१४२-८६", "content_sanskrit": "तमुवाच स कौन्तेयः पश्याम्येनं नवस्पतिम्।\nभन्तं च तथा भ्रातॄन्भासं चेति पुनःपुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2007361, "chapter_id": 1141, "verse_number": "१-१४२-८७", "content_sanskrit": "तमुवाचापसर्पेति द्रोणोऽप्रीतमना इव।\nनैतच्छक्यं त्वया वेद्धुं लक्ष्यमित्येव कुत्सयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2007362, "chapter_id": 1141, "verse_number": "१-१४२-८८", "content_sanskrit": "ततो दुर्योधनादींस्तान्धार्तराष्ट्रान्महायशाः।\nतेनैव क्रमयोगेन जिज्ञासुः पर्यपृच्छत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2007363, "chapter_id": 1141, "verse_number": "१-१४२-८९", "content_sanskrit": "अन्यांश्च शिष्यान्भीमादीन्राज्ञश्चैवान्यदेशजान्।\nयदा च सर्वे तत्सर्वं पश्याम इति कुत्सिताः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2007364, "chapter_id": 1141, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि द्विचत्वारिंशदधिकशततमोऽध्यायः॥ १४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}]