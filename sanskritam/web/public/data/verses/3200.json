[{"id": 2101933, "chapter_id": 3200, "verse_number": "१४-५६-१", "content_sanskrit": "जनमेजय उवाच।\nउदङ्कः केन तपसा संयुक्तो वै महामनाः।\nयः शापं दातुकामोऽभूद्विष्णवे प्रभविष्ववे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2101934, "chapter_id": 3200, "verse_number": "१४-५६-२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2101935, "chapter_id": 3200, "verse_number": "१४-५६-२", "content_sanskrit": "उदङ्को महता युक्तस्तपसा जनमेजय।\nगुरभक्तः स तेजस्वी नान्यत्किञ्चिदपूजयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2101936, "chapter_id": 3200, "verse_number": "१४-५६-३", "content_sanskrit": "सर्वेषामृषिपुत्राणामेष आसीन्मनोरथः।\nऔदङ्कीं गुरुवृत्तिं वै प्राप्नुयामेति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2101937, "chapter_id": 3200, "verse_number": "१४-५६-४", "content_sanskrit": "गौतमस्य तु शिष्याणां बहूनां जनमेजय।\nउदङ्केऽभ्यधिका प्रीतिः स्नेहश्चैवाभवत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2101938, "chapter_id": 3200, "verse_number": "१४-५६-५", "content_sanskrit": "स तस्य दमशौचाभ्यां विक्रान्तेन च कर्मणा।\nसम्यक्चैवोपचारेण गौतमः प्रीतिमानभूत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2101939, "chapter_id": 3200, "verse_number": "१४-५६-६", "content_sanskrit": "अथ शिष्यसहस्राणि समनुज्ञाय गौतमः।\nउदङ्कं परया प्रीत्या नाभ्यनुज्ञातुमैच्छत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2101940, "chapter_id": 3200, "verse_number": "१४-५६-७", "content_sanskrit": "तं क्रमेण जरा तात प्रतिपेदे महामुनिम्।\nन चान्वबुध्यत तदा स मुनिर्गुरुवत्सलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2101941, "chapter_id": 3200, "verse_number": "१४-५६-८", "content_sanskrit": "ततः कदाचिद्राजेन्द्र काष्ठान्यानयितुं ययौ।\nउदङ्कः काष्ठभारं च महान्तं समुपानयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2101942, "chapter_id": 3200, "verse_number": "१४-५६-९", "content_sanskrit": "स तद्भाराभिभूतात्मा काष्ठभारमरिंदम।\nनिचिक्षेप क्षितौ राजन्परिश्रान्तो बुभुक्षितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2101943, "chapter_id": 3200, "verse_number": "१४-५६-१०", "content_sanskrit": "तस्य काष्ठे विलग्नाऽभूज्जटा रूप्यसमप्रभा।\nततः काष्ठैः सह तदा पपात धरणीतलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2101944, "chapter_id": 3200, "verse_number": "१४-५६-११", "content_sanskrit": "ततः स भारनिष्पिष्टः क्षुधाविष्टश्च भारत।\nदृष्ट्वा तां वयसोऽवस्थां रुरोदार्तस्वरं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2101945, "chapter_id": 3200, "verse_number": "१४-५६-१२", "content_sanskrit": "ततो गुरुसुता तस्य पद्मपत्रनिभानना।\nजग्राहाश्रूणि सुश्रोणी करेण पृथुलोचना।\nपितुर्नियोगाद्भावज्ञा शिरसाऽवनता तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2101946, "chapter_id": 3200, "verse_number": "१४-५६-१३", "content_sanskrit": "तस्या निपेततुर्दग्धौ करौ तैरश्रुबिन्दुभिः।\nन हि तानश्रुपातांस्तु शक्ता धारयितुं मही।\nगौतमस्त्वब्रवीद्विप्रमुदङ्कं प्रीतमानसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2101947, "chapter_id": 3200, "verse_number": "१४-५६-१४", "content_sanskrit": "कस्मात्तात तवाद्येह शोकोत्तरमिदं मनः।\nस स्वैरं ब्रूहि विप्रर्षे श्रोतुमिच्छामि तत्त्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2101948, "chapter_id": 3200, "verse_number": "१४-५६-१५x", "content_sanskrit": "उदङ्क उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2101949, "chapter_id": 3200, "verse_number": "१४-५६-१५", "content_sanskrit": "भवद्गतेन मनसा भवत्प्रियचिकीर्षया।\nभवद्भक्तिगतेनेह भवद्भावानुगेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2101950, "chapter_id": 3200, "verse_number": "१४-५६-१६", "content_sanskrit": "जरेयं नाघबुद्धा मे नाभिज्ञातं सुखं च मे।\nशतवर्षोषितं मां हि न त्वमन्यनुजानिथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2101951, "chapter_id": 3200, "verse_number": "१४-५६-१७", "content_sanskrit": "भवता त्वभ्यनुज्ञाताः शिष्याः प्रत्यवरा मम।\nउपपन्ना द्विजश्रेष्ठ शतशोऽथ सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2101952, "chapter_id": 3200, "verse_number": "१४-५६-१८x", "content_sanskrit": "गौतम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2101953, "chapter_id": 3200, "verse_number": "१४-५६-१८", "content_sanskrit": "त्वत्प्रीतियुक्तेन मया गुरुशुश्रूषया तव।\nव्यतिक्रामन्महाकालो नावबुद्धो द्विजर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2101954, "chapter_id": 3200, "verse_number": "१४-५६-१९", "content_sanskrit": "किं त्वद्य यदि ते श्रद्धा गमनं प्रति भार्गव।\nअनुज्ञां प्रतिगृह्य त्वं स्वगृहान्गच्छ माचिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2101955, "chapter_id": 3200, "verse_number": "१४-५६-२०x", "content_sanskrit": "उदङ्क उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2101956, "chapter_id": 3200, "verse_number": "१४-५६-२०", "content_sanskrit": "गुर्वर्तं कं प्रयच्छामि ब्रूहि त्वं द्विजसत्तम।\nतमुपाहृत्य गच्छेयमनुज्ञातस्त्वया विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2101957, "chapter_id": 3200, "verse_number": "१४-५६-२१x", "content_sanskrit": "गौतम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2101958, "chapter_id": 3200, "verse_number": "१४-५६-२१", "content_sanskrit": "दक्षिणापरितोषो वै गुरूणां सद्भिरुच्यते।\nतवि ह्याचरतो धर्मं तुष्टोऽहं वै न संशयः।\nइत्थं च परितुष्टं मां विजानीहि भृगूद्वह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2101959, "chapter_id": 3200, "verse_number": "१४-५६-२२", "content_sanskrit": "युवा षोडशवर्षो हि यद्यद्य भविता भवान्।\nददानि पत्नीं कन्यां च स्वां ते दुहितरं द्विज।\nएतामृतेऽङ्गना नान्या त्वत्तेजोऽर्हति सेवितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2101960, "chapter_id": 3200, "verse_number": "१४-५६-२३", "content_sanskrit": "ततस्तां प्रतिजग्राह युवा भूत्वा यशस्विनीम्।\nगुरुणा चाभ्यनुज्ञातो गुरुपत्नीमथाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2101961, "chapter_id": 3200, "verse_number": "१४-५६-२४", "content_sanskrit": "किं भवत्यै प्रयच्छामि गुर्वर्थं विनियुङ्क्ष माम्।\nप्रियं हितं च काङ्क्षामि प्राणैरपि धनैरपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2101962, "chapter_id": 3200, "verse_number": "१४-५६-२५", "content_sanskrit": "यद्दुर्लभं हि लोकेऽस्मिन्रत्नमत्यद्भुतं महत्।\nतदानयेयं तपसा न हि मेऽत्रास्ति संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2101963, "chapter_id": 3200, "verse_number": "१४-५६-२६x", "content_sanskrit": "अहल्योवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2101964, "chapter_id": 3200, "verse_number": "१४-५६-२६", "content_sanskrit": "परितुष्टाऽस्मि ते विप्र नित्यं भक्त्या तवानघ।\nपर्याप्तमेतद्भद्रं ते गच्छ तात यथेप्सितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2101965, "chapter_id": 3200, "verse_number": "१४-५६-२७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2101966, "chapter_id": 3200, "verse_number": "१४-५६-२७", "content_sanskrit": "उदङ्कस्तु महाराज पुनरेवाब्रवीद्वचः।\nआज्ञापयस्व मां मातः कर्तव्यं च तव प्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2101967, "chapter_id": 3200, "verse_number": "१४-५६-२८x", "content_sanskrit": "अहल्योवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2101968, "chapter_id": 3200, "verse_number": "१४-५६-२८", "content_sanskrit": "सौदासपत्न्या विधृते दिव्ये ये मणिकुण्डले।\nते समानय भद्रं ते गुर्वर्थः सुकृतो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2101969, "chapter_id": 3200, "verse_number": "१४-५६-२९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2101970, "chapter_id": 3200, "verse_number": "१४-५६-२९", "content_sanskrit": "स तथेति प्रतिश्रुत्य जगाम जनमेजय।\nगुरुपत्नीप्रियार्थं वै ते समानयितुं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2101971, "chapter_id": 3200, "verse_number": "१४-५६-३०", "content_sanskrit": "स जगाम ततः शीघ्रमुदङ्को ब्राह्मणर्षभः।\nसौदासं पुरुषादं वै भिक्षितुं मणिकुण्डले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2101972, "chapter_id": 3200, "verse_number": "१४-५६-३१", "content_sanskrit": "गौतमस्त्वब्रवीत्पत्नीमुदङ्को नात्र दृश्यते।\nइति पृष्टा तमाचष्ट कुण्डलार्थे गतं च सा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2101973, "chapter_id": 3200, "verse_number": "१४-५६-३२", "content_sanskrit": "ततः प्रोवाच पत्नीं स न ते सम्यगिदं कृतम्।\nशप्तः स पार्थिवो नूनं ब्राह्मणं तं वधिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2101974, "chapter_id": 3200, "verse_number": "१४-५६-३३x", "content_sanskrit": "अहल्योवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2101975, "chapter_id": 3200, "verse_number": "१४-५६-३३", "content_sanskrit": "अजानन्त्या नियुक्तः स भगवन्ब्राह्मणो मया।\nभवत्प्रसादान्न भयं किञ्चित्तस्य भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2101976, "chapter_id": 3200, "verse_number": "१४-५६-३४", "content_sanskrit": "इत्युक्तः प्राह तां पत्नीमेवमस्त्विति गौतमः।\nउदङ्कोऽपि वने शून्ये राजानं तं ददर्श ह॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2101977, "chapter_id": 3200, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि षट्पञ्चाशोऽध्यायः॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]