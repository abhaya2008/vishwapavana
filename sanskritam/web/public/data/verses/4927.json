[{"id": 2185158, "chapter_id": 4927, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2185159, "chapter_id": 4927, "verse_number": "१", "content_sanskrit": "ततस्तं लुब्धकः पश्यन् कृपयाभिपरिप्लुतः ।\nकपोतमग्नौ पतितं वाक्यं पुनरुवाच ह\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2185160, "chapter_id": 4927, "verse_number": "२", "content_sanskrit": "किमीदृशं नृशंसेन मया कृतमबुद्धिना ।\nभविष्यति हि मे नित्यं पातकं हृदि जीवतः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2185161, "chapter_id": 4927, "verse_number": "३", "content_sanskrit": "स विनिन्दन्नथात्मानं पुनः पुनरुवाच ह ।\nधिङ्मामस्तु सुदुर्बुद्धिं सदा निकृतिनिश्चयम्॥\nशुभं कर्म परित्यज्य योऽहं शकुनिलुब्धकः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2185162, "chapter_id": 4927, "verse_number": "४", "content_sanskrit": "नृशंसस्य महान्यायप्रत्यादेशो न संशयः ।\nदत्तः स्वमांसं दहता कपोतेन महात्मना\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2185163, "chapter_id": 4927, "verse_number": "५", "content_sanskrit": "सोऽहं त्यक्ष्ये प्रियान् प्राणान् पुत्रदारं विसृज्य च ।\nउपदिष्टो हि मे धर्मः कपोतेनातिधर्मिणा\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2185164, "chapter_id": 4927, "verse_number": "६", "content_sanskrit": "अद्य प्रभृति देहं स्वं सर्वभोगैर्विवर्जितम् ।\nयथा स्वल्पं जलं ग्रीष्मे शोषयिष्याम्यहं तथा\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2185165, "chapter_id": 4927, "verse_number": "७", "content_sanskrit": "क्षुत्पिपासातपसहः कृशो धमनिसन्ततः ।\nउपवासैर्बहुविधैश्चरिष्ये पारलौकिकम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2185166, "chapter_id": 4927, "verse_number": "८", "content_sanskrit": "अहो देहप्रदानेन दर्शितातिथिपूजना ।\nतस्माद्धर्मं चरिष्यामि धर्मो हि परमा गतिः ।\nदृष्टो हि धर्मो धर्मिष्ठैर्यादृशो विहगोत्तमे\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2185167, "chapter_id": 4927, "verse_number": "९", "content_sanskrit": "एवमुक्त्वा विनिश्चित्य रौद्रकर्मा स लुब्धकः ।\nमहाप्रस्थानमाश्रित्य प्रययौ संशितव्रतः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2185168, "chapter_id": 4927, "verse_number": "१०", "content_sanskrit": "ततो यष्टिं शलाकाश्च क्षारकं पञ्जरं तथा ।\nतां च बद्धां कपोतीं स सम्प्रमुच्योत्ससर्ज ह\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2185169, "chapter_id": 4927, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि आपद्धर्मे पञ्चदशोऽध्यायः ॥ १५ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}]