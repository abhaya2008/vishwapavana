[{"id": 2135320, "chapter_id": 3931, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2135321, "chapter_id": 3931, "verse_number": "१", "content_sanskrit": "वने निवसतां तेषां पाण्डवानां महात्मनाम् ।\nवर्षाण्येकादशातीयुः कृच्छ्रेण भरतर्षभ \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2135322, "chapter_id": 3931, "verse_number": "२", "content_sanskrit": "फलमूलाशनास्ते हि सुखार्हा दुःखमुत्तमम्।\nप्राप्तकालमनुध्यान्तः सेहिरे वरपूरुषाः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2135323, "chapter_id": 3931, "verse_number": "३", "content_sanskrit": "युधिष्ठिरस्तु राजर्षिरात्मकर्मापराधजम् ।\nचिन्तयन् स महाबाहुर्भ्रातॄणां दुःखमुत्तमम् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2135324, "chapter_id": 3931, "verse_number": "४", "content_sanskrit": "न सुष्वाप सुखं राजा हृदि शल्यैरिवार्पितैः ।\nदौरात्म्यमनुपश्यंस्तत्काले द्यूतोद्भवस्य हि \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2135325, "chapter_id": 3931, "verse_number": "५", "content_sanskrit": "संस्मरन् परुषा वाचः सूतपुत्रस्य पाण्डवः ।\nनिःश्वासपरमो दीनो बिभ्रत् कोपविषं महत् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2135326, "chapter_id": 3931, "verse_number": "६", "content_sanskrit": "अर्जुनो यमजौ चोभौ द्रौपदी च यशस्विनी ।\nस च भीमो महातेजाः सर्वेषामुत्तमो बली ।\nचिरस्य जातं धर्मज्ञं सासूयमिव ते तदा\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2135327, "chapter_id": 3931, "verse_number": "७", "content_sanskrit": "युधिष्ठिरमुदीक्षन्तः सेहुर्दुःखमनुत्तमम् ।\nअवशिष्टमल्पकालं मन्वानाः पुरुषर्षभाः ।\nवपुरन्यदिवाकार्षुरुत्साहामर्षचेष्टितैः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2135328, "chapter_id": 3931, "verse_number": "८", "content_sanskrit": "कस्यचित्त्वथ कालस्य व्यासः सत्यवतीसुतः ।\nआजगाम महायोगी पाण्डवानवलोककः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2135329, "chapter_id": 3931, "verse_number": "९", "content_sanskrit": "तमागतमभिप्रेक्ष्य कुन्तीपुत्रो युधिष्ठिरः ।\nप्रत्युद्गम्य महात्मानं प्रत्यगृह्णाद् यथाविधि \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2135330, "chapter_id": 3931, "verse_number": "१०", "content_sanskrit": "तमासीनमुपासीनः शुश्रूषुर्नियतेन्द्रियः ।\nतोषयन् प्रणिपातेन व्यासं पाण्डवनन्दनः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2135331, "chapter_id": 3931, "verse_number": "११", "content_sanskrit": "तानवेक्ष्य कृशान् पौत्रान् वने वन्येन जीवतः ।\nमहर्षिरनुकम्पार्थमब्रवीद् बाष्पगद्गदम् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2135332, "chapter_id": 3931, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि काम्यकप्रवेशे अष्टचत्वारिंशदधिकद्विशततमोऽध्यायः ॥२४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2135333, "chapter_id": 3931, "verse_number": "", "content_sanskrit": "व्रीहिद्रौणिकपर्वणि प्रथमोऽध्यायः ॥१॥\n* * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]