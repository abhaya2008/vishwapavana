[{"id": 6000294000, "chapter_id": 10294, "verse_number": null, "content_sanskrit": "अथ अष्टनवतितमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000294001, "chapter_id": 10294, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_098/BhP_10.098.001.m4a", "display_order": 2}, {"id": 6000294002, "chapter_id": 10294, "verse_number": "१०-९८-१", "content_sanskrit": "अष्टादशाक्षौहिणीनां तावद्भिर्मायया दिनैः।\nव्यापादनं येन कृतं तस्मै विश्वात्मने नमः॥ १०/९८/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_098/BhP_10.098.002.m4a", "display_order": 3, "topics": [{"text": "बलरामस्य तीर्थयात्रा", "range": "१–६"}]}, {"id": 6000294003, "chapter_id": 10294, "verse_number": "१०-९८-२", "content_sanskrit": "शृृण्वतो मे कथास्तस्य चरितानि च सङ्घशः।\nवैक्लव्यं विस्मयो भीतिर्वर्धते मे पुनःपुनः॥ १०/९८/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_098/BhP_10.098.003.m4a", "display_order": 4}, {"id": 6000294004, "chapter_id": 10294, "verse_number": "१०-९८-३", "content_sanskrit": "मन्ये प्रायेण पाप्मानं जीर्णं मम दुरत्ययम्।\nइन्द्रियाणि प्रबुद्धानि प्रसन्नं च मनो भृशम्॥ १०/९८/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_098/BhP_10.098.004.m4a", "display_order": 5}, {"id": 6000294005, "chapter_id": 10294, "verse_number": "१०-९८-४", "content_sanskrit": "क्षुत्तृष्णे च प्रशान्ते मे आत्मा चानन्दनिर्भरः।\nप्रसादात् तव धर्मज्ञ कृतार्थोऽहमिहाभवम्॥ १०/९८/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_098/BhP_10.098.005.m4a", "display_order": 6}, {"id": 6000294006, "chapter_id": 10294, "verse_number": "१०-९८-५", "content_sanskrit": "अपि च श्रोतुमिच्छामि किञ्चिदर्थं तपोधन।\nयुध्यतः सुहृदो दृष्ट्वा निवारितुमशक्नुवन्॥ १०/९८/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_098/BhP_10.098.006.m4a", "display_order": 7}, {"id": 6000294007, "chapter_id": 10294, "verse_number": "१०-९८-६", "content_sanskrit": "तीर्थं स्नातुं गतो रामः किं चकार तपोधन॥ १०/९८/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_098/BhP_10.098.007.m4a", "display_order": 8}, {"id": 6000294008, "chapter_id": 10294, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_098/BhP_10.098.008.m4a", "display_order": 9}, {"id": 6000294009, "chapter_id": 10294, "verse_number": "१०-९८-७", "content_sanskrit": "तीर्थाभिषेकव्याजेन मध्यस्थः प्रययौ किल।\nस्नात्वा प्रभासे सन्तर्प्य देवर्षिपितृमानवान्॥ १०/९८/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_098/BhP_10.098.009.m4a", "display_order": 10, "topics": [{"text": "नैमिशारण्ये तेन रोमहर्षणस्य वधः", "range": "७–१६"}]}, {"id": 6000294010, "chapter_id": 10294, "verse_number": "१०-९८-८", "content_sanskrit": "सरस्वतीं प्रतिस्रोतं ययौ ब्राह्मणसंवृतः।\nपृथूदकं बिन्दुसरस्‍त्रितकूपं सुदर्शनम्॥ १०/९८/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_098/BhP_10.098.010.m4a", "display_order": 11}, {"id": 6000294011, "chapter_id": 10294, "verse_number": "१०-९८-९", "content_sanskrit": "विशालं ब्रह्मतीर्थं च चक्रं प्राचीसरस्वतीम्।\nयमुनामनु यात्येष गङ्गामनु च भारत॥ १०/९८/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_098/BhP_10.098.011.m4a", "display_order": 12}, {"id": 6000294012, "chapter_id": 10294, "verse_number": "१०-९८-१०", "content_sanskrit": "जगाम नैमिषं यत्र ऋषयः सत्रमासते। तमागतमभिप्रेत्य मुनयो दीर्घसत्रिणः।\nअभिवन्द्य यथान्यायं प्रणम्योत्थाय चार्चयन्॥ १०/९८/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_098/BhP_10.098.012.m4a", "display_order": 13}, {"id": 6000294013, "chapter_id": 10294, "verse_number": "१०-९८-११", "content_sanskrit": "सोऽर्चितः सपरीवारः कृतासनपरिग्रहः।\nरोमहर्षणमासीनं शिष्यमैक्षन्महामुनेः॥ १०/९८/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_098/BhP_10.098.013.m4a", "display_order": 14}, {"id": 6000294014, "chapter_id": 10294, "verse_number": "१०-९८-१२", "content_sanskrit": "प्रत्यवस्थायिनं सूतमकृतप्रह्वणाञ्जलिम्।\nअध्यासीनं च तान् विप्रांश्चुकोपोद्वीक्ष्य माधवः॥ १०/९८/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_098/BhP_10.098.014.m4a", "display_order": 15}, {"id": 6000294015, "chapter_id": 10294, "verse_number": "१०-९८-१३", "content_sanskrit": "कस्मादसाविमान् विप्रानध्यास्ते प्रतिलोमजः।\nधर्मपालांस्तथैवास्मान् वधमर्हति दुर्मदः॥ १०/९८/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_098/BhP_10.098.015.m4a", "display_order": 16}, {"id": 6000294016, "chapter_id": 10294, "verse_number": "१०-९८-१४", "content_sanskrit": "ऋषेर्भगवतो भूत्वा शिष्योऽधीत्य बहूनि च।\nसेतिहासपुराणानि धर्मशास्‍त्राणि सर्वशः॥ १०/९८/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_098/BhP_10.098.016.m4a", "display_order": 17}, {"id": 6000294017, "chapter_id": 10294, "verse_number": "१०-९८-१५", "content_sanskrit": "अदान्तस्याविनीतस्य वृथा पण्डितमानिनः।\nन गुणाय भवन्त्यस्य नटस्येवाजितात्मनः॥ १०/९८/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_098/BhP_10.098.017.m4a", "display_order": 18}, {"id": 6000294018, "chapter_id": 10294, "verse_number": "१०-९८-१६", "content_sanskrit": "एतदर्थो हि लोकेऽस्मिन्नवतारो मया कृतः।\nवध्या मे धर्मध्वजिनस्ते हि पातकिनोऽधिकाः॥ १०/९८/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_098/BhP_10.098.018.m4a", "display_order": 19}, {"id": 6000294019, "chapter_id": 10294, "verse_number": "१०-९८-१७", "content_sanskrit": "एतावदुक्त्वा भगवान्निवृत्तोऽसद्वधादपि।\nभावित्वात् तं कुशाग्रेण करस्थेनाहनत् प्रभुः॥ १०/९८/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_098/BhP_10.098.019.m4a", "display_order": 20, "topics": [{"text": "प्रायश्चित्ततया बल्वलवधो वत्सरपर्यन्तं तीर्थयात्रा च", "range": "१७–२९"}]}, {"id": 6000294020, "chapter_id": 10294, "verse_number": "१०-९८-१८", "content_sanskrit": "हाहेति वादिनः सर्वे ऋषयः खिन्नमानसाः।\nऊचुः सङ्कर्षणं देवमधर्मस्ते कृतः प्रभो॥ १०/९८/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_098/BhP_10.098.020.m4a", "display_order": 21}, {"id": 6000294021, "chapter_id": 10294, "verse_number": "१०-९८-१९", "content_sanskrit": "अस्य ब्रह्मासनं दत्तमस्माभिर्यदुनन्दन।\nआयुश्चास्याक्षयं तावद् यावत् सत्रं समाप्यते॥ १०/९८/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_098/BhP_10.098.021.m4a", "display_order": 22}, {"id": 6000294022, "chapter_id": 10294, "verse_number": "१०-९८-२०", "content_sanskrit": "अजानतेवाचरितं त्वया ब्रह्मवधो यथा।\nयोगेश्वरस्य भवतो नाम्ना यो विनियामकः॥ १०/९८/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_098/BhP_10.098.022.m4a", "display_order": 23}, {"id": 6000294023, "chapter_id": 10294, "verse_number": "१०-९८-२१", "content_sanskrit": "यद्येतद् ब्रह्महत्याया पावनं लोकपावन।\nचरिष्यति भवान् लोकसङ्ग्रहं नान्यचोदितः॥ १०/९८/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_098/BhP_10.098.023.m4a", "display_order": 24}, {"id": 6000294024, "chapter_id": 10294, "verse_number": null, "content_sanskrit": "बलभद्र उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_098/BhP_10.098.024.m4a", "display_order": 25}, {"id": 6000294025, "chapter_id": 10294, "verse_number": "१०-९८-२२", "content_sanskrit": "चरिष्ये वधनिर्वेशं लोकानुग्रहकाम्यया।\nनियमः प्रथमे कल्पे यावान् स तु विधीयताम्॥ १०/९८/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_098/BhP_10.098.025.m4a", "display_order": 26}, {"id": 6000294026, "chapter_id": 10294, "verse_number": "१०-९८-२३", "content_sanskrit": "दीर्घमायुर्व्रतं तस्य सत्वमिन्द्रियमेव च।\nआशासितं यद्यदुत साधये योगमायया॥ १०/९८/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_098/BhP_10.098.026.m4a", "display_order": 27}, {"id": 6000294027, "chapter_id": 10294, "verse_number": null, "content_sanskrit": "ऋषय ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_098/BhP_10.098.027.m4a", "display_order": 28}, {"id": 6000294028, "chapter_id": 10294, "verse_number": "१०-९८-२४", "content_sanskrit": "अस्‍त्रस्य तव वीर्यस्य मृत्योरस्माकमेव च।\nयथा भवेद् वचः सत्यं तथा राम विधीयताम्॥ १०/९८/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_098/BhP_10.098.028.m4a", "display_order": 29}, {"id": 6000294029, "chapter_id": 10294, "verse_number": null, "content_sanskrit": "बलभद्र उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_098/BhP_10.098.029.m4a", "display_order": 30}, {"id": 6000294030, "chapter_id": 10294, "verse_number": "१०-९८-२५", "content_sanskrit": "आत्मा वै पुत्र उत्पन्न इति वेदानुशासनम्।\nतस्मादस्य भवेद् वक्ता आयुरिन्द्रियवीर्यवान्॥ १०/९८/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_098/BhP_10.098.030.m4a", "display_order": 31}, {"id": 6000294031, "chapter_id": 10294, "verse_number": "१०-९८-२६", "content_sanskrit": "किं वः कामो मुनिश्रेष्ठा ब्रूताहं करवाणि तत्।\nअजानतश्चापचितिं यथा मे बुध्यतां बुधाः॥ १०/९८/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_098/BhP_10.098.031.m4a", "display_order": 32}, {"id": 6000294032, "chapter_id": 10294, "verse_number": null, "content_sanskrit": "ऋषय उचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_098/BhP_10.098.032.m4a", "display_order": 33}, {"id": 6000294033, "chapter_id": 10294, "verse_number": "१०-९८-२७", "content_sanskrit": "इल्वलस्य सुतो घोरो वल्वलो नाम दानवः।\nस दूषयति नः सर्वान् सत्रमेत्य च पर्वणि॥ १०/९८/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_098/BhP_10.098.033.m4a", "display_order": 34}, {"id": 6000294034, "chapter_id": 10294, "verse_number": "१०-९८-२८", "content_sanskrit": "तं पापं जहि दाशार्ह तत्र शुश्रूषणं परम्।\nपूयशोणितविण्मूत्रसुरामांसाभिवर्षिणम्॥ १०/९८/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_098/BhP_10.098.034.m4a", "display_order": 35}, {"id": 6000294035, "chapter_id": 10294, "verse_number": "१०-९८-२९", "content_sanskrit": "ततश्च भारतं वर्षं परीत्य सुसमाहितः।\nचरित्वा द्वादशान् मासान् तीर्थस्नायी विशुध्यसे॥ १०/९८/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_098/BhP_10.098.035.m4a", "display_order": 36}, {"id": 6000294036, "chapter_id": 10294, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्ध उत्तरार्धेऽष्टनवतितमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]