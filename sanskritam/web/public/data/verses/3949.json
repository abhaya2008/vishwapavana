[{"id": 2135972, "chapter_id": 3949, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2135973, "chapter_id": 3949, "verse_number": "१", "content_sanskrit": "उक्तं भगवता जन्म रामादीनां पृथक्पृथक् ।\nप्रस्थानशमने ब्रह्मन् श्रोतुमिच्छामि कथ्यताम् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2135974, "chapter_id": 3949, "verse_number": "२", "content_sanskrit": "जन्मादि चरितं सर्वं विवाहादि मया श्रुतम् ।\nकथं दाशरथी वीरौ भ्रातरौ रामलक्ष्मणौ ।\nसम्प्रस्थितौ वने ब्रह्मन् मैथिली च यशस्विनी \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2135975, "chapter_id": 3949, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2135976, "chapter_id": 3949, "verse_number": "३", "content_sanskrit": "जातपुत्रो दशरथः प्रीतिमानभवन् नृप ।\nक्रियारतिर्धर्मरतः सततं वृद्धसेविता \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2135977, "chapter_id": 3949, "verse_number": "४", "content_sanskrit": "क्रमेण चास्य ते पुत्रा व्यवर्धन्त महौजसः ।\nवेदेषु सरहस्येषु धनुर्वेदेषु पारगाः ।\nचरितब्रह्मचर्यास्ते कृतदाराश्च पार्थिव \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2135978, "chapter_id": 3949, "verse_number": "५", "content_sanskrit": "यदा तदा दशरथः प्रीतिमानभवत् सुखी \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2135979, "chapter_id": 3949, "verse_number": "६", "content_sanskrit": "ज्येष्ठो रामोऽभवत् तेषां रमयामास हि प्रजाः ।\nमनोहरतया धीमान् पितुर्हृदयनन्दनः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2135980, "chapter_id": 3949, "verse_number": "७", "content_sanskrit": "ततः स राजा मतिमान् मत्वाऽऽत्मानं वयोऽधिकम् ।\nमन्त्रयामास सचिवैर्धर्मज्ञैश्च पुरोहितैः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2135981, "chapter_id": 3949, "verse_number": "८", "content_sanskrit": "अभिषेकाय रामस्य यौवराज्येन भारत ।\nप्राप्तकालं च ते सर्वे मेनिरे मन्त्रिसत्तमाः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2135982, "chapter_id": 3949, "verse_number": "९", "content_sanskrit": "लोहिताक्षं महाबाहुं मत्तमातङ्गगामिनम् ।\nकम्बुग्रीवं महोरस्कं नीलकुञ्चितमूर्धजम् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2135983, "chapter_id": 3949, "verse_number": "१०", "content_sanskrit": "दीप्यमानं श्रिया वीरं शक्रादनवरं रणे ।\nपारगं सर्वधर्माणां बृहस्पतिसमं मतौ \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2135984, "chapter_id": 3949, "verse_number": "११", "content_sanskrit": "सर्वानुरक्तप्रकृतिं सर्वविद्याविशारदम् ।\nजितेन्द्रियममित्राणामपि दृष्टिमनोहरम् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2135985, "chapter_id": 3949, "verse_number": "१२", "content_sanskrit": "नियन्तारमसाधूनां गोप्तारं धर्मचारिणाम् ।\nधृतिमन्तमनाधृष्यं जेतारमपराजितम् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2135986, "chapter_id": 3949, "verse_number": "१३", "content_sanskrit": "पुत्रं राजा दशरथः कौसल्यानन्दवर्धनम् ।\nसन्दृश्य परमां प्रीतिमगच्छत् कुरुनन्दन \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2135987, "chapter_id": 3949, "verse_number": "१४", "content_sanskrit": "चिन्तयंश्च महातेजा गुणान् रामस्य वीर्यवान् ।\nअभ्यभाषत भद्रं ते प्रीयमाणः पुरोहितम् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2135988, "chapter_id": 3949, "verse_number": "", "content_sanskrit": "दशरथः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2135989, "chapter_id": 3949, "verse_number": "१५", "content_sanskrit": "अद्य पुष्यो निशि ब्रह्मन् पुण्यं योगमुपैष्यति ।\nसम्भाराः सम्भ्रियन्तां वै(मे) रामश्चोपनिमन्त्र्यताम्॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2135990, "chapter_id": 3949, "verse_number": "१६", "content_sanskrit": "श्व एव पुष्यो भविता यत्र रामः सुतो मया ।\nयौवराज्येऽभिषेक्तव्यः पौरेषु सह मन्त्रिभिः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2135991, "chapter_id": 3949, "verse_number": "समाप्तिः", "content_sanskrit": "इति तद् राजवचनं प्रतिश्रुत्याथ मन्थरा ।\nकैकेयीमभिगम्येदं काले वचनमब्रवीत् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2135992, "chapter_id": 3949, "verse_number": "१८", "content_sanskrit": "अद्य कैकेयि दौर्भाग्यं राज्ञा ते ख्यापितं महत् ।\nआशीविष इव क्रुद्धश्छन्नो दशतु दुर्भगे \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2135993, "chapter_id": 3949, "verse_number": "१९", "content_sanskrit": "सुभगा खलु कौसल्या यस्याः पुत्रोऽभिषेक्ष्यते ।\nकुतो हि तव सौभाग्यं यस्याः पुत्रो न राज्यभाक् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2135994, "chapter_id": 3949, "verse_number": "२०", "content_sanskrit": "सा तद्वचनमाज्ञाय सर्वाभरणभूषिता ।\nदेवी विलग्नमध्येव बिभ्रती रूपमुत्तमम् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2135995, "chapter_id": 3949, "verse_number": "२१", "content_sanskrit": "विविक्ते पतिमासाद्य हसन्तीव शुचिस्मिता ।\nप्रणयं व्यञ्जयन्तीव मधुरं वाक्यमब्रवीत् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2135996, "chapter_id": 3949, "verse_number": "२२", "content_sanskrit": "सत्यप्रतिज्ञ यन्मे त्वं काममेकं निसृष्टवान् ।\nउपाकुरुष्व तद्राजंस्तस्मान्मुच्यस्व सङ्कटात् ।\nतदद्य कुरु सत्यं मे वरं वरद भूपते \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2135997, "chapter_id": 3949, "verse_number": "", "content_sanskrit": "दशरथः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2135998, "chapter_id": 3949, "verse_number": "२३", "content_sanskrit": "वरं ददानि ते हन्त तद् गृहाण यदिच्छसि ।\nअबध्यो बध्यतां कोऽद्य बध्यः कोऽद्य विमुच्यताम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2135999, "chapter_id": 3949, "verse_number": "२४", "content_sanskrit": "धनं ददानि कस्याद्य ह्रियतां कस्य वा पुनः।\nब्राह्मणस्वादिहान्यत्र यत् किञ्चिद् वित्तमस्ति मे \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2136000, "chapter_id": 3949, "verse_number": "२५", "content_sanskrit": "पृथिव्यां राजराजोऽस्मि चातुर्वर्ण्यस्य रक्षिता ।\nयस्तेऽभिलषितः कामो ब्रूहि कल्याणि माचिरम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2136001, "chapter_id": 3949, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2136002, "chapter_id": 3949, "verse_number": "२६", "content_sanskrit": "सा तद्वचनमाज्ञाय परिगृह्य नराधिपम् ।\nआत्मनो बलमाज्ञाय तत एनमुवाच ह \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2136003, "chapter_id": 3949, "verse_number": "", "content_sanskrit": "कैकेयी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2136004, "chapter_id": 3949, "verse_number": "२७", "content_sanskrit": "आभिषेचनिकं यत् ते रामार्थमुपकल्पितम् ।\nभरतस्तदवाप्नोतु वनं गच्छतु राघवः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2136005, "chapter_id": 3949, "verse_number": "२८", "content_sanskrit": "नवपञ्च च वर्षाणि दण्डकारण्यमाश्रितः ।\nचीराजिनजटाधारी रामो भवतु तापसः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2136006, "chapter_id": 3949, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2136007, "chapter_id": 3949, "verse_number": "२९", "content_sanskrit": "स तद्राजा वचः श्रुत्वा विप्रियं दारुणोदयम् ।\nदुःखार्तो भरतश्रेष्ठ न किञ्चिद् व्याजहार ह \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2136008, "chapter_id": 3949, "verse_number": "३०", "content_sanskrit": "ततस्तथोक्तं पितरं रामो विज्ञाय वीर्यवान् ।\nवनं प्रतस्थे धर्मात्मा राजा सत्यो भवत्विति \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2136009, "chapter_id": 3949, "verse_number": "३१", "content_sanskrit": "तमन्वगच्छल्लक्ष्मीवान् धनुष्माँल्लक्ष्मणस्तदा ।\nसीता च भार्या भद्रं ते वैदेही जनकात्मजा \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2136010, "chapter_id": 3949, "verse_number": "३२", "content_sanskrit": "ततो वनं गते रामे राजा दशरथस्तदा ।\nसमयुज्यत धर्मात्मा कालपर्यायधर्मणा \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2136011, "chapter_id": 3949, "verse_number": "३३", "content_sanskrit": "रामं तु गतमाज्ञाय राजानं च तथागतम् ।\nआनाय्य भरतं देवी कैकेयी वाक्यमब्रवीत् \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2136012, "chapter_id": 3949, "verse_number": "", "content_sanskrit": "कैकेयी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2136013, "chapter_id": 3949, "verse_number": "३४", "content_sanskrit": "गतो दशरथः स्वर्गं वनस्थौ रामलक्ष्मणौ ।\nगृहाण राज्यं विपुलं क्षेमं निहतकण्टकम् \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2136014, "chapter_id": 3949, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2136015, "chapter_id": 3949, "verse_number": "३५", "content_sanskrit": "तामुवाच स धर्मात्मा नृशंसं बत ते कृतम् ।\nपतिं हत्वा कुलं चेदमुत्साद्य धनलुब्धया \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2136016, "chapter_id": 3949, "verse_number": "३६", "content_sanskrit": "अयशः पातयित्वा मे मूर्ध्नि त्वं कुलपांसने ।\nसकामा भव मे मातरित्युक्त्वा प्ररुरोद ह \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2136017, "chapter_id": 3949, "verse_number": "३७", "content_sanskrit": "स चारित्रं विशोध्याथ सर्वप्रकृतिसंनिधौ ।\nअन्वयाद् भ्रातरं रामं विनिवर्तनलालसः \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2136018, "chapter_id": 3949, "verse_number": "३८", "content_sanskrit": "संस्कृत्य पितरं वृत्तं भरतो धर्मवत्सलः ।\nकौसल्यां च सुमित्रां च कैकेयीं च सुदुःखितः ।\nअग्रे प्रस्थाप्य यानैः स शत्रुघ्नसहितो ययौ \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2136019, "chapter_id": 3949, "verse_number": "३९", "content_sanskrit": "वसिष्ठवामदेवाभ्यां विप्रैश्चान्यैः सहस्रशः ।\nपौरजानपदैः सार्धं रामानयनकाङ्क्षया \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2136020, "chapter_id": 3949, "verse_number": "४०", "content_sanskrit": "ददर्श चित्रकूटस्थं स रामं सहलक्ष्मणम् ।\nतापसानामलङ्कारं धारयन्तं धनुर्धरम् \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2136021, "chapter_id": 3949, "verse_number": "४१", "content_sanskrit": "उवाच प्राञ्जलिर्भूत्वा प्रणिपत्य रघूत्तमम् ।\nशशंस मरणं राज्ञः सोऽनाथांश्चापि कोसलान् ।\nनाथ त्वं प्रतिपद्यस्व स्वराज्यमिति चोक्तवान्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2136022, "chapter_id": 3949, "verse_number": "४२", "content_sanskrit": "स तस्य वचनं श्रुत्वा रामः परमदुःखितः ।\nचकार देवकल्पस्य पितुः स्नात्वोदकक्रियाम्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2136023, "chapter_id": 3949, "verse_number": "४३", "content_sanskrit": "अब्रवीत् स तदा रामो भ्रातरं भ्रातृवत्सलः ।\nपादुके मे भविष्येते राज्यगोप्त्यौ परन्तप ।\nएवमस्त्विति तं प्राह भरतः प्रणतस्तदा\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2136024, "chapter_id": 3949, "verse_number": "", "content_sanskrit": "(स रामो भरतं दृष्ट्वा श्रुत्वा स्वर्गगतिं पितुः ।\nकृत्वा तस्योदकं सम्यगुवाच भ्रातरं प्रियम् ।\nगच्छ तात प्रजा रक्ष्याः सत्यं रक्षाम्यहं पितुः ॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2136025, "chapter_id": 3949, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2136026, "chapter_id": 3949, "verse_number": "४४", "content_sanskrit": "विसर्जितः स रामेण पितुर्वचनकारिणा ।\nनन्दिग्रामेऽकरोद्राज्यं पुरस्कृत्यास्य पादुके \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2136027, "chapter_id": 3949, "verse_number": "४५", "content_sanskrit": "रामस्तु पुनराशङ्क्य पौरजानपदागमम् ।\nप्रविवेश महारण्यं शरभङ्गाश्रमं प्रति \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2136028, "chapter_id": 3949, "verse_number": "४६", "content_sanskrit": "सत्कृत्य शरभङ्गं स दण्डकारण्यमाश्रितः ।\nनदीं गोदावरीं रम्यामाश्रित्य न्यवसत् तदा \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2136029, "chapter_id": 3949, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि रामोपाख्यानपर्वणि वानराद्युत्पत्तौ पञ्चषष्ट्यधिकद्विशततमोऽध्यायः ॥२६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2136030, "chapter_id": 3949, "verse_number": "", "content_sanskrit": "रामोपाख्यानपर्वणि पञ्चमोऽध्यायः ॥५॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]