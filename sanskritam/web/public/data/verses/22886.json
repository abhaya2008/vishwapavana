[{"id": 7002886000, "chapter_id": 22886, "verse_number": "९-१७१-१", "content_sanskrit": "श्रीकृष्ण उवाच ।\nदासीदानमहं तेऽद्य प्रवक्ष्याम्यरिसूदन ।\nभक्त्या स्नेहाच्च भवतो यत्रोक्तं केनचित्क्वचित् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002886001, "chapter_id": 22886, "verse_number": "९-१७१-२", "content_sanskrit": "चतुर्णामाश्रमाणां हि गृहस्थः श्रेष्ठ उच्यते ।\nगृहस्थाच्च गृहं श्रेष्ठं गृहाच्छ्रेष्ठा वराः स्त्रियः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002886002, "chapter_id": 22886, "verse_number": "९-१७१-३", "content_sanskrit": "पूर्णेंदुबिंबवदनाः पीनोन्नतपयोधराः ।\nतद्गृहं यत्र दृश्यंते योषितः शीलमंडनाः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002886003, "chapter_id": 22886, "verse_number": "९-१७१-४", "content_sanskrit": "जामयो यत्र पूज्यंते रमन्ते तत्र देवताः ।\nयत्रैतास्तु न पूज्यंते विनंक्ष्यत्याशु तद्गृहम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002886004, "chapter_id": 22886, "verse_number": "९-१७१-५", "content_sanskrit": "जामयो यानि गेहानि शपंत्यप्रतिपूजिताः ।\nतानि कृत्याहतानीव सद्यो यांति पराभवम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002886005, "chapter_id": 22886, "verse_number": "९-१७१-६", "content_sanskrit": "अमृतस्येव कुण्डानि सुखानामिव राशयः ।\nरतेरिव निधानानि योषितः केन निर्मिताः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002886006, "chapter_id": 22886, "verse_number": "९-१७१-७", "content_sanskrit": "श्यामा मंथरगामिन्यः पीनोन्नतपयोधराः ।\nमहिष्यो वरनार्यश्च न भवंति गृहेगृहे ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002886007, "chapter_id": 22886, "verse_number": "९-१७१-८", "content_sanskrit": "अहिरण्यमदासीकमल्पान्नाज्यमगोरसम् ।\nगृहं कृपणवृत्तीनां नरकस्यापरो विधिः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002886008, "chapter_id": 22886, "verse_number": "९-१७१-९", "content_sanskrit": "अदण्डपाशिकं ग्राममदासीकं च यद्गृहम् ।\nअनाज्यं भोजनं यच्च वृथा तदिति मे मतिः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002886009, "chapter_id": 22886, "verse_number": "९-१७१-१०", "content_sanskrit": "विभवाभरणा दास्यो यद्गृहं समुपासते ।\nतत्रास्ते पंकजकरा लक्ष्मीः क्षीरोदवासिनी ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002886010, "chapter_id": 22886, "verse_number": "९-१७१-११", "content_sanskrit": "न यत्रास्ति गृहे शौचं न सुखं व्यवहारजम् ।\nयत्र वा नास्ति दास्येका तत्सदैवानवस्थितम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002886011, "chapter_id": 22886, "verse_number": "९-१७१-१२", "content_sanskrit": "यत्र कर्मकरी नास्ति सर्वकर्मकरी सदा ।\nन तच्छतं किंकराणां करोति शुभतामपि ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002886012, "chapter_id": 22886, "verse_number": "९-१७१-१३", "content_sanskrit": "यदेका कुरुते दासी गृहस्थेन भृता हि सा ।\nबहुलोकाकुलो ग्रामो दासीदासाकुलं गृहम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002886013, "chapter_id": 22886, "verse_number": "९-१७१-१४", "content_sanskrit": "बुद्धिर्धर्माकुला यस्य तस्य चेतः किमाकुलम् ।\nयत्र भार्यागृहे दक्षा दास्यकर्मण्यनुव्रताः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002886014, "chapter_id": 22886, "verse_number": "९-१७१-१५", "content_sanskrit": "भृत्याः सदोद्यमपरास्त्रिवर्गस्तत्र दृश्यते ।\nयद्यदिष्टतमं लोके तत्तद्देयमिति श्रुतिः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002886015, "chapter_id": 22886, "verse_number": "९-१७१-१६", "content_sanskrit": "एतद्विचार्य हृदये देया दासी द्विजातये ।\nस्थिरनक्षत्रसंयुक्ते सोमे सौम्यग्रहान्विते ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002886016, "chapter_id": 22886, "verse_number": "९-१७१-१७", "content_sanskrit": "दानकालं प्रशंसंति संतः पर्वणि वा पुनः ।\nअलंकृत्य यथाशक्त्या वासोभिर्भूषणैस्तथा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002886017, "chapter_id": 22886, "verse_number": "९-१७१-१८", "content_sanskrit": "ब्राह्मणाय प्रदातव्या मंत्रेणानेन कौरव ।\nइयं दासी मया तुभ्यं भगवन्प्रतिपादिता ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002886018, "chapter_id": 22886, "verse_number": "९-१७१-१९", "content_sanskrit": "कर्मोपयोज्या भोज्या वा यथेष्टं भद्रमस्तु ते ।\nदत्त्वा क्षमापयेत्पश्चाद्ब्राह्मणं कांचनेन तम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002886019, "chapter_id": 22886, "verse_number": "९-१७१-२०", "content_sanskrit": "अनुव्रज्य गृहद्वारं यावत्पश्चाद्विसर्जयेत् ।\nअनेन विधिना दद्यादंकयित्वा सुरालये ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002886020, "chapter_id": 22886, "verse_number": "९-१७१-२१", "content_sanskrit": "मखे चापि महाराज प्रसिद्धे वा प्रतिश्रये ।\nसर्वकर्मकरी दत्त्वा तरुणीं रूपशालिनीम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002886021, "chapter_id": 22886, "verse_number": "९-१७१-२२", "content_sanskrit": "प्राप्यते यत्फलं पुंभिः पार्थ तत्केन वर्ण्यते ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002886022, "chapter_id": 22886, "verse_number": "९-१७१-२३", "content_sanskrit": "दासीं समीक्ष्य बहुशो गृहकर्मदक्षां यो ब्रह्मणाय कुलशीलवते ददाति ।\nविद्याधराधिपशतैरपि पूजितोऽसौ लोकं त्रिलोकरमयाप्सरसां प्रयाति ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]