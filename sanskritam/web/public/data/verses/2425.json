[{"id": 2067769, "chapter_id": 2425, "verse_number": "९-४३-०x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2067770, "chapter_id": 2425, "verse_number": "९-४३-१", "content_sanskrit": "वसिष्ठापवाहो ब्रह्मन्वै भीमवेगः कथं नु सः।\nकिमर्थं च सरिच्छ्रेष्ठा तमृषिं प्रत्यवाहयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2067771, "chapter_id": 2425, "verse_number": "९-४३-२", "content_sanskrit": "कथमस्याभवद्वैरं कारणं किं च तत्प्रभो।\nशंस पृष्टो महाप्राज्ञ न हि तृप्यामि कथ्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2067772, "chapter_id": 2425, "verse_number": "९-४३-३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2067773, "chapter_id": 2425, "verse_number": "९-४३-३", "content_sanskrit": "विश्वामित्रस्य विप्रर्षेर्वसिष्ठस्य च भारत।\nभृशं वैरमभूद्राजंस्तपःस्पर्धाकृतं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2067774, "chapter_id": 2425, "verse_number": "९-४३-४", "content_sanskrit": "आश्रमो वै वसिष्ठस्य स्थाणुतीर्थेऽभवन्महान्।\nपूर्वतः पार्श्वतश्चासीद्विश्वामित्रस्य धीमतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2067775, "chapter_id": 2425, "verse_number": "९-४३-५", "content_sanskrit": "यत्र स्थाणुर्महाराज तप्तवान्परमं तपः।\nतत्रास्य कर्म तद्धोरं प्रवदन्ति मनीषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2067776, "chapter_id": 2425, "verse_number": "९-४३-६", "content_sanskrit": "यत्रेष्ट्वा भगवान्स्थाणुः पूजयित्वा सरस्वतीम्।\nस्थापयामास तत्तीर्थं स्थाणुतीर्थमिति प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2067777, "chapter_id": 2425, "verse_number": "९-४३-७", "content_sanskrit": "तत्र तीर्थे सुराः स्कन्दमभ्यषिञ्चन्नराधिप।\nसैनापत्येन महता सुरारिविनिबर्हणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2067778, "chapter_id": 2425, "verse_number": "९-४३-८", "content_sanskrit": "तस्मिन्सारस्वते तीर्थे विश्वामित्रो महामुनिः।\nवसिष्ठं चालयामास तपसोग्रेण तच्छृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2067779, "chapter_id": 2425, "verse_number": "९-४३-९", "content_sanskrit": "विश्वामित्रवसिष्ठौ तावहन्यहनि भारत।\nस्पर्धां तपः कृतां तीव्रां चक्रतुस्तौ वतपोधनौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2067780, "chapter_id": 2425, "verse_number": "९-४३-१०", "content_sanskrit": "तत्राप्यधिकसन्तप्तो विश्वामित्रो महामुनिः।\nदृष्ट्वा तेजो वसिष्ठस्य चिन्तामभिजगाम ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2067781, "chapter_id": 2425, "verse_number": "९-४३-११", "content_sanskrit": "तस्य बुद्धिरियं ह्यासीद्धर्मनित्यस्य भारत।\nइदं सरस्वती तूर्णं मत्समीपं तपोधनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2067782, "chapter_id": 2425, "verse_number": "९-४३-१२", "content_sanskrit": "आनयिष्यति वेगेन वसिष्ठं जपतां वरम्।\nइहागतं द्विजश्रेष्ठं हनिष्यामि न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2067783, "chapter_id": 2425, "verse_number": "९-४३-१३", "content_sanskrit": "एवं निश्चित्य भगवान्विश्वामित्रो महामुनिः।\nसस्मार सरितां श्रेष्ठां क्रोधसंरक्तलोचनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2067784, "chapter_id": 2425, "verse_number": "९-४३-१४", "content_sanskrit": "सा ध्याता मुनिना तेन व्याकुलत्वं जगाम ह।\nगत्वा चैनं महावीर्यं महाकोपं च भामिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2067785, "chapter_id": 2425, "verse_number": "९-४३-१५", "content_sanskrit": "तदा तं वेपमानाङ्गी विवर्णा प्राञ्जलिर्भृशम्।\nउपतस्थे मुनिवरं विश्वामित्रं सरस्वती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2067786, "chapter_id": 2425, "verse_number": "९-४३-१६", "content_sanskrit": "हतवीरा यथा नारी साऽभवद्दुःखिता भृशम्।\nब्रूहि किं करवाणीति प्रोवाच मुनिसत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2067787, "chapter_id": 2425, "verse_number": "९-४३-१७", "content_sanskrit": "तामुवाच मुनिः क्रुद्धो वसिष्ठं शीघ्रमानय।\nयावदेनं निहन्म्यद्य तच्छ्रुत्वा व्यथिता नदी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2067788, "chapter_id": 2425, "verse_number": "९-४३-१८", "content_sanskrit": "साञ्जलिं तु ततः कृत्वा पुण्डरीकनिभेक्षणा।\nप्राकम्पत भृशं भीता वायुनेवाहता लता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2067789, "chapter_id": 2425, "verse_number": "९-४३-१९", "content_sanskrit": "तथारूपां तु तां दृष्ट्वा मुनिराह महानदीम्।\nअविचारं वसिष्ठं त्वमानयस्त्वान्तिकं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2067790, "chapter_id": 2425, "verse_number": "९-४३-२०", "content_sanskrit": "सा तस्य वचनं श्रुत्वा ज्ञात्वा पापं चिकीर्षितम्।\nवसिष्ठस्य प्रभावं च जानन्त्यप्रतिमं भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2067791, "chapter_id": 2425, "verse_number": "९-४३-२१", "content_sanskrit": "साऽभिगम्य वसिष्ठं च इदमर्थमचोदयत्।\nयदुक्ता सरितांश्रेष्ठा विश्वामित्रेण धीमता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2067792, "chapter_id": 2425, "verse_number": "९-४३-२२", "content_sanskrit": "उभयोः शापयोर्भीता वेपमाना पुनःपुनः।\nचिन्तयित्वा महाशापमृषिविप्रासिता भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2067793, "chapter_id": 2425, "verse_number": "९-४३-२३", "content_sanskrit": "तां कृशां च विवर्णां च दृष्ट्वा चिन्तासमन्विताम्।\nउवाच राजन्धर्मात्मा वसिष्ठो द्विपदां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2067794, "chapter_id": 2425, "verse_number": "९-४३-२४", "content_sanskrit": "पाह्यात्मानं सरिच्छेष्ठे वह मां शीघ्रगामिनी।\nविश्वामित्रः शपेद्वि त्वां मा कृथास्त्वं विचारणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2067795, "chapter_id": 2425, "verse_number": "९-४३-२५", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा कृपाशीलस्य सा सरित्।\nचिन्तयामास कौरव्य किं कृत्वा सुकृतं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2067796, "chapter_id": 2425, "verse_number": "९-४३-२६", "content_sanskrit": "तस्याश्चिन्ता समुत्पन्ना वसिष्ठो मय्यतीव हि।\nकृतवान्हि दयां नित्यं तस्या कार्यं हितं मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2067797, "chapter_id": 2425, "verse_number": "९-४३-२७", "content_sanskrit": "अथ कूले स्वके राजञ्जपन्तमृषिसत्तमम्।\nजुह्वानं कौशिकं प्रेक्ष्य सरस्वत्यभ्यचिन्तयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2067798, "chapter_id": 2425, "verse_number": "९-४३-२८", "content_sanskrit": "इदमन्तरमित्येवं ततः सा सरितां वरा।\nकूलापहारमकरोत्स्वेन वेगेन सा सरित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2067799, "chapter_id": 2425, "verse_number": "९-४३-२९", "content_sanskrit": "तेन कूलापहारेण मैत्रावरुणिरौह्यत।\nउह्यमानः स तुष्टाव तदा राजन्सरस्वतीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2067800, "chapter_id": 2425, "verse_number": "९-४३-३०", "content_sanskrit": "पितामहस्य सरसः प्रवृत्ताऽसि सरस्वति।\nव्याप्तं चेदं जगत्सर्वं तवैवाम्भोभिरुत्तमैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2067801, "chapter_id": 2425, "verse_number": "९-४३-३१", "content_sanskrit": "त्वमेवाकाशगा देवि मेघेषु सृजसे पयः।\nसर्वाश्चापस्त्वमेवेति यथा वयमधीमहि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2067802, "chapter_id": 2425, "verse_number": "९-४३-३२", "content_sanskrit": "पुष्टिर्द्युतिस्तथा कीर्तिः सिद्धिर्बुद्धिरमा तथा।\nत्वमेव वाणी स्वाहा त्वं तवायत्तमिदं जगत्।\nत्वमेव सर्वभूतेषु वससीह चतुर्विधा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2067803, "chapter_id": 2425, "verse_number": "९-४३-३३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2067804, "chapter_id": 2425, "verse_number": "९-४३-३३", "content_sanskrit": "एवं सरस्वती राजन्स्तूयमाना महर्षिणा।\nवेगेनोवाह तं विप्रं विश्वामित्राश्रमं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2067805, "chapter_id": 2425, "verse_number": "९-४३-३४", "content_sanskrit": "न्यवेदयत चाक्षीक्ष्णं विश्वामित्राय तं मुनिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2067806, "chapter_id": 2425, "verse_number": "९-४३-३५", "content_sanskrit": "तमानीतं सरस्वत्या दृष्ट्वा कोपसमन्वितः।\nअथान्वेषत्प्रहरणं वसिष्ठान्तकरं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2067807, "chapter_id": 2425, "verse_number": "९-४३-३६", "content_sanskrit": "तं तु क्रुद्धमभिप्रेक्ष्य ब्रह्मवध्याभयान्नदी।\nअपोवाह वसिष्ठं तु प्राचीं दिशमतन्द्रिता।\nउभयोः कुर्वती वाक्यं वञ्चयित्वा च गाधिजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2067808, "chapter_id": 2425, "verse_number": "९-४३-३७", "content_sanskrit": "ततोपवाहितं दृष्ट्वा वसिष्ठमृषिसत्तमम्।\nअब्रवीत्त्वथ सङ्क्रुद्धो विश्वामित्रः सरस्वतीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2067809, "chapter_id": 2425, "verse_number": "९-४३-३८", "content_sanskrit": "यस्मान्मां त्वं सरिच्छ्रेष्ठे वञ्चयित्वा पुनर्गता।\nशोणितं वह कल्याणि राक्षसानां च सम्मतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2067810, "chapter_id": 2425, "verse_number": "९-४३-३९", "content_sanskrit": "ततः सरस्वती शप्ता विश्वामित्रेण धीमता।\nअवहच्छोणितोन्मिश्रं तोयं संवत्सरं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2067811, "chapter_id": 2425, "verse_number": "९-४३-४०", "content_sanskrit": "अथर्षयश्च देवाश्च गन्धर्वाप्सरसस्तदा।\nसरस्वतीं तथा दृष्ट्वा बभूवुर्भृशदुःखिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2067812, "chapter_id": 2425, "verse_number": "९-४३-४१", "content_sanskrit": "एवं वसिष्ठापवाहो लोके ख्यातो जनाधिप।\nआगच्छच्च पुनर्मार्गं स्वमेव सरितां वरा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2067813, "chapter_id": 2425, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शल्यपर्वणि ह्रदप्रवेशपर्वणि त्रिचत्वारिंशोऽध्यायः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]