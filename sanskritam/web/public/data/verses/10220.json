[{"id": 6000220000, "chapter_id": 10220, "verse_number": null, "content_sanskrit": "अथ चतुर्विंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000220001, "chapter_id": 10220, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_024/BhP_10.024.001.m4a", "display_order": 2}, {"id": 6000220002, "chapter_id": 10220, "verse_number": "१०-२४-१", "content_sanskrit": "एवंविधानि कर्माणि गोपाः कृष्णस्य वीक्ष्य ते।\nनतद्वीर्यविदः प्रोचुः समुपेत्य सुविस्मिताः॥ १०/२४/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_024/BhP_10.024.002.m4a", "display_order": 3, "topics": [{"text": "श्रीकृष्णस्याद्भुतं कर्म वीक्ष्य विस्मितैर्नन्दादिभिस्तत्सामर्थ्यानुवर्णनम्", "range": "१–२५"}]}, {"id": 6000220003, "chapter_id": 10220, "verse_number": "१०-२४-२", "content_sanskrit": "बालकस्य यदेतानि कर्माण्यत्यद्भुतानि वै।\nकथमर्हत्यसौ जन्म ग्राम्येष्वात्मजुगुप्सितम्॥ १०/२४/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_024/BhP_10.024.003.m4a", "display_order": 4}, {"id": 6000220004, "chapter_id": 10220, "verse_number": "१०-२४-३", "content_sanskrit": "यः सप्तहायनो बालः करेणैकेन लीलया।\nकथं बिभ्रद् गिरिवरं पुष्करं गजराडिव॥ १०/२४/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_024/BhP_10.024.004.m4a", "display_order": 5}, {"id": 6000220005, "chapter_id": 10220, "verse_number": "१०-२४-४", "content_sanskrit": "तोकेनामीलिताक्षेण पूतनाया महौजसः।\nपीतः स्तनः सह प्राणैः कालेनेव वयस्तनोः॥ १०/२४/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_024/BhP_10.024.005.m4a", "display_order": 6}, {"id": 6000220006, "chapter_id": 10220, "verse_number": "१०-२४-५", "content_sanskrit": "हिन्वतोऽधश्शयानस्य मास्यस्य चरणावुदक्।\nअनोऽपतद् विपर्यस्तं रुदतः प्रपदाहतम्॥ १०/२४/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_024/BhP_10.024.006.m4a", "display_order": 7}, {"id": 6000220007, "chapter_id": 10220, "verse_number": "१०-२४-६", "content_sanskrit": "एकहायन आसीनो ह्रियमाणो विहायसा।\nदैत्येन यस्तृणावर्तमहन् कण्ठग्रहातुरम्॥ १०/२४/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_024/BhP_10.024.007.m4a", "display_order": 8}, {"id": 6000220008, "chapter_id": 10220, "verse_number": "१०-२४-७", "content_sanskrit": "क्‍वचिद् हैयङ्गवस्तैन्ये मात्रा बद्ध उलूखले।\nगच्छन्नर्जुनयोर्मध्ये बाहुभ्यां तावपातयत्॥ १०/२४/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_024/BhP_10.024.008.m4a", "display_order": 9}, {"id": 6000220009, "chapter_id": 10220, "verse_number": "१०-२४-८", "content_sanskrit": "वने सञ्चारयन् वत्सान् सरामो बालकैर्वृतः।\nहन्तुकामं बकं दोर्भ्यां मुखतोऽरिमपाटयत्॥ १०/२४/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_024/BhP_10.024.009.m4a", "display_order": 10}, {"id": 6000220010, "chapter_id": 10220, "verse_number": "१०-२४-९", "content_sanskrit": "वत्सेषु वत्सरूपेण प्रविशन्तं जिघांसया।\nहत्वा न्यपातयत् तेन कपित्थानि च लीलया॥ १०/२४/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_024/BhP_10.024.010.m4a", "display_order": 11}, {"id": 6000220011, "chapter_id": 10220, "verse_number": "१०-२४-१०", "content_sanskrit": "हत्वा रासभदैतेयं तद्बन्धूंश्च बलान्वितः।\nचक्रे तालवनं क्षेमं परिपक्‍वफलोचितम्॥ १०/२४/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_024/BhP_10.024.011.m4a", "display_order": 12}, {"id": 6000220012, "chapter_id": 10220, "verse_number": "१०-२४-११", "content_sanskrit": "प्रलम्बं घातयित्वोग्रं बलेन बलशालिना।\nअमोचयद् व्रजपशून् गोपांश्चारण्यवह्नितः॥ १०/२४/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_024/BhP_10.024.012.m4a", "display_order": 13}, {"id": 6000220013, "chapter_id": 10220, "verse_number": "१०-२४-१२", "content_sanskrit": "आशीविषं महारौद्रं दमित्वा विमदं ह्रदात्।\nप्रसह्योद्वास्य यमुनां चक्रेऽसौ निर्विषोदकाम्॥ १०/२४/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_024/BhP_10.024.013.m4a", "display_order": 14}, {"id": 6000220014, "chapter_id": 10220, "verse_number": "१०-२४-१३", "content_sanskrit": "दुस्त्यजश्चानुरागोऽस्मिन् सर्वेषां नो व्रजौकसाम्।\nनन्द ते तनयेऽस्मासु तस्याप्यौत्पत्तिकः कथम्॥ १०/२४/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_024/BhP_10.024.014.m4a", "display_order": 15}, {"id": 6000220015, "chapter_id": 10220, "verse_number": "१०-२४-१४", "content_sanskrit": "क्‍व सप्तहायनो बालः क्‍व महाद्रिविधारणम्।\nततो नो जायते शङ्का व्रजनाथ तवात्मजे॥ १०/२४/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_024/BhP_10.024.015.m4a", "display_order": 16}, {"id": 6000220016, "chapter_id": 10220, "verse_number": null, "content_sanskrit": "नन्द उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_024/BhP_10.024.016.m4a", "display_order": 17}, {"id": 6000220017, "chapter_id": 10220, "verse_number": "१०-२४-१५", "content_sanskrit": "श्रूयतां मे वचो गोपा व्येतु शङ्का च वोऽर्भके।\nएनं कुमारमुद्दिश्य गर्गो मे यदुवाच ह॥ १०/२४/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_024/BhP_10.024.017.m4a", "display_order": 18}, {"id": 6000220018, "chapter_id": 10220, "verse_number": "१०-२४-१६", "content_sanskrit": "वर्णास्‍त्रयः किलास्यासन् गृह्णतोऽनुयुगं तनूः।\nशुक्लो रक्तस्तथा पीत इदानीं कृष्णतां गतः॥ १०/२४/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_024/BhP_10.024.018.m4a", "display_order": 19}, {"id": 6000220019, "chapter_id": 10220, "verse_number": "१०-२४-१७", "content_sanskrit": "प्रागयं वसुदेवस्य क्‍वचिज्जातस्तवात्मजः।\nवासुदेव इति श्रीमानभिज्ञाः सम्प्रचक्षते॥ १०/२४/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_024/BhP_10.024.019.m4a", "display_order": 20}, {"id": 6000220020, "chapter_id": 10220, "verse_number": "१०-२४-१८", "content_sanskrit": "बहूनि सन्ति नामानि रूपाणि च सुतस्य ते।\nगुणकर्मानुरूपाणि तान्यहं वेद नो जनाः॥ १०/२४/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_024/BhP_10.024.020.m4a", "display_order": 21}, {"id": 6000220021, "chapter_id": 10220, "verse_number": "१०-२४-१९", "content_sanskrit": "एष वः श्रेय आधास्यद् गोपगोकुलनन्दनः।\nअनेन सर्वदुर्गाणि यूयमञ्जस्तरिष्यथ॥ १०/२४/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_024/BhP_10.024.021.m4a", "display_order": 22}, {"id": 6000220022, "chapter_id": 10220, "verse_number": "१०-२४-२०", "content_sanskrit": "पुराऽनेन व्रजपते साधवो दस्युपीडिताः।\nअराजकेऽरक्ष्यमाणा जिग्युर्दस्यून् समेधिताः॥ १०/२४/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_024/BhP_10.024.022.m4a", "display_order": 23}, {"id": 6000220023, "chapter_id": 10220, "verse_number": "१०-२४-२१", "content_sanskrit": "य एतस्मिन्महाभागाः प्रीतिं कुर्वन्ति मानवाः।\nनारयोऽभिभवन्त्येतान् विष्णुपक्षानिवासुराः॥ १०/२४/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_024/BhP_10.024.023.m4a", "display_order": 24}, {"id": 6000220024, "chapter_id": 10220, "verse_number": "१०-२४-२२", "content_sanskrit": "तस्मान्नन्दकुमारोऽयं नारायणसमो गुणैः।\nश्रिया कीर्त्याऽनुभावेन तत्कर्मसु न विस्मयः॥ १०/२४/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_024/BhP_10.024.024.m4a", "display_order": 25}, {"id": 6000220025, "chapter_id": 10220, "verse_number": "१०-२४-२३", "content_sanskrit": "इत्यद्धा मां समादिश्य गर्गे च स्वगृहं गते।\nमन्ये नारायणस्यांशं कृष्णमक्लिष्टकारिणम्॥ १०/२४/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_024/BhP_10.024.025.m4a", "display_order": 26}, {"id": 6000220026, "chapter_id": 10220, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_024/BhP_10.024.026.m4a", "display_order": 27}, {"id": 6000220027, "chapter_id": 10220, "verse_number": "१०-२४-२४", "content_sanskrit": "इति नन्दवचः श्रुत्वा गर्गगीतं व्रजौकसः। दृष्टश्रुतानुभावास्ते कृष्णस्यामिततेजसः।\nमुदिता नन्दमानर्चुः कृष्णं च गतविस्मयाः॥ १०/२४/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_024/BhP_10.024.027.m4a", "display_order": 28}, {"id": 6000220028, "chapter_id": 10220, "verse_number": "१०-२४-२५", "content_sanskrit": "देवे वर्षति यज्ञविप्लवरुषा वज्राश्मवर्षानिलैः\nसीदद्बालपशु स्‍त्रियाऽऽत्मशरणं दृष्ट्वाऽनुकम्प्युत्स्मयः।\nउत्कृत्यैककरेण शैलमबलो लीलोच्छिलीन्ध्रं यथा\nबिभ्रद् गोष्ठमपान्महेन्द्रमदभित् प्रीयान्न इन्द्रो गवाम्॥ १०/२४/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_024/BhP_10.024.028.m4a", "display_order": 29}, {"id": 6000220029, "chapter_id": 10220, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्धपूर्वार्धे चतुर्विंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]