[{"id": 7001707000, "chapter_id": 21707, "verse_number": "१-९३-१", "content_sanskrit": "ब्रह्मोवाच ।\nश्रृणु पुत्र प्रवक्ष्यामि पुराणं पद्मसंज्ञकम् ।\nमहत्पुण्यप्रदं नॄणां श्रृण्वतां पठतां मुदा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001707001, "chapter_id": 21707, "verse_number": "१-९३-२", "content_sanskrit": "यथा चंचेंद्रियः सर्वः शरीरीति निगद्यते ।\nतथेदं पंचभिः खंडैरुदितं पापनाशनम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001707002, "chapter_id": 21707, "verse_number": "१-९३-३", "content_sanskrit": "पुलस्त्येन तु भीष्माय सृष्ट्यादिक्रमतो द्विज ।\nनानाख्यानेतिहासाद्यैर्यत्रोक्तो धर्मविस्तरः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001707003, "chapter_id": 21707, "verse_number": "१-९३-४", "content_sanskrit": "पुष्करस्य च माहात्म्यं विस्तरेण प्रकीर्तितम् ।\nब्रह्मयज्ञविधानं च वेदपाठादिलक्षणम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001707004, "chapter_id": 21707, "verse_number": "१-९३-५", "content_sanskrit": "दानानां कीर्तनं यत्र व्रतानां च पृथक्पृथक् ।\nविवाहः शैलजायाश्चतारकाख्यानकं महत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001707005, "chapter_id": 21707, "verse_number": "१-९३-६", "content_sanskrit": "माहात्म्यं च गवादीनां कीर्तितं सर्वपुण्यदम् ।\nकालकेयादिदैत्यानां वधो यत्र पृथक्पृथक् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001707006, "chapter_id": 21707, "verse_number": "१-९३-७", "content_sanskrit": "ग्रहाणामर्चनं दानं यत्र प्रोक्तं द्विजोत्तम ।\nतत्सृष्टिखंडमुद्दिष्टं व्यासेन सुमहात्मना ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001707007, "chapter_id": 21707, "verse_number": "१-९३-८", "content_sanskrit": "पितृमात्रादिपूज्यत्वे शिवशर्मकथा पुरा ।\nसुव्रतस्य कथा पश्चाद्वृत्रस्य च वधस्तथा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001707008, "chapter_id": 21707, "verse_number": "१-९३-९", "content_sanskrit": "पृथोर्वैनस्य चाख्यानं सुनूथायाः कथा तथा ।\nसुकलाख्यानकं चैव धर्माख्यानं ततः परम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001707009, "chapter_id": 21707, "verse_number": "१-९३-१०", "content_sanskrit": "पितृशुश्रूषणाख्यानं नहुषस्य कथा ततः ।\nययातिचरितं चैव गुरुतीर्थनिरूपणम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001707010, "chapter_id": 21707, "verse_number": "१-९३-११", "content_sanskrit": "राज्ञा जैमिनिसंवादो बह्वाश्चर्य्यकथायुतः ।\nकथा ह्यशोकसुंदर्याहुंडदैत्यवधान्विता ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001707011, "chapter_id": 21707, "verse_number": "१-९३-१२", "content_sanskrit": "कामोदाख्यानकं तत्र विहुंडवधसंयुतम् ।\nकुंजलस्य च संवादश्च्यवनेन महात्मना ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001707012, "chapter_id": 21707, "verse_number": "१-९३-१३", "content_sanskrit": "सिद्धाख्यानं ततः प्रोक्तं खंडस्यास्य फलोहनम् ।\nसूतशौनकसंवादं भूमिखंडमिदं स्मृतम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001707013, "chapter_id": 21707, "verse_number": "१-९३-१४", "content_sanskrit": "ब्रह्माण्डोत्पत्तिरुदिता यत्रर्षिभिश्च सौतिना ।\nसभूमिलोकसंस्थानं तीर्थाख्यानं ततः परम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001707014, "chapter_id": 21707, "verse_number": "१-९३-१५", "content_sanskrit": "नर्मदोत्पत्तिकथनं तत्तीर्थानां कथाः पृथक् ।\nकुरुक्षेत्रादितीर्थानां कथा पुण्या प्रकीर्तिता ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001707015, "chapter_id": 21707, "verse_number": "१-९३-१६", "content_sanskrit": "कालिंदीपुण्यकथनं काशीमाहात्म्यवर्णनम् ।\nगयायाश्चैव माहात्म्यं प्रयागस्य च पुण्यकम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001707016, "chapter_id": 21707, "verse_number": "१-९३-१७", "content_sanskrit": "वर्णाश्रमानुरोधेन कर्मयोगनिरूपणम् ।\nव्यासजमिनिसंवादः पुण्यकर्मकथान्वितः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001707017, "chapter_id": 21707, "verse_number": "१-९३-१८", "content_sanskrit": "समुद्रमथनाख्यानं व्रताख्यानं ततः परम् ।\nऊर्ज्जपंचाहमाहाम्यं स्तोत्रं सर्वापराधनुत् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001707018, "chapter_id": 21707, "verse_number": "१-९३-१९", "content_sanskrit": "एतत्स्वर्गाभिधं विप्र सर्वपातकनाशनम् ।\nरामाश्वमेधं प्रथमं रामराज्याभिषेचनम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001707019, "chapter_id": 21707, "verse_number": "१-९३-२०", "content_sanskrit": "अगस्त्याद्यागमश्चैव पौलस्त्यान्वयकीर्त्तनम् ।\nअश्वमेधोपदेशश्च हयचर्या ततः परम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001707020, "chapter_id": 21707, "verse_number": "१-९३-२१", "content_sanskrit": "नानाराजकथाः पुण्या जगन्नाथानुवर्णनम् ।\nवृन्दावनस्य माहात्म्यं सर्वपापप्रणाशनम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001707021, "chapter_id": 21707, "verse_number": "१-९३-२२", "content_sanskrit": "नित्यलीलानुकथनं यत्र कृष्णावतारिणः ।\nमाधवस्नानमाहात्म्यं स्नानदानार्चने फलम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001707022, "chapter_id": 21707, "verse_number": "१-९३-२३", "content_sanskrit": "धरावराहसंवादो यमब्रह्मणयोः कथा ।\nसंवादो राजदूतानां कृष्णस्तोत्रनिरूपणम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001707023, "chapter_id": 21707, "verse_number": "१-९३-२४", "content_sanskrit": "शिवशंभुसमायोगी दधीचाख्यानकं ततः ।\nभस्ममाहात्म्यमतुलं शिवमाहात्म्यमुत्तमम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001707024, "chapter_id": 21707, "verse_number": "१-९३-२५", "content_sanskrit": "देवरातसुताख्यानं पुराणज्ञप्रशंसनम् ।\nगौतमाख्यानकं चैव शिवगीता ततः स्मृता ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001707025, "chapter_id": 21707, "verse_number": "१-९३-२६", "content_sanskrit": "कल्पांतरे रामकथा भारद्वाजाश्रमस्थिता ।\nपातालखंडमेतद्धि श्रृण्वतां पठतां सदा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001707026, "chapter_id": 21707, "verse_number": "१-९३-२७", "content_sanskrit": "सर्वपापप्रशमनं सर्वाभीष्टफलप्रदम् ।\nपर्वताख्यानकं पूर्वं गौर्थै प्रोक्तं शिवेन वै ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001707027, "chapter_id": 21707, "verse_number": "१-९३-२८", "content_sanskrit": "जालंधरकथा पश्चाच्छ्रीशैलाद्यनुकीर्तनम् ।\nसगरस्य कथा पुण्या ततः परमुदीरितम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001707028, "chapter_id": 21707, "verse_number": "१-९३-२९", "content_sanskrit": "गंगाप्रयागकाशीनां गयायाश्चाधिपुण्यकम् ।\nअन्नादि दानमाहात्म्यं तन्महाद्वादशीव्रतम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001707029, "chapter_id": 21707, "verse_number": "१-९३-३०", "content_sanskrit": "चतुर्विंशैकादशीनां माहात्म्यं पृथगीरितम् ।\nविष्णुधर्मसमाख्यानं विष्णुनामसहस्रकम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001707030, "chapter_id": 21707, "verse_number": "१-९३-३१", "content_sanskrit": "कार्तिकव्रतमाहात्म्यं माघस्नानफलं ततः ।\nजम्बृद्वीपस्य तीर्थानां माहात्म्यं पापनाशनम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001707031, "chapter_id": 21707, "verse_number": "१-९३-३२", "content_sanskrit": "साभ्रमत्याश्च माहात्म्यं नृसिंहोत्पत्तिवर्णनम् ।\nदेवशर्मादिकाख्यानं गीतामाहात्म्यवर्णनम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001707032, "chapter_id": 21707, "verse_number": "१-९३-३३", "content_sanskrit": "भक्त्याख्यानं च माहात्म्यं श्रीमद्भागवतस्य ह ।\nइन्द्रप्रस्थस्य माहात्म्यं बहुतीर्थकथान्वितम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001707033, "chapter_id": 21707, "verse_number": "१-९३-३४", "content_sanskrit": "मन्त्ररत्नाभिधानं च त्रिपाद्भूत्यनुवर्णनम् ।\nअवतारकथाः पुण्या मत्स्यादीनामतः परम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001707034, "chapter_id": 21707, "verse_number": "१-९३-३५", "content_sanskrit": "रामनामशतं दिव्यं तन्माहात्म्यं च वाडव ।\nपरीक्षणं च भृगुणा श्रीविष्णोर्वैभवस्य च ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001707035, "chapter_id": 21707, "verse_number": "१-९३-३६", "content_sanskrit": "इत्येतदुत्तरं खण्डं पंचमं सर्वपुण्यदम् ।\nपंचखंडयुतं पाद्मं यः श्रृणोति नरोत्तमः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001707036, "chapter_id": 21707, "verse_number": "१-९३-३७", "content_sanskrit": "स लभेद्वैष्णवं धाम भुक्त्वा भोगानिहेप्सितान् ।\nएतद्वै पंचपंचाशत्सहस्रं पद्मसंज्ञकम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001707037, "chapter_id": 21707, "verse_number": "१-९३-३८", "content_sanskrit": "पुराणं लेखयित्वा वै ज्येष्ठ्यां स्वर्णाब्जसंयुतम् ।\nयः प्रदद्यात्सुसत्कृत्य पुराणज्ञाय मानद ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001707038, "chapter_id": 21707, "verse_number": "१-९३-३९", "content_sanskrit": "स याति वैष्णवं धाम सर्वदेवनमस्कृतः ।\nपद्मानुक्रमणीमेतां यः पठेच्छृणुयात्तथा ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001707039, "chapter_id": 21707, "verse_number": "१-९३-४०", "content_sanskrit": "सोऽपि पद्मपुराणस्य लभेच्छ्रवणजं फलम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]