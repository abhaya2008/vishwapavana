[{"id": 2005277, "chapter_id": 1104, "verse_number": "१-१०५-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2005278, "chapter_id": 1104, "verse_number": "१-१०५-१", "content_sanskrit": "संवत्सरानृतून्मासान्बुबुधे न बहून्गतान्।\nरममाणस्तया सार्धं यथाकामं नरेश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2005279, "chapter_id": 1104, "verse_number": "१-१०५-२", "content_sanskrit": "दिविष्ठान्मानुषांश्चैव भोगान्भुङ्क्ते स वै नृपः।\nआसाद्य शान्तनुः श्रीमान्मुमुदे योषितां वराम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2005280, "chapter_id": 1104, "verse_number": "१-१०५-३", "content_sanskrit": "ऋतुकाले तु सा देवी दिव्यं गर्भमधारयत्।\nअष्टावजनयत्पुत्रांस्तस्मादमरसन्निभान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2005281, "chapter_id": 1104, "verse_number": "१-१०५-४", "content_sanskrit": "जातं जातं च सा पुत्रं क्षिपत्यम्यसि भारत।\nसूतके कण्ठमाक्रम्य तान्निनाय यमक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2005282, "chapter_id": 1104, "verse_number": "१-१०५-५", "content_sanskrit": "प्रीणाम्यहं त्वामित्युक्त्वा गङ्गास्रोतस्यमज्जयत्।\nतस्य तन्न प्रियं राज्ञः शान्तनोरभवत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2005283, "chapter_id": 1104, "verse_number": "१-१०५-६", "content_sanskrit": "न च तां किंचनोवाच त्यागाद्भीतो महीपतिः।\nअमीमांस्या कर्मयोनिरागमश्चेति शान्तनुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2005284, "chapter_id": 1104, "verse_number": "१-१०५-७", "content_sanskrit": "स्मरन्पितृवचश्चैव नापृच्छत्पुत्रकिल्बिषम्।\nजाताञ्जातांश्च वै हन्ति सा स्त्री सप्त वरान्सुतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2005285, "chapter_id": 1104, "verse_number": "१-१०५-८", "content_sanskrit": "शान्तनुर्धर्मभङ्गाच्च नापृच्छत्तां कथंचन।\nअष्टमं तु जिघांसन्त्यां चुक्षुभे शान्तनोर्धृतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2005286, "chapter_id": 1104, "verse_number": "१-१०५-९", "content_sanskrit": "अथैनामष्टमे पुत्रे जाते प्रहसतीमिव।\nउवाच राजा दुःखार्तः परीप्सन्पुत्रमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2005287, "chapter_id": 1104, "verse_number": "१-१०५-१०", "content_sanskrit": "आलभन्तीं तदा दृष्ट्वा तां स कौरवनन्दनः।\nअब्रवीद्भरतश्रेष्ठो वाक्यं परमदुःखितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2005288, "chapter_id": 1104, "verse_number": "१-१०५-११", "content_sanskrit": "मावधीः कस्य काऽसीति किं हिनत्सि सुतानिति।\nपुत्रघ्नि सुमहत्पापं संप्राप्तं ते सुगर्हितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2005289, "chapter_id": 1104, "verse_number": "१-१०५-१२x", "content_sanskrit": "गङ्गोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2005290, "chapter_id": 1104, "verse_number": "१-१०५-१२", "content_sanskrit": "पुत्रकाम न ते हन्मि पुत्रं पुत्रवतां वर।\nजीर्णस्तु मम वासोऽयं यथा स समयः कृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2005291, "chapter_id": 1104, "verse_number": "१-१०५-१३", "content_sanskrit": "अहं गङ्गा जह्नुसुता महर्षिगणसेविता।\nदेवकार्यार्थसिद्ध्यर्थमुषिताऽहं त्वया सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2005292, "chapter_id": 1104, "verse_number": "१-१०५-१४", "content_sanskrit": "इमेऽष्टौ वसवो देवा महाभागा महौजसः।\nवसिष्ठशापदोषेण मानुषत्वमुपागताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2005293, "chapter_id": 1104, "verse_number": "१-१०५-१५", "content_sanskrit": "तेषां जनयिता नान्यस्त्वदृते भुवि विद्यते।\nमद्विधा मानुषी धात्री लोके नास्तीह काचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2005294, "chapter_id": 1104, "verse_number": "१-१०५-१६", "content_sanskrit": "तस्मात्तज्जननीहेतोर्मानुषत्वमुपागता।\nजनयित्वा वसूनष्टौ जिता लोकास्त्वयाऽक्षयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2005295, "chapter_id": 1104, "verse_number": "१-१०५-१७", "content_sanskrit": "देवानां समयस्त्वेष वसूनां संश्रुतो मया।\nजातं जातं मोक्षयिष्ये जन्मतो मानुषादिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2005296, "chapter_id": 1104, "verse_number": "१-१०५-१८", "content_sanskrit": "तत्ते शापाद्विनिर्मुक्ता आपवस्य महात्मनः।\nस्वस्ति तेस्तु गमिष्यामि पुत्रं पाहि महाव्रतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2005297, "chapter_id": 1104, "verse_number": "१-१०५-१९", "content_sanskrit": "अयं तव सुतस्तेषां वीर्येण कुलनन्दनः।\nसंभूतोतिजनं कर्म करिष्यति न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2005298, "chapter_id": 1104, "verse_number": "१-१०५-२०", "content_sanskrit": "एष पर्यायवासो मे वसूनां सन्निधौ कृतः।\nमत्प्रसूतिं विजानीहि गङ्गादत्तमिमं सुतम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2005299, "chapter_id": 1104, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि पञ्चाधिकशततमोऽध्यायः॥ १०५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]