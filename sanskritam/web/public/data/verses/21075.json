[{"id": 7001075000, "chapter_id": 21075, "verse_number": "१-११-१", "content_sanskrit": "ऋषय ऊचुः ।\nकथं लिंगं प्रतिष्ठाप्यं कथं वातस्य लक्षणम् ।\nकथं वा तत्समभ्यर्च्यं देशे काले च केन हि॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001075001, "chapter_id": 21075, "verse_number": "१-११-२", "content_sanskrit": "सूत उवाच ।\nयुष्मदर्थं प्रवक्ष्यामि बुद्ध्यतामवधानतः ।\nअनुकूले शुभे काले पुण्ये तीर्थे तटे तथा॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001075002, "chapter_id": 21075, "verse_number": "१-११-३", "content_sanskrit": "यथेष्टं लिंगमारोप्यं यत्र स्यान्नित्यमर्चनम् ।\nपार्थिवेन तथाप्येनं तैजसेन यथारुचि॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001075003, "chapter_id": 21075, "verse_number": "१-११-४", "content_sanskrit": "कल्पलक्षणसंयुक्तं लिंगं पूजाफलं लभेत् ।\nसर्वलक्षणसंयुक्तं सद्यः पूजाफलप्रदम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001075004, "chapter_id": 21075, "verse_number": "१-११-५", "content_sanskrit": "चरे विशिष्यते सूक्ष्मं स्थावरे स्थूलमेव हि ।\nसलक्षणं सपीठं च स्थापयेच्छिवनिर्मितम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001075005, "chapter_id": 21075, "verse_number": "१-११-६", "content_sanskrit": "मंडलं चतुरस्रं वा त्रिकोणमथवा तथा ।\nखट्वांगवन्मध्यसूक्ष्मं लिंगपीठं महाफलं॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001075006, "chapter_id": 21075, "verse_number": "१-११-७", "content_sanskrit": "प्रथमं मृच्छिलादिभ्यो लिगं लोहादिभिः कृतम् ।\nयेन लिंगं तेन पीठं स्थावरे हि विशिष्यते॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001075007, "chapter_id": 21075, "verse_number": "१-११-८", "content_sanskrit": "लिंगं पीठं चरे त्वेकं लिंगं बाणकृतं विना ।\nलिंगप्रमाणं कर्तृणां द्वादशांगुलमुत्तमम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001075008, "chapter_id": 21075, "verse_number": "१-११-९", "content_sanskrit": "न्यूनं चेत्फलमल्पं स्यादधिकं नैव दूष्यते ।\nकर्तुरेकांगुलन्यूनं चरेपि च तथैव हि॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001075009, "chapter_id": 21075, "verse_number": "१-११-१०", "content_sanskrit": "आदौ विमानं शिल्पेन कार्यं देवगणैर्युतम् ।\nतत्र गर्भगृहे रम्ये दृढे दर्पणसंनिभे॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001075010, "chapter_id": 21075, "verse_number": "१-११-११", "content_sanskrit": "भूषिते नवरत्नैश्च दिग्द्वारे च प्रधानकैः ।\nनीलं रक्तं च वै दूर्यं श्यामं मारकतं तथा॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001075011, "chapter_id": 21075, "verse_number": "१-११-१२", "content_sanskrit": "मुक्ताप्रवालगोमेदवज्राणि नवरत्नकम् ।\nमध्ये लिंगं महद्द्रव्यं निक्षिपेत्सहवैदिके॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001075012, "chapter_id": 21075, "verse_number": "१-११-१३", "content_sanskrit": "संपूज्य लिंगं सद्याद्यैः पंचस्थाने यथाक्रमम् ।\nअग्नौ च हुत्वा बहुधा हविषास कलं च माम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001075013, "chapter_id": 21075, "verse_number": "१-११-१४", "content_sanskrit": "अभ्यर्च्य गुरुमाचार्यमर्थैः कामैश्च बांधवम् ।\nदद्यादैश्वर्यमर्थिभ्यो जडमप्यजडं तथा॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001075014, "chapter_id": 21075, "verse_number": "१-११-१५", "content_sanskrit": "स्थावरं जंगमं जीवं सर्वं संतोष्य यत्नतः ।\nसुवर्णपूरिते श्वभ्रे नवरत्नैश्च पूरिते॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001075015, "chapter_id": 21075, "verse_number": "१-११-१६", "content_sanskrit": "सद्यादि ब्रह्म चोच्चार्य ध्यात्वा देवं परं शुभम् ।\nउदीर्य च महामंत्रमओंकारं नादघोषितम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001075016, "chapter_id": 21075, "verse_number": "१-११-१७", "content_sanskrit": "लिंगं तत्र प्रतिष्ठाप्य लिगं पीठेन योजयेत् ।\nलिंगं सपीठं निक्षिप्य नित्यलेपेन बंधयेत्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001075017, "chapter_id": 21075, "verse_number": "१-११-१८", "content_sanskrit": "एवं बेरं च संस्थाप्यं तत्रैव परमं शुभम् ।\nपंचाक्षरेण बेरं तु उत्सवार्थं वहिस्तथा॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001075018, "chapter_id": 21075, "verse_number": "१-११-१९", "content_sanskrit": "बेरं गुरुभ्यो गृह्णीयात्साधुभिः पूजितं तु वा ।\nएवं लिंगे च बेरे च पूजा शिवपदप्रदा॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001075019, "chapter_id": 21075, "verse_number": "१-११-२०", "content_sanskrit": "पुनश्च द्विविधं प्रोक्तं स्थावरं जंगमं तथा ।\nस्थावरं लिंगमित्याहुस्तरुगुल्मादिकं तथा॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001075020, "chapter_id": 21075, "verse_number": "१-११-२१", "content_sanskrit": "जंगमं लिंगमित्याहुः कृमिकीटादिकं तथा ।\nस्थावरस्य च शुश्रूषा जंगमस्य च तर्पणम्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001075021, "chapter_id": 21075, "verse_number": "१-११-२२", "content_sanskrit": "तत्तत्सुखानुरागेण शिवपूजां विदुर्बुधाः ।\nपीठमंबामयं सर्वं शिवलिंगं च चिन्मयम्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001075022, "chapter_id": 21075, "verse_number": "१-११-२३", "content_sanskrit": "यथा देवीमुमामंके धृत्वा तिष्ठति शंकरः ।\nतथा लिंगमिदं पीठं धृत्वा तिष्ठति संततम्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001075023, "chapter_id": 21075, "verse_number": "१-११-२४", "content_sanskrit": "एवं स्थाप्य महालिंगं पूजयेदुपचारकैः ।\nनित्यपूजा यथा शक्तिध्वजादिकरणं तथा॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001075024, "chapter_id": 21075, "verse_number": "१-११-२५", "content_sanskrit": "इति संस्थापयेल्लिंगं साक्षाच्छिवपदप्रदम् ।\nअथवा चरलिंगं तु षोडशैरुपचारकैः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001075025, "chapter_id": 21075, "verse_number": "१-११-२६", "content_sanskrit": "पूजयेच्च यथान्यायं क्रमाच्छिवपदप्रदम् ।\nआवाहनं चासनं च अर्घ्यं पाद्यं तथैव च॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001075026, "chapter_id": 21075, "verse_number": "१-११-२७", "content_sanskrit": "तदंगाचमनं चैव स्नानमभ्यंगपूर्वकम् ।\nवस्त्रं गंधं तथा पुष्पं धूपं दीपं निवेदनम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001075027, "chapter_id": 21075, "verse_number": "१-११-२८", "content_sanskrit": "नीराजनं च तांबूलं नमस्कारो विसर्जनम् ।\nअथवाऽर्घ्यादिकं कृत्वा नैवेद्यां तं यथाविधि॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001075028, "chapter_id": 21075, "verse_number": "१-११-२९", "content_sanskrit": "अथाभिषेकं नैवेद्यं नमस्कारं च तर्पणम् ।\nयथाशक्ति सदाकुर्यात्क्रमाच्छिवपदप्रदम्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001075029, "chapter_id": 21075, "verse_number": "१-११-३०", "content_sanskrit": "अथवा मानुषे लिंगेप्यार्षे दैवे स्वयंभुवि ।\nस्थापितेऽपूर्वके लिंगे सोपचारं यथा तथा॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001075030, "chapter_id": 21075, "verse_number": "१-११-३१", "content_sanskrit": "पूजोपकरणे दत्ते यत्किंचित्फलमश्नुते ।\nप्रदक्षिणानमस्कारैः क्रमाच्छिवपदप्रदम्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001075031, "chapter_id": 21075, "verse_number": "१-११-३२", "content_sanskrit": "लिंगं दर्शनमात्रं वा नियमेन शिवप्रदम् ।\nमृत्पिष्टगोशकृत्पुष्पैः करवीरेण वा फलैः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001075032, "chapter_id": 21075, "verse_number": "१-११-३३", "content_sanskrit": "गुडेन नवनीतेन भस्मनान्नैर्यथारुचि ।\nलिंगं यत्नेन कृत्वांते यजेत्तदनुसारतः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001075033, "chapter_id": 21075, "verse_number": "१-११-३४", "content_sanskrit": "अंगुष्ठादावपि तथा पूजामिच्छंति केचन ।\nलिंगकर्मणि सर्वत्र निषेधोस्ति न कर्हिचित्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001075034, "chapter_id": 21075, "verse_number": "१-११-३५", "content_sanskrit": "सर्वत्र फलदाता हि प्रयासानुगुणं शिवः ।\nअथवा लिंगदानं वा लिंगमौल्यमथापि वा॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001075035, "chapter_id": 21075, "verse_number": "१-११-३६", "content_sanskrit": "श्रद्धया शिवभक्ताय दत्तं शिवपदप्रदम् ।\nअथवा प्रणवं नित्यं जपेद्दशसहस्रकम्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001075036, "chapter_id": 21075, "verse_number": "१-११-३७", "content_sanskrit": "संध्ययोश्च सहस्रं वा ज्ञेयं शिवपदप्रदम् ।\nजपकाले मकारांतं मनःशुद्धिकरं भजेत्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001075037, "chapter_id": 21075, "verse_number": "१-११-३८", "content_sanskrit": "समाधौ मानसं प्रोक्तमुपांशु सार्वकालिकम् ।\nसमानप्रणवं चेमं बिंदुनादयुतं विदुः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001075038, "chapter_id": 21075, "verse_number": "१-११-३९", "content_sanskrit": "अथ पंचाक्षरं नित्यं जपेदयुतमादरात् ।\nसंध्ययोश्च सहस्रं वा ज्ञेयं शिवपदप्रदम्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001075039, "chapter_id": 21075, "verse_number": "१-११-४०", "content_sanskrit": "प्रणवेनादिसंयुक्तं ब्राह्मणानां विशिष्यते ।\nदीक्षायुक्तं गुरोर्ग्राह्यं मंत्रं ह्यथ फलाप्तये॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001075040, "chapter_id": 21075, "verse_number": "१-११-४१", "content_sanskrit": "कुंभस्नानं मंत्रदीक्षां मातृकान्यासमेव च ।\nब्राह्मणः सत्यपूतात्मा गुरुर्ज्ञानी विशिष्यते॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001075041, "chapter_id": 21075, "verse_number": "१-११-४२", "content_sanskrit": "द्विजानां च नमःपूर्वमन्येषां च नमोन्तकम् ।\nस्त्रीणां च क्वचिदिच्छंति नमो तं च यथाविधि॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001075042, "chapter_id": 21075, "verse_number": "१-११-४३", "content_sanskrit": "विप्रस्त्रीणां नमः पूर्वमिदमिच्छंति केचन ।\nपंचकोटिजपं कृत्वा सदा शिवसमो भवेत्॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001075043, "chapter_id": 21075, "verse_number": "१-११-४४", "content_sanskrit": "एकद्वित्रिचतुःकोट्याब्रह्मादीनां पदं व्रजेत् ।\nजपेदक्षरलक्षंवा अक्षराणां पृथक्पृथक्॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001075044, "chapter_id": 21075, "verse_number": "१-११-४५", "content_sanskrit": "अथवाक्षरलक्षं वा ज्ञेयं शिवपदप्रदम् ।\nसहस्रं तु सहस्राणां सहस्रेण दिनेन हि॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001075045, "chapter_id": 21075, "verse_number": "१-११-४६", "content_sanskrit": "जपेन्मंत्रादिष्टसिद्धिर्नित्यं ब्राह्मणभोजनात् ।\nअष्टोत्तरसहस्रं वै गायत्रीं प्रातरेव हि॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001075046, "chapter_id": 21075, "verse_number": "१-११-४७", "content_sanskrit": "ब्राह्मणस्तु जपेन्नित्यं क्रमाच्छिवपदप्रदान् ।\nवेदमंत्रांस्तु सूक्तानि जपेन्नियममास्थितः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001075047, "chapter_id": 21075, "verse_number": "१-११-४८", "content_sanskrit": "एकं दशार्णं मंत्रं च शतोनं च तदूर्ध्वकम् ।\nअयुतं च सहस्रं च शतमेकं विना भवेत्॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001075048, "chapter_id": 21075, "verse_number": "१-११-४९", "content_sanskrit": "वेदपारायणं चैव ज्ञेयं शिवपदप्रदम् ।\nअन्यान्बहुतरान्मंत्राञ्जपेदक्षरलक्षतः॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001075049, "chapter_id": 21075, "verse_number": "१-११-५०", "content_sanskrit": "एकाक्षरांस्तथा मंत्राञ्जपेदक्षरकोटितः ।\nततः परं जपेच्चैव सहस्रं भक्तिपूर्वकम्॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001075050, "chapter_id": 21075, "verse_number": "१-११-५१", "content_sanskrit": "एवं कुर्याद्यथाशक्ति क्रमाच्छिव पदं लभेत् ।\nनित्यं रुचिकरं त्वेकं मंत्रमामरणांतिकम्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001075051, "chapter_id": 21075, "verse_number": "१-११-५२", "content_sanskrit": "जपेत्सहस्रमोमिति सर्वाभीष्टं शिवाज्ञया ।\nपुष्पारामादिकं वापि तथा संमार्जनादिकम्॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001075052, "chapter_id": 21075, "verse_number": "१-११-५३", "content_sanskrit": "शिवाय शिवकार्याथे कृत्वा शिवपदं लभेत् ।\nशिवक्षेत्रे तथा वासं नित्यं कुर्याच्च भक्तितः॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001075053, "chapter_id": 21075, "verse_number": "१-११-५४", "content_sanskrit": "जडानामजडानां च सर्वेषां भुक्तिमुक्तिदम् ।\nतस्माद्वासं शिवक्षेत्रे कुर्यदामरणं बुधः॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001075054, "chapter_id": 21075, "verse_number": "१-११-५५", "content_sanskrit": "लिंगाद्धस्तशतं पुण्यं क्षेत्रे मानुषके विदुः ।\nसहस्रारत्निमात्रं तु पुण्यक्षेत्रे तथार्षके॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001075055, "chapter_id": 21075, "verse_number": "१-११-५६", "content_sanskrit": "दैवलिंगे तथा ज्ञेयं सहस्रारत्निमानतः ।\nधनुष्प्रमाणसाहस्रं पुण्यं क्षेत्रे स्वयं भुवि॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001075056, "chapter_id": 21075, "verse_number": "१-११-५७", "content_sanskrit": "पुण्यक्षेत्रे स्थिता वापी कूपाद्यं पुष्कराणि च ।\nशिवगंगेति विज्ञेयं शिवस्य वचनं यथा॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001075057, "chapter_id": 21075, "verse_number": "१-११-५८", "content_sanskrit": "तत्र स्नात्वा तथा दत्त्वा जपित्वा हि शिवं व्रजेत् ।\nशिवक्षेत्रं समाश्रित्य वसेदामरणं तथा॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001075058, "chapter_id": 21075, "verse_number": "१-११-५९", "content_sanskrit": "दाहं दशाहं मास्यं वा सपिंडीकरणं तु वा ।\nआब्दिकं वा शिवक्षेत्रे क्षेत्रे पिंडमथापि वा॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001075059, "chapter_id": 21075, "verse_number": "१-११-६०", "content_sanskrit": "सर्वपाप विनिर्मुक्तः सद्यः शिवपदं लभेत् ।\nअथवा सप्तरात्रं वा वसेद्वा पंचरात्रकम्॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001075060, "chapter_id": 21075, "verse_number": "१-११-६१", "content_sanskrit": "त्रिरात्रमेकरात्रं वा क्रमाच्छिवपदं लभेत् ।\nस्ववर्णानुगुणं लोके स्वाचारात्प्राप्नुते नरः॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001075061, "chapter_id": 21075, "verse_number": "१-११-६२", "content_sanskrit": "वर्णोद्धारेण भक्त्या च तत्फलातिशयं नरः ।\nसर्वं कृतं कामनया सद्यः फलमवाप्नुयात्॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001075062, "chapter_id": 21075, "verse_number": "१-११-६३", "content_sanskrit": "सर्वं कृतमकामेन साक्षाच्छिवपदप्रदम् ।\nप्रातर्मध्याह्नसायाह्नमहस्त्रिष्वेकतः क्रमात्॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001075063, "chapter_id": 21075, "verse_number": "१-११-६४", "content_sanskrit": "प्रातर्विधिकरं ज्ञेयं मध्याह्नं कामिकं तथा ।\nसायाह्नं शांतिकं ज्ञेयं रात्रावपि तथैव हि॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001075064, "chapter_id": 21075, "verse_number": "१-११-६५", "content_sanskrit": "कालो निशीथो वै प्रोक्तोमध्ययामद्वयं निशि ।\nशिवपूजा विशेषेण तत्कालेऽभीष्टसिद्धिदा॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001075065, "chapter_id": 21075, "verse_number": "१-११-६६", "content_sanskrit": "एवं ज्ञात्वा नरः कुर्वन्यथोक्तफलभाग्भवेत् ।\nकलौ युगे विशेषेण फलसिद्धिस्तु कर्मणा॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001075066, "chapter_id": 21075, "verse_number": "१-११-६७", "content_sanskrit": "उक्तेन केनचिद्वापि अधिकारविभेदतः ।\nसद्वृत्तिः पापभीरुश्चेत्ततत्फलमवाप्नुयात्॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001075067, "chapter_id": 21075, "verse_number": "१-११-६८", "content_sanskrit": "ऋषय ऊचुः ।\nअथ क्षेत्राणि पुण्यानि समासात्कथयस्व नः ।\nसर्वाः स्त्रियश्च पुरुषा यान्याश्रित्य पदं लभेत्॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001075068, "chapter_id": 21075, "verse_number": "१-११-६९", "content_sanskrit": "सूत योगिवरश्रेष्ठ शिवक्षेत्रागमांस्तथा ।\nसूत उवाच ।\nशृणुत श्रद्धया सर्वक्षेत्राणि च तदागमान्॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}]