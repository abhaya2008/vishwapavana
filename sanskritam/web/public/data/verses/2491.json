[{"id": 2070820, "chapter_id": 2491, "verse_number": "११-२३-०x", "content_sanskrit": "गान्धार्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2070821, "chapter_id": 2491, "verse_number": "११-२३-१", "content_sanskrit": "एष शल्यो हतः शेते साक्षान्नकुलमातुलः।\nधर्मज्ञेन हतस्तात धर्मराजेन संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2070822, "chapter_id": 2491, "verse_number": "११-२३-२", "content_sanskrit": "यस्त्वया स्पर्धते नित्यं सर्वत्र पुरुषर्षभ।\nस एष निहतः शेते मद्रराजो महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2070823, "chapter_id": 2491, "verse_number": "११-२३-३", "content_sanskrit": "`जयद्रथे यदि ब्रूयुरुपरोधं कथञ्चन।\nमद्रपुत्रे कथं ब्रूयुरुपरोधं विवक्षवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2070824, "chapter_id": 2491, "verse_number": "११-२३-४", "content_sanskrit": "येन सङ्गृह्णता तात रथमाधिरथेर्युधि।\nजयार्थं पाण्डुपुत्राणां तदा तेजोवधः कृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2070825, "chapter_id": 2491, "verse_number": "११-२३-५", "content_sanskrit": "अहो धिक्फश्य शल्यस्य पूर्णचन्द्रसुदर्शनम्।\nमुखं प्द्मपलाशाक्षं काकैरादष्टमव्रणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2070826, "chapter_id": 2491, "verse_number": "११-२३-६", "content_sanskrit": "एषा चामीकराभस्य तप्तकाञ्चनसप्रभा।\nआस्याद्विनिः सृता जिह्वा भक्ष्यते कृष्ण पक्षिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2070827, "chapter_id": 2491, "verse_number": "११-२३-७", "content_sanskrit": "युधिष्ठिरेण निहतं शल्यं समितिशोभनम्।\nरुदन्त्यः पर्युपासन्ते मद्रराजं कुलाङ्गनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2070828, "chapter_id": 2491, "verse_number": "११-२३-८", "content_sanskrit": "एताः सुसूक्ष्मवसना मद्रराजं नरर्षभम्।\nक्रोशन्त्योऽथ समासाद्य क्षत्रियाः क्षत्रियर्षभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2070829, "chapter_id": 2491, "verse_number": "११-२३-९", "content_sanskrit": "शल्यं निपतितं नार्यः परिवार्याभितः स्थिताः।\nवासिता गृष्टयः पङ्के परिमग्नमिवर्षभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2070830, "chapter_id": 2491, "verse_number": "११-२३-१०", "content_sanskrit": "शल्यं शरणदं शूरं पश्येमं वृष्णिनन्दन।\nशयानं वीरशयने शरैर्विशकलीकृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2070831, "chapter_id": 2491, "verse_number": "११-२३-११", "content_sanskrit": "एष शैलालयो राजा भगदत्तः प्रतापवान्।\nगजाङ्कुशधरः श्रीमाञ्शेते भुवि निपातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2070832, "chapter_id": 2491, "verse_number": "११-२३-१२", "content_sanskrit": "यस्य रुक्ममयी माला शिरस्येषा विराजते।\nश्वापदैर्भक्ष्यमाणस्य शोभयन्तीव मूर्धजान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2070833, "chapter_id": 2491, "verse_number": "११-२३-१३", "content_sanskrit": "एतेन किल पार्थस्य युद्धमासीत्सुदारुणम्।\nरोमहर्षणमत्युग्रं शक्रस्य त्वहिना यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2070834, "chapter_id": 2491, "verse_number": "११-२३-१४", "content_sanskrit": "योधयित्वा माहाबाहुरेष पार्थं धनञ्जयम्।\nसंशयं गमयित्वा च कुन्तीपुत्रेण पातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2070835, "chapter_id": 2491, "verse_number": "११-२३-१५", "content_sanskrit": "यस्य नास्ति समो लोके शौर्ये वीर्ये च कश्चन्।\nस एष निहतः शेते भीष्मो भीष्मकृदाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2070836, "chapter_id": 2491, "verse_number": "११-२३-१६", "content_sanskrit": "पश्य शान्तनवं कृष्ण शयानं सूर्यवर्चसम्।\nयुगान्त इव कालेन पातितं सूर्यमम्बरात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2070837, "chapter_id": 2491, "verse_number": "११-२३-१७", "content_sanskrit": "एष तप्त्वा रणे शत्रूञ्शस्त्रतापेन वीर्यवान्।\nनरसूर्योऽस्तमभ्येति सूर्योऽस्तमिव केशव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2070838, "chapter_id": 2491, "verse_number": "११-२३-१८", "content_sanskrit": "शरतल्पगतं भीष्ममूर्ध्वरेतसमच्युतम्।\nशयानं वीरशयने पश्य शूरनिषेविते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2070839, "chapter_id": 2491, "verse_number": "११-२३-१९", "content_sanskrit": "कर्णिनालीकनाराचैरास्तीर्य शयनोत्तमम्।\nआविश्य शेते भगवान्स्कन्दः शरवणं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2070840, "chapter_id": 2491, "verse_number": "११-२३-२०", "content_sanskrit": "अतूलपूर्णं गाङ्गेयस्त्रिभिर्बाणैः समन्वितम्।\nउपधायोपधानाग्र्यं दत्तं गाण्डीवधन्वना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2070841, "chapter_id": 2491, "verse_number": "११-२३-२१", "content_sanskrit": "पालयानः पितुः शास्त्रमूर्ध्वरेता महायशाः।\nएष शान्तनवः शेते माधवाप्रतिमो युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2070842, "chapter_id": 2491, "verse_number": "११-२३-२२", "content_sanskrit": "धर्मात्मा तात सर्वज्ञः पारावर्येण निर्णये।\nअमर्त्य इव मर्त्यः सन्नेष प्राणानधारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2070843, "chapter_id": 2491, "verse_number": "११-२३-२३", "content_sanskrit": "नास्ति युद्धे कृती कश्चिन्न विद्वान्न पराक्रमी।\nयत्र शान्तनवो भीष्मः शेतेऽद्य निहतः परैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2070844, "chapter_id": 2491, "verse_number": "११-२३-२४", "content_sanskrit": "स्वयमेतेन शूरेण पृच्छयमानेन पाण्डवैः।\nधर्मज्ञेनाहवे मृत्युरादिष्टः सत्यवादिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2070845, "chapter_id": 2491, "verse_number": "११-२३-२५", "content_sanskrit": "प्रनष्टः कुरुवंशश्च पुनर्येन समुद्वृतः।\nस गतः कुरुभिः सार्धं महाबुद्धिः पराभवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2070846, "chapter_id": 2491, "verse_number": "११-२३-२६", "content_sanskrit": "धर्मेण कुरवः केन परिद्रक्ष्यन्ति माधव।\nहते देवव्रते भीष्मे देवकल्पे नरर्षभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2070847, "chapter_id": 2491, "verse_number": "११-२३-२७", "content_sanskrit": "अर्जुनस्य विनेतारमाचार्यं सात्यकेस्तथा।\nतं पश्य पतितं द्रोणं कुरूणां गुरुमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2070848, "chapter_id": 2491, "verse_number": "११-२३-२८", "content_sanskrit": "अस्त्रं चतुर्विधं वेद यथैव त्रिदशेश्वरः।\nभार्गवो वा महावीर्यस्तथा द्रोणोऽपि माधव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2070849, "chapter_id": 2491, "verse_number": "११-२३-२९", "content_sanskrit": "यस्य प्रसादाद्बीभत्सुः पाण्डवः कर्म दुष्करम्।\nचकार स हतः शेते नैनमस्त्राण्यपालयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2070850, "chapter_id": 2491, "verse_number": "११-२३-३०", "content_sanskrit": "यं पुरोधाय कुरव आह्वयन्ति स्म पाण्डवान्।\nसोऽयं शस्त्रभृतां श्रेष्ठो द्रोणः शस्त्रपृथक्कृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2070851, "chapter_id": 2491, "verse_number": "११-२३-३१", "content_sanskrit": "यस्य निर्दहतः सेनां गतिरग्नरिवाभवत्।\nस भूमौ निहतः शेते शान्तार्चिरिव पावकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2070852, "chapter_id": 2491, "verse_number": "११-२३-३२", "content_sanskrit": "धनुर्मुष्टिरशीर्णश्च हस्तावापश्च माधव।\nद्रोणस्य निहतस्यापि दृश्यते जीवतो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2070853, "chapter_id": 2491, "verse_number": "११-२३-३३", "content_sanskrit": "वेदा यस्माच्च चत्वारः सर्वाण्यस्त्राणि केशव।\nअनपेतानि वै शूराद्यथैवादौ प्रजापतेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2070854, "chapter_id": 2491, "verse_number": "११-२३-३४", "content_sanskrit": "चन्दनार्हाविमौ तस्य बन्दिभिर्वन्दितौ शुभौ।\nगोमायवो विकर्षन्ति पादौ शिष्यशतार्चितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2070855, "chapter_id": 2491, "verse_number": "११-२३-३५", "content_sanskrit": "द्रोणं द्रुपदपुत्रेण निहतं मधुसूदन।\nकृपी कृपणमन्वास्ते दुःखोपहतचेतना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2070856, "chapter_id": 2491, "verse_number": "११-२३-३६", "content_sanskrit": "तां पश्य रुदतीमार्तां मुक्तकेशीमधोमुखीम्।\nहतं पतिमुपासन्तीं द्रोणं शस्त्रभृतां वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2070857, "chapter_id": 2491, "verse_number": "११-२३-३७", "content_sanskrit": "बाणैर्भिन्नतनुत्राणं धृष्टद्युम्नेन केशव।\nउपास्ते वै मृधे द्रोणं जटिला ब्रह्मचारिणी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2070858, "chapter_id": 2491, "verse_number": "११-२३-३८", "content_sanskrit": "प्रेतकृत्ये च यतते कृपी कृपणमातुरा।\nहतस्य समरे भर्तुः सुकुमारी यशस्विनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2070859, "chapter_id": 2491, "verse_number": "११-२३-३९", "content_sanskrit": "अग्नीनाधाय विविधवच्चितां प्रज्वाल्य सर्वतः।\nद्रोणमाधाय गायन्ति त्रीणि सामानि सामगाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2070860, "chapter_id": 2491, "verse_number": "११-२३-४०", "content_sanskrit": "कुर्वन्ति च चितामेते जटिला ब्रह्मचारिणः।\nधनुर्भिः शक्तिभिश्चैव रथनीडैश्च माधव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2070861, "chapter_id": 2491, "verse_number": "११-२३-४१", "content_sanskrit": "शरैश्च विविधैरन्यैर्धक्ष्यन्ते भूरितेजसम्।\nत एते द्रोणमादाय गायन्ति च रुदन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2070862, "chapter_id": 2491, "verse_number": "११-२३-४२", "content_sanskrit": "सामभिस्त्रिभिरन्तस्थैरनुशंसन्ति चापरे।\nअग्नावग्निं समाधाय द्रोणं हुत्वा हुताशने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2070863, "chapter_id": 2491, "verse_number": "११-२३-४३", "content_sanskrit": "गच्छन्त्यभिमुखा गङ्गां द्रोणशिष्या द्विजातयः।\nअपसव्यां चितिं कृत्वा पुरस्कृत्य कृपीं तथा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2070864, "chapter_id": 2491, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते स्त्रीपर्वणि स्त्रीविलापपर्वणि त्रयोविंशोऽध्यायः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]