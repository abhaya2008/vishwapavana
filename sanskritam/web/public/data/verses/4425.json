[{"id": 2158151, "chapter_id": 4425, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2158152, "chapter_id": 4425, "verse_number": "१", "content_sanskrit": "तेष्वनीकेषु भग्नेषु पाण्डुपुत्रेण सञ्जय ।\nचलितानां द्रुतानां च कथमासीन्मनांसि वः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2158153, "chapter_id": 4425, "verse_number": "२", "content_sanskrit": "अनीकानां प्रभग्नानामधिष्ठानमपश्यताम् ।\nदुष्करं प्रतिसन्धानं तन्ममाचक्ष्व सञ्जय\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2158154, "chapter_id": 4425, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2158155, "chapter_id": 4425, "verse_number": "३", "content_sanskrit": "ते तथा हतभूयिष्ठास्तव प्रियहितैषिणः ।\nयशः प्रवीरा लोकेषु रक्षन्तो द्रोणमन्वयुः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2158156, "chapter_id": 4425, "verse_number": "४", "content_sanskrit": "समुद्यतेषु शस्त्रेषु सम्प्राप्ते च युधिष्ठिरे ।\nअकुर्वन्नार्यकर्माणि भैरवे सत्यविक्रमाः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2158157, "chapter_id": 4425, "verse_number": "५", "content_sanskrit": "अन्तरं भीमसेनस्य प्रापतन्नमितौजसः ।\nसात्यकस्य च वीरस्य धृष्टद्युम्नस्य पार्थिवाः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2158158, "chapter_id": 4425, "verse_number": "६", "content_sanskrit": "द्रोणं द्रोणमिति क्रुद्धाः पाञ्चालाः समचोदयन् ।\nमा द्रोणमिति ते पुत्राः स्वसैन्यं समचोदयन्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2158159, "chapter_id": 4425, "verse_number": "७", "content_sanskrit": "पाण्डवा द्रोणमित्येवं मा द्रोणमिति चापरे ।\nपाण्डवानां कुरूणां च द्रोणद्यूतमवर्तत\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2158160, "chapter_id": 4425, "verse_number": "८", "content_sanskrit": "यं यं प्रमथते द्रोणः पाण्डवानां रथव्रजम् ।\nतत्र तत्र स पाञ्चालो धृष्टद्युम्नो विधीयते\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2158161, "chapter_id": 4425, "verse_number": "९", "content_sanskrit": "तेषां भाग्यविपर्यासे सङ्ग्रामे भैरवे सति ।\nवीराः समासदन् वीरान् नागच्छन् भीरवः परान्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2158162, "chapter_id": 4425, "verse_number": "१०", "content_sanskrit": "अकम्पनीयाः शत्रूणामभवंस्तत्र पाण्डवाः ।\nअकम्पयन्ननीकानि स्मरन्तः क्लेशमात्मनः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2158163, "chapter_id": 4425, "verse_number": "११", "content_sanskrit": "ते ह्यमर्षवशं प्राप्ता ह्रीमन्तः सत्त्वचोदिताः ।\nत्यक्त्वा प्राणानवर्तन्त निघ्नन्तो द्रोणमाहवे\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2158164, "chapter_id": 4425, "verse_number": "१२", "content_sanskrit": "अयसामिव सङ्घातः शिलानामिव चाभवत् ।\nदीव्यतां तुमुले युद्धे प्राणैरमिततेजसाम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2158165, "chapter_id": 4425, "verse_number": "१३", "content_sanskrit": "नानुस्मरन्ति सङ्ग्रामं वृद्धाश्चापि तथाविधम् ।\nये पूर्वदेवैर्देवानामपश्यन् पूर्वमद्भुतम्\nदृष्टपूर्वं न वै राजन् श्रुतपूर्वमथापि वा\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2158166, "chapter_id": 4425, "verse_number": "१४", "content_sanskrit": "प्रकम्पते च पृथिवी तत्र वीरावसादने ।\nविवर्तता जनौघेन महता भारपीडिता\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2158167, "chapter_id": 4425, "verse_number": "१५", "content_sanskrit": "बलौघस्य च भीमस्य दिवं स्तब्ध्वेव निस्वनः ।\nअजातशत्रोः क्रुद्धस्य पुत्रस्य तव चाभवत्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2158168, "chapter_id": 4425, "verse_number": "१६", "content_sanskrit": "समासाद्य च पाण्डूनामनीकानि सहस्रशः ।\nद्रोणेन चरता सङ्खे प्रभग्नानि शितैः शरैः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2158169, "chapter_id": 4425, "verse_number": "१७", "content_sanskrit": "तेषु प्रमथ्यमानेषु द्रोणेनाद्भुतकर्मणा ।\nपर्यवारयदासाद्य द्रोणं सेनापतिः स्वयम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2158170, "chapter_id": 4425, "verse_number": "१८", "content_sanskrit": "तद् युद्धमभवद् घोरं द्रोणपाञ्चाल्ययोस्तदा ।\nनैव तस्योपमा काचिदिति मे निश्चिता मतिः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2158171, "chapter_id": 4425, "verse_number": "१९", "content_sanskrit": "ततो नीलोऽनलप्रख्यः ददाह कुरुवाहिनीम् ।\nशरस्फुलिङ्गश्चापार्चिः शुष्ककक्षमिवानलः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2158172, "chapter_id": 4425, "verse_number": "२०", "content_sanskrit": "तं दहन्तमनीकानि द्रोणपुत्रः प्रतापवान् ।\nपूर्वाभिभाषी सुश्लक्ष्णं स्मयमानोऽभ्यभाषत\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2158173, "chapter_id": 4425, "verse_number": "२१", "content_sanskrit": "नील किं बहुभिर्दग्धैस्तव योधैः शरार्चिषा ।\nमयैकेनैव युद्ध्यस्व क्रुद्धः प्रहर चाशुगैः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2158174, "chapter_id": 4425, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2158175, "chapter_id": 4425, "verse_number": "२२", "content_sanskrit": "तं पद्मनिकराकारं पद्मपत्रनिभेक्षणम् ।\nव्याकोशपद्माभमुखं नीलो विव्याध पत्रिभिः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2158176, "chapter_id": 4425, "verse_number": "२३", "content_sanskrit": "तेनातिविद्धः सहसा द्रौणिर्भल्लैस्त्रिभिः शितैः ।\nधनुर्ध्वजं च छत्रं च द्विषतः सन्न्यकृन्तत\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2158177, "chapter_id": 4425, "verse_number": "२४", "content_sanskrit": "सोत्प्लुत्य स्यन्दनात् तस्मान्नीलश्चर्मवरासिधृक् ।\nद्रौणायनेः शिरः कायाद्धर्तुमैच्छत् पतत्रिवत्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2158178, "chapter_id": 4425, "verse_number": "२५", "content_sanskrit": "तस्योद्यतासेश्चरतः शिरः कायात् सकुण्डलम् ।\nभल्लेनापाहरद् द्रौणिः स्मयमान इवानघ\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2158179, "chapter_id": 4425, "verse_number": "२६", "content_sanskrit": "सम्पूर्णचन्द्राभमुखः पद्मपत्रनिभेक्षणः ।\nप्रांशुरुत्पलपत्राभो निहतो न्यपतद् भुवि\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2158180, "chapter_id": 4425, "verse_number": "२७", "content_sanskrit": "ततः प्रविव्यथे सेना पाण्डवी भृशमाकुला ।\nआचार्यपुत्रेण हते नीले ज्वलिततेजसि\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2158181, "chapter_id": 4425, "verse_number": "२८", "content_sanskrit": "अचिन्तयंश्च ते सर्वे पाण्डवानां महारथाः ।\nकथं नो वाऽस्वस्ति नायात् शत्रुभ्य इति मारिष\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2158182, "chapter_id": 4425, "verse_number": "२९", "content_sanskrit": "दक्षिणेन तु सेनायाः कुरुते कदनं बली ।\nसंशप्तकावशेषस्य नारायणबलस्य च\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2158183, "chapter_id": 4425, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nद्रोणपर्वणि त्रिंशोऽध्यायः ॥ ३० ॥\nसंशप्तकवधपर्वणि पञ्चदशोऽध्यायः ॥ १५ ॥\n– – ० – –", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]