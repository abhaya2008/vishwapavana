[{"id": 2026529, "chapter_id": 1568, "verse_number": "३-२०६-०x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2026530, "chapter_id": 1568, "verse_number": "३-२०६-१", "content_sanskrit": "स एवमुक्तो राजर्षिरुदङ्केनापराजितः।\nउदङ्कं कौरवश्रेष्ठ कृताञ्जलिथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2026531, "chapter_id": 1568, "verse_number": "३-२०६-२", "content_sanskrit": "न हि मे गमनं ब्रह्मन्मोघमेतद्भविष्यति।\nपुत्रो ममायं भगवन्कुवलाश्व इति स्मृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2026532, "chapter_id": 1568, "verse_number": "३-२०६-३", "content_sanskrit": "धृतिमान्क्षिप्रकारी च वीर्येणाप्रतिमो भुवि।\nप्रियं च ते सर्वमेतत्करिष्यति न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2026533, "chapter_id": 1568, "verse_number": "३-२०६-४", "content_sanskrit": "पुत्रैः परिवृतः सर्वैः शूरैः परिघबाहुभिः।\n`हनिष्यति महाबाहुस्तं वै धुन्धुं महाऽसुरम्।\nविसर्जयस्व मां ब्रह्मन्न्यस्तशस्त्रोस्मि सांप्रतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2026534, "chapter_id": 1568, "verse_number": "३-२०६-५", "content_sanskrit": "तथाऽस्त्विति च तेनोक्तो मुनिनाऽमिततेजसा।\nस तमादिश्य तनयमुदङ्काय महात्मने।\nक्रियतामिति राजर्षिर्जगाम वनमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2026535, "chapter_id": 1568, "verse_number": "३-२०६-६x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2026536, "chapter_id": 1568, "verse_number": "३-२०६-६", "content_sanskrit": "क एष भगवन्दैत्यो महावीर्यस्तपोधन।\nकस्य पुत्रोऽथ नप्ता वा एतदिच्छामि वेदितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2026537, "chapter_id": 1568, "verse_number": "३-२०६-७", "content_sanskrit": "एवं महाबलो दैत्यो न श्रुतो मे तपोधन।\n`यस्य निश्वासवातेन कम्पते भूः सपर्वता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2026538, "chapter_id": 1568, "verse_number": "३-२०६-८", "content_sanskrit": "एतदिच्छामि भगवन्याथातथ्येन वेदितुम्।\nसर्वमेव महाप्राज्ञ विस्तरेण तपोधन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2026539, "chapter_id": 1568, "verse_number": "३-२०६-९x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2026540, "chapter_id": 1568, "verse_number": "३-२०६-९", "content_sanskrit": "शृणु राजननिदं सर्वं यथावृत्तं नराधिप।\nकथ्यमानं महाप्राज्ञ विस्तरेण यथातथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2026541, "chapter_id": 1568, "verse_number": "३-२०६-१०", "content_sanskrit": "एकार्णवे निरालोके नष्टे स्थावरजङ्गमे।\nप्रनष्टेषु च भूतेषु सर्वेषु भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2026542, "chapter_id": 1568, "verse_number": "३-२०६-११", "content_sanskrit": "प्रभवं लोककर्तारं विष्णुं शाश्वतमव्ययम्।\nयमाहुर्मुनयः सिद्धाः सर्वलोकमहेश्वरम्।\n`चतुर्भुजमुदाराङ्गं दृष्टवानस्मि भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2026543, "chapter_id": 1568, "verse_number": "३-२०६-१२", "content_sanskrit": "सुष्वाप भगवान्विष्णुरप्शय्यामेक एव हि।\nनागस् भोगे महति शेपस्यामिततेजसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2026544, "chapter_id": 1568, "verse_number": "३-२०६-१३", "content_sanskrit": "लोककर्ता महाभाग भगवानच्युतो हरिः।\nनागभगेन महता परिरभ्य महीमिमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2026545, "chapter_id": 1568, "verse_number": "३-२०६-१४", "content_sanskrit": "स्वपतस्तस्य देवस्य पद्मं सूर्यसमप्रभम्।\nनाभ्या विनिःसृतं दिव्यं तत्रोत्पन्नः पितामहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2026546, "chapter_id": 1568, "verse_number": "३-२०६-१५", "content_sanskrit": "साक्षाल्लोकगुरुर्ब्रह्मा पद्मे सूर्यसमप्रभः।\nचतुर्वेदश्चतुर्मूर्तिश्चतुर्वर्गश्चतुर्मुखः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2026547, "chapter_id": 1568, "verse_number": "३-२०६-१६", "content_sanskrit": "स्वप्रभावाद्दुराधर्षो महाबलपराक्रमः।\nकस्यचित्त्वथ कालस्य दानवौ वीर्यवत्तमौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2026548, "chapter_id": 1568, "verse_number": "३-२०६-१७", "content_sanskrit": "मधुश्च कैटभश्चैव दृष्टवन्तौ हरिं प्रभुम्।\nशयानं शयने दिव्ये नागभोगे महाद्युतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2026549, "chapter_id": 1568, "verse_number": "३-२०६-१८", "content_sanskrit": "बहुयोजनविस्तीर्णे बहुयोजनमायते।\nकिरीटकौस्तुभधरं पीतकौशेयवाससम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2026550, "chapter_id": 1568, "verse_number": "३-२०६-१९", "content_sanskrit": "दीप्यमानं श्रिया राजंस्तेजसा वपुपा तथा।\nसहस्रसूर्यप्रतिममद्भुतोपमदर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2026551, "chapter_id": 1568, "verse_number": "३-२०६-२०", "content_sanskrit": "विस्मय सुमहानासीन्मधुकैटभयोस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2026552, "chapter_id": 1568, "verse_number": "३-२०६-२१", "content_sanskrit": "दृष्ट्वा पितामहं चापि पद्मे पद्मनिभेक्षणम्।\nवित्रासयेतामथ तौ ब्रह्माणममितौजसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2026553, "chapter_id": 1568, "verse_number": "३-२०६-२२", "content_sanskrit": "वित्रास्यमानो बहुधा ब्रह्मा ताभ्यां महायशाः।\nअकम्पयत्पद्मनालं ततोऽबुध्यत केशवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2026554, "chapter_id": 1568, "verse_number": "३-२०६-२३", "content_sanskrit": "अथापश्त गोविन्दो दानवौ वीर्यवत्तरौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2026555, "chapter_id": 1568, "verse_number": "३-२०६-२४", "content_sanskrit": "दृष्ट्वा तावब्रवीद्देवः स्वागतं वां महाबलौ।\nददामि वां वरं श्रेष्ठं रप्रीतिर्हि मम जायते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2026556, "chapter_id": 1568, "verse_number": "३-२०६-२५", "content_sanskrit": "तौ प्रहस्य हृषीकेशं महादर्पौ महाबलौ।\nप्रत्यब्रूतां महाराज सहितौ मधुसूदनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2026557, "chapter_id": 1568, "verse_number": "३-२०६-२६", "content_sanskrit": "आवां वरय देव त्वं वरदौ स्वः सुरोत्तम।\nदातारौ स्वो वरं तुभ्यं तद्ब्रवीह्यविचारयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2026558, "chapter_id": 1568, "verse_number": "३-२०६-२७x", "content_sanskrit": "भगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2026559, "chapter_id": 1568, "verse_number": "३-२०६-२७", "content_sanskrit": "प्रतिगृह्णे वरं वीरावीप्सितश्च वरो मम।\nयुवां हि वीर्यसंपन्नौ न वामस्ति समः पुमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2026560, "chapter_id": 1568, "verse_number": "३-२०६-२८", "content_sanskrit": "वध्यत्वमुपगच्छेतां मम सत्यपराक्रमौ।\nएतदिच्छाम्यहं कामं प्राप्तुं लोकहिताय वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2026561, "chapter_id": 1568, "verse_number": "३-२०६-२९x", "content_sanskrit": "मधुकैटभावूचतुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2026562, "chapter_id": 1568, "verse_number": "३-२०६-२९", "content_sanskrit": "अनृतंनोक्तपूर्वं नौ स्वैरेष्वपि कुतोऽन्यथा।\nसत्ये धर्मे च निरतौ विद्ध्यावां पुरुषोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2026563, "chapter_id": 1568, "verse_number": "३-२०६-३०", "content_sanskrit": "बले रूपे च शौर्ये च शमे न च समोस्ति नौ।\nधर्मे तपसि दाने च शीलसत्वदमेषु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2026564, "chapter_id": 1568, "verse_number": "३-२०६-३१", "content_sanskrit": "उपप्लवो महानस्मानुपावर्तत केशव।\nउक्तं प्रतिकुरुष्व त्वं कालो हि दुरतिक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2026565, "chapter_id": 1568, "verse_number": "३-२०६-३२", "content_sanskrit": "आवामिच्छावहे देव कृतमेकं त्वया विभो।\nआनावृतेऽवकाशे त्वं जह्यावां सुरसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2026566, "chapter_id": 1568, "verse_number": "३-२०६-३३", "content_sanskrit": "पुत्रत्वमधिगच्छाव तव चापि सुलोचन।\nवर एष वृतोदेव तद्विद्धि सुरसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2026567, "chapter_id": 1568, "verse_number": "३-२०६-३४", "content_sanskrit": "अनृतं मा भवेद्देव यद्धि नौ संश्रुतं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2026568, "chapter_id": 1568, "verse_number": "३-२०६-३५x", "content_sanskrit": "भगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2026569, "chapter_id": 1568, "verse_number": "३-२०६-३५", "content_sanskrit": "बाढमेवं करिष्यामि सर्वमेतद्भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2026570, "chapter_id": 1568, "verse_number": "३-२०६-३६", "content_sanskrit": "सविचिन्त्याथ गोविन्दो नापश्यद्यदनावृतम्।\nअवकाशंपृथिव्यां वा दिवि वा मधुसूदनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2026571, "chapter_id": 1568, "verse_number": "३-२०६-३७", "content_sanskrit": "स्वकावनावृतावूरू दृष्ट्वा देववरस्तदा।\nमधुकैटभयो राजञ्शिरसी मधुसूदनः।\nचक्रेण शितधारेण न्यकृन्तत महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2026572, "chapter_id": 1568, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि मार्कण्डेयसमास्यापर्वणि षडधिकद्विशततमोऽध्यायः ॥ २०६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]