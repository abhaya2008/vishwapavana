[{"id": 7004398000, "chapter_id": 24398, "verse_number": "५-३-९२-१", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nततो गच्छेत्तु राजेन्द्र यमहास्यमनुत्तमम् ।\nसर्वपापहरं तीर्थं नर्मदातटमाश्रितम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004398001, "chapter_id": 24398, "verse_number": "५-३-९२-२", "content_sanskrit": "युधिष्ठिर उवाच ।\nयमहास्यं कथं जातं पृथिव्यां द्विजपुंगव ।\nएतत्सर्वं ममाख्याहि परं कौतूहलं हि मे॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004398002, "chapter_id": 24398, "verse_number": "५-३-९२-३", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nसाधु साधु महाप्राज्ञ पृष्टोऽहं नृपनन्दन ।\nस्नानार्थं नर्मदां पुण्यामागतस्ते पिता पुरा॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004398003, "chapter_id": 24398, "verse_number": "५-३-९२-४", "content_sanskrit": "रजकेन यथा धौतं वस्त्रं भवति निर्मलम् ।\nतथासौ निर्मलो जातो धर्मराजो युधिष्ठिर॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004398004, "chapter_id": 24398, "verse_number": "५-३-९२-५", "content_sanskrit": "स पश्यन्निर्मलं देहं हसन्प्रोवाच विस्मितः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004398005, "chapter_id": 24398, "verse_number": "५-३-९२-६", "content_sanskrit": "यम उवाच ।\nमत्पुरं कथमायान्ति मनुजाः पापबृंहिताः ।\nस्नानेनैकेन रेवायाः प्राप्यते वैष्णवं पदम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004398006, "chapter_id": 24398, "verse_number": "५-३-९२-७", "content_sanskrit": "समर्था ये न पश्यन्ति रेवां पुण्यजलां शुभाम् ।\nजात्यन्धैस्ते समा ज्ञेया मृतैः पङ्गुभिरेव वा॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004398007, "chapter_id": 24398, "verse_number": "५-३-९२-८", "content_sanskrit": "समर्था ये न पश्यन्ति रेवां पुण्यजलां नदीम् ।\nएतस्मात्कारणाद्राजन्हसितो लोकशासनः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004398008, "chapter_id": 24398, "verse_number": "५-३-९२-९", "content_sanskrit": "स्थापयित्वा यमस्तत्र देवं स्वर्गं जगाम ह ।\nयमहासेश्वरे राजञ्जितक्रोधो जितेन्द्रियः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004398009, "chapter_id": 24398, "verse_number": "५-३-९२-१०", "content_sanskrit": "विशेषाच्चाश्विने मासि कृष्णपक्षे चतुर्दशीम् ।\nउपोष्य परया भक्त्या सर्वपापैः प्रमुच्यते॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004398010, "chapter_id": 24398, "verse_number": "५-३-९२-११", "content_sanskrit": "रात्रौ जागरणं कुर्याद्दीपं देवस्य बोधयेत् ।\nघृतेन चैव राजेन्द्र शृणु तत्रास्ति यत्फलम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004398011, "chapter_id": 24398, "verse_number": "५-३-९२-१२", "content_sanskrit": "मुच्यते पातकैः सर्वैरगम्यागमनोद्भवैः ।\nअभक्ष्यभक्षणोद्भूतैरपेयापेयजैरपि॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004398012, "chapter_id": 24398, "verse_number": "५-३-९२-१३", "content_sanskrit": "अवाह्यवाहिते यत्स्याददोह्यादोहने यथा ।\nस्नानमात्रेण तस्यैवं यान्ति पापान्यनेकधा॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004398013, "chapter_id": 24398, "verse_number": "५-३-९२-१४", "content_sanskrit": "यमलोकं न वीक्षेत मनुजः स कदाचन ।\nपित्ःणां परमं गुह्यमिदं भूमौ नरेश्वर॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004398014, "chapter_id": 24398, "verse_number": "५-३-९२-१५", "content_sanskrit": "ददतामक्षयं सर्वं यमहास्ये न संशयः ।\nअमावास्यां जितक्रोधो यस्तु पूजयते द्विजान्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004398015, "chapter_id": 24398, "verse_number": "५-३-९२-१६", "content_sanskrit": "हिरण्यभूमिदानेन तिलदानेन भूयसा ।\nकृष्णाजिनप्रदानेन तिलधेनुप्रदानतः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004398016, "chapter_id": 24398, "verse_number": "५-३-९२-१७", "content_sanskrit": "विधानोक्तद्विजाग्र्याय ये प्रदास्यन्ति भक्तितः ।\nहयं वा कुंजरं वाथ धूर्वहौ सीरसंयुतौ॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004398017, "chapter_id": 24398, "verse_number": "५-३-९२-१८", "content_sanskrit": "कन्यां वसुमतीं गां च महिषीं वा पयस्विनीम् ।\nददते ये नृपश्रेष्ठ नोपसर्पन्ति ते यमम्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004398018, "chapter_id": 24398, "verse_number": "५-३-९२-१९", "content_sanskrit": "यमोऽपि भवति प्रीतः प्रतिजन्म युधिष्ठिर ।\nयमस्य वाहो महिषो महिष्यस्तस्य मातरः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004398019, "chapter_id": 24398, "verse_number": "५-३-९२-२०", "content_sanskrit": "तासां दानप्रभावेण यमः प्रीतो भवेद्ध्रुवम् ।\nनासौ यममवाप्नोति यदि पापैः समावृतः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004398020, "chapter_id": 24398, "verse_number": "५-३-९२-२१", "content_sanskrit": "एतस्मात्कारणादत्र महिषीदानमुत्तमम् ।\nतस्याः शृङ्गे जलं कार्यं धूम्रवस्त्रानुवेष्टिता॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004398021, "chapter_id": 24398, "verse_number": "५-३-९२-२२", "content_sanskrit": "आयसस्य खुराः कार्यास्ताम्रपृष्ठाः सुभूषिताः ।\nलवणाचलं पूर्वस्यामाग्नेय्यां गुडपर्वतम्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004398022, "chapter_id": 24398, "verse_number": "५-३-९२-२३", "content_sanskrit": "कार्पासं याम्यभागं तु नवनीतं तु नैरृते ।\nपश्चिमे सप्तधान्यानि वायव्ये तंदुलाः स्मृताः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004398023, "chapter_id": 24398, "verse_number": "५-३-९२-२४", "content_sanskrit": "सौम्ये तु काञ्चनं दद्यादीशाने घृतमेव च ।\nप्रदद्याद्यमराजो मे प्रीयतामित्युदीरयन्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004398024, "chapter_id": 24398, "verse_number": "५-३-९२-२५", "content_sanskrit": "इत्युच्चार्य द्विजस्याग्रे यमलोकं महाभयम् ।\nअसिपत्त्रवनं घोरं यमचुल्ली सुदारुणा॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004398025, "chapter_id": 24398, "verse_number": "५-३-९२-२६", "content_sanskrit": "रौद्रा वैतरणी चैव कुम्भीपाको भयावहः ।\nकालसूत्रो महाभीमस्तथा यमलपर्वतौ॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004398026, "chapter_id": 24398, "verse_number": "५-३-९२-२७", "content_sanskrit": "क्रकचं तैलयन्त्रं च श्वानो गृध्राः सुदारुणाः ।\nनिरुच्छ्वासा महानादा भैरवो रौरवस्तथा॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004398027, "chapter_id": 24398, "verse_number": "५-३-९२-२८", "content_sanskrit": "एते घोरा याम्यलोके श्रूयन्ते द्विजसत्तम ।\nत्वत्प्रसादेन ते सोम्यास्तीर्थस्यास्य प्रभावतः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004398028, "chapter_id": 24398, "verse_number": "५-३-९२-२९", "content_sanskrit": "दानस्यास्य प्रभावेण यमराजप्रसादतः ।\nनरकेऽहं न यास्यामि द्विज जन्मनि जन्मनि॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004398029, "chapter_id": 24398, "verse_number": "५-३-९२-३०", "content_sanskrit": "यमहास्यस्य चाख्यानमिदं शृण्वन्ति ये नराः ।\nतेऽपि पापविनिर्मुक्ता न पश्यन्ति यमालयम्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]