[{"id": 2075649, "chapter_id": 2601, "verse_number": "१२-१०६-०x", "content_sanskrit": "राजोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2075650, "chapter_id": 2601, "verse_number": "१२-१०६-१", "content_sanskrit": "न निकृत्या न दम्भेन ब्रह्मन्निच्छामि जीवितुम्।\nनाधर्मयुक्तानिच्छेयमर्थान्सुमहतोऽप्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2075651, "chapter_id": 2601, "verse_number": "१२-१०६-२", "content_sanskrit": "पुरस्तादेव भगवन्मयैतदपवर्जितम्।\nयेन पापं न शङ्केत यद्वा कृत्स्नं हितं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2075652, "chapter_id": 2601, "verse_number": "१२-१०६-३", "content_sanskrit": "आनृशंस्येन धर्मेण लोके ह्यस्मिञ्जिजीविषुः।\nनाहमेतदलं कर्तुं नैतन्मय्युपपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2075653, "chapter_id": 2601, "verse_number": "१२-१०६-४x", "content_sanskrit": "मुनिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2075654, "chapter_id": 2601, "verse_number": "१२-१०६-४", "content_sanskrit": "उपपन्नस्त्वमेतेन यथा क्षत्रिय भाषसे।\nप्रकृत्या ह्युपपन्नोऽसि बुद्ध्या चाद्भुतदर्शनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2075655, "chapter_id": 2601, "verse_number": "१२-१०६-५", "content_sanskrit": "उभयोरेव साह्यार्थे यतिष्ये तव तस्य च।\nसंश्लेषं वा करिष्यामि शाश्वतं ह्यनपायिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2075656, "chapter_id": 2601, "verse_number": "१२-१०६-६", "content_sanskrit": "त्वादृशं हि कुले जातभनृशंसं बहुश्रुतम्।\nअमात्यं को न कुर्वीत राज्यप्रणयकोविदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2075657, "chapter_id": 2601, "verse_number": "१२-१०६-७", "content_sanskrit": "यस्त्वं प्रव्राजितो राज्याद्व्यसनं चोत्तमं गतः।\nआनृशंस्येन वृत्तेन क्षत्रियेच्छसि जीवितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2075658, "chapter_id": 2601, "verse_number": "१२-१०६-८", "content_sanskrit": "आगन्ता मद्गृहं तात वैदेहः सत्यसंगरः।\nअथाहं तं नियोक्ष्यामि तत्करिष्यत्यसंशयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2075659, "chapter_id": 2601, "verse_number": "१२-१०६-९x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2075660, "chapter_id": 2601, "verse_number": "१२-१०६-९", "content_sanskrit": "तत आहूय वैदेहं मुनिर्वचनमब्रवीत्।\nअयं राजकुले जातो विदिताभ्यन्तरो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2075661, "chapter_id": 2601, "verse_number": "१२-१०६-१०", "content_sanskrit": "आदर्श इव शुद्धात्मा शारदश्चन्द्रमा यथा।\nनास्मिन्पश्यामि वृजिनं सर्वतो मे परीक्षितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2075662, "chapter_id": 2601, "verse_number": "१२-१०६-११", "content_sanskrit": "तेन ते संधिरेवास्तु विश्वसास्मिन्यथा मयि।\nन राज्यमनमात्येन शक्यं शास्तुममित्रहन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2075663, "chapter_id": 2601, "verse_number": "१२-१०६-१२", "content_sanskrit": "अमात्य शुद्ध एव स्याद्बुद्धिसंपन्न एव वा।\nतस्माच्चैव भयं राज्ञः पश्य राज्यस्य योजनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2075664, "chapter_id": 2601, "verse_number": "१२-१०६-१३", "content_sanskrit": "धर्मात्मनां क्वचिल्लोके नान्यास्ति गतिरीदृशी।\nतदा राजपुत्रोऽयं सतां मार्गमनुष्ठितः।\nअसंगृहीतस्त्वेवैष त्वया धर्मपुरोगमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2075665, "chapter_id": 2601, "verse_number": "१२-१०६-१४", "content_sanskrit": "संसेव्यमानः शत्रूंस्ते गृह्णीयान्महतो गणान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2075666, "chapter_id": 2601, "verse_number": "१२-१०६-१५", "content_sanskrit": "यद्ययं प्रतियुद्ध्येत स्वकर्म क्षत्रियस्य तत्।\nजिगीषमाणस्त्वां युद्धे पितृपैतामहे पदे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2075667, "chapter_id": 2601, "verse_number": "१२-१०६-१६", "content_sanskrit": "त्वं अपि प्रतियुद्ध्येथा विजिगीषुर्व्रते स्थितः।\nअयुद्ध्वैव नियोगान्मे वशे कुरु हिते स्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2075668, "chapter_id": 2601, "verse_number": "१२-१०६-१७", "content_sanskrit": "स त्वं धर्ममवेक्षस्व हित्वा लोभमसांप्रतम्।\nन च कामान्न च द्रोहात्स्वधर्मं हातुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2075669, "chapter_id": 2601, "verse_number": "१२-१०६-१८", "content_sanskrit": "नैव नित्यं जयस्तात नैव नित्यं पराजयः।\nतस्माज्जयश्च भोक्तव्यो भोक्तव्यश्च पराजयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2075670, "chapter_id": 2601, "verse_number": "१२-१०६-१९", "content_sanskrit": "आत्मन्यपि च संदृश्यावृभौ जयपराजयौ।\nनिःशेषकारिणां तात निःशेषकरणाद्भयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2075671, "chapter_id": 2601, "verse_number": "१२-१०६-२०", "content_sanskrit": "इत्युक्तः प्रत्युवाचेदं वचनं ब्राह्मणर्षभम्।\nप्रतिपूज्याभिसत्कृत्य पूजार्हमनुमान्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2075672, "chapter_id": 2601, "verse_number": "१२-१०६-२१", "content_sanskrit": "यथा ब्रूयान्महाप्राज्ञो यथा ब्रूयान्महाश्रुतः।\nश्रेयस्कामो यथा ब्रूयादुभयोरेव तत्क्षमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2075673, "chapter_id": 2601, "verse_number": "१२-१०६-२२", "content_sanskrit": "यद्यद्वचनमुक्तोऽस्मि करिष्यामि च तत्तथा।\nएतद्धि परमं श्रेयो न मेऽत्रास्ति विचारणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2075674, "chapter_id": 2601, "verse_number": "१२-१०६-२३", "content_sanskrit": "ततः कौसल्यमाहूय मैथिलो वाक्यमब्रवीत्।\nधर्मतो बुद्धितश्चैव बलेन च जितं मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2075675, "chapter_id": 2601, "verse_number": "१२-१०६-२४", "content_sanskrit": "अहं त्वया चात्मगुणैर्जितः पार्थिवसत्तम।\nआत्मानमनवज्ञाय जितवद्वर्ततां भवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2075676, "chapter_id": 2601, "verse_number": "१२-१०६-२५", "content_sanskrit": "नावमन्यामि ते बुद्धिं नावमन्ये च पौरुषम्।\nनावमन्ये जयामीति जितवद्वर्ततां भवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2075677, "chapter_id": 2601, "verse_number": "१२-१०६-२६", "content_sanskrit": "यथावत्पूजितो राजन्गृहं गन्तासि मे गृहात्।\nततः संपूज्य तौ विप्रं विश्वस्तौ जग्मतुर्गृहान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2075678, "chapter_id": 2601, "verse_number": "१२-१०६-२७", "content_sanskrit": "वैदेहस्त्वथ कौसल्यं प्रवेश्य गृहमञ्जसा।\nप्राद्यार्ध्यमधुपर्कैस्तं पूजार्हं प्रत्यपूजयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2075679, "chapter_id": 2601, "verse_number": "१२-१०६-२८", "content_sanskrit": "ददौ दुहितरं चास्मै रत्नानि विविधानि च।\nएष राज्ञां परो धर्मः समौ जयपराजयौ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2075680, "chapter_id": 2601, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि ष़डधिकशततमोऽध्यायः॥ १०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]