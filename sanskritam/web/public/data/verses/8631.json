[{"id": 900008401, "chapter_id": 8631, "verse_number": "12.1", "content_sanskrit": "अत्राधिवेदगता गायत्र्यादिशब्दा उदाहरणम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900008402, "chapter_id": 8631, "verse_number": "12.2", "content_sanskrit": "अत्र गायत्री किं छन्दः किं वा विष्णुरिति चिन्ता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900008403, "chapter_id": 8631, "verse_number": "12.3", "content_sanskrit": "प्रमेयाश्रिता तु..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900008404, "chapter_id": 8631, "verse_number": "12.4", "content_sanskrit": "तत्राद्या शङ्का ‘‘चेतोर्पणनिगदात्’’ इति सूत्रे..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900008405, "chapter_id": 8631, "verse_number": "12.5", "content_sanskrit": "अनादीनां गुणादीनां यथा गुण्यादितन्त्रता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900008406, "chapter_id": 8631, "verse_number": "12.6", "content_sanskrit": "यद्यप्यनादिस्वभावस्येशाधीनतामनुक्त्वाऽपि..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900008407, "chapter_id": 8631, "verse_number": "12.7", "content_sanskrit": "अत्रोभाभ्यामुक्तं चतुस्सूत्र्येकमधिकरणम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900008408, "chapter_id": 8631, "verse_number": "12.8", "content_sanskrit": "अस्माकं मते षाड्विध्यं तु ‘‘गायत्र्यां संस्थितो विष्णुः’’", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900008409, "chapter_id": 8631, "verse_number": "12.9", "content_sanskrit": "यच्च ‘‘उभयस्मिन्नप्यविरोधात्’’ इत्यस्य परकीयं व्याख्यानं ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900008410, "chapter_id": 8631, "verse_number": "12.10", "content_sanskrit": "भाष्ये ह्येवमभिप्रेतम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900008411, "chapter_id": 8631, "verse_number": "12.11", "content_sanskrit": "एवं च यथा चैत्रो ग्रामेऽस्तीत्युक्त्वा ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900008412, "chapter_id": 8631, "verse_number": "12.12", "content_sanskrit": "यच्चोक्तं परैर्जागरिते हि जीवस्य शरीरबाह्याकाशः स्थानम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}]