[{"id": 5000525000, "chapter_id": 9525, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे अष्टादशाधिकशततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000525001, "chapter_id": 9525, "verse_number": "६-११८-१", "content_sanskrit": "एतच्छ्रुत्वा शुभं वाक्यं पितामहसमीरितम्।\nअङ्केनादाय वैदेहीमुत्पपात विभावसुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000525002, "chapter_id": 9525, "verse_number": "६-११८-२", "content_sanskrit": "विधूयाथ चितां तां तु वैदेहीं हव्यवाहनः।\nउत्तस्थौ मूर्तिमानाशु गृहीत्वा जनकात्मजाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000525003, "chapter_id": 9525, "verse_number": "६-११८-३", "content_sanskrit": "तरुणादित्यसंकाशां तप्तकाञ्चनभूषणाम्।\nरक्ताम्बरधरां बालां नीलकुञ्चितमूर्धजाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000525004, "chapter_id": 9525, "verse_number": "६-११८-४", "content_sanskrit": "अक्लिष्टमाल्याभरणां तथारूपामनिन्दिताम्।\nददौ रामाय वैदेहीमङ्के कृत्वा विभावसुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000525005, "chapter_id": 9525, "verse_number": "६-११८-५", "content_sanskrit": "अब्रवीत् तु तदा रामं साक्षी लोकस्य पावकः।\nएषा ते राम वैदेही पापमस्यां न विद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000525006, "chapter_id": 9525, "verse_number": "६-११८-६", "content_sanskrit": "नैव वाचा न मनसा नैव बुद्ध्या न चक्षुषा।\nसुवृत्ता वृत्तशौटीर्यं न त्वामत्यचरच्छुभा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000525007, "chapter_id": 9525, "verse_number": "६-११८-७", "content_sanskrit": "रावणेनापनीतैषा वीर्योत्सिक्तेन रक्षसा।\nत्वया विरहिता दीना विवशा निर्जने सती ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000525008, "chapter_id": 9525, "verse_number": "६-११८-८", "content_sanskrit": "रुद्धा चान्तःपुरे गुप्ता त्वच्चित्ता त्वत्परायणा।\nरक्षिता राक्षसीभिश्च घोराभिर्घोरबुद्धिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000525009, "chapter_id": 9525, "verse_number": "६-११८-९", "content_sanskrit": "प्रलोभ्यमाना विविधं तर्ज्यमाना च मैथिली।\nनाचिन्तयत तद्रक्षस्त्वद‍्गतेनान्तरात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000525010, "chapter_id": 9525, "verse_number": "६-११८-१०", "content_sanskrit": "विशुद्धभावां निष्पापां प्रतिगृह्णीष्व मैथिलीम्।\nन किंचिदभिधातव्या अहमाज्ञापयामि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000525011, "chapter_id": 9525, "verse_number": "६-११८-११", "content_sanskrit": "ततः प्रीतमना रामः श्रुत्वैवं वदतां वरः।\nदध्यौ मुहूर्तं धर्मात्मा हर्षव्याकुललोचनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000525012, "chapter_id": 9525, "verse_number": "६-११८-१२", "content_sanskrit": "एवमुक्तो महातेजा धृतिमानुरुविक्रमः।\nउवाच त्रिदशश्रेष्ठं रामो धर्मभृतां वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000525013, "chapter_id": 9525, "verse_number": "६-११८-१३", "content_sanskrit": "अवश्यं चापि लोकेषु सीता पावनमर्हति।\nदीर्घकालोषिता हीयं रावणान्तःपुरे शुभा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000525014, "chapter_id": 9525, "verse_number": "६-११८-१४", "content_sanskrit": "बालिशो बत कामात्मा रामो दशरथात्मजः।\nइति वक्ष्यति मां लोको जानकीमविशोध्य हि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000525015, "chapter_id": 9525, "verse_number": "६-११८-१५", "content_sanskrit": "अनन्यहृदयां सीतां मच्चित्तपरिरक्षिणीम्।\nअहमप्यवगच्छामि मैथिलीं जनकात्मजाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000525016, "chapter_id": 9525, "verse_number": "६-११८-१६", "content_sanskrit": "इमामपि विशालाक्षीं रक्षितां स्वेन तेजसा।\nरावणो नातिवर्तेत वेलामिव महोदधिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000525017, "chapter_id": 9525, "verse_number": "६-११८-१७", "content_sanskrit": "प्रत्ययार्थं तु लोकानां त्रयाणां सत्यसंश्रयः।\nउपेक्षे चापि वैदेहीं प्रविशन्तीं हुताशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000525018, "chapter_id": 9525, "verse_number": "६-११८-१८", "content_sanskrit": "न हि शक्तः सुदुष्टात्मा मनसापि हि मैथिलीम्।\nप्रधर्षयितुमप्राप्यां दीप्तामग्निशिखामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000525019, "chapter_id": 9525, "verse_number": "६-११८-१९", "content_sanskrit": "नेयमर्हति वैक्लव्यं रावणान्तःपुरे सती।\nअनन्या हि मया सीता भास्करस्य प्रभा यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000525020, "chapter_id": 9525, "verse_number": "६-११८-२०", "content_sanskrit": "विशुद्धा त्रिषु लोकेषु मैथिली जनकात्मजा।\nन विहातुं मया शक्या कीर्तिरात्मवता यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000525021, "chapter_id": 9525, "verse_number": "६-११८-२१", "content_sanskrit": "अवश्यं च मया कार्यं सर्वेषां वो वचो हितम्।\nस्निग्धानां लोकनाथानामेवं च वदतां हितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000525022, "chapter_id": 9525, "verse_number": "६-११८-२२", "content_sanskrit": "इत्येवमुक्त्वा विजयी महाबलः\nप्रशस्यमानः स्वकृतेन कर्मणा।\nसमेत्य रामः प्रियया महायशाः\nसुखं सुखार्होऽनुबभूव राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000525023, "chapter_id": 9525, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे अष्टादशाधिकशततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]