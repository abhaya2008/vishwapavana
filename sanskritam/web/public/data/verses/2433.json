[{"id": 2068286, "chapter_id": 2433, "verse_number": "९-५१-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2068287, "chapter_id": 2433, "verse_number": "९-५१-१", "content_sanskrit": "तस्मिन्नेव तु धर्मात्मा वसति स्म तपोधनः।\nगार्हिस्थ्यं धर्ममास्थाय ह्यसितो देवलः पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2068288, "chapter_id": 2433, "verse_number": "९-५१-२", "content_sanskrit": "धर्मनित्यः शुचिर्दान्तो यज्ञशीलो महातपाः।\nकर्मणा मनसा वाचा समः सर्वेषु जन्तुषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2068289, "chapter_id": 2433, "verse_number": "९-५१-३", "content_sanskrit": "अक्रोधनो महाराज तुल्यनिन्दात्मसंस्तुतिः।\nप्रियाप्रिये तुल्यवृत्तिर्यमवत्समदर्शनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2068290, "chapter_id": 2433, "verse_number": "९-५१-४", "content_sanskrit": "काञ्चने लोष्ठके चैव समदर्शी महातपाः।\nदेवानपूजयन्नित्यमतिथींश्च द्विजैः सह।\nब्रह्मचर्यरतो नित्यं सदा धर्मपरायणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2068291, "chapter_id": 2433, "verse_number": "९-५१-५", "content_sanskrit": "ततोऽभ्येत्य महाभाग योगमास्थाय भिक्षुकः।\nजैगीषव्यो मुनिर्धीमांस्तस्मिंस्तीर्थे समाहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2068292, "chapter_id": 2433, "verse_number": "९-५१-६", "content_sanskrit": "देवलस्याश्रमे राजन्न्यवसत्स महाद्युतिः।\nयोगनित्यो महाराज सिद्धिं प्राप्तो महातपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2068293, "chapter_id": 2433, "verse_number": "९-५१-७", "content_sanskrit": "तं तत्र वसमानं तु जैगीषव्यं महामुनिम्।\nदेवलो दर्शयन्नेव नैवायुञ्जत धर्मतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2068294, "chapter_id": 2433, "verse_number": "९-५१-८", "content_sanskrit": "एवं तयोर्महाराज दीर्घकालो व्यतिक्रमत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2068295, "chapter_id": 2433, "verse_number": "९-५१-९", "content_sanskrit": "जैगीषव्यो मुनिस्तं तु ददर्शाथ स केवलम्।\nआहारकाले मतिमान्परिव्राड् जमेजय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2068296, "chapter_id": 2433, "verse_number": "९-५१-१०", "content_sanskrit": "उपातिष्ठत धर्मज्ञो भैक्षकाले स देवलम्।\nगौरवं परमं चक्रे प्रीतिं च विपुलां तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2068297, "chapter_id": 2433, "verse_number": "९-५१-११", "content_sanskrit": "देवलस्तु यथाशक्ति पूजयामास भारत।\nऋषिदृष्टेन विधिना समा बहीः समाहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2068298, "chapter_id": 2433, "verse_number": "९-५१-१२", "content_sanskrit": "कदाचित्तस्य नृयते देवलस्य महात्मनः।\nचिन्ता सुमहती जाता मुनिं दृष्ट्वा महाद्युतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2068299, "chapter_id": 2433, "verse_number": "९-५१-१३", "content_sanskrit": "समास्तु समतिक्रान्ता बह्व्यः पूजयतो मम।\nन चायमलसो भिक्षुरभ्यभाषत किञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2068300, "chapter_id": 2433, "verse_number": "९-५१-१४", "content_sanskrit": "एवं विगणयन्नेव स जगाम महोदधिम्।\nअन्तरिक्षचरः श्रीमान्कलशं गृह्य देवलं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2068301, "chapter_id": 2433, "verse_number": "९-५१-१५", "content_sanskrit": "गच्छन्नेव स धर्मात्मा समुद्रं सरितां परिम्।\nजैगीषव्यं ततोऽपश्यद्रतं प्रागेव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2068302, "chapter_id": 2433, "verse_number": "९-५१-१६", "content_sanskrit": "ततः सविस्मयश्चिन्तां जगामाथामितप्रभः।\nकथं सिक्षुरचं प्राप्तः समुद्रे स्नात एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2068303, "chapter_id": 2433, "verse_number": "९-५१-१७", "content_sanskrit": "इत्येवं चिन्तयामास महर्षिरसितस्तदा।\nस्नात्वा सखुद्रे विधिवच्छुचिर्जप्यं जजाप सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2068304, "chapter_id": 2433, "verse_number": "९-५१-१८", "content_sanskrit": "कृतजxxxxx श्रीमानाश्रयं च जगाम ह।\nxxxxxxxxxx गृहीत्वा जनमेजय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2068305, "chapter_id": 2433, "verse_number": "९-५१-१९", "content_sanskrit": "ततः स प्रविशन्नेव स्वमाश्रमपदं मुनिः।\nxxxxxxxxx तत्र जैगीषव्यमपश्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2068306, "chapter_id": 2433, "verse_number": "९-५१-२०", "content_sanskrit": "न व्याहरति चैवेनं जैगीषव्यः कथञ्चन।\nxxxxxxxx वसति स्म महातपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2068307, "chapter_id": 2433, "verse_number": "९-५१-२१", "content_sanskrit": "तं दृष्ट्वा चाप्लुतं तोये सामरे सागरोपमम्।\nप्रविष्टxxxxx चापि पूर्वमेव ददर्श सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2068308, "chapter_id": 2433, "verse_number": "९-५१-२२", "content_sanskrit": "xxxxx देवलो राजंश्चिन्तयामास बुद्धिमान्।\nxxxxxxx तपसो जैगीषव्यास्व योगजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2068309, "chapter_id": 2433, "verse_number": "९-५१-२३", "content_sanskrit": "चिन्तयामास राजेन्द्र तदा स मुनिसत्तमः।\nमया दृष्टः समुद्रे च आश्रमे च कथंन्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2068310, "chapter_id": 2433, "verse_number": "९-५१-२४", "content_sanskrit": "एवं विगणयन्नेव स मुनिर्मन्त्रपारगः।\nउत्पपाताश्रमात्तस्मादन्तरिक्षं विशाम्पते।\nजिज्ञासार्थं तदा भिक्षोर्जैगीषव्यस्य देवलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2068311, "chapter_id": 2433, "verse_number": "९-५१-२५", "content_sanskrit": "सोऽन्तरिक्षचरान्सिद्धान्समपश्यत्समाहितान्।\nजैगीषव्यं च तैः सिद्धैः पूज्यमानमपश्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2068312, "chapter_id": 2433, "verse_number": "९-५१-२६", "content_sanskrit": "ततोऽसितः सुसंरब्धो व्यवसायी दृढव्रतः।\nअपश्यद्वै दिवं यातं जैगीषव्यं स देवलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2068313, "chapter_id": 2433, "verse_number": "९-५१-२७", "content_sanskrit": "तस्माच्च पितृलोकं तं व्रजन्तं सोऽन्वपश्यत।\nपितृलोकाच्च तं यातं याम्यं लोकमपश्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2068314, "chapter_id": 2433, "verse_number": "९-५१-२८", "content_sanskrit": "`तस्मादादित्यलोकं च व्रजन्तं सोऽन्वपश्यत।\nतस्मादपि समुत्पत्य सोमलोकमभिष्टुतम्।\nव्रजन्तमन्वपश्यत्स जैगीषव्यं स देवलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2068315, "chapter_id": 2433, "verse_number": "९-५१-२९", "content_sanskrit": "लोकान्समुत्पतन्तं तु शुभानेकान्तयाजिनाम्।\nततोऽग्निहोत्रिणां लोकांस्ततश्चाप्युत्पपात ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2068316, "chapter_id": 2433, "verse_number": "९-५१-३०", "content_sanskrit": "दर्शं च पौर्णमासं च ये यजन्ति तपोधनाः।\nतेभ्यः स ददृशे धीमाँल्लोकेभ्यः पशुयाजिनाम्।\nव्रजन्तं लोकममलमपश्यद्देवपूजितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2068317, "chapter_id": 2433, "verse_number": "९-५१-३१", "content_sanskrit": "चातुर्मास्यैर्बहुविधैर्यजन्ते ये तपोधनाः।\nतेषां स्थानं ततो यतां तथाऽग्निष्टोमयाजिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2068318, "chapter_id": 2433, "verse_number": "९-५१-३२", "content_sanskrit": "अग्निष्टुतेन च तथा ये यजन्ति तपोधनः।\nतत्स्थानमनुसम्प्राप्तमन्वपश्यत देवलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2068319, "chapter_id": 2433, "verse_number": "९-५१-३३", "content_sanskrit": "वाजपेयं क्रतुवरं तथा बहुसुवर्णकम्।\nआहरन्ति महाप्राज्ञास्तेषां लोकेष्वपश्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2068320, "chapter_id": 2433, "verse_number": "९-५१-३४", "content_sanskrit": "यजन्ते राजसूयेन पुण्डरीकेण चैव ये।\nतेषां लोकेष्वपश्यच्च जैगीषव्यं स देवलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2068321, "chapter_id": 2433, "verse_number": "९-५१-३५", "content_sanskrit": "अश्वमेधं क्रतुवरं नरमेधं तथैव च।\nआहरन्ति नरश्रेष्ठास्तेषां लोकेष्वपश्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2068322, "chapter_id": 2433, "verse_number": "९-५१-३६", "content_sanskrit": "सर्वमेधं च दुष्प्रापं तथा सौत्रामणिं च ये।\nतेषां लोकेष्वपश्यच्च जैगीषव्यं स देवलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2068323, "chapter_id": 2433, "verse_number": "९-५१-३७", "content_sanskrit": "द्वादशाहैश्च सत्रैश्च यजन्ते विविधैर्नृप।\nतेषां लोकेष्वपश्यच्च जैगीषव्यं स देवलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2068324, "chapter_id": 2433, "verse_number": "९-५१-३८", "content_sanskrit": "मैत्रावरुणयोर्लोकानादित्यानां तथैव च।\nसलोकतामनुप्राप्तमपश्यत ततोऽसितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2068325, "chapter_id": 2433, "verse_number": "९-५१-३९", "content_sanskrit": "रुद्राणां च वसूनां च स्थानं यच्च बृहस्पतेः।\nतानिं सर्वाण्यतीतं च समपश्यत्ततोऽसितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2068326, "chapter_id": 2433, "verse_number": "९-५१-४०", "content_sanskrit": "आरुह्य च गवां लोकं प्रयान्तं ब्रह्मसत्रिणाम्।\nलोकानपश्यद्गच्छन्तं जैगीषव्यं ततोऽसितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2068327, "chapter_id": 2433, "verse_number": "९-५१-४१", "content_sanskrit": "त्रील्लोँकान्प्रवरान्विप्रमुत्पतन्तं स्वतेजसा।\nपतिव्रतानां लोकांश्च व्रजन्तं सोऽन्वपश्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2068328, "chapter_id": 2433, "verse_number": "९-५१-४२", "content_sanskrit": "ततो मुनिवरं भूयो जैगीषव्यमथासितः।\nनान्वपश्यत लोकस्थमन्तर्हितमरिन्दम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2068329, "chapter_id": 2433, "verse_number": "९-५१-४३", "content_sanskrit": "सोऽचिन्तयन्महाभागो जैगीषव्यस्य देवलः।\nप्रभावं सुव्रतत्वं च सिद्धिं योगस्य चातुलाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2068330, "chapter_id": 2433, "verse_number": "९-५१-४४", "content_sanskrit": "असितोऽपृच्छत तदा सिद्धाँल्लोकेषु सत्तमान्।\nप्रयतः प्राञ्जलिर्भूत्वा धीरस्तान्ब्रह्मचारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2068331, "chapter_id": 2433, "verse_number": "९-५१-४५", "content_sanskrit": "जैगीषव्यं न पश्यामि तं शंसन्तु तपोधनाः।\nएतदिच्छाम्यहं श्रोतुं परं कौतूहलं हि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2068332, "chapter_id": 2433, "verse_number": "९-५१-४६x", "content_sanskrit": "सिद्धा ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2068333, "chapter_id": 2433, "verse_number": "९-५१-४६", "content_sanskrit": "शृणु देवल भूतार्थं शंसतां नो दृढव्रत।\nजैगीषव्यो गतो लोकं शाश्वतं ब्रह्मणोक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2068334, "chapter_id": 2433, "verse_number": "९-५१-४७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2068335, "chapter_id": 2433, "verse_number": "९-५१-४७", "content_sanskrit": "स श्रुत्वा वचनं तेषां सिद्धानां ब्रह्मचारिणाम्।\nअसिता देवलस्तूर्णमुत्पपात पपात च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2068336, "chapter_id": 2433, "verse_number": "९-५१-४८", "content_sanskrit": "ततः सिद्धास्त ऊचुर्हि देवलं पुनरेव ह।\nन देवलगतिस्तत्र तव गन्तुं तपोधन।\nब्रह्मणः सदने विप्र जैगीषव्यो यदाप्तवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2068337, "chapter_id": 2433, "verse_number": "९-५१-४९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2068338, "chapter_id": 2433, "verse_number": "९-५१-४९", "content_sanskrit": "तेषां तद्वचनं श्रुत्वा सिद्धानां देवलः पुनः।\nआनुपूर्व्येण लोकांस्तान्सर्वानवततार ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2068339, "chapter_id": 2433, "verse_number": "९-५१-५०", "content_sanskrit": "स्वमाश्रमपदं पुण्यमाजगाम पतङ्गवत्।\nप्रविशन्नेव चापश्यज्जैगीषव्यं स देवलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2068340, "chapter_id": 2433, "verse_number": "९-५१-५१", "content_sanskrit": "ततो बुद्ध्या व्यगणयद्देवलो धर्मयुक्तया।\nदृष्ट्वा प्रभावं तपसो जैगीषव्यस्य योगजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2068341, "chapter_id": 2433, "verse_number": "९-५१-५२", "content_sanskrit": "ततोऽब्रविन्महात्मानं जैगीषव्यं स देवलः।\nविनयावनतो राजन्नुपसर्प्य महामुनिम्।\nमोक्षधर्मं समास्थातुमिच्छेयं भगवन्नहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2068342, "chapter_id": 2433, "verse_number": "९-५१-५३", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा उपदेशं चकार सः।\nविधिं योगस्य परमं कार्याकार्यस्य शास्त्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2068343, "chapter_id": 2433, "verse_number": "९-५१-५४", "content_sanskrit": "सन्नाये कृतबुद्धिं तं ततो दृष्ट्वा महातपाः।\nसर्वाश्चास्य क्रियाश्चक्रे विधिदृष्टेन कर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2068344, "chapter_id": 2433, "verse_number": "९-५१-५५", "content_sanskrit": "सन्न्यासे कृतबुद्धिं तं भूतानि पितृभिः सह।\nततो दृष्ट्वा प्ररुरुदुः कोऽस्मान्संविभजिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2068345, "chapter_id": 2433, "verse_number": "९-५१-५६", "content_sanskrit": "देवलस्तु वचः श्रुत्वा भूतानां करुणं तथा।\nदिशो दश व्याहरतां मोक्षं त्यक्तुं मनो दधे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2068346, "chapter_id": 2433, "verse_number": "९-५१-५७", "content_sanskrit": "ततस्तु फलमूलानि पवित्राणि च भारत।\nपुष्पाण्योषधयश्चैव रोरूयन्ते सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2068347, "chapter_id": 2433, "verse_number": "९-५१-५८", "content_sanskrit": "पुनर्नो देवलः क्षुद्रो नूनं छेत्स्यति दुर्मतिः।\nअभयं सर्वभूतेभ्यो यो दत्त्वा नावबुध्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2068348, "chapter_id": 2433, "verse_number": "९-५१-५९", "content_sanskrit": "ततो भूयो व्यगणयत्स्वबुद्ध्या मुनिसत्तमः।\nमोक्षे गार्हस्थ्यधर्मे वा किन्नु श्रेयस्करं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2068349, "chapter_id": 2433, "verse_number": "९-५१-६०", "content_sanskrit": "इति निश्चित्य मनसा देवलो राजसत्तम।\nत्यक्त्वा गार्हस्थ्यधर्मं स मोक्षधर्ममरोचयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2068350, "chapter_id": 2433, "verse_number": "९-५१-६१", "content_sanskrit": "एवमादीनि सञ्चिन्त्य देवलो निश्चयान्वितः।\nप्राप्तवान्परमां सिद्धिं परं योगं च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2068351, "chapter_id": 2433, "verse_number": "९-५१-६२", "content_sanskrit": "ततो देवाः समागम्य बृहस्पतिपुरोगमाः।\nजैगीषव्यं तपश्चास्य प्रशंसन्ति तपस्विनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2068352, "chapter_id": 2433, "verse_number": "९-५१-६३", "content_sanskrit": "अथाब्रवीदृषिवरो देवान्वै नारदस्तथा।\nजैगीषव्ये तपो नास्ति विस्मापयति योऽसितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2068353, "chapter_id": 2433, "verse_number": "९-५१-६४", "content_sanskrit": "तमेवंवादिनं धीरं प्रत्यूचुस्ते दिवौकसः।\nनैवमित्येव शंसन्तो जैगीषव्यं महामुनिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2068354, "chapter_id": 2433, "verse_number": "९-५१-६५", "content_sanskrit": "नातः परतरं किञ्चित्तुल्यमस्ति प्रभावतः।\nतेजसस्तपसश्चास्य योगस्य च महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2068355, "chapter_id": 2433, "verse_number": "९-५१-६६", "content_sanskrit": "एवं प्रभावो धर्मात्मा जैगीषव्यस्तथाऽसितः।\nतयोरिदं स्थानवरं तीर्थं चैव महात्मनोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2068356, "chapter_id": 2433, "verse_number": "९-५१-६७", "content_sanskrit": "तत्राप्युपस्पृश्य ततो महात्मा\nदत्त्वा च वित्तं हलभृद्द्विजेभ्यः।\nअवाप्य धर्मं परमार्थकर्मा\nजगाम सोमस्य महाxxxxxxर्थम्। ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2068357, "chapter_id": 2433, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शल्यपर्वणि ह्रदप्रवेशपर्वणि एकपञ्चाशत्तमोऽध्यायः॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}]