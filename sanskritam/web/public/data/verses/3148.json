[{"id": 2100218, "chapter_id": 3148, "verse_number": "१४-४-१", "content_sanskrit": "युधिष्ठिर उवाच।\nशुश्रूषे तस्य धर्मज्ञ राजर्षेः परिकीर्तनम्।\nद्वैपायन मरुत्तस्य कथां प्रब्रूहि मेऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2100219, "chapter_id": 3148, "verse_number": "१४-४-२x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2100220, "chapter_id": 3148, "verse_number": "१४-४-२", "content_sanskrit": "आसीत्कृतयुगे तात मनुर्दण्डिधरः प्रभुः।\nतस्य पुत्रो महोष्वासः प्रजातिरभवन्नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2100221, "chapter_id": 3148, "verse_number": "१४-४-३", "content_sanskrit": "प्रजातेरभवत्पुत्रः क्षुत इत्यभिविश्रुतः।\nक्षुतस्य पुत्र इक्ष्वाकुर्महीपालोऽभवत्प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2100222, "chapter_id": 3148, "verse_number": "१४-४-४", "content_sanskrit": "तस्य पुत्रशतं राजन्नासीत्परमधार्मिकम्।\nतांस्तु सर्वान्महीपालानिक्ष्वाकुरकरोत्प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2100223, "chapter_id": 3148, "verse_number": "१४-४-५", "content_sanskrit": "तेषां ज्येष्ठस्तु विंशोऽभूत्प्रतिमानं धनुष्मताम्।\nविंशस्य पुत्रः कल्याणो विविंशो नाम भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2100224, "chapter_id": 3148, "verse_number": "१४-४-६", "content_sanskrit": "विविंशस्य सुता राजन्बभूवुर्दश पञ्च च।\nसर्वे धनुषि विक्रान्ता ब्रह्मण्याः सत्यवादिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2100225, "chapter_id": 3148, "verse_number": "१४-४-७", "content_sanskrit": "दानधर्मरताः शान्ताः सततं प्रियवादिनः।\nतेषां ज्येष्ठः खनीनेत्रः स तान्सर्वानपीडयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2100226, "chapter_id": 3148, "verse_number": "१४-४-८", "content_sanskrit": "खनीनेत्रस्तु विक्रान्तो जित्वा राज्यमकण्टकम्।\nनाशकद्रक्षितुं राज्यं नान्वरज्यन्त तं प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2100227, "chapter_id": 3148, "verse_number": "१४-४-९", "content_sanskrit": "तमपास्य च तद्राज्ये तस्य पुत्रं सुवर्चसम्।\nअभ्यषिञ्चन्त राजेन्द्र मुदिता ह्यभवंस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2100228, "chapter_id": 3148, "verse_number": "१४-४-१०", "content_sanskrit": "स पितुर्विक्रियां दृष्ट्वा राज्यान्निरसनं च तत्।\nनियतो वर्तयामास प्रजाहितचिकीर्षया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2100229, "chapter_id": 3148, "verse_number": "१४-४-११", "content_sanskrit": "ब्रह्मण्यः सत्यवादी च शुचिः शमदमान्वितः।\nप्रजास्तं चान्वरज्यन्त धर्मनित्यं मनस्विनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2100230, "chapter_id": 3148, "verse_number": "१४-४-१२", "content_sanskrit": "तस्य धर्मप्रवृत्तस्य व्यशीर्यत्कोशवाहनम्।\nतं क्षीणकोशं सामन्ताः समन्तात्पर्यपीडयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2100231, "chapter_id": 3148, "verse_number": "१४-४-१३", "content_sanskrit": "स पीड्यमानो बहुभिः क्षीणकोशाश्ववाहनः।\nआर्तिमार्च्छत्परां राजा सह भृत्यैः पुरेण च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2100232, "chapter_id": 3148, "verse_number": "१४-४-१४", "content_sanskrit": "न चैनमभिहन्तुं ते शक्नुवन्ति बलक्षये।\nसम्यग्वृत्तो हि राजा स धर्मनित्यो युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2100233, "chapter_id": 3148, "verse_number": "१४-४-१५", "content_sanskrit": "यदा तु परमामार्तिं गतोऽसौ सपुरो नृपः।\nततः प्रदध्मौ स करं प्रादुरासीत्ततो बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2100234, "chapter_id": 3148, "verse_number": "१४-४-१६", "content_sanskrit": "ततस्तानजयत्सर्वान्प्रातिसीमान्नराधिपान्।\nएतस्मात्कारणाद्राजन्विश्रुतः स करंधमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2100235, "chapter_id": 3148, "verse_number": "१४-४-१७", "content_sanskrit": "आवीक्षित्तस्य पुत्रोऽभूत्त्रेतायुगमुखे पुरा।\nइन्द्रादनवरः श्रीमान्देवैरपि सुदुर्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2100236, "chapter_id": 3148, "verse_number": "१४-४-१८", "content_sanskrit": "`कारंधम इति ख्यातो बभूव जगतीपतिः।\nतस्य सर्वे महीपाला वर्तन्ते स्म वशे तदा।\nस हि सम्राडभूत्तेषां वृत्तेन च बलेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2100237, "chapter_id": 3148, "verse_number": "१४-४-१९", "content_sanskrit": "अविक्षिन्नाम धर्मात्मा शौर्येणेन्द्रसमोऽभवत्।\nयज्ञशीलो धर्मरतिर्धृतिमान्संयतेन्द्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2100238, "chapter_id": 3148, "verse_number": "१४-४-२०", "content_sanskrit": "तेजसाऽऽदित्यसदृशः क्षमया पृथिवीसमः।\nबृहस्पतिसमो बुद्ध्या हिमवानिव सुस्थिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2100239, "chapter_id": 3148, "verse_number": "१४-४-२१", "content_sanskrit": "कर्मणा मनसा वाचा दमेन प्रशमेन च।\nमनांस्याराधयामास प्रजानां स महीपतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2100240, "chapter_id": 3148, "verse_number": "१४-४-२२", "content_sanskrit": "य ईजे हयमेधानां शतेन विधिवत्प्रभुः।\nयाजयामास यं विद्वान्स्वयमेवाङ्गिराः प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2100241, "chapter_id": 3148, "verse_number": "१४-४-२३", "content_sanskrit": "तस्य पुत्रोऽतिचक्राम पितरं गुणवत्तया।\nमरुत्तो नाम धर्मज्ञश्चक्रवर्ती महायशाः।\nनागायुतसमप्राणः साक्षाद्विष्णुरिवापरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2100242, "chapter_id": 3148, "verse_number": "१४-४-२४", "content_sanskrit": "स यक्ष्यमाणो धर्मात्मा शातकुम्भमयान्युत।\nकारयामास शुभ्राणि भाजनानि सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2100243, "chapter_id": 3148, "verse_number": "१४-४-२५", "content_sanskrit": "मेरुं पर्वतमासाद्य हिमवत्पार्श्व उत्तरे।\nकाञ्चनः सुमहान्पादस्तत्र कर्म चकार सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2100244, "chapter_id": 3148, "verse_number": "१४-४-२६", "content_sanskrit": "ततः कुण्डानि पात्रीश्च पिठराण्यासंनानि च।\nचक्रुः सुवर्णकर्तारो येषां सङ्ख्या न विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2100245, "chapter_id": 3148, "verse_number": "१४-४-२७", "content_sanskrit": "तस्यैव च समीपे तु यज्ञवाटो बभूव ह।\nईजे तत्र स धर्मात्मा विदिवत्पृथिवीपतिः।\nमरुत्तः सहितैः सर्वैः प्रजापालैर्नराधिपः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2100246, "chapter_id": 3148, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अश्वमेधपर्वणि चतुर्थाऽध्यायः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]