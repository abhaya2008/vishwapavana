[{"id": 6000267000, "chapter_id": 10267, "verse_number": null, "content_sanskrit": "अथ एकसप्ततिरध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000267001, "chapter_id": 10267, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_071/BhP_10.071.001.m4a", "display_order": 2}, {"id": 6000267002, "chapter_id": 10267, "verse_number": "१०-७१-१", "content_sanskrit": "तथाऽनुगृह्य भगवान् गोपीनां स गुरुर्गतिः।\nयुधिष्ठिरमथापृच्छत् सर्वांश्च सुहृदोऽव्ययम्॥ १०/७१/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_071/BhP_10.071.002.m4a", "display_order": 3, "topics": [{"text": "द्रौपद्याः कृष्णपत्नीभिःसाकं सम्भाषणम्", "range": "१–६"}]}, {"id": 6000267003, "chapter_id": 10267, "verse_number": "१०-७१-२", "content_sanskrit": "त एवं लोकनाथेन परिपृच्छ्य सुसत्कृताः।\nप्रत्यूचुर्हृष्टमनसस्तत्पादेक्षाहतांहसः॥ १०/७१/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_071/BhP_10.071.003.m4a", "display_order": 4}, {"id": 6000267004, "chapter_id": 10267, "verse_number": "१०-७१-३", "content_sanskrit": "कुतोऽशिवस्त्वच्चरणाम्बुजासवं महन्मनस्तो मुखनिःसृतं क्‍वचित्।\nपिबन्ति ये कर्णपुटैरलं प्रभो देहंभृतस्तत्कृतमुछ्वसन्ति हि॥ १०/७१/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_071/BhP_10.071.004.m4a", "display_order": 5}, {"id": 6000267005, "chapter_id": 10267, "verse_number": "१०-७१-४", "content_sanskrit": "तं त्वाऽऽत्मधामविबुधात्मगतिं त्र्यवस्थमानन्दसम्प्लवमखण्डविकुण्ठबोधम्।\nकालोपसृष्टनिगमावपनात्तयोगमायाकृतिं परमहंसगतिं नताः स्मः॥ १०/७१/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_071/BhP_10.071.005.m4a", "display_order": 6}, {"id": 6000267006, "chapter_id": 10267, "verse_number": "१०-७१-५", "content_sanskrit": "इत्युत्तमश्लोकशिखामणिं जनेष्वभिष्टुवत्स्वच्युतकौरवस्‍त्रियः।\nसमेत्य गोविन्दकथां मिथोऽगृणन् नृलोकगीतां शृणु वर्णयामि ते॥ १०/७१/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_071/BhP_10.071.006.m4a", "display_order": 7}, {"id": 6000267007, "chapter_id": 10267, "verse_number": null, "content_sanskrit": "द्रौपद्युवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_071/BhP_10.071.007.m4a", "display_order": 8}, {"id": 6000267008, "chapter_id": 10267, "verse_number": "१०-७१-६", "content_sanskrit": "हे वैदर्भ्यच्युतो भद्रे हे जाम्बवति कौसले।\nहे सत्यभामे कालिन्दि शैब्ये रोहिणि लक्षणे॥ १०/७१/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_071/BhP_10.071.008.m4a", "display_order": 9}, {"id": 6000267009, "chapter_id": 10267, "verse_number": "१०-७१-७", "content_sanskrit": "हे कृष्णपत्न्य एतन्नो ब्रूत वो भगवान् स्वयम्।\nउपयेमे यथा लोकमनुकुर्वन् स्वमायया॥ १०/७१/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_071/BhP_10.071.009.m4a", "display_order": 10, "topics": [{"text": "प्रत्येकं कृष्णपत्नीभिः विवाहसन्दर्भकथनञ्च", "range": "६–४३"}]}, {"id": 6000267010, "chapter_id": 10267, "verse_number": null, "content_sanskrit": "रुग्मिण्युवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_071/BhP_10.071.010.m4a", "display_order": 11}, {"id": 6000267011, "chapter_id": 10267, "verse_number": "१०-७१-८", "content_sanskrit": "चैद्याय माऽर्पयितुमुद्यतकार्मुकेषु राजस्वशेषभटशेखरिताङ्घ्रिरेणुः।\nनिन्ये मृगेन्द्र इव भागमजावियूथात् तच्छ्रीनिकेतचरणाब्जसमर्चनाय॥ १०/७१/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_071/BhP_10.071.011.m4a", "display_order": 12}, {"id": 6000267012, "chapter_id": 10267, "verse_number": null, "content_sanskrit": "सत्यभामोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_071/BhP_10.071.012.m4a", "display_order": 13}, {"id": 6000267013, "chapter_id": 10267, "verse_number": "१०-७१-९", "content_sanskrit": "यो मे सनाभिवधतप्तहृदा ततेन लिप्ताभिशापमपमार्ष्टुमुपाजहार।\nजित्वर्क्षराजमथ रत्नमदात् स तेन नीतच्छिदादिशत मां प्रभवेऽपि दत्ताम्॥ १०/७१/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_071/BhP_10.071.013.m4a", "display_order": 14}, {"id": 6000267014, "chapter_id": 10267, "verse_number": null, "content_sanskrit": "जाम्बवत्युवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_071/BhP_10.071.014.m4a", "display_order": 15}, {"id": 6000267015, "chapter_id": 10267, "verse_number": "१०-७१-१०", "content_sanskrit": "आज्ञाय देहविकृतिं निजनाथदैवं सीतापतिं त्रिनवहान्यमुनाऽभियुध्य।\nज्ञात्वाऽवधीरणमुपाहरदर्हणं मां पादौ प्रगृह्य मणिनाऽहममुष्य दासी॥ १०/७१/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_071/BhP_10.071.015.m4a", "display_order": 16}, {"id": 6000267016, "chapter_id": 10267, "verse_number": null, "content_sanskrit": "कालिन्द्युवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_071/BhP_10.071.016.m4a", "display_order": 17}, {"id": 6000267017, "chapter_id": 10267, "verse_number": "१०-७१-११", "content_sanskrit": "तपश्चरन्तीमाज्ञाय स्वपादस्पर्शकाम्यया।\nसख्योपेत्याग्रहीत् पाणिं योऽहं तद्गृहमार्जनी॥ १०/७१/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_071/BhP_10.071.017.m4a", "display_order": 18}, {"id": 6000267018, "chapter_id": 10267, "verse_number": null, "content_sanskrit": "मित्रविन्दोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_071/BhP_10.071.018.m4a", "display_order": 19}, {"id": 6000267019, "chapter_id": 10267, "verse_number": "१०-७१-१२", "content_sanskrit": "यो मां स्वयंवर उपेत्य विजित्य भूपान् निन्ये श्वयूथमिव चात्मबलिं द्विपारिः।\nभ्रातॄॄंश्च मेऽपकुरुतः स्वपुरं श्रियोऽगात् तस्यास्तु मेऽनुभवमङ्घ्र्यवनेजनाम्भः॥ १०/७१/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_071/BhP_10.071.019.m4a", "display_order": 20}, {"id": 6000267020, "chapter_id": 10267, "verse_number": null, "content_sanskrit": "नीलोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_071/BhP_10.071.020.m4a", "display_order": 21}, {"id": 6000267021, "chapter_id": 10267, "verse_number": "१०-७१-१३", "content_sanskrit": "सप्तोक्षणोऽतिबलवीर्यसुतीक्ष्णशृृङ्गान् पित्रा कृतान् क्षितिपवीर्यपरीक्षणाय।\nतान् वीरदुर्मदहनस्तरसा निगृह्य क्रीडन् बबन्ध ह यथा शिशवोऽजतोकान्॥ १०/७१/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_071/BhP_10.071.021.m4a", "display_order": 22}, {"id": 6000267022, "chapter_id": 10267, "verse_number": "१०-७१-१४", "content_sanskrit": "य इत्थं वीर्यशुल्कां मां दासीभिश्चतुरङ्गिणीम्।\nपथि निर्जित्य राजन्यान् निन्ये तद्दास्यमस्तु मे॥ १०/७१/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_071/BhP_10.071.022.m4a", "display_order": 23}, {"id": 6000267023, "chapter_id": 10267, "verse_number": null, "content_sanskrit": "भद्रोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_071/BhP_10.071.023.m4a", "display_order": 24}, {"id": 6000267024, "chapter_id": 10267, "verse_number": "१०-७१-१५", "content_sanskrit": "पिता मे मातुलेयाय स्वयमाहूय दत्तवान्।\nकृष्णे कृष्णाय तच्चित्तामक्षौहिण्या सखीजनैः॥ १०/७१/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_071/BhP_10.071.024.m4a", "display_order": 25}, {"id": 6000267025, "chapter_id": 10267, "verse_number": "१०-७१-१६", "content_sanskrit": "तस्य मे पादसंस्पर्शो भवेज्जन्मनि जन्मनि।\nकर्मभिर्भ्राम्यमाणाया येन तच्छ्रेय आत्मनः॥ १०/७१/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_071/BhP_10.071.025.m4a", "display_order": 26}, {"id": 6000267026, "chapter_id": 10267, "verse_number": null, "content_sanskrit": "लक्षणोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_071/BhP_10.071.026.m4a", "display_order": 27}, {"id": 6000267027, "chapter_id": 10267, "verse_number": "१०-७१-१७", "content_sanskrit": "ममापि राज्ञ्यच्युतजन्मकर्म च श्रुत्वा मुहुर्नारदगीतमास ह।\nचित्तं मुकुन्दे किल पद्महस्तया वृतः स्वयं यस्तु विहाय लोकपान्॥ १०/७१/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_071/BhP_10.071.027.m4a", "display_order": 28}, {"id": 6000267028, "chapter_id": 10267, "verse_number": "१०-७१-१८", "content_sanskrit": "ज्ञात्वा मम मतं साध्वि पिता दुहितृवत्सलः।\nबृहत्सेन इति ख्यातस्तत्रोपायमचीकरत्॥ १०/७१/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_071/BhP_10.071.028.m4a", "display_order": 29}, {"id": 6000267029, "chapter_id": 10267, "verse_number": "१०-७१-१९", "content_sanskrit": "यथा स्वयंवरे राज्ञि मत्स्यः पार्थेच्छया कृतः।\nअयं तु बहिराच्छन्नो दृश्यते स जले परम्॥ १०/७१/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_071/BhP_10.071.029.m4a", "display_order": 30}, {"id": 6000267030, "chapter_id": 10267, "verse_number": "१०-७१-२०", "content_sanskrit": "श्रुत्वैतत् सर्वतो भूपा आययुर्मत्पितुः पुरम्।\nसर्वास्‍त्रशस्‍त्रतत्त्वज्ञाः सोपाध्यायाः सहस्रशः॥ १०/७१/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_071/BhP_10.071.030.m4a", "display_order": 31}, {"id": 6000267031, "chapter_id": 10267, "verse_number": "१०-७१-२१", "content_sanskrit": "पित्रा सम्पूजिताः सर्वे यथावीर्यं यथावयः।\nआददुः सशरं चापं वेद्धुं पार्षति मद्धियः॥ १०/७१/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_071/BhP_10.071.031.m4a", "display_order": 32}, {"id": 6000267032, "chapter_id": 10267, "verse_number": "१०-७१-२२", "content_sanskrit": "आदाय व्यसृजन् केचित् सज्जीकर्तुमनीश्वराः।\nआकोट्यां ज्यां समाकृष्य पेतुरेकेऽमुना हताः॥ १०/७१/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_071/BhP_10.071.032.m4a", "display_order": 33}, {"id": 6000267033, "chapter_id": 10267, "verse_number": "१०-७१-२३", "content_sanskrit": "सज्यं कृत्वा परे वीराः प्राग्ज्योतिमगधेश्वरौ।\nभीमो दुर्योधनः कर्णो नाविन्दंस्तदवस्थितिम्॥ १०/७१/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_071/BhP_10.071.033.m4a", "display_order": 34}, {"id": 6000267034, "chapter_id": 10267, "verse_number": "१०-७१-२४", "content_sanskrit": "मत्स्याभासं जले दृष्ट्वा ज्ञात्वा च तदवस्थितिम्।\nपार्थो यत्तोऽसृजद्बाणान् नाच्छिनत् पस्पृशे परम्॥ १०/७१/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_071/BhP_10.071.034.m4a", "display_order": 35}, {"id": 6000267035, "chapter_id": 10267, "verse_number": "१०-७१-२५", "content_sanskrit": "राजन्येषु निवृत्तेषु भग्नमानेषु मानिषु।\nभगवान् धनुरादाय सज्जं कृत्वाऽथ लीलया॥ १०/७१/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_071/BhP_10.071.035.m4a", "display_order": 36}, {"id": 6000267036, "chapter_id": 10267, "verse_number": "१०-७१-२६", "content_sanskrit": "तस्मिन् सन्धाय विशिखं मत्स्यं वीक्ष्य सकृज्जले।\nछिन्नेषुणाऽपातयत् तं सूर्ये चाभिजिति स्थिते॥ १०/७१/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_071/BhP_10.071.036.m4a", "display_order": 37}, {"id": 6000267037, "chapter_id": 10267, "verse_number": "१०-७१-२७", "content_sanskrit": "दिवि दुन्दुभयो नेदुर्जयशब्दोऽपतद् भुवि।\nदेवाश्च कुसुमासारान् मुमुचुर्हर्षविह्वलाः॥ १०/७१/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_071/BhP_10.071.037.m4a", "display_order": 38}, {"id": 6000267038, "chapter_id": 10267, "verse_number": "१०-७१-२८", "content_sanskrit": "तद्रङ्गमाविशमहं कलनूपुराभ्यां पद्भ्यां दिशो भ्रमयती चलपेशलाभ्याम्।\nवृत्ते पिधाय परिधाय च कौशिकाग्य्रे सव्रीडहासवदना कबरीधृतस्रक्॥ १०/७१/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_071/BhP_10.071.038.m4a", "display_order": 39}, {"id": 6000267039, "chapter_id": 10267, "verse_number": "१०-७१-२९", "content_sanskrit": "उन्नीय वक्त्रमुरुकुण्डलकुन्तलत्विड्गण्डस्थलं शिशिरहासकटाक्षमोक्षम्।\nराज्ञो निरीक्ष्य परितः शनकैर्मुरारेरंसेऽनुरक्तहृदया विदधे स्वमालाम्॥ १०/७१/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_071/BhP_10.071.039.m4a", "display_order": 40}, {"id": 6000267040, "chapter_id": 10267, "verse_number": "१०-७१-३०", "content_sanskrit": "ततो मृदङ्गपटहशङ्खभेर्यानकादयः।\nनिनेदुर्नटनर्तक्यो ननृतुर्गायका जगुः॥ १०/७१/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_071/BhP_10.071.040.m4a", "display_order": 41}, {"id": 6000267041, "chapter_id": 10267, "verse_number": "१०-७१-३१", "content_sanskrit": "एवं वृते भगवति मयेशे नृपयूथपाः।\nन सेहिरे याज्ञसेनि स्पर्धिनो हृच्छयातुराः॥ १०/७१/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_071/BhP_10.071.041.m4a", "display_order": 42}, {"id": 6000267042, "chapter_id": 10267, "verse_number": "१०-७१-३२", "content_sanskrit": "मां रथं स समारोप्य लसद्धयचतुष्टयम्।\nशार्ङ्गमुद्यम्य सन्नद्धस्तस्थावीशश्चतुर्भुजः॥ १०/७१/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_071/BhP_10.071.042.m4a", "display_order": 43}, {"id": 6000267043, "chapter_id": 10267, "verse_number": "१०-७१-३३", "content_sanskrit": "दारुकश्चोदयामास काञ्चनोपस्करं रथम्।\nमिषतां द्विषतां राज्ञि वृकाणां मृगराडिव॥ १०/७१/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_071/BhP_10.071.043.m4a", "display_order": 44}, {"id": 6000267044, "chapter_id": 10267, "verse_number": "१०-७१-३४", "content_sanskrit": "ते त्वसज्जन्त राजन्या निषेद्धुं पथि केचन।\nसंयत्ता उद्धॄतेष्वासा ग्रामसिंहा यथा हरिम्॥ १०/७१/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_071/BhP_10.071.044.m4a", "display_order": 45}, {"id": 6000267045, "chapter_id": 10267, "verse_number": "१०-७१-३५", "content_sanskrit": "ते शार्ङ्गच्युतबाणौघैर्नुन्नबाह्वङ्घ्रिकन्धराः।\nनिपेतुः प्रधने केचिदेके सन्त्यज्य दुद्रुवुः॥ १०/७१/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_071/BhP_10.071.045.m4a", "display_order": 46}, {"id": 6000267046, "chapter_id": 10267, "verse_number": "१०-७१-३६", "content_sanskrit": "ततः पुरीं पतिजयभूत्यलङ्कृतां रविच्छदध्वजपटचित्रतोरणाम्।\nकुशस्थलीं दिवि भुवि चाभिसंस्तुतां समाविशत् तरणिरिव स्वकेतनम्॥ १०/७१/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_071/BhP_10.071.046.m4a", "display_order": 47}, {"id": 6000267047, "chapter_id": 10267, "verse_number": "१०-७१-३७", "content_sanskrit": "पिता मे पूजयामास सुहृत्सम्बन्धिबान्धवान्।\nमहार्हवासोऽलङ्कारैः शय्यासनपरिच्छदैः॥ १०/७१/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_071/BhP_10.071.047.m4a", "display_order": 48}, {"id": 6000267048, "chapter_id": 10267, "verse_number": "१०-७१-३८", "content_sanskrit": "दासीभिः सर्वसम्पद्भिर्भटेभरथवाजिभिः।\nआयुधानि महार्हाणि ददौ पूर्णस्य भक्तितः॥ १०/७१/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_071/BhP_10.071.048.m4a", "display_order": 49}, {"id": 6000267049, "chapter_id": 10267, "verse_number": "१०-७१-३९", "content_sanskrit": "आत्मारामस्य तस्येमा वयं वै गृहदासिकाः।\nसर्वसङ्गनिवृत्त्याऽद्धा तपसा च बभूविम॥ १०/७१/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_071/BhP_10.071.049.m4a", "display_order": 50}, {"id": 6000267050, "chapter_id": 10267, "verse_number": null, "content_sanskrit": "महिष्य ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_071/BhP_10.071.050.m4a", "display_order": 51}, {"id": 6000267051, "chapter_id": 10267, "verse_number": "१०-७१-४०", "content_sanskrit": "भौमं निहत्य सगणं युधि तेन रुद्धा ज्ञात्वा च नः क्षितिजये हृतराजकन्याः।\nनिर्मथ्य संसृतिविमोक्षमपि स्मरन्तीः पादाम्बुजं परिनिनाय य आप्तकामः॥ १०/७१/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_071/BhP_10.071.051.m4a", "display_order": 52}, {"id": 6000267052, "chapter_id": 10267, "verse_number": "१०-७१-४१", "content_sanskrit": "न वयं साध्वि साम्राज्यं स्वाराज्यं भौज्यमप्युत।\nवैराज्यं पारमेष्ठ्यं वा आनन्त्यं वा हरेः पदम्॥ १०/७१/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_071/BhP_10.071.052.m4a", "display_order": 53}, {"id": 6000267053, "chapter_id": 10267, "verse_number": "१०-७१-४२", "content_sanskrit": "कामयामह एतस्य श्रीमत्पादरजः श्रियः।\nकुचकुङ्कुमगन्धाढ्यं मूर्ध्ना वोढुं गदाभृतः॥ १०/७१/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_071/BhP_10.071.053.m4a", "display_order": 54}, {"id": 6000267054, "chapter_id": 10267, "verse_number": "१०-७१-४३", "content_sanskrit": "व्रजस्‍त्रियो यद् वाञ्छन्ति पुलिन्द्यस्तृणवीरुधः।\nगावश्चारयतो गोपैः पादस्पर्शं महात्मनः॥ १०/७१/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_071/BhP_10.071.054.m4a", "display_order": 55}, {"id": 6000267055, "chapter_id": 10267, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्ध उत्तरार्ध एकसप्ततितमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]