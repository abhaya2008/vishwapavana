[{"id": 2115002, "chapter_id": 3474, "verse_number": "", "content_sanskrit": "हिडिम्बचोदनया हिडिम्बायाः पाण्डवसमीपगमनम् ।\nभीमे तस्याः कामः । तदनुरूपवचनम् । तयोः संवादश्च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2115003, "chapter_id": 3474, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2115004, "chapter_id": 3474, "verse_number": "१", "content_sanskrit": "तत्र तेषु शयानेषु हिडिम्बो नाम राक्षसः ।\nअविदूरे वनात् तस्मात् सालवृक्षमुपाश्रितः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2115005, "chapter_id": 3474, "verse_number": "२", "content_sanskrit": "क्रूरो मानुषमांसादो महावीर्यो महाबलः ।\nपिशितेप्सुः क्षुधार्तः सन् जिघ्रन् गन्धं यदृच्छया\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2115006, "chapter_id": 3474, "verse_number": "३", "content_sanskrit": "ऊध्वाङ्गुलिः सकण्डूयो धुन्वन् रूक्षान् शिरोरुहान् ।\nजृम्भमाणो महावक्त्रः पुनःपुनरवेक्ष्य च \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2115007, "chapter_id": 3474, "verse_number": "४", "content_sanskrit": "आघ्राय मानुषं गन्धं भगिनीमिदमब्रवीत् ।\nउपपन्नं चिरस्याद्य भक्षो मम मनःप्रियः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2115008, "chapter_id": 3474, "verse_number": "५", "content_sanskrit": "स्नेहात् स्रावं विसृजति जिह्वा पर्येति वै मुखम् ।\nअष्टौ दंष्ट्राः सितास्तीक्ष्णाश्चिरस्य बत दुस्सहाः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2115009, "chapter_id": 3474, "verse_number": "६", "content_sanskrit": "देहेषु मज्जयिष्यन्ति स्निग्धेषु पिशितेषु च ।\nआक्रम्य मानुषं कण्ठमाच्छिद्य धमनीमपि \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2115010, "chapter_id": 3474, "verse_number": "७", "content_sanskrit": "उष्णं नवं प्रपास्यामि फेनिलं रुधिरं बहु ।\nगच्छ जानीहि के त्वेते शेरते वनमाश्रिताः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2115011, "chapter_id": 3474, "verse_number": "८", "content_sanskrit": "मानुषो बलवान् गन्धो घ्राणं तर्पयतीव मे ।\nहत्वा तान् मानुषानेतानानयाशु ममान्तिकम् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2115012, "chapter_id": 3474, "verse_number": "९", "content_sanskrit": "अस्मद्विषयसुप्तेभ्यो नैतेभ्यो भयमस्ति ते ।\nतेषां मांसानि संस्कृत्य मानुषाणि यथेष्टतः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2115013, "chapter_id": 3474, "verse_number": "१०", "content_sanskrit": "सहितौ भक्षयिष्यावः कुरु क्षिप्रं वचो मम ।\nततस्तुष्टौ प्रनृत्यावः प्रगीतौ तळताळकौ \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2115014, "chapter_id": 3474, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2115015, "chapter_id": 3474, "verse_number": "११", "content_sanskrit": "एवमुक्ता हिडिम्बेन हिडिम्बी राक्षसी तदा ।\nआप्लुत्याप्लुत्य च तरूनागच्छत् पाण्डवान् प्रति \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2115016, "chapter_id": 3474, "verse_number": "१२", "content_sanskrit": "भ्रातुर्वचनमाज्ञाय त्वरमाणैव राक्षसी ।\nजगाम तत्र यत्र स्म शेरते पाण्डवा वने \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2115017, "chapter_id": 3474, "verse_number": "१३", "content_sanskrit": "ददर्श तत्र सा गत्वा पाण्डवान् पृथया सह ।\nशयानान् भीमसेनं च जाग्रतं चापराजितम् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2115018, "chapter_id": 3474, "verse_number": "१४", "content_sanskrit": "उपास्यमानान् भीमेन रूपयौवनशालिना ।\nसुकुमारांश्च पार्थान् सा व्यायामेन च कर्शितान् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2115019, "chapter_id": 3474, "verse_number": "१५", "content_sanskrit": "दुःखेन सम्प्रयुक्तांश्च सहज्येष्ठान् प्रमादिनः ।\nरौद्री सती राजपुत्रं दर्शनीयप्रदर्शनम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2115020, "chapter_id": 3474, "verse_number": "१६", "content_sanskrit": "दृष्ट्वैव भीससेनं सा सालस्कन्धमिवोद्यतम् ।\nराक्षसी कामयामास रूपेणाप्रतिमं भुवि \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2115021, "chapter_id": 3474, "verse_number": "१७", "content_sanskrit": "अन्तर्गतेन मनसा चिन्तयामास राक्षसी ।\nअयं श्यामो महाबाहुः सिंहस्कन्धो महाद्युतिः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2115022, "chapter_id": 3474, "verse_number": "१८", "content_sanskrit": "कम्बुग्रीवः पुष्कराक्षो भर्ता युक्तो भवेन्मम ।\nनाहं भ्रातुर्वचो जातु कुर्यां क्रूरमसाम्प्रतम् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2115023, "chapter_id": 3474, "verse_number": "१९", "content_sanskrit": "पतिहेतुर्हि बलवान् न तथा भ्रातृसङ्गमः ।\nमुहूर्तमपि चाद्याहं प्राप्नुयां तृप्तिमुत्तमाम् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2115024, "chapter_id": 3474, "verse_number": "२०", "content_sanskrit": "भर्त्रा त्वहमनेनैव मोदिष्ये बहुळाः समाः ।\nहिडिम्बी तु महारौद्रा तदा भरतसत्तम \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2115025, "chapter_id": 3474, "verse_number": "२१", "content_sanskrit": "उत्सृज्य राक्षसं रूपं मानुषं रूपमास्थिता ।\nसा कामरूपिणी रूपं कृत्वा मदनमोहिता \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2115026, "chapter_id": 3474, "verse_number": "२२", "content_sanskrit": "उपतस्थे महात्मानं भीमसेनमनिन्दिता ।\nइङ्गिताकारकुशला सोपासर्पच्छनैः शनैः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2115027, "chapter_id": 3474, "verse_number": "२३", "content_sanskrit": "विनम्यमानेव लता सर्वाभरणभूषिता ।\nशनैश्शनैः स तां भीमः समीपमुपसर्पतीम् \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2115028, "chapter_id": 3474, "verse_number": "२४", "content_sanskrit": "वीक्षमाणस्तथाऽपश्यत् तन्वीं पीनपयोधराम् ।\nचन्द्राननां पद्मनेत्रां नीलकुञ्चितमूर्धजाम् \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2115029, "chapter_id": 3474, "verse_number": "२५", "content_sanskrit": "कृष्णां सुपाण्डरैर्वस्त्रैः बिम्बोष्ठीं चारुदर्शनाम् ।\nदृष्ट्वा तां रूपसम्पन्नां भीमो विस्मयमागतः \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2115030, "chapter_id": 3474, "verse_number": "२६", "content_sanskrit": "उपचारगुणैर्युक्ता ललितैर्भावसंस्थितैः ।\nसमीपमुपसम्प्राप्य भीमं साऽथ वरानना\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2115031, "chapter_id": 3474, "verse_number": "२७", "content_sanskrit": "वचो वचनवेलायामिदं प्रोवाच पाण्डवम् ।\nलज्जया नम्यमानेव सर्वाभरणभूषिता \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2115032, "chapter_id": 3474, "verse_number": "२८", "content_sanskrit": "स्मितपूर्वमिदं वाक्यं भीमसेनमथाब्रवीत् ।\nकुतस्त्वमसि सम्प्राप्तः कश्चासि पुरुषर्षभ \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2115033, "chapter_id": 3474, "verse_number": "२९", "content_sanskrit": "क इमे शेरते चेह पुरुषा देवरूपिणः ।\nकेयं च बृहती श्यामा सुकुमारी तवानघ \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2115034, "chapter_id": 3474, "verse_number": "३०", "content_sanskrit": "शेते वनमिदं प्राप्य विश्वस्ता स्वगृहे यथा ।\nनेदं जानीथ गहनं वनं राक्षससेवितम् \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2115035, "chapter_id": 3474, "verse_number": "३१", "content_sanskrit": "वसति ह्मत्र पापात्मा हिडिम्बो नाम राक्षसः ।\nतेनाहं प्रेषिता भ्रात्रा दुष्टभावेन रक्षसा \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2115036, "chapter_id": 3474, "verse_number": "३२", "content_sanskrit": "बिभक्षयिषता मांसं युष्माकममरोपम ।\nसाऽहं त्वामिह सम्प्रेक्ष्य देवगर्भसमप्रभम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2115037, "chapter_id": 3474, "verse_number": "३३", "content_sanskrit": "नान्यं भर्तारमिच्छामि सत्यमेतद् ब्रवीमि ते ।\nएतद् विज्ञाय धर्मज्ञ युक्तं मयि समाचर \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2115038, "chapter_id": 3474, "verse_number": "३४", "content_sanskrit": "कामोपहतचित्तां हि भजमानां भजस्व माम् ।\nत्रास्येऽहं त्वां महाराज राक्षसात् पुरुषादकात् \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2115039, "chapter_id": 3474, "verse_number": "३५", "content_sanskrit": "वत्स्यावो गिरिदुर्गेषु भर्ता भव ममानघ ।\nइच्छामि वीर भद्रं ते मम प्राणान् विहासिषुः \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2115040, "chapter_id": 3474, "verse_number": "३६", "content_sanskrit": "त्वया ह्यहं परित्यक्ता न जीवेयमरिन्दम ।\nअन्तरिक्षचरी चास्मि कामरूपधराऽपि च ।\nअतुलामाप्नुहि प्रीतिं तत्र तत्र मया सह \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2115041, "chapter_id": 3474, "verse_number": "", "content_sanskrit": "भीमसेनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2115042, "chapter_id": 3474, "verse_number": "३७", "content_sanskrit": "एष ज्येष्ठो मम भ्राता मान्यः परमको गुरुः ।\nअनिविष्टश्च तन्नाहं परिवेत्ता कथञ्चन \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2115043, "chapter_id": 3474, "verse_number": "३८", "content_sanskrit": "मातरं भ्रातरं ज्येष्ठं कनिष्ठानपराजितान् ।\nपरित्यजेद्धि को न्वद्य भयादपि च राक्षसि \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2115044, "chapter_id": 3474, "verse_number": "३९", "content_sanskrit": "को हि सुप्तानिमान् भ्रातॄन् दत्त्वा राक्षसभोजनम् ।\nमातरं च नरो गच्छेत् कामार्त इव मद्विधः \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2115045, "chapter_id": 3474, "verse_number": "", "content_sanskrit": "हिडिम्बी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2115046, "chapter_id": 3474, "verse_number": "४०", "content_sanskrit": "एकं त्वां मोक्षयिष्यामि सह मात्रा परन्तप ।\nसोदरानुत्सृजैनांस्त्वमारोह जघनं मम \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2115047, "chapter_id": 3474, "verse_number": "", "content_sanskrit": "भीमसेनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2115048, "chapter_id": 3474, "verse_number": "४१", "content_sanskrit": "नाहं जीवितुमाशंसे भ्रातॄनुत्सृज्य राक्षसि ।\nयथाश्रद्धं व्रजैका हि विप्रियं मे प्रभाषसे \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2115049, "chapter_id": 3474, "verse_number": "", "content_sanskrit": "राक्षसी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2115050, "chapter_id": 3474, "verse_number": "४२", "content_sanskrit": "न तेऽप्रियं चिकीर्षामि सर्वानेतान् प्रबोधय ।\nमोक्षयिष्यामि वः कामं राक्षसात् पुरुषादकात् \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2115051, "chapter_id": 3474, "verse_number": "", "content_sanskrit": "भीमसेनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2115052, "chapter_id": 3474, "verse_number": "४३", "content_sanskrit": "न भयाद् बोधयिष्यामि भ्रातुस्तव दुरात्मनः ।\nसुखसुप्तानिमान् भ्रातॄन् मातरं चैव राक्षसि \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2115053, "chapter_id": 3474, "verse_number": "४४", "content_sanskrit": "न हि मे राक्षसा भीरु सोढुं शक्ताः पराक्रमम् ।\nन मनुष्या न गन्धर्वा न यक्षाश्चारुलोचने \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2115054, "chapter_id": 3474, "verse_number": "४५", "content_sanskrit": "गच्छ वा तिष्ठ वा भद्रे यद्वाऽपीच्छसि तत् कुरु ।\nतं वा प्रेषय तन्वङ्गि राक्षसं पुरुषादकम् \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2115055, "chapter_id": 3474, "verse_number": "१५३", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nत्रिपञ्चाशदधिकशततमोऽध्यायः ॥१५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2115056, "chapter_id": 3474, "verse_number": "१", "content_sanskrit": "॥ इति हिडिम्बवधपर्वणि प्रथमोऽध्यायः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2115057, "chapter_id": 3474, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]