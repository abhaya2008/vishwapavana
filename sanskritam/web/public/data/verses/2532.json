[{"id": 2072649, "chapter_id": 2532, "verse_number": "१२-३७-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2072650, "chapter_id": 2532, "verse_number": "१२-३७-१", "content_sanskrit": "प्रवेशने तु पार्थानां जनानां पुरवासिनाम्।\nदिदृक्षूणां सहस्राणि समाजग्मुः सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2072651, "chapter_id": 2532, "verse_number": "१२-३७-२", "content_sanskrit": "स राजमार्गः शुशुभे समलंकृतचत्वरः।\nयथा चन्द्रोदये राजन्वर्धमानो महोदधिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2072652, "chapter_id": 2532, "verse_number": "१२-३७-३", "content_sanskrit": "गृहाणि राजमार्गेषु रत्नवन्ति महान्ति च।\nप्राकम्पन्तीव भारेण स्त्रीणां पूर्णानि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2072653, "chapter_id": 2532, "verse_number": "१२-३७-४", "content_sanskrit": "ताः शनैरिव सव्रीडं प्रशशंसुर्युधिष्ठिरम्।\nभीमसेनार्जुनौ चैव माद्रीपुत्रौ च पाण्डवौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2072654, "chapter_id": 2532, "verse_number": "१२-३७-५", "content_sanskrit": "धन्या त्वमसि पाञ्चालि या त्वं पुरुषसत्तमान्।\nउपतिष्ठसि कल्याणि महर्षिमिव गौतमी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2072655, "chapter_id": 2532, "verse_number": "१२-३७-६", "content_sanskrit": "तव कर्माण्यमोघानि व्रतचर्या च भामिनि।\nइति कृष्णां महाराज प्रशशंसुस्तदा स्त्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2072656, "chapter_id": 2532, "verse_number": "१२-३७-७", "content_sanskrit": "प्रशंसावचनैस्तासां मिथः शब्दैश्च भारत।\nप्रीतिजैश्च तदा शब्दैः पुरमासीत्समाकुलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2072657, "chapter_id": 2532, "verse_number": "१२-३७-८", "content_sanskrit": "तमतीत्य यथायुक्तं राजमार्गं युधिष्ठिरः।\nअलंकृतं शोभमानमुपापाद्राजवेश्म ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2072658, "chapter_id": 2532, "verse_number": "१२-३७-९", "content_sanskrit": "ततः प्रकृतयः सर्वाः पौरा जानपदास्तदा।\nऊचुः कर्णसुखा वाचः समुपेत्य ततस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2072659, "chapter_id": 2532, "verse_number": "१२-३७-१०", "content_sanskrit": "दिष्ट्या जयसि राजेन्द्र शत्रूञ्छत्रुनिषूदन।\nदिष्ट्या राज्यं पुनः प्राप्तं धर्मेण च बलेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2072660, "chapter_id": 2532, "verse_number": "१२-३७-११", "content_sanskrit": "भव नस्त्वं महाराज राजेह शरदां शतम्।\nप्रजाः पालय धर्मेण यथेन्द्रस्त्रिदिवं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2072661, "chapter_id": 2532, "verse_number": "१२-३७-१२", "content_sanskrit": "एवं राजकुलद्वारि मङ्गलैरभिपूजितः।\nआशीर्वादान्द्विजैरुक्तान्प्रतिगृह्य समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2072662, "chapter_id": 2532, "verse_number": "१२-३७-१३", "content_sanskrit": "प्रविश्य भवनं राजा देवराजगृहोपमम्।\nश्रुत्वा विजयसंयुक्तं रथात्पश्चादवातरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2072663, "chapter_id": 2532, "verse_number": "१२-३७-१४", "content_sanskrit": "प्रविश्याभ्यन्तरं श्रीमान्दैवतान्यभिगम्य च।\nपूजयामास रत्नैश्च गन्धमाल्यैश्च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2072664, "chapter_id": 2532, "verse_number": "१२-३७-१५", "content_sanskrit": "निश्चक्राम ततः श्रीमान्पुनरेव महायशाः।\nददर्श ब्राह्मणांश्चैव सोऽभिरूपानवस्थितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2072665, "chapter_id": 2532, "verse_number": "१२-३७-१६", "content_sanskrit": "स संवृतस्तदा विप्रैराशीर्वादविवक्षुभिः।\nशुशुभे विमलश्चन्द्रस्तारागणवृतो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2072666, "chapter_id": 2532, "verse_number": "१२-३७-१७", "content_sanskrit": "तांस्तु वै पूजयामास कौन्तेयो विधिवद्द्विजान्।\nसुमनोमोदकै रत्नैर्हिरण्येन च भूरिणा।\nगोभिर्वस्त्रैश्च राजेन्द्र विविधैश्च किमिच्छकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2072667, "chapter_id": 2532, "verse_number": "१२-३७-१८", "content_sanskrit": "धौम्यं गुरुं पुरस्कृत्य ज्येष्ठं पितरमेव च।\n`प्रविवेश सभां राजा सुधर्मां वासवो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2072668, "chapter_id": 2532, "verse_number": "१२-३७-१९", "content_sanskrit": "ततः पुण्याहघोषोऽभूद्दिवं स्तब्ध्वेव भारत।\nसुहृदां प्रीतिजननः पुण्यः श्रुतिसुखावहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2072669, "chapter_id": 2532, "verse_number": "१२-३७-२०", "content_sanskrit": "हंसवन्नेदुषां राजन्द्विजानां तत्र भारती।\nशुश्रुवे वेदविदुषां पुष्कलार्थपदाक्षरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2072670, "chapter_id": 2532, "verse_number": "१२-३७-२१", "content_sanskrit": "ततो दुन्दुभिनिर्घोषः शङ्खानां च मनोरमः।\nजयं प्रवदतां तत्र स्वनः प्रादुरभून्नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2072671, "chapter_id": 2532, "verse_number": "१२-३७-२२", "content_sanskrit": "निःशब्दे च स्थिते तत्र ततो विप्रजने पुनः।\nराजानं ब्राह्मणच्छझा चार्वाको राक्षसोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2072672, "chapter_id": 2532, "verse_number": "१२-३७-२३", "content_sanskrit": "तत्र दुर्योधनसखा भिक्षुरूपेण संवृतः।\nसाङ्ख्यः शिखी त्रिदण्डी च धृष्टो विगतसाध्वसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2072673, "chapter_id": 2532, "verse_number": "१२-३७-२४", "content_sanskrit": "वृतः सर्वैस्तथा विप्रैराशीर्वादविवक्षुभिः।\nपरस्सहस्रै राजेन्द्र तपोनियमसंस्थितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2072674, "chapter_id": 2532, "verse_number": "१२-३७-२५", "content_sanskrit": "सुदुष्टः पापमाशंसुः पाण्डवानां महात्मनाम्।\nअनामन्त्र्यैव तान्विप्रांस्तमुवाच महीपतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2072675, "chapter_id": 2532, "verse_number": "१२-३७-२६x", "content_sanskrit": "चार्वाक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2072676, "chapter_id": 2532, "verse_number": "१२-३७-२६", "content_sanskrit": "इमे प्राहुर्द्विजाः सर्वे समारोप्य वचो मयि।\nधिग्भवन्तं कुनृपतिं ज्ञातिघातिनमस्तु वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2072677, "chapter_id": 2532, "verse_number": "१२-३७-२७", "content_sanskrit": "किं ते राज्येन कौन्तेय कृत्वेमं ज्ञातिसंक्षयम्।\nघातयित्वा गुरूंश्चैव मृतं श्रेयो न जीवितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2072678, "chapter_id": 2532, "verse_number": "१२-३७-२८", "content_sanskrit": "इति ते वै द्विजाः श्रुत्वा तस्य दुष्टस्य रक्षसः।\nविव्यथुश्चुक्रुशुश्चैव तस्य वाक्यप्रधर्षिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2072679, "chapter_id": 2532, "verse_number": "१२-३७-२९", "content_sanskrit": "ततस्ते ब्राह्मणाः सर्वे स च राजा युधिष्ठिरः।\nव्रीडिताः परमोद्विग्रास्तूष्णीमासन्विशांपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2072680, "chapter_id": 2532, "verse_number": "१२-३७-३०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2072681, "chapter_id": 2532, "verse_number": "१२-३७-३०", "content_sanskrit": "प्रसीदन्तु भवन्तो मे प्रणतस्याभियाचतः।\nप्रत्यासन्नव्यसनिनं न मां धिक्कर्तुमर्हथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2072682, "chapter_id": 2532, "verse_number": "१२-३७-३१x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2072683, "chapter_id": 2532, "verse_number": "१२-३७-३१", "content_sanskrit": "ततो राजन्ब्राह्माणास्ते सर्व एव विशांपते।\nऊचुर्नैष द्विजोऽस्माकमन्यस्तु तव पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2072684, "chapter_id": 2532, "verse_number": "१२-३७-३२", "content_sanskrit": "जज्ञुश्चैनं महात्मानस्ततस्तं ज्ञानचक्षुषा।\nब्राह्मणा वेदविद्वांसस्तपोभिर्विमलीकृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2072685, "chapter_id": 2532, "verse_number": "१२-३७-३३x", "content_sanskrit": "ब्राह्मणा ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2072686, "chapter_id": 2532, "verse_number": "१२-३७-३३", "content_sanskrit": "एष दुर्योधनसखा विश्रुतो ब्रह्मराक्षसः।\nपरिव्राजकरूपेण हितं तस्य चिकीर्षति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2072687, "chapter_id": 2532, "verse_number": "१२-३७-३४", "content_sanskrit": "न वयं ब्रूम धर्मात्मन्व्येतु ते भयमीदृशम्।\nउपतिष्ठतु कल्याणं भवन्तं भ्रातृभिः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2072688, "chapter_id": 2532, "verse_number": "१२-३७-३५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2072689, "chapter_id": 2532, "verse_number": "१२-३७-३५", "content_sanskrit": "ततस्ते ब्राह्मणाः सर्वे हुंकारैः क्रोधमूर्च्छिताः।\nनिर्भर्त्सयन्तः शुचयो निजघ्नुः पापराक्षसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2072690, "chapter_id": 2532, "verse_number": "१२-३७-३६", "content_sanskrit": "स पपात विनिर्दग्धस्तेजसा ब्रह्मवादिनाम्।\nमहेन्द्राशनिनिर्दग्धः पादपोऽङ्कुरवानिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2072691, "chapter_id": 2532, "verse_number": "१२-३७-३७", "content_sanskrit": "पूजिताश्च ययुर्विप्रा राजानमभिनन्द्य तम्।\nराजा च हर्षमापेदे पाण्डवः ससुहृज्जनः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2072692, "chapter_id": 2532, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि सप्तत्रिंशोऽध्यायः॥ ३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]