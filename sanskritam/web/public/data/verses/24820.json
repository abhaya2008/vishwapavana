[{"id": 7004820000, "chapter_id": 24820, "verse_number": "७-१-३-१", "content_sanskrit": "ऋषय ऊचुः ।\nकथितो भवता सर्गः प्रतिसर्गस्तथैव च ।\nवंशानुवंशचरितं पुराणानामनुक्रमः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004820001, "chapter_id": 24820, "verse_number": "७-१-३-२", "content_sanskrit": "मन्वन्तरप्रमाणं च ब्रह्मांडस्य च विस्तरः ।\nज्योतिश्चक्रस्वरूपं च यथावदनुवर्णितम् ।\nश्रोतुमिच्छामहे त्वत्तः सांप्रतं तीर्थविस्तरम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004820002, "chapter_id": 24820, "verse_number": "७-१-३-३", "content_sanskrit": "पृथिव्यां यानि तीर्थानि पापघ्नानि शुभानि च ।\nतानि सूतज कार्त्स्न्येन यथावद्वक्तुमर्हसि ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004820003, "chapter_id": 24820, "verse_number": "७-१-३-४", "content_sanskrit": "सूत उवाच ।\nइदं पृष्टं पुरा देव्या कैलासशिखरोत्तमे ।\nनानाधातुविचित्रांगे नानारत्नसमन्विते ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004820004, "chapter_id": 24820, "verse_number": "७-१-३-५", "content_sanskrit": "नानाद्रुमलताकीर्णे नानापुष्पोपशोभिते ।\nयक्षविद्याधराकीर्णे ह्यप्सरोगणसेविते ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004820005, "chapter_id": 24820, "verse_number": "७-१-३-६", "content_sanskrit": "तत्र ब्रहमा च विष्णुश्च स्कन्दनन्दिगणेश्वराः ।\nचंद्रादित्यौ ग्रहैः सार्धं नक्षत्रध्रुवमण्डलम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004820006, "chapter_id": 24820, "verse_number": "७-१-३-७", "content_sanskrit": "वायुश्च वरुणश्चैव कुबेरो धनदस्तथा ।\nईशानश्चाग्निरिंद्रश्च यमो निरृतिरेव च ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004820007, "chapter_id": 24820, "verse_number": "७-१-३-८", "content_sanskrit": "सरितः सागराः सर्वे पर्वता उरगास्तथा ।\nब्राह्म्याद्या मातरश्चैव ऋषयश्च तपोधनाः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004820008, "chapter_id": 24820, "verse_number": "७-१-३-९", "content_sanskrit": "मूर्तिमंति च तीर्थानि क्षेत्राण्यायतनानि च ।\nदानवासुरदैत्याश्च पिशाचा भूतराक्षसाः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004820009, "chapter_id": 24820, "verse_number": "७-१-३-१०", "content_sanskrit": "तत्र सिंहासनं दिव्यं शतयोजनविस्तृतम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004820010, "chapter_id": 24820, "verse_number": "७-१-३-११", "content_sanskrit": "लक्षायुतसहस्रैश्च रुद्रकोटिभिरावृतम् ।\nतन्मध्ये सर्वतोभद्रं सिंहद्वारैः सुतोरणैः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004820011, "chapter_id": 24820, "verse_number": "७-१-३-१२", "content_sanskrit": "स्वच्छमौक्तिकसंकाशं प्राकारशिखरावृतम् ।\nनन्दीश्वरमहाकालद्वारपालगणैर्वृतम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004820012, "chapter_id": 24820, "verse_number": "७-१-३-१३", "content_sanskrit": "किंकिणीजालमुखरैः सत्यताकैरलंकृतम् ।\nवितानच्छत्रखंडैश्च मुक्तादामप्रलंबितैः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004820013, "chapter_id": 24820, "verse_number": "७-१-३-१४", "content_sanskrit": "घंटाचामरशोभाढयैर्दर्पणैश्चोपशोभितम् ।\nकलशैर्द्वारविन्यस्तरत्नपल्लवसंयुतैः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004820014, "chapter_id": 24820, "verse_number": "७-१-३-१५", "content_sanskrit": "चित्रितं चित्रशास्त्रज्ञै रत्नचूर्णैः समु्ज्वलैः ।\nस्वस्तिकैः पत्रवल्याद्यैर्लिंगोद्भवलतादिभिः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004820015, "chapter_id": 24820, "verse_number": "७-१-३-१६", "content_sanskrit": "शतसिंहासनाकीर्णं वेदिकाभिश्च शोभितम् ।\nआसीनै रुद्रवृन्दैश्च रुद्रकन्याकदम्बकैः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004820016, "chapter_id": 24820, "verse_number": "७-१-३-१७", "content_sanskrit": "लक्षपत्रदलाढ्यैश्च श्वेतपद्मैश्च भूषितम् ।\nअप्सरोभिः समाकीर्णं पुष्पप्रकरविस्तृतम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004820017, "chapter_id": 24820, "verse_number": "७-१-३-१८", "content_sanskrit": "धूपितं धूपवर्त्तीभिः कुंकुमोदकसेचितम् ।\nवंशवीणामृदंगैश्च गोमुखैर्मुखवादनैः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004820018, "chapter_id": 24820, "verse_number": "७-१-३-१९", "content_sanskrit": "शंखभेरीनिनादेन दुन्दुभिध्वनितेन च ।\nगर्जद्भिर्गणवृन्दैश्च मेघस्वनितनिस्वनैः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004820019, "chapter_id": 24820, "verse_number": "७-१-३-२०", "content_sanskrit": "गणानां स्तोत्रशब्देन सामवेदरवेण च ।\nप्रेक्षणीयैर्महानादैर्गेयहुङ्कारशोभितम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004820020, "chapter_id": 24820, "verse_number": "७-१-३-२१", "content_sanskrit": "वृषनर्दितशब्देन गजवाजिरवेण च ।\nकांचीनूपुरशब्देन समाकीर्णदिगंतरम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004820021, "chapter_id": 24820, "verse_number": "७-१-३-२२", "content_sanskrit": "सर्वसंपत्करं श्रीमच्छंकरस्यैव मंदिरम् ।\nवंश वीणामृदंगैश्च नादितं तत्र तत्र ह ।\nऋग्वेदो मूर्तिमांश्चैव शक्रनीलसमद्युतिः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004820022, "chapter_id": 24820, "verse_number": "७-१-३-२३", "content_sanskrit": "दिव्यगन्धानुलिप्तांगो दिव्याभरणभूषितः ।\nसंस्थितः पूर्वतस्तस्य दीप्यमानः स्वतेजसा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004820023, "chapter_id": 24820, "verse_number": "७-१-३-२४", "content_sanskrit": "उत्तरेण यजुर्वेदः शुद्धस्फटिकसन्निभः ।\nदिव्यकुण्डलधारी च महाकायो महाभुजः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004820024, "chapter_id": 24820, "verse_number": "७-१-३-२५", "content_sanskrit": "स्थितः पश्चिम दिग्भागे सामवेदः सनातनः ।\nरक्तांबरधरः श्रीमान्पप्ररागसमप्रभः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004820025, "chapter_id": 24820, "verse_number": "७-१-३-२६", "content_sanskrit": "स्रग्दामधारी चित्रश्च गीतभूषणभूषितः ।\nअथवांऽजनवच्छयामः स्थितो दक्षिणतस्तथा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004820026, "chapter_id": 24820, "verse_number": "७-१-३-२७", "content_sanskrit": "पिंगाक्षो लोहितग्रीवो हरिकेशो महातनुः ।\nइतिहासषडंगानि पुराणान्यखिलानि च ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004820027, "chapter_id": 24820, "verse_number": "७-१-३-२८", "content_sanskrit": "वेदोपनिषदश्छन्दो मीमांसारण्यकं तथा ।\nस्वाहाकारवषट्कारौ रहस्यानि तथैव च ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004820028, "chapter_id": 24820, "verse_number": "७-१-३-२९", "content_sanskrit": "एतैः समन्वितैश्चैव तत्र ब्रह्मा स्वयं स्थितः ।\nशक्तिरूपधरैर्मन्त्रैर्योगैश्वर्यसमन्वितैः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004820029, "chapter_id": 24820, "verse_number": "७-१-३-३०", "content_sanskrit": "सहस्रपत्रकमलैरंकितैः सुरपूजितैः ।\nपूजितैर्गणरुद्रैश्च ब्रह्मविष्विंद्रवंदितैः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004820030, "chapter_id": 24820, "verse_number": "७-१-३-३१", "content_sanskrit": "चामराक्षेपव्यजनैर्वीजितैश्च समन्ततः ।\nशोभितश्च सदा श्रीमांश्चंद्रकोटिसमप्रभः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004820031, "chapter_id": 24820, "verse_number": "७-१-३-३२", "content_sanskrit": "ज्ञानामृतसुतृप्तात्मा योगैश्वर्यप्रसादकः ।\nयोगींद्रमानसांभोज राजहंसो द्विजोत्तमः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004820032, "chapter_id": 24820, "verse_number": "७-१-३-३३", "content_sanskrit": "अज्ञानतिमिरध्वंसी षट्त्रिंशत्तत्त्वभूषणः ।\nसर्वसौख्यप्रदाता च तत्रास्ते चंद्रशेखरः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004820033, "chapter_id": 24820, "verse_number": "७-१-३-३४", "content_sanskrit": "तस्योत्संगगता देवी तप्तकांचनसप्रभा ।\nपूजितो योगिनीवृन्दैः साधकैः सुरकिन्नरैः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004820034, "chapter_id": 24820, "verse_number": "७-१-३-३५", "content_sanskrit": "सर्वलक्षणसंपूर्णा सर्वाभरणभूषिता ।\nयोगसिद्धिप्रदा नित्यं मोक्षाभ्युदयदायिनीम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004820035, "chapter_id": 24820, "verse_number": "७-१-३-३६", "content_sanskrit": "सौभाग्यकदलीकन्दमूलबीजं च पार्वती ।\nदेवस्य मुखमालोक्य विस्मिता चारुलोचना ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004820036, "chapter_id": 24820, "verse_number": "७-१-३-३७", "content_sanskrit": "आनंदभावं संज्ञाय आनन्दास्राविलेक्षणम् ।\nउवाच देवी मधुरं कृतांजलिपुटा सती ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004820037, "chapter_id": 24820, "verse_number": "७-१-३-३८", "content_sanskrit": "देव्युवाच ।\nजन्मकोटिसहस्राणि जन्मकोटिशतानि च ।\nशोधितस्त्वं जगन्नाथ मया प्राणनचिंतया ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004820038, "chapter_id": 24820, "verse_number": "७-१-३-३९", "content_sanskrit": "अर्द्धांग संस्थया वापि त्वद्वक्त्रध्यानकाम्यया ।\nतथापि ते जगन्नाथ नांतो लब्ध्वो महेश्वर ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004820039, "chapter_id": 24820, "verse_number": "७-१-३-४०", "content_sanskrit": "अनन्तरूपिणे तुभ्यं देवदेव नमोऽस्तु ते ।\nनमो वेदरहस्याय नमो वेदैः स्तुताय च ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004820040, "chapter_id": 24820, "verse_number": "७-१-३-४१", "content_sanskrit": "श्मशानरतिनित्याय नमो गगनचारिणे ।\nज्येष्ठसामरहस्याय शतरुद्रप्रियाय च ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004820041, "chapter_id": 24820, "verse_number": "७-१-३-४२", "content_sanskrit": "नमो वृषकृतांकाय यजुर्वेदधराय च ।\nब्रह्मांडकोटिसंलग्नमालिने गगनात्मने ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004820042, "chapter_id": 24820, "verse_number": "७-१-३-४३", "content_sanskrit": "मणिचित्रितकन्दाय नमः सर्वार्थसिद्धये ।\nनमो वेदस्वरूपाय द्विज सिद्धिप्रियाय च ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004820043, "chapter_id": 24820, "verse_number": "७-१-३-४४", "content_sanskrit": "पुंस्त्रीविकाररूपाय नमश्चंद्रार्द्धधारिणे ।\nनमोग्नये सहोमाय आदित्यवरुणाय च ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004820044, "chapter_id": 24820, "verse_number": "७-१-३-४५", "content_sanskrit": "पृथिव्यै चांतरिक्षाय वायवे दीक्षिताय च ।\nसंयोगाय वियोगाय धात्रे कर्त्रेऽपहारिणे ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004820045, "chapter_id": 24820, "verse_number": "७-१-३-४६", "content_sanskrit": "प्रदीप्तशूलहस्ताय ब्रह्मदण्डधराय च ।\nनमः पतीनां पतये महतां पतये नमः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004820046, "chapter_id": 24820, "verse_number": "७-१-३-४७", "content_sanskrit": "नमः कालाग्निरुद्राय सप्तलोकनिवासिने ।\nत्वं गतिः सर्वभूतानां भूतानां पतये नमः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004820047, "chapter_id": 24820, "verse_number": "७-१-३-४८", "content_sanskrit": "नमस्ते भगवन्रुद्र नमस्ते भगवञ्छिव ।\nनमस्ते परतः श्रेष्ठ नमस्ते परतः पर ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004820048, "chapter_id": 24820, "verse_number": "७-१-३-४९", "content_sanskrit": "जिह्वाचापल्यभावेन खेदितोऽसि मया प्रभो ।\nतत्क्षन्तव्यं महेशान ज्ञानदिव्य नमोऽस्तु ते ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004820049, "chapter_id": 24820, "verse_number": "७-१-३-५०", "content_sanskrit": "ईश्वर उवाच ।\nममोत्संगस्थिता देवि किं त्वं सास्राविलेक्षणा ।\nअद्यापि किमपूर्णं ते तत्सर्वं करवाण्यहम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004820050, "chapter_id": 24820, "verse_number": "७-१-३-५१", "content_sanskrit": "वरं ब्रवीहि भद्रं ते स्तवेनानेन सुव्रते ।\nददामि ते न संदेहः शोकं त्यज महेश्वरि ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004820051, "chapter_id": 24820, "verse_number": "७-१-३-५२", "content_sanskrit": "निष्कले सकले देवि स्थूले सूक्ष्मे चराचरे ।\nन तत्पश्यामि देवेशि यत्त्वया रहितं भवेत् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004820052, "chapter_id": 24820, "verse_number": "७-१-३-५३", "content_sanskrit": "अहं ते हृदये गौरि त्वं च मे हृदि संस्थिता ।\nअहं भ्राता च पुत्रश्च बंधुर्भर्ता तथैव च ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004820053, "chapter_id": 24820, "verse_number": "७-१-३-५४", "content_sanskrit": "त्वं तु मे भगिनी भार्या दुहिता बांधवी स्नुषा ।\nअहं यज्ञपतिर्यज्वा त्वं च श्रद्धा सदक्षिणा ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004820054, "chapter_id": 24820, "verse_number": "७-१-३-५५", "content_sanskrit": "ओंकारोऽहं वषट्कारः सामाहमृग्यजुस्तथा ।\nअहमग्निश्च होता च यजमानस्तथैव च ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004820055, "chapter_id": 24820, "verse_number": "७-१-३-५६", "content_sanskrit": "अध्वर्युरहमुद्गाता ब्रह्माहं ब्रह्मवित्तथा ।\nत्वं तु देव्यरणी चैव पत्नी तु परिकीर्त्यसे ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004820056, "chapter_id": 24820, "verse_number": "७-१-३-५७", "content_sanskrit": "स्वाहा स्वधा च सुश्रोणि त्वयि सर्वं प्रतिष्ठितम् ।\nअहमिष्टो महायज्ञः पूर्वो यज्ञस्त्वमुच्यसे ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004820057, "chapter_id": 24820, "verse_number": "७-१-३-५८", "content_sanskrit": "पुरुषोऽहं वरारोहे प्रकृतिस्त्वं निगद्यसे ।\nअहं विष्णुर्महावीर्यस्त्वं लक्ष्मीर्लोकभाविनी ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004820058, "chapter_id": 24820, "verse_number": "७-१-३-५९", "content_sanskrit": "अहमिन्द्रो महातेजाः प्राची त्वं परमेश्वरी ।\nप्रजापतीनां रूपेण सर्वमाहं व्यवस्थितः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004820059, "chapter_id": 24820, "verse_number": "७-१-३-६०", "content_sanskrit": "तेषां या नायिकास्तास्त्वं रूपैस्तैस्तैरवस्थिता ।\nदिवसोऽहं महादेवि रजनी त्वं निगद्यसे ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004820060, "chapter_id": 24820, "verse_number": "७-१-३-६१", "content_sanskrit": "निमेषोऽहं मुहूर्तश्च त्वं कला सिद्धिरेव च ।\nअहं तेजोऽधिकः सूर्यस्त्वं तु संध्या प्रकीर्त्त्यसे ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004820061, "chapter_id": 24820, "verse_number": "७-१-३-६२", "content_sanskrit": "अहं बीजधरः श्रेष्ठस्त्वं तु क्षेत्रं वरानने ।\nअहं वनस्पतिः प्लक्षस्त्वं वनस्पतिरुच्यसे ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004820062, "chapter_id": 24820, "verse_number": "७-१-३-६३", "content_sanskrit": "शेषरूपधरो नित्ये फणामणिविभूषितः ।\nरेवती त्वं विशालाक्षि मदविभ्रमलोचना ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004820063, "chapter_id": 24820, "verse_number": "७-१-३-६४", "content_sanskrit": "मोक्षोऽहं सर्वदुःखानां त्वं तु देवि परा गतिः ।\nअपां पतिरहं भद्रे त्वं तु देवि सरिद्वरा ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004820064, "chapter_id": 24820, "verse_number": "७-१-३-६५", "content_sanskrit": "वडवाग्निरहं भद्रे त्वं तु दीप्तिः प्रकीर्तिता ।\nप्रजापतिरहं कर्त्ता त्वं प्रजा प्रकृतिस्तथा ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004820065, "chapter_id": 24820, "verse_number": "७-१-३-६६", "content_sanskrit": "नागानामधिपश्चाहं पातालतलवासिनाम् ।\nत्वं नागी नागराजोऽहं सहस्रफणभूषितः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004820066, "chapter_id": 24820, "verse_number": "७-१-३-६७", "content_sanskrit": "निशाकरवरश्चाहं श्रेष्ठा त्वं रजनीकरी ।\nकामोऽहं कामदो देवि त्वं रतिः स्मृतिरेव च ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004820067, "chapter_id": 24820, "verse_number": "७-१-३-६८", "content_sanskrit": "दुर्वासाश्चाप्यहं भद्रे त्वं क्षमा समचारिणी ।\nलोभमोहतपश्चाहं त्वं तृष्णा तामसी स्मृता ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004820068, "chapter_id": 24820, "verse_number": "७-१-३-६९", "content_sanskrit": "ककुद्मान्वृषभश्चाहं योगमाता तपस्विनी ।\nवायुरप्यहमव्यक्तस्त्वं गतिर्मनसूदनी ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004820069, "chapter_id": 24820, "verse_number": "७-१-३-७०", "content_sanskrit": "अहं मोचयिता लोभे निर्ममा त्वं यशस्विनि ।\nनयोऽहं सर्वकार्येषु नीतिस्त्वं कमलेक्षणा ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004820070, "chapter_id": 24820, "verse_number": "७-१-३-७१", "content_sanskrit": "अहमन्नं च भोक्ता च ओषधी त्वं निगद्यसे ।\nअहमग्निश्च धूमश्च त्वमूष्मा ज्वालमेव च ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004820071, "chapter_id": 24820, "verse_number": "७-१-३-७२", "content_sanskrit": "अहं संवर्त्तको मेघस्त्वं च धारा ह्यनेकशः ।\nअहं मुनीनां रूपेण त्वं तत्पत्नी प्रकीर्तिता ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004820072, "chapter_id": 24820, "verse_number": "७-१-३-७३", "content_sanskrit": "अहं संसारकर्त्ता वै त्वं तु सृष्टिर्वरानने ।\nअहं शुक्रास्थिरोमाणि त्वं मज्जा बलमेव च ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004820073, "chapter_id": 24820, "verse_number": "७-१-३-७४", "content_sanskrit": "पर्जन्योऽहं महाभागे त्वं वृष्टिः परमेश्वरि ।\nअहं संवत्सरो देवि त्वमृतुः परिकीर्त्तिता ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004820074, "chapter_id": 24820, "verse_number": "७-१-३-७५", "content_sanskrit": "अहं कृतयुगो देवि त्वं तु त्रेता निगद्यसे ।\nयुगोऽहं द्वापरः श्रीमांस्त्वं कलिः परमेश्वरि ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004820075, "chapter_id": 24820, "verse_number": "७-१-३-७६", "content_sanskrit": "आकाशश्चाप्यहं भद्रे पृथिवी त्वमिहोच्यसे ।\nअहमदृश्यमूर्तिश्च दृश्यमूर्तिस्त्वमुच्यसे ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004820076, "chapter_id": 24820, "verse_number": "७-१-३-७७", "content_sanskrit": "वरदोऽहं वरारोहे मंत्रस्त्वमिति चोच्यसे ।\nअहं द्रष्टा च श्रोता च त्वं दृश्या श्रुतिरेव च ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004820077, "chapter_id": 24820, "verse_number": "७-१-३-७८", "content_sanskrit": "अहं वक्ता रमयिता त्वं वाच्या परमेश्वरि ।\nअहं श्रोता च गाता च त्वं गीतिर्गेयमेव च ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004820078, "chapter_id": 24820, "verse_number": "७-१-३-७९", "content_sanskrit": "अहं त्राता च गन्धश्च त्वं तु निघ्राणमेव च ।\nअहं स्पर्शयिता कर्ता स्पर्श्यस्त्वं सृष्टमेव च ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004820079, "chapter_id": 24820, "verse_number": "७-१-३-८०", "content_sanskrit": "अहं सर्वमिदं भूतं त्वं तु देवि न संशयः ।\nस्रष्टाऽहं तव देवेशि त्वं सृजस्यखिलं जगत् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004820080, "chapter_id": 24820, "verse_number": "७-१-३-८१", "content_sanskrit": "त्वया मया च देवेशि ओतप्रोतमिदं जगत् ।\nएकधा दशधा चैव तथा शतसहस्रधा ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004820081, "chapter_id": 24820, "verse_number": "७-१-३-८२", "content_sanskrit": "ऐश्वर्येण तु संयुक्तौ सर्वप्राणि व्यवस्थितौ ।\nअहं त्वं च विशालाक्षि सततं संप्रतिष्ठितौ ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7004820082, "chapter_id": 24820, "verse_number": "७-१-३-८३", "content_sanskrit": "क्रीडामि क्रीडया देवि त्वया सार्द्धं वरानने ।\nत्वं धृतिर्धारिणी लक्ष्मीः कांता मत्प्रकृतिर्ध्रुवम् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7004820083, "chapter_id": 24820, "verse_number": "७-१-३-८४", "content_sanskrit": "रतिः स्मृतिः कामचारी मम चांगनिवासिनी ।\nदेवि किं बहुनोक्तेन प्राणेभ्योऽपि गरीयसी ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7004820084, "chapter_id": 24820, "verse_number": "७-१-३-८५", "content_sanskrit": "वरं वरय देवशि यत्किंचिन्मनसि स्थितम् ।\nतत्ते ददामि तुष्टोऽहं यद्यपि स्यात्सुदुर्ल्लभम् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7004820085, "chapter_id": 24820, "verse_number": "७-१-३-८६", "content_sanskrit": "देव्युवाच ।\nधन्याहं कृतपुण्याहं तपः सुचरितं मया ।\nयत्त्वयाऽहं जगन्नाथ हर्षदृष्ट्याऽवलोकिता ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7004820086, "chapter_id": 24820, "verse_number": "७-१-३-८७", "content_sanskrit": "यदि तुष्टोऽसि मे देव वरं दातुं ममेच्छसि ।\nतन्मे कथय देवेश सांप्रतं तीर्थविस्तरम् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7004820087, "chapter_id": 24820, "verse_number": "७-१-३-८८", "content_sanskrit": "पृथिव्यां यानि तीर्थानि पापघ्नानि शिवानि च ।\nतानि देवेश कार्त्स्न्येन यथावद्वक्तुमर्हसि ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7004820088, "chapter_id": 24820, "verse_number": "७-१-३-८९", "content_sanskrit": "ईश्वर उवाच ।\nशृणु देवि प्रवक्ष्यामि तीर्थमाहात्म्यमुत्तमम् ।\nसर्वपापहरं नृणां पुण्यं देवर्षिसत्कृतम् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7004820089, "chapter_id": 24820, "verse_number": "७-१-३-९०", "content_sanskrit": "तीर्थानां दर्शनं श्रेष्ठं स्नानं चैव सुरेश्वरि ।\nश्रवणं च प्रशंसंति सदैव ऋषिसत्तमाः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7004820090, "chapter_id": 24820, "verse_number": "७-१-३-९१", "content_sanskrit": "पृथिव्यां नैमिषं तीर्थमंतरिक्षे च पुष्करम् ।\nकेदारं च प्रयागं च विपाशा चोर्मिला तथा ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7004820091, "chapter_id": 24820, "verse_number": "७-१-३-९२", "content_sanskrit": "कर्णवेणा महादेवी चंद्रभागा सरस्वती ।\nगंगासागरसंभेदस्तथा वाराणसी शुभा ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7004820092, "chapter_id": 24820, "verse_number": "७-१-३-९३", "content_sanskrit": "अर्घतीर्थं समाख्यातं गंगाद्वारं तथैव च ।\nहिमस्थानं महातीर्थं तथा मायापुरी शुभा ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7004820093, "chapter_id": 24820, "verse_number": "७-१-३-९४", "content_sanskrit": "शतभद्रा महाभागा सिन्धुश्चैव महा नदी ।\nऐरावती च कपिला शोणश्चैव महानदः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7004820094, "chapter_id": 24820, "verse_number": "७-१-३-९५", "content_sanskrit": "पयोधिः कौशिकी तद्वत्तथा गोदावरी शुभा ।\nदेवखातं गया चैव तथा द्वारावती शुभा ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7004820095, "chapter_id": 24820, "verse_number": "७-१-३-९६", "content_sanskrit": "प्रभासं च महातीर्थं सर्वपातकनाशनम् ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7004820096, "chapter_id": 24820, "verse_number": "७-१-३-९७", "content_sanskrit": "एवमादीनि तीर्थानि यानि संति महीतले ।\nतानि दृष्ट्वा तु देवेशि पुनर्जन्म न विन्दते ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7004820097, "chapter_id": 24820, "verse_number": "७-१-३-९८", "content_sanskrit": "तिस्रः कोट्योऽर्धकोटी च तीर्थानामिह भूतले ।\nसंजातानि पवित्राणि सर्वपापहराणि च ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7004820098, "chapter_id": 24820, "verse_number": "७-१-३-९९", "content_sanskrit": "गंतव्यानि महादेवि स्वधर्मस्य विवृद्धये ।\nअशक्यानि शिवान्येवं गंतुं चैव सुरेश्वरि ।\nमनसा तानि सर्वाणि गंतव्यानि समाहितैः ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7004820099, "chapter_id": 24820, "verse_number": "७-१-३-१००", "content_sanskrit": "देव्युवाच ।\nभगवन्प्राणिनः सर्वे सर्वोपद्रवसंकुलाः ।\nअल्पायुषः सदा बद्धा व्यामोहैर्मंदिरोद्भवैः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7004820100, "chapter_id": 24820, "verse_number": "७-१-३-१०१", "content_sanskrit": "त्रेतायां द्वापरे चैव किं नु वै दारुणे कलौ ।\nतस्मात्तेषां हितार्थाय तत्तीर्थं त्वं प्रकीर्तय ।\nयेन दृष्टेन सर्वेषां तीर्थानां लभ्यते फलम् ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7004820101, "chapter_id": 24820, "verse_number": "७-१-३-१०२", "content_sanskrit": "एवमुक्तस्तु पार्वत्या प्रहस्य परमेश्वरः ।\nउवाच परया प्रीत्या वाचा मधुरया प्रभुः ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7004820102, "chapter_id": 24820, "verse_number": "७-१-३-१०३", "content_sanskrit": "ईश्वर उवाच ।\nत्वमेव हि चराः प्राणाः सर्वस्य जगतोरणिः ।\nत्वया विरहितो देवि मुहूर्तमपि नोत्सहे ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7004820103, "chapter_id": 24820, "verse_number": "७-१-३-१०४", "content_sanskrit": "शिवस्य च तथा शक्तेरंतरं नास्ति पार्वति ।\nन तदस्ति महादेवि यन्न जानासि शोभने ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7004820104, "chapter_id": 24820, "verse_number": "७-१-३-१०५", "content_sanskrit": "त्वया विनाऽहं न क्वास्मि न त्वं देवि मया विना ।\nचंद्रचंद्रिकयोर्यद्वदग्नेरुष्णत्वमेव हि ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7004820105, "chapter_id": 24820, "verse_number": "७-१-३-१०६", "content_sanskrit": "तव देवि ममापीह नास्ति चैवांतरं प्रिये ।\nसर्वं चैव सुरेशानि यथावत्कथयाम्यहम् ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7004820106, "chapter_id": 24820, "verse_number": "७-१-३-१०७", "content_sanskrit": "रहस्यानां रहस्यं तु गोपनीयं प्रयत्नतः ।\nनास्तिकाय न दातव्यं न च पापरताय च ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7004820107, "chapter_id": 24820, "verse_number": "७-१-३-१०८", "content_sanskrit": "दातव्यं भक्ति युक्ताय स्वशिष्याय सुताय वा ।\nपूर्वमेव मया ख्यातं सारात्सारतरं प्रिये ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7004820108, "chapter_id": 24820, "verse_number": "७-१-३-१०९", "content_sanskrit": "तीर्थोपनिषदः ख्याता लिंगोपनिषदस्तथा ।\nयोगोपनिषदो देवि पूर्वं वै कथितास्तव ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7004820109, "chapter_id": 24820, "verse_number": "७-१-३-११०", "content_sanskrit": "पार्वत्युवाच ।\nलेशेनापि न सिद्ध्यंति कांक्षमाणाः परं पदम् ।\nयोनीर्भ्रमंतो दृश्यंते नरा नास्तिकवृत्तयः ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7004820110, "chapter_id": 24820, "verse_number": "७-१-३-१११", "content_sanskrit": "तीर्थव्रतानि सेवन्ते प्रत्ययो नैव जायते ।\nमोहितं तु जगत्पूर्वं मिथ्याज्ञानेन शंकर ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7004820111, "chapter_id": 24820, "verse_number": "७-१-३-११२", "content_sanskrit": "किं ते फलं सुरश्रेष्ठ जगद्व्यामोहने कृते ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7004820112, "chapter_id": 24820, "verse_number": "७-१-३-११३", "content_sanskrit": "सारात्सारतरं नाथ तव प्राणप्रियं हि यत् ।\nतन्मे कथय देवेश प्रियाहं यदि ते प्रभो ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7004820113, "chapter_id": 24820, "verse_number": "७-१-३-११४", "content_sanskrit": "इत्युक्तः स तया देव्या श्रीकंठः सुरनायकः ।\nप्रहस्योवाच भगवान्गंभीरार्थमिदं वचः ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7004820114, "chapter_id": 24820, "verse_number": "७-१-३-११५", "content_sanskrit": "ईश्वर उवाच ।\nशृणुष्वावहिता भूत्वा पृष्टोऽहं यस्त्वयाऽधुना ।\nनिष्फलं तत्प्रवक्ष्यामि वस्तुतत्त्वं यथास्थितम् ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7004820115, "chapter_id": 24820, "verse_number": "७-१-३-११६", "content_sanskrit": "पूर्वमुक्तानि तीर्थानि यानि ते सुरसुंदरि ।\nतिस्रः कोट्योऽर्द्धकोटी च ब्रह्मांडे सचराचरे ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7004820116, "chapter_id": 24820, "verse_number": "७-१-३-११७", "content_sanskrit": "तेषां च गोपितं तीर्थं प्रभासं चैव सुव्रते ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7004820117, "chapter_id": 24820, "verse_number": "७-१-३-११८", "content_sanskrit": "एवमुक्तं महादेवि प्रभासं क्षेत्रमुत्तमम् ।\nदृष्ट्वा संस्काररहिताः कलौ पापेन मोहिताः ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7004820118, "chapter_id": 24820, "verse_number": "७-१-३-११९", "content_sanskrit": "राजसास्तामसाश्चैव पापोपहतचेतसः ।\nपरदारपरद्रव्यपरहिंसारता नराः ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7004820119, "chapter_id": 24820, "verse_number": "७-१-३-१२०", "content_sanskrit": "उद्वेगं च परं यांति प्रतप्यंति यतस्ततः ।\nआत्मसंभाविता मूढा मिथ्याज्ञानेन मोहिताः ।\nवर्णाश्रमविरुद्धं तु तीर्थे कु्र्वन्ति येऽधमाः ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7004820120, "chapter_id": 24820, "verse_number": "७-१-३-१२१", "content_sanskrit": "तीर्थयात्रां प्रकुर्वंति दंभेन कपटेन च ।\nतीर्थे मृता न सिध्यंति ते नरा वरवर्णिनि ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7004820121, "chapter_id": 24820, "verse_number": "७-१-३-१२२", "content_sanskrit": "एतदर्थं मया देवि तीर्थानि विविधानि च ।\nलिंगानि चैव सुश्रोणि गोपितानि प्रयत्नतः ।\nन सिद्धिदानि देवेशि कलौ कल्मषकारिणाम् ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7004820122, "chapter_id": 24820, "verse_number": "७-१-३-१२३", "content_sanskrit": "ये नरास्तु जितक्रोधा जितलोभा जितेंद्रियाः ।\nब्राह्मणाः क्षत्रिया वैश्याः शूद्राश्चादम्भमत्सराः ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7004820123, "chapter_id": 24820, "verse_number": "७-१-३-१२४", "content_sanskrit": "मद्भावभाविता देवि तीर्थं सेवंति सुव्रताः ।\nतेषां चैव हितार्थाय कथयामि यशश्विनि ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7004820124, "chapter_id": 24820, "verse_number": "७-१-३-१२५", "content_sanskrit": "प्रभासमिति विख्यातं क्षेत्रं त्रैलोक्यवंदितम् ।\nतत्क्षेत्रं नैव जानंति मम मायाविमोहिताः ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7004820125, "chapter_id": 24820, "verse_number": "७-१-३-१२६", "content_sanskrit": "परोहं त्वेकचित्तैश्च बहुजन्मभिरर्चितः ।\nते विदंति परं क्षेत्रं प्रभासं पापनाशनम् ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7004820126, "chapter_id": 24820, "verse_number": "७-१-३-१२७", "content_sanskrit": "मद्भावभाविता देवि मम व्रतनिषेविणः ।\nतेषां प्रभासिकं क्षेत्रं विदितं नात्र संशयः ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7004820127, "chapter_id": 24820, "verse_number": "७-१-३-१२८", "content_sanskrit": "यमैश्च नियमैर्युक्ता अहंकारविवर्ज्जिताः ।\nतेषामर्थे वदिष्यामि तव प्रश्नं सुदुर्ल्लभम् ।\nब्रह्मविष्ण्विन्द्रदेवानां पुराणं कथितं मया ॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7004820128, "chapter_id": 24820, "verse_number": "७-१-३-१२९", "content_sanskrit": "सोऽहं देवि वदिष्यामि कर्णं देहि वरानने ।\nपृथिव्यामपि सर्वेषां तीर्थानां सुरसुंदरि ॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7004820129, "chapter_id": 24820, "verse_number": "७-१-३-१३०", "content_sanskrit": "एकं मे वल्लभं तत्र प्रभासं क्षेत्रमुत्तमम् ।\nतस्मिंश्चैव महाक्षेत्रे तीर्थैः सोमेन पूजितः ।\nवरांस्तस्मै प्रदायाथ सदैकांते स्थितो ह्यहम् ॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7004820130, "chapter_id": 24820, "verse_number": "७-१-३-१३१", "content_sanskrit": "तेन गुह्यं कृतं स्थानं तव देवि प्रकाशितम् ।\nतत्र मे योगयुक्तस्य दिव्यं लिंगं बभूव ह ॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7004820131, "chapter_id": 24820, "verse_number": "७-१-३-१३२", "content_sanskrit": "दिव्यतेजस्समा युक्तं वह्निमेखलमंडितम् ।\nलक्षमात्रस्थितं शांतं दुर्निरीक्ष्यं तु मानवैः ॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7004820132, "chapter_id": 24820, "verse_number": "७-१-३-१३३", "content_sanskrit": "इच्छाज्ञानक्रियाख्याश्च तिस्रो वै शक्तयश्च याः ।\nतस्माल्लिंगात्समुत्पन्ना जगत्कर्तृत्वहेतवे ॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 7004820133, "chapter_id": 24820, "verse_number": "७-१-३-१३४", "content_sanskrit": "तस्मिंल्लिंगे लयं याति जगदेतच्चराचरम् ।\nपुनस्तेनैव संभूतं दृश्यते सचराचरम् ॥१३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 7004820134, "chapter_id": 24820, "verse_number": "७-१-३-१३५", "content_sanskrit": "गुह्यं चैव तु संभूतं न कश्चिद्वेद तत्परम् ।\nजन्माभ्यासेन तल्लिंगं ज्ञायते भुवि मानवैः ॥१३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 7004820135, "chapter_id": 24820, "verse_number": "७-१-३-१३६", "content_sanskrit": "क्षेत्रं प्रभासिकं प्रोक्तं क्षेत्रज्ञोऽहं न संशयः ।\nतत्र सोमेशनामाहमस्मिन्क्षेत्रं वरानने ॥१३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 7004820136, "chapter_id": 24820, "verse_number": "७-१-३-१३७", "content_sanskrit": "ममांशसंभवा ये च अस्मिन्क्षेत्रे समुद्भवाः ।\nतेषां तु विदितं लिंगं पूर्वकल्पे तु भैरवम् ॥१३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 7004820137, "chapter_id": 24820, "verse_number": "७-१-३-१३८", "content_sanskrit": "अन्यैरपि युगैर्देवि इदं लिंगं सुदुर्लभम् ।\nघोरे कलियुगे पापे विशेषेण च दुर्लभम् ॥१३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 7004820138, "chapter_id": 24820, "verse_number": "७-१-३-१३९", "content_sanskrit": "अन्यन्निदर्शनं तत्र तत्प्रवक्ष्यामि पार्वति ॥१३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 7004820139, "chapter_id": 24820, "verse_number": "७-१-३-१४०", "content_sanskrit": "कलौ युगे महाघोरे हेतुवादरता नराः ।\nवदिष्यंति महापापाः सर्वे पाखण्डसंस्थिताः ॥१४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 7004820140, "chapter_id": 24820, "verse_number": "७-१-३-१४१", "content_sanskrit": "मिथ्या चैतत्कृतं सर्वं मूर्खैश्चापि प्रकीर्तितम् ।\nक्व क्षेत्रं क्व प्रभावश्च कुत्र वै सन्ति देवताः ॥१४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 7004820141, "chapter_id": 24820, "verse_number": "७-१-३-१४२", "content_sanskrit": "सर्वं चापि तथालीकं मूढैश्चापि प्रकीर्तितम् ॥१४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}, {"id": 7004820142, "chapter_id": 24820, "verse_number": "७-१-३-१४३", "content_sanskrit": "एवं मूर्खा वदिष्यंति प्रहसिष्यन्ति चापरे ।\nनारका नास्तिका लोकाः पापोपहतचेतसः ।\nसिद्धिं नैव प्रयास्यंति संप्राप्ते तु कलौ युगे ॥१४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143}, {"id": 7004820143, "chapter_id": 24820, "verse_number": "७-१-३-१४४", "content_sanskrit": "तीर्थे चैव मृता ये तु शिवनिन्दापरायणाः ।\nतिर्यग्योनिप्रसूताश्च दृश्यन्ते सर्वयोनिषु ॥१४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144}, {"id": 7004820144, "chapter_id": 24820, "verse_number": "७-१-३-१४५", "content_sanskrit": "एतस्मात्कारणाद्देवि तीर्थे चैव सुदुःखिताः ।\nदृश्यन्ते युगमाहात्म्यात्सत्यशौचविवर्जिताः ॥१४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 145}, {"id": 7004820145, "chapter_id": 24820, "verse_number": "७-१-३-१४६", "content_sanskrit": "इदं हि कारणं प्रोक्तं क्षेत्राणां चैव गोपने ।\nएतत्ते कथितं सर्वं सिद्धिर्येन सुदुर्ल्लभा ॥१४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 146}, {"id": 7004820146, "chapter_id": 24820, "verse_number": "७-१-३-१४७", "content_sanskrit": "युगेयुगे तु तीर्थानि कीर्तितानि सुरेश्वरि ।\nतेषां मे वल्लभं देवि प्रभासं क्षेत्रमेव च ॥१४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 147}, {"id": 7004820147, "chapter_id": 24820, "verse_number": "७-१-३-१४८", "content_sanskrit": "इत्येतत्कथितं देवि रहस्यं पापनाशनम् ।\nक्षेत्रबीजं महादेवि किमन्यत्परिपृच्छसि ॥१४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 148}, {"id": 7004820148, "chapter_id": 24820, "verse_number": "७-१-३-१४९", "content_sanskrit": "इदं महापातकनाशनं ये श्रोष्यंति वै क्षेत्रमहाप्रभावम् ।\nते चापि यास्यन्ति मम प्रभावात्त्रिविष्टपं पुण्यजनाधिवासम् ॥१४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 149}, {"id": 7004820149, "chapter_id": 24820, "verse_number": "७-१-३-१५०", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां सप्तमे प्रभास खण्डे प्रभासक्षेत्रमाहात्म्ये देवीप्रश्नवर्णनं नाम तृतीयोऽध्यायः ॥१५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 150}]