[{"id": 5000586000, "chapter_id": 9586, "verse_number": "७-५१-१", "content_sanskrit": "तथा सञ्चोदितः सूतो लक्ष्मणेन महात्मना ।\nतद्वाक्यमृषिणा प्रोक्तं व्याहर्तुमुपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000586001, "chapter_id": 9586, "verse_number": "७-५१-२", "content_sanskrit": "पुरा नाम्ना हि दुर्वासा अत्रेः पुत्रो महामुनिः ।\nवसिष्ठस्याश्रमे पुण्ये वार्षिक्यं समुवास ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000586002, "chapter_id": 9586, "verse_number": "७-५१-३", "content_sanskrit": "तमाश्रमं महातेजाः पिता ते सुमहायशाः ।\nपुरोहितं महात्मानं दिदृक्षुरगमस्त्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000586003, "chapter_id": 9586, "verse_number": "७-५१-४", "content_sanskrit": "स दृष्ट्वा सूर्यसङ्काशं ज्वलन्तमिव तेजसा ।\nउपविष्टं वसिष्ठस्य सव्यपार्श्वे महामुनिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000586004, "chapter_id": 9586, "verse_number": "७-५१-५", "content_sanskrit": "तौ मुनी तापसश्रेष्ठौ विनीतो ह्यभिवादयत् ।\nस ताभ्यां पूजितो राजा स्वागतेनासनेन च ॥\nपाद्येन फलमूलैश्च उवास मुनिभिः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000586005, "chapter_id": 9586, "verse_number": "७-५१-६", "content_sanskrit": "तेषां तत्रोपविष्टानां तास्ताः सुमधुराः कथाः ।\nबभूवुः परमर्षीणां मध्यादित्यगते ऽहनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000586006, "chapter_id": 9586, "verse_number": "७-५१-७", "content_sanskrit": "ततः कथायां कस्याञ्चित्प्राञ्जलिः प्रग्रहो नृपः ।\nउवाच तं महात्मानमत्रेः पुत्रं तपोधनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000586007, "chapter_id": 9586, "verse_number": "७-५१-८", "content_sanskrit": "भगवन्किं प्रमाणेन मम वंशो भविष्यति ।\nकिमायुश्च हि मे रामः पुत्राश्चान्ये किमायुषः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000586008, "chapter_id": 9586, "verse_number": "७-५१-९", "content_sanskrit": "रामस्य च सुता ये स्युस्तेषामायुः कियद्भवेत् ।\nकाम्यया भगवन्बूहि वंशस्यास्य गतिं मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000586009, "chapter_id": 9586, "verse_number": "७-५१-१०", "content_sanskrit": "तच्छ्रुत्वा व्याहृतं वाक्यं राज्ञो दशरथस्य च ।\nदुर्वासाः सुमहातेजा व्याहर्तुमुपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000586010, "chapter_id": 9586, "verse_number": "७-५१-११", "content_sanskrit": "शृणु राजन्पुरावृत्तं तदा देवासुरे युधि ।\nदैत्याः सुरैर्भर्त्स्यमाना भृगुपत्नीं समाश्रिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000586011, "chapter_id": 9586, "verse_number": "७-५१-१२", "content_sanskrit": "तया दत्ताभयास्तत्र न्यवसन्नभयास्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000586012, "chapter_id": 9586, "verse_number": "७-५१-१३", "content_sanskrit": "तया परिगृहीतांस्तान्दृष्ट्वा क्रुद्धः सुरेश्वरः ।\nचक्रेण शितधारेण भृगुपत्न्याः शिरो ऽहरत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000586013, "chapter_id": 9586, "verse_number": "७-५१-१४", "content_sanskrit": "ततस्तां निहतां दृष्ट्वा पत्नीं भृगुकुलोद्वहः ।\nशशाप सहसा क्रुद्धो विष्णुं रिपुकुलार्दनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000586014, "chapter_id": 9586, "verse_number": "७-५१-१५", "content_sanskrit": "यस्मादवध्यां मे पत्नीमवधीः क्रोधमूर्च्छितः ।\nतस्मात्त्वं मानुषे लोके जनिष्यसि जनार्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000586015, "chapter_id": 9586, "verse_number": "७-५१-१६", "content_sanskrit": "तत्र पत्नीवियोगं त्वं प्राप्स्यसे बहुवार्षिकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000586016, "chapter_id": 9586, "verse_number": "७-५१-१७", "content_sanskrit": "शापाभिहतचेतास्स स्वात्मना भावितो ऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000586017, "chapter_id": 9586, "verse_number": "७-५१-१९", "content_sanskrit": "अर्चयामास तं देवं भृगुः शापेन पीडितः ।\nतपसाराधितो देवो ह्यब्रवीद्भक्तवत्सलः ।\nलोकानां संहितार्थं तु तं शापं ग्राह्यमुक्तवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000586018, "chapter_id": 9586, "verse_number": "७-५१-२०", "content_sanskrit": "इति शप्तो महातेजा भृगुणा पूर्वजन्मनि ।\nइहागतो हि पुत्रत्वं तव पार्थिवसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000586019, "chapter_id": 9586, "verse_number": "७-५१-२१", "content_sanskrit": "राम इत्यभिविख्यातस्त्रिषु लोकेषु मानद ।\nतत्फलं प्राप्स्यते चापि भृगुशापकृतं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000586020, "chapter_id": 9586, "verse_number": "७-५१-२२", "content_sanskrit": "अयोध्यायाः पती रामो दीर्घकालं भविष्यति ।\nसुखिनश्च समृद्धाश्च भविष्यन्त्यस्य ये ऽनुगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000586021, "chapter_id": 9586, "verse_number": "७-५१-२३", "content_sanskrit": "दश वर्षसहस्राणि दश वर्षशतानि च ।\nरामो राज्यमुपासित्वा ब्रह्मलोकं गमिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000586022, "chapter_id": 9586, "verse_number": "७-५१-२४", "content_sanskrit": "समृद्धैश्चाश्वमेधैश्च इष्ट्वा परमदुर्जयः ।\nराजवंशांश्च बहुशो बहून्संस्थापयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000586023, "chapter_id": 9586, "verse_number": "७-५१-२५", "content_sanskrit": "द्वौ पुत्रौ तु भविष्येते सीतायां राघवस्य तु ।\nअन्यत्र न त्वयोध्यायां सत्यमेतन्नसंशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000586024, "chapter_id": 9586, "verse_number": "७-५१-२६", "content_sanskrit": "सीतायाश्च ततः पुत्रावभिषेक्ष्यति राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000586025, "chapter_id": 9586, "verse_number": "७-५१-२७", "content_sanskrit": "स सर्वमखिलं राज्ञो वंशस्याह गतागतम् ।\nआख्याय सुमहातेजास्तूष्णीमासीन्महामुनिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000586026, "chapter_id": 9586, "verse_number": "७-५१-२८", "content_sanskrit": "तूष्णीम्भूते तदा तस्मिन्राजा दशरथो मुनौ ।\nअभिवाद्य महात्मानौ पुनरायात्पुरोत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000586027, "chapter_id": 9586, "verse_number": "७-५१-२९", "content_sanskrit": "एतद्वचो मया तत्र मुनिना व्याहृतं पुरा ।\nश्रुतं हृदि च निक्षिप्तं नान्यथा तद्भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000586028, "chapter_id": 9586, "verse_number": "७-५१-३०", "content_sanskrit": "एवं गते न सन्तापं कर्तुमर्हसि राघव ।\nसीतार्थे राघवार्थे वा दृढो भव नरोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000586029, "chapter_id": 9586, "verse_number": "७-५१-३१", "content_sanskrit": "श्रुत्वा तु व्याहृतं वाक्यं सूतस्य परमाद्भुतम् ।\nप्रहर्षमतुलं लेभे साधु साध्विति चाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000586030, "chapter_id": 9586, "verse_number": "७-५१-३२", "content_sanskrit": "ततः संवदतोरेवं सूतलक्ष्मणयोः पथि ।\nअस्तमर्के गते वासं केशिन्यां तावथोषतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]