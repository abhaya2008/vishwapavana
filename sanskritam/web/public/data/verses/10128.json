[{"id": 6000128000, "chapter_id": 10128, "verse_number": null, "content_sanskrit": "अथ नवमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000128001, "chapter_id": 10128, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_009/BhP_06.009.001.m4a", "display_order": 2}, {"id": 6000128002, "chapter_id": 10128, "verse_number": "६-९-१", "content_sanskrit": "तस्यासन् विश्वरूपस्य शिरांसि त्रीणि भारत।\nसोमपीथं सुरापीथमन्नादमिति शुश्रुम॥ ६/९/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_009/BhP_06.009.002.m4a", "display_order": 3, "topics": [{"text": "इन्द्रेण विश्वरूपाचार्यहननम्", "range": "१–१०"}]}, {"id": 6000128003, "chapter_id": 10128, "verse_number": "६-९-२", "content_sanskrit": "स वै बर्हिषि देवेभ्यो भागं प्रत्यक्षमुच्चकैः।\nअददाद् यस्य पितरो देवास्तं प्रश्नयन्नृप॥ ६/९/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_009/BhP_06.009.003.m4a", "display_order": 4}, {"id": 6000128004, "chapter_id": 10128, "verse_number": "६-९-३", "content_sanskrit": "स एव हि ददौ भागं परोक्षमसुरान् प्रति।\nयजमानोऽवहद् भागं मातृस्नेहवशानुगः॥ ६/९/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_009/BhP_06.009.004.m4a", "display_order": 5}, {"id": 6000128005, "chapter_id": 10128, "verse_number": "६-९-४", "content_sanskrit": "तद् देवहेलनं तस्य धर्मालीकं सुरेश्वरः।\nआलक्ष्य तरसा भीतस्तच्छीर्षाण्यच्छिनद् रुषा॥ ६/९/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_009/BhP_06.009.005.m4a", "display_order": 6}, {"id": 6000128006, "chapter_id": 10128, "verse_number": "६-९-५", "content_sanskrit": "सोमपीथं तु यत् तस्य शिर आसीत् कपिञ्जलः।\nकलविङ्कः सुरापीथमन्नादं यत् स तित्तिरिः॥ ६/९/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_009/BhP_06.009.006.m4a", "display_order": 7}, {"id": 6000128007, "chapter_id": 10128, "verse_number": "६-९-६", "content_sanskrit": "ब्रह्महत्यामञ्जलिना जग्राह यदपीश्वरः। संवत्सरान्ते तदघं भूताशंसाविशुद्धये।\nभूम्यम्बुद्रुमयोषिद्भ्यश्चतुर्धा व्यभजद्धरिः॥ ६/९/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_009/BhP_06.009.007.m4a", "display_order": 8}, {"id": 6000128008, "chapter_id": 10128, "verse_number": "६-९-७", "content_sanskrit": "भूमिस्तुरीयं जग्राह खातपूरवरेण वै।\nईरणं ब्रह्महत्याया रूपं भूमौ प्रदृश्यते॥ ६/९/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_009/BhP_06.009.008.m4a", "display_order": 9}, {"id": 6000128009, "chapter_id": 10128, "verse_number": "६-९-८", "content_sanskrit": "तुरीयं छेदरोहेण वरेण जगृहुर्द्रुमाः।\nतेषां निर्यासरूपेण ब्रह्महत्या प्रदृश्यते॥ ६/९/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_009/BhP_06.009.009.m4a", "display_order": 10}, {"id": 6000128010, "chapter_id": 10128, "verse_number": "६-९-९", "content_sanskrit": "शश्वत्कामवरेणांहस्तुरीयं जगृहुः स्‍त्रियः।\nरजोरूपेण तास्वंहो मासि मासि प्रदृश्यते॥ ६/९/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_009/BhP_06.009.010.m4a", "display_order": 11}, {"id": 6000128011, "chapter_id": 10128, "verse_number": "६-९-१०", "content_sanskrit": "द्रव्यभूयोवरेणापस्तुरीयं जगृहुर्मलम्।\nतासु बुद्बुदफेनाभ्यां दृष्टं तद्धरिकिल्बिषम्॥ ६/९/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_009/BhP_06.009.011.m4a", "display_order": 12}, {"id": 6000128012, "chapter_id": 10128, "verse_number": "६-९-११", "content_sanskrit": "हतपुत्रस्ततस्त्वष्टा जुहावेन्द्राय शत्रवे।\nइन्द्रशत्रो विवर्धस्व, मा चिरं जहि विद्विषम्॥ ६/९/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_009/BhP_06.009.012.m4a", "display_order": 13, "topics": [{"text": "स्वपुत्रवधरुष्टेन त्वष्ट्रा इन्द्रहननाय वृत्रोत्पादनम्", "range": "११–१८"}]}, {"id": 6000128013, "chapter_id": 10128, "verse_number": "६-९-१२", "content_sanskrit": "अथान्वाहार्यपचनादुत्थितो घोरदर्शनः।\nकृतान्त इव लोकानां युगान्तसमये यथा॥ ६/९/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_009/BhP_06.009.013.m4a", "display_order": 14}, {"id": 6000128014, "chapter_id": 10128, "verse_number": "६-९-१३", "content_sanskrit": "विष्वग्विवर्धमानं तमिषुमात्रं दिने दिने। दग्धशैलप्रतीकाशं सन्ध्याभ्रानीकवाससम्।\nतप्तताम्रशिखाश्मश्रुं मध्याह्नार्कोग्रलोचनम्॥ ६/९/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_009/BhP_06.009.014.m4a", "display_order": 15}, {"id": 6000128015, "chapter_id": 10128, "verse_number": "६-९-१४", "content_sanskrit": "देदीप्यमानत्रिशिखे शूल आरोप्य रोदसी।\nनृत्यन्तमुन्नदन्तं च चालयन्तं पदा महीम्॥ ६/९/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_009/BhP_06.009.015.m4a", "display_order": 16}, {"id": 6000128016, "chapter_id": 10128, "verse_number": "६-९-१५", "content_sanskrit": "दरीगम्भीरवक्त्रेण पिबन्तं च नभस्तलम्।\nलिहन्तं जिह्वयर्क्षाणि ग्रसन्तं भुवनत्रयम्॥ ६/९/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_009/BhP_06.009.016.m4a", "display_order": 17}, {"id": 6000128017, "chapter_id": 10128, "verse_number": "६-९-१६", "content_sanskrit": "महता रौद्रदंष्ट्रेण जृम्भयन्तं मुहुर्मुहुः।\nवित्रस्ता दुद्रुवुर्लोका वीक्ष्य सर्वे दिशो दश॥ ६/९/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_009/BhP_06.009.017.m4a", "display_order": 18}, {"id": 6000128018, "chapter_id": 10128, "verse_number": "६-९-१७", "content_sanskrit": "येनावृता इमे लोकास्तमसा त्वाष्ट्रमूर्तिना।\nस वै वृत्र इति प्रोक्तः पापः परमदारुणः॥ ६/९/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_009/BhP_06.009.018.m4a", "display_order": 19}, {"id": 6000128019, "chapter_id": 10128, "verse_number": "६-९-१८", "content_sanskrit": "तं निजघ्नुरभिद्रुत्य सगणा विबुधर्षभाः।\nस्वैः स्वैर्दिव्यास्‍त्रशस्‍त्रौघैः सोऽग्रसत् तानि कृत्स्नशः॥ ६/९/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_009/BhP_06.009.019.m4a", "display_order": 20}, {"id": 6000128020, "chapter_id": 10128, "verse_number": "६-९-१९", "content_sanskrit": "ततस्ते विस्मिताः सर्वे विषण्णा ग्रस्ततेजसः।\nप्रत्यञ्चमादिपुरुषमुपतस्थुः समाहिताः॥ ६/९/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_009/BhP_06.009.020.m4a", "display_order": 21, "topics": [{"text": "वृत्रत्रस्तै-र्देवैर्भगवत्स्तुतिः", "range": "१९–३५"}]}, {"id": 6000128021, "chapter_id": 10128, "verse_number": null, "content_sanskrit": "देवा ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_009/BhP_06.009.021.m4a", "display_order": 22}, {"id": 6000128022, "chapter_id": 10128, "verse_number": "६-९-२०", "content_sanskrit": "वाय्वम्बराग्न्यप्क्षितयस्‍त्रिलोका ब्रह्मादयो ये वयमुद्विजन्तः।\nहराम यस्मै बलिमन्तकोऽसौ बिभेति यस्मादरणं ततो नः॥ ६/९/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_009/BhP_06.009.022.m4a", "display_order": 23}, {"id": 6000128023, "chapter_id": 10128, "verse_number": "६-९-२१", "content_sanskrit": "अविस्मितं तं परिपूर्णकामं स्वेनैव लाभेन समं प्रशान्तम्।\nविनोपसर्पत्यपरं हि बालिशः श्वलाङ्गुलेनातितितर्ति सिन्धुम्॥ ६/९/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_009/BhP_06.009.023.m4a", "display_order": 24}, {"id": 6000128024, "chapter_id": 10128, "verse_number": "६-९-२२", "content_sanskrit": "यस्योरुशृृङ्गे जगतीं स्वनावं मनुर्यथाऽऽबध्य ततार दुर्गम्।\nस एव नस्त्वाष्ट्रभयाद् दुरन्तात् त्राता श्रितान् वारिचरोऽपि नूनम्॥ ६/९/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_009/BhP_06.009.024.m4a", "display_order": 25}, {"id": 6000128025, "chapter_id": 10128, "verse_number": "६-९-२३", "content_sanskrit": "पुरा स्वयम्भूरपि संयमाम्भस्युदीर्णवातोर्मिरवैः कराले।\nएकोऽरविन्दात् पतितस्ततार तस्माद् भयाद् येन स नोऽस्तु पारः॥ ६/९/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_009/BhP_06.009.025.m4a", "display_order": 26}, {"id": 6000128026, "chapter_id": 10128, "verse_number": "६-९-२४", "content_sanskrit": "य एक ईशो निजमायया नः ससर्ज येनानुसृजाम विश्वम्।\nवयं च यस्यापि पुरः समेताः पश्याम लिङ्गं पृथगीशमानिनः॥ ६/९/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_009/BhP_06.009.026.m4a", "display_order": 27}, {"id": 6000128027, "chapter_id": 10128, "verse_number": "६-९-२५", "content_sanskrit": "यो नः सपत्नैर्भृशमर्द्यमानान् देवर्षितिर्यङ्‌नृषु नित्य एव।\nकृतावतारस्तनुभिः स्वमायया कृत्वाऽऽत्मसात् पाति युगे युगे च॥ ६/९/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_009/BhP_06.009.027.m4a", "display_order": 28}, {"id": 6000128028, "chapter_id": 10128, "verse_number": "६-९-२६", "content_sanskrit": "तमेव देवा वयमात्मदैवतं परं प्रधानं पुरुषं विश्वमाद्यम्।\nव्रजाम सर्वे शरणं शरण्यं स्वानां स नो धास्यति शं महात्मा॥ ६/९/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_009/BhP_06.009.028.m4a", "display_order": 29}, {"id": 6000128029, "chapter_id": 10128, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_009/BhP_06.009.029.m4a", "display_order": 30}, {"id": 6000128030, "chapter_id": 10128, "verse_number": "६-९-२७", "content_sanskrit": "इति तेषां महाराज सुराणामुपतिष्ठताम्।\nप्रतीच्यां दिश्यभूदाविः शङ्खचक्रगदाधरः॥ ६/९/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_009/BhP_06.009.030.m4a", "display_order": 31}, {"id": 6000128031, "chapter_id": 10128, "verse_number": "६-९-२८", "content_sanskrit": "आत्मतुल्यैः षोडशभिर्विना श्रीवत्सकौस्तुभौ।\nपर्युपासितमुन्निद्रशरदम्बुरुहेक्षणम्॥ ६/९/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_009/BhP_06.009.031.m4a", "display_order": 32}, {"id": 6000128032, "chapter_id": 10128, "verse_number": "६-९-२९", "content_sanskrit": "दृष्ट्वा तममराः सर्वे ईक्षणाह्लादविक्लवाः।\nदण्डवत् पतिता भूमौ शनैरुत्थाय तुष्टुवुः॥ ६/९/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_009/BhP_06.009.032.m4a", "display_order": 33}, {"id": 6000128033, "chapter_id": 10128, "verse_number": null, "content_sanskrit": "देवा ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_009/BhP_06.009.033.m4a", "display_order": 34}, {"id": 6000128034, "chapter_id": 10128, "verse_number": "६-९-३०", "content_sanskrit": "नमस्ते यज्ञवीर्याय वयसे उत ते नमः।\nनमस्ते अस्तु चक्राय नमोऽस्तु पुरुहूतये॥ ६/९/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_009/BhP_06.009.034.m4a", "display_order": 35}, {"id": 6000128035, "chapter_id": 10128, "verse_number": "६-९-३१", "content_sanskrit": "यत् ते गतीनां तिसृणामीशितुः परमं पदम्।\nनार्वाचीनो विसर्गस्य धातुर्वेदितुमर्हति॥ ६/९/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_009/BhP_06.009.035.m4a", "display_order": 36}, {"id": 6000128036, "chapter_id": 10128, "verse_number": "६-९-३२", "content_sanskrit": "ओं नमस्ते भगवन् नारायण वासुदेवादिपुरुष महापुरुष महानुभाव परममङ्गल परमकल्याण परमकारुणिक परमहंसपरिव्राजकैः परमेणात्मयोगसमाधिना परिभावितपरिस्फुटितपारमहंस्य-धर्मेणोद्घाटिततमःकपाटद्वारेणापावृते आत्मलोके स्वयमुपलब्धो निजसुखानुभवो भवान् दुरवबोध इव तव विहारयोगो यदशरणोऽशरीर इदमनपेक्षितास्मत्समवायः स आत्मनैवाविक्रियमाणेन सगुणमगुणः सृजसि पासि हंसि॥ ६/९/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_009/BhP_06.009.036.m4a", "display_order": 37}, {"id": 6000128037, "chapter_id": 10128, "verse_number": null, "content_sanskrit": "अथ तत्र भगवान् किं देवदत्तवदिह गुणविसर्गापतितः पारतन्त्र्येण स्वकृतकुशलाकुशल-फलमुपाददाति आहोस्विदात्माराम उपशमशीलः समञ्जसदर्शन उदास्त इति ह वाव न विदामः।\nन हि विरोध उभयं भगवत्यपरिगणितगुणगण ईश्वर अनवगाह्यमाहात्म्ये अर्वाचीनविकल्पवितर्क-विचारप्रमाणाभासकुतर्कशास्‍त्रकलिलान्तःकरणदुरवग्रहवादिनां च विवादानवसरे उपरतसमस्त-मायामये केवलस्वात्ममायामन्तर्धाय को नु दुर्घट इव भवति स्वरूपद्वयाभावात्। समविषममतीनां मतमनुसरसि यथा रज्जुखण्डः सर्पादिधियाम्।\nस एव नः सर्ववस्तुषु वस्तुस्वरूपः सर्वेश्वरः सकलजगत्कारणकारणभूतः सर्वप्रत्यगात्मत्वात् सर्वगुणाभासोपलक्षित एक एव पर्यवशेषितः॥ ६/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_009/BhP_06.009.037.m4a", "display_order": 38}, {"id": 6000128038, "chapter_id": 10128, "verse_number": "६-९-३३", "content_sanskrit": "अथ ह वाव तव महिमामहामृतरससमुद्रविप्लुषाऽसकृल्लीढया स्वमनसि निष्यन्दमानानवरतसुखेन विस्मारितदृष्टश्रुतविषयसुखलेशाभासाः परमभागवता एकान्तिनो भगवति सर्वभूतप्रियसुहृदि सर्वात्मनि निरन्तरनिर्वृतमनसः कथमु ह वा एते मधुमथन पुनः स्वार्थकुशला ह्यात्मप्रियसुहृदः साधवस्त्वच्चरणाम्बुजानुसेवां विसृजन्ति न यत्र पुनरयं संसारपरिवर्तः।\nत्रिभुवनात्मभवन त्रिविक्रम त्रिनयन त्रिलोकमनोहरानुभाव तवैव विभूतयोऽभूवन् दितिजदनुजादयश्चापि तेषामनुपक्रमसमयोऽयमिति स्वात्ममायया सुरनरमृगमिश्रित-जलचराकृतिभिः यथाऽपराधं दण्डं दधर्थावतीर्य॥ ६/९/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_009/BhP_06.009.038.m4a", "display_order": 39}, {"id": 6000128039, "chapter_id": 10128, "verse_number": null, "content_sanskrit": "एवमेनमपि भगवन् जहि त्वाष्ट्रं वृत्रासुरं यदि मन्यसे । अस्माकं तावकानां तव चरणनलिनयुगलध्यानानुबद्धहृदयनिगडानां स्वलिङ्गविधारणेनात्मसात्कृतानाम् अनुकम्पानु- रञ्जितविशदरुचिरशिशिरस्मितावलोकनेन विगलितमधुरमुखरितवचसाऽमृतकलया चान्तस्ताप-मनघार्हसि शमयितुम् ।\nअथ भगवंस्तवास्माभिरखिलजगदुत्पत्तिस्थितिलयनिमित्तायमानदिव्यमाया विनोदस्य सकलजीवनिकायानामन्तर्हृदयेषु बहिरपि च ब्रह्म प्रत्यगात्मस्वरूपेण प्रधानरूपेण यथादेशकालदेहावस्थानविशेषं तदुपादानोपलम्भकतयाऽनुभवतः सर्वप्रत्ययसाक्षिणः आकाश-शरीरस्य साक्षात् परब्रह्मणः परमात्मनः कियानिह वा अर्थविशेषो विज्ञापनीयः स्याद् विस्फुलिङ्गादिभिरिव हिरण्यरेतसः । अत एव स्वयं तदुपकल्पयास्माकं भगवतः परमगुरोस्तव चरणशतपलाशच्छायां विविधवृजिनसंसारपरिश्रमोपशमनीमुपसन्नानां वयं यत्कामेनोपसादिताः॥ ६/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_009/BhP_06.009.039.m4a", "display_order": 40}, {"id": 6000128040, "chapter_id": 10128, "verse_number": "६-९-३४", "content_sanskrit": "अथो ईश जहि त्वाष्ट्रं ग्रसन्तं भुवनत्रयम्।\nग्रस्तानि येन नः कृष्ण तेजांस्यस्‍त्रायुधानि च॥ ६/९/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_009/BhP_06.009.040.m4a", "display_order": 41}, {"id": 6000128041, "chapter_id": 10128, "verse_number": "६-९-३५", "content_sanskrit": "हंसाय दभ्रनिलयाय निरीक्षकाय कृष्णाय मृष्टयशसे निरुपक्रमाय।\nसत्संग्रहाय भवपान्थनिजाश्रयाय शश्वद् वरिष्ठगतये हरये नमस्ते॥ ६/९/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_009/BhP_06.009.041.m4a", "display_order": 42}, {"id": 6000128042, "chapter_id": 10128, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_009/BhP_06.009.042.m4a", "display_order": 43}, {"id": 6000128043, "chapter_id": 10128, "verse_number": "६-९-३६", "content_sanskrit": "अथैवमीडितो राजन् सादरं त्रिदशैर्हरिः।\nस्वमुपस्थानमाकर्ण्य प्राह तानभिनन्दितः॥ ६/९/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_009/BhP_06.009.043.m4a", "display_order": 44, "topics": [{"text": "भगवता देवान् प्रति दधीचेरस्थीनि संगृह्य वज्रायुधनिर्माणे आज्ञापनम्", "range": "३६–४५"}]}, {"id": 6000128044, "chapter_id": 10128, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_009/BhP_06.009.044.m4a", "display_order": 45}, {"id": 6000128045, "chapter_id": 10128, "verse_number": "६-९-३७", "content_sanskrit": "प्रीतोऽहं वः सुरश्रेष्ठा मदुपस्थानविद्यया।\nआत्मैश्वर्यस्मृतिः पुंसां भक्तिश्चैव यया मयि॥ ६/९/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_009/BhP_06.009.045.m4a", "display_order": 46}, {"id": 6000128046, "chapter_id": 10128, "verse_number": "६-९-३८", "content_sanskrit": "किं दुरापं मयि प्राप्ते तथाऽपि विबुधर्षभाः।\nमय्येकान्तमतिर्नान्यन्मत्तो वाञ्छति तत्त्ववित्॥ ६/९/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_009/BhP_06.009.046.m4a", "display_order": 47}, {"id": 6000128047, "chapter_id": 10128, "verse_number": "६-९-३९", "content_sanskrit": "न वेद कृपणः श्रेय आत्मनो गुणवस्तुदृक्।\nतस्य तानिच्छतो यच्छे यदि सोऽपि तथाविधः॥ ६/९/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_009/BhP_06.009.047.m4a", "display_order": 48}, {"id": 6000128048, "chapter_id": 10128, "verse_number": "६-९-४०", "content_sanskrit": "स्वयं निःश्रेयसं विद्वान् न वक्त्यज्ञाय कर्मभिः।\nन राति रोगिणोऽपथ्यं वाञ्छतोऽपि भिषक्तमः॥ ६/९/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_009/BhP_06.009.048.m4a", "display_order": 49}, {"id": 6000128049, "chapter_id": 10128, "verse_number": "६-९-४१", "content_sanskrit": "मघवन् यात भद्रं वो दध्यञ्चमृषिसत्तमम्।\nविद्याव्रततपःसारं गात्रं याचत मा चिरम्॥ ६/९/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_009/BhP_06.009.049.m4a", "display_order": 50}, {"id": 6000128050, "chapter_id": 10128, "verse_number": "६-९-४२", "content_sanskrit": "स वै ह्यधिगतो दध्यङ् अश्विभ्यां ब्रह्म निष्कृतम्।\nतद् वा अश्वशिरं नाम तयोरमरतां व्यधात्॥ ६/९/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_009/BhP_06.009.050.m4a", "display_order": 51}, {"id": 6000128051, "chapter_id": 10128, "verse_number": "६-९-४३", "content_sanskrit": "कृत्स्नं चाथर्वणं त्वाष्ट्रं वर्माभेद्यं मदात्मकम्।\nविश्वरूपाय यत् प्रादात् त्वाष्ट्राय त्वमधास्ततः॥ ६/९/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_009/BhP_06.009.051.m4a", "display_order": 52}, {"id": 6000128052, "chapter_id": 10128, "verse_number": "६-९-४४", "content_sanskrit": "युष्मभ्यं याचितो दध्यङ् धर्मज्ञोऽङ्गानि दास्यति। ततस्तैरायुधश्रेष्ठो विश्वकर्मविनिर्मितः।\nयेन वृत्रशिरोहर्ता मत्तेजउपबृंहितः॥ ६/९/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_009/BhP_06.009.052.m4a", "display_order": 53}, {"id": 6000128053, "chapter_id": 10128, "verse_number": "६-९-४५", "content_sanskrit": "तस्मिन् विनिहते यूयं तेजोऽस्‍त्रायुधसम्पदः।\nभूयः प्राप्स्यथ भद्रं वो न हिंसन्ति च मत्परान्॥ ६/९/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_009/BhP_06.009.053.m4a", "display_order": 54}, {"id": 6000128054, "chapter_id": 10128, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां षष्ठस्कन्धे नवमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}]