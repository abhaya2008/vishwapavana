[{"id": 2026016, "chapter_id": 1556, "verse_number": "३-१९४-०x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2026017, "chapter_id": 1556, "verse_number": "३-१९४-१", "content_sanskrit": "ततश्चोरक्षयंकृत्वाद्विजेभ्यः पृथिवीमिमाम्।\nवाजिमेधे महायज्ञे विधिवत्कल्पयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2026018, "chapter_id": 1556, "verse_number": "३-१९४-२", "content_sanskrit": "स्थापयित्वा च मर्यादाः स्वयंभुविहिताः शुभाः।\nपुनः पुण्ययशःकर्म जरया संश्रयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2026019, "chapter_id": 1556, "verse_number": "३-१९४-३", "content_sanskrit": "तच्छीलमनुवर्स्यन्ति मनुष्या लोकवासिनः।\nविप्रैश्चोरक्षये चैव कृतेक्षेमं भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2026020, "chapter_id": 1556, "verse_number": "३-१९४-४", "content_sanskrit": "कृष्णाजिनानि शक्तीश्च त्रिशूलान्यायुधानि च।\nस्थापयन्द्विजशार्दूलो देशेषु विजितेषु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2026021, "chapter_id": 1556, "verse_number": "३-१९४-५", "content_sanskrit": "संस्तूयमानो विप्रेन्द्रैर्मानयानो द्विजोत्तमान्।\nकल्कीचरिष्यति महीं सदा दस्युवधे रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2026022, "chapter_id": 1556, "verse_number": "३-१९४-६", "content_sanskrit": "हा मातस्तात पुत्रेति तास्ता वाचः सुदारुणाः।\nविक्रोशमानान्सुभृशं दस्यूननेष्यति संक्षयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2026023, "chapter_id": 1556, "verse_number": "३-१९४-७", "content_sanskrit": "ततोऽधऱ्मविनाशो वै धर्मवृद्धिश्च भारत।\nभविष्यति कृतेप्राप्ते क्रियावांश्च जनस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2026024, "chapter_id": 1556, "verse_number": "३-१९४-८", "content_sanskrit": "आरामाश्चैव चैत्याश्च तटाकावसथास्तथा।\nपुष्करिण्यश्च विविधा देवतायतनानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2026025, "chapter_id": 1556, "verse_number": "३-१९४-९", "content_sanskrit": "यज्ञक्रियाश्च विविधा भविष्यन्ति कृते युगे।\nब्राह्मणाः साधवश्चैव मुनयश्च तपस्विनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2026026, "chapter_id": 1556, "verse_number": "३-१९४-१०", "content_sanskrit": "आश्रमा हतपाषण्डाः स्थिताः सत्ये जनास्तदा।\nजायन्ति सर्वभूतानि शुध्यमानानि चैव हि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2026027, "chapter_id": 1556, "verse_number": "३-१९४-११", "content_sanskrit": "सर्वेष्वृतुषु राजेन्द्र सर्वं सस्यं भविष्यति।\nनरा दानेषु निरता व्रतेषु नियमेषु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2026028, "chapter_id": 1556, "verse_number": "३-१९४-१२", "content_sanskrit": "जपयज्ञपरा विप्रा धर्मकामा मुदा युताः।\nपालयिष्यन्ति राजानो धर्मेणेमां वसुंधराम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2026029, "chapter_id": 1556, "verse_number": "३-१९४-१३", "content_sanskrit": "व्यवहाररता वैश्या भविष्यन्ति कृते युगे।\nषट्कर्मनिरता विप्राः क्षत्रिया रक्षणे रताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2026030, "chapter_id": 1556, "verse_number": "३-१९४-१४", "content_sanskrit": "शुश्रूषायां रताः शूद्रास्तथा वर्णत्रयस्य च।\nएष धर्मः कृतयुगे त्रेतायां द्वापरे तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2026031, "chapter_id": 1556, "verse_number": "३-१९४-१५", "content_sanskrit": "पश्चिमे युगकाले च यः स ते संप्रकीर्तितः।\nसर्वलोकस् विदिता युगसह्ख्या च पाण्डव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2026032, "chapter_id": 1556, "verse_number": "३-१९४-१६", "content_sanskrit": "एतत्ते सर्वमाख्यातमतीतानागतं मया।\nवायुप्रोक्तमनुस्मृत्यपुराणमृषिसंस्तुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2026033, "chapter_id": 1556, "verse_number": "३-१९४-१७", "content_sanskrit": "एवं संसारमार्गा मे बहुशश्चिरजीविनः।\nदृष्टाश्चैवानुभूताश्च किं भूयः श्रोतुमिच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2026034, "chapter_id": 1556, "verse_number": "३-१९४-१८", "content_sanskrit": "इदं चैवापरं भूयः सह भ्रातृभिरच्युत।\nधर्मसंशयमोक्षार्थं निबोध वचनं मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2026035, "chapter_id": 1556, "verse_number": "३-१९४-१९", "content_sanskrit": "न तेऽन्यथाऽत्र विज्ञेयो धर्मो धर्मभृतांवर।\nधर्मात्मा हि सुखं राजन्प्रेत्य चेह च नन्दति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2026036, "chapter_id": 1556, "verse_number": "३-१९४-२०", "content_sanskrit": "न ब्राह्मणे परिभवः कर्तव्यस्ते कदाचन।\nब्राह्मणः कुपितोऽहन्यादपि लोकान्प्रतिज्ञया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2026037, "chapter_id": 1556, "verse_number": "३-१९४-२१x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2026038, "chapter_id": 1556, "verse_number": "३-१९४-२१", "content_sanskrit": "मार्कण्डेयवचः श्रुत्वा कुरूणां प्रवरो नृपः।\nउवाच वचनं धीमान्परमं परमद्युतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2026039, "chapter_id": 1556, "verse_number": "३-१९४-२२", "content_sanskrit": "`एतच्छ्रुत्वा मया किं स्यात्कर्तव्यं मुनिसत्तम।\nकथं चायं जितोलोको रक्षितव्यो भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2026040, "chapter_id": 1556, "verse_number": "३-१९४-२३", "content_sanskrit": "कस्मिन्धर्मे मया स्थेयं प्रजाः संरक्षता मुने।\nकथंच वर्तमानो वै न च्यवेयं स्वधर्मतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2026041, "chapter_id": 1556, "verse_number": "३-१९४-२४x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2026042, "chapter_id": 1556, "verse_number": "३-१९४-२४", "content_sanskrit": "दयावान्सर्वबूतेषु हितो रक्तोऽनसूयकः।\nउपत्यानामिव स्नेहात्प्रजानां रक्षणे रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2026043, "chapter_id": 1556, "verse_number": "३-१९४-२५", "content_sanskrit": "चर धर्मं त्यजाधर्मं पितॄन्पूर्वाननुस्मर।\nप्रमादाद्यत्कृतं तेऽभूत्सम्यग्ज्ञानेन तज्जय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2026044, "chapter_id": 1556, "verse_number": "३-१९४-२६", "content_sanskrit": "अलं ते मानमाश्रित्य सततं प्रियवाग्भव।\nविजित्य पृथिवीं सर्वां मोदमानः सुखी भव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2026045, "chapter_id": 1556, "verse_number": "३-१९४-२७", "content_sanskrit": "एष भूतो भविष्यश्च धर्मस्ते समुदीरितः।\nन तेऽस्त्यविदितं किंचिदतीतानागतं भुवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2026046, "chapter_id": 1556, "verse_number": "३-१९४-२८", "content_sanskrit": "तस्मादिमं परिक्लेशं त्वं तात हृदि मा कृथाः।\nप्राज्ञास्तात न मुह्यन्ति कालेनापि प्रपीडिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2026047, "chapter_id": 1556, "verse_number": "३-१९४-२९", "content_sanskrit": "एष कालो महाबाहो अपि सर्वदिबौकसाम्।\nमुह्यन्ति हि प्रजास्तात कालेनापि प्रचोदिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2026048, "chapter_id": 1556, "verse_number": "३-१९४-३०", "content_sanskrit": "मा च तेऽत्र विशङ्का भूद्यन्मयोक्तं तवानघ।\nअतिशङ्क्य वचो ह्येतद्धर्मलोपो भवेत्तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2026049, "chapter_id": 1556, "verse_number": "३-१९४-३१", "content_sanskrit": "जातोसि प्रथिते वंशे कुरूणां भरतर्षभ।\nकर्मणा मनसा वाचा सर्वमेतत्समाचर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2026050, "chapter_id": 1556, "verse_number": "३-१९४-३२x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2026051, "chapter_id": 1556, "verse_number": "३-१९४-३२", "content_sanskrit": "यत्त्वयोक्तं द्विजश्रेष्ठ वाक्यं श्रुतिमनोहरम्।\nतथा करिष्ये यत्नेन भवतः शासनं विभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2026052, "chapter_id": 1556, "verse_number": "३-१९४-३३", "content_sanskrit": "न मे लोभोस्ति विप्रेन्द्रन भयं न च मत्सरः।\nकरिष्यामि हि तत्सर्वमुक्तं यत्ते मयि प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2026053, "chapter_id": 1556, "verse_number": "३-१९४-३४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2026054, "chapter_id": 1556, "verse_number": "३-१९४-३४", "content_sanskrit": "श्रुत्वा तु वचनं तस्य पाण्डवस्य यशस्विनः।\nसंहृष्टः पाण्डवा राजन्सहिता शार्ङ्गधन्वना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2026055, "chapter_id": 1556, "verse_number": "३-१९४-३५", "content_sanskrit": "विप्र्रषभाश्च ते सर्वे ये तत्रासन्समागताः।\nतथा कथां शुभां श्रुत्वा रमार्कण्डेयस्य धमतः।\nविस्मिता समपद्यन्त पुराणस् निवेदनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2026056, "chapter_id": 1556, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि मार्कण्डेयसमास्यापर्वणि चतुर्नवत्यधिकशततमोऽध्यायः ॥ १९४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]