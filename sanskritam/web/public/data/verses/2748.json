[{"id": 2082330, "chapter_id": 2748, "verse_number": "१२-२५३-०x", "content_sanskrit": "शुक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2082331, "chapter_id": 2748, "verse_number": "१२-२५३-१", "content_sanskrit": "अध्यात्मं विस्तरेणेह पुनरेव वदस्व मे।\nयदध्यात्मं यथा वेद भगवन्नृषिसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2082332, "chapter_id": 2748, "verse_number": "१२-२५३-२x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2082333, "chapter_id": 2748, "verse_number": "१२-२५३-२", "content_sanskrit": "अध्यात्मं यदिदं तात पुरुषस्येह विद्यते।\nतत्तेऽहं वर्तयिष्यामि तस्य व्याख्यामिमां शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2082334, "chapter_id": 2748, "verse_number": "१२-२५३-३", "content_sanskrit": "भूमिरापस्तथा ज्योतिर्वायुराकाश एव च।\nमहाभूतानि भूतानां सागरस्योर्मयो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2082335, "chapter_id": 2748, "verse_number": "१२-२५३-४", "content_sanskrit": "प्रसार्येह यथाऽङ्गानि कूर्मः संहरते पुनः।\nतद्वन्महान्ति भूतानि यवीयःसु विकुर्वते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2082336, "chapter_id": 2748, "verse_number": "१२-२५३-५", "content_sanskrit": "इति तन्मयमेवेदं सर्वं स्थावरजङ्गमम्।\nसर्गे च प्रलये चैव तस्मिन्निर्दिश्यते तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2082337, "chapter_id": 2748, "verse_number": "१२-२५३-६", "content_sanskrit": "महाभूतानि पञ्चैव सर्वभूतेषु भूतकृत्।\nअकरोत्तात वैषम्यं यस्मिन्यदनुपश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2082338, "chapter_id": 2748, "verse_number": "१२-२५३-७x", "content_sanskrit": "शुक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2082339, "chapter_id": 2748, "verse_number": "१२-२५३-७", "content_sanskrit": "अकरोद्यच्छरीरेषु कथं तदुपलक्षयेत्।\nइन्द्रियाणि गुणाः केचित्कथं तानुपलक्षयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2082340, "chapter_id": 2748, "verse_number": "१२-२५३-८x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2082341, "chapter_id": 2748, "verse_number": "१२-२५३-८", "content_sanskrit": "एतत्ते वर्तयिष्यामि यथावदनुपूर्वकः।\nशृणु तत्त्वमिहैकाग्रो यथा तत्त्वं यथा च तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2082342, "chapter_id": 2748, "verse_number": "१२-२५३-९", "content_sanskrit": "शब्दः श्रोत्रं तथा खानि त्रयमाकाशसंभवम्।\nप्राणश्रेष्टा तथा स्पर्श एते वायुगुणास्त्रयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2082343, "chapter_id": 2748, "verse_number": "१२-२५३-१०", "content_sanskrit": "रूपं चक्षुर्विपाकश्च त्रिधा ज्योतिर्विधीयते।\nरसोऽथ रसनं स्नेहो गुणास्त्वेते त्रयोऽम्भसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2082344, "chapter_id": 2748, "verse_number": "१२-२५३-११", "content_sanskrit": "घ्रेयं घ्राणं शरीरं च भूमेरेते गुणास्त्रयः।\n`श्रोत्रं त्वक्चक्षुषी जिह्वा नासिका चैव पञ्चमी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2082345, "chapter_id": 2748, "verse_number": "१२-२५३-१२", "content_sanskrit": "एतावानिन्द्रियग्रामो व्याख्यातः पाञ्चभौतिकः।\nवायोः स्पर्शो रसोऽद्भ्यश्च ज्योतिषो रुपमुच्यते।\nआकाशप्रभवः शब्दो गन्धो भूमिगुणः स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2082346, "chapter_id": 2748, "verse_number": "१२-२५३-१३", "content_sanskrit": "मनो बुद्धिः स्वभावश्च त्रय एते मनोमयाः।\nन गुणानतिवर्तन्ते गुणेभ्यः परमागताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2082347, "chapter_id": 2748, "verse_number": "१२-२५३-१४", "content_sanskrit": "यथा कूर्म इहाङ्गानि प्रसार्य विनियच्छति।\nएवमेवेन्द्रियग्रामं बुद्धिः सृष्ट्वा नियच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2082348, "chapter_id": 2748, "verse_number": "१२-२५३-१५", "content_sanskrit": "यदूर्ध्वं पादतलयोरवाङ्भूर्ध्नश्च पश्यति।\nएतस्मिन्नेव कृत्ये तु वर्तते बुद्धिरुत्तमा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2082349, "chapter_id": 2748, "verse_number": "१२-२५३-१६", "content_sanskrit": "गुणान्नेनीयते बुद्धिर्बुद्धिरेवेन्द्रियाण्यपि।\nमनः षष्ठानि सर्वाणि बुद्ध्य भावे कृतो गुणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2082350, "chapter_id": 2748, "verse_number": "१२-२५३-१७", "content_sanskrit": "इन्द्रियाणि नरे पञ्च षष्ठं तु मन उच्यते।\nसप्तमीं बुद्धिमेवाहुः क्षेत्रज्ञं पुनरष्टमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2082351, "chapter_id": 2748, "verse_number": "१२-२५३-१८", "content_sanskrit": "चक्षुरालोचनायैव संशयं कुरुते मनः।\nबुद्धिरध्यवसानाय साक्षी क्षेत्रज्ञ उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2082352, "chapter_id": 2748, "verse_number": "१२-२५३-१९", "content_sanskrit": "रजस्तमश्च सत्वं च त्रय एते स्वयोनिजाः।\nसमाः सर्वेषु भूतेषु तान्गुणानुपलक्षयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2082353, "chapter_id": 2748, "verse_number": "१२-२५३-२०", "content_sanskrit": "तत्र यत्प्रीतिसंयुक्तं किंचिदात्मनि लक्षयेत्।\nप्रशान्तमिव संशुद्धं सत्वं तदुपधारयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2082354, "chapter_id": 2748, "verse_number": "१२-२५३-२१", "content_sanskrit": "यत्तु संतापसंयुक्तं काये मनसि वा भवेत्।\nप्रवृत्तं रज इत्येवं तत्र चाप्युपलक्षयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2082355, "chapter_id": 2748, "verse_number": "१२-२५३-२२", "content_sanskrit": "यत्तु संमोहसंयुक्तमव्यक्तविषयं भवेत्।\nअप्रतर्क्यमविज्ञेयं तमस्तदुपधार्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2082356, "chapter_id": 2748, "verse_number": "१२-२५३-२३", "content_sanskrit": "प्रहर्षः प्रीतिरानन्दः साम्यं स्वस्थात्मचित्तता।\nअकस्माद्यदि वा कस्माद्वर्तन्ते सात्विका गुणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2082357, "chapter_id": 2748, "verse_number": "१२-२५३-२४", "content_sanskrit": "अभिमानो मृषावादो लोभो मोहस्तथाऽक्षमा।\nलिङ्गानि रजसस्तानि वर्तन्ते हेत्वहेतुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2082358, "chapter_id": 2748, "verse_number": "१२-२५३-२५", "content_sanskrit": "तथा मोहः प्रमादश्च निद्रा तन्द्रा प्रबोधिता।\nकथंचिदभिवर्तन्ते विज्ञेयास्तामसा गुणाः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2082359, "chapter_id": 2748, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि त्रिपञ्चशदधिकद्विशततमोऽध्यायः॥ २५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]