[{"id": 2207899, "chapter_id": 5436, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2207900, "chapter_id": 5436, "verse_number": "१", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nकार्तवीर्यस्य संवादं समुद्रस्य च भामिनि\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2207901, "chapter_id": 5436, "verse_number": "२", "content_sanskrit": "कार्तवीर्यार्जुनो नाम राजा बाहुसहस्रवान् ।\nयेन सागरपर्यन्ता धनुषा निर्जिता मही\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2207902, "chapter_id": 5436, "verse_number": "३", "content_sanskrit": "स कदाचित् समुद्रान्ते विचरन् बलदर्पितः ।\nअवाकिरच्छरशतैः समुद्रमिति नः श्रुतम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2207903, "chapter_id": 5436, "verse_number": "४", "content_sanskrit": "तं समुद्रं नमस्कृत्य कृताञ्जलिरुवाच ह\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2207904, "chapter_id": 5436, "verse_number": "", "content_sanskrit": "समुद्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2207905, "chapter_id": 5436, "verse_number": "५", "content_sanskrit": "मा मुञ्च वीर नाराचान् ब्रूहि किं करवाणि ते\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2207906, "chapter_id": 5436, "verse_number": "६", "content_sanskrit": "मदाश्रयाणि भूतानि त्वदुत्सृष्टैर्महेषुभिः ।\nवध्यन्ते राजशार्दूल एभ्यो देह्यभयं प्रभो\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2207907, "chapter_id": 5436, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2207908, "chapter_id": 5436, "verse_number": "७", "content_sanskrit": "मत्समो यदि सङ्ग्रामे शरासनधरः क्वचित् ।\nविद्यते तं समाचक्ष्व यः समो हि महामृधे\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2207909, "chapter_id": 5436, "verse_number": "", "content_sanskrit": "समुद्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2207910, "chapter_id": 5436, "verse_number": "८", "content_sanskrit": "महर्षिर्जमदग्निस्ते यदि राजन् परिश्रुतः ।\nतस्य पुत्रस्तवातिथ्यं यथावत् कर्तुमर्हति\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2207911, "chapter_id": 5436, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2207912, "chapter_id": 5436, "verse_number": "९", "content_sanskrit": "ततः स राजा प्रययौ क्रोधेन महताऽन्वितः ।\nस तमाश्रममागम्य राममेवान्वपद्यत\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2207913, "chapter_id": 5436, "verse_number": "१०", "content_sanskrit": "स रामप्रतिकूलानि चकार सह बन्धुभिः ।\nआयासं जनयामास रामस्य च महात्मनः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2207914, "chapter_id": 5436, "verse_number": "११", "content_sanskrit": "ततस्तेजः प्रजज्वाल रामस्यामिततेजसः ।\nप्रदहन् रिपुसैन्यानि तदा कमललोचने\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2207915, "chapter_id": 5436, "verse_number": "१२", "content_sanskrit": "ततः परशुमादाय स तं बाहुसहस्रिणम् ।\nचिच्छेद सहसा रामो बहुशाखमिव द्रुमम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2207916, "chapter_id": 5436, "verse_number": "१३", "content_sanskrit": "तं हतं पतितं दृष्ट्वा समेताः सर्वबान्धवाः ।\nअसीनादाय शक्तीश्च भार्गवं पर्यवारयत्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2207917, "chapter_id": 5436, "verse_number": "१४", "content_sanskrit": "स रामो रथमारुह्य धनुरादाय सत्वरः ।\nविसृजन् शरवर्षाणि व्यधमत् पार्थिवं बलम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2207918, "chapter_id": 5436, "verse_number": "१५", "content_sanskrit": "ततस्तु क्षत्रियाः केचित् जमदग्निं निहत्य हि ।\nविविशुर्गिरिदुर्गाणि मृगाः सिंहार्दिता इव\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2207919, "chapter_id": 5436, "verse_number": "१६", "content_sanskrit": "तेषां स्वविहितं कर्म तद्भयान्नानुतिष्ठताम् ।\nप्रजा वृषलतां प्राप्ता ब्राह्मणानामदर्शनात्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2207920, "chapter_id": 5436, "verse_number": "१७", "content_sanskrit": "त एते द्रमिळाः आभीरा पुण्ड्राश्च शबरैः सह ।\nवृषलत्वं परिगता व्युत्थानात् क्षत्रधर्मिणः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2207921, "chapter_id": 5436, "verse_number": "१८", "content_sanskrit": "ततस्तु हतवीरास्तु क्षत्रियासु पुनः पुनः ।\nद्विजैरुत्पादितं क्षत्रं न्यकृन्तज्जमदग्निजः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2207922, "chapter_id": 5436, "verse_number": "१९", "content_sanskrit": "एकविंशतिके याते रामं वागशरीरिणी ।\nदिव्या प्रोवाच मधुरा सर्वलोकपरिश्रुता\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2207923, "chapter_id": 5436, "verse_number": "२०", "content_sanskrit": "राम राम निवर्तस्व कं गुणं त्वत्र पश्यसि ।\nक्षत्रबन्धूनिमान् प्राणैर्वियोज्य च पुनः पुनः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2207924, "chapter_id": 5436, "verse_number": "२१", "content_sanskrit": "तथैव तं महात्मानमृचीकप्रमुखास्तथा ।\nपितामहा महाभाग निवर्तस्वेत्यथाब्रुवन्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2207925, "chapter_id": 5436, "verse_number": "२२", "content_sanskrit": "पितुर्वधममृष्यंश्च रामः प्रोवाच तानृषीन् ।\nनार्हन्तीह भवन्तो मां निवारयितुमित्युत\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2207926, "chapter_id": 5436, "verse_number": "", "content_sanskrit": "पितरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2207927, "chapter_id": 5436, "verse_number": "२३", "content_sanskrit": "नार्हसि क्षत्रबन्धून् त्वं निहन्तुं जयकाङ्क्षया ।\nन हि युक्तं त्वया हन्तुं ब्राह्मणेन सता नृपान्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2207928, "chapter_id": 5436, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि अनुगीतासु रामकार्तवीर्ययुद्धे प्रतिसामवचनकथनं नाम त्रिंशोऽध्यायः ॥३०॥\nअनुगीतापर्वणि पञ्चदशोऽध्यायः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]