[{"id": 7006227000, "chapter_id": 26227, "verse_number": "२-५५-१", "content_sanskrit": "अभिनन्द्याशिषात्यर्थं लालयन्प्रशशंस ह ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006227001, "chapter_id": 26227, "verse_number": "२-५५-२", "content_sanskrit": "अथ ऋत्विक्सदस्यैश्च सहितो राजसत्तमः ।\nउपाक्रमत तं यज्ञे विधिवद्वेदपारगैः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006227002, "chapter_id": 26227, "verse_number": "२-५५-३", "content_sanskrit": "ततः प्रववृते यज्ञः सर्वसंपद्गुणान्वितः ।\nसम्यगौर्ववसिष्ठाद्यैर्मुनिभिः संप्रवर्त्तितः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006227003, "chapter_id": 26227, "verse_number": "२-५५-४", "content_sanskrit": "हिरण्मयमयी वेदिः पात्राण्युच्चावचानि च ।\nसुसमृद्धं यथाशास्त्रं यज्ञे सर्वं बभूव ह ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006227004, "chapter_id": 26227, "verse_number": "२-५५-५", "content_sanskrit": "एवं प्रवर्त्तितं यज्ञमृत्विजः सर्व एव ते ।\nक्रमात्समापयामासुर्यजमानपुरस्सराः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006227005, "chapter_id": 26227, "verse_number": "२-५५-६", "content_sanskrit": "समापयित्वा तं यज्ञं राजा विधिविदां वरः ।\nयथावद्दक्षिणां चैव ऋत्विजां प्रददौ तदा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006227006, "chapter_id": 26227, "verse_number": "२-५५-७", "content_sanskrit": "अथ ऋत्विक्सदस्यानां ब्राह्मणानां तथार्थिनाम् ।\nतत्काङ्क्षितादभ्यधिकं प्रददौ वसु सर्वशः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006227007, "chapter_id": 26227, "verse_number": "२-५५-८", "content_sanskrit": "एवं संतर्प्य विप्रादीन्दक्षिणाभिर्यथाक्रमम् ।\nक्षमापयामास गुरून्सदस्यान्प्रणिपत्य च ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006227008, "chapter_id": 26227, "verse_number": "२-५५-९", "content_sanskrit": "ब्राह्मणाद्यैस्ततो वर्णैरृत्विग्भिश्च समन्वितः ।\nवारकीयाकदंबैश्च सूतमागधवन्दिभिः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006227009, "chapter_id": 26227, "verse_number": "२-५५-१०", "content_sanskrit": "अन्वीयमानः सस्त्रीकः श्वेतच्छत्रविराजितः ।\nदोधूयमानचमरो वालव्यजनराजितः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006227010, "chapter_id": 26227, "verse_number": "२-५५-११", "content_sanskrit": "नानावादित्रनिर्घोषैर्बधिरीकृतदिङ्मुखः ।\nस गत्वा सरयूतीरं यथाशाश्त्रं यथाविधि ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006227011, "chapter_id": 26227, "verse_number": "२-५५-१२", "content_sanskrit": "चकारावभृथस्नानं मुदितः सहबन्धुभिः ।\nएवं स्नात्वा सपत्नीकः सुहृद्भिर्ब्राह्मणैः सह ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006227012, "chapter_id": 26227, "verse_number": "२-५५-१३", "content_sanskrit": "वीणावेणुमृदङ्गादिनानावादित्रनिःस्वनैः ।\nमङ्गल्यैर्वेदघोषैश्च सह विप्रजनेरितैः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006227013, "chapter_id": 26227, "verse_number": "२-५५-१४", "content_sanskrit": "संस्तूयमानः परितः सूतमागधबन्दिभिः ।\nप्रविवेश पुरीं रम्यां हृष्टपुष्टजनायुतम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006227014, "chapter_id": 26227, "verse_number": "२-५५-१५", "content_sanskrit": "श्वेतव्यजन सच्छत्रपताकाध्वजमालिनीम् ।\nसिक्तसंमृष्टभूभागापणशोभासमन्विताम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006227015, "chapter_id": 26227, "verse_number": "२-५५-१६", "content_sanskrit": "कैलासाद्रिप्रकाशाभिरुज्ज्वलां सौधपङ्क्तिभिः ।\nस तत्रागरुधूपोत्थगन्धामोदितदिङ्मुखम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006227016, "chapter_id": 26227, "verse_number": "२-५५-१७", "content_sanskrit": "विकीर्यमाणः परितः पौरनारीजनैर्मुहुः ।\nलाजवर्षेण सानन्दं वीक्षमाणश्च नागरैः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006227017, "chapter_id": 26227, "verse_number": "२-५५-१८", "content_sanskrit": "उपदाभिरनेकाभिस्तत्रतत्र वणिग्जनैः ।\nसंभाव्यमानः शनकैर्जगम स्वपुरं प्रति ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006227018, "chapter_id": 26227, "verse_number": "२-५५-१९", "content_sanskrit": "स प्रविश्य गृहं रम्यं सर्वमण्डलमण्डितम् ।\nसम्यक्संभावयामास सुहृदो ब्राह्मणानपि ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006227019, "chapter_id": 26227, "verse_number": "२-५५-२०", "content_sanskrit": "संसेव्यमानश्च तदा नानादेशेश्वरैर्नृपैः ।\nसभायां राजशार्दूलो रेमे शक्र इवापरः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006227020, "chapter_id": 26227, "verse_number": "२-५५-२१", "content_sanskrit": "एवं सुहृद्भिः सहितः पूरयित्वा मनोरथम् ।\nसगरः सह भार्याभ्यां रेमे नृपवरोत्तमः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006227021, "chapter_id": 26227, "verse_number": "२-५५-२२", "content_sanskrit": "अंशुमन्तं ततः पौत्रं मुदा विनयशालिनम् ।\nवसिष्ठानुमते राजा यौवराज्येऽभ्यषेचयत् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006227022, "chapter_id": 26227, "verse_number": "२-५५-२३", "content_sanskrit": "पौरजानपदानां तु बन्धूनां सुहृदामपि ।\nस प्रियोऽभवदत्यर्थमुदारैश्च गुणैर्नृपः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006227023, "chapter_id": 26227, "verse_number": "२-५५-२४", "content_sanskrit": "प्रजास्तमन्वरज्यन्त बालमप्यमितौजसम् ।\nनवं च शुक्लपक्षादौशीतांशुमचिरोदितम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006227024, "chapter_id": 26227, "verse_number": "२-५५-२५", "content_sanskrit": "स तेन सहितः श्रीमान्सुत्दृद्भिश्च नृपोत्तमः ।\nभार्याभ्यामनुरूपाभ्यां रममाणोऽवसच्चिरम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006227025, "chapter_id": 26227, "verse_number": "२-५५-२६", "content_sanskrit": "युवैव राजशार्दूलः साक्षाद्धर्म इवापरः ।\nपालयामास वसुधां सशैलवनकाननाम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006227026, "chapter_id": 26227, "verse_number": "२-५५-२७", "content_sanskrit": "एवं महानहिमदीधितिवंशमौलिरत्नाय यमानवपुरुत्तरकोसलेशः ।\nपूर्णेन्दुवत्सकललोकमनोऽभिरामः सार्द्ध प्रजाभिरखिलाभिरलं जहर्ष ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]