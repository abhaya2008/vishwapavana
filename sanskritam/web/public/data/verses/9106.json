[{"id": 5000106000, "chapter_id": 9106, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अयोध्याकाण्डे एकोनत्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000106001, "chapter_id": 9106, "verse_number": "२-२९-१", "content_sanskrit": "एतत् तु वचनं श्रुत्वा सीता रामस्य दुःखिता।\nप्रसक्ताश्रुमुखी मन्दमिदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000106002, "chapter_id": 9106, "verse_number": "२-२९-२", "content_sanskrit": "ये त्वया कीर्तिता दोषा वने वस्तव्यतां प्रति।\nगुणानित्येव तान् विद्धि तव स्नेहपुरस्कृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000106003, "chapter_id": 9106, "verse_number": "२-२९-३", "content_sanskrit": "मृगाः सिंहा गजाश्चैव शार्दूलाः शरभास्तथा।\nचमराः सृमराश्चैव ये चान्ये वनचारिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000106004, "chapter_id": 9106, "verse_number": "२-२९-४", "content_sanskrit": "अदृष्टपूर्वरूपत्वात् सर्वे ते तव राघव।\nरूपं दृष्ट्वापसर्पेयुस्तव सर्वे हि बिभ्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000106005, "chapter_id": 9106, "verse_number": "२-२९-५", "content_sanskrit": "त्वया च सह गन्तव्यं मया गुरुजनाज्ञया।\nत्वद्वियोगेन मे राम त्यक्तव्यमिह जीवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000106006, "chapter_id": 9106, "verse_number": "२-२९-६", "content_sanskrit": "नहि मां त्वत्समीपस्थामपि शक्रोऽपि राघव।\nसुराणामीश्वरः शक्तः प्रधर्षयितुमोजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000106007, "chapter_id": 9106, "verse_number": "२-२९-७", "content_sanskrit": "पतिहीना तु या नारी न सा शक्ष्यति जीवितुम्।\nकाममेवंविधं राम त्वया मम निदर्शितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000106008, "chapter_id": 9106, "verse_number": "२-२९-८", "content_sanskrit": "अथापि च महाप्राज्ञ ब्राह्मणानां मया श्रुतम्।\nपुरा पितृगृहे सत्यं वस्तव्यं किल मे वने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000106009, "chapter_id": 9106, "verse_number": "२-२९-९", "content_sanskrit": "लक्षणिभ्यो द्विजातिभ्यः श्रुत्वाहं वचनं गृहे।\nवनवासकृतोत्साहा नित्यमेव महाबल ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000106010, "chapter_id": 9106, "verse_number": "२-२९-१०", "content_sanskrit": "आदेशो वनवासस्य प्राप्तव्यः स मया किल।\nसा त्वया सह भर्त्राहं यास्यामि प्रिय नान्यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000106011, "chapter_id": 9106, "verse_number": "२-२९-११", "content_sanskrit": "कृतादेशा भविष्यामि गमिष्यामि त्वया सह।\nकालश्चायं समुत्पन्नः सत्यवान् भवतु द्विजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000106012, "chapter_id": 9106, "verse_number": "२-२९-१२", "content_sanskrit": "वनवासे हि जानामि दुःखानि बहुधा किल।\nप्राप्यन्ते नियतं वीर पुरुषैरकृतात्मभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000106013, "chapter_id": 9106, "verse_number": "२-२९-१३", "content_sanskrit": "कन्यया च पितुर्गेहे वनवासः श्रुतो मया।\nभिक्षिण्याः शमवृत्ताया मम मातुरिहाग्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000106014, "chapter_id": 9106, "verse_number": "२-२९-१४", "content_sanskrit": "प्रसादितश्च वै पूर्वं त्वं मे बहुतिथं प्रभो।\nगमनं वनवासस्य कांक्षितं हि सह त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000106015, "chapter_id": 9106, "verse_number": "२-२९-१५", "content_sanskrit": "कृतक्षणाहं भद्रं ते गमनं प्रति राघव।\nवनवासस्य शूरस्य मम चर्या हि रोचते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000106016, "chapter_id": 9106, "verse_number": "२-२९-१६", "content_sanskrit": "शुद्धात्मन् प्रेमभावाद्धि भविष्यामि विकल्मषा।\nभर्तारमनुगच्छन्ती भर्ता हि परदैवतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000106017, "chapter_id": 9106, "verse_number": "२-२९-१७", "content_sanskrit": "प्रेत्यभावे हि कल्याणः संगमो मे सदा त्वया।\nश्रुतिर्हि श्रूयते पुण्या ब्राह्मणानां यशस्विनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000106018, "chapter_id": 9106, "verse_number": "२-२९-१८", "content_sanskrit": "इहलोके च पितृभिर्या स्त्री यस्य महाबल।\nअद्भिर्दत्ता स्वधर्मेण प्रेत्यभावेऽपि तस्य सा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000106019, "chapter_id": 9106, "verse_number": "२-२९-१९", "content_sanskrit": "एवमस्मात् स्वकां नारीं सुवृत्तां हि पतिव्रताम्।\nनाभिरोचयसे नेतुं त्वं मां केनेह हेतुना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000106020, "chapter_id": 9106, "verse_number": "२-२९-२०", "content_sanskrit": "भक्तां पतिव्रतां दीनां मां समां सुखदुःखयोः।\nनेतुमर्हसि काकुत्स्थ समानसुखदुःखिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000106021, "chapter_id": 9106, "verse_number": "२-२९-२१", "content_sanskrit": "यदि मां दुःखितामेवं वनं नेतुं न चेच्छसि।\nविषमग्निं जलं वाहमास्थास्ये मृत्युकारणात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000106022, "chapter_id": 9106, "verse_number": "२-२९-२२", "content_sanskrit": "एवं बहुविधं तं सा याचते गमनं प्रति।\nनानुमेने महाबाहुस्तां नेतुं विजनं वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000106023, "chapter_id": 9106, "verse_number": "२-२९-२३", "content_sanskrit": "एवमुक्ता तु सा चिन्तां मैथिली समुपागता।\nस्नापयन्तीव गामुष्णैरश्रुभिर्नयनच्युतैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000106024, "chapter_id": 9106, "verse_number": "२-२९-२४", "content_sanskrit": "चिन्तयन्तीं तदा तां तु निवर्तयितुमात्मवान्।\nक्रोधाविष्टां तु वैदेहीं काकुत्स्थो बह्वसान्त्वयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000106025, "chapter_id": 9106, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अयोध्याकाण्डे एकोनत्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]