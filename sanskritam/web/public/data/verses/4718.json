[{"id": 2175342, "chapter_id": 4718, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2175343, "chapter_id": 4718, "verse_number": "१", "content_sanskrit": "सरस्वत्याः प्रभावोऽयमुक्तस्ते द्विजसत्तम ।\nकुमारस्याभिषेकं तु ब्रह्मन्नाख्यातुमर्हसि\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2175344, "chapter_id": 4718, "verse_number": "२", "content_sanskrit": "यस्मिन् देशे च काले च यथा च वदतां वर ।\nयैश्चाभिषिक्तो भगवान् विधिना येन च प्रभुः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2175345, "chapter_id": 4718, "verse_number": "३", "content_sanskrit": "स्कन्दो यथा च दैत्यानामकरोद् कदनं महत् ।\nतथा मे सर्वमाचक्ष्व परं कौतूहलं हि मे\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2175346, "chapter_id": 4718, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2175347, "chapter_id": 4718, "verse_number": "४", "content_sanskrit": "कुरुवंशस्य सदृशं कौतूहलमिदं तव ।\nहर्षमुत्पादयत्येव वचो मे जनमेजय\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2175348, "chapter_id": 4718, "verse_number": "५", "content_sanskrit": "अहं तत् कथयिष्यामि शृण्वानस्य नराधिप ।\nअभिषेकं कुमारस्य प्रभावं च महात्मनः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2175349, "chapter_id": 4718, "verse_number": "६", "content_sanskrit": "तेजो माहेश्वरं स्कन्नमग्नौ प्रपतितं पुरा ।\nतत्सर्वं भगवानग्निर्नाशकद् धर्तुमक्षयम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2175350, "chapter_id": 4718, "verse_number": "७", "content_sanskrit": "तेन सीदति तेजस्वी दीप्तिमान् हव्यवाहनः ।\nन चैवं धारयामास ब्रह्मणे चोक्तवान् प्रभुः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2175351, "chapter_id": 4718, "verse_number": "८", "content_sanskrit": "स गङ्गामुपसङ्गम्य नियोगाद् ब्रह्मणः प्रभुः ।\nगर्भमाहितवान् दिव्यं भास्करोपमतेजसम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2175352, "chapter_id": 4718, "verse_number": "९", "content_sanskrit": "अथ गङ्गापि तं गर्भमसहन्ती विधारणे ।\nउत्ससर्ज गिरौ रम्ये हिमवत्यमरार्चिते\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2175353, "chapter_id": 4718, "verse_number": "१०", "content_sanskrit": "स तत्र ववृधे लोकानावृत्य ज्वलनात्मजः ।\nददृशुर्ज्वलनाकारं तं गर्भमथ कृत्तिकाः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2175354, "chapter_id": 4718, "verse_number": "११", "content_sanskrit": "शरस्तम्बे महात्मानमनलात्मजमीश्वरम् ।\nममायमिति ताः सर्वाः पुत्रार्थिन्योऽभिचुक्रुशुः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2175355, "chapter_id": 4718, "verse_number": "१२", "content_sanskrit": "तासां विदित्वा भावं तं मातॄणां भगवान् प्रभुः ।\nप्रस्नुतानां पयः षड्भिर्वदनैरपिबत्तदा\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2175356, "chapter_id": 4718, "verse_number": "१३", "content_sanskrit": "तं प्रभावं समालक्ष्य तस्य बालस्य कृत्तिकाः ।\nपरं विस्मयमापन्ना देव्यो दिव्यवपुर्धराः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2175357, "chapter_id": 4718, "verse_number": "१४", "content_sanskrit": "यत्रोत्सृष्टश्च गर्भः स गङ्गया गिरिमूर्धनि ।\nस शैलः काञ्चनः सर्वः सम्बभौ मेरुवत् तदा\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2175358, "chapter_id": 4718, "verse_number": "१५", "content_sanskrit": "वर्धता चैव गर्भेण पृथिवी तेन रञ्जिता ।\nअतश्च सर्वे संवृत्ता गिरयः काञ्चनात्मकाः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2175359, "chapter_id": 4718, "verse_number": "१६", "content_sanskrit": "कुमारः सुमहावीर्यः कार्तिकेय इति स्मृतः ।\nगाङ्गेयः पूर्वमभवन्महाकायो बलान्वितः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2175360, "chapter_id": 4718, "verse_number": "१७", "content_sanskrit": "शमेन तपसा चैव वीर्येण च समन्वितः ।\nववृधेऽतीव राजेन्द्र चन्द्रवत् प्रियदर्शनः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2175361, "chapter_id": 4718, "verse_number": "१८", "content_sanskrit": "स तस्मिन् काञ्चने दिव्ये शरस्तम्भे श्रिया वृतः ।\nस्तूयमानः सदा शेते गन्धर्वैर्मुनिभिस्तथा\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2175362, "chapter_id": 4718, "verse_number": "१९", "content_sanskrit": "तथैनमन्वनृत्यन्त देवकन्याः सहस्रशः ।\nदिव्यवादित्रनृत्यज्ञाः स्तुवन्त्यश्चारुदर्शनाः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2175363, "chapter_id": 4718, "verse_number": "२०", "content_sanskrit": "अन्वयुश्चाग्नयः सर्वे गङ्गा च सरितां वरा ।\nदधार पृथिवी चैनं बिभ्रती रूपमुत्तमम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2175364, "chapter_id": 4718, "verse_number": "२१", "content_sanskrit": "जातकर्मादिकास्तस्य क्रियाश्चक्रे बृहस्पतिः ।\nवेदश्चैनं चतुर्मूर्तिरुपतस्थे कृताञ्जलिः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2175365, "chapter_id": 4718, "verse_number": "२२", "content_sanskrit": "धनुर्वेदश्चतुष्पादः सास्त्रग्रामः ससङ्ग्रहः ।\nतत्रैनं समुपातिष्ठत्साक्षाद् वाणी च केवला\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2175366, "chapter_id": 4718, "verse_number": "२३", "content_sanskrit": "स ददर्श महात्मानं देवदेवमुमापतिम् ।\nशैलपुत्र्या समागम्य भूतसङ्घशतैर्वृतः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2175367, "chapter_id": 4718, "verse_number": "२४", "content_sanskrit": "निकाया भूतसङ्घानां परमाद्भुतदर्शनाः ।\nविकृता विकृताकारा विकृताभरणध्वजाः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2175368, "chapter_id": 4718, "verse_number": "२५", "content_sanskrit": "व्याघ्रसिंहर्क्षवदना बिडालमकराननाः ।\nवृषदंशमुखाश्चान्ये गजोष्ट्रवदनास्तथा\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2175369, "chapter_id": 4718, "verse_number": "२६", "content_sanskrit": "उलूकवदनाः केचिद् गृध्रगोमायुदर्शनाः ।\nक्रौञ्चपारावतनिभैर्वदनैः राङ्कवैरपि\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2175370, "chapter_id": 4718, "verse_number": "२७", "content_sanskrit": "श्वाविच्छल्यकगोधानामजैडकगवां तथा ।\nसदृशानि वपूंष्यन्ये तत्र तत्र व्यधारयन्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2175371, "chapter_id": 4718, "verse_number": "२८", "content_sanskrit": "केचिच्छैलाम्बुदप्रख्याश्चक्रालातगदायुधाः ।\nकेचिदञ्जनपुञ्जाभाः केचिच्छ्वेताचलप्रभाः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2175372, "chapter_id": 4718, "verse_number": "२९", "content_sanskrit": "सप्तमातृगणाश्चैव समाजग्मुर्विशाम्पते ।\nसाध्या विश्वेऽथ मरुतो वसवः पितरस्तथा\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2175373, "chapter_id": 4718, "verse_number": "३०", "content_sanskrit": "रुद्रादित्यास्तथा सिद्धा भुजगा दानवाः खगाः ।\nब्रह्मा स्वयम्भूर्भगवान् सपुत्रः सहविष्णुना\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2175374, "chapter_id": 4718, "verse_number": "३१", "content_sanskrit": "शक्रस्तथाऽभ्ययाद् द्रष्टुं कुमारममितप्रभम् ।\nनारदप्रमुखाश्चापि देवगन्धर्वसत्तमाः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2175375, "chapter_id": 4718, "verse_number": "३२", "content_sanskrit": "देवर्षयश्च सिद्धाश्च बृहस्पतिपुरोगमाः ।\nपितरो जगतः श्रेष्ठा देवानामपि देवताः ।\nतेऽपि तत्र समाजग्मुर्यामा धामाश्च सर्वशः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2175376, "chapter_id": 4718, "verse_number": "३३", "content_sanskrit": "स तु बालोऽपि बलवान् महायोगबलान्वितः ।\nअभ्याजगाम देवेशं शूलहस्तं पिनाकिनम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2175377, "chapter_id": 4718, "verse_number": "३४", "content_sanskrit": "तमाव्रजन्तमालक्ष्य शिवस्यासीन्मनोगतम् ।\nयुगपच्छैलपुत्र्याश्च गङ्गायाः पावकस्य च\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2175378, "chapter_id": 4718, "verse_number": "३५", "content_sanskrit": "कं नु पूर्वमयं बालो गौरवादभ्युपैष्यति ।\nअपि मामिति सर्वेषां तेषामासीन्मनोगतम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2175379, "chapter_id": 4718, "verse_number": "३६", "content_sanskrit": "तेषामेतमभिप्रायं चतुर्णामुपलक्ष्य सः ।\nयुगपद्योगमास्थाय ससर्ज विविधास्तनूः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2175380, "chapter_id": 4718, "verse_number": "३७", "content_sanskrit": "ततोऽभवच्चतुर्मूर्तिः क्षणेन भगवान् प्रभुः ।\nतस्य शाखो विशाखश्च नैगमेयश्च पृष्ठतः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2175381, "chapter_id": 4718, "verse_number": "३८", "content_sanskrit": "एवं स कृत्वा ह्यात्मानं चतुर्धा भगवान् प्रभुः ।\nयतो रुद्रस्ततः स्कन्दो जगामाद्भुतदर्शनः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2175382, "chapter_id": 4718, "verse_number": "३९", "content_sanskrit": "विशाखस्तु ययौ देवीं ततो गिरिवरात्मजाम् ।\nशाखो ययौ स भगवान् दिव्यमूर्तिर्विभावसुम्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2175383, "chapter_id": 4718, "verse_number": "४०", "content_sanskrit": "नैगमेयोऽगमद् गङ्गां कुमारः पावकः प्रभुः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2175384, "chapter_id": 4718, "verse_number": "४१", "content_sanskrit": "सर्वे भास्वरदेहास्ते चत्वारः समरूपिणः ।\nतान् समभ्ययुरव्यग्रास्तदद्भुतमिवाभवत्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2175385, "chapter_id": 4718, "verse_number": "४२", "content_sanskrit": "हाहाकारो महानासीद् देवदानवरक्षसाम् ।\nदृष्ट्वा तन्महदाश्चर्यमद्भुतं रोमहर्षणम्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2175386, "chapter_id": 4718, "verse_number": "४३", "content_sanskrit": "ततो रुद्रश्च देवी च पावकश्च पितामहम् ।\nगङ्गया सहिताः सर्वे प्रणिपेतुर्जगत्पतिम्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2175387, "chapter_id": 4718, "verse_number": "४४", "content_sanskrit": "प्रणिपत्य ततस्ते तु विधिवद् राजपुङ्गव ।\nइदमूचुर्वचो राजन् कार्तिकेयप्रियेप्सया\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2175388, "chapter_id": 4718, "verse_number": "", "content_sanskrit": "रुद्रादयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2175389, "chapter_id": 4718, "verse_number": "४५", "content_sanskrit": "अस्य बालस्य भगवन्नाधिपत्यं यथेप्सितम् ।\nअस्मत्प्रियार्थं देवेश सदृशं दातुमर्हसि\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2175390, "chapter_id": 4718, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2175391, "chapter_id": 4718, "verse_number": "४६", "content_sanskrit": "ततः स भगवान् प्रीतः सर्वलोकपितामहः ।\nमनसा चिन्तयामास किमयं लभतामिति\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2175392, "chapter_id": 4718, "verse_number": "४७", "content_sanskrit": "ऐश्वर्याणि हि सर्वाणि देवदानवरक्षसाम् ।\nभूतयक्षपिशाचानां पन्नगानां च सर्वशः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2175393, "chapter_id": 4718, "verse_number": "४८", "content_sanskrit": "पूर्वमेवादिदेशासौ निकायेषु महात्मनाम्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2175394, "chapter_id": 4718, "verse_number": "४९", "content_sanskrit": "सामर्थ्यं च तथैश्वर्यं महामतिरमन्यत\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2175395, "chapter_id": 4718, "verse_number": "५०", "content_sanskrit": "ततो मुहूर्तं स ध्यात्वा देवानां श्रेयसि स्थितः ।\nसैनापत्यं ददौ तस्मै सर्वभूतेषु भारत\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2175396, "chapter_id": 4718, "verse_number": "५१", "content_sanskrit": "दिवि देवनिकायानां ये च राजन् परिश्रुताः ।\nतान् सर्वान् व्यादिदेशास्मै सर्वभूतपितामहः\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2175397, "chapter_id": 4718, "verse_number": "५२", "content_sanskrit": "ततः कुमारमादाय देवा ब्रह्मपुरोगमाः ।\nअभिषेकार्थमाजग्मुः शैलेन्द्रं सहितास्ततः\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2175398, "chapter_id": 4718, "verse_number": "५३", "content_sanskrit": "पुण्यां हैमवतीं देवीं सरिच्छ्रेष्ठां सरस्वतीम् ।\nस्यमन्तपञ्चके या वै पितृलोकेषु विश्रुता\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2175399, "chapter_id": 4718, "verse_number": "५४", "content_sanskrit": "तत्र तीरे सरस्वत्याः पुण्ये सर्वगुणान्विते ।\nनिषेदुर्देवगन्धर्वाः सर्वे सम्पूर्णमानसाः\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2175400, "chapter_id": 4718, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां गदापर्वणि कुमारसैनापत्यवर्णनं नाम षोडशोऽध्यायः ॥१६॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]