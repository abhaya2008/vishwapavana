[{"id": 7001080000, "chapter_id": 21080, "verse_number": "१-१६-१", "content_sanskrit": "ऋषय ऊचुः ।\nपार्थिवप्रतिमापूजाविधानं ब्रूहि सत्तम ।\nयेन पूजाविधानेन सर्वाभिष्टमवाप्यते॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001080001, "chapter_id": 21080, "verse_number": "१-१६-२", "content_sanskrit": "सूत उवाच ।\nसुसाधुपृष्टं युष्माभिः सदा सर्वार्थदायकम् ।\nसद्यो दुःखस्य शमनं शृणुत प्रब्रवीमि वः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001080002, "chapter_id": 21080, "verse_number": "१-१६-३", "content_sanskrit": "अपमृत्युहरं कालमृत्योश्चापि विनाशनम् ।\nसद्यः कलत्रपुत्रादिधनधान्यप्रदं द्विजाः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001080003, "chapter_id": 21080, "verse_number": "१-१६-४", "content_sanskrit": "अन्नादिभोज्यं वस्त्रादिसर्वमुत्पद्यते यतः ।\nततो मृदादिप्रतिमापूजाभीष्टप्रदा भुवि॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001080004, "chapter_id": 21080, "verse_number": "१-१६-५", "content_sanskrit": "पुरुषाणां च नारीणामधिकारोत्र निश्चितम् ।\nनद्यां तडागे कूपे वा जलांतर्मृदमाहरेत्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001080005, "chapter_id": 21080, "verse_number": "१-१६-६", "content_sanskrit": "संशोध्य गंधचूर्णेन पेषयित्वा सुमंडपे ।\nहस्तेन प्रतिमां कुर्यात्क्षीरेण च सुसंस्कृताम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001080006, "chapter_id": 21080, "verse_number": "१-१६-७", "content_sanskrit": "अंगप्रत्यंगकोपेतामायुधैश्च समन्विताम् ।\nपद्मासनस्थितां कृत्वा पूजयेदादरेण हि॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001080007, "chapter_id": 21080, "verse_number": "१-१६-८", "content_sanskrit": "विघ्नेशादित्यविष्णूनामंबायाश्च शिवस्य च ।\nशिवस्यशिवलिंगं च सर्वदा पूजयेद्द्विज॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001080008, "chapter_id": 21080, "verse_number": "१-१६-९", "content_sanskrit": "षोडशैरुपचारैश्च कुर्यात्तत्फलसिद्धये ।\nपुष्पेण प्रोक्षणं कुर्यादभिषेकं समंत्रकम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001080009, "chapter_id": 21080, "verse_number": "१-१६-१०", "content_sanskrit": "शाल्यन्नेनैव नैवेद्यं सर्वं कुडवमानतः ।\nगृहे तु कुडवं ज्ञेयं मानुषे प्रस्थमिष्यते॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001080010, "chapter_id": 21080, "verse_number": "१-१६-११", "content_sanskrit": "दैवे प्रस्थत्रयं योग्यं स्वयंभोः प्रस्थपंचकम् ।\nएवं पूर्णफलं विद्यादधिकं वै द्वयं त्रयम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001080011, "chapter_id": 21080, "verse_number": "१-१६-१२", "content_sanskrit": "सहस्रपूजया सत्यं सत्यलोकं लभेद्द्विजः ।\nद्वादशांगुलमायामं द्विगुणं च ततोऽधिकम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001080012, "chapter_id": 21080, "verse_number": "१-१६-१३", "content_sanskrit": "प्रमाणमंगुलस्यैकं तदूर्ध्वं पंचकत्रयम् ।\nअयोदारुकृतं पात्रं शिवमित्युच्यते बुधैः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001080013, "chapter_id": 21080, "verse_number": "१-१६-१४", "content_sanskrit": "तदष्टभागः प्रस्थः स्यात्तच्चतुःकुडवं मतम् ।\nदशप्रस्थं शतप्रस्थं सहस्रप्रस्थमेव च॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001080014, "chapter_id": 21080, "verse_number": "१-१६-१५", "content_sanskrit": "जलतैलादिगंधानां यथायोग्यं च मानतः ।\nमानुषार्षस्वयंभूनां महापूजेति कथ्यते॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001080015, "chapter_id": 21080, "verse_number": "१-१६-१६", "content_sanskrit": "अभिषेकादात्मशुद्धिर्गंधात्पुण्यमवाप्यते ।\nआयुस्तृप्तिश्च नैवेद्याद्धूपादर्थमवाप्यते॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001080016, "chapter_id": 21080, "verse_number": "१-१६-१७", "content_sanskrit": "दीपाज्ज्ञानमवाप्नोति तांबूलाद्भोगमाप्नुयात् ।\nतस्मात्स्नानादिकं षट्कं प्रयत्नेन प्रसाधयेत्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001080017, "chapter_id": 21080, "verse_number": "१-१६-१८", "content_sanskrit": "नमस्कारो जपश्चैव सर्वाभीष्टप्रदावुभौ ।\nपूजान्ते च सदाकार्यौ भोगमोक्षार्थिभिर्नरैः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001080018, "chapter_id": 21080, "verse_number": "१-१६-१९", "content_sanskrit": "संपूज्य मनसा पूर्वं कुर्यात्तत्तत्सदा नरः ।\nदेवानां पूजया चैव तत्तल्लोकमवाप्नुयात्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001080019, "chapter_id": 21080, "verse_number": "१-१६-२०", "content_sanskrit": "तदवांतरलोके च यथेष्टं भोग्यमाप्यते ।\nतद्विशेषान्प्रवक्ष्यामि शृणुत श्रद्धया द्विजाः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001080020, "chapter_id": 21080, "verse_number": "१-१६-२१", "content_sanskrit": "विघ्नेशपूजया सम्यग्भूर्लोकेऽभीष्टमाप्नुयात् ।\nशुक्रवारे चतुर्थ्यां च सिते श्रावणभाद्र के॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001080021, "chapter_id": 21080, "verse_number": "१-१६-२२", "content_sanskrit": "भिषगृक्षे धनुर्मासे विघ्नेशं विधिवद्यजेत् ।\nशतं पूजासहस्रं वा तत्संख्याकदिनैर्व्रजेत्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001080022, "chapter_id": 21080, "verse_number": "१-१६-२३", "content_sanskrit": "देवाग्निश्रद्धया नित्यं पुत्रदं चेष्टदं नृणाम् ।\nसर्वपापप्रशमनं तत्तद्दुरितनाशनम्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001080023, "chapter_id": 21080, "verse_number": "१-१६-२४", "content_sanskrit": "वारपूजांशिवादीनामात्मशुद्धिप्रदां विदुः ।\nतिथिनक्षत्रयोगानामाधारं सार्वकामिकम्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001080024, "chapter_id": 21080, "verse_number": "१-१६-२५", "content_sanskrit": "तथा बृद्धिक्षयाभावात्पूर्णब्रह्मात्मकं विदुः ।\nउदयादुदयं वारो ब्रह्मप्रभृति कर्मणाम्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001080025, "chapter_id": 21080, "verse_number": "१-१६-२६", "content_sanskrit": "तिथ्यादौ देवपूजा हि पूर्णभोगप्रदा नृणाम् ।\nपूर्वभागः पितृणां तु निशि युक्तः प्रशस्यते॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001080026, "chapter_id": 21080, "verse_number": "१-१६-२७", "content_sanskrit": "परभागस्तु देवानां दिवा युक्तः प्रशस्यते ।\nउदयव्यापिनी ग्राह्या मध्याह्ने यदि सा तिथिः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001080027, "chapter_id": 21080, "verse_number": "१-१६-२८", "content_sanskrit": "देवकार्ये तथा ग्राह्यास्थिति ऋक्षादिकाः शुभाः ।\nसम्यग्विचार्य वारादीन्कुर्यात्पूजाजपादिकम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001080028, "chapter_id": 21080, "verse_number": "१-१६-२९", "content_sanskrit": "पूजार्यते ह्यनेनेति वेदेष्वर्थस्य योजना ।\nपूर्णभोगफलसिद्धिश्च जायते तेन कर्मणा॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001080029, "chapter_id": 21080, "verse_number": "१-१६-३०", "content_sanskrit": "मनोभावांस्तथा ज्ञानमिष्टभोगार्थयोजनात् ।\nपूजाशब्दर्थ एवं हि विश्रुतो लोकवेदयोः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001080030, "chapter_id": 21080, "verse_number": "१-१६-३१", "content_sanskrit": "नित्यनैमित्तिकं कालात्सद्यः काम्ये स्वनुष्ठिते ।\nनित्यं मासं च पक्षं च वर्षं चैव यथाक्रमम्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001080031, "chapter_id": 21080, "verse_number": "१-१६-३२", "content_sanskrit": "तत्तत्कर्मफलप्राप्तिस्तादृक्पापक्षयः क्रमात् ।\nमहागणपतेः पूजा चतुर्थ्यां कृष्णपक्षके॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001080032, "chapter_id": 21080, "verse_number": "१-१६-३३", "content_sanskrit": "पक्षपापक्षयकरी पक्षभोगफलप्रदा ।\nचैत्रे चतुर्थ्यां पूजा च कृता मासफलप्रदा॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001080033, "chapter_id": 21080, "verse_number": "१-१६-३४", "content_sanskrit": "वर्षभोगप्रदा ज्ञेया कृता वै सिंहभाद्र के ।\nश्रवण्यादित्यवारे च सप्तम्यां हस्तभे दिने॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001080034, "chapter_id": 21080, "verse_number": "१-१६-३५", "content_sanskrit": "माघशुक्ले च सप्तम्यामादित्ययजनं चरेत् ।\nज्येष्ठभाद्र कसौम्ये च द्वादश्यां श्रवर्णक्षके॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001080035, "chapter_id": 21080, "verse_number": "१-१६-३६", "content_sanskrit": "द्वादश्यां विष्णुयजनमिष्टंसंपत्करं विदुः ।\nश्रावणे विष्णुयजनमिष्टारोग्यप्रदं भवेत्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001080036, "chapter_id": 21080, "verse_number": "१-१६-३७", "content_sanskrit": "गवादीन्द्वादशानर्थान्सांगान्दत्वा तु यत्फलम् ।\nतत्फलं समवाप्नोति द्वादश्यां विष्णुतर्पणात्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001080037, "chapter_id": 21080, "verse_number": "१-१६-३८", "content_sanskrit": "द्वादश्यां द्वादशान्विप्रान्विष्णोर्द्वादशनामतः ।\nषोडशैरुपचारैश्च यजेत्तत्प्रीतिमाप्नुयात्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001080038, "chapter_id": 21080, "verse_number": "१-१६-३९", "content_sanskrit": "एवं च सर्वदेवानां तत्तद्द्वादशनामकैः ।\nद्वादशब्रह्मयजनं तत्तत्प्रीतिकरं भवेत्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001080039, "chapter_id": 21080, "verse_number": "१-१६-४०", "content_sanskrit": "कर्कटे सोमवारे च नवम्यां मृगशीर्षके ।\nअंबां यजेद्भूतिकामः सर्वभोगफलप्रदाम्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001080040, "chapter_id": 21080, "verse_number": "१-१६-४१", "content_sanskrit": "आश्वयुक्छुक्लनवमी सर्वाभीष्टफलप्रदा ।\nआदिवारे चतुर्दश्यां कृष्णपक्षे विशेषतः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001080041, "chapter_id": 21080, "verse_number": "१-१६-४२", "content_sanskrit": "आर्द्रायां च महार्द्रायां शिवपूजा विशिष्यते ।\nमाघकृष्णचतुर्दश्यां सर्वाभीष्टफलप्रदा॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001080042, "chapter_id": 21080, "verse_number": "१-१६-४३", "content_sanskrit": "आयुष्करी मृत्युहरा सर्वसिद्धिकरी नृणाम् ।\nज्येष्ठमासे महार्द्रायां चतुर्दशीदिनेपि च॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001080043, "chapter_id": 21080, "verse_number": "१-१६-४४", "content_sanskrit": "मार्गशीर्षार्द्रकायां वा षोडशैरुपचारकैः ।\nतत्तन्मूर्तिशिवं पूज्य तस्य वै पाददर्शनम्॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001080044, "chapter_id": 21080, "verse_number": "१-१६-४५", "content_sanskrit": "शिवस्य यजनं ज्ञेयं भोगमोक्षप्रदं नृणाम् ।\nवारादिदेवयजनं कार्तिके हि विशिष्यते॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001080045, "chapter_id": 21080, "verse_number": "१-१६-४६", "content_sanskrit": "कार्तिके मासि संप्राप्ते सर्वान्देवान्यजेद्बुधः ।\nदानेन तपसा होमैर्जपेन नियमेन च॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001080046, "chapter_id": 21080, "verse_number": "१-१६-४७", "content_sanskrit": "षोडशैरुपचारैश्च प्रतिमा विप्रमंत्रकैः ।\nब्राह्मणानां भोजनेन निष्कामार्तिकरो भवेत्॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001080047, "chapter_id": 21080, "verse_number": "१-१६-४८", "content_sanskrit": "कार्तिके देवयजनं सर्वभोगप्रदं भवेत् ।\nव्याधीनां हरणं चैव भवेद्भूतग्रहक्षयः॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001080048, "chapter_id": 21080, "verse_number": "१-१६-४९", "content_sanskrit": "कार्तिकादित्यवारेषु नृणामादित्यपूजनात् ।\nतैलकार्पासदानात्तु भवेत्कुष्ठादिसंक्षयः॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001080049, "chapter_id": 21080, "verse_number": "१-१६-५०", "content_sanskrit": "हरीतकीमरीचीनां वस्त्रक्षीरादिदानतः ।\nब्रह्मप्रतिष्ठया चैव क्षयरोगक्षयो भवेत्॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001080050, "chapter_id": 21080, "verse_number": "१-१६-५१", "content_sanskrit": "दीपसर्षपदानाच्च अपस्मारक्षयो भवेत् ।\nकृत्तिकासोमवारेषु शिवस्य यजनं नृणाम्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001080051, "chapter_id": 21080, "verse_number": "१-१६-५२", "content_sanskrit": "महादारिद्र्य शमनं सर्वसंपत्करं भवेत् ।\nगृहक्षेत्रादिदानाच्च गृहोपकरणादिना॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001080052, "chapter_id": 21080, "verse_number": "१-१६-५३", "content_sanskrit": "कृत्तिकाभौमवारेषु स्कंदस्य यजनान्नृणाम् ।\nदीपघंटादिदानाद्वै वाक्सिद्धिरचिराद्भवेत्॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001080053, "chapter_id": 21080, "verse_number": "१-१६-५४", "content_sanskrit": "कृत्तिकासौम्यवारेषु विष्णोर्वै यजनं नृणाम् ।\nदध्योदनस्य दानं च सत्संतानकरं भवेत्॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001080054, "chapter_id": 21080, "verse_number": "१-१६-५५", "content_sanskrit": "कृतिकागुरुवारेषु ब्रह्मणो यजनाद्धनैः ।\nमधुस्वर्णाज्यदानेन भोगवृद्धिर्भवेन्नृणाम्॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001080055, "chapter_id": 21080, "verse_number": "१-१६-५६", "content_sanskrit": "कृत्तिकाशुक्रवारेषु गजकोमेडयाजनात् ।\nगंधपुष्पान्नदानेन भोग्यवृद्धिर्भवेन्नृणाम्॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001080056, "chapter_id": 21080, "verse_number": "१-१६-५७", "content_sanskrit": "वंध्या सुपुत्रं लभते स्वर्णरौप्यादिदानतः ।\nकृत्तिकाशनिवारेषु दिक्पालानां च वंदनम्॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001080057, "chapter_id": 21080, "verse_number": "१-१६-५८", "content_sanskrit": "दिग्गजानां च नागानां सेतुपानां च पूजनम् ।\nत्र्यंबकस्य च रुद्रस्य विष्णोः पापहरस्य च॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001080058, "chapter_id": 21080, "verse_number": "१-१६-५९", "content_sanskrit": "ज्ञानदं ब्रह्मणश्चैव धन्वंतर्यश्विनोस्तथा ।\nरोगापमृत्युहरणं तत्कालव्याधिशांतिदम्॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001080059, "chapter_id": 21080, "verse_number": "१-१६-६०", "content_sanskrit": "लवणायसतैलानां माषादीनां च दानतः ।\nत्रिकटुफलगंधानां जलादीनां च दानतः॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001080060, "chapter_id": 21080, "verse_number": "१-१६-६१", "content_sanskrit": "द्रवाणां कठिनानां च प्रस्थेन पलमानतः ।\nस्वर्गप्राप्तिर्धनुर्मासे ह्युषःकाले च पूजनम्॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001080061, "chapter_id": 21080, "verse_number": "१-१६-६२", "content_sanskrit": "शिवादीनां च सर्वेषां क्रमाद्वै सर्वसिद्धये ।\nशाल्यन्नस्य हविष्यस्य नैवेद्यं शस्तमुच्यते॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001080062, "chapter_id": 21080, "verse_number": "१-१६-६३", "content_sanskrit": "विविधान्नस्य नैवेद्यं धनुर्मासे विशिष्यते ।\nमार्गशीर्षेऽन्नदस्यैव सर्वमिष्टफलं भवेत्॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001080063, "chapter_id": 21080, "verse_number": "१-१६-६४", "content_sanskrit": "पापक्षयं चेष्टसिद्धिं चारोग्यं धर्ममेव च ।\nसम्यग्वेदपरिज्ञानं सदनुष्ठानमेव च॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001080064, "chapter_id": 21080, "verse_number": "१-१६-६५", "content_sanskrit": "इहामुत्र महाभोगानंते योगं च शाश्वतम् ।\nवेदांतज्ञानसिद्धिं च मार्गशीर्षान्नदो लभेत्॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001080065, "chapter_id": 21080, "verse_number": "१-१६-६६", "content_sanskrit": "मार्गशीर्षे ह्युषःकाले दिनत्रयमथापि वा ।\nयजेद्देवान्भोगकामो नाधनुर्मासिको भवेत्॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001080066, "chapter_id": 21080, "verse_number": "१-१६-६७", "content_sanskrit": "यावत्संगवकालं तु धनुर्मासो विधीयते ।\nधनुर्मासे निराहारो मासमात्रं जितेंद्रियः॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001080067, "chapter_id": 21080, "verse_number": "१-१६-६८", "content_sanskrit": "आमध्याह्नजपेद्विप्रो गायत्रीं वेदमातरम् ।\nपंचाक्षरादिकान्मंत्रान्पश्चादासप्तिकं जपेत्॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001080068, "chapter_id": 21080, "verse_number": "१-१६-६९", "content_sanskrit": "ज्ञानं लब्ध्वा च देहांते विप्रो मुक्तिमवाप्नुयात् ।\nअन्येषां नरनारीणां त्रिःस्नानेन जपेन च॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001080069, "chapter_id": 21080, "verse_number": "१-१६-७०", "content_sanskrit": "सदा पंचाक्षरस्यैव विशुद्धं ज्ञानमाप्यते ।\nइष्टमन्त्रान्सदा जप्त्वा महापापक्षयं लभेत्॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001080070, "chapter_id": 21080, "verse_number": "१-१६-७१", "content_sanskrit": "धनुर्मासे विशेषेण महानैवेद्यमाचरेत् ।\nशालितंडुलभारेण मरीचप्रस्थकेन च॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7001080071, "chapter_id": 21080, "verse_number": "१-१६-७२", "content_sanskrit": "गणनाद्द्वादशं सर्वं मध्वाज्यकुडवेन हि ।\nद्रोणयुक्तेन मुद्गेन द्वादशव्यंजनेन च॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7001080072, "chapter_id": 21080, "verse_number": "१-१६-७३", "content_sanskrit": "घृतपक्वैरपूपैश्च मोदकैः शालिकादिभिः ।\nद्वादशैश्च दधिक्षीरैर्द्वादशप्रस्थकेन च॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7001080073, "chapter_id": 21080, "verse_number": "१-१६-७४", "content_sanskrit": "नारिकेलफलादीनां तथा गणनया सह ।\nद्वादशक्रमुकैर्युक्तं षट्त्रिंशत्पत्रकैर्युतम्॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7001080074, "chapter_id": 21080, "verse_number": "१-१६-७५", "content_sanskrit": "कर्पूरखुरचूर्णेन पंचसौगंधिकैर्युतम् ।\nतांबूलयुक्तं तु यदा महानैवेद्यलक्षणम्॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7001080075, "chapter_id": 21080, "verse_number": "१-१६-७६", "content_sanskrit": "महानैवेद्यमेतद्वै देवतार्पणपूर्वकम् ।\nवर्णानुक्रमपूर्वेण तद्भक्तेभ्यः प्रदापयेत्॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7001080076, "chapter_id": 21080, "verse_number": "१-१६-७७", "content_sanskrit": "एवं चौदननैवेद्याद्भूमौ राष्ट्रपतिर्भवेत् ।\nमहानैवेद्यदानेन नरः स्वर्गमवाप्नुयात्॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7001080077, "chapter_id": 21080, "verse_number": "१-१६-७८", "content_sanskrit": "महानैवेद्यदानेन सहस्रेण द्विजर्षभाः ।\nसत्यलोके च तल्लोके पूर्णमायुरवाप्नुयात्॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7001080078, "chapter_id": 21080, "verse_number": "१-१६-७९", "content_sanskrit": "सहस्राणां च त्रिंशत्या महानैवेद्यदानतः ।\nतदूर्ध्वलोकमाप्यैव न पुनर्जन्मभाग्भवेत्॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7001080079, "chapter_id": 21080, "verse_number": "१-१६-८०", "content_sanskrit": "सहस्राणां च षट्त्रिंशज्जन्म नैवेद्यमीरितम् ।\nतावन्नैवेद्यदानं तु महापूर्णं तदुच्यते॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7001080080, "chapter_id": 21080, "verse_number": "१-१६-८१", "content_sanskrit": "महापूर्णस्य नैवेद्यं जन्मनैवेद्यमिष्यते ।\nजन्मनैवेद्यदानेन पुनर्जन्म न विद्यते॥ ८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7001080081, "chapter_id": 21080, "verse_number": "१-१६-८२", "content_sanskrit": "ऊर्जे मासि दिने पुण्ये जन्म नैवेद्यमाचरेत् ।\nसंक्रांतिपातजन्मर्क्षपौर्णमास्यादिसंयुते॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7001080082, "chapter_id": 21080, "verse_number": "१-१६-८३", "content_sanskrit": "अब्दजन्मदिने कुर्याज्जन्मनैवेद्यमुत्तमम् ।\nमासांतरेषु जन्मर्क्षपूर्णयोगदिनेपि च॥ ८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7001080083, "chapter_id": 21080, "verse_number": "१-१६-८४", "content_sanskrit": "मेलने च शनैर्वापि तावत्साहस्रमाचरेत् ।\nजन्मनैवेद्यदानेन जन्मार्पणफलं लभेत्॥ ८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7001080084, "chapter_id": 21080, "verse_number": "१-१६-८५", "content_sanskrit": "जन्मार्पणाच्छिवः प्रीतिः स्वसायुज्यं ददाति हि ।\nइदं तज्जन्मनैवेद्यं शिवस्यैव प्रदापयेत्॥ ८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7001080085, "chapter_id": 21080, "verse_number": "१-१६-८६", "content_sanskrit": "योनिलिंगस्वरूपेण शिवो जन्मनिरूपकः ।\nतस्माज्जन्मनिवृत्त्यर्थं जन्म पूजा शिवस्य हि॥ ८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7001080086, "chapter_id": 21080, "verse_number": "१-१६-८७", "content_sanskrit": "बिंदुनादात्मकं सर्वं जगत्स्थावरजंगमम् ।\nबिंदुः शक्तिः शिवो नादः शिवशक्त्यात्मकं जगत्॥ ८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7001080087, "chapter_id": 21080, "verse_number": "१-१६-८८", "content_sanskrit": "नादाधारमिदं बिंदुर्बिंद्वाधारमिदं जगत् ।\nजगदाधारभूतौ हि बिंदुनादौ व्यवस्थितौ॥ ८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7001080088, "chapter_id": 21080, "verse_number": "१-१६-८९", "content_sanskrit": "बिन्दुनादयुतं सर्वं सकलीकरणं भवेत् ।\nसकलीकरणाज्जन्मजगत्प्राप्नोत्यसंशयः॥ ८९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7001080089, "chapter_id": 21080, "verse_number": "१-१६-९०", "content_sanskrit": "बिंदुनादात्मकं लिंगं जगत्कारणमुच्यते ।\nबिंदुर्देवीशिवो नादः शिवलिंगं तु कथ्यते॥ ९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7001080090, "chapter_id": 21080, "verse_number": "१-१६-९१", "content_sanskrit": "तस्माज्जन्मनिवृत्त्यर्थं शिवलिंगं प्रपूजयेत् ।\nमाता देवी बिंदुरूपा नादरूपः शिवः पिता॥ ९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7001080091, "chapter_id": 21080, "verse_number": "१-१६-९२", "content_sanskrit": "पूजिताभ्यां पितृभ्यां तु परमानंद एव हि ।\nपरमानंदलाभार्थं शिवलिंगं प्रपूजयेत्॥ ९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7001080092, "chapter_id": 21080, "verse_number": "१-१६-९३", "content_sanskrit": "सा देवी जगतां माता स शिवो जगतः पिता ।\nपित्रोः शुश्रूषके नित्यं कृपाधिक्यं हि वर्धते॥ ९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7001080093, "chapter_id": 21080, "verse_number": "१-१६-९४", "content_sanskrit": "कृपयांतर्गतैश्वर्यं पूजकस्य ददाति हि ।\nतस्मादंतर्गतानंदलाभार्थं मुनिपुंगवाः॥ ९४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7001080094, "chapter_id": 21080, "verse_number": "१-१६-९५", "content_sanskrit": "पितृमातृस्वरूपेण शिवलिंगं प्रपूजयेत् ।\nभर्गः पुरुषरूपो हि भर्गा प्रकृतिरुच्यते॥ ९५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7001080095, "chapter_id": 21080, "verse_number": "१-१६-९६", "content_sanskrit": "अव्यक्तांतरधिष्ठानं गर्भः पुरुष उच्यते ।\nसुव्यक्तांतरधिष्ठानं गर्भः प्रकृतिरुच्यते॥ ९६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7001080096, "chapter_id": 21080, "verse_number": "१-१६-९७", "content_sanskrit": "पुरुषत्वादिगर्भो हि गर्भवाञ्जनको यतः ।\nपुरुषात्प्रकृतो युक्तं प्रथमं जन्म कथ्यते॥ ९७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7001080097, "chapter_id": 21080, "verse_number": "१-१६-९८", "content_sanskrit": "प्रकृतेर्व्यक्ततां यातं द्वितीयं जन्म कथ्यते ।\nजन्म जंतुर्मृत्युजन्म पुरुषात्प्रतिपद्यते॥ ९८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7001080098, "chapter_id": 21080, "verse_number": "१-१६-९९", "content_sanskrit": "अन्यतो भाव्यतेऽवश्यं मायया जन्म कथ्यते ।\nजीर्यते जन्मकालाद्यत्तस्माज्जीव इति स्मृतः॥ ९९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7001080099, "chapter_id": 21080, "verse_number": "१-१६-१००", "content_sanskrit": "जन्यते तन्यते पाशैर्जीवशब्दार्थ एव हि ।\nजन्मपाशनिवृत्त्यर्थं जन्मलिंगं प्रपूजयेत्॥ १०० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7001080100, "chapter_id": 21080, "verse_number": "१-१६-१०१", "content_sanskrit": "भं वृद्धिं गच्छतीत्यर्थाद्भगः प्रकृतिरुच्यते ।\nप्राकृतैः शब्दमात्राद्यैः प्राकृतेंद्रियभोजनात्॥ १०१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7001080101, "chapter_id": 21080, "verse_number": "१-१६-१०२", "content_sanskrit": "भगस्येदं भोगमिति शब्दार्थो मुख्यतः श्रुतः ।\nमुख्यो भगस्तु प्रकृतिर्भगवाञ्छिव उच्यते॥ १०२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7001080102, "chapter_id": 21080, "verse_number": "१-१६-१०३", "content_sanskrit": "भगवान्भोगदाता हि नाऽन्यो भोगप्रदायकः ।\nभगस्वामी च भगवान्भर्ग इत्युच्यते बुधैः॥ १०३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7001080103, "chapter_id": 21080, "verse_number": "१-१६-१०४", "content_sanskrit": "भगेन सहितं लिंगं भगंलिंगेन संयुतम् ।\nइहामुत्र च भोगार्थं नित्यभोगार्थमेव च॥ १०४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7001080104, "chapter_id": 21080, "verse_number": "१-१६-१०५", "content_sanskrit": "भगवंतं महादेवं शिवलिंगं प्रपूजयेत् ।\nलोकप्रसविता सूर्यस्तच्चिह्नं प्रसवाद्भवेत्॥ १०५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7001080105, "chapter_id": 21080, "verse_number": "१-१६-१०६", "content_sanskrit": "लिंगेप्रसूतिकर्तारं लिंगिनं पुरुषो यजेत् ।\nलिंगार्थगमकं चिह्नं लिंगमित्यभिधीयते॥ १०६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7001080106, "chapter_id": 21080, "verse_number": "१-१६-१०७", "content_sanskrit": "लिंगमर्थं हि पुरुषं शिवं गमयतीत्यदः ।\nशिवशक्त्योश्च चिह्नस्य मेलनं लिंगमुच्यते॥ १०७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7001080107, "chapter_id": 21080, "verse_number": "१-१६-१०८", "content_sanskrit": "स्वचिह्नपूजनात्प्रीतश्चिह्नकार्यं न वीयते ।\nचिह्नकार्यं तु जन्मादिजन्माद्यं विनिवर्तते॥ १०८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7001080108, "chapter_id": 21080, "verse_number": "१-१६-१०९", "content_sanskrit": "प्राकृतैः पुरुषैश्चापि बाह्याभ्यंतरसंभवैः ।\nषोडशैरुपचारैश्च शिवलिंगं प्रपूजयेत्॥ १०९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7001080109, "chapter_id": 21080, "verse_number": "१-१६-११०", "content_sanskrit": "एवमादित्यवारे हि पूजा जन्मनिवर्तिका ।\nआदिवारे महालिंगं प्रणवेनैव पूजयेत्॥ ११० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7001080110, "chapter_id": 21080, "verse_number": "१-१६-१११", "content_sanskrit": "आदिवारे पंचगव्यैरभिषेको विशिष्यते ।\nगोमयं गोजलं क्षीरं दध्याज्यं पंचगव्यकम्॥ १११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7001080111, "chapter_id": 21080, "verse_number": "१-१६-११२", "content_sanskrit": "क्षीराद्यं च पृथक्च्चैव मधुना चेक्षुसारकैः ।\nगव्यक्षीरान्ननैवेद्यं प्रणवेनैव कारयेत्॥ ११२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7001080112, "chapter_id": 21080, "verse_number": "१-१६-११३", "content_sanskrit": "प्रणवं ध्वनिलिंगं तु नादलिंगं स्वयंभुवः ।\nबिंदुलिंगं तु यंत्रं स्यान्मकारं तु प्रतिष्ठितम्॥ ११३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7001080113, "chapter_id": 21080, "verse_number": "१-१६-११४", "content_sanskrit": "उकारं चरलिंगं स्यादकारं गुरुविग्रहम् ।\nषड्लिंगं पूजया नित्यं जीवन्मुक्तो न संशयः॥ ११४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7001080114, "chapter_id": 21080, "verse_number": "१-१६-११५", "content_sanskrit": "शिवस्य भक्त्या पूजा हि जन्ममुक्तिकरी नृणाम् ।\nरुद्रा क्षधारणात्पादमर्धं वैभूतिधारणात्॥ ११५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7001080115, "chapter_id": 21080, "verse_number": "१-१६-११६", "content_sanskrit": "त्रिपादं मंत्रजाप्याच्च पूजया पूर्णभक्तिमान् ।\nशिवलिंगं च भक्तं च पूज्य मोक्षं लभेन्नरः॥ ११६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7001080116, "chapter_id": 21080, "verse_number": "१-१६-११७", "content_sanskrit": "य इमं पठतेऽध्यायं शृणुयाद्वा समाहितः ।\nतस्यैव शिवभक्तिश्च वर्धते सुदृढा द्विजाः॥ ११७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}]