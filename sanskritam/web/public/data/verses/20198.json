[{"id": 7000198000, "chapter_id": 20198, "verse_number": "१९८-१", "content_sanskrit": "हलिक्रीडावर्णनम् व्यास उवाच वने विहरतस्तस्य सह गोपैर्महात्मनः ।\nमानुषच्छद्मरूपस्य शेषस्य धरणीभृतः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000198001, "chapter_id": 20198, "verse_number": "१९८-२", "content_sanskrit": "निष्पादितोरुकार्यस्य कार्येणैवावतारिमः ।\nउपभोगार्थमत्यर्तं वरुणः प्राह वारुणीम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000198002, "chapter_id": 20198, "verse_number": "१९८-३", "content_sanskrit": "वरुण उवाच अभीष्टां सर्वदा ह्यस्य मदिरे त्वं महौजसः ।\nअनन्तस्योपभोगाय तस्य गच्छ मुदे शुभे ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000198003, "chapter_id": 20198, "verse_number": "१९८-४", "content_sanskrit": "इत्युक्ता वारुणी तेन सनिधानमथाकरोत् ।\nवृन्दावनतटोत्पन्नकदम्बतरुकोटरे ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000198004, "chapter_id": 20198, "verse_number": "१९८-५", "content_sanskrit": "विचरन्बलदेवोऽपि मदिरागन्धमुद्धतम् ।\nआग्राय मदिराहर्षमवापाथ पुरातनम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000198005, "chapter_id": 20198, "verse_number": "१९८-६", "content_sanskrit": "ततः कदम्बात्सहसा मद्यधारां स लाङ्गली ।\nपतन्तीं वीक्ष्य मुनयः प्रययौ परमां मुदम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000198006, "chapter_id": 20198, "verse_number": "१९८-७", "content_sanskrit": "पपौ च गोपगोपीभिः समवेतो मुदाऽन्वितः ।\nउपगीयमानो ललितं गीतवाद्यविशारदैः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000198007, "chapter_id": 20198, "verse_number": "१९८-८", "content_sanskrit": "श्रमतोऽत्यन्तघर्माम्भःकणिकामौक्तिकोज्ज्वलः ।\nआगच्छ यमुने स्नातुमिच्छामीत्याह विह्वलः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000198008, "chapter_id": 20198, "verse_number": "१९८-९", "content_sanskrit": "तस्य वाचं नदी सा तु मत्तोक्तामवमन्य वै ।\nनाऽऽजगाम ततः क्रुद्धो हलं जग्राह लाङ्गली ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000198009, "chapter_id": 20198, "verse_number": "१९८-१०", "content_sanskrit": "गृहीत्वा तां तटेनैव चकर्ष मदविह्वलः ।\nपापे नाऽऽयासि नाऽऽयासि गम्यतामिच्छयाऽन्यतः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000198010, "chapter_id": 20198, "verse_number": "१९८-११", "content_sanskrit": "सा गृष्टा तेन सहसा मार्गं संत्यज्य निम्नगा ।\nयत्राऽऽस्ते बलदेवोऽसौ प्लावयामास तद्वनम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000198011, "chapter_id": 20198, "verse_number": "१९८-१२", "content_sanskrit": "शरीरिणी तथोपेत्य त्रासविह्वललोचना ।\nप्रसीदेत्यब्रवीद्रामं मुञ्च मां मुशलायुध ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000198012, "chapter_id": 20198, "verse_number": "१९८-१३", "content_sanskrit": "सोऽब्रवीदवजानासि मम शौर्यबलं यदि ।\nसोऽहं त्वां हलपातेन नयिष्याम सहस्रधा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000198013, "chapter_id": 20198, "verse_number": "१९८-१४", "content_sanskrit": "व्यास उवाच इत्युक्तयाऽतिसंत्रस्ततया नद्या प्रसादितः ।\nभूभागे प्लाविते तत्र मुमोच यमुनां बलः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000198014, "chapter_id": 20198, "verse_number": "१९८-१५", "content_sanskrit": "ततः स्नातस्य वै कान्तिराजगाम महावने ।\nअवतंसोत्पलं चारु गृहीत्वैकं च कुण्डलम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000198015, "chapter_id": 20198, "verse_number": "१९८-१६", "content_sanskrit": "वरुणप्रहितां चास्मै मालामम्लानपङ्कजाम् ।\nसमुद्रार्हे तथा वस्त्रे नीले लक्ष्मीरयच्छत ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000198016, "chapter_id": 20198, "verse_number": "१९८-१७", "content_sanskrit": "कृतावतंसः स तदा चारुकुण्डलभूषितः ।\nनीलाम्बरधरः स्रग्वी शुशुभे कान्तिसंयुतः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000198017, "chapter_id": 20198, "verse_number": "१९८-१८", "content_sanskrit": "इत्थं विभूषितो रेमे तत्र रामस्तदा व्रजे ।\nमासद्वयेन यातश्च पुनः स मथुरां पुरीम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000198018, "chapter_id": 20198, "verse_number": "१९८-१९", "content_sanskrit": "रेवतीं चैव तनयां रैवतस्य महीपतेः ।\nउपयेमे बलस्तस्यां जज्ञाते निशठोल्मुकौ ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]