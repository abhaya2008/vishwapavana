[{"id": 7002073000, "chapter_id": 22073, "verse_number": "११८-१", "content_sanskrit": "अग्निरुवाच ।\nउत्तरं यत्समुद्रस्य हिमाद्रेश्चैव दक्षिणं ।\nवर्षं तद्भारतं नाम नवसाहस्रविस्तृतं ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002073001, "chapter_id": 22073, "verse_number": "११८-२", "content_sanskrit": "कर्मभूमिरियं स्वर्गमपवर्गं च गच्छतां ।\nमहेन्द्रो मलयः सह्यः शुक्तिमान् हेमपर्वतः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002073002, "chapter_id": 22073, "verse_number": "११८-३", "content_sanskrit": "विन्ध्यश्च पारिपात्रश्च सप्तात्र कुलपर्वताः ।\nइन्द्रद्वीपः कसेरुश्च ताम्रवर्णो गभस्तिमान् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002073003, "chapter_id": 22073, "verse_number": "११८-४", "content_sanskrit": "नागद्वीपस्तथा सौम्यो गान्धर्वस्त्वथ वारुणः ।\nअयं तु नवमस्तेषु द्वीपः सागरसंवृतः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002073004, "chapter_id": 22073, "verse_number": "११८-५", "content_sanskrit": "योजनानां सहस्राणि द्वीपोयं दक्षिणोत्तरात् ।\nनव भेदा भारतस्य मध्यभेदेऽथ पूर्वतः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002073005, "chapter_id": 22073, "verse_number": "११८-६", "content_sanskrit": "किराता यवनाश्चापि ब्राह्मणाद्याश्च मध्यतः ।\nवेदस्मृतिमुखा नद्यः पारिपात्रोद्भवास्तथा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002073006, "chapter_id": 22073, "verse_number": "११८-७", "content_sanskrit": "विन्ध्याच्च नर्मदाद्याः स्युः सह्यात्तापी पयोष्णिका ।\nगोदावरीभीमरथीकृष्णवेणादिकास्तथा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002073007, "chapter_id": 22073, "verse_number": "११८-८", "content_sanskrit": "मलयात्कृतमालाद्यास्त्रिसामाद्या महेन्द्रजाः ।\nकुमाराद्याः शुक्तिमतो हिमाद्रेश्चन्द्रभागका ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002073008, "chapter_id": 22073, "verse_number": "११८-९", "content_sanskrit": "पश्चिमे कुरुपाञ्चालमध्यदेशादयःस्थिताः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}]