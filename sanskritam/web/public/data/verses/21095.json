[{"id": 7001095000, "chapter_id": 21095, "verse_number": "२-१-६-१", "content_sanskrit": "॥ब्रह्मोवाच  ।\nभो ब्रह्मन्साधु पृष्टोऽहं त्वया विबुधसत्तम ।\nलोकोपकारिणा नित्यं लोकानां हितकाम्यया॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001095001, "chapter_id": 21095, "verse_number": "२-१-६-२", "content_sanskrit": "यच्छ्रुत्वा सर्वलोकानां सर्वपापक्षयो भवेत् ।\nतदहं ते प्रवक्ष्यामि शिवतत्त्वमनामयम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001095002, "chapter_id": 21095, "verse_number": "२-१-६-३", "content_sanskrit": "शिवतत्त्वं मया नैव विष्णुनापि यथार्थतः ।\nज्ञातश्च परमं रूपमद्भुतं च परेण न॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001095003, "chapter_id": 21095, "verse_number": "२-१-६-४", "content_sanskrit": "महाप्रलयकाले च नष्टे स्थावरजंगमे ।\nआसीत्तमोमयं सर्वमनर्कग्रहतारकम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001095004, "chapter_id": 21095, "verse_number": "२-१-६-५", "content_sanskrit": "अचन्द्रमनहोरात्रमनग्न्यनिलभूजलम् ।\nअप्रधानं वियच्छून्यमन्यतेजोविवर्जितम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001095005, "chapter_id": 21095, "verse_number": "२-१-६-६", "content_sanskrit": "अदृष्टत्वादिरहितं शब्दस्पर्शसमुज्झितम् ।\nअव्यक्तगंधरूपं च रसत्यक्तमदिङ्मुखम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001095006, "chapter_id": 21095, "verse_number": "२-१-६-७", "content_sanskrit": "इत्थं सत्यंधतमसे सूचीभेद्यं निरंतरे ।\nतत्सद्ब्रह्मेति यच्छ्रुत्वा सदेकं प्रतिपद्यते॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001095007, "chapter_id": 21095, "verse_number": "२-१-६-८", "content_sanskrit": "इतीदृशं यदा नासीद्यत्तत्सदसदात्मकम् ।\nयोगिनोंतर्हिताकाशे यत्पश्यंति निरंतरम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001095008, "chapter_id": 21095, "verse_number": "२-१-६-९", "content_sanskrit": "अमनोगोचरम्वाचां विषयन्न कदाचन ।\nअनामरूपवर्णं च न च स्थूलं न यत्कृशम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001095009, "chapter_id": 21095, "verse_number": "२-१-६-१०", "content_sanskrit": "अह्रस्वदीर्घमलघुगुरुत्वपरिवर्जितम् ।\nन यत्रोपचयः कश्चित्तथा नापचयोऽपि च॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001095010, "chapter_id": 21095, "verse_number": "२-१-६-११", "content_sanskrit": "अभिधत्ते स चकितं यदस्तीति श्रुतिः पुनः ।\nसत्यं ज्ञानमनंतं च परानंदम्परम्महः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001095011, "chapter_id": 21095, "verse_number": "२-१-६-१२", "content_sanskrit": "अप्रमेयमनाधारमविकारमनाकृति ।\nनिर्गुणं योगिगम्यञ्च सर्वव्याप्येककारकम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001095012, "chapter_id": 21095, "verse_number": "२-१-६-१३", "content_sanskrit": "निर्विकल्पं निरारंभं निर्मायं निरुपद्रवम् ।\nअद्वितीयमनाद्यन्तमविकाशं चिदात्मकम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001095013, "chapter_id": 21095, "verse_number": "२-१-६-१४", "content_sanskrit": "यस्येत्थं संविकल्पंते संज्ञासंज्ञोक्तितः स्म वै ।\nकियता चैव कालेन द्वितीयेच्छाऽभवत्किल॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001095014, "chapter_id": 21095, "verse_number": "२-१-६-१५", "content_sanskrit": "अमूर्तेन स्वमूर्तिश्च तेनाकल्पि स्वलीलया ।\nसर्वैश्वर्यगुणोपेता सर्वज्ञानमयी शुभा॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001095015, "chapter_id": 21095, "verse_number": "२-१-६-१६", "content_sanskrit": "सर्वगा सर्वरूपा च सर्वदृक्सर्वकारिणी ।\nसर्वेकवंद्या सर्वाद्या सर्वदा सर्वसंस्कृतिः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001095016, "chapter_id": 21095, "verse_number": "२-१-६-१७", "content_sanskrit": "परिकल्येति तां मूर्तिमैश्वरीं शुद्धरूपिणीम् ।\nअद्वितीयमनाद्यंतं सर्वाभासं चिदात्मकम् ।\nअंतर्दधे पराख्यं यद्ब्रह्म सर्वगमव्ययम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001095017, "chapter_id": 21095, "verse_number": "२-१-६-१८", "content_sanskrit": "अमूर्ते यत्पराख्यं वै तस्य मूर्तिस्सदाशिवः ।\nअर्वाचीनाः पराचीना ईश्वरं तं जगुर्बुधाः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001095018, "chapter_id": 21095, "verse_number": "२-१-६-१९", "content_sanskrit": "शक्तिस्तदैकलेनापि स्वैरं विहरता तनुः ।\nस्वविग्रहात्स्वयं सृष्टा स्वशरीरानपायिनी॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001095019, "chapter_id": 21095, "verse_number": "२-१-६-२०", "content_sanskrit": "प्रधानं प्रकृति तां च मायां गुणवतीं पराम् ।\nबुद्धितत्त्वस्य जननीमाहुर्विकृतिवर्जिताम्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001095020, "chapter_id": 21095, "verse_number": "२-१-६-२१", "content_sanskrit": "सा शक्तिरम्बिका प्रोक्ता प्रकृतिस्सकलेश्वरी ।\nत्रिदेवजननी नित्या मूलकारणमित्युत॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001095021, "chapter_id": 21095, "verse_number": "२-१-६-२२", "content_sanskrit": "अस्या अष्टौ भुजाश्चासन्विचित्रवदना शुभा ।\nराकाचन्द्रसहस्रस्य वदने भाश्च नित्यशः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001095022, "chapter_id": 21095, "verse_number": "२-१-६-२३", "content_sanskrit": "नानाभरणसंयुक्ता नानागतिसमन्विता ।\nनानायुधधरा देवी फुल्लपंकजलोचना॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001095023, "chapter_id": 21095, "verse_number": "२-१-६-२४", "content_sanskrit": "अचिंत्यतेजसा युक्ता सर्वयोनिस्समुद्यता ।\nएकाकिनी यदा माया संयोगाच्चाप्यनेकिका॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001095024, "chapter_id": 21095, "verse_number": "२-१-६-२५", "content_sanskrit": "परः पुमानीश्वरस्स शिवश्शंभुरनीश्वरः ।\nशीर्षे मन्दाकिनीधारी भालचन्द्रस्त्रिलोचनः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001095025, "chapter_id": 21095, "verse_number": "२-१-६-२६", "content_sanskrit": "पंचवक्त्रः प्रसन्नात्मा दशबाहुस्त्रिशूलधृक् ।\nकर्पूरगौरसुसितो भस्मोद्धूलितविग्रहः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001095026, "chapter_id": 21095, "verse_number": "२-१-६-२७", "content_sanskrit": "युगपच्च तया शक्त्या साकं कालस्वरूपिणा ।\nशिवलोकाभिधं क्षेत्रं निर्मितं तेन ब्रह्मणा॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001095027, "chapter_id": 21095, "verse_number": "२-१-६-२८", "content_sanskrit": "तदेव काशिकेत्येतत्प्रोच्यते क्षेत्रमुत्तमम् ।\nपरं निर्वाणसंख्यानं सर्वोपरि विराजितम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001095028, "chapter_id": 21095, "verse_number": "२-१-६-२९", "content_sanskrit": "ताभ्यां च रममाणाभ्यां च तस्मिन्क्षेत्रे मनोरमे ।\nपरमानंदरूपाभ्यां परमानन्दरूपिणी॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001095029, "chapter_id": 21095, "verse_number": "२-१-६-३०", "content_sanskrit": "मुने प्रलयकालेपि न तत्क्षेत्रं कदाचन ।\nविमुक्तं हि शिवाभ्यां यदविमुक्तं ततो विदुः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001095030, "chapter_id": 21095, "verse_number": "२-१-६-३१", "content_sanskrit": "अस्यानन्दवनं नाम पुराकारि पिनाकिना ।\nक्षेत्रस्यानंदहेतुत्वादविमुक्तमनंतरम्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001095031, "chapter_id": 21095, "verse_number": "२-१-६-३२", "content_sanskrit": "अथानन्दवने तस्मिञ्च्छिवयो रममाणयोः ।\nइच्छेत्यभूत्सुरर्षे हि सृज्यः कोप्यपरः किल॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001095032, "chapter_id": 21095, "verse_number": "२-१-६-३३", "content_sanskrit": "यस्मिन्यस्य महाभारमावां स्वस्वैरचारिणौ ।\nनिर्वाणधारणं कुर्वः केवलं काशिशायिनौ॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001095033, "chapter_id": 21095, "verse_number": "२-१-६-३४", "content_sanskrit": "स एव सर्वं कुरुतां स एव परिपातु च ।\nस एव संवृणोत्वं ते मदनुग्रहतस्सदा॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001095034, "chapter_id": 21095, "verse_number": "२-१-६-३५", "content_sanskrit": "चेतस्समुद्रमाकुंच्य चिंताकल्लोललोलितम् ।\nसत्त्वरत्नं तमोग्राहं रजोविद्रुमवल्लितम्॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001095035, "chapter_id": 21095, "verse_number": "२-१-६-३६", "content_sanskrit": "यस्य प्रसादात्तिष्ठावस्सुखमानंदकानने ।\nपरिक्षिप्तमनोवृत्तौ बहिश्चिंतातुरे सुखम्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001095036, "chapter_id": 21095, "verse_number": "२-१-६-३७", "content_sanskrit": "संप्रधार्य्येति स विभुस्तया शक्त्या परेश्वरः ।\nसव्ये व्यापारयांचक्रे दशमेंऽगेसुधासवम्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001095037, "chapter_id": 21095, "verse_number": "२-१-६-३८", "content_sanskrit": "ततः पुमानाविरासीदेकस्त्रैलोक्यसुंदरः ।\nशांतस्सत्त्वगुणोद्रिक्तो गांभीर्य्यामितसागरः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001095038, "chapter_id": 21095, "verse_number": "२-१-६-३९", "content_sanskrit": "तथा च क्षमया युक्तो मुनेऽलब्धोपमो ऽभवत् ।\nइन्द्रनीलद्युतिः श्रीमान्पुण्डरीकोत्तमेक्षणः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001095039, "chapter_id": 21095, "verse_number": "२-१-६-४०", "content_sanskrit": "सुवर्णकृतिभृच्छ्रेष्ठ दुकूलयुगलावृतः ।\nलसत्प्रचंडदोर्दण्डयुगलोह्यपराजितः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001095040, "chapter_id": 21095, "verse_number": "२-१-६-४१", "content_sanskrit": "ततस्स पुरुषश्शंभुं प्रणम्य परमेश्वरम् ।\nनामानि कुरु मे स्वामिन्वद कर्मं जगाविति॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001095041, "chapter_id": 21095, "verse_number": "२-१-६-४२", "content_sanskrit": "तच्छ्रुत्वा वचनम्प्राह शंकरः प्रहसन्प्रभुः ।\nपुरुषं तं महेशानो वाचा मेघगभीरया॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001095042, "chapter_id": 21095, "verse_number": "२-१-६-४३", "content_sanskrit": "शिव उवाच ।\nविष्ण्वितिव्यापकत्वात्ते नाम ख्यातं भविष्यति ।\nबहून्यन्यानि नामानि भक्तसौख्यकराणि ह॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001095043, "chapter_id": 21095, "verse_number": "२-१-६-४४", "content_sanskrit": "तपः कुरु दृढो भूत्वा परमं कार्यसाधनम् ।\nइत्युक्त्वा श्वासमार्गेण ददौ च निगमं ततः॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001095044, "chapter_id": 21095, "verse_number": "२-१-६-४५", "content_sanskrit": "ततोऽच्युतश्शिवं नत्वा चकार विपुलं तपः ।\nअंतर्द्धानं गतश्शक्त्या सलोकः परमेश्वरः॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001095045, "chapter_id": 21095, "verse_number": "२-१-६-४६", "content_sanskrit": "दिव्यं द्वादश साहस्रं वर्षं तप्त्वापि चाच्युतः ।\nन प्राप स्वाभिलषितं सर्वदं शंभुदर्शनम्॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001095046, "chapter_id": 21095, "verse_number": "२-१-६-४७", "content_sanskrit": "तत्तत्संशयमापन्नश्चिंतितं हृदि सादरम् ।\nमयाद्य किं प्रकर्तव्यमिति विष्णुश्शिवं स्मरन्॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001095047, "chapter_id": 21095, "verse_number": "२-१-६-४८", "content_sanskrit": "एतस्मिन्नंतरे वाणी समुत्पन्ना शिवाच्छुभा ।\nतपः पुनः प्रकर्त्तव्यं संशयस्यापनुत्तये॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001095048, "chapter_id": 21095, "verse_number": "२-१-६-४९", "content_sanskrit": "ततस्तेन च तच्छ्रुत्वा तपस्तप्तं सुदारुणम् ।\nबहुकालं तदा ब्रह्मध्यानमार्गपरेण हि॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001095049, "chapter_id": 21095, "verse_number": "२-१-६-५०", "content_sanskrit": "ततस्स पुरुषो विष्णुः प्रबुद्धो ध्यानमार्गतः ।\nसुप्रीतो विस्मयं प्राप्तः किं यत्तव महा इति॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001095050, "chapter_id": 21095, "verse_number": "२-१-६-५१", "content_sanskrit": "परिश्रमवतस्तस्य विष्णोः स्वाङ्गेभ्य एव च ।\nजलधारा हि संयाता विविधाश्शिवमायया॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001095051, "chapter_id": 21095, "verse_number": "२-१-६-५२", "content_sanskrit": "अभिव्याप्तं च सकलं शून्यं यत्तन्महामुने ।\nब्रह्मरूपं जलमभूत्स्पर्शनात्पापनाशनम्॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001095052, "chapter_id": 21095, "verse_number": "२-१-६-५३", "content_sanskrit": "तदा श्रांतश्च पुरुषो विष्णुस्तस्मिञ्जले स्वयम् ।\nसुष्वाप परम प्रीतो बहुकालं विमोहितः॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001095053, "chapter_id": 21095, "verse_number": "२-१-६-५४", "content_sanskrit": "नारायणेति नामापि तस्यसीच्छ्रुतिसंमतम् ।\nनान्यत्किंचित्तदा ह्यासीत्प्राकृतं पुरुषं विना॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001095054, "chapter_id": 21095, "verse_number": "२-१-६-५५", "content_sanskrit": "एतस्मिन्नन्तरे काले तत्त्वान्यासन्महात्मनः ।\nतत्प्रकारं शृणु प्राज्ञ गदतो मे महामते॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001095055, "chapter_id": 21095, "verse_number": "२-१-६-५६", "content_sanskrit": "प्रकृतेश्च महानासीन्महतश्च गुणास्त्रयः ।\nअहंकारस्ततो जातस्त्रिविधो गुणभेदतः॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001095056, "chapter_id": 21095, "verse_number": "२-१-६-५७", "content_sanskrit": "तन्मात्राश्च ततो जातः पञ्चभूतानि वै तता ।\nतदैव तानीन्द्रियाणि ज्ञानकर्ममयानि च॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001095057, "chapter_id": 21095, "verse_number": "२-१-६-५८", "content_sanskrit": "तत्त्वानामिति संख्यानमुक्तं ते ऋषिसत्तम ।\nजडात्मकञ्च तत्सर्वं प्रकृतेः पुरुषं विना॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001095058, "chapter_id": 21095, "verse_number": "२-१-६-५९", "content_sanskrit": "तत्तदैकीकृतं तत्त्वं चतुर्विंशतिसंख्यकम् ।\nशिवेच्छया गृहीत्वा स सुष्वाप ब्रह्मरूपके॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]