[{"id": 40001917, "chapter_id": 8849, "verse_number": "1", "content_sanskrit": ". जनकस्य वचश्श्रुत्वा विश्वामित्रो महामुनि: । धनुर्दर्शय रामाय इति होवाच पार्थिवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40001918, "chapter_id": 8849, "verse_number": "2", "content_sanskrit": "ततस्स राजा जनक: सामन्तान्व्यादिदेश ह। धनुरानीयतां दिव्यं गन्धमाल्यविभूषितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40001919, "chapter_id": 8849, "verse_number": "3", "content_sanskrit": "जनकेन समादिष्टा: सचिवा प्राविशन् पुरीम्। तद्धनु: पुरत: कृत्वा निर्जग्मु: पार्थिवाज्ञया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40001920, "chapter_id": 8849, "verse_number": "4", "content_sanskrit": "नृणां शतानि पञ्चाशद्व्यायतानां महात्मनाम्। मञ्जूषामष्टचक्रां तां समूहुस्ते कथञ्चन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40001921, "chapter_id": 8849, "verse_number": "5", "content_sanskrit": "तामादाय तु मञ्जूषामायसीं यत्र तद्धनु:। सुरोपमं ते जनकमूचुर्नृपतिमन्त्रिण: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40001922, "chapter_id": 8849, "verse_number": "6", "content_sanskrit": "इदं धनुर्वरं राजन् पूजितं सर्वराजभि:। मिथिलाधिप राजेन्द्र दर्शनीयं यदिच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40001923, "chapter_id": 8849, "verse_number": "7", "content_sanskrit": "तेषां नृपो वच: श्रुत्वा कृताञ्जलिरभाषत। विश्वामित्रं महात्मानं तौ चोभौ रामलक्ष्मणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40001924, "chapter_id": 8849, "verse_number": "8", "content_sanskrit": "इदं धनुर्वरं ब्रह्मन् जनकैरभिपूजितम्। राजभिश्च महावीर्यै: अशक्तै: पूरितुं पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40001925, "chapter_id": 8849, "verse_number": "9", "content_sanskrit": "नैतत्सुरगणास्सर्वे नासुरा न च राक्षसा:। गन्धर्वयक्षप्रवरा: सकिन्नरमहोरगा: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40001926, "chapter_id": 8849, "verse_number": "10", "content_sanskrit": "क्व गतिर्मानुषाणां च धनुषोऽस्य प्रपूरणे। आरोपणे समायोगे वेपने तोलनेऽपि वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40001927, "chapter_id": 8849, "verse_number": "11", "content_sanskrit": "तदेतद्धनुषां श्रेष्ठमानीतं मुनिपुङ्गव। दर्शयैतन्महाभाग अनयो: राजपुत्रयो: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40001928, "chapter_id": 8849, "verse_number": "12", "content_sanskrit": "विश्वामित्रस्तु धर्मात्मा श्रुत्वा जनकभाषितम्। वत्स राम धनु: पश्य इति राघवमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40001929, "chapter_id": 8849, "verse_number": "13", "content_sanskrit": "ब्रह्मर्षेर्वचनाद्रामो यत्र तिष्ठति तद्धनु:। मञ्जूषां तामपावृत्य दृष्ट्वा धनुरथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40001930, "chapter_id": 8849, "verse_number": "14", "content_sanskrit": "इदं धनुर्वरं ब्रह्मन् संस्पृशामीह पाणिना। यत्नवांश्च भविष्यामि तोलने पूरणेऽपि वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40001931, "chapter_id": 8849, "verse_number": "15", "content_sanskrit": "बाढमित्येव तं राजा मुनिश्च समभाषत। लीलया स धनुर्मध्ये जग्राह वचनान्मुने: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40001932, "chapter_id": 8849, "verse_number": "16", "content_sanskrit": "पश्यतां नृपसहस्राणां बहूनां रघुनन्दन: । आरोपयत्स धर्मात्मा सलीलमिव तद्धनु: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40001933, "chapter_id": 8849, "verse_number": "17", "content_sanskrit": "आरोपयित्वा धर्मात्मा पूरयामास तद्धनु:। तद्बभञ्ज धनुर्मध्ये नरश्रेष्ठो महायशा: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40001934, "chapter_id": 8849, "verse_number": "18", "content_sanskrit": "तस्य शब्दो महानासीत् निर्घातसमनिस्वन:। भूमिकम्पश्च सुमहान् पर्वतस्येव दीर्यत: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40001935, "chapter_id": 8849, "verse_number": "19", "content_sanskrit": "निपेतुश्च नरा स्सर्वे तेन शब्देन मोहिता:। वर्जयित्वा मुनिवरं राजानं तौ च राघवौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40001936, "chapter_id": 8849, "verse_number": "20", "content_sanskrit": "प्रत्याश्वस्ते जने तस्मिन्राजा विगतसाध्वस:। उवाच प्राञ्जलिर्वाक्यं वाक्यज्ञो मुनिपुङ्गवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40001937, "chapter_id": 8849, "verse_number": "21", "content_sanskrit": "भगवन् दृष्टवीर्यो मे रामो दशरथात्मज:। अत्यद्भुतमचिन्त्यं च न तर्कितमिदं मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40001938, "chapter_id": 8849, "verse_number": "22", "content_sanskrit": "जनकानां कुले कीर्तिमाहरिष्यति मे सुता। सीता भर्तारमासाद्य रामं दशरथात्मजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40001939, "chapter_id": 8849, "verse_number": "23", "content_sanskrit": "मम सत्या प्रतिज्ञा च वीर्यशुल्केति कौशिक। सीता प्राणैर्बहुमता देया रामाय मे सुता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40001940, "chapter_id": 8849, "verse_number": "24", "content_sanskrit": "भवतोऽनुमते ब्रह्मन् शीघ्रं गच्छन्तु मन्त्रिण:। मम कौशिक भद्रं ते अयोध्यां त्वरिता रथै: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40001941, "chapter_id": 8849, "verse_number": "25", "content_sanskrit": "राजानं प्रश्रितैर्वाक्यैरानयन्तु पुरं मम। प्रदानं वीर्यशुल्काया: कथयन्तु च सर्वश: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40001942, "chapter_id": 8849, "verse_number": "26", "content_sanskrit": "मुनिगुप्तौ च काकुत्स्थौ कथयन्तु नृपाय वै। प्रीयमाणं तु राजानमानयन्तु सुशीघ्रगा: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40001943, "chapter_id": 8849, "verse_number": "27", "content_sanskrit": "कौशिकश्च तथेत्याह राजा चाभाष्य मन्त्रिण: ॥ अयोध्यां प्रेषयामास धर्मात्मा कृतशासनान्। यथावृत्तं समाख्यातुमानेतुं च नृपं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]