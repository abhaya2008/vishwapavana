[{"id": 7004122000, "chapter_id": 24122, "verse_number": "४-७१-१", "content_sanskrit": "अगस्त्य उवाच ।\nकथं दुर्गेति वै नाम देव्या जातंमुमासुत ।\nकथं च काश्यां सा सेव्या समाचक्ष्वेति मामिह ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004122001, "chapter_id": 24122, "verse_number": "४-७१-२", "content_sanskrit": "स्कंद उवाच ।\nकथयामि महाबुद्धे यथा कलशसंभव ।\nदुर्गा नामाभवद्देव्या यथा सेव्या च साधकैः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004122002, "chapter_id": 24122, "verse_number": "४-७१-३", "content_sanskrit": "दुर्गो नाम मदादैत्यो रुरु दैत्यांगजोभवत् ।\nयश्च तप्त्वा तपस्तीव्रं पुंभ्योजेयत्वमाप्तवान् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004122003, "chapter_id": 24122, "verse_number": "४-७१-४", "content_sanskrit": "ततस्तेनाखिला लोका भूर्भुवःस्वर्मुखा अपि ।\nस्वसात्कृता विनिर्जित्य रणे स्वभुजसारतः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004122004, "chapter_id": 24122, "verse_number": "४-७१-५", "content_sanskrit": "स्वयमिंद्रः स्वयं वायुः स्वयं चंद्रः स्वयं यमः ।\nस्वयमग्निः स्वयं पाशी धनदोभूत्स्वयं बली ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004122005, "chapter_id": 24122, "verse_number": "४-७१-६", "content_sanskrit": "स्वयमीशानरुद्रार्क वसूनां पदमाददे ।\nतत्साध्वसाद्विमुक्तानि तपांस्यति तपस्विभिः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004122006, "chapter_id": 24122, "verse_number": "४-७१-७", "content_sanskrit": "न वेदाध्ययनं चक्रुर्ब्राह्मणास्तद्भयादिताः ।\nयज्ञवाटा विनिर्ध्वस्तास्तद्भटैरतिदुःसहैः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004122007, "chapter_id": 24122, "verse_number": "४-७१-८", "content_sanskrit": "विध्वस्ता बहुशः साध्व्यस्तैरमार्गकृतास्पदैः ।\nप्रसभं च परस्वानि अपहृत्य दुरासदाः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004122008, "chapter_id": 24122, "verse_number": "४-७१-९", "content_sanskrit": "अभोक्षिषुर्दुराचाराः क्रूरकर्मपरिग्रहाः ।\nनद्यो विमार्गगा आसञ्ज्वलंति न तथाग्नयः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004122009, "chapter_id": 24122, "verse_number": "४-७१-१०", "content_sanskrit": "ज्योतींषि न प्रदीप्यंति तद्भयाकुलितान्यहो ।\nदिग्वधूवसनन्यासन्विच्छायानि समंततः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004122010, "chapter_id": 24122, "verse_number": "४-७१-११", "content_sanskrit": "धर्मक्रियाविलुप्ताश्च प्रवृत्ताः सुकृतेतराः ।\nत एव जलदीभूय ववृषुर्निज लीलया ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004122011, "chapter_id": 24122, "verse_number": "४-७१-१२", "content_sanskrit": "सस्यानि तद्भयात्सूते त्वनुप्तापि वसुंधरा ।\nसदैव फलिनो जातास्तरवोप्यवकेशिनः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004122012, "chapter_id": 24122, "verse_number": "४-७१-१३", "content_sanskrit": "बंदीकृताः सुरर्षीणां पत्न्यस्तेनातिदर्पिणा ।\nदिवौकसः कृतास्तेन समस्ताः काननौकसः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004122013, "chapter_id": 24122, "verse_number": "४-७१-१४", "content_sanskrit": "मर्त्या अमर्त्यान्स्वगृहं प्राप्तानपि भयार्दिताः ।\nअपि संभाषमात्रेण नार्च्चयंति विपज्जुषः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004122014, "chapter_id": 24122, "verse_number": "४-७१-१५", "content_sanskrit": "स्कंद उवाच ।\nन कौलीन्यं न सद्वृत्तं महत्त्वाय प्रकल्पते ।\nएकमेव पदं श्रेयः पदभ्रंशो हि लाघवम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004122015, "chapter_id": 24122, "verse_number": "४-७१-१६", "content_sanskrit": "विपद्यपि हि ते धन्या न ये दैन्यप्रणोदिताः ।\nधनैर्मलिनचित्तानामालभंतेंगणं क्वचित् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004122016, "chapter_id": 24122, "verse_number": "४-७१-१७", "content_sanskrit": "पंचत्वमेव हि वरं लोके लाघववर्ज्जितम् ।\nनामरत्वमपि श्रेयो लाघवेन समन्वितम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004122017, "chapter_id": 24122, "verse_number": "४-७१-१८", "content_sanskrit": "त एव लोके जीवंति पुण्यभाजस्त एव वै ।\nविपद्यपि न गांभीर्यं यच्चेतोब्धिः परित्यजेत् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004122018, "chapter_id": 24122, "verse_number": "४-७१-१९", "content_sanskrit": "कदाचित्संपदुदयः कदाचिद्विपदुद्गमः ।\nदैवाद्द्वयमपि प्राप्य धीरो धैर्यं न हापयेत् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004122019, "chapter_id": 24122, "verse_number": "४-७१-२०", "content_sanskrit": "उदयानुदयौ प्राज्ञैर्द्रष्टव्यौ पुष्पवंतयोः ।\nसदैकरूपताऽत्याज्या हर्षाहर्षौ ततोऽध्रुवौ ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004122020, "chapter_id": 24122, "verse_number": "४-७१-२१", "content_sanskrit": "यस्त्वापदं समासाद्य दैन्यग्रस्तो विपद्यते ।\nतस्य लोकद्वयं नष्टं तस्माद्दैन्यं विवर्जयेत् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004122021, "chapter_id": 24122, "verse_number": "४-७१-२२", "content_sanskrit": "आपद्यपि हि ये धीरा इह लोके परत्र च ।\nन तान्पुनः स्पृशेदापत्तद्धैर्येणावधीरिता ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004122022, "chapter_id": 24122, "verse_number": "४-७१-२३", "content_sanskrit": "भ्रष्टराज्याश्च विबुधा महेशं शरणं गताः ।\nसर्वज्ञेन ततो देवीप्रेरिताऽसुरमर्दने ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004122023, "chapter_id": 24122, "verse_number": "४-७१-२४", "content_sanskrit": "माहेश्वरीं समासाद्य भवान्याज्ञां प्रहृष्टवत् ।\nअमर्त्यायाऽभयं दत्त्वा समरायोपचक्रमे ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004122024, "chapter_id": 24122, "verse_number": "४-७१-२५", "content_sanskrit": "कालरात्रीं समाहूय कांत्या त्रैलोक्यसुंदरीम् ।\nप्रेषयामास रुद्राणी तमाह्वातुं सुरद्रुहम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004122025, "chapter_id": 24122, "verse_number": "४-७१-२६", "content_sanskrit": "कालरात्री समासाद्य तं दैत्यं दुष्टचेष्टितम् ।\nउवाच दैत्याधिपते त्यज त्रैलोक्यसंपदम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004122026, "chapter_id": 24122, "verse_number": "४-७१-२७", "content_sanskrit": "त्रिलोकीं लभतामिंद्रस्त्वं तु याहि रसातलम् ।\nप्रवर्तंतां क्रियाः सर्वा वेदोक्ता वेदवादिनाम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004122027, "chapter_id": 24122, "verse_number": "४-७१-२८", "content_sanskrit": "अथ चेद्गर्वलेशोऽस्ति तदायाहि समाजये ।\nअथवा जीविताकांक्षी तदिंद्रं शरणं व्रज ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004122028, "chapter_id": 24122, "verse_number": "४-७१-२९", "content_sanskrit": "इति वक्तुं महादेव्या महामंगलरूपया ।\nत्वदंतिके प्रेषिताहं मृत्युस्ते तदुपेक्षया ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004122029, "chapter_id": 24122, "verse_number": "४-७१-३०", "content_sanskrit": "अतो यदुचितं कर्तुं तद्विधेहि महासुर ।\nपरं हितं चेच्छृणुयाज्जीवग्राहं ततो व्रज ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004122030, "chapter_id": 24122, "verse_number": "४-७१-३१", "content_sanskrit": "इत्याकर्ण्य वचो देव्या महाकाल्याः स दैत्यराट् ।\nप्रजज्वाल तदा क्रोधाद्गृह्यतां गृह्यतामियम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004122031, "chapter_id": 24122, "verse_number": "४-७१-३२", "content_sanskrit": "त्रैलोक्यमोहिनी ह्येषा प्राप्ता मद्भाग्यगौरवैः ।\nत्रैलोक्यराज्यसंपत्ति वल्ल्याः फलमिदं महत् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004122032, "chapter_id": 24122, "verse_number": "४-७१-३३", "content_sanskrit": "एतदर्थं हि देवर्षि नृपा बंदी कृता मया ।\nअनायासेन मे प्राप्ता गृहमेषा शुभोदयात् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004122033, "chapter_id": 24122, "verse_number": "४-७१-३४", "content_sanskrit": "अवश्यं यस्य योग्यं यत्तत्तस्येहोपतिष्ठते ।\nअरण्ये वा गृहे वापि यतो भाग्यस्य गौरवात् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004122034, "chapter_id": 24122, "verse_number": "४-७१-३५", "content_sanskrit": "अंतःपुरचरा एतां नयंत्वंतःपुरं महत् ।\nअनया सदलं कृत्या मम राष्ट्रमलंकृतम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004122035, "chapter_id": 24122, "verse_number": "४-७१-३६", "content_sanskrit": "अहो महोदयश्चाद्य जातो मम महामते ।\nकेवलं न ममैकस्य सर्वदैत्यान्वयस्य च ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004122036, "chapter_id": 24122, "verse_number": "४-७१-३७", "content_sanskrit": "नृत्यंतु पितरश्चाद्य मोदंतां बांधवाः सुखम् ।\nमृत्युः कालोंऽतको देवाः प्राप्नुवंत्वद्य मे भयम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004122037, "chapter_id": 24122, "verse_number": "४-७१-३८", "content_sanskrit": "इति यावत्समायातास्तां नेतुं सौविदल्लकाः ।\nतावत्तया कालरात्र्या प्रत्युक्तो दैत्यपुंगवः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004122038, "chapter_id": 24122, "verse_number": "४-७१-३९", "content_sanskrit": "कालरात्र्युवाच ।\nदैत्यराज महाप्राज्ञ नैतद्युक्तं भवादृशाम् ।\nवयं दूत्यः परवशा राजनीतिविदुत्तम ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004122039, "chapter_id": 24122, "verse_number": "४-७१-४०", "content_sanskrit": "अल्पोपि दूतसंबाधां न विदध्यात्कदाचन ।\nकिं पुनर्ये भवादृक्षा महांतो बलिनोऽधिपाः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004122040, "chapter_id": 24122, "verse_number": "४-७१-४१", "content_sanskrit": "दूतीषु कोनुरागोयं महाराजाल्पिकास्विह ।\nअनायासेन च वयमायास्यामस्तदागमात् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004122041, "chapter_id": 24122, "verse_number": "४-७१-४२", "content_sanskrit": "विजित्य समरे तां तु स्वामिनीं मम दैत्यप ।\nमादृशीनां सहस्रणि परिभुंक्ष्व यथेच्छया ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004122042, "chapter_id": 24122, "verse_number": "४-७१-४३", "content_sanskrit": "अद्यैव ते महासौख्यं भावितस्याविलोकनात् ।\nबांधवानां सुखं तेद्य भविता सह पूर्वजैः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004122043, "chapter_id": 24122, "verse_number": "४-७१-४४", "content_sanskrit": "संपत्स्यंतेऽद्य ते कामाः सर्वे ये चिरचिंतिताः ।\nअबला सा च मुग्धा च तस्यास्त्राता न कश्चन ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004122044, "chapter_id": 24122, "verse_number": "४-७१-४५", "content_sanskrit": "सर्वरूपमयी चैव तां भवान्द्रष्टुमर्हति ।\nअहं हि दर्शयिष्यामि यत्र साऽस्ति जगत्खनिः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004122045, "chapter_id": 24122, "verse_number": "४-७१-४६", "content_sanskrit": "धृतायामपि चैकस्यां कस्ते कामो भविष्यति ।\nअहं ते सन्निधिं नैव त्यक्ष्याम्यद्य दिनावधि ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004122046, "chapter_id": 24122, "verse_number": "४-७१-४७", "content_sanskrit": "ततो निवारयैतान्मामादित्सून्सौविदल्लकान् ।\nइति श्रुत्वा वचस्तस्याः स कामक्रोधमोहितः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004122047, "chapter_id": 24122, "verse_number": "४-७१-४८", "content_sanskrit": "तामेव बह्वमंस्तैकां दूतीं मृत्योरिवासुरः ।\nशुद्धांतरक्षिणश्चैतां शुद्धां तं प्रापयंत्वरम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004122048, "chapter_id": 24122, "verse_number": "४-७१-४९", "content_sanskrit": "इति तेन समादिष्टाः सर्वे वर्पवरा मुने ।\nतां धर्तुमुद्यमं चक्रुर्बलेन बलवत्तराः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004122049, "chapter_id": 24122, "verse_number": "४-७१-५०", "content_sanskrit": "सा तान्भस्मीचकाराशु हुंकारजनिताग्निना ।\nततो दैत्यपतिः क्रुद्धो दृष्ट्वा तान्भस्मसात्कृतान् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004122050, "chapter_id": 24122, "verse_number": "४-७१-५१", "content_sanskrit": "क्षणेनैव तया दूत्या दैत्त्यास्त्र्ययुतसंमितान् ।\nदृशा व्यापारयामास दुर्धरं दुर्मुखं खरम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004122051, "chapter_id": 24122, "verse_number": "४-७१-५२", "content_sanskrit": "सीरपाणिं पाशपाणिं सुरेंद्रदमनं हनुम् ।\nयज्ञारिं खङ्गलोमानमुग्रास्यं देवकंपनम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004122052, "chapter_id": 24122, "verse_number": "४-७१-५३", "content_sanskrit": "बद्ध्वा पाशैरिमां दुष्टामानयंत्वाशु दानवाः ।\nविध्वस्तकेशवेशां च विस्त्रस्तांबरभूषणाम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004122053, "chapter_id": 24122, "verse_number": "४-७१-५४", "content_sanskrit": "इति दैत्याधिपादेशाद्दुर्धरप्रमुखास्ततः ।\nपाशासिमुद्गरधरास्तामादातुं कृतोद्यमाः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004122054, "chapter_id": 24122, "verse_number": "४-७१-५५", "content_sanskrit": "गिरींद्रगुरुवर्ष्माणः शस्त्रास्त्रोद्यतपाणयः ।\nदिगंतं ते परिप्राप्तास्तदुच्छ्वासानिलाहताः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004122055, "chapter_id": 24122, "verse_number": "४-७१-५६", "content_sanskrit": "तेषूड्डीनेषु दैत्येषु शतकोटिमितेषु च ।\nनिर्जगाम ततः सा तु कालरात्रिर्नभोध्वगा ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004122056, "chapter_id": 24122, "verse_number": "४-७१-५७", "content_sanskrit": "ततस्तां तु विनिर्यांतीमनुजग्मुर्महासुराः ।\nकोटिकोटिसहस्राणि पूरयित्वा तु रोदसी ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004122057, "chapter_id": 24122, "verse_number": "४-७१-५८", "content_sanskrit": "दुर्गोनाम महादैत्यः शतकोटि रथावृतः ।\nगजानामर्बुदशतद्वयेनपारिवारितः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004122058, "chapter_id": 24122, "verse_number": "४-७१-५९", "content_sanskrit": "कोट्यर्बुदेन सहितो हयानां वातरंहसाम् ।\nपदातिभिरसंख्यातैः पच्चूर्णितशिलोच्चयैः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004122059, "chapter_id": 24122, "verse_number": "४-७१-६०", "content_sanskrit": "उदायुधैर्महाभीमैःकृतत्रिजगतीभयैः ।\nसमेतः स महादैत्यो दुर्गः क्रुद्धो विनिर्ययौ ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004122060, "chapter_id": 24122, "verse_number": "४-७१-६१", "content_sanskrit": "अथ दृष्ट्वा महादेवी विंध्याचलकृतालयाम् ।\nआगत्य कालरात्र्यां च निवेदित तदागसम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004122061, "chapter_id": 24122, "verse_number": "४-७१-६२", "content_sanskrit": "महाभुजसहस्राढयां महातेजोभिबृंहिताम् ।\nतत्तद्घोरप्रहरणां रणकौतुकसादराम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004122062, "chapter_id": 24122, "verse_number": "४-७१-६३", "content_sanskrit": "प्रौद्यच्चंद्रसहस्रांशु निर्मार्जित शुभाननाम् ।\nलावण्यवार्धि निर्गच्छच्चंचच्चंद्रैकचंद्रिकाम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004122063, "chapter_id": 24122, "verse_number": "४-७१-६४", "content_sanskrit": "महामाणिक्यनिचय रोचिःखचितविग्रहाम् ।\nत्रैलोक्यरम्यनगरी सुप्रकाशप्रदीपिकाम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004122064, "chapter_id": 24122, "verse_number": "४-७१-६५", "content_sanskrit": "हरनेत्राग्निनिर्दग्ध कामजीवातुवीरुधम् ।\nलसत्सौंदर्यसंभार जगन्मोहमहौषधिम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004122065, "chapter_id": 24122, "verse_number": "४-७१-६६", "content_sanskrit": "विषमेषु शरैर्भिन्नहृदयो दैत्यपुंगवः ।\nआदिष्टवान्महासैन्यनायकानुप्रशासनः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004122066, "chapter_id": 24122, "verse_number": "४-७१-६७", "content_sanskrit": "अयि जंभ महाजंभ कुजंभ विकटानन ।\nलंबोदर महाकाय महादंष्ट्र महाहनो ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004122067, "chapter_id": 24122, "verse_number": "४-७१-६८", "content_sanskrit": "पिंगाक्ष महिषग्रीव महोग्रात्युग्रविग्रह ।\nक्रूराक्ष क्रोधनाक्रंद संक्रंदन महाभय ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004122068, "chapter_id": 24122, "verse_number": "४-७१-६९", "content_sanskrit": "जितांतक महाबाहो महावक्त्र महीधर ।\nदुंदुभे दुंदुभिरव महादुंदुभिनासिक ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004122069, "chapter_id": 24122, "verse_number": "४-७१-७०", "content_sanskrit": "उग्रास्य दीर्घदशनमेवकेश वृकानन ।\nसिंहास्य सूकरमुख शिवाराव महोत्कट ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004122070, "chapter_id": 24122, "verse_number": "४-७१-७१", "content_sanskrit": "शुकतुंड प्रचंडास्य भीमाक्ष क्षुदमानस ।\nउलूकनेत्र कंकास्य काकतुंड करालवाक् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004122071, "chapter_id": 24122, "verse_number": "४-७१-७२", "content_sanskrit": "दीर्घग्रीव महाजंघ क्रमेलक शिरोधर ।\nरक्तबिंदो जपानेत्र विद्युज्जिह्वाग्नितापन ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004122072, "chapter_id": 24122, "verse_number": "४-७१-७३", "content_sanskrit": "धूम्राक्ष धूमनिःश्वास चंडचंडांशुतापन ।\nमहाभीषणमुख्याश्च शृण्वंत्वाज्ञां ममादरात् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004122073, "chapter_id": 24122, "verse_number": "४-७१-७४", "content_sanskrit": "भवत्स्वेतेषु चान्येषु एतां विंध्यवासिनीम् ।\nधृत्यानेष्यति बुद्ध्या वा बलेनापि च्छलेन वा ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004122074, "chapter_id": 24122, "verse_number": "४-७१-७५", "content_sanskrit": "तस्याहमिंद्रपदवीमद्य दास्याम्यसंशयम् ।\nदृष्ट्वैतां सुंदरीमद्य मनो मे व्याकुलं भवेत् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004122075, "chapter_id": 24122, "verse_number": "४-७१-७६", "content_sanskrit": "यांतु क्षिप्रं नयावन्मे पंचेषु शरपीडितम् ।\nमनोविह्वलतां गच्छेदेतत्प्राप्तेरभावतः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004122076, "chapter_id": 24122, "verse_number": "४-७१-७७", "content_sanskrit": "इत्याकर्ण्य वचस्तस्य दुर्गस्य दनुजेशितुः ।\nप्रोचुः सर्वे तदा दैत्याः प्रबद्धकरसंपुटाः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004122077, "chapter_id": 24122, "verse_number": "४-७१-७८", "content_sanskrit": "अवधेहि महाराज किमेतत्कर्मदुष्करम् ।\nअनाथायास्तथैकस्या अबलया विशेषतः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004122078, "chapter_id": 24122, "verse_number": "४-७१-७९", "content_sanskrit": "अस्या आनयने कोयं महायत्नविधिः प्रभो ।\nकोऽस्मान्प्रलयकालाग्निमहाज्वालावलीसमान् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004122079, "chapter_id": 24122, "verse_number": "४-७१-८०", "content_sanskrit": "सहेत त्रिषु लोकेषु त्वत्प्रसादात्कृतोद्यमान् ।\nयद्यादेशो भवेदद्य तदेंद्रं स मरुद्गणम् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004122080, "chapter_id": 24122, "verse_number": "४-७१-८१", "content_sanskrit": "सांतःपुरं समानीय क्षिप्नुमस्त्वत्पदाग्रतः ।\nभूर्भुवःस्वरिदं सर्वं त्वदाज्ञावशवर्तितम् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004122081, "chapter_id": 24122, "verse_number": "४-७१-८२", "content_sanskrit": "महर्जनस्तपःसत्यलोकास्त्वदधिकारिणः ।\nतत्राप्यसाध्यं नास्माकं त्वन्निदेशान्महासुर ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7004122082, "chapter_id": 24122, "verse_number": "४-७१-८३", "content_sanskrit": "वैकुंठनायको नित्यं त्वदाज्ञापरिपालकः ।\nयानि रम्याणि रत्नानि तानि संप्रेषयन्मुदा ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7004122083, "chapter_id": 24122, "verse_number": "४-७१-८४", "content_sanskrit": "अस्माभिरेव संत्यक्तः कैलासाधिपतिः स वै ।\nविपाशी चातिनिःस्वत्वाद्भस्मकृत्त्यहिभूषणः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7004122084, "chapter_id": 24122, "verse_number": "४-७१-८५", "content_sanskrit": "अर्धांगेनास्मद्भयतो योषिदेका निगूहिता ।\nतस्य ग्रामेपि सकले द्वितीयो न चतुष्पदः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7004122085, "chapter_id": 24122, "verse_number": "४-७१-८६", "content_sanskrit": "एकोऽजरद्गवः सोपि नान्यस्मात्परिजीवति ।\nश्मशानवासिनः सर्वे सर्वे कौपीनवाससः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7004122086, "chapter_id": 24122, "verse_number": "४-७१-८७", "content_sanskrit": "सर्वे विभूतिधवला सर्वेप्येक कपर्द्दिनः ।\nसमस्ते नगरे तस्य वसंत्येवंविधा गणाः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7004122087, "chapter_id": 24122, "verse_number": "४-७१-८८", "content_sanskrit": "तेषां गणानां किं कुर्मो दरिद्राणां वयं विभो ।\nसमुद्रा रत्नसंभारं प्रत्यहं प्रेषयंति च ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7004122088, "chapter_id": 24122, "verse_number": "४-७१-८९", "content_sanskrit": "नागा वराकाश्चास्माकं सायंसायं स्वयं प्रभो ।\nप्रदीपयंति सततं फणा रत्नप्रदीपकान् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7004122089, "chapter_id": 24122, "verse_number": "४-७१-९०", "content_sanskrit": "कल्पद्रुमः कामगवी चिंतामणिगणा बहु ।\nतव प्रसादादस्माकमपि तिष्ठंति वेश्मसु ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7004122090, "chapter_id": 24122, "verse_number": "४-७१-९१", "content_sanskrit": "वायुर्व्यजनतां यातस्त्वां सेवेत प्रयत्नतः ।\nस्वच्छान्यंबूनि वरुणः प्रत्यहं पूरयत्यहो ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7004122091, "chapter_id": 24122, "verse_number": "४-७१-९२", "content_sanskrit": "वासांसि क्षालयेदग्निश्चंद्रश्छत्रधरः स्वयम् ।\nसूर्यः प्रकाशयेन्नित्यं क्रीडावाप्यंबुजानि च ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7004122092, "chapter_id": 24122, "verse_number": "४-७१-९३", "content_sanskrit": "कस्त्वत्प्रसादं नेक्षेत मर्त्यामर्त्योरगेषु च ।\nसर्वे त्वामुपजीवंति सुराऽसुरखगादयः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7004122093, "chapter_id": 24122, "verse_number": "४-७१-९४", "content_sanskrit": "पश्य नः पौरुषं राजन्नानयामो बलादिमाम् ।\nइत्युक्त्वा युगपत्सर्वे क्षुब्धास्तोयधयो यथा ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7004122094, "chapter_id": 24122, "verse_number": "४-७१-९५", "content_sanskrit": "संवर्तकालमासाद्य प्लावितुं जगतीमिमाम् ।\nरणतूर्य निनादश्च समुत्तस्थौ समंततः ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7004122095, "chapter_id": 24122, "verse_number": "४-७१-९६", "content_sanskrit": "रोमांचिता यच्छ्रवणात्कातरा अप्यकातराः ।\nततो देवा भयत्रस्ताश्चकंपे च वसुंधरा ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7004122096, "chapter_id": 24122, "verse_number": "४-७१-९७", "content_sanskrit": "क्षुब्धा अंबुधयः सर्वे पेतुर्नक्षत्रमालिकाः ।\nरोदसीमंडलं व्याप्तं तेन तूर्यरवेण वै ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7004122097, "chapter_id": 24122, "verse_number": "४-७१-९८", "content_sanskrit": "ततो भगवती देवी स्वशरीरसमुद्भवाः ।\nशक्तीरुत्पादयामास शतशोऽथ सहस्रशः ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7004122098, "chapter_id": 24122, "verse_number": "४-७१-९९", "content_sanskrit": "ताभिः शक्तिभिरेतेषां बलिनां दितिजन्मनाम् ।\nप्रत्येकं परितो रुद्ध उद्वेलः सैन्यसागरः ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7004122099, "chapter_id": 24122, "verse_number": "४-७१-१००", "content_sanskrit": "शस्त्रास्त्राणि महादैत्यैर्यान्युत्सृष्टानि संगरे ।\nताभिः शक्तिभिरुग्राणि तृणीकृत्योज्झितान्यरम् ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7004122100, "chapter_id": 24122, "verse_number": "४-७१-१०१", "content_sanskrit": "ततोतिकोपपूर्णास्ते जंभमुख्याः सुरारयः ।\nअसि चक्र भुशुंडीभिर्गदामुद्गरतोमरैः ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7004122101, "chapter_id": 24122, "verse_number": "४-७१-१०२", "content_sanskrit": "भिंदिपालैश्च परिघैः कुंतैः शल्यैश्च शक्तिभिः ।\nअर्धचंद्रैः क्षुरप्रैश्च नाराचैश्च शिलीमुखैः ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7004122102, "chapter_id": 24122, "verse_number": "४-७१-१०३", "content_sanskrit": "महाभल्लैः परशुभिर्भिंदुरैर्मर्मभेदिभिः ।\nवृक्षोपलमहावर्षैर्ववृषुर्जलदा इव ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7004122103, "chapter_id": 24122, "verse_number": "४-७१-१०४", "content_sanskrit": "अथ सा विंध्यनिलया महामाया महेश्वरी ।\nआदायोद्दंडकोदंडं वायव्यास्त्रेण हेलया ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7004122104, "chapter_id": 24122, "verse_number": "४-७१-१०५", "content_sanskrit": "दैत्यास्त्रशस्त्रजालानि परिचिक्षेप दूरतः ।\nततो महासुरो दुर्गो वीक्ष्य सैन्यं निरायुधम् ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7004122105, "chapter_id": 24122, "verse_number": "४-७१-१०६", "content_sanskrit": "ज्वलंतीं शक्तिमादाय तां देवीं प्रति सोऽक्षिपत् ।\nतां तु शक्तिं समायांतीं महावेगवतीं रणे ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7004122106, "chapter_id": 24122, "verse_number": "४-७१-१०७", "content_sanskrit": "निजचापविनिर्मुक्तैर्बाणैश्चूर्णी चकार सा ।\nभग्नां शक्तिं समालोक्य ततो दुर्गो महासुरः ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7004122107, "chapter_id": 24122, "verse_number": "४-७१-१०८", "content_sanskrit": "चक्रं च प्रेषयामास दैत्यचक्रातिहर्षदम् ।\nतच्च देव्या शरशतैरंतरैवाणुवत्कृतम् ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7004122108, "chapter_id": 24122, "verse_number": "४-७१-१०९", "content_sanskrit": "ततः शार्ङ्गं समादाय धनुः शक्रधनुर्यथा ।\nहृदि विव्याध बाणेन तां देवीममरार्दनः ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7004122109, "chapter_id": 24122, "verse_number": "४-७१-११०", "content_sanskrit": "स च बाणस्तया देव्या निज बाणैर्महाजवैः ।\nनिवारितोपि वेगेन तां देवीमभ्यगान्मुने ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7004122110, "chapter_id": 24122, "verse_number": "४-७१-१११", "content_sanskrit": "ततः कोदंडदंडेन आषुगेन तमाशुगम् ।\nहत्वा निवारयामास कालदंडमिवापरम् ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7004122111, "chapter_id": 24122, "verse_number": "४-७१-११२", "content_sanskrit": "तस्मिन्विमुखतां याते मार्गणे दुर्गमासुरः ।\nक्रुद्धः शूलं समादाय संवर्तानलसुप्रभम् ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7004122112, "chapter_id": 24122, "verse_number": "४-७१-११३", "content_sanskrit": "महावेगन चिक्षेप तां देवीमभि दैत्यपः ।\nपरापतच्च तच्छूलं निजशूलेन चंडिका ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7004122113, "chapter_id": 24122, "verse_number": "४-७१-११४", "content_sanskrit": "अंतरैव प्रचिच्छेद सह दैत्यजयाशया ।\nतस्मिन्नपि महाशूले देवीशूलावहेलिते ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7004122114, "chapter_id": 24122, "verse_number": "४-७१-११५", "content_sanskrit": "गदामादाय दैत्येंद्रः सहसाभिपपात ह ।\nआजघान च तं देवीं भुजमूले महाबलः ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7004122115, "chapter_id": 24122, "verse_number": "४-७१-११६", "content_sanskrit": "सापि देवी भुजं प्राप्य गिरींद्रशिखराकृतिः ।\nगदाशुपरिपुस्फोट शतधा च सहस्रधा ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7004122116, "chapter_id": 24122, "verse_number": "४-७१-११७", "content_sanskrit": "तदा देव्या स दैत्येंद्रो वामपादतलेन हि ।\nआताडितः पपातोर्व्यां हृदि गाढं प्रपीडितः ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7004122117, "chapter_id": 24122, "verse_number": "४-७१-११८", "content_sanskrit": "तत्क्षणादेव दैत्येंद्रः पतित्वा पुनरुत्थितः ।\nबभूव सहसा दृश्यो दीपो वातहतो यथा ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7004122118, "chapter_id": 24122, "verse_number": "४-७१-११९", "content_sanskrit": "तावञ्जगज्जनन्याताः प्रेरिता निज शक्तयः ।\nविचेरुर्दैत्यसैन्येषु संवर्ते मृत्युसैन्यवत् ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7004122119, "chapter_id": 24122, "verse_number": "४-७१-१२०", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीति साहस्र्यां संहितायां चतुर्थे काशीखंड उत्तरार्धे दुर्गपराक्रमो नामैकसप्ततितमोऽध्यायः ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}]