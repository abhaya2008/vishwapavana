[{"id": 900001131, "chapter_id": 8216, "verse_number": "5.1", "content_sanskrit": "अथ हैनं सौर्यायणी गार्ग्यः पप्रच्छ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900001132, "chapter_id": 8216, "verse_number": "5.2", "content_sanskrit": "तस्मै स होवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900001133, "chapter_id": 8216, "verse_number": "5.3", "content_sanskrit": "प्राणाग्नय एवैतस्मिन् पुरे जाग्रति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900001134, "chapter_id": 8216, "verse_number": "5.4", "content_sanskrit": "अत्रैष देवः स्वप्ने महिमानमनुभवति ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900001135, "chapter_id": 8216, "verse_number": "5.5", "content_sanskrit": "स यथा सोम्य वयांसि वासोवृक्षं सम्प्रतिष्ठन्ते ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900001136, "chapter_id": 8216, "verse_number": "5.6", "content_sanskrit": "एष हि द्रष्टा स्प्रष्टा श्रोता घ्राता ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}]