[{"id": 2045519, "chapter_id": 2012, "verse_number": "६-६१-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2045520, "chapter_id": 2012, "verse_number": "६-६१-१", "content_sanskrit": "द्रौणिर्भूरिश्रवाः शत्यश्चित्रसेनश्च मारिषः।\nपुत्रः सांयमनेश्चैव सौभद्रं पर्यवारयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2045521, "chapter_id": 2012, "verse_number": "६-६१-२", "content_sanskrit": "संसक्तमतितेजोभिस्तमेकं ददृशुर्जनाः।\nपञ्चभिर्मनुजव्याघ्रैर्गजैः सिंहशिशुं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2045522, "chapter_id": 2012, "verse_number": "६-६१-३", "content_sanskrit": "नातिलक्ष्यतया कश्चिन्न शौर्ये न पराक्रमे ।\nबभूव सदृशः कार्ष्णेर्नास्त्रे नापि च लाघवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2045523, "chapter_id": 2012, "verse_number": "६-६१-४", "content_sanskrit": "तथा तमात्मजं युद्धे विक्रमन्तमरिन्दमम्।\nदृष्ट्वा पार्थः सुसंयत्तं सिंहनादमथानदत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2045524, "chapter_id": 2012, "verse_number": "६-६१-५", "content_sanskrit": "पीडयानं तु तत्सैन्यं पौत्रं तव विशांपते।\nदृष्ट्वा त्वदीया राजेन्द्र समन्तात्पर्यवारयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2045525, "chapter_id": 2012, "verse_number": "६-६१-६", "content_sanskrit": "ध्वजिनीं धार्तराष्ट्राणां दीनशत्रुरदीनवत् ।\nप्रत्युद्ययौ स सौभद्रस्तेजसा च बलेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2045526, "chapter_id": 2012, "verse_number": "६-६१-७", "content_sanskrit": "तस्य लाघवमार्गस्थमादित्यसदृशप्रभम् ।\nव्यदृश्यत महच्चापं समरे युध्यतः परैः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2045527, "chapter_id": 2012, "verse_number": "६-६१-८", "content_sanskrit": "स द्रौणिमिषुणैकेन विद्ध्वा शल्यं च पञ्चभिः ।\nध्वजं सांयमनेश्वैव सोऽष्टाभिश्चिच्छिदे ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2045528, "chapter_id": 2012, "verse_number": "६-६१-९", "content_sanskrit": "रुक्मदण्डां महाशक्तिं प्रेषितां सौमदत्तिन ।\nशितेनोरगसंकाशां पत्रिणाभिजघान ताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2045529, "chapter_id": 2012, "verse_number": "६-६१-१०", "content_sanskrit": "शल्यस्य च महावेगानस्यतः समरे शरान्।\n`धनुश्चिच्छेद भल्लेन तीव्रवेगन फाल्गुनिः\nजघानार्जुनदायादश्चतुर्भिश्चतुरो हयान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2045530, "chapter_id": 2012, "verse_number": "६-६१-११", "content_sanskrit": "भूरिश्रवाश्च शल्यश्च द्रौणिः सांयमनिः शलः।\nनाभ्यवर्तन्तं संरब्धाः कार्ष्णेर्बाहुबलोदयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2045531, "chapter_id": 2012, "verse_number": "६-६१-१२", "content_sanskrit": "ततस्त्रिगर्ता राजेन्द्र मद्राश्च सह केकयैः ।\nपञ्चविंशतिसाहस्रास्तव पुत्रेण चोदिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2045532, "chapter_id": 2012, "verse_number": "६-६१-१३", "content_sanskrit": "धनुर्वेदविदो मुख्या अजेयाः शत्रुभिर्युधि।\nसह पुत्रं जिघांसन्तं परिवव्रुः किरीटिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2045533, "chapter_id": 2012, "verse_number": "६-६१-१४", "content_sanskrit": "तौ तु तत्र पितापुत्रौ परिक्षिप्तौ महारथौ ।\nददर्श राजन्पाञ्चल्यः सेनापतिररिन्दम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2045534, "chapter_id": 2012, "verse_number": "६-६१-१५", "content_sanskrit": "स वारणरथोघानां सहस्रैर्बहुभिर्वृतः।\nवाजिभिः पत्तिभिश्चैव वृतः शतसहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2045535, "chapter_id": 2012, "verse_number": "६-६१-१६", "content_sanskrit": "`पारावताश्वः स रथमास्थाय परवीरहा\nधनुर्विष्फार्य संक्रुद्धो नोदयित्वा च वाहिनीम् ।\nययौ तं मद्रकानीकं केकयांश्च परंतप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2045536, "chapter_id": 2012, "verse_number": "६-६१-१७", "content_sanskrit": "तेन कीर्तिमता गुप्तमनीकं दृढधन्वना।\nसंरब्धरथनागाश्वं योत्स्यमानमशोभत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2045537, "chapter_id": 2012, "verse_number": "६-६१-१८", "content_sanskrit": "सोऽर्जुनप्रमुखे यान्तं पाञ्चालकुलवर्धनः ।\nत्रिभिः शारद्वतं बाणैर्जत्रदेशे समार्पयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2045538, "chapter_id": 2012, "verse_number": "६-६१-१९", "content_sanskrit": "ततः स मद्रकान्हत्वा दशैव दशभिः शरैः ।\nपृष्ठरक्षं जघानाशु भल्लेन कृतवर्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2045539, "chapter_id": 2012, "verse_number": "६-६१-२०", "content_sanskrit": "दमनं चापि दायादं पौरवस्य महात्मनः ।\nजघान विमलाग्नेण नाराचेन परंतपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2045540, "chapter_id": 2012, "verse_number": "६-६१-२१", "content_sanskrit": "ततः सांयमनेः पुत्रः पाञ्चाल्यं युद्धदुर्मदम् ।\nअविध्यत्रिंशता बाणैर्दशभिश्चास्य सारथिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2045541, "chapter_id": 2012, "verse_number": "६-६१-२२", "content_sanskrit": "सोऽतिविद्धो महेष्वासः सृक्किणी परिसंलिहन्।\nभल्लेन भृशतीक्ष्णेन निचकर्तास्य कार्मुकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2045542, "chapter_id": 2012, "verse_number": "६-६१-२३", "content_sanskrit": "अथैनं पञ्चविंशत्या क्षिप्रमेव समार्पयत् ।\nअश्वांश्चास्यावधीद्राजन्नुभौ तौ पार्ष्णिसारथी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2045543, "chapter_id": 2012, "verse_number": "६-६१-२४", "content_sanskrit": "स हताश्वे रते तिष्ठन्ददर्श भरतर्षभ ।\nपुत्रः सांयमनेः पुत्रं पाञ्चाल्यस्य महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2045544, "chapter_id": 2012, "verse_number": "६-६१-२५", "content_sanskrit": "स प्रगृह्य महाघोरं निस्त्रिंशवरमायसम् ।\nपदातिस्तूर्णमानर्च्छद्रथस्यं पुरुषर्षभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2045545, "chapter_id": 2012, "verse_number": "६-६१-२६", "content_sanskrit": "तं महौघमिवायान्तं स्वात्पतन्तमिवोरगम् ।\nभ्रान्तावरणनिस्त्रिंशं कालोत्सृष्टमिवान्तकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2045546, "chapter_id": 2012, "verse_number": "६-६१-२७", "content_sanskrit": "दीप्यमानमिवादित्यं मत्तवारणविक्रमम् ।\nअपश्यन्पाण्डवास्तत्र धृष्टद्युम्नश्च पार्षतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2045547, "chapter_id": 2012, "verse_number": "६-६१-२८", "content_sanskrit": "तस्य पाञ्चालदायादः प्रतीपमभिधावतः।\nशितनिस्त्रिंशहस्तस्य शरावरणधारिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2045548, "chapter_id": 2012, "verse_number": "६-६१-२९", "content_sanskrit": "बाणवेगमतीतस्य तथाभ्याशमुपेयुषः ।\nत्वरन्सेनापतिः क्रुद्धो बिभेद गदया शिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2045549, "chapter_id": 2012, "verse_number": "६-६१-३०", "content_sanskrit": "तस्य राजन्सनिस्त्रिंशं सुप्रभं च शरावरम् ।\nहतस्य पततो हस्ताद्वेगेन न्यपतद्भुवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2045550, "chapter_id": 2012, "verse_number": "६-६१-३१", "content_sanskrit": "तं निहत्य गदाग्रेण स लेभे परमां मुदम्।\nपुत्रः पाञ्चालराजस्य महात्मा भीमविक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2045551, "chapter_id": 2012, "verse_number": "६-६१-३२", "content_sanskrit": "तस्मिन्हते महेष्वासे शल्यपुत्रे महारथे ।\nहाहाकारो महानासीत्तव सैन्यस्य मारिष ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2045552, "chapter_id": 2012, "verse_number": "६-६१-३३", "content_sanskrit": "ततः सांयमनिः क्रुद्धो दृष्ट्वा निहतामात्मजम् ।\nअभिदुद्राव वेगेन पाञ्चाल्यं युद्धदुर्मदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2045553, "chapter_id": 2012, "verse_number": "६-६१-३४", "content_sanskrit": "तौ तत्र समरे शूरौ समेतौ युद्धदुर्मदौ ।\nददृशुः सर्वराजानः कुरवः पाण्डवास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2045554, "chapter_id": 2012, "verse_number": "६-६१-३५", "content_sanskrit": "ततः सांयमनिः क्रुद्धः पार्षतं परवीरहा।\nआजघान त्रिभिर्बाणैस्तोत्रैरिव महाद्विपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2045555, "chapter_id": 2012, "verse_number": "६-६१-३६", "content_sanskrit": "तथैव पार्षतं शूरं शल्यः समितिशोभनः।\nआजघानोरसि क्रुद्धस्ततो युद्धमवर्तत ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2045556, "chapter_id": 2012, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भीष्मवधपर्वणि चतुर्थदिवसयुद्धे एकषष्टितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]