[{"id": 7002399000, "chapter_id": 22399, "verse_number": "१-६१-१", "content_sanskrit": "सुमन्तुरुवाच ।\nतमेकमक्षरं धाम परं सदसतोर्महत् ।\nभेदाभेदस्वरूपस्थं प्रणिपत्य रविं नृप ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002399001, "chapter_id": 22399, "verse_number": "१-६१-२", "content_sanskrit": "प्रवक्ष्यामि यथापूर्वं विरिञ्चेन महात्मना ।\nऋषीणां कथितं पूर्वं तं निबोध नराधिप ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002399002, "chapter_id": 22399, "verse_number": "१-६१-३", "content_sanskrit": "आराधनाय सवितुर्महात्मा पद्मसंभवः ।\nयोगं ब्रह्मपरं प्राह महर्षीणां यथा प्रभुः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002399003, "chapter_id": 22399, "verse_number": "१-६१-४", "content_sanskrit": "समस्तवृत्तिसंरोधात्कैवल्यप्रतिपादकम् ।\nतदा जगत्पतिर्ब्रह्मा प्रणिपत्य महर्षिभिः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002399004, "chapter_id": 22399, "verse_number": "१-६१-५", "content_sanskrit": "सर्वैः किलोक्तो भगवानात्मयोनिः प्रजाहितम् ।\nयोयं योगो भगवता प्रोक्तो वृत्तिनिरोधजः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002399005, "chapter_id": 22399, "verse_number": "१-६१-६", "content_sanskrit": "प्राप्तुं शक्यः स त्वनेकैर्जन्मभिर्जगतः पते ।\nविषया दुर्जया नॄणामिन्द्रियाकर्षिणः प्रभो ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002399006, "chapter_id": 22399, "verse_number": "१-६१-७", "content_sanskrit": "वृत्तयश्चेतसश्चापि चञ्चलस्यापि दुर्धरा ।\nरागादयः कथं जेतुं शक्या वर्षशतैरपि ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002399007, "chapter_id": 22399, "verse_number": "१-६१-८", "content_sanskrit": "न योगयोग्यं भवति मन एभिरनिर्जितैः ।\nअल्पायुषश्च पुरुषा ब्रह्मन्कृतयुगेप्यमी ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002399008, "chapter_id": 22399, "verse_number": "१-६१-९", "content_sanskrit": "त्रेतायां द्वापरे चैव किमु प्राप्ते कलौ युगे ।\nभगवंस्त्वामुपासीनान्प्रसन्नो वक्तुमर्हसि ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002399009, "chapter_id": 22399, "verse_number": "१-६१-१०", "content_sanskrit": "अनायासेन येनैव उत्तरेम भवार्णवम् ।\nदुःखाम्बुमग्नाः पुरुषाः प्राप्य ब्रह्मन्महाप्लवम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002399010, "chapter_id": 22399, "verse_number": "१-६१-११", "content_sanskrit": "उत्तरेम भवाम्भोधिं तथा त्वमनुचिंतय ।\nएवमुक्तस्तदा ब्रह्माक्रियायोगं महात्मनाम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002399011, "chapter_id": 22399, "verse_number": "१-६१-१२", "content_sanskrit": "तेषामृषीणामाचष्ट नराणां हितकाम्यया ।\nआराधयत विश्वेशं दिवाकरमतन्द्रिताः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002399012, "chapter_id": 22399, "verse_number": "१-६१-१३", "content_sanskrit": "बाह्यालम्बनसापेक्षास्तमजं जगतः पतिम् ।\nइज्यापूजानमस्कारशुश्रूषाभिरहर्निशम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002399013, "chapter_id": 22399, "verse_number": "१-६१-१४", "content_sanskrit": "व्रतोपवासैर्विविधैर्ब्राह्मणानां च तर्पणं ।\nतैस्तैश्चाभिमतैः कामैर्ये च चेतसि तुष्टिदाः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002399014, "chapter_id": 22399, "verse_number": "१-६१-१५", "content_sanskrit": "अपरिच्छेद्यमाहात्म्यमाराधयत भास्करम् ।\nतन्निष्ठास्तद्गतधियस्तत्कर्माणस्तदाश्रयाः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002399015, "chapter_id": 22399, "verse_number": "१-६१-१६", "content_sanskrit": "तद्दृष्टयस्तन्मनसः सर्वस्मिन्त्स१ इति स्थिताः ।\nसमस्तान्यथ कर्माणि तत्र सर्वात्मनात्मनि ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002399016, "chapter_id": 22399, "verse_number": "१-६१-१७", "content_sanskrit": "संन्यसध्वं स वः कर्त्ता समस्तावरणक्षयम् ।\nएतत्तदक्षरं ब्रह्म प्रधानपुरुषावुभौ ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002399017, "chapter_id": 22399, "verse_number": "१-६१-१८", "content_sanskrit": "२ यतो यस्मिन्यथा चोभौ सर्वय्यापिन्यवस्थितौ ।\nपरः पराणां परमः सैकः सुमनसां परः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002399018, "chapter_id": 22399, "verse_number": "१-६१-१९", "content_sanskrit": "यस्माद्भिन्नमिदं सर्वं यच्चेदं यच्च नेङ्गति ।\nमोक्षकारणमव्यक्तमचिन्त्यमपरिग्रहम् ।\nसमाराध्य जगन्नाथं क्रियायोगेन मुच्यते ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002399019, "chapter_id": 22399, "verse_number": "१-६१-२०", "content_sanskrit": "इति ते ब्रह्मणः श्रुत्वा रहस्यमृषिसत्तमाः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002399020, "chapter_id": 22399, "verse_number": "१-६१-२१", "content_sanskrit": "नराणामुपकाराय योगशास्त्राणि चक्रिरे ।\nक्रियायोगपराणीह मुक्तिकारीण्यनेकशः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002399021, "chapter_id": 22399, "verse_number": "१-६१-२२", "content_sanskrit": "आराध्यते जगन्नाथस्तदनुष्ठानतत्परैः ।\nपरमात्मा स मार्तण्डः सर्वेशः सर्वभावनः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002399022, "chapter_id": 22399, "verse_number": "१-६१-२३", "content_sanskrit": "यान्युक्तानि पुरा तेन ब्रह्मणा कुरुनन्दन ।\nतानि ते कुरुशार्दूल सर्वपापहराण्यहम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002399023, "chapter_id": 22399, "verse_number": "१-६१-२४", "content_sanskrit": "वक्ष्यामि श्रूयतामद्य रहस्यमिदमुत्तमम् ।\nसंसारार्णवमग्नानां विषयाक्रांतचेतसाम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002399024, "chapter_id": 22399, "verse_number": "१-६१-२५", "content_sanskrit": "हंसपोतं विना नान्यत्किंचिदस्ति परायणम् ।\nउत्तिष्ठंश्चिंतय रविं व्रजंश्चिंतय गोपतिम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002399025, "chapter_id": 22399, "verse_number": "१-६१-२६", "content_sanskrit": "भुञ्जंश्चिंतय मार्तंडं स्वपांश्चिंतय भास्करम् ।\nएवमेकाग्रचित्तस्त्वं संश्रितः सततं रविम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002399026, "chapter_id": 22399, "verse_number": "१-६१-२७", "content_sanskrit": "जन्ममृत्युमहाग्राहं संसाराम्भस्तरिष्यसि ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002399027, "chapter_id": 22399, "verse_number": "१-६१-२८", "content_sanskrit": "ग्रहेशमीशं वरदं पुराणं जगद्विधातारमजं च नित्यम् ।\nसमाश्रिता ये रविमीशितारं तेषां भवो नास्ति विमुक्तिभाजाम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]