[{"id": 2047354, "chapter_id": 2048, "verse_number": "६-९७-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2047355, "chapter_id": 2048, "verse_number": "६-९७-१", "content_sanskrit": "ततो दुर्योधनो राजा शकुनिश्चापि सौबलः।\nदुःशासनश्च पुत्रस्ते सूतपुत्रश्च दुर्जयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2047356, "chapter_id": 2048, "verse_number": "६-९७-२", "content_sanskrit": "समागम्य महाराज मन्त्रं चक्रुर्विवक्षितम् ।\nकथं पाण्डुसुताः सङ्ख्ये जेतव्याः सगणा इति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2047357, "chapter_id": 2048, "verse_number": "६-९७-३", "content_sanskrit": "ततो दुर्योधनो राजा सर्वांस्तानाह मन्त्रिणः ।\nसूतपुत्रं समाभाष्य सौबलं च महाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2047358, "chapter_id": 2048, "verse_number": "६-९७-४", "content_sanskrit": "द्रोणो भीष्म कृपः शल्यः सौमदत्तिश्च संयुगे।\nन पार्थान्प्रति बाधन्ते न जाने किंनु कारणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2047359, "chapter_id": 2048, "verse_number": "६-९७-५", "content_sanskrit": "अवध्यमानास्ते चापि क्षपयन्ति बलं मम।\nसोऽस्मि क्षीणबलः कर्ण क्षीणशस्त्रश्च संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2047360, "chapter_id": 2048, "verse_number": "६-९७-६", "content_sanskrit": "`द्रोणस्य प्रमुखे वीरा हतास्ते भ्रातरो मम।\nभीमसेनेन राधेय मम चैव च पश्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2047361, "chapter_id": 2048, "verse_number": "६-९७-७", "content_sanskrit": "निकृतः पाण्डवैः शूरैरवध्यैर्दैवतैरपि ।\nसोऽहं संशयमापन्नः प्रकरिष्ये कथं रणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2047362, "chapter_id": 2048, "verse_number": "६-९७-८x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2047363, "chapter_id": 2048, "verse_number": "६-९७-८", "content_sanskrit": "तमब्रवीन्महाराज सूतपुत्रो नराधिपम् ।\nमा शोच भरतश्रेष्ठ करिष्येऽहं प्रियं तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2047364, "chapter_id": 2048, "verse_number": "६-९७-९", "content_sanskrit": "भीष्मः शान्तनवस्तूर्णमपयातु महारणात् ।\nनिवृत्ते युधि गाङ्गेये न्यस्तशस्त्रे च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2047365, "chapter_id": 2048, "verse_number": "६-९७-१०", "content_sanskrit": "अहं पार्थान्हनिष्यामि सहितान्सर्वसोमकैः ।\nपश्यतो युधि भीष्मस्य शपे सत्येन ते नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2047366, "chapter_id": 2048, "verse_number": "६-९७-११", "content_sanskrit": "पाण्डवेषु दयां नित्यं स हि भीष्मः करोति वै।\nअशक्तश्च रणे भीष्मो जेतुमेतान्महारथान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2047367, "chapter_id": 2048, "verse_number": "६-९७-१२", "content_sanskrit": "अभिमानी रणे भीष्मो नित्यं चापि रणप्रियः ।\nस कथं पाण्डवान्युद्धे जेष्यते तात संगतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2047368, "chapter_id": 2048, "verse_number": "६-९७-१३", "content_sanskrit": "स त्वं शीघ्रमितो गत्वा भीष्मस्य शिबिरं प्रति ।\nअनुमान्य गुरुं वृद्धं शस्त्रं न्यासय भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2047369, "chapter_id": 2048, "verse_number": "६-९७-१४", "content_sanskrit": "न्यस्तशस्त्रे ततो भीष्मे निहतान्पश्य पाण्डवान् ।\nमयैकेन रणे राजन्ससुहृद्गणबान्धवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2047370, "chapter_id": 2048, "verse_number": "६-९७-१५", "content_sanskrit": "एवमुक्तस्तु कर्णेन पुत्रो दुर्योधनस्तव ।\nअब्रवीद्भ्रातरं तत्र दुःशासनमिदं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2047371, "chapter_id": 2048, "verse_number": "६-९७-१६", "content_sanskrit": "अनुयात्रं यथा सर्वं सज्जीभवति सर्वशः ।\nदुःशासन तथा क्षिप्रं सर्वमेवोपपादय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2047372, "chapter_id": 2048, "verse_number": "६-९७-१७", "content_sanskrit": "एवमुक्त्वा ततो राजन्कर्णमाह जनेश्वरः ।\nअनुमान्य रणे भीष्ममेषोऽहं द्विपदां वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2047373, "chapter_id": 2048, "verse_number": "६-९७-१८", "content_sanskrit": "आगमिष्ये ततः क्षिप्रं त्वत्सकाशमरिन्दम।\nअपक्रान्ते ततो भीष्मे प्रहरिष्यसि संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2047374, "chapter_id": 2048, "verse_number": "६-९७-१९", "content_sanskrit": "निष्पपात ततस्तूर्णं पुत्रस्तव विशांपते ।\nसहितो भ्रातृभिस्तैस्तु देवैरिव शतक्रतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2047375, "chapter_id": 2048, "verse_number": "६-९७-२०", "content_sanskrit": "ततस्तं नृपशार्दूलं शार्दूलसमविक्रमम् ।\nआरोपयद्धयं तूर्णं भ्राता दुःशासनस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2047376, "chapter_id": 2048, "verse_number": "६-९७-२१", "content_sanskrit": "अङ्गदी बद्धमुकुटो हस्ताभरणवान्नृप ।\nधार्तराष्ट्रो महाराज विबभौ स पथि व्रजन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2047377, "chapter_id": 2048, "verse_number": "६-९७-२२", "content_sanskrit": "भण्डीपुष्पनिकाशेन तपनीयनिभेन च।\nअनुलिप्तः परार्द्ध्येन चन्दनेन सुगन्धिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2047378, "chapter_id": 2048, "verse_number": "६-९७-२३", "content_sanskrit": "अरजोम्बरसंवीतः सिंहखेलगतिर्नृप ।\nशुशुभे विमलार्चिष्मान्नभसीव दिवाकरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2047379, "chapter_id": 2048, "verse_number": "६-९७-२४", "content_sanskrit": "तं प्रयान्तं नरव्याघ्रं भीष्मस्य शिबिरं प्रति ।\nअनुजग्मुर्महेष्वासाः सर्वलोकस्य धन्विनः ।\nभ्रातरश्च महेष्वासास्त्रिदशा इव वासवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2047380, "chapter_id": 2048, "verse_number": "६-९७-२५", "content_sanskrit": "हयानन्ये समारुह्य गजानन्ये च भारत ।\nरथानन्ये नरश्रेष्ठं परिवव्रुः समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2047381, "chapter_id": 2048, "verse_number": "६-९७-२६", "content_sanskrit": "`पदातयश्च त्वरिता नखरप्रासयोधिनः।\nपरिवव्रुर्महेष्वासं धार्तराष्ट्रं महारथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2047382, "chapter_id": 2048, "verse_number": "६-९७-२७", "content_sanskrit": "आत्तशस्त्राश्च सुहृदो रक्षणार्थं महीपतेः ।\nप्रादुर्बभूवुः सहिताः शक्रस्येवामरा दिवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2047383, "chapter_id": 2048, "verse_number": "६-९७-२८", "content_sanskrit": "स पूज्यमानः कुरुभिः कौरवाणां महाबलः ।\nप्रययौ सदनं राजा गाङ्गेयस्य यशस्विनः ।\nअन्वीयमानः सततं सोदरैः परिवारितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2047384, "chapter_id": 2048, "verse_number": "६-९७-२९", "content_sanskrit": "दक्षिणं दक्षिणः काले संभृत्य स्वभुजं तदा।\nहस्तिहस्तोपमं सौम्यं सर्वशत्रुनिबर्हणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2047385, "chapter_id": 2048, "verse_number": "६-९७-३०", "content_sanskrit": "प्रगृह्णन्नञ्जलीन्नॄणामुद्यतान्सर्वतो दिशः।\nशुश्राव मधुरा वाचो नानादेशनिवासिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2047386, "chapter_id": 2048, "verse_number": "६-९७-३१", "content_sanskrit": "संस्तूयमानः सूतैश्च मागधैश्च महायशाः।\nपूजयानश्च तान्सर्वान्सर्वलोकेश्वरेश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2047387, "chapter_id": 2048, "verse_number": "६-९७-३२", "content_sanskrit": "प्रदीपैः काञ्चनैस्तत्र गन्धतैलावसेचितैः ।\nपरिवव्रुर्महाराजं प्रज्वलद्भिः समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2047388, "chapter_id": 2048, "verse_number": "६-९७-३३", "content_sanskrit": "स तैः परिवृतो राजा प्रदीपैः काञ्चनैर्ज्वलन्।\nशुशुभे चन्द्रमायुक्तो दीप्तैरिव महाग्रहैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2047389, "chapter_id": 2048, "verse_number": "६-९७-३४", "content_sanskrit": "कञ्चुकोष्णीषिणस्तत्र वेत्रझर्झरपाणयः।\nप्रोत्सारयन्तः शनकैस्तं जनं सर्वतो दिशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2047390, "chapter_id": 2048, "verse_number": "६-९७-३५", "content_sanskrit": "संप्राप्य तु ततो राजा भीष्मस्य सदनं शुभम् ।\nअवतीर्य हयाच्चापि भीष्मं प्राप्य जनेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2047391, "chapter_id": 2048, "verse_number": "६-९७-३६", "content_sanskrit": "अभिवाद्य ततो भीष्मं निषण्णः परमासने।\nकाञ्चने सर्वतोभद्रे स्पर्द्ध्यास्तरणसंवृते।\nउवाच प्राञ्जलिर्भीष्मं बाष्पकण्ठोऽश्रुलोचनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2047392, "chapter_id": 2048, "verse_number": "६-९७-३७", "content_sanskrit": "त्वां वयं हि समाश्रित्य संयुगे शत्रुसूदन ।\nउत्सहेम रणे जेतुं सेन्द्रानपि सुरासुरान् ।\nकिमु पाण्डुसुतान्वीरान्ससुहृद्गणबान्धवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2047393, "chapter_id": 2048, "verse_number": "६-९७-३८", "content_sanskrit": "तस्मादर्हसि गाङ्गेय कृपां कर्तुं मयि प्रभो।\nजहि पाणडुसुतान्वारान्महेन्द्र इव दानवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2047394, "chapter_id": 2048, "verse_number": "६-९७-३९", "content_sanskrit": "पूर्वमुक्तं महाबाहो हनिष्यामि ससोमकान् ।\nपाञ्चालान्केकयैः सार्धं करूपांश्चेति भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2047395, "chapter_id": 2048, "verse_number": "६-९७-४०", "content_sanskrit": "त्वद्वचः सत्यमेवास्तु जहि पार्थान्समागतान् ।\nसोमकांश्च महेष्वासान्सत्यवाग्भव भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2047396, "chapter_id": 2048, "verse_number": "६-९७-४१", "content_sanskrit": "दयया यदि वा राजन्द्वेष्यभावान्मम प्रभो ।\nमन्दभाग्यतया वापि मम रक्षसि पाण्डवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2047397, "chapter_id": 2048, "verse_number": "६-९७-४२", "content_sanskrit": "अनुजानीहि समरे कर्णमाहवशोभिनम् ।\nस जेष्यति रणे पार्थान्ससुहृद्गणबान्धवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2047398, "chapter_id": 2048, "verse_number": "६-९७-४३x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2047399, "chapter_id": 2048, "verse_number": "६-९७-४३", "content_sanskrit": "स एवमुक्त्वा नृपतिः पुत्रो दुर्योधनस्तव।\nनोवाच वचनं किंचिद्भीष्मं सत्यपराक्रमम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2047400, "chapter_id": 2048, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भीष्मवधपर्वणि सप्तनवतितमोऽध्यायः ॥\nMahabharata - Bhishma Parva - Chapter Footnotes\n६-९७-२१ भण्डीपुष्पं मञ्जिष्ठापुष्पम् ॥ ६-९७-२९ दक्षिणं स्वभुजं संभृत्य समुद्धृत्य ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]