[{"id": 900005008, "chapter_id": 8414, "verse_number": "1.1", "content_sanskrit": "नमोऽगणितकल्याणगुणपूर्णाय विष्णवे", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900005009, "chapter_id": 8414, "verse_number": "1.2", "content_sanskrit": "ननु कथं सत्यता जगतोऽङ्गीकाराधिकारि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900005010, "chapter_id": 8414, "verse_number": "1.3", "content_sanskrit": "तत्किमनिर्वचनीयत्वं वा असत्त्वं वा..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900005011, "chapter_id": 8414, "verse_number": "1.4", "content_sanskrit": "अनिर्वचनीयत्वं किं निर्वचनविरहो वा निर्वाच्यविरहो वा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900005012, "chapter_id": 8414, "verse_number": "1.5", "content_sanskrit": "ननु निषेधसमुच्चयस्य तात्त्विकत्वानभ्युपगमान्न व्याघातः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900005013, "chapter_id": 8414, "verse_number": "1.6", "content_sanskrit": "तत्रात्मत्वप्रयुक्तं सत्त्वमिति चेत्किं तदात्म-त्वम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900005014, "chapter_id": 8414, "verse_number": "1.7", "content_sanskrit": "असति व्यभिचारात्..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900005015, "chapter_id": 8414, "verse_number": "1.8", "content_sanskrit": "न च वाच्यमात्मादौ न विकल्पोऽवकल्पते..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900005016, "chapter_id": 8414, "verse_number": "1.9", "content_sanskrit": "किञ्च न सदसद्विलक्षणत्वे मानम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900005017, "chapter_id": 8414, "verse_number": "1.10", "content_sanskrit": "सत्त्वासत्त्वे एकवस्तुनिष्ठात्यन्ताभाव-प्रतियोगिनी..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900005018, "chapter_id": 8414, "verse_number": "1.11", "content_sanskrit": "सच्चेन्न बाध्येतेत्यत्र किमिदं सद्विक्षितं..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900005019, "chapter_id": 8414, "verse_number": "1.12", "content_sanskrit": "असच्चेन्न प्रतीयेतेत्यत्रासतोऽसत्त्वेन..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900005020, "chapter_id": 8414, "verse_number": "1.13", "content_sanskrit": "तदपि किं प्रकृतेनैव रूपेण प्रतीयते भ्रान्ता-वन्याकारेण वा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900005021, "chapter_id": 8414, "verse_number": "1.14", "content_sanskrit": "बाध्यत्वानिरूपणात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900005022, "chapter_id": 8414, "verse_number": "1.15", "content_sanskrit": "तत्किमन्यथाज्ञातस्य सम्यग्ज्ञातत्वं..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900005023, "chapter_id": 8414, "verse_number": "1.16", "content_sanskrit": "द्वितीये किमेकदेशकालप्रतिपन्नस्य..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900005024, "chapter_id": 8414, "verse_number": "1.17", "content_sanskrit": "का चेयं प्रतिपन्नता नाम", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900005025, "chapter_id": 8414, "verse_number": "1.18", "content_sanskrit": "न चतुर्थः । विचारागोचरत्वात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900005026, "chapter_id": 8414, "verse_number": "1.19", "content_sanskrit": "किञ्चातत्त्वावेदकं प्रमाणं चेति व्याघातः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 900005027, "chapter_id": 8414, "verse_number": "1.20", "content_sanskrit": "न षष्ठः । केयमविद्या नाम", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 900005028, "chapter_id": 8414, "verse_number": "1.21", "content_sanskrit": "न द्वितीयः । अनादित्वस्यासम्भवित्वात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 900005029, "chapter_id": 8414, "verse_number": "1.22", "content_sanskrit": "न तृतीयः । भ्रमशब्देनार्थो ज्ञानं वा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 900005030, "chapter_id": 8414, "verse_number": "1.23", "content_sanskrit": "तत्त्वावेदकस्यापि त्वयाऽऽविद्यकत्वाभ्युप-गमात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 900005031, "chapter_id": 8414, "verse_number": "1.24", "content_sanskrit": "अविद्यायां चैवंविधायां किं प्रमाणम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 900005032, "chapter_id": 8414, "verse_number": "1.25", "content_sanskrit": "अथ प्रमाणज्ञानं स्वप्रागभावव्यतिरिक्त-स्वविषयावरणस्व..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 900005033, "chapter_id": 8414, "verse_number": "1.26", "content_sanskrit": "नानेनानुमानेन त्वदभिमताज्ञानसिद्धिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 900005034, "chapter_id": 8414, "verse_number": "1.27", "content_sanskrit": "किञ्च सत्यतथाविधवस्तुपूर्वकत्वे साध्ये सिद्ध-साधनम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 900005035, "chapter_id": 8414, "verse_number": "1.28", "content_sanskrit": "किञ्च किमिदं प्रकाशकत्वं नाम", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 900005036, "chapter_id": 8414, "verse_number": "1.29", "content_sanskrit": "यत्तु कश्चिदाह नाज्ञानं ज्ञानाभावः यत्तु कश्चिदाह नाज्ञानं ज्ञानाभावः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 900005037, "chapter_id": 8414, "verse_number": "1.30", "content_sanskrit": "किमत्र सर्वानुवादेन व्यवहारः किं वा सामान्यतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 900005038, "chapter_id": 8414, "verse_number": "1.31", "content_sanskrit": "न द्वितीयः । सामान्यानुवादेन विशेष-व्यवहारोपपत्तेः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 900005039, "chapter_id": 8414, "verse_number": "1.32", "content_sanskrit": "न च भावरूपाज्ञाननिराकरणे सिद्धान्त-विरोधः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 900005040, "chapter_id": 8414, "verse_number": "1.33", "content_sanskrit": "नापि दृश्यत्वस्य", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 900005041, "chapter_id": 8414, "verse_number": "1.34", "content_sanskrit": "अतीतानागतनित्यानुमेयेषु ज्ञातताभावाद्भागा-सिद्धिश्च", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 900005042, "chapter_id": 8414, "verse_number": "1.35", "content_sanskrit": "स्वव्यवहारे स्वातिरिक्तसंविदनपेक्षत्वं..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 900005043, "chapter_id": 8414, "verse_number": "1.36", "content_sanskrit": "किञ्च दृश्यत्वं प्रमाणतो वा भ्रान्त्या वा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 900005044, "chapter_id": 8414, "verse_number": "1.37", "content_sanskrit": "ननु रजतसंविदः कथं शुक्तिका विषयो विरोधादिति चेन्न", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 900005045, "chapter_id": 8414, "verse_number": "1.38", "content_sanskrit": "किञ्च दृश्यत्वाभावे तदविद्यानिवृत्त्यभावेन मोक्षाभावप्रसङ्गः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 900005046, "chapter_id": 8414, "verse_number": "1.39", "content_sanskrit": "तथा हि । आत्माकारमिति कोऽर्थः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 900005047, "chapter_id": 8414, "verse_number": "1.40", "content_sanskrit": "ननु भवेदिदं यदि दृग्विषयत्वं दृश्यत्वम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]