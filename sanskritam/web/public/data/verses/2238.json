[{"id": 2057102, "chapter_id": 2238, "verse_number": "७-१६५-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2057103, "chapter_id": 2238, "verse_number": "७-१६५-१", "content_sanskrit": "प्रकाशिते तदा लोके रजसा तमसावृते।\nसमाजग्मुरथो वीराः परस्परवधैषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2057104, "chapter_id": 2238, "verse_number": "७-१६५-२", "content_sanskrit": "ते समेत्य रणे राजञ्शस्त्रप्रासासिधारिणः।\nपरस्परमुदैक्षन्त परस्परकृतागसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2057105, "chapter_id": 2238, "verse_number": "७-१६५-३", "content_sanskrit": "प्रदीपानां सहस्रैश्च दीप्यमानैः समन्ततः।\nरत्नाचितैः स्वर्णदण्डैर्गन्धतैलावसिञ्चितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2057106, "chapter_id": 2238, "verse_number": "७-१६५-४", "content_sanskrit": "देवगन्धर्वदीपाद्यैः प्रभाभिरधिकोज्ज्वलैः।\nविरराज तदा भूमिर्ग्रहैर्द्यौरिव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2057107, "chapter_id": 2238, "verse_number": "७-१६५-५", "content_sanskrit": "उल्काशतैः प्रज्वलितै रणभूमिर्व्यराजत।\nदह्यमानेव लोकानामभावे च वसुन्धरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2057108, "chapter_id": 2238, "verse_number": "७-१६५-६", "content_sanskrit": "व्यदीप्यन्त दिशः सर्वाः प्रदीपैस्तैः समन्ततः।\nवर्षाप्रदोषे खद्योतैर्वृता वृक्षा इवाबभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2057109, "chapter_id": 2238, "verse_number": "७-१६५-७", "content_sanskrit": "असज्जन्त ततो वीरा विरेष्वेव पृथक्पृथक्।\nनागा नागैः समाजग्मुस्तुरगा हयसादिभिः।\nरथा रथवरैरेव समजग्मुर्मुदा युताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2057110, "chapter_id": 2238, "verse_number": "७-१६५-८", "content_sanskrit": "तस्मिन्रात्रिमुखे घोरे तव पुत्रस्य शासनात्।\nचतुरङ्गस्य सैन्यस्य सम्पातश्च महारनभूत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2057111, "chapter_id": 2238, "verse_number": "७-१६५-९", "content_sanskrit": "ततोऽर्जुनो महाराज कौरवाणामनीकिनीम्।\nव्यधमत्त्वरया युक्तः क्षपयन्सर्वपार्थिवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2057112, "chapter_id": 2238, "verse_number": "७-१६५-१०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2057113, "chapter_id": 2238, "verse_number": "७-१६५-१०", "content_sanskrit": "तस्मिन्प्रविष्टे संरब्धे मम पुत्रस्य वाहिनीम्।\nअमृष्यमाणे दुर्धर्षे कथमासीन्मनो हि वः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2057114, "chapter_id": 2238, "verse_number": "७-१६५-११", "content_sanskrit": "किमकुर्वत सैन्यानि प्रविष्टे परषीडने।\nदुर्योधनश्च किं कृत्यं प्राप्तकालममन्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2057115, "chapter_id": 2238, "verse_number": "७-१६५-१२", "content_sanskrit": "के चैनं समरे वीरं प्रत्युद्ययुररिन्दमाः।\nद्रोणं च के व्यरक्षन्त प्रविष्टे श्वेतवाहने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2057116, "chapter_id": 2238, "verse_number": "७-१६५-१३", "content_sanskrit": "केऽरक्षन्दक्षिणं चक्रं के च द्रोणस्य सव्यतः।\nके पृष्ठतश्चाप्यभवन्वीरा वीरान्विनिघ्नतः।\nके पुरस्तादगच्छन्त निघ्नन्तः शास्त्रवान्रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2057117, "chapter_id": 2238, "verse_number": "७-१६५-१४", "content_sanskrit": "यत्प्राविशन्महेष्वासः पाञ्चालनापराजिताः।\nनृत्यन्निव नरव्याघ्रो रथमार्गेषु वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2057118, "chapter_id": 2238, "verse_number": "७-१६५-१५", "content_sanskrit": "यो ददाह शरैर्द्रोणः पाञ्चालानां रथव्रजान्।\nधूमकेतुरिव क्रुद्धः कथं मृत्युमुपेयिवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2057119, "chapter_id": 2238, "verse_number": "७-१६५-१६", "content_sanskrit": "अव्यग्रानेव हि परान्कथयस्यपराजितान्।\nहृष्टानुदीर्णान्सङ्ग्रामे न तथा सूत मामकान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2057120, "chapter_id": 2238, "verse_number": "७-१६५-१७", "content_sanskrit": "हतांश्चैव विदीर्णांश्च विप्रकीर्णांश्च शंससि।\nरथिनो विरथांश्चैव कृतान्युद्वेषु मामकान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2057121, "chapter_id": 2238, "verse_number": "७-१६५-१८x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2057122, "chapter_id": 2238, "verse_number": "७-१६५-१८", "content_sanskrit": "द्रोणस्य मतमाज्ञाय योद्वुकामस्य तां निशाम्।\nदुर्योधनो महाराज वश्यान्भ्रातॄनुवाच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2057123, "chapter_id": 2238, "verse_number": "७-१६५-१९", "content_sanskrit": "कर्णं च वृषसेनं च मद्रराजं च कौरव।\nदुर्धर्षं दीर्घबाहुं च ये च तेषां पदानुगाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2057124, "chapter_id": 2238, "verse_number": "७-१६५-२०", "content_sanskrit": "द्रोणं यत्ताः पराक्रान्ताः सर्वे रक्षन्तु पृष्ठतः।\nहार्दिक्यो दक्षिणं चक्रं शल्यश्चैवोत्तरं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2057125, "chapter_id": 2238, "verse_number": "७-१६५-२१", "content_sanskrit": "त्रिगर्तानां च ये शूरा हतशिष्टा महारथाः।\nतांश्चैव पुरतः सर्वान्पुत्रस्ते समचोदयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2057126, "chapter_id": 2238, "verse_number": "७-१६५-२२x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2057127, "chapter_id": 2238, "verse_number": "७-१६५-२२", "content_sanskrit": "आचार्यो हि सुसंयत्तो भृशं यत्ताश्च पाण्डवाः।\nतं रक्षत सुसंयत्ता निघ्नन्तं शास्त्रवान्रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2057128, "chapter_id": 2238, "verse_number": "७-१६५-२३", "content_sanskrit": "द्रोणो हि बलवान्युद्धे क्षिप्रहस्तः प्रतापवान्।\nनिर्जयेत्त्रिदशान्युद्धे किमु पार्थान्ससोमकान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2057129, "chapter_id": 2238, "verse_number": "७-१६५-२४", "content_sanskrit": "ते यूयं सहिताः सर्वे भृशं यत्ता महारथाः।\nद्रोणं रक्षत पाञ्चालाद्धृष्टद्युम्नान्महारथात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2057130, "chapter_id": 2238, "verse_number": "७-१६५-२५", "content_sanskrit": "पाण़्डवीयेषु सैन्येषु न तं पश्याम कञ्चन।\nयो योधयेद्रणे द्रोणं धृष्टद्युम्नादृते पुमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2057131, "chapter_id": 2238, "verse_number": "७-१६५-२६", "content_sanskrit": "तस्मात्सर्वात्मना मन्ये भारद्वाजस्य रक्षणम्।\nसुगुप्तः पाण्डवान्हन्यात्सृञ्जयांश्च ससोमकान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2057132, "chapter_id": 2238, "verse_number": "७-१६५-२७", "content_sanskrit": "सृञ्जयेष्वथ सर्वेषु निहतेषु चमूमुखे।\nधृष्टद्युम्नं रमे द्रौणिर्हनिष्यति न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2057133, "chapter_id": 2238, "verse_number": "७-१६५-२८", "content_sanskrit": "तथाऽर्जुनं च राधेयो हनिष्यति महारथः।\nभीमसेनमहं चापि युद्धेजेष्यामि दीक्षितः।\nशेषांश्च पाण्डवान्योधाः प्रसभं हीनतेजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2057134, "chapter_id": 2238, "verse_number": "७-१६५-२९", "content_sanskrit": "सोयं मम जयो व्यक्तो दीर्घकालं भविष्यति।\nतस्माद्रक्षत सङ्ग्रामे द्रोणमेव महारथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2057135, "chapter_id": 2238, "verse_number": "७-१६५-३०", "content_sanskrit": "इत्युक्त्वा भरतश्रेष्ठ पुत्रो दुर्याधनस्तव।\nव्यादिदेश तथा सैन्यं तस्मिंस्तमसि दारुणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2057136, "chapter_id": 2238, "verse_number": "७-१६५-३१", "content_sanskrit": "ततः प्रववृते युद्धं रात्रौ भरतसत्तम।\nउभयोः सेनयोर्घोरं परस्परजिगीषया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2057137, "chapter_id": 2238, "verse_number": "७-१६५-३२", "content_sanskrit": "अर्जुनः कौरवं सैन्यमर्जुनं चापि कौरवाः।\nनानाशस्त्रसमावायैरन्योन्यं समपीडयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2057138, "chapter_id": 2238, "verse_number": "७-१६५-३३", "content_sanskrit": "द्रौणिः पाञ्चालराजं च भारद्वाजश्च सृञ्जयान्।\nछादयांचक्रिरे सङ्ख्ये शरैः सन्नतपर्वभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2057139, "chapter_id": 2238, "verse_number": "७-१६५-३४", "content_sanskrit": "पाण्डुपाञ्चालसैन्यानां कौरवाणां च भारत।\nआसीन्निष्टानको घोरो निघ्नतामितरेतरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2057140, "chapter_id": 2238, "verse_number": "७-१६५-३५", "content_sanskrit": "नैवास्माभिस्तथा पूर्वैर्दृष्टपूर्वं तथाविधम्।\nयुद्धं यादृशमेवासीत्तां रात्रि सुभयावहम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2057141, "chapter_id": 2238, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि घटोत्कचवधपर्वणि चतुर्दशरात्रियुद्धे पञ्चषष्ट्यधिकशततमोऽध्यायः॥ १६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]