[{"id": 6000289000, "chapter_id": 10289, "verse_number": null, "content_sanskrit": "अथ त्रिनवतितमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000289001, "chapter_id": 10289, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_093/BhP_10.093.001.m4a", "display_order": 2}, {"id": 6000289002, "chapter_id": 10289, "verse_number": "१०-९३-१", "content_sanskrit": "वृष्णिष्वासीद् यदुश्रेष्ठः श्रुतदेव इति श्रुतः।\nकृष्णैकभक्त्या पूर्णार्थः शान्तः कविरलम्पटः॥ १०/९३/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_093/BhP_10.093.002.m4a", "display_order": 3, "topics": [{"text": "कृष्णेन मिथिलां गत्वा श्रुतदेवबहुलाश्वयोरनुग्रहः", "range": "१–४७"}]}, {"id": 6000289003, "chapter_id": 10289, "verse_number": "१०-९३-२", "content_sanskrit": "स उवास विदेहेषु मिथिलायां गृहाश्रमे।\nअनीहयाऽऽगताहार्यो निवर्तितजपक्रियः॥ १०/९३/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_093/BhP_10.093.003.m4a", "display_order": 4}, {"id": 6000289004, "chapter_id": 10289, "verse_number": "१०-९३-३", "content_sanskrit": "यावन्मात्रं त्वहरहर्दैवादुपनमत्ययम्।\nनाधिकं तपसा तुष्टः क्रियाश्चक्रे यथोचिताः॥ १०/९३/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_093/BhP_10.093.004.m4a", "display_order": 5}, {"id": 6000289005, "chapter_id": 10289, "verse_number": "१०-९३-४", "content_sanskrit": "तथा तद्राष्ट्रपालोऽभूद् बहुलाश्व इति श्रुतः।\nमैथिलो निरहम्मान उभावप्यच्युतप्रियौ॥ १०/९३/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_093/BhP_10.093.005.m4a", "display_order": 6}, {"id": 6000289006, "chapter_id": 10289, "verse_number": "१०-९३-५", "content_sanskrit": "तयोः प्रसन्नो भगवान् दारुकेणाहृतं रथम्।\nआरुह्य सहितो विप्रैर्नियतैर्ब्रह्मवादिभिः॥ १०/९३/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_093/BhP_10.093.006.m4a", "display_order": 7}, {"id": 6000289007, "chapter_id": 10289, "verse_number": "१०-९३-६", "content_sanskrit": "सहितः सात्वतश्रेष्ठो मुनिभिस्तत्वदर्शिभिः।\nकदाचित् कौरवश्रेष्ठ विदेहाय ययौ प्रभुः॥ १०/९३/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_093/BhP_10.093.007.m4a", "display_order": 8}, {"id": 6000289008, "chapter_id": 10289, "verse_number": "१०-९३-७", "content_sanskrit": "नारदो वामदेवोऽत्रिः कृष्णो रामोऽसितोऽरुणिः। अहं बृहस्पतिः कण्वो मैत्रेयश्च पराशरः।\nवसिष्ठः काश्यपश्चैव भरद्वाजोऽथ गौतमः॥ १०/९३/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_093/BhP_10.093.008.m4a", "display_order": 9}, {"id": 6000289009, "chapter_id": 10289, "verse_number": "१०-९३-८", "content_sanskrit": "तत्र तत्र समायान्तं पौरा जानपदान्विताः।\nउपतस्थुः सार्घ्यहस्ता लोकाः सूर्यमिवोदितम्॥ १०/९३/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_093/BhP_10.093.009.m4a", "display_order": 10}, {"id": 6000289010, "chapter_id": 10289, "verse_number": "१०-९३-९", "content_sanskrit": "आनर्तधन्वकुरुजाङ्गलटङ्कमत्स्यपाञ्चालकुन्तिमधुकैकयकोसलार्णाः।\nअन्ये च तन्मुखसरोजमुदारहासस्निग्धेक्षणं नृप पपुर्दृशिभिर्नृनार्यः॥ १०/९३/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_093/BhP_10.093.010.m4a", "display_order": 11}, {"id": 6000289011, "chapter_id": 10289, "verse_number": "१०-९३-१०", "content_sanskrit": "तेभ्यः स्ववीक्षणविनष्टतमिस्रदृग्भ्यः क्षेमं त्रिलोकगुरुरर्थदृशं च यच्छन्।\nशृण्वन् दिगन्तधवलं स्वयशोऽशुभघ्नं गीतं सुरैर्नृभिरयाच्छनकैर्विदेहान्॥ १०/९३/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_093/BhP_10.093.011.m4a", "display_order": 12}, {"id": 6000289012, "chapter_id": 10289, "verse_number": "१०-९३-११", "content_sanskrit": "तेऽच्युतं प्राप्तमाकर्ण्य पौरा जानपदा नृप।\nअभ्ययुर्मुदितास्तस्मै गृहीतार्हणपाणयः॥ १०/९३/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_093/BhP_10.093.012.m4a", "display_order": 13}, {"id": 6000289013, "chapter_id": 10289, "verse_number": "१०-९३-१२", "content_sanskrit": "दृष्ट्वा तमुत्तमश्लोकं प्रीत्युत्फुल्लामलाशयाः।\nउद्धृताञ्जलिभिर्नेमुः श्रुतपूर्वं तथा मुनीन्॥ १०/९३/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_093/BhP_10.093.013.m4a", "display_order": 14}, {"id": 6000289014, "chapter_id": 10289, "verse_number": "१०-९३-१३", "content_sanskrit": "स्वानुग्रहाय सम्प्राप्तं सत्यभूतं जगद्गुरुम्।\nमैथिलः श्रुतदेवश्च पादयोः पेततुः प्रभोः॥ १०/९३/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_093/BhP_10.093.014.m4a", "display_order": 15}, {"id": 6000289015, "chapter_id": 10289, "verse_number": "१०-९३-१४", "content_sanskrit": "निमन्त्रयेतां दाशार्हमातिथ्येन सह द्विजैः।\nमैथिलः श्रुतदेवश्च युगपत् सन्नताञ्जली॥ १०/९३/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_093/BhP_10.093.015.m4a", "display_order": 16}, {"id": 6000289016, "chapter_id": 10289, "verse_number": "१०-९३-१५", "content_sanskrit": "भगवांस्तदभिप्रेत्य तयोः प्रियचिकीर्षया।\nउभयोरविशद् गेहं रूपाभ्यां तदलक्षितः॥ १०/९३/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_093/BhP_10.093.016.m4a", "display_order": 17}, {"id": 6000289017, "chapter_id": 10289, "verse_number": "१०-९३-१६", "content_sanskrit": "श्रोतुमप्यसतां दूरान् जनकः स्वगृहागतान्।\nआनीतेष्वासनाग्र्येषु सुखासीनान् महामनाः॥ १०/९३/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_093/BhP_10.093.017.m4a", "display_order": 18}, {"id": 6000289018, "chapter_id": 10289, "verse_number": "१०-९३-१७", "content_sanskrit": "प्रवृद्धभक्त्युरूत्कर्षहृदयास्राविलेक्षणः।\nनत्वा तदङ्घ्रीन् प्रक्षाल्य तदपो लोकपावनीः॥ १०/९३/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_093/BhP_10.093.018.m4a", "display_order": 19}, {"id": 6000289019, "chapter_id": 10289, "verse_number": "१०-९३-१८", "content_sanskrit": "सकुटुम्बो वहन् मूर्ध्नि पूजयाञ्चक्र ईश्वरम्।\nगन्धमाल्याम्बराकल्पधूपदीपार्घ्यगोवृषैः॥ १०/९३/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_093/BhP_10.093.019.m4a", "display_order": 20}, {"id": 6000289020, "chapter_id": 10289, "verse_number": "१०-९३-१९", "content_sanskrit": "वाचा मधुरया प्रीणन्निदमाहान्नतर्पितान्।\nपादावङ्कगतौ विष्णोरामृजञ्छनकैर्मुदा॥ १०/९३/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_093/BhP_10.093.020.m4a", "display_order": 21}, {"id": 6000289021, "chapter_id": 10289, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_093/BhP_10.093.021.m4a", "display_order": 22}, {"id": 6000289022, "chapter_id": 10289, "verse_number": "१०-९३-२०", "content_sanskrit": "भवान् वै सर्वजीवानामात्मा साक्षी सुहृद् विभुः।\nअथ नस्त्वत्पदाम्भोजं स्मरतां दर्शनं गतः॥ १०/९३/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_093/BhP_10.093.022.m4a", "display_order": 23}, {"id": 6000289023, "chapter_id": 10289, "verse_number": "१०-९३-२१", "content_sanskrit": "स्ववचस्तद् ऋतं कर्तुमस्मद्दृग्गोचरो भवान्।\nयदा त्वेकान्तभक्तानामात्माऽनन्तोऽरजाः प्रियः॥ १०/९३/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_093/BhP_10.093.023.m4a", "display_order": 24}, {"id": 6000289024, "chapter_id": 10289, "verse_number": "१०-९३-२२", "content_sanskrit": "को नु त्वच्चरणाम्भोजमेवंविद् विसृजेत् प्रभो।\nनिष्किञ्चनानां शान्तानां मुनीनां यस्त्वमात्मदः॥ १०/९३/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_093/BhP_10.093.024.m4a", "display_order": 25}, {"id": 6000289025, "chapter_id": 10289, "verse_number": "१०-९३-२३", "content_sanskrit": "योऽवतीर्य यदोर्वंशे नृणां संसरतामिह।\nयशो वितेने तच्छान्त्यै त्रैलोक्यविकृतापहः॥ १०/९३/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_093/BhP_10.093.025.m4a", "display_order": 26}, {"id": 6000289026, "chapter_id": 10289, "verse_number": "१०-९३-२४", "content_sanskrit": "नमस्तुभ्यं भगवते कृष्णायाकुण्ठमेधसे।\nनारायणाय ऋषये स्वशान्ततप ईयुषे॥ १०/९३/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_093/BhP_10.093.026.m4a", "display_order": 27}, {"id": 6000289027, "chapter_id": 10289, "verse_number": "१०-९३-२५", "content_sanskrit": "दिनानि कतिचिद् भूमन् गृहे नो निवसन् निजैः।\nसमेतः पादरजसा पुनीहीदं निमेः कुलम्॥ १०/९३/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_093/BhP_10.093.027.m4a", "display_order": 28}, {"id": 6000289028, "chapter_id": 10289, "verse_number": "१०-९३-२६", "content_sanskrit": "इत्युपामन्त्रितो राज्ञा भगवान् लोकभावनः।\nउवास कुर्वन् कल्याणं मिथिलानरयोषिताम्॥ १०/९३/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_093/BhP_10.093.028.m4a", "display_order": 29}, {"id": 6000289029, "chapter_id": 10289, "verse_number": "१०-९३-२७", "content_sanskrit": "श्रुतदेवोऽच्युतं प्राप्तं स्वगृहान् जनको यथा।\nमत्वा मुनींश्च सन्तुष्टो धुन्वन् वासो ननर्त ह॥ १०/९३/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_093/BhP_10.093.029.m4a", "display_order": 30}, {"id": 6000289030, "chapter_id": 10289, "verse_number": "१०-९३-२८", "content_sanskrit": "तृणपीठे सशिष्यांस्तानास्तृतेषूपवेश्य सः।\nस्वागतेनाभिवन्द्याङ्घ्रिं सभार्योऽवनिजे मुदा॥ १०/९३/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_093/BhP_10.093.030.m4a", "display_order": 31}, {"id": 6000289031, "chapter_id": 10289, "verse_number": "१०-९३-२९", "content_sanskrit": "तदम्भसा महाभाग आत्मानं स्वगृहान्वयम्।\nस्नापयाञ्चक्र उद्धर्षो लब्धसर्वमनोरथः॥ १०/९३/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_093/BhP_10.093.031.m4a", "display_order": 32}, {"id": 6000289032, "chapter_id": 10289, "verse_number": "१०-९३-३०", "content_sanskrit": "सिद्धार्हणोशीरशिवामृताम्भसा मृदा सुरभ्या तुलसीकुशाम्बुजैः।\nआराधयामास यथोपपन्नया सपर्यया सत्वविवर्धमानया॥ १०/९३/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_093/BhP_10.093.032.m4a", "display_order": 33}, {"id": 6000289033, "chapter_id": 10289, "verse_number": "१०-९३-३१", "content_sanskrit": "स तर्कयामास कुतो ममापतत् गृहान्धकूपे पतितस्य सङ्गमः।\nयः सर्वतीर्थास्पदपादरेणुभिः कृष्णेन चाध्यात्मनिकेतभूसुरैः॥ १०/९३/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_093/BhP_10.093.033.m4a", "display_order": 34}, {"id": 6000289034, "chapter_id": 10289, "verse_number": "१०-९३-३२", "content_sanskrit": "सूपविष्टान् कृतातिथ्यान् श्रुतदेव उपस्थितः।\nसभार्यस्वजनापत्य उवाचाङ्घ्र्यभिमर्शनम्॥ १०/९३/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_093/BhP_10.093.034.m4a", "display_order": 35}, {"id": 6000289035, "chapter_id": 10289, "verse_number": null, "content_sanskrit": "श्रुतदेव उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_093/BhP_10.093.035.m4a", "display_order": 36}, {"id": 6000289036, "chapter_id": 10289, "verse_number": "१०-९३-३३", "content_sanskrit": "अद्य नो दर्शनं प्राप्तः परः परमपूरुषः।\nय इदं शक्तिभिः सृष्ट्वा विभजत्यात्मसत्तया॥ १०/९३/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_093/BhP_10.093.036.m4a", "display_order": 37}, {"id": 6000289037, "chapter_id": 10289, "verse_number": "१०-९३-३४", "content_sanskrit": "यथा शयानः पुरुषो मनसा चात्ममायया।\nसृष्ट्वा लोकं परं स्वाप्नमवरुद्ध्यावभासते॥ १०/९३/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_093/BhP_10.093.037.m4a", "display_order": 38}, {"id": 6000289038, "chapter_id": 10289, "verse_number": "१०-९३-३५", "content_sanskrit": "शृृण्वतां गदतां शश्वद् दर्शिनामभिनन्दताम्।\nनृणां संवसतां नित्यं हृदिस्थो योऽमलात्मनाम्॥ १०/९३/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_093/BhP_10.093.038.m4a", "display_order": 39}, {"id": 6000289039, "chapter_id": 10289, "verse_number": "१०-९३-३६", "content_sanskrit": "हृदिस्थोऽप्यथ दूरस्थः कर्मविक्षिप्तचेतसाम्।\nआत्मशक्तिभिरग्राह्यो ह्यर्थाकारोऽगुणात्मकः॥ १०/९३/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_093/BhP_10.093.039.m4a", "display_order": 40}, {"id": 6000289040, "chapter_id": 10289, "verse_number": "१०-९३-३७", "content_sanskrit": "नमोऽस्तु तेऽध्यात्मविदां परात्मने सर्वात्मने स्वात्मविभक्तमूर्तये।\nसकारणाकारणलिङ्गमीयुषे स्वमाययाऽसंवृतदृष्टये नमः॥ १०/९३/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_093/BhP_10.093.040.m4a", "display_order": 41}, {"id": 6000289041, "chapter_id": 10289, "verse_number": "१०-९३-३८", "content_sanskrit": "स त्वं शाधि स्वभृत्यान्नः किं चेश करवाम हे।\nएतदन्तो नृणां क्लेशो यद् भवानक्षगोचरः॥ १०/९३/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_093/BhP_10.093.041.m4a", "display_order": 42}, {"id": 6000289042, "chapter_id": 10289, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_093/BhP_10.093.042.m4a", "display_order": 43}, {"id": 6000289043, "chapter_id": 10289, "verse_number": "१०-९३-३९", "content_sanskrit": "तदुक्तमित्युपाकर्ण्य भगवान् प्रणतार्तिहा।\nगृहीत्वा पाणिना पाणिं प्रहसन् तमुवाच ह॥ १०/९३/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_093/BhP_10.093.043.m4a", "display_order": 44}, {"id": 6000289044, "chapter_id": 10289, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_093/BhP_10.093.044.m4a", "display_order": 45}, {"id": 6000289045, "chapter_id": 10289, "verse_number": "१०-९३-४०", "content_sanskrit": "ब्रह्मंस्तेऽनुग्रहार्थाय सम्प्राप्तान् विद्ध्यमून् मुनीन्।\nसञ्चरन्ति मया लोकान् पुनन्तः पादरेणुभिः॥ १०/९३/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_093/BhP_10.093.045.m4a", "display_order": 46}, {"id": 6000289046, "chapter_id": 10289, "verse_number": "१०-९३-४१", "content_sanskrit": "देवाः क्षेत्राणि तीर्थानि दर्शनस्पर्शनार्चनैः।\nलोकान् पुनन्ति कालेन तदप्यर्हत्तमेक्षया॥ १०/९३/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_093/BhP_10.093.046.m4a", "display_order": 47}, {"id": 6000289047, "chapter_id": 10289, "verse_number": "१०-९३-४२", "content_sanskrit": "ब्राह्मणा जन्मनः श्रेष्ठाः सर्वेषां प्राणिनामिव।\nतपसा विद्यया तुष्ट्या किमु मत्कथया पुनः॥ १०/९३/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_093/BhP_10.093.047.m4a", "display_order": 48}, {"id": 6000289048, "chapter_id": 10289, "verse_number": "१०-९३-४३", "content_sanskrit": "न ब्राह्मणान्मे दयितं रूपमेतच्चतुर्भुजम्।\nसर्ववेदमयो विप्रः सर्वदेवमयो ह्यहम्॥ १०/९३/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_093/BhP_10.093.048.m4a", "display_order": 49}, {"id": 6000289049, "chapter_id": 10289, "verse_number": "१०-९३-४४", "content_sanskrit": "दुष्प्रज्ञा अविदित्वैनमवजानन्त्यसूयवः।\nगुरुं मां विप्रमात्मानमर्चादाविति दृष्टयः॥ १०/९३/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_093/BhP_10.093.049.m4a", "display_order": 50}, {"id": 6000289050, "chapter_id": 10289, "verse_number": "१०-९३-४५", "content_sanskrit": "चराचरमिदं विश्वं भावये चास्य दैवतम्।\nमद्रूपाण्येभिरेतस्यां धत्ते विप्रो मदीक्षया॥ १०/९३/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_093/BhP_10.093.050.m4a", "display_order": 51}, {"id": 6000289051, "chapter_id": 10289, "verse_number": "१०-९३-४६", "content_sanskrit": "तस्माद् ब्रह्म ऋषीनेतान् ब्रह्मज्ञान् श्रद्धयाऽर्चय।\nएवंविदाऽर्चितोऽस्म्यद्धा नान्यथा सुविभूतिभिः॥ १०/९३/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_093/BhP_10.093.051.m4a", "display_order": 52}, {"id": 6000289052, "chapter_id": 10289, "verse_number": "१०-९३-४७", "content_sanskrit": "स इत्थं प्रभुणाऽऽदिष्टः सहकृष्णान् द्विजोत्तमान्।\nआराध्यैकान्तभावेन मैथिलश्चापतुर्गतिम्॥ १०/९३/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_093/BhP_10.093.052.m4a", "display_order": 53}, {"id": 6000289053, "chapter_id": 10289, "verse_number": "१०-९३-४८", "content_sanskrit": "एवं स्वभक्तयो राजन् भगवान् भक्तभक्तिमान्।\nउषित्वाऽऽदिश्य सन्मार्गं पुनर्द्वारावतीमगात्॥ १०/९३/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_093/BhP_10.093.053.m4a", "display_order": 54, "topics": [{"text": "ततः प्रतिनिवृत्तिः", "range": "४८"}]}, {"id": 6000289054, "chapter_id": 10289, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्ध उत्तरार्ध त्रिनवतितमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}]