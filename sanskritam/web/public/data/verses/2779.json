[{"id": 2083400, "chapter_id": 2779, "verse_number": "१२-२८४-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2083401, "chapter_id": 2779, "verse_number": "१२-२८४-१", "content_sanskrit": "किंशीलः किंसमाचारः किंविद्यः किंपरायणः।\nप्राप्नोति ब्रह्मणः स्थानं यत्परं प्रकृतेर्ध्रुवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2083402, "chapter_id": 2779, "verse_number": "१२-२८४-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2083403, "chapter_id": 2779, "verse_number": "१२-२८४-२", "content_sanskrit": "मोक्षधर्मेषु निरतो लघ्वाहारो जितेन्द्रियः।\nप्राप्नोति परमं स्थानं यत्परं प्रकृतेर्ध्रुवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2083404, "chapter_id": 2779, "verse_number": "१२-२८४-३", "content_sanskrit": "`अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nहारीतेन पुरा गीतं तं निबोध युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2083405, "chapter_id": 2779, "verse_number": "१२-२८४-४", "content_sanskrit": "स्वगृहादभिनिःसृत्य लाभेऽलाभे समो मुनिः।\nसमुपोढेषु कामेषु निरपेक्षः परिव्रजेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2083406, "chapter_id": 2779, "verse_number": "१२-२८४-५", "content_sanskrit": "न चक्षुषा न मनसा न वाचा दूषयेत्परम्।\nन प्रत्यक्षं परोक्षं वा दूषणं व्याहरेत्क्वचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2083407, "chapter_id": 2779, "verse_number": "१२-२८४-६", "content_sanskrit": "न हिंस्यात्सर्वभूतानि मैत्रायणगतिश्चरेत्।\nनेदं जीवितमासाद्य वैरं कुर्वीत केनचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2083408, "chapter_id": 2779, "verse_number": "१२-२८४-७", "content_sanskrit": "अतिवादांस्तितिक्षेत नाभिमन्येत कंचन।\nक्रोध्यमानः प्रियं ब्रूयादाक्रुष्टः कुशलं वदेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2083409, "chapter_id": 2779, "verse_number": "१२-२८४-८", "content_sanskrit": "प्रदक्षिणं च सव्यं च ग्राममध्ये च नाचरेत्।\nभैक्षचर्यामनापन्नो न गच्छेत्पूर्वकेतनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2083410, "chapter_id": 2779, "verse_number": "१२-२८४-९", "content_sanskrit": "अवकीर्णः सुगुप्तश्च न वाचाऽप्यप्रियं चरेत्।\nमृदुः स्यादप्रतीकारो विस्रब्धः स्यादरोषणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2083411, "chapter_id": 2779, "verse_number": "१२-२८४-१०", "content_sanskrit": "विधूमे न्यस्तमुसले व्यङ्गारे भुक्तवज्जने।\nअतीते पात्रसंचारे भिक्षां लिप्सेत वै मुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2083412, "chapter_id": 2779, "verse_number": "१२-२८४-११", "content_sanskrit": "प्राणयात्रिकमात्रः स्यान्मात्रालाभेष्वनादृतः।\nअलाभे न विहन्येत लाभश्चैनं न हर्षयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2083413, "chapter_id": 2779, "verse_number": "१२-२८४-१२", "content_sanskrit": "लाभं साधारणां नेच्छेन्न भुञ्जीताभिपूजितः।\nअभिपूजितलाभं हि जुगुप्सेतैव तादृशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2083414, "chapter_id": 2779, "verse_number": "१२-२८४-१३", "content_sanskrit": "न चान्नदोषान्निन्देत न गुणानभिपूजयेत्।\nशय्यासने विविक्ते च नित्यमेवाभिपूजयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2083415, "chapter_id": 2779, "verse_number": "१२-२८४-१४", "content_sanskrit": "शून्यागारं वृक्षमूलमरण्यमथवा गुहाम्।\nअज्ञातचर्यां गत्वाऽन्यां ततोऽन्यत्रैव संविशेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2083416, "chapter_id": 2779, "verse_number": "१२-२८४-१५", "content_sanskrit": "अनुरोधविरोधाभ्यां समः स्यादचलो ध्रुवः।\nसुकृतं दुष्कृतं चोभे नानुरुध्येत कर्मणि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2083417, "chapter_id": 2779, "verse_number": "१२-२८४-१६", "content_sanskrit": "नित्यतृप्तः सुसंतृष्टः प्रसन्नवदनेन्द्रियः।\nविभीर्जप्यपरो मौनी वैराग्यं समुपाश्रितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2083418, "chapter_id": 2779, "verse_number": "१२-२८४-१७", "content_sanskrit": "अभ्यस्तं भौतिकं पश्यन्भूतानामागतिं गतिम्।\nविस्मितः सर्वदर्शी च पक्वापक्वेन वर्तयन्।\nआत्मारामः प्रशान्तात्मा लघ्वाहारो जितेन्द्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2083419, "chapter_id": 2779, "verse_number": "१२-२८४-१८", "content_sanskrit": "वाचो वेगं मनसः क्रोधवेगं\nहिंसावेगमुदरोपस्थवेगम्।\nएतान्वेगान्विनयेद्वै तपस्वी\nनिन्दा चास्य हृदयं नोपहन्यात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2083420, "chapter_id": 2779, "verse_number": "१२-२८४-१९", "content_sanskrit": "मध्यस्थ एव तिष्ठेत प्रशंसानिन्दयोः समः।\nएतत्पवित्रं परमं परिव्राजक आश्रयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2083421, "chapter_id": 2779, "verse_number": "१२-२८४-२०", "content_sanskrit": "महात्मा सर्वतो दान्तः सर्वत्रैवानपाश्रितः।\nअपूर्वचारकः सौम्यो ह्यनिकेतः समाहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2083422, "chapter_id": 2779, "verse_number": "१२-२८४-२१", "content_sanskrit": "वानप्रस्थगृहस्थाभ्यां न संसृज्येत कर्हिचित्।\nअज्ञातलिप्सं लिप्सेत न चैनं हर्ष आविशेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2083423, "chapter_id": 2779, "verse_number": "१२-२८४-२२", "content_sanskrit": "विजानतां मोक्ष एष श्रमः स्यादविजानताम्।\nमोक्षयानमिदं कृत्स्नं विदुषां हारितोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2083424, "chapter_id": 2779, "verse_number": "१२-२८४-२३", "content_sanskrit": "अभयं सर्वभूतेभ्यो दत्त्वा यः प्रव्रजेद्गृहात्।\nलोकास्तेजोमयास्तस्य तथाऽनन्त्याय कल्पते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2083425, "chapter_id": 2779, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि चतुरशीत्यधिकद्विशततमोऽध्यायः॥ २८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]