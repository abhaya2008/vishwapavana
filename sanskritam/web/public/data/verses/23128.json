[{"id": 7003128000, "chapter_id": 23128, "verse_number": "४-६४-१", "content_sanskrit": "अथ चतुःषष्टितमोऽध्यायः ।\nनारायण उवाच ।\nसर्व कृत्वा परामर्शं सत्यकश्च पुरोहितः ।\nबुद्धिमाञ्छुक्रशिष्यश्च तमुवाच हितं मुने ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003128001, "chapter_id": 23128, "verse_number": "४-६४-२", "content_sanskrit": "सत्यक उवाच ।\nभयं त्यज महाभाग भयं किं ते मयि स्थिते ।\nकुरु यागं महेशस्य मर्वारिष्टविनाशनम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003128002, "chapter_id": 23128, "verse_number": "४-६४-३", "content_sanskrit": "यागो धनुर्मखो नाम बह्वन्नो बहुदक्षिणः ।\nदुःशप्नानां नाशकरः शत्रुभीतिविनाशकः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003128003, "chapter_id": 23128, "verse_number": "४-६४-४", "content_sanskrit": "आध्यात्मिकमाधिदैवमाधिभौतिकमुत्कटम् ।\nएषां त्रिविधोत्पातानां खण्डनो भूतिवर्धंनः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003128004, "chapter_id": 23128, "verse_number": "४-६४-५", "content_sanskrit": "यागे समाप्ते शंभुश्च जरामृत्युहरं वरम् ।\nददाति साक्षाद्भवति दाता च सर्वसंपदाम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003128005, "chapter_id": 23128, "verse_number": "४-६४-६", "content_sanskrit": "चकारेमं च यागं च पुरा बाणो महाबलः ।\nनन्दी परशुरामश्च भल्लश्च बलिनां वरः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003128006, "chapter_id": 23128, "verse_number": "४-६४-७", "content_sanskrit": "पुरा ददौ धनुरिदं शिवो नन्दीश्वराय च ।\nयागेन भूत्वा सिद्धः स ददौ बाणाय धार्मिकः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003128007, "chapter_id": 23128, "verse_number": "४-६४-८", "content_sanskrit": "कृत्वा यागं महासिद्धो ददौ रामाय पुष्करे ।\nतुभ्यं ददौ परशुरामः कृपया च कृपानिधिः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003128008, "chapter_id": 23128, "verse_number": "४-६४-९", "content_sanskrit": "सहस्रहस्तपरिमितं दैर्ध्येऽतिकठिनं नृप ।\nदशहस्तप्रशस्तं च शंकरेच्छाविनिर्मितम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003128009, "chapter_id": 23128, "verse_number": "४-६४-१०", "content_sanskrit": "पशुपतेः पशुपतं युक्तयानेन दुर्वहम् ।\nसर्वे भङ्क्तुं न शक्ताश्च देवं नारायणं विना ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003128010, "chapter_id": 23128, "verse_number": "४-६४-११", "content_sanskrit": "यागे च धनुषः पूजां शंकरस्य तु शंकरे ।\nकुरु शीघ्रं शुभार्थं च सर्वान्कुरु निमन्त्रणम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003128011, "chapter_id": 23128, "verse_number": "४-६४-१२", "content_sanskrit": "अस्मिन्यागे धनुर्भङ्गो भवेद्यदि नराधिप ।\nविनाशो यजमानस्य भविष्यति न संशयः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003128012, "chapter_id": 23128, "verse_number": "४-६४-१३", "content_sanskrit": "भग्ने धनुषि यागश्च भग्नो भवति निश्चितम् ।\nफलं ददाति को वाऽत्र चानिष्पन्ने च कर्मणि ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003128013, "chapter_id": 23128, "verse_number": "४-६४-१४", "content_sanskrit": "ब्रह्मा च धनुषो मूले मध्ये नारायणः स्वयम् ।\nअग्रे चोग्रप्रतापश्च महादेवो महामते ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003128014, "chapter_id": 23128, "verse_number": "४-६४-१५", "content_sanskrit": "धनुर्हि त्रिविकारं च सद्रत्नखचितं वरम् ।\nग्रीष्ममध्याङ्नमार्तंण्डप्रभाप्रच्छन्नकारण् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003128015, "chapter_id": 23128, "verse_number": "४-६४-१६", "content_sanskrit": "अशक्तश्च नमयितुमनन्तश्च महाबलः ।\nसुर्यश्च कार्तिकेयश्च का कथाऽन्यस्य भूमिप ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003128016, "chapter_id": 23128, "verse_number": "४-६४-१७", "content_sanskrit": "त्रिपुरारिः पुराऽनेन जघान त्रिपुरं मुदा ।\nनिर्भयं कुरु स्वच्छन्दं मङ्गलार्ह महोत्सवम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003128017, "chapter_id": 23128, "verse_number": "४-६४-१८", "content_sanskrit": "मत्यकस्य वचः श्रुत्वा चन्द्रवंशविवर्धनः ।\nउवाच कंसः सर्वार्थे सततं च हितैषिणम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003128018, "chapter_id": 23128, "verse_number": "४-६४-१९", "content_sanskrit": "कंस उवाच ।\nवसुदेवगृहे जज्ञे मद्वधी कुरनाशनः ।\nस्वच्छन्दं नन्दगेहे च वर्धते नन्दनन्दनः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003128019, "chapter_id": 23128, "verse_number": "४-६४-२०", "content_sanskrit": "मद्वन्धुवर्गाञ्छूरांश्च मन्त्रिणः सुविशारदान् ।\nभगिनीं पूतनां पूतां जघान बालको बली ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003128020, "chapter_id": 23128, "verse_number": "४-६४-२१", "content_sanskrit": "गोवर्धनं दधार्रककरेण बलवर्धनः ।\nमहेन्द्रस्य च शूरस्य चकार च पराभवम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003128021, "chapter_id": 23128, "verse_number": "४-६४-२२", "content_sanskrit": "ब्रह्माणं दर्शयामास ब्रह्मरूपं चराचरम् ।\nनिवहं बारवत्सानां चकार कृत्रिमं मुदा ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003128022, "chapter_id": 23128, "verse_number": "४-६४-२३", "content_sanskrit": "तमेव बलिनं हन्तुं मन्त्रणां कुरु सत्यक ।\nमम शत्रुर्विना तेन नास्तिह धरणीतले ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003128023, "chapter_id": 23128, "verse_number": "४-६४-२४", "content_sanskrit": "नहि स्वर्गे न पाताले त्रिषु लोकेषु निश्चितम् ।\nसन्ति सन्तश्च राजानः सर्वत्र मम बान्धवाः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003128024, "chapter_id": 23128, "verse_number": "४-६४-२५", "content_sanskrit": "महातपस्वी ब्रह्मा च तपस्वीं शंकरः स्वयाम् ।\nविष्णुः सर्वत्र सर्वात्मा समदर्शो सनातनः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003128025, "chapter_id": 23128, "verse_number": "४-६४-२६", "content_sanskrit": "नन्दपुत्रं निहत्याहं त्रिषु लोकेषु पूजितः ।\nमार्वभौमो भविष्यामि सप्तद्वीपेश्वरो महान् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003128026, "chapter_id": 23128, "verse_number": "४-६४-२७", "content_sanskrit": "स्वर्गे निहत्य शक्रं च दुर्बलं दैत्यनिर्जितम् ।\nभविष्यामि महेन्द्रश्च तत्र निर्जित्य भास्करम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003128027, "chapter_id": 23128, "verse_number": "४-६४-२८", "content_sanskrit": "यक्ष्मग्रस्तं च चन्द्रं च ममैव पूर्वपूरुषम् ।\nवायुं कुबेरं वरुणं यमं जेष्यामि निश्चितम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003128028, "chapter_id": 23128, "verse_number": "४-६४-२९", "content_sanskrit": "गच्छ नन्दव्रजं शीघ्रं नन्दं च नन्दनन्दनम् ।\nतद्भ्रातरं च बलिनं बलमानय संप्रतम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003128029, "chapter_id": 23128, "verse_number": "४-६४-३०", "content_sanskrit": "कंसस्य वचनं श्रुत्वा तमुवाच स सत्यकः ।\nहितं सत्यं नीतिसारं परं सामयिकं तथा ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003128030, "chapter_id": 23128, "verse_number": "४-६४-३१", "content_sanskrit": "सत्यक उवाच ।\nअक्रूरमुद्धवं वाऽपि वसुदेवमथापि वा ।\nप्रस्थापय महाभाग नन्दव्रजमभीप्सितम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003128031, "chapter_id": 23128, "verse_number": "४-६४-३२", "content_sanskrit": "सत्यकस्य वचः श्रुत्वा वसन्तं तत्र संसदि ।\nस्वर्णसिंहासनस्थं च वसुदेवमुवाच सः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003128032, "chapter_id": 23128, "verse_number": "४-६४-३३", "content_sanskrit": "कंम उवाच ।\nतत्तवज्ञो नीतिशास्त्राणां त्वमुपायविशारदः ।\nव्रज नन्दव्रजं बन्धो वसुदेव मुतालयम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003128033, "chapter_id": 23128, "verse_number": "४-६४-३४", "content_sanskrit": "वृषभानं च नन्दं च बलं च नन्दनन्दनम् ।\nशीघ्रमानय यज्ञेऽत्र सर्वं गोकुलवासिनम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003128034, "chapter_id": 23128, "verse_number": "४-६४-३५", "content_sanskrit": "गृहीत्वा पत्रिकां दूता गच्छन्तु च चतुर्दिश्म् ।\nनृपान्मुनिगणान्सर्वान्कर्तुं विज्ञापनं मुदा ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003128035, "chapter_id": 23128, "verse_number": "४-६४-३६", "content_sanskrit": "नृपस्य वचनं श्रुत्वा शुष्ककण्ठोष्ठतालुकः ।\nउवाच वचनं ब्रह्मन् हृदयेन विदूषता ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003128036, "chapter_id": 23128, "verse_number": "४-६४-३७", "content_sanskrit": "वसुदेव उवाच ।\nनियुक्तमत्र राजेन्द्र गमनं मम सांप्रतम् ।\nविज्ञापितुं नन्दव्रजं नन्दं वा नन्दनन्दनम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003128037, "chapter_id": 23128, "verse_number": "४-६४-३८", "content_sanskrit": "यद्यायातो नन्दपुत्रो यागो ते च महोत्सवे ।\nअवश्यं तद्विरोधश्च भविष्यति त्वया सह ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003128038, "chapter_id": 23128, "verse_number": "४-६४-३९", "content_sanskrit": "तमहं च समानीय कारयिष्यामि संयुतम् ।\nइति मे न हि भद्रं च विध्नस्तस्य तवापि च ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003128039, "chapter_id": 23128, "verse_number": "४-६४-४०", "content_sanskrit": "पित्राऽऽनोतो मृतः कृष्ण इति सर्वो वदिष्यति ।\nवसुदेवः सुतद्वारा जघान नृपमेव च ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003128040, "chapter_id": 23128, "verse_number": "४-६४-४१", "content_sanskrit": "द्वयोरेकतरस्यापि सद्यो मृत्युर्भविष्यति ।\nपतिष्यन्ति च शूराश्च नास्ति युद्धं निरामिषम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003128041, "chapter_id": 23128, "verse_number": "४-६४-४२", "content_sanskrit": "वसुदेववचः श्रुत्वा रक्तपङ्कचलोचनः ।\nखड्गं गृहीत्वा तं हन्तुं प्रययौ नृपतीश्वरः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003128042, "chapter_id": 23128, "verse_number": "४-६४-४३", "content_sanskrit": "हाहेति कृत्वा पुत्रं च वारयामास तत्क्षणम् ।\nउग्रसेनो महाराजमतीव बलवान्मुने ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003128043, "chapter_id": 23128, "verse_number": "४-६४-४४", "content_sanskrit": "स्वपीठाद्वसुदेवश्च कोपाविष्टो गृहं ययौ ।\nअक्रूरं प्रेरयामास गन्तुं नन्दव्रजं नृपः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003128044, "chapter_id": 23128, "verse_number": "४-६४-४५", "content_sanskrit": "दूतान्प्रस्थापयामास शीघ्रं प्रतिदिशं तथा ।\nआययुर्मुनयः सर्वे नृपश्च सपरिच्छदा ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003128045, "chapter_id": 23128, "verse_number": "४-६४-४६", "content_sanskrit": "दिक्पालाश्च सुराः सर्वे ब्राह्मणाश्च तपस्विनः ।\nसनकश्च सनन्दश्च वोढुः पञ्चशिखस्तथा ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003128046, "chapter_id": 23128, "verse_number": "४-६४-४७", "content_sanskrit": "सनत्कुमारो भगवान्प्रज्वलन्ब्रह्मतेजसा ।\nकपिलश्चासुरिः पैलः सुमन्तुश्च सनातनः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003128047, "chapter_id": 23128, "verse_number": "४-६४-४८", "content_sanskrit": "पुलहश्च पुलस्त्यश्च भृसुश्च क्रतुरङ्गिराः ।\nमरीचिः कश्यपश्चैव दक्षोऽत्रिश्च्यवनस्तथा ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003128048, "chapter_id": 23128, "verse_number": "४-६४-४९", "content_sanskrit": "भरद्वाजश्च व्यासश्च गौतमश्च पराशरः ।\nप्रचेताश्च वसिष्ठश्च संवर्तश्च बृहस्पतिः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003128049, "chapter_id": 23128, "verse_number": "४-६४-५०", "content_sanskrit": "कात्यायनो याज्ञवल्क्योऽप्युत्तङ्कः सौभरिस्तथा ।\nपर्वतो देवलश्चैव जैगीषव्यश्च जैमिनिः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003128050, "chapter_id": 23128, "verse_number": "४-६४-५१", "content_sanskrit": "विश्वामित्रश्च सुतपाः पिप्पलः शाकटायनः ।\nजाबालिर्जाङ्गलिश्चैव पिशलिश्च शिलालिकः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003128051, "chapter_id": 23128, "verse_number": "४-६४-५२", "content_sanskrit": "आस्तौकश्च जगत्कारुस्तथा कल्याणमित्रकः ।\nदुर्वासा वामदेवश्च ऋष्यश्रृङ्गो विभाण्डकः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003128052, "chapter_id": 23128, "verse_number": "४-६४-५३", "content_sanskrit": "पथिः कविः कणादश्च गौशिकः पाणिनिस्तथा ।\nकौत्सोऽद्यमर्षणश्चैव वाल्मीकिर्लोमहर्षणः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003128053, "chapter_id": 23128, "verse_number": "४-६४-५४", "content_sanskrit": "मार्कणडेयो मृकण्डुश्च पर्शुरामश्च सांकृतिः ।\nअगस्त्यश्च तथा वान्तस्तथाऽन्ये मुनयो मुने ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003128054, "chapter_id": 23128, "verse_number": "४-६४-५५", "content_sanskrit": "सशिष्याश्च सपुत्राश्च ब्राह्मणाश्च तपस्विनः ।\nजरासंधो दन्तवक्रो दाम्भिको द्रविडाधिपः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003128055, "chapter_id": 23128, "verse_number": "४-६४-५६", "content_sanskrit": "शिशुपालो भीष्मकश्च भगदत्तश्च मुद्गलः ।\nधार्तराष्ट्रो धूमकेशो धूम्रकेतुश्च शम्बरः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003128056, "chapter_id": 23128, "verse_number": "४-६४-५७", "content_sanskrit": "शल्यः सत्राजितः शङ्कुर्नृपाश्चान्ये महाबलाः ।\nभीष्मो द्रोणः कृपाचार्यो ह्यश्वत्थामा महाबलाः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003128057, "chapter_id": 23128, "verse_number": "४-६४-५८", "content_sanskrit": "भूरिश्रवाश्च शाल्वश्च कैकेयः कौशलस्तथा ।\nसर्वान्संभाषयामास महाराजो यथोचितम् ।\nसत्यको यज्ञदिवसे चकार च शुभक्षणम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}]