[{"id": 2105442, "chapter_id": 3275, "verse_number": "१६-४-१", "content_sanskrit": "युधिष्ठिर उवाच।\nन मां प्रीणयते राज्यं त्वय्येवं दुःखिते नृप।\nदिङ्मामस्तु सुदुर्बुद्धिं राज्यसक्तं प्रमादिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2105443, "chapter_id": 3275, "verse_number": "१६-४-२", "content_sanskrit": "गृहे वसन्तं दुःखार्तमुपवासकृशं भृशम्।\nयताहारं क्षितिशयं नाविदं भ्रातृभिः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2105444, "chapter_id": 3275, "verse_number": "१६-४-३", "content_sanskrit": "अहोस्मि वञ्चितो मूढो भवता गूढबुद्धिना।\nविस्वासयित्वा पूर्वं मां यदिदं दुःखमश्नुथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2105445, "chapter_id": 3275, "verse_number": "१६-४-४", "content_sanskrit": "किं मे राज्येन भोगैर्वा किं यज्ञैः किं सुखेन वा।\nयस्य मे त्वं महीपाल दुखान्येतान्यवाप्तवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2105446, "chapter_id": 3275, "verse_number": "१६-४-५", "content_sanskrit": "पीडितं चापि जानामि राज्यमात्मानमेव च।\nअनेन वचसा तेऽद्य दुःखितस्य जनेश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2105447, "chapter_id": 3275, "verse_number": "१६-४-६", "content_sanskrit": "भवान्पिता भवान्माता भवान्नः परमो गुरुः।\nभवता विप्रहीणा वै क्वनु तिष्ठामहे वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2105448, "chapter_id": 3275, "verse_number": "१६-४-७", "content_sanskrit": "औरसो भवतः पुत्रो युयुत्सुर्नृपसत्तम।\nअस्तु राजा महाराज यमन्यं मन्यते भवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2105449, "chapter_id": 3275, "verse_number": "१६-४-८", "content_sanskrit": "अहं वनं गमिष्यामि भवान्राजा प्रशास्त्विदम्।\nनमामयशसा दग्धं भूयस्त्वं दग्धुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2105450, "chapter_id": 3275, "verse_number": "१६-४-९", "content_sanskrit": "नाहं राजा भवान्राजा भवता परवानहम्।\nकथं गुरुं त्वां धर्मज्ञमनुज्ञातुमिहोत्सहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2105451, "chapter_id": 3275, "verse_number": "१६-४-१०", "content_sanskrit": "न मन्युर्हृदि नः कश्चित्सुयोधनकृतेऽनघ।\nभवितव्यं तथा तद्धि वयं चान्ये च मोहिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2105452, "chapter_id": 3275, "verse_number": "१६-४-११", "content_sanskrit": "वयं पुत्रा हि भवोत यथा दुर्योधनादयः।\nगान्धारी चैव कुन्ती च निर्विशेषे मते मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2105453, "chapter_id": 3275, "verse_number": "१६-४-१२", "content_sanskrit": "स मां त्वं यदि राजेन्द्र परित्यज्य गमिष्यसि।\nपृष्ठतस्त्वनुयास्यामि सत्यमात्मानमालभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2105454, "chapter_id": 3275, "verse_number": "१६-४-१३", "content_sanskrit": "इयं हि वसुसंपूर्णा मही सागरमेखला।\nभवता विप्रहीणस्य न मे प्रीतिकरी भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2105455, "chapter_id": 3275, "verse_number": "१६-४-१४", "content_sanskrit": "भवदीयमिदं सर्वं शिरसा त्वां प्रसादये।\nत्वदधीनाः स्म राजेन्द्र व्येतु ते मानसो ज्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2105456, "chapter_id": 3275, "verse_number": "१६-४-१५", "content_sanskrit": "भवितव्यमनुप्राप्तो मन्ये त्वं वसुधाधिप।\nदिष्ट्या शुश्रूषमाणस्त्वां मोक्षिष्ये मनसो ज्वरं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2105457, "chapter_id": 3275, "verse_number": "१६-४-१६x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2105458, "chapter_id": 3275, "verse_number": "१६-४-१६", "content_sanskrit": "तापस्ये मे मनस्तात वर्तते कुरुनन्दन।\nउचितं च कुलेऽस्माकमरण्यगमनं प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2105459, "chapter_id": 3275, "verse_number": "१६-४-१७", "content_sanskrit": "चिरमध्युषितः पुत्र चिरं शुश्रूषितस्त्वया।\nवृद्धं मामप्यनुज्ञातुमर्हसि त्वं नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2105460, "chapter_id": 3275, "verse_number": "१६-४-१८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2105461, "chapter_id": 3275, "verse_number": "१६-४-१८", "content_sanskrit": "इत्युक्त्वा धर्मराजानं वेपमानं कृताञ्जलिम्।\nउवाच विदुरं राजा धृतराष्ट्रोंऽबिकासुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2105462, "chapter_id": 3275, "verse_number": "१६-४-१९", "content_sanskrit": "संजयं च महात्मानं कृपं चापि महारथम्।\nअनुनेतुमिहेच्छामि भवद्भिर्वसुधाधिपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2105463, "chapter_id": 3275, "verse_number": "१६-४-२०", "content_sanskrit": "म्लायते मे मनो हीदं मुखं च परिशुष्यति।\nवयसा च प्रकृष्टेन वाग्व्यायामेन चैव ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2105464, "chapter_id": 3275, "verse_number": "१६-४-२१", "content_sanskrit": "इत्युक्त्वा स तु धर्मात्मा वृद्धो राजा कुरूद्वहः।\nगान्धारीं शिश्रिये धीमान्सहसैव गतासुवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2105465, "chapter_id": 3275, "verse_number": "१६-४-२२", "content_sanskrit": "तं तु दृष्ट्वा समासीनं विसंज्ञमिव कौरवम्।\nआर्तिं राजाऽगमत्तीव्रां कौन्तेयः परवीरहा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2105466, "chapter_id": 3275, "verse_number": "१६-४-२३x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2105467, "chapter_id": 3275, "verse_number": "१६-४-२३", "content_sanskrit": "यस्य नागसहस्रेण शतसङ्ख्येन वै बलम्।\nसोयं नारीं व्यपाश्रित्य शेते राजा गतासुवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2105468, "chapter_id": 3275, "verse_number": "१६-४-२४", "content_sanskrit": "आयसी प्रतिमा येन भीमसेनस्य सा पुरा।\nचूर्णीकृता बलवता सोबलामाश्रितः स्त्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2105469, "chapter_id": 3275, "verse_number": "१६-४-२५", "content_sanskrit": "धिगस्तु मामधर्मज्ञं धिग्बुद्धिं धिक्च मे श्रुतम्।\nयत्कृते पृथिवीपालः शेतेऽयमतथोचितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2105470, "chapter_id": 3275, "verse_number": "१६-४-२६", "content_sanskrit": "अहमप्युपवत्स्यामि यथैवायं गुरुर्मम।\nयदि राजा न भुङ्क्तेऽयं गान्धारी च यशस्विनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2105471, "chapter_id": 3275, "verse_number": "१६-४-२७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2105472, "chapter_id": 3275, "verse_number": "१६-४-२७", "content_sanskrit": "ततोस्य पाणिना राजञ्जलशीतेन पाण्डवः।\nउरो मुखं च शनकैः पर्यमार्जत धर्मवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2105473, "chapter_id": 3275, "verse_number": "१६-४-२८", "content_sanskrit": "तेन रत्नौषधिमता पुण्येन च सुगन्धिना।\nपाणिस्पर्शेन राज्ञः स राजा संज्ञामवाप ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2105474, "chapter_id": 3275, "verse_number": "१६-४-२९", "content_sanskrit": "स्पृशन्तं पाणिना भूयः परिष्यज्य च पाण्डवम्।\n`उवाच राजा धर्मज्ञो धृतराष्ट्रः शुभं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2105475, "chapter_id": 3275, "verse_number": "१६-४-३०", "content_sanskrit": "जीवामीवातिसंस्पर्शात्तव राजीवलोचन।\nमूर्धानं च तवाघ्रातुमिच्छामि मनुजाधिप।\nपाणिभ्यां हि परिस्प्रष्टुं प्राणानां हितमात्मनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2105476, "chapter_id": 3275, "verse_number": "१६-४-३१", "content_sanskrit": "अष्टमो ह्यद्य कालोऽयमाहारस्य कृतस्य मे।\nयेनाहं कुरुशार्दूल शक्नोमि न विचेष्टितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2105477, "chapter_id": 3275, "verse_number": "१६-४-३२", "content_sanskrit": "व्यायामश्चायमत्यर्थं कृतस्त्वामभियाचता।\nततो ग्लानमनास्तान नष्टसंज्ञ इवाभवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2105478, "chapter_id": 3275, "verse_number": "१६-४-३३", "content_sanskrit": "तवामृतसुखस्पर्शं हस्तस्पर्शमिमं प्रभो।\nलब्ध्वा संजीवितोस्मीति मन्ये कुरुकुलोद्वह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2105479, "chapter_id": 3275, "verse_number": "१६-४-३४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2105480, "chapter_id": 3275, "verse_number": "१६-४-३४", "content_sanskrit": "एवमुक्तस्तु कौन्तेयः पित्रा ज्येष्ठेन भारत।\nपस्पर्श सर्वगात्रेषु स्नेहार्द्रस्तं शनैस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2105481, "chapter_id": 3275, "verse_number": "१६-४-३५", "content_sanskrit": "उपलभ्य ततः प्राणान्धृतराष्ट्रो महीपतिः।\nबाहुभ्यां सम्परिष्वज्य मूर्ध्न्याजिघ्रत पाण्डवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2105482, "chapter_id": 3275, "verse_number": "१६-४-३६", "content_sanskrit": "विदुरादयश्च ते सर्वे रुरुदुर्दुःखिता भृशम्।\nअतिदुःखात्तु राजानं नोचुः किञ्चन पाण्डवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2105483, "chapter_id": 3275, "verse_number": "१६-४-३७", "content_sanskrit": "गान्धारी त्वेव धर्मज्ञा मनसोद्वहती भृशम्।\nदुःखान्यधारयद्राजन्मैवमित्येव चाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2105484, "chapter_id": 3275, "verse_number": "१६-४-३८", "content_sanskrit": "इतरास्तु स्त्रियः सर्वाः कुन्त्या सह सुदःखिताः।\nनेत्रैरागतविक्लेदैः परिवार्य स्थिताऽभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2105485, "chapter_id": 3275, "verse_number": "१६-४-३९", "content_sanskrit": "अथाब्रवीत्पुनर्वाक्यं धृतराष्ट्रो युधिष्ठिरम्।\nअनुजानीहि मां राजंस्तापस्ये भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2105486, "chapter_id": 3275, "verse_number": "१६-४-४०", "content_sanskrit": "ग्लायते मे मनस्तात भूयोभूयः प्रजल्पतः।\nन मामतः परं पुत्र परिक्लेष्टुमिहार्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2105487, "chapter_id": 3275, "verse_number": "१६-४-४१", "content_sanskrit": "तस्मिंस्तु कौरवेन्द्रे तं तथा ब्रुवति पाण्डवम्।\nसर्वेषामवरोधानामार्तनादो महानभूत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2105488, "chapter_id": 3275, "verse_number": "१६-४-४२", "content_sanskrit": "दृष्ट्वा कृशं विवर्णं च राजानमतथोचितम्॥\nउपवासपरिश्रान्तं त्वगस्थिपरिवारितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2105489, "chapter_id": 3275, "verse_number": "१६-४-४३", "content_sanskrit": "धर्मपुत्रः स्वपितरं परिष्वज्य महाप्रभुम्।\nशोकजं बाष्पमुत्सृज्यि पुनर्वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2105490, "chapter_id": 3275, "verse_number": "१६-४-४४", "content_sanskrit": "न कामये नरश्रेष्ठ जीवितं पृथिवीं तथा।\nयथा तव प्रियं राजंश्चिकीर्षामि परंतप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2105491, "chapter_id": 3275, "verse_number": "१६-४-४५", "content_sanskrit": "यदि चाहमनुग्राह्यो भवतो दयितोऽपि वा।\nक्रियतां तावदाहारस्ततो वेत्स्याम्यहं परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2105492, "chapter_id": 3275, "verse_number": "१६-४-४६", "content_sanskrit": "ततोऽब्रवीन्महातेजा धृतराष्ट्रो युधिष्ठिरम्।\nअनुज्ञातस्त्वया पुत्र भुञ्जीयामिति कामये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2105493, "chapter_id": 3275, "verse_number": "१६-४-४७", "content_sanskrit": "इति ब्रुवति राजेन्द्रे धृतराष्ट्रे युधिष्ठिरम्।\nऋषिः सत्यवतीपुत्रो व्यासोऽभ्योत्य वचोऽब्रवीत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2105494, "chapter_id": 3275, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्रमवासिकपर्वणि आश्रमिवासपर्वणि चतुर्थोऽध्यायः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]