[{"id": 5000533000, "chapter_id": 9533, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे षड्विंशत्यधिकशततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000533001, "chapter_id": 9533, "verse_number": "६-१२६-१", "content_sanskrit": "बहूनि नाम वर्षाणि गतस्य सुमहद्वनम्।\nशृणोम्यहं प्रीतिकरं मम नाथस्य कीर्तनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000533002, "chapter_id": 9533, "verse_number": "६-१२६-२", "content_sanskrit": "कल्याणी बत गाथेयं लौकिकी प्रतिभाति माम्।\nएति जीवन्तमानन्दो नरं वर्षशतादपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000533003, "chapter_id": 9533, "verse_number": "६-१२६-३", "content_sanskrit": "राघवस्य हरीणां च कथमासीत् समागमः।\nकस्मिन् देशे किमाश्रित्य तत्त्वमाख्याहि पृच्छतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000533004, "chapter_id": 9533, "verse_number": "६-१२६-४", "content_sanskrit": "स पृष्टो राजपुत्रेण बृस्यां समुपवेशितः।\nआचचक्षे ततः सर्वं रामस्य चरितं वने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000533005, "chapter_id": 9533, "verse_number": "६-१२६-५", "content_sanskrit": "यथा प्रव्राजितो रामो मातुर्दत्तौ वरौ तव।\nयथा च पुत्रशोकेन राजा दशरथो मृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000533006, "chapter_id": 9533, "verse_number": "६-१२६-६", "content_sanskrit": "यथा दूतैस्त्वमानीतस्तूर्णं राजगृहात् प्रभो।\nत्वयायोध्यां प्रविष्टेन यथा राज्यं न चेप्सितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000533007, "chapter_id": 9533, "verse_number": "६-१२६-७", "content_sanskrit": "चित्रकूटगिरिं गत्वा राज्येनामित्रकर्शनः।\nनिमन्त्रितस्त्वया भ्राता धर्ममाचरता सताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000533008, "chapter_id": 9533, "verse_number": "६-१२६-८", "content_sanskrit": "स्थितेन राज्ञो वचने यथा राज्यं विसर्जितम्।\nआर्यस्य पादुके गृह्य यथासि पुनरागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000533009, "chapter_id": 9533, "verse_number": "६-१२६-९", "content_sanskrit": "सर्वमेतन्महाबाहो यथावद् विदितं तव।\nत्वयि प्रतिप्रयाते तु यद् वृत्तं तन्निबोध मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000533010, "chapter_id": 9533, "verse_number": "६-१२६-१०", "content_sanskrit": "अपयाते त्वयि तदा समुद‍्भ्रान्तमृगद्विजम्।\nपरिद्यूनमिवात्यर्थं तद् वनं समपद्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000533011, "chapter_id": 9533, "verse_number": "६-१२६-११", "content_sanskrit": "तद्धस्तिमृदितं घोरं सिंहव्याघ्रमृगाकुलम्।\nप्रविवेशाथ विजनं स महद् दण्डकावनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000533012, "chapter_id": 9533, "verse_number": "६-१२६-१२", "content_sanskrit": "तेषां पुरस्ताद् बलवान् गच्छतां गहने वने।\nविनदन् सुमहानादं विराधः प्रत्यदृश्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000533013, "chapter_id": 9533, "verse_number": "६-१२६-१३", "content_sanskrit": "तमुत्क्षिप्य महानादमूर्ध्वबाहुमधोमुखम्।\nनिखाते प्रक्षिपन्ति स्म नदन्तमिव कुञ्जरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000533014, "chapter_id": 9533, "verse_number": "६-१२६-१४", "content_sanskrit": "तत् कृत्वा दुष्करं कर्म भ्रातरौ रामलक्ष्मणौ।\nसायाह्ने शरभङ्गस्य रम्यमाश्रममीयतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000533015, "chapter_id": 9533, "verse_number": "६-१२६-१५", "content_sanskrit": "शरभङ्गे दिवं प्राप्ते रामः सत्यपराक्रमः।\nअभिवाद्य मुनीन् सर्वाञ्जनस्थानमुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000533016, "chapter_id": 9533, "verse_number": "६-१२६-१६", "content_sanskrit": "पश्चाच्छूर्पणखा नाम रामपार्श्वमुपागता।\nततो रामेण संदिष्टो लक्ष्मणः सहसोत्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000533017, "chapter_id": 9533, "verse_number": "६-१२६-१७", "content_sanskrit": "प्रगृह्य खड्गं चिच्छेद कर्णनासं महाबलः।\nचतुर्दश सहस्राणि रक्षसां भीमकर्मणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000533018, "chapter_id": 9533, "verse_number": "६-१२६-१८", "content_sanskrit": "हतानि वसता तत्र राघवेण महात्मना।\nएकेन सह संगम्य रामेण रणमूर्धनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000533019, "chapter_id": 9533, "verse_number": "६-१२६-१९", "content_sanskrit": "अह्नश्चतुर्थभागेन निःशेषा राक्षसाः कृताः।\nमहाबला महावीर्यास्तपसो विघ्नकारिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000533020, "chapter_id": 9533, "verse_number": "६-१२६-२०", "content_sanskrit": "निहता राघवेणाजौ दण्डकारण्यवासिनः।\nराक्षसाश्च विनिष्पिष्टाः खरश्च निहतो रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000533021, "chapter_id": 9533, "verse_number": "६-१२६-२१", "content_sanskrit": "दूषणं चाग्रतो हत्वा त्रिशिरास्तदनन्तरम्।\nततस्तेनार्दिता बाला रावणं समुपागता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000533022, "chapter_id": 9533, "verse_number": "६-१२६-२२", "content_sanskrit": "रावणानुचरो घोरो मारीचो नाम राक्षसः।\nलोभयामास वैदेहीं भूत्वा रत्नमयो मृगः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000533023, "chapter_id": 9533, "verse_number": "६-१२६-२३", "content_sanskrit": "सा राममब्रवीद् दृष्ट्वा वैदेही गृह्यतामिति।\nअयं मनोहरः कान्त आश्रमो नो भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000533024, "chapter_id": 9533, "verse_number": "६-१२६-२४", "content_sanskrit": "ततो रामो धनुष्पाणिर्मृगं तमनुधावति।\nस तं जघान धावन्तं शरेणानतपर्वणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000533025, "chapter_id": 9533, "verse_number": "६-१२६-२५", "content_sanskrit": "अथ सौम्य दशग्रीवो मृगं याति तु राघवे।\nलक्ष्मणे चापि निष्क्रान्ते प्रविवेशाश्रमं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000533026, "chapter_id": 9533, "verse_number": "६-१२६-२६", "content_sanskrit": "जग्राह तरसा सीतां ग्रहः खे रोहिणीमिव।\nत्रातुकामं ततो युद्धे हत्वा गृध्रं जटायुषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000533027, "chapter_id": 9533, "verse_number": "६-१२६-२७", "content_sanskrit": "प्रगृह्य सहसा सीतां जगामाशु स राक्षसः।\nततस्त्वद्भुतसंकाशाः स्थिताः पर्वतमूर्धनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000533028, "chapter_id": 9533, "verse_number": "६-१२६-२८", "content_sanskrit": "सीतां गृहीत्वा गच्छन्तं वानराः पर्वतोपमाः।\nददृशुर्विस्मिताकारा रावणं राक्षसाधिपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000533029, "chapter_id": 9533, "verse_number": "६-१२६-२९", "content_sanskrit": "ततः शीघ्रतरं गत्वा तद् विमानं मनोजवम्।\nआरुह्य सह वैदेह्या पुष्पकं स महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000533030, "chapter_id": 9533, "verse_number": "६-१२६-३०", "content_sanskrit": "प्रविवेश तदा लङ्कां रावणो राक्षसेश्वरः।\nतां सुवर्णपरिष्कारे शुभे महति वेश्मनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000533031, "chapter_id": 9533, "verse_number": "६-१२६-३१", "content_sanskrit": "प्रवेश्य मैथिलीं वाक्यैः सान्त्वयामास रावणः।\nतृणवद् भाषितं तस्य तं च नैर्ऋतपुङ्गवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000533032, "chapter_id": 9533, "verse_number": "६-१२६-३२", "content_sanskrit": "अचिन्तयन्ती वैदेही ह्यशोकवनिकां गता।\nन्यवर्तत तदा रामो मृगं हत्वा तदा वने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000533033, "chapter_id": 9533, "verse_number": "६-१२६-३३", "content_sanskrit": "निवर्तमानः काकुत्स्थो दृष्ट्वा गृध्रं स विव्यथे।\nगृध्रं हतं तदा दृष्ट्वा रामः प्रियतरं पितुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000533034, "chapter_id": 9533, "verse_number": "६-१२६-३४", "content_sanskrit": "मार्गमाणस्तु वैदेहीं राघवः सहलक्ष्मणः।\nगोदावरीमनुचरन् वनोद्देशांश्च पुष्पितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000533035, "chapter_id": 9533, "verse_number": "६-१२६-३५", "content_sanskrit": "आसेदतुर्महारण्ये कबन्धं नाम राक्षसम्।\nततः कबन्धवचनाद् रामः सत्यपराक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000533036, "chapter_id": 9533, "verse_number": "६-१२६-३६", "content_sanskrit": "ऋष्यमूकगिरिं गत्वा सुग्रीवेण समागतः।\nतयोः समागमः पूर्वं प्रीत्या हार्दो व्यजायत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000533037, "chapter_id": 9533, "verse_number": "६-१२६-३७", "content_sanskrit": "भ्रात्रा निरस्तः क्रुद्धेन सुग्रीवो वालिना पुरा।\nइतरेतरसंवादात् प्रगाढः प्रणयस्तयोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000533038, "chapter_id": 9533, "verse_number": "६-१२६-३८", "content_sanskrit": "रामः स्वबाहुवीर्येण स्वराज्यं प्रत्यपादयत्।\nवालिनं समरे हत्वा महाकायं महाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000533039, "chapter_id": 9533, "verse_number": "६-१२६-३९", "content_sanskrit": "सुग्रीवः स्थापितो राज्ये सहितः सर्ववानरैः।\nरामाय प्रतिजानीते राजपुत्र्यास्तु मार्गणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000533040, "chapter_id": 9533, "verse_number": "६-१२६-४०", "content_sanskrit": "आदिष्टा वानरेन्द्रेण सुग्रीवेण महात्मना।\nदश कोट्यः प्लवङ्गानां सर्वाः प्रस्थापिता दिशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000533041, "chapter_id": 9533, "verse_number": "६-१२६-४१", "content_sanskrit": "तेषां नो विप्रकृष्टानां विन्ध्ये पर्वतसत्तमे।\nभृशं शोकाभितप्तानां महान् कालोऽत्यवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000533042, "chapter_id": 9533, "verse_number": "६-१२६-४२", "content_sanskrit": "भ्राता तु गृध्रराजस्य सम्पातिर्नाम वीर्यवान्।\nसमाख्याति स्म वसतीं सीतां रावणमन्दिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000533043, "chapter_id": 9533, "verse_number": "६-१२६-४३", "content_sanskrit": "सोऽहं दुःखपरीतानां दुःखं तज्ज्ञातिनां नुदन्।\nआत्मवीर्यं समास्थाय योजनानां शतं प्लुतः।\nतत्राहमेकामद्राक्षमशोकवनिकां गताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000533044, "chapter_id": 9533, "verse_number": "६-१२६-४४", "content_sanskrit": "कौशेयवस्त्रां मलिनां निरानन्दां दृढव्रताम्।\nतया समेत्य विधिवत् पृष्ट्वा सर्वमनिन्दिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000533045, "chapter_id": 9533, "verse_number": "६-१२६-४५", "content_sanskrit": "अभिज्ञानं मया दत्तं रामनामाङ्गुलीयकम्।\nअभिज्ञानं मणिं लब्ध्वा चरितार्थोऽहमागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000533046, "chapter_id": 9533, "verse_number": "६-१२६-४६", "content_sanskrit": "मया च पुनरागम्य रामस्याक्लिष्टकर्मणः।\nअभिज्ञानं मया दत्तमर्चिष्मान् स महामणिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000533047, "chapter_id": 9533, "verse_number": "६-१२६-४७", "content_sanskrit": "श्रुत्वा तां मैथिलीं रामस्त्वाशशंसे च जीवितम्।\nजीवितान्तमनुप्राप्तः पीत्वामृतमिवातुरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000533048, "chapter_id": 9533, "verse_number": "६-१२६-४८", "content_sanskrit": "उद्योजयिष्यन्नुद्योगं दध्रे लङ्कावधे मनः।\nजिघांसुरिव लोकान्ते सर्वाँल्लोकान् विभावसुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000533049, "chapter_id": 9533, "verse_number": "६-१२६-४९", "content_sanskrit": "ततः समुद्रमासाद्य नलं सेतुमकारयत्।\nअतरत् कपिवीराणां वाहिनी तेन सेतुना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000533050, "chapter_id": 9533, "verse_number": "६-१२६-५०", "content_sanskrit": "प्रहस्तमवधीन्नीलः कुम्भकर्णं तु राघवः।\nलक्ष्मणो रावणसुतं स्वयं रामस्तु रावणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000533051, "chapter_id": 9533, "verse_number": "६-१२६-५१", "content_sanskrit": "स शक्रेण समागम्य यमेन वरुणेन च।\nमहेश्वरस्वयंभूभ्यां तथा दशरथेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000533052, "chapter_id": 9533, "verse_number": "६-१२६-५२", "content_sanskrit": "तैश्च दत्तवरः श्रीमानृषिभिश्च समागतैः।\nसुरर्षिभिश्च काकुत्स्थो वराँल्लेभे परंतपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000533053, "chapter_id": 9533, "verse_number": "६-१२६-५३", "content_sanskrit": "स तु दत्तवरः प्रीत्या वानरैश्च समागतैः।\nपुष्पकेण विमानेन किष्किन्धामभ्युपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000533054, "chapter_id": 9533, "verse_number": "६-१२६-५४", "content_sanskrit": "तां गङ्गां पुनरासाद्य वसन्तं मुनिसंनिधौ।\nअविघ्नं पुष्ययोगेन श्वो रामं द्रष्टुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000533055, "chapter_id": 9533, "verse_number": "६-१२६-५५", "content_sanskrit": "ततः स वाक्यैर्मधुरैर्हनूमतो\nनिशम्य हृष्टो भरतः कृताञ्जलिः।\nउवाच वाणीं मनसः प्रहर्षिणीं\nचिरस्य पूर्णः खलु मे मनोरथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 5000533056, "chapter_id": 9533, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे षड्विंशत्यधिकशततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]