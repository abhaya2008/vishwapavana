[{"id": 40017687, "chapter_id": 9267, "verse_number": "1", "content_sanskrit": "निर्गतंमकराक्षंतेदृष्टवावानरपुङ्गवाः । आप्लुत्यसहसासर्वेयोद्धुकामाव्यवस्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40017688, "chapter_id": 9267, "verse_number": "2", "content_sanskrit": "ततःप्रवृत्तंसुमहत्तद्युद्धंरोमहर्षणम् । निशाचरैःप्लवङ्गानांदेवानांदानवैरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40017689, "chapter_id": 9267, "verse_number": "3", "content_sanskrit": "वृक्षशूलनिपातैश्चशिलापरिघपातनैः । अन्योन्यंमर्दयन्तिस्मतदाकपिनिशाचराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40017690, "chapter_id": 9267, "verse_number": "4", "content_sanskrit": "शक्तिखडगगदाकुन्तैस्तोमरैश्चनिशाचराः । पट्टसैर्भिण्ढिपालैश्चबाणपातैःसमन्ततः ॥ पाशमुद्गरदण्डैश्चनिखातैश्चापरेस्तथा । कदनंकपिसिंहानांचक्रुस्तेरजनीचराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40017691, "chapter_id": 9267, "verse_number": "5", "content_sanskrit": "शक्तिखडगगदाकुन्तैस्तोमरैश्चनिशाचराः । पट्टसैर्भिण्ढिपालैश्चबाणपातैःसमन्ततः ॥ पाशमुद्गरदण्डैश्चनिखातैश्चापरेस्तथा । कदनंकपिसिंहानांचक्रुस्तेरजनीचराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40017692, "chapter_id": 9267, "verse_number": "6", "content_sanskrit": "बाणौघैरर्दिताश्चापिखरपुत्रेणवानराः । सम्भ्रान्तमनसस्सर्वेदुद्रुवुर्भयपीडिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40017693, "chapter_id": 9267, "verse_number": "7", "content_sanskrit": "तान्दृष्टवाराक्षसास्सर्वेद्रवमाणान्वलीमुखान् । नेदुस्तेसिम्हवद्दृष्टाराक्षसाजितकाशिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40017694, "chapter_id": 9267, "verse_number": "8", "content_sanskrit": "विद्रवत्सुतदातेषुवानरेषुसमन्ततः । रामस्तान्वारमायासशरवर्षेणराक्षसान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40017695, "chapter_id": 9267, "verse_number": "9", "content_sanskrit": "रितान्राक्षसान्दृष्टवामकराक्षोनिशाचरः । क्रोधानलसमाविष्टोवचनंचेदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40017696, "chapter_id": 9267, "verse_number": "10", "content_sanskrit": "तिष्ठराम मयासार्धंद्वन्द्वयुद्धंददामिते । त्याजयिष्यामितेप्राणान् धनुर्मुक्सैशशितैश्शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40017697, "chapter_id": 9267, "verse_number": "11", "content_sanskrit": "यत्तदादण्डकारण्येपितरंहतवान्मम । तदग्रतःस्वकर्मस्थंदृष्टवारोषोऽभिवर्धते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40017698, "chapter_id": 9267, "verse_number": "12", "content_sanskrit": "दह्यन्तेधृशमङ्गानिदुरात्मन्ममराघव । यन्मयासि न दृष्टस्त्वंतस्मिन् कालेमहावने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40017699, "chapter_id": 9267, "verse_number": "13", "content_sanskrit": "दिष्ट्यासिदर्शनंराम ममत्वंप्राप्तवानिह । काङ्क्षितोऽसिक्षुधार्तस्यसिंहस्येवेतरोमृगः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40017700, "chapter_id": 9267, "verse_number": "14", "content_sanskrit": "अद्यमद्बाणवेगेनप्रेतराडिवषयंगतः । येत्वयानिहताःशूराःसहतैश्चसमेष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40017701, "chapter_id": 9267, "verse_number": "15", "content_sanskrit": "बहुनात्रकिमुक्तेनशृणुराम वचोमम । पश्यन्तुसकलालोकास्त्वा, मांचैवरणाजिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40017702, "chapter_id": 9267, "verse_number": "16", "content_sanskrit": "अस्त्रैर्वागदयावापिबाहुभ्यांवामहाहवे । अभ्यस्तंयेनवाराम तेनैवयुधिवर्तताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40017703, "chapter_id": 9267, "verse_number": "17", "content_sanskrit": "मकराक्ष्वचश्श्रुत्वारामोदशरथात्मजः । अब्रवीत्प्रहसन्वाक्यमुत्तरोत्तरवादिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40017704, "chapter_id": 9267, "verse_number": "18", "content_sanskrit": "कत्थसेकिंवृथारक्षो बहून्यसदृशानिते । न रणेशक्यतेजेतुंविनायुद्धेनवाग्भलात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40017705, "chapter_id": 9267, "verse_number": "19", "content_sanskrit": "चतुर्दशसहस्राणिरक्षसांत्वत्पिता च यः । त्रिशिरादूषणश्चापिदण्डकेनिहतामया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40017706, "chapter_id": 9267, "verse_number": "20", "content_sanskrit": "स्वाशितास्तवमांसेनगृध्रगोमायुवायसाः । भविष्यन्त्यद्यवैपाप तीक्ष्णतुण्डनखाङ्कुराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40017707, "chapter_id": 9267, "verse_number": "21", "content_sanskrit": "राघवेणैवमुक्तस्तुमकराक्षोमहाबलः । बाणौघानमुचत्तस्मैराघवायरणाजिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40017708, "chapter_id": 9267, "verse_number": "22", "content_sanskrit": "तान्शरान् शरवर्षेणरामश्चिच्छेदनैकधा । निपेतुर्भुवितेछिन्नारुक्मपुङ्खास्सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40017709, "chapter_id": 9267, "verse_number": "23", "content_sanskrit": "तद्युद्धमभवत्तत्रसमेत्यान्योन्यमोजसा । खरराक्षसपुत्रस्यसूनोर्धशरथस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40017710, "chapter_id": 9267, "verse_number": "24", "content_sanskrit": "जीमूतयोरिवाकाशेशब्दोज्यातलयोस्तदा । धनुर्मुक्तःस्वनोत्कृष्टश्श्रूयते च रणाजिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40017711, "chapter_id": 9267, "verse_number": "25", "content_sanskrit": "देवदानवगन्धर्वाःकिन्नराश्चमहोरगाः । अन्तरिक्षगतास्सर्वेद्रष्टुकामास्तदद्भुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40017712, "chapter_id": 9267, "verse_number": "26", "content_sanskrit": "विद्धमन्योन्यगात्रेषुद्विगुणंवर्धतेपरम् । कृतप्रतिकृतान्योन्यंकुरुतांतौरणाजिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40017713, "chapter_id": 9267, "verse_number": "27", "content_sanskrit": "राममुक्तांस्तुबाणौघान् राक्षसस्त्वच्छिनद्रणे । रक्षोमुक्तांस्तुरामोवैनैकथाप्राच्छिनच्छरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40017714, "chapter_id": 9267, "verse_number": "28", "content_sanskrit": "बाणौघैर्विततास्सर्वादिशश्चप्रदिशस्तथा । सञ्छन्नावसुधाचैवसमन्तान्नप्रकाशते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40017715, "chapter_id": 9267, "verse_number": "29", "content_sanskrit": "तःक्रुद्धोमहाबाहुर्धनुच्शिच्छेदरक्षसः । अष्टाभिरथनाराचैस्सूतंविव्याधराघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40017716, "chapter_id": 9267, "verse_number": "30", "content_sanskrit": "भित्त्वारथंशरैरामोहत्वाआश्वानपातयत् । विरथोवसुधास्थश्चमकराक्षोनिशाचरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40017717, "chapter_id": 9267, "verse_number": "31", "content_sanskrit": "तत्तिष्ठद्वसुधांरक्षश्शूलंजग्राहपाणिना । त्रासनंसर्वभूतानांयुगान्ताग्निसमप्रभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40017718, "chapter_id": 9267, "verse_number": "32", "content_sanskrit": "दुरवापम् महच्छूलंरुद्रदत्तंभयङ्करम् । जाज्वल्यमानमाकाशेसंहारास्त्रमिवापरम् ॥ यंदृष्टवादेवताःसर्वाभयार्ताविद्रुतादिशः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40017719, "chapter_id": 9267, "verse_number": "33", "content_sanskrit": "विभ्राम्यतुमहच्छूलंप्रज्वलन्तन्निशाचरः ॥ स क्रोधाप्राहिणोत्तस्मैराघवायमहात्मने ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40017720, "chapter_id": 9267, "verse_number": "34", "content_sanskrit": "तमापतन्तंज्वलितंखरपुत्रकराच्च्युतम् ॥ बाणैत्रिभिराकाशेशूलंचिच्छेदराघवः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40017721, "chapter_id": 9267, "verse_number": "35", "content_sanskrit": "सच्छन्नोनैकथाशूलोदिव्यहाटकमण्डितः ॥ व्यशीर्यतमहोल्केवरामबाणार्दितोभुवि ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 40017722, "chapter_id": 9267, "verse_number": "36", "content_sanskrit": "च्छूलंनिहतंदृष्टवारामेणाक्लिष्टकर्मणा ॥ साधुसावधितिभूतानिव्याहरन्तिनभोगताः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 40017723, "chapter_id": 9267, "verse_number": "37", "content_sanskrit": "तंदृष्टवानिहतंशूलंमकराक्षोनिशाचरः ॥ मुष्टिमुद्यम्यकाकुत्स्थंतिष्ठतिष्ठेतिचाब्रवीत् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 40017724, "chapter_id": 9267, "verse_number": "38", "content_sanskrit": "सःतंदृष्टवाऽपतन्तंवैप्रहस्यरघुनन्दनः ॥ पावकास्त्रंततोरामस्सन्दधेतुशरासने ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 40017725, "chapter_id": 9267, "verse_number": "39", "content_sanskrit": "तेनास्त्रणहतंरक्षःकाकुत्थ्सेनतदारणे ॥ सञ्चिन्नहृदयंतत्रपपात च ममार च ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 40017726, "chapter_id": 9267, "verse_number": "40", "content_sanskrit": "दृष्टवातेराक्षसास्सर्वेमकराक्षस्यपातनम् ॥ लङ्कामेवप्रधावन्तरामबाणभयार्दिताः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]