[{"id": 5000267000, "chapter_id": 9267, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे सप्ततितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000267001, "chapter_id": 9267, "verse_number": "३-७०-१", "content_sanskrit": "तौ तु तत्र स्थितौ दृष्ट्वा भ्रातरौ रामलक्ष्मणौ।\nबाहुपाशपरिक्षिप्तौ कबन्धो वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000267002, "chapter_id": 9267, "verse_number": "३-७०-२", "content_sanskrit": "तिष्ठतः किं नु मां दृष्ट्वा क्षुधार्तं क्षत्रियर्षभौ।\nआहारार्थं तु संदिष्टौ दैवेन हतचेतनौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000267003, "chapter_id": 9267, "verse_number": "३-७०-३", "content_sanskrit": "तच्छ्रुत्वा लक्ष्मणो वाक्यं प्राप्तकालं हितं तदा।\nउवाचार्तिसमापन्नो विक्रमे कृतनिश्चयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000267004, "chapter_id": 9267, "verse_number": "३-७०-४", "content_sanskrit": "त्वां च मां च पुरा तूर्णमादत्ते राक्षसाधमः।\nतस्मादसिभ्यामस्याशु बाहू छिन्दावहे गुरू ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000267005, "chapter_id": 9267, "verse_number": "३-७०-५", "content_sanskrit": "भीषणोऽयं महाकायो राक्षसा भुजविक्रमः।\nलोकं ह्यतिजितं कृत्वा ह्यावां हन्तुमिहेच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000267006, "chapter_id": 9267, "verse_number": "३-७०-६", "content_sanskrit": "निश्चेष्टानां वधो राजन् कुत्सितो जगतीपतेः।\nक्रतुमध्योपनीतानां पशूनामिव राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000267007, "chapter_id": 9267, "verse_number": "३-७०-७", "content_sanskrit": "एतत् संजल्पितं श्रुत्वा तयोः क्रुद्धस्तु राक्षसः।\nविदार्यास्यं ततो रौद्रं तौ भक्षयितुमारभत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000267008, "chapter_id": 9267, "verse_number": "३-७०-८", "content_sanskrit": "ततस्तौ देशकालज्ञौ खड्गाभ्यामेव राघवौ।\nअच्छिन्दन्तां सुसंहृष्टौ बाहू तस्यांसदेशतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000267009, "chapter_id": 9267, "verse_number": "३-७०-९", "content_sanskrit": "दक्षिणो दक्षिणं बाहुमसक्तमसिना ततः।\nचिच्छेद रामो वेगेन सव्यं वीरस्तु लक्ष्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000267010, "chapter_id": 9267, "verse_number": "३-७०-१०", "content_sanskrit": "स पपात महाबाहुश्छिन्नबाहुर्महास्वनः।\nखं च गां च दिशश्चैव नादयञ्जलदो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000267011, "chapter_id": 9267, "verse_number": "३-७०-११", "content_sanskrit": "स निकृत्तौ भुजौ दृष्ट्वा शोणितौघपरिप्लुतः।\nदीनः पप्रच्छ तौ वीरौ कौ युवामिति दानवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000267012, "chapter_id": 9267, "verse_number": "३-७०-१२", "content_sanskrit": "इति तस्य ब्रुवाणस्य लक्ष्मणः शुभलक्षणः।\nशशंस तस्य काकुस्त्थं कबन्धस्य महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000267013, "chapter_id": 9267, "verse_number": "३-७०-१३", "content_sanskrit": "अयमिक्ष्वाकुदायादो रामो नाम जनैः श्रुतः।\nतस्यैवावरजं विद्धि भ्रातरं मां च लक्ष्मणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000267014, "chapter_id": 9267, "verse_number": "३-७०-१४", "content_sanskrit": "मात्रा प्रतिहते राज्ये रामः प्रव्राजितो वनम्।\nमया सह चरत्येष भार्यया च महद् वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000267015, "chapter_id": 9267, "verse_number": "३-७०-१५", "content_sanskrit": "अस्य देवप्रभावस्य वसतो विजने वने।\nरक्षसापहृता भार्या यामिच्छन्ताविहागतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000267016, "chapter_id": 9267, "verse_number": "३-७०-१६", "content_sanskrit": "त्वं तु को वा किमर्थं वा कबन्धसदृशो वने।\nआस्येनोरसि दीप्तेन भग्नजङ्घो विचेष्टसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000267017, "chapter_id": 9267, "verse_number": "३-७०-१७", "content_sanskrit": "एवमुक्तः कबन्धस्तु लक्ष्मणेनोत्तरं वचः।\nउवाच वचनं प्रीतस्तदिन्द्रवचनं स्मरन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000267018, "chapter_id": 9267, "verse_number": "३-७०-१८", "content_sanskrit": "स्वागतं वां नरव्याघ्रौ दिष्ट्या पश्यामि वामहम्।\nदिष्ट्या चेमौ निकृत्तौ मे युवाभ्यां बाहुबन्धनौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000267019, "chapter_id": 9267, "verse_number": "३-७०-१९", "content_sanskrit": "विरूपं यच्च मे रूपं प्राप्तं ह्यविनयाद् यथा।\nतन्मे शृणु नरव्याघ्र तत्त्वतः शंसतस्तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000267020, "chapter_id": 9267, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे सप्ततितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]