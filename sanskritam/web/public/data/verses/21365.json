[{"id": 7001365000, "chapter_id": 21365, "verse_number": "५-१२-१", "content_sanskrit": "॥ सनत्कुमार उवाच  ।\nपानीयदानं परमं दानानामुत्तमं सदा ।\nसर्वेषां जीवपुंजानां तर्पणं जीवनं स्मृतम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001365001, "chapter_id": 21365, "verse_number": "५-१२-२", "content_sanskrit": "प्रपादानमतः कुर्यात्सुस्नेहादनिवारितम् ।\nजलाश्रयविनिर्माणं महानन्दकरं भवेत्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001365002, "chapter_id": 21365, "verse_number": "५-१२-३", "content_sanskrit": "इह लोके परे वापि सत्यं सत्यं न संशयः ।\nतस्माद्वापीश्च कूपांश्च तडागान्कारयेन्नरः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001365003, "chapter_id": 21365, "verse_number": "५-१२-४", "content_sanskrit": "अर्द्धं पापस्य हरति पुरुषस्य विकर्मणः ।\nकूपः प्रवृत्तपानीयः सुप्रवृत्तस्य नित्यशः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001365004, "chapter_id": 21365, "verse_number": "५-१२-५", "content_sanskrit": "सर्वं तारयते वंशं यस्य खाते जलाशये ।\nगावः पिबंति विप्राश्च साधवश्च नरास्सदा॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001365005, "chapter_id": 21365, "verse_number": "५-१२-६", "content_sanskrit": "निदाघकाले पानीयं यस्य तिष्ठत्यवारितम् ।\nसुदुर्गं विषमं कृच्छ्रं न कदाचिदवाप्यते॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001365006, "chapter_id": 21365, "verse_number": "५-१२-७", "content_sanskrit": "तडागानां च वक्ष्यामि कृतानां ये गुणाः स्मृता ।\nत्रिषु लोकेषु सर्वत्र पूजितो यस्तडागवान्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001365007, "chapter_id": 21365, "verse_number": "५-१२-८", "content_sanskrit": "अथवा मित्रसदने मैत्रं मित्रार्तिवर्जितम् ।\nकीर्तिसंजननं श्रेष्ठं तडागानां निवेशनम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001365008, "chapter_id": 21365, "verse_number": "५-१२-९", "content_sanskrit": "धर्मस्यार्थस्य कामस्य फलमाहुर्मनीषिणः ।\nतडागं सुकृते येन तस्य पुण्यमनन्तकम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001365009, "chapter_id": 21365, "verse_number": "५-१२-१०", "content_sanskrit": "चतुर्विधानां भूतानां तडागः परमाश्रयः ।\nतडागादीनि सर्वाणि दिशन्ति श्रियमुत्तमाम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001365010, "chapter_id": 21365, "verse_number": "५-१२-११", "content_sanskrit": "देवा मनुष्या गन्धर्वाः पितरो नागराक्षसाः ।\nस्थावराणि च भूतानि संश्रयंति जलाशयम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001365011, "chapter_id": 21365, "verse_number": "५-१२-१२", "content_sanskrit": "प्रावृडृतौ तडागे तु सलिलं यस्य तिष्ठति ।\nअग्निहोत्रफलं तस्य भवतीत्याह चात्मभूः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001365012, "chapter_id": 21365, "verse_number": "५-१२-१३", "content_sanskrit": "शरत्काले तु सलिलं तडागे यस्य तिष्ठति ।\nगोसहस्रफलं तस्य भवेन्नैवात्र संशयः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001365013, "chapter_id": 21365, "verse_number": "५-१२-१४", "content_sanskrit": "हेमन्ते शिशिरे चैव सलिलं यस्य तिष्ठति ।\nस वै बहुसुवर्णस्य यज्ञस्य लभते फलम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001365014, "chapter_id": 21365, "verse_number": "५-१२-१५", "content_sanskrit": "वसंते च तथा ग्रीष्मे सलिलं यस्य तिष्ठति ।\nअतिरात्राश्वमेधानां फलमाहुर्मनीषिणः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001365015, "chapter_id": 21365, "verse_number": "५-१२-१६", "content_sanskrit": "मुने व्यासाथ वृक्षाणां रोपणे च गुणाञ्छृणु ।\nप्रोक्तं जलाशयफलं जीवप्रीणनमुत्तमम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001365016, "chapter_id": 21365, "verse_number": "५-१२-१७", "content_sanskrit": "अतीतानागतान्सर्वान्पितृवंशांस्तु तारयेत् ।\nकांतारे वृक्षरोपी यस्तस्माद्वृक्षांस्तु रोपयेत्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001365017, "chapter_id": 21365, "verse_number": "५-१२-१८", "content_sanskrit": "तत्र पुत्रा भवंत्येते पादपा नात्र संशयः ।\nपरं लोकं गतस्सोऽपि लोकानाप्नोति चाक्षयान्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001365018, "chapter_id": 21365, "verse_number": "५-१२-१९", "content_sanskrit": "पुष्पैस्सुरगणान्सर्वान्फलैश्चापि तथा पितॄन् ।\nछायया चातिथीन्सर्वान्पूजयंति महीरुहाः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001365019, "chapter_id": 21365, "verse_number": "५-१२-२०", "content_sanskrit": "किन्नरोरगरक्षांसि देवगंधर्वमानवाः ।\nतथैवर्षिगणाश्चैव संश्रयंति महीरुहान्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001365020, "chapter_id": 21365, "verse_number": "५-१२-२१", "content_sanskrit": "पुष्पिताः फलवंतश्च तर्पयंतीह मानवान् ।\nइह लोके परे चैव पुत्रास्ते धर्मतः स्मृताः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001365021, "chapter_id": 21365, "verse_number": "५-१२-२२", "content_sanskrit": "तडागकृद्वृक्षरोपी चेष्टयज्ञश्च यो द्विजः ।\nएते स्वर्गान्न हीयंते ये चान्ये सत्यवादिनः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001365022, "chapter_id": 21365, "verse_number": "५-१२-२३", "content_sanskrit": "सत्यमेव परं ब्रह्म सत्यमेव परं तपः ।\nसत्यमेव परो यज्ञस्सत्यमेव परं श्रुतम्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001365023, "chapter_id": 21365, "verse_number": "५-१२-२४", "content_sanskrit": "सत्यं सुप्तेषु जागर्ति सत्यं च परमं पदम् ।\nसत्येनैव धृता पृथ्वी सत्ये सर्वं प्रतिष्ठितम्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001365024, "chapter_id": 21365, "verse_number": "५-१२-२५", "content_sanskrit": "ततो यज्ञश्च पुण्यं च देवर्षिपितृपूजने ।\nआपो विद्या च ते सर्वे सर्वं सत्ये प्रतिष्ठितम्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001365025, "chapter_id": 21365, "verse_number": "५-१२-२६", "content_sanskrit": "सत्यं यज्ञस्तपो दानं मंत्रा देवी सरस्वती ।\nब्रह्मचर्य्यं तथा सत्यमोंकारस्सत्यमेव च॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001365026, "chapter_id": 21365, "verse_number": "५-१२-२७", "content_sanskrit": "सत्येन वायुरभ्येति सत्येन तपते रविः ।\nसत्येनाग्निर्निर्दहति स्वर्गस्सत्येन तिष्ठति॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001365027, "chapter_id": 21365, "verse_number": "५-१२-२८", "content_sanskrit": "पालनं सर्ववेदानां सर्वतीर्थावगाहनम् ।\nसत्येन वहते लोके सर्वमाप्नोत्यसंशयम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001365028, "chapter_id": 21365, "verse_number": "५-१२-२९", "content_sanskrit": "अश्वमेधसहस्रं च सत्यं च तुलया धृतम् ।\nलक्षाणि क्रतवश्चैव सत्यमेव विशिष्यते॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001365029, "chapter_id": 21365, "verse_number": "५-१२-३०", "content_sanskrit": "सत्येन देवाः पितरो मानवोरगराक्षसाः ।\nप्रीयंते सत्यतस्सर्वे लोकाश्च सचराचराः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001365030, "chapter_id": 21365, "verse_number": "५-१२-३१", "content_sanskrit": "सत्यमाहुः परं धर्मं सत्यमाहुः परं पदम् ।\nसत्यमाहुः परं ब्रह्म तस्मात्सत्यं सदा वदेत्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001365031, "chapter_id": 21365, "verse_number": "५-१२-३२", "content_sanskrit": "मुनयस्सत्यनिरतास्तपस्तप्त्वा सुदुश्चरम् ।\nसत्यधर्मरतास्सिद्धास्ततस्स्वर्गं च ते गताः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001365032, "chapter_id": 21365, "verse_number": "५-१२-३३", "content_sanskrit": "अप्सरोगणसंविष्टैर्विमानैःपरिमातृभिः ।\nवक्तव्यं च सदा सत्यं न सत्याद्विद्यते परम्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001365033, "chapter_id": 21365, "verse_number": "५-१२-३४", "content_sanskrit": "अगाधे विपुले सिद्धे सत्यतीर्थे शुचिह्रदे ।\nस्नातव्यं मनसा युक्तं स्थानं तत्परमं स्मृतम्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001365034, "chapter_id": 21365, "verse_number": "५-१२-३५", "content_sanskrit": "आत्मार्थे वा परार्थे वा पुत्रार्थे वापि मानवाः ।\nअनृतं ये न भाषंते ते नरास्स्वर्गगामिनः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001365035, "chapter_id": 21365, "verse_number": "५-१२-३६", "content_sanskrit": "वेदा यज्ञास्तथा मंत्रास्संति विप्रेषु नित्यशः ।\nनोभांत्यपि ह्यसत्येषु तस्मात्सत्यं समाचरेत्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001365036, "chapter_id": 21365, "verse_number": "५-१२-३७", "content_sanskrit": "॥ व्यास उवाच  ।\nतपसो मे फलं ब्रूहि पुनरेव विशेषतः ।\nसर्वेषां चैव वर्णानां ब्राह्मणानां तपोधन॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001365037, "chapter_id": 21365, "verse_number": "५-१२-३८", "content_sanskrit": "सनत्कुमार उवाच ।\nप्रवक्ष्यामि तपोऽध्यायं सर्व कामार्थसाधकम् ।\nसुदुश्चरं द्विजातीनां तन्मे निगदतः शृणु॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001365038, "chapter_id": 21365, "verse_number": "५-१२-३९", "content_sanskrit": "तपो हि परमं प्रोक्तं तपसा विद्यते फलम् ।\nतपोरता हि ये नित्यं मोदंते सह दैवतैः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001365039, "chapter_id": 21365, "verse_number": "५-१२-४०", "content_sanskrit": "तपसा प्राप्यते स्वर्गस्तपसा प्राप्यते यशः ।\nतपसा प्राप्यते कामस्तपस्सर्वार्थसाधनम्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001365040, "chapter_id": 21365, "verse_number": "५-१२-४१", "content_sanskrit": "तपसा मोक्षमाप्नोति तपसा विंदते महत् ।\nज्ञानविज्ञानसंपत्तिः सौभाग्यं रूपमेव च॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001365041, "chapter_id": 21365, "verse_number": "५-१२-४२", "content_sanskrit": "नानाविधानि वस्तूनि तपसा लभते नरः ।\nतपसा लभते सर्वं मनसा यद्यदिच्छति॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001365042, "chapter_id": 21365, "verse_number": "५-१२-४३", "content_sanskrit": "नातप्ततपसो यांति ब्रह्मलोकं कदाचन ।\nनातप्ततपसां प्राप्यश्शंकरः परमेश्वरः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001365043, "chapter_id": 21365, "verse_number": "५-१२-४४", "content_sanskrit": "यत्कार्यं किंचिदास्थाय पुरुषस्तपते तपः ।\nतत्सर्वं समवाप्नोति परत्रेह च मानवः॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001365044, "chapter_id": 21365, "verse_number": "५-१२-४५", "content_sanskrit": "सुरापः पारदारी च ब्रह्महा गुरुतल्पगः ।\nतपसा तरते सर्वं सर्वतश्च विमुंचति॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001365045, "chapter_id": 21365, "verse_number": "५-१२-४६", "content_sanskrit": "अपि सर्वेश्वरः स्थाणुर्विष्णु श्चैव सनातनः ।\nब्रह्मा हुताशनः शक्रो ये चान्ये तपसान्विताः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001365046, "chapter_id": 21365, "verse_number": "५-१२-४७", "content_sanskrit": "अष्टाशीतिसहस्राणि मुनीनामूर्द्ध्वरेतसाम् ।\nतपसा दिवि मोदंते समेता दैवतैस्सह॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001365047, "chapter_id": 21365, "verse_number": "५-१२-४८", "content_sanskrit": "तपसा लभ्यते राज्यं स च शक्रस्सुरेश्वरः ।\nतपसाऽपालयत्सर्वमहन्यहनि वृत्रहा॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001365048, "chapter_id": 21365, "verse_number": "५-१२-४९", "content_sanskrit": "सूर्य्याचन्द्रमसौ देवौ सर्वलोकहिते रतौ ।\nतपसैव प्रकाशंते नक्षत्राणि ग्रहास्तथा॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001365049, "chapter_id": 21365, "verse_number": "५-१२-५०", "content_sanskrit": "न चास्ति तत्सुखं लोके यद्विना तपसा किल ।\nतपसैव सुखं सर्वमिति वेदविदो विदुः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001365050, "chapter_id": 21365, "verse_number": "५-१२-५१", "content_sanskrit": "ज्ञानं विज्ञानमारोग्यं रूपवत्त्वं तथैव च ।\nसौभाग्यं चैव तपसा प्राप्यते सर्वदा सुखम्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001365051, "chapter_id": 21365, "verse_number": "५-१२-५२", "content_sanskrit": "तपसा सृज्यते विश्वं ब्रह्मा विश्वं विनाश्रमम् ।\nपाति विष्णुर्हरोऽप्यत्ति धत्ते शेषोऽखिलां महीम्॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001365052, "chapter_id": 21365, "verse_number": "५-१२-५३", "content_sanskrit": "विश्वामित्रो गाधिसुतस्तपसैव महामुने ।\nक्षत्रियोऽथाभवद्विप्रः प्रसिद्धं त्रिभवेत्विदम्॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001365053, "chapter_id": 21365, "verse_number": "५-१२-५४", "content_sanskrit": "इत्युक्तं ते महाप्राज्ञ तपोमाहात्म्यमुत्तमम् ।\nशृण्वध्ययनमाहात्म्यं तपसोऽधिकमुत्तमम्॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]