[{"id": 2102695, "chapter_id": 3224, "verse_number": "१४-८०-१", "content_sanskrit": "वैशम्पायन उवाच।\nततो बहुतरं भीरर्विलप्य कमलेक्षणा।\nमुमोह दुःखसंतप्ता पपात च महीतले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2102696, "chapter_id": 3224, "verse_number": "१४-८०-२", "content_sanskrit": "प्रतिलभ्य च सा संज्ञां देवी दिव्यवपुर्धरा।\nउलूपीं पन्नगसुतां दृष्ट्वेदं वाक्यमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2102697, "chapter_id": 3224, "verse_number": "१४-८०-३", "content_sanskrit": "उलूपि पश्य भर्तारं शयानं नितं रणे।\nत्वत्कृते मम पुत्रेण बाणेन समितिंजयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2102698, "chapter_id": 3224, "verse_number": "१४-८०-४", "content_sanskrit": "ननु त्वमार्यधर्मज्ञा ननु चासि पतिव्रता।\nयत्त्वत्कृतेऽयं पतितः पतिस्ते निहतो रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2102699, "chapter_id": 3224, "verse_number": "१४-८०-५", "content_sanskrit": "किंनु मन्देऽपकराद्धोऽयं यदि तेऽद्य धनंजयः।\nक्षमस्व याच्यमाना वै जीवयस्व धनंजयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2102700, "chapter_id": 3224, "verse_number": "१४-८०-६", "content_sanskrit": "ननु त्वमार्ये धर्मज्ञे त्रैलोक्यविदिता शुभे।\nयद्धातयित्वा पुत्रेण भर्तारं नानुशोचसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2102701, "chapter_id": 3224, "verse_number": "१४-८०-७", "content_sanskrit": "नाहं शोचामि तनयं हतं पन्नगनन्दिनि।\nपतिमेव तु शोचामि यस्यातिथ्यमिदं कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2102702, "chapter_id": 3224, "verse_number": "१४-८०-८", "content_sanskrit": "इत्युक्त्वा सा तदा देवीमुलूपीं पन्नगात्मजाम्।\nभर्तारमभिगम्येदमित्युवाच यशस्विनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2102703, "chapter_id": 3224, "verse_number": "१४-८०-९", "content_sanskrit": "उत्तिष्ठ कुरुमुख्यस्य प्रियमुख्य मम प्रिय।\nअयमश्वो महाबाहो मयो ते परिमोक्षितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2102704, "chapter_id": 3224, "verse_number": "१४-८०-१०", "content_sanskrit": "ननु त्वया नाम विभो धर्मराजस्य यज्ञियः।\nअयमश्वोऽनुसर्तव्यः स शेषे किं महीतले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2102705, "chapter_id": 3224, "verse_number": "१४-८०-११", "content_sanskrit": "त्वयि प्राणा ममायत्ताः कुरूणां कुरुनन्दन।\nस कस्मात्प्राणदोऽन्येषां प्राणान्संत्यक्तवानसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2102706, "chapter_id": 3224, "verse_number": "१४-८०-१२", "content_sanskrit": "उलूपि साधु पश्येमं पतिं निपतितं भुवि।\nपुत्रं चेमं समुत्साद्य घातयित्वा न शोचसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2102707, "chapter_id": 3224, "verse_number": "१४-८०-१३", "content_sanskrit": "कामं स्वपितु बालोऽयं भूमौ मृत्युवशं गतः।\nलोहिताक्षो गुडाकेशो विजयः साधु जीवतु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2102708, "chapter_id": 3224, "verse_number": "१४-८०-१४", "content_sanskrit": "नापराधोऽस्ति सुभगे नराणां बहुभार्यता।\nप्रमदानां भवत्येष मा ते भूद्बुद्धिरीदृशी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2102709, "chapter_id": 3224, "verse_number": "१४-८०-१५", "content_sanskrit": "सख्यं चैतत्कृतं धात्रा शश्वदव्ययमेव तु।\nसख्यं समभिजानीहि सत्यं सङ्गतमस्तु ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2102710, "chapter_id": 3224, "verse_number": "१४-८०-१६", "content_sanskrit": "पुत्रेम घातयित्वैनं पतिं यदि न मेऽद्य वै।\nजीवन्तं दर्शयस्यद्य परित्यक्ष्यामि जीवितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2102711, "chapter_id": 3224, "verse_number": "१४-८०-१७", "content_sanskrit": "साऽहं दुःखान्विता देवि पतिपुत्रविनाकृता।\nइहैव प्रायमाशिष्ये प्रेक्षन्त्यास्ते न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2102712, "chapter_id": 3224, "verse_number": "१४-८०-१८", "content_sanskrit": "इत्युक्त्वा पन्नगसुतां सपत्नी चैत्रवाहनी।\nततः प्रायमुपासीना तूष्णीमासीज्जनाधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2102713, "chapter_id": 3224, "verse_number": "१४-८०-१९", "content_sanskrit": "ततो विलप्य विरता भर्तुः पादौ प्रगृह्य सा।\nउपविष्टा भवद्दीना सोच्छ्वासं पुत्रमीक्षती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2102714, "chapter_id": 3224, "verse_number": "१४-८०-२०", "content_sanskrit": "ततः संज्ञां पुनर्लब्ध्वा स राजा बभ्रुवाहनः।\nमातरं तामथालोक्य रणभूमावथाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2102715, "chapter_id": 3224, "verse_number": "१४-८०-२१", "content_sanskrit": "इतो दुःखतरं किंनु यन्मे माता सुखैधिता।\nभूमौ निपतितं वीरमनुशेते मृतं पतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2102716, "chapter_id": 3224, "verse_number": "१४-८०-२२", "content_sanskrit": "निहन्तारं रणेऽरीणां सर्वशस्त्रभृतां वरम्।\nमया विनिहतं सङ्ख्ये प्रेक्षते दुर्मरं बत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2102717, "chapter_id": 3224, "verse_number": "१४-८०-२३", "content_sanskrit": "अहोऽस्या हृदयं देव्या दृढं यन्न विदीर्यते।\nव्यूढोरस्कं महाबाहुं प्रेक्षन्त्या निहतं पतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2102718, "chapter_id": 3224, "verse_number": "१४-८०-२४", "content_sanskrit": "दुर्मरं पुरुषेणेह मन्ये काले ह्यनागते।\nयत्र नाहं न मे माता न वियुक्तौ स्वजीवितात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2102719, "chapter_id": 3224, "verse_number": "१४-८०-२५", "content_sanskrit": "हाहा धिक्कुरुवीरस्य किरीटं काञ्चनं भुवि।\nअपविद्धं हतस्येह मया पुत्रेम पश्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2102720, "chapter_id": 3224, "verse_number": "१४-८०-२६", "content_sanskrit": "भोभो पश्यत मे वीरं पितरं ब्राह्मणा भुवि।\nशयानं वीरशयने मया पुत्रेण पातितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2102721, "chapter_id": 3224, "verse_number": "१४-८०-२७", "content_sanskrit": "ब्राह्मणाः कुरुमुख्यस्य ये मुक्ता हयसारिणः।\nकुर्वन्ति शान्तिं कामस्य रणे योऽयं मया हतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2102722, "chapter_id": 3224, "verse_number": "१४-८०-२८", "content_sanskrit": "व्यादिशन्तु च किं विप्राः प्रायश्चित्तमिहाद्य मे।\nआनृशंसस्य पापस्य पितृहन्तू रणाजिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2102723, "chapter_id": 3224, "verse_number": "१४-८०-२९", "content_sanskrit": "दुश्चरा द्वादश समा हत्वा पितरमद्य वै।\nममेह सुनृशंसस्य संवीतस्यास्य चर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2102724, "chapter_id": 3224, "verse_number": "१४-८०-३०", "content_sanskrit": "शिरःकपाले चास्यैव भुञ्जतः पितुरद्य मे।\nप्रायश्चित्तं हि नास्त्यन्यद्धत्वाऽद्य पितरं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2102725, "chapter_id": 3224, "verse_number": "१४-८०-३१", "content_sanskrit": "पश्य नागोत्तमसुते भर्तारं निहतं मया।\nकृतं प्रियं मया तेऽद्य निहत्य समरेऽर्जुनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2102726, "chapter_id": 3224, "verse_number": "१४-८०-३२", "content_sanskrit": "सोऽहमद्य गमिष्यामि गतिं पितृनिषेविताम्।\nन शक्नोम्यात्मनाऽऽत्मानमहं दारयितुं शुभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2102727, "chapter_id": 3224, "verse_number": "१४-८०-३३", "content_sanskrit": "सा त्वं मयि मृते मातस्तथा गाण्डीवधन्वनि।\nभव प्रीतिमती देवि सत्येनात्मानमालभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2102728, "chapter_id": 3224, "verse_number": "१४-८०-३४", "content_sanskrit": "इत्युक्त्वा स ततो राजा दुःखशोकसमाहतः।\nउपस्पृश्य महाराज दुःखाद्वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2102729, "chapter_id": 3224, "verse_number": "१४-८०-३५", "content_sanskrit": "शृण्वन्तु सर्वभूतानि स्थावराणि चराणि च।\nत्वं च मातर्यथा सत्यं ब्रवीमि भुजगोत्तमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2102730, "chapter_id": 3224, "verse_number": "१४-८०-३६", "content_sanskrit": "यदि नोत्तिष्ठति जयः पिता मे नरसत्तमः।\nअस्मिन्नेव रणोद्देशे शोषयिष्ये कलेवरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2102731, "chapter_id": 3224, "verse_number": "१४-८०-३७", "content_sanskrit": "नहि मे पितरं हत्वा निष्कृतिर्विद्यते क्वचित्।\nनरकं प्रतिपत्स्यामि ध्रुवं गुरुवधार्दितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2102732, "chapter_id": 3224, "verse_number": "१४-८०-३८", "content_sanskrit": "वीरं हि क्षत्रियं हत्वा गोशतेन प्रमुच्यते।\nपितरं तु निहत्यैवं दुर्लभा निष्कृतिर्मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2102733, "chapter_id": 3224, "verse_number": "१४-८०-३९", "content_sanskrit": "एत एको महातेजाः पाण्डुपुत्रो धनंजयः।\nपिता च मम धर्मात्मा तस्य मे निष्कृतिः कुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2102734, "chapter_id": 3224, "verse_number": "१४-८०-४०", "content_sanskrit": "इत्येवमुक्त्वा नृपते धनंजयसुतो नृपः।\nउपस्पृश्याभवत्तूष्णीं प्रायोपेतो महामतिः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2102735, "chapter_id": 3224, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि अशीतितमोऽध्यायः॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]