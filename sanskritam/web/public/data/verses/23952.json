[{"id": 7003952000, "chapter_id": 23952, "verse_number": "३-१-१५-१", "content_sanskrit": "श्रीसूत उवाच ।\nब्रह्मकुण्डे महापुण्ये स्नानं कृत्वा समाहितः ।\nनरो हनूमतः कुण्डमथ गच्छेद्विजोत्तमाः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003952001, "chapter_id": 23952, "verse_number": "३-१-१५-२", "content_sanskrit": "पुरा हतेषु रक्षःसु समाप्ते रणकर्मणि ।\nरामादिषु निवृत्तेषु गंधमादनपर्वते॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003952002, "chapter_id": 23952, "verse_number": "३-१-१५-३", "content_sanskrit": "सर्व लोकोपकाराय हनूमान्मारुतात्मजः ।\nसर्वतीर्थोत्तमं चक्रे स्वनाम्ना तीर्थमुत्तमम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003952003, "chapter_id": 23952, "verse_number": "३-१-१५-४", "content_sanskrit": "विदित्वा वैभवं यस्य स्वयं रुद्रेण सेव्यते ।\nतस्य तीर्थस्य सदृशं न भूतं न भविष्यति॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003952004, "chapter_id": 23952, "verse_number": "३-१-१५-५", "content_sanskrit": "यत्र स्नाता नरा यांति शिवलोकं सनातनम् ।\nयस्मिंस्तीर्थे महापुण्ये महापातकनाशने॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003952005, "chapter_id": 23952, "verse_number": "३-१-१५-६", "content_sanskrit": "सर्वलोकोपकाराय निर्मिते वायुसूनुना ।\nसर्वाणि नरकाण्यासञ्च्छून्यान्येव चिराय वै॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003952006, "chapter_id": 23952, "verse_number": "३-१-१५-७", "content_sanskrit": "वैभवं तस्य तीर्थस्य शंकरो वेत्ति वा न वा ।\nयत्र धर्मसखोनाम राजा केकयवंशजः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003952007, "chapter_id": 23952, "verse_number": "३-१-१५-८", "content_sanskrit": "भक्त्या सह पुरा स्नात्वा शतं पुत्रानवाप्त वान् ।\nऋषय ऊचुः ।\nसूत धर्मसखस्याद्य चरितं वक्तुमर्हसि ।\nहनूमत्कुण्डतीर्थे यो लेभे स्नात्वा शतं सुतान्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003952008, "chapter_id": 23952, "verse_number": "३-१-१५-९", "content_sanskrit": "श्रीसूत उवाच ।\nशृणुध्वमृषयो यूयं चरितं तस्य भूपतेः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003952009, "chapter_id": 23952, "verse_number": "३-१-१५-१०", "content_sanskrit": "अद्य धर्मसखस्याहं प्रवक्ष्यामि समासतः ।\nराजा धर्मसखोनाम विजितारिः सुधार्मिकः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003952010, "chapter_id": 23952, "verse_number": "३-१-१५-११", "content_sanskrit": "बभूव नीतिमान्पूर्वं प्रजापालनतत्परः ।\nतस्य भार्याशतं विप्रा वभूव पतिदैवतम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003952011, "chapter_id": 23952, "verse_number": "३-१-१५-१२", "content_sanskrit": "स पालयन्महीं राजा सशैलवनकाननाम् ।\nतासु भार्यासु तनयं नाविंदद्वंशवर्द्धनम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003952012, "chapter_id": 23952, "verse_number": "३-१-१५-१३", "content_sanskrit": "पुत्रार्थं स महीपालो बहूयत्नानथाकरोत्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003952013, "chapter_id": 23952, "verse_number": "३-१-१५-१४", "content_sanskrit": "अकरोच्च महादानं पुत्रार्थं स महीपतिः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003952014, "chapter_id": 23952, "verse_number": "३-१-१५-१५", "content_sanskrit": "अश्वमेधादिभिर्यज्ञैरयजच्च सुरान्प्रति ।\nतुलापुरुषमुख्यानि ददौ दानानि भूरिशः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003952015, "chapter_id": 23952, "verse_number": "३-१-१५-१६", "content_sanskrit": "आमध्यरात्रमन्नानि सर्वेभ्योऽप्यनिवारितम् ।\nप्रायच्छद्बहुसूपानि सस्योपेतानि भूमिपः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003952016, "chapter_id": 23952, "verse_number": "३-१-१५-१७", "content_sanskrit": "पितॄनुद्दिश्य च श्राद्धमकरोद्विधिपूर्वकम् ।\nसंतानदायिनो मंत्राञ्जजाप नियतेद्रियः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003952017, "chapter_id": 23952, "verse_number": "३-१-१५-१८", "content_sanskrit": "एवमादीन्बहून्धर्मान्पुत्रार्थं कृतवान्नृपः ।\nपुत्रमुद्दिश्य सततं कुर्वन्धर्माननुत्तमान्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003952018, "chapter_id": 23952, "verse_number": "३-१-१५-१९", "content_sanskrit": "राजा दीर्घेण कालेन वृद्धतां प्रत्यपद्यत ।\nकदाचित्तस्य वृद्धस्य यतमानस्य भूपतेः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003952019, "chapter_id": 23952, "verse_number": "३-१-१५-२०", "content_sanskrit": "पुत्रस्सुचंद्रनामाभूज्ज्येष्ठपत्न्यां मनोरमः ।\nजातं पुत्रं जनन्यस्ताः सर्वा वैषम्यवर्जिताः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003952020, "chapter_id": 23952, "verse_number": "३-१-१५-२१", "content_sanskrit": "समं संवर्द्धयामासुः क्षीरादिभिरनुत्तमाः ।\nराज्ञश्च सर्वमातॄणां पौराणाम्मंत्रिणां तथा॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003952021, "chapter_id": 23952, "verse_number": "३-१-१५-२२", "content_sanskrit": "मनोनयनसंतोषजनकोऽयं सुतोऽभवत् ।\nलालयानः सुतं राजा मुदं लेभे परात्पराम्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003952022, "chapter_id": 23952, "verse_number": "३-१-१५-२३", "content_sanskrit": "आंदोलिकाशयानस्य सूनोस्तस्य कदाचन ।\nवृश्चिकोऽकुट्टयत्पादे पुच्छेनोद्यद्विषाग्निना॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003952023, "chapter_id": 23952, "verse_number": "३-१-१५-२४", "content_sanskrit": "कुट्टनाद्वृश्चिकस्यासावरुदत्तनयो भृशम् ।\nततस्तन्मातरः सर्वाः प्रारुदञ्च्छोककातराः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003952024, "chapter_id": 23952, "verse_number": "३-१-१५-२५", "content_sanskrit": "परिवार्यात्मजं विप्राः सध्वनिः संकुलोऽभवत् ।\nआर्तध्वनिं स शुश्राव राजा धर्मसखस्तदा॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003952025, "chapter_id": 23952, "verse_number": "३-१-१५-२६", "content_sanskrit": "उपविष्टः सभामध्ये सहामात्यपुरोहितः ।\nअथ प्रातिष्ठिपद्राजा सौविदल्लं स वेदितुम्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003952026, "chapter_id": 23952, "verse_number": "३-१-१५-२७", "content_sanskrit": "अन्तःपुरबहिर्द्वारं सौविदल्लः समेत्य सः ।\nषंढवृद्धान्समाहूय वाक्यमेतदभाषत॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003952027, "chapter_id": 23952, "verse_number": "३-१-१५-२८", "content_sanskrit": "षंढाः किमर्थमधुना रुदत्यन्तःपुर स्त्रियः ।\nतत्परिज्ञायतां तत्र गत्वा रोदनकारणम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003952028, "chapter_id": 23952, "verse_number": "३-१-१५-२९", "content_sanskrit": "एतदर्थं हि मां राजा प्रेरयामास संसदि ।\nइत्युक्तास्तु परिज्ञाय निदानं रोदनस्य ते॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003952029, "chapter_id": 23952, "verse_number": "३-१-१५-३०", "content_sanskrit": "निर्गम्यांतःपुरात्तस्मै यथावृत्तं न्यवेदयत् ।\nस षंढकवचः श्रुत्वा सौविदल्लः सभां गतः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003952030, "chapter_id": 23952, "verse_number": "३-१-१५-३१", "content_sanskrit": "राज्ञे निवेदयामास पुत्रं वृश्चिकपीडितम् ।\nततो धर्मसखो राजा श्रुत्वा वृत्तांतमीदृशम्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003952031, "chapter_id": 23952, "verse_number": "३-१-१५-३२", "content_sanskrit": "त्वरमाणः समुत्थाय सामात्यः सपुरोहितः ।\nप्रविश्यांतःपुरं सार्द्धं मांत्रिकैर्विषहा रिभिः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003952032, "chapter_id": 23952, "verse_number": "३-१-१५-३३", "content_sanskrit": "चिकित्सयामास सुतमौषधाद्यैरनेकशः ।\nजातस्वास्थ्यं ततः पुत्रं लालयित्वा स भूपतिः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003952033, "chapter_id": 23952, "verse_number": "३-१-१५-३४", "content_sanskrit": "मानयित्वा च मंत्रज्ञान्रत्नकां चनमौक्तिकैः ।\nनिष्क्रम्यांतःपुराद्राजा भृशं चिंतासमाकुलः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003952034, "chapter_id": 23952, "verse_number": "३-१-१५-३५", "content_sanskrit": "ऋत्विक्पुरोहितामात्यैस्तां सभां सनुपाविशत् ।\nतत्र धर्मसखो राजा समासीनो वरासने ।\nउवाचेदं वचो युक्तमृत्विजः सपुरोहितान्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003952035, "chapter_id": 23952, "verse_number": "३-१-१५-३६", "content_sanskrit": "धर्मसख उवाच ।\nदुःखायैवैकपुत्रत्वं भवति ब्राह्मणो त्तमाः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003952036, "chapter_id": 23952, "verse_number": "३-१-१५-३७", "content_sanskrit": "एकपुत्रत्वतो तृणां वरा चैव ह्यपुत्रता ।\nनित्यं व्यपाययुक्तत्वाद्वरमेव ह्यपुत्रता ।\nअहं भार्याशतं विप्रा उदवोढ विचिंत्य तु॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003952037, "chapter_id": 23952, "verse_number": "३-१-१५-३८", "content_sanskrit": "वयश्च समतिक्रांतं सपत्नीकस्य मे द्विजाः ।\nप्राणा मम च भार्याणामस्मिन्पुत्रे व्यवस्थिताः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003952038, "chapter_id": 23952, "verse_number": "३-१-१५-३९", "content_sanskrit": "तन्नाशे मम भार्याणां सर्वासां च मृतिर्ध्रुवा ।\nममापि प्राणनाशः स्यादेकपुत्रस्य मारणे॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003952039, "chapter_id": 23952, "verse_number": "३-१-१५-४०", "content_sanskrit": "अतो मे बहुपुत्रत्वं केनोपायेन वै भवेत् ।\nतमुपायं मम ब्रूत ब्राह्मणा वेदवि त्तमाः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003952040, "chapter_id": 23952, "verse_number": "३-१-१५-४१", "content_sanskrit": "एकैकः शतभार्यासु पुत्रो मे स्याद्यथा गुणी ।\nतत्कर्म व्रत यूयं तु शास्त्रमालोक्य धर्मतः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003952041, "chapter_id": 23952, "verse_number": "३-१-१५-४२", "content_sanskrit": "महता लघुना वापि कर्मणा दुष्करेण वा ।\nफलं यद्यपि तत्साध्यं करिष्येऽहं न संशयः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003952042, "chapter_id": 23952, "verse_number": "३-१-१५-४३", "content_sanskrit": "युष्माभिरुदितं कर्म करिष्यामि न संशयः ।\nकृतमेव हि तद्वित्त शपेऽहं सुकृतैर्मम॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003952043, "chapter_id": 23952, "verse_number": "३-१-१५-४४", "content_sanskrit": "अस्ति चेदीदृशं कर्म येन पुत्रशतं भवेत् ।\nतत्कर्म कुत्र कर्तव्यं मयेति वदताधुना॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003952044, "chapter_id": 23952, "verse_number": "३-१-१५-४५", "content_sanskrit": "इति पृष्टास्तदा राज्ञा ऋत्विजः सपुरोहिताः ।\nसंभूय सर्वे राजानमिदमूचुः सुनिश्चितम्॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003952045, "chapter_id": 23952, "verse_number": "३-१-१५-४६", "content_sanskrit": "ऋत्विज ऊचुः ।\nअस्ति राजन्प्रवक्ष्यामो येन पुत्रशतं तव ।\nभवेद्धर्मेण महता शतभार्यासु कैकय॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003952046, "chapter_id": 23952, "verse_number": "३-१-१५-४७", "content_sanskrit": "अस्ति कश्चिन्महापुण्यो गन्धमादनपर्वतः ।\nदक्षिणांबुधिमध्ये यः सेतुरूपेण वर्तते॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003952047, "chapter_id": 23952, "verse_number": "३-१-१५-४८", "content_sanskrit": "सिद्धचारणगंधर्वदेवर्षिगणसंकुलः ।\nदर्शनात्स्पर्शनान्नृणां महापातकनाशनः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003952048, "chapter_id": 23952, "verse_number": "३-१-१५-४९", "content_sanskrit": "तत्रास्ति हनुमत्कुंडमिति लोकेषु विश्रुतम् ।\nमहादुःखप्रशमनं स्वर्गमोक्षफलप्रदम्॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003952049, "chapter_id": 23952, "verse_number": "३-१-१५-५०", "content_sanskrit": "नरकक्लेशशमनं तथा दारिद्र्यमोचनम् ।\nपुत्रप्रदमपुत्राणामस्त्रीणां स्त्रीपदं नृणाम्॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003952050, "chapter_id": 23952, "verse_number": "३-१-१५-५१", "content_sanskrit": "तत्र त्वं प्रयतः स्नात्वा सर्वाभीष्टप्रदायिनीम् ।\nपुत्रीयेष्टिं च तत्तीरे कुरुष्व सुसमाहितः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003952051, "chapter_id": 23952, "verse_number": "३-१-१५-५२", "content_sanskrit": "तेन ते शतभार्यासु प्रत्येकं तनयो नृप ।\nएकैकस्तु भवेच्छीघ्रं मा कुरु ष्वात्र संशयम्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003952052, "chapter_id": 23952, "verse_number": "३-१-१५-५३", "content_sanskrit": "तथोक्तो नृपतिर्विप्रैऋत्विक्भिः सपुरोहितैः ।\nतत्क्षणेनैव ऋत्विक्भिर्भार्याभिश्च पुरोधसा॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003952053, "chapter_id": 23952, "verse_number": "३-१-१५-५४", "content_sanskrit": "वृतोमात्यैश्च भृत्यैश्च यज्ञसंभारसंयुतः ।\nप्रययौ दक्षिणांभोधौ गन्धमादनपर्वतम्॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003952054, "chapter_id": 23952, "verse_number": "३-१-१५-५५", "content_sanskrit": "हनुमत्कुंडमासाद्य तत्र सस्नौ ससैनिकः ।\nमासमात्रं स तत्तीरे न्यवस त्स्नानमाचरन्॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003952055, "chapter_id": 23952, "verse_number": "३-१-१५-५६", "content_sanskrit": "ततो वसंते संप्राप्ते चैत्रमासि नृपोत्तमः ।\nइष्टिमारब्धवांस्तत्र पुत्रीयां सपुरोहितः॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003952056, "chapter_id": 23952, "verse_number": "३-१-१५-५७", "content_sanskrit": "सम्यक्कर्माणि चक्रुस्ते ऋत्विजः सपुरोधसः ।\nसपत्नीकस्य राजर्षेस्तथाधर्मसखस्य तु॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003952057, "chapter_id": 23952, "verse_number": "३-१-१५-५८", "content_sanskrit": "इष्टौ तस्य समाप्तायां हनूमत्कुंडतीरतः ।\nपुरोहितो हुतोच्छिष्टं प्राश यद्राजयोषितः॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003952058, "chapter_id": 23952, "verse_number": "३-१-१५-५९", "content_sanskrit": "ततो धर्मसखो राजा हनूमत्कुंडवारिषु ।\nसम्यक्चकारावभृथस्नानं भार्याशतान्वितः॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003952059, "chapter_id": 23952, "verse_number": "३-१-१५-६०", "content_sanskrit": "ऋत्विक्भ्यो दक्षिणाः प्रादादसंख्यातास्तु भूरिशः ।\nग्रामांश्च प्रददौ राजा बाह्मणेभ्यो द्विजोत्तमाः॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003952060, "chapter_id": 23952, "verse_number": "३-१-१५-६१", "content_sanskrit": "सामात्यः सपरीवारः सपत्नीकः स धार्म्मिकः ।\nराजा ततो निववृते पुरीं स्वां प्रति नंदितः॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003952061, "chapter_id": 23952, "verse_number": "३-१-१५-६२", "content_sanskrit": "ततः कतिपये काले गते दशममामि वै ।\nशतं भार्याः शतं पुत्रान्सुषुवुर्गुणवत्तरान्॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003952062, "chapter_id": 23952, "verse_number": "३-१-१५-६३", "content_sanskrit": "अथ प्रीतमना राजा वीरो धर्मसखो महान् ।\nस्नातः शुद्धश्च संकल्प्य जातकर्माकरोत्तदा॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003952063, "chapter_id": 23952, "verse_number": "३-१-१५-६४", "content_sanskrit": "गोभूतिलहिरण्यादि ब्राह्मणेभ्यो ददौ बहु ।\nद्वौ पुत्रौ ज्येष्ठभार्यायाः पूर्वजोऽवरजस्तदा॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003952064, "chapter_id": 23952, "verse_number": "३-१-१५-६५", "content_sanskrit": "सर्वे ववृधिरे पुत्रा एकाधिकशतं द्विजाः ।\nप्रौढेषु तेषु राजासौ तेभ्यो राज्यं विभज्य तु॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003952065, "chapter_id": 23952, "verse_number": "३-१-१५-६६", "content_sanskrit": "दत्त्वा च प्रययौ सेतुं सभार्यो गन्धमादनम् ।\nहनुमत्कुंडमासाद्य तपोऽतप्यत तत्तटे॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003952066, "chapter_id": 23952, "verse_number": "३-१-१५-६७", "content_sanskrit": "महान्कालो व्यतीयाय राज्ञ स्तस्य तपस्यतः ।\nराज्ञो धर्मसखस्यास्य ध्यायमानस्य शूलिनम्॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003952067, "chapter_id": 23952, "verse_number": "३-१-१५-६८", "content_sanskrit": "ततो बहुतिथे काले गते धर्मसखो नृपः ।\nकालधर्मं ययौ तत्र धार्म्मिकश्शांतमानसः॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003952068, "chapter_id": 23952, "verse_number": "३-१-१५-६९", "content_sanskrit": "पत्न्योपि तस्य राजर्षेरनुजग्मुः पतिं तदा ।\nज्येष्ठपुत्रः सुचन्द्रोपि संस्कृत्य पितरं ततः॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003952069, "chapter_id": 23952, "verse_number": "३-१-१५-७०", "content_sanskrit": "अकरोच्छ्राद्ध पर्यंतं कर्माणि श्रद्धया सह ।\nराजा सभार्यो वैकुंठं मरणादत्र जग्मिवान्॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003952070, "chapter_id": 23952, "verse_number": "३-१-१५-७१", "content_sanskrit": "सुचन्द्रमुख्यास्ते सर्वे राजपुत्रा महौजसः ।\nस्वस्वराज्यं बुभुजिरे भ्रातरस्त्यक्तमत्सराः॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003952071, "chapter_id": 23952, "verse_number": "३-१-१५-७२", "content_sanskrit": "एवं वः कथितं विप्रा हनूमत्कुंडवैभवम् ।\nराज्ञो धर्मसखस्यापि चरित्रं परमाद्भुतम्॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003952072, "chapter_id": 23952, "verse_number": "३-१-१५-७३", "content_sanskrit": "तत्सर्वं कामसि द्ध्यर्थं स्नायात्कुंडे हनृमतः॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003952073, "chapter_id": 23952, "verse_number": "३-१-१५-७४", "content_sanskrit": "अध्यायमेनं पठते मनुष्यः शृणोति वा यः सुसमाहितो द्विजाः ।\nसोऽनंतमाप्नोति सुखं परत्र क्रीडेत सार्द्धं दिवि देववृन्दैः॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}]