[{"id": 7000481000, "chapter_id": 20481, "verse_number": "३-२८-१", "content_sanskrit": "नारद उवाच ।\nततो गच्छेत धर्म्मज्ञ धर्म्मतीर्थं पुरातनम् ।\nयत्र धर्मो महाभागस्तप्तवानुत्तमं तपः ॥१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000481001, "chapter_id": 20481, "verse_number": "३-२८-२", "content_sanskrit": "तेन तीर्थं कृतं पुण्यं स्वेन नाम्ना च चिह्नितम् ।\nतत्र स्नात्वा नरो राजन्धर्मशीलः समाहितः ॥२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000481002, "chapter_id": 20481, "verse_number": "३-२८-३", "content_sanskrit": "आसप्तमं कुलं चैव पुनीते नात्र संशयः ।\nततो गच्छेत धर्मज्ञ कलाप वनमुत्तमम् ॥३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000481003, "chapter_id": 20481, "verse_number": "३-२८-४", "content_sanskrit": "कृच्छ्रेण महता गत्वा तत्र स्नात्वा समाहितः ।\nअग्निष्टोममवाप्नोति विष्णुलोकं च गच्छति ॥४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000481004, "chapter_id": 20481, "verse_number": "३-२८-५", "content_sanskrit": "सौगंधिकं वनं राजंस्ततो गच्छेत मानवः ।\nयत्र ब्रह्मादयो देवा ऋषयश्च तपोधनाः ॥५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000481005, "chapter_id": 20481, "verse_number": "३-२८-६", "content_sanskrit": "सिद्धचारणगंधर्वाः किन्नराः स महोरगाः ।\nतद्वनं प्रविशन्नेव सर्वपापैः प्रमुच्यते ॥६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000481006, "chapter_id": 20481, "verse_number": "३-२८-७", "content_sanskrit": "ततो हि सा सरिच्छ्रेष्ठा नदीनामुत्तमा नदी ।\nप्लक्षादेवी स्मृता राजन्महा पुण्या सरस्वती ॥७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000481007, "chapter_id": 20481, "verse_number": "३-२८-८", "content_sanskrit": "तत्राभिषेकं कुर्वीत वल्मीकान्निःसृते जले ।\nअर्चयित्वा पितॄन्देवानश्वमेधफलं लभेत् ॥८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000481008, "chapter_id": 20481, "verse_number": "३-२८-९", "content_sanskrit": "ईशानाध्युषितं नाम तत्र तीर्थं सुदुर्लभम् ।\nषड्गुणं यन्निपातेषु वल्मीकादिति निश्चयः ॥९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000481009, "chapter_id": 20481, "verse_number": "३-२८-१०", "content_sanskrit": "कपिलानां सहस्रं च वाजिमेधं च विंदति ।\nतत्र स्नात्वा नरव्याघ्र दृष्टमेतत्पुरातनैः ॥१० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000481010, "chapter_id": 20481, "verse_number": "३-२८-११", "content_sanskrit": "सुगंधां शतकुंभां च पंचयज्ञं च भारत ।\nअभिगम्य नरश्रेष्ठ स्वर्गलोके महीयते ॥११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000481011, "chapter_id": 20481, "verse_number": "३-२८-१२", "content_sanskrit": "त्रिशूलपात्रं तत्रैव तीर्थमासाद्य दुर्लभम् ।\nतत्राभिषेकं कुर्वीत पितृदेवार्चने रतः ॥१२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000481012, "chapter_id": 20481, "verse_number": "३-२८-१३", "content_sanskrit": "गाणपत्यं च लभते देहं त्यक्त्वा न संशयः ।\nततो राजगृहं गच्छेद्देव्याः स्थानं सुदुर्लभम् ॥१३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000481013, "chapter_id": 20481, "verse_number": "३-२८-१४", "content_sanskrit": "शाकंभरीति विख्याता त्रिषुलोकेषु विश्रुता ।\nदिव्यं वर्षसहस्रं च शाकेन किल भारत ॥१४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000481014, "chapter_id": 20481, "verse_number": "३-२८-१५", "content_sanskrit": "आहारं सा कृतवती मासिमासि नराधिप ।\nऋषयोऽभ्यागतास्तत्र देव्या भक्तास्तपोधनाः ॥१५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000481015, "chapter_id": 20481, "verse_number": "३-२८-१६", "content_sanskrit": "आतिथ्यं च कृतं तेषां शाकेन किल भारत ।\nततः शाकंभरीत्येवं नाम तस्याः प्रतिष्ठितम् ॥१६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000481016, "chapter_id": 20481, "verse_number": "३-२८-१७", "content_sanskrit": "शाकंभरीं समासाद्य ब्रह्मचारी समाहितः ।\nत्रिरात्रमुषितः शाकं भक्षयेन्नियतः शुचिः ॥१७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000481017, "chapter_id": 20481, "verse_number": "३-२८-१८", "content_sanskrit": "शाकाहारस्य यत्सम्यग्वर्षैर्द्वादशभिः फलम् ।\nतत्फलं तस्य भवति देव्याश्छंदेन भारत ॥१८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000481018, "chapter_id": 20481, "verse_number": "३-२८-१९", "content_sanskrit": "ततो गच्छेत्सुवर्णाख्यं त्रिषुलोकेषु विश्रुतम् ।\nयत्र कृष्णः प्रसादार्थं रुद्रमाराधयत्पुरा ॥१९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000481019, "chapter_id": 20481, "verse_number": "३-२८-२०", "content_sanskrit": "वरांश्च सुबहूंल्लेभे देवैरपि स दुर्ल्लभान् ।\nउक्तश्च त्रिपुरघ्नेन परितुष्टेन भारत ॥२० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000481020, "chapter_id": 20481, "verse_number": "३-२८-२१", "content_sanskrit": "अपि चात्माप्रियतरो लोके कृष्ण भविष्यसि ।\nत्वन्मुखं च जगत्कृत्स्नं भविष्यति न संशयः ॥२१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000481021, "chapter_id": 20481, "verse_number": "३-२८-२२", "content_sanskrit": "तत्राभिगम्य राजेंद्र पूजयित्वा वृषध्वजम् ।\nअश्वमेधमवाप्नोति गाणपत्यं च विंदति ॥२२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000481022, "chapter_id": 20481, "verse_number": "३-२८-२३", "content_sanskrit": "धूमावतीं ततो गच्छेत्त्रिरात्रमुषितो नरः ।\nमनसा प्रार्थितान्कामांल्लभते नात्र संशयः ॥२३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000481023, "chapter_id": 20481, "verse_number": "३-२८-२४", "content_sanskrit": "देव्यास्तु दक्षिणार्धे नरथावर्त्तो नराधिप ।\nतत्रागत्य तु धर्मज्ञ श्रद्दधानो जितेंद्रियः ॥२४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000481024, "chapter_id": 20481, "verse_number": "३-२८-२५", "content_sanskrit": "महादेवप्रसादेन गच्छेत परमां गतिम् ।\nप्रदक्षिणमुपावृत्य गच्छेत भरतर्षभ ॥२५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]