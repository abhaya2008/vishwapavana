[{"id": 2105935, "chapter_id": 3293, "verse_number": "१६-२२-१", "content_sanskrit": "वैशम्पायन उवाच।\nनारदस्य तु तद्वाक्यं शशंसुर्द्विजसत्तमाः।\nशतयूपस्तु राजर्षिर्नारदं वाक्यमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2105936, "chapter_id": 3293, "verse_number": "१६-२२-२", "content_sanskrit": "अहो भगवता श्रद्धा कुरुराजस्य वर्धिता।\nसर्वस्य च जनस्यास्य मम चैव महाद्युते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2105937, "chapter_id": 3293, "verse_number": "१६-२२-३", "content_sanskrit": "अस्ति काचिद्विवक्षा तु तां मे निगदतः शृणु।\nधृतराष्ट्रं प्रति नृपं देवर्षे लोकपूजित॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2105938, "chapter_id": 3293, "verse_number": "१६-२२-४", "content_sanskrit": "सर्ववृत्तान्ततत्त्वज्ञो भवान्दिव्येन चक्षुषा।\nयुक्तः पश्यसि विप्रर्षे गतयो विविधा नृणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2105939, "chapter_id": 3293, "verse_number": "१६-२२-५", "content_sanskrit": "उक्तवान्नृपतीनां त्वं महेन्द्रस्य सलोकताम्।\nन त्वस्य नृपतेर्लोकाः कथितास्ते महामुने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2105940, "chapter_id": 3293, "verse_number": "१६-२२-६", "content_sanskrit": "स्थानमप्यस्य नृपतेः श्रोतुमिच्छाम्यहं विभो।\nत्वत्तः कीदृक्कदा चेति तन्ममाख्याहि तत्त्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2105941, "chapter_id": 3293, "verse_number": "१६-२२-७", "content_sanskrit": "इत्युक्तो नारदस्तेन वाक्यं सर्वमनोनुगम्।\nव्याजहार सभामध्ये दिव्यदर्शी महातपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2105942, "chapter_id": 3293, "verse_number": "१६-२२-८x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2105943, "chapter_id": 3293, "verse_number": "१६-२२-८", "content_sanskrit": "यदृच्छया शक्रसदो गत्वा शक्रं शचीपतिम्।\nदृष्टवानस्मि राजर्षे तत्र पाण्डुं नराधिपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2105944, "chapter_id": 3293, "verse_number": "१६-२२-९", "content_sanskrit": "तत्रेयं धृतराष्ट्रस्य कथा समभवन्नप।\nतपसो दुष्करस्यास्य यदयं तपते नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2105945, "chapter_id": 3293, "verse_number": "१६-२२-१०", "content_sanskrit": "तत्राहमिदमश्रौषं शक्रस्य वदतः स्वयम्।\nवर्षाणि त्रीणि शिष्टानि राज्ञोस्य परमायुषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2105946, "chapter_id": 3293, "verse_number": "१६-२२-११", "content_sanskrit": "ततः कुबेरभवनं गान्धारीसहितो नृपः।\nप्रयाता धृतराष्ट्रोऽयं राजराजाभिसत्कृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2105947, "chapter_id": 3293, "verse_number": "१६-२२-१२", "content_sanskrit": "कामगेन विमानेन दिव्याभरणभूषितः।\nऋषिपुत्रो महाभागस्तपसा दग्धकिल्बिषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2105948, "chapter_id": 3293, "verse_number": "१६-२२-१३", "content_sanskrit": "सञ्चरिष्यति लोकांश्च देवगन्धर्वरक्षसाम्।\nस्वच्छन्देनेति धर्मात्मा व्यासस्य तु तपोबलात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2105949, "chapter_id": 3293, "verse_number": "१६-२२-१४", "content_sanskrit": "देवगुह्यमिदं प्रीत्या मया वः कथितं महत्।\nभवन्तो हि श्रुतधनास्तपसा दग्धकिल्बिषाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2105950, "chapter_id": 3293, "verse_number": "१६-२२-१५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2105951, "chapter_id": 3293, "verse_number": "१६-२२-१५", "content_sanskrit": "इति ते तस्य तच्छ्रुत्वा देवर्षेर्मधुरं वचः।\nसर्वे सुमनसः प्रीता बभूवुः स च पार्थिवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2105952, "chapter_id": 3293, "verse_number": "१६-२२-१६", "content_sanskrit": "एवं कथाभिरन्वास्य धृतराष्ट्रं मनीषिणः।\nविप्रजग्मुर्यथाकामं ते सिद्धगतिमास्थिताः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2105953, "chapter_id": 3293, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्रमवासिकपर्वणि आश्रमवासपर्वणि द्वाविंशोऽध्यायः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]