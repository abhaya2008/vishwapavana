[{"id": 7004000000, "chapter_id": 24000, "verse_number": "३-२-११-१", "content_sanskrit": "युधिष्ठिर उवाच ।\nअतः परं किमभवद्ब्रवीतु द्विजसत्तम ।\nत्वद्वचनामृतं पीत्वा तृप्तिर्नास्ति मम प्रभो॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004000001, "chapter_id": 24000, "verse_number": "३-२-११-२", "content_sanskrit": "व्यास उवाच ।\nअथ किंचिद्गते काले युगांतसमये सति ।\nत्रेतादौ लोलजिह्वाक्ष अभवद्राक्षसेश्वरः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004000002, "chapter_id": 24000, "verse_number": "३-२-११-३", "content_sanskrit": "तेन विद्रावितं सर्वं त्रैलोक्यं सचराचरम् ।\nजित्वा स सकलांल्लोकान्धर्मारण्ये समागतः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004000003, "chapter_id": 24000, "verse_number": "३-२-११-४", "content_sanskrit": "तद्दृष्ट्वा सकलं पुण्यं रम्यं द्विजनिषे वितम् ।\nब्रह्मद्वेषाच्च तेनैव दाहितं च पुरं शुभम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004000004, "chapter_id": 24000, "verse_number": "३-२-११-५", "content_sanskrit": "दह्यमानं पुरं दृष्ट्वा प्रणष्टा द्विजसत्तमाः ।\nयथागतं प्रजग्मुस्ते धर्मारण्यनिवासिनः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004000005, "chapter_id": 24000, "verse_number": "३-२-११-६", "content_sanskrit": "श्रीमाताद्यास्तदा देव्यः कोपिता राक्षसेन वै ।\nघातयंत्येव शब्देन तर्जयित्वा च राक्षसम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004000006, "chapter_id": 24000, "verse_number": "३-२-११-७", "content_sanskrit": "समुच्छ्रितास्तदा देव्यः शतशोऽथ सह स्रशः ।\nत्रिशूलवरधारिण्यः शंखचक्रगदाधराः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004000007, "chapter_id": 24000, "verse_number": "३-२-११-८", "content_sanskrit": "कमंडलुधराः काश्चित्कशाखङ्गधराः पराः ।\nपाशांकुशधरा काचित्खड्गखेटकधारिणी॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004000008, "chapter_id": 24000, "verse_number": "३-२-११-९", "content_sanskrit": "काचित्परशुहस्ता च दिव्यायुधधरा परा ।\nनानाभरणभूषाढ्या नानारत्नाभिशोभिता॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004000009, "chapter_id": 24000, "verse_number": "३-२-११-१०", "content_sanskrit": "राक्षसानां विनाशाय ब्राह्मणानां हिताय च ।\nआजग्मुस्तत्र यत्रास्ते लोलजिह्वो हि राक्षसः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004000010, "chapter_id": 24000, "verse_number": "३-२-११-११", "content_sanskrit": "महादंष्ट्रो महाकायो विद्युज्जिह्वो भयंकरः ।\nदृष्ट्वा ता राक्षसो घोरं सिंहनादमथाकरोत्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004000011, "chapter_id": 24000, "verse_number": "३-२-११-१२", "content_sanskrit": "तेन नादेन महता त्रासितं भुवनत्रयम् ।\nआपूरिता दिशः सर्वाः क्षुभितानेकसागराः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004000012, "chapter_id": 24000, "verse_number": "३-२-११-१३", "content_sanskrit": "कोलाहलो महानासीद्धर्मारण्ये तदा नृप ।\nतच्छ्रुत्वा वासवेनाथ प्रेषितो नलकूबरः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004000013, "chapter_id": 24000, "verse_number": "३-२-११-१४", "content_sanskrit": "किमिदं पश्य गत्वा त्वं दृष्ट्वा मह्यं निवेदय ।\nतत्तस्य वचनं श्रुत्वा गतो वै नलकूबरः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004000014, "chapter_id": 24000, "verse_number": "३-२-११-१५", "content_sanskrit": "दृष्ट्वा तत्र महायुद्धं श्रीमातालोलजिह्वयोः ।\nयथादृष्टं यथाजातं शक्राग्रे स न्यवेदयत्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004000015, "chapter_id": 24000, "verse_number": "३-२-११-१६", "content_sanskrit": "उद्वेजयति लोकांस्त्रीन्धर्मारण्यमितो गतः ।\nतच्छ्रुत्वा वासवो विष्णुं निवेद्य क्षितिमागमत्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004000016, "chapter_id": 24000, "verse_number": "३-२-११-१७", "content_sanskrit": "दाहितं तत्पुरं रम्यं देवानामपि दुर्लभम् ।\nन दृष्टा वाडवास्तत्र गताः सर्वे दिशो दश॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004000017, "chapter_id": 24000, "verse_number": "३-२-११-१८", "content_sanskrit": "श्रीमाता योगिनी तत्र कुरुते युद्धमुत्तमम् ।\nहाहाभूता प्रजा सर्वा इतश्चेतश्च धावति॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004000018, "chapter_id": 24000, "verse_number": "३-२-११-१९", "content_sanskrit": "तच्छ्रुत्वा वासुदेवो हि गृहीत्वा च सुदर्शनम् ।\nसत्यलोकात्तदा राजन्समागच्छन्महीतले॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004000019, "chapter_id": 24000, "verse_number": "३-२-११-२०", "content_sanskrit": "धर्मारण्यं ततो गत्वा तच्चक्रं प्रमुमोच ह ।\nलोलजिह्वस्तदा रक्षो मूर्च्छितो निपपात ह॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004000020, "chapter_id": 24000, "verse_number": "३-२-११-२१", "content_sanskrit": "त्रिशूलेन ततो भिन्नः शक्तिभिः क्रोधमूर्च्छितः ।\nहन्यमानस्तदा रक्षः प्राणांस्त्यक्त्वा दिवं गतः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004000021, "chapter_id": 24000, "verse_number": "३-२-११-२२", "content_sanskrit": "ततो देवाः सगंधर्वा हर्षनिर्भरमानसाः ।\nतुष्टुवुस्तं जगन्नाथं सत्यलोकात्समागताः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004000022, "chapter_id": 24000, "verse_number": "३-२-११-२३", "content_sanskrit": "उद्वसं तत्समालोक्य विष्णुर्वचनमब्रवीत् ।\nक्व च ते ब्राह्मणाः सर्वे ऋषीणामाश्रमे पुनः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004000023, "chapter_id": 24000, "verse_number": "३-२-११-२४", "content_sanskrit": "ततो देवाः सगं धर्वा इतस्ततः पलायितान् ।\nसंशोध्य तरसा राजन्ब्राह्मणानिदमब्रुवन्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004000024, "chapter_id": 24000, "verse_number": "३-२-११-२५", "content_sanskrit": "श्रूयतां नो वचो विप्रा निहतो राक्षसाधमः ।\nवासुदेवेन देवेन चक्रेण निरकृंतत॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004000025, "chapter_id": 24000, "verse_number": "३-२-११-२६", "content_sanskrit": "तच्छ्रुत्वा वाडवाः सर्वे प्रहर्षोत्फुल्ललोचनाः ।\nसमाजग्मुस्तदा राजन्स्वस्वस्थाने समाविशन्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004000026, "chapter_id": 24000, "verse_number": "३-२-११-२७", "content_sanskrit": "श्रीकांताय तदा राजन्वाक्यमुक्तं मनोरमम् ।\nयस्मात्त्वं सत्यलोकाच्च आगतोऽसि जगत्प्रभुः ।\nस्थापितं च पुरं चेदं हिताय च द्विजात्मनाम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004000027, "chapter_id": 24000, "verse_number": "३-२-११-२८", "content_sanskrit": "सत्यमंदिरमिति ख्यातं तदा लोके भविष्यति ।\nकृते युगे धर्मारण्यं त्रेतायां सत्यमंदिरम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004000028, "chapter_id": 24000, "verse_number": "३-२-११-२९", "content_sanskrit": "तच्छ्रुत्वा वासुदेवेन तथेति प्रतिपद्य च ।\nततस्ते वाडवाः सर्वे पुत्रपौत्रसमन्विताः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004000029, "chapter_id": 24000, "verse_number": "३-२-११-३०", "content_sanskrit": "सपत्नीकाः सानुचरा यथापूर्वं न्यवात्सिषुः ।\nतपोयज्ञक्रियाद्येषु वर्तंतेऽध्ययनादिषु॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004000030, "chapter_id": 24000, "verse_number": "३-२-११-३१", "content_sanskrit": "एवं ते सर्वमाख्यातं धर्म वै सत्यमंदिरे॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]