[{"id": 7000606000, "chapter_id": 20606, "verse_number": "५-६५-१", "content_sanskrit": "शेष उवाच ।\nक्षणान्मूर्च्छां जहौ वीरः शत्रुघ्नः समरांगणे ।\nअन्येऽपि वीराबलिनो मूर्च्छां प्राप्ताः सुजीविताः॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000606001, "chapter_id": 20606, "verse_number": "५-६५-२", "content_sanskrit": "शत्रुघ्नो वाजिनां श्रेष्ठं ददर्श पुरतः स्थितम् ।\nआत्मानं च शिरस्त्राणरहितं सैन्यजीवितम्॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000606002, "chapter_id": 20606, "verse_number": "५-६५-३", "content_sanskrit": "वीक्ष्य चित्रमिदं स्वांते चकारच जगाद ह ।\nसुमतिं मंत्रिणां श्रेष्ठं मूर्च्छाविरहितं तदा॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000606003, "chapter_id": 20606, "verse_number": "५-६५-४", "content_sanskrit": "कृपां कृत्वा हयं प्रादाद्बालो यज्ञस्य पूर्तये ।\nगच्छाम रामं तरसा हयागमनकांक्षिणम्॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000606004, "chapter_id": 20606, "verse_number": "५-६५-५", "content_sanskrit": "इत्युक्त्वा स रथे स्थित्वा हयमादाय वेगतः ।\nययौ तदाश्रमाद्दूरं भेरीशंखविवर्जितः॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000606005, "chapter_id": 20606, "verse_number": "५-६५-६", "content_sanskrit": "तत्पृष्ठतो महासैन्यं चतुरंगसमन्वितम् ।\nचचाल कुर्वन्संभग्नं स्वभारेण फणीश्वरम्॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000606006, "chapter_id": 20606, "verse_number": "५-६५-७", "content_sanskrit": "जवेन जाह्नवीं तीर्त्वा कल्लोलजलशालिनीम् ।\nजगाम विषये स्वीये स्वकीयजनशोभिते॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000606007, "chapter_id": 20606, "verse_number": "५-६५-८", "content_sanskrit": "पुष्कलेन युतो राजा सुरथेन समन्वितः ।\nरथे मणिमये तिष्ठन्महत्कोदंडधारकः॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000606008, "chapter_id": 20606, "verse_number": "५-६५-९", "content_sanskrit": "हयं तं पुरतः कृत्वा रत्नमालाविभूषितम् ।\nश्वेतातपत्रं तस्यैव मूर्ध्नि चामरभूषितम्॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000606009, "chapter_id": 20606, "verse_number": "५-६५-१०", "content_sanskrit": "अनेकरथसाहस्रैः परितो बलिभिर्नृपैः ।\nउद्यत्कोदंडललितैर्वीरनादविभूषितैः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000606010, "chapter_id": 20606, "verse_number": "५-६५-११", "content_sanskrit": "क्रमेण नगरीं प्राप सूर्यवंशविभूषिताम् ।\nअनेकैः केतुभिः श्रेष्ठैर्भूषितां दुर्गराजिताम्॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000606011, "chapter_id": 20606, "verse_number": "५-६५-१२", "content_sanskrit": "रामः श्रुत्वा हयं प्राप्तं शत्रुघ्नेन सहामुना ।\nपुष्कलेन च वीरेण ययौ हर्षमनेकधा॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000606012, "chapter_id": 20606, "verse_number": "५-६५-१३", "content_sanskrit": "कटकं निर्दिदेशासौ चतुरंगं महाबलम् ।\nलक्ष्मणं प्रेषयामास भ्रातरं बलिनां वरम्॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000606013, "chapter_id": 20606, "verse_number": "५-६५-१४", "content_sanskrit": "लक्ष्मणः सैन्यसहितो गत्वा भ्रातरमागतम् ।\nपरिरेभे मुदाक्रांतः क्षतशोभितगात्रकम्॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000606014, "chapter_id": 20606, "verse_number": "५-६५-१५", "content_sanskrit": "सर्वत्र कुशलं पृष्टो वार्तां चात्र चकार सः ।\nपरमं हर्षमापन्नः शत्रुघ्नः संगतो मुदा॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000606015, "chapter_id": 20606, "verse_number": "५-६५-१६", "content_sanskrit": "सौमित्रिः स्वरथे स्थित्वा भ्रात्रा सह महामनाः ।\nसैन्येन महता वीरो ययौ स्वनगरीं प्रति॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000606016, "chapter_id": 20606, "verse_number": "५-६५-१७", "content_sanskrit": "सरयूः पुण्यसलिला पवित्रित जगत्त्रया ।\nरामपादरजः पूता शरच्चंद्रसमप्रभा॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000606017, "chapter_id": 20606, "verse_number": "५-६५-१८", "content_sanskrit": "हंसकारंडवाकीर्णा चक्रवाकोपशोभिता ।\nविचित्रतरवर्णैश्च पक्षिभिर्नादिता भृशम्॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000606018, "chapter_id": 20606, "verse_number": "५-६५-१९", "content_sanskrit": "मंडपास्तत्र बहुशो रामचंद्रेणकारिताः ।\nब्राह्मणानां वेदविदां पृथक्पाठनिनादकाः॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000606019, "chapter_id": 20606, "verse_number": "५-६५-२०", "content_sanskrit": "क्षत्रियास्तत्र बहवो धनुःपाणि सुशोभिताः ।\nज्याटंकारेण बहुना नादयंतो महीतलम्॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000606020, "chapter_id": 20606, "verse_number": "५-६५-२१", "content_sanskrit": "भुंजते ब्राह्मणा यत्र विचित्रान्नैर्मनोहरैः ।\nपरस्परं प्रपश्यंतो वार्तां चक्रुर्मनोहराम्॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000606021, "chapter_id": 20606, "verse_number": "५-६५-२२", "content_sanskrit": "पायसान्नानि शुभ्राणि चंद्रकांतिसमानि च ।\nक्षीराज्यबहुयुक्तानि शर्करामिश्रितानि च॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000606022, "chapter_id": 20606, "verse_number": "५-६५-२३", "content_sanskrit": "अपूपास्तत्र बहुलाश्चंद्रबिंबसमाः श्रिया ।\nकर्पूरादिसुगंधेन वासिताः सुमनोहराः॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000606023, "chapter_id": 20606, "verse_number": "५-६५-२४", "content_sanskrit": "फेनिकाघटकाः स्निग्धाः शतच्छिद्रा विरंध्रकाः ।\nशष्कुल्यो मंडकामृष्टा मधुरान्नसमन्विताः॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000606024, "chapter_id": 20606, "verse_number": "५-६५-२५", "content_sanskrit": "भक्तं कुमुदसंकाशं मुद्गदालिविमिश्रितम् ।\nसुगंधेन समायुक्तमत्यंतं प्रीतिदायकम्॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000606025, "chapter_id": 20606, "verse_number": "५-६५-२६", "content_sanskrit": "ओदनो दधिना युक्तो भीमसेनसमन्वितः ।\nस्वादुपाककरैः सृष्टः पात्रे मुक्तः प्रवेषकैः॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000606026, "chapter_id": 20606, "verse_number": "५-६५-२७", "content_sanskrit": "तत्र केचिद्द्विजाः पात्रे निक्षिप्तं वीक्ष्य पायसम् ।\nपरस्परं ते प्रत्यूचुः किमिदं दृश्यतेऽद्भुतम्॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000606027, "chapter_id": 20606, "verse_number": "५-६५-२८", "content_sanskrit": "किं चंद्रबिंबं नभसः पतितं तमसो भयात् ।\nअमृतं तु भवत्यत्र मृत्युनाशकमद्भुतम्॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000606028, "chapter_id": 20606, "verse_number": "५-६५-२९", "content_sanskrit": "तच्छ्रुत्वा रोषताम्राक्षः प्रोवाचान्यो द्विजोत्तमः ।\nनभवत्येव चंद्रस्य बिंबं त्वमृतविप्लुतम्॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000606029, "chapter_id": 20606, "verse_number": "५-६५-३०", "content_sanskrit": "एकमिंदोर्वपुस्त्वेतद्दृश्यते सदृशं कथम् ।\nब्राह्मणानां सहस्रस्य पात्रे पात्रे पृथक्पृथक्॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000606030, "chapter_id": 20606, "verse_number": "५-६५-३१", "content_sanskrit": "ततो जानीहि कुमुदं कर्पूरं वा भविष्यति ।\nमा जानीहि मृगांकस्य बिंबं शुभ्रश्रियान्वितम्॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000606031, "chapter_id": 20606, "verse_number": "५-६५-३२", "content_sanskrit": "तावदन्यो रुषाक्रांतो धुन्वन्स्वं मस्तकं तथा ।\nन जानंति द्विजा मूढाः स्वादुज्ञाना विचक्षणाः॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000606032, "chapter_id": 20606, "verse_number": "५-६५-३३", "content_sanskrit": "इदं तु क्षौद्रकंदस्यरसेन परिपाचितम् ।\nजानीहि शतपत्रस्य पुष्पाणि मधुराणि च॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000606033, "chapter_id": 20606, "verse_number": "५-६५-३४", "content_sanskrit": "एवं परस्परं विप्राः कंदमूलफलाशिनः ।\nतर्कयंति मुने प्रीता रसज्ञानेऽतिलोलुपाः॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000606034, "chapter_id": 20606, "verse_number": "५-६५-३५", "content_sanskrit": "तावदन्यो द्विजः प्राह क्षत्त्रियाणां वरं जनुः ।\nभोक्ष्यंते तादृशं त्वन्नं महत्पुण्यैरुपस्कृतम्॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000606035, "chapter_id": 20606, "verse_number": "५-६५-३६", "content_sanskrit": "तदा तं प्राब्रवीद्विप्रो दत्तस्य फलमीदृशम् ।\nये ददत्यग्रजन्मभ्यः प्राप्नुवंति त ईप्सितम्॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000606036, "chapter_id": 20606, "verse_number": "५-६५-३७", "content_sanskrit": "यैरर्चितो नैव हरिर्नैवेद्यैर्विविधैर्मुहुः ।\nतेषामेतादृशं भोज्यं न भवेदक्षिगोचरम्॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000606037, "chapter_id": 20606, "verse_number": "५-६५-३८", "content_sanskrit": "यैर्नरैरग्रजन्मानो भोजिता विविधै रसैः ।\nभुंजते ते स्वादुरसं पापिनां चक्षुरुज्झितम्॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000606038, "chapter_id": 20606, "verse_number": "५-६५-३९", "content_sanskrit": "एवंविधैरसैर्मिष्टैर्भोजिता द्विजसत्तमाः ।\nमंडपे विपठंतस्ते शब्दब्रह्मविचक्षणाः॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000606039, "chapter_id": 20606, "verse_number": "५-६५-४०", "content_sanskrit": "नृत्यंत्येके हसन्त्येके नदन्त्येके प्रहर्षिताः ।\nउत्सवो बहुरुद्भाति तत्र शत्रुघ्न आगमत्॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000606040, "chapter_id": 20606, "verse_number": "५-६५-४१", "content_sanskrit": "रामः शत्रुघ्नमायांतं पुष्कलेन समन्वितम् ।\nनिरीक्ष्यमुदमुद्भूतां रक्षितुं नाशकत्तदा॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000606041, "chapter_id": 20606, "verse_number": "५-६५-४२", "content_sanskrit": "यावदुत्तिष्ठते रामो भ्रातरं हयपालकम् ।\nतावद्रामपदेलग्नः शत्रुघ्नो भ्रातृवत्सलः॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000606042, "chapter_id": 20606, "verse_number": "५-६५-४३", "content_sanskrit": "पादयोः पतितं वीक्ष्य भ्रातरं विनयान्वितम् ।\nपरिरेभे दृढं प्रीतः क्षतसंशोभितांगकम्॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000606043, "chapter_id": 20606, "verse_number": "५-६५-४४", "content_sanskrit": "अश्रूणि बहुधा मुंचन्हर्षाच्छिरसि राघवः ।\nअत्यंतं परमां प्राप मुदं वचनदूरगाम्॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000606044, "chapter_id": 20606, "verse_number": "५-६५-४५", "content_sanskrit": "पुष्कलं स्वीयपदयोर्नम्रं विनयविह्वलः ।\nसुदृढं भुजयोर्मध्ये विनीयापीडयद्भृशम्॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000606045, "chapter_id": 20606, "verse_number": "५-६५-४६", "content_sanskrit": "हनूमंतं तथा वीरं सुग्रीवं चांगदं तथा ।\nलक्ष्मीनिधिं जनकजं प्रतापाग्र्यं रिपुंजयम्॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000606046, "chapter_id": 20606, "verse_number": "५-६५-४७", "content_sanskrit": "सुबाहुं सुमदं वीरं विमलं नीलरत्नकम् ।\nसत्यवंतं वीरमणिं सुरथं रामसेवकम्॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000606047, "chapter_id": 20606, "verse_number": "५-६५-४८", "content_sanskrit": "अन्यानपि महाभागान्रघुनाथः स्वयं तदा ।\nपरिरेभे दृढं स्निग्धान्पादयोः प्रणतान्नृपान्॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000606048, "chapter_id": 20606, "verse_number": "५-६५-४९", "content_sanskrit": "सुमतिः श्रीरघुपतिं भक्तानुग्रहकारकम् ।\nपरिरभ्य दृढं प्रीतः संमुखे तिष्ठदुन्नतः॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000606049, "chapter_id": 20606, "verse_number": "५-६५-५०", "content_sanskrit": "तदा रामो निजामात्यं वीक्ष्य सान्निध्यमागतम् ।\nउवाच परमप्रीत्या मंत्रिणं वदतां वरः॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000606050, "chapter_id": 20606, "verse_number": "५-६५-५१", "content_sanskrit": "सुमते मंत्रिणां श्रेष्ठ शंश मे वाग्मिनां वर ।\nक एते भूमिपाः सर्वे कथमत्र समागताः॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000606051, "chapter_id": 20606, "verse_number": "५-६५-५२", "content_sanskrit": "कुत्रकुत्र हयः प्राप्तः केनकेन नियंत्रितः ।\nकथं वै मोचितो भ्रात्रा महाबलसुशालिना॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000606052, "chapter_id": 20606, "verse_number": "५-६५-५३", "content_sanskrit": "शेष उवाच ।\nइत्युक्तो मंत्रिणां श्रेष्ठः सुमतिः प्राह राघवम् ।\nप्रहसन्मेघगंभीर नादेन च सुबुद्धिमान्॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000606053, "chapter_id": 20606, "verse_number": "५-६५-५४", "content_sanskrit": "सुमतिरुवाच ।\nसर्वज्ञस्य पुरस्तेऽद्य मया कथमुदीर्यते ।\nपृच्छसि त्वं लोकरीत्या सर्वं जानासि सर्वदृक्॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000606054, "chapter_id": 20606, "verse_number": "५-६५-५५", "content_sanskrit": "तथापि तव निर्देशं शिरस्याधाय सर्वदा ।\nब्रवीमि तच्छृणुष्वाद्य सर्वराजशिरोमणे॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000606055, "chapter_id": 20606, "verse_number": "५-६५-५६", "content_sanskrit": "त्वत्प्रसादादहो स्वामिन्सर्वत्र जगतीतले ।\nपरिबभ्राम ते वाहो भालपत्रसुशोभितः॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000606056, "chapter_id": 20606, "verse_number": "५-६५-५७", "content_sanskrit": "न कश्चित्तं निजग्राह स्वनामबलदर्पितः ।\nस्वं स्वं राज्यं समर्प्याथ प्रणेमुस्ते पदांबुजम्॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000606057, "chapter_id": 20606, "verse_number": "५-६५-५८", "content_sanskrit": "को वा रावण दैत्येंद्र निहंतुर्वाजिसत्तमम् ।\nगृह्णाति विजयाकांक्षी जरामरणवर्जितः॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000606058, "chapter_id": 20606, "verse_number": "५-६५-५९", "content_sanskrit": "अहिच्छत्रां गतस्तावत्तव वाजी मनोरमः ।\nतद्राजा सुमदः श्रुत्वा हयं प्राप्तं तव प्रभो॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000606059, "chapter_id": 20606, "verse_number": "५-६५-६०", "content_sanskrit": "सपुत्रः प्रबलः सर्वसैन्येन बलिना वृतः ।\nसर्वं समर्पयामास राज्यं निहतकंटकम्॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000606060, "chapter_id": 20606, "verse_number": "५-६५-६१", "content_sanskrit": "यो राजा जगतां नेत्रीं मातरं जगदंबिकाम् ।\nप्रसाद्य चिरमायुष्यं लेभे राज्यमकंटकम्॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000606061, "chapter_id": 20606, "verse_number": "५-६५-६२", "content_sanskrit": "स एष त्वां प्रणमति सुमदः प्रभुसेवितम् ।\nतं गृहाण कृपादृष्ट्या चिराद्दर्शनकांक्षकम्॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000606062, "chapter_id": 20606, "verse_number": "५-६५-६३", "content_sanskrit": "ततः सुबाहुभूपस्य नगरे बलपूरिते ।\nदमनस्तस्य वै पुत्रः प्रजग्राह हयोत्तमम्॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000606063, "chapter_id": 20606, "verse_number": "५-६५-६४", "content_sanskrit": "तेन साकं महद्युद्धं बभूव दमनेन च ।\nपुष्कलो जयमापेदे संमूर्छ्य सुभुजात्मजम्॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000606064, "chapter_id": 20606, "verse_number": "५-६५-६५", "content_sanskrit": "ततः सुबाहुः संक्रुद्धो रणे पवनजं बलात् ।\nयुयुधे तव पादाब्जसेवकं बलिनां वरम्॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000606065, "chapter_id": 20606, "verse_number": "५-६५-६६", "content_sanskrit": "तस्य पादाहतो ज्ञानं प्राप्य शापतिरस्कृतम् ।\nतुभ्यं समर्प्य सकलं वाजिनः पालकोऽभवत्॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000606066, "chapter_id": 20606, "verse_number": "५-६५-६७", "content_sanskrit": "एष त्वां सुभुजो राजा प्रणमत्युन्नतांगकः ।\nकृपादृष्ट्याभिषिंच त्वं सुबाहुं नयकोविदम्॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000606067, "chapter_id": 20606, "verse_number": "५-६५-६८", "content_sanskrit": "ततो मुक्तो हयो रेवाह्रदे स निममज्ज ह ।\nतत्र प्राप्तं मोहनास्त्रं शत्रुघ्नेन बलीयसा॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000606068, "chapter_id": 20606, "verse_number": "५-६५-६९", "content_sanskrit": "ततो देवपुरे प्रागाच्छिववासविभूषिते ।\nतत्रत्यं तु विजानासि यतस्त्वं तत्र चागतः॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000606069, "chapter_id": 20606, "verse_number": "५-६५-७०", "content_sanskrit": "विद्युन्माली हतो दैत्यः सत्यवान्संगतस्ततः ।\nसुरथेन समं युद्धं जानासि त्वं महामते॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000606070, "chapter_id": 20606, "verse_number": "५-६५-७१", "content_sanskrit": "ततः कुंडलकान्मुक्तो हयो बभ्राम सर्वतः ।\nन कश्चित्तं निजग्राह स्ववीर्यबलदर्पितः॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000606071, "chapter_id": 20606, "verse_number": "५-६५-७२", "content_sanskrit": "वाल्मीकेराश्रमे रम्ये हयः प्राप्तो मनोरमः ।\nतत्र यत्कुतुकं जातं तच्छृणुष्व नरोत्तम॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000606072, "chapter_id": 20606, "verse_number": "५-६५-७३", "content_sanskrit": "तत्रार्भस्तव सारूप्यं बिभ्रत्षोडशवार्षिकः ।\nजग्राह वीक्ष्य पत्रांकं वाजिनं बलवत्तमः॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000606073, "chapter_id": 20606, "verse_number": "५-६५-७४", "content_sanskrit": "तत्र कालजिता युद्धं महज्जातं नरोत्तम ।\nनिहतस्तेन वीरेण शितधारेण हेतिना॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000606074, "chapter_id": 20606, "verse_number": "५-६५-७५", "content_sanskrit": "अनेके निहताः संख्ये पुष्कलाद्या महाबलाः ।\nमूर्च्छितं चापि शत्रुघ्नं चक्रे वीरशिरोमणिः॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000606075, "chapter_id": 20606, "verse_number": "५-६५-७६", "content_sanskrit": "तदा राजा महद्दुःखं विचार्य हृदिसंयुगे ।\nकोपेन मूर्च्छितं चक्रे वीरो हि बलिनां वरः॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000606076, "chapter_id": 20606, "verse_number": "५-६५-७७", "content_sanskrit": "स यावन्मूर्च्छितो राज्ञा तावदन्यः समागतः ।\nतेनैतेन च संजीव्य नाशितं कटकं तव॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000606077, "chapter_id": 20606, "verse_number": "५-६५-७८", "content_sanskrit": "सर्वेषां मूर्च्छितानां तु शस्त्राण्याभरणानि च ।\nगृहीत्वा वानरौ बद्धौ जग्मतुः स्वाश्रमं प्रति॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000606078, "chapter_id": 20606, "verse_number": "५-६५-७९", "content_sanskrit": "कृपां कृत्वा पुनस्तेन दत्तोऽश्वो यज्ञियो महान् ।\nजीवनं प्रापितं सर्वं कटकं नष्टजीवितम्॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000606079, "chapter_id": 20606, "verse_number": "५-६५-८०", "content_sanskrit": "वयं गृहीत्वा तं वाहं प्राप्तास्तव समीपतः ।\nएतदेव मया ज्ञातं तदुक्तं ते पुरोवचः॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}]