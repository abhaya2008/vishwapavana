[{"id": 2025647, "chapter_id": 1552, "verse_number": "३-१९०-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2025648, "chapter_id": 1552, "verse_number": "३-१९०-१", "content_sanskrit": "ततः स पाण्डवो भूयो मार्कण्डेयमुवाच ह।\nकथयस्वति चरितं मनोर्वैवस्वतस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2025649, "chapter_id": 1552, "verse_number": "३-१९०-२x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2025650, "chapter_id": 1552, "verse_number": "३-१९०-२", "content_sanskrit": "विवस्वतः सुतो राजन्महर्षिः सुप्रतापवान्।\nबभूव नरशार्दूल प्रजापतिसमद्युतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2025651, "chapter_id": 1552, "verse_number": "३-१९०-३", "content_sanskrit": "ओजसातेजसा लक्ष्म्या तपसा च विशेषतः।\nअतिचक्राम पितरं मनुः स्वंच पितामहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2025652, "chapter_id": 1552, "verse_number": "३-१९०-४", "content_sanskrit": "ऊर्ध्वबाहुर्विशालायां बदर्यां स नराधिपः।\nएकपादस्थितस्तीव्रं चकार सुमहत्तपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2025653, "chapter_id": 1552, "verse_number": "३-१९०-५", "content_sanskrit": "अवाकूशिरास्तथा चापि नेत्रैरनिमिषैर्दृढम्।\nसोऽतप्यत तपो घोरं वर्षाणामयुतं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2025654, "chapter_id": 1552, "verse_number": "३-१९०-६", "content_sanskrit": "तं कदाचित्तपस्यन्तमार्द्रचीरजटाधरम्।\nचीरिणीतीरमागम्य मत्स्यो वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2025655, "chapter_id": 1552, "verse_number": "३-१९०-७", "content_sanskrit": "भगवन्क्षुद्रमत्स्येस्मि बलवद्भ्यो भयंमम।\nमत्स्येभ्यो हि ततो मां त्वं त्रातुमर्हसि सुव्रत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2025656, "chapter_id": 1552, "verse_number": "३-१९०-८", "content_sanskrit": "दुर्बलं बलवन्तो हि मत्स्या मत्स्यं विशेषतः।\nभक्षयन्ति सदा वृत्तिर्विहिता नः सनातनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2025657, "chapter_id": 1552, "verse_number": "३-१९०-९", "content_sanskrit": "तस्माद्भयौघान्महतो मज्जन्तं मां विशेषतः।\nत्रातुमर्हसि कर्तास्मि कृतेप्रतिकृतं तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2025658, "chapter_id": 1552, "verse_number": "३-१९०-१०", "content_sanskrit": "स मत्स्यवचनं श्रुत्वा कृपयाऽभिपरिप्लुतः।\nमनुर्वैवस्वतोऽगृह्णात्तं मत्स्यं पाणिना स्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2025659, "chapter_id": 1552, "verse_number": "३-१९०-११", "content_sanskrit": "उदकान्तमुपानीय मत्स्यं वैवस्वतो मनुः।\nअलिञ्जरे प्राक्षिपत्तं चन्द्रांशुसदृशप्रभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2025660, "chapter_id": 1552, "verse_number": "३-१९०-१२", "content_sanskrit": "स तत्र ववृधे राजन्मत्स्यः परमसत्कृतः।\nपुत्रवत्स्वीकरोत्तस्मै मनुर्भावं विशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2025661, "chapter_id": 1552, "verse_number": "३-१९०-१३", "content_sanskrit": "अथ कालेन महता स मत्स्यः सुमहानभूत्।\nअलिञ्जरजले चैव नासौ समभवत्किल ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2025662, "chapter_id": 1552, "verse_number": "३-१९०-१४", "content_sanskrit": "अथ मत्स्यो मनुं दृष्ट्वा पुनरेवाभ्यभाषत।\nभगवन्साधु मेऽद्यान्यत्स्थानं संप्रतिपादय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2025663, "chapter_id": 1552, "verse_number": "३-१९०-१५", "content_sanskrit": "उद्धृत्यालिञ्जरात्तस्मात्ततः स भगवान्मनुः।\nतं मत्स्यमनयद्वापीं महतीं स मनुस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2025664, "chapter_id": 1552, "verse_number": "३-१९०-१६", "content_sanskrit": "तत्रतं प्राक्षिपच्चापि मनुः परपुरंजय।\nअथावर्धत मत्स्यः स पुनर्वर्षगणान्बहून् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2025665, "chapter_id": 1552, "verse_number": "३-१९०-१७", "content_sanskrit": "द्वियोजनायता वापी विस्तृताचापि योजनम्।\nतस्यां नासौ समभवन्मत्स्यो राजीवलोचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2025666, "chapter_id": 1552, "verse_number": "३-१९०-१८", "content_sanskrit": "विचेष्टितुं च कौन्तेय मत्स्यो वाप्यां विशांपते।\nमनुं मत्स्यस्ततो दृष्ट्वा पुनरेवाभ्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2025667, "chapter_id": 1552, "verse_number": "३-१९०-१९", "content_sanskrit": "नय मां भगवन्साधो समुद्रमहिषीं प्रियाम्।\nगङ्गां नांत्रापि शक्तोस्मि वस्तुं मतिमतांवर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2025668, "chapter_id": 1552, "verse_number": "३-१९०-२०", "content_sanskrit": "निदेशे हि मया तुभ्यं स्थातव्यमनसूयता।\nवृद्धिर्हि परमा प्राप्ता त्वत्कृते हि मयाऽनघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2025669, "chapter_id": 1552, "verse_number": "३-१९०-२१", "content_sanskrit": "एवमुक्तो मनुर्मत्स्यमनयद्भगवान्वशी।\nनदीं गङ्गां तत्रचैनं स्वयं प्राक्षिपदेव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2025670, "chapter_id": 1552, "verse_number": "३-१९०-२२", "content_sanskrit": "स तत्र ववृधे मत्स्यः कंचित्रालमरिंदम।\nगतः पुनर्मनुं दृष्ट्वा मत्स्यो वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2025671, "chapter_id": 1552, "verse_number": "३-१९०-२३", "content_sanskrit": "गङ्गायां हि न शक्नोमि बृहत्त्वाच्चेष्टितुं प्रभो।\nसमुद्रं नय मामाशु प्रसीद भगवन्निति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2025672, "chapter_id": 1552, "verse_number": "३-१९०-२४", "content_sanskrit": "उद्धृत्य गङ्गासलिलात्ततो मत्स्यं मनुः स्वयम्।\nसमुद्रमनयत्पार्त तत्रचैनमवासृजत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2025673, "chapter_id": 1552, "verse_number": "३-१९०-२५", "content_sanskrit": "सुमहानपि मत्स्यस्तु स मनोर्नयतस्तदा।\nआसीद्यथेष्टहार्यश्च स्पर्शगन्धसुखश्च वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2025674, "chapter_id": 1552, "verse_number": "३-१९०-२६", "content_sanskrit": "यदा समुद्रे प्रक्षिप्तः स मत्स्यो ननुना तदा।\nतत एनमिदं वाक्यं स्मयमान इवाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2025675, "chapter_id": 1552, "verse_number": "३-१९०-२७", "content_sanskrit": "भगवन्हि कृता रक्षा त्वया सर्वा विशेषतः।\nप्राप्तकालं तु यत्कार्यं त्वया तच्छ्रूयतां मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2025676, "chapter_id": 1552, "verse_number": "३-१९०-२८", "content_sanskrit": "अचिराद्भगवन्बौममिदं स्थावरजङ्गमम्।\nसर्वमेव महाभाग प्रलयं वै गमिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2025677, "chapter_id": 1552, "verse_number": "३-१९०-२९", "content_sanskrit": "संप्रक्षालनकालोऽयंलोकानां समुपस्थितः।\nतस्मात्त्वां बोधयाम्यद्ययत्ते हितमनुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2025678, "chapter_id": 1552, "verse_number": "३-१९०-३०", "content_sanskrit": "त्रसानां स्तावराणां च यच्चेङ्गं यच्च नेङ्गति।\nतस्य सर्वस् संप्राप्तः कालः परमदारुणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2025679, "chapter_id": 1552, "verse_number": "३-१९०-३१", "content_sanskrit": "नौश्च कारयितव्या ते दृढा युक्तवटारका।\nतत्र सप्तर्षिभिः सार्धमारुहेथा महामुने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2025680, "chapter_id": 1552, "verse_number": "३-१९०-३२", "content_sanskrit": "बीजानि चैव सर्वाणि यथोक्तानि मया पुरा।\nतस्यामारोहयेर्नावि सुसंगुप्तानि भागशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2025681, "chapter_id": 1552, "verse_number": "३-१९०-३३", "content_sanskrit": "नौस्थश्च मां प्रतीक्षेथास्ततो मुनिजनप्रिय।\nआगमिष्याम्यहं शृङ्गी विज्ञेयस्तेन तापस ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2025682, "chapter_id": 1552, "verse_number": "३-१९०-३४", "content_sanskrit": "एवमेतत्त्वया कार्यमापृष्टोसि व्रजाम्यहम्।\nता न शक्या महत्यो वै आपस्तर्तुं मया विना।\nनातिशङ्क्यमिदं चापि वचनं मे त्वया विभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2025683, "chapter_id": 1552, "verse_number": "३-१९०-३५", "content_sanskrit": "एवं करिष्य इति तं स मत्स्यं प्रत्यभाषत।\nजग्मतुश्च यथाकाममनुज्ञाप्य परस्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2025684, "chapter_id": 1552, "verse_number": "३-१९०-३६", "content_sanskrit": "ततो मनुर्महाराज यथोक्तं मत्स्यकेन ह।\nबीजान्यादाय सर्वाणि सागरं पुप्लुवे तदा।\nनौकया शुभयावीर महोर्मिणमरिंदम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2025685, "chapter_id": 1552, "verse_number": "३-१९०-३७", "content_sanskrit": "चिन्तयामास च मनुस्तं मत्स्यं पृथिवीपते।\nसच तच्चिन्तितं ज्ञात्वा मत्स्यः परपुरंजय।\nशृङ्गी तत्राजगागाशु तदा भरतसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2025686, "chapter_id": 1552, "verse_number": "३-१९०-३८", "content_sanskrit": "तं दृष्ट्वा मनुजव्याघ्र मनुर्मत्स्यं जलार्णवे।\nशृङ्गिणं तं यथोक्तेन रूपेणाद्रिमिवोच्छ्रितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2025687, "chapter_id": 1552, "verse_number": "३-१९०-३९", "content_sanskrit": "वटारकमयं पाशमथ मत्स्यस्य मूर्धनि।\nमनुर्मनुजशार्दूल तस् शृङ्गे न्यवेशयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2025688, "chapter_id": 1552, "verse_number": "३-१९०-४०", "content_sanskrit": "संयतस्तेन पाशेन मत्स्यः परपुरंजय।\nवेगेन महता नावं प्राकर्षल्लवणाम्भसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2025689, "chapter_id": 1552, "verse_number": "३-१९०-४१", "content_sanskrit": "स ततार तया नावा समुद्रं मनुजेश्वर।\nनृत्यमानमिवोर्मीभिर्गर्जमानमिवाम्भसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2025690, "chapter_id": 1552, "verse_number": "३-१९०-४२", "content_sanskrit": "क्षोभ्यमाणा महावातैः सा नौस्तस्मिन्महोदधौ।\nघूर्णते चपलेव स्री मत्ता परपुरंजय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2025691, "chapter_id": 1552, "verse_number": "३-१९०-४३", "content_sanskrit": "नैव भूमिर्न च दिशः प्रदिशो वा चकाशिरे।\nसर्वं सलिलमेवासीत्खं द्यौश्च नरपुङ्गव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2025692, "chapter_id": 1552, "verse_number": "३-१९०-४४", "content_sanskrit": "एवंभूते तदा लोके संकुले भरतर्षभ।\nअदृश्यन्त सप्तर्षयो मनुर्मत्स्यस्तथैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2025693, "chapter_id": 1552, "verse_number": "३-१९०-४५", "content_sanskrit": "एवं बहून्वर्षगणांस्तां नावं सोऽथ मत्स्यकः।\nचकर्षातन्द्रितो राजंस्तस्मिन्सलिलसंचये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2025694, "chapter_id": 1552, "verse_number": "३-१९०-४६", "content_sanskrit": "ततो हिमवतः शृङ्गं यत्परं भरतर्षभ।\nतत्राकर्षत्ततो नावं स मत्स्यः कुरुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2025695, "chapter_id": 1552, "verse_number": "३-१९०-४७", "content_sanskrit": "अथाब्रवीत्तदा मत्स्यस्तानृषीन्प्रहसञ्शनैः।\nअस्मिन्हिमवतः शृङ्गे नावं बध्नीत माचिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2025696, "chapter_id": 1552, "verse_number": "३-१९०-४८", "content_sanskrit": "सा बद्धा तत्र तैस्तूर्णमृषिभिर्भरतर्षभ।\nनौर्मत्स्यस्य वचः श्रुत्वा शृङ्गे हिमवतस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2025697, "chapter_id": 1552, "verse_number": "३-१९०-४९", "content_sanskrit": "तच्च नौबन्धनं नाम शृङ्गं हिमवतः परम्।\nख्यातमद्यापि कौन्तेय तद्विद्धि भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2025698, "chapter_id": 1552, "verse_number": "३-१९०-५०", "content_sanskrit": "अथाब्रवीदनिमिषस्तानृषीन्सहितस्तदा।\nअहं प्रजापतिर्ब्रह्मा मत्परं नाधिगम्यते।\nमत्स्यरूपेण यूयं च मयाऽस्मान्मोक्षिता भयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2025699, "chapter_id": 1552, "verse_number": "३-१९०-५१", "content_sanskrit": "मनुना च प्रजाः सर्वाः सदेवासुरमानुपाः।\nस्रष्टव्याः सर्वलोकाश्चयच्चेङ्गं यच्चा नेङ्गति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2025700, "chapter_id": 1552, "verse_number": "३-१९०-५२", "content_sanskrit": "तपसा चापि तीव्रेण प्रतिभाऽस्य भविष्यति।\nमत्प्रसादात्प्रजासर्गे न च मोहं गमिष्यति।\nइत्युक्त्वा वचनं मत्स्यः क्षणेनादर्शनं गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2025701, "chapter_id": 1552, "verse_number": "३-१९०-५३", "content_sanskrit": "स्रष्टुकामः प्रजाश्चापि मनुर्वैवस्वतः स्वयम्।\nप्रमूढोऽभूत्प्रजासर्गे तपस्तेपे महत्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2025702, "chapter_id": 1552, "verse_number": "३-१९०-५४", "content_sanskrit": "तपसा महता युक्तः सोऽथ स्रष्टुं प्रचक्रमे।\nसर्वाः प्रजा मनुः साक्षाद्यथावद्भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2025703, "chapter_id": 1552, "verse_number": "३-१९०-५५", "content_sanskrit": "इत्येतन्मात्स्यकं नाम पुराणं परिकीर्तितम्।\nआख्यानमिदमाख्यातं सर्वपापहरं मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2025704, "chapter_id": 1552, "verse_number": "३-१९०-५६", "content_sanskrit": "य इदं शृणुयान्नित्यं मनोश्चरितमादितः।\nस सुखी सर्वपूर्णार्थः सर्वलोकमियान्नरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2025705, "chapter_id": 1552, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि मार्कण्डेयसमास्यापर्वणि नवत्यधिकशततमोऽध्यायः ॥ १९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]