[{"id": 2177475, "chapter_id": 4747, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2177476, "chapter_id": 4747, "verse_number": "१", "content_sanskrit": "तस्यां रात्र्यां व्यतीतायां धृष्टद्युम्नस्य सारथिः ।\nशशंस धर्मराजाय सौप्तिके कदनं कृतम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2177477, "chapter_id": 4747, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2177478, "chapter_id": 4747, "verse_number": "२", "content_sanskrit": "द्रौपदेया हता राजन् द्रुपदस्यात्मजैः सह ।\nप्रमत्ता निशि विश्वस्ताः स्वपन्तः शिबिरे स्वके\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2177479, "chapter_id": 4747, "verse_number": "३", "content_sanskrit": "गौतमेन नृशंसेन भोजेन कृतवर्मणा ।\nअश्वत्थाम्ना च पापेन हतं वः शिबिरं निशि\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2177480, "chapter_id": 4747, "verse_number": "४", "content_sanskrit": "एतैर्नरगजाश्वानां प्रासशक्तिपरश्वथैः ।\nसहस्राणि निकृन्तद्भिर्निःशेषं शिबिरं कृतम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2177481, "chapter_id": 4747, "verse_number": "५", "content_sanskrit": "छिद्यमानस्य महतो वनस्येव परश्वथैः ।\nशुश्रुवे सुमहान् शब्दो बलस्य तव भारत\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2177482, "chapter_id": 4747, "verse_number": "६", "content_sanskrit": "अहमेवावशिष्टस्तु तस्मात् सैन्यान्महीपते ।\nमुक्तः कथञ्चिद् धर्मात्मन् व्यग्रेण कृतवर्मणा\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2177483, "chapter_id": 4747, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2177484, "chapter_id": 4747, "verse_number": "७", "content_sanskrit": "तच्छ्रुत्वा वाक्यमशिवं कुन्तीपुत्रो युधिष्ठिरः ।\nपपात मुह्यन् दुर्धर्षः पुत्रशोकसमन्वितः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2177485, "chapter_id": 4747, "verse_number": "८", "content_sanskrit": "पतन्तं तमतिक्रम्य परिजग्राह सात्यकिः ।\nभीमसेनोऽर्जुनश्चैव माद्रीपुत्रौ च पाण्डवौ\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2177486, "chapter_id": 4747, "verse_number": "९", "content_sanskrit": "लब्धचेतास्तु कौन्तेयः शोकविह्वलया गिरा ।\nजित्वा शत्रून् जितः पश्चात् पर्यदेवयदार्तवम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2177487, "chapter_id": 4747, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2177488, "chapter_id": 4747, "verse_number": "१०", "content_sanskrit": "(अगम्या गतिरर्थानां कर्मणामीश्वरस्य च ।)\nदुर्विज्ञेया गतिर्ह्येषामपि ये दिव्यचक्षुषः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2177489, "chapter_id": 4747, "verse_number": "११", "content_sanskrit": "जीयमाना जयन्त्यन्ये जयमाना वयं जिताः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2177490, "chapter_id": 4747, "verse_number": "१२", "content_sanskrit": "हत्वा भ्रातॄन् वयस्यांश्च पितॄन् भृत्यान् सुहृद्गणान् ।\nबन्धूनमात्यान् पौत्रांश्च जित्वा सर्वान् जिता वयम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2177491, "chapter_id": 4747, "verse_number": "१३", "content_sanskrit": "अनर्था ह्यर्थसङ्काशाः तथाऽनर्थोर्ऽथदर्शनः ।\nजयोऽयमजयाकारो जयस्तस्मात् पराजयः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2177492, "chapter_id": 4747, "verse_number": "१४", "content_sanskrit": "यो जित्वा तप्यते पश्चाद् आपन्न इव दुर्मतिः ।\nकथं मन्येत विजयं यः स्याज्जिततरः परैः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2177493, "chapter_id": 4747, "verse_number": "१५", "content_sanskrit": "येषामर्थे जयोऽयं स्याद् विजयः स्यात् सुहृद्वधे ।\nतैर्जितैरप्रमत्तैर्हि निर्जिता जितकाशिनः॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2177494, "chapter_id": 4747, "verse_number": "१६", "content_sanskrit": "कर्णिनालीकदंष्ट्रस्य खड्गजिह्वस्य संयुगे ।\nचापव्याप्तस्य रौद्रस्य ज्यातळत्रविनादिनः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2177495, "chapter_id": 4747, "verse_number": "१७", "content_sanskrit": "क्रुद्धस्य नरसिंहस्य सङ्ग्रामेष्वपलायिनः ।\nये व्यमुच्यन्त कर्णस्य प्रमादात् त इमे हताः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2177496, "chapter_id": 4747, "verse_number": "१८", "content_sanskrit": "रथह्रदं शरवर्षोर्मिमन्तं\nरत्नाचितं वाजिसमाजयुक्तम् ।\nशक्त्यृष्टिशूलध्वजनागनक्र-\nशरासनावर्तमहौघफेनम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2177497, "chapter_id": 4747, "verse_number": "१९", "content_sanskrit": "सङ्ग्रामचन्द्रोदयवेगवेलं\nद्रोणार्णवं ज्यातळनेमिघोषम् ।\nये तेरुरुच्चावचशस्त्रनौभिः\nते राजपुत्रा निहताः प्रमादात्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2177498, "chapter_id": 4747, "verse_number": "२०", "content_sanskrit": "न हि प्रमादात् परमस्ति कश्चिद्\nवधो नराणामिह जीवलोके ।\nप्रमत्तमर्था हि नरं समन्तात्\nत्यजन्त्यनर्थाश्च समाविशन्ति\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2177499, "chapter_id": 4747, "verse_number": "२१", "content_sanskrit": "ध्वजोत्तमाग्रोच्छ्रितधूमकेतुं\nशरार्चिषं कोपमहासमीरम् ।\nमहाधनुर्ज्यातळनेमिघोषं\nतनुत्रनानाविधशस्त्रवेगम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2177500, "chapter_id": 4747, "verse_number": "२२", "content_sanskrit": "महाचमूकक्षदवाग्निभूतं\nमहाहवे भीष्ममहादवाग्निम् ।\nयोऽतीत्य भीमायुधतीक्ष्णवेगं\nते राजपुत्रा निहताः प्रमादात्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2177501, "chapter_id": 4747, "verse_number": "२३", "content_sanskrit": "न हि प्रमत्तेन नरेण शक्यम्\nआप्तुं वसुं श्रीर्विपुलं यशो वा\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2177502, "chapter_id": 4747, "verse_number": "२४", "content_sanskrit": "पश्याप्रमादेन विनिहत्य शत्रून्\nसर्वान् महेन्द्रान् सुसमेधमानान् ।\nइन्द्रोपमान् पार्थिवपुत्रपौत्रान्\nपश्याविशेषेण हतान् प्रमादात्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2177503, "chapter_id": 4747, "verse_number": "२५", "content_sanskrit": "तीर्त्वा समुद्रं वणिजः समृद्धा\nमग्नाः कुनद्यामिव सीदमानाः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2177504, "chapter_id": 4747, "verse_number": "२६", "content_sanskrit": "अमर्षितैर्ये निहता नरेन्द्रा\nनिःसंशयं ते त्रिदिवं प्रपन्नाः ।\nकृष्णां तु शोचामि कथं नु साध्वी\nशोकार्णवं साऽद्य विशक्ष्यतीति\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2177505, "chapter_id": 4747, "verse_number": "२७", "content_sanskrit": "भ्रातॄंश्च पुत्रांश्च हतान् निशम्य\nपाञ्चालराजं पितरं च वृद्धम् ।\nध्रुवं विसञ्ज्ञा पतिता पृथिव्यां\nसा शोचते शोककृशाङ्गयष्टिः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2177506, "chapter_id": 4747, "verse_number": "२८", "content_sanskrit": "तच्छोकजं दुःखमपारयन्ती\nकथं भविष्यत्युचिता सुखानाम् ।\nपुत्रक्षयं भ्रातृवधं प्रपन्ना\nप्रदह्यमानेव हुताशनेन\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2177507, "chapter_id": 4747, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2177508, "chapter_id": 4747, "verse_number": "२९", "content_sanskrit": "इत्येवमार्तः परिदेवयन् स\nराजा कुरूणां नकुलं बभाषे\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2177509, "chapter_id": 4747, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2177510, "chapter_id": 4747, "verse_number": "३०", "content_sanskrit": "गच्छानयैनामिह मन्दभाग्याम्\nअमात्यपक्षामिति राजपुत्रीम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2177511, "chapter_id": 4747, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2177512, "chapter_id": 4747, "verse_number": "३१", "content_sanskrit": "माद्रीसुतस्तत् परिगृह्य वाक्यं\nधर्मेण धर्मप्रतिमस्य राज्ञः ।\nययौ रथेनालयमाशु देव्याः\nपाञ्चालराजस्य च यत्र दाराः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2177513, "chapter_id": 4747, "verse_number": "३२", "content_sanskrit": "प्रस्थाप्य माद्रीसुतमाजमीढः\nशोकार्दितस्तैः सहितः सुहृद्भिः ।\nरोरूयमाणः प्रययौ सुतानाम्\nआयोधनं भूतगणानुकीर्णम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2177514, "chapter_id": 4747, "verse_number": "३३", "content_sanskrit": "स तत् प्रविश्याशिवमुग्ररूपं\nददर्श पुत्रान् सुहृदः सखींश्च ।\nभूमौ शयानान् रुधिरार्द्रगात्रान्\nविभिन्नगात्रोपहृतोत्तमाङ्गान्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2177515, "chapter_id": 4747, "verse_number": "३४", "content_sanskrit": "स तांस्तु दृष्ट्वा भृशमार्तरूपो\nयुधिष्ठिरो धर्मभृतां वरिष्ठः ।\nउच्चैः प्रचुक्रोश च कौरवाग्र्यः\nपपात चोर्व्यां सगणो विसञ्ज्ञः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2177516, "chapter_id": 4747, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nऐषीकपर्वणि युधिष्ठिरप्रलापो नाम प्रथमोऽध्यायः ॥१॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]