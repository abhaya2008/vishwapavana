[{"id": 50002211, "chapter_id": 10549, "verse_number": "1", "content_sanskrit": "यदि मन्यसे सुवेदेति दह्रमेवापि नूनं त्वं न वेत्थ ब्रह्मणो रूपम्‌। यदस्य त्वं यदस्य देवेष्वथ नु मीमांस्यमेव ते मन्ये[ऽ]विदितम्‌॥ २/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50002212, "chapter_id": 10549, "verse_number": "2", "content_sanskrit": "नाहं मन्ये सुवेदेति नो न वेदेति वेद च। यो नस्तद् वेद तद् वेद नो न वेदेति वेद च॥ २/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50002213, "chapter_id": 10549, "verse_number": "3", "content_sanskrit": "यस्यामतं तस्य मतं मतं यस्य न वेद सः। अविज्ञातं विजानतां विज्ञातमविजानताम्‌॥ २/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50002214, "chapter_id": 10549, "verse_number": "4", "content_sanskrit": "प्रतिबोधविदितं मतममृतत्वं हि विन्दते। आत्मना विन्दते वीर्यं विद्यया विन्दतेऽमृतम्‌॥ २/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50002215, "chapter_id": 10549, "verse_number": "5", "content_sanskrit": "इह चेदवेदीदथ सत्यमस्ति न चेदिहावेदीन्महती विनष्टिः। भूतेषुभूतेषु विचित्य धीराः प्रेत्यास्माल्लोकादमृता भवन्ति॥ २/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50002216, "chapter_id": 10549, "verse_number": "6", "content_sanskrit": "॥ इति तलवकारोपनिषदि द्वितीयः खण्डः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}]