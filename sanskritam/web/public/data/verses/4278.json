[{"id": 2150957, "chapter_id": 4278, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2150958, "chapter_id": 4278, "verse_number": "१", "content_sanskrit": "यदिदं भारतं वर्षं यत्रेदं मूर्छितं बलम् ।\nयत्रातिमात्रं लुब्धोऽयं पुत्रो दुर्योधनो मम\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2150959, "chapter_id": 4278, "verse_number": "२", "content_sanskrit": "यत्र गृद्धाः पाण्डुसुता यत्र मे सज्जते मनः ।\nएतन्मे तत्त्वमाचक्ष्व कुशलो ह्यसि सञ्जय\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2150960, "chapter_id": 4278, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2150961, "chapter_id": 4278, "verse_number": "३", "content_sanskrit": "न तत्र पाण्डवाः गृद्धाः शृणु राजन् वचो मम ।\nगृद्धो दुर्योधनस्तत्र शकुनिश्चापि सौबलः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2150962, "chapter_id": 4278, "verse_number": "४", "content_sanskrit": "अपरे क्षत्रियाश्चापि नानाजनपदेश्वराः ।\nये गृद्धा भारते वर्षे न मृष्यन्ति परस्परम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2150963, "chapter_id": 4278, "verse_number": "५", "content_sanskrit": "अत्र ते वर्णयिष्यामि वर्षं भारत भारतम् ।\nप्रियमिन्द्रस्य देवस्य मनोर्वैवस्वतस्य च\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2150964, "chapter_id": 4278, "verse_number": "६", "content_sanskrit": "पृथोश्च राजन् वैन्यस्य तथेक्ष्वाकोर्महात्मनः ।\nययातेरम्बरीषस्य मान्धातुर्नहुषस्य च\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2150965, "chapter_id": 4278, "verse_number": "७", "content_sanskrit": "तथैव मुचुकुन्दस्य शिबेरौशीनरस्य च ।\nऋषभस्य तथैलस्य नृगस्य नृपतेस्तथा\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2150966, "chapter_id": 4278, "verse_number": "८", "content_sanskrit": "अन्येषां च महाराज क्षत्रियाणां बलीयसाम् ।\nसर्वेषामेव राजेन्द्र प्रियं भारत भारतम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2150967, "chapter_id": 4278, "verse_number": "९", "content_sanskrit": "तत्ते वर्षं प्रवक्ष्यामि यथाश्रुतमरिन्दम ।\nशृणु मे गदतो राजन् यन्मां त्वं परिपृच्छसि\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2150968, "chapter_id": 4278, "verse_number": "१०", "content_sanskrit": "महेन्द्रो मलयः सह्यः शुक्तिमानृक्षवानपि ।\nविन्ध्यश्च पारियात्रश्च सप्तैते कुलपर्वताः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2150969, "chapter_id": 4278, "verse_number": "११", "content_sanskrit": "तेषां सहस्रशो राजन् पर्वतास्तु समीपतः ।\nअभिज्ञाताः सारवन्तो विपुलाश्चित्रसानवः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2150970, "chapter_id": 4278, "verse_number": "१२", "content_sanskrit": "अन्ये ततोऽपरिज्ञाता ह्रस्वा ह्रस्वोपजीविनः ।\nआर्या म्लेच्छाश्च कौरव्य तैर्मिश्राः पुरुषा विभो\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2150971, "chapter_id": 4278, "verse_number": "१३", "content_sanskrit": "नदीः पिबन्ति बहुला गङ्गां सिन्धुं सरस्वतीम् ।\nगोदावरीं नर्मदां च बाहुदां च महानदीम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2150972, "chapter_id": 4278, "verse_number": "१४", "content_sanskrit": "शतद्रुं चन्द्रभागां च यमुनां च महानदीम् ।\nदृषद्वतीं विपाशां च विपापां स्थूलवालुकाम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2150973, "chapter_id": 4278, "verse_number": "१५", "content_sanskrit": "नदीं वेत्रवतीं चैव कृष्णवेणां च निम्नगाम् ।\nइरावतीं वितस्तां च पयोष्णीं देविकामपि\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2150974, "chapter_id": 4278, "verse_number": "१६", "content_sanskrit": "वेदस्मृतिं वेतसिनीं त्रिदिवामिक्षुमालिनीम् ।\nकरीषिणीं चित्रवहां चित्रसेनां च निम्नगाम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2150975, "chapter_id": 4278, "verse_number": "१७", "content_sanskrit": "गोमतीं धूतपापां च वन्दनां च महानदीम् ।\nकौशिकीं त्रिदिवां कृत्यां विचित्रां लोहतारिणीम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2150976, "chapter_id": 4278, "verse_number": "१८", "content_sanskrit": "रथस्थां शतकुम्भां च सरयूं च नरेश्वर ।\nचर्मण्वतीं वेत्रवतीं हस्तिसोमां दिशं तथा\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2150977, "chapter_id": 4278, "verse_number": "१९", "content_sanskrit": "शतावरीं पयोष्णीं च परां भैमरथीं तथा ।\nकावेरीं चुलुकां चापि वापीं शतबलामपि\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2150978, "chapter_id": 4278, "verse_number": "२०", "content_sanskrit": "निचीरां महितां चापि सुप्रयोगां नराधिप ।\nपवित्रां कुण्डलां सिन्धुं वाजिनीं पुरमालिनीम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2150979, "chapter_id": 4278, "verse_number": "२१", "content_sanskrit": "पूर्वाभिरामां वीरां च भीमामोघवतीं तथा ।\nपलाशिनीं पापहरां महेन्द्रां पिप्पलावतीम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2150980, "chapter_id": 4278, "verse_number": "२२", "content_sanskrit": "पारिषेणामसिक्नीं च सरलां भारमर्दिनीम् ।\nपुरुहीं प्रवरां मेनां मोघां घृतवतीं तथा\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2150981, "chapter_id": 4278, "verse_number": "२३", "content_sanskrit": "धूमत्यामतिकृष्णां च सूचीं छावीं च कौरव ।\nसदानीरामधृष्यां च कुशधारां महानदीम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2150982, "chapter_id": 4278, "verse_number": "२४", "content_sanskrit": "शशिकान्तां शिवां चैव तथा वीरवतीमपि ।\nवास्तुं सुवास्तुं गौरीं च कम्पनां सहिरण्वतीम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2150983, "chapter_id": 4278, "verse_number": "२५", "content_sanskrit": "हिरण्वतीं चित्रवतीं चित्रसेनां च निम्नगाम् ।\nरथचित्रां ज्योतिरथां विश्वामित्रां कपिञ्जलाम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2150984, "chapter_id": 4278, "verse_number": "२६", "content_sanskrit": "उपेन्द्रां बहुलां चैव कुचरामम्बुवाहिनीम् ।\nवैनन्दीं पिञ्जलां वेण्णां तुङ्गवेणां महानदीम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2150985, "chapter_id": 4278, "verse_number": "२७", "content_sanskrit": "विदिशां कृष्णवेण्णां च ताम्रां च कपिलामपि ।\nशलुं सुवामां वेदाश्वां हरिस्रावां महापगाम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2150986, "chapter_id": 4278, "verse_number": "२८", "content_sanskrit": "शीघ्रां च पिच्छिलां चैव भारद्वाजीं च निम्नगाम् ।\nकौशिकीं निम्नगां शोणां बाहुदामथ चन्दनाम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2150987, "chapter_id": 4278, "verse_number": "२९", "content_sanskrit": "दुर्गामन्तःशिलां चैव ब्रह्ममेध्यां बृहद्वतीम् ।\nचरक्षां महिरोहीं च तथा जम्बुनदीमपि\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2150988, "chapter_id": 4278, "verse_number": "३०", "content_sanskrit": "सुनसां तमसां दासीं त्रसामन्यां वराणसीम् ।\nलोलोद्धृतकरां चैव पूर्णाशां च महानदीम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2150989, "chapter_id": 4278, "verse_number": "३१", "content_sanskrit": "मानवीं वृषभां चैव महानद्यो जनाधिप ।\nसदानिरामयां वृत्यां मन्दगां मन्दवाहिनीम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2150990, "chapter_id": 4278, "verse_number": "३२", "content_sanskrit": "ब्रह्माणीं च महागौरीं दुर्गामपि च भारत ।\nचित्रोपलां चित्रबर्हां मञ्जुं मकरवाहिनीम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2150991, "chapter_id": 4278, "verse_number": "३३", "content_sanskrit": "मन्दाकिनीं वैतरणीं कोकां चैव महानदीम् ।\nशुक्तिमतीमरण्यां च पुष्पवेण्युत्पलावतीम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2150992, "chapter_id": 4278, "verse_number": "३४", "content_sanskrit": "लोहित्यां करतोयां च तथैव वृषभाङ्गिनीम् ।\nकुमारीमृषिकुल्यां च ब्रह्मकुल्यां च भारत\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2150993, "chapter_id": 4278, "verse_number": "३५", "content_sanskrit": "सरस्वतीः सुपुण्याश्च सर्वा गङ्गाश्च मारिष ।\nविश्वस्य मातरः सर्वाः सर्वाश्चैव महाबलाः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2150994, "chapter_id": 4278, "verse_number": "३६", "content_sanskrit": "तथा नद्यस्त्वप्रकाशाः शतशोऽथ सहस्रशः ।\nइत्येताः सरितो राजन् समाख्याता यथास्मृति\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2150995, "chapter_id": 4278, "verse_number": "३७", "content_sanskrit": "अथ ऊर्ध्वं जनपदान्निबोध गदतो मम ।\nतत्रेमे कुरुपाञ्चालाः साल्वमाद्रेयजाङ्गलाः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2150996, "chapter_id": 4278, "verse_number": "३८", "content_sanskrit": "शूरसेनाः कलिङ्गाश्च बोधा मौकास्तथैव च ।\nमत्स्याः सुकुट्यः सौबल्याः कुन्तलाः काशिकोशलाः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2150997, "chapter_id": 4278, "verse_number": "३९", "content_sanskrit": "चेदिवत्साः करूषाश्च भोजाः सिन्धुपुलिन्दकाः ।\nउत्तमौजा दशार्णाश्च मेकलाश्चोत्कलैः सह\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2150998, "chapter_id": 4278, "verse_number": "४०", "content_sanskrit": "पाञ्चालाः कौशिजाश्चैव एकपृष्ठा युगन्धराः ।\nसौधा मद्रा भुजिङ्गाश्च काशयोऽपरकाशयः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2150999, "chapter_id": 4278, "verse_number": "४१", "content_sanskrit": "जठराः कुक्कुशाश्चैव सुदाशार्णाश्च भारत ।\nकुन्तयोऽवन्तयश्चैव तथैवापरकुन्तयः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2151000, "chapter_id": 4278, "verse_number": "४२", "content_sanskrit": "गोविन्दा मन्दकाः षण्डा विदर्भानूपवासिकाः ।\nअश्मकाः पांसुराष्ट्राश्च गोपराष्ट्राः पनीतकाः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2151001, "chapter_id": 4278, "verse_number": "४३", "content_sanskrit": "आदिराष्ट्राः सुकुट्टाश्च बलिराष्ट्रं च केवलम् ।\nवानरास्याः प्रवाहाश्च वक्रा वक्रभयाः शकाः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2151002, "chapter_id": 4278, "verse_number": "४४", "content_sanskrit": "विदेहका मागधाश्च सुह्माश्च विजयास्तथा ।\nअङ्गा वङ्गाः कलिङ्गाश्च यकृल्लोमान एव च\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2151003, "chapter_id": 4278, "verse_number": "४५", "content_sanskrit": "मल्लाः सुदेष्णाः प्राहूतास्तथा माहिषकार्षिकाः ।\nवाहीका वाटधानाश्च आभीराः कालतोयकाः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2151004, "chapter_id": 4278, "verse_number": "४६", "content_sanskrit": "अपरान्ध्राश्च शूद्राश्च पह्लवाश्चर्मखण्डिकाः ।\nअटवीशबराश्चैव मरुभौमाश्च मारिष\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2151005, "chapter_id": 4278, "verse_number": "४७", "content_sanskrit": "उपावृत्ताश्चानुपावृत्ताः सुराष्ट्राः केकयास्तथा ।\nकुट्टाः परान्ता द्वैधेयाः काक्षाः सामुद्रनिष्कुटाः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2151006, "chapter_id": 4278, "verse_number": "४८", "content_sanskrit": "आन्ध्राश्च बहवो राजन्नन्तर्गिर्यास्तथैव च ।\nबहिर्गिर्याङ्गमलदा मागधा मानवर्जकाः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2151007, "chapter_id": 4278, "verse_number": "४९", "content_sanskrit": "मह्युत्तराः प्रावृषेया भार्गवाश्च जनाधिप ।\nपुण्ड्रा भार्गाः किराताश्च सुदोष्णाः प्रमुदास्तथा\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2151008, "chapter_id": 4278, "verse_number": "५०", "content_sanskrit": "शका निषादा निषधास्तथैवानर्तनैर्ऋताः ।\nदुगूलाः प्रतिमत्स्याश्च कुशलाः कुनटास्तथा\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2151009, "chapter_id": 4278, "verse_number": "५१", "content_sanskrit": "तीरग्रा हास्तरतोया राजिका रस्यका गणाः ।\nतिलकाः पारसीकाश्च मधुमन्तः प्रकुत्सकाः\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2151010, "chapter_id": 4278, "verse_number": "५२", "content_sanskrit": "काश्मीराः सिन्धुसौवीरा गान्धारा दर्शकास्तथा ।\nअभीसारा कुलूताश्च शैवला बाह्लिकास्तथा\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2151011, "chapter_id": 4278, "verse_number": "५३", "content_sanskrit": "दर्वीकाः सकचा दर्वा वातजामरथोरगाः ।\nबहुवाद्याश्च कौरव्य सुदामानः सुमल्लिकाः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2151012, "chapter_id": 4278, "verse_number": "५४", "content_sanskrit": "वध्राः करीषकाश्चापि कुळिन्दोपत्यकास्तथा ।\nवानायवो दशापार्श्वा रोमाणः कुशबिन्दवः\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2151013, "chapter_id": 4278, "verse_number": "५५", "content_sanskrit": "कच्छा गोपालकच्छाश्च लाङ्गलाः परवल्लकाः ।\nकिराता बर्बराः सिद्धा विदेहास्ताम्रलिङ्गकाः\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2151014, "chapter_id": 4278, "verse_number": "५६", "content_sanskrit": "ओष्ट्राः पुण्ड्राः ससैरन्ध्राः पार्वतीयाश्च मारिष ।\nअथापरे जनपदा दक्षिणा भरतर्षभ\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2151015, "chapter_id": 4278, "verse_number": "५७", "content_sanskrit": "द्रविडाः केरलाः प्राच्या भूषिका वनवासिनः ।\nउन्नत्यका माहिषका विकल्पा मूषकास्तथा\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2151016, "chapter_id": 4278, "verse_number": "५८", "content_sanskrit": "कर्णिकाः कुन्तिकाश्चैव सौद्भिदा नलकालकाः ।\nकौकुट्टकास्तथा चोलाः कोङ्कणा मालवाणकाः\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2151017, "chapter_id": 4278, "verse_number": "५९", "content_sanskrit": "समङ्गाः कोपनाश्चैव कुकुराङ्गदमारिषाः ।\nध्वजिन्युत्सवसङ्केतास्त्रिगर्ताः सर्वसेनयः\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2151018, "chapter_id": 4278, "verse_number": "६०", "content_sanskrit": "त्र्यङ्गाः केकरकाः प्रोष्ठाः परसञ्चरकास्तथा ।\nतथैव विन्ध्यपुलकाः पुलिन्दाः कल्कलैः सह\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2151019, "chapter_id": 4278, "verse_number": "६१", "content_sanskrit": "मालका मल्लकाश्चैव तथैवापरवर्तकाः ।\nकुलिन्दाः कुलकाश्चैव करण्ठाः कुरकास्तथा\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2151020, "chapter_id": 4278, "verse_number": "६२", "content_sanskrit": "मृषका स्तनबालाश्च सनीपाः पत्तिपञ्जकाः ।\nआदिदायाः सिरालाश्च स्तूबका स्तनपास्तथा\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2151021, "chapter_id": 4278, "verse_number": "६३", "content_sanskrit": "हृषीविदर्भाः कान्तीकास्तङ्गणाः परतङ्गणाः ।\nउत्तराश्चापरे म्लेच्छा जना भरतसत्तम\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2151022, "chapter_id": 4278, "verse_number": "६४", "content_sanskrit": "यवनाश्च सकाम्बोजा दारुणा म्लेच्छजातयः ।\nसक्षद्द्रुहः कुन्तलाश्च हूणाः पारतकैः सह\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2151023, "chapter_id": 4278, "verse_number": "६५", "content_sanskrit": "तथैव मरधाश्चीनास्तथैव दशमालिकाः ।\nक्षत्रियोपनिवेशाश्च वैश्यशूद्रकुलानि च\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2151024, "chapter_id": 4278, "verse_number": "६६", "content_sanskrit": "शूद्राभीराथ दरदाः काश्मीराः पशुभिः सह ।\nखशिकाश्च तुखाराश्च पल्लवा गिरिगह्वराः\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2151025, "chapter_id": 4278, "verse_number": "६७", "content_sanskrit": "आत्रेयाः सभरद्वाजास्तथैव स्तनयोषिकाः ।\nऔपकाश्च कलिङ्गाश्च किरातानां च जातयः\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2151026, "chapter_id": 4278, "verse_number": "६८", "content_sanskrit": "तामरा हंसमार्गाश्च तथैव करभञ्जकाः ।\nउद्देशमात्रेण मया देशाः सङ्कीर्तिताः प्रभो\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2151027, "chapter_id": 4278, "verse_number": "६९", "content_sanskrit": "यथागुणबलं चापि त्रिवर्गस्य महाफलम् ।\nदुह्येद् धेनुः कामधुक्च भूमिः सम्यगनुष्ठिता\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2151028, "chapter_id": 4278, "verse_number": "७०", "content_sanskrit": "तस्यां गृध्यन्ति राजानः शूरा धर्मार्थकोविदाः ।\nते त्यजन्त्याहवे प्राणान् रसागृद्धास्तरस्विनः\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2151029, "chapter_id": 4278, "verse_number": "७१", "content_sanskrit": "देवमानुषकायानां कामं भूमिः परायणम् ।\nअन्योन्यस्यावलुम्पन्ति सारमेया इवामिषम्\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2151030, "chapter_id": 4278, "verse_number": "७२", "content_sanskrit": "राजानो भरतश्रेष्ठ भोक्तुकामा वसुन्धराम् ।\nन चापि तृप्तिः कामानां विद्यते चेह कस्यचित्\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2151031, "chapter_id": 4278, "verse_number": "७३", "content_sanskrit": "तस्मात् परिग्रहे भूमेर्यतन्ते कुरुपाण्डवाः ।\nसाम्ना दानेन भेदेन दण्डेनैव च पार्थिव\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2151032, "chapter_id": 4278, "verse_number": "७४", "content_sanskrit": "पिता माता च पुत्रश्च खं द्यौश्च नरपुङ्गव ।\nभूमिर्भवति भूतानां सम्यगच्छिद्रदर्शिनाम्\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2151033, "chapter_id": 4278, "verse_number": "१०", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां भीष्मपर्वणि दशमोऽध्यायः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2151034, "chapter_id": 4278, "verse_number": "१०", "content_sanskrit": "॥ इति जम्बूखण्डनिर्माणपर्वणि दशमोऽध्यायः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}]