[{"id": 2121922, "chapter_id": 3615, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2121923, "chapter_id": 3615, "verse_number": "१", "content_sanskrit": "एवमुक्त्वा ततो भीष्मो विरराम महायशाः ।\nव्याजहारोत्तरं तत्र सहदेवोऽर्थतत्त्ववित् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2121924, "chapter_id": 3615, "verse_number": "२", "content_sanskrit": "केशवं केशिहन्तारमप्रमेयमरिन्दमम् ।\nसर्वलोकेश्वरं कृष्णं विज्ञाय पुरुषोत्तमम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2121925, "chapter_id": 3615, "verse_number": "३", "content_sanskrit": "तमिमं सर्वसम्पन्नमाचार्यं पितरं गुरुम् ।\nअर्च्यमर्चितमस्माभिः सर्वे सम्मन्तुमर्हथ ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2121926, "chapter_id": 3615, "verse_number": "४", "content_sanskrit": "यो वा न सहते राज्ञां कश्चित् सबलवाहनः ।\nक्षिप्रं युद्धाय निर्यातु शक्तश्चेदत्र मे युधि ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2121927, "chapter_id": 3615, "verse_number": "५", "content_sanskrit": "पूज्यमानं मया यो वः कृष्णं न सहते नृपाः ।\nतस्य मूर्ध्नि सुसन्न्यस्तं राज्ञः सव्यं पदं मया ।\nएवमुक्ते मया सम्यग् उत्तरं प्रब्रवीतु सः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2121928, "chapter_id": 3615, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2121929, "chapter_id": 3615, "verse_number": "६", "content_sanskrit": "ततो न व्याजहारैषां कश्चिद् बुद्धिमतां सताम् ।\nमानिनां बलिनां राज्ञां मध्ये सन्दर्शिते पदे ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2121930, "chapter_id": 3615, "verse_number": "७", "content_sanskrit": "ततोऽपतत् पुष्पवृष्टिः सहदेवस्य मूर्धनि ।\nअदृश्यदेहा वाचश्च साधुसाध्विति चाब्रुवन् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2121931, "chapter_id": 3615, "verse_number": "८", "content_sanskrit": "आविध्यदजिनं हृष्टो भविष्यद्भूतजल्पकः ।\nसर्वसंशयनिर्मोक्ता नारदः सर्वधर्मवित् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2121932, "chapter_id": 3615, "verse_number": "१०", "content_sanskrit": "उवाचाखिलभूतानां मध्ये स्पष्टतरं वचः ॥९॥\nकृष्णं कमलपत्राक्षं नार्चयिष्यन्ति ये नराः ।\nजीवन्मृतास्तु ते ज्ञेया न सम्भाष्याः कदाचन ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2121933, "chapter_id": 3615, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2121934, "chapter_id": 3615, "verse_number": "११", "content_sanskrit": "तत्राहूतागताः सर्वे सुनीथप्रमुखा नृपाः ।\nप्रत्यदृश्यन्त सङ्क्रुद्धा विवर्णा क्रोधमूर्च्छिताः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2121935, "chapter_id": 3615, "verse_number": "१२", "content_sanskrit": "युधिष्ठिराभिषेकं च कृष्णे पूजां च तादृशीम् ।\nव्यब्रुवंस्तत्र राजानो निर्वेदादात्मनिश्चयात् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2121936, "chapter_id": 3615, "verse_number": "१३", "content_sanskrit": "सुहृद्भिर्वार्यमाणानां तेषां हि वपुराबभौ ।\nआमिषादपकृष्टानां सिंहानामिव गर्ज्जताम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2121937, "chapter_id": 3615, "verse_number": "१४", "content_sanskrit": "तं बलौघमपर्यन्तं राजसागरमव्ययम् ।\nकुर्वाणं समयं कृष्णो युद्धाय बुबुधे तदा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2121938, "chapter_id": 3615, "verse_number": "१५", "content_sanskrit": "पूजयित्वा तु पूजार्हं ब्रह्मक्षत्रं विशेषतः ।\nसहदेवो विशेषज्ञः समापयत कर्म तत् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2121939, "chapter_id": 3615, "verse_number": "१६", "content_sanskrit": "तस्मिन्नभ्यर्चिते कृष्णे सुनीथः शत्रुसूदनः ।\nअतिताम्रेक्षणः क्रोधादुवाच मनुजाधिपान् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2121940, "chapter_id": 3615, "verse_number": "१७", "content_sanskrit": "हितः सेनापतिर्वोऽहं मर्षयध्वं किमीदृशम् ।\nयुधि तिष्ठाम सन्नह्य समेतान् वृष्णिपाण्डवान् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2121941, "chapter_id": 3615, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2121942, "chapter_id": 3615, "verse_number": "१८", "content_sanskrit": "तदा सर्वान् समुत्साद्य नृपतींश्चेदिपुङ्गवः ।\nयज्ञोपघातं पार्थानाममन्त्रयत राजभिः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2121943, "chapter_id": 3615, "verse_number": "२६", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nसभापर्वणि सप्तपञ्चाशोऽध्यायः ॥५७॥\n॥ अर्घाभिहरणपर्वणि षड्विंशोऽध्यायः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2121944, "chapter_id": 3615, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]