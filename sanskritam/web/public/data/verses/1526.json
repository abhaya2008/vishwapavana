[{"id": 2024636, "chapter_id": 1526, "verse_number": "३-१६४-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2024637, "chapter_id": 1526, "verse_number": "३-१६४-१", "content_sanskrit": "ततः सूर्योदये धौम्यः पाञ्चालीसहितांस्च तान्।\nआर्ष्टिणेन सहितः पाण्डवानभ्यवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2024638, "chapter_id": 1526, "verse_number": "३-१६४-२", "content_sanskrit": "तेऽभिवाद्यार्ष्टिषेणस्य पादौ धौम्यस्य चैव ह।\nततः प्राञ्जलयः सर्वे ब्राह्मणांस्तानपूजयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2024639, "chapter_id": 1526, "verse_number": "३-१६४-३", "content_sanskrit": "`आर्ष्टिषेणं परिष्वज्य पुत्रवद्भरतर्षभ।\nधर्मराजं स्पृशन्पाणौ पाणिना स महातपाः।\nप्राचीं दिशमभिप्रेक्ष्य महर्षिरिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2024640, "chapter_id": 1526, "verse_number": "३-१६४-४", "content_sanskrit": "असौ सागरपर्यन्तां भूमिमावृत्य तिष्ठति।\nशैलराजो महाराज मन्दरोऽभिविराजयन्।\nइन्द्रवैश्रवणोपेतां दिशं पाण्डव रक्षति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2024641, "chapter_id": 1526, "verse_number": "३-१६४-५", "content_sanskrit": "पर्वतैश्च वनान्तैश्च काननैश्चैव शोभितम्।\nएतमाहुर्महेन्द्रस्य राज्ञो वैश्रवणस्य च।\nऋषयः सर्वधर्मज्ञाः सर्वे तात मनीषिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2024642, "chapter_id": 1526, "verse_number": "३-१६४-६", "content_sanskrit": "अतश्चोद्यन्तमादित्यमुपतिष्ठन्ति वै प्रजाः।\nऋषयश्चापि धर्मज्ञाः सिद्धाः साध्याश्च देवताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2024643, "chapter_id": 1526, "verse_number": "३-१६४-७", "content_sanskrit": "यमस्तु राजा धर्मज्ञः सर्वप्राणभृतां प्रभुः।\nप्रेतसत्वगतीमेतां दक्षिणामाश्रितो दिशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2024644, "chapter_id": 1526, "verse_number": "३-१६४-८", "content_sanskrit": "एतत्संयमनं पुण्यमतीवाद्भुतदर्शनम्।\nप्रेतराजस्य भवनमृद्ध्या परमया युतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2024645, "chapter_id": 1526, "verse_number": "३-१६४-९", "content_sanskrit": "यं प्राप्य सविता राजन्सत्येन प्रतितिष्ठति।\nअस्तं पर्वतराजानमेतमाहुर्मनीषिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2024646, "chapter_id": 1526, "verse_number": "३-१६४-१०", "content_sanskrit": "एवं पर्वतराजानं समुद्रं च महोदधिम्।\nअवसन्वरुणो राजा भूतानि परिरक्षति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2024647, "chapter_id": 1526, "verse_number": "३-१६४-११", "content_sanskrit": "उदीचीं दीपयन्नेष दिशं तिष्ठति कीर्तिमान्।\nमहामेरुर्महाभाग शिवो ब्रह्मविदांगतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2024648, "chapter_id": 1526, "verse_number": "३-१६४-१२", "content_sanskrit": "यस्मिन्ब्रह्मसदश्चैव भूतात्मा चावतिष्ठते।\nप्रजापतिः सृजन्सर्वं यत्किंचिज्जङ्गमागमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2024649, "chapter_id": 1526, "verse_number": "३-१६४-१३", "content_sanskrit": "यानाहुर्ब्रह्मणः पुत्रान्मानसान्दक्षसप्तमान्।\nतेषामपि महामेरुः शिवं स्थानमनामयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2024650, "chapter_id": 1526, "verse_number": "३-१६४-१४", "content_sanskrit": "अत्रैव प्रतितिष्ठन्ति पुनरेषोदयन्ति च।\nसप्त देवर्षयस्तात वसिष्ठप्रमुखास्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2024651, "chapter_id": 1526, "verse_number": "३-१६४-१५", "content_sanskrit": "देशं विरजसं पश्य मेरोः शिखरमुत्तमम्।\nयत्रात्मतृप्तैरध्यास्ते देवैः सह पितामहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2024652, "chapter_id": 1526, "verse_number": "३-१६४-१६", "content_sanskrit": "यमाहुः सर्वभूतानां प्रकृतेः प्रकृतिं ध्रुवम्।\nअनादिनिधनं देवं प्रभुं नारायणं परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2024653, "chapter_id": 1526, "verse_number": "३-१६४-१७", "content_sanskrit": "ब्रह्मणः सदनात्तस्य परं स्थानं प्रकाशते।\nदेवाश्च यत्नात्पश्यन्ति सर्वतेजोमयं शुभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2024654, "chapter_id": 1526, "verse_number": "३-१६४-१८", "content_sanskrit": "अत्यर्कानलदीप्तं तत्स्थानं विष्णोर्महात्मनः।\nस्वयैव प्रभया राजन्दुष्प्रेक्ष्यं देवदानवैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2024655, "chapter_id": 1526, "verse_number": "३-१६४-१९", "content_sanskrit": "प्राच्यां नारायणस्थानं मेरावतिविराजते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2024656, "chapter_id": 1526, "verse_number": "३-१६४-२०", "content_sanskrit": "यत्र भूतेश्वरस्तात सर्वप्रकृतिरात्मभूः।\nभासयन्सर्वभूतानि सुश्रियाऽभिविराजते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2024657, "chapter_id": 1526, "verse_number": "३-१६४-२१", "content_sanskrit": "नात्र ब्रह्मर्षयस्तात कुत एव महर्षयः।\nप्राप्नुवन्ति गतिं ह्येतां यतीनां भावितात्मनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2024658, "chapter_id": 1526, "verse_number": "३-१६४-२२", "content_sanskrit": "न तं ज्योतींपि सर्वाणि प्राप्य भासन्ति पाण्डव।\nस्वयंप्रभुरचिन्त्यात्मा तत्र ह्यतिविराजते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2024659, "chapter_id": 1526, "verse_number": "३-१६४-२३", "content_sanskrit": "यतयस्तत्र गच्छन्ति भक्त्या नारायणं हरिम्।\nपरेण तपसा युक्ता भाविताः कर्मभिः शुभैः।\nयोगसिद्धा महात्मानस्तमोमोहविवर्जिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2024660, "chapter_id": 1526, "verse_number": "३-१६४-२४", "content_sanskrit": "तत्र गत्वा पुनर्नेमं लोकमायान्ति भारत।\nस्वयंभुवं महात्मानं देवदेवं सनातनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2024661, "chapter_id": 1526, "verse_number": "३-१६४-२५", "content_sanskrit": "स्थानमेतन्महाभाव ध्रुवमक्षयमव्ययम्।\nईश्वरस्य सदा ह्येतत्प्रणमात्र युधिष्ठिर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2024662, "chapter_id": 1526, "verse_number": "३-१६४-२६", "content_sanskrit": "[एनं त्वहरहर्मेरुं सूर्याचन्द्रमसौ ध्रुवम्।\nप्रदक्षिणमुपावृत्यकुरुतः कुरुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2024663, "chapter_id": 1526, "verse_number": "३-१६४-२७", "content_sanskrit": "ज्योतींषि चाप्यशेषेण सर्वाण्यनघ सर्वतः।\nपरियान्ति महाराज गिरिराजं प्रदक्षिणम् ॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2024664, "chapter_id": 1526, "verse_number": "३-१६४-२८", "content_sanskrit": "एतं ज्योतींषि सर्वाणि प्रकर्षन्भगवानपि।\nकुरुते वितमस्कर्मा आदित्योऽभिप्रदक्षिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2024665, "chapter_id": 1526, "verse_number": "३-१६४-२९", "content_sanskrit": "अस्तं प्राप्य ततः सन्ध्यामतिक्रम्य दिवाकरः।\nउदीचीं भजते काष्ठां बहुधा पर्वसन्धिषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2024666, "chapter_id": 1526, "verse_number": "३-१६४-३०", "content_sanskrit": "सुमेरुमनुवृत्तः स पुनर्गच्छति पाण्डव।\nप्राङ्युखः सविता देवः सर्वभूतहिते रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2024667, "chapter_id": 1526, "verse_number": "३-१६४-३१", "content_sanskrit": "स सम्यग्विभजन्कालान्बहुधा पर्वसन्धिषु।\nतथैव भगवान्सोमो नक्षत्रैः सह गच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2024668, "chapter_id": 1526, "verse_number": "३-१६४-३२", "content_sanskrit": "एवमेतं त्वतिक्रम्य महामेरुमतन्द्रितः।\nसोमश्च विभजन्कालं बहुधा पर्वसन्धिषु।\nभासयन्सर्वभूतानि पुनर्गच्छति सागरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2024669, "chapter_id": 1526, "verse_number": "३-१६४-३३", "content_sanskrit": "तथा तमिस्रहा देवो मयूखैर्भासयञ्जगत्।\nमार्गमेतमसंबाधमादित्यः परिवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2024670, "chapter_id": 1526, "verse_number": "३-१६४-३४", "content_sanskrit": "सिसृक्षुः शिशिराण्येव दक्षिणां भजते दिशम्।\nततः सर्वाणि भूतानि कालं शिशिरमृच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2024671, "chapter_id": 1526, "verse_number": "३-१६४-३५", "content_sanskrit": "स्थावराणां च भूतानां जङ्गमानां च तेजसा।\nतेजांसि समुपादत्ते निवृत्तः स विभावसुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2024672, "chapter_id": 1526, "verse_number": "३-१६४-३६", "content_sanskrit": "ततः स्वेदः क्लमस्तन्द्री ग्लानिश्च भजते नरान्।\nप्राणिभिः सततं स्वप्नोह्यभीक्ष्णं च निपेव्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2024673, "chapter_id": 1526, "verse_number": "३-१६४-३७", "content_sanskrit": "एवमेतमनिर्देश्यं मार्गमावृत्य भानुमान्।\nपुनः सृजति वर्षाणि भगवान्भासयन्प्रजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2024674, "chapter_id": 1526, "verse_number": "३-१६४-३८", "content_sanskrit": "वृष्टिमारुतसंतापैः सुखैः स्थावरजङ्गमान्।\nवर्धयनसुमहातेजाः पुनः प्रतिनिवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2024675, "chapter_id": 1526, "verse_number": "३-१६४-३९", "content_sanskrit": "एवमेष चरन्पार्थ कालचक्रमतन्द्रितः।\nप्रकर्षन्सर्वभूतानि सविता परिवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2024676, "chapter_id": 1526, "verse_number": "३-१६४-४०", "content_sanskrit": "संतता गतिरेतस्य नैष तिष्ठति पाण्डव।\nआदायैव तु भूतानां तेजो विसृजते पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2024677, "chapter_id": 1526, "verse_number": "३-१६४-४१", "content_sanskrit": "विभजन्सर्वभूतानामायुः कर्म च भारत।\nअहोरात्रं कलाः काष्ठाः सृजत्येष सदा विभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2024678, "chapter_id": 1526, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि यक्षयुद्धपर्वणि चतुःषष्ट्यधिकशततमोऽध्यायः ॥ १६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]