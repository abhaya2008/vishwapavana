[{"id": 7004157000, "chapter_id": 24157, "verse_number": "५-१-६-१", "content_sanskrit": "सनत्कुमार उवाच ।\nप्रविश्याथ वनं देवाः सर्वपुष्पोपशोभितम् ।\nइह देवो ऽत्र देवोऽत्र विविशुस्ते दिदृक्षवः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004157001, "chapter_id": 24157, "verse_number": "५-१-६-२", "content_sanskrit": "अद्भुतस्य वनस्यांते न ते ददृशिरे सुराः ।\nविचिन्वंतो महादेवं देवैर्बहुविलोकितः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004157002, "chapter_id": 24157, "verse_number": "५-१-६-३", "content_sanskrit": "तमुवाच स भद्रं वै द्रक्ष्यध्वं न तपो विना ।\nविचिन्वन्तो विरूपाक्षं नैनं पश्यत शंकरम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004157003, "chapter_id": 24157, "verse_number": "५-१-६-४", "content_sanskrit": "स युक्तं हृदये स्मृत्वा ब्रह्मा देवांस्ततोऽब्रवीत् ।\nत्रिविधो दर्शनोपायस्तस्य देवस्य सर्वदा॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004157004, "chapter_id": 24157, "verse_number": "५-१-६-५", "content_sanskrit": "श्रद्धाज्ञानेन तपसा योगेनैव निगद्यते ।\nसकलं निष्कलं चापि देवाः पश्यंति योगिनः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004157005, "chapter_id": 24157, "verse_number": "५-१-६-६", "content_sanskrit": "तपस्विनस्तु सकलं ज्ञानिनो निष्कलं परम् ।\nसमुत्पन्नेऽपि विज्ञाने मंदश्रद्धो न पश्यति॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004157006, "chapter_id": 24157, "verse_number": "५-१-६-७", "content_sanskrit": "भक्त्या परमयोपेताः परं पश्यंति योगिनः ।\nद्रष्टव्यो निर्विकारोऽसौ प्रधानपुरुषेश्वरः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004157007, "chapter_id": 24157, "verse_number": "५-१-६-८", "content_sanskrit": "नादीक्षितैरतो देवाः शैवीं दीक्षां प्रपद्यत ।\nकर्मणा मनसा वाचा नित्ययुक्ता महेश्वरे॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004157008, "chapter_id": 24157, "verse_number": "५-१-६-९", "content_sanskrit": "तपश्चरत भद्रं वो रुद्राराध नतत्पराः ।\nशिवदीक्षां प्रपन्नानां भक्तानां च तपस्विनाम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004157009, "chapter_id": 24157, "verse_number": "५-१-६-१०", "content_sanskrit": "सर्वकालं विजानाति दातव्यं दर्शनं मया ।\nब्रह्मणो वचनं श्रुत्वा हितमेव यदु क्तवान्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004157010, "chapter_id": 24157, "verse_number": "५-१-६-११", "content_sanskrit": "शिवेक्षाविष्टमतयो ब्रह्माणमिदमबुवन् ।\nमार्गेण विधिना चैव शिवदीक्षासु तत्पराः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004157011, "chapter_id": 24157, "verse_number": "५-१-६-१२", "content_sanskrit": "प्रयच्छ ब्रह्मन्सर्वेषां दीक्षां नः शिवतोषदाम् ।\nश्रुत्वेति वचनं ब्रह्मा प्रत्युवाच विचारितम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004157012, "chapter_id": 24157, "verse_number": "५-१-६-१३", "content_sanskrit": "संदिदीक्षयिषुः क्षिप्रममराञ्छिवदीक्षया ।\nशिवयज्ञार्थसंभारानानयध्वमलं सुराः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004157013, "chapter_id": 24157, "verse_number": "५-१-६-१४", "content_sanskrit": "वेदी प्रकल्प्यतामत्र यष्टव्योऽष्टतनुः शिवः ।\nपद्मयोनेर्वचः श्रुत्वा चक्रुः सर्वमतः सुराः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004157014, "chapter_id": 24157, "verse_number": "५-१-६-१५", "content_sanskrit": "विनीतवेषाः प्रणता अनेन सस्तमन्वगुः ।\nशिवप्रसादसंप्राप्त्यै पुष्करज्ञानमीरितम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004157015, "chapter_id": 24157, "verse_number": "५-१-६-१६", "content_sanskrit": "यज्ञं चकार विधिना वेधाश्चन्द्रार्धधारिणः ।\nपद्मयोनिः पुरस्कृत्य तदा दीक्षां प्र योगतः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004157016, "chapter_id": 24157, "verse_number": "५-१-६-१७", "content_sanskrit": "अनुग्रहेण देवांस्तानकारयत भावतः ।\nततो व्रतानां प्रवरं व्रतं दिव्यं महाप्रभुः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004157017, "chapter_id": 24157, "verse_number": "५-१-६-१८", "content_sanskrit": "तेभ्यो ददौ देवताभ्यः स तदप्यविरोधवित् ।\nपठ्यते शिवशालायां महापाशुपतं व्रतम्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004157018, "chapter_id": 24157, "verse_number": "५-१-६-१९", "content_sanskrit": "शैवं यथोदितं यच्च आगमाचारचेष्टितम् ।\nशिवाराधनमुख्यानां मुनीनां तीव्रतेजसाम्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004157019, "chapter_id": 24157, "verse_number": "५-१-६-२०", "content_sanskrit": "सर्वानुग्राहकः शंभुः सर्वदेवैः प्रकल्पितम् ।\nतदेवं प्रार्थितं बुद्ध्या व्रतं रौद्रं शिवं समम्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004157020, "chapter_id": 24157, "verse_number": "५-१-६-२१", "content_sanskrit": "तत्तेभ्यो विस्मयं त्यक्त्वा प्रायच्छत्कनकांडजः ।\nकामिकं भस्मनामाढ्यं सर्वदा कीर्तितं शुभम्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004157021, "chapter_id": 24157, "verse_number": "५-१-६-२२", "content_sanskrit": "पापघ्रं दुःखशमनं पुष्टिश्रीबलवर्धनम् ।\nसिद्धिदं कीर्तिकृत्कांतं कलिकल्मषमोक्षणम्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004157022, "chapter_id": 24157, "verse_number": "५-१-६-२३", "content_sanskrit": "तस्मात्सर्वप्रयत्नेन भस्मस्नानं समाहिताः ।\nकुर्वंतो मानवा दांता दीक्षिताः संयतेंद्रियाः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004157023, "chapter_id": 24157, "verse_number": "५-१-६-२४", "content_sanskrit": "सर्वे कमंडलुधराः सर्वे रुद्राक्षधारिणः ।\nअनिष्टदर्शनालाप संगत्या परिवर्जिताः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004157024, "chapter_id": 24157, "verse_number": "५-१-६-२५", "content_sanskrit": "एवं व्रतधराः सर्वे वने तस्मिन्महेश्वरम् ।\nआराधयंस्तमीशानं व्रतेनैव उमाधवम्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004157025, "chapter_id": 24157, "verse_number": "५-१-६-२६", "content_sanskrit": "भक्त्या परमया युक्ता विधिना परमेण च ।\nकालेन महता ध्यानादेवं ज्ञात्वा मनोगतम्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004157026, "chapter_id": 24157, "verse_number": "५-१-६-२७", "content_sanskrit": "रुद्रध्यानाग्निनिर्दग्धकल्मषाश्च श्रियान्विताः ।\nतदा हत्वाऽसुरं शंभुः प्रत्यक्षो भगवानभूत्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004157027, "chapter_id": 24157, "verse_number": "५-१-६-२८", "content_sanskrit": "सनत्कुमार उवाच ।\nब्रह्मदत्तं वरं देवाः सर्वे शर्वानुभाविताः ।\nसमचीकरन्प्रत्युक्ता ब्रह्मापीशानभावितः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004157028, "chapter_id": 24157, "verse_number": "५-१-६-२९", "content_sanskrit": "गते वर्षसहस्रे स दिव्ये देवेश्वरेश्वरः ।\nजातानुकंपो देवानां दीपो दर्शनमेयिवान्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004157029, "chapter_id": 24157, "verse_number": "५-१-६-३०", "content_sanskrit": "गणैर्नानाविधैः सार्धं नानाभूषणभूषितैः ।\nसुदर्पोद्भूतदर्पघ्रैघोरैर्घोरविघातिभिः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004157030, "chapter_id": 24157, "verse_number": "५-१-६-३१", "content_sanskrit": "कामरूपैरकामैश्च सर्वकामसमन्वितैः ।\nकरींद्रकरटाटोपपाटनैः सिंहदेहिभिः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004157031, "chapter_id": 24157, "verse_number": "५-१-६-३२", "content_sanskrit": "अणिमादि गुणैर्दिव्यैर्योगैश्वर्यादिनामभिः ।\nव्यालोलकेशरशनादंष्ट्राकटकटोद्भवैः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004157032, "chapter_id": 24157, "verse_number": "५-१-६-३३", "content_sanskrit": "व्याघ्रव्यालाननै रौद्रैः काककंकवटैस्तथा॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004157033, "chapter_id": 24157, "verse_number": "५-१-६-३४", "content_sanskrit": "अरूपैः समरूपैश्च सुरूपैर्बहुरूपकैः ।\nएकद्वित्रिशिरोभिश्च बहुशीर्षैरशीर्षकैः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004157034, "chapter_id": 24157, "verse_number": "५-१-६-३५", "content_sanskrit": "एकद्वित्रिशिखैश्चैव नानारूपविराजितैः ।\nबहुनेत्रैरनेत्रैश्च एकद्वित्रिविलो चनैः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004157035, "chapter_id": 24157, "verse_number": "५-१-६-३६", "content_sanskrit": "एककर्णैर्द्विकर्णैश्च बहुकर्णैर्विकर्णकैः ।\nएकद्वित्रिसुनासैश्च बहुनासैरनासिकैः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004157036, "chapter_id": 24157, "verse_number": "५-१-६-३७", "content_sanskrit": "एकजंघैर्द्विजंघैश्च बहुजंघैरजंघकैः ।\nएक पादैर्द्विपादैश्च बहुपादैरपादकैः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004157037, "chapter_id": 24157, "verse_number": "५-१-६-३८", "content_sanskrit": "गौरश्यामैः श्यामगौरैरसितैः कर्बुरैस्तथा ।\nभुजंगहारवलयैः कृतयज्ञोपवीतकैः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004157038, "chapter_id": 24157, "verse_number": "५-१-६-३९", "content_sanskrit": "शूलासिपट्टिश धरैर्भुशुंडीपीरघायुधैः ।\nचक्रक्रकचकोदंडकांडदंडास्त्रपाणिभिः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004157039, "chapter_id": 24157, "verse_number": "५-१-६-४०", "content_sanskrit": "गदामुद्गरपाषाणमुशलायुधहस्तकैः ।\nवज्रशक्त्यशनिप्रासकुंतकर्तृक धारिभिः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004157040, "chapter_id": 24157, "verse_number": "५-१-६-४१", "content_sanskrit": "भंभाभेरीर्वादयद्भिर्वीणापणववेणुकान् ।\nमृदंगविमलाढक्काकाहलानकदुंदुभीन्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004157041, "chapter_id": 24157, "verse_number": "५-१-६-४२", "content_sanskrit": "हुडंकाशृंगिकाद्यानि नानावाद्यानि वादकैः ।\nएवं नानाविधै रौद्रैर्भीमैर्भीमपराक्रमैः॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004157042, "chapter_id": 24157, "verse_number": "५-१-६-४३", "content_sanskrit": "गणेश्वरैः सुदुर्द्धर्षैर्वृतः सूर्यो ग्रहैरिव ।\nआविर्भूतो महादेवः स्वगणैः परिवारितः ।\nतं पश्य तां तदा व्यास ब्रह्मादीनां दिवौकसाम्॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004157043, "chapter_id": 24157, "verse_number": "५-१-६-४४", "content_sanskrit": "अथ ब्रह्मादयो देवा दृष्ट्वाग्रे गणनायकम् ।\nतेजसाध्यासितास्तस्य बभूवुर्भ्रांतचेतसः॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004157044, "chapter_id": 24157, "verse_number": "५-१-६-४५", "content_sanskrit": "ततो ऽवलंब्य ते धैर्यं दृष्ट्वा देवं यथाविधि ।\nषडंगवेदयोगेन हृष्टचित्तवपुर्धराः॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004157045, "chapter_id": 24157, "verse_number": "५-१-६-४६", "content_sanskrit": "शिरोगतैरंजलिभिः पादेभ्यश्च महीं गतैः ।\nतुष्टुवुः सृष्टिसंहार स्थितिकर्तारमीश्वरम्॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004157046, "chapter_id": 24157, "verse_number": "५-१-६-४७", "content_sanskrit": "देवा ऊचुः ।\nनमः शिवाय शांताय सगणाय सनंदिने ।\nवृषासनाय सौम्याय शूलशक्तिधराय ते॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004157047, "chapter_id": 24157, "verse_number": "५-१-६-४८", "content_sanskrit": "नमो दिक्चर्मवस्त्राय शुचये तीव्रतेजसे ।\nब्रह्मणे ब्रह्मदेहाय ब्रह्मणा योजिताय च॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004157048, "chapter_id": 24157, "verse_number": "५-१-६-४९", "content_sanskrit": "नमोंधकविनाशाय परेशाय नमोनमः ।\nरुद्राय पंच वक्त्राय सर्वरोगापहारिणे॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004157049, "chapter_id": 24157, "verse_number": "५-१-६-५०", "content_sanskrit": "गिरिशाय सुरेशाय ईशानाय नमोनमः ।\nभीमोग्रादिस्वरूपाय विजयाय नमोनमः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004157050, "chapter_id": 24157, "verse_number": "५-१-६-५१", "content_sanskrit": "सुरासुराधिपतये यतीनां पतये नमः ।\nचंडाय चंडदंडाय वरखट्वांगदंडिने॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004157051, "chapter_id": 24157, "verse_number": "५-१-६-५२", "content_sanskrit": "विरूपाक्षशुभाख्याय विश्वरूपाय वै नमः ।\nशांताय च मनोज्ञाय त्रिनेत्राय नमोनमः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004157052, "chapter_id": 24157, "verse_number": "५-१-६-५३", "content_sanskrit": "वेधसे विश्वरूपाय दैत्यसंहारिणे नमः ।\nभक्तानुकंपिनेऽत्यर्थं रुद्रज्ञानपराय च॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004157053, "chapter_id": 24157, "verse_number": "५-१-६-५४", "content_sanskrit": "विरूपाय सुरूपाय रूपाणां शतधारिणे ।\nपंचास्याय शुभास्याय चन्द्रास्याय नमोनमः॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004157054, "chapter_id": 24157, "verse_number": "५-१-६-५५", "content_sanskrit": "वरदाय वराहाय सुकूर्माय नमोनमः॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004157055, "chapter_id": 24157, "verse_number": "५-१-६-५६", "content_sanskrit": "त्रिनेत्र त्राणमस्माकं त्रिपुरघ्न विधीयताम् ।\nवाङ्मनःकायभावैस्त्वां प्रपन्नानां महेश्वर॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004157056, "chapter_id": 24157, "verse_number": "५-१-६-५७", "content_sanskrit": "सनत्कुमार उवाच ।\nएवं स्तुतस्तदा देवैर्विरिंच्याद्यैस्तथा हरः ।\nशरीराणि विलोक्येशः कृशान्यथ दिवौकसाम्॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004157057, "chapter_id": 24157, "verse_number": "५-१-६-५८", "content_sanskrit": "दिव्यप्रतापधारेण त्रिवेधेनांतरात्मना॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004157058, "chapter_id": 24157, "verse_number": "५-१-६-५९", "content_sanskrit": "आराधनं समीक्ष्याह ब्रह्मादीनां सुरेश्वरः ।\nसाधुसाधु महाभागाः शश्वद्व्रतमुपासितम्॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004157059, "chapter_id": 24157, "verse_number": "५-१-६-६०", "content_sanskrit": "दिव्येनानेन विधिना भृशमाराधितो ह्यहम् ।\nभवद्भिः श्र द्धयात्यर्थं मम दर्शनकांक्षया॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004157060, "chapter_id": 24157, "verse_number": "५-१-६-६१", "content_sanskrit": "व्रतस्था मां हि पश्यंति मानुषा देवता अपि ।\nयदि यच्च प्रयच्छामि कांश्चिद्वो हि वराञ्छुभान्॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004157061, "chapter_id": 24157, "verse_number": "५-१-६-६२", "content_sanskrit": "एकैकशो द्वित्रिशो वा समस्तेभ्यः समेन वः ।\nसर्वकामप्रसिद्ध्यर्थं दास्याम्येनं वरं हि वः॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004157062, "chapter_id": 24157, "verse_number": "५-१-६-६३", "content_sanskrit": "हिताय भवतां चाहमागामुज्जयिनीं प्रति ।\nक्षिप्तं कपालं च मया किं पुनर्भद्रमस्तु वः॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004157063, "chapter_id": 24157, "verse_number": "५-१-६-६४", "content_sanskrit": "देवा ऊचुः ।\nकिं कृतं हितमस्माकं कपालं क्षिपता त्वया॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004157064, "chapter_id": 24157, "verse_number": "५-१-६-६५", "content_sanskrit": "किमर्थं कंपिता भूमिस्त्रैलोक्यं व्याकुलीकृतम् ।\nनैतन्निरर्थकं देव कथ्यतामत्र कारणम्॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004157065, "chapter_id": 24157, "verse_number": "५-१-६-६६", "content_sanskrit": "महादेव उवाच ।\nयुष्मद्धितार्थमेतद्वै भयं विनिहितं कृतम् ।\nदेवतानां तु रक्षार्थं श्रूयतामत्र कारणम्॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004157066, "chapter_id": 24157, "verse_number": "५-१-६-६७", "content_sanskrit": "असुरो द्रोहणोनाम बलवान्योगमायिकः ।\nअवस्थितस्त्ववष्टभ्य रसातलतला श्रयम्॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004157067, "chapter_id": 24157, "verse_number": "५-१-६-६८", "content_sanskrit": "तस्य दैत्यस्य बलिनो दैत्याः परपुरंजयाः ।\nयुष्माञ्ज्ञात्वा तपस्थांश्चाप्यभ्यगुर्बहवो हि ते॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004157068, "chapter_id": 24157, "verse_number": "५-१-६-६९", "content_sanskrit": "सेंद्रान्निहंतुमिच्छंतो माया प्रच्छन्नचारकाः ।\nपुरीं कनकशृंगाढ्यामेनामधि कुशस्थलीम् ।\nसमुद्ययुः सुरान्हंतुमुद्यता उद्यतायुधाः॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004157069, "chapter_id": 24157, "verse_number": "५-१-६-७०", "content_sanskrit": "तेषां कपालपातेन भूमिनिष्कं पनेन च ।\nशब्देन चातिघोरेण देहात्प्राणा विनिर्ययुः॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004157070, "chapter_id": 24157, "verse_number": "५-१-६-७१", "content_sanskrit": "लोकस्थितिविनाशाथ तेषामासीत्समुद्यमः ।\nराज्यैश्वर्येण दर्पिष्ठास्तेन ते निहता मया॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004157071, "chapter_id": 24157, "verse_number": "५-१-६-७२", "content_sanskrit": "देवा ऊचुः ।\nविश्वस्तानां पुनश्चैवमेव चानुग्रहः कृतः ।\nदेवानुग्रहकर्ता त्वं गुणस्मृतिनिषेवितः॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004157072, "chapter_id": 24157, "verse_number": "५-१-६-७३", "content_sanskrit": "दिव्यदृष्टिभिरत्यर्थं यशोऽर्थं भीम नंदिताः ।\nइत्युक्त्वा प्रणतान्देवानुत्थाप्योचे पुनर्भवः॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004157073, "chapter_id": 24157, "verse_number": "५-१-६-७४", "content_sanskrit": "शिव उवाच ।\nपरिचर्याभिसंयुक्तं नित्यमुग्रनिषेवितम् ।\nध्यानसाधननिष्पन्नं यदन्येषां न विद्यते॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004157074, "chapter_id": 24157, "verse_number": "५-१-६-७५", "content_sanskrit": "मनोवाक्कायभावेन दुष्करं दुश्चरं तपः ।\nअनेन तपसा युक्ताः कष्टेन दुःसहेन च॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004157075, "chapter_id": 24157, "verse_number": "५-१-६-७६", "content_sanskrit": "महता तनुसाध्येन बहुकालार्जितेन वः ।\nसमंतादभिवर्धेतां युष्मत्तेजस्तपोऽपि च॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004157076, "chapter_id": 24157, "verse_number": "५-१-६-७७", "content_sanskrit": "सनत्कुमार उवाच ।\nइत्युक्ता देवदेवेन देवा ब्रह्मपुरोगमाः ।\nऊचुरुन्नाम्य वक्त्राणि स्थिता जानुभिरीश्वरम्॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004157077, "chapter_id": 24157, "verse_number": "५-१-६-७८", "content_sanskrit": "देवा ऊचुः ।\nप्राणदस्त्वं कारणस्त्वं तपसां देव दृश्यसे ।\nतदस्माकं प्रवृत्तानां मानुषाणां वरप्रद॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004157078, "chapter_id": 24157, "verse_number": "५-१-६-७९", "content_sanskrit": "रक्षां कुरुष्व देवेश भक्तानामभयंकर॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004157079, "chapter_id": 24157, "verse_number": "५-१-६-८०", "content_sanskrit": "ईश्वर उवाच ।\nयत्नेन विधिना दत्तं सुव्यक्तं दर्शनं हि वः ।\nसुदुर्लभान्यपि पुनर्दास्यामि वो वरान्बहून्॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004157080, "chapter_id": 24157, "verse_number": "५-१-६-८१", "content_sanskrit": "एवमुक्ते भगवता ब्रह्मा वचनमब्रवीत् ।\nदेवानामग्रतः स्थित्वा श्रुतशब्दोद्भवं भवम्॥ ८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004157081, "chapter_id": 24157, "verse_number": "५-१-६-८२", "content_sanskrit": "प्राप्ता वयं च भगवन्सुपर्याप्तो महावरः ।\nजायतां नः सदैश्वर्यं वासस्थानमथाक्षयम्॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7004157082, "chapter_id": 24157, "verse_number": "५-१-६-८३", "content_sanskrit": "शिव उवाच ।\nलोकेऽस्मिन्मम ये भक्ता मया विनिहताश्च ये ।\nनैवं ते दुर्गतिं यांति लभंते सुमतिं पराम्॥ ८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7004157083, "chapter_id": 24157, "verse_number": "५-१-६-८४", "content_sanskrit": "सार्धं तत्र जटाजूटैः शिरोभिः शूलपाणयः ।\nभांति मद्वामपार्श्वस्था इमे ते दारुणा गणाः॥ ८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7004157084, "chapter_id": 24157, "verse_number": "५-१-६-८५", "content_sanskrit": "येषां विनिग्रहार्थाय युष्मत्संबोधनाय च ।\nसविकारं मया क्षिप्तं कपालं धरणीतले॥ ८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7004157085, "chapter_id": 24157, "verse_number": "५-१-६-८६", "content_sanskrit": "कृतो मेऽनुग्रहस्तेषां भक्तानां भक्तिमिच्छताम् ।\nवनेऽस्मिन्नित्यवासो मे वृक्षैरभ्यर्थितस्य च॥ ८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7004157086, "chapter_id": 24157, "verse_number": "५-१-६-८७", "content_sanskrit": "महाकालवने देवा आगतस्य ममानघाः ।\nतपस्यतां च भवतां महाकालवनं ततः॥ ८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7004157087, "chapter_id": 24157, "verse_number": "५-१-६-८८", "content_sanskrit": "नामद्वययुतं गुह्यं लोके ख्यातं भविष्यति ।\nगुह्यं वनं श्मशानं च क्षेत्राणां प्रवरं महत्॥ ८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7004157088, "chapter_id": 24157, "verse_number": "५-१-६-८९", "content_sanskrit": "कपालव्रतचर्या च मया ह्येषा प्रकीर्तिता ।\nकपालपात्रे भुंजानः कपालव्रतभूषणः॥ ८९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7004157089, "chapter_id": 24157, "verse_number": "५-१-६-९०", "content_sanskrit": "कपालपाणिः संतुष्टो भिक्षा व्रतसमन्वितः ।\nश्मशाननिलयो रौद्रो व्रतोन्मत्तविमूढधीः॥ ९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7004157090, "chapter_id": 24157, "verse_number": "५-१-६-९१", "content_sanskrit": "नंदितः सर्वभूतेषु प्रियाप्रियसमः सदा ।\nभस्मभूषितसर्वांगो ज्ञानी चैव विशेषतः॥ ९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7004157091, "chapter_id": 24157, "verse_number": "५-१-६-९२", "content_sanskrit": "जितेंद्रियोऽसर्वसंगो मृद्भस्मोदकसंग्रही ।\nनित्ययुक्तः सदाव्यापी जापी जितवरासनः॥ ९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7004157092, "chapter_id": 24157, "verse_number": "५-१-६-९३", "content_sanskrit": "पुण्यतीर्थाश्रमोपेतः स्वरे देवे समाहितः ।\nलोकातीतं परं ज्ञानं महापाशुपतं व्रतम्॥ ९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7004157093, "chapter_id": 24157, "verse_number": "५-१-६-९४", "content_sanskrit": "कपालव्रतमास्थाय पुरा चीर्णं मया स्वयम् ।\nकपालं परमं गुह्यं पवित्रं पापनाशनम्॥ ९४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7004157094, "chapter_id": 24157, "verse_number": "५-१-६-९५", "content_sanskrit": "कपालव्रतमेतद्धि दुर्धरं परमाद्भुतम् ।\nअत्यंतमुत्कटं रौद्रमघोरं लोमहर्षणम्॥ ९५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7004157095, "chapter_id": 24157, "verse_number": "५-१-६-९६", "content_sanskrit": "महाव्रतं द्विषन्मोहात्पापेनैव स्थितो नरः ।\nन मुच्यते स पापेन जन्मकोटिशतैरपि॥ ९६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7004157096, "chapter_id": 24157, "verse_number": "५-१-६-९७", "content_sanskrit": "महापाशुपतं तस्मान्न हन्यान्न च दूषयेत् ।\nएतस्मिन्निहते तस्मात्कोटिर्भवति घातिता॥ ९७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7004157097, "chapter_id": 24157, "verse_number": "५-१-६-९८", "content_sanskrit": "एवं महाव्रतं यस्तु भोजयेच्छ्रद्धयान्वितः ।\nतस्य भुक्ता भवेत्कोटिर्विप्राणां वेदपाठिनाम्॥ ९८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7004157098, "chapter_id": 24157, "verse_number": "५-१-६-९९", "content_sanskrit": "कपालपूरणीं भिक्षां यतीनां यः प्रयच्छति ।\nविमुक्तः सर्व पापेभ्यो नासौ दुर्गतिमाप्नुयात्॥ ९९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7004157099, "chapter_id": 24157, "verse_number": "५-१-६-१००", "content_sanskrit": "कपाले भोजनं श्रेष्ठं मार्गोऽयं ब्रह्मसंभवः ।\nवदंति लोके वेदेषु पूजितं देवदानवैः॥ १०० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7004157100, "chapter_id": 24157, "verse_number": "५-१-६-१०१", "content_sanskrit": "धारयिष्यंति ये विप्राः कपालं भूतमोहनम् ।\nमम तुल्यास्तु ते ब्रह्मन्विचरंति महीतले॥ १०१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7004157101, "chapter_id": 24157, "verse_number": "५-१-६-१०२", "content_sanskrit": "जपैकनिरता धीराः कपालकृतभूषणाः ।\nमहापाशुपता लोके रुद्राः संसारतारकाः॥ १०२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7004157102, "chapter_id": 24157, "verse_number": "५-१-६-१०३", "content_sanskrit": "धर्माधर्मविमुक्ताश्च कृत्याकृत्यविवर्जिताः ।\nदीक्षया ज्ञानयोगेन प्राणिनस्तारयंति ते॥ १०३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7004157103, "chapter_id": 24157, "verse_number": "५-१-६-१०४", "content_sanskrit": "यानि तीर्थानि लोकेऽस्मिन्यज्ञकोटिशतानि च ।\nविशुद्धस्य विज्ञानस्य कलां नार्हंति षोडशीम्॥ १०४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7004157104, "chapter_id": 24157, "verse_number": "५-१-६-१०५", "content_sanskrit": "यथाहं सर्वदेवानां संपूज्यो वै पितामह ।\nतथैव सर्वयोगेभ्यः संपूज्योऽयं महाव्रती॥ १०५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7004157105, "chapter_id": 24157, "verse_number": "५-१-६-१०६", "content_sanskrit": "संसारबन्धमोक्षार्थं शिवगुह्यमिदं व्रतम् ।\nयदेतत्सर्वधर्मेण अपुनर्भवकारणम्॥ १०६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7004157106, "chapter_id": 24157, "verse_number": "५-१-६-१०७", "content_sanskrit": "कपालव्रतमादाय यस्त्यजेदजिते न्द्रियः ।\nरौरवं स प्रयात्याशु प्रणीतो यमकिंकरैः॥ १०७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7004157107, "chapter_id": 24157, "verse_number": "५-१-६-१०८", "content_sanskrit": "आलापयति भावेन न तु कर्म करोति यः ।\nसरागचित्तः शृंगारी न च धर्मप्रियंकरः॥ १०८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7004157108, "chapter_id": 24157, "verse_number": "५-१-६-१०९", "content_sanskrit": "एकत्र भोजी मिष्टाश्ी कैतवेन प्रियस्तथा ।\nकुग्रामनगरे वासी कृषिवाणिज्यसेवकः॥ १०९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7004157109, "chapter_id": 24157, "verse_number": "५-१-६-११०", "content_sanskrit": "इत्यादिदुष्टदोषश्च तस्य संभाषणादपि ।\nनरो नरकगामी स्याद्यतो मद्व्रतदूषकः॥ ११० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7004157110, "chapter_id": 24157, "verse_number": "५-१-६-१११", "content_sanskrit": "दृष्ट्वा च शिष्टमथ ३ महाव्रतधरो नरः ।\nन स्पृशेदंगमंगेन स्पृष्ट्वा स्नायात्तु चांबुभिः॥ १११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7004157111, "chapter_id": 24157, "verse_number": "५-१-६-११२", "content_sanskrit": "एवं च सर्वमाख्यातं कपालस्य च मोक्षणम् ।\nयथा मयात्र निक्षिप्तमज्ञानेन हतं स्वयम्॥ ११२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7004157112, "chapter_id": 24157, "verse_number": "५-१-६-११३", "content_sanskrit": "सनत्कुमार उवाच ।\nएवमुक्त्वा स भगवान्ब्रह्माद्यैरमरैः सह ।\nक्षेत्रं निवासयामास यथावत्कथयामि ते॥ ११३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7004157113, "chapter_id": 24157, "verse_number": "५-१-६-११४", "content_sanskrit": "आद्यमेततत्स्मशानं च पठ्यते मुनिसत्तमैः ।\nमहाकालवनं व्यास यत्र सन्नि हितो हरः॥ ११४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7004157114, "chapter_id": 24157, "verse_number": "५-१-६-११५", "content_sanskrit": "अनुग्रहस्य भुवनं भूमिभागो न संशयः ।\nअनुग्रहार्थं भूतानां क्षेत्रांतर्मृत्युधर्मिणाम्॥ ११५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7004157115, "chapter_id": 24157, "verse_number": "५-१-६-११६", "content_sanskrit": "सुवर्णवज्रपर्यंकवेदिका च महीकृता ।\nविचित्रकुसुमारत्नैः कारिता सर्वशोभना॥ ११६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7004157116, "chapter_id": 24157, "verse_number": "५-१-६-११७", "content_sanskrit": "स्वर्णवज्रांकिततला श्रेष्ठा हरितशाद्वला ।\nत्रिंशच्चत्वारिंशपूर्णाः कलशाः कोणसंस्थिताः॥ ११७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7004157117, "chapter_id": 24157, "verse_number": "५-१-६-११८", "content_sanskrit": "द्वाराणि तत्र चत्वारि प्रवर्णानि तपंति च ।\nकुम्भाः शोभंति तत्रस्थाः उदिता भास्करा इव॥ ११८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7004157118, "chapter_id": 24157, "verse_number": "५-१-६-११९", "content_sanskrit": "रमते तत्र भगवान्वनानामुत्तमे वने ।\nसनंदिदेवगणपः कालदंडादिसंयुतः॥ ११९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7004157119, "chapter_id": 24157, "verse_number": "५-१-६-१२०", "content_sanskrit": "एतत्कृतयुगे सर्वं प्रत्यक्षं दृश्यते वने ।\nत्रेतायां धर्मनिरतास्तापसा ब्रह्मचारिणः॥ १२० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7004157120, "chapter_id": 24157, "verse_number": "५-१-६-१२१", "content_sanskrit": "द्वापरे धर्मशीला ये श्रुतवि ज्ञानशालिनः ।\nकलौ तु शुद्धविज्ञानशालिनः शंकरं हरम्॥ १२१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7004157121, "chapter_id": 24157, "verse_number": "५-१-६-१२२", "content_sanskrit": "तपोधिकाः प्रपश्यंति देवदेवं महेश्वरम् ।\nमहाकालवने नित्यं शूलपट्टिशधारिणम्॥ १२२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7004157122, "chapter_id": 24157, "verse_number": "५-१-६-१२३", "content_sanskrit": "एतत्ते तथ्यमाख्यातं लोकानुग्रहकारकम् ।\nसहितानुक्रमेणात्र मन्त्रैश्च विधिपूर्वकम्॥ १२३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7004157123, "chapter_id": 24157, "verse_number": "५-१-६-१२४", "content_sanskrit": "समर्चयंति ये विप्रा भक्त्या शंभुमहापदम्॥  ।\nवसंतीह समीपं ते महाकालानुभाविताः॥ १२४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7004157124, "chapter_id": 24157, "verse_number": "५-१-६-१२५", "content_sanskrit": "पठति य इह लोके तस्य संस्थानमेतत्प्रथितगुणगणौघैरर्चितं दोषहं तत् ।\nशुभमतिरभिषिक्तः सोऽमरैरर्च्यमानो व्रजति हरपुरं यः संशृणोत्येकचित्तः॥ १२५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}]