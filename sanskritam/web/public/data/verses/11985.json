[{"id": 50025147, "chapter_id": 11985, "verse_number": "1", "content_sanskrit": "॥ जीवाश्रितमिथ्योपाधेरव्यवस्थितत्वसमर्थनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50025148, "chapter_id": 11985, "verse_number": "2", "content_sanskrit": "इतश्च मिथ्योपाधिर्न युज्यते। अज्ञानसिद्धौ मिथ्योपाधिसिद्धिः, अज्ञानं विना मिथ्यात्वासिद्धेः। नच मिथ्योपाधिं विनाऽज्ञानसिद्धिः, मिथ्योपाधिभिन्नस्यैवाज्ञत्वात्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50025149, "chapter_id": 11985, "verse_number": "3", "content_sanskrit": "॥ अज्ञानस्य ब्रह्माश्रिततत्वनिराकरणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50025150, "chapter_id": 11985, "verse_number": "4", "content_sanskrit": "॥ मुक्तत्वव्याघातः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50025151, "chapter_id": 11985, "verse_number": "5", "content_sanskrit": "शुद्धस्यैवाज्ञत्वे मुक्तस्याप्यज्ञत्वप्रसक्तेः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50025152, "chapter_id": 11985, "verse_number": "6", "content_sanskrit": "॥ सद्वितीयत्वप्रसक्तिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50025153, "chapter_id": 11985, "verse_number": "7", "content_sanskrit": "स्वाभाविकत्वात् सत्यत्वात् सद्वितीयत्वप्रसक्तेश्च।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50025154, "chapter_id": 11985, "verse_number": "8", "content_sanskrit": "॥ ऐकात्म्योपदेशवैयर्थ्यम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50025155, "chapter_id": 11985, "verse_number": "9", "content_sanskrit": "स्वाभाविकस्य चानिवृत्त्यङ्गीकारादनिवृत्तिप्रसक्तेश्च। सत्यस्य चानिवृत्तिरिति हि तत्पक्षः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50025156, "chapter_id": 11985, "verse_number": "10", "content_sanskrit": "॥ अतोऽव्यवस्थितिदृढीकरणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50025157, "chapter_id": 11985, "verse_number": "11", "content_sanskrit": "अतश्चान्योन्याश्रयता। अज्ञानसिद्धौ मिथ्योपाधिसिद्धिः, मिथ्योपाधिसिद्धौ जीवसिद्धिः, जीवसिद्धौ तदाश्रयाज्ञानसिद्धिः - इति चक्रकं वा।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50025158, "chapter_id": 11985, "verse_number": "12", "content_sanskrit": "॥ ब्रह्माज्ञानपक्षेऽप्यव्यवस्थितिप्रतिपादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50025159, "chapter_id": 11985, "verse_number": "13", "content_sanskrit": "नच शुद्धमेव भ्रान्त्याऽज्ञमिति युक्तम्। अज्ञानसिद्धौ भ्रमसिद्धिः, तत्सिद्धावज्ञानसिद्धिः - इत्यन्योन्याश्रयत्वात्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}]