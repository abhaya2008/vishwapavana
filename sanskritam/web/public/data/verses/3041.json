[{"id": 2095656, "chapter_id": 3041, "verse_number": "१३-१७१-१", "content_sanskrit": "[*युधिष्ठिर उवाच।\nसर्वेषामुपवासानां यच्छ्रेयः सुमहत्फलम्।\nयच्चाप्यसंशयं लोके तन्मे त्वं वक्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2095657, "chapter_id": 3041, "verse_number": "१३-१७१-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2095658, "chapter_id": 3041, "verse_number": "१३-१७१-२", "content_sanskrit": "शृणु राजन्यथा गीतं स्वयमेव स्वयंभुवा।\nयत्कृत्वा निर्वृतो भूयात्पुरुषो नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2095659, "chapter_id": 3041, "verse_number": "१३-१७१-३", "content_sanskrit": "द्वादश्यां मार्गशीर्षे तु अहोरात्रेण केशवम्।\nअर्च्याश्वमेधं प्राप्नोति दुष्कृतं चास्य नश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2095660, "chapter_id": 3041, "verse_number": "१३-१७१-४", "content_sanskrit": "तथैव पौषमासे तु पूज्यो नारायणेति च।\nवाजपेयमवाप्नोति सिद्धिं च परमां व्रजेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2095661, "chapter_id": 3041, "verse_number": "१३-१७१-५", "content_sanskrit": "अहोरात्रेण द्वादश्यां माघमासे तु माघवम्।\nराजसूयमवाप्नोति कुलं चैव समुद्धरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2095662, "chapter_id": 3041, "verse_number": "१३-१७१-६", "content_sanskrit": "तथैव फाल्गुने मासि गोविन्देति च पूजयन्।\nअतिरात्रमवाप्नोति सोमलोकं च गच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2095663, "chapter_id": 3041, "verse_number": "१३-१७१-७", "content_sanskrit": "अहोरात्रेण द्वादश्यां चैत्रे विष्णुरिति स्मरन्।\nपौण्डरीकमवाप्नोति देवलोकं च गच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2095664, "chapter_id": 3041, "verse_number": "१३-१७१-८", "content_sanskrit": "वैशाखमासे द्वादश्यां पूजयन्मधुसूदनम्।\nअग्निष्टोममवाप्नोति सोमलोकं च गच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2095665, "chapter_id": 3041, "verse_number": "१३-१७१-९", "content_sanskrit": "अहोरात्रेण द्वादश्यां ज्येष्ठे मासि त्रिविक्रमम्।\nगवां मेधमवाप्नोति अप्सरोभिश्च मोदते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2095666, "chapter_id": 3041, "verse_number": "१३-१७१-१०", "content_sanskrit": "आषाढे मासि द्वादश्यां वामनेति च पूजयन्।\nनरमेधमवाप्नोति पुण्यं च लभते महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2095667, "chapter_id": 3041, "verse_number": "१३-१७१-११", "content_sanskrit": "अहोरात्रेण द्वादश्यां श्रावणे मासि श्रीधरम्।\nपञ्चयज्ञानवाप्नोति विमानस्थश्च मोदते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2095668, "chapter_id": 3041, "verse_number": "१३-१७१-१२", "content_sanskrit": "तथा भाद्रपदे मासि हृषीकेशेति पूजयन्।\nसौत्रामणिमवाप्नोति पूतात्मा भवते च हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2095669, "chapter_id": 3041, "verse_number": "१३-१७१-१३", "content_sanskrit": "द्वादश्यामाश्विने मासि पद्मनाभेति चार्चयन्।\nगोसहस्रफलं पुण्यं प्राप्नुयान्नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2095670, "chapter_id": 3041, "verse_number": "१३-१७१-१४", "content_sanskrit": "द्वादश्यां कार्तिके मासि पूज्यो दामोदरेति च।\nगवां यज्ञमवाप्नोति पुमान्स्त्री वा न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2095671, "chapter_id": 3041, "verse_number": "१३-१७१-१५", "content_sanskrit": "अर्चयेत्पुण्डरीकाक्षमेवं संवत्सरं तु यः।\nजातिस्मरत्वं प्राप्नोति विन्द्याद्बहु सुवर्णकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2095672, "chapter_id": 3041, "verse_number": "१३-१७१-१६", "content_sanskrit": "अहन्यहनि तद्भावमुपेन्द्रं योऽधिगच्छति।\nसमाप्ते भोजयेद्विप्रानथवा दापयेद्धृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2095673, "chapter_id": 3041, "verse_number": "१३-१७१-१७", "content_sanskrit": "अतः परं नोपवासो भवतीति विनिश्चयः॥\nउवाच भगवान्विष्णुः स्वयमेव पुरातनम्॥] ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2095674, "chapter_id": 3041, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि एकसप्तत्यधिकशततमोऽध्यायः॥ १७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]