[{"id": 7000797000, "chapter_id": 20797, "verse_number": "६-१४०-१", "content_sanskrit": "श्रीमहादेव उवाच ।\nभो देव्यन्यत्प्रवक्ष्यामि हिरण्यासंगमं महत् ।\nयदा साभ्रमती गंगा सप्तस्रोता पुराभवत्॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000797001, "chapter_id": 20797, "verse_number": "६-१४०-२", "content_sanskrit": "तदा सा ब्रह्मतनया सप्तस्रोतेति विश्रुता ।\nसप्तमं तद्धिरण्याख्यं स्रोत इत्यभिधीयते॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000797002, "chapter_id": 20797, "verse_number": "६-१४०-३", "content_sanskrit": "तस्मिंस्तीर्थे नरः स्नात्वा पापी गतिमवाप्नुयात् ।\nऋक्षुमंजुमयोर्मध्ये सत्यवान्नाम पर्वतः॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000797003, "chapter_id": 20797, "verse_number": "६-१४०-४", "content_sanskrit": "तस्य प्राक्सुमहत्तीर्थं हिरण्यासंगमं शुभम् ।\nतत्र स्नात्वा च पीत्वा च शुभां गतिमवाप्नुयात्॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000797004, "chapter_id": 20797, "verse_number": "६-१४०-५", "content_sanskrit": "वनस्थल्यां ततो गच्छेद्दृष्ट्वा नारायणं हरिम् ।\nतीर्थमप्सरसां पुण्यं हिरण्यासंगमेश्वरम्॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000797005, "chapter_id": 20797, "verse_number": "६-१४०-६", "content_sanskrit": "यत्रोर्वशी पुरा जाता समस्ताप्सरसां शुभा ।\nनरनारायणौ तत्र तपस्तेपतुरुत्तमम्॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000797006, "chapter_id": 20797, "verse_number": "६-१४०-७", "content_sanskrit": "हिरण्यासंगमे रम्ये महापापहरे शुभे ।\nयत्र वै ऋषयः सर्वे मज्जंति वीतकल्मषाः॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000797007, "chapter_id": 20797, "verse_number": "६-१४०-८", "content_sanskrit": "वसिष्ठाद्याश्च ये विप्रा वालखिल्यादयश्च ये ।\nयत्र मज्जंति देवेशि हिरण्या सह संगमे॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000797008, "chapter_id": 20797, "verse_number": "६-१४०-९", "content_sanskrit": "यत्र हिरण्मयं रूपं स्नानाद्वै भवति ध्रुवम् ।\nकपिलागोसहस्रस्य दानेनैव तु यत्फलम्॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000797009, "chapter_id": 20797, "verse_number": "६-१४०-१०", "content_sanskrit": "तत्फलं समवाप्नोति हिरण्यासंगमे सदा ।\nदशाश्वमेधे यत्पुण्यं ग्रहणे चंद्रसूर्ययोः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000797010, "chapter_id": 20797, "verse_number": "६-१४०-११", "content_sanskrit": "तदनंतगुणं प्रोक्तं हिरण्यासंगमे पुनः ।\nतुलापुरुषदाने च यत्फलं समवाप्नुयात्॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000797011, "chapter_id": 20797, "verse_number": "६-१४०-१२", "content_sanskrit": "तत्फलं समवाप्नोति हिरण्यासंगमे सदा ।\nहिरण्याक्षो महादैत्यस्तेन तप्तं महत्तपः॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000797012, "chapter_id": 20797, "verse_number": "६-१४०-१३", "content_sanskrit": "हिरण्यसदृशं तत्र शरीरमभवत्पुरा ।\nजनमेजये तथा राज्ञि यत्र स्नानं प्रकुर्वति॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000797013, "chapter_id": 20797, "verse_number": "६-१४०-१४", "content_sanskrit": "ब्रह्महत्या गता देवि हिरण्यासंगमे तदा ।\nविश्वामित्रोऽथ राजर्षिः स्नानार्थं वै समागतः॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000797014, "chapter_id": 20797, "verse_number": "६-१४०-१५", "content_sanskrit": "स्नानं कृत्वा विशेषेण गतोऽसौ मामकीं पुरीम्॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000797015, "chapter_id": 20797, "verse_number": "६-१४०-१६", "content_sanskrit": "ब्राह्मणाः क्षत्रिया वैश्याः शूद्राश्चाथ सुरेश्वरि ।\nस्नानं येऽत्र प्रकुर्वंति ते गच्छंति शिवालयम्॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]