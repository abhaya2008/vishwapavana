[{"id": 2105971, "chapter_id": 3295, "verse_number": "१६-२४-०", "content_sanskrit": "युधिष्ठिरेण वनस्थकुन्तीधृतराष्ट्रादिदिदृक्ष्या द्रौपद्यादिभिः पौरैर्भ्रातृभिश्च सह वनंप्रति प्रस्थानम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2105972, "chapter_id": 3295, "verse_number": "१६-२४-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2105973, "chapter_id": 3295, "verse_number": "१६-२४-१", "content_sanskrit": "एवं ते पुरुषव्याघ्राः पाण्डवा मातृनन्दनाः।\nस्मरन्तो मातरं वीरा बभूवुर्भशदुःखिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2105974, "chapter_id": 3295, "verse_number": "१६-२४-२", "content_sanskrit": "ये राजकार्येषु पुरा व्यासक्ता नित्यशोऽभवन्।\nते राजकार्याणि तदा नाकार्षुः सर्वतः पुरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2105975, "chapter_id": 3295, "verse_number": "१६-२४-३", "content_sanskrit": "प्रविष्टा इव शोकेन नाभ्यनन्दन्त किञ्चन।\nसम्भाष्यमाणा अपि ते न किञ्चित्प्रत्यपूजयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2105976, "chapter_id": 3295, "verse_number": "१६-२४-४", "content_sanskrit": "ते स्म वीरा दुराधर्षा गांभीर्ये सागरोपमाः।\nशोकोपहतविज्ञाना नष्टसंज्ञा इवाभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2105977, "chapter_id": 3295, "verse_number": "१६-२४-५", "content_sanskrit": "अचिन्तयंश्च जननीं ततस्ते पाण्डुनन्दनाः।\nकथं नु वृद्धमिथुनं वहत्यतिकृशा पृथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2105978, "chapter_id": 3295, "verse_number": "१६-२४-६", "content_sanskrit": "कथं च स महीपालो हतपुत्रो निराश्रयः।\nपत्न्या सह वसत्येको वने श्वापदसेविते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2105979, "chapter_id": 3295, "verse_number": "१६-२४-७", "content_sanskrit": "सा च देवी महाभागा गान्धारी हतबान्धवा।\nपतिमन्धं कथं वृद्धमन्वेति विजने वने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2105980, "chapter_id": 3295, "verse_number": "१६-२४-८", "content_sanskrit": "एवं तेषां कथयतामौत्सुक्यमभवत्तदा।\nगमने चाभवद्बुद्धिर्धृतराष्ट्रदिदृक्षया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2105981, "chapter_id": 3295, "verse_number": "१६-२४-९", "content_sanskrit": "सहदेवस्तु राजानं प्रणिपत्येदमब्रवीत्।\nअहो मे भवतो दृष्टं हृदयं गमनं प्रति।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2105982, "chapter_id": 3295, "verse_number": "१६-२४-१०", "content_sanskrit": "न हि त्वां गौरवेणाहमशकं वक्तुमञ्जसा।\nगमनं प्रति राजेन्द्र तदिदं समुपस्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2105983, "chapter_id": 3295, "verse_number": "१६-२४-११", "content_sanskrit": "दिष्ट्या द्रक्ष्यामि तां कुन्तीं वर्तयन्तीं तपस्विनीम्।\nजटिलां तापसीं वृद्धां कुशकाशपरिक्षताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2105984, "chapter_id": 3295, "verse_number": "१६-२४-१२", "content_sanskrit": "प्रासादहर्म्यसंवृद्धामत्यन्तसुखभागिनीम्।\nकदानुजननीं श्रान्तां द्रक्ष्यामि भृशदुःखिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2105985, "chapter_id": 3295, "verse_number": "१६-२४-१३", "content_sanskrit": "अनित्याः खलु मर्त्यानां गतयो भरतर्षभ।\nकुन्ती राजसुता यत्र वसत्यसुखिता वने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2105986, "chapter_id": 3295, "verse_number": "१६-२४-१४", "content_sanskrit": "सहदेववचः श्रुत्वा द्रौपदी योषितां वरा।\nउवाच देवी राजानमभिपूज्याभिनन्द्य च।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2105987, "chapter_id": 3295, "verse_number": "१६-२४-१५", "content_sanskrit": "कदा द्रक्ष्यामि तां देवीं यदि जीवति सा पृथा।\nजीवन्त्या ह्यद्य मे प्रीतिर्भविष्यति जनाधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2105988, "chapter_id": 3295, "verse_number": "१६-२४-१६", "content_sanskrit": "एषा तेऽस्तु मतिर्नित्यं धर्मे ते रमतां मनः।\nयोऽद्य त्वमस्मान्राजेन्द्र श्रेयसा योजयिष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2105989, "chapter_id": 3295, "verse_number": "१६-२४-१७", "content_sanskrit": "अग्रपादस्थितं चेमं विद्धि राजन्वधूजनम्।\nकाङ्क्षन्तं दर्शनं कुन्त्या गान्धार्याः श्वसुरस्च च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2105990, "chapter_id": 3295, "verse_number": "१६-२४-१८", "content_sanskrit": "इत्युक्तः स नृपो देव्या द्रौपद्या भरतर्षभ।\nसेनाध्यक्षान्समानाय्य सर्वानिदमुवाच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2105991, "chapter_id": 3295, "verse_number": "१६-२४-१९", "content_sanskrit": "निर्यातयत मे सेनां प्रभूतरथकुञ्जराम्।\nद्रक्ष्यामि वनसंस्थं च धृताष्ट्रं महीपतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2105992, "chapter_id": 3295, "verse_number": "१६-२४-२०", "content_sanskrit": "स्त्र्यध्यक्षांश्चाब्रवीद्राजा यानानि विविधानि मे।\nसज्जीक्रियन्तां सर्वाणि शिबिकाश्च सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2105993, "chapter_id": 3295, "verse_number": "१६-२४-२१", "content_sanskrit": "शकटापणवेशाश्च कोशः शिल्पिन एव च।\nनिर्यान्तु कोशपालाश्च कुरुक्षेत्राश्रमं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2105994, "chapter_id": 3295, "verse_number": "१६-२४-२२", "content_sanskrit": "यश्च पौरजनः कश्चिद्द्रष्टुमिच्छति पार्थिवम्।\nअनावृतः सुविहितः स च यातु सुरक्षितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2105995, "chapter_id": 3295, "verse_number": "१६-२४-२३", "content_sanskrit": "सूदाः पौरोगवाश्चैव सर्वं चैव महानसम्।\nविविधं भक्ष्यभोज्यं च शकटैरुह्यतां मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2105996, "chapter_id": 3295, "verse_number": "१६-२४-२४", "content_sanskrit": "प्रयाणं घुष्यतां चैव श्वोभूत इति माचिरम्।\nक्रियतां पथि चाप्यद्य वेश्मानि विविधानि च।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2105997, "chapter_id": 3295, "verse_number": "१६-२४-२५", "content_sanskrit": "एवमाज्ञाप्य राजा स भ्रातृभिः सह पाण्डवः।\nश्वोभूते निर्ययौ राजन्सस्त्रीवृद्धपुरःसरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2105998, "chapter_id": 3295, "verse_number": "१६-२४-२६", "content_sanskrit": "स बहिर्दिवसानेव जनौघं परिपालयन्।\nन्यवसन्नृपतिः पञ्च ततोऽगच्छद्वनं प्रति॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2105999, "chapter_id": 3295, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्रमवासिकपर्वणि आश्रमवासपर्वणि चतुर्विंशोऽध्यायः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]