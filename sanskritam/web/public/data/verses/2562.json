[{"id": 2073952, "chapter_id": 2562, "verse_number": "१२-६७-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2073953, "chapter_id": 2562, "verse_number": "१२-६७-१", "content_sanskrit": "किमाहुर्दैवतं विप्रा राजानं भरतर्षभ।\nमनुष्याणामधिपतिं तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2073954, "chapter_id": 2562, "verse_number": "१२-६७-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2073955, "chapter_id": 2562, "verse_number": "१२-६७-२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nबृहस्पतिं वसुमना यथा पप्रच्छ भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2073956, "chapter_id": 2562, "verse_number": "१२-६७-३", "content_sanskrit": "राजा वसुमना नाम कौसल्यो धीमतां वरः।\nमहर्षि किल पप्रच्छ कृतप्रज्ञं बृहस्पतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2073957, "chapter_id": 2562, "verse_number": "१२-६७-४", "content_sanskrit": "सर्वं वैनयिकं कृत्वा विनयज्ञो बृहस्पतिम्।\nदक्षिणानन्तरो भूत्वा प्रणम्य विधिपूर्वकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2073958, "chapter_id": 2562, "verse_number": "१२-६७-५", "content_sanskrit": "विधिं पप्रच्छ राजस्य सर्वलोकहिते रतः।\nप्रजानां सुखमन्विच्छन्धर्मशीलं बृहस्पतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2073959, "chapter_id": 2562, "verse_number": "१२-६७-६", "content_sanskrit": "केन भूतानि वर्धन्ते क्षयं गच्छन्ति केन वा।\nकमर्चन्तो महाप्राज्ञ सुखमव्ययमाप्नुयुः॥\n`एतन्मे शंस देवर्षे धर्मकामार्थसंशयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2073960, "chapter_id": 2562, "verse_number": "१२-६७-७", "content_sanskrit": "एवं पृष्टो महाप्राज्ञः कौसल्येनामितौजसा।\nराजसत्कारमव्यग्रो राज्यस्य च विवर्धनम्।\nदण्डनीतिं समाश्रित्य शशंसास्मै बृहस्पतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2073961, "chapter_id": 2562, "verse_number": "१२-६७-८", "content_sanskrit": "राजमूलो महाप्राज्ञ धर्मो लोकस्य लक्ष्यते।\nप्रजा राजभयादेव न खादन्ति परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2073962, "chapter_id": 2562, "verse_number": "१२-६७-९", "content_sanskrit": "राजा ह्येवाखिलं लोकं समुदीर्णं समुत्सुकम्।\nप्रसादयति धर्मेण प्रसाद्य च विराजते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2073963, "chapter_id": 2562, "verse_number": "१२-६७-१०", "content_sanskrit": "यथा ह्यनुदये राजन्भूतानि शशिसूर्ययोः।\nअन्धे तमसि मज्जेयुरपश्यन्तः परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2073964, "chapter_id": 2562, "verse_number": "१२-६७-११", "content_sanskrit": "यथा ह्यनुदके मत्स्या निराक्रन्दे विहङ्गमाः।\nविहरेयुर्यथाकामं विहिंसन्तः पुनः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2073965, "chapter_id": 2562, "verse_number": "१२-६७-१२", "content_sanskrit": "विमथ्यातिक्रमेरंश्च विषह्यापि परस्परम्।\nअभावमचिरेणैव गच्छेयुर्नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2073966, "chapter_id": 2562, "verse_number": "१२-६७-१३", "content_sanskrit": "एवमेव विना राज्ञा विनश्येयुरिमाः प्रजाः।\nअन्धे तमसि मज्जेयुरगोपाः पशवो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2073967, "chapter_id": 2562, "verse_number": "१२-६७-१४", "content_sanskrit": "हरेयुर्बलवन्तोऽपि दुर्बलानां परिग्रहान्।\nहन्युर्व्यायच्छमानांश्च यदि राजा न पालयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2073968, "chapter_id": 2562, "verse_number": "१२-६७-१५", "content_sanskrit": "ममेदमिति लोकेऽस्मिन्न भवेत्स्वपरिग्रहः।\nन दारा न च पुत्रः स्यान्न धनं न परिग्रहः।\nविष्वग्लोपः प्रवर्तेत यदि राजा न पालयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2073969, "chapter_id": 2562, "verse_number": "१२-६७-१६", "content_sanskrit": "यानं वस्त्रमलङ्कारान्रत्नानि विविधानि च।\nहरेयुः सहसा पापा यदि राजा न पालयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2073970, "chapter_id": 2562, "verse_number": "१२-६७-१७", "content_sanskrit": "पतेद्बहुविधं शस्त्रं बहुधा धर्मचारिषु।\nअधर्मः प्रगृहीतः स्याद्यदि राजा न पालयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2073971, "chapter_id": 2562, "verse_number": "१२-६७-१८", "content_sanskrit": "मातरं पितरं वृद्धमाचार्यमतिथिं गुरुम्।\nक्लिश्नीयुरपि हिंस्युर्वा यदि राजा न पालयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2073972, "chapter_id": 2562, "verse_number": "१२-६७-१९", "content_sanskrit": "`अन्यांश्च क्रोशतो हिंस्युर्लोकोऽयं दस्युवद्भवेत्।\nवधबन्धपरिक्लेशो नित्यमर्थवतां भवेत्।\nममत्वं च न विन्देयुर्यदि राजा न पालयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2073973, "chapter_id": 2562, "verse_number": "१२-६७-२०", "content_sanskrit": "अन्ताश्चाकाल एव स्युर्लोकोऽयं दस्युसाद्भवेत्।\nपतेद्बहुविधं राज्यं यदि राजा न पालयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2073974, "chapter_id": 2562, "verse_number": "१२-६७-२१", "content_sanskrit": "न योनिदोषो वर्तेत न कृषिर्न वणिक्पथः।\nमज्जेद्धर्मस्त्रयी न स्याद्यदि राजा न पालयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2073975, "chapter_id": 2562, "verse_number": "१२-६७-२२", "content_sanskrit": "न यज्ञाः संप्रवर्तेयुर्विधिवत्स्वाप्तदक्षिणाः।\nन विवाहाः समाजो वा यदि राजा न पालयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2073976, "chapter_id": 2562, "verse_number": "१२-६७-२३", "content_sanskrit": "न वृषाः संप्रवर्तेरन्न मथ्येरंश्च गर्गराः।\nघोषाः प्रणाशं गच्छेयुर्यदि राजा न पालयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2073977, "chapter_id": 2562, "verse_number": "१२-६७-२४", "content_sanskrit": "त्रस्तमुद्विग्नहृदयं हाहाभूतमचेतनम्।\nक्षणेन विनशेत्सर्वं यदि राजा न पालयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2073978, "chapter_id": 2562, "verse_number": "१२-६७-२५", "content_sanskrit": "न संवत्सरसत्राणि तिष्ठेयुरकुतोभयाः।\nविधिवद्दक्षिणावन्ति यदि राजा न पालयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2073979, "chapter_id": 2562, "verse_number": "१२-६७-२६", "content_sanskrit": "ब्राह्मणाश्चतुरो वेदान्नाधीयीरंस्तपस्विनः।\nविद्यास्नाता व्रतस्नाता यदि राजा न पालयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2073980, "chapter_id": 2562, "verse_number": "१२-६७-२७", "content_sanskrit": "न भवेद्धर्मसंसेवी मोहविप्रहतो जनः।\nहर्ता स्वच्छेन्द्रियो गच्छेद्यदि राजा न पालयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2073981, "chapter_id": 2562, "verse_number": "१२-६७-२८", "content_sanskrit": "हस्ताद्धस्तं परिमुषेद्भिद्येरन्सर्वसेतवः।\nभयार्तं विद्रवेत्सर्वं यदि राजा न पालयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2073982, "chapter_id": 2562, "verse_number": "१२-६७-२९", "content_sanskrit": "अनयाः संप्रवपर्तेरन्भवेद्वै वर्णसङ्करः।\nदुर्भिक्षमाविशेद्राष्ट्रं यदि राजा न पालयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2073983, "chapter_id": 2562, "verse_number": "१२-६७-३०", "content_sanskrit": "विवृत्य हि यथाकामं गृहद्वाराणि शेरते।\nमनुष्या रक्षिता राज्ञा समन्तादकुतोभयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2073984, "chapter_id": 2562, "verse_number": "१२-६७-३१", "content_sanskrit": "नाक्रुष्टं सहते कश्चित्कुतो वा हस्तलाघवम्।\nयदि राजा न सम्यग्गां रक्षयत्यपि धार्मिकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2073985, "chapter_id": 2562, "verse_number": "१२-६७-३२", "content_sanskrit": "स्त्रियश्चापुरुषा मार्गं सर्वालङ्कारभूषिताः।\nनिर्भयाः प्रतिपद्यन्ते यदि रक्षति भूमिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2073986, "chapter_id": 2562, "verse_number": "१२-६७-३३", "content_sanskrit": "धर्ममेव प्रपद्यन्ते न हिंसन्ति परस्परम्।\nअनुगृह्णन्ति चान्योन्यं यदा रक्षति भूमिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2073987, "chapter_id": 2562, "verse_number": "१२-६७-३४", "content_sanskrit": "यजन्ते च महायज्ञैस्त्रयो वर्णाः पृथग्विधैः।\nयुक्ताश्चाधीयते विद्यां यदा रक्षति भूमिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2073988, "chapter_id": 2562, "verse_number": "१२-६७-३५", "content_sanskrit": "वार्तामूलो ह्ययं लोकस्तया वै धार्यते सदा।\nतत्सर्वं वर्तते सम्यग्यदा रक्षति भूमिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2073989, "chapter_id": 2562, "verse_number": "१२-६७-३६", "content_sanskrit": "यदा राजा धुरं श्रेष्ठामादाय वहति प्रजाः।\nमहता बलयोगेन तदा लोकः प्रसीदयि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2073990, "chapter_id": 2562, "verse_number": "१२-६७-३७", "content_sanskrit": "यस्याभावेन भूतानामभावः स्यात्समन्ततः।\nभावे च भावो नित्यं स्यात्कस्तं न प्रतिपूजयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2073991, "chapter_id": 2562, "verse_number": "१२-६७-३८", "content_sanskrit": "तस्य यो वहते भारं सर्वलोकसुखावहम्।\nतिष्ठन्प्रियहिते राज्ञ उभौ लोकाविमौ जयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2073992, "chapter_id": 2562, "verse_number": "१२-६७-३९", "content_sanskrit": "यस्तस्य पुरुषः पापं मनसाऽप्यनुचिन्तयेत्।\nअसंशयमिह क्लिष्टः प्रेत्यापि नरकं व्रजेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2073993, "chapter_id": 2562, "verse_number": "१२-६७-४०", "content_sanskrit": "न हि जात्ववमन्तव्यो मनुष्य इति भूमिपः।\nमहती देवता ह्येषा नररूपेण तिष्ठति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2073994, "chapter_id": 2562, "verse_number": "१२-६७-४१", "content_sanskrit": "कुरुते पञ्चरूपाणि कालयुक्तानि यः सदा।\nभवत्यग्निस्तथाऽऽदित्यो मृत्युर्वैश्रवणो यमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2073995, "chapter_id": 2562, "verse_number": "१२-६७-४२", "content_sanskrit": "यदा ह्यासीदतः पापान्दहत्युग्रेण तेजसा।\nमिथ्योपचरितो राजा तदा भवति पावकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2073996, "chapter_id": 2562, "verse_number": "१२-६७-४३", "content_sanskrit": "यदा पश्यति चारेण सर्वभूतानि भूमिपः।\nक्षेमं च कृत्वा व्रजति तदा भवति भास्करः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2073997, "chapter_id": 2562, "verse_number": "१२-६७-४४", "content_sanskrit": "अशुचींश्च यदा क्रुद्धः क्षिणोति शतशो नरान्।\nसपुत्रपौत्रान्सामात्यांस्तदा भवति सोन्तकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2073998, "chapter_id": 2562, "verse_number": "१२-६७-४५", "content_sanskrit": "यदा त्वधार्मिकान्सर्वांस्तीक्ष्णैर्दण़्डैर्नियच्छति।\nधार्मिकांश्चानुगृह्णाति भवत्यथ यमस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2073999, "chapter_id": 2562, "verse_number": "१२-६७-४६", "content_sanskrit": "यदा तु धनधाराभिस्तर्पयत्युपकारिणः।\nआच्छिनत्ति च रत्नानि विविधान्यपकारिणां॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2074000, "chapter_id": 2562, "verse_number": "१२-६७-४७", "content_sanskrit": "श्रियं ददाति कस्मैचित्कस्माच्चिदपकर्षति।\nतदा वैश्रवणो राजा लोके भवति भूमिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2074001, "chapter_id": 2562, "verse_number": "१२-६७-४८", "content_sanskrit": "नास्यापवादे स्थातव्यं दक्षेणाक्लिष्टकर्मणा।\nधर्ममाकाङ्क्षता लोके ईश्वरस्यानसूयता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2074002, "chapter_id": 2562, "verse_number": "१२-६७-४९", "content_sanskrit": "न हि राज्ञः प्रतीपानि कुर्वन्सुखमवाप्नुयात्।\nपुत्रो भ्राता वयस्यो वा यद्यप्यात्मसमो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2074003, "chapter_id": 2562, "verse_number": "१२-६७-५०", "content_sanskrit": "कुर्यात्कृष्णगतिः शेषं ज्वलितोऽनिलसारथिः।\nन तु राज्ञाऽभिपन्नस्य शेषं क्वचन विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2074004, "chapter_id": 2562, "verse_number": "१२-६७-५१", "content_sanskrit": "तस्य सर्वाणि रक्ष्याणि दूरतः परिवर्जयेत्।\nमृत्योरिव जुगुप्सेत राजस्वहरणान्नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2074005, "chapter_id": 2562, "verse_number": "१२-६७-५२", "content_sanskrit": "वध्येतभिमृशन्सद्यो मृगः कूटमिव स्पृशन्।\nआत्मस्वमिव संरक्षेद्राजस्वमिह बुद्धिमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2074006, "chapter_id": 2562, "verse_number": "१२-६७-५३", "content_sanskrit": "महान्तं नरकं घोरमप्रतिष्ठमचेतसः।\nपतन्ति चिररात्राय राजवित्तापहारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2074007, "chapter_id": 2562, "verse_number": "१२-६७-५४", "content_sanskrit": "राजा भोजो विराट् सम्राट् क्षत्रियो भूपतिर्नृपः।\nय एभिः स्तूयते शब्दैः कस्तं नार्चितुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2074008, "chapter_id": 2562, "verse_number": "१२-६७-५५", "content_sanskrit": "तस्माद्बुभूषुर्नियतो जितात्मा संयतेन्द्रियः।\nमेधावी धृतिमान्दक्षः संश्रयेत् महीपतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2074009, "chapter_id": 2562, "verse_number": "१२-६७-५६", "content_sanskrit": "कृतज्ञं प्राज्ञमक्षुद्रं दृढभक्तिं जितेन्द्रियम्।\nधर्मनित्यं स्थितं स्थाने मन्त्रिणं पूजयेन्नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2074010, "chapter_id": 2562, "verse_number": "१२-६७-५७", "content_sanskrit": "दृढभक्तिं कृतप्रज्ञं धर्मज्ञं संयतेन्द्रियम्।\nशूरमक्षुद्रकर्माणं प्रसिद्धं जनमाश्रयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2074011, "chapter_id": 2562, "verse_number": "१२-६७-५८", "content_sanskrit": "राजा प्रगल्भं पुरुषं करोति\nराजा भृशं बृंहयते मनुष्यम्।\nराजाभिपन्नस्य कुतः सुखानि\nराजाऽभ्युपेतं सुखिनं करोति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2074012, "chapter_id": 2562, "verse_number": "१२-६७-५९", "content_sanskrit": "`राजा प्रजानां प्रथमं शरीरं\nप्रजाश्च राज्ञोऽप्रतिमं शरीरम्।\nराज्ञा विहीना न भवन्ति देशा\nदेशैर्विहीना न नृपा भवन्ति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2074013, "chapter_id": 2562, "verse_number": "१२-६७-६०", "content_sanskrit": "राजा प्रजानां हृदयं गरीयो\nगतिः प्रतिष्ठा सुखमुत्तमं च।\nसमाश्रिता लोकमिमं परं च\nजयन्ति सम्यक्पुरुषा नरेन्द्र॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2074014, "chapter_id": 2562, "verse_number": "१२-६७-६१", "content_sanskrit": "नराधिपश्चाप्यनुशिष्य मेदिनीं\nदमेन सत्येन च सौहृदेन।\nमहद्भिरिष्ट्वा क्रतुभिर्महायशा\nस्त्रिविष्टपे स्थानमुपैति शाश्वतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2074015, "chapter_id": 2562, "verse_number": "१२-६७-६२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2074016, "chapter_id": 2562, "verse_number": "१२-६७-६२", "content_sanskrit": "स एवमुक्तोऽङ्गिरसा कौसल्यो राजसत्तमः।\nप्रयत्नात्कृतवान्वीरः प्रजापालनमुत्तमम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2074017, "chapter_id": 2562, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि सप्तषष्टितमोऽध्यायः॥ ६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}]