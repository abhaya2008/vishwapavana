[{"id": 2119695, "chapter_id": 3571, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2119696, "chapter_id": 3571, "verse_number": "१", "content_sanskrit": "ऋषेस्तद्वचनं श्रुत्वा निशश्वास युधिष्ठिरः ।\nचिन्तयन् राजसूयाप्तिं न लेभे शर्म भारत\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2119697, "chapter_id": 3571, "verse_number": "२", "content_sanskrit": "राजर्षीणां च तं श्रुत्वा महिमानं महात्मनाम् ।\nयज्वनां कर्मभिः पुण्यैर्लोकप्राप्तिं समीक्ष्य च\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2119698, "chapter_id": 3571, "verse_number": "३", "content_sanskrit": "हरिश्चन्द्रं च राजर्षिं रोचमानं विशेषतः ।\nपार्थस्तं यज्ञमाहर्तुं राजसूयमियेष सः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2119699, "chapter_id": 3571, "verse_number": "४", "content_sanskrit": "युधिष्ठिरश्च तान् सर्वानर्चयित्वा सभासदः ।\nप्रत्यर्चितश्च तैः सर्वैर्यज्ञायैव मनो दधे\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2119700, "chapter_id": 3571, "verse_number": "५", "content_sanskrit": "स राजसूयं राजेन्द्रः कुरूणामृषभः क्रतुम् ।\nआहर्तुं प्रवणं चक्रे मनः सन्तत्य सोऽसकृत्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2119701, "chapter_id": 3571, "verse_number": "६", "content_sanskrit": "भूयश्चाद्भुतवीर्यौजा धर्ममेवानुपालयन् ।\nकिं हितं सर्वलोकानां भवेदिति मनो दधे\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2119702, "chapter_id": 3571, "verse_number": "७", "content_sanskrit": "अनुगृह्णन् प्रजाः सर्वाः सर्वधर्मविदां वरः ।\nअविशेषेण सर्वेषां हितं चक्रे युधिष्ठिरः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2119703, "chapter_id": 3571, "verse_number": "८", "content_sanskrit": "क्रियतां दीयतां देयं मुक्तकोपो बलान्वितः ।\nसाधुधर्मेति पार्थस्य नान्यच्छ्रूयेत भाषितम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2119704, "chapter_id": 3571, "verse_number": "९", "content_sanskrit": "एवंवृत्ते जगत् तस्मिन् पितरीवान्वरज्यत ।\nन तस्य विद्यते द्वेष्टा ततोऽस्याजातशत्रुता\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2119705, "chapter_id": 3571, "verse_number": "१०", "content_sanskrit": "परिग्रहान्नरेन्द्रस्य भीमस्य परिपालनात् ।\nशत्रूणां क्षपणाच्चैव बीभत्सोः सव्यसाचिनः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2119706, "chapter_id": 3571, "verse_number": "११", "content_sanskrit": "बलीनां सम्यगादानान्नकुलस्य यशस्विनः ।\nधीमतः सहदेवस्य धर्माणामनुशासनात्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2119707, "chapter_id": 3571, "verse_number": "१२", "content_sanskrit": "अविग्रहा वीतभयाः स्वधर्मनिरताः प्रजाः ।\nनिकामवर्षी पर्जन्यश्चासीज्जनपदे तदा\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2119708, "chapter_id": 3571, "verse_number": "१३", "content_sanskrit": "वार्धुषीर्यज्ञसन्तानो गोरक्षां कर्षणं वणिक् ।\nविशेषात् सर्ववर्णानां सञ्जज्ञे राजकर्मणि\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2119709, "chapter_id": 3571, "verse_number": "१४", "content_sanskrit": "अवर्षं चातिवर्षं च व्याधिपावकमूर्च्छनम् ।\nसर्वमेतत् तदा नासीद् धर्मनित्ये युधिष्ठिरे\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2119710, "chapter_id": 3571, "verse_number": "१५", "content_sanskrit": "दस्युतो राजतो वाऽपि परचक्रात् परस्परम् ।\nराजवल्लभतश्चैव नाश्रूयत क्लमः क्वचित्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2119711, "chapter_id": 3571, "verse_number": "१६", "content_sanskrit": "प्रियं कर्तुमुपस्थातुं बलिकर्म स्वकर्मजम् ।\nअभिहर्तुं नृपं जग्मुर्नान्यैः कार्यैः पृथग्जनाः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2119712, "chapter_id": 3571, "verse_number": "१७", "content_sanskrit": "धर्मैर्धनागमैस्तस्य ववृधे निचयो महान् ।\nकामतोऽप्युपयुञ्जन्त न क्षयैर्नामयैर्जनाः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2119713, "chapter_id": 3571, "verse_number": "१८", "content_sanskrit": "स मन्त्रिणः समानाय्य भ्रातॄंश्च वदतां वरः ।\nराजसूयं प्रति तदा पुनः पुनरपृच्छत\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2119714, "chapter_id": 3571, "verse_number": "१९", "content_sanskrit": "ते पृच्छ्यमानाः सहिता वचोऽर्थ्यं मन्त्रिणस्तदा ।\nयुधिष्ठिरं महाप्राज्ञं यियक्षुमिदमब्रुवन्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2119715, "chapter_id": 3571, "verse_number": "", "content_sanskrit": "मन्त्रिणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2119716, "chapter_id": 3571, "verse_number": "२०", "content_sanskrit": "सर्वव्यापी सर्वगुणः सर्वसाहश्च सर्वराट् ।\nयस्मिन्नधिकृतः सम्राड् यजमानो महायशाः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2119717, "chapter_id": 3571, "verse_number": "२१", "content_sanskrit": "अनूचाना दश दश पितृतो मातृतस्तथा ।\nअनुक्ता यं प्रतिष्ठन्ते सोमहस्ता द्विजातयः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2119718, "chapter_id": 3571, "verse_number": "२२", "content_sanskrit": "येनाभिषिक्तो नृपतिर्वारुणं गुणमृच्छति ।\nतेन राजा च सन् कृत्स्नं सम्राड् गुणमभीप्सते\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2119719, "chapter_id": 3571, "verse_number": "२३", "content_sanskrit": "तस्य सम्राड्गुणार्हस्य भवतः कुरुनन्दन ।\nराजसूयस्य समयं मन्यन्ते सुहृदस्तव ।\nतस्य यज्ञस्य समयः स्वाधीनः क्षत्रसम्पदा\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2119720, "chapter_id": 3571, "verse_number": "२४", "content_sanskrit": "नाम्ना षडग्नयो यस्मिन् चीयन्ते संशितव्रतैः ।\nदर्विहोमानुपादाय सर्वानाप्नोति यः क्रतून् ।\nमहाभिषेको यज्ञान्ते सर्ववित् तेन चोच्यते\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2119721, "chapter_id": 3571, "verse_number": "२५", "content_sanskrit": "समर्थोऽसि महाभाग सर्वे ते वशगा वयम् ।\nअविचार्य महाराज राजसूये मनः कुरु \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2119722, "chapter_id": 3571, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2119723, "chapter_id": 3571, "verse_number": "२६", "content_sanskrit": "इत्येवं सुहृदः सर्वे पृथक् च सह चाब्रुवन्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2119724, "chapter_id": 3571, "verse_number": "२७", "content_sanskrit": "स धर्म्यं पाण्डवस्तेषां वचः श्रुत्वा विशाम्पते१ ।\nधृष्टमिष्टं वरिष्ठं च जग्राह मनसाऽरिहा\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2119725, "chapter_id": 3571, "verse_number": "२८", "content_sanskrit": "श्रुत्वा सुहृद्वचः कल्यं जानंश्चैवात्मनः क्षमम् ।\nसम्प्रशस्तः क्रियारम्भे परीक्षामुपचक्रमे\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2119726, "chapter_id": 3571, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nसभापर्वणि त्रयोदशोऽध्यायः ॥१३॥ ॥ मन्त्रपर्वणि त्रयोदशोऽध्यायः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2119727, "chapter_id": 3571, "verse_number": "", "content_sanskrit": "—— ०  ——", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]