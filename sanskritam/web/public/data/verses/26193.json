[{"id": 7006193000, "chapter_id": 26193, "verse_number": "२-२१-१", "content_sanskrit": "समाप्तश्चायं श्राद्धकल्पः ।\nवसिष्ठ उवाच इत्थं प्रवर्त्तमानस्य जमदग्नेर्महात्मनः ।\nवर्षाणि कतिचिद्राजन्व्यतीयुरमितौजसः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006193001, "chapter_id": 26193, "verse_number": "२-२१-२", "content_sanskrit": "रामोऽपि नृपशार्दूल सर्वधर्मभृतां वरः ।\nवेदवेदाङ्गतत्त्वज्ञः सर्वशास्त्रविशारदः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006193002, "chapter_id": 26193, "verse_number": "२-२१-३", "content_sanskrit": "पित्रोश्चकार शुश्रूषां विनीतात्मा महामतिः ।\nप्रीतिं च निजचेष्टाभिरन्वहं पर्यवर्त्तयत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006193003, "chapter_id": 26193, "verse_number": "२-२१-४", "content_sanskrit": "इत्थं प्रवर्त्तमानस्य वर्षाणि कतिचिन्नृप ।\nपित्रोः शुश्रूषयानैषीद्रामो मतिमतां वरः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006193004, "chapter_id": 26193, "verse_number": "२-२१-५", "content_sanskrit": "स कदाचिन्महातेजाः पितामह गुहं प्रति ।\nगन्तुं व्यवसितो राजन्दैवेन च नियोजितः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006193005, "chapter_id": 26193, "verse_number": "२-२१-६", "content_sanskrit": "निपीड्य शिरसा पित्रोश्चरणौ भृगुपुङ्गवः ।\nउवाच प्राञ्जलिर्भूतवा सप्रश्रयमिदं वचः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006193006, "chapter_id": 26193, "verse_number": "२-२१-७", "content_sanskrit": "कञ्चिदर्थमहं तात मातरं त्वां च साम्प्रतम् ।\nविज्ञापयितुमिच्छामि मम तच्छ्रोतुमर्हथः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006193007, "chapter_id": 26193, "verse_number": "२-२१-८", "content_sanskrit": "पितामहमहं द्रष्टुमुत्कण्ठितमनाश्चिरम् ।\nतस्मात्तत्पार्श्वमधुना गमिष्ये वामनुज्ञया ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006193008, "chapter_id": 26193, "verse_number": "२-२१-९", "content_sanskrit": "आहूतश्चासकृत्तात सोत्कण्ठं प्रीयमाणया ।\nपितामह्या बहुमुखैरिच्छन्त्या मम दर्शनम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006193009, "chapter_id": 26193, "verse_number": "२-२१-१०", "content_sanskrit": "पितॄन्पितामहस्यापि प्रियमेव प्रदर्शनम् ।\nसदीयं तेन तत्पार्श्वं गन्तुं मामनुजानत ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006193010, "chapter_id": 26193, "verse_number": "२-२१-११", "content_sanskrit": "वसिष्ठ उवाच इति तस्य वचः श्रुत्वा संभ्रान्तं समुदीरितम् ।\nहर्षेण महता युक्तौ साश्रुनेत्रौ बभूवतुः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006193011, "chapter_id": 26193, "verse_number": "२-२१-१२", "content_sanskrit": "तमालिङ्ग्य महाभागं मूर्ध्न्युपाघ्राय सादरम् ।\nअभिनन्द्याशिषा तात ह्युभौ ताविदमाहतुः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006193012, "chapter_id": 26193, "verse_number": "२-२१-१३", "content_sanskrit": "पितामहगृहं तात प्रयाहि त्वं यथासुखम् ।\nपितामहपितामह्योः प्रीतये दर्शनाय च ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006193013, "chapter_id": 26193, "verse_number": "२-२१-१४", "content_sanskrit": "तत्र गत्वा यथान्यायं तं शुश्रूषा परायणः ।\nकञ्चित्कालं तयोर्वत्स प्रीतये वस तद्गृहे ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006193014, "chapter_id": 26193, "verse_number": "२-२१-१५", "content_sanskrit": "स्थित्वा नातिचिरं कालं तयोर्भूयोऽप्यनुशय ।\nअत्रागच्छ महाभाग क्षेमेणास्मद्दिदृक्षया ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006193015, "chapter_id": 26193, "verse_number": "२-२१-१६", "content_sanskrit": "क्षणार्द्धमपि शक्ताः स्थो न विना पुत्रदर्शनम् ।\nतस्मात्पितामह गृहे न चिरात्स्थातुमर्हसि ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006193016, "chapter_id": 26193, "verse_number": "२-२१-१७", "content_sanskrit": "तदाज्ञयाथ वा पुत्र प्रपितामहसन्निधिम् ।\nगतोऽपि शीघ्रमागच्छ क्रमेण तदनुज्ञया ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006193017, "chapter_id": 26193, "verse_number": "२-२१-१८", "content_sanskrit": "वसिष्ठ उवाच इत्युक्तस्तौ परिक्रम्य प्रणम्य च महामतिः ।\nपितरावप्यनुज्ञाप्य पितामहगृहं ततः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006193018, "chapter_id": 26193, "verse_number": "२-२१-१९", "content_sanskrit": "स गत्वा भृगुवर्यस्य ऋचीकस्य महात्मनः ।\nप्रविवेशाश्रमं रामो मुनिशिष्योपशोभितम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006193019, "chapter_id": 26193, "verse_number": "२-२१-२०", "content_sanskrit": "स्वाध्यायघोषैर्विपुलैः सर्वतः प्रतिनादितम् ।\nप्रशान्तवैर सत्त्वाढ्यं सर्वसत्त्वमनोहरम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006193020, "chapter_id": 26193, "verse_number": "२-२१-२१", "content_sanskrit": "स प्रविश्यश्रमं रम्यमृचीकं स्थितमासने ।\nददर्श रामो राजेन्द्र स पितामहमग्रतः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006193021, "chapter_id": 26193, "verse_number": "२-२१-२२", "content_sanskrit": "जाज्वल्यमानं तपसा धिष्ण्यस्थमिव पावकम् ।\nउपासितं सत्यवत्या यथा दक्षिणायऽध्वरम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006193022, "chapter_id": 26193, "verse_number": "२-२१-२३", "content_sanskrit": "स्वसमीपमुपायान्तं राममालोक्य तौ नृप ।\nसुचिरं तं विमर्शेतां समाज्ञापूर्वदर्शनौ ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006193023, "chapter_id": 26193, "verse_number": "२-२१-२४", "content_sanskrit": "कोऽयमेष तपोराशिः सर्वलत्रणपूजितः ।\nबालोऽयं बलवान्भातिगांभीर्यात्प्रश्रयेण च ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006193024, "chapter_id": 26193, "verse_number": "२-२१-२५", "content_sanskrit": "एवं तयोश्चिन्तयतोः सहर्षं हृदि कौतुकात् ।\nआससाद शनै रामः समीपे विनयान्वितः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006193025, "chapter_id": 26193, "verse_number": "२-२१-२६", "content_sanskrit": "स्वनामगोत्रे मतिमानुक्त्वा पित्रोर्मुदान्वितः ।\nसंस्पृशंश्चरणौ मूर्ध्ना हस्ताभ्यां चाभ्यवादयत् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006193026, "chapter_id": 26193, "verse_number": "२-२१-२७", "content_sanskrit": "ततस्तौ प्रीतमनसौ समुथाप्य च सत्तमम् ।\nआशीर्भिरभिनन्देतां पृथक्पृथगुभावपि ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006193027, "chapter_id": 26193, "verse_number": "२-२१-२८", "content_sanskrit": "तमाश्लिष्याङ्कमारोप्य हर्णाश्रुप्लुतलोचनौ ।\nवीक्षन्तौ तन्मुखांभोजं परं हर्षमवापतुः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006193028, "chapter_id": 26193, "verse_number": "२-२१-२९", "content_sanskrit": "ततः सुखोपविष्टं तमात्मवंशसमुद्वहम् ।\nअनामयमपृच्छेतां तावुभौ दंपती तदा ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006193029, "chapter_id": 26193, "verse_number": "२-२१-३०", "content_sanskrit": "पितरौ ते कुशलिनो वत्स किंभ्रातरस्तथा ।\nअनायासेन ते वृत्तिर्वर्तते चाथ कर्हिचित् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006193030, "chapter_id": 26193, "verse_number": "२-२१-३१", "content_sanskrit": "समस्ताभ्यां ततो राजन्नाचचक्षे यथोदितः ।\nतथा स्वानुगतं पित्रोर्भ्रातॄणां चैव चेष्टितम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006193031, "chapter_id": 26193, "verse_number": "२-२१-३२", "content_sanskrit": "एवं तयोर्महाराज सत्प्रीतिजनितैगुणैः ।\nप्रीयमाणोऽवसद्रामः पितुः पित्रोर्न्निवेशने ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006193032, "chapter_id": 26193, "verse_number": "२-२१-३३", "content_sanskrit": "स तस्मिन्सर्वभूतानां मनोनयननन्दनः ।\nउवास कतिचिन्मासांस्तच्छुश्रूषापरायणः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006193033, "chapter_id": 26193, "verse_number": "२-२१-३४", "content_sanskrit": "अथानुज्ञाप्य तौ राजन्भृगुवर्यो महामनाः ।\nपितामहगुरोर्गन्तुमियेषाश्रयमाश्रमम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006193034, "chapter_id": 26193, "verse_number": "२-२१-३५", "content_sanskrit": "स ताभ्यां प्रीतियुक्ताभ्यामाशीर्भिरभिनन्दितः ।\nयथा चाभ्यां प्रदिष्टेन यया वौर्वाश्रमं प्रति ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006193035, "chapter_id": 26193, "verse_number": "२-२१-३६", "content_sanskrit": "तं नमस्कृत्य विधिवच्च्यवनं च महातपाः ।\nसप्रहर्षं तदाज्ञातः प्रययावाश्रमं भृगोः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006193036, "chapter_id": 26193, "verse_number": "२-२१-३७", "content_sanskrit": "स गत्वामुनिमुख्यस्य भृगोराश्रममण्डलम् ।\nददर्श शान्तचेतोभिर्मुनिभिः सर्वतो वृतम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006193037, "chapter_id": 26193, "verse_number": "२-२१-३८", "content_sanskrit": "सुस्निग्धशीतलच्छायैः सर्वर्तुकगुणान्वितैः ।\nतरुभिः संवृतं प्रीतः फलपुष्पोत्तरान्वितैः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006193038, "chapter_id": 26193, "verse_number": "२-२१-३९", "content_sanskrit": "नानाखगकुलारावैर्मनःश्रोत्रसुखावहैः ।\nब्रह्मघोषैश्च विविधैः सर्वतः प्रतिनादितम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006193039, "chapter_id": 26193, "verse_number": "२-२१-४०", "content_sanskrit": "समन्त्राहुतिहोमोत्थधूमगन्धेन सर्वतः ।\nनिरस्तनिखिलाघौघं वनान्तरविसर्पिणा ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006193040, "chapter_id": 26193, "verse_number": "२-२१-४१", "content_sanskrit": "समित्कुशाहरैर्दण्डमेखलाजिनमण्डितैः ।\nअभितः शोभितं राजन्रम्यैर्मुनिकुमारकैः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006193041, "chapter_id": 26193, "verse_number": "२-२१-४२", "content_sanskrit": "प्रसूनजलसंपूर्मपात्रहस्ताभिरन्तरा ।\nशोभितं मुनिकल्याभिश्चरन्तीभिरितस्ततः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006193042, "chapter_id": 26193, "verse_number": "२-२१-४३", "content_sanskrit": "सपोतहरिणीयूथैर्विस्रंभादविशङ्किभिः ।\nउटजाङ्गणपर्यन्ततरुच्छायास्वधिष्ठितम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006193043, "chapter_id": 26193, "verse_number": "२-२१-४४", "content_sanskrit": "रोमन्थतः परामृष्टियूथ साक्षिकमुत्प्रदैः ।\nप्रारब्धताण्डवं केकीमयूरैर्मधुरस्वरैः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006193044, "chapter_id": 26193, "verse_number": "२-२१-४५", "content_sanskrit": "प्रविकीर्णकणोद्देशं मृगशब्दैः समीपगैः ।\nअनालीढातपच्छायाशुष्यन्नीवारराशिभिः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006193045, "chapter_id": 26193, "verse_number": "२-२१-४६", "content_sanskrit": "हूयमानानलं काले पूज्यमानातिथिव्रजम् ।\nअभ्यस्यमानच्छन्दौघं चिन्त्यमानगमोदितम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006193046, "chapter_id": 26193, "verse_number": "२-२१-४७", "content_sanskrit": "पठ्यमानाखिलस्मार्त्तं श्रौतार्थप्रविचारणम् ।\nप्रारब्धपितृदेवेज्यं सर्वभूतमनोहरम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006193047, "chapter_id": 26193, "verse_number": "२-२१-४८", "content_sanskrit": "तपस्विजनभूयिष्ठमाकापुरुषसेवितम् ।\nतपोवृद्धिकरं पुण्यं सर्वसत्त्वसुखास्पदम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006193048, "chapter_id": 26193, "verse_number": "२-२१-४९", "content_sanskrit": "तपोधनानन्दकरं ब्रह्मलोकमिवापरम् ।\nप्रसूनसौरभभ्राम्यन्मधुपारावनादितम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006193049, "chapter_id": 26193, "verse_number": "२-२१-५०", "content_sanskrit": "सर्वतो वीज्यमानेन विविधेन नभस्वता ।\nएवंविधगुणोपेतं पश्यन्नाश्रममुत्तमम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006193050, "chapter_id": 26193, "verse_number": "२-२१-५१", "content_sanskrit": "प्रविवेश विनीतात्मा सुकृतीवामरालयम् ।\nसंप्रविश्यश्रमोपान्तं रामः स्वप्रपितामहम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006193051, "chapter_id": 26193, "verse_number": "२-२१-५२", "content_sanskrit": "ददर्श परितो राजन्मुनिशिष्यशतावृतम् ।\nव्याख्यानवेदिकामध्ये निविष्टं कुशविष्टरे ।\nसितश्मश्रुजटाकूर्चब्रह्मसूत्रोपशोभितम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006193052, "chapter_id": 26193, "verse_number": "२-२१-५३", "content_sanskrit": "वामेतरोरुमध्यास्त वामजङ्घेन जानुना ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006193053, "chapter_id": 26193, "verse_number": "२-२१-५४", "content_sanskrit": "योगपट्टेन संवीतस्वदेहमृषिपुङ्गवम् ।\nव्याख्यानमुद्राविलसत्सव्यपाणितलांबुजम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006193054, "chapter_id": 26193, "verse_number": "२-२१-५५", "content_sanskrit": "योगपट्टोपरिन्यस्तविभ्राजद्वामपाणिकम् ।\nसम्यगारण्यवाक्यानां सूक्ष्मतत्त्वार्थसंहतिम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006193055, "chapter_id": 26193, "verse_number": "२-२१-५६", "content_sanskrit": "विवृत्य मुनिमुख्येभ्यः श्रावयन्तं तपोनिधिम् ।\nपितुः पितामहं द्दष्ट्वा रामस्तस्य महात्मनः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006193056, "chapter_id": 26193, "verse_number": "२-२१-५७", "content_sanskrit": "शनैरिवमहाराज समीपं समुपागमत् ।\nतमागतमुपालक्ष्य तत्प्रभावप्रधर्षिताः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006193057, "chapter_id": 26193, "verse_number": "२-२१-५८", "content_sanskrit": "शङ्कामवापुर्मुनयो दूरादेवाखिला नृप ।\nतावदूभृगुरमेयात्मा तदागमनतोषितः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006193058, "chapter_id": 26193, "verse_number": "२-२१-५९", "content_sanskrit": "निवृत्तान्यकथालापस्तं पश्यन्नास पार्थिव ।\nरामोऽपि तमुपागम्य विनयावनताननः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006193059, "chapter_id": 26193, "verse_number": "२-२१-६०", "content_sanskrit": "अवन्दत यथान्ययमुपेन्द्र इव वेधसम् ।\nअभिवाद्य यथान्यायं ख्यातिं च विनयान्वितः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006193060, "chapter_id": 26193, "verse_number": "२-२१-६१", "content_sanskrit": "तांश्च संभावयामास मुनीन्रामोयथावयः ।\nतैश्च सर्वैर्मुदोपेतैराशीर्भिरभिवर्द्धितः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006193061, "chapter_id": 26193, "verse_number": "२-२१-६२", "content_sanskrit": "उपाविवेश मेधावी भूमौ तेषामनुज्ञया ।\nउपविष्टं ततो राममाशीर्भिरभिनन्दितम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006193062, "chapter_id": 26193, "verse_number": "२-२१-६३", "content_sanskrit": "पप्रच्छकुशलप्रश्नं तमालोक्य भृगुस्तदा ।\nकुशलं खलु ते वत्स पित्रोश्च किमनामयम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006193063, "chapter_id": 26193, "verse_number": "२-२१-६४", "content_sanskrit": "भ्रातॄणां चैव भवतःपितुः पित्रोस्तथैव च ।\nकिमर्थमागतोऽत्र त्वमधुनामम सन्निधिम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006193064, "chapter_id": 26193, "verse_number": "२-२१-६५", "content_sanskrit": "केनापि वा त्वमादिष्टः स्वयमेवाथवागतः ।\nततोरामो यथान्यायं तस्मै सर्वमशेषतः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006193065, "chapter_id": 26193, "verse_number": "२-२१-६६", "content_sanskrit": "कथयामास यत्पृष्टं तदा तेन महात्मना ।\nपितुर्मातुश्च वृत्तान्त भ्रातॄणां च महात्मनाम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006193066, "chapter_id": 26193, "verse_number": "२-२१-६७", "content_sanskrit": "पितुः प्रित्रोश्चकौशल्य दर्शनं च तयोर्नृप ।\nएतदन्यच्च सकलं भृगोः सप्रश्रयं मुदा ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006193067, "chapter_id": 26193, "verse_number": "२-२१-६८", "content_sanskrit": "न्यवेदयद्यथान्यायमात्मनश्च समीहितम् ।\nश्रुत्वैतदखिलं राजन्रामेण समुदीरितम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006193068, "chapter_id": 26193, "verse_number": "२-२१-६९", "content_sanskrit": "तं च दृष्ट्वा विशेषेण भृगुः प्रीतोऽभ्यनन्दत ।\nएवं तस्य प्रियं कुर्वन्नुत्कृष्टैरात्मकर्मभिः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006193069, "chapter_id": 26193, "verse_number": "२-२१-७०", "content_sanskrit": "तत्राश्रमेऽवसद्रामो दिनानि कतिचिन्नृप ।\nततः कदाचिदेकान्ते रामं मुनिवरोत्तमः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006193070, "chapter_id": 26193, "verse_number": "२-२१-७१", "content_sanskrit": "वत्सागच्छेति तं राजन्नुपाह्वयदुपह्वरे ।\nसोऽभिगम्य तमासीनमभिवाद्य कृताञ्जलिः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006193071, "chapter_id": 26193, "verse_number": "२-२१-७२", "content_sanskrit": "तस्थौ तत्पुरतो रामः सुप्रीतेनान्तरात्मना ।\nआशीर्भिरभिनन्द्याथ भृगुस्तं प्रीत मानसः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006193072, "chapter_id": 26193, "verse_number": "२-२१-७३", "content_sanskrit": "प्राह नाधिगताशङ्कं राममालोक्य सादरम् ।\nश्रुणु वत्स वचो मह्य यत्त्वां वक्ष्यामि सांप्रतम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006193073, "chapter_id": 26193, "verse_number": "२-२१-७४", "content_sanskrit": "हितार्थं सर्वलोकानां तव चास्माकमेव च ।\nगच्छ पुत्र ममादेशाद्धिमवन्तं महागिरिम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006193074, "chapter_id": 26193, "verse_number": "२-२१-७५", "content_sanskrit": "अधुनैवाश्रमादस्मात्तपसे धृतमानसः ।\nतत्रगत्वा महाभाग कृत्वाश्रमापदं शुभम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006193075, "chapter_id": 26193, "verse_number": "२-२१-७६", "content_sanskrit": "आराधय महादेवं तपसा नियमेन च ।\nप्रीतिमुत्पाद्य तस्य त्वं भक्त्यानन्यगया चिरात् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7006193076, "chapter_id": 26193, "verse_number": "२-२१-७७", "content_sanskrit": "श्रेयो महदवाप्नोषि नात्र कार्या विजारणा ।\nतरसा तव भक्त्या च प्रीतो भवति शङ्करः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7006193077, "chapter_id": 26193, "verse_number": "२-२१-७८", "content_sanskrit": "करिष्यति च ते सर्वं मनसा यद्यदिच्छसि ।\nतुष्टे तस्मिञ्जगन्नाथे शङ्करे भक्तवत्सले ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7006193078, "chapter_id": 26193, "verse_number": "२-२१-७९", "content_sanskrit": "अस्त्रग्राममशेषं त्वं वणु पुत्र यथेप्सितम् ।\nत्वया हितार्थं देवानां करणीयं सुदुष्करम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7006193079, "chapter_id": 26193, "verse_number": "२-२१-८०", "content_sanskrit": "विद्यतेऽभ्यधिकं कर्म शस्त्रसाध्यमनेकशः ।\nतस्मात्त्वं देवदेवेशं समाराधय शङ्करम् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7006193080, "chapter_id": 26193, "verse_number": "२-२१-८१", "content_sanskrit": "भक्त्या परमया युक्तस्ततोऽभीष्टमवाप्स्यसि ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}]