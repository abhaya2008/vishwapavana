[{"id": 2096064, "chapter_id": 3051, "verse_number": "१३-१८१-१", "content_sanskrit": "भीष्म उवाच।\nक्षत्रधर्ममनुप्राप्तः स्मरन्नेव च वीर्यवान्।\nत्यक्त्वा हि कीटतां राजंश्चचार विपुलं तपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2096065, "chapter_id": 3051, "verse_number": "१३-१८१-२", "content_sanskrit": "तस्य धर्मार्थविदुषो दृष्ट्वा तद्विपुलं तपः।\nआजगाम द्विजश्रेष्ठः कृष्णद्वैपायनस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2096066, "chapter_id": 3051, "verse_number": "१३-१८१-३x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2096067, "chapter_id": 3051, "verse_number": "१३-१८१-३", "content_sanskrit": "क्षात्रादेव व्रतात्कीट भूतानां परिपालय।\nक्षात्रं देवव्रतं ध्यासंस्ततो विप्रत्वमेष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2096068, "chapter_id": 3051, "verse_number": "१३-१८१-४", "content_sanskrit": "पाहि सर्वाः प्रजाः सम्यक् शुभाशुभविदात्मवान्।\nशुभैः संविभजन्कामैरशुभानां च भावनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2096069, "chapter_id": 3051, "verse_number": "१३-१८१-५", "content_sanskrit": "आत्मवान्भव सुप्रीतः स्वधर्माचरणे रतः।\nक्षात्रीं तनुं समुत्सृज्य ततो विप्रत्वमेष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2096070, "chapter_id": 3051, "verse_number": "१३-१८१-६x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2096071, "chapter_id": 3051, "verse_number": "१३-१८१-६", "content_sanskrit": "सोऽप्यरण्यादभिप्रेत्य पुनरेव युधिष्ठिर।\nमहर्षेर्वचनं श्रुत्वा प्रजा धर्मेण पालयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2096072, "chapter_id": 3051, "verse_number": "१३-१८१-७", "content_sanskrit": "अचिरेणैव कालेन कीटः पार्थिवसत्तम।\nप्रजापालनधर्मेणि प्रेत्य विप्रत्वमागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2096073, "chapter_id": 3051, "verse_number": "१३-१८१-८", "content_sanskrit": "ततस्तं ब्राह्मणं द्रष्टुं पुनरेव महायशाः।\nआजगाम महाप्राज्ञः कृष्णद्वैपायनस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2096074, "chapter_id": 3051, "verse_number": "१३-१८१-९x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2096075, "chapter_id": 3051, "verse_number": "१३-१८१-९", "content_sanskrit": "भोभो ब्रह्मर्षभ श्रीमन्मा व्यथिष्ठाः कथञ्चन।\nशुभकृच्छुभयोनीषु पापकृत्पापयोनिषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2096076, "chapter_id": 3051, "verse_number": "१३-१८१-१०", "content_sanskrit": "उपपद्यति धर्मज्ञ यथाधर्मं यथाव्रतम्।\nतस्मान्मृत्युभयात्कीट मा व्यथिष्ठाः कथञ्चन।\nधर्मलाभात्परं न स्यात्तस्माद्धर्मं चरोत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2096077, "chapter_id": 3051, "verse_number": "१३-१८१-११x", "content_sanskrit": "कीट उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2096078, "chapter_id": 3051, "verse_number": "१३-१८१-११", "content_sanskrit": "सुखात्सुखतरं प्राप्तो भगवंस्त्वत्कृते ह्यहम्।\nधर्ममूलं शुभं प्राप्य पाप्मा नष्ट इहाद्य मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2096079, "chapter_id": 3051, "verse_number": "१३-१८१-१२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2096080, "chapter_id": 3051, "verse_number": "१३-१८१-१२", "content_sanskrit": "भगवद्वचनात्कीटो ब्राह्मण्यं प्राप्य दुर्लभम्।\nअकरोत्पृथिवीं राजन्यज्ञयूपशताङ्किताम्।\nततः सालोक्यमगमद्ब्रह्मणो ब्रह्मवित्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2096081, "chapter_id": 3051, "verse_number": "१३-१८१-१३", "content_sanskrit": "अथ पापहरं कीटः पार्त ब्रह्म सनातनम्।\nस्वकर्मफलनिर्वृत्तं व्यासस्य वचनात्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2096082, "chapter_id": 3051, "verse_number": "१३-१८१-१४", "content_sanskrit": "कुरुक्षेत्रे युद्धहताः पुण्ये क्षत्रियपुङ्गवाः।\nसम्प्राप्तास्ते गतिं पुण्यां तन्मा त्वं शोच पुत्रक॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2096083, "chapter_id": 3051, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि एकाशीत्यधिकशततमोऽध्यायः॥ १८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]