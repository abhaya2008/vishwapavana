[{"id": 7006437000, "chapter_id": 26437, "verse_number": "२-९७-१", "content_sanskrit": "वैशम्पायन उवाच\nजगतश्चक्षुषि ततो मुहूर्ताभ्युदिते रवौ ।\nप्रादुरासीद्धरिर्देवस्तार्क्ष्येणोरगशत्रुणा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006437001, "chapter_id": 26437, "verse_number": "२-९७-२", "content_sanskrit": "हंसत्रायुमनोभिश्च सुशीघ्रतरगः खगः ।\nतस्थौ वियति शक्रस्य समीपे कुरुनन्दन ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006437002, "chapter_id": 26437, "verse_number": "२-९७-३", "content_sanskrit": "समेत्य च यथान्यायं कृष्णो वासवसंनिधौ ।\nपाञ्चजन्यं हरिर्दध्मौ दैत्यानां भयवर्द्धनम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006437003, "chapter_id": 26437, "verse_number": "२-९७-४", "content_sanskrit": "तं श्रुत्वाभ्यागतस्तत्र प्रद्युम्नो परवीरहा ।\nवज्रनाभं जहीत्युक्तः केशवेन त्वरेति च ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006437004, "chapter_id": 26437, "verse_number": "२-९७-५", "content_sanskrit": "तार्क्ष्यमारुह्य गच्छेति पुनरेव प्रणोदितः ।\nचकार स तथा वीरः प्रणिपत्य सुरोत्तमौ ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006437005, "chapter_id": 26437, "verse_number": "२-९७-६", "content_sanskrit": "स मनोरंहसा वीर तार्क्ष्येणाशु ययौ नृप ।\nअभ्याशं वज्रनाभस्य महाद्वन्द्वस्य भारत ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006437006, "chapter_id": 26437, "verse_number": "२-९७-७", "content_sanskrit": "ततस्तार्क्ष्यगतो वीरस्ततर्द राणमूर्द्धनि ।\nवज्रनाभं स्थिरो भूत्वा सर्वास्त्रविदनिन्दितः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006437007, "chapter_id": 26437, "verse_number": "२-९७-८", "content_sanskrit": "तेन तार्क्ष्यगतेनैव गदया कृष्णसूनुना ।\nउरस्यभ्याहतो वीरो वज्रनाभो महात्मना ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006437008, "chapter_id": 26437, "verse_number": "२-९७-९", "content_sanskrit": "स तेनाभिहतो वीरो दैत्यो मोहवशं गतः ।\nचक्षार च भृशं रक्तं बभ्रामैव गतासुवत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006437009, "chapter_id": 26437, "verse_number": "२-९७-१०", "content_sanskrit": "आश्वसेत्यथ तं कार्ष्णिरुवाच रणदुर्जयः ।\nलब्धसंज्ञः स वीरस्तु प्रद्युम्नमिदमब्रवीत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006437010, "chapter_id": 26437, "verse_number": "२-९७-११", "content_sanskrit": "साधु यादव वीर्येण श्लाघ्यो मम रिपुर्भवान् ।\nप्रतिप्रहारकालोऽयं स्थिरो भव महाबल ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006437011, "chapter_id": 26437, "verse_number": "२-९७-१२", "content_sanskrit": "एवमुक्त्वा महानादं मुक्त्वा मेघशतोपमम् ।\nगदां मुमोच वेगेन सघण्टां बहुकण्टकाम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006437012, "chapter_id": 26437, "verse_number": "२-९७-१३", "content_sanskrit": "तया ललाटेऽभिहतः प्रद्युम्नो गदया नृप ।\nउद्वमन् रुधिरं भूरि मुमोह यदुनन्दनः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006437013, "chapter_id": 26437, "verse_number": "२-९७-१४", "content_sanskrit": "तं दृष्ट्वा भगवान् कृष्णः पाञ्चजन्यं जलोद्भवम् ।\nदध्मावाश्वासनकरं पुत्रस्य रिपुनाशनः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006437014, "chapter_id": 26437, "verse_number": "२-९७-१५", "content_sanskrit": "तं पाञ्चजन्यशब्देन प्रत्याश्वस्तं महाबलम् ।\nदृष्ट्वा प्रमुदिता लोका विशेषेणेन्द्रकेशवौ ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006437015, "chapter_id": 26437, "verse_number": "२-९७-१६", "content_sanskrit": "तस्य चक्रं करे यातं कृष्णच्छन्देन भारत ।\nक्षुरनेमिसहस्रारं दैत्यसंघकुलान्तकम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006437016, "chapter_id": 26437, "verse_number": "२-९७-१७", "content_sanskrit": "तन्मुमोचाच्युतसुतस्तस्य नाशाय भारत ।\nनमस्कृत्वा सुरेन्द्राय कृष्णाय च महात्मने ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006437017, "chapter_id": 26437, "verse_number": "२-९७-१८", "content_sanskrit": "वज्रनाभस्य तत्कायादुच्चकर्त शिरस्तदा ।\nनारायणसुतोन्मुक्तं दैत्यानामनुपश्यताम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006437018, "chapter_id": 26437, "verse_number": "२-९७-१९", "content_sanskrit": "गदः सुनाभमवधीद् यतमान रणाजिरे ।\nहर्म्यपृष्ठे जिघांसन्तं रणदृप्तं भयानकम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006437019, "chapter_id": 26437, "verse_number": "२-९७-२०", "content_sanskrit": "साम्बः समरमध्यस्थानसुरानरिमर्दनः ।\nनिनाय निशितैर्बाणैः प्रेताधिपपरिग्रहम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006437020, "chapter_id": 26437, "verse_number": "२-९७-२१", "content_sanskrit": "निकुम्भोऽपि हते वीरे वज्रनाभे महासुरे ।\nजगाम षट्पुरं वीरो नारायणभयार्दितः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006437021, "chapter_id": 26437, "verse_number": "२-९७-२२", "content_sanskrit": "निबर्हिते देवरिपौ वज्रनाभे महासुरे ।\nअवतीर्णौ महात्मानौ हरी वज्रपुरं तदा ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006437022, "chapter_id": 26437, "verse_number": "२-९७-२३", "content_sanskrit": "लब्धप्रशमनं चैव चक्रतुः सुरसत्तमौ ।\nसान्त्वयामासतुश्चैव बालवृद्धं भयार्दितम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006437023, "chapter_id": 26437, "verse_number": "२-९७-२४", "content_sanskrit": "इन्द्रोपेन्द्रौ महात्मानौ मन्त्रयित्वा महाबलौ ।\nआयत्यां च तदात्वे च नृहस्पतिमतानुगौ ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006437024, "chapter_id": 26437, "verse_number": "२-९७-२५", "content_sanskrit": "वज्रनाभस्य तद् राज्यं चतुर्धा चक्रतुर्नृप ।\nविजयस्य चतुर्भागं जयन्ततनयस्य वै ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006437025, "chapter_id": 26437, "verse_number": "२-९७-२६", "content_sanskrit": "प्रद्युम्नस्य चतुर्भागं रौक्मिणेयसुतस्य च ।\nचन्द्रप्रभस्य ददतुश्चतुर्भागं जनेश्वर ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006437026, "chapter_id": 26437, "verse_number": "२-९७-२७", "content_sanskrit": "कोट्यश्चतस्रो ग्रामाणामधिकास्ता विशाम्पते ।\nशाखापुरसहस्रं च स्फीतं वज्रपुरोपमम् ।\nचतुर्धा चक्रतुस्तत्र संहृष्टौ शक्रकेशवौ ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006437027, "chapter_id": 26437, "verse_number": "२-९७-२८", "content_sanskrit": "कम्बलाजिनवासांसि रत्नानि विविधानि च ।\nचतुर्द्धा चक्रतुर्वीरौ वीर वासवकेशवौ ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006437028, "chapter_id": 26437, "verse_number": "२-९७-२९", "content_sanskrit": "ततोऽभिषिक्तास्ते वीरा राजानो वासवाज्ञया ।\nदेवदुन्दुभिवाद्येन नृप विष्णुपदीजलैः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006437029, "chapter_id": 26437, "verse_number": "२-९७-३०", "content_sanskrit": "स्वयं शक्रेण देवेन केशवेन च धीमता ।\nऋषिवंशे महात्मानः शक्रमाधवनन्दनाः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006437030, "chapter_id": 26437, "verse_number": "२-९७-३१", "content_sanskrit": "विजयस्य प्रसिद्धेव गतिर्वियति धीमतः ।\nमातृजेन गुणेनापि माधवानां महात्मनाम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006437031, "chapter_id": 26437, "verse_number": "२-९७-३२", "content_sanskrit": "अभिषिच्य जयन्तं तु वासवो भगवान् ब्रवीत् ।\nत्वयैते वीर संरक्ष्या राजानः समितिंजयाः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006437032, "chapter_id": 26437, "verse_number": "२-९७-३३", "content_sanskrit": "मम वंशकरोऽत्रैकः केशवस्य त्रयोऽनघ ।\nअवध्याः सर्वभूतानां भविष्यन्ति ममाज्ञया ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006437033, "chapter_id": 26437, "verse_number": "२-९७-३४", "content_sanskrit": "गमनागमनं चैव दिवि सिद्धं भविष्यति ।\nत्रिविष्टपं द्वारकां च रम्यां भैमाभिरक्षिताम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006437034, "chapter_id": 26437, "verse_number": "२-९७-३५", "content_sanskrit": "दिशागजसुतान् नागान् हयांश्चोच्चैःश्रवोऽन्वयान् ।\nइच्छयैषां प्रयच्छस्व रथांस्त्वष्टृकृतानपि ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006437035, "chapter_id": 26437, "verse_number": "२-९७-३६", "content_sanskrit": "गजावैरावणसुतौ शत्रुञ्जयरिपुञ्जयौ ।\nप्रयच्छाकाशगौ वीर साम्बस्य च गदस्य च ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006437036, "chapter_id": 26437, "verse_number": "२-९७-३७", "content_sanskrit": "आकाशेन पुरीं यातु द्वारकां भैमरक्षिताम् ।\nआयातु च सुतौ द्रष्टुं यथेष्टं भैमनन्दनौ ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006437037, "chapter_id": 26437, "verse_number": "२-९७-३८", "content_sanskrit": "इति संदिश्य भगवान् देवराजः पुरन्दरः ।\nजगाम भगवान् स्वर्गं द्वारकामपि केशवः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006437038, "chapter_id": 26437, "verse_number": "२-९७-३९", "content_sanskrit": "षण्मासानुषितस्तत्र गदः प्रद्युम्न एव च ।\nसाम्बश्च द्वारकां याता रूढे राज्ये महाबलाः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006437039, "chapter_id": 26437, "verse_number": "२-९७-४०", "content_sanskrit": "अद्यापि तानि राज्यानि मेरोः पार्श्वे तथोत्तरे ।\nतिष्ठन्ति च जगद् यावत् स्थास्यन्त्यमरसंनिभ ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006437040, "chapter_id": 26437, "verse_number": "२-९७-४१", "content_sanskrit": "निवृत्ते मौसले युद्धे स्वर्गं यातेषु वृष्णिषु ।\nगदप्रद्युम्नसाम्बास्ते गता वज्रपुरं विभो ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006437041, "chapter_id": 26437, "verse_number": "२-९७-४२", "content_sanskrit": "ततः प्रोष्य पुनर्यान्ति स्वर्ग स्वैः कर्मभिः शुभैः ।\nप्रसादेन च कृष्णस्य लोककर्तुर्जनेश्वर ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006437042, "chapter_id": 26437, "verse_number": "२-९७-४३", "content_sanskrit": "प्रद्युम्नोत्तरमेतत् ते नृदेव कथितं मया ।\nधन्यं यशस्यमायुष्यं शत्रुनाशनमेव च ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006437043, "chapter_id": 26437, "verse_number": "२-९७-४४", "content_sanskrit": "पुत्रपौत्रा विवर्धन्ते आरोग्यधनसम्पदः ।\nयशो विपुलमाप्नोति द्वैपायनवचो यथा ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]