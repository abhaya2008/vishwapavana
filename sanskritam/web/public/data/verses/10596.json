[{"id": 50002495, "chapter_id": 10596, "verse_number": "1", "content_sanskrit": "॥ ईश्वरान्तःकरणजीवावरकतया ज्ञानोत्पत्तिप्रतिबन्धकत्वम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50002496, "chapter_id": 10596, "verse_number": "2", "content_sanskrit": "धूमेनाव्रियते वह्निर्यथाऽऽदर्शो मलेन च। यथोल्बेनावृतो गर्भस्तथा तेनेदमावृतम्॥ ३/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50002497, "chapter_id": 10596, "verse_number": "3", "content_sanskrit": "॥ उत्पन्नज्ञानप्रतिबन्धकत्वम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50002498, "chapter_id": 10596, "verse_number": "4", "content_sanskrit": "आवृतं ज्ञानमेतेन ज्ञानिनो नित्यवैरिणा। कामरूपेण कौन्तेय दुष्पूरेणानलेन च॥ ३/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}]