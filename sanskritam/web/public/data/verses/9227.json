[{"id": 5000227000, "chapter_id": 9227, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे एकत्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000227001, "chapter_id": 9227, "verse_number": "३-३१-१", "content_sanskrit": "त्वरमाणस्ततो गत्वा जनस्थानादकम्पनः।\nप्रविश्य लङ्कां वेगेन रावणं वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000227002, "chapter_id": 9227, "verse_number": "३-३१-२", "content_sanskrit": "जनस्थानस्थिता राजन् राक्षसा बहवो हताः।\nखरश्च निहतः संख्ये कथंचिदहमागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000227003, "chapter_id": 9227, "verse_number": "३-३१-३", "content_sanskrit": "एवमुक्तो दशग्रीवः क्रुद्धः संरक्तलोचनः।\nअकम्पनमुवाचेदं निर्दहन्निव तेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000227004, "chapter_id": 9227, "verse_number": "३-३१-४", "content_sanskrit": "केन भीमं जनस्थानं हतं मम परासुना।\nको हि सर्वेषु लोकेषु गतिं नाधिगमिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000227005, "chapter_id": 9227, "verse_number": "३-३१-५", "content_sanskrit": "न हि मे विप्रियं कृत्वा शक्यं मघवता सुखम्।\nप्राप्तुं वैश्रवणेनापि न यमेन च विष्णुना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000227006, "chapter_id": 9227, "verse_number": "३-३१-६", "content_sanskrit": "कालस्य चाप्यहं कालो दहेयमपि पावकम्।\nमृत्युं मरणधर्मेण संयोजयितुमुत्सहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000227007, "chapter_id": 9227, "verse_number": "३-३१-७", "content_sanskrit": "वातस्य तरसा वेगं निहन्तुमपि चोत्सहे।\nदहेयमपि संक्रुद्धस्तेजसाऽऽदित्यपावकौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000227008, "chapter_id": 9227, "verse_number": "३-३१-८", "content_sanskrit": "तथा क्रुद्धं दशग्रीवं कृताञ्जलिरकम्पनः।\nभयात् संदिग्धया वाचा रावणं याचतेऽभयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000227009, "chapter_id": 9227, "verse_number": "३-३१-९", "content_sanskrit": "दशग्रीवोऽभयं तस्मै प्रददौ रक्षसां वरः।\nस विस्रब्धोऽब्रवीद् वाक्यमसंदिग्धमकम्पनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000227010, "chapter_id": 9227, "verse_number": "३-३१-१०", "content_sanskrit": "पुत्रो दशरथस्यास्ते सिंहसंहननो युवा।\nरामो नाम महास्कन्धो वृत्तायतमहाभुजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000227011, "chapter_id": 9227, "verse_number": "३-३१-११", "content_sanskrit": "श्यामः पृथुयशाः श्रीमानतुल्यबलविक्रमः।\nहतस्तेन जनस्थाने खरश्च सहदूषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000227012, "chapter_id": 9227, "verse_number": "३-३१-१२", "content_sanskrit": "अकम्पनवचः श्रुत्वा रावणो राक्षसाधिपः।\nनागेन्द्र इव निःश्वस्य इदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000227013, "chapter_id": 9227, "verse_number": "३-३१-१३", "content_sanskrit": "स सुरेन्द्रेण संयुक्तो रामः सर्वामरैः सह।\nउपयातो जनस्थानं ब्रूहि कच्चिदकम्पन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000227014, "chapter_id": 9227, "verse_number": "३-३१-१४", "content_sanskrit": "रावणस्य पुनर्वाक्यं निशम्य तदकम्पनः।\nआचचक्षे बलं तस्य विक्रमं च महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000227015, "chapter_id": 9227, "verse_number": "३-३१-१५", "content_sanskrit": "रामो नाम महातेजाः श्रेष्ठः सर्वधनुष्मताम्।\nदिव्यास्त्रगुणसम्पन्नः परं धर्मं गतो युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000227016, "chapter_id": 9227, "verse_number": "३-३१-१६", "content_sanskrit": "तस्यानुरूपो बलवान् रक्ताक्षो दुन्दुभिस्वनः।\nकनीयाँल्लक्ष्मणो भ्राता राकाशशिनिभाननः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000227017, "chapter_id": 9227, "verse_number": "३-३१-१७", "content_sanskrit": "स तेन सह संयुक्तः पावकेनानिलो यथा।\nश्रीमान् राजवरस्तेन जनस्थानं निपातितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000227018, "chapter_id": 9227, "verse_number": "३-३१-१८", "content_sanskrit": "नैव देवा महात्मानो नात्र कार्या विचारणा।\nशरा रामेण तूत्सृष्टा रुक्मपुङ्खाः पतत्त्रिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000227019, "chapter_id": 9227, "verse_number": "३-३१-१९", "content_sanskrit": "सर्पाः पञ्चानना भूत्वा भक्षयन्ति स्म राक्षसान्।\nयेन येन च गच्छन्ति राक्षसा भयकर्षिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000227020, "chapter_id": 9227, "verse_number": "३-३१-२०", "content_sanskrit": "तेन तेन स्म पश्यन्ति राममेवाग्रतः स्थितम्।\nइत्थं विनाशितं तेन जनस्थानं तवानघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000227021, "chapter_id": 9227, "verse_number": "३-३१-२१", "content_sanskrit": "अकम्पनवचः श्रुत्वा रावणो वाक्यमब्रवीत्।\nगमिष्यामि जनस्थानं रामं हन्तुं सलक्ष्मणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000227022, "chapter_id": 9227, "verse_number": "३-३१-२२", "content_sanskrit": "अथैवमुक्ते वचने प्रोवाचेदमकम्पनः।\nशृणु राजन् यथावृत्तं रामस्य बलपौरुषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000227023, "chapter_id": 9227, "verse_number": "३-३१-२३", "content_sanskrit": "असाध्यः कुपितो रामो विक्रमेण महायशाः।\nआपगायास्तु पूर्णाया वेगं परिहरेच्छरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000227024, "chapter_id": 9227, "verse_number": "३-३१-२४", "content_sanskrit": "सताराग्रहनक्षत्रं नभश्चाप्यवसादयेत्।\nअसौ रामस्तु सीदन्तीं श्रीमानभ्युद्धरेन्महीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000227025, "chapter_id": 9227, "verse_number": "३-३१-२५", "content_sanskrit": "भित्त्वा वेलां समुद्रस्य लोकानाप्लावयेद् विभुः।\nवेगं वापि समुद्रस्य वायुं वा विधमेच्छरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000227026, "chapter_id": 9227, "verse_number": "३-३१-२६", "content_sanskrit": "संहृत्य वा पुनर्लोकान् विक्रमेण महायशाः।\nशक्तः श्रेष्ठः स पुरुषः स्रष्टुं पुनरपि प्रजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000227027, "chapter_id": 9227, "verse_number": "३-३१-२७", "content_sanskrit": "नहि रामो दशग्रीव शक्यो जेतुं रणे त्वया।\nरक्षसां वापि लोकेन स्वर्गः पापजनैरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000227028, "chapter_id": 9227, "verse_number": "३-३१-२८", "content_sanskrit": "न तं वध्यमहं मन्ये सर्वैर्देवासुरैरपि।\nअयं तस्य वधोपायस्तन्ममैकमनाः शृणु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000227029, "chapter_id": 9227, "verse_number": "३-३१-२९", "content_sanskrit": "भार्या तस्योत्तमा लोके सीता नाम सुमध्यमा।\nश्यामा समविभक्ताङ्गी स्त्रीरत्नं रत्नभूषिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000227030, "chapter_id": 9227, "verse_number": "३-३१-३०", "content_sanskrit": "नैव देवी न गन्धर्वी नाप्सरा न च पन्नगी।\nतुल्या सीमन्तिनी तस्या मानुषी तु कुतो भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000227031, "chapter_id": 9227, "verse_number": "३-३१-३१", "content_sanskrit": "तस्यापहर भार्यां त्वं तं प्रमथ्य महावने।\nसीतया रहितो रामो न चैव हि भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000227032, "chapter_id": 9227, "verse_number": "३-३१-३२", "content_sanskrit": "अरोचयत तद्वाक्यं रावणो राक्षसाधिपः।\nचिन्तयित्वा महाबाहुरकम्पनमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000227033, "chapter_id": 9227, "verse_number": "३-३१-३३", "content_sanskrit": "बाढं कल्यं गमिष्यामि ह्येकः सारथिना सह।\nआनेष्यामि च वैदेहीमिमां हृष्टो महापुरीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000227034, "chapter_id": 9227, "verse_number": "३-३१-३४", "content_sanskrit": "तदेवमुक्त्वा प्रययौ खरयुक्तेन रावणः।\nरथेनादित्यवर्णेन दिशः सर्वाः प्रकाशयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000227035, "chapter_id": 9227, "verse_number": "३-३१-३५", "content_sanskrit": "स रथो राक्षसेन्द्रस्य नक्षत्रपथगो महान्।\nचञ्चूर्यमाणः शुशुभे जलदे चन्द्रमा इव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000227036, "chapter_id": 9227, "verse_number": "३-३१-३६", "content_sanskrit": "स दूरे चाश्रमं गत्वा ताटकेयमुपागमत्।\nमारीचेनार्चितो राजा भक्ष्यभोज्यैरमानुषैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000227037, "chapter_id": 9227, "verse_number": "३-३१-३७", "content_sanskrit": "तं स्वयं पूजयित्वा तु आसनेनोदकेन च।\nअर्थोपहितया वाचा मारीचो वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000227038, "chapter_id": 9227, "verse_number": "३-३१-३८", "content_sanskrit": "कच्चित् सकुशलं राजँल्लोकानां राक्षसाधिप।\nआशङ्के नाधिजाने त्वं यतस्तूर्णमुपागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000227039, "chapter_id": 9227, "verse_number": "३-३१-३९", "content_sanskrit": "एवमुक्तो महातेजा मारीचेन स रावणः।\nततः पश्चादिदं वाक्यमब्रवीद् वाक्यकोविदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000227040, "chapter_id": 9227, "verse_number": "३-३१-४०", "content_sanskrit": "आरक्षो मे हतस्तात रामेणाक्लिष्टकारिणा।\nजनस्थानमवध्यं तत् सर्वं युधि निपातितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000227041, "chapter_id": 9227, "verse_number": "३-३१-४१", "content_sanskrit": "तस्य मे कुरु साचिव्यं तस्य भार्यापहारणे।\nराक्षसेन्द्रवचः श्रुत्वा मारीचो वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000227042, "chapter_id": 9227, "verse_number": "३-३१-४२", "content_sanskrit": "आख्याता केन वा सीता मित्ररूपेण शत्रुणा।\nत्वया राक्षसशार्दूल को न नन्दति नन्दितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000227043, "chapter_id": 9227, "verse_number": "३-३१-४३", "content_sanskrit": "सीतामिहानयस्वेति को ब्रवीति ब्रवीहि मे।\nरक्षोलोकस्य सर्वस्य कः शृङ्गं छेत्तुमिच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000227044, "chapter_id": 9227, "verse_number": "३-३१-४४", "content_sanskrit": "प्रोत्साहयति यश्च त्वां स च शत्रुरसंशयम्।\nआशीविषमुखाद् दंष्ट्रामुद्धर्तुं चेच्छति त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000227045, "chapter_id": 9227, "verse_number": "३-३१-४५", "content_sanskrit": "कर्मणानेन केनासि कापथं प्रतिपादितः।\nसुखसुप्तस्य ते राजन् प्रहृतं केन मूर्धनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000227046, "chapter_id": 9227, "verse_number": "३-३१-४६", "content_sanskrit": "विशुद्धवंशाभिजनाग्रहस्त-\nतेजोमदः संस्थितदोर्विषाणः।\nउदीक्षितुं रावण नेह युक्तः\nस संयुगे राघवगन्धहस्ती ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000227047, "chapter_id": 9227, "verse_number": "३-३१-४७", "content_sanskrit": "असौ रणान्तःस्थितिसंधिवालो\nविदग्धरक्षोमृगहा नृसिंहः।\nसुप्तस्त्वया बोधयितुं न शक्यः\nशराङ्गपूर्णो निशितासिदंष्ट्रः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000227048, "chapter_id": 9227, "verse_number": "३-३१-४८", "content_sanskrit": "चापापहारे भुजवेगपङ्के\nशरोर्मिमाले सुमहाहवौघे।\nन रामपातालमुखेऽतिघोरे\nप्रस्कन्दितुं राक्षसराज युक्तम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000227049, "chapter_id": 9227, "verse_number": "३-३१-४९", "content_sanskrit": "प्रसीद लङ्केश्वर राक्षसेन्द्र\nलङ्कां प्रसन्नो भव साधु गच्छ।\nत्वं स्वेषु दारेषु रमस्व नित्यं\nरामः सभार्यो रमतां वनेषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000227050, "chapter_id": 9227, "verse_number": "३-३१-५०", "content_sanskrit": "एवमुक्तो दशग्रीवो मारीचेन स रावणः।\nन्यवर्तत पुरीं लङ्कां विवेश च गृहोत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000227051, "chapter_id": 9227, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे एकत्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]