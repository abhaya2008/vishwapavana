[{"id": 7000502000, "chapter_id": 20502, "verse_number": "३-४९-१", "content_sanskrit": "सूत उवाच ।\nभ्रातृभिः सहिताः सर्वे पांडवा धर्मनिश्चयाः ।\nब्राह्मणेभ्यो नमस्कृत्वागुरुदेवांस्त्वतर्पयन्॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000502001, "chapter_id": 20502, "verse_number": "३-४९-२", "content_sanskrit": "वासुदेवोऽपि तत्रैव क्षणेनाभ्यागतस्तदा ।\nपांडवैः सहितैः सर्वैः पूज्यमानः स माधवः॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000502002, "chapter_id": 20502, "verse_number": "३-४९-३", "content_sanskrit": "कृष्णेन सहितैः सर्वैः पुनरेव महात्मभिः ।\nअभिषिक्तः स्वराज्ये तु धर्मपुत्रो युधिष्ठिरः॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000502003, "chapter_id": 20502, "verse_number": "३-४९-४", "content_sanskrit": "एतस्मिन्नंतरे चैव मार्कंडेयो महात्मवान् ।\nततः स्वस्तीति चोक्त्वा वै क्षणादाश्रममागतः॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000502004, "chapter_id": 20502, "verse_number": "३-४९-५", "content_sanskrit": "युधिष्ठिरोऽपि धर्मात्मा भ्रातृभिः सहितस्तु सः ।\nमहादानं ददौ चाथ धर्मपुत्रो युधिष्ठिरः॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000502005, "chapter_id": 20502, "verse_number": "३-४९-६", "content_sanskrit": "यस्त्विदं कल्यमुत्थाय पठते वा शृणोति वा ।\nमुच्यते सर्वपापेभ्यो विष्णुलोकं स गच्छति॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000502006, "chapter_id": 20502, "verse_number": "३-४९-७", "content_sanskrit": "वासुदेव उवाच ।\nमम वाक्यं तु कर्तव्यं तव स्नेहाद्ब्रवीम्यहम् ।\nनित्यं यज्ञरतो भूत्वा प्रयागे विगतज्वरः॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000502007, "chapter_id": 20502, "verse_number": "३-४९-८", "content_sanskrit": "प्रयागं संस्मरन्नित्यं सहास्माभिर्युधिष्ठिर ।\nस्वयं प्राप्स्यसि राजेंद्र स्वर्गलोकं तु शाश्वतम्॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000502008, "chapter_id": 20502, "verse_number": "३-४९-९", "content_sanskrit": "प्रयागमनुगच्छेद्वा वसते वापि यो नरः ।\nसर्वपापविशुद्धात्मा स्वर्गलोकं च गच्छति॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000502009, "chapter_id": 20502, "verse_number": "३-४९-१०", "content_sanskrit": "प्रतिग्रहादुपावृत्तः सन्तुष्टो नियतः शुचिः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000502010, "chapter_id": 20502, "verse_number": "३-४९-११", "content_sanskrit": "अहंकारनिवृत्तश्च स तीर्थफलमश्नुते ।\nअकोपनश्च राजेंद्र सत्यवादी दृढव्रतः ।\nआत्मोपमश्च भूतेषु स तीर्थफलमश्नुते॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000502011, "chapter_id": 20502, "verse_number": "३-४९-१२", "content_sanskrit": "ऋषिभिः क्रतवः प्रोक्ता देवैश्चापि यथाक्रमम् ।\nन हि शक्या दरिद्रेण यज्ञाः प्राप्तुं महीपते॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000502012, "chapter_id": 20502, "verse_number": "३-४९-१३", "content_sanskrit": "बहूपकरणो यज्ञो नानासंभारसंभ्रमः ।\nप्राप्यते विविधैरर्थ्यैः समृद्धैर्वा नरैः क्वचित्॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000502013, "chapter_id": 20502, "verse_number": "३-४९-१४", "content_sanskrit": "यो दरिद्रैरपि बुधैः शक्यः प्राप्तुं नरेश्वर ।\nततो यज्ञफलैः पुण्यैस्तन्निबोध जनेश्वर॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000502014, "chapter_id": 20502, "verse_number": "३-४९-१५", "content_sanskrit": "ऋषीणां परमं गुह्यमिदं भरतसत्तम ।\nतीर्थाभिगमनं पुण्यं यज्ञैरपि विशिष्यते॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000502015, "chapter_id": 20502, "verse_number": "३-४९-१६", "content_sanskrit": "दशकोटिसहस्राणि त्रिंशत्कोट्यस्तथापरे ।\nमाघमासे तु गंगायां गमिष्यंति नरर्षभ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000502016, "chapter_id": 20502, "verse_number": "३-४९-१७", "content_sanskrit": "स्वस्थो भव महाराज भुक्त्वा राज्यमकंटकम् ।\nपुनर्द्रक्ष्यसि राजेंद्र यजमानो विशेषतः॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]