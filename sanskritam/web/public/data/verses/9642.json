[{"id": 5000642000, "chapter_id": 9642, "verse_number": "७-१०७-१", "content_sanskrit": "विसृज्य लक्ष्मणं रामो दुःखशोकसमन्वितः ।\nपुरोधसं मन्त्रिणश्च नैगमांश्चेदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000642001, "chapter_id": 9642, "verse_number": "७-१०७-२", "content_sanskrit": "अद्य राज्ये ऽभिषेक्ष्यामि भरतं धर्मवत्सलम् ।\nअयोध्यायाः पतिं वीरं ततो यास्याम्यहं वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000642002, "chapter_id": 9642, "verse_number": "७-१०७-३", "content_sanskrit": "प्रवेशयत सम्भारान्माभूत्कालस्य पर्ययः ।\nअद्यैवाहं गमिष्यामि लक्ष्मणेन गतां गतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000642003, "chapter_id": 9642, "verse_number": "७-१०७-४", "content_sanskrit": "तच्छ्रुत्वा राघवेणोक्तं सर्वाः प्रकृतयो भृशम् ।\nमूर्धभिः प्रणता भूमौ गतसत्त्वा इवाभवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000642004, "chapter_id": 9642, "verse_number": "७-१०७-५", "content_sanskrit": "भरतश्च विसञ्ज्ञो ऽभूच्छ्रुत्वा रामस्य भाषितम् ।\nराज्यं विगर्हयामास राघवं चेदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000642005, "chapter_id": 9642, "verse_number": "७-१०७-६", "content_sanskrit": "सत्येनाहं शपे राजन्स्वर्गलोके न चैव हि ।\nन कामये यथा राज्यं त्वां विना रघुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000642006, "chapter_id": 9642, "verse_number": "७-१०७-७", "content_sanskrit": "इमौ कुशलवौ राजन्नभिषिञ्च नराधिप ।\nकोसलेषु कुशं वीरमुत्तरेषु तथा लवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000642007, "chapter_id": 9642, "verse_number": "७-१०७-८", "content_sanskrit": "शत्रुघ्नस्य तु गच्छन्तु दूतास्त्वरितविक्रमाः ।\nइदं गमनमस्माकं स्वर्गायाख्यातु मा चिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000642008, "chapter_id": 9642, "verse_number": "७-१०७-९", "content_sanskrit": "तच्छ्रुत्वा भरतेनोक्तं दृष्ट्वा चापि ह्यधोमुखान् ।\nपौरान्दुःखेन सन्तप्तान्वसिष्ठो वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000642009, "chapter_id": 9642, "verse_number": "७-१०७-१०", "content_sanskrit": "वत्स राम इमाः पश्य धरणीं प्रकृतीर्गताः ।\nज्ञात्वैषामीप्सितं कार्यं मा चैषां विप्रियं कृथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000642010, "chapter_id": 9642, "verse_number": "७-१०७-११", "content_sanskrit": "वसिष्ठस्य तु वाक्येन उत्थाप्य प्रकृतीजनम् ।\nकिं करोमीति काकुत्स्थः सर्वा वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000642011, "chapter_id": 9642, "verse_number": "७-१०७-१२", "content_sanskrit": "ततः सर्वाः प्रकृतयो रामं वचनमब्रुवन् ।\nगच्छन्तमनुगच्छामो यत्र राम गमिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000642012, "chapter_id": 9642, "verse_number": "७-१०७-१३", "content_sanskrit": "पौरेषु यदि ते प्रीतिर्यदि स्नेहो ह्यनुत्तमः ।\nसपुत्रदाराः काकुत्स्थ समागच्छाम सत्पथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000642013, "chapter_id": 9642, "verse_number": "७-१०७-१४", "content_sanskrit": "तपोवनं वा दुर्गं वा नदीमम्भोनिधिं तथा ।\nवयं ते यदि न त्याज्याः सर्वान्नो नय ईश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000642014, "chapter_id": 9642, "verse_number": "७-१०७-१५", "content_sanskrit": "एषा नः परमा प्रीतिरेष नः परमो वरः ।\nहृद्गता नः सदा प्रीतिस्तवानुगमने नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000642015, "chapter_id": 9642, "verse_number": "७-१०७-१६", "content_sanskrit": "पौराणां दृढभक्तिं च बाढमित्येव सो ऽब्रवीत् ।\nस्वकृतान्तं चान्ववेक्ष्य तस्मिन्नहनि राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000642016, "chapter_id": 9642, "verse_number": "७-१०७-१७", "content_sanskrit": "कोसलेषु कुशं वीरमुत्तरेषु तथा लवम् ।\nअभिषिच्य महात्मानावुभौ रामः कुशीलवौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000642017, "chapter_id": 9642, "verse_number": "७-१०७-१८", "content_sanskrit": "अभिषिक्तौ सुतावङ्के प्रतिष्ठाप्य पुरे ततः ।\nपरिष्वज्य महाबाहुर्मूर्ध्न्युपाघ्राय चासकृत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000642018, "chapter_id": 9642, "verse_number": "७-१०७-१९", "content_sanskrit": "रथानां तु सहस्राणि नागानामयुतानि च ।\nदशायुतानि चाश्वानामेकैकस्य धनं ददौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000642019, "chapter_id": 9642, "verse_number": "७-१०७-२०", "content_sanskrit": "बहुरत्नौ बहुधनौ हृष्टपुष्टजनावृतौ ।\nस्वे पुरे प्रेषयामास भ्रातरौ तु कुशीलवौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000642020, "chapter_id": 9642, "verse_number": "७-१०७-२१", "content_sanskrit": "अभिषिच्य सुतौ वीरौ प्रतिष्ठाप्य पुरे तदा ।\nदूतान्सम्प्रेषयामास शत्रुघ्नाय महात्मने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000642021, "chapter_id": 9642, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे सप्तोत्तरशततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]