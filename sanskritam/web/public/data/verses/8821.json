[{"id": 40001172, "chapter_id": 8821, "verse_number": "1", "content_sanskrit": "विश्वामित्रवचश्श्रुत्वा कथाऽन्ते रघुनन्दन:। उवाच परमप्रीतो मुनिं दीप्तमिवानलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40001173, "chapter_id": 8821, "verse_number": "2", "content_sanskrit": "श्रोतुमिच्छामि भद्रं ते विस्तरेण कथामिमाम्। पूर्वको मे कथं ब्रह्मन् यज्ञं वै समुपाहरत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40001174, "chapter_id": 8821, "verse_number": "3", "content_sanskrit": "विश्वामित्रस्तु काकुत्स्थमुवाच प्रहसन्निव। श्रूयतां विस्तरो राम सगरस्य महात्मन: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40001175, "chapter_id": 8821, "verse_number": "4", "content_sanskrit": "शङ्करश्वशुरो नाम हिमवानचलोत्तम:। विंध्यपर्वतमासाद्य निरीक्षेते परस्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40001176, "chapter_id": 8821, "verse_number": "5", "content_sanskrit": "तयोर्मध्ये प्रवृत्तोऽभूद्यज्ञ स्सपुरुषोत्तम। स हि देशो नरव्याघ्र प्रशस्तो यज्ञकर्मणि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40001177, "chapter_id": 8821, "verse_number": "6", "content_sanskrit": "तस्याश्वचर्यां काकुत्स्थ दृढधन्वा महारथ:। अंशुमानकरोत्तात सगरस्य मते स्थित: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40001178, "chapter_id": 8821, "verse_number": "7", "content_sanskrit": "तस्य पर्वणि तं यज्ञं यजमानस्य वासव:। राक्षसीं तनुमास्थाय यज्ञीयाश्वमपाहरत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40001179, "chapter_id": 8821, "verse_number": "8", "content_sanskrit": "ह्रियमाणे तु काकुत्स्थ तस्मिन्नश्वे महात्मन:। उपाध्यायगणास्सर्वे यजमानमथाब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40001180, "chapter_id": 8821, "verse_number": "9", "content_sanskrit": "अयं पर्वणि वेगेन यज्ञियाश्वोऽपनीयते। हर्तारं जहि काकुत्स्थ हयश्चैवोपनीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40001181, "chapter_id": 8821, "verse_number": "10", "content_sanskrit": "यज्ञच्छिद्रं भवत्येतत्सर्वेषामशिवाय न:। तत्तथा क्रियतां राजन् यथाऽच्छिद्र: क्रतुर्भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40001182, "chapter_id": 8821, "verse_number": "11", "content_sanskrit": "उपाध्यायवच श्श्रुत्वा तस्मिन् सदसि पार्थिव:। षष्टिं पुत्रसहस्राणि वाक्यमेतदुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40001183, "chapter_id": 8821, "verse_number": "12", "content_sanskrit": "गतिं पुत्रा: न पश्यामि रक्षसां परुषर्षभा:। मन्त्रपूतैर्महाभागैरास्थितो हि महाक्रतु: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40001184, "chapter_id": 8821, "verse_number": "13", "content_sanskrit": "तद्गच्छत विचिन्वध्वं पुत्रका: भद्रमस्तु व:। समुद्रमालिनीं सर्वां पृथिवीमनुगच्छत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40001185, "chapter_id": 8821, "verse_number": "14", "content_sanskrit": "एकैकयोजनं पुत्रा विस्तारमधिगच्छत। यावत्तुरगसन्दर्श: तावत् खनत मेदिनीम्। तं चैव हयहर्तारं मार्गमाणा ममाज्ञया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40001186, "chapter_id": 8821, "verse_number": "15", "content_sanskrit": "दीक्षित: पौत्रसहितस्सोपाध्यायगणो ह्यहम्। इह स्थास्यामि भद्रं वो यावत्तुरगदर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40001187, "chapter_id": 8821, "verse_number": "16", "content_sanskrit": "इत्युक्ता हृष्टमनसो राजपुत्रा महाबला:। जग्मुर्महीतलं राम पितुर्वचनयन्त्रिता: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40001188, "chapter_id": 8821, "verse_number": "17", "content_sanskrit": "योजनायामविस्तारमेकैको धरणीतलम्। बिभिदु: परुषव्याघ्र वज्रस्पर्शसमैर्नखै: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40001189, "chapter_id": 8821, "verse_number": "18", "content_sanskrit": "शूलैरशनिकल्पैश्च हलैश्चापि सुदारुणै:। भिद्यमाना वसुमती ननाद रघुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40001190, "chapter_id": 8821, "verse_number": "19", "content_sanskrit": "नागानां मथ्यमानानामसुराणां च राघव । राक्षसानां च दुर्धर्षस्सत्त्वानां निनदोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40001191, "chapter_id": 8821, "verse_number": "20", "content_sanskrit": "योजनानां सहस्राणि षष्टिं तु रघुनन्दन । बिभिदुर्धरणीं वीरा: रसातलमनुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40001192, "chapter_id": 8821, "verse_number": "21", "content_sanskrit": "एवं पर्वतसम्बाधं जम्बूद्वीपं नृपात्मजा:। खनन्तो नरशार्दूल सर्वत: परिचक्रमु: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40001193, "chapter_id": 8821, "verse_number": "22", "content_sanskrit": "ततो देवास्सगन्धर्वास्सासुरास्सहपन्नगा:। सम्भ्रान्तमनसस्सर्वे पितामहमुपागमन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40001194, "chapter_id": 8821, "verse_number": "23", "content_sanskrit": "ते प्रसाद्य महात्मानं विषण्णवदनास्तदा। ऊचु: परमसन्त्रस्ता पितामहमिदं वच: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40001195, "chapter_id": 8821, "verse_number": "24", "content_sanskrit": "भगवन् पृथिवी सर्वा खन्यते सगरात्मजै:। बहवश्च महात्मानो हन्यन्ते तलवासिन: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40001196, "chapter_id": 8821, "verse_number": "25", "content_sanskrit": "अयं यज्ञहरोऽस्माकमनेनाश्वोऽपनीयते। इति ते सर्वभूतानि निघ्नन्ति सगरात्मजा: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]