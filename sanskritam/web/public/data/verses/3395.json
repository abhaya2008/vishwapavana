[{"id": 2110809, "chapter_id": 3395, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2110810, "chapter_id": 3395, "verse_number": "१", "content_sanskrit": "पौरवेणाथ वयसा ययातिर्नहुषात्मजः ।\nरूपयौवनसम्पन्नः कुमारः सहसाऽभवत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2110811, "chapter_id": 3395, "verse_number": "२", "content_sanskrit": "प्रीतियुक्तो नृपश्रेष्ठश्चचार विषयान् प्रियान् ।\nयथाकामं यथोत्साहं यथाकालं यथासुखम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2110812, "chapter_id": 3395, "verse_number": "३", "content_sanskrit": "धर्माविरुद्धं राजेन्द्रो यथाऽर्हं सोऽन्वसेवत ।\nदेवानतर्पयद् यज्ञैः श्राद्धैः सन्तर्पयन् पितॄन् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2110813, "chapter_id": 3395, "verse_number": "४", "content_sanskrit": "दीनान्धकृपणान् विप्राननाथांश्चाभ्यपूजयत् ।\nअतिथीनन्नपानैश्च विशः शूद्रानपालयत् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2110814, "chapter_id": 3395, "verse_number": "५", "content_sanskrit": "आनृशंस्येन सर्वांश्च दस्यून् निग्रहणेन च ।\nस्वधर्मेण प्रजाः सर्वा यथावदनुरञ्जयन् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2110815, "chapter_id": 3395, "verse_number": "६", "content_sanskrit": "ययातिः पालयामास साक्षादिन्द्र इवापरः ।\nस राजा सिंहविक्रान्तो युवा विषयगोचरः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2110816, "chapter_id": 3395, "verse_number": "७", "content_sanskrit": "अविरोधेन धर्मस्य चचार सुखमुत्तमम् ।\nस सम्प्राप्य सुखान् कामान् तृप्तः खिन्नश्च पार्थिवः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2110817, "chapter_id": 3395, "verse_number": "८", "content_sanskrit": "कालं वर्षसहस्रान्तं सस्मार मनुजाधिपः ।\nपरिसङ्ख्याय कालज्ञः कलाः काष्ठाश्च वीर्यवान् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2110818, "chapter_id": 3395, "verse_number": "९", "content_sanskrit": "पूर्णं मत्वा ततः कालं पूरुं पुत्रमुवाच ह ।\nयथाकालं यथोत्साहं यथाकाममरिन्दम \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2110819, "chapter_id": 3395, "verse_number": "१०", "content_sanskrit": "सेविता विषयाः पुत्र यौवनेन मया तव ।\nतेजसा तव सत्पुत्र पूर्णं यौवनमुत्तमम् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2110820, "chapter_id": 3395, "verse_number": "११", "content_sanskrit": "पूरो प्रीतोऽस्मि भद्रं ते गृहाणेदं स्वयौवनम् ।\nराज्यं च मे गृहणेदं यावदिच्छसि यौवनम् ।\nतावद् दीर्घायुषो भुङ्क्ष्व त्वं हि मे प्रियकृत् सुतः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2110821, "chapter_id": 3395, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2110822, "chapter_id": 3395, "verse_number": "१२", "content_sanskrit": "प्रतिपेदे जरां राजा ययातिर्नहुषात्मजः ।\nयौवनं प्रतिपेदे च पूरुः स्वं पुनरात्मवान् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2110823, "chapter_id": 3395, "verse_number": "१३", "content_sanskrit": "अभिषेक्तुकामं नृपतिं पूरुं पुत्रं कनीयसम् ।\nब्राह्मणप्रमुखाः पौरा इदं वचनमब्रुवन् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2110824, "chapter_id": 3395, "verse_number": "१४", "content_sanskrit": "कथं शुक्रस्य नप्तारं देवयान्याः सुतं प्रभो ।\nज्येष्ठं यदुमतिक्रम्य पूरो राज्यं प्रदास्यसि\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2110825, "chapter_id": 3395, "verse_number": "१५", "content_sanskrit": "यदुर्ज्येष्ठस्तव सुतो जातस्तमनु तुर्वशुः ।\nशर्मिष्ठायाः सुतो द्रुह्युरनुः पूरुश्च पार्थिव\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2110826, "chapter_id": 3395, "verse_number": "१६", "content_sanskrit": "कथं ज्येष्ठानतिक्रम्य यवीयान् राज्यमर्हति ।\nएतत् सम्बोधयामस्त्वां धर्मं त्वमनुपालय \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2110827, "chapter_id": 3395, "verse_number": "", "content_sanskrit": "ययातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2110828, "chapter_id": 3395, "verse_number": "१७", "content_sanskrit": "ब्राह्मणप्रमुखाः पौराः सर्वे शृण्वन्तु मे वचः ।\nज्येष्ठं प्रति यथा राज्यं न देयं मे कथञ्चन \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2110829, "chapter_id": 3395, "verse_number": "१८", "content_sanskrit": "मम ज्येष्ठेन यदुना नियोगो नानुपालितः ।\nप्रतिकूलः पितुर्यश्च न स पुत्रः सतां मतः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2110830, "chapter_id": 3395, "verse_number": "१९", "content_sanskrit": "मातापित्रोर्वचनकृत् पथ्यस्य विहितस्य च ।\nस पुत्रः पुत्रवद् यश्च वर्तते पितृमातृषु\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2110831, "chapter_id": 3395, "verse_number": "२०", "content_sanskrit": "पुतीति नरकस्याख्या दुःखं हि नरकं विदुः ।\nपुतित्राणात् ततः पुत्रमिहेच्छन्ति परत्र च ।\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2110832, "chapter_id": 3395, "verse_number": "२१", "content_sanskrit": "आत्मनः सदृशः पुत्रः पितृदेवर्षिपूजने ।\nयो बहूनां गुणकरः स पुत्रो ज्येष्ठ उच्यते\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2110833, "chapter_id": 3395, "verse_number": "२२", "content_sanskrit": "मूकोऽन्धो बधिरः श्वित्री स्वधर्मं नानुतिष्ठति ।\nचोरः किल्बिषिकः पुत्रो ज्येष्ठो न ज्येष्ठ उच्यते \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2110834, "chapter_id": 3395, "verse_number": "२३", "content_sanskrit": "ज्येष्ठांशहारी गुणकृदिह लोके परत्र च ।\nश्रेयान् पुत्रो गुणोपेतः स पुत्रो नेतरो वृथा \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2110835, "chapter_id": 3395, "verse_number": "२४", "content_sanskrit": "वदन्ति धर्मं धर्मज्ञाः पितॄणां पुत्रकारणान् ।\nयदुनाऽहमवज्ञातस्तथा तुर्वशुना पुनः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2110836, "chapter_id": 3395, "verse_number": "२५", "content_sanskrit": "द्रुह्युना चानुना चैव मय्यवज्ञा कृता भृशम् ।\nपूरुणा मे कृतं वाक्यं मानितश्च विशेषतः \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2110837, "chapter_id": 3395, "verse_number": "२६", "content_sanskrit": "कनीयान् मम दायादो धृता येन जरा मम ।\nपुत्रो यस्त्वनुवर्तेत स राजा पृथिवीपतिः \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2110838, "chapter_id": 3395, "verse_number": "२७", "content_sanskrit": "यो वानुवर्ती पुत्राणां स पुत्रो दायभाग् भवेत् ।\nवेदोक्तं सम्भवं मह्यमनेन हृदयोद्भवम् \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2110839, "chapter_id": 3395, "verse_number": "२८", "content_sanskrit": "तस्य जातमिदं कृत्स्नमात्मा पुत्र इति श्रुतिः ।\nमम कामः स च कृतः पूरुणा पितृरूपिणा \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2110840, "chapter_id": 3395, "verse_number": "२९", "content_sanskrit": "शुक्रेण च वरो दत्तः काव्येनोशनसा स्वयम् ।\nभवतोऽनुनयाम्येवं पूरू राज्येऽभिषिच्यताम् \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2110841, "chapter_id": 3395, "verse_number": "", "content_sanskrit": "पौराः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2110842, "chapter_id": 3395, "verse_number": "३०", "content_sanskrit": "यः पुत्रो गुणसम्पन्नो मातापित्रोर्हितः सदा ।\nसर्वमर्हति कल्याणं कनीयानपि स प्रभो\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2110843, "chapter_id": 3395, "verse_number": "३१", "content_sanskrit": "वेदे धर्मे चार्थशास्त्रे मुनिभिः कथितं पुरा ।\nअर्हः पूरुरिदं राज्यं यः सुतः प्रियकृत् तव ।\nवरदानाच्च शुक्रस्य न शक्यं वक्तुमुत्तरम् \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2110844, "chapter_id": 3395, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2110845, "chapter_id": 3395, "verse_number": "३२", "content_sanskrit": "पौरजानपदैस्तुष्टैरित्युक्तो नाहुषस्तदा ।\nअभ्यषिञ्चत् तदा पूरुं ययातिर्द्विजपूर्वकम् \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2110846, "chapter_id": 3395, "verse_number": "३३", "content_sanskrit": "यदुं च तुर्वशुं चोभौ द्रुह्युं चैव सहानुजम् ।\nअन्तेषु स विनिक्षिप्य नाहुषः स्वात्मजान् सुतान् \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2110847, "chapter_id": 3395, "verse_number": "३४", "content_sanskrit": "दत्त्वा च पूरवे राज्यं वनवासाय दीक्षितः ।\nपुरात् स निर्ययौ तस्माद् ब्राह्मणैस्तापसैः सह\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2110848, "chapter_id": 3395, "verse_number": "३५", "content_sanskrit": "यदोर्जाता यादवाश्च तुर्वशोर्यवनाः सुताः ।\nद्रुह्योरपि सुता भोजा अनोस्तु म्लेच्छजातयः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2110849, "chapter_id": 3395, "verse_number": "३६", "content_sanskrit": "पुरोस्तु पौरवो वंशो यत्र जातोऽसि पार्थिव ।\nइदं वर्षसहस्राय राज्यं कारयिता प्रभो\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2110850, "chapter_id": 3395, "verse_number": "३२", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nचतुःसप्ततितमोऽध्यायः ॥७४॥ ॥ सम्भवपर्वणि द्वाविंशोऽध्यायः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]