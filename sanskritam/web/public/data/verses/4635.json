[{"id": 2170149, "chapter_id": 4635, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2170150, "chapter_id": 4635, "verse_number": "१", "content_sanskrit": "एवमेष महानासीत् सङ्ग्रामः पृथिवीक्षिताम् ।\nक्रुद्धेऽर्जुने तथा कर्णे भीमसेने च पाण्डवे\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2170151, "chapter_id": 4635, "verse_number": "२", "content_sanskrit": "द्रोणपुत्रं पराजित्य जित्वा चान्यान् महारथान् ।\nअब्रवीदर्जुनो राजन् वासुदेवमिदं वचः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2170152, "chapter_id": 4635, "verse_number": "३", "content_sanskrit": "पश्य कृष्ण महाबाहो द्रवन्तीं पाण्डवीं चमूम् ।\nकर्णं पश्य च सङ्ग्रामे कालयन्तं महारथान्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2170153, "chapter_id": 4635, "verse_number": "४", "content_sanskrit": "न च पश्यामि दाशार्ह धर्मराजं युधिष्ठिरम् ।\nनापि केतुर्युधांश्रेष्ठ धर्मराजस्य दृश्यते\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2170154, "chapter_id": 4635, "verse_number": "५", "content_sanskrit": "त्रिभागश्चावशिष्टोऽयं दिवसस्य जनार्दन ।\nन च मां धार्तराष्ट्रेषु कश्चिद् युध्यति संयुगे\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2170155, "chapter_id": 4635, "verse_number": "६", "content_sanskrit": "तस्मात् त्वं मत्प्रियं कुर्वन् याहि यत्र युधिष्ठिरः ।\nदृष्ट्वा कुशलिनं युद्धे धर्मपुत्रं सहानुजम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2170156, "chapter_id": 4635, "verse_number": "७", "content_sanskrit": "पुनर्योद्धास्मि वार्ष्णेय शत्रुभिः सह संयुगे\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2170157, "chapter_id": 4635, "verse_number": "८", "content_sanskrit": "ततः प्रायाद् रथेनाशु बीभत्सोर्वचनाद्धरिः ।\nयतो युधिष्ठिरो राजा सृञ्जयाश्च महारथाः ।\nअयुध्यंस्तावकैः सार्धं मृत्युं कृत्वा निवर्तनम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2170158, "chapter_id": 4635, "verse_number": "९", "content_sanskrit": "त्वरमाणः पुनः कृष्णः पार्थमाह शनैरिदम् ।\nपश्य कौरव्य राजानमुपायातांश्च पार्थिवान्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2170159, "chapter_id": 4635, "verse_number": "१०", "content_sanskrit": "कर्णं पश्य महारङ्गे ज्वलन्तमिव पावकम् ।\nअसौ भीमो महेष्वासः सन्निवृत्तो रणं प्रति\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2170160, "chapter_id": 4635, "verse_number": "११", "content_sanskrit": "तमेतेऽनु निवर्तन्ते धृष्टद्युम्नपुरोगमाः ।\nपाञ्चालानां सृञ्जयानां पाण्डवानां च यन्मुखम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2170161, "chapter_id": 4635, "verse_number": "१२", "content_sanskrit": "निवृत्तैश्च तथा पार्थैर्भग्नं शत्रुबलं महत्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2170162, "chapter_id": 4635, "verse_number": "१३", "content_sanskrit": "कौरवान् द्रवतो ह्येष कर्णो धारयतेऽर्जुन ।\nअन्तकप्रतिमो वेगे शक्रतुल्यपराक्रमः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2170163, "chapter_id": 4635, "verse_number": "१४", "content_sanskrit": "असौ गच्छति कौरव्य द्रौणिरस्त्रभृतां वरः ।\nतमेष प्रद्रुतः सङ्खे धृष्टद्युम्नो महारथः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2170164, "chapter_id": 4635, "verse_number": "१५", "content_sanskrit": "अनुप्रयातान् सङ्ग्रामे हतान् पश्य च सृञ्जयान्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2170165, "chapter_id": 4635, "verse_number": "१६", "content_sanskrit": "सर्वं व्याचष्ट दुर्धर्षो वासुदेवः किरीटिने ।\nततो राजन् प्रादुरासीन्महाघोरो महारणः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2170166, "chapter_id": 4635, "verse_number": "१७", "content_sanskrit": "सिंहनादरवाश्चात्र प्रादुरासन् समागमे ।\nउभयोः सेनयो राजन् मृत्युं कृत्वा निवर्तनम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2170167, "chapter_id": 4635, "verse_number": "१८", "content_sanskrit": "एवमेष क्षयो वृत्तः पृथिव्यां पृथिवीपते ।\nतावकानां परेषां च राजन् दुर्मन्त्रिते तव\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2170168, "chapter_id": 4635, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां कर्णपर्वणि\nपञ्चपञ्चाशोऽध्यायः ॥५५॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]