[{"id": 900008248, "chapter_id": 8624, "verse_number": "5.1", "content_sanskrit": "शास्त्रयोनित्वेन कारणत्वस्य नातिव्याप्तिरिति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900008249, "chapter_id": 8624, "verse_number": "5.2", "content_sanskrit": "उपक्रमादि तु न तात्पर्यनिश्चायकम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900008250, "chapter_id": 8624, "verse_number": "5.3", "content_sanskrit": "यद्वा शास्त्राद्रुद्रादेः कारणता तावद्भाति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900008251, "chapter_id": 8624, "verse_number": "5.4", "content_sanskrit": "सिद्धान्तस्तु", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900008252, "chapter_id": 8624, "verse_number": "5.5", "content_sanskrit": "उपक्रमादयोऽपि..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900008253, "chapter_id": 8624, "verse_number": "5.6", "content_sanskrit": "दुरधिगमेऽसम्भावितेऽर्थे तात्पर्याभावाशङ्कानिरासार्थमसकृदुक्तिश्चार्थवती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900008254, "chapter_id": 8624, "verse_number": "5.7", "content_sanskrit": "अपूर्वता तु स्वबोधनीयपुरुषगताज्ञानादिविरोधिना स्वानुपजीविमानान्तरेणा-ग्राह्यार्थत्वम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900008255, "chapter_id": 8624, "verse_number": "5.8", "content_sanskrit": "इतिकर्तव्यताविधायकस्य कर्मविधायकोपजीवित्वान्न कर्मांशेऽपूर्वता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900008256, "chapter_id": 8624, "verse_number": "5.9", "content_sanskrit": "स्तुतौ निन्दायामेककर्तृकोपाख्यानरूपपरकृतौ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900008257, "chapter_id": 8624, "verse_number": "5.10", "content_sanskrit": "तत्र चैकप्रकरणे प्रथमेनार्थे धीस्थे..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900008258, "chapter_id": 8624, "verse_number": "5.11", "content_sanskrit": "एवमुपसंहारादिरूपसकृदुक्तितोऽसकृदुक्तिरूपाभ्यासस्य प्राबल्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900008259, "chapter_id": 8624, "verse_number": "5.12", "content_sanskrit": "एवमसकृदावृत्तस्याप्येकस्य पदस्य वाक्यस्य वा..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900008260, "chapter_id": 8624, "verse_number": "5.13", "content_sanskrit": "एवं फलार्थत्वात्सर्वस्य..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900008261, "chapter_id": 8624, "verse_number": "5.14", "content_sanskrit": "एवं फलमात्रात्करणाकरणयोरिष्टानिष्टकथनादिरूपार्थवादस्य प्राबल्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900008262, "chapter_id": 8624, "verse_number": "5.15", "content_sanskrit": "एवं सार्थवादस्याप्यनुपपन्नेऽर्थे तात्पर्यादर्शनादुपपन्ने..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900008263, "chapter_id": 8624, "verse_number": "5.16", "content_sanskrit": "न च तात्पर्यनिर्णयाय श्रुत्युक्ताया..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900008264, "chapter_id": 8624, "verse_number": "5.17", "content_sanskrit": "तस्मादुपक्रमादौ परबलीयस्त्वं श्रुत्यादौ तु पूर्वबलीयस्त्वम् ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900008265, "chapter_id": 8624, "verse_number": "5.18", "content_sanskrit": "तत्र विरोधे दुर्बलं बाध्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900008266, "chapter_id": 8624, "verse_number": "5.19", "content_sanskrit": "सूत्राक्षरार्थस्तु", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 900008267, "chapter_id": 8624, "verse_number": "5.20", "content_sanskrit": "अत्र परैर्वेदान्ता ब्रह्मणि न प्रमाणं सिद्धवस्तुबोधने ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 900008268, "chapter_id": 8624, "verse_number": "5.21", "content_sanskrit": "सिद्धान्तोप्ययुक्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 900008269, "chapter_id": 8624, "verse_number": "5.22", "content_sanskrit": "किञ्च कण्ठमण्युपदेशस्य प्राप्तमणिप्राप्तिर्न फलम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 900008270, "chapter_id": 8624, "verse_number": "5.23", "content_sanskrit": "केचित्तु फलाभावापातात्सिद्धपरत्वं नेति प्राप्ते..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]