[{"id": 5000016000, "chapter_id": 9016, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे षोडशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000016001, "chapter_id": 9016, "verse_number": "१-१६-१", "content_sanskrit": "ततो नारायणो विष्णुर्नियुक्तः सुरसत्तमैः ।\nजानन्नपि सुरानेवं श्लक्ष्णं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000016002, "chapter_id": 9016, "verse_number": "१-१६-२", "content_sanskrit": "उपायः को वधे तस्य राक्षसाधिपतेः सुराः ।\nयमहं तं समास्थाय निहन्यामृषिकण्टकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000016003, "chapter_id": 9016, "verse_number": "१-१६-३", "content_sanskrit": "एवमुक्ताः सुराः सर्वे प्रत्यूचुर्विष्णुमव्ययम् ।\nमानुषं रूपमास्थाय रावणं जहि संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000016004, "chapter_id": 9016, "verse_number": "१-१६-४", "content_sanskrit": "स हि तेपे तपस्तीव्रं दीर्घकालमरिन्दमः ।\nयेन तुष्टोऽभवद् ब्रह्मा लोककृल्लोकपूर्वजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000016005, "chapter_id": 9016, "verse_number": "१-१६-५", "content_sanskrit": "संतुष्टः प्रददौ तस्मै राक्षसाय वरं प्रभुः ।\nनानाविधेभ्यो भूतेभ्यो भयं नान्यत्र मानुषात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000016006, "chapter_id": 9016, "verse_number": "१-१६-६", "content_sanskrit": "अवज्ञाताः पुरा तेन वरदाने हि मानवाः ।\nएवं पितामहात् तस्मात् वरदानेन गर्वितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000016007, "chapter_id": 9016, "verse_number": "१-१६-७", "content_sanskrit": "उत्सादयति लोकांस्त्रीन् स्त्रियश्चाप्युपकर्षति ।\nतस्मात् तस्य वधो दृष्टो मानुषेभ्यः परंतप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000016008, "chapter_id": 9016, "verse_number": "१-१६-८", "content_sanskrit": "इत्येतद् वचनं श्रुत्वा सुराणां विष्णुरात्मवान् ।\nपितरं रोचयामास तदा दशरथं नृपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000016009, "chapter_id": 9016, "verse_number": "१-१६-९", "content_sanskrit": "स चाप्यपुत्रो नृपतिस्तस्मिन् काले महाद्युतिः ।\nअयजत् पुत्रियामिष्टिं पुत्रेप्सुररिसूदनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000016010, "chapter_id": 9016, "verse_number": "१-१६-१०", "content_sanskrit": "स कृत्वा निश्चयं विष्णुरामन्त्र्य च पितामहम् ।\nअन्तर्धानं गतो देवैः पूज्यमानो महर्षिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000016011, "chapter_id": 9016, "verse_number": "१-१६-११", "content_sanskrit": "ततो वै यजमानस्य पावकादतुलप्रभम् ।\nप्रादुर्भूतं महद् भूतं महावीर्यं महाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000016012, "chapter_id": 9016, "verse_number": "१-१६-१२", "content_sanskrit": "कृष्णं रक्ताम्बरधरं रक्तास्यं दुन्दुभिस्वनम् ।\nस्निग्धहर्यक्षतनुजश्मश्रुप्रवरमूर्धजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000016013, "chapter_id": 9016, "verse_number": "१-१६-१३", "content_sanskrit": "शुभलक्षणसम्पन्नं दिव्याभरणभूषितम् ।\nशैलशृङ्गसमुत्सेधं दृप्तशार्दूलविक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000016014, "chapter_id": 9016, "verse_number": "१-१६-१४", "content_sanskrit": "दिवाकरसमाकारं दीप्तानलशिखोपमम् ।\nतप्तजाम्बूनदमयीं राजतान्तपरिच्छदाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000016015, "chapter_id": 9016, "verse_number": "१-१६-१५", "content_sanskrit": "दिव्यपायससम्पूर्णां पात्रीं पत्नीमिव प्रियाम् ।\nप्रगृह्य विपुलां दोर्भ्यां स्वयं मायामयीमिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000016016, "chapter_id": 9016, "verse_number": "१-१६-१६", "content_sanskrit": "समवेक्ष्याब्रवीद् वाक्यमिदं दशरथं नृपम् ।\nप्राजापत्यं नरं विद्धि मामिहाभ्यागतं नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000016017, "chapter_id": 9016, "verse_number": "१-१६-१७", "content_sanskrit": "ततः परं तदा राजा प्रत्युवाच कृताञ्जलिः ।\nभगवन् स्वागतं तेऽस्तु किमहं करवाणि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000016018, "chapter_id": 9016, "verse_number": "१-१६-१८", "content_sanskrit": "अथो पुनरिदं वाक्यं प्राजापत्यो नरोऽब्रवीत् ।\nराजन्नर्चयता देवानद्य प्राप्तमिदं त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000016019, "chapter_id": 9016, "verse_number": "१-१६-१९", "content_sanskrit": "इदं तु नरशार्दूल पायसं देवनिर्मितम् ।\nप्रजाकरं गृहाण त्वं धन्यमारोग्यवर्धनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000016020, "chapter_id": 9016, "verse_number": "१-१६-२०", "content_sanskrit": "भार्याणामनुरूपाणामश्नीतेति प्रयच्छ वै ।\nतासु त्वं लप्स्यसे पुत्रान् यदर्थं यजसे नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000016021, "chapter_id": 9016, "verse_number": "१-१६-२१", "content_sanskrit": "तथेति नृपतिः प्रीतः शिरसा प्रतिगृह्य ताम् ।\nपात्रीं देवान्नसम्पूर्णां देवदत्तां हिरण्मयीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000016022, "chapter_id": 9016, "verse_number": "१-१६-२२", "content_sanskrit": "अभिवाद्य च तद्भूतमद्भुतं प्रियदर्शनम् ।\nमुदा परमया युक्तश्चकाराभिप्रदक्षिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000016023, "chapter_id": 9016, "verse_number": "१-१६-२३", "content_sanskrit": "ततो दशरथः प्राप्य पायसं देवनिर्मितम् ।\nबभूव परमप्रीतः प्राप्य वित्तमिवाधनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000016024, "chapter_id": 9016, "verse_number": "१-१६-२४", "content_sanskrit": "ततस्तदद्भुतप्रख्यं भूतं परमभास्वरम् ।\nसंवर्तयित्वा तत् कर्म तत्रैवान्तरधीयत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000016025, "chapter_id": 9016, "verse_number": "१-१६-२५", "content_sanskrit": "हर्षरश्मिभिरुद्द्योतं तस्यान्तःपुरमाबभौ ।\nशारदस्याभिरामस्य चन्द्रस्येव नभोंऽशुभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000016026, "chapter_id": 9016, "verse_number": "१-१६-२६", "content_sanskrit": "सोऽन्तःपुरं प्रविश्यैव कौसल्यामिदमब्रवीत् ।\nपायसं प्रतिगृह्णीष्व पुत्रीयं त्विदमात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000016027, "chapter_id": 9016, "verse_number": "१-१६-२७", "content_sanskrit": "कौसल्यायै नरपतिः पायसार्धं ददौ तदा ।\nअर्धादर्धं ददौ चापि सुमित्रायै नराधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000016028, "chapter_id": 9016, "verse_number": "१-१६-२८", "content_sanskrit": "कैकेय्यै चावशिष्टार्धं ददौ पुत्रार्थकारणात् ।\nप्रददौ चावशिष्टार्धं पायसस्यामृतोपमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000016029, "chapter_id": 9016, "verse_number": "१-१६-२९", "content_sanskrit": "अनुचिन्त्य सुमित्रायै पुनरेव महामतिः ।\nएवं तासां ददौ राजा भार्याणां पायसं पृथक् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000016030, "chapter_id": 9016, "verse_number": "१-१६-३०", "content_sanskrit": "ताश्चैवं पायसं प्राप्य नरेन्द्रस्योत्तमस्त्रियः ।\nसम्मानं मेनिरे सर्वाः प्रहर्षोदितचेतसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000016031, "chapter_id": 9016, "verse_number": "१-१६-३१", "content_sanskrit": "ततस्तु ताः प्राश्य तमुत्तमस्त्रियो\n:::महीपतेरुत्तमपायसं पृथक् ।\nहुताशनादित्यसमानतेजसो-\n:::ऽचिरेण गर्भान् प्रतिपेदिरे तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000016032, "chapter_id": 9016, "verse_number": "१-१६-३२", "content_sanskrit": "ततस्तु राजा प्रतिवीक्ष्य ताः स्त्रियः\n:::प्ररूढगर्भाः प्रतिलब्धमानसः ।\nबभूव हृष्टस्त्रिदिवे यथा हरिः\n:::सुरेन्द्रसिद्धर्षिगणाभिपूजितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000016033, "chapter_id": 9016, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे षोडशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]