[{"id": 7006379000, "chapter_id": 26379, "verse_number": "२-३६-१", "content_sanskrit": "वैशम्पायन उवाच\nततो युद्धानि वृष्णीनां बभूवुः सुमहान्त्यथ ।\nमागधस्य महामात्रैर्नृपैश्चैवानुयायिभिः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006379001, "chapter_id": 26379, "verse_number": "२-३६-२", "content_sanskrit": "रुक्मिणा वासुदेवस्य भीष्मकेणाहुकस्य च।\nक्रथेन वसुदेवस्य कैशिकस्य तु बभ्रुणा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006379002, "chapter_id": 26379, "verse_number": "२-३६-३", "content_sanskrit": "गदेन चेदिराजस्य दन्तवक्त्रस्य शङ्कुना ।\nतथान्यैर्वृष्णिवीराणां नृपाणां च महात्मनाम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006379003, "chapter_id": 26379, "verse_number": "२-३६-४", "content_sanskrit": "युद्धमासीद्धि सैन्यानां सैनिकैर्भरतर्षभ ।\nअहानि पञ्च चैकं च षट् सप्ताष्टौ च दारुणम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006379004, "chapter_id": 26379, "verse_number": "२-३६-५", "content_sanskrit": "गजैर्गजा हयैरश्वाः पदाताश्च पदातिभिः ।\nरथै रथा विमिश्राश्च योधा युयुधिरे नृप ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006379005, "chapter_id": 26379, "verse_number": "२-३६-६", "content_sanskrit": "जरासंधस्य नृपते रामेणासीत् समागमः ।\nमहेन्द्रस्येव वृत्रेण दारुणो रोमहर्षणः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006379006, "chapter_id": 26379, "verse_number": "२-३६-७", "content_sanskrit": "अवेक्ष्य रुक्मिणीं कृष्णो रुक्मिणं न व्यपोथयत् ।\nज्वलनार्कांशुसंकाशानाशीविषविषोपमान् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006379007, "chapter_id": 26379, "verse_number": "२-३६-८", "content_sanskrit": "वारयामास कृष्णो वै शरांस्तस्य तु शिक्षया ।\nइत्येषां सुमहानासीद् बलौघानां परिक्षयः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006379008, "chapter_id": 26379, "verse_number": "२-३६-९", "content_sanskrit": "उभयोः सेनयो राजन् मांसशोणितकर्दमः ।\nकबन्धानि समुत्तस्थुः सुबहूनि समन्ततः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006379009, "chapter_id": 26379, "verse_number": "२-३६-१०", "content_sanskrit": "तस्मिन् विमर्दे योधानां संख्यावृत्तिकराणि च ।\nरथी रामो जरासंधं शरैराशीविषोपमैः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006379010, "chapter_id": 26379, "verse_number": "२-३६-११", "content_sanskrit": "आवृण्वन्नभ्ययाद् वीरस्तं च राजा स मागधः ।\nअभ्यवर्तत वेगेन स्यन्दनेनाशुगामिना ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006379011, "chapter_id": 26379, "verse_number": "२-३६-१२", "content_sanskrit": "अन्योन्यं विविधैरस्त्रैविद्ध्वा विद्ध्वा विनेदतुः ।\nतौ क्षीणशस्त्रौ विरथौ हताश्वौ हतसारथी ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006379012, "chapter_id": 26379, "verse_number": "२-३६-१३", "content_sanskrit": "गदे गृहीत्वा विक्रान्तावन्योन्यमभिधावताम् ।\nकम्पयन्तौ भुवं वीरौ तावुद्यतगदावुभौ ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006379013, "chapter_id": 26379, "verse_number": "२-३६-१४", "content_sanskrit": "ददृशाते महात्मानौ गिरी सशिखराविव ।\nव्युपारमन्त युद्धानि पश्यता तौ महाभुजौ ।\nसंरब्धावभिधावन्तौ गदायुद्धेषु विश्रुतौ ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006379014, "chapter_id": 26379, "verse_number": "२-३६-१५", "content_sanskrit": "उभौ तौ परमाचार्यौ लोके ख्यातौ महाबलौ ।\nमत्ताविव गजौ युद्धे तावन्योन्यमयुध्यताम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006379015, "chapter_id": 26379, "verse_number": "२-३६-१६", "content_sanskrit": "ततो देवाः सगन्धर्वाः सिद्धाश्च समहर्षयः ।\nसमन्ततश्चाप्सरसः समाजग्मुः सहस्रशः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006379016, "chapter_id": 26379, "verse_number": "२-३६-१७", "content_sanskrit": "तद् देवयक्षगन्धर्वमहर्षिभिरलंकृतम् ।\nशुशुभेऽभ्यधिकं राजन् दिवं ज्योतिर्गणैरिव ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006379017, "chapter_id": 26379, "verse_number": "२-३६-१८", "content_sanskrit": "अभिदुद्राव रामं तु जरासंधो महाबलः ।\nसव्यं मण्डलमाश्रित्य बलदेवस्तु दक्षिणम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006379018, "chapter_id": 26379, "verse_number": "२-३६-१९", "content_sanskrit": "प्रहरन्तौ ततोऽन्योन्यं गदायुद्धविशारदौ ।\nदन्ताभ्यामिव मातङ्गौ नादयन्तौ दिशो दश ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006379019, "chapter_id": 26379, "verse_number": "२-३६-२०", "content_sanskrit": "गदानिपातो रामस्य शुश्रुवेऽशनिनिःस्वनः ।\nजरासंधस्य च रणे पर्वतस्येव दीर्यतः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006379020, "chapter_id": 26379, "verse_number": "२-३६-२१", "content_sanskrit": "न स्म कम्पयते रामं जरासंधकरच्युता ।\nगदा गदाभृतां श्रेष्ठं विन्ध्यं गिरिमिवानिलः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006379021, "chapter_id": 26379, "verse_number": "२-३६-२२", "content_sanskrit": "रामस्य तु गदावेगं वीर्यात् स मगधेश्वरः ।\nसेहे धैर्येण महता शिक्षया च व्यपोहयत् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006379022, "chapter_id": 26379, "verse_number": "२-३६-२३", "content_sanskrit": "एवं तौ तत्र संग्रामे विचरन्तौ महाबलौ ।\nमण्डलानि विचित्राणि विचेरतुररिंदमौ ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006379023, "chapter_id": 26379, "verse_number": "२-३६-२४", "content_sanskrit": "व्यायच्छन्तौ चिरं कालं परिश्रान्तौ च तस्थतुः ।\nसमाश्वस्य मुहूर्तं तु पुनरन्योन्यमाहताम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006379024, "chapter_id": 26379, "verse_number": "२-३६-२५", "content_sanskrit": "एवं तौ योधमुख्यौ  तु समं युयुधतुश्चिरम् ।\nन च तौ युद्धवैमुख्यमुभावेव प्रजग्मतुः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006379025, "chapter_id": 26379, "verse_number": "२-३६-२६", "content_sanskrit": "अथापश्यद् गदायुद्धे विशेषं तस्य वीर्यवान् ।\nरामः क्रुद्धो गदां त्यक्त्वा जग्राह मुसलोत्तमम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006379026, "chapter_id": 26379, "verse_number": "२-३६-२७", "content_sanskrit": "तमुद्यन्तं तदा दृष्ट्वा मुसलं घोरदर्शनम् ।\nअमोघं बलदेवेन क्रुद्धेन तु महारणे ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006379027, "chapter_id": 26379, "verse_number": "२-३६-२८", "content_sanskrit": "ततोऽन्तरिक्षे वागासीत् सुस्वरा लोकसाक्षिणी ।\nउवाच बलदेवं तं समुद्यतहलायुधम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006379028, "chapter_id": 26379, "verse_number": "२-३६-२९", "content_sanskrit": "न त्वया राम वध्योऽयमलं सेदेन मानद ।\nविदितोऽस्य मया मृत्युस्तस्मात्साधु व्युपारम ।\nअचिरेणैव कालेन प्राणांस्त्यक्ष्यति मागधः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006379029, "chapter_id": 26379, "verse_number": "२-३६-३०", "content_sanskrit": "जरासंधस्तु तच्छ्रुत्वा विमनाः समपद्यत ।\nन प्रजह्रे ततस्तस्मै पुनरेव हलायुधः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006379030, "chapter_id": 26379, "verse_number": "२-३६-३१", "content_sanskrit": "तौ व्युपारमतां युद्धे वृष्णयस्ते च पार्थिवाः ।\nअसक्तमभवद् युद्धं तेषामेवं सुदारुणम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006379031, "chapter_id": 26379, "verse_number": "२-३६-३२", "content_sanskrit": "दीर्घकालं महाराज निघ्नतामितरेतरम् ।\nपराजिते त्वपक्रान्ते जरासंधे महीपतौ ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006379032, "chapter_id": 26379, "verse_number": "२-३६-३३", "content_sanskrit": "अस्तं याते दिनकरे नानुसस्रुस्तदा निशि ।\nसमानीय स्वकं सैन्यं लब्धलक्ष्या महाबलाः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006379033, "chapter_id": 26379, "verse_number": "२-३६-३४", "content_sanskrit": "पुरीं प्रविविशुर्हृष्टाः केशवेनाभिपालिताः ।\nखाच्च्युतान्यायुधान्येवं तान्येवान्तर्दधुस्तदा ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006379034, "chapter_id": 26379, "verse_number": "२-३६-३५", "content_sanskrit": "जरासंधोऽपि नृपतिर्बिमनाः स्वपुरीं ययौ ।\nराजानश्चानुगा येऽस्य स्वराष्ट्राण्येव ते ययुः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006379035, "chapter_id": 26379, "verse_number": "२-३६-३६", "content_sanskrit": "जरासंधं तु ते जित्वा मेनिरे नैव निर्जितम् ।\nवृष्णयः कुरुशार्दूल राजा ह्यतिबलः स वै ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006379036, "chapter_id": 26379, "verse_number": "२-३६-३७", "content_sanskrit": "दश चाष्टौ च संग्रामाञ्जरासन्धस्य यादवाः ।\nददुर्न चैनं समरे हन्तुं शेकुर्महाबलाः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006379037, "chapter_id": 26379, "verse_number": "२-३६-३८", "content_sanskrit": "अक्षौहिण्यश्च तस्यासन् विंशतिश्च महामते ।\nजरासन्धस्य नृपतेस्तदर्थं याः समागताः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006379038, "chapter_id": 26379, "verse_number": "२-३६-३९", "content_sanskrit": "अल्पत्वादभिभूतास्तु वृष्णयो भरतर्षभ ।\nबार्हद्रथेन राजेन्द्र राजभिः सहितेन वै ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006379039, "chapter_id": 26379, "verse_number": "२-३६-४०", "content_sanskrit": "जित्वा तु मागधं संख्ये जरासन्धं महीपतिम् ।\nविहरन्ति स्म सुखिनो वृष्णिसिंहा महारथाः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]