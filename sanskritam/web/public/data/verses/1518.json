[{"id": 2024156, "chapter_id": 1518, "verse_number": "३-१५६-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2024157, "chapter_id": 1518, "verse_number": "३-१५६-१", "content_sanskrit": "ततस्तानि महार्हाणि दिव्यानि भरतर्षभ।\nबहूनि बहुरूपाणि विरजांसि समाददे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2024158, "chapter_id": 1518, "verse_number": "३-१५६-२", "content_sanskrit": "ततो वायुर्महाञ्शीघ्रो नीचैः शर्करकर्षणः।\nप्रादुरासीद्वरस्पर्शः संग्राममभिचोदयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2024159, "chapter_id": 1518, "verse_number": "३-१५६-३", "content_sanskrit": "पपात महती चोल्का सनिर्घाता महाभया।\nनिष्प्रभश्चाभवत्सूर्यंश्छन्नरश्मिस्तमोवृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2024160, "chapter_id": 1518, "verse_number": "३-१५६-४", "content_sanskrit": "निर्घातश्चाभवद्भीमो भीमे विक्रममास्थिते।\nचचाल पृथिवी चापि पांसुवर्षं पपात च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2024161, "chapter_id": 1518, "verse_number": "३-१५६-५", "content_sanskrit": "सलोहिता दिशश्चासन्खरवाचो मृगद्विजाः।\nतमोवृतमभूत्सर्वं न प्राज्ञायत किंचन।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2024162, "chapter_id": 1518, "verse_number": "३-१५६-६", "content_sanskrit": "[अन्ये च बहवो भीमा उत्पातास्तत्र जज्ञिरे ॥]\nतदद्भुतमभिप्रेक्ष्य धर्मपुत्रो युधिष्ठिरः।\nउवाच वदतां श्रेष्ठः कोऽस्मानभिभविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2024163, "chapter_id": 1518, "verse_number": "३-१५६-७", "content_sanskrit": "सज्जीभवत भद्रं वः पाण्डवा युद्धदुर्मदाः।\nयथा रूपाणि पश्यामि सुव्यक्तो नः पराक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2024164, "chapter_id": 1518, "verse_number": "३-१५६-८", "content_sanskrit": "एवमुक्त्वा ततो राजा वीक्षांचक्रे समन्ततः।\nअपश्यमानो भीमं तु धर्मपुत्रो युधिष्ठिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2024165, "chapter_id": 1518, "verse_number": "३-१५६-९", "content_sanskrit": "ततः कृष्णां यमौ चापि समीपस्थानरिंदमः।\nपप्रच्छ भ्रातरं भीमं भीमकर्माणमाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2024166, "chapter_id": 1518, "verse_number": "३-१५६-१०", "content_sanskrit": "कच्चिन्न भीमः पाञ्चालि किंच कृत्यं चिकीर्षति।\nकृतवानपि वा वीर साहसं साहसप्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2024167, "chapter_id": 1518, "verse_number": "३-१५६-११", "content_sanskrit": "इमे ह्यकस्मादुत्पाता महासमरशंसिनः।\nदर्शयन्तो भयं तीव्रं प्रादुर्भूताः समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2024168, "chapter_id": 1518, "verse_number": "३-१५६-१२", "content_sanskrit": "तं तथावादिनं कृष्णा प्रत्युवाच मनस्विनी।\nप्रिया प्रियं चिकीर्षन्ती महिषी चारुहासिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2024169, "chapter_id": 1518, "verse_number": "३-१५६-१३", "content_sanskrit": "यत्तत्सौगन्धिकं राजन्नाहृतं मातरिश्वना।\nतन्मया भीमसेनस्य प्रीतयाऽद्योपपादितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2024170, "chapter_id": 1518, "verse_number": "३-१५६-१४", "content_sanskrit": "अपि चोक्तो मया वीरो यदिपश्येर्बहून्यपि।\nतानि सर्वाणअयुपादाय शीघ्रमागम्यतामिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2024171, "chapter_id": 1518, "verse_number": "३-१५६-१५", "content_sanskrit": "स तु नूनं महाबाहुः प्रियार्थं मम पाण्डवः।\nप्रागुदीचीं दिशं राजंस्तान्याहर्तुमितो गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2024172, "chapter_id": 1518, "verse_number": "३-१५६-१६", "content_sanskrit": "उक्तस्त्वेवं तया राजा यमाविदमथाब्रवीत्।\nगच्छाम सहितास्तूर्णं येन यातो वृकोदरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2024173, "chapter_id": 1518, "verse_number": "३-१५६-१७", "content_sanskrit": "वहन्तु राक्षसा विप्रान्यथाश्रान्तान्यथाकृशान्।\nत्वमप्यमरसंकाश वह कृष्णां घटोत्कच ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2024174, "chapter_id": 1518, "verse_number": "३-१५६-१८", "content_sanskrit": "व्यक्तं दूरमितो भीमः प्रविष्ट इतिमे मतिः।\nचिरं चतस्य कालोऽयं स च वायुसमो जवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2024175, "chapter_id": 1518, "verse_number": "३-१५६-१९", "content_sanskrit": "तरस्वी वैनतेयस्य सदृशो भुवि लङ्घने।\nउत्पतेदपिचाकाशं निपतेच्चयथेच्छकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2024176, "chapter_id": 1518, "verse_number": "३-१५६-२०", "content_sanskrit": "तमन्वियाम भवतां प्रभावाद्रजनीचराः।\nपुरा स नापराध्नोति सिद्धानां ब्रह्मवादिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2024177, "chapter_id": 1518, "verse_number": "३-१५६-२१", "content_sanskrit": "तथेत्युक्त्वा तु ते सर्वेहैडिम्बप्रमुखास्तदा।\nउद्देशज्ञाः कुबेरस्य नलिन्या भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2024178, "chapter_id": 1518, "verse_number": "३-१५६-२२", "content_sanskrit": "आदाय पाण्डवांश्चैव तांश्च विप्राननेकशः।\nलोमशेनैव सहिताः प्रययुः प्रीतमानसाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2024179, "chapter_id": 1518, "verse_number": "३-१५६-२३", "content_sanskrit": "ते सर्वे त्वरिता गत्वा ददृशुस्तत्र कानने।\nपद्मसौगन्धिकवतींनलिनीं सुमनोरमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2024180, "chapter_id": 1518, "verse_number": "३-१५६-२४", "content_sanskrit": "तं च भीमं महात्मानं तस्यास्तीरे व्यवस्थितम्।\nददृशुर्निहतांश्चैव यक्षांश्च विपुलेक्षणान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2024181, "chapter_id": 1518, "verse_number": "३-१५६-२५", "content_sanskrit": "भिन्नकायाक्षिबाहूरुन्संचूर्णितशिरोधरान्।\nतं च भीमं महात्मानं तस्यास्तीरे व्यवस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2024182, "chapter_id": 1518, "verse_number": "३-१५६-२६", "content_sanskrit": "सक्रोधं स्तव्धनयनं संदष्टदशनच्छदम्।\nउद्यम्य च गदां दोर्भ्यां नदीतीरे व्यवस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2024183, "chapter_id": 1518, "verse_number": "३-१५६-२७", "content_sanskrit": "प्रजासंक्षेपसमये दण्डहस्तमिवान्तकम्।\nतं दृष्ट्वा धर्मराजस्तु परिष्वज्याथ भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2024184, "chapter_id": 1518, "verse_number": "३-१५६-२८", "content_sanskrit": "उवाच श्लक्ष्णया वाचा कौन्तेय किमिदं कृतम्।\nसाहसं वत भद्रं ते देवानामपि चाप्रियम्।\nपुनरेवं न कर्तव्यं मम चेदिच्छसि प्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2024185, "chapter_id": 1518, "verse_number": "३-१५६-२९", "content_sanskrit": "अनुशिष्य तु कौन्तेयं पद्मानि परिगृह्य च।\nतस्यामेव नलिन्यां तु विजह्ररमरोपमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2024186, "chapter_id": 1518, "verse_number": "३-१५६-३०", "content_sanskrit": "एतस्मिन्नैव काले तु प्रगृहीतशिलायुधाः।\nप्रादुरासन्महाकायास्तस्योद्यानस्य रक्षिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2024187, "chapter_id": 1518, "verse_number": "३-१५६-३१", "content_sanskrit": "ते दृष्ट्वाधर्मराजानं महर्षिं चापि लोमशम्।\nनकुलं सहदेवं च तथाऽन्यान्ब्राह्मणर्षभान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2024188, "chapter_id": 1518, "verse_number": "३-१५६-३२", "content_sanskrit": "विनयेन नताः सर्वेप्रणिपत्य च भारत।\nसान्त्विता धर्मराजेन प्रसेदुः क्षणदाचराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2024189, "chapter_id": 1518, "verse_number": "३-१५६-३३", "content_sanskrit": "विदिताश्चकुबेरस्य तत्रते कुरुपुङ्गवाः।\nऊषुर्नातिचिरं कालं रममाणाः कुरूद्वहाः।\nप्रतीक्षमाणआ बीभत्सुं गन्धमादनसानुषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2024190, "chapter_id": 1518, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्थयात्रापर्वणि पञ्चपञ्चाशदधिकशततमोऽष्यायः ॥ १५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]