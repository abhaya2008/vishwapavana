[{"id": 2081707, "chapter_id": 2732, "verse_number": "१२-२३७-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2081708, "chapter_id": 2732, "verse_number": "१२-२३७-१", "content_sanskrit": "प्रियः सर्वस्य लोकस्य सर्वसत्वाभिनन्दितः।\nगुणैः तर्पैरुपेतश्च कोन्वस्ति भुवि मानवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2081709, "chapter_id": 2732, "verse_number": "१२-२३७-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2081710, "chapter_id": 2732, "verse_number": "१२-२३७-२", "content_sanskrit": "अत्र ते वर्तयिष्यामि पृच्छतो भरतर्षभ।\nउग्रसेनस्य संवादं नारदे केशवस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2081711, "chapter_id": 2732, "verse_number": "१२-२३७-३x", "content_sanskrit": "उग्रसेन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2081712, "chapter_id": 2732, "verse_number": "१२-२३७-३", "content_sanskrit": "यस्य संकल्पते लोको नारदस्य प्रकीर्तने।\nमन्ये स गुणसंपन्नो ब्रूहि तन्मम पृच्छतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2081713, "chapter_id": 2732, "verse_number": "१२-२३७-४x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2081714, "chapter_id": 2732, "verse_number": "१२-२३७-४", "content_sanskrit": "कुकुराधिप यान्मन्ये शृणु तान्मे विवक्षतः।\nनारदस्य गुणान्साधून्संक्षेपेण नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2081715, "chapter_id": 2732, "verse_number": "१२-२३७-५", "content_sanskrit": "न चारित्रनिमित्तोऽस्याहंकारो देहपातनः।\nअभिन्नश्रुतचारित्रस्तस्मात्सर्वत्र पूजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2081716, "chapter_id": 2732, "verse_number": "१२-२३७-६", "content_sanskrit": "अरतिः क्रोधचापल्ये भयं नैतानि नारदे॥\nअदीर्घसूत्रः शूरश्च तस्मात्सर्वत्र पूजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2081717, "chapter_id": 2732, "verse_number": "१२-२३७-७", "content_sanskrit": "उपास्यो नारदो बाढं वाचि नास्य व्यतिक्रमः।\nकामतो यदि वा लोभात्तस्मात्सर्वत्र पूजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2081718, "chapter_id": 2732, "verse_number": "१२-२३७-८", "content_sanskrit": "अध्यात्मविधितत्त्वज्ञः क्षान्तः शक्तो जितेन्द्रियः।\nऋजुश्च सत्यवादी च तस्मात्सर्वत्र पूजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2081719, "chapter_id": 2732, "verse_number": "१२-२३७-९", "content_sanskrit": "तेजसा यशसा बुद्ध्या ज्ञानेन विनयेन च।\nजन्मना तपसा वृद्धस्तस्मात्सर्वत्र पूजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2081720, "chapter_id": 2732, "verse_number": "१२-२३७-१०", "content_sanskrit": "सुशीलः सुखसंवेशः सुभोजः स्वादरः शुचिः।\nसुवाक्यश्चाप्यनीर्ष्यश्च तस्मात्सर्वत्र पूजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2081721, "chapter_id": 2732, "verse_number": "१२-२३७-११", "content_sanskrit": "कल्याणं कुरुते बाढं पापमस्मिन्न विद्यते।\nन प्रीयते परानर्थैस्तस्मात्सर्वत्र पूजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2081722, "chapter_id": 2732, "verse_number": "१२-२३७-१२", "content_sanskrit": "वेदश्रूतिभिराख्यानैरर्थानभिजिगीषति।\nतितिक्षुरनवज्ञश्च तस्मात्सर्वत्र पूजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2081723, "chapter_id": 2732, "verse_number": "१२-२३७-१३", "content_sanskrit": "समत्वाच्च प्रियो नास्ति नाप्रियश्च कथंचन।\nमनोऽनुकूलवादी च तस्मात्सर्वत्र पूजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2081724, "chapter_id": 2732, "verse_number": "१२-२३७-१४", "content_sanskrit": "बहुश्रुतश्चित्रकथः पण्डितोऽनलसोऽशठः।\nअदीनोऽक्रोधनोऽलुब्धस्तस्मात्सर्वत्र पूजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2081725, "chapter_id": 2732, "verse_number": "१२-२३७-१५", "content_sanskrit": "नार्थे धने वा कामे वा भूतपूर्वोऽस्य विग्रहः।\nदोषाश्चास्य समुच्छिन्नास्तस्मात्सर्वत्र पूजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2081726, "chapter_id": 2732, "verse_number": "१२-२३७-१६", "content_sanskrit": "दृढभक्तिरनिन्द्यात्मा श्रुतवाननृशंसवान्।\nवीतसंमोहदोषश्च तस्मात्सर्वत्र पूजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2081727, "chapter_id": 2732, "verse_number": "१२-२३७-१७", "content_sanskrit": "असक्तः सर्वसङ्गेषु सक्तात्मेव च लक्ष्यते।\nअदीर्घसंशयो वाग्मी तस्मात्सर्वत्र पूजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2081728, "chapter_id": 2732, "verse_number": "१२-२३७-१८", "content_sanskrit": "समाधिर्नास्य कामार्थै नात्मानं स्तौति कर्हिचित्।\nअनीर्षुर्मृदुसंवादस्तस्मात्सर्वत्र पूजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2081729, "chapter_id": 2732, "verse_number": "१२-२३७-१९", "content_sanskrit": "`नाहंकारे मुक्तिरस्य चारित्रे बुद्धिरास्थिता।\nवेदार्थविद्विभागेन यज्ञविद्योगवित्कविः।\nभक्तिमान्य सदा विद्वांस्तस्मात्सर्वत्र पूजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2081730, "chapter_id": 2732, "verse_number": "१२-२३७-२०", "content_sanskrit": "त्रिगुणं गुणभोक्तारं पञ्चयज्ञात्मकं तथा।\nयथावत्स विजानाति तस्मात्सर्वत्र पूजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2081731, "chapter_id": 2732, "verse_number": "१२-२३७-२१", "content_sanskrit": "कल्याणं कुरुते बाढं पापमस्मिन्न विद्यते।\nन प्रीयते परानर्थैस्तस्मात्सर्वत्र पूज्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2081732, "chapter_id": 2732, "verse_number": "१२-२३७-२२", "content_sanskrit": "लोकस्य विविधं चित्तं प्रेक्षते चाप्यकुत्सयन्।\nसंसर्गविद्याकुशलस्तस्मात्सर्वत्र पूजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2081733, "chapter_id": 2732, "verse_number": "१२-२३७-२३", "content_sanskrit": "नासूयत्यागमं कंचित्स्वनयेनोपजीवति।\nअबन्ध्यकालोऽवश्यात्मा तस्मात्सर्वत्र पूजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2081734, "chapter_id": 2732, "verse_number": "१२-२३७-२४", "content_sanskrit": "कृतश्रमः कृतप्रज्ञो न च तृप्तः समाधितः।\nनित्ययुक्तोऽप्रमत्तश्च तस्मात्सर्वत्र पूजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2081735, "chapter_id": 2732, "verse_number": "१२-२३७-२५", "content_sanskrit": "नापत्रपश्च युक्तश्च नियुक्तः श्रेयसे परैः।\nअभेत्ता परगुह्यानां तस्मात्सर्वत्र पूजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2081736, "chapter_id": 2732, "verse_number": "१२-२३७-२६", "content_sanskrit": "न हृष्यत्यर्थलाभेषु नालाभे तु व्यथत्यपि।\nस्थिरबुद्धिरसक्तात्मा तस्मात्सर्वत्र पूजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2081737, "chapter_id": 2732, "verse_number": "१२-२३७-२७", "content_sanskrit": "तं सर्वगुणसंपन्नं दक्षं शुचिमनामयम्।\nकालज्ञं च प्रियज्ञं च कः प्रियं न करिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2081738, "chapter_id": 2732, "verse_number": "१२-२३७-२८", "content_sanskrit": "`इत्युक्तः संप्रशस्यैनमुग्रसेनो गतो गृहात्।\nआस्ते कृष्णस्तथैकान्ते पर्यङ्के रत्नभूषिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2081739, "chapter_id": 2732, "verse_number": "१२-२३७-२९", "content_sanskrit": "कदाचित्तत्र भगवान्प्रविवेश महामुनिः।\nतमभ्यर्च्य यथान्यायं तूष्णीमास्ते जनार्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2081740, "chapter_id": 2732, "verse_number": "१२-२३७-३०", "content_sanskrit": "तं खिन्नमिव संलक्ष्य केशवं वाक्यमब्रवीत्।\nकिमिदं केशव तव वैमनस्यं जनार्दन।\nअभूतपूर्वं गोविन्द तन्मे व्याख्यातुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2081741, "chapter_id": 2732, "verse_number": "१२-२३७-३१x", "content_sanskrit": "श्रीवासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2081742, "chapter_id": 2732, "verse_number": "१२-२३७-३१", "content_sanskrit": "नासुहृत्परमं मेऽद्य नापदोऽर्हति वेदितुम्।\nअपण्डितो वापि सुहृत्पण्डितो वाऽप्यनात्मवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2081743, "chapter_id": 2732, "verse_number": "१२-२३७-३२", "content_sanskrit": "स त्वं सुहृच्च विद्वांश्च जितात्मा श्रोतुमर्हसि।\nअप्येतद्धृदि यद्दुःखं तद्भवाञ्श्रोतुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2081744, "chapter_id": 2732, "verse_number": "१२-२३७-३३", "content_sanskrit": "दास्यमैश्वर्यवादेन ज्ञातीनां च करोम्यहम्।\nद्विषन्ति सततं क्रुद्धा ज्ञातिसंबन्धिवान्धवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2081745, "chapter_id": 2732, "verse_number": "१२-२३७-३४", "content_sanskrit": "दिव्या अपि तथा भोगा दत्तास्तेषां मया पृथक्।\nतथाऽपि च द्विषन्तो मां वर्तन्ते च परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2081746, "chapter_id": 2732, "verse_number": "१२-२३७-३५x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2081747, "chapter_id": 2732, "verse_number": "१२-२३७-३५", "content_sanskrit": "अनायसेन शस्त्रेण परिमृज्यानुमृज्य च।\nजिह्वामुद्धर चैतेषां न वक्ष्यन्ति ततः परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2081748, "chapter_id": 2732, "verse_number": "१२-२३७-३६x", "content_sanskrit": "भगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2081749, "chapter_id": 2732, "verse_number": "१२-२३७-३६", "content_sanskrit": "अनायसं कथं विन्द्यां शस्त्रं मुनिवरोत्तम।\nयेनषामुद्धरे जिह्वां ब्रूहि तन्मे यथातथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2081750, "chapter_id": 2732, "verse_number": "१२-२३७-३७x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2081751, "chapter_id": 2732, "verse_number": "१२-२३७-३७", "content_sanskrit": "गोहिरण्यं च वासांसि रत्नाद्यं यद्धनं बहु।\nआस्ये प्रक्षिप चैतेषां शस्त्रमेतदनायसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2081752, "chapter_id": 2732, "verse_number": "१२-२३७-३८", "content_sanskrit": "सुहृत्संबन्धिमित्राणां गुरूणां स्वजनस्य च।\nआख्यातं शस्रमेतद्धि तेन च्छिन्धि पुनः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2081753, "chapter_id": 2732, "verse_number": "१२-२३७-३९", "content_sanskrit": "तवैश्वर्यप्रदानानि श्लाध्यमेषां वचांसि च।\nसमर्थं त्वामभिज्ञाय प्रवदन्ति च ते नराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2081754, "chapter_id": 2732, "verse_number": "१२-२३७-४०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2081755, "chapter_id": 2732, "verse_number": "१२-२३७-४०", "content_sanskrit": "ततः प्रहस्य भगवान्संपूज्य च महामुनिम्।\nतथाऽकरोन्महातेजा मुनिवाक्येन चोदितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2081756, "chapter_id": 2732, "verse_number": "१२-२३७-४१", "content_sanskrit": "एवंप्रभावो ब्रह्मर्षिर्नारदो मुनिसत्तमः।\nपृष्टवानसि यन्मां त्वं तदुक्तं राजसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2081757, "chapter_id": 2732, "verse_number": "१२-२३७-४२", "content_sanskrit": "सर्वधर्महिते युक्ताः सत्यधर्मपरायणाः।\nलोकप्रियत्वं गच्छन्ति ज्ञानविज्ञानकोविदाः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2081758, "chapter_id": 2732, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि सप्तत्रिंशदधिकद्विशततमोऽध्यायः॥ २३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]