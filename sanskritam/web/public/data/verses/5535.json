[{"id": 2212745, "chapter_id": 5535, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2212746, "chapter_id": 5535, "verse_number": "१", "content_sanskrit": "मण्डलानि च बुद्ध्येथाः परेषामात्मनस्तथा ।\nउदासीनगुणानां च मध्यमानां तथैव च\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2212747, "chapter_id": 5535, "verse_number": "२", "content_sanskrit": "चतुर्णां शत्रुजातानां सर्वेषामाततायिनाम् ।\nमित्रं चामित्रमित्रं च बोद्धव्यं शत्रुकर्शन\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2212748, "chapter_id": 5535, "verse_number": "३", "content_sanskrit": "तथाऽमात्या जनपदा दुर्गाणि विविधानि च ।\nकुरुश्रेष्ठ भवन्त्येषां यथादेशं यथास्वकम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2212749, "chapter_id": 5535, "verse_number": "४", "content_sanskrit": "पञ्च द्वादश कौन्तेय राजानो विविधात्मकाः ।\nमन्त्रिप्रधानाश्च गुणाः षट् च द्वादश च स्मृताः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2212750, "chapter_id": 5535, "verse_number": "५", "content_sanskrit": "एतन्मण्डलमित्याहुराचार्या नीतिकोविदाः ।\nअत्र षाड्गुण्यमायत्तं युधिष्ठिर निबोध तत्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2212751, "chapter_id": 5535, "verse_number": "६", "content_sanskrit": "वृद्धिक्षयौ च विज्ञेयौ स्थानं च कुरुनन्दन ।\nद्विसप्तत्यां महाबाहो ततः षाड्गुण्यचारणा\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2212752, "chapter_id": 5535, "verse_number": "७", "content_sanskrit": "यथा स्वपक्षो बलवान् परपक्षस्तथाऽवरः ।\nविगृह्य शत्रून् कौन्तेय यायात् क्षितिपतिस्तदा\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2212753, "chapter_id": 5535, "verse_number": "८", "content_sanskrit": "यदा स्वपक्षस्त्ववरः तदा सन्धिं समाश्रयेः ।\nद्रव्याणां सञ्चये चैव यत्नः कार्यस्तदा भवेत्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2212754, "chapter_id": 5535, "verse_number": "९", "content_sanskrit": "यदा समर्थो यानाय नचिरेण च भारत ।\nतदा सर्वं विधातव्यं स्थाने चैव विधायकः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2212755, "chapter_id": 5535, "verse_number": "१०", "content_sanskrit": "भूमिरल्पफला देया विपरीतस्य भारत\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2212756, "chapter_id": 5535, "verse_number": "११", "content_sanskrit": "हिरण्यरूप्यभूयिष्ठममित्रं क्षीणकोशवत् ।\nविपरीतं न गृह्णीयात् स्वयं सन्धिविशारदः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2212757, "chapter_id": 5535, "verse_number": "१२", "content_sanskrit": "सख्यार्थं राजपुत्रं वा लिप्सेथा भरतर्षभ ।\nविपरीते कृते देयः पुत्रः कस्याञ्चिदापदि\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2212758, "chapter_id": 5535, "verse_number": "१३", "content_sanskrit": "तस्य प्रमोक्षे यत्नं च कुर्याः सोपायमात्मवत् ।\nप्रकृतीनां च कौन्तेय राजा दीनान् विभावयेत्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2212759, "chapter_id": 5535, "verse_number": "१४", "content_sanskrit": "क्रमेण युगपद् वृद्धं व्यसनानां बलाबलम् ।\nपीडनं स्तम्भनं चैव कोशभङ्गस्तथैव च\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2212760, "chapter_id": 5535, "verse_number": "१५", "content_sanskrit": "कार्यं यत्नेन शत्रूणां स्वराष्ट्रं रक्षता स्वयम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2212761, "chapter_id": 5535, "verse_number": "१६", "content_sanskrit": "न च हिंस्योऽभ्युपगतः सामन्तो वृद्धिमिच्छता ।\nकौन्तेय तद्धितं ते स्यात् पृथिवीं विजिगीषतः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2212762, "chapter_id": 5535, "verse_number": "१७", "content_sanskrit": "गुणाभेदेन वै योगं गच्छेथाः सह मन्त्रिभिः ।\nआत्मसात्करणे नित्यं पालनानि गृहे तथा\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2212763, "chapter_id": 5535, "verse_number": "१८", "content_sanskrit": "दुर्बलाश्चैव सततं नावष्टभ्या बलीयसा ।\nतिष्ठेथा राजशार्दूल वैतसीं वृत्तिमाश्रितः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2212764, "chapter_id": 5535, "verse_number": "१९", "content_sanskrit": "यद्येवमभियायास्त्वां बलवान् दुर्बलं नृप ।\nसामादिभिरुपायैस्तं क्रमेण विनिवर्तय\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2212765, "chapter_id": 5535, "verse_number": "२०", "content_sanskrit": "अशक्नुवंस्तु युद्धाय निष्पतेः सह मन्त्रिभिः ।\nकोशेन पौरैर्दण्डेन ये चान्ये प्रियकारिणः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2212766, "chapter_id": 5535, "verse_number": "२१", "content_sanskrit": "असम्भवे तु सर्वस्य यथा मुख्येन निष्पतेत् ।\nक्रमेणानेन मोक्षः स्याच्छरीरमपि केवलम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2212767, "chapter_id": 5535, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम्\nआश्रमवासिकपर्वणि राजनीतौ एकादशोऽध्यायः ॥११॥\nआश्रमवासपर्वणि एकादशोऽध्यायः ॥११॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]