[{"id": 6000064000, "chapter_id": 10064, "verse_number": null, "content_sanskrit": "अथ चतुस्‍त्रिंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000064001, "chapter_id": 10064, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_034/BhP_03.034.001.m4a", "display_order": 2}, {"id": 6000064002, "chapter_id": 10064, "verse_number": "३-३४-१", "content_sanskrit": "एवं निशम्य कपिलस्य वचो जनित्री सा कर्दमस्य दयिता किल देवहूतिः।\nविस्रस्तमोहपटला तमभिप्रणम्य तुष्टाव तत्त्वविषयाखिलसिद्धभूमिम्॥ ३/३४/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_034/BhP_03.034.002.m4a", "display_order": 3, "topics": [{"text": "कपिलोपदेशसमधिगतभगवज्ज्ञानया देवहूत्या कपिलस्तवनम्", "range": "१–८"}]}, {"id": 6000064003, "chapter_id": 10064, "verse_number": null, "content_sanskrit": "देवहूतिरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_034/BhP_03.034.003.m4a", "display_order": 4}, {"id": 6000064004, "chapter_id": 10064, "verse_number": "३-३४-२", "content_sanskrit": "अथाप्ययान्ते सलिले शयानं भूतेन्द्रियार्थात्ममयं वपुस्ते।\nगुणप्रवाहं सदशेषबीजं दध्यौ स्वयं यज्जठराब्जजातः॥ ३/३४/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_034/BhP_03.034.004.m4a", "display_order": 5}, {"id": 6000064005, "chapter_id": 10064, "verse_number": "३-३४-३", "content_sanskrit": "स एव विश्वस्य भवान् विधत्ते गुणप्रवाहेषु विभक्तवीर्यः।\nसर्गाद्यनीहोऽवितथाभिसन्धिरात्मेश्वरोऽतर्क्यसहस्रशक्तिः॥ ३/३४/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_034/BhP_03.034.005.m4a", "display_order": 6}, {"id": 6000064006, "chapter_id": 10064, "verse_number": "३-३४-४", "content_sanskrit": "स त्वं भृतो मे जठरेण नाथ कथं नु यस्योदर एतदासीत्।\nविश्वं युगान्ते वटपत्र एकः शेते स्म मायाशिशुरङ्घ्रिपानः॥ ३/३४/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_034/BhP_03.034.006.m4a", "display_order": 7}, {"id": 6000064007, "chapter_id": 10064, "verse_number": "३-३४-५", "content_sanskrit": "त्वं देहतन्त्रः प्रशमाय पाप्मनां निदेशभाजां च विभो विभूतये।\nयथाऽवतारास्तव सूकरादयस्तथाऽयमप्यात्मपथोपलब्धये॥ ३/३४/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_034/BhP_03.034.007.m4a", "display_order": 8}, {"id": 6000064008, "chapter_id": 10064, "verse_number": "३-३४-६", "content_sanskrit": "यन्नामधेयश्रवणानुकीर्तनाद् यत्प्रह्वणाद् यत्स्मरणादपि क्‍वचित्।\nश्वादोऽपि सद्यः सवनाय कल्पते कुतः पुनस्ते भगवन् नु दर्शनात्॥ ३/३४/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_034/BhP_03.034.008.m4a", "display_order": 9}, {"id": 6000064009, "chapter_id": 10064, "verse_number": "३-३४-७", "content_sanskrit": "अहो बत श्वपचोऽतो गरीयान् यज्जिह्वाग्रे वर्तते नाम तुभ्यम्।\nतेपुस्तपस्ते जुहुवुः सस्नुरार्याः ब्रह्मानूचुर्नाम गृणन्ति ये ते॥ ३/३४/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_034/BhP_03.034.009.m4a", "display_order": 10}, {"id": 6000064010, "chapter_id": 10064, "verse_number": "३-३४-८", "content_sanskrit": "तं त्वाऽद्धाहं ब्रह्म परं पुमांसं प्रत्यक्स्रोतस्यात्मनि संविभाव्यम्।\nस्वतेजसा ध्वस्तगुणप्रवाहं वन्दे विष्णुं कपिलं वेदगर्भम्॥ ३/३४/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_034/BhP_03.034.010.m4a", "display_order": 11}, {"id": 6000064011, "chapter_id": 10064, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_034/BhP_03.034.011.m4a", "display_order": 12}, {"id": 6000064012, "chapter_id": 10064, "verse_number": "३-३४-९", "content_sanskrit": "ईडितो भगवानेवं कपिलाख्यः परः पुमान्।\nवाचाऽविक्लवयेत्याह मातरं मातृवत्सलः॥ ३/३४/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_034/BhP_03.034.012.m4a", "display_order": 13, "topics": [{"text": "कपिलस्य निर्गमनम्", "range": "९–१२"}]}, {"id": 6000064013, "chapter_id": 10064, "verse_number": null, "content_sanskrit": "भगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_034/BhP_03.034.013.m4a", "display_order": 14}, {"id": 6000064014, "chapter_id": 10064, "verse_number": "३-३४-१०", "content_sanskrit": "मार्गेणानेन मातस्ते सुसेव्येनोदितेन मे।\nआस्थितेन परां काष्ठामचिरादवरोत्स्यसि॥ ३/३४/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_034/BhP_03.034.014.m4a", "display_order": 15}, {"id": 6000064015, "chapter_id": 10064, "verse_number": "३-३४-११", "content_sanskrit": "श्रद्धत्स्वैतन्मतं मह्यं जुष्टं यद् ब्रह्मवादिभिः।\nयेन मामभयं यायान्मृत्युमृच्छन्त्यतद्विदः॥ ३/३४/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_034/BhP_03.034.015.m4a", "display_order": 16}, {"id": 6000064016, "chapter_id": 10064, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_034/BhP_03.034.016.m4a", "display_order": 17}, {"id": 6000064017, "chapter_id": 10064, "verse_number": "३-३४-१२", "content_sanskrit": "इति प्रदर्श्य भगवानुशतीमात्मनो गतिम्।\nस्वमात्रा ब्रह्मवादिन्या कपिलोऽनुमतो ययौ॥ ३/३४/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_034/BhP_03.034.017.m4a", "display_order": 18}, {"id": 6000064018, "chapter_id": 10064, "verse_number": "३-३४-१३", "content_sanskrit": "सा चापि तनयोक्तेन योगादेशेन योगयुक्।\nतस्मिन्नाश्रम आसीना सरस्वत्याः समाहिता॥ ३/३४/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_034/BhP_03.034.018.m4a", "display_order": 19, "topics": [{"text": "देवहूत्या कपिलोपदिष्टमार्गेण भगवद्‌ध्यानपूर्वकं देहत्यागः", "range": "१३–३२"}]}, {"id": 6000064019, "chapter_id": 10064, "verse_number": "३-३४-१४", "content_sanskrit": "अभीक्ष्णावगाहकपिशान् जटिलान् कुटिलालकान्।\nआत्मानं चोग्रतपसा बिभ्रती चीरिणं कृशम्॥ ३/३४/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_034/BhP_03.034.019.m4a", "display_order": 20}, {"id": 6000064020, "chapter_id": 10064, "verse_number": "३-३४-१५", "content_sanskrit": "प्रजापतेः कर्दमस्य तपोयोगविजृम्भितम्।\nस्वगार्हस्थ्यमनौपम्यं प्रार्थ्यं वैमानिकैरपि॥ ३/३४/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_034/BhP_03.034.020.m4a", "display_order": 21}, {"id": 6000064021, "chapter_id": 10064, "verse_number": "३-३४-१६", "content_sanskrit": "पयःफेननिभाः शय्या दान्ता रुक्मपरिच्छदाः।\nआसनानि च हैमानि सुस्पर्शास्तरणानि च॥ ३/३४/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_034/BhP_03.034.021.m4a", "display_order": 22}, {"id": 6000064022, "chapter_id": 10064, "verse_number": "३-३४-१७", "content_sanskrit": "स्वच्छस्फटिककुड्येषु महामरकतेषु च।\nरत्नदीपार्चिषो भान्ति ललनारत्नसंयुताः॥ ३/३४/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_034/BhP_03.034.022.m4a", "display_order": 23}, {"id": 6000064023, "chapter_id": 10064, "verse_number": "३-३४-१८", "content_sanskrit": "गृहोद्यानं कुसुमितै रम्यं बह्वमरद्रुमैः।\nकूजद्विहङ्गमिथुनं गायन्मत्तमधुव्रतम्॥ ३/३४/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_034/BhP_03.034.023.m4a", "display_order": 24}, {"id": 6000064024, "chapter_id": 10064, "verse_number": "३-३४-१९", "content_sanskrit": "यत्र प्रविष्टमात्मानं विबुधानुचरा जगुः।\nवाप्यामुत्पलगन्धिन्यां कर्दमेनोपलालितम्॥ ३/३४/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_034/BhP_03.034.024.m4a", "display_order": 25}, {"id": 6000064025, "chapter_id": 10064, "verse_number": "३-३४-२०", "content_sanskrit": "हित्वा तदीप्सिततममप्याखण्डलयोषिताम्।\nकिञ्चिच्चकार वदनं पुत्रविश्लेषणातुरा॥ ३/३४/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_034/BhP_03.034.025.m4a", "display_order": 26}, {"id": 6000064026, "chapter_id": 10064, "verse_number": "३-३४-२१", "content_sanskrit": "वनं प्रव्रजिते पत्यावपत्यविरहातुरा।\nज्ञाततत्त्वाऽप्यभून्नष्टवत्सा गौरिव वत्सला॥ ३/३४/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_034/BhP_03.034.026.m4a", "display_order": 27}, {"id": 6000064027, "chapter_id": 10064, "verse_number": "३-३४-२२", "content_sanskrit": "तमेव ध्यायती देवमपत्यं कपिलं हरिम्।\nबभूवाविरतोत्साहा निःस्पृहा तादृशे गृहे॥ ३/३४/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_034/BhP_03.034.027.m4a", "display_order": 28}, {"id": 6000064028, "chapter_id": 10064, "verse_number": "३-३४-२३", "content_sanskrit": "ध्यायती भगवद्रूपं यदाह ध्यानगोचरम्।\nसुतं प्रसन्नवदनं समस्तव्यस्तचिन्तया॥ ३/३४/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_034/BhP_03.034.028.m4a", "display_order": 29}, {"id": 6000064029, "chapter_id": 10064, "verse_number": "३-३४-२४", "content_sanskrit": "भक्तिप्रवाहयोगेन वैराग्येण बलीयसा।\nयुक्तानुष्ठानजातेन ज्ञानेन ब्रह्महेतुना॥ ३/३४/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_034/BhP_03.034.029.m4a", "display_order": 30}, {"id": 6000064030, "chapter_id": 10064, "verse_number": "३-३४-२५", "content_sanskrit": "विशुद्धेन तदात्मानमात्मना विश्वतोमुखम्।\nस्वानुभूत्या तिरोभूतमायागुणविशेषणम्॥ ३/३४/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_034/BhP_03.034.030.m4a", "display_order": 31}, {"id": 6000064031, "chapter_id": 10064, "verse_number": "३-३४-२६", "content_sanskrit": "ब्रह्मण्यवस्थितमतिर्भगवत्यात्मसंश्रये।\nनिवृत्तजीवोपाधित्वाद् वीतक्लेशाऽऽप्तनिर्वृतिः॥ ३/३४/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_034/BhP_03.034.031.m4a", "display_order": 32}, {"id": 6000064032, "chapter_id": 10064, "verse_number": "३-३४-२७", "content_sanskrit": "नित्यरूढसमाधित्वात् परावृत्तगुणभ्रमा।\nन सस्मार तदाऽऽत्मानं स्वप्नदृष्टमिवोत्थितः॥ ३/३४/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_034/BhP_03.034.032.m4a", "display_order": 33}, {"id": 6000064033, "chapter_id": 10064, "verse_number": "३-३४-२८", "content_sanskrit": "तद्देहः परतः पोष्योऽप्यकृशश्चाध्यसम्भवात्।\nबभौ मलैरवच्छन्नः सधूम इव पावकः॥ ३/३४/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_034/BhP_03.034.033.m4a", "display_order": 34}, {"id": 6000064034, "chapter_id": 10064, "verse_number": "३-३४-२९", "content_sanskrit": "स्वाङ्गं तपोयोगमयं मुक्तकेशं गताम्बरम्।\nदैवगुप्तं न बुबुधे वासुदेवप्रविष्टधीः॥ ३/३४/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_034/BhP_03.034.034.m4a", "display_order": 35}, {"id": 6000064035, "chapter_id": 10064, "verse_number": "३-३४-३०", "content_sanskrit": "एवं सा कपिलोक्तेन मार्गेणाविरहं परम्।\nआत्मानं ब्रह्म निर्वाणं भगवन्तमवाप ह॥ ३/३४/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_034/BhP_03.034.035.m4a", "display_order": 36}, {"id": 6000064036, "chapter_id": 10064, "verse_number": "३-३४-३१", "content_sanskrit": "तद् वीरासीत् पुण्यतमं क्षेत्रं त्रैलोक्यविश्रुतम्।\nनाम्ना सिद्धपदं यत्र सा संसिद्धिमुपेयुषी॥ ३/३४/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_034/BhP_03.034.036.m4a", "display_order": 37}, {"id": 6000064037, "chapter_id": 10064, "verse_number": "३-३४-३२", "content_sanskrit": "तस्यास्तद् योगविधुतमाशु मर्त्यमभूत् सरित्।\nस्रोतसां प्रवरा सौम्य सिद्धिदा सिद्धसेविता॥ ३/३४/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_034/BhP_03.034.037.m4a", "display_order": 38}, {"id": 6000064038, "chapter_id": 10064, "verse_number": "३-३४-३३", "content_sanskrit": "कपिलोऽपि महायोगी भगवान् पितुराश्रमात्।\nमातरं समनुज्ञाप्य प्रागुदीचीं दिशं ययौ॥ ३/३४/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_034/BhP_03.034.038.m4a", "display_order": 39, "topics": [{"text": "कपिलेन उदीचीं दिशमेत्य सुखविहरणम्", "range": "३३–३७"}]}, {"id": 6000064039, "chapter_id": 10064, "verse_number": "३-३४-३४", "content_sanskrit": "सिद्धचारणगन्धर्वैर्मुनिभिश्चाप्सरोगणैः।\nस्तूयमानः समुद्रेण दत्तार्हणनिकेतनः॥ ३/३४/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_034/BhP_03.034.039.m4a", "display_order": 40}, {"id": 6000064040, "chapter_id": 10064, "verse_number": "३-३४-३५", "content_sanskrit": "आस्ते योगं समास्थाय साङ्ख्याचार्यैरभिष्टुतः। सिद्धगन्धर्वमुख्यैश्च देवैश्चापि प्रपूजितः।\nत्रयाणामपि लोकानामुपशान्त्यै समाहितः॥ ३/३४/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_034/BhP_03.034.040.m4a", "display_order": 41}, {"id": 6000064041, "chapter_id": 10064, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_034/BhP_03.034.041.m4a", "display_order": 42}, {"id": 6000064042, "chapter_id": 10064, "verse_number": "३-३४-३६", "content_sanskrit": "एतन्निगदितं तात यत् पृष्टोऽहं त्वयाऽनघ।\nकपिलस्य च संवादो देवहूत्याश्च पावनः॥ ३/३४/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_034/BhP_03.034.042.m4a", "display_order": 43}, {"id": 6000064043, "chapter_id": 10064, "verse_number": "३-३४-३७", "content_sanskrit": "य इदमनुशृणोति योऽभिधत्ते कपिलमुनेर्मतमात्मयोगगुह्यम्।\nभगवति कृतधीः सुपर्णकेतावुपलभते भगवत्पदारविन्दम्॥ ३/३४/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_034/BhP_03.034.043.m4a", "display_order": 44}, {"id": 6000064044, "chapter_id": 10064, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां तृतीयस्कन्धे चतुस्‍त्रिंशाध्यायः॥\n॥ इति तृतीयस्कन्धः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]