[{"id": 2067270, "chapter_id": 2415, "verse_number": "९-३३-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2067271, "chapter_id": 2415, "verse_number": "९-३३-१", "content_sanskrit": "एवं दुर्योधने राजन्गर्जमाने मुहुर्मुहुः।\nयुधिष्ठिरस्य सङ्क्रुद्धो वासुदेवोऽब्रवीदिदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2067272, "chapter_id": 2415, "verse_number": "९-३३-२", "content_sanskrit": "यदी नाम ह्ययं यूद्धे वरयेत्त्वां युधिष्ठिर।\nअर्जुनं नकुलं चैव सहदेवमथापि वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2067273, "chapter_id": 2415, "verse_number": "९-३३-३", "content_sanskrit": "किमिदं साहसं राजंस्त्वया व्याहृतमीदृशम्।\nएकमेव निहत्याजौ भव राजा कुरुष्विति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2067274, "chapter_id": 2415, "verse_number": "९-३३-४", "content_sanskrit": "एतेन हि कृता योग्या वर्षाणीह त्रयोदश।\nआयसे पुरुषे राजन्भीमसेनजिघांसया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2067275, "chapter_id": 2415, "verse_number": "९-३३-५", "content_sanskrit": "कथं नाम भवेत्कार्यमस्माद्वि भरतर्षभ।\nसाहसं कृतवांस्त्वं तु ह्यनुक्रोशान्नृपोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2067276, "chapter_id": 2415, "verse_number": "९-३३-६", "content_sanskrit": "नान्यमस्यानुपश्यामि प्रतियोद्धारमाहवे।\nऋते वृकोदरात्पार्थात्स च नातिकृतश्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2067277, "chapter_id": 2415, "verse_number": "९-३३-७", "content_sanskrit": "तदिदं द्यूतमारब्धं पुनरेव यथा पुरा।\nविषमं शकुनेश्चैव तव चैव विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2067278, "chapter_id": 2415, "verse_number": "९-३३-८", "content_sanskrit": "बली भीमः समर्थश्च कृती राजा सुयोधनः।\nबलवान्वा कृती वेति कृती राजन्विशिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2067279, "chapter_id": 2415, "verse_number": "९-३३-९", "content_sanskrit": "सोऽयं राजंस्त्वया शत्रुः समे पथि निवेशितः।\nन्यस्तश्चात्मा सुविषमे कृच्छ्रमापादिता वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2067280, "chapter_id": 2415, "verse_number": "९-३३-१०", "content_sanskrit": "कोऽनु सर्वान्विनिर्जित्य शत्रूनेकेन वैरिणा।\n[कृच्छ्रप्राप्तेन च तथा हारयेद्राज्यमागतम्।]\nपातितश्चैकबाणेन शोचयेदेवमाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2067281, "chapter_id": 2415, "verse_number": "९-३३-११", "content_sanskrit": "न हि पश्यामि तं लोके योऽद्य दुर्योधनं रणे।\nगदाहस्तं विजेतुं वै शक्तः स्यादमरोपि हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2067282, "chapter_id": 2415, "verse_number": "९-३३-१२", "content_sanskrit": "फल्गुनो वा भवान्वाथ माद्रीपुत्रावथापि वा।\nन समर्थानहं मन्ये गदाहस्तस्य संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2067283, "chapter_id": 2415, "verse_number": "९-३३-१३", "content_sanskrit": "न त्वं भीमो न नकुलः सहदेवोऽथ फल्गुनः।\nजेतुं न्यायेन शक्तो वै कृती राजा सुयोधनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2067284, "chapter_id": 2415, "verse_number": "९-३३-१४", "content_sanskrit": "स कथं वदसे शत्रुं युध्यस्व गदयेति हि।\nएकं च नो निहत्याजौ भव राजेति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2067285, "chapter_id": 2415, "verse_number": "९-३३-१५", "content_sanskrit": "वृकोदरं समासाद्य संशयो वै जये हि नः।\nन्यायतो युध्यमानानां कृती ह्येष महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2067286, "chapter_id": 2415, "verse_number": "९-३३-१६", "content_sanskrit": "[नूनं न राज्यभागेषा पाण्डोः कुन्त्याश्च सन्ततिः।\nअत्यन्तवनवासाय सृष्टा भैक्ष्याय वा पुनः॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2067287, "chapter_id": 2415, "verse_number": "९-३३-१७x", "content_sanskrit": "भीमसेन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2067288, "chapter_id": 2415, "verse_number": "९-३३-१७", "content_sanskrit": "मधुसूदन माकार्षीविषादं यदुनन्दन।\nअद्य पारं गमिष्यामि वैरस्य भृशदुर्गमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2067289, "chapter_id": 2415, "verse_number": "९-३३-१८", "content_sanskrit": "अहं सुयोधनं सङ्ख्ये हनिष्यामि न संशयः।\nविजयो वै ध्रुवः कृष्ण धर्मराजस्य दृश्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2067290, "chapter_id": 2415, "verse_number": "९-३३-१९", "content_sanskrit": "अध्यर्धेन गुणेनेयं गदा गुरुतरी मम।\nन तथा धार्तराष्ट्रस्य माकार्षीर्माधव व्यथाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2067291, "chapter_id": 2415, "verse_number": "९-३३-२०", "content_sanskrit": "अनया गदयानाहं संयुगे योद्धुमुत्सहे।\nभवन्तः प्रेक्षकाः सर्वे मम सन्तु जनार्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2067292, "chapter_id": 2415, "verse_number": "९-३३-२१", "content_sanskrit": "सामरानपि लोकांस्त्रीन्नानाशस्त्रधरान्युधि।\nयोधयेयं रणे कृष्ण किमुताद्य सुयोधनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2067293, "chapter_id": 2415, "verse_number": "९-३३-२२x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2067294, "chapter_id": 2415, "verse_number": "९-३३-२२", "content_sanskrit": "तथा सम्भाषमाणं तु वासुदेवो वृकोदरम्।\nहृष्टः सम्पूजयामास वचनं चेदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2067295, "chapter_id": 2415, "verse_number": "९-३३-२३", "content_sanskrit": "त्वामाश्रित्य महाबाहो धर्मराजो युधिष्ठिरः।\nनिहतारिः स्वकां दीप्तां श्रियं प्राप्नोत्यसंशयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2067296, "chapter_id": 2415, "verse_number": "९-३३-२४", "content_sanskrit": "त्वया विनिहताः सर्वे धृतराष्ट्रसुता रणे।\nराजानो राजपुत्राश्च नागाश्च विनिपातिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2067297, "chapter_id": 2415, "verse_number": "९-३३-२५", "content_sanskrit": "कलिङ्गा मागधाः प्राच्या गान्धाराः कुरवस्तथा।\nत्वामासाद्य महायुद्धे निहताः पाण्डुनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2067298, "chapter_id": 2415, "verse_number": "९-३३-२६", "content_sanskrit": "हत्वा दुर्योधनं चापि प्रयच्छोर्वीं ससागराम्।\nधर्मराजाय कौन्तेय यथा विष्णुः शचीपतेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2067299, "chapter_id": 2415, "verse_number": "९-३३-२७", "content_sanskrit": "त्वां च प्राप्य रणे पापो धार्तराष्ट्रो विनङ्क्ष्यति।\nत्वमस्य सक्थिनी भंक्त्वा प्रतिज्ञां पालयिष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2067300, "chapter_id": 2415, "verse_number": "९-३३-२८", "content_sanskrit": "यत्नेन ह त्वया पापो योद्धव्यो धृतराष्ट्रजः।\nकृती च बलवांश्चैव युद्धशौण्डश्च नित्यदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2067301, "chapter_id": 2415, "verse_number": "९-३३-२९", "content_sanskrit": "ततस्तु सात्यकी राजन्पूजयामास पाण्डवम्।\nविविधाभिश्च तं वाग्भिर्भिमसेनं जनेश्वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2067302, "chapter_id": 2415, "verse_number": "९-३३-३०", "content_sanskrit": "पाञ्चालाः पाण्डवेयाश्च धर्मराजपुरोगमाः।\nतद्वचो भीमसेनस्य सर्व एवाभ्यपूजयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2067303, "chapter_id": 2415, "verse_number": "९-३३-३१", "content_sanskrit": "ततो भीमबलो भीमो युधिष्ठिरमथाब्रवीत्।\nसृञ्जयैः सह तिष्ठन्तं तपन्तमिव भास्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2067304, "chapter_id": 2415, "verse_number": "९-३३-३२", "content_sanskrit": "अहमेतेन सङ्गम्य संयुगे योद्धुमुत्सहे।\nन हि शक्तो रणे जेतुं मामेष पुरुषाधमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2067305, "chapter_id": 2415, "verse_number": "९-३३-३३", "content_sanskrit": "अद्य क्रोधं विमोक्ष्यामि निहितं हृदये भृशम्।\nसुयोधने धार्तराष्ट्रे खाण्डवेऽग्निमिवार्जुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2067306, "chapter_id": 2415, "verse_number": "९-३३-३४", "content_sanskrit": "शल्यमद्योद्धरिष्यामि तव पाण्डव हृच्छयम्।\nनिहते गदया पापे अद्य राजन्सुखी भव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2067307, "chapter_id": 2415, "verse_number": "९-३३-३५", "content_sanskrit": "अद्य कीर्तिमयीं मालां प्रितमोक्ष्ये तवानघ।\nप्राणाञ्श्रियं च राज्यं च मोक्ष्यतेऽद्य सुयोधनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2067308, "chapter_id": 2415, "verse_number": "९-३३-३६", "content_sanskrit": "राजा च धृतराष्ट्रोऽद्य श्रुत्वा पुत्रं मया हतम्।\nस्मरिष्यत्यशुभं कर्म यत्तच्छकुनिबुद्धिजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2067309, "chapter_id": 2415, "verse_number": "९-३३-३७", "content_sanskrit": "इत्युक्त्वा भरतश्रेष्ठो गदामुद्यम्य वीर्यवान्।\nउदतिष्ठत युद्धाय शक्रो वृत्रमिवाह्वयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2067310, "chapter_id": 2415, "verse_number": "९-३३-३८", "content_sanskrit": "[तदाह्वानममृष्यन्वै तव पुत्रोऽतिवीर्यवान्।\nप्रत्युपस्थित एवाशु मत्तो मत्तमिव द्विपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2067311, "chapter_id": 2415, "verse_number": "९-३३-३९", "content_sanskrit": "गदाहस्तं तव सुतं युद्धाय समुपस्थितम्।\nददृशुः पाण्डवाः सर्वे कैलासमिव शृङ्गिणम्]॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2067312, "chapter_id": 2415, "verse_number": "९-३३-४०", "content_sanskrit": "तमेकाकिनमासाद्य धार्तराष्ट्रं महाबलम्।\nवियूथमिव मातङ्गं समहृष्यन्त पाण्डवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2067313, "chapter_id": 2415, "verse_number": "९-३३-४१", "content_sanskrit": "[न सम्भ्रमो न च भयं न च ग्लानिर्न च व्यथा।\nआसीद्दुर्योधनस्यापि स्थितः सिंह इवाहवे]॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2067314, "chapter_id": 2415, "verse_number": "९-३३-४२", "content_sanskrit": "समुद्यतगदं दृष्ट्वा कैलासमिव शृङ्गियाम्।\nभीमसेनस्तदा राजन्दुर्योधनमथाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2067315, "chapter_id": 2415, "verse_number": "९-३३-४३", "content_sanskrit": "राज्ञापि धृतराष्ट्रेण त्वया चास्मासु यत्कृतम्।\nस्मर तद्दुष्कृतं कर्मं यद्भूतं वारणावते।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2067316, "chapter_id": 2415, "verse_number": "९-३३-४४", "content_sanskrit": "द्रौपदी च परामृष्टा समामध्ये रजस्वला।\nद्यूते च वञ्चितो राजा शकूनेर्बुद्धिलाघवात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2067317, "chapter_id": 2415, "verse_number": "९-३३-४५", "content_sanskrit": "यानि चान्यानि दुष्टात्मन्पापानि कृतवानसि।\nअनागासु च पार्थेषु तस्य पश्य महत्फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2067318, "chapter_id": 2415, "verse_number": "९-३३-४६", "content_sanskrit": "त्वत्कृते निहतः शेते शरतल्पे महायशाः।\nयाङ्गेयो भरतश्रेष्ठः सर्वेषां नः पितामहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2067319, "chapter_id": 2415, "verse_number": "९-३३-४७", "content_sanskrit": "हतो द्रोणश्च कर्णश्च इतः शल्यः प्रतापवान्।\nवैराग्नेरादिकर्ता च शकुनिर्निहतो रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2067320, "chapter_id": 2415, "verse_number": "९-३३-४८", "content_sanskrit": "भ्रातरस्ते हताः शूराः पुत्राश्च सहसैनिकाः।\nराजानश्च हताः शूराः समरेष्वनिवर्तिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2067321, "chapter_id": 2415, "verse_number": "९-३३-४९", "content_sanskrit": "एते चान्ये च निहता बहवः क्षत्रियर्षभाः।\nप्रातिकामी तथा पापो द्रौपद्याः क्लेशकृद्धतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2067322, "chapter_id": 2415, "verse_number": "९-३३-५०", "content_sanskrit": "अवशिष्टस्त्वमेवैकः कुलघ्नोऽधमपूरुषः।\nत्वामप्यद्य हनिष्यामि गदया नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2067323, "chapter_id": 2415, "verse_number": "९-३३-५१", "content_sanskrit": "अद्य तेऽहं रणे दर्पं सर्वं नाशयिता नृप।\nराज्याशां विपुलां चापि पाण्डवेषु च दुष्कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2067324, "chapter_id": 2415, "verse_number": "९-३३-५२x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2067325, "chapter_id": 2415, "verse_number": "९-३३-५२", "content_sanskrit": "किं कत्थितेन बहुना युध्यस्वाद्य मया सह।\nअद्य तेऽहं विनेष्यामि युद्धश्रद्धां वृकोदर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2067326, "chapter_id": 2415, "verse_number": "९-३३-५३", "content_sanskrit": "किं न पश्यसि मां पाप गदायुद्धे व्यवस्थितम्।\nहिमवच्छिखराकारां प्रगृह्य महतीं गदाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2067327, "chapter_id": 2415, "verse_number": "९-३३-५४", "content_sanskrit": "गदिनं कोऽद्य मां पाप हन्तुमुत्सहते रिपुः।\nन्यायतो युध्यमानश्च देवेष्वपि पुरन्दरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2067328, "chapter_id": 2415, "verse_number": "९-३३-५५", "content_sanskrit": "मा वृथा गर्ज कौन्तेय शारदाभ्रमिवाजलम्।\nदर्शयस्व बलं युद्धे यावन्नासून्निहन्मि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2067329, "chapter_id": 2415, "verse_number": "९-३३-५६", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा पाण्डवाः सहसृञ्जयाः।\nसर्वे सम्पूजयामासुस्तद्वचो विजिगीषवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2067330, "chapter_id": 2415, "verse_number": "९-३३-५७", "content_sanskrit": "उन्मत्तमिव मातङ्गं तलशब्देन मानवाः।\nभूयः संहर्षयामासू राजन्दुर्योधनं द्विषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2067331, "chapter_id": 2415, "verse_number": "९-३३-५८", "content_sanskrit": "बृंहन्ति कुञ्जरास्तत्र हया हेषन्ति चासकृत्।\nशस्त्राणि सम्प्रदीप्यन्ते पाण्डवानां जयैषिणाम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2067332, "chapter_id": 2415, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शल्यपर्वणि ह्रदप्रवेशपर्वणि त्रयस्त्रिंशोऽध्यायः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}]