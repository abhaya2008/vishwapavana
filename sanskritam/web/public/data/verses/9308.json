[{"id": 40019298, "chapter_id": 9308, "verse_number": "1", "content_sanskrit": "ततोहिदुर्मनाराम्श्रुत्वैवंवदतांगिरः । दध्यौमुहूर्तंधर्मात्माबाष्पव्याकुललोचनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40019299, "chapter_id": 9308, "verse_number": "2", "content_sanskrit": "ततोवैश्रवणोराजायमश्चपितृभिःसह । सहस्राक्षश्चदेवेशोवरुणश्चजलेश्वरः ॥ षडर्धनयन्श्रीमान्महादेवोवृषध्वजः । कर्तासर्वस्यलोकस्यब्रह्माब्रह्मविदांवरः ॥ एतेसर्वेसमागम्यविमानैस्सूर्यसन्निभैः । आगम्यनगरींलङ्कामभिजग्मुश्चराघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40019300, "chapter_id": 9308, "verse_number": "3", "content_sanskrit": "ततोवैश्रवणोराजायमश्चपितृभिःसह । सहस्राक्षश्चदेवेशोवरुणश्चजलेश्वरः ॥ षडर्धनयन्श्रीमान्महादेवोवृषध्वजः । कर्तासर्वस्यलोकस्यब्रह्माब्रह्मविदांवरः ॥ एतेसर्वेसमागम्यविमानैस्सूर्यसन्निभैः । आगम्यनगरींलङ्कामभिजग्मुश्चराघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40019301, "chapter_id": 9308, "verse_number": "4", "content_sanskrit": "ततोवैश्रवणोराजायमश्चपितृभिःसह । सहस्राक्षश्चदेवेशोवरुणश्चजलेश्वरः ॥ षडर्धनयन्श्रीमान्महादेवोवृषध्वजः । कर्तासर्वस्यलोकस्यब्रह्माब्रह्मविदांवरः ॥ एतेसर्वेसमागम्यविमानैस्सूर्यसन्निभैः । आगम्यनगरींलङ्कामभिजग्मुश्चराघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40019302, "chapter_id": 9308, "verse_number": "5", "content_sanskrit": "ततःसहस्ताभरणान्प्रगृह्यविपुलान्भुजान् । अब्रुवंस्त्रिदशश्रेष्ठाराघवंप्राञ्जलिंस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40019303, "chapter_id": 9308, "verse_number": "6", "content_sanskrit": "कर्तासर्वस्यलोकस्यश्रेष्ठोज्ञानवतांप्रभुः । उपेक्षसेकथंसीतांपतन्तींहव्यवाहने ॥ कथंदेवगणश्रेष्ठमात्मानंनावबुद्ध्यसे ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40019304, "chapter_id": 9308, "verse_number": "7", "content_sanskrit": "ऋतधामावसुःपूर्वंवसूनां च प्रजापतिः ॥ त्रयाणामपिलोकानामादिकर्तास्वयंप्रभुः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40019305, "chapter_id": 9308, "verse_number": "8", "content_sanskrit": "रुद्राणामष्टमोरुद्रस्साध्यानामपिपञ्चमः ॥ अश्विनौचापिकर्णौतेसूर्यचन्द्रामसौदृशौ ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40019306, "chapter_id": 9308, "verse_number": "9", "content_sanskrit": "अन्तेचादौ च लोकानांदृश्यसे च परन्तप ॥ उपेक्षसे च वैदेहींमानुषःप्राकृतोयथा ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40019307, "chapter_id": 9308, "verse_number": "10", "content_sanskrit": "इत्युक्तोलोकपालैस्तैस्स्वामीलोकस्यराघवः ॥ अब्रवीत्त्रिदशश्रेष्ठान्रामधर्मभृतांवरः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40019308, "chapter_id": 9308, "verse_number": "11", "content_sanskrit": "आत्मानंमानुषंमन्येरामंदशरथात्मजम् ॥ सोऽहंयस्ययतश्चाहंभगववंस्तद्भ्रवीतुमे ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40019309, "chapter_id": 9308, "verse_number": "12", "content_sanskrit": "इतिब्रुवाणंकाकुत्स्थंब्रह्माब्रह्मविदांवरः ॥ अब्रवीच्छ्रुणुमेवाक्यंसत्यंसत्यपराक्रम ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40019310, "chapter_id": 9308, "verse_number": "13", "content_sanskrit": "भवान्नारायणोदेवःश्रीमांश्चक्रायुधःप्रभुः ॥ एकशृङ्गोवराहस्त्वंभूतभव्यसपत्नजित् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40019311, "chapter_id": 9308, "verse_number": "14", "content_sanskrit": "अक्षरंब्रह्मसत्यं च मध्येचान्ते च राघव ॥ लोकानांत्वंपरोधर्मोविष्वक्सेनश्चतुर्भुजः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40019312, "chapter_id": 9308, "verse_number": "15", "content_sanskrit": "शार्ङ्गधन्वाहृषीकेशःपुरुषःपुरुषोत्तमः ॥ अजितःखङ्गदृग्विष्णुःकृष्णश्चैवमहाबलः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40019313, "chapter_id": 9308, "verse_number": "16", "content_sanskrit": "सेनानीर्ग्रामणीश्चत्वंत्वंबुद्धिस्त्वंक्षमादमः ॥ प्रभवश्चाप्ययश्चत्वमुपेन्द्रोमधुसूदनः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40019314, "chapter_id": 9308, "verse_number": "17", "content_sanskrit": "इन्द्रकर्मामहेन्द्रस्त्वंपद्मनाभोरणान्तकृत् ॥ शरण्यंशरणं च त्वामाहुर्दिव्यामहर्षयः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40019315, "chapter_id": 9308, "verse_number": "18", "content_sanskrit": "सहस्रशृङ्गोवेदात्माशरशीर्षोमहर्षभः ॥ त्वंत्रयाणांहिलोकानामादिकर्तास्वयम्प्रभुः । सिद्धानामपिसाध्यानामाश्रयश्चासिपूर्वजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40019316, "chapter_id": 9308, "verse_number": "19", "content_sanskrit": "सहस्रशृङ्गोवेदात्माशरशीर्षोमहर्षभः ॥ त्वंत्रयाणांहिलोकानामादिकर्तास्वयम्प्रभुः । सिद्धानामपिसाध्यानामाश्रयश्चासिपूर्वजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40019317, "chapter_id": 9308, "verse_number": "20", "content_sanskrit": "त्वम्यज्ञस्त्वंवषटकारस्त्वमोङ्कारःपरात्परः ॥ प्रभवंनिधनंवातेनोविदुःकोभवानिति ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40019318, "chapter_id": 9308, "verse_number": "21", "content_sanskrit": "दृश्यसेसर्वभूतेषुगोषु च ब्राह्मणेषु च ॥ दिक्षुसर्वासुगगनेपर्वतेषुनदीषु च ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40019319, "chapter_id": 9308, "verse_number": "22", "content_sanskrit": "सहस्रचरण्श्रीमान् शतशीर्षस्सहस्रदृक् ॥ त्वंधारयसिभूतानिपृथिवीं च सपर्वताम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40019320, "chapter_id": 9308, "verse_number": "23", "content_sanskrit": "अन्तेपृथिव्याःसलिलेदृश्यसेत्वंमहोरगः ॥ त्रीन्लोकान्धारयन् राम देवगन्धर्वदानवान् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40019321, "chapter_id": 9308, "verse_number": "24", "content_sanskrit": "अहंतेहृदयंरामजिह्वादेवीसरस्वती ॥ देवारोमाणिगात्रेषुब्रह्मणानिर्मिताःप्रभो ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40019322, "chapter_id": 9308, "verse_number": "25", "content_sanskrit": "निमेषस्तेस्मृतारात्रिरुन्मेषोदिवसस्तथा ॥ संस्कारास्त्वभवन्वेदानैतदस्तित्वयाविना ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40019323, "chapter_id": 9308, "verse_number": "26", "content_sanskrit": "जगत्सर्वंशरीरंतेस्थैर्यंतेवसुथातलम् ॥ अग्निःकोपःप्रसादस्तेसोम्श्रीवत्सलक्षणः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40019324, "chapter_id": 9308, "verse_number": "27", "content_sanskrit": "त्वयालोकास्त्रयःक्रान्ताःपुरास्वैर्विक्रमैस्त्रिभिः ॥ 