[{"id": 5000308000, "chapter_id": 9308, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे किष्किन्धाकाण्डे षट्त्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000308001, "chapter_id": 9308, "verse_number": "४-३६-१", "content_sanskrit": "इत्युक्तस्तारया वाक्यं प्रश्रितं धर्मसंहितम्।\nमृदुस्वभावः सौमित्रिः प्रतिजग्राह तद्वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000308002, "chapter_id": 9308, "verse_number": "४-३६-२", "content_sanskrit": "तस्मिन् प्रतिगृहीते तु वाक्ये हरिगणेश्वरः।\nलक्ष्मणात् सुमहत् त्रासं वस्त्रं क्लिन्नमिवात्यजत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000308003, "chapter_id": 9308, "verse_number": "४-३६-३", "content_sanskrit": "ततः कण्ठगतं माल्यं चित्रं बहुगुणं महत्।\nचिच्छेद विमदश्चासीत् सुग्रीवो वानरेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000308004, "chapter_id": 9308, "verse_number": "४-३६-४", "content_sanskrit": "स लक्ष्मणं भीमबलं सर्ववानरसत्तमः।\nअब्रवीत् प्रश्रितं वाक्यं सुग्रीवः सम्प्रहर्षयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000308005, "chapter_id": 9308, "verse_number": "४-३६-५", "content_sanskrit": "प्रणष्टा श्रीश्च कीर्तिश्च कपिराज्यं च शाश्वतम्।\nरामप्रसादात् सौमित्रे पुनश्चाप्तमिदं मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000308006, "chapter_id": 9308, "verse_number": "४-३६-६", "content_sanskrit": "कः शक्तस्तस्य देवस्य ख्यातस्य स्वेन कर्मणा।\nतादृशं प्रतिकुर्वीत अंशेनापि नृपात्मज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000308007, "chapter_id": 9308, "verse_number": "४-३६-७", "content_sanskrit": "सीतां प्राप्स्यति धर्मात्मा वधिष्यति च रावणम्।\nसहायमात्रेण मया राघवः स्वेन तेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000308008, "chapter_id": 9308, "verse_number": "४-३६-८", "content_sanskrit": "सहायकृत्यं किं तस्य येन सप्त महाद्रुमाः।\nगिरिश्च वसुधा चैव बाणेनैकेन दारिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000308009, "chapter_id": 9308, "verse_number": "४-३६-९", "content_sanskrit": "धनुर्विस्फारमाणस्य यस्य शब्देन लक्ष्मण।\nसशैला कम्पिता भूमिः सहायैः किं नु तस्य वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000308010, "chapter_id": 9308, "verse_number": "४-३६-१०", "content_sanskrit": "अनुयात्रां नरेन्द्रस्य करिष्येऽहं नरर्षभ।\nगच्छतो रावणं हन्तुं वैरिणं सपुरस्सरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000308011, "chapter_id": 9308, "verse_number": "४-३६-११", "content_sanskrit": "यदि किंचिदतिक्रान्तं विश्वासात् प्रणयेन वा।\nप्रेष्यस्य क्षमितव्यं मे न कश्चिन्नापराध्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000308012, "chapter_id": 9308, "verse_number": "४-३६-१२", "content_sanskrit": "इति तस्य ब्रुवाणस्य सुग्रीवस्य महात्मनः।\nअभवल्लक्ष्मणः प्रीतः प्रेम्णा चेदमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000308013, "chapter_id": 9308, "verse_number": "४-३६-१३", "content_sanskrit": "सर्वथा हि मम भ्राता सनाथो वानरेश्वर।\nत्वया नाथेन सुग्रीव प्रश्रितेन विशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000308014, "chapter_id": 9308, "verse_number": "४-३६-१४", "content_sanskrit": "यस्ते प्रभावः सुग्रीव यच्च ते शौचमीदृशम्।\nअर्हस्त्वं कपिराज्यस्य श्रियं भोक्तुमनुत्तमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000308015, "chapter_id": 9308, "verse_number": "४-३६-१५", "content_sanskrit": "सहायेन च सुग्रीव त्वया रामः प्रतापवान्।\nवधिष्यति रणे शत्रूनचरान्नात्र संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000308016, "chapter_id": 9308, "verse_number": "४-३६-१६", "content_sanskrit": "धर्मज्ञस्य कृतज्ञस्य संग्रामेष्वनिवर्तिनः।\nउपपन्नं च युक्तं च सुग्रीव तव भाषितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000308017, "chapter_id": 9308, "verse_number": "४-३६-१७", "content_sanskrit": "दोषज्ञः सति सामर्थ्ये कोऽन्यो भाषितुमर्हति।\nवर्जयित्वा मम ज्येष्ठं त्वां च वानरसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000308018, "chapter_id": 9308, "verse_number": "४-३६-१८", "content_sanskrit": "सदृशश्चासि रामेण विक्रमेण बलेन च।\nसहायो दैवतैर्दत्तश्चिराय हरिपुंगव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000308019, "chapter_id": 9308, "verse_number": "४-३६-१९", "content_sanskrit": "किं तु शीघ्रमितो वीर निष्क्रम त्वं मया सह।\nसान्त्वयस्व वयस्यं च भार्याहरणदुःखितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000308020, "chapter_id": 9308, "verse_number": "४-३६-२०", "content_sanskrit": "यच्च शोकाभिभूतस्य श्रुत्वा रामस्य भाषितम्।\nमया त्वं परुषाण्युक्तस्तत् क्षमस्व सखे मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000308021, "chapter_id": 9308, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे षट्त्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]