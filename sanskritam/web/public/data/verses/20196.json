[{"id": 7000196000, "chapter_id": 20196, "verse_number": "१९६-१", "content_sanskrit": "कालयवनोपाख्यानम् व्यास उवाच गार्ग्यं गोष्ठे दिजो(जं)श्यालः षण्ढ(ण्ड)इत्युक्तवान्द्विजाः ।\nयदूनां संनिधौ सर्वे जहसुर्यादवास्तदा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000196001, "chapter_id": 20196, "verse_number": "१९६-२", "content_sanskrit": "ततः कोपसमाविष्टो दक्षिणापथमेत्य सः ।\nसुतमिच्छंस्तपस्तेपे यदुचक्रभयावहम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000196002, "chapter_id": 20196, "verse_number": "१९६-३", "content_sanskrit": "आराधयन्महादेवं सोऽयश्चूर्णमभक्षयत् ।\nददौ वरं च तुष्टोऽसौ वर्षे द्वादशके हरः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000196003, "chapter_id": 20196, "verse_number": "१९६-४", "content_sanskrit": "संभावयामास स तं यवनेसो ह्यनात्मजम् ।\nतद्योषित्संगमाच्चास्य पुत्रोऽभूदलिसप्रभः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000196004, "chapter_id": 20196, "verse_number": "१९६-५", "content_sanskrit": "तं कालयवनं नाम राज्ये स्वे यवनेश्वरः ।\nअभिषिच्य वनं यातो वज्राग्रकठिनोरसम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000196005, "chapter_id": 20196, "verse_number": "१९६-६", "content_sanskrit": "स तु वीर्यमदोन्मत्तः पृथिव्यां बलिनो नृपान् ।\nपप्रच्छ नारदश्चास्मै कथयामास यादवान् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000196006, "chapter_id": 20196, "verse_number": "१९६-७", "content_sanskrit": "म्लेच्छकोटिसहस्राणां सहस्रैः सोऽपि संवृतः ।\nगजाश्वरथसंपन्नैश्चकार परमोद्यमम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000196007, "chapter_id": 20196, "verse_number": "१९६-८", "content_sanskrit": "प्रययौ चाऽऽतव(प)च्छिन्नैः प्रयामणैः स दिने दिने ।\nयादवान्प्रति समार्षो मुनयो मथुरां पुरीम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000196008, "chapter_id": 20196, "verse_number": "१९६-९", "content_sanskrit": "कृष्णोऽपि चिन्तयामास क्षपितं यादवं बलम् ।\nयवनेन समालोक्य मागधः संप्रयास्यति ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000196009, "chapter_id": 20196, "verse_number": "१९६-१०", "content_sanskrit": "मागधस्य बलं क्षीणं स कालयवनो बली ।\nहन्ता तदिदमायातं यदूनां व्यसनं द्विधा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000196010, "chapter_id": 20196, "verse_number": "१९६-११", "content_sanskrit": "तस्माद्‌दुर्गं करिष्यामि यदूनामतिदुर्जयम् ।\nस्त्रियोऽपि यत्र युध्येयुः किं पुनर्वृष्णियादवाः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000196011, "chapter_id": 20196, "verse_number": "१९६-१२", "content_sanskrit": "मयि मत्ते प्रमत्ते वा सुप्ते प्रवसितेऽपि वा ।\nयादवाभिभवं दुष्टा मा कुर्वन्वै(र्युवै)रिणोऽधिकम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000196012, "chapter_id": 20196, "verse_number": "१९६-१३", "content_sanskrit": "इति संचिन्त्य गोविन्दो योजनानि महोदधिम् ।\nययाचे द्वादश पुरीं द्वारकां तत्र निर्ममे ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000196013, "chapter_id": 20196, "verse_number": "१९६-१४", "content_sanskrit": "महोद्यानां महावप्रां तडागशतशोभिताम् ।\nप्रकारशतसंबाधामिन्द्रसयेवामरावतीम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000196014, "chapter_id": 20196, "verse_number": "१९६-१५", "content_sanskrit": "मथुरावासिनं लोकं तत्राऽऽनीय जनार्दनः ।\nआसन्ने कालयवने मथुरां च स्वयं ययौ ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000196015, "chapter_id": 20196, "verse_number": "१९६-१६", "content_sanskrit": "वहिरावासिते सैन्ये मथुराया निरायुधः ।\nनिर्जगाम स गोविन्दो ददर्श यवनश्च तम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000196016, "chapter_id": 20196, "verse_number": "१९६-१७", "content_sanskrit": "स ज्ञत्वा वासुदेवं तं बाहुप्रहरणो नृपः ।\nअनुयातो महायोगिचेतोभिः प्राप्यते न यः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000196017, "chapter_id": 20196, "verse_number": "१९६-१८", "content_sanskrit": "तेनानुयातः कृष्णोऽपि प्रविवेश महागुहाम् ।\nयत्र शेते महावीर्यो मुचुकुन्दो नरेश्वरः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000196018, "chapter_id": 20196, "verse_number": "१९६-१९", "content_sanskrit": "सोऽपि प्रविष्टो यवनो दृष्ट्वा शय्यागतं नरम् ।\nपादेन ताडयामास कृष्णं मत्वा स दुर्मति ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000196019, "chapter_id": 20196, "verse_number": "१९६-२०", "content_sanskrit": "दृष्ट्मात्रश्च तेनासौ जज्वाल यवनोऽग्निना ।\nतत्क्रोधजेन मुनयो भस्मीभूतश्च तत्क्षणात् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000196020, "chapter_id": 20196, "verse_number": "१९६-२१", "content_sanskrit": "स हि देवासुरे युद्धे गत्वा जित्वा महासुरान् ।\nनिद्रार्तः सुमहाकालं निद्रां वव्रे वरं सुरान् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000196021, "chapter_id": 20196, "verse_number": "१९६-२२", "content_sanskrit": "प्रोक्तश्च दैवैः संसुप्तं यस्त्वामुत्थापयिष्यति ।\nदेहजेनाग्निना सद्यः स तु भस्मीभविष्यति ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000196022, "chapter_id": 20196, "verse_number": "१९६-२३", "content_sanskrit": "एवं दग्ध्वा स तं पापं दृष्ट्वा च मधुसुदनम् ।\nकस्त्वमित्याह सोऽप्याह जातोऽहं शशिनः कुले ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000196023, "chapter_id": 20196, "verse_number": "१९६-२४", "content_sanskrit": "वसुदेवस्य तनयो यदुवंशसमुद्भवः ।\nमुचुकुन्दोऽपि तच्छ्रुत्वा वृद्धगार्ग्यवचः स्मरन् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000196024, "chapter_id": 20196, "verse_number": "१९६-२५", "content_sanskrit": "संस्मृत्य प्रणिपत्यैनं सर्वं सर्वेश्वरं हरिम् ।\nप्राह ज्ञातो भवान्विष्णोरंशस्त्वं परमेश्वरः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000196025, "chapter_id": 20196, "verse_number": "१९६-२६", "content_sanskrit": "पुरा गार्ग्येण कथितमष्टाविंशतिमे युगे ।\nद्वापरान्ते हरेर्जन्म यदुवंशे भविष्यति ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000196026, "chapter_id": 20196, "verse_number": "१९६-२७", "content_sanskrit": "स त्वं प्राप्तो न संदेहो मर्त्यानामुपकारकृत् ।\nतथा हि सुमहत्तेजो नालं सोढुमहं तव ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000196027, "chapter_id": 20196, "verse_number": "१९६-२८", "content_sanskrit": "तथा हि सुमहाम्भोदध्वनिधीरतरं ततः ।\nवाक्यं तमिति होवाच युष्मत्पादसुलालितम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000196028, "chapter_id": 20196, "verse_number": "१९६-२९", "content_sanskrit": "देवासुरे महायुद्धे दैत्याश्च सुमहाभटाः ।\nन शेकुस्ते महत्तेजस्तत्तेजो न सहाम्यहम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000196029, "chapter_id": 20196, "verse_number": "१९६-३०", "content_sanskrit": "संसारपतितस्यैको जन्तोस्त्वं शरणं परम् ।\nसंप्रसीद प्रपन्नार्तिहर्ता हर ममाशुभम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000196030, "chapter_id": 20196, "verse_number": "१९६-३१", "content_sanskrit": "त्वं पयोनिधयः शैलाः सतिरश्च वनानि च ।\nमोदिनी गगनं वायुरापोऽग्निस्त्वं तथा पुमान् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000196031, "chapter_id": 20196, "verse_number": "१९६-३२", "content_sanskrit": "पुंसः परतरं सर्वं व्याप्य जन्म विकल्पवत् ।\nशब्दादिहीनमजरं वृद्धिक्षयविवर्जितम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000196032, "chapter_id": 20196, "verse_number": "१९६-३३", "content_sanskrit": "त्वत्तोऽमरास्तु पितरो यक्षगन्धर्वराक्षसाः ।\nसिद्धाश्चाप्सरससत्वत्तो मनुष्याः पशवः खगाः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000196033, "chapter_id": 20196, "verse_number": "१९६-३४", "content_sanskrit": "सरीसृपा मृगाः सर्वे त्वत्तश्चैव महीरुहाः ।\nयच्च भूतं भविष्यद्वा किंचिदत्र चराचरे ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000196034, "chapter_id": 20196, "verse_number": "१९६-३५", "content_sanskrit": "अमूर्तं मूर्तमथवा स्थूलं सूक्ष्मतरं तथा ।\nतत्सर्वं त्वं जगत्कर्तर्नास्ति किंचित्त्वया विना ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000196035, "chapter_id": 20196, "verse_number": "१९६-३६", "content_sanskrit": "मया संसारचक्रेऽस्मन्भ्रमता भगवन्सदा ।\nतापत्रयाभिभुतेन न प्राप्ता निर्वृतिः क्वचित् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000196036, "chapter_id": 20196, "verse_number": "१९६-३७", "content_sanskrit": "दुःखान्येव सुकानीति मृगतृष्णा जलाशयः ।\nमया नाथ गृहीतानि तानि तापाय मेऽभवन् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000196037, "chapter_id": 20196, "verse_number": "१९६-३८", "content_sanskrit": "राज्यमुर्वी बलं कोशो मित्रपक्षस्तथाऽऽत्मजाः ।\nभार्या भृत्यजना ये च शब्दाद्य विषयाः प्रभो ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000196038, "chapter_id": 20196, "verse_number": "१९६-३९", "content_sanskrit": "सुखबुद्‌ध्या मया सर्वं गृहीतमिदमव्यय ।\nपरिणामे च देवेश तापात्मकमभून्मम ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000196039, "chapter_id": 20196, "verse_number": "१९६-४०", "content_sanskrit": "देवलोकगतिं प्राप्तो नाथ देवगणोऽपि हि ।\nमत्तः साहाय्यकामोभूच्चछाश्वती कुत्र निर्वृतिः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000196040, "chapter_id": 20196, "verse_number": "१९६-४१", "content_sanskrit": "त्वामनाराध्य जगतां सर्वेषां प्रभवास्पदम् ।\nशाश्वती प्राप्यते केन परमेश्वर निर्वृतिः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000196041, "chapter_id": 20196, "verse_number": "१९६-४२", "content_sanskrit": "त्वन्मायामूढमनसो जन्ममृत्युजरादिकान् ।\nअवाप्य पापान्पस्यन्ति प्रेतराजानमन्तरा ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000196042, "chapter_id": 20196, "verse_number": "१९६-४३", "content_sanskrit": "ततः पाशशतैर्बद्धा नरकेष्वतिदारुणम् ।\nप्राप्नुवन्ति महद्‌दुःख विश्वरूपमिदं तव ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000196043, "chapter_id": 20196, "verse_number": "१९६-४४", "content_sanskrit": "अहमत्यन्तविषयी मोहितस्तव मायया ।\nममत्वागाधगर्तान्ते भ्रमामि परमेश्वर ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000196044, "chapter_id": 20196, "verse_number": "१९६-४५", "content_sanskrit": "सोऽहं त्वां शरणमपारमीसमीड्यं, संप्राप्तः परमपदं यतो न किंचित् ।\nसंसारश्रमपरितापतप्तचेता निर्विण्णे परिणतधाम्नि साभिलाषः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]