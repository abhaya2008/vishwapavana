[{"id": 2107870, "chapter_id": 3329, "verse_number": "", "content_sanskrit": "सूत उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2107871, "chapter_id": 3329, "verse_number": "१", "content_sanskrit": "स चापि भार्गवो ब्रह्मन् च्यवनोऽजनयत्सुतम् ।\nसुकन्यायां महात्मानं प्रमतिं दीप्ततेजसम् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2107872, "chapter_id": 3329, "verse_number": "२", "content_sanskrit": "प्रमतिस्तु रुरुं नाम घृताच्यां समजीजनत् ।\nरुरोः प्रमद्वरायां तु शुनकः समपद्यत \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2107873, "chapter_id": 3329, "verse_number": "३", "content_sanskrit": "शौनकस्त्वं महाभागः शुनकस्य सुतोऽभवः ।\nतस्य ब्रह्मन् रुरोः सर्वं चरितं भूरितेजसः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2107874, "chapter_id": 3329, "verse_number": "४", "content_sanskrit": "विस्तरेण प्रवक्ष्यामि तच्छ्रुणु त्वमशेषतः ।\nऋषिरासीन्महान् पूर्वं तपोविद्याविशारदः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2107875, "chapter_id": 3329, "verse_number": "५", "content_sanskrit": "स्थूलकेश इति ख्यातः सर्वभूतहिते रतः ।\nएतस्मिन्नेव काले तु मेनकायां प्रजज्ञिवान् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2107876, "chapter_id": 3329, "verse_number": "६", "content_sanskrit": "गन्धर्वराजो विप्रर्षे विश्वावसुरिति श्रुतः ।\nअप्सरा मेनका चापि तं गर्भं भृगुनन्दन \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2107877, "chapter_id": 3329, "verse_number": "७", "content_sanskrit": "उत्ससर्ज यथाकालं स्थूलकेशाश्रमं प्रति ।\nउत्सृज्य चैव गर्भं स्वं नद्यास्तीरे जगाम सा \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2107878, "chapter_id": 3329, "verse_number": "८", "content_sanskrit": "कन्याममरगर्भाभां ज्वलन्तीमिव च श्रिया ।\nतां ददर्श समुत्सृष्टां नद्यास्तीरे महानृषिः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2107879, "chapter_id": 3329, "verse_number": "९", "content_sanskrit": "स्थूलकेशः सुतेजस्वी विजने बन्धुवर्जिताम् ।\nस तां दृष्ट्वा तदा कन्यां स्थूलकेशो द्विजोत्तमः\t ॥ ९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2107880, "chapter_id": 3329, "verse_number": "१०", "content_sanskrit": "जग्राहाथ मुनिश्रेष्ठः कृपाविष्टः पुपोष च ।\nववृधे सा वरारोहा तस्याश्रमपदे शुभा \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2107881, "chapter_id": 3329, "verse_number": "११", "content_sanskrit": "प्रमदाभ्यो वरा सा तु रूपशीलादिभिर्गुणैः ।\nततः प्रमद्वरेत्यस्या नाम चक्रे महानृषिः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2107882, "chapter_id": 3329, "verse_number": "१२", "content_sanskrit": "तामाश्रमपदे तस्य रुरुर्दृष्ट्वा प्रमद्वराम् ।\nबभूव किल धर्मात्मा मदनानुगतात्मवान् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2107883, "chapter_id": 3329, "verse_number": "१३", "content_sanskrit": "पितरं सखिभिः सोऽथ याचयामास भार्गवः ।\nप्रमतिश्चाभ्ययाज्ज्ञात्वा स्थूलकेशं यशस्विनम् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2107884, "chapter_id": 3329, "verse_number": "१४", "content_sanskrit": "ततः प्रादात् पिता कन्यां रुरवे तां प्रमद्वराम् ।\nविवाहं स्थापयित्वाग्रे नक्षत्रे भगदैवते\t ॥ १४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2107885, "chapter_id": 3329, "verse_number": "१५", "content_sanskrit": "ततः कतिपयाहस्सु विवाहे समुपस्थिते ।\nसखीभिः क्रीडती सार्धं सा कन्या वरवर्णिनी\t ॥ १५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2107886, "chapter_id": 3329, "verse_number": "१६", "content_sanskrit": "नापश्यत प्रसुप्तं वै भुजङ्गं तिर्यगायतम् ।\nपदा चैनं समाक्रामन् मुमूर्षुः कालचोदिता \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2107887, "chapter_id": 3329, "verse_number": "१७", "content_sanskrit": "स तस्याः सम्प्रमत्तायाश्चोदितः कालधर्मणा ।\nविषोपलिप्तदन्ताभ्यां व्यदंशच्च न्यपातयत् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2107888, "chapter_id": 3329, "verse_number": "१८", "content_sanskrit": "सा दष्टा सहसा भूमौ पपात गतचेतना ।\nव्यसुरप्रेक्षणीयाच प्रेक्षणीयतमाकृतिः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2107889, "chapter_id": 3329, "verse_number": "१९", "content_sanskrit": "प्रसुप्तेवाभवच्चापि भुवि सर्पविषार्दिता\nभूयोऽमनोहरतमा बभूव तनुमध्यमा \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2107890, "chapter_id": 3329, "verse_number": "२०", "content_sanskrit": "तां ददर्श पिता चैव ते चैवान्ये तपस्विनः ।\nविवेष्टमानां पतितां भूतळे पद्मवर्चसम् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2107891, "chapter_id": 3329, "verse_number": "२२", "content_sanskrit": "ततः सर्वे द्विजवराः समाजग्मुः कृपान्विताः ।\nस्वस्त्यात्रेयो महाजानुः कुशिकः शङ्खमेखलः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2107892, "chapter_id": 3329, "verse_number": "२३", "content_sanskrit": "उद्दालकोऽक्षकरश्चैव श्वेतकेतुस्तथैव च ।\nभरद्वाजः कौणकुत्स आर्ष्टिषेणोऽथ गौतमः\t ॥ २३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2107893, "chapter_id": 3329, "verse_number": "२४", "content_sanskrit": "प्रमतिः सह पुत्रेण तथान्ये वनवासिनः ।\nतां ते कन्यां व्यसुं दृष्ट्वा भुजङ्गस्य विषार्दिताम् \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2107894, "chapter_id": 3329, "verse_number": "२५", "content_sanskrit": "रुरुदुः कृपयाऽऽविष्टा रुरुस्त्वार्तो बहिर्ययौ ।\nते च सर्वे द्विजश्रेष्ठास्तत्रैवोपाविशंस्तदा \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2107895, "chapter_id": 3329, "verse_number": "८", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आदिपर्वणि अष्टमोऽध्यायः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2107896, "chapter_id": 3329, "verse_number": "५", "content_sanskrit": "॥ पौलोमपर्वणि पञ्चमोऽध्यायः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]