[{"id": 2077842, "chapter_id": 2650, "verse_number": "१२-१५५-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2077843, "chapter_id": 2650, "verse_number": "१२-१५५-१", "content_sanskrit": "एवमुक्त्वा तु राजेन्द्र शाल्मलिं ब्रह्मवित्तमः।\nनारदः पवने सर्वं शाल्मलेर्वाक्यमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2077844, "chapter_id": 2650, "verse_number": "१२-१५५-२x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2077845, "chapter_id": 2650, "verse_number": "१२-१५५-२", "content_sanskrit": "हिमवत्पृष्ठजः कश्चिच्छाल्मलिः परिवारवान्।\nबृहन्मूलो बृहच्छायः स त्वां वायोऽवमन्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2077846, "chapter_id": 2650, "verse_number": "१२-१५५-३", "content_sanskrit": "बहुव्याक्षेपयुक्तानि त्वामाह वचनानि सः।\nन युक्तानि मया वायो तानि वक्तुं तवाग्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2077847, "chapter_id": 2650, "verse_number": "१२-१५५-४", "content_sanskrit": "जानामि त्वामहं वायो सर्वप्राणभृतां वरम्।\nवरिष्ठं च गरिष्ठं च सर्वलोकेश्वरं प्रभुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2077848, "chapter_id": 2650, "verse_number": "१२-१५५-५x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2077849, "chapter_id": 2650, "verse_number": "१२-१५५-५", "content_sanskrit": "एतत्तु वचनं श्रुत्वा नारदस्य समीरणः।\nशाल्मलिं तमुपागम्य क्रुद्धो वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2077850, "chapter_id": 2650, "verse_number": "१२-१५५-६x", "content_sanskrit": "वायुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2077851, "chapter_id": 2650, "verse_number": "१२-१५५-६", "content_sanskrit": "शाल्मले नारदो गच्छंस्त्वयोक्तो मद्विगर्हणम्।\nअहं वायुः प्रभावं ते दर्शयाम्यात्मनो बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2077852, "chapter_id": 2650, "verse_number": "१२-१५५-७", "content_sanskrit": "नाहं त्वां नाभिजानामि विदितश्चासि मे द्रुम्।\nपितामहः प्रजासर्गे त्वयि विश्रान्तवान्प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2077853, "chapter_id": 2650, "verse_number": "१२-१५५-८", "content_sanskrit": "तस्य विश्रमणादेव प्रसादौ मत्कृतस्तव।\nअभूत्तस्य प्रसादात्त्वां न भज्यामि द्रुमाधम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2077854, "chapter_id": 2650, "verse_number": "१२-१५५-९", "content_sanskrit": "यन्मां त्वमवजानीषे यथाऽन्यं प्राकृतं तथा।\nदर्शयाम्येष चात्मानं यथा मां नावमन्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2077855, "chapter_id": 2650, "verse_number": "१२-१५५-१०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2077856, "chapter_id": 2650, "verse_number": "१२-१५५-१०", "content_sanskrit": "एवमुक्तस्ततः प्राह शाल्मलिः प्रहसन्निव।\nपवन त्वं वने क्रुद्धो दर्शयात्मानमात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2077857, "chapter_id": 2650, "verse_number": "१२-१५५-११", "content_sanskrit": "मयि वै मुच्यतां क्रोधः किं मे क्रुद्धः करिष्यसि।\nन ते बिभेमि पवन यद्यपि त्वं स्वयं प्रभुः।\nबलाधिकोऽहं त्वत्तश्च न भीः कार्या मया तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2077858, "chapter_id": 2650, "verse_number": "१२-१५५-१२", "content_sanskrit": "ये तु बुद्ध्या हि बलिनस्ते भवन्ति बलीयसः।\nप्राणमात्रबला ये वै नैव ते बलिनो मताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2077859, "chapter_id": 2650, "verse_number": "१२-१५५-१३", "content_sanskrit": "इत्येवमुक्तः पवनः श्व इत्येवाब्रवीद्वचः।\nदर्शयिष्यामि ते तेजस्ततो रात्रिरुपागमत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2077860, "chapter_id": 2650, "verse_number": "१२-१५५-१४", "content_sanskrit": "अथ निश्चित्य मनसा शाल्मलिर्वैरधारणम्।\nपश्यमानस्तदात्मानमसमं मातरिश्वना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2077861, "chapter_id": 2650, "verse_number": "१२-१५५-१५", "content_sanskrit": "नारदे यन्मया प्रोक्तं वचनं प्रति तन्मृषा।\nअसमर्थो ह्यहं वायोर्बलेन बलवान्हि सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2077862, "chapter_id": 2650, "verse_number": "१२-१५५-१६", "content_sanskrit": "मारुतो बल्यान्नित्यं यथा वै नारदोऽब्रवीत्।\nअहं तु दुर्बलोऽन्येभ्यो वृक्षेभ्यो नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2077863, "chapter_id": 2650, "verse_number": "१२-१५५-१७", "content_sanskrit": "किं तु बुद्ध्या समो नास्ति मम कश्चिद्वनस्पतिः।\nतदहं बुद्धिमास्थाय भयं त्यक्ष्ये समीरणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2077864, "chapter_id": 2650, "verse_number": "१२-१५५-१८", "content_sanskrit": "यदि तां बुद्धिमास्थाय तिष्ठेयुः पर्णिनो वने।\nअरिष्टाः स्युः सदा क्रुद्धात्पवनान्नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2077865, "chapter_id": 2650, "verse_number": "१२-१५५-१९", "content_sanskrit": "ते तु बाला न जानन्ति यथा नैतान्समीरणः।\nसमीरयेत संक्रुद्धो यथा जानाम्यहं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2077866, "chapter_id": 2650, "verse_number": "१२-१५५-२०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2077867, "chapter_id": 2650, "verse_number": "१२-१५५-२०", "content_sanskrit": "ततो निश्चित्य मनसा शाल्मलिः क्षुभितस्तदा।\nशाखाः स्कन्धान्प्रशाखाश्च स्वयमेव व्यशातयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2077868, "chapter_id": 2650, "verse_number": "१२-१५५-२१", "content_sanskrit": "स परित्यज्य शाखाश्च पत्राणि कुसुमानि च।\nप्रभाते वायुमायान्तं प्रेक्षते स्म वनस्पतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2077869, "chapter_id": 2650, "verse_number": "१२-१५५-२२", "content_sanskrit": "ततः क्रुद्धः श्वसन्वायुः पातयन्वै महाद्रुमान्।\nआजगामाथ तं देशमास्ते यत्र स शाल्मलिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2077870, "chapter_id": 2650, "verse_number": "१२-१५५-२३", "content_sanskrit": "तं हीनपर्णं पतिताग्रशाखं\nनिशीर्णपुष्पं प्रसमीक्ष्य वायुः।\nउवाच वाक्यं स्ययमान एवं\nमुदायुतः शाल्मलिं रुग्णशाखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2077871, "chapter_id": 2650, "verse_number": "१२-१५५-२४x", "content_sanskrit": "वायुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2077872, "chapter_id": 2650, "verse_number": "१२-१५५-२४", "content_sanskrit": "अहमप्येवमेव त्वां कुर्यां वै शाल्मले रुपा।\nआत्मना यत्कृतं कृच्छ्रं शाखानामपकर्पणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2077873, "chapter_id": 2650, "verse_number": "१२-१५५-२५", "content_sanskrit": "हीनपुष्पाग्रशाखस्त्वं शीर्णाङ्कुरपलाशकः।\nआत्मदुर्मन्त्रितेनेह मद्वीर्यवशगः कृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2077874, "chapter_id": 2650, "verse_number": "१२-१५५-२६x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2077875, "chapter_id": 2650, "verse_number": "१२-१५५-२६", "content_sanskrit": "एतच्छ्रुत्वा वचो वायोः शाल्मलिर्व्रीडितस्तदा।\nअतप्यत वचः स्मृत्वा नारदो यत्तदाऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2077876, "chapter_id": 2650, "verse_number": "१२-१५५-२७", "content_sanskrit": "एवं हि राजशार्दूल दुर्बलः सन्वलीयसा।\nवैरमासञ्जते बालस्तप्यते शाल्मलिर्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2077877, "chapter_id": 2650, "verse_number": "१२-१५५-२८", "content_sanskrit": "तस्माद्वैरं न कुर्वीत दुर्बलो बलवत्तरैः।\nशोचेद्धि वैरं कुर्वाणो यथा वै शाल्मलिस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2077878, "chapter_id": 2650, "verse_number": "१२-१५५-२९", "content_sanskrit": "न हि वैरं महात्मानो विवृण्वन्त्यपकारिषु।\nशनैः शनैर्महाराज दर्शयन्ति स्म ते बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2077879, "chapter_id": 2650, "verse_number": "१२-१५५-३०", "content_sanskrit": "वैरं न कुर्वीत नरो दुर्बुद्धिर्बुद्धिजीविना।\nबुद्धिर्वुद्धिमतो याति तूलष्विव हुताशनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2077880, "chapter_id": 2650, "verse_number": "१२-१५५-३१", "content_sanskrit": "न हि बुद्ध्या समं किंचिद्विद्यते पुरुषे नृप।\nतथा बलेन राजेन्द्र न समोऽस्तीह कश्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2077881, "chapter_id": 2650, "verse_number": "१२-१५५-३२", "content_sanskrit": "तस्मात्क्षमेत बालाय जडान्धवधिराय च।\nबलाधिकाय राजेन्द्र तद्दृष्टं त्वयि शत्रुहन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2077882, "chapter_id": 2650, "verse_number": "१२-१५५-३३", "content_sanskrit": "अक्षौहिण्यो दशैका च सप्त चैव महाद्युते।\nबलेन न समा राजन्नर्जुनस्य महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2077883, "chapter_id": 2650, "verse_number": "१२-१५५-३४", "content_sanskrit": "निहताश्चैव भग्नाश्च पाण्डवेन यशस्विना।\nचरता बलमास्थाय पाकशासनिना मृधे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2077884, "chapter_id": 2650, "verse_number": "१२-१५५-३५", "content_sanskrit": "उक्ताश्च ते राजधर्मा आपद्धर्माश्च भारत।\nविस्तरेण महाराज किं भूयः प्रव्रवीमि ते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2077885, "chapter_id": 2650, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि आपद्धर्मपर्वणि पञ्चषच्चाशदधिकशततमोऽध्यायः॥ १५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]