[{"id": 7000432000, "chapter_id": 20432, "verse_number": "२-१०४-१", "content_sanskrit": "कुंजल उवाच ।\nगते तस्मिन्महाभागे दत्तात्रेये महामुनौ ।\nआजगाम महाराज आयुश्च स्वपुरं प्रति॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000432001, "chapter_id": 20432, "verse_number": "२-१०४-२", "content_sanskrit": "इंदुमत्या गृहं हृष्टः प्रविवेश श्रियान्वितम् ।\nसर्वकामसमृद्धार्थमिंद्रस्य सदनोपमम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000432002, "chapter_id": 20432, "verse_number": "२-१०४-३", "content_sanskrit": "राज्यं चक्रे स मेधावी यथा स्वर्गे पुरंदरः ।\nस्वर्भानुसुतया सार्द्धमिंदुमत्या द्विजोत्तम॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000432003, "chapter_id": 20432, "verse_number": "२-१०४-४", "content_sanskrit": "सा च इंदुमती राज्ञी गर्भमाप फलाशनात् ।\nदत्तात्रेयस्य वचनाद्दिव्यतेजः समन्वितम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000432004, "chapter_id": 20432, "verse_number": "२-१०४-५", "content_sanskrit": "इंदुमत्या महाभाग स्वप्नं दृष्टमनुत्तमम् ।\nरात्रौ दिवान्वितं तात बहुमंगलदायकम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000432005, "chapter_id": 20432, "verse_number": "२-१०४-६", "content_sanskrit": "गृहांतरे विशंतं च पुरुषं सूर्यसन्निभम् ।\nमुक्तामालान्वितं विप्रं श्वेतवस्त्रेणशोभितम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000432006, "chapter_id": 20432, "verse_number": "२-१०४-७", "content_sanskrit": "श्वेतपुष्पकृतामाला तस्य कंठे विराजते ।\nसर्वाभरणशोभांगो दिव्यगंधानुलेपनः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000432007, "chapter_id": 20432, "verse_number": "२-१०४-८", "content_sanskrit": "चतुर्भुजः शंखपाणिर्गदाचक्रासिधारकः ।\nछत्रेण ध्रियमाणेन चंद्रबिंबानुकारिणा॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000432008, "chapter_id": 20432, "verse_number": "२-१०४-९", "content_sanskrit": "शोभमानो महातेजा दिव्याभरणभूषितः ।\nहारकंकणकेयूर नूपुराभ्यां विराजितः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000432009, "chapter_id": 20432, "verse_number": "२-१०४-१०", "content_sanskrit": "चंद्रबिंबानुकाराभ्यां कुंडलाभ्यां विराजितः ।\nएवंविधो महाप्राज्ञो नरः कश्चित्समागतः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000432010, "chapter_id": 20432, "verse_number": "२-१०४-११", "content_sanskrit": "इंदुमतीं समाहूय स्नापिता पयसा तदा ।\nशंखेन क्षीरपूर्णेन शशिवर्णेन भामिनी॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000432011, "chapter_id": 20432, "verse_number": "२-१०४-१२", "content_sanskrit": "रत्नकांचनबद्धेन संपूर्णेन पुनः पुनः ।\nश्वेतं नागं सुरूपं च सहस्रशिरसं वरम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000432012, "chapter_id": 20432, "verse_number": "२-१०४-१३", "content_sanskrit": "महामणियुतं दीप्तं धामज्वालासमाकुलम् ।\nक्षिप्तं तेन मुखप्रांते दत्तं मुक्ताफलं पुनः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000432013, "chapter_id": 20432, "verse_number": "२-१०४-१४", "content_sanskrit": "कंठे तस्याः स देवेश इंदुमत्या महायशाः ।\nपद्मं हस्ते ततो दत्वा स्वस्थानं प्रति जग्मिवान्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000432014, "chapter_id": 20432, "verse_number": "२-१०४-१५", "content_sanskrit": "एवंविधं महास्वप्नं तया दृष्टं सुतोत्तमम् ।\nसमाचष्ट महाभागा आयुं भूमिपतीश्वरम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000432015, "chapter_id": 20432, "verse_number": "२-१०४-१६", "content_sanskrit": "समाकर्ण्य महाराजश्चिंतयामास वै पुनः ।\nसमाहूय गुरुं पश्चात्कथितं स्वप्नमुत्तमम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000432016, "chapter_id": 20432, "verse_number": "२-१०४-१७", "content_sanskrit": "शौनकं सुमहाभागं सर्वज्ञं ज्ञानिनां वरम् ।\nराजोवाच ।\nअद्य रात्रौ महाभाग मम पत्न्या द्विजोत्तम॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000432017, "chapter_id": 20432, "verse_number": "२-१०४-१८", "content_sanskrit": "विप्रो गेहं विशन्दृष्टः किमिदं स्वप्नकारणम् ।\nशौनक उवाच ।\nवरो दत्तस्तु ते पूर्वं दत्तात्रेयेण धीमता॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000432018, "chapter_id": 20432, "verse_number": "२-१०४-१९", "content_sanskrit": "आदिष्टं च फलं राज्ञां सुगुणं सुतहेतवे ।\nतत्फलं किं कृतं राजन्कस्मै त्वया निवेदितम्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000432019, "chapter_id": 20432, "verse_number": "२-१०४-२०", "content_sanskrit": "सुभार्यायै मया दत्तमिति राज्ञोदितं वचः ।\nश्रुत्वोवाच महाप्राज्ञः शौनको द्विजसत्तमः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000432020, "chapter_id": 20432, "verse_number": "२-१०४-२१", "content_sanskrit": "दत्तात्रेयप्रसादेन तव गेहे सुतोत्तमः ।\nवैष्णवांशेन संयुक्तो भविष्यति न संशयः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000432021, "chapter_id": 20432, "verse_number": "२-१०४-२२", "content_sanskrit": "स्वप्नस्य कारणं राजन्नेतत्ते कथितं मया ।\nइंद्रोपेंद्र समः पुत्रो दिव्यवीर्यो भविष्यति॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000432022, "chapter_id": 20432, "verse_number": "२-१०४-२३", "content_sanskrit": "पुत्रस्ते सर्वधर्मात्मा सोमवंशस्य वर्द्धनः ।\nधनुर्वेदे च वेदे च सगुणोसौ भविष्यति॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000432023, "chapter_id": 20432, "verse_number": "२-१०४-२४", "content_sanskrit": "एवमुक्त्वा स राजानं शौनको गतवान्गृहम् ।\nहर्षेण महताविष्टो राजाभूत्प्रियया सह॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]