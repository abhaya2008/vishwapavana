[{"id": 2205008, "chapter_id": 5368, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2205009, "chapter_id": 5368, "verse_number": "१", "content_sanskrit": "तृतीयं सोपकरणं क्रियते गृहवासिभिः ।\nदानानि देवपूजां च पितृपूजां तथैव च\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2205010, "chapter_id": 5368, "verse_number": "२", "content_sanskrit": "अन्यानि धर्मकार्याणि सुकृतं सोपसाधनम् ।\nतत्सर्वं शृणु कल्याणि प्रजानां हितकाम्यया\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2205011, "chapter_id": 5368, "verse_number": "३", "content_sanskrit": "चेतनाचेतनैर्युक्तं यल्लोके विद्यते धनम् ।\nएतदर्थमवाप्नोति नरः प्रेत्य शुभेक्षणे\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2205012, "chapter_id": 5368, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2205013, "chapter_id": 5368, "verse_number": "४", "content_sanskrit": "लोकसिद्धं तु यद् द्रव्यं सर्वसाधारणं भवेत्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2205014, "chapter_id": 5368, "verse_number": "५", "content_sanskrit": "तद् ददत् सर्वसामान्यं कथं धर्मं लभेन्नरः ।\nएवं साधारणे द्रव्ये कस्य स्वत्वं कथं भवेत्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2205015, "chapter_id": 5368, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2205016, "chapter_id": 5368, "verse_number": "६", "content_sanskrit": "लोके भूतमयं द्रव्यं सर्वसाधारणं तथा ।\nतथैव तद् ददन्मर्त्यो भवेत् पुण्यं हि तच्छृणु\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2205017, "chapter_id": 5368, "verse_number": "७", "content_sanskrit": "दाता प्रकृतिहीनश्च देयं सोपक्रमं तथा ।\nदेशकालौ च यत्त्वेतद् दानं षङ्गुणमुच्यते ।\nतेषां सम्पद्विशेषांश्च कीर्त्यमानान् निबोध मे\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2205018, "chapter_id": 5368, "verse_number": "८", "content_sanskrit": "आदिप्रभृति यः शुद्धो मनोवाक्कायकर्मभिः ।\nसत्यवादी जितक्रोधस्त्वलुब्धो नाभ्यसूयकः ।\nश्रद्धावानास्तिकश्चैव एवं दाता प्रशस्यते\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2205019, "chapter_id": 5368, "verse_number": "९", "content_sanskrit": "शुद्धो दान्तो जितक्रोधस्तथोदितकुलोद्भवः ।\nश्रुतचारित्रसम्पन्नस्तथा बहुकळत्रवान्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2205020, "chapter_id": 5368, "verse_number": "१०", "content_sanskrit": "पञ्चयज्ञपरो नित्यं निर्विकारशरीरवान् ।\nएतान् पात्रगुणान् विद्धि तादृक्पात्रं प्रशस्यते\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2205021, "chapter_id": 5368, "verse_number": "११", "content_sanskrit": "पितृदेवाग्निकार्येषु तस्य दत्तं महत्फलम् ।\nयद्यदर्हति यो लोके पात्रं तस्य भवेच्च सः ।\nमुच्येदापदमापन्नो येन पात्रं स तस्य तु\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2205022, "chapter_id": 5368, "verse_number": "१२", "content_sanskrit": "अन्नस्य क्षुधितं पात्रं तृषितस्तु जलस्य वै ।\nएवं पात्रेषु नानात्वमिष्यते पुरुषं प्रति\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2205023, "chapter_id": 5368, "verse_number": "१३", "content_sanskrit": "जारश्चोरश्च षण्डश्च हिंस्रश्च कुहकः शुनिः ।\nलोकविघ्नकराश्चान्ये वर्जितव्याः सर्वशः प्रिये\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2205024, "chapter_id": 5368, "verse_number": "१४", "content_sanskrit": "परोपघाताद् यद् द्रव्यं चौर्याद्वा लभ्यते नृभिः ।\nनिन्दया लभ्यते यच्च धूर्तभावेन वै तथा\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2205025, "chapter_id": 5368, "verse_number": "१५", "content_sanskrit": "अधर्मादथ मोहाद्वा बहूनामुपरोधनात् ।\nलभ्यते यद् धनं देवि तदत्यन्तविगर्हितम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2205026, "chapter_id": 5368, "verse_number": "१६", "content_sanskrit": "तादृशेन कृतं धर्मं निष्फलं विद्धि भामिनि ।\nतस्मान्न्यायागतेनैव दातव्यं शुभमिच्छता\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2205027, "chapter_id": 5368, "verse_number": "१७", "content_sanskrit": "यद्यदात्मप्रियं नित्यं तत्तद् देयमिति स्थितिः ।\nउपक्रममिमं विद्धि दातॄणां परमं हितम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2205028, "chapter_id": 5368, "verse_number": "१८", "content_sanskrit": "पात्रभूतं तु दूरस्थमभिगम्य प्रसाद्य च ।\nदाता दानं तथा दद्याद् यथा तुष्येत तेन सः ।\nएष दानविधिः श्रेष्ठः समाहूय तु मध्यमः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2205029, "chapter_id": 5368, "verse_number": "१९", "content_sanskrit": "पूर्वं च पात्रतां ज्ञात्वा समाहूय निवेद्य च ।\nशौचार्चनसमायुक्तं दातव्यं श्रद्धया प्रिये\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2205030, "chapter_id": 5368, "verse_number": "२०", "content_sanskrit": "याचितॄणां तु परममाभिमुख्यपुरस्कृतम् ।\nसम्मानपूर्वं सङ्ग्राह्यं दातव्यं देशकालयोः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2205031, "chapter_id": 5368, "verse_number": "२१", "content_sanskrit": "अपात्रेभ्योऽपि चान्येभ्यो दातव्यं भूतिमिच्छता ।\nपात्राणि सम्परीक्ष्यैव दाता वै दानमात्रयोः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2205032, "chapter_id": 5368, "verse_number": "२२", "content_sanskrit": "अतिशक्त्या परं दानं यथाशक्ति तु मध्यमम् ।\nतृतीयं त्ववरं दानं दानरूपमिवात्मनः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2205033, "chapter_id": 5368, "verse_number": "२३", "content_sanskrit": "यथा सम्भावितं पूर्वं दातव्यं तत् तथैव च ।\nपुण्यक्षेत्रेषु यद् दत्तं पुण्यकालेषु वा यथा ।\nतच्छोभनतरं विद्धि गौरवाद् देशकालयोः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2205034, "chapter_id": 5368, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2205035, "chapter_id": 5368, "verse_number": "२४", "content_sanskrit": "यश्च पुण्यतमो देशस्तथा कालश्च शंस मे\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2205036, "chapter_id": 5368, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2205037, "chapter_id": 5368, "verse_number": "२५", "content_sanskrit": "कुरुक्षेत्रं महानद्यो यश्च देवर्षिसेवितम् ।\nगिरिर्वरश्च तीर्थानि देशभागेषु पूजिताः ।\nग्रहीतुरीप्सितो यश्च तत्र दत्तं महाफलम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2205038, "chapter_id": 5368, "verse_number": "२६", "content_sanskrit": "शरद्वसन्तकालश्च पुण्यमासस्तथैव च ।\nशुद्धपक्षश्च पक्षान्तः पौर्णमासी च पर्वसु\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2205039, "chapter_id": 5368, "verse_number": "२७", "content_sanskrit": "पितृदैवतनक्षत्रं निर्मला दिवसास्तथा ।\nतच्छोभनतरं विद्धि चन्द्रसूर्यग्रहं तथा\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2205040, "chapter_id": 5368, "verse_number": "२८", "content_sanskrit": "प्रतिग्रहीतुर्यः कालो मनसा कीर्तितः शुभे ।\nएवमादिषु कालेषु दत्तं दानं महद् भवेत्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2205041, "chapter_id": 5368, "verse_number": "२९", "content_sanskrit": "दाता देयं च पात्रं च उपक्रमयुता क्रिया ।\nदेशः कालश्च इत्येषां सम्पच्छुद्धिः प्रकीर्तिता\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2205042, "chapter_id": 5368, "verse_number": "३०", "content_sanskrit": "यत्रैव युगपत् सम्पत् तत्र शुद्धिर्महद् भवेत्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2205043, "chapter_id": 5368, "verse_number": "३१", "content_sanskrit": "अत्यल्पमपि यद् दानमेभिः षड्भिर्गुणैर्युतम् ।\nभूत्वाऽनन्तं नयेत् स्वर्गं दातारं दोषवर्जितम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2205044, "chapter_id": 5368, "verse_number": "३२", "content_sanskrit": "सुमहद्वाऽपि यद् दानं गुणैरेभिर्विनाकृतम् ।\nअत्यल्पफलनिर्योगमफलं वा भवेद्धि तत्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2205045, "chapter_id": 5368, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2205046, "chapter_id": 5368, "verse_number": "३३", "content_sanskrit": "एवं गुणयुतं दानं दत्तं त्वफलतां व्रजेत् ।\nतदस्ति चेन्महद् देयं तन्मे शंसितुमर्हसि\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2205047, "chapter_id": 5368, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2205048, "chapter_id": 5368, "verse_number": "३४", "content_sanskrit": "तदप्यस्ति महाभागे नराणां भावदोषतः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2205049, "chapter_id": 5368, "verse_number": "३५", "content_sanskrit": "कृत्वा तु धर्मं विधिवत् पश्चात्तापं करोति चेत् ।\nश्लाघया वा यदि ब्रूयाद् वृथा संसदि यत्कृतम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2205050, "chapter_id": 5368, "verse_number": "३६", "content_sanskrit": "प्रकल्पयेच्च मनसा तत्फलं प्रेत्यभावतः ।\nधर्मकार्यकृतं यच्च सततं फलकाङ्क्षया ।\nएवं कृतं वा दत्तं वा परत्र विफलं भवेत्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2205051, "chapter_id": 5368, "verse_number": "३७", "content_sanskrit": "एते दोषा विवर्ज्याश्च दातृभिः पुण्यकाङ्क्षिभिः ।\nसनातनमिदं वृत्तं सद्भिराचरितं तथा\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2205052, "chapter_id": 5368, "verse_number": "३८", "content_sanskrit": "अनुग्रहात् परेषां तु गृहस्थानामृणं हि तत् ।\nइत्येवं मन आवेश्य दातव्यं सततं बुधैः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2205053, "chapter_id": 5368, "verse_number": "३९", "content_sanskrit": "एवमेव कृतं नित्यं सुकृतं तद् भवेन्महत् ।\nसर्वसाधारणं द्रव्यमेवं दत्त्वा महत्फलम्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2205054, "chapter_id": 5368, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे तृतीयसुकृतकथनं नाम एकोनविंशत्युत्तरद्विशततमोऽध्यायः ॥२१९॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]