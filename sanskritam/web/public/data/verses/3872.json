[{"id": 2133112, "chapter_id": 3872, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2133113, "chapter_id": 3872, "verse_number": "१", "content_sanskrit": "कश्चिद् द्विजातिप्रवरो वेदाध्यायी तपोधनः ।\nतपस्वी धर्मशीलश्च कौशिको नाम भारत \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2133114, "chapter_id": 3872, "verse_number": "२", "content_sanskrit": "साङ्गोपनिषदो वेदानधीते द्विजसत्तमः ।\nस वृक्षमूले कस्मिंश्चिद् वेदानुच्चारयन् स्थितः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2133115, "chapter_id": 3872, "verse_number": "३", "content_sanskrit": "उपरिष्टाच्च वृक्षस्य बलाका सन्न्यलीयत ।\nतया पुरीषमुत्सृष्टं ब्राह्मणस्य तदोपरि \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2133116, "chapter_id": 3872, "verse_number": "४", "content_sanskrit": "तामवेक्ष्य ततः क्रुद्धः समवध्यायत द्विजः ।\nतां बलाकां महाराज निलीनां नगमूर्धनि\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2133117, "chapter_id": 3872, "verse_number": "५", "content_sanskrit": "भृशं क्रोधाभिभूतेन बलाका सा निरीक्षिता ।\nअपध्याता च विप्रेण न्यपतद् धरणीतळे\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2133118, "chapter_id": 3872, "verse_number": "६", "content_sanskrit": "बलाकां पतितां दृष्ट्वा गतसत्त्वामचेतनाम् ।\nकारुण्यादभिसन्तप्तः पर्यशोचत तां द्विजः ।\nअकार्यं कृतवानस्मि रोषरागबलात् कृतः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2133119, "chapter_id": 3872, "verse_number": "७", "content_sanskrit": "इत्युक्त्वा बहुशो विद्वान् ग्रामं भैक्ष्याय संश्रितः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2133120, "chapter_id": 3872, "verse_number": "८", "content_sanskrit": "ग्रामे शुचीनि प्रचरन् कुलानि भरतर्षभ ।\nप्रविष्टस्तत्कुलं यत्र पूर्वं चरितवांस्तु सः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2133121, "chapter_id": 3872, "verse_number": "९", "content_sanskrit": "देहीति याचमानोऽसौ तिष्ठेत्युक्तः स्त्रिया ततः ।\nशौचं तु यावत् कुरुते भाजनस्य कुटुम्बिनी\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2133122, "chapter_id": 3872, "verse_number": "१०", "content_sanskrit": "एतस्मिन्नन्तरे राजन् क्षुधासम्पीडितो भृशम् ।\nभर्ता प्रविष्टः सहसा तस्या भरतसत्तम\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2133123, "chapter_id": 3872, "verse_number": "११", "content_sanskrit": "सा तु दृष्ट्वा पतिं साध्वी ब्राह्मणं व्यवहाय तम् ।\nपाद्यमाचमनीयं वै ददौ भर्तुस्तथाऽऽसनम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2133124, "chapter_id": 3872, "verse_number": "१२", "content_sanskrit": "प्रह्वा पर्यचरच्चापि भर्तारमसितेक्षणा ।\nआहारेणाथ भक्ष्यैश्च भोज्यैः सुमधुरैस्तथा\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2133125, "chapter_id": 3872, "verse_number": "१३", "content_sanskrit": "उच्छिष्टं भाविता भर्तुर्भुङ्क्ते नित्यं युधिष्ठिर ।\nदैवतं च पतिं मेने भर्तुश्चित्तानुसारिणी\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2133126, "chapter_id": 3872, "verse_number": "१४", "content_sanskrit": "कर्मणा मनसा वाचा नान्यचित्ताऽभ्यगात् पतिम् ।\nतं सर्वभावोपगता पतिशुश्रूषणे रता\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2133127, "chapter_id": 3872, "verse_number": "१५", "content_sanskrit": "साध्वाचारा शुचिर्दक्षा कुटुम्बस्य हितैषिणी ।\nभर्तुश्चापि हितं यत्तत् सततं सानुवर्तते \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2133128, "chapter_id": 3872, "verse_number": "१६", "content_sanskrit": "देवतातिथिभृत्यानां श्वश्रूश्वशुरयोस्तथा ।\nशुश्रूषणपरा नित्यं सततं संयतेन्द्रिया \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2133129, "chapter_id": 3872, "verse_number": "१७", "content_sanskrit": "सा ब्राह्मणं तदा दृष्ट्वा संस्थितं भैक्ष्यकाङ्क्षिणम् ।\nकुर्वती पतिशुश्रूषां सस्माराथ शुभेक्षणा \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2133130, "chapter_id": 3872, "verse_number": "१८", "content_sanskrit": "व्रीडिता साऽभवत् साध्वी तदा भरतसत्तम ।\nभिक्षामादाय विप्राय निर्जगाम यशस्विनी\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2133131, "chapter_id": 3872, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2133132, "chapter_id": 3872, "verse_number": "१९", "content_sanskrit": "किमिदं भवति त्वं मां तिष्ठेत्युक्त्वा वराङ्गने ।\nउपरोधं कृतवती न विसर्जितवत्यसि\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2133133, "chapter_id": 3872, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2133134, "chapter_id": 3872, "verse_number": "२०", "content_sanskrit": "ब्राह्मणं क्रोधसन्तप्तं ज्वलन्तमिव तेजसा ।\nदृष्ट्वा साध्वी मनुष्येन्द्र सान्त्वपूर्वं वचोऽब्रवीत्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2133135, "chapter_id": 3872, "verse_number": "२१", "content_sanskrit": "क्षमस्व विप्रप्रवर क्षमस्व स्त्रीजडात्मताम् ।\nप्रसीद भगवन् मह्यं कृपां कुरु मयि द्विज \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2133136, "chapter_id": 3872, "verse_number": "२२", "content_sanskrit": "क्षन्तुमर्हसि मे विद्वन् भर्ता मे दैवतं महत् ।\nस चापि क्षुधितः श्रान्तः प्राप्तः शुश्रूषितो मया\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2133137, "chapter_id": 3872, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2133138, "chapter_id": 3872, "verse_number": "२३", "content_sanskrit": "ब्राह्मणा न गरीयांसो गरीयांस्ते पतिः कृतः ।\nगृहस्थधर्मे वर्तन्ती ब्राह्मणानवमन्यसे\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2133139, "chapter_id": 3872, "verse_number": "२४", "content_sanskrit": "इन्द्रोऽप्येषां प्रणमते किं पुनर्मानवो भुवि ।\nअवलिप्ते न जानीषे वृद्धानां न श्रुतं त्वया\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2133140, "chapter_id": 3872, "verse_number": "२५", "content_sanskrit": "ब्राह्मणा ह्यग्निसदृशा दहेयुः पृथिवीमपि ।\nसपर्वतवनद्वीपं क्षिप्रमेवावमानिताः \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2133141, "chapter_id": 3872, "verse_number": "", "content_sanskrit": "साध्वी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2133142, "chapter_id": 3872, "verse_number": "२६", "content_sanskrit": "नाहं बलाका विप्रर्षे त्यज क्रोधं तपोधन ।\nअनया क्रुद्धया दृष्ट्या क्रुद्धः किं मां करिष्यसि \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2133143, "chapter_id": 3872, "verse_number": "२७", "content_sanskrit": "नावजानाम्यहं विप्रान् देवैस्तुल्यान् मनस्विनः ।\nअपराधमिमं विप्र क्षन्तुमर्हसि मेऽनघ \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2133144, "chapter_id": 3872, "verse_number": "२८", "content_sanskrit": "जानामि तेजो विप्राणां महाभाग्यं च धीमताम् ।\nअपेयः सागरः क्रोधात् कृतो हि लवणोदकः\t ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2133145, "chapter_id": 3872, "verse_number": "२९", "content_sanskrit": "तथैव दीप्ततपसां मुनीनां भावितात्मनाम् ।\nयेषां क्रोधाग्निरद्यापि दण्डके नोपशाम्यति ।\nकस्तान् परिभवेन्मूढो ब्राह्मणानमितौजसः \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2133146, "chapter_id": 3872, "verse_number": "३०", "content_sanskrit": "ब्राह्मणानां परिभवाद् वातापिः सुदुरात्मवान् ।\nअगस्त्यमृषिमासाद्य जीर्णः क्रूरो महासुरः \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2133147, "chapter_id": 3872, "verse_number": "३१", "content_sanskrit": "बहुप्रभावाः श्रूयन्ते ब्राह्मणानां महात्मनाम् ।\nक्रोधः सुविपुलो ब्रह्मन् प्रसादश्च महात्मनाम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2133148, "chapter_id": 3872, "verse_number": "३२", "content_sanskrit": "अस्मिंस्त्वतिक्रमे ब्रह्मन् क्षन्तुमर्हसि मेऽनघ\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2133149, "chapter_id": 3872, "verse_number": "३३", "content_sanskrit": "पतिशुश्रूषया धर्मो यः स मे रोचते द्विज ।\nदैवतेष्वपि सर्वेषु भर्ता मे दैवतं परम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2133150, "chapter_id": 3872, "verse_number": "३४", "content_sanskrit": "अविशेषेण तस्याहं कुर्यां धर्मं द्विजोत्तम ।\nशुश्रूषायाः फलं पश्य पत्युर्ब्राह्मण यादृशम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2133151, "chapter_id": 3872, "verse_number": "३५", "content_sanskrit": "बलाका हि त्वया दग्धा रोषात् तद् विदितं मया ।\nक्रोधः शत्रुः शरीरस्थो मनुष्याणां द्विजोत्तम \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2133152, "chapter_id": 3872, "verse_number": "३६", "content_sanskrit": "मा स्म ऋद्धो बलाकेव न वध्यास्मि पतिव्रता ।\nयः क्रोधमोहौ त्यजति तं देवा ब्राह्मणं विदुः \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2133153, "chapter_id": 3872, "verse_number": "३७", "content_sanskrit": "यो वदेदिह सत्यानि गुरुं सन्तोषयिष्यति(येत च)।\nहिंसितश्च न हिंसेत तं देवा ब्राह्मणं विदुः \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2133154, "chapter_id": 3872, "verse_number": "३८", "content_sanskrit": "जितेन्द्रियो धर्मपरः स्वाध्यायनिरतः शुचिः ।\nकामक्रोधौ वशौ यस्य तं देवा ब्राह्मणं विदुः \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2133155, "chapter_id": 3872, "verse_number": "३९", "content_sanskrit": "योध्यापयेदधीयेद्वा याजयेत यजेत वा ।\nदद्याद् वापि यथाशक्ति तं देवा ब्राह्मणं विदुः \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2133156, "chapter_id": 3872, "verse_number": "४०", "content_sanskrit": "ब्रह्मचारी वदान्यो योऽधीयीत द्विजपुङ्गवः ।\nसर्वधर्मेषु च रतस्तं देवा ब्राह्मणं विदुः \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2133157, "chapter_id": 3872, "verse_number": "४१", "content_sanskrit": "योऽध्यापयेदधीयीत यजेद्वा याजयीत वा ।\nदद्याद्वापि यथाशक्ति तं देवा ब्राह्मणं विदुः \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2133158, "chapter_id": 3872, "verse_number": "४२", "content_sanskrit": "ब्रह्मचारी वदान्यो योप्यधीयाद् द्विजपुङ्गवः ।\nस्वाध्ययवानमत्तो वै तं देवा ब्राह्मणं विदुः \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2133159, "chapter_id": 3872, "verse_number": "४३", "content_sanskrit": "यद् ब्राह्मणानां कुशलं तदेषां परिकीर्तयेत् ।\nसत्यं तथा व्याहरतां नानृते रमते मनः \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2133160, "chapter_id": 3872, "verse_number": "४४", "content_sanskrit": "धर्मं तु ब्राह्मणस्याहुः स्वाध्यायं दममार्जवम् ।\nइन्द्रियाणां निग्रहं च शाश्वतं द्विजसत्तम\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2133161, "chapter_id": 3872, "verse_number": "४५", "content_sanskrit": "सत्यार्जवे धर्ममाहुः परं धर्मविदो जनाः ।\nदुर्ज्ञेयः शाश्वतो धर्मः स च सत्ये प्रतिष्ठितः \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2133162, "chapter_id": 3872, "verse_number": "४६", "content_sanskrit": "श्रुतिप्रमाणो धर्मः स्यादिति वृद्धानुशासनम् ।\nबहुधा दृश्यते धर्मः सूक्ष्म एव द्विजोत्तम \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2133163, "chapter_id": 3872, "verse_number": "४७", "content_sanskrit": "भवानपि च धर्मज्ञः स्वाध्यायनिरतः शुचिः ।\nन तु तत्त्वेन भगवन् धर्मं वेत्सीति मे मतिः \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2133164, "chapter_id": 3872, "verse_number": "४८", "content_sanskrit": "यदि विप्र न जानीषे धर्मं परमकं द्विज ।\nधर्मव्याधं ततः पृच्छ गत्वा तु मिथिलां पुरीम् \t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2133165, "chapter_id": 3872, "verse_number": "४९", "content_sanskrit": "मातापितृभ्यां शुश्रूषुः सत्यवादी जितेन्द्रियः ।\nमिथिलायां वसेद् व्याधः स ते धर्मान् प्रवक्ष्यति\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2133166, "chapter_id": 3872, "verse_number": "५०", "content_sanskrit": "तत्र गच्छस्व भद्रं ते यथाकामं द्विजोत्तम ।\nव्याधः परमधर्मात्मा स ते च्छेत्स्यति संशयान्\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2133167, "chapter_id": 3872, "verse_number": "५१", "content_sanskrit": "अत्युक्तमपि मे सर्वं क्षन्तुमर्हस्यनिन्दित ।\nस्त्रियो ह्यवध्याः सर्वेषां ये च धर्मविदो जनाः \t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2133168, "chapter_id": 3872, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2133169, "chapter_id": 3872, "verse_number": "५२", "content_sanskrit": "प्रीतोऽस्मि तव भद्रं ते गतः क्रोधश्च शोभने ।\nउपालम्भस्त्वयाऽत्युक्तो मम निश्रेयसं परम्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2133170, "chapter_id": 3872, "verse_number": "५३", "content_sanskrit": "स्वस्ति तेऽस्तु गमिष्यामि साधयिष्यामि शोभने ।\nधन्या त्वमसि कल्याणि यस्यास्ते वृत्तमीदृशम्\t ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2133171, "chapter_id": 3872, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2133172, "chapter_id": 3872, "verse_number": "५४", "content_sanskrit": "तया विसृष्टो निर्गम्य स्वमेव भवनं ययौ ।\nविनिन्दन् स स्वमात्मानं कौशिको द्विजसत्तमः \t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2133173, "chapter_id": 3872, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि मार्कण्डेयसमास्यापर्वणि त्रिनवत्यधिकशततमोऽध्यायः ॥१९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2133174, "chapter_id": 3872, "verse_number": "", "content_sanskrit": "॥ मार्कण्डेयसमस्यापर्वणि अष्टादशोऽध्यायः ॥१८॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}]