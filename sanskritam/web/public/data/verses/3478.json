[{"id": 2115180, "chapter_id": 3478, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2115181, "chapter_id": 3478, "verse_number": "१", "content_sanskrit": "सा तानेवापतत् तूर्णं भगिनी राक्षसस्य ह ।\nअब्रुवाणा हिडिम्बी तु राक्षसी पाण्डवान् प्रति \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2115182, "chapter_id": 3478, "verse_number": "२", "content_sanskrit": "अभिवाद्य च तान् कुन्तीं धर्मराजं च पाण्डवम् ।\nअभिपूज्य च तान् सर्वान् भीमसेनमभाषत \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2115183, "chapter_id": 3478, "verse_number": "३", "content_sanskrit": "अहं ते दर्शनादेव मन्मथस्य वशं गता ।\nक्रूरं भ्रातृवचो हित्वा सा त्वामेवानिरुन्धती \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2115184, "chapter_id": 3478, "verse_number": "४", "content_sanskrit": "राक्षसे रौद्रसङ्काशे तवापश्यं विचेष्टितम् ।\nअहं शुश्रूषुरिच्छेयं तव गात्रं निषेवितुम् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2115185, "chapter_id": 3478, "verse_number": "", "content_sanskrit": "भीमसेनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2115186, "chapter_id": 3478, "verse_number": "५", "content_sanskrit": "स्मरन्ति वैरं रक्षांसि मायामास्थाय मोहिनीम् ।\nहिडिम्बि व्रज पन्थानं मा त्वं भ्रातृनिषेवितम् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2115187, "chapter_id": 3478, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2115188, "chapter_id": 3478, "verse_number": "६", "content_sanskrit": "क्रुद्धोऽपि पुरुषव्याघ्र भीम मा च स्त्रियं वधीः ।\nशरीरगुप्त्यभ्यधिकं धर्मं गोपाय पाण्डव \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2115189, "chapter_id": 3478, "verse_number": "७", "content_sanskrit": "वधाभिप्रायमवधीस्त्वं महाबलराक्षसम् ।\nरक्षसस्तस्य भगिनी किं नः क्रुद्धा करिष्यति \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2115190, "chapter_id": 3478, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2115191, "chapter_id": 3478, "verse_number": "८", "content_sanskrit": "हिडिम्बी तु ततः कुन्तीमभिवाद्य कृताञ्जलिः ।\nयुधिष्ठिरं तु कौन्तेयमिदं वचनमब्रवीत् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2115192, "chapter_id": 3478, "verse_number": "९", "content_sanskrit": "आर्ये जानासि यद् दुःखमिह स्त्रीणामनङ्गजम् ।\nतदिदं मामनुप्राप्तं भीमसेनकृतं शुभे \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2115193, "chapter_id": 3478, "verse_number": "१०", "content_sanskrit": "साऽहं तत् परमं दुःखं सहे कालप्रतीक्षया ।\nसोऽयमभ्यागतः कालो भविता मे सुखावहः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2115194, "chapter_id": 3478, "verse_number": "११", "content_sanskrit": "मया ह्युत्सृज्य सुहृदो ज्ञातीन् स्वं धर्ममेव च ।\nवृतोऽयं पुरुषव्याघ्रस्तव पुत्रः पतिः शुभः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2115195, "chapter_id": 3478, "verse_number": "१२", "content_sanskrit": "वरेणानेन तु विना नाहं जीवितुमुत्सहे ।\nतदर्हसि कृपां कर्तुं मयि त्वं वरवर्णिनि \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2115196, "chapter_id": 3478, "verse_number": "१३", "content_sanskrit": "त्वं मां मूढेति वा मत्वा भक्तां वाऽनुगतेति वा ।\nभर्त्राऽनेन महाभागे योजयस्व सुतेन ते \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2115197, "chapter_id": 3478, "verse_number": "१४", "content_sanskrit": "तमुपादाय गच्छेयं यथेष्टं देवरूपिणम् ।\nपुनश्चैवानयिष्यामि विश्वासं कुरु मे शुभे \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2115198, "chapter_id": 3478, "verse_number": "१५", "content_sanskrit": "अहं हि समये लिप्से प्राग् भ्रातुरपवर्जनात् ।\nततः सोऽभ्यपतद् रात्रौ भीमसेनजिघांसया \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2115199, "chapter_id": 3478, "verse_number": "१६", "content_sanskrit": "यथायथा विक्रमते यथाऽरिमधितिष्ठति ।\nतथातथा समाधाय पाण्डवं काममोहिता \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2115200, "chapter_id": 3478, "verse_number": "१७", "content_sanskrit": "न यातुधान्यहं त्वार्ये न चास्मि रजनीचरी ।\nईशा रक्षस्सुता यास्मि राज्ञि सालकटङ्कटी \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2115201, "chapter_id": 3478, "verse_number": "१८", "content_sanskrit": "पुत्रेण तव संयुक्ता युवतिर्देववर्णिनी ।\nसर्वान् वोऽहमुपस्थास्ये पुरस्कृत्य वृकोदरम् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2115202, "chapter_id": 3478, "verse_number": "१९", "content_sanskrit": "अप्रमत्ता प्रमत्तेषु शुश्रूषुरनहंवदा ।\nव्रजिनं तारयिष्यामि दासीवच्च नरर्षभाः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2115203, "chapter_id": 3478, "verse_number": "२०", "content_sanskrit": "पृष्ठेन वो वहिष्यामि विमानं सुकृतानिव ।\nयूयं प्रसादं कुरुत भीमसेनो भजेत माम् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2115204, "chapter_id": 3478, "verse_number": "२१", "content_sanskrit": "एवं ब्रुवन्तीह तथा प्रत्याख्याता क्रियां प्रति ।\nभूम्यां दुष्कृतिनो लोकान् गमिष्येऽहं न संशयः॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2115205, "chapter_id": 3478, "verse_number": "२२", "content_sanskrit": "अहं हि मनसा ध्यात्वा सर्वं वेत्स्यामि सर्वदा ।\nआपन्निस्तरणे प्राणान् धारयेद् येन केनचित्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2115206, "chapter_id": 3478, "verse_number": "२३", "content_sanskrit": "सर्वमापत्सु कर्तव्यं तद् धर्ममनुपश्यता ।\nआपत्सु यो धारयति स वै धर्मविदुत्तमः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2115207, "chapter_id": 3478, "verse_number": "२४", "content_sanskrit": "व्यसनं ह्येव धर्मस्य धर्मिणामापदुच्यते ।\nपुण्यात् प्राणान् धारयति पुण्यं वै प्राणधारणम् \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2115208, "chapter_id": 3478, "verse_number": "२५", "content_sanskrit": "येनयेन चरेद् धर्मं तस्मिन् गर्हा न विद्यते ।\nमहतोऽत्र स्त्रियं कामाद् बाधितां त्राहि मामपि\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2115209, "chapter_id": 3478, "verse_number": "२६", "content_sanskrit": "धर्मार्थकाममोक्षेषु दयां कुर्वन्ति साधवः ।\nतं तु धर्ममिति प्राहुर्मुनयो धर्मवत्सलाः \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2115210, "chapter_id": 3478, "verse_number": "२७", "content_sanskrit": "दिव्यज्ञानेन पश्यामि अतीतानागतानहम् ।\nतस्माद् वक्ष्यामि वः श्रेय आसन्नं सर उत्तमम् \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2115211, "chapter_id": 3478, "verse_number": "२८", "content_sanskrit": "अत्र श्रान्ताः पुनः स्नात्वा विश्राम्य च वनस्पतौ ।\nश्वः प्रभाते महद्भूतं प्रादुर्भूतं जनार्दनम् \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2115212, "chapter_id": 3478, "verse_number": "२९", "content_sanskrit": "व्यासं कमलपत्राक्षं दृष्ट्वा शोकं विहास्यथ ।\nधार्तराष्ट्राद् विवासश्च दहनं वारणावते \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2115213, "chapter_id": 3478, "verse_number": "३०", "content_sanskrit": "त्राणं च विदुरात् तुभ्यं विदितं ज्ञानचक्षुषा ।\nआवासे शालिहोत्रस्य स च वासं विधास्यति \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2115214, "chapter_id": 3478, "verse_number": "३१", "content_sanskrit": "वर्षवातातपसह अयं पुण्यो वनस्पतिः ।\nपीतमात्रे तु पानीये क्षुत्पिपासे विनश्यतः \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2115215, "chapter_id": 3478, "verse_number": "३२", "content_sanskrit": "तपसा शालिहोत्रेण सरो वृक्षश्च निर्मितः ।\nकादम्बाः सारसा हंसाः कुरर्यः कुररैः सह ।\nरुवन्ति मधुरं गीतं गान्धर्वस्वनमिश्रितम् \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2115216, "chapter_id": 3478, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2115217, "chapter_id": 3478, "verse_number": "३३", "content_sanskrit": "तस्यास्तद्वचनं श्रुत्वा कुन्ती वचनमब्रवीत् ।\nयुधिष्ठिरं महाप्राज्ञं सर्वशास्त्रविशारदम् \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2115218, "chapter_id": 3478, "verse_number": "३४", "content_sanskrit": "त्वं हि धर्मभृतां श्रेष्ठ मयोक्तं शृणु भारत ।\nराक्षस्येषा हि वाक्येन धर्मं वदति साधु वै \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2115219, "chapter_id": 3478, "verse_number": "३५", "content_sanskrit": "भावेन दुष्टा भीमं सा किं करिष्यति राक्षसी ।\nभजतां पाण्डवं वीरमपत्यार्थं यदीच्छसि \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2115220, "chapter_id": 3478, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2115221, "chapter_id": 3478, "verse_number": "३६", "content_sanskrit": "एवमेतद् यथाऽऽत्थ त्वं हिडिम्बे नात्र संशयः ।\nस्थातव्यं तु त्वया धर्मे यथा ब्रूयाः सुमध्यमे\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2115222, "chapter_id": 3478, "verse_number": "३७", "content_sanskrit": "नित्यं कृताह्निका स्नाता कृतशौचा सुरूपिणी ।\nस्नातं कृताह्निकं भद्रे कृतकौतुकमङ्गलम् \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2115223, "chapter_id": 3478, "verse_number": "३८", "content_sanskrit": "भीमसेनं भजेथास्त्वमुदिते वै दिवाकरे ।\nअहस्सु विचरानेन यथाकामं मनोजवा \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2115224, "chapter_id": 3478, "verse_number": "३९", "content_sanskrit": "आनेतव्यस्त्वया भद्रे भीमसेनः सदा निशि ।\nप्राक् सन्ध्यातो विमोक्तव्यो रक्षितव्यश्च नित्यशः \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2115225, "chapter_id": 3478, "verse_number": "४०", "content_sanskrit": "एवं रमस्व भीमेन यावद् गर्भस्य वेदनम् ।\nएष ते समयो भद्रे शुश्रूष्यश्चाप्रमत्तया ।\nनित्यानुकूलया भूत्वा कर्तव्यं शोभनं त्वया \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2115226, "chapter_id": 3478, "verse_number": "१५७", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nसप्तपञ्चाशदधिकशततमोऽध्यायः ॥१५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2115227, "chapter_id": 3478, "verse_number": "५", "content_sanskrit": "॥ इति हिडिम्बवधपर्वणि पञ्चमोऽध्यायः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2115228, "chapter_id": 3478, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]