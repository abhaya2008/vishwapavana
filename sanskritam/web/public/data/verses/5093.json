[{"id": 2192495, "chapter_id": 5093, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2192496, "chapter_id": 5093, "verse_number": "१", "content_sanskrit": "धर्माधर्मविमुक्तंयद् विमुक्तं सर्वसंश्रयात्।\nजन्ममृत्युविमुक्तं च विमुक्तं पुण्यपापयोः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2192497, "chapter_id": 5093, "verse_number": "२", "content_sanskrit": "यच्छिवं नित्यमभयं नित्यं चाक्षरमव्ययम् ।\nशुचि नित्यमनायासं तद् भवान्वक्तुमर्हति\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2192498, "chapter_id": 5093, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2192499, "chapter_id": 5093, "verse_number": "३", "content_sanskrit": "अत्र ते वर्तयिष्येऽहमितिहासं पुरातनम् ।\nयाज्ञवल्क्यस्य संवादं जनकस्य च भारत\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2192500, "chapter_id": 5093, "verse_number": "४", "content_sanskrit": "याज्ञवल्क्यमृषिश्रेष्ठं दैवरातिर्महायशाः ।\nपप्रच्छ जनको राजा प्रश्नं प्रश्नविदां वरः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2192501, "chapter_id": 5093, "verse_number": "५", "content_sanskrit": "कतीन्द्रियाणि विप्रर्षेकति प्रकृतयः स्मृताः ।\nकिमव्यक्तं परं ब्रह्मतस्माच्च परतस्तु किम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2192502, "chapter_id": 5093, "verse_number": "६", "content_sanskrit": "प्रभवं चाप्ययं चैव कालसङ्ख्यां तथैव च ।\nवक्तुमर्हसि विप्रेन्द्र त्वदनुग्रहकाङ्क्षिणः॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2192503, "chapter_id": 5093, "verse_number": "७", "content_sanskrit": "अज्ञानात् परिपृच्छामि त्वं हि ज्ञानमयो निधिः।\nतदहं श्रोतुमिच्छामि सर्वमेतदसंशयम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2192504, "chapter_id": 5093, "verse_number": "", "content_sanskrit": "याज्ञवल्क्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2192505, "chapter_id": 5093, "verse_number": "८", "content_sanskrit": "श्रूयतामवनीपाल यदेतदनुपृच्छसि ।\nयोगानां परमं ज्ञानं साङ्ख्यानां च विशेषतः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2192506, "chapter_id": 5093, "verse_number": "९", "content_sanskrit": "न तवाविदितं किञ्चिन्मां तु जिज्ञासतेभवान् ।\nपृष्टेन चापि वक्तव्यमेष धर्मः सनातनः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2192507, "chapter_id": 5093, "verse_number": "१०", "content_sanskrit": "अष्टौ प्रकृतयः प्रोक्ता विकाराश्चापि षोडश ।\nअथ सप्त तु व्यक्तानि प्राहुरध्यात्मचिन्तकाः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2192508, "chapter_id": 5093, "verse_number": "११", "content_sanskrit": "अव्यक्तं च महांश्चैव तथाहङ्कार एव च ।\nपृथिवी वायुराकाशमापो ज्योतिश्च पञ्चमम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2192509, "chapter_id": 5093, "verse_number": "१२", "content_sanskrit": "एताः प्रकृतयस्त्वष्टौ विकारानपि मे शृणु ।\nश्रोत्रं त्वक्चैव चक्षुश्च जिह्वा घ्राणं च पञ्चमम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2192510, "chapter_id": 5093, "verse_number": "१३", "content_sanskrit": "शब्दस्पर्शौ च रूपं च रसो गन्धस्तथैव च ।\nवाक्च हस्तौ च पादौ च पायुर्मेढ्रं तथैव च\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2192511, "chapter_id": 5093, "verse_number": "१४", "content_sanskrit": "एते विशेषा राजेन्द्र महाभूतेषु पञ्चसु ।\nबुद्धीन्द्रियाण्यथैतानि सविशेषाणि मैथिल\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2192512, "chapter_id": 5093, "verse_number": "१५", "content_sanskrit": "मनः षोडशकंप्राहुरध्यात्मगतिचिन्तकाः ।\nत्वं चैवान्ये च विद्वांसस्तत्त्वबुद्धिविशारदाः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2192513, "chapter_id": 5093, "verse_number": "१६", "content_sanskrit": "अव्यक्ताच्च महानात्मा समुत्पद्यति पार्थिव ।\nप्रथमं सर्गमित्येतदाहुःप्राधानिकं बुधाः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2192514, "chapter_id": 5093, "verse_number": "१७", "content_sanskrit": "महतश्चाप्यहङ्कार उत्पद्यति नराधिप ।\nद्वितीयं सर्गमित्याहुरेतद् बुद्ध्यात्मकं स्मृतम्॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2192515, "chapter_id": 5093, "verse_number": "१८", "content_sanskrit": "अहङ्काराच्च सम्भूतं मनो भूतगुणात्मकम् ।\nतृतीयः सर्ग इत्येष आहङ्कारिक उच्यते॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2192516, "chapter_id": 5093, "verse_number": "१९", "content_sanskrit": "मनसस्तु समुद्भूता महाभूता नराधिप ।\nचतुर्थं सर्गमित्येतन्मानसंपरिचक्षते\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2192517, "chapter_id": 5093, "verse_number": "२०", "content_sanskrit": "शब्दः स्पर्शश्च रूपं च रसो गन्धस्तथैव च ।\nपञ्चमं सर्गमित्याहुर्भौतिकं भूतचिन्तकाः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2192518, "chapter_id": 5093, "verse_number": "२१", "content_sanskrit": "श्रोत्रं त्वक्चैव चक्षुश्च जिह्वा घ्राणं च पञ्चमम् ।\nसर्गं तु षष्ठमित्याहुर्बहुचिन्तात्मकंस्मृतम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2192519, "chapter_id": 5093, "verse_number": "२२", "content_sanskrit": "अधः स्रोतेन्द्रियग्रामम् उत्पद्यति नराधिप ।\nसप्तमं सर्गमित्याहुरेतदैन्द्रियकं स्मृतम्॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2192520, "chapter_id": 5093, "verse_number": "२३", "content_sanskrit": "ऊर्ध्वं चाधस्तथा तिर्यगुत्पद्यति नराधिप ।\nअष्टमं सर्गमित्याहुरेतदार्जवकं बुधाः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2192521, "chapter_id": 5093, "verse_number": "२४", "content_sanskrit": "तिर्यक्स्रोतस्त्वधःस्रोत उत्पद्यतिनराधिप ।\nनवमं सर्गमित्याहुरेतदार्जवकंबुधाः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2192522, "chapter_id": 5093, "verse_number": "२५", "content_sanskrit": "एतानि नव सर्गाणि तत्त्वानि च नराधिप।\nचतुर्विंशतिरुक्तानि यथाश्रुति निदर्शनात्॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2192523, "chapter_id": 5093, "verse_number": "२६", "content_sanskrit": "अत ऊर्ध्वं महाराज गुणस्यैतस्य तत्त्वतः ।\nमहात्मभिरनुप्रोक्तां कालसङ्ख्यां निबोध मे\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2192524, "chapter_id": 5093, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे द्विचत्वारिंशोत्तरशततमोऽध्यायः ॥१४२॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]