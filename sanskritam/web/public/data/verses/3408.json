[{"id": 2111275, "chapter_id": 3408, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2111276, "chapter_id": 3408, "verse_number": "१", "content_sanskrit": "ततो गत्वा महाबाहुरेकोऽमात्यान् विसृज्य सः ।\nनापश्यदाश्रमे तस्मिंस्तमृषिं संशितव्रतम् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2111277, "chapter_id": 3408, "verse_number": "२", "content_sanskrit": "सोऽपश्यमानस्तमृषिं शून्यं दृष्ट्वा तमाश्रमम् ।\nउवाच कोऽत्र इत्युच्चैर्वनं सन्नादयन्निव\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2111278, "chapter_id": 3408, "verse_number": "३", "content_sanskrit": "श्रुत्वाऽथ तस्य तं शब्दं कन्या श्रीरिव रूपिणी ।\nनिश्चक्रामाश्रमात् तस्माद् यथा विद्युद् घनान्तरात्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2111279, "chapter_id": 3408, "verse_number": "४", "content_sanskrit": "सा तं दृष्टैव राजानं दुष्षन्तमसितेक्षणा ।\nसुव्रताऽभ्यागतं तं तु पूज्यं प्राप्तमथेश्वरम् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2111280, "chapter_id": 3408, "verse_number": "५", "content_sanskrit": "रूपयौवनसम्पन्ना शीलाचारवती शुभा ।\nसा तमायतपद्माक्षं व्यूढोरस्कं सुसंहितम् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2111281, "chapter_id": 3408, "verse_number": "६", "content_sanskrit": "सिंहस्कन्धं दीर्घबाहुं सर्वलक्षणपूजितम् ।\nविस्पष्टं मधुरां वाचं साऽब्रवीज्जनमेजय \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2111282, "chapter_id": 3408, "verse_number": "७", "content_sanskrit": "स्वागतं त इति क्षिप्रमुक्त्वा तं प्रत्यपूजयत् ।\nआसनेनार्चयित्वाऽथ पाद्यार्घ्याचमनैस्तथा \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2111283, "chapter_id": 3408, "verse_number": "८", "content_sanskrit": "पप्रच्छानामयं राजन् कुशलं च नराधिपम् ।\nयथावदर्चयित्वा सा लज्जयाऽवनतानना \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2111284, "chapter_id": 3408, "verse_number": "९", "content_sanskrit": "उवाच स्मयमानेव किं कार्यं क्रियतां मया ।\nआश्रमस्याभिगमने किं त्वं कार्यं चिकीर्षसि\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2111285, "chapter_id": 3408, "verse_number": "१०", "content_sanskrit": "कस्त्वमद्येह सम्प्राप्तो महर्षेराश्रमं शुभम् ।\nतामब्रवीत् ततो राजा कन्यां मधुरभाषिणीम् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2111286, "chapter_id": 3408, "verse_number": "११", "content_sanskrit": "दृष्ट्वा सर्वानवद्याङ्गीं यथावत् प्रतिपूजितः ।\nराजर्षेरस्मि पुत्रोऽहमिलिलस्य महात्मनः ।\nदुष्षन्त इति मे नाम सत्यं पुष्करलोचने \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2111287, "chapter_id": 3408, "verse_number": "", "content_sanskrit": "शकुन्तला", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2111288, "chapter_id": 3408, "verse_number": "१२", "content_sanskrit": "स्वागतं ते महाराज फलमूलोदकं च नः ।\nप्रतिगृह्योपभुङ्क्ष्व त्वं किं च ते करवाण्यहम् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2111289, "chapter_id": 3408, "verse_number": "", "content_sanskrit": "दुष्षन्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2111290, "chapter_id": 3408, "verse_number": "१३", "content_sanskrit": "आगतोऽहं महाभागे ऋषिं कण्वमुपासितुम् ।\nक्व गतो भगवान् भद्रे तन्ममाचक्ष्व शोभने \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2111291, "chapter_id": 3408, "verse_number": "", "content_sanskrit": "शकुन्तला", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2111292, "chapter_id": 3408, "verse_number": "१४", "content_sanskrit": "गतः पिता मे भगवान् फलान्याहर्तुमाश्रमात् ।\nमुहूर्तं त्वं प्रतीक्षस्व द्रक्ष्यसे तमिहागतम् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2111293, "chapter_id": 3408, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2111294, "chapter_id": 3408, "verse_number": "१५", "content_sanskrit": "अपश्यमानस्तमृषिं तथा चोक्तस्तया नृपः ।\nतां च दृष्ट्वा वरारोहां श्रीमतीं चारुहासिनीम् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2111295, "chapter_id": 3408, "verse_number": "१६", "content_sanskrit": "विभ्राजमानां वपुषा तपसा च दमेन च ।\nरूपयौवनसम्पन्नामित्युवाच महीपतिः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2111296, "chapter_id": 3408, "verse_number": "१७", "content_sanskrit": "काऽसि कस्यासि सुश्रोणि किमर्थं चागता वनम् ।\nएवंरूपगुणोपेता कुतस्त्वमसि शोभने\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2111297, "chapter_id": 3408, "verse_number": "१८", "content_sanskrit": "दर्शनादेव हि शुभे त्वया मेऽपहृतं मनः ।\nस्थितोऽस्म्यमितसौभाग्ये विवक्षुश्चास्मि किञ्चन\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2111298, "chapter_id": 3408, "verse_number": "१९", "content_sanskrit": "शृणु मे नागनासोरु वचनं मत्तकाशिनि ।\nराजर्षेरन्वये जातः पुरोरस्मि विशेषतः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2111299, "chapter_id": 3408, "verse_number": "२०", "content_sanskrit": "वृणे त्वामद्य सुश्रोणि दुष्षन्तो वरवर्णिनि ।\nमनोऽन्यत्र क्षत्रियायां न मे जातु प्रवर्तते \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2111300, "chapter_id": 3408, "verse_number": "२१", "content_sanskrit": "ऋषिपुत्रीषु चान्यासु नावर्णासु परासु वा ।\nतस्मात् प्रब्रूहि चात्मानं विद्धि मां कलभाषिणि\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2111301, "chapter_id": 3408, "verse_number": "२२", "content_sanskrit": "तस्य मे त्वयि भावोऽस्ति क्षत्रिया ह्यसि का वद ।\nन हि मे भीरु विप्रायां मनः प्रसहते गतिम् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2111302, "chapter_id": 3408, "verse_number": "२३", "content_sanskrit": "भजे त्वामायतापाङ्गे भक्तं भजितुमर्हसि ।\nभुङ्क्ष्व राज्यं विशालाक्षि बुद्धिं मा त्वन्यथा कृथाः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2111303, "chapter_id": 3408, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2111304, "chapter_id": 3408, "verse_number": "२३", "content_sanskrit": "एवमुक्ता तदा कन्या एकाकी सा तमाश्रमे ।\nउवाच वसती वाक्यमिदं सुमधुराक्षरम् \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2111305, "chapter_id": 3408, "verse_number": "", "content_sanskrit": "शकुन्तला", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2111306, "chapter_id": 3408, "verse_number": "२४", "content_sanskrit": "कण्वस्याहं भगवतो दुष्षन्त दुहिता मता ।\nतपस्विनो धृतिमतो धर्मज्ञस्य यशस्विनः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2111307, "chapter_id": 3408, "verse_number": "२५", "content_sanskrit": "अस्वतन्त्राऽस्मि राजेन्द्र काश्यपो मे गुरुः पिता ।\nतमेव प्रार्थय स्वार्थं नायुक्तं कर्तुमर्हसि\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2111308, "chapter_id": 3408, "verse_number": "", "content_sanskrit": "दुष्षन्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2111309, "chapter_id": 3408, "verse_number": "२६", "content_sanskrit": "ऊर्ध्वरेता महाभागो भगवाँल्लोकपूजितः ।\nचलेद्धि चित्तं धर्मात् तु न चलेत् संशितव्रतः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2111310, "chapter_id": 3408, "verse_number": "२७", "content_sanskrit": "कथं त्वं तस्य दुहिता सम्भूता वरवर्णिनि ।\nसंशयो मे महानत्र सत्यं वक्तुमिहार्हसि \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2111311, "chapter_id": 3408, "verse_number": "", "content_sanskrit": "शकुन्तला", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2111312, "chapter_id": 3408, "verse_number": "२८", "content_sanskrit": "यथाऽयमागमो मह्यं यथा चेदमभूत् पुरा\nशृणु राजन् यथा तत् त्वं यथाऽस्मि दुहिता मुनेः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2111313, "chapter_id": 3408, "verse_number": "२९", "content_sanskrit": "अन्यथा सन्तमात्मानमन्यथा सत्सु भाषते ।\nस पापेनावृतो मूर्खस्तेन आत्मापहारकः \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2111314, "chapter_id": 3408, "verse_number": "३०", "content_sanskrit": "ऋषिः कश्चिदिहागम्य मम जन्माभ्यचोदयत् ।\nऊर्ध्वरेता यथासि त्वं कुतस्त्येयं शकुन्तला ।\nपुत्री त्वत्तः कथं जाता तत्वं मे ब्रूहि काश्यप\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2111315, "chapter_id": 3408, "verse_number": "", "content_sanskrit": "कण्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2111316, "chapter_id": 3408, "verse_number": "३१", "content_sanskrit": "तप्यमानस्तपो घोरं विश्वामित्रः सखा मम ।\nकम्पयामास देवेन्द्रं पुरा शक्रं महातपाः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2111317, "chapter_id": 3408, "verse_number": "३२", "content_sanskrit": "तपसा दीप्तवीर्योऽयं स्थानान्मां च्यावयेदिति ।\nभीतः पुरन्दरस्तस्मान्मेनकामिदमब्रवीत्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2111318, "chapter_id": 3408, "verse_number": "३३", "content_sanskrit": "गुणैर्दिव्यैरप्सरसां मेनके त्वं विशिष्यसे ।\nश्रेयो मे कुरु कल्याणि यत् त्वां वक्ष्यामि तच्छृणु \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2111319, "chapter_id": 3408, "verse_number": "३४", "content_sanskrit": "असावादित्यसङ्काशो विश्वामित्रो महातपाः ।\nतप्यमानस्तपो घोरं ब्रह्मचर्यं च संश्रितः \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2111320, "chapter_id": 3408, "verse_number": "३५", "content_sanskrit": "मेनके तव भारोऽयं विश्वामित्रः सुमध्यमे ।\nसंशितात्मा सुदुर्धर्षश्चोग्रे तपसि वर्तते \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2111321, "chapter_id": 3408, "verse_number": "३६", "content_sanskrit": "स मां न च्यावयेत् स्थानात् तं गत्वा विप्रलोभय ।\nचर तस्य तपोविघ्नं कुरु मे प्रियमुत्तमम् \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2111322, "chapter_id": 3408, "verse_number": "३७", "content_sanskrit": "रूपयौवनमाधुर्यचेष्टितस्मितभाषितैः ।\nलोभयित्वा वरारोहे तपसः सन्निवर्तय \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2111323, "chapter_id": 3408, "verse_number": "", "content_sanskrit": "मेनका", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2111324, "chapter_id": 3408, "verse_number": "३८", "content_sanskrit": "महातेजा स भगवान् सदैव च महातपाः ।\nकोपनश्च तथा ह्येनं जानाति भगवानपि \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2111325, "chapter_id": 3408, "verse_number": "३९", "content_sanskrit": "तेजसस्तपसश्चैव कोपस्य च महात्मनः ।\nत्वमप्युद्विजसे यस्य नोद्विजेयमहं कथम् \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2111326, "chapter_id": 3408, "verse_number": "४०", "content_sanskrit": "विगृह्य स(च) वसिष्ठं च तस्य पुत्राञ्छशाप ह ।\nक्षत्रे जातश्च यः पूर्वमभवद् ब्राह्मणो बलात्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2111327, "chapter_id": 3408, "verse_number": "४१", "content_sanskrit": "शौचार्थं यो नदीं चक्रे दुर्गमां पापकर्मभिः ।\nयत्तत् पुण्यतमां लोके कौशिकीति विदुर्बुधाः \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2111328, "chapter_id": 3408, "verse_number": "४२", "content_sanskrit": "बभार यत्रास्य पुरा काले दुर्गे महात्मनः ।\nदारान् मतङ्गो धर्मात्मा राजर्षिर्व्याधतां गतः \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2111329, "chapter_id": 3408, "verse_number": "४३", "content_sanskrit": "अतीतकाले दुर्भिक्षे प्रत्येत्य पुनराश्रमम् ।\nदुर्गपारेति नद्या वै नाम चक्रे तदा प्रभुः \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2111330, "chapter_id": 3408, "verse_number": "४४", "content_sanskrit": "मतङ्गं याजयाञ्चक्रे तत्र प्रीतमनाः स्वयम् ।\nत्वं च सोमं भयाद् यस्य गतः पातुं सुरेश्वर \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2111331, "chapter_id": 3408, "verse_number": "४५", "content_sanskrit": "अतिनक्षत्रवंशानि क्रुद्धो नक्षत्रसम्पदा ।\nप्रतिश्रवणपूर्वाणि नक्षत्राणि ससर्ज यः \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2111332, "chapter_id": 3408, "verse_number": "४६", "content_sanskrit": "गुरुशापहतस्यापि त्रिशङ्कोः शरणं ददौ ।\nब्रह्मर्षिशापं राजर्षिः कथं मोक्ष्यति कौशिकः \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2111333, "chapter_id": 3408, "verse_number": "४७", "content_sanskrit": "अवमत्य तदा देवैर्यज्ञाङ्गं तद् विनाशितम् ।\nअन्यानि च महातेजा यज्ञाङ्गान्यसृजत् प्रभुः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2111334, "chapter_id": 3408, "verse_number": "४८", "content_sanskrit": "निनाय च तदा स्वर्गं त्रिशङ्कुं स महातपाः ।\nएतान्यन्यानि कर्माणि भृशं देव बिभेम्यहम् \t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2111335, "chapter_id": 3408, "verse_number": "४९", "content_sanskrit": "यथा मां न दहेत् क्रुद्धः तथा पश्य सुरेश्वर ।\nतेजसा निर्दहेल्लोकांश्चालयेद् धरणीं तथा \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2111336, "chapter_id": 3408, "verse_number": "५०", "content_sanskrit": "सङ्क्षिपेच्च महामेरुं महीमावर्तयेत् तथा ।\nतादृशं तपसा युक्तं प्रदीप्तमिव पावकम् \t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2111337, "chapter_id": 3408, "verse_number": "५१", "content_sanskrit": "कथमस्मद्विधा बाला जितेन्द्रियमभिस्पृशेत् ।\nहुताशनमुखं दीप्तं सूर्यचन्द्राक्षितारकम् ।\nकालजिह्वं सुरश्रेष्ठ कथमस्मद्विधा स्पृशेत्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2111338, "chapter_id": 3408, "verse_number": "५२", "content_sanskrit": "यमश्च सोमश्च महर्षयश्च\nविश्वे देवा वालखिल्याश्च सर्वे ।\nयस्योद्विजन्ते मुनयः सदैव\nकस्माद् राजन् मादृशी नोद्विजेत \t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2111339, "chapter_id": 3408, "verse_number": "५३", "content_sanskrit": "त्वयैवमुक्ता तु कथं सुरेश\nऋषेर्न गच्छेयमहं समीपम् ।\nरक्षां तु मे चिन्तय देवराज\nयथा त्वदर्थे सुखिनी चरेयम् \t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2111340, "chapter_id": 3408, "verse_number": "५४", "content_sanskrit": "भवेच्च मे मन्मथस्तत्र कार्ये\nसहायभूतस्तव च प्रसादात् ।\nवनं च वायुः सुरभिः प्रवापयेत्\nतस्मिन् काले तमृषिं लोभयन्त्याः \t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2111341, "chapter_id": 3408, "verse_number": "५५", "content_sanskrit": "कामं तु मे मारुतस्तत्र वासः\nप्रक्रीडिताया विवृणोतु देव ।\nतथेत्युक्त्वा विहिते चैव तस्मिन्\nततो ययौ साऽऽश्रमं कौशिकस्य \t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2111342, "chapter_id": 3408, "verse_number": "८७", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि सप्ताशीतितमोऽध्यायः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2111343, "chapter_id": 3408, "verse_number": "३५", "content_sanskrit": "॥ सम्भवपर्वणि पञ्चत्रिंशोऽध्यायः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2111344, "chapter_id": 3408, "verse_number": "", "content_sanskrit": "* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}]