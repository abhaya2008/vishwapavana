[{"id": 2063140, "chapter_id": 2344, "verse_number": "८-६५-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2063141, "chapter_id": 2344, "verse_number": "८-६५-१", "content_sanskrit": "ततः श्वेताश्वसंयुक्ते नारायणसमाहिते।\nतिष्ठन्रथवरे श्रीमानर्जुनः समपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2063142, "chapter_id": 2344, "verse_number": "८-६५-२", "content_sanskrit": "तद्बलं नृपतिश्रेष्ठ तावकं विजयो रणे।\nव्यक्षोभयदुदीर्णाश्वं महोदधिमिवानिलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2063143, "chapter_id": 2344, "verse_number": "८-६५-३", "content_sanskrit": "दुर्योधनस्तव सुतः प्रमत्ते श्वेतवाहने।\nअभ्येत्य सहसा क्रुद्धः सैन्यार्धेनाभिसंवृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2063144, "chapter_id": 2344, "verse_number": "८-६५-४", "content_sanskrit": "पर्यवारयदायान्तं युधिष्ठिरममर्षणम्।\nक्षुरप्राणां त्रिसप्तत्या ततोऽविध्यत पाण्डवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2063145, "chapter_id": 2344, "verse_number": "८-६५-५", "content_sanskrit": "अक्रुध्यत भृशं तत्र कुन्तीपुत्रो युधिष्ठिरः।\nस भल्लांस्त्रिंशतस्तूर्णं तव पुत्रे न्यवेशयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2063146, "chapter_id": 2344, "verse_number": "८-६५-६", "content_sanskrit": "ततो धावन्त कौरव्या जिघृक्षन्तो युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2063147, "chapter_id": 2344, "verse_number": "८-६५-७", "content_sanskrit": "दुष्टभावान्पराञ्ज्ञात्वा समवेता महारथाः।\nआजग्मुस्तं परीप्सन्तः कुन्तीपुत्रं युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2063148, "chapter_id": 2344, "verse_number": "८-६५-८x", "content_sanskrit": "`सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2063149, "chapter_id": 2344, "verse_number": "८-६५-८", "content_sanskrit": "युधिष्ठिरश्चित्रसेनं शरवर्षैरवाकिरत्।\nचित्रसेनस्तु कौन्तेयं सङ्क्रुद्धः समवारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2063150, "chapter_id": 2344, "verse_number": "८-६५-९", "content_sanskrit": "मुहूर्ताद्विमुखीकृत्य चित्रसेनं स धर्मराट्।\nतावकं सैन्यमभ्यघ्नत्समन्तान्निशितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2063151, "chapter_id": 2344, "verse_number": "८-६५-१०", "content_sanskrit": "तावका हि माबाहो दुर्योधनपुरोगमाः।\nयुधिष्ठिरं जिघृक्षन्तः सर्वसैन्यं समाक्षिपन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2063152, "chapter_id": 2344, "verse_number": "८-६५-११", "content_sanskrit": "दृष्टप्रभावांस्तान्मत्वा समवेतान्महारथान्।\nआजग्मुः सम्परीप्सन्तः पाण्डवेयं युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2063153, "chapter_id": 2344, "verse_number": "८-६५-१२", "content_sanskrit": "नकुलः सहदेवश्च धृष्टद्युम्नश्च पार्षतः।\nअक्षौहिण्या परिवृतास्तेऽभ्यधावन्युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2063154, "chapter_id": 2344, "verse_number": "८-६५-१३", "content_sanskrit": "भीमसेनश्च नाराचैर्मृद्रंस्तव महारथान्।\nअभ्यधावदभिप्रेप्सू राजानं शत्रुभिर्वृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2063155, "chapter_id": 2344, "verse_number": "८-६५-१४", "content_sanskrit": "तांस्तु सर्वान्महेष्वासान्कर्णो वैकर्तनो वृषा।\nशरवर्षेण महता प्रत्यवारयदागतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2063156, "chapter_id": 2344, "verse_number": "८-६५-१५", "content_sanskrit": "शरौघान्विसृजन्तस्ते प्रेयन्तश्च कुञ्जरान्।\nन शेकुर्यत्नवन्तोऽपि राधेयं प्रतिवीक्षितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2063157, "chapter_id": 2344, "verse_number": "८-६५-१६", "content_sanskrit": "तांश्च सर्वान्महेष्वासान्सर्वशस्त्रविशारदान्।\nमहता शरवर्षेण राधेयः प्रत्यवारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2063158, "chapter_id": 2344, "verse_number": "८-६५-१७", "content_sanskrit": "दुर्योधनं च विंशत्या नाराचानां कृती बली।\nअविध्यत्तूर्णमभ्येत्य सहदेवो महीपतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2063159, "chapter_id": 2344, "verse_number": "८-६५-१८", "content_sanskrit": "स विद्धः सहदेवेन रराज बलसन्निधौ।\nप्रभिन्न इव मातङ्गो रुधिरेण परिप्लुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2063160, "chapter_id": 2344, "verse_number": "८-६५-१९", "content_sanskrit": "दृष्ट्वा तव सुतं तत्र गाढविद्धं सुतेजनैः।\nअभ्यधावद्दृढं क्रुद्धो राधेयो रथिनां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2063161, "chapter_id": 2344, "verse_number": "८-६५-२०", "content_sanskrit": "दुर्योधनं तथा दृष्ट्वा शीघ्रमस्त्रमुदीर्य सः।\nअवधीत्पाण्डवानीकं पाञ्चालांश्चैव मारिष॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2063162, "chapter_id": 2344, "verse_number": "८-६५-२१", "content_sanskrit": "ततो यौधिष्ठिरं सैन्यं वध्यमानं महात्मना।\nसहसा प्राद्रावद्राजन्मूतपुत्रशरार्दितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2063163, "chapter_id": 2344, "verse_number": "८-६५-२२", "content_sanskrit": "विविधा विशिखास्तत्र सम्पतन्ति परस्परम्।\nभल्लाः पुङ्खसमाश्लिष्टाः सूतपुत्रधनुश्च्युताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2063164, "chapter_id": 2344, "verse_number": "८-६५-२३", "content_sanskrit": "अन्तरिक्षे शरौघाणां पततां च परस्परम्।\nसङ्घर्पेण महाराज पावकः समजायत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2063165, "chapter_id": 2344, "verse_number": "८-६५-२४", "content_sanskrit": "तकतो दशदिशः कर्णः शलभैरिव यायिभिः।\nअभ्यघ्नंस्तरसा राजञ्शरैः परशरीरगैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2063166, "chapter_id": 2344, "verse_number": "८-६५-२५", "content_sanskrit": "रक्तचन्दनसन्दिग्धौ मणिहेमविभूषितौ।\nबाहू व्यत्यक्षिपत्कर्णः परमास्त्रं विदर्शयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2063167, "chapter_id": 2344, "verse_number": "८-६५-२६", "content_sanskrit": "ततः सर्वा दिशो राजन्सायकैर्विप्रमोहयन्।\nअपीडयद्भृशं कर्णो धर्मराजं युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2063168, "chapter_id": 2344, "verse_number": "८-६५-२७", "content_sanskrit": "ततः क्रुद्धो महाराज धर्मपुत्रो युधिष्ठिरः।\nनिशितैरिषुभिः कर्णं पञ्चाशद्भिः समार्पयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2063169, "chapter_id": 2344, "verse_number": "८-६५-२८", "content_sanskrit": "[बाणान्धकारमभवत्तद्युद्धं घोरदर्शनम्।\nहाहाकारो महानासीत्तावकानां विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2063170, "chapter_id": 2344, "verse_number": "८-६५-२९", "content_sanskrit": "वध्यमाने तदा सैन्ये धर्मपुत्रेण मारिष।\nसायकैर्विविधैस्तीक्ष्णैः कङ्कपत्रैः शिलाशितैः।\nभल्लैरनेकैर्विविधैः शक्त्यृष्टिमुसलैरपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2063171, "chapter_id": 2344, "verse_number": "८-६५-३०", "content_sanskrit": "यत्र यत्र स धर्मात्मा दुष्टां दृष्टिं व्यसर्जयत्।\nतत्र तत्र व्यशीर्यन्त तावका भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2063172, "chapter_id": 2344, "verse_number": "८-६५-३१", "content_sanskrit": "कर्णोऽपि भृशसङ्कुद्रो धर्मराजं युधिष्ठिरम्।\nनाराचैरर्धचन्द्रैश्च वत्सदन्तैश्च संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2063173, "chapter_id": 2344, "verse_number": "८-६५-३२", "content_sanskrit": "अमर्षी क्रोधनश्चैव रोषप्रस्फुरिताननः।\nसायकैरप्रमेयात्मा युधिष्ठिरमभिद्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2063174, "chapter_id": 2344, "verse_number": "८-६५-३३", "content_sanskrit": "युधिष्ठिरश्चापि स तं स्वर्णपुङ्खैः शितैः शरैः॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2063175, "chapter_id": 2344, "verse_number": "८-६५-३४", "content_sanskrit": "प्रहसन्निव तं कर्णः कङ्कपत्रैः शिलाशितैः।\nउरस्यविध्यद्राजानं कुन्तीपुत्रं युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2063176, "chapter_id": 2344, "verse_number": "८-६५-३५", "content_sanskrit": "स पीडितो भृशं तेन धर्मराजो युधिष्ठिरः।\nउपविश्य रथोपस्थे सूतं याहीत्यनोदयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2063177, "chapter_id": 2344, "verse_number": "८-६५-३६", "content_sanskrit": "अक्रोशन्त ततः सर्वे धार्तराष्ट्राः सराजकाः।\nगृह्णीध्वमिति राजानमभ्यधावन्त सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2063178, "chapter_id": 2344, "verse_number": "८-६५-३७", "content_sanskrit": "ततः शताः सप्तदश केकयानां प्रहारिणाम्।\nपञ्चालैः सहिता राजन्धार्तराष्ट्रान्न्यवारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2063179, "chapter_id": 2344, "verse_number": "८-६५-३८", "content_sanskrit": "तस्मिन्सुतुमुले युद्धे वर्तमाने जनक्षये।\nदुर्योधनश्च भीमश्च समेयातां महाबलौ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2063180, "chapter_id": 2344, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि सप्तदशदिवसयुद्धे पञ्चषष्टितमोऽध्यायः॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]