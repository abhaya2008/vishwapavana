[{"id": 7003953000, "chapter_id": 23953, "verse_number": "३-१-१६-१", "content_sanskrit": "सूत उवाच ।\nकुंडे हनुमतः स्नात्वा स्वयं रुद्रेण सेविते ।\nअगस्तितीर्थं विप्रेंद्रास्ततो गच्छेत्समाहितः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003953001, "chapter_id": 23953, "verse_number": "३-१-१६-२", "content_sanskrit": "एतद्विनिर्मितं तीर्थं साक्षाद्वै कुम्भयोनिना ।\nप्रवर्तमाने कलहे पुरा वै मेरुविंध्ययोः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003953002, "chapter_id": 23953, "verse_number": "३-१-१६-३", "content_sanskrit": "निरुद्धभुवनाभोगो ववृधे विंध्यपर्वतः ।\nतदा प्राणिषु सर्वेषु निरुच्छ्वासेषु देवताः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003953003, "chapter_id": 23953, "verse_number": "३-१-१६-४", "content_sanskrit": "कैलासं पर्वतं गत्वा शंभवे तद्व्यजिज्ञपन् ।\nतदा स पार्वतीपाणिग्रहणोत्सुककौतुकी॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003953004, "chapter_id": 23953, "verse_number": "३-१-१६-५", "content_sanskrit": "प्रेषयित्वा वसिष्ठादीन्पार्वतीं याचितुं मुनीन् ।\nकुंभज त्वं निगृह्णीष्व विंध्याद्रिमिति सोऽन्वशात्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003953005, "chapter_id": 23953, "verse_number": "३-१-१६-६", "content_sanskrit": "ततः स कुम्भजः प्राह भगवंतं पिनाकिनम् ।\nउद्वाहवेषं ते देव न द्रक्ष्येहं कथं विभो॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003953006, "chapter_id": 23953, "verse_number": "३-१-१६-७", "content_sanskrit": "इति विज्ञापितः शंभुः पुनः कुंभजमब्रवीत् ।\nकुंभजोद्वाहवेषं ते पार्वत्या सहितो ह्यहम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003953007, "chapter_id": 23953, "verse_number": "३-१-१६-८", "content_sanskrit": "वेदारण्ये महापुण्ये दर्शयिष्याम्यसंशयः ।\nतद्गच्छ शीघ्रं विंध्याद्रिं निग्रहीतुं मुनीश्वर॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003953008, "chapter_id": 23953, "verse_number": "३-१-१६-९", "content_sanskrit": "एवमुक्तस्ततोगस्त्यो विन्ध्याद्रिं स निगृह्य च ।\nपादाक्रमणमात्रेण समीकुर्वन्महीतलम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003953009, "chapter_id": 23953, "verse_number": "३-१-१६-१०", "content_sanskrit": "चरित्वा दक्षि णान्देशान्गन्धमादनमन्वगात् ।\nस विदित्वा महर्षिस्तु गन्धमादनवैभवम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003953010, "chapter_id": 23953, "verse_number": "३-१-१६-११", "content_sanskrit": "तत्र तीर्थं महापुण्यं स्वनाम्ना निर्ममे मुनिः ।\nलोपामुद्रासखस्तत्र वर्ततेऽद्यापि कुंभजः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003953011, "chapter_id": 23953, "verse_number": "३-१-१६-१२", "content_sanskrit": "तत्र स्नात्वा च पीत्वा च न भूयो जन्मभाग्भवेत् ।\nइह लोके त्रिकालेपि तत्तीर्थसदृशं द्विजाः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003953012, "chapter_id": 23953, "verse_number": "३-१-१६-१३", "content_sanskrit": "तीर्थं न विद्यते पुण्यं भुक्तिमुक्तिफलप्रदम् ।\nसर्वाभीष्टप्रदं नृणां यत्तीर्थस्नानवैभवात्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003953013, "chapter_id": 23953, "verse_number": "३-१-१६-१४", "content_sanskrit": "सुदीर्घतमसः पुत्रः कक्षीवान्नाम नामतः ।\nलेभे मनोरमां नाम स्वनयस्य सुतां प्रियाम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003953014, "chapter_id": 23953, "verse_number": "३-१-१६-१५", "content_sanskrit": "कक्षीवतः कथा सेयं पुण्यापापविनाशिनी ।\nतां कथां वः प्रवक्ष्यामि तच्छृणुध्वं मुनीश्वराः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003953015, "chapter_id": 23953, "verse_number": "३-१-१६-१६", "content_sanskrit": "अस्ति दीर्घतमा नाम मुनिः परमधार्मिकः ।\nतस्य पुत्रः समभवत्कक्षीवानिति विश्रुतः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003953016, "chapter_id": 23953, "verse_number": "३-१-१६-१७", "content_sanskrit": "उपनीतः स कक्षीवान्ब्रह्मचारी जितें द्रियः ।\nवेदाभ्यासाय स गुरोः कुले वासमकल्पयत्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003953017, "chapter_id": 23953, "verse_number": "३-१-१६-१८", "content_sanskrit": "उदंकस्य गुरोर्गेहे वसन्दीर्घतमःसुतः ।\nसोऽध्येष्ट चतुरो वेदान्सांगाञ्छास्त्राणि षट् तथा॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003953018, "chapter_id": 23953, "verse_number": "३-१-१६-१९", "content_sanskrit": "इतिहासपुराणानि तथोपनिषदोऽपिच ।\nउषित्वा षष्टिवर्षाणि कक्षीवान्गुरुसन्निधौ॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003953019, "chapter_id": 23953, "verse_number": "३-१-१६-२०", "content_sanskrit": "प्रयास्यन्स्वगृहं विप्रा गुरवे दक्षि णामदात् ।\nउवाच वै गुरुर्विद्वान्कक्षीवान्ब्रह्मवित्तमः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003953020, "chapter_id": 23953, "verse_number": "३-१-१६-२१", "content_sanskrit": "कक्षीवानुवाच ।\nअहं गृहं प्रयास्यामि कुर्वनुज्ञां महामुने ।\nअवलोक्य कृपादृष्ट्या मां रक्षोदंक सांप्रतम् ।\nउदंकस्त्वेव मुदितः कक्षीवंतमथाब्रवीत्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003953021, "chapter_id": 23953, "verse_number": "३-१-१६-२२", "content_sanskrit": "उदंक उवाच ।\nअनुजानामि कक्षीवन्गच्छ त्वं स्वगृहं प्रति॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003953022, "chapter_id": 23953, "verse_number": "३-१-१६-२३", "content_sanskrit": "उद्वाहार्थमुपायं ते वत्स वक्ष्यामि तच्छृणु ।\nरामसेतुं प्रयाहि त्वं गंधमादनपर्वतम्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003953023, "chapter_id": 23953, "verse_number": "३-१-१६-२४", "content_sanskrit": "तत्रागस्त्यकृतं तीर्थं सर्वाभीष्टप्रदा यकम् ।\nभुक्तिमुक्तिप्रदं पुंसां सर्वपापनिबर्हणम्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003953024, "chapter_id": 23953, "verse_number": "३-१-१६-२५", "content_sanskrit": "विद्यते स्नाहि तत्र त्वं सर्वमंगलसाधने ।\nत्रिवर्षं वस तत्र त्वं नियमाचारसंयुतः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003953025, "chapter_id": 23953, "verse_number": "३-१-१६-२६", "content_sanskrit": "वर्षेषु त्रिषु यातेषु चतुर्थे वत्सरे ततः ।\nनिर्गमिष्यति मातंगः कश्चित्तीर्थोत्तमात्ततः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003953026, "chapter_id": 23953, "verse_number": "३-१-१६-२७", "content_sanskrit": "चतुर्दंतो महाकायः शरदभ्रसमच्छविः ।\nतं गजं गिरिसंकाशं स्नात्वा तत्र समारुह॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003953027, "chapter_id": 23953, "verse_number": "३-१-१६-२८", "content_sanskrit": "आरुह्य तं गजं वत्स स्वनयस्य पुरीं व्रज ।\nचतुर्दंतगजस्थं त्वां दृष्ट्वा शक्रमिवापरम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003953028, "chapter_id": 23953, "verse_number": "३-१-१६-२९", "content_sanskrit": "राजर्षिः स्वनयो धीमान्हर्षव्याकुललोचनः ।\nस्वकन्यायाः कृते दुःखं त्यजेदेव हृदिस्थितम्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003953029, "chapter_id": 23953, "verse_number": "३-१-१६-३०", "content_sanskrit": "पुरा हि प्रतिजज्ञे सा तस्य पुत्री मनोरमा ।\nचतुर्दंतं महाकायं गजं सर्वांगपांडुरम्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003953030, "chapter_id": 23953, "verse_number": "३-१-१६-३१", "content_sanskrit": "आरुह्य यः समागच्छेत्स मे भर्ता भवेदिति ।\nस्वकन्यायाः प्रतिज्ञां तां समाकर्ण्य स भूपतिः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003953031, "chapter_id": 23953, "verse_number": "३-१-१६-३२", "content_sanskrit": "दुःखाकुलमना भूत्वा सततं पर्यचिंतयत् ।\nस्वनये चिंतयत्येवं नारदः समुपागमत्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003953032, "chapter_id": 23953, "verse_number": "३-१-१६-३३", "content_sanskrit": "तमागतं मुनिं दृष्ट्वा राजर्षिरतिधार्मिकः ।\nप्रत्युद्गम्य मुदा युक्तः पाद्यार्घ्याद्यैरपूजयत्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003953033, "chapter_id": 23953, "verse_number": "३-१-१६-३४", "content_sanskrit": "प्रणम्य नारदं राजा वचनं चेदमब्रवीत् ।\nकन्येयं मम देवर्षे प्रतिज्ञामकरोत्पुरा॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003953034, "chapter_id": 23953, "verse_number": "३-१-१६-३५", "content_sanskrit": "चतु र्दंतं महाकायं गजं सर्वांगपांडुरम् ।\nआरुह्य यः समागच्छेत्स मे भर्ता भवेदिति॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003953035, "chapter_id": 23953, "verse_number": "३-१-१६-३६", "content_sanskrit": "चतुर्दंतो महाकायो गजः सर्वांगपांडुरः ।\nसंभवेदिंद्रभवने भूतले नैव विद्यते॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003953036, "chapter_id": 23953, "verse_number": "३-१-१६-३७", "content_sanskrit": "इयं च दुस्तरामेनां प्रतिज्ञां बालिशाऽकरोत् ।\nइयं प्रतिज्ञातितरां सततं बाधते हि माम्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003953037, "chapter_id": 23953, "verse_number": "३-१-१६-३८", "content_sanskrit": "अनूढा हि पितुः कन्या सर्वदा शोकमावहेत् ।\nइति तस्य वचः श्रुत्वा स्वनये नारदोऽब्रवीत्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003953038, "chapter_id": 23953, "verse_number": "३-१-१६-३९", "content_sanskrit": "मा विषीदस्व राजर्षे तस्या ईदृग्विधः पतिः ।\nभविष्यत्यचिरादेव पृथिव्यां ब्राह्मणोत्तमः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003953039, "chapter_id": 23953, "verse_number": "३-१-१६-४०", "content_sanskrit": "कक्षीवानिति विख्यातो जामाता ते भविष्यति ।\nइत्युक्त्वा नारदमुनिर्ययावाकाशमार्गतः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003953040, "chapter_id": 23953, "verse_number": "३-१-१६-४१", "content_sanskrit": "स्व नयस्तद्वचः श्रुत्वा नारदेन प्रभाषितम् ।\nआकांक्षते दिवारात्रं तादृग्विधसमागमम्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003953041, "chapter_id": 23953, "verse_number": "३-१-१६-४२", "content_sanskrit": "अतः सौम्य महाभाग कक्षीवन्बालतापस ।\nअगस्त्यतीर्थमद्य त्वं स्नातुं गच्छ त्वरान्वितः॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003953042, "chapter_id": 23953, "verse_number": "३-१-१६-४३", "content_sanskrit": "सर्वमंगलसिद्धिस्ते भविष्यति न संशयः ।\nउदंकेनैवमुक्तोऽथ कक्षीवान्द्विजपुंगवः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003953043, "chapter_id": 23953, "verse_number": "३-१-१६-४४", "content_sanskrit": "अनु ज्ञातश्च गुरुणा प्रययौ गंधमादनम् ।\nसंप्राप्यागस्त्यतीर्थं च तत्र सस्नौ जितेंद्रियः॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003953044, "chapter_id": 23953, "verse_number": "३-१-१६-४५", "content_sanskrit": "क्षेत्रोपवासमकरोद्दिनमेकं मुनीश्वरः ।\nअपरेद्युः पुनः स्नात्वा पारणामकरोद्द्विजः॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003953045, "chapter_id": 23953, "verse_number": "३-१-१६-४६", "content_sanskrit": "रात्रौ तत्रैव सुष्वाप कक्षीवान्धर्मतत्परः ।\nएवं नियमयुक्तस्य तस्य कक्षीवतो मुनेः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003953046, "chapter_id": 23953, "verse_number": "३-१-१६-४७", "content_sanskrit": "एकेन दिवसे नोनं वर्षत्रयमथागमत् ।\nअथ वर्षत्रयस्यांते तस्मिन्नेव दिने मुनिः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003953047, "chapter_id": 23953, "verse_number": "३-१-१६-४८", "content_sanskrit": "अन्वास्य पश्चिमां संध्यां सुखं सुष्वाप तत्तटे ।\nयाममात्रावशिष्टायां विभावर्यां महाध्वनिः॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003953048, "chapter_id": 23953, "verse_number": "३-१-१६-४९", "content_sanskrit": "उदभूत्प्रलयांभोधिवीचिकोलाहलोपमः ।\nतेन शब्देन महता कक्षीवान्प्रत्यबुध्यत॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003953049, "chapter_id": 23953, "verse_number": "३-१-१६-५०", "content_sanskrit": "ततस्तु स्वनयो नाम राजा सानुचरो बली ।\nमृगयाकौतुकी तत्र मधुरापतिराययौ॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003953050, "chapter_id": 23953, "verse_number": "३-१-१६-५१", "content_sanskrit": "विनिघ्नन्स गजान्सिंहान्वराहान्महिषान्नुरून् ।\nअन्यान्मृगविशेषांश्च स राजा न्यवधीच्छरैः॥ ८५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003953051, "chapter_id": 23953, "verse_number": "३-१-१६-५२", "content_sanskrit": "सामात्यो मृगयासक्तो रथवाजिगजैर्युतः ।\nअगस्त्यतीर्थसविधमाससाद भटान्वितः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003953052, "chapter_id": 23953, "verse_number": "३-१-१६-५३", "content_sanskrit": "स राजा मृगयाश्रांतः श्रांतसैनिकसंवृतः ।\nतत्तीर्थतीरप्रांतेषु निषसाद महीपतिः॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003953053, "chapter_id": 23953, "verse_number": "३-१-१६-५४", "content_sanskrit": "ततः प्रभाते विमले कक्षी वान्मुनिसत्तमः ।\nअगस्त्यतीर्थे स्नात्वाऽसौ संध्यां पूर्वामुपास्य च॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003953054, "chapter_id": 23953, "verse_number": "३-१-१६-५५", "content_sanskrit": "तस्य तीरे जपन्मत्रांस्तस्थौ नियमसंयुतः ।\nअत्रांतरे तीर्थवराद्गज एको विनिर्ययौ॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003953055, "chapter_id": 23953, "verse_number": "३-१-१६-५६", "content_sanskrit": "चतुर्दंतो महाकायः कैलास इव मूर्तिमान् ।\nस समुत्थाय तत्तीर्थादगात्कक्षीवदंतिकम्॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003953056, "chapter_id": 23953, "verse_number": "३-१-१६-५७", "content_sanskrit": "तमागतमुदंकोक्त लक्षणैरुपलक्षितम् ।\nतदा निरीक्ष्य कक्षीवानारोढुं स्नानमातनोत्॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003953057, "chapter_id": 23953, "verse_number": "३-१-१६-५८", "content_sanskrit": "नमस्कृत्य च तत्तीर्थं श्लाघमानो मुहुर्मुहुः ।\nआरुरोह च कक्षीवांश्चतुर्दंतं महागजम्॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003953058, "chapter_id": 23953, "verse_number": "३-१-१६-५९", "content_sanskrit": "आरुह्य तं चतुर्दंतं रजताचलसंनिभम् ।\nस्वनयस्य पुरीमेव कक्षीवान्गंतुमैच्छत॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003953059, "chapter_id": 23953, "verse_number": "३-१-१६-६०", "content_sanskrit": "तमारूढं चतुर्दंतं श्वेतदंतावलोत्तमम् ।\nस वीक्ष्य निश्चिकायैनं कक्षीवानिति भूपतिः॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003953060, "chapter_id": 23953, "verse_number": "३-१-१६-६१", "content_sanskrit": "प्रसन्नहृदयो राजा तस्यांतिकमुपागमत् ।\nतदाभ्याशमुपागम्य कक्षीवंतं नृपोऽब्रवीत्॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003953061, "chapter_id": 23953, "verse_number": "३-१-१६-६२", "content_sanskrit": "स्वनय उवाच ।\nत्वं ब्रह्मन्कस्य पुत्रोऽसि नाम किं तव मे वद ।\nगजमेनं समारुह्य कुत्र वा गन्तुमिच्छसि ।\nस्वनयेनैवमुक्तस्तु कक्षीवान्वाक्यमब्रवीत्॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003953062, "chapter_id": 23953, "verse_number": "३-१-१६-६३", "content_sanskrit": "कक्षीवानुवाच ।\nपुत्रोऽहं दीर्घतमसः कक्षीवानिति विश्रुतः॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003953063, "chapter_id": 23953, "verse_number": "३-१-१६-६४", "content_sanskrit": "स्वनयस्य तु राजर्षेर्गच्छामि नगरं प्रति ।\nअहमुद्वोढुमिच्छामि तस्य कन्या मनोरमाम्॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003953064, "chapter_id": 23953, "verse_number": "३-१-१६-६५", "content_sanskrit": "चतुर्दंतगजारूढस्तत्प्रतिज्ञां च पूरयन् ।\nस्वनयस्य सुतापाणिं ग्रहीष्यामि नराधिप॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003953065, "chapter_id": 23953, "verse_number": "३-१-१६-६६", "content_sanskrit": "तद्भाषितं समाकर्ण्य श्रोत्रपीयूषवर्षणम् ।\nहर्षसंफुल्लनयनः स्वनयो वाक्यम ब्रवीत्॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003953066, "chapter_id": 23953, "verse_number": "३-१-१६-६७", "content_sanskrit": "कक्षीवन्भोः कृतार्थोस्मि स एव स्वनयो ह्यहम् ।\nउद्वोढुमिच्छति भवान्यस्य कन्यां मनोरमाम्॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003953067, "chapter_id": 23953, "verse_number": "३-१-१६-६८", "content_sanskrit": "स्वागतं ते मुनिश्रेष्ठ कक्षीवन्बालतापस ।\nमम कन्यां गृहाण त्वं तपोधन मनोरमाम्॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003953068, "chapter_id": 23953, "verse_number": "३-१-१६-६९", "content_sanskrit": "तया सह चरन्धर्मान्गार्हस्थ्यं प्रतिपालय ।\nराज्ञोक्तः स तदोवाच कक्षीवान्धर्मतत्परः ।\nराजानं स्वनयं प्रीतं मधुरापुरवासिनम्॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003953069, "chapter_id": 23953, "verse_number": "३-१-१६-७०", "content_sanskrit": "कक्षीवानुवाच ।\nपिता दीर्घतमानाम वेदारण्ये मम प्रभो॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003953070, "chapter_id": 23953, "verse_number": "३-१-१६-७१", "content_sanskrit": "आस्ते तपश्चरन्सौम्यो नियमाचारतत्परः ।\nतस्यांतिकं प्रेषय त्वं विप्रमेकं धरापते॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003953071, "chapter_id": 23953, "verse_number": "३-१-१६-७२", "content_sanskrit": "तथोक्तः स तदा राजा स्वनयो हृष्टमा नसः ।\nअनेकसेनया सार्धं प्राहिणोत्स्वपुरोधसम्॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003953072, "chapter_id": 23953, "verse_number": "३-१-१६-७३", "content_sanskrit": "विप्रं सुदर्शनं नाम वेदारण्यस्थलं प्रति ।\nसुदर्शनः समादिष्टः स्वनयेन नृपेण सः॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003953073, "chapter_id": 23953, "verse_number": "३-१-१६-७४", "content_sanskrit": "महत्या सेनया सार्धं प्रययौ वेदकाननम् ।\nतत्रोटजे समासीन तं दीर्घतमसं मुनिम्॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003953074, "chapter_id": 23953, "verse_number": "३-१-१६-७५", "content_sanskrit": "तपश्चरतमासीनं ध्यायन्वेदाटवी पतिम् ।\nपुरोहितो ददर्शाथ जपंतं मंत्रमुत्तमम्॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003953075, "chapter_id": 23953, "verse_number": "३-१-१६-७६", "content_sanskrit": "प्रणाममकरोत्तस्मै मुनये स सुदर्शनः ।\nउवाच दीर्घतमसं मुनिं प्रह्लादयन्निव॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003953076, "chapter_id": 23953, "verse_number": "३-१-१६-७७", "content_sanskrit": "सुदर्शन उवाच ।\nकच्चित्ते कुशलं ब्रह्मन्कच्चित्ते वर्धते तपः ।\nआश्रमे कुशलं कच्चित्कच्चिद्धर्मे सुखं वद॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003953077, "chapter_id": 23953, "verse_number": "३-१-१६-७८", "content_sanskrit": "पृष्टः सुदर्शनेनैवं मुनिर्दीर्घतमास्तदा ।\nसुदर्शनमुवाचेदमर्घ्यादिविधिपूर्वकम्॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003953078, "chapter_id": 23953, "verse_number": "३-१-१६-७९", "content_sanskrit": "दीर्घतमा उवाच ।\nसर्वत्र कुशलं ब्रह्मन्सुदर्शन महामते ।\nमम वेदाटवीनाथकृपया नाशुभं क्वचित्॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003953079, "chapter_id": 23953, "verse_number": "३-१-१६-८०", "content_sanskrit": "तवापि कुशलं ब्रह्मन्किं सुखागमनं तथा ।\nकिंवाऽगमनकार्यं ते सुदर्शन ममाश्रमे॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003953080, "chapter_id": 23953, "verse_number": "३-१-१६-८१", "content_sanskrit": "स्वनयस्य पुरोधास्त्वं खलु वेदविदांवरः ।\nतं विहाय महाराज मधुरापुरवासिनम्॥ ८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003953081, "chapter_id": 23953, "verse_number": "३-१-१६-८२", "content_sanskrit": "महत्या सेनया सार्धं किमर्थं त्वमिहागतः ।\nइत्युक्तो दीर्घतमसा तदानीं स सुदर्शनः॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003953082, "chapter_id": 23953, "verse_number": "३-१-१६-८३", "content_sanskrit": "उवाच तं महात्मानं मुनिं ज्वलिततेजसम् ।\nसर्वत्र मे सुखं ब्रह्मन्भवतः कृपया सदा॥ ८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003953083, "chapter_id": 23953, "verse_number": "३-१-१६-८४", "content_sanskrit": "भगवन्स्व नयो राजा साष्टांगं प्रणिपत्य तु ।\nत्वां प्राह प्रश्रितं वाक्यं मन्मुखेन शृणुष्व तत्॥ ८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003953084, "chapter_id": 23953, "verse_number": "३-१-१६-८५", "content_sanskrit": "स्वनय उवाच ।\nकक्षीवांस्ते सुतो ब्रह्म न्गंधमादनपर्वते ।\nस्नानं कुर्वन्नगस्त्यस्य तीर्थे संप्रति वर्तते॥ ८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003953085, "chapter_id": 23953, "verse_number": "३-१-१६-८६", "content_sanskrit": "तस्य रूपं तपो धर्ममाचारान्वैदिकांस्तथा ।\nवेदशास्त्रप्रवीणत्वमाभि जात्यं च तादृशम्॥ ८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003953086, "chapter_id": 23953, "verse_number": "३-१-१६-८७", "content_sanskrit": "लोकोत्तरमिदं सर्वं विज्ञाय तव नंदने ।\nमनोरमां सुतां तस्मै दातुमिच्छाम्यहं मुने॥ ८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003953087, "chapter_id": 23953, "verse_number": "३-१-१६-८८", "content_sanskrit": "मृगयाकौतुकी चाहं गंधमादनपर्वतम् ।\nआगतो मुनिशार्दूल वर्त्ते युष्मत्सुतांतिके॥ ८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003953088, "chapter_id": 23953, "verse_number": "३-१-१६-८९", "content_sanskrit": "पित्रनुज्ञां विना नाहमुद्वहेयं सुतां तव ।\nइति ब्रूते तव सुतः कक्षीवान्मुनिस त्तम॥ ८९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003953089, "chapter_id": 23953, "verse_number": "३-१-१६-९०", "content_sanskrit": "तद्भावां मत्सुतां तस्मै दातुं मेऽनुग्रहं कुरु ।\nप्रैषयं च समीपं ते सेनया च सुदर्शनम्॥ ९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003953090, "chapter_id": 23953, "verse_number": "३-१-१६-९१", "content_sanskrit": "सुदर्शन उवाच ।\nइति मां भगवन्राजा प्राहिणोत्तव सन्निधिम् ।\nतद्भवाननुमन्यस्व राज्ञस्तस्य चिकीर्षितम्॥ ९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003953091, "chapter_id": 23953, "verse_number": "३-१-१६-९२", "content_sanskrit": "श्रीसूत उवाच ।\nइत्युक्त्वा विररामाथ स्वनयस्य पुरोहितः ।\nततो दीर्घतमाः प्राह स्वनयस्य पुरोहितम्॥ ९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003953092, "chapter_id": 23953, "verse_number": "३-१-१६-९३", "content_sanskrit": "दीर्घतमा उवाच ।\nसुदर्शन भवत्वेवं कथितं स्वनयेन यत् ।\nममाभीष्टतमं ह्येतत्पाणिग्रहणमंगलम्॥ ९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003953093, "chapter_id": 23953, "verse_number": "३-१-१६-९४", "content_sanskrit": "आगमिष्याम्यहं विप्र गन्धमादनपर्वतम् ।\nइत्युक्त्वा स मुनिर्विप्रा महादीर्घतमा मुनिः॥ ९४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003953094, "chapter_id": 23953, "verse_number": "३-१-१६-९५", "content_sanskrit": "वेदाटवीपतिं नत्वा भक्तिप्रवणचेतसा ।\nसुदर्शनेन सहितः सेतुमुद्दिश्य निर्ययौ॥ ९५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003953095, "chapter_id": 23953, "verse_number": "३-१-१६-९६", "content_sanskrit": "षट्भिर्दिनैर्मुनिः पुण्यं प्रययौ गन्धमादनम् ।\nअगस्तितीर्थतीरं च गत्वा दीर्घतमा मुनिः॥ ९६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003953096, "chapter_id": 23953, "verse_number": "३-१-१६-९७", "content_sanskrit": "अथ पुत्रं ददर्शाग्रे कक्षीवंतं महामुनिः ।\nकक्षीवान्पितरं दृष्ट्वा ववन्दे नाम कीर्तयन्॥ ९७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7003953097, "chapter_id": 23953, "verse_number": "३-१-१६-९८", "content_sanskrit": "ततो दीर्घतमा योगी स्वांकमारोप्य तं सुतम् ।\nमूर्ध्न्युपाघ्राय सस्नेहं सस्वजे पुलकाकुलः॥ ९८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7003953098, "chapter_id": 23953, "verse_number": "३-१-१६-९९", "content_sanskrit": "कुशलं परिपप्रच्छ तदा दीर्घतमा ऋषिः ।\nसर्ववेदास्त्वयाधीताः कक्षीवन्किमु वत्सक॥ ९९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7003953099, "chapter_id": 23953, "verse_number": "३-१-१६-१००", "content_sanskrit": "शास्त्राण्यपाठीः किं त्वं वा वत्स सर्वं वदस्व मे ।\nइति पृष्टः स्वपित्रा स सर्वं वृत्तं तमव्रवीत्॥ १०० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}]