[{"id": 2025915, "chapter_id": 1555, "verse_number": "३-१९३-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2025916, "chapter_id": 1555, "verse_number": "३-१९३-१", "content_sanskrit": "युधिष्ठिरस्तु कौन्तेयो मार्कण्डेयं महामुनिम्।\nपुन- पप्रच्छ सामात्यो भविष्यां जगतो गतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2025917, "chapter_id": 1555, "verse_number": "३-१९३-२x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2025918, "chapter_id": 1555, "verse_number": "३-१९३-२", "content_sanskrit": "आश्चर्यभूतं भवतः श्रुतं नो वदतांवर।\nमुने भार्गव यद्वृत्तं युगादौ प्रभवाप्ययौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2025919, "chapter_id": 1555, "verse_number": "३-१९३-३", "content_sanskrit": "अस्मिन्कलियुगे त्वस्ति पुनः कौतूहलं मम।\nसमाकुलेषु धर्मेषु किंनु शेषं भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2025920, "chapter_id": 1555, "verse_number": "३-१९३-४", "content_sanskrit": "किंवीर्या मानवास्तत्रकिमाहारविहारिणः।\nकिमायुषः किंवसना भविष्यन्ति युगक्षये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2025921, "chapter_id": 1555, "verse_number": "३-१९३-५", "content_sanskrit": "कां च काष्ठां समासाद्य पुनः संपत्स्यते कृतम्।\nविस्तरेण मुने ब्रूहि विचित्राणीह भाषसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2025922, "chapter_id": 1555, "verse_number": "३-१९३-६", "content_sanskrit": "इत्युक्तः स मुनिश्रेष्ठः पुनरेवाभ्यभाषत।\nरमयन्वृष्णिशार्दूलं पाण्डवांस्च महानृषिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2025923, "chapter_id": 1555, "verse_number": "३-१९३-७", "content_sanskrit": "शृणु राजन्मया दृष्टं यत्पुरा श्रुतमेव च।\nअनुभूतं च राजेनद्रदेवदेवप्रसादजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2025924, "chapter_id": 1555, "verse_number": "३-१९३-८", "content_sanskrit": "भविष्यं सर्वलोकस्य वृत्तान्तं भरतर्षभ।\nकलुषं कालमासाद्य कथ्यमानं निबोध मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2025925, "chapter_id": 1555, "verse_number": "३-१९३-९", "content_sanskrit": "कृते चतुष्पात्सकलो निर्व्याजोप्राधिवर्जितः।\nवृषः प्रतिष्ठितो धर्मो मनुष्ये भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2025926, "chapter_id": 1555, "verse_number": "३-१९३-१०", "content_sanskrit": "अधर्मपादविद्धस्तु त्रिभिरंशैः प्रतिष्ठितः।\nत्रेतायां द्वापरेऽर्धेन व्यामिश्रो धर्म उच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2025927, "chapter_id": 1555, "verse_number": "३-१९३-११", "content_sanskrit": "त्रिभिरंशैरधर्मस्तु लोकानाक्रम्य तिष्ठति।\nतामसं युगमासाद्य तदा भरतसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2025928, "chapter_id": 1555, "verse_number": "३-१९३-१२", "content_sanskrit": "चतुर्थांशेन धर्मस्तु मनुष्यानुपतिष्ठति।\nआयुर्वीर्यं मनो बुद्धिर्बलं तेजश्च पाण्डव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2025929, "chapter_id": 1555, "verse_number": "३-१९३-१३", "content_sanskrit": "मनुष्याणआमनुयुगं ह्रप्तन्तीति निबोध मे।\nब्राह्मणाः क्षत्रिया वैश्याः शूद्राश्चैव युधिष्ठिर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2025930, "chapter_id": 1555, "verse_number": "३-१९३-१४", "content_sanskrit": "व्याजैर्धर्मं चरिष्यन्ति धर्मवैतंसिका नराः।\nसत्यं संक्षेप्स्यते लोके नरैः पण्डितमानिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2025931, "chapter_id": 1555, "verse_number": "३-१९३-१५", "content_sanskrit": "सत्यहान्या ततस्तेषामायुरल्पं भविष्यति।\nआयुषः प्रक्षयाद्विद्यां न शक्ष्यन्त्युपशिक्षितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2025932, "chapter_id": 1555, "verse_number": "३-१९३-१६", "content_sanskrit": "विद्याहीनानविज्ञानाल्लोभोप्यभिभविष्यति।\nलोभमोहपरा मूढाः कामासक्ताश् मानवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2025933, "chapter_id": 1555, "verse_number": "३-१९३-१७", "content_sanskrit": "वैरबद्धा भविष्यन्ति परस्परवधैषिणः।\nब्राह्मणाः क्षत्रिया वैश्याः संकीर्यन्ते परस्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2025934, "chapter_id": 1555, "verse_number": "३-१९३-१८", "content_sanskrit": "शूद्रतुल्या भविष्यन्ति तपःसत्यविवर्जिताः।\nअन्त्या मध्या भविष्यन्ति मध्याश्चान्त्या न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2025935, "chapter_id": 1555, "verse_number": "३-१९३-१९", "content_sanskrit": "ईदृशो भविता लोको युगान्ते पर्युपस्थिते।\nवस्त्राणां प्रवरा शाणी धान्यानां कोरदूपकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2025936, "chapter_id": 1555, "verse_number": "३-१९३-२०", "content_sanskrit": "भार्यामित्राश्च पुरुषा भविष्यन्ति युगक्षये।\nमत्स्यामिषेण जीवन्तो दुहन्तश्चाप्यजैडकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2025937, "chapter_id": 1555, "verse_number": "३-१९३-२१", "content_sanskrit": "गोषु नष्टासु पुरुषा येऽपि नित्यं धृतव्रताः।\nतेऽपिलोभसमायुक्ता भविष्यन्ति युगक्षये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2025938, "chapter_id": 1555, "verse_number": "३-१९३-२२", "content_sanskrit": "अन्योन्यं परिमुष्णन्तो हिंसयन्तश्च मानवाः।\nअजपा नास्तिकाः स्तेना भविष्यन्ति युगक्षये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2025939, "chapter_id": 1555, "verse_number": "३-१९३-२३", "content_sanskrit": "सरित्तीरेषु कुद्दालैर्वापयिष्यनति चौपधीः।\nताश्चाप्यल्पफलास्तेषां भविष्यन्ति युगक्षये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2025940, "chapter_id": 1555, "verse_number": "३-१९३-२४", "content_sanskrit": "श्राद्धे दैवे च पुरुषा येऽपि नित्यं धृव्रताः।\nतेऽपिलोभसमायुक्ता भोक्ष्यन्तीह परस्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2025941, "chapter_id": 1555, "verse_number": "३-१९३-२५", "content_sanskrit": "पिता पुत्रस् भोक्ता च पितुः पुत्रस्तथैव च।\nअतिक्रान्तानि भोज्यानि भविष्यन्ति युगक्षये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2025942, "chapter_id": 1555, "verse_number": "३-१९३-२६", "content_sanskrit": "न व्रतानि चरिष्यन्ति ब्राह्मणा वेदनिन्दकाः।\nन यक्ष्यन्ति न होष्यन्ति हेतुवादविमोहिताः।\nनिम्नेष्वीहां करिष्यनति हेतुवादविमोहिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2025943, "chapter_id": 1555, "verse_number": "३-१९३-२७", "content_sanskrit": "निम्ने कृषिं करिष्यन्ति योक्ष्यन्ति धुरि धेनुक्राः।\nएकहायनवत्सांश्च वाहयिष्यन्ति मानवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2025944, "chapter_id": 1555, "verse_number": "३-१९३-२८", "content_sanskrit": "पुत्रः पितृवधं कृत्वा पिता पुत्रवधं तथा।\n`स्त्रियोऽपि पतिपुत्रादीन्वधिष्यनति युगक्षये।\nनिरुद्वेगो बृहद्बादी न निन्दामुपलप्स्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2025945, "chapter_id": 1555, "verse_number": "३-१९३-२९", "content_sanskrit": "म्लेच्छभूतं जगत्सर्वं निष्क्रियं दानवर्जितम्।\nभविष्यति निरानन्दमनुत्सवमथो तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2025946, "chapter_id": 1555, "verse_number": "३-१९३-३०", "content_sanskrit": "प्रायशः कृपणानां हि तथा बन्धुमतामपि।\nविधवानां च वित्तानि हरिष्यन्तीह मानवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2025947, "chapter_id": 1555, "verse_number": "३-१९३-३१", "content_sanskrit": "स्वल्पवीर्यबलाः स्वाधा लोभमोहपरायणाः।\nतत्कथादानसंतुष्ट शिष्टानामपि बान्धवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2025948, "chapter_id": 1555, "verse_number": "३-१९३-३२", "content_sanskrit": "परिग्रहंकरिष्यति मायाचारपरिग्रहाः।\nसंघातयन्तः तय राजानः पापबुद्धयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2025949, "chapter_id": 1555, "verse_number": "३-१९३-३३", "content_sanskrit": "परस्परवधोयुक्ता मूर्खाः पण्डितमानिनः।\nभविष्यन्ति युगस्यान्ते क्षत्रिया लोककण्टकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2025950, "chapter_id": 1555, "verse_number": "३-१९३-३४", "content_sanskrit": "अरक्षितारो लुब्धाश् मानाहंकारदर्पिताः।\nकेवलं दण्डरुचयो भविष्यन्ति युगक्षये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2025951, "chapter_id": 1555, "verse_number": "३-१९३-३५", "content_sanskrit": "आक्रम्याक्रम्य साधूनां दारांश्चापि धनानि च।\nभोक्ष्यन्ते निरनुक्रोसा रुदतामपि भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2025952, "chapter_id": 1555, "verse_number": "३-१९३-३६", "content_sanskrit": "न कन्यां याचे कश्चिन्नापि कन्या प्रदीयते।\nस्वयंग्रहा भविष्यन्ति युगान्ते समुपस्थिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2025953, "chapter_id": 1555, "verse_number": "३-१९३-३७", "content_sanskrit": "राजानश्चाप्यसंतुष्टाः परार्तान्मूढचेतसः।\nसर्वोपायैर्हरिष्यन्ति युगान्ते पर्युपस्थिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2025954, "chapter_id": 1555, "verse_number": "३-१९३-३८", "content_sanskrit": "म्लेच्छीभूतं जगत्सर्वं भविष्यति न संशयः।\nहस्तो हस्तं परिमुषेद्युगान्ते समुपस्थिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2025955, "chapter_id": 1555, "verse_number": "३-१९३-३९", "content_sanskrit": "सत्यं संक्षिप्यते लोके नरैः पण्डितमानिभिः।\nस्थविरा बालमतयो बालाः स्थविरबुद्धयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2025956, "chapter_id": 1555, "verse_number": "३-१९३-४०", "content_sanskrit": "भीरुस्था शूरमानी शूरा भीरुविषादिनः।\nन विश्वसन्ति चान्योन्यं युगान्ते पर्युपस्थिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2025957, "chapter_id": 1555, "verse_number": "३-१९३-४१", "content_sanskrit": "नैकभार्यं जगत्सर्वं लोभमोहव्यवस्थितम्।\nअधर्मो वर्धते तत्र न तु धर्मः प्रवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2025958, "chapter_id": 1555, "verse_number": "३-१९३-४२", "content_sanskrit": "ब्राह्मणाः क्षत्रिया वैश्या नशिष्यन्ति जनाधिप।\nएकवर्णस्तदा लोको भविष्यति युगक्षये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2025959, "chapter_id": 1555, "verse_number": "३-१९३-४३", "content_sanskrit": "न क्षंस्यति पिता पुत्रं पुत्रश्च पितरं तथा।\nबार्याश्च पतिशुश्रूषां न करिष्यन्ति संक्षये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2025960, "chapter_id": 1555, "verse_number": "३-१९३-४४", "content_sanskrit": "ये यवान्ना जनपदा गोधूमान्नास्तथैव च।\nतान्देशान्संश्रयिष्यन्ति युगान्ते पर्युपस्थिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2025961, "chapter_id": 1555, "verse_number": "३-१९३-४५", "content_sanskrit": "स्वैराहाराश्च पुरुषा योपितश्च विशांपते।\nअन्योन्यं न सहिष्यन्ति युगान्ते पर्युपस्थिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2025962, "chapter_id": 1555, "verse_number": "३-१९३-४६", "content_sanskrit": "म्लेच्छभूतं जगत्सर्वं भविष्यति युधिष्ठिर।\nश्राद्धे न देवान्न पितॄस्तर्पयिष्यन्ति मानवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2025963, "chapter_id": 1555, "verse_number": "३-१९३-४७", "content_sanskrit": "न कश्चित्कस्यचिच्छ्रोता न कश्चित्कस्यचिद्गुरुः।\nतमोग्रस्तस्तदा लोको भविष्यति जनाधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2025964, "chapter_id": 1555, "verse_number": "३-१९३-४८", "content_sanskrit": "परमायुश्च भविता तदा वर्षाणि षोडश।\nततः प्राणान्विमोक्ष्यन्ति युगान्ते समुपस्थिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2025965, "chapter_id": 1555, "verse_number": "३-१९३-४९", "content_sanskrit": "पञ्चमे वाऽथ षष्ठे वा वर्षे कन्या प्रसूयते।\nसप्तवर्षाष्टवर्षाश्च प्रजास्यन्ति नरास्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2025966, "chapter_id": 1555, "verse_number": "३-१९३-५०", "content_sanskrit": "पत्यौ स्त्री तु तदा राजन्पुरुषो वा स्त्रियं प्रति।\nयुगान्ते राजशार्दूल न तोषमुपयास्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2025967, "chapter_id": 1555, "verse_number": "३-१९३-५१", "content_sanskrit": "अल्पद्रव्या वृथालिङ्गा हिंसा च प्रभविष्यति।\nन कश्चित्कस्यचिद्दाता भविष्यति युगक्षये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2025968, "chapter_id": 1555, "verse_number": "३-१९३-५२", "content_sanskrit": "अट्टशूला जनपदाः शिवशूलाश्चतुष्पथाः।\nकेशशूलाः स्त्रियश्चापि भविष्यनति युगक्षये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2025969, "chapter_id": 1555, "verse_number": "३-१९३-५३", "content_sanskrit": "म्लेच्छाचाराः सर्वमभक्षा दारुणा सर्वकर्मसु।\nभाविन पश्चिमे काले मनुष्या नात्र संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2025970, "chapter_id": 1555, "verse_number": "३-१९३-५४", "content_sanskrit": "क्रयविक्रयकाले च सर्वः सर्वस्य वञ्चनम्।\nयुगान्ते भरतश्रेष्ठ वित्तलोभात्करिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2025971, "chapter_id": 1555, "verse_number": "३-१९३-५५", "content_sanskrit": "ज्ञानानि चाप्यविज्ञाय करिष्यन्ति क्रियास्तथा।\nआत्मच्छन्देन वर्तन्ते युगान्ते समुपस्थिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2025972, "chapter_id": 1555, "verse_number": "३-१९३-५६", "content_sanskrit": "स्वभावात्क्रूरकर्माणश्चान्योन्यमभिशंसिनः।\nभवितारो जनाः सर्वे संप्राप्ते तु युगक्षये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2025973, "chapter_id": 1555, "verse_number": "३-१९३-५७", "content_sanskrit": "आरामांश्चैव वृक्षांश्च नाशयिष्यन्ति निर्व्यथाः।\nभविता संशयो लोके जीवितस्य हि देहिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2025974, "chapter_id": 1555, "verse_number": "३-१९३-५८", "content_sanskrit": "तथा लोभाभिभूताश्च भविष्यन्ति नरा नृप।\nब्राह्मणांश्च हनिष्यन्ति ब्राह्मणस्वोपभोगिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2025975, "chapter_id": 1555, "verse_number": "३-१९३-५९", "content_sanskrit": "हाहाकृता द्विजाश्चैव भयार्ता वृषलार्दिताः।\nत्रातारमलाभन्तो वै भ्रमिष्यनति महीमिमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2025976, "chapter_id": 1555, "verse_number": "३-१९३-६०", "content_sanskrit": "जीवितान्तकराः क्रूरा रौद्राः प्राणिविहिंसकाः।\nयदा भविष्यन्ति नरास्तदा संक्षेप्स्यते युगम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2025977, "chapter_id": 1555, "verse_number": "३-१९३-६१", "content_sanskrit": "आश्रयिष्यन्ति च नदी पर्वतान्विषमाणि च।\nप्रधावमाना वित्रस्ता द्विजाः कुरुकुलोद्वह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2025978, "chapter_id": 1555, "verse_number": "३-१९३-६२", "content_sanskrit": "दस्युभिः पीडिता राजन्काका इव द्विजोत्तमाः।\nकुराजभिश्च सततं करभारप्रपीडिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2025979, "chapter_id": 1555, "verse_number": "३-१९३-६३", "content_sanskrit": "धैर्यं त्यक्त्वा महीपाल दारुणे युगसंक्षये।\nविकर्माणि करिष्यन्ति शूद्राणां परिचारकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2025980, "chapter_id": 1555, "verse_number": "३-१९३-६४", "content_sanskrit": "शूद्रा धर्मं प्रवक्ष्यन्ति ब्राह्मणाः पर्युपासकाः।\nश्रोतारश्च भविष्यन्ति प्रामाण्येन व्यवस्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2025981, "chapter_id": 1555, "verse_number": "३-१९३-६५", "content_sanskrit": "विपरीतश्च लोकोऽयं भविष्यत्यधरोत्तरः।\nएडूकान्पूजयिष्यन्ति वर्जयिष्यन्ति देवताः।\nशूद्राश्च प्रभविष्यन्ति न द्विजा युगसंक्षये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2025982, "chapter_id": 1555, "verse_number": "३-१९३-६६", "content_sanskrit": "आश्रमेषुमहर्षीणां ब्राह्मणावसथेषु च।\nदेवस्थानेषु चैत्येषु नागानामालयेषु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2025983, "chapter_id": 1555, "verse_number": "३-१९३-६७", "content_sanskrit": "एडूकचिह्ना पृथिवी न देवगृहभूषिता।\nभविष्यति युगे क्षीणे तद्युगान्तस्य लक्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2025984, "chapter_id": 1555, "verse_number": "३-१९३-६८", "content_sanskrit": "दा रौद्रा धर्महीना मांसादाः पानपास्तथा।\nभविष्यन्ति नरा नित्यं तदा संक्षेप्स्यते युगम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2025985, "chapter_id": 1555, "verse_number": "३-१९३-६९", "content_sanskrit": "पुष्पं पुष्पे यदा राजन्फले वा फलमाश्रितम्।\nप्रजास्यति महाराज तदा संक्षेप्स्यते युगम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2025986, "chapter_id": 1555, "verse_number": "३-१९३-७०", "content_sanskrit": "अकालवर्षी पर्जन्यो भविष्यति गते युगे।\nअक्रमेण मनुष्याणां भविष्यनति तदा क्रियाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2025987, "chapter_id": 1555, "verse_number": "३-१९३-७१", "content_sanskrit": "विरोधमथ यास्यनति वृषला ब्राह्मणैः सह।\nमही म्लेच्छजनाकीर्णा भविष्यति ततोऽचिरात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2025988, "chapter_id": 1555, "verse_number": "३-१९३-७२", "content_sanskrit": "करभारभयाद्विप्रा भजिष्यन्ति दिशो दश।\n`अन्यायवर्तिनश्चापि भविष्यनति नराधिपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2025989, "chapter_id": 1555, "verse_number": "३-१९३-७३", "content_sanskrit": "निर्विशेषा जनपदास्तथा विष्टिकरार्दिताः।\nआश्रमानुपलप्स्यन्ति फलमूलोपजीविनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2025990, "chapter_id": 1555, "verse_number": "३-१९३-७४", "content_sanskrit": "एवं पर्याकुले लोके मर्यादा न भविष्यति।\n`ब्राह्मणःक्षत्रियावैश्याः परित्यक्ष्यन्ति सत्क्रियाम्\nन स्थास्यन्त्युपदेशे च शिष्या विप्रियकारिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2025991, "chapter_id": 1555, "verse_number": "३-१९३-७५", "content_sanskrit": "आचार्योपनिधिश्चैव भर्त्स्यते तदनन्तरम्।\nअर्थयुक्त्या प्रवात्स्यन्ति मित्रसंबन्धिबान्धवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2025992, "chapter_id": 1555, "verse_number": "३-१९३-७६", "content_sanskrit": "अभावः सर्वभूतानां युगान्ते संभविष्यति।\nदिशः प्रज्वलिता सर्वा नक्षत्राण्यप्रभाणि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2025993, "chapter_id": 1555, "verse_number": "३-१९३-७७", "content_sanskrit": "प्रधूपितानि ज्योतींषि वाताः पर्याकुलास्तथा।\nउल्कापाताश्च बहवो महाभयनिदर्शकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2025994, "chapter_id": 1555, "verse_number": "३-१९३-७८", "content_sanskrit": "षङ्भिरन्यैश्च सहितो भास्करः प्रतपिष्यति।\nतुमुलाश्चापि निर्ह्रादा दिग्दाहाश्चापि सर्वशः।\nकबन्धान्तर्हितो भानुरुदयास्तमने तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2025995, "chapter_id": 1555, "verse_number": "३-१९३-७९", "content_sanskrit": "अकालवर्षी भगवान्भविष्यति सहस्रदृक्।\nसस्यानि च न रोक्ष्यन्ति युगान्ते पर्युपस्थिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2025996, "chapter_id": 1555, "verse_number": "३-१९३-८०", "content_sanskrit": "अभीक्ष्णं क्रूरवादिन्यः परुषा रदितप्रियाः।\nभर्तॄणां वचने चैव न स्थास्यन्ति ततः स्त्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2025997, "chapter_id": 1555, "verse_number": "३-१९३-८१", "content_sanskrit": "पुत्राश्च मातापितरौ हनिष्यन्ति युगक्षये।\nसूदयिष्यन्ति च पतीन्स्त्रियः पुत्रानपाश्रिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2025998, "chapter_id": 1555, "verse_number": "३-१९३-८२", "content_sanskrit": "अपर्वणि महाराज सूर्यं राहुरुपैष्यति।\nयुगान्ते हुतभुक्वापि सर्वतः प्रज्वलिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2025999, "chapter_id": 1555, "verse_number": "३-१९३-८३", "content_sanskrit": "पानीयं भोजनं चापि याचमानास्तदाऽध्वगाः।\nन लप्स्यन्ते निवासं च निरस्ताः पथि शेरते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2026000, "chapter_id": 1555, "verse_number": "३-१९३-८४", "content_sanskrit": "निर्घातवायसा नागाः शकुनाः समृगद्विजाः।\nरूक्षा वाचो विमोक्ष्यन्ति युगान्ते पर्युपस्थिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2026001, "chapter_id": 1555, "verse_number": "३-१९३-८५", "content_sanskrit": "मित्रसंबन्धिनश्चापि संत्यक्ष्यनति नरास्तदा।\nजनं परिजनं चापि यागान्ते पर्युपस्थिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2026002, "chapter_id": 1555, "verse_number": "३-१९३-८६", "content_sanskrit": "अथ देशान्दिशश्चापि पत्तनान्यापणानि च।\nक्रमशः संलयिष्यन्ति युगान्ते पर्युपस्थिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2026003, "chapter_id": 1555, "verse_number": "३-१९३-८७", "content_sanskrit": "हा तात हा सुतेत्येवं तदा वाच सुदारुणाः।\nविक्रोशमानश्चान्योन्यं जनो गां पर्यटिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2026004, "chapter_id": 1555, "verse_number": "३-१९३-८८", "content_sanskrit": "`मोवादिनस्तथा शूद्रा ब्राह्मणाः प्राकृतप्रियाः।\nपाषण्डजनसंकीर्णा भविष्यन्ति युगक्षये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2026005, "chapter_id": 1555, "verse_number": "३-१९३-८९", "content_sanskrit": "ततस्तुमुलसंघाते वर्तमाने युगक्षये।\nद्विजातिपूर्वको लोकः क्रमेण प्रभविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2026006, "chapter_id": 1555, "verse_number": "३-१९३-९०", "content_sanskrit": "ततः कालान्तरेऽन्यस्मिन्पुनर्लोकविवृद्धये।\nभविष्यति पुनर्दैवमनुकूलं यदृच्छया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2026007, "chapter_id": 1555, "verse_number": "३-१९३-९१", "content_sanskrit": "यदा सूर्यश्च चन्द्रश्च तथा तिष्यबृहस्पती।\nएकराशौ समेष्यन्ति प्रपत्स्यति तदा कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2026008, "chapter_id": 1555, "verse_number": "३-१९३-९२", "content_sanskrit": "कालवर्षी च पर्जन्यो नक्षत्राणि शुभानि च।\nप्रदक्षिणा ग्रहाश्चापि भविष्यन्त्यनुलोमगाः।\nक्षेमं सुभिक्षमारोग्यं भविष्यति निरामयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2026009, "chapter_id": 1555, "verse_number": "३-१९३-९३", "content_sanskrit": "कल्की विष्णुयशा नाम द्विजः कालप्रचोदितः।\nउत्पत्स्यते महावीर्यो महाबुद्धिपराक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2026010, "chapter_id": 1555, "verse_number": "३-१९३-९४", "content_sanskrit": "संभूतः संभलग्रामे ब्राह्मणावसथे शुभे।\n`महात्मा वृत्तसंपन्नः प्रजानां हितकृन्नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2026011, "chapter_id": 1555, "verse_number": "३-१९३-९५", "content_sanskrit": "मनसा तस्य सर्वाणि वाहनान्यायुधानि च।\nउपस्तास्यन्ति योधाश्च शस्त्राणि कवचानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2026012, "chapter_id": 1555, "verse_number": "३-१९३-९६", "content_sanskrit": "स धर्मविजयी राजा चक्रवर्ती भविष्यति।\nसचेमं संकुलं लोकं प्रसादमुपनेष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2026013, "chapter_id": 1555, "verse_number": "३-१९३-९७", "content_sanskrit": "उत्थितो ब्राह्मणो दीप्तः क्षयान्तकृदुदारधीः।\nसंक्षेपको हि सर्वस्य युगस्य परिवर्तकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2026014, "chapter_id": 1555, "verse_number": "३-१९३-९८", "content_sanskrit": "स सर्वत्र गतान्क्षुद्रान्ब्राह्मणैः परिवारितः।\nउत्सादयिष्यति तदा सर्वम्लेच्छगणान्द्विजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2026015, "chapter_id": 1555, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि मार्कण्डेयसमास्यापर्वणि त्रिनवत्यधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}]