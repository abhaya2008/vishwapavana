[{"id": 2070800, "chapter_id": 2490, "verse_number": "११-२२-०x", "content_sanskrit": "गान्धार्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2070801, "chapter_id": 2490, "verse_number": "११-२२-१", "content_sanskrit": "आवनत्यं भीमसेनेन भक्षयन्ति निपातितम्।\nगृध्रगोमायवः शूरं दूरबन्धुमबन्धुवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2070802, "chapter_id": 2490, "verse_number": "११-२२-२", "content_sanskrit": "तं पश्य कदनं कृत्वा शूराणां मधुसूदन।\nशयानं वीरशयने रुधिरेण समुक्षितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2070803, "chapter_id": 2490, "verse_number": "११-२२-३", "content_sanskrit": "तं सृगालाश्च कङ्काश्च क्रव्यादाश्च पृथग्विधाः।\nतेनतेन विकर्षन्ति पश्य कालस्य पर्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2070804, "chapter_id": 2490, "verse_number": "११-२२-४", "content_sanskrit": "शयानं वीरशयने शूरमाक्रन्दकारिणम्।\nआवन्त्यमभितो नार्यो रुदत्यः पर्युपासते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2070805, "chapter_id": 2490, "verse_number": "११-२२-५", "content_sanskrit": "प्रातिपेयं महेष्वासं हतं भीमेन बाह्लिकम्।\nप्रसुप्तमिव शार्दुलं पश्य कृष्णमनस्विनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2070806, "chapter_id": 2490, "verse_number": "११-२२-६", "content_sanskrit": "अतीव मुखवर्णोऽस्य निहतस्यापि शोभते।\nसोमस्यवाभिपूर्णस्य पौर्णमास्यां समुद्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2070807, "chapter_id": 2490, "verse_number": "११-२२-७", "content_sanskrit": "पुत्रशोकाभितप्तेन प्रतिज्ञां चाभिरक्षता।\nपाकशासनिना सङ्ख्ये वार्धक्षत्रिर्निपातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2070808, "chapter_id": 2490, "verse_number": "११-२२-८", "content_sanskrit": "एकादशचमूर्भित्त्वा रक्ष्यमाणं महात्मभिः।\nसत्यं चिकीर्षता पश्य हतमेनं जयद्रथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2070809, "chapter_id": 2490, "verse_number": "११-२२-९", "content_sanskrit": "सिन्धुसौवीरभर्तारं दर्पपूर्णं मनस्विनम्।\nभक्षयन्ति शिवा गृध्रा जनार्दन जयद्रथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2070810, "chapter_id": 2490, "verse_number": "११-२२-१०", "content_sanskrit": "संरक्ष्यमाणं भार्याभिरनुरक्ताभिरच्युत।\nभीषयन्त्यो विकर्षन्ति गहनं निम्नमन्तिकात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2070811, "chapter_id": 2490, "verse_number": "११-२२-११", "content_sanskrit": "तमेताः पर्यपासन्ते वीक्षमाणा महाभुजम्।\nसिन्धुसौवीरकाम्भोजगान्धारयवनस्त्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2070812, "chapter_id": 2490, "verse_number": "११-२२-१२", "content_sanskrit": "यदा कृष्णामुपादाय प्राद्रवत्केकयैः सह।\nतदैव वध्यः पाण्डूनां जनार्दन जयद्रथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2070813, "chapter_id": 2490, "verse_number": "११-२२-१३", "content_sanskrit": "दुःशलां मानयद्भिस्तु तदा मुक्तो जयद्रथः।\nकथमद्य न तां कृष्ण मानयन्ति स्म ते पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2070814, "chapter_id": 2490, "verse_number": "११-२२-१४", "content_sanskrit": "सैन्धवं मे सुता बाला प्रस्स्वलन्तीव दुःखिता।\nप्रमापयन्ती चात्मानमाक्रोशन्तीव पाण्डवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2070815, "chapter_id": 2490, "verse_number": "११-२२-१५", "content_sanskrit": "किन्नु दुःखतरं कृष्ण परं मम भविष्यति।\nयत्सुता विधवा बाला स्नुषाश्च निहतेश्वराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2070816, "chapter_id": 2490, "verse_number": "११-२२-१६", "content_sanskrit": "हाहा धिग्धुःशलां पश्य वीतशोकभयामिव।\nभर्तुः शिर अपश्यन्तीं धावमानामितस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2070817, "chapter_id": 2490, "verse_number": "११-२२-१७", "content_sanskrit": "वारयामास यः सर्वान्पाण्डवान्पुत्रगृद्विनः।\nस हत्वा विपुलाः सेनाः सर्वयं मृत्युवशं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2070818, "chapter_id": 2490, "verse_number": "११-२२-१८", "content_sanskrit": "तं मत्तमिव मातङ्गं वीरं परमदुर्जयम्।\nपरिवार्य रुदन्त्येताः स्त्रियश्चन्द्रोपमाननाः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2070819, "chapter_id": 2490, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते स्त्रीपर्वणि स्त्रीविलापपर्वणि द्वाविंशोऽध्यायः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]