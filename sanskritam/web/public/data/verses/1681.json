[{"id": 2031272, "chapter_id": 1681, "verse_number": "४-४-०x", "content_sanskrit": "वैशम्पायन उवाच ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2031273, "chapter_id": 1681, "verse_number": "४-४-१", "content_sanskrit": "इत्येवमुक्त्वा पुरुषप्रवीरस्तथार्जुनो धर्मामृतां वरिष्ठः।\nवाक्यं तथासौ .... भूयो नृपोऽपरं भ्रातर...बभाषे", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2031274, "chapter_id": 1681, "verse_number": "४-४-२", "content_sanskrit": "किंकर्मा किंसमाचारो नकुलोयं भविष्यति।\nसुकुमारश्च शूरश्च दर्शनीयः सुखोचितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2031275, "chapter_id": 1681, "verse_number": "४-४-३", "content_sanskrit": "अदुःखार्हश्च बालश्च लालितश्चापि नित्यशः ।\nसोयमार्तश्च शान्तश्च किं नु रोचयतात्त्विह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2031276, "chapter_id": 1681, "verse_number": "४-४-४", "content_sanskrit": "किं त्वं नकुल कुर्वाणस्तस्य तात चरिष्यसि।\nकर्म तत्त्वं समाचक्ष्व राज्ये तस्य महीपतेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2031277, "chapter_id": 1681, "verse_number": "४-४-५x", "content_sanskrit": "नकुल उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2031278, "chapter_id": 1681, "verse_number": "४-४-५", "content_sanskrit": "अश्वाध्यक्षो भविष्यामि विराटस्येति मे मतिः।\nदामग्रन्थीति नाम्नाऽहं कर्मैतत्सुप्रियं मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2031279, "chapter_id": 1681, "verse_number": "४-४-६", "content_sanskrit": "दामग्नन्थी परिज्ञातः कुशलो दामकर्मणि ।\nन मां परिभविष्यन्ति जना जात्विह कर्हिचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2031280, "chapter_id": 1681, "verse_number": "४-४-७", "content_sanskrit": "कुशलोत्स्म्यश्वशिक्षायां तथैवाश्वचिकित्सने।\nप्रियाश्च सततं मेऽश्वाः कुरुराजा यथा तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2031281, "chapter_id": 1681, "verse_number": "४-४-८", "content_sanskrit": "न मां परिभविष्यन्ति किशोरा वडवास्तथा ।\nन दुष्टाश्च भविष्यन्ति पृष्ठे धुरि च मद्गताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2031282, "chapter_id": 1681, "verse_number": "४-४-९", "content_sanskrit": "द्रक्ष्यन्ति ये च मां केचिद्विराटनगरे जनाः ।\nतेभ्य एवं प्रवक्ष्यामि विहरिष्याम्यहं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2031283, "chapter_id": 1681, "verse_number": "४-४-१०", "content_sanskrit": "पाण्डवेन ह्यहं तात अश्वेष्वधिकृतः पुरा।\nइति तस्य पुरे छन्नश्चरिष्यामि महीपते ।\nइत्येतद्वः प्रतिज्ञातं विहरिष्याम्यहं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2031284, "chapter_id": 1681, "verse_number": "४-४-११x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2031285, "chapter_id": 1681, "verse_number": "४-४-११", "content_sanskrit": "नकुलेनैवमुक्तस्तु धर्मराजोऽब्रवीद्वचः।\nबृहस्पतिसमो बुद्ध्या नयेनोशनसा समः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2031286, "chapter_id": 1681, "verse_number": "४-४-१२", "content_sanskrit": "मन्त्रैर्नानाविधैर्नीतः पथ्येषु परिनिष्ठितः ।\nसुप्रणीतः सुमार्गस्थो राजतन्त्रमवाप यः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2031287, "chapter_id": 1681, "verse_number": "४-४-१३", "content_sanskrit": "न चास्य स्खलितं किंचिद्ददृशुस्तद्विदो जनाः।\nसुनीतिज्ञश्च शूरश्च सर्वमन्त्रविशारदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2031288, "chapter_id": 1681, "verse_number": "४-४-१४", "content_sanskrit": "अधिको मातुरस्माकं कुन्त्याः प्रियतमः सदा।\nसहदेव कथं कर्म तस्य राज्ञः करिष्यसि।\nकिं वा त्वं तात कुर्वाणः प्रच्छन्नो विचरिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2031289, "chapter_id": 1681, "verse_number": "४-४-१५x", "content_sanskrit": "सहदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2031290, "chapter_id": 1681, "verse_number": "४-४-१५", "content_sanskrit": "गोसङ्ख्याता भविष्यामि विराटस्येति रोचये।\nप्रतिभोक्ता च दोग्धा च सङ्ख्यानकुशलो गवाम्।\nतन्त्रीपालेति मे नाम स्वयं प्रोक्तं भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2031291, "chapter_id": 1681, "verse_number": "४-४-१६", "content_sanskrit": "अयोगा बहुलाः पुष्टाः क्षीरवत्यो बहुप्रजाः ।\nनिष्पन्नसत्त्वाः सुभृता ह्यपेतज्वरकिल्विषाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2031292, "chapter_id": 1681, "verse_number": "४-४-१७", "content_sanskrit": "दृष्टचोरभया नित्यं व्याधिव्याघ्रविवर्जिताः ।\nगावः सुसहिता राजन्निरुद्विग्ना निरामयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2031293, "chapter_id": 1681, "verse_number": "४-४-१८", "content_sanskrit": "भविष्यन्ति मया गुप्ता विराटनगरे तदा।\nनिपुणत्वं चरिष्यामि प्रीतिरत्र परा हि मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2031294, "chapter_id": 1681, "verse_number": "४-४-१९", "content_sanskrit": "अहं हि भवता गोषु प्रहितः सतत पुरा।\nतत्र मे कौशलं सर्वमनुबद्धं विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2031295, "chapter_id": 1681, "verse_number": "४-४-२०", "content_sanskrit": "लक्षणं चरितं चैव गवां यच्चापि मङ्गलम् ।\nसत्सर्वं मे सुविदितमन्यच्चापि विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2031296, "chapter_id": 1681, "verse_number": "४-४-२१", "content_sanskrit": "वृषभानपि जानामि राजन्पूजितलक्षणान्।\nयेषां मूत्रमुपाघ्राय अपि वन्ध्या प्रसूयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2031297, "chapter_id": 1681, "verse_number": "४-४-२२", "content_sanskrit": "सोऽहमेवं चरिष्यामि प्रीतिरत्र परा हि मे।\nविराटनगरे गूढो रंस्येऽहं तेन कर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2031298, "chapter_id": 1681, "verse_number": "४-४-२३", "content_sanskrit": "तोषयिष्ये च राजानां मा भूच्चिन्ता तवानघ ।\nन च मां वेत्स्यति परस्तत्ते रोचतु पार्थिव।\nइत्येतद्वः प्रतिज्ञातं विचरिष्याम्यहं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2031299, "chapter_id": 1681, "verse_number": "४-४-२४x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2031300, "chapter_id": 1681, "verse_number": "४-४-२४", "content_sanskrit": "केनात्र कर्मणा कृष्णा द्रौपदी विचरिष्यति।\nन हि किंचिद्विजानाति कर्म कर्तुं यथा स्त्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2031301, "chapter_id": 1681, "verse_number": "४-४-२५", "content_sanskrit": "माल्यागन्धानलङ्कारान्वस्त्राणि विविधानि च।\nएतान्येवाभिजानाति यथाजाता च भामिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2031302, "chapter_id": 1681, "verse_number": "४-४-२६", "content_sanskrit": "पतिव्रता महाभागा कथं नु विचरिष्यति।\nइयं तु नः प्रिया भार्या प्राणेभ्योपि गरीयसी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2031303, "chapter_id": 1681, "verse_number": "४-४-२७", "content_sanskrit": "मातेव परिपाल्या च पूज्या ज्येष्ठा स्वसेव च ।\nसुकुमारी सुशीला च राजपुत्री यशस्विनी ।\nकथं वत्स्यति कल्याणी विराटनगरे सती ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2031304, "chapter_id": 1681, "verse_number": "४-४-२८x", "content_sanskrit": "द्रौपद्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2031305, "chapter_id": 1681, "verse_number": "४-४-२८", "content_sanskrit": "अहं वत्स्यामि राजेन्द्र निर्वृतो भव पार्थिव।\nयथा ते मत्कृते शोको न भवेन्नृपते शृणु।\nयथा तु मां न जानन्ति यत्करिष्याम्यहं प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2031306, "chapter_id": 1681, "verse_number": "४-४-२९", "content_sanskrit": "छन्ना वत्स्याम्यहं यन्मां न विजानन्ति केचन।\nवृत्तं तच्च समाख्यास्ये शर्म तेस्तु विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2031307, "chapter_id": 1681, "verse_number": "४-४-३०", "content_sanskrit": "सैरन्ध्रीजातिसंपन्ना नाम्नाऽहं व्रतचारिणी ।\nभविष्यामि महाराज विराटस्येति मे मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2031308, "chapter_id": 1681, "verse_number": "४-४-३१", "content_sanskrit": "सैरन्ध्र्यो रक्षिताः स्त्रीणां भुजिष्याः सन्ति भारत ।\nएकपत्न्यः स्त्रियश्चैता इति लोकस्य निश्चयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2031309, "chapter_id": 1681, "verse_number": "४-४-३२", "content_sanskrit": "साऽहं ब्रुवाणा सैरन्ध्री कुशला केशकर्मणि।\nप्रमदाहरिका लोके पुरुषाणां प्रवासिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2031310, "chapter_id": 1681, "verse_number": "४-४-३३", "content_sanskrit": "युधिष्ठिरस्य वै गेहे द्रौपद्याः परिचारिका।\nउषिताऽस्मीति वक्ष्यामि पृष्टा राज्ञा च भारत।\nआत्मगुप्ता चरिष्यामि यन्मां त्वं परिपृच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2031311, "chapter_id": 1681, "verse_number": "४-४-३४", "content_sanskrit": "नाहं तत्र भविष्यामि दुर्भरा राजवेश्मनि।\nकृत्वा चैव सदा रक्षां व्रतेनैव नराधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2031312, "chapter_id": 1681, "verse_number": "४-४-३५", "content_sanskrit": "सुदेष्णां प्रत्युपस्थास्ये राजभार्यां यशस्विनीम् ।\nसा रक्षिष्यति मां प्राप्तां मा ते भूद्दुःखमीदृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2031313, "chapter_id": 1681, "verse_number": "४-४-३६", "content_sanskrit": "अथ गुप्ता चरिष्यामि युष्माभिस्तत्र तस्थुषी।\nइत्येवं वः प्रतिज्ञातं विहरिष्याम्यहं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2031314, "chapter_id": 1681, "verse_number": "४-४-३७x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2031315, "chapter_id": 1681, "verse_number": "४-४-३७", "content_sanskrit": "यथा नो दुर्हृदः पापा भवन्ति सुखिनः पुनः।\nकुर्यास्तथा त्वं कल्याणि लक्षयेयुर्न ते जनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2031316, "chapter_id": 1681, "verse_number": "", "content_sanskrit": "कल्याणं भाषसे कृष्णे यथा कौलेयकी तथा।\nन पापमभिजानासि साध्वी साधुव्रते स्थिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]