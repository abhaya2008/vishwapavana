[{"id": 7000435000, "chapter_id": 20435, "verse_number": "२-१०७-१", "content_sanskrit": "कुंजल उवाच ।\nअथासौ नारदः स्वर्गादायुराजानमागतः ।\nआगत्य कथयामास कस्माद्राजन्प्रशोचसे॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000435001, "chapter_id": 20435, "verse_number": "२-१०७-२", "content_sanskrit": "पुत्रापहरणं तेऽद्य क्षेमं जातं महामते ।\nदेवादीनां महाराज एवं ज्ञात्वा तु मा शुचः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000435002, "chapter_id": 20435, "verse_number": "२-१०७-३", "content_sanskrit": "सर्वज्ञः सगुणो भूत्वा सर्वविज्ञानसंयुतः ।\nसर्वकलाभिसंपूर्ण आगमिष्यति ते सुतः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000435003, "chapter_id": 20435, "verse_number": "२-१०७-४", "content_sanskrit": "येनाप्यपहृतस्तेऽद्य बालो देवगुणोपमः ।\nआत्मगेहे महाराज कालो नीतो न संशयः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000435004, "chapter_id": 20435, "verse_number": "२-१०७-५", "content_sanskrit": "तस्याप्यंतं स वै कर्त्ता महावीर्यो महाबलः ।\nस त्वामभ्येष्यते भूप शिवस्य सुतया सह॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000435005, "chapter_id": 20435, "verse_number": "२-१०७-६", "content_sanskrit": "इंद्रोपेंद्रसमः पुत्रो भविष्यति स्वतेजसा ।\nइंद्रत्वं भोक्ष्यते सोऽपि निजैश्च पुण्यकर्मभिः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000435006, "chapter_id": 20435, "verse_number": "२-१०७-७", "content_sanskrit": "एवमाभाष्य राजानमायुं देवर्षिसत्तमः ।\nजगाम सहसा तस्य पश्यतः सानुगस्य ह॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000435007, "chapter_id": 20435, "verse_number": "२-१०७-८", "content_sanskrit": "गते तस्मिन्महाभागे नारदे देवसंमिते ।\nआयुरागत्य तां राज्ञीं तत्सर्वं विन्यवेदयत्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000435008, "chapter_id": 20435, "verse_number": "२-१०७-९", "content_sanskrit": "दत्तात्रेयेण यो दत्तः पुत्रो देववरोत्तमः ।\nस वै राज्ञि कुशल्यास्ते विष्णोश्चैव प्रसादतः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000435009, "chapter_id": 20435, "verse_number": "२-१०७-१०", "content_sanskrit": "येनाप्यसौ हृतः पुत्रः सगुणो मे वरानने ।\nशिरस्तस्य गृहीत्वा तु पुनरेवागमिष्यति॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000435010, "chapter_id": 20435, "verse_number": "२-१०७-११", "content_sanskrit": "इत्याह नारदो भद्रे मा कृथाः शोकमेव च ।\nत्यज चैनं महामोहं कार्यधर्मविनाशनम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000435011, "chapter_id": 20435, "verse_number": "२-१०७-१२", "content_sanskrit": "भर्तुर्वाक्यं निशम्यैवं राज्ञी इंदुमती ततः ।\nहर्षेणापि समाविष्टा पुत्रस्यागमनं प्रति॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000435012, "chapter_id": 20435, "verse_number": "२-१०७-१३", "content_sanskrit": "यथोक्तं देवऋषिणा तत्तथैव भविष्यति ।\nदत्तात्रेयेण मे दत्तस्तनपो ह्यजरामरः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000435013, "chapter_id": 20435, "verse_number": "२-१०७-१४", "content_sanskrit": "भविष्यति न संदेहः प्रतिभात्येनमेव हि ।\nइत्येवं चिंतयित्वा तु ननाम द्विजपुंगवम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000435014, "chapter_id": 20435, "verse_number": "२-१०७-१५", "content_sanskrit": "नमोस्तु तस्मै परिसिद्धिदाय अत्रेः सुपुत्राय महात्मने च ।\nयस्य प्रसादेन मया सुपुत्रः प्राप्तः सुधीरः सुगुणः सुपुण्यः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000435015, "chapter_id": 20435, "verse_number": "२-१०७-१६", "content_sanskrit": "एवमुक्त्वा तु सा देवी विरराम सुदुःखिता ।\nआगमिष्यंतमाज्ञाय नहुषं तनयं पुनः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]