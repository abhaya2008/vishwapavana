[{"id": 7004154000, "chapter_id": 24154, "verse_number": "५-१-३-१", "content_sanskrit": "सनत्कुमार उवाच ।\nछिन्ने वक्त्रे ततो ब्रह्मा क्रोधेन तमसा वृतः ।\nललाटे स्वदमुत्पन्नं गृहीत्वाऽताडयद्भुवि॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004154001, "chapter_id": 24154, "verse_number": "५-१-३-२", "content_sanskrit": "तत्स्वेदात्कुंडली जज्ञे सधनुः समहेषुधिः ।\nसहस्रकवचो वीरः किं करोमीत्युवाच ह॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004154002, "chapter_id": 24154, "verse_number": "५-१-३-३", "content_sanskrit": "तमुवाच विरंचिस्तु दर्शयन्रुद्रमोजसा ।\nवध्यतामेष दुर्बुद्धिर्जायते न यथा पुनः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004154003, "chapter_id": 24154, "verse_number": "५-१-३-४", "content_sanskrit": "ब्रह्मणो वचनं श्रुत्वा धनुरुद्यम्य पृष्ठतः ।\nस प्रतस्थे महेशस्य बाणहस्तोऽतिरोषभृत्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004154004, "chapter_id": 24154, "verse_number": "५-१-३-५", "content_sanskrit": "स दृष्ट्वा पुरुषं चोग्रमगमद्विस्मितो भवः ।\nदिव्यबाणधनुर्हस्तं वेगविक्रांतगामिनम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004154005, "chapter_id": 24154, "verse_number": "५-१-३-६", "content_sanskrit": "मया न वध्योऽतिबलः सखा विष्णोर्भविष्यति ।\nअनुग्राह्यो ह्यहं तेन सख्यार्थं तपसि स्थितः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004154006, "chapter_id": 24154, "verse_number": "५-१-३-७", "content_sanskrit": "चिंतयन्नित्थमीशोऽपि विष्णोराश्रममभ्यगात् ।\nहुंकारध्वनिना ब्रह्मन्मोहयित्वा ततो नरम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004154007, "chapter_id": 24154, "verse_number": "५-१-३-८", "content_sanskrit": "प्रपात्य च तदा हृष्टः क्रीडां कुर्वञ्जगत्स्थितौ ।\nयत्र नारायणः श्रीमांस्तपस्तेपे प्रतापवान्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004154008, "chapter_id": 24154, "verse_number": "५-१-३-९", "content_sanskrit": "अदृश्यः सर्वभूतानां विश्वात्मा विश्वसृग्विभुः ।\nतत्र प्राप्तो विरूपाक्षो ददर्श मधुसूदनम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004154009, "chapter_id": 24154, "verse_number": "५-१-३-१०", "content_sanskrit": "एकांगुष्ठस्थितं भूमौ तपोऽत्यंतमनातुरम् ।\nयुगांतार्कसहस्रस्य तेजसा वृतमद्भुतम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004154010, "chapter_id": 24154, "verse_number": "५-१-३-११", "content_sanskrit": "पुण्या धारसमायुक्तं पुराणपुरुषोत्तमम् ।\nदृष्ट्वा नारायणं देवं भिक्षां देहीत्युवाच ह॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004154011, "chapter_id": 24154, "verse_number": "५-१-३-१२", "content_sanskrit": "कपालं दर्शयित्वाग्रे ज्वलज्ज्वलनसोत्कटम् ।\nकपालपाणिं संप्रेक्ष्य रुद्रं विष्णुरचिंतयत्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004154012, "chapter_id": 24154, "verse_number": "५-१-३-१३", "content_sanskrit": "कोऽन्यो योग्यो भवेद्भिक्षुर्भिक्षादानस्य सांप्रतम् ।\nयोग्योऽयमिति संकल्प्य दक्षिणं भुजमर्पयत्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004154013, "chapter_id": 24154, "verse_number": "५-१-३-१४", "content_sanskrit": "तं बिभेदांतर्गतज्ञः शूलेन शशिशेखरः ।\nततः प्रवाह उत्पन्नः शोणितस्य विभोर्भुजात्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004154014, "chapter_id": 24154, "verse_number": "५-१-३-१५", "content_sanskrit": "जांबूनदरसाकारा वह्निज्वालेव निर्मला ।\nनिष्पपात कपालांते शंभुना संप्रतीच्छिता॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004154015, "chapter_id": 24154, "verse_number": "५-१-३-१६", "content_sanskrit": "ऋज्वी वेगवती शिप्रा दीधितीवांबरे रवेः ।\nपंचाशद्योजना दीर्घा विस्तारे दशयोजना॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004154016, "chapter_id": 24154, "verse_number": "५-१-३-१७", "content_sanskrit": "दिव्यं वर्षसहस्रं सा समुवाह हरेर्भुजात् ।\nकियंतं कालमीशो हि भिक्षां जग्राह भावितः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004154017, "chapter_id": 24154, "verse_number": "५-१-३-१८", "content_sanskrit": "दत्तां नारायणेनाथ सत्पात्रे पात्र उत्तमे ।\nततो नारायणः प्राह हरं परमिदं वचः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004154018, "chapter_id": 24154, "verse_number": "५-१-३-१९", "content_sanskrit": "संपूर्णं तव पात्रं हि ततो वै परमेश्वरः ।\nसतोयांबुदनिर्घोषं श्रुत्वा वाक्यं हरेर्हरः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004154019, "chapter_id": 24154, "verse_number": "५-१-३-२०", "content_sanskrit": "शशिसूर्याग्नि नयनः शशिशेखरशोभितः ।\nकपाले दृष्टिमावेश्य त्रिनेत्रैश्च जनार्दनम्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004154020, "chapter_id": 24154, "verse_number": "५-१-३-२१", "content_sanskrit": "अंगुल्या घटयन्प्राह कपालं चातिपूरितम् ।\nश्रुत्वा हरिरिदं वाक्यं रक्तधारां समाहरत्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004154021, "chapter_id": 24154, "verse_number": "५-१-३-२२", "content_sanskrit": "पार्श्वतोथ हरेरीशः स्वांगुल्या रुधिरं तदा ।\nदिव्यं वर्षसहस्रं च दृष्टिपातं ममंथ वै॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004154022, "chapter_id": 24154, "verse_number": "५-१-३-२३", "content_sanskrit": "मथ्यमाने ततो रक्ते कललं बुद्बुदं क्रमात् ।\nबभूव च ततः पश्चात्किरीटी सशरासनः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004154023, "chapter_id": 24154, "verse_number": "५-१-३-२४", "content_sanskrit": "सहस्रबाहू रक्ताक्षो धनुर्ज्यां संस्पृशन्मुहुः ।\nबभूव तूणीरगलो वृषस्कंधोंऽगुलित्रवान्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004154024, "chapter_id": 24154, "verse_number": "५-१-३-२५", "content_sanskrit": "पुरुषोऽर्जुनसंकाशः कपाले संप्रकाशयन् ।\nतं दृष्ट्वा भगवान्विष्णुः प्राह रुद्रमिदं वचः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004154025, "chapter_id": 24154, "verse_number": "५-१-३-२६", "content_sanskrit": "कपाले भगवन्कोऽयं प्रादुर्भूतोऽभवन्नरः ।\nउक्तिं श्रुत्वा हरेरीशस्तमुवाच हरे शृणु॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004154026, "chapter_id": 24154, "verse_number": "५-१-३-२७", "content_sanskrit": "नरो नामेति पुरुषः परमास्त्रविदांवरः ।\nयस्त्वयोक्तो नर इति नरस्तस्माद्भ विष्यति॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004154027, "chapter_id": 24154, "verse_number": "५-१-३-२८", "content_sanskrit": "नरनारायणौ चोभौ युगे ख्यातौ भविष्यतः ।\nसंग्रामे देवकार्येषु लोकानां परिपालने॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004154028, "chapter_id": 24154, "verse_number": "५-१-३-२९", "content_sanskrit": "एष नारायण सखा नरस्तव भविष्यति ।\nतव एकाकिनः संख्ये तपसश्च महामुनिः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004154029, "chapter_id": 24154, "verse_number": "५-१-३-३०", "content_sanskrit": "विज्ञानस्य परीक्षायै तेजो लोके भविष्यति ।\nतेजोधिकमिदं दिव्यं ब्रह्मणः पंचमं शिरः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004154030, "chapter_id": 24154, "verse_number": "५-१-३-३१", "content_sanskrit": "तेजसा ब्रह्मणो दीप्तो भुजस्य तव शोणितात् ।\nमम दृष्टिनिपाताच्च त्रीणि तेजांसि यान्यतः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004154031, "chapter_id": 24154, "verse_number": "५-१-३-३२", "content_sanskrit": "तत्संयोगात्समुत्पन्नः शत्रूनुद्वेजयिष्यति ।\nअवध्या ये भविष्यंति दुर्जयास्तव चापरे॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004154032, "chapter_id": 24154, "verse_number": "५-१-३-३३", "content_sanskrit": "शक्रस्य चामरारीणां तेषामेव भयंकरः ।\nएवमुक्तवतः शंभोर्विस्मितस्तस्य तेजसा॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004154033, "chapter_id": 24154, "verse_number": "५-१-३-३४", "content_sanskrit": "हरिरपि स तत्रैव तुष्टाव हरकेशवौ ।\nनमो हर हरे तुभ्यं नमः शंकर विष्णवे॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004154034, "chapter_id": 24154, "verse_number": "५-१-३-३५", "content_sanskrit": "नमस्ते शूलहस्ताय नमस्ते खङ्गपा णये ।\nनमोनमस्ते मेध्याय हृषीकेश नमोऽस्तु ते॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004154035, "chapter_id": 24154, "verse_number": "५-१-३-३६", "content_sanskrit": "नमोऽस्तु वाचां पतये श्रीधराय नमोनमः ।\nएवं स्तुवन्तं तं भक्त्या कृतांजलि पुटं नरम्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004154036, "chapter_id": 24154, "verse_number": "५-१-३-३७", "content_sanskrit": "तथैवांजलिसंबद्धं गृहीत्वाशु करद्वयम् ।\nउद्धृत्याथ कपालात्तु पुनर्वचनमब्रवीत्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004154037, "chapter_id": 24154, "verse_number": "५-१-३-३८", "content_sanskrit": "य एव पुरुषो रौद्रो ब्रह्मणः स्वेदसं भवः ।\nमम हुंकारशब्देन मोहनिद्रामुपागतः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004154038, "chapter_id": 24154, "verse_number": "५-१-३-३९", "content_sanskrit": "निबोध तं च त्वरितमित्युक्त्वांतर्हितो हरः ।\nनारायणस्य प्रत्यक्षं बोधयित्वा द्रुतं हि तम्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004154039, "chapter_id": 24154, "verse_number": "५-१-३-४०", "content_sanskrit": "वामपादेन हत्वा च समुत्तस्थौ नरो रुषा ।\nतयोर्युद्धं समभवत्स्वेदरक्तजयोर्महत्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004154040, "chapter_id": 24154, "verse_number": "५-१-३-४१", "content_sanskrit": "विस्फारितधनुःशब्दैर्नादिताशेषभूत लम् ।\nकवचं स्वेदजस्यैकं रक्तजस्य तथा भुजौ॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004154041, "chapter_id": 24154, "verse_number": "५-१-३-४२", "content_sanskrit": "एवं समेन वै युद्धं दिव्यं जातं तु भूतले ।\nत्रिवर्षोनानि वर्षाणां शतानि दश सुद्विज॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004154042, "chapter_id": 24154, "verse_number": "५-१-३-४३", "content_sanskrit": "युध्यतो समतीतानि स्वेदरक्तजयोर्मुने ।\nरक्तजो द्विभुजो दृष्ट्वा कवचैकेन स्वेदजम्॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004154043, "chapter_id": 24154, "verse_number": "५-१-३-४४", "content_sanskrit": "बिभेद बाणवेगेन ब्रह्मणस्तं नरं परम् ।\nससंभ्रममु वाचेदं ब्रह्माणं मधुसूदनः॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004154044, "chapter_id": 24154, "verse_number": "५-१-३-४५", "content_sanskrit": "मन्नरेणोच्छ्रितो ब्रह्मंस्त्वदीयो विनिपातितः ।\nश्रुत्वा तदाकुलो ब्रह्मा बभाषे मधुसूदनम्॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004154045, "chapter_id": 24154, "verse_number": "५-१-३-४६", "content_sanskrit": "हरेऽन्यजन्मनि नरो मदीयो यदि हीयते ।\nतेन तुष्टेन संप्रोक्तं हरिणैवं भविष्यति॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004154046, "chapter_id": 24154, "verse_number": "५-१-३-४७", "content_sanskrit": "कृत्वा तयो रणमपि निवार्य तावुवाच ह ।\nअथान्यजन्मनि नरो मदीयो भविता कलौ॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004154047, "chapter_id": 24154, "verse_number": "५-१-३-४८", "content_sanskrit": "ततो महारणे जाते तत्राहं योजयामि तम् ।\nविष्णुनाथ समाहूय महेश्वरसुरेश्वरौ॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004154048, "chapter_id": 24154, "verse_number": "५-१-३-४९", "content_sanskrit": "उक्ताविमौ नरौ रुद्रौ पालनीयौ स्वशक्तितः ।\nस्वेदजातासृग्जातौ तु स्वकीयांशौ धरातले ।\nस्वांशभूतौ द्वापरांते नियोज्यौ भूतले त्वया॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004154049, "chapter_id": 24154, "verse_number": "५-१-३-५०", "content_sanskrit": "ततोऽब्रवीत्तदा विष्णुं सुरेशो दुःखितं वचः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004154050, "chapter_id": 24154, "verse_number": "५-१-३-५१", "content_sanskrit": "अस्मिन्मन्वंतरे देव त्रेतायुगं तदा यदा ।\nत्वद्रूपेणेह महता सूर्यपुत्रहितार्थिना ।\nवालीनाम महाबाहुः सुग्रीवार्थे निपातितः॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004154051, "chapter_id": 24154, "verse_number": "५-१-३-५२", "content_sanskrit": "तेन दुःखेन तप्तोऽहं नाहं गृह्णामि ते नरम् ।\nअगृह्णमानं देवेशं कारणांतरवादिनम्॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004154052, "chapter_id": 24154, "verse_number": "५-१-३-५३", "content_sanskrit": "विष्णुः प्रोवाच मघवन्भुवो भारावतारणे ।\nअवतारं करिष्यामि मर्त्यलोकेऽप्यहं विभो॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004154053, "chapter_id": 24154, "verse_number": "५-१-३-५४", "content_sanskrit": "ततो हृष्टोऽभवच्छक्रो विष्णुवाक्येन तेन वै ।\nप्रतिगृह्य नरं हृष्टः सत्यमस्तु वचस्तव॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004154054, "chapter_id": 24154, "verse_number": "५-१-३-५५", "content_sanskrit": "इत्युक्त्वा तु रवीन्द्रौ स प्रेषयित्वा च तौ पुनः ।\nगत्वा च पुण्डरीकाक्षो ब्रह्माणं ब्रह्मवेश्मनि॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004154055, "chapter_id": 24154, "verse_number": "५-१-३-५६", "content_sanskrit": "कृतं जुगुप्सितं कर्म ब्रह्मन्नीशं जिघांसता ।\nयत्त्वया देवदेवेश पुमान्कोपेन भाषितः॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004154056, "chapter_id": 24154, "verse_number": "५-१-३-५७", "content_sanskrit": "शुद्ध्यर्थमस्य पापस्य प्रायश्चित्तं परं कुरु ।\nगृह्णन्वह्नित्रयं ब्रह्मन्नग्नि होत्रमुपास्व ह॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004154057, "chapter_id": 24154, "verse_number": "५-१-३-५८", "content_sanskrit": "एको वै गार्हपत्योऽस्तु द्वितीयाहवनीयकः ।\nदक्षिणाग्निस्तृतीयस्तु त्रिकुण्डेषु प्रकल्पय॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004154058, "chapter_id": 24154, "verse_number": "५-१-३-५९", "content_sanskrit": "वर्तुले तर्पयात्मानं मामथो धनुषाकृतौ ।\nचतुष्कोणे हरं देवमृग्यजुःसामनामभिः॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004154059, "chapter_id": 24154, "verse_number": "५-१-३-६०", "content_sanskrit": "हुत्वा त्वग्निं च तपसा हरमेवार्च्य तत्क्षणात् ।\nदिव्यं वर्षसहस्रं तु हुत्वाग्निं सिद्धिमाप्स्यसि॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004154060, "chapter_id": 24154, "verse_number": "५-१-३-६१", "content_sanskrit": "प्रायश्चित्तविशुद्धात्मा प्रतिपद्य महेश्वरम् ।\nततो निष्कल्मषो भूत्वा विषादस्ते गमिष्यति॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004154061, "chapter_id": 24154, "verse_number": "५-१-३-६२", "content_sanskrit": "इत्येवमुक्त्वा हरिरुग्रतेजा गतः स्वकीयं निलयं महात्मा ।\nब्रह्मापि चित्तं तपसे निधाय समादधे सर्वमथाच्युतोक्तम्॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}]