[{"id": 2105214, "chapter_id": 3270, "verse_number": "१५-८-१", "content_sanskrit": "वैशम्पायन उवाच।\nएवमुक्तः स बीभत्सुर्मातुलेनि परंतप।\nदुर्मना दीनवदनो वसुदेवमुवाच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2105215, "chapter_id": 3270, "verse_number": "१५-८-२", "content_sanskrit": "नाहं वृष्णिप्रवीरेण बन्धुभिश्चैव मातुल।\nविहीनां पृथिवीं द्रष्टुं शक्तश्चिरमिह प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2105216, "chapter_id": 3270, "verse_number": "१५-८-३", "content_sanskrit": "राजा च भीमसेनश्च सहदेवश्च पाण्डवः।\nनकुलो याज्ञसेनी च षडेकमनसो वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2105217, "chapter_id": 3270, "verse_number": "१५-८-४", "content_sanskrit": "राज्ञः संक्रमणे चापि कामोऽयं नित्यमेव हि।\nतमिमं विद्धि सम्प्राप्तं कालं कालविदांवर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2105218, "chapter_id": 3270, "verse_number": "१५-८-५", "content_sanskrit": "सर्वथा वृष्णिदारांस्तु बालं वृद्धं तथैव च।\nनयिष्ये परिगृह्याहमिन्द्रप्रस्थमरिंदम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2105219, "chapter_id": 3270, "verse_number": "१५-८-६", "content_sanskrit": "इत्युक्त्वा दारुकमिदं वाक्यमाह धनंजयः।\nअमात्यान्वृष्णिवीराणां द्रष्टुमिच्छामि माचिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2105220, "chapter_id": 3270, "verse_number": "१५-८-७", "content_sanskrit": "इत्येवमुक्त्वा वचनं सुधर्मां यादवीं सभाम्।\nप्रविवेशार्जुनः शूरः शोचमानो महाभुजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2105221, "chapter_id": 3270, "verse_number": "१५-८-८", "content_sanskrit": "तमासनगतं तत्र सर्वाः प्रकृतयस्तथा।\nब्राह्मणा नागरास्तत्र परिवार्योपतस्थिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2105222, "chapter_id": 3270, "verse_number": "१५-८-९", "content_sanskrit": "तान्दीनमनसः सर्वान्विमूढान्गतचेतसः।\nउवाचेदं वचः काले पार्थो दीनतरस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2105223, "chapter_id": 3270, "verse_number": "१५-८-१०", "content_sanskrit": "शक्रप्रस्थमहं नेष्ये पृष्णन्धकजनं स्वयम्।\nइदं तु नगरं सर्वं समुद्रः प्लावयिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2105224, "chapter_id": 3270, "verse_number": "१५-८-११", "content_sanskrit": "सज्जीकुरुत यानानि रत्नानि विविधानि च।\nवज्रोऽयं भवतां राजा शक्रप्रस्थे भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2105225, "chapter_id": 3270, "verse_number": "१५-८-१२", "content_sanskrit": "सप्तमे दिवसे चैव रवौ विमल उद्गते।\nबहिर्वत्स्यामहे सर्वे सज्जीभावत माचिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2105226, "chapter_id": 3270, "verse_number": "१५-८-१३", "content_sanskrit": "इत्युक्तास्तेन ते सर्वे पार्थेनाक्लिष्टकर्मणा।\nसज्जमाशु ततश्चक्रुः स्वसिद्ध्यर्थं समुत्सुकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2105227, "chapter_id": 3270, "verse_number": "१५-८-१४", "content_sanskrit": "तां रात्रिमवसत्पार्थः केशवस्य निवेशने।\nमहता शोकमोहेन सहसाऽभिपरिप्लुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2105228, "chapter_id": 3270, "verse_number": "१५-८-१५", "content_sanskrit": "श्वोभूतेऽथ ततः शौरिर्वसुदेवः प्रतापवान्।\nयुक्त्वाऽऽत्मानं महातेजा जगाम गतिमुत्तमां॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2105229, "chapter_id": 3270, "verse_number": "१५-८-१६", "content_sanskrit": "ततः शब्दो महानासीद्वसुदेवनिवेशने।\nदारुणः क्रोशतीनां च रुदतीनां च योषिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2105230, "chapter_id": 3270, "verse_number": "१५-८-१७", "content_sanskrit": "प्रकीर्णमूर्धजाः सर्वा विमुक्ताभरणस्रजः।\nउरांसि पाणिभिर्घ्नन्त्यो व्यलपन्तकरुणं स्त्रियः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2105231, "chapter_id": 3270, "verse_number": "१५-८-१८", "content_sanskrit": "तं देवकी च भद्रा च रोहिणी मदिरा तथा।\nअन्वारोढुं व्यवसिता भर्तारं योषितां वराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2105232, "chapter_id": 3270, "verse_number": "१५-८-१९", "content_sanskrit": "ततः शौरिं नृयुक्तेन बहुमूल्येन भारत।\nयानेन महता पार्थो बहिर्निष्क्रामयत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2105233, "chapter_id": 3270, "verse_number": "१५-८-२०", "content_sanskrit": "तमन्वयुस्तत्रतत्रं दुःखसोकसमन्विताः।\nद्वारकावासिनः सर्वे पौरजानपदा हिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2105234, "chapter_id": 3270, "verse_number": "१५-८-२१", "content_sanskrit": "तस्याश्वमेधिकं छत्रं दीप्यमानाश्च पावकाः।\nपुरस्तात्तस्य यानस्य याजकाश्च ततो ययुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2105235, "chapter_id": 3270, "verse_number": "१५-८-२२", "content_sanskrit": "अनुजग्मुश्च तं वीरं देव्यस्ता वै स्वलङ्कृताः॥\nस्त्रीसहस्रैः परिवृता वधूभिश्च सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2105236, "chapter_id": 3270, "verse_number": "१५-८-२३", "content_sanskrit": "यस्तु देशः प्रियस्तस्य जीवतोऽभून्महात्मनः।\nतत्रैनमुपसंकल्प्य वितृमेधं प्रचक्रिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2105237, "chapter_id": 3270, "verse_number": "१५-८-२४", "content_sanskrit": "तं चिताग्निगतं वीरं शूरपुत्रं वराङ्गनाः।\nततोन्वारुरुहुः पत्न्यश्चतस्रः पतिलोकगाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2105238, "chapter_id": 3270, "verse_number": "१५-८-२५", "content_sanskrit": "तं वै चतसृभिः स्त्रीभिरन्वितं पाण्डुनन्दनः।\nअदाहयच्चन्दनैश्च गन्धैरुच्चावचैरपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2105239, "chapter_id": 3270, "verse_number": "१५-८-२६", "content_sanskrit": "ततः प्रादुरभूच्छब्दः समिद्धस्य विभावसोः।\nसामगानां च निर्घोषो नराणां रुदतामपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2105240, "chapter_id": 3270, "verse_number": "१५-८-२७", "content_sanskrit": "ततो वज्रप्रधानास्ते वृष्ण्यन्धककुमारकाः।\nसर्वे चैवोदकं चक्रुः स्त्रियश्चैव महात्मनः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2105241, "chapter_id": 3270, "verse_number": "१५-८-२८", "content_sanskrit": "अलुप्तधर्मस्तं धर्मं कारयित्वा स फल्गुनः।\nजगाम वृष्णयो यत्र विनष्टा भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2105242, "chapter_id": 3270, "verse_number": "१५-८-२९", "content_sanskrit": "स तान्दृष्ट्वा निपतितान्कदने भृशदुःखितः।\nबभूवातीव कौरव्यः प्राप्तकालं चकार ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2105243, "chapter_id": 3270, "verse_number": "१५-८-३०", "content_sanskrit": "यथाप्रधानतश्चैव चक्रे सर्वास्तथा क्रियाः।\nये हता ब्रह्मशापेन मुसलैरेरकोद्भवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2105244, "chapter_id": 3270, "verse_number": "१५-८-३१", "content_sanskrit": "`ततो भगवतो देहं दृष्ट्वा शिष्यः प्रलप्य च।\nस्मृत्वा तद्वचनं सर्वं मोहशोकोपबृंहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2105245, "chapter_id": 3270, "verse_number": "१५-८-३२", "content_sanskrit": "ततः शरीरे रामस्य वासुदेवस्य चोभयोः।\nअन्वीक्ष्य दाहयामास पुरुषैराप्तकारिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2105246, "chapter_id": 3270, "verse_number": "१५-८-३३", "content_sanskrit": "स तेषां विधिवत्कृत्वा प्रेतकार्याणि पाण्डवः।\nसप्तमे दिवसे प्रायाद्रथमारुह्य सत्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2105247, "chapter_id": 3270, "verse_number": "१५-८-३४", "content_sanskrit": "अश्वयुक्तै रथैश्चापि गोखरोष्ट्रयुतैरपि।\nस्त्रियस्ता वृष्णिवीराणां रुदन्त्यः शोककर्शिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2105248, "chapter_id": 3270, "verse_number": "१५-८-३५", "content_sanskrit": "अनुजग्मुर्महात्मानं पाण्डुपुत्रं धनंजयम्।\nभृत्याश्चान्धकवृष्णीनां सादिनो रथिनश्च ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2105249, "chapter_id": 3270, "verse_number": "१५-८-३६", "content_sanskrit": "वीरहीना वृद्धबालाः पौरजानपदास्तथा।\nययुस्ते परिवार्याथ कलत्रं पार्थशासनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2105250, "chapter_id": 3270, "verse_number": "१५-८-३७", "content_sanskrit": "कुञ्जरैश्च गजारोहा ययुः शैलनिर्भस्तथा।\nसपादरक्षैः संयुक्ताः सोत्तरायुधिका ययुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2105251, "chapter_id": 3270, "verse_number": "१५-८-३८", "content_sanskrit": "पुत्राश्चान्धकवृष्णीनां सर्वे पार्थमनुव्रताः।\nब्राह्मणाः क्षत्रिया वैश्याः शूद्राश्चैव महाधनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2105252, "chapter_id": 3270, "verse_number": "१५-८-३९", "content_sanskrit": "दश षट् च सहस्राणि वासुदेवावरोधनम्।\nपुरस्कृत्य ययुर्वज्रं पौत्रं कृष्णस्य धीमतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2105253, "chapter_id": 3270, "verse_number": "१५-८-४०", "content_sanskrit": "बहूनि च सहस्राणि प्रयुतान्यर्बुदानि च।\nभोजवृष्ण्यन्धकस्त्रीणां हतनाथानि निर्ययुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2105254, "chapter_id": 3270, "verse_number": "१५-८-४१", "content_sanskrit": "तत्सागरसमप्रख्यं वृष्णिचक्रं महर्द्धिमत्।\nउवाह रथिनांश्रेष्ठः पार्थः परपुरंजयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2105255, "chapter_id": 3270, "verse_number": "१५-८-४२", "content_sanskrit": "निर्याते तु जने तस्मिन्सागरो मकरालयः।\nद्वारकां रत्नसंपूर्णां जलेनाप्लावयत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2105256, "chapter_id": 3270, "verse_number": "१५-८-४३", "content_sanskrit": "यद्यद्धि पुरुषव्याघ्रो भूमेस्तस्या व्यमुञ्चत।\nतत्तत्संप्लावयामास सलिलेन स सागरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2105257, "chapter_id": 3270, "verse_number": "१५-८-४४", "content_sanskrit": "तदद्भुतमभिप्रेक्ष्य द्वारकावासिनो जनाः।\nतूर्णात्तूर्णतरं जग्मुरहो दैवमिति ब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2105258, "chapter_id": 3270, "verse_number": "१५-८-४५", "content_sanskrit": "काननेषु च रम्येषु पर्वतेषु नदीषु च।\nनिवसन्नानयामास वृष्णिदारान्धनंजयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2105259, "chapter_id": 3270, "verse_number": "१५-८-४६", "content_sanskrit": "स पञ्चनदमासाद्य धीमानतिसमृद्धिमत्।\nदेशे गोपशुधान्याढ्ये निवासमकरोत्प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2105260, "chapter_id": 3270, "verse_number": "१५-८-४७", "content_sanskrit": "ततो लोभः समभवद्दस्यूनां निहतेश्वराः।\nदृष्ट्वा स्त्रियो नीयमानाः पार्थेनैकेन भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2105261, "chapter_id": 3270, "verse_number": "१५-८-४८", "content_sanskrit": "ततस्ते पापकर्माणो लोभोपहतचेतसः।\nआभीरा मन्त्रयामासुः समेत्याशुभदर्शनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2105262, "chapter_id": 3270, "verse_number": "१५-८-४९", "content_sanskrit": "अयमेकोऽर्जुनो धन्वी वृद्धबालं हतेश्वरम्।\nनयत्यस्मानतिक्रम्य् योधाश्चेमे हतौजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2105263, "chapter_id": 3270, "verse_number": "१५-८-५०", "content_sanskrit": "ततो यष्टिप्रहरणा दस्यवस्ते सहस्रशः।\nअभ्यधावन्त वृष्णीनां तं जनं लोप्त्रहारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2105264, "chapter_id": 3270, "verse_number": "१५-८-५१", "content_sanskrit": "महता सिंहनादेन त्रासयन्तः पृथग्जनम्।\nअभिपेतुर्धनार्थं ते कालपर्यायचोदिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2105265, "chapter_id": 3270, "verse_number": "१५-८-५२", "content_sanskrit": "ततो निवृत्तः कौन्तेयः सहसा सपदानुगः।\nउवाच तान्महाबाहुरर्जुनः प्रहसन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2105266, "chapter_id": 3270, "verse_number": "१५-८-५३", "content_sanskrit": "निवर्तध्वमधर्मज्ञा यदि जीवितुमिच्छथ।\nइदानीं शरनिर्भिन्नाः शोचध्वं निहता मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2105267, "chapter_id": 3270, "verse_number": "१५-८-५४", "content_sanskrit": "तथोक्तास्तेन वीरेणि कदर्तीकृत्य तद्वचः।\nअभिपेतुर्जनं मूढा वार्यमाणाः पुनःपुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2105268, "chapter_id": 3270, "verse_number": "१५-८-५५", "content_sanskrit": "ततोऽर्जुनो धनुर्दिव्यं गाण्डीवमजरं महत्।\nकआरोपयितुमारेभे यत्नादिव कथञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2105269, "chapter_id": 3270, "verse_number": "१५-८-५६", "content_sanskrit": "चकार सज्यं कृच्छ्रेणि सम्भ्रमे तुमुले सति।\nचिन्तयामास शस्त्राणि न च सस्मार तान्यपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2105270, "chapter_id": 3270, "verse_number": "१५-८-५७", "content_sanskrit": "वैकृतं तन्महद्दृष्ट्वा भुजवीर्य तथा युधि।\nदिव्यानां च महास्त्राणां विनाशाद्व्रीडितोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2105271, "chapter_id": 3270, "verse_number": "१५-८-५८", "content_sanskrit": "वृष्णियोधाश्च ते सर्वे गजाश्वरथयोधिनः।\nन शेकुरावर्तयितुं ह्रियमाणं स्वकं धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2105272, "chapter_id": 3270, "verse_number": "१५-८-५९", "content_sanskrit": "कलत्रस्य बहुत्वाद्धि सम्पतन्सु ततस्ततः।\nप्रयत्नमकरोत्पार्थो जनस्य परिरक्षणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2105273, "chapter_id": 3270, "verse_number": "१५-८-६०", "content_sanskrit": "मिषतां सर्वयोधानां ततस्ताः प्रमदोत्तमाः।\nसमन्ततोवकृष्यन्त कामाच्चान्याः प्रवव्रजुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2105274, "chapter_id": 3270, "verse_number": "१५-८-६१", "content_sanskrit": "ततो गाण्डीवनिर्मुक्तैः शरैः पार्थो धनंजयः।\nजघान दस्यून्सोद्वेगो वृष्णिभृत्यैः सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2105275, "chapter_id": 3270, "verse_number": "१५-८-६२", "content_sanskrit": "क्षणेन तस्य ते राजन्क्षयं जग्मुरजिह्मगाः।\nअक्षया हि पुरा भूत्वा क्षीणाः क्षतजभोजनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2105276, "chapter_id": 3270, "verse_number": "१५-८-६३", "content_sanskrit": "स शरक्षयमासाद्य दुःखशोकसमाहतः।\nधनुष्कोट्या तदा दस्यूनवधीत्पाकशासनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2105277, "chapter_id": 3270, "verse_number": "१५-८-६४", "content_sanskrit": "[प्रेक्षतस्त्वेव पार्थस्य वृष्ण्यन्धकवरस्त्रियः।\nजग्मुरादाय ते म्लेच्छाः समन्ताज्जनमेजय॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2105278, "chapter_id": 3270, "verse_number": "१५-८-६५", "content_sanskrit": "धनंजयस्तु दैवं तन्मनसाऽचिन्तयत्प्रभुः।\nदुःखसोकसमाविष्टो निःश्वासपरमोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2105279, "chapter_id": 3270, "verse_number": "१५-८-६६", "content_sanskrit": "अस्त्राणां च प्रणाशेन बाहुवीर्यस्य च क्षयात्।\nधनुषश्चाविधेयत्वाच्छराणां संक्षयेण च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2105280, "chapter_id": 3270, "verse_number": "१५-८-६७", "content_sanskrit": "बभूव विमनाः पार्थो दैवमित्युनुचिन्तयन्।\nन्यवर्तत ततो राजन्नेदमस्तीति चिन्तयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2105281, "chapter_id": 3270, "verse_number": "१५-८-६८", "content_sanskrit": "ततः शेषं समादाय कलत्रस्य महामतिः।\nहृतभूयिष्ठरत्नस्य कुरुक्षेत्रमवातरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2105282, "chapter_id": 3270, "verse_number": "१५-८-६९", "content_sanskrit": "युधिष्ठिरस्यानुमते वंशकर्तॄन्कुमारकान्।\nन्यवेशयत कौरव्यस्तत्रतत्र धनंजयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2105283, "chapter_id": 3270, "verse_number": "१५-८-७०", "content_sanskrit": "हार्दिक्यतनयं पार्थो नगरे मृत्तिकावते।\nअश्वपतिं खाण्डवारण्ये राज्ये तत्र न्येवशयत्।\nभोजराजकलत्रं च हृतशेषं नरोत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2105284, "chapter_id": 3270, "verse_number": "१५-८-७१", "content_sanskrit": "तथा वृद्धांश्च बालांश्च स्त्रियश्चादाय पाण्डवः।\nवीरैर्विहीनान्सर्वांस्ताञ्शक्रप्रस्थे न्यवेशयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2105285, "chapter_id": 3270, "verse_number": "१५-८-७२", "content_sanskrit": "यौयुधानिं सरस्वत्याः पुत्रं सात्यकिनः प्रियम्।\nन्यवेशयत धर्मात्मा वृद्धबालपुरस्कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2105286, "chapter_id": 3270, "verse_number": "१५-८-७३", "content_sanskrit": "इन्द्रप्रस्थे ददौ राज्यं व्रज्राय परवीरहा।\nवज्रेणाक्रूरदारास्तु वार्यमाणाः प्रवव्रजुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2105287, "chapter_id": 3270, "verse_number": "१५-८-७४", "content_sanskrit": "रुक्मिणी त्वथ गान्धारी शैब्दा हैमवतीत्यपि।\nदेवी जींबवती चैव विविशुर्जातवेदसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2105288, "chapter_id": 3270, "verse_number": "१५-८-७५", "content_sanskrit": "सत्यभामा तथैवान्या देव्यः कृष्णस्य सम्मताः।\nवनं प्रविविशू राजंस्तापस्ये कृतनिश्चयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2105289, "chapter_id": 3270, "verse_number": "१५-८-७६", "content_sanskrit": "द्वारकावासिनो ये पुरुषाः पार्थमभ्ययुः।\nयथार्हं संविभज्यैनान्वज्रे पर्यददज्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2105290, "chapter_id": 3270, "verse_number": "१५-८-७७", "content_sanskrit": "स तत्कृत्वा प्राप्तकालं बाष्णेणापिहितोऽर्जुनः।\nकृष्णद्वैपायनं व्यासं ददर्शासीनमाश्रमे॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2105291, "chapter_id": 3270, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते मौसलपर्वणि अष्टमोऽध्यायः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}]