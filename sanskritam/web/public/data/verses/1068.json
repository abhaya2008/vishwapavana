[{"id": 2003448, "chapter_id": 1068, "verse_number": "१-६९-०x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2003449, "chapter_id": 1068, "verse_number": "१-६९-१", "content_sanskrit": "त्वत्तः श्रुतमिदं ब्रह्मन्देवदानवरक्षसाम्।\nअंशावतरणं सम्यग्गन्धर्वाप्सरसां तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2003450, "chapter_id": 1068, "verse_number": "१-६९-२", "content_sanskrit": "इमं तु भूय इच्छामि कुरूणां वंशमादितः।\nकथ्यमानं त्वया विप्र विप्रर्षिगणसन्निधौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2003451, "chapter_id": 1068, "verse_number": "१-६९-३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2003452, "chapter_id": 1068, "verse_number": "१-६९-३", "content_sanskrit": "धर्मार्थकामसहितं राजर्षीणां प्रकीर्तितम्।\nपवित्रं कीर्त्यमानं मे निबोधेदं मनीषिणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2003453, "chapter_id": 1068, "verse_number": "१-६९-४", "content_sanskrit": "प्रजापतेस्तु दक्षस्य मनोर्वैवस्वतस्य च।\nभरतस्य कुरोः पूरोराजमीढस्य चानघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2003454, "chapter_id": 1068, "verse_number": "१-६९-५", "content_sanskrit": "यादवानामिमं वंशं कौरवाणां च सर्वशः।\nतथैव भरतानां च पुण्यं स्वस्त्ययनं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2003455, "chapter_id": 1068, "verse_number": "१-६९-६", "content_sanskrit": "धन्यं यशस्यमायुष्यं कीर्तयिष्यामि तेऽनघ।\nतेजोभिरुदिताः सर्वे महर्षिसमतेजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2003456, "chapter_id": 1068, "verse_number": "१-६९-७", "content_sanskrit": "दश प्राचेतसः पुत्राः सन्तः पुण्यजनाः स्मृताः।\nमुखजेनाग्निना यैस्ते पूर्वं दग्धा महौजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2003457, "chapter_id": 1068, "verse_number": "१-६९-८", "content_sanskrit": "तेभ्यः प्राचेतसो जज्ञे दक्षो दक्षादिमाः प्रजाः।\nसंभूताः पुरुषव्याघ्र स हि लोकपितामहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2003458, "chapter_id": 1068, "verse_number": "१-६९-९", "content_sanskrit": "वीरिण्या सह सङ्गम्य दक्षः प्राचेतसो मुनिः।\nआत्मतुल्यानजनयत्सहस्रं संशितव्रतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2003459, "chapter_id": 1068, "verse_number": "१-६९-१०", "content_sanskrit": "सहस्रसङ्ख्यानसंभूतान्दक्षपुत्रांश्च नारदः।\nमोक्षमध्यापयामास साङ्ख्यज्ञानमनुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2003460, "chapter_id": 1068, "verse_number": "१-६९-११", "content_sanskrit": "नाशार्थं योजयामास दिगन्तज्ञानकर्मसु।\nततः पञ्चाशतं कन्या पुत्रिका अभिसन्दधे।\nप्रजापतिः प्रजा दक्षः सिसृक्षुर्जनमेजय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2003461, "chapter_id": 1068, "verse_number": "१-६९-१२", "content_sanskrit": "ददौ दश स धर्माय कश्यपाय त्रयोदश।\nकालस्य नयने युक्ताः सप्तविंशतिमिन्दवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2003462, "chapter_id": 1068, "verse_number": "१-६९-१३", "content_sanskrit": "त्रयोदशानां पत्नीनां या तु दाक्षायणी वरा।\nमारीचः कश्यपस्त्वस्यामादित्यान्समजीजनत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2003463, "chapter_id": 1068, "verse_number": "१-६९-१४", "content_sanskrit": "इन्द्रादीन्वीर्यसंपन्नान्विवस्वन्तमथापि च।\nविवस्वतः सुतो जज्ञे यमो वैवस्वतः प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2003464, "chapter_id": 1068, "verse_number": "१-६९-१५", "content_sanskrit": "मार्ताण्डस्य यमी चापि सुता राजन्नजायत।\nमार्तण्डस्य मनुर्धीमानजायत सुतः प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2003465, "chapter_id": 1068, "verse_number": "१-६९-१६", "content_sanskrit": "धर्मात्मा स मनुर्धीमान्यत्र वंशः प्रतिष्ठितः।\nमनोर्वंशो मानवानां ततोऽयं प्रथितोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2003466, "chapter_id": 1068, "verse_number": "१-६९-१७", "content_sanskrit": "ब्रह्मक्षत्रादयस्तस्मान्मनोर्जातास्तु मानवाः।\nततोऽभवन्महाराज ब्रह्म क्षत्रेण सङ्गतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2003467, "chapter_id": 1068, "verse_number": "१-६९-१८", "content_sanskrit": "ब्राह्मणा मानवास्तेषां साङ्गं वेदमदारयन्।\nवेनं धृष्णुं नरिष्यन्तं नाभागेक्ष्वाकुमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2003468, "chapter_id": 1068, "verse_number": "१-६९-१९", "content_sanskrit": "कारूषमथ शर्यातिं तथा चैवाष्टमीमिलाम्।\nपृष्टध्रं नवमं प्राहुः क्षत्रधर्मपरायणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2003469, "chapter_id": 1068, "verse_number": "१-६९-२०", "content_sanskrit": "नाभागारिष्टदशमान्मनोः पुत्रान्प्रचक्षते।\nपञ्चाशत्तु मनोः पुत्रास्तथैवान्येऽभवन्क्षितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2003470, "chapter_id": 1068, "verse_number": "१-६९-२१", "content_sanskrit": "अन्योन्यभेदात्ते सर्वे विनेशुरिति नः श्रुतम्।\nपुरूरवास्ततो विद्वानिलायां समपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2003471, "chapter_id": 1068, "verse_number": "१-६९-२२", "content_sanskrit": "सा वै तस्याभवन्माता पिता चैवेति नः श्रुतम्।\nत्रयोदश समुद्रस्य द्वीपानश्नन्पुरूरवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2003472, "chapter_id": 1068, "verse_number": "१-६९-२३", "content_sanskrit": "अमानुषैर्वृतः सत्वैर्मानुषः सन्महायशाः।\nविप्रैः स विग्रहं चक्रे वीर्योन्मत्तः पुरूरवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2003473, "chapter_id": 1068, "verse_number": "१-६९-२४", "content_sanskrit": "जहार च स विप्राणां रत्नान्युत्क्रोशतामपि।\nसनत्कुमारस्तं राजन्ब्रह्मलोकादुपेत्य ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2003474, "chapter_id": 1068, "verse_number": "१-६९-२५", "content_sanskrit": "अनुदर्शं ततश्चक्रे प्रत्यगृह्णान्न चाप्यसौ।\nततो महर्षिभिः क्रुद्धैः सद्यः शप्तो व्यनश्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2003475, "chapter_id": 1068, "verse_number": "१-६९-२६", "content_sanskrit": "लोभान्वितो बलमदान्नष्टसंज्ञो नराधिपः।\nस हि गन्धर्वलोकस्थानुर्वश्या सहितो विराट्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2003476, "chapter_id": 1068, "verse_number": "१-६९-२७", "content_sanskrit": "आनिनाय क्रियार्थेऽग्नीन्यथावद्विहितांस्त्रिधा।\nषट् सुता जज्ञिरे चैलादायुर्धीमानमावसुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2003477, "chapter_id": 1068, "verse_number": "१-६९-२८", "content_sanskrit": "दृढायुश्च वनायुश्च शतायुश्चोर्वशीसुताः।\nनहुषं वृद्धशर्माणं रजिं गयमनेनसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2003478, "chapter_id": 1068, "verse_number": "१-६९-२९", "content_sanskrit": "स्वर्भानवी सुतानेतानायोः पुत्रान्प्रचक्षते।\nआयुषो नहुषः पुत्रो धीमान्सत्यपराक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2003479, "chapter_id": 1068, "verse_number": "१-६९-३०", "content_sanskrit": "राज्यं शशास सुमहद्धर्मेण पृथिवीपते।\nपितॄन्देवानृषीन्विप्रान्गन्धर्वोरगराक्षसान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2003480, "chapter_id": 1068, "verse_number": "१-६९-३१", "content_sanskrit": "नहुषः पालयामास ब्रह्मक्षत्रमथो विशः।\nस हत्वा दस्युसंघातानृषीन्करमदापयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2003481, "chapter_id": 1068, "verse_number": "१-६९-३२", "content_sanskrit": "पशुवच्चैव तान्पृष्ठे वाहयामास वीर्यवान्।\nकारयामास चेन्द्रत्वमभिभूय दिवौकसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2003482, "chapter_id": 1068, "verse_number": "१-६९-३३", "content_sanskrit": "तेजसा तपसा चैव विक्रमेणौजसा तथा।\nविश्लिष्टो नहुषः शप्तः सद्यो ह्यजगरोऽभवत्।\nयतिं ययातिं संयातिमायातिमयतिं ध्रुवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2003483, "chapter_id": 1068, "verse_number": "१-६९-३४", "content_sanskrit": "नहुषो जनयामास षट् सुतान्प्रियवादिनः।\nयतिस्तु योगमास्थाय ब्रह्मीभूतोऽभवन्मुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2003484, "chapter_id": 1068, "verse_number": "१-६९-३५", "content_sanskrit": "ययातिर्नाहुषः सम्राडासीत्सत्यपराक्रमः।\nस पालयामास महीमीजे च बहुभिर्मखैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2003485, "chapter_id": 1068, "verse_number": "१-६९-३६", "content_sanskrit": "अतिभक्त्या पितॄनर्चन्देवांश्च प्रयतः सदा।\nअन्वगृह्णात्प्रजाः सर्वा ययातिरपराजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2003486, "chapter_id": 1068, "verse_number": "१-६९-३७", "content_sanskrit": "तस्य पुत्रा महेष्वासाः सर्वैः समुदिता गुणैः।\nदेवयान्यां महाराज शर्मिष्ठायां च जज्ञिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2003487, "chapter_id": 1068, "verse_number": "१-६९-३८", "content_sanskrit": "देवयान्यामजायेतां यदुस्तुर्वसुरेव च।\nद्रुह्युश्चानुश्च पूरुश्च शर्मिष्ठायां च जज्ञिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2003488, "chapter_id": 1068, "verse_number": "१-६९-३९", "content_sanskrit": "स शाश्वतीः समा राजन्प्रजा धर्मेण पालयन्।\nजरामार्च्छन्महाघोरां नाहुषो रूपनाशिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2003489, "chapter_id": 1068, "verse_number": "१-६९-४०", "content_sanskrit": "जराऽभिभूतः पुत्रान्स राजा वचनमब्रवीत्।\nयदुं पूरुं तुर्वसुं च द्रुह्युं चानुं च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2003490, "chapter_id": 1068, "verse_number": "१-६९-४१", "content_sanskrit": "यौवनेन चरन्कामान्युवा युवतिभिः सह।\nबिहर्तुमहमिच्छामि साह्यं कुरुत पुत्रकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2003491, "chapter_id": 1068, "verse_number": "१-६९-४२", "content_sanskrit": "तं पुत्रो दैवयानेयः पूर्वजो वाक्यमब्रवीत्।\nकिं कार्यं भवतः कार्यमस्माकं यौवनेन ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2003492, "chapter_id": 1068, "verse_number": "१-६९-४३", "content_sanskrit": "ययातिरब्रवीत्तं वै जरा मे प्रतिगृह्यताम्।\nयौवनेन त्वदीयेन चरेयं विषयानहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2003493, "chapter_id": 1068, "verse_number": "१-६९-४४", "content_sanskrit": "यजतो दीर्घसत्रैर्मे शापाच्चोशनसो मुनेः।\nकामार्थः परिहीणोऽयं तप्येयं तेन पुत्रकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2003494, "chapter_id": 1068, "verse_number": "१-६९-४५", "content_sanskrit": "मामकेन शरीरेण राज्यमेकः प्रशास्तु वः।\nअहं तन्वाऽभिनवया युवा काममवाप्नुयाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2003495, "chapter_id": 1068, "verse_number": "१-६९-४६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2003496, "chapter_id": 1068, "verse_number": "१-६९-४६", "content_sanskrit": "ते न तस्य प्रत्यगृह्णन्यदुप्रभृतयो जराम्।\nतमब्रवीत्ततः पूरुः कनीयान्सत्यविक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2003497, "chapter_id": 1068, "verse_number": "१-६९-४७", "content_sanskrit": "राजंश्चराभिनवया तन्वा यौवनगोचरः।\nअहं जरां समादाय राज्ये स्थास्यामि तेज्ञया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2003498, "chapter_id": 1068, "verse_number": "१-६९-४८", "content_sanskrit": "एवमुक्तः स राजर्षिस्तपोवीर्यसमाश्रयात्।\nसंचारयामास जरां तदा पुत्रे महात्मनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2003499, "chapter_id": 1068, "verse_number": "१-६९-४९", "content_sanskrit": "पौरवेणाथ वयसा राजा यौवनमास्थितः।\nयायातेनापि वयसा राज्यं पूरुरकारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2003500, "chapter_id": 1068, "verse_number": "१-६९-५०", "content_sanskrit": "ततो वर्षसहस्राणि ययातिरपराजितः।\nस्थितः स नृपशार्दूलः शार्दूलसमविक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2003501, "chapter_id": 1068, "verse_number": "१-६९-५१", "content_sanskrit": "ययातिरपि पत्नीभ्यां दीर्घकालं विहृत्य च।\nविश्वाच्या सहितो रेमे पुनश्चैत्ररथे वने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2003502, "chapter_id": 1068, "verse_number": "१-६९-५२", "content_sanskrit": "नाध्यगच्छत्तदा तृप्तिं कामानां स महायशाः।\nअवेत्य मनसा राजन्निमां गाथां तदा जगौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2003503, "chapter_id": 1068, "verse_number": "१-६९-५३", "content_sanskrit": "न जातु कामः कामानामुपभोगेन शाम्यति।\nइविषा कृष्णवर्त्मेव भूय एवाभिवर्धते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2003504, "chapter_id": 1068, "verse_number": "१-६९-५४", "content_sanskrit": "यत्पृथिव्यां व्रीहियवं हिरण्यं पशवः स्त्रियः।\nनालमेकस्य तत्सर्वमिति मत्वा शमं व्रजेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2003505, "chapter_id": 1068, "verse_number": "१-६९-५५", "content_sanskrit": "यदा न कुरुते पापं सर्वभूतेषु कर्हिचित्।\nकर्मणा मनसा वाचा ब्रह्म संपद्यते तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2003506, "chapter_id": 1068, "verse_number": "१-६९-५६", "content_sanskrit": "न बिभेति यदा चायं यदा चास्मान्न बिभ्यति।\nयदा नेच्छति न द्वेष्टि ब्रह्म संपद्यते तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2003507, "chapter_id": 1068, "verse_number": "१-६९-५७", "content_sanskrit": "इत्यवेक्ष्य महाप्राज्ञः कामानां फल्गुतां नृप।\nसमाधाय मनो बुद्ध्या प्रत्यगृह्णाज्जरां सुतात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2003508, "chapter_id": 1068, "verse_number": "१-६९-५८", "content_sanskrit": "ततो वर्षसहस्रान्ते ययातिरपराजितः।\nदत्वा च यौवनं राजा पूरुं राज्येऽभिषिच्य च।\nअतृप्त एव कामानां पूरुं पुत्रमुवाच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2003509, "chapter_id": 1068, "verse_number": "१-६९-५९", "content_sanskrit": "त्वया दायादवानस्मि त्वं मे वंशकरः सुतः।\nपौरवो वंश इति ते ख्यातिं लोके गमिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2003510, "chapter_id": 1068, "verse_number": "१-६९-६०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2003511, "chapter_id": 1068, "verse_number": "१-६९-६०", "content_sanskrit": "ततः स नृपशार्दूल पूरुं राज्येऽभिषिच्य च।\nततः सुचरितं कृत्वा भृगुतुङ्गे महातपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2003512, "chapter_id": 1068, "verse_number": "१-६९-६१", "content_sanskrit": "कालेन महता पश्चात्कालधर्ममुपेयिवान्।\nकारयित्वा त्वनशनं सदारः स्वर्गमाप्तवान्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2003513, "chapter_id": 1068, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि एकोनसप्ततितमोऽध्यायः॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}]