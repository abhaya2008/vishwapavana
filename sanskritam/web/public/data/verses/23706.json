[{"id": 7003706000, "chapter_id": 23706, "verse_number": "१-४-१४-१", "content_sanskrit": "नंदिकेश्वर उवाच ।\nसोऽपि ब्रह्माणमुद्वीक्ष्य तावता द्विगुणं स्मयन् ।\nनाग्रं दृष्टमनेनेति निश्चिकाय विवेकवान् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003706001, "chapter_id": 23706, "verse_number": "१-४-१४-२", "content_sanskrit": "अनुग्रहीतुं मां मुग्धं हंतुं चास्य विधेर्मदम् ।\nदेवदेवः स एवालं भूतभर्तेत्यमन्यत ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003706002, "chapter_id": 23706, "verse_number": "१-४-१४-३", "content_sanskrit": "मूलसंदर्शनाशक्त्या तेजःस्तंम्भस्य मे मदः ।\nव्यपेत एव मन्येऽद्य यद्भक्तिस्त्र्यंबकेऽजनि ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003706003, "chapter_id": 23706, "verse_number": "१-४-१४-४", "content_sanskrit": "स्तूयते वीतगर्वत्वात्स इदानीं महेश्वरः ।\nयस्य दक्षिणवामाभ्यामंगाभ्यां नौ समुद्भवौ ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003706004, "chapter_id": 23706, "verse_number": "१-४-१४-५", "content_sanskrit": "अद्याप्यवीतगर्वत्वाल्लब्ध्वासौ कूटसाक्षिणम् ।\nहिरण्यगर्भो मामेवमतिसंधातुमिच्छति ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003706005, "chapter_id": 23706, "verse_number": "१-४-१४-६", "content_sanskrit": "तदद्य सकलस्यापि दुःखस्यापनये क्षमः ।\nस एव शरणत्वेन प्राप्तव्यः शंकरो मया ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003706006, "chapter_id": 23706, "verse_number": "१-४-१४-७", "content_sanskrit": "तथा कृतापराधस्य कृतघ्नस्य गुरुद्रुहः ।\nतमृते रक्षिता कोऽन्यस्तमेव स्तौमि शंकरम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003706007, "chapter_id": 23706, "verse_number": "१-४-१४-८", "content_sanskrit": "विष्णुरुवाच ।\nजय पृध्वीमयाकार जय चापोमयाकृते ।\nजय प्रभाकराकार जयामृतकराकृते ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003706008, "chapter_id": 23706, "verse_number": "१-४-१४-९", "content_sanskrit": "जय वैश्वानराकार जय गन्धवहाकृते ।\nजय होतृमयाकार जयाकाशमयाकृते ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003706009, "chapter_id": 23706, "verse_number": "१-४-१४-१०", "content_sanskrit": "रक्ष मां त्रिगुणातीत रक्ष मां कालविग्रह ।\nरक्ष मामक्षयैश्वर्य रक्ष मां करुणाकर ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003706010, "chapter_id": 23706, "verse_number": "१-४-१४-११", "content_sanskrit": "स्रष्टा त्वं सर्वजगतां रक्षिता सर्वदेहिनाम् ।\nहर्ता च सर्वभूतानां त्वां विनैवास्ति कोऽपरः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003706011, "chapter_id": 23706, "verse_number": "१-४-१४-१२", "content_sanskrit": "अणूनामप्यणीयांस्त्वं महांस्त्वं महतामपि ।\nअन्तर्बहिस्त्वमेवैतज्जगदाक्रम्य वर्तसे ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003706012, "chapter_id": 23706, "verse_number": "१-४-१४-१३", "content_sanskrit": "निगमास्तव निश्वासा विश्वं ते शिल्पवैभवम् ।\nस त्वं त्वदीय एवासि ज्ञानमात्मा तव प्रभो ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003706013, "chapter_id": 23706, "verse_number": "१-४-१४-१४", "content_sanskrit": "अमरा दानवा दैत्याः सिद्धा विद्याधरा नराः ।\nप्राणिनः पक्षिणः शैलाः शिखिनोऽपि त्वमेव हि ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003706014, "chapter_id": 23706, "verse_number": "१-४-१४-१५", "content_sanskrit": "स्वर्गस्त्वमपवर्गस्त्वं त्वमोंकारस्त्वमध्वरः ।\nत्वं योगस्त्वं परा संवित्किं त्वं न भवसीश्वर ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003706015, "chapter_id": 23706, "verse_number": "१-४-१४-१६", "content_sanskrit": "त्वमादिर्मध्यमंतश्च तस्थुषां जग्मुषामपि ।\nकालस्वरूपतां प्राप्य कलयस्यखिलं जगत् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003706016, "chapter_id": 23706, "verse_number": "१-४-१४-१७", "content_sanskrit": "परेशः परतः शास्ता सर्वानुग्राहकः शिवः ।\nस एष मे कथंकारं साक्षाद्भवति धूर्जटिः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003706017, "chapter_id": 23706, "verse_number": "१-४-१४-१८", "content_sanskrit": "यं दृष्ट्वा शरणं प्राप्तो निःश्रेयसमवाप्नुयात् ।\nअथ वा स्तौमि तद्धाम जातमात्रं यथामिति ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003706018, "chapter_id": 23706, "verse_number": "१-४-१४-१९", "content_sanskrit": "तच्छ्रुत्वैष कृपां कुर्यादवश्यं सर्वतः श्रुतिः ।\nइति निश्चित्य वैकुंठः स्तोतुं समुपचक्रमे ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003706019, "chapter_id": 23706, "verse_number": "१-४-१४-२०", "content_sanskrit": "तमेव तैजसं स्तंभं प्रणम्य परमेश्वरम् ।\nआदिमध्यांतरहितं मत्वा तं जगदीश्वरम् ।\nहठात्तेन विरंचेन वार्यमाणोपि सस्मितम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003706020, "chapter_id": 23706, "verse_number": "१-४-१४-२१", "content_sanskrit": "श्रीविष्णुरुवाच ।\nजय देव महादेव वामदेव वृषध्वज ।\nकालांतक क्रतुध्वंसिन्नीलकंठेंदुशेखर ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003706021, "chapter_id": 23706, "verse_number": "१-४-१४-२२", "content_sanskrit": "जय शंभो शिवेशान शर्व त्र्यंबक धूर्जटे ।\nस्मरवैरिन्पुराराते स्थाणो भव महेश्वर ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003706022, "chapter_id": 23706, "verse_number": "१-४-१४-२३", "content_sanskrit": "जयेश खंडपरशो शूलिन्पशुपते हर ।\nसर्वज्ञ भर्ग भूतेश कपालिन्नीललोहित ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003706023, "chapter_id": 23706, "verse_number": "१-४-१४-२४", "content_sanskrit": "जय रुद्र मखाराते पिनाकिन्प्रमथाधिप ।\nगंगाधर व्योमकेश गिरीश परमेश्वर ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003706024, "chapter_id": 23706, "verse_number": "१-४-१४-२५", "content_sanskrit": "जय भीम मृगव्याध कृत्तिवासः कृपानिधे ।\nकृशानुरेतः कैलासे नित्यमेव हि वर्तसे ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003706025, "chapter_id": 23706, "verse_number": "१-४-१४-२६", "content_sanskrit": "त्वदाज्ञया मरुद्राति फणी वहति भूभरम् ।\nदीप्यतः सूर्यशशिनौ ब्रह्मांडं प्लवतेंऽबुधौ ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003706026, "chapter_id": 23706, "verse_number": "१-४-१४-२७", "content_sanskrit": "ज्योतींषि संचरंते खे सर्वं त्वच्छासनात्प्रभो ।\nअहं ब्रह्मा च जगतां सर्गसंत्राणयोरलम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003706027, "chapter_id": 23706, "verse_number": "१-४-१४-२८", "content_sanskrit": "विधाय कल्पसे पुष्ट्यै सूते सस्यानि मेदिनी ।\nनाक्रामंत्यव्ययः सीमां यच्च त्वन्महिरेव सः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003706028, "chapter_id": 23706, "verse_number": "१-४-१४-२९", "content_sanskrit": "अणिमादिमहासिद्धिनिःसाधारणवैभवः ।\nकथं त्वाममरैरन्यैरुपेक्षे समभिष्टुतम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003706029, "chapter_id": 23706, "verse_number": "१-४-१४-३०", "content_sanskrit": "विशुक्त्वे विस्मरामस्त्वां स्मरामः संकटेपि च ।\nन रोषो जातु भक्तेषु प्रसादः सर्वदैव ते ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003706030, "chapter_id": 23706, "verse_number": "१-४-१४-३१", "content_sanskrit": "यदा विधित्सेर्भक्तिं त्वं यदा च प्रावृणोषि ताम् ।\nमोहबोधौ तदा पुंसां कल्पेते बंधमोक्षयोः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003706031, "chapter_id": 23706, "verse_number": "१-४-१४-३२", "content_sanskrit": "इति स्तुतस्सांजलिबद्धपाणिना पतिः पशूनामथ चक्रपाणिना ।\nकृतापहासे च सरोजसंभवे मदोद्धते प्रादुरभूद्दयानिधिः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]