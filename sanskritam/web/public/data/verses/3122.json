[{"id": 2099133, "chapter_id": 3122, "verse_number": "१३-२५२-१", "content_sanskrit": "नारद उवाच।\nअथ व्योम्नि महाञ्शब्दः सविद्युत्स्तनयित्नुमान्।\nमेघैश्च गगनं नीलं संरुद्धमभवद्धनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2099134, "chapter_id": 3122, "verse_number": "१३-२५२-२", "content_sanskrit": "प्रावृषीव च पर्जन्यो ववृषे निर्मलं पयः।\nतमश्वैवाभवद्धोरं दिशश्च न चकाशिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2099135, "chapter_id": 3122, "verse_number": "१३-२५२-३", "content_sanskrit": "ततो देवगिरौ तस्मिन्रम्ये पुण्ये सनातने।\nन शर्वं भूतसङ्घं वा ददृशुर्मनयस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2099136, "chapter_id": 3122, "verse_number": "१३-२५२-४", "content_sanskrit": "व्यभ्रं च गगनं सद्यः क्षणेन समपद्यत।\nतीर्थयात्रां ततो विप्रा जग्मुश्चान्ये यथागतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2099137, "chapter_id": 3122, "verse_number": "१३-२५२-५", "content_sanskrit": "तदद्भुतमचिन्त्यं च दृष्ट्वा ते विस्मिताऽभवन्।\nशङ्करस्योमया सार्धं संवादं त्वत्कथाश्रयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2099138, "chapter_id": 3122, "verse_number": "१३-२५२-६", "content_sanskrit": "स भवान्पुरुषव्याघ्र ब्रह्मभूतः सनातनः।\nयदर्थमनुशिष्टा स्मो गिरिपृष्ठे महात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2099139, "chapter_id": 3122, "verse_number": "१३-२५२-७", "content_sanskrit": "द्वितीयं त्वद्भुतमिदं त्वत्तेजःकृतमद्य वै।\nदृष्ट्वा च विस्मिताः कृष्ण सा च नः स्मृतिरागता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2099140, "chapter_id": 3122, "verse_number": "१३-२५२-८", "content_sanskrit": "एतत्ते देवदेवस्य माहात्म्यं कथितं प्रभो।\nकपर्दिनो गिरीशस्य महाबाहो जनार्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2099141, "chapter_id": 3122, "verse_number": "१३-२५२-९", "content_sanskrit": "इत्युक्ताः स तदा कृष्णस्तपोवननिवासिभिः।\nमानयामास तान्सर्वानृषीन्देवकिनन्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2099142, "chapter_id": 3122, "verse_number": "१३-२५२-१०", "content_sanskrit": "अथर्षयः सम्प्रहृष्टाः पुनस्ते कृष्ममब्रुवन्।\nपुनःपुनर्दर्शयास्मान्सदैव मधुसूदन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2099143, "chapter_id": 3122, "verse_number": "१३-२५२-११", "content_sanskrit": "न हि नः सा रति स्वर्गे या च त्वद्दर्शने विभो।\nतदृतं च महाबाहो यदाह भगवान्भवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2099144, "chapter_id": 3122, "verse_number": "१३-२५२-१२", "content_sanskrit": "एतत्ते सर्वमाख्यातं रहस्यमरिकर्शन।\nत्वमेव ह्यर्ततत्त्वज्ञः पृष्टोऽस्मान्पृच्छसे यदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2099145, "chapter_id": 3122, "verse_number": "१३-२५२-१३", "content_sanskrit": "तदस्माभिरिदं गुह्यं त्वत्प्रियार्थमुदाहृतम्।\nन च तेऽविदितं किञ्चित्त्रिषु लोकेषु विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2099146, "chapter_id": 3122, "verse_number": "१३-२५२-१४", "content_sanskrit": "जन्म चैव प्रसूतिश्च यच्चान्यत्कारणं विभो।\nवयं तु बहुचापल्यादशक्ता गुह्यधारणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2099147, "chapter_id": 3122, "verse_number": "१३-२५२-१५", "content_sanskrit": "ततः स्थिते त्वयि विभो लघुत्वात्प्रलपामहे।\nन हि किञ्चित्तदाश्चर्यं यन्न वेत्ति भवानिह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2099148, "chapter_id": 3122, "verse_number": "१३-२५२-१६", "content_sanskrit": "दिवि वा भुवि वा देव सर्वं हि विदितं तव।\nसाधयाम वयं कृष्ण बुद्धिं पुष्टिमवाप्नुहि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2099149, "chapter_id": 3122, "verse_number": "१३-२५२-१७", "content_sanskrit": "पुत्रस्ते सदृशस्तात विशिष्टो वा भविष्यति।\nमहाप्रभावसंयुक्तो दीप्तिकीर्तिकरः प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2099150, "chapter_id": 3122, "verse_number": "१३-२५२-१८x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2099151, "chapter_id": 3122, "verse_number": "१३-२५२-१८", "content_sanskrit": "ततः प्रणम्य देवेशं यादवं पुरुषोत्तमम्।\nप्रदक्षिणमुपावृत्य प्रजग्मुस्ते महर्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2099152, "chapter_id": 3122, "verse_number": "१३-२५२-१९", "content_sanskrit": "सोयं नारायणः श्रीमन्दीप्त्या परमया युतः।\nव्रतं यथावत्तच्चीर्त्वा द्वारकां पुनरागमत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2099153, "chapter_id": 3122, "verse_number": "१३-२५२-२०", "content_sanskrit": "पूर्णे च दशमे मासि पुत्रोऽस्य परमाद्भुतः।\nरुक्मिण्यां सम्मतो जज्ञे शूरो वंशधरः प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2099154, "chapter_id": 3122, "verse_number": "१३-२५२-२१", "content_sanskrit": "स कामः सर्वभूतानां सर्वभावगतो नृप।\nअसुराणां सुराणां च चरत्यन्तर्गतः सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2099155, "chapter_id": 3122, "verse_number": "१३-२५२-२२", "content_sanskrit": "सोयं पुरुषशार्दूलो मेघवर्णश्चतुर्भुजः।\nसंश्रितः पाण्डवान्प्रेम्णा भवन्तश्चैनमाश्रिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2099156, "chapter_id": 3122, "verse_number": "१३-२५२-२३", "content_sanskrit": "कीर्तिर्लक्ष्मीर्धृतिश्चैवक स्वर्गमार्गस्तथैव च।\nयत्रैष संस्थितस्तत्र देवो विष्णुस्त्रिविक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2099157, "chapter_id": 3122, "verse_number": "१३-२५२-२४", "content_sanskrit": "सेन्द्रा देवास्त्रयस्त्रिंशदेष नात्र विचारणा।\nआदिदेवो महादेवः सर्वभूतप्रतिश्रयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2099158, "chapter_id": 3122, "verse_number": "१३-२५२-२५", "content_sanskrit": "अनादिनिधनोऽव्यक्तो महात्मा मधुसूदनः।\nअयं जातो महातेजाः सुराणामर्थसिद्धये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2099159, "chapter_id": 3122, "verse_number": "१३-२५२-२६", "content_sanskrit": "सुदुस्तरार्थतत्त्वस्य वक्ता कर्ता च माधवः।\nतव पार्थ जयः कृत्स्नस्तव कीर्तिस्तथाऽतुला॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2099160, "chapter_id": 3122, "verse_number": "१३-२५२-२७", "content_sanskrit": "तवेयं पृथिवी देवी कृत्स्ना नारायणाश्रयात्।\nअयं नाथस्तवाचिन्त्यो यस्य नारायणो गतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2099161, "chapter_id": 3122, "verse_number": "१३-२५२-२८", "content_sanskrit": "स भवांस्त्वमुपाध्वर्यू रणाग्नौ हुतवान्नृपान्।\nकृष्णस्रुवेण महता युगान्ताग्निसमेन वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2099162, "chapter_id": 3122, "verse_number": "१३-२५२-२९", "content_sanskrit": "दुर्योधनश्च शोच्योसौ सपुत्रभ्रातृबान्धवः।\nकृतवान्योऽबुधः क्रोधाद्धरिगाण्डीविविग्रहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2099163, "chapter_id": 3122, "verse_number": "१३-२५२-३०", "content_sanskrit": "दैतेया दानवेन्द्राश्च महाकाया महाबलाः।\nचक्राग्नौ क्षयमापन्ना दावाग्नौ शलभा इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2099164, "chapter_id": 3122, "verse_number": "१३-२५२-३१", "content_sanskrit": "प्रतियोद्धुं न शक्यो हि मानुषैरेव संयुगे।\nविहीनैः पुरुषव्याघ्र सत्त्वशक्तिबलादिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2099165, "chapter_id": 3122, "verse_number": "१३-२५२-३२", "content_sanskrit": "जयो योगी युगान्ताभः सव्यसाची रणाग्रगः।\nतेजसा हतवान्सर्वं सुयोधनवलं नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2099166, "chapter_id": 3122, "verse_number": "१३-२५२-३३", "content_sanskrit": "यत्तु गोवृषभाङ्केन मुनिभ्यः समुदाहृतम्।\nपुराणं हिमवत्पृष्ठे तन्मे निगदतः शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2099167, "chapter_id": 3122, "verse_number": "१३-२५२-३४", "content_sanskrit": "यावत्तस्य भवेत्पुष्टिस्तेजो जीप्तिः पराक्रमः।\nप्रभावः सन्नतिर्जन्म कृष्णे तत्त्रिगुणं विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2099168, "chapter_id": 3122, "verse_number": "१३-२५२-३५", "content_sanskrit": "कः शक्नोत्यन्यथा कर्तुं तद्यदि स्यात्तथा शृणु।\nयत्रः कृष्णो हि भगवांस्तत्र पुष्टिरनुत्तमा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2099169, "chapter_id": 3122, "verse_number": "१३-२५२-३६", "content_sanskrit": "वयं त्विहाल्पमतयः परतन्त्राः सुविक्लबाः।\nज्ञानपूर्वं प्रपन्नाः स्मो मृत्योः पन्थानमव्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2099170, "chapter_id": 3122, "verse_number": "१३-२५२-३७", "content_sanskrit": "भवांश्चाप्यार्जवपरः पूर्वं कृत्वा प्रतिश्रयम्।\nराजवृत्तं न लभते प्रतिज्ञापालने रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2099171, "chapter_id": 3122, "verse_number": "१३-२५२-३८", "content_sanskrit": "अत्येवात्मवधं लोके राजंस्त्वं बहु मन्यसे।\nन हि प्रतिज्ञा या दत्ता तां प्रहातुमरिंदम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2099172, "chapter_id": 3122, "verse_number": "१३-२५२-३९", "content_sanskrit": "कालेनायं जनः सर्वो निहतो रणमूर्धनि।\nवयं च कालेन हताः कालो हि परमेश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2099173, "chapter_id": 3122, "verse_number": "१३-२५२-४०", "content_sanskrit": "न हि कालेन कालज्ञः स्पृष्टः शोचितुमर्हसि।\nकालो लोहितरक्ताक्षः कृष्णो दण्डी सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2099174, "chapter_id": 3122, "verse_number": "१३-२५२-४१", "content_sanskrit": "तस्मात्कुन्तीसुत ज्ञातीन्नेह शोचितुमर्हसि।\nव्यपेतमन्युर्नित्यं त्वं भव कौरवनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2099175, "chapter_id": 3122, "verse_number": "१३-२५२-४२", "content_sanskrit": "माधवस्यास्य महात्म्यं श्रुतं यत्कथितं मया।\nतदेव तावत्पर्याप्तं सज्जनस्य निदर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2099176, "chapter_id": 3122, "verse_number": "१३-२५२-४३", "content_sanskrit": "व्यासस्य वचनं श्रुत्वा नारदस्य च धीमतः।\nस्वयं चैव महाराज कृष्णस्यार्हतमस्य वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2099177, "chapter_id": 3122, "verse_number": "१३-२५२-४४", "content_sanskrit": "प्रभावश्चर्षिपूगस्य कथितः सुमहान्मया।\nमहेश्वरस्य संवादं शैलपुत्र्याश्च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2099178, "chapter_id": 3122, "verse_number": "१३-२५२-४५", "content_sanskrit": "धारयिष्यति यश्चैनं महापुरुषसम्भवम्।\nशृणुयात्कथयेद्वा यः स श्रेयो लभते परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2099179, "chapter_id": 3122, "verse_number": "१३-२५२-४६", "content_sanskrit": "भवितारश्च तस्याथ सर्वे कामा यथेप्सिताः।\nप्रेत्य स्वर्गं च लभते नरो नास्त्यत्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2099180, "chapter_id": 3122, "verse_number": "१३-२५२-४७", "content_sanskrit": "न्याय्यं श्रेयोभिकामेन प्रतिपत्तुं जनार्दनः।\nएष एवाक्षयो विप्रैः स्तुतो राजञ्जनार्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2099181, "chapter_id": 3122, "verse_number": "१३-२५२-४८", "content_sanskrit": "महेश्वरमुखोत्सृष्टा ये च धर्मगुणाः स्मृताः।\nते त्वया मनसा धार्याः कुरुराज दिवानिशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2099182, "chapter_id": 3122, "verse_number": "१३-२५२-४९", "content_sanskrit": "एवं ते वर्तमानस्य सम्यग्दण्डधरस्य च।\nप्रजापालनदक्षस्य स्वर्गलोको भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2099183, "chapter_id": 3122, "verse_number": "१३-२५२-५०", "content_sanskrit": "धर्मोणापि सदा राजन्प्रजा रक्षितुमर्हसि।\nयस्तस्य विपुलो दण्डः सम्यग्धर्मः स कीर्त्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2099184, "chapter_id": 3122, "verse_number": "१३-२५२-५१", "content_sanskrit": "य एष कथितो राजन्मया सज्जनसन्निधौ।\nशङ्करस्योमया सार्धं संवादो धर्मसंहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2099185, "chapter_id": 3122, "verse_number": "१३-२५२-५२", "content_sanskrit": "श्रुत्वा वा श्रोतुकामो वाऽप्यर्चयेद्वृषभध्वजम्।\nविशुद्धेनेह भावेन य इच्छेद्भूतिमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2099186, "chapter_id": 3122, "verse_number": "१३-२५२-५३", "content_sanskrit": "एष तस्यानवद्यस्य नारदस्य महात्मनः।\nसंदेशो देवपूजार्थं तं तथा कुरु पाण्डव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2099187, "chapter_id": 3122, "verse_number": "१३-२५२-५४", "content_sanskrit": "एतदत्यद्भुतं वृत्तं पुण्ये हि भवति प्रभो।\nवासुदेवस्य कौन्तेय स्थाणोश्चैव स्वभावजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2099188, "chapter_id": 3122, "verse_number": "१३-२५२-५५", "content_sanskrit": "दशवर्शसहस्राणि बदर्यामेष शाश्वतः।\nतपश्चचार विपुलं सह गाण्डीवधन्वना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2099189, "chapter_id": 3122, "verse_number": "१३-२५२-५६", "content_sanskrit": "त्रियुगौ पुण्डरीकाक्षौ वासुदेवधनंजयौ।\nविदितौ नारदादेतौ मम व्यासाच्च पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2099190, "chapter_id": 3122, "verse_number": "१३-२५२-५७", "content_sanskrit": "बाल एव महाबाहुश्चकार कदनं महत्।\nकंसस्य पुण्डरीकाक्षो ज्ञातित्रामार्थकारणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2099191, "chapter_id": 3122, "verse_number": "१३-२५२-५८", "content_sanskrit": "कर्मणामस्य कौन्तेय नान्तं सङ्ख्यातुमुत्सहे।\nशाश्वतस्य पुराणस्य पुरुषस्य युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2099192, "chapter_id": 3122, "verse_number": "१३-२५२-५९", "content_sanskrit": "ध्रुवं श्रेयः परं तात भविष्यति तवोत्तमम्।\nयस्य ते पुरुषव्याघ्रः सखा चायं जनार्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2099193, "chapter_id": 3122, "verse_number": "१३-२५२-६०", "content_sanskrit": "दुर्योधनं तु शोचामि प्रेत्य लोकेऽपि दुर्मतिम्।\nयत्कृते पृथिवी सर्वा विनष्टा सहयद्विपा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2099194, "chapter_id": 3122, "verse_number": "१३-२५२-६१", "content_sanskrit": "दुर्योधनापराधेन कर्णस्य शकुनेस्तथा।\nदुःशासनवतुर्थानां कुरवो निधनं गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2099195, "chapter_id": 3122, "verse_number": "१३-२५२-६२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2099196, "chapter_id": 3122, "verse_number": "१३-२५२-६२", "content_sanskrit": "एवं सम्भाषमाणे तु गाङ्गेये पुरुषर्षभे।\nतूष्णीं बभूव कौरव्यो मध्ये तेषां महात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2099197, "chapter_id": 3122, "verse_number": "१३-२५२-६३", "content_sanskrit": "तच्छ्रुत्वा विस्मयं जग्मुर्धृतराष्ट्रादयो नृपाः।\nसम्पूज्य मनसा कृष्णं सर्वे प्राञ्जलयऽभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2099198, "chapter_id": 3122, "verse_number": "१३-२५२-६४", "content_sanskrit": "ऋषयश्चापि ते सर्वे नारदप्रमुखास्तदा।\nप्रतिगृह्याभ्यनन्दन्त तद्वाक्यं प्रतिपूज्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2099199, "chapter_id": 3122, "verse_number": "१३-२५२-६५", "content_sanskrit": "इत्येतदखिलं सर्वैः पाण्डवो भ्रातृभिः सह।\nश्रुतवान्सुमहाश्चर्यं पुण्यं भीष्मानुशासनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2099200, "chapter_id": 3122, "verse_number": "१३-२५२-६६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2099201, "chapter_id": 3122, "verse_number": "१३-२५२-६६", "content_sanskrit": "युधिष्ठिरस्तु गाङ्गेयं विश्रान्तं भूरिदक्षिणम्।\nपुनरेव महाबुद्धिः पर्यपृच्छन्महीपतिः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2099202, "chapter_id": 3122, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि द्विपञ्चाशदधिकद्विशततमोऽध्यायः॥ २५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}]