[{"id": 2067925, "chapter_id": 2428, "verse_number": "९-४६-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2067926, "chapter_id": 2428, "verse_number": "९-४६-१", "content_sanskrit": "ततोऽभिषेकसम्भारान्सर्वान्सम्भृत्य शास्त्रतः।\nबृहस्पतिः समिद्धेऽग्नौ जुहावाग्निं यथाविधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2067927, "chapter_id": 2428, "verse_number": "९-४६-२", "content_sanskrit": "ततो हिमवता दत्ते मणिप्रवरशोभिते।\nदिव्यरत्नाचिते पुण्ये निषण्णं परमासने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2067928, "chapter_id": 2428, "verse_number": "९-४६-३", "content_sanskrit": "सर्वमङ्गलसम्भारैर्विधिमन्त्रपुरस्कृतम्।\nआभिषेचनिकं द्रव्यं गृहीत्वा देवतागणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2067929, "chapter_id": 2428, "verse_number": "९-४६-४", "content_sanskrit": "इन्द्राविष्णू महावीर्यौ सूर्योचन्द्रमसौ तथा।\nधाता चैव विधाता च तथा चैवानिलानलौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2067930, "chapter_id": 2428, "verse_number": "९-४६-५", "content_sanskrit": "पूष्णा भगेनार्यम्णा च अंशेन च विवस्वतां।\nरुद्रश्च सहितो धीमान्मित्रेण वरुणेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2067931, "chapter_id": 2428, "verse_number": "९-४६-६", "content_sanskrit": "रुद्रैर्वसुभिरादित्यैरश्विभ्यां च वृतः प्रभुः।\nविश्वैर्देवैर्मरुद्भिश्च साध्यैश्च पितृभिः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2067932, "chapter_id": 2428, "verse_number": "९-४६-७", "content_sanskrit": "गन्धर्वैरप्सरोभिश्च यक्षराक्षसपन्नगैः।\nदेवर्षिभिरसङ्ख्यातैस्तथा ब्रह्मर्षिभिस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2067933, "chapter_id": 2428, "verse_number": "९-४६-८", "content_sanskrit": "वैखानसैर्वालखिल्यैर्वाय्वाहारैर्मरीचिपैः।\nभृगुभिश्चाङ्गिरोभिश्च यतिभिश्च महात्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2067934, "chapter_id": 2428, "verse_number": "९-४६-९", "content_sanskrit": "सर्वैर्विद्याधरैः पुण्यैर्योगसिद्धैस्तथा वृतः।\nपितामहः पुलस्त्यश्च पुलहश्च महातपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2067935, "chapter_id": 2428, "verse_number": "९-४६-१०", "content_sanskrit": "अङ्गिराः कश्यपोऽत्रिश्च मरीचिर्भृगुरेव च।\nक्रतुर्हरिः प्रचेताश्च मनुर्दक्षस्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2067936, "chapter_id": 2428, "verse_number": "९-४६-११", "content_sanskrit": "ऋतवश्च ग्रहाश्चैव ज्योतींषि च विशाम्पते।\nमूर्तिमत्यश्च सरितो वेदाश्चैव सनातनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2067937, "chapter_id": 2428, "verse_number": "९-४६-१२", "content_sanskrit": "समुद्राश्च हदाश्चैव तीर्थानि विविधानि च।\nपृथिवी द्यौर्दिशश्चैव पादपाश्च जनाधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2067938, "chapter_id": 2428, "verse_number": "९-४६-१३", "content_sanskrit": "अदितिर्देवमाता च हीः श्रीः स्वाहा सरस्वती।\nउमा शची सिनीवाली तथैवानुमतिः कुहूः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2067939, "chapter_id": 2428, "verse_number": "९-४६-१४", "content_sanskrit": "राका च धिषणा चैव पत्न्यश्चान्या दिवौकसाम्।\nहिमवांश्चैव विन्ध्यश्च मेरुश्चानेकशृङ्गवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2067940, "chapter_id": 2428, "verse_number": "९-४६-१५", "content_sanskrit": "ऐरावतः सानुचरः कलाः काष्ठास्तथैव च।\nमासार्धमासा ऋतवस्तथा रात्र्यहनी नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2067941, "chapter_id": 2428, "verse_number": "९-४६-१६", "content_sanskrit": "उच्चैः श्रवा हयश्रेष्ठो नागराजश्च वासुकिः।\nअरुणो गरुडश्चैव वृक्षाश्चौषधिभिः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2067942, "chapter_id": 2428, "verse_number": "९-४६-१७", "content_sanskrit": "धर्मश्च भगवान्देवः समाजग्मुर्हि सङ्गताः।\nकालो यमश्च मृत्युश्च यमस्यानुचराश्च ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2067943, "chapter_id": 2428, "verse_number": "९-४६-१८", "content_sanskrit": "बहुलत्वाच्च नोक्ता ये विविधा देवतागणाः।\nते कुमाराभिषेकार्षं समाजग्मुस्ततस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2067944, "chapter_id": 2428, "verse_number": "९-४६-१९", "content_sanskrit": "जगृहुस्ते तदा राजन्सर्वं एव दिवौकसः।\nआभिषेचनिकं भाण्डं मङ्गलानि च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2067945, "chapter_id": 2428, "verse_number": "९-४६-२०", "content_sanskrit": "दिव्यसम्भारसंयुक्तैः कलशैः काञ्चनैर्नृप।\nसारस्वताभिः पुण्याभिरद्भिस्ताभिरलङ्कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2067946, "chapter_id": 2428, "verse_number": "९-४६-२१", "content_sanskrit": "अभ्यषिञ्चन्कुमारं वै सम्प्रहृष्टा दिवौकसः।\nसैनापत्ये महात्मानमसुराणां भयङ्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2067947, "chapter_id": 2428, "verse_number": "९-४६-२२", "content_sanskrit": "पुरा यथा महाराज वरुणं वै जलेश्वरम्।\nतथाऽभ्यषिञ्चद्भगवान्सर्वलोकपितामहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2067948, "chapter_id": 2428, "verse_number": "९-४६-२३", "content_sanskrit": "कश्यपश्च महातेजा ये चान्ये सोककीर्तिताः।\nतस्मै ब्रह्मा ददौ प्रीतो बलिनो वातरंहसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2067949, "chapter_id": 2428, "verse_number": "९-४६-२४", "content_sanskrit": "कामवीर्यधरान्सिद्धान्महापारिषदान्प्रभुः।\nनन्दिसेनं लोहिताक्षं घण्टाकार्णं च सम्मतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2067950, "chapter_id": 2428, "verse_number": "९-४६-२५", "content_sanskrit": "चतुर्थमस्यानुचरं ख्यातं कुमुदमालिनम्।\nतत्र स्थाणुर्महातेजा महापारिषदं प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2067951, "chapter_id": 2428, "verse_number": "९-४६-२६", "content_sanskrit": "मायाशतधरं कामं कामवीर्यबलान्वितम्।\nददौ स्कन्दाय राजेन्द्र सुरारिविनिबर्हणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2067952, "chapter_id": 2428, "verse_number": "९-४६-२७", "content_sanskrit": "सहि देवासुरे युद्धे दैत्यानां भीमकर्मणाम्।\nजघान दोर्भ्यां सङ्क्रुद्धः प्रयुतानि चतुर्दश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2067953, "chapter_id": 2428, "verse_number": "९-४६-२८", "content_sanskrit": "तथा देवा ददुस्तस्मै सेनां नैर्ऋतसङ्कुलाम्।\nदेवशत्रुक्षयकरीमजय्यां विश्वरूपिणीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2067954, "chapter_id": 2428, "verse_number": "९-४६-२९", "content_sanskrit": "जयशब्दं तथा चक्रुर्देवाः सर्वे सवासवाः।\nगन्धर्वा यक्षरक्षांसि मुनयः पितरस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2067955, "chapter_id": 2428, "verse_number": "९-४६-३०", "content_sanskrit": "ततः प्रादादनुचरौ यमः कालोपमावुभौ।\nउन्माथं च प्रमाथं च महावीर्यौ महाद्युती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2067956, "chapter_id": 2428, "verse_number": "९-४६-३१", "content_sanskrit": "सुभ्राजो भास्वरश्चैव यौ तौ सूर्यानुयायिनौ।\nतौ सूर्यः कार्तिकेयाय ददौ प्रीतः प्रतापवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2067957, "chapter_id": 2428, "verse_number": "९-४६-३२", "content_sanskrit": "कैलासशृङ्गसङ्काशौ श्वेतमाल्यानुलेपनौ।\nसोमोऽप्यनुचरौ प्रादान्मणिं सुमणिमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2067958, "chapter_id": 2428, "verse_number": "९-४६-३३", "content_sanskrit": "ज्वालाजिह्वं तथा ज्योतिरात्मजाय हुताशनः।\nददावनुचरौ शूरौ परसैन्यप्रमाथिनौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2067959, "chapter_id": 2428, "verse_number": "९-४६-३४", "content_sanskrit": "परिधं च वटं चैव भीमं च सुमहाबलम्।\nदहतिं दहनं चैव प्रचण्डौ वीर्यसम्मतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2067960, "chapter_id": 2428, "verse_number": "९-४६-३५", "content_sanskrit": "अंशोऽप्यनुचरान्पञ्च ददौ स्कन्दाय धीमते।\nउत्क्रोशं सत्करं चैव वज्रदण्डधरावुभौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2067961, "chapter_id": 2428, "verse_number": "९-४६-३६", "content_sanskrit": "ददावनलपुत्राय वासवः परवीरहा।\nतौ हि शत्रून्महेन्द्रास्य जघ्नतुः समरे बहून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2067962, "chapter_id": 2428, "verse_number": "९-४६-३७", "content_sanskrit": "चक्रं विक्रमकं चैव सङ्क्रमं च महाबलम्।\nस्कन्दाय त्रीननुचरान्ददौ विष्णुर्महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2067963, "chapter_id": 2428, "verse_number": "९-४६-३८", "content_sanskrit": "वर्धनं नन्दनं चैव सर्वविद्याविशारदौ।\nस्कन्दाय ददतुः प्रीतावश्विनौ भिषजां वरौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2067964, "chapter_id": 2428, "verse_number": "९-४६-३९", "content_sanskrit": "किन्दुं च कुसुमं चैव कुमुदं च महायशाः।\nडम्बराडम्बरौ चैव ददौ धाता महात्मने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2067965, "chapter_id": 2428, "verse_number": "९-४६-४०", "content_sanskrit": "वक्रानुवक्रौ बलिनौ मेषवक्त्रौ बलोत्कटौ।\nददौ त्वष्टा महामायौ स्कन्दायानुचरावुभौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2067966, "chapter_id": 2428, "verse_number": "९-४६-४१", "content_sanskrit": "सुव्रतं सत्यसन्धं च ददौ मित्रो महात्मने।\nकुमाराय महात्मानौ तपोविद्याधरौ प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2067967, "chapter_id": 2428, "verse_number": "९-४६-४२", "content_sanskrit": "सुदर्शनीयौ वरदौ त्रिषु लोकेषु विश्रुतौ।\nसुव्रतं च महात्मानं शुभकर्माणमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2067968, "chapter_id": 2428, "verse_number": "९-४६-४३", "content_sanskrit": "कार्तिकेयाय सम्प्रादाद्विधाता लोकविश्रुतौ।\nपाणीतकं कालिकं च महामायाविनावुभौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2067969, "chapter_id": 2428, "verse_number": "९-४६-४४", "content_sanskrit": "पूषा च पार्षदौ प्रादात्कार्तिकेयाय भारत।\nबलं चातिबलं चैव महावक्त्रौ महाबलौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2067970, "chapter_id": 2428, "verse_number": "९-४६-४५", "content_sanskrit": "प्रददौ कार्तिकेयाय वायुर्भरतसत्तम।\nयमं चातियमं चैव तिमिवक्त्रौ महाबलौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2067971, "chapter_id": 2428, "verse_number": "९-४६-४६", "content_sanskrit": "प्रददौ कार्तिकेयाय वरुणः सत्यसङ्गरः।\nसुवर्चसं महात्मानं तथैवाप्यतिवर्चसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2067972, "chapter_id": 2428, "verse_number": "९-४६-४७", "content_sanskrit": "हिमवान्प्रददौ राजन्हुताशनसुताय वै।\nकाञ्चनं च महात्मानं मेघमालिनमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2067973, "chapter_id": 2428, "verse_number": "९-४६-४८", "content_sanskrit": "ददावनुचरौ मेरुरग्निपुत्राय भारत।\nस्थिरं चातिस्थिरं चैव मेरुरेवापरौ ददौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2067974, "chapter_id": 2428, "verse_number": "९-४६-४९", "content_sanskrit": "महात्मा त्वग्निपुत्राय महाबलपराक्रमौ।\nउच्छृङ्गं चातिशृङ्गं च महापाषाणयोधिनौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2067975, "chapter_id": 2428, "verse_number": "९-४६-५०", "content_sanskrit": "प्रददावग्निपुत्राय विन्ध्यः पारिषदावुभौ।\nसङ्ग्रहं विग्रहं चैव समुद्रोऽमि गदाधरौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2067976, "chapter_id": 2428, "verse_number": "९-४६-५१", "content_sanskrit": "प्रददावग्निपुत्राय महापारिषदावुभौ।\nउन्मादं शङ्कुकर्णं च पुष्पदन्तं तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2067977, "chapter_id": 2428, "verse_number": "९-४६-५२", "content_sanskrit": "प्रददावग्निपुत्राय पार्वती शुभदर्शना।\nजयं महाजयं चैव गङ्गा ज्वलनसूनवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2067978, "chapter_id": 2428, "verse_number": "९-४६-५३", "content_sanskrit": "प्रददौ पुरुषव्याघ्र वासुकिः पन्नगेश्वरः।\nएवं साध्याश्च रुद्राश्च वसवः पितरस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2067979, "chapter_id": 2428, "verse_number": "९-४६-५४", "content_sanskrit": "सागराः सरितश्चैव गिरयश्च महाबलाः।\nददुः सेनागणाध्यक्षाञ्शूलपट्टसधारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2067980, "chapter_id": 2428, "verse_number": "९-४६-५५", "content_sanskrit": "दिव्यप्रहरणोपेतान्नानावेषविभूषितान्।\nशृणु नामानि चाप्येषां येऽन्ये स्कन्दस्य सैनिकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2067981, "chapter_id": 2428, "verse_number": "९-४६-५६", "content_sanskrit": "विविधायुधसम्पन्नाश्चित्राभरणभूषिताः।\nशङ्कुकर्णो निकुम्भश्च पद्मः कुमुद एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2067982, "chapter_id": 2428, "verse_number": "९-४६-५७", "content_sanskrit": "अनन्तो द्वादशभुजस्तथा कृष्णोपकृष्णकौ।\nघ्राणश्रवाः कपिस्कन्धः काञ्चनाक्षो जलन्धमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2067983, "chapter_id": 2428, "verse_number": "९-४६-५८", "content_sanskrit": "अक्षः सन्तर्जनो राजन्कुनदीकस्तमोन्तकृत्।\nएकाक्षो द्वाशाक्षश्च तथैवैकजटः प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2067984, "chapter_id": 2428, "verse_number": "९-४६-५९", "content_sanskrit": "सहस्रबाहुर्विकटो व्याघ्राक्षः क्षितिकम्पनः।\nपुण्यनामा सुनामा च सुचक्रः प्रियदर्शनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2067985, "chapter_id": 2428, "verse_number": "९-४६-६०", "content_sanskrit": "परिश्रुतः कोकनदः प्रियमाल्यानुलेपनः।\nअजोदरो गजशिराः स्कन्धाक्षः शतलोचनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2067986, "chapter_id": 2428, "verse_number": "९-४६-६१", "content_sanskrit": "ज्वालाजिह्वः करालाक्षः शितिकेशो जटी हरिः।\nपरिश्रुतः कोकनदः कृष्णकेशो जटाधरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2067987, "chapter_id": 2428, "verse_number": "९-४६-६२", "content_sanskrit": "चतुर्दंष्ट्रोऽष्टजिह्वश्च मेघनादः पृथुश्रवाः।\nविद्युताक्षो धनुर्वक्त्रो जाठरो मारुताशनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2067988, "chapter_id": 2428, "verse_number": "९-४६-६३", "content_sanskrit": "उदाराक्षो रथाक्षश्च वज्रनाभो वसुप्रभः।\nसमुद्रवेगो राजेन्द्र शैलकम्पी तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2067989, "chapter_id": 2428, "verse_number": "९-४६-६४", "content_sanskrit": "वृषो मेषः प्रवाहश्च तथा नन्दोपनन्दकौ।\nधूम्रः श्वेतः कलिङ्गश्च सिद्धार्थो वरदस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2067990, "chapter_id": 2428, "verse_number": "९-४६-६५", "content_sanskrit": "प्रियकश्चैव नन्दश्च गोनन्दश्च प्रतपवान्।\nआनन्दश्च प्रमोदश्च स्वस्तिको ध्रुवकस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2067991, "chapter_id": 2428, "verse_number": "९-४६-६६", "content_sanskrit": "क्षेमवाहः सुवाहश्च सिद्धपात्रश्च भारत।\nगोव्रजः कनकापीडो महापारिषदेश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2067992, "chapter_id": 2428, "verse_number": "९-४६-६७", "content_sanskrit": "गायनो हसनश्चैव बाणः खङ्गश्च वीर्यवान्।\nवैताली गतिताली च तथा कथकवातिकौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2067993, "chapter_id": 2428, "verse_number": "९-४६-६८", "content_sanskrit": "हंसजः पङ्कदिग्धाङ्गः समुद्रोन्मादनश्च ह।\nरणोत्कटः प्रहासश्च श्वेतसिद्धश्च नन्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2067994, "chapter_id": 2428, "verse_number": "९-४६-६९", "content_sanskrit": "कालकण्ठः प्रभासश्च तथा कुम्भाण्डकोदरः।\nकालकक्षः सितश्चैव भूतानां मथनस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2067995, "chapter_id": 2428, "verse_number": "९-४६-७०", "content_sanskrit": "यज्ञवाहः सुवाहश्च देवयाजी च सोमपः।\nमज्जानश्च महातेजाः क्रथक्राथौ च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2067996, "chapter_id": 2428, "verse_number": "९-४६-७१", "content_sanskrit": "तुहरश्च तुहारश्च चित्रदेवश्च वीर्यवान्।\nमधुरः सुप्रसादश्च किरीटी च महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2067997, "chapter_id": 2428, "verse_number": "९-४६-७२", "content_sanskrit": "वत्सलो मधुवर्णश्च कलशोदर एव च।\nधर्मदो मन्मथकरः सूचीवक्त्रश्च वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2067998, "chapter_id": 2428, "verse_number": "९-४६-७३", "content_sanskrit": "श्वेतवक्त्रः सुवक्त्रश्च चारुवक्त्रश्च पाण्डुरः।\nदण्डबाहुः सुबाहुश्च रजः कोकिलकस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2067999, "chapter_id": 2428, "verse_number": "९-४६-७४", "content_sanskrit": "अचलः कनकाक्षश्च बालानामपि यः प्रभुः।\nसञ्चारकः कोकनदो गृध्रपत्रश्च जम्बुकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2068000, "chapter_id": 2428, "verse_number": "९-४६-७५", "content_sanskrit": "लोहाजवक्त्रो जवनः कुम्भवक्त्रश्च कुम्भकः।\nस्वर्णग्रीवश्च कृष्णौजा हंसवक्त्रश्च चन्द्रभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2068001, "chapter_id": 2428, "verse_number": "९-४६-७६", "content_sanskrit": "पाणिकूर्चाश्च शम्बूकः पञ्चवक्त्रश्च शिक्षकः।\nचाषवक्त्रक्ष जम्बूकः शाकवक्त्रश्च कुञ्जलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2068002, "chapter_id": 2428, "verse_number": "९-४६-७७", "content_sanskrit": "योगयोक्ता महात्मानः सततं ब्राह्मणप्रियाः।\nपैतामहा महात्मानो महापारिषदाश्च ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2068003, "chapter_id": 2428, "verse_number": "९-४६-७८", "content_sanskrit": "यौवनस्थाश्च बालाश्च वृद्धाश्च जनमेजय।\nसहस्रशः पारिषदाः कुमारमुपतस्थिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2068004, "chapter_id": 2428, "verse_number": "९-४६-७९", "content_sanskrit": "वक्त्रैर्नानाविधैर्ये तु शृणु ताञ्चनमेजय।\nकूर्मकुक्कुटवक्त्राश्च शशोलूकमुखास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2068005, "chapter_id": 2428, "verse_number": "९-४६-८०", "content_sanskrit": "खरोष्ट्रवदनाश्चान्ये वराहवदनास्तथा।\nमार्जारशशवक्ताश्च दीर्घवक्त्राश्च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2068006, "chapter_id": 2428, "verse_number": "९-४६-८१", "content_sanskrit": "नकुलोलूकवक्त्राश्च काकवक्त्रास्तथा परे।\nआखुबभ्रुकवक्त्राश्च मयूरवदनास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2068007, "chapter_id": 2428, "verse_number": "९-४६-८२", "content_sanskrit": "मत्स्यमेषाननाश्चान्ये अजाविमहिषाननाः।\nऋक्षशार्दूलवक्त्राश्च द्वीतिसिंहाननास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2068008, "chapter_id": 2428, "verse_number": "९-४६-८३", "content_sanskrit": "भीमा गजाननाश्चैव तथा नक्रमुखाश्च ये।\nगरुडाननाः कङ्कुमुखा वृककाकमुखास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2068009, "chapter_id": 2428, "verse_number": "९-४६-८४", "content_sanskrit": "गोखरोष्ट्रमुखाश्चान्ये वृषदंशमुखास्तथा।\nमहाजठरपादाङ्गास्तारकाक्षाश्च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2068010, "chapter_id": 2428, "verse_number": "९-४६-८५", "content_sanskrit": "पारावतमुखाश्चान्ये तथा वृषमुखाः परे।\nकोकिलाभाननाश्चान्ये श्येनतित्तिरिकाननाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2068011, "chapter_id": 2428, "verse_number": "९-४६-८६", "content_sanskrit": "कृकलासमुखाश्चैव विरजोम्बरधारिणः।\nव्यालवक्त्राः शूलमुखाश्चण्डवक्त्राः शुभाननाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2068012, "chapter_id": 2428, "verse_number": "९-४६-८७", "content_sanskrit": "आशीविषाश्चीरधरा गोनासावदनास्तथा।\nस्थूलोदराः कृशाङ्गाश्च स्थूलाङ्गाश्च कृशोदराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2068013, "chapter_id": 2428, "verse_number": "९-४६-८८", "content_sanskrit": "हस्वग्रीवा महाकर्णा नानाव्यालविभूषणाः।\nगजेन्द्रचर्मवसनास्तथा कृष्णाजिनाम्बराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2068014, "chapter_id": 2428, "verse_number": "९-४६-८९", "content_sanskrit": "स्कन्धेमुखा महाराज तथाप्युदरतोमुखाः।\nपृष्ठेमुखा हनुमुखास्तथा जङ्घामुखा अपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2068015, "chapter_id": 2428, "verse_number": "९-४६-९०", "content_sanskrit": "पार्श्वाननाश्च बहवो नानादेशमुखास्तथा।\nतथा कीटपतङ्गानां सदृशास्या गणेश्वराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2068016, "chapter_id": 2428, "verse_number": "९-४६-९१", "content_sanskrit": "नानाव्यालमुखाश्चान्ये बहुबाहुशिरोधराः।\nनानावृक्षभुजाः केचित्कटिशीर्षास्तथा परे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2068017, "chapter_id": 2428, "verse_number": "९-४६-९२", "content_sanskrit": "भुजङ्गभोगवदना नानागुल्मनिवासिनः।\nचीरसंवृतगात्राश्च नानाकनकवाससः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2068018, "chapter_id": 2428, "verse_number": "९-४६-९३", "content_sanskrit": "नानावेषधराश्चैव नानामाल्यानुलेपनाः।\nनानावस्त्रधराश्चैव चर्मवासस एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2068019, "chapter_id": 2428, "verse_number": "९-४६-९४", "content_sanskrit": "उष्णीषिणो मुकुटिनः सुग्रीवाश्च सुवर्चसः।\nकिरीटिनः पञ्चशिखास्तथा काञ्चनमूर्धजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2068020, "chapter_id": 2428, "verse_number": "९-४६-९५", "content_sanskrit": "त्रिशिखा द्विशिखाश्चैव तथा सप्तशिखाः परे।\nशिखण्डिनो मुकुटिनो मुण्डाश्च जटिलास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2068021, "chapter_id": 2428, "verse_number": "९-४६-९६", "content_sanskrit": "चित्रमालाधराः केचित्केचिद्रोमाननास्तथा।\nविग्रहैकरसा नित्यमजेताः सुरसत्तमैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2068022, "chapter_id": 2428, "verse_number": "९-४६-९७", "content_sanskrit": "कृष्णा निर्मांसवक्त्राश्च दीर्घपृष्ठास्तनूदराः।\nस्थूलपृष्ठा हस्वपृष्ठाः प्रलम्बोदरमेहनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2068023, "chapter_id": 2428, "verse_number": "९-४६-९८", "content_sanskrit": "महाभुजा हस्वभुजा हस्वगात्राश्च वामनाः।\nकुब्जाश्च हस्वजङ्घाश्च हस्तिकर्णशिरोधराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2068024, "chapter_id": 2428, "verse_number": "९-४६-९९", "content_sanskrit": "हस्तिनासाः कूर्मनासा वृकनासास्तथा परे।\nदीर्घोच्छ्वासा दीर्घजङ्घा विकराला ह्यधोमुखाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2068025, "chapter_id": 2428, "verse_number": "९-४६-१००", "content_sanskrit": "महादंष्ट्रा हस्वदंष्ट्राश्चतुर्दंष्ट्रास्तथा परे।\nवारमेन्द्रनिभाश्चान्ये भीमा राजन्सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2068026, "chapter_id": 2428, "verse_number": "९-४६-१०१", "content_sanskrit": "सुविभक्तशरीराश्च दीप्तिमन्तः स्वलङ्कृताः।\nपिङ्गाक्षाः शङ्कुकर्णाश्च रक्तनासाश्च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2068027, "chapter_id": 2428, "verse_number": "९-४६-१०२", "content_sanskrit": "पृथुदंष्ट्रा महादंष्ट्राः स्थूलौष्ठा हरिमूर्धजाः।\nनानापादौष्ठदंष्ट्राश्च नानाहस्तशिरोधराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2068028, "chapter_id": 2428, "verse_number": "९-४६-१०३", "content_sanskrit": "नानाचर्मभिराच्छन्ना नानाभाषाश्च भारत।\nकुशला देशभाषासु जल्पन्तोऽन्योन्यमीश्वराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2068029, "chapter_id": 2428, "verse_number": "९-४६-१०४", "content_sanskrit": "हृष्टाः परिपतन्ति स्म महापारिषदास्तथा।\nदीर्घग्रीवा दीर्घनखा दीर्घपादशिरोभुजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2068030, "chapter_id": 2428, "verse_number": "९-४६-१०५", "content_sanskrit": "पिङ्गाक्षा नीलकण्ठाश्च लम्बकर्णाश्च भारत।\nवृकोदरनिभाश्चैव केचिदञ्जनसन्निभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2068031, "chapter_id": 2428, "verse_number": "९-४६-१०६", "content_sanskrit": "श्वेताक्षा लोहितग्रीवाः पिङ्गाक्षाश्च तथा परे।\nकल्माषा बहवो राजंश्चित्रवर्णाश्च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2068032, "chapter_id": 2428, "verse_number": "९-४६-१०७", "content_sanskrit": "चामरापीडकनिभाः श्वेतलोहितराजयः।\nनानावर्णाः सवर्णाश्च मयूरसदृशप्रभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2068033, "chapter_id": 2428, "verse_number": "९-४६-१०८", "content_sanskrit": "पुनः प्रहरणान्येषां कीर्त्यमानानि मे शृणु।\nशेषैः कृतः पारिषदैरायुधानां परिग्रहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2068034, "chapter_id": 2428, "verse_number": "९-४६-१०९", "content_sanskrit": "पाशोद्यतकराः केचिद्व्यादितास्याः खराननाः।\nपृष्ठाक्षा नीलकण्ठाश्च तथा परिघबाहवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2068035, "chapter_id": 2428, "verse_number": "९-४६-११०", "content_sanskrit": "शतघ्नीचक्रहस्ताश्च तथा मुसलपाणयः।\nअसिमुद्ग्ररहस्ताश्च दण्डहस्ताश्च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2068036, "chapter_id": 2428, "verse_number": "९-४६-१११", "content_sanskrit": "गदाभुशुण्डिहस्ताश्च तथा तोमरपाणयः।\nआयुधैर्विविधैर्घोरैर्महात्मानो महाजवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2068037, "chapter_id": 2428, "verse_number": "९-४६-११२", "content_sanskrit": "महाबला महावेगा महापारिषदास्तथा।\nअभिषेकं कुमारस्य दृष्ट्वा हृष्टा रणप्रियाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2068038, "chapter_id": 2428, "verse_number": "९-४६-११३", "content_sanskrit": "घण्टाजालपिनद्धाङ्गा ननृतुस्ते महौजसः।\nएते चान्ये च बहवो महापारिषदा नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2068039, "chapter_id": 2428, "verse_number": "९-४६-११४", "content_sanskrit": "उपतस्थुर्महात्मानं कार्तिकेयं यशस्विनम्।\nदिव्याश्चाप्यान्तरिक्षाश्च पार्थिवाश्चानिलोपमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2068040, "chapter_id": 2428, "verse_number": "९-४६-११५", "content_sanskrit": "व्यादिष्टा दैवतैः शूराः स्कन्दस्यानुचराऽभवन्।\nतादृशानां सहस्राणि प्रयुतान्यर्बुदानि च।\nअभिषिक्तं महात्मानं परिवार्योपतस्थिरे॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2068041, "chapter_id": 2428, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शल्यपर्वणि ह्रदप्रवेशपर्वणि षट्चत्वारिंशोऽध्यायः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}]