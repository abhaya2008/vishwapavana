[{"id": 7003516000, "chapter_id": 23516, "verse_number": "१५६-१", "content_sanskrit": "अथ मथुराप्रादुर्भावः ।\nश्रीवराह उवाच ।\nवत्सक्रीडनकं नाम तीर्थं वक्ष्ये परं मम ।\nतत्र रक्तशिलाबद्धं रक्तचन्दनभूषितम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003516001, "chapter_id": 23516, "verse_number": "१५६-२", "content_sanskrit": "स्नानमात्रेण तत्रैव वायुलोकं व्रजेन्नरः ।\nतत्राऽथ मुञ्चते प्राणान्मम लोके महीयते ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003516002, "chapter_id": 23516, "verse_number": "१५६-३", "content_sanskrit": "पुनरन्यत्प्रवक्ष्यामि तच्छृणुष्व वसुन्धरे ।\nअस्ति भाण्डीरकं नाम यत्तीर्थं परमुत्तमम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003516003, "chapter_id": 23516, "verse_number": "१५६-४", "content_sanskrit": "सालैस्तालैश्च तरुभिस्तमालैरर्ज्जुनैस्तथा ।\nइङ्गुदैः पीलुकैश्चैव करीरैरक्तपुष्पकैः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003516004, "chapter_id": 23516, "verse_number": "१५६-५", "content_sanskrit": "तस्मिन्भाण्डीरके स्नातो नियतो नियताशनः ।\nसर्वपापविनिर्मुक्तश्चेन्द्रलोकं स गच्छति ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003516005, "chapter_id": 23516, "verse_number": "१५६-६", "content_sanskrit": "तत्राऽथ मुञ्चते प्राणान्मम लोकं च गच्छति ।\nपुनरन्यत्प्रवक्ष्यामि क्षेत्रं वृन्दावनं मम ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003516006, "chapter_id": 23516, "verse_number": "१५६-७", "content_sanskrit": "तत्राहं क्रीडयिष्यामि गोभिर् गोपालकैः सह ।\nरम्यं च सुप्रतीतं च देवदानवदुर्लभम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003516007, "chapter_id": 23516, "verse_number": "१५६-८", "content_sanskrit": "तत्र कुण्डे महाभागे बहुगुल्मलतावृते ।\nतत्र  स्नानं प्रकुर्वीत चैकरात्रोषितो नरः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003516008, "chapter_id": 23516, "verse_number": "१५६-९", "content_sanskrit": "गन्धर्वैरप्सरोभिश्च क्रीडमानः स मोदते ।\nतत्राथ मुञ्चते प्राणान्मम लोकं च गच्छति ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003516009, "chapter_id": 23516, "verse_number": "१५६-१०", "content_sanskrit": "पुनरन्यत्प्रवक्ष्यामि महापातकनाशनम् ।\nतत्र वृन्दावने तीर्थे यत्र केशी निपातितः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003516010, "chapter_id": 23516, "verse_number": "१५६-११", "content_sanskrit": "तीर्थं शतगुणं पुण्यं यत्र केशी निपातितः ।\nकेश्यः शतगुणं पुण्यं यत्र विश्रमते हरिः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003516011, "chapter_id": 23516, "verse_number": "१५६-१२", "content_sanskrit": "तस्माच्छतगुणं पुण्यं नात्र कार्या विचारणा ।\nतत्रापि च विशेषोऽस्ति केशीतीर्थे वसुन्धरे ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003516012, "chapter_id": 23516, "verse_number": "१५६-१३", "content_sanskrit": "तस्मिन्पिण्डप्रदानेन गयातुल्य फलं भवेत् ।\nस्नाने दाने तथा होमे अग्निष्टोमफलं भवेत् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003516013, "chapter_id": 23516, "verse_number": "१५६-१४", "content_sanskrit": "सूर्यतीर्थेषु वसुधे द्वादशादित्यसंज्ञिके ।\nकालियो रमते तत्र कालिंद्याः सलिले शुभे ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003516014, "chapter_id": 23516, "verse_number": "१५६-१५", "content_sanskrit": "कालियो दमितस्तत्र आदित्याः स्थापिता मया ।\nवरं वृणुध्वं भद्रं वो यद्वो मनसि वर्त्तते ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003516015, "chapter_id": 23516, "verse_number": "१५६-१६", "content_sanskrit": "आदित्या ऊचुः ।\nवरं ददासि नो देव वरार्हा यदि वा वयम् ।\nअस्मिंस्तीर्थवरे स्नानमस्माकं संप्रदीयताम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003516016, "chapter_id": 23516, "verse_number": "१५६-१७", "content_sanskrit": "आदित्यानां वचः श्रुत्वा क्रीडां कृत्वा वसुन्धरे ।\nस्नानमात्रेण तत्रैव मुच्यते सर्वकिल्बिषैः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003516017, "chapter_id": 23516, "verse_number": "१५६-१८", "content_sanskrit": "अथात्र मुंचते प्राणान्मम लोकं स गच्छति ।\nउत्तरे हरिदेवस्य दक्षिणे कालियस्य तु ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003516018, "chapter_id": 23516, "verse_number": "१५६-१९", "content_sanskrit": "अनयोर्देवयोर्मध्ये ये मृतास्तेऽपुनर्भवाः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]