[{"id": 7004919000, "chapter_id": 24919, "verse_number": "७-१-१०२-१", "content_sanskrit": "ततो गच्छेन्महादेवि देवीं कंटकशोधिनीम् ।\nतस्यैवोत्तरदिग्भागे धनुर्द्वितयसंस्थिताम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004919001, "chapter_id": 24919, "verse_number": "७-१-१०२-२", "content_sanskrit": "महिषघ्नीं महाकायां ब्रह्मदेवर्षिपूजिताम् ।\nपुरा ये कल्मषोपेता दानवा देवकंटकाः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004919002, "chapter_id": 24919, "verse_number": "७-१-१०२-३", "content_sanskrit": "युगेयुगे शोधयेत्तांस्तेन कंटकशोधिनी ।\nआश्वयुक्छुक्लपक्षे तु नवम्यां तामथार्चयेत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004919003, "chapter_id": 24919, "verse_number": "७-१-१०२-४", "content_sanskrit": "पशुपुष्पोपहारैश्च दीपधूपैस्तथोत्तमैः ।\nतस्याऽरयो न जायंते यावद्वर्षं वरानने ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004919004, "chapter_id": 24919, "verse_number": "७-१-१०२-५", "content_sanskrit": "यस्तां पश्यति सद्भक्त्या भूताया नित्यमेव वा॥ ॥तं पुत्रमिव कल्याणी संरक्षति न संशयः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004919005, "chapter_id": 24919, "verse_number": "७-१-१०२-६", "content_sanskrit": "इति संक्षेपतः प्रोक्तं माहात्म्यं पापनाशनम् ।\nदेवि कंटकशोधिन्याः श्रुतं रक्षाकरं परम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}]