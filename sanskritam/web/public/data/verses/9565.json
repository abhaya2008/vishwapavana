[{"id": 5000565000, "chapter_id": 9565, "verse_number": "७-३०-१", "content_sanskrit": "जिते महेन्द्रे ऽतिबले रावणस्य सुतेन वै ।\nप्रजापतिं पुरस्कृत्य ययुर्लङ्कां सुरास्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000565001, "chapter_id": 9565, "verse_number": "७-३०-२", "content_sanskrit": "तत्र रावणमासाद्य पुत्रभ्रातृभिरावृतम् ।\nअब्रवीद्गगने तिष्ठन्सामपूर्वं प्रजापतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000565002, "chapter_id": 9565, "verse_number": "७-३०-३", "content_sanskrit": "वत्स रावण तुष्टो ऽस्मि पुत्रस्य तव संयुगे ।\nअहो ऽस्य विक्रमौदार्यं तव तुल्यो ऽधिको ऽपि वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000565003, "chapter_id": 9565, "verse_number": "७-३०-४", "content_sanskrit": "जितं हि भवता सर्वं त्रैलोक्यं स्वेन तेजसा ।\nकृता प्रतिज्ञा सफला प्रीतो ऽस्मि स्वसुतेन वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000565004, "chapter_id": 9565, "verse_number": "७-३०-५", "content_sanskrit": "अयं च पुत्रो ऽतिबलस्तव रावण वीर्यवान् ।\nजगतीन्द्रजिदित्येव परिख्यातो भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000565005, "chapter_id": 9565, "verse_number": "७-३०-६", "content_sanskrit": "बलवान्दुर्जयश्चैव भविष्यत्येव राक्षसः ।\nयं समाश्रित्य ते राजन्स्थापितास्त्रिदशा वशे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000565006, "chapter_id": 9565, "verse_number": "७-३०-७", "content_sanskrit": "तन्मुच्यतां महाबाहो महेन्द्रः पाकशासनः ।\nकिञ्चास्य मोक्षणार्थाय प्रयच्छन्तु दिवौकसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000565007, "chapter_id": 9565, "verse_number": "७-३०-८", "content_sanskrit": "अथाब्रवीन्महातेजा इन्द्रजित्समितिञ्जयः ।\nअमरत्वमहं देव वृणे यद्येष मुच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000565008, "chapter_id": 9565, "verse_number": "७-३०-९", "content_sanskrit": "चतुष्पदां खेचराणामन्येषां वा महौजसाम् ।\nवृक्षगुल्मक्षुपलतातृणोपलमहीभृताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000565009, "chapter_id": 9565, "verse_number": "७-३०-१०", "content_sanskrit": "सर्वे ऽपि जन्तवो ऽन्योन्यं भेतव्ये सति बिभ्यति ।\nअतो ऽत्र लोके सर्वेषां सर्वस्माच्च भवेद्भयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000565010, "chapter_id": 9565, "verse_number": "७-३०-११", "content_sanskrit": "ततो ऽब्रवीन्महातेजा मेघनादं प्रजापतिः ।\nनास्ति सर्वामरत्वं हि कस्यचित्प्राणिनो भुवि ।\nचतुष्पदः पक्षिणश्च भूतानां वा महौजसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000565011, "chapter_id": 9565, "verse_number": "७-३०-१२", "content_sanskrit": "श्रुत्वा पितामहेनोक्तमिन्द्रजित्प्रभुणाव्ययम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000565012, "chapter_id": 9565, "verse_number": "७-३०-१३", "content_sanskrit": "्वं हि कस्यचित्प्राणिनो भुवि ।\nअथाब्रवीत्स तत्रस्थं मेघनादो महाबलः ।\nश्रूयतां वा भवेत्सिद्धिः शतक्रतुविमोक्षणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000565013, "chapter_id": 9565, "verse_number": "७-३०-१४", "content_sanskrit": "ममेष्टं नित्यशो हर्व्यैर्मन्त्रैः सम्पूज्य पावकम् ।\nसङ्ग्राममवतर्त्तुं च शत्रुनिर्जयकाङ्क्षिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000565014, "chapter_id": 9565, "verse_number": "७-३०-१५", "content_sanskrit": "अश्वयुक्तो रथो मह्यमुत्तिष्ठेत्तु विभावसोः ।\nतत्स्थस्यामरता स्यान्मे एष मे निश्चयो वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000565015, "chapter_id": 9565, "verse_number": "७-३०-१६", "content_sanskrit": "तस्मिन्यद्यसमाप्ते च जप्यहोमे विभावसौ ।\nयुध्येयं देव सङ्ग्रामे तदा मे स्याद्विनाशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000565016, "chapter_id": 9565, "verse_number": "७-३०-१७", "content_sanskrit": "सर्वो हि तपसा देव वृणोत्यमरतां पुमान् ।\nविक्रमेण मया त्वेतदमरत्वं प्रवर्तितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000565017, "chapter_id": 9565, "verse_number": "७-३०-१८", "content_sanskrit": "एवमस्त्विति तं चाह वाक्यं देवः पितामहः ।\nमुक्तश्चेन्द्रजिता शक्रो गताश्च त्रिदिवं सुराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000565018, "chapter_id": 9565, "verse_number": "७-३०-१९", "content_sanskrit": "एतस्मिन्नन्तरे राम दीनो भ्रष्टाम्बरद्युतिः ।\nइन्द्रश्चिन्तापरीतात्मा ध्यानतत्परतां गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000565019, "chapter_id": 9565, "verse_number": "७-३०-२०", "content_sanskrit": "तं तु दृष्ट्वा तथाभूतं प्राह देवः प्रजापतिः ।\nशतक्रतो किमु पुरा करोति स्म सुदुष्कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000565020, "chapter_id": 9565, "verse_number": "७-३०-२१", "content_sanskrit": "अमरेन्द्र मया बह्व्यः प्रजाः सृष्टास्तथा प्रभो ।\nएकवर्णाः समाभाषा एकरूपाश्च सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000565021, "chapter_id": 9565, "verse_number": "७-३०-२२", "content_sanskrit": "तासां नास्ति विशेषो हि दर्शने लक्षणे ऽपि वा ।\nततो ऽहमेकाग्रमनास्ताः प्रजाः परिचिन्तयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000565022, "chapter_id": 9565, "verse_number": "७-३०-२३", "content_sanskrit": "सो ऽहं तासां विशेषार्थं स्त्रियमेकां विनिर्ममे ।\nयद्यत्प्रजानां प्रत्यङ्गं विशिष्टं तत्तदुद्धृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000565023, "chapter_id": 9565, "verse_number": "७-३०-२४", "content_sanskrit": "ततो मया रूपगुणैरहल्या स्त्री विनिर्मिता ।\nहलं नामेह वैरूपं हल्यं तत्प्रभवं भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000565024, "chapter_id": 9565, "verse_number": "७-३०-२५", "content_sanskrit": "यस्मान्न विद्यते हल्यं तेनाहल्येति विश्रुता ।\nअहल्येति मया शक्र तस्या नाम प्रवर्तितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000565025, "chapter_id": 9565, "verse_number": "७-३०-२६", "content_sanskrit": "निर्मितायां च देवेन्द्र तस्यां नार्यां सुरर्षभ ।\nभविष्यतीति कस्यैषा मम चिन्ता ततो ऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000565026, "chapter_id": 9565, "verse_number": "७-३०-२७", "content_sanskrit": "त्वं तु शक्र तदा नारीं जानीषे मनसा प्रभो ।\nस्थानाधिकतया पत्नी ममैषेति पुरन्दर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000565027, "chapter_id": 9565, "verse_number": "७-३०-२८", "content_sanskrit": "सा मया न्यासभूता तु गौतमस्य महात्मनः ।\nन्यस्ता बहूनि वर्षाणि तेन निर्यातिता च ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000565028, "chapter_id": 9565, "verse_number": "७-३०-२९", "content_sanskrit": "ततस्तस्य परिज्ञाय महास्थैर्यं महामुनेः ।\nज्ञात्वा तपसि सिद्धिं च पत्न्यर्थं स्पर्शिता तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000565029, "chapter_id": 9565, "verse_number": "७-३०-३०", "content_sanskrit": "सङ्क्रुद्धस्त्वं हि धर्मात्मन् गत्वा तस्याश्रमं मुनेः ।\nदृष्टवांश्च तदा तां स्त्रीं दीप्तामग्निशिखामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000565030, "chapter_id": 9565, "verse_number": "७-३०-३१", "content_sanskrit": "सा त्वया धर्षिता शक्र कामार्तेन समन्युना ।\nदृष्टस्त्वं च तदा तेन ह्याश्रमे परमर्षिणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000565031, "chapter_id": 9565, "verse_number": "७-३०-३२", "content_sanskrit": "ततः क्रुद्धेन तेना ऽसि शप्तः परमतेजसा ।\nगतो ऽसि येन देवेन्द्र दशाभागविपर्ययम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000565032, "chapter_id": 9565, "verse_number": "७-३०-३३", "content_sanskrit": "यस्मान्मे धर्षिता पत्नी त्वया वासव निर्भयम् ।\nतस्मात्त्वं समरे राजञ्छत्रुहस्तं गमिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000565033, "chapter_id": 9565, "verse_number": "७-३०-३४", "content_sanskrit": "अयं तु भावो दुर्बुद्धे यस्त्वयेह प्रवर्तितः ।\nमानुषेष्वपि लोकेषु भविष्यति न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000565034, "chapter_id": 9565, "verse_number": "७-३०-३५", "content_sanskrit": "तत्रार्धं तस्य यः कर्ता त्वय्यर्धं निपतिष्यति ।\nन च ते स्थावरं स्थानं भविष्यति न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000565035, "chapter_id": 9565, "verse_number": "७-३०-३६", "content_sanskrit": "यश्च यश्च सुरेन्द्रः स्याद्ध्रुवः स न भविष्यति ।\nएष शापो मया मुक्त इत्यसौ त्वां तदा ऽब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000565036, "chapter_id": 9565, "verse_number": "७-३०-३७", "content_sanskrit": "तां तु भार्यां स निर्भर्त्स्य सो ऽब्रवीत्सुमहातपाः ।\nदुर्विनीते विनिध्वंस ममाश्रमसमीपतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000565037, "chapter_id": 9565, "verse_number": "७-३०-३८", "content_sanskrit": "रूपयौवनसम्पन्ना यस्मात्त्वमनवस्थिता ।\nतस्माद्रूपवती लोके न त्वमेका भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000565038, "chapter_id": 9565, "verse_number": "७-३०-३९", "content_sanskrit": "रूपं च ते प्रजाः सर्वा गमिष्यन्ति न संशयः ।\nयत्तदेकं समाश्रित्य विभ्रमो ऽयमुपस्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000565039, "chapter_id": 9565, "verse_number": "७-३०-४०", "content_sanskrit": "तदाप्रभृति भूयिष्ठं प्रजा रूपसमन्विताः ।\nसा तं प्रसादयामास महर्षिं गौतमं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000565040, "chapter_id": 9565, "verse_number": "७-३०-४१", "content_sanskrit": "अज्ञानाद्धर्षिता विप्र त्वद्रूपेण दिवौकसा ।\nन कामकाराद्विप्रर्षे प्रसादं कर्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000565041, "chapter_id": 9565, "verse_number": "७-३०-४२", "content_sanskrit": "अहल्यया त्वेवमुक्तः प्रत्युवाच स गौतमः ।\nउत्पत्स्यति महातेजा इक्ष्वाकूणां महारथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000565042, "chapter_id": 9565, "verse_number": "७-३०-४३", "content_sanskrit": "रामो नाम श्रुतो लोके वनं चाप्युपयास्यति ।\nब्राह्मणार्थे महाबाहुर्विष्णुर्मानुषविग्रहः ।\nतं द्रक्ष्यसि यदा भद्रे ततः पूता भविष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000565043, "chapter_id": 9565, "verse_number": "७-३०-४४", "content_sanskrit": "स हि पावयितुं शक्तस्त्वया यद्दुष्कृतं कृतम् ।\nतस्यातिथ्यं च कृत्वा वै मत्समीपं गमिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000565044, "chapter_id": 9565, "verse_number": "७-३०-४५", "content_sanskrit": "वत्स्यसि त्वं मया सार्धं तदा हि वरवर्णिनि ।\nएवमुक्त्वा स विप्रर्षिराजगाम स्वमाश्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000565045, "chapter_id": 9565, "verse_number": "७-३०-४६", "content_sanskrit": "तपश्चाचार सुमहत्सा पत्नी ब्रह्मवादिनः ।\nशापोत्सर्गाद्धि तस्येदं मुनेः सर्वमुपस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000565046, "chapter_id": 9565, "verse_number": "७-३०-४७", "content_sanskrit": "तत्स्मर त्वं महाबाहो दुष्कृतं यत्त्वया कृतम् ।\nतेन त्वं ग्रहणं शत्रोर्यातो नान्येन वासव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000565047, "chapter_id": 9565, "verse_number": "७-३०-४८", "content_sanskrit": "शीघ्रं वै यज यज्ञं त्वं वैष्णवं सुसमाहितः ।\nपावितस्तेन यज्ञेन यास्यसे त्रिदिवं ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000565048, "chapter_id": 9565, "verse_number": "७-३०-४९", "content_sanskrit": "पुत्रश्च तव देवेन्द्र न विनष्टो महारणे ।\nनीतः सन्निहितश्चैव आर्यकेण महोदधौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000565049, "chapter_id": 9565, "verse_number": "७-३०-५०", "content_sanskrit": "एतच्छ्रुत्वा महेन्द्रस्तु यज्ञमिष्ट्वा च वैष्णवम् ।\nपुनस्त्रिदिवमाक्रामदन्वशासच्च देवराट् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000565050, "chapter_id": 9565, "verse_number": "७-३०-५१", "content_sanskrit": "एतदिन्द्रजितो नाम बलं यत्कीर्तितं मया ।\nनिर्जितस्तेन देवेन्द्रः प्राणिनो ऽन्ये तु किं पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000565051, "chapter_id": 9565, "verse_number": "७-३०-५२", "content_sanskrit": "आश्चर्यमिति रामश्च लक्ष्मणश्चाब्रवीत्तदा ।\nअगस्त्यवचनं श्रुत्वा वानरा राक्षसास्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000565052, "chapter_id": 9565, "verse_number": "७-३०-५३", "content_sanskrit": "विभीषणस्तु रामस्य पार्श्वस्थो वाक्यमब्रवीत् ।\nआश्चर्यं स्मारितो ऽस्म्यद्य यत्तद्दृष्टं पुरातनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000565053, "chapter_id": 9565, "verse_number": "७-३०-५४", "content_sanskrit": "अगस्त्यं त्वब्रवीद्रामः सत्यमेतच्छ्रुतं च मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000565054, "chapter_id": 9565, "verse_number": "७-३०-५५", "content_sanskrit": "एवं राम समुद्भूतो रावणो लोककण्टकः ।\nसपुत्रो येन सङ्ग्रामे जितः शक्रः सुरेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000565055, "chapter_id": 9565, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे त्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]