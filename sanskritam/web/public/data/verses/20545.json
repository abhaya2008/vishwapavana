[{"id": 7000545000, "chapter_id": 20545, "verse_number": "५-४-१", "content_sanskrit": "वात्स्यायन उवाच ।\nभुजगाधीश्वरेशान धराभारधरक्षम ।\nशृण्वेकं संशयं मह्यं कृपया कथयस्व तम्॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000545001, "chapter_id": 20545, "verse_number": "५-४-२", "content_sanskrit": "रघुनाथस्य गमनं वनं प्रति यदा ह्यभूत् ।\nतदा प्रभृति देहेन स्थिता शून्येन चेतसा॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000545002, "chapter_id": 20545, "verse_number": "५-४-३", "content_sanskrit": "तद्विप्रयोगविधुरा कृशदेहातिदुःखिता ।\nसुमुखान्मंत्रिणः श्रुत्वा रघुनाथं समागतम्॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000545003, "chapter_id": 20545, "verse_number": "५-४-४", "content_sanskrit": "कथं जहर्ष किमभूत्कीदृशं तत्र चिह्नितम् ।\nरामचंद्रस्य संदेशहर्तारं किमुवाच सा॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000545004, "chapter_id": 20545, "verse_number": "५-४-५", "content_sanskrit": "एतन्मे संशयं छिंधि रघुनाथगुणोदयम् ।\nयथावच्छृण्वते मह्यं कथयस्व प्रसादतः॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000545005, "chapter_id": 20545, "verse_number": "५-४-६", "content_sanskrit": "शेष उवाच ।\nसाधुपृष्टं महाभाग द्विजवर्यपुरस्कृत ।\nतन्मे निगदतः साक्षाच्छृणुष्वैकमनाः किल॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000545006, "chapter_id": 20545, "verse_number": "५-४-७", "content_sanskrit": "सा वै तद्वदनांभोज च्युतं रामागमामृतम् ।\nपीत्वा पीत्वा बभूवाहो स्थगितांगेन विह्वला॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000545007, "chapter_id": 20545, "verse_number": "५-४-८", "content_sanskrit": "किं मे स्वप्नो विमूढायाः किं वा भ्रमकरं वचः ।\nममवै मंदभाग्यायाः कथं रामेक्षणं पुनः॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000545008, "chapter_id": 20545, "verse_number": "५-४-९", "content_sanskrit": "बहुना तपसा कृत्वा प्राप्तोऽयं वै सुतः शिशुः ।\nकेनचिन्मम पापेन विप्रयोगं गतः पुनः॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000545009, "chapter_id": 20545, "verse_number": "५-४-१०", "content_sanskrit": "सुमंत्रिन्कुशली रामः सीतालक्ष्मणसंयुतः ।\nकथं मां स्मरते वीरो वनचारी सुदुःखिताम्॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000545010, "chapter_id": 20545, "verse_number": "५-४-११", "content_sanskrit": "इति सा विललापोच्चै रघुनाथस्मृतिं गता ।\nन निवेद निजं किंचित्परकीयं विमोहिता ।\nसुमुखोऽपि तथा दृष्ट्वा दुःखितां मातरं भृशम्॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000545011, "chapter_id": 20545, "verse_number": "५-४-१२", "content_sanskrit": "वीजयामास वासोग्रैः संज्ञामाप च सा पुनः ।\nउवाच जननीं सौम्यं वचोहर्षकरं मुहुः॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000545012, "chapter_id": 20545, "verse_number": "५-४-१३", "content_sanskrit": "रघुनाथागमस्मार हृष्टां तां व्यदधात्पुनः ।\nमातर्विद्धि गृहं प्राप्तं रघुनाथं सलक्ष्मणम्॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000545013, "chapter_id": 20545, "verse_number": "५-४-१४", "content_sanskrit": "सीतया सहितं पश्य चाशीर्भिरभियुंक्ष्व च ।\nइति तथ्यं वचः श्रुत्वा सुमुखेन प्रभाषितम्॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000545014, "chapter_id": 20545, "verse_number": "५-४-१५", "content_sanskrit": "यादृशं हर्षमापेदे तादृशं वेद्म्यहं नहि ।\nउत्थाय चाजिरे प्राप्ता रोमांचिततनूरुहा॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000545015, "chapter_id": 20545, "verse_number": "५-४-१६", "content_sanskrit": "हर्षविह्वलितांग्यश्रु मुंचंती राममैक्षत ।\nतावत्स रामो राजेंद्रो नरयानमधिश्रितः॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000545016, "chapter_id": 20545, "verse_number": "५-४-१७", "content_sanskrit": "प्राप्तः स्वमातुर्भवनं कैकेय्याः सुनयः पुरः ।\nकैकेय्यपि त्रपाभारनम्रा रामं पुरःस्थितम्॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000545017, "chapter_id": 20545, "verse_number": "५-४-१८", "content_sanskrit": "नोवाच किंचिन्महतीं चिंतां प्राप्तवती मुहुः ।\nसूर्यवंशध्वजो रामो मातरं वीक्ष्य लज्जिताम्॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000545018, "chapter_id": 20545, "verse_number": "५-४-१९", "content_sanskrit": "उवाच सांत्वयंस्तां च वाक्यैर्विनयमिश्रितैः ।\nश्रीराम उवाच ।\nमातर्मया वनं गत्वा सर्वमाचरितं तथा॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000545019, "chapter_id": 20545, "verse_number": "५-४-२०", "content_sanskrit": "अधुना करवै किं वा त्वदाज्ञातो जनन्यहो ।\nमया न्यूनं कृतं नास्ति कथं मां नेक्ष्यसे पुनः॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000545020, "chapter_id": 20545, "verse_number": "५-४-२१", "content_sanskrit": "आशीर्भिरभिनंद्यैनं भरतं मां च वीक्षय ।\nइति श्रुत्वापि तद्वाक्यं सा नम्रवदनानघ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000545021, "chapter_id": 20545, "verse_number": "५-४-२२", "content_sanskrit": "शनैः शनैः प्रत्युवाच राम गच्छ स्वमालयम् ।\nरामोऽपि श्रुत्वा वचनं जनन्याः पुरुषोत्तमः॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000545022, "chapter_id": 20545, "verse_number": "५-४-२३", "content_sanskrit": "नमस्कृत्य ययौ गेहं सुमित्रायाः कृपानिधिः ।\nसुमित्रा पुत्रसहितं रामं दृष्ट्वा महामनाः॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000545023, "chapter_id": 20545, "verse_number": "५-४-२४", "content_sanskrit": "चिरंजीव चिरंजीव ह्याशीर्भिरिति चाभ्यधात् ।\nमातुश्च रामभद्रोऽपि चरणौ प्रणिपत्य च॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000545024, "chapter_id": 20545, "verse_number": "५-४-२५", "content_sanskrit": "परिष्वज्य मुदायुक्तो जगाद वचनं पुनः ।\nरत्नगर्भे मम भ्रात्रा केनापि न कृतं तथा॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000545025, "chapter_id": 20545, "verse_number": "५-४-२६", "content_sanskrit": "यथायमकरोद्धीमान्ममदुःखापनोदनम्॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000545026, "chapter_id": 20545, "verse_number": "५-४-२७", "content_sanskrit": "रावणेन हृता सीता मया यत्प्राप्यते पुनः ।\nमातस्तत्सर्वमाविद्धि लक्ष्मणस्य विचेष्टितम्॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000545027, "chapter_id": 20545, "verse_number": "५-४-२८", "content_sanskrit": "दत्तामाशिषमागृह्य शिरसायं सुमित्रया ।\nनिजमातुश्च भवनं प्रययौ विबुधैर्वृतः॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000545028, "chapter_id": 20545, "verse_number": "५-४-२९", "content_sanskrit": "मातरं वीक्ष्य हृषितां निजदर्शनलालसाम् ।\nस्वयानादवरुह्याशु चरणावग्रहीद्धरिः॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000545029, "chapter_id": 20545, "verse_number": "५-४-३०", "content_sanskrit": "माता तद्दर्शनोत्कंठा विह्वलीकृतमानसा ।\nपरिष्वज्य परिष्वज्य रामं मुदमवाप सा॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000545030, "chapter_id": 20545, "verse_number": "५-४-३१", "content_sanskrit": "शरीरे रोमहर्षोऽभूद्गद्गदा वागभूत्तदा ।\nहर्षाश्रूणि तु सोष्णानि प्रवाहं प्रापुरापदात्॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000545031, "chapter_id": 20545, "verse_number": "५-४-३२", "content_sanskrit": "जननीं वीक्ष्य विनयी ताटंकद्वयवर्जिताम् ।\nकराकल्प पदाकल्परहितां बिभ्रतीं तनुम्॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000545032, "chapter_id": 20545, "verse_number": "५-४-३३", "content_sanskrit": "किंचित्स्वदर्शनाद्धृष्टां कृशांगीं तां स शोकभाक् ।\nदुःखस्य समयो नायमिति मत्वा जगाद ताम्॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000545033, "chapter_id": 20545, "verse_number": "५-४-३४", "content_sanskrit": "श्रीराम उवाच ।\nमातर्मया त्वच्चरणौ चिरकालं न सेवितौ ।\nततः क्षमस्वापराधं भाग्यहीनस्य वै मम॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000545034, "chapter_id": 20545, "verse_number": "५-४-३५", "content_sanskrit": "ये पुत्रा मातापित्रोर्न शुश्रूषायां समुत्सुकाः ।\nते मंतव्याः परा मातः कीटका रेतसो भवाः॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000545035, "chapter_id": 20545, "verse_number": "५-४-३६", "content_sanskrit": "किं कुर्वे जनकाज्ञातो गतो वै दंडकं वनम् ।\nतत्रापि त्वत्कृपापांगात्तीर्णोऽस्मि दुःखसागरम्॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000545036, "chapter_id": 20545, "verse_number": "५-४-३७", "content_sanskrit": "रावणेन हृता सीता लंकायां गमिता पुनः ।\nत्वत्कृपातो मया लब्धा तं हत्वा राक्षसेश्वरम्॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000545037, "chapter_id": 20545, "verse_number": "५-४-३८", "content_sanskrit": "सीतेयं त्वच्चरणयोः पतिता वै पतिव्रता ।\nसंभावयाशु चकितां त्वत्पादार्पितमानसाम्॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000545038, "chapter_id": 20545, "verse_number": "५-४-३९", "content_sanskrit": "इति श्रुत्वा तु तद्वाक्यं पादयोः पतितां स्नुषाम् ।\nआशीर्भिरभियुज्यैनां बभाषे तां पतिव्रताम्॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000545039, "chapter_id": 20545, "verse_number": "५-४-४०", "content_sanskrit": "सीते स्वपतिना सार्द्धं चिरं विलस भामिनि ।\nपुत्रौ प्रसूय च कुलं स्वकं पावय पावने॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000545040, "chapter_id": 20545, "verse_number": "५-४-४१", "content_sanskrit": "त्वत्सदृश्यः पतिपराः पतिदुःखसुखानुगाः ।\nभवंति दुःखभागिन्यो न हि सत्यं जगत्त्रये॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000545041, "chapter_id": 20545, "verse_number": "५-४-४२", "content_sanskrit": "विदेहपुत्रि स्वकुलं त्वया पावितमात्मना ।\nरामपादाब्जयुगलमनुयांत्या महावनम्॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000545042, "chapter_id": 20545, "verse_number": "५-४-४३", "content_sanskrit": "किं चित्रं यत्पुमांसस्तु वैरिकोटिप्रभंजनाः ।\nयेषां गेहे सती भार्या स्वपतिप्रियवाञ्छिका॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000545043, "chapter_id": 20545, "verse_number": "५-४-४४", "content_sanskrit": "इत्युक्त्वा रघुनाथस्य भार्यामंचितलोचनाम् ।\nतूष्णीं बभूव हृषिता प्रहृष्टस्वतनूरुहा॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000545044, "chapter_id": 20545, "verse_number": "५-४-४५", "content_sanskrit": "अथ भ्रातास्य भरतः पित्रा दत्तं निजं महत् ।\nराज्यं निवेदयामास रामचंद्राय धीमते॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000545045, "chapter_id": 20545, "verse_number": "५-४-४६", "content_sanskrit": "मंत्रिणस्ते प्रहृष्टांगा दैवज्ञान्मंत्रकोविदान् ।\nआहूय सुमुहूर्तंते पप्रच्छुः परमादरात्॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000545046, "chapter_id": 20545, "verse_number": "५-४-४७", "content_sanskrit": "शुभे मुहूर्ते सुदिने शुभनक्षत्रसंयुते ।\nअभिषेकं महाराज्ये कारयामासुरुद्यताः॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000545047, "chapter_id": 20545, "verse_number": "५-४-४८", "content_sanskrit": "सप्तद्वीपवतीं पृथ्वीं व्याघ्रचर्मणि सुंदरे ।\nलिखित्वोपरि राजेंद्रो महाराजोधितस्थिवान्॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000545048, "chapter_id": 20545, "verse_number": "५-४-४९", "content_sanskrit": "तद्दिनादेव साधूनां मनांसि प्रमुदं ययुः ।\nदुष्टानां चेतसो ग्लानिरभवत्परतापिनाम्॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000545049, "chapter_id": 20545, "verse_number": "५-४-५०", "content_sanskrit": "स्त्रियस्तु पतिभक्त्या च पतिव्रतपरायणाः ।\nमनसापि कदा पापं नाचरंति जना मुने॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000545050, "chapter_id": 20545, "verse_number": "५-४-५१", "content_sanskrit": "दैत्यादेवास्तथा नागा यक्षासुरमहोरगाः ।\nसर्वे न्यायपथे स्थित्वा रामाज्ञां शिरसा दधुः॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000545051, "chapter_id": 20545, "verse_number": "५-४-५२", "content_sanskrit": "परोपकरणेयुक्ताः स्वधर्मसुखनिर्वृताः ।\nविद्याविनोदगमिता दिनरात्रिक्षणाः शुभाः॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000545052, "chapter_id": 20545, "verse_number": "५-४-५३", "content_sanskrit": "वातोऽपि मार्गसंस्थानां बलान्नाहरते महान् ।\nवासांस्यपि तु सूक्ष्माणि तत्र चौरकथा नहि॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000545053, "chapter_id": 20545, "verse_number": "५-४-५४", "content_sanskrit": "धनदो ह्यर्थिनां रामः कारुण्यश्च कृपानिधिः ।\nभ्रातृभिः सहितो नित्यं गुरुदेवस्तुतिं व्यधात्॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]