[{"id": 7002713000, "chapter_id": 22713, "verse_number": "८-२४-१", "content_sanskrit": "सूत उवाच ।\nततस्ते सकला दैत्याः कलिना च पुरस्कृताः ।\nकृत्वा च जलयानानि हरिखण्डमुपाययुः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002713001, "chapter_id": 22713, "verse_number": "८-२४-२", "content_sanskrit": "मनुजा हरिखण्डे च देवतुल्या महाबलाः ।\nअयुध्यंस्तान्महाशस्त्रैरयुताब्दप्रजीविनः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002713002, "chapter_id": 22713, "verse_number": "८-२४-३", "content_sanskrit": "दशवर्षान्तरे सर्वे मायायुद्धैः पराजिताः ।\nमहेन्द्रं शरणं जग्मुर्हरिखण्डनिवासिनः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002713003, "chapter_id": 22713, "verse_number": "८-२४-४", "content_sanskrit": "तदा तु भगवाञ्छक्रो विश्वकर्माणमब्रवीत् ।\nभ्रमिश्च नामयन्त्रोऽयं संस्थितः सप्तसिन्धुषु ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002713004, "chapter_id": 22713, "verse_number": "८-२४-५", "content_sanskrit": "त्वया विरचितस्तात तत्प्रभावान्नरा भुवि ।\nअन्यखण्डे न गच्छन्ति स च यन्त्रस्तु मायिना ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002713005, "chapter_id": 22713, "verse_number": "८-२४-६", "content_sanskrit": "मयेन भ्रंशितो भ्रात्रा म्लेच्छैः सार्द्धं समन्ततः ।\nसप्तद्वीपेषु यास्यन्ति मनुजा मम वैरिणः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002713006, "chapter_id": 22713, "verse_number": "८-२४-७", "content_sanskrit": "अतो नः पाहि मर्यादां भूमध्ये भवता कृताम् ।\nइति श्रुत्वा विश्वकर्मा दिव्ययन्त्रमचीकरत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002713007, "chapter_id": 22713, "verse_number": "८-२४-८", "content_sanskrit": "तेन यन्त्रप्रभावेन भ्रमितास्ते बभूविरे ।\nभ्रमियन्त्रान्महावायुर्ज्जातो म्लेच्छविनाशकः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002713008, "chapter_id": 22713, "verse_number": "८-२४-९", "content_sanskrit": "तद्वायोरभवत्पुत्रो वात्यो वात्यासमुद्भवः ।\nदैत्ययक्षांश्च पैशाचाञ्जित्वा ज्ञानमयो बली ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002713009, "chapter_id": 22713, "verse_number": "८-२४-१०", "content_sanskrit": "ब्राह्मणाः क्षत्रिया वैश्यास्त्रिवर्णास्तेन सत्कृताः ।\nबलान्म्लेच्छान्वर्णमयान्कृत्वा वात्यो महाबलः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002713010, "chapter_id": 22713, "verse_number": "८-२४-११", "content_sanskrit": "शतार्द्धाब्दं मण्डलीकं पदं भुवि गृहीतवान् ।\nतदन्वये सहस्राश्च नृपाश्चासन्कलौ युगे ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002713011, "chapter_id": 22713, "verse_number": "८-२४-१२", "content_sanskrit": "वायुपक्षास्त्रिवर्णाढ्याः षोडशाब्दसहस्रके ।\nवायोर्जातः स्वयं ब्रह्मा वायोर्जातः स वै हरिः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002713012, "chapter_id": 22713, "verse_number": "८-२४-१३", "content_sanskrit": "वायोर्जातो महादेवः सर्वं वायुमयं जगत् ।\nविना वायुं मृताः सर्वे वायुना भुवि जीविनः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002713013, "chapter_id": 22713, "verse_number": "८-२४-१४", "content_sanskrit": "इति मत्वा तु ते लोका वायुं च समतर्पयन् ।\nपुनस्तदा कलिर्घोरो दैत्यराजं बलिं प्रभुम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002713014, "chapter_id": 22713, "verse_number": "८-२४-१५", "content_sanskrit": "नत्वा निवेदयामास दुःखितोऽभूत्तदा बलिः ।\nवामनान्तिकमागम्य कलिमित्रेण संयुतः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002713015, "chapter_id": 22713, "verse_number": "८-२४-१६", "content_sanskrit": "नत्वोवाच स वै राजा देवदेवं जनार्दनम् ।\nत्वया कलिः कृतो मह्यं प्रसन्नेन सुरोत्तम ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002713016, "chapter_id": 22713, "verse_number": "८-२४-१७", "content_sanskrit": "वात्यैर्द्विजैः कर्मभूमेः कलिस्तु स निराकृतः ।\nएकपादो व्यतीतोऽयं किञ्चिदूनं कलेः प्रभोः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002713017, "chapter_id": 22713, "verse_number": "८-२४-१८", "content_sanskrit": "मया सम्यक्तु वै भुक्ता भूमिर्देवेन्द्रमायया ।\nसहस्राब्दं कलौ प्राप्ते मया भुक्तं महीतलम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002713018, "chapter_id": 22713, "verse_number": "८-२४-१९", "content_sanskrit": "ततः सार्द्धं सहस्राब्दं देवैर्भुक्तं सुरस्थलम् ।\nततः पंचशतं वर्षं किञ्चिदधिकमेव च ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002713019, "chapter_id": 22713, "verse_number": "८-२४-२०", "content_sanskrit": "मया भुक्ता कर्मभूमिः सर्वलोकस्य कारणात् ।\nततः सार्द्धं सहस्राब्दं देवैर्भुक्तेयमुत्तमा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002713020, "chapter_id": 22713, "verse_number": "८-२४-२१", "content_sanskrit": "ततः सार्द्धसहस्राब्दं किञ्चिदूनं मया धृता ।\nसार्द्धत्रिंशत्सहस्राब्दं देवैर्देत्यैस्तथा मही ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002713021, "chapter_id": 22713, "verse_number": "८-२४-२२", "content_sanskrit": "भुक्ता दैत्यैः पुनर्देवैः तथा देवैश्च दानवैः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002713022, "chapter_id": 22713, "verse_number": "८-२४-२३", "content_sanskrit": "त्वया दत्तो हि मे देव कलिः कलिविनाशन ।\nनाधिकारं कृतं नाथ सत्यं सत्यप्रियक्षम ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002713023, "chapter_id": 22713, "verse_number": "८-२४-२४", "content_sanskrit": "इति श्रुत्वा बलेर्वाक्यं भगवान्वामनो हरिः ।\nस्वांशान्महीतले प्राप्तो दैत्यपक्षविवर्धनः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002713024, "chapter_id": 22713, "verse_number": "८-२४-२५", "content_sanskrit": "कामशर्मा तदा विप्रो यमुनातटसंस्थितः ।\nहरिं तुष्टाव मनसा द्वादशाब्दं प्रयत्नतः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002713025, "chapter_id": 22713, "verse_number": "८-२४-२६", "content_sanskrit": "तदा तु वामनः श्रीमान्वचः प्राह द्विजोत्तमम् ।\nवरं ब्रूहि द्विजश्रेष्ठ यत्ते मनसि संस्थितम् ।\nइति श्रुत्वा कामशर्मा तुष्टाव श्लक्ष्णया गिरा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002713026, "chapter_id": 22713, "verse_number": "८-२४-२७", "content_sanskrit": "कामशर्मोवाच ।\nनमो देवाय महते सर्वपूज्याय ते नमः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002713027, "chapter_id": 22713, "verse_number": "८-२४-२८", "content_sanskrit": "धर्मप्रियाय धर्माय देवदैत्यकराय च ।\nदैवाधीननृणां भर्त्रे कर्मकर्त्रे नमो नमः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002713028, "chapter_id": 22713, "verse_number": "८-२४-२९", "content_sanskrit": "दैवाधीनाश्च ते देवा दैवोल्लङ्घाश्च दानवाः ।\nतेषां भर्त्ता क्रमाद्धर्ता तस्मै देवाय ते नमः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002713029, "chapter_id": 22713, "verse_number": "८-२४-३०", "content_sanskrit": "पुत्रो भव हरे स्वामिन्सफलं वाञ्छितं कुरु ।\nइति श्रुत्वा हरिः साक्षाद्वामनो बलिरक्षकः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002713030, "chapter_id": 22713, "verse_number": "८-२४-३१", "content_sanskrit": "स्वपूर्वार्द्धाद्देवहूत्यां तत्पत्न्यां च समुद्भवः ।\nद्विधा भूत्वा मही जातौ दिव्याङ्गौ दिव्यविग्रहौ ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002713031, "chapter_id": 22713, "verse_number": "८-२४-३२", "content_sanskrit": "भोगसिहः केलिसिंह देवपो दैत्यपो हरिः ।\nजित्वा वात्योद्भवान्भूपात्कल्पक्षेत्रमुपस्थितः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002713032, "chapter_id": 22713, "verse_number": "८-२४-३३", "content_sanskrit": "रहः क्रीडावती नाम नगरी मयनिर्मिता ।\nतत्रोष्य बलवन्तौ तौ दधतुश्च कलेर्धुरम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002713033, "chapter_id": 22713, "verse_number": "८-२४-३४", "content_sanskrit": "पत्नीयं सर्वधर्माणां सारभूता सनातनी ।\nपतिव्रतायां ये जाता नरा आर्याः सुरप्रियाः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002713034, "chapter_id": 22713, "verse_number": "८-२४-३५", "content_sanskrit": "दूषितायां नरा जातास्ते सर्वे वर्णसङ्कराः ।\nइति सञ्चिन्त्य भगवान्कृत्वा काममयं वपुः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002713035, "chapter_id": 22713, "verse_number": "८-२४-३६", "content_sanskrit": "दिने दिने सहस्राणि योषितो बुभुजे हरिः ।\nताः सर्वा गर्भमाधाय यमौ सुषुविरे मुदा ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002713036, "chapter_id": 22713, "verse_number": "८-२४-३७", "content_sanskrit": "नार्या तया सहोदर्या रेमिरे ते सहोदराः ।\nएवं च बहुधा सृष्टिस्तेषां जाता कलौ युगे ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002713037, "chapter_id": 22713, "verse_number": "८-२४-३८", "content_sanskrit": "पूर्वजातास्त्रिवर्णाश्च भक्षयित्वा दिनेदिने ।\nकर्मभूम्यां ववृधिरे पक्षिणश्च यथा द्रुमे ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002713038, "chapter_id": 22713, "verse_number": "८-२४-३९", "content_sanskrit": "उभयाब्दसहस्रान्ते तैरन्नाः पूर्वमानवाः ।\nतदा कलेश्च चरणो द्वितीयो भुवि चागमत् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002713039, "chapter_id": 22713, "verse_number": "८-२४-४०", "content_sanskrit": "साम्प्रतं वर्तते वार्ता किन्नराणां च भूतले ।\nद्विकिष्कुमात्राश्च नराः सार्द्धा दैत्यमयाः स्मृताः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002713040, "chapter_id": 22713, "verse_number": "८-२४-४१", "content_sanskrit": "यथा खगाः कर्महीनाश्चत्वारिंशाब्दजीविनः ।\nभूमिगाश्च तथा ते वै भेदं तेष्वेषु नैव भोः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002713041, "chapter_id": 22713, "verse_number": "८-२४-४२", "content_sanskrit": "दृश्यन्ते चाद्य युष्माभिर्भूतले किन्नरा नराः ।\nद्वितीयचरणान्ते च भविष्यन्त्येवमेव हि ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002713042, "chapter_id": 22713, "verse_number": "८-२४-४३", "content_sanskrit": "न विवाहो न भूपश्च नोद्यमो न हि कर्मकृत् ।\nभविता च तदा तेषां द्वितीयचरणान्तिके ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002713043, "chapter_id": 22713, "verse_number": "८-२४-४४", "content_sanskrit": "सपादलक्षाब्दमितमद्यप्रभृति भो द्विजाः ।\nभोगकेल्यन्वयोद्भूता भविष्यन्ति महीतले ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002713044, "chapter_id": 22713, "verse_number": "८-२४-४५", "content_sanskrit": "अतो मया च सहिता भवन्तो मुनिसत्तमाः ।\nकृष्णचैतन्यमागम्य गमिष्यामस्तदाज्ञया ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002713045, "chapter_id": 22713, "verse_number": "८-२४-४६", "content_sanskrit": "व्यास उवाच ।\nइति श्रुत्वा तु मुनयो विशालापूर्निवासिनः ।\nभो नमस्ते गमिष्यन्ति यज्ञांशं प्रति हर्षिताः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002713046, "chapter_id": 22713, "verse_number": "८-२४-४७", "content_sanskrit": "नत्वा सर्वे मुनिश्रेष्ठा यज्ञांशं यज्ञरूपिणम् ।\nवचनं च वदिष्यन्ति देह्याज्ञां भगवन्प्रभो ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002713047, "chapter_id": 22713, "verse_number": "८-२४-४८", "content_sanskrit": "इन्द्रलोके गमिष्यामो नाकमध्यं मनोहरम् ।\nइति श्रुत्वा तु यज्ञांशः सर्वशिष्यसमन्वितः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002713048, "chapter_id": 22713, "verse_number": "८-२४-४९", "content_sanskrit": "तैः सर्वैः सह स्वर्लोकं गमिष्यति सुरप्रियः ।\nतदा कलिः समं दैत्यैर्भजिष्यति महीतलम् ।\nकिमन्यच्छ्रोतुमिच्छा ते हृषीकोत्तम तद्वद ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002713049, "chapter_id": 22713, "verse_number": "८-२४-५०", "content_sanskrit": "मनुरुवाच ।\nभगवन्विस्तराद्ब्रूहि भोगकेलिचरित्रकम् ।\nकलौ यथा भविष्यन्ति मनुजास्तत्तथा प्रभो ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7002713050, "chapter_id": 22713, "verse_number": "८-२४-५१", "content_sanskrit": "व्यास उवाच ।\nभोगसिंहे केलिसिंहे वामनांशसमुद्भवे ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7002713051, "chapter_id": 22713, "verse_number": "८-२४-५२", "content_sanskrit": "जित्वा दैत्यान्नरमयान्नरान्वात्योद्भवान्भुवि ।\nवामनांशमुपागम्य हर्षिताः सम्बभूविरे ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7002713052, "chapter_id": 22713, "verse_number": "८-२४-५३", "content_sanskrit": "तदा तु दुःखिता देवास्त्यक्त्वा मूर्तीः समन्ततः ।\nकृष्णचैतन्यमागम्य नत्वोचुर्नतकन्धराः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7002713053, "chapter_id": 22713, "verse_number": "८-२४-५४", "content_sanskrit": "भगवंस्त्वत्प्रसादेन चरणं प्रथमं कलेः ।\nभुक्ता तथा मही स्वामिञ्जित्वा वै दैत्यप्रपूजकान् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7002713054, "chapter_id": 22713, "verse_number": "८-२४-५५", "content_sanskrit": "किं कर्तव्यं च यज्ञांश नमस्ते करुणाकर ।\nइति श्रुत्वा हरिः प्राह तदा शृणुध्वं सुरसत्तमाः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7002713055, "chapter_id": 22713, "verse_number": "८-२४-५६", "content_sanskrit": "अहं स्वर्गं गमिष्यामि भवद्भिः सह हर्षितः ।\nअतो यूयं सुराः सर्वे देववंशान्नरान्सदा ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7002713056, "chapter_id": 22713, "verse_number": "८-२४-५७", "content_sanskrit": "उत्थाप्य शीघ्रमागम्य गच्छध्वं च त्रिविष्टपम् ।\nइति सूतेन कथिते मुनीन्प्रति सुमण्डलम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7002713057, "chapter_id": 22713, "verse_number": "८-२४-५८", "content_sanskrit": "देवा विमानमादाय तत्र यास्यन्ति भो मनः ।\nसूतादींश्च मुनीन्सर्वान्समारुह्य सुरास्तदा ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7002713058, "chapter_id": 22713, "verse_number": "८-२४-५९", "content_sanskrit": "यज्ञांशं च गमिष्यन्ति नदीहोपवने तदा ।\nअह्लादश्च तदा योगी गोरखाद्यास्तथैव च ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7002713059, "chapter_id": 22713, "verse_number": "८-२४-६०", "content_sanskrit": "शङ्कराद्याश्च रुद्रांशा नृपो भर्तृहरिस्तदा ।\nअन्ये तु योगनिष्ठाश्च गमिष्यन्ति हितप्रदाः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7002713060, "chapter_id": 22713, "verse_number": "८-२४-६१", "content_sanskrit": "तैः सार्द्धं कृष्णचैतन्यो देवलोकं गमिष्यति ।\nतदा तौ वामनांशौ च द्वितीयचरणे कलौ ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7002713061, "chapter_id": 22713, "verse_number": "८-२४-६२", "content_sanskrit": "योगनिष्ठां समाधाय कल्पक्षेत्रे वसिष्यतः ।\nतदैव सकला दैत्या हर्षितास्तैर्नृभिर्मुहुः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7002713062, "chapter_id": 22713, "verse_number": "८-२४-६३", "content_sanskrit": "विवरान्वर्द्धयिष्यन्ति पातालाद्यान्समन्ततः ।\nकलेस्तुतीयचरणे सम्प्राप्ते किन्नराश्च ते ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7002713063, "chapter_id": 22713, "verse_number": "८-२४-६४", "content_sanskrit": "शनैःशनैः क्षयं भूमौ गमिष्यन्ति समन्ततः ।\nषड्विंशाब्दसहस्रे च तृतीयचरणे गते ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7002713064, "chapter_id": 22713, "verse_number": "८-२४-६५", "content_sanskrit": "रुद्राज्ञया भृङ्गऋषिर्भूतपक्षो गमिष्यति ।\nसौरभी नाम तत्पत्नी जनिष्यति महाबलान् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7002713065, "chapter_id": 22713, "verse_number": "८-२४-६६", "content_sanskrit": "कौलकल्पान्नरान्घोरान्सर्वकिन्नरभक्षकान् ।\nषड्विंशाब्दवयस्तेषां भविष्यति तदा कलौ ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7002713066, "chapter_id": 22713, "verse_number": "८-२४-६७", "content_sanskrit": "शरणं वामनांशं च गमिष्यन्ति सकिन्नराः ।\nभोगसिहः केलिसिंहस्तैश्च सार्द्धं महद्रणम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7002713067, "chapter_id": 22713, "verse_number": "८-२४-६८", "content_sanskrit": "करिष्यति दशाब्दं च पुनस्तैश्च पराजितौ ।\nदैत्यैः सार्द्धं च पातालं वामनांशो गमिष्यतः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7002713068, "chapter_id": 22713, "verse_number": "८-२४-६९", "content_sanskrit": "भृङ्गसृष्टिर्महाघोरा भविष्यति तदा कलौ ।\nमातृः स्वसुः सुतास्ते वै नराश्च पशुरूपिणः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7002713069, "chapter_id": 22713, "verse_number": "८-२४-७०", "content_sanskrit": "भुक्त्वा प्रीत्या च कामान्धा जनिष्यन्ति सुतान्बहून् ।\nकलेस्तृतीयचरणे समाप्ते तास्तु सृष्टयः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7002713070, "chapter_id": 22713, "verse_number": "८-२४-७१", "content_sanskrit": "तिर्य्यग्योनिधरा घोराः क्षयिष्यन्ति कलौ युगे ।\nकलेश्चतुर्थचरणे सम्प्राप्ते तु तदा नराः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7002713071, "chapter_id": 22713, "verse_number": "८-२४-७२", "content_sanskrit": "विंशदब्दवयस्काश्च मरिष्यन्ति च नारकाः ।\nयथा जलमनुष्याश्च यथैव वनजा नराः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7002713072, "chapter_id": 22713, "verse_number": "८-२४-७३", "content_sanskrit": "कन्दमूलफलाहारा भविष्यन्ति कलौ तदा ।\nआलोका ये तु विख्यातास्तामिस्राद्या भयानकाः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7002713073, "chapter_id": 22713, "verse_number": "८-२४-७४", "content_sanskrit": "ते सर्वे पूर्णमेष्यन्ति कर्मभूमिभवैर्नरैः ।\nयथा सत्यस्य प्रथमे चरणे सत्यलोककः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7002713074, "chapter_id": 22713, "verse_number": "८-२४-७५", "content_sanskrit": "द्वितीये च तपोलोके जनलोकस्तृतीयकः ।\nचतुर्थे स्वर्गलोकश्च पूरितः कर्मभूमिजैः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7002713075, "chapter_id": 22713, "verse_number": "८-२४-७६", "content_sanskrit": "त्रेतायुगाद्यचरणे भुवर्लोकं भुवास्पदम् ।\nस्वर्गलोकं यथा तैश्च मनुजैः पूरितं स्मृतम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7002713076, "chapter_id": 22713, "verse_number": "८-२४-७७", "content_sanskrit": "द्वितीये ऋषिलोकं च तृतीये ग्रहविष्टपम् ।\nचतुर्थे च भुवर्लोकं पूरितं कर्मजैर्नरैः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7002713077, "chapter_id": 22713, "verse_number": "८-२४-७८", "content_sanskrit": "द्वापराद्यपदे पूर्णे भवेद्द्वीपः स पुष्कर ।\nद्वितीये शाल्मलः क्रौञ्चस्तृतीये द्वीपशेषकः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7002713078, "chapter_id": 22713, "verse_number": "८-२४-७९", "content_sanskrit": "जम्बूद्वीपश्चतुर्थे च चरणे मुनिभिः स्मृतः ।\nकलेश्च चरणे चाद्येधश्चोर्ध्वं पूरितं जगत् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7002713079, "chapter_id": 22713, "verse_number": "८-२४-८०", "content_sanskrit": "द्वितीये सप्तपातालस्तृतीये भूतविष्टपम् ।\nपूरितं मनुजैस्तत्र कर्मभूमिसमुद्भवैः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7002713080, "chapter_id": 22713, "verse_number": "८-२४-८१", "content_sanskrit": "तदाद्यनारकास्सर्वे पूर्णमेष्यन्ति तैर्नरैः ।\nइति ते कथितं सर्वं यत्पृष्टोऽहं मनो त्वया ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}]