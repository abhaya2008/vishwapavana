[{"id": 2103072, "chapter_id": 3236, "verse_number": "१४-९२-१", "content_sanskrit": "नकुल उवाच।\nहन्त वः कथयिष्यामि दानस्य फलमुत्तमम्।\nन्यायलब्धस्य सूक्ष्मस्य विप्रदत्तस्य यद्द्विजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2103073, "chapter_id": 3236, "verse_number": "१४-९२-२", "content_sanskrit": "धर्मक्षेत्रे कुरुक्षेत्रे धर्मज्ञैर्बहुभिर्वृते।\nउञ्छवृत्तिर्द्विजः कश्चित्कापोतिरभवत्पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2103074, "chapter_id": 3236, "verse_number": "१४-९२-३", "content_sanskrit": "सभार्यः सहपुत्रेण सस्नुषस्तपसि स्थितः।\nबभूव शुक्लवृत्तः स धर्मात्मा नियतेन्द्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2103075, "chapter_id": 3236, "verse_number": "१४-९२-४", "content_sanskrit": "षष्ठे काले सदा विप्रो भुङ्क्ते तैः सह संवृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2103076, "chapter_id": 3236, "verse_number": "१४-९२-५", "content_sanskrit": "षष्ठे काले कदाचित्तु तस्याहारो न विद्यते।\nभुङ्क्तेऽन्यस्मिन्कदाचित्स षष्ठे काले द्विजोत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2103077, "chapter_id": 3236, "verse_number": "१४-९२-६", "content_sanskrit": "कपोतधर्मिणस्तस्य दुर्भिक्षे सति दारुणे।\nनाविद्यत तदा विप्राः संचयस्तन्निबोधत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2103078, "chapter_id": 3236, "verse_number": "१४-९२-७", "content_sanskrit": "क्षीणाषैदिसमावापो द्रव्यहीनोऽभवत्तदा।\nकालेकालेऽस्य सम्प्राप्ते नैव विद्येत भोजनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2103079, "chapter_id": 3236, "verse_number": "१४-९२-८", "content_sanskrit": "क्षुधापरिगताः सर्वे प्रातिष्ठन्त तदा तु ते।\nउञ्छं तदा शुक्लपक्षे मध्यं तपति भास्करे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2103080, "chapter_id": 3236, "verse_number": "१४-९२-९", "content_sanskrit": "उष्णार्तश्च क्षुधार्तश्च विप्रस्तपसि संस्थितः।\nउञ्छमप्राप्तवानेव ब्राह्मणः क्षुच्छ्रमान्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2103081, "chapter_id": 3236, "verse_number": "१४-९२-१०", "content_sanskrit": "स तथैव क्षुधाविष्टः सार्धं परिजनेन ह।\nक्षपयामास तं कालं कृच्छ्रप्राणो द्विजोत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2103082, "chapter_id": 3236, "verse_number": "१४-९२-११", "content_sanskrit": "अथ षष्ठे गते काले यवप्रस्थमुपार्जयन्।\nयवप्रस्थं तु तं सक्तूनकुर्वन्त तपस्विनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2103083, "chapter_id": 3236, "verse_number": "१४-९२-१२", "content_sanskrit": "कृतजप्याह्निकास्ते तु हुत्वा चाग्निं यथाविधि।\nकुडवंकुडवं सर्वे व्यभजन्त तपस्विनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2103084, "chapter_id": 3236, "verse_number": "१४-९२-१३", "content_sanskrit": "अथागच्छद्द्विजः कश्चिदतिथिर्भुञ्जतां तदा।\nते तं दृष्ट्वाऽतिथिं प्राप्तं प्रहृष्टमनसोऽभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2103085, "chapter_id": 3236, "verse_number": "१४-९२-१४", "content_sanskrit": "तेऽभिवाद्य सुखप्रश्नं पृष्ट्वा तमतिथिं तदा।\nविशुद्धमनसो दान्ताः श्रद्धादमसमन्विताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2103086, "chapter_id": 3236, "verse_number": "१४-९२-१५", "content_sanskrit": "अनसूया गतक्रोधाः साधवो वीतमत्सराः।\nत्यक्तमानमदक्रोधा धर्मज्ञा द्विजसत्तमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2103087, "chapter_id": 3236, "verse_number": "१४-९२-१६", "content_sanskrit": "सब्रह्यचर्यं गोत्रं ते तस्य ख्यात्वा परस्परम्।\nकुटीं प्रवेशयामासुः क्षुधार्तमतिथिं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2103088, "chapter_id": 3236, "verse_number": "१४-९२-१७", "content_sanskrit": "इदमर्घ्यं च पाद्यं च बृसी चेयं तवानघ।\nशुचयः सक्तवश्चेमे नियमोपार्जिताः प्रभो।\nप्रतिगृह्णीष्व भद्रं ते मया दत्ता द्विजर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2103089, "chapter_id": 3236, "verse_number": "१४-९२-१८", "content_sanskrit": "इत्युक्तः प्रतिगृह्याथ सक्तूनां कुडवं द्विजः।\nभक्षयामास राजेन्द्र न च तुष्टिं जगाम सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2103090, "chapter_id": 3236, "verse_number": "१४-९२-१९", "content_sanskrit": "स उञ्छवृत्तिस्तं प्रेक्ष्य क्षुधापरिगतं द्विजम्।\nआहारं चिन्तयामास कथं तुष्टो भवेदिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2103091, "chapter_id": 3236, "verse_number": "१४-९२-२०", "content_sanskrit": "तस्य भार्याऽब्रवीद्वाक्यं मद्भागो दीयतामिति।\nगच्छत्वेष यथाकामं परितुष्टो द्विजोत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2103092, "chapter_id": 3236, "verse_number": "१४-९२-२१", "content_sanskrit": "इति ब्रुवन्तीं तां साध्वीं भार्यां स द्विजसत्तमः।\nक्षउधापरिगतां ज्ञात्वा तान्सक्तून्नाभ्यनन्दत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2103093, "chapter_id": 3236, "verse_number": "१४-९२-२२", "content_sanskrit": "आत्मानुमानतो विद्वान्स तु विप्रर्षभस्तदा।\nजानन्वृद्धां क्षुधार्तां च श्रान्तां ग्लानां तपस्विनीम्।\nत्वगस्थिभूता वेपन्तीं ततो भार्यामुवाच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2103094, "chapter_id": 3236, "verse_number": "१४-९२-२३", "content_sanskrit": "अपि कीटपतङ्गानां मृगाणां चैव शोभने।\nस्त्रियो रक्ष्याश्च पोष्पाश्च न त्वेवं वक्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2103095, "chapter_id": 3236, "verse_number": "१४-९२-२४", "content_sanskrit": "अनुकंप्यो नरः पत्न्या पुष्टो रक्षित एव च।\nप्रपतेद्यशसो दीप्तात्स च लोकान्न चाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2103096, "chapter_id": 3236, "verse_number": "१४-९२-२५", "content_sanskrit": "धर्मकामार्थकार्याणि शुश्रूषाकुलसंततिः।\nदारेष्वदीनो धर्मस्च पितॄणामात्मनस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2103097, "chapter_id": 3236, "verse_number": "१४-९२-२६", "content_sanskrit": "न वेत्ति कर्मतो भार्यारक्षणे योऽक्षमः पुमान्।\nअयशो महदाप्नोति नारकांश्चैव गच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2103098, "chapter_id": 3236, "verse_number": "१४-९२-२७", "content_sanskrit": "इत्युक्ता सा ततः प्राह धर्मार्थौ नौ समौ द्विज।\nसक्तुप्रस्थचतुर्भागं गृहाणेमं प्रसीद मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2103099, "chapter_id": 3236, "verse_number": "१४-९२-२८", "content_sanskrit": "सत्यं रतिश्च धर्मश्च स्वर्गश्च गुणनिर्जितः।\nस्त्रीणां पतिसमाधीनं काङ्क्षितं च द्विजर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2103100, "chapter_id": 3236, "verse_number": "१४-९२-२९", "content_sanskrit": "ऋतुर्मातु पितुर्बीजं दैवतं परमं पतिः।\nभर्तुः प्रसादान्नारीणां रतिपुत्रफलं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2103101, "chapter_id": 3236, "verse_number": "१४-९२-३०", "content_sanskrit": "पालनाद्धि पतिस्त्वं मे भर्ताऽसि भरणाच्च मे।\nपुत्रप्रदानाद्वरदस्तस्मात्सक्तून्प्रयच्छ मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2103102, "chapter_id": 3236, "verse_number": "१४-९२-३१", "content_sanskrit": "जरापरिगतो वृद्धः क्षुधार्तो दुर्बलो भृशम्।\nउपवासपरिश्रान्तो यदा त्वमपि कर्शितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2103103, "chapter_id": 3236, "verse_number": "१४-९२-३२", "content_sanskrit": "इत्युक्तः स तया सक्तून्प्रगृह्येदं वचोऽब्रवीत्।\nद्विजि सक्तूनिमान्भूयः प्रतिगृह्णीष्व सत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2103104, "chapter_id": 3236, "verse_number": "१४-९२-३३", "content_sanskrit": "स तान्प्रगृह्य भुक्त्वा च न तुष्टिमगमद्द्विजः।\nतमुञ्छवृत्तिरालक्ष्य ततश्चिन्तापरोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2103105, "chapter_id": 3236, "verse_number": "१४-९२-३४x", "content_sanskrit": "पुत्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2103106, "chapter_id": 3236, "verse_number": "१४-९२-३४", "content_sanskrit": "सक्तूनिमान्प्रगृह्य त्वं देहि विप्राय सत्तम।\nइत्येव सुकृतं मन्ये तस्मादेतत्करोम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2103107, "chapter_id": 3236, "verse_number": "१४-९२-३५", "content_sanskrit": "भवान्हि परिपाल्यो मे सर्वदैव प्रयत्नतः।\nसाधूनां काङ्क्षितं यस्मात्पितुर्वृद्धस्य पालनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2103108, "chapter_id": 3236, "verse_number": "१४-९२-३६", "content_sanskrit": "पुत्रार्थो विहितो ह्येष वार्धके परिपालनम्॥\nश्रुतिरेषा हि विप्रर्षे त्रिषु लोकेषु शाश्वती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2103109, "chapter_id": 3236, "verse_number": "१४-९२-३७", "content_sanskrit": "प्राणाधारणमात्रेण शक्यं कर्तुं तपस्त्वया।\nप्राणो हि परमो धर्मः स्थितो देहेषु देहिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2103110, "chapter_id": 3236, "verse_number": "१४-९२-३८x", "content_sanskrit": "पितोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2103111, "chapter_id": 3236, "verse_number": "१४-९२-३८", "content_sanskrit": "अपि वर्षसहस्री त्वं बाल एव मतो मम।\nउत्पाद्य पुत्रं हि पिता कृतकृत्यो भवेत्सुतात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2103112, "chapter_id": 3236, "verse_number": "१४-९२-३९", "content_sanskrit": "बालानां क्षुद्बलवती जानाम्येतदहं प्रभो।\nवृद्धोऽहं धारयिष्यामि त्वं बली भव पुत्रक॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2103113, "chapter_id": 3236, "verse_number": "१४-९२-४०", "content_sanskrit": "जीर्णेन वयसा पुत्र न मां क्षुद्बाधतेऽपि च।\nदीर्घकालं तपस्तप्तं न मे मरणतो भयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2103114, "chapter_id": 3236, "verse_number": "१४-९२-४१x", "content_sanskrit": "पुत्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2103115, "chapter_id": 3236, "verse_number": "१४-९२-४१", "content_sanskrit": "अपत्यमस्मि ते पुंसस्त्राणात्पुत्र इति स्मृतः।\nआत्मा पुत्रः स्मृतस्तस्मात्त्राह्यात्मानमिहात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2103116, "chapter_id": 3236, "verse_number": "१४-९२-४२x", "content_sanskrit": "पितोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2103117, "chapter_id": 3236, "verse_number": "१४-९२-४२", "content_sanskrit": "रूपेण सदृशस्त्वं मे शीलेन च दमेन च।\nपरीक्षितश्च बहुधा सक्तूनादद्मि ते सुत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2103118, "chapter_id": 3236, "verse_number": "१४-९२-४३", "content_sanskrit": "इत्युक्त्वाऽऽदाय तान्सक्तून्प्रीतात्मा द्विजसत्तमः।\nप्रहसन्निव विप्राय स तस्मै प्रददौ तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2103119, "chapter_id": 3236, "verse_number": "१४-९२-४४", "content_sanskrit": "भुक्त्वा तानपि सक्तून्स नैव तुष्टो बभूव ह।\nउच्छवृत्तिस्तु धर्मात्मा व्रीडामनुजगाम ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2103120, "chapter_id": 3236, "verse_number": "१४-९२-४५", "content_sanskrit": "तं वै वधूः स्थिता साध्वी ब्राह्मणिप्रियकाम्यया।\nसक्तूनादाय संहृष्टा श्वशुरं वाक्यमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2103121, "chapter_id": 3236, "verse_number": "१४-९२-४६", "content_sanskrit": "संतानात्तव संतानं मम विप्र भविष्यति।\nसक्तूनिमानतिथये गृहीत्वा सम्प्रयच्छ मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2103122, "chapter_id": 3236, "verse_number": "१४-९२-४७", "content_sanskrit": "तव प्रसादान्निर्वृत्ता मम लोकाः किलाक्षयाः।\nपुत्रेण तानवाप्नोति यत्र गत्वा न शोचति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2103123, "chapter_id": 3236, "verse_number": "१४-९२-४८", "content_sanskrit": "धर्माद्या हि यथा त्रेता वह्नित्रेता तथैव च।\nतथैव पुत्रपौत्राणां स्वर्गस्त्रेता किलाक्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2103124, "chapter_id": 3236, "verse_number": "१४-९२-४९", "content_sanskrit": "पितॄणात्तारयति पुत्र इत्यनुशुश्रुम।\nपुत्रपौत्रैश्च नियतं सादुलोकानुपाश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2103125, "chapter_id": 3236, "verse_number": "१४-९२-५०x", "content_sanskrit": "श्वशुर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2103126, "chapter_id": 3236, "verse_number": "१४-९२-५०", "content_sanskrit": "वातातपविशीर्णाङ्गीं त्वां विवर्णां निरीक्ष्य वै।\nकर्शितां सुव्रताचारे क्षुधाविह्वलचेतसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2103127, "chapter_id": 3236, "verse_number": "१४-९२-५१", "content_sanskrit": "कथं सक्तून्ग्रहीष्यामि भूत्वा धर्मोपघातकः।\nकल्याणवृत्ते कल्याणि नैव त्वं वक्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2103128, "chapter_id": 3236, "verse_number": "१४-९२-५२", "content_sanskrit": "षष्ठे काले व्रतवतीं शौचशीलतपोन्विताम्।\nकृच्छ्रवृत्तिं निराहारां द्रक्ष्यामि त्वां कथं शुभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2103129, "chapter_id": 3236, "verse_number": "१४-९२-५३", "content_sanskrit": "बाला क्षुधार्ता नारी च रक्ष्या त्वं सततं मया।\nउपवासपरिश्रान्ता त्वं हि बान्धवनन्दिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2103130, "chapter_id": 3236, "verse_number": "१४-९२-५४x", "content_sanskrit": "स्नुषोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2103131, "chapter_id": 3236, "verse_number": "१४-९२-५४", "content_sanskrit": "गुरोर्मम गुरुस्त्वं वै यतो दैवतदैवतम्।\nदेवातिदेवस्तस्मात्त्वं सक्तूनादत्स्व मे प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2103132, "chapter_id": 3236, "verse_number": "१४-९२-५५", "content_sanskrit": "देहः प्राणश्च धर्मश्च शुश्रूषार्थमिदं गुरोः।\nतव विप्र प्रसादेन लोकान्प्राप्स्यामहे शुभान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2103133, "chapter_id": 3236, "verse_number": "१४-९२-५६", "content_sanskrit": "अवेक्ष्या इति कृत्वाऽहं दृढभक्तेति वा द्विज।\nचिन्त्या ममेयमिति वा सक्तूनादानुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2103134, "chapter_id": 3236, "verse_number": "१४-९२-५७x", "content_sanskrit": "श्वशुर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2103135, "chapter_id": 3236, "verse_number": "१४-९२-५७", "content_sanskrit": "अनेन नित्यं साध्वी त्वं शीलवृत्तेन शोभसे।\nया त्वं धर्मव्रतोपेता गुरुवृत्तिमवेक्षसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2103136, "chapter_id": 3236, "verse_number": "१४-९२-५८", "content_sanskrit": "तस्मात्सक्तून्ग्रहीष्यामि वधु नार्हसि वञ्चनाम्।\nगणयित्वा महाभागे त्वां हि धर्मभृतां वरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2103137, "chapter_id": 3236, "verse_number": "१४-९२-५९", "content_sanskrit": "इत्युक्त्वा तानुपादाय सक्तून्प्रादाद्द्विजातये।\nततस्तुष्टोऽभवद्विप्रस्तस्य साधोर्महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2103138, "chapter_id": 3236, "verse_number": "१४-९२-६०", "content_sanskrit": "प्रीतात्मा स तु तं वाक्यमिदमाह द्विजर्षभम्।\nवाग्मी तदा द्विजश्रेष्टो धर्मः पुरुषविग्रहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2103139, "chapter_id": 3236, "verse_number": "१४-९२-६१", "content_sanskrit": "शुद्धेनि तव दानेन न्यायोपात्तेन धर्मतः।\nयथाशक्ति विसृष्टेन प्रीतोस्मि द्विजसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2103140, "chapter_id": 3236, "verse_number": "१४-९२-६२", "content_sanskrit": "अहो दानं घुष्यते ते स्वर्गे स्वर्गनिवासिभिः।\nगगनात्पुष्पवर्षं च पश्येदं पतितं भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2103141, "chapter_id": 3236, "verse_number": "१४-९२-६३", "content_sanskrit": "सुरर्षिदेवगन्धर्वा ये च देवपुरःसराः।\nस्तुवन्तो देवदूताश्च स्थिता दानेन विस्मिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2103142, "chapter_id": 3236, "verse_number": "१४-९२-६४", "content_sanskrit": "ब्रह्मर्षयो विमानस्था ब्रह्मलोकचरश्च ये।\nकाङ्क्षन्ते दर्शनं तुभ्यं दिवं व्रज द्विजर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2103143, "chapter_id": 3236, "verse_number": "१४-९२-६५", "content_sanskrit": "पितृलोकगताः सर्वे तारिताः पितरस्त्वया।\nअनागताश्च बहवः सुबहूनि युगान्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2103144, "chapter_id": 3236, "verse_number": "१४-९२-६६", "content_sanskrit": "ब्रह्मचर्येण दानेन यज्ञेनि तपसा तथा।\nअगह्वरेण धर्मेण तस्माद्गच्च दिवं द्विज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2103145, "chapter_id": 3236, "verse_number": "१४-९२-६७", "content_sanskrit": "श्रद्धया परया यरत्वं तपश्चरसि सुव्रत।\nतस्माद्देवास्तवानेन प्रीता ब्राह्मणसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2103146, "chapter_id": 3236, "verse_number": "१४-९२-६८", "content_sanskrit": "सर्वमेतद्धि यस्मात्ते दत्तं शुद्धेन चेतसा।\nकृच्छ्रकाले ततः स्वर्गो विजितः कर्मणा त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2103147, "chapter_id": 3236, "verse_number": "१४-९२-६९", "content_sanskrit": "क्षुधा निर्णुदति प्रज्ञां धर्मबुद्धिं व्यपोहति।\nक्षुधापरिगतज्ञानो धृतिं त्यजति चैव ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2103148, "chapter_id": 3236, "verse_number": "१४-९२-७०", "content_sanskrit": "बुभुक्षां जयते यस्तु स स्वर्गं जयते ध्रुवम्।\nयदा दानरुचिः स्याद्वै तदा धर्मो न सीदति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2103149, "chapter_id": 3236, "verse_number": "१४-९२-७१", "content_sanskrit": "अनवेक्ष्य सुतस्नेहं कलत्रस्नेहमेव च।\nधर्ममेव गुरं ज्ञात्वा तृष्णा न गणिता त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2103150, "chapter_id": 3236, "verse_number": "१४-९२-७२", "content_sanskrit": "द्रव्यागमो नृणां सूक्ष्मः पात्रे दानं ततः परम्।\nकालः परतरो दानाच्छ्रद्धा चैव ततः परा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2103151, "chapter_id": 3236, "verse_number": "१४-९२-७३", "content_sanskrit": "स्वर्गद्वारं सुसूक्ष्मं हि नरैर्माहान्नि दृश्यते।\nसङ्गर्गलं लोभकीलं रागगुप्तं दुरासदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2103152, "chapter_id": 3236, "verse_number": "१४-९२-७४", "content_sanskrit": "तं तु पश्यन्ति पुरुषा जितदक्रोधा जितेन्द्रियाः।\nब्राह्मणास्तपसा युक्ता यथाशक्ति प्रदायिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2103153, "chapter_id": 3236, "verse_number": "१४-९२-७५", "content_sanskrit": "सहस्रशक्तिश्च शतं शतशक्तिर्दशापि च।\nदद्यादपश्च यः शक्त्या सर्वे तुल्यफलाः स्मृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2103154, "chapter_id": 3236, "verse_number": "१४-९२-७६", "content_sanskrit": "रन्तिदेवो हि नृपतिरपः प्रादादकिंचनः।\nशुद्धेन मनसा विप्र नाकपृष्ठं ततो गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2103155, "chapter_id": 3236, "verse_number": "१४-९२-७७", "content_sanskrit": "न धर्मः प्रीयते तात दानैर्दत्तैर्महाफलैः।\nन्यायलब्धैर्यथा सूक्ष्मैः श्रुद्धापूतैः स तुष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2103156, "chapter_id": 3236, "verse_number": "१४-९२-७८", "content_sanskrit": "गोप्रदानसहस्राणि द्विजेभ्योऽदान्नृगो नृपः।\nएकां दत्त्वा स पारक्यां नरकं समपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2103157, "chapter_id": 3236, "verse_number": "१४-९२-७९", "content_sanskrit": "आत्ममांसप्रदानेन शिबोरौशीनरो नृपः।\nप्राप्य पुण्यकृताँल्लोकान्मोदत दिवि सुव्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2103158, "chapter_id": 3236, "verse_number": "१४-९२-८०", "content_sanskrit": "विभवेन नृणां पुण्यं यच्छत्त्या स्वार्जितं न तत्।\nन यज्ञैर्विविधैर्विप्र यथान्यायेन संचितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2103159, "chapter_id": 3236, "verse_number": "१४-९२-८१", "content_sanskrit": "क्रोधाद्दानफलं हन्ति लोभात्स्वर्गं न गच्छति।\nन्यायवृत्तिर्हि तपसा दानवित्स्वर्गमश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2103160, "chapter_id": 3236, "verse_number": "१४-९२-८२", "content_sanskrit": "न राजसूयैर्बहुभिरिष्टा विपुलदक्षिणैः॥\nन चाश्वमेधैर्बहुभिः फलं सममिदं तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2103161, "chapter_id": 3236, "verse_number": "१४-९२-८३", "content_sanskrit": "सक्तुप्रस्थेन विजितो ब्रह्मलोकस्त्वयाऽक्षयः।\nविरजो ब्रह्मसदनं गच्छ विप्र यतासुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2103162, "chapter_id": 3236, "verse_number": "१४-९२-८४", "content_sanskrit": "सर्वेषां वो द्विजश्रेष्ठ दिव्यं यानमुपस्थितम्।\nआरोहत यथाकामं धर्मोस्मि द्विज पश्य माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2103163, "chapter_id": 3236, "verse_number": "१४-९२-८५", "content_sanskrit": "बाधितो हि त्वया देहो लोके कीर्तिः स्थिरा च ते।\nसभार्यः सहपुत्रश्च सस्नुषश्च दिवं व्रज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2103164, "chapter_id": 3236, "verse_number": "१४-९२-८६", "content_sanskrit": "इत्युक्तवाक्ये धर्मे तु यानमारुद्य स द्विजः।\nसदारः ससुतश्चैव सस्नुषश्च दिवं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2103165, "chapter_id": 3236, "verse_number": "१४-९२-८७", "content_sanskrit": "तस्मिन्विपरे गते स्वर्गं ससुते सस्नुषे तदा।\nभार्याचतुर्थे धर्मज्ञे ततोऽहं निःसृतो बिलात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2103166, "chapter_id": 3236, "verse_number": "१४-९२-८८", "content_sanskrit": "ततस्तु सक्तुगन्धेन क्लेदेन सलिलस्य च।\nदिव्यपुष्पविमर्दाच्च साधोर्दानलवैश्च तैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2103167, "chapter_id": 3236, "verse_number": "१४-९२-८९", "content_sanskrit": "विप्रस्य तपसा तस्य शिरो मे काञ्चनीकृतम्।\nतस्य सत्याभिसन्धस्य सक्तुदानेन चैव ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2103168, "chapter_id": 3236, "verse_number": "१४-९२-९०", "content_sanskrit": "शरीरार्धं च मे विप्राः शातकुंभमयं कृतम्।\nपश्यतेमं सुविपुलं तपसा तस्य धीमतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2103169, "chapter_id": 3236, "verse_number": "१४-९२-९१", "content_sanskrit": "कथमेवंविधं स्याद्वै पार्श्वमन्यदिति द्विजाः।\nतपोवनानि यज्ञांश्च हृष्टोऽभ्योमि पुनः पुनः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2103170, "chapter_id": 3236, "verse_number": "१४-९२-९२", "content_sanskrit": "यज्ञं त्वहमिमं श्रुत्वा रुरुराजस्य धीमतः।\nआशया परया प्राप्तो न चाहं काञ्चनीकृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2103171, "chapter_id": 3236, "verse_number": "१४-९२-९३", "content_sanskrit": "ततो मयोक्तं तद्वाक्यं प्रहस्य ब्राह्मणर्षभाः।\nसक्तुप्रस्थेन यज्ञोऽयं संमितो नेति सर्वथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2103172, "chapter_id": 3236, "verse_number": "१४-९२-९४", "content_sanskrit": "सक्तुप्रस्थलवैस्तैर्हि तदाऽहं काञ्चनीकृतः।\nन हि यज्ञो महानेष सदृशस्तैर्मतो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2103173, "chapter_id": 3236, "verse_number": "१४-९२-९५", "content_sanskrit": "इत्युक्त्वा नकुलः सर्वान्यज्ञे द्विजवरांस्तदा।\nजगामादर्सनं तेषां विप्रास्ते च ययुर्गृहान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2103174, "chapter_id": 3236, "verse_number": "१४-९२-९६", "content_sanskrit": "एतत्ते सर्वमाख्यातं मया परपुरंजय।\nयदाश्चर्यमभूत्तत्र वाचिमेधे महाक्रतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2103175, "chapter_id": 3236, "verse_number": "१४-९२-९७", "content_sanskrit": "न विस्मयस्ते नृपते यज्ञे कार्यः कथञ्चन।\nऋषिकोटिसहस्राणि तपोभिर्ये दिवं गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2103176, "chapter_id": 3236, "verse_number": "१४-९२-९८", "content_sanskrit": "अद्रोहः सर्वभूतेषु संतोषः शीलमार्जवम्।\nतपो दमश्च सत्यं च प्रदानं चेति संमितम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2103177, "chapter_id": 3236, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि द्विनवतितमोऽध्यायः॥ ९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}]