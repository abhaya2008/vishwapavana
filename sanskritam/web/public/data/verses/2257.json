[{"id": 2058143, "chapter_id": 2257, "verse_number": "७-१८४-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2058144, "chapter_id": 2257, "verse_number": "७-१८४-१", "content_sanskrit": "कर्णदुर्योधनादीनां शकुनेः सौबलस्य च।\nअपनीतं महत्तात तव चैव विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2058145, "chapter_id": 2257, "verse_number": "७-१८४-२", "content_sanskrit": "यदि जानीथ तां शक्तिमेकघ्नीं सततं रणे।\nअनिवार्यामसह्यां च देवैरपि सवासवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2058146, "chapter_id": 2257, "verse_number": "७-१८४-३", "content_sanskrit": "सा किमर्थं तु कर्णेन प्रवृत्ते समरे पुरा।\nन देवकीसुते मुक्ता फल्गुने वाऽपि सञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2058147, "chapter_id": 2257, "verse_number": "७-१८४-४x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2058148, "chapter_id": 2257, "verse_number": "७-१८४-४", "content_sanskrit": "सङ्ग्रामाद्विनिवृत्तानां सर्वेषां नो विशाम्पते।\nरात्रौ कुरुकुलश्रेष्ठ मन्त्रोऽयं समजायत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2058149, "chapter_id": 2257, "verse_number": "७-१८४-५", "content_sanskrit": "प्रभातमात्रे श्वोभूते केशवायार्जुनाय वा।\nशक्तिरेषा हि मोक्तव्या कर्णकर्णेनि नित्यशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2058150, "chapter_id": 2257, "verse_number": "७-१८४-६", "content_sanskrit": "ततः प्रभातसमये राजन्कर्णस्य दैवतैः।\nअन्येषां चैव योधानां सा बुद्धिर्नाश्यते पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2058151, "chapter_id": 2257, "verse_number": "७-१८४-७", "content_sanskrit": "दैवमेव परं मन्ये यत्कर्णो हस्तसंस्थया।\nन जघान रणे पार्थं कृष्णं वा देवकीसुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2058152, "chapter_id": 2257, "verse_number": "७-१८४-८", "content_sanskrit": "तस्य हस्तस्थिता शक्तिः कालरात्रिरिवोद्यता।\nदैवोपहतबुद्धित्वान्न तां कर्णो विमुक्तवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2058153, "chapter_id": 2257, "verse_number": "७-१८४-९", "content_sanskrit": "कृष्णे वा देवकीपुत्रे मोहितो देवमायया।\nपार्थे वा शक्रकल्पे वै वधार्थं वासवीं प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2058154, "chapter_id": 2257, "verse_number": "७-१८४-१०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2058155, "chapter_id": 2257, "verse_number": "७-१८४-१०", "content_sanskrit": "दैवेनोपहता यूयं स्वबुद्ध्या केशवस्य च।\nगता हि वासवी हत्वा तृणभूतं घटोत्कचम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2058156, "chapter_id": 2257, "verse_number": "७-१८४-११", "content_sanskrit": "कर्णश्च मम पुत्राश्च सर्वे चान्ये च पार्थिवाः।\nतेन वै दुष्प्रणीतेन गता वैवस्वतक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2058157, "chapter_id": 2257, "verse_number": "७-१८४-१२", "content_sanskrit": "भूय एव तु मे शंस यथा युद्धमवर्तत।\nकृरूणां पाण्डवानां च हैडिम्बौ निहते तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2058158, "chapter_id": 2257, "verse_number": "७-१८४-१३", "content_sanskrit": "ये च तेऽभ्यद्रवन्द्रोणं व्यूढानीकाः प्रहारिणः।\nसृञ्जयाः सह पाञ्चालैस्तेऽप्यकुर्वन्कथं रणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2058159, "chapter_id": 2257, "verse_number": "७-१८४-१४", "content_sanskrit": "सौमदत्तेर्वधाद्द्रोणमायान्तं सैन्धवस्य च।\nअमर्षाज्जीवितं त्यक्त्वा गाहमानं वरूथिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2058160, "chapter_id": 2257, "verse_number": "७-१८४-१५", "content_sanskrit": "जृम्भमाणमिव व्याघ्रं व्यात्ताननमिवान्तकम्।\nकथं प्रत्युद्ययुर्द्रोणमस्यन्तं पाण्डुसृञ्जयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2058161, "chapter_id": 2257, "verse_number": "७-१८४-१६", "content_sanskrit": "आचार्यं ये च तेऽरक्षन्दुर्योधनपुरोगमाः।\nद्रौणिकर्णकृपास्तात ते वाऽकुर्वन्किमाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2058162, "chapter_id": 2257, "verse_number": "७-१८४-१७", "content_sanskrit": "भारद्वाजं जिघांसन्तौ सव्यसाचिवृकीदरौ।\nसमार्च्छन्मामका युद्धे कथं सञ्जय शंस मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2058163, "chapter_id": 2257, "verse_number": "७-१८४-१८", "content_sanskrit": "सिन्धुराजवधेनेमे घटोत्कचवधेन ते।\nअमर्पिताः सुसङ्क्रुद्धा रणं चक्रुः कथं निशि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2058164, "chapter_id": 2257, "verse_number": "७-१८४-१९x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2058165, "chapter_id": 2257, "verse_number": "७-१८४-१९", "content_sanskrit": "हते घटोत्कचे राजन्कर्णेन निशि राक्षसे।\nप्रणदत्सु च हृष्टेषु तावकेषु युयुत्सुषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2058166, "chapter_id": 2257, "verse_number": "७-१८४-२०", "content_sanskrit": "आपतत्सु च वेगेन वध्यमाने बलेऽपि च।\nविगाढायां रजन्यां च राजा दैन्यं परं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2058167, "chapter_id": 2257, "verse_number": "७-१८४-२१", "content_sanskrit": "अब्रवीच्च महाबाहुर्भीमसेनमिदं वचः।\nआवारय महाबाहो धार्तराष्ट्रस्य वाहिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2058168, "chapter_id": 2257, "verse_number": "७-१८४-२२", "content_sanskrit": "हैडिम्बेश्चैव घातेन मोहो मामाविशन्महान्।\nएवं भीमं समादिश्य स्वरथे समुपाविशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2058169, "chapter_id": 2257, "verse_number": "७-१८४-२३", "content_sanskrit": "अश्रुपूर्णमुखो राजा निःश्वसंश्च पुनःपुनः।\nकश्मलं प्राविशद्धोरं दृष्ट्वा कर्णस्य विक्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2058170, "chapter_id": 2257, "verse_number": "७-१८४-२४", "content_sanskrit": "तं तथा व्यथितं दृष्ट्वा कृष्णो वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2058171, "chapter_id": 2257, "verse_number": "७-१८४-२५", "content_sanskrit": "मा व्यथां कुरु कौन्तेय नैतत्त्वय्युपपद्यते।\nवैक्लव्यं भरतश्रेष्ठ यथा प्राकृतपूरुषे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2058172, "chapter_id": 2257, "verse_number": "७-१८४-२६", "content_sanskrit": "उत्तिष्ठ राजन्युध्वस्व वह गुर्वीं धुरं विभो।\nत्वयि वैक्लव्यमापन्ने संशयो विजये भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2058173, "chapter_id": 2257, "verse_number": "७-१८४-२७", "content_sanskrit": "श्रुत्वा कृष्णस्य वचनं धर्मराजो युधिष्ठिरः।\nविमृज्य नेत्रे पाणिभ्यां कृष्णं वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2058174, "chapter_id": 2257, "verse_number": "७-१८४-२८", "content_sanskrit": "विदिता मे महाबाहो धर्माणां परमा गतिः।\nब्रह्महत्याफलं तस्य यः कृतं नावबुध्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2058175, "chapter_id": 2257, "verse_number": "७-१८४-२९", "content_sanskrit": "अस्माकं हि वनस्थानां हैडिम्बेन महात्सना।\nबालेनापि सता तेन कृतं साह्यं जनार्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2058176, "chapter_id": 2257, "verse_number": "७-१८४-३०", "content_sanskrit": "अस्त्रहेतोर्गतं ज्ञात्वा पाण्डवं स्वेतवाहनम्।\nअसौ कृष्ण महेष्वासः काम्यके मामुपस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2058177, "chapter_id": 2257, "verse_number": "७-१८४-३१", "content_sanskrit": "उषितश्च सहास्माभिर्यावन्नासीद्धनञ्जयः।\nगन्धमादनयात्रायां दुर्गेभ्यश्च स्म तारिताः।\nपाञ्चाली च परिश्रान्ता पृष्ठेनोढा महात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2058178, "chapter_id": 2257, "verse_number": "७-१८४-३२", "content_sanskrit": "आरम्भांश्चैव युद्धानां यदेष कृतवान्प्रभो।\nमदर्थे दुष्करं कर्म कृतं तेन महाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2058179, "chapter_id": 2257, "verse_number": "७-१८४-३३", "content_sanskrit": "स्वभावाद्या च मे प्रीतिः सहदेवे जनार्दन।\nसैव मे द्विगुणा प्रीती राक्षसेन्द्रे घटोत्कचे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2058180, "chapter_id": 2257, "verse_number": "७-१८४-३४", "content_sanskrit": "भक्तश्च मेहाबाहुः प्रियोऽस्याहं प्रियश्च मे।\nतेन विन्दामि वार्ष्णेय कश्मलं शोकतापिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2058181, "chapter_id": 2257, "verse_number": "७-१८४-३५", "content_sanskrit": "पश्य सैन्यानि वार्ष्णेय द्राव्यमाणानि कौरवैः।\nद्रोणकर्णौ तु संयत्तौ पश्य युद्धे महारथौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2058182, "chapter_id": 2257, "verse_number": "७-१८४-३६", "content_sanskrit": "निशीथे पाण्डवं सैन्यमाभ्यां माधव मर्दितम्।\nगजाभ्यामिव मत्ताभ्यां यथा नलवनं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2058183, "chapter_id": 2257, "verse_number": "७-१८४-३७", "content_sanskrit": "अनादृत्य बलं बाह्वोर्भीमसेनस्य माधव।\nचित्रास्त्रतां च पार्थस्य विक्रमन्ते च कौरवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2058184, "chapter_id": 2257, "verse_number": "७-१८४-३८", "content_sanskrit": "एष द्रोणश्च कर्णश्च राजा चैव सुयोधनः।\nनिहत्य राक्षसं युद्धे हृष्टा नर्दन्ति संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2058185, "chapter_id": 2257, "verse_number": "७-१८४-३९", "content_sanskrit": "कथं वाऽसमासु जीवत्सु त्वयि चैव जनार्दन।\nहैडिम्बिः प्राप्तवान्मृत्यं सूतपुत्रेण सङ्गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2058186, "chapter_id": 2257, "verse_number": "७-१८४-४०", "content_sanskrit": "कदर्थीकृत्य नः सर्वान्पश्यतः सव्यसाचिनः।\nनिहतो राक्षसः कृष्ण भैमसेनिर्महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2058187, "chapter_id": 2257, "verse_number": "७-१८४-४१", "content_sanskrit": "यदाऽभिमन्युर्निहतो धार्तराष्ट्रैर्दुरात्मभिः।\nनासीत्तत्र रणे कृष्ण सव्यसाची महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2058188, "chapter_id": 2257, "verse_number": "७-१८४-४२", "content_sanskrit": "निरुद्वाश्च वयं सर्वे सैन्धवेन दुरात्मना।\nनिमित्तमभवद्द्रोणः सपुत्रस्तत्र कर्मणि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2058189, "chapter_id": 2257, "verse_number": "७-१८४-४३", "content_sanskrit": "उपदिष्टो वधोपायः कर्णस्य गुरुणा स्वयम्।\nव्यायच्छतश्च खङ्गेन द्विधा खङ्गं चकार ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2058190, "chapter_id": 2257, "verse_number": "७-१८४-४४", "content_sanskrit": "व्यसने वर्तमानस्य कृतवर्मा नृशंसवत्।\nअश्वाञ्जघान सहसा तथोभौ पार्ष्णिसारथी।\nतथेतरे महेष्वासाः सौभद्रं युध्यपातयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2058191, "chapter_id": 2257, "verse_number": "७-१८४-४५", "content_sanskrit": "अल्पे च कारणे कृष्ण हतो गाण्डीवधन्वना।\nसैन्धवो यादवश्रेष्ठ तच्च नातिप्रियं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2058192, "chapter_id": 2257, "verse_number": "७-१८४-४६", "content_sanskrit": "यदि शत्रुवधो न्याय्यो भवेत्कर्तुं हि पाण्डवैः।\nकर्णद्रोणौ रणे पूर्वं हन्तव्याविति मे मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2058193, "chapter_id": 2257, "verse_number": "७-१८४-४७", "content_sanskrit": "एतौ हि मूलं दुःखानामस्माकं पुरुषर्षभ।\nएतौ रणे समासाद्य समाश्वस्तः सुयोधनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2058194, "chapter_id": 2257, "verse_number": "७-१८४-४८", "content_sanskrit": "यत्र वध्यो भवेद्द्रोणः सूतपुत्रश्च सानुगः।\nतत्रावधीन्महाबाहुः सैन्धवं दूरवासिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2058195, "chapter_id": 2257, "verse_number": "७-१८४-४९", "content_sanskrit": "अवश्यं तु मया कार्यः सूतपुत्रस्य निग्रहः।\nततो यास्याम्यहं वीर स्वयं कर्णजिघांसया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2058196, "chapter_id": 2257, "verse_number": "७-१८४-५०", "content_sanskrit": "भीमसेनो महाबाहुर्द्रोणानीकेन सङ्गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2058197, "chapter_id": 2257, "verse_number": "७-१८४-५१", "content_sanskrit": "एवमुक्त्वा ययौ तूर्णं त्वरमाणो युधिष्ठिरः।\nस विष्फार्य महच्चापं शङ्खं प्रध्माप्य भैरवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2058198, "chapter_id": 2257, "verse_number": "७-१८४-५२", "content_sanskrit": "ततो रथसहस्रेण गजानां च शतैस्त्रिभिः।\nवाजिभिः पञ्चसाहस्रैः पाञ्चालैः सप्रभद्रकैः।\nवृतः शिखण्डी तवरितो राजानं पृष्ठतोऽन्वयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2058199, "chapter_id": 2257, "verse_number": "७-१८४-५३", "content_sanskrit": "ततो भेरीः समाजघ्नुः पणवानकगोमुखान्।\nशह्खशब्दरवांश्चैव पाणिशब्दांश्च दंशिताः।\nपाञ्चालाः पाण्डवाश्चैव युधिष्ठिरपुरोगमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2058200, "chapter_id": 2257, "verse_number": "७-१८४-५४", "content_sanskrit": "ततोऽब्रवीन्महाबाहुर्वासुदेवो धनञ्जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2058201, "chapter_id": 2257, "verse_number": "७-१८४-५५", "content_sanskrit": "एष प्रयाति त्वरितः क्रोधाविष्टो युधिष्ठिरः।\nजिघांसुः सूतपुत्रस्य तस्योपेक्षा न युज्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2058202, "chapter_id": 2257, "verse_number": "७-१८४-५६", "content_sanskrit": "एवमुक्त्वा हृषीकेशः शीघ्रमश्वानचोदयत्।\nदूरं प्रयान्तं राजानमन्वगच्छज्जनार्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2058203, "chapter_id": 2257, "verse_number": "७-१८४-५७", "content_sanskrit": "तं दृष्ट्वा सहसा यान्तं भूतपुत्रजिघांसया।\nशोकोपहतसङ्कल्पं दह्यमानमिवाग्निना।\nअभिगम्याब्रवीद्व्यासो धर्मपुत्रं युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2058204, "chapter_id": 2257, "verse_number": "७-१८४-५८x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2058205, "chapter_id": 2257, "verse_number": "७-१८४-५८", "content_sanskrit": "कर्णमासाद्य सङ्ग्रामे दिष्ट्या जीवति फल्गुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2058206, "chapter_id": 2257, "verse_number": "७-१८४-५९", "content_sanskrit": "सव्यसाचिवधाकाङ्क्षी शक्तिं रक्षितवान्हि सः।\nन चागाद्द्वैरथं जिष्णुर्दिष्ट्या तेन महारणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2058207, "chapter_id": 2257, "verse_number": "७-१८४-६०", "content_sanskrit": "सृजेतां स्पर्धिनावेतौ दिव्यान्यस्त्राणि सर्वशः।\nवध्मानेषु चास्त्रेषु पीडितः सूतनन्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2058208, "chapter_id": 2257, "verse_number": "७-१८४-६१", "content_sanskrit": "वासवीं समरे शक्तिं ध्रुवं मुञ्चेद्युधिष्ठिर।\nततो भवेत्ते व्यसनं घोरं भरतसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2058209, "chapter_id": 2257, "verse_number": "७-१८४-६२", "content_sanskrit": "दिष्ट्या रक्षो हतं युद्धे सूतपुत्रेण मानद।\nवासवीं कारणं कृत्वा कालेनोपहतो ह्यसौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2058210, "chapter_id": 2257, "verse_number": "७-१८४-६३", "content_sanskrit": "तवैव कारणाद्रक्षो निहतं तात संयुगे।\nमा क्रुधो भरतश्रेष्ठ मा च शोके मनः कृथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2058211, "chapter_id": 2257, "verse_number": "७-१८४-६४", "content_sanskrit": "प्राणिनामिह सर्वेषामेषा निष्ठा युधिष्ठिर।\nभ्रातृभिः सहितः सर्वैः पार्थिवैश्च महात्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2058212, "chapter_id": 2257, "verse_number": "७-१८४-६५", "content_sanskrit": "कौरवान्समरे राजन्प्रतियुध्यस्व भारत।\nपञ्चमे दिवसे तात पृथिवी ते भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2058213, "chapter_id": 2257, "verse_number": "७-१८४-६६", "content_sanskrit": "नित्यं च पुरुषव्याघ्र धर्ममेवानुचिन्तय।\nआनृशंस्यं तपो दानं क्षमां सत्यं च पाण्डव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2058214, "chapter_id": 2257, "verse_number": "७-१८४-६७", "content_sanskrit": "सेवेथाः परमप्रीतो यतो धर्मस्ततो जयः।\nइत्युक्त्वा पाण्डवं व्यासस्तत्रैवान्तरधीयत॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2058215, "chapter_id": 2257, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि घटोत्कचवधपर्वणि चतुर्दशरात्रियुद्धे चतुरशीत्यधिकशततमोऽध्यायः॥ १८४ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-१८४-१ महत् जयालम्बनममोघशक्तिरूपमिति शेषः। अपनीतं ना शितम्। महदपनीतं अन्याय इति वा॥ ५-१८४-११ दुष्प्रणीतेन दुर्न येन॥ ५-१८४-३२ अभिज्ञश्चैवेति झ. पाठः॥ ५-१८४-१८४ चतुरशीत्यधिकशततमोध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}]