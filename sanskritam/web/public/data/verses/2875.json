[{"id": 2088141, "chapter_id": 2875, "verse_number": "१३-५-१", "content_sanskrit": "भीष्म उवाच।\nएवमुक्तो मतङ्गस्तु संशितात्मा यतव्रतः।\nसहस्रमेकपादेन ततो ध्याने व्यतिष्ठत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2088142, "chapter_id": 2875, "verse_number": "१३-५-२", "content_sanskrit": "तं सहस्रावरे काले शक्रो द्रष्टुमुपागमत्।\nतदेव च पुनर्वाक्यमुवाच बलवृत्रहा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2088143, "chapter_id": 2875, "verse_number": "१३-५-३x", "content_sanskrit": "मतङ्ग उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2088144, "chapter_id": 2875, "verse_number": "१३-५-३", "content_sanskrit": "इदं वर्षसहस्रं वै ब्रह्मचारी समाहितः।\nअतिष्ठमेकपादेन ब्राह्मण्यं नाप्नुयां कथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2088145, "chapter_id": 2875, "verse_number": "१३-५-४x", "content_sanskrit": "शक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2088146, "chapter_id": 2875, "verse_number": "१३-५-४", "content_sanskrit": "चण्डालयोनो जातेन नावाप्यं वै कथञ्चन।\nअन्यं कामं वृणीष्व त्वं मा वृथा तेऽस्त्वयं श्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2088147, "chapter_id": 2875, "verse_number": "१३-५-५", "content_sanskrit": "एवमुक्तो मतङ्गस्तु भृशं शोकपरायणः।\nअध्यतिष्ठद्गयां गत्वा सोऽङ्गुष्टेन शतं समाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2088148, "chapter_id": 2875, "verse_number": "१३-५-६", "content_sanskrit": "सुदुर्वहं वहन्योगं कृशो धमनिसन्ततः।\nत्वगस्थिभूतो धर्मात्मा स ततापेति नः श्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2088149, "chapter_id": 2875, "verse_number": "१३-५-७", "content_sanskrit": "तं तपन्तमभिद्रुत्य पाणिं जग्राह वासवः।\nवराणामीश्वरो दाता सर्वभूतहिते रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2088150, "chapter_id": 2875, "verse_number": "१३-५-८x", "content_sanskrit": "शक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2088151, "chapter_id": 2875, "verse_number": "१३-५-८", "content_sanskrit": "मतङ्ग ब्राह्मणत्वं ते विरुद्धमिह दृश्यते।\nब्राह्मण्यं दुर्लभतरं संवृतं परिपन्थिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2088152, "chapter_id": 2875, "verse_number": "१३-५-९", "content_sanskrit": "पूजयन्सुखमाप्नोति दुःखमाप्नोत्यपूजयन्।\nब्राह्मणे सर्वभूतानां योगक्षेमः समाहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2088153, "chapter_id": 2875, "verse_number": "१३-५-१०", "content_sanskrit": "ब्राह्मणेभ्योऽनुतृप्यन्ते पितरो देवतास्तथा।\nब्राह्मणः सर्वभूतानां मतङ्ग पर उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2088154, "chapter_id": 2875, "verse_number": "१३-५-११", "content_sanskrit": "ब्राह्मणः कुरुते तद्धि यथा यद्यच्च वाञ्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2088155, "chapter_id": 2875, "verse_number": "१३-५-१२", "content_sanskrit": "बह्वीस्तु संसरन्योनीर्जायमानः पनुःपुनः।\nपर्याये तात कस्मिंश्चिद्ब्राह्मण्यमिह विन्दति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2088156, "chapter_id": 2875, "verse_number": "१३-५-१३", "content_sanskrit": "तदुत्सृज्येह दुष्प्रापं ब्राह्मण्यमकृतात्मभिः।\nअन्यं वरं वृणीष्व त्वं दुर्लभोऽयं हि ते वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2088157, "chapter_id": 2875, "verse_number": "१३-५-१४", "content_sanskrit": "किं मां तुदसि दुःखार्तं मृतं मारयसे च माम्।\nत्वां तु शोचामि यो लब्ध्वा ब्राह्मण्यं न बुभूषसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2088158, "chapter_id": 2875, "verse_number": "१३-५-१५", "content_sanskrit": "ब्राह्मण्यं यदि दुष्प्रापं त्रिभिर्वर्णैर्दुरासदम्।\nसुदुर्लभं सदावाप्य नानुतिष्ठन्ति मानवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2088159, "chapter_id": 2875, "verse_number": "१३-५-१६", "content_sanskrit": "ये पापेभ्यः पापतमास्तेषामधम एव सः।\nब्राह्मण्यं योऽवजानीते धनं लब्ध्वेव दुर्लभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2088160, "chapter_id": 2875, "verse_number": "१३-५-१७", "content_sanskrit": "दुष्प्रापं खलु विप्रत्वं प्राप्तं दुरनुपालनम्।\nदुरवापमवाप्यैतन्नानुतिष्ठन्ति मानवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2088161, "chapter_id": 2875, "verse_number": "१३-५-१८", "content_sanskrit": "एकारामो ह्यहं शक्र निर्न्द्वद्वो निष्परिग्रहः।\nअहिंसादममास्थाय कथं नार्हामि विप्रताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2088162, "chapter_id": 2875, "verse_number": "१३-५-१९", "content_sanskrit": "दैवं तु कथमेतद्वै यदहं मातृदोषतः।\nएतामवस्थां सम्प्राप्तो धर्मज्ञः सन्पुरन्दरं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2088163, "chapter_id": 2875, "verse_number": "१३-५-२०", "content_sanskrit": "नूनं दैवं न शक्यं हि पौरुषेणातिवर्तितुम्।\nयदर्थं यत्नवानेव न लभे विप्रतां विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2088164, "chapter_id": 2875, "verse_number": "१३-५-२१", "content_sanskrit": "एवंगते तु धर्मज्ञ दातुमर्हसि मे वरम्।\nयदि तेऽहमनुग्राह्यः किचिद्वा सुकृतं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2088165, "chapter_id": 2875, "verse_number": "१३-५-२२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2088166, "chapter_id": 2875, "verse_number": "१३-५-२२", "content_sanskrit": "वृणीष्वेति तदा प्राह ततस्तं बलवृत्रहा।\nचोदितस्तु महेन्द्रेण मतङ्गः प्राब्रवीदिदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2088167, "chapter_id": 2875, "verse_number": "१३-५-२३", "content_sanskrit": "यथा कामविहारी स्यां कामरूपी विहङ्गमः।\nब्रह्मक्षत्राविरोधेन पूजां च प्राप्नुयामहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2088168, "chapter_id": 2875, "verse_number": "१३-५-२४", "content_sanskrit": "यथा ममाक्षया कीर्तिर्भवेच्चापि पुरन्दर।\nकर्तुमर्हसि तद्देव शिरसा त्वां प्रसादये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2088169, "chapter_id": 2875, "verse_number": "१३-५-२५x", "content_sanskrit": "शक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2088170, "chapter_id": 2875, "verse_number": "१३-५-२५", "content_sanskrit": "मतङ्ग गम्यतां शीघ्रमेवमेतद्भविष्यति।\nस्त्रियः सर्वास्त्वया लोके यक्ष्यन्ते भूतिकर्मणि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2088171, "chapter_id": 2875, "verse_number": "१३-५-२६", "content_sanskrit": "छन्दोदेव इति ख्यातः स्त्रीणां पूज्यो भविष्यसि।\nकीर्तिश्च तेऽतुला वत्स त्रिषु लोकेषु यास्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2088172, "chapter_id": 2875, "verse_number": "१३-५-२७", "content_sanskrit": "एवं तस्मै वरं दत्त्वा वासवोऽन्तरधीयत।\nप्राणांस्त्यक्त्वा मतङ्गोपि प्राप तत्स्थानमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2088173, "chapter_id": 2875, "verse_number": "१३-५-२८", "content_sanskrit": "एवमेव परं स्थानं मर्त्यानां भरतर्षभ।\nब्राह्मण्यं नाम दुष्प्रापमिन्द्रेणोक्तं महात्मना॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2088174, "chapter_id": 2875, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि पञ्चमोध्यायः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]