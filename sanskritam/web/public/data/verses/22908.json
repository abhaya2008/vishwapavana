[{"id": 7002908000, "chapter_id": 22908, "verse_number": "९-१९३-१", "content_sanskrit": "श्रीकृष्ण उवाच ।\nतिथिदानमिदानीं ते कथयामि युधिष्ठिर ।\nसर्वपापप्रशमनं सर्वविघ्नविनाशनम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002908001, "chapter_id": 22908, "verse_number": "९-१९३-२", "content_sanskrit": "मानसं वाचिकं चापि कर्मजं यदघं भवेत् ।\nसर्वं प्रशममायाति दानेनानेन पांडव ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002908002, "chapter_id": 22908, "verse_number": "९-१९३-३", "content_sanskrit": "श्रावणे कार्तिके चैत्रे वैशाखे फाल्गुने तथा ।\nसितपक्षात्प्रभृत्येव दातव्यं पुण्यवर्द्धनम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002908003, "chapter_id": 22908, "verse_number": "९-१९३-४", "content_sanskrit": "वित्तं श्रद्धासहायश्च पात्रप्राप्तिस्तथैव च ।\nदानकालः सदैवेह कथितस्तत्त्वदर्शिभिः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002908004, "chapter_id": 22908, "verse_number": "९-१९३-५", "content_sanskrit": "तीर्थे देवालये गोष्ठे गृहे वा नियतात्मवान् ।\nयद्ददाति नरश्रेष्ठस्तदानंत्याय कल्पते ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002908005, "chapter_id": 22908, "verse_number": "९-१९३-६", "content_sanskrit": "प्रतिपत्सु द्विजान्पूज्यप्त पूजयित्वा प्रजापतिम् ।\nसौवर्णमरविन्दं च कारयित्वाष्टपत्रकम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002908006, "chapter_id": 22908, "verse_number": "९-१९३-७", "content_sanskrit": "कृत्वा चौदुम्बरे पात्रे सुगन्धवृतपूरिते ।\nपुष्पैर्धूपैः पूजयित्वा विप्राय प्रतिपाद येत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002908007, "chapter_id": 22908, "verse_number": "९-१९३-८", "content_sanskrit": "अनेन विधिना दत्त्वा कमलं कमलालयम् ।\nईप्सितांल्लभते कामान्निष्कामो ब्रह्मसात्म्यताम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002908008, "chapter_id": 22908, "verse_number": "९-१९३-९", "content_sanskrit": "वह्निं पूज्य द्वितीयायां भूर्भुवःस्वरिति क्रमात् ।\nतिलाज्येन शतं हुत्वा दत्त्वा पूर्णाहुतिं ततः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002908009, "chapter_id": 22908, "verse_number": "९-१९३-१०", "content_sanskrit": "वैश्वानरं तु सौवर्णं स्थापयेत्ताम्रभाजने ।\nगुडाज्यपूरिते राजंस्तोयपूर्णघटोपरि ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002908010, "chapter_id": 22908, "verse_number": "९-१९३-११", "content_sanskrit": "पूजयित्वा वस्त्रमाल्यैर्भक्ष्यभोज्यैरनेकधा ।\nततस्तं ब्राह्मणे दद्याद्वह्निर्मे प्रीयतामिति ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002908011, "chapter_id": 22908, "verse_number": "९-१९३-१२", "content_sanskrit": "यावज्जीवकृतात्पापान्मुच्यते नात्र संशयः ।\nमृतो वह्नि पुरं याति प्राहेदं नारदो मुनिः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002908012, "chapter_id": 22908, "verse_number": "९-१९३-१३", "content_sanskrit": "तृतीयायां महाराज राधां स्वर्णमयीं शुभाम् ।\nस्थापयित्वा ताम्रपात्रे लवणोपरि विन्यसेत् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002908013, "chapter_id": 22908, "verse_number": "९-१९३-१४", "content_sanskrit": "जीरकं कटुकं चैव गुडं पार्थेषु दापयेत् ।\nरक्तवस्त्रयुगच्छन्नां कुंकुमेन विभूषिताम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002908014, "chapter_id": 22908, "verse_number": "९-१९३-१५", "content_sanskrit": "पुष्पधूपैः सनैवेद्यैः पूजयित्वा द्विजातये ।\nदत्त्वा यत्फलमाप्नोति पार्थ तत्केन वर्ण्यते ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002908015, "chapter_id": 22908, "verse_number": "९-१९३-१६", "content_sanskrit": "प्रासादा यत्र सौवर्णा नद्यः पायसकर्दमाः ।\nगन्धर्वाप्सरसो यत्र तत्र ते यांति मानवाः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002908016, "chapter_id": 22908, "verse_number": "९-१९३-१७", "content_sanskrit": "स्वर्गादिहैत्य संसारे सुरूपः सुभगो भवेत् ।\nदाता भोक्ता बहुधनः पुत्रपौत्रसमन्वितः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002908017, "chapter_id": 22908, "verse_number": "९-१९३-१८", "content_sanskrit": "नारी वा तद्गुणैर्युक्ता भवतीह न संशयः ।\nचतुर्थ्यां वारणं हैमं पलादूर्द्ध्वं सुशोभनम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002908018, "chapter_id": 22908, "verse_number": "९-१९३-१९", "content_sanskrit": "कामयित्वांकुशयुतं तिलद्रोणोपरि न्यसेत् ।\nवस्त्रैः पुष्पैः पूजयित्वा नैवेयं विनिवेद्य च ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002908019, "chapter_id": 22908, "verse_number": "९-१९३-२०", "content_sanskrit": "ततस्तु ब्राह्मणे दद्याद्गणेशः प्रीयतामिति ।\nकार्यारंभेषु सर्वेषु तस्य विघ्नं न जायते ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002908020, "chapter_id": 22908, "verse_number": "९-१९३-२१", "content_sanskrit": "वारणाः सप्त जन्मानि भवंति मदविह्वलाः ।\nवारणेन्द्रसमारूढस्त्रैलोक्यविजयी भवेत् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002908021, "chapter_id": 22908, "verse_number": "९-१९३-२२", "content_sanskrit": "पंचम्यां पन्नगं चैव स्वर्णेनैकेन कारयेत् ।\nक्षीराज्यपत्रमध्यस्थं पूजयित्वा प्रदापयेत् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002908022, "chapter_id": 22908, "verse_number": "९-१९३-२३", "content_sanskrit": "द्विजं संपूज्य वासोभिः प्रणिपत्य क्षमापयेत् ।\nइह लोके परे चैव दानमेतत्सुखावहम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002908023, "chapter_id": 22908, "verse_number": "९-१९३-२४", "content_sanskrit": "नागोपद्रवविद्रावि सर्वदुष्टनिबर्हणम् ।\nप्रायश्चित्तं तथा प्रोक्तं नागदष्टस्य शंभुना ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002908024, "chapter_id": 22908, "verse_number": "९-१९३-२५", "content_sanskrit": "षष्ठ्यां शक्तिसमोपेतं कुमारं शिखिवाहनम् ।\nकारयित्वा यथाशक्त्या हेममालाविभूषितम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002908025, "chapter_id": 22908, "verse_number": "९-१९३-२६", "content_sanskrit": "तंडुलेनाथ शिखरे वासोभिः पूज्य भक्तितः ।\nषष्ठ्यां स्कंदं यथाशक्ति कृत्वा स्कंदं हिरण्मयम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002908026, "chapter_id": 22908, "verse_number": "९-१९३-२७", "content_sanskrit": "पूजयित्वा गंधपुष्पधूपैनैवेद्यतस्तथा ।\nनमस्कृत्य ततो दद्याद्ब्राह्मणाय कुटुंबिने ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002908027, "chapter_id": 22908, "verse_number": "९-१९३-२८", "content_sanskrit": "इह भूतिं परां प्राप्य प्रेत्य स्वर्गे महीयते ।\nशूद्रो ब्राह्मणतामेति ब्राह्मणो ब्रह्मलोकताम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002908028, "chapter_id": 22908, "verse_number": "९-१९३-२९", "content_sanskrit": "सप्तम्यां भास्करं पूज्य ब्राह्मणानश्वमुत्तमम् ।\nदद्यादलंकृतग्रीवं सपर्याणं सदक्षिणम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002908029, "chapter_id": 22908, "verse_number": "९-१९३-३०", "content_sanskrit": "सूर्यलोकमवाप्नोति सूर्येण सह मोदते ।\nगंधर्वास्तुष्टिमायांति दत्तेऽश्वे समलंकृते ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002908030, "chapter_id": 22908, "verse_number": "९-१९३-३१", "content_sanskrit": "अष्टम्यां वृषभं श्वेतमव्यंगांगं धुरंधरम् ।\nसितवस्त्रयुगच्छन्नं घंटाभरणभूषितम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002908031, "chapter_id": 22908, "verse_number": "९-१९३-३२", "content_sanskrit": "दद्यात्प्रणम्य विप्राय प्रीयतां वृषभध्वजः ।\nप्रदक्षिणं ततः कृत्वा आद्वारांतमनुव्रजेत् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002908032, "chapter_id": 22908, "verse_number": "९-१९३-३३", "content_sanskrit": "दानेनानेन नृपते शिवलोको न दुर्लभः ।\nवृषस्कंधे प्रतिष्ठंति भुवनानि चतुर्दश ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002908033, "chapter_id": 22908, "verse_number": "९-१९३-३४", "content_sanskrit": "तस्माद्वृषभदानेन दत्ता भवति भारती ।\nनवम्यां कांचनं सिंहं कारयित्वा स्वशक्तितः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002908034, "chapter_id": 22908, "verse_number": "९-१९३-३५", "content_sanskrit": "मुक्ताफलाष्टकयुतं नीलवस्त्रावगुण्ठितम् ।\nदद्याद्देवीमनुस्मृत्य दुष्टदैत्यनिबर्हणीम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002908035, "chapter_id": 22908, "verse_number": "९-१९३-३६", "content_sanskrit": "द्विजातिप्रवरायेत्थं सर्वान्कामान्समश्नुते ।\nकांतारवनदुर्गेषु चौरव्याला कुले पथि ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002908036, "chapter_id": 22908, "verse_number": "९-१९३-३७", "content_sanskrit": "हिंसकास्तं न हिंसंति दानस्यास्य प्रभावतः ।\nमृतो देवीपुरं याति पूज्यमानः सुरासुरैः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002908037, "chapter_id": 22908, "verse_number": "९-१९३-३८", "content_sanskrit": "पुण्यक्षयादिहाभ्येत्य राजा भवति धार्मिकः ।\nदशम्यां नृपशार्दूल दशाशाः स्वर्णनिर्मिताः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002908038, "chapter_id": 22908, "verse_number": "९-१९३-३९", "content_sanskrit": "लवणे च गुडे क्षीरे निष्पावेषु तिलेषु च ।\nगव्यत्रये तंदुलेषु माषाणा सुपरि स्थिताः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002908039, "chapter_id": 22908, "verse_number": "९-१९३-४०", "content_sanskrit": "संपूज्य वस्त्रपुष्पाद्यैर्द्विजाय प्रतिपादयेत् ।\nअनेन विधिना यस्तु पुमान्स्त्री वाथ वा पुनः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002908040, "chapter_id": 22908, "verse_number": "९-१९३-४१", "content_sanskrit": "निर्वापयति राजेंद्र तस्य पुण्यफलं शृणु ।\nइह लोके भूपतिः स्यात्प्रेत्य स्वर्गे महीयते ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002908041, "chapter_id": 22908, "verse_number": "९-१९३-४२", "content_sanskrit": "सकलास्तस्य सर्वाशा याः काश्चिन्मनसेच्छिताः ।\nततः स्वर्गादिहाभ्येत्य कुले महति जायते ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002908042, "chapter_id": 22908, "verse_number": "९-१९३-४३", "content_sanskrit": "एकादश्यां गरुत्मंतं कारयित्वा हिरण्मयम् ।\nयथाशक्त्या ताम्रपात्रे घृतस्योपरि पूजितम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002908043, "chapter_id": 22908, "verse_number": "९-१९३-४४", "content_sanskrit": "पंचाग्न्यभिरते विप्रे पुराणज्ञे विशेषतः ।\nदत्त्वा किं बहुनोक्तेन विष्णुलोके महीयते ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002908044, "chapter_id": 22908, "verse_number": "९-१९३-४५", "content_sanskrit": "गां वृषं महिषीं हेमं सप्तधान्यान्यजाविकम् ।\nवडवां गुरडरसान्स र्वांस्तथा बहुफलद्रुमान् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002908045, "chapter_id": 22908, "verse_number": "९-१९३-४६", "content_sanskrit": "पुष्पाणि च विचित्राणि गंधांश्चोच्चावचान्बहून् ।\nयथाशक्त्या मेलयित्वा वस्त्रैराच्छादयेन्नवैः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002908046, "chapter_id": 22908, "verse_number": "९-१९३-४७", "content_sanskrit": "द्वादश्यां द्वादशैतानि ब्राह्मणेभ्यो निवेदयेत् ।\nएकस्य वा महाराज यत्फलं तन्निशामय ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002908047, "chapter_id": 22908, "verse_number": "९-१९३-४८", "content_sanskrit": "इह कीर्तिं परां प्राप्य भुक्त्वा भोगान्यथेप्सितान् ।\nततो विष्णुपुरं याति सेव्यमानोऽप्सरोणणैः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002908048, "chapter_id": 22908, "verse_number": "९-१९३-४९", "content_sanskrit": "कर्मक्षयादिहाभ्येत्य राजा भवति धार्मिकः ।\nयज्ञयाजी दानपतिर्जीवेच्च शरदां शतम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002908049, "chapter_id": 22908, "verse_number": "९-१९३-५०", "content_sanskrit": "स्नापयेद्ब्राह्मणांश्चात्र त्रयोदश्यां त्रयोदश ।\nतानाच्छाद्य नवैर्वस्त्रैर्गंधपुष्पैरथार्चयेत् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7002908050, "chapter_id": 22908, "verse_number": "९-१९३-५१", "content_sanskrit": "भोजयीत सुमिष्टान्नं दक्षिणां विनिवेदयेत् ।\nयथाशक्त्या हेमखण्डान्धर्मात्मा प्रीयतामिति ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7002908051, "chapter_id": 22908, "verse_number": "९-१९३-५२", "content_sanskrit": "धर्मराजाय कालाय चित्रगुप्ताय दंडिने ।\nमृत्यवे क्षयरूपाय अंतकाय यमाय च ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7002908052, "chapter_id": 22908, "verse_number": "९-१९३-५३", "content_sanskrit": "प्रेतनाथाय रौद्राय तथा वैवस्वताय च ।\nमहिषस्थाय देवाय नामानीह त्रयोदश ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7002908053, "chapter_id": 22908, "verse_number": "९-१९३-५४", "content_sanskrit": "उच्चार्य श्रद्धया युक्तः प्रणिपत्य विसर्जयेत् ।\nयः करोति महाराज पूजामेतां मनोरमाम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7002908054, "chapter_id": 22908, "verse_number": "९-१९३-५५", "content_sanskrit": "यमाय स सुखं मर्त्ये स्थित्वा व्याधिविवर्जितः ।\nयममार्गगतः पश्चाद्दुःखं नाप्नोत्यसौ पुमान् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7002908055, "chapter_id": 22908, "verse_number": "९-१९३-५६", "content_sanskrit": "न पश्यति प्रेतमुखं पितृलोकं स गच्छति ।\nपुण्यक्षयादिहाभ्येत्य स सुखी नीरुजो भवेत् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7002908056, "chapter_id": 22908, "verse_number": "९-१९३-५७", "content_sanskrit": "महिषं सुशुभं कुंभं चतुर्दश्यां पयोभृतम् ।\nतं कर्षकेण संयुक्तं हेम्नः सद्वस्त्रसंयुतम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7002908057, "chapter_id": 22908, "verse_number": "९-१९३-५८", "content_sanskrit": "घंटाभरणशोभाढ्यं वृषभेण समन्वितम् ।\nयो दद्याच्छिवभक्ताय ब्राह्मणाय कुटुंबिने ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7002908058, "chapter_id": 22908, "verse_number": "९-१९३-५९", "content_sanskrit": "वृषं दत्त्वा नरश्रेष्ठ शिवलोके महीयते ।\nतत्र स्थित्वा चिरं कालं क्रमादेत्य महीतलम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7002908059, "chapter_id": 22908, "verse_number": "९-१९३-६०", "content_sanskrit": "आरोग्यधनसंयुक्ते कुले महति जायते ।\nसर्वकामसमृद्ध्यर्थं यावजन्मशतत्रयम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7002908060, "chapter_id": 22908, "verse_number": "९-१९३-६१", "content_sanskrit": "पौर्णमास्यां वृषोत्सर्गं कारयित्वा विधानतः ।\nचंद्ररजतनिष्पन्नं फलेनैकेन शोभनम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7002908061, "chapter_id": 22908, "verse_number": "९-१९३-६२", "content_sanskrit": "पूजयेद्गंधकुसुमैर्नैवेद्यं विनिवेद्य च ।\nदद्याद्विप्राय संकल्प्य वासोलंकारभूषणैः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7002908062, "chapter_id": 22908, "verse_number": "९-१९३-६३", "content_sanskrit": "मंत्रेणानेन राजेन्द्र तन्निबोध यथोदितम् ।\nक्षीरोदार्णवसंभूत त्रैलोक्यांगणदीपक ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7002908063, "chapter_id": 22908, "verse_number": "९-१९३-६४", "content_sanskrit": "उमा पतेः शिरोरत्नशिवं यच्छ नमोनमः ।\nदानेनानेन नृपते भ्राजते चंद्रवद्दिवि ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7002908064, "chapter_id": 22908, "verse_number": "९-१९३-६५", "content_sanskrit": "अप्सरोभिः परिवृतो यावदाभूतसंप्लवम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7002908065, "chapter_id": 22908, "verse_number": "९-१९३-६६", "content_sanskrit": "दानान्यमूनि विधिवत्प्रयतिक्रमेण यच्छंति ये द्विजवराय विशुद्धसत्त्वाः ।\nते ब्रह्मविष्णुभुवनेषु सुखं विहृत्य यांत्येकतां सह शिवेन न संशयो मे ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}]