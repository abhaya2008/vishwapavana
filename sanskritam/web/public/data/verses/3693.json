[{"id": 2125654, "chapter_id": 3693, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2125655, "chapter_id": 3693, "verse_number": "१", "content_sanskrit": "भगवञ्श्रोतुमिच्छामि पार्थस्याक्लिष्टकर्मणः ।\nविस्तरेण कथामेतां यथाऽस्त्राण्युपलब्धवान्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2125656, "chapter_id": 3693, "verse_number": "२", "content_sanskrit": "कथं स पुरुषव्याघ्रो दीर्घबाहुः सुलोचनः ।\nवनं प्रविष्टस्तेजस्वी निर्मनुष्यमभीतवत्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2125657, "chapter_id": 3693, "verse_number": "३", "content_sanskrit": "किं वाऽनेन कृतं तत्र वसता ब्रह्मवित्तम ।\nकथं च भगवान् रुद्रो देवराजश्च तोषितः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2125658, "chapter_id": 3693, "verse_number": "४", "content_sanskrit": "एतदिच्छाम्यहं श्रोतुं त्वत्प्रसादाद् द्विजोत्तम ।\nत्वं हि सर्वज्ञ दिव्यं च मानुषं चैव वेत्थ ह\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2125659, "chapter_id": 3693, "verse_number": "५", "content_sanskrit": "अत्यद्भुतं महाप्राज्ञ रोमहर्षणमर्जुनः ।\nभवेन सह सङ्ग्रामं चकाराप्रतिमं किल ।\nपुरा प्रहरतां श्रेष्ठः सङ्ग्रामेष्वपराजितः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2125660, "chapter_id": 3693, "verse_number": "६", "content_sanskrit": "यच्छ्रुत्वा नरसिंहानां दैन्यहर्षातिविस्मयात् ।\nशूराणामपि पार्थानां हृदयानि चकम्पिरे\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2125661, "chapter_id": 3693, "verse_number": "८", "content_sanskrit": "यद्यच्च कृतवानन्यत् पार्थस्तदखिलं वद \t॥७॥\nन ह्यस्य निन्दितं जिष्णोः सुसूक्ष्ममपि लक्षये ।\nचरितं तस्य शूरस्य तन्मे सर्वं प्रकीर्तय\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2125662, "chapter_id": 3693, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2125663, "chapter_id": 3693, "verse_number": "९", "content_sanskrit": "कथयिष्यामि ते पार्थकथामेतां महात्मनः ।\nदिव्यां कौरवशार्दूल महतीमद्भुतोपमाम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2125664, "chapter_id": 3693, "verse_number": "१०", "content_sanskrit": "गात्रसंस्पर्शसम्बद्धां त्र्यम्बकेण महाहवे ।\nपार्थस्य देवदेवेन शृणु सम्यक् समागमम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2125665, "chapter_id": 3693, "verse_number": "११", "content_sanskrit": "युधिष्ठिरनियोगात् स जगामामितविक्रमः ।\nशक्रं सुरेश्वरं द्रष्टुं देवदेवं च शङ्करम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2125666, "chapter_id": 3693, "verse_number": "१२", "content_sanskrit": "दिव्यं तद्धनुरादाय खड्गं च पुरुषर्षभः ।\nमहाबलो महाबाहुरर्जुनः कार्यसिद्धये\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2125667, "chapter_id": 3693, "verse_number": "१३", "content_sanskrit": "दिशं ह्युदीचीं कौरव्यो हिमवच्छिखरं प्रति ।\nऐन्द्रिः स्थिरमना राजन् सर्वलोकमहारथः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2125668, "chapter_id": 3693, "verse_number": "१४", "content_sanskrit": "त्वरया परया युक्तस्तपसे धृतनिश्चयः ।\nवनं कण्टकिनं घोरमेक एवान्वपद्यत\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2125669, "chapter_id": 3693, "verse_number": "१५", "content_sanskrit": "नानापुष्पफलोपेतं नानापक्षिविनादितम् ।\nनानामृगगणाकीर्णं सिद्धचारणसेवितम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2125670, "chapter_id": 3693, "verse_number": "१६", "content_sanskrit": "ततः प्रयाते बीभत्सौ वनं मानुषवर्जितम् ।\nशङ्खानां पटहानां च शब्दः समभवद् दिवि\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2125671, "chapter_id": 3693, "verse_number": "१७", "content_sanskrit": "पुष्पवर्षं च सुमहन्निपपात महीतळे ।\nमेघजालं च विततं छादयामास सर्वतः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2125672, "chapter_id": 3693, "verse_number": "१८", "content_sanskrit": "सोऽतीत्य वनदुर्गाणि सन्निकर्षे महागिरेः ।\nशुशुभे हिमवत्पृष्टे वसमानोऽर्जुनस्तदा\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2125673, "chapter_id": 3693, "verse_number": "१९", "content_sanskrit": "तत्र पुण्यद्रुमान्पुष्पान् विहगैर्वल्गुनादितान् ।\nदीर्घं च विपुलावर्तां नीलवैडूर्यसंनिभाम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2125674, "chapter_id": 3693, "verse_number": "२०", "content_sanskrit": "हंसकारण्डवोद्गीतां सारसाभिरुतां तथा ।\nपुंस्कोकिलरुतां चैव क्रौञ्चबर्हिणनादिताम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2125675, "chapter_id": 3693, "verse_number": "२१", "content_sanskrit": "मनोहरवनोपेतां तस्मिन्नतिरथोऽर्जुनः ।\nपुण्यशीलामलजलां पश्यन् प्रीतमनाऽभवत्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2125676, "chapter_id": 3693, "verse_number": "२२", "content_sanskrit": "रमणीये वनोद्देशे रममाणोऽर्जुनस्तदा ।\nतपस्युग्रे वर्तमान उग्रतेजा महामनाः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2125677, "chapter_id": 3693, "verse_number": "२३", "content_sanskrit": "दर्भचीरं निवस्याथ दण्डाजिनविभूषितः ।\nपूर्णे पूर्णे त्रिरात्रे तु मासमेकं फलाशनः ।\nद्विगुणेन च कालेन द्वितीयं मासमत्यगात्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2125678, "chapter_id": 3693, "verse_number": "२४", "content_sanskrit": "तृतीयमाससमये पक्षेणाहारमाचरत् ।\nजीर्णं च पतितं भूमौ पर्णं समुपयुक्तवान्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2125679, "chapter_id": 3693, "verse_number": "२५", "content_sanskrit": "चतुर्थे त्वथ सम्प्राप्ते मासि पूर्णे ततः परम् ।\nवायुभक्षो महाबाहुरभवत् पाण्डुनन्दनः \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2125680, "chapter_id": 3693, "verse_number": "२६", "content_sanskrit": "ऊर्ध्वबाहुर्निरालम्बः पादाङ्गुष्ठाग्रविष्ठितः \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2125681, "chapter_id": 3693, "verse_number": "२७", "content_sanskrit": "सदोपस्पर्शनाच्चास्य बभूवुरमितौजसः ।\nविद्युदम्भोरुहनिभा जटास्तस्य महात्मनः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2125682, "chapter_id": 3693, "verse_number": "२८", "content_sanskrit": "ततो महर्षयः सर्वे जग्मुर्देवं पिनाकिनम् ।\nशितिकण्ठं महादेवं प्रणिपत्य प्रसादयन् ।\nसर्वं निवेदयामासुः कर्म तत् फल्गुनस्य च\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2125683, "chapter_id": 3693, "verse_number": "२९", "content_sanskrit": "एषः पार्थो महातेजा हिमवत्पृष्ठमाश्रितः ।\nउग्रे तपसि दुष्पारे स्थितो धूमापयन् दिशः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2125684, "chapter_id": 3693, "verse_number": "३०", "content_sanskrit": "तस्य देवेश न वयं विद्मः सर्वे चिकीर्षितम् ।\nसन्तापयति नः सर्वानसौ साधु निवार्यताम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2125685, "chapter_id": 3693, "verse_number": "", "content_sanskrit": "श्रीमहेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2125686, "chapter_id": 3693, "verse_number": "३१", "content_sanskrit": "शीघ्रं गच्छत संहृष्टा यथागतमतन्द्रिताः ।\nअहमस्य विजानामि सङ्कल्पं मनसि स्थितम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2125687, "chapter_id": 3693, "verse_number": "३२", "content_sanskrit": "नास्य स्वर्गस्पृहा काचिन्नैश्वर्यस्स तथाऽऽयुषः ।\nयत् तस्य काङ्क्षितं सर्वं तदस्य करवाण्यहम् \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2125688, "chapter_id": 3693, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2125689, "chapter_id": 3693, "verse_number": "३३", "content_sanskrit": "तच्छ्रुत्वा भगवद्वाक्यमृषयः सत्यवादिनः ।\nप्रहृष्टमनसो जग्मुर्यथास्वं पुनराश्रमान्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2125690, "chapter_id": 3693, "verse_number": "२५", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nवनपर्वणि पञ्चस्त्रिंशोऽध्यायः ॥३५॥\n॥ कैरातपर्वणि पञ्चविंशोऽध्यायः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2125691, "chapter_id": 3693, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]