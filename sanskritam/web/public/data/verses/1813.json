[{"id": 2037669, "chapter_id": 1813, "verse_number": "५-५८-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2037670, "chapter_id": 1813, "verse_number": "५-५८-१", "content_sanskrit": "क्षत्रतेजा ब्रह्मचारी कौमारादपि पाण्डवः।\nतेन संयुगमेष्यन्ति मन्दा विलपतो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2037671, "chapter_id": 1813, "verse_number": "५-५८-२", "content_sanskrit": "दुर्योधन निवर्तस्व युद्धाद्भरतसत्तम ।\nन हि युद्धं प्रशंसन्ति सर्वावस्थमरिन्दम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2037672, "chapter_id": 1813, "verse_number": "५-५८-३", "content_sanskrit": "अलमर्धं पृथिव्यास्ते सहामात्यस्य जीवितुम् ।\nप्रयच्छ पाण्डुपुत्राणां यथोचितमरिन्दम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2037673, "chapter_id": 1813, "verse_number": "५-५८-४", "content_sanskrit": "एतद्धि कुरवः सर्वे मन्यन्ते धर्मसंहितम् ।\nयत्त्वं प्रशान्तिं मन्येथाः पाण्डुपुत्रैर्महात्मभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2037674, "chapter_id": 1813, "verse_number": "५-५८-५", "content_sanskrit": "अङ्गेमां समवेक्षस्व पुत्र स्वामेव वाहिनीम् ।\nजात एष तवाभावस्त्वं तु मोहान्न बुद्ध्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2037675, "chapter_id": 1813, "verse_number": "५-५८-६", "content_sanskrit": "न त्वहं युद्धमिच्छामि नैतदिच्छति बाह्लिकः।\nन च भीष्मो न च द्रोणो नाश्वत्थामा न सञ्जयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2037676, "chapter_id": 1813, "verse_number": "५-५८-७", "content_sanskrit": "न सोमदत्तो न शलो न कृपो युद्धमिच्छति ।\nसत्यव्रतः पुरुमित्रो जयो भूरिश्रवास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2037677, "chapter_id": 1813, "verse_number": "५-५८-८", "content_sanskrit": "येषु संप्रतितिष्ठेयुः कुरवः पीडिताः परैः ।\nते युद्धं नाभिनन्दन्ति तत्तुभ्यं तात रोचताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2037678, "chapter_id": 1813, "verse_number": "५-५८-९", "content_sanskrit": "न त्वं करोषि कामेन कर्णः कारयिता तव।\nदुःशासनश्च पापात्मा शकुनिश्चापि सौबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2037679, "chapter_id": 1813, "verse_number": "५-५८-१०x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2037680, "chapter_id": 1813, "verse_number": "५-५८-१०", "content_sanskrit": "नाहं भवति न द्रोणे नाश्वत्थाम्नि न सञ्जये।\nन भीष्मे न काम्भोजे न कृपे न च बाह्लिके ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2037681, "chapter_id": 1813, "verse_number": "५-५८-११", "content_sanskrit": "सत्यव्रते पुरुमित्रे भूरिश्रवसि वा पुनः ।\nअन्येषु वा तावकेषु भारं कुत्वा समाह्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2037682, "chapter_id": 1813, "verse_number": "५-५८-१२", "content_sanskrit": "अहं च तात कर्णश्च रणयज्ञं वितत्य वै।\nयुधिष्ठिरं पशुं कृत्वा दीक्षितौ भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2037683, "chapter_id": 1813, "verse_number": "५-५८-१३", "content_sanskrit": "रथो वेदी स्रुवः खङ्गो गदा स्रुक् कवचोऽजिनम् ।\nचातुर्होत्रं च धुर्या मे शरा दर्भा हविर्यशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2037684, "chapter_id": 1813, "verse_number": "५-५८-१४", "content_sanskrit": "आत्मयज्ञेन नृपते इष्ट्वा वैवस्वतं रणे।\nविजित्य च समेष्यावो हतामित्रौ श्रिया वृतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2037685, "chapter_id": 1813, "verse_number": "५-५८-१५", "content_sanskrit": "अहं च तात कर्णश्च भ्राता दुःशासनश्च मे।\nएते वयं हनिष्यामः पाण्डवान्समरे त्रयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2037686, "chapter_id": 1813, "verse_number": "५-५८-१६", "content_sanskrit": "अहं हि पाण्डवान्हत्वा प्रशास्ता पृथिवीमिमाम् ।\nमां वा हत्वा पाण्डुपुत्रा भोक्तारः पृथिवीमिमां ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2037687, "chapter_id": 1813, "verse_number": "५-५८-१७", "content_sanskrit": "त्यक्तं मे जीवितं राज्यं धनं सर्वं च पार्थिव ।\nन जातु पाण्डवैः सार्धं वसेयमहमच्युत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2037688, "chapter_id": 1813, "verse_number": "५-५८-१८", "content_sanskrit": "यावद्धि सूच्यास्तीक्ष्णाया विध्येदग्रेण मारिष ।\nतावदप्यपरित्याज्यं भूमेर्नः पाण्डवान्प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2037689, "chapter_id": 1813, "verse_number": "५-५८-१९x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2037690, "chapter_id": 1813, "verse_number": "५-५८-१९", "content_sanskrit": "सर्वान्वस्तात शोचामि त्यक्तो दुर्योधनो मया।\nये मन्दमनुयास्यध्वं यान्तं वैवस्वतक्षयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2037691, "chapter_id": 1813, "verse_number": "५-५८-२०", "content_sanskrit": "रुरूणामिव यूथेषु व्याघ्राः प्रहरतां वराः।\nवरान्वरान्हनिष्यन्ति समेता युधि पाण्डवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2037692, "chapter_id": 1813, "verse_number": "५-५८-२१", "content_sanskrit": "प्रतीपमिव मे भाति युयुधानेन भारती।\nव्यस्ता सीमन्तिनी ग्रस्ता प्रमृष्टा दीर्घबाहुना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2037693, "chapter_id": 1813, "verse_number": "५-५८-२२", "content_sanskrit": "संपूर्मं पूरयन्भूयो धनं पार्थस्य माधवः।\nशैनेयः समरे स्थाता बीजवत्प्रवपञ्शरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2037694, "chapter_id": 1813, "verse_number": "५-५८-२३", "content_sanskrit": "सेनामुखे प्रयुद्धानां भीमसेनो भविष्यति।\nतं सर्वे संश्रयिष्यन्ति प्राकारमकुतोभयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2037695, "chapter_id": 1813, "verse_number": "५-५८-२४", "content_sanskrit": "यदा द्रक्ष्यसि भीमेन कुञ्जरान्विनिपातितान्।\nविशीर्णदन्तान्गिर्याभान्भिन्नकुम्भान्सशोणितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2037696, "chapter_id": 1813, "verse_number": "५-५८-२५", "content_sanskrit": "तानभिप्रेक्ष्य सङ्ग्रामे विशीर्णानिव पर्वतान्।\nभीतो भीमस्य संस्पर्शात्स्मर्तासि वचनस्य मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2037697, "chapter_id": 1813, "verse_number": "५-५८-२६", "content_sanskrit": "निर्दग्धं भीमसेनेन सैन्यं रथहयद्विपम् ।\nगतिमग्नेरिव प्रेक्ष्य स्मर्तासि वचनस्य मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2037698, "chapter_id": 1813, "verse_number": "५-५८-२७", "content_sanskrit": "महद्वो भयमागामि न चेच्छाम्यथ पाण्डवैः।\nगदया भीमसेनेन हताः शममुपैष्यथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2037699, "chapter_id": 1813, "verse_number": "५-५८-२८", "content_sanskrit": "महावनमिव च्छिन्नं यदा द्रक्ष्यसि पातितम् ।\nबलं कुरूणां भीमेन तदा स्मर्तासि मे वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2037700, "chapter_id": 1813, "verse_number": "५-५८-२९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2037701, "chapter_id": 1813, "verse_number": "५-५८-२९", "content_sanskrit": "एतावदुक्त्वा राजा तु सर्वांस्तान्पृथिवीपतीन्।\nअनुभाष्य महाराज पुनः पप्रच्छ सञ्जयम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2037702, "chapter_id": 1813, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि यानसन्धिपर्वणि अष्टपञ्चाशत्तमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]