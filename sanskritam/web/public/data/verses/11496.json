[{"id": 50012647, "chapter_id": 11496, "verse_number": "1", "content_sanskrit": "पृश्निस्तु पत्नी सवितुः सावित्रीं व्याहृतीं त्रयीम्। अग्निहोत्रं पशुं सोमं चातुर्मास्यं महामखान्॥ ६/१८/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50012648, "chapter_id": 11496, "verse_number": "2", "content_sanskrit": "सिद्धिर्भगस्य भार्याऽङ्ग महिमानं विभुं प्रभुम्। आशिषं च वरारोहां कन्यां प्रासूत सुव्रता॥ ६/१८/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50012649, "chapter_id": 11496, "verse_number": "3", "content_sanskrit": "धातुः कुहूः सिनीवाली राका चानुमतिस्तथा। सायं दर्शमथ प्रातः पूर्णमासमनुक्रमात्॥ ६/१८/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50012650, "chapter_id": 11496, "verse_number": "4", "content_sanskrit": "अग्नीन् पुरीषानाधत्त क्रियायां समनन्तरः। चर्षणी वरुणस्यासीद् यस्यां जातो भृगुः पुनः॥ ६/१८/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50012651, "chapter_id": 11496, "verse_number": "5", "content_sanskrit": "वाल्मीकिश्च महायोगी वल्मीकादभवत् किल। अगस्त्यश्च वसिष्ठश्च मित्रावरुणयोऋर्षी॥ ६/१८/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50012652, "chapter_id": 11496, "verse_number": "6", "content_sanskrit": "रेतः सिषिचतुः कुम्भे उर्वश्या सन्निधौ द्रुतम्। रेवत्यां मित्र उत्सर्गमरिष्टं पिप्पलं व्यघात्॥ ६/१८/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50012653, "chapter_id": 11496, "verse_number": "7", "content_sanskrit": "पौलोम्यामिन्द्र आधत्त त्रीन् पुत्रानिति नः श्रुतम्। जयन्तं ऋषभं तात तृतीयं मीह्ळुषं प्रभुम्॥ ६/१८/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50012654, "chapter_id": 11496, "verse_number": "8", "content_sanskrit": "उरुक्रमस्य देवस्य मायावामनरूपिणः। कार्तौ पत्नयां बृहछ्लोकस्तस्यासन् सौभगादयः॥ ६/१८/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50012655, "chapter_id": 11496, "verse_number": "9", "content_sanskrit": "तत्कर्मगुणवीर्याणि काश्यपस्य महात्मनः। पश्चाद् वक्ष्यामहेऽदित्यां यथैवावततार ह॥ ६/१८/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50012656, "chapter_id": 11496, "verse_number": "10", "content_sanskrit": "अथ काश्यपदायादान् दैतेयान् कार्तयामि ते। यत्र भागवतः श्रीमान् प्रह्लादो बलिरेव च॥ ६/१८/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50012657, "chapter_id": 11496, "verse_number": "11", "content_sanskrit": "दितेर्द्वावेव दायादौ दैत्यदानववन्दितौ। हिरण्यकशिपुर्नाम हिरण्याक्षश्च कार्तितौ॥ ६/१८/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50012658, "chapter_id": 11496, "verse_number": "12", "content_sanskrit": "हिरण्यकशिपोर्भार्या कयाधुर्नाम दानवी। जम्भस्य तनया दत्ता सुषुवे चतुरः सुतान्॥ ६/१८/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50012659, "chapter_id": 11496, "verse_number": "13", "content_sanskrit": "संह्लादं प्रागनुह्लादं प्रह्लादं ह्लादमेव च। तत्स्वसा सिंहिका नाम राहुं विप्रचितोऽग्रहीत्॥ ६/१८/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50012660, "chapter_id": 11496, "verse_number": "14", "content_sanskrit": "शिरोऽहरद् यस्य हरिश्चक्रेण पिबतोऽमृतम्। संह्लादस्य कृतिर्भार्याऽसूत पञ्चजनं ततः॥ ६/१८/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50012661, "chapter_id": 11496, "verse_number": "15", "content_sanskrit": "ह्लादस्य धमनिर्भार्याऽसूत वातापिमिल्वलम्। योऽगस्त्यायाप्यतिथये पेचे वातापिमिल्वलः॥ ६/१८/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50012662, "chapter_id": 11496, "verse_number": "16", "content_sanskrit": "अनुह्लादस्य सूर्म्यायां बाष्कळो महिषस्तथा। विरोचनस्तु प्राह्लादिर्बलिस्तस्याभवत् किल॥ ६/१८/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50012663, "chapter_id": 11496, "verse_number": "17", "content_sanskrit": "बाणज्येष्ठं पुत्रशतमशनायां ततोऽभवत्। तस्यानुभावः सुश्लोक्यः पश्चादेवाभिधास्यते॥ ६/१८/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50012664, "chapter_id": 11496, "verse_number": "18", "content_sanskrit": "बाणस्त्वाराध्य गिरिशं लेभे तद्गणमुख्यताम्। यत्पार्श्वे भगवानास्ते ह्यद्यापि पुरपालकः॥ ६/१८/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50012665, "chapter_id": 11496, "verse_number": "19", "content_sanskrit": "मरुतश्च दितेः पुत्राश्चत्वारिंशन्नवाधिकाः। त आसन्नप्रजाः सर्वे नीता इन्द्रेण सात्मताम्॥ ६/१८/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50012666, "chapter_id": 11496, "verse_number": "20", "content_sanskrit": "राजोवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50012667, "chapter_id": 11496, "verse_number": "21", "content_sanskrit": "कथं त आसुरं भावमपोह्यौप्तत्तिकं गुरो। इन्द्रेण प्रापिताः साम्यं किं तत् साधु कृतं हि तैः॥ ६/१८/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50012668, "chapter_id": 11496, "verse_number": "22", "content_sanskrit": "इमे श्रद्दधते विद्वन् ऋषयोऽपि मया सह। परिज्ञानाय भगवंस्तन्नो व्याख्यातुमर्हसि॥ ६/१८/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50012669, "chapter_id": 11496, "verse_number": "23", "content_sanskrit": "सूत उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50012670, "chapter_id": 11496, "verse_number": "24", "content_sanskrit": "तद् विष्णुरातस्य स बादरायणिर्वचो निशम्यादृतमर्थवन्मुनिः। सभाजयंस्तन्निभृतेन चेतसा जगाद सत्रायणसर्वदर्शनः॥ ६/१८/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50012671, "chapter_id": 11496, "verse_number": "25", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 50012672, "chapter_id": 11496, "verse_number": "26", "content_sanskrit": "हतपुत्रा दितिः शक्रपार्ष्णिग्राहेण विष्णुना। मन्युना शोकदीप्तेन ज्वलन्ती पर्यचिन्तयत्॥ ६/१८/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 50012673, "chapter_id": 11496, "verse_number": "27", "content_sanskrit": "कदा नु भ्रातृहन्तारं इन्द्रियाराममुद्बणम्। अक्ल्न्निहृदयं पापं घातयित्वा स्वपे सुखम्॥ ६/१८/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 50012674, "chapter_id": 11496, "verse_number": "28", "content_sanskrit": "कृमिविङ्भस्मसञ्ज्ञाऽन्ते यस्येशाभिहितस्य वा। भूतध्रुक् तत्कृते स्वार्थं किं वेद निरयो यतः॥ ६/१८/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 50012675, "chapter_id": 11496, "verse_number": "29", "content_sanskrit": "आशासानस्य तस्येदं ध्रुवमुन्नद्धचेतसः। मदशोषणमिन्द्रस्य भूयाद् येन सुतो हि मे॥ ६/१८/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 50012676, "chapter_id": 11496, "verse_number": "30", "content_sanskrit": "इति भावेन सा भर्तुराचचारासकृत् प्रियम्। शुश्रूषयाऽनुरागेण प्रश्रयेण दमेन च॥ ६/१८/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 50012677, "chapter_id": 11496, "verse_number": "31", "content_sanskrit": "भक्त्या परमया राजन् मनोज्ञैर्वल्गुभाषितैः। मनो जग्राह भावज्ञा सस्मितापाङ्गवीक्षणैः॥ ६/१८/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 50012678, "chapter_id": 11496, "verse_number": "32", "content_sanskrit": "एवं स्त्रिया जडीभूतो विद्वानपि विदग्धया। बाढमित्याह विवशो न तच्चित्रं हि योषिति॥ ६/१८/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 50012679, "chapter_id": 11496, "verse_number": "33", "content_sanskrit": "विलोक्यैकान्तभूतानि भूतान्यादौ प्रजापतिः। स्त्रियं चक्रे स्वदेहार्धां यया पुंसां मतिर्हृता॥ ६/१८/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 50012680, "chapter_id": 11496, "verse_number": "34", "content_sanskrit": "एवं शुश्रूषितस्तात भगवान् काश्यपः स्त्रिया। प्रहस्य परमप्रीतो दितिमाहाभिनन्द्य च॥ ६/१८/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 50012681, "chapter_id": 11496, "verse_number": "35", "content_sanskrit": "काश्यप उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 50012682, "chapter_id": 11496, "verse_number": "36", "content_sanskrit": "वरं वरय वामोरु प्रीतस्तेऽहमनिन्दिते। स्त्रीणां भर्तरि सुप्रीते कः काम इह चागमः॥ ६/१८/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 50012683, "chapter_id": 11496, "verse_number": "37", "content_sanskrit": "पतिरेव हि नारीणां दैवतं परमं स्मृतम्। मानसः सर्वभूतानां वासुदेवः श्रियः पतिः॥ ६/१८/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 50012684, "chapter_id": 11496, "verse_number": "38", "content_sanskrit": "स एव देवतालिङ्गैर्नामरूपविकल्पितैः। इज्यते भगवान् पुम्भिः स्त्रीभिश्च पतिरूपधृक्॥ ६/१८/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 50012685, "chapter_id": 11496, "verse_number": "39", "content_sanskrit": "तस्मात् पतिव्रता नार्यः श्रेयःकामाः सुमध्यमे। यजन्तेऽनन्यभावेन पतिमात्मानमीश्वरम्॥ ६/१८/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 50012686, "chapter_id": 11496, "verse_number": "40", "content_sanskrit": "योऽहं त्वयाऽर्चितो भद्रे ईदृग्भावेन भक्तितः। कं ते सम्पादये काममसतीनां सुदुर्लभम्॥ ६/१८/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 50012687, "chapter_id": 11496, "verse_number": "41", "content_sanskrit": "दितिरुवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 50012688, "chapter_id": 11496, "verse_number": "42", "content_sanskrit": "वरदो यदि मे ब्रह्मन् पुत्रमिन्द्रहणं वृणे। अमृत्युं मृतपुत्राऽहं येन मे घातितौ सुतौ॥ ६/१८/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 50012689, "chapter_id": 11496, "verse_number": "43", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 50012690, "chapter_id": 11496, "verse_number": "44", "content_sanskrit": "निशम्य तद्वचो विप्रो विमनाः पर्यतप्यत। अहो अधर्मः सुमहानद्य मे समुपस्थितः॥ ६/१८/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 50012691, "chapter_id": 11496, "verse_number": "45", "content_sanskrit": "अहो अद्येन्द्रियारामो योषिन्मय्येशमायया। गृहीतचेताः कृपणः पतिष्ये नरके ध्रुवम्॥ ६/१८/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 50012692, "chapter_id": 11496, "verse_number": "46", "content_sanskrit": "कोऽतिक्रमोऽनुवर्तन्त्याः स्वभावमिह योषितः। धिङ् मां बताबुधं स्वार्थे यदहं लाळतेन्द्रियः॥ ६/१८/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 50012693, "chapter_id": 11496, "verse_number": "47", "content_sanskrit": "शरच्चन्द्रोपमं वक्त्रं वाचश्च श्रवणामृतम्। हृदयं क्षुरधाराभं स्त्रीणां को वेद चेष्टितम्॥ ६/१८/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 50012694, "chapter_id": 11496, "verse_number": "48", "content_sanskrit": "न हि कश्चित् प्रियः स्त्रीणामञ्जसा स्वाशिषात्मनाम्। पतिं पुत्रं भ्रातरं वा घ्नन्त्यर्थे घातयन्ति च॥ ६/१८/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 50012695, "chapter_id": 11496, "verse_number": "49", "content_sanskrit": "प्रतिश्रुतं ददानीति वचस्तन्न मृषा भवेत्। वधं नार्हति चेन्द्रोऽपि तत्रेदमुपकल्पये॥ ६/१८/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 50012696, "chapter_id": 11496, "verse_number": "50", "content_sanskrit": "इति सञ्चिन्त्य भगवान् मारीचः कुरुनन्दन। उवाच किञ्चित् कुपित आत्मानं च विगर्हयन्॥ ६/१८/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 50012697, "chapter_id": 11496, "verse_number": "51", "content_sanskrit": "काश्यप उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 50012698, "chapter_id": 11496, "verse_number": "52", "content_sanskrit": "पुत्रस्ते भविता भद्रे इन्द्रहा देवबान्धवः। संवत्सरं व्रतमिदं यद्यञ्जो धारयिष्यसि॥ ६/१८/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 50012699, "chapter_id": 11496, "verse_number": "53", "content_sanskrit": "दितिरुवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 50012700, "chapter_id": 11496, "verse_number": "54", "content_sanskrit": "धारयिष्ये व्रतं ब्रह्मन् ब्रूहि कार्याणि यानि मे। यानि चेह निषिद्धानि न व्रतं घ्नान्त यान्युत॥ ६/१८/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 50012701, "chapter_id": 11496, "verse_number": "55", "content_sanskrit": "काश्यप उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 50012702, "chapter_id": 11496, "verse_number": "56", "content_sanskrit": "न हिंस्यात् सर्वभूतानि न शपेन्नानृतं वदेत्। न छिन्द्यान्नखरोमाणि न स्पृशेद् यदमङ्गळम्॥ ६/१८/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 50012703, "chapter_id": 11496, "verse_number": "57", "content_sanskrit": "नाप्सु स्नायान्न कुप्येत न सम्भाषेत दुर्जनैः। न वसीताधौतवासः स्रजं च विधृतां क्वचित्॥ ६/१८/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 50012704, "chapter_id": 11496, "verse_number": "58", "content_sanskrit": "नोच्छिष्टं चण्डिकान्नं च सामिषं वृषळाहृतम्। भुञ्जीतोदक्यया दृष्टं पिबेन्नाञ्जलिना त्वपः॥ ६/१८/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 50012705, "chapter_id": 11496, "verse_number": "59", "content_sanskrit": "नोच्छिष्टाऽस्पृष्टसलिला सन्ध्ययोर्मुक्तमूर्धजा। अनर्चिताऽसंयतवाक् नासंवीता बहिश्चरेत्॥ ६/१८/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 50012706, "chapter_id": 11496, "verse_number": "60", "content_sanskrit": "नाधौतपादा प्रयता नार्द्रपान्नाप्युदक्शिराः। शयीत नापराङ् नान्यैर्न नग्ना न च सन्ध्ययोः॥ ६/१८/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 50012707, "chapter_id": 11496, "verse_number": "61", "content_sanskrit": "धौतवासा शुचिर्नित्यं सर्वमङ्गळसंयुता। पूजयेत् प्रातराशात् प्राग् गोविप्रान् श्रियमच्युतम्॥ ६/१८/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 50012708, "chapter_id": 11496, "verse_number": "62", "content_sanskrit": "स्त्रियो वरवतीश्चार्चेत् स्रग्गन्धबलिमण्डनैः। पतिं चार्च्योपतिष्ठेत ध्यायेत् कोष्ठगतं च तम्॥ ६/१८/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 50012709, "chapter_id": 11496, "verse_number": "63", "content_sanskrit": "संवत्सरं पुंसवनं व्रतमेतदविप्लुतम्। धारयिष्यसि चेत् तुभ्यं शत्रुहा भविता सुतः॥ ६/१८/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 50012710, "chapter_id": 11496, "verse_number": "64", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 50012711, "chapter_id": 11496, "verse_number": "65", "content_sanskrit": "बाढमित्यभ्युपेत्याथ दिती राजन् महामनाः। काश्यपात् गर्भमाधत्त व्रतं चाञ्जो दधार सा॥ ६/१८/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 50012712, "chapter_id": 11496, "verse_number": "66", "content_sanskrit": "मातृष्वसुरभिप्रायमिन्द्र आज्ञाय मानद। शुश्रूषणेनाश्रमस्थां दितिं पर्यचरत् कविः॥ ६/१८/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 50012713, "chapter_id": 11496, "verse_number": "67", "content_sanskrit": "नित्यं वनात् सुमनसः फलमूलसमित्कुशान्। पत्राङ्कुरमृदापश्च कालेकाल उपाहरत्॥ ६/१८/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 50012714, "chapter_id": 11496, "verse_number": "68", "content_sanskrit": "एवं तस्या व्रतस्थाया व्रतच्छिद्रं हरिर्नृप। प्रेप्सुः पर्यचरज्जिह्मो मृगहेव मृगाकृतिः॥ ६/१८/५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 50012715, "chapter_id": 11496, "verse_number": "69", "content_sanskrit": "नाध्यगच्छद् व्रतच्छिद्रं तत्परोऽथ महीपते। चिन्तां तीव्रां गतः शक्रः केन मे स्याच्छिवं त्विह॥ ६/१८/५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 50012716, "chapter_id": 11496, "verse_number": "70", "content_sanskrit": "एकदा सा तु सन्ध्यायामुच्छिष्टा व्रतकर्शिता। अस्पृष्टवार्यधौताङ्घ्रिः सुष्वाप विधिमोहिता॥ ६/१८/६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 50012717, "chapter_id": 11496, "verse_number": "71", "content_sanskrit": "लब्ध्वा तदन्तरं शक्रो निद्रोपहतचेतसः। दितेः प्रविष्ट उदरं योगेशो योगमायया॥ ६/१८/६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 50012718, "chapter_id": 11496, "verse_number": "72", "content_sanskrit": "चकर्त्त सप्तधा गर्भं वज्रेण कनकप्रभम्। रुदन्तं सप्तधैकैकं मा रोदीरिति तान् पुनः॥ ६/१८/६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 50012719, "chapter_id": 11496, "verse_number": "73", "content_sanskrit": "ते तमूचुः पाट्यमानाः सर्वे प्राञ्जलयो नृप। नो जिघांससि किं इन्द्र भ्रातरो मरुतस्तव॥ ६/१८/६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 50012720, "chapter_id": 11496, "verse_number": "74", "content_sanskrit": "मा भैष्ट भ्रातरो मह्यं यूयमित्याह कौशिकः। अनन्यभावान् पार्षदानात्मनो मरुतां गणान्॥ ६/१८/६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 50012721, "chapter_id": 11496, "verse_number": "75", "content_sanskrit": "न ममार दितेर्गर्भः श्रीनिवासानुकम्पया। बहुधा कुलिशक्षुण्णो द्रौण्यस्त्रेण यथा भवान्॥ ६/१८/६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 50012722, "chapter_id": 11496, "verse_number": "76", "content_sanskrit": "सकृदिष्ट्वाऽपि पुरुषं पुरुषो याति साम्यताम्। संवत्सरं किञ्चिदूनं दित्या यद्धरिरर्चितः॥ ६/१८/६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 50012723, "chapter_id": 11496, "verse_number": "77", "content_sanskrit": "सजूरिन्द्रेण पञ्चाशद् देवास्ते मरुतोऽभवन्। व्यपोह्य मातृदोषं ते हरिणा सोमपाः कृताः॥ ६/१८/६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 50012724, "chapter_id": 11496, "verse_number": "78", "content_sanskrit": "दितिरुत्थाय ददृशे कुमाराननलप्रभान्। इन्द्रेण सहितान् देवी पर्यतुष्यदनि⁄न्दता॥ ६/१८/६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 50012725, "chapter_id": 11496, "verse_number": "79", "content_sanskrit": "अथेन्द्रमाह ताताहमादित्यानां भयावहम्। अपत्यमिच्छन्त्यचरं व्रतमेतत् सुदुश्चरम्॥ ६/१८/६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 50012726, "chapter_id": 11496, "verse_number": "80", "content_sanskrit": "एकः सङ्काल्पतः पुत्रः सप्तसप्ताभवन् कथम्। यदि ते विदितं पुत्र सत्यं कथय मा मृषा॥ ६/१८/७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 50012727, "chapter_id": 11496, "verse_number": "81", "content_sanskrit": "अम्ब तेऽहं व्यवसितमुपधार्यागतोऽऽन्तकम्। लब्धान्तरोऽऽच्छनं गर्भमर्थबुद्धिर्न धर्मवित्॥ ६/१८/७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 50012728, "chapter_id": 11496, "verse_number": "82", "content_sanskrit": "कृतो मे सप्तधा गर्भ आसन् सप्त कुमारकाः। तेऽपि चैकैकशो वृक्णाः सप्तधा नापि मम्रिरे॥ ६/१८/७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 50012729, "chapter_id": 11496, "verse_number": "83", "content_sanskrit": "ततस्तत् परमाश्चर्यं वीक्ष्याध्यवसितं मया। महापुरुषपूजायाः सिद्धिः कार्यानुषङ्गिणी॥ ६/१८/७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 50012730, "chapter_id": 11496, "verse_number": "84", "content_sanskrit": "आराधनं भगवत ईहमाना निराशिषः। ये तु नेच्छन्त्यपि वरं ते स्वार्थकुशलाः स्मृताः॥ ६/१८/७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 50012731, "chapter_id": 11496, "verse_number": "85", "content_sanskrit": "आराध्यात्मप्रदं देवमात्मानं जगदीश्वरम्। को वृणीत गुणस्पर्शं बुधः स्यान्नरकेऽपि यत्॥ ६/१८/७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 50012732, "chapter_id": 11496, "verse_number": "86", "content_sanskrit": "तदिदं मम दौर्जन्यं बालिशस्य महीयसि। क्षन्तुमर्हसि मातस्त्वं दिष्ट्या गर्भोऽमृतोत्थितः॥ ६/१८/७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 50012733, "chapter_id": 11496, "verse_number": "87", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 50012734, "chapter_id": 11496, "verse_number": "88", "content_sanskrit": "इन्द्रस्तयाऽप्यनुज्ञातः शुक्ल्भावेन तुष्टया। मरुद्भिः सह तां नत्वा जगाम त्रिदिवं प्रभुः॥ ६/१८/७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 50012735, "chapter_id": 11496, "verse_number": "89", "content_sanskrit": "एवं ते सर्वमाख्यातं यन्मां त्वं प्ररिपृच्छसि। मङ्गळं मरुतां जन्म किं भूयः कथयामि ते॥ ६/१८/७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 50012736, "chapter_id": 11496, "verse_number": "90", "content_sanskrit": "इति श्रीमद्भागवते षष्ठस्कन्धे अष्टादशोऽध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}]