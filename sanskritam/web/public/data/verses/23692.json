[{"id": 7003692000, "chapter_id": 23692, "verse_number": "१-३-१३-१", "content_sanskrit": "ब्रह्मोवाच ।\nअथ गौरी पुरारातिं प्रणम्य जगदंबिका ।\nअयाचत्तादृशा शंभुमविनाभावमात्मनः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003692001, "chapter_id": 23692, "verse_number": "१-३-१३-२", "content_sanskrit": "इदं विज्ञापयामास लोकानुग्रहकारणात् ।\nकृपया परया पूर्णा गौरी संवादसुंदरी ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003692002, "chapter_id": 23692, "verse_number": "१-३-१३-३", "content_sanskrit": "न त्याज्यमेतत्ते रूपमत्र दृष्टिमनोहरम् ।\nअहं त्वया न च त्याज्या सापराधापि सर्वदा ।\nमनोहरमिदं रूपमेतत्ते लोकमंगलम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003692003, "chapter_id": 23692, "verse_number": "१-३-१३-४", "content_sanskrit": "आलोक्यतां सदा सर्वैर्दिव्यगन्धसमन्वितम् ।\nभुजंगगरलब्रह्मकपालशिवभस्मभिः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003692004, "chapter_id": 23692, "verse_number": "१-३-१३-५", "content_sanskrit": "भीषणैरलमीशान जय वेषपरिग्रहैः ।\nसुकुमारो भवेर्दिव्यमाल्यगंधांबरादिभिः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003692005, "chapter_id": 23692, "verse_number": "१-३-१३-६", "content_sanskrit": "भूषितो रत्नभूषाभिर्विहरस्व महेश्वर ।\nआगता नित्यमीशान देवगन्धर्वकन्यकाः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003692006, "chapter_id": 23692, "verse_number": "१-३-१३-७", "content_sanskrit": "सेवंतामत्र देवेशं नृत्यवादित्रगीतिभिः ।\nगणाश्च मानुषा भूत्वा सेवंतां त्वामहर्निशम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003692007, "chapter_id": 23692, "verse_number": "१-३-१३-८", "content_sanskrit": "त्वत्प्रसादादयं देव सुगंधिः पुष्टिवर्द्धनः ।\nआवयोः संगमो दृष्टो भूयात्सर्वार्थदायकः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003692008, "chapter_id": 23692, "verse_number": "१-३-१३-९", "content_sanskrit": "गृहीतमत्र देवेश सर्वमंत्रात्मकं वपुः ।\nचरितं तव कैंकर्यमस्तु भक्तिः सदा तव ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003692009, "chapter_id": 23692, "verse_number": "१-३-१३-१०", "content_sanskrit": "ज्ञानाज्ञानकृतं नित्यमपराधसहस्रकम् ।\nक्षम्यतां तव भक्तानामनन्यशरणेक्षणात् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003692010, "chapter_id": 23692, "verse_number": "१-३-१३-११", "content_sanskrit": "इति देव्या वचः श्रुत्वा शम्भुः शोणाचलेश्वरः ।\nतमेव वरदः प्रादाद्वरं सर्वमभीप्सितम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003692011, "chapter_id": 23692, "verse_number": "१-३-१३-१२", "content_sanskrit": "आभाष्य गौरीं कुतुकाद्रंतुकामः स्वयं शिवः ।\nधारय त्वं मृगमदं मनोज्ञमिदमूचिवान् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003692012, "chapter_id": 23692, "verse_number": "१-३-१३-१३", "content_sanskrit": "महादेव उवाच ।\nपुलकाख्यो महान्दैत्यो मृगरूपी तपोधिकम् ।\nकृत्वा प्राप वरं मत्तः सौगन्ध्यं परमाद्भुतम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003692013, "chapter_id": 23692, "verse_number": "१-३-१३-१४", "content_sanskrit": "लब्ध्वा वरं स्वगन्धेनामोहयत्सुरयोषितः ।\nतथैवाधर्मसंप्राप्तो बबाधे सकलं जगत् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003692014, "chapter_id": 23692, "verse_number": "१-३-१३-१५", "content_sanskrit": "देवैरभ्यर्थितः सोहमाहूयासुरनायकम् ।\nविमुंच लोकरक्षार्थमासुरं देहमित्यशाम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003692015, "chapter_id": 23692, "verse_number": "१-३-१३-१६", "content_sanskrit": "पुलक उवाच ।\nत्यक्ष्यामि देवदेवेश देहमेतं त्वदाज्ञया ।\nप्रणम्य भक्तिमनसा मामप्यर्चेदमूचिवान् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003692016, "chapter_id": 23692, "verse_number": "१-३-१३-१७", "content_sanskrit": "मदंगसंभवं दिव्यं सौरभं विश्वमोहनम् ।\nधार्यतां देव देवेश सदा सादरचेतसा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003692017, "chapter_id": 23692, "verse_number": "१-३-१३-१८", "content_sanskrit": "पुलकस्वेदजातो हि सदा प्रख्यायतां तव ।\nअयं मृगमदो लोके शृङ्गाररसवर्द्धनः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003692018, "chapter_id": 23692, "verse_number": "१-३-१३-१९", "content_sanskrit": "त्वत्प्रियः कांतिसौभाग्यरूपलावण्यदायकः ।\nविसृजामि निजं देहं देवदेव जगत्पते ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003692019, "chapter_id": 23692, "verse_number": "१-३-१३-२०", "content_sanskrit": "सदा बहुमतो देव्या दिव्यसौरभलुब्धया ।\nमदंशसंभवा ये स्युर्मत्तपोलब्धसौरभाः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003692020, "chapter_id": 23692, "verse_number": "१-३-१३-२१", "content_sanskrit": "लीयंतां तव देवेश मूर्तावालेपनच्छलात् ।\nतथेति मय्युक्तवति स दैत्यः पुलकाभिधः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003692021, "chapter_id": 23692, "verse_number": "१-३-१३-२२", "content_sanskrit": "विससर्ज निजं देहं मयिसन्यस्तजीवितः ।\nततस्तदंगसंभूतं मदं बहुलसौरभम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003692022, "chapter_id": 23692, "verse_number": "१-३-१३-२३", "content_sanskrit": "अधारयमहं प्रेम्णा शतशृंगारवर्द्धनम् ।\nतपसा देवदेवेशि तप्तं तव वपुः कृशम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003692023, "chapter_id": 23692, "verse_number": "१-३-१३-२४", "content_sanskrit": "मदंगं च वियोगात्त इदं निर्वापयाधुना ।\nइति प्रशस्य बहुधा पुलकस्नेहमद्भुतम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003692024, "chapter_id": 23692, "verse_number": "१-३-१३-२५", "content_sanskrit": "आलिलिंप महादेवः पार्वतीं प्रेममंदिराम् ।\nअपृच्छच्च हसन्देवः पार्वतीं ललनाकृतिम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003692025, "chapter_id": 23692, "verse_number": "१-३-१३-२६", "content_sanskrit": "किमेतदिति हस्तोत्थं दृष्ट्वा तं जगदंबिका ।\nअब्रवीदरुणाद्रीशमानम्य जगदंबिका ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003692026, "chapter_id": 23692, "verse_number": "१-३-१३-२७", "content_sanskrit": "आगतिं तस्य पुष्पस्य सदा स्वकरवर्तिनः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003692027, "chapter_id": 23692, "verse_number": "१-३-१३-२८", "content_sanskrit": "देव्युवाच ।\nअहं कैलासशिखराद्देवदेव त्वदाज्ञया ।\nतपः कर्तुमनुप्राप्ता कांचीं कनकतोरणाम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003692028, "chapter_id": 23692, "verse_number": "१-३-१३-२९", "content_sanskrit": "अवाप्य मानसोद्भूतं कह्लारमिदमुत्तमम् ।\nआराधयं महादेवमम्लानगुरुसौरभम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003692029, "chapter_id": 23692, "verse_number": "१-३-१३-३०", "content_sanskrit": "यदक्षयमविश्रांतमर्चनायोजितं मया ।\nअविच्छिन्नमहादीप्तिः कामधेनुघृताप्लुतः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003692030, "chapter_id": 23692, "verse_number": "१-३-१३-३१", "content_sanskrit": "अवेक्षणीयो भूपालैरनुपाल्यश्च सर्वदा ।\nधर्मलक्षणमाधेयं लोकरक्षार्थमादरात् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003692031, "chapter_id": 23692, "verse_number": "१-३-१३-३२", "content_sanskrit": "सर्वाभीप्सितसिद्ध्यर्थं मत्प्रीतिकरणाय च ।\nमया संस्थापिता धर्मा द्वात्रिंशल्लोकगुप्तये ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003692032, "chapter_id": 23692, "verse_number": "१-३-१३-३३", "content_sanskrit": "रक्षणीया प्रयत्नेन तत्संनिधिमुपागतैः ।\nसर्वालंकारसंयुक्तं सर्वभोगकृतोत्सवम् ।\nआलोक्यतामिदं रूपं कन्यायां मम कांतिमत् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003692033, "chapter_id": 23692, "verse_number": "१-३-१३-३४", "content_sanskrit": "ब्रह्मोवाच ।\nइति देव्या वचः श्रुत्वा शम्भुः शोणाचलेश्वरः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003692034, "chapter_id": 23692, "verse_number": "१-३-१३-३५", "content_sanskrit": "तथेति वरदः प्रादाद्वरं सर्वमभीप्सितम् ।\nएष शोणाचलः श्रीमान्दृश्यते लोकपूजितः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003692035, "chapter_id": 23692, "verse_number": "१-३-१३-३६", "content_sanskrit": "सर्वदा वरदागौर्या सर्वभोगैश्च संवृतः ।\nय एतच्छांभवं रूपमरुणाद्रितया स्थितम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003692036, "chapter_id": 23692, "verse_number": "१-३-१३-३७", "content_sanskrit": "संपश्यंति नमस्यंति कृतार्थाः सर्व एव ते ।\nअरुणाचलमाहात्म्यमेतच्छ्रण्वंति ये भुवि ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003692037, "chapter_id": 23692, "verse_number": "१-३-१३-३८", "content_sanskrit": "भवंति सततं तेषां समग्राः सर्वसंपदः ।\nश्रीमत्त्वं वाक्पतित्वं च रूपमव्याहतं बलम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003692038, "chapter_id": 23692, "verse_number": "१-३-१३-३९", "content_sanskrit": "लभंते पापनाशं च माहात्म्यस्यास्य धारणात् ।\nसर्वतीर्थाभिषवणं सर्वयज्ञक्रियाफलम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003692039, "chapter_id": 23692, "verse_number": "१-३-१३-४०", "content_sanskrit": "सदाशिवप्रसादं च दत्ते शोणाद्रिदर्शनम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003692040, "chapter_id": 23692, "verse_number": "१-३-१३-४१", "content_sanskrit": "इति कैलासशिखरात्प्राप्ता देवी शिवाज्ञया ।\nशापमोक्षगतवती शोणाचलनिरीक्षणात् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003692041, "chapter_id": 23692, "verse_number": "१-३-१३-४२", "content_sanskrit": "स्थानेष्वन्येषु देवस्य विद्यमानेषु च क्षितौ ।\nदिवि चात्यंतपुण्येषु शंभुरत्र प्रसेदिवान् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003692042, "chapter_id": 23692, "verse_number": "१-३-१३-४३", "content_sanskrit": "अयं सदाशिवः साक्षादरुणाचलरूपतः ।\nदृश्यते परमं तेजः सर्गस्थित्यंतकारणम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003692043, "chapter_id": 23692, "verse_number": "१-३-१३-४४", "content_sanskrit": "एतत्तु तैजसं लिगं सर्वदेवनमस्कृतम् ।\nदृश्यते कर्मभूरेषा तेन धर्माधिका मता ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003692044, "chapter_id": 23692, "verse_number": "१-३-१३-४५", "content_sanskrit": "अरुणाचलनाथस्य तेजसा धूतकल्मषाः ।\nभक्तिमंतो नरा लोके सुखमाप्स्यंति सर्वतः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003692045, "chapter_id": 23692, "verse_number": "१-३-१३-४६", "content_sanskrit": "प्रदक्षिणैर्नमस्कारैस्तपोभिर्नियमैरपि ।\nयेऽर्चयंत्यरुणाद्रीशं तेषां शंभुर्वशंगतः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003692046, "chapter_id": 23692, "verse_number": "१-३-१३-४७", "content_sanskrit": "न तथा तपसा योगैर्दानैः प्रीणाति शंकरः ।\nयथा सकृदपि प्राप्तादरुणाचलदर्शनात् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003692047, "chapter_id": 23692, "verse_number": "१-३-१३-४८", "content_sanskrit": "स्वयंभुवः सदा वेदाः सेतिहासा दिवि स्थिताः ।\nपरितो गिरिरूपास्ते स्तुवंत्यरुणपर्वतम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003692048, "chapter_id": 23692, "verse_number": "१-३-१३-४९", "content_sanskrit": "एतस्य वैभवं सर्वं न मया न च शार्ङ्गिणा ।\nवचसा शक्यते वक्तुं वर्षकोटिशतैरपि ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003692049, "chapter_id": 23692, "verse_number": "१-३-१३-५०", "content_sanskrit": "देवाश्च हरिमुख्यास्ते कल्पकाद्याः सुरद्रुमाः ।\nप्रच्छन्नरूपाः सेवंते सर्वदैवारुणाचलम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003692050, "chapter_id": 23692, "verse_number": "१-३-१३-५१", "content_sanskrit": "न तस्य कलिदोषः स्यान्नाधिव्याधिविजृंभणा ।\nयत्र संपूज्यते लिंगमरुणाचलसंज्ञितम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003692051, "chapter_id": 23692, "verse_number": "१-३-१३-५२", "content_sanskrit": "इत्येतत्कथितं सर्वं तव शंभुपदाश्रयम् ।\nचरितं ह्यरुणस्यास्य कल्पपुण्यदुरासदम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003692052, "chapter_id": 23692, "verse_number": "१-३-१३-५३", "content_sanskrit": "सूत उवाच ।\nइति विधिमुखनिःसृतामुदारामरुणगिरीशकथासुधापगां हि ।\nश्रुतिपुटयुगलात्पिबन्मनोज्ञां सनकमुनिस्तपसां फलं स लेभे ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]