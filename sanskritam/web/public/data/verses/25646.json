[{"id": 7005646000, "chapter_id": 25646, "verse_number": "११९-१", "content_sanskrit": "हिमवत्प्रदेशवर्णनम् ।\nसूत उवाच ।\nतत्र यौ तौ महाश्रृङ्गौ महावर्णौ महाहिमौ ।\nतृतीयन्तु तयोर्मध्ये श्रृङ्गमत्यन्तमुच्छ्रितम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005646001, "chapter_id": 25646, "verse_number": "११९-२", "content_sanskrit": "नित्यातप्तशिलाजालं सदाभ्रपरिवर्जितम् ।\nतस्याधस्ताद्‌वृक्षगणो दिशा भागे च पश्चिमे ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005646002, "chapter_id": 25646, "verse_number": "११९-३", "content_sanskrit": "जातीलतापरिक्षिप्तं विवरं चारुदर्शनम् ।\nद्रृष्टैव कौतुकाविष्टस्तं विवेश महीपतिः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005646003, "chapter_id": 25646, "verse_number": "११९-४", "content_sanskrit": "तमसा चातिनिबिडं नल्वमात्रं सुसङ्कटम् ।\nनल्वमात्रमतिक्रम्य स्वप्रभाभरणोज्ज्वलम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005646004, "chapter_id": 25646, "verse_number": "११९-५", "content_sanskrit": "तमुच्छ्रितमथात्यन्तं गम्भीरं परिवर्तुलम् ।\nन तत्र सूर्य्यस्तपति न विराजति चन्द्रमाः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005646005, "chapter_id": 25646, "verse_number": "११९-६", "content_sanskrit": "तथापि दिवसाकारं प्रकाशं तदहर्निशम् ।\nक्रोशाधिकपरीमाणं सरसाच विराजितम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005646006, "chapter_id": 25646, "verse_number": "११९-७", "content_sanskrit": "समन्तात्सरसस्तस्य शैललग्ना तु वेदिका ।\nसौवर्णे राजतैर्वृक्षैर्विद्रुमैरुपशोभितम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005646007, "chapter_id": 25646, "verse_number": "११९-८", "content_sanskrit": "नानामाणिक्यकुसुमैः सुप्रभाभरणोज्ज्वलैः ।\nतस्मिन् सरसि पद्मानि पद्मरागच्छदानि तु ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005646008, "chapter_id": 25646, "verse_number": "११९-९", "content_sanskrit": "वज्रकेसरजालानि सुगन्धीनि तथा युतम् ।\nपत्रैर्मरकतैर्नीलर्वैढूर्य्यस्य महीपते ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005646009, "chapter_id": 25646, "verse_number": "११९-१०", "content_sanskrit": "कर्णिकाश्च तथा तेषां जातरूपस्य पार्थिव ।\nतस्मिन् सरसि या भूमिर्न सा वज्रसमाकुला ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005646010, "chapter_id": 25646, "verse_number": "११९-११", "content_sanskrit": "नानारत्नैरुपचिता जलजानां समाश्रया ।\nकपर्दिकानां शुक्तीनां शङ्कानाञ्च महीपते! ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005646011, "chapter_id": 25646, "verse_number": "११९-१२", "content_sanskrit": "मकराणाञ्च मत्स्यानां चण्डानां कच्छपैः सह ।\nतत्र मरकतखण्डानि वज्राणाञ्च सहस्रशः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005646012, "chapter_id": 25646, "verse_number": "११९-१३", "content_sanskrit": "पद्मरागेन्द्रनीलानि महानीलानि पार्थिव ।\nपुष्परागाणि सर्वाणि तथा कर्कोटकानि च ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005646013, "chapter_id": 25646, "verse_number": "११९-१४", "content_sanskrit": "तुत्थकस्य तु खण्डानि तथाशेषस्य भागशः ।\nराजावर्तस्य मुख्यस्य रुचिराक्षस्य चाप्यथ ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005646014, "chapter_id": 25646, "verse_number": "११९-१५", "content_sanskrit": "सूर्य्येन्दुकान्तयश्चैव नीलो वर्णान्तिमश्च यः ।\nज्योतीरसस्य रम्यस्य स्यमन्तस्य च भागशः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005646015, "chapter_id": 25646, "verse_number": "११९-१६", "content_sanskrit": "सुरोरगवलक्षाणां स्फटिकस्य तथैव च ।\nगोमेदपित्तकानाञ्च धूलीमरकतस्य च ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005646016, "chapter_id": 25646, "verse_number": "११९-१७", "content_sanskrit": "वैढूर्यसौगन्धिकयस्तथा राजमणेर्नृप ।\nवज्रस्यैव च मुख्यस्य तथा ब्रह्ममणेरपि ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005646017, "chapter_id": 25646, "verse_number": "११९-१८", "content_sanskrit": "मुक्ताफलानि मुक्तानान्ताराविग्रहधारिणाम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005646018, "chapter_id": 25646, "verse_number": "११९-१९", "content_sanskrit": "सुखोष्णञ्चैव तत्तोयं स्नानाच्छीतविनाशनम् ।\nवैढूर्यस्य शिलामध्ये सरसस्तस्य शोभना ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005646019, "chapter_id": 25646, "verse_number": "११९-२०", "content_sanskrit": "प्रमाणेन तथा सा च द्वे च राजन्! धनुः शते ।\nचतुरस्रा तथा रम्या तपसा निर्मिताऽत्रिणा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005646020, "chapter_id": 25646, "verse_number": "११९-२१", "content_sanskrit": "बिलद्वारसमो देशो यत्र तत्र हिरण्मयः ।\nप्रदेशः स तु राजेन्द्र! द्वीपे तस्मिन् मनोहरे ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005646021, "chapter_id": 25646, "verse_number": "११९-२२", "content_sanskrit": "तथा पुष्करिणी रम्या तस्मिन् राजन्! शिलातले ।\nसुशीतामलपानीया जलजैश्च विराजिता ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005646022, "chapter_id": 25646, "verse_number": "११९-२३", "content_sanskrit": "आकाशप्रतिमा राजन्! चतुरस्रा मनोहरा ।\nतस्यास्तदुदकं स्वादु लघुशीतं सुगन्धिकम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005646023, "chapter_id": 25646, "verse_number": "११९-२४", "content_sanskrit": "न क्षिणोति यथा कण्ठं कुक्षिन्नापूरयत्यपि ।\nतृप्तिं विधत्ते परमां शरीरे च महत् सुखम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005646024, "chapter_id": 25646, "verse_number": "११९-२५", "content_sanskrit": "मध्ये तु तस्याः प्रासादं निर्मितं तपसात्रिणा ।\nरुक्मसेतुप्रवेशान्तं सर्वरत्नमयं शुभम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005646025, "chapter_id": 25646, "verse_number": "११९-२६", "content_sanskrit": "इन्द्रनीलमहास्तम्भं मरकतासक्तवेदिकम् ।\nवज्रांशुजालैः स्फुरितं रम्यं द्रृष्टिमनोरमम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005646026, "chapter_id": 25646, "verse_number": "११९-२७", "content_sanskrit": "प्रासादे तत्र भगवान् देवदेवो जनार्दनः ।\nभोगिभोगावलीसुप्तः सर्वालङ्कारभूषितः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005646027, "chapter_id": 25646, "verse_number": "११९-२८", "content_sanskrit": "जान्वाचकुञ्चितस्त्वेको देवदेवस्य चक्रिणः ।\nफणीन्द्रसन्निविष्टोऽङ्‌घ्रिर्द्वितीयश्च तथानघ ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005646028, "chapter_id": 25646, "verse_number": "११९-२९", "content_sanskrit": "लक्ष्म्युत्सङ्गगतोऽङ्घ्रिस्तु शेषभोगप्रशायिनः ।\nफणीन्द्रभोगसन्यस्तबाहुः केयूरभूषणः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005646029, "chapter_id": 25646, "verse_number": "११९-३०", "content_sanskrit": "अङ्गुलीपृष्ठविन्यस्तदेवशीर्षधरम्भुजम् ।\nएकं वै देवदेवस्य द्वितीयन्तु प्रसारितम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005646030, "chapter_id": 25646, "verse_number": "११९-३१", "content_sanskrit": "समाकुञ्चितजानुस्थमणिबन्धेन शोभितम् ।\nकिञ्चिदाकुञ्चितं चैव नाभिदेशकरस्थितम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005646031, "chapter_id": 25646, "verse_number": "११९-३२", "content_sanskrit": "तृतीयन्तु भुजं तस्य चतुर्थन्तु तथा श्रृणु ।\nआत्तसन्तानकुसुमं घ्राणदेशानुसर्पिणम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005646032, "chapter_id": 25646, "verse_number": "११९-३३", "content_sanskrit": "लक्ष्म्या सवाह्यमानाङ्‌घ्रिः पद्मपत्रनिभेः करैः ।\nसन्तानमालामुकुटं हारकेयूरभूषितम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005646033, "chapter_id": 25646, "verse_number": "११९-३४", "content_sanskrit": "भूषितञ्च तथा देवमङ्गदैरङ्गुलीयकैः ।\nफणीन्द्रफणविन्यस्तचारुरत्नशिरोज्ज्वलम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005646034, "chapter_id": 25646, "verse_number": "११९-३५", "content_sanskrit": "अज्ञातवस्तुचरितं प्रतिष्ठितमथात्रिणा ।\nसिद्धानुपूज्यं सततं सन्तानकुसुमार्चितम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7005646035, "chapter_id": 25646, "verse_number": "११९-३६", "content_sanskrit": "दिव्यगन्धानुलिप्ताङ्गं दिव्यधूपेन धूपितम् ।\nसुरसैः सुफलैर्हृद्यैः सिद्धेरुपहृतैः सदा ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7005646036, "chapter_id": 25646, "verse_number": "११९-३७", "content_sanskrit": "शोभितोत्तमपार्श्वन्तं देवमुत्पलशीर्षकम् ।\nततः सन्मुखमुद्वीक्ष्य ववन्दे स नराधिपः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7005646037, "chapter_id": 25646, "verse_number": "११९-३८", "content_sanskrit": "जानुभ्यां शिरसा चैव गत्वा भूमिं यथाविधिः ।\nनाम्नां सहस्रेण तदा तुष्टाव मधुसूदनम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7005646038, "chapter_id": 25646, "verse_number": "११९-३९", "content_sanskrit": "प्रदक्षिणमथो चक्रे स तूत्थाय पुनः पुनः ।\nरम्यमायतनं द्रृष्ट्वा तत्रोवासाश्रमे पुनः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7005646039, "chapter_id": 25646, "verse_number": "११९-४०", "content_sanskrit": "जलाद्‌बहिर्गुहां काञ्चिदाश्रित्य सुमनोहराम् ।\nतपश्चकार तत्रैव पूजयन्‌ मधुसूदनम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7005646040, "chapter_id": 25646, "verse_number": "११९-४१", "content_sanskrit": "नानाविधैस्तथा पुष्पैः फलमूलैः सगोरसैः ।\nनित्यं त्रिषवणस्नायी वह्निपूजापरायणः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7005646041, "chapter_id": 25646, "verse_number": "११९-४२", "content_sanskrit": "देववापीजलैः कुर्वन् सततं प्राणधारणम् ।\nसर्वाहारपरित्यागं कृत्वा तु मनुजेश्वरः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7005646042, "chapter_id": 25646, "verse_number": "११९-४३", "content_sanskrit": "अनास्तृतगुहाशायी कालं नयति पार्थिवः ।\nत्यक्ताहारक्रियश्चैव केवलं तोयतो नृपः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7005646043, "chapter_id": 25646, "verse_number": "११९-४४", "content_sanskrit": "न तस्य ग्लानिमायाति शरीरञ्च तदद्‌भुतम् ।\nएवं स राजा तपसि प्रसक्तः सम्पूजयन् देववरं सदैव ।\nतत्राश्रमे कालमुवास कञ्चित् स्वर्गोपमे दुःखमविन्दमानः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]