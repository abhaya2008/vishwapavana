[{"id": 2100674, "chapter_id": 3161, "verse_number": "१४-१७-१", "content_sanskrit": "जनमेजय उवाच।\nसभायां वसतोस्तत्र निहत्यारीन्महात्मनोः।\nकेशवार्जुनयोः का नु कथा समभवद्द्विज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2100675, "chapter_id": 3161, "verse_number": "१४-१७-२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2100676, "chapter_id": 3161, "verse_number": "१४-१७-२", "content_sanskrit": "कृष्णेन सहितः पार्थः स्वं राज्यं प्राप्य केवलम्।\nतस्यां सभायां दिव्यायां विजहार मुदा युतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2100677, "chapter_id": 3161, "verse_number": "१४-१७-३", "content_sanskrit": "तत्र कञ्चित्सभोद्देशं स्वर्गोद्देशसमं नृप।\nयदृच्छया तौ मुदितौ जग्मतुः स्वजनावृतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2100678, "chapter_id": 3161, "verse_number": "१४-१७-४", "content_sanskrit": "ततः प्रतीतः कृष्णेन सहितः पाण्डवोऽर्जुनः।\nनिरीक्ष्य तां सभां रम्यामिदं वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2100679, "chapter_id": 3161, "verse_number": "१४-१७-५", "content_sanskrit": "विदितं मे महाबाहो सङ्ग्रामे समुपस्थिते।\nमहात्म्यं देवकीपुत्र तच्च ते रूपमैश्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2100680, "chapter_id": 3161, "verse_number": "१४-१७-६", "content_sanskrit": "यत्तु तद्भवता प्रोक्तं पुरा केशव सौहृदात्।\nतत्सर्वं पुरुषव्याघ्र नष्टं मे व्यग्रचेतसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2100681, "chapter_id": 3161, "verse_number": "१४-१७-७", "content_sanskrit": "मम कौतूहलं त्वस्ति तेष्वर्थेषु पुनः पुनः।\nभवांस्तु द्वारकां गन्ता नचिरादिव माधव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2100682, "chapter_id": 3161, "verse_number": "१४-१७-८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2100683, "chapter_id": 3161, "verse_number": "१४-१७-८", "content_sanskrit": "एवमुक्तस्तु तं कृष्णः फाल्गुनं प्रत्यभाषत।\nपरिष्वज्य महातेजा वचनं वदतांवरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2100684, "chapter_id": 3161, "verse_number": "१४-१७-९x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2100685, "chapter_id": 3161, "verse_number": "१४-१७-९", "content_sanskrit": "श्रावितस्त्वं मया गुह्यं ज्ञापितश्च सनातनम्।\nधर्मं स्वरूपिणं पार्त सर्वलोकांश्च शाश्वतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2100686, "chapter_id": 3161, "verse_number": "१४-१७-१०", "content_sanskrit": "अबुद्ध्या यन्न गृह्णीतास्तन्मे सुमहदप्रियम्।\nन च साऽद्य पुनर्भूयः स्मृतिर्मे सम्भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2100687, "chapter_id": 3161, "verse_number": "१४-१७-११", "content_sanskrit": "नूनमश्रद्दधानोऽसि दुर्मेधा ह्यसि पाण्डव।\nन च शक्यं पुनर्वक्तुमशेषेण धनंजय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2100688, "chapter_id": 3161, "verse_number": "१४-१७-१२", "content_sanskrit": "स हि धर्मः सुपर्याप्तो ब्रह्मणः पदवेदने।\nन शक्यं तन्मया भूयस्तथा वक्तुमशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2100689, "chapter_id": 3161, "verse_number": "१४-१७-१३", "content_sanskrit": "परं हि ब्रह्म कथितं योगयुक्तेन तन्मया।\nइतिहासं तु वक्ष्यामि तस्मिन्नर्थे पुरातनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2100690, "chapter_id": 3161, "verse_number": "१४-१७-१४", "content_sanskrit": "यथा तां बुद्धिमास्थाय गतिमग्र्यां गमिष्यसि।\nशृणु धर्मभृतांश्रेष्ठ गदतः सर्वमेव मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2100691, "chapter_id": 3161, "verse_number": "१४-१७-१५", "content_sanskrit": "आगच्छद्ब्राह्मणः कश्चित्स्वर्गलोकादरिंदम।\nब्रह्मलोकाच्च दुर्धर्षः सोस्माभिः पूजितोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2100692, "chapter_id": 3161, "verse_number": "१४-१७-१६", "content_sanskrit": "अस्माभिः परिपृष्ठश्च यदाह भरतर्षभ।\nदिव्येन विधिना पार्थ तच्छृणुष्वाविचारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2100693, "chapter_id": 3161, "verse_number": "१४-१७-१७x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2100694, "chapter_id": 3161, "verse_number": "१४-१७-१७", "content_sanskrit": "मोक्षधर्मं समाश्रित्य कृष्ण यन्माऽनुपृच्छसि।\nभूतानामनुकम्पार्थं मन्मोहच्छेदनं विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2100695, "chapter_id": 3161, "verse_number": "१४-१७-१८", "content_sanskrit": "तत्तेऽहं सम्प्रवक्ष्यामि यथावन्मधुसूदन।\nशृणुष्वावहितो भूत्वा गदतो मम माधव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2100696, "chapter_id": 3161, "verse_number": "१४-१७-१९", "content_sanskrit": "कश्चिद्विप्रस्तपोयुक्तः काश्यपो धर्मवित्तमः।\nआससाद द्विजं कंचिद्धर्माणामागतागमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2100697, "chapter_id": 3161, "verse_number": "१४-१७-२०", "content_sanskrit": "गतागमं सुबहुशो ज्ञानविज्ञानपारगम्।\nलोकतत्त्वार्थकुशलं ज्ञातरं सुखदुःखयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2100698, "chapter_id": 3161, "verse_number": "१४-१७-२१", "content_sanskrit": "जातिस्मरणतत्त्वज्ञं कोविदं पापपुण्ययोः।\nद्रष्टारमुच्चनीचानां कर्मभिर्देहिनां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2100699, "chapter_id": 3161, "verse_number": "१४-१७-२२", "content_sanskrit": "चरन्तं मुक्तवत्सिद्धं प्रशान्तं संयतेन्द्रियम्।\nदीप्यमानं श्रिया ब्राह्मया क्रममाणं च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2100700, "chapter_id": 3161, "verse_number": "१४-१७-२३", "content_sanskrit": "अन्तर्धानगतिज्ञं च श्रुत्वा तत्त्वेन काश्यपः।\nतथैवान्तर्हितैः सिद्धैर्यान्तं चक्रधरैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2100701, "chapter_id": 3161, "verse_number": "१४-१७-२४", "content_sanskrit": "सम्भाषमाणमेकान्ते समासीनं च तैः सह।\nयदृच्छया च गच्छन्तमसक्तं पवनं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2100702, "chapter_id": 3161, "verse_number": "१४-१७-२५", "content_sanskrit": "तं समासाद्य मेधावी स तदा द्विजसत्तमः।\nचरणौ धर्मकामो वै स तस्य सुसमाहितः।\nप्रतिपदे यथान्यायं भक्त्या परमया युतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2100703, "chapter_id": 3161, "verse_number": "१४-१७-२६", "content_sanskrit": "विस्मितश्चाद्भुतं दृष्ट्वा काश्यपस्तं द्विजोत्तमम्।\nपरिचारेण महता गुरुं तं पर्यतोषयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2100704, "chapter_id": 3161, "verse_number": "१४-१७-२७", "content_sanskrit": "उपपन्नं च तत्सर्वं श्रुतचारित्रसंयुतम्।\nभौमेनातोषयच्चैनं गुरुवृत्तिं समास्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2100705, "chapter_id": 3161, "verse_number": "१४-१७-२८", "content_sanskrit": "तस्मै तुष्टः स शिष्याय यत्प्रसन्नोऽब्रवीद्गुरुः।\nसिद्धिं परामभिप्रेक्ष्य शृणु मत्तो जनार्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2100706, "chapter_id": 3161, "verse_number": "१४-१७-२९x", "content_sanskrit": "सिद्ध उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2100707, "chapter_id": 3161, "verse_number": "१४-१७-२९", "content_sanskrit": "विविधैः कर्मभिस्तात पुण्ययोगैश्च केवलैः।\nगच्छन्तीह गतिं मर्त्या देवलोके च वा स्थितिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2100708, "chapter_id": 3161, "verse_number": "१४-१७-३०", "content_sanskrit": "न क्वचित्सुखमत्यन्तं न क्वचिच्छाश्वती स्थितिः।\nस्थानाच्च महतो भ्रंशो दुःखलब्दात्पुनः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2100709, "chapter_id": 3161, "verse_number": "१४-१७-३१", "content_sanskrit": "अशुभा गतयः प्राप्ताः कष्टा मे पापसेवनात्।\nकाममन्युपरीतेन तृष्णया मोहितेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2100710, "chapter_id": 3161, "verse_number": "१४-१७-३२", "content_sanskrit": "पुनः पुनश्च मरणं जन्म चैव पुनः पुनः।\nआहारा विविधा भुक्ताःपीता नानाविधाःस्तनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2100711, "chapter_id": 3161, "verse_number": "१४-१७-३३", "content_sanskrit": "मातरो विविधा दृष्टाः पितरश्च पृथग्विधाः।\nसुखानि च विचित्राणि दुःखानि च मयाऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2100712, "chapter_id": 3161, "verse_number": "१४-१७-३४", "content_sanskrit": "प्रियैर्विवासो बहुशः संवासश्चाप्रियैः सह।\nधननाशश्च सम्प्राप्तो लब्ध्वा दुःखेन तद्धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2100713, "chapter_id": 3161, "verse_number": "१४-१७-३५", "content_sanskrit": "अवमानाः सुकष्टाश्च परतः स्वजनात्तथा।\nशारीरा मानसा वाऽपि वेदना भृशदारुणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2100714, "chapter_id": 3161, "verse_number": "१४-१७-३६", "content_sanskrit": "प्राप्ता विमाननाश्चोग्रा वधबन्धाश्च दारुणाः।\nपतनं निरये चैव यातनाश्च यमक्षये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2100715, "chapter_id": 3161, "verse_number": "१४-१७-३७", "content_sanskrit": "जरारोगाश्च सततं व्यसनानि च भूरिशः।\nलोकेऽस्मिन्ननुभूतानि द्वन्द्वजानि भृशं मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2100716, "chapter_id": 3161, "verse_number": "१४-१७-३८", "content_sanskrit": "ततः कदाचिन्निर्वेदान्निकारान्निकृतेन च।\nलोकतन्त्रं परित्यक्तं दुःखार्तेन भृशं मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2100717, "chapter_id": 3161, "verse_number": "१४-१७-३९", "content_sanskrit": "लोकेऽस्मिन्ननुभूयाहमिमं मार्गमनुष्ठितः।\nततः सिद्धिरियं प्राप्ता प्रसादादात्मनो मया।\nनाहं पुनरिहागन्ता लोकानालोकयाम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2100718, "chapter_id": 3161, "verse_number": "१४-१७-४०", "content_sanskrit": "आसिद्धेराप्रजासर्गादात्मनोपि गतीः शुभाः।\nउपलब्धा द्विजश्रेष्ठ तथेयं सिद्धिरुत्तमा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2100719, "chapter_id": 3161, "verse_number": "१४-१७-४१", "content_sanskrit": "इतः परं गमिष्यामि ततः परतरं पुनः।\nब्रह्मणः पदमव्यक्तं मा तेऽभूतत्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2100720, "chapter_id": 3161, "verse_number": "१४-१७-४२", "content_sanskrit": "नाहं पुनरिहागन्ता मर्त्यलोकं परन्तप।\nप्रीतोस्मि ते महाप्राज्ञ ब्रूहि किं करवाणि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2100721, "chapter_id": 3161, "verse_number": "१४-१७-४३", "content_sanskrit": "यदीप्सुरुपपन्नस्त्वं तस्य कालोऽयमागतः।\nअभिजाने च तदहं यदर्थं मामुपागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2100722, "chapter_id": 3161, "verse_number": "१४-१७-४४", "content_sanskrit": "अचिरात्तु गमिष्यामि येनाहं त्वामचूचुदम्।\nभृशं प्रीतोस्मि भवतश्चारित्रेण विचक्षण॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2100723, "chapter_id": 3161, "verse_number": "१४-१७-४५", "content_sanskrit": "परिपृच्छ यावद्भवतो भाषे यद्यत्तवेप्सितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2100724, "chapter_id": 3161, "verse_number": "१४-१७-४६", "content_sanskrit": "बहुमन्ये च ते बुद्धिं भृशं सम्पूजयामि च।\nयेनाहं भवता बुद्धो मेधावी ह्यसि काश्यप॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2100725, "chapter_id": 3161, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि सप्तदशोऽध्यायः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]