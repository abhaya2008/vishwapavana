[{"id": 6000206000, "chapter_id": 10206, "verse_number": null, "content_sanskrit": "अथ दशमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000206001, "chapter_id": 10206, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_010/BhP_10.010.001.m4a", "display_order": 2}, {"id": 6000206002, "chapter_id": 10206, "verse_number": "१०-१०-१", "content_sanskrit": "एकदा गृहदासीषु यशोदा नन्दगेहिनी।\nकर्मान्तरनियुक्तासु निर्ममन्थ स्वयं दधि॥ १०/१०/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_010/BhP_10.010.002.m4a", "display_order": 3, "topics": [{"text": "स्तनं पिबन्तमतृप्तं श्रीकृष्णं त्यक्त्वा उत्सिच्यमानं क्षीरं चुल्ल्या अवतारयितुं यशोदायां गतायां श्रीकृष्णेन दधिपात्रभञ्जनम्", "range": "१–८"}]}, {"id": 6000206003, "chapter_id": 10206, "verse_number": "१०-१०-२", "content_sanskrit": "यानि यानीह गीतानि तद्बालचरितानि च।\nदधिनिर्मथने काले स्मरन्ती तान्यगायत॥ १०/१०/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_010/BhP_10.010.003.m4a", "display_order": 4}, {"id": 6000206004, "chapter_id": 10206, "verse_number": "१०-१०-३", "content_sanskrit": "क्षौमं वासः पृथुकटितटे बिभ्रती सूत्रनद्धं पुत्रस्नेहस्रुतकुचयुगं जातकम्पं च सुभ्रूः।\nरज्ज्वाकर्षश्रमभुजचलत्कङ्कणौ कुण्डले च स्विन्नं वक्त्रं कबरविगलन्मालती निर्ममन्थ॥ १०/१०/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_010/BhP_10.010.004.m4a", "display_order": 5}, {"id": 6000206005, "chapter_id": 10206, "verse_number": "१०-१०-४", "content_sanskrit": "तां स्तन्यकाम आसाद्य मथ्नन्तीं जननीं हरिः।\nगृहीत्वा दधिमन्थानं न्यषेधत् प्रीतिमावहन्॥ १०/१०/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_010/BhP_10.010.005.m4a", "display_order": 6}, {"id": 6000206006, "chapter_id": 10206, "verse_number": "१०-१०-५", "content_sanskrit": "तमङ्कमारूढमपाययत् स्तनं स्नेहस्नुतं सस्मितमीक्षती मुखम्।\nअतृप्तमुत्सृज्य जवेन सा ययावुत्सिच्यमाने पयसि त्वधिश्रिते॥ १०/१०/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_010/BhP_10.010.006.m4a", "display_order": 7}, {"id": 6000206007, "chapter_id": 10206, "verse_number": "१०-१०-६", "content_sanskrit": "सञ्जातकोपः स्फुरितारुणाधरं सन्दश्य दद्भिर्दधिमण्डभाजनम्।\nभित्त्वा मृषाश्रुर्दृषदश्मना रहो जघास हैयङ्गवमन्तरं गतः॥ १०/१०/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_010/BhP_10.010.007.m4a", "display_order": 8}, {"id": 6000206008, "chapter_id": 10206, "verse_number": "१०-१०-७", "content_sanskrit": "उत्तार्य गोपी सुशृतं पयः पुनः प्रविश्य सन्दृश्य च दध्यमत्रकम्।\nभग्नं विलोक्य स्वसुतस्य कर्म तज्जहास तं चापि न तत्र पश्यती॥ १०/१०/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_010/BhP_10.010.008.m4a", "display_order": 9}, {"id": 6000206009, "chapter_id": 10206, "verse_number": "१०-१०-८", "content_sanskrit": "उलूखलाङ्घ्रेरुपरि व्यवस्थितं मर्काय कामं ददतं यथेप्सितम्।\nहैयङ्गवं चौर्यविशङ्कितेक्षणं निरीक्ष्य पश्चात् सुतमागमच्छनैः॥ १०/१०/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_010/BhP_10.010.009.m4a", "display_order": 10}, {"id": 6000206010, "chapter_id": 10206, "verse_number": "१०-१०-९", "content_sanskrit": "तामात्तयष्टिं प्रसमीक्ष्य सत्वरस्ततोऽवरुह्याभिससार भीतवत्।\nगोप्यन्वधावन्न यमास योगिनां क्षमं प्रवेष्टुं तपसेरितं मनः॥ १०/१०/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_010/BhP_10.010.010.m4a", "display_order": 11, "topics": [{"text": "गोप्यां कृष्णमुलूखले बद्ध्वा गृहकर्मव्यग्रायां नलकूबरमोचनाय कृष्णस्य बहिर्गमनम्", "range": "९–२३"}]}, {"id": 6000206011, "chapter_id": 10206, "verse_number": "१०-१०-१०", "content_sanskrit": "अन्वञ्चमाना जननी बृहच्चलच्छ्रोणीभराक्रान्तगतिः सुमध्यमा।\nजवेन विभ्रंशितकेशबन्धनच्युतप्रसूनानुगतिः परामृशत्॥ १०/१०/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_010/BhP_10.010.011.m4a", "display_order": 12}, {"id": 6000206012, "chapter_id": 10206, "verse_number": "१०-१०-११", "content_sanskrit": "कृतागसं तं प्ररुदन्तमक्षिणी कषन्तमञ्जन्मषिणी स्वपाणिना।\nउद्वीक्षमाणं भयविह्वलेक्षणं हस्ते गृहीत्वा भिषयन्त्यवागुरत्॥ १०/१०/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_010/BhP_10.010.012.m4a", "display_order": 13}, {"id": 6000206013, "chapter_id": 10206, "verse_number": "१०-१०-१२", "content_sanskrit": "त्यक्त्वा यष्टिं सुतं भीतं विज्ञायार्भकवत्सला।\nइयेष किल तं बन्धुं दाम्नाऽतद्वीर्यकोविदा॥ १०/१०/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_010/BhP_10.010.013.m4a", "display_order": 14}, {"id": 6000206014, "chapter_id": 10206, "verse_number": "१०-१०-१३", "content_sanskrit": "न चान्तर्न बहिर्यस्य न पूर्वं नापि चापरम्।\nपूर्वापरं बहिश्चान्तर्जगतो यो जगन्मयः॥ १०/१०/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_010/BhP_10.010.014.m4a", "display_order": 15}, {"id": 6000206015, "chapter_id": 10206, "verse_number": "१०-१०-१४", "content_sanskrit": "तं मत्वाऽर्भकमव्यक्तं मर्त्यलिङ्गमधोक्षजम्।\nगोपिकोलूखले दाम्ना बबन्ध प्राकृतं यथा॥ १०/१०/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_010/BhP_10.010.015.m4a", "display_order": 16}, {"id": 6000206016, "chapter_id": 10206, "verse_number": "१०-१०-१५", "content_sanskrit": "तद्दाम बध्यमानस्य स्वार्भकस्य कृतागसः।\nद्व्यङ्गुलोनमभूत् तेन सन्दधेऽन्यच्च गोपिका॥ १०/१०/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_010/BhP_10.010.016.m4a", "display_order": 17}, {"id": 6000206017, "chapter_id": 10206, "verse_number": "१०-१०-१६", "content_sanskrit": "यदाऽऽसीत् तदपि न्यूनं तेनान्यदपि सन्दधे।\nतदपि द्व्यङ्गुलं न्यूनं यद्यदादत्त बन्धनम्॥ १०/१०/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_010/BhP_10.010.017.m4a", "display_order": 18}, {"id": 6000206018, "chapter_id": 10206, "verse_number": "१०-१०-१७", "content_sanskrit": "एवं स्वगेहदामानि यशोदा सन्दधत्यपि।\nगोपीनां सुस्मयन्तीनां स्मयन्ती विस्मिताऽभवत्॥ १०/१०/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_010/BhP_10.010.018.m4a", "display_order": 19}, {"id": 6000206019, "chapter_id": 10206, "verse_number": "१०-१०-१८", "content_sanskrit": "स्वमातुः स्विन्नगात्राया विस्रस्तकबरस्रजः।\nदृष्ट्वा परिश्रमं कृष्णः कृपयाऽऽसीत् स्वबन्धने॥ १०/१०/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_010/BhP_10.010.019.m4a", "display_order": 20}, {"id": 6000206020, "chapter_id": 10206, "verse_number": "१०-१०-१९", "content_sanskrit": "एवं सन्दर्शिता ह्यङ्ग हरिणा भक्तवश्यता।\nस्ववशेनापि कृष्णेन यस्येदं सेश्वरं वशे॥ १०/१०/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_010/BhP_10.010.020.m4a", "display_order": 21}, {"id": 6000206021, "chapter_id": 10206, "verse_number": "१०-१०-२०", "content_sanskrit": "नेमं विरिञ्चिर्न भवो न श्रीरप्यङ्गसंश्रया।\nप्रसादं लेभिरे गोप्यो यत् तत् प्राप विमुक्तिदात्॥ १०/१०/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_010/BhP_10.010.021.m4a", "display_order": 22}, {"id": 6000206022, "chapter_id": 10206, "verse_number": "१०-१०-२१", "content_sanskrit": "नायं सुखाप्यो भगवान् देहिनां गोपिकासुतः।\nज्ञानिनां चात्मपोतानां यथा भक्तिमतामिह॥ १०/१०/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_010/BhP_10.010.022.m4a", "display_order": 23}, {"id": 6000206023, "chapter_id": 10206, "verse_number": "१०-१०-२२", "content_sanskrit": "कृष्णस्तु गृहकृत्येषु व्यग्रायां मातरि प्रभुः।\nअद्राक्षीदर्जुनौ पूर्वं गुह्यकौ धनदात्मजौ॥ १०/१०/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_010/BhP_10.010.023.m4a", "display_order": 24}, {"id": 6000206024, "chapter_id": 10206, "verse_number": "१०-१०-२३", "content_sanskrit": "पुरा नारदशापात् तौ वृक्षतां प्रापितौ मदात्।\nनलकूबरमणिग्रीवाविति ख्यातौ श्रियाऽन्वितौ॥ १०/१०/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_010/BhP_10.010.024.m4a", "display_order": 25}, {"id": 6000206025, "chapter_id": 10206, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्धपूर्वार्धे दशमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]