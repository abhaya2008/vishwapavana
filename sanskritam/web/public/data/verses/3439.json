[{"id": 2113345, "chapter_id": 3439, "verse_number": "", "content_sanskrit": "वैश्मपायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2113346, "chapter_id": 3439, "verse_number": "१", "content_sanskrit": "जाते बलवतां श्रेष्ठे पाण्डुश्चिन्तापरोऽभवत् ।\nकथमन्यो मम सुतो लोके श्रेष्ठो भवेदिति\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2113347, "chapter_id": 3439, "verse_number": "२", "content_sanskrit": "दैवं पुरुषकारश्च यत्र लोकः प्रतिष्ठितः ।\nयत्र देवात्तु तपसा लप्स्ये पुत्रं महाबलम् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2113348, "chapter_id": 3439, "verse_number": "३", "content_sanskrit": "इन्द्रो हि राजा देवानां प्रधान इति मे श्रुतः ।\nअप्रमेयबलोत्साहो वीर्यवानुत्तमद्युतिः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2113349, "chapter_id": 3439, "verse_number": "४", "content_sanskrit": "तं तोषयित्वा तपसा पुत्रं लप्स्ये महाबलम् ।\nयं दास्यति स नः पुत्रं स प्रधानो भविष्यति \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2113350, "chapter_id": 3439, "verse_number": "५", "content_sanskrit": "अमानुषान् मानुषांश्च स सङ्ग्रामे हनिष्यति ।\nतपसा कर्मणा चैव तस्मात् तप्स्ये महत् तपः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2113351, "chapter_id": 3439, "verse_number": "६", "content_sanskrit": "ततः पाण्डुस्तु राजर्षिः मन्त्रयित्वा महर्षिभिः ।\nआदिश्य कुन्त्याः कौरव्य व्रतं सांवत्सरं शुभम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2113352, "chapter_id": 3439, "verse_number": "७", "content_sanskrit": "आत्मनश्च महावीर्य एकपादस्थितोऽभवत् ।\nउग्रं तपः स आतस्थे परमेण समाधिना \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2113353, "chapter_id": 3439, "verse_number": "८", "content_sanskrit": "आरिराधयिषुर्देवं त्रिदशानां तमीश्वरम् ।\nसूर्येण सह धर्मात्मा पर्यवर्तत भारत\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2113354, "chapter_id": 3439, "verse_number": "९", "content_sanskrit": "तं तु कालेन महता वासवः प्रत्यभाषत ।\nपुत्रं तव प्रदास्यामि त्रिषु लोकेषु विश्रुतम् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2113355, "chapter_id": 3439, "verse_number": "१०", "content_sanskrit": "मित्रेभ्यो ब्राह्मणेभ्यश्च सुहृद्भ्यश्चार्थसाधकम् ।\nसुतं तेऽग्र्यं प्रदास्यामि सर्वामित्रविनाशनम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2113356, "chapter_id": 3439, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2113357, "chapter_id": 3439, "verse_number": "११", "content_sanskrit": "इत्युक्तस्तु महेन्द्रेण कौरवः कुरुवर्धन ।\nकुन्तीं राजसुतां पाण्डुरपत्यार्थेऽभ्यचोदयत् ।\nधर्मं बलं च निश्चित्य यथा स्यादिति भारत \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2113358, "chapter_id": 3439, "verse_number": "", "content_sanskrit": "पाण्डुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2113359, "chapter_id": 3439, "verse_number": "१२", "content_sanskrit": "नीतिमन्तं महात्मानमादित्यसमतेजसम् ।\nदुराधर्षं रणे शूरं देवराजमिवानघम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2113360, "chapter_id": 3439, "verse_number": "१३", "content_sanskrit": "पुत्रं जनय सुश्रोणि धाम क्षत्रियतेजसाम् ।\nलब्धः प्रसादो देवेन्द्रात् तमाह्वय शुचिस्मिते\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2113361, "chapter_id": 3439, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2113362, "chapter_id": 3439, "verse_number": "१४", "content_sanskrit": "जातेषु धृतराष्ट्रस्य पुत्रेषु च महात्मसु ।\nकुन्ती पुनरपत्याय देवराजमुपाह्वयत् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2113363, "chapter_id": 3439, "verse_number": "१५", "content_sanskrit": "ततः पर्यचरत् तेन बलिना भगवानपि ।\nअथाजगाम देवेन्द्रो जनयामास चार्जुनम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2113364, "chapter_id": 3439, "verse_number": "१६", "content_sanskrit": "उत्तराभ्यां तु पूर्वाभ्यां फल्गुनीभ्यां ततो दिवा ।\nजातस्तु फाल्गुने मासि तेनासौ फल्गुनः स्मृतः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2113365, "chapter_id": 3439, "verse_number": "१७", "content_sanskrit": "जातमात्रे कुमारे तु सर्वभूतप्रहर्षिणी ।\nसूतके वर्तमानानां वागुवाचाशरीरिणी \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2113366, "chapter_id": 3439, "verse_number": "१९", "content_sanskrit": "मेघगम्भीरनिर्घोषा नभो नादयती तदा ।\nकार्तवीर्यसमः पुत्रो देवतुल्यपराक्रमः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2113367, "chapter_id": 3439, "verse_number": "२०", "content_sanskrit": "एष शक्र इवाजय्यः प्रथयिष्यति ते यशः ।\nअदित्या विष्णुना प्रीतिर्यथा समभिवर्धिता\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2113368, "chapter_id": 3439, "verse_number": "२१", "content_sanskrit": "तथा विष्णुसमः प्रीतिं वर्धयिष्यति तेऽर्जुनः ।\nएष मद्रान् वशे कृत्वा कोसलान् सह केकयैः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2113369, "chapter_id": 3439, "verse_number": "२२", "content_sanskrit": "चेदिकाशिकरूशांश्च कुरूणां लक्ष्म धास्यति ।\nएतस्य भुजवीर्येण त्रासिताः सर्वशत्रवः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2113370, "chapter_id": 3439, "verse_number": "२३", "content_sanskrit": "निवातकवचाः सर्वे प्रहास्यन्ते च जीवितम् ।\nहिरण्यपुरमारुज्य निहनिष्यति संयुगे \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2113371, "chapter_id": 3439, "verse_number": "२४", "content_sanskrit": "पुलोमजायास्तनयान् कालकेयांश्च सर्वशः ।\nजित्वोत्तरां दिशं देवो विजित्य युधि पार्थिवान् \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2113372, "chapter_id": 3439, "verse_number": "२५", "content_sanskrit": "धनरत्नौघममितमानयिष्यति पाण्डवः ।\nएतस्य भुजवीर्येण खाण्डवे हव्यवाहनः \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2113373, "chapter_id": 3439, "verse_number": "२६", "content_sanskrit": "मेदसा सर्वभूतानां तुष्टिं यास्यति वै पराम् ।\nग्रामणींश्च महीपालान् एष जित्वा महाबलः \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2113374, "chapter_id": 3439, "verse_number": "२७", "content_sanskrit": "भ्रातृभिः सहितो वीरः त्रीन् मेधानाहरिष्यति ।\nजामदग्न्यसमः कुन्ति शिवेरौशीनरात् परः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2113375, "chapter_id": 3439, "verse_number": "२८", "content_sanskrit": "एवं वीर्यवतां श्रेष्ठो महाभागो भविष्यति ।\nएष चास्त्राणि दिव्यानि निखिलान्याहरिष्यति \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2113376, "chapter_id": 3439, "verse_number": "२९", "content_sanskrit": "विप्रनष्टां श्रियं चायमाहर्ता पुरुषर्षभः ।\nएतदत्यद्भुतं राजन् कुन्त्याः पार्थस्य सूतके\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2113377, "chapter_id": 3439, "verse_number": "३०", "content_sanskrit": "उक्तवान् वायुराकाशे कुन्ती शुश्राव भारत ।\nवाचमुच्चरितामुच्चैस्तां निशम्य यशस्विनीम् \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2113378, "chapter_id": 3439, "verse_number": "३१", "content_sanskrit": "बभूव परमो हर्षः शतशृङ्गनिवासिनाम् ।\nततो देवरथानां च सेन्द्राणां च दिवौकसाम् \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2113379, "chapter_id": 3439, "verse_number": "३२", "content_sanskrit": "आकाशे दुन्दुभीनां च बभूवातुलनिस्वनः ।\nउदतिष्ठन् महाघोषः पुष्पवृष्टिभिरावृतः \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2113380, "chapter_id": 3439, "verse_number": "३३", "content_sanskrit": "समवेत्य च देवानां गणः पार्थमपूजयत् ।\nकाद्रवेया वैनतेया गन्धर्वाप्सरसस्तथा ।\nप्रजानां पतयः सर्वे सप्त चैव महर्षयः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2113381, "chapter_id": 3439, "verse_number": "३४", "content_sanskrit": "भरद्वाजः काश्यपो गौतमश्च\nविश्वामित्रो जमदग्निर्वसिष्ठः ।\nयश्चोदितो भास्करेऽभूत् प्रनष्टे\nसोऽप्यत्रात्रिर्भगवानाजगाम\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2113382, "chapter_id": 3439, "verse_number": "३५", "content_sanskrit": "मरीचिरङ्गिराश्चैव पुलस्त्यः पुलहः क्रतुः ।\nदक्षप्रजापतिश्चैव अथर्वाऽप्सरसस्तथा\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2113383, "chapter_id": 3439, "verse_number": "३६", "content_sanskrit": "दिव्यमल्याम्बरधराः सर्वालङ्कारभूषिताः ।\nते च प्रकाशा मर्त्येषु सर्वोपस्कारसम्भृताः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2113384, "chapter_id": 3439, "verse_number": "३७", "content_sanskrit": "उपगायन्ति बीभत्सुमुपनृत्यन्ति चैव हि ।\nततो गन्धर्वतूर्येषु निनदत्सु विहायसि\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2113385, "chapter_id": 3439, "verse_number": "३८", "content_sanskrit": "बहुभिः सह गन्धर्वैरगायत च तुम्बुरुः ।\nभीष्मसेनोग्रसेनौ च पूर्णायुरनघस्तदा\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2113386, "chapter_id": 3439, "verse_number": "३९", "content_sanskrit": "होमश्च धृतराष्ट्रश्च सूर्यवर्चास्तथाऽष्टमः ।\nयुगपस्तुर्णपः कार्ष्णी नन्दी चित्ररथस्तथा\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2113387, "chapter_id": 3439, "verse_number": "४०", "content_sanskrit": "त्रयोदशः शालिशिराः पर्जन्यश्च चतुर्दशः ।\nकविः पञ्चदशश्चात्र किन्तुनरास्तु षोडशः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2113388, "chapter_id": 3439, "verse_number": "४१", "content_sanskrit": "इत्येते देवगन्धर्वा उपगायन् धनञ्जयम् ।\nसद्वान्बृहद्वान् बृहकः कराळश्च महायशाः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2113389, "chapter_id": 3439, "verse_number": "४२", "content_sanskrit": "ब्रह्मचारी रतिगुणः सुवर्णश्चेति सप्तमः ।\nविश्चावसुर्भुमन्युश्च सुचन्द्रो दशमः स्मृतः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2113390, "chapter_id": 3439, "verse_number": "४३", "content_sanskrit": "इत्येते देवगन्धर्वा उपगायन् धनञ्जयम् ।\nहाहा हूहूश्च गन्धर्वो हंसश्च भरतर्षभ \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2113391, "chapter_id": 3439, "verse_number": "४४", "content_sanskrit": "इत्येते देवगन्धर्वा उपगायन् धनञ्जयम् ।\nतथैवाप्सरसो हृष्टाः सर्वालङ्कारभूषिताः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2113392, "chapter_id": 3439, "verse_number": "४५", "content_sanskrit": "ननृतुश्च वरारोहा जगुरायतलोचनाः ।\nअनूचानाऽनवद्याङ्गी क्रियामुख्या गुणावरा\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2113393, "chapter_id": 3439, "verse_number": "४६", "content_sanskrit": "अन्तकेशी तथा साची दीर्घकेशी त्वलम्बुसा ।\nमरीचिः शुचिका चैव विद्युद्वर्णा तिलोत्तमा \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2113394, "chapter_id": 3439, "verse_number": "४७", "content_sanskrit": "अद्रिका लक्षणा क्षेमा देवी रम्भा मनोरमा ।\nउर्वशी चैव राजेन्द्र ननृतुर्गीतनिस्वनैः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2113395, "chapter_id": 3439, "verse_number": "४८", "content_sanskrit": "असिता च सुबाहुश्च सुप्रिया सुवपुस्तथा ।\nपुण्डरीका सुगन्धा च सुरथा च प्रमाथिनी\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2113396, "chapter_id": 3439, "verse_number": "४९", "content_sanskrit": "काम्या शारद्वती चैव ननृतुस्तत्र सङ्घशः ।\nमेनका सहजन्या च पर्णिका पुञ्जिकस्थला \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2113397, "chapter_id": 3439, "verse_number": "५०", "content_sanskrit": "घृताची चैव विश्वाची पूर्वचित्तिः क्रतुस्तथा ।\nउन्मोचेत्यभिविख्याता प्रम्लोचेति च तादृशी \t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2113398, "chapter_id": 3439, "verse_number": "५१", "content_sanskrit": "उर्वश्येकादशीत्येता जगुरायतलोचनाः ।\nघाताऽर्यमा च मित्रश्च वरुणोंऽशो भगस्तथा \t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2113399, "chapter_id": 3439, "verse_number": "५२", "content_sanskrit": "इन्द्रो विवस्वान् पूषा च पर्जन्यो दशमः स्मृतः ।\nततस्त्वष्टा ततो विष्णुरजघन्यो जघन्यजः \t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2113400, "chapter_id": 3439, "verse_number": "५३", "content_sanskrit": "इत्येते द्वादशादित्या ज्वलन्तः सूर्यवर्चसः ।\nमहिमानं पाण्डवस्य कुर्वन्तस्तस्थुरम्बरे\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2113401, "chapter_id": 3439, "verse_number": "५४", "content_sanskrit": "मृगव्याधश्च शर्वश्च निरृतिश्च महायशाः ।\nअजैकपादहिर्बुध्न्यः पिनाकी च परन्तपः\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2113402, "chapter_id": 3439, "verse_number": "५५", "content_sanskrit": "भवनोऽथेश्वरश्चैव कपाली च विशाम्पते ।\nस्थाणुर्भवश्च भगवान् रुद्रास्तत्रावतस्थिरे \t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2113403, "chapter_id": 3439, "verse_number": "५६", "content_sanskrit": "धरो ध्रुवश्च सोमश्च आपश्चैवानलोऽनिलः ।\nप्रत्यूषश्च प्रभासश्च वसवश्चावतस्थिरे\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2113404, "chapter_id": 3439, "verse_number": "५७", "content_sanskrit": "यथैव वसवस्त्वष्टौ मरुतश्च महाबलाः ।\nनासत्यश्चैव दस्रश्च स्मृतौ द्वावश्विनाविति \t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2113405, "chapter_id": 3439, "verse_number": "५८", "content_sanskrit": "तौ चाश्विनौ तथा साध्यास्तस्य जन्मनि संस्थिताः ।\nक्रतुर्दक्षो वसुः सत्यः कालः कामो मुनिस्तथा \t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2113406, "chapter_id": 3439, "verse_number": "५९", "content_sanskrit": "पुरूरवाद्रवश्चैव रोचमानस्तु ते दश ।\nविश्वे देवा इति ख्याताः तस्यासन् जन्मनि स्थिताः\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2113407, "chapter_id": 3439, "verse_number": "६०", "content_sanskrit": "तार्क्ष्यश्चारिष्टनेमिश्च गरुडश्च महायशाः ।\nअरुणश्चारुणिश्चैव वैनतेया उपासते \t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2113408, "chapter_id": 3439, "verse_number": "६१", "content_sanskrit": "आययुस्तपसा युक्ता महावेगा महाबलाः ।\nमहान् पितामहस्त्वेनं वस्त्रेण रजसा तदा\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2113409, "chapter_id": 3439, "verse_number": "६२", "content_sanskrit": "प्रतिजग्राह नप्तारं राजर्षिपरिवारितः ।\nसगरेणाम्बरीषेण नहुषेण ययातिना \t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2113410, "chapter_id": 3439, "verse_number": "६३", "content_sanskrit": "धीमता धुन्धुमारेण राज्ञोपरिचरेण ह ।\nमुचुकुन्देन मान्धात्रा शिबिनाऽरिष्टनेमिना\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2113411, "chapter_id": 3439, "verse_number": "६४", "content_sanskrit": "भरतेन दिलीपेन सर्वैश्च जनमेजय ।\nपूरुः सार्धं नृपतिभिर्जग्राह कुरुपुङ्गवम् \t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2113412, "chapter_id": 3439, "verse_number": "६५", "content_sanskrit": "अन्ये च बहवस्तत्र समासन् राजसत्तमाः ।\nएते चान्ये च बहवो नरलोकाधिपास्तथा\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2113413, "chapter_id": 3439, "verse_number": "६६", "content_sanskrit": "देवलोकादिहागम्य प्रैक्षन्त भरतर्षभम् ।\nविद्योतमानं वपुषा भासयन्तं दिशो दश\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2113414, "chapter_id": 3439, "verse_number": "६७", "content_sanskrit": "लक्षणैर्व्यञ्जकैः सर्वैर्युक्तं माहात्म्यसूचकैः ।\nएतं दृष्ट्वा महावीर्यं विस्मिता ऋषिसत्तमाः \t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2113415, "chapter_id": 3439, "verse_number": "६८", "content_sanskrit": "अधिकां स्म तदा वृत्तिमवर्तन् पाण्डवान् प्रति ।\nपाण्डुः प्रीतेन मनसा देवतादीनपूजयत्\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2113416, "chapter_id": 3439, "verse_number": "६९", "content_sanskrit": "पाण्डुना पूजिता देवाः प्रत्यूचुर्नृपसत्तमम् ।\nप्रादुर्भूतो ह्ययं धर्मो देवतानां प्रसादजः \t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2113417, "chapter_id": 3439, "verse_number": "७०", "content_sanskrit": "मातरिश्वा ह्ययं भीमो बलवानरिमर्दनः।\nसाक्षादिन्द्रः स्वयं जातः प्रसादाच्च शतक्रतोः\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2113418, "chapter_id": 3439, "verse_number": "७१", "content_sanskrit": "फल्गुनो जयतां श्रेष्ठः पूरुवंशविवर्धनः ।\nपितृत्वाद् देवतानां हि नास्ति पुण्यतरस्त्वया ।\nधन्यस्त्वमचिरादेव स्वर्गं प्राप्स्यसि पुण्यभाक्\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2113419, "chapter_id": 3439, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2113420, "chapter_id": 3439, "verse_number": "७२", "content_sanskrit": "इत्युक्त्वा देवताः सर्वा विप्रजग्मुर्यथागतम् ।\nपाण्डुश्च पुनरेवार्यां पुत्रलोभान्महायशाः \t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2113421, "chapter_id": 3439, "verse_number": "७३", "content_sanskrit": "प्रादिशद् दर्शनीयार्थी कुन्ती त्वेनमथाब्रवीत् ।\nन वै चतुर्थप्रसवं विदुरापत्सु भारत \t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2113422, "chapter_id": 3439, "verse_number": "७४", "content_sanskrit": "अतः परमनाचारं पञ्चमे बन्धकी भवेत् ।\nस वै विद्वान् धर्ममिमं सञ्चोदयसि मामतः ।\nअपत्यलाभात् त्वं राजन् प्रमत्त इव भाषसे \t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2113423, "chapter_id": 3439, "verse_number": "", "content_sanskrit": "पाण्डुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2113424, "chapter_id": 3439, "verse_number": "७५", "content_sanskrit": "एवमेतद्धर्मशास्त्रं यथा वदसि तत् तथा\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2113425, "chapter_id": 3439, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nअष्टादशाधिकशततमोऽध्यायः ॥१०८॥॥ इति सम्भवपर्वणि षट्षष्टितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2113426, "chapter_id": 3439, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}]