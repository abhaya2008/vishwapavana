[{"id": 7000466000, "chapter_id": 20466, "verse_number": "३-१३-१", "content_sanskrit": "युधिष्ठिर उवाच ।\nवसिष्ठेन दिलीपाय कथितं तीर्थमुत्तमम् ।\nनर्मदेति च विख्यातं पापपर्वतदारणम्॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000466001, "chapter_id": 20466, "verse_number": "३-१३-२", "content_sanskrit": "भूयश्च श्रोतुमिच्छामि तन्मे कथय नारद ।\nनर्मदायाश्च माहात्म्यं वसिष्ठोक्तं द्विजोत्तम॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000466002, "chapter_id": 20466, "verse_number": "३-१३-३", "content_sanskrit": "कथमेषा महापुण्या नदी सर्वत्र विश्रुता ।\nनर्मदानाम विख्याता तन्मम ब्रूहिनारद॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000466003, "chapter_id": 20466, "verse_number": "३-१३-४", "content_sanskrit": "नारद उवाच ।\nनर्मदा सरितां श्रेष्ठा सर्वपापप्रणाशिनी ।\nतारयेत्सर्वभूतानि स्थावराणि चराणि च॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000466004, "chapter_id": 20466, "verse_number": "३-१३-५", "content_sanskrit": "नर्मदायास्तु माहात्म्यं वसिष्ठोक्तं मया श्रुतम् ।\nतदेतद्धि महाराज सर्वं हि कथयामि ते॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000466005, "chapter_id": 20466, "verse_number": "३-१३-६", "content_sanskrit": "पुण्या कनखले गङ्गा कुरुक्षेत्रे सरस्वती ।\nग्रामे वा यदि वारण्ये पुण्या सर्वत्र नर्म्मदा॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000466006, "chapter_id": 20466, "verse_number": "३-१३-७", "content_sanskrit": "त्रिभिः सारस्वतं तोयं सप्ताहेन तु यामुनम् ।\nसद्यः पुनाति गांगेयं दर्शनादेव नार्मदम्॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000466007, "chapter_id": 20466, "verse_number": "३-१३-८", "content_sanskrit": "कलिंग देशे पश्चार्द्धे पर्वतेऽमरकंटके ।\nपुण्या च त्रिषु लोकेषु रमणीया मनोरमा॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000466008, "chapter_id": 20466, "verse_number": "३-१३-९", "content_sanskrit": "सदेवासुरगंधर्वा ऋषयश्च तपोधनाः ।\nतपस्तप्त्वा महाराज सिद्धिं च परमां गताः॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000466009, "chapter_id": 20466, "verse_number": "३-१३-१०", "content_sanskrit": "तत्र स्नात्वा महाराज नियमस्थो जितेंद्रियः ।\nउपोष्य रजनीमेकां कुलानां तारयेच्छतम्॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000466010, "chapter_id": 20466, "verse_number": "३-१३-११", "content_sanskrit": "जनेश्वरे नरः स्नात्वा पिंडं दत्वा यथाविधि ।\nपितरस्तस्य तृप्यंति यावदाभूतसंप्लवम्॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000466011, "chapter_id": 20466, "verse_number": "३-१३-१२", "content_sanskrit": "पर्वतस्य समंतात्तु रुद्रकोटिः प्रतिष्ठिता ।\nस्नानं यः कुरुते तत्र गंधमाल्यानुलेपनम्॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000466012, "chapter_id": 20466, "verse_number": "३-१३-१३", "content_sanskrit": "प्रीता तस्य भवेत्सर्वा रुद्रकोटिर्न संशयः ।\nपर्वते पश्चिमस्यांते स्वयं देवो महेश्वरः॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000466013, "chapter_id": 20466, "verse_number": "३-१३-१४", "content_sanskrit": "तत्र स्नात्वा शुचिर्भूत्वा ब्रह्मचारी जितेंद्रियः ।\nपितृकार्यं तु कुर्वीत विधिदृष्टेन कर्मणा॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000466014, "chapter_id": 20466, "verse_number": "३-१३-१५", "content_sanskrit": "तिलोदकेन तत्रैव तर्पयेत्पितृदेवताः ।\nआसप्तमं कुलं तस्य स्वर्गे तिष्ठति पांडव॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000466015, "chapter_id": 20466, "verse_number": "३-१३-१६", "content_sanskrit": "षष्टिवर्षसहस्राणि स्वर्गलोके महीयते ।\nअप्सरोगणसंकीर्णो दिव्यस्त्रीपरिवारितः॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000466016, "chapter_id": 20466, "verse_number": "३-१३-१७", "content_sanskrit": "दिव्यगंधानुलिप्तश्च दिव्यालंकारभूषितः ।\nततः स्वर्गात्परिभ्रष्टो जायते विपुले कुले॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000466017, "chapter_id": 20466, "verse_number": "३-१३-१८", "content_sanskrit": "धनवान्दानशीलश्च धार्मिकश्चैव जायते ।\nपुनः स्मरति तत्तीर्थं गमनं तत्र कुर्वते॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000466018, "chapter_id": 20466, "verse_number": "३-१३-१९", "content_sanskrit": "तारयित्वा कुलशतं रुद्रलोकं स गच्छति ।\nयोजनानां शतं साग्रं श्रूयते सरिदुत्तमा॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000466019, "chapter_id": 20466, "verse_number": "३-१३-२०", "content_sanskrit": "विस्तारेण तु राजेन्द्र योजनद्वयमंतरम् ।\nषष्टितीर्थसहस्राणि षष्टिकोट्यस्तथैव च॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000466020, "chapter_id": 20466, "verse_number": "३-१३-२१", "content_sanskrit": "पर्वतस्य समंतात्तु तिष्ठंत्यमरकंटके ।\nब्रह्मचारी शुचिर्भूत्वा जितक्रोधो जितेंद्रियः॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000466021, "chapter_id": 20466, "verse_number": "३-१३-२२", "content_sanskrit": "सर्वहिंसानिवृत्तश्च सर्वभूतहिते रतः ।\nएवं सर्वसमाचारः क्षेत्रपालान्परिव्रजेत्॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000466022, "chapter_id": 20466, "verse_number": "३-१३-२३", "content_sanskrit": "तस्य पुण्यफलं राजन्शृणुष्वावहितो हि मे ।\nशतं वर्षसहस्राणां स्वर्गे मोदेत पांडव॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000466023, "chapter_id": 20466, "verse_number": "३-१३-२४", "content_sanskrit": "अप्सरोगणसंकीर्णे दिव्यस्त्रीपरिचारिते ।\nदिव्यगंधानुलिप्तश्च दिव्यालंकारभूषितः॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000466024, "chapter_id": 20466, "verse_number": "३-१३-२५", "content_sanskrit": "क्रीडते देवलोके तु दैवतैः सह मोदते ।\nततः स्वर्गात्परिभ्रष्टो राजा भवति वीर्यवान्॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]