[{"id": 40021699, "chapter_id": 9364, "verse_number": "1", "content_sanskrit": "तेषां समुपविष्टानां सर्वेषां दीनचेतसाम् । उवाच वाक्यं काकुत्स्थो मुखेन परिशुष्यता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40021700, "chapter_id": 9364, "verse_number": "2", "content_sanskrit": "सर्वे शृणुत भद्रं वो मा कुरुध्वं मनो ऽन्यथा । पौराणां मम सीतायां यादृशी वर्तते कथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40021701, "chapter_id": 9364, "verse_number": "3", "content_sanskrit": "पौरापवादः सुमहांस्तथा जनपदस्य च । वर्तते मयि बीभत्सा सा मे मर्माणि कृन्तति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40021702, "chapter_id": 9364, "verse_number": "4", "content_sanskrit": "अहं किल कुले जात इक्ष्वाकूणां महात्मनाम् । सीता ऽपि सत्कुले जाता जनकानां महात्मनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40021703, "chapter_id": 9364, "verse_number": "5", "content_sanskrit": "जानासि त्वं यथा सौम्य दण्डके विजने वने । रावणेन हृता सीता स च विध्वंसितो मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40021704, "chapter_id": 9364, "verse_number": "6", "content_sanskrit": "तत्र मे बुद्धिरुत्पन्ना जनकस्य सुतां प्रति । अत्रोषितामिमां सीतामानयेयं कथं पुरीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40021705, "chapter_id": 9364, "verse_number": "7", "content_sanskrit": "प्रत्ययार्थं ततः सीता विवेश ज्वलनं तदा । प्रत्यक्षं तव सौमित्रे देवानां हव्यवाहनः । अपापां मैथिलीमाह वायुश्चाकाशगोचरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40021706, "chapter_id": 9364, "verse_number": "8", "content_sanskrit": "चन्द्रादित्यौ च शंसेते सुराणां सन्निधौ पुरा । ऋषीणां चैव सर्वेषामपापां जनकात्मजाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40021707, "chapter_id": 9364, "verse_number": "9", "content_sanskrit": "एवं शुद्धसमाचारा देवगन्धर्वसन्निधौ । लङ्काद्वीपे महेन्द्रेण मम हस्ते निवेशिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40021708, "chapter_id": 9364, "verse_number": "10", "content_sanskrit": "अन्तरात्मा च मे वेत्ति सीतां शुद्धां यशस्विनीम् । ततो गृहीत्वा वैदेहीमयोध्यामहमागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40021709, "chapter_id": 9364, "verse_number": "11", "content_sanskrit": "अयं तु मे महान्वादः शोकश्च हृदि वर्तते । पौरापवादः सुमहांस्तथा जनपदस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40021710, "chapter_id": 9364, "verse_number": "12", "content_sanskrit": "अकीर्तिर्यस्य गीयेत लोके भूतस्य कस्यचित् । पतत्येवाधमाँल्लोकान्यावच्छब्दः प्रकीर्त्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40021711, "chapter_id": 9364, "verse_number": "13", "content_sanskrit": "अकीर्तिर्निन्द्यते देवैः कीर्तिर्लोकेषु पूज्यते । कीर्त्यर्थं तु समारम्भः सर्वेषां सुमहात्मनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40021712, "chapter_id": 9364, "verse_number": "14", "content_sanskrit": "अप्यहं जीवितं जह्यां युष्मान्वा पुरुषर्षभाः । अपवादभयाद्भीतः किं पुनर्जनकात्मजाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40021713, "chapter_id": 9364, "verse_number": "15", "content_sanskrit": "तस्माद्भवन्तः पश्यन्तु पतितं शोकसागरे । नहि पश्याम्यहं भूतं किञ्चिद्दुःखमतो ऽधिकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40021714, "chapter_id": 9364, "verse_number": "16", "content_sanskrit": "श्वस्त्वं प्रभाते सौमित्रे सुमन्त्राधिष्ठितं रथम् । आरुह्य सीतामारोप्य विषयान्ते समुत्सृज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40021715, "chapter_id": 9364, "verse_number": "17", "content_sanskrit": "गङ्गायास्तु परे पारे वाल्मीकेस्तु महात्मनः । आश्रमो दिव्यसङ्काशस्तमसातीरमाश्रितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40021716, "chapter_id": 9364, "verse_number": "18", "content_sanskrit": "तत्रैनां विजने देशे विसृज्य रघुनन्दन । शीघ्रमागच्छ भद्रं ते कुरुष्व वचनं मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40021717, "chapter_id": 9364, "verse_number": "19", "content_sanskrit": "न चास्मिन् प्रतिवक्तव्यः सीतां प्रति कथञ्चन । तस्मात्त्वं गच्छ सौमित्रे नात्र कार्या विचारणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40021718, "chapter_id": 9364, "verse_number": "20", "content_sanskrit": "अप्रीतिर्हि परा मह्यं त्वयेतत्प्रतिवारिते । शापिता हि मया यूयं भुजाभ्यां जीवितेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40021719, "chapter_id": 9364, "verse_number": "21", "content_sanskrit": "ये मां वाक्यान्तरे ब्रूयुरनुनेतुं कथञ्चन । अहिता नाम ते नित्यं मदभीष्टविघातनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40021720, "chapter_id": 9364, "verse_number": "22", "content_sanskrit": "मानयन्तु भवन्तो मां यदि मच्छासने स्थिताः । इतो ऽद्य नीयतां सीता कुरुष्व वचनं मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40021721, "chapter_id": 9364, "verse_number": "23", "content_sanskrit": "पूर्वमुक्तो ऽहमनया गङ्गातीरे ऽहमाश्रमान् । पश्येयमिति तस्याश्च कामः संवर्त्यतामयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40021722, "chapter_id": 9364, "verse_number": "24", "content_sanskrit": "एवमुक्त्वा तु काकुत्स्थो बाष्पेण पिहिताननः । प्रविवेश स धर्मात्मा भ्रातृभिः परिवारितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40021723, "chapter_id": 9364, "verse_number": "25", "content_sanskrit": "शोकसंलग्नहृदयो निशश्वास यथा द्विपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]