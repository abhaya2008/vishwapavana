[{"id": 5000364000, "chapter_id": 9364, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे सुन्दरकाण्डे पञ्चविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000364001, "chapter_id": 9364, "verse_number": "५-२५-१", "content_sanskrit": "अथ तासां वदन्तीनां परुषं दारुणं बहु।\nराक्षसीनामसौम्यानां रुरोद जनकात्मजा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000364002, "chapter_id": 9364, "verse_number": "५-२५-२", "content_sanskrit": "एवमुक्ता तु वैदेही राक्षसीभिर्मनस्विनी।\nउवाच परमत्रस्ता बाष्पगद‍्गदया गिरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000364003, "chapter_id": 9364, "verse_number": "५-२५-३", "content_sanskrit": "न मानुषी राक्षसस्य भार्या भवितुमर्हति।\nकामं खादत मां सर्वा न करिष्यामि वो वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000364004, "chapter_id": 9364, "verse_number": "५-२५-४", "content_sanskrit": "सा राक्षसीमध्यगता सीता सुरसुतोपमा।\nन शर्म लेभे शोकार्ता रावणेनेव भर्त्सिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000364005, "chapter_id": 9364, "verse_number": "५-२५-५", "content_sanskrit": "वेपते स्माधिकं सीता विशन्तीवांगमात्मनः।\nवने यूथपरिभ्रष्टा मृगी कोकैरिवार्दिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000364006, "chapter_id": 9364, "verse_number": "५-२५-६", "content_sanskrit": "सा त्वशोकस्य विपुलां शाखामालम्ब्य पुष्पिताम्।\nचिन्तयामास शोकेन भर्तारं भग्नमानसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000364007, "chapter_id": 9364, "verse_number": "५-२५-७", "content_sanskrit": "सा स्नापयन्ती विपुलौ स्तनौ नेत्रजलस्रवैः।\nचिन्तयन्ती न शोकस्य तदान्तमधिगच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000364008, "chapter_id": 9364, "verse_number": "५-२५-८", "content_sanskrit": "सा वेपमाना पतिता प्रवाते कदली यथा।\nराक्षसीनां भयत्रस्ता विवर्णवदनाभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000364009, "chapter_id": 9364, "verse_number": "५-२५-९", "content_sanskrit": "तस्याः सा दीर्घबहुला वेपन्त्याः सीतया तदा।\nददृशे कम्पिता वेणी व्यालीव परिसर्पती ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000364010, "chapter_id": 9364, "verse_number": "५-२५-१०", "content_sanskrit": "सा निःश्वसन्ती शोकार्ता कोपोपहतचेतना।\nआर्ता व्यसृजदश्रूणि मैथिली विललाप च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000364011, "chapter_id": 9364, "verse_number": "५-२५-११", "content_sanskrit": "हा रामेति च दुःखार्ता हा पुनर्लक्ष्मणेति च।\nहा श्वश्रूर्मम कौसल्ये हा सुमित्रेति भामिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000364012, "chapter_id": 9364, "verse_number": "५-२५-१२", "content_sanskrit": "लोकप्रवादः सत्योऽयं पण्डितैः समुदाहृतः।\nअकाले दुर्लभो मृत्युः स्त्रिया वा पुरुषस्य वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000364013, "chapter_id": 9364, "verse_number": "५-२५-१३", "content_sanskrit": "यत्राहमाभिः क्रूराभी राक्षसीभिरिहार्दिता।\nजीवामि हीना रामेण मुहूर्तमपि दुःखिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000364014, "chapter_id": 9364, "verse_number": "५-२५-१४", "content_sanskrit": "एषाल्पपुण्या कृपणा विनशिष्याम्यनाथवत्।\nसमुद्रमध्ये नौः पूर्णा वायुवेगैरिवाहता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000364015, "chapter_id": 9364, "verse_number": "५-२५-१५", "content_sanskrit": "भर्तारं तमपश्यन्ती राक्षसीवशमागता।\nसीदामि खलु शोकेन कूलं तोयहतं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000364016, "chapter_id": 9364, "verse_number": "५-२५-१६", "content_sanskrit": "तं पद्मदलपत्राक्षं सिंहविक्रान्तगामिनम्।\nधन्याः पश्यन्ति मे नाथं कृतज्ञं प्रियवादिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000364017, "chapter_id": 9364, "verse_number": "५-२५-१७", "content_sanskrit": "सर्वथा तेन हीनाया रामेण विदितात्मना।\nतीक्ष्णं विषमिवास्वाद्य दुर्लभं मम जीवनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000364018, "chapter_id": 9364, "verse_number": "५-२५-१८", "content_sanskrit": "कीदृशं तु महापापं मया देहान्तरे कृतम्।\nतेनेदं प्राप्यते घोरं महादुःखं सुदारुणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000364019, "chapter_id": 9364, "verse_number": "५-२५-१९", "content_sanskrit": "जीवितं त्यक्तुमिच्छामि शोकेन महता वृता।\nराक्षसीभिश्च रक्षन्त्या रामो नासाद्यते मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000364020, "chapter_id": 9364, "verse_number": "५-२५-२०", "content_sanskrit": "धिगस्तु खलु मानुष्यं धिगस्तु परवश्यताम्।\nन शक्यं यत् परित्यक्तुमात्मच्छन्देन जीवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000364021, "chapter_id": 9364, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये सुन्दरकाण्डे पञ्चविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]