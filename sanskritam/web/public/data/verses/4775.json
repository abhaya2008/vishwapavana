[{"id": 2178519, "chapter_id": 4775, "verse_number": "", "content_sanskrit": "गान्धारी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2178520, "chapter_id": 4775, "verse_number": "१", "content_sanskrit": "एष माधव पुत्रो मे विकर्णः प्राज्ञसम्मतः ।\nभूमौ विनिहतः शेते भीमेन शतधा कृतः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2178521, "chapter_id": 4775, "verse_number": "२", "content_sanskrit": "गजमध्ये हतः शेते विकर्णो मधुसूदन ।\nनीलमेघपरिक्षिप्तः शरदीव दिवाकरः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2178522, "chapter_id": 4775, "verse_number": "३", "content_sanskrit": "अस्य चापग्रहेणैष पाणिः कृतकिणो महान् ।\nकथञ्चिच्छिद्यते गृध्रैरत्तुकामैस्तळत्रवान्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2178523, "chapter_id": 4775, "verse_number": "४", "content_sanskrit": "अस्य भार्याऽऽमिषप्रेप्सून् गृद्धकाकान् तपस्विनी ।\nवारयत्यनिशं बाला न च शक्नोति माधव\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2178524, "chapter_id": 4775, "verse_number": "५", "content_sanskrit": "युवा वृन्दारकः शूरो विकर्णः पुरुषर्षभ ।\nसुखोषितः सुखार्हश्च शेते पांसुषु माधव\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2178525, "chapter_id": 4775, "verse_number": "६", "content_sanskrit": "कर्णिनालीकनाराचैर्भिन्नवर्माणमाहवे ।\nअद्यापि न जहात्येनं लक्ष्मीर्भरतसत्तमम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2178526, "chapter_id": 4775, "verse_number": "७", "content_sanskrit": "एष सङ्ग्रामशूरेण प्रतिज्ञां पालयिष्यता ।\nदुर्मुखो निहतः शेते भीमेनारिनिबर्हणः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2178527, "chapter_id": 4775, "verse_number": "८", "content_sanskrit": "तस्यैतद्वदनं कृष्ण श्वापदैरर्धभक्षितम् ।\nविभात्यभ्यधिकं तात सप्तम्यामिव चन्द्रमाः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2178528, "chapter_id": 4775, "verse_number": "९", "content_sanskrit": "शूरस्यास्य रणे कृष्ण पश्याननमथेदृशम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2178529, "chapter_id": 4775, "verse_number": "१०", "content_sanskrit": "स कथं निहतोऽमित्रैः पांसून् ग्रसति मत्सुतः ।\nयस्याहवमुखे सौम्य स्थाता नैवोपलभ्यते\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2178530, "chapter_id": 4775, "verse_number": "११", "content_sanskrit": "चित्रसेनं हतं भूमौ शयानं मधुसूदन ।\nधार्तराष्ट्रमिमं पश्य प्रतिमानं धनुर्भृताम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2178531, "chapter_id": 4775, "verse_number": "१२", "content_sanskrit": "तं चित्रमाल्याभरणं युवत्यः शोककर्शिताः ।\nक्रव्यादसङ्घसहिता रुदन्त्यः पर्युपासते\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2178532, "chapter_id": 4775, "verse_number": "१३", "content_sanskrit": "स्त्रीणां रुदितनिर्घोषं श्वापदानां च गर्जितम् ।\nचित्ररूपमिदं कृष्ण विमिश्रं प्रतिभाति मे\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2178533, "chapter_id": 4775, "verse_number": "१४", "content_sanskrit": "युवा वृन्दारको नित्यं प्रवरस्त्रीनिषेवितः ।\nविविंशतिरसौ शेते ध्वस्तः पांसुषु माधव\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2178534, "chapter_id": 4775, "verse_number": "१५", "content_sanskrit": "शरसङ्कृत्तवर्माणं वीरं विशसने हतम् ।\nपरिवार्यासते गृध्राः पश्य कृष्ण विविंशतिम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2178535, "chapter_id": 4775, "verse_number": "१६", "content_sanskrit": "प्रमथ्य समरे वीरः पाण्डवानामनीकिनीम् ।\nआविश्य शयनं शेते पुनः सत्पुरुषोचितम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2178536, "chapter_id": 4775, "verse_number": "१७", "content_sanskrit": "स्मितोपपन्नं सुनसं सुभ्रु ताराधिपोपमम् ।\nअतीव सौम्यं वदनं कृष्ण पश्य विविंशतेः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2178537, "chapter_id": 4775, "verse_number": "१८", "content_sanskrit": "एनं हि पर्युपातिष्ठन् बहुधा वरयोषितः ।\nक्रीडन्तमिव गन्धर्वं देवकन्याः सहस्रशः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2178538, "chapter_id": 4775, "verse_number": "१९", "content_sanskrit": "हन्तारमरिसैन्यानां वीरं समितिशोभनम् ।\nनिबर्हणममित्राणां दुस्सहं प्रसहेत कः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2178539, "chapter_id": 4775, "verse_number": "२०", "content_sanskrit": "दुस्सहस्यैतदाभाति शरीरं संवृतं शरैः ।\nगिरिरात्मरुहैः फुल्लैः कणिकारैरिवावृतः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2178540, "chapter_id": 4775, "verse_number": "२१", "content_sanskrit": "शातकुम्भस्रजा भाति कवचेन च भास्वता ।\nअग्निनेव गिरिः श्वेतो गतासुरपि दुस्सहः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2178541, "chapter_id": 4775, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां स्त्रीपर्वणि\nएकोनविंशोऽध्यायः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2178542, "chapter_id": 4775, "verse_number": "", "content_sanskrit": "स्त्रीपर्वणि चतुर्थोऽध्यायः ॥४॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]