[{"id": 2075948, "chapter_id": 2608, "verse_number": "१२-११३-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2075949, "chapter_id": 2608, "verse_number": "१२-११३-१", "content_sanskrit": "राजा राज्यमनुप्राप्य दुर्बलो भरतर्षभ।\nअमित्रस्यातिवृद्धस्य कथं तिष्ठेदसाधनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2075950, "chapter_id": 2608, "verse_number": "१२-११३-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2075951, "chapter_id": 2608, "verse_number": "१२-११३-२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nसरितां चैव संवादं सागरस्य च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2075952, "chapter_id": 2608, "verse_number": "१२-११३-३", "content_sanskrit": "सुरारिनिलयः शश्वत्सागरः सरितां पतिः।\nपप्रच्छ सरितः सर्वाः संशयं जातमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2075953, "chapter_id": 2608, "verse_number": "१२-११३-४x", "content_sanskrit": "सागर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2075954, "chapter_id": 2608, "verse_number": "१२-११३-४", "content_sanskrit": "समूलशाखान्पश्यामि निहतान्क्वापि नो द्रुमान्।\nयुष्माभिरिह पूर्णाभिरन्यांस्तत्र न वेतसान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2075955, "chapter_id": 2608, "verse_number": "१२-११३-५", "content_sanskrit": "अ-पकायश्चाल्पसारो वेतसः कूलजश्च यः।\nअज्ञया वा नानीतः किं च वा तेन वः कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2075956, "chapter_id": 2608, "verse_number": "१२-११३-६", "content_sanskrit": "तदहं श्रोतुमिच्छामि सर्वासामेव वो मतम्।\nयथा चेमानि कूलानि हित्वा नायाति वेतसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2075957, "chapter_id": 2608, "verse_number": "१२-११३-७", "content_sanskrit": "तत्र प्राह नदी गङ्गा वाक्यमुत्तरमर्थवत्।\nहेतुमद्ग्राहकं चैव सागरं सरितां पतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2075958, "chapter_id": 2608, "verse_number": "१२-११३-८x", "content_sanskrit": "गङ्गोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2075959, "chapter_id": 2608, "verse_number": "१२-११३-८", "content_sanskrit": "तिष्ठन्त्येते यथास्थानं नगा ह्येकनिकेतनाः।\nततस्त्यजन्ति तत्स्थानं प्रातिलोम्यान्न वेतसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2075960, "chapter_id": 2608, "verse_number": "१२-११३-९", "content_sanskrit": "वेतसो वेगमायान्तं दृष्ट्वा नमति नापरे।\nस च वेगे ह्यतिक्रान्ते स्थानमापद्यते पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2075961, "chapter_id": 2608, "verse_number": "१२-११३-१०", "content_sanskrit": "कालज्ञः समयज्ञश्च सदावश्यश्च नो द्रुमः।\nअनुलोमवृत्तितस्तब्धस्तेन त्वां नैति वेतसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2075962, "chapter_id": 2608, "verse_number": "१२-११३-११", "content_sanskrit": "मारुतोदकवेगेन ये नमन्त्युन्नमन्ति च।\nओषध्यः पादपा गुल्मा न ते यान्ति पराभवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2075963, "chapter_id": 2608, "verse_number": "१२-११३-१२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2075964, "chapter_id": 2608, "verse_number": "१२-११३-१२", "content_sanskrit": "यो हि शत्रोर्विवृद्धस्य प्रभोर्बन्धविनाशने।\nपूर्वं न सहते वेगं क्षिप्रमेव विनश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2075965, "chapter_id": 2608, "verse_number": "१२-११३-१३", "content_sanskrit": "सारासारं बलं वीर्यमात्मनो द्विषतश्च यः।\nजानन्विचरति प्राज्ञो न स याति पराभवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2075966, "chapter_id": 2608, "verse_number": "१२-११३-१४", "content_sanskrit": "एवमेव यदा विद्वान्मन्यते विपुलं बलम्।\nसंश्रयेद्वैतसीं वृत्तिमेतत्प्रज्ञानलक्षणम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2075967, "chapter_id": 2608, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि त्रयोदशाधिकशततमोऽध्यायः॥ ११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]