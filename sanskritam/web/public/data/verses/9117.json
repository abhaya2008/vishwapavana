[{"id": 5000117000, "chapter_id": 9117, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अयोध्याकाण्डे चत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000117001, "chapter_id": 9117, "verse_number": "२-४०-१", "content_sanskrit": "अथ रामश्च सीता च लक्ष्मणश्च कृताञ्जलिः।\nउपसंगृह्य राजानं चक्रुर्दीनाः प्रदक्षिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000117002, "chapter_id": 9117, "verse_number": "२-४०-२", "content_sanskrit": "तं चापि समनुज्ञाप्य धर्मज्ञः सह सीतया।\nराघवः शोकसम्मूढो जननीमभ्यवादयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000117003, "chapter_id": 9117, "verse_number": "२-४०-३", "content_sanskrit": "अन्वक्षं लक्ष्मणो भ्रातुः कौसल्यामभ्यवादयत्।\nअपि मातुः सुमित्राया जग्राह चरणौ पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000117004, "chapter_id": 9117, "verse_number": "२-४०-४", "content_sanskrit": "तं वन्दमानं रुदती माता सौमित्रिमब्रवीत्।\nहितकामा महाबाहुं मूर्ध्न्युपाघ्राय लक्ष्मणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000117005, "chapter_id": 9117, "verse_number": "२-४०-५", "content_sanskrit": "सृष्टस्त्वं वनवासाय स्वनुरक्तः सुहृज्जने।\nरामे प्रमादं मा कार्षीः पुत्र भ्रातरि गच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000117006, "chapter_id": 9117, "verse_number": "२-४०-६", "content_sanskrit": "व्यसनी वा समृद्धो वा गतिरेष तवानघ।\nएष लोके सतां धर्मो यज्ज्येष्ठवशगो भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000117007, "chapter_id": 9117, "verse_number": "२-४०-७", "content_sanskrit": "इदं हि वृत्तमुचितं कुलस्यास्य सनातनम्।\nदानं दीक्षा च यज्ञेषु तनुत्यागो मृधेषु हि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000117008, "chapter_id": 9117, "verse_number": "२-४०-८", "content_sanskrit": "लक्ष्मणं त्वेवमुक्त्वासौ संसिद्धं प्रियराघवम्।\nसुमित्रा गच्छ गच्छेति पुनः पुनरुवाच तम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000117009, "chapter_id": 9117, "verse_number": "२-४०-९", "content_sanskrit": "रामं दशरथं विद्धि मां विद्धि जनकात्मजाम्।\nअयोध्यामटवीं विद्धि गच्छ तात यथासुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000117010, "chapter_id": 9117, "verse_number": "२-४०-१०", "content_sanskrit": "ततः सुमन्त्रः काकुत्स्थं प्राञ्जलिर्वाक्यमब्रवीत्।\nविनीतो विनयज्ञश्च मातलिर्वासवं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000117011, "chapter_id": 9117, "verse_number": "२-४०-११", "content_sanskrit": "रथमारोह भद्रं ते राजपुत्र महायशः।\nक्षिप्रं त्वां प्रापयिष्यामि यत्र मां राम वक्ष्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000117012, "chapter_id": 9117, "verse_number": "२-४०-१२", "content_sanskrit": "चतुर्दश हि वर्षाणि वस्तव्यानि वने त्वया।\nतान्युपक्रमितव्यानि यानि देव्या प्रचोदितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000117013, "chapter_id": 9117, "verse_number": "२-४०-१३", "content_sanskrit": "तं रथं सूर्यसंकाशं सीता हृष्टेन चेतसा।\nआरुरोह वरारोहा कृत्वालंकारमात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000117014, "chapter_id": 9117, "verse_number": "२-४०-१४", "content_sanskrit": "वनवासं हि संख्याय वासांस्याभरणानि च।\nभर्तारमनुगच्छन्त्यै सीतायै श्वशुरो ददौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000117015, "chapter_id": 9117, "verse_number": "२-४०-१५", "content_sanskrit": "तथैवायुधजातानि भ्रातृभ्यां कवचानि च।\nरथोपस्थे प्रविन्यस्य सचर्म कठिनं च यत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000117016, "chapter_id": 9117, "verse_number": "२-४०-१६", "content_sanskrit": "अथो ज्वलनसंकाशं चामीकरविभूषितम्।\nतमारुरुहतुस्तूर्णं भ्रातरौ रामलक्ष्मणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000117017, "chapter_id": 9117, "verse_number": "२-४०-१७", "content_sanskrit": "सीतातृतीयानारूढान् दृष्ट्वा रथमचोदयत्।\nसुमन्त्रः सम्मतानश्वान् वायुवेगसमाञ्जवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000117018, "chapter_id": 9117, "verse_number": "२-४०-१८", "content_sanskrit": "प्रयाते तु महारण्यं चिररात्राय राघवे।\nबभूव नगरे मूर्च्छा बलमूर्च्छा जनस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000117019, "chapter_id": 9117, "verse_number": "२-४०-१९", "content_sanskrit": "तत् समाकुलसम्भ्रान्तं मत्तसंकुपितद्विपम्।\nहयसिञ्जितनिर्घोषं पुरमासीन्महास्वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000117020, "chapter_id": 9117, "verse_number": "२-४०-२०", "content_sanskrit": "ततः सबालवृद्धा सा पुरी परमपीडिता।\nराममेवाभिदुद्राव घर्मार्तः सलिलं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000117021, "chapter_id": 9117, "verse_number": "२-४०-२१", "content_sanskrit": "पार्श्वतः पृष्ठतश्चापि लम्बमानास्तदुन्मुखाः।\nबाष्पपूर्णमुखाः सर्वे तमूचुर्भृशनिःस्वनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000117022, "chapter_id": 9117, "verse_number": "२-४०-२२", "content_sanskrit": "संयच्छ वाजिनां रश्मीन् सूत याहि शनैः शनैः।\nमुखं द्रक्ष्याम रामस्य दुर्दर्शं नो भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000117023, "chapter_id": 9117, "verse_number": "२-४०-२३", "content_sanskrit": "आयसं हृदयं नूनं राममातुरसंशयम्।\nयद् देवगर्भप्रतिमे वनं याति न भिद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000117024, "chapter_id": 9117, "verse_number": "२-४०-२४", "content_sanskrit": "कृतकृत्या हि वैदेही छायेवानुगता पतिम्।\nन जहाति रता धर्मे मेरुमर्कप्रभा यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000117025, "chapter_id": 9117, "verse_number": "२-४०-२५", "content_sanskrit": "अहो लक्ष्मण सिद्धार्थः सततं प्रियवादिनम्।\nभ्रातरं देवसंकाशं यस्त्वं परिचरिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000117026, "chapter_id": 9117, "verse_number": "२-४०-२६", "content_sanskrit": "महत्येषा हि ते बुद्धिरेष चाभ्युदयो महान्।\nएष स्वर्गस्य मार्गश्च यदेनमनुगच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000117027, "chapter_id": 9117, "verse_number": "२-४०-२७", "content_sanskrit": "एवं वदन्तस्ते सोढुं न शेकुर्बाष्पमागतम्।\nनरास्तमनुगच्छन्ति प्रियमिक्ष्वाकुनन्दनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000117028, "chapter_id": 9117, "verse_number": "२-४०-२८", "content_sanskrit": "अथ राजा वृतः स्त्रीभिर्दीनाभिर्दीनचेतनः।\nनिर्जगाम प्रियं पुत्रं द्रक्ष्यामीति ब्रुवन् गृहात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000117029, "chapter_id": 9117, "verse_number": "२-४०-२९", "content_sanskrit": "शुश्रुवे चाग्रतः स्त्रीणां रुदतीनां महास्वनः।\nयथा नादः करेणूनां बद्धे महति कुञ्जरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000117030, "chapter_id": 9117, "verse_number": "२-४०-३०", "content_sanskrit": "पिता हि राजा काकुत्स्थः श्रीमान् सन्नस्तदा बभौ।\nपरिपूर्णः शशी काले ग्रहेणोपप्लुतो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000117031, "chapter_id": 9117, "verse_number": "२-४०-३१", "content_sanskrit": "स च श्रीमानचिन्त्यात्मा रामो दशरथात्मजः।\nसूतं संचोदयामास त्वरितं वाह्यतामिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000117032, "chapter_id": 9117, "verse_number": "२-४०-३२", "content_sanskrit": "रामो याहीति तं सूतं तिष्ठेति च जनस्तथा।\nउभयं नाशकत् सूतः कर्तुमध्वनि चोदितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000117033, "chapter_id": 9117, "verse_number": "२-४०-३३", "content_sanskrit": "निर्गच्छति महाबाहौ रामे पौरजनाश्रुभिः।\nपतितैरभ्यवहितं प्रणनाश महीरजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000117034, "chapter_id": 9117, "verse_number": "२-४०-३४", "content_sanskrit": "रुदिताश्रुपरिद्यूनं हाहाकृतमचेतनम्।\nप्रयाणे राघवस्यासीत् पुरं परमपीडितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000117035, "chapter_id": 9117, "verse_number": "२-४०-३५", "content_sanskrit": "सुस्राव नयनैः स्त्रीणामस्रमायाससम्भवम्।\nमीनसंक्षोभचलितैः सलिलं पङ्कजैरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000117036, "chapter_id": 9117, "verse_number": "२-४०-३६", "content_sanskrit": "दृष्ट्वा तु नृपतिः श्रीमानेकचित्तगतं पुरम्।\nनिपपातैव दुःखेन कृत्तमूल इव द्रुमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000117037, "chapter_id": 9117, "verse_number": "२-४०-३७", "content_sanskrit": "ततो हलहलाशब्दो जज्ञे रामस्य पृष्ठतः।\nनराणां प्रेक्ष्य राजानं सीदन्तं भृशदुःखितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000117038, "chapter_id": 9117, "verse_number": "२-४०-३८", "content_sanskrit": "हा रामेति जनाः केचिद् राममातेति चापरे।\nअन्तःपुरसमृद्धं च क्रोशन्तं पर्यदेवयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000117039, "chapter_id": 9117, "verse_number": "२-४०-३९", "content_sanskrit": "अन्वीक्षमाणो रामस्तु विषण्णं भ्रान्तचेतसम्।\nराजानं मातरं चैव ददर्शानुगतौ पथि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000117040, "chapter_id": 9117, "verse_number": "२-४०-४०", "content_sanskrit": "स बद्ध इव पाशेन किशोरो मातरं यथा।\nधर्मपाशेन संयुक्तः प्रकाशं नाभ्युदैक्षत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000117041, "chapter_id": 9117, "verse_number": "२-४०-४१", "content_sanskrit": "पदातिनौ च यानार्हावदुःखार्हौ सुखोचितौ।\nदृष्ट्वा संचोदयामास शीघ्रं याहीति सारथिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000117042, "chapter_id": 9117, "verse_number": "२-४०-४२", "content_sanskrit": "नहि तत् पुरुषव्याघ्रो दुःखजं दर्शनं पितुः।\nमातुश्च सहितुं शक्तस्तोत्त्रैर्नुन्न इव द्विपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000117043, "chapter_id": 9117, "verse_number": "२-४०-४३", "content_sanskrit": "प्रत्यगारमिवायान्ती सवत्सा वत्सकारणात्।\nबद्धवत्सा यथा धेनू राममाताभ्यधावत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000117044, "chapter_id": 9117, "verse_number": "२-४०-४४", "content_sanskrit": "तथा रुदन्तीं कौसल्यां रथं तमनुधावतीम्।\nक्रोशन्तीं राम रामेति हा सीते लक्ष्मणेति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000117045, "chapter_id": 9117, "verse_number": "२-४०-४५", "content_sanskrit": "रामलक्ष्मणसीतार्थं स्रवन्तीं वारि नेत्रजम्।\nअसकृत् प्रैक्षत स तां नृत्यन्तीमिव मातरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000117046, "chapter_id": 9117, "verse_number": "२-४०-४६", "content_sanskrit": "तिष्ठेति राजा चुक्रोश याहि याहीति राघवः।\nसुमन्त्रस्य बभूवात्मा चक्रयोरिव चान्तरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000117047, "chapter_id": 9117, "verse_number": "२-४०-४७", "content_sanskrit": "नाश्रौषमिति राजानमुपालब्धोऽपि वक्ष्यसि।\nचिरं दुःखस्य पापिष्ठमिति रामस्तमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000117048, "chapter_id": 9117, "verse_number": "२-४०-४८", "content_sanskrit": "स रामस्य वचः कुर्वन्ननुज्ञाप्य च तं जनम्।\nव्रजतोऽपि हयान् शीघ्रं चोदयामास सारथिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000117049, "chapter_id": 9117, "verse_number": "२-४०-४९", "content_sanskrit": "न्यवर्तत जनो राज्ञो रामं कृत्वा प्रदक्षिणम्।\nमनसाप्याशुवेगेन न न्यवर्तत मानुषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000117050, "chapter_id": 9117, "verse_number": "२-४०-५०", "content_sanskrit": "यमिच्छेत् पुनरायातं नैनं दूरमनुव्रजेत्।\nइत्यमात्या महाराजमूचुर्दशरथं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000117051, "chapter_id": 9117, "verse_number": "२-४०-५१", "content_sanskrit": "तेषां वचः सर्वगुणोपपन्नः\nप्रस्विन्नगात्रः प्रविषण्णरूपः।\nनिशम्य राजा कृपणः सभार्यो\nव्यवस्थितस्तं सुतमीक्षमाणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000117052, "chapter_id": 9117, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अयोध्याकाण्डे चत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]