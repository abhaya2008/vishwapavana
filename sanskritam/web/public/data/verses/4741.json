[{"id": 2177002, "chapter_id": 4741, "verse_number": "", "content_sanskrit": "कृपः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2177003, "chapter_id": 4741, "verse_number": "१", "content_sanskrit": "दिष्ट्या ते प्रतिकर्तव्ये बुद्धिर्जातेयमच्युत ।\nन त्वां वारयितुं शक्तो वज्रपाणिरपि स्वयम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2177004, "chapter_id": 4741, "verse_number": "२", "content_sanskrit": "अनुयास्यावहे त्वां हि प्रभाते सहितावुभौ ।\nअद्य रात्रौ विश्रमस्व विमुक्तकवचध्वजः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2177005, "chapter_id": 4741, "verse_number": "३", "content_sanskrit": "अहं त्वामनुयास्यामि कृतवर्मा च सात्वतः ।\nपरानभिमुखं यान्तं रथमास्थाय दंसितौ\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2177006, "chapter_id": 4741, "verse_number": "४", "content_sanskrit": "आवाभ्यां सहितः शत्रून् श्वो निहन्ता समागमे ।\nविक्रम्य रथिनां श्रेष्ठ पाञ्चालान् सपदानुगान्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2177007, "chapter_id": 4741, "verse_number": "५", "content_sanskrit": "शक्तस्त्वमसि विक्रम्य विश्रमस्व निशामिमाम् ।\nचरञ्चरे जागरितं स्वप तात निशामिमाम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2177008, "chapter_id": 4741, "verse_number": "६", "content_sanskrit": "विश्रान्तस्य सनिद्रश्च स्वस्थचित्तश्च मानद ।\nसमेत्य समरे शत्रून् वधिष्यसि न संशयः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2177009, "chapter_id": 4741, "verse_number": "७", "content_sanskrit": "न हि त्वां रथिनां श्रेष्ठं प्रगृहीतवरायुधम् ।\nजेतुमुत्सहते कश्चिद् दिवि देवेषु पावकिः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2177010, "chapter_id": 4741, "verse_number": "८", "content_sanskrit": "कृपेण सहितं यान्तं युक्तं वै कृतवर्मणा ।\nको द्रौणिं युधि संरब्धं योधयेदपि देवराट्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2177011, "chapter_id": 4741, "verse_number": "९", "content_sanskrit": "ते वयं परिविश्रान्ताः सनिद्रा विगतज्वराः ।\nप्रभातायां रजन्यां तु निहनिष्याम शात्रवान्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2177012, "chapter_id": 4741, "verse_number": "१०", "content_sanskrit": "तव ह्यस्त्राणि दिव्यानि मम चैव न संशयः ।\nसात्वतोऽपि महेष्वासो नित्यं युद्धेषु कोविदः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2177013, "chapter_id": 4741, "verse_number": "११", "content_sanskrit": "ते वयं सहितास्तात सर्वान् शत्रून् समागतान् ।\nप्रसह्य समरे हत्वा प्रीतिं यास्याम पुष्कलाम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2177014, "chapter_id": 4741, "verse_number": "१२", "content_sanskrit": "विश्रमस्व त्वमप्यद्य स्वप चेमां निशां सुखम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2177015, "chapter_id": 4741, "verse_number": "१३", "content_sanskrit": "अहं च कृतवर्मा च प्रभाते त्वां नरोत्तम ।\nअनुयास्याव सहितौ धन्विनौ परतापिनौ\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2177016, "chapter_id": 4741, "verse_number": "१४", "content_sanskrit": "रथिनं तरसा यान्तं रथावास्थाय दंसितौ\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2177017, "chapter_id": 4741, "verse_number": "१५", "content_sanskrit": "स गत्वा शिबिरं तेषां नाम विश्राव्य चाहवे ।\nततः कर्तासि शत्रूणां युध्यतां कदनं महत्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2177018, "chapter_id": 4741, "verse_number": "१६", "content_sanskrit": "कृत्वा च कदनं तेषां प्रभाते विमलेऽहनि ।\nविहरस्व यथा शक्रः सूदयित्वा महारथान्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2177019, "chapter_id": 4741, "verse_number": "१७", "content_sanskrit": "त्वं हि शक्तो रणे जेतुं पाञ्चालानां वरूथिनीम् ।\nदैत्यसेनामिव क्रुद्धः सर्वदानवसूदनः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2177020, "chapter_id": 4741, "verse_number": "१८", "content_sanskrit": "मया त्वां सहितं सङ्खे गुप्तं च कृतवर्मणा ।\nन सहेत विभुः साक्षाद् वज्रपाणिरपि स्वयम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2177021, "chapter_id": 4741, "verse_number": "१९", "content_sanskrit": "न चाहं समरे तात कृतवर्मा तथैव च ।\nअनिर्जित्य रणे पाण्डून् अपयास्याम कर्हिचित्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2177022, "chapter_id": 4741, "verse_number": "२०", "content_sanskrit": "हत्वा च समरे क्षुद्रान् पाञ्चालान् सह पाण्डवैः ।\nनिवर्तयिष्यामहे सर्वे हता वा स्वर्गगा वयम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2177023, "chapter_id": 4741, "verse_number": "२१", "content_sanskrit": "सर्वोपायसहायास्ते प्रभाते वयमाहवे ।\nसत्यमेतन्महाबाहो प्रब्रवीमि तवानघ\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2177024, "chapter_id": 4741, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2177025, "chapter_id": 4741, "verse_number": "२२", "content_sanskrit": "एवमुक्तस्ततो द्रौणिर्मातुलेन हितं वचः ।\nअब्रवीन्मातुलं राजन् क्रोधादुद्वृत्य लोचने\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2177026, "chapter_id": 4741, "verse_number": "", "content_sanskrit": "द्रौणिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2177027, "chapter_id": 4741, "verse_number": "२३", "content_sanskrit": "आतुरस्य कुतो निद्रा नरस्यामर्षितस्य वा ।\nअर्थांश्चिन्तयतश्चापि कामयानस्य वा पुनः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2177028, "chapter_id": 4741, "verse_number": "२४", "content_sanskrit": "तदिदं समनुप्राप्तं पश्य मेऽद्य चतुष्टयम् ।\nयस्य भागश्चतुर्थो वै स्वप्नमह्नाय नाशयेत्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2177029, "chapter_id": 4741, "verse_number": "२५", "content_sanskrit": "किं नाम दुःखं लोकेऽस्मिन् पितुर्वधमनुस्मरन् ।\nहृदयं निहतं यन्मे रात्र्यहानि न शाम्यति\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2177030, "chapter_id": 4741, "verse_number": "२६", "content_sanskrit": "यथा च निहतः पापैः पिता मम विशेषतः ।\nप्रत्यक्षमपि ते सर्वं तन्मे मर्माणि कृन्तति\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2177031, "chapter_id": 4741, "verse_number": "२७", "content_sanskrit": "कथं हि मादृशो लोके मुहूर्तमपि जीवति ।\nद्रोणहन्तेति यद्वाचः पाञ्चालानां शृणोम्यहम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2177032, "chapter_id": 4741, "verse_number": "२८", "content_sanskrit": "धृष्टद्युम्नमहत्वाऽऽजौ नाहं जीवितुमुत्सहे ।\nस मे पितुर्वधाद्वध्यः पाञ्चाला ये च सङ्गताः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2177033, "chapter_id": 4741, "verse_number": "२९", "content_sanskrit": "विलापो भग्नसक्थस्य यस्तु राज्ञो मया श्रुतः ।\nस पुनर्हृदयं कस्य क्रूरस्यापि न निर्दहेत्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2177034, "chapter_id": 4741, "verse_number": "३०", "content_sanskrit": "कस्य नाकरुणस्यापि नेत्राभ्यामास्रमास्रवेत् ।\nनृपतेर्भिन्नसक्थस्य श्रुत्वा तादृग्वचः पुनः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2177035, "chapter_id": 4741, "verse_number": "३१", "content_sanskrit": "अयं च मित्रपक्षो मे मयि जीवति निर्जितः ।\nशोकं मे वर्धयत्येष वारिवेग इवार्णवम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2177036, "chapter_id": 4741, "verse_number": "३२", "content_sanskrit": "अनेकाग्रस्य मे तस्य कुतो निद्रा कुतःसुखम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2177037, "chapter_id": 4741, "verse_number": "३३", "content_sanskrit": "वासुदेवार्जुनाभ्यां हि तानहं परिरक्षितान् ।\nअविषह्यतमान् मन्ये महेन्द्रेणापि मातुल\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2177038, "chapter_id": 4741, "verse_number": "३४", "content_sanskrit": "न चास्मि शक्यः संयन्तुमस्मात् कार्यात् कथञ्चन ।\nतं न पश्यामि लोके मां योऽस्मात्कार्याद् विचालयेत्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2177039, "chapter_id": 4741, "verse_number": "समाप्तिः", "content_sanskrit": "इति मे निश्चिता बुद्धिरेषा साधुतमा च मे\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2177040, "chapter_id": 4741, "verse_number": "३६", "content_sanskrit": "वादिकैः कथ्यमानस्तु मित्राणां मे पराभवः ।\nपाण्डवानां च विजयो हृदयं दहतीव मे\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2177041, "chapter_id": 4741, "verse_number": "३७", "content_sanskrit": "अहं तु कदनं कृत्वा शत्रूणामद्य सौप्तिके ।\nततो विश्रमिता चैव स्वप्ता च विगतज्वरः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2177042, "chapter_id": 4741, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nसौप्तिकपर्वणि अश्वत्थामकृपसंवादो नाम चतुर्थोऽध्यायः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]