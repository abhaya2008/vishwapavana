[{"id": 2112806, "chapter_id": 3431, "verse_number": "", "content_sanskrit": "कुन्तेः पूर्ववृत्तान्तः । कुन्तभोजगृहे तस्या दुर्वाससो\nमन्त्रप्राप्तिः । सूर्यात् कर्णोत्पत्तिः । कर्णस्य यमुनायां विसर्जनम् ।\nराधाभर्त्रा स्वीकृत्य नामकरणम् । सङ्क्षेपतः कर्णचरित्रकथनं च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2112807, "chapter_id": 3431, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2112808, "chapter_id": 3431, "verse_number": "१", "content_sanskrit": "शूरो नाम यदुश्रेष्ठो वसुदेवपिताऽभवत् ।\nतस्य कन्या पृथा नाम रूपेणासदृशी भुवि \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2112809, "chapter_id": 3431, "verse_number": "२", "content_sanskrit": "पैतृष्वसेयाय ततः सोऽनपत्याय वीर्यवान् ।\nअग्रमग्रे प्रतिज्ञाय स्वस्यापत्यं च वीर्यवान्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2112810, "chapter_id": 3431, "verse_number": "३", "content_sanskrit": "अग्रजातां तु तां कन्यामग्रानुग्रहकाङ्क्षया ।\nअददात् कुन्तिभोजाय शूरो गोपतये सुताम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2112811, "chapter_id": 3431, "verse_number": "४", "content_sanskrit": "सा नियुक्ता पितुर्गेहे देवतातिथिभोजने ।\nउग्रं पर्यचरत् साङ्गं ब्राह्मणं संशितव्रतम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2112812, "chapter_id": 3431, "verse_number": "५", "content_sanskrit": "निरूढनिश्चयं धर्मे दुर्वासा इति यं विदुः ।\nतमुग्रं संशितात्मानं सर्वयत्नैरतोषयत्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2112813, "chapter_id": 3431, "verse_number": "६", "content_sanskrit": "दुर्वासा वत्सरस्यान्ते ददौ मन्त्रमनुत्तमम् ।\nयशस्विन्यै पृथायै स आपद्धर्मान्ववेक्षया \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2112814, "chapter_id": 3431, "verse_number": "७", "content_sanskrit": "अभिसाराभिसंयुक्तमब्रवीच्चैव तां मुनिः ।\nयं यं देवं त्वमेतेन मन्त्रेणावाहयिष्यसि \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2112815, "chapter_id": 3431, "verse_number": "८", "content_sanskrit": "तस्य तस्य प्रसादाद् वै पुत्रस्तव जनिष्यते ।\nतथोक्ता सा तु मुनिना तस्य कौतूहलात् तदा \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2112816, "chapter_id": 3431, "verse_number": "९", "content_sanskrit": "कन्या सती देवमर्कमाजुहाव यशस्विनी ।\nततो घनान्तरं कृत्वा स्वमार्गं तपनस्तदा \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2112817, "chapter_id": 3431, "verse_number": "१०", "content_sanskrit": "उपतस्थे स तां कन्यां पृथां पृथुललोचनाम् ।\nसा ददर्श तमायान्तं विस्मयाल्लोकभावनम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2112818, "chapter_id": 3431, "verse_number": "११", "content_sanskrit": "विस्मिता चानवद्याङ्गी दृष्ट्वा तं तपनं तदा ।\nसाऽब्रवीद् भगवन् कस्त्वं प्रादुर्भूतो ममाग्रतः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2112819, "chapter_id": 3431, "verse_number": "", "content_sanskrit": "सूर्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2112820, "chapter_id": 3431, "verse_number": "१२", "content_sanskrit": "आहूतोपस्थितं भद्रे ऋषिमन्त्रेण चोदितम् ।\nविद्धि मां पुत्रलाभाय देवमर्कं शुभानने\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2112821, "chapter_id": 3431, "verse_number": "", "content_sanskrit": "कुन्ती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2112822, "chapter_id": 3431, "verse_number": "१३", "content_sanskrit": "कश्चिन्मे ब्रह्मवित् प्रादाद् वरविद्यां च शत्रुहन् ।\nतद्विजिज्ञासयाऽऽह्वानं कृतवत्यस्मि ते विभो \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2112823, "chapter_id": 3431, "verse_number": "१४", "content_sanskrit": "एतस्मिन्नपराधे त्वां शिरसाऽभिप्रसादये ।\nयोषितो हि सदा रक्ष्यास्त्वपराधेऽपि नित्यशः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2112824, "chapter_id": 3431, "verse_number": "", "content_sanskrit": "सूर्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2112825, "chapter_id": 3431, "verse_number": "१५", "content_sanskrit": "वेदाहं सर्वमेवैतद् यद् दुर्वासा वरं ददौ ।\nसन्त्यज्योभे मानभये क्रियतां सङ्गमो मया\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2112826, "chapter_id": 3431, "verse_number": "१६", "content_sanskrit": "अमोघं दर्शनं मह्यमाहूतश्चास्मि ते शुभे ।\nवृथाह्वानाद्धि ते भीरु दोषो हि स्यादसंशयः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2112827, "chapter_id": 3431, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2112828, "chapter_id": 3431, "verse_number": "१७", "content_sanskrit": "एवमुक्ता बहुविधं सान्त्वपूर्वं विवस्वता ।\nसा तु नैच्छद् वरारोहा कन्याऽहमिति पार्थिव \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2112829, "chapter_id": 3431, "verse_number": "१८", "content_sanskrit": "बन्धुपक्षभयाद् भीता लज्जया च यशस्विनी ।\nतामर्कः पुनरेवेदमब्रवीद् भरतर्षभ \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2112830, "chapter_id": 3431, "verse_number": "१९", "content_sanskrit": "पुत्रस्ते निर्मितः सुभ्रु शृणु यादृक् शुभानने ।\nआदित्ये कुण्डले बिभ्रत्कवचं चैव मामकम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2112831, "chapter_id": 3431, "verse_number": "२०", "content_sanskrit": "शस्त्रास्त्राणामभेद्यं च भविष्यति शुचिस्मिते ।\nन न किञ्चन देयं तु ब्राह्मणेभ्यो भविष्यति \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2112832, "chapter_id": 3431, "verse_number": "२१", "content_sanskrit": "चोद्यमानो मया चापि नाक्षत्रं चिन्तयिष्यति ।\nदास्यत्येव हि विप्रेभ्यो मानी चैव भविष्यति \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2112833, "chapter_id": 3431, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2112834, "chapter_id": 3431, "verse_number": "२२", "content_sanskrit": "एवमुक्ता ततः कुन्ती गोपतिं प्रत्युवाच ह ।\nकन्या पितृवशा चाहमपत्यार्थो न चैव मे \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2112835, "chapter_id": 3431, "verse_number": "", "content_sanskrit": "सूर्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2112836, "chapter_id": 3431, "verse_number": "२३", "content_sanskrit": "यद्येवं मन्यसे भीरु किमाह्वयसि भास्करम् ।\nयदि मामवजानासि ऋषिः स न भविष्यति \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2112837, "chapter_id": 3431, "verse_number": "२४", "content_sanskrit": "मन्त्रदानेन यस्य त्वमवलेपेन दर्पिता ।\nकुलं च तेऽद्य धक्ष्यामि क्रोधदीप्तेन चक्षुषा \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2112838, "chapter_id": 3431, "verse_number": "", "content_sanskrit": "कुन्ती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2112839, "chapter_id": 3431, "verse_number": "२५", "content_sanskrit": "प्रसीद भगवन्देव अवलेपो हि नास्ति मे ।\nमया त्वपरिहार्यं स्यात् कन्याभावस्य दूषणम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2112840, "chapter_id": 3431, "verse_number": "", "content_sanskrit": "सूर्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2112841, "chapter_id": 3431, "verse_number": "२६", "content_sanskrit": "व्यपयातु भयं तेऽद्य कुमारं प्रभविष्यसे ।\nमया त्वं चाभ्यनुज्ञाता पुनः कन्या भविष्यसि \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2112842, "chapter_id": 3431, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2112843, "chapter_id": 3431, "verse_number": "२७", "content_sanskrit": "एवमुक्ता ततः कुन्ती सम्प्रहृष्टतनूरुहा ।\nसङ्गता च तदा सुभ्रूरादित्येन महात्मना \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2112844, "chapter_id": 3431, "verse_number": "२८", "content_sanskrit": "प्रकाशकर्मा तपनः कन्यागर्भं दधौ ततः ।\nअजीजनत् ततो वीरं सर्वशस्त्रभृतां वरम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2112845, "chapter_id": 3431, "verse_number": "२९", "content_sanskrit": "आमुक्तकवचःश्रीमान् कुण्डलाभ्यां समावृतः ।\nसोऽजायत तदा वीरः सर्वलोकेषु विश्रुतः \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2112846, "chapter_id": 3431, "verse_number": "२९", "content_sanskrit": "मञ्जूषां रत्नसम्पूर्णां कर्णनामाभिसञ्ज्ञिताम् ।\nगूहमानाऽपचारं तं बन्धुपक्षभयात् तदा \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2112847, "chapter_id": 3431, "verse_number": "३०", "content_sanskrit": "उत्ससर्ज जले कुन्ती तं कुमारं सलक्षणम् ।\nप्रादाच्च तस्याः कन्यात्वं पुनः स परमद्युतिः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2112848, "chapter_id": 3431, "verse_number": "३१", "content_sanskrit": "दत्वा च वरदश्रेष्ठो दिवमाचक्रमे पुनः ।\nतमुत्सृष्टं तदा गर्भं राधाभर्ता महायशाः \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2112849, "chapter_id": 3431, "verse_number": "३२", "content_sanskrit": "पुत्रत्वे कल्पयामास भार्यायाः सूतनन्दनः ।\nनामधेयं च चक्राते तस्य बालस्य तावुभौ \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2112850, "chapter_id": 3431, "verse_number": "३३", "content_sanskrit": "समाहृतोऽयं वसुना वसुषेणेति नामतः ।\nस वर्धमानो बलवान् सर्वास्त्रेषूद्यतोऽभवत् ।\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2112851, "chapter_id": 3431, "verse_number": "३४", "content_sanskrit": "आपृष्ठतापाच्चादित्यमुपतस्थे कृताञ्जलिः ।\nयस्मिन् काले जपन्नास्ते स वीरः सत्यसङ्गरः \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2112852, "chapter_id": 3431, "verse_number": "३५", "content_sanskrit": "नादेयं ब्राह्मणायासीत् तस्मिन् काले महात्मनः ।\nततः काले तु कस्मिंश्चित् स्वप्नान्ते कर्णमब्रवीत् \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2112853, "chapter_id": 3431, "verse_number": "३६", "content_sanskrit": "आदित्यो ब्राह्मणो भूत्वा शृणु वीर वचो मम ।\nप्रभातायां रजन्यां त्वामागमिष्यति वासवः \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2112854, "chapter_id": 3431, "verse_number": "३७", "content_sanskrit": "न तस्य भिक्षा दातव्या विप्ररूपो भविष्यति ।\nनिश्चयोऽस्यापहर्तुं ते कवचं कुण्डले तथा ।\nअतस्त्वां बोधयाम्येष निबोध वचनं मम \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2112855, "chapter_id": 3431, "verse_number": "", "content_sanskrit": "कर्णः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2112856, "chapter_id": 3431, "verse_number": "३८", "content_sanskrit": "शक्रो मां विप्ररूपेण यदि वै याचते द्विज ।\nकथं चास्मै न दास्यामि यथा चास्म्यवबोधितः \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2112857, "chapter_id": 3431, "verse_number": "३९", "content_sanskrit": "विप्राः पूज्यास्तु देवानां प्रियमस्तीति ब्राह्मण ।\nतं देवदेवं जानन् वै न शक्नोम्यवमन्त्रणे \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2112858, "chapter_id": 3431, "verse_number": "", "content_sanskrit": "सूर्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2112859, "chapter_id": 3431, "verse_number": "४०", "content_sanskrit": "यद्येवं शृणु मे वीर वरं ते सोऽपि दास्यति ।\nशक्तिं त्वमपि याचेथाः सर्वशत्रुनिबर्हिणीम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2112860, "chapter_id": 3431, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2112861, "chapter_id": 3431, "verse_number": "४१", "content_sanskrit": "एवमुक्त्वा द्विजः स्वप्ने तत्रैवान्तरधीयत ।\nकर्णः प्रबुद्धस्तं स्वप्नं चिन्तयानोऽभवत् तदा \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2112862, "chapter_id": 3431, "verse_number": "४२", "content_sanskrit": "तमिन्द्रो ब्राह्मणो भूत्वा पुत्रार्थं भूतभावनः ।\nकुण्डले प्रार्थयामास कवचं च महाद्युतिः \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2112863, "chapter_id": 3431, "verse_number": "४३", "content_sanskrit": "उत्कृत्याविमनाः स्वाङ्गात् कवचं रुधिरस्रवम् ।\nकर्णपाल्यौ च द्वे च्छित्वा प्रायच्छत् स कृताञ्जलिः \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2112864, "chapter_id": 3431, "verse_number": "४४", "content_sanskrit": "अहो साहसमित्येवं मनसा वासवो हसन् ।\nदेवदानवयक्षाणां गन्धर्वोरगरक्षसाम्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2112865, "chapter_id": 3431, "verse_number": "४५", "content_sanskrit": "न तं पश्यामि को ह्मेतत् कर्म कर्ता भविष्यति ।\nप्रीतोऽस्मि कर्मणा तेन वरं ब्रूहि यमिच्छसि\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2112866, "chapter_id": 3431, "verse_number": "", "content_sanskrit": "कर्णः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2112867, "chapter_id": 3431, "verse_number": "", "content_sanskrit": "इच्छामि भगवद्दत्तां शक्तिं शत्रुनिबर्हिणीम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2112868, "chapter_id": 3431, "verse_number": "", "content_sanskrit": "वैशम्पयानः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2112869, "chapter_id": 3431, "verse_number": "४६", "content_sanskrit": "शक्तिं तस्मै ददौ शक्रो विस्मितो वाक्यमब्रवीत्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2112870, "chapter_id": 3431, "verse_number": "४७", "content_sanskrit": "देवदानवयक्षाणां गन्धर्वोरगरक्षसाम् ।\nयस्मै क्षेप्स्यसि रुष्टः सन् सोऽनया न भविष्यति ।\nहत्वैकं समरे शत्रुं ततो मामागमिष्यति \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2112871, "chapter_id": 3431, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2112872, "chapter_id": 3431, "verse_number": "४८", "content_sanskrit": "पुरा नाम तु तस्याऽऽसीद् वसुषेण इति स्मृतम् ।\nततो वैकर्तनः कर्णः स तस्मात् कारणादिति \t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2112873, "chapter_id": 3431, "verse_number": "११०", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nदशाधिकशततमोऽध्यायः ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2112874, "chapter_id": 3431, "verse_number": "५८", "content_sanskrit": "॥ इति सम्भवपर्वणि अष्टपञ्चाशोऽध्यायः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2112875, "chapter_id": 3431, "verse_number": "", "content_sanskrit": "* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}]