[{"id": 7001219000, "chapter_id": 21219, "verse_number": "२-४-१२-१", "content_sanskrit": "ब्रह्मोवाच ।\nनिहतं तारकं दृष्ट्वा देवा विष्णुपुरोगमाः ।\nतुष्टुवुश्शांकरिं भक्त्या सर्वेऽन्ये मुदिताननाः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001219001, "chapter_id": 21219, "verse_number": "२-४-१२-२", "content_sanskrit": "देवा ऊचुः ।\nनमः कल्याणरूपाय नमस्ते विश्वमंगल ।\nविश्वबंधो नमस्तेऽस्तु नमस्ते विश्वभावन॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001219002, "chapter_id": 21219, "verse_number": "२-४-१२-३", "content_sanskrit": "नमोस्तु ते दानववर्यहंत्रे बाणासुरप्राणहराय देव ।\nप्रलंबनाशाय पवित्ररूपिणे नमोनमश्शंकरतात तुभ्यम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001219003, "chapter_id": 21219, "verse_number": "२-४-१२-४", "content_sanskrit": "त्वमेव कर्त्ता जगतां च भर्त्ता त्वमेव हर्त्ता शुचिज प्रसीद ।\nप्रपञ्चभूतस्तव लोकबिंबः प्रसीद शम्भ्वात्मज दीनबंधो॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001219004, "chapter_id": 21219, "verse_number": "२-४-१२-५", "content_sanskrit": "देवरक्षाकर स्वामिन्रक्ष नस्सर्वदा प्रभो ।\nदेवप्राणावन कर प्रसीद करुणाकर॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001219005, "chapter_id": 21219, "verse_number": "२-४-१२-६", "content_sanskrit": "हत्वा ते तारकं दैत्यं परिवारयुतं विभो ।\nमोचितास्सकला देवा विपद्भ्यः परमेश्वर॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001219006, "chapter_id": 21219, "verse_number": "२-४-१२-७", "content_sanskrit": "ब्रह्मोवाच ।\nएवं स्तुतः कुमारोऽसौ देवैर्विष्णुमुखैः प्रभुः ।\nवरान्ददावभिनवान्सर्वेभ्यः क्रमशो मुने॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001219007, "chapter_id": 21219, "verse_number": "२-४-१२-८", "content_sanskrit": "शैलान्निरीक्ष्य स्तुवतस्ततस्स गिरिशात्मजः ।\nसुप्रसन्नतरो भूत्वा प्रोवाच प्रददद्वरान्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001219008, "chapter_id": 21219, "verse_number": "२-४-१२-९", "content_sanskrit": "स्कन्द उवाच ।\nयूयं सर्वे पर्वता हि पूजनीयास्तपस्विभिः ।\nकर्मिभिर्ज्ञानिभिश्चैव सेव्यमाना भविष्यथ॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001219009, "chapter_id": 21219, "verse_number": "२-४-१२-१०", "content_sanskrit": "शंभोर्विशिष्टरूपाणि लिंगरूपाणि चैव हि ।\nभविष्यथ न संदेहः पर्वता वचनान्मम॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001219010, "chapter_id": 21219, "verse_number": "२-४-१२-११", "content_sanskrit": "योऽयं मातामहो मेऽद्य हिमवान्पर्वतोत्तमः ।\nतपस्विनां महाभागः फलदो हि भविष्यति॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001219011, "chapter_id": 21219, "verse_number": "२-४-१२-१२", "content_sanskrit": "देवा ऊचुः ।\nएवं दत्त्वा वरान्हत्वा तारकं चासुराधिपम् ।\nत्वया कृताश्च सुखिनो वयं सर्वे चराचराः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001219012, "chapter_id": 21219, "verse_number": "२-४-१२-१३", "content_sanskrit": "इदानीं खलु सुप्रीत्या कैलासं गिरिशालयम् ।\nजननी जनकौ द्रष्टुं शिवाशंभू त्वमर्हसि॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001219013, "chapter_id": 21219, "verse_number": "२-४-१२-१४", "content_sanskrit": "ब्रह्मोवाच ।\nइत्युक्त्वा निखिला देवा विष्ण्वाद्या प्राप्तशासनाः ।\nकृत्वा महोत्सवं भूरि सकुमारा ययुर्गिरिम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001219014, "chapter_id": 21219, "verse_number": "२-४-१२-१५", "content_sanskrit": "कुमारे गच्छति विभौ कैलासं शंकरालयम् ।\nमहामंगलमुत्तस्थौ जयशब्दो बभूव ह॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001219015, "chapter_id": 21219, "verse_number": "२-४-१२-१६", "content_sanskrit": "आरुरोह कुमारोऽसौ विमानं परमर्द्धिमत् ।\nसर्वतोलंकृतं रम्यं सर्वोपरि विराजितम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001219016, "chapter_id": 21219, "verse_number": "२-४-१२-१७", "content_sanskrit": "अहं विष्णुश्च समुदौ तदा चामरधारिणौ ।\nगुह मूर्ध्नि महाप्रीत्या मुनेऽभूव ह्यतंद्रितौ॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001219017, "chapter_id": 21219, "verse_number": "२-४-१२-१८", "content_sanskrit": "इन्द्राद्या अमरास्सर्वे कुर्वंतो गुहसेवनम् ।\nयथोचितं चतुर्दिक्षु जग्मुश्च प्रमुदास्तदा॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001219018, "chapter_id": 21219, "verse_number": "२-४-१२-१९", "content_sanskrit": "शंभोर्जयं प्रभाषंतः प्रापुस्ते शंभुपर्वतम् ।\nसानंदा विविशुस्तत्रोच्चरितो मंगलध्वनिः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001219019, "chapter_id": 21219, "verse_number": "२-४-१२-२०", "content_sanskrit": "दृष्ट्वा शिवं शिवां चैव सर्वे विष्ण्वादयो द्रुतम् ।\nप्रणम्य शंकरं भक्त्या करौ बद्ध्वा विनम्रकाः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001219020, "chapter_id": 21219, "verse_number": "२-४-१२-२१", "content_sanskrit": "कुमारोऽपि विनीतात्मा विमानादवतीर्य च ।\nप्रणनाम मुदा शंभुं शिवां सिंहासनस्थिताम्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001219021, "chapter_id": 21219, "verse_number": "२-४-१२-२२", "content_sanskrit": "अथ दृष्ट्वा कुमारं तं तनयं प्राणवल्लभम् ।\nतौ दंपती शिवौ देवौ मुमुदातेऽति नारद॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001219022, "chapter_id": 21219, "verse_number": "२-४-१२-२३", "content_sanskrit": "महाप्रभुस्समुत्थाप्य तमुत्संगे न्यवेशयत् ।\nमूर्ध्नि जघ्रौ मुदा स्नेहात्तं पस्पर्श करेण ह॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001219023, "chapter_id": 21219, "verse_number": "२-४-१२-२४", "content_sanskrit": "महानंदभरः शंभुश्चकार मुखचुंबनम् ।\nकुमारस्य महास्नेहात् तारकारेर्महाप्रभोः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001219024, "chapter_id": 21219, "verse_number": "२-४-१२-२५", "content_sanskrit": "शिवापि तं समुत्थाप्य स्वोत्संगे संन्यवेशयत् ।\nकृत्वा मूर्ध्नि महास्नेहात् तन्मुखाब्जं चुचुम्ब हि॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001219025, "chapter_id": 21219, "verse_number": "२-४-१२-२६", "content_sanskrit": "तयोस्तदा महामोदो ववृधेऽतीव नारद ।\nदंपत्योः शिवयोस्तात भवाचारं प्रकुर्वतोः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001219026, "chapter_id": 21219, "verse_number": "२-४-१२-२७", "content_sanskrit": "तदोत्सवो महानासीन्नानाविधिः शिवालये ।\nजयशब्दो नमश्शब्दो बभूवातीव सर्वतः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001219027, "chapter_id": 21219, "verse_number": "२-४-१२-२८", "content_sanskrit": "ततस्सुरगणास्सर्वे विष्ण्वाद्या मुनयस्तथा ।\nसुप्रणम्य मुदा शंभुं तुष्टुवुस्सशिवं मुने॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001219028, "chapter_id": 21219, "verse_number": "२-४-१२-२९", "content_sanskrit": "देवा ऊचुः ।\nदेवदेव महादेव भक्तानामभयप्रद ।\nनमो नमस्ते बहुशः कृपाकर महेश्वर॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001219029, "chapter_id": 21219, "verse_number": "२-४-१२-३०", "content_sanskrit": "अद्भुता ते महादेव महालीला सुखप्रदा ।\nसर्वेषां शंकर सतां दीनबंधो महाप्रभो॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001219030, "chapter_id": 21219, "verse_number": "२-४-१२-३१", "content_sanskrit": "एवं मूढधियश्चाज्ञाः पूजायां ते सनातनम् ।\nआवाहनं न जानीमो गतिं नैव प्रभोद्भुताम्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001219031, "chapter_id": 21219, "verse_number": "२-४-१२-३२", "content_sanskrit": "गंगासलिलधाराय ह्याधाराय गुणात्मने ।\nनमस्ते त्रिदशेशाय शंकराय नमोनमः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001219032, "chapter_id": 21219, "verse_number": "२-४-१२-३३", "content_sanskrit": "वृषांकाय महेशाय गणानां पतये नमः ।\nसर्वेश्वराय देवाय त्रिलोकपतये नमः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001219033, "chapter_id": 21219, "verse_number": "२-४-१२-३४", "content_sanskrit": "संहर्त्रे जगतां नाथ सर्वेषां ते नमो नमः ।\nभर्त्रे कर्त्रे च देवेश त्रिगुणेशाय शाश्वते॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001219034, "chapter_id": 21219, "verse_number": "२-४-१२-३५", "content_sanskrit": "विसंगाय परेशाय शिवाय परमात्मने ।\nनिष्प्रपंचाय शुद्धाय परमायाव्ययाय च॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001219035, "chapter_id": 21219, "verse_number": "२-४-१२-३६", "content_sanskrit": "दण्डहस्ताय कालाय पाशहस्ताय ते नमः ।\nवेदमंत्रप्रधानाय शतजिह्वाय ते नमः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001219036, "chapter_id": 21219, "verse_number": "२-४-१२-३७", "content_sanskrit": "भूतं भव्यं भविष्यच्च स्थावरं जंगमं च यत् ।\nतव देहात्समुत्पन्नं सर्वथा परमेश्वर॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001219037, "chapter_id": 21219, "verse_number": "२-४-१२-३८", "content_sanskrit": "पाहि नस्सर्वदा स्वामिन्प्रसीद भगवन्प्रभो ।\nवयं ते शरणापन्नाः सर्वथा परमेश्वर॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001219038, "chapter_id": 21219, "verse_number": "२-४-१२-३९", "content_sanskrit": "शितिकण्ठाय रुद्राय स्वाहाकाराय ते नमः ।\nअरूपाय सरूपाय विश्वरूपाय ते नमः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001219039, "chapter_id": 21219, "verse_number": "२-४-१२-४०", "content_sanskrit": "शिवाय नीलकंठाय चिताभस्मांगधारिणे ।\nनित्यं नीलशिखंडाय श्रीकण्ठाय नमोनमः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001219040, "chapter_id": 21219, "verse_number": "२-४-१२-४१", "content_sanskrit": "सर्वप्रणतदेहाय संयमप्रणताय च ।\nमहादेवाय शर्वाय सर्वार्चितपदाय च॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001219041, "chapter_id": 21219, "verse_number": "२-४-१२-४२", "content_sanskrit": "त्वं ब्रह्मा सर्वदेवानां रुद्राणां नीललोहितः ।\nआत्मा च सर्वभूतानां सांख्यैः पुरुष उच्यसे॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001219042, "chapter_id": 21219, "verse_number": "२-४-१२-४३", "content_sanskrit": "पर्वतानां सुमेरुस्त्वं नक्षत्राणां च चन्द्रमा ।\nऋषीणां च वशिष्ठस्त्वं देवानां वासवस्तथा॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001219043, "chapter_id": 21219, "verse_number": "२-४-१२-४४", "content_sanskrit": "अकारस्सर्ववेदानां त्राता भव महेश्वर ।\nत्वं च लोकहितार्थाय भूतानि परिषिंचसि॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001219044, "chapter_id": 21219, "verse_number": "२-४-१२-४५", "content_sanskrit": "महेश्वर महाभाग शुभाशुभनिरीक्षक ।\nआप्यायास्मान्हि देवेश कर्तॄन्वै वचनं तव॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001219045, "chapter_id": 21219, "verse_number": "२-४-१२-४६", "content_sanskrit": "रूपकोटिसहस्रेषु रूपकोटिशतेषु ते ।\nअंतं गंतुं न शक्ताः स्म देवदेव नमोस्तु ते॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001219046, "chapter_id": 21219, "verse_number": "२-४-१२-४७", "content_sanskrit": "॥ ब्रह्मोवाच  ।\nइति स्तुत्वाखिला देवा विष्ण्वाद्या प्रमुखस्थिताः ।\nमुहुर्मुहुस्सुप्रणम्य स्कंदं कृत्वा पुरस्सरम्॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001219047, "chapter_id": 21219, "verse_number": "२-४-१२-४८", "content_sanskrit": "देवस्तुतिं समाकर्ण्य शिवस्सर्वेश्वरस्स्वराट् ।\nसुप्रसन्नो बभूवाथ विजहास दयापरः॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001219048, "chapter_id": 21219, "verse_number": "२-४-१२-४९", "content_sanskrit": "उवाच सुप्रसन्नात्मा विष्ण्वादीन्सुरसत्तमान् ।\nशंकरः परमेशानो दीनबंधुस्सतां गतिः॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001219049, "chapter_id": 21219, "verse_number": "२-४-१२-५०", "content_sanskrit": "शिव उवाच ।\nहे हरे हे विधे देवा वाक्यं मे शृणुतादरात् ।\nसर्वथाहं सतां त्राता देवानां वः कृपानिधिः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001219050, "chapter_id": 21219, "verse_number": "२-४-१२-५१", "content_sanskrit": "दुष्टहंता त्रिलोकेशश्शंकरो भक्तवत्सलः ।\nकर्ता भर्ता च हर्ता च सर्वेषां निर्विकारवान्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001219051, "chapter_id": 21219, "verse_number": "२-४-१२-५२", "content_sanskrit": "यदा यदा भवेद्दुःखं युष्माकं देवसत्तमाः ।\nतदा तदा मां यूयं वै भजंतु सुखहेतवे॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001219052, "chapter_id": 21219, "verse_number": "२-४-१२-५३", "content_sanskrit": "ब्रह्मोवाच ।\nइत्याज्ञप्तस्तदा देवा विष्ण्वाद्यास्समुनीश्वराः ।\nशिवं प्रणम्य सशिवं कुमारं च मुदान्विताः॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001219053, "chapter_id": 21219, "verse_number": "२-४-१२-५४", "content_sanskrit": "कथयंतो यशो रम्यं शिवयोश्शांकरेश्च तत् ।\nआनन्दं परमं प्राप्य स्वधामानि ययु र्मुने॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001219054, "chapter_id": 21219, "verse_number": "२-४-१२-५५", "content_sanskrit": "शिवोपि शिवया सार्द्धं सगणः परमेश्वरः ।\nकुमारेणयुतः प्रीत्योवास तस्मिन्गिरौ मुदा॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001219055, "chapter_id": 21219, "verse_number": "२-४-१२-५६", "content_sanskrit": "इत्येवं कथितं सर्वं कौमारं चरितं मुने ।\nशैवं च सुखदं दिव्यं किमन्यच्छ्रोतुमिच्छसि॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]