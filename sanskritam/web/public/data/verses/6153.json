[
  {
    "id": 16753001,
    "chapter_id": 6153,
    "verse_number": "5.1",
    "content_sanskrit": "अर्जुन उवाच —",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "base_unit_id": "BG_C05_V01"
  },
  {
    "id": 16753002,
    "chapter_id": 6153,
    "verse_number": "5.2",
    "content_sanskrit": "श्रीभगवानुवाच —",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "base_unit_id": "BG_C05_V02"
  },
  {
    "id": 16753003,
    "chapter_id": 6153,
    "verse_number": "5.3",
    "content_sanskrit": "ज्ञेयः स नित्यसंन्यासी यो न द्वेष्टि न काङ्क्षति ।\nनिर्द्वन्द्वो हि महाबाहो सुखं बन्धात्प्रमुच्यते ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "base_unit_id": "BG_C05_V03"
  },
  {
    "id": 16753004,
    "chapter_id": 6153,
    "verse_number": "5.4",
    "content_sanskrit": "साङ्‍ख्ययोगौ पृथग्बालाः प्रवदन्ति न पण्डिताः ।\nएकमप्यास्थितः सम्यगुभयोर्विन्दते फलम् ॥ ४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "base_unit_id": "BG_C05_V04"
  },
  {
    "id": 16753005,
    "chapter_id": 6153,
    "verse_number": "5.5",
    "content_sanskrit": "यत्साङ्‍ख्यैः प्राप्यते स्थानं तद्योगैरपि गम्यते ।\nएकं साङ्‍ख्यं च योगं च यः पश्यति स पश्यति ॥ ५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "base_unit_id": "BG_C05_V05"
  },
  {
    "id": 16753006,
    "chapter_id": 6153,
    "verse_number": "5.6",
    "content_sanskrit": "संन्यासस्तु महाबाहो दुःखमाप्तुमयोगतः ।\nयोगयुक्तो मुनिर्ब्रह्म नचिरेणाधिगच्छति ॥ ६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "base_unit_id": "BG_C05_V06"
  },
  {
    "id": 16753007,
    "chapter_id": 6153,
    "verse_number": "5.7",
    "content_sanskrit": "योगयुक्तो विशुद्धात्मा\nविजितात्मा जितेन्द्रियः ।\nसर्वभूतात्मभूतात्मा\nकुर्वन्नपि न लिप्यते ॥ ७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "base_unit_id": "BG_C05_V07"
  },
  {
    "id": 16753008,
    "chapter_id": 6153,
    "verse_number": "5.8",
    "content_sanskrit": "नैव किञ्चित्करोमीति युक्तो मन्येत तत्त्ववित् ।\nपश्यञ्शृण्वन्स्पृशञ्जिघ्रन्नश्नन्गच्छन्स्वपञ्श्वसन् ॥ ८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "base_unit_id": "BG_C05_V08"
  },
  {
    "id": 16753009,
    "chapter_id": 6153,
    "verse_number": "5.9",
    "content_sanskrit": "प्रलपन् विसृजन्गृह्णन्नुन्मिषन्निमिषन्नपि ।\nइन्द्रियाणीन्द्रियार्थेषु वर्तन्त इति धारयन् ॥ ९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "base_unit_id": "BG_C05_V09"
  },
  {
    "id": 16753010,
    "chapter_id": 6153,
    "verse_number": "5.10",
    "content_sanskrit": "ब्रह्मण्याधाय कर्माणि सङ्गं त्यक्त्वा करोति यः ।\nलिप्यते न स पापेन पद्मपत्रमिवाम्भसा ॥ १० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "base_unit_id": "BG_C05_V10"
  },
  {
    "id": 16753011,
    "chapter_id": 6153,
    "verse_number": "5.11",
    "content_sanskrit": "कायेन मनसा बुद्ध्या केवलैरिन्द्रियैरपि ।\nयोगिनः कर्म कुर्वन्ति सङ्गं त्यक्त्वात्मशुद्धये ॥ ११ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "base_unit_id": "BG_C05_V11"
  },
  {
    "id": 16753012,
    "chapter_id": 6153,
    "verse_number": "5.12",
    "content_sanskrit": "युक्तः कर्मफलं त्यक्त्वा\nशान्तिमाप्नोति नैष्ठिकीम् ।\nअयुक्तः कामकारेण\nफले सक्तो निबध्यते ॥ १२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "base_unit_id": "BG_C05_V12"
  },
  {
    "id": 16753013,
    "chapter_id": 6153,
    "verse_number": "5.13",
    "content_sanskrit": "सर्वकर्माणि मनसा संन्यस्यास्ते सुखं वशी ।\nनवद्वारे पुरे देही नैव कुर्वन्न कारयन् ॥ १३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "base_unit_id": "BG_C05_V13"
  },
  {
    "id": 16753014,
    "chapter_id": 6153,
    "verse_number": "5.14",
    "content_sanskrit": "न कर्तृत्वं न कर्माणि लोकस्य सृजति प्रभुः ।\nन कर्मफलसंयोगं स्वभावस्तु प्रवर्तते ॥ १४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "base_unit_id": "BG_C05_V14"
  },
  {
    "id": 16753015,
    "chapter_id": 6153,
    "verse_number": "5.15",
    "content_sanskrit": "नादत्ते कस्यचित्पापं न चैव सुकृतं विभुः ।\nअज्ञानेनावृतं ज्ञानं तेन मुह्यन्ति जन्तवः ॥ १५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "base_unit_id": "BG_C05_V15"
  },
  {
    "id": 16753016,
    "chapter_id": 6153,
    "verse_number": "5.16",
    "content_sanskrit": "ज्ञानेन तु तदज्ञानं येषां नाशितमात्मनः ।\nतेषामादित्यवज्ज्ञानं प्रकाशयति तत्परम् ॥ १६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "base_unit_id": "BG_C05_V16"
  },
  {
    "id": 16753017,
    "chapter_id": 6153,
    "verse_number": "5.17",
    "content_sanskrit": "तद्बुद्धयस्तदात्मानस्तन्निष्ठास्तत्परायणाः ।\nगच्छन्त्यपुनरावृत्तिं ज्ञाननिर्धूतकल्मषाः ॥ १७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "base_unit_id": "BG_C05_V17"
  },
  {
    "id": 16753018,
    "chapter_id": 6153,
    "verse_number": "5.18",
    "content_sanskrit": "विद्याविनयसम्पन्ने ब्राह्मणे गवि हस्तिनि ।\nशुनि चैव श्वपाके च पण्डिताः समदर्शिनः ॥ १८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "base_unit_id": "BG_C05_V18"
  },
  {
    "id": 16753019,
    "chapter_id": 6153,
    "verse_number": "5.19",
    "content_sanskrit": "इहैव तैर्जितः सर्गो येषां साम्ये स्थितं मनः ।\nनिर्दोषं हि समं ब्रह्म तस्माद्ब्रह्मणि ते स्थिताः ॥ १९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "base_unit_id": "BG_C05_V19"
  },
  {
    "id": 16753020,
    "chapter_id": 6153,
    "verse_number": "5.20",
    "content_sanskrit": "न प्रहृष्येत्प्रियं प्राप्य नोद्विजेत्प्राप्य चाप्रियम् ।\nस्थिरबुद्धिरसंमूढो ब्रह्मविद्ब्रह्मणि स्थितः ॥ २० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "base_unit_id": "BG_C05_V20"
  },
  {
    "id": 16753021,
    "chapter_id": 6153,
    "verse_number": "5.21",
    "content_sanskrit": "बाह्यस्पर्शेष्वसक्तात्मा\nविन्दत्यात्मनि यत्सुखम् ।\nस ब्रह्मयोगयुक्तात्मा\nसुखमक्षयमश्नुते ॥ २१ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "base_unit_id": "BG_C05_V21"
  },
  {
    "id": 16753022,
    "chapter_id": 6153,
    "verse_number": "5.22",
    "content_sanskrit": "ये हि संस्पर्शजा भोगा दुःखयोनय एव ते ।\nआद्यन्तवन्तः कौन्तेय न तेषु रमते बुधः ॥ २२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "base_unit_id": "BG_C05_V22"
  },
  {
    "id": 16753023,
    "chapter_id": 6153,
    "verse_number": "5.23",
    "content_sanskrit": "शक्नोतीहैव यः सोढुं प्राक्छरीरविमोक्षणात् ।\nकामक्रोधोद्भवं वेगं स युक्तः स सुखी नरः ॥ २३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "base_unit_id": "BG_C05_V23"
  },
  {
    "id": 16753024,
    "chapter_id": 6153,
    "verse_number": "5.24",
    "content_sanskrit": "योऽन्तःसुखोऽन्तरारामस्तथान्तर्ज्योतिरेव यः ।\nस योगी ब्रह्मनिर्वाणं ब्रह्मभूतोऽधिगच्छति ॥ २४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "base_unit_id": "BG_C05_V24"
  },
  {
    "id": 16753025,
    "chapter_id": 6153,
    "verse_number": "5.25",
    "content_sanskrit": "लभन्ते ब्रह्मनिर्वाणमृषयः क्षीणकल्मषाः ।\nछिन्नद्वैधा यतात्मानः सर्वभूतहिते रताः ॥ २५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "base_unit_id": "BG_C05_V25"
  },
  {
    "id": 16753026,
    "chapter_id": 6153,
    "verse_number": "5.26",
    "content_sanskrit": "कामक्रोधवियुक्तानां यतीनां यतचेतसाम् ।\nअभितो ब्रह्मनिर्वाणं वर्तते विदितात्मनाम् ॥ २६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "base_unit_id": "BG_C05_V26"
  },
  {
    "id": 16753027,
    "chapter_id": 6153,
    "verse_number": "5.27",
    "content_sanskrit": "स्पर्शान्कृत्वा बहिर्बाह्यांश्चक्षुश्चैवान्तरे भ्रुवोः ।\nप्राणापानौ समौ कृत्वा नासाभ्यन्तरचारिणौ ॥ २७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "base_unit_id": "BG_C05_V27"
  },
  {
    "id": 16753028,
    "chapter_id": 6153,
    "verse_number": "5.28",
    "content_sanskrit": "यतेन्द्रियमनोबुद्धिर्मुनिर्मोक्षपरायणः ।\nविगतेच्छाभयक्रोधो यः सदा मुक्त एव सः ॥ २८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "base_unit_id": "BG_C05_V28"
  },
  {
    "id": 16753029,
    "chapter_id": 6153,
    "verse_number": "5.29",
    "content_sanskrit": "भोक्तारं यज्ञतपसां सर्वलोकमहेश्वरम् ।\nसुहृदं सर्वभूतानां ज्ञात्वा मां शान्तिमृच्छति ॥ २९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "base_unit_id": "BG_C05_V29"
  }
]