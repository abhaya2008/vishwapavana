[{"id": 7001319000, "chapter_id": 21319, "verse_number": "४-९-१", "content_sanskrit": "ऋषय ऊचुः ।\nसूतसूत महाभाग धन्यस्त्वं शैवसत्तमः ।\nचाण्डाली का समाख्याता तत्कथां कथय प्रभो॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001319001, "chapter_id": 21319, "verse_number": "४-९-२", "content_sanskrit": "सूत उवाच ।\nद्विजाः शृणुत सद्भक्त्या तां कथां परमाद्भुताम् ।\nशिवप्रभावसंमिश्रां शृण्वतां भक्तिवर्द्धिनीम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001319002, "chapter_id": 21319, "verse_number": "४-९-३", "content_sanskrit": "चांडाली सा पूर्वभरेऽभवद्ब्राह्मणकन्यका ।\nसौमिनी नाम चन्द्रास्या सर्वलक्षणसंयुता॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001319003, "chapter_id": 21319, "verse_number": "४-९-४", "content_sanskrit": "अथ सा समये कन्या युवतिः सौमिनी द्विजाः ।\nपित्रा दत्ता च कस्मैचिद्विधिना द्विजसूनवे॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001319004, "chapter_id": 21319, "verse_number": "४-९-५", "content_sanskrit": "सा भर्तारमनुप्राप्य किंचित्कालं शुभव्रता ।\nरेमे तेन द्विजश्रेष्ठा नवयौवनशालिनी॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001319005, "chapter_id": 21319, "verse_number": "४-९-६", "content_sanskrit": "अथ तस्याः पतिर्विप्रस्तरुणस्सुरुजार्दितः ।\nसौमिन्याः कालयोगात्तु पञ्चत्वमगमद्द्विजाः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001319006, "chapter_id": 21319, "verse_number": "४-९-७", "content_sanskrit": "मृते भर्तरि सा नारी दुखितातिविषण्णधीः ।\nकिंचित्कालं शुभाचारा सुशीलोवास सद्मनि॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001319007, "chapter_id": 21319, "verse_number": "४-९-८", "content_sanskrit": "ततस्सा मन्मथाविष्टहृदया विधवापि च ।\nयुवावस्थाविशेषेण बभूव व्यभिचारिणी॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001319008, "chapter_id": 21319, "verse_number": "४-९-९", "content_sanskrit": "तज्ज्ञात्वा गोत्रिणस्तस्या दुष्कर्म कुलदूषणम् ।\nसमेतास्तत्यजु दूरं नीत्वा तां सकचग्रहाम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001319009, "chapter_id": 21319, "verse_number": "४-९-१०", "content_sanskrit": "कश्चिच्छूद्रवरस्तां वै विचरन्तीं निजेच्छया ।\nदृष्ट्वा वने स्त्रियं चक्रे निनाय स्वगृहं तत॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001319010, "chapter_id": 21319, "verse_number": "४-९-११", "content_sanskrit": "अथ सा पिशिताहारा नित्यमापीतवारुणी ।\nअजीजनत्सुतान्तेन शूद्रेण सुरतप्रिया॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001319011, "chapter_id": 21319, "verse_number": "४-९-१२", "content_sanskrit": "कदाचिद्भर्तरि क्वापि याते पीतसुराथ सा ।\nइयेष पिशिताहारं सौमिनी व्यभिचारिणी॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001319012, "chapter_id": 21319, "verse_number": "४-९-१३", "content_sanskrit": "ततो मेषेषु बद्धेषु गोभिस्सह बहिर्व्रजे ।\nनिशामुखे तमोऽन्धे हि खड्गमादाय सा ययौ॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001319013, "chapter_id": 21319, "verse_number": "४-९-१४", "content_sanskrit": "अविमृश्य मदावेशान्मेषबुद्याऽऽमिष प्रिया ।\nएकं जघान गोवत्सं क्रोशंतमतिदुर्भगा॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001319014, "chapter_id": 21319, "verse_number": "४-९-१५", "content_sanskrit": "हतं तं गृहमानीय ज्ञात्वा गोवत्समंगना ।\nभीता शिवशिवेत्याह केनचित्पुण्यकर्मणा॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001319015, "chapter_id": 21319, "verse_number": "४-९-१६", "content_sanskrit": "सा मुहूर्तं शिवं ध्यात्वामिषभोजनलालसा ।\nछित्त्वा तमेव गोवत्सं चकाराहारमीप्सितम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001319016, "chapter_id": 21319, "verse_number": "४-९-१७", "content_sanskrit": "एवं बहुतिथे काले गते सा सौमिनी द्विजाः ।\nकालस्य वशमापन्ना जगाम यमसंक्षयम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001319017, "chapter_id": 21319, "verse_number": "४-९-१८", "content_sanskrit": "यमोऽपि धर्ममालोक्य तस्याः कर्म च पौर्विकम् ।\nनिवर्त्य निरयावासाच्चक्रे चाण्डालजातिकाम्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001319018, "chapter_id": 21319, "verse_number": "४-९-१९", "content_sanskrit": "साथ भ्रष्टा यमपुराच्चाण्डालीगर्भमाश्रिता ।\nततो बभूव जन्मान्धा प्रशांतांगारमेचका॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001319019, "chapter_id": 21319, "verse_number": "४-९-२०", "content_sanskrit": "जन्मान्धा साथ बाल्येऽपि विध्वस्तपितृमातृका ।\nऊढा न केनचिद्दुष्टा महाकुष्ठरुजार्दिता॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001319020, "chapter_id": 21319, "verse_number": "४-९-२१", "content_sanskrit": "ततः क्षुधार्दिता दीना यष्टिपाणिर्गतेक्षणा ।\nचाण्डालोच्छिष्टपिंडेन जठराग्निमतपर्यत्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001319021, "chapter_id": 21319, "verse_number": "४-९-२२", "content_sanskrit": "एवं कृच्छ्रेण महता नीत्वा स्वविपुलं वयः ।\nजरयाग्रस्तसवार्ङ्गी दुःखमाप दुरत्ययम्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001319022, "chapter_id": 21319, "verse_number": "४-९-२३", "content_sanskrit": "कदाचित्साथ चांडाली गोकर्णं तं महाजनान् ।\nआयास्यंत्यां शिवतिथौ गच्छतो बुबुधेऽन्वगान्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001319023, "chapter_id": 21319, "verse_number": "४-९-२४", "content_sanskrit": "अथासावपि चांडाली वसनासनतृष्णया ।\nमहाजनान् याचयितुं संचचार शनैः शनैः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001319024, "chapter_id": 21319, "verse_number": "४-९-२५", "content_sanskrit": "गत्वा तत्राथ चांडाली प्रार्थयन्ती महाजनान् ।\nयत्र तत्र चचारासौ दीनवाक्प्रसृताञ्जलिः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001319025, "chapter_id": 21319, "verse_number": "४-९-२६", "content_sanskrit": "एवमभ्यर्थयंत्यास्तु चांडाल्याः प्रसृताञ्जलौ ।\nएकः पुण्यतमः पान्थः प्राक्षिपद्बिल्वमंजरीम्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001319026, "chapter_id": 21319, "verse_number": "४-९-२७", "content_sanskrit": "तामंजलौ निपतिता सा विमृश्य पुनः पुनः ।\nअभक्ष्यमिति मत्वाथ दूरे प्राक्षिपदातुरा॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001319027, "chapter_id": 21319, "verse_number": "४-९-२८", "content_sanskrit": "तस्याः कराद्विनिर्मुक्ता रात्रौ सा बिल्वमंजरी ।\nपपात कस्यचिद्दिष्ट्या शिवलिंगस्य मस्तके॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001319028, "chapter_id": 21319, "verse_number": "४-९-२९", "content_sanskrit": "सैवं शिवचतुर्दश्यां रात्रौ पान्थजनान्मुहुः ।\nयाचमानापि यत्किंचिन्न लेभे दैवयोगतः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001319029, "chapter_id": 21319, "verse_number": "४-९-३०", "content_sanskrit": "एवं शिवचतुर्दश्या व्रतं जातं च निर्मलम् ।\nअज्ञानतो जागरणं परमानन्ददायकम्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001319030, "chapter_id": 21319, "verse_number": "४-९-३१", "content_sanskrit": "ततः प्रभाते सा नारी शोकेन महता वृता ।\nशनैर्निववृते दीना स्वदेशायैव केवलम्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001319031, "chapter_id": 21319, "verse_number": "४-९-३२", "content_sanskrit": "श्रांता चिरोपवासेन निपतंती पदेपदे ।\nअतीत्य तावतीं भूमिं निपपात विचेतना॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001319032, "chapter_id": 21319, "verse_number": "४-९-३३", "content_sanskrit": "अथ सा शंभुकृपया जगाम परमं पदम् ।\nआरुह्य सुविमानं च नीतं शिवगणैर्द्रुतम्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001319033, "chapter_id": 21319, "verse_number": "४-९-३४", "content_sanskrit": "आदौ यदेषा शिवनाम नारी प्रमादतो वाप्यसती जगाद ।\nतेनेह भूयः सुकृतेन विप्रा महाबलस्थानमवाप दिव्यम्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001319034, "chapter_id": 21319, "verse_number": "४-९-३५", "content_sanskrit": "श्रीगोकर्णे शिवतिथावुपोष्य शिवमस्तके ।\nकृत्वा जागरणं सा हि चक्रे बिल्वार्चनं निशि॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001319035, "chapter_id": 21319, "verse_number": "४-९-३६", "content_sanskrit": "अकामतः कृतस्यास्य पुण्यस्यैव च तत्फलम् ।\nभुनक्त्यद्यापि सा चैव महाबलप्रसादतः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001319036, "chapter_id": 21319, "verse_number": "४-९-३७", "content_sanskrit": "एवंविधं महालिंगं शंकरस्य महाबलम् ।\nसर्वपापहरं सद्यः परमानन्ददायकम्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001319037, "chapter_id": 21319, "verse_number": "४-९-३८", "content_sanskrit": "एवं वः कथितं विप्रा माहात्म्यं परमं मया ।\nमहाबलाभिधानस्य शिवलिंगवरस्य हि॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001319038, "chapter_id": 21319, "verse_number": "४-९-३९", "content_sanskrit": "अथान्यदपि वक्ष्यामि माहात्म्यं तस्य चाद्भुतम् ।\nश्रुतमात्रेण येनाशु शिवे भक्तिः प्रजायते॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]