[{"id": 7003498000, "chapter_id": 23498, "verse_number": "१३८-१", "content_sanskrit": "अथ खंजरीटोपाख्यानम् ।\nसूत उवाच ।\nएतत्पुण्यतमं श्रुत्वा रम्ये सौकरवे तदा ।\nगुणस्तवं च माहात्म्यं जात्यानां परिवर्तनम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003498001, "chapter_id": 23498, "verse_number": "१३८-२", "content_sanskrit": "ततः कमलपत्राक्षी सर्वधर्मविदां वरा ।\nविस्मयं परमं गत्वा निर्वृतेनान्तरात्मना ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003498002, "chapter_id": 23498, "verse_number": "१३८-३", "content_sanskrit": "पुनः पप्रच्छ तं देवं विस्मयाविष्टमानसा ।\nअहो तीर्थस्य माहात्म्यं क्षेत्रे सौकरवे तव ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003498003, "chapter_id": 23498, "verse_number": "१३८-४", "content_sanskrit": "अकामान्म्रियमाणस्य मानुषत्वमजायत ।\nकिं वान्यद्वृत्तमाख्याहि क्षेत्रे सौकरवेऽमले ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003498004, "chapter_id": 23498, "verse_number": "१३८-५", "content_sanskrit": "शृण्वन्त्या मे महज्जातं चित्ते कौतूहलं परम् ।\nगायमानस्य किं पुण्यं वाद्यमानस्य किं फलम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003498005, "chapter_id": 23498, "verse_number": "१३८-६", "content_sanskrit": "नृत्यतः कि भवेत्पुण्यं जाग्रतो वा फलं नु किम् ।\nगोदातुरन्नदातुर्वा जलदातुस्तु किं फलम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003498006, "chapter_id": 23498, "verse_number": "१३८-७", "content_sanskrit": "संमार्जने लेपने वा गन्धपुष्पादिदानतः ।\nधूपदीपादिनैवेद्यैः किं फलं समुदीरितम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003498007, "chapter_id": 23498, "verse_number": "१३८-८", "content_sanskrit": "अन्येन कर्मणा चैव जपयज्ञादिनाऽथवा ।\nकां गतिं प्रतिपद्यन्ते ये शुद्धमनसो जनाः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003498008, "chapter_id": 23498, "verse_number": "१३८-९", "content_sanskrit": "तव भक्तसुखार्याय तद्भवान्वक्तुमर्हति ।\nततो मह्या वचः श्रुत्वा सर्वदेवमयो हरिः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003498009, "chapter_id": 23498, "verse_number": "१३८-१०", "content_sanskrit": "उवाच मधुरं वाक्यं धर्मकामां वसुन्धराम् ।\nश्रीवराह उवाच ।\nशृणु सुन्दरि तत्त्वेन यन्मां त्वं परिपृच्छसि ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003498010, "chapter_id": 23498, "verse_number": "१३८-११", "content_sanskrit": "सर्वं ते कथयिष्यामि पुण्यकर्म सुखावहम् ।\nतस्मिन्सौकरवे पक्षी खञ्जरीटस्तु कीटकान् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003498011, "chapter_id": 23498, "verse_number": "१३८-१२", "content_sanskrit": "बहून् भुक्त्वा हि वसुधे अजीर्णभृशपीडितः ।\nमरणं समनुप्राप्तः पतितः स्वेन कर्मणा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003498012, "chapter_id": 23498, "verse_number": "१३८-१३", "content_sanskrit": "सम्प्राप्तास्तत्र वै बालाः क्रीडन्तस्तं मृतं खगम् ।\nग्रहीष्याम इति प्रोच्य धावन्तस्तत्र तत्र ह ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003498013, "chapter_id": 23498, "verse_number": "१३८-१४", "content_sanskrit": "ममायं वै ममायं वै जिघृक्षन्तः परस्परम ।\nसङ्घर्षात्कलहं चक्रुर्भृशं क्रीडनकोत्सुकाः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003498014, "chapter_id": 23498, "verse_number": "१३८-१५", "content_sanskrit": "तत एको गृहीत्वैनं गङ्गाम्भसि समाक्षिपत् ।\nयुष्माकमेव भवतु नानेनास्मत्प्रयोजनम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003498015, "chapter_id": 23498, "verse_number": "१३८-१६", "content_sanskrit": "एवं स खञ्जरीटो हि गङ्गातोयात्ततस्तदा ।\nआदित्यतीर्थसंक्लिन्नशरीरः स वसुन्धरे ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003498016, "chapter_id": 23498, "verse_number": "१३८-१७", "content_sanskrit": "वैश्यस्य तु गृहे जातो ह्यनेकक्रतुयाजिनः ।\nधनरत्नसमृद्धे तु रूपवान् गुणवान् शुचिः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003498017, "chapter_id": 23498, "verse_number": "१३८-१८", "content_sanskrit": "विबुद्धश्च पवित्रश्च मद्भक्तश्च वसुन्धरे ।\nजातस्य तस्य वर्षाणि जग्मुर्द्वादश सुव्रते ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003498018, "chapter_id": 23498, "verse_number": "१३८-१९", "content_sanskrit": "कदाचिदुपविष्टौ तौ दृष्ट्वा बालो गुणान्वितः ।\nमातरंपितरं चोभौ हर्षेण महतान्वितौ ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003498019, "chapter_id": 23498, "verse_number": "१३८-२०", "content_sanskrit": "प्रणम्य शिरसा भूमौ बद्धाञ्जलिरयाचत ।\nमत्प्रियं यदि कर्त्तव्यमेको मे दीयतां वरः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003498020, "chapter_id": 23498, "verse_number": "१३८-२१", "content_sanskrit": "न चाहं वारणीयो वै पित्रा मात्रा कथंचन ।\nसत्यं शपामि गुरुणा यथा ननु कृतं भवेत् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003498021, "chapter_id": 23498, "verse_number": "१३८-२२", "content_sanskrit": "पुत्रस्य वचनं श्रुत्वा दम्पती तौ मुदान्वितौ ।\nऊचतुस्तं प्रियं वाक्यं बालं कमललोचनम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003498022, "chapter_id": 23498, "verse_number": "१३८-२३", "content_sanskrit": "यद्यत्त्वं वक्ष्यसे वत्स यद्यत्ते हृदि वर्त्तते ।\nसर्वं तत्तत्करिष्यावो विस्रब्धं वद साम्प्रतम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003498023, "chapter_id": 23498, "verse_number": "१३८-२४", "content_sanskrit": "त्रिंशत्सहस्रं गावो हि सर्वाश्च शुभदोहनाः ।\nयद्यत्र रोचते पुत्र देहि त्वमविचारितम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003498024, "chapter_id": 23498, "verse_number": "१३८-२५", "content_sanskrit": "पुनरन्यत्प्रवक्ष्यामि आवयोः पुत्र कारणात् ।\nवाणिज्यं नः स्मृतं कर्म तत्ते पुत्रे यदीप्सितम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003498025, "chapter_id": 23498, "verse_number": "१३८-२६", "content_sanskrit": "तत्कुरुष्व यथान्यायं मित्रेभ्यो दीयतां धनम् ।\nधनधान्यानि रत्नानि देहि पुत्र अवारितः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003498026, "chapter_id": 23498, "verse_number": "१३८-२७", "content_sanskrit": "कन्या वै रमणीयाश्च सजातीयाः कुलोद्भवाः ।\nआनयिष्याव भद्रं ते उद्वाहेन क्रमेण ते ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003498027, "chapter_id": 23498, "verse_number": "१३८-२८", "content_sanskrit": "यदीच्छसि पुनश्चान्यद्यज्ञैर्यष्टुं सुपुत्रक ।\nविधिना पूवर्दृष्टेन वैश्या येन यजन्ति च ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003498028, "chapter_id": 23498, "verse_number": "१३८-२९", "content_sanskrit": "अष्टौ सम्पूर्णधुर्याणां हलानां तावतां शतम् ।\nवैश्यकर्म समादाय किं पुनः प्राप्तुमिच्छसि ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003498029, "chapter_id": 23498, "verse_number": "१३८-३०", "content_sanskrit": "यावद्भोजनतृप्तान्वा द्विजानिच्छसि तर्पितुम् ।\nसर्वं निजेच्छया पुत्र कर्त्तुमर्हसि साम्प्रतम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003498030, "chapter_id": 23498, "verse_number": "१३८-३१", "content_sanskrit": "पितृमातृ वचः श्रुत्वा स बालो धर्मसंयुतः ।\nचरणावुपसंगृह्य पितरौ पुनरब्रवीत् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003498031, "chapter_id": 23498, "verse_number": "१३८-३२", "content_sanskrit": "गोप्रदाने न मे कार्यं मित्रं वापि न चिन्तितम् ।\nकन्यालाभे न चेच्छास्ति न च यज्ञफले तथा ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003498032, "chapter_id": 23498, "verse_number": "१३८-३३", "content_sanskrit": "नाहं वाणिज्यमिच्छामि कृषिगोरक्षमेव च ।\nन च सर्वातिथित्वं वा मम चित्ते प्रसज्जति ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003498033, "chapter_id": 23498, "verse_number": "१३८-३४", "content_sanskrit": "एकं मे परमं चिन्त्यं यन्ममेच्छा तपोधृतौ ।\nचिन्ता नारायणक्षेत्रं गाढं सौकरवं प्रति ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003498034, "chapter_id": 23498, "verse_number": "१३८-३५", "content_sanskrit": "ततः पुत्रवचः श्रुत्वा मम कर्मपरायणौ ।\nकरुणं परिदेवन्तौ रुदन्तौ तावुभौ तथा ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003498035, "chapter_id": 23498, "verse_number": "१३८-३६", "content_sanskrit": "अथ द्वादश वर्षाणि तव जातस्य पुत्रक ।\nकिमिदं चिन्तितं वत्स त्वया नारायणाश्रयम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003498036, "chapter_id": 23498, "verse_number": "१३८-३७", "content_sanskrit": "चिन्तयिष्यति भद्रं ते यदा तत्प्राप्नुया वयः ।\nअद्यापि भोजनं गृह्य धावमानास्मि पृष्ठतः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003498037, "chapter_id": 23498, "verse_number": "१३८-३८", "content_sanskrit": "किमिदं चिन्तितं वत्स गमने सौकरं प्रति ।\nअद्यापि मत्स्तनौ धन्यौ प्रस्रुतौ हि दिवानिशम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003498038, "chapter_id": 23498, "verse_number": "१३८-३९", "content_sanskrit": "पुत्र त्वत्स्पर्शनाशायाः किमेतच्चिन्तितं त्वया।\nरात्रौ सुप्तोऽसि वत्स त्वं शय्यासु परिवर्त्तितः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003498039, "chapter_id": 23498, "verse_number": "१३८-४०", "content_sanskrit": "अम्बेति भाषसेऽद्यापि कथमेतद्विचिन्तितम् ।\nस्पृशंति तव नार्योऽपि क्रीडमानस्य पुत्रक ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003498040, "chapter_id": 23498, "verse_number": "१३८-४१", "content_sanskrit": "अपराधो न विद्येत पुत्र क्षेत्रगृहेष्वपि ।\nन वा स्वजनभृत्याद्यैः परुषं ते प्रभाषितम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003498041, "chapter_id": 23498, "verse_number": "१३८-४२", "content_sanskrit": "रुष्टेन वापि भीषायै गृह्यते चैव यष्टिका ।\nपुत्रहर्तुं न पश्येहं तव निर्वेदकारणम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003498042, "chapter_id": 23498, "verse_number": "१३८-४३", "content_sanskrit": "इति मातुर्वचः श्रुत्वा स वैश्यकुलनन्दनः ।\nउवाच मधुरं वाक्यं जननीं संशितव्रतः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003498043, "chapter_id": 23498, "verse_number": "१३८-४४", "content_sanskrit": "उषितोऽस्मि तदंगेषु गर्भस्थः कुक्षिसंभवः ।\nक्रीडतोस्मि यथान्यायं तवोत्संगे यशस्विनि ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003498044, "chapter_id": 23498, "verse_number": "१३८-४५", "content_sanskrit": "स्तनौ ह्येतौ मया पीतौ ललितेन विजृम्भितौ ।\nअङ्गं तव समारुह्य पांसुभिर्गुण्ठिता तनुः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003498045, "chapter_id": 23498, "verse_number": "१३८-४६", "content_sanskrit": "अम्ब त्वं मयि कारुण्यं कुरुष्व खलु चोचितम् ।\nमुंच पुत्रकृतं शोकं त्यज मातरनिन्दिते ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003498046, "chapter_id": 23498, "verse_number": "१३८-४७", "content_sanskrit": "आयान्ति च पुनर्यान्ति गता गच्छन्ति चापरे।\nदृश्यते च पुनर्नष्टो न दृश्येत पुनः क्वचित् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003498047, "chapter_id": 23498, "verse_number": "१३८-४८", "content_sanskrit": "कुतो जातः क्व संबद्धः कस्य माता पिताथवा ।\nइमां योनिमनुप्राप्तो घोरे संसारसागरे ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003498048, "chapter_id": 23498, "verse_number": "१३८-४९", "content_sanskrit": "मातापितृसहस्राणि पुत्रदारशतानि च ।\nजन्मजन्मनि वर्त्तन्ते कस्य ते कस्य वा वयम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003498049, "chapter_id": 23498, "verse_number": "१३८-५०", "content_sanskrit": "एवं चिन्तां समासाद्य मा शुचो जननि क्वचित् ।\nएवं तौ पितरौ श्रुत्वा विस्मयात्पुनरूचतुः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003498050, "chapter_id": 23498, "verse_number": "१३८-५१", "content_sanskrit": "अहो बत महद्गुह्यं किमेतत्तात कथ्यताम् ।\nएतद्वचनमाकर्ण्य स वैश्यकुलबालकः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003498051, "chapter_id": 23498, "verse_number": "१३८-५२", "content_sanskrit": "उवाच मधुरं वाक्यं जननीं पितरं तथा ।\nयदि श्रुतेन वः कार्यं गुह्यस्य परिनिश्चयात् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003498052, "chapter_id": 23498, "verse_number": "१३८-५३", "content_sanskrit": "तत्पृच्छ्यतां भवद्भ्यां हि गुह्यं सौकरवं प्रति ।\nतत्राहं कथयिष्यामि स्वस्य गुह्यं महौजसम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003498053, "chapter_id": 23498, "verse_number": "१३८-५४", "content_sanskrit": "सूर्यतीर्थं समासाद्य यत्तात परिपृच्छसि ।\nबाढमित्येव पुत्रं तौ दम्पती प्रोचतुश्च तम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003498054, "chapter_id": 23498, "verse_number": "१३८-५५", "content_sanskrit": "गमने कृतसंकल्पौ ततः सौकरवं प्रति ।\nसर्वद्रव्यसमायुक्तौ गतौ सौकरवं प्रति ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003498055, "chapter_id": 23498, "verse_number": "१३८-५६", "content_sanskrit": "गतः स पद्मपत्राक्ष आभीराणां जनेश्वरः ।\nगावो विंशसहस्राणि प्रेषयत्यग्रतो द्रुतम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003498056, "chapter_id": 23498, "verse_number": "१३८-५७", "content_sanskrit": "अग्रे सर्वास्ताः प्रययुर्द्रव्येण च समायुताः ।\nयच्च किंचिद्गृहे वास्ति कृतं नारायणं प्रति ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003498057, "chapter_id": 23498, "verse_number": "१३८-५८", "content_sanskrit": "ततः पूर्वार्द्धयामेन माघमासे त्रयोदशी ।\nसर्वं स्वजनमामन्त्र्य सम्बद्धं च यथाविधि ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003498058, "chapter_id": 23498, "verse_number": "१३८-५९", "content_sanskrit": "मुहूर्त्तेन च तेनैव गमनं कुरुते ततः ।\nस्नात्वा च कृतशौचास्ते नारायणमुदावहाः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003498059, "chapter_id": 23498, "verse_number": "१३८-६०", "content_sanskrit": "अथ दीर्घेण कालेन नारायणमुदावहाः ।\nवैशाखस्य तु द्वादश्यां मम क्षेत्रमुपागताः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003498060, "chapter_id": 23498, "verse_number": "१३८-६१", "content_sanskrit": "स्नाताः सन्तर्प्य च पितॄन्मम वस्त्रविभूषिताः ।\nगावो विंशतिसाहस्रा याः पूर्वमुपकल्पिताः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003498061, "chapter_id": 23498, "verse_number": "१३८-६२", "content_sanskrit": "तत्र भङ्गुरसो नाम मम कर्मपरायणः ।\nतेनैव ता गृहीता वै विधिदृष्टेन कर्मणा ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003498062, "chapter_id": 23498, "verse_number": "१३८-६३", "content_sanskrit": "ततः स प्रददौ तस्य विंशा गावो महाधनाः ।\nमङ्गल्याश्च पवित्राश्च सर्वाश्च वरदोहनाः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003498063, "chapter_id": 23498, "verse_number": "१३८-६४", "content_sanskrit": "प्रददौ धनरत्नानि नित्यमेव दिने दिने ।\nमोदते सह पुत्रेण भार्यया स्वजनेन च ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003498064, "chapter_id": 23498, "verse_number": "१३८-६५", "content_sanskrit": "एवं तु वसतस्तस्य वर्षाकाल उपागतः ।\nप्रावृडुपस्थिता तत्र सर्वसस्यप्रवर्द्धिनी ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003498065, "chapter_id": 23498, "verse_number": "१३८-६६", "content_sanskrit": "पुष्पितानि कदम्बानि कुटजार्ज्जुनकानि च ।\nएवं दुःखमनुप्राप्ता स्त्रियो या रहिताः प्रियैः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003498066, "chapter_id": 23498, "verse_number": "१३८-६७", "content_sanskrit": "गर्ज्जतां गुञ्जतां चैव धारापातनिपातिताः ।\nमेघाः सविद्युतश्चैव बलाकाङ्गदभूषिताः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003498067, "chapter_id": 23498, "verse_number": "१३८-६८", "content_sanskrit": "नदीनां चैव निर्घोषो मयूराणां च निःस्वनः ।\nकुटजार्ज्जुनगन्धाश्च कदम्बार्ज्जुनपादपाः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003498068, "chapter_id": 23498, "verse_number": "१३८-६९", "content_sanskrit": "वाताः प्रवान्ति ते तत्र शिखीनां च सुखावहाः ।\nशोकेन कामिनीनां च भर्त्रा च रहिताश्च याः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003498069, "chapter_id": 23498, "verse_number": "१३८-७०", "content_sanskrit": "गच्छत्येवं स कालो हि मेघदुन्दुभिनादितः ।\nततः शरदनुप्राप्ता अगस्तिरुदितो महान् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003498070, "chapter_id": 23498, "verse_number": "१३८-७१", "content_sanskrit": "तडागानि प्रसन्नानि कुमुदोत्पलवन्ति च ।\nपद्मषण्डैः सुरम्याणि पुष्पितानि समन्ततः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003498071, "chapter_id": 23498, "verse_number": "१३८-७२", "content_sanskrit": "प्रवान्ति सुसुखा वाताः सुगन्धाश्च सुशीतलाः ।\nसप्तपर्णसुगन्धाश्च शीतलाः कामिवल्लभाः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003498072, "chapter_id": 23498, "verse_number": "१३८-७३", "content_sanskrit": "एवं शरदि निर्वृत्ते कौमुदे समुपागते ।\nसा तस्मिन्मासि सुश्रोणि शुक्लपक्षान्तरे तदा ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003498073, "chapter_id": 23498, "verse_number": "१३८-७४", "content_sanskrit": "एकादश्यां ततः सुभ्रु स्नातौ क्षौमविभूषितौ ।\nउभौ तौ दम्पती तत्र पुत्रमूचतुरात्मनः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003498074, "chapter_id": 23498, "verse_number": "१३८-७५", "content_sanskrit": "उषितास्त्वत्र षण्मासान्सुखं च द्वादशी भवेत् ।\nकिन्नो न वक्ष्यसे गुह्यं येन वै वारिता वयम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003498075, "chapter_id": 23498, "verse_number": "१३८-७६", "content_sanskrit": "पित्रोस्तु वचनं श्रुत्वा स पुत्रो धर्मनिष्ठितः ।\nउवाच मधुरं वाक्यं तयोस्तु कृतनिश्चयः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003498076, "chapter_id": 23498, "verse_number": "१३८-७७", "content_sanskrit": "एवमेतन्महाभाग यत्त्वया परिभाषितम् ।\nकल्यं ते कथयिष्यामि इदं गुह्यं महौजसम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003498077, "chapter_id": 23498, "verse_number": "१३८-७८", "content_sanskrit": "एषा वै द्वादशी तात प्रभुनारायणप्रिया ।\nमंगला च विचित्रा च विष्णुभक्तसुखावहा ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003498078, "chapter_id": 23498, "verse_number": "१३८-७९", "content_sanskrit": "ददतेऽस्यां प्रहृष्टाश्च द्वादश्यां कौमुदे सिते ।\nदीक्षितास्ते योगिकुले विष्णुभक्तिपरायणाः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003498079, "chapter_id": 23498, "verse_number": "१३८-८०", "content_sanskrit": "तेन दानप्रभावेण विष्णुतोषकरेण च ।\nतरन्ति दुस्तरं तात घोरं संसारसागरम् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003498080, "chapter_id": 23498, "verse_number": "१३८-८१", "content_sanskrit": "एवं कथयतां तेषां प्रभाता रजनी शुभा ।\nततः सन्ध्यामुपास्याथ उदिते सूर्यमण्डले ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003498081, "chapter_id": 23498, "verse_number": "१३८-८२", "content_sanskrit": "शुचिर्भूत्वा यथान्यायं क्षौमवस्त्रविभूषितः ।\nप्रणम्य शिरसा देवं शंखचक्रगदाधरम् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003498082, "chapter_id": 23498, "verse_number": "१३८-८३", "content_sanskrit": "उभौ तच्चरणौ गृह्य पितरौ समभाषत ।\nशृणु तात महाभाग यदर्थं समुपागतः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003498083, "chapter_id": 23498, "verse_number": "१३८-८४", "content_sanskrit": "यद्भवान्पृच्छते तात गुह्यं सौकरवं प्रति ।\nखञ्जरीटो ह्यहं तात पक्षियोनिसमुद्भवः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003498084, "chapter_id": 23498, "verse_number": "१३८-८५", "content_sanskrit": "भक्षिताश्च पतंगा मे अजीर्णेनातिपीडितः ।\nअहं तेनैव दोषेण न शक्नोमि विचेष्टितुम् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003498085, "chapter_id": 23498, "verse_number": "१३८-८६", "content_sanskrit": "दृष्ट्वा मां विह्वलं बाला गृहीत्वा क्रीडितुं गताः ।\nहस्ताद्धस्तेन क्रीडन्तश्चान्योन्यपरिहासया ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003498086, "chapter_id": 23498, "verse_number": "१३८-८७", "content_sanskrit": "त्वया दृष्टो मया दृष्टो ह्यं चेति कलिः कृतः ।\nतत एकेन बालेन भ्रामयित्वाऽक्षयेम्भसि ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003498087, "chapter_id": 23498, "verse_number": "१३८-८८", "content_sanskrit": "न ममेति तवेत्युक्त्वा ह्यादित्यं तीर्थमुत्तमम् ।\nक्रोधेनादाय तीव्रेण क्षिप्तो गङ्गाम्भसि त्वरा॥ ८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003498088, "chapter_id": 23498, "verse_number": "१३८-८९", "content_sanskrit": "तत्र मुक्ता मया प्राणाः सूर्यतीर्थे महौजसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003498089, "chapter_id": 23498, "verse_number": "१३८-९०", "content_sanskrit": "अकामेन विशालाक्षि तत्प्रभावादहं ततः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003498090, "chapter_id": 23498, "verse_number": "१३८-९१", "content_sanskrit": "जातस्तव सुतो मातस्तदेतद्दिनमुत्तमम् ।\nअकामान्म्रियमाणस्य वर्षाण्यद्य त्रयोदश ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003498091, "chapter_id": 23498, "verse_number": "१३८-९२", "content_sanskrit": "व्यतीतानि च गुह्यं ते कथनं मम चैव यत् ।\nएतत्ते कथितं तात गुह्यमागमनं प्रति ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003498092, "chapter_id": 23498, "verse_number": "१३८-९३", "content_sanskrit": "अहं कर्म करिष्यामि गच्छ तात नमोऽस्तु ते ।\nततो माता पिता चैव पुत्रं पुनरुवाच ह ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003498093, "chapter_id": 23498, "verse_number": "१३८-९४", "content_sanskrit": "विष्णुप्रोक्तानि कर्माणि यं यं कारयिता भवान् ।\nतान्वयं  च करिष्यामो विधिदृष्टेन कर्मणा ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003498094, "chapter_id": 23498, "verse_number": "१३८-९५", "content_sanskrit": "वटमाला यथान्यायं कर्मसंसारमोक्षणम् ।\nतेऽपि दीर्घेण कालेन मम कर्मपरायणाः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003498095, "chapter_id": 23498, "verse_number": "१३८-९६", "content_sanskrit": "कृत्वा तु विपुलं कर्म ततः पंचत्वमागताः ।\nमम क्षेत्रप्रभावेण चात्मनः कर्मनिश्चयात् ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003498096, "chapter_id": 23498, "verse_number": "१३८-९७", "content_sanskrit": "विमुक्ताः सर्वसंसाराच्छ्वेतद्वीपमुपागताः ।\nयोऽसौ परिजनः कश्चिद्गृहेभ्यश्च समागतः ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7003498097, "chapter_id": 23498, "verse_number": "१३८-९८", "content_sanskrit": "सर्वः श्रिया युतस्तत्र रोगव्याधिविवर्जितः ।\nसर्वे च योगिनस्तत्र सर्वे चोत्पलगंधयः॥॥ ९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7003498098, "chapter_id": 23498, "verse_number": "१३८-९९", "content_sanskrit": "मोदन्ते तु यथान्यायं प्रसादात्क्षेत्रजान्मम ।\nएतत्ते कथितं देवि महाख्यानं महौजसम् ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7003498099, "chapter_id": 23498, "verse_number": "१३८-१००", "content_sanskrit": "पुनरन्यत्प्रवक्ष्यामि यद्वृत्तं सौकरे मम ।\nएषा व्युष्टिर्महाभागे क्षेत्रे यत्क्रियते महत् ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7003498100, "chapter_id": 23498, "verse_number": "१३८-१०१", "content_sanskrit": "तिर्यग्योनिविनिर्मुक्ताः श्वेतद्वीपमुपागताः ।\nय एतत्पठते नित्यं कल्यमुत्थाय मानवः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7003498101, "chapter_id": 23498, "verse_number": "१३८-१०२", "content_sanskrit": "स कुलं तारयेत्तूर्णं दश पूर्वान्दशावरान् ।\nन पठेन्मूर्खमध्ये तु पापिष्ठे शास्त्रदूषके ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7003498102, "chapter_id": 23498, "verse_number": "१३८-१०३", "content_sanskrit": "न पठेत्पिशुनानां च एकाकी तु पठेद्गृहे ।\nपठेद्ब्राह्मणमध्ये च ये च वेदविदां वराः ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7003498103, "chapter_id": 23498, "verse_number": "१३८-१०४", "content_sanskrit": "वैष्णवानां च पुरतो यै व शास्त्रगुणान्विताः।\nविशुद्धानां विनीतानां सर्वसंसारमोक्षणम् ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}]