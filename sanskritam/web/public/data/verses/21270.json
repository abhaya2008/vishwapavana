[{"id": 7001270000, "chapter_id": 21270, "verse_number": "३-२-१", "content_sanskrit": "॥ नन्दीश्वर उवाच  ।\nशृणु तात महेशस्यावतारान्परमान्प्रभो ।\nसर्वकार्यकरांल्लोके सर्वस्य सुखदान्मुने॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001270001, "chapter_id": 21270, "verse_number": "३-२-२", "content_sanskrit": "तस्य शंभोः परेशस्य मूर्त्यष्टकमयं जगत् ।\nतस्मिन्व्याप्य स्थितं विश्वं सूत्रे मणिगणा इव॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001270002, "chapter_id": 21270, "verse_number": "३-२-३", "content_sanskrit": "शर्वो भवस्तथा रुद्र उग्रो भीमः पशो पतिः ।\nईशानश्च महादेवो मूर्तयश्चाष्ट विश्रुताः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001270003, "chapter_id": 21270, "verse_number": "३-२-४", "content_sanskrit": "भूम्यंभोग्निमरुद्व्योमक्षेत्रज्ञार्कनिशाकराः ।\nअधिष्ठिताश्च शर्वाद्यैरष्टरूपैः शिवस्य हि॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001270004, "chapter_id": 21270, "verse_number": "३-२-५", "content_sanskrit": "धत्ते चराचरं विश्वं रूपं विश्वंभरात्मकम् ।\nशंकरस्य महेशस्य शास्त्रस्यैवेति निश्चयः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001270005, "chapter_id": 21270, "verse_number": "३-२-६", "content_sanskrit": "संजीवनं समस्तस्य जगतः सलिलात्मकम् ।\nभव इत्युच्यते रूपं भवस्य परमात्मनः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001270006, "chapter_id": 21270, "verse_number": "३-२-७", "content_sanskrit": "बहिरंतर्जगद्विश्वं बिभर्ति स्पन्दतेस्य यम् ।\nउग्र इत्युच्यते सद्भी रूपमुग्रस्य सत्प्रभो॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001270007, "chapter_id": 21270, "verse_number": "३-२-८", "content_sanskrit": "सर्वावकाशदं सर्वव्यापकं गगनात्मकम् ।\nरूपं भीमस्य भीमाख्यं भूपवृन्दस्व भेदकम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001270008, "chapter_id": 21270, "verse_number": "३-२-९", "content_sanskrit": "सर्वात्मनामधिष्ठानं सर्वक्षेत्रनिवासकम् ।\nरूपं पशुपतेर्ज्ञेयं पशुपाशनिकृन्तनम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001270009, "chapter_id": 21270, "verse_number": "३-२-१०", "content_sanskrit": "सन्दीपयञ्जगत्सर्वं दिवाकरसमाह्वयम् ।\nईशानाख्यं महेशस्य रूपं दिवि विसर्पति॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001270010, "chapter_id": 21270, "verse_number": "३-२-११", "content_sanskrit": "आप्याययति यो विश्वममृतांशुर्निशाकरः ।\nमहादेवस्य तद्रूपं महादेवस्य चाह्वयम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001270011, "chapter_id": 21270, "verse_number": "३-२-१२", "content_sanskrit": "आत्मा तस्याष्टमं रूपं शिवस्य परमात्मनः ।\nव्यापिकेतरमूर्तीनां विश्वं तस्माच्छिवात्मकम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001270012, "chapter_id": 21270, "verse_number": "३-२-१३", "content_sanskrit": "शाखाः पुष्यन्ति वृक्षस्य वृक्षमूलस्य सेचनात् ।\nतद्वदस्य वपुर्विश्वं पुष्यते च शिवार्चनात॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001270013, "chapter_id": 21270, "verse_number": "३-२-१४", "content_sanskrit": "यथेह पुत्रपौत्रादेः प्रीत्या प्रीतो भवेत्पिता ।\nतथा विश्वस्य सम्प्रीत्या प्रीतो भवति शंकरः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001270014, "chapter_id": 21270, "verse_number": "३-२-१५", "content_sanskrit": "क्रियते यस्य कस्यापि देहिनो यदि निग्रहः ।\nअष्टमूर्त्तेरनिष्टं तत्कृतमेव न संशयः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001270015, "chapter_id": 21270, "verse_number": "३-२-१६", "content_sanskrit": "अष्टमूर्त्यात्मना विश्वमधिष्ठायास्थितं शिवम् ।\nभजस्व सर्वभावेन रुद्रं परमकारणम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001270016, "chapter_id": 21270, "verse_number": "३-२-१७", "content_sanskrit": "इति प्रोक्ताः स्वरूपास्ते विधिपुत्राष्टविश्रुताः ।\nसर्वोपकारनिरताः सेव्याः श्रेयोर्थिभिर्नरैः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]