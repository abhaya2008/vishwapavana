[{"id": 6000199000, "chapter_id": 10199, "verse_number": null, "content_sanskrit": "अथ तृतीयाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000199001, "chapter_id": 10199, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_003/BhP_10.003.001.m4a", "display_order": 2}, {"id": 6000199002, "chapter_id": 10199, "verse_number": "१०-३-१", "content_sanskrit": "प्रलम्बबकचाणूरतृणावर्तमहाशनैः।\nमुष्टिकारिष्टद्विविदपूतनाकेशिधेनुकैः॥ १०/३/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_003/BhP_10.003.002.m4a", "display_order": 3, "topics": [{"text": "कंसकृतं षण्णां पुत्राणां हननम्", "range": "१–५"}]}, {"id": 6000199003, "chapter_id": 10199, "verse_number": "१०-३-२", "content_sanskrit": "अन्यैश्चासुरभूपालैर्बाणभौमादिभिर्युतः।\nयदूनां कदनं चक्रे बली मागधसंश्रयः॥ १०/३/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_003/BhP_10.003.003.m4a", "display_order": 4}, {"id": 6000199004, "chapter_id": 10199, "verse_number": "१०-३-३", "content_sanskrit": "ते पीडिता निविविशुः कुरुपाञ्चालकेकयान्।\nसाल्वान् विदर्भान् निषधान् विदेहान् मागधानपि॥ १०/३/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_003/BhP_10.003.004.m4a", "display_order": 5}, {"id": 6000199005, "chapter_id": 10199, "verse_number": "१०-३-४", "content_sanskrit": "एके तमनुरुन्धाना ज्ञातयः पर्युपासते। मधुरायां स्थिताश्चैव येऽक्रूराद्या विशाम्पते।\nहतेषु षट्सु बालेषु देवक्या औग्रसेनिना॥ १०/३/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_003/BhP_10.003.005.m4a", "display_order": 6}, {"id": 6000199006, "chapter_id": 10199, "verse_number": "१०-३-५", "content_sanskrit": "सप्तमो वैष्णवं धाम यमनन्तं प्रचक्षते।\nगर्भो बभूव देवक्या हर्षशोकविवर्धनः॥ १०/३/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_003/BhP_10.003.006.m4a", "display_order": 7}, {"id": 6000199007, "chapter_id": 10199, "verse_number": "१०-३-६", "content_sanskrit": "भगवानपि विश्वात्मा विदित्वा कंसजं भयम्।\nयदूनां निजनाथानां योगमायां समादिशत्॥ १०/३/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_003/BhP_10.003.007.m4a", "display_order": 8, "topics": [{"text": "देवक्याः गर्भस्य दुर्गया रोहिण्या जठरे स्थापनम्", "range": "६–१५"}]}, {"id": 6000199008, "chapter_id": 10199, "verse_number": "१०-३-७", "content_sanskrit": "गच्छ देवि व्रजं भद्रे गोपगोभिरलङ्कृतम्।\nरोहिणी वसुदेवस्य भार्याऽऽस्ते नन्दगोकुले॥ १०/३/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_003/BhP_10.003.008.m4a", "display_order": 9}, {"id": 6000199009, "chapter_id": 10199, "verse_number": "१०-३-८", "content_sanskrit": "अन्याश्च कंससंविग्ना विवरेषु वसन्ति हि।\nदेवक्या जठरे गर्भं शेषाख्यं धाम मामकम्॥ १०/३/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_003/BhP_10.003.009.m4a", "display_order": 10}, {"id": 6000199010, "chapter_id": 10199, "verse_number": "१०-३-९", "content_sanskrit": "तत् सन्निकृष्य रोहिण्या उदरे सन्निवेशय।\nअथाहं स्वांशभागेन देवक्याः पुत्रतां शुभे॥ १०/३/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_003/BhP_10.003.010.m4a", "display_order": 11}, {"id": 6000199011, "chapter_id": 10199, "verse_number": "१०-३-१०", "content_sanskrit": "प्राप्स्यामि त्वं यशोदायां नन्दपत्न्यां भविष्यसि।\nअर्चिष्यन्ति मनुष्यास्त्वां सर्वकामवरेश्वरीम्॥ १०/३/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_003/BhP_10.003.011.m4a", "display_order": 12}, {"id": 6000199012, "chapter_id": 10199, "verse_number": "१०-३-११", "content_sanskrit": "नानोपहारबलिभिः सर्वकामवरप्रदाम्।\nनामधेयानि कुर्वन्ति स्थानानि च नरा भुवि॥ १०/३/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_003/BhP_10.003.012.m4a", "display_order": 13}, {"id": 6000199013, "chapter_id": 10199, "verse_number": "१०-३-१२", "content_sanskrit": "दुर्गेति भद्रकालीति विजया वैष्णवीति च।\nकुमुदा चण्डिका कृष्णा माधवी कन्यकेति च॥ १०/३/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_003/BhP_10.003.013.m4a", "display_order": 14}, {"id": 6000199014, "chapter_id": 10199, "verse_number": "१०-३-१३", "content_sanskrit": "माया नारायणीशाना शारदेत्यम्बिकेति च॥ १०/३/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_003/BhP_10.003.014.m4a", "display_order": 15}, {"id": 6000199015, "chapter_id": 10199, "verse_number": "१०-३-१४", "content_sanskrit": "गर्भसङ्कर्षणात् तं वै प्राहुः सङ्कर्षणं भुवि।\nरामेति लोकरमणाद् बलभद्रं बलोच्छ्रयात्॥ १०/३/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_003/BhP_10.003.015.m4a", "display_order": 16}, {"id": 6000199016, "chapter_id": 10199, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_003/BhP_10.003.016.m4a", "display_order": 17}, {"id": 6000199017, "chapter_id": 10199, "verse_number": "१०-३-१५", "content_sanskrit": "सन्दिष्टैवं भगवता तथेत्योमिति तद्वचः।\nप्रतिगृह्य परिक्रम्य गां गता तत् तथाऽकरोत्॥ १०/३/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_003/BhP_10.003.017.m4a", "display_order": 18}, {"id": 6000199018, "chapter_id": 10199, "verse_number": "१०-३-१६", "content_sanskrit": "गर्भे प्रणीते देवक्या रोहिणीं योगनिद्रया।\nअहो विस्रंसितो गर्भ इति पौरा विचुक्रुशुः॥ १०/३/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_003/BhP_10.003.018.m4a", "display_order": 19, "topics": [{"text": "तस्याः सप्तमगर्भस्य सृतत्वेन प्रथा", "range": "१६"}]}, {"id": 6000199019, "chapter_id": 10199, "verse_number": "१०-३-१७", "content_sanskrit": "भगवानपि विश्वात्मा भक्तानामभयङ्करः।\nआविवेशांशभागेन मन आनकदुन्दुभेः॥ १०/३/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_003/BhP_10.003.019.m4a", "display_order": 20, "topics": [{"text": "भगवतः देवकीगर्भेऽनुप्रवेशः", "range": "१७–२५"}]}, {"id": 6000199020, "chapter_id": 10199, "verse_number": "१०-३-१८", "content_sanskrit": "स बिभ्रत् पौरुषं धाम राजमानो यथा रविः।\nदुरासदोऽतिदुर्धर्षो भूतानां सम्बभूव ह॥ १०/३/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_003/BhP_10.003.020.m4a", "display_order": 21}, {"id": 6000199021, "chapter_id": 10199, "verse_number": "१०-३-१९", "content_sanskrit": "ततो जगन्मङ्गलमच्युतांशं समाहितं शूरसुतेन देवी।\nदधार सर्वात्मकमात्मभूतं काष्ठा यथाऽऽनन्दकरं नभस्तः॥ १०/३/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_003/BhP_10.003.021.m4a", "display_order": 22}, {"id": 6000199022, "chapter_id": 10199, "verse_number": "१०-३-२०", "content_sanskrit": "सा देवकी सर्वजगन्निवासनिवासभूता नितरां न रेजे।\nभोजेन्द्रगेहेऽग्निशिखेव रुद्धा सरस्वती द्यूतखले यथा सती॥ १०/३/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_003/BhP_10.003.022.m4a", "display_order": 23}, {"id": 6000199023, "chapter_id": 10199, "verse_number": "१०-३-२१", "content_sanskrit": "तां वीक्ष्य कंसः प्रभयाऽजितम्भरां विरोचयन्तीं भवनं शुचिस्मिताम्।\nआहैष मे प्राणहरो हरिर्गुहां ध्रुवं श्रितो यन्न पुरेयमीदृशी॥ १०/३/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_003/BhP_10.003.023.m4a", "display_order": 24}, {"id": 6000199024, "chapter_id": 10199, "verse_number": "१०-३-२२", "content_sanskrit": "किमद्य तस्मिन् घटनीयमाशु मे यथाऽर्थतन्त्रो न विहन्ति विक्रमम्।\nस्‍त्रियः स्वसुर्गुरुमत्या वधोऽयं यशः श्रियं हन्त्यनुकूलमायुः॥ १०/३/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_003/BhP_10.003.024.m4a", "display_order": 25}, {"id": 6000199025, "chapter_id": 10199, "verse_number": "१०-३-२३", "content_sanskrit": "स एष जीवन् खलु सम्परेतो वर्तेत योऽत्यन्तनृशंसितेन।\nदेहे मृते तमनु ह्यर्थकामौ यशोऽमलं गौरभिमानिनो ध्रुवम्॥ १०/३/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_003/BhP_10.003.025.m4a", "display_order": 26}, {"id": 6000199026, "chapter_id": 10199, "verse_number": "१०-३-२४", "content_sanskrit": "इति घोरतमाद् भावात् सन्निवृत्तः स्वयं प्रभुः।\nआस्ते प्रतीक्षंस्तज्जन्म हरेर्वैरानुबन्धवित्॥ १०/३/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_003/BhP_10.003.026.m4a", "display_order": 27}, {"id": 6000199027, "chapter_id": 10199, "verse_number": "१०-३-२५", "content_sanskrit": "आसीनः संविशंस्तिष्ठन् भुञ्जानः पर्यटन् पिबन्।\nचिन्तयानो हृषीकेशमपश्यत् तन्मयं जगत्॥ १०/३/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_003/BhP_10.003.027.m4a", "display_order": 28}, {"id": 6000199028, "chapter_id": 10199, "verse_number": "१०-३-२६", "content_sanskrit": "ब्रह्मा भवश्च तत्रैत्य मुनिभिर्नारदादिभिः।\nदेवैः सानुचरैः साकं गीर्भिर्विष्णुमथास्तुवत्॥ १०/३/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_003/BhP_10.003.028.m4a", "display_order": 29, "topics": [{"text": "देवकीगर्भस्थस्य श्रीकृष्णस्य ब्रह्मादिदेवकृता स्तुतिः", "range": "२६–४३"}]}, {"id": 6000199029, "chapter_id": 10199, "verse_number": null, "content_sanskrit": "ब्रह्मभवावूचतुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_003/BhP_10.003.029.m4a", "display_order": 30}, {"id": 6000199030, "chapter_id": 10199, "verse_number": "१०-३-२७", "content_sanskrit": "सत्यव्रतं सत्यपरं त्रिसत्यं सत्यस्य योनिं निहितं च सत्ये।\nसत्यस्य सत्यमुत सत्यनेत्रं सत्यात्मकं त्वां शरणं प्रपन्नाः॥ १०/३/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_003/BhP_10.003.030.m4a", "display_order": 31}, {"id": 6000199031, "chapter_id": 10199, "verse_number": "१०-३-२८", "content_sanskrit": "एकायनोऽसौ द्विफलस्‍त्रिमूलश्चतूरसः पञ्चशिफः षडात्मा।\nसप्तत्वगष्टविटपो नवाक्षो दशच्छदी द्विखगो ह्यादिवृक्षः॥ १०/३/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_003/BhP_10.003.031.m4a", "display_order": 32}, {"id": 6000199032, "chapter_id": 10199, "verse_number": "१०-३-२९", "content_sanskrit": "त्वमेक एवास्य सतः प्रसूतिः स्थानं निधानं त्वमनुग्रहश्च।\nत्वन्मायया संवृतचेतसस्त्वां पश्यन्ति नाना न विपश्चितो ये॥ १०/३/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_003/BhP_10.003.032.m4a", "display_order": 33}, {"id": 6000199033, "chapter_id": 10199, "verse_number": "१०-३-३०", "content_sanskrit": "बिभर्षि रूपाण्यवबोध आत्मन् क्षेमाय लोकस्य चराचरस्य।\nसत्त्वोपपन्नानि सुखावहानि सतामभद्राणि मुहुः खलानाम्॥ १०/३/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_003/BhP_10.003.033.m4a", "display_order": 34}, {"id": 6000199034, "chapter_id": 10199, "verse_number": "१०-३-३१", "content_sanskrit": "त्वय्यम्बुजाक्षाखिलसत्त्वधाम्नि समाधिनाऽऽवेशितचेतसो ये।\nत्वत्पादपोतेन महत्कृतेन कुर्वन्ति गोवत्सपदं भवाब्धिम्॥ १०/३/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_003/BhP_10.003.034.m4a", "display_order": 35}, {"id": 6000199035, "chapter_id": 10199, "verse_number": "१०-३-३२", "content_sanskrit": "स्वयं समुत्तीर्य सुदुस्तरं द्युमन् भवार्णवं भीममदभ्रसौहृदाः।\nभवत्पदाम्भोरुहनावमत्र ते निधाय याताः सदनुग्रहो भवान्॥ १०/३/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_003/BhP_10.003.035.m4a", "display_order": 36}, {"id": 6000199036, "chapter_id": 10199, "verse_number": "१०-३-३३", "content_sanskrit": "येऽन्येऽरविन्दाक्ष विमुक्तमानिनः त्वय्यस्तभावादविशुद्धबुद्धयः।\nआरुह्य कृच्छ्रेण परं पदं ततः पतन्त्यधोऽनादृतयुष्मदङ्घ्रयः॥ १०/३/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_003/BhP_10.003.036.m4a", "display_order": 37}, {"id": 6000199037, "chapter_id": 10199, "verse_number": "१०-३-३४", "content_sanskrit": "तथा न ते माधव तावकाः क्‍वचिद् भ्रश्यन्ति मार्गात् त्वयि बद्धसौहृदाः।\nत्वयाऽभिगुप्ता विचरन्ति निर्भया विनायकानीकपमूर्धसु प्रभो॥ १०/३/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_003/BhP_10.003.037.m4a", "display_order": 38}, {"id": 6000199038, "chapter_id": 10199, "verse_number": "१०-३-३५", "content_sanskrit": "सत्त्वं विशुद्धं श्रयते भवान् स्थितौ शरीरिणां श्रेयउपायनं वपुः।\nवेदक्रियायोगतपःसमाधिभिस्तवार्हणं येन जनः समीहते॥ १०/३/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_003/BhP_10.003.038.m4a", "display_order": 39}, {"id": 6000199039, "chapter_id": 10199, "verse_number": "१०-३-३६", "content_sanskrit": "सत्त्वं न चेद् धातरिदं निजं भवेद् विज्ञानमज्ञानभिदापमार्जनम्।\nगुणप्रकाशैरनुमीयते भवान् प्रकाशते यस्य च येन वाऽगुणः॥ १०/३/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_003/BhP_10.003.039.m4a", "display_order": 40}, {"id": 6000199040, "chapter_id": 10199, "verse_number": "१०-३-३७", "content_sanskrit": "न नामरूपे गुणजन्मकर्मभिः निरूपितव्ये तव तस्य साक्षिणः।\nमनोवचोभ्यामनुमेयवर्त्मनो देवक्रियायाः प्रतियन्त्यथापि हि॥ १०/३/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_003/BhP_10.003.040.m4a", "display_order": 41}, {"id": 6000199041, "chapter_id": 10199, "verse_number": "१०-३-३८", "content_sanskrit": "शृण्वन् गृणन् संस्मरयंश्च चिन्तयन् नामानि रूपाणि च मङ्गलानि ते।\nक्रियासु यस्त्वच्चरणारविन्दयोराविष्टचित्तो न भवाय कल्प्यते॥ १०/३/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_003/BhP_10.003.041.m4a", "display_order": 42}, {"id": 6000199042, "chapter_id": 10199, "verse_number": "१०-३-३९", "content_sanskrit": "दिष्ट्या हरेऽस्या भवतः पदो भुवो भारोऽपनीतस्तव जन्मनेशितुः।\nदिष्ट्याऽङ्कितां त्वत्पदकैः सुशोभनैर्द्रक्ष्याम गां द्यां च तवानुकम्पिताम्॥ १०/३/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_003/BhP_10.003.042.m4a", "display_order": 43}, {"id": 6000199043, "chapter_id": 10199, "verse_number": "१०-३-४०", "content_sanskrit": "न तेऽभवस्येश भवस्य कारणं विना विनोदं बत तर्कयामहे।\nभवो निरोधः स्थितिरप्यविद्यया कृता यतस्त्वय्यभवाश्रयात्मनि॥ १०/३/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_003/BhP_10.003.043.m4a", "display_order": 44}, {"id": 6000199044, "chapter_id": 10199, "verse_number": "१०-३-४१", "content_sanskrit": "मत्स्याश्वकच्छपनृसिंहवराहहंसराजन्यविप्रविबुधेषुकृतावतारः।\nत्वं पासि नस्‍त्रिभुवनं च तथाऽधुनेश भारं भुवो हर यदूत्तम वन्दनं ते॥ १०/३/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_003/BhP_10.003.044.m4a", "display_order": 45}, {"id": 6000199045, "chapter_id": 10199, "verse_number": "१०-३-४२", "content_sanskrit": "दिष्ट्याऽम्ब ते कुक्षिगतः परः पुमान् अंशेन साक्षाद् भगवान् भवाय नः।\nमा भूद् भयं भोजपतेर्मुमूर्षोः गोप्ता यदूनां भविता तवात्मजः॥ १०/३/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_003/BhP_10.003.045.m4a", "display_order": 46}, {"id": 6000199046, "chapter_id": 10199, "verse_number": "१०-३-४३", "content_sanskrit": "इत्यभिष्टूय पुरुषं यद्रूपमनिदं यथा।\nब्रह्मेशानौ पुरोधाय देवाः प्रतिययुर्दिवम्॥ १०/३/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_003/BhP_10.003.046.m4a", "display_order": 47}, {"id": 6000199047, "chapter_id": 10199, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्धे तृतीयाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]