[{"id": 2096516, "chapter_id": 3065, "verse_number": "१३-१९५-१", "content_sanskrit": "[भीष्म उवाच।\nततः पद्मप्रतीकाशः पद्मोद्भूतः पितामहः।\nउवाच वचनं देवान्वासवं च शचीपतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2096517, "chapter_id": 3065, "verse_number": "१३-१९५-२", "content_sanskrit": "अयं महाबलो नागो रसातलचरो बली।\nतेजस्वी रेणुको नाम महासत्वपराक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2096518, "chapter_id": 3065, "verse_number": "१३-१९५-३", "content_sanskrit": "अतितेजस्विनः सर्वे महावीर्या महागजाः।\nधारयन्ति महीं कृत्स्नां सशैलवनकाननाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2096519, "chapter_id": 3065, "verse_number": "१३-१९५-४", "content_sanskrit": "भवद्भिः समनुज्ञातो रेणुकस्तान्महागजान्।\nधर्मगुह्यानि सर्वाणि गत्वा पृच्छतु तत्र वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2096520, "chapter_id": 3065, "verse_number": "१३-१९५-५", "content_sanskrit": "पितामहवचःक श्रुत्वा ते देवा रेणुकं तदा।\nप्रेषयामासुरव्यग्रा यत्र ते धरणीधराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2096521, "chapter_id": 3065, "verse_number": "१३-१९५-६x", "content_sanskrit": "रेणुक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2096522, "chapter_id": 3065, "verse_number": "१३-१९५-६", "content_sanskrit": "अनुज्ञातोऽस्मि देवैश्च पितृभिस्चक महाबलाः।\nधर्मगुह्यानि युष्माकं श्रोतुमिच्छामि तत्त्वतः।\nकथयध्वं महाभागा यद्वस्तत्त्वं मनीषितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2096523, "chapter_id": 3065, "verse_number": "१३-१९५-७x", "content_sanskrit": "दिग्गजा ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2096524, "chapter_id": 3065, "verse_number": "१३-१९५-७", "content_sanskrit": "कार्तिके मासि चाश्लेषा बहुलस्याष्टमी शिवा।\nतेन नक्षत्रयोगेन यो ददाति गुडौदनम्।\nइमं मन्त्रं जपच्छ्राद्धे यताहारो ह्यकोपनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2096525, "chapter_id": 3065, "verse_number": "१३-१९५-८", "content_sanskrit": "बलदेवप्रभृतयो ये नागा बलवत्तराः।\nअनन्ता ह्यक्षया नित्यं भोगिनः सुमहाबलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2096526, "chapter_id": 3065, "verse_number": "१३-१९५-९", "content_sanskrit": "तेषां कुलोद्भवा ये च महाभूता भुजङ्गमाः।\nते मे बलिं प्रयच्छन्तु बलतेजोभिवृद्धये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2096527, "chapter_id": 3065, "verse_number": "१३-१९५-१०", "content_sanskrit": "यदा नारायणः श्रीमानुज्जहार वसुन्धराम्।\nतद्बलं तस्य देवस्य धरामुद्धरतस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2096528, "chapter_id": 3065, "verse_number": "१३-१९५-११", "content_sanskrit": "एवमुक्त्वा बलिं तत्र वल्मीके तु निवेदयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2096529, "chapter_id": 3065, "verse_number": "१३-१९५-१२", "content_sanskrit": "गजेन्द्रकुसुमाकीर्णं नीलवस्त्रानुलेपनम्।\nनिर्वपेत्तं तु वल्मीके अस्तं याते दिवाकरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2096530, "chapter_id": 3065, "verse_number": "१३-१९५-१३", "content_sanskrit": "एवं तुष्टास्ततः सर्वे अधस्ताद्भारपीडिताः।\nश्रमं तं नावबुध्यामो धारयन्तो वसुन्धराम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2096531, "chapter_id": 3065, "verse_number": "१३-१९५-१४", "content_sanskrit": "एवं मन्यामहे सर्वे भारार्ता निरपेक्षिणः।\nब्राह्मणः क्षत्रियो वैश्यः शूद्रो वा यद्युपोषितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2096532, "chapter_id": 3065, "verse_number": "१३-१९५-१५", "content_sanskrit": "एवं संवत्सरं कृत्वा दानं बहुफलं लभेत्।\nवल्मीके बलिमादाय तन्नो बहुफलं मतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2096533, "chapter_id": 3065, "verse_number": "१३-१९५-१६", "content_sanskrit": "ये च नागा महावीर्यास्त्रिषु लोकेषु कृत्स्नशः।\nकृतातिथ्या भवेयुस्ते शतं वर्षाणि तत्त्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2096534, "chapter_id": 3065, "verse_number": "१३-१९५-१७", "content_sanskrit": "दिग्गजानां च तच्छ्रुत्वा देवताः पितरस्तथा।\nऋषयश्च महाभागाः पूजयन्ति स्म रेणुकम्॥] ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2096535, "chapter_id": 3065, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि पञ्चनवत्यधिकशततमोऽध्यायः॥ १९५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]