[{"id": 2204818, "chapter_id": 5365, "verse_number": "", "content_sanskrit": "शुभाशुभकर्मप्रकारकथनम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2204819, "chapter_id": 5365, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2204820, "chapter_id": 5365, "verse_number": "१", "content_sanskrit": "भगवन् देवदेवेश शूलपाणे वृषध्वज ।\nश्रुतं मे परमं गुह्यं प्रसादात् ते वरप्रद\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2204821, "chapter_id": 5365, "verse_number": "२", "content_sanskrit": "श्रोतुं भूयोऽहमिच्छामि प्रजानां हितकारणात् ।\nशुभाशुभमिति प्रोक्तं कर्म स्वंस्वं समासतः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2204822, "chapter_id": 5365, "verse_number": "३", "content_sanskrit": "तन्मे विस्तरतो ब्रूहि शुभाशुभविधिं प्रति ।\nअशुभं कीदृशं कर्म प्राणिनोऽधो निपातयेत्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2204823, "chapter_id": 5365, "verse_number": "", "content_sanskrit": "शुभं कर्म कथं देव प्रजानामूर्ध्वतो नयेत् ।\nएतन्मे वद देवेश श्रोतुकामाऽस्मि कीर्तय\t॥४", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2204824, "chapter_id": 5365, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2204825, "chapter_id": 5365, "verse_number": "५", "content_sanskrit": "तदहं ते प्रवक्ष्यामि तत्सर्वं शृणु शोभने ।\nसुकृतं दुष्कृतं चेति द्विविधं कर्मविस्तरम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2204826, "chapter_id": 5365, "verse_number": "६", "content_sanskrit": "तयोर्यद् दुष्कृतं कर्म तच्च सञ्जायते त्रिधा ।\nमनसा कर्मणा वाचा बुद्धिमोहसमुद्भवम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2204827, "chapter_id": 5365, "verse_number": "७", "content_sanskrit": "मनःपूर्वं तु वाक्कर्म वर्तते वाङ्मयं ततः ।\nजायते वै क्रियायोगमेवं चेष्टाक्रमं प्रिये\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2204828, "chapter_id": 5365, "verse_number": "८", "content_sanskrit": "अभिद्रोहोऽभ्यसूया च परार्थे चक्षुषा स्पृहा ।\nशुभाशुभानां मर्त्यानां वर्तनं विपरीततः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2204829, "chapter_id": 5365, "verse_number": "९", "content_sanskrit": "धर्मकार्ये यदाऽश्रद्धा पापकर्मणि हर्षणम् ।\nएवमाद्यशुभं कर्म मनसा पापमुच्यते\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2204830, "chapter_id": 5365, "verse_number": "१०", "content_sanskrit": "अनृतं यच्च परुषमबद्धवचनं कटु ।\nअसत्यं परिवादश्च पापमेतत्तु वाङ्मयम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2204831, "chapter_id": 5365, "verse_number": "११", "content_sanskrit": "अगम्यागमनं चैव परदारनिषेवणम् ।\nवधबन्धपरिक्लेशैः परप्राणोपतापनम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2204832, "chapter_id": 5365, "verse_number": "१२", "content_sanskrit": "चौर्यं परेषां द्रव्याणां हरणं नाशनं तथा ।\nअभक्ष्यभक्षणं चैव व्यसनेष्वभिषङ्गता\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2204833, "chapter_id": 5365, "verse_number": "१३", "content_sanskrit": "दर्पात् स्तम्भाभिमानाच्च परेषामुपतापनम् ।\nअकार्याणां च करणमशौचं पानमेव च\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2204834, "chapter_id": 5365, "verse_number": "१४", "content_sanskrit": "दौःशील्ये क्षुद्रसम्पर्कः साहाय्यं पापकर्मणि ।\nअधर्म्यमयशस्यं च कार्यं तस्य निषेवणम् ।\nएवमाद्यशुभं चान्यच्छारीरं पापमुच्यते\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2204835, "chapter_id": 5365, "verse_number": "१५", "content_sanskrit": "मानसाद् वाङ्मयं पापं विशिष्टमिति वक्ष्यते ।\nवाङ्मयादपि वै पापाच्छारीरं गण्यते बहु\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2204836, "chapter_id": 5365, "verse_number": "१६", "content_sanskrit": "एवं पापयुतं कर्म पातयेत् त्रिविधं नरम् ।\nपरोपतापजननमत्यन्तं पापकं स्मृतम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2204837, "chapter_id": 5365, "verse_number": "१७", "content_sanskrit": "त्रिविधं तत् कृतं पापं कर्तारं नरकं नयेत् ।\nपातकं त्वपि यत्कर्म करणाद् बुद्धिपूर्वकम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2204838, "chapter_id": 5365, "verse_number": "१८", "content_sanskrit": "सापदेशमवश्यं तु कर्तव्यमिति यत्कृतम् ।\nकथञ्चित् तत्कृतमपि कर्ता तेन न लिप्यते\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2204839, "chapter_id": 5365, "verse_number": "१९", "content_sanskrit": "अवश्यमपदेशेन प्रतिहन्येत कारणम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2204840, "chapter_id": 5365, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2204841, "chapter_id": 5365, "verse_number": "२०", "content_sanskrit": "भगवन् पापकं कर्म यथा कृत्वा न लिप्यते\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2204842, "chapter_id": 5365, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2204843, "chapter_id": 5365, "verse_number": "२१", "content_sanskrit": "यो नरोऽनपराधी च स्वात्मप्राणस्य रक्षणात् ।\nशत्रुमुद्यतशस्त्रं वा पूर्वं तेन हतोऽपि वा ।\nप्रतिगत्य नरो हिंस्यान्न स पापेन लिप्यते\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2204844, "chapter_id": 5365, "verse_number": "२२", "content_sanskrit": "चोराटविकसंत्रस्तास्तत्प्रतीकारचेष्टया ।\nतान् प्रतिघ्नन् नरो हिंस्यान्न स पापेन लिप्यते\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2204845, "chapter_id": 5365, "verse_number": "२३", "content_sanskrit": "ग्रामार्थं भर्तृपिण्डार्थं दीनानुग्रहकारणात् ।\nवधबन्धपरिक्लेशान् कुर्वन् पापात् प्रमुच्यते\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2204846, "chapter_id": 5365, "verse_number": "२४", "content_sanskrit": "दुर्भिक्षे चात्मवृत्त्यर्थमेकायतनगतस्तथा ।\nअकार्यं वाऽप्यभक्ष्यं वा कृत्वा पापैर्न लिप्यते\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2204847, "chapter_id": 5365, "verse_number": "२५", "content_sanskrit": "व्याधितो रोगमोक्षार्थमभक्ष्येण न लिप्यते ।\nअनृतं धर्मयुक्तं च दाक्षिण्यात् स्त्रीषु भाषितम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2204848, "chapter_id": 5365, "verse_number": "२६", "content_sanskrit": "आत्मप्राणभयादुक्तं मोक्षार्थं चाप्यधार्मिकात् ।\nविवाहकरणे चैव लौकिकेनानृतं ब्रुवन् ।\nसंस्तम्भनार्थं त्रस्तानामनृतेन न लिप्यते\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2204849, "chapter_id": 5365, "verse_number": "२७", "content_sanskrit": "विधिरेष गृहस्थानां प्रायेणैवोपदिश्यते ।\nअवाच्यं वाऽप्यकार्यं वा देशकालवशेन तु\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2204850, "chapter_id": 5365, "verse_number": "२८", "content_sanskrit": "बुद्धिपूर्वं नरः कुर्वंस्तत्प्रयोजनमात्रया ।\nकिञ्चिद्वा लिप्यते पापैरथवा न च लिप्यते\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2204851, "chapter_id": 5365, "verse_number": "२९", "content_sanskrit": "एवं देवि विजानीहि नास्ति तत्र विचारणा\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2204852, "chapter_id": 5365, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2204853, "chapter_id": 5365, "verse_number": "३०", "content_sanskrit": "भगवन् पानदोषांश्च प्रेक्षयापेयकारणान् ।\nएतदिच्छाम्यहं श्रोतुं तन्मे वद महेश्वर\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2204854, "chapter_id": 5365, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2204855, "chapter_id": 5365, "verse_number": "३१", "content_sanskrit": "हन्त ते कथयिष्यामि पानोत्पत्तिं शुचिस्मिते\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2204856, "chapter_id": 5365, "verse_number": "३२", "content_sanskrit": "पुरा सर्वेऽभवन्मर्त्या बुद्धिमन्तो नयानुगाः ।\nशुचयः सुभगाचाराः सर्वे सुमनसः प्रिये\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2204857, "chapter_id": 5365, "verse_number": "३३", "content_sanskrit": "एवंभूते तदा लोके प्रेष्यत्वं न परस्परम् ।\nप्रेष्याभावान्मनुष्याणां कर्मारम्भो ननाश ह\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2204858, "chapter_id": 5365, "verse_number": "३४", "content_sanskrit": "उभयोर्लोकयोर्नाशं दृष्ट्वा कर्मक्षयात् प्रभुः ।\nयज्ञकर्म कथं लोके वर्तेतेति पितामहः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2204859, "chapter_id": 5365, "verse_number": "३५", "content_sanskrit": "आज्ञापयत् सुरान् देवि मोहयस्वेति मानुषान् ।\nतमसः सारमुद्धृत्य पानं बुद्धिप्रणाशनम् ।\nन्यपातयन् मनुष्येषु पापदोषावहं प्रिये\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2204860, "chapter_id": 5365, "verse_number": "३६", "content_sanskrit": "तदाप्रभृति तत् पीत्वा मुमुहुर्मानवा भुवि ।\nकार्याकार्यमजानन्तो वाच्यावाच्यं गुणागुणम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2204861, "chapter_id": 5365, "verse_number": "३७", "content_sanskrit": "केचिद् हसन्ति तत् पीत्वा प्रवदन्ति तथा परे ।\nनृत्यन्ति मुदिताः केचिद् गायन्ति च शुभाशुभान्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2204862, "chapter_id": 5365, "verse_number": "३८", "content_sanskrit": "कलहं कुर्वतेऽभीक्ष्णं प्रहरन्ति परस्परम् ।\nक्वचिद् धावन्ति सहसा प्रस्खलन्ति पतन्ति च\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2204863, "chapter_id": 5365, "verse_number": "३९", "content_sanskrit": "अयुक्तं बहु भाषन्ते यत्र क्वचन शोभने ।\nनग्ना विक्षिप्य गात्राणि नष्टसञ्ज्ञा मृता इव\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2204864, "chapter_id": 5365, "verse_number": "४०", "content_sanskrit": "एवं बहुविधान् पापान् कुर्वन्ति हृतचेतसः ।\nये पिबन्ति महामोहं पानं पापयुता नराः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2204865, "chapter_id": 5365, "verse_number": "४१", "content_sanskrit": "धृतिं लज्जां च बुद्धिं च पानं पीतं प्रणाशयेत् ।\nतस्मान्नराः सम्भवन्ति निर्लज्जा निरपत्रपाः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2204866, "chapter_id": 5365, "verse_number": "४२", "content_sanskrit": "बुद्धिसत्त्वैः परिक्षीणास्तेजोहीना मलान्विताः ।\nपीत्वापीत्वा तृषायुक्ताः पानपाः सम्भवन्ति च\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2204867, "chapter_id": 5365, "verse_number": "४३", "content_sanskrit": "पानकामाः पानकथाः पानकालाभिकाङ्क्षिणः ।\nपानार्थं कर्मवश्यास्ते सम्भवन्ति नराधमाः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2204868, "chapter_id": 5365, "verse_number": "४४", "content_sanskrit": "पानकामास्तृषायोगाद् बुद्धिसत्त्वपरिक्षयात् ।\nपानपानां प्रेष्यकराः पानपास्त्वभवन् भृशम्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2204869, "chapter_id": 5365, "verse_number": "४५", "content_sanskrit": "तदाप्रभृति वै लोके नीचैः पानवशैर्नरैः ।\nकारयन्ति च कर्माणि बुद्धिमन्तस्त्वपानपाः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2204870, "chapter_id": 5365, "verse_number": "४६", "content_sanskrit": "काकृत्त्वमथ दासत्वं प्रेष्यतामेत्य पानपाः ।\nसर्वकर्मकराश्चासन् पशुवद् रज्जुबन्धिताः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2204871, "chapter_id": 5365, "verse_number": "४७", "content_sanskrit": "पानपस्तु मधान्धत्वात् तदा बुद्धिप्रणाशनात् ।\nकार्याकार्यस्य चाज्ञानाद् यथेष्टकरणात् स्वयम् ।\nविदुषामविधेयत्वात् पापमेवाभिपद्यते\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2204872, "chapter_id": 5365, "verse_number": "४८", "content_sanskrit": "परिभूतो भवेल्लोके मद्यपो मित्रभेदकः ।\nसर्वकालमशुद्धश्च सर्वभक्षस्तथाऽभवत्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2204873, "chapter_id": 5365, "verse_number": "४९", "content_sanskrit": "विशिष्टैर्ज्ञातिभिर्द्वेष्यः सततं कलिभावनः ।\nकटुकं परुषं घोरं वाक्यं वदति सर्वशः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2204874, "chapter_id": 5365, "verse_number": "५०", "content_sanskrit": "गुरूनतिवदेन्मत्तः परदारान् प्रधर्षयेत् ।\nसंविदं कुरुते शौण्डैर्न शृणोति हितं क्वचित्\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2204875, "chapter_id": 5365, "verse_number": "५१", "content_sanskrit": "एवं बहुविधा दोषाः पानपे सन्ति शोभने ।\nकेवलं नरकं यान्ति नास्ति तत्र विचारणा ।\nतस्मात् तद् वर्जितं सद्भिः पानमात्महितैषिभिः\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2204876, "chapter_id": 5365, "verse_number": "५२", "content_sanskrit": "यदि पानं न वर्जेरन् सन्तश्चारित्रकारणात् ।\nभवेदेवं जगत् सर्वं निर्मर्यादं च निष्क्रियम्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2204877, "chapter_id": 5365, "verse_number": "५३", "content_sanskrit": "तस्माद् बुद्धेर्हि रक्षार्थं सद्भिः पानं विवर्जितम् ।\nइति ते दुष्कृतं सर्वं त्रिविधं कथितं प्रिये॥\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2204878, "chapter_id": 5365, "verse_number": "२१६", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे षोडशोत्तरद्विशततमोऽध्यायः ॥२१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2204879, "chapter_id": 5365, "verse_number": "", "content_sanskrit": "* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}]