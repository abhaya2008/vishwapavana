[{"id": 7004337000, "chapter_id": 24337, "verse_number": "५-३-३१-१", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nततो गच्छेच्च राजेन्द्र तीर्थं त्रैलोक्यविश्रुतम् ।\nब्रह्मावर्तमिति ख्यातं सर्वपापप्रणाशनम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004337001, "chapter_id": 24337, "verse_number": "५-३-३१-२", "content_sanskrit": "तत्र संनिहितो ब्रह्मा नित्यसेवी युधिष्ठिर ।\nऊर्ध्वबाहुर्निरालम्बचकार भ्रमणं सदा॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004337002, "chapter_id": 24337, "verse_number": "५-३-३१-३", "content_sanskrit": "एकाहारवशेऽतिष्ठद्द्वादशाब्दं महाव्रती ।\nअत्र तीर्थे विधानेन चिन्तयन् वै महेश्वरम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004337003, "chapter_id": 24337, "verse_number": "५-३-३१-४", "content_sanskrit": "तेन तत्पुण्यमाख्यातं ब्रह्मावर्तमिति प्रभो ।\nतत्र स्नात्वा विधानेन तर्पयेत्पितृदेवताः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004337004, "chapter_id": 24337, "verse_number": "५-३-३१-५", "content_sanskrit": "अर्चयेद्देवमीशानं विष्णुं वा परमेश्वरम् ।\nयत्फलं सर्वयज्ञानां विधिवद्दक्षिणावताम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004337005, "chapter_id": 24337, "verse_number": "५-३-३१-६", "content_sanskrit": "तत्फलं समवाप्नोति तत्तीर्थस्य प्रभावतः ।\nयस्मिंस्तीर्थे तु यो देवो दानवो वा द्विजोऽथ वा॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004337006, "chapter_id": 24337, "verse_number": "५-३-३१-७", "content_sanskrit": "सिद्धस्तेनैव तन्नाम्ना ख्यातं लोके महच्च तत् ।\nन जलं न स्थलं नाम क्षेत्रं वा ह्यूषराणि च॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004337007, "chapter_id": 24337, "verse_number": "५-३-३१-८", "content_sanskrit": "पवित्रत्वं लभन्त्येते पौरुषेण विना नृणाम् ।\nसामर्थ्यान्निश्चयाद्धैर्यात्सिध्यन्ति पुरुषा नृप॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004337008, "chapter_id": 24337, "verse_number": "५-३-३१-९", "content_sanskrit": "प्रमादात्तस्य लोभेन पतन्ति नरके ध्रुवम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004337009, "chapter_id": 24337, "verse_number": "५-३-३१-१०", "content_sanskrit": "संनिरुध्येन्द्रियग्रामं यत्र यत्र वसेन्मुनिः ।\nतत्र तत्र कुरुक्षेत्रं नैमिषं पुष्कराणि च॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}]