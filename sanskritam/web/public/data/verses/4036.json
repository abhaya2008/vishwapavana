[{"id": 2140783, "chapter_id": 4036, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2140784, "chapter_id": 4036, "verse_number": "१", "content_sanskrit": "उत्तरं सारथिं कृत्वा शमीं कृत्वा प्रदक्षिणम् ।\nआयुधं सर्वमादाय ततः प्रायाद् धनञ्जयः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2140785, "chapter_id": 4036, "verse_number": "२", "content_sanskrit": "ध्वजं च सिंहं मात्स्यस्य भ्रातॄणामायुधानि च ।\nप्रणिधाय शमीमध्ये प्रयातुमुपचक्रमे\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2140786, "chapter_id": 4036, "verse_number": "३", "content_sanskrit": "ततः काञ्चनलाङ्गूलं ध्वजं वानरलक्षणम् ।\nदिव्यं मायामयं युक्तं विहितं विश्वकर्मणा\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2140787, "chapter_id": 4036, "verse_number": "४", "content_sanskrit": "मनसा चिन्तयामास प्रसादं पावकस्य च\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2140788, "chapter_id": 4036, "verse_number": "५", "content_sanskrit": "स च तच्चिन्तितं ज्ञात्वा ध्वजे भूतान्यचोदयत् ।\nरथे वानरमुच्छ्रित्य गाण्डीवं विक्षिपद् धनुः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2140789, "chapter_id": 4036, "verse_number": "६", "content_sanskrit": "सपताकं विचित्राङ्गं सोपासङ्गं महाबलम् ।\nरथमास्थाय बीभत्सुः कौन्तेयः श्वेतवाहनः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2140790, "chapter_id": 4036, "verse_number": "७", "content_sanskrit": "बद्धासिः सतळत्राणः प्रगृहीतशरासनः ।\nततः प्रायादुदीचीं स कपिप्रवरकेतनः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2140791, "chapter_id": 4036, "verse_number": "८", "content_sanskrit": "स्वनवन्तं महाशङ्खं देवदत्तं धनञ्जयः ।\nशशाङ्करूपं बीभत्सुः प्राध्मापयदरिन्दमः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2140792, "chapter_id": 4036, "verse_number": "९", "content_sanskrit": "शङ्खशब्दोऽस्य सोऽत्यर्थं श्रूयते कालमेघवत्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2140793, "chapter_id": 4036, "verse_number": "१०", "content_sanskrit": "तस्य शङ्खस्य शब्देन धनुषोऽभिस्वनेन च ।\nवानरस्य च नादेन रथनेमिस्वनेन च\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2140794, "chapter_id": 4036, "verse_number": "११", "content_sanskrit": "जङ्गमस्य भयं घोरमकरोत् पाकशासनिः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2140795, "chapter_id": 4036, "verse_number": "१२", "content_sanskrit": "शङ्खशब्देन पार्थस्य मुखेनाश्वासयन् क्षितौ ।\nततस्ते जवना युग्या जानुभ्यामगमन् महीम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2140796, "chapter_id": 4036, "verse_number": "१३", "content_sanskrit": "उत्तरश्चापि सन्त्रस्तो रथोपस्थ उपाविशत्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2140797, "chapter_id": 4036, "verse_number": "१४", "content_sanskrit": "अथाश्वान् रश्मिभिः पार्थः समुद्यम्य परन्तपः ।\nव्यभ्राजत रथोपस्थे भानुर्मेराविवोत्तरे\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2140798, "chapter_id": 4036, "verse_number": "१५", "content_sanskrit": "शङ्खशब्देन वित्रस्तं ज्यास्वनेन च मूर्च्छितम् ।\nउत्तरं सम्परिष्वज्य समाश्वासयदर्जुनः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2140799, "chapter_id": 4036, "verse_number": "१६", "content_sanskrit": "मा भैस्त्वं राजपुत्राग्र्य क्षत्रियोऽसि परन्तप ।\nकथं पुरुषशार्दूल शत्रुमध्ये विषीदसि\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2140800, "chapter_id": 4036, "verse_number": "१७", "content_sanskrit": "श्रुतास्ते शङ्खशब्दाश्च भेरीशब्दाश्च सर्वशः ।\nकुञ्जराणां च नदतां व्यूढानीकेषु तिष्ठताम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2140801, "chapter_id": 4036, "verse_number": "१८", "content_sanskrit": "स त्वं कथमिवानेन शङ्खशब्देन भीषितः ।\nविषण्णरूपो वित्रस्तः पुरुषः प्राकृतो यथा\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2140802, "chapter_id": 4036, "verse_number": "", "content_sanskrit": "उत्तरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2140803, "chapter_id": 4036, "verse_number": "१९", "content_sanskrit": "श्रुता मे शङ्खशब्दाश्च भेरीनादाश्च सर्वशः ।\nकुञ्जराणां च निनदा व्यूढानीकेषु तिष्ठताम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2140804, "chapter_id": 4036, "verse_number": "२०", "content_sanskrit": "नैवंविधाः शङ्खशब्दाः पुरा जातु मया श्रुताः ।\nध्वजस्य चापि रूपं मे दृष्टपूर्वं न हीदृशम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2140805, "chapter_id": 4036, "verse_number": "२१", "content_sanskrit": "धनुषश्चैव घोषो यः श्रुतपूर्वो न मे क्वचित्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2140806, "chapter_id": 4036, "verse_number": "२२", "content_sanskrit": "अस्य शङ्खस्य शब्देन धनुषो निस्वनेन च ।\nअमानुषाणां शब्देन भूतानां ध्वजवासिनाम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2140807, "chapter_id": 4036, "verse_number": "२३", "content_sanskrit": "रथनेमिप्रणादेन मनो मे मुह्यते भृशम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2140808, "chapter_id": 4036, "verse_number": "२४", "content_sanskrit": "व्याकुलाश्च दिशः सर्वा हृदयं व्यथतीव च ।\nध्वजेन पिहिताः सर्वा दिशो न प्रतिभान्ति मे\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2140809, "chapter_id": 4036, "verse_number": "२५", "content_sanskrit": "गाण्डीवस्य च शब्देन कर्णौ मे बधिरीकृतौ\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2140810, "chapter_id": 4036, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2140811, "chapter_id": 4036, "verse_number": "२६", "content_sanskrit": "पुनर्ध्वजं पुनःशङ्खं धनुश्चैव पुनः पुनः ।\nसम्मूढचेता वैराटिरर्जुनं समुदैक्षत\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2140812, "chapter_id": 4036, "verse_number": "२७", "content_sanskrit": "ततोऽर्जुनोऽब्रवीद् वाक्यं राजपुत्रं परन्तपः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2140813, "chapter_id": 4036, "verse_number": "२८", "content_sanskrit": "स्थिरो भव महाबाहो सञ्ज्ञां चात्मानमानय ।\nएकान्ते रथमास्थाय पद्भ्यां त्वमवपीड्य च\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2140814, "chapter_id": 4036, "verse_number": "२९", "content_sanskrit": "दृढं रश्मींश्च संयच्छ शङ्खं ध्मास्याम्यहं पुनः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2140815, "chapter_id": 4036, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2140816, "chapter_id": 4036, "verse_number": "३०", "content_sanskrit": "ततः स पुनरेवाथ तं शङ्खं पूरयद् बली ।\nद्विषतां दुःखजननं सुहृदां हर्षवर्धनम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2140817, "chapter_id": 4036, "verse_number": "३१", "content_sanskrit": "ततः शङ्खमुपाध्मासीद् दारयन्निव पर्वतान् ।\nगुहा गिरीणां च तथा दिशः शैलांस्तथैव च\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2140818, "chapter_id": 4036, "verse_number": "३२", "content_sanskrit": "उत्तरश्चापि सँल्लीनो रथोपस्थ उपाविशत्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2140819, "chapter_id": 4036, "verse_number": "३३", "content_sanskrit": "तस्य शङ्खस्य शब्देन रथनेमिस्वनेन च ।\nगाण्डीवस्य च शब्देन पृथिवी समकम्पत\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2140820, "chapter_id": 4036, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां विराटपर्वणि चतुश्चत्वारिंशोऽध्यायः ॥४४॥ गोग्रहणपर्वणि सप्तदशोऽध्यायः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]