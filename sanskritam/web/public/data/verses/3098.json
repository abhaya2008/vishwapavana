[{"id": 2098008, "chapter_id": 3098, "verse_number": "१३-२२८-१", "content_sanskrit": "उमोवाच।\nभगवन्सर्वभूतेश लोके कर्मक्रियापथे।\nदैवात्प्रवर्तते सर्वमिति केचिद्व्यवस्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2098009, "chapter_id": 3098, "verse_number": "१३-२२८-२", "content_sanskrit": "अपरे चेष्टया चेति दृष्ट्वा प्रत्यक्षतः क्रियाम्।\nपक्षभेदे द्विधा चास्मिन्संशयस्थं मनो मम।\nतत्त्वं वद महादेव श्रोतुं कौतूहलं हि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2098010, "chapter_id": 3098, "verse_number": "१३-२२८-३x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2098011, "chapter_id": 3098, "verse_number": "१३-२२८-३", "content_sanskrit": "तदहं ते प्रवक्ष्यामि शृणु तत्वं समाहिता।\nतदेवं कुरुते कर्म लोके देवि शुभाशुभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2098012, "chapter_id": 3098, "verse_number": "१३-२२८-४", "content_sanskrit": "लक्ष्यते द्विविधं कर्म मानुषेष्वेव तच्छृणु।\nपुराकृतं तयोरेकमैहिकं त्वितरस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2098013, "chapter_id": 3098, "verse_number": "१३-२२८-५", "content_sanskrit": "अदृष्टपूर्वं यत्कर्म तद्दैवमिति लक्ष्यते।\nविहीनं दृष्टकरणं तन्मानुषमिति स्मृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2098014, "chapter_id": 3098, "verse_number": "१३-२२८-६", "content_sanskrit": "मानुषं तु क्रियामात्रं दैवात्सम्भवते फलम्।\nएवं तदुभयं कर्म मानुषं विद्धि तन्नृषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2098015, "chapter_id": 3098, "verse_number": "१३-२२८-७", "content_sanskrit": "लौकिकं तु प्रवक्ष्यामि दैवमानुषनिर्मितम्।\nकृषौ तु दृश्यते कर्म कर्षणं वपनं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2098016, "chapter_id": 3098, "verse_number": "१३-२२८-८", "content_sanskrit": "रोपणं चैव लवनं यच्चान्यत्पौरुषं स्मृतम्।\nदैवादसिद्धिश्च भवेद्दुष्कृतं चास्ति पौरुषे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2098017, "chapter_id": 3098, "verse_number": "१३-२२८-९", "content_sanskrit": "सुयत्नाल्लभ्यते कीर्तिर्दुर्यत्नादयशस्तथा।\nएवं लोकगतिर्देवि आदिप्रभृति वर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2098018, "chapter_id": 3098, "verse_number": "१३-२२८-१०x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2098019, "chapter_id": 3098, "verse_number": "१३-२२८-१०", "content_sanskrit": "भगवन्सर्वलोकेश सुरासुरनमस्कृत।\nकथमात्मा सदा गर्भं संविशेष्कर्मकारणात्।\nतन्मे वद महादेव तद्धि गुह्यं परं मतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2098020, "chapter_id": 3098, "verse_number": "१३-२२८-११x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2098021, "chapter_id": 3098, "verse_number": "१३-२२८-११", "content_sanskrit": "शृणु भामिनि तत्सर्वं गुह्यानां परमं प्रिये।\nदेवगुह्यादपि परमात्मगुह्यमिति स्मृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2098022, "chapter_id": 3098, "verse_number": "१३-२२८-१२", "content_sanskrit": "देवासुरास्तन्न विदुरात्मनो हि गतागतम्।\nअदृश्यो हि सदैवात्मा जनैः सौक्ष्म्यान्निराश्रयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2098023, "chapter_id": 3098, "verse_number": "१३-२२८-१३", "content_sanskrit": "अतिमायेति मायानामात्ममाया सेदष्यते।\nसोयं चतुर्विधां जातिं संविशत्यात्ममायया।\nमैथुनं शोणितं बीजं दैवमेवात्र कारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2098024, "chapter_id": 3098, "verse_number": "१३-२२८-१४", "content_sanskrit": "बीजशोणितसंयोगे यदा सम्भवते शुभे।\nतदाऽऽत्मा विशते गर्भमेवमण्डजरायुजे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2098025, "chapter_id": 3098, "verse_number": "१३-२२८-१५", "content_sanskrit": "एवं संयोगकाले तु आत्मा गर्भत्वमेयिवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2098026, "chapter_id": 3098, "verse_number": "१३-२२८-१६", "content_sanskrit": "कलिलाज्जायते पिण्डं पिण्डात्पेश्यर्बुदं भवेत्।\nव्यक्तिभावगतं चैव कर्म त्वाश्रयते क्रमात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2098027, "chapter_id": 3098, "verse_number": "१३-२२८-१७", "content_sanskrit": "एवं विवर्धमानेन कर्मात्मा सह वर्धते।\nएवमात्मगतिं विद्धि यन्मां पृच्छसि सुप्रभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2098028, "chapter_id": 3098, "verse_number": "१३-२२८-१८", "content_sanskrit": "रोपणं चैव लवनं यच्चान्यत्पौरुषं स्मृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2098029, "chapter_id": 3098, "verse_number": "१३-२२८-१९", "content_sanskrit": "काले वृष्टिः सुवापं च प्ररोहः पक्तिरेव च।\nएवमादि तु यच्चान्यत्तद्दैवतमिति स्मृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2098030, "chapter_id": 3098, "verse_number": "१३-२२८-२०", "content_sanskrit": "पञ्चभूतस्थितिश्चैव ज्योतिषामयनं तथा।\nअबुद्धिगम्यं यन्मर्त्यैर्हेतुभिर्वा न विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2098031, "chapter_id": 3098, "verse_number": "१३-२२८-२१", "content_sanskrit": "तादृशं कारणं दैवं शुभं वा यदि वेतरत्।\nयादृशं चात्मना शक्यं तत्पौरुषमिति स्मृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2098032, "chapter_id": 3098, "verse_number": "१३-२२८-२२", "content_sanskrit": "केवलं फलनिष्पत्तिरेकेन तु न शक्यते।\nपौरुषेणैव दैवेनि युगपद्ग्रथितं प्रिये।\nतयोः समाहितं कर्म शीतोष्णं युगपत्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2098033, "chapter_id": 3098, "verse_number": "१३-२२८-२३", "content_sanskrit": "पौरुषं तु तयोः पूर्वमारब्धव्यं विजानता।\nआत्मना तु न शक्यं हि न तथा कीर्तिमाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2098034, "chapter_id": 3098, "verse_number": "१३-२२८-२४", "content_sanskrit": "खननान्मथनाल्लोके जलाग्निप्रापणं यथा।\nतथा पुरुषकारे तु दैवसम्पत्समाहिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2098035, "chapter_id": 3098, "verse_number": "१३-२२८-२५", "content_sanskrit": "नरस्याकुर्वतः कर्म दैवसम्पन्न लभ्यते।\nतस्मात्सर्वसमारम्भो दैवमानुषनिर्मितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2098036, "chapter_id": 3098, "verse_number": "१३-२२८-२६", "content_sanskrit": "असुरा राक्षसाश्चैव मन्यन्ते लोकनाशनाः।\nपश्यन्ते न च ते पापाः केवलं मांसभक्षणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2098037, "chapter_id": 3098, "verse_number": "१३-२२८-२७", "content_sanskrit": "प्रच्छादितं हि तत्सर्वं गूढमाया हि देवताः।\nतदहं ते प्रवक्ष्यामि देवि गुह्यं पुरस्सरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2098038, "chapter_id": 3098, "verse_number": "१३-२२८-२८", "content_sanskrit": "आदिकाले नराः सर्वे कृत्वा कर्म शुभाशुभम्।\nभुञ्जते पश्यमानास्ते वृत्तान्तं लोकयोर्द्वयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2098039, "chapter_id": 3098, "verse_number": "१३-२२८-२९", "content_sanskrit": "यथैवात्मकृतं विद्युर्देशान्तरगता नराः।\nविद्युस्तथैवान्तकाले सुकृतं पौर्वदैहिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2098040, "chapter_id": 3098, "verse_number": "१३-२२८-३०", "content_sanskrit": "एवं व्यवस्थिते लोके सर्वे धर्मरताऽभवन्।\nअचिरेणैव कालेन स्वर्गः सम्पूरितस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2098041, "chapter_id": 3098, "verse_number": "१३-२२८-३१", "content_sanskrit": "देवानामपि सम्बाधं दृष्ट्वा ब्रह्माऽप्यचिन्तयत्।\nसञ्चरन्ते कथं स्वर्गं मानुषाः प्रविशन्ति हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2098042, "chapter_id": 3098, "verse_number": "१३-२२८-३२", "content_sanskrit": "इत्येवमनुचिन्त्यैव मानुषान्सममोहयत्।\nतदाप्रभृति ते मर्त्या न विदुस्ते पुराकृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2098043, "chapter_id": 3098, "verse_number": "१३-२२८-३३", "content_sanskrit": "कामक्रोधौ तु तत्काले मानुषेष्ववपातयत्।\nताभ्यामभिहता मर्त्याः स्वर्गलोकं न पेदिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2098044, "chapter_id": 3098, "verse_number": "१३-२२८-३४", "content_sanskrit": "पुराकृतस्याविज्ञानात्कामक्रोधाभिपीडिताः।\nनैतदस्तीति मन्वाना विकारंश्चक्रिरे पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2098045, "chapter_id": 3098, "verse_number": "१३-२२८-३५", "content_sanskrit": "अकार्यादिमहादोषानाहरन्त्यात्मकारणात्।\nविस्मृत्य धर्मकार्याणि परलोकभयं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2098046, "chapter_id": 3098, "verse_number": "१३-२२८-३६", "content_sanskrit": "एवं व्यवस्थिते लोके कश्मलं समपद्यत।\nलोकानां चैव देवानां क्षयायैव तथा प्रिये।\nनरकाः पूरिताश्चासन्प्राणिभिः पापकारिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2098047, "chapter_id": 3098, "verse_number": "१३-२२८-३७", "content_sanskrit": "पुनरेव तु तान्दृष्ट्वा लोककर्ता पितामहः।\nअचिन्तयत्तमेवार्थं लोकानां हितकारणात्।\nसमत्वेन कथं लोके वर्तेतेति मुहुर्मुहुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2098048, "chapter_id": 3098, "verse_number": "१३-२२८-३८", "content_sanskrit": "चिन्तयित्वा तदा ब्रह्मा ज्ञानेन तपसा प्रिये।\nअकरोज्ज्ञानदृश्यं तत्परलोकं न चक्षुषा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2098049, "chapter_id": 3098, "verse_number": "१३-२२८-३९x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2098050, "chapter_id": 3098, "verse_number": "१३-२२८-३९", "content_sanskrit": "भगवन्मृतमात्रस्तु योयं जात इति स्मृतः।\nतथैव दृश्यते जातस्तत्रात्मा तु कथं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2098051, "chapter_id": 3098, "verse_number": "१३-२२८-४०", "content_sanskrit": "गर्भादावेव संविष्ट आत्मा तु भगवन्मम।\nएष मे संशयो देव तन्मे छेत्तुं त्वमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2098052, "chapter_id": 3098, "verse_number": "१३-२२८-४१x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2098053, "chapter_id": 3098, "verse_number": "१३-२२८-४१", "content_sanskrit": "तदहं ते प्रवक्ष्यामि शृणु तत्वं समाहिता।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2098054, "chapter_id": 3098, "verse_number": "१३-२२८-४२", "content_sanskrit": "अन्यो गर्भगतो भूत्वा तत्रैव निधनं गतः।\nपुनरन्यच्छरीरं तत्प्रविश्य भुवि जायते।\nतत्वविन्नैव सर्वस्तु दैवयोगस्तु सम्भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2098055, "chapter_id": 3098, "verse_number": "१३-२२८-४३", "content_sanskrit": "सूतिकाया हितार्थं च मोहनार्थं च देहिनाम्।\nसमकर्मविधानत्वादित्येवं विद्धि शोभने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2098056, "chapter_id": 3098, "verse_number": "१३-२२८-४४", "content_sanskrit": "काङ्क्षमाणास्तु नरकं भुक्त्वा केचित्प्रयान्ति हि।\nमायासंयामिका नाम यज्जन्ममरणान्तरे।\nइति ते कथितं देवि भूयः श्रोतुं किमिच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2098057, "chapter_id": 3098, "verse_number": "१३-२२८-४५x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2098058, "chapter_id": 3098, "verse_number": "१३-२२८-४५", "content_sanskrit": "भगवन्सर्वलोकेश लोकनाथ वृषध्वज।\nनास्त्यात्मा कर्मभोक्तेति मृतो जन्तुर्न जायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2098059, "chapter_id": 3098, "verse_number": "१३-२२८-४६", "content_sanskrit": "स्वभावाज्जायते सर्वं यथा वृक्षफलं तथा।\nयथोर्मयः सम्भवन्ति तथैव जगदाकृतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2098060, "chapter_id": 3098, "verse_number": "१३-२२८-४७", "content_sanskrit": "तपोदानानि यत्कर्म तत्र तद्दृश्यते वृथा।\nनास्ति पौनर्भवं जन्म इति केचिद्व्यवस्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2098061, "chapter_id": 3098, "verse_number": "१३-२२८-४८", "content_sanskrit": "परोक्षवचनं श्रुत्वा न प्रत्यक्षस्य दर्शनात्।\nतत्सर्वं नास्तिनास्तीति संशयस्थास्तथा परे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2098062, "chapter_id": 3098, "verse_number": "१३-२२८-४९", "content_sanskrit": "पक्षभेदान्तरे चास्मिंस्तत्वं मे वक्तुमर्हसि।\nउक्तं भगवता यत्तु तत्तु लोकस्य संस्थितिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2098063, "chapter_id": 3098, "verse_number": "१३-२२८-५०", "content_sanskrit": "प्रश्नमेतत्तु पृच्छत्या रुद्राण्या परिषत्तदा।\nकौतूहलयुता श्रोतुं समाहितमनाऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2098064, "chapter_id": 3098, "verse_number": "१३-२२८-५१x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2098065, "chapter_id": 3098, "verse_number": "१३-२२८-५१", "content_sanskrit": "नैतदस्ति महाभागे यद्वदन्तीह नास्तिकाः।\nएतदेवाभिशस्तानां श्रुतविद्वेषिणां मतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2098066, "chapter_id": 3098, "verse_number": "१३-२२८-५२", "content_sanskrit": "सर्वमर्थं श्रुतं दृष्टं यत्प्रागुक्तं मया तव।\nतदाप्रभृति मर्त्यानां श्रुतमाश्रित्य पण्डिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2098067, "chapter_id": 3098, "verse_number": "१३-२२८-५३", "content_sanskrit": "कामान्संछिद्य परिगान्धृत्या वै परमासिना।\nअभियान्त्येव ते स्वर्गं पश्यन्तः कर्मणः पलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2098068, "chapter_id": 3098, "verse_number": "१३-२२८-५४", "content_sanskrit": "एवं श्रद्धाफलं लोके परतः सुमहत्फलम्।\nबुद्धिः श्रद्धा च विनयः कारणानि हितैषिणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2098069, "chapter_id": 3098, "verse_number": "१३-२२८-५५", "content_sanskrit": "तस्मात्स्वर्गाभिगन्तारः कतिचित्त्वभवन्नराः।\nअन्ये करणहीनत्वान्नास्तिक्यं भावमाश्रिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2098070, "chapter_id": 3098, "verse_number": "१३-२२८-५६", "content_sanskrit": "श्रुतविद्वेषिणो मूर्खा नास्तिका दृढनिश्चयाः।\nनिष्क्रियास्तु निरन्नादाः पतन्त्येवाधमां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2098071, "chapter_id": 3098, "verse_number": "१३-२२८-५७", "content_sanskrit": "नास्त्यस्तीति पुनर्जन्म कवयोऽप्यत्र मोहिताः।\nनाधिगच्छन्ति तन्नित्यं हेतुवादशतैरपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2098072, "chapter_id": 3098, "verse_number": "१३-२२८-५८", "content_sanskrit": "एषा ब्रह्मकृता माया दुर्विज्ञेया सुरासुरैः।\nकिंपुनर्मानवैर्लोके ज्ञातुकामैः कुबुद्धिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2098073, "chapter_id": 3098, "verse_number": "१३-२२८-५९", "content_sanskrit": "केवलं श्रद्धया देवि श्रुतमात्मनिविष्टया।\nततोस्तीऽत्येव मन्तव्यं तथा हितमवाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2098074, "chapter_id": 3098, "verse_number": "१३-२२८-६०", "content_sanskrit": "दैवगुह्येषु चान्येषु हेतुर्देवि निरर्थकः।\nबधिरान्धवदेवात्र वर्तितव्यं हितैषिणा।\nएतत्ते कथितं देवि ऋषिगुह्यं प्रजाहितम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2098075, "chapter_id": 3098, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि अष्टाविंशत्यधिकद्विशततमोऽध्यायः॥ २२८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}]