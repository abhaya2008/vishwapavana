[{"id": 2014437, "chapter_id": 1298, "verse_number": "२-३९-१", "content_sanskrit": "वैशम्पायन उवाच॥\nततोऽभिषेचनीयेऽह्नि ब्राह्मणा राजभिः सह।\nअन्तर्वेदीं प्रविविशुः सत्कारार्हा महर्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2014438, "chapter_id": 1298, "verse_number": "२-३९-२", "content_sanskrit": "नारदप्रमुखास्तस्यामन्तर्वेद्यां महात्मनः।\nसमासीनाः शुशुभिरे सहराजर्षिभिस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2014439, "chapter_id": 1298, "verse_number": "२-३९-३", "content_sanskrit": "समेता ब्रह्मभवने देवा देवर्षयस्तथा।\nकर्मान्तरमुपासन्तो जजल्पुरमितौजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2014440, "chapter_id": 1298, "verse_number": "२-३९-४", "content_sanskrit": "एवमेतन्न चाप्येवमेवं चैतन्न चान्यथा।\nइत्यूचुर्बहवस्तत्र वितण्डां वै परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2014441, "chapter_id": 1298, "verse_number": "२-३९-५", "content_sanskrit": "कृशानर्थांस्ततः केचिदकृशांस्तत्र कुर्वते।\nअकृशांश्च कृशांश्चक्रुर्हेतुभिः शास्त्रनिश्चयैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2014442, "chapter_id": 1298, "verse_number": "२-३९-६", "content_sanskrit": "तत्र मेधाविनः केचिदर्थमन्यैरुदीरितम्।\nविचिक्षिपुर्यथा श्येना नभोगतमिवामिषम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2014443, "chapter_id": 1298, "verse_number": "२-३९-७", "content_sanskrit": "केचिद्धर्मार्थकुशलाः केचित्तत्र महाव्रताः।\nरेमिरे कथयन्तश्च सर्वभाष्यविदां वराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2014444, "chapter_id": 1298, "verse_number": "२-३९-८", "content_sanskrit": "सा वेदिर्वेदसम्पन्नैर्देवद्विजमहर्षिभिः।\nआबभासे समाकीर्णा नक्षत्रैर्द्यौरिवायता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2014445, "chapter_id": 1298, "verse_number": "२-३९-९", "content_sanskrit": "न तस्यां सन्निधौ शूद्रः कश्चिदासीन्न चाव्रती।\nअन्तर्वेद्यां तदा राजन्युधिष्ठिरनिवेशने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2014446, "chapter_id": 1298, "verse_number": "२-३९-१०", "content_sanskrit": "तां तु लक्ष्मीवतो लक्ष्मीं तदा यज्ञविधानजाम्।\nतुतोष नारदः पश्यन्धर्मराजस्य धीमतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2014447, "chapter_id": 1298, "verse_number": "२-३९-११", "content_sanskrit": "अथ चिन्तां समापेदे स मुनिर्मनुजाधिप।\nनारदस्तु तदा पश्यन्सर्वक्षत्रसमागमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2014448, "chapter_id": 1298, "verse_number": "२-३९-१२", "content_sanskrit": "सस्मार च पुरावृत्तां कथां तां पुरुषर्षभ।\nअंशावतरणे याऽसौ ब्रह्मणो भवनेऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2014449, "chapter_id": 1298, "verse_number": "२-३९-१३", "content_sanskrit": "देवानां सङ्गमं तं तु विज्ञाय कुरुनन्दन।\nनारदः पुण्डरीकाक्षं सस्मार मनसा हरिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2014450, "chapter_id": 1298, "verse_number": "२-३९-१४", "content_sanskrit": "साक्षात्स विबुधारिघ्नः क्षत्रे नारायणो विभुः।\nप्रतिज्ञां पालयंश्चेमां जातः परपुरञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2014451, "chapter_id": 1298, "verse_number": "२-३९-१५", "content_sanskrit": "सन्दिदेश पुरा योऽसौ विबुधान्भूतकृत्स्वयम्।\nअन्योन्यमभिनिघ्नन्तः पुनर्लोकानवाप्स्यथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2014452, "chapter_id": 1298, "verse_number": "२-३९-१६", "content_sanskrit": "इति नारायणः शम्भुर्भगवान्भूतभावनः।\nआदिश्य विबुधान्सर्वानजायत यदुक्षये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2014453, "chapter_id": 1298, "verse_number": "२-३९-१७", "content_sanskrit": "क्षितावन्धकवृष्णीनां वंशे वंशभृतां वरः।\nपरया शुशुभे लक्ष्म्या नक्षत्राणामिवोडुराट्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2014454, "chapter_id": 1298, "verse_number": "२-३९-१८", "content_sanskrit": "यस्य बाहुबलं सेन्द्राः सुराः सर्व उपासते।\nसोयं मानुषवन्नाम हरिरास्तेऽरिमर्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2014455, "chapter_id": 1298, "verse_number": "२-३९-१९", "content_sanskrit": "अहो बत महद्भूतं स्वयम्भूर्यदिदं स्वयम्।\nआदास्यति पुनः क्षत्रमेवं बलसमन्वितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2014456, "chapter_id": 1298, "verse_number": "२-३९-२०", "content_sanskrit": "इत्येतां नारदश्चिन्तां चिन्तयामास सर्ववित्।\nहरिं नारायणं ज्ञात्वा यज्ञैरीज्यं तमीश्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2014457, "chapter_id": 1298, "verse_number": "२-३९-२१", "content_sanskrit": "तस्मिन्धर्मविदां श्रेष्ठो धर्मराजस्य धीमतः।\nमहाध्वरे महाबुद्धिस्तस्थौ स बहुमानतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2014458, "chapter_id": 1298, "verse_number": "२-३९-२२", "content_sanskrit": "ततः समुदिता मुख्यैर्गुणैर्गुणवतां वराः।\nबहवो भावितात्मानः पृथक्पृथगरिन्दमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2014459, "chapter_id": 1298, "verse_number": "२-३९-२३", "content_sanskrit": "आत्मकृत्यमिति ज्ञात्वा पाञ्चालास्तत्र सर्वशः।\nसमीयुर्वृष्णयश्चैव तदाऽनीकाग्रहारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2014460, "chapter_id": 1298, "verse_number": "२-३९-२४", "content_sanskrit": "सदाराः सजनामात्या वहन्तो रत्नसञ्चयान्।\nविकृष्टत्वाच्च देशस्य गुरुभारतया च ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2014461, "chapter_id": 1298, "verse_number": "२-३९-२५", "content_sanskrit": "ययुः प्रमुदिताः पश्चाद्भगवन्तं समन्वयुः।\nबलशेषं समुदितं परिगृह्य समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2014462, "chapter_id": 1298, "verse_number": "२-३९-२६", "content_sanskrit": "अजश्चक्रायुधः शौरिरमित्रगणमर्दनः।\nबलाधिकारे निक्षिप्य संमान्यानकदुन्दुभिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2014463, "chapter_id": 1298, "verse_number": "२-३९-२७", "content_sanskrit": "सम्प्रायाद्यादवश्रेष्ठो जयमाने युधिष्ठिरे।\nउच्चावचमुपादाय धर्मराजाय माधवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2014464, "chapter_id": 1298, "verse_number": "२-३९-२८", "content_sanskrit": "धनौघं पुरतः कृत्वा खाण्डवप्रस्थमाययौ।\nतत्र यज्ञगतान्पश्यंश्चैद्यवर्गसमागतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2014465, "chapter_id": 1298, "verse_number": "२-३९-२९", "content_sanskrit": "भूमिपालगणान्सर्वान्सप्रभानिव तोयदान्।\nमेघकायान्निवसतो यूथपानिव यूथपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2014466, "chapter_id": 1298, "verse_number": "२-३९-३०", "content_sanskrit": "बलिनः सिंहसङ्काशान्महीमावृत्य तिष्ठतः।\nततो जनौघसम्बाधं राजसागरमव्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2014467, "chapter_id": 1298, "verse_number": "२-३९-३१", "content_sanskrit": "नादयन्रथघोषेण ह्युपायान्मधुसूदनः।\nअसूर्यमिव सूर्येण निवातमिव वायुना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2014468, "chapter_id": 1298, "verse_number": "२-३९-३२", "content_sanskrit": "कृष्णेन समुपेतेन जहर्षे भारतं पुरम्।\nब्राह्मणक्षत्रियाणां तु पूजार्थं ह्यर्थधर्मवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2014469, "chapter_id": 1298, "verse_number": "२-३९-३३", "content_sanskrit": "सहदेवो विशेषज्ञो माद्रीपुत्रः कृतोऽभवत्।\nभगवन्तं तु भूतानां भास्वन्तमिव तेजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2014470, "chapter_id": 1298, "verse_number": "२-३९-३४", "content_sanskrit": "विशन्तं यज्ञभूमिं तां सितस्यावरजं प्रभुम्।\nतेजोराशिमृषिं विप्रमदृश्यं वै विजानताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2014471, "chapter_id": 1298, "verse_number": "२-३९-३५", "content_sanskrit": "वयोधिकानां वृद्धानां मार्गमात्मनि तिष्ठताम्।\nजगतस्तस्थुषश्चैव प्रभवाप्ययमच्युतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2014472, "chapter_id": 1298, "verse_number": "२-३९-३६", "content_sanskrit": "अनन्तमन्तं शत्रूणाममित्रगणमर्दनम्।\nप्रभवं सर्वभूतानामापत्स्वभयमच्युतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2014473, "chapter_id": 1298, "verse_number": "२-३९-३७", "content_sanskrit": "भविष्यं भावनं भूतं द्वारवत्यामरिन्दमम्।\nस दृष्ट्वा कृष्णमायान्तं प्रतिपूज्यामितौजसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2014474, "chapter_id": 1298, "verse_number": "२-३९-३८", "content_sanskrit": "यथार्हं केशवे वृत्तिं प्रत्यपद्यत पाण्डवः।\nज्यैष्ठ्यकानिष्ठ्यसंयोगं सम्प्रधार्य गुणागुणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2014475, "chapter_id": 1298, "verse_number": "२-३९-३९", "content_sanskrit": "आरिराधयिषुर्धर्मः पूजयित्वा द्विजोत्तमान्।\nमहदादित्यसङ्काशमासनं च जगत्पतेः।\nददौ नासादितं कैश्चित्तस्मिन्नुपविवेश सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2014476, "chapter_id": 1298, "verse_number": "२-३९-४०", "content_sanskrit": "ततो भीष्मोऽब्रवीद्राजन्धर्मराजं युधिष्ठिरम्।\nक्रियतामर्हणं राज्ञां यथार्हमिति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2014477, "chapter_id": 1298, "verse_number": "२-३९-४१", "content_sanskrit": "आचार्यमृत्विजं चैव संयुजं च युधिष्ठिर।\nस्नातकं च प्रियं प्राहुः षडर्घार्हान्नृपं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2014478, "chapter_id": 1298, "verse_number": "२-३९-४२", "content_sanskrit": "एतानर्घ्यानभिगतानाहुः संवत्सरोषितान्।\nत इमे कालपूगस्य महतोऽस्मानुपागताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2014479, "chapter_id": 1298, "verse_number": "२-३९-४३", "content_sanskrit": "एषामेकैकशो राजन्नर्घ आनीयतामिति।\nअथ तैषां वरिष्ठाय समर्थायोपनीयताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2014480, "chapter_id": 1298, "verse_number": "२-३९-४४x", "content_sanskrit": "युधिष्ठिर उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2014481, "chapter_id": 1298, "verse_number": "२-३९-४४", "content_sanskrit": "कस्मै भवान्मन्यतेऽर्घमेकस्मै कुरुनन्दन।\nउपनीयमानं युक्तं च तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2014482, "chapter_id": 1298, "verse_number": "२-३९-४५x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2014483, "chapter_id": 1298, "verse_number": "२-३९-४५", "content_sanskrit": "ततो भीष्मः शान्तनवो बुद्ध्या निश्चित्य वीर्यवान्।\nवार्ष्णेयं मन्यते कृष्णमर्हणीयतमं भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2014484, "chapter_id": 1298, "verse_number": "२-३९-४६x", "content_sanskrit": "भीष्ण उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2014485, "chapter_id": 1298, "verse_number": "२-३९-४६", "content_sanskrit": "एष ह्येषां समस्तानां तेजोबलपराक्रमैः।\nमध्ये तपन्निवाभाति ज्योतिषामिव भास्करः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2014486, "chapter_id": 1298, "verse_number": "२-३९-४७", "content_sanskrit": "असूर्यमिव सूर्येण निर्वातमिव वायुना।\nभासितं ह्लादितं चैव कृष्णेनेदं सदो हि नः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2014487, "chapter_id": 1298, "verse_number": "२-३९-४८", "content_sanskrit": "तस्मै भीष्माभ्यनुज्ञातः सहदेवः प्रतापवान्।\nउपजह्रेऽथ विधिवद्वार्ष्णेयायार्घ्यमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2014488, "chapter_id": 1298, "verse_number": "२-३९-४९", "content_sanskrit": "गामर्घ्यं मधुपर्कं च ह्यानीयोपाहरत्तदा।\nएतस्मिन्नन्तरे राजन्निदमासीत्तदाऽद्भुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2014489, "chapter_id": 1298, "verse_number": "२-३९-५०", "content_sanskrit": "तां दृष्ट्वा क्षत्रियाः सर्वे पूजां कृष्णस्य भूयसीम्।\nसम्प्रेक्ष्यान्योन्यमासीना हृदयैस्तामधारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2014490, "chapter_id": 1298, "verse_number": "२-३९-५१", "content_sanskrit": "प्रतिजग्राह तां कृष्णः शास्त्रदृष्टेन कर्मणा।\nशिशुपालस्तु तां पूजां वासुदेवे न चक्षमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2014491, "chapter_id": 1298, "verse_number": "२-३९-५२", "content_sanskrit": "उपालभ्य स भीष्मं च धर्मराजं च संसदि।\nअवाक्षिपद्वासुदेवं चेदिराजो महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2014492, "chapter_id": 1298, "verse_number": "२-३९-५३", "content_sanskrit": "तेषामाकारभावज्ञः सहदेवो न चक्षमे।\nमानिनां बलिनां राज्ञां पुरुः सन्दर्शिते पदे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2014493, "chapter_id": 1298, "verse_number": "२-३९-५४", "content_sanskrit": "पुष्पवृष्टिर्महत्यासीत्सहदेवस्य मूर्धनि।\nजन्मप्रभृति वृष्णीना सुनीथः शत्रुरब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2014494, "chapter_id": 1298, "verse_number": "२-३९-५५", "content_sanskrit": "प्रष्टा वियोनिजो राजा प्रतिवक्ता नदीसुतः।\nप्रतिग्रहीता गोपालः प्रदाता च वियोनिजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2014495, "chapter_id": 1298, "verse_number": "२-३९-५६", "content_sanskrit": "सदस्या मूकवत्सर्वे आसतेऽत्र किमुच्यते।\nइत्युक्त्वा स विहस्याशु पाण्डुं पुनरब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2014496, "chapter_id": 1298, "verse_number": "२-३९-५७", "content_sanskrit": "अतिपश्यसि वा सर्वान्न वा पश्यसि पाण्डव।\nतिष्ठत्स्वन्येषु पूज्येषु गोपमर्चितवानसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2014497, "chapter_id": 1298, "verse_number": "२-३९-५८", "content_sanskrit": "एते चैवोभये तात कार्यस्य तु विनाशके।\nअतिदृष्टिरदृष्टिर्वा तयोः किं त्वं समास्थितः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2014498, "chapter_id": 1298, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि दिग्विजयपर्वणि एकोनचत्वारिंशोऽध्यायः॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}]