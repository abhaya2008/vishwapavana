[{"id": 7006281000, "chapter_id": 26281, "verse_number": "३-३५-१", "content_sanskrit": "हयग्रीव उवाच अथ वापीत्र यादीनां कक्ष्याभेदान्प्रचक्ष्महे ।\nएषां श्रवणमात्रेण जायते श्रीमहोदयः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006281001, "chapter_id": 26281, "verse_number": "३-३५-२", "content_sanskrit": "सहस्रस्तम्भशालस्यातरमारुतयोजने ।\nमनो नाम महाशालः सर्वरत्नविचित्रितः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006281002, "chapter_id": 26281, "verse_number": "३-३५-३", "content_sanskrit": "पूर्ववद्गोपुरद्वारकपाटार्गलसंयुतः ।\nतन्मध्यकक्ष्याभागस्तु सर्वाप्यमृतवापिका ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006281003, "chapter_id": 26281, "verse_number": "३-३५-४", "content_sanskrit": "यत्पीत्वा योगिनः सिद्धा वज्रकाया महाबलाः ।\nभवन्ति पुरुषाः प्राज्ञास्तदेव हि रसायनम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006281004, "chapter_id": 26281, "verse_number": "३-३५-५", "content_sanskrit": "वाप्याममृतमय्यां तु वर्तते तोयतां गतम् ।\nतद्गन्धाघ्राणमात्रेण सिद्धिकान्तापतिर्भवेत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006281005, "chapter_id": 26281, "verse_number": "३-३५-६", "content_sanskrit": "अस्पृशन्नपि विन्धयारे पुरुषः क्षीणकल्मषः ।\nउभयोः शालयोः पार्श्वे सुधावापीतटद्वये ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006281006, "chapter_id": 26281, "verse_number": "३-३५-७", "content_sanskrit": "अधक्रोशसमायामा अन्यास्सर्वाश्च वापिकाः ।\nचतुर्योजनदूरं तु तलं तस्या जलान्तरे ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006281007, "chapter_id": 26281, "verse_number": "३-३५-८", "content_sanskrit": "सोपानावलयस्तस्या नानारत्नविचित्रिताः ।\nस्वर्णवर्णा रत्नवर्णास्तस्यां हंसाश्च सारसाः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006281008, "chapter_id": 26281, "verse_number": "३-३५-९", "content_sanskrit": "आस्फोट्यते तटद्वन्द्वतरङ्गैर्मन्दचञ्चलैः ।\nपक्षिणस्तज्जलं पीत्वा रसायनमयं नवम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006281009, "chapter_id": 26281, "verse_number": "३-३५-१०", "content_sanskrit": "अजरामरतां प्राप्तास्तत्र विन्ध्यनिषूदन ।\nसदाकूजितलक्षेण तत्र कारण्डवद्विजाः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006281010, "chapter_id": 26281, "verse_number": "३-३५-११", "content_sanskrit": "जपन्ति ललितादेव्या मन्त्रमेव महत्तरम् ।\nपरितो वापिकाचक्रपरिवेषणभूयसा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006281011, "chapter_id": 26281, "verse_number": "३-३५-१२", "content_sanskrit": "न तत्र गन्तु मार्गोऽस्ति नौकावाहनमन्तरा ।\nआज्ञया केवलं तत्र मन्त्रिणी दण्डनाथयोः ।\nतारा नाम महाशक्तिर्वर्तते तोरणेश्वरी ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006281012, "chapter_id": 26281, "verse_number": "३-३५-१३", "content_sanskrit": "बह्व्यस्तत्रोत्पलश्यामास्तारायाः परिचारिकाः ।\nरत्ननौकासहस्रेण खेलन्त्यो सरसीजले ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006281013, "chapter_id": 26281, "verse_number": "३-३५-१४", "content_sanskrit": "अपरं पारमायान्ति पुनर्यान्ति परं तटम् ।\nवीणावेणुमृदङ्गादि वादयन्त्यो मुहुर्मुहुः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006281014, "chapter_id": 26281, "verse_number": "३-३५-१५", "content_sanskrit": "कोटिशस्तत्र ताराया नाविक्यो नवयौवनाः ।\nमुहुर्गायन्ति नृत्यन्ति देव्याः पुण्यतमं यशः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006281015, "chapter_id": 26281, "verse_number": "३-३५-१६", "content_sanskrit": "अरित्रपाणयः काश्चित्काश्चिच्छूगाम्बुपाणयः ।\nपिबन्त्यस्तत्सुधातोयं संचरन्त्यस्तरीशतैः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006281016, "chapter_id": 26281, "verse_number": "३-३५-१७", "content_sanskrit": "तासां नौकावाहिकानां शक्तीनां श्यामलत्विषाम् ।\nप्रधानभूता तारांबा जलौघशमनक्षमा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006281017, "chapter_id": 26281, "verse_number": "३-३५-१८", "content_sanskrit": "आज्ञां विना तयोस्तारा मन्त्रिणीदण्डधारयोः ।\nत्रिनेत्रस्यापि नो दत्ते वापिकांभसि सन्तरम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006281018, "chapter_id": 26281, "verse_number": "३-३५-१९", "content_sanskrit": "गायन्तीनां चलन्तीनां नौकाभिर्मणिचारुभिः ।\nमहाराज्ञी महौदार्यं पतन्तीनां पदेपदे ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006281019, "chapter_id": 26281, "verse_number": "३-३५-२०", "content_sanskrit": "पिबन्तीनां मधु भृशं माणिक्यचषकोदरैः ।\nप्रतिनौकं मणिगृहे वसन्तीनां मनोहरे ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006281020, "chapter_id": 26281, "verse_number": "३-३५-२१", "content_sanskrit": "तारातरणिशक्तीनां समवायोऽतिसुन्दरः ।\nकाश्चिन्नौकाः सुवर्णाढ्याः काश्चिद्रत्नकृता मुने ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006281021, "chapter_id": 26281, "verse_number": "३-३५-२२", "content_sanskrit": "मकराकारमापन्नाः काश्चिन्नौका मृगाननाः ।\nकाश्चित्सिंहासना नावः काश्चिद्दन्तावलाननाः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006281022, "chapter_id": 26281, "verse_number": "३-३५-२३", "content_sanskrit": "इत्थं विचित्ररूपाभिर्नौङ्काभिः परिवेष्टिता ।\nतारांबामहतीं नौकामधिगम्य विराजते ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006281023, "chapter_id": 26281, "verse_number": "३-३५-२४", "content_sanskrit": "अनुलोमविलोमाभ्यां सञ्चारं वापिकाजले ।\nतन्वाना सततं तारा कक्ष्यामेनां हि रक्षति ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006281024, "chapter_id": 26281, "verse_number": "३-३५-२५", "content_sanskrit": "मनशालस्यान्तराले सप्तयोजनदूरतः ।\nबुद्धिशाल इति ख्यातश्चतुर्योजनमुच्छ्रितः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006281025, "chapter_id": 26281, "verse_number": "३-३५-२६", "content_sanskrit": "तन्मध्यकक्ष्याभागेऽस्ति सर्वाप्यानन्दवापिका ।\nतत्र दिव्यं महामद्यं बकुलामोदमेदुरम् ।\nप्रतप्तकनकच्छायं तज्जलत्वेन वर्त्तते ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006281026, "chapter_id": 26281, "verse_number": "३-३५-२७", "content_sanskrit": "आनन्दवापिकागाधाः पूर्ववत्परिकीर्त्तिताः ।\nसोपानादिक्रमश्चैव पक्षिणास्तत्र पूर्ववत् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006281027, "chapter_id": 26281, "verse_number": "३-३५-२८", "content_sanskrit": "तत्रत्यं सलिलं मद्यं पायम्पायं तटस्थिताः ।\nविहरन्ति मदोन्मत्ताः शक्तयो मदपाटलाः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006281028, "chapter_id": 26281, "verse_number": "३-३५-२९", "content_sanskrit": "साक्षाच्च वारुणी देवी तत्र नौकाधिनायिका ।\nयां सुधामालिनीमाहुर्यामा हुरमृतेश्वरीम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006281029, "chapter_id": 26281, "verse_number": "३-३५-३०", "content_sanskrit": "सा तत्र मणिनौकास्थशक्तिसेनासमावृता ।\nईषदालोकमात्रेण त्रैलोक्यमददायिनी ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006281030, "chapter_id": 26281, "verse_number": "३-३५-३१", "content_sanskrit": "तरुणादित्य सङ्काश मदारक्तकपोलभूः ।\nपारिजातप्रसूनस्रक्परिवीतकचाचिता ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006281031, "chapter_id": 26281, "verse_number": "३-३५-३२", "content_sanskrit": "वहन्ती मदिरापूर्णं चषकं लोलदुत्पलम् ।\nपक्वं पिशितखण्डं च मणिपात्रे तथान्यके ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006281032, "chapter_id": 26281, "verse_number": "३-३५-३३", "content_sanskrit": "वारुणीतरणिश्रेणीनायिका तत्र राजते ।\nसाप्याज्ञयैव सर्वेषां मन्त्रिणीदण्डनाथयोः ।\nददाति वापीतरणं त्रिनेत्रस्यापि नान्यथा ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006281033, "chapter_id": 26281, "verse_number": "३-३५-३४", "content_sanskrit": "अथ बुद्धिमहाशालान्तरे मारुतयोजने ।\nअहङ्कारमहाशालः पूर्ववद्गोपुरान्वितः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006281034, "chapter_id": 26281, "verse_number": "३-३५-३५", "content_sanskrit": "तयोस्तु शालयोर्मध्ये कक्ष्याभूरखिला मुने ।\nविमर्शवापिका नाम सौषुम्णामृतरूपिणी ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006281035, "chapter_id": 26281, "verse_number": "३-३५-३६", "content_sanskrit": "तन्महायोगिनामन्तर्मनो मारुतपूरितम् ।\nसुषुम्णदण्डविवरे जागर्ति परमामृतम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006281036, "chapter_id": 26281, "verse_number": "३-३५-३७", "content_sanskrit": "तदेव तस्याः सलिलं वापिकायास्तपोधन ।\nपूर्ववत्तटसोपानपक्षिनौका हि ताः स्मृताः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006281037, "chapter_id": 26281, "verse_number": "३-३५-३८", "content_sanskrit": "तत्र नौकेश्वरी देवी क्लरुकुल्लेतिविश्रुता ।\nतमालश्यामलाकारा श्यामकञ्चुकधारिणी ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006281038, "chapter_id": 26281, "verse_number": "३-३५-३९", "content_sanskrit": "नौकेश्वरीभिरन्याभिस्स्वसमानाभिरावृता ।\nरत्नारित्रकरा नित्यमुल्लसन्मदमांसला ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006281039, "chapter_id": 26281, "verse_number": "३-३५-४०", "content_sanskrit": "परितो भ्राम्यति मुने मणिनौकाधिरोहिणी ।\nवापिका पयसागाधा पूर्ववत्परिकीर्तिता ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006281040, "chapter_id": 26281, "verse_number": "३-३५-४१", "content_sanskrit": "अहङ्कारस्य शालस्यान्तरे मारुतयोजने ।\nसूर्यबिंबमहाशालश्चतुर्योजन मुच्छ्रितः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006281041, "chapter_id": 26281, "verse_number": "३-३५-४२", "content_sanskrit": "सूर्यस्यापि महानासीद्यदभूदरुणोदयः ।\nतन्मध्यकक्ष्या वसुधा खचिता कुरविन्दकैः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006281042, "chapter_id": 26281, "verse_number": "३-३५-४३", "content_sanskrit": "तत्र बालातपोद्गारे ललिता परमेश्वरी ।\nअतितीव्रतपस्तप्त्वा सूर्योऽलभत तां द्युतिम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006281043, "chapter_id": 26281, "verse_number": "३-३५-४४", "content_sanskrit": "ग्रहराशिगणाः सर्वे नक्षत्राण्यपि तारकाः ।\nतेऽत्रेव हि तपस्तप्त्वा लोकभासकतां गताः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006281044, "chapter_id": 26281, "verse_number": "३-३५-४५", "content_sanskrit": "मार्तण्डभैरवस्तत्र भिन्नो द्वादशधा मुने ।\nशक्तिभिस्तैजसीभिश्च कोटिसंख्याभिरन्वितः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006281045, "chapter_id": 26281, "verse_number": "३-३५-४६", "content_sanskrit": "महाप्रकाशरूपश्च मदारुणविलोचनः ।\nकङ्कोलितरुखण्डेषु नित्यं क्रीडारसोत्सुकः ।\nवर्तते विन्ध्यदर्पारे पारे यस्तन्मयस्थितः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006281046, "chapter_id": 26281, "verse_number": "३-३५-४७", "content_sanskrit": "महाप्रकाशनाम्रास्ति तस्य शक्तिर्महीयसी ।\nचक्षुष्मत्यपराशक्तिश्छाया देवी परा स्मृता ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006281047, "chapter_id": 26281, "verse_number": "३-३५-४८", "content_sanskrit": "इत्थं तिसृभि रिष्टाभिः शक्तिभिः परिवारितः ।\nललिताया महेशान्याः सदा विद्या हृदा जपन् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006281048, "chapter_id": 26281, "verse_number": "३-३५-४९", "content_sanskrit": "तद्भक्तानामिन्द्रियाणि भास्वराणि प्रकाशयन् ।\nबहिरन्तस्तमोजालं समूलमवमर्दयन् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006281049, "chapter_id": 26281, "verse_number": "३-३५-५०", "content_sanskrit": "तत्र बालातपोद्गारे भाति मार्तण्डभैरवः ।\nसूर्यबिम्बमहाशालान्तरे मारुतयोजने ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006281050, "chapter_id": 26281, "verse_number": "३-३५-५१", "content_sanskrit": "चन्द्रबिम्बमयः शालश्चतुर्योजनमुच्छ्रितः ।\nपूर्ववद्गोपुरद्वारकपाटार्गलसंयुतः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006281051, "chapter_id": 26281, "verse_number": "३-३५-५२", "content_sanskrit": "तन्मध्यभूः समस्तापि चन्द्रिकाद्वारमुच्यते ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006281052, "chapter_id": 26281, "verse_number": "३-३५-५३", "content_sanskrit": "तत्रैव चन्द्रिकाद्वारे तपस्तप्त्वा सुदारुणम् ।\nअत्रिनेत्रसमुत्पन्नश्चन्द्रमाः कान्तिमाययौ ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006281053, "chapter_id": 26281, "verse_number": "३-३५-५४", "content_sanskrit": "अत्र श्रीसोमनाथाख्यो वर्तते निर्मलाकृतिः ।\nदेवस्त्रलोक्यतिमिरध्वंसी संसारवर्तकः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006281054, "chapter_id": 26281, "verse_number": "३-३५-५५", "content_sanskrit": "पिबञ्च षकसम्पूर्णं निर्मलं चन्द्रिकामृतम् ।\nसप्तविंशतिनक्षत्रशक्तिभिः परिवारितः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006281055, "chapter_id": 26281, "verse_number": "३-३५-५६", "content_sanskrit": "सदा पूर्णनिजाकारो निष्कलङ्को निजाकृतिः ।\nतत्रैव चन्द्रिकाद्वारे वर्तते भगवाञ्छशी ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006281056, "chapter_id": 26281, "verse_number": "३-३५-५७", "content_sanskrit": "ललिताया जपैध्यानैः स्तोत्रैः पूजाशतैरपि ।\nअश्विन्यादियुतस्तत्र कालं नयति चन्द्रमाः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006281057, "chapter_id": 26281, "verse_number": "३-३५-५८", "content_sanskrit": "अन्याश्च शक्तयस्तारानामधेयाः सहस्रशः ।\nसन्ति तस्यैव निकटे सा कक्षा तत्प्र पूरिता ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006281058, "chapter_id": 26281, "verse_number": "३-३५-५९", "content_sanskrit": "अथ चन्द्रस्य शालस्यान्तरे मारुतयोजने ।\nशृङ्गारो नाम शालोऽस्ति चतुर्योजनमुच्छ्रितः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006281059, "chapter_id": 26281, "verse_number": "३-३५-६०", "content_sanskrit": "शृङ्गारागाररूपैस्तु कौस्तुभैरिव निर्मितः ।\nमहाशृङ्गारपरिखा तन्मध्ये वसुधाखिला ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006281060, "chapter_id": 26281, "verse_number": "३-३५-६१", "content_sanskrit": "परिखावलये तत्र शृङ्गाररसपूरिते ।\nशृङ्गारशक्तयः सन्ति नानाभूषणभासुराः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006281061, "chapter_id": 26281, "verse_number": "३-३५-६२", "content_sanskrit": "तत्र नौकासहस्रेण संचरन्त्यो मदोद्धताः ।\nउपासते सदा सत्तं नौकास्थं कुसुमायुधम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006281062, "chapter_id": 26281, "verse_number": "३-३५-६३", "content_sanskrit": "स तु संमोहयत्येव विश्वं सम्मोहनादिभिः ।\nविशिखैरखिलांल्लोकांल्ललिताज्ञावशंवदः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006281063, "chapter_id": 26281, "verse_number": "३-३५-६४", "content_sanskrit": "तत्प्रभावेण संमूढा महापद्माटवीस्थलम् ।\nवनितुं शुद्धवेषाश्च ललिताभक्तिनिर्भराः ।\nसावधानेन मनसा यान्ति पद्माटदीस्थलम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006281064, "chapter_id": 26281, "verse_number": "३-३५-६५", "content_sanskrit": "न गन्तुं पारयत्येव सुरसिद्धनराः सुराः ।\nब्रह्मविष्णुमहेशास्तु शुद्धचित्ताः स्वभावतः ।\nतदाज्ञया परं यान्ति महापद्माटवीस्थलम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006281065, "chapter_id": 26281, "verse_number": "३-३५-६६", "content_sanskrit": "संसारिणश्च रागान्धाबहुसंकल्पकल्पनाः ।\nमहाकुलाश्च पुरुषा विकल्पज्ञानधूसराः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006281066, "chapter_id": 26281, "verse_number": "३-३५-६७", "content_sanskrit": "प्रभूतरागगहनाः प्रौढव्यामोहदायिनीम् ।\nमहाशृङ्गारपरिखान्तरितुं न विचक्षणाः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006281067, "chapter_id": 26281, "verse_number": "३-३५-६८", "content_sanskrit": "यस्मादजेयसैन्दर्यस्त्रैलोक्यजनमोहनः ।\nमहाशृङ्गारपरिखाधिकारी वर्तते स्मरः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006281068, "chapter_id": 26281, "verse_number": "३-३५-६९", "content_sanskrit": "तस्य सर्वमतिक्रम्य महतामपि मोहनम् ।\nमहापद्माटवीं गन्तुं न कोऽपि भवति क्षमः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006281069, "chapter_id": 26281, "verse_number": "३-३५-७०", "content_sanskrit": "अथ शृङ्गारशालस्यान्तराले सप्तयोजने ।\nचिन्तामणिगृहं नाम चक्रराजमहालयः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006281070, "chapter_id": 26281, "verse_number": "३-३५-७१", "content_sanskrit": "तन्मध्यभूः समस्तापि परितो रत्नभूषिता ।\nमहापद्माटवी नाम सर्वसौभाग्यदायिनी ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006281071, "chapter_id": 26281, "verse_number": "३-३५-७२", "content_sanskrit": "शृङ्गाराख्यामहाकालपर्यन्तं गोपुरं मुने ।\nचतुर्दिक्ष्वप्येवमेव गोपुराणां व्यवस्थितिः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006281072, "chapter_id": 26281, "verse_number": "३-३५-७३", "content_sanskrit": "सर्वदिक्षु तदुक्तानि गोपुराणिशत मुने ।\nशालास्तु विंशतिः प्रोक्ताः पञ्चसंख्याधिकाः शुभाः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006281073, "chapter_id": 26281, "verse_number": "३-३५-७४", "content_sanskrit": "सर्वेषामपि शालानां मूलं योजनसंमितम् ।\nपद्माटवीस्थलं वक्ष्ये सावधानो मुने शृणु ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006281074, "chapter_id": 26281, "verse_number": "३-३५-७५", "content_sanskrit": "समस्तरत्नखचिते तत्र षड्योजनान्तरे ।\nपरितस्थलपद्मानि महाकाण्डानि संति वै ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006281075, "chapter_id": 26281, "verse_number": "३-३५-७६", "content_sanskrit": "काण्डास्तु योजनायामा मृदुभिः कण्टकैर्वृताः ।\nपत्राणि तालदशकमात्रायामानि संति वै ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7006281076, "chapter_id": 26281, "verse_number": "३-३५-७७", "content_sanskrit": "केसराश्च सरोजानां पञ्चतालसमायताः ।\nदशतालसमुन्नम्रः कर्णिकाः परिकीर्तिताः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7006281077, "chapter_id": 26281, "verse_number": "३-३५-७८", "content_sanskrit": "अत्यन्तकोमलान्यत्र सदा विकसितानि च ।\nनवसौरभहृद्यानि विशङ्कटदलानि च ।\nबहुशः संति पद्मानि कोडीनामपि कोडिशः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7006281078, "chapter_id": 26281, "verse_number": "३-३५-७९", "content_sanskrit": "महापद्माडवीकक्ष्यापूर्वभागे घटोद्भव ।\nक्रोशोन्नतो वह्निरूपो वर्तुलाकारसंस्थितः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7006281079, "chapter_id": 26281, "verse_number": "३-३५-८०", "content_sanskrit": "अर्द्धयोजनविस्तारः कलाभिर्दशभिर्युतः ।\nअर्घ्यपात्रमहाधारो वर्तते कुम्भसम्भव ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7006281080, "chapter_id": 26281, "verse_number": "३-३५-८१", "content_sanskrit": "तदाधारस्य परितः शक्तयोदीप्तविग्रहाः ।\nधूम्रार्चिःप्रमुखा भान्ति कला दश विभावसोः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7006281081, "chapter_id": 26281, "verse_number": "३-३५-८२", "content_sanskrit": "दीप्ततारुण्यलक्ष्मीका नानालङ्कारभूषिताः ।\nआधाररूपं श्रीमन्तं भगवन्तं हविर्भुजम् ।\nपरिष्वज्यैव परितो वर्तन्ते मन्मथालसाः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7006281082, "chapter_id": 26281, "verse_number": "३-३५-८३", "content_sanskrit": "धूम्रार्चिरुष्णा ज्वलिनी ज्वालिनी विस्फुलिङ्गिनी ।\nसुश्रीःसुरूपा कपिला हव्यकव्यवहेतिच ।\nएता दशकलाः प्रोक्ता वह्नेराधाररूपिणः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7006281083, "chapter_id": 26281, "verse_number": "३-३५-८४", "content_sanskrit": "तत्राधारे स्थितो देवः पात्ररूपं समाश्रितः ।\nसूर्यस्त्रिलोकीतिमिरप्रध्वंसप्रथितोदयः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7006281084, "chapter_id": 26281, "verse_number": "३-३५-८५", "content_sanskrit": "सूर्यात्मकं तु तत्पात्रं सार्द्धयोजनमुन्नतम् ।\nयोजनायामविस्तारं महाज्योतिः प्रकाशितम् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7006281085, "chapter_id": 26281, "verse_number": "३-३५-८६", "content_sanskrit": "तत्पात्रात्परितः सक्तवपुषः पुत्रिका इव ।\nवर्तन्ते द्वादश कला अतिभास्वररोचिषः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7006281086, "chapter_id": 26281, "verse_number": "३-३५-८७", "content_sanskrit": "तपिनी तापिनी धूम्रा मरीचिर्ज्वलिनी रुचिः ।\nसुषुम्णा भोगदा विश्वा बोधिनी धारिणी क्षमा ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7006281087, "chapter_id": 26281, "verse_number": "३-३५-८८", "content_sanskrit": "तस्मिन्पात्रे परानन्दकारणं परमामृतम् ।\nसर्वौंषधि रसाढ्यं च हृद्यसौरभसंयुतम् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7006281088, "chapter_id": 26281, "verse_number": "३-३५-८९", "content_sanskrit": "नीलोत्पलैश्च कह्लारैरम्लानैरतिसौरभैः ।\nवास्यमानं सदा हृद्यं शीतलं लघु निर्मलम् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7006281089, "chapter_id": 26281, "verse_number": "३-३५-९०", "content_sanskrit": "चलद्वीचिशतोदारं ललिताब्यर्चनोचितम् ।\nसदा शब्दायमानं च भासतेर्ऽचनकारणम् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7006281090, "chapter_id": 26281, "verse_number": "३-३५-९१", "content_sanskrit": "तदर्घ्यममृतं प्रोक्तं निशाकरकलामयम् ।\nतस्मिंस्तनीयसीर्नौङ्का मणिकॢप्ताः समास्थिताः ।\nनिशाकरकला हृद्याः क्रीडन्ति नवयौवनाः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7006281091, "chapter_id": 26281, "verse_number": "३-३५-९२", "content_sanskrit": "अमृता मानदा पूष्णा तुष्टिः पुष्टी रतिर्धृतिः ।\nशशिनी चन्द्रिका कान्तिर्ज्योत्स्ना श्रीः प्रीतिरङ्गदा ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7006281092, "chapter_id": 26281, "verse_number": "३-३५-९३", "content_sanskrit": "पूर्णा पूर्णामृता चेति कलाः पीयूष रोचिषः ।\nनवयौवनसंपूर्णाः सदा प्रहसिताननाः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7006281093, "chapter_id": 26281, "verse_number": "३-३५-९४", "content_sanskrit": "पुष्टिरृद्धिः स्थितिर्मेधा कान्तिर्लक्ष्मीर्द्युतिर्धृतिः ।\nजरा सिद्धिरिति प्रोक्ताः क्रीडन्ति ब्रह्मणः कलाः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7006281094, "chapter_id": 26281, "verse_number": "३-३५-९५", "content_sanskrit": "स्थितिश्च पालिनी शान्तिश्चेश्वरी ततिकामिके ।\nवरदाह्लादिनी प्रीतिर्दीर्घा चेति हरेः कलाः ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7006281095, "chapter_id": 26281, "verse_number": "३-३५-९६", "content_sanskrit": "तीक्ष्णा रौद्री भया निद्रा तन्द्रा क्षुत्क्रोधिनी त्रपा ।\nउत्कारी मृत्युरप्येता रोद्ध्र्यस्तत्र स्थिताः कालाः ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7006281096, "chapter_id": 26281, "verse_number": "३-३५-९७", "content_sanskrit": "ईश्वरस्य कलाः पीताः श्वेताश्चैवारुणाः सिताः ।\nचतस्रेव प्रोक्तास्तु शङ्करस्य कला अथ ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7006281097, "chapter_id": 26281, "verse_number": "३-३५-९८", "content_sanskrit": "निवृत्तिश्च प्रतिष्ठा च त्रिद्या शान्तिस्तथैव च ।\nइन्दिरा दीपिका चैव रेचिका चैव मोचिका ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7006281098, "chapter_id": 26281, "verse_number": "३-३५-९९", "content_sanskrit": "परा सूक्ष्मा च विन्ध्यारे तथा सूक्ष्मामृता कला ।\nज्ञानामृता व्याधिनी च व्यापिनी व्योमरूपिका ।\nएतां षोडश संप्रोक्तास्तत्र क्रीडन्ति शक्तयः ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7006281099, "chapter_id": 26281, "verse_number": "३-३५-१००", "content_sanskrit": "रुद्रनौकासमारूढास्ततश्चेतश्च चञ्चलाः ।\nशक्तिरुपेण खेलन्ति तत्र विद्याः सहस्रशः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7006281100, "chapter_id": 26281, "verse_number": "३-३५-१०१", "content_sanskrit": "अर्घ्यसंशोधनार्थाय कल्पिताः परमेष्ठिना ।\nतदर्घ्यममृतं पीत्वा सदा माद्यन्ति शक्तयः ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7006281101, "chapter_id": 26281, "verse_number": "३-३५-१०२", "content_sanskrit": "महापद्माटवीवासा महाचक्रस्थिता अपि ।\nमुहुर्मुहुर्नवनवं मुहुस्चाबद्धसौरभम् ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7006281102, "chapter_id": 26281, "verse_number": "३-३५-१०३", "content_sanskrit": "रत्नकुम्भसहस्रैश्च सुवर्णघटकोटिभिः ।\nआपूर्यापूर्य सततं तदर्घ्यममृतं महत् ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7006281103, "chapter_id": 26281, "verse_number": "३-३५-१०४", "content_sanskrit": "चिन्तामणिगृहस्थानां परिचारकशक्तयः ।\nअणिमादिकशक्तीनामर्घ्ययन्ति मदोद्धताः ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7006281104, "chapter_id": 26281, "verse_number": "३-३५-१०५", "content_sanskrit": "महापद्माटवीकक्ष्यापूर्वभागेर्ऽघ्यकल्पनम् ।\nइत्थ समीरितं पश्चात्तत्रान्यदपि कथ्यते ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}]