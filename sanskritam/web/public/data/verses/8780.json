[{"id": 900010185, "chapter_id": 8780, "verse_number": "1.1", "content_sanskrit": "रामं दिग्विजयं सुनिर्मलतनुं विभ्राजमानं सदा ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900010186, "chapter_id": 8780, "verse_number": "1.2", "content_sanskrit": "न तावद् द्रव्याद्रव्यविभागो युक्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900010187, "chapter_id": 8780, "verse_number": "1.3", "content_sanskrit": "द्रव्यं षड्विधमित्ययुक्तम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900010188, "chapter_id": 8780, "verse_number": "1.4", "content_sanskrit": "अव्याकृताकाशस्य द्रव्यान्तरस्य सत्त्वादुक्तसंख्याऽयोगः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900010189, "chapter_id": 8780, "verse_number": "1.5", "content_sanskrit": "अन्धकारस्य न पृथिव्यामन्तर्भावः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900010190, "chapter_id": 8780, "verse_number": "1.6", "content_sanskrit": "अखण्डः कालो नाभ्युपेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900010191, "chapter_id": 8780, "verse_number": "1.7", "content_sanskrit": "तस्य प्राकृतत्वेन द्रव्यान्तरत्वायोगः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900010192, "chapter_id": 8780, "verse_number": "1.8", "content_sanskrit": "तस्य प्राकृतत्वेन द्रव्यान्तरत्वायोगः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900010193, "chapter_id": 8780, "verse_number": "1.9", "content_sanskrit": "नित्यविभूतिरूपं अण्डाद्बहिर्भूतमप्रमाणकं देशमात्रस्य मूलप्रकृतिव्याप्तत्वात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900010194, "chapter_id": 8780, "verse_number": "1.10", "content_sanskrit": "सत्त्वं खल्वीरितं विषमत्वं प्रयाति ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900010195, "chapter_id": 8780, "verse_number": "1.11", "content_sanskrit": "उपादेयमुपादानातिरिक्तम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900010196, "chapter_id": 8780, "verse_number": "1.12", "content_sanskrit": "ब्रह्म न जगदुपादानं निर्विकारत्वात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900010197, "chapter_id": 8780, "verse_number": "1.13", "content_sanskrit": "किं च भक्तिः प्रपत्तिश्चेति मोक्षसाधनं द्विविधमित्यनुपपन्नम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900010198, "chapter_id": 8780, "verse_number": "1.14", "content_sanskrit": "किं च ब्रह्मानन्दानुभवो मोक्ष इत्यनुपपन्नम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900010199, "chapter_id": 8780, "verse_number": "1.15", "content_sanskrit": "'देवादयो मानुषादिभ्योऽधिकमौत्तफलभाजः तदपेक्षयाऽ-धिकतत्साधनवत्त्वात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900010200, "chapter_id": 8780, "verse_number": "1.16", "content_sanskrit": "मम साधर्म्यमागताः । सर्गेऽपि नोपजायन्ते प्रलये न व्यथन्ति च", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900010201, "chapter_id": 8780, "verse_number": "1.17", "content_sanskrit": "तदेवं श्रुतिस्मृतियुक्तिज्ञानिप्रत्यक्षैः प्रमितस्य ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900010202, "chapter_id": 8780, "verse_number": "1.18", "content_sanskrit": "एतेन सांशजीवानां देवादीनां सांशत्वादेव संसार इव मुक्ता-वप्यधिक्य ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900010203, "chapter_id": 8780, "verse_number": "1.19", "content_sanskrit": "'तन्तवः पटः' ‘शुक्लः पटः' इत्याद्यभेदव्यवहारयोग्यता..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 900010204, "chapter_id": 8780, "verse_number": "1.20", "content_sanskrit": "यदप्युक्तम्, ‘पटोपलम्भेऽपि शौक्ल्याद्यनुपलम्भान्यथाऽनुपपत्त्या विशेषसिद्धिरिति तन्न", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 900010205, "chapter_id": 8780, "verse_number": "1.21", "content_sanskrit": "यदप्युक्तम्, ‘पटोपलम्भेऽपि शौक्ल्याद्यनुपलम्भान्यथाऽनुपपत्त्या विशेषसिद्धिरिति तन्न", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 900010206, "chapter_id": 8780, "verse_number": "1.22", "content_sanskrit": "यच्चोक्तं ‘एवं धर्मान् पृथक् पश्यन्निति श्रौतार्थापत्तिरपि..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 900010207, "chapter_id": 8780, "verse_number": "1.23", "content_sanskrit": "यदपि विशेषे साधकानुमाननिराकरणं, तदसंबद्धम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]