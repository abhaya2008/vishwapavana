[{"id": 6000336000, "chapter_id": 10336, "verse_number": null, "content_sanskrit": "अथ चतुर्थाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000336001, "chapter_id": 10336, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_004/BhP_12.004.001.m4a", "display_order": 2}, {"id": 6000336002, "chapter_id": 10336, "verse_number": "१२-४-१", "content_sanskrit": "कालस्ते परमाण्वादिर्द्विपरार्धावधिर्नृप।\nकथितो युगमानं च शृणु कल्पलयावथ॥ १२/४/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_004/BhP_12.004.002.m4a", "display_order": 3, "topics": [{"text": "नैमित्तिकादिचतुर्विधलयकथनम्", "range": "१"}]}, {"id": 6000336003, "chapter_id": 10336, "verse_number": "१२-४-२", "content_sanskrit": "चतुर्युगसहस्रं तु ब्रह्मणो दिनमुच्यते।\nस कल्पो यत्र मनवश्चतुर्दश विशां पते॥ १२/४/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_004/BhP_12.004.003.m4a", "display_order": 4}, {"id": 6000336004, "chapter_id": 10336, "verse_number": "१२-४-३", "content_sanskrit": "यदन्ते प्रलयस्तावान् ब्राह्मी रात्रिरुदाहृता।\nत्रयो लोका इमे यत्र कल्पन्ते प्रलयाय हि॥ १२/४/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_004/BhP_12.004.004.m4a", "display_order": 5}, {"id": 6000336005, "chapter_id": 10336, "verse_number": "१२-४-४", "content_sanskrit": "एष नैमित्तिकः प्रोक्तः प्रलयो यत्र विश्वसृक्।\nशेतेऽनन्तासनो विश्वमात्मसात्कृत्य आत्मभूः॥ १२/४/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_004/BhP_12.004.005.m4a", "display_order": 6}, {"id": 6000336006, "chapter_id": 10336, "verse_number": "१२-४-५", "content_sanskrit": "द्विपरार्धे त्वतिक्रान्ते ब्रह्मणः परमेष्ठिनः।\nतदा प्रकृतयः सप्त कल्पन्ते प्रलयाय वै॥ १२/४/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_004/BhP_12.004.006.m4a", "display_order": 7}, {"id": 6000336007, "chapter_id": 10336, "verse_number": "१२-४-६", "content_sanskrit": "एष प्राकृतिको राजन् प्रलयो यत्र लीयते।\nआण्डकोशस्तु सङ्घातो विघात उपसादिते॥ १२/४/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_004/BhP_12.004.007.m4a", "display_order": 8}, {"id": 6000336008, "chapter_id": 10336, "verse_number": "१२-४-७", "content_sanskrit": "पर्जन्यः शतवर्षाणि भूमौ राजन् न वर्षति। तदा निरन्ने ह्यन्योन्यं भक्ष्यमाणाः क्षुधार्दिताः।\nक्षयं यास्यन्ति शनकैः कालेनोपद्रुताः प्रजाः॥ १२/४/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_004/BhP_12.004.008.m4a", "display_order": 9}, {"id": 6000336009, "chapter_id": 10336, "verse_number": "१२-४-८", "content_sanskrit": "सामुद्रं दैहिकं भौमं रसं सांवर्तको रविः।\nरश्मिभिः पिबते घोरैः सर्वं नैव विमुञ्चति॥ १२/४/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_004/BhP_12.004.009.m4a", "display_order": 10}, {"id": 6000336010, "chapter_id": 10336, "verse_number": "१२-४-९", "content_sanskrit": "ततः सांवर्तको वह्निः सङ्कर्षणमुखोत्थितः।\nदहत्यनिलवेगोत्थः शून्यान् भूविवरानथ॥ १२/४/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_004/BhP_12.004.010.m4a", "display_order": 11}, {"id": 6000336011, "chapter_id": 10336, "verse_number": "१२-४-१०", "content_sanskrit": "उपर्यधः समन्ताच्च शिखाभिर्वह्निसूर्ययोः।\nदह्यमानं विभात्यण्डं दग्धगोमयपिण्डवत्॥ १२/४/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_004/BhP_12.004.011.m4a", "display_order": 12}, {"id": 6000336012, "chapter_id": 10336, "verse_number": "१२-४-११", "content_sanskrit": "ततः प्रचण्डपवनो वर्षाणामधिकं शतम्।\nपरः सांवर्तको वाति धूम्रं खं रजसा वृतम्॥ १२/४/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_004/BhP_12.004.012.m4a", "display_order": 13}, {"id": 6000336013, "chapter_id": 10336, "verse_number": "१२-४-१२", "content_sanskrit": "ततो मेघकुलान्यङ्ग चित्रवर्णान्यनेकशः।\nशतं वर्षाणि वर्षन्ति नदन्ति रभसस्वनैः॥ १२/४/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_004/BhP_12.004.013.m4a", "display_order": 14}, {"id": 6000336014, "chapter_id": 10336, "verse_number": "१२-४-१४", "content_sanskrit": "तदा भूमेर्गन्धगुणं ग्रसन्त्याप उपप्लवे।\nग्रस्तगन्धा तु पृथिवी प्रलयत्वाय कल्पते॥ १२/४/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_004/BhP_12.004.014.m4a", "display_order": 15}, {"id": 6000336015, "chapter_id": 10336, "verse_number": "१२-४-१५", "content_sanskrit": "अपां रसमथो तेजस्ता लीयन्तेऽथ नीरसाः।\nग्रसते तेजसो रूपं वायुस्तद्रहितं तदा॥ १२/४/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_004/BhP_12.004.015.m4a", "display_order": 16}, {"id": 6000336016, "chapter_id": 10336, "verse_number": "१२-४-१६", "content_sanskrit": "लीयते चानिले तेजो वायोः खं ग्रसते गुणम्। स वै विशति खं राजंस्ततश्च नभसो गुणम्।\nशब्दं ग्रसति भूतादिर्नभस्तदनु लीयते॥ १२/४/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_004/BhP_12.004.016.m4a", "display_order": 17}, {"id": 6000336017, "chapter_id": 10336, "verse_number": null, "content_sanskrit": "महान् ग्रसत्यहङ्कारं गुणाः सत्त्वादयश्च तम्।\nग्रसतेऽव्याकृतं बीजं गुणान् कालेन चोदितम्॥ १२/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_004/BhP_12.004.017.m4a", "display_order": 18}, {"id": 6000336018, "chapter_id": 10336, "verse_number": "१२-४-१९", "content_sanskrit": "न तस्य कालावयवैः परिणामादयो गुणाः।\nअनाद्यनन्तमव्यक्तं नित्यं कारणमव्ययम्॥ १२/४/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_004/BhP_12.004.018.m4a", "display_order": 19}, {"id": 6000336019, "chapter_id": 10336, "verse_number": "१२-४-२०", "content_sanskrit": "न यत्र वाचो न मनो न सत्त्वं तमो रजो वा महदादयोऽमी।\nन प्राणबुद्धीन्द्रियदेवता वा न सन्निवेशः खलु लोककल्पः॥ १२/४/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_004/BhP_12.004.019.m4a", "display_order": 20}, {"id": 6000336020, "chapter_id": 10336, "verse_number": "१२-४-२१", "content_sanskrit": "न स्वप्नजाग्रन्न च तत् सुषुप्तं न खं जलं भूरनिलोऽग्निरर्कः।\nसुषुप्तवच्छून्यवदप्रतर्क्यं तन्मूलभूतं पदमामनन्ति॥ १२/४/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_004/BhP_12.004.020.m4a", "display_order": 21}, {"id": 6000336021, "chapter_id": 10336, "verse_number": "१२-४-२२", "content_sanskrit": "लयः प्राकृतिको ह्येष पुरुषाव्यक्तयोर्यदा।\nशक्तयः सम्प्रलीयन्ते विवशाः कालविद्रुताः॥ १२/४/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_004/BhP_12.004.021.m4a", "display_order": 22}, {"id": 6000336022, "chapter_id": 10336, "verse_number": "१२-४-२३", "content_sanskrit": "बुद्धीन्द्रियार्थरूपेण ज्ञानं भाति तदाश्रयम्।\nअन्वयव्यतिरेकाभ्यामाद्यन्तवदवस्तु यत्॥ १२/४/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_004/BhP_12.004.022.m4a", "display_order": 23}, {"id": 6000336023, "chapter_id": 10336, "verse_number": "१२-४-२४", "content_sanskrit": "दीपश्चक्षुश्च रूपं च तेजसो न पृथग् भवेत्।\nएवं धीः खानि मात्राश्च न स्युरप्युत मारुतात्॥ १२/४/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_004/BhP_12.004.023.m4a", "display_order": 24}, {"id": 6000336024, "chapter_id": 10336, "verse_number": "१२-४-२५", "content_sanskrit": "बुद्धेर्जागरणं स्वप्नः सुषुप्तिरिति होच्यते।\nमायामात्रमिदं राजन् नानात्वं प्रत्यगात्मनि॥ १२/४/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_004/BhP_12.004.024.m4a", "display_order": 25}, {"id": 6000336025, "chapter_id": 10336, "verse_number": "१२-४-२६", "content_sanskrit": "यथा जलधरा व्योम्नि भवन्ति न भवन्ति च।\nब्रह्मणीदं तदा विश्वमुपयात्युदयाप्ययम्॥ १२/४/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_004/BhP_12.004.025.m4a", "display_order": 26}, {"id": 6000336026, "chapter_id": 10336, "verse_number": "१२-४-२७", "content_sanskrit": "एते ह्यवयवाः प्रोक्ताः सर्वावयविनामिह।\nविनार्थे न प्रतीयेरन् पटस्येवाङ्ग तन्तवः॥ १२/४/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_004/BhP_12.004.026.m4a", "display_order": 27}, {"id": 6000336027, "chapter_id": 10336, "verse_number": "१२-४-२८", "content_sanskrit": "यत् सामान्यविशेषाभ्यामुपलभ्येत स भ्रमः।\nअन्योन्यापाश्रयात् सर्वमाद्यन्तवदवस्तु च॥ १२/४/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_004/BhP_12.004.027.m4a", "display_order": 28}, {"id": 6000336028, "chapter_id": 10336, "verse_number": "१२-४-२९", "content_sanskrit": "विकारः ख्यायमानोऽपि प्रत्यगात्मानमन्तरा।\nन निरूप्यो ह्यणुरपि स्याच्चेत् स भ्रम आत्मनः॥ १२/४/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_004/BhP_12.004.028.m4a", "display_order": 29}, {"id": 6000336029, "chapter_id": 10336, "verse_number": "१२-४-३०", "content_sanskrit": "न हि सत्यस्य नानात्वमविद्वान् यदि मन्यते।\nनानात्वं छिद्रयोर्यद्वज्ज्योतिषोर्वा तयोरपि॥ १२/४/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_004/BhP_12.004.029.m4a", "display_order": 30}, {"id": 6000336030, "chapter_id": 10336, "verse_number": "१२-४-३१", "content_sanskrit": "यथा हिरण्यं बहुधा समीयते नृभिः क्रियाभिर्व्यवहारवर्त्मसु।\nएवं वचोभिर्भगवानधोक्षजो व्याख्यायते वैदिकलौकिकैर्जनैः॥ १२/४/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_004/BhP_12.004.030.m4a", "display_order": 31}, {"id": 6000336031, "chapter_id": 10336, "verse_number": "१२-४-३२", "content_sanskrit": "यथा घनोऽर्कप्रभवोऽर्कदर्शितो ह्यर्कांशभूतस्य च चक्षुषस्तमः।\nएवं त्वहं ब्रह्मगुणस्तदीक्षितो ब्रह्मांशकस्यात्मन आत्मबन्धनः॥ १२/४/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_004/BhP_12.004.031.m4a", "display_order": 32}, {"id": 6000336032, "chapter_id": 10336, "verse_number": "१२-४-३३", "content_sanskrit": "घनो यदाऽर्कप्रभया विदीर्यते चक्षुःस्वरूपं परमीक्षते तदा।\nयदा ह्यहङ्कार उपाधिरात्मनो जिज्ञासया नश्यति तर्ह्यनुस्मरेत्॥ १२/४/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_004/BhP_12.004.032.m4a", "display_order": 33}, {"id": 6000336033, "chapter_id": 10336, "verse_number": "१२-४-३४", "content_sanskrit": "यदैवमेतेन विवेकहेतिना मायामयाहङ्करणात्मबन्धनम्।\nछित्वाऽच्युतात्मानुभवोऽवतिष्ठते तमाहुरात्यन्तिकमङ्ग सम्प्लवम्॥ १२/४/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_004/BhP_12.004.033.m4a", "display_order": 34}, {"id": 6000336034, "chapter_id": 10336, "verse_number": "१२-४-३५", "content_sanskrit": "नित्यदा सर्वभूतानां ब्रह्मादीनां परन्तप।\nउत्पत्तिप्रलयावेके सूक्ष्मज्ञाः सम्प्रचक्षते॥ १२/४/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_004/BhP_12.004.034.m4a", "display_order": 35}, {"id": 6000336035, "chapter_id": 10336, "verse_number": "१२-४-३६", "content_sanskrit": "कालस्रोतोजवेनाशु ह्रियमाणस्य नित्यदा।\nपरिमाणाद्यवस्थास्ता जन्मप्रलयहेतवः॥ १२/४/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_004/BhP_12.004.035.m4a", "display_order": 36}, {"id": 6000336036, "chapter_id": 10336, "verse_number": "१२-४-३७", "content_sanskrit": "अनाद्यन्तवताऽनेन कालेनेश्वरमूर्तिना।\nअवस्था नैव दृश्यन्ते वियति ज्योतिषामिव॥ १२/४/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_004/BhP_12.004.036.m4a", "display_order": 37}, {"id": 6000336037, "chapter_id": 10336, "verse_number": "१२-४-३८", "content_sanskrit": "नित्यो नैमित्तिकश्चैव तथा प्राकृतिको लयः।\nआत्यन्तिकश्च कथितः कालस्य गतिरीदृशी॥ १२/४/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_004/BhP_12.004.037.m4a", "display_order": 38}, {"id": 6000336038, "chapter_id": 10336, "verse_number": "१२-४-३९", "content_sanskrit": "एताः कुरुश्रेष्ठ जगद्विधातुर्नारायणस्याखिलसत्त्वधाम्नः।\nलीलाकथास्ते कथिताः समासतः कार्त्स्न्येन नाजोऽप्यभिधातुमीशः॥ १२/४/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_004/BhP_12.004.038.m4a", "display_order": 39, "topics": [{"text": "शुकाचार्येण परीक्षिते ब्रह्मोपदेशेन तक्षकदंशभीतिनिवारणम्", "range": "३९–५७"}]}, {"id": 6000336039, "chapter_id": 10336, "verse_number": "१२-४-४०", "content_sanskrit": "संसारसिन्धुमतिदुस्तरमुत्तितीर्षोर्नान्यः प्लवो भगवतः पुरुषोत्तमस्य।\nलीलाकथारसनिषेवणमन्तरेण पुंसो भवेद् विविधदुःखदवार्दितस्य॥ १२/४/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_004/BhP_12.004.039.m4a", "display_order": 40}, {"id": 6000336040, "chapter_id": 10336, "verse_number": "१२-४-४१", "content_sanskrit": "पुराणसंहितामेतां ऋषिर्नारायणोऽव्ययः।\nनारदाय पुरा प्राह कृष्णद्वैपायनाय सः॥ १२/४/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_004/BhP_12.004.040.m4a", "display_order": 41}, {"id": 6000336041, "chapter_id": 10336, "verse_number": "१२-४-४२", "content_sanskrit": "स वै मह्यं महाराज भगवान् बादरायणः।\nइमां भागवतीं प्रीतः संहितां वेदसम्मिताम्॥ १२/४/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_004/BhP_12.004.041.m4a", "display_order": 42}, {"id": 6000336042, "chapter_id": 10336, "verse_number": "१२-४-४३", "content_sanskrit": "एतां वक्ष्यत्यसौ सूत ऋषिभ्यो निमिशालये।\nदीर्घसत्रे कुरुश्रेष्ठ सम्पृष्टः शौनकादिभिः॥ १२/४/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_004/BhP_12.004.042.m4a", "display_order": 43}, {"id": 6000336043, "chapter_id": 10336, "verse_number": "१२-४-४४", "content_sanskrit": "अत्रानुवर्ण्यतेऽभीक्ष्णं विश्वात्मा भगवान् हरिः।\nयस्य प्रसादजो ब्रह्मा रुद्रः क्रोधसमुद्भवः॥ १२/४/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_004/BhP_12.004.043.m4a", "display_order": 44}, {"id": 6000336044, "chapter_id": 10336, "verse_number": "१२-४-४५", "content_sanskrit": "त्वं च राजन् मरिष्येति पशुबुद्धिमिमां जहि।\nन जातः प्रागभूतोऽद्य देहवत् त्वं न नङ्‌क्ष्यसि॥ १२/४/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_004/BhP_12.004.044.m4a", "display_order": 45}, {"id": 6000336045, "chapter_id": 10336, "verse_number": "१२-४-४६", "content_sanskrit": "न भविष्यसि भूत्वा त्वं पुत्रपौत्रादिरूपवान्।\nबीजाङ्कुरवद् देहादेर्व्यतिरिक्तो यथाऽनलः॥ १२/४/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_004/BhP_12.004.045.m4a", "display_order": 46}, {"id": 6000336046, "chapter_id": 10336, "verse_number": "१२-४-४७", "content_sanskrit": "स्वप्ने यथा शिरश्छेदः पञ्चत्वाद्यात्मनस्तथा।\nयस्मात् पश्यसि देहस्य तत आत्मा ह्यजोऽमरः॥ १२/४/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_004/BhP_12.004.046.m4a", "display_order": 47}, {"id": 6000336047, "chapter_id": 10336, "verse_number": "१२-४-४८", "content_sanskrit": "घटे भिन्ने यथाऽकाश आकाशः स्याद् यथा पुरा।\nएवं देहे मृते जीवो ब्रह्म सम्पद्यते पुनः॥ १२/४/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_004/BhP_12.004.047.m4a", "display_order": 48}, {"id": 6000336048, "chapter_id": 10336, "verse_number": "१२-४-४९", "content_sanskrit": "मनः सृजति वै देहान् गुणान् कर्माणि चात्मनः।\nतन्मनः सृजते माया ततो जीवस्य संसृतिः॥ १२/४/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_004/BhP_12.004.048.m4a", "display_order": 49}, {"id": 6000336049, "chapter_id": 10336, "verse_number": "१२-४-५०", "content_sanskrit": "स्नेहाधिष्ठानवर्त्यग्निसंयोगो यावदीयते।\nतावद् दीपस्य दीपत्वमेवं देहकृतो भवः॥ १२/४/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_004/BhP_12.004.049.m4a", "display_order": 50}, {"id": 6000336050, "chapter_id": 10336, "verse_number": "१२-४-५१", "content_sanskrit": "रजःसत्त्वतमोवृत्त्या जायेतैधेत नश्यति।\nन तत्रात्मा स्वयञ्ज्योतिर्यो व्यक्ताव्यक्तयोः परः॥ १२/४/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_004/BhP_12.004.050.m4a", "display_order": 51}, {"id": 6000336051, "chapter_id": 10336, "verse_number": "१२-४-५२", "content_sanskrit": "आकाशवद् ध्रुवाधारो ध्रुवो नानामितस्ततः।\nएवमात्मानमात्मस्थमात्मनैवामृश प्रभो॥ १२/४/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_004/BhP_12.004.051.m4a", "display_order": 52}, {"id": 6000336052, "chapter_id": 10336, "verse_number": "१२-४-५३", "content_sanskrit": "बुद्ध्याऽनुमानगर्भिण्या वासुदेवानुचिन्तया।\nचोदितो विप्रवाक्येन न त्वां धक्ष्यति तक्षकः॥ १२/४/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_004/BhP_12.004.052.m4a", "display_order": 53}, {"id": 6000336053, "chapter_id": 10336, "verse_number": "१२-४-५४–५५", "content_sanskrit": "मृत्यवो नोपसर्पन्ति मृत्यूनां मृत्युमीश्वरम्। अहं ब्रह्म परं धाम ब्रह्माहं परमं पदम्\nएवं समीक्ष्य चात्मानमात्मन्याधाय निष्कले॥ १२/४/५४-५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_004/BhP_12.004.053.m4a", "display_order": 54}, {"id": 6000336054, "chapter_id": 10336, "verse_number": "१२-४-५६", "content_sanskrit": "दशन्तं तक्षकं पादे लेलिहानं विषाननैः।\nन द्रक्ष्यसि शरीरं च विश्वं च पृथगात्मनः॥ १२/४/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_004/BhP_12.004.054.m4a", "display_order": 55}, {"id": 6000336055, "chapter_id": 10336, "verse_number": "१२-४-५७", "content_sanskrit": "एतत् ते कथितं तात यथा त्वं पृष्टवान् नृप।\nहरेर्विश्वात्मनश्चेष्टां किं भूयः श्रोतुमिच्छसि॥ १२/४/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_004/BhP_12.004.055.m4a", "display_order": 56}, {"id": 6000336056, "chapter_id": 10336, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां द्वादशस्कन्धे चतुर्थाध्यायः॥१२-४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]