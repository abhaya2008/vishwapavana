[{"id": 2129561, "chapter_id": 3789, "verse_number": "", "content_sanskrit": "अष्टावक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2129562, "chapter_id": 3789, "verse_number": "१", "content_sanskrit": "अनेनैव ब्राह्मणाः शुश्रुवांसो\nवादे जित्वा सलिले मज्जिताः प्राक् ।\nतानेव धर्मानयमद्य बन्दी\nप्राप्नोतु गृह्याप्सु निमज्जयैनम् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2129563, "chapter_id": 3789, "verse_number": "", "content_sanskrit": "वन्दी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2129564, "chapter_id": 3789, "verse_number": "२", "content_sanskrit": "अहं पुत्रो वरुणस्योत राज्ञ-\nस्तत्रास सत्रं द्वादशवार्षिकं वै ।\nसत्रेण ते जनक तुल्यकालं\nतदर्थं ते प्रहिता मे द्विजाग्र्याः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2129565, "chapter_id": 3789, "verse_number": "३", "content_sanskrit": "ते तु सर्वे वरुणस्योत यज्ञं\nद्रष्टुं गता इम(इह) आयान्ति भूयः ।\nअष्टावक्रं पूजयेः पूजनीयं\nयस्य हेतोर्जनितारं समेष्ये\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2129566, "chapter_id": 3789, "verse_number": "", "content_sanskrit": "अष्टावक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2129567, "chapter_id": 3789, "verse_number": "४", "content_sanskrit": "विप्राः समुद्राम्भसि मज्जिता ये\nवाचा जिता मेधया वा विदानाः ।\nतां मेधया वाचमथोज्जहार\nयथा वाचमवचिन्वन्ति सन्तः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2129568, "chapter_id": 3789, "verse_number": "५", "content_sanskrit": "अग्निर्दहन् जातवेदाः सतां गृहान्\nविसर्जयंस्तेजसा न स्म धाक्षीत् ।\nबालेषु पुत्रेषु कृपणं वदत्सु\nतथा वाचमवचिन्वन्ति सन्तः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2129569, "chapter_id": 3789, "verse_number": "६", "content_sanskrit": "श्लेष्मातकः क्षीणवर्चाः शृणोषि\nउताहो त्वां स्तुतयो मादयन्ति ।\nहस्तीव त्वं जनक विनुद्यमानो\nन मामिकां वाचमिमां शृणोषि \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2129570, "chapter_id": 3789, "verse_number": "", "content_sanskrit": "जनकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2129571, "chapter_id": 3789, "verse_number": "७", "content_sanskrit": "शृणोमि वाचं तव दिव्यरूपाम्\nअमानुषीं दिव्यरूपोऽसि साक्षात् ।\nअजैषीर्यद् बन्दिनं त्वं विवादे\nनिसृष्ट एष तव कामोऽद्य बन्दी\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2129572, "chapter_id": 3789, "verse_number": "", "content_sanskrit": "अष्टावक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2129573, "chapter_id": 3789, "verse_number": "८", "content_sanskrit": "नानेन जीवता कश्चिदर्थो मे बन्दिना नृप ।\nपिता यद्यस्य वरुणो मज्जयैनं जलाशये \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2129574, "chapter_id": 3789, "verse_number": "", "content_sanskrit": "बन्दी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2129575, "chapter_id": 3789, "verse_number": "९", "content_sanskrit": "अहं पुत्रो वरुणस्योत राज्ञो न मे भयं विद्यते मज्जितस्य ।\nइमं मुहूर्तं पितरं द्रक्ष्यतेऽयमष्टावक्रश्चिरनष्टं कहोळम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2129576, "chapter_id": 3789, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2129577, "chapter_id": 3789, "verse_number": "१०", "content_sanskrit": "ततस्ते पूजिता विप्रा वरुणेन महात्मना ।\nउदतिष्ठंस्ततः सर्वे जनकस्य समीपतः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2129578, "chapter_id": 3789, "verse_number": "", "content_sanskrit": "कहोलः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2129579, "chapter_id": 3789, "verse_number": "११", "content_sanskrit": "इत्यर्थमिच्छन्ति सुतान् जना जनक कर्मणा ।\nयदहं नाशकं कर्तुं तत्पुत्रः कृतवान् मम\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2129580, "chapter_id": 3789, "verse_number": "१२", "content_sanskrit": "उताबलस्य बलवानुत बालस्य पण्डितः ।\nउत वाविदुषो विद्वान् पुत्रो जनक जायते\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2129581, "chapter_id": 3789, "verse_number": "", "content_sanskrit": "वन्दी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2129582, "chapter_id": 3789, "verse_number": "१३", "content_sanskrit": "सितेन ते परशुना स्वयमेवान्तको नृप ।\nशिरांस्यपहरन्नाजौ रिपूणां भद्रमस्तु ते\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2129583, "chapter_id": 3789, "verse_number": "१४", "content_sanskrit": "महदुक्थ्यं गीयते साम चाग्र्यं\nसम्यक्सोमः पीयते चात्र सत्रे ।\nशुचीन् भागान् प्रतिजगृहुश्च\nहृष्टाः साक्षाद् देवा जनकस्योत राज्ञः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2129584, "chapter_id": 3789, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2129585, "chapter_id": 3789, "verse_number": "", "content_sanskrit": "समुत्थितेष्वथ सर्वेषु राजन् विप्रेषु तेष्वधिकं सुप्रभेषु ।\nअनुज्ञातो जनकेनाथ राज्ञा विवेश तोयं सागरस्योत बन्दी \t॥१५", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2129586, "chapter_id": 3789, "verse_number": "", "content_sanskrit": "अष्टावक्रः पितरं पूजयित्वा सम्पूजितो ब्राह्मणैस्तैर्यथावत् । प्रत्याजगामाश्रममेव चाग्र्यं जित्वा सौतिं सहितो मातुलेन\t ॥१६", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2129587, "chapter_id": 3789, "verse_number": "", "content_sanskrit": "ततोऽष्टावक्रं मातुरथान्तिके पिता \tनदीं समङ्गां शीघ्रमिमां विशस्व प्रोवाच चैनं स तथा विवेश समैरङ्गैश्चापि बभूव सद्यः \t॥१७", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2129588, "chapter_id": 3789, "verse_number": "", "content_sanskrit": "नदी समङ्गा च बभूव पुष्या \tयस्यां स्नातो मुच्यते किल्बिषाद्धि ।\nतमप्येनां स्नानपानावगाहैः सभ्रातृकः सहभार्यो विशस्व \t॥१८", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2129589, "chapter_id": 3789, "verse_number": "१९", "content_sanskrit": "अत्र कौन्तेय सहितो भ्रातृभि-\nस्त्वं सुखोषितः सह विप्रैः प्रतीतः ।\nपुण्यान्यन्यानि शुचिकर्मैकभक्ति-\nर्मया सार्धं चरितास्याजमीढ \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2129590, "chapter_id": 3789, "verse_number": "१३१", "content_sanskrit": "॥ इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि तीर्थयात्रापर्वणि एकत्रिंशदुत्तशततमोऽध्यायः ॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2129591, "chapter_id": 3789, "verse_number": "८७", "content_sanskrit": "॥ इति तीर्थयात्रापर्वणि सप्ताशीतितमोऽध्यायः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2129592, "chapter_id": 3789, "verse_number": "", "content_sanskrit": "––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]