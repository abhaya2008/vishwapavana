[{"id": 7006206000, "chapter_id": 26206, "verse_number": "२-३४-१", "content_sanskrit": "सगर उवाच ब्रह्मपुत्र महाभाग महान्मेऽनुग्रहः कृतः ।\nयदिदं कवचं मह्यं प्रकाशितमनामयम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006206001, "chapter_id": 26206, "verse_number": "२-३४-२", "content_sanskrit": "और्वेणानुगृहीतोऽहं कृतास्त्रो यदनुग्रहात् ।\nभवतस्तु कृपापात्रं जातोऽहमधुना विभो ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006206002, "chapter_id": 26206, "verse_number": "२-३४-३", "content_sanskrit": "रामेण भार्गवेन्द्रेण कार्त्तवीर्यो नृपो गुरो ।\nयथा समापितो वीरस्तन्मे विस्तरतो वद ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006206003, "chapter_id": 26206, "verse_number": "२-३४-४", "content_sanskrit": "कृपापात्रं स दत्तस्य राजा रामः शिवस्य च ।\nउभौ तौ समरे वीरौ जघटाते कथं गुरो ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006206004, "chapter_id": 26206, "verse_number": "२-३४-५", "content_sanskrit": "वसिष्ठ उवाच शृणु राजन्प्रवक्ष्यामि चरितं पापनाशनम् ।\nकार्त्तवीर्यस्य भूपस्य रामस्य च महात्मनः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006206005, "chapter_id": 26206, "verse_number": "२-३४-६", "content_sanskrit": "स रामः कवचं लब्ध्वा मन्त्रं चैव गुरोर्मुखात् ।\nचकार माधनं तस्य भक्त्या परमया युतः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006206006, "chapter_id": 26206, "verse_number": "२-३४-७", "content_sanskrit": "भूमिशागी त्रिषवण स्नानसध्यापरायणः ।\nउवासपुष्करे राम शतवर्षमतन्द्रितः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006206007, "chapter_id": 26206, "verse_number": "२-३४-८", "content_sanskrit": "समित्पुष्पकुशादीनि द्रव्याण्यहरहर्भृगोः ।\nआनीय काननाद्भूप प्रायच्छदकृतव्रणः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006206008, "chapter_id": 26206, "verse_number": "२-३४-९", "content_sanskrit": "सततं ध्यानसंयुक्तो रामो मतिमतां वरः ।\nआराधयामास विभुं कृष्णं कल्मषनाशनम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006206009, "chapter_id": 26206, "verse_number": "२-३४-१०", "content_sanskrit": "तस्यैवं यजमानस्य रामस्य जगतीपते ।\nगतं वर्षशतं तत्र ध्यानयुक्तस्य नित्यदा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006206010, "chapter_id": 26206, "verse_number": "२-३४-११", "content_sanskrit": "एकदा तु महाराज रामः स्नातुं गतो महान् ।\nमध्यमं पुष्करं तत्र ददर्शाश्वर्यमुत्तमम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006206011, "chapter_id": 26206, "verse_number": "२-३४-१२", "content_sanskrit": "मृग एकः समायातो मृग्य युक्तः पलायितः ।\nव्याधस्य मृगयां प्राप्तो धर्मतप्तोऽतिपीडितः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006206012, "chapter_id": 26206, "verse_number": "२-३४-१३", "content_sanskrit": "पिपासितो महाभाग जलपानसमुत्सुकः ।\nरामस्य पश्यतस्तत्र सरसस्तटमागतः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006206013, "chapter_id": 26206, "verse_number": "२-३४-१४", "content_sanskrit": "पश्चान्मृगी समायाता भीता सा चकितेक्षणा ।\nउभो तौ पिबतस्तत्र जलं शङ्कितमानसौ ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006206014, "chapter_id": 26206, "verse_number": "२-३४-१५", "content_sanskrit": "तावत्समागतो व्याधो बाणपाणिर्धनुर्द्धरः ।\nस दृष्ट्वा तत्र संविष्टं रामं भार्गवनन्दनम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006206015, "chapter_id": 26206, "verse_number": "२-३४-१६", "content_sanskrit": "अकृतव्रणसंयुक्तं तस्थौ दूरकृतेक्षणः ।\nस चिन्तयामास तदा शङ्कितो भृगुनन्दनात् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006206016, "chapter_id": 26206, "verse_number": "२-३४-१७", "content_sanskrit": "अयं रामो महावीरो दुष्टानामन्तकारकः ।\nकथमेतस्य हन्म्येतौ पश्यतो मृगयामृगौ ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006206017, "chapter_id": 26206, "verse_number": "२-३४-१८", "content_sanskrit": "इति चिन्ता समाविष्टो व्याधो राजन्यसत्तम ।\nतस्थौ तत्रैव रामस्य भयात्संत्रस्तमानसः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006206018, "chapter_id": 26206, "verse_number": "२-३४-१९", "content_sanskrit": "रामस्तु तौ मृगों दृष्ट्वा पिबन्तौ सभ्यं जलम् ।\nतर्कयामास मेधावी किमत्र भयकारणम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006206019, "chapter_id": 26206, "verse_number": "२-३४-२०", "content_sanskrit": "नैवात्र व्याघ्रसेनादो न च व्याधो हि दृश्यते ।\nकेनैतौ कारणेनाहो शङ्कितौ चकितेक्षणौ ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006206020, "chapter_id": 26206, "verse_number": "२-३४-२१", "content_sanskrit": "अथ वा मृगजातिर्हि निसर्गाच्चकितेक्षणा ।\nचेनैतौ जलपानेऽपि पश्यतश्चकितेक्षणौ ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006206021, "chapter_id": 26206, "verse_number": "२-३४-२२", "content_sanskrit": "नैतावत्कारणं चात्र किन्तु खेदभयातुरौ ।\nलक्षयेते खिन्नसर्वाङ्गौ कम्पयुक्तौ यतस्त्विमौ ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006206022, "chapter_id": 26206, "verse_number": "२-३४-२३", "content_sanskrit": "एवं संचिन्त्य मतिमान्स तस्थौ मध्यपुष्करे ।\nशिष्येण संयुतो रामो यावत्तौ चापि संस्थितौ ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006206023, "chapter_id": 26206, "verse_number": "२-३४-२४", "content_sanskrit": "पीत्वा जलं ततस्तौ तु वृक्षच्छायासमाश्रितौ ।\nरामं दृष्ट्वा महात्मानं कथां तौ चक्रतुर्मुदा ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006206024, "chapter_id": 26206, "verse_number": "२-३४-२५", "content_sanskrit": "मृग्युवाच कान्त चात्रैव तिष्ठावो यावद्रामोऽत्रसंस्थितः ।\nअस्य वीरस्य सांनिध्ये भयं नैवावयोर्भवेत् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006206025, "chapter_id": 26206, "verse_number": "२-३४-२६", "content_sanskrit": "अत्राप्यागत्य चैव्द्याधौ ह्यावयोः प्रहरिष्यति ।\nदृष्टमात्रो हि मुनिना भस्मीभूतो भविष्यति ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006206026, "chapter_id": 26206, "verse_number": "२-३४-२७", "content_sanskrit": "इत्युक्ते वचने मृग्या रामर्शनतुष्टया ।\nमृगश्चोवाच हर्षेण समाविष्टः प्रियां स्वकाम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006206027, "chapter_id": 26206, "verse_number": "२-३४-२८", "content_sanskrit": "एवमेव महाभागे यद्वै वदसि भामिनि ।\nजानेऽहमपि रामस्य प्रभावं सुमहात्मनः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006206028, "chapter_id": 26206, "verse_number": "२-३४-२९", "content_sanskrit": "योऽयं संदृश्यते चास्य पार्श्वं शिष्योऽकृतव्रणः ।\nसचाने न महाभागस्त्रातो व्याघ्रभयातुरः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006206029, "chapter_id": 26206, "verse_number": "२-३४-३०", "content_sanskrit": "अयं रामो महाभागे जमदग्निसुतोऽनुजः ।\nपितरं कार्त्तवीर्येण दृष्ट्वा चैव तिरस्कृतम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006206030, "chapter_id": 26206, "verse_number": "२-३४-३१", "content_sanskrit": "चकारातितरां क्रुद्धः प्रतिज्ञां नृपघातिनीम् ।\nतत्पूर्तिकामो ह्यगमद्ब्रह्मलोकं पुरा ह्ययम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006206031, "chapter_id": 26206, "verse_number": "२-३४-३२", "content_sanskrit": "स ब्रह्मा दिष्टवांश्चैनं शिवलोकं व्रजेति ह ।\nतस्य त्वाज्ञां समादाय गतोऽसौ शिवसन्निधिम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006206032, "chapter_id": 26206, "verse_number": "२-३४-३३", "content_sanskrit": "प्रोवाचाखिलवृत्तान्त राज्ञश्चप्यात्मनः पितुः ।\nस कृपालुर्महादेवः सभाज्य भृगुनन्दनम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006206033, "chapter_id": 26206, "verse_number": "२-३४-३४", "content_sanskrit": "ददौ कृष्णस्य सन्मन्त्रमभेद्यं कवचं तथा ।\nस्वीयं पाशुपतं चास्त्रमन्यास्त्रग्राममेव च ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006206034, "chapter_id": 26206, "verse_number": "२-३४-३५", "content_sanskrit": "विसर्जयामास मुदा दत्त्वा शस्त्राणि चादरात् ।\nसोऽयमत्रागतो भद्रे मेत्रसाधनतत्परः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006206035, "chapter_id": 26206, "verse_number": "२-३४-३६", "content_sanskrit": "नित्यं जपति धर्मात्मा कृष्णस्य कवचं सुधीः ।\nशतवर्षाणि चाप्यस्य गतानि सुमहात्मनः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006206036, "chapter_id": 26206, "verse_number": "२-३४-३७", "content_sanskrit": "मन्त्र साधयतो भद्रे न च तत्सिद्धिरेति हि ।\nआत्रास्ति कारणं भक्तिः साव वै त्रिविधा मता ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006206037, "chapter_id": 26206, "verse_number": "२-३४-३८", "content_sanskrit": "उत्तमा मध्यमा चैव कनिष्ठा तरलेक्षणे ।\nशिवस्य नारदस्यापि शुकस्य च महात्मनः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006206038, "chapter_id": 26206, "verse_number": "२-३४-३९", "content_sanskrit": "अंबरीष्स्य राजर्षे रन्तिदेवस्य मारुतेः ।\nबलेर्विभीषणस्यापि प्रह्लादस्य महात्मनः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006206039, "chapter_id": 26206, "verse_number": "२-३४-४०", "content_sanskrit": "उत्तमा भक्तिरेवास्ति गोपीनामुद्धवस्य च ।\nवसिष्ठादिमुनीशानां मन्वादीनां शुभेक्षणे ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006206040, "chapter_id": 26206, "verse_number": "२-३४-४१", "content_sanskrit": "मध्या च भक्तिरेवास्ति प्राकृतान्यजनेषु सा ।\nमध्यभक्तिरयं रामो नित्यं यमपरायणः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006206041, "chapter_id": 26206, "verse_number": "२-३४-४२", "content_sanskrit": "सेवते गोपिकाधीशं तेन सिद्धिं न चागतः ।\nवसिष्ठ उवाच इत्युक्ता त्वरितं कान्तं सा मृगी हृष्टमानसा ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006206042, "chapter_id": 26206, "verse_number": "२-३४-४३", "content_sanskrit": "पुनः पप्रच्छ भक्तेस्तु लक्षणं प्रेमदायकम् ।\nमृग्युवाच साधुकान्त महाभाग वचस्तेऽलौकिकं प्रिय ।\nर्हदृग्ज्ञानं तव कथं संजातं तद्वदाधुना ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006206043, "chapter_id": 26206, "verse_number": "२-३४-४४", "content_sanskrit": "मृग उवाच शृणु प्रिये महाभागे ज्ञानं पुण्येन जायते ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006206044, "chapter_id": 26206, "verse_number": "२-३४-४५", "content_sanskrit": "तत्पुण्यमद्य संजातं भार्गवस्यास्य दर्शनात् ।\nपुण्यात्मा भार्गवश्चायं कृष्णाभक्तो जितेन्द्रियः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006206045, "chapter_id": 26206, "verse_number": "२-३४-४६", "content_sanskrit": "गुरुशुश्रूषको नित्यं नित्यनैमित्तिकादरः ।\nअतोऽस्य दर्शनाज्जातं ज्ञानं ं द्यैव भामिनि ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006206046, "chapter_id": 26206, "verse_number": "२-३४-४७", "content_sanskrit": "त्रैलोक्यस्थितसत्त्वानां शुभाशुभनिदर्शकम् ।\nअद्यैव विदितं मेऽभूद्रासस्यास्य महात्मनः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006206047, "chapter_id": 26206, "verse_number": "२-३४-४८", "content_sanskrit": "चरितं पुण्यदं चैव पापघ्नं शृण्वतामिदम् ।\nयद्यत्करिष्यते चैव तदपि ज्ञानगोचरम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006206048, "chapter_id": 26206, "verse_number": "२-३४-४९", "content_sanskrit": "योत्तमा भक्तिराख्याता तां विना नैव सिद्ध्यति ।\nकवचं मन्त्रसहितं ह्यपि वर्षायुतायुतैः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006206049, "chapter_id": 26206, "verse_number": "२-३४-५०", "content_sanskrit": "यद्ययं भार्गवो भद्रे ह्यगस्त्यानुग्रहं लभेत् ।\nकृष्णप्रेमामृतं नाम स्तोत्रमुत्तमभक्तिदम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006206050, "chapter_id": 26206, "verse_number": "२-३४-५१", "content_sanskrit": "ज्ञात्वा च लप्स्यते सिद्धिं मन्त्रस्य कवचस्य च ।\nस मुनिर्ज्ञाततत्त्वार्थः सानुकंपोऽभयप्रदः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006206051, "chapter_id": 26206, "verse_number": "२-३४-५२", "content_sanskrit": "उपदेक्ष्यति चैवैनं तत्त्वज्ञानं मुदावहम् ।\nश्रीकृष्णचारितं सर्वं नामभिर्ग्रथितं यतः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006206052, "chapter_id": 26206, "verse_number": "२-३४-५३", "content_sanskrit": "कृष्णप्रेमामृतस्तोत्राज्ज्ञास्यतेऽस्य महामतिः ।\nततः संसिद्ध कवचौ राजनं हैहयाधिपम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006206053, "chapter_id": 26206, "verse_number": "२-३४-५४", "content_sanskrit": "हत्वा सपुत्रामात्यं च ससुहृद्बलवाहनम् ।\nत्रिः सप्तकृत्वो निर्भूपां करिष्यत्यवनीं प्रिय ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006206054, "chapter_id": 26206, "verse_number": "२-३४-५५", "content_sanskrit": "वसिष्ठ उवाच एवमुक्त्वा मृगो राजन्विरराम मृगीं ततः ।\nआत्मनो मृगभावस्य कारणं ज्ञातवांश्च ह ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}]