[{"id": 2119017, "chapter_id": 3558, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2119018, "chapter_id": 3558, "verse_number": "१", "content_sanskrit": "मन्दपालोऽपि कौरव्य चिन्तयानः सुतान् तदा ।\nउक्तवानप्यशीतांशुं स नैव स्म न तप्यते ।\nस तप्यमानः पुत्रार्थे लपितामिदमब्रवीत् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2119019, "chapter_id": 3558, "verse_number": "", "content_sanskrit": "मन्दपालः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2119020, "chapter_id": 3558, "verse_number": "२", "content_sanskrit": "कथं त्वशक्ताः पतने लपिते मम पुत्रकाः ।\nवर्धमाने हुतवहे वाते शीघ्रं प्रवायति \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2119021, "chapter_id": 3558, "verse_number": "३", "content_sanskrit": "असमर्था विमोक्षाय भविष्यन्ति ममात्मजाः ।\nकथं नु शक्ता त्राणाय माता तेषां तपस्विनी \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2119022, "chapter_id": 3558, "verse_number": "४", "content_sanskrit": "भविष्यत्यसुखाविष्टा पुत्रत्राणमपश्यती ।\nकथं च सरणेऽशक्तान् पतने च ममात्मजान् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2119023, "chapter_id": 3558, "verse_number": "५", "content_sanskrit": "सा तप्यमाना भीता वा गमनायाभिधावती ।\nजरितारिः कथं पुत्रः सारिसृक्कः कथं भवेत् ।\nस्तम्बमित्रः कथं द्रोणः कथं सा च तपस्विनी \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2119024, "chapter_id": 3558, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2119025, "chapter_id": 3558, "verse_number": "६", "content_sanskrit": "लालप्यमानं तमृषिं मन्दपालं तथा वने ।\nलपिता प्रत्युवाचेदं सासूयमिव भारत \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2119026, "chapter_id": 3558, "verse_number": "७", "content_sanskrit": "न ते पुत्रेष्ववेक्षाऽस्ति यान् ऋृषीनुक्तवानसि ।\nतेजस्विनो वीर्यवन्तो न तेषां ज्वलनाद् भयम् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2119027, "chapter_id": 3558, "verse_number": "८", "content_sanskrit": "दावाग्नेः परिदत्ताश्च त्वया हि मम सन्निधौ ।\nप्रतिश्रुतं तथा तेन ज्वलनेन महात्मना \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2119028, "chapter_id": 3558, "verse_number": "९", "content_sanskrit": "लोकपालोऽनृतां वाचं न च वक्ता कथञ्चन ।\nनासमञ्जसवेत्ता वै न ते तेष्वस्ति मानसम् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2119029, "chapter_id": 3558, "verse_number": "१०", "content_sanskrit": "तामेव हि ममामित्रां चिन्तयन् परितप्यसे ।\nध्रुवं मयि न ते स्नेहो यथा तस्यां पुराऽभवत् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2119030, "chapter_id": 3558, "verse_number": "११", "content_sanskrit": "न हि पक्षवता भाव्यं निःस्नेहेन सुहृज्जने ।\nपीड्यमान उपस्प्रष्टुं शक्यो नात्मा कथञ्चन \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2119031, "chapter_id": 3558, "verse_number": "१२", "content_sanskrit": "गच्छ त्वं जरितामेव यस्यार्थे परितप्यसे ।\nचरिष्याम्यद्य चैवैका यथा कापुरुषे रता \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2119032, "chapter_id": 3558, "verse_number": "", "content_sanskrit": "मन्दपालः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2119033, "chapter_id": 3558, "verse_number": "१३", "content_sanskrit": "नाहमेवं चरे लोके यथा त्वमभिमन्यसे ।\nअपत्यहेतोर्विचरे तच्च कृच्छ्रतरं मम \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2119034, "chapter_id": 3558, "verse_number": "१४", "content_sanskrit": "भूतं हित्वा भविष्यत्त्वे यो रमेत स मन्दधीः ।\nअवमत्य तथा लोकान् यथेच्छसि तथा कुरु \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2119035, "chapter_id": 3558, "verse_number": "१५", "content_sanskrit": "एष हि ज्वलमानोऽग्निर्लेलिहानो महीरुहान् ।\nद्वेष्यं हि हृदि सन्तापं जनयत्यशिवं मम \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2119036, "chapter_id": 3558, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2119037, "chapter_id": 3558, "verse_number": "१६", "content_sanskrit": "तस्माद् देशादतिक्रान्ते ज्वलने च महात्मनि ।\nजगाम पुत्रकानेव जरिता पुत्रगृद्धिनी \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2119038, "chapter_id": 3558, "verse_number": "१७", "content_sanskrit": "सा तान् कुशलिनः सर्वान् विमुक्तान् जातवेदसः ।\nरोरूयमाणा कृपणा सुतान् दृष्टवती वने \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2119039, "chapter_id": 3558, "verse_number": "१८", "content_sanskrit": "अश्रद्धेयतमं तेषां दर्शनं सा पुनःपुनः ।\nएकैकशश्च पुत्रांस्तान् क्रोशमानाऽन्वपद्यत \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2119040, "chapter_id": 3558, "verse_number": "१९", "content_sanskrit": "जरिता तु परिष्वज्य पुत्रस्नेहाच्चुचुम्ब ह ।\nततोऽभ्यगच्छत् सहसा मन्दपालोऽपि भारत \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2119041, "chapter_id": 3558, "verse_number": "२०", "content_sanskrit": "अथ ते सर्व एवैनं नाभ्यजानन्त वै सुताः ।\nगुरुत्वान्मन्दपालस्य तपसश्च विशेषतः \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2119042, "chapter_id": 3558, "verse_number": "२१", "content_sanskrit": "अभिवादयामहे सर्वे जातपक्षाः प्रसादतः ।\nएवमुक्तवतां तेषां प्रतिनन्द्य महातपाः ।\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2119043, "chapter_id": 3558, "verse_number": "२२", "content_sanskrit": "परिष्वज्य च तान् सर्वान् मूर्ध्युपाघ्राय बालकान् ।\nपुत्रस्पर्शात् तु या प्रीतिस्तामवाप स गौतमः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2119044, "chapter_id": 3558, "verse_number": "२३", "content_sanskrit": "लालप्यमाना एकैकं जरिता च पुनःपुनः ।\nउच्यते वचनं किञ्चिन्न चैव साध्वसाधु वा \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2119045, "chapter_id": 3558, "verse_number": "", "content_sanskrit": "मन्दपालः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2119046, "chapter_id": 3558, "verse_number": "२४", "content_sanskrit": "ज्येष्ठः सुतस्ते कतमस्तथानुज्येष्ठ एव च ।\nमध्यमः कतमः पुत्रः कनीयान् कतमश्च ते \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2119047, "chapter_id": 3558, "verse_number": "२५", "content_sanskrit": "एवं ब्रुवन्तं दुःखार्तं किं मां न प्रतिभाषसे ।\nकृतवानपि हव्याशे नैव शान्तिमितो लभे \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2119048, "chapter_id": 3558, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2119049, "chapter_id": 3558, "verse_number": "२६", "content_sanskrit": "एवं जरां ततः पत्नीं मन्दपालस्तदाऽस्पृशत् \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2119050, "chapter_id": 3558, "verse_number": "", "content_sanskrit": "जरिता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2119051, "chapter_id": 3558, "verse_number": "२७", "content_sanskrit": "किं ते ज्येष्ठे सुते कार्यं किमनन्तरजेन वा ।\nकिं च ते मध्यमे कार्यं किं कनिष्ठे तपोधन \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2119052, "chapter_id": 3558, "verse_number": "२८", "content_sanskrit": "यत्र मां सर्वशो हीनामुत्सृज्यासि गतः पुरा ।\nतामेव लपितां गच्छ तरुणीं चारुहासिनीम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2119053, "chapter_id": 3558, "verse_number": "", "content_sanskrit": "मन्दपालः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2119054, "chapter_id": 3558, "verse_number": "२९", "content_sanskrit": "न स्त्रीणां विद्यते किञ्चिदन्यत्र पुरुषान्तरात् ।\nसापत्निकमृते लोके वर्तते किञ्चिदप्रियम् \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2119055, "chapter_id": 3558, "verse_number": "३०", "content_sanskrit": "सुव्रता चापि कल्याणी सर्वलोकपरिश्रुता ।\nअरुन्धती पर्यशङ्कद् वसिष्ठमृषिसत्तमम् \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2119056, "chapter_id": 3558, "verse_number": "३१", "content_sanskrit": "विशुद्वभावमत्यन्तं सदा प्रियहिते रतम् ।\nसप्तर्षिमध्यगं विप्रमवमेने च तं मुनिम् \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2119057, "chapter_id": 3558, "verse_number": "३२", "content_sanskrit": "अपध्याता च सा तेन ततो धूम्रारुणाकृतिः ।\nलक्ष्यालक्ष्या नातिरूपा निमित्तमिव लक्ष्यते \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2119058, "chapter_id": 3558, "verse_number": "३३", "content_sanskrit": "अपत्यहेतोः सम्प्राप्तं तथा त्वमपि मामिह ।\nइष्टमेवं गतं हित्वा त्वं तथैव च वर्तसे \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2119059, "chapter_id": 3558, "verse_number": "३४", "content_sanskrit": "न वै भार्येति विश्वासः कार्यः पुंसा कथञ्चन ।\nहितं कार्यमनुध्याति भार्या पुत्रवती सती \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2119060, "chapter_id": 3558, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि कविकुलतिलकभाविसमीरश्रीमद्वादिराजतीर्थपूज्य-\nचरणविरचितलक्षालङ्काराख्यटीका समाप्ता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2119061, "chapter_id": 3558, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2119062, "chapter_id": 3558, "verse_number": "३५", "content_sanskrit": "ततस्ते सर्व एवैनं पुत्राः सम्यगुपासते ।\nस च तानात्मजान् राजन्नाश्वासयितुमारभत् \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2119063, "chapter_id": 3558, "verse_number": "", "content_sanskrit": "मन्दपालः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2119064, "chapter_id": 3558, "verse_number": "३६", "content_sanskrit": "युष्माकं परिरक्षार्थं विज्ञप्तो ज्वलनो मया ।\nअग्निना च तथेत्येवं पूर्वमेव प्रतिश्रुतम् \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2119065, "chapter_id": 3558, "verse_number": "३७", "content_sanskrit": "अग्नेर्वचनमादाय मातुर्धर्मज्ञतां च वः ।\nयुष्माकं च परं वीर्यं नाहं पूर्वमिहागतः \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2119066, "chapter_id": 3558, "verse_number": "३८", "content_sanskrit": "न सन्तापो हि वः कार्यः पुत्रका मरणं प्रति ।\nऋषीन् वेद हुताशोऽपि ब्रह्मैतद् विदितं च वः \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2119067, "chapter_id": 3558, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2119068, "chapter_id": 3558, "verse_number": "३९", "content_sanskrit": "एवमाश्वास्य पुत्रांश्च भार्यामादाय भारत ।\nमन्दपालस्ततो देशादन्यं देशं जगाम ह \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2119069, "chapter_id": 3558, "verse_number": "४०", "content_sanskrit": "भगवानपि तिग्मांशुः समिद्धः खाण्डवं वनम् ।\nददाह परमप्रीतः कृष्णाभ्यां परिरक्षितः \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2119070, "chapter_id": 3558, "verse_number": "४१", "content_sanskrit": "वसामेदोवहाः कुल्यास्तत्र पीत्वा च पावकः ।\nअगच्छत् परमां तृप्तिं दर्शयामास चार्जुनम् \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2119071, "chapter_id": 3558, "verse_number": "४२", "content_sanskrit": "ततोऽन्तरिक्षाद् भगवानवतीर्य शतक्रतुः ।\nमरुत्परिवृतः पार्थं माधवं चाब्रवीदिदम् \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2119072, "chapter_id": 3558, "verse_number": "४३", "content_sanskrit": "कृतं युवाभ्यां कर्मेदममरैरपि दुष्करम् ।\nवरान् वृणीतं तृष्टोऽस्मि दुर्लभानप्यमानुषान्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2119073, "chapter_id": 3558, "verse_number": "४४", "content_sanskrit": "पार्थस्तु वरयामास शक्रादस्त्राणि सर्वशः ।\nगृहीतुं तच्च शक्रस्तु ददौ कालं च कर्म च \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2119074, "chapter_id": 3558, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2119075, "chapter_id": 3558, "verse_number": "४५", "content_sanskrit": "यदा प्रसन्नो भगवान् महादेवो भविष्यति ।\nतुभ्यं तदा प्रदास्यामि पाण्डवास्त्राणि सर्वशः \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2119076, "chapter_id": 3558, "verse_number": "४६", "content_sanskrit": "अहमेव च तं कालं वेत्स्यामि कुरुनन्दन ।\nतपसा महता चापि भवतो दास्यामि तान्यहम् \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2119077, "chapter_id": 3558, "verse_number": "४७", "content_sanskrit": "आग्नेयानि च सर्वाणि वायव्यानि धनञ्जय ।\nमदीयानि च सर्वाणि ग्रहीष्यसि धनञ्जय \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2119078, "chapter_id": 3558, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2119079, "chapter_id": 3558, "verse_number": "४८", "content_sanskrit": "वासुदेवोऽपि पार्थेन प्रीतिं वव्रे च शाश्वतीम् ।\nददौ च तस्मै देवेन्द्रस्तं वरं प्रीतिमांस्तदा \t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2119080, "chapter_id": 3558, "verse_number": "४९", "content_sanskrit": "पावकश्चापि तं दावं दग्ध्वा समृगपक्षिणम् ।\nअहोभिरेकविंशद्भिर्विरराम सुतर्पितः \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2119081, "chapter_id": 3558, "verse_number": "५०", "content_sanskrit": "जग्ध्वा मांसानि पीत्वा च मेदांसि रुधिराणि च ।\nयुक्तः परमया प्रीत्या तावुवाच विशाम्पते \t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2119082, "chapter_id": 3558, "verse_number": "५१", "content_sanskrit": "युवाभ्यां पुरुषाग्य्राभ्यां तर्पितोऽस्मि यथासुखम् ।\nअनुजानामि वां वीरौ चरतं यत्र वाञ्छितम् \t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2119083, "chapter_id": 3558, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2119084, "chapter_id": 3558, "verse_number": "५२", "content_sanskrit": "एवं तौ समनुज्ञातौ पावकेन महात्मना ।\nअर्जुनो वासुदेवश्च दानवश्च मयस्तथा \t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2119085, "chapter_id": 3558, "verse_number": "५३", "content_sanskrit": "परिक्रम्य ततः सर्वे त्रयो वै भरतर्षभ ।\nरमणीये नदीकूले सहिताः समुपाविशन् \t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2119086, "chapter_id": 3558, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nसप्तत्रिंशत्यधिकद्विशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2119087, "chapter_id": 3558, "verse_number": "", "content_sanskrit": "॥ इति मयदर्शनपर्वणि षष्ठोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2119088, "chapter_id": 3558, "verse_number": "", "content_sanskrit": "॥ समाप्तं मयदर्शनपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2119089, "chapter_id": 3558, "verse_number": "", "content_sanskrit": "॥ समाप्तम् आदिपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2119090, "chapter_id": 3558, "verse_number": "", "content_sanskrit": "॥ श्रीमन्महाभारते आदिपर्वणि तृतीयसम्पुटं समाप्तम् ॥\n॥ श्रीमध्वेशार्पणमस्तु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}]