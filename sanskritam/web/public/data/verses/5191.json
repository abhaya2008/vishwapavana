[{"id": 2197179, "chapter_id": 5191, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2197180, "chapter_id": 5191, "verse_number": "१", "content_sanskrit": "यदिदं सहधर्मेति प्रोच्यते भरतर्षभ ।\nपाणिग्रहणकाले तु स्त्रीणामेतत् कथं स्मृतम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2197181, "chapter_id": 5191, "verse_number": "२", "content_sanskrit": "आर्ष एष भवेद् धर्मः प्राजापत्योऽथ वाऽऽसुरः ।\nयदेतत् सहधर्मेति पूर्वमुक्तं महर्षिभिः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2197182, "chapter_id": 5191, "verse_number": "३", "content_sanskrit": "सन्देहः सुमहानेष विरुद्ध इति मे मतिः ।\nइह यः सहधर्मो वै प्रेत्यायं विहितः क्व नु\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2197183, "chapter_id": 5191, "verse_number": "४", "content_sanskrit": "स्वर्गो मृतानां भवति सहधर्मः पितामह ।\nपूर्वमेकस्तु म्रियते क्व चैकस्तिष्ठते वद\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2197184, "chapter_id": 5191, "verse_number": "५", "content_sanskrit": "नानाकर्मफलोपेता नानाकर्मनिवासिताः ।\nनानानिरयनिष्ठान्ता मानुषा बहवो यदा\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2197185, "chapter_id": 5191, "verse_number": "६", "content_sanskrit": "अनृताः स्त्रिय इत्येवं सूत्रकारो व्यवस्यति ।\nयदाऽनृताः स्त्रियस्तात सहधर्मः कुतः स्मृतः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2197186, "chapter_id": 5191, "verse_number": "७", "content_sanskrit": "अनृताः स्त्रिय इत्येवं वेदेष्वपि हि पठ्यते ।\nधर्मोऽयं पूर्विको दृष्टः उपचारः क्रियाविधिः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2197187, "chapter_id": 5191, "verse_number": "८", "content_sanskrit": "गह्वरं प्रतिभात्येतन्मम चिन्तयतोऽनिशम् ।\nनिःसन्देहमिदं सर्वं पितामह यथा श्रुतिः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2197188, "chapter_id": 5191, "verse_number": "९", "content_sanskrit": "यदेतद् यादृशं चैतद् यथा चैतत् प्रवर्तितम् ।\nनिखिलेन महाप्राज्ञ भवानेतद् ब्रवीतु मे\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2197189, "chapter_id": 5191, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2197190, "chapter_id": 5191, "verse_number": "१०", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nअष्टावक्रस्य संवादं दिशया सह भारत\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2197191, "chapter_id": 5191, "verse_number": "११", "content_sanskrit": "निर्वेष्टुकामस्तु पुरा अष्टावक्रो महातपाः ।\nऋषेरथ वदान्यस्य कन्यां वव्रे महात्मनः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2197192, "chapter_id": 5191, "verse_number": "१२", "content_sanskrit": "सुप्रभां नाम वै नाम्ना रूपेणाप्रतिमां भुवि ।\nगुणप्रभावशीलेन साध्वीं चारित्रशोभनाम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2197193, "chapter_id": 5191, "verse_number": "१३", "content_sanskrit": "सा तस्य दृष्ट्वैव मनो जहार शुभलोचना ।\nवनराजी यथा चित्रा वसन्ते कुसुमाचिता\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2197194, "chapter_id": 5191, "verse_number": "१४", "content_sanskrit": "अनन्यस्त्रीजनः प्राज्ञो ह्यप्रवासी प्रियंवदः ।\nसुरूपः सम्मतो वीरः शीलवान् भोगभुक् शुचिः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2197195, "chapter_id": 5191, "verse_number": "१५", "content_sanskrit": "दारानुमतयज्ञश्च सुनक्षत्रामथोद्वहेत् ।\nस्वभृत्यस्वजनोपेत इह प्रेत्य च मोदते \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2197196, "chapter_id": 5191, "verse_number": "१६", "content_sanskrit": "ऋषिस्तमाह देया मे सुता तुभ्यं शृणुष्व मे ।\nगच्छ तावद् दिशं पुण्यामुत्तरां द्रक्ष्यसे ततः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2197197, "chapter_id": 5191, "verse_number": "", "content_sanskrit": "अष्टावक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2197198, "chapter_id": 5191, "verse_number": "१७", "content_sanskrit": "किं द्रष्टव्यं मया तत्र वक्तुमर्हति मे भवान् ।\nतथेदानीं मया कार्यं यथा वक्ष्यति मां भवान्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2197199, "chapter_id": 5191, "verse_number": "", "content_sanskrit": "वदान्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2197200, "chapter_id": 5191, "verse_number": "१८", "content_sanskrit": "धनदं समतिक्रम्य हिमवन्तं तथैव च ।\nरुद्रस्यायतनं दृष्ट्वा सिद्धचारणसेवितम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2197201, "chapter_id": 5191, "verse_number": "१९", "content_sanskrit": "संहृष्टैः पार्षदैर्जुष्टं नृत्यद्भिर्विविधाननैः ।\nदिव्याङ्गरागैः पैशाचैर्वन्यैर्नानाविधैस्तथा\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2197202, "chapter_id": 5191, "verse_number": "२०", "content_sanskrit": "पाणिताळसताळैश्च शम्याताळैः समैस्तथा ।\nसम्प्रहृष्टैः प्रनृत्यद्भिः शर्वस्तत्र निषेव्यते\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2197203, "chapter_id": 5191, "verse_number": "२१", "content_sanskrit": "इष्टं किल गिरौ स्थानं तद् दिव्यमनुशुश्रुम ।\nनित्यं सन्निहितो देवस्तथा पारिषदाः शुभाः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2197204, "chapter_id": 5191, "verse_number": "२२", "content_sanskrit": "तत्र देव्या तपस्तप्तं शङ्करार्थं सुदुश्चरम् ।\nअतस्तदिष्टं देवस्य तथोमाया इति श्रुतिः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2197205, "chapter_id": 5191, "verse_number": "२३", "content_sanskrit": "पूर्वे तत्र महान् पार्श्वे देवस्योत्तरतस्तथा ।\nऋतवः काळरात्रिश्च ये दिव्या ये च मानुषाः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2197206, "chapter_id": 5191, "verse_number": "२४", "content_sanskrit": "सर्वे देवमुपासन्ते रूपिणः किल तत्र ह ।\nतदतिक्रम्य भवनं त्वया यातव्यमेव हि\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2197207, "chapter_id": 5191, "verse_number": "२५", "content_sanskrit": "ततो नीलं वनोद्देशं द्रक्ष्यसे मेघसन्निभम् ।\nरमणीयं मनोग्राहि तत्र द्रक्ष्यसि वै स्त्रियम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2197208, "chapter_id": 5191, "verse_number": "२६", "content_sanskrit": "तपस्विनीं महाभागां वृद्धां दीक्षामनुष्ठिताम् ।\nद्रष्टव्या सा त्वया तत्र सम्पूज्या चैव यत्नतः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2197209, "chapter_id": 5191, "verse_number": "२७", "content_sanskrit": "तां दृष्ट्वा विनिवृत्तस्त्वं ततः पाणिं ग्रहीष्यसि ।\nयद्येष समयः सत्यः साध्यतां तत्र गम्यताम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2197210, "chapter_id": 5191, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि\nदानधर्मे अष्टावक्रदिक्संवादे कन्यावरणं नाम द्विचत्वारिंशोऽध्यायः ॥४२॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]