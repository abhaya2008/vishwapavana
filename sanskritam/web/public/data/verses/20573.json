[{"id": 7000573000, "chapter_id": 20573, "verse_number": "५-३२-१", "content_sanskrit": "सुमतिरुवाच ।\nअसावपि नृपः सौम्य सत्यवान्नाम विश्रुतः ।\nनिजधर्मेण लोकेशं रघुनाथमतोषयत्॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000573001, "chapter_id": 20573, "verse_number": "५-३२-२", "content_sanskrit": "अस्मै तुष्टो रमानाथो ददौ भक्तिमचंचलाम् ।\nनिजांघ्रिपद्मे यजतां दुर्लभां पुण्यकोटिभिः॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000573002, "chapter_id": 20573, "verse_number": "५-३२-३", "content_sanskrit": "नित्यं श्रीरघुनाथस्य कथानकमनातुरः ।\nकुरुते सर्वलोकानां पावनं कृपयायुतः॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000573003, "chapter_id": 20573, "verse_number": "५-३२-४", "content_sanskrit": "यो न पूजयते देवं रघुनाथं रमापतिम् ।\nस तेन ताड्यते दंडैर्यमस्यापि भयावहैः॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000573004, "chapter_id": 20573, "verse_number": "५-३२-५", "content_sanskrit": "अष्टमाद्वत्सरादूर्ध्वमशीतिवत्सरो भवेत् ।\nतावदेकादशी सर्वैर्मानुषैः कारिताऽमुना॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000573005, "chapter_id": 20573, "verse_number": "५-३२-६", "content_sanskrit": "तुलसी वल्लभा यस्य कदाचिद्यच्छिरोधराम् ।\nन मुंचति रमानाथ पादपद्मस्रगुत्तमा॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000573006, "chapter_id": 20573, "verse_number": "५-३२-७", "content_sanskrit": "ऋषीणामपि पूज्योयमितरेषां कथं नहि ।\nरघुनाथस्मृतिप्रीतिर्धूतपाप्मा हताशुभः॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000573007, "chapter_id": 20573, "verse_number": "५-३२-८", "content_sanskrit": "ज्ञात्वायं रामचंद्रस्य वाजिनं परमाद्भुतम् ।\nआगत्य तुभ्यं संदास्यत्येतद्राज्यमकंटकम्॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000573008, "chapter_id": 20573, "verse_number": "५-३२-९", "content_sanskrit": "त्वया यद्गदितं राजंस्तत्ते कथितमुत्तमम् ।\nपुनः किं पृच्छसे स्वामिन्नाज्ञापय करोमि तत्॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000573009, "chapter_id": 20573, "verse_number": "५-३२-१०", "content_sanskrit": "शेष उवाच ।\nगतोऽश्वस्तत्पुरांतस्तु नानाश्चर्यसमन्वितः ।\nतं दृष्ट्वा जनताः सर्वा राज्ञे गत्वा न्यवेदयन्॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000573010, "chapter_id": 20573, "verse_number": "५-३२-११", "content_sanskrit": "जनता ऊचुः ।\nकोऽप्यश्वः सितवर्णेन गंगाजलसमेन वै ।\nभाले सौवर्णपत्रेण राजमानः समागतः॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000573011, "chapter_id": 20573, "verse_number": "५-३२-१२", "content_sanskrit": "तच्छ्रुत्वा वचनं रम्यं जनानां हृद्यमीरितम् ।\nताः प्रत्याह हसन्भूपो ज्ञायतां कस्य वै हयः॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000573012, "chapter_id": 20573, "verse_number": "५-३२-१३", "content_sanskrit": "ताश्चैनं कथयामासुः शत्रुघ्नेन प्रपालितः ।\nआयात्यश्वो महीभर्तू रामस्य पुरमध्यतः॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000573013, "chapter_id": 20573, "verse_number": "५-३२-१४", "content_sanskrit": "रामस्य नाम स श्रुत्वा द्व्यक्षरं सुमनोरमम् ।\nजहर्ष चित्ते सुभृशं गद्गदस्वरचिन्हितः॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000573014, "chapter_id": 20573, "verse_number": "५-३२-१५", "content_sanskrit": "मयायोध्यापतिर्नित्यं यो रामश्चिन्त्यते हृदि ।\nतस्याश्वः सहशत्रुघ्नः समायातः पुरं मम॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000573015, "chapter_id": 20573, "verse_number": "५-३२-१६", "content_sanskrit": "हनूमांस्तत्र रामांघ्रिसेवाकर्ता भविष्यति ।\nकदाचिदपि यो रामं न विस्मरति मानसे॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000573016, "chapter_id": 20573, "verse_number": "५-३२-१७", "content_sanskrit": "गच्छामि यत्र शत्रुघ्नो यत्र मारुतनंदनः ।\nअन्येऽपि यत्र पुरुषा रामपादाब्जसेवकाः॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000573017, "chapter_id": 20573, "verse_number": "५-३२-१८", "content_sanskrit": "अमात्यमादिदेशाथ सर्वं राजधनं महत् ।\nगृहीत्वा तु मया सार्द्धमागच्छ त्वरया युतः॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000573018, "chapter_id": 20573, "verse_number": "५-३२-१९", "content_sanskrit": "यास्येऽहं रघुनाथस्य हयं पालयितुं वरम् ।\nकर्तुं च रामपादाब्जपरिचर्यां सुदुर्लभाम्॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000573019, "chapter_id": 20573, "verse_number": "५-३२-२०", "content_sanskrit": "इत्युक्त्वा निर्जगामाथ शत्रुघ्नं प्रति सैनिकैः ।\nतावत्पुरीमथ प्राप्तो रामभ्राता ससैनिकः॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000573020, "chapter_id": 20573, "verse_number": "५-३२-२१", "content_sanskrit": "वीरा गर्जंति प्रबला रथाः सुनिनदंति च ।\nजयशंखस्वनास्तत्र वेणुनादाश्च सर्वतः॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000573021, "chapter_id": 20573, "verse_number": "५-३२-२२", "content_sanskrit": "आगत्य सत्यवान्राजा मंत्रिभिः सुसमन्वितः ।\nचरणे प्रणिपत्यास्मै राज्यं प्रादान्महाधनम्॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000573022, "chapter_id": 20573, "verse_number": "५-३२-२३", "content_sanskrit": "शत्रुघ्नस्तं तु राजानं ज्ञात्वा राममनुव्रतम् ।\nतद्राज्यं तस्य पुत्राय रुक्मनाम्ने ददौ महत्॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000573023, "chapter_id": 20573, "verse_number": "५-३२-२४", "content_sanskrit": "हनूमंतं परीरभ्य सुबाहुं रामसेवकम् ।\nअन्यान्वै रामभक्तांश्च परिरभ्य महायशाः॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000573024, "chapter_id": 20573, "verse_number": "५-३२-२५", "content_sanskrit": "कृतार्थमिव चात्मानं मेने सत्यसमन्वितः ।\nननंद चेतसि तदा शत्रुघ्नेन समन्वितः॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000573025, "chapter_id": 20573, "verse_number": "५-३२-२६", "content_sanskrit": "हयस्तावद्गतो दूरं वीरैः सुपरिरक्षितः ।\nशत्रुघ्नस्तेन भूपेन ययौ वीरसमन्वितः॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]