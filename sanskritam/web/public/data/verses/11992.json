[{"id": 50025195, "chapter_id": 11992, "verse_number": "1", "content_sanskrit": "अतोऽनन्तदोषदुष्टत्वाद् ग्रन्थबहुत्वं स्यादित्येवोपरम्यते।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50025196, "chapter_id": 11992, "verse_number": "2", "content_sanskrit": "॥ त्रयाणामपि भेदाभेदवादानां निरासार्थं युक्त्यन्तराणि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50025197, "chapter_id": 11992, "verse_number": "3", "content_sanskrit": "॥ उपसंहारः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50025198, "chapter_id": 11992, "verse_number": "4", "content_sanskrit": "अतः सर्वप्रमाणविरुद्धत्वान्नाभेदे श्रुतितात्पर्यम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50025199, "chapter_id": 11992, "verse_number": "5", "content_sanskrit": "॥ जीवेश्वराभेदस्य श्रुतितात्पर्यत्वे दोषान्तरकथनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50025200, "chapter_id": 11992, "verse_number": "6", "content_sanskrit": "॥ नाभेदस्वरूपे ब्रह्मणि श्रुतितात्पर्यम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}]