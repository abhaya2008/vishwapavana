[{"id": 50025161, "chapter_id": 11987, "verse_number": "1", "content_sanskrit": "॥ जगन्मिथ्यात्वनिरासः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50025162, "chapter_id": 11987, "verse_number": "2", "content_sanskrit": "॥ मिथ्याया दुर्घटत्वेऽपि जगतो प्रत्यक्षसिद्धत्वान्न युक्तिमात्रेण मिथ्यात्वम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50025163, "chapter_id": 11987, "verse_number": "3", "content_sanskrit": "नच मिथ्यावस्तुनो दुर्घटत्वमेव भूषणम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50025164, "chapter_id": 11987, "verse_number": "4", "content_sanskrit": "॥ प्रमाणसिद्धस्यापि मिथ्यात्वं तु बलवत्प्रमाणबाध एव, सत्यत्वं तु स्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50025165, "chapter_id": 11987, "verse_number": "5", "content_sanskrit": "दृष्टस्य वस्तुनो मिथ्यात्वकल्पनस्य दृष्टिसकाशाद् बलवत्प्रमाणयुक्त्यपेक्षत्वात्। तदभावे सत्यत्वं दृष्ट्यैव सिद्ध्यति। नह्यन्नादिकं भोग्यं दृष्ट्वा भोक्तुं सत्यत्वे प्रमाणान्तरमपेक्षते। किन्तु? नेदमन्नमिति केनचिदुक्ते कथमिदमन्नत्वेन दृश्यमानमन्नं न भवतीति प्रमाणान्तरमपेक्षते।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50025166, "chapter_id": 11987, "verse_number": "6", "content_sanskrit": "॥ युक्तिमात्रस्य न प्रमाणसिद्धसत्यत्वबाधकत्वम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50025167, "chapter_id": 11987, "verse_number": "7", "content_sanskrit": "नच प्रत्यक्षदृष्टस्य ततो बलवत्प्रत्यक्षमागमं विनाऽनुमानादिनैव बाधो दृष्टः। दूरस्थवृक्षह्रस्वत्वादौ प्रत्यक्षापटुत्वस्य निश्चितत्वाद् युक्त्या तत्र दीर्घत्वनिश्चयः। प्रत्यक्षस्य हि दूरे मन्दग्राहित्वं परिमाणादावन्यथात्वं च ततो बलवत्प्रत्यक्षेणैव निश्चितम्। नच जगत्प्रत्यक्षस्य मिथ्यात्वं केनापि प्रमाणेन निश्चितम्। विशेषतश्च ज्ञानाज्ञानसुखदुःखात्मभेदादिविषयस्यानुभवस्य न मिथ्यात्वं दृष्टम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50025168, "chapter_id": 11987, "verse_number": "8", "content_sanskrit": "॥ प्रसङ्गात् जगन्मिथ्यात्वमते दूषणान्तरोक्तिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50025169, "chapter_id": 11987, "verse_number": "9", "content_sanskrit": "अतश्च संसारस्य सत्यत्वात् सत्यस्य चानिवृत्त्यङ्गीकारान्न मोक्षः स्यात्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50025170, "chapter_id": 11987, "verse_number": "10", "content_sanskrit": "॥ जगन्मिथ्यात्वनिरासः - अनुवृत्तः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50025171, "chapter_id": 11987, "verse_number": "11", "content_sanskrit": "॥ युक्तिमात्रेण मिथ्यात्वं न सिद्ध्यतीत्यत्र विपक्षेबाधकोक्तिः - आत्ममिथ्यात्वापादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50025172, "chapter_id": 11987, "verse_number": "12", "content_sanskrit": "अनुभवसिद्धस्य बलवदनुभवं विना युक्तित एव मिथ्यात्वाङ्गीकारे, आत्मनोऽपि मिथ्यात्वं स्यात्। युक्तिश्च - सर्वस्यान्यस्य मिथ्यात्वाङ्गीकारात्, द्विधा कल्पने कल्पनागौरवमिति।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50025173, "chapter_id": 11987, "verse_number": "13", "content_sanskrit": "॥ आत्ममिथ्यात्वापादनपरिहारनिरासः, युक्त्यन्तरेण जगन्मिथ्यात्वनिरासश्च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50025174, "chapter_id": 11987, "verse_number": "14", "content_sanskrit": "आत्माधिष्ठानभ्रमस्यैवादृष्टेस्तस्याधिष्ठानत्वमपि न युज्यते।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]