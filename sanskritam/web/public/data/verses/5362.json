[{"id": 2204679, "chapter_id": 5362, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2204680, "chapter_id": 5362, "verse_number": "१", "content_sanskrit": "भगवन् सर्वभूतेश लोके कर्मक्रियापथे ।\nदैवात् प्रवर्तते सर्वमिति केचिद् व्यवस्थिताः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2204681, "chapter_id": 5362, "verse_number": "२", "content_sanskrit": "अपरे चेष्टया चेति दृष्ट्वा प्रत्यक्षतः क्रियाम् ।\nपक्षभेदे द्विधा चास्मिन् संशयस्थं मनो मम ।\nतत्त्वं वद महादेव श्रोतुं कौतूहलं हि मे\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2204682, "chapter_id": 5362, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2204683, "chapter_id": 5362, "verse_number": "३", "content_sanskrit": "तदहं ते प्रवक्ष्यामि शृणु तत्वं समाहिता ।\nन दैवं कुरुते कर्म लोके देवि शुभाशुभम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2204684, "chapter_id": 5362, "verse_number": "४", "content_sanskrit": "लक्ष्यते द्विविधं कर्म मानुषाणां शुभानने ।\nपुराकृतं तयोरेकमैहिकं च परं तथा\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2204685, "chapter_id": 5362, "verse_number": "५", "content_sanskrit": "अदृष्टं पौर्विकं कर्म तद् दैवमिति लक्ष्यते ।\nऐहिकं दृष्टकरणं तन्मानुषमिति स्मृतम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2204686, "chapter_id": 5362, "verse_number": "६", "content_sanskrit": "मानुषं तु क्रियामात्रं दैवात् सम्भवते फलम् ।\nएवं तदुभयं कर्म मानुषं विद्यते नृषु\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2204687, "chapter_id": 5362, "verse_number": "७", "content_sanskrit": "लौकिकं तत् प्रवक्ष्यामि दैवमानुषनिर्मितम् ।\nकृषौ तु दृश्यते कर्म कर्षणं वपनं तथा\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2204688, "chapter_id": 5362, "verse_number": "८", "content_sanskrit": "रोपणं चैव लवनं यच्चान्यत् पौरुषं स्मृतम् ।\nकाले वृष्टिः सुवापश्च प्ररोहः पक्तिरेव च\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2204689, "chapter_id": 5362, "verse_number": "९", "content_sanskrit": "एवमादि तु यच्चान्यत् तद् दैवतमिति स्मृतम् ।\nप्रवापः पौरुषं कर्म सिद्धिर्दैवमिति स्मृतम् ।\nदैवादसिद्धिश्च भवेद् दुष्कृतं चास्ति पौरुषे\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2204690, "chapter_id": 5362, "verse_number": "१०", "content_sanskrit": "सुयत्नाल्लभ्यते कीर्तिर्दुर्यत्नादयशस्तथा ।\nएवं लोकगतिर्देवि आदिप्रभृति वर्तते\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2204691, "chapter_id": 5362, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2204692, "chapter_id": 5362, "verse_number": "११", "content_sanskrit": "भगवन् सर्वलोकेश सुरासुरनमस्कृत ।\nकथमात्मा सदा गर्भं संविशेत् कर्मकारणात् ।\nतन्मे वद महादेव तद्धि गुह्यं परं मतम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2204693, "chapter_id": 5362, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2204694, "chapter_id": 5362, "verse_number": "१२", "content_sanskrit": "शृणु भामिनि तद् गुह्यं गुह्यानां परमं प्रिये ।\nदेवगुह्यादपि परमात्मगुह्यमिति स्मृतम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2204695, "chapter_id": 5362, "verse_number": "१३", "content_sanskrit": "देवासुरास्तन्न विदुरात्मनो हि गतागतम् ।\nअदृश्यो हि स देवानां शैघ्र्यात् सौक्ष्म्यान्निराश्रयात्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2204696, "chapter_id": 5362, "verse_number": "१४", "content_sanskrit": "अतिमात्रातिमायानामात्ममाया सदेष्यते ।\nसोऽयं चतुर्विधां जातिं संविशत्यात्ममायया ।\nमैथुनं शोणितं बीजं दैवं चाप्यत्र कारणम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2204697, "chapter_id": 5362, "verse_number": "१५", "content_sanskrit": "बीजशोणितसंयोगो यदा सम्भवते शुभे ।\nतदाऽऽत्मा विशते गर्भमेवमण्डजरायुजे\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2204698, "chapter_id": 5362, "verse_number": "१६", "content_sanskrit": "शीतोष्णयोस्तु संयोगे क्लेदजेष्ववतिष्ठति ।\nबीजभूमिजलानां तु योगादुद्भेदजेषु च ।\nएवं संयोगकाले तु आत्मा गर्भत्वमेयिवान्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2204699, "chapter_id": 5362, "verse_number": "१७", "content_sanskrit": "कललाज्जायते पिण्डं पिण्डात् पेश्यर्बुदं भवेत् ।\nव्यक्तिभावं गते चैव कर्म त्वाश्रयते क्रमात्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2204700, "chapter_id": 5362, "verse_number": "१८", "content_sanskrit": "एवं स्त्रीपुरुषसंयोगं पौरुषं विद्धि भामिनि ।\nअपत्यलाभो यच्चान्यत् तद् दैवमिति संस्मृतम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2204701, "chapter_id": 5362, "verse_number": "१९", "content_sanskrit": "पञ्चभूतस्थितिश्चैव ज्योतिषामयनं तथा ।\nअबुद्धिगम्यं यन्मर्त्यैर्हेतुभिर्वा न विद्यते\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2204702, "chapter_id": 5362, "verse_number": "२०", "content_sanskrit": "तादृशं कारणं दैवं शुभं वा यदि वेतरत् ।\nयादृशं चात्मना शक्यं तत् पौरुषमिति स्मृतम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2204703, "chapter_id": 5362, "verse_number": "२१", "content_sanskrit": "केवलं फलनिष्पत्तिरेकेन न तु शक्यते ।\nपौरुषेणैव दैवेन युगपद् ग्रथितं प्रिये ।\nतयोः समाहितं कर्म शीतोष्णं युगपत् तथा\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2204704, "chapter_id": 5362, "verse_number": "२२", "content_sanskrit": "पौरुषं तु तयोः पूर्वमारब्धव्यं विजानता ।\nआत्मना नैव शक्यं हि न तथा कीर्तिमाप्नुयात्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2204705, "chapter_id": 5362, "verse_number": "२३", "content_sanskrit": "खननान्मथनाल्लोके जलाग्निप्रापणं यथा ।\nतथा पुरुषकारे तु दैवसम्पत् समाहिता\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2204706, "chapter_id": 5362, "verse_number": "२४", "content_sanskrit": "नरस्याकुर्वतः कर्म दैवसम्पन्न लभ्यते ।\nतस्मात् सर्वसमारम्भो दैवमानुषनिर्मितः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2204707, "chapter_id": 5362, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2204708, "chapter_id": 5362, "verse_number": "२५", "content_sanskrit": "भगवन् मृतमात्रस्तु योऽयं जात इति स्मृतः ।\nतथैव दृश्यते जातस्तत्रात्मा तु कथं भवेत्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2204709, "chapter_id": 5362, "verse_number": "२६", "content_sanskrit": "गर्भादावेव संविष्ट आत्मा तु भगवन् मतम् ।\nएष मे संशयो देव तन्मे छेत्तुं त्वमर्हसि\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2204710, "chapter_id": 5362, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2204711, "chapter_id": 5362, "verse_number": "२७", "content_sanskrit": "तदहं ते प्रवक्ष्यामि शृणु तत्त्वं समाहिता\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2204712, "chapter_id": 5362, "verse_number": "२८", "content_sanskrit": "अन्यो गर्भगतो भूत्वा तत्रैव निधनं गतः ।\nपुनरन्यः शरीरं तदाविश्य भुवि जायते ।\nतत् क्वचिन्नैव सर्वत्र दैवयोगं तु तद् भवेत्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2204713, "chapter_id": 5362, "verse_number": "२९", "content_sanskrit": "सूतिकाया हितार्थं च मोहनार्थं च देहिनाम् ।\nसमकर्मविधानं तदित्येवं विद्धि शोभने\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2204714, "chapter_id": 5362, "verse_number": "३०", "content_sanskrit": "कौक्षमात्रं तु नरकं भुक्त्वा केचित् प्रयान्ति हि ।\nमाया सा यामिका नाम यज्जन्ममरणान्तरे ।\nइति ते कथितं देवि भूयः श्रोतुं किमिच्छसि\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2204715, "chapter_id": 5362, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे दैवपुरुषकारयोर्मेलनकथनं नाम त्रयोदशोत्तरशततमोऽध्यायः ॥२१३॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]