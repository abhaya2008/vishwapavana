[{"id": 7002930000, "chapter_id": 22930, "verse_number": "१-७-१", "content_sanskrit": "सौतिरुवाच ।\nतदा ब्रह्मा तपः कृत्वा सिद्धिं प्राप्य यथेप्सिताम् ।\nससृजे पृथिवीमादौ मधुकैटभमेदसा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002930001, "chapter_id": 22930, "verse_number": "१-७-२", "content_sanskrit": "ससृजे पर्वतानष्टौ प्रधानान्सुमनोहरान् ।\nक्षुद्रानसंख्यान्किं ब्रूमः प्रधानाख्यां निशामय ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002930002, "chapter_id": 22930, "verse_number": "१-७-३", "content_sanskrit": "सुमेरुं चैव कैलासं मलयं च हिमालयम् ।\nउदयं च तथाऽस्तं च सुवेलं गन्धमादनम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002930003, "chapter_id": 22930, "verse_number": "१-७-४", "content_sanskrit": "समुद्रान्ससृजे सप्त नदान्कतिविधा नदीः ।\nवृक्षांश्च ग्रामनगरं समुद्राख्या निशामय ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002930004, "chapter_id": 22930, "verse_number": "१-७-५", "content_sanskrit": "लवणेक्षुसुरासर्पिर्दधिदुग्धजलार्णवान् ।\nलक्षयोजनमानेन द्विगुणांश्च परात्परान् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002930005, "chapter_id": 22930, "verse_number": "१-७-६", "content_sanskrit": "सप्तद्वीपांश्च तद्भूमिमण्डले कमलाकृते ।\nउपद्वीपांस्तथा सप्तसीमाशैलांश्च सप्त च ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002930006, "chapter_id": 22930, "verse_number": "१-७-७", "content_sanskrit": "निबोध विप्र द्वीपाख्यां पुरा या विधिना कृता ।\nजम्बूशाककुशप्लक्षक्रौञ्चन्यग्रोधपौष्करान् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002930007, "chapter_id": 22930, "verse_number": "१-७-८", "content_sanskrit": "मेरोरष्टसु शृङ्गेषु ससृजेऽष्टौ पुरी प्रभुः ।\nअष्टानां लोकपालानां विहाराय मनोहराः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002930008, "chapter_id": 22930, "verse_number": "१-७-९", "content_sanskrit": "मूलेऽनन्तस्य नगरीं निर्माय जगतां पतिः ।\nऊर्ध्वे स्वर्गांश्च सप्तैव तेषामाख्या निशामय ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002930009, "chapter_id": 22930, "verse_number": "१-७-१०", "content_sanskrit": "भूर्लोकं च भुवर्लोकं स्वर्लोकं सुमनोहरम् ।\nजनोलोकं तपोलोकं सत्यलोकं च शौनक ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002930010, "chapter_id": 22930, "verse_number": "१-७-११", "content_sanskrit": "शृङ्गमूर्ध्नि ब्रह्मलोकं जरादिपरिवर्जितम् ।\nतदूर्ध्वे ध्रुवलोकं च सर्वतः सुमनोहरम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002930011, "chapter_id": 22930, "verse_number": "१-७-१२", "content_sanskrit": "तदधः सप्त पातालान्निर्ममे जगदीश्वरः ।\nस्वर्गातिरिक्तभोगाढ्यानधोधः क्रमतो मुने ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002930012, "chapter_id": 22930, "verse_number": "१-७-१३", "content_sanskrit": "अतलं वितलं चैव सुतलं च तलातलम् ।\nमहातलं च पातालं रसातलमधस्ततः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002930013, "chapter_id": 22930, "verse_number": "१-७-१४", "content_sanskrit": "सप्तद्वीपैः सप्तनाकैः सप्तपातालसंज्ञकैः ।\nएभिर्लोकैश्च ब्रह्माण्डं ब्रह्माधिकृतमेव च ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002930014, "chapter_id": 22930, "verse_number": "१-७-१५", "content_sanskrit": "एवञ्चासंख्यब्रह्माण्डं सर्वं कृत्रिममेव च ।\nमहाविष्णोश्च लोम्नां च विवरेषु च शौनक ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002930015, "chapter_id": 22930, "verse_number": "१-७-१६", "content_sanskrit": "प्रतिविश्वेषु दिक्पाला ब्रह्मविष्णुमहेश्वराः ।\nसुरा नरादयः सर्वे सन्ति कृष्णस्य मायया ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002930016, "chapter_id": 22930, "verse_number": "१-७-१७", "content_sanskrit": "ब्राह्माण्डगणनां कर्तुं न क्षमो जगतां पतिः ।\nन शङ्करो न धर्मश्च न च विष्णुश्च के सुराः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002930017, "chapter_id": 22930, "verse_number": "१-७-१८", "content_sanskrit": "संख्यातुमीश्वरः शक्तो न संख्यातुं तथापि सः ।\nविश्वाकाशदिशां चैव सर्वतो यद्यपि क्षमः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002930018, "chapter_id": 22930, "verse_number": "१-७-१९", "content_sanskrit": "कृत्रिमाणि च विश्वानि विश्वस्थानि च यानि च ।\nअनित्यानि च विप्रेन्द्र स्वप्नवन्नश्वराणि च ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002930019, "chapter_id": 22930, "verse_number": "१-७-२०", "content_sanskrit": "वैकुण्ठः शिवलोकश्च गोलोकश्च तयोः परः ।\nनित्यो विश्वबहिर्भूतश्चात्माकाशदिशो यथा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]