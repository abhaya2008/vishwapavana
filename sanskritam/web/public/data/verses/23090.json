[{"id": 7003090000, "chapter_id": 23090, "verse_number": "४-२६-१", "content_sanskrit": "नारद उवाच ।\nद्वादशीलङ्घने दोषः श्रुतस्त्वन्मुखतो मुने ।\nपराभवो मुनेश्चैव नृपत्राणं हरेरहो ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003090001, "chapter_id": 23090, "verse_number": "४-२६-२", "content_sanskrit": "अधुना श्रोतुमिच्छामि सर्वेषामीप्सितं च मे ।\nएकादशीव्रतस्यास्य विधानं वद निश्चितम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003090002, "chapter_id": 23090, "verse_number": "४-२६-३", "content_sanskrit": "अहो श्रुतौ श्रुतं किंचिन्मतभेदान्न निश्चितम् ।\nश्रुतीनां कारणमुखाच्छ्रोतुं कौतूहलं मम ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003090003, "chapter_id": 23090, "verse_number": "४-२६-४", "content_sanskrit": "नारायण उवाच ।\nएकादशीव्रतमिदं देवानामपि दुर्लभम् ।\nश्रीकृष्णप्रीतिजनकं तपः श्रेष्ठं तपस्विनाम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003090004, "chapter_id": 23090, "verse_number": "४-२६-५", "content_sanskrit": "देवानां च यथा कृष्णो देवीनां प्रकृतिर्यथा ।\nआश्रमाणां यथा विप्रो वैष्णवानां यथा शिवः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003090005, "chapter_id": 23090, "verse_number": "४-२६-६", "content_sanskrit": "यथा गणेशः पूज्यानां यथा वाणी विपश्चिताम् ।\nशास्त्राणां च यथा वेदास्तीर्थानां जाह्नवी यथा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003090006, "chapter_id": 23090, "verse_number": "४-२६-७", "content_sanskrit": "तैजसानां यथा स्वर्णं प्राणिनां वैष्णवो यथा ।\nधनानां च यथा विद्या सङ्गिनां च यथा प्रिया ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003090007, "chapter_id": 23090, "verse_number": "४-२६-८", "content_sanskrit": "प्रमथानां यथा रुद्रः श्रेयसां च यथा मतिः।\nआत्मा यथेन्द्रियाणां च चञ्चलानां यथा मनः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003090008, "chapter_id": 23090, "verse_number": "४-२६-९", "content_sanskrit": "गुरुस्त्रीणां यथा माता बन्धूनां च यथा पतिः ।\nबलिष्ठानां यथा दैवं कालः कलयतां यथा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003090009, "chapter_id": 23090, "verse_number": "४-२६-१०", "content_sanskrit": "सुशीलं चैव मित्राणां शत्रूणां रुग्यथा मुने ।\nयथा कीर्तिः कीर्तिमतां गृहिणां च यथा गृहम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003090010, "chapter_id": 23090, "verse_number": "४-२६-११", "content_sanskrit": "यथा खलो हिंसकानां दुष्टानां चैव पुंश्चली ।\nतेजस्विनां ग्रहेशश्च सहिष्णूनां यथा क्षितिः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003090011, "chapter_id": 23090, "verse_number": "४-२६-१२", "content_sanskrit": "यथाऽमृतं भक्षणानां दाहकानां यथाऽनलः ।\nयथा श्रीर्धनदातॄणां सतीनां च यथा सती ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003090012, "chapter_id": 23090, "verse_number": "४-२६-१३", "content_sanskrit": "प्रजेशानां यथा ब्रह्मा सरितां सागरो यथा ।\nयथा साम श्रुतीनां च गायत्री छन्दसां यथा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003090013, "chapter_id": 23090, "verse_number": "४-२६-१४", "content_sanskrit": "वृक्षाणां च यथाऽश्वत्थः पुष्पाणां तुलसी यथा ।\nयथा मार्गो हि मासानामृतूनां च यथा मधुः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003090014, "chapter_id": 23090, "verse_number": "४-२६-१५", "content_sanskrit": "आदित्यानां यथा सूर्यो रुद्राणां शंकरो यथा।\nयथा भीष्मो वसूनां च वर्षाणां भारतं यथा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003090015, "chapter_id": 23090, "verse_number": "४-२६-१६", "content_sanskrit": "देवर्षीणां यथा त्वं च ब्रह्मर्षीणां यथा भृगुः ।\nनृपाणां च यथा रामः सिद्धानां कपिलो यथा ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003090016, "chapter_id": 23090, "verse_number": "४-२६-१७", "content_sanskrit": "यथा सनत्कुमारश्च योगिनां ज्ञानिनां वरः ।\nऐरावतो गजेन्द्राणां पशूनां शरभो यथा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003090017, "chapter_id": 23090, "verse_number": "४-२६-१८", "content_sanskrit": "यथा हिमाद्रिः शैलानां मणीनां कौस्तुभो यथा ।\nसरस्वती नदीनां च यथा पुण्यस्वरूपिणी ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003090018, "chapter_id": 23090, "verse_number": "४-२६-१९", "content_sanskrit": "गन्धर्वाणां चित्ररथो यथा श्रेष्ठश्च नारद ।\nयथा कुबेरो यक्षाणां सुमाली रक्षसां यथा ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003090019, "chapter_id": 23090, "verse_number": "४-२६-२०", "content_sanskrit": "यथा श्रेष्ठा च नारीणां शतरूपा वरा परा ।\nमनूनां च यथा श्रेष्ठः स्वयं स्वायंभुवो मनुः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003090020, "chapter_id": 23090, "verse_number": "४-२६-२१", "content_sanskrit": "सुन्दरीणां यथा रम्भा यथा माया च मायिनाम् ।\nएकादशीव्रतमिदं व्रतानां च वरं तथा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003090021, "chapter_id": 23090, "verse_number": "४-२६-२२", "content_sanskrit": "कर्तव्यं च चतुर्णां च वर्णानां नित्यमेव च ।\nयतीनां वैष्णवानां ब्राह्मणानां विशेषतः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003090022, "chapter_id": 23090, "verse_number": "४-२६-२३", "content_sanskrit": "सत्यं सर्वाणि पापानि ब्रह्महत्यादिकानि च ।\nसन्त्येवौदनमाश्रित्य श्रीकृष्णव्रतवासरे ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003090023, "chapter_id": 23090, "verse_number": "४-२६-२४", "content_sanskrit": "भुक्त्वैतानि च पापानि यो भुङ्क्ते तत्र मन्दधीः ।\nइहातिपातकी सोऽपि यात्यन्ते नरकं ध्रुवम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003090024, "chapter_id": 23090, "verse_number": "४-२६-२५", "content_sanskrit": "एकादशीप्रमाणानि युगसंख्याकृतानि च ।\nकुम्भीपाके महाघोरे स्थित्वा चण्डालतां व्रजेत् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003090025, "chapter_id": 23090, "verse_number": "४-२६-२६", "content_sanskrit": "गलितव्याधियुक्तश्च ततः सप्तसु जन्मसु। ।\nपश्चान्मुक्तो भवेत्पापादित्याह कमलोद्भवः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003090026, "chapter_id": 23090, "verse_number": "४-२६-२७", "content_sanskrit": "इत्येवं कथितं ब्रह्मन्यो दोषस्तत्र भोजने ।\nद्वादशीलङ्घने दोषो मयोक्तश्च श्रुतः पुरा ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003090027, "chapter_id": 23090, "verse_number": "४-२६-२८", "content_sanskrit": "दशमीलङ्घने दोषं निबोध कथयामि ते ।\nपुरा श्रुतो धर्मवक्त्राद्वेदसारोद्धृतोऽपि च ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003090028, "chapter_id": 23090, "verse_number": "४-२६-२९", "content_sanskrit": "दशमीं यः कलामात्रां मूढोऽज्ञानेन लङ्घयेत् ।\nयाति श्रीस्तद्गृहात्तूर्णं शापं दत्त्वा तु दारुणम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003090029, "chapter_id": 23090, "verse_number": "४-२६-३०", "content_sanskrit": "इह तद्वंशहानिश्च यशोहानिर्भवेद्ध्रुवम् ।\nअन्ते मन्वन्तरशतमन्धकूपे वसेद्द्विज ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003090030, "chapter_id": 23090, "verse_number": "४-२६-३१", "content_sanskrit": "दशम्येकादशी वापि द्वादशी यत्र वासरे ।\nतत्र भुक्त्वा परदिने उपोष्य व्रतमाचरेत् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003090031, "chapter_id": 23090, "verse_number": "४-२६-३२", "content_sanskrit": "द्वादश्यां च व्रतं कृत्वा त्रयोदश्यां च पारणम् ।\nद्वादशीलङ्घने दोषो व्रतिनां तन्न विद्यते ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003090032, "chapter_id": 23090, "verse_number": "४-२६-३३", "content_sanskrit": "संपूर्णैकादशी यत्र प्रभाते किंचिदेव सा।\nतत्रोपोष्या द्वितीया च परा चेद्यदि वर्धते ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003090033, "chapter_id": 23090, "verse_number": "४-२६-३४", "content_sanskrit": "षष्टिदण्डात्मिका यत्र प्रभाते च तिथित्रयम् ।\nकुर्वन्ति गृहिणः पूर्वं चैव यत्यादयस्तथा ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003090034, "chapter_id": 23090, "verse_number": "४-२६-३५", "content_sanskrit": "परत्रानशनं कृत्वा नित्यकृत्यं समाचरेत् ।\nव्रते जागरणं सर्वं पूर्वत्रैवाचरेद्बुधः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003090035, "chapter_id": 23090, "verse_number": "४-२६-३६", "content_sanskrit": "तत्पूर्वदिवसे नित्यं व्रते कृत्वा परेऽहनि ।\nएकादश्यां व्यतीतायां पारणं तु समाचरेत् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003090036, "chapter_id": 23090, "verse_number": "४-२६-३७", "content_sanskrit": "वैष्णवानां यतीनां च विधवानां तथैव च ।\nसर्वाः समा उपोष्यास्ता भिक्षूणां ब्रह्मचारिणाम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003090037, "chapter_id": 23090, "verse_number": "४-२६-३८", "content_sanskrit": "शुक्लामेव तु कुर्वन्ति गृहिणो वैष्णवेतराः ।\nन कृष्णालङ्घने दोषस्तेषां वेदेषु नारद ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003090038, "chapter_id": 23090, "verse_number": "४-२६-३९", "content_sanskrit": "शयनीबोधिनीमध्ये या कृष्णैकादशी भवेत् ।\nसैवोपोष्या गृहस्थेन नान्या कृष्णा कदाचन ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003090039, "chapter_id": 23090, "verse_number": "४-२६-४०", "content_sanskrit": "इत्येवं कथितो ब्रह्मन्निर्णयोऽयं श्रुतौ श्रुतः ।\nव्रतस्यास्य विधानं च निबोध कथयामि ते ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003090040, "chapter_id": 23090, "verse_number": "४-२६-४१", "content_sanskrit": "कृत्वा हविष्यं पूर्वाह्णे न च भुङ्क्ते पुनर्जलम् ।\nएकाकी कुशशय्यायां नक्तं शयनमाचरेत् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003090041, "chapter_id": 23090, "verse_number": "४-२६-४२", "content_sanskrit": "ब्राह्मे मुहूर्ते चोत्थाय प्रातःकृत्यं विधाय च ।\nनित्यकृत्यं विधायाथ ततः स्नानं समाचरेत् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003090042, "chapter_id": 23090, "verse_number": "४-२६-४३", "content_sanskrit": "व्रतोपवासं संकल्प्य श्रीकृष्णप्रीतिपूर्वकम् ।\nकृत्वा सन्ध्यां तर्पणं च विधायाह्निकमाचरेत् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003090043, "chapter_id": 23090, "verse_number": "४-२६-४४", "content_sanskrit": "नित्यपूजां दिने कृत्वा व्रतद्रव्यं समाहरेत् ।\nकृत्वा षोडशोपचारं प्रदृष्टं विधिबोधितम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003090044, "chapter_id": 23090, "verse_number": "४-२६-४५", "content_sanskrit": "आसनं वसनं पाद्यमर्घ्यं पुष्पानुलेपनम् ।\nधूपं दीपं च नैवेद्यं यज्ञसूत्रं च भूषणम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003090045, "chapter_id": 23090, "verse_number": "४-२६-४६", "content_sanskrit": "गन्धं स्नानीयताम्बूले मधुपर्कं पुनर्जलम् ।\nएतान्याहृत्य दिवसे व्रतं नक्तं समाचरेत् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003090046, "chapter_id": 23090, "verse_number": "४-२६-४७", "content_sanskrit": "उपविश्यासने पूतो धृत्वा धौतेयवाससी ।\nआचम्य श्रीहरिं नत्वा स्वस्तिवाचनमाचरे त्४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003090047, "chapter_id": 23090, "verse_number": "४-२६-४८", "content_sanskrit": "आरोप्य मङ्गलघटं धान्याधारे शुभे क्षणे ।\nफलशाखाचंदनाक्तं वेदोक्तं मुनिभिर्मुदा ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003090048, "chapter_id": 23090, "verse_number": "४-२६-४९", "content_sanskrit": "देवषट्कं समावाह्य पृथग्धान्यैः समाचरेत् ।\nपूजां पञ्चोपचारैश्च प्रकृष्टैश्च विचक्षणः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003090049, "chapter_id": 23090, "verse_number": "४-२६-५०", "content_sanskrit": "गणेश्वरं दिनकरं वह्निं विष्णुं शिवं शिवाम् ।\nसंपूज्यैतान्प्रणम्याथ व्रतं कुर्याद्धरिं स्मरन् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003090050, "chapter_id": 23090, "verse_number": "४-२६-५१", "content_sanskrit": "नाराध्य देवषट्कं च यदि कर्म समाचरेत् ।\nनित्यं नैमित्तिकं चापि तत्सर्वं निष्फलं भवेत् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003090051, "chapter_id": 23090, "verse_number": "४-२६-५२", "content_sanskrit": "इत्येवं कथितं सर्वं व्रताङ्गभूतमेव च ।\nकण्वशाखोक्तमिष्टं च व्रतं शृणु महामुने ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003090052, "chapter_id": 23090, "verse_number": "४-२६-५३", "content_sanskrit": "सामवेदोक्तध्यानेन ध्यात्वा कृष्णं परात्परम् ।\nपुष्पं च शिरसि न्यस्य पुनर्ध्यानं समाचरेत् ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003090053, "chapter_id": 23090, "verse_number": "४-२६-५४", "content_sanskrit": "ध्यानं शृणु निगूढं च सर्वेषामपि वाञ्छितम् ।\nन प्रकाश्यमभक्ताय भक्तप्राणाधिकं परम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003090054, "chapter_id": 23090, "verse_number": "४-२६-५५", "content_sanskrit": "नवीननीरदो यद्वच्छ्यामसुन्दरविग्रहम् ।\nशरत्पार्वणचन्द्राभाविनिन्द्यास्यमनुत्तमम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003090055, "chapter_id": 23090, "verse_number": "४-२६-५६", "content_sanskrit": "शरत्सूर्योदयाब्जानां प्रभामोचनलोचनम्। ।\nस्वांगसौंदर्यशोभाभी रत्नभूषणभूषितम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003090056, "chapter_id": 23090, "verse_number": "४-२६-५७", "content_sanskrit": "गोपीलोचनकोणैश्च प्रसन्नैरतिसूचकैः ।\nशश्वन्निरीक्ष्यमाणं तत्प्राणैरिव विनिर्मितम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003090057, "chapter_id": 23090, "verse_number": "४-२६-५८", "content_sanskrit": "रासमण्डलमध्यस्थं रासोल्लाससमुत्सुकम्।\nराधावक्त्रशरच्चन्द्रसुधापानचकोरकम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003090058, "chapter_id": 23090, "verse_number": "४-२६-५९", "content_sanskrit": "कौस्तुभेन मणीन्द्रेण वक्षःस्थलसमुज्ज्वलम्। ।\nपारिजातप्रसूनानां मालाजालैर्विराजितम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003090059, "chapter_id": 23090, "verse_number": "४-२६-६०", "content_sanskrit": "सद्रत्नसारनिर्माणं किरीटोज्ज्वलशेखरम् ।\nविनोदमुरलीन्यस्तहस्तं पूज्यं सुरासुरैः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003090060, "chapter_id": 23090, "verse_number": "४-२६-६१", "content_sanskrit": "ध्यानासाध्यं दुराराध्यं ब्रह्मादीनां च वन्दितम् ।\nकारणं कारणानां यस्तमीश्वरमहं भजे ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003090061, "chapter_id": 23090, "verse_number": "४-२६-६२", "content_sanskrit": "ध्यात्वाऽनेन तमावाह्य चोपहाराणि षोडश ।\nदत्त्वा संपूजयेद्भक्त्या मन्त्रैरेभिश्च नारद ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003090062, "chapter_id": 23090, "verse_number": "४-२६-६३", "content_sanskrit": "आसनं स्वर्णनिर्माणं रत्नसारपरिच्छदम् ।\nनानाचित्र विचित्राढ्यं गृह्यतां परमेश्वर ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003090063, "chapter_id": 23090, "verse_number": "४-२६-६४", "content_sanskrit": "वह्निप्रक्षालितं वस्त्रं निर्मितं विश्वकर्मणा ।\nमूल्यानिर्वचनीयं च गृह्यतां राधिकापते ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003090064, "chapter_id": 23090, "verse_number": "४-२६-६५", "content_sanskrit": "पादप्रक्षालनार्हं च सुवर्णपात्रसंस्थितम् ।\nसुवासितं शीतलं च गृह्यतां करुणानिधे ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003090065, "chapter_id": 23090, "verse_number": "४-२६-६६", "content_sanskrit": "इदमर्घ्यं पवित्रं च शङ्खतोयसमन्वितम् ।\nपुष्पदूर्वाचन्दनाक्तं गृह्यतां भक्तवत्सल ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003090066, "chapter_id": 23090, "verse_number": "४-२६-६७", "content_sanskrit": "सुवासितं शुक्लपुष्पं चन्दनागुरुसंयुतम् ।\nसद्यस्ते प्रीतिजनकं गृह्यतां सर्वकारण ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003090067, "chapter_id": 23090, "verse_number": "४-२६-६८", "content_sanskrit": "चन्दनागुरुकस्तूरीकुङ्कुमोशीरमुत्तमम् ।\nसर्वेप्सितमिदं कृष्ण गृह्यतामनुलेपनम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003090068, "chapter_id": 23090, "verse_number": "४-२६-६९", "content_sanskrit": "रसो वृक्षविशेषस्य नानाद्रव्यसमन्वितः।\nसुगन्धियुक्तः सुखदो धूपोऽयं प्रतिगृह्यताम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003090069, "chapter_id": 23090, "verse_number": "४-२६-७०", "content_sanskrit": "दिवानिशं सुप्रदीप्तो रत्नसारविनिर्मितः ।\nपुनर्ध्वान्तनाशबीजं दीपोऽयं प्रतिगृह्यताम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003090070, "chapter_id": 23090, "verse_number": "४-२६-७१", "content_sanskrit": "नानाविधानि द्रव्याणि स्वादूनि सुरभीणि च ।\nचोष्यादीनि पवित्राणि स्वात्माराम प्रगृह्यताम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003090071, "chapter_id": 23090, "verse_number": "४-२६-७२", "content_sanskrit": "सावित्रीग्रन्थिसयुक्तं स्वर्णतन्तुविनिर्मितम् ।\nगृह्यतां देवदेवेश रचितं चारु कारुणा ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003090072, "chapter_id": 23090, "verse_number": "४-२६-७३", "content_sanskrit": "अमूल्यरत्नरचितं सर्वा वयवभूषणम्। ।\nत्विषा जाज्वल्यमानं च गृह्यतां नन्दनन्दन ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003090073, "chapter_id": 23090, "verse_number": "४-२६-७४", "content_sanskrit": "प्रधानो वर्णनीयश्च सर्वमङ्गलकर्मणि ।\nप्रगृह्यतां दीनबन्धो गन्धोऽयं मङ्गलप्रदः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003090074, "chapter_id": 23090, "verse_number": "४-२६-७५", "content_sanskrit": "धात्री श्रीफलपत्रोत्थं विष्णुतैलं मनोहरम्। ।\nवाञ्छितं सर्वलोकानां भगवन्प्रतिगृह्यताम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003090075, "chapter_id": 23090, "verse_number": "४-२६-७६", "content_sanskrit": "वाञ्छनीयं च सर्वेषां कर्पूरादिसुवासितम्। ।\nमया निवेदितं नाथ ताम्बूलं प्रतिगृह्यताम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003090076, "chapter_id": 23090, "verse_number": "४-२६-७७", "content_sanskrit": "सर्वेषां प्रीतिजनकं सुमिष्टं मधुरं मधु।\nसद्रत्नसारपात्रस्थं गोपीकान्त प्रगृह्यताम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003090077, "chapter_id": 23090, "verse_number": "४-२६-७८", "content_sanskrit": "निर्मलं जाह्नवीतोयं सुपवित्रं सुवासितम् ।\nपुनराचमनीयं च गृह्यतां मधुसूदन ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003090078, "chapter_id": 23090, "verse_number": "४-२६-७९", "content_sanskrit": "इति षोडशोपचारान्दत्त्वा भक्तो मुदाऽन्वितः ।\nमन्त्रेणानेन पुष्पाणि माल्यं दत्त्वा प्रयत्नतः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003090079, "chapter_id": 23090, "verse_number": "४-२६-८०", "content_sanskrit": "नानाप्रकारपुष्पैश्च ग्रथितं शुक्लतन्तुना ।\nप्रवरं भूषणानां च माल्यं च गृह्यतां प्रभो ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003090080, "chapter_id": 23090, "verse_number": "४-२६-८१", "content_sanskrit": "इति पुष्पाञ्जलिं दद्यान्मूलमन्त्रेण च व्रती ।\nकुर्यात्तत्स्तवनं भक्त्या पुटाञ्जलियुतः सुधीः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003090081, "chapter_id": 23090, "verse_number": "४-२६-८२", "content_sanskrit": "भक्त उवाच ।\nहे कृष्ण राधिकानाथ करुणासागर प्रभो ।\nसंसारसागरे घोरे मामुद्धर भयानके ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003090082, "chapter_id": 23090, "verse_number": "४-२६-८३", "content_sanskrit": "शतजन्मकृतायासादुद्विग्नस्य मम प्रभो ।\nस्वकर्मपाशनिगडैर्बद्धस्य मोक्षणं कुरु ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003090083, "chapter_id": 23090, "verse_number": "४-२६-८४", "content_sanskrit": "प्रणतं पादपद्मे ते पश्य मां शरणागतम् ।\nभवपाशभयाद्भीतं पाहि त्वं शरणागतम् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003090084, "chapter_id": 23090, "verse_number": "४-२६-८५", "content_sanskrit": "भक्तिहीनं क्रियाहीनं विधिहीनं च वेदतः ।\nवस्तुमन्त्रविहीनं यत्तत्संपूर्णं कुरु प्रभो ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003090085, "chapter_id": 23090, "verse_number": "४-२६-८६", "content_sanskrit": "वेदोक्तविहिताऽज्ञानात्स्वाङ्गहीने च कर्मणि ।\nत्वन्नामोच्चारणेनैव सर्वं पूर्णं भवेद्धरे ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003090086, "chapter_id": 23090, "verse_number": "४-२६-८७", "content_sanskrit": "इति स्तुत्वा तं प्रणम्य दत्त्वा विप्राय दक्षिणाम् ।\nमहोत्सवं विधायाथ कुर्याज्जागरणं व्रती ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003090087, "chapter_id": 23090, "verse_number": "४-२६-८८", "content_sanskrit": "कृत्वा व्रतोपवासं च यदि निद्रां निषेवते ।\nपुनरेव जलं भुङ्क्ते व्रतार्धफलभाग्भवेत् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003090088, "chapter_id": 23090, "verse_number": "४-२६-८९", "content_sanskrit": "यत्नेन च हविष्यान्नं सकृदेव समाचरेत् ।\nमन्त्रेणानेन विप्रेन्द्र श्रीकृष्णचरणं स्मरन् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003090089, "chapter_id": 23090, "verse_number": "४-२६-९०", "content_sanskrit": "अन्नं हि प्राणिनां प्राणा ब्रह्मणा निर्मितं पुरा ।\nदेहि मे विष्णुरूपं त्वं व्रतोपवासयोः फलम् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003090090, "chapter_id": 23090, "verse_number": "४-२६-९१", "content_sanskrit": "एवं यः कुरुते भक्त्या भारते व्रतमुत्तमम् ।\nपूर्वान्सप्त परान्सप्त स्वात्मानमुद्धरेद्ध्रुवम् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003090091, "chapter_id": 23090, "verse_number": "४-२६-९२", "content_sanskrit": "मातरं भ्रातरं चैव श्वश्रूं  च श्वशुरं सुताम् ।\nजामातरं तथा भृत्यमुद्धरेन्निश्चितं नरः ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003090092, "chapter_id": 23090, "verse_number": "४-२६-९३", "content_sanskrit": "इत्येवं कथितं विप्र श्रीकृष्णचरितव्रतम् ।\nसुखदं मोक्षदं सारमपरं कथयामि ते ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}]