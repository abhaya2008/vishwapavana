[{"id": 2124361, "chapter_id": 3666, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2124362, "chapter_id": 3666, "verse_number": "१", "content_sanskrit": "धृतराष्ट्र महाप्राज्ञ निबोध वचनं मम ।\nवक्ष्यामि त्वां कौरवाणां सर्वेषां हितमुत्तमम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2124363, "chapter_id": 3666, "verse_number": "२", "content_sanskrit": "न मे प्रियं महाबाहो यद्गताः पाण्डवा वनम् ।\nनिकृत्या निर्जिताश्चैव दुर्योधनवशानुगैः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2124364, "chapter_id": 3666, "verse_number": "३", "content_sanskrit": "ते स्मरन्तः परिक्लेशान् वर्षे पूर्णे त्रयोदशे ।\nविमोक्ष्यन्ति विषं क्रुद्धाः कौरवेयेषु भारत\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2124365, "chapter_id": 3666, "verse_number": "४", "content_sanskrit": "तदयं किं नु पापात्मा तव पुत्रः सुमन्दधीः ।\nपाण्डवान् नित्यसङ्क्रुद्धान् राज्यहेतोर्जिघांसति\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2124366, "chapter_id": 3666, "verse_number": "५", "content_sanskrit": "वार्यतां साध्वयं मूढः शमं गच्छतु ते सुतः ।\nवनस्थांस्तानयं हन्तुमिच्छन् प्राणैर्विमोक्ष्यते \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2124367, "chapter_id": 3666, "verse_number": "६", "content_sanskrit": "यथाऽऽह विदुरः प्राज्ञो यथा भीष्मो यथा वयम् ।\nयथा कृपश्च द्रोणश्च तथा साधु विधीयताम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2124368, "chapter_id": 3666, "verse_number": "७", "content_sanskrit": "विग्रहो हि महाप्राज्ञ स्वजनेन विगर्हितः ।\nअधर्म्यमयशस्यं च मा राजन् प्रतिपद्यथाः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2124369, "chapter_id": 3666, "verse_number": "८", "content_sanskrit": "समीक्षा यादृशी ह्यस्य पाण्डवान् प्रति भाषतः ।\nउपेक्ष्यमाणा सा राजन् महान्तमनयं सृजेत् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2124370, "chapter_id": 3666, "verse_number": "९", "content_sanskrit": "अथवाऽयं सुमन्दात्मा वनं गच्छतु ते सुतः ।\nपाण्डवैः सहितो राजन्नेक एवासहायवान्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2124371, "chapter_id": 3666, "verse_number": "१०", "content_sanskrit": "ततः संसर्गजः स्नेहः पुत्रस्य तव पाण्डवैः ।\nयदि स्यात् कृतकृत्यस्त्वं भवेथाः पुरुषर्षभ\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2124372, "chapter_id": 3666, "verse_number": "११", "content_sanskrit": "अथवा जायमानस्य यच्छीलमनुजायते ।\nभूयस्तदेतन्मा राजन् नामृतस्यापसर्पति\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2124373, "chapter_id": 3666, "verse_number": "१२", "content_sanskrit": "कथं वा मन्यते भीष्मो द्रोणोऽथ विदुरोऽपि वा ।\nभवान् वाऽत्र परं कार्यं पुराऽपार्थो निवर्तते\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2124374, "chapter_id": 3666, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2124375, "chapter_id": 3666, "verse_number": "१३", "content_sanskrit": "भगवान् नाहमप्येतद् रोचये द्यूतसंस्तवम् ।\nमन्ये तु विधिनाऽऽक्रम्य कारितोऽस्मीति वै मुने\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2124376, "chapter_id": 3666, "verse_number": "१४", "content_sanskrit": "न तद् रोचयते भीष्मो न द्रोणो विदुरो न च ।\nगान्धार्या नेष्यते द्यूतं तच्च मोहात् प्रवर्तितम् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2124377, "chapter_id": 3666, "verse_number": "१५", "content_sanskrit": "परित्यक्तुं न शक्नोमि दुर्योधनमचेतनम् ।\nपुत्रस्नेहेन भगवन् जानन्नपि यतव्रत\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2124378, "chapter_id": 3666, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2124379, "chapter_id": 3666, "verse_number": "१६", "content_sanskrit": "वैचित्रवीर्य नृपते सत्यमाह यथा भवान् ।\nदृढं वेद्मि परं पुत्र परं पुत्रान्न विद्यते \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2124380, "chapter_id": 3666, "verse_number": "१७", "content_sanskrit": "इन्द्रोऽप्यश्रुनिपातेन सुरभ्या प्रतिबोधितः ।\nअन्यैः समृद्धैरप्यर्थैर्नसुतान्मन्यते परम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2124381, "chapter_id": 3666, "verse_number": "१८", "content_sanskrit": "अत्र ते कथयिष्यामि महदाख्यानमुत्तमम् ।\nसुरभ्याश्चैव संवादमिन्द्रस्य च विशाम्पते\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2124382, "chapter_id": 3666, "verse_number": "१९", "content_sanskrit": "त्रिविष्टपगता राजन् सुरभिः प्रारुदत् किल ।\nगवां माता पुरा तात तामिन्द्रोऽन्वकृपायत\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2124383, "chapter_id": 3666, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2124384, "chapter_id": 3666, "verse_number": "२०", "content_sanskrit": "किमिदं रोदिषि शुभे कच्चित् क्षेमं दिवौकसाम् ।\nमनुष्येष्वथवा गोषु नैतदल्पं भविष्यति\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2124385, "chapter_id": 3666, "verse_number": "", "content_sanskrit": "सुरभिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2124386, "chapter_id": 3666, "verse_number": "२१", "content_sanskrit": "विनिपातो न वः कश्चिद् दृश्यते त्रिदशाधिप ।\nअहं तु पुत्रं शोचामि तेन रोदिमि कौशिक\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2124387, "chapter_id": 3666, "verse_number": "२२", "content_sanskrit": "पश्यैनं कर्षकं रौद्रं दुर्बलं मम पुत्रकम् ।\nप्रतोदेनाभिनिघ्नन्तं लाङ्गलेनाभिपीडितम् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2124388, "chapter_id": 3666, "verse_number": "२३", "content_sanskrit": "एनं दृष्ट्वा भृशं श्रान्तं वध्यमानं सुराधिप ।\nकृपाविष्टाऽस्मि देवेन्द्र मनश्चोद्वेपते मम\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2124389, "chapter_id": 3666, "verse_number": "२४", "content_sanskrit": "एकस्त्वत्र बलोपेतो धुरमुद्वहतेऽधिकाम् ।\nअपरोऽल्पबलप्राणः कृशो धमनिसन्ततः ।\nकृच्छ्रादुद्वहते भारं तं वै शोचामि वासव\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2124390, "chapter_id": 3666, "verse_number": "२५", "content_sanskrit": "वध्यमानः प्रतोदेन तुद्यमानस्तथैव च ।\nनैव शक्नोति तं भारमुद्वोढुं पश्य वासव\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2124391, "chapter_id": 3666, "verse_number": "२६", "content_sanskrit": "ततोऽहं तस्य दुःखार्ता विरौमि भृशदुःखिता ।\nअश्रूण्यावर्तयं चैव नेत्राभ्यां करुणावती\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2124392, "chapter_id": 3666, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2124393, "chapter_id": 3666, "verse_number": "२७", "content_sanskrit": "तव पुत्रसहस्रेषु पीड्यमानेषु शोभने ।\nकिं कृपायितवत्यत्र पुत्र एकोऽत्र पीड्यते\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2124394, "chapter_id": 3666, "verse_number": "", "content_sanskrit": "सुरभिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2124395, "chapter_id": 3666, "verse_number": "२८", "content_sanskrit": "यदि पुत्रसहस्रं मे सर्वत्र सममेव मे ।\nदीनस्य तु ततः शक्र पुत्रस्याभ्यधिका कृपा\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2124396, "chapter_id": 3666, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2124397, "chapter_id": 3666, "verse_number": "२९", "content_sanskrit": "तदिन्द्रः सुरभेर्वाक्यं निशम्य भृशविस्मितः ।\nजीवितेनापि कौरव्य मेनेऽभ्यधिकमात्मजम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2124398, "chapter_id": 3666, "verse_number": "३०", "content_sanskrit": "प्रववर्ष च तत्रैव सहसा तोयमुल्बणम् ।\nकर्षकस्याचरन् विघ्नं भगवान् पाकशासनः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2124399, "chapter_id": 3666, "verse_number": "३१", "content_sanskrit": "तद्यथा सुरभिः प्राह सममेवास्तु ते तथा ।\nसुतेषु राजन् सर्वेषु दीनेष्वभ्यधिका कृपा\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2124400, "chapter_id": 3666, "verse_number": "३२", "content_sanskrit": "यादृशो मे सुतः पाण्डुस्तादृशो मेऽसि पुत्रक ।\nविदुरश्च महाप्राज्ञः स्नेहादेतद् ब्रवीम्यहम् \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2124401, "chapter_id": 3666, "verse_number": "३३", "content_sanskrit": "चिराय तव पुत्राणां शतमेकं च पार्थिव ।\nपाण्डोः पञ्चैव लक्ष्यन्ते तेऽपि मन्दाः सुदुःखिताः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2124402, "chapter_id": 3666, "verse_number": "३४", "content_sanskrit": "कथं जीवेयुरित्येवं कथं वर्धेयुरित्यपि ।\nइति दीनेषु पार्थेषु मनो मे परितप्यते\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2124403, "chapter_id": 3666, "verse_number": "३५", "content_sanskrit": "यदि पार्थिव कौरव्यान् जीवमानानिहेच्छसि ।\nदुर्योधनस्तव सुतः शमं गच्छतु पाण्डवैः \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2124404, "chapter_id": 3666, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां वनपर्वणि\nअष्टमोऽध्यायः ॥८॥ ॥ आरण्यकपर्वणि अष्टमोऽध्यायः ॥८॥\n—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]