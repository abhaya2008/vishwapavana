[{"id": 2164717, "chapter_id": 4549, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2164718, "chapter_id": 4549, "verse_number": "१", "content_sanskrit": "शतानीकं शरैस्तूर्णं निर्दहन्तं चमूं तव ।\nचित्रसेनस्तव सुतो वारयामास भारत\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2164719, "chapter_id": 4549, "verse_number": "२", "content_sanskrit": "नाकुलिश्चित्रसेनं तु नाराचेनार्दयद् भृशम् ।\nस च तं प्रतिविव्याध दशभिर्निशितैः शरैः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2164720, "chapter_id": 4549, "verse_number": "३", "content_sanskrit": "चित्रसेनो महाराज शतानीकं पुनर्युधि ।\nनवभिर्निशितैर्बाणैराजघान स्तनान्तरे\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2164721, "chapter_id": 4549, "verse_number": "४", "content_sanskrit": "नाकुलिस्तस्य विशिखैर्वर्म सन्नतपर्वभिः ।\nगात्रात् सञ्च्यावयामास तदद्भुतमिवाभवत्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2164722, "chapter_id": 4549, "verse_number": "५", "content_sanskrit": "सोऽपेतवर्मा पुत्रस्ते विरराज भृशं नृप ।\nउत्सृज्य काले राजेन्द्र निर्मोकमिव पन्नगः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2164723, "chapter_id": 4549, "verse_number": "६", "content_sanskrit": "ततोऽस्य निशितैर्बाणैर्ध्वजं चिच्छेद नाकुलिः ।\nधनुश्चैव महाराज यतमानस्य संयुगे\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2164724, "chapter_id": 4549, "verse_number": "७", "content_sanskrit": "स छिन्नधन्वा समरे विवर्मा च महारथः ।\nधनुरन्यन्महाराज जग्राहारिविदारणम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2164725, "chapter_id": 4549, "verse_number": "८", "content_sanskrit": "ततस्तूर्णं चित्रसेनो नाकुलिं नवभिः शरैः ।\nविव्याध समरे क्रुद्धो भरतानां महारथः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2164726, "chapter_id": 4549, "verse_number": "९", "content_sanskrit": "शतानीकोऽथ सङ्क्रुद्धश्चित्रसेनस्य मारिष ।\nजघान चतुरो वाहान् सारथिं च नरोत्तमः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2164727, "chapter_id": 4549, "verse_number": "१०", "content_sanskrit": "अवप्लुत्य रथात् तस्माच्चित्रसेनो महारथः ।\nनाकुलिं पञ्चविंशत्या शराणामार्दयद् बली\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2164728, "chapter_id": 4549, "verse_number": "११", "content_sanskrit": "तस्य तत्कुर्वतः कर्म नकुलस्य सुतो रणे ।\nअर्धचन्द्रेण चिच्छेद चापं रत्नविभूषितम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2164729, "chapter_id": 4549, "verse_number": "१२", "content_sanskrit": "स छिन्नधन्वा विरथो हताश्वो हतसारथिः ।\nआरुरोह रथं तूर्णं हार्दिक्यस्य महात्मनः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2164730, "chapter_id": 4549, "verse_number": "१३", "content_sanskrit": "द्रुपदं तु सहानीकं द्रोणप्रेप्सुं महारथम् ।\nवृषसेनोऽभ्ययात् तूर्णं किरन् शरशतैस्तदा\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2164731, "chapter_id": 4549, "verse_number": "१४", "content_sanskrit": "यज्ञसेनस्तु समरे कर्णपुत्रं महारथम् ।\nषष्ट्या शराणां विव्याध बाह्वोरुरसि चानघ\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2164732, "chapter_id": 4549, "verse_number": "१५", "content_sanskrit": "वृषसेनस्तु सङ्क्रुद्धो यज्ञसेनं रथे स्थितम् ।\nबहुभिः सायकैस्तीक्ष्णैराजघान स्तनान्तरे\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2164733, "chapter_id": 4549, "verse_number": "१६", "content_sanskrit": "तावुभौ शरनुन्नाङ्गौ शरकण्टकिनौ रणे ।\nव्यभ्राजेतां महाराज श्वाविधौ शललैरिव\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2164734, "chapter_id": 4549, "verse_number": "१७", "content_sanskrit": "रुग्मपुङ्खैरजिह्माग्रैः शरैश्छिन्नतनुच्छदौ ।\nरुधिरौघपरिक्लिन्नौ व्यभ्राजेतां महामृधे\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2164735, "chapter_id": 4549, "verse_number": "१८", "content_sanskrit": "तपनीयनिभौ चित्रौ कल्पवृक्षाविवाद्भुतौ ।\nकिंशुकाविव चोत्फुल्लौ व्यकाशेतां रणाजिरे\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2164736, "chapter_id": 4549, "verse_number": "१९", "content_sanskrit": "वृषसेनस्ततो राजन्नवभिर्द्रुपदं शरैः ।\nविद्ध्वा विव्याध सप्तत्या पुनश्चान्यैस्त्रिभिः शरैः॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2164737, "chapter_id": 4549, "verse_number": "२०", "content_sanskrit": "ततः शरसहस्राणि विमुञ्चन् विबभौ तदा ।\nकर्णपुत्रो महाराज वर्षमाण इवाम्बुदः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2164738, "chapter_id": 4549, "verse_number": "२१", "content_sanskrit": "ततस्तु द्रुपदानीकं शरैश्छिन्नतनुच्छदम् ।\nसम्प्राद्रवद् रणे राजन् निशीथे भैरवे सति\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2164739, "chapter_id": 4549, "verse_number": "२२", "content_sanskrit": "प्रदीपैर्हि परित्यक्तैर्ज्वलद्भिस्तैः समन्ततः ।\nव्यराजत मही राजन् वीताभ्रा द्यौरिव ग्रहैः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2164740, "chapter_id": 4549, "verse_number": "२३", "content_sanskrit": "तथाङ्गदैर्निपतितैर्व्यराजत वसुन्धरा ।\nप्रावृट्काले महाराज विद्युद्भिरिव तोयदः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2164741, "chapter_id": 4549, "verse_number": "२४", "content_sanskrit": "ततः कर्णसुतत्रस्ताः सोमका विप्रदुद्रुवुः ।\nयथेन्द्रभयवित्रस्ता दानवास्तारकामये\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2164742, "chapter_id": 4549, "verse_number": "२५", "content_sanskrit": "तेनार्द्यमानाः समरे द्रवमाणाश्च सोमकाः ।\nव्यराजन्त महाराज प्रदीपैरवभासिताः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2164743, "chapter_id": 4549, "verse_number": "२६", "content_sanskrit": "तांस्तु निर्जित्य समरे कर्णपुत्रो व्यरोचत ।\nमध्यन्दिनमनुप्राप्तो घर्मांशुरिव भारत\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2164744, "chapter_id": 4549, "verse_number": "२७", "content_sanskrit": "तेषु राजसहस्रेषु तावकेषु परेषु च ।\nएक एव ज्वलंस्तस्थौ वृषसेनः प्रतापवान्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2164745, "chapter_id": 4549, "verse_number": "२८", "content_sanskrit": "स विजित्य रणे शूरान् सोमकानां महारथान् ।\nजगाम त्वरितस्तत्र यत्र राजा युधिष्ठिरः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2164746, "chapter_id": 4549, "verse_number": "२९", "content_sanskrit": "प्रतिविन्ध्यमथ क्रुद्धं प्रदहन्तं रणे रिपून् ।\nदुःशासनस्तव सुतः प्रत्युद्गच्छन् महारथः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2164747, "chapter_id": 4549, "verse_number": "३०", "content_sanskrit": "तयोः समागमो राजंश्चित्ररूपो बभूव ह ।\nव्यपेतजलदे व्योम्नि बुधभार्गवयोरिव\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2164748, "chapter_id": 4549, "verse_number": "३१", "content_sanskrit": "प्रतिविन्ध्यं तु समरे कुर्वाणं कर्म दुष्करम् ।\nदुःशासनस्त्रिभिर्बाणैर्ललाटे समविद्ध्यत\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2164749, "chapter_id": 4549, "verse_number": "३२", "content_sanskrit": "सोऽतिविद्धो बलवता पुत्रेण तव धन्विना ।\nविरराज महाबाहुः सशृङ्ग इव पर्वतः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2164750, "chapter_id": 4549, "verse_number": "३३", "content_sanskrit": "दुःशासनं तु समरे प्रतिविन्ध्यो महारथः ।\nनवभिः सायकैर्विद्ध्वा पुनर्विव्याध सप्तभिः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2164751, "chapter_id": 4549, "verse_number": "३४", "content_sanskrit": "तत्र भारत पुत्रस्ते कृतवान् कर्म दुष्करम् ।\nप्रतिविन्ध्यहयानुग्रैः पातयामास यच्छरैः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2164752, "chapter_id": 4549, "verse_number": "३५", "content_sanskrit": "सारथिं चास्य भल्लेन ध्वजं च समपातयत् ।\nरथं च शतशो राजन् व्यधमत् तस्य धन्विनः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2164753, "chapter_id": 4549, "verse_number": "३६", "content_sanskrit": "पताकाश्च स तूणीरान् रश्मीन् योक्त्राणि चाभिभो ।\nचिच्छेद तिलशः क्रुद्धः शरैः सन्नतपर्वभिः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2164754, "chapter_id": 4549, "verse_number": "३७", "content_sanskrit": "विरथः स तु धर्मात्मा धनुष्पाणिरवस्थितः ।\nअयोधयत् तव सुतं किरन् शरशतान् बहून्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2164755, "chapter_id": 4549, "verse_number": "३८", "content_sanskrit": "क्षुरप्रेण धनुस्तस्य चिच्छेद कृतहस्तवत् ।\nअथैनं दशभिर्भल्लैश्छिन्नधन्वानमार्दयत्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2164756, "chapter_id": 4549, "verse_number": "३९", "content_sanskrit": "तं दृष्ट्वा विरथं तत्र भ्रातरोऽस्य महारथाः ।\nअन्ववर्तन्त वेगेन महत्या सेनया सह\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2164757, "chapter_id": 4549, "verse_number": "४०", "content_sanskrit": "आप्लुतः स ततो यानं सुतसोमस्य भास्वरम् ।\nधनुर्गृह्य महाराज विव्याध तनयं तव\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2164758, "chapter_id": 4549, "verse_number": "४१", "content_sanskrit": "ततस्तु तावकाः सर्वे परिवार्य सुतं तव ।\nअभ्यवर्तन्त सङ्ग्रामे महत्या सेनया वृताः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2164759, "chapter_id": 4549, "verse_number": "४२", "content_sanskrit": "ततः प्रववृते युद्धं तव तेषां च भारत ।\nनिशीथे दारुणे काले यमराष्ट्रविवर्धनम्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2164760, "chapter_id": 4549, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nद्रोणपर्वणि चतुःपञ्चाशदधिकशततमोऽध्यायः ॥ १५४ ॥\nघटोत्कचवधपर्वणि एकविंशोऽध्यायः ॥ २१ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]