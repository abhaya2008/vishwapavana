[{"id": 7003184000, "chapter_id": 23184, "verse_number": "४-१२०-१", "content_sanskrit": "विंशत्यधिकशततमोऽध्यायः ।\nनारायण उवाच ।\nअथ कृष्णश्च भगवानुद्धवेत बलेन च ।\nदूतं प्रश्थापयामास विधाय मन्त्रणं शुभम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003184001, "chapter_id": 23184, "verse_number": "४-१२०-२", "content_sanskrit": "शिवो गणपतिर्यत्र दुर्गां दुर्गतिनाशिनी ।\nकार्तिकेयो भद्रकाली चोग्रचण्डा च कोटरी ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003184002, "chapter_id": 23184, "verse_number": "४-१२०-३", "content_sanskrit": "आगत्य नत्वा दूतश्च गणेशं च शिवं शिवाम् ।\nमानवांश्चापि पूच्यांश्च समुवाच यथोचितम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003184003, "chapter_id": 23184, "verse_number": "४-१२०-४", "content_sanskrit": "दूत उवाच ।\nबाणमाह्वयते कृष्णः संग्रामार्थ महेश्वर ।\nकिं वाऽनिरुद्धमूषां च गृहीत्वा शरणं व्रज ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003184004, "chapter_id": 23184, "verse_number": "४-१२०-५", "content_sanskrit": "रणे निमन्त्रितो यो हि न याति भयकातरः ।\nपरत्र नरकं याति सप्तभिः पितृभिः सह ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003184005, "chapter_id": 23184, "verse_number": "४-१२०-६", "content_sanskrit": "दूतस्य वचनं श्रुत्वा सभामध्ये यथोचितम् ।\nउवाच पार्वती देवी स्वयं शंकरसंनिधौ ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003184006, "chapter_id": 23184, "verse_number": "४-१२०-७", "content_sanskrit": "पार्वत्युवाच ।\nगच्छ बाण महाभाग गृहीत्वा तव कन्यकाम् ।\nसर्वस्वं यौतकं दत्त्वा श्रीकृष्णं शरणं व्रज ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003184007, "chapter_id": 23184, "verse_number": "४-१२०-८", "content_sanskrit": "सर्वेषामीश्वरं बीजं दातारं सर्वसंपदम् ।\nवरं वरेप्यं शरणं कृपालुं भक्तवत्सलम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003184008, "chapter_id": 23184, "verse_number": "४-१२०-९", "content_sanskrit": "पार्वतीवचनं श्रुत्वा तमूचुस्ते सुरेश्वराः ।\nप्रशसंसुःसभामध्ये धन्यधन्येति सर्वदा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003184009, "chapter_id": 23184, "verse_number": "४-१२०-१०", "content_sanskrit": "कोपाविष्टश्च बाणोऽयमुत्तस्थौ सहसाऽसुरः ।\nसांनाहिको धनुष्पाणिः प्रणम्य शंकरं ययौ ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003184010, "chapter_id": 23184, "verse_number": "४-१२०-११", "content_sanskrit": "सर्वैर्निषिध्यमानश्च कम्पितो रक्तलोचनः ।\nसांनाहिकश्च दैत्यानां त्रिकोट्या च महाबलः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003184011, "chapter_id": 23184, "verse_number": "४-१२०-१२", "content_sanskrit": "कुम्भाण्डः कूपकर्णश्च निकुम्भः कुम्भ एव च ।\nसेनापतीश्वरश्चैते ययुः सांनाहिकास्तथा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003184012, "chapter_id": 23184, "verse_number": "४-१२०-१३", "content_sanskrit": "उन्मत्तभैरवश्चैव संहारभैरवस्तथा ।\nअसिताङ्गो भैरवश्च रुरुभैरव एव च ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003184013, "chapter_id": 23184, "verse_number": "४-१२०-१४", "content_sanskrit": "महाभैरवसंज्ञश्च कालभैरव एव च ।\nप्रचण्डभैरवश्चैव क्रोधभैरव एव च ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003184014, "chapter_id": 23184, "verse_number": "४-१२०-१५", "content_sanskrit": "प्रययुः शक्तिभिः सार्ध सर्वे सांनाहिकाश्च ते ।\nकालाग्गिरुद्रो भगवान्रुद्रैः सांनाहिको ययौ ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003184015, "chapter_id": 23184, "verse_number": "४-१२०-१६", "content_sanskrit": "उग्रचण्डा प्रचण्डा च चण्डिका चण्डिनायिका ।\nचण्डेश्वरी च चामुण्डा चण्डी चण्डकपालिका ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003184016, "chapter_id": 23184, "verse_number": "४-१२०-१७", "content_sanskrit": "अष्टौ च नायिकाः सर्वाः प्रययुः खर्पराविन्ताः ।\nकोटरी रत्नयानस्था शोणितग्रामदेवता ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003184017, "chapter_id": 23184, "verse_number": "४-१२०-१८", "content_sanskrit": "प्रययौ सा प्रफुल्लास्या खड्गखर्परधारिणी ।\nइन्द्राणी वैष्णवी शान्ता ब्रह्माणी ब्रह्मवादिनी ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003184018, "chapter_id": 23184, "verse_number": "४-१२०-१९", "content_sanskrit": "कौमारी नारसिंही च वाराही विकटाकृतिः ।\nमाहेश्वरी महामाया भैरवी भीमरूपिणी ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003184019, "chapter_id": 23184, "verse_number": "४-१२०-२०", "content_sanskrit": "अष्टौ च शक्तयः सर्वा रथस्थाः प्रययुर्मुदा ।\nरत्नेन्द्रसारयानस्था प्रययौ भद्रकालिका ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003184020, "chapter_id": 23184, "verse_number": "४-१२०-२१", "content_sanskrit": "रक्तवर्णा त्रिनयना जिह्वाललनभीषणा ।\nशूलशक्तिगदाहस्ता खड्गखर्परधारिणी ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003184021, "chapter_id": 23184, "verse_number": "४-१२०-२२", "content_sanskrit": "प्रययौ शूलहस्तश्च वृषभस्थो महेश्वरः ।\nस्कन्दश्च शिखियानस्थः शस्त्रपाणिर्धनुर्धरः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003184022, "chapter_id": 23184, "verse_number": "४-१२०-२३", "content_sanskrit": "एवं च प्रययुः सर्वे गणेशं पार्वतीं विना ।\nएभिर्युक्तं महादेवं दृष्ट्वा च भद्रकालिकाम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003184023, "chapter_id": 23184, "verse_number": "४-१२०-२४", "content_sanskrit": "प्रचक्रे चक्रपाणिश्च संभाषां च यथोचिताम् ।\nबाणः शङ्कध्वनिं कृत्वा प्रणम्य पार्वतीश्वरम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003184024, "chapter_id": 23184, "verse_number": "४-१२०-२५", "content_sanskrit": "धनुर्दथार सगुणं दिव्यास्त्रेण नियोजितम् ।\nबाणं समुद्यतं दृष्ट्वा सात्यकिः परवीरहा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003184025, "chapter_id": 23184, "verse_number": "४-१२०-२६", "content_sanskrit": "निषिध्यमानस्तैः सर्वैः संनाही प्रययौ मुदा ।\nबाणश्चिक्षेप दिव्यास्त्रमञ्जनं नाम नारद ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003184026, "chapter_id": 23184, "verse_number": "४-१२०-२७", "content_sanskrit": "अव्यर्थं ग्रीष्ममध्याहनमार्तण्डाभं सुतीक्ष्णकम् ।\nदृष्टावाऽस्त्रं सात्यकिः साक्षात्किंचिन्नम्रो बभूव सः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003184027, "chapter_id": 23184, "verse_number": "४-१२०-२८", "content_sanskrit": "किं वा न दग्धः प्रययौ नभोमध्यं सुदारुणम् ।\nवह्निं चिक्षेप बाणश्च सात्यकिर्वारुणेन च ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003184028, "chapter_id": 23184, "verse_number": "४-१२०-२९", "content_sanskrit": "प्रज्वलन्तं तालमानं निर्वाणं च चकार सः ।\nचिच्छेद वारुणं घोरं प्रजण्डं भीममुल्बणम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003184029, "chapter_id": 23184, "verse_number": "४-१२०-३०", "content_sanskrit": "चिच्छेद सात्यकिश्चैव पार्जन्येनावलीलया ।\nचिक्षेप पवनं बाणः प्रचण्डं भीममुल्बणम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003184030, "chapter_id": 23184, "verse_number": "४-१२०-३१", "content_sanskrit": "चिच्छेद सात्यकिश्चैव पर्वताश्त्रेण लीलया ।\nनारायणस्त्रं चिक्षेप बाणश्च रणमूर्धनि ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003184031, "chapter_id": 23184, "verse_number": "४-१२०-३२", "content_sanskrit": "सात्यकिर्दण्डवद्भूमौ पपातार्जुनशिक्षया ।\nमाहेश्वरं प्रचिक्षेप बाणः शस्त्रविदां वरः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003184032, "chapter_id": 23184, "verse_number": "४-१२०-३३", "content_sanskrit": "सात्यकिर्वैष्णवास्त्रेण प्रविच्छेदावलीलया ।\nब्रह्मास्त्रं चापि चिक्षेप बाणश्च रणमूर्धनि ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003184033, "chapter_id": 23184, "verse_number": "४-१२०-३४", "content_sanskrit": "क्षणं चकार निर्वाणं ब्रह्मास्त्रेण च सात्यकिः ।\nनागास्त्रं चापि चिक्षेप बाणो रणविशारदः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003184034, "chapter_id": 23184, "verse_number": "४-१२०-३५", "content_sanskrit": "सात्यकिर्गारुडेनैव संजहार क्षणेन च ।\nजग्राह शूलमव्यर्थं शंकरस्य सुदारुणम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003184035, "chapter_id": 23184, "verse_number": "४-१२०-३६", "content_sanskrit": "तुष्टाव सात्यकिर्दुर्गा गले माल्यं बभूव ह ।\nजग्राह धनुषा बाणो बाणं पाशुपतं तथा ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003184036, "chapter_id": 23184, "verse_number": "४-१२०-३७", "content_sanskrit": "बाणं सबाणं जृम्भं च सात्यकिश्च चकार ह ।\nबाणं तं जृम्भितं दृष्ट्वा कार्तिकेयो महाबलः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003184037, "chapter_id": 23184, "verse_number": "४-१२०-३८", "content_sanskrit": "अर्धचन्द्रं च चिक्षेप कामश्चिच्छेद लीलया ।\nगदां चक्षेप च स्कन्दः प्रातः सूर्यसमप्रभाम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003184038, "chapter_id": 23184, "verse_number": "४-१२०-३९", "content_sanskrit": "वैष्णवास्त्रेण कामश्च निर्वाणं च चकार सः ।\nनारायणस्त्रं स्कन्दश्च प्राक्षिपच्च त्वरान्वितः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003184039, "chapter_id": 23184, "verse_number": "४-१२०-४०", "content_sanskrit": "पपात दण्डवद्भूमौ प्रद्युम्नः कृष्णशिक्षया ।\nस्कन्दः शक्तिं च चिक्षेप प्रलयग्निसमप्रभाम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003184040, "chapter_id": 23184, "verse_number": "४-१२०-४१", "content_sanskrit": "कामो नारायणास्त्रेण निर्वाणं च चकार ताम् ।\nब्रह्मास्त्रं च प्रचिक्षेप कार्तिको रणमूर्धनि ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003184041, "chapter_id": 23184, "verse_number": "४-१२०-४२", "content_sanskrit": "ब्रह्मास्त्रेणापि कामश्च निर्वाणं च चकार सः ।\nजग्राह कार्तिकं कोपाद्दिव्यं पाशुपतं तदा ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003184042, "chapter_id": 23184, "verse_number": "४-१२०-४३", "content_sanskrit": "निद्रास्त्रेणापि मदनो निद्रितं च चकार तम् ।\nकार्तिकं निद्रितं दृष्ट्वा बाणं च जृम्भितं तथा ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003184043, "chapter_id": 23184, "verse_number": "४-१२०-४४", "content_sanskrit": "कोपात्कामं च सरथं जग्राह भद्रकालिका ।\nक्रोडे कृत्वा च बाणं च स्कन्दं च जगतां प्रसूः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003184044, "chapter_id": 23184, "verse_number": "४-१२०-४५", "content_sanskrit": "रणस्थलाच्च प्रययौ यत्रैव पार्वती सती ।\nकार्तिकं बोधयामास बाणं सुस्थं चकार सा ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003184045, "chapter_id": 23184, "verse_number": "४-१२०-४६", "content_sanskrit": "सहसासरथः कामो नासारन्ध्रेण वर्त्मना ।\nबहिर्बभूव संत्रस्तः प्रययौ च रणस्थलम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003184046, "chapter_id": 23184, "verse_number": "४-१२०-४७", "content_sanskrit": "दृष्ट्का कामं च सरथं जहसुर्यादवास्तदा ।\nसर्वे शैवाश्च तत्रस्थाः शुष्ककण्ठा भयकुलाः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003184047, "chapter_id": 23184, "verse_number": "४-१२०-४८", "content_sanskrit": "अथ बाणः पुनः क्रुद्धो रथमारुह्य कोपतः ।\nकार्तिकेयश्च भगवान्युद्धाय पुनरागतः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003184048, "chapter_id": 23184, "verse_number": "४-१२०-४९", "content_sanskrit": "बाणः पञ्च शरांश्चैव चिक्षेप रणमूर्धनि ।\nअर्धचन्द्रेण चिच्छेद बलदेवो महाबलः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003184049, "chapter_id": 23184, "verse_number": "४-१२०-५०", "content_sanskrit": "रथं बभञ्ज बाणस्य लाङ्गलेन च लाङ्गली ।\nजघन सूतमश्वांश्च मुसलेनावलीलया ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003184050, "chapter_id": 23184, "verse_number": "४-१२०-५१", "content_sanskrit": "कुर्वन्तमुद्यमं छेत्तुं हलिनं च महाबलः ।\nकालाग्निरुद्रो भगवान्वारयामास लीलया ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003184051, "chapter_id": 23184, "verse_number": "४-१२०-५२", "content_sanskrit": "रथं कालाग्निरुद्रस्य बभञ्ज लाङ्गली रुषा ।\nहलेन सूतमश्वाश्च जधान रणमूर्धनि ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003184052, "chapter_id": 23184, "verse_number": "४-१२०-५३", "content_sanskrit": "कालाग्निरुद्रः कोपेन चिक्षेप जवरमुल्वणम् ।\nबभूवुर्यादवाः सर्वे ज्वराक्रान्ता हरिं विना ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003184053, "chapter_id": 23184, "verse_number": "४-१२०-५४", "content_sanskrit": "तं दृष्ट्वा भगवान्कृष्णः ससर्ज वैष्णवं ज्वरम् ।\nतं चिक्षेप ज्वरं हन्तुं माहेशं रणमूर्धनि ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003184054, "chapter_id": 23184, "verse_number": "४-१२०-५५", "content_sanskrit": "बभूव ज्वरयोर्युद्धं मुहूर्तमतिदारुणम् ।\nवैष्णवज्वरनिष्कान्तो रणमीर्ध्नि पपात सः ।\nपरं बभूव निश्चेष्टस्तुष्टाव माधवं पुनः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003184055, "chapter_id": 23184, "verse_number": "४-१२०-५६", "content_sanskrit": "ज्वर उवाच ।\nप्रणान्रक्ष जगन्नाथ भक्तानुग्रहविग्रह ।\nत्वमात्मा पुरुषः पुर्णः सर्वत्र समता तव ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003184056, "chapter_id": 23184, "verse_number": "४-१२०-५७", "content_sanskrit": "ज्वरस्य वचनं श्रुत्वा संजहार स्वकं ज्वरम् ।\nमाहेश्वरो ज्वरो भीतो रणादेव हि निर्ययौ ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003184057, "chapter_id": 23184, "verse_number": "४-१२०-५८", "content_sanskrit": "बाणश्च पुनरागत्य बाणानां च सहस्रकम् ।\nचिक्षेप मन्त्रपूतं च प्रलयाग्निशिखोपमम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003184058, "chapter_id": 23184, "verse_number": "४-१२०-५९", "content_sanskrit": "फाल्गुनः शरजालेन वारयामास लीलया ।\nचिक्षेप शक्तिं बाणश्च ग्रीष्मसूर्यसमप्रभाम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003184059, "chapter_id": 23184, "verse_number": "४-१२०-६०", "content_sanskrit": "चिच्छेद लीलया तां च सव्यसाची महाबलः ।\nस जग्राह पाशुपतं शतसूर्यसमप्रभम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003184060, "chapter_id": 23184, "verse_number": "४-१२०-६१", "content_sanskrit": "अत्यर्थमतिघोरं च विश्वसंहारकारकम् ।तद्दृष्टा चक्रपाणिश्च चक्रं चिक्षेप दारुणम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003184061, "chapter_id": 23184, "verse_number": "४-१२०-६२", "content_sanskrit": "हस्तानां च सहस्रं च सपाशुपतमुल्बणम् ।\nचिच्छेद रणमध्ये च पपाताचलसिंहवत् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003184062, "chapter_id": 23184, "verse_number": "४-१२०-६३", "content_sanskrit": "शस्त्रं पाशुपतं चैव ययौ पशुपतेः करम् ।\nअव्यर्थ दारुणं लोके प्रलयाग्निशिखोपमम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003184063, "chapter_id": 23184, "verse_number": "४-१२०-६४", "content_sanskrit": "बाणरक्तसमूहेन बभूव च महानदः ।\nबाणः पपात निश्चेष्टी व्यथितो हतचेतनः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003184064, "chapter_id": 23184, "verse_number": "४-१२०-६५", "content_sanskrit": "तत्राऽऽजगाम भगवान्महदेवो जगद्गुरुः ।\nरुरोदाऽऽगत्य मोहेन बाणं कृत्वा स्ववक्षसि ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003184065, "chapter_id": 23184, "verse_number": "४-१२०-६६", "content_sanskrit": "शिवाश्रुपतनेनैव संबभूव सरोवरम् ।\nचेतनं कारयामास करुमासागरः प्रभुः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003184066, "chapter_id": 23184, "verse_number": "४-१२०-६७", "content_sanskrit": "बाणां गृहीत्वा प्रययौ यत्र देवो जनार्दनः ।\nचक्रे पद्मार्चिते पादपद्मे बाणसमर्पणम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003184067, "chapter_id": 23184, "verse_number": "४-१२०-६८", "content_sanskrit": "तुष्टाव जगतां नाथं भक्तेशं चन्द्रशेखलः ।\nबलिना च स्ततं येन वेदोक्तेन च तेन च ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003184068, "chapter_id": 23184, "verse_number": "४-१२०-६९", "content_sanskrit": "हरिर्मृत्युंजयं ज्ञानं ददौ बाणाय धीमते ।\nकरपद्मं ददौ गात्रे तं चकाराजरामरम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003184069, "chapter_id": 23184, "verse_number": "४-१२०-७०", "content_sanskrit": "बाणः स्तोत्रेण तुष्टाव भक्त्या बलिकृतेन च ।\nवरां कन्यां समानीय रत्नभूषणभूषिताम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003184070, "chapter_id": 23184, "verse_number": "४-१२०-७१", "content_sanskrit": "ब्रददौ हरये भक्त्या तत्रैव देवसंसदि ।\nगजेन्द्राणां पञ्चलक्ष्मश्वानां तच्चतुर्गुणम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003184071, "chapter_id": 23184, "verse_number": "४-१२०-७२", "content_sanskrit": "दासीनां च सहस्रं च रत्नभूषणभूषितम् ।\nसहस्रं कामधेनूनां वत्सयुक्तं च सर्वदम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003184072, "chapter_id": 23184, "verse_number": "४-१२०-७३", "content_sanskrit": "माणिक्यानां च मुक्तानां रत्नानां शतलक्षकम् ।\nमणीन्द्राणां हीरकाणां शतलक्षं मनोहरम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003184073, "chapter_id": 23184, "verse_number": "४-१२०-७४", "content_sanskrit": "जलभाजनपात्राणि सुवर्णनिर्मितानि च ।\nमहस्राणि ददौ तस्मै भक्तिनम्रात्मकंधरः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003184074, "chapter_id": 23184, "verse_number": "४-१२०-७५", "content_sanskrit": "वराणि सूक्ष्मवस्त्राणि वह्निशुद्धांशुकानि च ।\nददौ बाणश्च मर्वाणि स्वभक्त्या शंकराज्ञया ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003184075, "chapter_id": 23184, "verse_number": "४-१२०-७६", "content_sanskrit": "ताम्बूलानां मधनां च पूर्णपात्राणि नारद ।\nसहस्राणि ददौ भक्त्या वराणि विविधानि च ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003184076, "chapter_id": 23184, "verse_number": "४-१२०-७७", "content_sanskrit": "कन्यां समर्पयामास पादपद्मे हरेरपि ।\nरुरोदोच्चैः स्वभक्त्या च परिहारं चकार सः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003184077, "chapter_id": 23184, "verse_number": "४-१२०-७८", "content_sanskrit": "कृष्णस्तस्मै वरं दत्त्वा वेदोक्तं च शुभाशिष्म् ।\nशंकरानुमतेनैव प्रययौ द्वारकां पुरीम् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003184078, "chapter_id": 23184, "verse_number": "४-१२०-७९", "content_sanskrit": "गत्वा कन्यां नवोढां तां बाणस्यापि महात्मनः ।\nरुक्मिण्यै प्रददौ शीघ्रं देवक्यै च हरिः स्वयम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003184079, "chapter_id": 23184, "verse_number": "४-१२०-८०", "content_sanskrit": "महोत्सवं मङ्गलं च कारयामास यत्नतः ।\nब्राह्मणान्भोजयामास ब्राह्मणेभ्यो धनं ददौ ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}]