[{"id": 7006268000, "chapter_id": 26268, "verse_number": "३-२२-१", "content_sanskrit": "अथ श्रीललितासेनानिस्साणप्रतिनिस्वनः ।\nउच्चचालसुरेन्द्राणां योद्धतो दुन्दुभिध्वनिः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006268001, "chapter_id": 26268, "verse_number": "३-२२-२", "content_sanskrit": "तेन मर्दितदिक्केन क्षुभ्यद्गर्भपयोधिना ।\nबधिरीकृतलोकेन चकम्पे जगतां त्रयी ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006268002, "chapter_id": 26268, "verse_number": "३-२२-३", "content_sanskrit": "मर्दयन्ककुभां वृन्दं भिन्दन्भूधरकन्दराः ।\nपुप्रोथे गगनाभोगे दैत्य निःसाणनिस्वनः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006268003, "chapter_id": 26268, "verse_number": "३-२२-४", "content_sanskrit": "महानरहरिक्रुद्धहुङ्कारोद्धतिमद्ध्वनिः ।\nविरसं विररासोच्चैर्विबुधद्वेषिझल्लरी ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006268004, "chapter_id": 26268, "verse_number": "३-२२-५", "content_sanskrit": "ततः किलकिलारावमुखरा दैत्यकोटयः ।\nसमनह्यन्त संक्रुद्धाः प्रति तां परमेश्वरीम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006268005, "chapter_id": 26268, "verse_number": "३-२२-६", "content_sanskrit": "कश्चिद्रत्नविचित्रेण वर्मणाच्छन्नविग्रहः ।\nचकाशे जङ्गम इव प्रोत्तुङ्गो रोहणाचलः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006268006, "chapter_id": 26268, "verse_number": "३-२२-७", "content_sanskrit": "कालरात्रिमिवोदग्रां शस्त्रकारेण गोपिताम् ।\nअधुनीत भटः कश्चिदतिधौतां कृपाणिकाम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006268007, "chapter_id": 26268, "verse_number": "३-२२-८", "content_sanskrit": "उल्ला सयन्कराग्रेण कुन्तपल्लवमेकतः ।\nआरूढतुरगो वीथ्यां चारिभेदं चकार ह ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006268008, "chapter_id": 26268, "verse_number": "३-२२-९", "content_sanskrit": "केचिदारुरुहुर्योधा मातङ्गांस्तुङ्गवर्ष्मणः ।\nउत्पात वातसंपातप्रेरितानिव पर्वतान् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006268009, "chapter_id": 26268, "verse_number": "३-२२-१०", "content_sanskrit": "पट्टिशैर्मुद्गरैश्चैव भिदुरैर्भिण्डिपालकैः ।\nद्रुहणैश्च भुशुण्डीभिः कुठारैर्मुसलैरपि ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006268010, "chapter_id": 26268, "verse_number": "३-२२-११", "content_sanskrit": "गदाभिश्च शतघ्नीभिस्त्रिशिखैर्विशिखैरपि ।\nअर्धचक्रैर्महाचक्रैर्वक्राङ्गैरुरगाननैः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006268011, "chapter_id": 26268, "verse_number": "३-२२-१२", "content_sanskrit": "फणिशीर्षप्रभेदैश्च धनुर्भिः शार्ङ्गधन्विभिः ।\nदण्डैः क्षेपणिकाशस्त्रैर्वज्रबाणैर्दृषद्वरैः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006268012, "chapter_id": 26268, "verse_number": "३-२२-१३", "content_sanskrit": "यवमध्यैर्मुष्टिमध्यैर्वललैः खण्डलैरपि ।\nकटारैः कोणमध्यैश्च फणिदन्तैः परःशतैः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006268013, "chapter_id": 26268, "verse_number": "३-२२-१४", "content_sanskrit": "पाशायुधैः पाशतुण्डैः काकतुण्डैः सहस्रशः ।\nएवमादिभिरत्युग्रैरायुधैर्जीवहारिभिः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006268014, "chapter_id": 26268, "verse_number": "३-२२-१५", "content_sanskrit": "परिकल्पितहस्ताग्रा वर्मिता दैत्यकोटयः ।\nअश्वारोहा गजारोहा गर्दभारोहिणः परे ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006268015, "chapter_id": 26268, "verse_number": "३-२२-१६", "content_sanskrit": "उष्ट्रारोहा वृकारोहा शुनकारोहिणः परे ।\nकाकादिरोहिणो गृध्रारोहाः कङ्कादिरोहिणः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006268016, "chapter_id": 26268, "verse_number": "३-२२-१७", "content_sanskrit": "व्याघ्रादिरोहिणश्चान्ये परे सिंहादिरोहिणः ।\nशरभारोहिणश्चान्ये भेरुण्डारोहिणः परे ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006268017, "chapter_id": 26268, "verse_number": "३-२२-१८", "content_sanskrit": "सूकरारोहिणो व्यालारूढाः प्रेतादिरोहिणः ।\nएवं नानाविधैर्वाहवाहिनो ललितां प्रति ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006268018, "chapter_id": 26268, "verse_number": "३-२२-१९", "content_sanskrit": "प्रचेलुः प्रबलक्रोधसंमूर्च्छितनिजाशयाः ।\nकुटिलं सैन्यभर्त्तारं दुर्मदं नाम दानवम् ।\nदशाक्षौहिणिकायुक्तं प्राहिणोल्ललितां प्रति ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006268019, "chapter_id": 26268, "verse_number": "३-२२-२०", "content_sanskrit": "दिधक्षुभिरिवाशेषं विश्वं सह बलोत्कटैः ।\nभटैर्युक्तः स सेनानी ललिताभिमुखे ययौ ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006268020, "chapter_id": 26268, "verse_number": "३-२२-२१", "content_sanskrit": "भिन्दन्पटहसंरावैश्चतुर्दश जगन्ति सः ।\nअट्टहासान्वितन्वानो दुर्मदस्तन्मुखो ययौ ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006268021, "chapter_id": 26268, "verse_number": "३-२२-२२", "content_sanskrit": "अथ भण्डासुराज्ञप्तः कुटिलाक्षो महाबलः ।\nशून्यकस्य पुरद्वारे प्रचीने समकल्पयत् ।\nरक्षणार्थं दशाक्षौ हिण्युपेतं तालजङ्घकम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006268022, "chapter_id": 26268, "verse_number": "३-२२-२३", "content_sanskrit": "अवाचीने पुरद्वारे दशाक्षौहिणिकायुतम् ।\nनाम्ना तालभुजं दैत्यं रक्षणार्थमकल्पयत् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006268023, "chapter_id": 26268, "verse_number": "३-२२-२४", "content_sanskrit": "प्रतीचीने पुरद्वारे दशाक्षौहिणिकायुतम् ।\nतालग्रीवं नाम दैत्यं रक्षार्थं समकल्पयत् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006268024, "chapter_id": 26268, "verse_number": "३-२२-२५", "content_sanskrit": "उत्तरे तु पुरद्वारे तालकेतुं महा बलम् ।\nआदिदेश स रक्षार्थं दशाक्षौहिणिकायुतम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006268025, "chapter_id": 26268, "verse_number": "३-२२-२६", "content_sanskrit": "पुरस्य सालवलये कपिशीर्षकवेश्मसु ।\nमण्डलाकारतो वस्तुन्दशाक्षौहिणिमादिशत् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006268026, "chapter_id": 26268, "verse_number": "३-२२-२७", "content_sanskrit": "एवं पञ्चाशता कृत्वाक्षौहिण्या पुररक्षणम् ।\nशून्यकस्य पुरस्यैव तद्वृत्तं स्वामिनेऽवदत् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006268027, "chapter_id": 26268, "verse_number": "३-२२-२८", "content_sanskrit": "कुटिलाक्ष उवाच देव त्वदाज्ञया दत्तं सैन्यं नगररक्षणे ।\nदुर्मदः प्रेषितः पूर्वं दुष्टां तां ललितां प्रति ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006268028, "chapter_id": 26268, "verse_number": "३-२२-२९", "content_sanskrit": "अस्मत्किङ्कर मात्रेण सुनिराशा हि साबला ।\nतथापि राज्ञामाचारः कर्त्तव्यं पुररक्षणम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006268029, "chapter_id": 26268, "verse_number": "३-२२-३०", "content_sanskrit": "इत्युक्त्वा भण्डदैत्येन्द्रं कुबिलाक्षोऽतिगर्वितः ।\nस्वसैन्यं सज्जयामास सेनापतिभिरन्वितः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006268030, "chapter_id": 26268, "verse_number": "३-२२-३१", "content_sanskrit": "दूतस्तु प्रेषितः पूर्वं कुटिलाक्षेण दानवः ।\nस ध्वनन्ध्वजिनीयुक्तो ललितासैन्य मावृणोत् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006268031, "chapter_id": 26268, "verse_number": "३-२२-३२", "content_sanskrit": "कृत्वा किलकिलारावं भटास्तत्र सहस्रशः ।\nदोधूयमानैरसिभिर्निपेतुः शक्तिसैनिकैः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006268032, "chapter_id": 26268, "verse_number": "३-२२-३३", "content_sanskrit": "ताश्च शक्त्य उद्दण्डाः स्फुरिताट्टहसस्वनाः ।\nदेदीप्यमानशस्त्राभाः समयुध्यन्त दानवैः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006268033, "chapter_id": 26268, "verse_number": "३-२२-३४", "content_sanskrit": "शक्तीनां दानवानां च संशोभितजगत्त्रयः ।\nसमवर्तत संग्रामो धूलिग्रामतताम्बरः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006268034, "chapter_id": 26268, "verse_number": "३-२२-३५", "content_sanskrit": "रथवंशेषु मूर्च्छन्त्यः करिकण्ठैः प्रपञ्चिताः ।\nअश्वनिःश्वासविक्षिप्ता धूलयः रवं प्रपेदिरे ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006268035, "chapter_id": 26268, "verse_number": "३-२२-३६", "content_sanskrit": "तमापतन्तमालोक्य दशाक्षौहिणिकावृतम् ।\nसंपत्सरस्वती क्रोधादभिदुद्राव संगरे ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006268036, "chapter_id": 26268, "verse_number": "३-२२-३७", "content_sanskrit": "सम्पत्करीसमानाभिः शक्तिभिः समधिष्ठिताः ।\nअश्वाश्च दन्तिनो मत्ता व्यमर्दन्दानत्रीं चमुम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006268037, "chapter_id": 26268, "verse_number": "३-२२-३८", "content_sanskrit": "अन्योन्यतुमुले युद्धे जाते किलिकिलारवे ।\nधूलीषु धूयमानासु ताड्यमानासु भेरिषु ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006268038, "chapter_id": 26268, "verse_number": "३-२२-३९", "content_sanskrit": "इतस्ततः प्रववृधे रक्तसिन्धुर्महीयसी ।\nशक्तिभिः पात्यमानानां दानवानां सहस्रशः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006268039, "chapter_id": 26268, "verse_number": "३-२२-४०", "content_sanskrit": "ध्वजानि लुठितान्यासन्विलूनानि शिलीमुखैः ।\nविस्रस्ततत्तच्छिह्नानि समं छत्रकदम्बकैः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006268040, "chapter_id": 26268, "verse_number": "३-२२-४१", "content_sanskrit": "रक्तारुणायां युद्धोर्व्यां पतितैश्छत्रमण्डलैः ।\nआलंबि तुलना संध्यारक्ताभ्रहिमरोचिषा ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006268041, "chapter_id": 26268, "verse_number": "३-२२-४२", "content_sanskrit": "ज्वालाकपालः कल्पाग्निरिव चारुपयोनिधौ ।\nदैत्यसैन्यानि निवहाः शक्तीनां पर्यवारयन् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006268042, "chapter_id": 26268, "verse_number": "३-२२-४३", "content_sanskrit": "शक्तिच्छन्दोज्ज्वलच्छस्त्रधारानिष्कृत्तकन्धराः ।\nदानवानां रणतले निपेतुर्मुण्डराशयः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006268043, "chapter_id": 26268, "verse_number": "३-२२-४४", "content_sanskrit": "दष्टौष्ठैर्भ्रुकुटीक्रूरैः क्रोधसंरक्तलोचनैः ।\nमुण्डैरखण्डमभवत्संग्रामधरणीतलम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006268044, "chapter_id": 26268, "verse_number": "३-२२-४५", "content_sanskrit": "एवं प्रवृत्ते समये जगच्चक्रभयङ्करे ।\nशक्तयो भृशसंक्रुद्धा दैत्यसेनाममर्दयन् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006268045, "chapter_id": 26268, "verse_number": "३-२२-४६", "content_sanskrit": "इतस्ततः शक्तिशस्त्रैस्ताडिता मूर्च्छिता इति ।\nविनेशुर्दानवास्तत्र संपद्देवीबलाहताः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006268046, "chapter_id": 26268, "verse_number": "३-२२-४७", "content_sanskrit": "अथ भग्नं समाश्वास्य निजं बलमरिन्दमः ।\nउष्ट्रमारुह्य सहसा दुर्मदोऽभ्यद्रवच्चमुम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006268047, "chapter_id": 26268, "verse_number": "३-२२-४८", "content_sanskrit": "दीर्घग्रीवः समुन्नद्धः पृष्ठे निष्ठुरतोदनः ।\nअधिष्ठितो दुर्मदेन वाहनोष्ट्रश्चचाल ह ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006268048, "chapter_id": 26268, "verse_number": "३-२२-४९", "content_sanskrit": "तमुष्ट्रवाहनं दुष्टमन्वीयुः क्रुद्धचेतसः ।\nदानावनश्वसत्सर्वान्भीताञ्छक्तियुयुत्सया ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006268049, "chapter_id": 26268, "verse_number": "३-२२-५०", "content_sanskrit": "अवाकिरद्दिशो भल्लैरुल्लसत्फलशालिभिः ।\nसंपत्करीचमूचक्रं वनं वार्भिरिवांबुदः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006268050, "chapter_id": 26268, "verse_number": "३-२२-५१", "content_sanskrit": "तेन दुःसहसत्त्वेन ताडिता बहुभिः शरैः ।\nस्तंभितेवाभवत्सेना संपत्कर्याः क्षणं रणे ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006268051, "chapter_id": 26268, "verse_number": "३-२२-५२", "content_sanskrit": "अथ क्रोधारुणं चक्षुर्दधाना संपदंबिका ।\nरणकोलाहलगजमारूढायुध्यतामुना ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006268052, "chapter_id": 26268, "verse_number": "३-२२-५३", "content_sanskrit": "आलोलकङ्कणक्वाणरमणीयतरः करः ।\nतस्याश्चाकृष्य कोदण्डमौर्वीमाकर्णमाहवे ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006268053, "chapter_id": 26268, "verse_number": "३-२२-५४", "content_sanskrit": "लघुहस्ततयापश्यन्नाकृष्टन्न च मोक्षणम् ।\nददृशे घनुषश्चक्रं केवलं शरधारणे ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006268054, "chapter_id": 26268, "verse_number": "३-२२-५५", "content_sanskrit": "आश्वर्काबरसंपर्कस्फुटप्रतिफलत्फलाः ।\nशराः सम्पत्करीचापच्युताः समदहन्नरीन् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006268055, "chapter_id": 26268, "verse_number": "३-२२-५६", "content_sanskrit": "दुर्मदस्याथ तस्याश्च समभूद्युद्धमुद्धतम् ।\nअभूदन्योन्यसंघट्टाद्विस्फुलिङ्गशिलीमुखैः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006268056, "chapter_id": 26268, "verse_number": "३-२२-५७", "content_sanskrit": "प्रथमं प्रसृतैर्बाणैः सम्पद्देवीसुरद्विषोः ।\nअन्धकारः समभवत्तिरस्कुर्वन्नहस्करम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006268057, "chapter_id": 26268, "verse_number": "३-२२-५८", "content_sanskrit": "तदन्तरे च बाणानामतिसंघट्टयोनयः ।\nविष्फुलिङ्गा विदधिरे दधिरे भ्रमचातुरीम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006268058, "chapter_id": 26268, "verse_number": "३-२२-५९", "content_sanskrit": "तयाधिरूढः संश्रोण्यारणकोलाहलः करी ।\nपराक्रमं बहुविधं दर्शयामास संगरे ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006268059, "chapter_id": 26268, "verse_number": "३-२२-६०", "content_sanskrit": "करेण कतिचिद्दैत्यान्पादघातेन कांश्चन ।\nउदग्रदन्तमुसलघातैरन्यांश्च दानवान् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006268060, "chapter_id": 26268, "verse_number": "३-२२-६१", "content_sanskrit": "वालकाण्डहतैरन्यान्फेत्कारैरपरान्रिपून् ।\nगात्रव्यामर्द्दनैरन्यान्नखघातैस्तथापरान् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006268061, "chapter_id": 26268, "verse_number": "३-२२-६२", "content_sanskrit": "पृथुमानाभिघातेन कांश्चिद्दैत्यन्व्यमर्दयत् ।\nचतुरं चरितं चक्रे संपद्देवीमतङ्गजः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006268062, "chapter_id": 26268, "verse_number": "३-२२-६३", "content_sanskrit": "सुदुर्मदः क्रुधा रक्तो दृढेनैकेन पत्रिणा ।\nसंपत्करीमुकुटगं मणिमेकमपाहरत् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006268063, "chapter_id": 26268, "verse_number": "३-२२-६४", "content_sanskrit": "अथ क्रोधारुणदृशा तया मुक्तैः शिलीमुखैः ।\nविक्षतो वक्षसि क्षिप्रं दुर्मदो जीवितं जहौ ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006268064, "chapter_id": 26268, "verse_number": "३-२२-६५", "content_sanskrit": "ततः किलकिला रावं कृत्वा शक्तिचमूवरैः ।\nतत्सैनिकवरास्त्वन्ये निहता दानवोत्तमाः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006268065, "chapter_id": 26268, "verse_number": "३-२२-६६", "content_sanskrit": "हतावशिष्टा दैत्यास्तु शक्तिबाणैः खिलीकृताः ।\nपलायिता रणक्षोण्याः शून्यकं पुरमाश्रयन् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006268066, "chapter_id": 26268, "verse_number": "३-२२-६७", "content_sanskrit": "तद्वृत्तान्तमथाकर्ण्य संक्रुद्धो दानवेश्वरः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006268067, "chapter_id": 26268, "verse_number": "३-२२-६८", "content_sanskrit": "प्रचण्डेन प्रभावेण दीप्यमान इवात्मनि ।\nस पस्पर्श नियुद्धाय खड्गमुग्रविलोचनः ।\nकुटिलाक्षं निकटगं बभाषे पृतनापतिम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006268068, "chapter_id": 26268, "verse_number": "३-२२-६९", "content_sanskrit": "कथं सा दुष्टवनिता दुर्मदं बलशालिनम् ।\nनिपातितवती युद्धे कष्ट एव विधेः क्रमः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006268069, "chapter_id": 26268, "verse_number": "३-२२-७०", "content_sanskrit": "न सुरेषु न यक्षेषु नोरगेन्द्रेषु यद्बलम् ।\nअभूत्प्रतिहतं सोऽपि दुर्मदोऽबलया हतः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006268070, "chapter_id": 26268, "verse_number": "३-२२-७१", "content_sanskrit": "तां दुष्टवनितां जेतुमाक्रष्टुं च कचं हठात् ।\nसेनापतिं कुरण्डाख्यं प्रेषयाहवदुर्मदम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006268071, "chapter_id": 26268, "verse_number": "३-२२-७२", "content_sanskrit": "एति संप्रोषितस्तेन कुटिलाक्षो महापलम् ।\nकुरण्डं चण्डदोर्द्दण्डमाजुहाव प्रभोः पुरः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006268072, "chapter_id": 26268, "verse_number": "३-२२-७३", "content_sanskrit": "स कुरण्डः समागत्य प्रणाम स्वामिनेऽदिशत् ।\nउवाच कुटिलाक्षस्तं गच्छ सज्जय सैनिकान् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006268073, "chapter_id": 26268, "verse_number": "३-२२-७४", "content_sanskrit": "मायायां चतुरोऽसि त्वं चित्रयुद्धविशारद ।\nकूटयुद्धे च निपुणस्तां स्त्रियं परिमर्दय ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006268074, "chapter_id": 26268, "verse_number": "३-२२-७५", "content_sanskrit": "इति स्वामिपुरस्तेन कुटिलाक्षेण देशितः ।\nनिर्जगाम पुरात्तूर्णं कुरण्डश्चण्डविक्रमः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006268075, "chapter_id": 26268, "verse_number": "३-२२-७६", "content_sanskrit": "विंशत्यक्षौहिणीभिश्च समन्तात्परिवारितः ।\nमर्दयन्स महीगोलं हस्तिवाजिपदातिभिः ।\nदुर्मदस्याग्रजश्चण्डः कुरण्डः समरं ययौ ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7006268076, "chapter_id": 26268, "verse_number": "३-२२-७७", "content_sanskrit": "दूलीभिस्तुमुलीकुर्वन्दिगन्तं धीरमानसः ।\nशोकरोषग्रहग्रस्तो जवनाश्वगतो ययौ ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7006268077, "chapter_id": 26268, "verse_number": "३-२२-७८", "content_sanskrit": "शार्ङ्गं धनुः समादाय घोरटङ्कारमुत्स्वनम् ।\nववर्ष शरधारभिः संपत्कर्या महाचमूम् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7006268078, "chapter_id": 26268, "verse_number": "३-२२-७९", "content_sanskrit": "पापे मदनुजं हत्वा दुर्मदं युद्धदुर्मदम् ।\nवृथा वहसि विक्रान्तिलवलेशं महामदम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7006268079, "chapter_id": 26268, "verse_number": "३-२२-८०", "content_sanskrit": "इदानीं चैव भवतीमेतैर्नाराचमण्डलैः ।\nअन्तकस्य पुरीमत्र प्रापयिष्यामि पश्य माम् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7006268080, "chapter_id": 26268, "verse_number": "३-२२-८१", "content_sanskrit": "अतिहृद्यमतिस्वादु त्वद्वपुर्बिलनिर्गतम् ।\nअपूर्वमङ्गनारक्तं पिबन्तु रणपूतनाः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7006268081, "chapter_id": 26268, "verse_number": "३-२२-८२", "content_sanskrit": "ममानुजवधोत्थस्य प्रत्यवायस्य तत्फलम् ।\nअधुना भोक्ष्यसे दुष्टे पश्य मे भुजयोर्बलम् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7006268082, "chapter_id": 26268, "verse_number": "३-२२-८३", "content_sanskrit": "इति संतर्जयन्संपत्करीं करिवरस्थिताम् ।\nसैन्यं प्रोत्साहयामास शक्तिसेनाविमर्दने ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7006268083, "chapter_id": 26268, "verse_number": "३-२२-८४", "content_sanskrit": "अथ तां पृतनां चण्डी कुरण्डस्य महौजसः ।\nविमर्दयितुमुद्युक्ता स्वसैन्यं प्रोदसीसहत् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7006268084, "chapter_id": 26268, "verse_number": "३-२२-८५", "content_sanskrit": "अपुर्वाहवसंजातकौतुकाथ जगाद ताम् ।\nअश्वरूढा समागत्य सस्नेहार्द्रमिदं वचः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7006268085, "chapter_id": 26268, "verse_number": "३-२२-८६", "content_sanskrit": "सखि संपत्करि प्रीत्या मम वाणी निशम्यतम् ।\nअस्य युद्धमिदं देहि मम कर्तुं गुणोत्तरम् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7006268086, "chapter_id": 26268, "verse_number": "३-२२-८७", "content_sanskrit": "क्षणं सहस्व समरे मयैवैष नियोत्स्यते ।\nयाचितासि सखित्वेन नात्र संशयमाचर ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7006268087, "chapter_id": 26268, "verse_number": "३-२२-८८", "content_sanskrit": "इति तस्या वचः श्रुत्वा संपद्देव्या शुचिस्मिता ।\nनिवर्तयामास चमूङ्कुरुण्डाभिमुखोत्थिताम् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7006268088, "chapter_id": 26268, "verse_number": "३-२२-८९", "content_sanskrit": "अथ बालार्कवर्णाभिः शक्तिभिः समधिष्ठिताः ।\nतरङ्गा इव सैन्याब्धेस्तुरङ्गा वातरंहसः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7006268089, "chapter_id": 26268, "verse_number": "३-२२-९०", "content_sanskrit": "खरैः खुरपुटैः क्षोणीमुल्लिखन्तो मुहुर्मुहुः ।\nपेतुरेकप्रवाहेण कुरण्डस्य चमूमुखे ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7006268090, "chapter_id": 26268, "verse_number": "३-२२-९१", "content_sanskrit": "वल्गाविभागकृत्येषु संवर्तनविवर्तने ।\nघतिभेदेषु चारेषु पञ्चधा खुरपातने ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7006268091, "chapter_id": 26268, "verse_number": "३-२२-९२", "content_sanskrit": "प्रोत्साहने च संज्ञाभिः करपादाग्रयोनिभिः ।\nचतुराभिस्तुरङ्गस्य हृदयज्ञाभिराहवे ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7006268092, "chapter_id": 26268, "verse_number": "३-२२-९३", "content_sanskrit": "अश्वारूढांबिकासैन्यशक्तिभिः सह दानवाः ।\nप्रोत्साहिताः कुरण्डेन समयुध्यन्त दुर्मदाः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7006268093, "chapter_id": 26268, "verse_number": "३-२२-९४", "content_sanskrit": "एवं प्रवृत्ते समरे शक्तीनां च सुरद्विषाम् ।\nअपराजितनामानं हयमारुह्य वेगिनम् ।\nअभ्यद्रवद्दुराचारमश्वारूढाः कुरण्डकम् ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7006268094, "chapter_id": 26268, "verse_number": "३-२२-९५", "content_sanskrit": "प्रचलद्वेणिसुभगा शरच्चन्द्रकलोज्ज्वला ।\nसंध्यानुरक्तशीतांशुमण्डलीसुंदरानना ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7006268095, "chapter_id": 26268, "verse_number": "३-२२-९६", "content_sanskrit": "स्मयमानेव समरे गृहीतमणिकार्मुका ।\nअवाकिरच्छरासारैः कुरण्डं तुरगानना ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7006268096, "chapter_id": 26268, "verse_number": "३-२२-९७", "content_sanskrit": "तुरगारूढयोत्क्षिप्ताः समाक्रामन्दिगन्तरान् ।\nदिशो दश व्यानशिरे रुक्मपुङ्खाः शिलीमुखाः ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7006268097, "chapter_id": 26268, "verse_number": "३-२२-९८", "content_sanskrit": "दुर्मदस्याग्रजः क्रुद्धः कुरण्डश्चण्डविक्रमः ।\nविशिखैः शार्ङ्गनिष्ठ्यूतैरश्वारूढा मवाकिरत् ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7006268098, "chapter_id": 26268, "verse_number": "३-२२-९९", "content_sanskrit": "चण्डैः खुरपुटैः सैन्यं खण्डयन्नतिवेगतः ।\nअश्वारूढातुरङ्गोऽपि मर्दयामास दानवान् ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7006268099, "chapter_id": 26268, "verse_number": "३-२२-१००", "content_sanskrit": "तस्या हेषारवाद्दूरमुत्पातांबुधिनिःस्वनः ।\nअमूर्च्छयन्ननेकानि तस्यानीतानि वैरिणः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7006268100, "chapter_id": 26268, "verse_number": "३-२२-१०१", "content_sanskrit": "इतस्ततः प्रचलितैर्दैत्यचक्रे हयासना ।\nनिजं पाशायुधं दिव्यं मुमोच ज्वलिताकृति ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7006268101, "chapter_id": 26268, "verse_number": "३-२२-१०२", "content_sanskrit": "तस्मात्पाशात्कोटिशोऽन्ये पाशा भुजगभीषणाः ।\nसमस्तमपि तत्सैन्यं बद्ध्वाबद्ध्वा व्यमूर्छयन् ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7006268102, "chapter_id": 26268, "verse_number": "३-२२-१०३", "content_sanskrit": "थ सैनिकबन्धेन क्रुद्धः स च कुरण्डकः ।\nसरेणैकेन चिच्छेद तस्या मणिधनुर्गुणम् ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7006268103, "chapter_id": 26268, "verse_number": "३-२२-१०४", "content_sanskrit": "छिन्नमौर्वि धनुस्त्यक्त्वा भृशङ्क्रुद्धा हयासना ।\nअङ्कुशं पातयामास तस्य वक्षसि दुर्मतेः ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7006268104, "chapter_id": 26268, "verse_number": "३-२२-१०५", "content_sanskrit": "तेनाङ्कुशेन ज्वलता पीतजीवितशोणितः ।\nकुरण्डो न्यपतद्भूमौ वज्ररुग्ण इव द्रुमः ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7006268105, "chapter_id": 26268, "verse_number": "३-२२-१०६", "content_sanskrit": "तदङ्कुशविनिष्ठ्यूताः पुतनाः काश्चिदुद्भटाः ।\nतत्सैन्यं पाशनिष्यन्दं भक्षयित्वा क्षयं गताः ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7006268106, "chapter_id": 26268, "verse_number": "३-२२-१०७", "content_sanskrit": "इत्थं कुरुण्डे निहते विंशत्यक्षौहिणीपतौ ।\nहतावशिष्टास्ते दैत्याः प्रपलायन्त वै द्रुतम् ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7006268107, "chapter_id": 26268, "verse_number": "३-२२-१०८", "content_sanskrit": "कुरण्डं सानुजं युद्धे शक्तिसैन्यैर्निपातितम् ।\nश्रुत्वा शून्यकनाथोऽपि निशश्वास भुजङ्गवत् ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}]