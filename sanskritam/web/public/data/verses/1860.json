[{"id": 2039213, "chapter_id": 1860, "verse_number": "५-१०५-०x", "content_sanskrit": "कण्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2039214, "chapter_id": 1860, "verse_number": "५-१०५-१", "content_sanskrit": "गरुडस्तत्र शुश्राव यथावृत्तं महाबलः ।\nआयुःप्रदानं शक्रेण कृतं नागस्य भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2039215, "chapter_id": 1860, "verse_number": "५-१०५-२", "content_sanskrit": "पक्षवातेन महता रुद्ध्वा त्रिभुवनं खगः।\nसुपर्णः परमक्रुद्धो वासवं समुपाद्रवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2039216, "chapter_id": 1860, "verse_number": "५-१०५-३x", "content_sanskrit": "गरुड उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2039217, "chapter_id": 1860, "verse_number": "५-१०५-३", "content_sanskrit": "भगवन्किमवज्ञानाद्वृत्तिः प्रतिहता मम।\nकामकारवरं दत्त्वा पुनश्चलितवानसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2039218, "chapter_id": 1860, "verse_number": "५-१०५-४", "content_sanskrit": "निसर्गात्सर्वभूतानां सर्वभूतेश्वरेण मे।\nआहारो विहितो धात्रा किमर्थं वार्यते त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2039219, "chapter_id": 1860, "verse_number": "५-१०५-५", "content_sanskrit": "वृतश्चैष महानागः स्थापितः समयश्च मे।\nअनेन च मया देव भर्तव्यः प्रसवो महान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2039220, "chapter_id": 1860, "verse_number": "५-१०५-६", "content_sanskrit": "एतस्मिंस्तु तथाभूते नान्यं हिंसितुमुत्सहे ।\nक्रीडसे कामकारेण देवराज यथेच्छकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2039221, "chapter_id": 1860, "verse_number": "५-१०५-७", "content_sanskrit": "सोऽहं प्राणान्विमोक्ष्यामि तथा परिजनो मम।\nये च भृत्या मम गृहे प्रीतिमान्भव वासव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2039222, "chapter_id": 1860, "verse_number": "५-१०५-८x", "content_sanskrit": "`कण्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2039223, "chapter_id": 1860, "verse_number": "५-१०५-८", "content_sanskrit": "श्रुत्वा सुपर्णवचनं सुमुखो दुर्मुखस्तदा।\nत्यक्त्वा रूपं विवर्णस्तु सर्परूपधरोऽभवत् ।\nगत्वा विष्णुसमीपं तु पादपीठं समाश्लिषत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2039224, "chapter_id": 1860, "verse_number": "५-१०५-९x", "content_sanskrit": "इन्द्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2039225, "chapter_id": 1860, "verse_number": "५-१०५-९", "content_sanskrit": "न मत्कृतं वैनतेय न मां क्रोद्धुं त्वमर्हसि।\nदत्ताभयः स सुमुखो विष्णुना प्रभविष्णुना ।\nश्रत्वा पुरन्दरेणोक्तमुवाच विनतासुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2039226, "chapter_id": 1860, "verse_number": "५-१०५-१०", "content_sanskrit": "एतच्चैवाहमर्हामि भूयश्च बलवृत्रहन्।\nत्रैलोक्यस्येश्वरो योऽहं परभृत्यत्वमागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2039227, "chapter_id": 1860, "verse_number": "५-१०५-११", "content_sanskrit": "त्वयि तिष्ठति देवेश न विष्णुः कारणं मम।\nत्रैलोक्यराजराज्यं हि त्वयि वासव शाश्वतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2039228, "chapter_id": 1860, "verse_number": "५-१०५-१२", "content_sanskrit": "ममापि दक्षस्य सुता जननी कश्यपः पिता।\nअहमत्युत्सहे लोकान्समन्ताद्वोढुमोजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2039229, "chapter_id": 1860, "verse_number": "५-१०५-१३", "content_sanskrit": "असह्यं सर्वभूतानां ममापि विपुलं बलम्।\nमयाऽपि सुमहत्कर्म कृतं दैतेयविग्रहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2039230, "chapter_id": 1860, "verse_number": "५-१०५-१४", "content_sanskrit": "श्रुतश्रीः श्रुतसेनश्च विवस्वान्रोचनामुखः ।\nप्रस्रुतः कालकाक्षश्च मयाऽपि दितिजा हताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2039231, "chapter_id": 1860, "verse_number": "५-१०५-१५", "content_sanskrit": "यत्तु ध्वजस्थानगतो यत्नात्परिचराम्यहम्।\nवहामि चैवानुजं ते तेन मामवमन्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2039232, "chapter_id": 1860, "verse_number": "५-१०५-१६", "content_sanskrit": "कोऽन्यो भारसहो ह्यस्ति कोऽन्योस्ति बलवत्तरः ।\nमया योऽहं विशिष्टः सन्वहामीमं सबान्धवं ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2039233, "chapter_id": 1860, "verse_number": "५-१०५-१७", "content_sanskrit": "अवज्ञाय तु यत्तेऽहं भोजनाद्व्यपरोपितः ।\nतेन मे गौरवं नष्टं त्वत्तश्चास्माच्च वासव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2039234, "chapter_id": 1860, "verse_number": "५-१०५-१८", "content_sanskrit": "अदित्यां य इमे जाता बलविक्रमशालिनः ।\nत्वमेषां किल सर्वेषां बलेन बलवत्तरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2039235, "chapter_id": 1860, "verse_number": "५-१०५-१९", "content_sanskrit": "सोऽहं पक्षैकदेशेन वहामि त्वां गतक्लमः ।\nविमृश त्वं शनैस्तात कोऽन्वत्र बलवानिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2039236, "chapter_id": 1860, "verse_number": "५-१०५-२०x", "content_sanskrit": "कण्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2039237, "chapter_id": 1860, "verse_number": "५-१०५-२०", "content_sanskrit": "स तस्य वचनं श्रुत्वा खगस्योदर्कदारुणम्।\nअक्षोभ्यं क्षोभयंस्तार्क्ष्यमुवाच रथचक्रभृत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2039238, "chapter_id": 1860, "verse_number": "५-१०५-२१", "content_sanskrit": "गरुत्मन्मन्यसेत्मानं बलवन्तं सुदुर्बलम् ।\nअलमस्मत्समक्षं ते स्तोतुमात्मानमण्डज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2039239, "chapter_id": 1860, "verse_number": "५-१०५-२२", "content_sanskrit": "त्रैलोक्यमपि मे कृत्स्नमशक्तं देहधारणे।\nअहमेवात्मनात्मानं वहामि त्वां च धारये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2039240, "chapter_id": 1860, "verse_number": "५-१०५-२३", "content_sanskrit": "`न त्वं वहसि मां दोर्भ्यां मोघं तव विकत्थनम् ।\nइमं तावन्ममैकं त्वं बाहुं सव्येतरं वह।\nयद्येनं धारयस्येकं सफलं ते विकत्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2039241, "chapter_id": 1860, "verse_number": "५-१०५-२४", "content_sanskrit": "इत्युक्त्वा भगवांस्तस्य स्कन्धे बाहुं समासजत् ।\n`आरोपितं समुद्वोढुं भारं तं नाशकद्बलात् ।\nनिपपात स भारार्तो विहलो नष्टचेतनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2039242, "chapter_id": 1860, "verse_number": "५-१०५-२५", "content_sanskrit": "यावान्हि भारः कृत्स्नायाः पृथिव्याः पर्वतैः सह ।\nएकस्या देहशाखायास्तावद्भारममन्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2039243, "chapter_id": 1860, "verse_number": "५-१०५-२६", "content_sanskrit": "न त्वेनं पीडयामास बलेन बलवत्तरः।\nततो हि जीवितं तस्य न व्यनीनशदच्युतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2039244, "chapter_id": 1860, "verse_number": "५-१०५-२७", "content_sanskrit": "व्यात्तास्यः स्रस्तकायश्च विचेता विह्वलः खगः ।\nमुमोच पत्राणि तदा गुरुभारप्रपीडितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2039245, "chapter_id": 1860, "verse_number": "५-१०५-२८", "content_sanskrit": "स विष्णुं शिरसा पक्षी प्रणम्य विनतासुतः।\nविचेता विह्वलो दीनः किंचिद्वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2039246, "chapter_id": 1860, "verse_number": "५-१०५-२९", "content_sanskrit": "भगवँल्लोकसारस्य सदृशेन वपुष्मता।\nभुजेन स्वैरमुक्तेन निष्पिष्टोऽस्मि महीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2039247, "chapter_id": 1860, "verse_number": "५-१०५-३०", "content_sanskrit": "क्षन्तुमर्हसि मे देव विह्वलस्याल्पचेतसः।\nबलदाहविदग्धस्य पक्षिणो ध्वजवासिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2039248, "chapter_id": 1860, "verse_number": "५-१०५-३१", "content_sanskrit": "न हि ज्ञातं बलं देव मया ते परम विभो।\nतेन मन्याम्यहं वीर्यमात्मनो न समं परैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2039249, "chapter_id": 1860, "verse_number": "५-१०५-३२x", "content_sanskrit": "कण्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2039250, "chapter_id": 1860, "verse_number": "५-१०५-३२", "content_sanskrit": "ततश्चक्रे स भगवान्प्रसादं वै गरुत्मतः।\nमैवं भूय इति स्नेहात्तदा चैनमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2039251, "chapter_id": 1860, "verse_number": "५-१०५-३३", "content_sanskrit": "पादाङ्गुष्ठेन चिक्षेप सुमुखं गरुडोरसि।\nततः प्रभृति राजेन्द्र सहसर्पेण वर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2039252, "chapter_id": 1860, "verse_number": "५-१०५-३४", "content_sanskrit": "एवं विष्णुबलाक्रान्तो गर्वनाशमुपागतः।\nगरुडो बलवान्राजन्वैनतेयो महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2039253, "chapter_id": 1860, "verse_number": "५-१०५-३५x", "content_sanskrit": "कण्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2039254, "chapter_id": 1860, "verse_number": "५-१०५-३५", "content_sanskrit": "तथा त्वमपि गान्धारे यावत्पाण्डुसुतान्रणे।\nनासादयसि तान्वीरांस्तावज्जीवसि पुत्रक ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2039255, "chapter_id": 1860, "verse_number": "५-१०५-३६", "content_sanskrit": "भीमः प्रहरतां श्रेष्ठो वायुपुत्रो महाबलः ।\nधनञ्जयश्चेन्द्रसुतो न हन्यातां तु कं रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2039256, "chapter_id": 1860, "verse_number": "५-१०५-३७", "content_sanskrit": "विष्णुर्वायुश्च शक्रश्च धर्मस्तौ चाश्विनावुभौ ।\nएते देवास्त्वया केन हेतुना वीक्षितुं क्षमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2039257, "chapter_id": 1860, "verse_number": "५-१०५-३८", "content_sanskrit": "तदलं ते विरोधेन शमं गच्छ नृपात्मज ।\nवासुदेवेन तीर्थेन कुलं रक्षितुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2039258, "chapter_id": 1860, "verse_number": "५-१०५-३९", "content_sanskrit": "प्रत्यक्षदर्शी सर्वस्य नारदोऽयं महातपाः ।\nमाहात्म्यस्य तदा विष्णोः सोऽयं चक्रगदाधरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2039259, "chapter_id": 1860, "verse_number": "५-१०५-४०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2039260, "chapter_id": 1860, "verse_number": "५-१०५-४०", "content_sanskrit": "दुर्योधनस्तु तच्छ्रुत्वा निश्वसन्भृकुटीमुखः।\nराधेयमभिसंप्रेक्ष्य जहास स्वनवत्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2039261, "chapter_id": 1860, "verse_number": "५-१०५-४१", "content_sanskrit": "कदर्थीकृत्य तद्वाक्यमृषेः कण्वस्य दुर्मतिः ।\nऊरुं गजकराकारं ताडयन्निदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2039262, "chapter_id": 1860, "verse_number": "५-१०५-४२", "content_sanskrit": "यथैवेश्वरसृष्टोऽस्मि यद्भावि या च मे गतिः।\nतथा महर्षे वर्तामि किं प्रलापः करिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2039263, "chapter_id": 1860, "verse_number": "५-१०५-४३", "content_sanskrit": "` ततः कण्वोऽब्रवीत्क्रुद्धो दुर्योधनमपण्डितम् ।\nयस्मादूकं ताडयसि ऊरौ मृत्युर्भविष्यति ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2039264, "chapter_id": 1860, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि पञ्चाधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]