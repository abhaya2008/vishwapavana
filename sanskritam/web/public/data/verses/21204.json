[{"id": 7001204000, "chapter_id": 21204, "verse_number": "२-३-५२-१", "content_sanskrit": "ब्रह्मोवाच ।\nअथ शैलवरस्तात हिमवान्भाग्यसत्तमः ।\nप्राङ्गणं रचयामास भोजनार्थं विचक्षणः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001204001, "chapter_id": 21204, "verse_number": "२-३-५२-२", "content_sanskrit": "मार्जनं लेपनं सम्यक्कारयामास तस्य सः ।\nस सुगन्धैरलञ्चक्रे नानावस्तुभिरादरात्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001204002, "chapter_id": 21204, "verse_number": "२-३-५२-३", "content_sanskrit": "अथ शैलस्सुरान्सर्वानन्यानपि च सेश्वरान् ।\nभोजनायाह्वयामास पुत्रैश्शैलैः परैरपि॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001204003, "chapter_id": 21204, "verse_number": "२-३-५२-४", "content_sanskrit": "शैलाह्वानमथाकर्ण्य स प्रभुस्साच्युतो मुने ।\nसर्वैस्सुरादिभिस्तत्र भोजनाय ययौ मुदा॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001204004, "chapter_id": 21204, "verse_number": "२-३-५२-५", "content_sanskrit": "गिरिः प्रभुं च सर्वांस्तान्सुसत्कृत्य यथाविधि ।\nमुदोपवेशयामास सत्पीठेषु गृहान्तरे॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001204005, "chapter_id": 21204, "verse_number": "२-३-५२-६", "content_sanskrit": "नानासुभोज्यवस्तूनि परिविष्य च तत्पुनः ।\nसाञ्चलिर्भोजनायाज्ञां चक्रे विज्ञप्तिमानतः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001204006, "chapter_id": 21204, "verse_number": "२-३-५२-७", "content_sanskrit": "अथ सम्मानितास्तत्र देवा विष्णुपुरोगमाः ।\nसदाशिवं पुरस्कृत्य बुभुजुस्सकलाश्च ते॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001204007, "chapter_id": 21204, "verse_number": "२-३-५२-८", "content_sanskrit": "तदा सर्वे हि मिलिता ऐकपद्येन सर्वशः ।\nपंक्तिभूताश्च बुभुजु र्विहसन्तः पृथक्पृथक्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001204008, "chapter_id": 21204, "verse_number": "२-३-५२-९", "content_sanskrit": "नन्दिभृंगिवीरभद्रवीरभद्रगणाः पृथक् ।\nबुभुजुस्ते महाभागाः कुतूहलसमन्विताः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001204009, "chapter_id": 21204, "verse_number": "२-३-५२-१०", "content_sanskrit": "देवास्सेन्द्रा लोकपाला नानाशोभासमन्विताः ।\nबुभुजुस्ते महाभागा नानाहास्यरसैस्सह॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001204010, "chapter_id": 21204, "verse_number": "२-३-५२-११", "content_sanskrit": "सर्वे च मुनयो विप्रा भृग्वाद्या ऋषयस्तथा ।\nबुभुजु प्रीतितस्सर्वे पृथक् पंक्तिगतास्तदा॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001204011, "chapter_id": 21204, "verse_number": "२-३-५२-१२", "content_sanskrit": "तथा चण्डीगणास्सर्वे बुभुजुः कृतभाजनाः ।\nकुतूहलं प्रकुर्वन्तो नानाहास्यकरा मुदा॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001204012, "chapter_id": 21204, "verse_number": "२-३-५२-१३", "content_sanskrit": "एवन्ते भुक्तवन्तश्चाचम्य सर्वे मुदान्विताः ।\nविश्रामार्थं गताः प्रीत्या विष्ण्वाद्यास्स्वस्वमाश्रमम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001204013, "chapter_id": 21204, "verse_number": "२-३-५२-१४", "content_sanskrit": "मेनाज्ञया स्त्रियस्साध्व्य श्शिवं सम्प्रार्थ्य भक्तितः ।\nगेहे निवासयामासुर्वासाख्ये परमोत्सवे॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001204014, "chapter_id": 21204, "verse_number": "२-३-५२-१५", "content_sanskrit": "रत्नसिंहासने शम्भुर्मेनादत्ते मनोहरे ।\nसन्निधाय मुदा युक्तो ददृशे वासमन्दिरम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001204015, "chapter_id": 21204, "verse_number": "२-३-५२-१६", "content_sanskrit": "रत्नप्रदीपशतकैर्ज्वलद्भिर्ज्वलितं श्रिया ।\nरत्नपात्रघटाकीर्णं मुक्तामणिविराजितम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001204016, "chapter_id": 21204, "verse_number": "२-३-५२-१७", "content_sanskrit": "रत्नदर्प्पणशोभाढ्यं मण्डितं श्वेतचामरैः ।\nमुक्तामणिसुमालाभिर्वेष्टितं परमर्द्धिमत्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001204017, "chapter_id": 21204, "verse_number": "२-३-५२-१८", "content_sanskrit": "अनूपमम्महादिव्यं विचित्रं सुमनोहरम् ।\nचित्ताह्लादकरं नानारचनारचितस्थलम्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001204018, "chapter_id": 21204, "verse_number": "२-३-५२-१९", "content_sanskrit": "शिवदत्तवरस्यैव प्रभावमतुलम्परम् ।\nदर्शयन्तं समुल्लासि शिवलोकाभिधानकम्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001204019, "chapter_id": 21204, "verse_number": "२-३-५२-२०", "content_sanskrit": "नानासुगन्धसद्द्रव्यैर्वासितं सुप्रकाशकम् ।\nचन्दनागुरुसंयुक्तं पुष्पशय्यासमन्वितम्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001204020, "chapter_id": 21204, "verse_number": "२-३-५२-२१", "content_sanskrit": "नानाचित्रविचित्राढ्यं निर्मितं विश्वकर्म्मणा ।\nरत्नेन्द्रसाररचितैराचितं हारकैर्वरैः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001204021, "chapter_id": 21204, "verse_number": "२-३-५२-२२", "content_sanskrit": "कुत्रचित्सुरनिर्माणं वैकुण्ठं सुमनोहरम् ।\nकुत्रचिच्च ब्रह्मलोकं लोकपालपुरं क्वचित्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001204022, "chapter_id": 21204, "verse_number": "२-३-५२-२३", "content_sanskrit": "कैलासं कुत्रचिद्रम्यं कुत्रचिच्छक्रमन्दिरम् ।\nकुत्रचिच्छिवलोकं च सर्वोपरि विराजितम्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001204023, "chapter_id": 21204, "verse_number": "२-३-५२-२४", "content_sanskrit": "एतादृशगृहं सर्वदृष्टाश्चर्य्यं महेश्वरः ।\nप्रशंसन् हिमशैलेशं परितुष्टो बभूव ह॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001204024, "chapter_id": 21204, "verse_number": "२-३-५२-२५", "content_sanskrit": "तत्रातिरमणीये च रत्नपर्य्यंक उत्तमे ।\nअशयिष्ट मुदा युक्तो लीलया परमेश्वरः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001204025, "chapter_id": 21204, "verse_number": "२-३-५२-२६", "content_sanskrit": "हिमाचलश्च स्वभ्रातॄन्भोजयामास कृत्स्नशः ।\nसर्वानन्यांश्च सुप्रीत्या शेषकृत्यं चकार ह॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001204026, "chapter_id": 21204, "verse_number": "२-३-५२-२७", "content_sanskrit": "एवं कुर्वति शैलेशे स्वपति प्रेष्ठ ईश्वरे ।\nव्यतीता रजनी सर्वा प्रातःकालो बभूव ह॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001204027, "chapter_id": 21204, "verse_number": "२-३-५२-२८", "content_sanskrit": "अथ प्रभातकाले च धृत्युत्साहपरायणाः ।\nनानाप्रकारवाद्यानि वादयाञ्चक्रिरे जनाः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001204028, "chapter_id": 21204, "verse_number": "२-३-५२-२९", "content_sanskrit": "सर्वे सुरास्समुत्तस्थुर्विष्ण्वाद्यास्सुमुदान्विताः ।\nस्वेष्टं संस्मृत्य देवेशं सज्जिभूतास्ससंभ्रमाः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001204029, "chapter_id": 21204, "verse_number": "२-३-५२-३०", "content_sanskrit": "स्ववाहनानि सज्जानि कैलासङ्गन्तुमुत्सुकाः ।\nकृत्वा सम्प्रेषयामासुर्धर्मं शिवसमीपतः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001204030, "chapter_id": 21204, "verse_number": "२-३-५२-३१", "content_sanskrit": "वासगेहमथागत्य धर्मो नारायणाज्ञया ।\nउवाच शंकरं योगी योगीशं समयोचितम्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001204031, "chapter_id": 21204, "verse_number": "२-३-५२-३२", "content_sanskrit": "॥ धर्म उवाच  ।\nउत्तिष्ठोत्तिष्ठ भद्रन्ते भव नः प्रमथाधिप ।\nजनावासं समागच्छ कृतार्थं कुरु तत्र तान्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001204032, "chapter_id": 21204, "verse_number": "२-३-५२-३३", "content_sanskrit": "॥ ब्रह्मोवाच  ।\nइति धर्मवचः श्रुत्वा विजहास महेश्वरः ।\nददर्श कृपया दृष्ट्या तल्पमुज्झाञ्चकार ह॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001204033, "chapter_id": 21204, "verse_number": "२-३-५२-३४", "content_sanskrit": "उवाच विहसन् धर्म त्वमग्रे गच्छ तत्र ह ।\nअहमप्यागमिष्यामि द्रुतमेव न संशयः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001204034, "chapter_id": 21204, "verse_number": "२-३-५२-३५", "content_sanskrit": "॥ ब्रह्मोवाच  ।\nइत्युक्तश्शंकरेणाथ जनावासं जगाम सः ।\nस्वयङ्गन्तुमना आसीत्तत्र शम्भुरपि प्रभुः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001204035, "chapter_id": 21204, "verse_number": "२-३-५२-३६", "content_sanskrit": "तज्ज्ञात्वा स्त्रीगणस्सोसौ तत्रागच्छन्महोत्सवः ।\nचक्रे मंगलगानं हि पश्यन्शम्भुपदद्वयम्॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001204036, "chapter_id": 21204, "verse_number": "२-३-५२-३७", "content_sanskrit": "अथ शंम्भुर्भवाचारी प्रातःकृत्यं विधाय च ।\nमेनामान्त्र्य कुध्रं च जनावासं जगाम सः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001204037, "chapter_id": 21204, "verse_number": "२-३-५२-३८", "content_sanskrit": "महोत्सवस्तदा चासीद्वेदध्वनिरभून्मुने ।\nवाद्यानि वादयामासुर्जनाश्चातुर्विधानि च॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001204038, "chapter_id": 21204, "verse_number": "२-३-५२-३९", "content_sanskrit": "शम्भुरागत्य स्वस्थानं ववन्दे च मुनींस्तदा ।\nहरिं च मां भवाचारात् वन्दितोऽभूत्सुरादिभिः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001204039, "chapter_id": 21204, "verse_number": "२-३-५२-४०", "content_sanskrit": "जयशब्दो बभूवाथ नमश्शब्दस्तथैव च ।\nवेदध्वनिश्च शुभदो महाकोलाहलोऽभवत्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]