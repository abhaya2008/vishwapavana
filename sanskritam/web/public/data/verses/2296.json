[{"id": 2060543, "chapter_id": 2296, "verse_number": "८-१७-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2060544, "chapter_id": 2296, "verse_number": "८-१७-१", "content_sanskrit": "धृष्टद्युम्नं कृपो राजन्वारयामास संयुगे।\nयथा दृष्ट्वा वने सिंहं शरभो वारयेद्युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2060545, "chapter_id": 2296, "verse_number": "८-१७-२", "content_sanskrit": "निरुद्वः पार्षतस्तेन गौतमेन बलीयसा।\nपदात्पदं विचलितुं नाशकत्तत्र भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2060546, "chapter_id": 2296, "verse_number": "८-१७-३", "content_sanskrit": "गौतमस्य रथं दृष्ट्वा धृष्टद्युम्नरथं प्रति।\nवित्रेसुः सर्वभूतानि क्षयं प्राप्तं च मेनिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2060547, "chapter_id": 2296, "verse_number": "८-१७-४", "content_sanskrit": "तदा जल्पन्ति पाण्डूनां रथिनः सादिनस्तथा।\nद्रोणस्य निधनान्नूनं सङ्क्रुद्वो द्विपदां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2060548, "chapter_id": 2296, "verse_number": "८-१७-५", "content_sanskrit": "शारद्वतो महातेजा दिव्यास्त्रविदुदारधीः।\nअपि स्वस्ति भवेदद्य धृष्टद्युम्नस्य गौतमात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2060549, "chapter_id": 2296, "verse_number": "८-१७-६", "content_sanskrit": "अपीयं वाहिनी कृत्स्ना मुच्येत महतो भयात्।\nअप्ययं ब्राह्मणः सर्वान्न नो हन्यात्समागतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2060550, "chapter_id": 2296, "verse_number": "८-१७-७", "content_sanskrit": "यादृशं दृश्यते रूपमन्तकप्रतिमं रणे।\nगमिष्यत्यद्य पदवीं भारद्वाजस्य गौतमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2060551, "chapter_id": 2296, "verse_number": "८-१७-८", "content_sanskrit": "आचार्यः क्षिप्रहस्तश्च विजयी च सदा युधि।\nअस्त्रवान्वीर्यसम्पन्नः क्रोधेन च समन्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2060552, "chapter_id": 2296, "verse_number": "८-१७-९", "content_sanskrit": "पार्षतश्च महायुद्वे विमुखोऽद्याभिलक्ष्यते।\nइत्येवं विविधा वाचस्तावकानां परैः सह।\nव्यश्रूयन्त महाराज तयोस्तत्र समागमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2060553, "chapter_id": 2296, "verse_number": "८-१७-१०", "content_sanskrit": "विनिःश्वस्य ततः क्रोधात्कृपः शारद्वतो नृप।\nपार्षतं चार्दयामास निश्चेष्टं सर्वमर्मसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2060554, "chapter_id": 2296, "verse_number": "८-१७-११", "content_sanskrit": "स हन्यमानः समरे गौतमेन महात्मना।\nकर्तव्यं न स्म जानाति मोहेन महता वृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2060555, "chapter_id": 2296, "verse_number": "८-१७-१२", "content_sanskrit": "तमब्रवीत्ततो यन्ता कञ्चित्क्षेमं तु पार्षत।\nईदृशं व्यसनं युद्धे न ते दृष्टं मया क्वचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2060556, "chapter_id": 2296, "verse_number": "८-१७-१३", "content_sanskrit": "दैवयोगात्तु ते बाणा नापतन्मर्मभेदिनः।\nप्रेषिता द्विजमुख्येन मर्माण्युद्दिश्य सर्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2060557, "chapter_id": 2296, "verse_number": "८-१७-१४", "content_sanskrit": "व्यावर्तये रथं तूर्णं नदीवेगमिवार्णवात्।\nअवध्यं ब्राह्मणं मन्ये येन ते विक्रमो हतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2060558, "chapter_id": 2296, "verse_number": "८-१७-१५", "content_sanskrit": "धृष्टद्युम्नस्ततो राजञ्शनकैरब्रवीद्वचः।\nमुह्यते मे मनस्तात गात्रस्वेदश्च जायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2060559, "chapter_id": 2296, "verse_number": "८-१७-१६", "content_sanskrit": "वेपथुश्च शरीरे मे रोमहर्षश्च सारथे।\nवर्जयन्ब्राह्मणं युद्धे शनैर्याहि यतोऽर्जुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2060560, "chapter_id": 2296, "verse_number": "८-१७-१७", "content_sanskrit": "अर्जुनं भीमसेनं वा समरे प्राप्य सारथे।\nक्षेममद्य भवेन्मह्यमिति मे नैष्ठिकी मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2060561, "chapter_id": 2296, "verse_number": "८-१७-१८", "content_sanskrit": "ततः प्रायान्महाराज सारथिस्त्वरयन्हयान्।\nयतो भीमो महेष्वासो युयुधे तव सैनिकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2060562, "chapter_id": 2296, "verse_number": "८-१७-१९", "content_sanskrit": "प्रद्रुतं च रथं दृष्ट्वा धृष्टद्युम्नस्य मारिष।\nकिरञ्शरशतान्येव गौतमोऽनुययौ तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2060563, "chapter_id": 2296, "verse_number": "८-१७-२०", "content_sanskrit": "शङ्खं च पूरयामास मुहुर्मुहुररिन्दमः।\nपार्षतं त्रासयामास महेन्द्रो नमुचिं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2060564, "chapter_id": 2296, "verse_number": "८-१७-२१", "content_sanskrit": "शिखण्डिनं तु समरे भीष्ममृत्युं दुरासदम्।\nहार्दिक्यो वारयामास स्मयन्निव मुहुर्मुहुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2060565, "chapter_id": 2296, "verse_number": "८-१७-२२", "content_sanskrit": "शिखण्डी तु समासाद्य हृदिकानां महारथम्।\nपञ्चभिर्निशितैर्भल्लैर्जत्रुदेशे समाहनत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2060566, "chapter_id": 2296, "verse_number": "८-१७-२३", "content_sanskrit": "कृतवर्मा तु सङ्क्रद्धो भित्त्वा षष्ट्या पतत्रिभिः।\nधनुरेकेन चिच्छेद हसन्राजन्महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2060567, "chapter_id": 2296, "verse_number": "८-१७-२४", "content_sanskrit": "अथान्यद्वनुरादाय द्रुपदस्यात्मजो बली।\nतिष्ठतिष्ठेति सङ्क्रुद्धो हार्दिक्यं प्रत्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2060568, "chapter_id": 2296, "verse_number": "८-१७-२५", "content_sanskrit": "ततोऽस्य नवतिं बाणान्रुक्मपुङ्खान्सुतेजनान्।\nप्रेषयामास राजेन्द्र तेऽस्याभ्रश्यन्त वर्मणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2060569, "chapter_id": 2296, "verse_number": "८-१७-२६", "content_sanskrit": "वितथांस्तान्समालक्ष्य पतितांश्च महीतले।\nक्षुरप्रेण सुतीक्ष्णेन कार्मुकं चिच्छिदे भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2060570, "chapter_id": 2296, "verse_number": "८-१७-२७", "content_sanskrit": "अथैनं छिन्नधन्वानं भग्नशृङ्गमिवर्षभम्।\nअशीत्या मार्गणैः क्रुद्धो बाह्वोरुरसि चार्पयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2060571, "chapter_id": 2296, "verse_number": "८-१७-२८", "content_sanskrit": "कृतवर्मा तु सङ्क्रुद्धो मार्गणैः क्षतविक्षतः।\nववाम रुधिरं गात्रैः कुम्भवक्रादिवोदकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2060572, "chapter_id": 2296, "verse_number": "८-१७-२९", "content_sanskrit": "रुधिरेण परिक्लिन्नः कृतवर्मा त्वराजत।\nवर्षेण क्लेदितो राजन्यथा गैरिकपर्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2060573, "chapter_id": 2296, "verse_number": "८-१७-३०", "content_sanskrit": "अथान्यद्वनुरादाय समार्गणगुणं प्रभुः।\nशिखण्डिनं बाणगणैः स्कन्धदेशे व्यताडयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2060574, "chapter_id": 2296, "verse_number": "८-१७-३१", "content_sanskrit": "स्कन्धदेशस्थितैर्बाणैः शिखण्डी तु व्यराजत।\nशाखाप्रशाखाविपुलः सुमहान्पादपो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2060575, "chapter_id": 2296, "verse_number": "८-१७-३२", "content_sanskrit": "तावन्योन्यं भृशं विद्व्वा रुधिरेण समुक्षितौ।\n`पोप्लुयमानौ हि यथा महान्तौ शोणितहदे।\nतद्वद्विरेजतुर्वीरौ शोणितेन परिप्लुतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2060576, "chapter_id": 2296, "verse_number": "८-१७-३३", "content_sanskrit": "यथा च किंशुकौ फुल्लौ पुष्पमासे समागते।\nरुधिरोक्षितसर्वाङ्गौ रक्तचन्दनरूषितौ।\nभुजगाविव सङ्क्रुद्धौ रेजतुस्तौ नरोत्तमौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2060577, "chapter_id": 2296, "verse_number": "८-१७-३४", "content_sanskrit": "तावुभौ शरवनुन्नाङ्गौ परस्परशरक्षतौ।\nअन्योन्यशृङ्गाभिहतौ रेजतुर्वृषभाविव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2060578, "chapter_id": 2296, "verse_number": "८-१७-३५", "content_sanskrit": "अन्योन्यस्य वधे यत्नं कुर्वाणौ तौ महारथौ।\nरथाभ्यां चेरतुस्तत्र मण्डलानि सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2060579, "chapter_id": 2296, "verse_number": "८-१७-३६", "content_sanskrit": "कृतवर्मा महाराज पार्षतं निशितैः शरैः।\nरणे विव्याध सप्तत्या स्वर्णपुङ्गैः शिलाशितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2060580, "chapter_id": 2296, "verse_number": "८-१७-३७", "content_sanskrit": "ततोऽस्य समरे बाणं भोजः प्रहरतां वरः।\nजीवितान्तकरं घोरं व्यसृजत्त्वरयाऽन्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2060581, "chapter_id": 2296, "verse_number": "८-१७-३८", "content_sanskrit": "स तेनाभिहतो राजन्मूर्च्छामाशु समाविशत्।\nध्वजयष्टिं च सहसा शिश्रिये कश्मलावृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2060582, "chapter_id": 2296, "verse_number": "८-१७-३९", "content_sanskrit": "अपोवाह रणात्तूर्णं सारथी रथिनां वरम्।\nहार्दिक्यशरसन्तप्तं निःश्वसन्तं पुनःपुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2060583, "chapter_id": 2296, "verse_number": "८-१७-४०", "content_sanskrit": "पराजिते ततः शूरे द्रुपदस्यात्मजे प्रभो।\nव्यद्रवत्पाण्डवी सेना व्यधमाना समन्ततः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2060584, "chapter_id": 2296, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि षोडशदिवसयुद्धे सप्तदशोऽध्यायः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]