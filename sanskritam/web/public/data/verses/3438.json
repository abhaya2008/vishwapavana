[{"id": 2113320, "chapter_id": 3438, "verse_number": "", "content_sanskrit": "दुर्योधनादिशतपुत्राणां नामकथनम् । दुश्शलाजयद्रथयोर्विवाहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2113321, "chapter_id": 3438, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2113322, "chapter_id": 3438, "verse_number": "१", "content_sanskrit": "ज्येष्ठानुज्येष्ठतां चैव नामधेयानि च प्रभो ।\nधृतराष्ट्रस्य पुत्राणामानुपूर्व्येण कीर्तय\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2113323, "chapter_id": 3438, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2113324, "chapter_id": 3438, "verse_number": "२", "content_sanskrit": "दुर्योधनो युयुत्सुश्च राजन् दुःशासनस्तथा ।\nदुर्धर्षो दुर्मुखश्चैव जलसन्धिः सहः समः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2113325, "chapter_id": 3438, "verse_number": "३", "content_sanskrit": "विन्दानुविन्दौ दुष्प्रापः सुबाहुर्दुष्प्रधर्षणः ।\nदुर्मदश्चित्रयोधश्च दुष्कर्णः कर्ण एव च \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2113326, "chapter_id": 3438, "verse_number": "४", "content_sanskrit": "विविंशतिर्विकर्णश्च जयसन्धः सुलोचनः ।\nचित्रो विचित्रश्चित्राक्षः चारुचित्रः शरासनः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2113327, "chapter_id": 3438, "verse_number": "५", "content_sanskrit": "दुर्मर्षणो दुष्प्रधर्षो विवित्सुर्विकलः शमः ।\nऊर्णनाभः सुनाभश्च तथा नन्दोपनन्दकौ \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2113328, "chapter_id": 3438, "verse_number": "६", "content_sanskrit": "सेनापतिः सुषेणश्च कुण्डोदरमहोदरौ ।\nचित्रध्वजश्चित्ररथः चित्रबाहुरमित्रजित् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2113329, "chapter_id": 3438, "verse_number": "७", "content_sanskrit": "चित्रबाणश्चित्रवर्मा सुवर्मा दुर्विलोचनः ।\nचित्रसेनश्च विक्रान्तः सुचित्रश्चित्रवर्मधृक्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2113330, "chapter_id": 3438, "verse_number": "८", "content_sanskrit": "अपराजितः पण्डितको विशालाक्षो दुरासदः ।\nअजितश्च जयन्तश्च जयत्सेनोऽथ दुर्जयः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2113331, "chapter_id": 3438, "verse_number": "९", "content_sanskrit": "दृढहस्तः सुहस्तश्च वातवेगसुवर्चसौ ।\nआदित्यकेतुर्बह्वाशी नागदन्तोग्रशायिनौ\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2113332, "chapter_id": 3438, "verse_number": "१०", "content_sanskrit": "कवची निषङ्गी पाशी च दण्डधार अनुग्रहः ।\nउग्रो भीमरथो भीमो भीमबाहुरलोलुपः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2113333, "chapter_id": 3438, "verse_number": "११", "content_sanskrit": "भीमकर्मा सुबाहुश्च भीमविक्रान्त एव च ।\nअभयो रूक्षकर्मा च तथा दृढरथश्च यः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2113334, "chapter_id": 3438, "verse_number": "१२", "content_sanskrit": "अनाधृष्यः कुण्डभेदी धीरारिर्दीर्घलोचनः ।\nदीर्घध्वजो दीर्घजङ्घ अदीर्घो दीर्घ एव च ।\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2113335, "chapter_id": 3438, "verse_number": "१३", "content_sanskrit": "दीर्घबाहुर्महाबाहुर्व्यूढोरुः कनकध्वजः ।\nमहाकुण्डश्च कुण्डश्च विकुण्डश्चित्रजस्तथा\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2113336, "chapter_id": 3438, "verse_number": "१४", "content_sanskrit": "असनश्चित्रकश्चैव दुःशला चैव भारत ।\nएतदेकशतं राजन् कन्या चैका प्रकीर्तिता\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2113337, "chapter_id": 3438, "verse_number": "१५", "content_sanskrit": "नामधेयानुपूर्ञ्येण विद्धि जन्मक्रमं नृप ।\nसर्वेऽप्यतिरथाः शूराः सर्वे युद्धविशारदाः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2113338, "chapter_id": 3438, "verse_number": "१६", "content_sanskrit": "सर्वे वेदविदश्चैव राजशास्त्रेषु चाभवन् ।\nसर्वे संसक्तविद्यास्तु मुख्याभिजनशोभिताः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2113339, "chapter_id": 3438, "verse_number": "१७", "content_sanskrit": "सर्वेषामनुरूपं च कृतदाराः कृतश्रमाः ।\nधृतराष्ट्रेण समये समीक्ष्य विधिवत् तदा \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2113340, "chapter_id": 3438, "verse_number": "१८", "content_sanskrit": "दुःशलां समये राजा सिन्धुराजाय भारत ।\nजयद्रथाय प्रददौ सौबलानुमतात् तदा \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2113341, "chapter_id": 3438, "verse_number": "समाप्तिः", "content_sanskrit": "इति पुत्रशतं राजन् युयुत्सुश्च शताधिकः ।\nकन्यका दुःशला चैव यथावत् कीर्तितं मया\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2113342, "chapter_id": 3438, "verse_number": "११७", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nसप्तदशाधिकशततमोऽध्यायः ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2113343, "chapter_id": 3438, "verse_number": "६५", "content_sanskrit": "॥ इति सम्भवपर्वणि पञ्चषष्टितमोऽध्यायः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2113344, "chapter_id": 3438, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]