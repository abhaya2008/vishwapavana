[{"id": 2075968, "chapter_id": 2609, "verse_number": "१२-११४-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2075969, "chapter_id": 2609, "verse_number": "१२-११४-१", "content_sanskrit": "विद्वान्मूढप्रगल्भेन मृदुस्तीक्ष्णेन भारत।\nआक्रुश्यमानः सदसि कथं कुर्यादरिंदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2075970, "chapter_id": 2609, "verse_number": "१२-११४-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2075971, "chapter_id": 2609, "verse_number": "१२-११४-२", "content_sanskrit": "श्रूयतां पृथिवीपाल यथैऽषोर्थोऽवगम्यते।\nसदा सचेताः सहते नरस्येहाल्पचेतसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2075972, "chapter_id": 2609, "verse_number": "१२-११४-३", "content_sanskrit": "आक्रुश्य दूष्यमाणश्च सुकृतं तस्य विन्दति।\nदुष्कृतं चात्मनो मर्षी तस्मिन्नेव प्रमार्जति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2075973, "chapter_id": 2609, "verse_number": "१२-११४-४", "content_sanskrit": "गर्हितं तमुपेक्षेत वाश्यमानमिवातुरम्।\nलोके विद्वेषमापन्नो निष्फलं प्रतिपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2075974, "chapter_id": 2609, "verse_number": "१२-११४-५", "content_sanskrit": "इति संश्लाघते नित्यं तेन पापेन कर्मणा।\nइदमुक्तो मया कश्चित्सर्वतो जनसंसदि।\nस तत्र व्रीडितः शुष्को मृतकल्पोऽवतिष्ठते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2075975, "chapter_id": 2609, "verse_number": "१२-११४-६", "content_sanskrit": "श्लाघन्नश्लाघनीयेन कर्मणा निरपत्रपः।\nउपेक्षितव्यो दान्तेन तादृशः पुरुषाधमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2075976, "chapter_id": 2609, "verse_number": "१२-११४-७", "content_sanskrit": "यद्यद्ब्रूयादल्पमतिस्तत्तदस्य सहेत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2075977, "chapter_id": 2609, "verse_number": "१२-११४-८", "content_sanskrit": "प्रकृत्या हि प्रशंसन्वा निन्दन्वा किं करिष्यति।\nवने काक इवाबुद्धिर्वाश्यमानो निरर्थकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2075978, "chapter_id": 2609, "verse_number": "१२-११४-९", "content_sanskrit": "यदि वाग्भिः प्रयोगः स्यात्प्रयोज्यः पापकर्मणा।\nवागेवार्थो भवेत्तस्य न ह्येवार्थो जिघांसतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2075979, "chapter_id": 2609, "verse_number": "१२-११४-१०", "content_sanskrit": "निषेकं वै परस्यासावाचष्टे वृत्तचेष्टया।\nमयूर इव कौपीनं नृत्यं संदर्शयन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2075980, "chapter_id": 2609, "verse_number": "१२-११४-११", "content_sanskrit": "यस्यावाच्यं न लोकेऽस्मिन्नाकार्यं चापि किंचन।\nवाचं तेन न संदध्याच्छुचिः संश्लिष्टकर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2075981, "chapter_id": 2609, "verse_number": "१२-११४-१२", "content_sanskrit": "प्रत्यक्षं गुणवादी यः परोक्षं तु विनिन्दकः।\nस मानवः श्ववल्लोके नष्टलोकपरायणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2075982, "chapter_id": 2609, "verse_number": "१२-११४-१३", "content_sanskrit": "तादृग्दिनशतं चापि यद्ददाति जुहोति च।\nपरोक्षेणापवादेन तं नाशयति तत्क्षणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2075983, "chapter_id": 2609, "verse_number": "१२-११४-१४", "content_sanskrit": "तस्मात्प्राज्ञो नरः सद्यस्तादृशं पापचेतसम्।\nवर्जयेन्मतिमान्वर्ज्यं सारमेयामिषं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2075984, "chapter_id": 2609, "verse_number": "१२-११४-१५", "content_sanskrit": "परिवादं ब्रुवाणो हि दुरात्मा वै महाजने।\nप्रकाशयति दोषान्स्वान्सर्पः फणमिवोन्नतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2075985, "chapter_id": 2609, "verse_number": "१२-११४-१६", "content_sanskrit": "तं स्वकर्मणि कुर्वाणं प्रतिकर्तुं य इच्छति।\nभस्मकूट इवाबुद्धिः खरो रजसि मज्जति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2075986, "chapter_id": 2609, "verse_number": "१२-११४-१७", "content_sanskrit": "मनुष्यसालावृकमप्रशान्तं\nजनापवादे सततं निविष्टम्।\nमातङ्गमुन्मत्तमिवोन्नदन्तं\nत्यजेत तं श्वानमिवातिरौद्रम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2075987, "chapter_id": 2609, "verse_number": "१२-११४-१८", "content_sanskrit": "अनार्यजुष्टे पथि वर्तमानं\nदमादपेतं विनयाच्च पापम्।\nअरिव्रतं नित्यमभूतिकामं\nधिगस्तु तं पापमतिं मनुष्यम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2075988, "chapter_id": 2609, "verse_number": "१२-११४-१९", "content_sanskrit": "प्रत्युच्यमानस्त्वथ भूय एव\nनिशाम्य माभूस्त्वमथार्तरूपः।\nउच्चस्य नीचेन हि संप्रयोगं\nविगर्हयन्ति स्थिरबुद्धयो ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2075989, "chapter_id": 2609, "verse_number": "१२-११४-२०", "content_sanskrit": "क्रुद्धो दशेद्वाऽपि च ताडयेद्वा\nस पांसुभिर्वा विकिरेत्तुषैर्वा।\nविवृत्य दन्तांश्च विभीषयेद्वा\nसिद्धं हि मूढे कुपिते नृशंसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2075990, "chapter_id": 2609, "verse_number": "१२-११४-२१", "content_sanskrit": "विगर्हणां नाऽपि दुरात्मना कृतां\nसहेत यः संसदि दुर्जनानाम्।\nपठेदिदं चापि निदर्शनं सदा\nन वाङ्भयं स लभति किंचिदप्रियम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2075991, "chapter_id": 2609, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि चतुर्दशाधिकशततमोऽध्यायः॥ ११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]