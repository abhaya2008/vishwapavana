[{"id": 2068484, "chapter_id": 2437, "verse_number": "९-५५-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2068485, "chapter_id": 2437, "verse_number": "९-५५-१", "content_sanskrit": "कुरुक्षेत्रं ततो दृष्ट्वा दत्त्वा देयांश्च सात्वतः।\nआश्रमं सुमहत्पुण्यमगमज्जनमेजय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2068486, "chapter_id": 2437, "verse_number": "९-५५-२", "content_sanskrit": "मधूकाम्रवणोपेतं प्लुक्षन्यग्रोधसङ्कुलम्।\nचिरबिल्वयुतं पुण्यं पनसार्जुनसङ्कुलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2068487, "chapter_id": 2437, "verse_number": "९-५५-३", "content_sanskrit": "तं दृष्ट्वा यादवश्रेष्ठः प्रवरं पुण्यलक्षणम्।\nपप्रच्छ तानृषीन्सर्वान्कस्याश्रमवरस्त्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2068488, "chapter_id": 2437, "verse_number": "९-५५-४", "content_sanskrit": "ते तु सर्वे महात्मानमूचू राजन्हलायुधम्।\nशृणु विस्तरशो राम यस्यायं पूर्वमाश्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2068489, "chapter_id": 2437, "verse_number": "९-५५-५", "content_sanskrit": "अत्र विष्णुः पुरा देवस्तप्तवांस्तप उत्तमम्।\nअत्रास्य विधिवद्यज्ञाः सर्वे वृत्ताः सनातनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2068490, "chapter_id": 2437, "verse_number": "९-५५-६", "content_sanskrit": "अत्रैव ब्राह्मणी वृद्वा कौमारब्रह्मचारिणी।\nयोगयुक्ता दिवं याता तपोयुक्ता विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2068491, "chapter_id": 2437, "verse_number": "९-५५-७", "content_sanskrit": "बभूव श्रीमती राजञ्शाण्डिल्यस्य महात्मनः।\nसुता धृतव्रता साध्वी नियता ब्रह्मचारिणी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2068492, "chapter_id": 2437, "verse_number": "९-५५-८", "content_sanskrit": "साऽपि प्राप्य परं योगं गता स्वर्गमनुत्तमम्।\nभुक्त्वाऽश्रमेऽश्वमेधस्य फलं फलवतः शुभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2068493, "chapter_id": 2437, "verse_number": "९-५५-९", "content_sanskrit": "गता स्वर्गं महाराज पूजिता च महात्मभिः।\nअभिगम्याश्रमं पुण्यं स दृष्ट्वा यदुनन्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2068494, "chapter_id": 2437, "verse_number": "९-५५-१०", "content_sanskrit": "ऋषींस्तानभिवाद्याथ पार्श्वे हिमवतोऽच्युतः।\nसन्ध्याकार्याणि सर्वाणि निर्वर्त्यारुरुहेऽचलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2068495, "chapter_id": 2437, "verse_number": "९-५५-११", "content_sanskrit": "नातिदूरं ततो गत्वा नगं तालध्वजो बली।\nपुण्ये तीर्थवरे स्नात्वा विस्मयं परमं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2068496, "chapter_id": 2437, "verse_number": "९-५५-१२", "content_sanskrit": "प्रभवं च सरस्वत्याः प्लक्षप्रस्रवणं बलः।\nसम्प्राप्तः कारपचनं तीर्थप्रवरमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2068497, "chapter_id": 2437, "verse_number": "९-५५-१३", "content_sanskrit": "हलायुधस्तु तत्रापि दत्त्वा दानं महाबलः।\nआप्लुतः सलिले पुण्ये सुशीते विमले शुचौ।\nसन्तर्पयामास पितॄन्देवांश्च रणदुर्मदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2068498, "chapter_id": 2437, "verse_number": "९-५५-१४", "content_sanskrit": "तत्रोष्यैकां तु रजनीं यतिभिर्ब्राह्मणैः सह।\nमित्रावरुणयोः पुण्यं जगामाश्रममच्युतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2068499, "chapter_id": 2437, "verse_number": "९-५५-१५", "content_sanskrit": "इन्द्रोऽग्निरर्यमा चैव यत्र प्राक् प्रीतिमाप्नुवम्।\nतं देशं कारपचनात्स तस्मादाजगामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2068500, "chapter_id": 2437, "verse_number": "९-५५-१६", "content_sanskrit": "स्नात्वा तत्र च धर्मात्मा परां प्रीतिमवाप्य च।\nऋषिभिश्चैव सिद्धैश्च सहितो वै महाबलः।\nउपविष्टः कथाः शुभ्राः शुश्राव यदुपुङ्गवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2068501, "chapter_id": 2437, "verse_number": "९-५५-१७", "content_sanskrit": "तथा तु तिष्ठतां तेषां नारदो भगवानृषिः।\nआजगामाथ तं देशं यत्र रामो व्यवस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2068502, "chapter_id": 2437, "verse_number": "९-५५-१८", "content_sanskrit": "जटामण्डलसंवीतः कुशचीरी महातपाः।\nहेमदण्डधरो राजन्कमण्डलुधरस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2068503, "chapter_id": 2437, "verse_number": "९-५५-१९", "content_sanskrit": "महतीं सुखशब्दां तां गृह्य वीणां मनोरमाम्।\nनृत्ये गीते च कुशलो देवब्राह्मणपूजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2068504, "chapter_id": 2437, "verse_number": "९-५५-२०", "content_sanskrit": "प्रभवः कलहानं च नित्यं च कलहप्रियः।\nतं देशमगमद्यत्र श्रीमान्रामो व्यवस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2068505, "chapter_id": 2437, "verse_number": "९-५५-२१", "content_sanskrit": "प्रत्युत्थाय च तं रामः पूजयित्वा यतव्रतम्।\nदेवर्षिं पर्यपृच्छत्स यथावृत्तं कुरून्प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2068506, "chapter_id": 2437, "verse_number": "९-५५-२२", "content_sanskrit": "तदाऽस्याकथयद्राजन्नारदः सर्ववेदवित्।\nसर्वमेतद्यथावृत्तमतीतं कुरुसंक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2068507, "chapter_id": 2437, "verse_number": "९-५५-२३", "content_sanskrit": "ततोऽब्रवीद्रौहिणेयो नारदं दीनया गिरा।\nकिमवस्थं तु तत्क्षत्रं ये तु तत्राभवन्नृपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2068508, "chapter_id": 2437, "verse_number": "९-५५-२४", "content_sanskrit": "श्रुतमेतन्मया पूर्वं सर्वमेव तपोधन।\nविस्तरश्रवणे जातं कौतूहलमतीव मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2068509, "chapter_id": 2437, "verse_number": "९-५५-२५x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2068510, "chapter_id": 2437, "verse_number": "९-५५-२५", "content_sanskrit": "पूर्वमेव हतो भीष्मो द्रोणः सिन्धुपतिस्तथा।\nहतो वैकर्तनः कर्णः पुत्राश्चास्य महारथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2068511, "chapter_id": 2437, "verse_number": "९-५५-२६", "content_sanskrit": "भूरिश्रवा रौहिणेय मद्रराजश्च वीर्यवान्।\nएते चान्ये च बहवो हतास्तत्र महाबलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2068512, "chapter_id": 2437, "verse_number": "९-५५-२७", "content_sanskrit": "प्रियान्प्राणान्परित्यज्य प्रियार्थं कौरवस्य वै।\nराजानो राजपुत्राश्च समरेष्वनिवर्तिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2068513, "chapter_id": 2437, "verse_number": "९-५५-२८", "content_sanskrit": "अहतांस्तु महाबाहो शृणु मे तत्र माधव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2068514, "chapter_id": 2437, "verse_number": "९-५५-२९", "content_sanskrit": "धार्तराष्ट्रबले शेषास्त्रयः समितिमर्दनाः।\nकृपश्च कृतवर्मा च द्रोणपुत्रश्च वीर्यवान्।\nतेऽपि वै विद्रुता राम दिशो दश भयात्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2068515, "chapter_id": 2437, "verse_number": "९-५५-३०", "content_sanskrit": "दुर्योधनो हते सैन्ये विद्रुतेषु पदातिषु।\nहदं द्वैपायनं नाम विवेश भृशदुःखितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2068516, "chapter_id": 2437, "verse_number": "९-५५-३१", "content_sanskrit": "शयानं धार्तराष्ट्रं तु सलिले स्तम्भिते तदा।\nपाण्डवाः सह कृष्णेन वाग्भिरुग्राभिरार्दयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2068517, "chapter_id": 2437, "verse_number": "९-५५-३२", "content_sanskrit": "स तुद्यमानो बलवान्वाग्भी राम समन्ततः।\nउत्थितः स हदाद्वीरः प्रगृह्य महतीं गदाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2068518, "chapter_id": 2437, "verse_number": "९-५५-३३", "content_sanskrit": "स चाप्युपागतो योद्धुं भीमेन सह साम्प्रतम्।\nभविष्यति तयोरद्य युद्धं राम सुदारुणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2068519, "chapter_id": 2437, "verse_number": "९-५५-३४", "content_sanskrit": "यदि कौतूहलं तेऽस्ति व्रज माधव मा चिरम्।\nपश्य युद्धं महाघोरं शिष्ययोर्यदि मन्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2068520, "chapter_id": 2437, "verse_number": "९-५५-३५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2068521, "chapter_id": 2437, "verse_number": "९-५५-३५", "content_sanskrit": "नारदस्य वचः श्रुत्वा तानभ्यर्च्य द्विजर्षभान्।\nसर्वान्विसर्जयामास ये तेनाभ्यागताः सह।\nगम्यतां द्वारकां चेति सोऽन्वशादनुयायिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2068522, "chapter_id": 2437, "verse_number": "९-५५-३६", "content_sanskrit": "सोऽवतीर्याचलश्रेष्ठात्प्लक्षप्रस्रवणाच्छुभात्।\nततः प्रीतमनाः रामः श्रुता तीर्थफलं महत्।\nविप्राणां सन्निधौ श्लोकमगायदिममच्युतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2068523, "chapter_id": 2437, "verse_number": "९-५५-३७", "content_sanskrit": "सरस्वतीवाससमा कुतो रतिः\nसरस्वतीवाससमाः कुतो गुणाः।\nसरस्वतीं प्राप्य दिवं गता जनाः\nसदा स्मरिष्यन्ति नदीं सरस्वतीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2068524, "chapter_id": 2437, "verse_number": "९-५५-३८", "content_sanskrit": "सरस्वती सर्वनदीषु पुण्या\nसरस्वती लोकशुभावहा सदा।\nसरस्वतीं प्राप्य जनाः सुदुष्कृतं\nसदा न शोचन्ति परत्र चेह च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2068525, "chapter_id": 2437, "verse_number": "९-५५-३९", "content_sanskrit": "ततो मुहुर्मुहुः प्रीत्या प्रेक्षमाणः सरस्वतीम्।\nहयैर्युक्तं रथं शुभ्रमारुरोह परन्तपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2068526, "chapter_id": 2437, "verse_number": "९-५५-४०", "content_sanskrit": "स शीघ्रगामिना तेन रथेन यदुपुङ्गवः।\nदिदृक्षुरभिसम्प्राप्तः शिष्ययुद्वमुपस्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2068527, "chapter_id": 2437, "verse_number": "९-५५-४१", "content_sanskrit": "एवं तदभवद्युद्वं तुमुलं जनमेजयं।\nयत्र दुःखान्वितो राजा धृतराष्ट्रोऽब्रवीदिदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2068528, "chapter_id": 2437, "verse_number": "९-५५-४२x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2068529, "chapter_id": 2437, "verse_number": "९-५५-४२", "content_sanskrit": "राम सन्निहितं श्रुत्वा गदायुद्ध उपस्थिते।\nमम पुत्रः कथं भीमं प्रत्ययुध्यत सञ्जय॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2068530, "chapter_id": 2437, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शल्यपर्वणि ह्रदप्रवेशपर्वणि पञ्चपञ्चाशत्तमोऽध्यायः॥ ५५ ॥ समाप्तं हदप्रवेशपर्व ॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]