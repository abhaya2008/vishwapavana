[{"id": 2063055, "chapter_id": 2342, "verse_number": "८-६३-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2063056, "chapter_id": 2342, "verse_number": "८-६३-१", "content_sanskrit": "निवृत्ते भीमसेने च पाण्डवे च युधिष्ठिरे।\nवध्यमाने बले चापि मामके पाण्डुसृञ्जयैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2063057, "chapter_id": 2342, "verse_number": "८-६३-२", "content_sanskrit": "द्रवमाणे बलौघे च निराक्रन्दे मुहुर्मुहुः।\n`अवशेषं न पश्यामि मम सैन्येषु सञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2063058, "chapter_id": 2342, "verse_number": "८-६३-३", "content_sanskrit": "अहो बत दशां प्राप्तो न हि शक्ष्यामि जीवितुम्।\nजयकाङ्क्षी कथं सूत पुत्राणामनिवर्तिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2063059, "chapter_id": 2342, "verse_number": "८-६३-४", "content_sanskrit": "कथं जीवामि निहताञ्श्रुत्वा च मम सैनिकान्।\nबहुनाऽद्य किमुक्तेन दैवं तेषां परायणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2063060, "chapter_id": 2342, "verse_number": "८-६३-५", "content_sanskrit": "मामकाः किमकुर्वन्त तन्ममाचक्ष्व सञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2063061, "chapter_id": 2342, "verse_number": "८-६३-६x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2063062, "chapter_id": 2342, "verse_number": "८-६३-६", "content_sanskrit": "दृष्ट्वा भीमं महाबाहुं तव पुत्रः प्रतापवान्।\nक्रोधरक्तेक्षणो राजन्भीमसेनमभिद्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2063063, "chapter_id": 2342, "verse_number": "८-६३-७", "content_sanskrit": "`तिष्ठतिष्ठ पृथापुत्र पश्य मेऽद्य पराक्रमम्।\nअद्य त्वां प्रेषायष्यामि यमस्य सदनं प्राते।\nइत्युक्त्वा प्रययौ कर्णो यत्र भीमो व्यवस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2063064, "chapter_id": 2342, "verse_number": "८-६३-८", "content_sanskrit": "तावकं तु बलं दृष्ट्वा भीमसेनात्पराङ्मुखम्।\nयत्नेन महता कर्णः पर्यवस्थापयद्बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2063065, "chapter_id": 2342, "verse_number": "८-६३-९", "content_sanskrit": "व्यवस्थाप्य महाबाहुस्तव पुत्रस्य वाहिनीम्।\nप्रत्युद्ययौ तदा कर्णः पाण्डवान्युद्धदुर्मदान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2063066, "chapter_id": 2342, "verse_number": "८-६३-१०", "content_sanskrit": "प्रत्युद्ययुश्च राधेयं पाण्डवानां महारथाः।\nधुन्वानाः कार्मुकाण्याजौ विक्षिपन्तश्च सायकान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2063067, "chapter_id": 2342, "verse_number": "८-६३-११", "content_sanskrit": "भीमसेनः शिनेर्नप्ता शिखण्डी जनमेजयः।\nधृष्टद्युम्नश्च बलवान्सर्वे चापि प्रभद्रकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2063068, "chapter_id": 2342, "verse_number": "८-६३-१२", "content_sanskrit": "पाञ्चालानां नरव्याघ्राः समन्तात्त्व वाहिनीम्।\nअभ्यद्रवन्त सङ्क्रुद्धाः समरे जितकाशिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2063069, "chapter_id": 2342, "verse_number": "८-६३-१३", "content_sanskrit": "तथैव तावका राजन्पाण्डवानामनीकिनीम्।\nअभ्यद्रवन्त त्वरिता जिघांसन्तो महारथान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2063070, "chapter_id": 2342, "verse_number": "८-६३-१४", "content_sanskrit": "रथनागाश्वकलिलं पत्तिध्वजसमाकुलम्।\nबभूव पुरुषव्याघ्र सैन्यमद्भुतदर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2063071, "chapter_id": 2342, "verse_number": "८-६३-१५", "content_sanskrit": "शिखण्डी तु ययौ कर्णं धृष्टद्युम्नः सुतं तव।\nदुःशासनं महाराज महासेनः समभ्ययात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2063072, "chapter_id": 2342, "verse_number": "८-६३-१६", "content_sanskrit": "नकुलो वृषसेनं तु चित्रसेनं युधिष्ठिरः।\nउलूकं समरे राजन्सहदेवः समभ्ययात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2063073, "chapter_id": 2342, "verse_number": "८-६३-१७", "content_sanskrit": "सात्यकिः शकुनिं चापि द्रौपदेयाश्च कौरवान्।\nअर्जुनं च रणे यत्तो द्रोणपुत्रो महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2063074, "chapter_id": 2342, "verse_number": "८-६३-१८", "content_sanskrit": "युधामन्युं महेष्वासं गौतमोऽभ्यपतद्रणे।\nकृतवर्मा च बलवानुत्तमौजसमाद्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2063075, "chapter_id": 2342, "verse_number": "८-६३-१९", "content_sanskrit": "भीमसेनः कुरून्सर्वान्पुत्रांश्च तव मारिष।\nसहानीकान्महाबाहुरेक एव न्यवारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2063076, "chapter_id": 2342, "verse_number": "८-६३-२०", "content_sanskrit": "शिखण्डी तु ततः कर्णं विचरन्तमभीतवत्।\nभीष्महन्ता महाराज वारयामास पत्रिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2063077, "chapter_id": 2342, "verse_number": "८-६३-२१", "content_sanskrit": "प्रतिरुद्धस्ततः कर्णो रोपात्प्रस्फुरिताधरः।\nशिखण्डिनं त्रिभिर्बाणैर्भ्रुवोर्मध्येऽभ्यताडयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2063078, "chapter_id": 2342, "verse_number": "८-६३-२२", "content_sanskrit": "धारयंस्तु स तान्वाणाञ्शिखण्डी बह्वशोभत।\nराजतः पर्वतो यद्वत्त्रिभिः शृङ्गैः समन्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2063079, "chapter_id": 2342, "verse_number": "८-६३-२३", "content_sanskrit": "सोऽतिविद्धो महेष्वासः सूतपुत्रेण संयुगे।\nकर्णं विव्याध समरे नवत्या निशितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2063080, "chapter_id": 2342, "verse_number": "८-६३-२४", "content_sanskrit": "तस्य कर्णो हयान्हत्वा सारथिं च शरैः।\nउन्ममाथ ध्वजं चास्य क्षुरप्रेण महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2063081, "chapter_id": 2342, "verse_number": "८-६३-२५", "content_sanskrit": "हताश्वात्तु ततो यानादवप्लुत्य महारथः।\nशक्तिं चिक्षेप कर्णाय सङ्क्रुद्धः शत्रुतापनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2063082, "chapter_id": 2342, "verse_number": "८-६३-२६", "content_sanskrit": "तां छित्त्वा समरे कर्णस्त्रिभिर्भारत सायकैः।\nशिखण्डिनमथाविध्यन्नवभिर्निशितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2063083, "chapter_id": 2342, "verse_number": "८-६३-२७", "content_sanskrit": "कर्णचापच्युतान्बाणान्वर्जयंस्तु नरोत्तमः।\nअपयातस्ततस्तूर्णं शिखण्डी भृशविक्षतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2063084, "chapter_id": 2342, "verse_number": "८-६३-२८", "content_sanskrit": "ततः कर्णो महाराज पाण्डुसैन्यान्यशातयत्।\nतूलराशिं समासाद्य यथा वायुर्महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2063085, "chapter_id": 2342, "verse_number": "८-६३-२९", "content_sanskrit": "धृष्टद्युम्नो महाराज तव पुत्रेण पीडितः।\nदुःशासनं त्रिभिर्बाणैः प्रत्यविध्यत्स्तनान्तरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2063086, "chapter_id": 2342, "verse_number": "८-६३-३०", "content_sanskrit": "तस्य दुःशासनो बाहुं सव्यं विव्याध मारिष।\nस तेन रुक्मपुङ्खेन भल्लेन नतपर्वणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2063087, "chapter_id": 2342, "verse_number": "८-६३-३१", "content_sanskrit": "धृष्टद्युम्नस्तु निर्विद्धः शरं घोरममर्षणः।\nदुःशासनाय सङ्क्रुद्धः प्रेषयामास भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2063088, "chapter_id": 2342, "verse_number": "८-६३-३२", "content_sanskrit": "आपतन्तं महावेगं धृष्टद्युम्नसमीरितम्।\nशरैश्चिच्छेद पुत्रस्ते त्रिभिरेव विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2063089, "chapter_id": 2342, "verse_number": "८-६३-३३", "content_sanskrit": "अथापरैः षोडशभिर्भल्लैः कनकभूषणैः।\nधृष्टद्युम्नं समासाद्य बाह्वोरुरसि चार्पयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2063090, "chapter_id": 2342, "verse_number": "८-६३-३४", "content_sanskrit": "ततः स पार्षतः क्रुद्धो धनुश्चिच्छेद मारिष।\nक्षुरप्रेण सुतीक्ष्णेन तत उच्चुक्रुशुर्जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2063091, "chapter_id": 2342, "verse_number": "८-६३-३५", "content_sanskrit": "अथान्यद्धनुरादाय पुत्रस्ते प्रहसन्निव।\nधृष्टद्युम्नं शरव्रातैः समन्तात्पर्यवारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2063092, "chapter_id": 2342, "verse_number": "८-६३-३६", "content_sanskrit": "तव पुत्रस्य ते दृष्ट्वा विक्रमं सुमहात्मनः।\nव्यस्मयन्त रणे योधाः सिद्धाश्चाप्सरसस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2063093, "chapter_id": 2342, "verse_number": "८-६३-३७", "content_sanskrit": "धृष्टद्युम्नं तु पश्याम घटमानं महाबलम्।\nदुःशासनेन संरुद्धं सिंहेनेव महागजम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2063094, "chapter_id": 2342, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि सप्तदशदिवसयुद्धे त्रिषष्टितमोऽध्यायः॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]