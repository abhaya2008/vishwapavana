[{"id": 50026100, "chapter_id": 12058, "verse_number": "1", "content_sanskrit": "स्वयं वेदपदारूढः पूर्ववर्णपुरःसरः। नत्यन्तोऽष्टाक्षरो मन्त्रः प्रियो विज्ञानगोपतेः॥ ४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50026101, "chapter_id": 12058, "verse_number": "2", "content_sanskrit": "व्याख्याश्रीसर्वविज्ञानकवितादिगुणप्रदः। वादे विजयदो नित्यं यथा युद्धे नृकेसरी॥ ४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50026102, "chapter_id": 12058, "verse_number": "3", "content_sanskrit": "विज्ञानरोचिःपरिपूरितान्तर्बाह्याण्डकोशं हरितोपलाभम्। तर्काभयेतं विधिशर्वपूर्वगीर्वाणविज्ञानदमानतोऽस्मि॥ ४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}]