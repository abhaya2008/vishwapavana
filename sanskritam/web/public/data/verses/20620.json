[{"id": 7000620000, "chapter_id": 20620, "verse_number": "५-७९-१", "content_sanskrit": "ईश्वर उवाच ।\nशालग्रामे मणौयंत्रे मंडले प्रतिमासु च ।\nनित्यं तु श्रीहरेः पूजा केवले भवनेन तु॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000620001, "chapter_id": 20620, "verse_number": "५-७९-२", "content_sanskrit": "गंडक्यामेकदेशे तु शालग्रामस्थलं महत् ।\nपाषाणं तद्भवं पातु शालग्राममिति स्थितम्॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000620002, "chapter_id": 20620, "verse_number": "५-७९-३", "content_sanskrit": "शालग्रामशिलास्पर्शात्कोटिजन्माघनाशनम् ।\nकिं पुनः पूजनं तत्र हरेः सांनिध्यकारणम्॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000620003, "chapter_id": 20620, "verse_number": "५-७९-४", "content_sanskrit": "शालग्रामैकयजनाच्छतलिंगीफलं लभेत् ।\nबहुभिर्जन्मभिः पुण्यैर्यदिकृष्णशिलां लभेत्॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000620004, "chapter_id": 20620, "verse_number": "५-७९-५", "content_sanskrit": "गोष्पदेन च चिह्नेन जनुस्तेन समाप्यते ।\nआदौ शिलां परीक्षेत स्निग्धां श्रेष्ठां च मेचकाम्॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000620005, "chapter_id": 20620, "verse_number": "५-७९-६", "content_sanskrit": "आकृष्णा मध्यमा प्रोक्ता मिश्रा मिश्रफलप्रदा ।\nसदा काष्ठे स्थितो वह्निर्मथनेन प्रकाश्यते॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000620006, "chapter_id": 20620, "verse_number": "५-७९-७", "content_sanskrit": "यथा तथा हरिर्व्यापी शालग्रामे प्रतीयते ।\nप्रत्यहं द्वादशशिलाः शालग्रामस्य योऽर्चयेत्॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000620007, "chapter_id": 20620, "verse_number": "५-७९-८", "content_sanskrit": "द्वारवत्याः शिलायुक्ताः स वैकुंठे महीयते ।\nशालग्रामशिलायां तु गह्वरं लक्षते नरः॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000620008, "chapter_id": 20620, "verse_number": "५-७९-९", "content_sanskrit": "पितरस्तस्य तिष्ठंति तृप्ताः कल्पांतकं दिवि ।\nवैकुंठभवनं तत्र यत्र द्वारावती शिला॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000620009, "chapter_id": 20620, "verse_number": "५-७९-१०", "content_sanskrit": "मृतो विष्णुपुरं याति तत्तीर्थं योजनत्रयम् ।\nजपः पूजा च होमश्च सर्वं कोटिगुणं भवेत्॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000620010, "chapter_id": 20620, "verse_number": "५-७९-११", "content_sanskrit": "मनस्कामसमाभीष्टं क्रोशमात्रं न संशयः ।\nकीटकोऽपि मृतिं याति वैकुंठभवनं यतः॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000620011, "chapter_id": 20620, "verse_number": "५-७९-१२", "content_sanskrit": "शालग्रामशिलायां यो मूल्यमुद्घाटयेन्नरः ।\nविक्रेता चानुमंता च यः परीक्षानुमोदकः॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000620012, "chapter_id": 20620, "verse_number": "५-७९-१३", "content_sanskrit": "सर्वे ते नरकं यांति यावत्सूर्यश्च संप्लवः ।\nअतस्तद्वर्जयेद्देवि चक्रक्रयणविक्रयम्॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000620013, "chapter_id": 20620, "verse_number": "५-७९-१४", "content_sanskrit": "शालग्रामोद्भवो देवो यो देवो द्वारकोद्भवः ।\nउभयोः संगमो यत्र मुक्तिस्तत्र न संशयः॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000620014, "chapter_id": 20620, "verse_number": "५-७९-१५", "content_sanskrit": "द्वारकोद्भवचक्राढ्यो बहुचक्रेण चिह्नितः ।\nचक्रासनशिलाकारचित्स्वरूपो निरंजनः॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000620015, "chapter_id": 20620, "verse_number": "५-७९-१६", "content_sanskrit": "नमोऽस्त्वोंकाररूपाय सदानंदस्वरूपिणे ।\nशालग्राममहाभाग भक्तस्यानुग्रहं कुरु॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000620016, "chapter_id": 20620, "verse_number": "५-७९-१७", "content_sanskrit": "तवानुग्रहकामस्य ऋणग्रस्तस्य मे प्रभो ।\nअतः परं प्रवक्ष्यामि तिलकस्य विधिं मुदा॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000620017, "chapter_id": 20620, "verse_number": "५-७९-१८", "content_sanskrit": "यच्छ्रुत्वा मानवाः सर्वे विष्णुसारूप्यमाप्नुयुः ।\nललाटे केशवं विद्यात्कंठे श्रीपुरुषोत्तमम्॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000620018, "chapter_id": 20620, "verse_number": "५-७९-१९", "content_sanskrit": "नाभौ नारायणं देवं वैकुंठं हृदये तथा ।\nदामोदरं वामपार्श्वे दक्षिणे च त्रिविक्रमम्॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000620019, "chapter_id": 20620, "verse_number": "५-७९-२०", "content_sanskrit": "मूर्ध्नि चैव हृषीकेशं पद्मनाभं च पृष्ठतः ।\nकर्णयोर्यमुनां गंगां बाह्वोः कृष्णं हरिं तथा॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000620020, "chapter_id": 20620, "verse_number": "५-७९-२१", "content_sanskrit": "यथास्थानेषु तुष्यंति देवता द्वादश स्मृताः ।\nद्वादशैतानि नामानि कर्तव्ये तिलके पठेत्॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000620021, "chapter_id": 20620, "verse_number": "५-७९-२२", "content_sanskrit": "सर्वपापविशुद्धात्मा विष्णुलोकं स गच्छति ।\nऊर्द्ध्वपुंड्रमूर्द्ध्वरेखं ललाटे यस्य दृश्यते॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000620022, "chapter_id": 20620, "verse_number": "५-७९-२३", "content_sanskrit": "चांडालोऽपि स शुद्धात्मा पूज्य एव न संशयः ।\nयस्योर्द्ध्वपुंड्रं दृश्येत न ललाटे नरस्य हि॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000620023, "chapter_id": 20620, "verse_number": "५-७९-२४", "content_sanskrit": "तद्दर्शनं न कर्त्तव्यं दृष्ट्वा सूर्यं निरीक्षयेत् ।\nत्रिपुंड्रं यस्य विप्रस्य ऊर्द्ध्वपुंड्रं न दृश्यते॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000620024, "chapter_id": 20620, "verse_number": "५-७९-२५", "content_sanskrit": "तं दृष्ट्वाप्यथवा स्पृष्ट्वा सचैलं स्नानमाचरेत् ।\nसांतरालं प्रकर्त्तव्यं पुंड्रं हरिपदाकृति॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000620025, "chapter_id": 20620, "verse_number": "५-७९-२६", "content_sanskrit": "निरंतरालं यः कुर्यादूर्द्ध्वपुंड्रं द्विजाधमः ।\nललाटे तस्य सततं शुनःपादो न संशयः॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000620026, "chapter_id": 20620, "verse_number": "५-७९-२७", "content_sanskrit": "नासादिकेशपर्यंतमूर्द्ध्वपुंड्रं सुशोभनम् ।\nमध्ये छिद्रसमायुक्तं तं विद्याद्धरिमंदिरम्॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000620027, "chapter_id": 20620, "verse_number": "५-७९-२८", "content_sanskrit": "वामभागे स्थितो ब्रह्मा दक्षिणे तु सदाशिवः ।\nमध्ये विष्णुं विजानीयात्तस्मान्मध्यं न लेपयेत्॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000620028, "chapter_id": 20620, "verse_number": "५-७९-२९", "content_sanskrit": "वीक्ष्यादर्शे जले वापि यो विदध्यात्प्रयत्नतः ।\nऊर्द्ध्वपुंड्रं महाभागः सयाति परमां गतिम्॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000620029, "chapter_id": 20620, "verse_number": "५-७९-३०", "content_sanskrit": "अग्निरापश्च वेदाश्च चंद्रादित्यौ तथानिलः ।\nविप्राणां नित्यमेते हि कर्णे तिष्ठंति दक्षिणे॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000620030, "chapter_id": 20620, "verse_number": "५-७९-३१", "content_sanskrit": "गंगा च दक्षिणे श्रोत्रे नासिकायां हुताशनः ।\nउभयोरपि संस्पर्शात्तत्क्षणादेव शुध्यति॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000620031, "chapter_id": 20620, "verse_number": "५-७९-३२", "content_sanskrit": "कृत्वा चैवोदकं शंखे वैष्णवानां महात्मनाम् ।\nतुलसीमिश्रितं दद्यात्पिबेन्मूर्ध्नाभिवंदयेत्॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000620032, "chapter_id": 20620, "verse_number": "५-७९-३३", "content_sanskrit": "प्राश्नीयात्प्रोक्षयेद्देहं पुत्रमित्रपरिग्रहम् ।\nविष्णोः पादोदकं पीतं कोटिजन्माघनाशनम्॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000620033, "chapter_id": 20620, "verse_number": "५-७९-३४", "content_sanskrit": "तदेवाष्टगुणं पापं भूमौ बिंदुनिपातनात् ।\nजलशंखं करे कृत्वा स्तुत्वा नत्वा प्रदक्षिणम्॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000620034, "chapter_id": 20620, "verse_number": "५-७९-३५", "content_sanskrit": "सततं धार्यते वारि तेनाप्तं जन्मनः फलम् ।\nशंखो यस्य गृहे नास्ति घंटा वा गरुडान्विता॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000620035, "chapter_id": 20620, "verse_number": "५-७९-३६", "content_sanskrit": "पुरतो वासुदेवस्य न स भागवतः कलौ ।\nयानैर्वा पादुकाभिर्वा यानं भगवतो गृहे॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000620036, "chapter_id": 20620, "verse_number": "५-७९-३७", "content_sanskrit": "देवोत्सवेष्वसेवा च अप्रणामस्तदग्रतः ।\nउच्छिष्टे चैव चाशौचे भगवद्वंदनादिकम्॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000620037, "chapter_id": 20620, "verse_number": "५-७९-३८", "content_sanskrit": "एकहस्तप्रणामश्च तत्पुरस्तात्प्रदक्षिणम् ।\nपादप्रसारणं चाग्रे तथा पर्यंकसेवनम्॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000620038, "chapter_id": 20620, "verse_number": "५-७९-३९", "content_sanskrit": "शयनं भक्षणं चापि मिथ्याभाषणमेव च ।\nउच्चैर्भाषामिथो जल्पो रोदनानि च विग्रहः॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000620039, "chapter_id": 20620, "verse_number": "५-७९-४०", "content_sanskrit": "निग्रहानुग्रहौ चैव स्त्रीषु च क्रूरभाषणम् ।\nकेवलावरणं चैव परनिंदापरस्तुतिः॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000620040, "chapter_id": 20620, "verse_number": "५-७९-४१", "content_sanskrit": "अश्लीलभाषणं चैव अधोवायुविमोक्षणम् ।\nशक्तौ गौणोपचारश्च अनिवेदितभक्षणम्॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000620041, "chapter_id": 20620, "verse_number": "५-७९-४२", "content_sanskrit": "तत्तत्कालोद्भवानां च फलादीनामनर्पणम् ।\nविनियुक्तावशिष्टस्य प्रदानं व्यंजनस्य यत्॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000620042, "chapter_id": 20620, "verse_number": "५-७९-४३", "content_sanskrit": "स्पष्टीकृत्याशनं चैव परनिंदा परस्तुतिः ।\nगुरौ मौनं निजस्तोत्रं देवतानिंदनं तथा॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000620043, "chapter_id": 20620, "verse_number": "५-७९-४४", "content_sanskrit": "अपराधास्तथा विष्णोर्द्वात्रिंशत्परिकीर्तिताः॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000620044, "chapter_id": 20620, "verse_number": "५-७९-४५", "content_sanskrit": "अपराधसहस्राणि क्रियंतेऽहर्निशं मया ।\nतवाहमिति मां मत्वा क्षमस्व मधुसूदन॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000620045, "chapter_id": 20620, "verse_number": "५-७९-४६", "content_sanskrit": "इति मंत्रं समुच्चार्य प्रणमेद्दंडवद्भुवि ।\nअपराधसहस्राणि क्षमते सर्वदा हरिः॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000620046, "chapter_id": 20620, "verse_number": "५-७९-४७", "content_sanskrit": "सायंप्रातर्द्विजातीनां श्रुत्युक्तमशनं तथा ।\nविष्णुभक्तावशिष्टस्य दिनपापात्प्रमुच्यते॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000620047, "chapter_id": 20620, "verse_number": "५-७९-४८", "content_sanskrit": "अन्नं ब्रह्मा रसो विष्णुः खादयेन्मांसमुच्चरन् ।\nएवं ज्ञात्वा तु यो भुंक्ते सोऽन्नदोषैर्न लिप्यते॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000620048, "chapter_id": 20620, "verse_number": "५-७९-४९", "content_sanskrit": "अलाबुं वर्त्तुलाकारं मसूरं च सवल्कलम् ।\nतालं शुक्लं च वृंताकं न खादेद्वैष्णवो नरः॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000620049, "chapter_id": 20620, "verse_number": "५-७९-५०", "content_sanskrit": "वटाश्वत्थार्कपत्रेषु कुंभी तिंदुकपत्रयोः ।\nकोविदारे कदंबे च न खादेद्वैष्णवो नरः॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000620050, "chapter_id": 20620, "verse_number": "५-७९-५१", "content_sanskrit": "श्रावणे वर्जयेच्छाकं दधि भाद्रपदे त्यजेत् ।\nआश्विने मासि दुग्धं च कार्त्तिके चामिषं त्यजेत्॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000620051, "chapter_id": 20620, "verse_number": "५-७९-५२", "content_sanskrit": "दग्धमन्नं तु जंबीरं यद्विष्णोरनिवेदितम् ।\nबीजपूरं च शाकं चप्रत्यक्षलवणं तथा॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000620052, "chapter_id": 20620, "verse_number": "५-७९-५३", "content_sanskrit": "यदि दैवाच्च भुंजीत तदा तन्नाम संस्मरेत् ।\nहैमंतिकं सिता स्विन्नं धान्यं मुद्गास्तिला यवाः॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000620053, "chapter_id": 20620, "verse_number": "५-७९-५४", "content_sanskrit": "कलाप कंगु नीवाराः शाकं च हिलमोचिका ।\nकालशाकं च वास्तूकं मूलकं रक्तकेतरत्॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000620054, "chapter_id": 20620, "verse_number": "५-७९-५५", "content_sanskrit": "लवणे सिंधुसामुद्रे गव्ये च दधिसर्पिषी ।\nपयोनुद्धृतसारं च पनसाम्रहरीतकी॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000620055, "chapter_id": 20620, "verse_number": "५-७९-५६", "content_sanskrit": "पिप्पली जीरकं चैव नागरंगक तिंतिडी ।\nकदलीलवली धात्री फलान्यगुडमैक्षवम्॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000620056, "chapter_id": 20620, "verse_number": "५-७९-५७", "content_sanskrit": "अतैलपक्वं मुनयो हविष्यान्नं प्रचक्षते ।\nतुलसीपत्रपुष्पाद्यैर्माल्यं वहति यो नरः॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000620057, "chapter_id": 20620, "verse_number": "५-७९-५८", "content_sanskrit": "विष्णुं तमपि जानीयात्सत्यं सत्यं न संशयः ।\nधात्रीवृक्षं समारोप्य विष्णुतुल्यो भवेन्नरः॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000620058, "chapter_id": 20620, "verse_number": "५-७९-५९", "content_sanskrit": "कुरुक्षेत्रं विजानीयात्सार्द्धं हस्तशतत्रयम् ।\nतुलसीकाष्ठघटितै रुद्राक्षाकारकारितैः॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000620059, "chapter_id": 20620, "verse_number": "५-७९-६०", "content_sanskrit": "निर्मितां मालिकां कंठे निधायार्चनमारभेत् ।\nतथामलकमालां च सम्यक्पुष्करमालिकाम्॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000620060, "chapter_id": 20620, "verse_number": "५-७९-६१", "content_sanskrit": "कंठे मालां च यत्नेन धारयेद्विष्णुपूजकः ।\nनिर्माल्यं तुलसीमालां शिरस्यपि च धारयेत्॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000620061, "chapter_id": 20620, "verse_number": "५-७९-६२", "content_sanskrit": "निर्माल्यचंदनेनांगमंकयेत्तस्य नामभिः ।\nललाटे च गदा धार्या मूर्ध्नि चापं शरस्तथा॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000620062, "chapter_id": 20620, "verse_number": "५-७९-६३", "content_sanskrit": "नंदकं चैव हृन्मध्ये शंखं चक्रं भुजद्वये ।\nशंखचक्रान्वितो विप्रः श्मशाने म्रियते यदि॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000620063, "chapter_id": 20620, "verse_number": "५-७९-६४", "content_sanskrit": "प्रयागे या गतिः प्रोक्ता सा गतिस्तस्य निश्चिता ।\nयो धृत्वा तुलसीपत्रं शिरसा विष्णुतत्परः॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000620064, "chapter_id": 20620, "verse_number": "५-७९-६५", "content_sanskrit": "करोति सर्वकार्याणि फलमाप्नोति चाक्षयम् ।\nतुलसीकाष्ठमालाभिर्भूषितः कर्म आचरन्॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000620065, "chapter_id": 20620, "verse_number": "५-७९-६६", "content_sanskrit": "पितॄणां देवतानां च कृतं कोटिगुणं भवेत् ।\nनिवेद्य केशवे मालां तुलसीकाष्ठनिर्मिताम्॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000620066, "chapter_id": 20620, "verse_number": "५-७९-६७", "content_sanskrit": "वहते यो नरो भक्त्या तस्य नश्यति पातकम् ।\nपाद्यादिभिरथाभ्यर्च्य इमं मंत्रमुदीरयेत्॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000620067, "chapter_id": 20620, "verse_number": "५-७९-६८", "content_sanskrit": "या दृष्टा निखिलाघसंघशमनी स्पृष्टा वपुः पावनी ।\nरोगाणामभिवंदिता निरसनी सिक्तांतकत्रासिनी ।\nप्रत्यासत्ति विधायिनी भगवतः कृष्णस्य संरोपिता ।\nन्यस्ता तच्चरणे विमुक्तिफलदा तस्यै तुलस्यै नमः॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}]