[{"id": 6000225000, "chapter_id": 10225, "verse_number": null, "content_sanskrit": "अथ एकोनत्रिंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000225001, "chapter_id": 10225, "verse_number": null, "content_sanskrit": "गोप्य ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_029/BhP_10.029.001.m4a", "display_order": 2}, {"id": 6000225002, "chapter_id": 10225, "verse_number": "१०-२९-१", "content_sanskrit": "जयति तेऽधिकं जन्मना व्रजः श्रयत इन्दिरा साधु तत्र हि।\nदयित दृश्यतां त्वां दिदृक्षतां त्वयि गतासवस्त्वां विचिन्वते॥ १०/२९/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_029/BhP_10.029.002.m4a", "display_order": 3, "topics": [{"text": "गोपीगीतम्", "range": "१–१८"}]}, {"id": 6000225003, "chapter_id": 10225, "verse_number": "१०-२९-२", "content_sanskrit": "व्रजजनार्तिहन् वीर योषितां निजजनस्मयध्वंसनस्मित।\nभज सखे भवे किङ्करीः स्म नो जलरुहाननं चारु दर्शयन्॥ १०/२९/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_029/BhP_10.029.003.m4a", "display_order": 4}, {"id": 6000225004, "chapter_id": 10225, "verse_number": "१०-२९-३", "content_sanskrit": "शरदुदाशये साधुजातसत्सरसिजोदरश्रीमुषा दृशा।\nसुरतनाथ तेऽशुल्कदासिका वरद निघ्नतो नेह किं वधः॥ १०/२९/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_029/BhP_10.029.004.m4a", "display_order": 5}, {"id": 6000225005, "chapter_id": 10225, "verse_number": "१०-२९-४", "content_sanskrit": "विषजलाशयाद् व्यालराक्षसाद् वर्षमारुताद् वैद्युतानलात्।\nवृषमयाद् भयाद् विश्वतोमुखाद् वृषभ ते वयं रक्षिता मुहुः॥ १०/२९/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_029/BhP_10.029.005.m4a", "display_order": 6}, {"id": 6000225006, "chapter_id": 10225, "verse_number": "१०-२९-५", "content_sanskrit": "स खलु गोपिकानन्दनो भवानखिलदेहिनामन्तरात्मदृक्।\nविखनसार्चितो विश्वगुप्तये सख उदेयिवान् सात्वतां कुले॥ १०/२९/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_029/BhP_10.029.006.m4a", "display_order": 7}, {"id": 6000225007, "chapter_id": 10225, "verse_number": "१०-२९-६", "content_sanskrit": "विरचिताभयं वृष्णिवर्य ते शरणमीयुषां संसृतेर्भयात्।\nकरसरोरुहं कान्त कामदं शिरसि धेहि नः श्रीकरग्रहम्॥ १०/२९/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_029/BhP_10.029.007.m4a", "display_order": 8}, {"id": 6000225008, "chapter_id": 10225, "verse_number": "१०-२९-७", "content_sanskrit": "प्रणतदेहिनां पापकर्शनं तृणचरानुगं श्रीनिकेतनम्।\nफणिफणार्पितं ते पदाम्बुजं कृणु कुचेषु नः कृन्धि हृच्छयम्॥ १०/२९/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_029/BhP_10.029.008.m4a", "display_order": 9}, {"id": 6000225009, "chapter_id": 10225, "verse_number": "१०-२९-८", "content_sanskrit": "मधुरया गिरा वल्गुवाक्यया बुधमनोज्ञया पुष्करेक्षण।\nविधिकरीरिमा वीर मुह्यती रधरसीधुनाऽऽप्याययस्व नः॥ १०/२९/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_029/BhP_10.029.009.m4a", "display_order": 10}, {"id": 6000225010, "chapter_id": 10225, "verse_number": "१०-२९-९", "content_sanskrit": "तव कथामृतं तप्तजीवनं कविभिरीडितं कल्मषापहम्।\nश्रवणमङ्गलं श्रीमदाततं भुवि गृणन्ति ते भूरिदा जनाः॥ १०/२९/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_029/BhP_10.029.010.m4a", "display_order": 11}, {"id": 6000225011, "chapter_id": 10225, "verse_number": "१०-२९-१०", "content_sanskrit": "प्रहसितं प्रिय प्रेमवीक्षणं विहरणं च ते ध्यानमङ्गलम्।\nरहसि संविदो या हृदिस्पृशः कुहक नो मनः क्षोभयन्ति हि॥ १०/२९/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_029/BhP_10.029.011.m4a", "display_order": 12}, {"id": 6000225012, "chapter_id": 10225, "verse_number": "१०-२९-११", "content_sanskrit": "चलसि यद् व्रजाच्चारयन् पशून् नलिनसुन्दरं नाथ ते पदम्।\nशिलतृणाङ्कुरैः सीदतीति नः कलिलतां मनः कान्त गच्छति॥ १०/२९/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_029/BhP_10.029.012.m4a", "display_order": 13}, {"id": 6000225013, "chapter_id": 10225, "verse_number": "१०-२९-१२", "content_sanskrit": "दिनपरिक्षये नीलकुन्तलैर्वनरुहाननं बिभ्रदावृतम्।\nवनरजस्वलं दर्शयन् मुहुर्मनसि नः स्मरं वीर यच्छसि॥ १०/२९/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_029/BhP_10.029.013.m4a", "display_order": 14}, {"id": 6000225014, "chapter_id": 10225, "verse_number": "१०-२९-१३", "content_sanskrit": "प्रणतकामदं पद्मजार्चितं धरणिमण्डनं ध्येयमापदि।\nचरणपङ्कजं शन्तमं च ते रमण नः स्तनेष्वर्पयाधिहन्॥ १०/२९/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_029/BhP_10.029.014.m4a", "display_order": 15}, {"id": 6000225015, "chapter_id": 10225, "verse_number": "१०-२९-१४", "content_sanskrit": "सुरतवर्धनं शोकनाशनं स्वरितवेणुना सुष्ठु चुम्बितम्।\nइतररागविस्मारणं नृणां वितर वीर नस्तेऽधरामृतम्॥ १०/२९/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_029/BhP_10.029.015.m4a", "display_order": 16}, {"id": 6000225016, "chapter_id": 10225, "verse_number": "१०-२९-१५", "content_sanskrit": "अटति यद् भवानह्नि काननं त्रुटि युगायते त्वामपश्यताम्।\nकुटिलकुन्तलं श्रीमुखं च ते जडवदीक्षतां पक्ष्मनुद्दृशाम्॥ १०/२९/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_029/BhP_10.029.016.m4a", "display_order": 17}, {"id": 6000225017, "chapter_id": 10225, "verse_number": "१०-२९-१६", "content_sanskrit": "पतिसुतान्वयभ्रातृबान्धवानतिविलङ्घ्य ते ह्यच्युतागताः।\nगतिविदस्तवोद्गीतमोहिताः कितव योषितः कस्त्यजेन्निशि॥ १०/२९/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_029/BhP_10.029.017.m4a", "display_order": 18}, {"id": 6000225018, "chapter_id": 10225, "verse_number": "१०-२९-१७", "content_sanskrit": "रहसि संविदं हृच्छयोदयं प्रहसिताननं प्रेमवीक्षणम्।\nबृहदुरःश्रियो वीर वीक्ष्य ते मुहुरतिस्पृहा मुह्यते मनः॥ १०/२९/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_029/BhP_10.029.018.m4a", "display_order": 19}, {"id": 6000225019, "chapter_id": 10225, "verse_number": "१०-२९-१८", "content_sanskrit": "व्रजवनौकसां व्यक्तिरङ्ग ते वृजिनहन्त्र्यलं विश्वमङ्गलम्।\nभज मनाक् च नस्त्वत्स्पृहात्मनां स्वजनहृद्रुजां यन्निषूदनम्॥ १०/२९/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_029/BhP_10.029.019.m4a", "display_order": 20}, {"id": 6000225020, "chapter_id": 10225, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्धपूर्वार्धे एकोनत्रिंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]