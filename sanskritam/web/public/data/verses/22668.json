[{"id": 7002668000, "chapter_id": 22668, "verse_number": "७-११-१", "content_sanskrit": "सूत उवाच ।\nदशाब्दे च वयः प्राप्ते विष्णोः शक्त्यवतारके ।\nवसंतसमये रम्ये ययुस्ते प्रमदावनम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002668001, "chapter_id": 22668, "verse_number": "७-११-२", "content_sanskrit": "ऊषुस्तत्र व्रताचारे माधवे कृष्णवल्लभे ।\nस्नात्वा च सागरे प्रातः पूजयामासुरंबिकाम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002668002, "chapter_id": 22668, "verse_number": "७-११-३", "content_sanskrit": "ऋतुकालोद्भवैः पुष्पैर्धूपैर्दीपैर्विधानतः ।\nजप्त्वा सप्तशतीस्तोत्रं दध्युः सर्वकरीं शिवाम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002668003, "chapter_id": 22668, "verse_number": "७-११-४", "content_sanskrit": "कंदमूलफलाहारा जीवहिंसाविवर्जिताः ।\nतेषां भक्तिं समालोक्य मासांते जगदंबिका ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002668004, "chapter_id": 22668, "verse_number": "७-११-५", "content_sanskrit": "ददौ तेभ्यो वरं रम्यं तच्छृणुध्वं समाहिताः ।\nआह्लादाय सुरत्वं च बलत्वं बलखानये ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002668005, "chapter_id": 22668, "verse_number": "७-११-६", "content_sanskrit": "कालज्ञत्वं च देवाय ब्रह्मज्ञत्वं नृपाय च  ।\nकृष्णांशायैव योगत्वं दत्त्वा चांतर्दधे शिवा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002668006, "chapter_id": 22668, "verse_number": "७-११-७", "content_sanskrit": "कृतकृत्यास्तदा ते वै स्वगेहं पुनराययुः ।\nतेषां प्राप्ते वरे रम्ये मलना पुत्रमूर्जितम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002668007, "chapter_id": 22668, "verse_number": "७-११-८", "content_sanskrit": "श्यामांगं सात्यकेरंशं सुषुवे शुभलक्षणम् ।\nस ज्ञेयो रणजिच्छूरो राजन्यप्रियकारकः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002668008, "chapter_id": 22668, "verse_number": "७-११-९", "content_sanskrit": "आषाढे मासि संप्राप्ते कृष्णांशो हयवाहनः ।\nउर्वीयां नगरीं प्राप्त एकाकी निर्भयो वली ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002668009, "chapter_id": 22668, "verse_number": "७-११-१०", "content_sanskrit": "दृष्ट्वा स नगरीं रम्यां चतुर्वर्णनिषेविताम् ।\nद्विजशालां ययौ शूरो द्विजधेनुप्रपूजकः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002668010, "chapter_id": 22668, "verse_number": "७-११-११", "content_sanskrit": "दत्त्वा स्वर्णं द्विजातिभ्यः संतर्प्य द्विजदेवताः ।\nमहीपतिगृहं रम्यं जगाम बलवत्तरः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002668011, "chapter_id": 22668, "verse_number": "७-११-१२", "content_sanskrit": "नत्वा स मातुलं धीमांस्तथान्यांश्च सभासदः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002668012, "chapter_id": 22668, "verse_number": "७-११-१३", "content_sanskrit": "तदा नृपाज्ञया शूरा बंधनाय समुद्यताः ।\nखङ्गहस्ताः समाजग्मुर्यथा सिंहं गजाः शशाः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002668013, "chapter_id": 22668, "verse_number": "७-११-१४", "content_sanskrit": "मोहितं तं नृपं कृत्वा दुष्टबुद्धिर्महीपतिः ।\nकृत्वा लोहमयं जालं तस्योपरि समादधेः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002668014, "chapter_id": 22668, "verse_number": "७-११-१५", "content_sanskrit": "एतस्मिन्नंतरे वीरो बोधितो देवमायया ।\nआगस्कृतान्रिपूञ्ज्ञात्वा खङ्गहस्तः समावधीत् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002668015, "chapter_id": 22668, "verse_number": "७-११-१६", "content_sanskrit": "हत्वा पंचशतं शूरो हयारूढो महाबली ।\nउर्वीयां नगरीं प्राप्य जलपाने मनो दधौ ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002668016, "chapter_id": 22668, "verse_number": "७-११-१७", "content_sanskrit": "कूपे दृष्ट्वा शुभा नार्यो घटपूर्तिकरीस्तदा ।\nउवाच मधुरो वाक्यं देहि सुंदरि मे जलम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002668017, "chapter_id": 22668, "verse_number": "७-११-१८", "content_sanskrit": "दृष्ट्वा ताः सुंदरं रूपं मोहनायोपचक्रिरे ।\nभित्त्वा तासां तु वै कुम्भान्पाययित्वा हयं जलम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002668018, "chapter_id": 22668, "verse_number": "७-११-१९", "content_sanskrit": "वनं गत्वा रिपुं जित्वा बद्ध्वा तमुभयं बली ।\nचण्डिकापार्श्वमागम्य तद्वधाय मनो दधे ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002668019, "chapter_id": 22668, "verse_number": "७-११-२०", "content_sanskrit": "श्रुत्वा स करुणं वाक्यं त्यक्त्वा स्वनगरं ययौ ।\nनृपांतिकमुपागम्य वर्णयामास कारणम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002668020, "chapter_id": 22668, "verse_number": "७-११-२१", "content_sanskrit": "श्रुत्वा परिमलो राजा द्विजातिभ्यो ददौ धनम् ।\nसमाघ्राय स कृष्णांशं कृतकृत्योऽभवन्नृपः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002668021, "chapter_id": 22668, "verse_number": "७-११-२२", "content_sanskrit": "संप्राप्तैकादशदाब्दे तु कृष्णांशे युद्धदुर्मदे ।\nमहीपतिर्निरुत्साहः प्रययौ देहलीं प्रति ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002668022, "chapter_id": 22668, "verse_number": "७-११-२३", "content_sanskrit": "बलिं यथोचितं दत्त्वा भगिन्यै भयकातरः ।\nरुरोद वहुधा दुःखं देशराजात्मजप्रजम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002668023, "chapter_id": 22668, "verse_number": "७-११-२४", "content_sanskrit": "अगमा भगिनी तस्य दृष्ट्वा भ्रातरमातुरम् ।\nस्वपतिं वर्णयामास श्रुत्वा राजाब्रवीदिदम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002668024, "chapter_id": 22668, "verse_number": "७-११-२५", "content_sanskrit": "अद्याहं स्वबलैः सार्द्धं गत्वा तत्र महावतीम् ।\nहनिष्यामि महादुष्टं देशराजसुतं रिपुम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002668025, "chapter_id": 22668, "verse_number": "७-११-२६", "content_sanskrit": "इत्युक्त्वा धुंधुकारं च समाहूय महाबलम् ।\nसैन्यमाज्ञापयामास सप्तलक्षं तनुत्यजम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002668026, "chapter_id": 22668, "verse_number": "७-११-२७", "content_sanskrit": "केचिच्छूरा हयारूढा उष्ट्रारूढा महाबलाः ।\nगजारूढा रथारूढाः संययुश्च पदातयः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002668027, "chapter_id": 22668, "verse_number": "७-११-२८", "content_sanskrit": "देवसिंहस्तु कालज्ञः श्रुत्वा चागमनं रिपोः ।\nनृपपार्श्वं समागम्य सर्वं राज्ञे न्यवेदयत् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002668028, "chapter_id": 22668, "verse_number": "७-११-२९", "content_sanskrit": "श्रुत्वा परिमलो राजा विह्वलोऽभूद्भयातुरः ।\nबलखानिस्तमुत्थाय हर्षयुक्त इवाह च ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002668029, "chapter_id": 22668, "verse_number": "७-११-३०", "content_sanskrit": "अद्याहं च महीराजं धुंधुकारं ससैन्यकम् ।\nजित्वा दंड्यं च भवतः करिष्यामि तवाज्ञया ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002668030, "chapter_id": 22668, "verse_number": "७-११-३१", "content_sanskrit": "इत्युक्त्वा तं नमस्कृत्य सेनापतिरभून्मुने ।\nतदा तु निर्भया वीरा दृष्ट्वा राजानमातुरम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002668031, "chapter_id": 22668, "verse_number": "७-११-३२", "content_sanskrit": "चतुर्लक्षबलैः सार्द्धं ते युद्धाय समाययुः ।\nशिंशपाख्यं वनं घोरं छेदयित्वा रिपोस्तदा ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002668032, "chapter_id": 22668, "verse_number": "७-११-३३", "content_sanskrit": "ऊषुस्तत्र रणे मत्ताः सर्वशत्रुभयंकराः ।\nएतस्मिन्नन्तरे तत्र धुंधुकारादयो बला ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002668033, "chapter_id": 22668, "verse_number": "७-११-३४", "content_sanskrit": "कृत्वा कोलाहलं शब्दं युद्धाय समुपाययुः ।\nपूर्वाह्णे तु भृगुश्रेष्ठ सन्नद्धास्ते शतघ्निपाः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002668034, "chapter_id": 22668, "verse_number": "७-११-३५", "content_sanskrit": "शतघ्नीभिस्त्रिसाहस्रैः पञ्चसाहस्रका ययुः ।\nद्विसहस्रशतघ्नीभिः सहिता श्चन्द्रवंशिनः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002668035, "chapter_id": 22668, "verse_number": "७-११-३६", "content_sanskrit": "सैन्यं षष्टिसहस्रं च स्वगर्लोकमुपाययौ ।\nतदर्द्धं च तथा सैन्यं महीराजस्य संक्षितम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002668036, "chapter_id": 22668, "verse_number": "७-११-३७", "content_sanskrit": "दुद्रुवुर्भीरुकाः शूरा वलखानेर्दिशो दश ।\nरथा रथै रणे हन्युर्गजाश्चैव गजैस्तथा ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002668037, "chapter_id": 22668, "verse_number": "७-११-३८", "content_sanskrit": "हया हयैस्तथा उष्ट्रा उष्ट्रपैश्च समाहनन् ।\nएवं सुतुमुले जाते दारुणे रोम हर्षणे ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002668038, "chapter_id": 22668, "verse_number": "७-११-३९", "content_sanskrit": "हाहाभूतान्स्वकीयांश्च सैन्यान्दृष्ट्वा महाबलान् ।\nअपराह्णे भृगुश्रेष्ठ पञ्च शूराः समाययुः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002668039, "chapter_id": 22668, "verse_number": "७-११-४०", "content_sanskrit": "ब्रह्मानंदः शरैः शत्रूननयद्यमसादनम् ।\nदेवसिंहस्तथा भल्लैराह्रादस्तत्र तोमरैः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002668040, "chapter_id": 22668, "verse_number": "७-११-४१", "content_sanskrit": "बलखानिः स्वखड्गेन कृष्णांशस्तु तथैव च ।\nद्विलक्षान्क्षत्रियाञ्जघ्नुः सर्वसैन्यैः समं ततः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002668041, "chapter_id": 22668, "verse_number": "७-११-४२", "content_sanskrit": "दृष्ट्वा पराजितं सैन्यं धुंधुकारो महाबलः ।\nआह्लादं च स्वभल्लेन गजारूढः समावधीत् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002668042, "chapter_id": 22668, "verse_number": "७-११-४३", "content_sanskrit": "आह्लादे मूर्च्छिते तत्र देवसिंहो महाबलः ।\nभल्लेन भ्रातरं तस्य दंशयामास वेगतः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002668043, "chapter_id": 22668, "verse_number": "७-११-४४", "content_sanskrit": "स तीक्ष्णव्रणमासाद्य गजस्थः संमुमोह वै ।\nआगताः शतराजानो नानादेश्या महाबलाः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002668044, "chapter_id": 22668, "verse_number": "७-११-४५", "content_sanskrit": "शस्त्राण्यस्त्राणि तेषां तु छित्त्वा खङ्गेन वत्सजः ।\nस्वखड्गेन शिरांस्येषां पातयामास भूतले ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002668045, "chapter_id": 22668, "verse_number": "७-११-४६", "content_sanskrit": "हते शत्रुसमूहे तु तच्छेषास्तु प्रदुद्रुवुः ।\nमहीराजस्तु बलवान्दृष्ट्वा भग्नं स्वसैन्यकम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002668046, "chapter_id": 22668, "verse_number": "७-११-४७", "content_sanskrit": "आजगाम गजारूढः शिवदत्तवरो बली ।\nरौद्रेणास्त्रेण हृदये चावधीद्वत्सजं रिपुम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002668047, "chapter_id": 22668, "verse_number": "७-११-४८", "content_sanskrit": "आह्लादं च तथा वीरं देवं परिमलात्मजम् ।\nमूर्च्छयित्वा महावीराञ्छत्रुसैन्यमुपागमत् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002668048, "chapter_id": 22668, "verse_number": "७-११-४९", "content_sanskrit": "पूजयित्वा शतघ्नीश्च महावधमकारयत् ।\nरोपणस्त्वरितो गत्वा राज्ञे सर्वमवर्णयत् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002668049, "chapter_id": 22668, "verse_number": "७-११-५०", "content_sanskrit": "एतस्मिन्नंतरे वीरः सुखखानिर्महाबलः ।\nकपोतं हयमारुह्य नभोमार्गेण चागमत् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7002668050, "chapter_id": 22668, "verse_number": "७-११-५१", "content_sanskrit": "मूर्च्छयित्वा महीराजं स्वबंधूंश्च सवाहनान् ।\nकृत्वा नृपांतमागम्य बंधनाय समुद्यतः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7002668051, "chapter_id": 22668, "verse_number": "७-११-५२", "content_sanskrit": "तदोत्थाय महीराजो महादेवेन बोधितः ।\nपुनस्तान्स्वशरै रौद्रैर्मूर्च्छयामास कोपवान् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7002668052, "chapter_id": 22668, "verse_number": "७-११-५३", "content_sanskrit": "सुखखान्यादिकाञ्छूरान्संबध्य निगडैर्दृढैः ।\nनृपं परिमलं प्राप्य पुनर्युद्धमचीकरत् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7002668053, "chapter_id": 22668, "verse_number": "७-११-५४", "content_sanskrit": "हाहाभूतं स्वसैन्यं च दृष्ट्वा स उदयो हरिः ।\nनभोमार्गे हयं कृत्वा ताः शतध्नीरनाशयत् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7002668054, "chapter_id": 22668, "verse_number": "७-११-५५", "content_sanskrit": "महीराजगजं प्राप्य बद्ध्वा तं निगडैर्बलो ।\nआह्लादपार्श्वमागम्य भ्रात्रे भूपं समर्पयत् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7002668055, "chapter_id": 22668, "verse_number": "७-११-५६", "content_sanskrit": "तदा तु पृथिवीराजो लज्जितस्तेन निर्जितः ।\nपञ्चकोटिधनं दत्त्वा स्वगेहं पुनराययौ ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7002668056, "chapter_id": 22668, "verse_number": "७-११-५७", "content_sanskrit": "देवसिंहाज्ञया शूरो बलखानिर्हि वत्सजः ।\nतैर्द्रव्यैर्नगरीं रम्यां कारयामास सुन्दरीम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7002668057, "chapter_id": 22668, "verse_number": "७-११-५८", "content_sanskrit": "शिरीषाख्यं पुरं नाम तेन वीरेण वै कृतम् ।\nसर्ववर्णसमायुक्तं द्विक्रोशायामसंमितम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7002668058, "chapter_id": 22668, "verse_number": "७-११-५९", "content_sanskrit": "तत्रैव न्यवसद्वीरो वत्सजः स्वकुलैः सह ।\nत्रिंशत्कोशे कृतं राष्ट्रं तत्रैव बलखानिना ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7002668059, "chapter_id": 22668, "verse_number": "७-११-६०", "content_sanskrit": "श्रुत्वा परिमलो राजा तत्रागत्य मुदान्वितः ।\nआघ्राय वत्सजं शूरं देशराजसुतं तथा ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7002668060, "chapter_id": 22668, "verse_number": "७-११-६१", "content_sanskrit": "ब्रह्मानंदेन सहितः स्वगेहं पुनराययौ ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}]