[{"id": 900004251, "chapter_id": 8331, "verse_number": "7.1", "content_sanskrit": "संवादानुक्तियुता निग्रहाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900004252, "chapter_id": 8331, "verse_number": "7.2", "content_sanskrit": "तत्र येन यत् यथा साध्यत्वादिना निर्दिष्टं तस्य तथा निर्वाहादर्शनेन पुनस्त्यागः प्रतिज्ञाहानिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900004253, "chapter_id": 8331, "verse_number": "7.3", "content_sanskrit": "दूषणहानिः स्वरूपतो यथा ‘पर्वतोऽग्निमान् प्रमेयत्वात्’", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900004254, "chapter_id": 8331, "verse_number": "7.4", "content_sanskrit": "सद्विषया तु ‘पर्वतोऽग्निमान् धूमवत्वात्’ इत्यत्र ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900004255, "chapter_id": 8331, "verse_number": "7.5", "content_sanskrit": "दोषपरिजिहीर्षया निर्दिष्टसाध्यभागेऽधिकप्रक्षेपः प्रतिज्ञाऽन्तरम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900004256, "chapter_id": 8331, "verse_number": "7.6", "content_sanskrit": "उदाहरणे प्रयोज्यभागे प्रयोज्यस्वरूपतदन्तरतद्विशेषण-धर्मितद्विशेषणप्रक्षेपभेदेन पंचविधम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900004257, "chapter_id": 8331, "verse_number": "7.7", "content_sanskrit": "निगमनेऽपि प्रतिज्ञायामिवोदाहर्तव्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900004258, "chapter_id": 8331, "verse_number": "7.8", "content_sanskrit": "एकवाक्ये अवान्तरवाक्यानां पदानां च मिथो व्याघातः प्रतिज्ञाविरोधः", "padaccheda":