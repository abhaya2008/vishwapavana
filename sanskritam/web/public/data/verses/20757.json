[{"id": 7000757000, "chapter_id": 20757, "verse_number": "६-१००-१", "content_sanskrit": "नारद उवाच ।\nजालंधरस्तु तच्छ्रुत्वा कोपाकुलितविग्रहः ।\nनिर्जगामाशु दैत्यानां कोटिभिः परिवारितः॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000757001, "chapter_id": 20757, "verse_number": "६-१००-२", "content_sanskrit": "गतस्तस्याग्रतः शुक्रो राहुर्दृष्टिस्थितोऽभवत् ।\nमुकुटश्चापतद्भूमौ वेगात्प्रस्खलितस्तदा॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000757002, "chapter_id": 20757, "verse_number": "६-१००-३", "content_sanskrit": "दैत्यसैन्यवृतैस्तत्र विमानानां शतैस्तदा ।\nव्यराजत नभः पूर्णं प्रावृषीव बलाहकैः॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000757003, "chapter_id": 20757, "verse_number": "६-१००-४", "content_sanskrit": "तस्योद्योगं तदा दृष्ट्वा देवाः शक्रपुरोगमाः ।\nअलक्षितत्वराजग्मुः शूलिनं ते व्यजिज्ञपन्॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000757004, "chapter_id": 20757, "verse_number": "६-१००-५", "content_sanskrit": "देवा ऊचुः ।\nन जानासि कथं स्वामिन्देवा विज्ञापयंति भो ।\nतदस्मद्रक्षणार्थाय जहि सागरनंदनम्॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000757005, "chapter_id": 20757, "verse_number": "६-१००-६", "content_sanskrit": "नारद उवाच ।\nइति देववचः श्रुत्वा प्रहस्य वृषभध्वजः ।\nमहाविष्णुं समाहूय वचनं चेदमब्रवीत्॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000757006, "chapter_id": 20757, "verse_number": "६-१००-७", "content_sanskrit": "ईश्वर उवाच ।\nजालंधरः कथं विष्णो न हतः संगरे त्वया ।\nतद्भयाच्चापयातोऽसि त्यक्त्वा वैकुंठमात्मनः॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000757007, "chapter_id": 20757, "verse_number": "६-१००-८", "content_sanskrit": "भगवानुवाच ।\nतवांशसंभवत्वाच्च भ्रातृत्वाच्च तथा श्रियः ।\nन मया निहतः संख्ये त्वमेनं जहि दानवम्॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000757008, "chapter_id": 20757, "verse_number": "६-१००-९", "content_sanskrit": "ईश्वर उवाच ।\nनायमेभिर्महातेजाः शस्त्रास्त्रैर्वध्यते मया ।\nदेवैः सर्वैः स्वतेजोंशः शस्त्रार्थे दीयतां मम॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000757009, "chapter_id": 20757, "verse_number": "६-१००-१०", "content_sanskrit": "नारद उवाच ।\nअथ विष्णुमुखा देवाः स्वतेजांसि ददुस्तदा ।\nतान्येकत्वं गतानीशो दृष्ट्वा तेजो महांस्तदा॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000757010, "chapter_id": 20757, "verse_number": "६-१००-११", "content_sanskrit": "तेनाकरोन्महादेवः सहसा शस्त्रमुत्तमम् ।\nचक्रं सुदर्शनं नाम ज्वालामालातिभीषणम्॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000757011, "chapter_id": 20757, "verse_number": "६-१००-१२", "content_sanskrit": "तेजःशेषेण च तदा वज्रं च कृतवान्हरः ।\nतावज्जलंधरो दृष्टः कैलासतलभूमिषु॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000757012, "chapter_id": 20757, "verse_number": "६-१००-१३", "content_sanskrit": "हस्त्यश्वरथपत्तीनां कोटीभिः परिवारितः ।\nतं दृष्ट्वा हर्षिताः सर्वे देवा जग्मुर्यथागतम्॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000757013, "chapter_id": 20757, "verse_number": "६-१००-१४", "content_sanskrit": "गणाश्च समनह्यंत युद्धायातित्वरान्विताः ।\nनंदीभवक्त्रसेनानीमुखाः सर्वे शिवाज्ञया॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000757014, "chapter_id": 20757, "verse_number": "६-१००-१५", "content_sanskrit": "अवतेरुर्गणाः सर्वे कैलासाद्युद्धदुर्मदाः ।\nततः समभवद्युद्धं कैलासोपत्यका भुवि॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000757015, "chapter_id": 20757, "verse_number": "६-१००-१६", "content_sanskrit": "प्रमथाधिपदैत्यानां घोरं शस्त्रास्त्रसंकुलम् ।\nभेरीमृदंगशंखौघनिस्वनैर्वीरहर्षणैः॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000757016, "chapter_id": 20757, "verse_number": "६-१००-१७", "content_sanskrit": "गजाश्वरथशब्दैश्च नादिता भूर्व्यकंपत ।\nशक्तितोमरबाणौघैर्मुशलप्रासपट्टिशैः॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000757017, "chapter_id": 20757, "verse_number": "६-१००-१८", "content_sanskrit": "व्यराजत नभः पूर्णमुल्काभिरिव संवृतम् ।\nनिहतैरथ नागाश्वैः सर्वा भूमिर्व्यराजत॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000757018, "chapter_id": 20757, "verse_number": "६-१००-१९", "content_sanskrit": "वज्राहताश्चलशिरः शकलैरिव संवृता ।\nप्रमथाहतदैत्यौघैर्दैत्याहतगणैस्तथा॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000757019, "chapter_id": 20757, "verse_number": "६-१००-२०", "content_sanskrit": "वसासृङ्मांस पंकाद्यैर्भूरगम्याभवत्तदा ।\nप्रमथाहतदैत्यौघान्भार्गवः समजीवयत्॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000757020, "chapter_id": 20757, "verse_number": "६-१००-२१", "content_sanskrit": "युद्धे पुनः पुनश्चैव मृतसंजीवनी बलात् ।\nतं दृष्ट्वा व्याकुलीभूत्वा गणाः सर्वे भयार्दिताः॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000757021, "chapter_id": 20757, "verse_number": "६-१००-२२", "content_sanskrit": "शशंसुर्देवदेवेशं तत्सर्वं शुक्रचेष्टितम् ।\nअथ रुद्रमुखात्कृत्या बभूवातीव भीषणा॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000757022, "chapter_id": 20757, "verse_number": "६-१००-२३", "content_sanskrit": "तालजंघोदरी वक्रा स्तनापीडितभूरुहा ।\nसा युद्धभूमिमासाद्य भक्षयंती महासुरान्॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000757023, "chapter_id": 20757, "verse_number": "६-१००-२४", "content_sanskrit": "भार्गवं स्वकरे धृत्वा जगामांतर्हिताभवत् ।\nविधृतं भार्गवं दृष्ट्वा दैत्यसैन्यगणास्तदा॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000757024, "chapter_id": 20757, "verse_number": "६-१००-२५", "content_sanskrit": "प्रम्लानवदना दर्पान्निजघ्नुर्युद्धदुर्मदाः ।\nअथाभज्यत दैत्यानां सेना गणभयार्दिता॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000757025, "chapter_id": 20757, "verse_number": "६-१००-२६", "content_sanskrit": "वायुवेगहता यद्वत्प्रकीर्णतृणसंहतिः ।\nभग्नां गतभयात्सेनां दृष्ट्वा हर्षं गणा ययुः॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000757026, "chapter_id": 20757, "verse_number": "६-१००-२७", "content_sanskrit": "निशुंभशुंभसेनान्यौ कालनेमिश्च वीर्यवान् ।\nत्रयस्ते वारयामासुर्गणसेनां महाबलाः॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000757027, "chapter_id": 20757, "verse_number": "६-१००-२८", "content_sanskrit": "मुंचतः शरवर्षाणि प्रावृषीव बलाहकाः ।\nततो दैत्यशरौघास्ते शलभानामिव व्रजाः॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000757028, "chapter_id": 20757, "verse_number": "६-१००-२९", "content_sanskrit": "रुरुधुः खं दिशः सर्वा गणसेनामकंपयन् ।\nगणाः शरशतैर्भिन्ना रुधिरासारवर्षिणः॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000757029, "chapter_id": 20757, "verse_number": "६-१००-३०", "content_sanskrit": "वसंते किंशुकाभासा न प्राज्ञायत किंचन ।\nपतिताः पात्यमानाश्च छिन्नाभिन्नास्तदा गणाः॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000757030, "chapter_id": 20757, "verse_number": "६-१००-३१", "content_sanskrit": "त्यक्त्वा संग्रामभूमिं ते सर्वेऽपि विमुखाभवन्॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000757031, "chapter_id": 20757, "verse_number": "६-१००-३२", "content_sanskrit": "ततः प्रभग्नं स्वबलं विलोक्य गजास्यनंदीश्वरकार्तिकेयाः ।\nचिरान्विता दैत्यवरान्प्रसह्य निवारयामासुरमर्षणास्ते॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]