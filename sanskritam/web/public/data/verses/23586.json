[{"id": 7003586000, "chapter_id": 23586, "verse_number": "१-१-८-१", "content_sanskrit": "लोमश उवाच ।\nतस्करोऽपि पुरा ब्रह्मन्सर्वधर्मबाहिष्कृतः ।\nब्रह्मघ्नोऽसौ सुरापश्च सुवर्णस्य च तस्करः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003586001, "chapter_id": 23586, "verse_number": "१-१-८-२", "content_sanskrit": "लंपटोहि महापाप उत्तमस्त्रीषु सर्वदा ।\nद्यूतकारी सदा मंदः कितवैः सह संगतः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003586002, "chapter_id": 23586, "verse_number": "१-१-८-३", "content_sanskrit": "एकदा क्रीडता तेन हारितं द्यूतमद्भुतम् ।\nकितवैर्मर्द्यमानो हि तदा नोवाच किञ्चन ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003586003, "chapter_id": 23586, "verse_number": "१-१-८-४", "content_sanskrit": "पीडितोऽप्यभवत्तूष्णीं तैरुक्तः पापकृत्तमः ।\nद्यूते त्वया च तद्द्रव्यं हारितं किं प्रयच्छसि ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003586004, "chapter_id": 23586, "verse_number": "१-१-८-५", "content_sanskrit": "नो वा तत्कथ्यतां शीघ्रं याथातथ्येन दुर्मते ।\nयद्धारितं प्रयच्छामि रात्रावित्यब्रवीच्च सः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003586005, "chapter_id": 23586, "verse_number": "१-१-८-६", "content_sanskrit": "तैर्मुक्तस्तेन वाक्येन गतास्ते कितवादयः ।\nतदा निशीथसमये गतोऽसौ शिवमंदिरम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003586006, "chapter_id": 23586, "verse_number": "१-१-८-७", "content_sanskrit": "शिरोधिरुह्य शम्भोश्च घण्टामादातुमुद्यतः ।\nतावत्कैलासशिखरे शंभुः प्रोवाच किंकरान् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003586007, "chapter_id": 23586, "verse_number": "१-१-८-८", "content_sanskrit": "अनेन यत्कृतं चाद्य सर्वेषामधिकं भुवि ।\nसर्वेषामेव भक्तानां वरिष्ठोऽयं च मत्प्रियः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003586008, "chapter_id": 23586, "verse_number": "१-१-८-९", "content_sanskrit": "इति प्रोक्त्वान यामास वीरभद्रादिभिर्गणैः ।\nते सर्वे त्वरिता जग्मुः कैलासाच्छिववल्लभात् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003586009, "chapter_id": 23586, "verse_number": "१-१-८-१०", "content_sanskrit": "सर्वैर्डमरुनादेन नादितं भुवनत्रयम् ।\nतान्दृष्ट्वा सहसोत्तीर्य तस्करोसौ दुरात्मवान् ।\nलिंगस्य मस्तकात्सद्यः पलायनपरोऽभवत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003586010, "chapter_id": 23586, "verse_number": "१-१-८-११", "content_sanskrit": "पलायमानं तं दृष्ट्वा वीरभद्रः समाह्वयत् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003586011, "chapter_id": 23586, "verse_number": "१-१-८-१२", "content_sanskrit": "कस्माद्विभेपि रे मन्द देवदेवो महेस्वरः ।\nप्रसन्नस्तव जातोद्य उदारचरितो ह्यसौ ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003586012, "chapter_id": 23586, "verse_number": "१-१-८-१३", "content_sanskrit": "इत्युक्त्वा तं विमाने च कृत्वा कैलासमाययौ ।\nपार्षदो हि कृतस्तेन तस्करो हि महात्मना ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003586013, "chapter_id": 23586, "verse_number": "१-१-८-१४", "content_sanskrit": "तस्माद्भाव्या शिवे भक्तिः सर्वेषामपि देहिनाम् ।\nपशवोऽपि हि पूज्याः स्युः किं पुनर्मानवाभुवि ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003586014, "chapter_id": 23586, "verse_number": "१-१-८-१५", "content_sanskrit": "ये तार्किकास्तर्कपरास्तथ मीमांसकाश्च ये ।\nअन्योन्यवादिनश्चान्ये चान्ये वात्मवितर्ककाः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003586015, "chapter_id": 23586, "verse_number": "१-१-८-१६", "content_sanskrit": "एकवाक्यं न कुर्वंति शिवार्चनबहिष्कृताः ।\nतर्को हि क्रियते यैश्च तेसर्वे किं शिवं विना ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003586016, "chapter_id": 23586, "verse_number": "१-१-८-१७", "content_sanskrit": "तथा किं बहुनोक्तेन सर्वेऽपि स्थिरजंगमाः ।\nप्राणिनोऽपि हि जायंते केवलं लिंगधारिणः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003586017, "chapter_id": 23586, "verse_number": "१-१-८-१८", "content_sanskrit": "पिण्डीयुक्तं यता लिंगं स्थापितं च यथाऽभवत् ।\nतथा नरा लिंगयुक्ताः पिण्डीभूतास्तता स्त्रियः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003586018, "chapter_id": 23586, "verse_number": "१-१-८-१९", "content_sanskrit": "शिवशक्तियुतं सर्वं जगदेतच्चराचरम् ।\nतं शिवं मौढ्यतस्त्यक्त्वा मूढाश्चान्यं भजंति ये ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003586019, "chapter_id": 23586, "verse_number": "१-१-८-२०", "content_sanskrit": "धर्ममात्यंतिकं तुच्छं नश्वरं क्षणभंगुरम् ।\nयो विष्णुः स शिवो ज्ञेयो यः शिवो विष्णुरेव सः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003586020, "chapter_id": 23586, "verse_number": "१-१-८-२१", "content_sanskrit": "पीठिका विष्णुरूपं स्याल्लिंगरूपी महेश्वरः ।\nतस्माल्लिंगार्चनं श्रेष्ठं सर्वेषामपि वै द्विजाः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003586021, "chapter_id": 23586, "verse_number": "१-१-८-२२", "content_sanskrit": "ब्रह्मा मणिमयं लिंगं पूजयत्यनिशं शुभम् ।\nइन्द्रो रत्नमयं लिंगं चन्द्रो मुक्तामयं तथा ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003586022, "chapter_id": 23586, "verse_number": "१-१-८-२३", "content_sanskrit": "भानुस्ताम्रमयं लिंगं पूजयत्यनिशं शुभम् ।\nरौक्मं लिंगं कुबेरश्च पाशी चारक्तमेव च ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003586023, "chapter_id": 23586, "verse_number": "१-१-८-२४", "content_sanskrit": "यमो नीलमयं लिंगं राजतं नैरृतस्तथा ।\nकाश्मीरं पवनो लिंगमर्चयत्यनिशं विभोः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003586024, "chapter_id": 23586, "verse_number": "१-१-८-२५", "content_sanskrit": "एवं ते लिंगिताः सर्वे लोकपालाः सवासवाः ।\nतथा सर्वेऽपि पाताले गंधर्वाः किंनरैः सह ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003586025, "chapter_id": 23586, "verse_number": "१-१-८-२६", "content_sanskrit": "दैत्यानां वैष्णवाः केचित्प्रह्लादप्रमुखा द्विजाः ।\nतथाहि राक्षसानां च विभीषणपुरोगमाः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003586026, "chapter_id": 23586, "verse_number": "१-१-८-२७", "content_sanskrit": "बलिश्च नमुचिश्चैव हिरण्यकशिपुस्तथा ।\nवृषपर्वा वृषश्चैव संह्रादो बाण एव च ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003586027, "chapter_id": 23586, "verse_number": "१-१-८-२८", "content_sanskrit": "एते चान्ये च बहवः शिष्याः शुक्रस्य धीमतः ।\nएवं शिवार्चनरताः सर्वे ते दैत्यदानवाः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003586028, "chapter_id": 23586, "verse_number": "१-१-८-२९", "content_sanskrit": "राक्षसा एव ते सर्वे शिवपूजान्विताः सदा ।\nहेतिः प्रहेतिः संयातिर्विघसः प्रघसस्तथा ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003586029, "chapter_id": 23586, "verse_number": "१-१-८-३०", "content_sanskrit": "विद्युज्जिह्वस्तीक्ष्णदंष्ट्रो धूम्राक्षो भीमविक्रमः ।\nमाली चैव सुमाली च माल्यवानतिभीषमः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003586030, "chapter_id": 23586, "verse_number": "१-१-८-३१", "content_sanskrit": "विद्युत्कैशस्तडिज्जिह्वो रावणश्च महाबलः ।\nकुंभकर्णो दुराधर्षो वेगदर्शी प्रतापवान् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003586031, "chapter_id": 23586, "verse_number": "१-१-८-३२", "content_sanskrit": "एते हि राक्षसाः श्रेष्ठा शिवार्चनरताः सदा ।\nलिंगमभ्यर्च्य च सदा सिद्धिं प्राप्ताः पुरा तु ते ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003586032, "chapter_id": 23586, "verse_number": "१-१-८-३३", "content_sanskrit": "रावणेन तपस्तप्तं सर्वेषामपि दुःखहम् ।\nतपोधिपो महादेवस्तुतोष च तदा भृशम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003586033, "chapter_id": 23586, "verse_number": "१-१-८-३४", "content_sanskrit": "वरान्प्रायच्छत तदा सर्वेषामपि दुर्लभान् ।\nज्ञानं विज्ञानसहितं लब्धं तेन सदाशिवात् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003586034, "chapter_id": 23586, "verse_number": "१-१-८-३५", "content_sanskrit": "अजेयत्वं च संग्रामे द्वैगुण्यं शिरसामपि ।\nपंचवक्त्रो महा देवो दशवक्त्रोऽथ रावणः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003586035, "chapter_id": 23586, "verse_number": "१-१-८-३६", "content_sanskrit": "देवानृषीन्पितॄंश्चैव निर्जित्य तपसा विभुः ।\nमहेशस्य प्रसादाच्च सर्वेषामधिकोऽभवत् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003586036, "chapter_id": 23586, "verse_number": "१-१-८-३७", "content_sanskrit": "राजा त्रिकूटाधिपतिर्महेशेन कृतो महान् ।\nसर्वेषां राक्षसानां च परमासनमास्तितः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003586037, "chapter_id": 23586, "verse_number": "१-१-८-३८", "content_sanskrit": "तपस्विनां परीक्षायै यदृषीणां विहिंसनम् ।\nकृतं तेन तदा विप्रा रावणेन तपस्विना ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003586038, "chapter_id": 23586, "verse_number": "१-१-८-३९", "content_sanskrit": "अजेयो हि महाञ्जातो रावणो लोकरावणः ।\nसृष्ट्यंतरं कृतं येन प्रसादाच्छंकरस्य च ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003586039, "chapter_id": 23586, "verse_number": "१-१-८-४०", "content_sanskrit": "लोकपाला जितास्तेन प्रतापेन तपस्विना ।\nब्रह्मापि विजितो येन तपसा परमेण हि ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003586040, "chapter_id": 23586, "verse_number": "१-१-८-४१", "content_sanskrit": "अमृतांशुकरो भूत्वा जितो येन शशी द्विजाः ।\nदाहकत्वाज्जितो वह्निरीशः कैलासतोलनात् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003586041, "chapter_id": 23586, "verse_number": "१-१-८-४२", "content_sanskrit": "ऐश्वर्येण जितश्चेन्द्रो विष्णुः सर्वगतस्तथा ।\nलिंगार्चनप्रसादेन त्रैलोक्यं च वशीकृतम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003586042, "chapter_id": 23586, "verse_number": "१-१-८-४३", "content_sanskrit": "तदा सर्वे सुरगणा ब्रह्मविष्णुपुरोगमाः ।\nमेरुपृष्ठं समासाद्य सुमंत्रं चक्रिरे तदा ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003586043, "chapter_id": 23586, "verse_number": "१-१-८-४४", "content_sanskrit": "पीडिताः स्मो रावणेन तपसा दुष्करेण वै ।\nगोकर्णाख्ये गिरौ देवाः श्रूयतां परमाद्भुतम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003586044, "chapter_id": 23586, "verse_number": "१-१-८-४५", "content_sanskrit": "साक्षाल्लिंगार्चनं येन कृतमस्ति महात्मना ।\nज्ञानज्ञेयं ज्ञानगम्यं यद्यत्परममद्भुतम् ।\nतत्कृतं रावणेनैव सर्वेषां दुरतिक्रमम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003586045, "chapter_id": 23586, "verse_number": "१-१-८-४६", "content_sanskrit": "वैराग्यं परमास्थाय औदार्यं च ततोऽधिकम् ।\nतेनैव ममता त्यक्ता रावणेन महात्मना ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003586046, "chapter_id": 23586, "verse_number": "१-१-८-४७", "content_sanskrit": "संवत्सरसहस्राच्च स्वशिरो हि महाभुजः ।\nकृत्त्वा करेण लिंगस्य पूजनार्थं समर्पयत् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003586047, "chapter_id": 23586, "verse_number": "१-१-८-४८", "content_sanskrit": "रावणस्य कबंधं च तदग्रे च समीपतः ।\nयोगधारणया युक्तं परमेण समाधिना ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003586048, "chapter_id": 23586, "verse_number": "१-१-८-४९", "content_sanskrit": "लिंगे लयं समाधाय कयापि कलया स्थितम् ।\nअन्यच्छिरोविवृश्च्यैवं तेनापि शिवपूजनम् ।\nकृतं नैवान्यमुनिना तथा चैवापरेणहि ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003586049, "chapter_id": 23586, "verse_number": "१-१-८-५०", "content_sanskrit": "एवं शिरांस्येव बहूनि तेन समर्पितान्येव शिवार्चनार्थे ।\nभूत्वा कबंधो हि पुनः पुनश्च शिवोऽसौ वरदो बभूव ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003586050, "chapter_id": 23586, "verse_number": "१-१-८-५१", "content_sanskrit": "मया विनासुरस्तत्र पिंडीभूतेन वै पुरा ।\nवरान्वरय पौलस्त्य यथेष्टं तान्ददाम्यहम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003586051, "chapter_id": 23586, "verse_number": "१-१-८-५२", "content_sanskrit": "रावणेन तदा चोक्तः शिवः परममंगलः ।\nयदि प्रसन्नो भगवन्देयो मे वर उत्तमः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003586052, "chapter_id": 23586, "verse_number": "१-१-८-५३", "content_sanskrit": "न कामयेऽन्यं च वरमाश्रये त्वत्पदांबुजम् ।\nयथा तथा प्रदातव्यं यद्यस्ति च कृपा मयि ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003586053, "chapter_id": 23586, "verse_number": "१-१-८-५४", "content_sanskrit": "तदा सदाशिवेनोक्तो रावणो लोकरावणः ।\nमत्प्रसादाच्च सर्वं त्वं प्राप्स्यसे मनसेप्सितम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003586054, "chapter_id": 23586, "verse_number": "१-१-८-५५", "content_sanskrit": "एवं प्राप्तं शिवात्सर्वं रावणेन सुरेश्वराः ।\nतस्मात्सर्वैर्भवद्भिश्च तपसा परमेण हि ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003586055, "chapter_id": 23586, "verse_number": "१-१-८-५६", "content_sanskrit": "विजेतव्यो रावणोयमिति मे मनसि स्थितम् ।\n्च्युतस्य वचः श्रुत्वा ब्रह्माद्या देवतागणाः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003586056, "chapter_id": 23586, "verse_number": "१-१-८-५७", "content_sanskrit": "चिंतामापेदिरे सर्वे चिरं ते विषयान्विताः ।\nब्रह्मापि चेंद्रियग्रस्तः सुता रमितुमुद्यतः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003586057, "chapter_id": 23586, "verse_number": "१-१-८-५८", "content_sanskrit": "इंद्रो हि जारभावाच्च चंद्रो हि गुरुतल्पगः ।\nयमः कदर्यभावाच्च चंचलत्वात्सदागतिः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003586058, "chapter_id": 23586, "verse_number": "१-१-८-५९", "content_sanskrit": "पावकः सर्वभक्षित्वात्तथान्ये देवतागणाः ।\nअशक्ता रावणं जेतुं तपसा च विजृंभितम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003586059, "chapter_id": 23586, "verse_number": "१-१-८-६०", "content_sanskrit": "शैलादो हि महातेजा गणश्रेष्ठः पुरातनः ।\nबुद्धि मान्नीतिनिपुणो महाबलपराक्रमी ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003586060, "chapter_id": 23586, "verse_number": "१-१-८-६१", "content_sanskrit": "शिवप्रियो रुद्ररूपी महात्मा ह्युवाच सर्वानथ चेंद्रमुख्यान् ।\nकस्माद्यूयं संभ्रमादागताश्च एतत्सर्वं कथ्यतां विस्तरेण ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003586061, "chapter_id": 23586, "verse_number": "१-१-८-६२", "content_sanskrit": "नंदिना च तदा सर्वे पृष्टाः प्रोचुस्त्वरान्विताः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003586062, "chapter_id": 23586, "verse_number": "१-१-८-६३", "content_sanskrit": "देवा ऊचुः ।\nरावणेन वयं सर्वे निर्जिता मुनिभिः सह ।\nप्रसादयितुमायाताः शिवं लोकेश्वरेश्वरम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003586063, "chapter_id": 23586, "verse_number": "१-१-८-६४", "content_sanskrit": "प्रहस्य भगवान्नंदी ब्रह्माणं वै ह्युवाच ह ।\nक्व यूयं क्व शिवः शंभुस्तपसा परमेण हि ।\nद्रष्टव्यो हृदि मध्यस्थः सोऽद्य द्रष्टुं न पार्यते ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003586064, "chapter_id": 23586, "verse_number": "१-१-८-६५", "content_sanskrit": "यावद्भावा ह्यनेकाश्च इंद्रियार्थास्तथैव च ।\nयावच्च ममताभावस्तावदीशो हि दुर्लभः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003586065, "chapter_id": 23586, "verse_number": "१-१-८-६६", "content_sanskrit": "जितेंद्रियाणां शांतानां तन्निष्ठानां महात्मनाम् ।\nसुलभो लिंगरूपी स्याद्भवतां हि सुदुर्लभः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003586066, "chapter_id": 23586, "verse_number": "१-१-८-६७", "content_sanskrit": "तदा ब्रह्मादयो देवा ऋषयश्च विपश्चितः ।\nप्रणम्य नंदिनं प्राहुः कस्मात्त्वं वानराननः ।\nतत्सर्वं कथयान्यं च रावणस्य तपोबलम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003586067, "chapter_id": 23586, "verse_number": "१-१-८-६८", "content_sanskrit": "नंदीश्वर उवाच ।\nकुबेरोऽधिकृतस्तेन शंकरेण महात्मना ।\nधनानामादिपत्ये च तं द्रष्टुं रावणोऽत्र वै ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003586068, "chapter_id": 23586, "verse_number": "१-१-८-६९", "content_sanskrit": "आगच्छत्त्वरया युक्तः समारुह्य स्ववाहनम् ।\nमां दृष्ट्वा चाब्रवीत्क्रुद्धः कुबेरो ह्यत्र आगतः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003586069, "chapter_id": 23586, "verse_number": "१-१-८-७०", "content_sanskrit": "त्वया दृष्टोऽथ वात्रासौ कथ्यतामविलंबितम् ।\nकिं कार्यं धनदेनाद्य इति पृष्टो मया हि सः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003586070, "chapter_id": 23586, "verse_number": "१-१-८-७१", "content_sanskrit": "तदोवाच महातेजा रावणो लोकरावणः ।\nमय्यश्रद्धान्वितो भूत्वा विषयात्मा सुदुर्मदः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003586071, "chapter_id": 23586, "verse_number": "१-१-८-७२", "content_sanskrit": "शिक्षापयितुमारब्धो मैवं कार्यमिति प्रभो ।\nयथाहं च श्रिया युक्त आढ्योऽहं बलवानहम् ।\nतथा त्वं भव रे मूढ मा मूढत्वमुपार्जय ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003586072, "chapter_id": 23586, "verse_number": "१-१-८-७३", "content_sanskrit": "अहं मूढः कृतस्तेन कुबेरेण महात्मना ।\nमया निराकृतो रोषात्तपस्तेपे स गुह्यकः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003586073, "chapter_id": 23586, "verse_number": "१-१-८-७४", "content_sanskrit": "कुबेरः स हि नंदिन्किमागतस्तव मंदिरम् ।\nदीयतां च कुबेरोद्य नात्र कार्या विचारणा ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003586074, "chapter_id": 23586, "verse_number": "१-१-८-७५", "content_sanskrit": "रावणस्य वचः श्रुत्वा ह्यवोचं त्वरितोऽप्यहम् ।\nलिंगकोसि महाभाग त्वमहं च तथाविधः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003586075, "chapter_id": 23586, "verse_number": "१-१-८-७६", "content_sanskrit": "उभयोः समनां ज्ञात्वा वृथा जल्पसि दुर्मते ।\nयथोक्तः स त्ववादीन्मां वदनार्थे बलोद्धतः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003586076, "chapter_id": 23586, "verse_number": "१-१-८-७७", "content_sanskrit": "यथा भवद्भिः पृष्टोऽहं वदनार्थे महात्मभिः ।\nपुरावृत्तं मया प्रोक्तं शिवार्चनविधेः फलम् ।\nशिवेन दत्तं सालूप्यं न गृहीतं मया तदा ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003586077, "chapter_id": 23586, "verse_number": "१-१-८-७८", "content_sanskrit": "याचितं च मया शंभोर्वदनं वानरस्य च ।\nशिवेन कृपया दत्तं मम कारुण्यशालिना ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003586078, "chapter_id": 23586, "verse_number": "१-१-८-७९", "content_sanskrit": "निराभिमानिनो ये च निर्दभा निष्परिग्रहाः ।\nशंभोः प्रियास्ते विज्ञेया ह्यन्ये शिववबहिष्कृताः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003586079, "chapter_id": 23586, "verse_number": "१-१-८-८०", "content_sanskrit": "तथावदन्मया सार्द्धं रावणस्तपसो बलात् ।\nमया च याचितान्येव दश वक्त्राणि धीमता ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003586080, "chapter_id": 23586, "verse_number": "१-१-८-८१", "content_sanskrit": "उपहासकरं वाक्यं पौलस्त्यस्य तदा सुराः ।\nमया तदा हि शप्तोऽसौ रावणो लोकरावणः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003586081, "chapter_id": 23586, "verse_number": "१-१-८-८२", "content_sanskrit": "ईदृशान्येव वक्त्राणि येषां वै संभवंति हि ।\nतैः समेतो यदा कोऽपि नरवर्यो महातपाः ।\nमां पुरस्कृत्य सहसा हनिष्यति न संशयः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003586082, "chapter_id": 23586, "verse_number": "१-१-८-८३", "content_sanskrit": "एवं शप्तो मया ब्रह्मन्रावणो लोकरावणः ।\nअर्चितं केवलं लिंगं विना तेन महात्मना ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003586083, "chapter_id": 23586, "verse_number": "१-१-८-८४", "content_sanskrit": "पीठिकारूपसंस्थेन विना तेन सुरोत्तमाः ।\nविष्णुना हि महाभागास्तस्मात्सर्वं विधास्यति ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003586084, "chapter_id": 23586, "verse_number": "१-१-८-८५", "content_sanskrit": "देवदेवो महादेवो विष्णुरूपी महेश्वरः ।\nसर्वे यूयं प्रार्थयंतु विष्णुं सर्वगुहाशयम् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003586085, "chapter_id": 23586, "verse_number": "१-१-८-८६", "content_sanskrit": "अहं हि सर्वदेवानां पुरोवर्ती भवाम्यतः ।\nते सर्वे नंदिनो वाक्यं श्रुत्वा मुदितमानसाः ।\nवैकुंठमागता गीर्भिर्विष्णुं स्तोतुं प्रचक्रिरे ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003586086, "chapter_id": 23586, "verse_number": "१-१-८-८७", "content_sanskrit": "देवा ऊचुः ।\nनमो भगवते तुभ्यं देवदेव जगत्पते ।\nत्वदाधारमिदं सर्वं जगदेतच्चराचरम् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003586087, "chapter_id": 23586, "verse_number": "१-१-८-८८", "content_sanskrit": "एतल्लिंगं त्वया विष्णो धृतं वै पिण्डिरूपिणा ।\nमहाविष्णुस्वरूपेण घातितौ मधुकैटभौ ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003586088, "chapter_id": 23586, "verse_number": "१-१-८-८९", "content_sanskrit": "तथा कमठरूपेण धृतो वै मंदराचलः ।\nवराहरूपमास्थाय हिरण्याक्षो हतस्त्वया ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003586089, "chapter_id": 23586, "verse_number": "१-१-८-९०", "content_sanskrit": "हिरण्यकशिपुर्दैत्यो हतो नृहरिरूपिणा ।\nत्वया चैव बलिर्बद्धो दैत्यो वामनरूपिणा ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003586090, "chapter_id": 23586, "verse_number": "१-१-८-९१", "content_sanskrit": "भृगूणामन्वये भूत्वा कृतवीर्यात्मजो हतः ।\nइतोप्यस्मान्महाविष्णो तथैव परिपालय ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003586091, "chapter_id": 23586, "verse_number": "१-१-८-९२", "content_sanskrit": "रावमस्य भयादस्मात्त्रातुं भूयोर्हसि त्वरम् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003586092, "chapter_id": 23586, "verse_number": "१-१-८-९३", "content_sanskrit": "एवं संप्रार्थितो देवैर्भगवान्भूतभावनः ।\nउवाच च सुरान्सर्वान्वासुदेवो जगन्मयः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003586093, "chapter_id": 23586, "verse_number": "१-१-८-९४", "content_sanskrit": "हे देवाः श्रूयतां वाक्यं प्रस्तावसदृशं महत् ।\nशैलादिं च पुरस्कृत्य सर्वे यूयं त्वरान्विताः ।\nअवतारान्प्रकुर्वन्तु वानरीं तनुमाश्रिताः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003586094, "chapter_id": 23586, "verse_number": "१-१-८-९५", "content_sanskrit": "अहं हि मानुषो भूत्वा ह्यज्ञानेन समावृतः ।\nसंभविष्याम्ययोध्यायं गृहे दशरथस्य च ।\nब्रह्मविद्यासहायोस्मि भवतां कार्यसिद्धये ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003586095, "chapter_id": 23586, "verse_number": "१-१-८-९६", "content_sanskrit": "जनकस्य गृहे साक्षाद्ब्रह्मविद्या जनिष्यति ।\nभक्तो हि रावणः साक्षाच्छिवध्यानपरायणः ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003586096, "chapter_id": 23586, "verse_number": "१-१-८-९७", "content_sanskrit": "तपसा महता युक्तो ब्रह्मविद्यां यदेच्छति ।\nतदा सुसाध्यो भवति पुरुषो धर्मनिर्जितः ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7003586097, "chapter_id": 23586, "verse_number": "१-१-८-९८", "content_sanskrit": "एवं संभाष्य भगवान्विष्णुः परममङ्गलः ।\nवाली चेन्द्रांशसंभूतः सुग्रीवों शुमतः सुतः ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7003586098, "chapter_id": 23586, "verse_number": "१-१-८-९९", "content_sanskrit": "तथा ब्रह्मांशसंभूतो जाम्बवान्नृक्षकुञ्जरः ।\nशिलादतनयो नंदी शिवस्यानुचरः प्रियः ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7003586099, "chapter_id": 23586, "verse_number": "१-१-८-१००", "content_sanskrit": "यो वै चैकादशो रुद्रो हनूमान्स महाकपिः ।\nअवतीर्णः सहायार्थं विष्णोरमिततेजसः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7003586100, "chapter_id": 23586, "verse_number": "१-१-८-१०१", "content_sanskrit": "मैंदादयोऽथ कपयस्ते सर्वे सुरसत्तमाः ।\nएवं सर्वे सुरगणा अवतेरुर्यथा तथम् ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7003586101, "chapter_id": 23586, "verse_number": "१-१-८-१०२", "content_sanskrit": "तथैव विष्णुरुत्पन्नः कौशल्यानंदवर्द्धनः ।\nविश्वस्य रमणाच्चैव राम इत्युच्यते बुधैः ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7003586102, "chapter_id": 23586, "verse_number": "१-१-८-१०३", "content_sanskrit": "शेषोपि भक्त्या विष्णोश्च तपसाऽवातरद्भुवि ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7003586103, "chapter_id": 23586, "verse_number": "१-१-८-१०४", "content_sanskrit": "दोर्दण्डावपि विष्णोश्च अवतीर्णौ प्रतापिनौ ।\nशत्रुघ्नभरताख्यौ च विख्यातौ भुवनत्रये ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7003586104, "chapter_id": 23586, "verse_number": "१-१-८-१०५", "content_sanskrit": "मिथिलाधिपतेः कन्या या उक्ता ब्रह्मवादिभिः ।\nसा ब्रह्मविद्यावतरत्सुराणां कार्य्यसिद्धये ।\nसीता जाता लांगलस्य इयं भूमिविकर्षणात् ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7003586105, "chapter_id": 23586, "verse_number": "१-१-८-१०६", "content_sanskrit": "तस्मात्सीतेति विख्याता विद्या सान्वीक्षिकी तदा ।\nमिथिलायां समुत्पन्ना मैथितीत्यभिधीयते ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7003586106, "chapter_id": 23586, "verse_number": "१-१-८-१०७", "content_sanskrit": "जनकस्य कुले जाता विश्रुता जनकात्मजा ।\nख्याता वेदवती पूर्वं ब्रह्मविद्याघनाशिनी ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7003586107, "chapter_id": 23586, "verse_number": "१-१-८-१०८", "content_sanskrit": "सा दत्ता जनकेनैव विष्णवे परमात्मने ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7003586108, "chapter_id": 23586, "verse_number": "१-१-८-१०९", "content_sanskrit": "तयाथ विद्यया सार्द्धं देवदेवो जगत्पतिः ।\nउग्रे तपसि लीनोऽसौ विष्णुः परमदुष्करम् ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7003586109, "chapter_id": 23586, "verse_number": "१-१-८-११०", "content_sanskrit": "रावणं जेतुकामो वै रामो राजीवलोचनः ।\nअरण्यवासमकरोद्देवानां कार्यसिद्धये ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7003586110, "chapter_id": 23586, "verse_number": "१-१-८-१११", "content_sanskrit": "शेषावतारोऽपि महांस्तपः परमदुष्करम् ।\nतताप परया शक्त्या देवानां कार्यसिद्धये ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7003586111, "chapter_id": 23586, "verse_number": "१-१-८-११२", "content_sanskrit": "शत्रुघ्नो भरतश्चैव तेपतुः परमं तपः ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7003586112, "chapter_id": 23586, "verse_number": "१-१-८-११३", "content_sanskrit": "ततोऽसौ तपसा युक्तः सार्द्धं तैर्देवतागणैः ।\nसगणं रावणं रामः षड्भिर्मासैरजीहनत् ।\nविष्णुना घातितः शस्त्रैः शिवसारूप्यमाप्तवान् ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7003586113, "chapter_id": 23586, "verse_number": "१-१-८-११४", "content_sanskrit": "सगमः स पुनः सद्यो बंधुभिः सह सुव्रताः ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7003586114, "chapter_id": 23586, "verse_number": "१-१-८-११५", "content_sanskrit": "शिवप्रसादात्सकलं द्वैताद्वैतमवाप ह ।\nद्वैताद्वैतविवेकार्थमृपयोप्यत्र मोहिताः ।\nतत्सर्वं प्राप्नुवंतीह शिवार्चनरता नराः ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7003586115, "chapter_id": 23586, "verse_number": "१-१-८-११६", "content_sanskrit": "येऽर्चयंति शिवं नित्यं लिंगरूपिणमेव च ।\nस्त्रियो वाप्यथ वा शूद्राः श्वपचा ह्यंत्यवासिनः ।\nतं शिवं प्राप्नुवंत्येव सर्वदुःखोपनाशनम् ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7003586116, "chapter_id": 23586, "verse_number": "१-१-८-११७", "content_sanskrit": "पशवोऽपि परं याताः किं पुनर्मानुषादयः ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7003586117, "chapter_id": 23586, "verse_number": "१-१-८-११८", "content_sanskrit": "ये द्विजा ब्रह्मचर्येण तपः परममास्थिताः ।\nवर्षैरनेकैर्यज्ञानां तेऽपि स्वर्गपरा भवन् ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7003586118, "chapter_id": 23586, "verse_number": "१-१-८-११९", "content_sanskrit": "ज्योतिष्टोमो वाजपेयो ह्यतिरात्रादयो ह्यमी ।\nयज्ञाः स्वर्गं प्रयच्छंति सत्त्रीणां नात्र संशयः ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7003586119, "chapter_id": 23586, "verse_number": "१-१-८-१२०", "content_sanskrit": "तत्र स्वर्गसुखं भुक्त्वा पुण्यक्षयकरं महत् ।\nपुण्यक्षयेऽपि यज्वानो मर्त्यलोकं पतंति वै ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7003586120, "chapter_id": 23586, "verse_number": "१-१-८-१२१", "content_sanskrit": "पतितानां च संसारे दैवाद्बुद्धिः प्रजायते ।\nगुणत्रयमयी विप्रास्तासुतास्त्विह योनिषु ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7003586121, "chapter_id": 23586, "verse_number": "१-१-८-१२२", "content_sanskrit": "यथा सत्त्वं संभवति सत्त्वयुक्तभवं नराः ।\nराजसाश्च तथा ज्ञेयास्ता मसाश्चैव ते द्विजाः ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7003586122, "chapter_id": 23586, "verse_number": "१-१-८-१२३", "content_sanskrit": "एवं संसारचक्रेऽस्मिन्भ्रमिता बहवो जनाः ।\nयदृच्छया दैवगत्या शिवं संसेवते नरः ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7003586123, "chapter_id": 23586, "verse_number": "१-१-८-१२४", "content_sanskrit": "शिवध्यानपराणां च नराणां यतचेतसाम् ।\nमायानिरसनं सद्यो भविष्यति न चान्यथा ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7003586124, "chapter_id": 23586, "verse_number": "१-१-८-१२५", "content_sanskrit": "मायानिरसनात्सद्यो नश्यत्येव गुणत्रयम् ।\nयदा गुणत्रयातीतो भवतीति स मुक्तिभाक् ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7003586125, "chapter_id": 23586, "verse_number": "१-१-८-१२६", "content_sanskrit": "तस्माल्लिङ्गार्चनं भाव्यं सर्वेषामपि देहिनाम् ।\nलिङ्गरूपी शिवो भूत्वा त्रायते संचराचरम् ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7003586126, "chapter_id": 23586, "verse_number": "१-१-८-१२७", "content_sanskrit": "पुरा भवद्भिः पृष्टोऽहं लिङ्गरूपी कथं शिवः ।\nतत्सर्वं कथितं विप्रा याथातथ्येन संप्रति ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7003586127, "chapter_id": 23586, "verse_number": "१-१-८-१२८", "content_sanskrit": "कथं गरं भक्षितवाञ्छिवो लोकमहेश्वरः ।\nतत्सर्वं श्रूयतां विप्रा यतावत्कथयामि वः ॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}]