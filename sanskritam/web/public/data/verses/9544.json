[{"id": 5000544000, "chapter_id": 9544, "verse_number": "७-९-१", "content_sanskrit": "कस्यचित्त्वथ कालस्य सुमाली नाम राक्षसः ।\nरसातलान्मर्त्यलोकं सर्वं वै विचचार ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000544001, "chapter_id": 9544, "verse_number": "७-९-२", "content_sanskrit": "नीलजीमूतसङ्काशस्तप्तकाञ्चनकुण्डलः ।\nकन्यां दुहितरं गृह्य विना पद्ममिव श्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000544002, "chapter_id": 9544, "verse_number": "७-९-३", "content_sanskrit": "राक्षसेन्द्रः स तु तदा विचरन्वै महीतलम् ।\nतदापश्यत्स गच्छन्तं पुष्पकेण धनेश्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000544003, "chapter_id": 9544, "verse_number": "७-९-४", "content_sanskrit": "गच्छन्तं पितरं द्रष्टुं पुलस्त्यतनयं विभुम् ।\nतं दृष्ट्वा ऽमरसङ्काशं स्वच्छन्दं तपनोपमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000544004, "chapter_id": 9544, "verse_number": "७-९-५", "content_sanskrit": "रसातलं प्रविष्टः सन्मर्त्यलोकात्सविस्मयः ।\nइत्येवं चिन्तयामास राक्षसानां महामतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000544005, "chapter_id": 9544, "verse_number": "७-९-६", "content_sanskrit": "किं कृतं श्रेय इत्येवं वर्धेमहि कथं वयम् ।\nअथाब्रवीत्सुतां रक्षः कैकसीं नाम नामतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000544006, "chapter_id": 9544, "verse_number": "७-९-७", "content_sanskrit": "पुत्रि प्रदानकालो ऽयं यौवनं व्यतिवर्तते ।\nप्रत्याख्यानाच्च भीतैस्त्वं न वरैः प्रतिगृह्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000544007, "chapter_id": 9544, "verse_number": "७-९-८", "content_sanskrit": "त्वत्कृते च वयं सर्वे यन्त्रिता धर्मबुद्धयः ।\nत्वं हि सर्वगुणोपेता श्रीः साक्षादिव पुत्रिके ।\nकन्यापितृत्वं दुःखं हि सर्वेषां मानकाङ्क्षिणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000544008, "chapter_id": 9544, "verse_number": "७-९-९", "content_sanskrit": "न ज्ञायते च कः कन्यां वरयेदिति कन्यके ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000544009, "chapter_id": 9544, "verse_number": "७-९-१०", "content_sanskrit": "त्वं हि सर्वगुणोपेता श्रीः साक्षादिव पुत्रिके ।\nमातुः कुलं पितृकुलं यत्र चैव प्रदीयते ।\nकुलत्रयं सदा कन्या संशये स्थाप्य तिष्ठति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000544010, "chapter_id": 9544, "verse_number": "७-९-११", "content_sanskrit": "सा त्वं मुनिवरं श्रेष्ठं प्रजापतिकुलोद्भवम् ।\nभज विश्रवसं पुत्रि पौलस्त्यं वरय स्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000544011, "chapter_id": 9544, "verse_number": "७-९-१२", "content_sanskrit": "ईदृशास्ते भविष्यन्ति पुत्राः पुत्रि न संशयः ।\nतेजसा भास्करसमो यादृशो ऽयं धनेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000544012, "chapter_id": 9544, "verse_number": "७-९-१३", "content_sanskrit": "सा तु तद्वचनं श्रुत्वा कन्यका पितृगौरवात् ।\nतत्रोपागम्य सा तस्थौ विश्रवा यत्र तप्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000544013, "chapter_id": 9544, "verse_number": "७-९-१४", "content_sanskrit": "एतस्मिन्नन्तरे राम पुलस्त्यतनयो द्विजः ।\nअग्निहोत्रमुपातिष्ठच्चतुर्थ इव पावकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000544014, "chapter_id": 9544, "verse_number": "७-९-१५", "content_sanskrit": "अविचिन्त्य तु तां वेलां दारुणां पितृगौरवात् ।\nउपसृत्याग्रतस्तस्य चरणाधोमुखी स्थिता ।\nविलिखन्ती मुहुर्भूमिमङ्गुष्ठाग्रेण भामिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000544015, "chapter_id": 9544, "verse_number": "७-९-१६", "content_sanskrit": "स तु तां वीक्ष्य सुश्रोणीं पूर्णचन्द्रनिभाननाम् ।\nअब्रवीत्परमोदारो दीप्यमानां स्वतेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000544016, "chapter_id": 9544, "verse_number": "७-९-१७", "content_sanskrit": "भद्रे कस्यासि दुहिता कुतो वा त्वमिहागता ।\nकिं कार्यं कस्य वा हेतोस्तत्त्वतो ब्रूहि शोभने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000544017, "chapter_id": 9544, "verse_number": "७-९-१८", "content_sanskrit": "एवमुक्ता तु सा कन्या कृताञ्जलिरथाब्रवीत् ।\nआत्मप्रभावेण मुने ज्ञातुमर्हसि मे मतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000544018, "chapter_id": 9544, "verse_number": "७-९-१९", "content_sanskrit": "किं तु मां विद्धि ब्रह्मर्षे शासनात्पितुरागताम् ।\nकैकसी नाम नाम्नाहं शेषं त्वं ज्ञातुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000544019, "chapter_id": 9544, "verse_number": "७-९-२०", "content_sanskrit": "स तु गत्वा मुनिर्ध्यानं वाक्यमेतदुवाच ह ।\nविज्ञातं ते मया भद्रे कारणं यन्मनोगतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000544020, "chapter_id": 9544, "verse_number": "७-९-२१", "content_sanskrit": "सुताभिलाषो मत्तस्ते मत्तमातङ्गगामिनि ।\nदारुणायां तु वेलायां यस्मात्त्वं मामुपस्थिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000544021, "chapter_id": 9544, "verse_number": "७-९-२२", "content_sanskrit": "शृणु तस्मात्सुतान्भद्रे यादृशाञ्जनयिष्यसि ।\nदारुणान्दारुणाकारान्दारुणाभिजनप्रियान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000544022, "chapter_id": 9544, "verse_number": "७-९-२३", "content_sanskrit": "प्रसविष्यसि सुश्रोणि राक्षसान्क्रूरकर्मणः ।\nसा तु तद्वचनं श्रुत्वा प्रणिपत्याब्रवीद्वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000544023, "chapter_id": 9544, "verse_number": "७-९-२४", "content_sanskrit": "भगवन्नीदृशान्पुत्रांस्त्वत्तो ऽहं ब्रह्मवादिनः ।\nनेच्छामि सुदुराचारान्प्रसादं कर्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000544024, "chapter_id": 9544, "verse_number": "७-९-२५", "content_sanskrit": "कन्यया त्वेवमुक्तस्तु विश्रवा मुनिपुङ्गवः ।\nउवाच कैकसीं भूयः पूर्णेन्दुरिव रोहिणीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000544025, "chapter_id": 9544, "verse_number": "७-९-२६", "content_sanskrit": "पश्चिमो यस्तव सुतो भविष्यति शुभानने ।\nमम वंशानुरूपः स धर्मात्मा च भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000544026, "chapter_id": 9544, "verse_number": "७-९-२७", "content_sanskrit": "एवमुक्ता तु सा कन्या राम कालेन केनचित् ।\nजनयामास बीभत्सं रक्षोरूपं सुदारुणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000544027, "chapter_id": 9544, "verse_number": "७-९-२८", "content_sanskrit": "दशग्रीवं महादंष्ट्रं नीलाञ्जनचयोपमम् ।\nताम्रोष्ठं विंशतिभुजं महास्यं दीप्तमूर्धजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000544028, "chapter_id": 9544, "verse_number": "७-९-२९", "content_sanskrit": "तस्मिञ्जाते तु तत्काले सज्वालकवलाः शिवाः ।\nक्रव्यादाश्चापसव्यानि मण्डलानि प्रचक्रमुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000544029, "chapter_id": 9544, "verse_number": "७-९-३०", "content_sanskrit": "ववर्ष रुधिरं देवो मेघाश्च खरनिःस्वनाः ।\nप्रबभौ न च सूर्यो वै महोल्काश्चापतन्भुवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000544030, "chapter_id": 9544, "verse_number": "७-९-३१", "content_sanskrit": "चकम्पे जगती चैव ववुर्वाताः सुदारुणाः ।\nअक्षोभ्यः क्षुभितश्चैव समुद्रः सरितां पतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000544031, "chapter_id": 9544, "verse_number": "७-९-३२", "content_sanskrit": "अथ नामाकरोत्तस्य पितामहसमः पिता ।\nदशग्रीवः प्रसूतो ऽयं दशग्रीवो भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000544032, "chapter_id": 9544, "verse_number": "७-९-३३", "content_sanskrit": "तस्य त्वनन्तरं जातः कुम्भकर्णो महाबलः ।\nप्रमाणाद्यस्य विपुलं प्रमाणं नेह विद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000544033, "chapter_id": 9544, "verse_number": "७-९-३४", "content_sanskrit": "ततः शूर्पणखा नाम सञ्जज्ञे विकृतानना ।\nविभीषणश्च धर्मात्मा कैकस्याः पश्चिमः सुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000544034, "chapter_id": 9544, "verse_number": "७-९-३५", "content_sanskrit": "तस्मिञ्जाते महासत्त्वे पुष्पवर्षं पपात ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000544035, "chapter_id": 9544, "verse_number": "७-९-३६", "content_sanskrit": "नभःस्थाने दुन्दुभयो देवानां प्राणदंस्तदा ।\nवाक्यं चैवान्तरिक्षे च साधु साध्विति तत्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000544036, "chapter_id": 9544, "verse_number": "७-९-३७", "content_sanskrit": "तौ तु तत्र महारण्ये ववृधाते महौजसौ ।\nकुम्भकर्णदशग्रीवौ लोकोद्वेगकरौ तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000544037, "chapter_id": 9544, "verse_number": "७-९-३८", "content_sanskrit": "कुम्भकर्णः प्रमत्तस्तु महर्षीन्धर्मवत्सलान् ।\nत्रैलोक्यं भक्षयन्नित्यासन्तुष्टो विचचार ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000544038, "chapter_id": 9544, "verse_number": "७-९-३९", "content_sanskrit": "विभीषणस्तु धर्मात्मा नित्यं धर्मे व्यवस्थितः ।\nस्वाध्यायनियताहार उवास विजितेन्द्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000544039, "chapter_id": 9544, "verse_number": "७-९-४०", "content_sanskrit": "अथ वैश्रवणो देवस्तत्र कालेन केनचित् ।\nआगतः पितरं द्रष्टुं पुष्पकेण धनेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000544040, "chapter_id": 9544, "verse_number": "७-९-४१", "content_sanskrit": "तं दृष्ट्वा कैकसी तत्र ज्वलन्तमिव तेजसा ।\nआगम्य राक्षसी तत्र दशग्रीवमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000544041, "chapter_id": 9544, "verse_number": "७-९-४२", "content_sanskrit": "पुत्र वैश्रवणं पश्य भ्रातरं तेजसा वृतम् ।\nभ्रातृभावे समे चापि पश्यात्मानं त्वमीदृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000544042, "chapter_id": 9544, "verse_number": "७-९-४३", "content_sanskrit": "दशग्रीव तथा यत्नं कुरुष्वामितविक्रम ।\nयथा त्वमसि मे पुत्र भव र्वैश्रवणोपमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000544043, "chapter_id": 9544, "verse_number": "७-९-४४", "content_sanskrit": "मातुस्तद्वचनं श्रुत्वा दशग्रीवः प्रतापवान् ।\nअमर्षमतुलं लेभे प्रतिज्ञां चाकरोत्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000544044, "chapter_id": 9544, "verse_number": "७-९-४५", "content_sanskrit": "सत्यं ते प्रतिजानामि भ्रातृतुल्यो ऽधिको ऽपि वा ।\nभविष्याम्योजसा चैव सन्तापं त्यज हृद्गतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000544045, "chapter_id": 9544, "verse_number": "७-९-४६", "content_sanskrit": "ततस्तेनैव कोपेन दशग्रीवः सहानुजः ।\nचिकीर्षुर्दुष्करं कर्म तपसे धृतमानसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000544046, "chapter_id": 9544, "verse_number": "७-९-४७", "content_sanskrit": "प्राप्स्यामि तपसा काममिति कृत्वा ऽध्यवस्य च ।\nआगच्छदात्मसिद्ध्यर्थं गोकर्णस्याश्रमं शुभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000544047, "chapter_id": 9544, "verse_number": "७-९-४८", "content_sanskrit": "स राक्षसस्तत्र सहानुजस्तदा तपश्चकारातुलमुग्रविक्रमः ।\nअतोषयच्चापि पितामहं विभुं ददौ स तुष्टश्च वराञ्जयावहान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000544048, "chapter_id": 9544, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे नवमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]