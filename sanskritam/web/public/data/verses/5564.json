[{"id": 2213645, "chapter_id": 5564, "verse_number": "", "content_sanskrit": "सौतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2213646, "chapter_id": 5564, "verse_number": "१", "content_sanskrit": "एतच्छ्रुत्वा नृपो विद्वान् हृष्टोऽभूज्जनमेजयः ।\nपितामहानां सर्वेषां गमनागमनं तदा\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2213647, "chapter_id": 5564, "verse_number": "२", "content_sanskrit": "अब्रवीच्च मुदा युक्तः पुनरागमनं प्रति\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2213648, "chapter_id": 5564, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2213649, "chapter_id": 5564, "verse_number": "३", "content_sanskrit": "कथं नु त्यक्तदेहानां पुनस्तद्रूपदर्शनम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2213650, "chapter_id": 5564, "verse_number": "४", "content_sanskrit": "इत्युक्तः स द्विजश्रेष्ठो व्यासशिष्यः प्रतापवान् ।\nप्रोवाच वदतांश्रेष्ठस्तं नृपं जनमेजयम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2213651, "chapter_id": 5564, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2213652, "chapter_id": 5564, "verse_number": "५", "content_sanskrit": "अविप्रणाशः सर्वेषां कर्मणामिति निश्चयः ।\nकर्मजानि शरीराणि शरीराकृतयस्तथा\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2213653, "chapter_id": 5564, "verse_number": "६", "content_sanskrit": "महाभूतानि नित्यानि भूताधिपतिसंश्रयात् ।\nतेषां च नित्यसंवासो न विनाशो वियुज्यताम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2213654, "chapter_id": 5564, "verse_number": "७", "content_sanskrit": "अनाशाय कृतं कर्म तस्य चेष्टः फलागमः ।\nआत्मा चैभिः समायुक्तः सुखदुःखमुपाश्नुते\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2213655, "chapter_id": 5564, "verse_number": "८", "content_sanskrit": "अविनाश्यस्तथा नित्यं क्षेत्रज्ञ इति निश्चयः ।\nभूतानामात्मभावो यो ध्रुवोसौ संविजानताम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2213656, "chapter_id": 5564, "verse_number": "९", "content_sanskrit": "यावन्न क्षीयते कर्म तावत्तस्य स्वरूपता ।\nक्षीणकर्मा नरो लोके रूपान्यत्वमुपाश्नुते\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2213657, "chapter_id": 5564, "verse_number": "१०", "content_sanskrit": "नानाभूतास्तथैकत्वं शरीरं प्राप्य संहताः ।\nभवन्ति ते तथा नित्याः पृथग्भावं विजानताम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2213658, "chapter_id": 5564, "verse_number": "११", "content_sanskrit": "अश्वमेधश्रुतिश्चेयमश्वसञ्ज्ञपनं प्रति ।\nलोकान्तरगता नित्यं प्राणा नित्या हि वाजिनः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2213659, "chapter_id": 5564, "verse_number": "१२", "content_sanskrit": "अहं हितं वदाम्येतत् प्रियं चेत्तव पार्थिव ।\nदेवयाना हि पन्थानः श्रुतास्ते यज्ञसंस्तरे\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2213660, "chapter_id": 5564, "verse_number": "१३", "content_sanskrit": "सुकृतो यत्र यज्ञस्ते तत्र देवा हितास्तव ।\nयदा समन्विता देवाः पशूनां गमनेश्वराः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2213661, "chapter_id": 5564, "verse_number": "१४", "content_sanskrit": "गतिमन्तश्च तेनेष्ट्वा नान्ये नित्या भवन्त्युत ।\nनित्येऽस्मिन् पञ्चके वर्गे नित्ये चात्मनि पूरुषः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2213662, "chapter_id": 5564, "verse_number": "१५", "content_sanskrit": "अस्य नाशं समायोगं यः पश्यति वृथामतिः ।\nवियोगे शोचतेऽत्यर्थं स बाल इति मे मतिः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2213663, "chapter_id": 5564, "verse_number": "१६", "content_sanskrit": "वियोगे दोषदर्शी यः संयोगं स विसर्जयेत् ।\nअसङ्गे सङ्गमो नास्ति दुःखं भावि वियोगजम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2213664, "chapter_id": 5564, "verse_number": "१७", "content_sanskrit": "परापरज्ञस्तु नरो नाति(भि)मानादुदीरितः ।\nअपरज्ञः परां बुद्धिं स्पृष्ट्वा मोहाद् विमुच्यते\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2213665, "chapter_id": 5564, "verse_number": "१८", "content_sanskrit": "अदर्शनादापतितः पुनश्चादर्शनं गतः ।\nनाहं तं वेद्मि नासौ मां न च मेऽस्ति विरागता\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2213666, "chapter_id": 5564, "verse_number": "१९", "content_sanskrit": "येनयेन शरीरेण करोत्ययमनीश्वरः ।\nतेन तेन शरीरेण तदवश्यमुपाश्नुते\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2213667, "chapter_id": 5564, "verse_number": "२०", "content_sanskrit": "मानसं मनसाऽऽप्नोति शरीरं च शरीरवान्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2213668, "chapter_id": 5564, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्रमवासिकपर्वणि\nकर्मानुरूपशरीरग्रहणकथनं नाम चत्वारिंशोऽध्यायः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2213669, "chapter_id": 5564, "verse_number": "", "content_sanskrit": "पुत्रदर्शनपर्वणि सप्तमोऽध्यायः ॥७॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]