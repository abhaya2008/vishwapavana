[{"id": 2108615, "chapter_id": 3353, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2108616, "chapter_id": 3353, "verse_number": "१", "content_sanskrit": "मातुः सकाशात् तं शापं श्रुत्वा पन्नगसत्तमः ।\nवासुकिश्चिन्तयामास शापोऽयं न भवेत् कथम् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2108617, "chapter_id": 3353, "verse_number": "२", "content_sanskrit": "ततः स मन्त्रयामास भ्रातृभिः सह सर्वशः ।\nऐरावतप्रभृतिभिर्ये स्म धर्मपरायणाः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2108618, "chapter_id": 3353, "verse_number": "", "content_sanskrit": "वासुकिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2108619, "chapter_id": 3353, "verse_number": "३", "content_sanskrit": "अयं शापो यथोत्सृष्टो विदितो वस्तथाऽनघाः ।\nतस्य शापस्य मोक्षार्थं मन्त्रयित्वा यतामहे \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2108620, "chapter_id": 3353, "verse_number": "५", "content_sanskrit": "सर्वेषामपि शापानां प्रतिघातो हि विद्यते\nन तु मात्राऽभिशप्तानां मोक्षो विद्येत पन्नगाः\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2108621, "chapter_id": 3353, "verse_number": "६", "content_sanskrit": "अव्ययस्याप्रमेयस्य सत्यस्य च तथाग्रतः ।\nशप्ता इत्येव मे श्रुत्वा जायते हृदि वेपथुः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2108622, "chapter_id": 3353, "verse_number": "७", "content_sanskrit": "नूनं सर्वविनाशोऽयमस्माकं समुदाहृतः ।\nन ह्यस्मान् सोऽव्ययो देवः शपन्तीं प्रत्यपेधयत्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2108623, "chapter_id": 3353, "verse_number": "८", "content_sanskrit": "तस्मात् सम्मन्त्रयामोऽद्य भुजङ्गानामनामयम् ।\nयथा भवेच्च सर्वेषां मा नः कालोऽत्यगादयम्\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2108624, "chapter_id": 3353, "verse_number": "९", "content_sanskrit": "अपि मन्त्रयमाणा हि हेतुं पश्याम मोक्षणे ।\nयथा नष्टं पुरा देवो गूढमग्निं गुहागतम् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2108625, "chapter_id": 3353, "verse_number": "१०", "content_sanskrit": "यथा स यज्ञो न भवेद् यथा चापि पराभवेत् ।\nजनमेजयस्य सर्पाणां विनाशकरणं हितम् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2108626, "chapter_id": 3353, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2108627, "chapter_id": 3353, "verse_number": "११", "content_sanskrit": "तथेत्युक्त्वा ततः सर्वे काद्रवेयाः समागताः ।\nसमयं चक्रिरे तत्र मन्त्रबुद्धिविशारदाः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2108628, "chapter_id": 3353, "verse_number": "१२", "content_sanskrit": "एके तत्राब्रुवन् नागा वयं भूत्वा द्विजोत्तमाः ।\nजनमेजयं तं भिक्षामो यज्ञस्ते न भवेदिति \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2108629, "chapter_id": 3353, "verse_number": "१३", "content_sanskrit": "अपरे त्वब्रुवन् नागास्तत्र पण्डितमानिनः ।\nमन्त्रिणोऽस्य वयं सर्वे भविष्यामः सुसत्तमाः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2108630, "chapter_id": 3353, "verse_number": "१४", "content_sanskrit": "स नः पृच्छति कार्येषु सर्वेष्वर्थविनिश्चयम् ।\nतत्र बुद्धिं प्रवक्ष्यामो यथा यज्ञो न वर्तते \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2108631, "chapter_id": 3353, "verse_number": "१५", "content_sanskrit": "स नो बहुमतान् राजा बुद्धौ बुद्धिमतां वरः ।\nयज्ञार्थं पृच्छति व्यक्तं नेति वक्ष्यामहे वयम् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2108632, "chapter_id": 3353, "verse_number": "१६", "content_sanskrit": "दर्शयन्तो बहून् दोषान् प्रेत्य चेह सुदारुणान् ।\nहेतुभिः कारणैश्चैव यथा यज्ञो भवेन्न सः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2108633, "chapter_id": 3353, "verse_number": "१७", "content_sanskrit": "अथवा य उपाध्यायो यज्ञे तस्य भविष्यति ।\nसर्पसत्रविधानज्ञो राजकार्यहिते रतः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2108634, "chapter_id": 3353, "verse_number": "१८", "content_sanskrit": "तं गत्वा दशतां कश्चिद् भुजगः स मरिष्यति ।\nतस्मिन् हते यज्ञकारे यज्ञौऽसौ न भविष्यति \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2108635, "chapter_id": 3353, "verse_number": "१९", "content_sanskrit": "ये चान्ये सर्पसत्रज्ञा भविष्यन्त्यत्र ऋत्विजः ।\nतान् सर्वान् वै दशिष्यामः क्रतुर्नैवं भविष्यति \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2108636, "chapter_id": 3353, "verse_number": "२०", "content_sanskrit": "तत्रापरे मन्त्रयन्ति धर्मात्मानो भुजङ्गमाः ।\nअबुद्धिरेषा युष्माकं ब्रह्महत्या न शोभना \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2108637, "chapter_id": 3353, "verse_number": "२१", "content_sanskrit": "सम्पत् सुधर्ममूला वै व्यसने शान्तिरुत्तमा ।\nअधर्मोत्तरता नाम व्यक्तं व्यापादते जगत् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2108638, "chapter_id": 3353, "verse_number": "२२", "content_sanskrit": "अपरे त्वब्रुवन् नागाः समिद्धं जातवेदसम् ।\nवर्षैर्निर्वापयिष्यामो मेघा भूत्वा सविद्युतः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2108639, "chapter_id": 3353, "verse_number": "२३", "content_sanskrit": "स्रुग्भाण्डान् निशि गत्वा चाप्यपरे भुजगोत्तमाः ।\nप्रमत्तानां हरन्त्वाशु विघ्न एवं भविष्यति \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2108640, "chapter_id": 3353, "verse_number": "२४", "content_sanskrit": "यज्ञे वा भुजगास्तस्मिन् शतशोऽथ सहस्रशः ।\nजनं दशन्तु वै सर्वमेवं त्रासो भविष्यति \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2108641, "chapter_id": 3353, "verse_number": "२५", "content_sanskrit": "अथवा संस्कृतं भोज्यं दूषयन्तु भुजङ्गमाः\nस्वेदमूत्रपुरीषेण सर्वभोज्यविनाशनम्\t ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2108642, "chapter_id": 3353, "verse_number": "२६", "content_sanskrit": "अपरे त्वब्रुवंस्तत्र ऋत्विजोऽस्य भवामहे ।\nयज्ञविघ्नं करिष्यामो दीयतां दक्षिणा इति\t ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2108643, "chapter_id": 3353, "verse_number": "२७", "content_sanskrit": "वश्यतां चागतोऽसौ नः करिष्यति यथेप्सितम् ।\nअपरे त्वब्रुवन् नागा जले प्रक्रीडितं नृपम्\t ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2108644, "chapter_id": 3353, "verse_number": "२८", "content_sanskrit": "गृहमानीय बध्नीमः क्रतुरेवं भवेन्न सः ।\nअपरे त्वब्रुवंस्तत्र नागाः दुष्कृतकारिणः\t ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2108645, "chapter_id": 3353, "verse_number": "२९", "content_sanskrit": "दशामैनं प्रगृह्याशु क्रतुर्नैव भविष्यति ।\nएषा नो नैष्ठिकी बुद्धिः सर्वेषामेव सम्मता\t ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2108646, "chapter_id": 3353, "verse_number": "३०", "content_sanskrit": "यथा वा मन्यसे राजंस्तत् क्षिप्रं संविधीयताम् ।\nइत्युक्त्वा समुदैक्षन्त वासुकिं पन्नगेश्वरम् ।\nवासुकिश्चापि सञ्चिन्त्य तानुवाच भुजङ्गमान् \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2108647, "chapter_id": 3353, "verse_number": "", "content_sanskrit": "वासुकिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2108648, "chapter_id": 3353, "verse_number": "३१", "content_sanskrit": "नैषा वो नैष्ठिकी बुद्धिर्मता कर्तुं भुजङ्गमाः ।\nसर्वेषामेव मे बुद्धिः पन्नगानां न रोचते \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2108649, "chapter_id": 3353, "verse_number": "३२", "content_sanskrit": "किं त्वत्र संविधातव्यं भवतां यद्धितं भवेत् ।\nअनेनाहं भृशं तप्ये गुणदोषौ मदाश्रितौ \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2108650, "chapter_id": 3353, "verse_number": "२०", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि द्वात्रिंशोऽध्यायः ॥३२॥ ॥ आस्तीकपर्वणि विंशोऽध्यायः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]