[{"id": 2005670, "chapter_id": 1111, "verse_number": "१-११२-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2005671, "chapter_id": 1111, "verse_number": "१-११२-१", "content_sanskrit": "ततः सत्यवती दीना कृपणा पुत्रगृद्धिनी।\nपुत्रस्य कृत्वा कार्याणि स्नुषाभ्यां सह भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2005672, "chapter_id": 1111, "verse_number": "१-११२-२", "content_sanskrit": "समाश्वास्य स्नुषे ते च भर्तृशोकनिपीडिते।\nधर्मं च पितृवंशं च मातृवंशं च भामिनी।\nप्रसमीक्ष्य महाभागा गाङ्गेयं वाक्यमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2005673, "chapter_id": 1111, "verse_number": "१-११२-३", "content_sanskrit": "दुःखार्दिता तु सा देवी मज्जन्ती शोकसागरे।\nशन्तनोर्धर्मनित्यस्य कौरव्यस्य यशस्विनः।\nत्वयि पिण्डश्च कीर्तिश्च संतानश्च प्रतिष्ठितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2005674, "chapter_id": 1111, "verse_number": "१-११२-४", "content_sanskrit": "भ्राता विचित्रवीर्यस्ते भूतानामन्तमेयिवान्।\nयथाकर्म शुभं कृत्वा स्वर्गोपगमनं ध्रुवम्।\nयथा चायुर्ध्रुवं सत्ये त्वयि धर्मस्तथा ध्रुवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2005675, "chapter_id": 1111, "verse_number": "१-११२-५", "content_sanskrit": "वेत्थ धर्मांश्च धर्मज्ञ समासेनेतरेण च।\nविविधास्त्वं श्रुतीर्वेत्थ वेदाङ्गानि च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2005676, "chapter_id": 1111, "verse_number": "१-११२-६", "content_sanskrit": "व्यवस्थानं च ते धर्मे कुलाचारं च लक्षये।\nप्रतिपत्तिं च कृच्छ्रेषु शुक्राङ्गिरसयोरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2005677, "chapter_id": 1111, "verse_number": "१-११२-७", "content_sanskrit": "तस्मात्सुभृशमाश्वस्य त्वयि धर्मभृतां वर।\nकार्ये त्वां विनियोक्ष्यामि तच्छ्रुत्वा कर्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2005678, "chapter_id": 1111, "verse_number": "१-११२-८", "content_sanskrit": "मम पुत्रस्तव भ्राता वीर्यवान्सुप्रियश्च ते।\nबाल एव गतः स्वर्गमपुत्रः पुरुषर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2005679, "chapter_id": 1111, "verse_number": "१-११२-९", "content_sanskrit": "इमे महिष्यौ भ्रातुस्ते काशिराजसुते शुभे।\nरूपयौवनसंपन्ने पुत्रकामे च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2005680, "chapter_id": 1111, "verse_number": "१-११२-१०", "content_sanskrit": "तयोरुत्पादयापत्यं सन्तानाय कुलस्य नः।\nमन्नियोगान्महाबाहो धर्मं कर्तुमिहार्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2005681, "chapter_id": 1111, "verse_number": "१-११२-११", "content_sanskrit": "राज्ये चैवाभिषिच्यस्व भारताननुशाधि च।\nदारांश्च कुरु धर्मेण मा निमज्जीः पितामहान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2005682, "chapter_id": 1111, "verse_number": "१-११२-१२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2005683, "chapter_id": 1111, "verse_number": "१-११२-१२", "content_sanskrit": "तथोच्यमानो मात्रा स सुहृद्भिश्च परन्तपः।\nइत्युवाचाथ धर्मात्मा धर्म्यमेवोत्तरं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2005684, "chapter_id": 1111, "verse_number": "१-११२-१३", "content_sanskrit": "असंशयं परो धर्मस्त्वया मातरुदाहृतः।\nत्वमपत्यं प्रति च मे प्रतिज्ञां वेत्थ वै परां॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2005685, "chapter_id": 1111, "verse_number": "१-११२-१४", "content_sanskrit": "जानासि च यथावृत्तं शुल्कहेतोस्त्वदन्तरे।\nस सत्यवति सत्यं ते प्रतिजानाम्यहं पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2005686, "chapter_id": 1111, "verse_number": "१-११२-१५", "content_sanskrit": "परित्यजेयं त्रैलोक्यं राज्यं देवेषु वा पुनः।\nयद्वाऽप्यधिकमेताभ्यां न तु सत्यं कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2005687, "chapter_id": 1111, "verse_number": "१-११२-१६", "content_sanskrit": "त्यजेच्च पृथिवी गन्धमापश्च रसमात्मनः।\nज्योतिस्तथा त्यजेद्रूपं वायुः स्पर्शगुणं त्यजेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2005688, "chapter_id": 1111, "verse_number": "१-११२-१७", "content_sanskrit": "प्रभां समुत्सृजेदर्को धूमकेतुस्तथोष्मताम्।\nत्यजेच्छब्दं तथाऽऽकाशं सोमः शीतांशुतां त्यजेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2005689, "chapter_id": 1111, "verse_number": "१-११२-१८", "content_sanskrit": "विक्रमं वृत्रहा जह्याद्धर्मं जह्याच्च धर्मराट्।\nन त्वहं सत्यमुत्स्रष्टुं व्यवसेयं कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2005690, "chapter_id": 1111, "verse_number": "१-११२-१९", "content_sanskrit": "तन्न जात्वन्यथा कुर्यां लोकानामपि संक्षये।\nअमरत्वस्य वा हेतोस्त्रैलोक्यस्य धनस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2005691, "chapter_id": 1111, "verse_number": "१-११२-२०", "content_sanskrit": "एवमुक्ता तु पुत्रेण भूरिद्रविणतेजसा।\nमाता सत्यवती भीष्ममुवाच तदनन्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2005692, "chapter_id": 1111, "verse_number": "१-११२-२१", "content_sanskrit": "जानामि ते स्थितिं सत्ये परां सत्यपराक्रम।\nइच्छन्सृजेथास्त्रींल्लोकानन्यांस्त्वं स्वेन तेजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2005693, "chapter_id": 1111, "verse_number": "१-११२-२२", "content_sanskrit": "जानामि चैवं सत्यं तन्मदर्थे यच्च भाषितम्।\nआपद्धर्मं त्वमावेक्ष्य वह पैतामहीं धुरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2005694, "chapter_id": 1111, "verse_number": "१-११२-२३", "content_sanskrit": "यथा ते कुलतन्तुश्च धर्मश्च न पराभवेत्।\nसुहृदश्च प्रहृष्येरंस्तथा कुरु परन्तप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2005695, "chapter_id": 1111, "verse_number": "१-११२-२४", "content_sanskrit": "आत्मनश्च हितं तात प्रियं च मम भारत।\nलालप्यमानां तामेवं कृपणां पुत्रगृद्धिनीम्।\nधर्मादपेतं ब्रुवतीं भीष्मो भूयोऽब्रवीदिदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2005696, "chapter_id": 1111, "verse_number": "१-११२-२५", "content_sanskrit": "राज्ञि धर्मानवेक्षस्व मा नः सर्वान्व्यनीनशः।\nसत्याच्च्युतिः क्षत्रियस्य न धर्मेषु प्रशस्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2005697, "chapter_id": 1111, "verse_number": "१-११२-२६", "content_sanskrit": "शान्तनोरपि संतानं यथा स्यादक्षयं भुवि।\nतत्ते धर्मं प्रवक्ष्यामि क्षात्रं राज्ञि सनातनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2005698, "chapter_id": 1111, "verse_number": "१-११२-२७", "content_sanskrit": "श्रुत्वा तं प्रतिपद्यस्व प्राज्ञैः सह पुरोहितैः।\nआपद्धर्मार्थकुशलैर्लोकतन्त्रमवेक्ष्य च॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2005699, "chapter_id": 1111, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि द्वादशाधिकशततमोऽध्यायः॥ ११२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]