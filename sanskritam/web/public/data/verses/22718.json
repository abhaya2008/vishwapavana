[{"id": 7002718000, "chapter_id": 22718, "verse_number": "९-३-१", "content_sanskrit": "युधिष्ठिर उवाच ।\nकीदृशी कृष्ण सा माया विष्णोरमिततेजसः ।\nयया व्यामोहितं यच्च जगदेतच्चराचरम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002718001, "chapter_id": 22718, "verse_number": "९-३-२", "content_sanskrit": "श्रीकृष्ण उवाच ।\nयेन द्वीपे पुरा विष्णुरास्ते चक्रगदाधरः ।\nवासुदेवः सगरुडः सचक्रश्च श्रिया सह ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002718002, "chapter_id": 22718, "verse_number": "९-३-३", "content_sanskrit": "नीलोत्पलदलश्यामः कुंडलाभ्यां विभूषितः ।\nभ्राजते मुकुटोद्द्योतकेयूरवनमालया ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002718003, "chapter_id": 22718, "verse_number": "९-३-४", "content_sanskrit": "तस्य द्रष्टुमथाभ्यागान्नारदो मुनिसत्तमः ।\nप्रणम्य स्तुतिभिर्द्देवं प्राहेदं विस्मयान्वितः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002718004, "chapter_id": 22718, "verse_number": "९-३-५", "content_sanskrit": "संशयं परिपृच्छामि भगवन्वक्तुमर्हसि ।\nका माया कीदृशी माया किंरूपा च कुतस्तथा ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002718005, "chapter_id": 22718, "verse_number": "९-३-६", "content_sanskrit": "तस्या दर्शय मे रूपं मायायाः पुरुषोत्तम ।\nया च मोहयते सर्वं त्रैलोक्यं सचराचरम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002718006, "chapter_id": 22718, "verse_number": "९-३-७", "content_sanskrit": "आब्रह्मस्तंबपर्यंतं सदेवासुरमानुषम् ।\nवैकुंठं वासुदेवं च प्रसादं कर्तुमर्हसि ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002718007, "chapter_id": 22718, "verse_number": "९-३-८", "content_sanskrit": "एवमुक्तस्तु मुनिना देवदेवो जनार्दनः ।\nप्रहस्योवाच देवर्षे न कार्यं मायया त्वया ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002718008, "chapter_id": 22718, "verse_number": "९-३-९", "content_sanskrit": "भूयोऽपि मोहयामास सोमग्राहेण नारदम् ।\nनारदोपि महाराज प्रोवाचेदं पुनः पुनः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002718009, "chapter_id": 22718, "verse_number": "९-३-१०", "content_sanskrit": "मायां दर्शय मे देव नान्यदस्ति प्रयोजनम् ।\nअथासौ विष्णुरुत्थाय श्वेतद्वीपं पुनर्ययौ ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002718010, "chapter_id": 22718, "verse_number": "९-३-११", "content_sanskrit": "अडुल्यग्रेण संगृह्य नारदं मुनि पुङ्गवम् ।\nततो मार्गगतश्चक्रे आत्मानं द्विजरूपिणम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002718011, "chapter_id": 22718, "verse_number": "९-३-१२", "content_sanskrit": "ऋग्वेदसदृशः साक्षाद्विष्णुर्ब्रह्मवदास्थितः ।\nवृद्धद्विजोत्तमवपुः संशयो नाल्पको भवत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002718012, "chapter_id": 22718, "verse_number": "९-३-१३", "content_sanskrit": "शिखी कमंडलुधृतो मृगचर्मोपवीतकः ।\nयज्ञशर्मेति संज्ञां च चक्रेऽसावात्मनः प्रभुः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002718013, "chapter_id": 22718, "verse_number": "९-३-१४", "content_sanskrit": "कृत्वापि कुशतंत्वग्रपवित्रकृत लक्षणम् ।\nआययौ स महीपृष्ठे जम्बूद्वीपं चचार ह ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002718014, "chapter_id": 22718, "verse_number": "९-३-१५", "content_sanskrit": "वैदिशं नाम नगरं वेत्रवत्यास्तटे शुभम् ।\nतस्मिन्सदोद्यमपरो धनधान्यस मृद्धिमान् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002718015, "chapter_id": 22718, "verse_number": "९-३-१६", "content_sanskrit": "गोमहिष्यजसंपूर्णं पाशुपाल्येन संस्थितः ।\nहलकर्मवृषासक्तो वैश्यजातिरनिंदितः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002718016, "chapter_id": 22718, "verse_number": "९-३-१७", "content_sanskrit": "गृहकर्मणि तन्निष्ठः सीरभद्र इति स्मृतः ।\nतस्यांतिके हरिः साक्षान्नारदेन सहागतः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002718017, "chapter_id": 22718, "verse_number": "९-३-१८", "content_sanskrit": "तेनाप्यासनसन्मानैः समर्थेन कृतादरौ ।\nप्रोक्तं केनाथ किं तुभ्यं साध्यमन्नं न साध्यते ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002718018, "chapter_id": 22718, "verse_number": "९-३-१९", "content_sanskrit": "न वास्मदीयं युष्माकं रोचतेन्नं ततो हरिः ।\nप्रहस्य प्रददौ तस्मै वरं द्विजवरो महत् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002718019, "chapter_id": 22718, "verse_number": "९-३-२०", "content_sanskrit": "उन्नाम्य वक्त्रं चोवाच देवसंस्तुतया गिरा ।\nसंतु ते बहवः पुत्राः क्षेत्रव्यापारबुद्धयः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002718020, "chapter_id": 22718, "verse_number": "९-३-२१", "content_sanskrit": "पशुपाशगृहासक्ताः शतार्द्धबलवाहनाः ।\nतेषां पुत्राश्च पौत्राश्च कृषि वृद्धिप्रवर्द्धकाः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002718021, "chapter_id": 22718, "verse_number": "९-३-२२", "content_sanskrit": "त्वञ्च वृत्तिशतैर्न्नित्यं वर्द्धस्व स्वजनावृतः ।\nइत्युक्त्वा स जगन्नाथो वासुदेवः सनारदः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002718022, "chapter_id": 22718, "verse_number": "९-३-२३", "content_sanskrit": "क्षेत्रे गोस्वामिनामानं द्विजं ददृशतुश्च तौ ।\nदरिद्रं हलकर्मार्त्तं मेथ्याद्योपस्करार्दितम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002718023, "chapter_id": 22718, "verse_number": "९-३-२४", "content_sanskrit": "भागीरथ्यास्तटे रम्ये वेणिकाग्रामसन्निधौ ।\nतृणगुल्मलताच्छन्नक्षेत्रे चिंताकुलो हि सः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002718024, "chapter_id": 22718, "verse_number": "९-३-२५", "content_sanskrit": "ताभ्यां संप्रार्थितो विप्रो भोज्यं प्रादाच्च किंचन ।\nसकाशं तव संप्राप्तौ दूरादतिथिधर्मिणौ ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002718025, "chapter_id": 22718, "verse_number": "९-३-२६", "content_sanskrit": "इत्युक्तोऽसौ द्विजश्रेष्ठो हलकर्म विधाय तत् ।\nआजगाम गृहं तूर्णं ताभ्यां सह ससंभ्रमम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002718026, "chapter_id": 22718, "verse_number": "९-३-२७", "content_sanskrit": "चक्रे चैवादरं भक्त्या स्वयमासनसत्क्रियाम् ।\nपादशौचं तथाभ्यंगं कृत्वात्र च सुसंस्कृतम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002718027, "chapter_id": 22718, "verse_number": "९-३-२८", "content_sanskrit": "सह पत्न्या सतनयो भोज्यं भुक्तिं चकार सः ।\nभुक्तभोज्यौ च शर्वर्यां सुखं सुप्तौ निशात्यये ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002718028, "chapter_id": 22718, "verse_number": "९-३-२९", "content_sanskrit": "प्रयातौ ददतुः श्रेष्ठं वरं तस्मै द्विजातये ।\nमा ते भवतु गोस्वामिन्कदाचिदपि कर्षणम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002718029, "chapter_id": 22718, "verse_number": "९-३-३०", "content_sanskrit": "मा धान्यं मखसंतान मत्प्रसादाद्विजोत्तम ।\nइत्युक्त्वा जग्मतुस्तूर्णं पुनः पप्रच्छ नारदः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002718030, "chapter_id": 22718, "verse_number": "९-३-३१", "content_sanskrit": "किमिदं वद देवेश शापरूपो वरस्त्वया ।\nभद्र गोस्वामिने दत्तः किं च वैश्ये तथाविधः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002718031, "chapter_id": 22718, "verse_number": "९-३-३२", "content_sanskrit": "इत्युक्तः प्राह देवेशः शृणु नारद मद्वचः ।\nपरमार्थं प्रवक्ष्येऽहं तव संशयकर्तनम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002718032, "chapter_id": 22718, "verse_number": "९-३-३३", "content_sanskrit": "संवत्सरेण यत्पापं मत्स्यघाती समाचरेत् ।\nतदह्ने केन कुरुते लांगली नात्र संशयः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002718033, "chapter_id": 22718, "verse_number": "९-३-३४", "content_sanskrit": "अतोऽर्थं कृषिपाल्येन नरकं याति लांगली ।\nतदभावान्न कल्पः स्यात्तेन मोक्षो मयि ध्रुवम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002718034, "chapter_id": 22718, "verse_number": "९-३-३५", "content_sanskrit": "मयि भुक्ते प्रसन्ने वा को विशेषोऽस्य नारद ।\nयदि स्वर्गोऽथ वा मोक्षो न संपद्येत तद्वृथा ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002718035, "chapter_id": 22718, "verse_number": "९-३-३६", "content_sanskrit": "इदानीं हलकालुष्यैः सीरभद्रो विचेष्टितैः ।\nबहुपापप्रसंगेन घोरं नरकमेष्यति ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002718036, "chapter_id": 22718, "verse_number": "९-३-३७", "content_sanskrit": "सपुत्रपौत्रसंतानो हृतोर्थस्तद्गृहे मया ।\nन भुक्तं न च विश्रान्तं विश्रांतं द्विजवेश्मनि ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002718037, "chapter_id": 22718, "verse_number": "९-३-३८", "content_sanskrit": "सोऽपि द्विजो मुनिश्रेष्ठ संसारादुत्तरिष्यति ।\nइत्येवं संवदंतौ च जग्मतुर्मार्गमुत्तमम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002718038, "chapter_id": 22718, "verse_number": "९-३-३९", "content_sanskrit": "कान्यकुब्जस्य सामीप्ये सरः श्रेष्ठमपश्यताम् ।\nहंसकारण्ड वाकीर्णं चक्रवाकोपशोभितम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002718039, "chapter_id": 22718, "verse_number": "९-३-४०", "content_sanskrit": "पद्मिनीजलकह्लाररक्तोत्पलसितोत्पलैः ।\nछादितं पद्मिनीपत्रैर्मत्स्यैः कूर्मैर्ज्जलोद्भवैः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002718040, "chapter_id": 22718, "verse_number": "९-३-४१", "content_sanskrit": "तटै रम्यैर्घनैर्वृक्षैः केतकीखण्डमंडितम् ।\nकेतकीकुसुमामोदैर्ल्लकुचैस्तटमंडितैः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002718041, "chapter_id": 22718, "verse_number": "९-३-४२", "content_sanskrit": "दात्यूहशिखिभारुण्डचकोराद्यैश्च संकुलम् ।\nकुरवैश्चातकै रम्यं केकाकुलनिनादितम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002718042, "chapter_id": 22718, "verse_number": "९-३-४३", "content_sanskrit": "जलकुक्कुटसंगीतं हंससारसशोभितम् ।\nजीवंजीवकहारीतचकोरैरुपशोभितम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002718043, "chapter_id": 22718, "verse_number": "९-३-४४", "content_sanskrit": "वशिष्ठस्य मुनेर्नाम्ना विख्यातं श्रीमहोदयम् ।\nअस्मिन्नद्य प्रवेष्टव्यं महाजनविवेकिनाम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002718044, "chapter_id": 22718, "verse_number": "९-३-४५", "content_sanskrit": "स्थातव्यं पुरतस्तेषां तस्मात्स्नानं समाचरेत् ।\nइत्युक्त्वा केशवः पापं सस्नौ प्रागेव तज्जलैः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002718045, "chapter_id": 22718, "verse_number": "९-३-४६", "content_sanskrit": "यत्तीर्थलोकं विख्यातं स्नात्वा तीरं समाश्रितः ।\nप्रहरे वासुदेवस्य नारदोऽपि मुदा युतः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002718046, "chapter_id": 22718, "verse_number": "९-३-४७", "content_sanskrit": "आचम्य सस्नौ तीर्थेन क्षणात्तीर्थमवाप्य च ।\nयावदुत्तिष्ठते तोयात्स्नात्वा ऋषिरुदारधीः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002718047, "chapter_id": 22718, "verse_number": "९-३-४८", "content_sanskrit": "तावत्स्त्रीत्वं समापन्नो नारदः केन वर्ण्यते ।\nयस्यास्तु विस्तृते नेत्रे वक्त्रं चन्द्रोपमं शुभम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002718048, "chapter_id": 22718, "verse_number": "९-३-४९", "content_sanskrit": "स्मरपाशोपमौ कर्णौ कपोलौ कनकोज्ज्वलौ ।\nनासिका तिलसूनेन कामचापोपमे भ्रुवौ ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002718049, "chapter_id": 22718, "verse_number": "९-३-५०", "content_sanskrit": "दशना हीरकैस्तुल्या विद्रुमाभः शुभाधरः ।\nमयूरस्य कलापेन तुल्य कचनिबंधनम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7002718050, "chapter_id": 22718, "verse_number": "९-३-५१", "content_sanskrit": "शंखरेखात्रयेणैव कंठदेशो विराजते ।\nमाधवीलतया तुल्यौ मंजू तस्या भुजौ शुभौ ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7002718051, "chapter_id": 22718, "verse_number": "९-३-५२", "content_sanskrit": "युतौ रक्तोत्पलाभासौ पाणी रक्तनखांगुली ।\nपीनावतुंगतनुधृत्कठिनौ कलशोपमौ ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7002718052, "chapter_id": 22718, "verse_number": "९-३-५३", "content_sanskrit": "स्तनावविरलौ स्निग्धौ चक्रवाकयुगोपमौ ।\nस्वल्पकं मध्यदेशं तु मुष्टिग्राह्यमसंशयम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7002718053, "chapter_id": 22718, "verse_number": "९-३-५४", "content_sanskrit": "नाभिमंडलगांभीर्यं लावण्यं केन वर्ण्यते ।\nवलित्रयेण विकृता रोमराजिर्विराजिता ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7002718054, "chapter_id": 22718, "verse_number": "९-३-५५", "content_sanskrit": "नयने च पुनस्तस्या मृग्या इव सुशोभने ।\nनितंबो बिंबफलका मन्मथायतनं शुभम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7002718055, "chapter_id": 22718, "verse_number": "९-३-५६", "content_sanskrit": "रंभायुग्मोपमावूरू स्मरबाणनिबंधनौ ।\nविपरीतरतायासखेदभारसहौ दृढौ ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7002718056, "chapter_id": 22718, "verse_number": "९-३-५७", "content_sanskrit": "नवकुन्दलतासारसरलं सनिबंधनम् ।\nजंघायुगं महाराज गूढगुल्फ युगं तथा ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7002718057, "chapter_id": 22718, "verse_number": "९-३-५८", "content_sanskrit": "रक्तांगुलीलतातल्पनखचन्द्रकयाचितम् ।\nचरणारविंदयुगलं सरक्तं सुप्रतिष्ठितम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7002718058, "chapter_id": 22718, "verse_number": "९-३-५९", "content_sanskrit": "सैवंविधा तदा नारी सर्वलक्षणपू जिता ।\nबभूव क्षणमात्रेण जगद्व्यामोहकारिणी ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7002718059, "chapter_id": 22718, "verse_number": "९-३-६०", "content_sanskrit": "क्षीरोदमथनोत्तीर्णा लक्ष्मीमन्याभिवोच्छ्रिताम् ।\nदृष्ट्वाप्यदर्शनं प्राप्तो मायया मधुसूदनः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7002718060, "chapter_id": 22718, "verse_number": "९-३-६१", "content_sanskrit": "संप्राप्यते च सा कालसंगराहारिणी यथा ।\nआस्त एकाकिनी मुग्धा कुर्याद्दिगवलोकनम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7002718061, "chapter_id": 22718, "verse_number": "९-३-६२", "content_sanskrit": "अथाजगाम तं देशं नाम्ना तालध्वजो नृपः ।\nसह सैन्यैः परिवृतः पुरंदर इवामरैः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7002718062, "chapter_id": 22718, "verse_number": "९-३-६३", "content_sanskrit": "गजारूढैर्हयारूढै रथारूढैर्नरोत्तमैः ।\nविमानयानयुग्मस्थैस्तथांतःपुरिकाजनैः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7002718063, "chapter_id": 22718, "verse_number": "९-३-६४", "content_sanskrit": "ध्वजातपत्रकलिलैरनीकैः परिवारितः ।\nतेन सा सहसा दृष्टा नारी कमललोचना ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7002718064, "chapter_id": 22718, "verse_number": "९-३-६५", "content_sanskrit": "बभूव क्षणमात्रेण कंदर्पशरपीडितः ।\nकेयं कस्य कुतः प्राप्ता किं देवी वाथ मानुषी ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7002718065, "chapter_id": 22718, "verse_number": "९-३-६६", "content_sanskrit": "अदृष्टरूपाप्सरसा काचिद्देवी समागता ।\nअहोरूपं सुरूपाया गोचरे परितः पुमान् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7002718066, "chapter_id": 22718, "verse_number": "९-३-६७", "content_sanskrit": "मुमूर्षुर्जायते मोहादनुदिग्धहतो यथा ।\nइति संचिन्त्य हृदये राजा तालध्वजोऽन्तिके ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7002718067, "chapter_id": 22718, "verse_number": "९-३-६८", "content_sanskrit": "उवाच नारीं मुग्धां तां शृणु मद्वचनं शुभे ।\nका त्वं कस्य कुतः प्राप्ता देशमेतं शुचिस्मिते ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7002718068, "chapter_id": 22718, "verse_number": "९-३-६९", "content_sanskrit": "इत्युक्ते साश्रु चार्वंगी प्राह मां विद्ध्ययोनिजाम् ।\nपित्रा मात्रा विहीनां च तथाद्यापि कुमारिकाम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7002718069, "chapter_id": 22718, "verse_number": "९-३-७०", "content_sanskrit": "निराश्रयां विदित्वैनां ततो जातः स्मरार्दितः ।\nआरोप्य हयपृष्ठे तां ततो राजागतो गृहम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7002718070, "chapter_id": 22718, "verse_number": "९-३-७१", "content_sanskrit": "नीत्वा विवाहयामास शास्त्रोक्तविधिना ततः ।\nरेमे प्रासादशृंगाग्रे पर्यंके सितया तया ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7002718071, "chapter_id": 22718, "verse_number": "९-३-७२", "content_sanskrit": "उद्यानभव्यभूमीषु नदीनां पुलिनेषु च ।\nपर्वतानां नितंबेषु निर्झरेषु गुहासु च ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7002718072, "chapter_id": 22718, "verse_number": "९-३-७३", "content_sanskrit": "पद्मखंडेषु फुल्लेषु शोभितेषु सरस्सु च ।\nप्रयागादिषु तीर्थेषु नदीनामाश्रमेषु च ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7002718073, "chapter_id": 22718, "verse_number": "९-३-७४", "content_sanskrit": "दिव्यावसथरम्येषु वेलाकूलेषु पार्थिवः ।\nयावद्द्वादश वर्षाणि एकाहमपि भारत ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7002718074, "chapter_id": 22718, "verse_number": "९-३-७५", "content_sanskrit": "ततस्त्रयोदशे वर्षे तस्या गर्भोऽभवन्महान् ।\nएतस्मिन्गर्भसंपूर्णे जातं दीर्घमलाबुकम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7002718075, "chapter_id": 22718, "verse_number": "९-३-७६", "content_sanskrit": "तद्भेदाहतकुंभेषु बीजप्रारोहणान्नराः ।\nबभूवुर्द्धातुशून्या वै दिव्यदेहबलोत्कटाः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7002718076, "chapter_id": 22718, "verse_number": "९-३-७७", "content_sanskrit": "पंचाशत्संख्यया जाता उपसर्गादिवर्जिताः ।\nआरूढयौवनाः सर्वे सुताः संग्रामकोविदाः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7002718077, "chapter_id": 22718, "verse_number": "९-३-७८", "content_sanskrit": "तेषां पुत्राश्च पौत्राश्च बभूवुः सुरसत्तमाः ।\nयुयुधुः शरसंघातैश्चक्रशूलासिपट्टिशैः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7002718078, "chapter_id": 22718, "verse_number": "९-३-७९", "content_sanskrit": "हयैरन्यैर्गजैरन्यैः क्रोधांधाः कौरवा इव ।\nपांडवैः सह संग्रामे युयुधुः क्षयमंजसा ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7002718079, "chapter_id": 22718, "verse_number": "९-३-८०", "content_sanskrit": "सपदातिगजारोहाः सांतःपुरयुगेच्छया ।\nविनेशुरब्धिमासाद्य सिंधूनां प्रवहा इव ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7002718080, "chapter_id": 22718, "verse_number": "९-३-८१", "content_sanskrit": "सासिसबलविस्ताराः सदर्पाः समहोच्छ्रयाः ।\nइन्द्रलोकोपमं सर्वं कुलं नष्टं क्षणं तदा ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7002718081, "chapter_id": 22718, "verse_number": "९-३-८२", "content_sanskrit": "संदृश्य नारदीयैषा विनष्टं स्वकुलं रणे ।\nरुरोद स्नेहसंयुक्तै रसैः कलुषया गिरा ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7002718082, "chapter_id": 22718, "verse_number": "९-३-८३", "content_sanskrit": "हा दैव हा विधे पाप हा कृतान्त नमस्कृत ।\nदर्शयित्वा विधानं मे पुनर्नेत्रे हृते त्वया ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7002718083, "chapter_id": 22718, "verse_number": "९-३-८४", "content_sanskrit": "इत्युक्त्वा स्वमुरोहस्तैर्जघान भृशदुःखिता ।\nभूमौ मूर्च्छातुरा भूत्वा पुनः प्राप्ता विचेतनम् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7002718084, "chapter_id": 22718, "verse_number": "९-३-८५", "content_sanskrit": "सोऽपि राजा विषण्णोऽसौ निर्विण्णः शोकसागरे ।\nभूमौ निपतितो दुःखाद्रुरोद भृशदुःखितः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7002718085, "chapter_id": 22718, "verse_number": "९-३-८६", "content_sanskrit": "विषण्णो मंत्रिभिः सार्धं वृद्धशोकेन संयुतः ।\nएतस्मिन्नंतरे विष्णुराजगाम द्विजैः सह ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7002718086, "chapter_id": 22718, "verse_number": "९-३-८७", "content_sanskrit": "द्विजवेषपरिच्छन्न उपविष्टः सुखासने ।\nततः पुरस्सरो भूत्वा चक्रे धर्मार्थदर्शनम् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7002718087, "chapter_id": 22718, "verse_number": "९-३-८८", "content_sanskrit": "किं रोदनेन बहुना युवयोः क्लेशकारिणा ।\nश्रूयतां विष्णुमायैषा स्वप्नदृष्टधनोपमा ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7002718088, "chapter_id": 22718, "verse_number": "९-३-८९", "content_sanskrit": "शोभने यादृशः शोकः कृतः संसारसागरे ।\nसर्वेषामेव भूतानां परिणामोयमीदृशः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7002718089, "chapter_id": 22718, "verse_number": "९-३-९०", "content_sanskrit": "पुरंदरसहस्राणि चक्रवर्तिशतानि च ।\nनिर्वापितानि कालेन प्रदीप इव वायुना ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7002718090, "chapter_id": 22718, "verse_number": "९-३-९१", "content_sanskrit": "येऽपि शोषयितुं शक्ताः समुद्रं ग्राहसंकुलम् ।\nकुर्युश्च करयुग्मेन चूर्णं मेरुं महीतले ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7002718091, "chapter_id": 22718, "verse_number": "९-३-९२", "content_sanskrit": "ऊद्धर्तुं धरणीसंज्ञां ग्रहीतुं चन्द्रभास्करौ ।\nप्रविष्टास्ते तु कालेन कृतांतवदनं तदा ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7002718092, "chapter_id": 22718, "verse_number": "९-३-९३", "content_sanskrit": "दुर्गस्त्रिकूटः परिखाः समुद्रा रक्षांसि योधा धनदाच्च वित्तम् ।\nमंत्रश्च यस्यौशनसा प्रणीतः स रावणो दैववशाद्विषण्णः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7002718093, "chapter_id": 22718, "verse_number": "९-३-९४", "content_sanskrit": "संग्रामे गजतुरगसमाकुलेऽपि वादादग्नौ वा गतविवरे महोदधौ वा ।\nसर्वैर्वा सह वसतामुदीर्णकोपैर्नाभाव्यो भवति कदाचिदेव नाशः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7002718094, "chapter_id": 22718, "verse_number": "९-३-९५", "content_sanskrit": "पातालमाविशतु यातु सुरेन्द्रलोकमारोहतु क्षितिधराधिपतिं सुमेरुम् ।\nमंत्रौषधिप्रहरणैश्च करोतु रक्षां यद्भावि तद्भवति नाथ विभावितोऽस्मि ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7002718095, "chapter_id": 22718, "verse_number": "९-३-९६", "content_sanskrit": "रोदिति कश्चिदथाश्रुधौताननगुरुतरशोकविह्वलः ।\nप्रविकटचरणवानपि नृत्यति कश्चिद्धर्मादिविग्रहः ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7002718096, "chapter_id": 22718, "verse_number": "९-३-९७", "content_sanskrit": "गायति हृदयहारि सुखनिर्भरमायतविस्तृताऽधरोऽधिकम् ।\nसार एष रंगोदरगतनटपटहाकाम एवायम् ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7002718097, "chapter_id": 22718, "verse_number": "९-३-९८", "content_sanskrit": "इत्येवं धर्ममुद्दिश्य विष्णुः संसारचेष्टितम् ।\nतूष्णीं बभूवानुपदं ततस्ते द्विजपुङ्गवाः ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7002718098, "chapter_id": 22718, "verse_number": "९-३-९९", "content_sanskrit": "उत्तिष्ठ स्नाहि पुत्राणां प्रकुरुष्वौर्ध्वदेहिकम् ।\nमा शोकं विष्णुमायैषा विष्णुना निर्मिता स्वयम् ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7002718099, "chapter_id": 22718, "verse_number": "९-३-१००", "content_sanskrit": "इत्युक्ता चारुसर्वांगी स बभूवाचलः पुमान् ।\nस एष सदृशाकारो नारदस्तत्क्षणेऽभवत् ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7002718100, "chapter_id": 22718, "verse_number": "९-३-१०१", "content_sanskrit": "सोऽपि राजा ददर्शाथ तं समंत्रिपुरोहितः ।\nसांतःपुरमिदं सर्वमिंद्रजालोपमं क्षणात् ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7002718101, "chapter_id": 22718, "verse_number": "९-३-१०२", "content_sanskrit": "नारदं मुनिशार्दूलं जटाभारभयानकम् ।\nगौरवर्णं ज्वलंतं च ब्राहम्या लक्ष्म्या विराजितम् ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7002718102, "chapter_id": 22718, "verse_number": "९-३-१०३", "content_sanskrit": "शिखा कमण्डलुधरं वीणादण्डकरं तथा ।\nब्रह्मसूत्रेण शुभ्रेण कौपीनाच्छादनेन च ।\nपादुकाभ्यां स्थितं तीरे सरसो ब्राह्मणासने ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7002718103, "chapter_id": 22718, "verse_number": "९-३-१०४", "content_sanskrit": "संप्रगृह्य कराग्रेण जगामादर्शनं हरिः ।\nअम्बरेण सुरैः सार्द्धं तस्माद्देशाद्युधिष्ठिर ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7002718104, "chapter_id": 22718, "verse_number": "९-३-१०५", "content_sanskrit": "श्वेतद्वीपमथासाद्य प्राह देवो मुनिं नृप ।\nदेवर्षे यत्त्वया पृष्टं पूर्वं मायाकथां प्रति ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7002718105, "chapter_id": 22718, "verse_number": "९-३-१०६", "content_sanskrit": "माया ययेदृशी माया यत्स्वरूपा यदात्मिका ।\nसा ते माया मया ब्रह्मन्वैष्णवी संप्रदर्शिता ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7002718106, "chapter_id": 22718, "verse_number": "९-३-१०७", "content_sanskrit": "एवमुक्त्वा मुनिवरं देवदेवो जनार्दनः ।\nबभूवान्तर्हितस्सद्यो देवर्षेस्तस्य पश्यतः ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}]