[{"id": 2075559, "chapter_id": 2599, "verse_number": "१२-१०४-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2075560, "chapter_id": 2599, "verse_number": "१२-१०४-१", "content_sanskrit": "धार्मिकोऽर्थानसंप्राप्य राजामात्यैः प्रबाधितः।\nच्युतः कोशाच्च दण्डाच्च सुखमिच्छन्कथं चरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2075561, "chapter_id": 2599, "verse_number": "१२-१०४-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2075562, "chapter_id": 2599, "verse_number": "१२-१०४-२", "content_sanskrit": "अत्रायं क्षेमदर्शीय इतिहासोऽनुगीयते।\nतत्तेऽह संप्रवक्ष्यामि तन्निबोध युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2075563, "chapter_id": 2599, "verse_number": "१२-१०४-३", "content_sanskrit": "क्षेमदर्शी नृपसुतो यत्र क्षीणबलः पुरा।\nमुनिं कालकवृक्षीयमाजमामेति नः श्रुतम्।\nतं पप्रच्छानुसंगृह्य कृच्छ्रामापदमास्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2075564, "chapter_id": 2599, "verse_number": "१२-१०४-४", "content_sanskrit": "अर्थेषु मागी पुरुष ईहमानः पुनः पुनः।\nअलब्ध्वा मद्विधो राज्यं ब्रह्मन्किं कर्तुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2075565, "chapter_id": 2599, "verse_number": "१२-१०४-५", "content_sanskrit": "अन्यत्र मरणाद्दैन्यादन्यत्र परसंश्रयात्।\nक्षुद्रादन्यत्र चाचारात्तन्ममाचक्ष्व सत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2075566, "chapter_id": 2599, "verse_number": "१२-१०४-६", "content_sanskrit": "व्याधिनां चाभिपन्नस्य मानसेनेतरेण वा।\nबहुश्रुतः कृतप्रज्ञस्त्वद्विधः शरणं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2075567, "chapter_id": 2599, "verse_number": "१२-१०४-७", "content_sanskrit": "निर्विद्य हि नरः कामान्नियम्य सुखमेधते।\nत्वक्त्वा प्रीतिं च शोकं च लब्ध्वा बुद्धिमयं वसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2075568, "chapter_id": 2599, "verse_number": "१२-१०४-८", "content_sanskrit": "सुखमर्थाश्रयं येषामनुशोचामि तानहम्।\nमम ह्यर्थाः सुबहवो नष्टाः स्वप्नगता इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2075569, "chapter_id": 2599, "verse_number": "१२-१०४-९", "content_sanskrit": "दुष्करं बत कुर्वन्ति महतोऽर्थांस्त्यजन्ति ये।\nवयं त्वेतान्परित्यक्तुमसतोऽपि न शक्नुमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2075570, "chapter_id": 2599, "verse_number": "१२-१०४-१०", "content_sanskrit": "इमामवस्थां संप्राप्तं दीनमार्तं श्रिया च्युतम्।\nयदन्यत्सुखमस्तीह तद्ब्रह्मन्ननुशाधि माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2075571, "chapter_id": 2599, "verse_number": "१२-१०४-११", "content_sanskrit": "कौसल्येनैवमुक्तस्तु राजपुत्रेण धीमता।\nमुनिः कालकवृक्षीयः प्रत्युवाच महाद्युतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2075572, "chapter_id": 2599, "verse_number": "१२-१०४-१२", "content_sanskrit": "पुरस्तादेव ते बुद्धिरियं कार्या विजानतः।\nअनित्यं सर्वमेवैतदहं च मम चास्ति यत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2075573, "chapter_id": 2599, "verse_number": "१२-१०४-१३", "content_sanskrit": "यत्किंचिन्मन्यसेऽस्तीति सर्वं नास्तीति विद्धि तत्।\nएवं न व्यथते प्राज्ञः कृच्छ्रामप्यापदं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2075574, "chapter_id": 2599, "verse_number": "१२-१०४-१४", "content_sanskrit": "यद्धि भूतं भविष्यच्च ध्रुवं तन्न भविष्यति।\nएवं विदितवेद्यस्त्वमनर्थेभ्यः प्रमोक्ष्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2075575, "chapter_id": 2599, "verse_number": "१२-१०४-१५", "content_sanskrit": "ये च पूर्वसमारम्भा ये च पूर्वतरे परे।\nसर्वं नास्तीति ते चैव तज्ज्ञात्वा को नु संज्वरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2075576, "chapter_id": 2599, "verse_number": "१२-१०४-१६", "content_sanskrit": "भूत्वा च न भवत्येतदभूत्वा च भविष्यति।\nशोके न ह्यस्ति सामर्थ्यं शोचेत स कथं नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2075577, "chapter_id": 2599, "verse_number": "१२-१०४-१७", "content_sanskrit": "क्वनु तेऽद्य पिता राजन्क्वनु तेऽद्य पितामहः।\nन त्वं पश्यसि तानद्य न त्वां पश्यन्ति तेऽपि वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2075578, "chapter_id": 2599, "verse_number": "१२-१०४-१८", "content_sanskrit": "आत्मनोऽध्रुवतां पश्यंस्तांस्त्वं किमनुशोचसि।\nबुद्ध्या चैवानुबुद्ध्यस्व ध्रुवं हि न च विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2075579, "chapter_id": 2599, "verse_number": "१२-१०४-१९", "content_sanskrit": "अहं च त्वं च नृपते सुहृदः शत्रवश्च ते।\nअवश्यं न भविष्यामः सर्वं च न भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2075580, "chapter_id": 2599, "verse_number": "१२-१०४-२०", "content_sanskrit": "ये तु विंशतिवर्षा वै त्रिंशद्वर्षाश्च मानवाः।\nअर्वागेव हि ते सर्वे मरिष्यन्ति शरच्छतात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2075581, "chapter_id": 2599, "verse_number": "१२-१०४-२१", "content_sanskrit": "अपि चेन्महतो वित्तान्न प्रमुच्यते पूरुषः।\nनैतन्ममेति तन्मत्वा कुर्वीत प्रियमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2075582, "chapter_id": 2599, "verse_number": "१२-१०४-२२", "content_sanskrit": "अनागतं यन्न ममेति विद्या\nदतिक्रान्तं यन्न ममेति विद्यात्।\nदिष्टं बलीय इति मन्यमाना\nस्ते पण्डितास्तत्सतां वृत्तिमाहुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2075583, "chapter_id": 2599, "verse_number": "१२-१०४-२३", "content_sanskrit": "अनाढ्याश्चापि जीवन्ति राज्यं चाप्यनुशासते।\nबुद्धिपौरुषसंपन्नास्त्वया तुल्याधिका जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2075584, "chapter_id": 2599, "verse_number": "१२-१०४-२४", "content_sanskrit": "न च त्वमिव शोचन्ति तस्मात्त्वमपि मा शुचः।\nकिं न त्वं तैर्नरैः श्रेयांस्तुल्यो वा बुद्धिपौरुषैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2075585, "chapter_id": 2599, "verse_number": "१२-१०४-२५x", "content_sanskrit": "राजोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2075586, "chapter_id": 2599, "verse_number": "१२-१०४-२५", "content_sanskrit": "यादृच्छिकं सर्वमासीत्तद्राज्यमिति चिन्तये।\nह्रियते सर्वमेवेदं कालेन महता द्विज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2075587, "chapter_id": 2599, "verse_number": "१२-१०४-२६", "content_sanskrit": "तस्यैव ह्रियमाणस्य स्रोतसेव तपोधन।\nफलमेतत्प्रपश्यामि यथालब्धेन वर्तयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2075588, "chapter_id": 2599, "verse_number": "१२-१०४-२७x", "content_sanskrit": "मुनिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2075589, "chapter_id": 2599, "verse_number": "१२-१०४-२७", "content_sanskrit": "अनागतमतीतं च याथातथ्यविनिश्चयात्।\nनानुशोचेत कौसल्य सर्वार्थेषु तथा भव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2075590, "chapter_id": 2599, "verse_number": "१२-१०४-२८", "content_sanskrit": "अवाप्यान्कामयन्नर्थान्नानवाप्यान्कदाचन।\nप्रत्युत्पन्नाननुभवन्मा शुचस्त्वमनागतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2075591, "chapter_id": 2599, "verse_number": "१२-१०४-२९", "content_sanskrit": "यथालब्धोपपन्नार्थैस्तथा कौसल्य रंस्यसे।\nकच्चिच्छुद्धस्वभावेन श्रिया हीनो न शोचसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2075592, "chapter_id": 2599, "verse_number": "१२-१०४-३०", "content_sanskrit": "पुरस्ताद्भूतपूर्वत्वाद्धीनभोग्यो हि दुर्मतिः।\nधातारं गर्हते नित्यं लब्धार्थश्च न मृष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2075593, "chapter_id": 2599, "verse_number": "१२-१०४-३१", "content_sanskrit": "अनर्हानपि चैवान्यान्मन्यते श्रीमतो जनान्।\nएतस्मात्कारणादेतद्दुःखं भूयोऽनुवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2075594, "chapter_id": 2599, "verse_number": "१२-१०४-३२", "content_sanskrit": "ईर्ष्याभिमानसंपन्ना राजन्पुरुषमानिनः।\nकच्चित्त्वं न तथा प्राज्ञ मत्सरी कोसलाधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2075595, "chapter_id": 2599, "verse_number": "१२-१०४-३३", "content_sanskrit": "सहस्व श्रियमन्येषां यद्यपि त्वयि नास्ति सा।\nअन्यत्रापि सतीं लक्ष्मीं कुशला भुञ्जते नराः।\nअभिनिष्यन्दते देही श्रीभूतश्च द्विषज्जनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2075596, "chapter_id": 2599, "verse_number": "१२-१०४-३४", "content_sanskrit": "श्रियं च पुत्रपौत्रं च मनुष्या धर्मचारिणः।\nत्यागधर्मविदो धीराः स्वयमेव त्यजन्त्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2075597, "chapter_id": 2599, "verse_number": "१२-१०४-३५", "content_sanskrit": "`त्यक्तं स्वायंभुवे वंशे शुभेन भरतेन च।\nनानारत्नसमाकीर्णं राज्यं स्फीतमिति श्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2075598, "chapter_id": 2599, "verse_number": "१२-१०४-३६", "content_sanskrit": "तथाऽन्यैर्भूमिपालैश्च त्यक्तं राज्यं महोदयम्।\nत्यक्त्वा राज्यानि ते सर्वे वने वन्यफलाशिनः।\nगताश्च तपसः पारं दुःखस्यान्तं च भूमिपा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2075599, "chapter_id": 2599, "verse_number": "१२-१०४-३७", "content_sanskrit": "बहुसंकुसुकं दृष्ट्वा विधित्सासाधनेन च।\nतथान्ये संत्यजन्त्येव मत्वा परमदुर्लभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2075600, "chapter_id": 2599, "verse_number": "१२-१०४-३८", "content_sanskrit": "त्वं पुनः प्राज्ञरूपः सन्कृपणं परितप्यसे।\nअकाम्यान्कामयानोऽर्थान्पराधीनानुपद्रवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2075601, "chapter_id": 2599, "verse_number": "१२-१०४-३९", "content_sanskrit": "तां बुद्धिमनुविज्ञाय त्वमेवैनान्परित्यज।\nअनर्थाश्चार्थरूपेण ह्यर्थाश्चानर्थरूपिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2075602, "chapter_id": 2599, "verse_number": "१२-१०४-४०", "content_sanskrit": "अर्थायैव हि केषांचिद्धननाशा भवन्त्युत।\nअनित्यं तत्सुखं मत्वा श्रियमन्ये न लिप्सते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2075603, "chapter_id": 2599, "verse_number": "१२-१०४-४१", "content_sanskrit": "रममाणः श्रिया कश्चिन्नान्यच्छ्रेयोऽभिमन्यते।\nतथा तस्येहमानस्य संरम्भोऽपि विनश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2075604, "chapter_id": 2599, "verse_number": "१२-१०४-४२", "content_sanskrit": "कृच्छ्राल्लब्धमभिप्रेतं यथा कौसल्य नश्यति।\nतदा निर्विद्यते सोऽर्थात्परिभग्नक्रमो नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2075605, "chapter_id": 2599, "verse_number": "१२-१०४-४३", "content_sanskrit": "`अनित्यां तां श्रियं मत्वा श्रियं वा कः परीप्सति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2075606, "chapter_id": 2599, "verse_number": "१२-१०४-४४", "content_sanskrit": "धर्ममेकेऽभिपद्यन्ते कल्याणाभिजना नराः।\nपरत्र सुखमिच्छन्तो निर्विद्येयुश्च लौकिकात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2075607, "chapter_id": 2599, "verse_number": "१२-१०४-४५", "content_sanskrit": "जीवितं संत्यजन्त्येके धनलोभपरा नराः।\nन जीवितार्थं मन्यन्ते पुरुषा हि धनादृते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2075608, "chapter_id": 2599, "verse_number": "१२-१०४-४६", "content_sanskrit": "पश्य चैषां कृपणतां पश्य चैषामबुद्धिताम्।\nअध्रुवे जीविते मोहादर्थतृष्णामुपाश्रिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2075609, "chapter_id": 2599, "verse_number": "१२-१०४-४७", "content_sanskrit": "संचये च विनाशान्ते मरणान्ते च जीविते।\nसंयोगे च वियोगान्ते कोनु विप्रणयेन्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2075610, "chapter_id": 2599, "verse_number": "१२-१०४-४८", "content_sanskrit": "धनं वा पुरुषो राजन्पुरुषं वा पुनर्धनम्।\nअवश्यं प्रजहात्येव तद्विद्वान्कोनु संज्वरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2075611, "chapter_id": 2599, "verse_number": "१२-१०४-४९", "content_sanskrit": "अन्यत्रोपनता ह्यापत्पुरुषं तोषयत्युत।\nतेन शान्तिं न लभते नाहमेवेति कारणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2075612, "chapter_id": 2599, "verse_number": "१२-१०४-५०", "content_sanskrit": "अन्येषामपि नश्यन्ति सुहृदश्च धनानि च।\nपश्य बुद्ध्या मनुष्याणां तुल्यामापदमात्मनः।\nनियच्छ यच्छ संयच्छ इन्द्रियाणि मनस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2075613, "chapter_id": 2599, "verse_number": "१२-१०४-५१", "content_sanskrit": "प्रतिषेद्धा न चाप्येषु दुर्बलेष्वहितेषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2075614, "chapter_id": 2599, "verse_number": "१२-१०४-५२", "content_sanskrit": "प्राप्तिसृष्टेषु भावेषु व्यपकृष्टेष्वसंभवे।\nप्रज्ञानतृप्तो विक्रान्तस्त्वद्विधो नानुशोचति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2075615, "chapter_id": 2599, "verse_number": "१२-१०४-५३", "content_sanskrit": "अल्पमिच्छन्नचपलो मृदुर्दान्तः सुसंस्थितः।\nब्रह्मचर्योपपन्नश्च त्वद्विधो नैव मुह्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2075616, "chapter_id": 2599, "verse_number": "१२-१०४-५४", "content_sanskrit": "न त्वेव जाल्मीं कापालीं वृत्तिमेषितुमर्हसि।\nनृशंसवृत्तिं पापिष्ठां दुःखां कापुरुषोचिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2075617, "chapter_id": 2599, "verse_number": "१२-१०४-५५", "content_sanskrit": "अपि मूलफलाहारो रमस्वैको महावने।\nवाग्यतः संगृहीतात्मा सर्वभूतदयान्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2075618, "chapter_id": 2599, "verse_number": "१२-१०४-५६", "content_sanskrit": "सदृशं पण्डितस्यैतदीषादन्तेन हस्तिना।\nयदेको रमतेऽरण्ये यच्चाप्यल्पेन तुष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2075619, "chapter_id": 2599, "verse_number": "१२-१०४-५७", "content_sanskrit": "महाह्रदः संक्षुभित आत्मनैव प्रसीदति।\n`एवं नरः स्वत्मानैव कृतप्रज्ञः प्रसीदति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2075620, "chapter_id": 2599, "verse_number": "१२-१०४-५८", "content_sanskrit": "एतदेवं गतस्याहं सुखं पश्यामि केवलम्।\nअसंभवे श्रियो राजन्हीनस्य सचिवादिभिः।\nदैवे प्रतिनिविष्टे च किं श्रेयो मन्यते भवान्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2075621, "chapter_id": 2599, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि चतुरधिकशततमोऽध्यायः॥ १०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}]