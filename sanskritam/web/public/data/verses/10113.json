[{"id": 6000113000, "chapter_id": 10113, "verse_number": null, "content_sanskrit": "अथ अष्टादशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1, "topics": [{"text": "सर्वखण्डेषु सन्निहितस्य सेव्यस्य भगवद्रूपस्य तत्सेवकानां च वर्णनम्", "range": null}]}, {"id": 6000113001, "chapter_id": 10113, "verse_number": null, "content_sanskrit": "श्री शुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_018/BhP_05.018.001.m4a", "display_order": 2}, {"id": 6000113002, "chapter_id": 10113, "verse_number": "५-१८-१", "content_sanskrit": "तथा च भद्रश्रवा नाम धर्मसुतस्तत्कुलपतयः पुरुषा भद्राश्वे वर्षे साक्षाद्भगवतो वासुदेवस्य प्रियां तनुं धर्ममयीं हयशीर्षाभिधानां परमेण समाधिना सन्निधाप्येदमभिगृणन्त उपधावन्ति॥ ५/१८/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_018/BhP_05.018.002.m4a", "display_order": 3, "topics": [{"text": "भद्राश्वखण्डवर्णनम्", "range": "१–६"}]}, {"id": 6000113003, "chapter_id": 10113, "verse_number": null, "content_sanskrit": "भद्रश्रवस ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_018/BhP_05.018.003.m4a", "display_order": 4}, {"id": 6000113004, "chapter_id": 10113, "verse_number": "५-१८-२", "content_sanskrit": "ॐ नमो भगवते धर्मायात्मशोधनाय नम इति॥ ५/१८/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_018/BhP_05.018.004.m4a", "display_order": 5}, {"id": 6000113005, "chapter_id": 10113, "verse_number": "५-१८-३", "content_sanskrit": "अहो विचित्रं भगवद्विचेष्टितं घ्नन्तं जनोऽयं हि मिषन्न पश्यति।\nध्यायन्नसद्यर्हि विकर्म सेवते निर्हृत्य पुत्रः पितरं जिजीविषुः॥ ५/१८/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_018/BhP_05.018.005.m4a", "display_order": 6}, {"id": 6000113006, "chapter_id": 10113, "verse_number": "५-१८-४", "content_sanskrit": "वदन्ति विश्वं कवयश्च नश्वरं पश्यन्ति चाध्यात्मविदो विपश्चितः।\nतथाऽपि मुह्यन्ति तवाज मायया सुविस्मयं कृत्यविदं नताः स्म तम्॥ ५/१८/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_018/BhP_05.018.006.m4a", "display_order": 7}, {"id": 6000113007, "chapter_id": 10113, "verse_number": "५-१८-५", "content_sanskrit": "विश्वोद्भवस्थाननिरोधकर्म ते ह्यकर्तुरङ्गीकृतमप्यपावृतम्।\nयुक्तं न चित्रं त्वयि कार्यकारणे सर्वात्मनि व्यतिरिक्ते च वस्तुनि॥ ५/१८/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_018/BhP_05.018.007.m4a", "display_order": 8}, {"id": 6000113008, "chapter_id": 10113, "verse_number": "५-१८-६", "content_sanskrit": "वेदान्युगान्ते तमसा तिरस्कृतान् रसातलाद्यो नृतुरङ्गविग्रहः।\nप्रत्याददे वै कवयेऽभियाचते तस्मै नमस्तेऽवितथेहिताय ते॥ ५/१८/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_018/BhP_05.018.008.m4a", "display_order": 9}, {"id": 6000113009, "chapter_id": 10113, "verse_number": "५-१८-७", "content_sanskrit": "हरिवर्षे च भगवान्नरहरिरूपेणाऽस्ते, तद्रूपग्रहणनिमित्तमुत्तरत्राभिधास्यामः, तद्दयितं रूपं महापुरुषगुणभाजनो महाभागवतो दैत्यदानवकुलतीर्थीकरणशीलचरितः प्रह्लादोऽव्यवधानानन्यभक्तियोगेन सह तद्वर्षपुरुषैरुपास्ते इदं चोदाहरति॥ ५/१८/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_018/BhP_05.018.009.m4a", "display_order": 10, "topics": [{"text": "हरिवर्षखण्डवर्णनम्", "range": "७–१४"}]}, {"id": 6000113010, "chapter_id": 10113, "verse_number": "५-१८-८", "content_sanskrit": "ॐ नमो नृसिंहाय तेजस्तेजसे आविराविर्भव वज्रनख वज्रदंष्ट्र कर्माशयान् रन्धय रन्धय तमो ग्रस ग्रस स्वाहा अभयमभयमात्मने भूयिष्ठात्॥ ५/१८/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_018/BhP_05.018.010.m4a", "display_order": 11}, {"id": 6000113011, "chapter_id": 10113, "verse_number": "५-१८-९", "content_sanskrit": "स्वस्त्यस्तु विश्वस्य खलः प्रसीदतां ध्यायन्तु भद्राणि शिवं मनो धिया।\nमनश्च भद्रं भजतादधोक्षजे आविश्यतां नो मतिरप्यहैतुकी॥ ५/१८/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_018/BhP_05.018.011.m4a", "display_order": 12}, {"id": 6000113012, "chapter_id": 10113, "verse_number": "५-१८-१०", "content_sanskrit": "माऽऽगारदारात्मजदेहबन्धुषु सङ्गो यदि स्याद्भगवत्प्रियेषु नः।\nयः प्राणवृत्त्या परितुष्ट आत्मवान् सिध्यत्यदूरान्न तथेन्द्रियप्रियः॥ ५/१८/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_018/BhP_05.018.012.m4a", "display_order": 13}, {"id": 6000113013, "chapter_id": 10113, "verse_number": "५-१८-११", "content_sanskrit": "यत्सङ्गलब्धं निजवीर्यवैभवं तीर्थं मुहुः संस्पृशतां हि मानसम्।\nहरत्यजोंऽहः श्रुतिभिर्गतोऽन्तः को वै न सेवेत मुकुन्दविक्रमम्॥ ५/१८/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_018/BhP_05.018.013.m4a", "display_order": 14}, {"id": 6000113014, "chapter_id": 10113, "verse_number": "५-१८-१२", "content_sanskrit": "यस्यास्ति भक्तिर्भगवत्यकिञ्चना सर्वैर्गुणैस्तत्र समासते सुराः।\nहरावभक्तस्य कुतो महद्गुणा मनोरथेनासति धावतो बहिः॥ ५/१८/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_018/BhP_05.018.014.m4a", "display_order": 15}, {"id": 6000113015, "chapter_id": 10113, "verse_number": "५-१८-१३", "content_sanskrit": "हरिर्हि साक्षाद्भगवाञ् शरीरिणामात्मा झषाणामिव तोयमीप्सितः।\nहित्वा महान्तं यदि सज्जते गृहे तदा महत्त्वं वयसा दम्पतीनाम्॥ ५/१८/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_018/BhP_05.018.015.m4a", "display_order": 16}, {"id": 6000113016, "chapter_id": 10113, "verse_number": "५-१८-१४", "content_sanskrit": "तस्माद्रजोरागविषादमन्युमानस्पृहाभयदैन्याधिमूलम्।\nहित्वा गृहं संसृतिचक्रवालं नृसिंहपादं भजताकुतोभयम्॥ ५/१८/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_018/BhP_05.018.016.m4a", "display_order": 17}, {"id": 6000113017, "chapter_id": 10113, "verse_number": "५-१८-१५", "content_sanskrit": "इति केतुमाले भगवान्कामदेवस्वरूपेणास्ते लक्ष्म्याः प्रियचिकीर्षया प्रजापतेर्दुहितॄणां च तद्वर्षपतीनां पुरुषायुषाऽहोरात्रपरिसङ्ख्यानानां यासां गर्भा महापुरुषमहास्‍त्रतेजसोद्वेजितमनसां विध्वस्ता व्यसवः संवत्सरान्ते निपतन्ति॥ ५/१८/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_018/BhP_05.018.017.m4a", "display_order": 18, "topics": [{"text": "केतुमालाखण्डवर्णनम्", "range": "१५–२३"}]}, {"id": 6000113018, "chapter_id": 10113, "verse_number": "५-१८-१६", "content_sanskrit": "अतीव सुललितगतिविलासविलसितरुचिरहासलेशावलोकलीलया किञ्चिदुत्तम्भितसुन्दर-भ्रूमण्डलसुभगवदनारविन्दश्रिया रमां रमयन्निन्द्रियाणि रमयते॥ ५/१८/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_018/BhP_05.018.018.m4a", "display_order": 19}, {"id": 6000113019, "chapter_id": 10113, "verse_number": "५-१८-१७", "content_sanskrit": "तद्भगवतो मायामयं रूपं परमसमाधियोगेन रमादेवी संवत्सरस्य रात्रिषु प्रजापतेर्दुहितृभिरुपेता अहस्सु तद्भर्तृभिरुपेतोपास्ते।\nइदं चोदाहरति-॥ ५/१८/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_018/BhP_05.018.019.m4a", "display_order": 20}, {"id": 6000113020, "chapter_id": 10113, "verse_number": "५-१८-१८", "content_sanskrit": "ओं नमो भगवते हृषीकेशाय सर्वविशेषवित्क्षेत्रात्मने आकूतीनां चित्तानां चेतसां विशेषाणां चाधिपतये षोडशकलाय च्छन्दोमयायान्नमयायामृतमयाय सर्वमयाय महसे ओजसे बलाय कान्ताय कामाय नमस्ते उभयत्र भूयात्॥ ५/१८/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_018/BhP_05.018.020.m4a", "display_order": 21}, {"id": 6000113021, "chapter_id": 10113, "verse_number": "५-१८-१९", "content_sanskrit": "स्‍त्रियो व्रतैस्त्वां हृषीकेश्वरं स्वतो ह्याराध्य लोके पतिमाशासतेऽन्यम्।\nअनेन तासां परिपास्यपत्यं प्रियं धनायूंषि यतोऽस्वतन्त्राः॥ ५/१८/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_018/BhP_05.018.021.m4a", "display_order": 22}, {"id": 6000113022, "chapter_id": 10113, "verse_number": "५-१८-२०", "content_sanskrit": "स वै पतिः स्यादकुतोभयः स्वयं समन्ततः पाति भयातुरं जनम्।\nस एक एवेतरथा मिथो भजन् नैवात्मलाभादधि मन्यते परम्॥ ५/१८/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_018/BhP_05.018.022.m4a", "display_order": 23}, {"id": 6000113023, "chapter_id": 10113, "verse_number": "५-१८-२१", "content_sanskrit": "यस्तस्य ते पादसरोरुहार्हणं निकामयेत्सोऽखिलकामलम्पटः।\nतदेव चाभीप्सितमीप्सितार्चनं यद्भग्नयाञ्चो भगवन्प्रतप्यते॥ ५/१८/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_018/BhP_05.018.023.m4a", "display_order": 24}, {"id": 6000113024, "chapter_id": 10113, "verse_number": "५-१८-२२", "content_sanskrit": "मत्प्राप्तये ये ससुरासुरादयस्तप्यन्त उग्रं तप ऐन्द्रिये धियः।\nऋते भवत्पादपरायणं न मां विन्दन्त्यहं त्वद्हृदया यतोऽजित॥ ५/१८/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_018/BhP_05.018.024.m4a", "display_order": 25}, {"id": 6000113025, "chapter_id": 10113, "verse_number": "५-१८-२३", "content_sanskrit": "स त्वं ममापि कुरु शीर्षणि स्वकं कराम्बुजं यत्तदधायि सात्वताम्।\nबिभर्षि मा लक्ष्म वरेण्य मायया क ईश्वरस्येहितमूहितुं विभुः’ इति॥ ५/१८/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_018/BhP_05.018.025.m4a", "display_order": 26}, {"id": 6000113026, "chapter_id": 10113, "verse_number": "५-१८-२४", "content_sanskrit": "रम्यके च भगवतः प्रियतमं मात्स्यमवताररूपं तद्वर्षपुरुषस्य मनोः प्राक् प्रदर्शितं स इदानीमपि महता भक्तियोगेनाराधयन्निदं चोदाहरति॥ ५/१८/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_018/BhP_05.018.026.m4a", "display_order": 27, "topics": [{"text": "रम्यकखण्डवर्णनम्", "range": "२४–२८"}]}, {"id": 6000113027, "chapter_id": 10113, "verse_number": "५-१८-२५", "content_sanskrit": "ओं नमो भगवते मुख्यतमाय नमः सत्त्वाय प्राणायौजसे बलाय महामत्स्याय नम इति॥ ५/१८/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_018/BhP_05.018.027.m4a", "display_order": 28}, {"id": 6000113028, "chapter_id": 10113, "verse_number": "५-१८-२६", "content_sanskrit": "अन्तर्बहिश्चाखिललोकपालकैरदृष्टरूपो विचरस्युरुस्वनः।\nस ईश्वरस्त्वं य इदं वशेऽनयन्नात्मा यथा दारुमयीं नरः स्‍त्रियम्॥ ५/१८/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_018/BhP_05.018.028.m4a", "display_order": 29}, {"id": 6000113029, "chapter_id": 10113, "verse_number": "५-१८-२७", "content_sanskrit": "यं लोकपालाः किल मत्सरज्वरा हित्वा यतन्तोऽपि पृथक्समेत्य च।\nपातुं न शेकुर्द्विपदश्चतुष्पदः सरीसृपं स्थास्नु यदत्र दृश्यते॥ ५/१८/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_018/BhP_05.018.029.m4a", "display_order": 30}, {"id": 6000113030, "chapter_id": 10113, "verse_number": "५-१८-२८", "content_sanskrit": "भवान्युगान्तार्णव ऊर्मिमालिनि क्षोणीमिमामोषधिवीरुधां निधिम्।\nमया सहोरुक्रम ऊह ओजसा तस्मै जगत्प्राणगुणात्मने नम इति॥ ५/१८/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_018/BhP_05.018.030.m4a", "display_order": 31}, {"id": 6000113031, "chapter_id": 10113, "verse_number": "५-१८-२९", "content_sanskrit": "हिरण्मये भगवान्निवसति कूर्मतनुं बिभ्राणस्तस्य प्रियतमां तनुमर्यमा सह तद्वर्षपुरुषैः पितृगणाधिपतिरुपधावति, मन्त्रमिमं चानुजपति॥ ५/१८/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_018/BhP_05.018.031.m4a", "display_order": 32, "topics": [{"text": "हिरण्मयखण्डवर्णनम्", "range": "२९–३३"}]}, {"id": 6000113032, "chapter_id": 10113, "verse_number": "५-१८-३०", "content_sanskrit": "ओं नमो भगवते अकूपाराय सर्वसत्त्वगुणविशेषणाय नोपलक्षितस्थानाय नमोऽवर्ष्मणे नमो भूयसे नमोऽवस्थानाय नमस्ते॥ ५/१८/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_018/BhP_05.018.032.m4a", "display_order": 33}, {"id": 6000113033, "chapter_id": 10113, "verse_number": "५-१८-३१", "content_sanskrit": "यद्रूपमेतन्निजमाययाऽर्पितम् अर्थस्वरूपं बहुरूपरूपितम्।\nसङ्ख्या न यस्यास्त्ययथोपलम्भनात् तस्मै नमस्तेऽव्यपदेशरूपिणे॥ ५/१८/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_018/BhP_05.018.033.m4a", "display_order": 34}, {"id": 6000113034, "chapter_id": 10113, "verse_number": "५-१८-३२", "content_sanskrit": "जरायुजं स्वेदजमण्डजोद्भिजं चराचरं देवर्षिपितृभूतभेदम्।\nद्यौः खं क्षितिः शैलसरित्समुद्रद्वीपग्रहर्क्षेत्यभिधेय एकः॥ ५/१८/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_018/BhP_05.018.034.m4a", "display_order": 35}, {"id": 6000113035, "chapter_id": 10113, "verse_number": "५-१८-३३", "content_sanskrit": "यस्मिन्नसङ्ख्येयविशेषनामरूपाकृतौ कविभिः कल्पितेयम्।\nसङ्ख्या यया तत्त्वदृशा विनीयते तस्मै नमः साङ्ख्यनिदर्शनाय हि॥ ५/१८/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_018/BhP_05.018.035.m4a", "display_order": 36}, {"id": 6000113036, "chapter_id": 10113, "verse_number": "५-१८-३४", "content_sanskrit": "इति उत्तरेषु कुरुषु भगवान् यज्ञपुरुषः कृतवराहरूप आस्ते।\nतं तु देवी हैषा भूः सह कुरुभिरस्खलितभक्तियोगेनोपधावति।\nइमां च परमामुपनिषदमावर्तयति॥ ५/१८/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_018/BhP_05.018.036.m4a", "display_order": 37, "topics": [{"text": "उत्तरकुरुखण्डवर्णनम्", "range": "३४–३९"}]}, {"id": 6000113037, "chapter_id": 10113, "verse_number": "५-१८-३५", "content_sanskrit": "ओं नमो भगवते मन्त्रतत्त्वलिङ्गाय यज्ञक्रतवे महीधराय महापुरुषाय नमः कर्मशुक्‍लाय त्रियुगाय नमस्ते॥ ५/१८/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_018/BhP_05.018.037.m4a", "display_order": 38}, {"id": 6000113038, "chapter_id": 10113, "verse_number": "५-१८-३६", "content_sanskrit": "यस्य स्वरूपं कवयो विपश्चितो गुणेषु योनिष्विव जातवेदसम्।\nमथ्नन्ति मथ्ना मनसा दिदृक्षवो गूढं क्रियार्थैर्नम ईरितात्मने॥ ५/१८/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_018/BhP_05.018.038.m4a", "display_order": 39}, {"id": 6000113039, "chapter_id": 10113, "verse_number": "५-१८-३७", "content_sanskrit": "द्रव्यक्रियाहेत्वयनेशकर्तृभिर्मायागुणैर्वस्तुनिरीक्षितात्मने।\nतथैव तत्रातिशयात्मबुद्धिभिर्निरस्तमायाकृतये नमो नमः॥ ५/१८/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_018/BhP_05.018.039.m4a", "display_order": 40}, {"id": 6000113040, "chapter_id": 10113, "verse_number": "५-१८-३८", "content_sanskrit": "करोति विश्वस्थितिसंयमोदयं यथेप्सितं नेक्षितुमीश ते गुणैः।\nमाया यथाऽयो भ्रमते यदाश्रया ग्राव्णो नमस्ते गुणकर्मसाक्षिणे॥ ५/१८/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_018/BhP_05.018.040.m4a", "display_order": 41}, {"id": 6000113041, "chapter_id": 10113, "verse_number": "५-१८-३९", "content_sanskrit": "प्रमथ्य दैत्यं प्रतिवारणं मृधे यो मां रसाया जगदादिसूकरः।\nकृत्वाऽग्रदंष्ट्रे निरगादुदन्वतः क्रीडन्निवेभः प्रणताऽस्मि तं विभुम्॥ ५/१८/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_018/BhP_05.018.041.m4a", "display_order": 42}, {"id": 6000113042, "chapter_id": 10113, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां पञ्चमस्कन्धे अष्टादशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]