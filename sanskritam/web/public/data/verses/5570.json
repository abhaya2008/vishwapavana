[{"id": 2213858, "chapter_id": 5570, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2213859, "chapter_id": 5570, "verse_number": "१", "content_sanskrit": "एवं प्रयतमानानां वृष्णीनामन्धकैः सह ।\nकालो गृहाणि सर्वेषां परिचक्राम नित्यशः\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2213860, "chapter_id": 5570, "verse_number": "२", "content_sanskrit": "कृकलासः सशेषञ्च काकपत्रविलोचनः\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2213861, "chapter_id": 5570, "verse_number": "३", "content_sanskrit": "(करालो विकटो मुण्डः पुरुषः कृष्णपिङ्गलः ।)\nगृहाण्यावेक्ष्य वृष्णीनां नादृश्यत पुनः क्वचित्\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2213862, "chapter_id": 5570, "verse_number": "४", "content_sanskrit": "तमघ्नन्त महेष्वासाः शरैः शतसहस्रशः ।\nन चाशक्यत वेद्धुं स सर्वभूतात्ययस्तदा\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2213863, "chapter_id": 5570, "verse_number": "५", "content_sanskrit": "उत्पेदिरे महावाता दारुणाश्च दिनेदिने ।\nवृष्ण्यन्धकविनाशाय बहवो रोमहर्षणाः\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2213864, "chapter_id": 5570, "verse_number": "६", "content_sanskrit": "विवृद्धमूषिका रथ्या विभिन्नमणिकास्तथा ।\nकेशा नखाश्च सुप्तानामद्यन्ते मूषिकैर्निशि\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2213865, "chapter_id": 5570, "verse_number": "७", "content_sanskrit": "चीचीकूचीति वाशन्ति शारिका वृष्णिवेश्मसु ।\nनोपशाम्यति शब्दश्च सदिवारात्रमेव हि\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2213866, "chapter_id": 5570, "verse_number": "८", "content_sanskrit": "अन्वकुर्वन्नुलूकानां सारसा विरुतं तथा ।\nअजाः शिवानां विरुतमन्वकुर्वत भारत\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2213867, "chapter_id": 5570, "verse_number": "९", "content_sanskrit": "(पाण्डुरा रक्तपादाश्च विहगाः कालचोदिताः ।\nवृष्ण्यन्धकानां गेहेषु कपोता व्यचरंस्तदा\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2213868, "chapter_id": 5570, "verse_number": "", "content_sanskrit": "व्यजायन्त खरा गोषु करभाश्वतरीषु च ।\nशुनीष्वपि बिडालाश्च मूषिका नकुलीषु च\t ॥१०॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2213869, "chapter_id": 5570, "verse_number": "११", "content_sanskrit": "नापत्रपन्त पापानि कुर्वन्तो वृष्णयस्तदा ।\nप्रार्दयन् ब्राह्मणांश्चापि पितॄन् देवांस्तथैव च\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2213870, "chapter_id": 5570, "verse_number": "१२", "content_sanskrit": "गुरूंश्चाप्यवमन्यन्ते न तु रामजनार्दनौ ।\nपत्न्यः पतीनुच्चरन्ति पत्नीश्च पतयस्तथा\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2213871, "chapter_id": 5570, "verse_number": "१३", "content_sanskrit": "विभावसुः प्रज्वलितो वामं विपरिवर्तते ।\nनीललोहितमञ्जिष्ठा विसृजन्नर्चिषः पृथक्\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2213872, "chapter_id": 5570, "verse_number": "१४", "content_sanskrit": "उदयास्तमये नित्यं पुर्यां तस्यां दिवाकरः ।\nव्यदृश्यतासकृत् पुम्भिः कबन्धैः परिवारितः\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2213873, "chapter_id": 5570, "verse_number": "१५", "content_sanskrit": "महानसेषु सिद्धेषु संस्कृतेऽतीव भारत ।\nआहार्यमाणे कृमयो व्यदृश्यन्त सहस्रशः\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2213874, "chapter_id": 5570, "verse_number": "१६", "content_sanskrit": "पुण्याहे वाच्यमाने तु जपत्सु च महात्मसु ।\nअभिधावन्तः श्रूयन्ते न चादृश्यत कश्चन\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2213875, "chapter_id": 5570, "verse_number": "१७", "content_sanskrit": "परस्परं च नक्षत्रं हन्यमानं पुनःपुनः ।\n(ग्रहैरपश्यन् सर्वे ते आत्मनस्तु न पश्यन्ते\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2213876, "chapter_id": 5570, "verse_number": "", "content_sanskrit": "नदन्तं पाञ्चजन्यं च वृष्णन्धकनिवेशने ।\nसमन्तात् पर्यवाशन्त रासभा दारुणस्वराः\t ॥१८॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2213877, "chapter_id": 5570, "verse_number": "१९", "content_sanskrit": "एवं पश्यन् हृषीकेशः सम्प्राप्तं कालपर्ययम् ।\nत्रयोदश्याममावास्यां तान् दृष्ट्वा प्राब्रवीदिदम्\t ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2213878, "chapter_id": 5570, "verse_number": "", "content_sanskrit": "चतुर्दशी पञ्चदशी कृतेयं राहुणा पुनः ।\n(प्राप्तं वै भारते युद्धे प्राप्ता चाद्य क्षयाय नः\t ॥२०॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2213879, "chapter_id": 5570, "verse_number": "२१", "content_sanskrit": "विमृशन्नेव कालं तं परिचिन्त्य जनार्दनः ।\nमेने प्राप्तं स षट्त्रिंशं वर्षं वै केशिसूदनः\t ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2213880, "chapter_id": 5570, "verse_number": "२२", "content_sanskrit": "पुत्रशोकाभिसन्तप्ता गान्धारी हतबान्धवा ।\nयदनुव्याजहारार्ता तदिदं समुपागमत्\t ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2213881, "chapter_id": 5570, "verse_number": "२३", "content_sanskrit": "इदं च तदनुप्राप्तमब्रवीद् यद् युधिष्ठिरः ।\nपुरा व्यूढेष्वनीकेषु दृष्ट्वोत्पातान् सुदारुणान्\t ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2213882, "chapter_id": 5570, "verse_number": "२४", "content_sanskrit": "पुण्याहवाचनाच्चापि शान्तिहोमाच्च शोभनात् ।\nपूततीर्थाभिषेकाच्च न नो श्रेयो भवेदिति\t ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2213883, "chapter_id": 5570, "verse_number": "२५", "content_sanskrit": "इत्युक्त्वा वासुदेवस्तु चिकीर्षुः सत्यमेव तत् ।\nआज्ञापयामास तदा तीर्थयात्रामरिन्दमः\t ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2213884, "chapter_id": 5570, "verse_number": "२६", "content_sanskrit": "अघोषयन्त पुरुषास्तत्र केशवशासनात् ।\nतीर्थयात्रा समुद्रे वः कार्येति पुरुषर्षभाः\t ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2213885, "chapter_id": 5570, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् मौसलपर्वणि\nकृष्णवाक्यघोषणं नाम तृतीयोऽध्यायः ॥३॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]