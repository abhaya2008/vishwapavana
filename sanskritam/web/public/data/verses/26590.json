[{"id": 7006590000, "chapter_id": 26590, "verse_number": "३-१२९-१", "content_sanskrit": "डिम्भकस्य आत्महत्या वैशम्पायन उवाच श्रुत्वा निहतमत्युग्रं भ्रातरं वीर्यशालिनम् ।\nबलदेवं परित्यज्य युध्यमानं महारणे ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006590001, "chapter_id": 26590, "verse_number": "३-१२९-२", "content_sanskrit": "डिम्भको वीर्यसम्पन्नो यमुनामनुजग्मिवान् ।\nतमन्वधावद् वेगेन बलभद्रो हलायुधः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006590002, "chapter_id": 26590, "verse_number": "३-१२९-३", "content_sanskrit": "हंसो हि यत्र पतितस्तत्रासौ निपपात ह ।\nयमुनायां महाराज विलोड्य जलसंचयम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006590003, "chapter_id": 26590, "verse_number": "३-१२९-४", "content_sanskrit": "अथं क्रुद्धः स डिम्भको भ्रामयित्वा जलं बहु ।\nउन्मज्ज्योन्मज्ज्य सहसा निमज्ज्य च पुनः पुनः ४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006590004, "chapter_id": 26590, "verse_number": "३-१२९-५", "content_sanskrit": "न ददर्श तदा राजन् भ्रातरं वीर्यशालिनम् ।\nउन्मज्ज्याथ महाबाहुर्वासुदेवं विलोक्य च ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006590005, "chapter_id": 26590, "verse_number": "३-१२९-६", "content_sanskrit": "उवाच वचनं राजन् डिम्भको वीर्यवत्तमः ।\nअरे गोपकदायाद क्वासौ हंस इति स्थितः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006590006, "chapter_id": 26590, "verse_number": "३-१२९-७", "content_sanskrit": "वासुदेवोऽपि धर्मात्मा यमुनां पृच्छ राजक ।\nइत्यब्रवीत् प्रसन्नात्मा वासुदेवः प्रतापवान् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006590007, "chapter_id": 26590, "verse_number": "३-१२९-८", "content_sanskrit": "तच्छ्रुत्वा यमुनां भूयः प्रविश्य डिम्भकः किल ।\nबहुप्रकारमुद्वीक्ष्य भ्रातरं भ्रातृवत्सलः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006590008, "chapter_id": 26590, "verse_number": "३-१२९-९", "content_sanskrit": "विललाप ततो राजा डिम्भको भ्रान्तमानसः ।\nक्व नु गच्छसि राजेन्द्र विहायैनमबान्धवम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006590009, "chapter_id": 26590, "verse_number": "३-१२९-१०", "content_sanskrit": "कुतो भ्रातरितो गच्छेः परित्यज्यैव मामिह ।\nविलप्यैवं नृपश्रेष्ठ डिम्भको भ्रातृवत्सलः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006590010, "chapter_id": 26590, "verse_number": "३-१२९-११", "content_sanskrit": "आत्मत्यागे मनः कुर्वन् यमुनाया महाह्रदे ।\nनिमज्योन्मज्य सहसा मरणे कृतनिश्चयः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006590011, "chapter_id": 26590, "verse_number": "३-१२९-१२", "content_sanskrit": "हस्तेन जिह्वामाकृष्य भूयो भूयो विलप्य च ।\nततः समूलामाकृष्य जिह्वां साहसकृत् स्वयम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006590012, "chapter_id": 26590, "verse_number": "३-१२९-१३", "content_sanskrit": "ममारान्तर्जले राजन् डिम्भको नरकाय वै ।\nएवं तु निहते हंसे डिम्भके वीर्यशालिनि ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006590013, "chapter_id": 26590, "verse_number": "३-१२९-१४", "content_sanskrit": "आगमत्पुण्डरीकाक्षो भूतान्विस्मापयन्निव ।\nततः प्रीतः प्रसन्नात्मा वासुदेवः प्रतापवान् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006590014, "chapter_id": 26590, "verse_number": "३-१२९-१५", "content_sanskrit": "गोवर्धनेऽथ विश्रम्य बलभद्रसहायवान् ।\nकंचित् कालं महाराज पूर्वभुक्तमुवास ह ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]