[{"id": 2020902, "chapter_id": 1439, "verse_number": "३-७७-०x", "content_sanskrit": "बृहदश्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2020903, "chapter_id": 1439, "verse_number": "३-७७-१", "content_sanskrit": "प्रशान्ते तु पुरे हृष्टे संप्रवृत्ते महोत्सवे।\nमहत्या सेनया राजा दमयन्तीमुपानयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2020904, "chapter_id": 1439, "verse_number": "३-७७-२", "content_sanskrit": "`पुण्यश्लोकं तु राज्यस्थं श्रुत्वा भीमो महीपतिः।\nमुदा परमया युक्तो बभूव भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2020905, "chapter_id": 1439, "verse_number": "३-७७-३", "content_sanskrit": "अथ हृष्टमना राजा महत्या सेनया सह।\nसुतां प्रस्थापयामास पुण्यश्लोकाय धीमते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2020906, "chapter_id": 1439, "verse_number": "३-७७-४", "content_sanskrit": "दमयन्तीमपि पिता सत्कृत्यपरवीरहा।\nप्रास्थापयदमेयात्मा भीमो भीमपराक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2020907, "chapter_id": 1439, "verse_number": "३-७७-५", "content_sanskrit": "आगतायां तु वैदर्भ्यां सपुत्रायां नलो नृपः।\nवर्तयामास मुदितो दोवराडिव नन्दने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2020908, "chapter_id": 1439, "verse_number": "३-७७-६", "content_sanskrit": "तथा प्रकाशतां यातो जम्बूद्वीपे स राजसु।\nपुनः स्वे चावसद्राज्ये प्रत्याहृत्य महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2020909, "chapter_id": 1439, "verse_number": "३-७७-७", "content_sanskrit": "ईजे च विविधैर्यज्ञैर्विधिवच्चाप्तदक्षिणैः।\nतथा त्वमपि राजेन्द्र ससुहृद्वक्ष्यसे चिरात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2020910, "chapter_id": 1439, "verse_number": "३-७७-८", "content_sanskrit": "दुःखमेतादृशंप्राप्तो नलः परपुरंजयः।\nदेवनेन नरश्रेष्ठ सभार्यो भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2020911, "chapter_id": 1439, "verse_number": "३-७७-९", "content_sanskrit": "एकाकिनैव सुमहन्नलेन पृथिवीपते।\nदुःखमासादितं घोरं प्राप्तश्चाभ्युदयः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2020912, "chapter_id": 1439, "verse_number": "३-७७-१०", "content_sanskrit": "त्वं पुनर्भ्रातृसहितः कृष्णया चैव पाण्डव।\nकथाश्चापि समाकर्ण्य धर्ममेवानुचिन्तयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2020913, "chapter_id": 1439, "verse_number": "३-७७-११", "content_sanskrit": "ब्राह्मणैश्च महाभागैर्वेदवेदाङ्गपारगैः।\nनित्यमन्वास्यसे राजंस्तत्र का परिदेवना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2020914, "chapter_id": 1439, "verse_number": "३-७७-१२", "content_sanskrit": "कर्कोटकस्य नागस् दमयन्त्या नलस्य च।\nऋतुपर्णस्य राजर्षेः कीर्तनं कलिनाशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2020915, "chapter_id": 1439, "verse_number": "३-७७-१३", "content_sanskrit": "इतिहासमिमं चापि कलिनाशनमच्युत।\nशक्यमाश्वसितुं श्रुत्वा त्वद्विधेन विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2020916, "chapter_id": 1439, "verse_number": "३-७७-१४", "content_sanskrit": "अस्थिरत्वं च संचिन्त्य पुरुषार्थस् नित्यदा।\nतस्योदये व्यये चापि न चिन्तयितुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2020917, "chapter_id": 1439, "verse_number": "३-७७-१५", "content_sanskrit": "श्रुत्वेतिहासं नृषते समाश्वसिहि मा शुचः।\nव्यसने त्वं महाराज न विषीदितुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2020918, "chapter_id": 1439, "verse_number": "३-७७-१६", "content_sanskrit": "विषमावस्थिते दैवे पौरुषेऽफलतां गते।\nविषादयन्ति नात्मानं सत्त्वापाश्रयिणो नराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2020919, "chapter_id": 1439, "verse_number": "३-७७-१७", "content_sanskrit": "ये चेदं कथयिष्यन्ति नलस् चरितं महत्।\nश्रोष्यन्ति चाप्यभीक्ष्णं वै नालक्ष्मीस्तान्भजिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2020920, "chapter_id": 1439, "verse_number": "३-७७-१८", "content_sanskrit": "अर्थास्तस्योपपत्स्यन्ते धन्यतां च गमिष्यति।\nइतिहासमिमं श्रुत्वा पुराणं शश्वदुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2020921, "chapter_id": 1439, "verse_number": "३-७७-१९", "content_sanskrit": "पुत्रान्पौत्रान्पशूंश्चापि लभते नृषु चाग्र्यताम्।\nआरोग्यप्रीतिमांश्चैव भविष्ति न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2020922, "chapter_id": 1439, "verse_number": "३-७७-२०", "content_sanskrit": "भयात्रस्यसि यच्च त्वमाह्वयिष्यति मां पुनः।\nअक्षज्ञ इति तत्तेऽहं नाशयिष्यामि पार्थिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2020923, "chapter_id": 1439, "verse_number": "३-७७-२१", "content_sanskrit": "वेदाक्षहृदयं कृत्स्नमहं सत्यपराक्रम।\nउपपद्यस्व कौन्तेय प्रसन्नोऽहं ब्रवीमि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2020924, "chapter_id": 1439, "verse_number": "३-७७-२२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2020925, "chapter_id": 1439, "verse_number": "३-७७-२२", "content_sanskrit": "ततो हृष्टमना राजा बृहदश्वमुवाच ह।\nभगवन्नक्षहृदयं ज्ञातुमिच्छामि तत्त्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2020926, "chapter_id": 1439, "verse_number": "३-७७-२३", "content_sanskrit": "`कौन्तेयेनैवमुक्तस्तु बृहदश्वो महामुनिः।\nततोऽक्षहृदयं प्रादात्पाण्डवाय महात्मने।\n`लब्ध्वा च पाण्डवो राजा विशोकः समपद्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2020927, "chapter_id": 1439, "verse_number": "३-७७-२४x", "content_sanskrit": "बृहदश्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2020928, "chapter_id": 1439, "verse_number": "३-७७-२४", "content_sanskrit": "पुनरेव तु वक्ष्यामि यस्त्वत्तो दुःखितो नृपः।\nतं शृणुष्व महाराज सर्वदुःखापनुत्तये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2020929, "chapter_id": 1439, "verse_number": "३-७७-२५", "content_sanskrit": "इक्ष्वाकूणां कुले जातो महात्मा पृथिवीपतिः।\nत्रिशङ्कुरिति विख्यातोराजराजो महाद्युतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2020930, "chapter_id": 1439, "verse_number": "३-७७-२६", "content_sanskrit": "हरिश्चन्द्रस्ततो जज्ञे गुणरत्नाकरो नृपात्।\nततो विशेषैर्विविधैर्यज्ञैर्विपुलदक्षिणैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2020931, "chapter_id": 1439, "verse_number": "३-७७-२७", "content_sanskrit": "स तु लोके वरः पुंसां पुण्यश्लोको महायशाः।\nसत्यवादी मधुरवाक्सत्येन बहुभाषिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2020932, "chapter_id": 1439, "verse_number": "३-७७-२८", "content_sanskrit": "तस्य भार्याऽभवद्भूमौ सौशील्यसमलंकृता।\nउशीनरस्य राजर्षेर्दुहिता पुण्यलक्षणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2020933, "chapter_id": 1439, "verse_number": "३-७७-२९", "content_sanskrit": "स्वयंवरे महाभागं वरयामास भामिनी।\nहरिश्चन्द्रं समेतानां राज्ञां मद्ये पतिं विभुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2020934, "chapter_id": 1439, "verse_number": "३-७७-३०", "content_sanskrit": "तया सह महीपालः सत्यवत्या मनोज्ञया।\nरेमे च सुचिरं कालं राजा राज्यमवाप्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2020935, "chapter_id": 1439, "verse_number": "३-७७-३१", "content_sanskrit": "तस्यां देव्यां हरिश्चन्द्राज्जज्ञे राजीवलोचनः।\nपुत्रः पुण्यवतां श्रेष्ठो लोहिताश्व इति श्रुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2020936, "chapter_id": 1439, "verse_number": "३-७७-३२", "content_sanskrit": "देव्या पुत्रेण सहितः पुण्यश्लोको महायशाः।\nवसिष्ठयाज्यो नृपतिरीजे शुण्यैर्महाध्वरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2020937, "chapter_id": 1439, "verse_number": "३-७७-३३", "content_sanskrit": "एतस्मिन्नेव काले तु विश्वामित्रो दिवं गतः।\nपुरुहूतपुरीं रम्यामाजगामेन्द्रसेवया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2020938, "chapter_id": 1439, "verse_number": "३-७७-३४", "content_sanskrit": "उपस्थाने च संवृत्ते देवेन्द्रस्य महात्मनः।\nआजगाम वसिष्ठोऽपि वामदेवसहायवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2020939, "chapter_id": 1439, "verse_number": "३-७७-३५", "content_sanskrit": "उपस्थाने च संवृत्ते सुखासीने पुरंदरे।\nवर्ण्यमानेषु च तदा सत्यवादिषु राजसु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2020940, "chapter_id": 1439, "verse_number": "३-७७-३६", "content_sanskrit": "तस्यां संसदिसर्वस्माद्धरिश्चन्द्रोऽपि पप्रथे।\nयज्ञदानतपःशीलसत्यवाक्यदृझव्रतैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2020941, "chapter_id": 1439, "verse_number": "३-७७-३७", "content_sanskrit": "वसिष्ठः परमप्रीतः स्वयाज्यपरिकीर्तनात्।\nतथापि विश्वामित्रस्तं न सेहे सत्यभूषितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2020942, "chapter_id": 1439, "verse_number": "३-७७-३८", "content_sanskrit": "हरिश्चन्द्रं प्रति तदा विश्वामित्रवसिष्ठयोः।\nपणः कृतस्तदा पश्चाद्विश्वामित्रेण पार्थिवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2020943, "chapter_id": 1439, "verse_number": "३-७७-३९", "content_sanskrit": "राज्याच्चापि सुखाच्चापि सहसा चावरोपितः।\nअवाप परमं दुःखं मरणादमनोहरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2020944, "chapter_id": 1439, "verse_number": "३-७७-४०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2020945, "chapter_id": 1439, "verse_number": "३-७७-४०", "content_sanskrit": "तच्छ्रुत्वा परमप्रीतो धर्मराजो युधिष्ठिरः।\nभ्रातृभिर्ब्राह्मणैश्चैव द्रौपद्या च समन्वितः।\nविस्मयं परमं गत्वा साधुसाध्वित्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2020946, "chapter_id": 1439, "verse_number": "३-७७-४१", "content_sanskrit": "ततो हरिश्चन्द्रकथां च सर्वे\nश्रुत्वा तु राजा मनुजेन्द्रकेतुः।\nविहाय शोकं विजहार भूयः\nस्मरन्हरिश्चन्द्रमनन्तकीर्तिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2020947, "chapter_id": 1439, "verse_number": "३-७७-४२", "content_sanskrit": "कथामेवं तथा कृत्वा हरिश्चन्द्रनलाश्रयाम्।\nआमन्त्र्य पाण्डवान्सर्वान्बृहदश्वो जगाम ह।\nउक्त्वा चाशु सरोऽगच्छदुपस्प्रष्टुं महातपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2020948, "chapter_id": 1439, "verse_number": "३-७७-४३", "content_sanskrit": "बृहदश्व गते पार्थमश्रौषीत्सव्यसाचिनम्।\nवर्तमनं तपस्युग्रे वायुभक्षं मनीषिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2020949, "chapter_id": 1439, "verse_number": "३-७७-४४", "content_sanskrit": "ब्राह्मणएभ्यस्तपस्विभ्यः संपतद्भ्यस्ततस्ततः।\nतीर्थशैलवनेभ्यश्च समेतेभ्यो दृढव्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2020950, "chapter_id": 1439, "verse_number": "३-७७-४५", "content_sanskrit": "इतिपार्थो महाबाहुर्दुरापं तप आस्थितः।\nन तथा दृष्टपूर्वोऽन्यः कश्चिदुग्रतपा इति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2020951, "chapter_id": 1439, "verse_number": "३-७७-४६", "content_sanskrit": "यथा धनंजयः पार्थस्तपस्वी नियतव्रतः।\nमुनिरेकचरः श्रीमान्धर्मो विग्रहवानिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2020952, "chapter_id": 1439, "verse_number": "३-७७-४७", "content_sanskrit": "तं श्रुत्वा पाण्डवो राजंस्तप्यमानं महावने।\nअन्वशोचत कौन्तेयः प्रियं वै भ्रातरं जयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2020953, "chapter_id": 1439, "verse_number": "३-७७-४८", "content_sanskrit": "दह्यमानेन तु हृदा शरणार्थी महावने।\nब्राह्मणान्विविधज्ञानान्पर्यपृच्छद्युधिष्ठिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2020954, "chapter_id": 1439, "verse_number": "३-७७-४९", "content_sanskrit": "`प्रतिगृह्याक्षहृदयं कुन्तीपुत्रो युधिष्ठिरः।\nआसीद्धृष्टमना राजन्भीमसेनादिभिर्युतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2020955, "chapter_id": 1439, "verse_number": "३-७७-५०", "content_sanskrit": "स्वभ्रातॄन्सहितान्पश्यन्कुन्तीपुत्रो युधिष्ठिरः।\nअपश्यन्नर्जुनं तत्रबभूवाश्रुपरिप्लुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2020956, "chapter_id": 1439, "verse_number": "३-७७-५१", "content_sanskrit": "संतप्यमानः कौन्तेयो भीमसेनमुवाच ह।\nकदा द्रक्ष्यामि वै भीम पार्तमत्र तवानुजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2020957, "chapter_id": 1439, "verse_number": "३-७७-५२", "content_sanskrit": "मत्कृते हि कुरुश्रेष्ठ तष्यते परमं तपः।\nतस्याक्षहृदयज्ञानमाख्यास्यामि कदा न्बहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2020958, "chapter_id": 1439, "verse_number": "३-७७-५३", "content_sanskrit": "स हि श्रुत्वाऽक्षहृदयं समुपात्तं मया विभो।\nप्रहृष्टः पुरुषव्याघ्रो भविष्यति न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2020959, "chapter_id": 1439, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि नलोपाख्यानपर्वणि सप्तसप्ततितमोऽध्यायः ॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}]