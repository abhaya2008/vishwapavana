[{"id": 7005018000, "chapter_id": 25018, "verse_number": "७-१-२०१-१", "content_sanskrit": "ईश्वर उवाच ।\nतस्मिन्स्थाने महादेवि स्मशानं कालभैरवम् ।\nब्रह्मकुण्डं वरारोहे यावद्देवः कृतस्मरः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005018001, "chapter_id": 25018, "verse_number": "७-१-२०१-२", "content_sanskrit": "तत्र ये प्राणिनो दग्धा मृताः कालविपर्ययात् ।\nते सर्वे मुक्तिमायांति महापातकिनोऽपि वा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005018002, "chapter_id": 25018, "verse_number": "७-१-२०१-३", "content_sanskrit": "कृतस्मरान्महादेवि यावन्मंकीश्वरः स्थितः ।\nमहास्मशानं तद्देवि अपुनर्भवदायकम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005018003, "chapter_id": 25018, "verse_number": "७-१-२०१-४", "content_sanskrit": "तस्मिन्स्थाने वहेद्यत्र विषुवं प्राणिनां प्रिये ।\nतत्रोषरं स्मृतं क्षेत्रं तन्मे प्रियतरं सदा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005018004, "chapter_id": 25018, "verse_number": "७-१-२०१-५", "content_sanskrit": "कल्पांतेऽपि न मुंचामि अविमुक्तात्प्रियं मम ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005018005, "chapter_id": 25018, "verse_number": "७-१-२०१-६", "content_sanskrit": "इति श्रीस्कान्दे महापुराण एकाशीतिसाहस्र्यां संहितायां सप्तमे प्रभासखण्डे प्रथमे प्रभासक्षेत्रमाहात्म्ये कालभैरवस्मशानमाहात्म्यवर्णनं नामैकोत्तरद्विशततमोऽध्यायः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}]