[{"id": 6000284000, "chapter_id": 10284, "verse_number": null, "content_sanskrit": "अथ अष्टाशीतितमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000284001, "chapter_id": 10284, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_088/BhP_10.088.001.m4a", "display_order": 2}, {"id": 6000284002, "chapter_id": 10284, "verse_number": "१०-८८-१", "content_sanskrit": "इति सूतोदितां वाणीमाकर्ण्य यदुनन्दनः।\nपुनरात्तप्रहरणः सूतमाह रणाङ्गणे॥ १०/८८/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_088/BhP_10.088.002.m4a", "display_order": 3, "topics": [{"text": "प्रत्यावृत्य प्रद्युम्नेन द्युमतो वधः", "range": "१–४"}]}, {"id": 6000284003, "chapter_id": 10284, "verse_number": "१०-८८-२", "content_sanskrit": "पश्य सूत द्युमानेष दंशितो धृतकार्मुकः।\nनय मां द्युमतः पार्श्वं वीरस्येत्याह सारथिम्॥ १०/८८/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_088/BhP_10.088.003.m4a", "display_order": 4}, {"id": 6000284004, "chapter_id": 10284, "verse_number": "१०-८८-३", "content_sanskrit": "आद्रवन्तं स्वसैन्यानि द्युमन्तं रुग्मिणीसुतः।\nप्रतिहत्य रुषाऽविध्यन्नाराचैरष्टभिः स्मरन्॥ १०/८८/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_088/BhP_10.088.004.m4a", "display_order": 5}, {"id": 6000284005, "chapter_id": 10284, "verse_number": "१०-८८-४", "content_sanskrit": "चतुर्भिश्चतुरो वाहान् सूतमेकेन चाहनत्।\nद्वाभ्यां च केतुधनुषी द्युमतोऽन्येन वै शिरः॥ १०/८८/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_088/BhP_10.088.005.m4a", "display_order": 6}, {"id": 6000284006, "chapter_id": 10284, "verse_number": "१०-८८-५", "content_sanskrit": "गदः सात्यकिरक्रूरः साम्बश्च शुकसारणौ।\nवसुदेवोग्रसेनौ च जघ्नुः सौभपतेर्बलम्॥ १०/८८/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_088/BhP_10.088.006.m4a", "display_order": 7, "topics": [{"text": "पीडितस्य साल्वस्य ततोऽपयानम्", "range": "५–१७"}]}, {"id": 6000284007, "chapter_id": 10284, "verse_number": "१०-८८-६", "content_sanskrit": "पेतुः समुद्रे बहवः साल्वेया भिन्नकन्धराः।\nएवं यदूनां साल्वानां निघ्नतामितरेतरम्॥ १०/८८/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_088/BhP_10.088.007.m4a", "display_order": 8}, {"id": 6000284008, "chapter_id": 10284, "verse_number": "१०-८८-७", "content_sanskrit": "रणं त्रिनवरात्रं तु तुमुलं रोमहर्षणम्।\nइन्द्रप्रस्थं गतः कृष्ण आहूतो धर्मसूनुना॥ १०/८८/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_088/BhP_10.088.008.m4a", "display_order": 9}, {"id": 6000284009, "chapter_id": 10284, "verse_number": "१०-८८-८", "content_sanskrit": "राजसूये निवृत्ते च शिशुपाले रणे हते।\nअलक्षयद् दुःशकुनान् घोरान् सङ्ग्रामशंसिनः॥ १०/८८/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_088/BhP_10.088.009.m4a", "display_order": 10}, {"id": 6000284010, "chapter_id": 10284, "verse_number": "१०-८८-९", "content_sanskrit": "कुरुवृद्धाननुज्ञाप्य मुनींश्च ब्राह्मणैः सह।\nअन्वीयमानः सामात्यैः पाण्डवैर्निर्ययौ पुरात्॥ १०/८८/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_088/BhP_10.088.010.m4a", "display_order": 11}, {"id": 6000284011, "chapter_id": 10284, "verse_number": "१०-८८-१०", "content_sanskrit": "स गत्वा किञ्चिदध्वानं स्थापयित्वा पुरौकसः।\nपृथासुताननुज्ञाप्य प्रणतानश्रुलोचनान्॥ १०/८८/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_088/BhP_10.088.011.m4a", "display_order": 12}, {"id": 6000284012, "chapter_id": 10284, "verse_number": "१०-८८-११", "content_sanskrit": "सुवर्णशिबिकारूढैरवरोधवधूजनैः।\nगजाश्वरथपादातिसहस्रैरपि संवृतः॥ १०/८८/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_088/BhP_10.088.012.m4a", "display_order": 13}, {"id": 6000284013, "chapter_id": 10284, "verse_number": "१०-८८-१२", "content_sanskrit": "अन्वीतराजकटकः प्रतस्थे पश्चिमामुखः। साल्वोऽपि कुरुशार्दूल विमानेन खचारिणा।\nअपावृत्य रणाद् राष्ट्रं स्वमेवाभ्यर्दितो ययौ॥ १०/८८/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_088/BhP_10.088.013.m4a", "display_order": 14}, {"id": 6000284014, "chapter_id": 10284, "verse_number": "१०-८८-१३", "content_sanskrit": "गच्छमानस्य साल्वस्य साम्बोऽभिद्रुत्य पृष्ठतः।\nसाल्वामात्यं क्षेमधूर्तिं बाणैर्निन्ये यमक्षयम्॥ १०/८८/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_088/BhP_10.088.014.m4a", "display_order": 15}, {"id": 6000284015, "chapter_id": 10284, "verse_number": "१०-८८-१४", "content_sanskrit": "सेनापतिं विविन्दाख्यं साल्वस्याखिलवल्लभम्।\nनिरुद्ध्य पथि गच्छन्तं प्रद्युम्नः प्राहरच्छरैः॥ १०/८८/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_088/BhP_10.088.015.m4a", "display_order": 16}, {"id": 6000284016, "chapter_id": 10284, "verse_number": "१०-८८-१५", "content_sanskrit": "प्रद्युम्नेनातिविद्धोऽसौ गृहीत्वा खङ्गचर्मणी।\nससज्ज रौग्मिणेयेन तदभूद् रणमद्भुतम्॥ १०/८८/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_088/BhP_10.088.016.m4a", "display_order": 17}, {"id": 6000284017, "chapter_id": 10284, "verse_number": "१०-८८-१६", "content_sanskrit": "मण्डलानि विचित्राणि चरतस्तस्य सङ्गरे।\nकृपाणेन यदुश्रेष्ठः शिरः कायादपाहरत्॥ १०/८८/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_088/BhP_10.088.017.m4a", "display_order": 18}, {"id": 6000284018, "chapter_id": 10284, "verse_number": "१०-८८-१७", "content_sanskrit": "विभ्रष्टमार्गा सा सेना हतप्रवरयूथपा।\nविदुद्राव यथाकामं प्राणत्राणपरायणा॥ १०/८८/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_088/BhP_10.088.018.m4a", "display_order": 19}, {"id": 6000284019, "chapter_id": 10284, "verse_number": "१०-८८-१८", "content_sanskrit": "देवोऽपि द्वारकामेत्य वेगेन गरुडध्वजः।\nददर्श नगरीं भग्नप्रासादाट्टालगोपुराम्॥ १०/८८/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_088/BhP_10.088.019.m4a", "display_order": 20, "topics": [{"text": "ततः कृष्णस्य द्वारकागमनम्", "range": "१८–२०"}]}, {"id": 6000284020, "chapter_id": 10284, "verse_number": "१०-८८-१९", "content_sanskrit": "विशीर्णतोरणां रुग्णतुङ्गसालप्रतोलिकाम्।\nविध्वस्तोपवनोद्यानां प्रस्तरापूर्णदीर्घिकाम्॥ १०/८८/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_088/BhP_10.088.020.m4a", "display_order": 21}, {"id": 6000284021, "chapter_id": 10284, "verse_number": "१०-८८-२०", "content_sanskrit": "निःस्वाध्यायवषट्कारामालोक्य द्वारकापुरीम्।\nअपृच्छत् कृतवर्माणं किमेतदिति दुर्मनाः॥ १०/८८/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_088/BhP_10.088.021.m4a", "display_order": 22}, {"id": 6000284022, "chapter_id": 10284, "verse_number": "१०-८८-२१", "content_sanskrit": "तेनोक्तं सर्वमाकर्ण्य साल्वराजविचेष्टितम्।\nप्रतिजज्ञे यदुपतिः शृण्वतां सर्वसात्वताम्॥ १०/८८/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_088/BhP_10.088.022.m4a", "display_order": 23, "topics": [{"text": "कृतवर्ममुखेन सर्वं ज्ञात्वा साल्वमनुद्रुत्य युद्धे तद्वधश्च", "range": "२१–५८"}]}, {"id": 6000284023, "chapter_id": 10284, "verse_number": "१०-८८-२२", "content_sanskrit": "अनुद्रुत्य तमद्यैव सौभं हत्वा दुरात्मकम्।\nसौभं निपात्य जलधौ प्रवेक्ष्ये द्वारकामिति॥ १०/८८/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_088/BhP_10.088.023.m4a", "display_order": 24}, {"id": 6000284024, "chapter_id": 10284, "verse_number": "१०-८८-२३", "content_sanskrit": "स रथं शैब्यसुग्रीवमेघपुष्पबलाहकैः।\nयुक्तं बहुप्रहरणमग्रावस्थितदारुकम्॥ १०/८८/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_088/BhP_10.088.024.m4a", "display_order": 25}, {"id": 6000284025, "chapter_id": 10284, "verse_number": "१०-८८-२४", "content_sanskrit": "आरुह्य भगवान् विष्णुर्गरुडध्वजमुत्तमम्।\nप्रययौ सौभपदवीं मनोमारुतरंहसा॥ १०/८८/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_088/BhP_10.088.025.m4a", "display_order": 26}, {"id": 6000284026, "chapter_id": 10284, "verse_number": "१०-८८-२५", "content_sanskrit": "तथा गत्वा सुदूरं तमम्भोधेः कुक्षिमाश्रितम्।\nददर्श सौभं तन्मध्ये साल्वं च समलङ्कृतम्॥ १०/८८/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_088/BhP_10.088.026.m4a", "display_order": 27}, {"id": 6000284027, "chapter_id": 10284, "verse_number": "१०-८८-२६", "content_sanskrit": "साल्वश्च कृष्णमालोक्य हतप्रायबलेश्वरः।\nप्राहरत् कृष्णसूताय शक्तिं भीमां दृढां मृधे॥ १०/८८/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_088/BhP_10.088.027.m4a", "display_order": 28}, {"id": 6000284028, "chapter_id": 10284, "verse_number": "१०-८८-२७", "content_sanskrit": "तामापतन्तीं नभसि महोल्कामिव रंहसा।\nभासयन्तीं दिशः शौरिः सायकैः शतधाऽच्छिनत्॥ १०/८८/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_088/BhP_10.088.028.m4a", "display_order": 29}, {"id": 6000284029, "chapter_id": 10284, "verse_number": "१०-८८-२८", "content_sanskrit": "तं च षोडशभिर्बाणैर्विद्ध्वा सौभं च खेचरम्।\nआविद्ध्यच्छरसन्दोहैः खं सूर्य इव रश्मिभिः॥ १०/८८/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_088/BhP_10.088.029.m4a", "display_order": 30}, {"id": 6000284030, "chapter_id": 10284, "verse_number": "१०-८८-२९", "content_sanskrit": "साल्वः शौरेस्तु दोः सव्यं सशार्ङ्गं शार्ङ्गधन्वनः।\nबिभेद न्यपतद् हस्ताच्छार्ङ्गमासीत् तदद्भुतम्॥ १०/८८/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_088/BhP_10.088.030.m4a", "display_order": 31}, {"id": 6000284031, "chapter_id": 10284, "verse_number": "१०-८८-३०", "content_sanskrit": "हाहाकारो महानासीद् यदूनां तत्र पश्यताम्।\nविनद्य सौभराडुच्चैरिदमाह जनार्दनम्॥ १०/८८/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_088/BhP_10.088.031.m4a", "display_order": 32}, {"id": 6000284032, "chapter_id": 10284, "verse_number": "१०-८८-३१", "content_sanskrit": "यत् त्वया युधि दुर्बुद्धे भ्रातरौ मे महाबलौ। निहतौ हंसडिभकौ यमुनायां दुरात्मना।\nयद् भूयो मूढ नः सख्युर्भार्याऽप्यपहृता त्वया॥ १०/८८/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_088/BhP_10.088.032.m4a", "display_order": 33}, {"id": 6000284033, "chapter_id": 10284, "verse_number": "१०-८८-३२", "content_sanskrit": "यच्च मन्द सभामध्ये दमघोषसुतः सखा।\nव्यापादितः क्षत्रियाणां पश्यतां हतचेतसाम्॥ १०/८८/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_088/BhP_10.088.033.m4a", "display_order": 34}, {"id": 6000284034, "chapter_id": 10284, "verse_number": "१०-८८-३३", "content_sanskrit": "तं त्वाऽद्य निशितैर्बाणैरपराजितमानिनम्।\nनयाम्यपुनरावृत्तिं यदि तिष्ठेर्ममाग्रतः॥ १०/८८/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_088/BhP_10.088.034.m4a", "display_order": 35}, {"id": 6000284035, "chapter_id": 10284, "verse_number": "१०-८८-३४", "content_sanskrit": "इति तेनोदितां वाणीमाकर्ण्य मधुसूदनः।\nप्राहार्दितो बाणगणैः पुनरात्तशरासनः॥ १०/८८/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_088/BhP_10.088.035.m4a", "display_order": 36}, {"id": 6000284036, "chapter_id": 10284, "verse_number": "१०-८८-३५", "content_sanskrit": "वृथा त्वं कत्थसे मन्द न यस्यास्त्यतिकौतुकम्।\nपौरुषं दर्शय त्वं नः शूराणां फल्गु भाषणम्॥ १०/८८/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_088/BhP_10.088.036.m4a", "display_order": 37}, {"id": 6000284037, "chapter_id": 10284, "verse_number": "१०-८८-३६", "content_sanskrit": "इत्युक्त्वा भगवान् साल्वं गदया भीमवेगया।\nतताड जत्रौ संरब्धः स चकम्पे वमन्नसृक्॥ १०/८८/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_088/BhP_10.088.037.m4a", "display_order": 38}, {"id": 6000284038, "chapter_id": 10284, "verse_number": "१०-८८-३७", "content_sanskrit": "ततः साल्वः समुत्पत्य खड्गेनानकदुन्दुभेः।\nउत्कृत्य शिर आदाय खस्थं सौभं समाविशत्॥ १०/८८/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_088/BhP_10.088.038.m4a", "display_order": 39}, {"id": 6000284039, "chapter_id": 10284, "verse_number": "१०-८८-३८", "content_sanskrit": "ततो मुहूर्तात् प्रकृतावुपस्थितस्तत्रानुतिष्ठत् स्वजनानुसङ्गतः।\nमहानुभावस्तदबुद्ध्यतासुरीं मायां स साल्वप्रकृतां मयोदिताम्॥ १०/८८/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_088/BhP_10.088.039.m4a", "display_order": 40}, {"id": 6000284040, "chapter_id": 10284, "verse_number": "१०-८८-३९", "content_sanskrit": "न तत्र दैत्यं न पितुः कलेवरं प्रबुद्ध आत्मा तदपश्यदच्युतः।\nस्वप्ने यथा चाम्बरचारिणं रिपुं सौभस्थमालोक्य निहन्तुमुद्यतः॥ १०/८८/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_088/BhP_10.088.040.m4a", "display_order": 41}, {"id": 6000284041, "chapter_id": 10284, "verse_number": "१०-८८-४०", "content_sanskrit": "एवं वदन्ति राजर्षे ऋषयः खेचरान्विताः।\nयत् स्ववाचो विरुद्ध्यन्ते तन्नूनं ते स्मरन्ति नु॥ १०/८८/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_088/BhP_10.088.041.m4a", "display_order": 42}, {"id": 6000284042, "chapter_id": 10284, "verse_number": "१०-८८-४१", "content_sanskrit": "क्‍व शोकमोहौ स्नेहो वा भयं वा येऽज्ञसंभवाः।\nक्‍व चाखण्डितविज्ञानज्ञानैश्वर्येश्वरोऽजितः॥ १०/८८/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_088/BhP_10.088.042.m4a", "display_order": 43}, {"id": 6000284043, "chapter_id": 10284, "verse_number": "१०-८८-४२", "content_sanskrit": "यत्पादसेवार्जितयाऽऽत्मविद्यया हिन्वन्त्यनाद्यात्मविपर्ययग्रहम्।\nलभन्त आत्मीयमनन्तमैश्वरं कुतो नु मोहः परमस्य सद्गतेः॥ १०/८८/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_088/BhP_10.088.043.m4a", "display_order": 44}, {"id": 6000284044, "chapter_id": 10284, "verse_number": "१०-८८-४३", "content_sanskrit": "इति तैरुदितां वाणीमाकर्ण्य कमलेक्षणः।\nससौभं हन्तुमारेभे साल्वं कुरुकुलोद्वह॥ १०/८८/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_088/BhP_10.088.044.m4a", "display_order": 45}, {"id": 6000284045, "chapter_id": 10284, "verse_number": "१०-८८-४४", "content_sanskrit": "ततो निशातमादाय चक्रं कृष्णः सुदर्शनम्।\nआग्नेयास्‍त्रेणाभिमन्त्र्य प्राहिणोत् सौभनाशनम्॥ १०/८८/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_088/BhP_10.088.045.m4a", "display_order": 46}, {"id": 6000284046, "chapter_id": 10284, "verse_number": "१०-८८-४५", "content_sanskrit": "तन्नारायणहस्ताग्य्रान्मुक्तमाग्नेयमन्त्रितम्।\nजज्वालाब्रह्मसदनं ज्वालामालातिभीषणम्॥ १०/८८/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_088/BhP_10.088.046.m4a", "display_order": 47}, {"id": 6000284047, "chapter_id": 10284, "verse_number": "१०-८८-४६", "content_sanskrit": "ततो वैमानिकाः सर्वे ते विहाय विहायसम्।\nसुदर्शनोष्मणा तप्ता दुद्रुवुः सर्वतो दिशम्॥ १०/८८/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_088/BhP_10.088.047.m4a", "display_order": 48}, {"id": 6000284048, "chapter_id": 10284, "verse_number": "१०-८८-४७", "content_sanskrit": "तदर्कशतसङ्काशं सौभं भित्त्वा द्विधा पुरम्।\nभूयो नारायणकरं प्राप भूप सुदर्शनम्॥ १०/८८/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_088/BhP_10.088.048.m4a", "display_order": 49}, {"id": 6000284049, "chapter_id": 10284, "verse_number": "१०-८८-४८", "content_sanskrit": "ततः समुद्रे न्यपतत् पुरं विच्छिन्नबन्धनम्। गदापाणिर्दुराधर्षः साल्वोऽपि प्रत्यदृश्यत।\nतां प्रेषयामास गदां कृष्णमुद्दिश्य दुर्मतिः॥ १०/८८/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_088/BhP_10.088.049.m4a", "display_order": 50}, {"id": 6000284050, "chapter_id": 10284, "verse_number": "१०-८८-४९", "content_sanskrit": "ततो रथं दैत्यबलोपनीतं संस्थाय साल्वो बहुशस्‍त्रसञ्चयम्।\nअवाकिरत् कृष्णशिरस्यनन्तैर्महायुधैश्च व्यननद् हरिर्यथा॥ १०/८८/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_088/BhP_10.088.050.m4a", "display_order": 51}, {"id": 6000284051, "chapter_id": 10284, "verse_number": "१०-८८-५०", "content_sanskrit": "तां गदां प्रेषितां तेन छित्त्वा बाणैस्‍त्रिधा हरिः।\nपाञ्चजन्यमुपाध्माय सिंहनादं व्यनीनदत्॥ १०/८८/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_088/BhP_10.088.051.m4a", "display_order": 52}, {"id": 6000284052, "chapter_id": 10284, "verse_number": "१०-८८-५१", "content_sanskrit": "तं शस्‍त्रपूगैः प्रहरन्तमोजसा साल्वं शरैः शौरिरमोघविक्रमः।\nविद्ध्वाऽच्छिनद् वर्म धनुः शिरोमणिं रथं च शत्रोर्गदया रुरोज ह॥ १०/८८/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_088/BhP_10.088.052.m4a", "display_order": 53}, {"id": 6000284053, "chapter_id": 10284, "verse_number": "१०-८८-५२", "content_sanskrit": "तत्कृष्णहस्तेरितया विचूर्णितं पपात तोये गदया सहस्रधा।\nविसृज्य तं भूतलमास्थितो गदामुद्यम्य साल्वोऽच्युतमभ्यगाद् द्रुतम्॥ १०/८८/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_088/BhP_10.088.053.m4a", "display_order": 54}, {"id": 6000284054, "chapter_id": 10284, "verse_number": "१०-८८-५३", "content_sanskrit": "आधावतो भीमगदस्य बद्धुं भल्लेन छित्वाऽथ रथाङ्गमद्भुतम्।\nवधाय साल्वस्य लयार्कसन्निभं बिभ्रद् बभौ सार्क इवोदयाचलः॥ १०/८८/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_088/BhP_10.088.054.m4a", "display_order": 55}, {"id": 6000284055, "chapter_id": 10284, "verse_number": "१०-८८-५४", "content_sanskrit": "जहार तेनैव शिरःसकुण्डलं किरीटयुक्तं पुरुषायितो हरिः।\nवज्रेण वृत्रस्य यथा पुरन्दरो बभूव हाहेति वचस्तदा नृणाम्॥ १०/८८/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_088/BhP_10.088.055.m4a", "display_order": 56}, {"id": 6000284056, "chapter_id": 10284, "verse_number": "१०-८८-५५", "content_sanskrit": "तस्मिन् निपतिते पापे सौभे चाब्धौ निपातिते।\nदेवदुन्दुभयो नेदुर्ववृर्षुः पुष्पवृष्टयः॥ १०/८८/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_088/BhP_10.088.056.m4a", "display_order": 57}, {"id": 6000284057, "chapter_id": 10284, "verse_number": "१०-८८-५६", "content_sanskrit": "स्तूयमानो मुनिगणैः सूतमागधवन्दिभिः।\nआजगाम वृतः सैन्यैः पुरीं द्वारावतीं हरिः॥ १०/८८/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_088/BhP_10.088.057.m4a", "display_order": 58}, {"id": 6000284058, "chapter_id": 10284, "verse_number": "१०-८८-५७", "content_sanskrit": "सम्प्रविश्य पुरीं रम्यां पताकाखण्डमण्डिताम्।\nअलङ्कृतामलङ्कारैः सिक्तसम्मृष्टचत्वराम्॥ १०/८८/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_088/BhP_10.088.058.m4a", "display_order": 59}, {"id": 6000284059, "chapter_id": 10284, "verse_number": "१०-८८-५८", "content_sanskrit": "पूजितो यदुभिर्वृद्धैः पौरजानपदैस्तथा। रमयन् व्द्यष्टसाहस्रमहिषीः प्रेमविह्वलाः।\nउवास देवकीपुत्रः सानन्दं कुरुनन्दन॥ १०/८८/५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_088/BhP_10.088.059.m4a", "display_order": 60}, {"id": 6000284060, "chapter_id": 10284, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्ध उत्तरार्धेऽष्टाशीतितमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}]