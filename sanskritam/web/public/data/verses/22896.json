[{"id": 7002896000, "chapter_id": 22896, "verse_number": "९-१८१-१", "content_sanskrit": "युधिष्ठिर उवाच ।\nदानान्यन्यानि मे कृष्ण कथयस्व यदूत्तम ।\nमंगल्यानि पवित्राणि सर्वपापहराणि च ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002896001, "chapter_id": 22896, "verse_number": "९-१८१-२", "content_sanskrit": "संसारसागरोत्तारहेतुभूतोऽसि माधव ।\nधर्माधर्मपरिज्ञाने त्वदन्यो नेह कश्चन ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002896002, "chapter_id": 22896, "verse_number": "९-१८१-३", "content_sanskrit": "श्रीकृष्ण उवाच ।\nदानानि बहुरूपाणि कथितानि मया तव ।\nपुनरेव प्रवक्ष्यामि यद्यस्ति तव कौतुकम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002896003, "chapter_id": 22896, "verse_number": "९-१८१-४", "content_sanskrit": "कथितानि मया तुभ्यं कथयिष्यामि यानि च ।\nमहतार्थेन सिध्यंति प्रयच्छंति महत्फलम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002896004, "chapter_id": 22896, "verse_number": "९-१८१-५", "content_sanskrit": "काम्यो दानविधिः पार्थ क्रियमाणः प्रयत्नतः ।\nफलाय मुनिभिः प्रोक्तो विपरीतो भयाय च ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002896005, "chapter_id": 22896, "verse_number": "९-१८१-६", "content_sanskrit": "ज्ञेयं निष्कशतं सर्वदानेषु विधिरुत्तमः ।\nमध्यमस्तु तदर्धेन तदर्द्धेनावरः स्मृतः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002896006, "chapter_id": 22896, "verse_number": "९-१८१-७", "content_sanskrit": "एवं वृक्षरथेंद्राणां धेनोः कृष्णाजिनस्य च ।\nअशक्तस्यापि कृष्टोऽयं पंचसौवर्णिको विधिः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002896007, "chapter_id": 22896, "verse_number": "९-१८१-८", "content_sanskrit": "अतोऽन्यूनेन यो दद्यान्महादानं नराधिप ।\nप्रतिगृह्णाति वा तस्य दुःखशोकावहं भवेत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002896008, "chapter_id": 22896, "verse_number": "९-१८१-९", "content_sanskrit": "आदौ तावत्प्रवक्ष्यामि कालाख्यं पुरुषं तव ।\nसप्तसागरदानं च महाभूतघटन्तथा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002896009, "chapter_id": 22896, "verse_number": "९-१८१-१०", "content_sanskrit": "अर्ध्यप्रदानमंत्रोक्त मात्मप्रतिकृतिस्तथा ।\nसुवर्णाश्वः स्मृतः षष्ठः सुवर्णाश्वरथोऽपरः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002896010, "chapter_id": 22896, "verse_number": "९-१८१-११", "content_sanskrit": "सर्वदानोत्तमं राजन्कृष्णाजिनमथाष्टमम् ।\nविश्वचक्रं च नवमं हैमो गजरथस्तथा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002896011, "chapter_id": 22896, "verse_number": "९-१८१-१२", "content_sanskrit": "एतत्ते दानदशकं वेद्मि पार्थिवसत्तम ।\nदेहि दापय सद्बुदिं दाने नृपनरोत्तम ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002896012, "chapter_id": 22896, "verse_number": "९-१८१-१३", "content_sanskrit": "दानादृते नोपकारो विद्यते धनिनोऽपरः ।\nदीयमानो हि नापैति भूय एवाभिवर्धते ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002896013, "chapter_id": 22896, "verse_number": "९-१८१-१४", "content_sanskrit": "कूप उल्लिख्यमानोऽपि भवत्येव बहूदकः ।\nपुण्यं दिनमथासाद्य भूमिभागे समे शुभे ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002896014, "chapter_id": 22896, "verse_number": "९-१८१-१५", "content_sanskrit": "चतुर्थ्यां वा चतुर्दश्यां विष्ट्यां वा पांडुनंदन ।\nपुमान्कृष्णतिलैः कार्यो रौप्यदंतः सुवर्णदृक् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002896015, "chapter_id": 22896, "verse_number": "९-१८१-१६", "content_sanskrit": "खड्गोद्यतकरो दीर्णो जपा कुसुमकुंडलः ।\nरक्तांबरधरः स्रग्वी शंखमालाविभूषितः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002896016, "chapter_id": 22896, "verse_number": "९-१८१-१७", "content_sanskrit": "तीक्ष्णासिपत्रधनुषा विस्फारितकटीतटः ।\nउपानद्युगयुक्तो हि कृष्णकंबल पार्श्वगः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002896017, "chapter_id": 22896, "verse_number": "९-१८१-१८", "content_sanskrit": "गृहीतमांसपिंडश्च वामे करतले तथा ।\nएवं विधं नरं कृत्वा गृहीतकुसुमांजलिः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002896018, "chapter_id": 22896, "verse_number": "९-१८१-१९", "content_sanskrit": "संपूज्य गंधकुसुमैर्नैवेद्यं विनिवेद्य च ।\nतिलाज्यं जुहुयात्तत्र त्र्यंबकेति च मंत्रतः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002896019, "chapter_id": 22896, "verse_number": "९-१८१-२०", "content_sanskrit": "स्वगृह्योक्तविधानेन शतमष्टोत्तरं यजेत् ।\nयजमानः प्रसन्नात्मा इमं मंत्रमुदीरयेत् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002896020, "chapter_id": 22896, "verse_number": "९-१८१-२१", "content_sanskrit": "सर्वं कलयसे यस्मात्कालस्त्वं तेन भण्यसे ।\nब्रह्मविष्णुशिवादीनां त्वमसाध्योऽसि सुव्रत ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002896021, "chapter_id": 22896, "verse_number": "९-१८१-२२", "content_sanskrit": "पूजितस्त्वं मया भक्त्या प्रार्थितश्च तथा सुखम् ।\nयदुच्यते तव विभो तत्कुरुष्व नमोनमः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002896022, "chapter_id": 22896, "verse_number": "९-१८१-२३", "content_sanskrit": "एवं संपूजयित्वा तं ब्राह्मणाय निवेदयेत् ।\nब्रह्माणं प्रथमं पूज्य वासोभिर्भूषणैस्तथा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002896023, "chapter_id": 22896, "verse_number": "९-१८१-२४", "content_sanskrit": "दक्षिणां शक्तितो दद्यात्प्रणिपत्य विसर्जयेत् ।\nअनेन विधिना यस्तु दानमेतत्प्रयच्छति ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002896024, "chapter_id": 22896, "verse_number": "९-१८१-२५", "content_sanskrit": "नापमृत्युभयं तस्य न च व्याधिकृतं भयम् ।\nभवत्यव्याहतैश्वर्यः सर्वबाधाविवर्जितः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002896025, "chapter_id": 22896, "verse_number": "९-१८१-२६", "content_sanskrit": "देहांते सूर्यभवनं भित्त्वा याति परं पदम् ।\nपुण्यक्षयादिहाभ्येत्य राजा भवति धार्मिकः ।\nसंतत्या च श्रिया युक्तः पुत्रपौत्रसमन्वितः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002896026, "chapter_id": 22896, "verse_number": "९-१८१-२७", "content_sanskrit": "संपूज्य कालपुरुषं विधिवद्द्विजाय दत्त्वा शुभाशुभफलोदयहेतुभूतः ।\nरोगांतरे सकलदोषमये च देही नो वध्यभावमुपगच्छति तत्प्रभावात् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]