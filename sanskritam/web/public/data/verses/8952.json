[{"id": 40005626, "chapter_id": 8952, "verse_number": "1", "content_sanskrit": "तया महत्या यायिन्या ध्वजिन्या वनवासिनः। अर्दिता यूथपा मत्ताः सयूथास्सम्प्रदुद्रुवुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40005627, "chapter_id": 8952, "verse_number": "2", "content_sanskrit": "ऋक्षाः पृषतसङ्घाश्च रुरवश्च समन्ततः। दृश्यन्ते वनराजीषु गिरिष्वपि नदीषु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40005628, "chapter_id": 8952, "verse_number": "3", "content_sanskrit": "स सम्प्रतस्थे धर्मात्मा प्रीतो दशरथात्मजः। वृतो महत्या नादिन्या सेनया चतुरङ्गया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40005629, "chapter_id": 8952, "verse_number": "4", "content_sanskrit": "सागरौघनिभा सेना भरतस्य महात्मनः। महीं सञ्छादयामास प्रावृषि द्यामिवाम्बुदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40005630, "chapter_id": 8952, "verse_number": "5", "content_sanskrit": "तुरङ्गौघैरवतता वारणैश्च महाजवैः। अनालक्ष्या चिरं कालं तस्मिन्काले बभूव भूः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40005631, "chapter_id": 8952, "verse_number": "6", "content_sanskrit": "स यात्वा दूरमध्वानं सुपरिश्रान्तवाहनः। उवाच भरत श्श्रीमान् वसिष्ठं मन्त्रिणां वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40005632, "chapter_id": 8952, "verse_number": "7", "content_sanskrit": "यादृशं लक्ष्यते रूपं यथा चैव श्रुतं मया। व्यक्तं प्राप्ताः स्म तं देशं भरद्वाजो यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40005633, "chapter_id": 8952, "verse_number": "8", "content_sanskrit": "अयं गिरिश्चित्रकूट इयं मन्दाकिनी नदी। एतत्प्रकाशते दूरान्नीलमेघनिभं वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40005634, "chapter_id": 8952, "verse_number": "9", "content_sanskrit": "गिरे स्सानूनि रम्याणि चित्रकूटस्य सम्प्रति। वारणैरवमृद्यन्ते मामकै पर्वतोपमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40005635, "chapter_id": 8952, "verse_number": "10", "content_sanskrit": "मुञ्चन्ति कुसुमान्येते नगाः पर्वतसानुषु। नीला इवातपापाये तोयं तोयधरा घनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40005636, "chapter_id": 8952, "verse_number": "11", "content_sanskrit": "किन्नराचरितं देशं पश्य शत्रुघ्न पर्वतम्। मृगैस्समन्तादाकीर्णं मकरैरिव सागरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40005637, "chapter_id": 8952, "verse_number": "12", "content_sanskrit": "एते मृगगणा भान्ति शीघ्रवेगाः प्रचोदिताः। वायुप्रविद्धा श्शरदि मेघराजिरिवाम्बरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40005638, "chapter_id": 8952, "verse_number": "13", "content_sanskrit": "कुर्वन्ति कुसुमापीडान् शिरस्सु सुरभीनमी। मेघप्रकाशैः फलकैर्दाक्षिणात्या यथा नराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40005639, "chapter_id": 8952, "verse_number": "14", "content_sanskrit": "निष्कूजमिव भूत्वेदं वनं घोरप्रदर्शनम्। अयोध्येव जनाकीर्णा सम्प्रति प्रतिभाति मा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40005640, "chapter_id": 8952, "verse_number": "15", "content_sanskrit": "खुरैरुदीरितो रेणुर्दावं प्रच्छाद्य तिष्ठति। तं वहत्यनिल श्श्रीघ्रं कुर्वन्निव मम प्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40005641, "chapter_id": 8952, "verse_number": "16", "content_sanskrit": "स्यन्दनांस्तुरगोपेतान्सूतमुख्यै रधिष्ठितान्। एतान्सम्पततश्श्रीघ्रं पश्य शत्रुघ्न कानने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40005642, "chapter_id": 8952, "verse_number": "17", "content_sanskrit": "एतान्वित्रासितान्पश्यबर्हिणः प्रियदर्शनान्। एतमाविशत श्श्रीघ्रमधिवासं पतत्रिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40005643, "chapter_id": 8952, "verse_number": "18", "content_sanskrit": "अतिमात्रमयं देशो मनोज्ञः प्रतिभाति मे। तापसानां निवासोऽयं व्यक्तं स्वर्गपथो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40005644, "chapter_id": 8952, "verse_number": "19", "content_sanskrit": "मृगा मृगीभिः सहिता बहवः पृषता वने। मनोज्ञरूपा दृश्यन्ते कुसुमैरिव चित्रिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40005645, "chapter_id": 8952, "verse_number": "20", "content_sanskrit": "साधु सैन्याः प्रतिष्ठन्तां विचिन्वन्तु च कानने। यथा तौ पुरुषव्याघ्रौ दृश्येते रामलक्ष्मणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40005646, "chapter_id": 8952, "verse_number": "21", "content_sanskrit": "भरतस्य वचश्श्रुत्वा पुरुषाश्शस्त्रपाणयः। विविशु स्तद्वनं शूरा धूमं च ददृशु स्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40005647, "chapter_id": 8952, "verse_number": "22", "content_sanskrit": "ते समालोक्य धूमाग्रमूचुर्भरतमागताः। नामनुष्ये भवत्यग्नि र्व्यक्तमत्रैव राघवौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40005648, "chapter_id": 8952, "verse_number": "23", "content_sanskrit": "अथ नाऽत्र नरव्याघ्रौ राजपुत्रौ परन्तपौ। अन्ये रामोपमा स्सन्ति व्यक्तमत्र तपस्विनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40005649, "chapter_id": 8952, "verse_number": "24", "content_sanskrit": "तच्छ्रुत्वा भरतस्तेषां वचनं साधुसम्मतम्। सैन्यानुवाच सर्वांस्तानमित्रबलमर्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40005650, "chapter_id": 8952, "verse_number": "25", "content_sanskrit": "यत्ता भवन्तस्तिष्ठन्तु नेतो गन्तव्यमग्रतः। अहमेव गमिष्यामि सुमन्त्रो गुरुरेव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40005651, "chapter_id": 8952, "verse_number": "26", "content_sanskrit": "एवमुक्ता स्ततस्सर्वे तत्र तस्थुः समन्तः। भरतो यत्र धूमाग्रं तत्र दृष्टिं समादधात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40005652, "chapter_id": 8952, "verse_number": "27", "content_sanskrit": "व्यवस्थिता या भरतेन सा चमूर्निरीक्षमाणाऽपि च भूमिमग्रतः। बभूव हृष्टा न चिरेण जानती प्रियस्य रामस्य समागमं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]