[{"id": 7006093000, "chapter_id": 26093, "verse_number": "२-३७-१", "content_sanskrit": "तार्क्ष्य उवाच ।\nउदकुम्भप्रदानं मे कथयस्व यथातथम् ।\nविधिना केन कर्तव्या कृतिरेषा जनार्दन ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006093001, "chapter_id": 26093, "verse_number": "२-३७-२", "content_sanskrit": "किंलक्षणाः केन पूर्णाः कस्य देया जनार्दन ।\nकस्मिन् काले प्रदातव्या प्रेततृप्तिप्रसाधकाः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006093002, "chapter_id": 26093, "verse_number": "२-३७-३", "content_sanskrit": "श्रीकृष्ण उवाच ।\nसत्यं पुनः प्रवक्ष्यामि उदकुम्भप्रदानकम् ।\nप्रेतोद्देशेन दातव्या अन्नपानीयसंयुताः ।\nविशेषेण महापक्षिन् प्रेतमुक्तिप्रदायकाः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006093003, "chapter_id": 26093, "verse_number": "२-३७-४", "content_sanskrit": "द्वादशाहे च पण्मासे त्रैपक्षे वापि वत्सरे ।\nउदकुम्भाः प्रदातव्या मार्गे तस्य सुखाय वै ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006093004, "chapter_id": 26093, "verse_number": "२-३७-५", "content_sanskrit": "अहन्यहनि दातव्या उदकुम्भास्तिलैर्युताः ।\nसुलिप्ते भूमिभागे तु पक्कान्नजलपूरिताः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006093005, "chapter_id": 26093, "verse_number": "२-३७-६", "content_sanskrit": "प्रेतस्य तत्र दातव्यं भाजनञ्च यदृच्छया ।\nसुप्रीतस्तेन दत्तेन प्रेतो याम्यैः स गच्छति ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006093006, "chapter_id": 26093, "verse_number": "२-३७-७", "content_sanskrit": "द्वादशाहे विशेषेण उदकम्भान् प्रदापयेत् ।\nविधिना तत्र सङ्कल्पय घटान् द्वादशसंख्यकान् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006093007, "chapter_id": 26093, "verse_number": "२-३७-८", "content_sanskrit": "एकाषि बर्धनी तत्र पक्वान्नफलपूरिता ।\nविष्णुमुद्दिश्य दातव्या संकल्प्य ब्राह्मणे शुभे ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006093008, "chapter_id": 26093, "verse_number": "२-३७-९", "content_sanskrit": "एको वै धर्मराजाय तेन तुष्टेन मुक्तिभाक् ।\nचित्रगुप्ताय चैकं तु गतस्तत्र सुखी भवेत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006093009, "chapter_id": 26093, "verse_number": "२-३७-१०", "content_sanskrit": "षोडशाद्याः प्रदातव्या माषान्नजलपूरिताः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006093010, "chapter_id": 26093, "verse_number": "२-३७-११", "content_sanskrit": "उक्त्रान्तिश्राद्धमारभ्य श्राद्धषोडषोडशकस्य तु ।\nषोडशब्राह्मणानान्तु एकैकं विनिवदयेत् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006093011, "chapter_id": 26093, "verse_number": "२-३७-१२", "content_sanskrit": "एकादशाहात्प्रभृति देयो नित्यं दृढाह्वयः ।\nपक्वान्नजलपूर्णो हि यावत्संवत्सरं दिनम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006093012, "chapter_id": 26093, "verse_number": "२-३७-१३", "content_sanskrit": "जलपात्राणि वृद्धानि दत्तानिघटकानि च ।\nएका वै वर्धनी तत्र तस्यां पात्रन्तु वंशजम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006093013, "chapter_id": 26093, "verse_number": "२-३७-१४", "content_sanskrit": "वस्त्रेणाच्छादयेत्तान्तु पूजयित्वा सुगन्धिभिः ।\nब्राह्मणेभ्यो विशेषेण जलपूर्णानि दापयेत् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006093014, "chapter_id": 26093, "verse_number": "२-३७-१५", "content_sanskrit": "अहन्यहनि सङ्कल्प्य विधिपूर्वं खगेश्वर ।\nब्राह्मणाय कुलीनाय वेदवृत्तयुताय च ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006093015, "chapter_id": 26093, "verse_number": "२-३७-१६", "content_sanskrit": "विद्यावृत्तवते देयं मूर्खे तन्न कदाचन ।\nसमर्थो वेदवृत्ताढ्यस्तारणे तरणेऽपि च ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]