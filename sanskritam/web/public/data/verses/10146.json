[{"id": 6000146000, "chapter_id": 10146, "verse_number": null, "content_sanskrit": "अथ अष्टमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000146001, "chapter_id": 10146, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.001.m4a", "display_order": 2}, {"id": 6000146002, "chapter_id": 10146, "verse_number": "७-८-१", "content_sanskrit": "अथ दैत्यसुताः सर्वे श्रुत्वा तदनुवर्णितम्।\nजगृहुर्निरवद्यत्वान्नैव गुर्वनुशिक्षितम्॥ ७/८/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.002.m4a", "display_order": 3, "topics": [{"text": "पुनः स्वपुत्रं प्रह्लादं हन्तुमुद्युक्तस्य हिरण्यकशिपोः तत्क्षणे स्तम्भादाविर्भूतेन नृसिंहरूपिणा हरिणा हननम्", "range": "१–३८"}]}, {"id": 6000146003, "chapter_id": 10146, "verse_number": "७-८-२", "content_sanskrit": "अथाचार्यसुतस्तेषां बुद्धिमेकान्तसंस्थिताम्।\nआलक्ष्य भीतस्त्वरितो राज्ञ आवेदयद् यथा॥ ७/८/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.003.m4a", "display_order": 4}, {"id": 6000146004, "chapter_id": 10146, "verse_number": "७-८-३", "content_sanskrit": "श्रुत्वा तदप्रियं दैत्यो दुस्सहं तनयानयम्।\nकोपावेशचलद्गात्रः पुत्रं हन्तुं मनो दधे॥ ७/८/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.004.m4a", "display_order": 5}, {"id": 6000146005, "chapter_id": 10146, "verse_number": "७-८-४", "content_sanskrit": "क्षिप्त्वा परुषया वाचा प्रह्लादमतदर्हणम्।\nआहेक्षमाणः पापेन तिरश्चीनेन चक्षुषा॥ ७/८/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.005.m4a", "display_order": 6}, {"id": 6000146006, "chapter_id": 10146, "verse_number": "७-८-५", "content_sanskrit": "प्रश्रयावनतं दान्तं बद्धाञ्जलिमवस्थितम्।\nसर्पः पदाहत इव श्वसन् प्रकृतिदारुणः॥ ७/८/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.006.m4a", "display_order": 7}, {"id": 6000146007, "chapter_id": 10146, "verse_number": null, "content_sanskrit": "हिरण्यकशिपुरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.007.m4a", "display_order": 8}, {"id": 6000146008, "chapter_id": 10146, "verse_number": "७-८-६", "content_sanskrit": "हे दुर्विनीत मन्दात्मन् कुलभेदकराधम।\nस्तब्धं मच्छासनोद्धूतं नेष्ये त्वाऽद्य यमक्षयम्॥ ७/८/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.008.m4a", "display_order": 9}, {"id": 6000146009, "chapter_id": 10146, "verse_number": "७-८-७", "content_sanskrit": "क्रुद्धस्य यस्य कम्पन्ते त्रयो लोकाः सहेश्वराः।\nतस्य मेऽभिहितं मूढ शासनं किम्बलोऽत्यगाः॥ ७/८/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.009.m4a", "display_order": 10}, {"id": 6000146010, "chapter_id": 10146, "verse_number": null, "content_sanskrit": "प्रह्लाद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.010.m4a", "display_order": 11}, {"id": 6000146011, "chapter_id": 10146, "verse_number": "७-८-८", "content_sanskrit": "न केवलं मे भवतश्च राजन् स वै बलं बलिनां चापरेषाम्।\nपरावरेषांस्थिरजङ्गमा ये ब्रह्मादयो येन वशं प्रणीताः॥ ७/८/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.011.m4a", "display_order": 12}, {"id": 6000146012, "chapter_id": 10146, "verse_number": "७-८-९", "content_sanskrit": "स ईश्वरः काल उरुक्रमोऽसावोजःसहःसत्त्वबलेन्द्रियात्मा।\nस एव विश्वं परमः स्वशक्तिभिः सृजत्यवत्यत्ति गुणत्रयेशः॥ ७/८/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.012.m4a", "display_order": 13}, {"id": 6000146013, "chapter_id": 10146, "verse_number": "७-८-१०", "content_sanskrit": "जह्यासुरं भावमिमं स्वमात्मनः समं मनो धत्स्व न सन्ति विद्विषः।\nऋतेऽजितादात्मन उत्पथस्थितात् तद् विद्ध्यनन्तस्य महत् समर्हणम्॥ ७/८/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.013.m4a", "display_order": 14}, {"id": 6000146014, "chapter_id": 10146, "verse_number": "७-८-११", "content_sanskrit": "दस्यून् पुरं षण्णविजित्य लुम्पतो मन्यन्त एके स्वजिता दिशो दश।\nजितात्मनो ज्ञस्य समस्य देहिनां साधोः स्वमोहप्रभवाः कुतः परे॥ ७/८/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.014.m4a", "display_order": 15}, {"id": 6000146015, "chapter_id": 10146, "verse_number": null, "content_sanskrit": "हिरण्यकशिपुरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.015.m4a", "display_order": 16}, {"id": 6000146016, "chapter_id": 10146, "verse_number": "७-८-१२", "content_sanskrit": "व्यक्तं त्वं मर्तुकामोऽसि योऽतिमात्रं विकत्थसे।\nमुमूर्षूणां हि मन्दात्मन् ननु स्युर्विप्लवा गिरः॥ ७/८/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.016.m4a", "display_order": 17}, {"id": 6000146017, "chapter_id": 10146, "verse_number": "७-८-१३", "content_sanskrit": "यस्त्वया मन्दभाग्योक्तो मदन्यो जगदीश्वरः।\nक्‍वासौ यदि स सर्वत्र कस्मात् स्तम्भे न दृश्यते॥ ७/८/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.017.m4a", "display_order": 18}, {"id": 6000146018, "chapter_id": 10146, "verse_number": "७-८-१४", "content_sanskrit": "सोऽहं विकत्थमानस्य शिरः कायाद्धरामि ते।\nगोपायेत हरिस्त्वाऽद्य यस्ते शरणमीप्सितः॥ ७/८/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.018.m4a", "display_order": 19}, {"id": 6000146019, "chapter_id": 10146, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.019.m4a", "display_order": 20}, {"id": 6000146020, "chapter_id": 10146, "verse_number": "७-८-१५", "content_sanskrit": "एवं दुरुक्तैर्मुहुरर्दयन् रुषा सुतं महाभागवतं महासुरः।\nखड्गं प्रगृह्योत्पतितो वरासनात् स्तम्भं तताडातिबलः स्वमुष्टिना॥ ७/८/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.020.m4a", "display_order": 21}, {"id": 6000146021, "chapter_id": 10146, "verse_number": "७-८-१६", "content_sanskrit": "तदैव तस्मिन् निनदोऽतिभीषणो बभूव येनाण्डकटाहमस्फुटत्।\nयं वै स्वधिष्ण्योपगतं ह्यजादयः श्रुत्वा स्वधामाप्ययमङ्ग मेनिरे॥ ७/८/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.021.m4a", "display_order": 22}, {"id": 6000146022, "chapter_id": 10146, "verse_number": "७-८-१७", "content_sanskrit": "अभिक्रमन् पुत्रवधेप्सुरोजसा निशम्य निर्ह्रादमपूर्वमद्भुतम्।\nअन्तः सभायां न ददर्श तत्पदं वितत्रसुर्येन सुरारियूथपाः॥ ७/८/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.022.m4a", "display_order": 23}, {"id": 6000146023, "chapter_id": 10146, "verse_number": "७-८-१८", "content_sanskrit": "सत्यं विधातुं निजभृत्यभाषितं व्याप्तिं च भूतेष्वखिलेषु चात्मनः।\nअदृश्यतात्यद्भुतरूपमुद्वहन् स्तम्भे सभायां नमृगं नमानुषम्॥ ७/८/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.023.m4a", "display_order": 24}, {"id": 6000146024, "chapter_id": 10146, "verse_number": "७-८-१९", "content_sanskrit": "स सत्त्वमेवं परितो विपश्यन् स्तम्भस्य मध्यादनु निर्जिहानम्।\nनायं मृगो नापि नरो विचित्रमहो किमेतन्नृमृगेन्द्ररूपम्॥ ७/८/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.024.m4a", "display_order": 25}, {"id": 6000146025, "chapter_id": 10146, "verse_number": "७-८-२०", "content_sanskrit": "मीमांसमानस्य समुत्थितोऽग्रतो नृसिंहरूपस्तदलं भयानकम्।\nप्रतप्तचामीकरचण्डलोचनं स्फुरत्सटाकेसरजृम्भिताननम्॥ ७/८/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.025.m4a", "display_order": 26}, {"id": 6000146026, "chapter_id": 10146, "verse_number": "७-८-२१", "content_sanskrit": "करालदंष्ट्रं करवालचञ्चलं क्षुरान्तजिह्वं भ्रुकुटीमुखोल्बणम्।\nस्तब्धोर्ध्वकर्णं गिरिकन्दराद्भुतव्यात्तास्यनासं हनुभेदभीषणम्॥ ७/८/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.026.m4a", "display_order": 27}, {"id": 6000146027, "chapter_id": 10146, "verse_number": "७-८-२२", "content_sanskrit": "दिवि स्पृशत्कायमदीर्घपीवरग्रीवोरुवक्षःस्थलमल्पमध्यमम्।\nचन्द्रांशुगौरैश्छुरितं तनूरुहैर्विष्वग्भुजानीकशतैर्नखायुधम्॥ ७/८/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.027.m4a", "display_order": 28}, {"id": 6000146028, "chapter_id": 10146, "verse_number": "७-८-२३", "content_sanskrit": "दुरासदं सर्वनिजेतरायुधप्रवेकविद्रावितदैत्यदानवम्।\nप्रायेण मेऽयं हरिणौरसारिणा वधः स्मृतोऽनेन समुद्यतस्य किम्॥ ७/८/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.028.m4a", "display_order": 29}, {"id": 6000146029, "chapter_id": 10146, "verse_number": "७-८-२४", "content_sanskrit": "एवं ब्रुवंस्त्वभ्यपतद् गदायुधो नदन् नृसिंहं प्रति दैत्यकुञ्जरः।\nअलक्षितोऽग्नौ पतितः पतङ्गमो यथा नृसिंहौजसि सोऽसुरस्तथा॥ ७/८/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.029.m4a", "display_order": 30}, {"id": 6000146030, "chapter_id": 10146, "verse_number": "७-८-२५", "content_sanskrit": "न तद् विचित्रं खलु सत्वधामनि स्वतेजसांऽशेन पुराऽपिबत् तमः।\nततोऽभिपद्याभ्यहनन्महासुरो रुषा नृसिंहं गदयोरुवेगया॥ ७/८/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.030.m4a", "display_order": 31}, {"id": 6000146031, "chapter_id": 10146, "verse_number": "७-८-२६", "content_sanskrit": "तं विक्रमन्तं सगदं गदाधरो महोरगं तार्क्ष्यसुतो यथाऽग्रहीत्।\nस तस्य हस्तोत्कलितस्तदाऽसुरो विक्रीडतो यद्वदहिर्गरुत्मतः॥ ७/८/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.031.m4a", "display_order": 32}, {"id": 6000146032, "chapter_id": 10146, "verse_number": "७-८-२७", "content_sanskrit": "असाध्वमन्यन्त हृतौजसोऽमरा घनच्छदा भारत सर्वधिष्ण्यपाः।\nतं मन्यमानो निजवीर्यशङ्कितं यद्धस्तमुक्तो नृहरिं महासुरः॥ ७/८/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.032.m4a", "display_order": 33}, {"id": 6000146033, "chapter_id": 10146, "verse_number": "७-८-२८", "content_sanskrit": "पुनस्तमासज्जत खड्गचर्मणी प्रगृह्य वेगेन गतश्रमो मृधे।\nतं श्येनवेगं शतचन्द्रचर्मभिश्चरन्तमच्छिद्रमुपर्यधो हरिः॥ ७/८/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.033.m4a", "display_order": 34}, {"id": 6000146034, "chapter_id": 10146, "verse_number": "७-८-२९", "content_sanskrit": "कृत्वाऽट्टहासं खरकेसरोल्बणो निमीलिताक्षं जगृहे महाजवः।\nविष्वक् स्फुरन्तं ग्रहणातुरं हरिर्व्यालो यथाऽऽखुं कुलिशाक्षतत्वचम्॥ ७/८/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.034.m4a", "display_order": 35}, {"id": 6000146035, "chapter_id": 10146, "verse_number": "७-८-३०", "content_sanskrit": "द्वार्यूरवापात्य ददार लीलया नखैर्यथाऽहिं गरुडो महाविषम्।\nसंरम्भदुष्प्रेक्ष्यकराललोचनो व्यात्ताननान्तं विलिहन् स्वजिह्वया॥ ७/८/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.035.m4a", "display_order": 36}, {"id": 6000146036, "chapter_id": 10146, "verse_number": "७-८-३१", "content_sanskrit": "असृग्वसाक्तारुणकेसराननो यथाऽऽन्त्रमाली द्विपहत्यया हरिः।\nनखाङ्कुरोत्पाटितहृत्सरोरुहं विसृज्य तस्यानुचरानुदायुधान्॥ ७/८/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.036.m4a", "display_order": 37}, {"id": 6000146037, "chapter_id": 10146, "verse_number": "७-८-३२", "content_sanskrit": "अहन् समन्तान्नखशस्‍त्रपाणिभिर्दोर्दण्डयूथानुपथान् सहस्रशः।\nसटावधूता जलदाः परापतन् ग्रहाश्च तद्दृष्टिविनष्टरोचिषः॥ ७/८/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.037.m4a", "display_order": 38}, {"id": 6000146038, "chapter_id": 10146, "verse_number": "७-८-३३", "content_sanskrit": "अम्भोधयः श्वासहता विचुक्षुभुर्निर्ह्रादभीता दिगिभा जहुर्दिशः।\nद्यौस्तत्सटाक्षिप्तविमानसङ्कुला प्रोत्सर्पत क्ष्मा च पदाऽतिपीडिता॥ ७/८/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.038.m4a", "display_order": 39}, {"id": 6000146039, "chapter_id": 10146, "verse_number": "७-८-३४", "content_sanskrit": "शैलाः समुत्पेतुरमुष्य रंहसा तत्तेजसा खं ककुभो न रेजिरे।\nततः सभायामुपविष्टमुत्तमे नृपासने सम्भृततेजसं विभुम्॥ ७/८/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.039.m4a", "display_order": 40}, {"id": 6000146040, "chapter_id": 10146, "verse_number": "७-८-३५", "content_sanskrit": "अलक्षितद्वैरथमत्यमर्षणं प्रचण्डवक्त्रं न बभाज कश्चन।\nनिशाम्य लोकत्रयमस्तकज्वरं तमादिदैत्यं हरिणा हतं मृधे॥ ७/८/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.040.m4a", "display_order": 41}, {"id": 6000146041, "chapter_id": 10146, "verse_number": "७-८-३६", "content_sanskrit": "प्रहर्षवेगोत्कलितानना मुहुः प्रसूनवर्षैर्ववृषुः सुरस्‍त्रियः।\nतदा विमानावलिभिर्नभःस्थलं दिदृक्षतां सङ्कुलमास नाकिनाम्॥ ७/८/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.041.m4a", "display_order": 42}, {"id": 6000146042, "chapter_id": 10146, "verse_number": "७-८-३७", "content_sanskrit": "सुरानका दुन्दुभयो विनेदिरे गन्धर्वमुख्या ननृतुर्जगुः स्रियः॥ ७/८/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.042.m4a", "display_order": 43}, {"id": 6000146043, "chapter_id": 10146, "verse_number": "७-८-३८", "content_sanskrit": "त उपव्रज्य विबुधा ब्रह्मेन्द्रगिरिशादयः।\nऋषयः पितरः सिद्धा विद्याधरमहोरगाः॥ ७/८/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.043.m4a", "display_order": 44}, {"id": 6000146044, "chapter_id": 10146, "verse_number": "७-८-३९", "content_sanskrit": "मनवः प्रजानां पतयो गन्धर्वाप्सरचारणाः।\nयक्षाः किम्पुरुषास्तात वेतालाः सहकिन्नराः॥ ७/८/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.044.m4a", "display_order": 45, "topics": [{"text": "ब्रह्मरुद्रादिदेवैर्नृसिंहस्तवनम्", "range": "३९–५७"}]}, {"id": 6000146045, "chapter_id": 10146, "verse_number": "७-८-४०", "content_sanskrit": "ते विष्णुपार्षदाः सर्वे सुनन्दकुमुदादयः। मूर्ध्नि बद्धाञ्जलिपुटा आसीनं तीव्रतेजसम्।\nईडिरे नरशार्दूलं नातिदूरचराः पृथक्॥ ७/८/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.045.m4a", "display_order": 46}, {"id": 6000146046, "chapter_id": 10146, "verse_number": null, "content_sanskrit": "ब्रह्मोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.046.m4a", "display_order": 47}, {"id": 6000146047, "chapter_id": 10146, "verse_number": "७-८-४१", "content_sanskrit": "नतोऽस्म्यनन्ताय दुरन्तशक्तये विचित्रवीर्याय पवित्रकर्मणे।\nविश्वस्य सर्गस्थितिसंयमान् गुणैः स्वलीलया सन्दधतेऽव्ययात्मने॥ ७/८/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.047.m4a", "display_order": 48}, {"id": 6000146048, "chapter_id": 10146, "verse_number": null, "content_sanskrit": "रुद्र उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.048.m4a", "display_order": 49}, {"id": 6000146049, "chapter_id": 10146, "verse_number": "७-८-४२", "content_sanskrit": "कोपकालो युगान्तस्ते हतोऽयमसुरोऽल्पकः।\nतत्सुतं पाह्यनुसृतं भक्तं ते भक्तवत्सल॥ ७/८/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.049.m4a", "display_order": 50}, {"id": 6000146050, "chapter_id": 10146, "verse_number": null, "content_sanskrit": "इन्द्र उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.050.m4a", "display_order": 51}, {"id": 6000146051, "chapter_id": 10146, "verse_number": "७-८-४३", "content_sanskrit": "प्रत्यानीताः परम भवता त्रायता नः स्वभागा दैत्याक्रान्तं हृदयकमलं त्वद्गृहं प्रत्यबोधि।\nकालग्रस्तं कियदिदमहो नाथ शुश्रूषतां ते मुक्तिस्तेषां न हि बहुमता नारसिंहापरैः किम्॥ ७/८/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.051.m4a", "display_order": 52}, {"id": 6000146052, "chapter_id": 10146, "verse_number": null, "content_sanskrit": "ऋषय ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.052.m4a", "display_order": 53}, {"id": 6000146053, "chapter_id": 10146, "verse_number": "७-८-४४", "content_sanskrit": "त्वं नस्तपः परममात्थ यदात्मतेजो येनेदमादिपुरुषात्मगतं समस्तम्।\nतद् विप्रलुप्तममुनाद्य शरण्यपाल रक्षागृहीतवपुषा पुनरन्वमंस्थाः॥ ७/८/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.053.m4a", "display_order": 54}, {"id": 6000146054, "chapter_id": 10146, "verse_number": null, "content_sanskrit": "पितर ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.054.m4a", "display_order": 55}, {"id": 6000146055, "chapter_id": 10146, "verse_number": "७-८-४५", "content_sanskrit": "श्राद्धानि नोऽधिबुभुजे प्रसभं तनूजैर्दत्तानि तीर्थसमयेऽपि तिलाम्बु चापिबत्।\nतस्योदरान्नखविदीर्णवपाद् य आर्च्छत् तस्मै नमो भगवतेऽखिलकर्मगोप्त्रे॥ ७/८/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.055.m4a", "display_order": 56}, {"id": 6000146056, "chapter_id": 10146, "verse_number": null, "content_sanskrit": "सिद्धा ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.056.m4a", "display_order": 57}, {"id": 6000146057, "chapter_id": 10146, "verse_number": "७-८-४६", "content_sanskrit": "यो नो गतिं योगसिद्धामसाधुरहार्षीद् योगतपोबलेन।\nनानादर्पं तं नखैर्विर्ददार तस्मै तुभ्यं प्रणताः स्मो नृसिंह॥ ७/८/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.057.m4a", "display_order": 58}, {"id": 6000146058, "chapter_id": 10146, "verse_number": null, "content_sanskrit": "विद्याधरा ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.058.m4a", "display_order": 59}, {"id": 6000146059, "chapter_id": 10146, "verse_number": "७-८-४७", "content_sanskrit": "विद्यां पृथग्धारणयाऽनुरुद्धां न्यषेधदज्ञो बलवीर्यदृप्तः।\nस येन सङ्ख्ये पशुवद्धतस्तं महानृसिंहं प्रणताः स्म नित्यम्॥ ७/८/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.059.m4a", "display_order": 60}, {"id": 6000146060, "chapter_id": 10146, "verse_number": null, "content_sanskrit": "नागा ऊचुः —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.060.m4a", "display_order": 61}, {"id": 6000146061, "chapter_id": 10146, "verse_number": "७-८-४८", "content_sanskrit": "येन पापेन रत्नानि स्‍त्रीरत्नानि हृतानि नः।\nतद्वक्षःपाटनेनासां दत्तानन्द नमोऽस्तु ते॥ ७/८/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.061.m4a", "display_order": 62}, {"id": 6000146062, "chapter_id": 10146, "verse_number": null, "content_sanskrit": "मनव ऊचुः —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.062.m4a", "display_order": 63}, {"id": 6000146063, "chapter_id": 10146, "verse_number": "७-८-४९", "content_sanskrit": "मनवो वयं तव निदेशकारिणो दितिजेन देव परिभूतसेतवः।\nभवता खलः स उपसंहृतः प्रभो करवाम ते किमनुशाधि किङ्करान्॥ ७/८/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.063.m4a", "display_order": 64}, {"id": 6000146064, "chapter_id": 10146, "verse_number": null, "content_sanskrit": "प्रजापतय ऊचुः —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.064.m4a", "display_order": 65}, {"id": 6000146065, "chapter_id": 10146, "verse_number": "७-८-५०", "content_sanskrit": "प्रजेशा वयं ते परेशाभिसृष्टा न येन प्रजा वै सृजामो निषिद्धाः।\nस एष त्वया भिन्नवक्षास्तु शेते जगन्मङ्गलं सत्त्वमूर्तेऽवतारः॥ ७/८/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.065.m4a", "display_order": 66}, {"id": 6000146066, "chapter_id": 10146, "verse_number": null, "content_sanskrit": "गन्धर्वा ऊचुः —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.066.m4a", "display_order": 67}, {"id": 6000146067, "chapter_id": 10146, "verse_number": "७-८-५१", "content_sanskrit": "वयं विभो ते नटनाट्यगायका येनात्मसाद् वीर्यबलौजसा कृताः।\nस एष नीतो भवता दशामिमां किमुत्पथस्थः कुशलाय कल्पते॥ ७/८/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.067.m4a", "display_order": 68}, {"id": 6000146068, "chapter_id": 10146, "verse_number": null, "content_sanskrit": "चारणा ऊचुः —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.068.m4a", "display_order": 69}, {"id": 6000146069, "chapter_id": 10146, "verse_number": "७-८-५२", "content_sanskrit": "हरे तवाङ्घ्रिपङ्कजं भवापवर्गमाश्रिताः।\nय एष साधुहृच्छ्रयस्त्वयाऽसुरः समापितः॥ ७/८/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.069.m4a", "display_order": 70}, {"id": 6000146070, "chapter_id": 10146, "verse_number": null, "content_sanskrit": "यक्षा ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.070.m4a", "display_order": 71}, {"id": 6000146071, "chapter_id": 10146, "verse_number": "७-८-५३", "content_sanskrit": "वयमनुचरमुख्याः कर्मभिस्ते मनोज्ञैस्त इह दितिसुतेन प्रापिता वाहकत्वम्।\nअनुजनपरितापं तत्कृतं जानता ते नरहर उपनीतः पञ्चतां पञ्चविंश॥ ७/८/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.071.m4a", "display_order": 72}, {"id": 6000146072, "chapter_id": 10146, "verse_number": null, "content_sanskrit": "किंपुरुषा ऊचुः —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.072.m4a", "display_order": 73}, {"id": 6000146073, "chapter_id": 10146, "verse_number": "७-८-५४", "content_sanskrit": "वयं किम्पुरुषास्त्वं तु महापुरुष ईश्वरः।\nअयं कापुरुषो नष्टो धिक्कृतः साधुभिर्यतः॥ ७/८/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.073.m4a", "display_order": 74}, {"id": 6000146074, "chapter_id": 10146, "verse_number": null, "content_sanskrit": "वेताला ऊचुः —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.074.m4a", "display_order": 75}, {"id": 6000146075, "chapter_id": 10146, "verse_number": "७-८-५५", "content_sanskrit": "सभासु सत्रेषु तवामलं यशो गीत्वा सपर्यां महतीं लभामहे।\nयस्तान् व्यनैषीद् भृशमेष दुर्जनो दिष्ट्या हतस्ते भगवन् यथाऽऽमयः॥ ७/८/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.075.m4a", "display_order": 76}, {"id": 6000146076, "chapter_id": 10146, "verse_number": null, "content_sanskrit": "किन्नरा ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.076.m4a", "display_order": 77}, {"id": 6000146077, "chapter_id": 10146, "verse_number": "७-८-५६", "content_sanskrit": "वयमीश किन्नरगणास्तवानुगा दितिजेन विष्टिममुनाऽनुकारिताः।\nभवता हरे सवृजिनोऽपसादितो नरसिंह नाथ विभवाय नो भव॥ ७/८/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.077.m4a", "display_order": 78}, {"id": 6000146078, "chapter_id": 10146, "verse_number": null, "content_sanskrit": "विष्णुपार्षदा ऊचुः —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.078.m4a", "display_order": 79}, {"id": 6000146079, "chapter_id": 10146, "verse_number": "७-८-५७", "content_sanskrit": "अद्यैतद्धरिनररूपमद्भुतं ते दृष्टं नः शरणद सर्वलोकशर्म।\nसोऽयं ते विधिकर ईश विप्रशापात्तस्येदं निधनमनुग्रहाय विद्मः॥ ७/८/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_008/BhP_07.008.079.m4a", "display_order": 80}, {"id": 6000146080, "chapter_id": 10146, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां सप्तमस्कन्धे अष्टमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}]