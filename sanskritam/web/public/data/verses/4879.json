[{"id": 2182909, "chapter_id": 4879, "verse_number": "", "content_sanskrit": "वामदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2182910, "chapter_id": 4879, "verse_number": "१", "content_sanskrit": "अयुद्धेनैव विजयं वर्धयेद् वसुधाधिपः ।\nजघन्यमाहुर्विजयं यो युद्धेन नराधिप\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2182911, "chapter_id": 4879, "verse_number": "२", "content_sanskrit": "नचाप्यलब्धे लिप्सेत मूले नातिदृढे सति ।\nनहि दुर्बलमूलस्य राज्ञो लाभो विधीयते\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2182912, "chapter_id": 4879, "verse_number": "३", "content_sanskrit": "यस्य स्फीतो जनपदः सम्पन्नः प्रियराजकः ।\nसन्तुष्टपुष्टसचिवो दृढमूलः स पार्थिवः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2182913, "chapter_id": 4879, "verse_number": "४", "content_sanskrit": "यस्य योधाः सुसन्तुष्टाः सान्त्विताः सूपवासिताः ।\nअल्पेनापि स दण्डेन महीं जयति भूमिपः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2182914, "chapter_id": 4879, "verse_number": "५", "content_sanskrit": "पौरजानपदा यस्य स्वनुरक्ताः सुपूजिताः ।\nसधना धान्यवन्तश्च दृढमूलः स पार्थिवः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2182915, "chapter_id": 4879, "verse_number": "६", "content_sanskrit": "राष्ट्रकर्मकरा ह्येते राष्ट्रस्य च विरोधिनः ।\nदुर्विनीता विनीताश्च सर्वे साध्याः प्रयत्नतः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2182916, "chapter_id": 4879, "verse_number": "७", "content_sanskrit": "चण्डालम्लेच्छजात्याश्च पाषण्डाश्च विकर्मिणः ।\nबलिनश्चाश्रमाश्चैव तथा गायकनर्तकाः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2182917, "chapter_id": 4879, "verse_number": "८", "content_sanskrit": "प्रभावकालावधिकौ यदा मन्येत चात्मनः ।\nतदा लिप्सेत मेधावी परभूमिं धनान्युत\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2182918, "chapter_id": 4879, "verse_number": "९", "content_sanskrit": "भोगेष्वदयमानस्य भूतेषु च दयावतः ।\nवर्धते त्वरमाणस्य विषयो रक्षितात्मनः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2182919, "chapter_id": 4879, "verse_number": "१०", "content_sanskrit": "तक्षत्यात्मानमेवैष वनं परशुना यथा ।\nयः सम्यग् वर्तमानेषु स्वेषु मिथ्या प्रवर्तते\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2182920, "chapter_id": 4879, "verse_number": "११", "content_sanskrit": "नवै द्विषन्तः क्षीयन्ते राज्ञो नित्यमपि घ्नतः ।\nक्रोधं नियन्तुं यो वेद तस्य द्वेष्टा न विद्यते\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2182921, "chapter_id": 4879, "verse_number": "१२", "content_sanskrit": "यदार्यजनविद्विष्टं कर्म तन्नाचरेद् बुधः ।\nयत् कल्याणमभिध्यायेत् तत्रात्मानं नियोजयेत्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2182922, "chapter_id": 4879, "verse_number": "१३", "content_sanskrit": "नैनमन्येऽवजानन्ति नात्मना परितप्यते ।\nकृत्यशेषेण यो राजा सुखान्यनुबुभूषति\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2182923, "chapter_id": 4879, "verse_number": "१४", "content_sanskrit": "इदं वृत्तं मनुष्येषु वर्तते यो महीपतिः ।\nउभौ लोकौ विनिर्जित्य विजये सम्प्रतिष्ठते\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2182924, "chapter_id": 4879, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2182925, "chapter_id": 4879, "verse_number": "१५", "content_sanskrit": "इत्युक्तो वामदेवेन सर्वं तत् कृतवान् नृपः ।\nतथा कुर्वंस्त्वमप्येतौ लोकौ जेता न संशयः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2182926, "chapter_id": 4879, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि राजधर्मे षण्णवतितमोऽध्यायः ॥ ९६ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]