[{"id": 7004195000, "chapter_id": 24195, "verse_number": "५-१-४४-१", "content_sanskrit": "सनत्कुमार उवाच ।\nअथातः संप्रवक्ष्यामि पद्मावती यथाऽभवत् ।\nशृणुष्व चादृतो व्यास बहुपुण्यकृतां कथाम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004195001, "chapter_id": 24195, "verse_number": "५-१-४४-२", "content_sanskrit": "एकदा सर्वरत्नानां हानिर्जाता दुरात्मभिः ।\nधर्मग्लानिर्निरोधश्च जातो वै दुष्टदानवैः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004195002, "chapter_id": 24195, "verse_number": "५-१-४४-३", "content_sanskrit": "तदा सुरासुरैः सर्वैर्मिलित्वा मथितोंऽबु धिः ।\nमेरुर्वंशोदधिः पात्रं रज्जुर्वासुकिपन्नगः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004195003, "chapter_id": 24195, "verse_number": "५-१-४४-४", "content_sanskrit": "कूर्मपृष्ठे विधिं कृत्वा रत्नानि दुदुहुस्तदा ।\nआदौ लक्ष्मीर्विनिर्याता कृष्णाय प्रतिपादिता॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004195004, "chapter_id": 24195, "verse_number": "५-१-४४-५", "content_sanskrit": "तेन कृत्वा विषादोऽभूद्देवदानवयोस्तदा ।\nएतस्मिन्नंतरे प्राप्तो नारदो देवदर्शनः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004195005, "chapter_id": 24195, "verse_number": "५-१-४४-६", "content_sanskrit": "वारितः कलहस्तेन देवदैत्यसमुद्भवः ।\nमहाकालवने साऽस्तु पद्मा सिंधुसमुद्भवा॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004195006, "chapter_id": 24195, "verse_number": "५-१-४४-७", "content_sanskrit": "सागरांते च रत्नानि तिष्ठंति विविधानि च ।\nतानि सर्वाणि चादाय भवतां वै ददाम्यहम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004195007, "chapter_id": 24195, "verse_number": "५-१-४४-८", "content_sanskrit": "मथ्यतामुदधिः शीघ्रं नात्र कार्या विचारणा ।\nपुनस्ते तूद्यमं चक्रुरमृतार्थं सुरासुराः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004195008, "chapter_id": 24195, "verse_number": "५-१-४४-९", "content_sanskrit": "मथ्यमानेंऽबुधौ तेषां मणिः प्राप्तश्च कौस्तुभः ।\nपरिजाततरुः पश्चात्सुरा जाता ततः परम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004195009, "chapter_id": 24195, "verse_number": "५-१-४४-१०", "content_sanskrit": "धन्वंतरिरथोत्पन्नश्चंद्रो जातोऽपि वै ततः ।\nकामधेनुस्ततो जाता गजरत्नं ततः परम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004195010, "chapter_id": 24195, "verse_number": "५-१-४४-११", "content_sanskrit": "उच्चैःश्रवा हयश्रेष्ठः सुधा रंभा ततस्ततः ।\nततः परं च सारंगं धनुः सर्वास्त्रसंभवम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004195011, "chapter_id": 24195, "verse_number": "५-१-४४-१२", "content_sanskrit": "पांचजन्यस्तथा शंखः करे तिष्ठति मुरद्विषः ।\nनिधिरेष महापद्मो विषं हालाहलं ततः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004195012, "chapter_id": 24195, "verse_number": "५-१-४४-१३", "content_sanskrit": "चतुर्दशापि रत्नानि प्राप्तानि विविधानि च ।\nसमादाय गतास्तत्र यत्र माहेश्वरं वनम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004195013, "chapter_id": 24195, "verse_number": "५-१-४४-१४", "content_sanskrit": "गत्वा ते च समासीना मंत्रं चक्रुः परस्परम् ।\nअहंपूर्वमहंपूर्वमिति ते समयंत्रिताः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004195014, "chapter_id": 24195, "verse_number": "५-१-४४-१५", "content_sanskrit": "कोलाहलस्तथोत्पन्नो नारदः पुनरभ्यगात् ।\nतेषां कलिमलं दृष्ट्वा विष्णुमाराधयत्ततः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004195015, "chapter_id": 24195, "verse_number": "५-१-४४-१६", "content_sanskrit": "मोहनीरूपमास्थाय नारीभूत्वाभ्यगाद्धरिः ।\nअतिरूपवती तन्वी तामालोक्य महासुराः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004195016, "chapter_id": 24195, "verse_number": "५-१-४४-१७", "content_sanskrit": "विह्वलांगाश्च ते सर्वे कामबाणवशंगताः ।\nएतस्मिन्नंतरे तेषां सुरां प्रादात्सुरेश्वरः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004195017, "chapter_id": 24195, "verse_number": "५-१-४४-१८", "content_sanskrit": "हस्तलाघवयोगेन देवानाममृतं ददौ ।\nएतस्मिन्नंतरे व्यास राहुस्तद्रू पधारकः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004195018, "chapter_id": 24195, "verse_number": "५-१-४४-१९", "content_sanskrit": "तेषामंतरगो भूत्वा पपौ चामृतमुत्तमम् ।\nतज्ज्ञात्वा च द्रुतं विष्णुः शिरश्चक्रेण चाच्छिनत्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004195019, "chapter_id": 24195, "verse_number": "५-१-४४-२०", "content_sanskrit": "सुधास्पर्शप्रसंगेन न ममारासुरस्तदा ।\nराहुः केतुरिति ख्यातौ क्षेत्रेऽस्मिन्मुनिसत्तम॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004195020, "chapter_id": 24195, "verse_number": "५-१-४४-२१", "content_sanskrit": "राहुकायात्समुद्भूतं बहु सुस्राव शोणितम् ।\nतस्मिन्क्षेत्रे महत्तीर्थं जातं तद्दोष नाशनम्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004195021, "chapter_id": 24195, "verse_number": "५-१-४४-२२", "content_sanskrit": "तत्र स्नात्वा शुचिर्भूत्वा राहोर्दर्शनतत्पराः ।\nन तेषां जायते किंचिद्राहुपीडा कदाचन॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004195022, "chapter_id": 24195, "verse_number": "५-१-४४-२३", "content_sanskrit": "वांछितार्थमवाप्नोति गोसहस्र फलं भवेत् ।\nततस्तानि च रत्नानि महाकालवने सुराः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004195023, "chapter_id": 24195, "verse_number": "५-१-४४-२४", "content_sanskrit": "विभज्य भागांस्ते सर्वे प्राप्य रत्नभुजोऽभवन् ।\nमणिं पद्मां धनुः शंखं विष्णवे नारदो ददौ॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004195024, "chapter_id": 24195, "verse_number": "५-१-४४-२५", "content_sanskrit": "सूर्याय च ददौ ह्यश्वं सप्तास्यं चाब्धिसंभवम् ।\nऐरावतं गजश्रेष्ठं वासवाय समर्पयत्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004195025, "chapter_id": 24195, "verse_number": "५-१-४४-२६", "content_sanskrit": "पीयूषं दिविषद्गणान्ददौ चंद्रं च शंभवे ।\nपारिजातं तरुश्रेष्ठं रंभां चैव वरांगनाम्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004195026, "chapter_id": 24195, "verse_number": "५-१-४४-२७", "content_sanskrit": "इंद्रक्रीडावने रम्ये नंदने च समर्पयत् ।\nऋषीणां समदाद्धेनुं कामदोग्ध्रीं यज्ञसिद्धये॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004195027, "chapter_id": 24195, "verse_number": "५-१-४४-२८", "content_sanskrit": "निधिरेष महापद्मः कुबेरभवनं गतः ।\nयत्तद्धालाहलं प्रोक्तं विषं केनापि नादृतम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004195028, "chapter_id": 24195, "verse_number": "५-१-४४-२९", "content_sanskrit": "यतोयतः प्रसरति प्रलयं यांति जंतवः ।\nदधार तद्विषं शंभुर्जगतां हितकाम्यया॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004195029, "chapter_id": 24195, "verse_number": "५-१-४४-३०", "content_sanskrit": "तदाप्रभृति महादेवो नीलकंठ इति स्मृतः ।\nरत्नकुंडे नरः स्नात्वा नीलग्रीवं च पश्यति॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004195030, "chapter_id": 24195, "verse_number": "५-१-४४-३१", "content_sanskrit": "मुक्त्वा स सर्वपापेभ्यः सर्वरत्नभुजो भवेत् ।\nशताश्वमेधिकं पुण्यं लब्ध्वा शिवपुरं व्रजेत्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004195031, "chapter_id": 24195, "verse_number": "५-१-४४-३२", "content_sanskrit": "तदादाय सुराः सर्वे ब्रह्मविष्णुपुरोगमाः ।\nऊचुश्च ते तदा व्यास हर्षनिर्भरमानसाः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004195032, "chapter_id": 24195, "verse_number": "५-१-४४-३३", "content_sanskrit": "उज्जयिनीं समासाद्य जाता रत्नभुजो वयम् ।\nपद्मायाश्च निवासेन यस्मात्सर्वसुखावहा॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004195033, "chapter_id": 24195, "verse_number": "५-१-४४-३४", "content_sanskrit": "तस्मात्सर्वेषु कालेषु पद्मा वसतु निश्चला ।\nअद्यप्रभृति पूरेषा पद्मावतीति च स्मृता॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004195034, "chapter_id": 24195, "verse_number": "५-१-४४-३५", "content_sanskrit": "य एतस्यां महाभागाः स्नानं दानं तथार्चनम् ।\nतर्पणं चैव देवानां पितॄणां च विशेषतः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004195035, "chapter_id": 24195, "verse_number": "५-१-४४-३६", "content_sanskrit": "न तेषां दुष्कृतं किंचिन्न दारिद्र्यं न दुर्गतिः ।\nशतं कुलानि सर्वाणि तारयेन्निरयात्तदा॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004195036, "chapter_id": 24195, "verse_number": "५-१-४४-३७", "content_sanskrit": "धनार्थी चैव पुत्रार्थो विद्यार्थो बहुकामुकः ।\nयत्रकुत्र स्थितो भूत्वा पद्मावतीति च स्मरेत्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004195037, "chapter_id": 24195, "verse_number": "५-१-४४-३८", "content_sanskrit": "सर्वान्कामानवाप्नोति शिवः साक्षाद्भवेन्नरः ।\nएतद्व्यास फलं नाम्नः किं चिरं सेवनेन वै॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004195038, "chapter_id": 24195, "verse_number": "५-१-४४-३९", "content_sanskrit": "ये शृण्वंति कथां पुण्यां ये श्रावयंति नित्यशः ।\nन तेषां पातकं किंचिदश्वमेधफलं लभेत्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]