[{"id": 2014607, "chapter_id": 1303, "verse_number": "२-४४-१", "content_sanskrit": "भीष्म उवाच।\nअव्यक्तो व्यक्तलिङ्गस्थो य एव भगवान्प्रभुः।\nनरनारायणो भूत्वा हरिरासीद्युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2014608, "chapter_id": 1303, "verse_number": "२-४४-२", "content_sanskrit": "ब्रह्मा च शक्रः सूर्यश्च धर्मश्चैव सनातनः।\nबहुशः सर्वभूतात्मा प्रादुर्भवति कार्यतः।\nप्रादुर्भावांस्तु वक्ष्यामि दिव्यान्देवगणैर्युतान्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2014609, "chapter_id": 1303, "verse_number": "२-४४-३", "content_sanskrit": "सुप्त्वा युगसहस्रं स प्रादुर्भवति कार्यवान्।\nअनेकबहुसाहस्रैर्देवदेवो जगत्पतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2014610, "chapter_id": 1303, "verse_number": "२-४४-४", "content_sanskrit": "ब्रह्माणं कपिलं चैव परमेष्ठिं तथैव च।\nदेवान्सप्तर्षिभिश्चैव शङ्करं च महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2014611, "chapter_id": 1303, "verse_number": "२-४४-५", "content_sanskrit": "सनत्कुमारं भगवान्मनुं चैव प्रजापतिम्।\nपुरा चक्रे च देवादिः प्रदीप्ताग्निसमप्रभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2014612, "chapter_id": 1303, "verse_number": "२-४४-६", "content_sanskrit": "येन चार्णवमध्यस्थौ नष्टेस्थावरजङ्गमे।\nनष्टदेवासुरवरे प्रनष्टोरगराक्षसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2014613, "chapter_id": 1303, "verse_number": "२-४४-७", "content_sanskrit": "योद्धुकामौ सुदुर्धर्षौ भ्रातरौ मधुकैठभौ।\nहतौ भगवता तेन ततो दत्त्वा वरं परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2014614, "chapter_id": 1303, "verse_number": "२-४४-८", "content_sanskrit": "भूमिं बद्ध्वा कृतौ पूर्वावजेयौ द्वौ महाऽसुरौ।\nतौ कर्णमलसंभूतौ विष्णोस्तस्य महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2014615, "chapter_id": 1303, "verse_number": "२-४४-९", "content_sanskrit": "महार्णवे प्रस्वपतः शैलराजसमौ स्थितौ।\nतौ विवेश स्वयं वायुर्ब्रह्मणा साधु चोदितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2014616, "chapter_id": 1303, "verse_number": "२-४४-१०", "content_sanskrit": "तौ दिवं छादयित्वा तु ववृधाते महाऽसुरौ।\nवायुप्रमाणौ तौ दृष्ट्वा ब्रह्मा पर्यमृशच्छनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2014617, "chapter_id": 1303, "verse_number": "२-४४-११", "content_sanskrit": "एकं मृदुतरं वेत्ति कठिनं वेत्ति चापरम्।\nनामनी तु तयोश्चके सविता सलिलोद्भवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2014618, "chapter_id": 1303, "verse_number": "२-४४-१२", "content_sanskrit": "मृदुस्त्वयं मधुर्नाम कठिनः कैठभः स्वयम्।\nतौ दैत्यौ कृतनामानौ चेरतुर्बलगर्वितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2014619, "chapter_id": 1303, "verse_number": "२-४४-१३", "content_sanskrit": "तौ पुराऽथ दिवं सर्वां प्राप्तौ राजन्महासुरौ।\nप्रच्छाद्याथ दिवं सर्वां चेरतुर्मधुकैठभौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2014620, "chapter_id": 1303, "verse_number": "२-४४-१४", "content_sanskrit": "सर्वमेकार्णवं लोकं योद्धुकामौ सुनिर्भयौ।\nतौ गतावसुरौ दृष्ट्वा ब्रह्मा लोकपितामहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2014621, "chapter_id": 1303, "verse_number": "२-४४-१५", "content_sanskrit": "एकार्णवाम्बुनिचये तत्रैवान्तरधीयत।\nस पद्मात्पद्मनाभस्य नाभिदेशात्समुत्थितात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2014622, "chapter_id": 1303, "verse_number": "२-४४-१६", "content_sanskrit": "आससाद स्वयं जन्म तत्पङ्कजमपङ्कजम्।\nपूजयामास वसतिं ब्रह्मा लोकपितामहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2014623, "chapter_id": 1303, "verse_number": "२-४४-१७", "content_sanskrit": "तावुभौ जलगर्भस्थौ नारायणचतुर्मुखौ।\nबहून्वर्षायुतानप्सु शयानौ न च कम्पितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2014624, "chapter_id": 1303, "verse_number": "२-४४-१८", "content_sanskrit": "अथ दीर्घस्य कालस्य तावुभौ मधुकैठभौ।\nआजग्मतुस्तौ तं देशं यत्र ब्रह्मा व्यवस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2014625, "chapter_id": 1303, "verse_number": "२-४४-१९", "content_sanskrit": "तौ दृष्ट्वा लोकनाथस्तु रोषात्संरक्तलोचनः।\nउत्पपाताथ शयनात्पद्मनाभो महाद्युतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2014626, "chapter_id": 1303, "verse_number": "२-४४-२०", "content_sanskrit": "तद्युद्धमभवद्घोरं तयोस्तस्य च भारत।\nएकार्णवे तदा घोरे त्रैलोक्ये जलतां गते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2014627, "chapter_id": 1303, "verse_number": "२-४४-२१", "content_sanskrit": "तदभूत्तुमुलं युद्धं वर्षसङ्ख्यासहस्रशः।\nन च तावसुरौ युद्धे तदा श्रममवापतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2014628, "chapter_id": 1303, "verse_number": "२-४४-२२", "content_sanskrit": "अथ दीर्घस्य कालस्य तौ दैत्यौ युद्धदुर्मदौ।\nऊचतुः प्रीतमनसौ देवं नारायणं प्रभुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2014629, "chapter_id": 1303, "verse_number": "२-४४-२३", "content_sanskrit": "प्रीतौ स्वस्तव युद्धेन श्लाघ्यस्त्वं मृत्युरावयोः।\nआवां जहि न यत्रोर्वा सलिलेन पिरप्लुता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2014630, "chapter_id": 1303, "verse_number": "२-४४-२४", "content_sanskrit": "हतौ च तव पुत्रत्वं प्राप्नुयाव सुरोत्तम।\nयो ह्यानां युधि निर्जेता तस्यावां विहितौ सुतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2014631, "chapter_id": 1303, "verse_number": "२-४४-२५", "content_sanskrit": "तयोस्तु वचनं श्रुत्वा तदा नारायणः प्रभुः।\nतौ प्रहस्य मृधे दैत्यौ दोर्भ्यां च समपीडयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2014632, "chapter_id": 1303, "verse_number": "२-४४-२६", "content_sanskrit": "ऊरुभ्यां निधनं चक्रे तावुभौ मधुकैठबौ।\nतौ हतौ चाप्लुतौ तोये वपुर्भ्यामेकतां गतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2014633, "chapter_id": 1303, "verse_number": "२-४४-२७", "content_sanskrit": "मेदो मुमुचतुर्दैत्यौ मज्जमानौ जलोर्मिभिः।\nमेदसा तज्जलं व्याप्तं ताभ्यामन्तर्दधे तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2014634, "chapter_id": 1303, "verse_number": "२-४४-२८", "content_sanskrit": "नारायणश्च भगवानसृजद्विविधाः प्रजाः।\nदैत्ययोर्मेदसा छन्ना सर्वा राजन्वसुन्धरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2014635, "chapter_id": 1303, "verse_number": "२-४४-२९", "content_sanskrit": "तदाप्रभृति कौन्तेय मेदिनीति स्मृता मही।\nप्रभावात्पद्मनाभस्य शाश्वती च कृता नृणाम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2014636, "chapter_id": 1303, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि अर्घाहरणपर्वणि चतुश्चत्वारिंशोऽध्यायः॥ ४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]