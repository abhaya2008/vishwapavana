[{"id": 2011864, "chapter_id": 1243, "verse_number": "१-२४४-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2011865, "chapter_id": 1243, "verse_number": "१-२४४-१", "content_sanskrit": "शासनात्पुरुषेन्द्रस्य बलेन महता बली।\nगिरौ रैवतके नित्यं बभूव विपृथुश्रवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2011866, "chapter_id": 1243, "verse_number": "१-२४४-२", "content_sanskrit": "प्रवासे वासुदेवस्य तस्मिन्हलधरोपमः।\nसंबभूव तदा गोप्ता पुरस्य पुरवर्धनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2011867, "chapter_id": 1243, "verse_number": "१-२४४-३", "content_sanskrit": "प्राप्य पाण्डवनिर्याणं निर्ययौ विपृथुश्रवाः।\nनिशम्य पुरनिर्घोषं स्वमनीकमचोदयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2011868, "chapter_id": 1243, "verse_number": "१-२४४-४", "content_sanskrit": "सोऽभिपत्य तदाध्वानं ददर्श पुरुषर्षभम्।\nनिःसृतं द्वारकाद्वारादंशुमन्तमिवाम्बिरात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2011869, "chapter_id": 1243, "verse_number": "१-२४४-५", "content_sanskrit": "सविद्युतमिवाम्भोदं प्रेक्षतां तं धनुर्धरम्।\nपार्थमानर्तयोधानां विस्मयः समपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2011870, "chapter_id": 1243, "verse_number": "१-२४४-६", "content_sanskrit": "उदीर्णरथनागाश्वमनीकमभिवीक्ष्य तत्।\nउवाच परमप्रीता सुभद्रा भद्रभाषिणी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2011871, "chapter_id": 1243, "verse_number": "१-२४४-७", "content_sanskrit": "संग्रहीतुमभिप्रायो दीर्घकालकृतो मम।\nयुध्यमानस्य सङ्ग्रामे रथं तव नरर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2011872, "chapter_id": 1243, "verse_number": "१-२४४-८", "content_sanskrit": "ओजस्तेजोद्युतिबलैरन्वितस्य महात्मनः।\nपार्थ ते सारथित्वेन भविता शिक्षितास्म्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2011873, "chapter_id": 1243, "verse_number": "१-२४४-९", "content_sanskrit": "एवमुक्तः प्रियां प्रीतः प्रत्युवाच नरर्षभः।\nचोदयाश्वानसंसक्तान्विश्तु विपृथोर्बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2011874, "chapter_id": 1243, "verse_number": "१-२४४-१०", "content_sanskrit": "बहुभिर्युध्यमानस्य तावकान्विजिघांसतः।\nपश्य बाहुबलं भद्रे शरान्विक्षिपतो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2011875, "chapter_id": 1243, "verse_number": "१-२४४-११x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2011876, "chapter_id": 1243, "verse_number": "१-२४४-११", "content_sanskrit": "एवमुक्ता तदा भद्रा पार्थेन भरतर्षभ।\nचुचोद साश्वान्संहृष्टा ते ततो विविशुर्बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2011877, "chapter_id": 1243, "verse_number": "१-२४४-१२", "content_sanskrit": "तदाहतमहावाद्यं समुदग्रध्वजायुतम्।\nअनीकं विपृथोर्हृष्टं पार्थमेवान्ववर्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2011878, "chapter_id": 1243, "verse_number": "१-२४४-१३", "content_sanskrit": "रथैर्बहुविधाकारैः सदश्वैश्च महाजवैः।\nकिरन्तः शरवर्षाणि परिवव्रुर्धनञ्जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2011879, "chapter_id": 1243, "verse_number": "१-२४४-१४", "content_sanskrit": "तेषामस्त्राणि संवार्य दिव्यास्त्रेण महास्त्रवित्।\nआवृणोन्महदाकाशं शरैः परपुरञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2011880, "chapter_id": 1243, "verse_number": "१-२४४-१५", "content_sanskrit": "तेषां बाणान्महाबाहुर्मुकुटान्यङ्गदानि च।\nचिच्छेद निशितैर्बाणैः शरांश्चैव धनूंषि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2011881, "chapter_id": 1243, "verse_number": "१-२४४-१६", "content_sanskrit": "युगानीषान्वरूथानि यन्त्राणि विविधानि च।\nअजिघांसन्परान्पार्थश्चिच्छेद निशितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2011882, "chapter_id": 1243, "verse_number": "१-२४४-१७", "content_sanskrit": "विधनुष्कान्विकवचान्विरथांश्च महारथान्।\nकृत्वा पार्थः प्रियां प्रीतः प्रेक्ष्यतामित्यदर्शयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2011883, "chapter_id": 1243, "verse_number": "१-२४४-१८", "content_sanskrit": "सा दृष्ट्वा महदाश्चर्यं सुभद्रा पार्थमब्रवीत्।\nअवाप्तार्थाऽस्मि भद्रं ते याहि पार्थ यथासुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2011884, "chapter_id": 1243, "verse_number": "१-२४४-१९", "content_sanskrit": "स सक्तं पाण्डुपुत्रेण समीक्ष्य विपृथुर्बलम्।\nत्वरमाणोऽभिसंक्रम्य स्थीयतामित्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2011885, "chapter_id": 1243, "verse_number": "१-२४४-२०", "content_sanskrit": "ततः सेनापतेर्वाक्यं नात्यवर्तन्त यादवाः।\nसागरे मारुतोद्धूता वेलामिव महोर्मयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2011886, "chapter_id": 1243, "verse_number": "१-२४४-२१", "content_sanskrit": "ततो रथवरात्तूर्णमवरुह्य नरर्षभः।\nअभिगम्य नरव्याघ्रं प्रहृष्टः परिषस्वजे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2011887, "chapter_id": 1243, "verse_number": "१-२४४-२२", "content_sanskrit": "सोऽब्रवीत्पार्थमासाद्य दीर्घकालमिदं तव।\nनिवासमभिजानामि शङ्खचक्रगदाधरात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2011888, "chapter_id": 1243, "verse_number": "१-२४४-२३", "content_sanskrit": "न मेऽस्त्यविदितं किंचिद्यद्यदाचितं त्वया।\nसुभद्रार्थं प्रलोभेन प्रीतस्तव जनार्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2011889, "chapter_id": 1243, "verse_number": "१-२४४-२४", "content_sanskrit": "प्राप्तस्य यतिलिङ्गेन वासितस्य धनञ्जय।\nबन्धुमानसि रामेण महेन्द्रावरजेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2011890, "chapter_id": 1243, "verse_number": "१-२४४-२५", "content_sanskrit": "मामेव च सदाकाङ्क्षी मन्त्रिणं मधुसूदनः।\nअन्तरेण सुभद्रां च त्वां च तात धनञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2011891, "chapter_id": 1243, "verse_number": "१-२४४-२६", "content_sanskrit": "इमं रथवरं दिव्यं सर्वशस्त्रसमन्वितम्।\nइदमेवानुयात्रं च निर्दिश्य गदपूर्वजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2011892, "chapter_id": 1243, "verse_number": "१-२४४-२७", "content_sanskrit": "अन्तर्द्वीपं तदा वीर गतो वृष्णिसुखावहः।\nदीर्घकालावरुद्धं त्वां संप्राप्तं प्रियया सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2011893, "chapter_id": 1243, "verse_number": "१-२४४-२८", "content_sanskrit": "पश्यन्तु भ्रातरः सर्वे वज्रपाणिमिवामराः।\nआयाते तु दशार्हाणामृषभे शार्ङ्गधन्वनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2011894, "chapter_id": 1243, "verse_number": "१-२४४-२९", "content_sanskrit": "भद्रामनुगमिष्यन्ति रत्नानि च वसूनि च।\nअरिष्टं याहि पन्थानं सुखी भव धनञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2011895, "chapter_id": 1243, "verse_number": "१-२४४-३०", "content_sanskrit": "नष्टशोकैर्विशोकस्य सुहृद्भिः संगमोऽस्तु ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2011896, "chapter_id": 1243, "verse_number": "१-२४४-३१x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2011897, "chapter_id": 1243, "verse_number": "१-२४४-३१", "content_sanskrit": "ततो विपृथुमामन्त्र्य पार्थः प्रीतोऽभिवाद्य च।\nकृष्णस्य मतमास्थाय कृष्णस्य रथमास्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2011898, "chapter_id": 1243, "verse_number": "१-२४४-३२", "content_sanskrit": "पूर्वमेव तु पार्थाय कृष्णेन विनियोजितम्।\nसर्वरत्नसुसंपूर्णं सर्वभोगसमन्वितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2011899, "chapter_id": 1243, "verse_number": "१-२४४-३३", "content_sanskrit": "रथेन काञ्चनाङ्गेन कल्पितेन यथाविधि।\nशैब्यसुग्रीवयुक्तेन किङ्किणीजालमालिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2011900, "chapter_id": 1243, "verse_number": "१-२४४-३४", "content_sanskrit": "सर्वशस्त्रोपपन्नेन जीमूतरवनादिना।\nज्वलनार्चिःप्रकाशेन द्विषतां हर्षनाशिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2011901, "chapter_id": 1243, "verse_number": "१-२४४-३५", "content_sanskrit": "सन्नद्धः कवची खड्गी बद्धगोधाङ्गुलित्रवान्।\nयुक्तः सेनानुयात्रेण रथणारोप्य माधवीम्।\nरथेनाकाशगेनैव पययौ *स्वपुरं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2011902, "chapter_id": 1243, "verse_number": "१-२४४-३६", "content_sanskrit": "ह्रियमाणां तु तां दृष्ट्वा सुभद्रां सैनिका जनाः।\nविक्रोशन्तोऽद्रवन्सर्वे द्वारकामभितः पुरीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2011903, "chapter_id": 1243, "verse_number": "१-२४४-३७", "content_sanskrit": "ते समासाद्य सहिताः सुधर्मामभितः सभाम्।\nसभापालस्य तत्सर्वमाचख्युः पार्थविक्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2011904, "chapter_id": 1243, "verse_number": "१-२४४-३८", "content_sanskrit": "तेषां श्रुत्वा सभापालो भेरीं सान्नाहिकीं ततः।\nसमाजघ्ने महाघोषां जाम्बूनदपरिष्कृताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2011905, "chapter_id": 1243, "verse_number": "१-२४४-३९", "content_sanskrit": "क्षुब्धास्तेनाथ शब्देन भोजवृष्ण्यन्धकास्तदा।\nअन्तर्द्वीपात्समुत्पेतुः सहसा सहितास्तदा।\nअन्नपानमपास्याथ समापेतुः समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2011906, "chapter_id": 1243, "verse_number": "१-२४४-४०", "content_sanskrit": "तत्र जाम्बूनदाङ्गानि स्पर्ध्यास्तरणवन्ति च।\nमणिविद्रुमचित्राणि ज्वलिताग्निप्रभाणि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2011907, "chapter_id": 1243, "verse_number": "१-२४४-४१", "content_sanskrit": "भेजिरे पुरुषव्याघ्रा वृष्ण्यन्धकमहारथाः।\nसिंहासनानि शतशो धिष्ण्यानीव हुताशनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2011908, "chapter_id": 1243, "verse_number": "१-२४४-४२", "content_sanskrit": "तेषां समुपविष्टानां देवानामिव सन्नये।\nआचख्यौ चेष्टितं जिष्णोः सभापालः सहानुगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2011909, "chapter_id": 1243, "verse_number": "१-२४४-४३", "content_sanskrit": "तच्छ्रुत्वा वृष्णिवीरास्ते मदसंरक्तलोचनाः।\nअमृष्यमाणाः पार्थस्य समुत्पेतुरहङ्कृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2011910, "chapter_id": 1243, "verse_number": "१-२४४-४४", "content_sanskrit": "योजयध्वं रथानाशु प्रासानाहरतेति च।\nधनूंषि च महार्हाणि कवचानि बृहन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2011911, "chapter_id": 1243, "verse_number": "१-२४४-४५", "content_sanskrit": "सूतानुच्चुक्रुशुः केचिद्रथान्योजयतेति च।\nस्वयं च तुरगान्केचिदयुञ्जन्हेमभूषितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2011912, "chapter_id": 1243, "verse_number": "१-२४४-४६", "content_sanskrit": "रथेष्वानीयमानेषु कवचेषु ध्वजेषु च।\nअभिक्रन्दे नृवीराणां तदासीत्तुमुलं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2011913, "chapter_id": 1243, "verse_number": "१-२४४-४७", "content_sanskrit": "वनमाली ततः क्षीबः कैलासशिखरोपमः।\nनीलवासा मदोत्सिक्त इदं वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2011914, "chapter_id": 1243, "verse_number": "१-२४४-४८", "content_sanskrit": "किमिदं कुरुथाप्रज्ञास्तूष्णींभूते जनार्दने।\nअस्य भावमविज्ञाय संक्रुद्धा मोघगर्जिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2011915, "chapter_id": 1243, "verse_number": "१-२४४-४९", "content_sanskrit": "एष तावदभिप्रायमाख्यातु स्वं महामतिः।\nयदस्य रुचिरं कर्तुं तत्कुरुध्वमतन्द्रिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2011916, "chapter_id": 1243, "verse_number": "१-२४४-५०", "content_sanskrit": "ततस्ते तद्वचः श्रुत्वा ग्राह्यरूपं हलायुधात्।\nतूष्णींभूतास्ततः सर्वे साधुसाध्विति चाब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2011917, "chapter_id": 1243, "verse_number": "१-२४४-५१", "content_sanskrit": "समं वचो निशम्यैव बलदेवस्य धीमतः।\nपुनरेवसभामध्ये सर्वे ते समुपाविशन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2011918, "chapter_id": 1243, "verse_number": "१-२४४-५२", "content_sanskrit": "ततोऽब्रवीद्वासुदेवं वचो रामः परन्तपः।\nत्रैलोक्यनाथ हे कृष्ण भूतभव्यभविष्यकृत्।\nकिमवागुपविष्टोऽसि प्रेक्षमाणो जनार्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2011919, "chapter_id": 1243, "verse_number": "१-२४४-५३", "content_sanskrit": "सत्कृतस्त्वत्कृते पार्थः सर्वैरस्माभिरच्युत।\nन च सोऽर्हति तां पूजां दुर्बुद्धिः कुलपांसनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2011920, "chapter_id": 1243, "verse_number": "१-२४४-५४", "content_sanskrit": "को हि तत्रैव भुक्तावान्नं भाजनं भेत्तुमर्हति।\nमन्यमानः कुले जातमात्मानं पुरुषः क्वचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2011921, "chapter_id": 1243, "verse_number": "१-२४४-५५", "content_sanskrit": "इच्छन्नेव हि संबन्धं कृतं पूर्वं च मानयन्।\nको हि नाम भवेनार्थी साहसेन समाचरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2011922, "chapter_id": 1243, "verse_number": "१-२४४-५६", "content_sanskrit": "सोऽवमन्य तथाऽस्माकमनादृत्य च केशवम्।\nप्रसह्य हृतवानद्य सुभद्रां मृत्युमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2011923, "chapter_id": 1243, "verse_number": "१-२४४-५७", "content_sanskrit": "कथं हि शिरसो मध्ये कृतं तेन पदं मम।\nमर्षयिष्यामि गोविन्द पादस्पर्शमिवोरगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2011924, "chapter_id": 1243, "verse_number": "१-२४४-५८", "content_sanskrit": "अद्य निष्कौरवामेकः करिष्यामि वसुन्धराम्।\nन हि मे मर्षणीयोऽयमर्जुनस्य व्यतिक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2011925, "chapter_id": 1243, "verse_number": "१-२४४-५९", "content_sanskrit": "तं तथा गर्जमानं तु मेघदुन्दुभिनिःस्वनम्।\nअन्वपद्यन्त ते सर्वे भोजवृष्ण्यन्धकास्तदा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2011926, "chapter_id": 1243, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि सुभद्राहरणपर्वणि चतुश्चत्वारिंशदधिकद्विशततमोऽध्यायः॥ २४४ ॥ ॥ समाप्तं च सुभद्राहरणपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}]