[{"id": 40017405, "chapter_id": 9262, "verse_number": "1", "content_sanskrit": "तयोस्तदासादितयोरणाग्रेमुमोहसैन्यंहरिपुङ्गवानाम् । सुग्रीवनीलाङ्गदजाम्बवन्तो न चापिकिञ्चित्प्रतिपेदिरेते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40017406, "chapter_id": 9262, "verse_number": "2", "content_sanskrit": "ततोविषण्णंसमवेक्ष्यसैन्यंविभीषणोबुद्धिमतांवरिष्ठः । उवाचशाखमृगराजवीरानाश्वासयन्नप्रतिमैर्वचोभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40017407, "chapter_id": 9262, "verse_number": "3", "content_sanskrit": "माभैष्टनास्त्यत्रविषादकालोयदार्यपुत्त्रौविवशौविषण्णौ । स्वयम्भुवोवाक्यमथोद्वहन्तौयत्सादिताविन्द्रजिदस्त्रजालैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40017408, "chapter_id": 9262, "verse_number": "4", "content_sanskrit": "तस्मैतुदत्तंपरमास्त्रमेतत्स्वयम्भुवाब्राह्मममोघवेगम् । तन्मानयन्तौयुधिराजपुत्रौनिपातितौकोऽत्रविषादकालः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40017409, "chapter_id": 9262, "verse_number": "5", "content_sanskrit": "ब्राह्ममस्त्रंततोधीमान्मानयित्वातुमारुतिः । विभीषणवचश्श्रुत्वाहनूमांस्तमथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40017410, "chapter_id": 9262, "verse_number": "6", "content_sanskrit": "एतस्मिन्निहतेसैन्येवानराणांतरस्विनाम् । योयोधारयतेप्राणांस्तंतमाश्वासयाव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40017411, "chapter_id": 9262, "verse_number": "7", "content_sanskrit": "तावुभौयुगपवदीरौहनूमद्राक्षसोत्तमौ । उल्काहस्तौतदारात्रौरणशीर्षेविचेरतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40017412, "chapter_id": 9262, "verse_number": "8", "content_sanskrit": "भिन्नलाङ्गूलहस्तोरुपादाङ्गुळशिरोधरैः । स्रवद्भिःक्षतजंगात्रैःप्रस्रवद्भिस्ततस्ततः ॥ पतितैःपर्वताकारैर्वानरैरभिसङ्कुलाम् । शस्सैश्चपतितैर्दीप्तैर्ददृशातेवसुन्धराम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40017413, "chapter_id": 9262, "verse_number": "9", "content_sanskrit": "भिन्नलाङ्गूलहस्तोरुपादाङ्गुळशिरोधरैः । स्रवद्भिःक्षतजंगात्रैःप्रस्रवद्भिस्ततस्ततः ॥ पतितैःपर्वताकारैर्वानरैरभिसङ्कुलाम् । शस्सैश्चपतितैर्दीप्तैर्ददृशातेवसुन्धराम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40017414, "chapter_id": 9262, "verse_number": "10", "content_sanskrit": "सुग्रीवमङ्गदंनीलंशरभंगन्धमादनम् । गवाक्षं च सुषेणं च वेगदर्शिनमाहुकम् ॥ मैन्दंनळंज्योतिमुखंद्विविदंपनसंतथा । विभीषणोहनूमांश्चददृशातेहतान् रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40017415, "chapter_id": 9262, "verse_number": "11", "content_sanskrit": "सुग्रीवमङ्गदंनीलंशरभंगन्धमादनम् । गवाक्षं च सुषेणं च वेगदर्शिनमाहुकम् ॥ मैन्दंनळंज्योतिमुखंद्विविदंपनसंतथा । विभीषणोहनूमांश्चददृशातेहतान् रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40017416, "chapter_id": 9262, "verse_number": "12", "content_sanskrit": "सप्तषष्टिर्हताःकोट्योवानराणांतरस्विनाम् । अह्नःपञ्चमशेषेणवल्लभेनस्वयम्भुवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40017417, "chapter_id": 9262, "verse_number": "13", "content_sanskrit": "सागरौघनिभंभीमंदृष्टवाबाणार्दितंबलम् । मार्गतेजाम्बवन्तंस्मिहनूमान् सविभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40017418, "chapter_id": 9262, "verse_number": "14", "content_sanskrit": "स्वभावजरयायुक्तंवृद्धंशरशतैश्चितम् । प्रजापतिसुतंवीरंशाम्यन्तमिवपावकम् ॥ दृष्टवातमुपसङ्ग्रम्यपौलस्त्योवाक्यमब्रवीत् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40017419, "chapter_id": 9262, "verse_number": "15", "content_sanskrit": "च्चिदार्यशरैस्तीक्ष्णैर्नप्राणाध्वंसितास्तव ॥ विभीषणवचश्श्रुत्वाजाम्बवानृक्षपुङ्गवः । कृच्छ्रादभ्युग्दिरन्वाक्यमिदंवचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40017420, "chapter_id": 9262, "verse_number": "16", "content_sanskrit": "च्चिदार्यशरैस्तीक्ष्णैर्नप्राणाध्वंसितास्तव ॥ विभीषणवचश्श्रुत्वाजाम्बवानृक्षपुङ्गवः । कृच्छ्रादभ्युग्दिरन्वाक्यमिदंवचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40017421, "chapter_id": 9262, "verse_number": "17", "content_sanskrit": "नैरृतेन्द्रमहावीर्यस्वरेणत्वाऽभिलक्ष्ये । पीड्यमानशशितैर्बाणैर्नत्वापश्यामिचक्षुषा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40017422, "chapter_id": 9262, "verse_number": "18", "content_sanskrit": "अञ्जनासुप्रजायेनमातरिश्वा च नैरृत । हनुमान् वानरश्रेष्ठःप्राणान् धारयतेक्वचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40017423, "chapter_id": 9262, "verse_number": "19", "content_sanskrit": "श्रुत्वाजाम्बवतोवाक्यमुवाचेदंविभीषणः । आर्यपुत्रावतिक्रम्यकस्मात्पृच्छसिमारुतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40017424, "chapter_id": 9262, "verse_number": "20", "content_sanskrit": "नैवराजनिसुग्रीवेनाङ्गदेनापिराघवे । आर्यसन्दर्श