[{"id": 5000262000, "chapter_id": 9262, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे पञ्चषष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000262001, "chapter_id": 9262, "verse_number": "३-६५-१", "content_sanskrit": "तप्यमानं तदा रामं सीताहरणकर्शितम्।\nलोकानामभवे युक्तं सांवर्तकमिवानलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000262002, "chapter_id": 9262, "verse_number": "३-६५-२", "content_sanskrit": "वीक्षमाणं धनुः सज्यं निःश्वसन्तं पुनः पुनः।\nदग्धुकामं जगत् सर्वं युगान्ते च यथा हरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000262003, "chapter_id": 9262, "verse_number": "३-६५-३", "content_sanskrit": "अदृष्टपूर्वं संक्रुद्धं दृष्ट्वा रामं स लक्ष्मणः।\nअब्रवीत् प्राञ्जलिर्वाक्यं मुखेन परिशुष्यता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000262004, "chapter_id": 9262, "verse_number": "३-६५-४", "content_sanskrit": "पुरा भूत्वा मृदुर्दान्तः सर्वभूतहिते रतः।\nन क्रोधवशमापन्नः प्रकृतिं हातुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000262005, "chapter_id": 9262, "verse_number": "३-६५-५", "content_sanskrit": "चन्द्रे लक्ष्मीः प्रभा सूर्ये गतिर्वायौ भुवि क्षमा।\nएतच्च नियतं नित्यं त्वयि चानुत्तमं यशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000262006, "chapter_id": 9262, "verse_number": "३-६५-६", "content_sanskrit": "एकस्य नापराधेन लोकान् हन्तुं त्वमर्हसि।\nननु जानामि कस्यायं भग्नः सांग्रामिको रथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000262007, "chapter_id": 9262, "verse_number": "३-६५-७", "content_sanskrit": "केन वा कस्य वा हेतोः सयुगः सपरिच्छदः।\nखुरनेमिक्षतश्चायं सिक्तो रुधिरबिन्दुभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000262008, "chapter_id": 9262, "verse_number": "३-६५-८", "content_sanskrit": "देशो निर्वृत्तसंग्रामः सुघोरः पार्थिवात्मज।\nएकस्य तु विमर्दोऽयं न द्वयोर्वदतां वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000262009, "chapter_id": 9262, "verse_number": "३-६५-९", "content_sanskrit": "नहि वृत्तं हि पश्यामि बलस्य महतः पदम्।\nनैकस्य तु कृते लोकान् विनाशयितुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000262010, "chapter_id": 9262, "verse_number": "३-६५-१०", "content_sanskrit": "युक्तदण्डा हि मृदवः प्रशान्ता वसुधाधिपाः।\nसदा त्वं सर्वभूतानां शरण्यः परमा गतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000262011, "chapter_id": 9262, "verse_number": "३-६५-११", "content_sanskrit": "को नु दारप्रणाशं ते साधु मन्येत राघव।\nसरितः सागराः शैला देवगन्धर्वदानवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000262012, "chapter_id": 9262, "verse_number": "३-६५-१२", "content_sanskrit": "नालं ते विप्रियं कर्तुं दीक्षितस्येव साधवः।\nयेन राजन् हृता सीता तमन्वेषितुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000262013, "chapter_id": 9262, "verse_number": "३-६५-१३", "content_sanskrit": "मद‍‍‍्द्वितीयो धनुष्पाणिः सहायैः परमर्षिभिः।\nसमुद्रं वा विचेष्यामः पर्वतांश्च वनानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000262014, "chapter_id": 9262, "verse_number": "३-६५-१४", "content_sanskrit": "गुहाश्च विविधा घोराः पद्मिन्यो विविधास्तथा।\nदेवगन्धर्वलोकांश्च विचेष्यामः समाहिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000262015, "chapter_id": 9262, "verse_number": "३-६५-१५", "content_sanskrit": "यावन्नाधिगमिष्यामस्तव भार्यापहारिणम्।\nन चेत् साम्ना प्रदास्यन्ति पत्नीं ते त्रिदशेश्वराः।\nकोसलेन्द्र ततः पश्चात् प्राप्तकालं करिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000262016, "chapter_id": 9262, "verse_number": "३-६५-१६", "content_sanskrit": "शीलेन साम्ना विनयेन सीतां\nनयेन न प्राप्स्यसि चेन्नरेन्द्र।\nततः समुत्सादय हेमपुङ्खै-\nर्महेन्द्रवज्रप्रतिमैः शरौघैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000262017, "chapter_id": 9262, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे पञ्चषष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]