": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40017432, "chapter_id": 9262, "verse_number": "28", "content_sanskrit": "ऋक्ष्वानरवीराणामनीकानिप्रहर्षय । शल्यौकुरुचाप्येतासादितौरामलक्ष्मणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40017433, "chapter_id": 9262, "verse_number": "29", "content_sanskrit": "गत्वापरममध्वानमुपर्युपरिसागरम् । हिमवन्तंनगश्रेष्ठंहनुमन्गन्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40017434, "chapter_id": 9262, "verse_number": "30", "content_sanskrit": "ततःकाञ्चनमत्युच्चमृषभंपर्वतोत्तमम् । कैलासशिखरंचापिद्रक्ष्यस्यरिनिषूदन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40017435, "chapter_id": 9262, "verse_number": "31", "content_sanskrit": "तयोशशिखरयोर्मध्येप्रदीप्तमतुलप्रभम् । सर्यौषधियुतंवीर द्रक्ष्यस्यौषधिपर्यतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40017436, "chapter_id": 9262, "verse_number": "32", "content_sanskrit": "तस्यवानरशार्दूल चतस्रो मूधि सम्भवाः । द्रक्ष्यस्योषधयोदीप्तादीपय्नत्योदिशोदश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40017437, "chapter_id": 9262, "verse_number": "33", "content_sanskrit": "मृतसञ्जीवनींचैवविशल्यकरणीमपि । सुवर्णकरणींचैवसन्धानकरणींतथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40017438, "chapter_id": 9262, "verse_number": "34", "content_sanskrit": "तास्सर्वाहनुमन्गृह्वक्षिप्रमागन्तुमर्हसि । आश्वासयहरीन् प्राणैर्योज्यगन्धवहात्मज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40017439, "chapter_id": 9262, "verse_number": "35", "content_sanskrit": "श्रुत्वाजाम्बवतोवाक्यंहनूमान् हरिपुङ्गवः । आपूर्यतबलोद्धर्षैस्तोयवेगैरिवार्णवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 40017440, "chapter_id": 9262, "verse_number": "36", "content_sanskrit": "पर्वततटाग्रस्थःपीडयन् पर्वतोत्तमम् । हनूमान्दृश्यतेवीरोद्वितीयइवपर्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 40017441, "chapter_id": 9262, "verse_number": "37", "content_sanskrit": "हरिपादविनिर्भग्नोनिषसाद स पर्वतः । न शशाकतदात्मानंसोढुंभृशनिपीडितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 40017442, "chapter_id": 9262, "verse_number": "38", "content_sanskrit": "तस्यपेतुर्नगाभूमौहरिवेगाच्चजज्वलुः । शृङ्गाणि च व्यशीर्यन्तपीडितस्यहनूमता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 40017443, "chapter_id": 9262, "verse_number": "39", "content_sanskrit": "तस्मिन् सम्पीड्यमानेतुभग्नद्रुमशिलातले । न शेकुर्वानरास्स्थातुंघूर्णमानेनगोत्तमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 40017444, "chapter_id": 9262, "verse_number": "40", "content_sanskrit": "साघूर्णितमहाद्वाराप्रभग्नगृहगोपुरा । लङ्कात्रासाकुलारात्रौप्रवृत्तेवाभवत्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 40017445, "chapter_id": 9262, "verse_number": "41", "content_sanskrit": "पृथिवीधरसङ्काशोनिपीड्यधरणीधरम् । पृथिवींक्षोभयामाससार्णवांमारुतात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 40017446, "chapter_id": 9262, "verse_number": "42", "content_sanskrit": "आरुरोहतदातस्माद्धरिर्मलयपर्वतम् । मेरुमन्दरसङ्काशंनानाप्रस्रवणाकुलम् ॥ नानाद्रुमलताकीर्णंविकासिकमलोत्पलम् । सेवितंदेवगन्धर्वैष्षष्टियोजनमुच्छ्रितम् ॥ विद्याधरैर्मुनिगणैरप्सरोभिर्निषेवितम् । नानामृगगणाकीर्णंबहुकन्दरशोभितम् ॥ सर्वानाकुलयंस्तत्रयक्षगन्धर्वकिन्नरान् । हनुमान् मेघसङ्काशोववृधेमारुतात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 40017447, "chapter_id": 9262, "verse_number": "43", "content_sanskrit": "आरुरोहतदातस्माद्धरिर्मलयपर्वतम् । मेरुमन्दरसङ्काशंनानाप्रस्रवणाकुलम् ॥ नानाद्रुमलताकीर्णंविकासिकमलोत्पलम् । सेवितंदेवगन्धर्वैष्षष्टियोजनमुच्छ्रितम् ॥ विद्याधरैर्मुनिगणैरप्सरोभिर्निषेवितम् । नानामृगगणाकीर्णंबहुकन्दरशोभितम् ॥ सर्वानाकुलयंस्तत्रयक्षगन्धर्वकिन्नरान् । हनुमान् मेघसङ्काशोववृधेमारुतात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 40017448, "chapter_id": 9262, "verse_number": "44", "content_sanskrit": "आरुरोहतदातस्माद्धरिर्मलयपर्वतम् । मेरुमन्दरसङ्काशंनानाप्रस्रवणाकुलम् ॥ नानाद्रुमलताकीर्णंविकासिकमलोत्पलम् । सेवितंदेवगन्धर्वैष्षष्टियोजनमुच्छ्रितम् ॥ विद्याधरैर्मुनिगणैरप्सरोभिर्निषेवितम् । नानामृगगणाकीर्णंबहुकन्दरशोभितम् ॥ सर्वानाकुलयंस्तत्रयक्षगन्धर्वकिन्नरान् । हनुमान् मेघसङ्काशोववृधेमारुतात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 40017449, "chapter_id": 9262, "verse_number": "45", "content_sanskrit": "आरुरोहतदातस्माद्धरिर्मलयपर्वतम् । मेरुमन्दरसङ्काशंनानाप्रस्रवणाकुलम् ॥ नानाद्रुमलताकीर्णंविकासिकमलोत्पलम् । सेवितंदेवगन्धर्वैष्षष्टियोजनमुच्छ्रितम् ॥ विद्याधरैर्मुनिगणैरप्सरोभिर्निषेवितम् । नानामृगगणाकीर्णंबहुकन्दरशोभितम् ॥ सर्वानाकुलयंस्तत्रयक्षगन्धर्वकिन्नरान् । हनुमान् मेघसङ्काशोववृधेमारुतात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 40017450, "chapter_id": 9262, "verse_number": "46", "content_sanskrit": "पद्भ्यांतुशैलमापीड्यबडबामुखवन्मुखम् । विवृत्योग्रंननादोच्चैस्त्रासयन्निवराक्षसान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 40017451, "chapter_id": 9262, "verse_number": "47", "content_sanskrit": "तस्यनानद्यमानस्यश्रुत्वानिनदमद्भुतम् । लङ्कास्थाराक्षसास्सर्वे न शेकुस्स्पन्दितुंभयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 40017452, "chapter_id": 9262, "verse_number": "48", "content_sanskrit": "नमस्कृत्वाऽथरामायमारुतिर्भीमविक्रमः । राघवार्थेपरंकर्मसमीहतपरन्तपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 40017453, "chapter_id": 9262, "verse_number": "49", "content_sanskrit": "स पुच्छमुद्यम्यभुजङ्गकल्पंविनम्यपृष्ठंश्रवणेनिकुञ्च्य । विवृत्यवक्त्रंबडबामुखाभमापुफ्लुवेव्योमनिचण्डवेगः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 40017454, "chapter_id": 9262, "verse_number": "50", "content_sanskrit": "सवृक्षषण्डांस्तरसाजहारशैलान् शिलाःप्राकृतवानरांश्च । बाहूरुवेगोद्धतसम्प्रणुन्नास्तेक्षीणवेगास्सलिलेनिपेतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 40017455, "chapter_id": 9262, "verse_number": "51", "content_sanskrit": "तौप्रसार्योरगभोगकल्पौभुजौभुजङ्गारिनिकाशवीर्यः । जगाममेरुंनगराजमग्य्रंदिशःप्रकर्षन्निववायुसूनुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 40017456, "chapter_id": 9262, "verse_number": "52", "content_sanskrit": "स सागरंघूर्णितवीचिमालंतथाभृशंभ्रामितसर्वसत्त्वम् । समीक्षमाणस्सहसाजगामचक्रंयथाविष्णुकराग्रमुक्तम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 40017457, "chapter_id": 9262, "verse_number": "53", "content_sanskrit": "स पर्वतान्वृक्षगवान् सरांसिनदीस्तटाकानिपुरोत्तमानि । स्फीतान् जनान्तानपिसम्प्रवीक्ष्यजगामवेगापतितृतुल्यवेगः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 40017458, "chapter_id": 9262, "verse_number": "54", "content_sanskrit": "आदित्यपथमाश्रित्यजगाम स गतक्लमः । हनूमांस्त्वरितोवीरःपितृतुल्यपराक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 40017459, "chapter_id": 9262, "verse_number": "55", "content_sanskrit": "जवेनमहतायुक्तोमारुतिर्मारुतोयथा । जगामहरिशार्दूलोदिशश्शब्देनपूरयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 40017460, "chapter_id": 9262, "verse_number": "56", "content_sanskrit": "स्म्मरन्जाम्बवतोवाक्यंमारुतिर्वातरंहसा । ददर्शसहसागत्वाहिमवन्तंमहाकपिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 40017461, "chapter_id": 9262, "verse_number": "57", "content_sanskrit": "नानाप्रस्रवणोपेतंनानाकन्दरनिर्घरम् । श्वेताभ्रचयसङ्काशैशशिखरैश्चारुदर्शनैः ॥ शोभितंविविधैर्वृक्षैरगमत्पर्वतोत्तमम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 40017462, "chapter_id": 9262, "verse_number": "58", "content_sanskrit": "स तंसमासाद्यमहानगेन्द्रमतिप्रवृद्धोत्तमघोरशृङ्गम् । ददर्शपुण्यानिमहाश्रमाणिसुरर्षिसंघोत्तमसेवितानि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 40017463, "chapter_id": 9262, "verse_number": "59", "content_sanskrit": "स ब्रह्मकोशंरजतालयं च शक्रालयंरुद्रशरप्रमोक्षम् । हयाननंब्रह्मशिरश्चदीप्तंददर्शवैवस्वतकिङ्करांश्च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 40017464, "chapter_id": 9262, "verse_number": "60", "content_sanskrit": "वज्रालयंवैश्रवणालयं च सूर्यप्रभंसूर्यनिबन्धनंच । a. ब्रह्मासनंशङ्करकार्मुकं च ददर्शनाभिं च वसुन्धरायाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 40017465, "chapter_id": 9262, "verse_number": "61", "content_sanskrit": "कैलासमग्य्रंहिमवच्छिलां च तथर्षभंकाञ्चनशैलमग्य्रम् । सन्दीप्तसर्वौषधिसन्प्रदीप्तंददर्शसर्वौषधिपर्वतेन्द्रम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 40017466, "chapter_id": 9262, "verse_number": "62", "content_sanskrit": "स तंसमीक्ष्यानलरश्मिदीप्तंविसिष्मियेवासवदूतसूनुः । आवृत्यतंचौषधिपर्वतेन्द्रंतत्रौषधीनांविचयंचकार ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 40017467, "chapter_id": 9262, "verse_number": "63", "content_sanskrit": "सयोजनसहस्राणिसमतीत्यमहाकपिः । दिव्यौषधिधरंशैलंव्यचरन्मारुतात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 40017468, "chapter_id": 9262, "verse_number": "64", "content_sanskrit": "महौषध्यस्ततस्सर्वास्तस्मिन् पर्वतसत्तमे । विज्ञायार्थिनमायान्तंततोजग्मुरदर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 40017469, "chapter_id": 9262, "verse_number": "65", "content_sanskrit": "स तामहात्माहनुमानपश्यंश्चुकोपकोपाच्चभृशंननाद । अमृष्यमाणोऽनगिनिकाशचक्षुर्महीधरेन्द्रंतमुवाचवाक्यम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 40017470, "chapter_id": 9262, "verse_number": "66", "content_sanskrit": "कीमेतदेवंसुविनिश्चितंतेयद्राघवेनासिकृतानुकम्प । पश्याद्यमद्बाहुबलाभिभूतोविकीर्णमात्मानमथोनगेन्द्र ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 40017471, "chapter_id": 9262, "verse_number": "67", "content_sanskrit": "स तस्यशृङ्गंसनगंसनागंसकाञ्चनंधातुसहस्रजुष्टम् । विकीर्णकूटंज्वलिताग्रसानुंप्रगृह्यवेगात्सहसोन्ममाथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 40017472, "chapter_id": 9262, "verse_number": "68", "content_sanskrit": "सतसमुत्पाट्यखमुत्पपातवित्रास्यलोकान् ससुरासुरेन्द्रान् । संस्तूयमानःखचरैरनेकैर्जगामवेगाद्गरुडोग्रवेगः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 40017473, "chapter_id": 9262, "verse_number": "69", "content_sanskrit": "स भास्कराध्वानमनुप्रपन्नस्तंभास्कराभंशिखरंप्रगृह्य । बभौतदाभास्करसन्निकाशोरवेस्समीपेप्रतिभास्कराभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 40017474, "chapter_id": 9262, "verse_number": "70", "content_sanskrit": "स तेनशैलेनभृशंरराजशैलोपमोगन्धवहात्मजस्तु । सहस्रधारेणसपावकेनचक्रेणखेविष्णुरिवार्पितेन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 40017475, "chapter_id": 9262, "verse_number": "71", "content_sanskrit": "तंवानराःप्रेक्ष्यविनेदुरुच्चैस्सतानपिप्रेक्ष्यमुदाननाद । तेषांसमुध्घुष्टरवंनिशम्यलङ्कालयाभीमतरंविनेदुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 40017476, "chapter_id": 9262, "verse_number": "72", "content_sanskrit": "ततोमहात्मानिपपाततस्मिन् शैलोत्तमेवानरसैन्यमथ्ये । हर्युत्तमेभ्यशशिरसाऽभिवाद्यविभीषणंतत्र स सस्वजे च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 40017477, "chapter_id": 9262, "verse_number": "73", "content_sanskrit": "तावप्युभौमानुषराजपुत्रौतंगन्धमाघ्रायमहौषधीनाम् । बभूवतुस्तत्रतदाविशल्यावुत्तस्थुरन्ये च हरिप्रवीराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 40017478, "chapter_id": 9262, "verse_number": "74", "content_sanskrit": "सर्वेविशल्याविरुजाःक्षणेनहरिप्रवीराश्चहताश्चयेस्युः । गन्धेनतासांप्रवरौषधीनांसुप्तानिशान्तेष्विवसम्प्रबुद्धाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 40017479, "chapter_id": 9262, "verse_number": "75", "content_sanskrit": "दाप्रभृतिलङ्कायांयुध्यन्तेहरिराक्षसाः । तदाप्रभृतिमानार्थमाज्ञयारावणस्य च ॥ येहन्यन्तेरणेतत्रराक्षसाःकपिकुञ्जरैः । हताहतास्तुक्षिप्यन्तेसर्वएवतुसागरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 40017480, "chapter_id": 9262, "verse_number": "76", "content_sanskrit": "दाप्रभृतिलङ्कायांयुध्यन्तेहरिराक्षसाः । तदाप्रभृतिमानार्थमाज्ञयारावणस्य च ॥ येहन्यन्तेरणेतत्रराक्षसाःकपिकुञ्जरैः । हताहतास्तुक्षिप्यन्तेसर्वएवतुसागरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}]