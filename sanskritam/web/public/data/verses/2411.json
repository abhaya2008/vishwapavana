[{"id": 2066932, "chapter_id": 2411, "verse_number": "९-२९-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2066933, "chapter_id": 2411, "verse_number": "९-२९-१", "content_sanskrit": "निहते मामके सैन्ये निःशेषे शिबिरे कृते।\nपाण्डवानां बले सूत किन्नु शेषमभूत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2066934, "chapter_id": 2411, "verse_number": "९-२९-२", "content_sanskrit": "एतन्मे पृच्छतो ब्रूहि कुशलो ह्यसि सञ्जय।\nयच्च दुर्योधनो मानी कृतवांस्तनयो मम।\nवलक्षयं तथा दृष्ट्वा स एकः पृथिवीपतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2066935, "chapter_id": 2411, "verse_number": "९-२९-३x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2066936, "chapter_id": 2411, "verse_number": "९-२९-३", "content_sanskrit": "रथानां द्वे सहस्रे तु सप्त नागशतानि च।\nपञ्च चाश्वसहस्राणि पत्तीनामयुतानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2066937, "chapter_id": 2411, "verse_number": "९-२९-४", "content_sanskrit": "एतच्छेषमभूद्राजन्पाण्डवानां महद्बलम्।\nपरिगृह्य हि यद्युद्धे धृष्टद्युम्नो व्यवस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2066938, "chapter_id": 2411, "verse_number": "९-२९-५", "content_sanskrit": "एकाकी भरतश्रेष्ठ ततो दुर्योधनो नृपः।\nनापश्यत्समरे कञ्चित्सहायं रथिनां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2066939, "chapter_id": 2411, "verse_number": "९-२९-६", "content_sanskrit": "नर्दमानान्परान्दृष्ट्वा स्वबलस्य च सङ्क्षयम्।\nदृष्ट्वा भरतशार्दूलः कश्मलेनाभिसंवृतः।\nहतं स्वहयमुत्सृज्य प्राङ्मुखः प्राद्रावद्भयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2066940, "chapter_id": 2411, "verse_number": "९-२९-७", "content_sanskrit": "एकादशचमूभर्ता पुत्रो दुर्योधनस्तव।\nगदामादाय तेजस्वी पदातिः प्रस्थितो हदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2066941, "chapter_id": 2411, "verse_number": "९-२९-८", "content_sanskrit": "नातिदूरं ततो गत्वा पद्भ्यामेव नराधिपः।\nसस्मार वचनं क्षत्रुर्धर्मशीलस्य धीमतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2066942, "chapter_id": 2411, "verse_number": "९-२९-९", "content_sanskrit": "इदं नूनं महाप्राज्ञो विदुरो दृष्ट्वान्पुरा।\nमहद्व्सनमस्माकं क्षत्रियाणां च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2066943, "chapter_id": 2411, "verse_number": "९-२९-१०", "content_sanskrit": "एवं विचिन्तयानस्तु प्रविविक्षुर्हदं नृपः।\nदुःखसन्तप्तहृदयो दृष्ट्वा राजन्बलक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2066944, "chapter_id": 2411, "verse_number": "९-२९-११", "content_sanskrit": "`दशैकाक्षौहिणीभर्ता तदा दुर्योधनोऽपि सन्।\nप्राप्तवान्व्यसनं तीव्रं दैवं हि बलवत्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2066945, "chapter_id": 2411, "verse_number": "९-२९-१२", "content_sanskrit": "पाण्डवास्तु महाराज धृष्टद्युम्नपुरोगमाः।\nअभ्यद्रवन्त सङ्क्रुद्धास्तव राजन्बलं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2066946, "chapter_id": 2411, "verse_number": "९-२९-१३", "content_sanskrit": "शक्त्यृष्टिप्रासहस्तानां बलानामभिगर्जताम्।\nसङ्कल्पमकरोन्मोघं गाण्डीवेन धनञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2066947, "chapter_id": 2411, "verse_number": "९-२९-१४", "content_sanskrit": "तान्हत्वा निशितैर्वाणैः सामात्यान्सह बन्धुभिः।\nरथे श्वेतहये तिष्ठन्नर्जुनो बह्वशोभत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2066948, "chapter_id": 2411, "verse_number": "९-२९-१५", "content_sanskrit": "सुबलस्य हते पुत्रे सवाजिरथकुञ्जरे।\nमहावनमिव च्छिन्नमभवत्तावकं बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2066949, "chapter_id": 2411, "verse_number": "९-२९-१६", "content_sanskrit": "अनेकशतसाहस्रे बले दुर्योधनस्य ह।\nनान्यो महारथो राजञ्जीवमानो व्यदृश्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2066950, "chapter_id": 2411, "verse_number": "९-२९-१७", "content_sanskrit": "द्रोणपुत्रादृते वीरात्तथैव कृतवर्मणः।\nकृपाच्च गौतमाद्राजन्पार्थिवाच्च तवात्मजात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2066951, "chapter_id": 2411, "verse_number": "९-२९-१८", "content_sanskrit": "धृष्टद्युम्नस्तु मां दृष्ट्वा हसन्सात्यकिमब्रवीत्।\nकिमनेन गृहीतेन नानेनार्थोऽस्ति जीवता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2066952, "chapter_id": 2411, "verse_number": "९-२९-१९", "content_sanskrit": "धृष्टद्युम्नवचः श्रुत्वा शिनेर्नप्ता महारथः।\nउद्यम्य निशितं खङ्गं हन्तुं मामुद्यतस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2066953, "chapter_id": 2411, "verse_number": "९-२९-२०", "content_sanskrit": "तमागम्य महाप्राज्ञः कृष्णद्वैपायनोऽब्रवीत्।\nमुच्यतां सञ्जयो जीवन्न हन्तव्यः कथञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2066954, "chapter_id": 2411, "verse_number": "९-२९-२१", "content_sanskrit": "द्वैपायनवचः श्रुत्वा शिनेर्नप्ता कृताञ्जलिः।\nततो मामब्रवीन्मुक्त्वा स्वस्ति सञ्जय साधय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2066955, "chapter_id": 2411, "verse_number": "९-२९-२२", "content_sanskrit": "अनुज्ञातस्त्वहं तेन न्यस्तवर्मा निरायुधः।\nप्रातिष्ठं येन नगरं सायाह्ने रुधिरोक्षितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2066956, "chapter_id": 2411, "verse_number": "९-२९-२३", "content_sanskrit": "क्रोशमात्रमपक्रान्तं गदापाणिमवस्थितम्।\nएकं दुर्योधनं राजन्नपश्यं भृशविक्षतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2066957, "chapter_id": 2411, "verse_number": "९-२९-२४", "content_sanskrit": "स तु मामश्रुपूर्णाक्षो नाशक्नोदभिवीक्षितुम्।\nउपप्रैक्षत मां दृष्ट्वा तथा दीनमवस्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2066958, "chapter_id": 2411, "verse_number": "९-२९-२५", "content_sanskrit": "तं चाहमपि शोचन्तं दृष्ट्वैकाकिनमाहवे।\nमुहूर्तं नाशकं वक्तुमतिदुःखपरिप्लुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2066959, "chapter_id": 2411, "verse_number": "९-२९-२६", "content_sanskrit": "`यस्य मूर्धाभिषिक्तानां सहस्रमणिमौलिनाम्।\nआहृत्य च करं सर्वं स्वस्य वेश्म समागतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2066960, "chapter_id": 2411, "verse_number": "९-२९-२७", "content_sanskrit": "चतुःसागरपर्यन्ता पृथिवी रत्नभूषिता।\nकर्णेनैकेन यस्यार्थे करमाहारिता पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2066961, "chapter_id": 2411, "verse_number": "९-२९-२८", "content_sanskrit": "यस्याज्ञा परराष्ट्रेषु कर्णेनैव प्रसारिता।\nनाभवद्यस्य शस्त्रेषु खेदो राज्ञः प्रशासतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2066962, "chapter_id": 2411, "verse_number": "९-२९-२९", "content_sanskrit": "आसीनो हास्तिनपुरे क्षेमं राज्यमकण्टकम्।\nअन्वपालयदैश्वर्यात्कुबेरमपि नास्मरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2066963, "chapter_id": 2411, "verse_number": "९-२९-३०", "content_sanskrit": "भवनाद्भवनं राजन्प्रयातुं पृथिवीपते।\nदेवालयप्रदेशे च पन्था यस्य हिरण्मयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2066964, "chapter_id": 2411, "verse_number": "९-२९-३१", "content_sanskrit": "पताकावृतसूर्यांशुतोरणोच्छ्रितशोभिताः।\nप्रयाणे पृथिवीभर्तुर्धन्यानामभवन्गृहाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2066965, "chapter_id": 2411, "verse_number": "९-२९-३२", "content_sanskrit": "आरुह्यैरावतप्रख्यं नागमिन्द्रसमो बली।\nविभूत्या सुमहत्या यः प्रयाति पृथिवीपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2066966, "chapter_id": 2411, "verse_number": "९-२९-३३", "content_sanskrit": "तं भृशक्षतसर्वाङ्गं पद्ध्यामेव धरातले।\nतिष्ठन्तमेकं दृष्ट्वा तु ममाभूत्क्लेश उत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2066967, "chapter_id": 2411, "verse_number": "९-२९-३४", "content_sanskrit": "तस्य चैवंविधस्याद्य जगन्नाथस्य भूपते।\nआपदप्रतिमैवाभूद्बलीयान्विधिरेव हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2066968, "chapter_id": 2411, "verse_number": "९-२९-३५", "content_sanskrit": "ततोऽस्मै तदहं सर्वमुक्तवान्ग्रहणं तदा।\nद्वैपायनप्रसादाच्च जीवतो मोक्षमाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2066969, "chapter_id": 2411, "verse_number": "९-२९-३६", "content_sanskrit": "स मुहूर्तमिव ध्यात्वा प्रतिलभ्य च चेतनाम्।\nभ्रातॄंश्च सर्वसैन्यानि पर्यपृच्छत मां ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2066970, "chapter_id": 2411, "verse_number": "९-२९-३७", "content_sanskrit": "तस्मै तदहमाचक्षे सर्वं प्रत्यक्षदर्शिवान्।\nभ्रातॄश्च निहतान्सर्वान्सैन्यं च विनिपातितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2066971, "chapter_id": 2411, "verse_number": "९-२९-३८", "content_sanskrit": "त्रयः किल रथाः शिष्टास्तावकानां नराधिप।\nइति प्रस्थानकाले मां कृष्णद्वैपायनोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2066972, "chapter_id": 2411, "verse_number": "९-२९-३९", "content_sanskrit": "स दीर्घमिव निःश्वस्य प्रत्यवेक्ष्य पुनः पुनः।\nअसौ मां पाणिना स्पृष्ट्वा पुत्रस्ते पर्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2066973, "chapter_id": 2411, "verse_number": "९-२९-४०", "content_sanskrit": "त्वदन्यो नेह सङ्ग्रामे कश्चिज्जीवति सञ्जय।\nद्वितीयं नेह पश्यामि ससहायाश्च पाण़्डवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2066974, "chapter_id": 2411, "verse_number": "९-२९-४१", "content_sanskrit": "ब्रूयाः सञ्जय राजानं पज्ञाचक्षुषमीश्वरम्।\nदुर्योधनस्तव सुतः प्रविष्टो हदमित्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2066975, "chapter_id": 2411, "verse_number": "९-२९-४२", "content_sanskrit": "सुहृद्भिस्तादृशैर्हीनः पुत्रैर्भ्रातृभिरेव च।\nपाण्डवैश्च हृते राज्ये को नु जीवेत मादृशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2066976, "chapter_id": 2411, "verse_number": "९-२९-४३", "content_sanskrit": "आचक्षीथाः सर्वमिदं मां च मुक्तं महाहवात्।\nआस्मिंस्तोयहदे गुप्तं जीवन्तं भृशविक्षतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2066977, "chapter_id": 2411, "verse_number": "९-२९-४४", "content_sanskrit": "एवमुक्त्वा महाराज प्राविशत्तं महाहदम्।\nअस्तम्भयत तोयं च मायया मनुजाधिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2066978, "chapter_id": 2411, "verse_number": "९-२९-४५", "content_sanskrit": "तस्मिन्हदं प्रविष्टे तु त्रीन्रथाञ्श्रान्तवाहनान्।\nअपश्यं सहितानेकस्तं देशं समुपेयुषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2066979, "chapter_id": 2411, "verse_number": "९-२९-४६", "content_sanskrit": "कृपं शारद्वतं वीरं द्रौणिं च रथिनां वरम्।\nभोजं च कृतवर्माणं सहिताञ्शरविक्षतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2066980, "chapter_id": 2411, "verse_number": "९-२९-४७", "content_sanskrit": "ते सर्वं मामभिप्रेक्ष्य तूर्णमश्वाननोदयन्।\nउपयाय तु मामूचुर्दिष्ट्या जीवसि सञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2066981, "chapter_id": 2411, "verse_number": "९-२९-४८", "content_sanskrit": "अपृच्छंश्चैव मां सर्वे पुत्रं तव जनाधिपम्।\nकच्चिद्दुर्योधनो राजा स नो जीवति सञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2066982, "chapter_id": 2411, "verse_number": "९-२९-४९", "content_sanskrit": "आख्यातवानहं तेभ्यस्तदा कुशलिनं नृपम्।\nतच्चैव सर्वमाचक्षं यन्मां दुर्योधनोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2066983, "chapter_id": 2411, "verse_number": "९-२९-५०", "content_sanskrit": "हदं चैवाहमाचक्षं यं प्रविष्टो नराधिपः।\nअश्वत्थामा तु तद्राजन्निशम्य वचनं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2066984, "chapter_id": 2411, "verse_number": "९-२९-५१", "content_sanskrit": "तं हदं विपुलं प्रेक्ष्य करुणं पर्यदेवयत्।\nअहो धिक्स न जानाति जीवतोऽस्मान्नराधिप।\nपर्याप्ता हि वयं तेन सह योधयितुं परान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2066985, "chapter_id": 2411, "verse_number": "९-२९-५२", "content_sanskrit": "ते तु तत्र चिरं कालं विलप्य च महारथाः।\nप्राद्रवन्रथिनां श्रेष्ठा दृष्ट्वा पाण्डुसुतान्रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2066986, "chapter_id": 2411, "verse_number": "९-२९-५३", "content_sanskrit": "ते तु मां रथमारोप्य कृपस्य सुपरिष्कृतम्।\nसेनानिवेशमाजग्मुर्हतशेषास्त्रयो रथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2066987, "chapter_id": 2411, "verse_number": "९-२९-५४", "content_sanskrit": "तत्र गुल्माः परिक्षिप्ताः सूर्ये चास्तमिते सति।\nसर्वे विचुक्रुशुः श्रुत्वा पुत्राणां तव संक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2066988, "chapter_id": 2411, "verse_number": "९-२९-५५", "content_sanskrit": "ततो वृद्धा महाराज योषितां रक्षिणो नराः।\nराजदारानुपादाय पययुर्नगरं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2066989, "chapter_id": 2411, "verse_number": "९-२९-५६", "content_sanskrit": "तत्र विक्रोशमानानां रुदतीनां च सर्वशः।\nप्रादुरासीन्महाञ्शब्दः श्रुत्वा तद्बलसङ्क्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2066990, "chapter_id": 2411, "verse_number": "९-२९-५७", "content_sanskrit": "ततस्ता योषितो राजन्रुदन्त्यो वै मुहुर्मुहुः।\nकुरर्य इव शब्देन नादयन्त्यो महीतलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2066991, "chapter_id": 2411, "verse_number": "९-२९-५८", "content_sanskrit": "आजघ्नुः करजैश्चापि पाणिभिश्च शिरांस्युत।\nलुलुचुश्च तदा केशान्क्रोशन्त्यस्तत्रतत्र ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2066992, "chapter_id": 2411, "verse_number": "९-२९-५९", "content_sanskrit": "हाहाकारविनादिन्यो विनिघ्नन्त्य उरांसि च।\nशोचन्त्यस्तत्र रुरुदुः क्रन्दमाना विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2066993, "chapter_id": 2411, "verse_number": "९-२९-६०", "content_sanskrit": "ततो दुर्योधनामात्याः साश्रुकण्ठा भृशातुराः।\nराजदारानुपामन्त्र्य प्रययुर्नगरं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2066994, "chapter_id": 2411, "verse_number": "९-२९-६१", "content_sanskrit": "वेत्रव्यासक्तहस्ताश्च द्वाराध्यक्षा विशाम्पते।\nशयनीयानि शुभ्राणि स्पर्ध्यास्तरणवन्ति च।\nसमादाय ययुस्तूर्णं नगरं दाररक्षिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2066995, "chapter_id": 2411, "verse_number": "९-२९-६२", "content_sanskrit": "आस्थायाश्वतरीयुक्तान्स्यन्दनानपरे पुनः।\nस्वान्स्वान्दारानुपादाय प्रययुर्नगरं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2066996, "chapter_id": 2411, "verse_number": "९-२९-६३", "content_sanskrit": "अदृष्टपूर्वा या नार्यो भास्करेणापि वेश्मसु।\nददृशुस्ता महाराज जना याताः पुरं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2066997, "chapter_id": 2411, "verse_number": "९-२९-६४", "content_sanskrit": "ताः स्त्रियो भरतश्रेष्ठ सौकुमार्यसमन्विताः।\nप्रययुर्नगरं तूर्णं हतस्वपतिबान्धवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2066998, "chapter_id": 2411, "verse_number": "९-२९-६५", "content_sanskrit": "आगोपालाविपालेभ्यो द्रवन्तो नगरं प्रति।\nययुर्मनुष्याः सम्भ्रान्ता भीमसेनभयार्दिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2066999, "chapter_id": 2411, "verse_number": "९-२९-६६", "content_sanskrit": "अपिचैषां भयं तीव्रं पार्थेभ्योऽभूत्सुदारुणम्।\nप्रेक्षमाणास्तदाऽन्योन्यमाधावन्नगरं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2067000, "chapter_id": 2411, "verse_number": "९-२९-६७", "content_sanskrit": "तस्मिंस्तथा वर्तमाने विद्रवे भृशदारुणे।\nयुयुत्सुः शोकसम्मूढः प्राप्तकालमचिन्तयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2067001, "chapter_id": 2411, "verse_number": "९-२९-६८", "content_sanskrit": "जितो दुर्योधनः सङ्ख्ये पाण्डवैर्भीमविक्रमैः।\nएकादशचमूभर्ता भ्रातरश्चास्य सूदिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2067002, "chapter_id": 2411, "verse_number": "९-२९-६९", "content_sanskrit": "हताश्च कुरवः सर्वे भीष्मद्रोणपुरः सराः।\nअहमेको विमुक्तस्तु भाग्ययोगाद्यदृच्छया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2067003, "chapter_id": 2411, "verse_number": "९-२९-७०", "content_sanskrit": "विद्रुतानि च सर्वाणि शिबिराद्वै समन्ततः।\n[इतस्ततः पलायन्ते हतनाथा हतौजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2067004, "chapter_id": 2411, "verse_number": "९-२९-७१", "content_sanskrit": "अदृष्टपूर्वा दुःखार्ता भयव्याकुललोचनाः।\nहरिणा इव वित्रस्ता वीक्षमाणा दिशो दश]॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2067005, "chapter_id": 2411, "verse_number": "९-२९-७२", "content_sanskrit": "दुर्योधनस्य सचिवा ये केचिदवशेषिताः।\nराजदारानुपादाय प्रययुर्नगरं प्रति।\nप्राप्तकालमहं मन्ये प्रवेशं तैः सह प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2067006, "chapter_id": 2411, "verse_number": "९-२९-७३", "content_sanskrit": "युधिष्ठिरमनुज्ञाय वासूदेवं तथैव च।\nएतमर्थं महाबाहुरुभयोः सन्न्यवेदयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2067007, "chapter_id": 2411, "verse_number": "९-२९-७४", "content_sanskrit": "तस्य प्रीतोऽभवद्राजा नित्यं करुणवेदिता।\nपरिष्वज्य महाबाहुर्वैश्यापुत्रं व्यसर्जयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2067008, "chapter_id": 2411, "verse_number": "९-२९-७५", "content_sanskrit": "ततः स रथमास्थाय द्रुतमश्वानचोदयत्।\nसंवाहयितवांश्चापि राजदारान्पुरं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2067009, "chapter_id": 2411, "verse_number": "९-२९-७६", "content_sanskrit": "तैश्चैव सहितः क्षिप्रमस्तं गच्छति भास्करे।\nप्रविष्टो हास्तिनपुरं बाष्पकण्ठोऽश्रुलोचनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2067010, "chapter_id": 2411, "verse_number": "९-२९-७७", "content_sanskrit": "अपश्यत महाप्राज्ञं विदुरं साश्रुलोचनम्।\nराज्ञः समीपान्निष्क्रान्तं शोकोपहतचेतसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2067011, "chapter_id": 2411, "verse_number": "९-२९-७८", "content_sanskrit": "तमब्रवीत्सत्यधृतिः प्रणतं त्वग्रतः स्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2067012, "chapter_id": 2411, "verse_number": "९-२९-७९x", "content_sanskrit": "विदुर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2067013, "chapter_id": 2411, "verse_number": "९-२९-७९", "content_sanskrit": "दिष्ट्या कुरुक्षये वृत्ते अस्मिंस्त्वं पुत्र जीवसि।\nविना राज्ञः पर्वेशार्द्वै किमसि त्वमिहागतः।\nएतद्वै कारणं सर्वं विस्तरेण निवेदय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2067014, "chapter_id": 2411, "verse_number": "९-२९-८०x", "content_sanskrit": "युयुत्सुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2067015, "chapter_id": 2411, "verse_number": "९-२९-८०", "content_sanskrit": "निहते शकुनौ तत्र सज्ञातिसुतबान्धवे।\nहतशेषपरीवारो राजा दुर्योधनस्ततः।\nस्वकं स हयमुत्सृज्य प्राङ्मुखः प्राद्रवद्भयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2067016, "chapter_id": 2411, "verse_number": "९-२९-८१", "content_sanskrit": "अपक्रान्ते तु नृपतौ स्कन्धावारनिवेशनात्।\nभयव्याकुलितं सर्वं प्राद्रावन्नगरं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2067017, "chapter_id": 2411, "verse_number": "९-२९-८२", "content_sanskrit": "ततो राज्ञः कलत्राणि भ्रातॄणां चास्य सर्वतः।\nवाहनेषु समारोप्य अध्यक्षाः प्राद्रावन्भयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2067018, "chapter_id": 2411, "verse_number": "९-२९-८३", "content_sanskrit": "ततोऽहं समनुज्ञाप्य राजानं सहकेशवम्।\nप्रविष्टो हास्तिनपुरं रक्षन्लोकस्य वाच्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2067019, "chapter_id": 2411, "verse_number": "९-२९-८४x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2067020, "chapter_id": 2411, "verse_number": "९-२९-८४", "content_sanskrit": "एतच्छ्रुत्वा तु वचनं वैश्यापुत्रेण भाषितम्।\nप्राप्तकालमिति ज्ञात्वा विदुरः सर्वधर्मवित्।\nअपूजयदमेयात्मा युयुत्सुं वाक्यमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2067021, "chapter_id": 2411, "verse_number": "९-२९-८५", "content_sanskrit": "प्राप्तकालमिदं सर्वं ब्रुवता भरतक्षये।\n[रक्षितः कुलधर्मश्च सानुक्रोशतया त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2067022, "chapter_id": 2411, "verse_number": "९-२९-८६", "content_sanskrit": "दिष्ठ्या त्वामिह सङ्ग्राम दस्माद्वीरक्षयात्पुरम्।\nसमागतमपश्याम ह्यंशुमन्तमिव प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2067023, "chapter_id": 2411, "verse_number": "९-२९-८७", "content_sanskrit": "अन्धस्यं नृपतेर्यष्टिर्लुब्धस्यादीर्घदर्शिनः।\nबहुशो याच्यमानस्य दैवोपहतचेतसः।\nत्वमेको व्यसनार्तस्य ध्रियसे पुत्र सर्वथा]॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2067024, "chapter_id": 2411, "verse_number": "९-२९-८८", "content_sanskrit": "अद्य त्वमिह विश्रान्तः श्वोऽभिगन्ता युधिष्ठिरम्।\nएतावदुक्त्वा वचनं विदुरः साश्रुलोचनः।\nयुयुत्सुं समनुज्ञाप्य प्रविवेश नृपक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2067025, "chapter_id": 2411, "verse_number": "९-२९-८९", "content_sanskrit": "[पौरजानपदैर्दुःखाद्धाहेति भृशनादितम्।\nनिरानन्दं गतश्रीकं हृताराममिवाशयम्।\nशून्यरूपमपध्वस्तं दुःखाद्दुःखतरोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2067026, "chapter_id": 2411, "verse_number": "९-२९-९०", "content_sanskrit": "विदुरः सर्वधर्मज्ञो विक्लवेनान्तरात्मना।\nविवेश नगरे राजन्निशश्वास शनैः शनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2067027, "chapter_id": 2411, "verse_number": "९-२९-९१", "content_sanskrit": "युयुत्सुरपि तां रात्रिं स्वगृहे न्यवसत्तदा।\nवन्द्यमानः स्वकैश्चापि नाभ्यनन्दत्सुदुःखितः।\nचिन्तयानः क्षयं तीव्रं भरतानां परस्परम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2067028, "chapter_id": 2411, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शल्यपर्वणि ह्रदप्रवेशपर्वणि अष्टादशदिवसयुद्धे एकोनत्रिंशोऽध्यायः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}]