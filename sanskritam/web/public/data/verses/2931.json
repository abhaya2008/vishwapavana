[{"id": 2090827, "chapter_id": 2931, "verse_number": "१३-६१-१", "content_sanskrit": "युधिष्ठिर उवाच।\nश्राद्धकाले च दैवे च पित्र्येऽपि च पितामह।\nइच्छामीह त्वयाऽऽख्यातं विहितं यत्सुरर्षिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2090828, "chapter_id": 2931, "verse_number": "१३-६१-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2090829, "chapter_id": 2931, "verse_number": "१३-६१-२", "content_sanskrit": "दैवं पौर्वाह्णिके कुर्यादपराह्णे तु पैतृकम्।\nमङ्गलाचारसम्पन्नः कृतशौचः प्रयत्नवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2090830, "chapter_id": 2931, "verse_number": "१३-६१-३", "content_sanskrit": "मनुष्याणां तु मध्याह्ने प्रदद्यादुपपत्तिभिः।\nकालहीनं तु यद्दानं तं भागं रक्षसां विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2090831, "chapter_id": 2931, "verse_number": "१३-६१-४", "content_sanskrit": "लङ्घितं चावलीढं च लाकपूर्वं च यत्कृतम्।\nरजस्वलाभिदृष्टं च तं भागं रक्षसां विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2090832, "chapter_id": 2931, "verse_number": "१३-६१-५", "content_sanskrit": "अवघुष्टं च यद्भुक्तमव्रतेन च भारत।\nपरामृष्टं शुना चैव तं भागं रक्षसां विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2090833, "chapter_id": 2931, "verse_number": "१३-६१-६", "content_sanskrit": "केशकीटावपतितं क्षुतं श्वभिरवेक्षितम्।\nरुदितं चावधूतं च तं भागं रक्षसां विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2090834, "chapter_id": 2931, "verse_number": "१३-६१-७", "content_sanskrit": "निरोङ्कारेण यद्भुक्तं सशस्त्रेण च भारत।\nदुरात्मना च यद्भुक्तं तं भागं रक्षसां विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2090835, "chapter_id": 2931, "verse_number": "१३-६१-८", "content_sanskrit": "परोच्छिष्टं च यद्भुक्तं परिभुक्तं च यद्भवेत्।\nदैवे पित्र्ये च सततं तं भागं रक्षसां विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2090836, "chapter_id": 2931, "verse_number": "१३-६१-९", "content_sanskrit": "मन्त्रहीनं क्रियाहीनं यच्छ्राद्धं परिविष्यते।\nत्रिभिर्वर्णैर्नरश्रेष्ठ तं भागं रक्षसां विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2090837, "chapter_id": 2931, "verse_number": "१३-६१-१०", "content_sanskrit": "आज्याहुतिं विना चैव यत्किञ्चित्परिविष्यते।\nदुराचारैश्च यद्भुक्तं तं भागं रक्षसां विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2090838, "chapter_id": 2931, "verse_number": "१३-६१-११", "content_sanskrit": "ये भागा रक्षसां प्राप्तास्त उक्ता भरतर्षभ।\nअत ऊर्ध्वं विसर्गस्य परीक्षां ब्राह्मणे शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2090839, "chapter_id": 2931, "verse_number": "१३-६१-१२", "content_sanskrit": "यावन्तः पतिता विप्रा जडोन्मत्तास्तथैव च।\nदैवे वाऽप्यथ पित्र्ये वा राजन्नार्हन्ति केतनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2090840, "chapter_id": 2931, "verse_number": "१३-६१-१३", "content_sanskrit": "श्वित्री क्लीबश्च कुष्ठी च तता यक्ष्महतश्च यः।\nअपस्मारी च यश्चान्धो राजन्नार्हन्ति केतनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2090841, "chapter_id": 2931, "verse_number": "१३-६१-१४", "content_sanskrit": "चिकित्सका देवलका वृथा नियमधारिणः।\nसोमविक्रयिणश्चैव श्राद्धे नार्हन्ति केतनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2090842, "chapter_id": 2931, "verse_number": "१३-६१-१५", "content_sanskrit": "गायना नर्तकाश्चैव प्लवका वादकास्तथा।\nकथका योधकाश्चैव राजन्नार्हन्ति केतनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2090843, "chapter_id": 2931, "verse_number": "१३-६१-१६", "content_sanskrit": "होतारो वृषलानां च वृषलाध्यापकास्तथा।\nतथा वृषलशिष्याश्च राजन्नार्हन्ति केतनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2090844, "chapter_id": 2931, "verse_number": "१३-६१-१७", "content_sanskrit": "अनुयोक्ता च यो विप्रो अनुयुक्तश्च भारत।\nनार्हतस्तावपि श्राद्धं ब्रह्मविक्रयिणौ हि तौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2090845, "chapter_id": 2931, "verse_number": "१३-६१-१८", "content_sanskrit": "अग्रणीर्यः कृतः पूर्वं वर्णावरपरिग्रहः।\nब्राह्मणः सर्वविद्योऽपि राजन्नार्हति केतनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2090846, "chapter_id": 2931, "verse_number": "१३-६१-१९", "content_sanskrit": "अनग्नयश्च ये विप्रा मृतनिर्यातकाश्च ये।\nस्तेनाश्च पतिताश्चैव राजन्नार्हन्ति केतनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2090847, "chapter_id": 2931, "verse_number": "१३-६१-२०", "content_sanskrit": "अपरिज्ञातपूर्वाश्च गणपूर्वाश्च भारत।\nपुत्रिकापूर्वपुत्राश्च श्राद्धे नार्हन्ति केतनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2090848, "chapter_id": 2931, "verse_number": "१३-६१-२१", "content_sanskrit": "ऋणकर्ता च यो राजन्यश्च वार्धुषिको नरः।\nप्राणिविक्रयवृत्तिश्च राजन्नार्हन्ति केतनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2090849, "chapter_id": 2931, "verse_number": "१३-६१-२२", "content_sanskrit": "स्त्रीपूर्वाः काण्डपृष्ठाश्च यावन्तो भरतर्षभ।\nआजपा ब्राह्मणाश्चैव श्राद्धे नार्हन्ति केतनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2090850, "chapter_id": 2931, "verse_number": "१३-६१-२३", "content_sanskrit": "श्राद्धे दैवे च निर्दिष्टो ब्राह्मणो भरतर्षभ।\nदातुः प्रतिग्रहीतुश्च शृणुष्वानुग्रहं पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2090851, "chapter_id": 2931, "verse_number": "१३-६१-२४", "content_sanskrit": "चीर्णव्रता गुणैर्युक्ता भवेयुर्येऽपि कर्षकाः।\nसावित्रीज्ञाः क्रियावन्तस्ते राजन्केतनक्षमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2090852, "chapter_id": 2931, "verse_number": "१३-६१-२५", "content_sanskrit": "क्षात्रधर्मिणमप्याजौ केतयेत्कुलजं द्विजम्।\nन त्वेव वणिजं तात श्राद्धे च परिकल्पयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2090853, "chapter_id": 2931, "verse_number": "१३-६१-२६", "content_sanskrit": "अग्निहोत्री च यो विप्रो ग्रामवासी च यो भवेत्।\nअस्तेनश्चातिथिज्ञश्च स राजन्केतनक्षमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2090854, "chapter_id": 2931, "verse_number": "१३-६१-२७", "content_sanskrit": "सावित्रीं जपते यस्तु त्रिकालं भरतर्षभ।\nभिक्षावृत्तिः क्रियावांश्च स राजन्केतनक्षमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2090855, "chapter_id": 2931, "verse_number": "१३-६१-२८", "content_sanskrit": "उदितास्तमितो यश्च तथैवास्तमितोदितः।\nअहिंस्रश्चाल्पदोषश्च स राजन्केतनक्षमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2090856, "chapter_id": 2931, "verse_number": "१३-६१-२९", "content_sanskrit": "अकल्कको ह्यतर्कश्च ब्राह्मणो भरतर्षभ।\nसंसर्ग भैक्ष्यवृत्तिश्च स राजन्केतनक्षमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2090857, "chapter_id": 2931, "verse_number": "१३-६१-३०", "content_sanskrit": "अव्रती कितवः स्तेनः प्राणिविक्रयिको वणिक्।\nसनिष्कृतिः पुनः सोमं पीतवान्केतनक्षमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2090858, "chapter_id": 2931, "verse_number": "१३-६१-३१", "content_sanskrit": "अर्जयित्वा धनं पूर्वं दारुणैरपि कर्मभिः।\nभवेत्सर्वातिथिः पश्चात्स राजन्केतनक्षमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2090859, "chapter_id": 2931, "verse_number": "१३-६१-३२", "content_sanskrit": "ब्रह्मविक्रयनिर्दिष्टं स्त्रिया यच्चार्जितं धनम्।\nअदेयं पितृविप्रेभ्यो यच्च क्लैब्यादुपार्जितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2090860, "chapter_id": 2931, "verse_number": "१३-६१-३३", "content_sanskrit": "क्रियमाणेऽपवर्गे च यो द्विजो भरतर्षभ।\nन व्याहरति यद्युक्तं तस्याधर्मो गवानृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2090861, "chapter_id": 2931, "verse_number": "१३-६१-३४", "content_sanskrit": "श्राद्धस्य ब्राह्मणः कालः प्राप्तं दधि घृतं तथा।\nसोमक्षयश्च मांसं च यदारण्यं युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2090862, "chapter_id": 2931, "verse_number": "१३-६१-३५", "content_sanskrit": "`मुहूर्तानां त्रयं पूर्वमह्नः प्रातरिति स्मृतम्।\nजपध्यानादिभिस्तस्मिन्विप्रैः कार्यं शुभव्रतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2090863, "chapter_id": 2931, "verse_number": "१३-६१-३६", "content_sanskrit": "सङ्गवाख्यं त्रिभागं तु मध्याह्नस्त्रिमुहूर्तकः।\nलौकिकं सङ्गवेऽर्धं च स्नानादि ह्यथ मध्यमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2090864, "chapter_id": 2931, "verse_number": "१३-६१-३७", "content_sanskrit": "चतुर्थमपराह्णं तु त्रिमुहूर्तं तु पित्र्यकम्।\nसायाह्नस्त्रिमुहूर्तं च मध्यमं कविभिः स्मृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2090865, "chapter_id": 2931, "verse_number": "१३-६१-३८", "content_sanskrit": "चतुर्थ त्वपराह्णाख्ये श्राद्धं कुर्यात्सदा नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2090866, "chapter_id": 2931, "verse_number": "१३-६१-३९", "content_sanskrit": "प्रागुदीचीमुखा विप्राः विश्वेदेवे च दक्षिणाः।\nश्रावितेषु सुतृप्तेषु पिण्डं दद्यात्सदक्षिणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2090867, "chapter_id": 2931, "verse_number": "१३-६१-४०", "content_sanskrit": "श्राद्धापवर्गे विप्रस्य दातारो वोस्त्वितीरयेत्।\nक्षत्रियस्यापि यो ब्रूयात्प्रीयन्तां पितरस्त्विति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2090868, "chapter_id": 2931, "verse_number": "१३-६१-४१", "content_sanskrit": "अपवर्गे तु वैश्यस्य श्राद्धकर्मणि भारत।\nअक्षय्यमभिधातव्यं स्वस्ति शूद्रस्य भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2090869, "chapter_id": 2931, "verse_number": "१३-६१-४२", "content_sanskrit": "पुण्याहवाचनं दैवं ब्राह्मणस्य विधीयते।\nएतदेव निरोङ्कारं क्षत्रियस्य विधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2090870, "chapter_id": 2931, "verse_number": "१३-६१-४३", "content_sanskrit": "वैश्यस्य दैवे वक्तव्यं प्रीयन्तां देवता इति।\n`गोर्हिसायां चतुर्भागं पूर्वं विप्रातिकेतिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2090871, "chapter_id": 2931, "verse_number": "१३-६१-४४", "content_sanskrit": "वर्णावरेषु भुञ्जानं क्रमाच्छूद्रे चतुर्गुणम्।\nनान्यत्र ब्राह्मणो ब्रूयात्पूर्वं विप्रेण केतितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2090872, "chapter_id": 2931, "verse_number": "१३-६१-४५", "content_sanskrit": "अभोजने च दोषः स्याद्वर्जयेच्छूद्रकेतनम्।\nशूद्रान्नरसपुष्टाङ्गो द्विजो नोर्ध्वां गतिं लभेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2090873, "chapter_id": 2931, "verse_number": "१३-६१-४६", "content_sanskrit": "अशुचिर्नैव चाश्नीयान्नास्तिको मानवर्जितः।\nन पूर्वं लङ्घयेल्लोभादेकवर्णोऽपि पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2090874, "chapter_id": 2931, "verse_number": "१३-६१-४७", "content_sanskrit": "विप्राः स्मृता भूमिदेवा उपकुर्वाणवर्जिताः।\nकर्मणामानुपूर्व्येण विदिपूर्वं कृतं शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2090875, "chapter_id": 2931, "verse_number": "१३-६१-४८", "content_sanskrit": "जातकर्मादिकाः सर्वास्त्रिषु वर्णेषु भारत।\nब्रह्मक्षत्रे हि मन्त्रोक्ता वैश्यस्य च युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2090876, "chapter_id": 2931, "verse_number": "१३-६१-४९", "content_sanskrit": "विप्रस्य रशना मौञ्जी मौर्वी राजन्यगामिनी।\nबाल्वजी ह्येव वैश्यस्य धर्म एष युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2090877, "chapter_id": 2931, "verse_number": "१३-६१-५०", "content_sanskrit": "`पालाशो द्विजदण्डः स्यादश्वत्थः क्षत्रियस्य तु।\nऔदुम्बरश्च वैश्यस्य धर्म एष युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2090878, "chapter_id": 2931, "verse_number": "१३-६१-५१", "content_sanskrit": "दातुः प्रतिग्रहीतुश्च धर्माधर्माविमौ शृणु।\nब्राह्मणस्यानृतेऽधर्मः प्रोक्तः पातकसंज्ञितः।\nचतुर्गुणः क्षत्रियस्य वैश्यस्याष्टगुणः स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2090879, "chapter_id": 2931, "verse_number": "१३-६१-५२", "content_sanskrit": "नान्यत्र ब्राह्मणोऽश्नीयात्पूर्वं विप्रेण केतितः।\n[यवीयान्पशुहिंसायां तुल्यधर्मा भवेत्स हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2090880, "chapter_id": 2931, "verse_number": "१३-६१-५३", "content_sanskrit": "तथा राजन्यवैश्याभ्यां यद्यश्नीयात्तु केतितः।\nयवीयान्पशुहिंसायां भागार्धं समवाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2090881, "chapter_id": 2931, "verse_number": "१३-६१-५४", "content_sanskrit": "दैवं वाऽ************** पित्र्यं योऽश्नीयाद्ब्राह्मणादिषु।]\nअस्नातो ब्राह्मणो राजंस्तस्याधर्मोऽनृतं स्मृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2090882, "chapter_id": 2931, "verse_number": "१३-६१-५५", "content_sanskrit": "आशौचो ब्राह्मणो राजन्योऽश्नीयाद्ब्राह्मणादिषु।\nज्ञानपूर्वमथो लोभात्तस्याधर्मो गवानृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2090883, "chapter_id": 2931, "verse_number": "१३-६१-५६", "content_sanskrit": "अर्थेनान्येन यो लिप्सेत्कर्मार्थं चैव भारत।\nआमन्त्रयति राजेन्द्र तस्याधर्मोऽनृतं स्मृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2090884, "chapter_id": 2931, "verse_number": "१३-६१-५७", "content_sanskrit": "अवेदव्रतचारित्रास्त्रिभिर्वर्णैर्युधिष्ठिर।\nमन्त्रवत्परिविष्यन्ते तस्याधर्मो गवानृतम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2090885, "chapter_id": 2931, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि एकषष्टितमोऽध्यायः॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]