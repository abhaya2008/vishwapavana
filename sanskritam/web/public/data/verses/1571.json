[{"id": 2026645, "chapter_id": 1571, "verse_number": "३-२०९-०x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2026646, "chapter_id": 1571, "verse_number": "३-२०९-१", "content_sanskrit": "कश्चिद्द्विजातिप्रवरो वेदाध्यायी तपोधनः।\nतपस्वी धर्मशीलश्च कौशिको नाम भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2026647, "chapter_id": 1571, "verse_number": "३-२०९-२", "content_sanskrit": "साङ्गोपनिषदान्वेदानधीते द्विजसत्तमः।\nसवृक्षमूले कस्मिंश्चिद्वेदानुच्चारयन्स्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2026648, "chapter_id": 1571, "verse_number": "३-२०९-३", "content_sanskrit": "उपरिष्टाच्च वृक्षस्य बलाका संन्यलीयत।\nतया पुरीषमुत्सृष्टं ब्राह्मणस्य तदोपरि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2026649, "chapter_id": 1571, "verse_number": "३-२०९-४", "content_sanskrit": "समवेक्ष्यततः क्रुद्धः सममध्यायत द्विजः।\n`तां बलकां महाराज निलीनां नगमूर्धनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2026650, "chapter_id": 1571, "verse_number": "३-२०९-५", "content_sanskrit": "भृशं क्रोधाभिभूतेन बलाका सा निरीक्षिता।\nअपध्याता च विप्रेण न्यपतद्धरणीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2026651, "chapter_id": 1571, "verse_number": "३-२०९-६", "content_sanskrit": "बलाकां पतितां दृष्ट्वा गतसत्वामचेतनाम्।\nकारुण्यादभिसंतप्तः पर्यशोचत तां द्विजः।\nअकार्यं कृतवानस्मि द्वेषरागबलात्कृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2026652, "chapter_id": 1571, "verse_number": "३-२०९-७", "content_sanskrit": "इत्युक्ताव बहुशो विद्वान्ग्रामं भैक्षाय संश्रितः।\nग्रामे शुचीनि प्रचरन्कुलानि भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2026653, "chapter_id": 1571, "verse_number": "३-२०९-८", "content_sanskrit": "देहीति याचमानोऽसौ तिष्ठेत्युक्तः स्त्रिया ततः।\nशौचं तु यावत्कुरुते भाजनस्य कुटुम्बिवी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2026654, "chapter_id": 1571, "verse_number": "३-२०९-९", "content_sanskrit": "एतस्मिन्नन्तरे राजन्क्षुधासंपीडितो भृशम्।\nभर्ता प्रविष्टः सहसा तस्या भरतसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2026655, "chapter_id": 1571, "verse_number": "३-२०९-१०", "content_sanskrit": "सा तु दृष्ट्वा पतिं साध्वी ब्राह्मणं व्यपहाय तम्।\nपाद्यमाचमनीयं वै ददौ भर्तुस्तथाऽऽसनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2026656, "chapter_id": 1571, "verse_number": "३-२०९-११", "content_sanskrit": "प्रह्वा पर्यचरच्चापि भर्तारमसितेक्षणा।\nआहारेणाथ भक्ष्यैश्च वाक्यैः सुमधुरैस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2026657, "chapter_id": 1571, "verse_number": "३-२०९-१२", "content_sanskrit": "उच्छिष्टं भाविता भर्तुर्भुङ्क्ते नित्यं युधिष्ठिर।\nदैवतं च पतिं मेने भर्तुश्चित्तानुसारिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2026658, "chapter_id": 1571, "verse_number": "३-२०९-१३", "content_sanskrit": "कर्मणा मनसा वाचा नात्यश्नान्नापि चापिवत्।\nतं सर्वभावोपगता पतिशुश्रूषणे रता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2026659, "chapter_id": 1571, "verse_number": "३-२०९-१४", "content_sanskrit": "साध्वाचारा शुचिर्दक्षा कुटुम्बस्य हितैषिणी।\nभर्तुश्चापि हितं यत्तत्सततं साऽनुवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2026660, "chapter_id": 1571, "verse_number": "३-२०९-१५", "content_sanskrit": "देवतातिथिभृत्यानां श्वश्रूश्वशुरयोस्तथा।\nशुश्रूषणपरा नित्यं सततं संयतेन्द्रिया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2026661, "chapter_id": 1571, "verse_number": "३-२०९-१६", "content_sanskrit": "सा ब्राह्मणं तदा दृष्ट्वा संस्थितं भैक्षकाङ्क्षिणम्।\nकुर्वती पतिशुश्रूषां सस्माराथ शुभेक्षणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2026662, "chapter_id": 1571, "verse_number": "३-२०९-१७", "content_sanskrit": "व्रीडिता साऽभवत्साध्वी तदा भरतसत्तम।\nभिक्षामादाय विप्राय निर्जगाम यशस्विनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2026663, "chapter_id": 1571, "verse_number": "३-२०९-१८x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2026664, "chapter_id": 1571, "verse_number": "३-२०९-१८", "content_sanskrit": "किमिदं भवति त्वं मां तिष्ठेत्युक्त्वा वराङ्गने।\nउपरोधं कृतवती न विसर्जितवत्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2026665, "chapter_id": 1571, "verse_number": "३-२०९-१९x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2026666, "chapter_id": 1571, "verse_number": "३-२०९-१९", "content_sanskrit": "ब्राह्मणं क्रोधसंतप्तं ज्वलन्तमिव तेजसा।\nदृष्ट्वा साध्वी मनुष्येन्द्रसान्त्वपूर्वं वचोऽब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2026667, "chapter_id": 1571, "verse_number": "३-२०९-२०", "content_sanskrit": "`क्षमस्वविप्रप्रवर क्षमस्व स्त्रीजडात्मताम्।\nप्रसीद भगवन्मह्यं कृपां कुरु मयि द्विज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2026668, "chapter_id": 1571, "verse_number": "३-२०९-२१", "content_sanskrit": "क्षन्तुमर्हसि मे विद्वन्भर्ता मे दैवतं महत्।\nस चापि क्षुधितः श्रान्तः प्राप्तः शुश्रूषितोमया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2026669, "chapter_id": 1571, "verse_number": "३-२०९-२२x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2026670, "chapter_id": 1571, "verse_number": "३-२०९-२२", "content_sanskrit": "ब्राह्मणआ न गरीयांसो गरीयांस्ते पतिः कृतः।\nगृहस्थधर्मे वर्तन्ती ब्राह्मणानवमन्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2026671, "chapter_id": 1571, "verse_number": "३-२०९-२३", "content_sanskrit": "इन्द्रोऽप्येषां प्रणमते किं पुनर्मानवो भुवि।\nअवलिप्ते न जानीषे वृद्धानां न श्रुतं त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2026672, "chapter_id": 1571, "verse_number": "३-२०९-२४", "content_sanskrit": "ब्राह्मणा ह्यग्निसदृशा दहेयुः पृथिवीमपि।\n`सपर्वतवनद्वीपां क्षिप्रमेवावमानिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2026673, "chapter_id": 1571, "verse_number": "३-२०९-२५x", "content_sanskrit": "स्त्र्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2026674, "chapter_id": 1571, "verse_number": "३-२०९-२५", "content_sanskrit": "[नाहं बलाका विप्रर्षे त्यज क्रोधं तपोधन।\nअनया क्रुद्धया दृष्ट्या क्रुद्धः किं मां करिष्यसि]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2026675, "chapter_id": 1571, "verse_number": "३-२०९-२६", "content_sanskrit": "नावजानाम्यहं विप्रान्देवैस्तुल्यान्मनस्विनः।\nअपराधमिमं विप्र क्षन्तुमर्हसि मेऽनघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2026676, "chapter_id": 1571, "verse_number": "३-२०९-२७", "content_sanskrit": "जानामि तेजो विप्राणआं महाभाग्यं च धीमताम्।\nअपेयः सागरः क्रोधात्कृतो हि लवणोदकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2026677, "chapter_id": 1571, "verse_number": "३-२०९-२८", "content_sanskrit": "तथैव दीप्ततपसां मुनीनां भावितात्मनाम्।\nयेषां क्रोधाग्निरद्यापि समुद्रे नोपशाम्यति।\n`कस्तान्परिभवेन्मूढो ब्राह्मणानमितौजसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2026678, "chapter_id": 1571, "verse_number": "३-२०९-२९", "content_sanskrit": "ब्राह्मणानां परिभवाद्वातापिः सुदुरात्मवान्।\nअगस्त्यमृषिमासाद्य जीर्णः क्रूरो महासुरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2026679, "chapter_id": 1571, "verse_number": "३-२०९-३०", "content_sanskrit": "बहुप्रभावाः श्रूयन्ते ब्राह्मणानां महात्मनाम्।\nक्रोधः सुविपुलो ब्रह्मन्प्रसादश्च महात्मनाम्।\nअस्मिंस्त्वतिक्रमे ब्रह्मन्क्षन्तुमर्हसि मेऽनघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2026680, "chapter_id": 1571, "verse_number": "३-२०९-३१", "content_sanskrit": "पतिशुश्रूषया धर्मो य स मे रोचते द्विज।\nदैवतेष्वपि सर्वेषु भर्ता मे दैवतं परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2026681, "chapter_id": 1571, "verse_number": "३-२०९-३२", "content_sanskrit": "अविशेषेण तस्याहं कुर्यां धर्मं द्विजोत्तम।\nशुश्रूषायाः फलं पश्य पत्युर्ब्राह्मण यादृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2026682, "chapter_id": 1571, "verse_number": "३-२०९-३३", "content_sanskrit": "बलाका हि त्वया दग्धा रोषात्तद्विदितं मया।\nक्रोधः शत्रुः शरीरस्थो मनुष्याणां द्विजोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2026683, "chapter_id": 1571, "verse_number": "३-२०९-३४", "content_sanskrit": "`मास्म क्रुध्यो बलाकेव न वध्याऽस्मि पतिव्रता।\nयः क्रोधमोहौ त्यजति तं देवा ब्राह्मणं विदुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2026684, "chapter_id": 1571, "verse_number": "३-२०९-३५", "content_sanskrit": "यो वदेदिह सत्यानि गुरुं संतोषयेत च।\nहिंसितश्च त हिंसेत तं देवा ब्राह्मणं विदुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2026685, "chapter_id": 1571, "verse_number": "३-२०९-३६", "content_sanskrit": "जितेन्द्रियो धर्मपरः स्वाध्यायनिरतः शुचिः।\nकामक्रोधौ वशौ यस्य तं देवा ब्राह्मणं विदुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2026686, "chapter_id": 1571, "verse_number": "३-२०९-३७", "content_sanskrit": "यस्य चात्मसमो लोको धर्मज्ञस्य मनस्विनः।\nसर्वधर्मेषु चरतस्तं देवा ब्राह्मणं विदुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2026687, "chapter_id": 1571, "verse_number": "३-२०९-३८", "content_sanskrit": "योऽध्यापयेदधीयीत यजेद्वा याजयीत वा।\nदद्याद्वाऽपि यथाशक्ति तं देवा ब्राह्मणं विदुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2026688, "chapter_id": 1571, "verse_number": "३-२०९-३९", "content_sanskrit": "ब्राह्मचारी वदान्यो योप्यधीयाद्द्विजपुङ्गवः।\nस्वाध्यायवानमत्तो वै तं देवा ब्राह्मणं विदुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2026689, "chapter_id": 1571, "verse_number": "३-२०९-४०", "content_sanskrit": "यद्ब्राह्मणानां कुशलं तदेषां परिकीर्तयेत्।\nसत्यं तथा व्याहरतां नानृते रमते मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2026690, "chapter_id": 1571, "verse_number": "३-२०९-४१", "content_sanskrit": "धनं तु ब्राह्मणस्याहुः स्वाध्यायं दममार्जवम्।\nइन्द्रियाणां निग्रहं च शाश्वतं द्विजसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2026691, "chapter_id": 1571, "verse_number": "३-२०९-४२", "content_sanskrit": "सत्यार्जवे धर्ममाहुः परं धर्मविदो जनाः।\nदुर्ज्ञेयः शाश्वतो धर्मः स च सत्ये प्रतिष्ठितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2026692, "chapter_id": 1571, "verse_number": "३-२०९-४३", "content_sanskrit": "श्रुतिप्रमाणो धर्मः स्यादिति वृद्धानुशासनम्।\nबहुधा दृश्यते धर्मः सूक्ष्म एव द्विजोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2026693, "chapter_id": 1571, "verse_number": "३-२०९-४४", "content_sanskrit": "भगवानपि धर्मज्ञः स्वाद्यायनिरतः शुचिः।\nन तु तत्त्वेन भगवन्दर्मं वेत्सीति मे मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2026694, "chapter_id": 1571, "verse_number": "३-२०९-४५", "content_sanskrit": "यदि विप्र न जानीषे धर्मं परमकं द्विज।\nधर्मव्याधं तत पृच्छ गत्वा तु मिथिलां पुरीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2026695, "chapter_id": 1571, "verse_number": "३-२०९-४६", "content_sanskrit": "मातापितृभ्यां शुश्रूपुः सत्यवादी जितेन्द्रियः।\nमिथिलायां वसेद्व्याधः स ते धर्मान्प्रवक्ष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2026696, "chapter_id": 1571, "verse_number": "३-२०९-४७", "content_sanskrit": "तत्र गच्छस्व भद्रं ते यथाकामं द्विजोत्तम।\n`व्याधः परमधर्मात्मा स ते छेत्स्यति संशयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2026697, "chapter_id": 1571, "verse_number": "३-२०९-४८", "content_sanskrit": "अत्युक्तमपि मे सर्वं क्षन्तुमर्हस्यनिन्दित।\nस्त्रियो ह्यवध्याः सर्वेषां ये धर्ममभिविन्दते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2026698, "chapter_id": 1571, "verse_number": "३-२०९-४९x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2026699, "chapter_id": 1571, "verse_number": "३-२०९-४९", "content_sanskrit": "प्रीतोस्मि तव भद्रं ते गतः क्रोधश्च शोभने।\nउपालम्भस्त्वया प्रोक्तो मम निश्रेयसं परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2026700, "chapter_id": 1571, "verse_number": "३-२०९-५०", "content_sanskrit": "स्वस्ति तेऽस्तु गमिष्यामि साधयिष्यामि शोभने।\n`धन्या त्वमसि कल्याणि यस्याः स्याद्वृत्तमीदृशम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2026701, "chapter_id": 1571, "verse_number": "३-२०९-५१x", "content_sanskrit": "मारक्ण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2026702, "chapter_id": 1571, "verse_number": "", "content_sanskrit": "तया विसृष्टो निर्गत्य स्वमेव भवनं ययौ।\nविनिन्दन्स स्वमात्मानं कौशिको द्विजसत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}]