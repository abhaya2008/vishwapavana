[{"id": 2039994, "chapter_id": 1885, "verse_number": "५-१३०-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2039995, "chapter_id": 1885, "verse_number": "५-१३०-१", "content_sanskrit": "तत्तु वाक्यमनादृत्य सोऽर्थवन्मातृभाषितम् ।\nपुनः प्रतस्थे संरम्भात्सकाशमकृतात्मनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2039996, "chapter_id": 1885, "verse_number": "५-१३०-२", "content_sanskrit": "ततः सभाया निर्गम्य मन्त्रयामास कौरवः।\nसौबलेन मताक्षेण राज्ञा शकुनिना सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2039997, "chapter_id": 1885, "verse_number": "५-१३०-३", "content_sanskrit": "` दुर्योधनं धार्तराष्ट्रं कर्णं दुःशासनोऽब्रवीति ।\nनोचेत्सन्धास्यसे राजन्स्वेन कामेन पाण्डवैः ।\nबद्ध्वैव त्वां प्रदास्यन्ति पाण्डुपुत्राय भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2039998, "chapter_id": 1885, "verse_number": "५-१३०-४", "content_sanskrit": "वैकर्तनं त्वां च मां च त्रीनेतान्भरतर्षभ ।\nपाण्डवेभ्यः प्रदास्यन्ति भीष्मद्रोणौ पिता च ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2039999, "chapter_id": 1885, "verse_number": "५-१३०-५", "content_sanskrit": "दुःशासनस्य तद्वाक्यं निशम्य भरतर्षभ ।\nदुर्योधनो धार्तराष्ट्रो निश्वस्य प्रहसन्निव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2040000, "chapter_id": 1885, "verse_number": "५-१३०-६", "content_sanskrit": "एकान्तमुपसृत्येह मन्त्रं पुनरमन्त्रयत् ।\nसौबलेन मताक्षेण राज्ञा शकुनिना सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2040001, "chapter_id": 1885, "verse_number": "५-१३०-७", "content_sanskrit": "दुर्योधनस्य कर्णस्य शकुनेः सौबलस्य च।\nदुःशासनचतुर्थानामिदमासीद्विचेष्टितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2040002, "chapter_id": 1885, "verse_number": "५-१३०-८", "content_sanskrit": "पुराऽयमस्मान्गृह्णाति क्षिप्रकारी जनार्दनः ।\nसहितो धृतराष्ट्रेण राज्ञा शान्तनवेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2040003, "chapter_id": 1885, "verse_number": "५-१३०-९", "content_sanskrit": "वयमेव हृषीकेशं निगृह्णीम बलादिव।\nप्रसह्य पुरुषव्याघ्रमिन्द्रो वैरोचनिं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2040004, "chapter_id": 1885, "verse_number": "५-१३०-१०", "content_sanskrit": "श्रुत्वा गृहीतं वार्ष्णेयं पाण्डवा हतचेतसः ।\nनिरुत्साहा भविष्यन्ति भग्नदंष्ट्रा इवोरगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2040005, "chapter_id": 1885, "verse_number": "५-१३०-११", "content_sanskrit": "अयं ह्येषां महाबाहुः सर्वेषां शर्म वर्म च ।\nअस्मिन्गृहीते वरदे ऋषभे सर्वसात्वताम्।\nनिरुद्यमा भविष्यन्ति पाण्डवाः सोमकैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2040006, "chapter_id": 1885, "verse_number": "५-१३०-१२", "content_sanskrit": "तस्माद्वयमिहैवैकं केशवं क्षिप्रकारिणम् ।\nक्रोशतो धृतराष्ट्रस्य बद्ध्वा योत्स्यामहे रिपून् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2040007, "chapter_id": 1885, "verse_number": "५-१३०-१३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2040008, "chapter_id": 1885, "verse_number": "५-१३०-१३", "content_sanskrit": "तेषां पापमभिप्रायं पापानां दुष्टचेतसाम्।\nइङ्गितज्ञः कविः क्षिप्रमन्वबुद्ध्यत सात्यकिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2040009, "chapter_id": 1885, "verse_number": "५-१३०-१४", "content_sanskrit": "तदर्थमभिनिष्क्रम्य हार्दिक्येन सहास्थितः ।\nअब्रवीत्कृतवर्माणं क्षिप्रं योजय वाहिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2040010, "chapter_id": 1885, "verse_number": "५-१३०-१५", "content_sanskrit": "व्यूढानीकः सभाद्वारमुपतिष्ठस्व दंशितः ।\nयावदाख्याम्यहं चैतत्कृष्णायाक्लिष्टकारिणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2040011, "chapter_id": 1885, "verse_number": "५-१३०-१६", "content_sanskrit": "स प्रविश्य सभां वीरः सिंहो गिरिगुहामिव ।\nआचष्ट तमभिप्रायं केशवाय महात्मने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2040012, "chapter_id": 1885, "verse_number": "५-१३०-१७", "content_sanskrit": "धृतराष्ट्रं ततश्चैव विदुरं चान्वभाषत ।\nतेषामेतमभिप्रायमाचचक्षे स्मयन्निव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2040013, "chapter_id": 1885, "verse_number": "५-१३०-१८", "content_sanskrit": "धर्मादर्थाच्च कामाच्च कर्म साधुविगर्हितम् ।\nमन्दाः कर्तुमिहेच्छन्ति न चावाप्यं कथंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2040014, "chapter_id": 1885, "verse_number": "५-१३०-१९", "content_sanskrit": "पुरा विकुर्वते मूढाः पापात्मानः समागताः ।\nधर्षिताः काममन्युभ्यां क्रोधलोभवशानुगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2040015, "chapter_id": 1885, "verse_number": "५-१३०-२०", "content_sanskrit": "इमं हि पुण्डरीकाक्षं जिघृक्षन्त्यल्पचेतसः।\nपटेनाग्निं प्रज्वलितं यथा बाला यथा जडाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2040016, "chapter_id": 1885, "verse_number": "५-१३०-२१", "content_sanskrit": "सात्यकेस्तद्वचः श्रुत्वा विदुरो दीर्घदर्शिवान् ।\nधृतराष्ट्रं महाबाहुमब्रवीत्कुरुसंसदि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2040017, "chapter_id": 1885, "verse_number": "५-१३०-२२", "content_sanskrit": "राजन्परीतकालास्ते पुत्राः सर्वे परन्तप ।\nअसक्यमयशस्यं च कर्तुं कर्म समुद्यताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2040018, "chapter_id": 1885, "verse_number": "५-१३०-२३", "content_sanskrit": "इमं हि पुण्डरीकाक्षमभिभूय प्रसह्य च ।\nनिग्रहीतुं किलेच्छन्ति सहिता वासवानुजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2040019, "chapter_id": 1885, "verse_number": "५-१३०-२४", "content_sanskrit": "इमं पुरुषशार्दूलमप्रधृष्यं दुरसदम् ।\nआसाद्य नभविष्यन्ति पतङ्गा इव पावकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2040020, "chapter_id": 1885, "verse_number": "५-१३०-२५", "content_sanskrit": "अयमिच्छन्हि तान्सर्वान्युध्यमानाञ्जनार्दनः ।\nसिंहो नागानिव क्रुद्धो गमयेद्यमसादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2040021, "chapter_id": 1885, "verse_number": "५-१३०-२६", "content_sanskrit": "न त्वयं निन्दितं कर्म कुर्यात्पापं कथंचन ।\nन च धर्मादपक्रामदेच्युतः पुरुषोत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2040022, "chapter_id": 1885, "verse_number": "५-१३०-२७", "content_sanskrit": "` यथा वाराणसी दग्धा साश्वा सरथकुञ्जरा ।\nसानुबन्धस्तु कृष्णेन काशीनामृषभो हतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2040023, "chapter_id": 1885, "verse_number": "५-१३०-२८", "content_sanskrit": "तथा नागपुरं दग्ध्वा शङ्खचक्रगदाधरः ।\nस्वयं कालेश्वरो भूत्वा नाशयिष्यति कौरवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2040024, "chapter_id": 1885, "verse_number": "५-१३०-२९", "content_sanskrit": "पारिजातहरं ह्येनमेकं यदुसुखावहम्।\nनाभ्यवर्तत संरब्धो वृत्रहा वसुभिः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2040025, "chapter_id": 1885, "verse_number": "५-१३०-३०", "content_sanskrit": "प्राप्य निर्मोचने पाशान्षट्सहस्रांस्तरस्विनः ।\nहृतास्ते वासुदेवेन ह्युपसङ्क्रम्य कौरवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2040026, "chapter_id": 1885, "verse_number": "५-१३०-३१", "content_sanskrit": "द्वारमासाद्य सौभस्य विधूय गदया गिरिम्।\nद्युमत्सेनः सहामात्यः कृष्णेन विनिपातितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2040027, "chapter_id": 1885, "verse_number": "५-१३०-३२", "content_sanskrit": "शेषवत्त्वात्कुरूणां तु धर्मापेक्षी तथाऽच्युतः ।\nक्षमते पुण्डरीकाक्षः शक्तः सन्पापकर्मणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2040028, "chapter_id": 1885, "verse_number": "५-१३०-३३", "content_sanskrit": "एते हि यदि गोविन्दमिच्छन्ति सह राजभिः ।\nअद्यैवातिथयः सर्वे भविष्यन्ति यमस्य ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2040029, "chapter_id": 1885, "verse_number": "५-१३०-३४", "content_sanskrit": "यथा वायोस्तृणाग्रणि वशं यान्ति बलीयसः।\nतथा चक्रभृतः सर्वे वशमेष्यन्ति कौरवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2040030, "chapter_id": 1885, "verse_number": "५-१३०-३५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2040031, "chapter_id": 1885, "verse_number": "५-१३०-३५", "content_sanskrit": "विदुरेणैवमुक्ते तु केशवो वाक्यमब्रवीत् ।\nधृतराष्ट्रमभिप्रेक्ष्य सुहृदां श्रृण्वतां मिथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2040032, "chapter_id": 1885, "verse_number": "५-१३०-३६", "content_sanskrit": "राजन्नेते यदि क्रुद्धा मां निगृह्णीयुरोजसा ।\nएते वा मामहं वैनाननुजानीहि पार्थिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2040033, "chapter_id": 1885, "verse_number": "५-१३०-३७", "content_sanskrit": "एतान्हि सर्वान्संरब्धान्नियन्तुमहमुत्सहे ।\nन त्वहं निन्दितं कर्म कुर्यां पापं कथंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2040034, "chapter_id": 1885, "verse_number": "५-१३०-३८", "content_sanskrit": "पाण्डवार्थे हि लुभ्यन्तः स्वार्थान्हास्यन्ति ते सुताः ।\nएते चेदेवमिच्छन्ति कृतकार्यो युधिष्ठिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2040035, "chapter_id": 1885, "verse_number": "५-१३०-३९", "content_sanskrit": "अद्यैव ह्यहमेनांश्च ये चैनाननु भारत ।\nनिगृह्य राजन्पार्थेभ्यो दद्यां किं दुष्कृतं भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2040036, "chapter_id": 1885, "verse_number": "५-१३०-४०", "content_sanskrit": "` एष मे निश्चयो राजन्यद्येषोऽस्य विनिश्चयः ।\nनर्दन्तु सहिताः शङ्खाः पणवानकनिस्वनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2040037, "chapter_id": 1885, "verse_number": "५-१३०-४१", "content_sanskrit": "अनायासेन पार्थानां पर्वतां च शिवं महत्।\nनिगृह्य राजन्पार्थेभ्यो दद्यां चेत्सुकृतं भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2040038, "chapter_id": 1885, "verse_number": "५-१३०-४२", "content_sanskrit": "इदं तु न प्रवर्तेयं निन्दितं कर्म भारत ।\nसन्निधौ ते महाराज क्रोधजं पापबुद्धिजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2040039, "chapter_id": 1885, "verse_number": "५-१३०-४३", "content_sanskrit": "एष दुर्योधनो राजन्यथेच्छति तथाऽस्तु तत्।\nअहं तु सर्वांस्तनयाननुजानामि ते नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2040040, "chapter_id": 1885, "verse_number": "५-१३०-४४", "content_sanskrit": "एतच्छ्रुत्वा तु विदुरं धृतराष्ट्रोऽभ्यभाषत ।\nक्षिप्रमानय तं पापं राज्यलुब्धं सुयोधनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2040041, "chapter_id": 1885, "verse_number": "५-१३०-४५", "content_sanskrit": "सहमित्रं सहामात्यं ससोदर्यं सहानुगम्।\nशक्नुयां यदि पन्थानमवतारयितुं पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2040042, "chapter_id": 1885, "verse_number": "५-१३०-४६", "content_sanskrit": "ततो दुर्योधनं क्षत्ता पुनः प्रावेशयत्मभाम् ।\nअकामं भ्रातृभिः सार्धं राजभिः परिवारितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2040043, "chapter_id": 1885, "verse_number": "५-१३०-४७", "content_sanskrit": "अथ दुरोयधनं राजा धृतराष्ट्रोऽभ्यभाषत ।\nकर्णदुःशासनाभ्यां च राजभिश्चापि संवृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2040044, "chapter_id": 1885, "verse_number": "५-१३०-४८", "content_sanskrit": "नृशंस पापभूयिष्ठ क्षुद्रकर्मसहायवान्।\nपापैः सहायैः संहत्य पापं कर्म चिकीर्षसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2040045, "chapter_id": 1885, "verse_number": "५-१३०-४९", "content_sanskrit": "अशक्यमयशस्यं च सद्भिश्चापि विगर्हितम् ।\nयथा त्वादृशको मूढो व्यवस्येत्कुलपांसनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2040046, "chapter_id": 1885, "verse_number": "५-१३०-५०", "content_sanskrit": "त्वमिमं पुण्डरीकाक्षमप्रधृष्यं दुरासदम् ।\nपापैः सहायैः संहत्य निग्रहीतुं किलेच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2040047, "chapter_id": 1885, "verse_number": "५-१३०-५१", "content_sanskrit": "यो न शक्यो बलात्कर्तुं देवैरपि सवासवैः ।\nतं त्वं प्रार्थयसे मन्द बालश्चन्द्रमसं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2040048, "chapter_id": 1885, "verse_number": "५-१३०-५२", "content_sanskrit": "देवैर्मनुष्यैर्गन्धर्वैरसुरैरुरगैश्च यः।\nन सोढुं समरे शक्यस्तं न बुध्यसि केशवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2040049, "chapter_id": 1885, "verse_number": "५-१३०-५३", "content_sanskrit": "दुर्ग्राह्यः पाणिना वायुर्दुस्पर्शः पाणिना शशी ।\nदुर्धरा पृथिवी मूर्ध्ना दुर्ग्राह्यः केशवो बलात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2040050, "chapter_id": 1885, "verse_number": "५-१३०-५४", "content_sanskrit": "इत्युक्ते धृतराष्ट्रेण क्षत्ताऽपि विदुरोऽब्रवीत्।\nदुर्योधनमभिप्रेक्ष्य धार्तराष्ट्रममर्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2040051, "chapter_id": 1885, "verse_number": "५-१३०-५५", "content_sanskrit": "दुर्योधन निबोधेदं वचनं मम सांप्रतम्।\nसौभद्वारे वानरेन्द्रो द्विविदो नाम नामतः।\nशिलावर्षेण महता छादयामास केशवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2040052, "chapter_id": 1885, "verse_number": "५-१३०-५६", "content_sanskrit": "ग्रहीतुकामो विक्रम्य सर्वयत्नेन माधवम् ।\nग्रहीतुं नाशकच्चैनं तं त्वं प्रार्थयसे बलात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2040053, "chapter_id": 1885, "verse_number": "५-१३०-५७", "content_sanskrit": "प्राग्ज्योतिषगतं शौरिं नरकः सह दानवैः ।\nग्रहीतुं नाशकत्तत्र तं त्वं प्रार्थयसे बलात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2040054, "chapter_id": 1885, "verse_number": "५-१३०-५८", "content_sanskrit": "अनेकयुगवर्षायुर्निहत्य नरकं मृधे ।\nनीत्वा कन्यासहस्राणि उपयेमे यथाविधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2040055, "chapter_id": 1885, "verse_number": "५-१३०-५९", "content_sanskrit": "निर्मोचने षट्सहस्राः पाशैर्बद्ध्वा महासुराः ।\nग्रहीतुं नाशकंश्चैनं तं त्वं प्रार्थयसे बलात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2040056, "chapter_id": 1885, "verse_number": "५-१३०-६०", "content_sanskrit": "अनेन हि हता बाल्ये पूतना शिशुना तदा।\nगोवर्धनो धारितश्च गवार्थे भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2040057, "chapter_id": 1885, "verse_number": "५-१३०-६१", "content_sanskrit": "अरिष्टो धेनुकश्चैव चाणूरश्च महाबलः।\nअश्वराजश्च निहतः कंसश्चारिष्टमाचरन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2040058, "chapter_id": 1885, "verse_number": "५-१३०-६२", "content_sanskrit": "जरासन्धश्च वक्रश्च शिशुपालश्च वीर्यवान् ।\nबाणाश्च निहतः सङ्ख्ये राजानश्च निषूदिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2040059, "chapter_id": 1885, "verse_number": "५-१३०-६३", "content_sanskrit": "वरुणो निर्जितो राजा पावकश्चामितौजसा ।\nपारिजातं च हरता जितः साक्षाच्छचीपतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2040060, "chapter_id": 1885, "verse_number": "५-१३०-६४", "content_sanskrit": "एकार्णवे च स्वपता निहतौ मधुकैटभौ ।\nजन्मान्तरमुपागम्य हयग्रीवस्तथा हतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2040061, "chapter_id": 1885, "verse_number": "५-१३०-६५", "content_sanskrit": "अयं कर्ता न क्रियते कारणं चापि पौरुषे ।\nयद्यदिच्छेदयं शौरिस्तत्तत्कुर्यादयत्नतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2040062, "chapter_id": 1885, "verse_number": "५-१३०-६६", "content_sanskrit": "तं न बुध्यसि गोविन्द घोरविक्रममच्युतम्।\nआशीविषमिव क्रूद्धं तेजोराशिमनिन्दितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2040063, "chapter_id": 1885, "verse_number": "५-१३०-६७", "content_sanskrit": "प्रधर्षयन्महाबाहुं कृष्णमक्लिष्टकारिणम्।\nपतङ्गोऽग्निमिवासाद्य सामात्यो नभविष्यसि ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2040064, "chapter_id": 1885, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि त्रिंशदधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}]