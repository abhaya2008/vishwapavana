[{"id": 7003530000, "chapter_id": 23530, "verse_number": "१७०-१", "content_sanskrit": "श्रीवराह उवाच ।\nपुनरन्यत् प्रवक्ष्यामि तच्छृणुष्व वसुन्धरे ।\nमथुरायां पुरा वृत्तं गोकर्णस्य महात्मनः ।\nवसुकर्णः पिता तस्य वैश्यो धनसमृद्धिमान् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003530001, "chapter_id": 23530, "verse_number": "१७०-२", "content_sanskrit": "तस्य भार्या सुशीला तु नाम्ना गुणसमन्विता ।\nभर्त्तुः प्रियकरी साध्वी न प्रसूता वयोऽधिका ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003530002, "chapter_id": 23530, "verse_number": "१७०-३", "content_sanskrit": "विललाप च सुश्रोणि चैकान्ते दीनमानसा ।\nसरस्वती संगमेऽथ स्त्रियो दृष्ट्वा प्रजावतीः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003530003, "chapter_id": 23530, "verse_number": "१७०-४", "content_sanskrit": "वृक्षमूले तु तत्रैव मुनिरेकः समास्थितः ।\nतस्या विलपितं श्रुत्वा शनैः सकरुणं हृदि ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003530004, "chapter_id": 23530, "verse_number": "१७०-५", "content_sanskrit": "जात हार्दः प्रियं चेष्टं शनैः स्त्रियमथाब्रवीत् ।\nका त्वं कस्यासि सुभगे किमर्थं रोदिषि स्वयम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003530005, "chapter_id": 23530, "verse_number": "१७०-६", "content_sanskrit": "इति तस्य वचः श्रुत्वा सा स्त्री ऋषिमथाब्रवीत् ।\nसापत्यास्तु स्त्रियो दृष्ट्वा क्रीडन्त्यो बालकैः सह ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003530006, "chapter_id": 23530, "verse_number": "१७०-७", "content_sanskrit": "मम तन्नास्ति हि मुने दुर्भगायाः प्रजासुखम् ।\nउवाच मुनिशार्दूलस्तां स्त्रियं पुत्रगर्द्धिनीम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003530007, "chapter_id": 23530, "verse_number": "१७०-८", "content_sanskrit": "देवतायाः प्रसादेन तव पुत्रो भविष्यति ।\nशिवस्यायतनं पुण्यं गोकर्णेति च विश्रुतम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003530008, "chapter_id": 23530, "verse_number": "१७०-९", "content_sanskrit": "तमाराधय देवेशं पत्या सह यशस्विनि ।\nस्नानदीपोपहारेण स्तोत्रैर्नानाविधैर्जपैः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003530009, "chapter_id": 23530, "verse_number": "१७०-१०", "content_sanskrit": "इत्युक्ता सा च सुश्रोणी प्रणिपत्य प्रसाद्य तम् ।\nभर्त्रे सा कथयामास यदुक्तं मुनिना प्रियम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003530010, "chapter_id": 23530, "verse_number": "१७०-११", "content_sanskrit": "स तद्वचनमाकर्ण्य प्रीतियुक्तं सुसंयुतम् ।\nजगादोच्चैः प्रियां देवि भद्रं जातो मनोरथः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003530011, "chapter_id": 23530, "verse_number": "१७०-१२", "content_sanskrit": "ममाप्येतन्मतं देवि यदुक्तमृषिणा ततः ।\nइति प्रियां समाभाष्य प्रियया च तथाऽकरोत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003530012, "chapter_id": 23530, "verse_number": "१७०-१३", "content_sanskrit": "सरस्वत्याः संगमे तौ स्नात्वा   गोकर्णमर्चतुः ।\nपुष्पदीपोपहारं तु चक्राते तौ दिनेदिने ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003530013, "chapter_id": 23530, "verse_number": "१७०-१४", "content_sanskrit": "एवं तयोर्दशाब्दानि गतानि सुतहेतवे ।\nततः प्रसन्नो भगवानुमापतिरुवाच ह ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003530014, "chapter_id": 23530, "verse_number": "१७०-१५", "content_sanskrit": "भविष्यति युवां पुत्रो रूपवान्गुणसंयुतः ।\nसस्यसन्ततिवद्दृश्यः सन्तानो यस्य वै बहु ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003530015, "chapter_id": 23530, "verse_number": "१७०-१६", "content_sanskrit": "देवतानां प्रसादेन तदुक्तस्य भविष्यति ।\nइत्युक्तौ तौ तु देवेन स्नानं कृत्वा सरस्वतीम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003530016, "chapter_id": 23530, "verse_number": "१७०-१७", "content_sanskrit": "प्रभाते देवदेवाय ददौ द्रव्यमनन्तकम् ।\nब्राह्मणेभ्यो ददौ भोज्यं वस्त्राय बहुदक्षिणम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003530017, "chapter_id": 23530, "verse_number": "१७०-१८", "content_sanskrit": "ततस्तस्यां सुशीलायां गर्भाधानमविन्दत ।\nततः प्रववृधे गर्भः शुक्लपक्षे यथा शशी ।\nसुषुवे दशमे मासि पुत्रं बालं शशिप्रभम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003530018, "chapter_id": 23530, "verse_number": "१७०-१९", "content_sanskrit": "गोसहस्रं तदा दत्त्वा ससुवर्णं सवस्त्रकम् ।\nबहुशः सर्ववर्णेभ्यः पुत्रजन्ममहोत्सवे ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003530019, "chapter_id": 23530, "verse_number": "१७०-२०", "content_sanskrit": "जातकर्म तथा चैव नामकर्म चकार च ।\nगोकर्णं नाम तस्यैव पिता चक्रे निरूप्य च ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003530020, "chapter_id": 23530, "verse_number": "१७०-२१", "content_sanskrit": "एवमन्नप्राशनं च चूडोपनयनं तथा ।\nअतःपरं च गोदानं वैवाहिकमनुत्तमम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003530021, "chapter_id": 23530, "verse_number": "१७०-२२", "content_sanskrit": "दानं तु ददतस्तस्य देवतां पूजयिष्यतः ।\nकृतानि बहुमुख्यानि मंगलानि यथाविधि ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003530022, "chapter_id": 23530, "verse_number": "१७०-२३", "content_sanskrit": "ततः प्रविष्टे तारुण्ये त्वप्रजं वीक्ष्य पुत्रकम् ।\nपुनर्विवाहयामास भार्याणां च चतुष्टयम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003530023, "chapter_id": 23530, "verse_number": "१७०-२४", "content_sanskrit": "वयोरूपगुणोपेतास्तस्य भार्याः सुलोचनाः ।\nअप्रजा एव ताः सर्वा नाभवत्पुत्रिणी क्वचित् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003530024, "chapter_id": 23530, "verse_number": "१७०-२५", "content_sanskrit": "तेनैव धर्म आरब्धः प्रजार्थो देवसेवनम् ।\nवापीकूपतडागानि देवतायतनानि च ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003530025, "chapter_id": 23530, "verse_number": "१७०-२६", "content_sanskrit": "प्रपामालाश्च नित्यान्नं भोजनं वर्त्तनानि च ।\nअनित्यतां ततो मत्वा चंचलाऽस्थिरजीवितम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003530026, "chapter_id": 23530, "verse_number": "१७०-२७", "content_sanskrit": "विनियोगः कृतस्तेन सर्वदा सर्वकर्मसु ।\nगोकर्णस्य समीपे तु पश्चिमे चक्रपाणिनः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003530027, "chapter_id": 23530, "verse_number": "१७०-२८", "content_sanskrit": "प्रासादं कारयामास पंचायतनकं हरेः ।\nआरामस्तत्र विस्तीर्णः पुष्पजात्यस्तथैव च ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003530028, "chapter_id": 23530, "verse_number": "१७०-२९", "content_sanskrit": "आम्रजम्बीरनारङ्गं बीजपूरः सदाडिमः ।\nप्राकारं कारयामास परिखामण्डलीयकम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003530029, "chapter_id": 23530, "verse_number": "१७०-३०", "content_sanskrit": "प्रावर्त्तनं च कूपेषु येन सिंचेत्प्रवाटिकाम् ।\nपुष्पाणि च विचिन्वंति सर्वास्ता वरयोषितः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003530030, "chapter_id": 23530, "verse_number": "१७०-३१", "content_sanskrit": "स्नानं पूजादिकं तद्वन्मार्जनं दीपकर्म च ।\nकुर्वन्ति देवतागारे ताः सर्वाः शुभलोचना ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003530031, "chapter_id": 23530, "verse_number": "१७०-३२", "content_sanskrit": "पतिव्रता महाभागाश्चतुरो भगिनीर्यथा ।\nनित्यकालं पतेर्वाक्ये स्थिताः कुर्वन्त्यहर्निशम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003530032, "chapter_id": 23530, "verse_number": "१७०-३३", "content_sanskrit": "मालाकारस्तथा नित्यं विटपांश्च प्रसिंचति ।\nपालयामास विधिवद्विधिदृष्टेन कर्मणा ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003530033, "chapter_id": 23530, "verse_number": "१७०-३४", "content_sanskrit": "जाताः सुपुष्पवन्तश्च द्रुमाः फलसमन्विताः ।\nनित्यकालं त्वर्पयन्तः फलानां सुमहोत्सवम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003530034, "chapter_id": 23530, "verse_number": "१७०-३५", "content_sanskrit": "दीयते भुज्यते सर्वैर्यथा शक्रस्तथा सदा ।\nएवं तु वसतस्तस्य मथुरायां स्थितस्य च ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003530035, "chapter_id": 23530, "verse_number": "१७०-३६", "content_sanskrit": "धनस्य संक्षयो जातः प्रत्यहं ददतः सतः ।\nशेषमात्रे धने तस्य चिन्ताभून्महती तदा ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003530036, "chapter_id": 23530, "verse_number": "१७०-३७", "content_sanskrit": "मातापित्रोः कुटुम्बस्य भरणीयस्य भोजनम् ।\nकथं ब्रूहि करिष्यामि महाकष्टं तु सोऽब्रवीत् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003530037, "chapter_id": 23530, "verse_number": "१७०-३८", "content_sanskrit": "इति निश्चित्य मनसा वणिग्भावं हृदि स्थिरम् ।\nकृत्वा सार्थमुपामन्त्र्य निर्गतः पूर्वमण्डलम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003530038, "chapter_id": 23530, "verse_number": "१७०-३९", "content_sanskrit": "तत्र क्रीत्वा सुपण्यानि उत्तरापथगानि च ।\nयातायातं ततः कृत्वा लाभालाभविचक्षणः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003530039, "chapter_id": 23530, "verse_number": "१७०-४०", "content_sanskrit": "क्रीत्वा क्रेयानि वस्तूनि लाभालाभं विचार्य च ।\nउत्तरापथदेशात्तु सार्थं सबहुविस्तरम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003530040, "chapter_id": 23530, "verse_number": "१७०-४१", "content_sanskrit": "मणिरत्नं ह्यश्वरत्नं पट्टरत्नं समर्थकम् ।\nगृहीत्वा तु समागच्छन्मथुरायां गृहं प्रति ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003530041, "chapter_id": 23530, "verse_number": "१७०-४२", "content_sanskrit": "एकदा सार्थसम्भारो विश्रान्तुमुपचक्रमे ।\nसानौ पर्वतसामीप्ये प्रभूतयवसोदके ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003530042, "chapter_id": 23530, "verse_number": "१७०-४३", "content_sanskrit": "नद्यास्तीरे सुप्रदेशे आवासांश्च प्रचक्रिरे ।\nनिवेश्य भाण्डं तत्रैव अश्वानां यवसादिकम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003530043, "chapter_id": 23530, "verse_number": "१७०-४४", "content_sanskrit": "समादिश्येतिकृत्यं च भृत्यैः कतिपयैर्वृतः ।\nसमारुरोह तं शैलं बहुकन्दरशोभितम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003530044, "chapter_id": 23530, "verse_number": "१७०-४५", "content_sanskrit": "क्रीडार्थं विहरंस्तत्र सोऽपश्यत् स्थानमुत्तमम् ।\nप्रसन्नसलिलोपेतं नारङ्गैस्तु विभूषितम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003530045, "chapter_id": 23530, "verse_number": "१७०-४६", "content_sanskrit": "फलवन्तश्च वृक्षाश्च पुष्पाणि सुरभीणि च ।\nपाषाणसन्धौ तत्रस्थैर्मालाकारैस्तु रोपितम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003530046, "chapter_id": 23530, "verse_number": "१७०-४७", "content_sanskrit": "तत्रारुह्य दरीद्वारं यावद्दृष्टिर्निपात्यते ।\nतावदभ्यागतादीनि स्वागतादि शृणोति च ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003530047, "chapter_id": 23530, "verse_number": "१७०-४८", "content_sanskrit": "श्रुत्वापि शब्दप्रभवं किमेतदिति निश्चयम् ।\nकरिष्यंस्तत्र चैकान्ते दृष्टः पञ्जरगः शुकः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003530048, "chapter_id": 23530, "verse_number": "१७०-४९", "content_sanskrit": "तेनोक्तं भो इहागच्छ आतिथ्यं करवाणि ते ।\nपाद्यं गृहाण भोः पान्थ आसनं ते इदं शुभम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003530049, "chapter_id": 23530, "verse_number": "१७०-५०", "content_sanskrit": "फलानीमानि स्वादूनि मधुमांसोदकानि च ।\nयथेष्टं यावतीच्छा च तावद्गृह्णन्त्विमे नराः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003530050, "chapter_id": 23530, "verse_number": "१७०-५१", "content_sanskrit": "आगत्य पितरौ मह्यं विशेषं तौ करिष्यतः ।\nअतिथेरागतस्येह पूजाया विमुखो भवेत् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003530051, "chapter_id": 23530, "verse_number": "१७०-५२", "content_sanskrit": "गृहस्थस्तस्य पितरो वसन्ति नरके ध्रुवम् ।\nपूजिते पूजिताः स्वर्गे मोदन्ते कालमक्षयम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003530052, "chapter_id": 23530, "verse_number": "१७०-५३", "content_sanskrit": "अतिथिर्यस्य भग्नाशो गृहात्प्रव्रजते यदि ।\nआत्मनो दुष्कृतं तस्मै दत्त्वा तत्सुकृतं हरेत् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003530053, "chapter_id": 23530, "verse_number": "१७०-५४", "content_sanskrit": "तस्मात्सर्वप्रयत्नेन पूज्यो वै गृहमेधिना ।\nकाले प्राप्तस्त्वकाले वा यथा विष्णुस्तथैव सः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003530054, "chapter_id": 23530, "verse_number": "१७०-५५", "content_sanskrit": "एवंविधाः शुभा वाचो वैश्यो धर्मोपदेशकात् ।\nश्रुत्वा शुकात्स सर्वस्मै गोकर्णो मुदितोऽब्रवीत् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003530055, "chapter_id": 23530, "verse_number": "१७०-५६", "content_sanskrit": "ऋषिः कस्त्वं पुराणज्ञः किं वा देवोऽथ गुह्यकः ।\nतव प्रसन्नरूपस्य यस्येयं वागमानुषी ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003530056, "chapter_id": 23530, "verse_number": "१७०-५७", "content_sanskrit": "कस्त्वं कथय मे सत्यमुत्साहश्चातिथिप्रियः ।\nधन्यः स मानुषो यस्य नित्यं सन्निहितो भवान् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003530057, "chapter_id": 23530, "verse_number": "१७०-५८", "content_sanskrit": "इत्युक्तः स शुकः सर्वं शशंसात्मपुराकृतम् ।\nशृणु रौद्रं यथा पूर्वे मया कृतमबुद्धिना ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003530058, "chapter_id": 23530, "verse_number": "१७०-५९", "content_sanskrit": "शुकस्य विप्रियं यादृङ् महर्षेस्तु तपस्यतः ।\nसुमेरोरुत्तरे पार्श्वे महर्षिगणसेविते ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003530059, "chapter_id": 23530, "verse_number": "१७०-६०", "content_sanskrit": "तपश्चचार विपुलं शुको व्याससुतो महान् ।\nश्रोतुकामाः पुराणानि सेतिहासानि नैगमाः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003530060, "chapter_id": 23530, "verse_number": "१७०-६१", "content_sanskrit": "ऋषयस्तत्र चाजग्मुरसितो देवलस्तदा ।\nमार्कण्डेयो भरद्वाजो यवक्रीतस्ततो भृगुः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003530061, "chapter_id": 23530, "verse_number": "१७०-६२", "content_sanskrit": "अङ्गिरास्तैत्तिरी रैभ्यः काण्वो मेधातिथिः कृतः ।\nतन्तुः सुतन्तुरादित्यो वसुमानेकतो द्वितः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003530062, "chapter_id": 23530, "verse_number": "१७०-६३", "content_sanskrit": "वामदेवश्चाश्वशिरास्त्रिशीर्षो गौतमोदरः ।\nअन्ये च सिद्धा देवाश्च पन्नगा गुह्यकास्तथा ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003530063, "chapter_id": 23530, "verse_number": "१७०-६४", "content_sanskrit": "शुकं सम्मुखयामासुः पप्रच्छुर्द्धर्मसंहिताम् ।\nअहं तु वामदेवस्य शिष्यो नाम्ना शुकोदरः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003530064, "chapter_id": 23530, "verse_number": "१७०-६५", "content_sanskrit": "भ्रष्टः श्रद्धान्वितो बाल्यात्सुनीत्यामग्रतश्चरन् ।\nऊहापोहकरं प्रश्नं वारंवारं च पृष्टवान् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003530065, "chapter_id": 23530, "verse_number": "१७०-६६", "content_sanskrit": "अन्यायवादिनं मां च गुरुर्नित्यं निषेधति ।\nगुरूणामग्रतो वाक्यं कथायां वदतां सह ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003530066, "chapter_id": 23530, "verse_number": "१७०-६७", "content_sanskrit": "पूर्वपक्षाश्च सिद्धान्ताः परस्परजिगीषवः ।\nअन्तरे चान्तराक्षेपं पुनर्नैवमवोचथाः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003530067, "chapter_id": 23530, "verse_number": "१७०-६८", "content_sanskrit": "एवं निषेधितश्चाहं गुरुणा मुनिसत्तमैः ।\nन कृतं यन्मया वाक्यं तेनाहं शपितस्तदा ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003530068, "chapter_id": 23530, "verse_number": "१७०-६९", "content_sanskrit": "शुकेन कोपाच्छापो मे दत्तोऽयं जल्पको बटुः ।\nयथानामा त्वयं पक्षी शुको भवति नान्यथा ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003530069, "chapter_id": 23530, "verse_number": "१७०-७०", "content_sanskrit": "इत्युक्तमात्रे वचने तत्रैवाहं शुकोदरः ।\nशुकत्वं तत्क्षणात्प्राप्तः क्षमस्वेत्यूचु तेजसा ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003530070, "chapter_id": 23530, "verse_number": "१७०-७१", "content_sanskrit": "मुनयस्तं महात्मानं शुकं तत्त्वार्थवित्तमम् ।\nनान्यथा नान्यथा चोक्तं कदाचित्त्संभविष्यति ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003530071, "chapter_id": 23530, "verse_number": "१७०-७२", "content_sanskrit": "आगामिकाले दास्यामि वरमस्मै शुकाय भो ।\nयुष्माकमुपरोधेन यथारूपो विहङ्गमः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003530072, "chapter_id": 23530, "verse_number": "१७०-७३", "content_sanskrit": "अयं भविष्यति सदा सद्भावहितभावनः ।\nपुराणतत्त्ववेत्ता च सर्वशास्त्रार्थपारगः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003530073, "chapter_id": 23530, "verse_number": "१७०-७४", "content_sanskrit": "मथुरायां मृतः पश्चाद्ब्रह्मलोकं गमिष्यति ।\nएवं शापं वरं गृह्य तस्माद्दीनो ह्यहं द्रुतम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003530074, "chapter_id": 23530, "verse_number": "१७०-७५", "content_sanskrit": "मथुरामथुरोच्चारं कुर्वन्नित्यमतन्द्रितः।\nनित्योद्विग्नश्च मे गात्रे हिमाद्रौ तु गुहां वसन् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003530075, "chapter_id": 23530, "verse_number": "१७०-७६", "content_sanskrit": "प्राप्तोऽहं शबरेणैव येनाहं पञ्जरे धृतः ।\nशबरस्तु सभार्यो वै क्रीडते स मया सह ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003530076, "chapter_id": 23530, "verse_number": "१७०-७७", "content_sanskrit": "मुनेः प्रसादान्मे ज्ञानं न जहाति कदाचन ।\nभुज्यते ह्यवशेनैव कृतं येन यथा च यत् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003530077, "chapter_id": 23530, "verse_number": "१७०-७८", "content_sanskrit": "स्वस्थो भव महाभाग मा स्म शोके मनः कृथाः।\nइत्युक्तः स तु गोकर्णस्तदा तेन शुकेन च ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003530078, "chapter_id": 23530, "verse_number": "१७०-७९", "content_sanskrit": "तस्य तद्वचनं हृद्यं शुकमोक्षप्रदायकम् ।\nया सा मुक्तिप्रदा रम्या मधुरा पापनाशिनी ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003530079, "chapter_id": 23530, "verse_number": "१७०-८०", "content_sanskrit": "तस्यां वसाम्यहं भद्र वाणिज्यार्थमिहागतः ।\nपुनरिच्छामहे तत्र भाण्डं गृह्य यथासुखम् ।170.८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003530080, "chapter_id": 23530, "verse_number": "१७०-८१", "content_sanskrit": "मथुरावासिनं श्रुत्वा गोकर्णं स शुकस्तदा ।\nपुत्रं संस्थाप्य चात्मानं गोकर्णस्य यथेप्सितम् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003530081, "chapter_id": 23530, "verse_number": "१७०-८२", "content_sanskrit": "एवं च वदतस्तस्य शबरी शयनोत्थिता ।\nदर्पान्निर्गत्य तु बहिर्ददर्शासनसंस्थितम् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003530082, "chapter_id": 23530, "verse_number": "१७०-८३", "content_sanskrit": "भृत्यैः परिवृतं चारुदर्शनीयस्वरूपकम् ।\nनिरीक्ष्य बहुशस्तत्र शुको वचनमब्रवीत् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003530083, "chapter_id": 23530, "verse_number": "१७०-८४", "content_sanskrit": "प्रियातिथिं च संप्राप्तं मातः पूज्यतमं शुचिम् ।\nकुरु पूजां यथार्हं च गोकर्णस्य वरातिथेः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003530084, "chapter_id": 23530, "verse_number": "१७०-८५", "content_sanskrit": "शुकस्य वचनाद्यावत्पूजार्थमुपकल्पितम् ।\nन ददाति ततस्तत्र वनाच्छबर आगतः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003530085, "chapter_id": 23530, "verse_number": "१७०-८६", "content_sanskrit": "तस्याग्रे तु पुनस्तेन शुकेनातिथिपूजनम् ।\nशंसितं स तथेत्युक्त्वा कृत्वा पूजां प्रणम्य च ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003530086, "chapter_id": 23530, "verse_number": "१७०-८७", "content_sanskrit": "फलानि मांसयुक्तानि मधूनि सुरभीणि च ।\nसंपाद्य संविदं कृत्वा वद किङ्करवाणि ते ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003530087, "chapter_id": 23530, "verse_number": "१७०-८८", "content_sanskrit": "इत्युक्तः शबरेणाथ गोकर्णो वाक्यमब्रवीत् ।\nअन्यत्किंचिदथो देयं यदि किंचिद्ददासि च ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003530088, "chapter_id": 23530, "verse_number": "१७०-८९", "content_sanskrit": "शुकोऽयं पञ्जरस्श्चश्च पुत्रार्थं मे प्रदीयताम् ।\nमथुरायां गमिष्यामि कृतार्थः पितुरन्तिके ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003530089, "chapter_id": 23530, "verse_number": "१७०-९०", "content_sanskrit": "इत्युक्तमात्रे वचने शबरो वाक्यमब्रवीत् ।\nअस्माकं यमुनास्नानं सङ्गमे यमुनाम्भसः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003530090, "chapter_id": 23530, "verse_number": "१७०-९१", "content_sanskrit": "सरस्वत्याः फले चैव दत्ते दास्यामि ते शुकम् ।\nशबरेणैवमुक्तस्तु गोकर्णः प्रत्यभाषत ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003530091, "chapter_id": 23530, "verse_number": "१७०-९२", "content_sanskrit": "सरस्वत्याः सङ्गमे च यत्फलं लभते नरः ।\nस्नानेन किं फलं तस्य यदि जानासि तद्वद ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003530092, "chapter_id": 23530, "verse_number": "१७०-९३", "content_sanskrit": "शबर उवाच ।\nशुकेनानेन मे सर्वं मथुरायाश्च यत्फलम् ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003530093, "chapter_id": 23530, "verse_number": "१७०-९४", "content_sanskrit": "यत्फलं सङ्गमस्योक्तं शृणुयाद्द्वादशीव्रतम् ।\nवियोनिस्थो राक्षसो वा तिर्यग्योनिं गतस्य वा ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003530094, "chapter_id": 23530, "verse_number": "१७०-९५", "content_sanskrit": "यमुद्दिश्य व्रतं कुर्यात्स गच्छेत्परमां गतिम् ।\nसङ्गमस्य फलं तस्य दृष्ट्वा गोकर्णमीश्वरम् ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003530095, "chapter_id": 23530, "verse_number": "१७०-९६", "content_sanskrit": "नासौ यमपुरं याति विष्णुलोकं च गच्छति ।\nएवं मया श्रुतं तस्य सङ्गमस्य महाफलम् ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}]