[{"id": 2027968, "chapter_id": 1602, "verse_number": "३-२४०-०x", "content_sanskrit": "वैसंपायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2027969, "chapter_id": 1602, "verse_number": "३-२४०-१", "content_sanskrit": "धृतराष्ट्रं ततः सर्वेददृशुर्जनमेजय।\nदृष्ट्वा सुखमथो राज्ञः पृष्टा राज्ञा च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2027970, "chapter_id": 1602, "verse_number": "३-२४०-२", "content_sanskrit": "ततस्तैर्विहितः पूर्वं संगवो नाम वल्लवः।\nसमीपस्थास्तदा गावो धृतराष्ट्रे न्यवेदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2027971, "chapter_id": 1602, "verse_number": "३-२४०-३", "content_sanskrit": "अनन्तरं च राधेयः शकुनिश्च विशांपते।\nआहतुः पार्थिवश्रेष्ठं धृतराष्ट्रं जनाधिपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2027972, "chapter_id": 1602, "verse_number": "३-२४०-४", "content_sanskrit": "रमणीयेषु देशेषु घोषाः संप्रति कौरव।\nस्मारणे समयः प्राप्तो वत्सानामपि चाङ्कनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2027973, "chapter_id": 1602, "verse_number": "३-२४०-५", "content_sanskrit": "मृगया चोचिता राजन्नस्मिन्काले सुतस्यते।\nदुर्योधनस्य गमनं त्वमनुज्ञातुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2027974, "chapter_id": 1602, "verse_number": "३-२४०-६x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2027975, "chapter_id": 1602, "verse_number": "३-२४०-६", "content_sanskrit": "मृगया शोभना तात गवां हि समवेक्षणम्।\nविस्रम्भस्तु न गन्तव्यो वल्लवानामिति स्मरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2027976, "chapter_id": 1602, "verse_number": "३-२४०-७", "content_sanskrit": "ते तु तत्रनरव्याघ्राः समीप इति नः श्रुतम्।\nअतो नाभ्यनुजानामि गमनं तत्र वः स्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2027977, "chapter_id": 1602, "verse_number": "३-२४०-८", "content_sanskrit": "छद्मना निर्जितास्ते तु कर्शिताश्च महावने।\nतपोनित्याश्च राधेय समर्थाश्च महारथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2027978, "chapter_id": 1602, "verse_number": "३-२४०-९", "content_sanskrit": "धर्मराजो न संक्रुद्ध्येद्भीमसेनस्त्वमर्षणः।\nयज्ञसेनस् दुहिता तेज एवतु केवलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2027979, "chapter_id": 1602, "verse_number": "३-२४०-१०", "content_sanskrit": "यूयंचाप्यपराध्येयुर्दर्पमोहसमन्विताः।\nततो विनिर्दहेयुस्ते तपसा हि समन्विताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2027980, "chapter_id": 1602, "verse_number": "३-२४०-११", "content_sanskrit": "अथवा सायुधावीरा मन्युनाऽभिपरिप्लुताः।\nसहिता बद्धनिस्त्रिशा दहेयुः शस्त्रतेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2027981, "chapter_id": 1602, "verse_number": "३-२४०-१२", "content_sanskrit": "अथ यूयं बहुत्वात्तान्नारभध्वं कथंचन।\nअनार्यं परमं तत्स्यादशक्यं तच्च वै मतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2027982, "chapter_id": 1602, "verse_number": "३-२४०-१३", "content_sanskrit": "उषितो हि महाबाहुरिन्द्रलोके धनंजयः।\nदिव्यान्यस्त्राण्यवाप्याथ ततः प्रत्यागतो वनं ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2027983, "chapter_id": 1602, "verse_number": "३-२४०-१४", "content_sanskrit": "अकृतास्त्रेण पृथिवी जिता बीभत्सुना पुरा।\nकिं पुनः सकृतास्त्रोऽद्य न हन्याद्वो महारथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2027984, "chapter_id": 1602, "verse_number": "३-२४०-१५", "content_sanskrit": "अथवा मद्वचः श्रुत्वा तत्र यत्ता भविष्यथ।\nउद्विग्रवासा विस्रब्धा दुःखं तत्रगमिष्यथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2027985, "chapter_id": 1602, "verse_number": "३-२४०-१६", "content_sanskrit": "अथवा सैनिकाः केचिदपकुर्युर्युधिष्ठिरे।\nतदबुद्धिकृतंकर्म दोषमुत्पादयेच्च वः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2027986, "chapter_id": 1602, "verse_number": "३-२४०-१७", "content_sanskrit": "तस्मादन्ये नरा यान्तु स्मारणायाप्तकारिणः।\nन स्वयं तत्रगमनं रोचये तव भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2027987, "chapter_id": 1602, "verse_number": "३-२४०-१८x", "content_sanskrit": "शकुनिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2027988, "chapter_id": 1602, "verse_number": "३-२४०-१८", "content_sanskrit": "धर्मज्ञः पाण्डवो ज्येष्ठः प्रतिज्ञातं च संसदि।\nतेन द्वादशवर्षाणि वस्तव्यानीति भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2027989, "chapter_id": 1602, "verse_number": "३-२४०-१९", "content_sanskrit": "अनुवृत्ताश्च रतं सर्वे पाण्डवा धर्मचारिणः।\nयुधिष्ठिरस्तु कौन्तेयो न नः कोपं करिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2027990, "chapter_id": 1602, "verse_number": "३-२४०-२०", "content_sanskrit": "मृगयां चैव नो गन्तुमिच्छा संवर्धते भृशम्।\nस्मारणं तु चिकीर्षामो न तु पाण्डवदर्सनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2027991, "chapter_id": 1602, "verse_number": "३-२४०-२१", "content_sanskrit": "न चानार्यसमाचारः कश्चित्तत्र भविष्यति।\nन च तत्र गमिष्यामो यत्र तेषां प्रतिश्रयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2027992, "chapter_id": 1602, "verse_number": "३-२४०-२२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2027993, "chapter_id": 1602, "verse_number": "३-२४०-२२", "content_sanskrit": "एवमुक्तः शकुनिना धृतराष्ट्रो जनेश्वरः।\nदुर्योधनं सहामात्यमनुजज्ञे न कामतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2027994, "chapter_id": 1602, "verse_number": "३-२४०-२३", "content_sanskrit": "अनुज्ञातस्तु गान्धारिः कर्णेन सहितस्तदा।\nनिर्ययौ भरतश्रेष्ठो बलेन महता वृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2027995, "chapter_id": 1602, "verse_number": "३-२४०-२४", "content_sanskrit": "दुःशासनेन च तथा सौबलेन च धीमता।\nसंवृतो भ्रातृभिश्चान्यैः स्त्रीभिश्चापि सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2027996, "chapter_id": 1602, "verse_number": "३-२४०-२५", "content_sanskrit": "तं निर्यान्तं महाबाहुं द्रष्टुं द्वैतवनं सरः।\nपौराश्चानुययुः सर्वेसहदारा वनं च तत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2027997, "chapter_id": 1602, "verse_number": "३-२४०-२६", "content_sanskrit": "अष्टौ रथसहस्राणि त्रीणि नागायुतानि च।\nपत्तयो बहुसाहस्रा हयाश्च नवतिः शताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2027998, "chapter_id": 1602, "verse_number": "३-२४०-२७", "content_sanskrit": "शकटापणवेशाश्च वणिजो वन्दिनस्तथा।\nनराश्च मृगयाशीलाः शतशोऽथ सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2027999, "chapter_id": 1602, "verse_number": "३-२४०-२८", "content_sanskrit": "ततः प्रयाणे नृपतेः सुमहानभवत्स्वनः।\nप्रावृषीव महावायोरुत्थितस्य विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2028000, "chapter_id": 1602, "verse_number": "३-२४०-२९", "content_sanskrit": "गव्यूतिमात्रेन्यवसद्राजा दुर्योधनस्तदा।\nप्रयातो वाहनैः सर्वैस्ततो द्वैतवनं सरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2028001, "chapter_id": 1602, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि घोषयात्रापर्वणि चत्वारिंशदधिकद्विशततमोऽध्यायः ॥ २४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]