[{"id": 40001042, "chapter_id": 8816, "verse_number": "1", "content_sanskrit": "कृतोद्वाहे गते तस्मिन् ब्रह्मदत्ते च राघव। अपुत्र: पुत्रलाभाय पौत्रीमिष्टिमकल्पयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40001043, "chapter_id": 8816, "verse_number": "2", "content_sanskrit": "इष्ट्यां तु वर्तमानायां कुशनाभं महीपतिम्। उवाच परमोदार: कुशो ब्रह्मसुतस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40001044, "chapter_id": 8816, "verse_number": "3", "content_sanskrit": "पुत्रस्ते सदृश: पुत्र भविष्यति सुधार्मिक:। गाधिं प्राप्स्यसि तेन त्वं कीर्तिं लोके च शाश्वतीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40001045, "chapter_id": 8816, "verse_number": "4", "content_sanskrit": "एवमुक्त्वा कुशो राम कुशनाभं महीपतिम्। जगामाकाशमाविश्य ब्रह्मलोकं सनातनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40001046, "chapter_id": 8816, "verse_number": "5", "content_sanskrit": "कस्य चित्त्वथ कालस्य कुशनाभस्य धीमत:। जज्ञे परमधर्मिष्ठो गाधिरित्येव नामत: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40001047, "chapter_id": 8816, "verse_number": "6", "content_sanskrit": "स पिता मम काकुत्स्थ गाधि: परमधार्मिक:। कुशवंशप्रसूतोऽस्मि कौशिको रघुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40001048, "chapter_id": 8816, "verse_number": "7", "content_sanskrit": "पूर्वजा भगिनी चापि मम राघव सुव्रता। नाम्ना सत्यवती नाम ऋचीके प्रतिपादिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40001049, "chapter_id": 8816, "verse_number": "8", "content_sanskrit": "सशरीरा गता स्वर्गं भर्तारमनुवर्तिनी। कौशिकी परमोदारा प्रवृत्ता च महानदी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40001050, "chapter_id": 8816, "verse_number": "9", "content_sanskrit": "दिव्या पुण्योदका रम्या हिमवन्तमुपाश्रिता। लोकस्य हितकामार्थं प्रवृत्ता भगिनी मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40001051, "chapter_id": 8816, "verse_number": "10", "content_sanskrit": "ततोऽहं हिमवत्पार्श्वे वसामि निरतस्सुखम्। भगिन्यां स्नेहसंयुक्त: कौशिक्यां रघुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40001052, "chapter_id": 8816, "verse_number": "11", "content_sanskrit": "सा तु सत्यवती पुण्या सत्ये धर्मे प्रतिष्ठिता। पतिव्रता महाभागा कौशिकी सरितां वरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40001053, "chapter_id": 8816, "verse_number": "12", "content_sanskrit": "अहं हि नियमाद्राम हित्वा तां समुपागत:। सिद्धाश्रममनुप्राप्य सिद्धोऽस्मि तव तेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40001054, "chapter_id": 8816, "verse_number": "13", "content_sanskrit": "एषा राम ममोत्पत्तिस्स्वस्य वंशस्य कीर्तिता। देशस्य च महाबाहो यन्मां त्वं परिपृच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40001055, "chapter_id": 8816, "verse_number": "14", "content_sanskrit": "गतोऽर्धरात्र: काकुत्स्थ कथा: कथयतो मम। निद्रामभ्येहि भद्रं ते मा भूद्विघ्नोऽध्वनीह न: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40001056, "chapter_id": 8816, "verse_number": "15", "content_sanskrit": "निष्पन्दास्तरवस्सर्वे निलीनमृगपक्षिण:। नैशेन तमसा व्याप्ता दिशश्च रघुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40001057, "chapter_id": 8816, "verse_number": "16", "content_sanskrit": "शनैर्वियुज्यते सन्ध्या नभो नेत्रैरिवावृतम् । नक्षत्रतारागहनं ज्योतिर्भिरिव भासते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40001058, "chapter_id": 8816, "verse_number": "17", "content_sanskrit": "उत्तिष्ठति च शीतांशुश्शशी लोकतमोनुद:। ह्लादयन् प्राणिनां लोके मनांसि प्रभया विभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40001059, "chapter_id": 8816, "verse_number": "18", "content_sanskrit": "नैशानि सर्वभूतानि प्रचरन्ति ततस्तत:। यक्षराक्षससङ्घाश्च रौद्राश्च पिशिताशना: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40001060, "chapter_id": 8816, "verse_number": "19", "content_sanskrit": "एवमुक्त्वा महातेजा विरराम महामुनि:। साधु साध्विति तं सर्वे ऋषयो ह्यभ्यपूजयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40001061, "chapter_id": 8816, "verse_number": "20", "content_sanskrit": "कुशिकानामयं वंशो महान् धर्मपरस्सदा। ब्रह्मोपमा महात्मान: कुशवंश्या नरोत्तमा: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40001062, "chapter_id": 8816, "verse_number": "21", "content_sanskrit": "विशेषेण भवानेव विश्वामित्रो महायशा:। कौशिकी सरितां श्रेष्ठा कुलोद्योतकरी तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40001063, "chapter_id": 8816, "verse_number": "22", "content_sanskrit": "इति तैर्मुनिशार्दूलै: प्रशस्त: कुशिकात्मज: । निद्रामुपागमच्छ्रीमान् अस्तंगत इवांशुमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40001064, "chapter_id": 8816, "verse_number": "23", "content_sanskrit": "रामोऽपि सहसौमित्रि: किञ्चिदागतविस्मय:। प्रशस्य मुनिशार्दूलं निद्रां समुपसेवते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]