[{"id": 2009008, "chapter_id": 1176, "verse_number": "१-१७७-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2009009, "chapter_id": 1176, "verse_number": "१-१७७-१", "content_sanskrit": "उपपन्नमिदं मातस्त्वया यद्बुद्धिपूर्वकम्।\nआर्तस्य ब्राह्मणस्यैतदनुक्रोशादिदं कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2009010, "chapter_id": 1176, "verse_number": "१-१७७-२", "content_sanskrit": "ध्रुवमेष्यति भीमोऽयं निहत्य पुरुषादकम्।\nसर्वथा ब्राह्मणस्यार्थे यदनुक्रोशवत्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2009011, "chapter_id": 1176, "verse_number": "१-१७७-३", "content_sanskrit": "यथा त्विदं न विन्देयुर्नरा नगरवासिनः।\nतथाऽयं ब्राह्मणो वाच्यः परिग्राह्यश्च यत्नतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2009012, "chapter_id": 1176, "verse_number": "१-१७७-४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2009013, "chapter_id": 1176, "verse_number": "१-१७७-४", "content_sanskrit": "युधिष्ठिरेण संमन्त्र्य ब्राह्मणार्थमरिन्दम।\nकुन्ती प्रविश्य तान्सर्वान्मन्त्रयामास भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2009014, "chapter_id": 1176, "verse_number": "१-१७७-५", "content_sanskrit": "अथ रात्र्यां व्यतीतायां भीमसेनो महाबलः।\nब्राह्मणं समुपागम्य वचश्चेदमुवाच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2009015, "chapter_id": 1176, "verse_number": "१-१७७-६", "content_sanskrit": "आपदस्त्वां विमोक्ष्येऽहं सपुत्रं ब्राह्मण प्रियम्।\nमा भैषी राक्षसात्तस्मान्मां ददातु बलिं भवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2009016, "chapter_id": 1176, "verse_number": "१-१७७-७", "content_sanskrit": "इद मामशितं कर्तुं प्रयतस्व सकृद्गृहे।\nआथात्मानं प्रादास्यामि तस्मै घोराय रक्षसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2009017, "chapter_id": 1176, "verse_number": "१-१७७-८", "content_sanskrit": "त्वरध्वं किं विलम्बध्वे मा चिरं कुरुतानघाः।\nव्यवस्येयं मनः प्राणैर्युष्मान्रक्षितुमद्य वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2009018, "chapter_id": 1176, "verse_number": "१-१७७-९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2009019, "chapter_id": 1176, "verse_number": "१-१७७-९", "content_sanskrit": "एवमुक्तः स भीमेन ब्राह्मणो भरतर्षभ।\nसुहृदां तत्समाख्याय ददावन्नं सुसंस्कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2009020, "chapter_id": 1176, "verse_number": "१-१७७-१०", "content_sanskrit": "पिशितोदनमाजह्रुरथास्मै पुरवासिनः।\nसघृतं सोपदंशं च सूपैर्नानाविधैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2009021, "chapter_id": 1176, "verse_number": "१-१७७-११", "content_sanskrit": "तदाऽशित्वा भीमसेनो मांसानि विविधानि च।\nमोदकानि च मुख्यानि चित्रोदनचयान्बहून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2009022, "chapter_id": 1176, "verse_number": "१-१७७-१२", "content_sanskrit": "ततोऽपिबद्दधिघटान्सुबहून्द्रोणसंमितान्।\nतस्य भुक्तवतः पौरा यथावत्समुपार्जितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2009023, "chapter_id": 1176, "verse_number": "१-१७७-१३", "content_sanskrit": "उपजह्रुर्भृतं भागं समृद्धमनसस्तदा।\nततो रात्र्यां व्यतीतायां सव्यञ्जनदधिप्लुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2009024, "chapter_id": 1176, "verse_number": "१-१७७-१४", "content_sanskrit": "समारुह्यान्नसंपूर्णं शकटं स वृकोदरः।\nप्रययौ तूर्यनिर्घोषैः पौरैश्च परिवारितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2009025, "chapter_id": 1176, "verse_number": "१-१७७-१५", "content_sanskrit": "आत्मानमेषोऽन्नभूतो राक्षसाय प्रदास्यति।\nतरुणोऽप्रतिरूपश्च दृढ औदरिको युवा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2009026, "chapter_id": 1176, "verse_number": "१-१७७-१६", "content_sanskrit": "वाग्भिरेवंप्रकाराभिः स्तूयमानो वृकोदरः।\nचुचोद स बलीवर्दौ युक्तौ सर्वाङ्गकालकौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2009027, "chapter_id": 1176, "verse_number": "१-१७७-१७", "content_sanskrit": "वादित्राणां प्रवादेन ततस्तं पुरुषादकम्।\nअभ्यगच्छत्सुसंहृष्टः सर्वत्र मनुजैर्वृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2009028, "chapter_id": 1176, "verse_number": "१-१७७-१८", "content_sanskrit": "संप्राप्य स च तं देशमेकाकी समुपाययौ।\nपुरुषादभयाद्भीतस्तत्रैवासीज्जनव्रजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2009029, "chapter_id": 1176, "verse_number": "१-१७७-१९", "content_sanskrit": "स गत्वा दूरमध्वानं दक्षिणामभितो दिशम्।\nयतोपदिष्टमुद्देशे ददर्श विपुलं द्रुमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2009030, "chapter_id": 1176, "verse_number": "१-१७७-२०", "content_sanskrit": "केशमज्जास्थिमेदोभिर्बाहूरुचरणैरपि।\nआर्द्रैः शुष्कैश्च संकीर्णमभितोऽथ वनस्पतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2009031, "chapter_id": 1176, "verse_number": "१-१७७-२१", "content_sanskrit": "गृध्रकङ्कबलच्छन्नं गोमायुगणसेवितम्।\nउग्रगन्धमचक्षुष्यं श्मशानमिव दारुणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2009032, "chapter_id": 1176, "verse_number": "१-१७७-२२", "content_sanskrit": "तं प्रविश्य महावृक्षं चिन्तयामास वीर्यवान्।\nयावन्न पश्यते रक्षो बकाभिख्यं बलोत्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2009033, "chapter_id": 1176, "verse_number": "१-१७७-२३", "content_sanskrit": "आचितं विविधैर्भोज्यैरन्नैरुच्चावचैरिदम्।\nशकटं सूपसंपूर्णं यावद्द्रक्ष्यति राक्षसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2009034, "chapter_id": 1176, "verse_number": "१-१७७-२४", "content_sanskrit": "तावदेवेह भोक्ष्येऽहं दुर्लभं हि पुनर्भवेत्।\nविप्रकीर्येत सर्वं हि प्रयुद्धे मयि रक्षसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2009035, "chapter_id": 1176, "verse_number": "१-१७७-२५", "content_sanskrit": "अभोज्यं हि शवस्पर्शे निगृहीते बके भवेत्।\nस त्वेवं भीमकर्मा तु भीमसेनोऽभिलक्ष्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2009036, "chapter_id": 1176, "verse_number": "१-१७७-२६", "content_sanskrit": "उपविश्य विविक्तेऽन्नं भुङ्क्ते स्म परमं परः।\nतं ततः सर्वतोऽपश्यन्द्रुमानारुह्य नागराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2009037, "chapter_id": 1176, "verse_number": "१-१७७-२७", "content_sanskrit": "नारक्षो बलिमश्नीयादेवं बहु च मानवाः।\nभुङ्क्ते ब्राह्मणरूपेण बकोऽयमिति चाब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2009038, "chapter_id": 1176, "verse_number": "१-१७७-२८", "content_sanskrit": "स तं हसति तेजस्वी तदन्नमुपभुज्य च।\nआसाद्य तु वनं तस्य रक्षसः पाण्डवो बली।\nआजुहाव ततो नाम्ना तदन्नमुपपादयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2009039, "chapter_id": 1176, "verse_number": "१-१७७-२९", "content_sanskrit": "ततः स राक्षसः क्रुद्धो भीमस्य वचनात्तदा।\nआजगाम सुसंक्रुद्धो यत्र भीमो व्यवस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2009040, "chapter_id": 1176, "verse_number": "१-१७७-३०", "content_sanskrit": "महाकायो महावेगो दारयन्निव मेदिनीम्।\nलोहिताक्षः करालश्च लोहितश्मश्रुमूर्धजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2009041, "chapter_id": 1176, "verse_number": "१-१७७-३१", "content_sanskrit": "आकर्णाद्भिन्नवक्त्रश्च शङ्कुकर्णो विभीषणः।\nत्रिशिखां भ्रुकुटिं कृत्वा संदश्य दशनच्छदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2009042, "chapter_id": 1176, "verse_number": "१-१७७-३२", "content_sanskrit": "भुञ्जानमन्नं तं दृष्ट्वा भीमसेनं स राक्षसः।\nविवृत्य नयने क्रुद्ध इदं वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2009043, "chapter_id": 1176, "verse_number": "१-१७७-३३", "content_sanskrit": "कोऽयमन्नमिदं भुङ्क्ते मदर्थमुपकल्पितम्।\nपश्यतो मम दुर्बुद्धिर्यियासुर्यमसादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2009044, "chapter_id": 1176, "verse_number": "१-१७७-३४", "content_sanskrit": "भीमसेनस्ततः श्रुत्वा प्रहसन्निव भारत।\nराक्षसं तमनादृत्य भुङ्क्त एव पराङ्मुखः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2009045, "chapter_id": 1176, "verse_number": "१-१७७-३५", "content_sanskrit": "रवं स भैरवं कृत्वा समुद्यम्य करावुभौ।\nअभ्यद्रवद्भीमसेनं जिङांसुः पुरुषादकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2009046, "chapter_id": 1176, "verse_number": "१-१७७-३६", "content_sanskrit": "तथापि परिभूयैनं प्रेक्षमाणो वृकोदरः।\nराक्षसं भुङ्क्त एवान्नं पाण्डवः परवीरहा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2009047, "chapter_id": 1176, "verse_number": "१-१७७-३७", "content_sanskrit": "अमर्षेण तु संपूर्णः कुन्तीपुत्रं वृकोदरम्।\nजघान पृष्ठे पाणिभ्यामुभाभ्यां पृष्ठतः स्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2009048, "chapter_id": 1176, "verse_number": "१-१७७-३८", "content_sanskrit": "तथा बलवता भीमः पाणिभ्यां भृशमाहतः।\nनैवावलोकयामास राक्षसं भुङ्क्त एव सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2009049, "chapter_id": 1176, "verse_number": "१-१७७-३९", "content_sanskrit": "ततः स भूयः संक्रुद्धो वृक्षमादाय राक्षसः।\nताडयिष्यंस्तदा भीमं पुनरभ्यद्रवद्बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2009050, "chapter_id": 1176, "verse_number": "१-१७७-४०", "content_sanskrit": "क्षिप्तं क्रुद्धेन तं वृक्षं प्रतिजग्राह वीर्यवान्।\nसव्येन पाणिना भीमो दक्षिणेनाप्यभुङ्क्त ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2009051, "chapter_id": 1176, "verse_number": "१-१७७-४१", "content_sanskrit": "शकटान्नं ततो भुक्त्वा रक्षसः पाणिना सह।\nगृह्णन्नेव तदा वृक्षं निःशेषं पर्वतोपमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2009052, "chapter_id": 1176, "verse_number": "१-१७७-४२", "content_sanskrit": "भीमसेनो हसन्नेव भुक्त्वा त्यक्त्वा च राक्षसम्।\nपीत्वा दधिघटान्पूर्णान्घृतकुम्भाञ्शतं शतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2009053, "chapter_id": 1176, "verse_number": "१-१७७-४३", "content_sanskrit": "वार्युपस्पृश्य संहृष्टस्तस्थौ गिरिरिवापरः।\nभ्रामयन्तं महावृक्षमायान्तं भीमदर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2009054, "chapter_id": 1176, "verse_number": "१-१७७-४४", "content_sanskrit": "दृष्ट्वोत्थायाहवे वीरः सिंहनादं व्यनादयत्।\nभुजवेगं तथाऽऽस्फोटं क्ष्वेलितं च महास्वनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2009055, "chapter_id": 1176, "verse_number": "१-१७७-४५", "content_sanskrit": "कृत्वाऽऽह्वयत संक्रुद्धो भीमसेनोऽथ राक्षसम्।\nउवाचाशनिशब्देन ध्वनिना भीषयन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2009056, "chapter_id": 1176, "verse_number": "१-१७७-४६x", "content_sanskrit": "भीम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2009057, "chapter_id": 1176, "verse_number": "१-१७७-४६", "content_sanskrit": "बहुकालं सुपुष्टं ते शरीरं राक्षसाधम।\nद्विपच्चतुष्पन्मांसैश्च बहुभिश्चौदनैरपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2009058, "chapter_id": 1176, "verse_number": "१-१७७-४७", "content_sanskrit": "मद्बाहुबलमाश्रित्य न त्वं भूयस्त्वशिष्यसि।\nअद्य मद्बाहुनिष्पिष्टो गमिष्यसि यमालयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2009059, "chapter_id": 1176, "verse_number": "१-१७७-४८", "content_sanskrit": "अद्यप्रभृति स्वप्स्यन्ति वेत्रकीयनिवासिनः।\nनिरुद्विग्नाः पुरस्यास्य कण्टके सूद्धृते मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2009060, "chapter_id": 1176, "verse_number": "१-१७७-४९", "content_sanskrit": "अद्य युद्धे शरीरं ते कङ्कगोमायुवायसाः।\nमया हतस्य खादन्तु विकर्षन्तु च भूतले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2009061, "chapter_id": 1176, "verse_number": "१-१७७-५०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2009062, "chapter_id": 1176, "verse_number": "१-१७७-५०", "content_sanskrit": "एवमुक्त्वा सुसंक्रुद्धः पार्थो बकजिघांसया।\nउपाधावद्बकश्चापि पार्थं पार्थिवसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2009063, "chapter_id": 1176, "verse_number": "१-१७७-५१", "content_sanskrit": "महाकायो महावेगो दारयन्निव मेदिनीम्।\nपिशङ्गरूपः पिङ्गाक्षो भीमसेनमभिद्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2009064, "chapter_id": 1176, "verse_number": "१-१७७-५२", "content_sanskrit": "त्रिशिखां भ्रुकुटीं कृत्वा संदश्य दशनच्छदम्।\nभृशं स भूयः संक्रुद्धो वृक्षमादाय राक्षसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2009065, "chapter_id": 1176, "verse_number": "१-१७७-५३", "content_sanskrit": "ताडयिष्यंस्तदा भीमं तरसाऽभ्यद्रवद्बली।\nक्रुद्धेनाभिहतं वृक्षं प्रतिजग्राह लीलया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2009066, "chapter_id": 1176, "verse_number": "१-१७७-५४", "content_sanskrit": "सव्येन पाणिना भीमः प्रहसन्निव भारत।\nततः स पुनरुद्यम्य वृक्षान्बहुविधान्बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2009067, "chapter_id": 1176, "verse_number": "१-१७७-५५", "content_sanskrit": "प्राहिणोद्भीमसेनाय बकोऽपि बलवान्रणे।\nसर्वानपोहयद्वृक्षान्स्वस्य हस्तस्य शाखया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2009068, "chapter_id": 1176, "verse_number": "१-१७७-५६", "content_sanskrit": "तद्वृक्षयुद्धमभवद्वृक्षषण्डविनाशनम्॥\nमहत्सुघोरं राजेन्द्र बकपाण्डवयोस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2009069, "chapter_id": 1176, "verse_number": "१-१७७-५७", "content_sanskrit": "नाम विश्राव्य स बकः समभिद्रुत्य पाण्डवम्।\nसमयुध्यत तीव्रेण वेगेन पुरुषादकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2009070, "chapter_id": 1176, "verse_number": "१-१७७-५८", "content_sanskrit": "तयोर्वेगेन महता पृथिवी समकम्पत।\nपादपांश्च महामात्रांश्चूर्णयामासतुः क्षणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2009071, "chapter_id": 1176, "verse_number": "१-१७७-५९", "content_sanskrit": "द्रुतमागत्य पाणिभ्यां गृहीत्वा चैनमाक्षिपत्।\nआक्षिप्तो भीमसेनश्च पुनरेवोत्थितो हसन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2009072, "chapter_id": 1176, "verse_number": "१-१७७-६०", "content_sanskrit": "आलिङ्ग्यापि बकं भीमो न्यहनद्वसुधातले।\nभीमो विसर्जयित्वैनं समाश्वसिहि राक्षस॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2009073, "chapter_id": 1176, "verse_number": "१-१७७-६१", "content_sanskrit": "इत्युक्त्वा पुनरास्फोट्य उत्तिष्ठेति च सोऽब्रवीत्।\nसमुत्पत्य ततः क्रुद्धो रूपं कृत्वा महत्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2009074, "chapter_id": 1176, "verse_number": "१-१७७-६२", "content_sanskrit": "विरूपः सहसा तस्थौ२ तर्जयित्वा वृकोदरम्।\nअहसद्भीमसेनोऽपि राक्षसं भीमदर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2009075, "chapter_id": 1176, "verse_number": "१-१७७-६३", "content_sanskrit": "असौ गृहीत्वा पाणिभ्यां पृष्ठतश्च व्यवस्थितः।\nजानुभ्यां पीडयित्वाथ पातयामास भूतले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2009076, "chapter_id": 1176, "verse_number": "१-१७७-६४", "content_sanskrit": "पुनः क्रुद्धो विसृज्यैनं राक्षसं क्रोधजीवितम्।\nस्वां कटीमीषदुन्नम्य बाहू तस्य परामृशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2009077, "chapter_id": 1176, "verse_number": "१-१७७-६५", "content_sanskrit": "तस्य बाहू समादाय त्वरमाणो वृकोदरः।\nउत्क्षिप्य चावधूयैनं पातयन्बलवान्भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2009078, "chapter_id": 1176, "verse_number": "१-१७७-६६", "content_sanskrit": "तं तु वामेन पादेन क्रुद्धो भीमपराक्रमः।\nउरस्येनं समाजघ्ने भीमस्तु पतितं भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2009079, "chapter_id": 1176, "verse_number": "१-१७७-६७", "content_sanskrit": "व्यात्ताननेन घोरेण लम्बजिह्वेन रक्षसा।\nतेनाभिद्रुत्य भीमेन भीमो मूर्ध्नि समाहतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2009080, "chapter_id": 1176, "verse_number": "१-१७७-६८", "content_sanskrit": "एवं निहन्यमानः स राक्षसेन बलीयसा।\nरोषेण महताऽऽविष्टो भीमो भीमपराक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2009081, "chapter_id": 1176, "verse_number": "१-१७७-६९", "content_sanskrit": "गृहीत्वा मध्यमुत्क्षिप्य बली जग्राह राक्षसम्।\nतावन्योन्यं पीडयन्तौ पुरुषादवृकोदरौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2009082, "chapter_id": 1176, "verse_number": "१-१७७-७०", "content_sanskrit": "मत्ताविव महानागावन्योन्यं विचकर्षतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2009083, "chapter_id": 1176, "verse_number": "१-१७७-७१", "content_sanskrit": "बाहुविक्षेपशब्दैश्च भीमराक्षसयोस्तदा।\nवेत्रकीयपुरी सर्वा वित्रस्ता समपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2009084, "chapter_id": 1176, "verse_number": "१-१७७-७२", "content_sanskrit": "तयोर्वेगेन महता तत्र भूमिरकम्पत।\nपादपान्वीरुधश्चैव चूर्णयामासतू रयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2009085, "chapter_id": 1176, "verse_number": "१-१७७-७३", "content_sanskrit": "समागतौ च तौ वीरावन्योन्यवधकाङ्क्षिणौ।\nगिरिभिर्गिरिशृह्गैश्च पाषाणैः पर्वतच्युतैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2009086, "chapter_id": 1176, "verse_number": "१-१७७-७४", "content_sanskrit": "अन्योन्यं ताडयन्तौ तौ चूर्णयामासतुस्तदा।\nआयामविस्तराभ्यां च परितो योजनद्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2009087, "chapter_id": 1176, "verse_number": "१-१७७-७५", "content_sanskrit": "निर्महीरुहपाषाणतृणकुञ्जलतावलिम्।\nचक्रतुर्युद्धदुर्मत्तौ कूर्मपृष्ठोपमां महीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2009088, "chapter_id": 1176, "verse_number": "१-१७७-७६", "content_sanskrit": "मुहूर्तमेवं संयुध्य समं रक्षःकुरूद्वहौ।\nततो रक्षोविनाशाय मतिं कृत्वा कुरूत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2009089, "chapter_id": 1176, "verse_number": "१-१७७-७७", "content_sanskrit": "दन्तान्कटकटीकृत्य दष्ट्वा च दशनच्छदम्।\nनेत्रे संवृत्य विकटं तिर्यक्प्रैक्षत राक्षसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2009090, "chapter_id": 1176, "verse_number": "१-१७७-७८", "content_sanskrit": "अथ तं लोलयित्वा तु भीमसेनो महाबलः।\nअगृह्णात्परिरभ्यैनं बाहुभ्यां परिरभ्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2009091, "chapter_id": 1176, "verse_number": "१-१७७-७९", "content_sanskrit": "जानुभ्यां पार्श्वयोः कुक्षौ पृष्ठे वक्षसि जघ्निवान्।\nभग्नोरुबाहुहृच्चैव विस्रंसद्देहबन्धनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2009092, "chapter_id": 1176, "verse_number": "१-१७७-८०", "content_sanskrit": "प्रस्वेददीर्घनिश्वासो निर्यञ्जीवाक्षितारकः।\nअजाण्डास्फोटनं कुर्वन्नाक्रोशंश्च श्वसञ्छनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2009093, "chapter_id": 1176, "verse_number": "१-१७७-८१", "content_sanskrit": "भूमौ निपत्य विलुठन्दण्डाहत इवोरगः।\nविस्फुरन्तं महाकायं परितो विचकर्ष ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2009094, "chapter_id": 1176, "verse_number": "१-१७७-८२", "content_sanskrit": "विकृष्यमाणो वेगेन पाण्डवेन बलीयसा।\nसमयुज्यत तीव्रेण श्रमेण पुरुषादकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2009095, "chapter_id": 1176, "verse_number": "१-१७७-८३", "content_sanskrit": "हीयमानबलं रक्षः समीक्ष्य पुरुषर्षभः।\nनिष्पिष्य भूमौ जानुभ्यां समाजघ्ने वृकोदरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2009096, "chapter_id": 1176, "verse_number": "१-१७७-८४", "content_sanskrit": "ततो।ञस्य जानुना पृष्ठमवपीड्य बलादिव।\nबाहुना परिजग्राह दक्षिणेन शिरोधराम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2009097, "chapter_id": 1176, "verse_number": "१-१७७-८५", "content_sanskrit": "सव्येन च कटीदेशे गृह्य वाससि पाण्डवः।\nजानुन्यारोप्य तत्पृष्ठं महाशब्दं बभञ्ज ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2009098, "chapter_id": 1176, "verse_number": "१-१७७-८६", "content_sanskrit": "ततोऽस्य रुधिरं वक्त्रात्प्रादुरासीद्विशांपते।\nभज्यमानस्य भीमेन तस्य घोरस्य रक्षसः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2009099, "chapter_id": 1176, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि बकवधपर्वणि सप्तसप्तत्यधिकशततमोऽध्यायः॥ १७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}]