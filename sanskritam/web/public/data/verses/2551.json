[{"id": 2073417, "chapter_id": 2551, "verse_number": "१२-५६-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2073418, "chapter_id": 2551, "verse_number": "१२-५६-१", "content_sanskrit": "नित्योद्युक्तेन वै राज्ञा भवितव्यं युधिष्ठिर।\nप्रशस्यते न राजा हि नारीवोद्यमवर्जितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2073419, "chapter_id": 2551, "verse_number": "१२-५६-२", "content_sanskrit": "भगवानुशना चाह श्लोकमत्र विशांपते।\nतदिहैकमना राजन्गदतस्तं निबोध मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2073420, "chapter_id": 2551, "verse_number": "१२-५६-३", "content_sanskrit": "द्वाविमौ ग्रसते भूमिः सर्पो बिलशयानिव।\nराजानं चाविरोद्धारं ब्राह्मणं चाप्रवासिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2073421, "chapter_id": 2551, "verse_number": "१२-५६-४", "content_sanskrit": "तदेतन्नरशार्दूल हृदि त्वं कर्तुमर्हसि।\nसन्धेयानभिसन्धत्स्व विरोध्यांश्च विरोधय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2073422, "chapter_id": 2551, "verse_number": "१२-५६-५", "content_sanskrit": "सप्ताङ्गस्य च राज्यस्य विपरीतं य आचरेत्।\nगुरुर्वा यदि वा मित्रं प्रतिहन्तव्य एव सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2073423, "chapter_id": 2551, "verse_number": "१२-५६-६", "content_sanskrit": "मरुत्तेन हि राज्ञा वै गीतः श्लोकः पुरातनः।\nराज्याधिकारे राजेन्द्र बृहस्पतिमतः पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2073424, "chapter_id": 2551, "verse_number": "१२-५६-७", "content_sanskrit": "गुरोरप्यवलिप्तस्य कार्याकार्यमजानतः।\nउत्पथं प्रतिपन्नस्य परित्यागो विधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2073425, "chapter_id": 2551, "verse_number": "१२-५६-८", "content_sanskrit": "बाहोः पुत्रेण राज्ञा च सगरेण च धीमता।\nअसमञ्जः सुतो ज्येष्ठस्त्यक्तः पौरहितैषिणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2073426, "chapter_id": 2551, "verse_number": "१२-५६-९", "content_sanskrit": "असमञ्जः सरय्वां स पौराणां बालकान्नृप।\nन्यमज्जयदतः पित्रा निर्भर्त्स्य स विवासितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2073427, "chapter_id": 2551, "verse_number": "१२-५६-१०", "content_sanskrit": "ऋषिणोद्दालकेनापि श्वेतकेतुर्महातपाः।\nमिथ्या विप्रानुपचरन्सन्त्यक्तो दयितः सुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2073428, "chapter_id": 2551, "verse_number": "१२-५६-११", "content_sanskrit": "लोकरञ्जनमेवात्र राज्ञां धर्मः सनातनः।\nसत्यस्य रक्षणं चैव व्यवहारस्य चार्जवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2073429, "chapter_id": 2551, "verse_number": "१२-५६-१२", "content_sanskrit": "न हिंस्यात्परवित्तानि देयं काले च दापयेत्।\nविक्रान्तः सत्यवाक्क्षान्तो नृपो न चलते पथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2073430, "chapter_id": 2551, "verse_number": "१२-५६-१३", "content_sanskrit": "गुप्तमन्त्रो जितक्रोधः शास्त्रार्थकृतनिश्चयः।\nधर्मे चार्थे च कामे च मोक्षे च सततं रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2073431, "chapter_id": 2551, "verse_number": "१२-५६-१४", "content_sanskrit": "त्रय्या संवृतमन्त्रश्च राजा भवितुर्महति।\nवृजिनं च नरेन्द्राणां नान्यच्चारक्षणात्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2073432, "chapter_id": 2551, "verse_number": "१२-५६-१५", "content_sanskrit": "चातुर्वर्ण्यस्य धर्माश्च रक्षितव्या महीक्षिता।\nधर्मसंकररक्षा च राज्ञां धर्मः सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2073433, "chapter_id": 2551, "verse_number": "१२-५६-१६", "content_sanskrit": "न विश्वसेच्च नृपतिर्न चात्यर्थं च विश्वसेत्।\nषाङ्गुण्यगुणदोषांश्च नित्यं बुद्ध्याऽवलोकयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2073434, "chapter_id": 2551, "verse_number": "१२-५६-१७", "content_sanskrit": "अच्छिद्रदर्शी नृपतिर्नित्यमेव प्रशस्यते।\nत्रिवर्गे विदितार्थश्च युक्ताचारपथश्च यः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2073435, "chapter_id": 2551, "verse_number": "१२-५६-१८", "content_sanskrit": "कोशस्योपार्जनरतिर्यमवैश्रवणोपमः।\nवेत्ता च दशवर्गस्य स्थानवृद्धिक्षयात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2073436, "chapter_id": 2551, "verse_number": "१२-५६-१९", "content_sanskrit": "अभृतानां भवेद्भर्ता भृतानामन्ववेक्षकः।\nनृपतिः सुभुखश्च स्यात्स्मितपूर्वाभिभाषिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2073437, "chapter_id": 2551, "verse_number": "१२-५६-२०", "content_sanskrit": "उपासिता ---- जिततन्द्रिरलोलुपः।\nसतां वृत्ते स्थितमतिः सतां ह्याचारदर्शनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2073438, "chapter_id": 2551, "verse_number": "१२-५६-२१", "content_sanskrit": "न चाददीत वित्तानि सतां हस्तात्कदाचन।\nअसभ्द्यश्च समादाय सभ्द्यस्तु प्रतिपादयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2073439, "chapter_id": 2551, "verse_number": "१२-५६-२२", "content_sanskrit": "स्वयं प्रहर्ता दाता च वश्यात्मा वश्यसाधनः।\nकाले दाता च भोक्ता च शुद्धाचारस्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2073440, "chapter_id": 2551, "verse_number": "१२-५६-२३", "content_sanskrit": "शूरान्भक्तानसंहार्यान्कुले जातानरोगिणः।\nशिष्टाञ्शिष्टाभिसंबन्धान्मानिनोऽनवमानिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2073441, "chapter_id": 2551, "verse_number": "१२-५६-२४", "content_sanskrit": "विद्याविदो लोकविदः परलोकान्ववेक्षकान्।\nधर्मे च निरतान्साधूनचलानचलानिव।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2073442, "chapter_id": 2551, "verse_number": "१२-५६-२५", "content_sanskrit": "सहायान्सततं कुर्याद्राजा भूतिपरिष्कृतान्।\nतैश्च तुल्यो भवेद्भोगैश्छत्रमात्राज्ञयाऽधिकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2073443, "chapter_id": 2551, "verse_number": "१२-५६-२६", "content_sanskrit": "प्रत्यक्षा च परोक्षा च वृत्तिश्चास्य भवेत्समा।\nएवं कुर्वन्नरेन्द्रो हि न खेदमिह विन्दति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2073444, "chapter_id": 2551, "verse_number": "१२-५६-२७", "content_sanskrit": "सर्वाभिशङ्की नृपतिर्यश्च सर्वहरो भवेत्।\nस क्षिप्रमनृर्जुर्लुब्धः स्वजनेनैव बाध्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2073445, "chapter_id": 2551, "verse_number": "१२-५६-२८", "content_sanskrit": "शुचिस्तु पृथिवीपालो लोकस्यानुग्रहे रतः।\nन पतत्यरिभिर्ग्रस्तः पतितश्चाधितिष्ठति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2073446, "chapter_id": 2551, "verse_number": "१२-५६-२९", "content_sanskrit": "अक्रोधनो ह्यव्यसनी मृदुदण्डो जितेन्द्रियः।\nराजा भवति भूतानां विश्वास्यो हिमवानिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2073447, "chapter_id": 2551, "verse_number": "१२-५६-३०", "content_sanskrit": "प्राज्ञो न्यायगुणोपेतः पररन्ध्रेषु लालसः।\nसुदर्शः सर्ववर्णानां नयापनयवित्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2073448, "chapter_id": 2551, "verse_number": "१२-५६-३१", "content_sanskrit": "क्षिप्रकारी जितक्रोधः सुप्रसादो महामनाः।\nअरोगप्रकृतिर्युक्तः क्रियावानविकत्थनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2073449, "chapter_id": 2551, "verse_number": "१२-५६-३२", "content_sanskrit": "आरब्धान्येव कार्याणि न पर्यवसितान्यपि।\nयस्य राज्ञः प्रदृश्यन्ते स राजा राजसत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2073450, "chapter_id": 2551, "verse_number": "१२-५६-३३", "content_sanskrit": "पुत्रा इव पितुर्गेहे विषये यस्य मानवाः।\nनिर्भया विचरिष्यन्ति स राजा राजसत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2073451, "chapter_id": 2551, "verse_number": "१२-५६-३४", "content_sanskrit": "अगूढविभवा यस्य पौरा राष्ट्रनिवासिनः।\nनयापनयवेत्तारः स राजा राजसत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2073452, "chapter_id": 2551, "verse_number": "१२-५६-३५", "content_sanskrit": "स्वधर्मनिरता यस्य जना विषयवासिनः।\nअसङ्घातरता दान्ताः पाल्यमाना यथाविधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2073453, "chapter_id": 2551, "verse_number": "१२-५६-३६", "content_sanskrit": "वश्या यत्ता विनीताश्च न च सङ्घर्षशीलिनः।\nविषये दानरुचयो नरा यस्य स पार्थिवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2073454, "chapter_id": 2551, "verse_number": "१२-५६-३७", "content_sanskrit": "न यस्य कूटं कपटं न माया न च मत्सरः।\nविषये भूमिपालस्य तस्य धर्मः सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2073455, "chapter_id": 2551, "verse_number": "१२-५६-३८", "content_sanskrit": "यः सत्करोति ज्ञानानि श्रेयान्परहिते रतः।\nसतां वर्त्मानुगस्त्यागी स राजा स्वर्गमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2073456, "chapter_id": 2551, "verse_number": "१२-५६-३९", "content_sanskrit": "यस्य चाराश्च मन्त्राश्च नित्यं चैव कृताकृताः।\nन ज्ञायन्ते हि रिपुभिः स राजा राज्यमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2073457, "chapter_id": 2551, "verse_number": "१२-५६-४०", "content_sanskrit": "श्लोकद्वयं पुरा गीतं भार्गवेण महात्मना।\nआख्याते राजचरिते नृपतिं प्रति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2073458, "chapter_id": 2551, "verse_number": "१२-५६-४१", "content_sanskrit": "राजानं प्रथमं विन्देत्ततो भार्यां ततो धनम्।\nराजन्यसति लोकेऽस्मिन्कुतो भार्या कुतो धनं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2073459, "chapter_id": 2551, "verse_number": "१२-५६-४२", "content_sanskrit": "तद्राज्ये राज्यकामानां नान्यो धर्मः सनातनः।\nऋते रक्षां तु विस्पष्टां रक्षा लोकस्य धारिणी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2073460, "chapter_id": 2551, "verse_number": "१२-५६-४३", "content_sanskrit": "प्राचेतसेन मनुना श्लोकौ चेमावुदाहृतौ।\nराजधर्मेषु राजेन्द्र ताविहैकमनाः शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2073461, "chapter_id": 2551, "verse_number": "१२-५६-४४", "content_sanskrit": "षडेतान्पुरुषो जह्याद्भिन्नां नावमिवार्णवे।\nअप्रवक्तारमाचार्यमनधीयानमृत्विजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2073462, "chapter_id": 2551, "verse_number": "१२-५६-४५", "content_sanskrit": "अरक्षितारं राजानं भार्यां चाप्रियवादिनीम्।\nग्रामकामं च गोपालं वनकामं च नापितम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2073463, "chapter_id": 2551, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि षट्पञ्चाशोऽध्यायः॥ ५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]