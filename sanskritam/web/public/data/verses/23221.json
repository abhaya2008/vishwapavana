[{"id": 7003221000, "chapter_id": 23221, "verse_number": "१-२४-१", "content_sanskrit": "सूत उवाच  ।\nश्रुत्वैवमखिलं ब्रह्मा रुद्रेण परिभाषितम्  ।\nपुनः प्रणम्य देवेशं रुद्रमाह प्रजापतिः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003221001, "chapter_id": 23221, "verse_number": "१-२४-२", "content_sanskrit": "भगवन्देवदेवेश विश्वरूपं महेश्वर  ।\nउमाधव महादेव नमो लोकाभिवंदित ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003221002, "chapter_id": 23221, "verse_number": "१-२४-३", "content_sanskrit": "विश्वरूप महाभाग कस्मिन्काले महेश्वर  ।\nया इमास्ते महादेव तनवो लोकवंदिताः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003221003, "chapter_id": 23221, "verse_number": "१-२४-४", "content_sanskrit": "कस्यां वा युगसंभूत्यां द्रक्ष्यंतीह द्विजातयः  ।\nकेन वा तपसा देव ध्यानयोगेन केन वा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003221004, "chapter_id": 23221, "verse_number": "१-२४-५", "content_sanskrit": "नमस्ते वै महादेव शक्यो द्रष्टुं द्विजातिभिः  ।\nतस्य तद्वचनं श्रुत्वा शर्वः संप्रेक्ष्य तं पुरः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003221005, "chapter_id": 23221, "verse_number": "१-२४-६", "content_sanskrit": "स्मयन्प्राह महादेवो ऋग्यजुःसामसंभवः  ।\nश्रीभगवानुवाच  ।\nतपसा नैव वृत्तेन दानधर्मफलेन च ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003221006, "chapter_id": 23221, "verse_number": "१-२४-७", "content_sanskrit": "न तीर्थफलयोगेन क्रतुभिर्वाप्तदक्षिणैः ।\nन वेदाध्ययनैर्वापि न वित्तेन न वेदनैः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003221007, "chapter_id": 23221, "verse_number": "१-२४-८", "content_sanskrit": "न शक्यं मानवैर्द्रष्टुमृते ध्यानादहं त्विह  ।\nसप्तमे चैव वाराहे ततस्तस्मिन्पितामह ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003221008, "chapter_id": 23221, "verse_number": "१-२४-९", "content_sanskrit": "कल्पेश्वरोऽथ भगवान् सर्वलोकप्रकाशनः  ।\nमनुर्वैवस्वतश्चैव तव पौत्रो भविष्यति ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003221009, "chapter_id": 23221, "verse_number": "१-२४-१०", "content_sanskrit": "तदा चतुर्युगावस्थे तस्मिन्कल्पे युगांतिके  ।\nअनुग्रहार्थं लोकानां ब्राह्मणानां हिताय च ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003221010, "chapter_id": 23221, "verse_number": "१-२४-११", "content_sanskrit": "उत्पत्स्यामि तदा ब्रह्मन्पुनरस्मिन्युगांतिके  ।\nयुगप्रवृत्त्या च तदा तस्मिंश्च प्रथमे युगे ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003221011, "chapter_id": 23221, "verse_number": "१-२४-१२", "content_sanskrit": "द्वापरे प्रथमे ब्रह्मन्यदा व्यासः स्वयं प्रभुः  ।\nतदाहं ब्राह्मणार्थाय कलौ तस्मिन् युगांतिके ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003221012, "chapter_id": 23221, "verse_number": "१-२४-१३", "content_sanskrit": "भविष्यामि शिखायुक्तः श्वेतो नाम महामुनिः  ।\nहिमवच्छिखरे रम्ये छागले पर्वतोत्तमे ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003221013, "chapter_id": 23221, "verse_number": "१-२४-१४", "content_sanskrit": "तत्र शिष्याः शिखायुक्ता भविष्यंति तदा मम  ।\nश्वेतः श्वेतशिखश्चैव श्वेतास्यः श्वेतलोहितः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003221014, "chapter_id": 23221, "verse_number": "१-२४-१५", "content_sanskrit": "चत्वारस्तु महात्मानो ब्राह्मणा वेदपारगाः  ।\nततस्ते ब्रह्मभूयिष्ठा दृष्ट्वा ब्रह्मगतिं पराम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003221015, "chapter_id": 23221, "verse_number": "१-२४-१६", "content_sanskrit": "मत्समीपं गमिष्यंति ध्यानयोगपरायणाः  ।\nततः पुनर्यदा ब्रह्मन् द्वितीये द्वापरे प्रभुः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003221016, "chapter_id": 23221, "verse_number": "१-२४-१७", "content_sanskrit": "प्रजापतिर्यदा व्यसः सद्यो नाम भविष्यति  ।\nतदा लोकहितार्थाय सुतारो नाम नामतः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003221017, "chapter_id": 23221, "verse_number": "१-२४-१८", "content_sanskrit": "भविष्यामि कलौ तस्मिन् शिष्यानुग्रहकाम्यया  ।\nतत्रापि मम ते शिष्या नामतः परिकीर्तिताः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003221018, "chapter_id": 23221, "verse_number": "१-२४-१९", "content_sanskrit": "दुंदुभिः शतरूपश्च ऋचीकः केतुमांस्तदा  ।\nप्राप्य योगं तथा ध्यानं स्थाप्य ब्रह्म च भूतले ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003221019, "chapter_id": 23221, "verse_number": "१-२४-२०", "content_sanskrit": "रुद्रलोकं गमिष्यंति सहचारित्वमेव च  ।\nतृतीये द्वापरे चैव यदा व्यासस्तु भार्गवः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003221020, "chapter_id": 23221, "verse_number": "१-२४-२१", "content_sanskrit": "तदाप्यहं भविष्यामि दमनस्तु युगांतिके  ।\nतत्रापि च भविष्यंति चत्वारो मम पुत्रकाः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003221021, "chapter_id": 23221, "verse_number": "१-२४-२२", "content_sanskrit": "विकोशश्च विकेशश्च विपाशः शापनाशनः  ।\nतेपि तेनैव मार्गेण योगोक्तेन महौजसः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003221022, "chapter_id": 23221, "verse_number": "१-२४-२३", "content_sanskrit": "रुद्रलोकं गमिष्यंति पुनरावृत्तिदुर्लभम्  ।\nचतुर्थे द्वापरे चैव यदा व्यासोऽङ्गिराः स्मृतः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003221023, "chapter_id": 23221, "verse_number": "१-२४-२४", "content_sanskrit": "तदाप्यहं भविष्यामि सुहोत्रो नाम नामतः  ।\nतत्रापि मम ते पुत्राश्चत्वारोपि तपोधनाः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003221024, "chapter_id": 23221, "verse_number": "१-२४-२५", "content_sanskrit": "द्विजश्रेष्ठा भविष्यंति योगात्मानो दृढव्रताः।\nसुमुखो दुर्मुखश्चैव दुर्दरो दुरतिक्रमः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003221025, "chapter_id": 23221, "verse_number": "१-२४-२६", "content_sanskrit": "प्राप्य योगगतिं सूक्ष्मां विमला दग्ध किल्बिषाः  ।\nतेपि तेनैव मार्गेण योगयुक्ता महौजसः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003221026, "chapter_id": 23221, "verse_number": "१-२४-२७", "content_sanskrit": "रुद्रलोकं गमिष्यंति पुनरावृत्तिदुर्लभम्  ।\nपंचमे द्वापरे चैव व्यासस्तु सविता यदा ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003221027, "chapter_id": 23221, "verse_number": "१-२४-२८", "content_sanskrit": "तदा चापि भविष्यामि कंको नाम महातपाः  ।\nअनुग्रहार्थं लोकानां योगात्मैककलागतिः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003221028, "chapter_id": 23221, "verse_number": "१-२४-२९", "content_sanskrit": "चत्वारस्तु महाभागा विमलाः शुद्धयोनयः  ।\nशिष्या मम भविष्यंति योगात्मानो दृढव्रताः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003221029, "chapter_id": 23221, "verse_number": "१-२४-३०", "content_sanskrit": "सनकः सनंदनश्चैव प्रभुर्यश्च सनातनः  ।\nविभुः सनत्कुमारश्च निर्ममा निरहंकृताः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003221030, "chapter_id": 23221, "verse_number": "१-२४-३१", "content_sanskrit": "मत्समीपमुपेष्यंति पुनरावृत्तिदुर्लभम्  ।\nपरिवर्ते पुनः षष्ठे मृत्युर्व्यासो यदा विभुः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003221031, "chapter_id": 23221, "verse_number": "१-२४-३२", "content_sanskrit": "तदाप्यहं भविष्यामि लोगाक्षीर्नाम नामतः  ।\nतत्रापि मम ते शिष्या योगात्मानो दृढव्रताः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003221032, "chapter_id": 23221, "verse_number": "१-२४-३३", "content_sanskrit": "भविष्यंति महाभागाश्चत्वारो लोकसंमताः  ।\nसुधामा विरजाश्चैव शंखपाद्रज एव च ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003221033, "chapter_id": 23221, "verse_number": "१-२४-३४", "content_sanskrit": "योगात्मानो महात्मानः सर्वे वै दग्धकिल्बिषाः  ।\nतेपि तेनैव मार्गेण ध्यानयोगसमन्विताः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003221034, "chapter_id": 23221, "verse_number": "१-२४-३५", "content_sanskrit": "मत्समीपं गमिष्यंति पुनरावृत्तिदुर्लभम्  ।\nसप्तमे परिवर्ते तु यदा व्यासः शतक्रतुः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003221035, "chapter_id": 23221, "verse_number": "१-२४-३६", "content_sanskrit": "विभुनामा महातेजाः प्रथितः पूर्वजन्मनि  ।\nतदाप्यहं भविष्यामि कलौ तस्मिन् युगांतिके ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003221036, "chapter_id": 23221, "verse_number": "१-२४-३७", "content_sanskrit": "जैगीषव्यो विभुः ख्यातः सर्वेषां योगिनां वरः  ।\nतत्रापि मम ते पुत्रा भविष्यंति युगे तथा ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003221037, "chapter_id": 23221, "verse_number": "१-२४-३८", "content_sanskrit": "सारस्वतश्च मेघश्च मेघवाहः सुवाहनः  ।\nतेपि तेनैव मार्गेण ध्यानयोगपरायणाः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003221038, "chapter_id": 23221, "verse_number": "१-२४-३९", "content_sanskrit": "गमिष्यंति महात्मानो रुद्रलोकं निरामयम्  ।\nवसिष्ठश्चाष्टमे व्यासः परिवर्ते भविष्यति ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003221039, "chapter_id": 23221, "verse_number": "१-२४-४०", "content_sanskrit": "यदा तदा भविष्यामि नाम्नाहं दधिवाहनः  ।\nतत्रापि मम ते पुत्रा योगात्मानो दृढव्रताः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003221040, "chapter_id": 23221, "verse_number": "१-२४-४१", "content_sanskrit": "भविष्यंति महायोगा येषां नास्ति समो भुवि  ।\nकपिलश्चासुरिश्चैव तथा पंचशिखो मुनिः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003221041, "chapter_id": 23221, "verse_number": "१-२४-४२", "content_sanskrit": "बाष्कलश्च महायोगी धर्मात्मानो महौजसः  ।\nप्राप्य माहेश्वरं योगं ज्ञानिनो दग्धकिल्बिषाः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003221042, "chapter_id": 23221, "verse_number": "१-२४-४३", "content_sanskrit": "मत्समीपं गमिष्यंति पुनरावृत्ति दुर्लभम्  ।\nपरिवर्ते तु नवमे व्यासः सारस्वतो यदा ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003221043, "chapter_id": 23221, "verse_number": "१-२४-४४", "content_sanskrit": "तदाप्यहं भविष्यामि ऋषभो नाम नामतः  ।\nतत्रापि मम ते पुत्रा भविष्यंति महौजसः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003221044, "chapter_id": 23221, "verse_number": "१-२४-४५", "content_sanskrit": "पराशरश्च गर्गश्च भार्गवांगिरसौ तदा  ।\nभविष्यंति महात्मानो ब्राह्मणा वेदपारगाः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003221045, "chapter_id": 23221, "verse_number": "१-२४-४६", "content_sanskrit": "ध्यानमार्गं समासाद्य गमिष्यंति तथैव ते  ।\nसर्वे तपोबलोत्कृष्टाः शापानुग्रहकोविदाः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003221046, "chapter_id": 23221, "verse_number": "१-२४-४७", "content_sanskrit": "तेपि तेनैव मार्गेण योगोक्तेन तपस्विनः  ।\nरुद्रलोकं गमिष्यंति पुनरावृत्तिदुर्लभम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003221047, "chapter_id": 23221, "verse_number": "१-२४-४८", "content_sanskrit": "दशमे द्वापरे व्यासः त्रिपाद्वै नाम नामतः  ।\nयदा भविष्यते विप्रस्तदाहं भविता मुनिः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003221048, "chapter_id": 23221, "verse_number": "१-२४-४९", "content_sanskrit": "हिमवच्छिखरे रम्ये भृगुतुङ्गे नगोत्तमे  ।\nनाम्ना भृगोस्तु शिखरं प्रथितं देवपूजितम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003221049, "chapter_id": 23221, "verse_number": "१-२४-५०", "content_sanskrit": "तत्रापि मम ते पुत्रा भविष्यन्ति दृढव्रताः  ।\nबलबंधुर्निरामित्रः केतुश्रृंगस्तपोधनः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003221050, "chapter_id": 23221, "verse_number": "१-२४-५१", "content_sanskrit": "योगात्मानो महात्मानस्तपोयोगसमन्विताः  ।\nरुद्रलोकं गमिष्यंति तपसा दग्धकिल्बिषाः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003221051, "chapter_id": 23221, "verse_number": "१-२४-५२", "content_sanskrit": "एकादशे द्वापरे तु व्यासस्तु त्रिव्रतो यदा  ।\nतदाप्यहं भविष्यामि गंगाद्वारे कलौ तथा ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003221052, "chapter_id": 23221, "verse_number": "१-२४-५३", "content_sanskrit": "उग्रो नाम महातेजाः सर्वलोकेषु विश्रुतः  ।\nतत्रापि मम ते पुत्रा भविष्यंति महौजसः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003221053, "chapter_id": 23221, "verse_number": "१-२४-५४", "content_sanskrit": "लंबोदरश्च लंबाक्षो लंबकेशः प्रलंबकः  ।\nप्राप्य माहेश्वरं योगं रुद्रलोकं गता हि ते ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003221054, "chapter_id": 23221, "verse_number": "१-२४-५५", "content_sanskrit": "द्वादशे परिवर्ते तु शततेजा यदा मुनिः  ।\nभविष्यति महातेजा व्यासस्तु कविसत्तमः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003221055, "chapter_id": 23221, "verse_number": "१-२४-५६", "content_sanskrit": "तदाप्यहं भविष्यामि कलाविह युगांतिके  ।\nहैतुकं वनमासाद्य अत्रिर्नाम्ना परिश्रुतः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003221056, "chapter_id": 23221, "verse_number": "१-२४-५७", "content_sanskrit": "तत्रापि मम ते पुत्रा भस्मस्नानानुलेपनाः  ।\nभविष्यंति महायोगा रुद्रलोकपरायणाः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003221057, "chapter_id": 23221, "verse_number": "१-२४-५८", "content_sanskrit": "सर्वज्ञः समबुद्धिश्च साध्यः सर्वस्तथैव च  ।\nप्राप्य माहेश्वरं योगं रुद्रलोकं गता हि ते ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003221058, "chapter_id": 23221, "verse_number": "१-२४-५९", "content_sanskrit": "त्रयोदशे पुनः प्राप्ते परिवर्ते क्रमेण तु  ।\nधर्मो नारायणो नाम व्यासस्तु भविता यदा ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003221059, "chapter_id": 23221, "verse_number": "१-२४-६०", "content_sanskrit": "तदाप्यहं भविष्यामि वालिर्नाम महामुनिः  ।\nवालखिल्याश्रमे पुण्ये पर्वते गंधमादने ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003221060, "chapter_id": 23221, "verse_number": "१-२४-६१", "content_sanskrit": "तत्रापि मम ते पुत्रा भविष्यंति तपोधनाः  ।\nसुधामा काश्यपश्चैव वासिष्ठो विरजास्तथा ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003221061, "chapter_id": 23221, "verse_number": "१-२४-६२", "content_sanskrit": "महायोगबलोपेता विमला ऊर्ध्वरेतसः  ।\nप्राप्य माहेश्वरं योगं रुद्रलोकं गता हि ते ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003221062, "chapter_id": 23221, "verse_number": "१-२४-६३", "content_sanskrit": "यदा व्यासस्तरक्षुस्तु पर्याये तु चतुर्दशे ।\nतत्रापि पुनरेवाहं भविष्यामि युगांतिके ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003221063, "chapter_id": 23221, "verse_number": "१-२४-६४", "content_sanskrit": "वंशे त्वंगिरसां श्रेष्ठे गौतमो नाम नामतः  ।\nभविष्यति महापुण्यं गौतमं नाम तद्वनम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003221064, "chapter_id": 23221, "verse_number": "१-२४-६५", "content_sanskrit": "तत्रापि मम ते पुत्रा भविष्यंति कलौ तदा  ।\nअत्रिर्देवसदश्चैव श्रवणोऽथ श्रविष्ठकः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003221065, "chapter_id": 23221, "verse_number": "१-२४-६६", "content_sanskrit": "योगात्मानो महात्मानः सर्वे योगसमन्विताः  ।\nप्राप्य माहेश्वरं योगं रुद्रलोकाय ते गताः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003221066, "chapter_id": 23221, "verse_number": "१-२४-६७", "content_sanskrit": "ततः पंचदशे प्राप्ते परिवर्ते क्रमागते  ।\nत्रैय्यारुणिर्यदा व्यासो द्वापरे समपद्यत ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003221067, "chapter_id": 23221, "verse_number": "१-२४-६८", "content_sanskrit": "तदाप्यहं भविष्यामि नाम्ना वेदशिरा द्विजः  ।\nतत्र वेदशिरो नाम अस्त्रं तत्पारमेश्वरम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003221068, "chapter_id": 23221, "verse_number": "१-२४-६९", "content_sanskrit": "भविष्यति महावीर्यं वेदशीर्षश्च पर्वतः  ।\nहिमवत्पृष्ठमासाद्य सरस्वत्यां नगोत्तमे ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003221069, "chapter_id": 23221, "verse_number": "१-२४-७०", "content_sanskrit": "तत्रापि मम ते पुत्रा भविष्यंति तपोधनाः  ।\nकुणिश्च कुणिबाहुश्च कुशरीरः कुनेत्रकः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003221070, "chapter_id": 23221, "verse_number": "१-२४-७१", "content_sanskrit": "योगात्मानो महात्मानः सर्वे ते द्यूर्ध्वरेतसः  ।\nप्राप्य माहेश्वरं योगं रुद्रलोकाय ते गताः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003221071, "chapter_id": 23221, "verse_number": "१-२४-७२", "content_sanskrit": "व्यासो युगे षोडशे तु यदा देवो भविष्यति  ।\nतत्र योगप्रदानाय भक्तानां च यतात्मनाम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003221072, "chapter_id": 23221, "verse_number": "१-२४-७३", "content_sanskrit": "तदाप्यहं भविष्यामि गोकर्णो नाम नामतः  ।\nभविष्यति सुपुण्यं च गोकर्णं नाम तद्वनम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003221073, "chapter_id": 23221, "verse_number": "१-२४-७४", "content_sanskrit": "तत्रापि मम ते पुत्रा भविष्यंति च योगिनः  ।\nकाश्यपो ह्युशनाश्चैव च्यवनोथ बृहस्पतिः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003221074, "chapter_id": 23221, "verse_number": "१-२४-७५", "content_sanskrit": "तेपि तेनैव मार्गेण ध्यानयोगसमन्विताः  ।\nप्राप्य माहेश्वरं योगं गंतारो रुद्रमेव हि ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003221075, "chapter_id": 23221, "verse_number": "१-२४-७६", "content_sanskrit": "ततः सप्तदशे चैव परिवर्ते क्रमागते  ।\nयदा भविष्यति व्यासो नाम्ना देवकृतं जयः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003221076, "chapter_id": 23221, "verse_number": "१-२४-७७", "content_sanskrit": "तदाप्यहं भविष्यामि गुहावासीति नामतः ।\nहिमवच्छिखरे रम्ये महोत्तुंगे महालये ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003221077, "chapter_id": 23221, "verse_number": "१-२४-७८", "content_sanskrit": "सिद्धक्षेत्रं महापुण्यं भविष्यति महालयम्  ।\nतत्रापि मम ते पुत्रा योगज्ञा ब्रह्मवादिनः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003221078, "chapter_id": 23221, "verse_number": "१-२४-७९", "content_sanskrit": "भविष्यंति महात्मानो निर्ममा निरहंकृताः  ।\nउतथ्यो वामदेवश्च महायोगो महाबलः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003221079, "chapter_id": 23221, "verse_number": "१-२४-८०", "content_sanskrit": "तेषां शतसहस्रं तु शिष्याणां ध्यानयोगिनाम्  ।\nभविष्यन्ति तदा काले सर्वे ते ध्यानयुंजकाः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003221080, "chapter_id": 23221, "verse_number": "१-२४-८१", "content_sanskrit": "योगाभ्यासरताश्चैव हृदि कृत्वा महेश्वरम्  ।\nमहालये पदं न्यस्तं दृष्ट्वा यांति शिवं पदम् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003221081, "chapter_id": 23221, "verse_number": "१-२४-८२", "content_sanskrit": "ये चान्येपि महात्मानः कलौ तस्मिन् युगांतिके  ।\nध्याने मनः समाधाय विमलाः शुद्धबुद्धयः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003221082, "chapter_id": 23221, "verse_number": "१-२४-८३", "content_sanskrit": "मम प्रसादाद्यास्यंति रुद्रलोकं गतज्वराः  ।\nगत्वा महालयं पुण्यं दृष्ट्वा माहेश्वरं पदम् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003221083, "chapter_id": 23221, "verse_number": "१-२४-८४", "content_sanskrit": "तीर्णस्तारयते जंतुर्दश पूर्वान्दशोत्तरान्  ।\nआत्मानमेकविंशं तु तारयित्वा महालये ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003221084, "chapter_id": 23221, "verse_number": "१-२४-८५", "content_sanskrit": "मम प्रसादाद्यास्यंति रुद्रलोकं गतज्वराः  ।\nततोष्टादशमे चैव परिवर्ते यदा विभो ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003221085, "chapter_id": 23221, "verse_number": "१-२४-८६", "content_sanskrit": "तदा ऋतंजयो नाम व्यासस्तु भविता मुनिः  ।\nतदाप्यहं भविष्यामि शिखंडी नाम नामतः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003221086, "chapter_id": 23221, "verse_number": "१-२४-८७", "content_sanskrit": "सिद्धक्षेत्रे महापुण्ये देवदानवपूजिते  ।\nहिमवच्छिखरे रम्ये शिखंडी नाम पर्वतः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003221087, "chapter_id": 23221, "verse_number": "१-२४-८८", "content_sanskrit": "शिखंडिनो वनं चापि यत्र सिद्धनिषेवितम्  ।\nतत्रापि मम ते पुत्रा भविष्यंति तपोधनाः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003221088, "chapter_id": 23221, "verse_number": "१-२४-८९", "content_sanskrit": "वाचश्रवा ऋचीकश्च श्यावाश्वश्च यतीश्वरः  ।\nयोगात्मानो महात्मानः सर्वे ते वेदपारगाः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003221089, "chapter_id": 23221, "verse_number": "१-२४-९०", "content_sanskrit": "प्रप्य माहेश्वरं योगं रुद्रलोकाय संवृताः  ।\nअथ एकोनविंशे तु परिवर्त्ते क्रमागते ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003221090, "chapter_id": 23221, "verse_number": "१-२४-९१", "content_sanskrit": "व्यासस्तु भविता नाम्ना भरद्वाजो महामुनिः  ।\nतदाप्यहं भविष्यामि जटामाली च नामतः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003221091, "chapter_id": 23221, "verse_number": "१-२४-९२", "content_sanskrit": "हिमवच्छिखरे रम्ये जटायुर्यत्र पर्वतः  ।\nतत्रापि मम ते पुत्रा भविष्यंति महौजसः ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003221092, "chapter_id": 23221, "verse_number": "१-२४-९३", "content_sanskrit": "हिरण्यनाभः कौशल्यो लोकाक्षी कुथुमिस्तथा  ।\nईश्वरा योगधर्माणः सर्वे ते ह्यूर्ध्वरेतसः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003221093, "chapter_id": 23221, "verse_number": "१-२४-९४", "content_sanskrit": "प्राप्य माहेश्वरं योगं रुद्रलोकाय संस्थिताः  ।\nततो विंशतिमश्चैव परिवर्तो यदा तदा ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003221094, "chapter_id": 23221, "verse_number": "१-२४-९५", "content_sanskrit": "गौतमस्तु तदा व्यासो भविष्यति महामुनिः  ।\nतदाप्यहं भविष्यामि अट्टहासस्तु नामतः ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003221095, "chapter_id": 23221, "verse_number": "१-२४-९६", "content_sanskrit": "अट्टहासप्रियाश्चैव भविष्यंति तदा नराः  ।\nतत्रैव हिमवत्पृष्ठे अट्टहासो महागिरिः ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003221096, "chapter_id": 23221, "verse_number": "१-२४-९७", "content_sanskrit": "देवदानव यक्षेन्द्रसिद्धचारणसेवितः  ।\nतत्रापि मम ते पुत्रा भविष्यंति महौजसः ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7003221097, "chapter_id": 23221, "verse_number": "१-२४-९८", "content_sanskrit": "योगात्मानो महात्मानो ध्यायिनो नियतव्रताः  ।\nसुमंतुर्बर्बरी विद्वान् कबंधः कुशिकंधरः ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7003221098, "chapter_id": 23221, "verse_number": "१-२४-९९", "content_sanskrit": "प्राप्य माहेश्वरं योगं रुद्रलोकाय ते गताः ।\nएकविंशे पुनः प्राप्ते परिवर्ते क्रमागते ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7003221099, "chapter_id": 23221, "verse_number": "१-२४-१००", "content_sanskrit": "वाचश्रवाः स्मृतो व्यासो यदा स ऋषिसत्तमः  ।\nतदाप्यहं भविष्यामि दारुको नाम नामतः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7003221100, "chapter_id": 23221, "verse_number": "१-२४-१०१", "content_sanskrit": "तस्माद्भविष्यते पुण्यं देवदारु वनं शुभम् ।\nतत्रापि मम ते पुत्रा भवष्यंति महौजसः ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7003221101, "chapter_id": 23221, "verse_number": "१-२४-१०२", "content_sanskrit": "प्लक्षो दार्भायणिश्चैव केतुमान् गौतमस्तथा  ।\nयोगात्मानो महात्मानो नियता ऊर्ध्वरेतसः ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7003221102, "chapter_id": 23221, "verse_number": "१-२४-१०३", "content_sanskrit": "नैष्ठिकं व्रतमास्थाय रुद्रलोकाय ते गताः  ।\nद्वाविंशे परिवर्ते तु व्यासः शुष्मायणो यदा ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7003221103, "chapter_id": 23221, "verse_number": "१-२४-१०४", "content_sanskrit": "तदाप्यहं भविष्यामि वाराणस्यां महामुनिः  ।\nनाम्ना वै लांगली भीमो यत्र देवाः सवासवाः ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7003221104, "chapter_id": 23221, "verse_number": "१-२४-१०५", "content_sanskrit": "द्रक्ष्यंति मां कलौ तस्मिन् भवं चैव हलायुधम्  ।\nतत्रापि मम ते पुत्रा भविष्यंति सुधार्मिकाः ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7003221105, "chapter_id": 23221, "verse_number": "१-२४-१०६", "content_sanskrit": "भल्लवी मधुपिंगश्च श्वेतकेतुः कुशस्तथा  ।\nप्राप्य माहेश्वरं योगं तेपि ध्यानपरायणाः ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7003221106, "chapter_id": 23221, "verse_number": "१-२४-१०७", "content_sanskrit": "विमला ब्रह्मभूयिष्ठा रुद्रलोकाय संस्थिताः  ।\nपरिवर्ते त्रयोविंशे तृणबिंदुर्यदा मुनिः ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7003221107, "chapter_id": 23221, "verse_number": "१-२४-१०८", "content_sanskrit": "व्यासो हि भविता ब्रह्मंस्तदाहं भविता पुनः ।\nश्वेतो नाम महाकायो मुनिपुत्रस्तु धार्मिकः ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7003221108, "chapter_id": 23221, "verse_number": "१-२४-१०९", "content_sanskrit": "तत्र कालं जरिष्यामि तदा गिरिवरोत्तमे ।\nतेन कालंजरो नाम भविष्यति स पर्वतः ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7003221109, "chapter_id": 23221, "verse_number": "१-२४-११०", "content_sanskrit": "तत्रापि मम ते शिष्याः भविष्यंति तपस्विनः  ।\nउशिको बृहदश्वश्च देवलः कविरेव च ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7003221110, "chapter_id": 23221, "verse_number": "१-२४-१११", "content_sanskrit": "प्राप्य माहेश्वरं योगं रुद्रलोकाय ते गतः  ।\nपरिवर्ते चतुर्विंशे व्यासो ऋक्षो यदा विभो ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7003221111, "chapter_id": 23221, "verse_number": "१-२४-११२", "content_sanskrit": "तदाप्यहं भविष्यामि कलौ तस्मिन् युगांतिके  ।\nशूली नाम महायोगी नैमिषे देववंदिते ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7003221112, "chapter_id": 23221, "verse_number": "१-२४-११३", "content_sanskrit": "तत्रापि मम ते शिष्या भविष्यंति तपोधनाः  ।\nशालिहोत्रोग्निवेशश्च युवनाश्वः शरद्वसुः ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7003221113, "chapter_id": 23221, "verse_number": "१-२४-११४", "content_sanskrit": "तेऽपि तेनैव मार्गेण रुद्रलोकाय संस्थिताः  ।\nपंचविंशे पुनः प्राप्ते परिवर्ते क्रमागते ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7003221114, "chapter_id": 23221, "verse_number": "१-२४-११५", "content_sanskrit": "वासिष्ठस्तु यदा व्यासः शक्तिर्नाम्ना भविष्यति  ।\nतदाप्यहं भविष्यामि दंडी मुंडीश्वरः प्रभुः ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7003221115, "chapter_id": 23221, "verse_number": "१-२४-११६", "content_sanskrit": "तत्रापि मम ते पुत्रा भविष्यंति तपोधनाः  ।\nछगलः कुंडकर्णश्च कुभांडश्च प्रवाहकः ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7003221116, "chapter_id": 23221, "verse_number": "१-२४-११७", "content_sanskrit": "प्राप्य माहेश्वरं योगममृतत्वाय ते गताः ।\nषड्विंशे परिवर्ते तु यदा व्यासः पराशरः ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7003221117, "chapter_id": 23221, "verse_number": "१-२४-११८", "content_sanskrit": "तदाप्यहं भविष्यामि सहिष्णुर्नाम नामतः  ।\nपुरं भद्रवटं प्राप्य कलौ तस्मिन् युगांतिके ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7003221118, "chapter_id": 23221, "verse_number": "१-२४-११९", "content_sanskrit": "तत्रापि मम ते पुत्रा भविष्यंति सुधार्मिकाः  ।\nउलूको विद्युतश्चैव शंबूको ह्याश्वलायनः ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7003221119, "chapter_id": 23221, "verse_number": "१-२४-१२०", "content_sanskrit": "प्राप्य माहेश्वरं योगं रुद्रलोकाय ते गताः  ।\nसप्तविंशे पुनः प्राप्ते परिवर्ते क्रमागते ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7003221120, "chapter_id": 23221, "verse_number": "१-२४-१२१", "content_sanskrit": "जातूकर्ण्यो यदा व्यासो भविष्यति तपोधनः  ।\nतदाप्यहं भविष्यामि सोमशर्मा द्विजोत्तमः ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7003221121, "chapter_id": 23221, "verse_number": "१-२४-१२२", "content_sanskrit": "प्रभासतीर्थमासाद्य योगात्मा योगविश्रुतः  ।\nतत्रापि मम ते शिष्या भविष्यंति तपोधनाः ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7003221122, "chapter_id": 23221, "verse_number": "१-२४-१२३", "content_sanskrit": "अक्षपादः कुमारश्च उलूको वत्स एव च  ।\nयोगात्मानो महात्मानो विमलाः शुद्धबुद्धयः ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7003221123, "chapter_id": 23221, "verse_number": "१-२४-१२४", "content_sanskrit": "प्राप्य माहेश्वरं योगं रुद्रलोकं ततो गताः  ।\nअष्टाविंशे पुनः प्राप्ते परिवर्ते क्रमागते ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7003221124, "chapter_id": 23221, "verse_number": "१-२४-१२५", "content_sanskrit": "पराशरसुतः श्रीमान् विष्णुर्लोकपितामहः  ।\nयदा भविष्यति व्यासो नाम्ना द्वैपायनः प्रभुः ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7003221125, "chapter_id": 23221, "verse_number": "१-२४-१२६", "content_sanskrit": "तदा षष्ठेन चांशेन कृष्णः पुरुषसत्तमः ।\nवसुदेवाद्यदुश्रेष्ठो वासुदेवो भविष्यति ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7003221126, "chapter_id": 23221, "verse_number": "१-२४-१२७", "content_sanskrit": "तदाप्यहं भविष्यामि योगात्मा योगमायया  ।\nलोकविस्मयनार्थाय ब्रह्मचारिशरीरकः ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7003221127, "chapter_id": 23221, "verse_number": "१-२४-१२८", "content_sanskrit": "श्मशाने मृतमुत्सृष्टं दृष्ट्वा कायमनाथकम्  ।\nब्राह्मणानां हितार्थाय प्रविष्टो योगमायया ॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7003221128, "chapter_id": 23221, "verse_number": "१-२४-१२९", "content_sanskrit": "दिव्यां मेरुगुहां पुण्यां त्वया सार्धं च विष्णुना  ।\nभविष्यामि तदा ब्रह्मँल्लकुली नाम नामतः ॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7003221129, "chapter_id": 23221, "verse_number": "१-२४-१३०", "content_sanskrit": "कायावतार इत्येवं सिद्धक्षेत्रं च वै तदा  ।\nभविष्यति सुविख्यातं यावद्भूमिर्धरिष्यति ॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7003221130, "chapter_id": 23221, "verse_number": "१-२४-१३१", "content_sanskrit": "तत्रापि मम ते पुत्रा भविष्यंति तपस्विनः  ।\nकुशिकश्चैव गर्गश्च मित्रः कौरुष्य एव च ॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7003221131, "chapter_id": 23221, "verse_number": "१-२४-१३२", "content_sanskrit": "योगात्मानो महात्मानो ब्राह्मणा वेदपारगाः  ।\nप्राप्य माहेश्वरं योगं विमला ह्यूर्ध्वरेतसः ॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7003221132, "chapter_id": 23221, "verse_number": "१-२४-१३३", "content_sanskrit": "रुद्रलोकं गमिष्यंति पुनरावृत्तिदुर्लभम्  ।\nएते पाशुपताः सिद्धा भस्मोद्दूलितविग्रहाः ॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 7003221133, "chapter_id": 23221, "verse_number": "१-२४-१३४", "content_sanskrit": "लिंगार्चनरता नित्यं बाह्याभ्यंतरतः स्थिताः  ।\nभक्त्या मयि च योगेन ध्यान निष्ठा जितेंद्रियाः ॥१३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 7003221134, "chapter_id": 23221, "verse_number": "१-२४-१३५", "content_sanskrit": "संसारबंधच्छेदार्थं ज्ञानमार्गप्रकाशकम्  ।\nस्वरूपज्ञानसिद्ध्यर्थं योगं पाशुपतं महत् ॥१३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 7003221135, "chapter_id": 23221, "verse_number": "१-२४-१३६", "content_sanskrit": "योगमार्गा अनेकाश्च ज्ञानमार्गास्त्वनेकशः  ।\nन निवृत्तिमुपायांति विना पंचाक्षरीं क्वचित् ॥१३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 7003221136, "chapter_id": 23221, "verse_number": "१-२४-१३७", "content_sanskrit": "यदाचरेत्तपश्चायं सर्वद्वंद्वविवर्जितम्  ।\nतदा स मुक्तो मंतव्यः पक्वं फलमिव स्थितः ॥१३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 7003221137, "chapter_id": 23221, "verse_number": "१-२४-१३८", "content_sanskrit": "एकाहं यः पुमान्सम्यक् चरेत्पाशुपतव्रतम्  ।\nन सांख्ये पंचरात्रे वा न प्राप्नोति गतिं कदा ॥१३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 7003221138, "chapter_id": 23221, "verse_number": "१-२४-१३९", "content_sanskrit": "इत्येतद्वै मया प्रोक्तमवतारेषु लक्षणम्  ।\nमन्वादिकृष्णपर्यंतमष्टाविशंद्युगक्रमात् ॥१३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 7003221139, "chapter_id": 23221, "verse_number": "१-२४-१४०", "content_sanskrit": "तत्र श्रुतिसमूहानां विभागो धर्मलक्षणः  ।\nभविष्यति तदा कल्पे कृष्णद्वैपायनो यदा ॥१४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 7003221140, "chapter_id": 23221, "verse_number": "१-२४-१४१", "content_sanskrit": "सूत उवाच  ।\nनिशम्यैवं महातेजा महादेवेन कीर्तितम्  ।\nरुद्रावतारं भगवान् प्रणिपत्य महेश्वरम् ॥१४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 7003221141, "chapter_id": 23221, "verse_number": "१-२४-१४२", "content_sanskrit": "तुष्टाव वाग्भिरिष्टाभिः पुनः प्राह च शंकरम्  ।\nपितामह उवाच  ।\nसर्वे विष्णुमया देवाः सर्वे विष्णुमया गणाः ॥१४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}, {"id": 7003221142, "chapter_id": 23221, "verse_number": "१-२४-१४३", "content_sanskrit": "न हि विष्णुसमा काचिद्गतिरन्या विधीयते  ।\nइत्येवं सततं वेदा गायंति नात्र संशयः ॥१४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143}, {"id": 7003221143, "chapter_id": 23221, "verse_number": "१-२४-१४४", "content_sanskrit": "स देवदेवो भगवांस्तव लिंगार्चने रतः  ।\nतव प्रणामपरमः कथं देवो ह्यभूत्प्रभुः ॥१४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144}, {"id": 7003221144, "chapter_id": 23221, "verse_number": "१-२४-१४५", "content_sanskrit": "सूत उवाच  ।\nनिशम्य वचनं तस्य ब्रह्मणः परमेष्ठिनः  ।\nप्रपिबन्निव चक्षुर्भ्यां प्रीतस्तत्प्रश्नगौरवात् ॥१४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 145}, {"id": 7003221145, "chapter_id": 23221, "verse_number": "१-२४-१४६", "content_sanskrit": "पूजाप्रकरणं तस्मै तमालोक्याह शंकरः  ।\nभवान्नारायणश्चैव शक्रः साक्षात्सुरोत्तमः ॥१४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 146}, {"id": 7003221146, "chapter_id": 23221, "verse_number": "१-२४-१४७", "content_sanskrit": "मुनयश्च सदा लिंगं संपूज्य विधिपूर्वकम्  ।\nस्वंस्वं पदं विभो प्राप्तास्तस्मात्संपूजयंति ते ॥१४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 147}, {"id": 7003221147, "chapter_id": 23221, "verse_number": "१-२४-१४८", "content_sanskrit": "लिंगार्चनं विना निष्ठा नास्ति तस्माज्जनार्दनः  ।\nआत्मनो यजते नित्यं श्रद्धया भगवान्प्रभुः ॥१४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 148}, {"id": 7003221148, "chapter_id": 23221, "verse_number": "१-२४-१४९", "content_sanskrit": "इत्येवमुक्त्वा ब्रह्माणमनुगृह्य महेश्वरः  ।\nपुनः संप्रेक्ष्य देवेशं तत्रैवांतरधीयत ॥१४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 149}, {"id": 7003221149, "chapter_id": 23221, "verse_number": "१-२४-१५०", "content_sanskrit": "तमुद्दिश्य तदा ब्रह्मा नमस्कृत्य कृतांजलिः  ।\nस्रष्टुं त्वशेषं भगवाँल्लब्धसंज्ञस्तु शंकरात् ॥१५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 150}]