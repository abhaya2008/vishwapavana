[{"id": 900008542, "chapter_id": 8645, "verse_number": "26.1", "content_sanskrit": "यद्यप्यत्रेशानपदप्रवृत्तिनिमित्तप्रेरकत्वमसङ्कुचितं न वायौ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900008543, "chapter_id": 8645, "verse_number": "26.2", "content_sanskrit": "पूर्वपक्षस्तु", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900008544, "chapter_id": 8645, "verse_number": "26.3", "content_sanskrit": "एतेन विश्वदेवशब्दो गणविशेषपर इति निरस्तम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900008545, "chapter_id": 8645, "verse_number": "26.4", "content_sanskrit": "सिद्धान्तस्तु", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900008546, "chapter_id": 8645, "verse_number": "26.5", "content_sanskrit": "मध्ये वामनमित्यत्र च मध्यशब्दो देशवाची", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900008547, "chapter_id": 8645, "verse_number": "26.6", "content_sanskrit": "अन्येतु ‘‘अङ्गुष्ठमात्रः पुरुष’’ इति श्रुतोंऽगुष्ठमात्रो जीवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900008548, "chapter_id": 8645, "verse_number": "26.7", "content_sanskrit": "केचित्तु", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900008549, "chapter_id": 8645, "verse_number": "26.8", "content_sanskrit": "अत्र ‘‘श्रुतिर्लिङ्ग’’मित्यादिभाष्ये श्रुत्यादौ पूर्वबलीयस्त्वमुक्तम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900008550, "chapter_id": 8645, "verse_number": "26.9", "content_sanskrit": "विवृतं चैतत्तत्रैव", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900008551, "chapter_id": 8645, "verse_number": "26.10", "content_sanskrit": "उक्तं हि सुधायां ‘‘वाक्यलिङ्गानुमाहिसे’’ति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900008552, "chapter_id": 8645, "verse_number": "26.11", "content_sanskrit": "अत्र च श्रुतिः स्वनिर्णेये श्रुतित्वेनैव निर्णायिका", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}]