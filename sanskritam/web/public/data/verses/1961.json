[{"id": 2043023, "chapter_id": 1961, "verse_number": "६-१०-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2043024, "chapter_id": 1961, "verse_number": "६-१०-१", "content_sanskrit": "भारतस्यास्य वर्षस्य तथा हैमवतस्य च।\nप्रमाणमायुषः सूत बलं चापि शुभाशुभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2043025, "chapter_id": 1961, "verse_number": "६-१०-२", "content_sanskrit": "अनागतमतिक्रान्तं वर्तमानं च संजय ।\nआचक्ष्व मे विस्तरेण हरिवर्षं तथैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2043026, "chapter_id": 1961, "verse_number": "६-१०-३x", "content_sanskrit": "संजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2043027, "chapter_id": 1961, "verse_number": "६-१०-३", "content_sanskrit": "चत्वारि भारते वर्षे युगानि भरतर्षभ।\nकृतं त्रेता द्वापरं च तिष्यं च कुरुवर्धन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2043028, "chapter_id": 1961, "verse_number": "६-१०-४", "content_sanskrit": "पूर्वं कृतयुगं नाम ततस्रेतायुगं प्रभो ।\nसंक्षेपाद्द्वापरस्याथ ततस्तिष्यं प्रवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2043029, "chapter_id": 1961, "verse_number": "६-१०-५", "content_sanskrit": "चत्वारि तु सहस्राणि वर्षाणां कुरुसत्तम।\nआयुःसंख्या कृतयुगे संख्याता राजसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2043030, "chapter_id": 1961, "verse_number": "६-१०-६", "content_sanskrit": "तथा त्रीणि सहस्राणि त्रेतायां मनुजाधिप ।\nद्वे सहस्रे द्वापरे तु भुवि तिष्ठन्ति सांप्रतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2043031, "chapter_id": 1961, "verse_number": "६-१०-७", "content_sanskrit": "न प्रमाणस्थितिर्ह्यस्ति तिष्येऽस्मिन्भरतर्षभ ।\nगर्भस्थाश्च म्रियन्तेऽत्र तथा जाता म्रियन्ति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2043032, "chapter_id": 1961, "verse_number": "६-१०-८", "content_sanskrit": "महाबला महासत्वाः प्रज्ञागुणसमन्विताः।\nप्रजायन्ते च जाताश्च शतशोऽथ सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2043033, "chapter_id": 1961, "verse_number": "६-१०-९", "content_sanskrit": "जाताः कृतयुगे राजन्धनिनः प्रयदर्शनाः ।\nप्रजायन्ते च जाताश्च मुनयो वै तपोधनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2043034, "chapter_id": 1961, "verse_number": "६-१०-१०", "content_sanskrit": "महोत्साहा महात्मानो धार्मिकाः सत्यवादिनः।\nप्रियदर्शना वपुष्मन्तो महावीर्या धनुर्धराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2043035, "chapter_id": 1961, "verse_number": "६-१०-११", "content_sanskrit": "वरार्हा युधि जायन्ते क्षत्रियाः शूरसत्तमाः।\nत्रेतायां क्षत्रिया राजन्सर्वे वै चक्रवर्तिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2043036, "chapter_id": 1961, "verse_number": "६-१०-१२", "content_sanskrit": "सर्ववर्णाश्च जायन्ते सदा चैव च द्वापरे ।\nमहोत्साहा वीर्यवन्तः परस्परजयैषिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2043037, "chapter_id": 1961, "verse_number": "६-१०-१३", "content_sanskrit": "तेजसाल्पेन संयुक्ताः क्रोधनाः पुरुषा नृप।\nलुब्धा अनृतकाश्चैव तिष्ये जायन्ति भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2043038, "chapter_id": 1961, "verse_number": "६-१०-१४", "content_sanskrit": "ईर्ष्या मानस्तथा क्रोधो मायाऽसूया तथैव च।\nतिष्ये भवति भूतानां रागो लोभश्च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2043039, "chapter_id": 1961, "verse_number": "६-१०-१५", "content_sanskrit": "संक्षेपो वर्तते राजन्द्वापरेऽस्मिन्नराधिप ।\nगुणोत्तरं हैमवतं हरिवर्षं ततः परम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2043040, "chapter_id": 1961, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि जम्बूखण्डविनिर्माणपर्वणि दशमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]