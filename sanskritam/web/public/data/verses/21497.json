[{"id": 7001497000, "chapter_id": 21497, "verse_number": "७-२-३५-१", "content_sanskrit": "उपमन्युरुवाच ।\nअथाविरभवत्तत्र सनादं शब्दलक्षणम् ।\nओमित्येकाक्षरं ब्रह्म ब्रह्मणः प्रतिपादकम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001497001, "chapter_id": 21497, "verse_number": "७-२-३५-२", "content_sanskrit": "तदप्यविदितं तावद्ब्रह्मणा विष्णुना तथा ।\nरजसा तमसा चित्तं तयोर्यस्मात्तिरस्कृतम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001497002, "chapter_id": 21497, "verse_number": "७-२-३५-३", "content_sanskrit": "तदा विभक्तमभवच्चतुर्धैकं तदक्षरम् ।\nअ उ मेति त्रिमात्राभिः परस्ताच्चार्धमात्रया॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001497003, "chapter_id": 21497, "verse_number": "७-२-३५-४", "content_sanskrit": "तत्राकारः श्रितो भागे ज्वलल्लिंगस्य दक्षिणे ।\nउकारश्चोत्तरे तद्वन्मकारस्तस्य मध्यतः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001497004, "chapter_id": 21497, "verse_number": "७-२-३५-५", "content_sanskrit": "अर्धमात्रात्मको नादः श्रूयते लिंगमूर्धनि ।\nविभक्ते ऽपि तदा तस्मिन्प्रणवे परमाक्षरे॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001497005, "chapter_id": 21497, "verse_number": "७-२-३५-६", "content_sanskrit": "विभावार्थं च तौ देवौ न किंचिदवजग्मतुः ।\nवेदात्मना तदाव्यक्तः प्रणवो विकृतिं गतः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001497006, "chapter_id": 21497, "verse_number": "७-२-३५-७", "content_sanskrit": "तत्राकारो ऋगभवदुकारो यजुरव्ययः ।\nमकारस्साम संजातो नादस्त्वाथर्वणी श्रुतिः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001497007, "chapter_id": 21497, "verse_number": "७-२-३५-८", "content_sanskrit": "ऋगयं स्थापयामास समासात्त्वर्थमात्मनः ।\nरजोगुणेषु ब्रह्माणं मूर्तिष्वाद्यं क्रियास्वपि॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001497008, "chapter_id": 21497, "verse_number": "७-२-३५-९", "content_sanskrit": "सृष्टिं लोकेषु पृथिवीं तत्त्वेष्वात्मानमव्ययम् ।\nकलाध्वनि निवृत्तिं च सद्यं ब्रह्मसु पञ्चसु॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001497009, "chapter_id": 21497, "verse_number": "७-२-३५-१०", "content_sanskrit": "लिंगभागेष्वधोभागं बीजाख्यं कारणत्रये ।\nचतुःषष्टिगुणैश्वर्यं बौद्धं यदणिमादिषु॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001497010, "chapter_id": 21497, "verse_number": "७-२-३५-११", "content_sanskrit": "तदित्थमर्थैर्दशभिर्व्याप्तं विश्वमृचा जगत् ।\nअथोपस्थापयामास स्वार्थं दशविधं यजुः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001497011, "chapter_id": 21497, "verse_number": "७-२-३५-१२", "content_sanskrit": "सत्त्वं गुणेषु विष्णुं च मूर्तिष्वाद्यं क्रियास्वपि ।\nस्थितिं लोकेष्वंतरिक्षं विद्यां तत्त्वेषु च त्रिषु॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001497012, "chapter_id": 21497, "verse_number": "७-२-३५-१३", "content_sanskrit": "कलाध्वसु प्रतिष्ठां च वामं ब्रह्मसु पञ्चसु ।\nमध्यं तु लिंगभागेषु योनिं च त्रिषु हेतुषु॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001497013, "chapter_id": 21497, "verse_number": "७-२-३५-१४", "content_sanskrit": "प्राकृतं च यथैश्वर्यं तस्माद्विश्वं यजुर्मयम् ।\nततोपस्थापयामास सामार्थं दशधात्मनः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001497014, "chapter_id": 21497, "verse_number": "७-२-३५-१५", "content_sanskrit": "तमोगुणेष्वथो रुद्रं मूर्तिष्वाद्यं क्रियासु च ।\nसंहृतिं त्रिषु लोकेषु तत्त्वेषु शिवमुत्तमम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001497015, "chapter_id": 21497, "verse_number": "७-२-३५-१६", "content_sanskrit": "विद्याकलास्वघोरं च तथा ब्रह्मसु पञ्चसु ।\nलिंगभागेषु पीठोर्ध्वं बीजिनं कारणत्रये॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001497016, "chapter_id": 21497, "verse_number": "७-२-३५-१७", "content_sanskrit": "पौरुषं च तथैश्वर्यमित्थं साम्ना ततं जगत् ।\nअथाथर्वाह नैर्गुण्यमर्थं प्रथममात्मनः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001497017, "chapter_id": 21497, "verse_number": "७-२-३५-१८", "content_sanskrit": "ततो महेश्वरं साक्षान्मूर्तिष्वपि सदाशिवम् ।\nक्रियासु निष्क्रियस्यापि शिवस्य परमात्मनः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001497018, "chapter_id": 21497, "verse_number": "७-२-३५-१९", "content_sanskrit": "भूतानुग्रहणं चैव मुच्यंते येन जंतवः ।\nलोकेष्वपि यतो वाचो निवृत्ता मनसा सह॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001497019, "chapter_id": 21497, "verse_number": "७-२-३५-२०", "content_sanskrit": "तदूर्ध्वमुन्मना लोकात्सोमलोकमलौकिकम् ।\nसोमस्सहोमया यत्र नित्यं निवसतीश्वरः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001497020, "chapter_id": 21497, "verse_number": "७-२-३५-२१", "content_sanskrit": "तदूर्ध्वमुन्मना लोकाद्यं प्राप्तो न निवर्तते ।\nशांतिं च शांत्यतीतां च व्यापिकां चै कलास्वपि॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001497021, "chapter_id": 21497, "verse_number": "७-२-३५-२२", "content_sanskrit": "तत्पूरुषं तथेशानं ब्रह्म ब्रह्मसु पञ्चसु ।\nमूर्धानमपि लिंगस्य नादभागेष्वनुत्तमम्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001497022, "chapter_id": 21497, "verse_number": "७-२-३५-२३", "content_sanskrit": "यत्रावाह्य समाराध्यः केवलो निष्कलः शिवः ।\nतत्तेष्वपि तदा बिंदोर्नादाच्छक्तेस्ततः परात्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001497023, "chapter_id": 21497, "verse_number": "७-२-३५-२४", "content_sanskrit": "तत्त्वादपि परं तत्त्वमतत्त्वं परमार्थतः ।\nकारणेषु त्रयातीतान्मायाविक्षोभकारणात्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001497024, "chapter_id": 21497, "verse_number": "७-२-३५-२५", "content_sanskrit": "अनंताच्छुद्धविद्यायाः परस्ताच्च महेश्वरात् ।\nसर्वविद्येश्वराधीशान्न पराच्च सदाशिवात्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001497025, "chapter_id": 21497, "verse_number": "७-२-३५-२६", "content_sanskrit": "सर्वमंत्रतनोर्देवाच्छक्तित्रयसमन्वितात् ।\nपञ्चवक्त्राद्दशभुजात्साक्षात्सकलनिष्कलात्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001497026, "chapter_id": 21497, "verse_number": "७-२-३५-२७", "content_sanskrit": "तस्मादपि पराद्बिंदोरर्धेदोश्च ततः परात् ।\nततः परान्निशाधीशान्नादाख्याच्च ततः परात्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001497027, "chapter_id": 21497, "verse_number": "७-२-३५-२८", "content_sanskrit": "ततः परात्सुषुम्नेशाद्ब्रह्मरंध्रेश्वरादपि ।\nततः परस्माच्छक्तेश्च परस्ताच्छिवतत्त्वतः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001497028, "chapter_id": 21497, "verse_number": "७-२-३५-२९", "content_sanskrit": "परमं कारणं साक्षात्स्वयं निष्कारणं शिवम् ।\nकारणानां च धातारं ध्यातारां ध्येयमव्ययम्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001497029, "chapter_id": 21497, "verse_number": "७-२-३५-३०", "content_sanskrit": "परमाकाशमध्यस्थं परमात्मोपरि स्थितं ।\nसर्वैश्वर्येण संपन्नं सर्वेश्वरमनीश्वरम्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001497030, "chapter_id": 21497, "verse_number": "७-२-३५-३१", "content_sanskrit": "ऐश्वर्याच्चापि मायेयादशुद्धान्मानुषादिकात् ।\nअपराच्च परात्त्याज्यादधिशुद्धाध्वगोचरात्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001497031, "chapter_id": 21497, "verse_number": "७-२-३५-३२", "content_sanskrit": "तत्पराच्छुद्धविद्याद्यादुन्मनांतात्परात्परात् ।\nपरमं परमैश्वर्यमुन्मनाद्यमनादि च॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001497032, "chapter_id": 21497, "verse_number": "७-२-३५-३३", "content_sanskrit": "अपारमपराधीनं निरस्तातिशयं स्थिरम् ।\nइत्थमर्थैर्दशविधैरियमाथर्वणी श्रुतिः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001497033, "chapter_id": 21497, "verse_number": "७-२-३५-३४", "content_sanskrit": "यस्माद्गरीयसी तस्माद्विश्वं व्याप्तमथर्वणात् ।\nऋग्वेदः पुनराहेदं जाग्रद्रूपं मयोच्यते॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001497034, "chapter_id": 21497, "verse_number": "७-२-३५-३५", "content_sanskrit": "येनाहमात्मतत्त्वस्य नित्यमस्म्यभिधायकः ।\nयजुर्वेदो ऽवदत्तद्वत्स्वप्नावस्था मयोच्यते॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001497035, "chapter_id": 21497, "verse_number": "७-२-३५-३६", "content_sanskrit": "भोग्यात्मना परिणता विद्यावेद्या यतो मयि ।\nसाम चाह सुषुप्त्याख्यमेवं सर्वं मयोच्यते॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001497036, "chapter_id": 21497, "verse_number": "७-२-३५-३७", "content_sanskrit": "ममार्थेन शिवेनेदं तामसेनाभिधीयते ।\nअथर्वाह तुरायाख्यं तुरीयातीतमेव च॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001497037, "chapter_id": 21497, "verse_number": "७-२-३५-३८", "content_sanskrit": "मयाभिधीयते तस्मादध्वातीतपदोस्म्यहम् ।\nअध्वात्मकं तु त्रितयं शिवविद्यात्मसंज्ञितम्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001497038, "chapter_id": 21497, "verse_number": "७-२-३५-३९", "content_sanskrit": "तत्त्रैगुण्यं त्रयीसाध्यं संशोध्यं च पदैषिणा ।\nअध्वातीतं तुरीयाख्यं निर्वाणं परमं पदम्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001497039, "chapter_id": 21497, "verse_number": "७-२-३५-४०", "content_sanskrit": "तदतीतं च नैर्गुण्यादध्वनोस्य विशोधकम् ।\nद्वयोः प्रमापको नादो नदांतश्च मदात्मकः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001497040, "chapter_id": 21497, "verse_number": "७-२-३५-४१", "content_sanskrit": "तस्मान्ममार्थस्वातंत्र्यात्प्रधानः परमेश्वरः ।\nयदस्ति वस्तु तत्सर्वं गुणप्रधान्ययोगतः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001497041, "chapter_id": 21497, "verse_number": "७-२-३५-४२", "content_sanskrit": "समस्तं व्यस्तमपि च प्रणवार्थं प्रचक्षते ।\nसवार्थवाचकं तस्मादेकं ब्रह्मैतदक्षरम्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001497042, "chapter_id": 21497, "verse_number": "७-२-३५-४३", "content_sanskrit": "तेनोमिति जगत्कृत्स्नं कुरुते प्रथमं शिवः ।\nशिवो हि प्रणवो ह्येष प्रणवो हि शिवः स्मृतः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001497043, "chapter_id": 21497, "verse_number": "७-२-३५-४४", "content_sanskrit": "वाच्यवाचकयोर्भेदो नात्यंतं विद्यते यतः ।\nचिंतया रहितो रुद्रो वाचोयन्मनसा सह॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001497044, "chapter_id": 21497, "verse_number": "७-२-३५-४५", "content_sanskrit": "अप्राप्य तन्निवर्तंते वाच्यस्त्वेकाक्षरेण सः ।\nएकाक्षरादकाराख्यादात्मा ब्रह्माभिधीयते॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001497045, "chapter_id": 21497, "verse_number": "७-२-३५-४६", "content_sanskrit": "एकाक्षरादुकाराख्याद्द्विधा विष्णुरुदीर्यते ।\nएकाक्षरान्मकाराख्याच्छिवो रुद्र उदाहृतः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001497046, "chapter_id": 21497, "verse_number": "७-२-३५-४७", "content_sanskrit": "दक्षिणांगान्महेशस्य जातो ब्रह्मात्मसंज्ञिकः ।\nवामांगादभवद्विष्णुस्ततो विद्येति संज्ञितः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001497047, "chapter_id": 21497, "verse_number": "७-२-३५-४८", "content_sanskrit": "हृदयान्नीलरुद्रो भूच्छिवस्य शिवसंज्ञिकः ।\nसृष्टेः प्रवर्तको ब्रह्मा स्थितेर्विष्णुर्विमोहकः॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001497048, "chapter_id": 21497, "verse_number": "७-२-३५-४९", "content_sanskrit": "संहारस्य तथा रुद्रस्तयोर्नित्यं नियामकः ।\nतस्मात्त्रयस्ते कथ्यंते जगतः कारणानि च॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001497049, "chapter_id": 21497, "verse_number": "७-२-३५-५०", "content_sanskrit": "कारणत्रयहेतुश्च शिवः परमकारणम् ।\nअर्थमेतमविज्ञाय रजसा बद्धवैरयोः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001497050, "chapter_id": 21497, "verse_number": "७-२-३५-५१", "content_sanskrit": "युवयोः प्रतिबोधाय मध्ये लिंगमुपस्थितम् ।\nएवमोमिति मां प्राहुर्यदिहोक्तमथर्वणा॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001497051, "chapter_id": 21497, "verse_number": "७-२-३५-५२", "content_sanskrit": "ऋचो यजूंषि सामानि शाखाश्चान्याः सहस्रशः ।\nवेदेष्वेवं स्वयं वक्त्रैर्व्यक्तमित्यवदत्स्वपि॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001497052, "chapter_id": 21497, "verse_number": "७-२-३५-५३", "content_sanskrit": "स्वप्नानुभूतमिव तत्ताभ्यां नाध्यवसीयते ।\nतयोस्तत्र प्रबोधाय तमोपनयनाय च॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001497053, "chapter_id": 21497, "verse_number": "७-२-३५-५४", "content_sanskrit": "लिंगेपि मुद्रितं सर्वं यथा वेदैरुदाहृतम् ।\nतद्दृष्ट्वा मुद्रितं लिंगे प्रसादाल्लिंगिनस्तदा॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001497054, "chapter_id": 21497, "verse_number": "७-२-३५-५५", "content_sanskrit": "प्रशांतमनसौ देवौ प्रबुद्धौ संबभूवतुः ।\nउत्पत्तिं विलयं चैव यथात्म्यं च षडध्वनाम्॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001497055, "chapter_id": 21497, "verse_number": "७-२-३५-५६", "content_sanskrit": "ततः परतरं धाम धामवंतं च पूरुषम् ।\nनिरुत्तरतरं ब्रह्म निष्कलं शिवमीश्वरम्॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001497056, "chapter_id": 21497, "verse_number": "७-२-३५-५७", "content_sanskrit": "पशुपाशमयस्यास्य प्रपञ्चस्य सदा पतिम् ।\nअकुतोभयमत्यंतमवृद्धिक्षयमव्ययम्॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001497057, "chapter_id": 21497, "verse_number": "७-२-३५-५८", "content_sanskrit": "वाह्यमाभ्यंतरं व्याप्तं वाह्याभ्यंतरवर्जितम् ।\nनिरस्तातिशयं शश्वद्विश्वलोकविलक्षणम्॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001497058, "chapter_id": 21497, "verse_number": "७-२-३५-५९", "content_sanskrit": "अलक्षणमनिर्देश्यमवाङ्मनसगोचरम् ।\nप्रकाशैकरसं शांतं प्रसन्नं सततोदितम्॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001497059, "chapter_id": 21497, "verse_number": "७-२-३५-६०", "content_sanskrit": "सर्वकल्याणनिलयं शक्त्या तादृशयान्वितम् ।\nज्ञात्वा देवं विरूपाक्षं ब्रह्मनारायणौ तदा॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001497060, "chapter_id": 21497, "verse_number": "७-२-३५-६१", "content_sanskrit": "रचयित्वांजलिं मूर्ध्नि भीतौ तौ वाचमूचतुः ।\nब्रह्मोवाच ।\nअज्ञो वाहमभिज्ञो वा त्वयादौ देव निर्मितः॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001497061, "chapter_id": 21497, "verse_number": "७-२-३५-६२", "content_sanskrit": "ईदृशीं भ्रांतिमापन्न इति को ऽत्रापराध्यति ।\nआस्तां ममेदमज्ञानं त्वयि सन्निहते प्रभो॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001497062, "chapter_id": 21497, "verse_number": "७-२-३५-६३", "content_sanskrit": "निर्भयः को ऽभिभाषेत कृत्यं स्वस्य परस्य वा ।\nआवयोर्देवदेवस्य विवादो ऽपि हि शोभनः॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001497063, "chapter_id": 21497, "verse_number": "७-२-३५-६४", "content_sanskrit": "पादप्रणामफलदो नाथस्य भवतो यतः ।\nविष्णुरुवाच ।\nस्तोतुं देव न वागस्ति महिम्नः सदृशी तव॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001497064, "chapter_id": 21497, "verse_number": "७-२-३५-६५", "content_sanskrit": "प्रभोरग्रे विधेयानां तूष्णींभावो व्यतिक्रमः ।\nकिमत्र संघटेत्कृत्यमित्येवावसरोचितम्॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001497065, "chapter_id": 21497, "verse_number": "७-२-३५-६६", "content_sanskrit": "अजानन्नपि यत्किंचित्प्रलप्य त्वां नतो ऽस्म्यहम् ।\nकारणत्वं त्वया दत्तं विस्मृतं तव मायया॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001497066, "chapter_id": 21497, "verse_number": "७-२-३५-६७", "content_sanskrit": "मोहितो ऽहंकृतश्चापि पुनरेवास्मि शासितः ।\nविज्ञापितैः किं बहुभिर्भीतोस्मि भृशमीश्वर॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001497067, "chapter_id": 21497, "verse_number": "७-२-३५-६८", "content_sanskrit": "यतो ऽहमपरिच्छेद्यं त्वां परिच्छेत्तुमुद्यतः ।\nत्वामुशंति महादेवं भीतानामार्तिनाशनम्॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001497068, "chapter_id": 21497, "verse_number": "७-२-३५-६९", "content_sanskrit": "अतो व्यतिक्रमं मे ऽद्य क्षंतुमर्हसि शंकर ।\nइति विज्ञापितस्ताभ्यामीश्वराभ्यां महेश्वरः॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001497069, "chapter_id": 21497, "verse_number": "७-२-३५-७०", "content_sanskrit": "प्रीतो ऽनुगृह्य तौ देवौ स्मितपूर्वमभाषत ।\nईश्वर उवाच ।\nवत्सवत्स विधे विष्णो मायया मम मोहितौ॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001497070, "chapter_id": 21497, "verse_number": "७-२-३५-७१", "content_sanskrit": "युवां प्रभुत्वे ऽहंकृत्य बुद्धवैरो परस्परम् ।\nविवादं युद्धपर्यंतं कृत्वा नोपरतौ किल॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7001497071, "chapter_id": 21497, "verse_number": "७-२-३५-७२", "content_sanskrit": "ततश्च्छिन्ना प्रजासृष्टिर्जगत्कारणभूतयोः ।\nअज्ञानमानप्रभवाद्वैमत्याद्युवयोरपि॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7001497072, "chapter_id": 21497, "verse_number": "७-२-३५-७३", "content_sanskrit": "तन्निवर्तयितुं युष्मद्दर्पमोहौ मयैव तु ।\nएवं निवारितावद्यलिंगाविर्भावलीलया॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7001497073, "chapter_id": 21497, "verse_number": "७-२-३५-७४", "content_sanskrit": "तस्माद्भूयो विवादं च व्रीडां चोत्सृज्य कृत्स्नशः ।\nयथास्वं कर्म कुर्यातां भवंतौ वीतमत्सरौ॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7001497074, "chapter_id": 21497, "verse_number": "७-२-३५-७५", "content_sanskrit": "पुरा ममाज्ञया सार्धं समस्तज्ञानसंहिताः ।\nयुवाभ्यां हि मया दत्ता कारणत्वप्रसिद्धये॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7001497075, "chapter_id": 21497, "verse_number": "७-२-३५-७६", "content_sanskrit": "मंत्ररत्नं च सूत्राख्यं पञ्चाक्षरमयं परम् ।\nमयोपदिष्टं सर्वं तद्युवयोरद्य विस्मृतम्॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7001497076, "chapter_id": 21497, "verse_number": "७-२-३५-७७", "content_sanskrit": "ददामि च पुनः सर्वं यथापूर्वं ममाज्ञया ।\nयतो विना युवां तेन न क्षमौ सृष्टिरक्षणे॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7001497077, "chapter_id": 21497, "verse_number": "७-२-३५-७८", "content_sanskrit": "एवमुक्त्वा महादेवो नारायणपितामहौ ।\nमंत्रराजं ददौ ताभ्यां ज्ञानसंहितया सह॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7001497078, "chapter_id": 21497, "verse_number": "७-२-३५-७९", "content_sanskrit": "तौ लब्ध्वा महतीं दिव्यामाज्ञां माहेश्वरीं पराम् ।\nमहार्थं मंत्ररत्नं च तथैव सकलाः कलाः॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7001497079, "chapter_id": 21497, "verse_number": "७-२-३५-८०", "content_sanskrit": "दंडवत्प्रणतिं कृत्वा देवदेवस्य पादयोः ।\nअतिष्ठतां वीतभयावानंदास्तिमितौ तदा॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7001497080, "chapter_id": 21497, "verse_number": "७-२-३५-८१", "content_sanskrit": "एतस्मिन्नंतरे चित्रमिंद्रजालवदैश्वरम् ।\nलिंगं क्वापि तिरोभूतं न ताभ्यामुपलभ्यते॥ ८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7001497081, "chapter_id": 21497, "verse_number": "७-२-३५-८२", "content_sanskrit": "ततो विलप्य हाहेति सद्यःप्रणयभंगतः ।\nकिमसत्यमिदं वृत्तमिति चोक्त्वा परस्परम्॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7001497082, "chapter_id": 21497, "verse_number": "७-२-३५-८३", "content_sanskrit": "अचिंत्यवैभवं शंभोर्विचिंत्य च गतव्यथौ ।\nअभ्युपेत्य परां मैत्रीमालिंग्य च परस्परम्॥ ८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7001497083, "chapter_id": 21497, "verse_number": "७-२-३५-८४", "content_sanskrit": "जगद्व्यापारमुद्दिश्य जग्मतुर्देवपुंगवौ ।\nततः प्रभृति शक्राद्याः सर्व एव सुरासुराः॥ ८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7001497084, "chapter_id": 21497, "verse_number": "७-२-३५-८५", "content_sanskrit": "ऋषयश्च नरा नागा नार्यश्चापि विधानतः ।\nलिंगप्रतिष्ठा कुर्वंति लिंगे तं पूजयंति च॥ ८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}]