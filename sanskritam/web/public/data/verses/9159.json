[{"id": 40013043, "chapter_id": 9159, "verse_number": "1", "content_sanskrit": "मणिं दत्त्वा ततः सीता हनूमन्तमथाब्रवीत्। अभिज्ञानमभिज्ञातमेतद्रामस्य तत्त्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40013044, "chapter_id": 9159, "verse_number": "2", "content_sanskrit": "मणिं तु दृष्ट्वा रामो वै त्रयाणां संस्मरिष्यति। वीरो जनन्या मम च राज्ञो दशरथस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40013045, "chapter_id": 9159, "verse_number": "3", "content_sanskrit": "स भूयस्त्वं समुत्साहे चोदितो हरिसत्तम। अस्मिन्कार्यसमारम्भे प्रचिन्तय यदुत्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40013046, "chapter_id": 9159, "verse_number": "4", "content_sanskrit": "त्वमस्मिन्कार्यनिर्योगे प्रमाणं हरिसत्तम। हनुमन्यत्नमास्थाय दुःखक्षयकरो भव ॥ तस्य चिन्तयतो यत्नो दुःखक्षयकरो भवेत्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40013047, "chapter_id": 9159, "verse_number": "5", "content_sanskrit": "स तथेति प्रतिज्ञाय मारुतिर्भीमविक्रमः ॥ शिरसा वन्ध्य वैदेहीं गमनायोपचक्रमे।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40013048, "chapter_id": 9159, "verse_number": "6", "content_sanskrit": "ज्ञात्वा सम्प्रस्थितं देवी वानरं मारुतात्मजम् ॥ बाष्पगद्गदया वाचा मैथिली वाक्यमब्रवीत्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40013049, "chapter_id": 9159, "verse_number": "7", "content_sanskrit": "कुशलं हनुमन्ब्रूयाः सहितौ रामलक्ष्मणौ ॥ सुग्रीवं च सहामात्यं वृद्धान् सर्वांश्च वानरान्। ब्रूयास्त्वं वानरश्रेष्ठ कुशलं धर्मसंहितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40013050, "chapter_id": 9159, "verse_number": "8", "content_sanskrit": "कुशलं हनुमन्ब्रूयाः सहितौ रामलक्ष्मणौ ॥ सुग्रीवं च सहामात्यं वृद्धान् सर्वांश्च वानरान्। ब्रूयास्त्वं वानरश्रेष्ठ कुशलं धर्मसंहितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40013051, "chapter_id": 9159, "verse_number": "9", "content_sanskrit": "यथा स च महाबाहुर्मां तारयति राघवः। अस्माद्धुःखाम्बुसंरोधात्त्वं समाधातुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40013052, "chapter_id": 9159, "verse_number": "10", "content_sanskrit": "जीवन्तीं मां यथा रामः सम्भावयति कीर्तिमान्। तत्तथा हनुमन्वाच्यं वाचा धर्ममवाप्नुहि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40013053, "chapter_id": 9159, "verse_number": "11", "content_sanskrit": "नित्यमुत्साहयुक्ताश्च वाचश्रुत्वा त्वयेरिताः। वर्धिष्यते दाशरथेः पौरुषं मदवाप्तये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40013054, "chapter_id": 9159, "verse_number": "12", "content_sanskrit": "मत्सन्देशयुता वाचस्त्वत्तश्श्रुत्वा च राघवः। पराक्रमविधिं वीरो विधिवत्संविधास्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40013055, "chapter_id": 9159, "verse_number": "13", "content_sanskrit": "सीताया वचनं श्रुत्वा हनुमान्मारुतात्मजः। शिरस्यञ्जलिमाधाय वाक्यमुत्तरमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40013056, "chapter_id": 9159, "verse_number": "14", "content_sanskrit": "क्षिप्रमेष्यति काकुत्स्थो हार्यृक्षप्रवरैर्वृतः। यस्ते युधि विजित्यारीन्शोकं व्यपनयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40013057, "chapter_id": 9159, "verse_number": "15", "content_sanskrit": "न हि पश्यामि मर्त्येषु नासुरेषु सुरेषु वा। यस्तस्य क्षिपतो बाणान्स्थातुमुत्सहतेऽग्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40013058, "chapter_id": 9159, "verse_number": "16", "content_sanskrit": "अप्यर्कमपि पर्जन्यमपि वैवस्वतं यमम्। स हि सोढुं रणे शक्तस्तव हेतोर्विशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40013059, "chapter_id": 9159, "verse_number": "17", "content_sanskrit": "स हि सागरपर्यन्तां महीं शासितुमीहति। त्वन्निमित्तो हि रामस्य जयो जनकनन्दिनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40013060, "chapter_id": 9159, "verse_number": "18", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा सम्यक्सत्यं सुभाषितम्। जानकी बहुमेनेऽथ वचनं चेदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40013061, "chapter_id": 9159, "verse_number": "19", "content_sanskrit": "ततस्तं प्रस्थितं सीता वीक्षमाणा पुनः पुनः। भर्तृस्नेहान्वितं वाक्यं सौहार्दादनुमानयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40013062, "chapter_id": 9159, "verse_number": "20", "content_sanskrit": "यदि वा मन्यसे वीर वसैकाहमरिन्दम। कस्मिंश्चित्संवृते देशे विश्रान्तःश्वो गमिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40013063, "chapter_id": 9159, "verse_number": "21", "content_sanskrit": "मम चेदल्पभाग्याया सान्निध्यात्तव वानर। अस्य शोकस्य महतो मुहूर्तं मोक्षणं भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40013064, "chapter_id": 9159, "verse_number": "22", "content_sanskrit": "गते हि हरिशार्दूल पुनरागमनाय तु। प्राणानामपि सन्देहो मम स्यान्नात्र संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40013065, "chapter_id": 9159, "verse_number": "23", "content_sanskrit": "तवादर्शनजः शोको भूयो मां परितापयेत्। दुःखाद्धुःखपरामृष्टां दीपयन्निव वानर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40013066, "chapter_id": 9159, "verse_number": "24", "content_sanskrit": "अयं च वीर सन्देहस्तिष्ठतीव ममाग्रतः। सुमहांस्त्वत्सहायेषु हर्यृक्षेषु हरीश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40013067, "chapter_id": 9159, "verse_number": "25", "content_sanskrit": "कथं नु खलु दुष्पारं तरिष्यन्ति महोदधिम्। तानि हर्यृक्षसैन्यानि तौ वा नरवरात्मजौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40013068, "chapter_id": 9159, "verse_number": "26", "content_sanskrit": "त्रयाणामेव भूतानां सागरस्यास्य लङ्घने। शक्तिस्स्याद्वैनतेयस्य तव वा मारुतस्य वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40013069, "chapter_id": 9159, "verse_number": "27", "content_sanskrit": "तदस्मिन्कार्यनिर्योगे वीरैवं दुरतिक्रमे। किं पश्यसि समाधानं त्वं हि कार्यविदां वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40013070, "chapter_id": 9159, "verse_number": "28", "content_sanskrit": "काममस्य त्वमेवैकः कार्यस्य परिसाधने। पर्याप्तः परवीरघ्न यशस्यस्ते फलोदयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40013071, "chapter_id": 9159, "verse_number": "29", "content_sanskrit": "बलैस्समग्रैर्यदि मां रावणं जित्य संयुगे। विजयी स्वपुरं यायात्तत्तस्य सदृशं भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40013072, "chapter_id": 9159, "verse_number": "30", "content_sanskrit": "शरैस्तु सङ्कुलां कृत्वा लङ्कां परबलार्दनः। मां नयेद्यदि काकुत्स्थः तत्तस्य सदृशं भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40013073, "chapter_id": 9159, "verse_number": "31", "content_sanskrit": "तद्यथा तस्य विक्रान्तमनुरूपं महात्मनः। भवेदाहवशूरस्य तथा त्वमुपपादय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40013074, "chapter_id": 9159, "verse_number": "32", "content_sanskrit": "तदर्थोपहितं वाक्यं प्रश्रितं हेतुसंहितम्। निशम्य हनुमान्शेषं वाक्यमुत्तरमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40013075, "chapter_id": 9159, "verse_number": "33", "content_sanskrit": "देवि हर्यृक्षसैन्यानामीश्वरः प्लवतां वरः। सुग्रीवस्सत्त्वसम्पन्नस्तवार्थे कृतनिश्चयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40013076, "chapter_id": 9159, "verse_number": "34", "content_sanskrit": "स वानरसहस्राणां कोटीभिरभिसंवृतः। क्षिप्रमेष्यति वैदेहि राक्षसानां निबर्हणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40013077, "chapter_id": 9159, "verse_number": "35", "content_sanskrit": "तस्य विक्रमसम्पन्नास्सत्त्ववन्तो महाबलाः। मनस्सङ्कल्पसम्पाता निदेशे हरयः स्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 40013078, "chapter_id": 9159, "verse_number": "36", "content_sanskrit": "येषां नोपरि नाधस्तान्न तिर्यक्सज्जते गतिः। न च कर्मसु सीदन्ति महत्स्वमिततेजसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 40013079, "chapter_id": 9159, "verse_number": "37", "content_sanskrit": "असकृत्तैर्महोत्साहैस्ससागरधराधरा। प्रदक्षिणीकृता भूमिर्वायुमार्गानुसारिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 40013080, "chapter_id": 9159, "verse_number": "38", "content_sanskrit": "मद्विशिष्टाश्च तुल्याश्च सन्ति तत्र वनौकसः। मत्तः प्रत्यवरः कश्चिन्नास्ति सुग्रीवसन्निधौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 40013081, "chapter_id": 9159, "verse_number": "39", "content_sanskrit": "अहं तावदिह प्राप्तः किं पुनस्ते महाबलाः। न हि प्रकृष्टाः प्रेष्यन्ते प्रेष्यन्ते हीतरे जनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 40013082, "chapter_id": 9159, "verse_number": "40", "content_sanskrit": "तदलं परितापेन देवि शोको व्यपैतु ते। एकोत्पातेन ते लङ्कामेष्यन्ति हरियूथपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 40013083, "chapter_id": 9159, "verse_number": "41", "content_sanskrit": "मम पृष्ठगतौ तौ च चन्द्रसूर्याविवोदितौ। त्वत्सकाशं महासत्त्वौ नृसिंहावागमिष्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 40013084, "chapter_id": 9159, "verse_number": "42", "content_sanskrit": "ततो वीरौ नरवरौ सहितौ रामलक्ष्मणौ। आगम्य नगरीं लङ्कां सायकैर्विधमिष्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 40013085, "chapter_id": 9159, "verse_number": "43", "content_sanskrit": "सगणं रावणं हत्त्वा राघवो रघुनन्दनः। त्वामादाय वरारोहे स्वपुरीं प्रतियास्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 40013086, "chapter_id": 9159, "verse_number": "44", "content_sanskrit": "तदाश्वसिहि भद्रं ते भव त्वं कालकाङ्क्षिणी। नचिराद्द्रक्ष्यसे रामं प्रज्वलन्तमिवानलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 40013087, "chapter_id": 9159, "verse_number": "45", "content_sanskrit": "निहते राक्षसेन्द्रेऽस्मिन्सपुत्रामात्यबान्धवे। त्वं समेष्वसि रामेण शशाङ्केनेव रोहिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 40013088, "chapter_id": 9159, "verse_number": "46", "content_sanskrit": "क्षिप्रं त्वं देवि शोकस्य पारं यास्यसि मैथिलि। रावणं चैव रामेण निहतं द्रक्ष्यसेऽचिरात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 40013089, "chapter_id": 9159, "verse_number": "47", "content_sanskrit": "एवमाश्वास्य वैदेहीं हनुमान्मारुतात्मजः। गमनाय मतिं कृत्वा वैदेहीं पुनरब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 40013090, "chapter_id": 9159, "verse_number": "48", "content_sanskrit": "तमरिघ्नं कृतात्मानं क्षिप्रं द्रक्ष्यसि राघवम्। लक्ष्मणं च धनुष्पाणिं लङ्काद्वारमुपागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 40013091, "chapter_id": 9159, "verse_number": "49", "content_sanskrit": "नखदंष्ट्रायुधान्वीरान्सिम्हशार्दूलविक्रमान्। वानरान्वारणेन्द्राभान्क्षिप्रं द्रक्ष्यसि सङ्गतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 40013092, "chapter_id": 9159, "verse_number": "50", "content_sanskrit": "शैलाम्बुदनिकाशानां लङ्कामलयसानुषु। नर्दतां कपिमुख्यानामार्ये यूधान्यनेकशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 40013093, "chapter_id": 9159, "verse_number": "51", "content_sanskrit": "स तु मर्मणि घोरेण ताडितो मन्मथेषुणा। न शर्म लभते रामस्सिंहार्धित इव द्विपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 40013094, "chapter_id": 9159, "verse_number": "52", "content_sanskrit": "मा रुदो देवि शोकेन माभूत्ते मनसोऽप्रियम्। शचीव पत्या शक्रेण भर्त्रा नाथवती ह्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 40013095, "chapter_id": 9159, "verse_number": "53", "content_sanskrit": "रामाद्विशिष्टः कोऽन्योऽस्ति कश्चित्सौमित्रिणा समः। अग्निमारुतकल्पौ तौ भ्रातरौ तव संश्रयौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 40013096, "chapter_id": 9159, "verse_number": "54", "content_sanskrit": "नास्मिंश्चिरं वत्स्यसि देवि देशे रक्षोगणैरध्युषितेऽतिरौद्रे। न ते चिरादामगमनं प्रियस्य क्षमस्व मत्सङ्गमकालमात्रम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]