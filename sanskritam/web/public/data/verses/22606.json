[{"id": 7002606000, "chapter_id": 22606, "verse_number": "४-११-१", "content_sanskrit": "सूत उवाच ।\nशतहस्तमितां मुष्टिं नानातरुविभूषिताम् ।\nपूगाम्रादिफलैर्युक्तं वास्तुं कृत्वा यजेत्तु यः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002606001, "chapter_id": 22606, "verse_number": "४-११-२", "content_sanskrit": "षष्टिवर्षसहस्राणि स्वर्गलोके वसेच्चिरम् ।\nतद्विधानं प्रवक्ष्यामि यथाशास्त्रानुसारतः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002606002, "chapter_id": 22606, "verse_number": "४-११-३", "content_sanskrit": "नित्यं निर्वर्त्य विधिवत्पंच विप्रान्समर्चयेत् ।\nभोजयेत्पूजयेद्विष्णुं प्रजापतिसमन्वितम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002606003, "chapter_id": 22606, "verse_number": "४-११-४", "content_sanskrit": "अग्निकार्यं ततः कृत्वा दद्याद्विप्राय दक्षिणाम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}]