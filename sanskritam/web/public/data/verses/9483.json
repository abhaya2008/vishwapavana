[{"id": 5000483000, "chapter_id": 9483, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे षट्सप्ततितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000483001, "chapter_id": 9483, "verse_number": "६-७६-१", "content_sanskrit": "प्रवृत्ते संकुले तस्मिन् घोरे वीरजनक्षये।\nअङ्गदः कम्पनं वीरमाससाद रणोत्सुकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000483002, "chapter_id": 9483, "verse_number": "६-७६-२", "content_sanskrit": "आहूय सोऽङ्गदं कोपात् ताडयामास वेगितः।\nगदया कम्पनः पूर्वं स चचाल भृशाहतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000483003, "chapter_id": 9483, "verse_number": "६-७६-३", "content_sanskrit": "स संज्ञां प्राप्य तेजस्वी चिक्षेप शिखरं गिरेः।\nअर्दितश्च प्रहारेण कम्पनः पतितो भुवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000483004, "chapter_id": 9483, "verse_number": "६-७६-४", "content_sanskrit": "ततस्तु कम्पनं दृष्ट्वा शोणिताक्षो हतं रणे।\nरथेनाभ्यपतत् क्षिप्रं तत्राङ्गदमभीतवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000483005, "chapter_id": 9483, "verse_number": "६-७६-५", "content_sanskrit": "सोऽङ्गदं निशितैर्बाणैस्तदा विव्याध वेगितः।\nशरीरदारणैस्तीक्ष्णैः कालाग्निसमविग्रहैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000483006, "chapter_id": 9483, "verse_number": "६-७६-६", "content_sanskrit": "क्षुरक्षुरप्रनाराचैर्वत्सदन्तैः शिलीमुखैः।\nकर्णिशल्यविपाठैश्च बहुभिर्निशितैः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000483007, "chapter_id": 9483, "verse_number": "६-७६-७", "content_sanskrit": "अङ्गदः प्रतिविद्धाङ्गो वालिपुत्रः प्रतापवान्।\nधनुरुग्रं रथं बाणान् ममर्द तरसा बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000483008, "chapter_id": 9483, "verse_number": "६-७६-८", "content_sanskrit": "शोणिताक्षस्ततः क्षिप्रमसिचर्म समाददे।\nउत्पपात तदा क्रुद्धो वेगवानविचारयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000483009, "chapter_id": 9483, "verse_number": "६-७६-९", "content_sanskrit": "तं क्षिप्रतरमाप्लुत्य परामृश्याङ्गदो बली।\nकरेण तस्य तं खड्गं समाच्छिद्य ननाद च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000483010, "chapter_id": 9483, "verse_number": "६-७६-१०", "content_sanskrit": "तस्यांसफलके खड्गं निजघान ततोऽङ्गदः।\nयज्ञोपवीतवच्चैनं चिच्छेद कपिकुञ्जरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000483011, "chapter_id": 9483, "verse_number": "६-७६-११", "content_sanskrit": "तं प्रगृह्य महाखड्गं विनद्य च पुनः पुनः।\nवालिपुत्रोऽभिदुद्राव रणशीर्षे परानरीन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000483012, "chapter_id": 9483, "verse_number": "६-७६-१२", "content_sanskrit": "प्रजङ्घसहितो वीरो यूपाक्षस्तु ततो बली।\nरथेनाभिययौ क्रुद्धो वालिपुत्रं महाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000483013, "chapter_id": 9483, "verse_number": "६-७६-१३", "content_sanskrit": "आयसीं तु गदां गृह्य स वीरः कनकाङ्गदः।\nशोणिताक्षः समाश्वस्य तमेवानुपपात ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000483014, "chapter_id": 9483, "verse_number": "६-७६-१४", "content_sanskrit": "प्रजङ्घस्तु महावीरो यूपाक्षसहितो बली।\nगदयाभिययौ क्रुद्धो वालिपुत्रं महाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000483015, "chapter_id": 9483, "verse_number": "६-७६-१५", "content_sanskrit": "तयोर्मध्ये कपिश्रेष्ठः शोणिताक्षप्रजङ्घयोः।\nविशाखयोर्मध्यगतः पूर्णचन्द्र इवाबभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000483016, "chapter_id": 9483, "verse_number": "६-७६-१६", "content_sanskrit": "अङ्गदं परिरक्षन्तौ मैन्दो द्विविद एव च।\nतस्य तस्थतुरभ्याशे परस्परदिदृक्षया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000483017, "chapter_id": 9483, "verse_number": "६-७६-१७", "content_sanskrit": "अभिपेतुर्महाकायाः प्रतियत्ता महाबलाः।\nराक्षसा वानरान् रोषादसिबाणगदाधराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000483018, "chapter_id": 9483, "verse_number": "६-७६-१८", "content_sanskrit": "त्रयाणां वानरेन्द्राणां त्रिभी राक्षसपुंगवैः।\nसंसक्तानां महद् युद्धमभवद् रोमहर्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000483019, "chapter_id": 9483, "verse_number": "६-७६-१९", "content_sanskrit": "ते तु वृक्षान् समादाय सम्प्रचिक्षिपुराहवे।\nखड्गेन प्रतिचिक्षेप तान् प्रजङ्घो महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000483020, "chapter_id": 9483, "verse_number": "६-७६-२०", "content_sanskrit": "रथानश्वान् द्रुमाञ्छैलान् प्रतिचिक्षिपुराहवे।\nशरौघैः प्रतिचिच्छेद तान् यूपाक्षो महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000483021, "chapter_id": 9483, "verse_number": "६-७६-२१", "content_sanskrit": "सृष्टान् द्विविदमैन्दाभ्यां द्रुमानुत्पाट्य वीर्यवान्।\nबभञ्ज गदया मध्ये शोणिताक्षः प्रतापवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000483022, "chapter_id": 9483, "verse_number": "६-७६-२२", "content_sanskrit": "उद्यम्य विपुलं खड्गं परमर्मविदारणम्।\nप्रजङ्घो वालिपुत्राय अभिदुद्राव वेगितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000483023, "chapter_id": 9483, "verse_number": "६-७६-२३", "content_sanskrit": "तमभ्याशगतं दृष्ट्वा वानरेन्द्रो महाबलः।\nआजघानाश्वकर्णेन द्रुमेणातिबलस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000483024, "chapter_id": 9483, "verse_number": "६-७६-२४", "content_sanskrit": "बाहुं चास्य सनिस्त्रिंशमाजघान स मुष्टिना।\nवालिपुत्रस्य घातेन स पपात क्षितावसिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000483025, "chapter_id": 9483, "verse_number": "६-७६-२५", "content_sanskrit": "तं दृष्ट्वा पतितं भूमौ खड्गं मुसलसंनिभम्।\nमुष्टिं संवर्तयामास वज्रकल्पं महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000483026, "chapter_id": 9483, "verse_number": "६-७६-२६", "content_sanskrit": "स ललाटे महावीर्यमङ्गदं वानरर्षभम्।\nआजघान महातेजाः स मुहूर्तं चचाल ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000483027, "chapter_id": 9483, "verse_number": "६-७६-२७", "content_sanskrit": "स संज्ञां प्राप्य तेजस्वी वालिपुत्रः प्रतापवान्।\nप्रजङ्घस्य शिरः कायात् पातयामास मुष्टिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000483028, "chapter_id": 9483, "verse_number": "६-७६-२८", "content_sanskrit": "स यूपाक्षोऽश्रुपूर्णाक्षः पितृव्ये निहते रणे।\nअवरुह्य रथात् क्षिप्रं क्षीणेषुः खड्गमाददे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000483029, "chapter_id": 9483, "verse_number": "६-७६-२९", "content_sanskrit": "तमापतन्तं सम्प्रेक्ष्य यूपाक्षं द्विविदस्त्वरन्।\nआजघानोरसि क्रुद्धो जग्राह च बलाद् बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000483030, "chapter_id": 9483, "verse_number": "६-७६-३०", "content_sanskrit": "गृहीतं भ्रातरं दृष्ट्वा शोणिताक्षो महाबलः।\nआजघान महातेजा वक्षसि द्विविदं ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000483031, "chapter_id": 9483, "verse_number": "६-७६-३१", "content_sanskrit": "स ततोऽभिहतस्तेन चचाल च महाबलः।\nउद्यतां च पुनस्तस्य जहार द्विविदो गदाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000483032, "chapter_id": 9483, "verse_number": "६-७६-३२", "content_sanskrit": "एतस्मिन्नन्तरे मैन्दो द्विविदाभ्याशमागमत्।\nयूपाक्षं ताडयामास तलेनोरसि वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000483033, "chapter_id": 9483, "verse_number": "६-७६-३३", "content_sanskrit": "तौ शोणिताक्षयूपाक्षौ प्लवंगाभ्यां तरस्विनौ।\nचक्रतुः समरे तीव्रमाकर्षोत्पाटनं भृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000483034, "chapter_id": 9483, "verse_number": "६-७६-३४", "content_sanskrit": "द्विविदः शोणिताक्षं तु विददार नखैर्मुखे।\nनिष्पिपेष स वीर्येण क्षितावाविध्य वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000483035, "chapter_id": 9483, "verse_number": "६-७६-३५", "content_sanskrit": "यूपाक्षमभिसंक्रुद्धो मैन्दो वानरपुङ्गवः।\nपीडयामास बाहुभ्यां पपात स हतः क्षितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000483036, "chapter_id": 9483, "verse_number": "६-७६-३६", "content_sanskrit": "हतप्रवीरा व्यथिता राक्षसेन्द्रचमूस्तथा।\nजगामाभिमुखी सा तु कुम्भकर्णात्मजो यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000483037, "chapter_id": 9483, "verse_number": "६-७६-३७", "content_sanskrit": "आपतन्तीं च वेगेन कुम्भस्तां सान्त्वयच्चमूम्।\nअथोत्कृष्टं महावीर्यैर्लब्धलक्षैः प्लवंगमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000483038, "chapter_id": 9483, "verse_number": "६-७६-३८", "content_sanskrit": "निपातितमहावीरां दृष्ट्वा रक्षश्चमूं तदा।\nकुम्भः प्रचक्रे तेजस्वी रणे कर्म सुदुष्करम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000483039, "chapter_id": 9483, "verse_number": "६-७६-३९", "content_sanskrit": "स धनुर्धन्विनां श्रेष्ठः प्रगृह्य सुसमाहितः।\nमुमोचाशीविषप्रख्याञ्छरान् देहविदारणान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000483040, "chapter_id": 9483, "verse_number": "६-७६-४०", "content_sanskrit": "तस्य तच्छुशुभे भूयः सशरं धनुरुत्तमम्।\nविद्युदैरावतार्चिष्मद‍‍्द्वितीयेन्द्रधनुर्यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000483041, "chapter_id": 9483, "verse_number": "६-७६-४१", "content_sanskrit": "आकर्णकृष्टमुक्तेन जघान द्विविदं तदा।\nतेन हाटकपुङ्खेन पत्रिणा पत्रवाससा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000483042, "chapter_id": 9483, "verse_number": "६-७६-४२", "content_sanskrit": "सहसाभिहतस्तेन विप्रमुक्तपदः स्फुरन्।\nनिपपात त्रिकूटाभो विह्वलन् प्लवगोत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000483043, "chapter_id": 9483, "verse_number": "६-७६-४३", "content_sanskrit": "मैन्दस्तु भ्रातरं तत्र भग्नं दृष्ट्वा महाहवे।\nअभिदुद्राव वेगेन प्रगृह्य विपुलां शिलाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000483044, "chapter_id": 9483, "verse_number": "६-७६-४४", "content_sanskrit": "तां शिलां तु प्रचिक्षेप राक्षसाय महाबलः।\nबिभेद तां शिलां कुम्भः प्रसन्नैः पञ्चभिः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000483045, "chapter_id": 9483, "verse_number": "६-७६-४५", "content_sanskrit": "संधाय चान्यं सुमुखं शरमाशीविषोपमम्।\nआजघान महातेजा वक्षसि द्विविदाग्रजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000483046, "chapter_id": 9483, "verse_number": "६-७६-४६", "content_sanskrit": "स तु तेन प्रहारेण मैन्दो वानरयूथपः।\nमर्मण्यभिहतस्तेन पपात भुवि मूर्च्छितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000483047, "chapter_id": 9483, "verse_number": "६-७६-४७", "content_sanskrit": "अङ्गदो मातुलौ दृष्ट्वा मथितौ तु महाबलौ।\nअभिदुद्राव वेगेन कुम्भमुद्यतकार्मुकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000483048, "chapter_id": 9483, "verse_number": "६-७६-४८", "content_sanskrit": "तमापतन्तं विव्याध कुम्भः पञ्चभिरायसैः।\nत्रिभिश्चान्यैः शितैर्बाणैर्मातंगमिव तोमरैः।\nसोऽङ्गदं बहुभिर्बाणैः कुम्भो विव्याध वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000483049, "chapter_id": 9483, "verse_number": "६-७६-४९", "content_sanskrit": "अकुण्ठधारैर्निशितैस्तीक्ष्णैः कनकभूषणैः।\nअङ्गदः प्रतिविद्धाङ्गो वालिपुत्रो न कम्पते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000483050, "chapter_id": 9483, "verse_number": "६-७६-५०", "content_sanskrit": "शिलापादपवर्षाणि तस्य मूर्ध्नि ववर्ष ह।\nस प्रचिच्छेद तान् सर्वान् बिभेद च पुनः शिलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000483051, "chapter_id": 9483, "verse_number": "६-७६-५१", "content_sanskrit": "कुम्भकर्णात्मजः श्रीमान् वालिपुत्रसमीरितान्।\nआपतन्तं च सम्प्रेक्ष्य कुम्भो वानरयूथपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000483052, "chapter_id": 9483, "verse_number": "६-७६-५२", "content_sanskrit": "भ्रुवौ विव्याध बाणाभ्यामुल्काभ्यामिव कुञ्जरम्।\nतस्य सुस्राव रुधिरं पिहिते चास्य लोचने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000483053, "chapter_id": 9483, "verse_number": "६-७६-५३", "content_sanskrit": "अङ्गदः पाणिना नेत्रे पिधाय रुधिरोक्षिते।\nसालमासन्नमेकेन परिजग्राह पाणिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000483054, "chapter_id": 9483, "verse_number": "६-७६-५४", "content_sanskrit": "सम्पीड्योरसि सस्कन्धं करेणाभिनिवेश्य च।\nकिंचिदभ्यवनम्यैनमुन्ममाथ महारणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000483055, "chapter_id": 9483, "verse_number": "६-७६-५५", "content_sanskrit": "तमिन्द्रकेतुप्रतिमं वृक्षं मन्दरसंनिभम्।\nसमुत्सृजत वेगेन मिषतां सर्वरक्षसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 5000483056, "chapter_id": 9483, "verse_number": "६-७६-५६", "content_sanskrit": "स चिच्छेद शितैर्बाणैः सप्तभिः कायभेदनैः।\nअङ्गदो विव्यथेऽभीक्ष्णं स पपात मुमोह च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 5000483057, "chapter_id": 9483, "verse_number": "६-७६-५७", "content_sanskrit": "अङ्गदं पतितं दृष्ट्वा सीदन्तमिव सागरे।\nदुरासदं हरिश्रेष्ठा राघवाय न्यवेदयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 5000483058, "chapter_id": 9483, "verse_number": "६-७६-५८", "content_sanskrit": "रामस्तु व्यथितं श्रुत्वा वालिपुत्रं महाहवे।\nव्यादिदेश हरिश्रेष्ठाञ्जाम्बवत्प्रमुखांस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 5000483059, "chapter_id": 9483, "verse_number": "६-७६-५९", "content_sanskrit": "ते तु वानरशार्दूलाः श्रुत्वा रामस्य शासनम्।\nअभिपेतुः सुसंक्रुद्धाः कुम्भमुद्यतकार्मुकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 5000483060, "chapter_id": 9483, "verse_number": "६-७६-६०", "content_sanskrit": "ततो द्रुमशिलाहस्ताः कोपसंरक्तलोचनाः।\nरिरक्षिषन्तोऽभ्यपतन्नङ्गदं वानरर्षभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 5000483061, "chapter_id": 9483, "verse_number": "६-७६-६१", "content_sanskrit": "जाम्बवांश्च सुषेणश्च वेगदर्शी च वानरः।\nकुम्भकर्णात्मजं वीरं क्रुद्धाः समभिदुद्रुवुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 5000483062, "chapter_id": 9483, "verse_number": "६-७६-६२", "content_sanskrit": "समीक्ष्यापततस्तांस्तु वानरेन्द्रान् महाबलान्।\nआववार शरौघेण नगेनेव जलाशयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 5000483063, "chapter_id": 9483, "verse_number": "६-७६-६३", "content_sanskrit": "तस्य बाणपथं प्राप्य न शेकुरपि वीक्षितुम्।\nवानरेन्द्रा महात्मानो वेलामिव महोदधिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 5000483064, "chapter_id": 9483, "verse_number": "६-७६-६४", "content_sanskrit": "तांस्तु दृष्ट्वा हरिगणान् शरवृष्टिभिरर्दितान्।\nअङ्गदं पृष्ठतः कृत्वा भ्रातृजं प्लवगेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 5000483065, "chapter_id": 9483, "verse_number": "६-७६-६५", "content_sanskrit": "अभिदुद्राव सुग्रीवः कुम्भकर्णात्मजं रणे।\nशैलसानुचरं नागं वेगवानिव केसरी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 5000483066, "chapter_id": 9483, "verse_number": "६-७६-६६", "content_sanskrit": "उत्पाट्य च महावृक्षानश्वकर्णादिकान् बहून्।\nअन्यांश्च विविधान् वृक्षांश्चिक्षेप स महाकपिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 5000483067, "chapter_id": 9483, "verse_number": "६-७६-६७", "content_sanskrit": "तां छादयन्तीमाकाशं वृक्षवृष्टिं दुरासदाम्।\nकुम्भकर्णात्मजः श्रीमांश्चिच्छेद स्वशरैः शितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 5000483068, "chapter_id": 9483, "verse_number": "६-७६-६८", "content_sanskrit": "अभिलक्ष्येण तीव्रेण कुम्भेन निशितैः शरैः।\nआचितास्ते द्रुमा रेजुर्यथा घोराः शतघ्नयः।\nद्रुमवर्षं तु तद् भिन्नं दृष्ट्वा कुम्भेन वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 5000483069, "chapter_id": 9483, "verse_number": "६-७६-६९", "content_sanskrit": "वानराधिपतिः श्रीमान् महासत्त्वो न विव्यथे।\nस विध्यमानः सहसा सहमानस्तु ताञ्छरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 5000483070, "chapter_id": 9483, "verse_number": "६-७६-७०", "content_sanskrit": "कुम्भस्य धनुराक्षिप्य बभञ्जेन्द्रधनुःप्रभम्।\nअवप्लुत्य ततः शीघ्रं कृत्वा कर्म सुदुष्करम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 5000483071, "chapter_id": 9483, "verse_number": "६-७६-७१", "content_sanskrit": "अब्रवीत् कुपितः कुम्भं भग्नशृङ्गमिव द्विपम्।\nनिकुम्भाग्रज वीर्यं ते बाणवेगं तदद्भुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 5000483072, "chapter_id": 9483, "verse_number": "६-७६-७२", "content_sanskrit": "संनतिश्च प्रभावश्च तव वा रावणस्य वा।\nप्रह्लादबलिवृत्रघ्नकुबेरवरुणोपम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 5000483073, "chapter_id": 9483, "verse_number": "६-७६-७३", "content_sanskrit": "एकस्त्वमनुजातोऽसि पितरं बलवत्तरम्।\nत्वामेवैकं महाबाहुं शूलहस्तमरिंदमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 5000483074, "chapter_id": 9483, "verse_number": "६-७६-७४", "content_sanskrit": "त्रिदशा नातिवर्तन्ते जितेन्द्रियमिवाधयः।\nविक्रमस्व महाबुद्धे कर्माणि मम पश्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 5000483075, "chapter_id": 9483, "verse_number": "६-७६-७५", "content_sanskrit": "वरदानात् पितृव्यस्ते सहते देवदानवान्।\nकुम्भकर्णस्तु वीर्येण सहते च सुरासुरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 5000483076, "chapter_id": 9483, "verse_number": "६-७६-७६", "content_sanskrit": "धनुषीन्द्रजितस्तुल्यः प्रतापे रावणस्य च।\nत्वमद्य रक्षसां लोके श्रेष्ठोऽसि बलवीर्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 5000483077, "chapter_id": 9483, "verse_number": "६-७६-७७", "content_sanskrit": "महाविमर्दं समरे मया सह तवाद्भुतम्।\nअद्य भूतानि पश्यन्तु शक्रशम्बरयोरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 5000483078, "chapter_id": 9483, "verse_number": "६-७६-७८", "content_sanskrit": "कृतमप्रतिमं कर्म दर्शितं चास्त्रकौशलम्।\nपतिता हरिवीराश्च त्वयैते भीमविक्रमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 5000483079, "chapter_id": 9483, "verse_number": "६-७६-७९", "content_sanskrit": "उपालम्भभयाच्चैव नासि वीर मया हतः।\nकृतकर्मपरिश्रान्तो विश्रान्तः पश्य मे बलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 5000483080, "chapter_id": 9483, "verse_number": "६-७६-८०", "content_sanskrit": "तेन सुग्रीववाक्येन सावमानेन मानितः।\nअग्नेराज्यहुतस्येव तेजस्तस्याभ्यवर्धत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 5000483081, "chapter_id": 9483, "verse_number": "६-७६-८१", "content_sanskrit": "ततः कुम्भस्तु सुग्रीवं बाहुभ्यां जगृहे तदा।\nगजाविवातीतमदौ निःश्वसन्तौ मुहुर्मुहुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 5000483082, "chapter_id": 9483, "verse_number": "६-७६-८२", "content_sanskrit": "अन्योन्यगात्रग्रथितौ घर्षन्तावितरेतरम्।\nसधूमां मुखतो ज्वालां विसृजन्तौ परिश्रमात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 5000483083, "chapter_id": 9483, "verse_number": "६-७६-८३", "content_sanskrit": "तयोः पादाभिघाताच्च निमग्ना चाभवन्मही।\nव्याघूर्णिततरङ्गश्च चुक्षुभे वरुणालयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 5000483084, "chapter_id": 9483, "verse_number": "६-७६-८४", "content_sanskrit": "ततः कुम्भं समुत्क्षिप्य सुग्रीवो लवणाम्भसि।\nपातयामास वेगेन दर्शयन्नुदधेस्तलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 5000483085, "chapter_id": 9483, "verse_number": "६-७६-८५", "content_sanskrit": "ततः कुम्भनिपातेन जलराशिः समुत्थितः।\nविन्ध्यमन्दरसंकाशो विससर्प समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 5000483086, "chapter_id": 9483, "verse_number": "६-७६-८६", "content_sanskrit": "ततः कुम्भः समुत्पत्य सुग्रीवमभिपात्य च।\nआजघानोरसि क्रुद्धो वज्रकल्पेन मुष्टिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 5000483087, "chapter_id": 9483, "verse_number": "६-७६-८७", "content_sanskrit": "तस्य वर्म च पुस्फोट संजज्ञे चापि शोणितम्।\nतस्य मुष्टिर्महावेगः प्रतिजघ्नेऽस्थिमण्डले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 5000483088, "chapter_id": 9483, "verse_number": "६-७६-८८", "content_sanskrit": "तस्य वेगेन तत्रासीत् तेजः प्रज्वलितं महत्।\nवज्रनिष्पेषसंजाता ज्वाला मेरोर्यथा गिरेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 5000483089, "chapter_id": 9483, "verse_number": "६-७६-८९", "content_sanskrit": "स तत्राभिहतस्तेन सुग्रीवो वानरर्षभः।\nमुष्टिं संवर्तयामास वज्रकल्पं महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 5000483090, "chapter_id": 9483, "verse_number": "६-७६-९०", "content_sanskrit": "अर्चिःसहस्रविकचरविमण्डलवर्चसम्।\nस मुष्टिं पातयामास कुम्भस्योरसि वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 5000483091, "chapter_id": 9483, "verse_number": "६-७६-९१", "content_sanskrit": "स तु तेन प्रहारेण विह्वलो भृशपीडितः।\nनिपपात तदा कुम्भो गतार्चिरिव पावकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 5000483092, "chapter_id": 9483, "verse_number": "६-७६-९२", "content_sanskrit": "मुष्टिनाभिहतस्तेन निपपाताशु राक्षसः।\nलोहिताङ्ग इवाकाशाद् दीप्तरश्मिर्यदृच्छया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 5000483093, "chapter_id": 9483, "verse_number": "६-७६-९३", "content_sanskrit": "कुम्भस्य पततो रूपं भग्नस्योरसि मुष्टिना।\nबभौ रुद्राभिपन्नस्य यथा रूपं गवां पतेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 5000483094, "chapter_id": 9483, "verse_number": "६-७६-९४", "content_sanskrit": "तस्मिन् हते भीमपराक्रमेण\nप्लवंगमानामृषभेण युद्धे।\nमही सशैला सवना चचाल\nभयं च रक्षांस्यधिकं विवेश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 5000483095, "chapter_id": 9483, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे षट्सप्ततितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}]