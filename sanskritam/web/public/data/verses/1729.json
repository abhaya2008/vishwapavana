[{"id": 2033772, "chapter_id": 1729, "verse_number": "४-५२-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2033773, "chapter_id": 1729, "verse_number": "४-५२-१", "content_sanskrit": "कलाः काष्ठाश्च युज्यन्ते मुहूर्ताश्च दिनानि च।\nअर्धमासाश्च मासाश्च नक्षत्राणि ग्रहास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2033774, "chapter_id": 1729, "verse_number": "४-५२-२", "content_sanskrit": "ऋतवश्चापि युज्यन्ते तथा संवत्सरा अपि।\nएवं कालविभागेन कालचक्रं प्रवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2033775, "chapter_id": 1729, "verse_number": "४-५२-३", "content_sanskrit": "तेषां कालातिरेकेण ज्योतिषां च व्यतिक्रमात्।\nपञ्चमे पञ्चमे वर्षे द्वौ मासावधिमासकौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2033776, "chapter_id": 1729, "verse_number": "४-५२-४", "content_sanskrit": "एषामभ्यधिका मासाः पञ्च च द्वादश क्षपाः ।\nत्रयोदशानां वर्षाणामिति मे वर्तते मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2033777, "chapter_id": 1729, "verse_number": "४-५२-५", "content_sanskrit": "पूर्वेद्युरेव निर्वृत्तस्ततो बीभत्सुरागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2033778, "chapter_id": 1729, "verse_number": "४-५२-६", "content_sanskrit": "सर्वं यथावच्चरितं यद्यदेभिः प्रतिश्रुतम्।\nएवमेतद्भ्रुवं ज्ञात्वा ततो बीभत्सुरागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2033779, "chapter_id": 1729, "verse_number": "४-५२-७", "content_sanskrit": "सर्वे पञ्च महात्मानः सर्वे धर्मार्थकोविदाः।\nयेषां युधिष्ठिरो राजा कस्माद्धर्मेऽपराध्नुयुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2033780, "chapter_id": 1729, "verse_number": "४-५२-८", "content_sanskrit": "कामात्क्रोधाच्च लोभाच्च कामक्रोधभयादपि ।\nस्नेहाद्वा यदि वा मोहाद्धर्मं नात्येति धर्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2033781, "chapter_id": 1729, "verse_number": "४-५२-९", "content_sanskrit": "अलुब्धाश्चैव कौन्तेयाः कृतवन्तश्च दुष्करम्।\nन चापि केवलं राज्यमिच्छेयुस्ते ह्यधर्मतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2033782, "chapter_id": 1729, "verse_number": "४-५२-१०", "content_sanskrit": "तदैव ते हि विक्रान्तुमीषुः कौरवनन्दनाः ।\nधर्मपाशनिबद्धास्तु न चेलुः क्षत्रियव्रतात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2033783, "chapter_id": 1729, "verse_number": "४-५२-११", "content_sanskrit": "यश्चानृत इति ख्यातः स च गच्छेत्पराभवम् ।\nवृणुयुर्माणं पार्था नानृतत्वं कथंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2033784, "chapter_id": 1729, "verse_number": "४-५२-१२", "content_sanskrit": "प्राप्ते तु काले स्वानर्थान्नोत्सृजेयुर्नरर्षभाः ।\nअपि वज्रभृता गुप्तांस्तथावीर्या हि पाण्डवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2033785, "chapter_id": 1729, "verse_number": "४-५२-१३", "content_sanskrit": "प्रतियुद्ध्येम समरे सर्वशस्त्रभृतांवरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2033786, "chapter_id": 1729, "verse_number": "४-५२-१४", "content_sanskrit": "तस्माद्यदत्र कल्याणं लोके सद्भिरनुष्ठितम्।\nतत्संविधीयतां शीघ्रं मा वो ह्यर्थोऽभ्यगात्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2033787, "chapter_id": 1729, "verse_number": "४-५२-१५", "content_sanskrit": "न हि पश्यामि संग्रामे कदाचिदपि कौरव ।\nएकान्तसिद्धिं राजेन्द्र संप्राप्तश्च धनञ्जयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2033788, "chapter_id": 1729, "verse_number": "४-५२-१६", "content_sanskrit": "संप्रवृत्ते तु संग्रामे भावाभावौ जयाजयौ ।\nअवश्यमेकं स्पृशतो दृष्टमेतदसंशयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2033789, "chapter_id": 1729, "verse_number": "४-५२-१७", "content_sanskrit": "तस्माद्युद्धोपचरितं कर्म वा धर्मसंहितम् ।\nक्रियतामाशु राजेन्द्र संप्राप्तश्च धनञ्जयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2033790, "chapter_id": 1729, "verse_number": "४-५२-१८", "content_sanskrit": "एको हि समरे पार्थः पृथिवीं निर्दहेच्छरैः ।\nभ्रातृभिः सहितो भूत्वा किं पुनः कौरवान्रणे ।\nतस्मात्सन्धिं कुरुश्रेष्ठ कुरुष्व यदि मन्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2033791, "chapter_id": 1729, "verse_number": "४-५२-१९x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2033792, "chapter_id": 1729, "verse_number": "४-५२-१९", "content_sanskrit": "नाहं राज्यं प्रदास्यामि पाण्डवेभ्यः पितामह।\nग्रामं सेनां च दासांश्च स्वल्पं द्रव्यमपि प्रभो ।\nयुद्धोपचारिकं यत्तु तत्सर्वं संविधीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2033793, "chapter_id": 1729, "verse_number": "४-५२-२०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2033794, "chapter_id": 1729, "verse_number": "४-५२-२०", "content_sanskrit": "भीष्मस्योपरते वाक्ये तथा दुर्योधनस्य च।\nप्राप्तमर्थ्यं च यद्वाक्यं द्रोणश्वाह द्विजोत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2033795, "chapter_id": 1729, "verse_number": "४-५२-२१", "content_sanskrit": "यत्तु युद्धोपचरितं भवेद्वा धर्मसंहितम्।\nकस्त्वया सदृशो लोके भूयस्त्वं वक्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2033796, "chapter_id": 1729, "verse_number": "४-५२-२२", "content_sanskrit": "अत्र या मामिका बुद्धिः श्रूयतां यदि रोचते ।\nसर्वथा हि मया श्रेयो वक्तव्यं कुरुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2033797, "chapter_id": 1729, "verse_number": "४-५२-२३", "content_sanskrit": "राजा बलचतुर्भागं क्षिप्रमादाय गच्छतु ।\nततोऽपरश्चतुर्भागो गाः समादाय गच्छतु ।\nवयं चार्धेन सैन्यस्य प्रतियोत्स्याम पाण्डवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2033798, "chapter_id": 1729, "verse_number": "४-५२-२४", "content_sanskrit": "अहं भीष्मश्च कर्णश्च अश्वत्थामा कृपस्तथा।\nप्रतियोत्स्याम बीभत्सुमागतं कृतनिश्चयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2033799, "chapter_id": 1729, "verse_number": "४-५२-२५", "content_sanskrit": "एवं राजा सुगुप्तः स्यान्न क्लैब्यं गन्तुमर्हति ।\nमत्स्यं वा पुनरायातमथवापि शतक्रतुम् ।\nअहमावारयिष्यामि वेलेव मकरालयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2033800, "chapter_id": 1729, "verse_number": "४-५२-२६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2033801, "chapter_id": 1729, "verse_number": "४-५२-२६", "content_sanskrit": "तद्वाक्यं रुरुचे तेषां द्रोणेनोक्तं महात्मना ।\nतथाहि कृतवान्राजा कौरवाणामनन्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2033802, "chapter_id": 1729, "verse_number": "४-५२-२७", "content_sanskrit": "भीष्मः प्रस्थाप्य राजानं गोधनं तदनन्तरम् ।\nसेनामुख्यान्व्यवस्थाप्य व्यूहितुं संप्रचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2033803, "chapter_id": 1729, "verse_number": "४-५२-२८", "content_sanskrit": "द्रोणस्योपरते वाक्ये भीष्मः प्रोवाच बुद्धिमान्।\nआचार्य मध्ये तिष्ठ त्वमश्वत्थामा तु सव्यतः।\nकृपः शारद्वतो धीमान्पार्श्वं रक्षतु दक्षिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2033804, "chapter_id": 1729, "verse_number": "४-५२-२९", "content_sanskrit": "विकर्णश्च महावीर्यो दुर्मुखश्च परन्तपः।\nशकुनिः सौबलश्चैव दुःसहश्च महाबलः ।\nद्रोणस्य पार्श्वमजिताः पालयन्तु महाबलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2033805, "chapter_id": 1729, "verse_number": "४-५२-३०", "content_sanskrit": "अग्रतः सूतपुत्रस्तु कर्णस्तिष्ठतु दंशितः।\nअहं सर्वस्य सैन्यस्य पश्चात्स्थास्यामि पालयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2033806, "chapter_id": 1729, "verse_number": "४-५२-३१", "content_sanskrit": "सर्वे महारथाः शूरा महेष्वासा महाबलाः ।\nयुद्ध्यन्तु पाण्डवश्रेष्ठमागतं यत्नतो युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2033807, "chapter_id": 1729, "verse_number": "४-५२-३२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2033808, "chapter_id": 1729, "verse_number": "४-५२-३२", "content_sanskrit": "अभेद्यं परसैन्यानां व्यूहं व्यूह्य कुरूत्तमः ।\nवज्रगर्भं व्रीहिमुखं पद्मचन्द्रार्धमण्डलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2033809, "chapter_id": 1729, "verse_number": "४-५२-३३", "content_sanskrit": "तस्य व्यूहस्य पश्चार्धे भीष्मश्चाथोद्यतायुधः ।\nसौवर्णं तालमुच्छ्रित्य रथे तिष्ठन्नशोभत ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2033810, "chapter_id": 1729, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते विराटपर्वणि गोग्रहणपर्वणि द्विपञ्चाशोऽध्यायः ॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]