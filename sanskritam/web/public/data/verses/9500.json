[{"id": 5000500000, "chapter_id": 9500, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे त्रिनवतितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000500001, "chapter_id": 9500, "verse_number": "६-९३-१", "content_sanskrit": "स प्रविश्य सभां राजा दीनः परमदुःखितः।\nनिषसादासने मुख्ये सिंहः क्रुद्ध इव श्वसन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000500002, "chapter_id": 9500, "verse_number": "६-९३-२", "content_sanskrit": "अब्रवीच्च स तान् सर्वान् बलमुख्यान् महाबलः।\nरावणः प्राञ्जलिर्वाक्यं पुत्रव्यसनकर्शितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000500003, "chapter_id": 9500, "verse_number": "६-९३-३", "content_sanskrit": "सर्वे भवन्तः सर्वेण हस्त्यश्वेन समावृताः।\nनिर्यान्तु रथसङ्घैश्च पादातैश्चोपशोभिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000500004, "chapter_id": 9500, "verse_number": "६-९३-४", "content_sanskrit": "एकं रामं परिक्षिप्य समरे हन्तुमर्हथ।\nवर्षन्तः शरवर्षाणि प्रावृट्काल इवाम्बुदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000500005, "chapter_id": 9500, "verse_number": "६-९३-५", "content_sanskrit": "अथवाहं शरैस्तीक्ष्णैर्भिन्नगात्रं महाहवे।\nभवद्भिः श्वो निहन्तास्मि रामं लोकस्य पश्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000500006, "chapter_id": 9500, "verse_number": "६-९३-६", "content_sanskrit": "इत्येतद् वाक्यमादाय राक्षसेन्द्रस्य राक्षसाः।\nनिर्ययुस्ते रथैः शीघ्रैर्नानानीकैश्च संयुताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000500007, "chapter_id": 9500, "verse_number": "६-९३-७", "content_sanskrit": "परिघान् पट्टिशांश्चैव शरखड्गपरश्वधान्।\nशरीरान्तकरान् सर्वे चिक्षिपुर्वानरान् प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000500008, "chapter_id": 9500, "verse_number": "६-९३-८", "content_sanskrit": "वानराश्च द्रुमान् शैलान् राक्षसान् प्रति चिक्षिपुः।\nस संग्रामो महाभीमः सूर्यस्योदयनं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000500009, "chapter_id": 9500, "verse_number": "६-९३-९", "content_sanskrit": "रक्षसां वानराणां च तुमुलः समपद्यत।\nते गदाभिश्च चित्राभिः प्रासैः खड्गैः परश्वधैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000500010, "chapter_id": 9500, "verse_number": "६-९३-१०", "content_sanskrit": "अन्योन्यं समरे जघ्नुस्तदा वानरराक्षसाः।\nएवं प्रवृत्ते संग्रामे ह्यद्भुतं सुमहद्रजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000500011, "chapter_id": 9500, "verse_number": "६-९३-११", "content_sanskrit": "रक्षसां वानराणां च शान्तं शोणितविस्रवैः।\nमातंगरथकूलाश्च शरमत्स्या ध्वजद्रुमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000500012, "chapter_id": 9500, "verse_number": "६-९३-१२", "content_sanskrit": "शरीरसंघाटवहाः प्रसस्रुः शोणितापगाः।\nततस्ते वानराः सर्वे शोणितौघपरिप्लुताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000500013, "chapter_id": 9500, "verse_number": "६-९३-१३", "content_sanskrit": "ध्वजवर्मरथानश्वान् नानाप्रहरणानि च।\nआप्लुत्याप्लुत्य समरे वानरेन्द्रा बभञ्जिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000500014, "chapter_id": 9500, "verse_number": "६-९३-१४", "content_sanskrit": "केशान् कर्णललाटं च नासिकाश्च प्लवंगमाः।\nरक्षसां दशनैस्तीक्ष्णैर्नखैश्चापि व्यकर्तयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000500015, "chapter_id": 9500, "verse_number": "६-९३-१५", "content_sanskrit": "एकैकं राक्षसं संख्ये शतं वानरपुंगवाः।\nअभ्यधावन्त फलिनं वृक्षं शकुनयो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000500016, "chapter_id": 9500, "verse_number": "६-९३-१६", "content_sanskrit": "तदा गदाभिर्गुर्वीभिः प्रासैः खड्गैः परश्वधैः।\nनिर्जघ्नुर्वानरान् घोरान् राक्षसाः पर्वतोपमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000500017, "chapter_id": 9500, "verse_number": "६-९३-१७", "content_sanskrit": "राक्षसैर्वध्यमानानां वानराणां महाचमूः।\nशरण्यं शरणं याता रामं दशरथात्मजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000500018, "chapter_id": 9500, "verse_number": "६-९३-१८", "content_sanskrit": "ततो रामो महातेजा धनुरादाय वीर्यवान्।\nप्रविश्य राक्षसं सैन्यं शरवर्षं ववर्ष च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000500019, "chapter_id": 9500, "verse_number": "६-९३-१९", "content_sanskrit": "प्रविष्टं तु तदा रामं मेघाः सूर्यमिवाम्बरे।\nनाधिजग्मुर्महाघोरा निर्दहन्तं शराग्निना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000500020, "chapter_id": 9500, "verse_number": "६-९३-२०", "content_sanskrit": "कृतान्येव सुघोराणि रामेण रजनीचराः।\nरणे रामस्य ददृशुः कर्माण्यसुकराणि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000500021, "chapter_id": 9500, "verse_number": "६-९३-२१", "content_sanskrit": "चालयन्तं महासैन्यं विधमन्तं महारथान्।\nददृशुस्ते न वै रामं वातं वनगतं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000500022, "chapter_id": 9500, "verse_number": "६-९३-२२", "content_sanskrit": "छिन्नं भिन्नं शरैर्दग्धं प्रभग्नं शस्त्रपीडितम्।\nबलं रामेण ददृशुर्न रामं शीघ्रकारिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000500023, "chapter_id": 9500, "verse_number": "६-९३-२३", "content_sanskrit": "प्रहरन्तं शरीरेषु न ते पश्यन्ति राघवम्।\nइन्द्रियार्थेषु तिष्ठन्तं भूतात्मानमिव प्रजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000500024, "chapter_id": 9500, "verse_number": "६-९३-२४", "content_sanskrit": "एष हन्ति गजानीकमेष हन्ति महारथान्।\nएष हन्ति शरैस्तीक्ष्णैः पदातीन् वाजिभिः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000500025, "chapter_id": 9500, "verse_number": "६-९३-२५", "content_sanskrit": "इति ते राक्षसाः सर्वे रामस्य सदृशान् रणे।\nअन्योन्यं कुपिता जघ्नुः सादृश्याद् राघवस्य तु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000500026, "chapter_id": 9500, "verse_number": "६-९३-२६", "content_sanskrit": "न ते ददृशिरे रामं दहन्तमपि वाहिनीम्।\nमोहिताः परमास्त्रेण गान्धर्वेण महात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000500027, "chapter_id": 9500, "verse_number": "६-९३-२७", "content_sanskrit": "ते तु रामसहस्राणि रणे पश्यन्ति राक्षसाः।\nपुनः पश्यन्ति काकुत्स्थमेकमेव महाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000500028, "chapter_id": 9500, "verse_number": "६-९३-२८", "content_sanskrit": "भ्रमन्तीं काञ्चनीं कोटिं कार्मुकस्य महात्मनः।\nअलातचक्रप्रतिमां ददृशुस्ते न राघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000500029, "chapter_id": 9500, "verse_number": "६-९३-२९", "content_sanskrit": "शरीरनाभि सत्त्वार्चिः शरारं नेमिकार्मुकम्।\nज्याघोषतलनिर्घोषं तेजोबुद्धिगुणप्रभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000500030, "chapter_id": 9500, "verse_number": "६-९३-३०", "content_sanskrit": "दिव्यास्त्रगुणपर्यन्तं निघ्नन्तं युधि राक्षसान्।\nददृशू रामचक्रं तत् कालचक्रमिव प्रजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000500031, "chapter_id": 9500, "verse_number": "६-९३-३१", "content_sanskrit": "अनीकं दशसाहस्रं रथानां वातरंहसाम्।\nअष्टादश सहस्राणि कुञ्जराणां तरस्विनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000500032, "chapter_id": 9500, "verse_number": "६-९३-३२", "content_sanskrit": "चतुर्दश सहस्राणि सारोहाणां च वाजिनाम्।\nपूर्णे शतसहस्रे द्वे राक्षसानां पदातिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000500033, "chapter_id": 9500, "verse_number": "६-९३-३३", "content_sanskrit": "दिवसस्याष्टभागेन शरैरग्निशिखोपमैः।\nहतान्येकेन रामेण रक्षसां कामरूपिणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000500034, "chapter_id": 9500, "verse_number": "६-९३-३४", "content_sanskrit": "ते हताश्वा हतरथाः शान्ता विमथितध्वजाः।\nअभिपेतुः पुरीं लङ्कां हतशेषा निशाचराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000500035, "chapter_id": 9500, "verse_number": "६-९३-३५", "content_sanskrit": "हतैर्गजपदात्यश्वैस्तद् बभूव रणाजिरम्।\nआक्रीडभूमिः क्रुद्धस्य रुद्रस्येव महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000500036, "chapter_id": 9500, "verse_number": "६-९३-३६", "content_sanskrit": "ततो देवाः सगन्धर्वाः सिद्धाश्च परमर्षयः।\nसाधु साध्विति रामस्य तत् कर्म समपूजयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000500037, "chapter_id": 9500, "verse_number": "६-९३-३७", "content_sanskrit": "अब्रवीच्च तदा रामः सुग्रीवं प्रत्यनन्तरम्।\nविभीषणं च धर्मात्मा हनूमन्तं च वानरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000500038, "chapter_id": 9500, "verse_number": "६-९३-३८", "content_sanskrit": "जाम्बवन्तं हरिश्रेष्ठं मैन्दं द्विविदमेव च।\nएतदस्त्रबलं दिव्यं मम वा त्र्यम्बकस्य वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000500039, "chapter_id": 9500, "verse_number": "६-९३-३९", "content_sanskrit": "निहत्य तां राक्षसराजवाहिनीं\nरामस्तदा शक्रसमो महात्मा।\nअस्त्रेषु शस्त्रेषु जितक्लमश्च\nसंस्तूयते देवगणैः प्रहृष्टैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000500040, "chapter_id": 9500, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे त्रिनवतितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]