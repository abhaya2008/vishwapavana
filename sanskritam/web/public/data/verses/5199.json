[{"id": 2197483, "chapter_id": 5199, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2197484, "chapter_id": 5199, "verse_number": "१", "content_sanskrit": "श्रुता भार्याश्च पुत्राश्च विस्तरेण महामुने ।\nआश्रमस्थाश्च या नार्यो न दुष्यन्तीति ब्रूहि भो\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2197485, "chapter_id": 5199, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2197486, "chapter_id": 5199, "verse_number": "२", "content_sanskrit": "आश्रमस्थासु नारीषु बान्धवत्वं प्रणश्यति ।\nनष्टवंश्या भवन्त्येता बन्धूनामथ भर्तृणाम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2197487, "chapter_id": 5199, "verse_number": "३", "content_sanskrit": "परदारा मुक्तदोषास्ता नार्योऽश्रमसंस्थिताः ।\nस्वयमीशाः स्वदेहानां काम्यास्तद्गतमानसाः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2197488, "chapter_id": 5199, "verse_number": "४", "content_sanskrit": "एवं नार्यो न दुष्यन्ति नराणां तत्प्रसूतिषु ।\nधर्मपत्न्यो भवन्त्येताः सपुत्रा हव्यकव्यदाः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2197489, "chapter_id": 5199, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2197490, "chapter_id": 5199, "verse_number": "५", "content_sanskrit": "परस्य भार्या या पूर्वं मृते भर्तरि या पुनः ।\nअन्यं भजति भर्तारं ससुता असुता कथम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2197491, "chapter_id": 5199, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2197492, "chapter_id": 5199, "verse_number": "६", "content_sanskrit": "असुता वा प्रसूता वा गृहस्थानां परस्त्रियः ।\nपरामृष्टेति ता वर्ज्या धर्मचारेषु दूषिताः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2197493, "chapter_id": 5199, "verse_number": "७", "content_sanskrit": "न चासां हव्यकव्यानि प्रतिगृह्णन्ति देवताः ।\nयस्तासु जनयेत् पुत्रान्न तैः पुत्रमवाप्नुयात्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2197494, "chapter_id": 5199, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2197495, "chapter_id": 5199, "verse_number": "८", "content_sanskrit": "परक्षेत्रेषु यो बीजं चापलाद् विसृजेन्नरः ।\nकथं पुत्रफलं तस्य भवेत् तदृषिसत्तम\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2197496, "chapter_id": 5199, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2197497, "chapter_id": 5199, "verse_number": "९", "content_sanskrit": "अस्वामिके परक्षेत्रे यो नरो बीजमुत्सृजेत् ।\nस्वयंवृतोऽश्रमस्थायां तद्बीजं न विनश्यति\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2197498, "chapter_id": 5199, "verse_number": "१०", "content_sanskrit": "परक्षेत्रेषु यो बीजं नरो दर्पात् समुत्सृजेत् ।\nक्षेत्रिकस्यैव तद्बीजं न बीजी लभते फलम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2197499, "chapter_id": 5199, "verse_number": "११", "content_sanskrit": "नातः परमधर्म्यं चाप्ययशस्यं तथोत्तरम् ।\nगर्भादीनां च बहुभिस्ताश्च त्याज्याः समेष्वपि\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2197500, "chapter_id": 5199, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2197501, "chapter_id": 5199, "verse_number": "१२", "content_sanskrit": "अथ ये परदारेषु पुत्रा जायन्ति नारद ।\nकस्य ते बन्धुदायादा भवन्ति परमद्युते\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2197502, "chapter_id": 5199, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2197503, "chapter_id": 5199, "verse_number": "१३", "content_sanskrit": "परदारेषु जायेते द्वौ पुत्रौ कुण्डगोलकौ ।\nजीवत्यथ पतौ कुण्डो मृते भर्तरि गोलकः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2197504, "chapter_id": 5199, "verse_number": "१४", "content_sanskrit": "ते च जाताः परक्षेत्रे देहिनां प्रेत्य चेह च ।\nदत्तानि हव्यकव्यानि नाशयन्त्यथ दातृणाम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2197505, "chapter_id": 5199, "verse_number": "१५", "content_sanskrit": "पितुर्हि नरकायैते गोलकस्तु विशेषतः ।\nचण्डालतुल्यौ तज्जौ हि परत्रेह च नश्यतः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2197506, "chapter_id": 5199, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2197507, "chapter_id": 5199, "verse_number": "१६", "content_sanskrit": "कस्य ते गर्हिताः पुत्राः पितॄणां हव्यकव्यदाः ।\nयस्य क्षेत्रे प्रसूयन्ते यो वा तान् जनयेत् सुतान्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2197508, "chapter_id": 5199, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2197509, "chapter_id": 5199, "verse_number": "१७", "content_sanskrit": "क्षेत्रिकश्चैव बीजी च द्वावेतौ निरयं गतौ ।\nन रक्षति च यो दारान् परदारांश्च गच्छति\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2197510, "chapter_id": 5199, "verse_number": "१८", "content_sanskrit": "गर्हितास्ते नरा नित्यं धर्मचारबहिष्कृताः ।\nकुण्डो भोक्ता च भोगी च कुत्सिताः पितृदैवतैः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2197511, "chapter_id": 5199, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2197512, "chapter_id": 5199, "verse_number": "१९", "content_sanskrit": "तथैते गर्हिताः पुत्रा हव्यकव्यानि नारद ।\nकस्य नित्यं प्रयच्छन्ति धर्मो वा तेषु किं फलम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2197513, "chapter_id": 5199, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2197514, "chapter_id": 5199, "verse_number": "२०", "content_sanskrit": "यातुधानाः पिशाचाश्च प्रतिगृह्णन्ति तैर्हुतम् ।\nहव्यं कव्यं च तैर्दत्तं ये च भूता निशाचराः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2197515, "chapter_id": 5199, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2197516, "chapter_id": 5199, "verse_number": "२१", "content_sanskrit": "अथ ते राक्षसाः प्रीताः किं प्रयच्छन्ति दातृणाम् ।\nकिं वा धर्मफलं तेषां भवेत् तदृषिसत्तम\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2197517, "chapter_id": 5199, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2197518, "chapter_id": 5199, "verse_number": "२२", "content_sanskrit": "न दत्तं नश्यते किञ्चित् सर्वभूतेषु दातृणाम् ।\nप्रेत्य चेह च तां पुष्टिमुपाश्नन्ति प्रदायिनः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2197519, "chapter_id": 5199, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2197520, "chapter_id": 5199, "verse_number": "२३", "content_sanskrit": "अथ गोलककुण्डाभ्यां सन्ततिर्या भविष्यति ।\nतयोर्ये बान्धवाः केचित् प्रदास्यन्ति कथं नु तम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2197521, "chapter_id": 5199, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2197522, "chapter_id": 5199, "verse_number": "२४", "content_sanskrit": "साध्वीजाताः सुतास्तेषां तां वृत्तिमनुतिष्ठताम् ।\nप्रीणन्ति पितृदैवत्यं हव्यकव्यसमाहिताः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2197523, "chapter_id": 5199, "verse_number": "२५", "content_sanskrit": "एवं गोलककुण्डाभ्यां ये च वर्णापदेशिनः ।\nहव्यं कव्यं च शुद्धानां प्रतिगृह्णन्ति देवताः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2197524, "chapter_id": 5199, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि\nदानधर्मे नरचापल्यकथनं नाम पञ्चाशोऽध्यायः ॥५०॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]