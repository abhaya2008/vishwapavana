[{"id": 7004485000, "chapter_id": 24485, "verse_number": "५-३-१७९-१", "content_sanskrit": "मार्कण्डेय उवाच ।\nततो गच्छेत्तु राजेन्द्र गौतमेश्वरमुत्तमम् ।\nसर्वपापहरं तीर्थं त्रिषु लोकेषु विश्रुतम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004485001, "chapter_id": 24485, "verse_number": "५-३-१७९-२", "content_sanskrit": "गौतमेन तपस्तप्तं तत्र तीर्थे युधिष्ठिर ।\nदिव्यं वर्षसहस्रं तु ततस्तुष्टो महेश्वरः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004485002, "chapter_id": 24485, "verse_number": "५-३-१७९-३", "content_sanskrit": "प्रणम्य शिरसा तत्र स्थापितः परमेश्वरः ।\nस्थापितो गौतमेनेशो गौतमेश्वर उच्यते॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004485003, "chapter_id": 24485, "verse_number": "५-३-१७९-४", "content_sanskrit": "तत्र देवैश्च गन्धर्वैरृषिभिः पितृदैवतैः ।\nसम्प्राप्ता ह्युत्तमा सिद्धिराराध्य परमेश्वरम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004485004, "chapter_id": 24485, "verse_number": "५-३-१७९-५", "content_sanskrit": "तत्र तीर्थे तु यः स्नात्वा पूजयेत्पितृदेवताः ।\nपूजयेत्परमीशानं सर्वपापैः प्रमुच्यते॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004485005, "chapter_id": 24485, "verse_number": "५-३-१७९-६", "content_sanskrit": "बहवस्तन्न जानन्ति विष्णुमायाविमोहिताः ।\nतत्र संनिहितं देवं शूलपाणिं महेश्वरम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004485006, "chapter_id": 24485, "verse_number": "५-३-१७९-७", "content_sanskrit": "ब्रह्मचारी तु यो भूत्वा तत्र तीर्थे नरेश्वर ।\nस्नात्वार्चयेन्महादेवं सोऽश्वमेधफलं लभेत्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004485007, "chapter_id": 24485, "verse_number": "५-३-१७९-८", "content_sanskrit": "ब्रह्मचारी तु यो भूत्वा तर्पयेत्पितृदेवताः ।\nपूजयेत्परमीशानं सर्वपापैः प्रमुच्यते॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004485008, "chapter_id": 24485, "verse_number": "५-३-१७९-९", "content_sanskrit": "तत्र तीर्थे तु यो दानं भक्त्या दद्याद्द्विजातये ।\nतदक्षयफलं सर्वं नात्र कार्या विचारणा॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004485009, "chapter_id": 24485, "verse_number": "५-३-१७९-१०", "content_sanskrit": "मासे चाश्वयुजे राजन् कृष्णपक्षे चतुर्दशीम् ।\nस्नात्वा तत्र विधानेन दीपकानां शतं ददेत्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004485010, "chapter_id": 24485, "verse_number": "५-३-१७९-११", "content_sanskrit": "पूजयित्वा महादेवं गन्धपुष्पादिभिर्नरः ।\nमुच्यते सर्वपापेभ्यो मृतः शिवपुरं व्रजेत्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004485011, "chapter_id": 24485, "verse_number": "५-३-१७९-१२", "content_sanskrit": "अष्टम्यां च चतुर्दश्यां कार्त्तिक्यां तु विशेषतः ।\nउपोष्य प्रयतो भूत्वा घृतेन स्नापयेच्छिवम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004485012, "chapter_id": 24485, "verse_number": "५-३-१७९-१३", "content_sanskrit": "पञ्चगव्येन मधुना दध्ना वा शीतवारिणा ।\nस च सर्वस्य यज्ञस्य फलं प्राप्नोति मानवः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004485013, "chapter_id": 24485, "verse_number": "५-३-१७९-१४", "content_sanskrit": "भक्त्या तु पूजयेत्पश्चात्स लभेत्फलमुत्तमम् ।\nबिल्वपत्रैरखण्डैश्च पुष्पैरुन्मत्तकोद्भवैः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004485014, "chapter_id": 24485, "verse_number": "५-३-१७९-१५", "content_sanskrit": "कुशापामार्गसहितैः कदम्बद्रोणजैरपि ।\nमल्लिकाकरवीरैश्च रक्तपीतैः सितासितैः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004485015, "chapter_id": 24485, "verse_number": "५-३-१७९-१६", "content_sanskrit": "पुष्पैरन्यैर्यथालाभं यो नरः पूजयेच्छिवम् ।\nनैरन्तर्येण षण्मासं योऽर्चयेद्गौतमेश्वरम् ।\nसर्वान्कामानवाप्नोति मृतः शिवपुरं व्रजेत्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]