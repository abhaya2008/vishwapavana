[{"id": 2147330, "chapter_id": 4185, "verse_number": "", "content_sanskrit": "गालवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2147331, "chapter_id": 4185, "verse_number": "१", "content_sanskrit": "महावीर्यो महीपालः काशीनामीश्वरः प्रभुः ।\nदिवोदास इति ख्यातो भैमसेनिर्नराधिपः\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2147332, "chapter_id": 4185, "verse_number": "२", "content_sanskrit": "तत्र गच्छावहे भद्रे शनैरागच्छ मा शुचः ।\nधार्मिकः संयमे युक्तः सत्यश्चैव जनेश्वरः\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2147333, "chapter_id": 4185, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2147334, "chapter_id": 4185, "verse_number": "३", "content_sanskrit": "तमुपागम्य स मुनिः न्यायतस्तेन सत्कृतः ।\nगालवः प्रसवस्यार्थे तं नृपं प्रत्यचोदयत्\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2147335, "chapter_id": 4185, "verse_number": "", "content_sanskrit": "दिवोदासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2147336, "chapter_id": 4185, "verse_number": "४", "content_sanskrit": "श्रुतमेतन्मया पूर्वं किमुक्त्वा विस्तरं द्विज ।\nकाङ्क्षितो हि मयैषोऽर्थः श्रुत्वैव द्विजसत्तम\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2147337, "chapter_id": 4185, "verse_number": "५", "content_sanskrit": "एतच्च मे बहुमतं यदुत्सृज्य नराधिपान् ।\nमामेवमुपयातोऽसि भावि चैतदसंशयम्\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2147338, "chapter_id": 4185, "verse_number": "६", "content_sanskrit": "स एव विभवोऽस्माकमश्वानामपि गालव ।\nअहमप्येकमेवास्यां जनयिष्यामि पार्थिवम्\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2147339, "chapter_id": 4185, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2147340, "chapter_id": 4185, "verse_number": "७", "content_sanskrit": "तथेत्युक्त्वा द्विजश्रेष्ठः प्रादात् कन्यां महीपतेः ।\nविधिपूर्वां च तां राजा कन्यां प्रतिगृहीतवान्\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2147341, "chapter_id": 4185, "verse_number": "८", "content_sanskrit": "रेमे स तस्यां राजर्षिः प्रभावत्यां यथा रविः ।\nस्वाहायां च यथा वह्निर्यथा शच्यां च वासवः\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2147342, "chapter_id": 4185, "verse_number": "९", "content_sanskrit": "यथा चन्द्रश्च रोहिण्यां यथा धूमोर्णया यमः ।\nवरुणश्च यथा गौर्यां यथा चर्ध्यां धनेश्वरः\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2147343, "chapter_id": 4185, "verse_number": "१०", "content_sanskrit": "यथा नारायणो लक्ष्म्यां जाह्नव्यां च यथोदधिः ।\nयथा रुद्रश्च रुद्राण्यां यथा वाण्यां पितामहः\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2147344, "chapter_id": 4185, "verse_number": "११", "content_sanskrit": "अदृश्यन्त्यां च वासिष्ठो वसिष्ठश्चाक्षमालया ।\nच्यवनश्च सुकन्यायां पुलस्त्यः सन्ध्यया यथा\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2147345, "chapter_id": 4185, "verse_number": "१२", "content_sanskrit": "अगस्त्यश्चापि वैदर्भ्यां सावित्र्यां सत्यवान् यथा ।\nयथा भृगुः पुलोमायामदित्यां काश्यपो यथा\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2147346, "chapter_id": 4185, "verse_number": "१३", "content_sanskrit": "रेणुकायां यथर्चीको हैमवत्यां च कौशिकः ।\nबृहस्पतिश्च तारायां शुक्रश्च शतपर्वया\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2147347, "chapter_id": 4185, "verse_number": "१४", "content_sanskrit": "यथा भूम्यां भूमिपतिरुर्वश्यां च पुरूरवाः ।\nदधीचिः सत्यधृत्यां च सरस्वत्यां यथा मनुः\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2147348, "chapter_id": 4185, "verse_number": "१५", "content_sanskrit": "शकुन्तलायां दुष्यन्तो धृत्यां धर्मश्च शाश्वतः ।\nदमयन्त्यां नळश्चैव सत्यवत्यां च भार्गवः\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2147349, "chapter_id": 4185, "verse_number": "१६", "content_sanskrit": "जरत्कारुर्जरत्कार्वां रत्यां च मदनो यथा ।\nमेनकायां यथोर्णायुः तुम्बुरुश्चैव रम्भया\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2147350, "chapter_id": 4185, "verse_number": "१७", "content_sanskrit": "वासुकिः शतशीर्षायां कुमार्यां च धनञ्जयः ।\nवैदेह्यां च यथा रामो रुग्मिण्यां च जनार्दनः\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2147351, "chapter_id": 4185, "verse_number": "१८", "content_sanskrit": "तथा तु रममाणस्य दिवोदासस्य भूपतेः ।\nमाधवी जनयामास पुत्रमेकं प्रतर्दनम्\t ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2147352, "chapter_id": 4185, "verse_number": "१९", "content_sanskrit": "अथाजगाम भगवान् दिवोदासं स गालवः ।\nसमये समनुप्राप्ते वचनं चेदमब्रवीत्\t ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2147353, "chapter_id": 4185, "verse_number": "२०", "content_sanskrit": "निर्यातयतु मे कन्यां भवांस्तिष्ठन्तु वाजिनः ।\nयावदन्यत्र गच्छामि शुल्कार्थं पृथिवीपते\t ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2147354, "chapter_id": 4185, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2147355, "chapter_id": 4185, "verse_number": "२१", "content_sanskrit": "दिवोदासोऽथ धर्मात्मा समये गालवस्य ताम् ।\nकन्यां निर्यातयामास स्थितः सत्ये महीपतिः\t ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2147356, "chapter_id": 4185, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि षोडशोत्तरशततमोऽध्यायः ॥११६॥\nभगवद्यानपर्वणि सप्तचत्वारिंशोऽध्यायः ॥४७॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]