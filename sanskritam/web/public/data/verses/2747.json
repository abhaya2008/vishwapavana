[{"id": 2082305, "chapter_id": 2747, "verse_number": "१२-२५२-०x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2082306, "chapter_id": 2747, "verse_number": "१२-२५२-१", "content_sanskrit": "प्रकृतेस्तु विकारा ये क्षेत्रज्ञस्तैरधिष्ठितः।\nन चैनं ते प्रजानन्ति स तु जानाति तानपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2082307, "chapter_id": 2747, "verse_number": "१२-२५२-२", "content_sanskrit": "तैश्चैवं कुरुते कार्यं मनःषष्ठैरिहेन्द्रियैः।\nसुदान्तैरिव संयन्ता दृढैः परमवाजिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2082308, "chapter_id": 2747, "verse_number": "१२-२५२-३", "content_sanskrit": "इन्द्रियेभ्यः परे ह्यर्था अर्थेभ्यः परमं मनः।\nमनसस्तु परा बुद्धिर्बुद्धेरात्मा महान्परः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2082309, "chapter_id": 2747, "verse_number": "१२-२५२-४", "content_sanskrit": "महतः परमव्यक्तमव्यक्तात्पुरुषः परः।\nपुरुषान्न परं किंचित्सा काष्ठा सा परा गतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2082310, "chapter_id": 2747, "verse_number": "१२-२५२-५", "content_sanskrit": "एवं सर्वेषु भूतेषु गूढोत्मा न प्रकाशते।\nदृश्यते त्वग्र्यया बुद्ध्या सूक्ष्मया सूक्ष्मदर्शिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2082311, "chapter_id": 2747, "verse_number": "१२-२५२-६", "content_sanskrit": "अन्तरात्मनि संलीय मनः षष्ठानि मेधया।\nइन्द्रियाणीन्द्रियार्थांश्च बहुचिन्त्यमचिन्तयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2082312, "chapter_id": 2747, "verse_number": "१२-२५२-७", "content_sanskrit": "ध्यानोपरमणं कृत्वा विद्यासंपादितं मनः।\nअनिश्चरः प्रशान्तात्मा ततोर्च्छत्यमृतं पदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2082313, "chapter_id": 2747, "verse_number": "१२-२५२-८", "content_sanskrit": "इन्द्रियाणां तु सर्वेषां पश्यात्मा चलितस्मृतिः।\nआत्मनः संप्रदानेन मर्त्यो मृत्युमुपाश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2082314, "chapter_id": 2747, "verse_number": "१२-२५२-९", "content_sanskrit": "हित्वा तु सर्वसंकल्पान्सत्वे चित्तं निवेशयेत्।\nसत्वे चित्तं समावेश्य ततः कालंजरो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2082315, "chapter_id": 2747, "verse_number": "१२-२५२-१०", "content_sanskrit": "चित्तप्रसादेन यतिर्जहातीह शुभाशुभम्।\nप्रसन्नात्मात्मनि स्थित्वा सुखमत्यन्तमश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2082316, "chapter_id": 2747, "verse_number": "१२-२५२-११", "content_sanskrit": "लक्षणं तु प्रसादस्य यथा तृप्तः सुखं स्वपेत्।\nनिवाते वा यथा दीपो दीप्यमानो न कम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2082317, "chapter_id": 2747, "verse_number": "१२-२५२-१२", "content_sanskrit": "एवं पूर्वापरे रात्रौ युञ्जन्नात्मानमात्मनि।\nलघ्वाहारो विशुद्धात्मा पश्यत्यात्मानमात्मनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2082318, "chapter_id": 2747, "verse_number": "१२-२५२-१३", "content_sanskrit": "रहस्यं सर्ववेदानामनैतिह्यमनागतम्।\nआत्मप्रत्ययिकं शास्त्रमिदं पुत्रानुशासनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2082319, "chapter_id": 2747, "verse_number": "१२-२५२-१४", "content_sanskrit": "धर्माख्यानेषु सर्वेषु चित्राख्यानेषु यद्वसु।\nदृश्यते ऋक्सहस्राणि निर्मथ्यामृतमुद्धृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2082320, "chapter_id": 2747, "verse_number": "१२-२५२-१५", "content_sanskrit": "नवनीतं यथा दध्नः काष्ठादग्निर्यथैव च।\nतथैव विदुषां ज्ञानं पुत्रहेतोः समुद्धृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2082321, "chapter_id": 2747, "verse_number": "१२-२५२-१६", "content_sanskrit": "स्नातकानामिदं शास्त्रं वाच्यं पुत्रानुशासनम्।\nतदितं नाप्रशान्ताय नादान्तायातपस्विने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2082322, "chapter_id": 2747, "verse_number": "१२-२५२-१७", "content_sanskrit": "नावेदविदुषे वाच्यं तथा नानुगताय च।\nनासूयकायानृजवे न चानिर्दिष्टकारिणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2082323, "chapter_id": 2747, "verse_number": "१२-२५२-१८", "content_sanskrit": "न तर्कशास्त्रदग्धाय तथैव पिशुनाय च।\nश्लाघिने श्लाघनीयाय प्रशान्ताय तपस्विने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2082324, "chapter_id": 2747, "verse_number": "१२-२५२-१९", "content_sanskrit": "इदं प्रियाय पुत्राय शिष्यायानुगताय च।\nरहस्यधर्मं वक्तव्यं नान्यस्मै तु कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2082325, "chapter_id": 2747, "verse_number": "१२-२५२-२०", "content_sanskrit": "यद्यप्यस्य महीं दद्याद्रत्नपूर्णामिमां नरः।\nइदमेव ततः श्रेय इति मन्येत तत्त्ववित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2082326, "chapter_id": 2747, "verse_number": "१२-२५२-२१", "content_sanskrit": "अतो गुह्यतरार्थं तदध्यात्ममतिमानुषम्।\nयत्तन्महर्षिभिर्जुष्टं वेदान्तेषु च गीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2082327, "chapter_id": 2747, "verse_number": "१२-२५२-२२", "content_sanskrit": "तत्तेऽहं संप्रवक्ष्यामि यन्मां त्वं परिपृच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2082328, "chapter_id": 2747, "verse_number": "१२-२५२-२३", "content_sanskrit": "यच्च ते मनसि वर्तते परं\nयत्र चास्ति तव संशयः क्वचित्।\nश्रूयतामयमहं तवाग्रतः\nपुत्र किं हि कथयामि ते पुनः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2082329, "chapter_id": 2747, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि द्विपञ्चाशदधिकद्विशततमोऽध्यायः॥ २५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]