[{"id": 5000489000, "chapter_id": 9489, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे द्व्यशीततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000489001, "chapter_id": 9489, "verse_number": "६-८२-१", "content_sanskrit": "श्रुत्वा तु भीमनिर्ह्रादं शक्राशनिसमस्वनम्।\nवीक्ष्यमाणा दिशः सर्वा दुद्रुवुर्वानरा भृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000489002, "chapter_id": 9489, "verse_number": "६-८२-२", "content_sanskrit": "तानुवाच ततः सर्वान् हनूमान् मारुतात्मजः।\nविषण्णवदनान् दीनांस्त्रस्तान् विद्रवतः पृथक् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000489003, "chapter_id": 9489, "verse_number": "६-८२-३", "content_sanskrit": "कस्माद् विषण्णवदना विद्रवध्वं प्लवंगमाः।\nत्यक्तयुद्धसमुत्साहाः शूरत्वं क्व नु वो गतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000489004, "chapter_id": 9489, "verse_number": "६-८२-४", "content_sanskrit": "पृष्ठतोऽनुव्रजध्वं मामग्रतो यान्तमाहवे।\nशूरैरभिजनोपेतैरयुक्तं हि निवर्तितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000489005, "chapter_id": 9489, "verse_number": "६-८२-५", "content_sanskrit": "एवमुक्ताः सुसंक्रुद्धा वायुपुत्रेण धीमता।\nशैलशृङ्गान् द्रुमांश्चैव जगृहुर्हृष्टमानसाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000489006, "chapter_id": 9489, "verse_number": "६-८२-६", "content_sanskrit": "अभिपेतुश्च गर्जन्तो राक्षसान् वानरर्षभाः।\nपरिवार्य हनूमन्तमन्वयुश्च महाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000489007, "chapter_id": 9489, "verse_number": "६-८२-७", "content_sanskrit": "स तैर्वानरमुख्यैस्तु हनूमान् सर्वतो वृतः।\nहुताशन इवार्चिष्मानदहच्छत्रुवाहिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000489008, "chapter_id": 9489, "verse_number": "६-८२-८", "content_sanskrit": "स राक्षसानां कदनं चकार सुमहाकपिः।\nवृतो वानरसैन्येन कालान्तकयमोपमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000489009, "chapter_id": 9489, "verse_number": "६-८२-९", "content_sanskrit": "स तु शोकेन चाविष्टः कोपेन महता कपिः।\nहनूमान् रावणिरथे महतीं पातयच्छिलाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000489010, "chapter_id": 9489, "verse_number": "६-८२-१०", "content_sanskrit": "तामापतन्तीं दृष्ट्वैव रथः सारथिना तदा।\nविधेयाश्वसमायुक्तः विदूरमपवाहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000489011, "chapter_id": 9489, "verse_number": "६-८२-११", "content_sanskrit": "तमिन्द्रजितमप्राप्य रथस्थं सहसारथिम्।\nविवेश धरणीं भित्त्वा सा शिला व्यर्थमुद्यता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000489012, "chapter_id": 9489, "verse_number": "६-८२-१२", "content_sanskrit": "पतितायां शिलायां तु व्यथिता रक्षसां चमूः।\nनिपतन्त्या च शिलया राक्षसा मथिता भृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000489013, "chapter_id": 9489, "verse_number": "६-८२-१३", "content_sanskrit": "तमभ्यधावन् शतशो नदन्तः काननौकसः।\nते द्रुमांश्च महाकाया गिरिशृङ्गाणि चोद्यताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000489014, "chapter_id": 9489, "verse_number": "६-८२-१४", "content_sanskrit": "क्षिपन्तीन्द्रजितं संख्ये वानरा भीमविक्रमाः।\nवृक्षशैलमहावर्षं विसृजन्तः प्लवंगमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000489015, "chapter_id": 9489, "verse_number": "६-८२-१५", "content_sanskrit": "शत्रूणां कदनं चक्रुर्नेदुश्च विविधैः स्वनैः।\nवानरैस्तैर्महाभीमैर्घोररूपा निशाचराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000489016, "chapter_id": 9489, "verse_number": "६-८२-१६", "content_sanskrit": "वीर्यादभिहता वृक्षैर्व्यचेष्टन्त रणक्षितौ।\nस सैन्यमभिवीक्ष्याथ वानरार्दितमिन्द्रजित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000489017, "chapter_id": 9489, "verse_number": "६-८२-१७", "content_sanskrit": "प्रगृहीतायुधः क्रुद्धः परानभिमुखो ययौ।\nस शरौघानवसृजन् स्वसैन्येनाभिसंवृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000489018, "chapter_id": 9489, "verse_number": "६-८२-१८", "content_sanskrit": "जघान कपिशार्दूलान् सुबहून् दृढविक्रमः।\nशूलैरशनिभिः खड्गैः पट्टिशैः शूलमुद‍्गरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000489019, "chapter_id": 9489, "verse_number": "६-८२-१९", "content_sanskrit": "ते चाप्यनुचरांस्तस्य वानरा जघ्नुराहवे।\nसुस्कन्धविटपैः शैलैः शिलाभिश्च महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000489020, "chapter_id": 9489, "verse_number": "६-८२-२०", "content_sanskrit": "हनूमान् कदनं चक्रे रक्षसां भीमकर्मणाम्।\nसंनिवार्य परानीकमब्रवीत् तान् वनौकसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000489021, "chapter_id": 9489, "verse_number": "६-८२-२१", "content_sanskrit": "हनूमान् संनिवर्तध्वं न नः साध्यमिदं बलम्।\nत्यक्त्वा प्राणान् विचेष्टन्तो रामप्रियचिकीर्षवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000489022, "chapter_id": 9489, "verse_number": "६-८२-२२", "content_sanskrit": "यन्निमित्तं हि युध्यामो हता सा जनकात्मजा।\nइममर्थं हि विज्ञाप्य रामं सुग्रीवमेव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000489023, "chapter_id": 9489, "verse_number": "६-८२-२३", "content_sanskrit": "तौ यत् प्रतिविधास्येते तत् करिष्यामहे वयम्।\nइत्युक्त्वा वानरश्रेष्ठो वारयन् सर्ववानरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000489024, "chapter_id": 9489, "verse_number": "६-८२-२४", "content_sanskrit": "शनैः शनैरसंत्रस्तः सबलः संन्यवर्तत।\nततः प्रेक्ष्य हनूमन्तं व्रजन्तं यत्र राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000489025, "chapter_id": 9489, "verse_number": "६-८२-२५", "content_sanskrit": "स होतुकामो दुष्टात्मा गतश्चैत्यं निकुम्भिलाम्।\nनिकुम्भिलामधिष्ठाय पावकं जुहवेन्द्रजित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000489026, "chapter_id": 9489, "verse_number": "६-८२-२६", "content_sanskrit": "यज्ञभूम्यां ततो गत्वा पावकस्तेन रक्षसा।\nहूयमानः प्रजज्वाल होमशोणितभुक् तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000489027, "chapter_id": 9489, "verse_number": "६-८२-२७", "content_sanskrit": "सार्चिःपिनद्धो ददृशे होमशोणिततर्पितः।\nसंध्यागत इवादित्यः सुतीव्रोऽग्निः समुत्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000489028, "chapter_id": 9489, "verse_number": "६-८२-२८", "content_sanskrit": "अथेन्द्रजिद् राक्षसभूतये तु\nजुहाव हव्यं विधिना विधानवित्।\nदृष्ट्वा व्यतिष्ठन्त च राक्षसास्ते\nमहासमूहेषु नयानयज्ञाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000489029, "chapter_id": 9489, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे द्व्यशीततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]