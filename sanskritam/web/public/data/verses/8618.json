[{"id": 900008106, "chapter_id": 8618, "verse_number": "9.1", "content_sanskrit": "अतो निखिलगुणगणाढ्यमेव ब्रह्म..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900008107, "chapter_id": 8618, "verse_number": "9.2", "content_sanskrit": "अनिर्वचनीयासिद्धेरेवानुमानस्याप्यसिद्धिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900008108, "chapter_id": 8618, "verse_number": "9.3", "content_sanskrit": "अनिर्वचनीयासिद्धेरेवानुमानस्याप्यसिद्धिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900008109, "chapter_id": 8618, "verse_number": "9.4", "content_sanskrit": "अनिर्वचनीयासिद्धेरेवानुमानस्याप्यसिद्धिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900008110, "chapter_id": 8618, "verse_number": "9.5", "content_sanskrit": "उत तमादेश-मप्राक्ष्यो..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900008111, "chapter_id": 8618, "verse_number": "9.6", "content_sanskrit": "वाचारम्भणं विविधप्रकारः..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900008112, "chapter_id": 8618, "verse_number": "9.7", "content_sanskrit": "एवं प्रधानस्य परमात्मनो.", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900008113, "chapter_id": 8618, "verse_number": "9.8", "content_sanskrit": "यथा सोम्येत्याद्यपि सादृश्यकथनम्..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900008114, "chapter_id": 8618, "verse_number": "9.9", "content_sanskrit": "न चैकनखनिकृन्तनविकारः..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900008115, "chapter_id": 8618, "verse_number": "9.10", "content_sanskrit": "मुक्तामुक्तयोर्भेदाभावे..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900008116, "chapter_id": 8618, "verse_number": "9.11", "content_sanskrit": "ततश्च दुःखित्वं स्यात्..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900008117, "chapter_id": 8618, "verse_number": "9.12", "content_sanskrit": "तान्यहं वेद सर्वाणि..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900008118, "chapter_id": 8618, "verse_number": "9.13", "content_sanskrit": "तत एवाभ्रान्तत्वान्न..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}]