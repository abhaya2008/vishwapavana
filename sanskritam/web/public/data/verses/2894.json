[{"id": 2088652, "chapter_id": 2894, "verse_number": "१३-२४-१", "content_sanskrit": "`भीष्म उवाच।\nततः कद्रूर्हसन्ती च विनतां धर्मचारिणीम्।\nदासीवत्प्रेषयामास सा च सर्वं चकार तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2088653, "chapter_id": 2894, "verse_number": "१३-२४-२", "content_sanskrit": "न विवर्णा न संक्षुब्धा न च क्रुद्धा न दुःखिता।\nप्रेष्यकर्म चकारास्या विनता कमलेक्षणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2088654, "chapter_id": 2894, "verse_number": "१३-२४-३", "content_sanskrit": "इमा दिशश्चतस्रोऽस्याः प्रेष्यभावेन वर्तिताः।\nअथ स्म वैनतेयं वै बलदर्पौ समीयतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2088655, "chapter_id": 2894, "verse_number": "१३-२४-४", "content_sanskrit": "तं दर्पवशमापन्नं परिधावन्तमन्तिकात्।\nददर्श नारदो राजन्देवर्षिर्दर्पसंयुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2088656, "chapter_id": 2894, "verse_number": "१३-२४-५", "content_sanskrit": "तमब्रवीच्च देवर्षिर्नारदः प्रहसन्निव।\nकिं दर्पवशमापन्नो न वै पश्यसि मातरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2088657, "chapter_id": 2894, "verse_number": "१३-२४-६", "content_sanskrit": "बलेन दृप्तः सततमहंमानकृतः सदा।\nदासीं पन्नगराजस्य मातुरन्तर्गृहे सतीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2088658, "chapter_id": 2894, "verse_number": "१३-२४-७", "content_sanskrit": "तमब्रवीद्वैनतेयः कर्म किं तन्महामते।\nजनयित्री मयि सुते जाता दासी तपस्विनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2088659, "chapter_id": 2894, "verse_number": "१३-२४-८", "content_sanskrit": "अथाब्रवीदृषिर्वाक्यं दीव्यती विजिता खग।\nनिकृत्या पन्नगेन्द्रस्य मात्रा पुत्रैः पुरा सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2088660, "chapter_id": 2894, "verse_number": "१३-२४-९x", "content_sanskrit": "गरुड उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2088661, "chapter_id": 2894, "verse_number": "१३-२४-९", "content_sanskrit": "कथं जिता निकृत्या सा भगवञ्जननी मम।\nब्रूहि तन्मे यथावृत्तं श्रुत्वा वेत्स्ये ततः परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2088662, "chapter_id": 2894, "verse_number": "१३-२४-१०", "content_sanskrit": "ततस्तस्य यथावृत्तं सर्वं तन्नारदस्तदा।\nआचख्यौ भरतश्रेष्ठ यथावृत्तं पतत्रिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2088663, "chapter_id": 2894, "verse_number": "१३-२४-११", "content_sanskrit": "तच्छ्रुत्वा वैनतेयस्य कोपो हृदि समाविशत्।\nजगर्हे पन्नगान्सर्वान्मात्रा सह परंतपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2088664, "chapter_id": 2894, "verse_number": "१३-२४-१२", "content_sanskrit": "ततस्तु रोषाद्दुःखाच्च तूर्णमुत्पत्यक पक्षिराट्।\nजगाम यत्र माताऽस्य कृच्छ्रे महति वर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2088665, "chapter_id": 2894, "verse_number": "१३-२४-१३", "content_sanskrit": "तत्रापश्यत्ततो दीनां जटिलां मलिनां कृशाम्।\nतोयदेन प्रतिच्छन्नां सूर्याभामिव मातरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2088666, "chapter_id": 2894, "verse_number": "१३-२४-१४", "content_sanskrit": "तस्य दुःखाच्च रोषाच्च नेत्राभ्यामश्रु चास्रवत्।\nप्रवृत्तिं च निवृत्तिं च पौरुषे प्रतितस्थुषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2088667, "chapter_id": 2894, "verse_number": "१३-२४-१५", "content_sanskrit": "अनुक्त्वा मातरं किञ्चित्पतत्रिवरपुङ्गवः।\nकद्रूमेव स धर्मात्मा वचनं प्रत्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2088668, "chapter_id": 2894, "verse_number": "१३-२४-१६", "content_sanskrit": "यदि धर्मेण मे माता जिता यद्यप्यधर्मतः।\nज्येष्ठा त्वमसि मे माता धर्मः सर्वः स मे मतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2088669, "chapter_id": 2894, "verse_number": "१३-२४-१७", "content_sanskrit": "इयं तु मे स्यात्कृपणा मयि पुत्रेऽम्ब दुःखिता।\nअनुजानीहि तां साधु मत्कृते धर्मदर्शिनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2088670, "chapter_id": 2894, "verse_number": "१३-२४-१८", "content_sanskrit": "कद्रूः श्रुत्वास्य तद्वाक्यं वैनतेयस्य धीमतः।\nउवाच वाक्यं दुष्प्रज्ञा परीता दुःखमूर्च्छिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2088671, "chapter_id": 2894, "verse_number": "१३-२४-१९", "content_sanskrit": "नाहं तव न ते मातुर्वैनतेय कथञ्चन।\nकुर्यां प्रियमनिष्टात्मा मां ब्रवीषि खग द्विजा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2088672, "chapter_id": 2894, "verse_number": "१३-२४-२०", "content_sanskrit": "तां तदा ब्रुवतीं वाक्यमनिष्टं क्रूरभाषिणीम्।\nदारुणां सूनृताभिस्तामनुनेतुं प्रचक्रमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2088673, "chapter_id": 2894, "verse_number": "१३-२४-२१x", "content_sanskrit": "गरुड रुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2088674, "chapter_id": 2894, "verse_number": "१३-२४-२१", "content_sanskrit": "ज्येष्ठा त्वमसि कल्याणि मातुर्मे भामिनि प्रिया।\nसोदर्यी मम चासि त्वं ज्येष्ठा माता न संशयः॥१३--२४-२२x कद्रूरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2088675, "chapter_id": 2894, "verse_number": "१३-२४-२२", "content_sanskrit": "विहङ्गम यथाकामं गच्छ कामगम द्विज।\nसूनृताभिस्त्वया माता नादासी शक्यमण्डज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2088676, "chapter_id": 2894, "verse_number": "१३-२४-२३", "content_sanskrit": "अमृतं यद्याहरेस्त्वं विहङ्गं जननीं तव।\nअदासीं मम पश्येमां वैनतेय न संशयः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2088677, "chapter_id": 2894, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि चतुर्विंशोऽध्यायः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]