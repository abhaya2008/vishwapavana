[{"id": 2040792, "chapter_id": 1905, "verse_number": "५-१५०-०x", "content_sanskrit": "भगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2040793, "chapter_id": 1905, "verse_number": "५-१५०-१", "content_sanskrit": "एवमुक्ते तु भीष्मेण द्रोणेन विदुरेण च।\nगान्धार्या धृतराष्ट्रेण न वै मन्दोऽन्वबुद्ध्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2040794, "chapter_id": 1905, "verse_number": "५-१५०-२", "content_sanskrit": "अवधूयोत्थितो मन्दः क्रोधसंरक्तलोचनः।\nअन्वद्रवन्त तं पश्चाद्राजानस्त्यक्तजीविताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2040795, "chapter_id": 1905, "verse_number": "५-१५०-३", "content_sanskrit": "आज्ञापयच्च राज्ञस्तान्पार्थिवान्नष्टचेतसः ।\nप्रयात वै कुरुक्षेत्रं पुष्योऽद्येति पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2040796, "chapter_id": 1905, "verse_number": "५-१५०-४", "content_sanskrit": "ततस्ते पृथिवीपालाः प्रययुः सहसैनिकाः ।\nभीष्मं सेनापतिं कृत्वा संहृष्टाः कालचोदिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2040797, "chapter_id": 1905, "verse_number": "५-१५०-५", "content_sanskrit": "अक्षौहिण्यो दशैका च कौरवाणां समागताः ।\nतासां प्रमुखतो भीष्मस्तालकेतुर्व्यरोचत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2040798, "chapter_id": 1905, "verse_number": "५-१५०-६", "content_sanskrit": "यदत्र युक्तं प्राप्तं च तद्विधत्स्व विशांपते ।\nउक्तं भीष्मेण यद्वाक्यं द्रोणेन विदुरेण च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2040799, "chapter_id": 1905, "verse_number": "५-१५०-७", "content_sanskrit": "गान्धार्या धृतराष्ट्रेण समक्षं मम भारत ।\nएतत्ते कथितं राजन्यद्वृत्तं कुरुसंसदि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2040800, "chapter_id": 1905, "verse_number": "५-१५०-८", "content_sanskrit": "साम चादौ प्रयुक्तं मे राजन्सौभ्रात्रमिच्छता ।\nअभेदायास्य वंशस्य प्रजानां च विवृद्धये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2040801, "chapter_id": 1905, "verse_number": "५-१५०-९", "content_sanskrit": "पुनर्भेदश्च मे युक्तो यदा साम न गृह्यते।\nकर्मानुकीर्तनं चैव देवमानुपसंहितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2040802, "chapter_id": 1905, "verse_number": "५-१५०-१०", "content_sanskrit": "यदा नाद्रियते वाक्यं सामपूर्वं सुयोधनः ।\nतदा मया समानीय भेदिताः सर्वपार्थिवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2040803, "chapter_id": 1905, "verse_number": "५-१५०-११", "content_sanskrit": "अद्भुतानि च घोराणि दारुणानि च भारत।\nअमानुषाणि कर्माणि दर्शितानि मया विभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2040804, "chapter_id": 1905, "verse_number": "५-१५०-१२", "content_sanskrit": "निर्भर्त्सयित्वा राज्ञस्तांस्तृणीकृत्य सुयोधनम् ।\nराधेयं भीषयित्वा च सौबलं च पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2040805, "chapter_id": 1905, "verse_number": "५-१५०-१३", "content_sanskrit": "द्यूततो धार्तराष्ट्राणां निन्दां कृत्वा तथा पुनः।\nभेदयित्वा नृपास्नर्वान्वाग्भिर्मन्त्रेम चासकृत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2040806, "chapter_id": 1905, "verse_number": "५-१५०-१४", "content_sanskrit": "पुनः सामाभिसंयुक्तं संप्रदानमथाब्रुवम्।\nअभेदात्कुरुवंशस्य कार्ययोगात्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2040807, "chapter_id": 1905, "verse_number": "५-१५०-१५", "content_sanskrit": "ते शूरा धृतराष्ट्रस्य भीष्मस्य विदुरस्य च ।\nतिष्ठेयुः पाण्डवाः सर्वे हित्वा मानमधश्चराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2040808, "chapter_id": 1905, "verse_number": "५-१५०-१६", "content_sanskrit": "प्रयच्छन्तु च ते राज्यमनीशास्ते भवन्तु च।\nयथाह राजा गाङ्गेयो विदुरश्च हितं तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2040809, "chapter_id": 1905, "verse_number": "५-१५०-१७", "content_sanskrit": "सर्वं भवतु ते राज्यं पञ्च ग्रामान्विसर्जय।\nअवश्यं भरणीया हि पितुस्ते राजसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2040810, "chapter_id": 1905, "verse_number": "५-१५०-१८", "content_sanskrit": "एवमुक्तोऽपि दुष्टात्मा नैव भागं व्यमुञ्चत।\nदण्डं चतुर्थं पश्यामि तेषु पापेषु नान्यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2040811, "chapter_id": 1905, "verse_number": "५-१५०-१९", "content_sanskrit": "निर्याताश्च विनाशाय कुरुक्षेत्रं नराधिपाः ।\nएतत्ते कथितं राजन्यद्वृत्तं कुरुसंसदि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2040812, "chapter_id": 1905, "verse_number": "५-१५०-२०", "content_sanskrit": "न ते राज्यं प्रयच्छन्ति विना युद्धेन पाण्डव ।\nविनाशहेतवः सर्वे प्रत्युपस्थितमृत्यवः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2040813, "chapter_id": 1905, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि पञ्चाशदधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]