[{"id": 7005323000, "chapter_id": 25323, "verse_number": "८-१४-१", "content_sanskrit": "अथ वृत्ते विवाहे तु भवस्यामिततेजसः ।\nप्रहर्षमतुलं गत्वा देवाः सहपितामहाः ।\nतुष्टुवुर्वाग्भिरिष्टाभिः प्रणमन्तो महेश्वरम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005323001, "chapter_id": 25323, "verse_number": "८-१४-२", "content_sanskrit": "नमः पर्वतलिङ्गाय पर्वतेशाय वै नमः ।\nनमः पवनवेगाय विरूपायाजिताय च ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005323002, "chapter_id": 25323, "verse_number": "८-१४-३", "content_sanskrit": "नमः क्लेशविनाशाय दात्रे च शुभसम्पदाम् ।\nनमो नीलशिखण्डाय अम्बिकापतये नमः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005323003, "chapter_id": 25323, "verse_number": "८-१४-४", "content_sanskrit": "नमः पवनरूपाय शतरूपाय वै नमः ।\nनमो भैरवरूपाय विरूपनयनाय च ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005323004, "chapter_id": 25323, "verse_number": "८-१४-५", "content_sanskrit": "नमः सहस्रनेत्राय सहस्रचरणाय च ।\nनमो वेदरहस्याय वेदाङ्गाय नमो नमः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005323005, "chapter_id": 25323, "verse_number": "८-१४-६", "content_sanskrit": "विष्टम्भनाय शक्रस्य बाहोर्वेदाङ्कराय च ।\nचराचराधिपतये शमनाय नमो नमः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005323006, "chapter_id": 25323, "verse_number": "८-१४-७", "content_sanskrit": "सलिलेशयलिङ्गाय युगान्तायतलिङ्गिने ।\nनमः कपालमालाय कपालस्रग्मिणे नमः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005323007, "chapter_id": 25323, "verse_number": "८-१४-८", "content_sanskrit": "नमः कपालहस्ताय दंष्ट्रिणे गदिने नमः ।\nनमस्त्रैलोक्यवाहाय सप्तलोकरथाय च प ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005323008, "chapter_id": 25323, "verse_number": "८-१४-९", "content_sanskrit": "नमः खट्वाङ्गहस्ताय प्रमथार्तिहराय च ।\nनमो यज्ञशिरोहर्त्रे कृष्णकेशापहारिणे ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005323009, "chapter_id": 25323, "verse_number": "८-१४-१०", "content_sanskrit": "भगनेत्रनिपाताय पूष्णो दन्तहराय च ।\nनमः पिनाकशूलासिखड्गमुद्गरधारिणे ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005323010, "chapter_id": 25323, "verse_number": "८-१४-११", "content_sanskrit": "नमोऽस्तु कालकालाय तृतीयनयनाय च ।\nअन्तकान्तकृते चैव नमः पर्वतवासिने ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005323011, "chapter_id": 25323, "verse_number": "८-१४-१२", "content_sanskrit": "सुवर्णरतसे चैव सर्पकुण्डलधारिणे ।\nवाड्वलेर्योगनाशाय योगिनां गुरवे नमः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005323012, "chapter_id": 25323, "verse_number": "८-१४-१३", "content_sanskrit": "शशाङ्कादित्यनेत्राय ललाटनयनाय च ।\nनमः श्मशानरतये श्मशानवरदाय च ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005323013, "chapter_id": 25323, "verse_number": "८-१४-१४", "content_sanskrit": "नमो दैवतनाथाय त्र्यम्बकाय नमो नमः ।\nअशनीशतहासाय ब्रह्मण्यायाजिताय च ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005323014, "chapter_id": 25323, "verse_number": "८-१४-१५", "content_sanskrit": "गृहस्थसाधवे नित्यं जटिने ब्रह्मचारिणे ।\nनमो मुण्डार्धमुण्डाय पशूनां पतये नमः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005323015, "chapter_id": 25323, "verse_number": "८-१४-१६", "content_sanskrit": "सलिले तप्यमानाय योगैश्वर्यप्रदाय च ।\nनमः शान्ताय दान्ताय प्रलयोत्पत्तिकारिणे ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005323016, "chapter_id": 25323, "verse_number": "८-१४-१७", "content_sanskrit": "नमोऽनुग्रहकर्त्रे च स्थितिकर्त्रे नमो नमः ।\nमो रुद्राय वसवे श्रादित्यायाश्विने नमः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005323017, "chapter_id": 25323, "verse_number": "८-१४-१८", "content_sanskrit": "नमः पित्रेऽथ साध्याय विश्वेदेवाय वै नमः ।\nनमः शर्वाय सर्वाय उग्राय वरदाय च ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005323018, "chapter_id": 25323, "verse_number": "८-१४-१९", "content_sanskrit": "नमो भीमाय सेनान्ये पशूनां पतये नमः ।\nशुचये रेरिहाणाय सद्योजाताय वै नमः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005323019, "chapter_id": 25323, "verse_number": "८-१४-२०", "content_sanskrit": "महादेवाय चित्राय नमश्चित्ररथाय च ।\nप्रधानाय प्रमेयाय कार्याय करणाय च ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005323020, "chapter_id": 25323, "verse_number": "८-१४-२१", "content_sanskrit": "पुरुषाय नमस्तेऽस्तु पुरुषेच्छाकराय च ।\nनमः पुरुषसंयोगप्रधान गुणकारिणे ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005323021, "chapter_id": 25323, "verse_number": "८-१४-२२", "content_sanskrit": "प्रवर्तकाय प्रकृतेः पुरुषस्य च सर्वशः ।\nकृताकृतस्य संवेत्त्रे फलसंयोगदाय च ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005323022, "chapter_id": 25323, "verse_number": "८-१४-२३", "content_sanskrit": "कालज्ञाय च सर्वत्र नमो नियमकारिणे ।\nनमो वैषम्यकर्त्रे च गुणानां वृत्तिदाय च ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005323023, "chapter_id": 25323, "verse_number": "८-१४-२४", "content_sanskrit": "नमस्ते देवदेवेश नमस्ते भूतभावन ।\nशिवः सौम्यः सुखो द्रष्टं भव सोमो हि नः प्रभो ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005323024, "chapter_id": 25323, "verse_number": "८-१४-२५", "content_sanskrit": "सनत्कुमार उवाच ।\nएवं स भगवान्देवो जगत्पतिरुमापतिः ।\nस्तूयमानः सुरैः सर्वैरमरानिदमब्रवीत् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005323025, "chapter_id": 25323, "verse_number": "८-१४-२६", "content_sanskrit": "द्रष्टं सुखश्च सौम्यश्च देवानामस्मि भो सुराः ।\nवरं ब्रूत यथेष्टं च दातास्मि वदतानघाः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005323026, "chapter_id": 25323, "verse_number": "८-१४-२७", "content_sanskrit": "ततस्ते प्रणताः सर्वे ऊचुः सब्रह्मकाः सुराः ।\nतवैव भगवन्हस्ते वर एषोऽवतिष्ठताम् ।\nयदा कार्यं तदा नस्त्वं दास्यसे वरमीप्सितम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005323027, "chapter_id": 25323, "verse_number": "८-१४-२८", "content_sanskrit": "एवमस्त्विति तानुक्त्वा विसृज्य च सुरान्हरः ।\nलोकांश्च प्रमथैः सार्धं विवेश भवनं ततः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005323028, "chapter_id": 25323, "verse_number": "८-१४-२९", "content_sanskrit": "यस्तु हरोत्सवमद्भुतमेतं गायति दैवतविप्रसमक्षम् ।\nसोऽप्रतिरूपगणेशसमानो देहविपर्ययमेत्य सुखी स्यात् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005323029, "chapter_id": 25323, "verse_number": "८-१४-३०", "content_sanskrit": "सनत्कुमार उवाच ।\nपाराशर्य स्तवं हीदं शृणुयाद्यः पठेत वा ।\nस स्वर्गलोकगो देवैः पूज्यतेऽमरराडिव ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]