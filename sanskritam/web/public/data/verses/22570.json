[{"id": 7002570000, "chapter_id": 22570, "verse_number": "२-१६-१", "content_sanskrit": "सूत् उवाच ।\nनित्यं नैमित्तिकं चैव यागादौ च समाप्तके ।\nहोमावसाने प्रजपेदुपचारांश्च षोडश ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002570001, "chapter_id": 22570, "verse_number": "२-१६-२", "content_sanskrit": "दद्यात्समीरणं पश्चात्पीठपूजां समाचरत् ।\nगृहीत्वा रक्तपुष्पं च ध्यायेद्वह्निं यथाविधि ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002570002, "chapter_id": 22570, "verse_number": "२-१६-३", "content_sanskrit": "इष्टं शक्तिस्वस्तिकाभीतिमुच्चैर्दीर्घैर्दोर्भिर्धारयन्तं वरांतम् ।\nहेमाकल्पं पद्मसंस्थं त्रिनेत्रं ध्यायेद्वह्निं बद्धमौलिं जटाभिः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002570003, "chapter_id": 22570, "verse_number": "२-१६-४", "content_sanskrit": "पूर्वादिद्वारदेशेषु कामदेवं शतक्रतुम् ।\nवराहं षण्मुखं चैव गंधाद्यैः साधु पूजयेत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002570004, "chapter_id": 22570, "verse_number": "२-१६-५", "content_sanskrit": "आवाह्य स्थापयेत्पश्चादष्टौ मुद्राः प्रदर्शयेत् ।\nदत्त्वासनं स्वागतं च दद्यात्पाद्यादिकत्रयम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002570005, "chapter_id": 22570, "verse_number": "२-१६-६", "content_sanskrit": "अतः पूर्वादिपात्रेषु यावता च हुताशनम् ।\nसुवर्णवर्णममलं समिद्धं सर्वतोमुखम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002570006, "chapter_id": 22570, "verse_number": "२-१६-७", "content_sanskrit": "महोदरं महाजिह्वमाकाशत्वेन पूजयेत् ।\nतारकादीन्समाप्ते च गन्धैः पुष्पैः पृथग्विधैः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002570007, "chapter_id": 22570, "verse_number": "२-१६-८", "content_sanskrit": "तत्रैव जिह्वास्त्रिविधा ध्यायेन्मंत्रपुरःसराः ।\nवक्ष्यमाणेन मंत्रेण उपचारैरनंतरम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002570008, "chapter_id": 22570, "verse_number": "२-१६-९", "content_sanskrit": "त्वमादिः सर्वभूतानां संसारार्णवतारकः ।\nपरमज्योतीरूपस्त्वमासनं सफली कुरु ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002570009, "chapter_id": 22570, "verse_number": "२-१६-१०", "content_sanskrit": "दद्यादासनमेतेन पुष्पगुच्छत्रयेण तु ।\nपुटांजलिं ततो बद्ध्वा पृच्छेत्कुशलपूर्वकम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002570010, "chapter_id": 22570, "verse_number": "२-१६-११", "content_sanskrit": "वैश्वानर नमस्तेऽस्तु नमस्ते हव्यवाहन ।\nस्वागतं तु सुरश्रेष्ठ शांतिं कुरु नमोऽस्तु ते ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002570011, "chapter_id": 22570, "verse_number": "२-१६-१२", "content_sanskrit": "नमस्ते भगवन्देव आपोनारायणात्मक ।\nसर्वलोकहितार्थाय पाद्यं च प्रतिगृह्यताम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002570012, "chapter_id": 22570, "verse_number": "२-१६-१३", "content_sanskrit": "नारायणपरं धाम ज्योतीरूप सनातन ।\nगृहाणार्घ्यं मया दत्तं विश्वरूप नमोऽस्तु ते ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002570013, "chapter_id": 22570, "verse_number": "२-१६-१४", "content_sanskrit": "जगदादित्यरूपेण प्रकाशयति यः सदा ।\nतस्मै प्रकाशरू पाय नमस्ते जातवेदसे ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002570014, "chapter_id": 22570, "verse_number": "२-१६-१५", "content_sanskrit": "धनंजय नमस्तेऽस्तु सर्वपापप्रणाशन ।\nस्नानीयं ते मया दत्तं सर्वकामार्थसिद्धये ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002570015, "chapter_id": 22570, "verse_number": "२-१६-१६", "content_sanskrit": "हुताशन महाबाहो देवदेव सनातन ।\nशरणं ते प्रयच्छामि देहि मे परमं पदम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002570016, "chapter_id": 22570, "verse_number": "२-१६-१७", "content_sanskrit": "ज्योतिषां ज्योतीरूपस्त्वमनादिनिधनाच्युत ।\nमया दत्तमलंकारमलंकुरु नमोस्तु ते ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002570017, "chapter_id": 22570, "verse_number": "२-१६-१८", "content_sanskrit": "देवीदेवा मुदं यांति यस्य सम्यक्समागमात् ।\nसर्वदोषोपशांत्यर्थ गन्धोऽयं प्रतिगृह्यताम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002570018, "chapter_id": 22570, "verse_number": "२-१६-१९", "content_sanskrit": "त्वं विष्णुस्त्वं हि ब्रह्मा च ज्योतिषां गतिरीश्वर ।\nगृहाण पुष्पं देवेश सानुलेपं जगद्भवेत् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002570019, "chapter_id": 22570, "verse_number": "२-१६-२०", "content_sanskrit": "देवतानां पितॄणां च सुखमेकं सनातनम् ।\nधूपोऽयं देवदेवेश गृह्यतां मे धनंजय ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002570020, "chapter_id": 22570, "verse_number": "२-१६-२१", "content_sanskrit": "त्वमेकः सर्वभूतेषु स्थावरेषु चरेषु च ।\nपरमात्मा पराकारः प्रदीपः प्रतिगृह्यताम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002570021, "chapter_id": 22570, "verse_number": "२-१६-२२", "content_sanskrit": "नमोऽस्तु यज्ञपतये प्रभवे जातवेदसे ।\nसर्वलोकहितार्थाय नैवेद्यं प्रतिगृह्यताम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002570022, "chapter_id": 22570, "verse_number": "२-१६-२३", "content_sanskrit": "हुताशन नमस्तुभ्यं नमस्ते रुक्मवाहन ।\nलोकनाथ नमस्तेऽस्तु नमस्ते जातवेदसे ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002570023, "chapter_id": 22570, "verse_number": "२-१६-२४", "content_sanskrit": "इत्यनेन तु मन्त्रेण दद्याद्दिव्येऽप्यधीतकम् ।\nसर्वस्वं यज्ञसूत्रं च परमान्नं समाक्षिकम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]