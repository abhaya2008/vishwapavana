[{"id": 7006283000, "chapter_id": 26283, "verse_number": "३-३७-१", "content_sanskrit": "हयग्रीव उवाच सर्वज्ञद्यन्तरालस्योपरिष्टात्कलशोद्भव ।\nहस्तविंशतिरुन्नम्रं चतुर्नल्वप्रविस्तरम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006283001, "chapter_id": 26283, "verse_number": "३-३७-२", "content_sanskrit": "वशिन्याद्यन्तरं ज्ञेयं प्राग्वत्सोपानमन्दिरम् ।\nसर्वरोगहरं नाम्ना तच्चक्रमिति विश्रुतम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006283002, "chapter_id": 26283, "verse_number": "३-३७-३", "content_sanskrit": "वशिन्याद्यास्तत्र देव्यः पूर्वादिदिगनुक्रमात् ।\nस्वरैस्तु रहितास्तत्र प्रथमा वशिनीश्वरी ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006283003, "chapter_id": 26283, "verse_number": "३-३७-४", "content_sanskrit": "कवर्गसहिता पश्चात्कामेश्वर्याख्यवाह्मयी ।\nचवर्गजुष्टा वागीशी मोदिनी स्यात्तृतीयका ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006283004, "chapter_id": 26283, "verse_number": "३-३७-५", "content_sanskrit": "टवर्गमण्डिताकारा विमलाख्या सरस्वती ।\nतवर्गेण तथोपेता पञ्चमी वाक्प्रधारणा ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006283005, "chapter_id": 26283, "verse_number": "३-३७-६", "content_sanskrit": "पवर्गेण परिस्फीता षष्ठी तु जयिनी मता ।\nयादिवर्णचतुष्कोणे सर्वैश्वर्यादिवाङ्मयी ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006283006, "chapter_id": 26283, "verse_number": "३-३७-७", "content_sanskrit": "साधिकाक्षरषट्केन कौलिनी त्वष्टमी मता ।\nएता देव्यो जपरता मुक्ताभरणमण्डिताः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006283007, "chapter_id": 26283, "verse_number": "३-३७-८", "content_sanskrit": "सदा स्फुरद्गद्यपद्यलहरीलालिता मताः ।\nकाव्यैश्च नाटकैश्चैव मधुरैः कर्णहारिभिः ।\nविनोदयन्त्यः श्रीदेवीं वर्तन्ते कुम्भसम्भवः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006283008, "chapter_id": 26283, "verse_number": "३-३७-९", "content_sanskrit": "एता रहस्यनाम्नैव ख्याता वातापितापन ।\nनायिका स्वस्य चक्रस्य सिद्धानाम्ना प्रकीर्तिता ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006283009, "chapter_id": 26283, "verse_number": "३-३७-१०", "content_sanskrit": "अस्य चक्रस्य संरक्षाकारिणी खेचरी मता ।\nवशिन्याद्यन्तरालस्योपरिष्टाद्विन्ध्यमर्दन ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006283010, "chapter_id": 26283, "verse_number": "३-३७-११", "content_sanskrit": "हस्तविंशतिरुन्नम्रं चतुर्नल्वप्रविस्तरम् ।\nअस्त्रं चक्रमितिज्ञेयं तत्र बाणादिदेवताः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006283011, "chapter_id": 26283, "verse_number": "३-३७-१२", "content_sanskrit": "पञ्च बाणेश्वरीदेव्यः पञ्च कामेश्वराशुगाः ।\nअङ्कुशद्वितयं दीप्तमादिस्त्रीपुंसयोर्द्वयोः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006283012, "chapter_id": 26283, "verse_number": "३-३७-१३", "content_sanskrit": "धनुर्द्वयं च विन्ध्यारे नव पुण्ड्रेषु कल्पितम् ।\nपाशद्वयं च दीप्ताभं चत्वार्यस्त्राणि कुम्भज ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006283013, "chapter_id": 26283, "verse_number": "३-३७-१४", "content_sanskrit": "कामेश्वर्यास्तु चत्वारि चत्वारि श्रीमहेशितुः ।\nआहत्याष्टायुधानीति प्रज्वलन्ति विभान्ति च ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006283014, "chapter_id": 26283, "verse_number": "३-३७-१५", "content_sanskrit": "भण्डासुरमहायुद्धे दुष्टदानवशोणितैः ।\nपीतैरतीव तृप्तानिदिव्यास्त्राण्यति जाग्रति ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006283015, "chapter_id": 26283, "verse_number": "३-३७-१६", "content_sanskrit": "एतेषामायुधानां तु परिवारायुधान्यलम् ।\nवर्तन्तेऽस्त्रान्तरे तत्र तेषां संख्या तु कोटिशः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006283016, "chapter_id": 26283, "verse_number": "३-३७-१७", "content_sanskrit": "वज्रशक्तिः शतघ्नी च भुशुण्डी मुसलं तथा ।\nकृपाणः पट्टिशं चैव मुद्गरं भिन्दिपालकम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006283017, "chapter_id": 26283, "verse_number": "३-३७-१८", "content_sanskrit": "एवमादीनि शस्त्राणि सहस्राणां सहस्रशः ।\nअष्टायुधमहाशक्तीः सेवन्ते मदविह्वलाः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006283018, "chapter_id": 26283, "verse_number": "३-३७-१९", "content_sanskrit": "अथ शस्त्रान्तरालस्योपरि वातापितापन ।\nहस्तविंशतिरुन्नम्रं चतुर्नल्वप्रविस्तरम् ।\nधिष्ण्यं तु समयेशीनां स्थानं च तिसृणां मतम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006283019, "chapter_id": 26283, "verse_number": "३-३७-२०", "content_sanskrit": "कामेशाद्यास्तत्र देव्यस्तिस्रोऽन्या तु चतुर्थिका ।\nसैव निःशेषविश्वानां सवित्री ललितेश्वरी ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006283020, "chapter_id": 26283, "verse_number": "३-३७-२१", "content_sanskrit": "तिसृणां शृणु नामानि कामेशी प्रथमा मता ।\nवज्रेशी भगमाला च ताः सेवन्ते सहस्रशः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006283021, "chapter_id": 26283, "verse_number": "३-३७-२२", "content_sanskrit": "सर्वेषां दर्शनानां च या देव्यो विविधाः स्मृताः ।\nताः सर्वास्तत्र सेवन्ते कामेशादिमहोदयाः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006283022, "chapter_id": 26283, "verse_number": "३-३७-२३", "content_sanskrit": "एतासांच प्रसंगेषु नित्यानां च प्रसञ्जने ।\nचक्रिणीनां योगिनीनां श्रीदेवी पूरणात्मिका ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006283023, "chapter_id": 26283, "verse_number": "३-३७-२४", "content_sanskrit": "या कामेश्वरदेवाङ्कशायिनी ललितांबिका ।\nकामेश्यादिचतुर्थी सा नित्यानां षोडशी मता ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006283024, "chapter_id": 26283, "verse_number": "३-३७-२५", "content_sanskrit": "योगिनी चक्रदेवीनां नवमी परिकीर्तिता ।\nसमयेश्यन्तरालस्योपरिष्टादिल्वलान्तक ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006283025, "chapter_id": 26283, "verse_number": "३-३७-२६", "content_sanskrit": "नाथान्तरमिति प्रोक्तं हस्तविंशतिरुन्नतम् ।\nचतुर्नल्वप्रविस्तारं प्राग्वत्सोपानमण्डितम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006283026, "chapter_id": 26283, "verse_number": "३-३७-२७", "content_sanskrit": "तत्र नाथामहादेव्या योगशास्त्रप्रवर्त्तकाः ।\nसर्वेषां मन्त्रगुरवः सर्वविद्यामहार्णवाः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006283027, "chapter_id": 26283, "verse_number": "३-३७-२८", "content_sanskrit": "चत्वारो यागनाथाश्च लोकानामिह गुप्तये ।\nसृष्टाः कामंशदेवेन तेषां नामानि मे शृणु ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006283028, "chapter_id": 26283, "verse_number": "३-३७-२९", "content_sanskrit": "मित्री च शोडिशश्चैव चर्याख्यः कुम्भसम्भव ।\nतैः सृष्टा बहवो लोकारक्षार्थं पादुकात्मकाः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006283029, "chapter_id": 26283, "verse_number": "३-३७-३०", "content_sanskrit": "दिव्यविद्या मानवौघसिद्धौघाः सुरतापसाः ।\nप्राप्तसालोक्यसारूप्यसायुज्यादिकसिद्धयः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006283030, "chapter_id": 26283, "verse_number": "३-३७-३१", "content_sanskrit": "महान्तो गुरवस्तांस्तु सेवन्ते प्रचुरा गुरून् ।\nअथ नाथान्तरालस्योपरिष्टाद्धिष्ण्यमुत्तमम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006283031, "chapter_id": 26283, "verse_number": "३-३७-३२", "content_sanskrit": "हस्तविंशतिरुन्नमं चतुर्नल्वप्रविस्तरम् ।\nनित्यान्तरमिति प्रोक्तं नित्याः पञ्चदशात्र वै ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006283032, "chapter_id": 26283, "verse_number": "३-३७-३३", "content_sanskrit": "अथ कामेश्वरी नित्या नित्या च भगमालिनी ।\nनित्यक्लिन्ना अपि तथा भेरुण्डा वह्निवासिनी ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006283033, "chapter_id": 26283, "verse_number": "३-३७-३४", "content_sanskrit": "महावज्रेश्वरी दूती त्वरिता कुलसुन्दरी ।\nनित्या नीलपताका च विजया सर्वमङ्गला ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006283034, "chapter_id": 26283, "verse_number": "३-३७-३५", "content_sanskrit": "ज्वालामालिनिका चित्रेत्येताः पञ्चदशोदिताः ।\nएता देवीस्वरूपाः स्युर्महाबलपराक्रमाः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006283035, "chapter_id": 26283, "verse_number": "३-३७-३६", "content_sanskrit": "प्रथमा मुख्यतिथितां प्राप्ता व्याप्य जगत्त्रयाः ।\nकालत्रितयरूपाश्च कालग्रासविचक्षणाः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006283036, "chapter_id": 26283, "verse_number": "३-३७-३७", "content_sanskrit": "ब्रह्मादीनामशेषाणां चिरकालमुपेयुषाम् ।\nतत्तत्कालशतायुष्यरूपा देव्याज्ञया स्थिताः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006283037, "chapter_id": 26283, "verse_number": "३-३७-३८", "content_sanskrit": "नित्योद्यता निरान्तकाः श्रीपराङ्गसमुद्भवाः ।\nसेवन्ते जगतामृद्ध्यै ललितां चित्स्वरूपिणीम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006283038, "chapter_id": 26283, "verse_number": "३-३७-३९", "content_sanskrit": "तासां भवनतां प्राप्ता दीप्ताः पञ्चदशेश्वराः ।\nविसृष्टिबिन्दुचक्रे तु षोडश्या भवनं मतम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006283039, "chapter_id": 26283, "verse_number": "३-३७-४०", "content_sanskrit": "अथ नित्यान्तरालस्योपरिष्टात्कुम्भसम्भव ।\nअङ्गदेव्यन्तरं प्रोक्तं हस्तविंशातिरुन्नतम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006283040, "chapter_id": 26283, "verse_number": "३-३७-४१", "content_sanskrit": "चतुर्नल्वप्रविस्तारं प्राग्वत्सोपानमन्दिरम् ।\nतस्मिन्हृदयदेव्याद्याः शक्तयः संति वै मुने ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006283041, "chapter_id": 26283, "verse_number": "३-३७-४२", "content_sanskrit": "हृद्देवी च शिरोदेवी शिखादेवी तथैव च ।\nवर्मदेवी दृष्टिदेवी शस्त्रदेवी षडीरिताः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006283042, "chapter_id": 26283, "verse_number": "३-३७-४३", "content_sanskrit": "अत्यन्तसन्निकृष्टास्ताः श्रीकामेश्वरसुभ्रुवः ।\nनवलावण्यपूर्णाङ्ग्यः सावधाना धृतायुधाः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006283043, "chapter_id": 26283, "verse_number": "३-३७-४४", "content_sanskrit": "परितो बिन्दुपीठे च भ्राम्यन्तो दृप्तमूर्तयः ।\nललिताज्ञाप्रवर्तिन्यो वशीनां पीठवर्तिकाः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006283044, "chapter_id": 26283, "verse_number": "३-३७-४५", "content_sanskrit": "अथाङ्गदेव्यन्तरस्योपरिष्टान्मण्डलाकृति ।\nबिन्दुनाद महापीठं दशहस्तसमुन्नतम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006283045, "chapter_id": 26283, "verse_number": "३-३७-४६", "content_sanskrit": "नल्वाष्टकप्रविस्तारमुद्यदादित्यसंनिभम् ।\nबिन्दुपीठमिदं ज्ञेयं श्रीपीठमपि चेष्यते ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006283046, "chapter_id": 26283, "verse_number": "३-३७-४७", "content_sanskrit": "महापीठमिति ज्ञेयं विद्यापीठमपीष्यते ।\nआनन्दपीठमपि च पञ्चाशत्पीठरूपधृक् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006283047, "chapter_id": 26283, "verse_number": "३-३७-४८", "content_sanskrit": "तत्र श्रीललितादेव्याः पञ्चब्रह्ममये महत् ।\nजागर्ति मञ्चरत्नं तु प्रपञ्चत्रयमूलकम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006283048, "chapter_id": 26283, "verse_number": "३-३७-४९", "content_sanskrit": "तस्य मञ्चस्य पादास्तु चत्वारः परिकीर्तिताः ।\nदशहस्तसमुन्नम्रा हस्तत्रितयविष्ठिताः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006283049, "chapter_id": 26283, "verse_number": "३-३७-५०", "content_sanskrit": "ब्रह्मविष्णुमहेशानेश्वररूपत्वमागताः ।\nशक्तिभावमनुप्राप्ताः सदा श्रीध्यानयोगतः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006283050, "chapter_id": 26283, "verse_number": "३-३७-५१", "content_sanskrit": "एकस्तु पञ्चपादः स्याज्जपाकुसुमसन्निभः ।\nब्रह्मात्मकः स विज्ञेयो वह्निदिग्भागमाश्रितः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006283051, "chapter_id": 26283, "verse_number": "३-३७-५२", "content_sanskrit": "चतुर्थो मञ्चपादस्तु कर्णिकारकसाररुक् ।\nईश्वरात्मा स विज्ञेय ईशदिग्भागमाश्रितः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006283052, "chapter_id": 26283, "verse_number": "३-३७-५३", "content_sanskrit": "एते सर्वे सायुधाश्च सर्वालङ्कारभूषिताः ।\nउपर्यधःस्तंभरूपा मध्ये पुरुषरूपिणः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006283053, "chapter_id": 26283, "verse_number": "३-३७-५४", "content_sanskrit": "श्रीध्यानमीलिताक्षाश्च श्रीध्यानान्निश्चलाङ्गकाः ।\nतेषामुपरि मञ्चस्य फलकस्तु सदाशिवः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006283054, "chapter_id": 26283, "verse_number": "३-३७-५५", "content_sanskrit": "विकासिदाडिमच्छायश्चतुर्नल्वप्रविस्तरः ।\nनल्वषट्कायामवांश्च सदाभास्वरमूर्तिमान् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006283055, "chapter_id": 26283, "verse_number": "३-३७-५६", "content_sanskrit": "अङ्गदेव्यन्तरारंभान्मञ्चस्य फलकावधि ।\nचिन्तामणिमयाङ्गानि तत्त्वरूपाणि तापस ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006283056, "chapter_id": 26283, "verse_number": "३-३७-५७", "content_sanskrit": "सोपानानि विभासंते षट्त्रिंशद्वै निवेशनैः ।\nआरोहस्य क्रमेणैव सोपानान्यभिदध्महे ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006283057, "chapter_id": 26283, "verse_number": "३-३७-५८", "content_sanskrit": "भूमिरापोऽनलो वायुराकाशो गन्ध एव च ।\nरसो रूपं स्पर्शसंब्दोपस्थपायुपदानि च ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006283058, "chapter_id": 26283, "verse_number": "३-३७-५९", "content_sanskrit": "पाणिवाग्घ्राणजिह्वाश्चत्वक्चक्षुः श्रोत्रमेव च ।\nअहङ्कारश्च बुद्धिश्च मनः प्रकृतिपूरुषौ ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006283059, "chapter_id": 26283, "verse_number": "३-३७-६०", "content_sanskrit": "नियतिः कालरागौ च कला विद्ये च मायया ।\nशुद्धाविद्येश्वरसदाशिवशक्तिः शिवा इति ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006283060, "chapter_id": 26283, "verse_number": "३-३७-६१", "content_sanskrit": "एताः षट्त्रिंशदाख्यातास्तत्त्वसोपानपङ्क्तयः ।\nपूषा सोपानपङ्क्तिश्च मञ्चपूर्वदिशंश्रिताः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006283061, "chapter_id": 26283, "verse_number": "३-३७-६२", "content_sanskrit": "अथ मञ्चस्योपरिष्टाद्धंसतूलिकतल्पकः ।\nहस्तमात्रं समुन्नम्रं चतुर्नल्वप्रविस्तरम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006283062, "chapter_id": 26283, "verse_number": "३-३७-६३", "content_sanskrit": "पादोपधानमूर्धोपधान दन्द्वविराजितम् ।\nगड्डकानां चतुः षष्टिशोभितं पाटलत्विषा ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006283063, "chapter_id": 26283, "verse_number": "३-३७-६४", "content_sanskrit": "तस्योपरिष्टात्कौसुंभवसनेनोत्तरच्छदः ।\nशुचिना मृदुना कॢप्तः पद्मरागमणित्विषा ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006283064, "chapter_id": 26283, "verse_number": "३-३७-६५", "content_sanskrit": "तस्योपरि वसन्पूर्वदिङ्मुखो दययान्वितः ।\nशृङ्गारवेषरुचिरस्सदा षोडशवार्षिकः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006283065, "chapter_id": 26283, "verse_number": "३-३७-६६", "content_sanskrit": "उद्यद्भास्करबिंबाभश्चतुर्हस्तस्त्रिलोचनः ।\nहारकेयूरमुकुटकटकाद्यैरलङ्कृतः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006283066, "chapter_id": 26283, "verse_number": "३-३७-६७", "content_sanskrit": "कमनीयस्मितज्योत्स्नामरिपूर्णकपोलभूः ।\nजागर्ति भगवानादिदेवः कामेश्वरः शिवः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006283067, "chapter_id": 26283, "verse_number": "३-३७-६८", "content_sanskrit": "तस्योत्संगे समासीना तरुणादित्यपाटला ।\nसदा षोडशवर्षा च नवयौवनदर्पिता ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006283068, "chapter_id": 26283, "verse_number": "३-३७-६९", "content_sanskrit": "अमृष्टपद्मरागाभा चन्दनाब्जनखच्छटा ।\nयावकश्रीर्निर्व्यपेक्षा पादलौहित्यवाहिनी ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006283069, "chapter_id": 26283, "verse_number": "३-३७-७०", "content_sanskrit": "कलनिस्वानमञ्जीरपतत्कङ्कणमोहना ।\nअनङ्गवरतूणीरदर्पोन्मथनजङ्घिका ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006283070, "chapter_id": 26283, "verse_number": "३-३७-७१", "content_sanskrit": "करिशुण्डदोः कदलिकाकान्तितुल्योरुशोभिनी ।\nअरुणेन दुकूलेन सुस्पर्शेन तनीयसा ।\nअलङ्कृतनितंबाढ्या जघनाभोगभासुरा ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006283071, "chapter_id": 26283, "verse_number": "३-३७-७२", "content_sanskrit": "अर्धोरुकग्रन्थिमती रत्नकाञ्चीविराजिता ।\nनतनाभिमहावर्तत्रि वल्यूर्मिप्रभासरित् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006283072, "chapter_id": 26283, "verse_number": "३-३७-७३", "content_sanskrit": "स्तनकुड्मलहिन्दोलमुक्तादामशतावृता ।\nअतिपीवरवक्षोजभारभङ्गुरमध्यभूः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006283073, "chapter_id": 26283, "verse_number": "३-३७-७४", "content_sanskrit": "शिरीषदाममृदुलच्छदाभांश्चतुरो भुजान् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006283074, "chapter_id": 26283, "verse_number": "३-३७-७५", "content_sanskrit": "केयूरकङ्कणश्रेणीमण्डितान्सोर्मिकाङ्गुलीन् ।\nवहन्ती पतिसंसृष्टशङ्खसुन्दरकन्धरा ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006283075, "chapter_id": 26283, "verse_number": "३-३७-७६", "content_sanskrit": "मुखदर्पण वृत्ताभचिबुका पाटलाधरा ।\nशुचिभिः पङ्क्तिशुद्धैस्च विद्यारूपैर्विभास्वरैः ।\nकुन्दकुड्मललक्ष्मीकैर्दन्तैर्दर्शितचन्द्रिका ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7006283076, "chapter_id": 26283, "verse_number": "३-३७-७७", "content_sanskrit": "स्थूलमौक्तिकसनद्धनानाभरणभासुरा ।\nकेतकान्तर्दलश्रोणी दीर्घदीर्घविलोचना ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7006283077, "chapter_id": 26283, "verse_number": "३-३७-७८", "content_sanskrit": "अर्धेन्दुललिते भाले सम्यक्कॢप्तालकच्छटा ।\nपालीवतं समाणिक्यकुण्डलामण्डितश्रुतिः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7006283078, "chapter_id": 26283, "verse_number": "३-३७-७९", "content_sanskrit": "नवकर्पूरकस्तूरीसदामोदितवीटिका ।\nशरच्चञ्चन्निशानाथमण्डलीमधुरानना ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7006283079, "chapter_id": 26283, "verse_number": "३-३७-८०", "content_sanskrit": "चिन्तामणीनां सारेण कॢप्तचारुकिरीटिका ।\nस्फुरत्तिलकरत्नाभभालनेत्रविराजिता ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7006283080, "chapter_id": 26283, "verse_number": "३-३७-८१", "content_sanskrit": "गाढान्धकारनिबिडक्षामकुन्तलसंहतिः ।\nसीमन्तरेशाविन्यस्तकिन्दूरश्रेणिभासुरा ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7006283081, "chapter_id": 26283, "verse_number": "३-३७-८२", "content_sanskrit": "स्फुरच्चन्द्रकलोत्तंसमदलोलविलोचना ।\nसर्वशृङ्गारवेषाढ्या सर्वाभरणभूषिता ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7006283082, "chapter_id": 26283, "verse_number": "३-३७-८३", "content_sanskrit": "समस्तलोकमाता च सदानन्दविवर्धिनी ।\nब्रह्मविष्णुगिरीशेशसदाशिवनिदानभूः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7006283083, "chapter_id": 26283, "verse_number": "३-३७-८४", "content_sanskrit": "अपाङ्गरिङ्खत्करुणानिर्झरीतर्पिताखिला ।\nभासते सा भगवती पापघ्नी ललितांबिका ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7006283084, "chapter_id": 26283, "verse_number": "३-३७-८५", "content_sanskrit": "अन्यदैवतपूजानां यस्याः पूजाफलं विदुः ।\nयस्याः पूजाफलं प्राहुयस्या एव हि पूजनम् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7006283085, "chapter_id": 26283, "verse_number": "३-३७-८६", "content_sanskrit": "तस्याश्च ललितादेव्या वर्णयामि कथं पुनः ।\nवर्षकोटिसहस्रेणाप्येकांशो वर्ण्यते न हि ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7006283086, "chapter_id": 26283, "verse_number": "३-३७-८७", "content_sanskrit": "वर्ण्यमाना ह्यवाग्रूपा वाचस्तस्यां कुतो गतिः ।\nयतो वाचो निवर्तन्ते अप्राप्य मनसा सह ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7006283087, "chapter_id": 26283, "verse_number": "३-३७-८८", "content_sanskrit": "बहुना किमिहोक्तेन तत्त्वभूतमिदं शृणु ।\nन पक्षपातान्न स्नेहान्न मोहाद्वा मयोच्यते ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7006283088, "chapter_id": 26283, "verse_number": "३-३७-८९", "content_sanskrit": "संतु कल्पतरोः शाखा लेखिन्यस्तपसां निधे ।\nमषीपात्राणि सर्वेऽपि सप्त संतु महार्णवाः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7006283089, "chapter_id": 26283, "verse_number": "३-३७-९०", "content_sanskrit": "पञ्चाशत्कोटिविस्तीर्णा भूमिः पत्रत्वमृच्छतु ।\nतस्य लेखनकालोऽस्तु परार्ध्याधिकवत्सरैः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7006283090, "chapter_id": 26283, "verse_number": "३-३७-९१", "content_sanskrit": "लिखन्तु सर्वे लोकाश्च प्रत्येकं कोटिबाहवः ।\nसर्वे बृहस्पतिसमा वक्तारो यदि कुंभज ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7006283091, "chapter_id": 26283, "verse_number": "३-३७-९२", "content_sanskrit": "अथापि तस्याः श्रीदेव्याः पादाब्जैकाङ्गुलिद्युतेः ।\nसहस्रांशेष्वेकैकांशवर्णना न हि जायते ।\nअथ वा वृत्तिरखिला निष्फला तद्गुणस्तुतौ ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7006283092, "chapter_id": 26283, "verse_number": "३-३७-९३", "content_sanskrit": "बिन्दुपीठस्य परितश्चतुरस्रवया स्थिता ।\nमहामायाजवनिका लंबते मेचकप्रभा ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7006283093, "chapter_id": 26283, "verse_number": "३-३७-९४", "content_sanskrit": "देव्या उपरि हस्तानां विंशतिद्वितयोर्ध्वतः ।\nइन्द्रगोपवितानं तु बद्धं त्रैलोक्यदुर्लभम् ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7006283094, "chapter_id": 26283, "verse_number": "३-३७-९५", "content_sanskrit": "तत्रालङ्कारजालं तु वर्तमानं सुदुर्लभम् ।\nमद्वाणी वर्णयिष्यन्ती कण्ठ एव ह्रिया हता ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7006283095, "chapter_id": 26283, "verse_number": "३-३७-९६", "content_sanskrit": "सैव जानाति तत्सर्वं तत्रत्यमखिलं गुणम् ।\nमनसोऽपि हि दूरे तत्सौभाग्यं केनवर्ण्यते ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7006283096, "chapter_id": 26283, "verse_number": "३-३७-९७", "content_sanskrit": "इत्थं भण्डमहादैत्यवधाय ललितांबिका ।\nप्रादुर्भुता चिदनलाद्दग्धनिःशेषदानवा ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7006283097, "chapter_id": 26283, "verse_number": "३-३७-९८", "content_sanskrit": "दिव्यशिल्पिजनैः कॢप्तं षोडशक्षेत्रवेशनम् ।\nअधिष्ठाय श्रीनगरं सदा रक्षति विष्टपम् ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7006283098, "chapter_id": 26283, "verse_number": "३-३७-९९", "content_sanskrit": "इत्थमेव प्रकारेण श्रीपुराण्यन्यकान्यपि ।\nन भेदकोऽपि विन्यासो नाममात्रं पुरां भिदा ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7006283099, "chapter_id": 26283, "verse_number": "३-३७-१००", "content_sanskrit": "नानावृक्षमहोद्यानमारभ्येतिक्रमेण ये ।\nवदन्ति श्रीपुरकथां ते यान्ति परमां गतिम् ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7006283100, "chapter_id": 26283, "verse_number": "३-३७-१०१", "content_sanskrit": "आकर्णयन्ति पृच्छन्ति विचिन्वन्ति च ये नराः ।\nये पुस्तके धारयन्ति ते यान्ति परमां गतिम् ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7006283101, "chapter_id": 26283, "verse_number": "३-३७-१०२", "content_sanskrit": "ये श्रीपुरप्रकारेण तत्तत्स्थानविभेदतः ।\nकृत्वा शिल्पिजनैः सर्वं श्रीदेव्यायतनं महत् ।\nसंपादयन्ति ये भक्तास्ते यान्ति परमां गतिम् ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}]