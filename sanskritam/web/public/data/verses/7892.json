[{"id": 33000125, "chapter_id": 7892, "verse_number": "1", "content_sanskrit": "ह्लादते नर्दति नदत्यपि गर्जति गुञ्जति । कूजति क्षीजति गुजत्यपि गजति गृञ्जति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1, "avatarnika": ""}, {"id": 33000126, "chapter_id": 7892, "verse_number": "2", "content_sanskrit": "रेभते शिञ्जति रणत्येवं व्रणति मुञ्जति । अम्बते लम्बते वेटत्यणति क्वणतीति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2, "avatarnika": ""}, {"id": 33000127, "chapter_id": 7892, "verse_number": "3", "content_sanskrit": "शब्दायते कणति च रौति भ्रणति रासते । वणति ध्रणति ह्रादते च ध्वनति नासते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3, "avatarnika": ""}, {"id": 33000128, "chapter_id": 7892, "verse_number": "4", "content_sanskrit": "कल्लते कौति वनति ध्वनयत्यपि मोजति । कवते तोसति रसत्यपि ह्रसति रायति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4, "avatarnika": ""}, {"id": 33000129, "chapter_id": 7892, "verse_number": "5", "content_sanskrit": "गवते घोषति रवीत्यपि स्यमति कायति । ङवते घवते क्नूयतेऽवते स्वनतीति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5, "avatarnika": ""}, {"id": 33000130, "chapter_id": 7892, "verse_number": "6", "content_sanskrit": "रम्भते खवते गर्जयत्येते शब्दवाचिनः। भषते बुक्कयति च बुक्कतीति शुनां ध्वनौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6, "avatarnika": ""}, {"id": 33000131, "chapter_id": 7892, "verse_number": "7", "content_sanskrit": "रिणाति रेषते वार्के तिरश्चां वाश्यते ध्वनौ । द्राङ्क्षति ध्राङ्क्षति ध्वाङ्क्षत्येते स्युर्घोरवाशिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7, "avatarnika": ""}, {"id": 33000132, "chapter_id": 7892, "verse_number": "8", "content_sanskrit": "घुरत्यार्ते च कुरति तारे कोचति निःस्वने । हेषते ह्रेषतेऽश्वानां हस्तिनां बृंहतीति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8, "avatarnika": ""}, {"id": 33000133, "chapter_id": 7892, "verse_number": "9", "content_sanskrit": "जीमूतानां स्तनयति गदयत्यपि गर्जति । स्फूर्जत्यशनि निर्घोष उत्कण्ठास्वन आनुते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9, "avatarnika": ""}, {"id": 33000134, "chapter_id": 7892, "verse_number": "10", "content_sanskrit": "उच्चर्चति च सङ्क्रीडत्येते शकटकूजने । हिक्कते हिक्कतीत्येतौ हिक्कायां क्षौति तु क्षुते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10, "avatarnika": ""}, {"id": 33000135, "chapter_id": 7892, "verse_number": "11", "content_sanskrit": "कासते कफजे शब्दे सौरते मणतीत्यदः। कौक्षे कर्दत्यपानोत्थे पर्दते शर्धते पदे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11, "avatarnika": ""}, {"id": 33000136, "chapter_id": 7892, "verse_number": "12", "content_sanskrit": "चीत्करोति टङ्करोति करिकार्मुकयोः क्रमात्‌ । द्वावात्मनेऽपि भूषादेः शिङ्क्ते गीते तु गायति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12, "avatarnika": ""}, {"id": 33000137, "chapter_id": 7892, "verse_number": "13", "content_sanskrit": "उपवीणयतीत्येतदुपगाने हि वीणया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13, "avatarnika": ""}]