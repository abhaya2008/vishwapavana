[{"id": 7005276000, "chapter_id": 25276, "verse_number": "७-४-११-१", "content_sanskrit": "प्रह्लाद उवाच ।\nततो गच्छेद्द्विजश्रेष्ठास्तीर्थं विष्णुपदोद्भवम् ।\nयस्य दर्शनमात्रेण गंगास्नानफलं लभेत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005276001, "chapter_id": 25276, "verse_number": "७-४-११-२", "content_sanskrit": "यस्योत्पत्तिर्मया पूर्वं कथिता द्विजसत्तमाः ।\nयस्य संस्मरणादेव कीर्तनात्पापनाशनम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005276002, "chapter_id": 25276, "verse_number": "७-४-११-३", "content_sanskrit": "हरिणा या समानीता रुक्मिण्यर्थे महात्मना ।\nयस्या गण्डूषमात्रेण हयमेधफलं लभेत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005276003, "chapter_id": 25276, "verse_number": "७-४-११-४", "content_sanskrit": "विष्णोः पादप्रसूताया वैष्णवीति च विश्रुता ।\nतत्र गत्वा महाभाग गृहीत्वाऽर्घ्यं विधानतः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005276004, "chapter_id": 25276, "verse_number": "७-४-११-५", "content_sanskrit": "नमस्ये त्वां भगवति विष्णुपादतलोद्भवे ।\nगृहाणार्घ्यमिदं देवि गंगे त्वं हरिणा सह ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005276005, "chapter_id": 25276, "verse_number": "७-४-११-६", "content_sanskrit": "इत्युच्चार्य द्विजश्रेष्ठा मृदमालभ्य पाणिना ।\nप्राङ्मुखः संयतो भूत्वा स्नानं कुर्यादतन्द्रितः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005276006, "chapter_id": 25276, "verse_number": "७-४-११-७", "content_sanskrit": "देवान्पितॄन्मनुष्यांश्च तर्पितव्यं तिलाक्षतैः ।\nउपहृत्योपहारांश्च ह्याहूय ब्राह्मणांस्ततः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005276007, "chapter_id": 25276, "verse_number": "७-४-११-८", "content_sanskrit": "श्रद्धया परया युक्तः श्राद्धं कुर्याद्विचक्षणः ।\nयथोक्तां दक्षिणां दद्यात्सुवर्णं रजतं तथा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005276008, "chapter_id": 25276, "verse_number": "७-४-११-९", "content_sanskrit": "दीनान्ध कृपणानाञ्च दानं देयं स्वशक्तितः ।\nविशेषतः प्रदातव्यं सुवर्णं द्विजसत्तमाः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005276009, "chapter_id": 25276, "verse_number": "७-४-११-१०", "content_sanskrit": "उपानहौ ततो देये जलकुम्भं द्विजातये ।\nदध्योदनं सलवणं शाकजीरकसंयुतम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005276010, "chapter_id": 25276, "verse_number": "७-४-११-११", "content_sanskrit": "रक्तवस्त्रैः कंचुकीभी रुक्मिणीं परिधापयेत् ।\nविप्रपत्नीश्च विप्रांश्च विष्णुर्मेप्रीयतामिति ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005276011, "chapter_id": 25276, "verse_number": "७-४-११-१२", "content_sanskrit": "एवं कृते द्विज श्रेष्ठाः कृतकृत्यो भवेन्नरः ।\nपितॄणामक्षया तृप्तिर्गयाश्राद्धेन वै यथा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005276012, "chapter_id": 25276, "verse_number": "७-४-११-१३", "content_sanskrit": "वैष्णवं लोकमायान्ति पितरस्त्रिकुलोद्भवाः ।\nजीवते स श्रियायुक्तः पुत्रपौत्रसमन्वितः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005276013, "chapter_id": 25276, "verse_number": "७-४-११-१४", "content_sanskrit": "प्रीतः सदा भवेत्तस्य रुक्मिण्या सह केशवः ।\nयच्छते वाञ्छितान्सर्वानैहिकामुष्मिकान्प्रभुः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005276014, "chapter_id": 25276, "verse_number": "७-४-११-१५", "content_sanskrit": "एतन्माहात्म्यमतुलं विष्णुपादोद्भवं तथा ।\nयः शृणोति हरौ भक्त्या सर्वपापैः स मुच्यते ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005276015, "chapter_id": 25276, "verse_number": "७-४-११-१६", "content_sanskrit": "श्रुत्वाऽध्यायमिमं पुण्यं सर्वपापैः प्रमुच्यते ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005276016, "chapter_id": 25276, "verse_number": "७-४-११-१७", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां सप्तमे प्रभासखंडे चतुर्थे द्वारकामाहात्म्ये विष्णुपदतीर्थमाहात्म्यवर्णनंनामैकादशोऽध्याय ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]