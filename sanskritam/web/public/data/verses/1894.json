[{"id": 2040386, "chapter_id": 1894, "verse_number": "५-१३९-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2040387, "chapter_id": 1894, "verse_number": "५-१३९-१", "content_sanskrit": "एवमुक्तस्तु विमनास्तिर्यग्दृष्टिरधोमुखः।\nसंहत्य च भ्रुवोर्मध्यं न किञ्चिद्व्याजहार ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2040388, "chapter_id": 1894, "verse_number": "५-१३९-२", "content_sanskrit": "तं वै विमनसं दृष्ट्वा संप्रेक्ष्यान्योन्यमन्तिकात् ।\nपुनरेवोत्तरं वाक्यमुक्तवन्तौ नरर्षभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2040389, "chapter_id": 1894, "verse_number": "५-१३९-३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2040390, "chapter_id": 1894, "verse_number": "५-१३९-३", "content_sanskrit": "शुश्रूषमनसूयं च ब्रह्मण्यं सत्यवादिनम् ।\nप्रतियोत्स्यामहे पार्थमतो दुःखतरं नु किम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2040391, "chapter_id": 1894, "verse_number": "५-१३९-४x", "content_sanskrit": "द्रोण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2040392, "chapter_id": 1894, "verse_number": "५-१३९-४", "content_sanskrit": "अश्वत्थाम्नि यथा पुत्रे भूयो मम धनञ्जये।\nबहुमानः परो राजन्सन्नतिश्च कपिध्वजे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2040393, "chapter_id": 1894, "verse_number": "५-१३९-५", "content_sanskrit": "तं चेत्पुत्रात्प्रियतमं प्रतियोत्स्ये धनञ्जयम् ।\nक्षात्रं धर्ममनुष्ठाय धिगस्तु क्षत्रिजीविकाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2040394, "chapter_id": 1894, "verse_number": "५-१३९-६", "content_sanskrit": "यस्य लोके समो नास्ति कश्चिदन्यो धनुर्धरः ।\nमत्प्रसादात्स बीभत्सुः श्रेयानन्यैर्धनुर्धरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2040395, "chapter_id": 1894, "verse_number": "५-१३९-७", "content_sanskrit": "मित्रध्रुग्दुष्टभावश्च नास्तिकोऽथानृजुः शठः।\nन सत्सु लभते पूजां यज्ञे मूर्ख इवागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2040396, "chapter_id": 1894, "verse_number": "५-१३९-८", "content_sanskrit": "वार्यमाणोऽपि पापेभ्यः पापात्मा पापमिच्छति।\nचोद्यमानोऽपि पापेन शुभात्मा शुभमिच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2040397, "chapter_id": 1894, "verse_number": "५-१३९-९", "content_sanskrit": "मिथ्योपचरिता ह्येते वर्तमान ह्यनुप्रिये ।\nअहितत्वाय कल्पन्ते दोषा भरतसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2040398, "chapter_id": 1894, "verse_number": "५-१३९-१०", "content_sanskrit": "त्वमुक्तः कुरुवृद्धेन मया च विदुरेण च ।\nवासुदेवेन च तथा श्रेयो नैवाभिमन्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2040399, "chapter_id": 1894, "verse_number": "५-१३९-११", "content_sanskrit": "अस्ति मे बलमित्येव सहसा त्वं तितीर्षसि।\nसग्राहनक्रमकरं गङ्गावेगमिवोष्णगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2040400, "chapter_id": 1894, "verse_number": "५-१३९-१२", "content_sanskrit": "वाससैव यथा हि त्वं प्रावृण्वानोऽभिमन्यसे।\nस्रजं त्यक्तामिव प्राप्य लोभाद्यौधिष्ठिरीं श्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2040401, "chapter_id": 1894, "verse_number": "५-१३९-१३", "content_sanskrit": "द्रौपदीसहितं पार्थं सायुधैर्भ्रातृभिर्वृतम्।\nवनस्थमपि राज्यस्थः पाण्डवं को विजेष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2040402, "chapter_id": 1894, "verse_number": "५-१३९-१४", "content_sanskrit": "निदेशे यस्य राजानः सर्वे तिष्ठन्ति किङ्कराः ।\nतमैलविलमासाद्य धर्मराजो व्यराजत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2040403, "chapter_id": 1894, "verse_number": "५-१३९-१५", "content_sanskrit": "कुबेरसदनं प्राप्य ततो रत्नान्यवाप्य च ।\nस्फीतमाक्रम्य ते राष्ट्रं राज्यमिच्छन्ति पाण्डवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2040404, "chapter_id": 1894, "verse_number": "५-१३९-१६", "content_sanskrit": "दत्तं हुतमधीतं च ब्राह्मणास्तर्पिता धनैः ।\nआवयोर्गतमायुश्च कृतकृत्यौ च विद्धि नौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2040405, "chapter_id": 1894, "verse_number": "५-१३९-१७", "content_sanskrit": "त्वं तु हित्वा सुखं राज्यं मित्राणि च धनानि च ।\nविग्रहं पाण्डवैः कृत्वा महद्व्यसनमाप्स्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2040406, "chapter_id": 1894, "verse_number": "५-१३९-१८", "content_sanskrit": "द्रौपदी यस्य चाशास्ते विजयं सत्यवादिनी ।\nतपोघोरव्रता देवी कथं जेष्यसि पाण्डवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2040407, "chapter_id": 1894, "verse_number": "५-१३९-१९", "content_sanskrit": "मन्त्री जनार्दनो यस्य भ्राता यस्य धनञ्जयः।\nसर्वशस्त्रभृतां श्रेष्ठः कथं जेष्यसि पाण्डवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2040408, "chapter_id": 1894, "verse_number": "५-१३९-२०", "content_sanskrit": "सहाया ब्राह्मणा यस्य धृतिमन्तो जितेन्द्रियाः।\nतमुग्रतपसं वीरं कथं जेष्यसि पाण्डवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2040409, "chapter_id": 1894, "verse_number": "५-१३९-२१", "content_sanskrit": "पुनरुक्तं च वक्ष्यामि यत्कार्यं भूतिमिच्छता।\nसुहृदा मञ्जमानेषु सुहृत्सु व्यसनार्णवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2040410, "chapter_id": 1894, "verse_number": "५-१३९-२२", "content_sanskrit": "अलं युद्धेन तैर्वीरैः शाम्य त्वं कुरुवृद्धये ।\nमा गमः सतुतामात्यःसमित्रश्च यमक्षयम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2040411, "chapter_id": 1894, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि एकोनचत्वारिंशदधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]