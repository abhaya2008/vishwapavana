[{"id": 2198041, "chapter_id": 5208, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2198042, "chapter_id": 5208, "verse_number": "१", "content_sanskrit": "एवमुक्तो मतङ्गस्तु संशितात्मा यतव्रतः ।\nअतिष्ठदेकपादेन वर्षाणां शतमच्युत\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2198043, "chapter_id": 5208, "verse_number": "२", "content_sanskrit": "तमुवाच ततः शक्रः पुनरेव महायशाः ।\nमतङ्ग परमं स्थानं प्रार्थयन्नतिदुर्लभम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2198044, "chapter_id": 5208, "verse_number": "३", "content_sanskrit": "मा कृथाः साहसं पुत्र नैष धर्मपथस्तव ।\nअप्राप्यं प्रार्थयानो हि नचिराद् विनशिष्यसि\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2198045, "chapter_id": 5208, "verse_number": "४", "content_sanskrit": "मतङ्ग परमं स्थानं वार्यमाणो मयाऽसकृत् ।\nचिकीर्षस्येव तपसा सर्वथा न भविष्यसि\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2198046, "chapter_id": 5208, "verse_number": "५", "content_sanskrit": "तिर्यग्योनिगतः सर्वो मानुष्यं यदि गच्छति ।\nस जायते पुल्कसो वा चण्डालो वा कदाचन\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2198047, "chapter_id": 5208, "verse_number": "६", "content_sanskrit": "पुंश्चलः पापयोनिर्वा यः कश्चिदिह लक्ष्यते ।\nस तस्यामेव सुचिरं मतङ्ग परिवर्तते\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2198048, "chapter_id": 5208, "verse_number": "७", "content_sanskrit": "ततो दशगुणे काले लभते शूद्रतामपि ।\nशूद्रयोनावपि ततो बहुशः परिवर्तते\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2198049, "chapter_id": 5208, "verse_number": "८", "content_sanskrit": "ततस्त्रिशंद्गुणे काले लभते वैश्यतामपि ।\nवैश्यतायां चिरं कालं तत्रैव परिवर्तते\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2198050, "chapter_id": 5208, "verse_number": "९", "content_sanskrit": "ततः षष्टिगुणे काले राजन्यो नाम जायते ।\nराजन्यत्वे चिरं कालं तत्रैव परिवर्तते\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2198051, "chapter_id": 5208, "verse_number": "१०", "content_sanskrit": "ततः षष्टिगुणे काले लभते ब्रह्मबन्धुताम् ।\nब्रह्मबन्धुश्चिरं कालं तत्रैव परिवर्तते\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2198052, "chapter_id": 5208, "verse_number": "११", "content_sanskrit": "ततस्तु द्विशते काले लभते काण्डपृष्ठताम् ।\nकाण्डपृष्ठश्चिरं कालं तत्रैव परिवर्तते\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2198053, "chapter_id": 5208, "verse_number": "१२", "content_sanskrit": "ततस्तु त्रिशते काले लभते द्विजतामपि ।\nतां च प्राप्य चिरं कालं तत्रैव परिवर्तते\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2198054, "chapter_id": 5208, "verse_number": "१३", "content_sanskrit": "ततश्चतुःशते काले श्रोत्रियो नाम जायते ।\nश्रोत्रियत्वे चिरं कालं तत्रैव परिवर्तते\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2198055, "chapter_id": 5208, "verse_number": "१४", "content_sanskrit": "तदैव क्रोधहर्षौ च कामद्वेषौ च पुत्रक ।\nअतिमानातिवादौ तमाविशन्ति द्विजाधमम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2198056, "chapter_id": 5208, "verse_number": "१५", "content_sanskrit": "तांश्चेज्जयति शत्रून् स तदा प्राप्नोति सद्गतिम् ।\nअथ ते वै जयन्त्येनं ताळाग्रादिव पात्यते\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2198057, "chapter_id": 5208, "verse_number": "१६", "content_sanskrit": "मतङ्ग सम्प्रधार्यैतद् यदहं त्वामचूचुदम् ।\nवृणीष्व काममन्यं त्वं ब्राह्मण्यं हि सुदुर्लभम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2198058, "chapter_id": 5208, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि\nदानधर्मे इन्द्रमतङ्गसंवादे ब्राह्मण्यप्रशंसा नाम एकोनषष्टितमोऽध्यायः ॥५९॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]