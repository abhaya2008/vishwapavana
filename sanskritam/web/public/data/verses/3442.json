[{"id": 2113509, "chapter_id": 3442, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2113510, "chapter_id": 3442, "verse_number": "१", "content_sanskrit": "दर्शनीयांस्ततः पुत्रान् पाण्डुः पञ्च महावने ।\nतान् पश्यन् पर्वते रम्ये स्वबाहुबलपालितान् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2113511, "chapter_id": 3442, "verse_number": "२", "content_sanskrit": "सुपुष्पितवने काले प्रवृत्ते मधुमाधवे ।\nपूर्णे चतुर्दशे वर्षे फल्गुनस्य च धीमतः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2113512, "chapter_id": 3442, "verse_number": "३", "content_sanskrit": "तदा उत्तरफल्गुन्यां प्रवृत्ते स्वस्तिवाचने ।\nरक्षणे विस्मिता कुन्ती व्यग्रा ब्राह्मणभोजने\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2113513, "chapter_id": 3442, "verse_number": "४", "content_sanskrit": "पुरोहितेन सहिता ब्राह्मणान् पर्यवेषयत् ।\nतस्मिन् काले समाहूय माद्रीं मदनमोहितः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2113514, "chapter_id": 3442, "verse_number": "५", "content_sanskrit": "भूतसम्मोहने काले सभार्यो व्यचरद् वने ।\nपलाशैस्तिलकैश्चूतैश्चम्पकैः पारिभद्रकैः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2113515, "chapter_id": 3442, "verse_number": "६", "content_sanskrit": "कर्णिकारैरशोकैश्च मल्लिकैरतिमुक्तकैः ।\nवकुलैस्तिन्दुकैः सालैः पनसैर्वनकिंशुकैः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2113516, "chapter_id": 3442, "verse_number": "७", "content_sanskrit": "अन्यैश्च बहुभिर्वृक्षैर्लतापुष्पफलैर्युतम् ।\nजलस्थानैश्च बहुभिः पद्मिनीभिश्च शोभितम् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2113517, "chapter_id": 3442, "verse_number": "८", "content_sanskrit": "पाण्डोर्वनं तु सम्प्रेक्ष्य प्रजज्ञे हृदि मन्मथः ।\nमत्तभ्रमरसङ्गीतं कोकिलस्वनमिश्रितम् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2113518, "chapter_id": 3442, "verse_number": "९", "content_sanskrit": "गायमानैस्तु गन्धर्वैः पुरा नागपुरे यथा ।\nप्रहृष्टमनसं तत्र विहरन्तं यथाऽमरम् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2113519, "chapter_id": 3442, "verse_number": "१०", "content_sanskrit": "तं माद्र्यनुजगामैका वसने बिभ्रती शुभे ।\nसमीक्षमाणस्य तु तां वयस्स्थां तनुवाससम् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2113520, "chapter_id": 3442, "verse_number": "११", "content_sanskrit": "तस्य कामः प्रववृधे गहनेऽग्निरिवोत्थितः ।\nरहस्यात्मसमां दृष्ट्वा राजा राजीवलोचनाम् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2113521, "chapter_id": 3442, "verse_number": "१२", "content_sanskrit": "न शशाक नियन्तुं तं कामं कामबलात्कृतः ।\nजिष्णोश्चतुर्दशे वर्षे ऋतौ माद्रीमलङ्कृताम् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2113522, "chapter_id": 3442, "verse_number": "१३", "content_sanskrit": "आजुहाव ततः पाण्डुः परीतात्मा यशस्विनीम् ।\nतत एनां बलाद् राजा जग्राह च रहोगतः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2113523, "chapter_id": 3442, "verse_number": "१४", "content_sanskrit": "वार्यमाणस्तया देव्या विस्फुरन्त्त्या यथाबलम् ।\nस तु कामपरीतात्मा तं शापं नान्वबुध्यत\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2113524, "chapter_id": 3442, "verse_number": "१५", "content_sanskrit": "माद्रीं मैथुनधर्मेण गच्छमानो बलादिव ।\nजीवितान्ताय कौरव्यो मन्मथस्य वशं गतः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2113525, "chapter_id": 3442, "verse_number": "१६", "content_sanskrit": "शापजं भयमुत्सृज्य जगामैव बलात् प्रियाम् ।\nतस्य कामात्मनो बुद्धिः साक्षात् कालेन मोहिता \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2113526, "chapter_id": 3442, "verse_number": "१७", "content_sanskrit": "सम्प्रमथ्येन्द्रियग्रामं प्रनष्टा सह चेतसा ।\nस तया सह सङ्गम्य भार्यया कुरुसत्तमः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2113527, "chapter_id": 3442, "verse_number": "१७", "content_sanskrit": "पाण्डुः परमधर्मात्मा युयुजे कालधर्मणा ।\nक्षणेनाभ्यपतद् राजा राजधानीं यमस्य वै\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2113528, "chapter_id": 3442, "verse_number": "१८", "content_sanskrit": "ततो माद्री समालिङ्ग्य राजानं गतचेतसम् ।\nआक्रोशपरमायत्ता चक्रवाकी यथा पतिम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2113529, "chapter_id": 3442, "verse_number": "१९", "content_sanskrit": "तं श्रुत्वा करुणं शब्दं सहसोत्पतितं तदा ।\nसहपुत्रा ततः कुन्ती माद्रीपुत्रौ च पाण्डवौ \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2113530, "chapter_id": 3442, "verse_number": "२०", "content_sanskrit": "आजग्मुः सहितास्तत्र यत्र राजा तथागतः ।\nततो माद्र्यब्रवीद् राजन् आर्ता कुन्तीमिदं वचः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2113531, "chapter_id": 3442, "verse_number": "२१", "content_sanskrit": "एकैव त्वमिहागच्छ तिष्ठन्तां तत्र दारकाः ।\nएतच्छ्रुत्वा वचस्तस्याः तत्रैवावार्य दारकान् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2113532, "chapter_id": 3442, "verse_number": "२२", "content_sanskrit": "हताऽहमिति विक्रुश्य सहसोपजगाम ताम् ।\nदृष्ट्वा माद्रीं च पाण्डुं च शयानौ धरणीतळे ।\nकुन्ती शोकपरीताङ्गी विललाप सुदुःखिता \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2113533, "chapter_id": 3442, "verse_number": "", "content_sanskrit": "कुन्ती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2113534, "chapter_id": 3442, "verse_number": "२३", "content_sanskrit": "रक्ष्यमाणो मया नित्यं धीरः सततमात्मवान् ।\nकथं त्वामप्यतिक्रान्तः शापं जानन् वनौकसः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2113535, "chapter_id": 3442, "verse_number": "३४", "content_sanskrit": "ननु नाम त्वया माद्रि रक्षितव्यो नराधिपः ।\nसा कथं लोभितवती विजने त्वं नराधिपम् \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2113536, "chapter_id": 3442, "verse_number": "", "content_sanskrit": "माद्री", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2113537, "chapter_id": 3442, "verse_number": "२५", "content_sanskrit": "विधिना चोदितस्यास्य मां दृष्ट्वा विजने वने ।\nअचिन्तयित्वा तच्छापं प्रहर्षः समजायत\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2113538, "chapter_id": 3442, "verse_number": "", "content_sanskrit": "कुन्ती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2113539, "chapter_id": 3442, "verse_number": "२६", "content_sanskrit": "धन्या त्वमसि बाह्लीके मत् सभाग्यतरा भुवि ।\nदृष्टवत्यसि यद् वक्त्रं प्रहृष्टस्य महीपतेः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2113540, "chapter_id": 3442, "verse_number": "", "content_sanskrit": "माद्री", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2113541, "chapter_id": 3442, "verse_number": "२७", "content_sanskrit": "विलोभ्यमानेन मया वार्यमाणेन चासकृत् ।\nआत्मा न धारितस्तेन सत्यं दिष्टं चिकीर्षुणा\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2113542, "chapter_id": 3442, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2113543, "chapter_id": 3442, "verse_number": "२८", "content_sanskrit": "तस्यास्तद्वचनं श्रुत्वा कुन्ती शोकाग्नितापिता ।\nपपात सहसा भूमौ छिन्नमूल इव द्रुमः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2113544, "chapter_id": 3442, "verse_number": "२९", "content_sanskrit": "निश्चेष्टा पतिता भूमौ मोहेन न चचाल सा ।\nतस्मिन् क्षणे कृतस्नानममलाम्बरसंवृतम् \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2113545, "chapter_id": 3442, "verse_number": "३०", "content_sanskrit": "अलङ्कारकृतं पाण्डुं शयानं शयने शुभे ।\nकुन्तीमुत्थाप्य माद्री च मोहेनाविष्टचेतनाम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2113546, "chapter_id": 3442, "verse_number": "३१", "content_sanskrit": "एह्येहीति तां कुन्तीं दर्शयामास कौरवम् ।\nपादयोः पतिता कुन्ती पुनरुत्थाय भूमिपम् \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2113547, "chapter_id": 3442, "verse_number": "३२", "content_sanskrit": "रक्तचन्दनदिग्धाङ्गं महारजनवाससम् ।\nसस्मितेन तु वक्त्रेण गदन्तमिव भारत \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2113548, "chapter_id": 3442, "verse_number": "३३", "content_sanskrit": "परिरभ्य तदा मोहाद् विललापाकुलेन्द्रिया ।\nमाद्री चापि समालिङ्ग्य राजानं विललाप सा\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2113549, "chapter_id": 3442, "verse_number": "३४", "content_sanskrit": "तथा शापहतं पाण्डुमृषयः सह चारणैः ।\nअभ्येत्य सहिताः सर्वे शोकाश्रूणि प्रवर्तयन् \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2113550, "chapter_id": 3442, "verse_number": "३५", "content_sanskrit": "अस्तङ्गतमिवादित्यं सुशुष्कमिव सागरम् ।\nदृष्ट्वा पाण्डुं नरव्याघ्रं शोचन्ति स्म महर्षयः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2113551, "chapter_id": 3442, "verse_number": "३६", "content_sanskrit": "समानशोका ऋषयः पाण्डवाश्च बभूविरे ।\nते समाश्वासिते विप्रैर्विलेपतुरनिन्दिते\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2113552, "chapter_id": 3442, "verse_number": "", "content_sanskrit": "कुन्ती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2113553, "chapter_id": 3442, "verse_number": "३७", "content_sanskrit": "हा राजन् कस्य नो हित्वा गच्छसि त्रिदशालयम् ।\nहा राजन् मम मन्दायाः कथं माद्रीं समेत्य वै \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2113554, "chapter_id": 3442, "verse_number": "३८", "content_sanskrit": "निधनं प्राप्तवान् राजन् मद्भाग्यपरिसङ्क्षयात् ।\nयुधिष्ठिरं भीमसेनमर्जुनं च यमावुभौ \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2113555, "chapter_id": 3442, "verse_number": "३९", "content_sanskrit": "कस्य हित्वा प्रियान् पुत्रान् प्रयातोऽसि विशाम्पते ।\nनूनं त्वां त्रिदशा देवाः प्रतिनन्दन्ति भारत\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2113556, "chapter_id": 3442, "verse_number": "४०", "content_sanskrit": "यथा हि तप उग्रं ते चरितं विप्रसंसदि ।\nआवाभ्यां सहितो राजन् गमिष्यसि दिवं शुभाम् \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2113557, "chapter_id": 3442, "verse_number": "४१", "content_sanskrit": "आजमीढाजमीढानां कर्मणा चरितां गतिम् ।\nननु नाम सहावाभ्यां गच्छेयमिति च त्वया \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2113558, "chapter_id": 3442, "verse_number": "४२", "content_sanskrit": "प्रतिज्ञातं कुरुश्रेष्ठ यदाऽस्मि वनमागता ।\nआवाभ्यां त्वेव सहितो गमिष्यसि विशाम्पते ।\nमुहूर्तं क्षम्यतां राजन् आरोक्ष्यावश्चितां तव\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2113559, "chapter_id": 3442, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2113560, "chapter_id": 3442, "verse_number": "४३", "content_sanskrit": "विलपित्वा भृशं त्वेवं निःसञ्ज्ञे पतिते भुवि ।\nयथा मृगे हते मृग्यौ लुब्धैर्वनगतैस्तदा\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2113561, "chapter_id": 3442, "verse_number": "४४", "content_sanskrit": "युधिष्ठिरमुखाः सर्वे पाण्डवा वेदपारगाः ।\nतेऽप्यागत्य पितुर्मूले निःसञ्ज्ञाः पतिता भुवि\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2113562, "chapter_id": 3442, "verse_number": "४५", "content_sanskrit": "पाण्डोः पादौ परिष्वज्य विलपन्ति स्म पाण्डवाः ।\nहा विनष्टाः स्म तातेति हा अनाथा भवामहे \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2113563, "chapter_id": 3442, "verse_number": "४६", "content_sanskrit": "क्षणेनैव महाराज अहो लोकस्य चित्रता ।\nत्वद्विहीना महाप्राज्ञ कथं जीवाम बालकाः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2113564, "chapter_id": 3442, "verse_number": "४७", "content_sanskrit": "लोकनाथस्य पुत्राश्च न सनाथा भवामहे ।\nनास्मद्विधा राजपुत्रा अधन्याः सन्ति भारत \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2113565, "chapter_id": 3442, "verse_number": "४८", "content_sanskrit": "त्वद्विनाशाच्च राजेन्द्र राज्यप्रस्खलनात् तथा ।\nबान्धवानामजातत्वात् कर्तव्यं न प्रसीदताम्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2113566, "chapter_id": 3442, "verse_number": "४९", "content_sanskrit": "हित्वा राज्यं च भोगांश्च शतशृङ्गे निवासिना ।\nत्वया लब्धाः स्म राजेन्द्र महता तपसा वयम् \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2113567, "chapter_id": 3442, "verse_number": "५०", "content_sanskrit": "हित्वा मानं वनं गत्वा स्वयमाहृत्य भक्षणम् ।\nशाकमूलफलैर्वन्यैर्भरणं वै त्वया कृतम्\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2113568, "chapter_id": 3442, "verse_number": "५१", "content_sanskrit": "पुत्रानुत्पाद्य पितरो यमिच्छन्ति महात्मनः ।\nत्रिवर्गफलमिच्छन्तः तस्य कालोऽयमागतः\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2113569, "chapter_id": 3442, "verse_number": "५२", "content_sanskrit": "इत्येवमुक्त्वा पितरं भीमोऽपि विललाप ह ।\nप्रनष्टं भारतं वंशं पाण्डुना पुनरुद्धृतम्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2113570, "chapter_id": 3442, "verse_number": "५३", "content_sanskrit": "तस्मिंस्तपोवनगते नष्टं राज्यं सराष्ट्रकम् ।\nपुनर्निस्तारितं क्षत्रं पाण्डुपुत्रैश्च पञ्चभिः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2113571, "chapter_id": 3442, "verse_number": "५४", "content_sanskrit": "एतच्छ्रुत्वाऽनुमोदित्वा गन्तुमर्हसि कौरव ।\nइत्येवमुक्त्वा पितरं विललाप धनञ्जयः\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2113572, "chapter_id": 3442, "verse_number": "५५", "content_sanskrit": "दुस्सञ्चयं तपः कृत्वा लब्ध्वा नो भरतर्षभ ।\nपुत्रलाभस्य महतः शुश्रूषादिफलं त्वया\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2113573, "chapter_id": 3442, "verse_number": "५६", "content_sanskrit": "न चावाप्तं त्वया तात त्वत्पित्रा तु यथा पुरा ।\nदुस्सञ्चरं किञ्चिदेव पुरा दशरथो यथा ।\nएवमुक्त्वा यमौ चापि विलेपतुरथातुरौ\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2113574, "chapter_id": 3442, "verse_number": "", "content_sanskrit": "कुन्ती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2113575, "chapter_id": 3442, "verse_number": "५७", "content_sanskrit": "अहं ज्येष्ठा धर्मपत्नी ज्येष्ठं धर्मफलं मम ।\nअवश्यम्भाविनो भावान् मामा माद्रि निवर्तय \t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2113576, "chapter_id": 3442, "verse_number": "५८", "content_sanskrit": "अन्वेष्यामीह भर्तारमहं प्रेतवशं गतम् ।\nउत्तिष्ठैनं विसृज्य त्वमिमान् रक्षस्व दारकान्\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2113577, "chapter_id": 3442, "verse_number": "५९", "content_sanskrit": "अवाप्य पुत्राँल्लब्धात्मा वीरपत्नीत्वमर्थये ।\nमद्रराजसुता कुन्तीमिदं वचनमब्रवीत्\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2113578, "chapter_id": 3442, "verse_number": "६०", "content_sanskrit": "अहमेवानुयास्यामि भर्तारमपलायिनम् ।\nन हि तृप्ताऽस्मि कामानां त्वं ज्येष्ठा ह्यनुमन्यताम् \t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2113579, "chapter_id": 3442, "verse_number": "६१", "content_sanskrit": "मां चाभिगम्य क्षीणोऽयं कामाद् भरतसत्तमः ।\nसमुच्छिन्द्यामस्य कामं कथं नु यमसादने\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2113580, "chapter_id": 3442, "verse_number": "६२", "content_sanskrit": "मम हेतोर्गतो राजा दिवं भरतसत्तमः ।\nन चैव तादृशी बुद्धिर्बान्धवाश्च न तादृशाः\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2113581, "chapter_id": 3442, "verse_number": "६३", "content_sanskrit": "न चोत्सहे धारयितुं प्राणान् भर्त्रा विनाकृता ।\nतस्मात् तमनुयास्यामि यान्तं वैवस्वतक्षयम्\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2113582, "chapter_id": 3442, "verse_number": "६४", "content_sanskrit": "वर्तेयं न समां वृत्तिं जात्वहं च सुतेषु ते ।\nतथा हि वर्तमानां मामधर्मः संपृशेन्महान्\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2113583, "chapter_id": 3442, "verse_number": "६५", "content_sanskrit": "तस्मान्मे सुतयोर्देवि वर्तितव्यं स्वपुत्रवत् ।\nअन्वेष्यामि च भर्तारं व्रजन्तं यमसादनम् \t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2113584, "chapter_id": 3442, "verse_number": "६६", "content_sanskrit": "मां हि कामयमानोऽयं राजा प्रेतवशं गतः ।\nराज्ञः शरीरेण सह ममापीदं कलेबरम् \t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2113585, "chapter_id": 3442, "verse_number": "६७", "content_sanskrit": "दग्धव्यं सुप्रतिच्छन्नमेतदार्ये प्रियं कुरु ।\nदारकेष्वप्रमत्ता त्वं भवेथाश्च हिता मम ।\nअतोऽन्यन्न प्रपश्यामि सन्देष्टव्यं हि किञ्चन\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2113586, "chapter_id": 3442, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2113587, "chapter_id": 3442, "verse_number": "६८", "content_sanskrit": "ऋषयस्तान् समाश्वास्य पाण्डवान् सत्यविक्रमान् ।\nऊचुः कुन्तीं च माद्रीं च समाश्वास्य तपस्विनः\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2113588, "chapter_id": 3442, "verse_number": "६९", "content_sanskrit": "सुभगे बालपुत्रे तु न मर्तव्यं कथञ्चन ।\nपाण्डवांश्चापि नेष्यामः कुरुराष्ट्रं परन्तपान्\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2113589, "chapter_id": 3442, "verse_number": "७०", "content_sanskrit": "अधर्मेष्वर्थजातेषु धृतराष्ट्रश्च लोभवान् ।\nस कदाचिन्न वर्तेत पाण्डवेषु यथाविधि\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2113590, "chapter_id": 3442, "verse_number": "७१", "content_sanskrit": "कुन्त्याश्च वृष्णयो नाथाः कुन्तिभोजस्तथैव च ।\nमाद्र्याश्च बलिनां श्रेष्ठः शल्यो भ्राता महारथः\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2113591, "chapter_id": 3442, "verse_number": "७२", "content_sanskrit": "भर्त्रानुमरणं सार्धं फलवन् नात्र संशयः ।\nयुवाभ्यां दुष्करं चैतद् वदन्ति द्विजपुङ्गवाः\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2113592, "chapter_id": 3442, "verse_number": "७३", "content_sanskrit": "मृते भर्तरि या साध्वी ब्रह्मचर्यव्रते स्थिता ।\nयमैश्च नियमैः श्रान्ता मनोवाक्कायजैः शुभैः\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2113593, "chapter_id": 3442, "verse_number": "७५", "content_sanskrit": "भर्तारं चिन्तयन्ती सा भर्तारं निस्तरेच्छुभा ।\nतारितश्चापि भर्ता स्यादात्मा पुत्रस्तथैव च ।\nतस्माज्जीवितमेवैतद् युवयोर्विद्म शोभनम् \t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2113594, "chapter_id": 3442, "verse_number": "", "content_sanskrit": "कुन्ती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2113595, "chapter_id": 3442, "verse_number": "७६", "content_sanskrit": "यथा पाण्डोश्च निर्देशः तथा विप्रगणस्य च ।\nआज्ञा शिरसि निक्षिप्ता करिष्यामि च तत् तथा \t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2113596, "chapter_id": 3442, "verse_number": "७७", "content_sanskrit": "यथाऽऽहुर्भगवन्तो हि तन्मन्ये शोभनं वरम् ।\nभर्तुश्च मम पुत्राणां मम चैव न संशयः\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2113597, "chapter_id": 3442, "verse_number": "", "content_sanskrit": "माद्री", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2113598, "chapter_id": 3442, "verse_number": "७८", "content_sanskrit": "कुन्ती समर्था पुत्राणां योगक्षेमस्य धारणे ।\nअस्या हि न समा बुद्ध्या देव्यपि स्यादरुन्धती\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2113599, "chapter_id": 3442, "verse_number": "७९", "content_sanskrit": "कुन्त्याश्च वृष्णयो नाथाः कुन्तीभोजस्तथैव च ।\nनाहं त्वमिव पुत्राणां समर्था धारणे तथा\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2113600, "chapter_id": 3442, "verse_number": "८०", "content_sanskrit": "साऽहं भर्तारमन्वेष्ये अतृप्ता नन्वहं तथा ।\nभर्तृलोकस्य तु ज्येष्ठा देवी मामनुमन्यताम्\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2113601, "chapter_id": 3442, "verse_number": "८१", "content_sanskrit": "धर्मज्ञस्य कृतज्ञस्य सत्यसन्धस्य धीमतः ।\nपादौ परिचरिष्यामि तदार्ये ह्यनुमन्यताम्\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2113602, "chapter_id": 3442, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2113603, "chapter_id": 3442, "verse_number": "८२", "content_sanskrit": "एवमुक्त्वा महाराज मद्रराजसुता शुभा ।\nददौ कुन्त्यै यमौ माद्री शिरसाऽभिप्रणम्य च\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2113604, "chapter_id": 3442, "verse_number": "८३", "content_sanskrit": "अभिवाद्य ऋषीन् सर्वान् परिष्वज्य च पाण्डवान् ।\nमूर्ध्न्युपाघ्राय बहुशः पार्थानात्मसुतौ तथा ।\nहस्ते युधिष्ठिरं गृह्य माद्री वाक्यमभाषत\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2113605, "chapter_id": 3442, "verse_number": "८४", "content_sanskrit": "कुन्ती माता अहं धात्री युवाऽऽभ्यां च पिता मृतः ।\nयुधिष्ठिरः पिता ज्येष्ठः चतुर्णां धर्मतः सदा\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2113606, "chapter_id": 3442, "verse_number": "८५", "content_sanskrit": "वृद्धानुशासने सक्ताः सत्यधर्मपरायणाः ।\nतादृशा न विनश्यन्ति नैव यान्ति पराभवम् ।\nतस्मात् सर्वे कुरुध्वं वै गुरुवृत्तिमतन्द्रिताः\t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2113607, "chapter_id": 3442, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2113608, "chapter_id": 3442, "verse_number": "८६", "content_sanskrit": "ऋषीणां च पृथायाश्च नमस्कृत्य पुनः पुनः ।\nआवासकृपणा माद्री प्रत्युवाच पृथां तथा\t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2113609, "chapter_id": 3442, "verse_number": "८७", "content_sanskrit": "धन्या त्वमसि वार्ष्णेयि नास्ति स्त्री सदृशी त्वया ।\nवीर्यं तेजश्च योगं च माहात्म्यं च यशस्विनाम् \t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2113610, "chapter_id": 3442, "verse_number": "८८", "content_sanskrit": "कुन्ति द्रक्ष्यसि पुत्राणां पञ्चानाममितौजसाम् ।\nऋषीणां सन्निधावेषां मया वागभ्युदीरिता\t॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2113611, "chapter_id": 3442, "verse_number": "८९", "content_sanskrit": "दिदृक्षमाणायाः स्वर्गं ममैषा न वृथा भवेत् ।\nआचार्या चाभिवाद्या च मम पूज्या च सर्वदा\t॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2113612, "chapter_id": 3442, "verse_number": "९०", "content_sanskrit": "ज्येष्ठा वरिष्ठा त्वं देवि भूषिता सद्गुणैः शुभैः ।\nअभ्यनुज्ञातुमिच्छामि त्वया यादवनन्दिनि\t॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2113613, "chapter_id": 3442, "verse_number": "९१", "content_sanskrit": "धर्मं स्वर्गं च कीर्तिं च त्वत्कृतेऽहमवाप्नुयाम् ।\nयथा तथा विधत्स्वेह मा च कार्षीर्विचारणाम् \t॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2113614, "chapter_id": 3442, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2113615, "chapter_id": 3442, "verse_number": "९२", "content_sanskrit": "बाष्पसन्दिग्धया वाचा कुन्त्युवाच यशस्विनी ।\nअनुज्ञातासि कल्याणि त्रिदिवे सङ्गमोऽस्तु ते \t॥९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2113616, "chapter_id": 3442, "verse_number": "९३", "content_sanskrit": "भर्त्रा सह विशालाक्षि क्षिप्रमद्यैव भामिनि ।\nसङ्गता स्वर्गलोके त्वं रमेथाः शाश्वतीः समाः\t॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2113617, "chapter_id": 3442, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2113618, "chapter_id": 3442, "verse_number": "९४", "content_sanskrit": "ततः पुरोहितः स्नात्वा प्रेतकर्मणि पारगः ।\nहिरण्यशकलान्याज्यं तिलान् दधि च तण्डुलान् \t॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2113619, "chapter_id": 3442, "verse_number": "९५", "content_sanskrit": "उदकुम्भं सपरशुं समानीय तपस्विभिः ।\nअश्वमेधाग्निमाहृत्य यथान्यायं समन्ततः\t॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2113620, "chapter_id": 3442, "verse_number": "९६", "content_sanskrit": "काश्यपः कारयामास पाण्डोः पुत्रो युधिष्ठिरः ।\nतेनाग्निनाऽदहत् पाण्डुं कृत्वा चापि क्रियां तदा\t॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2113621, "chapter_id": 3442, "verse_number": "९७", "content_sanskrit": "रुदञ्छोकाभिसन्तप्तः पपात भुवि पाण्डवः ।\nऋषीन् पुत्रान् पृथां चैव विसृज्य च नृपात्मजान् \t॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2113622, "chapter_id": 3442, "verse_number": "९८", "content_sanskrit": "नमस्कृत्य चिताग्निस्थं धर्मपत्नी नराधिपम् ।\nमद्रराजात्मजा तूर्णमन्वारोहद् यशस्विनी\t॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2113623, "chapter_id": 3442, "verse_number": "९९", "content_sanskrit": "अहताम्बरसंवीतो भ्रातृभिः सहितोऽनघः ।\nउदकं कृतवांस्तत्र पुरोहितमते स्थितः\t॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2113624, "chapter_id": 3442, "verse_number": "१००", "content_sanskrit": "युक्तानि तस्य कृत्यानि शतशृङ्गनिवासिनः ।\nतापसा विधिवच्चक्रुश्चारणा ऋषिभिः सह\t॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2113625, "chapter_id": 3442, "verse_number": "१२१", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nएकविंशत्यधिकशततमोऽध्यायः ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2113626, "chapter_id": 3442, "verse_number": "६९", "content_sanskrit": "॥ इति सम्भवपर्वणि एकोनसप्ततितमोऽध्यायः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2113627, "chapter_id": 3442, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}]