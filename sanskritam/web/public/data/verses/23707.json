[{"id": 7003707000, "chapter_id": 23707, "verse_number": "१-४-१५-१", "content_sanskrit": "नंदिकेश्वर उवाच ।\nतेजःस्तंभं विनिर्भिद्य संध्याभ्रमिव चंद्रमाः ।\nकैलासकूटधवलं वृषेन्द्रमधितस्थिवान् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003707001, "chapter_id": 23707, "verse_number": "१-४-१५-२", "content_sanskrit": "जटाजूटवता बालचंद्रचूडेन मौलिना ।\nकपालमालिकां वैधीं स्रजं चारग्वधी दधत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003707002, "chapter_id": 23707, "verse_number": "१-४-१५-३", "content_sanskrit": "नागकुंडलिभिः फालफलकोद्भासिलोचनैः ।\nपंचभिर्वदनैर्दीप्तैः क्ष्वेडकल्माषकंधरैः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003707003, "chapter_id": 23707, "verse_number": "१-४-१५-४", "content_sanskrit": "शूलं कपालं डमरुं सारंगं परशुं धनुः ।\nखट्वांगममलं खड्गं दोर्भिर्नागं च धारयन् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003707004, "chapter_id": 23707, "verse_number": "१-४-१५-५", "content_sanskrit": "श्वसितोद्धूलिताकारो गजचर्मोत्तरीयवान् ।\nसर्वालंकारसंपन्नः सर्वदेवैरभिष्टुतः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003707005, "chapter_id": 23707, "verse_number": "१-४-१५-६", "content_sanskrit": "परिधानीकृतव्याघ्रचर्मा ताभ्यामदर्शि सः ।\nरूपं दृष्ट्वा स आनंदं ननर्त्त नलिनेक्षणः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003707006, "chapter_id": 23707, "verse_number": "१-४-१५-७", "content_sanskrit": "न किंचिदपि जानानो मुमोह च सरोजभूः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003707007, "chapter_id": 23707, "verse_number": "१-४-१५-८", "content_sanskrit": "दृशाभिनंद्य माधवं प्रसन्नया महेश्वरः ।\nअथोदतिष्ठिपच्च तं सहुंक्रियश्चतुर्मुखम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003707008, "chapter_id": 23707, "verse_number": "१-४-१५-९", "content_sanskrit": "जगाद चाधिकारितामदाद्युवां समुद्धतौ ।\nन लज्जितव्यमत्र वामयं क्रमोऽधिकारिणाम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003707009, "chapter_id": 23707, "verse_number": "१-४-१५-१०", "content_sanskrit": "परीक्ष्य वैभवं मम प्रबोधवानभूद्धरिः ।\nअयं न जातुपद्मभूश्छलन्मनो दुरात्मवान् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003707010, "chapter_id": 23707, "verse_number": "१-४-१५-११", "content_sanskrit": "अशासि पंचवक्त्रता यदोपहासितो ह्यहम् ।\nपुनःस्वपुत्रिकारतिर्मयैष शिक्षितोऽभवत् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003707011, "chapter_id": 23707, "verse_number": "१-४-१५-१२", "content_sanskrit": "तृतीय एष मंतुरप्यहो कथं नु सह्यते ।\nतदस्य तु प्रतिष्ठया क्वचिन्न भूयतां विधेः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003707012, "chapter_id": 23707, "verse_number": "१-४-१५-१३", "content_sanskrit": "अयं च केतकच्छदो यदाप कूटसाक्षिताम् ।\nअतः परं न जातु तन्ममैतु मूर्ध्नि संस्थितिम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003707013, "chapter_id": 23707, "verse_number": "१-४-१५-१४", "content_sanskrit": "शप्त्वैवमेतौ गिरिशः प्रीत्या विष्णुमभाषत ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003707014, "chapter_id": 23707, "verse_number": "१-४-१५-१५", "content_sanskrit": "श्रीमहेश्वर उवाच ।\nवत्स मा भैः प्रसन्नोऽस्मि भवते भक्तिशालिने ।\nननु त्वमंगान्मे जातस्सात्त्विकोऽसि विशेषतः ।\nमाहेश्वराग्रगण्योऽसि जगत्यां हि यथा पुरा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003707015, "chapter_id": 23707, "verse_number": "१-४-१५-१६", "content_sanskrit": "न तवातः परं जातु भक्तिहानिर्भवेन्मयि ।\nप्रतिक्षणं वर्द्धमाना कल्पते च विमुक्तये ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003707016, "chapter_id": 23707, "verse_number": "१-४-१५-१७", "content_sanskrit": "इत्यनुग्रहकृतं त्रिलोचनं भक्तिभाजि निरहंक्रिये हरौ ।\nभीतिमानवनतः स्वयं विधिः स्तोतुमारभत क्लृप्तवंदनः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]