[{"id": 2086481, "chapter_id": 2839, "verse_number": "१२-३४४-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2086482, "chapter_id": 2839, "verse_number": "१२-३४४-१", "content_sanskrit": "ततोऽतीते महाकल्पे उत्पन्नेऽङ्गिरसः सुते।\nबभूवुर्निर्वृता देवा जाते देवपुरोहिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2086483, "chapter_id": 2839, "verse_number": "१२-३४४-२", "content_sanskrit": "बृहद्ब्रह्म महच्चेति शब्दाः पर्यायवाचकाः।\nएभिः समन्वितो राजन्गुणैर्विद्वान्बृहस्पतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2086484, "chapter_id": 2839, "verse_number": "१२-३४४-३", "content_sanskrit": "तस्य शिष्यो बभूवाग्र्यो राजोपरिचरो वसुः।\nअधीतवांस्तदा शास्त्रं सम्यक्चित्रशिखण्डिजं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2086485, "chapter_id": 2839, "verse_number": "१२-३४४-४", "content_sanskrit": "स राजा भावितः पूर्वं दैवेन विधिना वसुः।\nपालयामास पृथिवीं दिवमाखण्डलो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2086486, "chapter_id": 2839, "verse_number": "१२-३४४-५", "content_sanskrit": "तस्य यज्ञो महानासीदश्वमेधो महात्मनः।\nबृहस्पतिरुपाध्यायस्तत्र होता बभूव ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2086487, "chapter_id": 2839, "verse_number": "१२-३४४-६", "content_sanskrit": "प्रजापतिसुताश्चात्र सदस्याश्चाभवंस्त्रयः।\nएकतश्च द्वितश्चैव त्रितश्चैव मर्हषयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2086488, "chapter_id": 2839, "verse_number": "१२-३४४-७", "content_sanskrit": "धनुषाख्योऽथ रैभ्यश्च अर्वावसुपरावसू।\nऋषिर्मोधातिथिश्चैव ताण्ड्यश्चैव महानृषिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2086489, "chapter_id": 2839, "verse_number": "१२-३४४-८", "content_sanskrit": "ऋषिः शान्तिर्महाभागस्तथा वेदशिराश्च यः।\nऋषिश्रेष्ठश्च कपिलः शालिहोत्रपिता स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2086490, "chapter_id": 2839, "verse_number": "१२-३४४-९", "content_sanskrit": "आद्यः कठस्तैत्तिरिश्च वैशम्पायनपूर्वजः।\nकण्वोऽथ देवहोत्रश्च एते षोडश कीर्तिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2086491, "chapter_id": 2839, "verse_number": "१२-३४४-१०", "content_sanskrit": "संभूताः सर्वसंभारास्तस्मिन्राजन्महाक्रतौ।\nन तत्र पशुघातोऽभूत्स राजैवं स्थितोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2086492, "chapter_id": 2839, "verse_number": "१२-३४४-११", "content_sanskrit": "अहिंस्रः शुचिरक्षुद्रो निराशीः कर्मसंस्तुतः।\nआरण्यकपदोद्भूता भागास्तत्रोपकल्पिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2086493, "chapter_id": 2839, "verse_number": "१२-३४४-१२", "content_sanskrit": "प्रीतस्ततोऽस्य भगवान्देवदेवः पुरातनः।\nसाक्षात्तं दर्शयामास सोदृश्योऽन्येन केनचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2086494, "chapter_id": 2839, "verse_number": "१२-३४४-१३", "content_sanskrit": "स्वयं भागमुपाघ्राय पुरोडाशं गृहीतवान्।\nअदृश्येन हृतो भागो देवेन हरिमेधसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2086495, "chapter_id": 2839, "verse_number": "१२-३४४-१४", "content_sanskrit": "बृहस्पतिस्ततः क्रुद्धः स्रुचमुद्यम्य वेगितः।\nआकाशं घ्नन्स्रुचः पातै रोषादश्रूण्यवर्तयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2086496, "chapter_id": 2839, "verse_number": "१२-३४४-१५", "content_sanskrit": "उवाच चोपरिचरं मया भागोऽयमुद्यतः।\nग्राह्यः स्वयं हि देवेन मत्प्रत्यक्षं न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2086497, "chapter_id": 2839, "verse_number": "१२-३४४-१६", "content_sanskrit": "उद्यता यज्ञभागा हि साक्षात्प्राप्ताः सुरैरिह।\nकिमर्थमिह न प्राप्तो दर्शनं मे हरिर्नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2086498, "chapter_id": 2839, "verse_number": "१२-३४४-१७x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2086499, "chapter_id": 2839, "verse_number": "१२-३४४-१७", "content_sanskrit": "ततः स तं समुद्भूतं भूमिपालो महान्वसुः।\nप्रसादयामास मुनिं सदस्यास्ते च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2086500, "chapter_id": 2839, "verse_number": "१२-३४४-१८", "content_sanskrit": "`हुतस्त्वया वदानीह पुरोडाशस्य यावती।\nगृहीता देवदेवेन मत्प्रत्यक्षं न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2086501, "chapter_id": 2839, "verse_number": "१२-३४४-१९", "content_sanskrit": "इत्येवमुक्ते वसुना सरोषश्चाब्रवीद्गुरुः।\nन यजेयमहं चात्र परिभूतस्त्वया नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2086502, "chapter_id": 2839, "verse_number": "१२-३४४-२०", "content_sanskrit": "त्वया पशुर्वारितश्च कृतः पिष्टमयः पशुः।\nत्वं देवं पश्यसे नित्यं न पश्येयमहं कथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2086503, "chapter_id": 2839, "verse_number": "१२-३४४-२१x", "content_sanskrit": "वसुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2086504, "chapter_id": 2839, "verse_number": "१२-३४४-२१", "content_sanskrit": "पशुहिंसा वारिता च यजुर्वेदादिमन्त्रतः।\nअहं न वारये हिंसां द्रक्ष्याम्येकान्तिको हरिम्।\nतस्मात्कोपो न कर्तव्यो भवता गुरुणा मयि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2086505, "chapter_id": 2839, "verse_number": "१२-३४४-२२", "content_sanskrit": "वसुमेवं ब्रुवाणं तु क्रुद्ध एव बृहस्पतिः।\nउवाच ऋत्विजश्चैव किं नः कर्मेति वारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2086506, "chapter_id": 2839, "verse_number": "१२-३४४-२३", "content_sanskrit": "अथैकतो द्वितश्चैव त्रितश्चैव महर्षयः।\nऊचुश्चैनमसंभ्रान्ता न रोषं कर्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2086507, "chapter_id": 2839, "verse_number": "१२-३४४-२४", "content_sanskrit": "`शृणु त्वं वचनं पुत्र अस्माभिः समुदाहृतम्।\nनैष धर्मः कृतयुगे यत्त्वं रोषमिहाहिथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2086508, "chapter_id": 2839, "verse_number": "१२-३४४-२५", "content_sanskrit": "अरोषणो ह्यसौ देवो यस्य भागोऽयमुद्यतः।\nन शक्यः स त्वया द्रष्टुमस्माभिर्वा बृहस्पते।\nयस्य प्रसादं कुरुते स वै तं द्रष्टुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2086509, "chapter_id": 2839, "verse_number": "१२-३४४-२६", "content_sanskrit": "वयं हि ब्रह्मणः पुत्रा मानसाः परिकीर्तिताः।\nगता निःश्रेयसार्थं हि कदाचिद्दिशमुत्तराम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2086510, "chapter_id": 2839, "verse_number": "१२-३४४-२७", "content_sanskrit": "तप्त्वा वर्षसहस्राणि चत्वारि तप उत्तमम्।\nएकपादा स्थिताः सम्यक्काष्ठभूताः समाहिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2086511, "chapter_id": 2839, "verse_number": "१२-३४४-२८", "content_sanskrit": "मेरोरुत्तरभागे तु क्षीरोदस्यानुकूलतः।\nस देशो यत्र नस्तप्तं तपः परमदारुणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2086512, "chapter_id": 2839, "verse_number": "१२-३४४-२९", "content_sanskrit": "वरेण्यं वरदं तं वै देवदेवं सनातनम्।\nकथं पश्येमहि वयं देवं नारायणं त्विति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2086513, "chapter_id": 2839, "verse_number": "१२-३४४-३०", "content_sanskrit": "अथ व्रतस्यावभृथे वागुवाचाशरीरिणी।\nस्निग्धगम्भीरया वाचा प्रहर्षणकरी विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2086514, "chapter_id": 2839, "verse_number": "१२-३४४-३१", "content_sanskrit": "सुतप्तं वस्तपो विप्राः प्रसन्नेनान्तरात्मना।\nयूयं जिज्ञासवो भक्ताः कथं द्रक्ष्यथ तं विभुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2086515, "chapter_id": 2839, "verse_number": "१२-३४४-३२", "content_sanskrit": "क्षीरोदधेरुत्तरतः श्वेतद्वीपो महाप्रभः।\nतत्र नारायणपरा मानवाश्चन्द्रवर्चसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2086516, "chapter_id": 2839, "verse_number": "१२-३४४-३३", "content_sanskrit": "एकान्तभावोपगतास्ते भक्ताः पुरुषोत्तमम्।\nते सहस्रार्चिषं देवं प्रविशन्ति सनातनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2086517, "chapter_id": 2839, "verse_number": "१२-३४४-३४", "content_sanskrit": "अनिन्द्रिया निराहारा अनिष्पन्दाः सुगन्धिनः।\nएकान्तिनस्ते पुरुषाः श्वेतद्वीपनिवासिनः। १२-३४४-३४ca गच्छध्वं तत्र मुनयस्तत्रात्मा मे प्रकाशितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2086518, "chapter_id": 2839, "verse_number": "१२-३४४-३५", "content_sanskrit": "अथ श्रुत्वा वयं सर्वे वाचं तामशरीरिणीम्।\nयथाख्यातेन मार्गेण तं देशं प्रविशेमहि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2086519, "chapter_id": 2839, "verse_number": "१२-३४४-३६", "content_sanskrit": "प्राप्य श्वेतं महाद्वीपं तच्चित्तास्तद्दिदृक्षवः।\n`सहसा हि गताः सर्वे तेजसा तस्य मोहिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2086520, "chapter_id": 2839, "verse_number": "१२-३४४-३७", "content_sanskrit": "ततोऽस्मद्दृष्टिविषयस्तदा प्रतिहतोऽभवत्।\nन च पश्याम पुरुषं तत्तेजोहतदर्शनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2086521, "chapter_id": 2839, "verse_number": "१२-३४४-३८", "content_sanskrit": "ततो नः प्रादुरभवद्विज्ञानं देवयोगजम्।\nन किलातप्ततपसा शक्यते द्रष्टमञ्जसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2086522, "chapter_id": 2839, "verse_number": "१२-३४४-३९", "content_sanskrit": "ततः पुनर्वर्षशतं तप्त्वा तात्कालिकं महत्।\nव्रतावसाने च शुभान्नरान्ददृशिमो वमय्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2086523, "chapter_id": 2839, "verse_number": "१२-३४४-४०", "content_sanskrit": "श्वेतांश्चन्द्रप्रतीकाशान्सर्वलक्षणलक्षितान्।\nनित्याञ्जलिकृतान्ब्रह्म जपतः प्रागुदङ्भुखान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2086524, "chapter_id": 2839, "verse_number": "१२-३४४-४१", "content_sanskrit": "मानसो नाम स जपो जप्यते तैर्महात्मभिः।\nतेनैकाग्रमनस्त्वेन प्रीतो भवति वै हरिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2086525, "chapter_id": 2839, "verse_number": "१२-३४४-४२", "content_sanskrit": "याऽभवन्मुनिशार्दूल भाः सूर्यस्य युगक्षये।\nएकैकस्य प्रभा तादृक्साऽभवन्मानवस्य ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2086526, "chapter_id": 2839, "verse_number": "१२-३४४-४३", "content_sanskrit": "तेजोनिवासः स द्वीप इति वै मेनिरे वयम्।\nन तत्राभ्यधिकः कश्चित्सर्वे ते समतेजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2086527, "chapter_id": 2839, "verse_number": "१२-३४४-४४", "content_sanskrit": "अथ सूर्यसहस्रस्य प्रभां युगपदुत्थिताम्।\nसहसा दृष्टवन्तः स्म पुनरेव बृहस्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2086528, "chapter_id": 2839, "verse_number": "१२-३४४-४५", "content_sanskrit": "सहिताश्चाभ्यधावन्त ततस्ते मानवा द्रुतम्।\nकृताञ्जलिपुष्टा हृष्टा नम इत्येव वादिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2086529, "chapter_id": 2839, "verse_number": "१२-३४४-४६", "content_sanskrit": "ततो हि वदतां तेषामश्रौष्म विपुलं ध्वनिम्।\nबलिः किलोपह्रियते तस्य देवस्य तैर्नरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2086530, "chapter_id": 2839, "verse_number": "१२-३४४-४७", "content_sanskrit": "वयं तु तेजसा तस्य सहसा हृतचेतसः।\nन किंचिदपि पश्यामो हतचक्षुर्बलेन्द्रियाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2086531, "chapter_id": 2839, "verse_number": "१२-३४४-४८", "content_sanskrit": "एकस्तु शब्दो विततः श्रुतोऽस्माभिरुदीरितः।\n`आकाशं पूरयन्सर्वं शिक्षाक्षरसमन्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2086532, "chapter_id": 2839, "verse_number": "१२-३४४-४९", "content_sanskrit": "जितं ते पुण्डरीकाक्ष नमस्ते विश्वभावन।\nनमस्तेऽस्तु हृषीकेश महापुरुष पूर्वज।\nइति शब्दः श्रुतोऽस्माभिः शिक्षाक्षरसमन्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2086533, "chapter_id": 2839, "verse_number": "१२-३४४-५०", "content_sanskrit": "एतस्मिन्नन्तरे वायुः सर्वगन्धवहः शुचिः।\nदिव्यान्युवाह पुष्पाणि कर्मण्याश्चौषधीस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2086534, "chapter_id": 2839, "verse_number": "१२-३४४-५१", "content_sanskrit": "तैरिष्टः पञ्चकालज्ञैर्हरिरेकान्तिभिर्नरैः।\nभक्त्या परमया युक्तैर्मनोवाक्कर्मभिस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2086535, "chapter_id": 2839, "verse_number": "१२-३४४-५२", "content_sanskrit": "नूनं तत्रागतो देवो यथा तैर्वागुदीरिता।\nवयं त्वेनं न पश्यामो मोहितास्तस्य मायया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2086536, "chapter_id": 2839, "verse_number": "१२-३४४-५३", "content_sanskrit": "मारुते सन्निवृत्ते च बलौ च प्रतिपादिते।\nचिन्ताव्याकुलितात्मानो जाताः स्मोङ्गिसांवर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2086537, "chapter_id": 2839, "verse_number": "१२-३४४-५४", "content_sanskrit": "मानवानां सहस्रेषु तेषु वै शुद्धयोनिषु।\nअस्मान्न कश्चिन्मनसा चक्षुषा वाऽप्यपूजयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2086538, "chapter_id": 2839, "verse_number": "१२-३४४-५५", "content_sanskrit": "तेऽपि स्वस्था मुनिगणा एक भावमनुव्रताः।\nनास्मासु दधिरे भावं ब्रह्मभावमनुष्ठिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2086539, "chapter_id": 2839, "verse_number": "१२-३४४-५६", "content_sanskrit": "ततोऽस्मान्सुपरिश्रान्तांस्तपसा चातिकर्शितान्।\nउवाच स्वस्थं किमपि भूतं तत्राशरीरकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2086540, "chapter_id": 2839, "verse_number": "१२-३४४-५७x", "content_sanskrit": "देव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2086541, "chapter_id": 2839, "verse_number": "१२-३४४-५७", "content_sanskrit": "दृष्टा वः पुरुषाः श्वेताः सर्वेन्द्रियविवर्जिताः।\nदृष्टो भवति देवेश एभिर्दृष्टैर्द्विजोत्तमैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2086542, "chapter_id": 2839, "verse_number": "१२-३४४-५८", "content_sanskrit": "गच्छध्वं मुनयः सर्वे यथागतमितोऽचिरात्।\nन स शक्यस्त्वभक्तेन द्रष्टुं देवः कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2086543, "chapter_id": 2839, "verse_number": "१२-३४४-५९", "content_sanskrit": "कामं कालेन महता एकान्तित्वमुपागतैः।\nशक्यो द्रष्टुं स भगवान्प्रभामण्डलदुर्दृशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2086544, "chapter_id": 2839, "verse_number": "१२-३४४-६०", "content_sanskrit": "महत्कार्यं च कर्तव्यं युष्माभिर्द्विजसत्तमाः।\nइतः कृतयुगेऽतीते विपर्यासं गतेऽपि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2086545, "chapter_id": 2839, "verse_number": "१२-३४४-६१", "content_sanskrit": "वैवस्वतेऽन्तरे विप्राः प्राप्ते त्रेतायुगे पुनः।\nसुराणां कार्यसिद्ध्यर्थं सहाया वै भविष्यथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2086546, "chapter_id": 2839, "verse_number": "१२-३४४-६२", "content_sanskrit": "ततस्तदद्भुतं वाक्यं निशम्यैवामृतोपमम्।\nतस्य प्रसादात्प्राप्ताः स्मो देशमीप्सिंतमञ्जसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2086547, "chapter_id": 2839, "verse_number": "१२-३४४-६३", "content_sanskrit": "एवं सुतपसा चैव हव्यकव्यस्तैथैव च।\nदेवोऽस्माभिर्न दृष्टः स कथं त्वं द्रष्टुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2086548, "chapter_id": 2839, "verse_number": "१२-३४४-६४", "content_sanskrit": "नारायणो महद्भूतं विश्वसृग्घव्यकव्यभुक्।\nअनादिनिधनोऽव्यक्तो देवदानवपूजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2086549, "chapter_id": 2839, "verse_number": "१२-३४४-६५", "content_sanskrit": "एवमेकतवाक्येन द्वितत्रितमतेन च।\nअनुनीतः सदस्यैश्च बृहस्पतिरुदारधीः।\nसमापयत्ततो यज्ञं दैवतं समपूजयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2086550, "chapter_id": 2839, "verse_number": "१२-३४४-६६", "content_sanskrit": "समाप्तयज्ञो राजाऽपि प्रजां पालितवान्वसुः।\nब्रह्मशापाद्दिवो भ्रष्टः प्रविवेश महीं ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2086551, "chapter_id": 2839, "verse_number": "१२-३४४-६७", "content_sanskrit": "स राजा राजशार्दूल सत्यधर्मपरायणः।\nअन्तर्भूमिगतश्चैव सततं धर्मवत्सलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2086552, "chapter_id": 2839, "verse_number": "१२-३४४-६८", "content_sanskrit": "नारायणपरो भूत्वा नारायणजपं जपन्।\nतस्यैव च प्रसादेन पुनरेवोत्थितस्तु सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2086553, "chapter_id": 2839, "verse_number": "१२-३४४-६९", "content_sanskrit": "महीतलाद्गतः स्थानं ब्रह्मणः समनन्तरम्।\nपरां गतिमनुप्राप्त इति नैष्ठिकमञ्जसा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2086554, "chapter_id": 2839, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि नारायणीये चतुश्चत्वारिंशदधिकत्रिशततमोऽध्यायः॥ ३४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}]