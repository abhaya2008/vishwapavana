[{"id": 7001752000, "chapter_id": 21752, "verse_number": "२-१३-१", "content_sanskrit": "वसिष्ठ उवाच ।\nउत्थापयित्वा राजानं मोहिनी वाक्यमब्रवीत् ।\nमा शंकां कुरु राजेंद्र कुमारीं विद्ध्यकल्मषाम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001752001, "chapter_id": 21752, "verse_number": "२-१३-२", "content_sanskrit": "उद्वहस्व महीपाल गृह्योक्तविधिना हि माम् ।\nअनूढा कन्यका राजन् यदि गर्भं बिभर्ति हि ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001752002, "chapter_id": 21752, "verse_number": "२-१३-३", "content_sanskrit": "प्रसूयति दिवाकीर्तिं सर्ववर्णविगर्हितम् ।\nचांडालयोनयस्तिस्रः पुराणे कवयो विदुः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001752003, "chapter_id": 21752, "verse_number": "२-१३-४", "content_sanskrit": "कुमारीसंभवात्वेका सगोत्रापि द्वितीयका ।\nब्राह्मण्यां शूद्रजनिता तृतीया नृपपुंगव ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001752004, "chapter_id": 21752, "verse_number": "२-१३-५", "content_sanskrit": "एतस्मात्कारणाद्राजन् कुमारीं मां समुद्वह ।\nततस्तां चपलापांगीं नृपो रुक्माङ्गदो गिरौ ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001752005, "chapter_id": 21752, "verse_number": "२-१३-६", "content_sanskrit": "उद्वाह्य विधिना युक्तस्तस्थौ राजा हसन्निव ।\nराजोवाच ।\nन तथा त्रिदिवप्राप्तिः प्रीणयेन्मां वरानने ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001752006, "chapter_id": 21752, "verse_number": "२-१३-७", "content_sanskrit": "तवप्राप्तिर्यथा देवि मन्दरेऽस्मिन्सुखाय वै ।\nमन्ये पुरंदराद्देवि ह्यात्मानमधिकं क्षितौ ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001752007, "chapter_id": 21752, "verse_number": "२-१३-८", "content_sanskrit": "त्रैलोक्यसुन्दरीं प्राप्य भार्यां त्वां चारुलोचने ।\nतस्माद्यदनुकूलं ते तत्करोमि प्रशाधि माम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001752008, "chapter_id": 21752, "verse_number": "२-१३-९", "content_sanskrit": "इहैव रमसे बाले अथवा मंदिरे मम ।\nमलये मेरुशिखरे वने वा नन्दने वद ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001752009, "chapter_id": 21752, "verse_number": "२-१३-१०", "content_sanskrit": "तच्छ्रुत्वा नृपतेर्वाक्यं मोहिनी मधुरं नृप ।\nउवाचानुशयं राजन्वचनं प्रीतिवर्द्धनम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001752010, "chapter_id": 21752, "verse_number": "२-१३-११", "content_sanskrit": "सपत्नीनां कटाक्षाणां क्षतानि नगरे मम ।\nभविष्यंति महीपाल कथं गच्छामि ते पुरम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001752011, "chapter_id": 21752, "verse_number": "२-१३-१२", "content_sanskrit": "मास्म सीमंतिनी काचिद्भवेद्धि क्षितिमण्डले ।\nयस्याः सपत्नीप्रभवं दुःखमामरणं भवेत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001752012, "chapter_id": 21752, "verse_number": "२-१३-१३", "content_sanskrit": "साहं लब्धा महीपाल मनसा वशगा तव ।\nज्ञात्वा सपत्नीप्रभवं दुःखं भर्ता कृतो मया ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001752013, "chapter_id": 21752, "verse_number": "२-१३-१४", "content_sanskrit": "वत्स्यामि पर्वतश्रेष्ठे बह्वाश्चर्यसमन्विते ।\nन त्वं वससि राजेंद्र संध्यावल्या विना क्वचित् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001752014, "chapter_id": 21752, "verse_number": "२-१३-१५", "content_sanskrit": "तस्यास्त्वं विरहे दुःखी सपुत्राया भविष्यसि ।\nदुःखेन भवतो राजन्भूरि दुःखं भवेन्मम ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001752015, "chapter_id": 21752, "verse_number": "२-१३-१६", "content_sanskrit": "यत्रैव भवतः सौख्यं तत्राहमपि संस्थिता ।\nयत्र त्वं रंस्यसे राजंस्तत्र मे मंदरो गिरिः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001752016, "chapter_id": 21752, "verse_number": "२-१३-१७", "content_sanskrit": "भर्तृस्थाने हि वस्तव्यमृद्धिहीनेऽपि भार्यया ।\nस मेरुः कांचनमयः सन्निधाने प्रचक्षते ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001752017, "chapter_id": 21752, "verse_number": "२-१३-१८", "content_sanskrit": "मनोरथो नाम मेरुर्यत्र त्वं रमसे विभो ।\nभर्तृस्थानं परित्यज्य स्वपितुर्वापि वर्जितम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001752018, "chapter_id": 21752, "verse_number": "२-१३-१९", "content_sanskrit": "पितृस्थानाश्रयरता नारी तमसि मज्जति ।\nसर्वधर्मविहीनापि नारी भवति सूकरी ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001752019, "chapter_id": 21752, "verse_number": "२-१३-२०", "content_sanskrit": "एवं जानाम्यहं दोषं कथं वत्स्यामि मंदरे ।\nगमिष्यामि त्वया सार्द्धमीशस्त्वं सुखदुःखयोः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001752020, "chapter_id": 21752, "verse_number": "२-१३-२१", "content_sanskrit": "मोहिन्यास्तद्वचः श्रुत्वा राजा संहृष्टमानसः ।\nपरिष्वज्य वरारोहामिदं वचनमब्रवीत् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001752021, "chapter_id": 21752, "verse_number": "२-१३-२२", "content_sanskrit": "भार्याणां मम सर्वासामुपरिष्टाद्भविष्यसि ।\nमा शंकां कुरु वामोरु यतो दुःखं भविष्यति ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001752022, "chapter_id": 21752, "verse_number": "२-१३-२३", "content_sanskrit": "जीवितादधिका सुभ्रु भविष्यसि गृहे मम ।\nएहि गच्छाव तन्वंगि सुखाय नगरं प्रति ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001752023, "chapter_id": 21752, "verse_number": "२-१३-२४", "content_sanskrit": "भुंक्ष्व भोगान्मया सार्द्धं तत्रस्था स्वेच्छया प्रिये ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001752024, "chapter_id": 21752, "verse_number": "२-१३-२५", "content_sanskrit": "सा त्वेवमुक्ता शशिगौरवक्त्रा रुक्मांगदेनात्मविनाशनाय ।\nसंप्रस्थिता नूपुरघोषयुक्ता विकर्षयन्ती गिरिजातशोभाम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]