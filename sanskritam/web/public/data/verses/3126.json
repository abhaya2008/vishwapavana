[{"id": 2099453, "chapter_id": 3126, "verse_number": "१३-२५६-१", "content_sanskrit": "युधिष्ठिर उवाच।\nके पूज्याः के नमस्कार्या कथं वर्तेत केषु च।\nकिमाचारः कीदृशेषु पितामह न रिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2099454, "chapter_id": 3126, "verse_number": "१३-२५६-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2099455, "chapter_id": 3126, "verse_number": "१३-२५६-२", "content_sanskrit": "ब्राह्मणानां परिभवः सादयेदपि देवताः।\nब्राह्मणांस्तु नमस्कृत्य युधिष्ठिर न रिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2099456, "chapter_id": 3126, "verse_number": "१३-२५६-३", "content_sanskrit": "ते पूज्यास्ते नमस्कार्या वर्तेथास्तेषु पुत्रवत्।\nते हि लोकानिमान्सर्वान्धारयन्ति मनीषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2099457, "chapter_id": 3126, "verse_number": "१३-२५६-४", "content_sanskrit": "ब्राह्मणाः सर्वलोकानां महान्तो धर्मसेतवः॥\nधनत्यागाभिरामास्चि वाक्सङ्गमधुराश्च ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2099458, "chapter_id": 3126, "verse_number": "१३-२५६-५", "content_sanskrit": "रमणीयाश्च भूतानां नियमेन धृतव्रताः।\nप्रणेतारश्च कोशानां शास्त्राणां च यशस्विनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2099459, "chapter_id": 3126, "verse_number": "१३-२५६-६", "content_sanskrit": "तपो येषां धनं नित्यं वाक्चैव विपुलं बलम्।\nप्रसवाश्चैव धर्माणां धर्मज्ञाः सूक्ष्मदर्शिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2099460, "chapter_id": 3126, "verse_number": "१३-२५६-७", "content_sanskrit": "धर्मकामाः स्थिता धर्मे सुकृतैर्धर्मसेवतः।\nयान्समाश्रित्य तिष्ठन्ति प्रजाः सर्वाश्चतुर्विधाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2099461, "chapter_id": 3126, "verse_number": "१३-२५६-८", "content_sanskrit": "पन्थानः सर्वनेतारो यज्ञवाहाः सनातनाः।\nपितृपैतामहीं गुर्वीमुद्वहन्ति धुरं सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2099462, "chapter_id": 3126, "verse_number": "१३-२५६-९", "content_sanskrit": "धुरि ये नावसीदन्ति विषमे सद्धया इव।\nपितृदेवातिथिमुखा हव्यकव्याग्रभोजिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2099463, "chapter_id": 3126, "verse_number": "१३-२५६-१०", "content_sanskrit": "भोजनादेव लोकांस्त्रींस्त्रायन्ते महतो भयात्।\nदीपः सर्वस्य लोकस्य चक्षुश्चक्षुष्मतामपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2099464, "chapter_id": 3126, "verse_number": "१३-२५६-११", "content_sanskrit": "सर्वशिल्पादिनिधयो निपुणाः सूक्ष्मदर्शिनः।\nगतिज्ञाः सर्वभूतानामध्यात्मगतिचिन्तकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2099465, "chapter_id": 3126, "verse_number": "१३-२५६-१२", "content_sanskrit": "आदिमध्यावसानानां ज्ञातारश्छिन्नसंशयाः।\nपरावरविशेषज्ञा गन्तारः परमां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2099466, "chapter_id": 3126, "verse_number": "१३-२५६-१३", "content_sanskrit": "विमुक्ता धूतपाप्मानो निर्द्वन्द्वा निष्परिग्रहाः।\nमानार्हा मानिता नित्यं ज्ञानविद्भिर्महात्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2099467, "chapter_id": 3126, "verse_number": "१३-२५६-१४", "content_sanskrit": "चन्दने मलपङ्के च भोजनेऽभोजने समाः।\nसमं येषां दुकूलं च शाणक्षौमाजिनानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2099468, "chapter_id": 3126, "verse_number": "१३-२५६-१५", "content_sanskrit": "तिष्ठेयुरप्यभुञ्जाना बहूनि दिवसान्यपि।\nशोषयेयुश्च गात्राणि स्वाध्यायैः संयतेन्द्रियाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2099469, "chapter_id": 3126, "verse_number": "१३-२५६-१६", "content_sanskrit": "अदैवं दैवतं कुर्युर्दैवतं चाप्यदैवतम्।\nलोकानन्यान्सृजेयुस्ते लोकपालांश्च कोपिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2099470, "chapter_id": 3126, "verse_number": "१३-२५६-१७", "content_sanskrit": "अपेयः सागरो येषामपि सापान्महात्मनाम्।\nयेषां कोपाग्निरद्यापि दण्डके नोपशाम्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2099471, "chapter_id": 3126, "verse_number": "१३-२५६-१८", "content_sanskrit": "देवानामपि ये देवाः कारणं कारणस्य च।\nप्रमामस्य प्रमाणं च तस्मान्नाभिभवेद्बुधः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2099472, "chapter_id": 3126, "verse_number": "१३-२५६-१९", "content_sanskrit": "तेषां वृद्धाश्च बालाश्च सर्वे सन्मार्गदर्शिनः।\nतपोविद्याविशेषात्तु मानयन्ति परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2099473, "chapter_id": 3126, "verse_number": "१३-२५६-२०", "content_sanskrit": "अविद्वान्ब्राह्मणो देवः पात्रं वै पावनं महत्।\nविद्वान्भूयस्तरो देवः पूर्णसागरसन्निभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2099474, "chapter_id": 3126, "verse_number": "१३-२५६-२१", "content_sanskrit": "अविद्वांश्चैव विद्वांश्च ब्राह्मणो दैवतं महत्।\nप्रणीतश्चाप्रणीतश्च यथाऽग्निर्दैवतं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2099475, "chapter_id": 3126, "verse_number": "१३-२५६-२२", "content_sanskrit": "श्मशाने ह्यपि तेजस्वी पावको नैव दुष्यति।\nहविर्यज्ञे च विधिवद्भूय एवाभिशोभते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2099476, "chapter_id": 3126, "verse_number": "१३-२५६-२३", "content_sanskrit": "एवं यद्यप्यनिष्टेषु वर्तते सर्वकर्मसु।\nसर्वथा ब्राह्मणो मान्यो दैवतं विद्धि तत्परम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2099477, "chapter_id": 3126, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि षट्पञ्चाशदधिकद्विशततमोऽध्यायः॥ २५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]