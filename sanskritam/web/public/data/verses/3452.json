[{"id": 2113938, "chapter_id": 3452, "verse_number": "", "content_sanskrit": "वैशम्पयानः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2113939, "chapter_id": 3452, "verse_number": "१", "content_sanskrit": "अर्जुनस्तु परं यत्नमातस्थे गुरुपूजने ।\nअस्त्रे च परमे योगे प्रियो द्रोणस्य चाभवत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2113940, "chapter_id": 3452, "verse_number": "२", "content_sanskrit": "द्रोणेन च समाहूय रहस्युक्तोऽन्नसाधकः ।\nअन्धकारेऽर्जुनायान्नं न देयं ते कदाचन\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2113941, "chapter_id": 3452, "verse_number": "३", "content_sanskrit": "ततः कदाचिद् भुञ्जाने प्रववौ वायुरर्जुने ।\nतेन दीपस्तु सहसा निर्वापित इति श्रुतिः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2113942, "chapter_id": 3452, "verse_number": "४", "content_sanskrit": "भुक्तवानेव कौन्तेयो नचास्मात् स न्यवर्तत ।\nहस्ततेजस्विनो नित्यमभ्यासकृतकारणात् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2113943, "chapter_id": 3452, "verse_number": "५", "content_sanskrit": "तदभ्यासकृतं मत्वा रात्रावभ्यस्त पाण्डवः ।\nयोगं चक्रे महाबाहुर्धनुषा पाण्डुनन्दनः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2113944, "chapter_id": 3452, "verse_number": "६", "content_sanskrit": "तस्य ज्यातळनिर्घोषं द्रोणः शुश्राव तं निशि ।\nउपेत्यार्जुनमुत्थाप्य परिष्वज्येदमब्रवीत्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2113945, "chapter_id": 3452, "verse_number": "७", "content_sanskrit": "प्रयतिष्ये तथा कर्तुं यथा नान्यो धनुर्धरः ।\nत्वत्समो भविता लोके सत्यमेतद् ब्रवीमि ते\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2113946, "chapter_id": 3452, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2113947, "chapter_id": 3452, "verse_number": "८", "content_sanskrit": "ततो द्रोणोऽर्जुनं भूयो हयेषु च गजेषु च ।\nरथेषु भूमावपि च रणशिक्षामशिक्षयत्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2113948, "chapter_id": 3452, "verse_number": "९", "content_sanskrit": "गदायुद्धेऽसिचर्यायां तोमरप्रासशक्तिषु ।\nद्रोणः सङ्कीर्णयुद्धेषु शिक्षयामास कौरवम् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2113949, "chapter_id": 3452, "verse_number": "१०", "content_sanskrit": "तस्य तत् कौशलं दृष्ट्वा धनुर्वेदजिघृक्षवः ।\nराजानो राजपुत्राश्च तत्राजग्मुः सहस्रशः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2113950, "chapter_id": 3452, "verse_number": "११", "content_sanskrit": "तान् सर्वान् शिक्षयामास द्रोणः शस्त्रभृतां वरः ।\nततो निषादराजस्य हिरण्यधनुषः सुतः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2113951, "chapter_id": 3452, "verse_number": "१२", "content_sanskrit": "एकलव्यो महावीर्यो द्रोणमभ्याजगाम ह ।\nन स तं प्रतिजग्राह नैषादिरिति चिन्तयन् ।\nशिष्यं धनुषि धर्मज्ञः तेषामेवान्ववेक्षया \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2113952, "chapter_id": 3452, "verse_number": "", "content_sanskrit": "द्रोणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2113953, "chapter_id": 3452, "verse_number": "१३", "content_sanskrit": "शिष्योऽसि मम नैषादे प्रयोगे बलवत्तरः ।\nनिवर्तस्व गृहानेव अनुज्ञातोऽसि नित्यशः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2113954, "chapter_id": 3452, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2113955, "chapter_id": 3452, "verse_number": "१४", "content_sanskrit": "स तु द्रोणस्य शिरसा पादौ गृह्य परन्तपः ।\nअरण्यमनुसम्प्राप्य कृत्वा द्रोणं महीमयम् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2113956, "chapter_id": 3452, "verse_number": "१५", "content_sanskrit": "तस्मिन्नाचार्यवृत्तिं च परमामास्थितस्तदा ।\nइष्वस्त्रे योगमातस्थे परं नियममास्थितः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2113957, "chapter_id": 3452, "verse_number": "१६", "content_sanskrit": "स तेन तपसा युक्तो योगेन परमेण च ।\nविमोक्षादानसन्धाने लघुत्वं परमाप सः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2113958, "chapter_id": 3452, "verse_number": "१७", "content_sanskrit": "लाघवं चास्त्रयोगं च नचिरात् प्रत्यपद्यत ।\nअथ द्रोणाभ्यनुज्ञाताः कदाचित् कुरुपाण्डवाः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2113959, "chapter_id": 3452, "verse_number": "१८", "content_sanskrit": "तथैव निर्ययुः सर्वे मृगयामरिमर्दनाः ।\nतत्रोपकरणं गृह्य नरः कश्चिद् यदृच्छया\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2113960, "chapter_id": 3452, "verse_number": "१९", "content_sanskrit": "राजन्ननुजगामैकः श्वानमादाय पाण्डवान् ।\nतेषां विचरतां तत्र तत्तत्कर्म चिकीर्षताम् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2113961, "chapter_id": 3452, "verse_number": "२०", "content_sanskrit": "श्वा चरन् स वने मूढो नैषादिं प्रति जग्मिवान् ।\nस कृष्णं मलदिग्धाङ्गं कृष्पाजिनधरं कृशम् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2113962, "chapter_id": 3452, "verse_number": "२१", "content_sanskrit": "नैषादिं श्वा समुद्वीक्ष्य भषंस्तस्थे तदन्तिके ।\nतस्यैकलव्यो भषतः शुनः सप्त शरान् मुखे\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2113963, "chapter_id": 3452, "verse_number": "२२", "content_sanskrit": "लाघवादर्पयामास शब्दवेध्यमदर्शयन् ।\nस तु श्वा शरपूर्णास्यः पाण्डवानाजगाम ह\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2113964, "chapter_id": 3452, "verse_number": "२३", "content_sanskrit": "तं दृष्ट्वा कौरवा राजन् विस्मयं परमं गताः ।\nलाघवं शब्दवेधित्वं दृष्ट्वा तं चिन्तयंस्तदा \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2113965, "chapter_id": 3452, "verse_number": "२४", "content_sanskrit": "प्रेक्ष्य तं व्रीळिताश्चासन् प्रशशंसुश्च शिक्षितम् ।\nतं ततोऽन्वेषमाणास्ते वने वनचरेश्वरम् \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2113966, "chapter_id": 3452, "verse_number": "२५", "content_sanskrit": "ददृशुः पाण्डवा राजन्नस्यन्तमनिशं शरान् ।\nन चैनमभ्यजानंस्ते तदा विकृतदर्शनम् ।\nअथैनं परिपप्रच्छुः को भवान् कस्य चेति ह\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2113967, "chapter_id": 3452, "verse_number": "", "content_sanskrit": "एकलव्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2113968, "chapter_id": 3452, "verse_number": "२६", "content_sanskrit": "निषादाधिपतेर्वीरा हिरण्यधनुषः सुतम् ।\nद्रोणशिष्यं च मां वित्त धनुर्वेदकृतश्रमम् \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2113969, "chapter_id": 3452, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2113970, "chapter_id": 3452, "verse_number": "२७", "content_sanskrit": "ते तमाज्ञाय तत्त्वेन पुनरागम्य पाण्डवाः ।\nयथावृत्तं वने राजन् द्रोणायाचख्युरद्भुतम् \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2113971, "chapter_id": 3452, "verse_number": "२८", "content_sanskrit": "कौन्तेयस्त्वर्जुनो राजन्नेकलव्यमनुस्मरन् ।\nरहो द्रोणं समागम्य प्रणयादिदमब्रवीत्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2113972, "chapter_id": 3452, "verse_number": "२९", "content_sanskrit": "नन्वहं परिरभ्यैकः प्रीतिपूर्वमिदं वचः ।\nभवतोक्तो न मे शिष्यः त्वद्विशिष्टो भविष्यति\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2113973, "chapter_id": 3452, "verse_number": "३०", "content_sanskrit": "अथ कस्मान्मद्विशिष्टो लोकादपि च वीर्यवान् ।\nअस्त्यन्यो भवतः शिष्यो निषादाधिपतेः सुतः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2113974, "chapter_id": 3452, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2113975, "chapter_id": 3452, "verse_number": "३१", "content_sanskrit": "मुहूर्तमिव तं द्रोणश्चिन्तयित्वा विनिश्चयम् ।\nसव्यसाचिनमादाय नैषादिं प्रति जग्मिवान् \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2113976, "chapter_id": 3452, "verse_number": "३२", "content_sanskrit": "ददर्श मलदिग्धाङ्गं जटिलं चीरवाससम् ।\nएकलव्यं धनुष्पाणिमस्यन्तमनिशं शरान् \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2113977, "chapter_id": 3452, "verse_number": "३३", "content_sanskrit": "एकलव्यस्तु तं दृष्ट्वा द्रोणमायान्तमन्तिकात् ।\nअभिगम्योपसङ्गृह्य जगाम शिरसा महीम् \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2113978, "chapter_id": 3452, "verse_number": "३४", "content_sanskrit": "पूजयित्वा ततो द्रोणं विधिवत् स निषादजः ।\nनिवेद्य शिष्यमात्मानं तस्थौ प्राञ्जलिरग्रतः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2113979, "chapter_id": 3452, "verse_number": "३५", "content_sanskrit": "ततो द्रोणोऽब्रवीद् राजन् एकलव्यमिदं वचः ।\nयदि शिष्योऽसि मे तात वेतनं दीयतामिति\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2113980, "chapter_id": 3452, "verse_number": "३६", "content_sanskrit": "एकलव्यस्तु तच्छ्रुत्वा प्रीयमाणोऽब्रवीदिदम् ।\nकिं प्रयच्छामि भगवानाज्ञापयतु मां गुरुः \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2113981, "chapter_id": 3452, "verse_number": "३७", "content_sanskrit": "न हि किंचिददेयं मे गुरवे ब्रह्मवित्तम ।\nतमब्रवीत् त्वयाऽङ्गुष्ठो दक्षिणो दीयतामिति\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2113982, "chapter_id": 3452, "verse_number": "३८", "content_sanskrit": "एकलव्यस्तु तच्छ्रुत्वा वचो द्रोणस्य दारुणम् ।\nप्रतिज्ञामात्मनो रक्षन् सत्ये च निरतः सदा\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2113983, "chapter_id": 3452, "verse_number": "३९", "content_sanskrit": "तथैव हृष्टवदनः तथैवादीनमानसः ।\nसत्यसन्धं तं नैषादिं दृष्ट्वा द्रोणोऽब्रवीदिदम् \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2113984, "chapter_id": 3452, "verse_number": "४०", "content_sanskrit": "एवं कर्तव्यमिति वै एकलव्यमभाषत ।\nछित्त्वाऽविचार्य तं प्रादाद् द्रोणायाङ्गुष्ठमात्मनः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2113985, "chapter_id": 3452, "verse_number": "४१", "content_sanskrit": "अतः परं तु नैषादिरङ्गुलीभिरकर्षत ।\nन तथा स तु शीघ्रोऽभूद् यथा पूर्वं नराधिप\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2113986, "chapter_id": 3452, "verse_number": "४२", "content_sanskrit": "ततोऽर्जुनः प्रीतमना बभूव विगतज्वरः ।\nद्रोणश्च सत्यवागासीन्नाधिकोऽन्योऽर्जुनादभूत्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2113987, "chapter_id": 3452, "verse_number": "१३१", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nएकत्रिंशत्यधिकशततमोऽध्यायः ॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2113988, "chapter_id": 3452, "verse_number": "७९", "content_sanskrit": "॥ इति सम्भवपर्वणि एकोनाशीतितमोऽध्यायः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2113989, "chapter_id": 3452, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]