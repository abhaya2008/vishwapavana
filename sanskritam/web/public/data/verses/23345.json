[{"id": 7003345000, "chapter_id": 23345, "verse_number": "२-४०-१", "content_sanskrit": "सनत्कुमार उवाच  ।\nकन्यादानं प्रवक्ष्यामि सर्वदानोत्तमोत्तमम् ।\nकन्यां लक्षणसंपन्नां सर्वदोषविवर्जिताम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003345001, "chapter_id": 23345, "verse_number": "२-४०-२", "content_sanskrit": "मातापित्रोस्तु संवादं कृत्वा दत्त्वा धनं महत् ।\nआत्मीकृत्याथ संस्नाप्य वस्त्रं दत्त्वा शुभं नवम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003345002, "chapter_id": 23345, "verse_number": "२-४०-३", "content_sanskrit": "भूषणैर्भूषयित्वाथ गंधमाल्यैरथार्चयेत् ।\nनिमित्तानि समीक्ष्याथ गोत्रनक्षत्रकादिकान् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003345003, "chapter_id": 23345, "verse_number": "२-४०-४", "content_sanskrit": "उभयोश्चित्तमालोक्य उभौ संपूज्य यत्नतः ।\nदातव्या श्रोत्रियायैव ब्राह्मणाय तपस्विने ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003345004, "chapter_id": 23345, "verse_number": "२-४०-५", "content_sanskrit": "साक्षादधीतवेदाय विधिना ब्रह्मचारिणे ।\nदासदासीधनाढ्यं च भूषणानिं विशेषतः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003345005, "chapter_id": 23345, "verse_number": "२-४०-६", "content_sanskrit": "क्षेत्राणि च धनं धान्य वासांसि च प्रदापयेत् ।\nयावंति देहे रोमाणि कन्यायाः संततौ पुनः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003345006, "chapter_id": 23345, "verse_number": "२-४०-७", "content_sanskrit": "तावद्वर्षसहस्राणि रुद्रलोके महीयते ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}]