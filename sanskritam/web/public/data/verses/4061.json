[{"id": 2142038, "chapter_id": 4061, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2142039, "chapter_id": 4061, "verse_number": "१", "content_sanskrit": "युद्धं त्वमानुषं द्रष्टुमागतास्त्रिदशाः पुरा ।\nकिमकुर्वन्त ते पश्चात् कथयस्व ममानघ\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2142040, "chapter_id": 4061, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2142041, "chapter_id": 4061, "verse_number": "२", "content_sanskrit": "वासवप्रमुखाः सर्वे देवाः सर्षिपुरोगमाः ।\nयक्षगन्धर्वसङ्घाश्च गणाश्चाप्सरसां तथा\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2142042, "chapter_id": 4061, "verse_number": "३", "content_sanskrit": "युद्धं त्वमानुषं दृष्ट्वा कुरूणां फल्गुनस्य च ।\nएकस्य च बहूनां च रौद्रमत्युग्रदर्शनम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2142043, "chapter_id": 4061, "verse_number": "४", "content_sanskrit": "अस्त्राणामथ दिव्यानां प्रयोगानथ सङ्ग्रहान् ।\nलघु सुष्ठु च चित्रं च कृतीनां च प्रयत्नतः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2142044, "chapter_id": 4061, "verse_number": "५", "content_sanskrit": "भीष्मं शारद्वतं द्रोणं कर्णं गाण्डीवधन्वना ।\nजितानन्यान् भूमिपालान् दृष्ट्वा जग्मुर्दिवौकसः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2142045, "chapter_id": 4061, "verse_number": "६", "content_sanskrit": "सर्वेषां परितुष्टाश्च प्रशस्य च मुहुर्मुहुः ।\nअसङ्गगतिना तेन विमानेनाशुगामिना\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2142046, "chapter_id": 4061, "verse_number": "७", "content_sanskrit": "प्रतिजग्मुरसङ्गेन त्रिदिवं च दिवौकसः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2142047, "chapter_id": 4061, "verse_number": "८", "content_sanskrit": "कुरवोऽर्जुनबाणैश्च ताडिताः शरविक्षताः ।\nकुरूनभिमुखा याताः समग्रबलवाहनाः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2142048, "chapter_id": 4061, "verse_number": "९", "content_sanskrit": "विराटनगराच्चैव गजाश्वरथसङ्कुलाः ।\nयोधैः क्षत्रियदायादैर्बलवद्भिरधिष्ठिता\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2142049, "chapter_id": 4061, "verse_number": "१०", "content_sanskrit": "विराटप्रहिता सेना नगराच्छीघ्रयायिनी ।\nउत्तरं सह सूतेन प्रत्ययात् तमरिन्दमम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2142050, "chapter_id": 4061, "verse_number": "११", "content_sanskrit": "तस्मिंस्तूर्यशताकीर्णे हस्त्यश्वरथसङ्कुले ।\nप्रहर्षः स्त्रीकुमाराणां तुमुलः समपद्यत\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2142051, "chapter_id": 4061, "verse_number": "१२", "content_sanskrit": "अर्जुनस्तु ततो दृष्ट्वा सैन्यरेणुं समुत्थितम् ।\nसैन्यध्वजं निशाम्याथ वैराटिं समभाषत\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2142052, "chapter_id": 4061, "verse_number": "१३", "content_sanskrit": "नगरे तुमुलः शब्दो रेणुश्चाक्रमते नभः ।\nकिं नु खल्वपयातास्ते कुरवो नगरं गताः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2142053, "chapter_id": 4061, "verse_number": "१४", "content_sanskrit": "ते चैव न जितास्माभिर्महेष्वासाः सुचेतसः ।\nआमुञ्च कवचं वीर चोदयस्व च वाजिनः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2142054, "chapter_id": 4061, "verse_number": "१५", "content_sanskrit": "जवेनाभिप्रपद्यस्व विराटनगरं प्रति\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2142055, "chapter_id": 4061, "verse_number": "१६", "content_sanskrit": "न तावत् तळनिर्घोषं गाण्डीवस्य च निस्वनम् ।\nध्वजं वा दर्शयिष्यामि कदाचित् स्वजनो भवेत्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2142056, "chapter_id": 4061, "verse_number": "", "content_sanskrit": "उत्तरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2142057, "chapter_id": 4061, "verse_number": "१७", "content_sanskrit": "सेनाग्रमेतन्मत्स्यानां गणिकाश्च स्वलङ्कृताः ।\nकन्या रथेषु दृश्यन्ते पुरे विविधवाससः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2142058, "chapter_id": 4061, "verse_number": "१८", "content_sanskrit": "उत्तरामत्र पश्यामि सखीभिः परिवारिताम् ।\nअनीकानि प्रकाशन्ते हस्तिनोऽश्वाश्च वर्जिताः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2142059, "chapter_id": 4061, "verse_number": "१९", "content_sanskrit": "पादाता रथिनश्चैव बहवो न च शस्त्रिणः ।\nविराटवचनात् सर्वे संहृष्टाः प्रतिभान्ति मे\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2142060, "chapter_id": 4061, "verse_number": "२०", "content_sanskrit": "न च मेऽस्य प्रतीघातश्चित्तस्य स्वजने यथा\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2142061, "chapter_id": 4061, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2142062, "chapter_id": 4061, "verse_number": "२१", "content_sanskrit": "ततः शीघ्रं समागम्य उत्तरः स्वजनं बहु ।\nपरस्परममित्रघ्नः सस्वजे तं समागतम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2142063, "chapter_id": 4061, "verse_number": "२२", "content_sanskrit": "प्रीतिमान् पुरुषव्याघ्रो हर्षयुक्तः पुनः पुनः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2142064, "chapter_id": 4061, "verse_number": "", "content_sanskrit": "जनाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2142065, "chapter_id": 4061, "verse_number": "२३", "content_sanskrit": "दिष्ट्या जयसि भद्रं ते दिष्ट्या सूतो बृहन्नळा ।\nदिष्ट्या सङ्ग्राममागम्य भयं तव न किञ्चन\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2142066, "chapter_id": 4061, "verse_number": "", "content_sanskrit": "उत्तरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2142067, "chapter_id": 4061, "verse_number": "२४", "content_sanskrit": "अजैषीदेष तान् जिष्णुः कुरूनेकरथो रणे ।\nएतस्य बाहुवीर्यं तद् तेन गावो जिता मया\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2142068, "chapter_id": 4061, "verse_number": "२५", "content_sanskrit": "कुरवो निर्जिता यस्मात् सङ्ग्रामेऽमिततेजसः ।\nअकार्षीदेष तत्कर्म देवपुत्रोपमो युवा\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2142069, "chapter_id": 4061, "verse_number": "२६", "content_sanskrit": "एष तत् पुरुषव्याघ्रो विक्षोभ्य कुरुमण्डलम् ।\nगावः प्रसँह्य जितवान् रणे मां चाप्यपालयत्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2142070, "chapter_id": 4061, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2142071, "chapter_id": 4061, "verse_number": "२७", "content_sanskrit": "उत्तरस्य वचःश्रुत्वा शंसमानस्य चार्जुनम् ।\nचोदिता राजपुत्रेण जयमङ्गलवादिनः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2142072, "chapter_id": 4061, "verse_number": "२८", "content_sanskrit": "ततो गन्धैश्च माल्यैश्च धूपैश्च वसुसम्भृतैः ।\nकन्याः पार्थममित्रघ्नं किरन्त्यः समपूजयन्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2142073, "chapter_id": 4061, "verse_number": "२९", "content_sanskrit": "आपूर्यमाणो माल्यैश्च गन्धैश्च विविधैः शुभैः ।\nसम्पूज्यमानो लोकेन नगरद्वारमाविशत्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2142074, "chapter_id": 4061, "verse_number": "३०", "content_sanskrit": "भेर्यश्च तूर्याणि च वेणवश्च\nविचित्रवेषाः प्रमदाजनाश्च ।\nपुराद् विराटस्य महाबलस्य\nनिष्क्रम्य भूमिञ्जयमभ्यनन्दन्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2142075, "chapter_id": 4061, "verse_number": "३१", "content_sanskrit": "प्रशस्यमानस्तु जयेन तत्र\nपुत्रो विराटस्य न हृष्यति स्म ।\nसम्भाष्यमाणस्तु जयेन तेन\nसोऽन्तर्मनाः पाण्डवमीक्षमाणः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2142076, "chapter_id": 4061, "verse_number": "३२", "content_sanskrit": "पुत्र्या विराटस्य ततो वराणि\nवस्त्राण्यदात् पाण्डुसुतः सखीभ्यः ।\nसभाजयंश्चापि समागतास्ता\nदृष्ट्वा जयं तच्च बलं कुमार्यः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2142077, "chapter_id": 4061, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां विराटपर्वणि एकोनसप्ततितमोऽध्यायः ॥६९॥ गोग्रहणपर्वणि द्विचत्वारिंशोऽध्यायः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]