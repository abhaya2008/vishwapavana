[{"id": 2098120, "chapter_id": 3100, "verse_number": "१३-२३०-१", "content_sanskrit": "उमोवाच।\nभगवंस्ते कथं तत्र दण्ड्यन्ते नरकेषु वै।\nकति ते नरका घोराः कीदृशास्ते महेश्वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2098121, "chapter_id": 3100, "verse_number": "१३-२३०-२x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2098122, "chapter_id": 3100, "verse_number": "१३-२३०-२", "content_sanskrit": "शृणु भामिनि तत्सर्वं पञ्चैते नरकाः स्मृताः।\nभूमेरधस्ताद्विहिता घोरा दुष्कृतकर्मणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2098123, "chapter_id": 3100, "verse_number": "१३-२३०-३", "content_sanskrit": "प्रथमं रौरवं नाम शतयोजनमायतम्।\nतावत्प्रमाणविस्तीर्णं तामसं पापपीडितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2098124, "chapter_id": 3100, "verse_number": "१३-२३०-४", "content_sanskrit": "भृशं दुर्गन्धि परुषं क्रिमिभिर्दारुणैर्वृतम्।\nअतिघोरमनिर्देश्यं प्रतिकूलं ततस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2098125, "chapter_id": 3100, "verse_number": "१३-२३०-५", "content_sanskrit": "ते चिरं तत्र तिष्ठन्ति न तत्र शयनासने।\nक्रिमिभिर्भक्ष्यमाणाश्च विष्ठागन्धसमायुताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2098126, "chapter_id": 3100, "verse_number": "१३-२३०-६", "content_sanskrit": "एवंप्रमाणमुद्विग्ना यावत्तिष्ठन्ति तत्र ते।\nयातनाभ्यो दशगुणं नरके दुःखमिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2098127, "chapter_id": 3100, "verse_number": "१३-२३०-७", "content_sanskrit": "तत्र चात्यन्तिकं दुःखमिष्यते च शुभेक्षणे\nक्रोशन्तश्च रुद्रन्तश्च वेदनास्तत्रि भुञ्जते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2098128, "chapter_id": 3100, "verse_number": "१३-२३०-८", "content_sanskrit": "भ्रमन्ति दुःखमोक्षार्थं ज्ञाता कश्चिन्न विद्यते।\nदुःखस्यान्तरमात्रं तु ज्ञानं वा न च लभ्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2098129, "chapter_id": 3100, "verse_number": "१३-२३०-९", "content_sanskrit": "महारौरवसंज्ञं तु द्वितीयं नरकं प्रिये।\nतस्माद्द्विगुणितं विद्धि माने दुःखे च रौरवात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2098130, "chapter_id": 3100, "verse_number": "१३-२३०-१०", "content_sanskrit": "तृतीयं नरकं तत्र कण्टिकावनसंज्ञितम्।\nततो द्विगुणितं तच्च पूर्वाभ्यां दुःखमानयोः।\nमहापातकसंयुक्ता घोरास्तस्मिन्विशन्ति हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2098131, "chapter_id": 3100, "verse_number": "१३-२३०-११", "content_sanskrit": "अग्निकुण्डमिति ख्यातं चतुर्थं नरकं प्रिये।\nएतद्द्विगुणितं तस्माद्यथानिष्टसुखं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2098132, "chapter_id": 3100, "verse_number": "१३-२३०-१२", "content_sanskrit": "ततो दुःखं हि सुमहदमानुषमिति स्मृतम्।\nभुञ्जते तत्रतत्रैव दुःखं दुष्कृतकारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2098133, "chapter_id": 3100, "verse_number": "१३-२३०-१३", "content_sanskrit": "तत्र दुःखमनिर्देश्यं वहद्धोरं यथा तथा।\nपञ्चेन्द्रियैरसम्बाधात्पञ्चकष्टमिति स्मृतम्।\nभुञ्जते तत्रतत्रैव दुःखं दुष्कृतकारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2098134, "chapter_id": 3100, "verse_number": "१३-२३०-१४", "content_sanskrit": "अमानुषार्हजं दुःखं महाभूतैश्च भुञ्जते।\nअतिघोरं चिरं कृत्वा महाभूतानि यान्ति तम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2098135, "chapter_id": 3100, "verse_number": "१३-२३०-१५", "content_sanskrit": "पञ्च् कष्टेन हि समं नास्ति दुःखं तथा परम्।\nदुःखस्थानमिति प्राहुः पञ्चकष्टमिति प्रिये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2098136, "chapter_id": 3100, "verse_number": "१३-२३०-१६", "content_sanskrit": "एवं त्वेतेषु तिष्ठन्ति प्राणिनोः दुःखभागिनः।\nअन्ये च नरकाः सन्ति अवीचिप्रमुखाः प्रिये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2098137, "chapter_id": 3100, "verse_number": "१३-२३०-१७", "content_sanskrit": "क्रोशन्तश्च रुदन्तश्च वेदनर्ता भृशातुराः।\nकेचिद्भमन्तश्चेष्टन्ते केचिद्धावन्ति चातुराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2098138, "chapter_id": 3100, "verse_number": "१३-२३०-१८", "content_sanskrit": "आधावन्तो निवार्यन्ते शूलहस्तैर्यतस्ततः।\nरुजार्दितास्तृषायुक्ताः प्राणिनः पापकारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2098139, "chapter_id": 3100, "verse_number": "१३-२३०-१९", "content_sanskrit": "यावत्पूर्वकृतं तावन्न मुच्यन्ते कथञ्चन।\nक्रिमिभिर्भक्ष्यमाणाश्च वेदनार्तास्तृषान्विताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2098140, "chapter_id": 3100, "verse_number": "१३-२३०-२०", "content_sanskrit": "संस्मरन्तः स्वकं पापं कृतमात्मापराधजम्।\nशोचन्तस्तत्र तिष्ठन्ति यावत्पापक्षयं प्रिये।\nएवं भुक्त्वा तु नरकं मुच्यन्ते पापसंक्षयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2098141, "chapter_id": 3100, "verse_number": "१३-२३०-२१x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2098142, "chapter_id": 3100, "verse_number": "१३-२३०-२१", "content_sanskrit": "भगवन्कतिकालं ते तिष्ठन्ति नरकेषु वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2098143, "chapter_id": 3100, "verse_number": "१३-२३०-२२x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2098144, "chapter_id": 3100, "verse_number": "१३-२३०-२२", "content_sanskrit": "शतवर्षसहस्राणामादिं कृत्वा हि जन्तवः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2098145, "chapter_id": 3100, "verse_number": "१३-२३०-२२", "content_sanskrit": "तिष्ठन्ति नरकावासाः प्रलयान्तमिति स्थितिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2098146, "chapter_id": 3100, "verse_number": "१३-२३०-२३x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2098147, "chapter_id": 3100, "verse_number": "१३-२३०-२३", "content_sanskrit": "भगवंस्तेषु के तत्र तिष्ठन्तीति वद प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2098148, "chapter_id": 3100, "verse_number": "१३-२३०-२४x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2098149, "chapter_id": 3100, "verse_number": "१३-२३०-२४", "content_sanskrit": "रौरवे शतसाहस्रं वर्षाणामिति संस्थितिः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2098150, "chapter_id": 3100, "verse_number": "१३-२३०-२४", "content_sanskrit": "मानुषघ्नाः कृतघ्नाश्च तथैवानृतवादिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2098151, "chapter_id": 3100, "verse_number": "१३-२३०-२५", "content_sanskrit": "द्वितीये द्विगुणं कालं पच्यन्ते तादृशा नराः।\nमहापातकयुक्तास्तु तृतीये दुःखमाप्नुयुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2098152, "chapter_id": 3100, "verse_number": "१३-२३०-२६", "content_sanskrit": "एतावन्मानुषसहं परमन्येषु लक्ष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2098153, "chapter_id": 3100, "verse_number": "१३-२३०-२७", "content_sanskrit": "यक्षा विद्याधराश्चैव काद्रवेयाश्च किंनराः।\nगन्धर्वभूतसङ्घाश्च तेषां पापयुता भृशम्।\nचतुर्थे परिपच्यन्ते तादृशा नरकाः स्मृताः॥\nचतुर्थे परितप्यन्ते यावद्युगविपर्ययः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2098154, "chapter_id": 3100, "verse_number": "१३-२३०-२८", "content_sanskrit": "सहन्तस्तादृशं घोरं पञ्चकष्टे तु यादृशम्।\nतत्रास्य चिरदुःखस्य ह्यधोन्यान्विद्धि मानुषान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2098155, "chapter_id": 3100, "verse_number": "१३-२३०-२९", "content_sanskrit": "एवं ते नरकान्भुक्त्वा तत्र क्षपितकल्मषाः।\nनरकेभ्यो विमुक्ताश्च जायन्ते कृमिजातिषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2098156, "chapter_id": 3100, "verse_number": "१३-२३०-३०", "content_sanskrit": "उद्भेदजेषु वा केचिदत्रापि क्षीणकल्मषाः।\nपुनरेव प्रजायन्ते मृगपक्षिषु शोभने।\nमृगपक्षिषु तद्भुक्त्वा लभन्ते मानुषं पदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2098157, "chapter_id": 3100, "verse_number": "१३-२३०-३१x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2098158, "chapter_id": 3100, "verse_number": "१३-२३०-३१", "content_sanskrit": "नानाजातिषु केनैव जायन्ते पापकारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2098159, "chapter_id": 3100, "verse_number": "१३-२३०-३२x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2098160, "chapter_id": 3100, "verse_number": "१३-२३०-३२", "content_sanskrit": "तदहं ते प्रवक्ष्यामि यत्त्वमिच्छसि शोभने।\nसर्वदाऽऽत्मा कर्मवशो नानाजातिषु जायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2098161, "chapter_id": 3100, "verse_number": "१३-२३०-३३", "content_sanskrit": "यश्च मांसप्रियो नित्यं काकगृध्नान्स संस्पृशेत्।\nसुरापः सततं मर्त्यः सूकरत्वं व्रजेद्भुवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2098162, "chapter_id": 3100, "verse_number": "१३-२३०-३४", "content_sanskrit": "अभक्ष्यभक्षणो मर्त्यः काकजातिषु जायते।\nआत्मघ्नो यो नरः कोपात्प्रेतजातिसु तिष्ठति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2098163, "chapter_id": 3100, "verse_number": "१३-२३०-३५", "content_sanskrit": "पैशुन्यात्परिवादाच्च कुक्कुटत्वमवाप्नुयात्।\nनास्तिकश्चैव यो मूर्खो मृगजातिं स गच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2098164, "chapter_id": 3100, "verse_number": "१३-२३०-३६", "content_sanskrit": "हिंसाविहारस्तु नरः क्रिमिकीटेषु जायते।\nअतिमानयुतो नित्यं प्रेत्य गर्दभतां व्रजेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2098165, "chapter_id": 3100, "verse_number": "१३-२३०-३७", "content_sanskrit": "अगम्यागमनाच्चैव परदारनिषेवणात्।\nमूषिकत्वं व्रजेन्मर्त्यो नास्ति तत्र विचारणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2098166, "chapter_id": 3100, "verse_number": "१३-२३०-३८", "content_sanskrit": "कृतघ्नो मित्रघाती च सृगालवृकजातिषु।\nकृतघ्नः पुत्रघाती च स्थावरेष्वथ तिष्ठति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2098167, "chapter_id": 3100, "verse_number": "१३-२३०-३९", "content_sanskrit": "एवमाद्यशुभं कृत्वा नरा निरयगामिनः।\nतांस्तान्भावान्प्रपद्यन्ते स्वकृतस्यैव कारणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2098168, "chapter_id": 3100, "verse_number": "१३-२३०-४०", "content_sanskrit": "एवंजातिषु निर्देश्याः प्राणिनः पापकारिणः।\nकथंचित्पुनरुत्पद्यि लभन्ते मानुषं पदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2098169, "chapter_id": 3100, "verse_number": "१३-२३०-४१", "content_sanskrit": "बहुशश्चाग्निसङ्क्रान्तं लोहं शुचिमयं तथा।\nबहुदुःखाभिसन्तप्तस्तथाऽऽत्मा शोध्यते बलात्।\nतस्मात्सुदुर्लभं चेति विद्धि जन्मसु मानुषम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2098170, "chapter_id": 3100, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि त्रिंशदधिकद्विशततमोऽध्यायः॥ २३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]