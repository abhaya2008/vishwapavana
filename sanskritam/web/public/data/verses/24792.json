[{"id": 7004792000, "chapter_id": 24792, "verse_number": "६-२५४-१", "content_sanskrit": "शूद्र उवाच ।\nइदमाश्चर्यरूपं मे प्रतिभाति वचस्तव ।\nयद्यपि स्यान्महाक्लेशो वदतस्तव सुव्रत ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004792001, "chapter_id": 24792, "verse_number": "६-२५४-२", "content_sanskrit": "तथापि मम भाग्येन मत्पुण्यैर्मद्गृहं गतः ।\nन तृप्ये त्वन्मुखांभोजाच्च्युतं वाक्यामृतं पुनः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004792002, "chapter_id": 24792, "verse_number": "६-२५४-३", "content_sanskrit": "पिबन्गौरीकथाख्यानं विशेषगुणपूरितम् ।\nकथं महेश्वरो नृत्यं चकार सुरसंवृतः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004792003, "chapter_id": 24792, "verse_number": "६-२५४-४", "content_sanskrit": "चातुर्मास्ये कथं जातं कि ग्राह्यं व्रतमुच्यते ।\nअनुग्रहं कृतवती सा कथं को ह्यनुग्रहः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004792004, "chapter_id": 24792, "verse_number": "६-२५४-५", "content_sanskrit": "एतद्विस्तरतो ब्रूहि पृच्छतो मे द्विजोत्तम ।\nभगवान्पूज्यते लोके ममानुग्रहकारकः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004792005, "chapter_id": 24792, "verse_number": "६-२५४-६", "content_sanskrit": "प्रसन्नवदनो भूत्वा स्वस्थः कथय सुव्रत ।\nगालवश्चापि तच्छ्रुत्वा पुनराह प्रहृष्टवान् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004792006, "chapter_id": 24792, "verse_number": "६-२५४-७", "content_sanskrit": "गालव उवाच ।\nइतिहासमिमं पुण्यं कथयामि तवानघ ।\nशृणुष्वावहितो भूत्वा यज्ञायुतफलप्रदम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004792007, "chapter_id": 24792, "verse_number": "६-२५४-८", "content_sanskrit": "चातुर्मास्येऽथ संप्राप्ते हरो भक्तिसमन्वितः ।\nब्रह्मचर्यव्रतपरः प्रहृष्टवदनोऽभवत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004792008, "chapter_id": 24792, "verse_number": "६-२५४-९", "content_sanskrit": "देवतानां च संकल्पं महर्षीणां चकार ह ।\nसमागत्य ततो देवा मन्दराचलमास्थिताः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004792009, "chapter_id": 24792, "verse_number": "६-२५४-१०", "content_sanskrit": "प्रणम्य ते महेशानं तस्थुः प्रांजलयोऽग्रतः ।\nतानुवाच सुरान्सर्वान्हरो दृष्ट्वा समागतान् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004792010, "chapter_id": 24792, "verse_number": "६-२५४-११", "content_sanskrit": "पार्वत्याभिहितं प्राह कस्मिन्कार्यांतरे सति ।\nमया नियुक्तेऽभिनये यत्र साहाय्यकारिणः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004792011, "chapter_id": 24792, "verse_number": "६-२५४-१२", "content_sanskrit": "भवंत्विंद्रपुरोगाश्च चातुर्मास्ये समागते ।\nते तथोचुश्च संहृष्टा नमस्कृत्य च शूलिनम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004792012, "chapter_id": 24792, "verse_number": "६-२५४-१३", "content_sanskrit": "स्वंस्वं भवनमाजग्मुर्विमानैः सूर्यसन्निभैः ।\nतथाऽषाढे शुक्लपक्षे चतुर्दश्यां महेश्वरः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004792013, "chapter_id": 24792, "verse_number": "६-२५४-१४", "content_sanskrit": "प्रनर्त्तयितुमारेभे भवानीतोषणाय च ।\nमंदरे पर्वतश्रेष्ठे तत्र जग्मुर्महर्षयः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004792014, "chapter_id": 24792, "verse_number": "६-२५४-१५", "content_sanskrit": "नारदो देवलो व्यासः शुकद्वैपायनादयः ।\nअंगिराश्च मरीचिश्च कर्दमश्च प्रजापतिः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004792015, "chapter_id": 24792, "verse_number": "६-२५४-१६", "content_sanskrit": "कश्यपो गौतमश्चात्रिर्वसिष्ठो भृगुरेव च ।\nजमदग्निस्तथोत्तंको रामो भार्गव एव च ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004792016, "chapter_id": 24792, "verse_number": "६-२५४-१७", "content_sanskrit": "अगस्त्यश्च पुलोमा च पुलस्त्यः पुलहस्तथा ।\nप्रचेताश्च क्रतुश्चैव तथैवान्ये महर्षयः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004792017, "chapter_id": 24792, "verse_number": "६-२५४-१८", "content_sanskrit": "सिद्धा यक्षाः पिशाचाश्च चारणाश्चारणैः सह ।\nआदित्या गुह्यकाश्चैव सा ध्याश्च वसवोऽश्विनौ ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004792018, "chapter_id": 24792, "verse_number": "६-२५४-१९", "content_sanskrit": "एते सर्वे तथेन्द्राद्या ब्रह्मविष्णुपुरोगमाः ।\nसमाजग्मुर्महेशस्य नृत्यदर्शनलालसाः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004792019, "chapter_id": 24792, "verse_number": "६-२५४-२०", "content_sanskrit": "ततो गणा नंदिमुखा रत्नानि प्रददुस्तथा ।\nभूषणानि च वासांसि मुन्यादिभ्यो यथाक्रमम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004792020, "chapter_id": 24792, "verse_number": "६-२५४-२१", "content_sanskrit": "ततो वाद्यसहस्रेषु वादित्रेषु समंततः ।\nसर्वैर्जयेति चैवोक्ता भगवा न्व्रतमादिशत् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004792021, "chapter_id": 24792, "verse_number": "६-२५४-२२", "content_sanskrit": "भवानी हृष्टहृदया महादेवं व्यलोकयत् ।\nजया च विजया चैव जयन्ती मंगलारुणा ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004792022, "chapter_id": 24792, "verse_number": "६-२५४-२३", "content_sanskrit": "चतुष्टयसखीमध्ये विर राज शुभानना ।\nतस्याः सान्निध्ययोगेन जगद्भाति गुणोत्तरम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004792023, "chapter_id": 24792, "verse_number": "६-२५४-२४", "content_sanskrit": "यस्याः शरीरजा शोभा वर्णितुं नैव शक्यते ।\nईशोऽपि गणकोटीभिर्ना नावक्त्त्राभिरीक्षितः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004792024, "chapter_id": 24792, "verse_number": "६-२५४-२५", "content_sanskrit": "पिशाचभूतसंघैश्च वृतः परमशोभनः ।\nस्वर्णवेत्रधरो नन्दी बभौ कपिमुखोऽग्रतः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004792025, "chapter_id": 24792, "verse_number": "६-२५४-२६", "content_sanskrit": "विद्याधराश्च गंधर्वाश्चि त्रसेनादयस्तथा ।\nचित्रन्यस्ता इव बभुस्तत्र नागा मुनीश्वराः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004792026, "chapter_id": 24792, "verse_number": "६-२५४-२७", "content_sanskrit": "श्रीरागप्रमुखा रागास्तस्य पुत्रा महौजसः ।\nअमूर्त्ताश्चैव ते पुत्रा हरदेव समुद्भवाः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004792027, "chapter_id": 24792, "verse_number": "६-२५४-२८", "content_sanskrit": "एकैकस्य च षड्भार्याः सर्वासां च पितामहः ।\nताभिः सहैव ते रागा लीलावपुर्धरास्तथा ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004792028, "chapter_id": 24792, "verse_number": "६-२५४-२९", "content_sanskrit": "प्रादुर्बभूवुः सहसा चिंतितास्तेन शंभुना ।\nतेषां नामानि ते वच्मि शृणुष्व त्वं महाधन ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004792029, "chapter_id": 24792, "verse_number": "६-२५४-३०", "content_sanskrit": "श्रीरागः प्रथमः पुत्र ईश्वरस्य विमोहनः ।\nआसां चक्रे भ्रुवोर्मध्ये परब्रह्म प्रदायकः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004792030, "chapter_id": 24792, "verse_number": "६-२५४-३१", "content_sanskrit": "तन्मध्यश्चैव माहेशात्समुद्भूतो गणोत्तमः ।\nद्वितीयोऽथ वसन्तोऽभूत्कटिदेशान्महायशाः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004792031, "chapter_id": 24792, "verse_number": "६-२५४-३२", "content_sanskrit": "महदंकश्च भूतानां चक्राच्चैव विशुद्धितः ।\nपंचमस्तु तृतीयोऽभूत्सुतो विश्वविभूषणः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004792032, "chapter_id": 24792, "verse_number": "६-२५४-३३", "content_sanskrit": "महेश्वरहृदो जातं चक्रं चैवमनाहतम् ।\nनासादेशात्समुद्भूतो भैरवो भैरवः स्वयम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004792033, "chapter_id": 24792, "verse_number": "६-२५४-३४", "content_sanskrit": "मणिपूरकनामेदं चक्रं तद्धि विमुक्तिदम् ।\nपंचाशच्च तथा वर्णा अंका नाम महेश्वरात् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004792034, "chapter_id": 24792, "verse_number": "६-२५४-३५", "content_sanskrit": "राशयो द्वादश तथा नक्षत्राणि तथैव च ।\nस्वाधिष्ठानसमुद्भूता जगद्बीजसमन्विताः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004792035, "chapter_id": 24792, "verse_number": "६-२५४-३६", "content_sanskrit": "क्षणेन वृद्धिमायांति ततो रेतः प्रवर्तते ।\nरेतसस्तु जगत्सृष्टं तदीशजननेंद्रियम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004792036, "chapter_id": 24792, "verse_number": "६-२५४-३७", "content_sanskrit": "आधाराच्च महान्षष्ठो नटो नारायणोऽभवत् ।\nमहेशवल्लभः पुत्रो नीलो विष्णुपराक्रमः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004792037, "chapter_id": 24792, "verse_number": "६-२५४-३८", "content_sanskrit": "एते मूर्तिधरा रागा जाता भार्यासहायिनः ।\nभार्यास्तेषां समुद्भूताः शिरोभागात्पिनाकिनः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004792038, "chapter_id": 24792, "verse_number": "६-२५४-३९", "content_sanskrit": "षट्त्रिंशत्परिमाणेन ततस्तास्त्वं निशामय ।\nगौरी कोलाहली धीरा द्राविडी माल कौशिकी ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004792039, "chapter_id": 24792, "verse_number": "६-२५४-४०", "content_sanskrit": "षष्ठी स्याद्देवगांधारी श्रीरागत्य प्रिया इमाः ।\nआन्दोला कौशिकी चैव तथा चरममंजरी ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004792040, "chapter_id": 24792, "verse_number": "६-२५४-४१", "content_sanskrit": "गंडगिरी देवशाखा राम गिरी वसन्तगा ।\nत्रिगुणा स्तम्भतीर्था च अहिरी कुंकुमा तथा ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004792041, "chapter_id": 24792, "verse_number": "६-२५४-४२", "content_sanskrit": "वैराटी सामवेरी च षड्भार्याः पंचमे मताः ।\nभैरवी गुर्जरी चैव भाषा वेलागुली तथा ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004792042, "chapter_id": 24792, "verse_number": "६-२५४-४३", "content_sanskrit": "कर्णाटकी रक्तहंसा षड्भार्या भैरवानुगाः ।\nबंगाली मधुरा चैव कामोदा चाक्षिनारिका ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004792043, "chapter_id": 24792, "verse_number": "६-२५४-४४", "content_sanskrit": "देवगिरी च देवाली मेघ रागानुगा इमा ।\nत्रोटकी मीडकी चैव नरादुम्बी तथैव च ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004792044, "chapter_id": 24792, "verse_number": "६-२५४-४५", "content_sanskrit": "मल्हारी सिन्धुमल्हारी नटनारायणानुगाः ।\nएता हि गिरिशं नत्वा महेशं च महेश्वरीम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004792045, "chapter_id": 24792, "verse_number": "६-२५४-४६", "content_sanskrit": "स्वमूर्त्तिवाहनोपेताः स्वभर्तृसहिताः स्थिताः ।\nब्रह्मा मृदंगवाद्येन तोषयामास शंकरम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004792046, "chapter_id": 24792, "verse_number": "६-२५४-४७", "content_sanskrit": "चतुरक्षरवाद्येन सुवाद्यं चाकरोत्पुनः ।\nतालक्रियां महेशाय दर्शयामास केशवः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004792047, "chapter_id": 24792, "verse_number": "६-२५४-४८", "content_sanskrit": "वायवस्तत्र वाद्यं च चक्रुः सुस्वरमोजसा ।\nमहेन्द्रो वंशवाद्यं च सुगिरं सुस्वरं बहुः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004792048, "chapter_id": 24792, "verse_number": "६-२५४-४९", "content_sanskrit": "वह्निः शूर्परवं चक्रे पणवं च तथाश्विनौ ।\nउपांगवादनं चक्रे सोमः सूर्यः समंततः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004792049, "chapter_id": 24792, "verse_number": "६-२५४-५०", "content_sanskrit": "घंटानां वादनं चक्रुर्गणाः शतसहस्रशः ।\nमुनीश्वरास्तथा देव्यः पार्वतीसहितास्तथा ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004792050, "chapter_id": 24792, "verse_number": "६-२५४-५१", "content_sanskrit": "स्वर्णभद्रासनेष्वेते ह्युपविष्टा व्यलोकयन् ।\nशृंगाणां वादनं चक्रुर्वसवः समहोरगाः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004792051, "chapter_id": 24792, "verse_number": "६-२५४-५२", "content_sanskrit": "भेरीध्वनिं तथा साध्या वाद्यान्यन्ये सुरोत्तमाः ।\nझर्झरीगोमुखादीनि साध्याश्चक्रुर्महोत्सवे ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004792052, "chapter_id": 24792, "verse_number": "६-२५४-५३", "content_sanskrit": "तन्त्रीलयसमायुक्ता गंधर्वा मधुर स्वराः ।\nसुवर्णशृंगनादं च चक्रुः सिद्धाः समंततः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004792053, "chapter_id": 24792, "verse_number": "६-२५४-५४", "content_sanskrit": "ततस्तु भगवानासीन्महानटवपुर्धरः ।\nमुकुटाः पंचशीर्षे तु पन्नगैरुपशोभिताः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004792054, "chapter_id": 24792, "verse_number": "६-२५४-५५", "content_sanskrit": "जटा विमुच्य सकला भस्मोद्धूलितविग्रहः ।\nबाहुभिर्दशभिर्युक्तो हारकेयूरसंयुतः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004792055, "chapter_id": 24792, "verse_number": "६-२५४-५६", "content_sanskrit": "त्रैलोक्यव्यापकं रूपं सूर्यकोटिसमप्रभम् ।\nकृत्वा ननर्त्त भगवान्भासुरं स महानगे ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004792056, "chapter_id": 24792, "verse_number": "६-२५४-५७", "content_sanskrit": "ततं वीणादिकं वाद्यं कांस्यतालादिकं घनम् ।\nवंशादिकं तु वादित्रं तोमरादिकनामकम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004792057, "chapter_id": 24792, "verse_number": "६-२५४-५८", "content_sanskrit": "चतुर्विधं ततो वाद्यं तुमुलं समजायत ।\nतालानां पटहादीनां हस्तकानां तथैव च ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004792058, "chapter_id": 24792, "verse_number": "६-२५४-५९", "content_sanskrit": "मानानां चैव तानानां प्रत्यक्षं रूपमाबभौ ।\nसुकंठं सुस्वरं मुक्तं सुगम्भीरं महास्वनम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004792059, "chapter_id": 24792, "verse_number": "६-२५४-६०", "content_sanskrit": "विश्वावसुर्नारदश्च तुंबुरुश्चैव गायकाः ।\nजगुर्गंधर्वपतयोऽप्सरसो मधुरस्वराः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004792060, "chapter_id": 24792, "verse_number": "६-२५४-६१", "content_sanskrit": "ग्रामत्रयसमोपेतं स्वरसप्तकसंयुतम् ।\nदिव्यं शुद्धं च सांकल्पं तत्र गेयमवर्त्तत ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004792061, "chapter_id": 24792, "verse_number": "६-२५४-६२", "content_sanskrit": "पर्वतोऽपि महानादं हरपादतलाहतः ।\nभ्रमिभिर्भ्रमयंस्तत्र महीं सपुरकाननाम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004792062, "chapter_id": 24792, "verse_number": "६-२५४-६३", "content_sanskrit": "हस्तकांश्चतुराशीतिं स ससर्ज सदाशिवः ।\nललाटफलकस्वेदात्सूतमागधबंदिनः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004792063, "chapter_id": 24792, "verse_number": "६-२५४-६४", "content_sanskrit": "महेशहृदयाज्जाता गंधर्वा विश्वगायकाः ।\nते मूर्त्ता देवदेवस्य सुरंगालयसंयुताः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004792064, "chapter_id": 24792, "verse_number": "६-२५४-६५", "content_sanskrit": "प्रेक्षकाणामृषीणां च चक्रुराश्चर्यमोजसा ।\nकिन्नराः पुष्पवर्षाणि ससृजुः स्वैर्गुणैरिह ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004792065, "chapter_id": 24792, "verse_number": "६-२५४-६६", "content_sanskrit": "एवं चतुर्षुमासेषु यदा नृत्यमजायत ।\nअतिक्रांता शरज्जाता निर्मलाकाशशोभिता ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004792066, "chapter_id": 24792, "verse_number": "६-२५४-६७", "content_sanskrit": "पद्मखंडसमाच्छन्नसरोवरमुखांबुजा ।\nफलवृक्षौषधीभिश्च किंचित्पांडुमुखच्छविः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004792067, "chapter_id": 24792, "verse_number": "६-२५४-६८", "content_sanskrit": "ऊर्जशुक्लचतुर्दश्यां प्रसन्ना गिरिजा तदा ।\nसमाप्तव्रतचर्यः स ईश्वरोऽपि तदा बभौ ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004792068, "chapter_id": 24792, "verse_number": "६-२५४-६९", "content_sanskrit": "सा चोवाच तदा शंभुं विकचस्वरलोचना ।\nविप्रशापपातितं च यदा लिंगं भविष्यति ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004792069, "chapter_id": 24792, "verse_number": "६-२५४-७०", "content_sanskrit": "नर्मदाजलसंभूतं विश्वपूज्यं भविष्यति ।\nएवमुक्त्वा ततस्तुष्टा हरस्तोत्रं चकार ह ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004792070, "chapter_id": 24792, "verse_number": "६-२५४-७१", "content_sanskrit": "नमस्ते देवदेवाय महादेवाय मौलिने ।\nजगद्धात्रे सवित्रे च शंकराय शिवाय च ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004792071, "chapter_id": 24792, "verse_number": "६-२५४-७२", "content_sanskrit": "कपर्दिनेऽजयादाय ब्रह्मगर्भाय ते नमः ।\nहिरण्यरेतसे तुभ्यं नीलग्रीवाय ते नमः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004792072, "chapter_id": 24792, "verse_number": "६-२५४-७३", "content_sanskrit": "नमो ब्रह्मण्य देवाय सितभूतिधराय च ।\nपंचवक्त्राय रूपाय नीरूपाय नमोनमः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004792073, "chapter_id": 24792, "verse_number": "६-२५४-७४", "content_sanskrit": "सहस्राक्षाय शुभ्राय नमस्ते कृत्तिवाससे ।\nअन्धकासुरमोक्षाय पशूनां पतये नमः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004792074, "chapter_id": 24792, "verse_number": "६-२५४-७५", "content_sanskrit": "विप्रवह्निमुखाग्राय हराय च भवाय च ।\nशंकराय महेशाय ईश्वराय नमो नमः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004792075, "chapter_id": 24792, "verse_number": "६-२५४-७६", "content_sanskrit": "अमूर्तब्रह्मरूपाय मूर्त्तानां भावनाय च ।\nनमः शिवाय चोग्राय हराय च भवाय च ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004792076, "chapter_id": 24792, "verse_number": "६-२५४-७७", "content_sanskrit": "नमः कृष्णाय शर्वाय त्रिपुरांतक हारिणे ।\nअघोराय नमस्तेऽस्तु नमस्ते पुरुषाय ते ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004792077, "chapter_id": 24792, "verse_number": "६-२५४-७८", "content_sanskrit": "सद्योजाताय तुभ्यं भो वामदेवाय ते नमः ।\nईशानाय नमस्तुभ्यं पंचास्याय कपालिने ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004792078, "chapter_id": 24792, "verse_number": "६-२५४-७९", "content_sanskrit": "विरूपाक्षाय भावाय भगनेत्रनिपातिने ।\nपूषदंतनिपाताय महायज्ञनिपातिने ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004792079, "chapter_id": 24792, "verse_number": "६-२५४-८०", "content_sanskrit": "मृगव्याधाय धर्माय कालचक्राय चक्रिणे ।\nमहापुरुषपूज्याय गणानां पतये नमः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004792080, "chapter_id": 24792, "verse_number": "६-२५४-८१", "content_sanskrit": "गंगाधराय मृडिने भवानीप्रियकारिणे ।\nजगदानंददात्रे च ब्रह्मरूपाय ते नमः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004792081, "chapter_id": 24792, "verse_number": "६-२५४-८२", "content_sanskrit": "गुणातीताय गुणिने सूक्ष्माय गुरवेऽपि च ।\nनमो महास्वरूपाय भस्मनो जन्मकारिणे ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7004792082, "chapter_id": 24792, "verse_number": "६-२५४-८३", "content_sanskrit": "वैराग्यरूपिणे नित्यं योगाचार्याय वै नमः ।\nमयोक्तमप्रियं देव स्मरसंहारकारक ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7004792083, "chapter_id": 24792, "verse_number": "६-२५४-८४", "content_sanskrit": "क्षंतुमर्हसि विश्वेश शिरसा त्वां प्रसादये ।\nशापानुग्रह एवैष कृतस्ते वै न संशयः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7004792084, "chapter_id": 24792, "verse_number": "६-२५४-८५", "content_sanskrit": "ममापराधजो मन्युर्न कार्यो भवताऽनघ ।\nएवं प्रसादितः शंभुर्हृष्टात्मा त्रिदशैः सह ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7004792085, "chapter_id": 24792, "verse_number": "६-२५४-८६", "content_sanskrit": "तीर्णव्रतपरानंदनिर्भरः प्राह तामुमाम् ।\nय इमां मत्स्तुतिं भक्त्या पठिष्यति तवोद्गताम् ।\nतस्य चेष्टवियोगश्च न भविष्यति पार्वति ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7004792086, "chapter_id": 24792, "verse_number": "६-२५४-८७", "content_sanskrit": "जन्मत्रयधनैर्युक्तः सर्वव्याधिविवर्जितः ।\nभुक्त्वेह विविधान्भोगानंते यास्यति मत्पुरम् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7004792087, "chapter_id": 24792, "verse_number": "६-२५४-८८", "content_sanskrit": "इत्युक्त्वा तां महेशोऽपि स्वमंगं प्रददौ ततः ।\nवैष्णवं वामभागं सा प्रतिजग्राह पार्वती ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7004792088, "chapter_id": 24792, "verse_number": "६-२५४-८९", "content_sanskrit": "शर्वं कपालहस्तं च ग्रीवार्द्धे गरलान्वितम् ।\nरुण्डमालार्द्धहारं च सितगौरं समंततः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7004792089, "chapter_id": 24792, "verse_number": "६-२५४-९०", "content_sanskrit": "ब्रह्मांडकोटिजनकं जटाभिर्भूषितं शिरः ।\nसित द्युतिकलाखंडरत्नभासावभासितम् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7004792090, "chapter_id": 24792, "verse_number": "६-२५४-९१", "content_sanskrit": "स्वर्णाभरणसंयुक्तमेकतो भुजगांगदम् ।\nएकतः कृत्तिवसनमन्यतः पट्टकूलवत् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7004792091, "chapter_id": 24792, "verse_number": "६-२५४-९२", "content_sanskrit": "मत्स्य वाहनसंयुक्तमन्यतो वृषभांकितम् ।\nएकतः पार्षदैः सेव्यमन्यतः सखिसेवितम् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7004792092, "chapter_id": 24792, "verse_number": "६-२५४-९३", "content_sanskrit": "रूपमेवंविधं दृष्ट्वा ब्रह्माद्या देवतागणाः ।\nतुष्टुवुः परया भक्त्या तेजोभूषितलोचनम् ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7004792093, "chapter_id": 24792, "verse_number": "६-२५४-९४", "content_sanskrit": "त्वमेको भगवान्सर्वव्यापकः सर्वदेहिनाम् ।\nपितृवद्रक्षकोऽसि त्वं माता त्वं जीवसंज्ञकः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7004792094, "chapter_id": 24792, "verse_number": "६-२५४-९५", "content_sanskrit": "साक्षी विश्वस्य बीजं त्वं ब्रह्मांडवशकारकः ।\nउत्पद्यंते विलीयंते त्वयि ब्रह्मांडकोटयः ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7004792095, "chapter_id": 24792, "verse_number": "६-२५४-९६", "content_sanskrit": "ऊर्मयः सागरे नित्यं सलिले बुद्बुदा यथा ।\nअहं कदा चित्ते नेत्रात्कदाचित्तव भालतः ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7004792096, "chapter_id": 24792, "verse_number": "६-२५४-९७", "content_sanskrit": "क्वचित्संगे शिवादेव्या प्राहुर्भूत्वा सृजे जगत् ।\nतवाज्ञाकरिणः सर्वे वयं ब्रह्मादयः सुराः ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7004792097, "chapter_id": 24792, "verse_number": "६-२५४-९८", "content_sanskrit": "अनंतवैभवोऽनंतोऽनंतधामाऽस्यनंतकः ।\nअनंतः सर्वभंगाय कुरुषे रूपमद्भुतम् ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7004792098, "chapter_id": 24792, "verse_number": "६-२५४-९९", "content_sanskrit": "भवानि त्वं भयं नित्यमशिवानां पवित्रकृत् ।\nशिवा नामपि दात्री त्वं तपसामपि त्वं फलम् ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7004792099, "chapter_id": 24792, "verse_number": "६-२५४-१००", "content_sanskrit": "यः शिवः स स्वयं विष्णुर्यो विष्णुः स सदाशिवः ।\nइत्यभेदमतिर्जाता स्वल्पा नस्त्वत्प्रसादतः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7004792100, "chapter_id": 24792, "verse_number": "६-२५४-१०१", "content_sanskrit": "यत्किंचिच्च जगत्यस्मिन्दृश्यते श्रूयतेऽपि वा ।\nमध्ये बहिश्च तत्सर्वं त्रयं व्याप्य स्थिता यदा ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7004792101, "chapter_id": 24792, "verse_number": "६-२५४-१०२", "content_sanskrit": "जगत्पूज्ये सुरेशानि जगद्वंद्ये तथांबिके ।\nप्रसादं कुरु देवेशि देवेश प्रणता वयम् ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7004792102, "chapter_id": 24792, "verse_number": "६-२५४-१०३", "content_sanskrit": "इत्युक्त्वा त्रिदशाः सर्वे हृष्टा जग्मुर्यथागतम् ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7004792103, "chapter_id": 24792, "verse_number": "६-२५४-१०४", "content_sanskrit": "गालव उवाच ।\nतद्दिव्यरूपमतुलं भुवि ये मनुष्याः संसारसागरसमुत्तरणैकपोतम् ।\nसंचिन्तयंति मनसा हृतकिल्बिषास्ते ब्रह्मस्वरूपमनुयांति विमुक्तसंगाः ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7004792104, "chapter_id": 24792, "verse_number": "६-२५४-१०५", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां षष्ठे नागरखण्डे हाटकेश्वरक्षेत्रमाहात्म्ये शेषशाय्युपाख्याने ब्रह्मनारदसंवादे चातुर्मास्य माहात्म्ये हरतांडवनर्त्तनवर्णनंनाम चतुःपञ्चाशदुत्तरद्विशततमोऽध्यायः ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}]