[{"id": 6000273000, "chapter_id": 10273, "verse_number": null, "content_sanskrit": "अथ सप्तसप्ततितमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000273001, "chapter_id": 10273, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_077/BhP_10.077.001.m4a", "display_order": 2}, {"id": 6000273002, "chapter_id": 10273, "verse_number": "१०-७७-१", "content_sanskrit": "बाणस्य तनयामूषामुपयेमे यदूत्तमः। तत्र युद्धमभूद् घोरं हरिशङ्करयोर्महत्।\nएतत् सर्वं महायोगिन् समाख्यातुं त्वमर्हसि॥ १०/७७/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_077/BhP_10.077.002.m4a", "display_order": 3, "topics": [{"text": "बाणासुरकथा", "range": "१–११"}]}, {"id": 6000273003, "chapter_id": 10273, "verse_number": "१०-७७-२", "content_sanskrit": "बाणः पुत्रशतज्येष्ठो बलेरासीन्महात्मनः।\nयेन वामनरूपाय हरयेऽदायि मेदिनी॥ १०/७७/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_077/BhP_10.077.003.m4a", "display_order": 4}, {"id": 6000273004, "chapter_id": 10273, "verse_number": "१०-७७-३", "content_sanskrit": "तस्यौरसः सुतो बाणः शिवभक्तिरतः सदा।\nमान्यो वदान्यो धीमांश्च सत्यसन्धो दृढव्रतः॥ १०/७७/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_077/BhP_10.077.004.m4a", "display_order": 5}, {"id": 6000273005, "chapter_id": 10273, "verse_number": "१०-७७-४", "content_sanskrit": "शोणिताख्ये पुरे रम्ये स राज्यमकरोत् पुरा। तस्य शम्भोः प्रसादेन किङ्करा इव तेऽमराः।\nसहस्रबाहुर्वाद्येन ताण्डवेऽतोषयन्मृडम्॥ १०/७७/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_077/BhP_10.077.005.m4a", "display_order": 6}, {"id": 6000273006, "chapter_id": 10273, "verse_number": "१०-७७-५", "content_sanskrit": "भगवान् सर्वभूतेशः शरण्यो भक्तवत्सलः।\nवरेण च्छन्दयामास स तं वव्रे पुराधिपम्॥ १०/७७/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_077/BhP_10.077.006.m4a", "display_order": 7}, {"id": 6000273007, "chapter_id": 10273, "verse_number": "१०-७७-६", "content_sanskrit": "स एकदाऽऽह गिरिशं पार्श्वस्थं वीर्यदुर्मदः।\nकिरीटेनार्कवर्णेन संस्पृशंस्तत्पदाम्बुजम्॥ १०/७७/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_077/BhP_10.077.007.m4a", "display_order": 8}, {"id": 6000273008, "chapter_id": 10273, "verse_number": "१०-७७-७", "content_sanskrit": "नमस्ये त्वां महादेव लोकानां गुरुमीश्वरम्।\nपुंसामपूर्णकामानां कामपूरामराङ्घ्रिपम्॥ १०/७७/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_077/BhP_10.077.008.m4a", "display_order": 9}, {"id": 6000273009, "chapter_id": 10273, "verse_number": "१०-७७-८", "content_sanskrit": "दोःसहस्रं त्वया दत्तं परं भाराय मेऽभवत्।\nत्रिलोक्यां प्रतियोद्धारं न लभे त्वदृते समम्॥ १०/७७/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_077/BhP_10.077.009.m4a", "display_order": 10}, {"id": 6000273010, "chapter_id": 10273, "verse_number": "१०-७७-९", "content_sanskrit": "कण्डूत्या निभृतैर्दोर्भिर्युयुत्सुर्दिग्गजानहम्।\nआद्यायां चूर्णयन्नद्रीन् भीतास्तेऽपि प्रदुद्रुवुः॥ १०/७७/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_077/BhP_10.077.010.m4a", "display_order": 11}, {"id": 6000273011, "chapter_id": 10273, "verse_number": "१०-७७-१०", "content_sanskrit": "तच्छ्रुत्वा भगवान् क्रुद्धः केतुस्ते भज्यते यदा।\nत्वद्दर्पघ्नं भवेन्मूढ संयुगं मत्समेन ते॥ १०/७७/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_077/BhP_10.077.011.m4a", "display_order": 12}, {"id": 6000273012, "chapter_id": 10273, "verse_number": "१०-७७-११", "content_sanskrit": "इत्युक्तः कुमतिर्हृष्टः स्वगृहं प्राविशन्नृप।\nप्रतीक्षन् गिरिशादेशं स्ववीर्यनशनं कुधीः॥ १०/७७/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_077/BhP_10.077.012.m4a", "display_order": 13}, {"id": 6000273013, "chapter_id": 10273, "verse_number": "१०-७७-१२", "content_sanskrit": "तस्योषा नाम दुहिता स्वप्ने प्राद्युम्निना रतिम्।\nकन्याऽलभत कान्तेन प्रागदृष्टश्रुतेन सा॥ १०/७७/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_077/BhP_10.077.013.m4a", "display_order": 14, "topics": [{"text": "चित्रलेखया अनिरुद्धापहरणम्", "range": "११–३५"}]}, {"id": 6000273014, "chapter_id": 10273, "verse_number": "१०-७७-१३", "content_sanskrit": "सा तत्र तमपश्यन्ती क्‍वासि कान्तेति वादिनी।\nसखीनां मध्य उत्तस्थौ विह्वला व्रीडिता भृशम्॥ १०/७७/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_077/BhP_10.077.014.m4a", "display_order": 15}, {"id": 6000273015, "chapter_id": 10273, "verse_number": "१०-७७-१४", "content_sanskrit": "बाणस्य मन्त्री कुम्भाण्डश्चित्रलेखा च तत्सुता।\nसख्यपृच्छत् सखीमूषां कौतूहलसमन्विता॥ १०/७७/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_077/BhP_10.077.015.m4a", "display_order": 16}, {"id": 6000273016, "chapter_id": 10273, "verse_number": "१०-७७-१५", "content_sanskrit": "कं त्वं मृगयसे सुभ्रु कीदृशस्ते मनोरथः।\nहस्तग्राहं न तेऽद्यापि राजपुत्र्युपलक्षये॥ १०/७७/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_077/BhP_10.077.016.m4a", "display_order": 17}, {"id": 6000273017, "chapter_id": 10273, "verse_number": null, "content_sanskrit": "ऊषोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_077/BhP_10.077.017.m4a", "display_order": 18}, {"id": 6000273018, "chapter_id": 10273, "verse_number": "१०-७७-१६", "content_sanskrit": "दृष्टः कश्चिन्नरः स्वप्ने श्यामः कमललोचनः।\nपीतवासा बृहद्बाहुर्योषितां हृदयङ्गमः॥ १०/७७/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_077/BhP_10.077.018.m4a", "display_order": 19}, {"id": 6000273019, "chapter_id": 10273, "verse_number": "१०-७७-१७", "content_sanskrit": "तमहं मृगये कान्तं पाययित्वाधरं मधु।\nक्‍वापि यातः स्पृहयतीं क्षिप्त्वा मां वृजिनार्णवे॥ १०/७७/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_077/BhP_10.077.019.m4a", "display_order": 20}, {"id": 6000273020, "chapter_id": 10273, "verse_number": null, "content_sanskrit": "चित्रलेखोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_077/BhP_10.077.020.m4a", "display_order": 21}, {"id": 6000273021, "chapter_id": 10273, "verse_number": "१०-७७-१८", "content_sanskrit": "व्यसनं तेऽपकर्षामि त्रिलोक्यां यदि भाव्यसे।\nतमानेष्ये नरं यस्ते मनोहर्ता तमादिश॥ १०/७७/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_077/BhP_10.077.021.m4a", "display_order": 22}, {"id": 6000273022, "chapter_id": 10273, "verse_number": "१०-७७-१९", "content_sanskrit": "इत्युक्त्वा देवगन्धर्वसिद्धचारणपन्नगान्।\nदैत्यविद्याधरान् यक्षान् मनुजांश्च यथाऽलिखत्॥ १०/७७/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_077/BhP_10.077.022.m4a", "display_order": 23}, {"id": 6000273023, "chapter_id": 10273, "verse_number": "१०-७७-२०", "content_sanskrit": "मनुजेषु च सा वृष्णीन् शूरमानकदुन्दुभिम्।\nव्यलिखद् रामकृष्णौ च प्रद्युम्नं वीक्ष्य लज्जिता॥ १०/७७/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_077/BhP_10.077.023.m4a", "display_order": 24}, {"id": 6000273024, "chapter_id": 10273, "verse_number": "१०-७७-२१", "content_sanskrit": "अनिरुद्धं विलिखितं वीक्ष्योषाऽवाङ्मुखी ह्रिया।\nसोऽसावसाविति प्राह स्मयमाना महीपते॥ १०/७७/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_077/BhP_10.077.024.m4a", "display_order": 25}, {"id": 6000273025, "chapter_id": 10273, "verse_number": "१०-७७-२२", "content_sanskrit": "चित्रलेखा तमाज्ञाय पौत्रं कृष्णस्य योगिनी।\nययौ विहायसा राजन् द्वारकां कृष्णपालिताम्॥ १०/७७/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_077/BhP_10.077.025.m4a", "display_order": 26}, {"id": 6000273026, "chapter_id": 10273, "verse_number": "१०-७७-२३", "content_sanskrit": "तत्र सुप्तं सुपर्यङ्के प्राद्युम्निं योगमास्थिता।\nगृहीत्वा शोणितपुरं सख्यै प्रियमदर्शयत्॥ १०/७७/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_077/BhP_10.077.026.m4a", "display_order": 27}, {"id": 6000273027, "chapter_id": 10273, "verse_number": "१०-७७-२४", "content_sanskrit": "सा च तं सुन्दरवरं विलोक्य मुदितानना।\nदुष्प्रेक्ष्ये स्वगृहे पुम्भी रेमे प्राद्युम्निना समम्॥ १०/७७/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_077/BhP_10.077.027.m4a", "display_order": 28}, {"id": 6000273028, "chapter_id": 10273, "verse_number": "१०-७७-२५", "content_sanskrit": "परार्घ्यवासःस्रग्गन्धधूपदीपासनादिभिः।\nपानभोजनभक्ष्यैश्च वाक्यैः शुश्रूषयाऽर्चितः॥ १०/७७/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_077/BhP_10.077.028.m4a", "display_order": 29}, {"id": 6000273029, "chapter_id": 10273, "verse_number": "१०-७७-२६", "content_sanskrit": "गूढः कन्यापुरे शश्वत्प्रवृद्धस्नेहया तया।\nनाहर्गणान् स बुबुधे उषयाऽपहृतेन्द्रियः॥ १०/७७/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_077/BhP_10.077.029.m4a", "display_order": 30}, {"id": 6000273030, "chapter_id": 10273, "verse_number": "१०-७७-२७", "content_sanskrit": "तां तथा यदुवीरेण भुज्यमानां हतव्रताम्।\nहेतुभिर्लक्षयाञ्चक्रुराप्रीतां दुरवच्छदैः॥ १०/७७/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_077/BhP_10.077.030.m4a", "display_order": 31}, {"id": 6000273031, "chapter_id": 10273, "verse_number": "१०-७७-२८", "content_sanskrit": "भटा आवेदयाञ्चक्रू राजंस्ते दुहितुर्वयम्।\nविचेष्टितं लक्षयामः कन्यायाः कुलदूषणम्॥ १०/७७/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_077/BhP_10.077.031.m4a", "display_order": 32}, {"id": 6000273032, "chapter_id": 10273, "verse_number": "१०-७७-२९", "content_sanskrit": "अनपायिभिरस्माभिर्गुप्तायाश्च गृहे प्रभो।\nकन्याया दूषणं पुम्भिर्दुष्प्रेक्षाया न विद्महे॥ १०/७७/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_077/BhP_10.077.032.m4a", "display_order": 33}, {"id": 6000273033, "chapter_id": 10273, "verse_number": "१०-७७-३०", "content_sanskrit": "ततः प्रव्यथितो बाणो दुहितुः श्रुतदूषणः।\nत्वरितः कन्यकागारं प्राप्तोऽद्राक्षीद् यदूद्वहम्॥ १०/७७/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_077/BhP_10.077.033.m4a", "display_order": 34}, {"id": 6000273034, "chapter_id": 10273, "verse_number": "१०-७७-३१", "content_sanskrit": "कामात्मजं तं भुवनैकसुन्दरं श्यामं पिशङ्गाम्बरमम्बुजेक्षणम्।\nबृहद्भुजं कुन्तलकुण्डलत्विषा स्मितावलोकेन च मण्डिताननम्॥ १०/७७/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_077/BhP_10.077.034.m4a", "display_order": 35}, {"id": 6000273035, "chapter_id": 10273, "verse_number": "१०-७७-३२", "content_sanskrit": "दीव्यन्तमक्षैः प्रिययाऽभिनृम्णया तदङ्गसङ्गस्तनकुङ्कुमस्रजम्।\nबाह्वोर्दधानं मधुमल्लिकाश्रितां तस्याग्र आसीनमवेक्ष्य विस्मितः॥ १०/७७/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_077/BhP_10.077.035.m4a", "display_order": 36}, {"id": 6000273036, "chapter_id": 10273, "verse_number": "१०-७७-३३", "content_sanskrit": "स तं प्रविष्टं वृतमाततायिभिर्भटैरनेकैरवलोक्य माधवः।\nउद्यम्य सौर्वं परिघं व्यवस्थितो यथाऽन्तको दण्डधरो जिघांसया॥ १०/७७/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_077/BhP_10.077.036.m4a", "display_order": 37}, {"id": 6000273037, "chapter_id": 10273, "verse_number": "१०-७७-३४", "content_sanskrit": "जिघृक्षया तान् परितः प्रसर्पतः शुनो यथा सूकरयूथपोऽहनत्।\nते हन्यमाना भवनाद् विनिर्गता निर्भिन्नमूर्धोरुभुजाः प्रदुद्रुवुः॥ १०/७७/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_077/BhP_10.077.037.m4a", "display_order": 38}, {"id": 6000273038, "chapter_id": 10273, "verse_number": "१०-७७-३५", "content_sanskrit": "तं नागपाशैर्बलिनन्दनो बली घ्नन्तं स्वसैन्यं कुपितो बबन्ध ह।\nऊषा भृशं शोकविषादविह्वला बद्धं निरीक्ष्याश्रुकलाक्ष्यरोदिषत्॥ १०/७७/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_077/BhP_10.077.038.m4a", "display_order": 39}, {"id": 6000273039, "chapter_id": 10273, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्ध उत्तरार्धे सप्तसप्ततितमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]