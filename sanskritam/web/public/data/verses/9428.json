[{"id": 40023216, "chapter_id": 9428, "verse_number": "1", "content_sanskrit": "प्रभातायां तु शर्वर्यां पृथुवक्षा महायशाः । रामः कमलपत्राक्षः पुरोधसमथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40023217, "chapter_id": 9428, "verse_number": "2", "content_sanskrit": "अग्निहोत्रं व्रजत्वग्रे दीप्यमानं सह द्विजैः । वाजपेयातपत्रं च शोभमानं महापथे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40023218, "chapter_id": 9428, "verse_number": "3", "content_sanskrit": "ततो वसिष्ठस्तेजस्वी सर्वं निरवशेषतः । चकार विधिवद्धर्मं महाप्रास्थानिकं विधिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40023219, "chapter_id": 9428, "verse_number": "4", "content_sanskrit": "ततः सूक्ष्माम्बरधरो ब्रह्ममावर्तयन्परम् । कुशान्गृहीत्वा पाणिभ्यां प्रसज्य प्रययावथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40023220, "chapter_id": 9428, "verse_number": "5", "content_sanskrit": "अव्याहरन्क्वचित्किञ्चिन्निश्चेष्टो निःसुखः पथि । निर्जगाम गृहात्तस्माद्दीप्यमान इवांशुमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40023221, "chapter_id": 9428, "verse_number": "6", "content_sanskrit": "रामस्य दक्षिणे पार्श्वे सपद्मा श्रीरपाश्रिता । सव्ये तु ह्रीर्महादेवी व्यवसायस्तथाग्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40023222, "chapter_id": 9428, "verse_number": "7", "content_sanskrit": "शरा नानाविधाश्चापि धनुरायतमुत्तमम् । तथा ऽ ऽयुधानि ते सर्वे ययुः पुरुषविग्रहाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40023223, "chapter_id": 9428, "verse_number": "8", "content_sanskrit": "वेदा ब्राह्मणरूपेण गायत्री सर्वरक्षिणी । ओङ्कारो ऽथ वषट्कारः सर्वे राममनुव्रताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40023224, "chapter_id": 9428, "verse_number": "9", "content_sanskrit": "ऋषयश्च महात्मानः सर्व एव महीसुराः । अन्वगच्छन्महात्मानं स्वर्गद्वारमपावृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40023225, "chapter_id": 9428, "verse_number": "10", "content_sanskrit": "तं यान्तमनुगच्छन्ति ह्यन्तःपुरचराः स्त्रियः । सवृद्धबालदासीकाः सवर्षवरकिङ्कराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40023226, "chapter_id": 9428, "verse_number": "11", "content_sanskrit": "सान्तःपुरश्च भरतः शत्रुघ्नसहितो ययौ । रामं गतिमुपागम्य साग्निहोत्रमनुव्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40023227, "chapter_id": 9428, "verse_number": "12", "content_sanskrit": "ते च सर्वे महात्मानः साग्निहोत्राः समागताः । सपुत्रदाराः काकुत्स्थमनुजग्मुर्महामतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40023228, "chapter_id": 9428, "verse_number": "13", "content_sanskrit": "मन्त्रिणो भृत्यवर्गाश्च सपुत्रपशुबान्धवाः । सर्वे सहानुगा राममन्वगच्छन्प्रहृष्टवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40023229, "chapter_id": 9428, "verse_number": "14", "content_sanskrit": "ततः सर्वाः प्रकृतयो हृष्टपुष्टजनावृताः । गच्छन्तमन्वगछंस्तं राघवं गुणरञ्जिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40023230, "chapter_id": 9428, "verse_number": "15", "content_sanskrit": "ततः सस्त्रीपुमांसस्ते सपक्षिपशुवाहनाः । राघवस्यानुगाः सर्वे हृष्टा विगतकल्मषाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40023231, "chapter_id": 9428, "verse_number": "16", "content_sanskrit": "स्नाताः प्रमुदिताः सर्वे हृष्टाः पुष्टाश्च वानराः । दृढं किलकिलाशब्दैः सर्वं राममनुव्रतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40023232, "chapter_id": 9428, "verse_number": "17", "content_sanskrit": "न तत्र कश्चिद्दीनो वा व्रीडितो वा ऽपि दुःखितः । हृष्टं समुदितं सर्वं बभूव परमाद्भुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40023233, "chapter_id": 9428, "verse_number": "18", "content_sanskrit": "द्रष्टुकामो ऽथ निर्यान्तं रामं जानपदो जनः । यः प्राप्तः सो ऽपि दृष्ट्वैव स्वर्गायानुगतो मुदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40023234, "chapter_id": 9428, "verse_number": "19", "content_sanskrit": "ऋक्षवानररक्षांसि जनाश्च पुरवासिनः । आगच्छन्परया भक्त्या पृष्ठतः सुसमाहिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40023235, "chapter_id": 9428, "verse_number": "20", "content_sanskrit": "यानि भूतानि नगरे ऽप्यन्तर्धानगतानि च । राघवं तान्यनुययुः स्वर्गाय समुपस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40023236, "chapter_id": 9428, "verse_number": "21", "content_sanskrit": "यानि पश्यन्ति काकुत्स्थं स्थावराणि चराणि च । सर्वाणि रामगमने ह्यनुजग्मुर्हि तान्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40023237, "chapter_id": 9428, "verse_number": "22", "content_sanskrit": "नोच्छ्वसत्तदयोध्यायां सुसूक्ष्ममपि दृश्यते । तिर्यग्योनिगताश्चापि सर्वे राममनुव्रताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]