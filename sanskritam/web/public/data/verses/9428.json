[{"id": 5000428000, "chapter_id": 9428, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे एकविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000428001, "chapter_id": 9428, "verse_number": "६-२१-१", "content_sanskrit": "ततः सागरवेलायां दर्भानास्तीर्य राघवः।\nअञ्जलिं प्राङ्मुखः कृत्वा प्रतिशिश्ये महोदधेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000428002, "chapter_id": 9428, "verse_number": "६-२१-२", "content_sanskrit": "बाहुं भुजङ्गभोगाभमुपधायारिसूदनः।\nजातरूपमयैश्चैव भूषणैर्भूषितं पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000428003, "chapter_id": 9428, "verse_number": "६-२१-३", "content_sanskrit": "मणिकाञ्चनकेयूरमुक्ताप्रवरभूषणैः।\nभुजैः परमनारीणामभिमृष्टमनेकधा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000428004, "chapter_id": 9428, "verse_number": "६-२१-४", "content_sanskrit": "चन्दनागुरुभिश्चैव पुरस्तादभिसेवितम्।\nबालसूर्यप्रकाशैश्च चन्दनैरुपशोभितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000428005, "chapter_id": 9428, "verse_number": "६-२१-५", "content_sanskrit": "शयने चोत्तमाङ्गेन सीतायाः शोभितं पुरा।\nतक्षकस्येव सम्भोगं गङ्गाजलनिषेवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000428006, "chapter_id": 9428, "verse_number": "६-२१-६", "content_sanskrit": "संयुगे युगसंकाशं शत्रूणां शोकवर्धनम्।\nसुहृदां नन्दनं दीर्घं सागरान्तव्यपाश्रयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000428007, "chapter_id": 9428, "verse_number": "६-२१-७", "content_sanskrit": "अस्यता च पुनः सव्यं ज्याघातविहतत्वचम्।\nदक्षिणो दक्षिणं बाहुं महापरिघसंनिभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000428008, "chapter_id": 9428, "verse_number": "६-२१-८", "content_sanskrit": "गोसहस्रप्रदातारं ह्युपधाय भुजं महत्।\nअद्य मे तरणं वाथ मरणं सागरस्य वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000428009, "chapter_id": 9428, "verse_number": "६-२१-९", "content_sanskrit": "इति रामो धृतिं कृत्वा महाबाहुर्महोदधिम्।\nअधिशिष्ये च विधिवत् प्रयतो नियतो मुनिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000428010, "chapter_id": 9428, "verse_number": "६-२१-१०", "content_sanskrit": "तस्य रामस्य सुप्तस्य कुशास्तीर्णे महीतले।\nनियमादप्रमत्तस्य निशास्तिस्रोऽभिजग्मतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000428011, "chapter_id": 9428, "verse_number": "६-२१-११", "content_sanskrit": "स त्रिरात्रोषितस्तत्र नयज्ञो धर्मवत्सलः।\nउपासत तदा रामः सागरं सरितां पतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000428012, "chapter_id": 9428, "verse_number": "६-२१-१२", "content_sanskrit": "न च दर्शयते रूपं मन्दो रामस्य सागरः।\nप्रयतेनापि रामेण यथार्हमभिपूजितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000428013, "chapter_id": 9428, "verse_number": "६-२१-१३", "content_sanskrit": "समुद्रस्य ततः क्रुद्धो रामो रक्तान्तलोचनः।\nसमीपस्थमुवाचेदं लक्ष्मणं शुभलक्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000428014, "chapter_id": 9428, "verse_number": "६-२१-१४", "content_sanskrit": "अवलेपः समुद्रस्य न दर्शयति यः स्वयम्।\nप्रशमश्च क्षमा चैव आर्जवं प्रियवादिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000428015, "chapter_id": 9428, "verse_number": "६-२१-१५", "content_sanskrit": "असामर्थ्यफला ह्येते निर्गुणेषु सतां गुणाः।\nआत्मप्रशंसिनं दुष्टं धृष्टं विपरिधावकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000428016, "chapter_id": 9428, "verse_number": "६-२१-१६", "content_sanskrit": "सर्वत्रोत्सृष्टदण्डं च लोकः सत्कुरुते नरम्।\nन साम्ना शक्यते कीर्तिर्न साम्ना शक्यते यशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000428017, "chapter_id": 9428, "verse_number": "६-२१-१७", "content_sanskrit": "प्राप्तुं लक्ष्मण लोकेऽस्मिञ्जयो वा रणमूर्धनि।\nअद्य मद‍्बाणनिर्भग्नैर्मकरैर्मकरालयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000428018, "chapter_id": 9428, "verse_number": "६-२१-१८", "content_sanskrit": "निरुद्धतोयं सौमित्रे प्लवद्भिः पश्य सर्वतः।\nभोगिनां पश्य भोगानि मया भिन्नानि लक्ष्मण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000428019, "chapter_id": 9428, "verse_number": "६-२१-१९", "content_sanskrit": "महाभोगानि मत्स्यानां करिणां च करानिह।\nसशङ्खशुक्तिकाजालं समीनमकरं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000428020, "chapter_id": 9428, "verse_number": "६-२१-२०", "content_sanskrit": "अद्य युद्धेन महता समुद्रं परिशोषये।\nक्षमया हि समायुक्तं मामयं मकरालयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000428021, "chapter_id": 9428, "verse_number": "६-२१-२१", "content_sanskrit": "असमर्थं विजानाति धिक् क्षमामीदृशे जने।\nन दर्शयति साम्ना मे सागरो रूपमात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000428022, "chapter_id": 9428, "verse_number": "६-२१-२२", "content_sanskrit": "चापमानय सौमित्रे शरांश्चाशीविषोपमान्।\nसमुद्रं शोषयिष्यामि पद्भ्यां यान्तु प्लवंगमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000428023, "chapter_id": 9428, "verse_number": "६-२१-२३", "content_sanskrit": "अद्याक्षोभ्यमपि क्रुद्धः क्षोभयिष्यामि सागरम्।\nवेलासु कृतमर्यादं सहस्रोर्मिसमाकुलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000428024, "chapter_id": 9428, "verse_number": "६-२१-२४", "content_sanskrit": "निर्मर्यादं करिष्यामि सायकैर्वरुणालयम्।\nमहार्णवं क्षोभयिष्ये महादानवसंकुलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000428025, "chapter_id": 9428, "verse_number": "६-२१-२५", "content_sanskrit": "एवमुक्त्वा धनुष्पाणिः क्रोधविस्फारितेक्षणः।\nबभूव रामो दुर्धर्षो युगान्ताग्निरिव ज्वलन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000428026, "chapter_id": 9428, "verse_number": "६-२१-२६", "content_sanskrit": "सम्पीड्य च धनुर्घोरं कम्पयित्वा शरैर्जगत्।\nमुमोच विशिखानुग्रान् वज्रानिव शतक्रतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000428027, "chapter_id": 9428, "verse_number": "६-२१-२७", "content_sanskrit": "ते ज्वलन्तो महावेगास्तेजसा सायकोत्तमाः।\nप्रविशन्ति समुद्रस्य जलं वित्रस्तपन्नगम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000428028, "chapter_id": 9428, "verse_number": "६-२१-२८", "content_sanskrit": "तोयवेगः समुद्रस्य समीनमकरो महान्।\nस बभूव महाघोरः समारुतरवस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000428029, "chapter_id": 9428, "verse_number": "६-२१-२९", "content_sanskrit": "महोर्मिमालाविततः शङ्खशुक्तिसमावृतः।\nसधूमः परिवृत्तोर्मिः सहसासीन्महोदधिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000428030, "chapter_id": 9428, "verse_number": "६-२१-३०", "content_sanskrit": "व्यथिताः पन्नगाश्चासन् दीप्तास्या दीप्तलोचनाः।\nदानवाश्च महावीर्याः पातालतलवासिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000428031, "chapter_id": 9428, "verse_number": "६-२१-३१", "content_sanskrit": "ऊर्मयः सिन्धुराजस्य सनक्रमकरास्तथा।\nविन्ध्यमन्दरसंकाशाः समुत्पेतुः सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000428032, "chapter_id": 9428, "verse_number": "६-२१-३२", "content_sanskrit": "आघूर्णिततरङ्गौघः सम्भ्रान्तोरगराक्षसः।\nउद्वर्तितमहाग्राहः सघोषो वरुणालयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000428033, "chapter_id": 9428, "verse_number": "६-२१-३३", "content_sanskrit": "ततस्तु तं राघवमुग्रवेगं\nप्रकर्षमाणं धनुरप्रमेयम्।\nसौमित्रिरुत्पत्य विनिःश्वसन्तं\nमामेति चोक्त्वा धनुराललम्बे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000428034, "chapter_id": 9428, "verse_number": "६-२१-३४", "content_sanskrit": "एतद्विनापि ह्युदधेस्तवाद्य\nसम्पत्स्यते वीरतमस्य कार्यम्।\nभवद्विधाः क्रोधवशं न यान्ति\nदीर्घं भवान् पश्यतु साधुवृत्तम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000428035, "chapter_id": 9428, "verse_number": "६-२१-३५", "content_sanskrit": "अन्तर्हितैश्चापि तथान्तरिक्षे\nब्रह्मर्षिभिश्चैव सुरर्षिभिश्च।\nशब्दः कृतः कष्टमिति ब्रुवद्भि-\nर्मामेति चोक्त्वा महता स्वरेण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000428036, "chapter_id": 9428, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे एकविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]