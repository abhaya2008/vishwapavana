[{"id": 2072486, "chapter_id": 2529, "verse_number": "१२-३४-०x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2072487, "chapter_id": 2529, "verse_number": "१२-३४-१", "content_sanskrit": "तपसा कर्मणा चैव प्रदानेन च भारत।\nपुनाति पापं पुरुषः पूतश्चेन्न प्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2072488, "chapter_id": 2529, "verse_number": "१२-३४-२", "content_sanskrit": "एककालं तु भुञ्जानश्चरन्भैक्षं स्वकर्मकृत्।\nकपालपाणिः खट्वाङ्गी ब्रह्मचारी सदोत्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2072489, "chapter_id": 2529, "verse_number": "१२-३४-३", "content_sanskrit": "अनसूयुरधः शायी कर्म लोके प्रकाशयन्।\nपूर्णैर्द्वादशभिर्वर्षैर्ब्रह्महा विप्रमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2072490, "chapter_id": 2529, "verse_number": "१२-३४-४", "content_sanskrit": "लक्ष्यः शस्त्रभृतां वा स्याद्विदुषामिच्छयाऽऽत्मनः।\nप्रास्येदात्मानमग्नौ वा समिद्धे त्रिरवाक्शिराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2072491, "chapter_id": 2529, "verse_number": "१२-३४-५", "content_sanskrit": "जपन्वाऽन्यतमं वेदं योजनानां शतं व्रजेत्।\nसर्वस्वं वा वेदविदे ब्राह्मणायोपपादयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2072492, "chapter_id": 2529, "verse_number": "१२-३४-६", "content_sanskrit": "धनं वा जीवनायालं गृहं वा सपरिच्छदम्।\nमुच्यते ब्रह्महत्याया गोप्ता गोब्राह्मणस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2072493, "chapter_id": 2529, "verse_number": "१२-३४-७", "content_sanskrit": "षङ्गिर्वर्षैः कृच्छ्रभोजी ब्रह्महा पूयते नरः।\nमासेमासे समश्नंस्तु त्रिभिर्वर्षैः प्रमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2072494, "chapter_id": 2529, "verse_number": "१२-३४-८", "content_sanskrit": "संवत्सरेण मासाशी पूयते नात्र संशयः।\nतथैवोपवसन्राजन्स्वल्पेनापि प्रपूयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2072495, "chapter_id": 2529, "verse_number": "१२-३४-९", "content_sanskrit": "क्रतुना चाश्वमेधेन पूयते नात्र संशयः।\nये चाप्यवभृथस्नाताः केचिदेवंविधा नराः।\nते सर्वे धूतपाप्मानो भवन्तीति परा श्रुतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2072496, "chapter_id": 2529, "verse_number": "१२-३४-१०", "content_sanskrit": "ब्राह्मणार्थे हतो युद्धे मुच्यते ब्रह्महत्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2072497, "chapter_id": 2529, "verse_number": "१२-३४-११", "content_sanskrit": "गवां शतसहस्रं तु पात्रेभ्यः प्रतिपादयेत्।\nब्रह्महा विप्रमुच्येत सर्वपापेभ्य एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2072498, "chapter_id": 2529, "verse_number": "१२-३४-१२", "content_sanskrit": "कपिलानां सहस्राणि यो दद्यात्पञ्चविंशतिम्।\nदोग्ध्रीणां स च पापेभ्यः सर्वेभ्यो विप्रमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2072499, "chapter_id": 2529, "verse_number": "१२-३४-१३", "content_sanskrit": "गोसहस्रं सवत्सानां दोग्ध्रीणां प्राणसंशये।\nसाधुभ्यो वै दरिद्रेभ्यो दत्त्वा मुच्येत किल्विषात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2072500, "chapter_id": 2529, "verse_number": "१२-३४-१४", "content_sanskrit": "शतं वै यस्तु काम्भोजान्ब्राह्मणेभ्यः प्रयच्छति।\nनियतेभ्यो महीपाल स च पापात्प्रमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2072501, "chapter_id": 2529, "verse_number": "१२-३४-१५", "content_sanskrit": "मनोरथं तु यो दद्यादेकस्मा अपि भारत।\nन कीर्तयेत दत्त्वा यः स च पापात्प्रमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2072502, "chapter_id": 2529, "verse_number": "१२-३४-१६", "content_sanskrit": "सुरापानं सकृत्कृत्वा योऽग्निवर्णां सुरां पिबेत्।\nस पावयत्यथात्मानमिह लोके परत्र च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2072503, "chapter_id": 2529, "verse_number": "१२-३४-१७", "content_sanskrit": "मरुप्रपातं प्रपतञ्ज्वलनं वा समाविशन्।\nमहाप्रस्थानमातिष्ठन्मुच्यते सर्वकिल्बिषैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2072504, "chapter_id": 2529, "verse_number": "१२-३४-१८", "content_sanskrit": "बृहस्पतिसवेनेष्ट्वा सुरापो ब्राह्मणः पुनः।\nसमितिं ब्राह्मणो गच्छेदिति वै ब्रह्मणः श्रुतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2072505, "chapter_id": 2529, "verse_number": "१२-३४-१९", "content_sanskrit": "भूमिप्रदानं कुर्याद्यः सुरां पीत्वा विमत्सरः।\nपुनर्न च पिबेद्राजन्संस्कृतः स च शुध्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2072506, "chapter_id": 2529, "verse_number": "१२-३४-२०", "content_sanskrit": "गुरुतल्पी शिलां तप्तामायसीमभिसंविशेत्।\nअवकृत्यात्मनः शेफं प्रव्रजेदूर्ध्वदर्शनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2072507, "chapter_id": 2529, "verse_number": "१२-३४-२१", "content_sanskrit": "शरीरस्य विमोक्षेण मुच्यते कर्मणोऽशुभात्।\nकर्मभ्यो विप्रमुच्यन्ते यताः संवत्सरं स्त्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2072508, "chapter_id": 2529, "verse_number": "१२-३४-२२", "content_sanskrit": "महाव्रतं चरेद्यस्तु दद्यात्सर्वस्वमेव तु।\nगुर्वर्थे वा हतो युद्धे स मुच्येत्कर्मणोऽशुभात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2072509, "chapter_id": 2529, "verse_number": "१२-३४-२३", "content_sanskrit": "अनृतेनोपवर्ती चेत्प्रतिरोद्धा गुरोस्तथा।\nउपाहृत्य प्रियं तस्मै तस्मात्पापात्प्रमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2072510, "chapter_id": 2529, "verse_number": "१२-३४-२४", "content_sanskrit": "अवकीर्णनिमित्तं तु ब्रह्महत्याव्रतं चरेत्।\nगोचर्मवासाः षण्मासांस्तथा मुच्येत किल्बिषात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2072511, "chapter_id": 2529, "verse_number": "१२-३४-२५", "content_sanskrit": "परदारोपसेवी तु परस्यापहरन्वसु।\nसंवत्सरं व्रती भूत्वा तथा मुच्येत किल्बिषात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2072512, "chapter_id": 2529, "verse_number": "१२-३४-२६", "content_sanskrit": "धनं तु यस्यापहरेत्तस्मै दद्यात्समं वसु।\nविविधेनाभ्युपायेन तदा मुच्येत किल्बिषात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2072513, "chapter_id": 2529, "verse_number": "१२-३४-२७", "content_sanskrit": "कृच्छ्राद्द्वादशरात्रेण संयतात्मा व्रते स्थितः।\nपरिवेत्ता भवेत्पूतः परिवित्तिस्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2072514, "chapter_id": 2529, "verse_number": "१२-३४-२८", "content_sanskrit": "निवेश्यं तु पुनस्तेन भवेत्तारयता पितॄन्।\nन तु स्त्रिया भवेद्दोषो न तु सा तेन लिप्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2072515, "chapter_id": 2529, "verse_number": "१२-३४-२९", "content_sanskrit": "भोजनं ह्यन्तराशुद्धं चातुर्मास्ये विधीयते।\nस्त्रियस्तेन प्रशुध्यन्ति इति धर्मविदो विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2072516, "chapter_id": 2529, "verse_number": "१२-३४-३०", "content_sanskrit": "स्त्रियस्त्वाशङ्किताः पापे नोपगम्या विजानता।\nरजसा ता विशुध्यन्ते भस्मना भाजनं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2072517, "chapter_id": 2529, "verse_number": "१२-३४-३१", "content_sanskrit": "पादजोच्छिष्टकांस्यं यद्गवा घ्रातमथापि वा।\nगण्डूषोच्छिष्टमपि वा विशुध्येद्दशभिस्तु तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2072518, "chapter_id": 2529, "verse_number": "१२-३४-३२", "content_sanskrit": "चतुष्पात्सकलो धर्मो ब्राह्मणस्य विधीयते।\nपादोन इष्टो राजन्ये तथा धर्मो विधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2072519, "chapter_id": 2529, "verse_number": "१२-३४-३३", "content_sanskrit": "तथा वैश्ये च शूद्रे च पादः पादो विधीयते।\nविद्यादेवंविधनैषां गुरुलाघवनिश्चयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2072520, "chapter_id": 2529, "verse_number": "१२-३४-३४", "content_sanskrit": "तिर्यग्योनिवधं कृत्वा द्रुमांश्छित्वोत्तरान्बहून्।\nत्रिरात्रं वायुभक्षः स्यात्कर्म च प्रथयन्नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2072521, "chapter_id": 2529, "verse_number": "१२-३४-३५", "content_sanskrit": "अगम्यागमने राजन्प्रायश्चित्तं विधीयते।\nआर्द्रवस्त्रेण षण्मासान्विभाव्यं भस्मशायिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2072522, "chapter_id": 2529, "verse_number": "१२-३४-३६", "content_sanskrit": "एवमेव तु सर्वेषामकार्याणां विधिर्भवेत्।\nब्रह्मणोक्तेन विधिना दृष्टान्तागमहेतुभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2072523, "chapter_id": 2529, "verse_number": "१२-३४-३७", "content_sanskrit": "सावित्रीमप्यधीयानः शुचौ देशे मिताशनः।\nअहिंसो मन्दकं जल्पान्मुच्यते सर्वकिल्बिषात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2072524, "chapter_id": 2529, "verse_number": "१२-३४-३८", "content_sanskrit": "अहः सु सततं तिष्ठेदभ्याकाशं निशाः स्वपन्।\nत्रिरह्नि त्रिर्निशायां च सवासा जलमाविशेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2072525, "chapter_id": 2529, "verse_number": "१२-३४-३९", "content_sanskrit": "स्त्रीशूद्रपतितांश्चापि नाभिभाषेद्ब्रतान्वितः।\nपापान्यज्ञानतः कृत्वा मुच्येदेवंव्रतो द्विजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2072526, "chapter_id": 2529, "verse_number": "१२-३४-४०", "content_sanskrit": "शुभाशुभफलं प्रेत्य लभते भूतसाक्षिकम्।\nअतिरिच्येत्तयोर्यस्तु तत्कर्ता लभते फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2072527, "chapter_id": 2529, "verse_number": "१२-३४-४१", "content_sanskrit": "तस्माद्दानेन तपसा कर्मणा च फलं शुभम्।\nवर्धयेदशुभं कृत्वा यथा स्यादतिरेकवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2072528, "chapter_id": 2529, "verse_number": "१२-३४-४२", "content_sanskrit": "कुर्याच्छुभानि कर्माणि निमित्ते पापकर्मणाम्।\nदद्यान्नित्यं च वित्तानि तथा मुच्येत किल्बिषात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2072529, "chapter_id": 2529, "verse_number": "१२-३४-४३", "content_sanskrit": "अनुरूपं हि पापस्य प्रायश्चित्तमुदाहृतम्।\nमहापातकवर्जं तु प्रायश्चित्तं विधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2072530, "chapter_id": 2529, "verse_number": "१२-३४-४४", "content_sanskrit": "भक्ष्याभक्ष्येषु चान्येषु वाच्यावाच्ये तथैव च।\nअज्ञानज्ञानयो राजन्विहितान्यनुजानतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2072531, "chapter_id": 2529, "verse_number": "१२-३४-४५", "content_sanskrit": "जानता तु कृतं पापं गुरु सर्वं भवत्युत।\nअज्ञानात्स्खलिते दोषे प्रायश्चित्तं विधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2072532, "chapter_id": 2529, "verse_number": "१२-३४-४६", "content_sanskrit": "शक्यते विधिना पापं यथोक्तेन व्यपोहितुम्।\nआस्तिके श्रद्दधाने च विधिरेष विधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2072533, "chapter_id": 2529, "verse_number": "१२-३४-४७", "content_sanskrit": "नास्तिकाश्रद्दधानेषु पुरुषेषु कदाचन।\nदम्भद्वेषप्रधानेषु विधिरेष न शिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2072534, "chapter_id": 2529, "verse_number": "१२-३४-४८", "content_sanskrit": "शिष्टाचारश्च दिष्टश्च धर्मो धर्मभूतां वर।\nसेवितव्यो नरव्याघ्र प्रेत्येह च हितेप्सुना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2072535, "chapter_id": 2529, "verse_number": "१२-३४-४९", "content_sanskrit": "स राजन्मोक्ष्यते पापात्तेन पूर्णेन हेतुना।\nत्राणार्थं वा वधे तेषामथवा नृपकर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2072536, "chapter_id": 2529, "verse_number": "१२-३४-५०", "content_sanskrit": "अथवा ते घृणा काचित्प्रायश्चित्तं चरिष्यसि।\nमा चैवानार्यजुष्टेन मृत्युना निधनं गमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2072537, "chapter_id": 2529, "verse_number": "१२-३४-५१x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2072538, "chapter_id": 2529, "verse_number": "१२-३४-५१", "content_sanskrit": "एवमुक्तो भगवता धर्मराजो युधिष्ठिरः।\nचिन्तयित्वा मुहूर्तेन प्रत्युवाच तपोधनम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2072539, "chapter_id": 2529, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि चतुस्त्रिंशोऽध्यायः॥ ३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]