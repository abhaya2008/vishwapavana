[{"id": 2009359, "chapter_id": 1185, "verse_number": "१-१८६-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2009360, "chapter_id": 1185, "verse_number": "१-१८६-१", "content_sanskrit": "ते प्रतस्थुः पुरस्कृत्य मातरं पुरुषर्षभाः।\nसमैरुदङ्मुकैर्मार्गैर्यथोद्दिष्टं च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2009361, "chapter_id": 1185, "verse_number": "१-१८६-२", "content_sanskrit": "अहोरात्रेणाभ्यगच्छन्पाञ्चालनगरं प्रति।\nअभ्याजग्मुर्लोकनदीं गङ्गां भागीरथीं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2009362, "chapter_id": 1185, "verse_number": "१-१८६-३", "content_sanskrit": "चन्द्रास्तमयवेलायामर्धरात्रसमागमे।\nवारि चैवानुमज्जन्तस्तीर्थं सोमाश्रयायणम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2009363, "chapter_id": 1185, "verse_number": "१-१८६-४", "content_sanskrit": "आसेदुः पुरुषव्याघ्रा गङ्गायां पाण्डुनन्दनाः॥\nउल्मुकं तु समुद्यम्य तेषामग्रे धनञ्जयः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2009364, "chapter_id": 1185, "verse_number": "१-१८६-५", "content_sanskrit": "प्रकाशार्थं ययौ तत्र रक्षार्थं च महारथः॥\nतत्र गङ्गाजले रम्ये विविक्ते क्रीडयन् स्त्रियः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2009365, "chapter_id": 1185, "verse_number": "१-१८६-६", "content_sanskrit": "शब्दं तेषां स शुश्राव नदीं समुपसर्पताम्।\nतेन शब्देन चाविष्टश्चुक्रोध बलवद्बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2009366, "chapter_id": 1185, "verse_number": "१-१८६-७", "content_sanskrit": "स दृष्ट्वा पाण्डवांस्तत्र सह मात्रा परन्तपान्।\nविष्फारयन्धनुर्घोरमिदं वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2009367, "chapter_id": 1185, "verse_number": "१-१८६-८", "content_sanskrit": "सन्ध्या संरज्यते घोरा पूर्वरात्रागमेषु या।\nअशीतिभिर्लवैर्हीनं तन्मुहूर्तं प्रचक्षते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2009368, "chapter_id": 1185, "verse_number": "१-१८६-९", "content_sanskrit": "विहितं कामचाराणां यक्षगन्धर्वरक्षसाम्।\nशेषमन्यन्मनुष्याणां कर्मचारेषु वै स्मृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2009369, "chapter_id": 1185, "verse_number": "१-१८६-१०", "content_sanskrit": "लोभात्प्रचारं चरतस्तासु वेलासु वै नरान्।\nउपक्रान्ता निगृह्णीमो राक्षसैः सह बालिशान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2009370, "chapter_id": 1185, "verse_number": "१-१८६-११", "content_sanskrit": "अतो रात्रौ प्राप्नुवतो जलं ब्रह्मविदो जनाः।\nगर्हयन्ति नरान्सर्वान्बलस्थान्नृपतीनपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2009371, "chapter_id": 1185, "verse_number": "१-१८६-१२", "content_sanskrit": "आराच्च तिष्ठतास्माकं समीपं नोपसर्पत।\nकस्मान्मां नाभिजानीत प्राप्तं भागीरथीजलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2009372, "chapter_id": 1185, "verse_number": "१-१८६-१३", "content_sanskrit": "अङ्गारपर्णं गन्धर्वं वित्त मां स्वबलाश्रयम्।\nअहं हि मानी चेर्ष्युश्च कुबेरस्य प्रियः सखा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2009373, "chapter_id": 1185, "verse_number": "१-१८६-१४", "content_sanskrit": "अङ्गारपर्णमित्येवं ख्यातं चेदं वनं मम।\nअनुगङ्गं चरन्कामांश्चित्रं यत्र रमाम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2009374, "chapter_id": 1185, "verse_number": "१-१८६-१५", "content_sanskrit": "न कौणपाः शृङ्गिणो वा न देवा न च मानुषाः।\nकुबेरस्य यथोष्णीषं किं मां समुपसर्पथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2009375, "chapter_id": 1185, "verse_number": "१-१८६-१६x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2009376, "chapter_id": 1185, "verse_number": "१-१८६-१६", "content_sanskrit": "समुद्रे हिमवत्पार्श्वे नद्यामस्यां च दुर्मते।\nरात्रावहनि सन्ध्यायां कस्य क्लृप्तः परिग्रहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2009377, "chapter_id": 1185, "verse_number": "१-१८६-१७", "content_sanskrit": "भुक्तो वाऽप्यथ वाऽभुक्तो रात्रावहनि खेचर।\nन कालनियमो ह्यस्ति गङ्गां प्राप्य सरिद्वरां॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2009378, "chapter_id": 1185, "verse_number": "१-१८६-१८", "content_sanskrit": "वयं च शक्तिसम्पन्ना अकाले त्वामधृष्णुम।\nअशक्ता हि रणे क्रूर युष्मानर्चन्ति मानवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2009379, "chapter_id": 1185, "verse_number": "१-१८६-१९", "content_sanskrit": "पुरा हिमवतश्चैषा हेमशृङ्गाद्विनिःसृता।\nगङ्गा गत्वा समुद्राम्भः सप्तधा समपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2009380, "chapter_id": 1185, "verse_number": "१-१८६-२०", "content_sanskrit": "गङ्गां च यमुनां चैव प्लक्षजातां सरस्वतीम्।\nरथस्थां सरयूं चैव गोमतीं गण्डकीं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2009381, "chapter_id": 1185, "verse_number": "१-१८६-२१", "content_sanskrit": "अपर्युषितपापास्ते नदीः सप्त पिबन्ति ये।\nइयं भूत्वा चैकवप्रा शुचिराकाशगा पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2009382, "chapter_id": 1185, "verse_number": "१-१८६-२२", "content_sanskrit": "देवेषु गङ्गा गन्धर्व प्राप्नोत्यलकनन्दताम्।\nतथा पितॄन्वैतरणी दुस्तरा पापकर्मभिः।\nगङ्गा भवति वै प्राप्य कृष्णद्वैपायनोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2009383, "chapter_id": 1185, "verse_number": "१-१८६-२३", "content_sanskrit": "असम्बाधा देवनदी स्वर्गसंपादनी शुभा।\nकथमिच्छसि तां रोद्धुं नैष धर्मः सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2009384, "chapter_id": 1185, "verse_number": "१-१८६-२४", "content_sanskrit": "अनिवार्यमसम्बाधं तव वाचा कथं वयम्।\nन स्पृशेम यथाकामं पुण्यं भागीरथीजलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2009385, "chapter_id": 1185, "verse_number": "१-१८६-२५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2009386, "chapter_id": 1185, "verse_number": "१-१८६-२५", "content_sanskrit": "अङ्गारपर्णस्तच्छ्रुत्वा क्रुद्ध आनाम्य कार्मुकम्।\nमुमोच बाणान्निशितानहीनाशीविषानिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2009387, "chapter_id": 1185, "verse_number": "१-१८६-२६", "content_sanskrit": "उल्मुकं भ्रामयंस्तूर्णं पाण्डवश्चर्म चोत्तरम्।\nव्यपोहत शरांस्तस्य सर्वानेव धनञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2009388, "chapter_id": 1185, "verse_number": "१-१८६-२७x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2009389, "chapter_id": 1185, "verse_number": "१-१८६-२७", "content_sanskrit": "बिभीषिका वै गन्धर्व नास्त्रज्ञेषु प्रयुज्यते।\nअस्त्रज्ञेषु प्रयुक्तेयं फेनवत्प्रविलीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2009390, "chapter_id": 1185, "verse_number": "१-१८६-२८", "content_sanskrit": "मानुषानति गन्धर्वान्सर्वान् गन्धर्व लक्षये।\nतस्मादस्त्रेण दिव्येन योत्स्येऽहं न तु मायया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2009391, "chapter_id": 1185, "verse_number": "१-१८६-२९", "content_sanskrit": "पुराऽस्त्रमिमाग्नेयं प्रादात्किल बृहस्पतिः।\nभरद्वाजाय गन्धर्व गुरुर्मान्यः शतक्रतोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2009392, "chapter_id": 1185, "verse_number": "१-१८६-३०", "content_sanskrit": "भरद्वजादग्निवेश्य अग्निवेश्याद्गुरुर्मम।\nसाध्विदं मह्यमददद्द्रोणो ब्राह्मणसत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2009393, "chapter_id": 1185, "verse_number": "१-१८६-३१x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2009394, "chapter_id": 1185, "verse_number": "१-१८६-३१", "content_sanskrit": "इत्युक्त्वा पाण्डवः क्रुद्धो गन्धर्वाय मुमोच ह।\nप्रदीप्तमस्त्रमाग्नेयं ददाहास्य रथं तु तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2009395, "chapter_id": 1185, "verse_number": "१-१८६-३२", "content_sanskrit": "विरथं विप्लुतं तं तु स गन्धऱ्वं महाबलः।\nअस्त्रतेजःप्रमूढं च प्रपतन्तमवाङ्मुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2009396, "chapter_id": 1185, "verse_number": "१-१८६-३३", "content_sanskrit": "शिरोरुहेषु जग्राह माल्यवत्सु धनञ्जयः।\nभ्रातॄन्प्रति चकर्षाथ सोऽस्त्रपातादचेतसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2009397, "chapter_id": 1185, "verse_number": "१-१८६-३४", "content_sanskrit": "युधिष्ठिरं तस्य भार्या प्रपेदे शरणार्थिनी।\nनाम्ना कुम्भीनसी नाम पतित्राणमभीप्सती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2009398, "chapter_id": 1185, "verse_number": "१-१८६-३५x", "content_sanskrit": "गन्धर्व्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2009399, "chapter_id": 1185, "verse_number": "१-१८६-३५", "content_sanskrit": "त्रायस्व मां महाभाग पतिं चेमं विमुञ्च मे।\nगन्धर्वी शरणं प्राप्ता नाम्ना कुम्भीनसी प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2009400, "chapter_id": 1185, "verse_number": "१-१८६-३६x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2009401, "chapter_id": 1185, "verse_number": "१-१८६-३६", "content_sanskrit": "युद्धे जितं यशोहीनं स्त्रीनाथमपराक्रमम्।\nको निहन्याद्रिपुं तात मुञ्चेमं रिपुसूदन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2009402, "chapter_id": 1185, "verse_number": "१-१८६-३७x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2009403, "chapter_id": 1185, "verse_number": "१-१८६-३७", "content_sanskrit": "जीवितं प्रतिपद्यस्व गच्छ गन्धर्व मा शुचः।\nप्रदिशत्यभयं तेऽद्य कुरुराजो युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2009404, "chapter_id": 1185, "verse_number": "१-१८६-३८x", "content_sanskrit": "गन्धर्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2009405, "chapter_id": 1185, "verse_number": "१-१८६-३८", "content_sanskrit": "जितोऽहं पूर्वकं नाम मुञ्चाम्यङ्गारपर्णताम्।\nयशोहीनं न च श्लाघ्यं स्वं नाम जनसंसदि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2009406, "chapter_id": 1185, "verse_number": "१-१८६-३९", "content_sanskrit": "साध्विमं लब्धवाँल्लाभं योऽहं दिव्यास्त्रधारिणम्।\nगान्धर्व्या माययेच्छामि संयोजयितुमर्जुनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2009407, "chapter_id": 1185, "verse_number": "१-१८६-४०", "content_sanskrit": "अस्त्राग्निना विचित्रोऽयं दग्धो मे रथ उत्तमः।\nसोऽहं चित्ररथो भूत्वा नाम्ना दग्धरथोऽभवं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2009408, "chapter_id": 1185, "verse_number": "१-१८६-४१", "content_sanskrit": "संभृता चैव विद्येयं तपसेह मया पुरा।\nनिवेदयिष्ये तामद्य प्राणदाय महात्मने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2009409, "chapter_id": 1185, "verse_number": "१-१८६-४२", "content_sanskrit": "संस्तम्भयित्वा तरसा जितं शरणमागतम्।\nयो रिपुं योजयेत्प्राणैः कल्याणं किं न सोऽर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2009410, "chapter_id": 1185, "verse_number": "१-१८६-४३", "content_sanskrit": "चाक्षुषी नाम विद्येयं यां सोमाय ददौ मनुः।\nददौ स विश्वावसवे मम विश्वावसुर्ददौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2009411, "chapter_id": 1185, "verse_number": "१-१८६-४४", "content_sanskrit": "सेयं कापुरुषं प्राप्ता गुरुदत्ता प्रणश्यति।\nआगमोऽस्या मया प्रोक्तो वीर्यं प्रतिनिबोध मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2009412, "chapter_id": 1185, "verse_number": "१-१८६-४५", "content_sanskrit": "यच्चक्षुषा द्रष्टुमिच्छेत्रिषु लोकेषु किंचन।\nतत्पश्येद्यादृशं चेच्छेत्तादृशं द्रष्टुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2009413, "chapter_id": 1185, "verse_number": "१-१८६-४६", "content_sanskrit": "एकपादेन षण्मासान्स्थितो विद्यां लभेदिमाम्।\nअनुनेष्याम्यहं विद्यां स्वयं तुभ्यं व्रते कृते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2009414, "chapter_id": 1185, "verse_number": "१-१८६-४७", "content_sanskrit": "विद्यया ह्यनया राजन्वयं नृभ्यो विशेषिताः।\nअविशिष्टाश्च देवानामनुभावप्रदर्शिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2009415, "chapter_id": 1185, "verse_number": "१-१८६-४८", "content_sanskrit": "गन्धर्वजानामश्वानामहं पुरुषसत्तम।\nभ्रातृभ्यस्तव तुभ्यं च पृथग्दाता शतं शतं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2009416, "chapter_id": 1185, "verse_number": "१-१८६-४९", "content_sanskrit": "देवगन्धर्ववाहास्ते दिव्यवर्णा मनोजवाः।\nक्षीणाक्षीणा भवन्त्येते न हीयन्ते च रंहसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2009417, "chapter_id": 1185, "verse_number": "१-१८६-५०", "content_sanskrit": "पुरा कृतं महेन्द्रस्य वज्रं वृत्रनिबर्हणम्।\nदशधा शतधा चैव तच्छीर्णं वृत्रमूर्धनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2009418, "chapter_id": 1185, "verse_number": "१-१८६-५१", "content_sanskrit": "ततो भागीकृतो देवैर्वज्रभाग उपास्यते।\nलोके यशोधनं किंचित्सैव वज्रतनुः स्मृता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2009419, "chapter_id": 1185, "verse_number": "१-१८६-५२", "content_sanskrit": "वज्रपाणिर्ब्राह्मणः स्यात्क्षत्रं वज्ररथं स्मृतम्।\nवैश्या वै दानवज्राश्च कर्मवज्रा यवीयसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2009420, "chapter_id": 1185, "verse_number": "१-१८६-५३", "content_sanskrit": "क्षत्रवज्रस्य भागेन अवध्या वाजिनः स्मृताः।\nरथाङ्गं वडबा सूते शूराश्चाश्वेषु ये मताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2009421, "chapter_id": 1185, "verse_number": "१-१८६-५४", "content_sanskrit": "कामवर्णाः कामजवाः कामतः समुपस्थिताः।\nइति गन्धर्वजाः कामं पूरयिष्यन्ति मे हयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2009422, "chapter_id": 1185, "verse_number": "१-१८६-५५x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2009423, "chapter_id": 1185, "verse_number": "१-१८६-५५", "content_sanskrit": "यदि प्रीतेन मे दत्तं संशये जीवितस्य वा।\nविद्याधं श्रुतं वाऽपि न तद्गन्धर्व रोचये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2009424, "chapter_id": 1185, "verse_number": "१-१८६-५६x", "content_sanskrit": "गन्धर्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2009425, "chapter_id": 1185, "verse_number": "१-१८६-५६", "content_sanskrit": "संयोगो वै प्रीतिकरो महत्सु प्रतिदृश्यते।\nजीवितस्य प्रदानेन प्रीतो विद्यां ददामि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2009426, "chapter_id": 1185, "verse_number": "१-१८६-५७", "content_sanskrit": "त्वत्तोऽप्यहं ग्रहीष्यामि अस्त्रमाग्नेयमुत्तमम्।\nतथैव योग्यं बीभत्सो चिराय मरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2009427, "chapter_id": 1185, "verse_number": "१-१८६-५८x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2009428, "chapter_id": 1185, "verse_number": "१-१८६-५८", "content_sanskrit": "त्वत्तोऽस्त्रेण वृणोम्यश्वान्संयोगः शास्वतोऽस्तुनौ।\nसखे तद्ब्रूहि गन्धर्व युष्मभ्यो यद्भयं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2009429, "chapter_id": 1185, "verse_number": "१-१८६-५९", "content_sanskrit": "कारणं ब्रूहि गन्धर्व किं तद्येन स्म धर्षिताः।\nयान्तो वेदविदः सर्वे सन्तो रात्रावरिन्दमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2009430, "chapter_id": 1185, "verse_number": "१-१८६-६०x", "content_sanskrit": "गन्धर्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2009431, "chapter_id": 1185, "verse_number": "१-१८६-६०", "content_sanskrit": "अनग्नयोऽनाहुतयो न च विप्रपुरस्कृताः।\nयूयं ततो धर्षिताः स्थ मया वै पाण्डुनन्दनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2009432, "chapter_id": 1185, "verse_number": "१-१८६-६१", "content_sanskrit": "यक्षराक्षसगन्धर्वपिशाचपतगोरगाः।\nधर्षन्ति नरव्याघ्र न ब्राह्मणपुरस्कृतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2009433, "chapter_id": 1185, "verse_number": "१-१८६-६२", "content_sanskrit": "जानतापि मया तस्मात्तेजश्चाभिजनं च वः।\nइयमग्निमतां श्रेष्ठ धर्षिता वै पुरागतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2009434, "chapter_id": 1185, "verse_number": "१-१८६-६३", "content_sanskrit": "को हि वस्त्रिषु लोकेषु न वेद भरतर्षभ।\nस्वैर्गुणैर्विस्तृतं श्रीमद्यशोऽग्र्यं भूरिवर्चसाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2009435, "chapter_id": 1185, "verse_number": "१-१८६-६४", "content_sanskrit": "यक्षराक्षसगन्धर्वाः पिशाचोरगदानवाः।\nविस्तरं कुरुवंशस्य धीमन्तः कथयन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2009436, "chapter_id": 1185, "verse_number": "१-१८६-६५", "content_sanskrit": "नारदप्रभृतीनां तु देवर्षीणां मया श्रुतम्।\nगुणान्कथयतां वीर पूर्वेषां तव धीमताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2009437, "chapter_id": 1185, "verse_number": "१-१८६-६६", "content_sanskrit": "स्वयं चापि मया दृष्टश्चरता सागराम्बराम्।\nइमां वसुमतीं कृत्स्नां प्रभावः सुकुलस्य ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2009438, "chapter_id": 1185, "verse_number": "१-१८६-६७", "content_sanskrit": "वेदे धनुषि चाचार्यमभिजानामि तेऽर्जुन।\nविश्रुतं त्रिषु लोकेषु भारद्वाजं यशस्विनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2009439, "chapter_id": 1185, "verse_number": "१-१८६-६८", "content_sanskrit": "सर्ववेदविदां श्रेष्ठं सर्वशस्त्रभृतां वरम्।\nद्रोणमिष्वस्त्रकुशलं धनुष्यह्गिरसां वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2009440, "chapter_id": 1185, "verse_number": "१-१८६-६९", "content_sanskrit": "धर्मं वायुं च शक्रं च विजानाम्यश्विनौ तथा।\nपाण्डुं च कुरुशार्दूल षडेतान्कुरुवर्धनान्।\nपितॄनेतानहं पार्थ देवमानुषसत्तमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2009441, "chapter_id": 1185, "verse_number": "१-१८६-७०", "content_sanskrit": "दिव्यात्मानो महात्मानः सर्वशस्त्रभृतां वराः।\nभवन्तो भ्रातरः शूराः सर्वे सुचरितव्रताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2009442, "chapter_id": 1185, "verse_number": "१-१८६-७१", "content_sanskrit": "उत्तमां च मनोबुद्धिं भवतां भावितात्मनाम्।\nजानन्नपि च वः पार्थ कृतवानिह धर्षणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2009443, "chapter_id": 1185, "verse_number": "१-१८६-७२", "content_sanskrit": "स्त्रीसकाशे च कौरव्य न पुमान्क्षन्तुमर्हति।\nधर्षणामात्मनः पश्यन्ब्राहुद्रविणमाश्रितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2009444, "chapter_id": 1185, "verse_number": "१-१८६-७३", "content_sanskrit": "नक्तं च बलमस्माकं भूय एवाभिवर्धते।\nयतस्ततो मां कौन्तेय सदारं मन्युराविशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2009445, "chapter_id": 1185, "verse_number": "१-१८६-७४", "content_sanskrit": "सोऽहं त्वयेह विजितः सङ्ख्ये तापत्यवर्धन।\nयेन तेनेह विधिना कीर्त्यमानं निबोध मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2009446, "chapter_id": 1185, "verse_number": "१-१८६-७५", "content_sanskrit": "ब्रह्मचर्यं परो धर्मः स चापि नियतस्त्वयि।\nयस्मात्तस्मादहं पार्थ रणे।ञस्मि विजितस्त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2009447, "chapter_id": 1185, "verse_number": "१-१८६-७६", "content_sanskrit": "यस्तु स्यात्क्षत्रियः कश्चित्कामवृत्तः परन्तप।\nनक्तं च युधि युध्येत न स जीवेत्कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2009448, "chapter_id": 1185, "verse_number": "१-१८६-७७", "content_sanskrit": "यस्तु स्यात्कामवृत्तोऽपि पार्थ ब्रह्मपुरस्कृतः।\nजयेन्नक्तञ्चरान्सर्वान्स पुरोहितधूर्गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2009449, "chapter_id": 1185, "verse_number": "१-१८६-७८", "content_sanskrit": "तस्मात्तापत्य यत्किंचिन्नृणां श्रेय इहेप्सितम्।\nतस्मिन्कर्मणि योक्तव्या दान्तात्मानः पुरोहिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2009450, "chapter_id": 1185, "verse_number": "१-१८६-७९", "content_sanskrit": "वेदे षडङ्गे निरताः शुचयः सत्यवादिनः।\nधर्मात्यागः कृतात्मानः स्युर्नृपाणां पुरोहिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2009451, "chapter_id": 1185, "verse_number": "१-१८६-८०", "content_sanskrit": "जयश्च नियतो राज्ञः स्वर्गश्च तदनन्तरम्।\nयस्य स्याद्धर्मविद्वाग्मी पुरोधाः शीलवाञ्शुचिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2009452, "chapter_id": 1185, "verse_number": "१-१८६-८१", "content_sanskrit": "लाभं लब्धुमलब्धं वा लब्धं वा परिरक्षितुम्।\nपुरोहितं प्रकुर्वीत राजा गुणसमन्वितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2009453, "chapter_id": 1185, "verse_number": "१-१८६-८२", "content_sanskrit": "पुरोहितमते तिष्ठेद्य इच्छेद्भूतिमात्मनः।\nप्राप्तुं वसुमतीं सर्वां सर्वशः सागराम्बराम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2009454, "chapter_id": 1185, "verse_number": "१-१८६-८३", "content_sanskrit": "न हि केवलशौर्येण तापत्याभिजनेन च।\nजयेदब्राह्मणः कश्चिद्भूमिं भूमिपतिः क्वचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2009455, "chapter_id": 1185, "verse_number": "१-१८६-८४", "content_sanskrit": "तस्मादेवं विजानीहि कुरूणां वंशवर्धन।\nब्राह्मणप्रमुखं राज्यं शक्यं पालयितुं चिरम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2009456, "chapter_id": 1185, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि चैत्ररथपर्वणि षडशीत्यधिकशततमोऽध्यायः॥ १८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}]