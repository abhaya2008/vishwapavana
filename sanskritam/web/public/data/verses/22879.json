[{"id": 7002879000, "chapter_id": 22879, "verse_number": "९-१६४-१", "content_sanskrit": "श्रीकृष्ण उवाच ।\nभूमिदानमतो वक्ष्ये सर्वपापप्रणाशनम् ।\nये प्रयच्छंति विप्रेभ्यो भूमिदानं सदक्षिणम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002879001, "chapter_id": 22879, "verse_number": "९-१६४-२", "content_sanskrit": "श्रोत्रियाय दरिद्राय अग्निहोत्ररताय च ।\nस सर्वकामतृप्तात्मा सर्वरत्नैर्विभूषितः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002879002, "chapter_id": 22879, "verse_number": "९-१६४-३", "content_sanskrit": "सर्वपापविनिर्मुक्तो दीप्यमानो रविर्यथा ।\nबालसूर्यप्रभाभासैर्वादित्रध्वजशोभितैः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002879003, "chapter_id": 22879, "verse_number": "९-१६४-४", "content_sanskrit": "विमानैर्भास्वरैर्दिव्यैर्विष्णुलोकं स गच्छति ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002879004, "chapter_id": 22879, "verse_number": "९-१६४-५", "content_sanskrit": "तत्र दिव्यांगनाभिश्च सेव्यमानो यथासुखम् ।\nकामगः कामरूपी च क्रीडत्यानंदमक्षयम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002879005, "chapter_id": 22879, "verse_number": "९-१६४-६", "content_sanskrit": "यावद्धारयते लोकान्भूरंकुरसमुद्भवा ।\nतावद्भूमिप्रदः कामं विष्णुलोके महीयते ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002879006, "chapter_id": 22879, "verse_number": "९-१६४-७", "content_sanskrit": "नहि भूमिप्रदानाद्वै दानमन्यद्विशिष्यते ।\nदिशो दशानुगृह्णाति हर्ता ता दश हंति च ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002879007, "chapter_id": 22879, "verse_number": "९-१६४-८", "content_sanskrit": "दानान्यन्यानि क्षीयंते कालेन पुरुषर्षभ ।\nभूमिप्रदानपुण्यस्य क्षयो नैवोपपद्यते ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002879008, "chapter_id": 22879, "verse_number": "९-१६४-९", "content_sanskrit": "सर्वपापानि क्षीयंते कालयोगक्रमेण तु ।\nभूमिहर्तुश्च राजेंद्र दुःखस्यांतो न विद्यते ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002879009, "chapter_id": 22879, "verse_number": "९-१६४-१०", "content_sanskrit": "ब्राह्मणाय सुशीलाय भूमिं दत्त्वा तु यो नरः ।\nन हि तामुपजीवेद्यः स महत्पुण्यमाप्नुयात् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002879010, "chapter_id": 22879, "verse_number": "९-१६४-११", "content_sanskrit": "हलकृष्टां महीं कृत्वा सबीजां सस्यमालिनीम् ।\nयावत्सूर्यकृता लोकस्तावत्स्वर्गे महीयते ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002879011, "chapter_id": 22879, "verse_number": "९-१६४-१२", "content_sanskrit": "धनं धान्यं हिरण्यं च रत्नान्याभरणानि च ।\nसर्वदानानि राजेंद्र ददाति वसुधां ददत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002879012, "chapter_id": 22879, "verse_number": "९-१६४-१३", "content_sanskrit": "सागरान्सरितः शैलान्समानि विषमाणि च ।\nसर्वगंधरसान्स्नेहान्ददाति वसुधां ददत् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002879013, "chapter_id": 22879, "verse_number": "९-१६४-१४", "content_sanskrit": "ओषधीः क्षीरसंपन्ना नानापुष्पफलोपगाः ।\nकमलोत्पलखंडांश्च ददाति वसुधां ददत् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002879014, "chapter_id": 22879, "verse_number": "९-१६४-१५", "content_sanskrit": "अग्निष्टोमादिभिर्यज्ञैर्ये यजंति सदक्षिणैः ।\nप्राप्नुवंति च तत्पुण्यं भूमिदानाद्यदाप्यते ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002879015, "chapter_id": 22879, "verse_number": "९-१६४-१६", "content_sanskrit": "श्रोत्रियाय महीं दत्त्वा ये हरंति न मानवाः ।\nतावत्तेषां भवेत्स्वर्गो यावल्लोका प्रतिष्ठिताः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002879016, "chapter_id": 22879, "verse_number": "९-१६४-१७", "content_sanskrit": "सस्यपूर्णां महीं यस्तु श्रोत्रियाय प्रयच्छति ।\nपितरस्तस्य तुष्यंति यावदाभूतसंप्लवम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002879017, "chapter_id": 22879, "verse_number": "९-१६४-१८", "content_sanskrit": "यत्किंचित्कुरुते पापं पुरुषो वृत्तिकर्शितः ।\nअपि गोचर्ममात्रेण भूमिदानेन शुध्यति ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002879018, "chapter_id": 22879, "verse_number": "९-१६४-१९", "content_sanskrit": "सुवर्णानां सहस्रेण यत्पुण्यं समुदाहृतम् ।\nभूमि गोचर्ममात्रेण तत्फलं प्राप्नुयान्नरः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002879019, "chapter_id": 22879, "verse_number": "९-१६४-२०", "content_sanskrit": "कपिलानां सहस्रेभ्यो यद्दत्तेऽन्नं नरोत्तम ।\nभूमिगोचर्ममात्रेण तत्फलं लभते नरः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002879020, "chapter_id": 22879, "verse_number": "९-१६४-२१", "content_sanskrit": "मध्यमस्य मनुष्यस्य व्यासेन परिसंख्यया ।\nत्रिंशद्दंडांश्च गोचर्म दत्त्वा स्वर्गे महीयते ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002879021, "chapter_id": 22879, "verse_number": "९-१६४-२२", "content_sanskrit": "बहुभिर्वसुधा भुक्ता राजभिः सगरादिभिः ।\nयस्य यस्य यदा भूमिस्तस्यतस्य तदा फलम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002879022, "chapter_id": 22879, "verse_number": "९-१६४-२३", "content_sanskrit": "किंकरा मृत्युदंडाश्च असिपत्रवनादयः ।\nघोराश्च वारुणाः पाशा नोपसर्पंति भूमिदम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002879023, "chapter_id": 22879, "verse_number": "९-१६४-२४", "content_sanskrit": "निरया रौरवाद्याश्च कुंभीपाकः सुदुःसहः ।\nतथा च यातनाः कष्टा नोपसर्पंति भूमिदम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002879024, "chapter_id": 22879, "verse_number": "९-१६४-२५", "content_sanskrit": "चित्रगुप्तश्च कालश्च कृतांतो मृत्युरेव च ।\nयमश्चापि स्वयं राजा संपूजयति भूमिदम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002879025, "chapter_id": 22879, "verse_number": "९-१६४-२६", "content_sanskrit": "रुद्रः प्रजापतिः शक्रो देवासुरगणास्तथा ।\nअहं च परमप्रीत्या पूजयामीह भूमिदम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002879026, "chapter_id": 22879, "verse_number": "९-१६४-२७", "content_sanskrit": "षट्कर्मकृत्सुवृत्ताय कृशाय च प्रियार्थिने ।\nभूमिर्देया नरव्याघ्र सन्निधिश्चाक्षयो भवेत् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002879027, "chapter_id": 22879, "verse_number": "९-१६४-२८", "content_sanskrit": "सीदमानकुटुंबाय श्रोत्रियायाहिताग्नये ।\nवृत्तस्थाय दरिद्राय भूमिर्देया नरेश्वर ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002879028, "chapter_id": 22879, "verse_number": "९-१६४-२९", "content_sanskrit": "यथा जनित्री क्षीरेण पुत्रं संवर्द्धयेत्सदा ।\nतथा भूमिप्रदं भूमिः सर्वकामैस्तु तर्पति ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002879029, "chapter_id": 22879, "verse_number": "९-१६४-३०", "content_sanskrit": "यथा गौर्भरते वत्स क्षीरेण क्षीरमुत्सृजेत् ।\nतथा सर्वरसोपेता भूमिर्भरति भूमिदम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002879030, "chapter_id": 22879, "verse_number": "९-१६४-३१", "content_sanskrit": "यथा बीजानि रोहंति जलसिक्तानि भूतले ।\nतथा कामाः प्ररोहंति भूमिदस्य दिनेदिने ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002879031, "chapter_id": 22879, "verse_number": "९-१६४-३२", "content_sanskrit": "यथोदयन्सहस्रांशुस्तमः सर्वं व्यपोहति ।\nतथा भूमिप्रदानं तु सर्वपापं व्यपोहति ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002879032, "chapter_id": 22879, "verse_number": "९-१६४-३३", "content_sanskrit": "पर दत्तां तु यो भूमिमुपहिंसेत्कदाचन ।\nस बद्धो वारुणैः पाशैः क्षिप्यते पूयशोणिते ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002879033, "chapter_id": 22879, "verse_number": "९-१६४-३४", "content_sanskrit": "स्वदत्तां परदत्तां वा यो हरेत वसुंधराम् ।\nस नरो नरके घोरे क्लिश्यत्याप्रलयांतिकम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002879034, "chapter_id": 22879, "verse_number": "९-१६४-३५", "content_sanskrit": "रुदतां वृत्तिनाशेन ये पतंत्यश्रुबिंदवः ।\nताद्वर्षसहस्राणि नरके पच्यते तु सः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002879035, "chapter_id": 22879, "verse_number": "९-१६४-३६", "content_sanskrit": "ब्राह्मणानां हृते क्षेत्रे हर्तुस्त्रिपुरुषं कुलम् ।\nदत्त्वा भूमिं तु विप्राय उपहिंसेद्यदा पुनः ।\nअधोमुखश्च दुष्टात्मा कुंभीपाके स पच्यते ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002879036, "chapter_id": 22879, "verse_number": "९-१६४-३७", "content_sanskrit": "दिव्यवर्षसहस्रांते कुंभीपाकाद्विनिःसृतः ।\nइह लोके भवेच्छा वै सप्त जन्मानि पार्थिव ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002879037, "chapter_id": 22879, "verse_number": "९-१६४-३८", "content_sanskrit": "स्वदत्तां परदत्तां वा यत्नाद्रक्षेद्युधिष्ठिर ।\nमहीं महीभृतां श्रेष्ठ दानाच्छ्रेयोनुपालनम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002879038, "chapter_id": 22879, "verse_number": "९-१६४-३९", "content_sanskrit": "तोयहीनेष्वरण्येषु शुष्ककोटरवासिनः ।\nकृष्णाह्वयोभिजायंते नरा ब्रह्मस्वहारिणः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002879039, "chapter_id": 22879, "verse_number": "९-१६४-४०", "content_sanskrit": "एवं दत्त्वा महीं राजन्प्रहृष्टेनांतरात्मना ।\nसर्वान्कामानवाप्नोति मनसा चिंतितान्नरः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002879040, "chapter_id": 22879, "verse_number": "९-१६४-४१", "content_sanskrit": "भूमिदानात्परं नास्ति सुखं वामुष्मिकं महत् ।\nन चापि भूमिहरणादन्यत्पातकमुच्यते ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002879041, "chapter_id": 22879, "verse_number": "९-१६४-४२", "content_sanskrit": "यच्छंति ये द्विजवराय महीं सुकृष्टां ते यांति शक्रसदनं सुविशुद्धदेहाः ।\nये लोपयंत्यतिबलादथ कामलोभात्ते रौरवातिगहनान्न समुत्तरंति ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]