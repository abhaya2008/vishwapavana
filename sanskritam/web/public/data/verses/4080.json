[{"id": 2142915, "chapter_id": 4080, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2142916, "chapter_id": 4080, "verse_number": "१", "content_sanskrit": "क्रुद्धं तु नहुषं दृष्ट्वा देवा ऋषिपुरोगमाः ।\nअब्रुवन् देवराजानं नहुषं घोरदर्शनम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2142917, "chapter_id": 4080, "verse_number": "२", "content_sanskrit": "देवराज जहि क्रोधं त्वयि क्रुद्धे जगद् विभो ।\nत्रस्तं सासुरगन्धर्वं सकिन्नरमहोरगम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2142918, "chapter_id": 4080, "verse_number": "३", "content_sanskrit": "जहि क्रोधमिमं साधो न कुप्यन्ति भवद्विधाः ।\nपरस्य पत्नी सा देवी प्रसीदस्व सुरेश्वर\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2142919, "chapter_id": 4080, "verse_number": "४", "content_sanskrit": "निवर्तय मनः पापात् परदाराभिमर्शनात् ।\nदेवराजोऽसि भद्रं ते प्रजा धर्मेण पालय\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2142920, "chapter_id": 4080, "verse_number": "५", "content_sanskrit": "एवमुक्तो न जग्राह तद्वचः कालचोदितः ।\nअथ देवानुवाचेदमिन्द्रं प्रति सुराधिपः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2142921, "chapter_id": 4080, "verse_number": "६", "content_sanskrit": "अहल्या धर्षिता पूर्वम् ऋषिपत्नी यशस्विनी ।\nपत्यौ जीवति सेन्द्रेण स च किं न निवारितः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2142922, "chapter_id": 4080, "verse_number": "७", "content_sanskrit": "बहूनि च नृशंसानि कृतानीन्द्रेण वै पुरा ।\nवैधर्म्याण्यपथा चैव स वः कस्मान्न वारितः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2142923, "chapter_id": 4080, "verse_number": "८", "content_sanskrit": "उपतिष्ठतु देवी मामेतदस्या हितं परम् ।\nयुष्माकं च सदा देवाः शिवमेवं भविष्यति\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2142924, "chapter_id": 4080, "verse_number": "", "content_sanskrit": "देवाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2142925, "chapter_id": 4080, "verse_number": "९", "content_sanskrit": "इन्द्राणीमानयिष्यामो सुराधिप यदीच्छसि ।\nजहि क्रोधमिमं वीर प्रीतो भव सुरेश्वर\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2142926, "chapter_id": 4080, "verse_number": "१०", "content_sanskrit": "इत्युक्त्वा तं तदा देवा ऋषिभिः सह भारत ।\nजग्मुर्बृहस्पतिं वक्तुमिन्द्राणीं चाशुभं वचः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2142927, "chapter_id": 4080, "verse_number": "", "content_sanskrit": "देवाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2142928, "chapter_id": 4080, "verse_number": "११", "content_sanskrit": "जानीमः शरणं प्राप्तामिन्द्राणीं तव वेश्मनि ।\nदत्ताभयां च विप्रेन्द्र त्वया देवर्षिसत्तम\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2142929, "chapter_id": 4080, "verse_number": "१२", "content_sanskrit": "ते त्वां देवाः सगन्धर्वा ऋषयश्च महाद्युते ।\nप्रसादयन्ति चेन्द्राणी नहुषाय प्रदीयताम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2142930, "chapter_id": 4080, "verse_number": "१३", "content_sanskrit": "इन्द्राद् विशिष्टो नहुषो देवराजो महाद्युतिः ।\nवृणोत्वियं वरारोहा भर्तृत्वे वरवर्णिनी\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2142931, "chapter_id": 4080, "verse_number": "१४", "content_sanskrit": "एवमुक्ता तु सा देवी बाष्पमुत्सृज्य सस्वनम् ।\nउवाच रुदती दीना बृहस्पतिमिदं वचः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2142932, "chapter_id": 4080, "verse_number": "१५", "content_sanskrit": "नाहमिच्छामि नहुषं पतिमन्वास्य तं प्रभुम् ।\nशरणागताऽस्मि ते ब्रह्मन् त्रायस्व महतो भयात्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2142933, "chapter_id": 4080, "verse_number": "", "content_sanskrit": "बृहस्पतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2142934, "chapter_id": 4080, "verse_number": "१६", "content_sanskrit": "शरणागतां न त्यजेयमिन्द्राणि मम निश्चयः ।\nधर्मज्ञां सत्यशीलां च न त्यजेयमनिन्दिते\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2142935, "chapter_id": 4080, "verse_number": "१७", "content_sanskrit": "नाकार्यं कर्तुमिच्छामि ब्राह्मणः सन् विशेषतः ।\nश्रुतधर्मा सत्यशीलो जानन् धर्मानुशासनम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2142936, "chapter_id": 4080, "verse_number": "१८", "content_sanskrit": "नाहमेतत् करिष्यामि गच्छध्वं वै सुरोत्तमाः ।\nअस्मिंश्चार्थे पुरा गीतं ब्रह्मणा श्रूयतामिदम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2142937, "chapter_id": 4080, "verse_number": "१९", "content_sanskrit": "न तस्य बीजं रोहति रोहकाले\nन चास्य वर्षं वर्षति वर्षकाले ।\nभीतं प्रपन्नं प्रददाति शत्रवे\nन सोऽन्तरं लभते त्राणमिच्छन्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2142938, "chapter_id": 4080, "verse_number": "२०", "content_sanskrit": "मोघमन्नं विन्दति चाप्रचेताः\nस्वर्गाल्लोकाद् भ्रश्यति भ्रष्टचेष्टः ।\nभीतं प्रपन्नं प्रददाति यो वै\nन तस्य हव्यं प्रतिगृह्णन्ति देवाः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2142939, "chapter_id": 4080, "verse_number": "२१", "content_sanskrit": "प्रमीयते चास्य प्रजा ह्यकाले\nसदा विवादं पितरोऽस्य कुर्वते ।\nभीतं प्रपन्नं प्रददाति शत्रवे\nसेन्द्रा देवाः प्रहरन्त्यस्य वज्रम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2142940, "chapter_id": 4080, "verse_number": "२२", "content_sanskrit": "एतदेवं विजानन् वै न दास्यामि शचीमिमाम् ।\nइन्द्राणीं विश्रुतां लोके शक्रस्य महिषीं प्रियाम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2142941, "chapter_id": 4080, "verse_number": "२३", "content_sanskrit": "अस्या हितं भवेद्यच्च मम चापि हितं भवेत् ।\nक्रियतां तत् सुरश्रेष्ठा न हि दास्याम्यहं शचीम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2142942, "chapter_id": 4080, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2142943, "chapter_id": 4080, "verse_number": "२४", "content_sanskrit": "अथ देवाः सगन्धर्वा गुरुमाहुरिदं वचः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2142944, "chapter_id": 4080, "verse_number": "२५", "content_sanskrit": "कथं सुनीतं तु भवेन्मन्त्रयस्व बृहस्पते\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2142945, "chapter_id": 4080, "verse_number": "", "content_sanskrit": "बृहस्पतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2142946, "chapter_id": 4080, "verse_number": "२६", "content_sanskrit": "नहुषं याचतां देवी किञ्चित् कालान्तरं शुभा ।\nहितमेतद्धि वै मन्ये तथाऽस्माकं भविष्यति\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2142947, "chapter_id": 4080, "verse_number": "२७", "content_sanskrit": "बहुविघ्नकरः कालः कालः सन् घातयिष्यति ।\nगर्वितो बलवांश्चापि नहुषो वरसंश्रयात्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2142948, "chapter_id": 4080, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2142949, "chapter_id": 4080, "verse_number": "२८", "content_sanskrit": "ततस्तेन तथोक्ते तु प्रीता देवास्तमब्रुवन्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2142950, "chapter_id": 4080, "verse_number": "२९", "content_sanskrit": "ब्रह्मन् साध्विदमुक्तं ते हितं सर्वं दिवौकसाम् ।\nएवमेतद् द्विजश्रेष्ठ देवी चेयं प्रसाद्यताम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2142951, "chapter_id": 4080, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2142952, "chapter_id": 4080, "verse_number": "३०", "content_sanskrit": "ततः समस्ता इन्द्राणीं देवाः साग्निपुरोगमाः ।\nऊचुर्वचनमव्यग्रा लोकानां हितकाम्यया\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2142953, "chapter_id": 4080, "verse_number": "३१", "content_sanskrit": "त्वया जगदिदं सर्वं धृतं स्थावरजङ्गमम् ।\nएकपत्न्यसि साध्वी च गच्छ त्वं नहुषं प्रति\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2142954, "chapter_id": 4080, "verse_number": "३२", "content_sanskrit": "क्षिप्रं त्वामभिकामश्च विनशिष्यति पापकृत् ।\nनहुषो देवि शक्रश्च सुरैश्वर्यमवाप्स्यति\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2142955, "chapter_id": 4080, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2142956, "chapter_id": 4080, "verse_number": "३३", "content_sanskrit": "एवं विनिश्चयं कृत्वा इन्द्राणी कार्यसिद्धये ।\nअभ्यगच्छत सव्रीडा नहुषं घोरदर्शनम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2142957, "chapter_id": 4080, "verse_number": "३४", "content_sanskrit": "दृष्ट्वा तां नहुषश्चापि वयोरूपसमन्विताम् ।\nसमहृष्यत दुष्टात्मा कामोपहतचेतनः \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2142958, "chapter_id": 4080, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि द्वादशोऽध्यायः ॥१२॥ सेनोद्योगपर्वणि द्वादशोऽध्यायः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]