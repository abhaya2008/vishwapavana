[{"id": 2184218, "chapter_id": 4910, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2184219, "chapter_id": 4910, "verse_number": "१", "content_sanskrit": "ततस्तेषां समस्तानामृषीणामृषिसत्तमः ।\nऋषभो नाम विप्रर्षिः स्मयन्निव ततोऽब्रवीत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2184220, "chapter_id": 4910, "verse_number": "२", "content_sanskrit": "पुराहं राजशार्दूल तीर्थान्यनुचरन् प्रभो ।\nसमासादितवान् दिव्यं नरनारायणाश्रमम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2184221, "chapter_id": 4910, "verse_number": "३", "content_sanskrit": "यत्र सा बदरी रम्या ह्रदो वैहायसस्तथा ।\nयत्र चाश्वशिरा राजन् वेदान् पठति शाश्वतान्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2184222, "chapter_id": 4910, "verse_number": "४", "content_sanskrit": "तस्मिन् सरसि कृत्वाहं विधिवत् तर्पणं पुरा ।\nपितॄणां देवतानां च ततोऽऽश्रममियां तदा\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2184223, "chapter_id": 4910, "verse_number": "५", "content_sanskrit": "रेमाते यत्र तौ नित्यं नरनारायणावृषी ।\nअदूरादाश्रमं कञ्चिद् वासार्थमगमं ततः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2184224, "chapter_id": 4910, "verse_number": "६", "content_sanskrit": "ततश्चीराजिनधरं कृशमुच्चमतीव च ।\nअद्राक्षमृषिमायान्तं तनुं नाम तपोनिधिम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2184225, "chapter_id": 4910, "verse_number": "७", "content_sanskrit": "अन्यैर्नरैर्महाबाहो वपुषाऽष्टगुणान्वितम् ।\nकृशता चापि राजर्षे न दृष्टा तादृशी क्वचित्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2184226, "chapter_id": 4910, "verse_number": "८", "content_sanskrit": "शरीरमपि राजेन्द्र तनु कानिष्ठिकासमम् ।\nग्रीवा बाहू तथा पादौ केशाश्चाद्भुतदर्शनाः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2184227, "chapter_id": 4910, "verse_number": "९", "content_sanskrit": "शिरः कायानुरूपं च कर्णौ नेत्रे तथैव च ।\nतस्य वाक् चैव चेष्टा च सामान्ये राजसत्तम\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2184228, "chapter_id": 4910, "verse_number": "१०", "content_sanskrit": "दृष्ट्वाऽहं तं कृशं विप्रं भीतः परमदुर्मनाः ।\nपादौ तस्याभिवाद्याथ स्थितः प्राञ्जलिरग्रतः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2184229, "chapter_id": 4910, "verse_number": "११", "content_sanskrit": "निवेद्य नाम गोत्रं च पितरं च नरर्षभ ।\nप्रदिष्टे चासने तेन शनैरहमुपाविशम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2184230, "chapter_id": 4910, "verse_number": "१२", "content_sanskrit": "ततः स कथयामास कथा धर्मार्थसंहिताः ।\nऋषिमध्ये महाराज तत्र धर्मभृतांवरः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2184231, "chapter_id": 4910, "verse_number": "१३", "content_sanskrit": "तस्मिंस्तु कथयत्येव राजा राजीवलोचनः ।\nउपायाद् जवनैरश्वैः सबलः सावरोधनः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2184232, "chapter_id": 4910, "verse_number": "१४", "content_sanskrit": "स्मरन् पुत्रमरण्ये वै नष्टं परमदुर्मनाः ।\nभूरिद्युम्नपिता धीमान् रघुश्रेष्ठो महायशाः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2184233, "chapter_id": 4910, "verse_number": "१५", "content_sanskrit": "इह द्रक्ष्यामि तं पुत्रं द्रक्ष्यामीहेति पार्थिवः ।\nएवमाशाकृतो राजंश्चरन् वनमिदं पुरा\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2184234, "chapter_id": 4910, "verse_number": "१६", "content_sanskrit": "दुर्लभः स मया द्रष्टुं नूनं परमधार्मिकः ।\nएकः पुत्रो महारण्ये नष्ट इत्यसकृत् तदा\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2184235, "chapter_id": 4910, "verse_number": "१७", "content_sanskrit": "दुर्लभः स मया द्रष्टुमाशा च महती मम ।\nतया परीतगात्रोऽहं मुमूर्षर्ुनात्र संशयः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2184236, "chapter_id": 4910, "verse_number": "१८", "content_sanskrit": "एतच्छ्रुत्वा स भगवांस्तनुर्मुनिवरोत्तमः ।\nअवाक्शिरा ध्यानपरो मुहूर्तमिव तस्थिवान्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2184237, "chapter_id": 4910, "verse_number": "१९", "content_sanskrit": "तमनुध्यान्तमालक्ष्य राजा परमदुर्मनाः ।\nउवाच वाक्यं दीनात्मा मन्दं मन्दमिवासकृत्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2184238, "chapter_id": 4910, "verse_number": "२०", "content_sanskrit": "दुर्लभं किन्नु विप्रर्षे आशायाश्चैव किं भवेत् ।\nब्रवीतु भगवानेतद् यदि गुह्यं न तन्मयि\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2184239, "chapter_id": 4910, "verse_number": "२१", "content_sanskrit": "महर्षिर्भगवांस्तेन पूर्वमासीद् विमानितः ।\nबालिशां बुद्धिमास्थाय मन्दभाग्यतयाऽऽत्मनः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2184240, "chapter_id": 4910, "verse_number": "२२", "content_sanskrit": "अर्थयन् कलशं राजन् काञ्चनं वल्कलानि च ।\nनिर्विण्णः स तु विप्रर्षिर्निराशः समपद्यत\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2184241, "chapter_id": 4910, "verse_number": "२३", "content_sanskrit": "एवमुक्त्वाऽभिवाद्याथ तमृषिं लोकपूजितम् ।\nश्रान्तो न्यषीदद् धर्मात्मा यथा त्वं नरसत्तम\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2184242, "chapter_id": 4910, "verse_number": "२४", "content_sanskrit": "अर्घ्यं ततः समानीय पाद्यं चैव महानृषिः ।\nआरण्यकेन विधिना राज्ञे सर्वं न्यवेदयत्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2184243, "chapter_id": 4910, "verse_number": "२५", "content_sanskrit": "ततस्ते मुनयः सर्वे परिवार्य नरर्षभम् ।\nउपाविशन् पुरस्कृत्य सप्तर्षय इव ध्रुवम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2184244, "chapter_id": 4910, "verse_number": "२६", "content_sanskrit": "अपृच्छंश्चैव ते तत्र राजानमपराजितम् ।\nप्रयोजनमिदं सर्वमाश्रमस्य प्रवेशनम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2184245, "chapter_id": 4910, "verse_number": "", "content_sanskrit": "राजा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2184246, "chapter_id": 4910, "verse_number": "२७", "content_sanskrit": "वीरद्युम्न इति ख्यातो राजाहं दिक्षु विश्रुतः ।\nभूरिद्युम्नं सुतं नष्टमन्वेष्टुं वनमागतः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2184247, "chapter_id": 4910, "verse_number": "२८", "content_sanskrit": "एकपुत्रः स विप्राग्र्य बाल एव च सोऽनघ ।\nन दृश्यते वने चास्मिंस्तमन्वेष्टुं चराम्यहम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2184248, "chapter_id": 4910, "verse_number": "", "content_sanskrit": "ऋषभः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2184249, "chapter_id": 4910, "verse_number": "२९", "content_sanskrit": "एवमुक्ते तु वचने राज्ञा मुनिरधोमुखः ।\nतूष्णीमेवाभवत् तत्र नच प्रत्युक्तवान् नृपम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2184250, "chapter_id": 4910, "verse_number": "३०", "content_sanskrit": "स हि तेन पुरा विप्रो राज्ञा नात्यर्थमानितः ।\nआशाकृशं च राजेन्द्र तपो दीर्घं समास्थितः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2184251, "chapter_id": 4910, "verse_number": "३१", "content_sanskrit": "प्रतिग्रहमहं राज्ञां न करिष्ये कथञ्चन ।\nअन्येषां चैव वर्णानामिति कृत्वा धियं तदा\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2184252, "chapter_id": 4910, "verse_number": "३२", "content_sanskrit": "आशा हि पुरुषं बालं लालापयति तस्थुषी ।\nतामहं व्यपनेष्यामि इति कृत्वा व्यवस्थितः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2184253, "chapter_id": 4910, "verse_number": "", "content_sanskrit": "राजा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2184254, "chapter_id": 4910, "verse_number": "३३", "content_sanskrit": "आशायाः किं कृशत्वं च किं चेह भुवि दुर्लभम् ।\nब्रवीतु भगवानेतत् त्वं हि धर्मार्थदर्शिवान्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2184255, "chapter_id": 4910, "verse_number": "", "content_sanskrit": "ऋषभः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2184256, "chapter_id": 4910, "verse_number": "३४", "content_sanskrit": "ततः संस्मृत्य तत् सर्वं स्मारयिष्यन्निवाब्रवीत् ।\nराजानं भगवान् विप्रस्ततः कृशतनुस्तनुः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2184257, "chapter_id": 4910, "verse_number": "३५", "content_sanskrit": "कृशत्वेन समं राजन्नाशाया विद्यते न च ।\nतस्य वै दुर्लभत्वात्तु प्रार्थिताः पार्थिवा मया\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2184258, "chapter_id": 4910, "verse_number": "", "content_sanskrit": "राजा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2184259, "chapter_id": 4910, "verse_number": "३६", "content_sanskrit": "कृशाकृशे मया ब्रह्मन् गृहीते वचनात् तव ।\nदुर्लभत्वं च तस्यैव वेदवाक्यमिव द्विज\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2184260, "chapter_id": 4910, "verse_number": "३७", "content_sanskrit": "संशयस्तु महाप्राज्ञ सञ्जातो हृदये मम ।\nतन्मे सत्तम तत्त्वेन वक्तुमर्हसि पृच्छतः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2184261, "chapter_id": 4910, "verse_number": "३८", "content_sanskrit": "त्वत्तः कृशतरं किन्नु ब्रवीतु भगवानिदम् ।\nयदि गुह्यं न ते विप्र लोकेऽस्मिन् किं नु दुर्लभम्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2184262, "chapter_id": 4910, "verse_number": "", "content_sanskrit": "कृशतनुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2184263, "chapter_id": 4910, "verse_number": "३९", "content_sanskrit": "दुर्लभोऽप्यथ वा नास्ति योऽर्थी धृतिमवाप्नुयात् ।\nसुदुर्लभतरस्तात योऽर्थिनं नावमन्यते\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2184264, "chapter_id": 4910, "verse_number": "४०", "content_sanskrit": "सत्कृत्य नोपकुरुते परं शक्त्या यथार्हतः ।\nसक्ता या सर्वभूतेषु साऽऽशा कृशतरी मया\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2184265, "chapter_id": 4910, "verse_number": "४१", "content_sanskrit": "कृतघ्नेषु च या सक्ता नृशंसेष्वलसेषु च ।\nअपकारिषु या सक्ता साऽऽशा कृशतरी मया\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2184266, "chapter_id": 4910, "verse_number": "४२", "content_sanskrit": "एकपुत्रः पिता पुत्रे नष्टे वा प्रोषिते तथा ।\nप्रवृत्तिं यो न जानाति साऽऽशा कृशतरी मया\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2184267, "chapter_id": 4910, "verse_number": "४३", "content_sanskrit": "प्रसवे चैव नारीणां वृद्धानां पुत्रकारिता ।\nतथा नरेन्द्र धनिनामाशा कृशतरी मया\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2184268, "chapter_id": 4910, "verse_number": "४४", "content_sanskrit": "प्रदानकाङ्क्षिणीनां च कन्यानां वयसि स्थिते ।\nश्रुत्वा कथास्तथाऽयुक्ता साशा कृशतरी मया\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2184269, "chapter_id": 4910, "verse_number": "", "content_sanskrit": "ऋषभः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2184270, "chapter_id": 4910, "verse_number": "४५", "content_sanskrit": "एतच्छ्रुत्वा ततो राजन् स राजा सावरोधनः ।\nसंस्पृश्य पादौ शिरसा निपपात द्विजर्षभे\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2184271, "chapter_id": 4910, "verse_number": "", "content_sanskrit": "राजा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2184272, "chapter_id": 4910, "verse_number": "४६", "content_sanskrit": "प्रसादये त्वा भगवन् पुत्रेणेच्छामि सङ्गतिम् ।\nवृणीष्व च वरं विप्र यमिच्छसि यथाविधि\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2184273, "chapter_id": 4910, "verse_number": "", "content_sanskrit": "ऋषभः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2184274, "chapter_id": 4910, "verse_number": "४७", "content_sanskrit": "अब्रवीच्च हि तं वाक्यं राजा राजीवलोचनः ।\nसत्यमेतदसन्देहं त्वयोक्तं नास्त्यतो मृषा\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2184275, "chapter_id": 4910, "verse_number": "४८", "content_sanskrit": "ततः प्रहस्य भगवांस्तनुर्धर्मभृतां वरः ।\nपुत्रमस्यानयत् क्षिप्रं तपसा च श्रुतेन च\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2184276, "chapter_id": 4910, "verse_number": "४९", "content_sanskrit": "तं समानाय्य पुत्रं तु तदोपालभ्य पार्थिवम् ।\nआत्मानं दर्शयामास धर्मं धर्मभृतां वरः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2184277, "chapter_id": 4910, "verse_number": "५०", "content_sanskrit": "सन्दर्शयित्वा चात्मानं दिव्यमद्भुतदर्शनम् ।\nविपाप्मा विगतक्रोधश्चचार वनमन्तिकात्\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2184278, "chapter_id": 4910, "verse_number": "५१", "content_sanskrit": "एतद् दृष्टं मया राजंस्ततश्च वचनं श्रुतम् ।\nआशामपनयस्वाशु ततः कृशतरीमिमाम्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2184279, "chapter_id": 4910, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2184280, "chapter_id": 4910, "verse_number": "५२", "content_sanskrit": "स तत्रोक्तो महाराज ऋषभेण महात्मना ।\nसुमित्रोऽपनयत् क्षिप्रमाशां कृशतरीं तदा\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2184281, "chapter_id": 4910, "verse_number": "५३", "content_sanskrit": "एवं त्वमपि कौन्तेय श्रुत्वा वाणीमिमां मम ।\nस्थिरो भव यथा राजन् हिमवानचलोत्तमः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2184282, "chapter_id": 4910, "verse_number": "५४", "content_sanskrit": "त्वं हि द्रष्टा च श्रोता च कृच्छ्रेष्वर्थकृतेष्विह ।\nश्रुत्वा मम महाराज न सन्तप्तुमिहार्हसि\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2184283, "chapter_id": 4910, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि राजधर्मे सप्तविंशाधिकशततमोध्यायः ॥ १२७ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}]