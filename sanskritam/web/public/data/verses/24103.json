[{"id": 7004103000, "chapter_id": 24103, "verse_number": "४-५२-१", "content_sanskrit": "स्कंद उवाच ।\nगभस्तिमालिनिगते काशीं त्रैलोक्यमोहिनीम् ।\nपुनश्चिंतामवापोच्चैर्मंदरस्थो मुने हरः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004103001, "chapter_id": 24103, "verse_number": "४-५२-२", "content_sanskrit": "नाद्याप्यायांति योगिन्यो नाद्याप्यायाति तिग्मगुः ।\nप्रवृत्तिरपि मे काश्याश्चित्रमत्यंत दुर्लभा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004103002, "chapter_id": 24103, "verse_number": "४-५२-३", "content_sanskrit": "किमत्र चित्रं यत्काशी मदीयमपिमानसम् ।\nनिश्चलं चंचलयति गणना केतरेसुरे ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004103003, "chapter_id": 24103, "verse_number": "४-५२-४", "content_sanskrit": "अधाक्षिपमहं कामं त्रिजगज्जित्त्वरंदृशा ।\nअहो काश्यभिलाषोत्र मामेव दुनुयात्तराम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004103004, "chapter_id": 24103, "verse_number": "४-५२-५", "content_sanskrit": "काशीप्रवृत्तिमन्वेष्टुं कं वा प्रहिणुयामितः ।\nज्ञातुं क एव निपुणो यतः स चतुराननः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004103005, "chapter_id": 24103, "verse_number": "४-५२-६", "content_sanskrit": "इत्याहूय विधातारं बहुमानपुरःसरम् ।\nतत्रोपवेश्य श्रीकंठः प्रोवाच चतुराननम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004103006, "chapter_id": 24103, "verse_number": "४-५२-७", "content_sanskrit": "योगिन्यः प्रेषिताः पूर्वं प्रेषितोथ सहस्रगुः ।\nनाद्यापि ते निवर्तंते काश्याः कलशसंभव ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004103007, "chapter_id": 24103, "verse_number": "४-५२-८", "content_sanskrit": "सा समुत्सुकयेत्काशी लोकेश मम मानसम् ।\nप्राकृतस्य जनस्येव चंचलाक्षीव काचन ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004103008, "chapter_id": 24103, "verse_number": "४-५२-९", "content_sanskrit": "मंदरेत्र रतिर्मे न भृशं सुंदरकंदरे ।\nअनच्छतुच्छपानीये नक्रस्येवाल्पपल्वले ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004103009, "chapter_id": 24103, "verse_number": "४-५२-१०", "content_sanskrit": "ना बाधिष्ट तथा मां स तापो हालाहलोद्भवः ।\nकाशीविरहजन्मात्र यथा मामतिबाधते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004103010, "chapter_id": 24103, "verse_number": "४-५२-११", "content_sanskrit": "शीतरश्मिः शिरःस्थोपि वर्षन्पीयूषसीकरैः ।\nकाशीविश्लेषजं तापं नाहो गमयितुं प्रभुः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004103011, "chapter_id": 24103, "verse_number": "४-५२-१२", "content_sanskrit": "विधे विधेहि मे कार्यमार्य धुर्य महामते ।\nयाहि काशीमितस्तूर्णं यतस्व च ममेहिते ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004103012, "chapter_id": 24103, "verse_number": "४-५२-१३", "content_sanskrit": "ब्रह्मंस्त्वमेव तद्वेत्सि काशी त्यजनकारणम् ।\nमंदोपि न त्यजेत्काशीं किमु यो वेत्ति किंचन ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004103013, "chapter_id": 24103, "verse_number": "४-५२-१४", "content_sanskrit": "अद्यैव किं न गच्छेयं काशीं ब्रह्मन्स्वमायया ।\nदिवोदासं स्वधर्मस्थं न तूल्लंघितुमुत्सहे ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004103014, "chapter_id": 24103, "verse_number": "४-५२-१५", "content_sanskrit": "विधे सर्वविधेयानि त्वमेव विदधासि यत् ।\nइति चेति च वक्तव्यं त्वय्यपार्थमतोखिलम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004103015, "chapter_id": 24103, "verse_number": "४-५२-१६", "content_sanskrit": "अरिष्टं गच्छ पंथास्ते शुभोदर्को भवत्वलम् ।\nआदायाज्ञां विधि मूर्ध्नि ययौ वाराणसीं मुदा ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004103016, "chapter_id": 24103, "verse_number": "४-५२-१७", "content_sanskrit": "सितहंसरथस्तूर्णं प्राप्य वाराणसीं पुरीम् ।\nकृतकृत्यमिवात्मानममन्यत तदात्मभूः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004103017, "chapter_id": 24103, "verse_number": "४-५२-१८", "content_sanskrit": "हंसयानफलं मेद्य जातं काशीसमागमे ।\nकाशी प्राप्तौ यतः प्रोक्ता अंतरायाः पदेपदे ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004103018, "chapter_id": 24103, "verse_number": "४-५२-१९", "content_sanskrit": "दृशि धातुरभूद्य मदृशो प्राप्य सान्वयः ।\nस्पष्टं दृष्टिपथं प्राप्ता यदेषाऽनंदवाटिका ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004103019, "chapter_id": 24103, "verse_number": "४-५२-२०", "content_sanskrit": "स्वयं सिंचति या मद्भिः स्वाभिः स्वर्गतरंगिणी ।\nयत्रानंदमया वृक्षा यत्रानंदमया जनाः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004103020, "chapter_id": 24103, "verse_number": "४-५२-२१", "content_sanskrit": "निर्विशंति सदा काश्यां फलान्यानंदवंत्यपि ।\nसदैवानंदभूः काशी सदैवानंददः शिवः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004103021, "chapter_id": 24103, "verse_number": "४-५२-२२", "content_sanskrit": "आनंदरूपा जायंते तेन काश्यां हि जंतवः ।\nचरणौ चरितुं वित्तस्तावेव कृतिनामिह ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004103022, "chapter_id": 24103, "verse_number": "४-५२-२३", "content_sanskrit": "चरणौ विचरेतांयौ विश्वभर्तृ पुरी भुवि ।\nतावेव श्रवणौ श्रोतुं संविदा ते बहुश्रुतौ ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004103023, "chapter_id": 24103, "verse_number": "४-५२-२४", "content_sanskrit": "इह श्रुतिमतां पुंसां याभ्यां काशी श्रुता सकृत् ।\nतदेव मनुते सर्वं मनस्त्विह मनस्विनाम ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004103024, "chapter_id": 24103, "verse_number": "४-५२-२५", "content_sanskrit": "येनानुमन्यते चैषा काशी सर्वप्रमाणभूः ।\nबुद्धिर्बुध्यति सा सर्वमिह बुद्धिमतां सताम् ।\nययैतद्धूर्जटेर्धाम धृतं स्व विषयीकृतम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004103025, "chapter_id": 24103, "verse_number": "४-५२-२६", "content_sanskrit": "वरं तृणानि धान्यानि तानि वात्याहतान्यपि ।\nकाश्यां यान्या पतंतीह न जनाः काश्यदर्शनाः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004103026, "chapter_id": 24103, "verse_number": "४-५२-२७", "content_sanskrit": "अद्य मे सफलं चायुः परार्धद्वय संमितम् ।\nयस्मिन्सति मया प्रापि दुष्प्रापा काशिका पुरी ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004103027, "chapter_id": 24103, "verse_number": "४-५२-२८", "content_sanskrit": "अहो मे धर्मसंपत्तिरहोमे भाग्यगौरवम् ।\nयदद्राक्षिषमद्याहं काशीं सुचिर चिंतिताम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004103028, "chapter_id": 24103, "verse_number": "४-५२-२९", "content_sanskrit": "अद्य मे स्वतपो वृक्षो मनोरथफलैरलम् ।\nशिवभक्त्यंबुना सिक्तः फलितोति बृहत्तरैः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004103029, "chapter_id": 24103, "verse_number": "४-५२-३०", "content_sanskrit": "मया व्यधायि बहुधा सृष्टिः सृष्टिं वितन्वता ।\nपरमन्यादृशी काशी स्वयं विश्वेश निर्मितिः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004103030, "chapter_id": 24103, "verse_number": "४-५२-३१", "content_sanskrit": "इति हृष्टमना वेधा दृष्ट्वा वाराणसीं पुरीम् ।\nवृद्धब्राह्मणरूपेण राजानं च ददर्श ह ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004103031, "chapter_id": 24103, "verse_number": "४-५२-३२", "content_sanskrit": "जलार्द्राक्षतपाणिश्च स्वस्त्युक्त्वा पृथिवीभुजे ।\nकृतप्रणामो राज्ञाथ भेजे तद्दत्तमासनम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004103032, "chapter_id": 24103, "verse_number": "४-५२-३३", "content_sanskrit": "कृतमानो नृपतिना सोभ्युत्थानासनादिभिः ।\nविप्रो व्यजिज्ञपद्भूपं पृष्टागमनकारणम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004103033, "chapter_id": 24103, "verse_number": "४-५२-३४", "content_sanskrit": "ब्राह्मण उवाच ।\nभूपाल बहुकालीनोस्म्यहमत्र चिरंतनः ।\nत्वं तु मां नैव जानासि जाने त्वां हि रिपुंजयम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004103034, "chapter_id": 24103, "verse_number": "४-५२-३५", "content_sanskrit": "परःशता मया दृष्टा राजानो भूरिदक्षिणाः ।\nविजितानेकसंग्रामा यायजूका जितेंद्रियाः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004103035, "chapter_id": 24103, "verse_number": "४-५२-३६", "content_sanskrit": "विनिष्कृतारिषड्वर्गाः सुशीलाः सत्त्वशालिनः ।\nश्रुतस्यपारदृश्वानो राजनीतिविचक्षणाः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004103036, "chapter_id": 24103, "verse_number": "४-५२-३७", "content_sanskrit": "दयादाक्षिण्यनिपुणाः सत्यव्रतपरायणाः ।\nक्षमया क्षमयातुल्या गांभीर्यजितसागराः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004103037, "chapter_id": 24103, "verse_number": "४-५२-३८", "content_sanskrit": "जितरोषरयाः शूराः सौम्यसौंदर्यभूमयः ।\nइत्यादि गुणसंपन्नाः सुसंचितयशोधनाः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004103038, "chapter_id": 24103, "verse_number": "४-५२-३९", "content_sanskrit": "परं द्वित्राः पवित्रा ये राजर्षे तव सद्गुणाः ।\nतेष्वेषु राजसु मम प्रायशो न दृशं गताः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004103039, "chapter_id": 24103, "verse_number": "४-५२-४०", "content_sanskrit": "प्रजानिजकुटुंबस्त्वं त्वं तु भूदेवदैवतः ।\nमहातपः सहायस्त्वं पथानान्ये तथा नृपाः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004103040, "chapter_id": 24103, "verse_number": "४-५२-४१", "content_sanskrit": "धन्यो मान्योसि च सतां पूजनीयोसि सद्गुणैः ।\nदेवा अपि दिवोदास त्वत्त्रासान्न विमार्गगाः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004103041, "chapter_id": 24103, "verse_number": "४-५२-४२", "content_sanskrit": "किं नः स्तुत्या तव नृप द्विजानामस्पृहावताम् ।\nकिं कुर्मस्त्वद्गुणग्रामाः स्तावकान्नः प्रकुर्वते ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004103042, "chapter_id": 24103, "verse_number": "४-५२-४३", "content_sanskrit": "गोष्ठी तिष्ठत्वियं तावत्प्रस्तुतं स्तौमि सांप्रतम् ।\nयष्टुकामोस्म्यहं राजंस्त्वां सहायमतो वृणे ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004103043, "chapter_id": 24103, "verse_number": "४-५२-४४", "content_sanskrit": "त्वया राजन्वती चैषाऽवनिः सर्वर्धिभाजनम् ।\nअहं चास्तिधनो राजन्न्यायोपात्तमहाधनः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004103044, "chapter_id": 24103, "verse_number": "४-५२-४५", "content_sanskrit": "इयं च राजधानी ते कर्मभूमावनुत्तमा ।\nयस्यां कृतानां कार्याणां संवर्तेपि न संक्षयः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004103045, "chapter_id": 24103, "verse_number": "४-५२-४६", "content_sanskrit": "संचितं यद्धनं पुंभिर्नयसन्मार्गगामिभिः ।\nतत्काश्यां विनियुज्येत क्लेशायेतरथा भवेत् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004103046, "chapter_id": 24103, "verse_number": "४-५२-४७", "content_sanskrit": "महिमानं परं काश्याः कोपि वेद न भूपते ।\nऋते त्रिनयनाच्छंभोः सर्वज्ञानप्रदायिनः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004103047, "chapter_id": 24103, "verse_number": "४-५२-४८", "content_sanskrit": "मन्ये धन्यतरोसि त्वं बहुजन्मशतार्जितैः ।\nसुकृतैः पासि यत्काशीं विश्वभर्तुः परां तनुम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004103048, "chapter_id": 24103, "verse_number": "४-५२-४९", "content_sanskrit": "काशी त्रिजगतीसारस्त्रिवेदी सार एव वै ।\nत्रिवर्गोत्तरसारश्च निर्णीतेति महर्षिभिः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004103049, "chapter_id": 24103, "verse_number": "४-५२-५०", "content_sanskrit": "विश्वेशानुग्रहेणैव त्वयैषा पाल्यते पुरी ।\nएकस्याप्यवनात्काश्यां त्रैलोक्यमवितं भवेत् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004103050, "chapter_id": 24103, "verse_number": "४-५२-५१", "content_sanskrit": "अन्यच्च ते हितं वच्मि यदि ते रोचतेऽनघ ।\nप्रीणनीयः सदैवैको विश्वेशः सर्वकर्मभिः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004103051, "chapter_id": 24103, "verse_number": "४-५२-५२", "content_sanskrit": "अन्यदेवधिया राजन्विश्वेशं पश्य मा क्वचित् ।\nब्रह्मविष्ण्विंद्र चंद्रार्का क्रीडेयं तस्य धूर्जटेः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004103052, "chapter_id": 24103, "verse_number": "४-५२-५३", "content_sanskrit": "विप्रैरुदर्कमिच्छद्भिः शिक्षणीया यतो नृपाः ।\nअतस्तव हितं ख्यातं किं वा मे चिंतयानया ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004103053, "chapter_id": 24103, "verse_number": "४-५२-५४", "content_sanskrit": "इति जोषं स्थितं विप्रं प्रत्युवाच नृपोत्तमः ।\nसर्वं मया हृदि धृतं यत्त्वयोक्तं द्विजोत्तम ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004103054, "chapter_id": 24103, "verse_number": "४-५२-५५", "content_sanskrit": "राजोवाच ।\nअहं यियक्षमाणस्य तव साहाय्यकर्मणि ।\nदासोस्मि यज्ञसंभारान्नयमेको शतोऽखिलान् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004103055, "chapter_id": 24103, "verse_number": "४-५२-५६", "content_sanskrit": "यदस्ति मेखिलं तत्र सप्तांगेपि भवान्प्रभुः ।\nयजस्वैकमनाब्रह्मन्सिद्धं मन्यस्व वांछितम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004103056, "chapter_id": 24103, "verse_number": "४-५२-५७", "content_sanskrit": "राज्यं करोमि यद्ब्रह्मन्स्वार्थं तन्न मनागपि ।\nपुत्रैः कलत्रैर्देहेनपरोपकृतये यते ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004103057, "chapter_id": 24103, "verse_number": "४-५२-५८", "content_sanskrit": "राज्ञां क्रतुक्रियाभ्योपि तीर्थेभ्योपि समंततः ।\nप्रजापालनमेवैको धर्मः प्रोक्तो मनीषिभिः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004103058, "chapter_id": 24103, "verse_number": "४-५२-५९", "content_sanskrit": "प्रजासंतापजोवह्निर्वज्राग्नेरपि दारुणः ।\nद्वित्रान्दहति वज्राग्निः पूर्वो राज्यं कुलं तनुम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004103059, "chapter_id": 24103, "verse_number": "४-५२-६०", "content_sanskrit": "यदावभृथसिस्रासुर्भवेयं द्विजसत्तम ।\nतदा विप्रपदांभोभिरभिषेकं करोम्यहम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004103060, "chapter_id": 24103, "verse_number": "४-५२-६१", "content_sanskrit": "हवनं ब्राह्मणमुखे यत्करोमि द्विजोत्तम ।\nमन्ये क्रतुक्रियाभ्योपि तद्विशिष्टं महामते ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004103061, "chapter_id": 24103, "verse_number": "४-५२-६२", "content_sanskrit": "अभिलाषेषु सर्वेषु जागर्त्येको हृदीह मे ।\nअद्यापि मार्गणः कोपि द्रष्टव्यः स्वतनोरपि ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004103062, "chapter_id": 24103, "verse_number": "४-५२-६३", "content_sanskrit": "अहो अहोभिर्बहुभिः फलितो मे मनोरथः ।\nयत्त्वं मेद्य गृहे प्राप्तः किंचित्प्रार्थयितुं द्विज ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004103063, "chapter_id": 24103, "verse_number": "४-५२-६४", "content_sanskrit": "एकाग्रमानसो विप्र यज्ञान्विपुलदक्षिणान् ।\nबहून्यजकृतं विद्धि साहाय्यं सर्ववस्तुषु ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004103064, "chapter_id": 24103, "verse_number": "४-५२-६५", "content_sanskrit": "इति राज्ञो महाबुद्धेर्धर्मशीलस्य भाषितम् ।\nश्रुत्वा तुष्टमनाः स्रष्टा क्रतुसंभारमाहरत् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004103065, "chapter_id": 24103, "verse_number": "४-५२-६६", "content_sanskrit": "साहाय्यं प्राप्य राजर्षेर्दिवोदासस्य पद्मभूः ।\nइयाज दशभिः काश्यामश्वमेधैर्महामखैः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004103066, "chapter_id": 24103, "verse_number": "४-५२-६७", "content_sanskrit": "अद्यापि होमधूमोघैर्यद्व्याप्तं गगनांतरम् ।\nतदा प्रभृति न व्योम नीलिमानं जहात्यदः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004103067, "chapter_id": 24103, "verse_number": "४-५२-६८", "content_sanskrit": "तीर्थं दशाश्वमेधाख्यं प्रथितं जगतीतले ।\nतदा प्रभृति तत्रासीद्वाराणस्यां शुभप्रदम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004103068, "chapter_id": 24103, "verse_number": "४-५२-६९", "content_sanskrit": "पुरा रुद्रसरो नाम तत्तीर्थं कलशोद्भव ।\nदशाश्वमेधिकं पश्चाज्जातं विधिपरिग्रहात् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004103069, "chapter_id": 24103, "verse_number": "४-५२-७०", "content_sanskrit": "स्वर्धुन्यथ ततः प्राप्ता भगीरथसमागमात् ।\nअतीव पुण्यवज्जातमतस्तत्तीर्थमुत्तमम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004103070, "chapter_id": 24103, "verse_number": "४-५२-७१", "content_sanskrit": "विधिर्दशाश्वमेधेशं लिंगं संस्थाप्य तत्र वै ।\nस्थितवान्न गतोद्यापि क्वापि काशीं विहाय तु ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004103071, "chapter_id": 24103, "verse_number": "४-५२-७२", "content_sanskrit": "राज्ञो धर्मरतेस्तस्य च्छिद्रं नावाप किंचन ।\nअतः पुरारेः पुरतो व्रजित्वा किं वदेद्विधिः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004103072, "chapter_id": 24103, "verse_number": "४-५२-७३", "content_sanskrit": "क्षेत्रप्रभावं विज्ञाय ध्यायन्विश्वेश्वरं शिवम् ।\nब्रह्मेश्वरं च संस्थाप्य विधिस्तत्रैव संस्थितः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004103073, "chapter_id": 24103, "verse_number": "४-५२-७४", "content_sanskrit": "परातनुरियं काशी विश्वेशस्येति निश्चितम् ।\nअस्याः संसेवनाच्छंभुर्न कुप्यति पुरो मयि ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004103074, "chapter_id": 24103, "verse_number": "४-५२-७५", "content_sanskrit": "कः प्राप्य काशीं दुर्मेधाः पुनस्त्यक्तुमिहेह ते ।\nअनेकजन्मजनितकर्मनिर्मूलनक्षमाम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004103075, "chapter_id": 24103, "verse_number": "४-५२-७६", "content_sanskrit": "विश्वसंतापसंहर्तुः स्थाने विश्वपतेस्तनुः ।\nसंताप्यतेतरां काश्या विश्लेषज महाग्निना ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004103076, "chapter_id": 24103, "verse_number": "४-५२-७७", "content_sanskrit": "प्राप्य काशीं त्यजेद्यस्तु समस्ताघौघनाशिनीम् ।\nनृपशुः स परिज्ञेयो महासौख्यपराङमुखः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004103077, "chapter_id": 24103, "verse_number": "४-५२-७८", "content_sanskrit": "निर्वाणलक्ष्मीं यः कांक्षेत्त्यक्त्वा संसारदुर्गतिम् ।\nतेन काशी न संत्याज्या यद्याप्तैशादनुग्रहात् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004103078, "chapter_id": 24103, "verse_number": "४-५२-७९", "content_sanskrit": "यः काशीं संपरित्यज्य गच्छेदन्यत्र दुर्मतिः ।\nतस्य हस्ततलाद्गच्छेच्चतुर्वर्गफलोदयः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004103079, "chapter_id": 24103, "verse_number": "४-५२-८०", "content_sanskrit": "निबर्हणी मधौघस्य सुपुण्य परिबृंहिणीम् ।\nकः प्राप्य काशीं दुर्मेधास्त्यजेन्मोक्षसुखप्रदाम् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004103080, "chapter_id": 24103, "verse_number": "४-५२-८१", "content_sanskrit": "सत्यलोके क्व तत्सौख्यं क्व सौख्यं वैष्णवे पदे ।\nयत्सौख्यं लभ्यते काश्यां निमेषार्धनिषेवणात् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004103081, "chapter_id": 24103, "verse_number": "४-५२-८२", "content_sanskrit": "वाराणसीगुणगणान्निर्णीय द्रुहिणस्त्विति ।\nव्यावृत्य मंदरगिरिं न पुनः प्रत्यगान्मुने ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7004103082, "chapter_id": 24103, "verse_number": "४-५२-८३", "content_sanskrit": "स्कंद उवाच ।\nमित्रावरुणयोः पुत्र महिमानं ब्रवीमि ते ।\nकाश्यां दशाश्वमेधस्य सर्वतीर्थशिरोमणेः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7004103083, "chapter_id": 24103, "verse_number": "४-५२-८४", "content_sanskrit": "दशाश्वमेधिकं प्राप्य सर्वतीर्थोत्तमोत्तमम् ।\nयत्किंचित्क्रियते कर्म तदक्षयमिहेरितम् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7004103084, "chapter_id": 24103, "verse_number": "४-५२-८५", "content_sanskrit": "स्नानं दानं जपो होमः स्वाध्यायो दे वतार्चनम् ।\nसंध्योपास्तिस्तर्पणं च श्राद्धं पितृसमर्चनम् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7004103085, "chapter_id": 24103, "verse_number": "४-५२-८६", "content_sanskrit": "दशाश्वमेधिके तीर्थे सकृत्स्नात्वा नरोत्तमः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7004103086, "chapter_id": 24103, "verse_number": "४-५२-८७", "content_sanskrit": "दृष्ट्वा दशाश्वमेधेशं सर्वपापैः प्रमुच्यते ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7004103087, "chapter_id": 24103, "verse_number": "४-५२-८८", "content_sanskrit": "ज्येष्ठे मासि सिते पक्षे प्राप्य प्रतिपदं तिथिम् ।\nदशाश्वमेधिके स्नात्वा मुच्यते जन्मपातकैः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7004103088, "chapter_id": 24103, "verse_number": "४-५२-८९", "content_sanskrit": "ज्येष्ठे शुक्ल द्वितीयायां स्नात्वा रुद्रसरोवरे ।\nजन्मद्वयकृतं पापं तत्क्षणादेव नश्यति ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7004103089, "chapter_id": 24103, "verse_number": "४-५२-९०", "content_sanskrit": "एवं सर्वासु तिथिषु क्रमस्नायी नरोत्तमः ।\nआशुक्लपक्षदशमि प्रतिजन्माघमुत्सृजेत् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7004103090, "chapter_id": 24103, "verse_number": "४-५२-९१", "content_sanskrit": "तिथिं दशहरां प्राप्य दशजन्माघहारिणीम् ।\nदशाश्वमेधिके स्नातो यामीं पश्येन्न यातनाम् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7004103091, "chapter_id": 24103, "verse_number": "४-५२-९२", "content_sanskrit": "लिंगं दशाश्वमेधेशं दृष्ट्वा दशहरा तिथौ ।\nदशजन्मार्जितैः पापैस्त्यज्यते नात्र संशयः ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7004103092, "chapter_id": 24103, "verse_number": "४-५२-९३", "content_sanskrit": "स्नातो दशहरायां यः पूजयेल्लिंगमुत्तमम् ।\nभक्त्या दशाश्वमेधेशं न तं गर्भदशा स्पृशेत् ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7004103093, "chapter_id": 24103, "verse_number": "४-५२-९४", "content_sanskrit": "ज्येष्ठे मासि सिते पक्षे पक्षं रुद्रसरे नरः ।\nकुर्वन्वै वार्षिकीं यात्रां न विघ्नैरभिभूयते ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7004103094, "chapter_id": 24103, "verse_number": "४-५२-९५", "content_sanskrit": "दशाश्वमेधावभृथैर्यत्फलं सम्यगाप्यते ।\nदशाश्वमेधे तन्नूनं स्नात्वा दशहरा तिथौ ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7004103095, "chapter_id": 24103, "verse_number": "४-५२-९६", "content_sanskrit": "स्वर्धुन्याः पश्चिमे तीरे नत्वा दशहरेश्वरम् ।\nन दुर्दशामवाप्नोति पुमान्पुण्यतमः क्वचित् ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7004103096, "chapter_id": 24103, "verse_number": "४-५२-९७", "content_sanskrit": "यत्काश्यां दक्षिणद्वारमंतर्गेहस्य कीर्त्यते ।\nतत्र ब्रह्मेश्वरं दृष्ट्वा ब्रह्मलोके महीयते ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7004103097, "chapter_id": 24103, "verse_number": "४-५२-९८", "content_sanskrit": "इति ब्राह्मणवेषेण वाराणस्यां महाधिया ।\nद्रुहिणेन स्थितं तावद्यावद्विश्वेश्वरागमः ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7004103098, "chapter_id": 24103, "verse_number": "४-५२-९९", "content_sanskrit": "दिवोदासोपि राजेंद्रो वृद्धब्राह्मणरूपिणे ।\nब्रह्मणे कृतयज्ञाय ब्रह्मशालामकल्पयत् ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7004103099, "chapter_id": 24103, "verse_number": "४-५२-१००", "content_sanskrit": "ब्रह्मेश्वरसमीपे तु ब्रह्मशाला मनोहरा ।\nब्रह्मा तत्रावसद्व्योम ब्रह्मघोषैर्निनादयन् ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7004103100, "chapter_id": 24103, "verse_number": "४-५२-१०१", "content_sanskrit": "इति ते कथितो ब्रह्मन्महिमातिमहत्तरः ।\nदशाश्वमेधतीर्थस्य सर्वाघौघविनाशनः ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7004103101, "chapter_id": 24103, "verse_number": "४-५२-१०२", "content_sanskrit": "श्रुत्वाध्यायमिमं पुण्यं श्रावयित्वा तथैव च ।\nब्रह्मलोकमवाप्नोति श्रद्धया मानवोत्तमः ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7004103102, "chapter_id": 24103, "verse_number": "४-५२-१०३", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायामुत्तरार्द्धे चतुर्थे काशीखंडे दशाश्वमेधवर्णनंनाम द्विपंचाशत्तमोऽध्यायः ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}]