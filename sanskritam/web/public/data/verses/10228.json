[{"id": 6000228000, "chapter_id": 10228, "verse_number": null, "content_sanskrit": "अथ द्वात्रिंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000228001, "chapter_id": 10228, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_032/BhP_10.032.001.m4a", "display_order": 2}, {"id": 6000228002, "chapter_id": 10228, "verse_number": "१०-३२-१", "content_sanskrit": "एकदा देवयात्रायां गोपाला जातकौतुकाः।\nअनोभिरनडुद्युक्तैः प्रययुस्तेऽम्बिकावनम्॥ १०/३२/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_032/BhP_10.032.002.m4a", "display_order": 3, "topics": [{"text": "सर्पग्रस्तस्य नन्दस्य श्रीकृष्णेन मोचनम्", "range": "१–९"}]}, {"id": 6000228003, "chapter_id": 10228, "verse_number": "१०-३२-२", "content_sanskrit": "तत्र स्नात्वा सरस्वत्यां देवं पशुपतिं प्रभुम्।\nआनर्चुरर्हणैर्भक्त्या देवीं च नृपतेऽम्बिकाम्॥ १०/३२/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_032/BhP_10.032.003.m4a", "display_order": 4}, {"id": 6000228004, "chapter_id": 10228, "verse_number": "१०-३२-३", "content_sanskrit": "गावो हिरण्यं वासांसि मधु मध्वन्नमादृताः।\nब्राह्मणेभ्यो ददुः सर्वे देवो नः प्रीयतामिति॥ १०/३२/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_032/BhP_10.032.004.m4a", "display_order": 5}, {"id": 6000228005, "chapter_id": 10228, "verse_number": "१०-३२-४", "content_sanskrit": "ऊषुः सरस्वतीतीरे जलं प्राश्य यतव्रताः।\nरजनीं तां महाभाग नन्दसन्नन्दकादयः॥ १०/३२/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_032/BhP_10.032.005.m4a", "display_order": 6}, {"id": 6000228006, "chapter_id": 10228, "verse_number": "१०-३२-५", "content_sanskrit": "कश्चिन्महानहिस्तस्मिन् विपिनेऽतिबुभुक्षितः।\nयदृच्छयाऽऽगतो नन्दं शयानमुरगोऽग्रसीत्॥ १०/३२/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_032/BhP_10.032.006.m4a", "display_order": 7}, {"id": 6000228007, "chapter_id": 10228, "verse_number": "१०-३२-६", "content_sanskrit": "स चुक्रोशाहिना ग्रस्तः कृष्ण कृष्ण महानयम्।\nसर्पो मां ग्रसते तात प्रपन्नं परिमोचय॥ १०/३२/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_032/BhP_10.032.007.m4a", "display_order": 8}, {"id": 6000228008, "chapter_id": 10228, "verse_number": "१०-३२-७", "content_sanskrit": "तस्य चाक्रन्दितं श्रुत्वा गोपालाः सहसोत्थिताः।\nग्रस्तं च दृष्ट्वा सम्भ्रान्ताः सर्पं विव्यधुरुल्मुकैः॥ १०/३२/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_032/BhP_10.032.008.m4a", "display_order": 9}, {"id": 6000228009, "chapter_id": 10228, "verse_number": "१०-३२-८", "content_sanskrit": "अलातैर्हन्यमानोऽपि नामुञ्चत् तमुरङ्गमः।\nतमस्पृशत् पदाऽभ्येत्य भगवान् सात्वतां पतिः॥ १०/३२/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_032/BhP_10.032.009.m4a", "display_order": 10}, {"id": 6000228010, "chapter_id": 10228, "verse_number": "१०-३२-९", "content_sanskrit": "स वै भगवतः श्रीमत्पादस्पर्शहताशुभः।\nभेजे सर्पवपुर्हित्वा रूपं विद्याधरार्चितम्॥ १०/३२/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_032/BhP_10.032.010.m4a", "display_order": 11}, {"id": 6000228011, "chapter_id": 10228, "verse_number": "१०-३२-१०", "content_sanskrit": "तमपृच्छद् हृषीकेशः प्रणतं समुपस्थितम्।\nदीप्यमानेन वपुषा पुरुषं हेममालिनम्॥ १०/३२/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_032/BhP_10.032.011.m4a", "display_order": 12, "topics": [{"text": "अङ्गिरसाम् ऋषीणां शापात्सर्पजन्म प्राप्तस्य सुदर्शननामकविद्याधरस्य श्रीकृष्णेन स्वपादस्पर्शेन तज्जन्मनो मोक्षणम्", "range": "१०–१९"}]}, {"id": 6000228012, "chapter_id": 10228, "verse_number": "१०-३२-११", "content_sanskrit": "को भवान् परया लक्ष्म्या रोचतेऽद्भुतदर्शनः।\nकथं जुगुप्सितामेतां गतिं वा प्रापितोऽवशः॥ १०/३२/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_032/BhP_10.032.012.m4a", "display_order": 13}, {"id": 6000228013, "chapter_id": 10228, "verse_number": null, "content_sanskrit": "सर्प उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_032/BhP_10.032.013.m4a", "display_order": 14}, {"id": 6000228014, "chapter_id": 10228, "verse_number": "१०-३२-१२", "content_sanskrit": "अहं विद्याधरः कश्चित् सुदर्शन इति श्रुतः।\nश्रिया स्वरूपसम्पत्त्या विमानेनाचरन् दिशः॥ १०/३२/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_032/BhP_10.032.014.m4a", "display_order": 15}, {"id": 6000228015, "chapter_id": 10228, "verse_number": "१०-३२-१३", "content_sanskrit": "ऋषीन् विरूपानङ्गिरसः प्राहसं रूपदर्पितः।\nतैरिमां प्रापितो योनिं प्रलब्धः स्वेन पाप्मना॥ १०/३२/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_032/BhP_10.032.015.m4a", "display_order": 16}, {"id": 6000228016, "chapter_id": 10228, "verse_number": "१०-३२-१४", "content_sanskrit": "शापो मेऽनुग्रहायैव कृतस्तैः करुणात्मभिः।\nयदहं लोकगुरुणा पादस्पृष्टो हताशुभः॥ १०/३२/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_032/BhP_10.032.016.m4a", "display_order": 17}, {"id": 6000228017, "chapter_id": 10228, "verse_number": "१०-३२-१५", "content_sanskrit": "तं त्वाऽहं भवभीतानां प्रपन्नानां भयापहम्।\nआपृच्छे शापनिर्मुक्तः पादस्पर्शादमीवहन्॥ १०/३२/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_032/BhP_10.032.017.m4a", "display_order": 18}, {"id": 6000228018, "chapter_id": 10228, "verse_number": "१०-३२-१६", "content_sanskrit": "प्रपन्नोऽस्मि महायोगिन् महापुरुष सत्पते।\nअनुजानीहि मां कृष्ण सर्वलोकेश्वरेश्वर॥ १०/३२/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_032/BhP_10.032.018.m4a", "display_order": 19}, {"id": 6000228019, "chapter_id": 10228, "verse_number": "१०-३२-१७", "content_sanskrit": "ब्रह्मदण्डाद् विमुक्तोऽहं सद्यस्तेऽच्युत दर्शनात्। यन्नाम गृह्णन्नखिलान् श्रोतॄनात्मानमेव च।\nसद्यः पुनाति किं भूयस्तस्य स्पृष्टः पदा हि ते॥ १०/३२/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_032/BhP_10.032.019.m4a", "display_order": 20}, {"id": 6000228020, "chapter_id": 10228, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_032/BhP_10.032.020.m4a", "display_order": 21}, {"id": 6000228021, "chapter_id": 10228, "verse_number": "१०-३२-१८", "content_sanskrit": "इत्यनुज्ञाप्य दाशार्हं परिक्रम्याभिवाद्य च।\nसुदर्शनो दिवं यातः कृच्छ्रान्नन्दश्च मोचितः॥ १०/३२/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_032/BhP_10.032.021.m4a", "display_order": 22}, {"id": 6000228022, "chapter_id": 10228, "verse_number": "१०-३२-१९", "content_sanskrit": "निशाम्य कृष्णस्य तदात्मवैभवं व्रजौकसो विस्मितचेतसस्ततः।\nसमाप्य तस्मिन् नियमं पुनर्व्रजं नृपाययुस्तत् कथयन्त आदृताः॥ १०/३२/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_032/BhP_10.032.022.m4a", "display_order": 23}, {"id": 6000228023, "chapter_id": 10228, "verse_number": "१०-३२-२०", "content_sanskrit": "कदाचिदथ गोविन्दो रामश्चाद्भुतविक्रमः।\nविजह्रतुर्वने रात्र्यां मध्यगौ व्रजयोषिताम्॥ १०/३२/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_032/BhP_10.032.023.m4a", "display_order": 24, "topics": [{"text": "कस्याञ्चित् रात्र्यां गोपीभिः समं वने विहरतो रामकृष्णयोः शङ्खचूडनाम्ना गुह्यकेन स्त्रीणां भयोत्पादने कृष्णेन तस्य शिरःकर्तनम्", "range": "२०–३१"}]}, {"id": 6000228024, "chapter_id": 10228, "verse_number": "१०-३२-२१", "content_sanskrit": "उपगीयमानौ ललितं स्‍त्रीजनैर्बद्धसौहृदैः।\nस्वलङ्कृतानुलिप्ताङ्गौ स्‍त्रग्विणौ विरजाम्बरौ॥ १०/३२/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_032/BhP_10.032.024.m4a", "display_order": 25}, {"id": 6000228025, "chapter_id": 10228, "verse_number": "१०-३२-२२", "content_sanskrit": "निशामुखं मानयन्तावुदितोडुपतारकम्।\nमल्लिकागन्धमत्तालिजुष्टं कुमुदवायुना॥ १०/३२/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_032/BhP_10.032.025.m4a", "display_order": 26}, {"id": 6000228026, "chapter_id": 10228, "verse_number": "१०-३२-२३", "content_sanskrit": "जगतुः सर्वभूतानां मनःश्रवणमङ्गलम्।\nतौ कल्पयन्तौ युगपत् स्वरमण्डलमूर्च्छनाम्॥ १०/३२/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_032/BhP_10.032.026.m4a", "display_order": 27}, {"id": 6000228027, "chapter_id": 10228, "verse_number": "१०-३२-२४", "content_sanskrit": "गोप्यस्तद्गीतमाकर्ण्य मूर्च्छिता नाविदन् नृप।\nश्लथद्दुकूलमात्मानं स्रस्तकेशस्रजं ततः॥ १०/३२/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_032/BhP_10.032.027.m4a", "display_order": 28}, {"id": 6000228028, "chapter_id": 10228, "verse_number": "१०-३२-२५", "content_sanskrit": "एवं विक्रीडतोः स्वैरं गायतोः सम्प्रमत्तवत्।\nशङ्खचूड इति ख्यातो धनदानुचरोऽभ्यगात्॥ १०/३२/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_032/BhP_10.032.028.m4a", "display_order": 29}, {"id": 6000228029, "chapter_id": 10228, "verse_number": "१०-३२-२६", "content_sanskrit": "तयोर्निरीक्षतोरेव तन्नाथं प्रमदाजनम्।\nक्रोशन्तं कालयामास दिश्युदीच्यामशङ्कितः॥ १०/३२/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_032/BhP_10.032.029.m4a", "display_order": 30}, {"id": 6000228030, "chapter_id": 10228, "verse_number": "१०-३२-२७", "content_sanskrit": "क्रोशन्तं कृष्ण रामेति विलोक्य स्वपरिग्रहम्।\nयथा गा दस्युना ग्रस्ता भ्रातरावन्वधावताम्॥ १०/३२/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_032/BhP_10.032.030.m4a", "display_order": 31}, {"id": 6000228031, "chapter_id": 10228, "verse_number": "१०-३२-२८", "content_sanskrit": "मा भैष्टेत्यभयारावौ तालहस्तौ मनस्विनौ।\nआसेदतुस्तं तरसा त्वरितं गुह्यकाधमम्॥ १०/३२/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_032/BhP_10.032.031.m4a", "display_order": 32}, {"id": 6000228032, "chapter_id": 10228, "verse_number": "१०-३२-२९", "content_sanskrit": "स वीक्ष्य तावनुप्राप्तौ कालमृत्यू इवोद्विजन्।\nविसृज्य स्‍त्रीजनं मूढः प्राद्रवज्जीवनेच्छया॥ १०/३२/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_032/BhP_10.032.032.m4a", "display_order": 33}, {"id": 6000228033, "chapter_id": 10228, "verse_number": "१०-३२-३०", "content_sanskrit": "तमन्वधावद् गोविन्दो यत्र यत्र स धावति।\nजिहीर्षुस्तच्छिरोरत्नं तस्थौ रक्षन् स्‍त्रियो बलः॥ १०/३२/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_032/BhP_10.032.033.m4a", "display_order": 34}, {"id": 6000228034, "chapter_id": 10228, "verse_number": "१०-३२-३१", "content_sanskrit": "अविदूर इवाभ्येत्य शिरस्तस्य दुरात्मनः।\nजहार मुष्टिनैवाङ्ग सहचूडामणिं विभुः॥ १०/३२/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_032/BhP_10.032.034.m4a", "display_order": 35}, {"id": 6000228035, "chapter_id": 10228, "verse_number": "१०-३२-३२", "content_sanskrit": "शङ्खचूडं निहत्यैवं मणिमादाय भासुरम्।\nअग्रजायाददात् प्रीत्या पश्यन्तीनां च योषिताम्॥ १०/३२/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_032/BhP_10.032.035.m4a", "display_order": 36}, {"id": 6000228036, "chapter_id": 10228, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्धपूर्वार्धे द्वात्रिंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]