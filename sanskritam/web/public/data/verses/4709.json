[{"id": 2174812, "chapter_id": 4709, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2174813, "chapter_id": 4709, "verse_number": "१", "content_sanskrit": "यत्नं चाप्यकरोद् राजन् मोक्षार्थं तस्य यक्ष्मणः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2174814, "chapter_id": 4709, "verse_number": "२", "content_sanskrit": "इष्ट्वेष्टिभिर्महाराज विचित्राभिर्निशाकरः ।\nन चामुच्यत शापाद्वै क्षयं चैवाधिगच्छति\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2174815, "chapter_id": 4709, "verse_number": "३", "content_sanskrit": "क्षीयमाणे ततः सोमे ओषध्यो न प्रजज्ञिरे ।\nनिरास्वादरसाः सर्वा हीनवीर्याश्च सर्वशः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2174816, "chapter_id": 4709, "verse_number": "४", "content_sanskrit": "ओषधीनां क्षये जाते प्राणिनामपि सङ्क्षयः ।\nकृशाश्चासन् प्रजाः सर्वाः क्षीयमाणे निशाकरे\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2174817, "chapter_id": 4709, "verse_number": "५", "content_sanskrit": "ततो देवाः समागम्य सोममूचुर्नराधिप\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2174818, "chapter_id": 4709, "verse_number": "", "content_sanskrit": "देवाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2174819, "chapter_id": 4709, "verse_number": "६", "content_sanskrit": "किमिदं भवतो रूपमीदृशं सम्प्रकाशते ।\nकारणं ब्रूहि नः सर्वं येनेदं ते महद्भयम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2174820, "chapter_id": 4709, "verse_number": "७", "content_sanskrit": "श्रुत्वा तु कारणं त्वत्तो विधास्यामस्ततो वयम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2174821, "chapter_id": 4709, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2174822, "chapter_id": 4709, "verse_number": "८", "content_sanskrit": "एवमुक्तः प्रत्युवाच सर्वांस्तान् शशलक्षणः ।\nशापस्य कारणं चैव यक्ष्माणं च तथाऽऽत्मनः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2174823, "chapter_id": 4709, "verse_number": "९", "content_sanskrit": "देवास्तस्य वचः श्रुत्वा गत्वा दक्षमथाब्रुवन्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2174824, "chapter_id": 4709, "verse_number": "", "content_sanskrit": "देवाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2174825, "chapter_id": 4709, "verse_number": "१०", "content_sanskrit": "प्रसीदतु भवान् सोमे शापोऽयं विनिवर्त्यताम् ।\nअसौ हि चन्द्रमा क्षीणः किञ्चिच्छेषश्च लक्ष्यते\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2174826, "chapter_id": 4709, "verse_number": "११", "content_sanskrit": "क्षयं व्रजति शीतांशौ तत्प्रजा आगताः क्षयम् ।\nवीरुदोषधयश्चैव बीजानि विविधानि च\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2174827, "chapter_id": 4709, "verse_number": "१२", "content_sanskrit": "तेषां क्षये क्षयोऽस्माकमितास्माभिः जगच्च किम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2174828, "chapter_id": 4709, "verse_number": "समाप्तिः", "content_sanskrit": "इति ज्ञात्वा लोकगुरो प्रसादं कर्तुमर्हसि\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2174829, "chapter_id": 4709, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2174830, "chapter_id": 4709, "verse_number": "१४", "content_sanskrit": "एवमुक्तस्तु सञ्चिन्त्य प्राह वाक्यं प्रजापतिः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2174831, "chapter_id": 4709, "verse_number": "", "content_sanskrit": "दक्षः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2174832, "chapter_id": 4709, "verse_number": "१५", "content_sanskrit": "नैतच्छक्यं मम वचो व्यावर्तयितुमञ्जसा ।\nहेतुना तु महाभागा निवर्तिष्यति केनचित्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2174833, "chapter_id": 4709, "verse_number": "१६", "content_sanskrit": "समं वर्तेत सर्वासु शशी भार्यासु सर्वशः ।\nअस्मिंस्तीर्थवरे चापि निमज्जेच्छशलक्षणः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2174834, "chapter_id": 4709, "verse_number": "१७", "content_sanskrit": "पुनर्वर्धिष्यते देवाः तद्धि सत्यं वचो मम ।\nमासार्धं च क्षयं सोमो नित्यमेव गमिष्यति\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2174835, "chapter_id": 4709, "verse_number": "१८", "content_sanskrit": "मासार्धं च पुनर्वृद्धिं सत्यमेव ब्रवीमि वः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2174836, "chapter_id": 4709, "verse_number": "१९", "content_sanskrit": "तीर्थयात्रां ततः सोमो जगाम ऋषिशासनात् ।\nप्रभासं परमं तीर्थं सरस्वत्यां जगाम ह\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2174837, "chapter_id": 4709, "verse_number": "२०", "content_sanskrit": "अमावास्यां महातेजाः तत्र मज्जन् महाद्युतिः ।\nलोकान् प्रभासयामास शीतांशुत्वमवाप च\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2174838, "chapter_id": 4709, "verse_number": "२१", "content_sanskrit": "देवाश्च सर्वे राजेन्द्र प्रसादं प्राप्य पुष्कलम् ।\nसोमेन सहिता भूत्वा दक्षस्य प्रमुखे स्थिताः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2174839, "chapter_id": 4709, "verse_number": "२२", "content_sanskrit": "ततः प्रजापतिर्देवो विससर्जाथ देवताः ।\nसोमं च भगवान् भूयः प्रीतो वचनमब्रवीत्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2174840, "chapter_id": 4709, "verse_number": "", "content_sanskrit": "दक्षः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2174841, "chapter_id": 4709, "verse_number": "२३", "content_sanskrit": "माऽवमंस्थाः स्त्रियः पुत्र मा च विप्रान् कदाचन ।\nगच्छ युक्तः सदा भूत्वा कुरु त्वं शासनं मम\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2174842, "chapter_id": 4709, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2174843, "chapter_id": 4709, "verse_number": "२४", "content_sanskrit": "स विसृष्टो महातेजा जगामाथ स्वमालयम् ।\nप्रजाश्च मुदिता भूत्वा ईजिरे च यथापुरम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2174844, "chapter_id": 4709, "verse_number": "२५", "content_sanskrit": "एवं ते सर्वमाख्यातं यथा शप्तो निशाकरः ।\nप्रभासं च यथा तीर्थं तीर्थानां प्रवरं ह्यभूत्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2174845, "chapter_id": 4709, "verse_number": "२६", "content_sanskrit": "अमावास्यां महाराज स नित्यं शशलक्षणः ।\nस्नात्वा ह्याप्यायते श्रीमान् प्रभासे तीर्थसत्तमे\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2174846, "chapter_id": 4709, "verse_number": "२७", "content_sanskrit": "अतश्चैनं प्रजानन्ति प्रभासमिति भूमिप ।\nप्रभां हि परमां लेभे तस्मिन्नामज्य चन्द्रमाः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2174847, "chapter_id": 4709, "verse_number": "", "content_sanskrit": "(लोकान् प्रभासयामास पुपोष च वपुस्तदा ।\nतत्र स्नात्वा हली रामो दत्वा प्रीतोऽथ दक्षिणाः\t॥२८॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2174848, "chapter_id": 4709, "verse_number": "२९", "content_sanskrit": "ततस्तु चमसोद्भेदमभीतस्त्वगमद् बली ।\nचमसोद्भेद इत्येव यं जनोऽकथयद् भुवि\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2174849, "chapter_id": 4709, "verse_number": "३०", "content_sanskrit": "तत्र दत्त्वा च दानानि विशिष्टानि हलायुधः ।\nउषित्वा रजनीमेकां स्नात्वा च विधिवत् तदा\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2174850, "chapter_id": 4709, "verse_number": "३१", "content_sanskrit": "उदपानमथागच्छत् त्वरावान् केशवाग्रजः ।\nआद्यं स्वस्त्ययनं चैव तत्रावाप्य महत्फलम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2174851, "chapter_id": 4709, "verse_number": "३२", "content_sanskrit": "स्निग्धानि तत्र वस्तूनि द्विजेभ्यश्च तदा ददौ ।\nतत्र दत्वा च दानानि वासांसि च सहस्रशः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2174852, "chapter_id": 4709, "verse_number": "३३", "content_sanskrit": "गवां तथा सहस्राणि हेमशृङ्गवतां पुनः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2174853, "chapter_id": 4709, "verse_number": "३४", "content_sanskrit": "हयांश्च नानाविधदेशजातान्\nअन्यानि दानानि तदा द्विजेभ्यः ।\nरत्नानि मुक्तामणि विद्रुमांश्च\nशृङ्गीसुवर्णं रजतञ्च शुद्धम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2174854, "chapter_id": 4709, "verse_number": "३५", "content_sanskrit": "अयस्मयं ताम्रमयञ्च भाण्डं\nददौ द्विजातिप्रवरेषु रामः ।\nएवं स वित्तं प्रददौ महात्मा ।\nसमस्ततीर्थप्रवरेषु भूरि\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2174855, "chapter_id": 4709, "verse_number": "३६", "content_sanskrit": "ययौ क्रमेण च पुनः कुरुक्षेत्रं मुदा युतः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2174856, "chapter_id": 4709, "verse_number": "३७", "content_sanskrit": "स्निग्धत्वादोषधीनां च भूमेश्च जनमेजय\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2174857, "chapter_id": 4709, "verse_number": "३८", "content_sanskrit": "जानन्ति सिद्धा मुनयो निगूढां तां सरस्वतीम्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2174858, "chapter_id": 4709, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां गदापर्वणि सप्तमोऽध्यायः ॥७॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]