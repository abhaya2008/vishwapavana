[{"id": 2110902, "chapter_id": 3398, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2110903, "chapter_id": 3398, "verse_number": "१", "content_sanskrit": "सर्वाणि कर्माणि विसृज्य राजन्\nगृहान् परित्यज्य वनं गतोऽसि ।\nतत् त्वां पृच्छामि नहुषस्य पुत्र\nकेनासि तुल्यस्तपसा ययाते\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2110904, "chapter_id": 3398, "verse_number": "", "content_sanskrit": "ययातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2110905, "chapter_id": 3398, "verse_number": "२", "content_sanskrit": "नाहं देवमनुष्येषु न गन्धर्वमहर्षिपु ।\nआत्मनस्तपसा तुल्यं कञ्चित् पश्यामि वासव\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2110906, "chapter_id": 3398, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2110907, "chapter_id": 3398, "verse_number": "३", "content_sanskrit": "यदाऽवमंस्थाः सदृशाञ्छ्रेयसश्च\nवरीयसश्चाप्यमितप्रभावान् ।\nतस्माल्लोका अन्तवन्तस्तवेमे\nक्षीणे पुण्ये पतितोऽस्यद्य राजन् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2110908, "chapter_id": 3398, "verse_number": "", "content_sanskrit": "ययातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2110909, "chapter_id": 3398, "verse_number": "४", "content_sanskrit": "सुरर्षिगन्धर्वनरावमानात्\nक्षयं गता मे यदि शक्र लोकाः ।\nइच्छेयं वै सुरलोकाद् विहीनः\nसतां सकाशे पतितुं देवराज\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2110910, "chapter_id": 3398, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2110911, "chapter_id": 3398, "verse_number": "५", "content_sanskrit": "सतां सकाशे पतितोऽसि राजन्\nच्युतः प्रतिष्ठां यत्र लब्धाऽसि भूयः ।\nएवं विदित्वा नाहुष मा स्म सर्वान्\nन चावमंस्थाः सदृशान् श्रेयसश्च\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2110912, "chapter_id": 3398, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2110913, "chapter_id": 3398, "verse_number": "६", "content_sanskrit": "ततः प्रहायामरराजजुष्टान्\nपुण्याँल्लोकान् पतमानं ययातिम् ।\nसम्प्रेक्ष्य राजर्षिवरोऽष्टकस्तं\nउवाच सद्धर्मविधानगोप्ता\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2110914, "chapter_id": 3398, "verse_number": "", "content_sanskrit": "अष्टकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2110915, "chapter_id": 3398, "verse_number": "७", "content_sanskrit": "कस्त्वं युवा वासवतुल्यरूपः\nस्वेतजसा दीप्यमानो यथाऽग्निः ।\nपतस्युदीर्णाम्बुधरप्रकारः\nखात् खेचराणां प्रवरो यथाऽर्कः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2110916, "chapter_id": 3398, "verse_number": "८", "content_sanskrit": "दृष्ट्वा च त्वां सूर्यपथात् पतन्तं\nवैश्वानरार्कद्युतिमप्रमेयम् ।\nकिं नु स्विदेतत् पततीति सर्वे\nवितर्कयन्तः परिमोहिताः स्मः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2110917, "chapter_id": 3398, "verse_number": "९", "content_sanskrit": "दृष्ट्वा च त्वां विष्ठितं देवमार्गे\nशक्रार्कविष्णुप्रतिमप्रभावम् ।\nअभ्युद्गतास्त्वां वयमद्य सर्वे\nतत्वं पाते तव जिज्ञासमानाः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2110918, "chapter_id": 3398, "verse_number": "१०", "content_sanskrit": "न चापि त्वां धृष्णुमप्रष्टुमग्रे\nन च त्वमस्मानत पृच्छसे ये वयं स्मः ।\nते त्वां पृच्छामः कमनीयरूप\nकस्य त्वं वा किन्निमित्तं त्विहागाः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2110919, "chapter_id": 3398, "verse_number": "", "content_sanskrit": "भयं तु ते व्येतु विषादमोहौ त्यजाशु देवेन्द्रसमानरूप ।\nत्वां वर्तमानं हि सतां सकाशे नालं प्रसोढुं बलहाऽपि शक्रः\t॥११", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2110920, "chapter_id": 3398, "verse_number": "१२", "content_sanskrit": "सन्तः प्रतिष्ठा हि सुखाच्च्युतानां \tसतां सदैवामरराजकल्प ।\nते सङ्गताः स्थावरजङ्गमेशाः प्रतिष्ठितास्ते सदृशेषु सत्सु\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2110921, "chapter_id": 3398, "verse_number": "१३", "content_sanskrit": "प्रभुरग्निः प्रतपने भूमिरावपने प्रभुः ।\nप्रभुः सूर्यः प्रकाशित्वे सतामभ्यागतः प्रभुः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2110922, "chapter_id": 3398, "verse_number": "२५", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि सप्तसप्ततितमोऽध्यायः ॥७७॥ ॥ सम्भवपर्वणि पञ्चविंशोऽध्यायः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]