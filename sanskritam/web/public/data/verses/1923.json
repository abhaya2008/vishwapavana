[{"id": 2041568, "chapter_id": 1923, "verse_number": "५-१६८-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2041569, "chapter_id": 1923, "verse_number": "५-१६८-१", "content_sanskrit": "अचलो वृषकश्चैव सहितौ भ्रातरावुभौ ।\nरथौ तव दुराधर्षौ शत्रून्विध्वंसयिष्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2041570, "chapter_id": 1923, "verse_number": "५-१६८-२", "content_sanskrit": "बलवन्तौ नरव्याघ्रौ दृढक्रोधौ प्रहारिणौ।\nगान्धारमुख्यौ तरुणौ दर्शनीयौ महाबलौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2041571, "chapter_id": 1923, "verse_number": "५-१६८-३", "content_sanskrit": "सखा ते दयितो नित्यं य एष रणकर्कशः ।\nउत्साहयति राजंस्त्वां विग्रहे पाण्डवैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2041572, "chapter_id": 1923, "verse_number": "५-१६८-४", "content_sanskrit": "परुषः कत्थनो नीचः कर्णो वैकर्तनस्त्रव ।\nमन्त्री नेता च बन्धुश्च मानी चात्यन्तमुच्छ्रितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2041573, "chapter_id": 1923, "verse_number": "५-१६८-५", "content_sanskrit": "एष नैव रथः पूर्णो न चाप्यतिरथो रणे ।\nवियुक्तः कवचेनैष सहजेन विचेतनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2041574, "chapter_id": 1923, "verse_number": "५-१६८-६", "content_sanskrit": "कुण्डलाभ्यां च दिव्याभ्यां वियुक्तः सततं घृणी ।\nअभिशापाच्च रामस्य ब्राह्मणस्य च भाषणात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2041575, "chapter_id": 1923, "verse_number": "५-१६८-७", "content_sanskrit": "करणानां वियोगाच्च तेन मेऽर्थरथो मतः।\nनैष फाल्गुनमासाद्य पुनर्जीवन्विमोक्ष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2041576, "chapter_id": 1923, "verse_number": "५-१६८-८", "content_sanskrit": "ततोऽब्रवीत्पुनर्द्रोणः सर्वशस्त्रभृतां वरः।\nएवमेतद्यथाऽऽत्थ त्वं न मिथ्यास्ति कदाचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2041577, "chapter_id": 1923, "verse_number": "५-१६८-९", "content_sanskrit": "रणेरणेऽभिमानी च विमुखश्चापि दृश्यते।\nघृणी कर्णः प्रमादी च तेन मेऽर्धरथो मतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2041578, "chapter_id": 1923, "verse_number": "५-१६८-१०x", "content_sanskrit": "संजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2041579, "chapter_id": 1923, "verse_number": "५-१६८-१०", "content_sanskrit": "एतच्छ्रुत्वा तु राधेयः क्रोधादुल्फाल्य लोचने ।\nउवाच भीष्मं राधेयस्तुदन्वाग्भिः प्रतोदवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2041580, "chapter_id": 1923, "verse_number": "५-१६८-११", "content_sanskrit": "पितामह यथेष्टं मां वाक्शरैरुपकृन्तसि ।\nअनागसं सदा द्वेषादेवमेव पदेपदे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2041581, "chapter_id": 1923, "verse_number": "५-१६८-१२", "content_sanskrit": "मर्षयामि च तत्सर्वं दुर्योधनकृतेन वै ।\nत्वं तुं मां मान्यसे मन्दं यथा कापुरुषं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2041582, "chapter_id": 1923, "verse_number": "५-१६८-१३", "content_sanskrit": "भवानर्धरथो मह्यं मतो वै नात्र संशयः ।\nसर्वस्य जगतश्चैव गाङ्गेयो न मृषा वदेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2041583, "chapter_id": 1923, "verse_number": "५-१६८-१४", "content_sanskrit": "कुरूणामहितो नित्यं न च राजाऽवबुध्यते ।\nको हि नाम समानेषु राजसूदारकर्मसु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2041584, "chapter_id": 1923, "verse_number": "५-१६८-१५", "content_sanskrit": "तेजोवधमिमं कुर्याद्विभेदयिषुराहवे ।\nयथा त्वं गुणविद्वेषादपरागं चिकीर्षसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2041585, "chapter_id": 1923, "verse_number": "५-१६८-१६", "content_sanskrit": "न हायनैर्न पलितैर्न वित्तैर्न च बन्धुभिः ।\nमहारयत्वं संख्यातुं शक्यं क्षत्रस्य कौरव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2041586, "chapter_id": 1923, "verse_number": "५-१६८-१७", "content_sanskrit": "बलज्येष्ठं स्मृतं क्षत्रं मन्त्रज्येष्ठा द्विजातयः ।\nधनज्येष्ठाः स्मृता वैश्याः शूद्रास्तु वयसाऽधिकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2041587, "chapter_id": 1923, "verse_number": "५-१६८-१८", "content_sanskrit": "यथेच्छकं स्वयं ब्रूया रथानतिरथांस्तथा।\nकामद्वेषसमायुक्तो मोहात्प्रकुरुते भवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2041588, "chapter_id": 1923, "verse_number": "५-१६८-१९", "content_sanskrit": "दुर्योधन महाबाहो साधु सम्यगवेक्ष्यताम्।\nत्यज्यतां दुष्टभावोऽयं भीष्मः किल्बिषकृत्तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2041589, "chapter_id": 1923, "verse_number": "५-१६८-२०", "content_sanskrit": "भिन्ना हि सेना नृपते दुःसन्धेया भवत्युत।\nमौला हि पुरुषव्याघ्र किमु नानासमुत्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2041590, "chapter_id": 1923, "verse_number": "५-१६८-२१", "content_sanskrit": "एषां द्वैधं समुत्पन्नं योधानां युधि भारत।\nतेजोवधो नः क्रियते प्रत्यक्षेण विशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2041591, "chapter_id": 1923, "verse_number": "५-१६८-२२", "content_sanskrit": "रथानां क्वच विज्ञानं क्वच भीष्मोऽल्पचेतनः ।\nअहमावारयिष्यामि पाण्डवानामनीकिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2041592, "chapter_id": 1923, "verse_number": "५-१६८-२३", "content_sanskrit": "आसाद्य माममोघेषुं गमिष्यन्ति दिशो दश।\nपाण्डवाः सहपञ्चालाः शार्दूलं वृषभा इव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2041593, "chapter_id": 1923, "verse_number": "५-१६८-२४", "content_sanskrit": "क्वच युद्धं विमर्दो वा मन्त्रे सुव्याहृतानि च।\nक्वचभीष्मो गतवयामन्दात्मा कालचोदितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2041594, "chapter_id": 1923, "verse_number": "५-१६८-२५", "content_sanskrit": "एकाकी स्पर्धति नित्यं सर्वेण रमता सह ।\nन चान्यं पुरुषं कंचिन्मन्यते मोघदर्शनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2041595, "chapter_id": 1923, "verse_number": "५-१६८-२६", "content_sanskrit": "श्रोतव्यं खलु वृद्धानमिति शास्त्रनिदर्शनम् ।\nन त्वेव ह्यतिवृद्धानां पुनर्बालाहि ते मताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2041596, "chapter_id": 1923, "verse_number": "५-१६८-२७", "content_sanskrit": "अहमेको हनिष्यामि पाण्डवानानीकिनीम् ।\nसुयुद्धे राज्यशार्दूल यशो भीष्मं गमिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2041597, "chapter_id": 1923, "verse_number": "५-१६८-२८", "content_sanskrit": "कृतः सेनापतिस्त्वेष त्वया भीष्मो नराधिप।\nसेनापतौ यशो गन्ता न तु योधान्कथञ्चन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2041598, "chapter_id": 1923, "verse_number": "५-१६८-२९", "content_sanskrit": "नाहं जीवति गाङ्गेये योत्स्ये राजन्कथञ्चन।\nहते भीष्मे तु योद्धाऽस्मि सर्वैरेव महारथैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2041599, "chapter_id": 1923, "verse_number": "५-१६८-३०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2041600, "chapter_id": 1923, "verse_number": "५-१६८-३०", "content_sanskrit": "समुद्यतोयं भारो मे सुमहान्सागरोपमः।\nधार्तराष्ट्रस्य संग्रामे वर्षपूगाभिचिन्तितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2041601, "chapter_id": 1923, "verse_number": "५-१६८-३१", "content_sanskrit": "तस्मिन्नभ्यागते काले प्रतप्ते रोमहर्षणे ।\nमिथो भेदो न मे कार्यस्तेन जीवसि सूतज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2041602, "chapter_id": 1923, "verse_number": "५-१६८-३२", "content_sanskrit": "न ह्यहं त्वद्य विक्रम्य स्थविरोऽपि शिशोस्तव।\nयुद्धश्रद्धामहं छिन्द्यां जीवितस्य च सूतज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2041603, "chapter_id": 1923, "verse_number": "५-१६८-३३", "content_sanskrit": "जामदग्र्येन रामेण महास्त्राणि विमुञ्चता।\nन मे व्यथा कृता काचित्त्वं तु मे कि करिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2041604, "chapter_id": 1923, "verse_number": "५-१६८-३४", "content_sanskrit": "कामं नैतत्प्रशंसन्ति सन्तः स्वबलसंस्तवम्।\nवक्ष्यामि तु त्वां सन्तप्तो निहीन कुलपांसन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2041605, "chapter_id": 1923, "verse_number": "५-१६८-३५", "content_sanskrit": "समेतं पार्थिवं क्षत्रं काशिराजस्वयंवरे ।\nनिर्जित्यैकरथेनैव याः कन्यास्तरसाहृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2041606, "chapter_id": 1923, "verse_number": "५-१६८-३६", "content_sanskrit": "ईदृशानां सहस्राणि विशिष्टानामथो पुनः ।\nमयैकेन निरस्तानि ससैन्यानि रणाजिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2041607, "chapter_id": 1923, "verse_number": "५-१६८-३७", "content_sanskrit": "त्वां प्राप्य वैरपुरुषं कुरूणामनयो महान्।\nउपस्थितो विनाशाय यतस्व पुरुषो भव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2041608, "chapter_id": 1923, "verse_number": "५-१६८-३८", "content_sanskrit": "युध्यस्व समरे पार्थं येन विस्पर्धसे सह ।\nद्रक्ष्यामि त्वां विनिर्मुक्तमस्माद्युद्धात्सुदुर्मते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2041609, "chapter_id": 1923, "verse_number": "५-१६८-३९", "content_sanskrit": "तमुवाच ततो राजा धार्तराष्ट्रः प्रतापवान् ।\nमां समीक्षस्व गाङ्गेय कार्यं हि महदुद्यतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2041610, "chapter_id": 1923, "verse_number": "५-१६८-४०", "content_sanskrit": "चिन्त्यतामिदमेकाग्रं मम निःश्रेयसं परम्।\nउभावपि भवन्तौ मे महत्कर्म करिष्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2041611, "chapter_id": 1923, "verse_number": "५-१६८-४१", "content_sanskrit": "भूयश्च श्रोतुमिच्छामि परेषां रथसत्तमान् ।\nये चैवातिथास्तत्र ये चैव रथयूथपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2041612, "chapter_id": 1923, "verse_number": "५-१६८-४२", "content_sanskrit": "बलाबलममित्राणां श्रोतुमिच्छामि कौरव ।\nप्रभातायां रजन्यां वै इदं युद्धं भविष्यति ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2041613, "chapter_id": 1923, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि रथातिरथसंख्यानपर्वणि अष्टषष्ट्यधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]