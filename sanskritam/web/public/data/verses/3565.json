[{"id": 2119428, "chapter_id": 3565, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2119429, "chapter_id": 3565, "verse_number": "१", "content_sanskrit": "शतक्रतोः सभा दिव्या भास्वरा कर्मनिर्मिता ।\nस्वयं शक्रेण कौरव्य निर्जितार्कसमप्रभा\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2119430, "chapter_id": 3565, "verse_number": "२", "content_sanskrit": "विस्तीर्णा योजनशतं शतमध्यर्धमायता ।\nवैहायसी कामगमा पञ्चयोजनमुच्छ्रिता\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2119431, "chapter_id": 3565, "verse_number": "३", "content_sanskrit": "जराशोकक्लमापेता निरातङ्का शिवा सुखा ।\nवेश्मासनवती रम्या दिव्यपादपशोभिता\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2119432, "chapter_id": 3565, "verse_number": "४", "content_sanskrit": "तस्यां देवेश्वरः पार्थ सभायां परमासने ।\nआस्ते शच्या सहेन्द्राण्या श्रिया लक्ष्म्या च भारत\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2119433, "chapter_id": 3565, "verse_number": "५", "content_sanskrit": "बिभ्रद्वपुरनिर्देश्यं किरीटी लोहिताङ्गदः ।\nविरजोम्बरश्चित्रमाल्यो ह्रीकीर्तिद्युतिभिः सह\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2119434, "chapter_id": 3565, "verse_number": "६", "content_sanskrit": "तस्यां तूपासते नित्यं महात्मानं शतक्रतुम् ।\nमरुतः सर्वतो राजन् सर्वे च गृहमेधिनः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2119435, "chapter_id": 3565, "verse_number": "७", "content_sanskrit": "सिद्धा देवर्षयश्चैव साध्या देवगणास्तथा ।\nमरुद्गणाश्च सहिता भास्वन्तो हेममालिनः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2119436, "chapter_id": 3565, "verse_number": "८", "content_sanskrit": "एते सानुचराः सर्वे दिव्यरूपाः स्वलङ्कृताः ।\nउपासते महात्मानं देवराजं शतक्रतुम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2119437, "chapter_id": 3565, "verse_number": "९", "content_sanskrit": "तथा देवर्षयः सर्वे पार्थ शक्रमुपासते ।\nअमला धूतपाप्मानो दीप्यमाना इवाग्नयः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2119438, "chapter_id": 3565, "verse_number": "", "content_sanskrit": "तेजस्विनः सोमपाश्च विपापा विगतक्लमाः ।\nपराशरः पर्वतश्च तथा सावर्णिगालवौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2119439, "chapter_id": 3565, "verse_number": "१०", "content_sanskrit": "एकतश्च द्वितश्चैव त्रितश्चैव महामुनिः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2119440, "chapter_id": 3565, "verse_number": "११", "content_sanskrit": "शङ्खश्च लिखितश्चैव तथा गौरशिरा मुनिः ।\nदुर्वासा वै दीर्घतमा याज्ञवल्क्योऽथ भालुकिः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2119441, "chapter_id": 3565, "verse_number": "१२", "content_sanskrit": "उद्दालकः श्वेतकेतुः ताण्ड्यः शाट्यायनिस्तथा ।\nहविष्मांश्च हविष्यश्च हरिश्चन्द्रश्च पार्थिवः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2119442, "chapter_id": 3565, "verse_number": "१३", "content_sanskrit": "हृद्यश्चौदरशाण्डिल्यः पाराशर्यगविष्ठलौ ।\nजाबालिर्वामदेवश्च शक्तिर्गार्ग्यसुवामनौ\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2119443, "chapter_id": 3565, "verse_number": "१४", "content_sanskrit": "वातस्कन्धो विशाखश्च विधाता काल एव च ।\nअनन्तदत्तस्त्वष्टा च विश्वकर्मा च तुम्बुरुः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2119444, "chapter_id": 3565, "verse_number": "१५", "content_sanskrit": "मरुत्तश्च मरीचिश्च स्थाणुश्चात्रिर्महातपाः ।\nकक्षीवान् गौतमस्तार्क्ष्यः तथा वैश्वानरो मुनिः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2119445, "chapter_id": 3565, "verse_number": "१६", "content_sanskrit": "षडर्तुः कवषो धौम्यो रैभ्यो नलपरावसू ।\nस्वस्त्यात्रेयो जरत्कारुः कहोळः काश्यपस्तथा\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2119446, "chapter_id": 3565, "verse_number": "१७", "content_sanskrit": "विभाण्डकर्श्यशृङ्गौ च उन्मुखो विमुखस्तथा ।\nऋषिः कालकवर्षीयः सुश्रुतोऽथ हिरण्यदः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2119447, "chapter_id": 3565, "verse_number": "१८", "content_sanskrit": "संवर्तो वेदहव्यश्च विश्वसेनश्च वीर्यवान् ।\nदिव्या आपस्तथौषध्यः श्रद्धा मेधा सरस्वती\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2119448, "chapter_id": 3565, "verse_number": "१९", "content_sanskrit": "अर्थो धर्मश्च कामश्च विद्युतश्चापि पाण्डव ।\nप्राची दिग् यज्ञवाहाश्च पावकाः सप्तविंशतिः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2119449, "chapter_id": 3565, "verse_number": "२०", "content_sanskrit": "अग्नीषोमौ तथेन्द्राग्नी मित्रश्च सविताऽर्यमा ।\nभगो विश्वे च साध्याश्च शुक्रो मन्त्री च भारत ॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2119450, "chapter_id": 3565, "verse_number": "२१", "content_sanskrit": "यज्ञाश्च दक्षिणाश्चैव ग्रहाः सोमाश्च सर्वशः ।\nयज्ञवाहाश्च ये मन्त्राः सर्वे शक्रमुपासते\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2119451, "chapter_id": 3565, "verse_number": "२२", "content_sanskrit": "तथैवाप्सरसो राजन् रम्भोर्वश्यथ मेनका ।\nघृताची पञ्चचूडा च विप्रचित्तिपुरोगमाः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2119452, "chapter_id": 3565, "verse_number": "२३", "content_sanskrit": "विश्वावसुश्चित्रसेनः पर्वतस्तुम्बुरुस्तथा ।\nविद्याधराश्च राजेन्द्र गन्धर्वाश्च मनोरमाः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2119453, "chapter_id": 3565, "verse_number": "२४", "content_sanskrit": "नृत्तवादित्रगीतैश्च भावैश्च विविधैरपि ।\nरमयन्ति महात्मानं देवराजं शतक्रतुम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2119454, "chapter_id": 3565, "verse_number": "२५", "content_sanskrit": "स्तुतिभिर्मङ्गलैश्चैव स्तुवन्तः कर्मभिस्तथा ।\nविक्रमैश्च महात्मानं स्तुवन्तो रमयन्ति तम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2119455, "chapter_id": 3565, "verse_number": "२६", "content_sanskrit": "ब्रह्मराजर्षयः सर्वे तथा देवर्षयोऽप्युत ।\nविमानैर्विविधै रम्यैर्भ्राजमानैरिवाग्निभिः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2119456, "chapter_id": 3565, "verse_number": "२७", "content_sanskrit": "स्रग्विणो भूषिताः सर्वे यान्ति चायान्ति चापरे ।\nबृहस्पतिश्च शुक्रश्च नित्यमास्तां विशाम्पते\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2119457, "chapter_id": 3565, "verse_number": "२८", "content_sanskrit": "एते चान्ये च बहवो विपाप्मानो यतव्रताः ।\nविमानैः सूर्यसङ्काशैः सोमवत् प्रियदर्शनाः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2119458, "chapter_id": 3565, "verse_number": "२९", "content_sanskrit": "ब्रह्मणो वचनाद् राजन् भृगुः सप्तर्षयस्तथा\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2119459, "chapter_id": 3565, "verse_number": "३०", "content_sanskrit": "एषा सभा मया दृष्टा दिव्या पुष्करमालिनी ।\nशतक्रतोर्महाबाहो याम्यां शृणु ममानघ\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2119460, "chapter_id": 3565, "verse_number": "७", "content_sanskrit": "॥ इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nसभापर्वणि सप्तमोऽध्यायः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2119461, "chapter_id": 3565, "verse_number": "७", "content_sanskrit": "॥ मन्त्रपर्वणि सप्तमोऽध्यायः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2119462, "chapter_id": 3565, "verse_number": "", "content_sanskrit": "—— ०  ——", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]