[{"id": 2033910, "chapter_id": 1733, "verse_number": "४-५६-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2033911, "chapter_id": 1733, "verse_number": "४-५६-१", "content_sanskrit": "ततस्त्रीणि सहस्राणि रथानां च धनुष्मताम्।\nघोराणि कुरुवीराणां पर्यकीर्यन्त भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2033912, "chapter_id": 1733, "verse_number": "४-५६-२", "content_sanskrit": "कर्णो रथसहस्रेण प्रत्यगृह्णाद्धनञ्जयम्।\nभीष्मः शान्तनवो धीमान्सहस्रेण पुरस्कृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2033913, "chapter_id": 1733, "verse_number": "४-५६-३", "content_sanskrit": "तथा रथसहस्रेण भ्रातृभिः परिवारितः।\nपश्चाद्दुर्योधनोऽतिष्ठद्यशसा च श्रिया ज्वलन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2033914, "chapter_id": 1733, "verse_number": "४-५६-४", "content_sanskrit": "अतिष्ठन्निवकाशेषु पादाताः सह वाजिभिः ।\nभीमरूपाश्च मातङ्गास्तोमराङ्कुशचोदिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2033915, "chapter_id": 1733, "verse_number": "४-५६-५", "content_sanskrit": "तानि दृष्ट्वा ह्यनीकानि विततानि महात्मनाम् ।\nवैराटिमुत्तरं तं तु प्रत्यभाषत पाण्डवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2033916, "chapter_id": 1733, "verse_number": "४-५६-६", "content_sanskrit": "जाम्बूनदमयी वेदी ध्वजाग्रे यस्य दृश्यते।\nशोणाश्चाश्वा रथे युक्ता द्रोण एष प्रकाशते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2033917, "chapter_id": 1733, "verse_number": "४-५६-७", "content_sanskrit": "आचार्यो निपुणो धीमान्ब्रह्मविच्छूरसत्तमः।\nआहवे चाप्रतिद्वन्द्वो दूरपाती महारथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2033918, "chapter_id": 1733, "verse_number": "४-५६-८", "content_sanskrit": "सुप्रसन्नो महावीरः कुरुष्वैनं प्रदक्षिणम्।\nअत्रैव चाविरोधेन एष धर्मः सनातनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2033919, "chapter_id": 1733, "verse_number": "४-५६-९", "content_sanskrit": "यदि मे प्रहरेद्द्रोणः शरीरे मे प्रहृष्यतः ।\nततोऽस्मिन्प्रहरिष्यामि नान्यथा बुद्धिरस्ति मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2033920, "chapter_id": 1733, "verse_number": "४-५६-१०", "content_sanskrit": "भारताचार्यमुख्येन ब्राह्मणेन महात्मना ।\nतेन मे युध्यमानस्य मन्दं वाहय सारथे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2033921, "chapter_id": 1733, "verse_number": "४-५६-११", "content_sanskrit": "ध्वजाग्रे सिंहलाङ्गूलो दिक्षु सर्वासु शोभते ।\nभारताचार्यपुत्रस्तु सोऽश्वत्थामा विराजते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2033922, "chapter_id": 1733, "verse_number": "४-५६-१२", "content_sanskrit": "ध्वजाग्रं दृश्यते यत्र बालसूर्यसमप्रभम् ।\nदुर्जयः सर्वसैन्यानां देवैरपि सवासवैः ।\nतेन मे युध्यमानस्य मन्दं वाहय सारथे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2033923, "chapter_id": 1733, "verse_number": "४-५६-१३", "content_sanskrit": "ध्वजाग्रे गोवृषो यस्य काञ्चनोऽभिविराजते ।\nआचार्यवरमुख्यस्तु कृप एष महारथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2033924, "chapter_id": 1733, "verse_number": "४-५६-१४", "content_sanskrit": "द्रोणेन च समो वीर्ये पितुर्मे परमः सखा।\nतेन मे युध्यमानस्य मन्दं वाहय सारथे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2033925, "chapter_id": 1733, "verse_number": "४-५६-१५", "content_sanskrit": "यस्य काञ्चनकम्बूभिर्हस्तिकक्ष्यापरिष्कृतः।\nध्वजः प्रकाशते दूराद्रथे विद्युद्गणोपमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2033926, "chapter_id": 1733, "verse_number": "४-५६-१६", "content_sanskrit": "एष वैकर्तनः कर्णः प्रतिमानं धनुष्मताम्।\nदृढवैरी सदाऽस्माकं नित्यं कटुकभाषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2033927, "chapter_id": 1733, "verse_number": "४-५६-१७", "content_sanskrit": "यस्याश्रयबलादेव धार्तराष्ट्रः ससौबलः ।\nअस्मान्निरस्य राज्याच्च पुनरद्यापि योत्स्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2033928, "chapter_id": 1733, "verse_number": "४-५६-१८", "content_sanskrit": "एष वै स्पर्धते नित्यं मया सह सुदुर्जयः ।\nजामदग्न्यस्य रामस्य शिष्यो ह्येष महारथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2033929, "chapter_id": 1733, "verse_number": "४-५६-१९", "content_sanskrit": "सर्वास्त्रकुशलः कर्णः सर्वशस्त्रभृतांवरः ।\nयुद्धेऽप्रतिमवीर्यश्च दृढवेधी पराक्रमी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2033930, "chapter_id": 1733, "verse_number": "४-५६-२०", "content_sanskrit": "अद्याहं युद्धमेतेन करिष्ये सूतबन्धुना।\nद्रष्टा त्वमावयोर्युद्धं बलिवासवयोरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2033931, "chapter_id": 1733, "verse_number": "४-५६-२१", "content_sanskrit": "महारथेन शूरेण सूतपुत्रेण धन्विना।\nतेन मे युध्यमानस्य शीघ्रं वाहय सारथे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2033932, "chapter_id": 1733, "verse_number": "४-५६-२२", "content_sanskrit": "यस्य चैव रथोपस्थे नागो मणिमयो ध्वजः ।\nएष दुर्योधनस्तत्र कौरवो यशसा वृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2033933, "chapter_id": 1733, "verse_number": "४-५६-२३", "content_sanskrit": "लब्धलक्षो दृढं वेधी लघुहस्तः प्रतापवान् ।\nतेन मे युध्यमानस्य शीघ्रं वाहय सारथे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2033934, "chapter_id": 1733, "verse_number": "४-५६-२४", "content_sanskrit": "यस्तु श्वेतावदातेन पञ्चतालेन केतुना ।\nवैडूर्यमयदण्डेन तालवृक्षेण राजते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2033935, "chapter_id": 1733, "verse_number": "४-५६-२५", "content_sanskrit": "हस्तावापी बृहद्धन्वा सेनां तिष्ठति हर्षयन् ।\nरामेण जामदग्न्येन द्वैरथेनाजितः पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2033936, "chapter_id": 1733, "verse_number": "४-५६-२६", "content_sanskrit": "शीघ्रश्च लगुवेधी च लघुहस्तः प्रतापवान् ।\nएष शान्तनवो भीष्मः सर्वेषां नः पितामहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2033937, "chapter_id": 1733, "verse_number": "४-५६-२७", "content_sanskrit": "ककुदः सर्वसैन्यानां सर्वशस्त्रभृतांवरः ।\nजयश्रियाऽवबद्धस्तु सुयोधनवशानुगः ।\nपश्चादेष प्रयातव्यो न मे विघ्नकरो भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2033938, "chapter_id": 1733, "verse_number": "४-५६-२८", "content_sanskrit": "इत्येतांस्त्वरितः पार्थः कथयित्वा तु चोत्तरे।\nरूपतश्चिह्नतश्चैव युद्धाय त्वरते पुनः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2033939, "chapter_id": 1733, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते विराटपर्वणि गोग्रहणपर्वणि षट्पञ्चाशोऽध्यायः ॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]