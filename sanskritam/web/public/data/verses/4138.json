[{"id": 2145656, "chapter_id": 4138, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2145657, "chapter_id": 4138, "verse_number": "१", "content_sanskrit": "चक्षुष्मतां वै स्पृहयामि सञ्जय\nद्रक्ष्यन्ति यो वासुदेवं समीपे ।\nविभ्राजमानं वपुषा परेण\nप्रकाशयन्तं प्रदिशो दिशश्च\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2145658, "chapter_id": 4138, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2145659, "chapter_id": 4138, "verse_number": "२", "content_sanskrit": "वक्ता वाचं राजमध्ये सभायां\nवृष्णिश्रेष्ठो मुनिभिर्भ्राजमानः\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2145660, "chapter_id": 4138, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2145661, "chapter_id": 4138, "verse_number": "३", "content_sanskrit": "ईरयन्तं भारतीं भारतानाम्\nअभ्यर्चनीयां शङ्करीं सृञ्जयानाम् ।\nबुभूषद्भिर्ग्रहणीयामनिन्द्यां\nपरासूनामग्रहणीयरूपाम्\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2145662, "chapter_id": 4138, "verse_number": "४", "content_sanskrit": "समुद्यन्तं सात्वतमेकवीरं\nप्रणेतारमृषभं यादवानाम् ।\nनिहन्तारं क्षोभणं शात्रवाणां\nमुष्णन्तं वै द्विषतां चैव तेजः\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2145663, "chapter_id": 4138, "verse_number": "५", "content_sanskrit": "द्रष्टारो हि कुरवस्तं समेता\nमहात्मानं शत्रुहणं वरेण्यम् ।\nब्रुवन्तं वाचमनृशंसरूपां\nवृष्णिश्रेष्ठं मोहयन्तं मदीयान्\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2145664, "chapter_id": 4138, "verse_number": "६", "content_sanskrit": "ऋषिं सनातनतमं विपश्चितं वाचः समुद्रं कलशं यतीनाम् ।\nअरिष्टनेमिं गरुडं सुपर्णं हरिं प्रजानां भुवनस्य धाम\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2145665, "chapter_id": 4138, "verse_number": "७", "content_sanskrit": "सहस्रशीर्षं पुरुषं पुराणम्\nअनादिमध्यान्तमनन्तकीर्तिम् ।\nशुक्रस्य धातारमजं च नित्यं\nपरं परेषां शरणं प्रपद्ये\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2145666, "chapter_id": 4138, "verse_number": "८", "content_sanskrit": "त्रैलोक्यनिर्माणमजं जनित्रं देवासुराणामथ नागरक्षसाम् ।\nनराधिपानां विदुषां प्रधानम् इन्द्रानुजं तं शरणं प्रपद्ये\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2145667, "chapter_id": 4138, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि एकोनसप्ततितमोऽध्यायः ॥६९॥\nव्यासाभिगमनपर्वणि द्वाविंशोऽध्यायः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2145668, "chapter_id": 4138, "verse_number": "", "content_sanskrit": "॥ समाप्तं व्यासाभिगमनपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}]