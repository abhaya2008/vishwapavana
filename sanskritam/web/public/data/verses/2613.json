[{"id": 2076082, "chapter_id": 2613, "verse_number": "१२-११८-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2076083, "chapter_id": 2613, "verse_number": "१२-११८-१", "content_sanskrit": "स श्वा प्रकृतिमापन्नः परं दैन्यमुपागमत्।\nऋषिणा हुंकृतः पापस्तपोवनबहिष्कृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2076084, "chapter_id": 2613, "verse_number": "१२-११८-२", "content_sanskrit": "एवं राज्ञा मतिमता विदित्वा शीलशौचताम्।\nआर्जवं प्रकृतिं सत्वं श्रुतं वृत्तं कुलं दमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2076085, "chapter_id": 2613, "verse_number": "१२-११८-३", "content_sanskrit": "अनुक्रोशं बलं वीर्यं प्रभावं प्रशमं क्षमाम्।\nभृत्यायेमन्त्रिणो योग्यास्तत्र स्थाप्याः सुरक्षिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2076086, "chapter_id": 2613, "verse_number": "१२-११८-४", "content_sanskrit": "नाषरीक्ष्य महीपालः प्रकर्तुं भृत्यमर्हति।\nअकुलीननराकीर्णो न राजा सुखमेधते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2076087, "chapter_id": 2613, "verse_number": "१२-११८-५", "content_sanskrit": "कुलजः प्राकृतो राजंस्तत्कुलीनतया सदा।\nन पापे कुरुते बुद्धिं निन्द्यमानोऽप्यनागसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2076088, "chapter_id": 2613, "verse_number": "१२-११८-६", "content_sanskrit": "अकुलीनस्तु पुरुषः प्राकृतः साधुसंक्षयात्।\nदुर्लभैश्वर्यतां प्राप्तो निन्दितः शत्रुतां व्रजेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2076089, "chapter_id": 2613, "verse_number": "१२-११८-७", "content_sanskrit": "`काकः श्वानोऽकुलीनश्च बिडालः सर्प एव च।\nअकुलीना च या नारी तुल्यास्ते परिकीर्तिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2076090, "chapter_id": 2613, "verse_number": "१२-११८-८", "content_sanskrit": "लोकपालाः सदोद्विग्नाः पश्यन्त्यकुलजान्यथा।\nनारीं वा पुरुषं वाऽथ शीलं तत्रापि कारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2076091, "chapter_id": 2613, "verse_number": "१२-११८-९", "content_sanskrit": "दुष्कुलीना च या स्त्री स्याद्दुष्कुलीनश्च यः पुम।\nअहिंसाशीलसंयोगाद्धर्मश्चाऽऽकुलतां व्रजेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2076092, "chapter_id": 2613, "verse_number": "१२-११८-१०", "content_sanskrit": "धर्मं प्रति महाराज श्लोकानाह बृहस्पतिः।\nशृणु सर्वान्महीपाल हृदि तांश्च करिष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2076093, "chapter_id": 2613, "verse_number": "१२-११८-११", "content_sanskrit": "असितं सितकर्माणं यथा दान्तं तपस्विनम्।\nवृत्तस्थमपि चण्डालं तं देवा ब्राह्मणं विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2076094, "chapter_id": 2613, "verse_number": "१२-११८-१२", "content_sanskrit": "यदि घातयते कश्चित्पापसत्वं प्रजाहितः।\nसर्वसत्वहितार्थाय न तेनासौ विहिंसकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2076095, "chapter_id": 2613, "verse_number": "१२-११८-१३", "content_sanskrit": "द्वीपिनं शरभं सिंहं व्याघ्रं कुञ्जरमेव च।\nमहिषं च वराहं च सूकरं श्वानपन्नगान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2076096, "chapter_id": 2613, "verse_number": "१२-११८-१४", "content_sanskrit": "गोब्राह्मणहितार्थाय बालस्त्रीरक्षणाय च।\nवृद्धातुरपरित्राणे यो हिनस्ति स धर्मवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2076097, "chapter_id": 2613, "verse_number": "१२-११८-१५", "content_sanskrit": "ब्राह्मणः पापकर्मा च म्लेच्छो वा धार्मिकः शु वः।\nश्रेयांस्तत्र भवेन्म्लेच्छो ब्राह्मणः पापकृत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2076098, "chapter_id": 2613, "verse_number": "१२-११८-१६", "content_sanskrit": "दुष्कुलीनः कुलीनो वा यः कश्चिच्छीलवान्नरः।\nप्रकृतिं तस्य विज्ञाय स्थिरां वा यदि वाऽस्थिराम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2076099, "chapter_id": 2613, "verse_number": "१२-११८-१७", "content_sanskrit": "शीलं वाऽनुत्तमं कर्म कुर्याद्राजा समाहितः।\nनियुञ्जीत महीपालो दुर्वृत्तं पापकर्मसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2076100, "chapter_id": 2613, "verse_number": "१२-११८-१८", "content_sanskrit": "कुलीनं शिक्षितं प्राज्ञं ज्ञानविज्ञानकोविदम्।\nसर्वशास्त्रार्थतत्त्वज्ञं सहिष्णुं देशजं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2076101, "chapter_id": 2613, "verse_number": "१२-११८-१९", "content_sanskrit": "कृतज्ञं बलवन्तं च क्षान्तं दान्तं जितेन्द्रियम्।\nअलुब्धं लब्धसंतुष्टं स्वामिमित्रबुभूषकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2076102, "chapter_id": 2613, "verse_number": "१२-११८-२०", "content_sanskrit": "सचिवं देशकालज्ञं सर्वसंग्रहणे रतम्।\nसंस्कृतं युक्तवचनं हितैषिणमतन्द्रितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2076103, "chapter_id": 2613, "verse_number": "१२-११८-२१", "content_sanskrit": "युक्ताचारं स्वविषये संधिविग्रहकोविदम्।\nशस्तं त्रिवर्गवेत्तारं पौरजानपदप्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2076104, "chapter_id": 2613, "verse_number": "१२-११८-२२", "content_sanskrit": "सेनाव्यूहनतत्त्वज्ञं बलहर्षणकोविदम्।\nइङ्गिताकरातत्त्वज्ञं यात्रासेनाविशारदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2076105, "chapter_id": 2613, "verse_number": "१२-११८-२३", "content_sanskrit": "हस्तिशिक्षाश्वतत्त्वज्ञमहंकारविवर्जितम्।\nप्रगल्भं दक्षिणं दान्तं बलिनं युक्तमन्त्रिणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2076106, "chapter_id": 2613, "verse_number": "१२-११८-२४", "content_sanskrit": "चौक्षं चौक्षजनाकीर्णं सुवेषं सुखदर्शनम्।\nनायकं नीतिकुशलं गुणैः षङ्भिः समन्वितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2076107, "chapter_id": 2613, "verse_number": "१२-११८-२५", "content_sanskrit": "अस्तब्धं प्रश्रितं श्लक्ष्णं मृदुवादिनमेव च।\nधीरं महर्द्धि च देशकालोपपादकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2076108, "chapter_id": 2613, "verse_number": "१२-११८-२६", "content_sanskrit": "सचि यः प्रकुरुते न चैनमवमन्यते।\nतस्य विस्तीर्यते राज्यं ज्योत्स्ना ग्रहपतेरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2076109, "chapter_id": 2613, "verse_number": "१२-११८-२७", "content_sanskrit": "एतैरेव गुणैर्युक्तो राजा शास्त्रविशारदः।\nएष्टव्यो धर्मपरमः प्रजापालनतत्परः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2076110, "chapter_id": 2613, "verse_number": "१२-११८-२८", "content_sanskrit": "धीरो मर्षी शुचिः शीघ्रः काले पुरुषकारवित्।\nशुश्रूषुः श्रुतवाञ्श्रोता ऊहापोहविशारदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2076111, "chapter_id": 2613, "verse_number": "१२-११८-२९", "content_sanskrit": "मेधावी धारणायुक्तो यथान्यायोपपादकः।\nदान्तः सदा प्रियाभाषी क्षमावांश्च विपर्यये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2076112, "chapter_id": 2613, "verse_number": "१२-११८-३०", "content_sanskrit": "नातिच्छेत्ता स्वयंकारी श्रद्धालुः सुखदर्शनः।\nआर्तहस्तप्रदो नित्यमाप्तामात्यो नये रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2076113, "chapter_id": 2613, "verse_number": "१२-११८-३१", "content_sanskrit": "नाहंवादी ननिर्द्वन्द्वो नयत्किंचनकारकः।\nकृते कर्मण्यमोघानां कर्ता भृत्यजनप्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2076114, "chapter_id": 2613, "verse_number": "१२-११८-३२", "content_sanskrit": "संगृहीतजनोऽस्तब्धः प्रसन्नवदनः सदा।\nत्राता भृत्यजनापेक्षी न क्रोधी सुमहामनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2076115, "chapter_id": 2613, "verse_number": "१२-११८-३३", "content_sanskrit": "युक्तदण्डो न निर्दण्डो धर्मकार्यानुशासनः।\nचारनेत्रः प्रजावेक्षी धर्मार्थकुशलः सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2076116, "chapter_id": 2613, "verse_number": "१२-११८-३४", "content_sanskrit": "राजा गुणशताकीर्ण एष्टव्यस्तादृशो भवेत्।\nयोधाश्चैव मनुष्येन्द्र सर्वैर्गुणगणैर्वृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2076117, "chapter_id": 2613, "verse_number": "१२-११८-३५", "content_sanskrit": "अन्वेष्टव्याः सुपुरुषाः सहाया राज्यधारणे।\nन विमानयितव्यास्ते राज्ञा वृद्धिमभीप्सता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2076118, "chapter_id": 2613, "verse_number": "१२-११८-३६", "content_sanskrit": "योधाः समरशौण्डीराः कृतज्ञाः शास्त्रकोविदाः।\nधर्मशास्त्रसमायुक्ताः पदातिजनसंवृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2076119, "chapter_id": 2613, "verse_number": "१२-११८-३७", "content_sanskrit": "अर्थमानविवृद्धाश्च रथचर्याविशारदाः।\nइष्वस्त्रकुशला यस्य तस्येयं नृपतेर्मही॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2076120, "chapter_id": 2613, "verse_number": "१२-११८-३८", "content_sanskrit": "`ज्ञातीनामनवज्ञानं भृत्येष्वशठता तथा।\nनैपुणं चार्थचर्यासु यस्यैते तस्य सा मही॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2076121, "chapter_id": 2613, "verse_number": "१२-११८-३९", "content_sanskrit": "आलस्यं चैव निद्रा च व्यसनान्यतिहास्यता।\nयस्तैतानि न विद्यन्ते तस्यैव सुचिरं मही॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2076122, "chapter_id": 2613, "verse_number": "१२-११८-४०", "content_sanskrit": "वृद्धसेवी महोत्साहो वर्णानां चैव रक्षिता।\nधर्मचर्याः सदा यस्य तस्येयं सुचिरं मही॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2076123, "chapter_id": 2613, "verse_number": "१२-११८-४१", "content_sanskrit": "नीतिवर्त्मानुसरणं नित्यमुत्थानमेव च।\nरिपूणामनवज्ञानं तस्येयं सुचिरं मही॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2076124, "chapter_id": 2613, "verse_number": "१२-११८-४२", "content_sanskrit": "उत्थानं चैव दैवं च तयोर्नानात्वमेव च॥\nमनुना वर्णितं पूर्वं वक्ष्ये शृणु तदेव हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2076125, "chapter_id": 2613, "verse_number": "१२-११८-४३", "content_sanskrit": "उत्थानं हि नरेन्द्राणां बृहस्पतिरभाषत।\nनयानयविधानज्ञः सदा भव कुरूद्वह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2076126, "chapter_id": 2613, "verse_number": "१२-११८-४४", "content_sanskrit": "दुर्हृदां छिद्रदर्शी यः सुहृदामुपकारवान्।\nविशेषविच्च भृत्यानां स राज्यफलमश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2076127, "chapter_id": 2613, "verse_number": "१२-११८-४५", "content_sanskrit": "सर्वसंग्रहणे युक्तो नृपो भवति यः सदा।\nउत्थानशीलो मन्त्राढ्यः स राजा राजसत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2076128, "chapter_id": 2613, "verse_number": "१२-११८-४६", "content_sanskrit": "शक्या चाश्वसहस्रेण वीरारोहेण भारत।\nसंगृहीतमनुष्येण कृत्स्ना जेतुं वसुंधरा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2076129, "chapter_id": 2613, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि अष्टादशाधिकशततमोऽध्यायः॥ ११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]