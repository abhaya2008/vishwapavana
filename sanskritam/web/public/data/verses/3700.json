[{"id": 2126078, "chapter_id": 3700, "verse_number": "", "content_sanskrit": "जनमेयजः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2126079, "chapter_id": 3700, "verse_number": "१", "content_sanskrit": "अत्यद्भुतानि कर्माणि पार्थस्यामिततेजसः ।\nधृतराष्ट्रो महातेजाः श्रुत्वा विप्र किमब्रवीत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2126080, "chapter_id": 3700, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2126081, "chapter_id": 3700, "verse_number": "२", "content_sanskrit": "शक्रलोकगतं पार्थं श्रुत्वा राजाऽम्बिकासुतः ।\nद्वैपायनादृषिश्रेष्ठात् सञ्जयं वाक्यमब्रवीत्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2126082, "chapter_id": 3700, "verse_number": "३", "content_sanskrit": "श्रुतं मे सूत कार्त्स्न्येन कर्म पार्थस्य धीमतः ।\nकच्चित् तवापि विदितं याथातथ्येन सारथे\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2126083, "chapter_id": 3700, "verse_number": "४", "content_sanskrit": "प्रमत्तो ग्राम्यधर्मेषु मन्दात्मा पापनिश्चयः ।\nमम पुत्रः सुदुर्बुद्धिः पृथिवीं नाशयिष्यति\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2126084, "chapter_id": 3700, "verse_number": "५", "content_sanskrit": "यस्य नित्यमृता वाचः स्वैरेष्वपि महात्मनः ।\nत्रैलोक्यमपि तस्य स्याद् योद्धा यस्य धनञ्जयः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2126085, "chapter_id": 3700, "verse_number": "६", "content_sanskrit": "अस्यतः कर्णिनाराचान् तीक्ष्णाग्रांश्च शिलाशितान् ।\nनार्जुनस्याग्रतस्तिष्ठेद् अपि मृत्युजरातिगः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2126086, "chapter_id": 3700, "verse_number": "७", "content_sanskrit": "मम पुत्रा दुरात्मानः सर्वे मृत्युवशं गताः ।\nयेषां युद्धं दुराधर्षैः पाण्डवैः समुपस्थितम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2126087, "chapter_id": 3700, "verse_number": "८", "content_sanskrit": "तस्यैव च न पश्यामि युधि गाण्डीवधन्वनः ।\nअनिशं चिन्तयानोऽपि य एनमभियाद् युधि\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2126088, "chapter_id": 3700, "verse_number": "९", "content_sanskrit": "द्रोणकर्णौ प्रतीयातां यदि भीष्मोऽपि वा रणे ।\nमहान् स्यात् संशयो लोके न तु पश्यामि नो जयम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2126089, "chapter_id": 3700, "verse_number": "१०", "content_sanskrit": "घृणी कर्णः प्रमादी च आचार्यः स्थविरो गुरुः ।\nअमर्षी बलवान् पार्थः संरम्भी दृढविक्रमः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2126090, "chapter_id": 3700, "verse_number": "११", "content_sanskrit": "भवेत् सुतुमुलं युद्धं सर्वस्याप्यपराजितम् ।\nसर्वेप्यस्त्रविदः शूराः सर्वे प्राप्ता महद्यशः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2126091, "chapter_id": 3700, "verse_number": "१२", "content_sanskrit": "अपि सर्वेश्वरत्वं हि न वाञ्छेरन् पराजिताः ।\nवधे नूनं भवेच्छान्तिः तेषां वा फल्गुनस्य वा \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2126092, "chapter_id": 3700, "verse_number": "१३", "content_sanskrit": "न तु हन्ताऽर्जुनस्यास्ति जेता वाऽस्य न विद्यते ।\nमन्युस्तस्य कथं शाम्येन्मन्दान् प्रति समुत्थितः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2126093, "chapter_id": 3700, "verse_number": "१४", "content_sanskrit": "त्रिदशेशसमो वीरः खाण्डवेऽग्निमतर्पयत् ।\nजिगाय पार्थिवान् सर्वान् राजसूये महाक्रतौ\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2126094, "chapter_id": 3700, "verse_number": "१५", "content_sanskrit": "शेषं कुर्याद् गिरेर्वज्रं निपतन् मूर्ध्निर् सञ्जय ।\nन तु कुर्युः शराः शेषम् अस्तास्तात किरीटिना\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2126095, "chapter_id": 3700, "verse_number": "१६", "content_sanskrit": "यथा हि किरणा भानोस्तपन्तीह चराचरम् ।\nतथा पार्थकरोत्सृष्टाः शरास्तप्यन्ति मे सुतान्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2126096, "chapter_id": 3700, "verse_number": "१७", "content_sanskrit": "अपीमां रथघोषेण भयार्ता सव्यसाचिनः ।\nप्रतिभाति विदीर्णेव सर्वतो भारती चमूः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2126097, "chapter_id": 3700, "verse_number": "१८", "content_sanskrit": "य उद्धरन् प्रवपंश्चैव बाणान्\nतथाऽऽततायी समरे किरीटी ।\nसृष्टोऽन्तकः सर्वहरो विधात्रा\nभवेद्यथा तद्वदवारणीयः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2126098, "chapter_id": 3700, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2126099, "chapter_id": 3700, "verse_number": "१९", "content_sanskrit": "यदेतत् कथितं राजन् त्वया दुर्योधनं प्रति ।\nसर्वमेतद् यथातथ्यं न तन्मिथ्या महीपते\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2126100, "chapter_id": 3700, "verse_number": "२०", "content_sanskrit": "मन्युनाऽभिसमाविष्टाः पाण्डवास्त्वमितौजसः ।\nदृष्ट्वा नीतां सभां कृष्णां धर्मपत्नीं यशस्विनीम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2126101, "chapter_id": 3700, "verse_number": "२१", "content_sanskrit": "दुःशासनस्य ता वाचः श्रुत्वा वै दारुणोदयाः ।\nकर्णस्य च महाराज न स्वप्स्यन्तीति मे मतिः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2126102, "chapter_id": 3700, "verse_number": "२२", "content_sanskrit": "श्रुतं हि ते महाराज यथा पार्थेन संयुगे ।\nएकादशतनुः स्थाणुर्धनुषा परितोषितः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2126103, "chapter_id": 3700, "verse_number": "२३", "content_sanskrit": "कैरातं वेषमास्थाय योधयामास फल्गुनम् ।\nजिज्ञासुः सर्वदेवेशः कपर्दी भगवान् स्वयम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2126104, "chapter_id": 3700, "verse_number": "२४", "content_sanskrit": "तत्रैनं लोकपालास्ते दर्शयामासुरर्जुनम् ।\nअस्त्रहेतोः पराक्रान्तं तपसा कौरवर्षभम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2126105, "chapter_id": 3700, "verse_number": "२५", "content_sanskrit": "नैतदुत्सहतेऽन्यो हि लब्धुमन्यत्र फल्गुनात् ।\nसाक्षाद्दर्शनमेतेषामीश्वराणां नरो भुवि\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2126106, "chapter_id": 3700, "verse_number": "२६", "content_sanskrit": "महेश्वरेण यो राजन्न जीर्णो ग्रस्तमूर्तिमान् ।\nकस्तमुत्सहते वीरो युद्धे जरयितुं पुमान्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2126107, "chapter_id": 3700, "verse_number": "२७", "content_sanskrit": "आसादितमिदं घोरं तुमुलं रोमहर्षणम् ।\nद्रौपदीं परिकर्षद्भिः कोपयद्भिश्च पाण्डवान्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2126108, "chapter_id": 3700, "verse_number": "२८", "content_sanskrit": "यत्र विस्फुरमाणौष्ठो भीमः प्राह वचो महत् ।\nदृष्ट्वा दुर्योधनेनोरू द्रौपद्या दर्शितावुभौ\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2126109, "chapter_id": 3700, "verse_number": "२९", "content_sanskrit": "ऊरुं भेत्स्यामि ते पाप गदया वज्रकल्पया ।\nत्रयोदशानां वर्षाणामन्ते दुर्द्यूतदेविनः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2126110, "chapter_id": 3700, "verse_number": "३०", "content_sanskrit": "सर्वे प्रहरतां श्रेष्ठाः सर्वे चामिततेजसः ।\nसर्वास्त्रनिपुणाः सर्वे देवैरपि सुदुर्जयाः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2126111, "chapter_id": 3700, "verse_number": "३१", "content_sanskrit": "मन्ये मन्युसमुद्भूताः पुत्राणां तव सङ्गरे ।\nअन्तं पार्थाः करिष्यन्ति वीर्यामर्षसमन्विताः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2126112, "chapter_id": 3700, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2126113, "chapter_id": 3700, "verse_number": "३२", "content_sanskrit": "किं कृतं सूत कर्णेन वदता परुषं वचः ।\nपर्याप्तं वैरमेतावद् यत् कृष्णा सा सभां गता\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2126114, "chapter_id": 3700, "verse_number": "३३", "content_sanskrit": "अपीदानीं मम सुताः तिष्ठेरन् मन्दचेतसः ।\nयेषां भ्राता गुरुर्ज्येष्ठो विनये नावतिष्ठते \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2126115, "chapter_id": 3700, "verse_number": "३४", "content_sanskrit": "ममापि वचनं सूत न शुश्रूषति मन्दभाक् ।\nदृष्ट्वा मां चक्षुषा हीनं निर्विचेष्टमचेतसम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2126116, "chapter_id": 3700, "verse_number": "३५", "content_sanskrit": "ये चास्य सचिवा मन्दाः कर्णसौबलकादयः ।\nते तस्य भूयसो दोषान् वर्धयन्ति विचेतसः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2126117, "chapter_id": 3700, "verse_number": "३६", "content_sanskrit": "स्वैरं मुक्ता अपि शराः पार्थेनामिततेजसा ।\nनिर्दहेयुर्मम सुतान् किम्पुनर्मन्युनेरिताः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2126118, "chapter_id": 3700, "verse_number": "३७", "content_sanskrit": "पार्थबाहुबलोत्सृष्टा महाचापविनिःसृताः ।\nदिव्यास्त्रमन्त्रचुदिताः सादयेषुः सुरानपि\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2126119, "chapter_id": 3700, "verse_number": "३८", "content_sanskrit": "यस्य मन्त्री च गोप्ता च सुहृच्चैव जनार्दनः ।\nहरिस्त्रैलोक्यनाथः किंनु तेन न निर्जितम्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2126120, "chapter_id": 3700, "verse_number": "३९", "content_sanskrit": "इदं च सुमहच्चित्रम् अर्जुनस्यैव सञ्जय ।\nमहादेवेन बाहुभ्यां यत्समेत इति श्रुतिः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2126121, "chapter_id": 3700, "verse_number": "४०", "content_sanskrit": "प्रत्यक्षं सर्वलोकस्य खाण्डवे यत्कृतं पुरा ।\nफल्गुनेन सहायेन वह्नेर्दामोदरेण च\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2126122, "chapter_id": 3700, "verse_number": "४१", "content_sanskrit": "सर्वथा नास्ति मे पुत्रः सामात्यः सहबान्धवः ।\nक्रुद्धे पार्थे च भीमे च वासुदेवे च सात्यकौ\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2126123, "chapter_id": 3700, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nवनपर्वणि द्विचत्वारिंशोऽध्यायः ॥४२॥\n॥ इन्द्रलोकाभिगमनपर्वणि पञ्चमोऽध्यायः ॥५॥\n—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]