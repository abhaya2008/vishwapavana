[{"id": 2105084, "chapter_id": 3266, "verse_number": "१५-४-१", "content_sanskrit": "वैशम्पायन उवाच।\nकाली स्त्री पाण्डुरैर्दन्तैः प्रविश्य हसती निशि।\nस्त्रियः स्वप्नेषु मुष्णन्ती द्वारकां परिधावति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2105085, "chapter_id": 3266, "verse_number": "१५-४-२", "content_sanskrit": "अग्निहोत्रनिकेतेषु वास्तुमध्येषु वेश्मसु।\nवृष्ण्यन्धकानखादन्त स्वप्ने गृध्रा भयानकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2105086, "chapter_id": 3266, "verse_number": "१५-४-३", "content_sanskrit": "अलङ्काराश्च च्छत्रं च ध्वजाश्च कवचानि च।\nह्रियमाणान्यदृश्यन्त रक्षोभिः सुभयानकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2105087, "chapter_id": 3266, "verse_number": "१५-४-४", "content_sanskrit": "तच्चाग्निदत्तं कृष्णस्य वज्रनाभमयोमयम्।\nदिवमाचक्रमे चक्रं वृष्णीनां पश्यतां तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2105088, "chapter_id": 3266, "verse_number": "१५-४-५", "content_sanskrit": "युक्तं रथं दिव्यमादित्यवर्णं\nहयाऽहरन्पश्यतो दारुकस्य।\nते सागरस्योपरिष्टादगच्छ-\nन्मनोजवाश्चतुरो वाजिमुख्याः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2105089, "chapter_id": 3266, "verse_number": "१५-४-६", "content_sanskrit": "तालः सुपर्णश्च महाध्वजौ तौ\nसुपूजितौ रामजनार्धनाभ्याम्।\nउच्चैर्जह्रुरप्सरसश्च दिव्या\nदेवा ऊचुर्गम्यतां तीर्थयात्राः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2105090, "chapter_id": 3266, "verse_number": "१५-४-७", "content_sanskrit": "`भगवद्दर्शनस्पर्शस्नेहैर्विततभोगिनः।\nदिवः प्रवेशानार्थं ते विमानैर्दिवमाययुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2105091, "chapter_id": 3266, "verse_number": "१५-४-८", "content_sanskrit": "ततो जिगमिषन्तस्ते वृष्ण्यन्धकमहारथाः।\nसान्तःपुरास्तदा तीर्थयात्रामैच्छन्नरर्षभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2105092, "chapter_id": 3266, "verse_number": "१५-४-९", "content_sanskrit": "ततो मनोहरा हृष्टाःक पेयं मांसं मधूनि च।\nबहु नानाविधं चक्रुस्त्वरिताः कालचोदिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2105093, "chapter_id": 3266, "verse_number": "१५-४-१०", "content_sanskrit": "ततः सीधुषु सक्ताश्च निर्ययुर्नगराद्बहिः।\nयानैरश्वैर्गजैश्चैव श्रीमन्तस्तिग्मतेजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2105094, "chapter_id": 3266, "verse_number": "१५-४-११", "content_sanskrit": "ततः प्रभासे न्यवसन्यथोद्दिष्टं यथागृहम्।\nप्रभूतभक्ष्यपेयास्ते सदारा यादवास्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2105095, "chapter_id": 3266, "verse_number": "१५-४-१२", "content_sanskrit": "निविष्टांस्तान्निशाम्याथ समुद्रान्ते स योगवित्।\nजगामामन्त्र्य तान्वीरानुद्धवोऽर्थविशारदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2105096, "chapter_id": 3266, "verse_number": "१५-४-१३", "content_sanskrit": "तं प्रस्थितं महात्मानमभिवाद्य कृताञ्जलिम्।\nजानन्विनाशं वृष्णीनां नैच्छद्वारयितुं हरिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2105097, "chapter_id": 3266, "verse_number": "१५-४-१४", "content_sanskrit": "ततः कालपरीतास्ते वृष्ण्यन्धकमहारथाः।\nअपश्यन्नुद्धवं यान्तं तेजसाऽऽवृत्य रोदसी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2105098, "chapter_id": 3266, "verse_number": "१५-४-१५", "content_sanskrit": "ब्राह्मणार्थेषु यत्सिद्धमन्नं तेषां महात्मनाम्।\nतद्वानरेभ्यः प्रददुः सुरागन्धसमन्वितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2105099, "chapter_id": 3266, "verse_number": "१५-४-१६", "content_sanskrit": "ततस्तूर्यशताकीर्णं नटनर्तकसंकुलम्।\nअवर्तत महापानं प्रभासे तिग्मतेजसाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2105100, "chapter_id": 3266, "verse_number": "१५-४-१७", "content_sanskrit": "कृष्णस्य सन्निधौ रामः सहितः कृतवर्मणा।\nअपिबद्युयुधानश्च गदो बभ्रुस्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2105101, "chapter_id": 3266, "verse_number": "१५-४-१८", "content_sanskrit": "ततः परिषदो मध्ये युयुधानो मदोत्कटः।\nअब्रवीत्कृतवर्माणमवहास्यावमत्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2105102, "chapter_id": 3266, "verse_number": "१५-४-१९", "content_sanskrit": "कः क्षत्रियो हन्यमानः सुप्तान्हन्यान्मृतानिव।\nतन्न मृष्यन्ति हार्दिक्य यादवा यत्त्वया कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2105103, "chapter_id": 3266, "verse_number": "१५-४-२०", "content_sanskrit": "इत्युक्ते युयुधानेन पूजयामास तद्वचः।\nप्रद्युम्नो रथिनांश्रेष्ठो हार्दिक्यमवमत्य व॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2105104, "chapter_id": 3266, "verse_number": "१५-४-२१", "content_sanskrit": "ततः परमसंक्रुद्धः कृतवर्मा तमब्रवीत्।\nनिर्दिशन्निव सावज्ञं तदा सव्येन पाणिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2105105, "chapter_id": 3266, "verse_number": "१५-४-२२", "content_sanskrit": "भूरिश्रवाश्छिन्नबाहुर्युर्द्धे प्रायगतस्त्वया।\nवधेन सुनृशंसेन कथं वीरेण पातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2105106, "chapter_id": 3266, "verse_number": "१५-४-२३", "content_sanskrit": "इति तस्य वचः श्रुत्वा केशवः परवीरहा।\nतिर्यक्सरोषया दृष्ट्या वीक्षांचक्रे स मन्युमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2105107, "chapter_id": 3266, "verse_number": "१५-४-२४", "content_sanskrit": "मणिः स्यमन्तकश्चैव यः स सत्राजितोऽभवत्।\nतां कथां श्रावयामास सात्यकिर्मधुसूदनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2105108, "chapter_id": 3266, "verse_number": "१५-४-२५", "content_sanskrit": "तच्छ्रुत्वा केशवस्याङ्कमगमद्रुदती तदा।\nसत्यभामा प्रकुपिता कोपयन्ती जनार्दनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2105109, "chapter_id": 3266, "verse_number": "१५-४-२६", "content_sanskrit": "तत उत्थाय सक्रोधः सात्यकिर्वाक्यमब्रवीत्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2105110, "chapter_id": 3266, "verse_number": "१५-४-२७", "content_sanskrit": "पञ्चानां द्रौपदेयानां धृष्टद्युम्नशिखण्डिनोः।\nएष गच्छामि पदवीं सत्येन च तथा शपे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2105111, "chapter_id": 3266, "verse_number": "१५-४-२८", "content_sanskrit": "सौप्तिके ये च निहताः सुप्ता येन दुरात्मना।\nद्रोणपुत्रसहायेन पापेन कृतवर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2105112, "chapter_id": 3266, "verse_number": "१५-४-२९", "content_sanskrit": "समाप्तमायुरस्याद्य यशश्चैव सुमध्यते।\nइत्येवमुक्त्वा खङ्गेन केशवस्य समीपतः।\nअभिद्रुत्य शिरः क्रुद्धश्चिच्छेद कृतवर्मणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2105113, "chapter_id": 3266, "verse_number": "१५-४-३०", "content_sanskrit": "तथाऽन्यानपि निघ्नन्तं युयुधानं समन्ततः।\nअभ्यधावद्धृषीकेशो विनिवारयितुं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2105114, "chapter_id": 3266, "verse_number": "१५-४-३१", "content_sanskrit": "एकीभूतास्ततः सर्वे कालपर्यायचोदिताः।\nभोजान्धका महाराज शैनेयं पर्यवारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2105115, "chapter_id": 3266, "verse_number": "१५-४-३२", "content_sanskrit": "तान्दृष्ट्वा पततस्तूर्णमभिक्रुद्धाञ्जनार्दनः।\nन चुक्रोध महातेजा जानन्कालस्य पर्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2105116, "chapter_id": 3266, "verse_number": "१५-४-३३", "content_sanskrit": "ते तु पानमदाविष्टाश्चोदिताः कालधर्मणा।\nयुयुधानमथाभ्यघ्नन्नुच्छिष्टैर्भाजनैस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2105117, "chapter_id": 3266, "verse_number": "१५-४-३४", "content_sanskrit": "हन्यमाने तु शैनेये क्रुद्धो रुक्मिणिनन्दनः।\nतदनन्तरमागच्छन्मोचयिष्यञ्शिनेः सुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2105118, "chapter_id": 3266, "verse_number": "१५-४-३५", "content_sanskrit": "स भोजैः सह संयुक्तः सात्यकिश्चान्धकैः सह।\nव्यायच्छमानौ तौ वीरौ बाहुद्रविणशालिनौ।\nबहुत्वान्निहतौ तत्र उभौ कुष्णस्य पश्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2105119, "chapter_id": 3266, "verse_number": "१५-४-३६", "content_sanskrit": "हतं दृष्ट्वा च शैनेयं पुत्रं च यदुनन्दनः।\nएरकाणां ततो मुष्टिं कोपाज्जग्राह केशवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2105120, "chapter_id": 3266, "verse_number": "१५-४-३७", "content_sanskrit": "तदभून्मुसलं घोरं वज्रकल्पमयोमयम्।\nजघान कुष्णस्तांस्तेनि येये प्रमुखतोऽभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2105121, "chapter_id": 3266, "verse_number": "१५-४-३८", "content_sanskrit": "ततोऽन्धकाश्च भोजाश्च शैनेया वृष्णयस्तथा।\nजघ्नुरन्योन्यमाक्रन्दे मुसलैः कालचोदिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2105122, "chapter_id": 3266, "verse_number": "१५-४-३९", "content_sanskrit": "यस्तेषामेरकां कश्चिज्जग्राह कुपितो नृपः।\nवज्रभूतेव सा राजन्नदृश्यत तदा विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2105123, "chapter_id": 3266, "verse_number": "१५-४-४०", "content_sanskrit": "तृणं च मुसलीभूतमपि तत्र व्यदृश्यत।\nब्रह्मदण्डकृतं सर्वमिति तद्विद्वि पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2105124, "chapter_id": 3266, "verse_number": "१५-४-४१", "content_sanskrit": "आविध्याविध्य ते राजन्प्रहरन्ति स्म तैस्तृणैः।\nतद्वज्रभूतं मुसलं व्यदृश्यत तदा दृढम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2105125, "chapter_id": 3266, "verse_number": "१५-४-४२", "content_sanskrit": "अवधीत्पितरं पुत्रः पिता पुत्रं च भारत।\nमत्ताः परिपतन्ति स्म योधयन्तः परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2105126, "chapter_id": 3266, "verse_number": "१५-४-४३", "content_sanskrit": "पतङ्गा इव चाग्नौ ते निपेतुः कुकुरान्धकाः।\nनासीत्पलायने बुद्धिर्वधअयमानस्य कस्यचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2105127, "chapter_id": 3266, "verse_number": "१५-४-४४", "content_sanskrit": "तत्रापश्यन्महाबाहुर्जानन्कालस्य पर्ययम्।\nमुसलं समवष्टभ्य तस्थौ स मधुसूदनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2105128, "chapter_id": 3266, "verse_number": "१५-४-४५", "content_sanskrit": "सांबं च निहतं दृष्ट्वा चारुदेष्णं च माधवः।\nप्रद्युम्नं चानिरुद्धं च ततश्चुक्रोध भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2105129, "chapter_id": 3266, "verse_number": "१५-४-४६", "content_sanskrit": "गदं वीक्ष्य शयानं च भृशं कोपसमन्वितः।\nस निःशेषं तदा चक्रे शार्ङ्गचक्रगंदाधरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2105130, "chapter_id": 3266, "verse_number": "१५-४-४७", "content_sanskrit": "तं निघ्नन्तं महातेजा बभ्रुः परपुरंजयः।\nदारुकश्चैव दाशार्हमूवतुर्यन्निबोध तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2105131, "chapter_id": 3266, "verse_number": "१५-४-४८", "content_sanskrit": "भगवन्निहताः सर्वे त्वया भूयिष्ठशो नराः।\nरामस्य पदमन्विच्छ तत्र गच्छाम यत्र सः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2105132, "chapter_id": 3266, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते मौसलपर्वणि चतुर्थोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]