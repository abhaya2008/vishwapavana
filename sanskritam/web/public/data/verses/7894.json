[{"id": 33000184, "chapter_id": 7894, "verse_number": "1", "content_sanskrit": "प्रक्षालयति पल्यूलयति शोधयतीत्यमी । निर्णेनेक्ति पुनातीति धावत्यप्यात्मने त्रयम्‌ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1, "avatarnika": ""}, {"id": 33000185, "chapter_id": 7894, "verse_number": "2", "content_sanskrit": "निङ्क्ते मार्ष्टि च शौचे स्युर्मार्जयत्यपि मार्जति । मज्जत्याप्लवते  स्नाति स्नायत्येतेऽवगाहते  ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2, "avatarnika": ""}, {"id": 33000186, "chapter_id": 7894, "verse_number": "3", "content_sanskrit": "सयुर्मज्जने क्रुडत्येते शुन्धयत्यपि शुन्धति । शुन्धते शुध्यति शुचीभावे स्युरवदायति  ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3, "avatarnika": ""}, {"id": 33000187, "chapter_id": 7894, "verse_number": "4", "content_sanskrit": "उपस्पृशति चाऽऽचामत्यमू आचमनाऽर्थके । अभिवादयते नमति प्रणतावभिवन्दते नमस्यति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4, "avatarnika": ""}, {"id": 33000188, "chapter_id": 7894, "verse_number": "5", "content_sanskrit": "उपसङ्गृह्णात्युपसङ्गृह्णीते प्रणिपतति नमस्कुरुते । अथाऽर्चत्यञ्चति भजत्यपचायति चाऽऽत्मने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5, "avatarnika": ""}, {"id": 33000189, "chapter_id": 7894, "verse_number": "6", "content_sanskrit": "चत्वारि वल्गूयति च सभाजयति मानति । सपर्यत्यर्चयति चाऽऽरान्धोति महयत्यपि  ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6, "avatarnika": ""}, {"id": 33000190, "chapter_id": 7894, "verse_number": "7", "content_sanskrit": "पूजयत्यर्हयति च महत्याराधयत्यपि । मानयत्यञ्चयति चाऽर्हति  यक्षयतेऽर्चने   ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7, "avatarnika": ""}, {"id": 33000191, "chapter_id": 7894, "verse_number": "8", "content_sanskrit": "सम्मन्यते त्वाद्रियते सम्भावयति सूर्क्षति । सत्करोत्यादरेऽपि स्युरुपास्तौ वरिवस्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8, "avatarnika": ""}, {"id": 33000192, "chapter_id": 7894, "verse_number": "9", "content_sanskrit": "शुश्रूषते परिचरत्युपास्ते च द्रवस्यति । यजति त्रिदशाऽर्चायां यजते चोपतिष्ठते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9, "avatarnika": ""}, {"id": 33000193, "chapter_id": 7894, "verse_number": "10", "content_sanskrit": "भिष्णज्यत्युपसेवायां लाडयत्युपसेवते । वासयत्यपि संवाहयति विश्रमयत्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10, "avatarnika": ""}, {"id": 33000194, "chapter_id": 7894, "verse_number": "11", "content_sanskrit": "ददाति निर्वपति च दधात्यपि च दाशति । सनोति दासति दिशत्यात्मने सप्त यच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11, "avatarnika": ""}, {"id": 33000195, "chapter_id": 7894, "verse_number": "12", "content_sanskrit": "अपवर्जयति स्पर्शयति विश्राणयत्यपि । वितरत्यर्पयति च चणत्यतिसृजत्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12, "avatarnika": ""}, {"id": 33000196, "chapter_id": 7894, "verse_number": "13", "content_sanskrit": "ददते राति शणति प्रतिपादयतीति च । दाने विलभते भ्राजयति श्रणति लाति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13, "avatarnika": ""}, {"id": 33000197, "chapter_id": 7894, "verse_number": "14", "content_sanskrit": "स्वधाकरोत्यात्मने द्वौ पितृभ्यो निर्वपत्यपि । विक्षिपत्यात्मनेऽपि स्याद्‌ विक्षेपे विकिरत्यपि  ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14, "avatarnika": ""}, {"id": 33000198, "chapter_id": 7894, "verse_number": "15", "content_sanskrit": "प्रक्षिप्यति प्रक्षिपति मिनोत्यप्यात्मने द्वयम्‌ । प्रक्षेपे पर्थयति च हविर्दाने जुहोत्यदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15, "avatarnika": ""}, {"id": 33000199, "chapter_id": 7894, "verse_number": "16", "content_sanskrit": "स्वाहावौषड्वषड्भ्यश्च करोति कुरुते पदे । प्रीणाति प्रयति द्वावप्यात्मनेऽवति तर्पति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16, "avatarnika": ""}, {"id": 33000200, "chapter_id": 7894, "verse_number": "17", "content_sanskrit": "पृणाति प्रीणयति च जिन्वत्यपि च हिन्वति । धिनोति धिन्वति ध्रायतीत्यादीनि च तर्पणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17, "avatarnika": ""}, {"id": 33000201, "chapter_id": 7894, "verse_number": "18", "content_sanskrit": "केतयत्यामन्त्रयते निमन्त्रयत इत्यपि । आमन्त्रणे ग्रामयति कुणयत्यपि पञ्चकम्‌ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18, "avatarnika": ""}, {"id": 33000202, "chapter_id": 7894, "verse_number": "19", "content_sanskrit": "धापयत्यात्मनेऽपि द्वौ धापने पाययत्यमू | चूषयत्यादयोऽप्यत्र स्युरथो परिवेषणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19, "avatarnika": ""}, {"id": 33000203, "chapter_id": 7894, "verse_number": "20", "content_sanskrit": "परिवेवेष्टि परिवेविष्टे यामयति त्रयम्‌ । आदयत्यात्मनेऽप्येतद्‌ भोजयत्यादि भोजने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20, "avatarnika": ""}, {"id": 33000204, "chapter_id": 7894, "verse_number": "21", "content_sanskrit": "पृणाति पूरयति च पिपर्ति प्राति पूर्वति। पारयत्युम्भति तथा पर्वत्युभति मर्वति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21, "avatarnika": ""}, {"id": 33000205, "chapter_id": 7894, "verse_number": "22", "content_sanskrit": "तूणयत्याप्याययति पूरणे स्युर्भृणाति च । आह्लादते मृडति च मृणाति सुखयत्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22, "avatarnika": ""}, {"id": 33000206, "chapter_id": 7894, "verse_number": "23", "content_sanskrit": "पृडत्येवं मदयति मृडयत्यादि तोषणे । इज्याऽऽरम्भे दीक्षते च जपतीति जपे तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23, "avatarnika": ""}, {"id": 33000207, "chapter_id": 7894, "verse_number": "24", "content_sanskrit": "जञ्जप्यते तु जञ्जप्ति कुत्सिते जञ्जपीति च । अभुक्तौ तूपवसति लङ्घते व्रतयत्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24, "avatarnika": ""}, {"id": 33000208, "chapter_id": 7894, "verse_number": "25", "content_sanskrit": "तपस्यति श्राम्यति च तप्यते च तपःकृतौ । मुण्डति मुण्डयति च मौण्ड्ये वापयतीति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25, "avatarnika": ""}, {"id": 33000209, "chapter_id": 7894, "verse_number": "26", "content_sanskrit": "मद्राकरोत्यात्मनेऽपि द्वयं भद्राकरोति च । उपेक्षत उदास्ते च पदे माध्यस्थ्यवाचिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26, "avatarnika": ""}, {"id": 33000210, "chapter_id": 7894, "verse_number": "27", "content_sanskrit": "स्युर्विरज्यत्युपरमत्यात्मने विरमत्यमी । उपशाम्यति वैराग्ये मोक्षते च मुमुक्षते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27, "avatarnika": ""}, {"id": 33000211, "chapter_id": 7894, "verse_number": "28", "content_sanskrit": "परिव्रजति सन्न्यासे सन्न्यस्यत्यात्मनेऽप्यदः । ब्रह्मीभवति कैवल्ये मुच्यते चाऽपवृज्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28, "avatarnika": ""}]