[{"id": 2183668, "chapter_id": 4898, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2183669, "chapter_id": 4898, "verse_number": "१", "content_sanskrit": "राजा राज्यमनुप्राप्य दुर्बलो भरतर्षभ ।\nअमित्रस्यातिवृद्धस्य कथं तिष्ठेदसाधनः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2183670, "chapter_id": 4898, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2183671, "chapter_id": 4898, "verse_number": "२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nसरितां चैव संवादं सागरस्य च भारत\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2183672, "chapter_id": 4898, "verse_number": "३", "content_sanskrit": "सुरारिनिलयः शश्वत् सागरः सरितां पतिः ।\nपप्रच्छ सरितः सर्वाः संशयं जातमात्मनः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2183673, "chapter_id": 4898, "verse_number": "४", "content_sanskrit": "समूलशाखान् पश्यामि निहतान् क्वाथिनो द्रुमान् ।\nयुग्माभिरिह पूर्णाभिरन्यांस्तत्र न वेतसम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2183674, "chapter_id": 4898, "verse_number": "५", "content_sanskrit": "अकायश्चाल्पसारश्च वेतसः कूलजश्च वः ।\nअवज्ञाय नशक्यो वा किञ्चिद् वा तेन वः कृतम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2183675, "chapter_id": 4898, "verse_number": "६", "content_sanskrit": "तदहं श्रोतुमिच्छामि सर्वासामेव वो मतम् ।\nयथा कूलानि चेमानि भित्त्वा नानीयते वशम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2183676, "chapter_id": 4898, "verse_number": "७", "content_sanskrit": "ततः प्राह नदी गङ्गा वाक्यमुत्तरमर्थवत् ।\nहेतुमद् ग्राहकं चैव सागरं सरितां पतिम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2183677, "chapter_id": 4898, "verse_number": "८", "content_sanskrit": "तिष्ठन्त्येते यथास्थानं नगा ह्येकनिकेतनाः ।\nततस्त्यजन्ति तत् स्थानं प्रातिलोम्यादचेतसः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2183678, "chapter_id": 4898, "verse_number": "९", "content_sanskrit": "वेतसो वेगमायान्तं दृष्ट्वा नमति नेतरः ।\nस च वेगेऽभ्यतिक्रान्ते स्थानमासाद्य तिष्ठति\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2183679, "chapter_id": 4898, "verse_number": "१०", "content_sanskrit": "कालज्ञः समयज्ञश्च सदा वश्यश्च यो द्रुमः ।\nअनुलोमस्तथाऽस्तब्धस्तेन नात्येति वेतसः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2183680, "chapter_id": 4898, "verse_number": "११", "content_sanskrit": "मारुतोदकवेगेन ये नमन्त्युन्नमन्ति च ।\nओषध्यः पादपा गुल्मा न ते यान्ति पराभवम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2183681, "chapter_id": 4898, "verse_number": "१२", "content_sanskrit": "यो हि शत्रोर्विवृद्धस्य प्रभोर्वधविनाशने ।\nपूर्वं न सहते वेगं क्षिप्रमेव स नश्यति\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2183682, "chapter_id": 4898, "verse_number": "१३", "content_sanskrit": "सारासारं बलं वीर्यमात्मनो द्विषतश्च यः ।\nजानन् विचरति प्राज्ञो न स याति पराभवम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2183683, "chapter_id": 4898, "verse_number": "१४", "content_sanskrit": "एवमेव यदा विद्वान् मन्येतातिबलं रिपुम् ।\nसंश्रयेद् वैतसीं वृत्तिमेवं प्रज्ञानलक्षणम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2183684, "chapter_id": 4898, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि राजधर्मे पञ्चदशाधिकशततमोध्यायः ॥ ११५ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]