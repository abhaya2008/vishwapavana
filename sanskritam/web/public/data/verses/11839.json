[{"id": 50024207, "chapter_id": 11839, "verse_number": "1", "content_sanskrit": "॥ मधुच्छन्दा वैश्वामित्रः। इन्द्रः। गायत्री॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50024208, "chapter_id": 11839, "verse_number": "2", "content_sanskrit": "एन्द्र॑ सान॒सिं र॒यिं स॒जित्वा॑नं सदा॒सह॑म्। वर्षि॑ष्ठमू॒तये॑ भर॥ ८/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50024209, "chapter_id": 11839, "verse_number": "3", "content_sanskrit": "नि येन॑ मुष्टिह॒त्यया॒ नि वृ॒त्रा रु॒णधा॑महै। त्वोता॑सो॒ न्यर्व॑ता॥ ८/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50024210, "chapter_id": 11839, "verse_number": "4", "content_sanskrit": "इन्द्र॒ त्वोता॑स॒ आ व॒यं वज्रं॑ घ॒ना द॑दीमहि। जये॑म॒ सं यु॒धि स्पृध॑ः॥ ८/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50024211, "chapter_id": 11839, "verse_number": "5", "content_sanskrit": "व॒यं शूरे॑भि॒रस्तृ॑भि॒रिन्द्र॒ त्वया॑ यु॒जा व॒यम्। सा॒स॒ह्याम॑ पृतन्य॒तः॥ ८/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50024212, "chapter_id": 11839, "verse_number": "6", "content_sanskrit": "म॒हाँ इन्द्र॑ः प॒रश्च॒ नु म॑हि॒त्वम॑स्तु व॒ज्रिणे॑। द्यौर्न प्र॑थि॒ना शव॑ः॥ ८/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50024213, "chapter_id": 11839, "verse_number": "7", "content_sanskrit": "स॒मो॒हे वा॒ य आश॑त॒ नर॑स्तो॒कस्य॒ सनि॑तौ। विप्रा॑सो वा धिया॒यव॑ः॥ ८/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50024214, "chapter_id": 11839, "verse_number": "8", "content_sanskrit": "यः कु॒क्षिः सो॑म॒पात॑मः समु॒द्र इ॑व॒ पिन्व॑ते। उ॒र्वीरापो॒ न का॒कुद॑ः॥ ८/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50024215, "chapter_id": 11839, "verse_number": "9", "content_sanskrit": "ए॒वा ह्य॑स्य सू॒नृता॑ विर॒प्शी गोम॑ती म॒ही। प॒क्वा शाखा॒ न दा॒शुषे॑॥ ८/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50024216, "chapter_id": 11839, "verse_number": "10", "content_sanskrit": "ए॒वा हि ते॒ विभू॑तय ऊ॒तय॑ इन्द्र॒ माव॑ते। स॒द्यश्चि॒त्सन्ति॑ दा॒शुषे॑॥ ८/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50024217, "chapter_id": 11839, "verse_number": "11", "content_sanskrit": "ए॒वा ह्य॑स्य॒ काम्या॒ स्तोम॑ उ॒क्थं च॒ शंस्या॑। इन्द्रा॑य॒ सोम॑पीतये॥ ८/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}]