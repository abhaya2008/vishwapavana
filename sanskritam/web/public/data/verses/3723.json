[{"id": 2127006, "chapter_id": 3723, "verse_number": "", "content_sanskrit": "बृहदश्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2127007, "chapter_id": 3723, "verse_number": "१", "content_sanskrit": "श्रुत्वा वचः सुदेवस्य ऋतुपर्णो जनाधिपः ।\nसान्त्वयन् श्लक्ष्णया वाचा बाहुकं प्रत्यभाषत\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2127008, "chapter_id": 3723, "verse_number": "२", "content_sanskrit": "विदर्भान् यातुमिच्छामि दमयन्त्याःस्वयंवरम् ।\nएकाह्ना हयतत्त्वज्ञ मन्यसे यदि बाहुक \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2127009, "chapter_id": 3723, "verse_number": "३", "content_sanskrit": "एवमुक्तस्य कौन्तेय तेन राज्ञा नळस्य ह ।\nव्यदीर्यत मनो दुःखात् प्रदध्यौ च महायशाः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2127010, "chapter_id": 3723, "verse_number": "", "content_sanskrit": "नळः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2127011, "chapter_id": 3723, "verse_number": "४", "content_sanskrit": "दमयन्ती भवेदेतत् कुर्याद् दुःखेन मोहिता ।\nअस्मदर्थं भवेद्वाऽयमुपायश्चिन्तितो महान्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2127012, "chapter_id": 3723, "verse_number": "५", "content_sanskrit": "नृशंसं सा तु वैदर्भी कर्तुकामा यशस्विनी ।\nमया क्षुद्रेण निकृता पापेनाकृतबुद्धिना ।\nस्त्रीस्वभावश्चलो लोके मम दोषश्च दारुणः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2127013, "chapter_id": 3723, "verse_number": "६", "content_sanskrit": "स्यादेवमपि कुर्यात् सा विवशा गतसौहृदा ।\nमम दोषेण संविग्ना नैराश्यात् तनुमध्यमा \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2127014, "chapter_id": 3723, "verse_number": "७", "content_sanskrit": "न चैवं कर्हिचित् कुर्यात् सापत्या च विशेषतः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2127015, "chapter_id": 3723, "verse_number": "८", "content_sanskrit": "यदत्र तथ्यं च पुनर्गत्वा वेत्स्यामि निश्चयम् ।\nऋतुपर्णस्य वै काममात्मार्थं च करोम्यहम् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2127016, "chapter_id": 3723, "verse_number": "समाप्तिः", "content_sanskrit": "इति निश्चित्य मनसा बाहुको दीनमानसः ।\nकृताञ्जलिरुवाचेदमृतुपर्णं नराधिपम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2127017, "chapter_id": 3723, "verse_number": "१०", "content_sanskrit": "प्रतिजानामि ते सत्यं गमिष्यसि नराधिप ।\nएकाह्ना पुरुषव्याघ्र विदर्भनगरीं ध्रुवम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2127018, "chapter_id": 3723, "verse_number": "११", "content_sanskrit": "एवमुक्तोऽब्रवीद् राजा बाहुकं हृष्टमानसः ।\nयद्येवं भविता श्वो वै कं ते कामं करोम्यहम् ।\nप्रतिगृह्णामि ते वाक्यं सर्वं कामं करोम्यहम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2127019, "chapter_id": 3723, "verse_number": "१२", "content_sanskrit": "ततः परीक्षामश्वानां चक्रे राज्ञः स बाहुकः ।\nअश्वशालामुपागम्य भार्गस्वरिनृपाज्ञया\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2127020, "chapter_id": 3723, "verse_number": "१३", "content_sanskrit": "स त्वर्यमाणो बहुश ऋतुपर्णेन बाहुकः ।\nअध्यगच्छत् कृशानश्वान् सुवेगानध्वनि क्षमान् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2127021, "chapter_id": 3723, "verse_number": "१४", "content_sanskrit": "तेजोबलसमायुक्तान् कुलशीलसमन्वितान् ।\nवर्जिताँल्लक्षणैर्हीनैः पृथुप्रोथान् महाहनून्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2127022, "chapter_id": 3723, "verse_number": "१५", "content_sanskrit": "शुद्धान् दशभिरावर्तैः सिन्धुजान् वातरंहसः ।\nदृश्यमानान् कृशानङ्गैर्जवेनाप्रतिमान् पथि\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2127023, "chapter_id": 3723, "verse_number": "१६", "content_sanskrit": "दृष्ट्वा तानब्रवीद् राजा किञ्चित् कोपसमन्वितः ।\nकिमिदं प्रार्थितं कर्तुं प्रलब्धव्या हि ते वयम् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2127024, "chapter_id": 3723, "verse_number": "१७", "content_sanskrit": "कथमल्पबलप्राणा वक्ष्यन्तीमे हया रथम् ।\nमहान्तमपि चाध्वानं गन्तव्यं कथमीदृशैः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2127025, "chapter_id": 3723, "verse_number": "", "content_sanskrit": "बाहुकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2127026, "chapter_id": 3723, "verse_number": "", "content_sanskrit": "एते हया गमिष्यन्ति विदर्भान् नात्र संशयः ।\nअश्वानन्यान् मन्यसे राजन् ब्रूहि कान् योजयामि ते\t॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2127027, "chapter_id": 3723, "verse_number": "१९", "content_sanskrit": "त्वमेव हयतत्त्वज्ञः कुशलश्चासि बाहुक ।\nयान् मन्यसे समर्थांस्त्वं क्षिप्रं तानेव योजय\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2127028, "chapter_id": 3723, "verse_number": "२०", "content_sanskrit": "ततस्सदश्वांश्चतुरः कुलशीलसमन्वितान् ।\nयोजयामास कुशलो जवयुक्तान् रथे नळः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2127029, "chapter_id": 3723, "verse_number": "२१", "content_sanskrit": "ततो युक्तं रथं राजा समारोहत् त्वरान्वितः ।\nअथ पर्यपतन् राजन् जानुभिस्ते हयोत्तमाः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2127030, "chapter_id": 3723, "verse_number": "२२", "content_sanskrit": "ततो नरवरःश्रीमान् नळो राजा विशांपते ।\nसान्त्वयामास तानश्वांस्तेजोबलसमन्वितान् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2127031, "chapter_id": 3723, "verse_number": "२३", "content_sanskrit": "रश्मिभिश्च समुद्यम्य नळो यातुमियेष सः ।\nसूतमारोप्य वार्ष्णेयं जवमास्थाय वै परम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2127032, "chapter_id": 3723, "verse_number": "२४", "content_sanskrit": "ते चोद्यमाना बहुधा बाहुकेन हयोत्तमाः ।\nसमुत्पेतुरिवाकाशं रथिनं मोहयन्ति च \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2127033, "chapter_id": 3723, "verse_number": "२५", "content_sanskrit": "तथा तु दृष्ट्वा तानश्वान् वहतो वातरंहसः ।\nअयोध्याधिपतिः श्रीमान् विस्मयं परमं ययौ\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2127034, "chapter_id": 3723, "verse_number": "२६", "content_sanskrit": "रथघोषं च तं श्रुत्वा हयानां ग्रहणं च तत् ।\nवार्ष्णेयश्चिन्तयामास बाहुकस्य हयज्ञताम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2127035, "chapter_id": 3723, "verse_number": "२७", "content_sanskrit": "किं नु स्यान्मातलिरयं देवराजस्य सारथिः ।\nतथा हि लक्षणं वीरे बाहुके दृश्यते महत्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2127036, "chapter_id": 3723, "verse_number": "२८", "content_sanskrit": "शालिहोत्रोऽपि किंनु स्याद्धयानां कुलतत्त्ववित् ।\nमानुषं परमं प्राप्तो वपुः परमशोभनम् \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2127037, "chapter_id": 3723, "verse_number": "२९", "content_sanskrit": "उताहोस्विद् भवेद् राजा नळः परपुरञ्जयः ।\nसोऽयं नृपतिरायात इत्येवं समचिन्तयत्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2127038, "chapter_id": 3723, "verse_number": "३०", "content_sanskrit": "अथवाऽयं नळाद् वेद विद्यां तामेव बाहुकः ।\nतुल्यं हि लक्षये ज्ञानं बाहुकस्य नळस्य च\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2127039, "chapter_id": 3723, "verse_number": "३१", "content_sanskrit": "अपि चेदं वचस्तुल्यमस्य मन्ये नळस्य च ।\nनयोयं नळो महावीर्यस्तद्विद्यश्च भविष्यति\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2127040, "chapter_id": 3723, "verse_number": "३२", "content_sanskrit": "प्रच्छन्ना हि महात्मानः चरन्ति पृथिवीमिमाम् ।\nदैवेन विधिना युक्तः शक्ताश्चैव विरूपिणः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2127041, "chapter_id": 3723, "verse_number": "३३", "content_sanskrit": "भवेत्तु मतिभेदो मे गात्रवैरूप्यकं प्रति ।\nप्रमाणात् परिहीनस्तु भवेदिति हि मे मतिः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2127042, "chapter_id": 3723, "verse_number": "३४", "content_sanskrit": "वयःप्रमाणं तत्तुल्यं रूपेण तु विपर्ययः ।\nनळं सर्वगुणैर्युक्तं मन्ये बाहुकमन्ततः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2127043, "chapter_id": 3723, "verse_number": "३५", "content_sanskrit": "एवं विचार्य बहुशो वार्ष्णेयः पर्यचिन्तयत् ।\nहृदयेन महाराज पुण्यश्लोकस्य सारथिः \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2127044, "chapter_id": 3723, "verse_number": "३६", "content_sanskrit": "ऋतुपर्णस्तु दृष्ट्वैव बाहुकस्य हयज्ञताम् ।\nचिन्तयन् मुमुदे वीरः सहवार्ष्णेयसारथिः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2127045, "chapter_id": 3723, "verse_number": "३७", "content_sanskrit": "बलं शौर्यं तथोत्साहं हयनां ग्रहणं च तत् ।\nपरं यत्नं च सम्प्रेक्ष्य परां मुदमवाप सः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2127046, "chapter_id": 3723, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nवनपर्वणि पञ्चषष्टितमोऽध्यायः ॥६५॥\n॥ तीर्थयात्रापर्वणि एकविंशोऽध्यायः ॥२१॥\n—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]