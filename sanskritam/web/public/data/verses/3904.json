[{"id": 2134511, "chapter_id": 3904, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2134512, "chapter_id": 3904, "verse_number": "१", "content_sanskrit": "मार्कण्डेयादिभिर्विप्रैः पाण्डवैश्च महात्मभिः ।\nकथाभिरनुकूलाभिः सह स्थित्वा जनार्दनः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2134513, "chapter_id": 3904, "verse_number": "२", "content_sanskrit": "ततस्तैः संविदं कृत्वा यथावन्मधुसूदनः ।\nआरुरुक्षू रथं सत्यामाह्वयामास केशवः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2134514, "chapter_id": 3904, "verse_number": "३", "content_sanskrit": "सत्यभामा ततस्तत्र स्वजित्वा द्रुपदात्मजाम् ।\nउवाच वचनं हृद्यं यथाभावं समाहिता \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2134515, "chapter_id": 3904, "verse_number": "४", "content_sanskrit": "कृष्णे मा भूत् तवोत्कण्ठा मा व्यथा मा प्रजागरः ।\nभर्तृभिर्देवसङ्काशैर्जितां प्राप्स्यसि मेदिनीम् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2134516, "chapter_id": 3904, "verse_number": "५", "content_sanskrit": "न ह्येवं शीलसम्पन्ना नैवं पूजितलक्षणाः ।\nप्राप्नुवन्ति चिरं क्लेशं यथा त्वमसितेक्षणे \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2134517, "chapter_id": 3904, "verse_number": "६", "content_sanskrit": "अवश्यं च त्वया भूमिरियं निहतकण्टका ।\nभर्तृभिः सह भोक्तव्या निर्द्वन्द्वेति श्रुतं मया \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2134518, "chapter_id": 3904, "verse_number": "७", "content_sanskrit": "धार्तराष्ट्रवधं कृत्वा वैराणि प्रतियात्य च ।\nयुधिष्ठिरस्थां पृथिवीं द्रक्ष्यसि द्रुपदात्मजे \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2134519, "chapter_id": 3904, "verse_number": "८", "content_sanskrit": "यास्ताः प्रव्रजमानां त्वां प्राहसन् दर्पमोहिताः ।\nताः क्षिप्रं हतसङ्कल्पा द्रक्ष्यसि त्वं कुरुस्त्रियः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2134520, "chapter_id": 3904, "verse_number": "९", "content_sanskrit": "तव दुःखोपपन्नाया यैराचरितमप्रियम् ।\nविद्धि सम्प्रस्थितान् सर्वांस्तान् कृष्णे यमसादनम् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2134521, "chapter_id": 3904, "verse_number": "", "content_sanskrit": "ये च तत्र स्थिता राज्ञि तत्पक्षीयाः क्षितीश्वराः ।\nतेषां कालः क्षितीशानां प्राप्तः कृष्णे दुरासदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2134522, "chapter_id": 3904, "verse_number": "१०", "content_sanskrit": "पुत्रस्ते प्रतिविन्ध्यश्च सुतसोमस्तथाविधः ।\nश्रुतकर्मार्जुनिश्चैव शतानीकश्च नाकुलिः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2134523, "chapter_id": 3904, "verse_number": "११", "content_sanskrit": "सहदेवाच्च यो जातः श्रुतसेनस्तवात्मजः ।\nसर्वे कुशलिनो वीराः कृतास्त्राश्च सुतास्तव\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2134524, "chapter_id": 3904, "verse_number": "१२", "content_sanskrit": "अभिमन्युरिव प्रीता द्वारवत्यां रता भृशम् ।\nत्वमिवैषां सुभद्रा च प्रीत्या सर्वात्मना स्थिता \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2134525, "chapter_id": 3904, "verse_number": "१३", "content_sanskrit": "प्रीयते तव निर्द्वन्द्वा तेभ्यश्च विगतज्वरा ।\nदुःखिता तेन दुःखेन सुखेन सुखिता तथा ।\nभजेत् सर्वात्मना चैव प्रद्युम्नजननी तथा \t॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2134526, "chapter_id": 3904, "verse_number": "१४", "content_sanskrit": "भानुप्रभृतिभिश्चैनान् विशिनष्टि च केशवः ।\nभोजनाच्छादने चैषां नित्यं मे श्वशुरः स्थितः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2134527, "chapter_id": 3904, "verse_number": "१५", "content_sanskrit": "रामप्रभृतयः सर्वे भजन्त्यन्धकवृष्णयः ।\nतुल्यो हि प्रणयस्तेषां प्रद्युम्नस्य च भामिनि \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2134528, "chapter_id": 3904, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2134529, "chapter_id": 3904, "verse_number": "१६", "content_sanskrit": "एवमादि प्रियं सत्यं हृद्यमुक्त्वा मनोऽनुगम् ।\nगमनाय मनश्चक्रे वासुदेवरथं प्रति \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2134530, "chapter_id": 3904, "verse_number": "१७", "content_sanskrit": "तां कृष्णां कृष्णमहिषी चकाराभिप्रदक्षिणम्।\nआरुरोह रथं शौरेः सत्यभामाथ भाविनी \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2134531, "chapter_id": 3904, "verse_number": "१८", "content_sanskrit": "स्मयित्वा तु यदुश्रेष्ठो द्रौपदीं परिसान्त्व्य च ।\nउपावर्त्य ततः शीघ्रैर्हयैः प्रायात् पुरं स्वकम् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2134532, "chapter_id": 3904, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि चतुर्विंशत्यधिकद्विशततमोऽध्यायः ॥२२४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2134533, "chapter_id": 3904, "verse_number": "", "content_sanskrit": "॥ द्रौपदीसत्यभामासंवादपर्वणि तृतीयोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2134534, "chapter_id": 3904, "verse_number": "", "content_sanskrit": "॥ समाप्तं द्रौपदीसत्यभामासंवादपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]