[{"id": 2150288, "chapter_id": 4259, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2150289, "chapter_id": 4259, "verse_number": "१", "content_sanskrit": "कथं शिखण्डी गाङ्गेय कन्या भूत्वा सती तदा ।\nपुरुषोऽभूद् युधिश्रेष्ठ तन्मे ब्रूहि पितामह\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2150290, "chapter_id": 4259, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2150291, "chapter_id": 4259, "verse_number": "२", "content_sanskrit": "भार्या तु तस्य राजेन्द्र द्रुपदस्य महीपतेः ।\nमहिषी दयिता ह्यासीदपुत्रा च विशाम्पते\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2150292, "chapter_id": 4259, "verse_number": "३", "content_sanskrit": "एतस्मिन्नेव काले तु द्रुपदो वै महीपतिः ।\nअपत्यार्थे महाराज तोषयामास शङ्करम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2150293, "chapter_id": 4259, "verse_number": "४", "content_sanskrit": "अस्मद्वधार्थं निश्चित्य तपो घोरं समास्थितः ।\nलेभे कन्यां महादेवात् पुरुषो मे स्यादिति ब्रुवन्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2150294, "chapter_id": 4259, "verse_number": "५", "content_sanskrit": "भगवन् पुत्रमिच्छामि भीष्मप्रतिचिकीर्षया ।\nइत्युक्तो देवदेवेन स्त्री पुमांस्ते भविष्यति\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2150295, "chapter_id": 4259, "verse_number": "६", "content_sanskrit": "निवर्तस्व महीपाल नैतज्जात्वन्यथा भवेत् ।\nस तु गत्वा च नगरं भार्यामिदमुवाच ह\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2150296, "chapter_id": 4259, "verse_number": "७", "content_sanskrit": "कृतो यत्नो मया देवि पुत्रार्थं तपसा महान् ।\nकन्या भूत्वा पुमान् भावी इति चोक्तोऽस्मि शम्भुना\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2150297, "chapter_id": 4259, "verse_number": "८", "content_sanskrit": "पुनः पुनर्याच्यमानो दिष्टमित्यब्रवीच्छिवः ।\nन तदन्यच्च भविता भवितव्यं हि तत् तथा\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2150298, "chapter_id": 4259, "verse_number": "९", "content_sanskrit": "ततः सा नियता भूत्वा ऋतुकाले मनस्विनी ।\nप्रत्नी द्रुपदराजस्य द्रुपदं प्रविवेश ह\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2150299, "chapter_id": 4259, "verse_number": "१०", "content_sanskrit": "लेभे गर्भं यथाकालं विधिदृष्टेन हेतुना ।\nपार्षतस्य महीपाल यथा मां नारदोऽब्रवीत्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2150300, "chapter_id": 4259, "verse_number": "११", "content_sanskrit": "ततो दधार सा देवी गर्भं राजीवलोचना\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2150301, "chapter_id": 4259, "verse_number": "१२", "content_sanskrit": "तां स राजप्रियां भार्यां द्रुपदः कुरुनन्दन ।\nपुत्रस्नेहान्महाबाहुः सुखं पर्यचरत् तदा\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2150302, "chapter_id": 4259, "verse_number": "१३", "content_sanskrit": "सर्वानभिप्रायगतान् भार्याऽलभत कौरव ।\nअपुत्रस्य सतो राज्ञो द्रुपदस्य यशस्विनः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2150303, "chapter_id": 4259, "verse_number": "१४", "content_sanskrit": "यथाकालं तु सा देवी महिषी द्रुपदस्य ह ।\nकन्यां प्रवररूपां तु प्राजायत नराधिप\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2150304, "chapter_id": 4259, "verse_number": "१५", "content_sanskrit": "अपुत्रस्य तु राज्ञः सा द्रुपदस्य मनस्विनी ।\nख्यापयामास राजेन्द्र पुत्रो ह्येष ममेति वै\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2150305, "chapter_id": 4259, "verse_number": "१६", "content_sanskrit": "ततः स राजा द्रुपदः प्रच्छन्नाया नराधिप ।\nपुत्रवत् पुत्रकार्याणि सर्वाणि समकारयत्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2150306, "chapter_id": 4259, "verse_number": "१७", "content_sanskrit": "रक्षणं चैव मन्त्रस्य महिषी द्रुपदस्य सा ।\nचकार सर्वयत्नेन ब्रुवाणा पुत्र इत्युत\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2150307, "chapter_id": 4259, "verse_number": "१८", "content_sanskrit": "न हि तां वेद नगरे कश्चिदन्यत्र पार्षतात्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2150308, "chapter_id": 4259, "verse_number": "१९", "content_sanskrit": "श्रद्दधानो हि तद्वाक्यं देवस्याद्भुतचेतसः ।\nछादयामास तां कन्यां पुमानिति च सोऽब्रवीत्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2150309, "chapter_id": 4259, "verse_number": "२०", "content_sanskrit": "जातकर्माणि सर्वाणि कारयामास पार्थिवः ।\nपुंवद्विधानयुक्तानि शिखण्डीति च तां विदुः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2150310, "chapter_id": 4259, "verse_number": "२१", "content_sanskrit": "अहमेकस्तु चारेण वचनान्नारदस्य ह ।\nज्ञातवान् देववाक्येन अम्बायास्तपसा तथा\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2150311, "chapter_id": 4259, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि नवत्युत्तरशततमोऽध्यायः ॥१९०॥\nअम्बोपाख्यानपर्वणि विंशोऽध्यायः ॥२०॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]