[{"id": 7000392000, "chapter_id": 20392, "verse_number": "२-६४-१", "content_sanskrit": "पिप्पलौवाच ।\nपितुःप्रसादभावाद्वै यदुना सुखमुत्तमम् ।\nकथं प्राप्तं सुभुक्तं च तन्मे विस्तरतो वद॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000392001, "chapter_id": 20392, "verse_number": "२-६४-२", "content_sanskrit": "कस्मात्पापप्रभावं च रुरुर्भुंक्ते द्विजोत्तम ।\nसकलं विस्तरेणापि वद मे कुंडलात्मज॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000392002, "chapter_id": 20392, "verse_number": "२-६४-३", "content_sanskrit": "सुकर्मोवाच ।\nश्रूयतामभिधास्यामि चरित्रं पापनाशनम् ।\nनहुषस्य सुपुण्यस्य ययातेश्च महात्मनः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000392003, "chapter_id": 20392, "verse_number": "२-६४-४", "content_sanskrit": "सोमवंशात्प्रभूतो हि नहुषो मेदिनीपतिः ।\nदानधर्माननेकांश्च चका रह्यतुलानपि॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000392004, "chapter_id": 20392, "verse_number": "२-६४-५", "content_sanskrit": "मखानामश्वमेधानामियाज शतमुत्तमम् ।\nवाजपेयशतं चापि अन्यान्यज्ञाननेकधा॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000392005, "chapter_id": 20392, "verse_number": "२-६४-६", "content_sanskrit": "आत्मनः पुण्यभावेन इंद्रलोकमवाप सः ।\nपुत्रं धर्मगुणोपेतं प्रजापालं चकार सः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000392006, "chapter_id": 20392, "verse_number": "२-६४-७", "content_sanskrit": "ययातिं सत्यसंपन्नं धर्मवीर्यं महामतिम् ।\nएंद्रं पदं गतो राजा तस्य पुत्रः पदे स्वके॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000392007, "chapter_id": 20392, "verse_number": "२-६४-८", "content_sanskrit": "ययातिः सत्यसंपन्नः प्रजा धर्मेण पालयेत् ।\nस्वयमेव प्रपश्येत्स प्रजाकर्माणि तान्यपि॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000392008, "chapter_id": 20392, "verse_number": "२-६४-९", "content_sanskrit": "याजयामास धर्मज्ञः श्रुत्वा धर्ममनुत्तमम् ।\nयज्ञतीर्थादिकं सर्वं दानपुण्यं चकार सः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000392009, "chapter_id": 20392, "verse_number": "२-६४-१०", "content_sanskrit": "राज्यं चकार मेधावी सत्यधर्मेण वै तदा ।\nयावदशीतिसहस्राणि वर्षाणां नृपनंदनः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000392010, "chapter_id": 20392, "verse_number": "२-६४-११", "content_sanskrit": "तावत्कालं गतं तस्य ययातेस्तु महात्मनः ।\nतस्य पुत्राश्च चत्वारस्तद्वीर्यबलविक्रमाः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000392011, "chapter_id": 20392, "verse_number": "२-६४-१२", "content_sanskrit": "तेषां नामानि वक्ष्यामि शृणुष्वैकाग्रमानसः ।\nतस्यासीज्ज्येष्ठपुत्रस्तु रुरुर्नाम महाबलः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000392012, "chapter_id": 20392, "verse_number": "२-६४-१३", "content_sanskrit": "पुरुर्नाम द्वितीयोऽभूत्कुरुश्चान्यस्तृतीयकः ।\nयदुर्नाम स धर्मात्मा चतुर्थो नृपतेः सुतः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000392013, "chapter_id": 20392, "verse_number": "२-६४-१४", "content_sanskrit": "एवं चत्वारः पुत्राश्च ययातेस्तु महात्मनः ।\nतेजसा पौरुषेणापि पितृतुल्यपराक्रमाः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000392014, "chapter_id": 20392, "verse_number": "२-६४-१५", "content_sanskrit": "एवं राज्यं कृतं तेन धर्मेणापि ययातिना ।\nतस्य कीर्तिर्यशो भावस्त्रैलोक्ये प्रचुरोभवत्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000392015, "chapter_id": 20392, "verse_number": "२-६४-१६", "content_sanskrit": "विष्णुरुवाच ।\nएकदा तु द्विजश्रेष्ठो नारदो ब्रह्मनंदनः ।\nएंद्रं लोकं गतो राजन्द्रष्टुं चैव पुरंदरम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000392016, "chapter_id": 20392, "verse_number": "२-६४-१७", "content_sanskrit": "सहस्राक्षस्ततोपश्यद्धुताशनसमप्रभम् ।\nदेवो विप्रं समायांतं सर्वज्ञं ज्ञानपंडितम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000392017, "chapter_id": 20392, "verse_number": "२-६४-१८", "content_sanskrit": "पूजितं मधुपर्काद्यैर्भक्त्या नमितकंधरः ।\nनिवेश्य चासने पुण्ये पप्रच्छ मुनिपुंगवम्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000392018, "chapter_id": 20392, "verse_number": "२-६४-१९", "content_sanskrit": "इंद्र उवाच ।\nकस्मादागमनं तेद्य किमर्थमिह चागतः ।\nकिं ते हि सुप्रियं विप्र करोम्यद्य महामुने॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000392019, "chapter_id": 20392, "verse_number": "२-६४-२०", "content_sanskrit": "नारद उवाच ।\nदेवराज कृतं सर्वं भक्त्या यच्च प्रभाषितम् ।\nसंतुष्टोस्मि महाप्राज्ञ प्रश्नोत्तरं वदाम्यहम्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000392020, "chapter_id": 20392, "verse_number": "२-६४-२१", "content_sanskrit": "महीलोकात्सुसंप्राप्तः सांप्रतं तव मंदिरम् ।\nत्वामन्वेष्टुं समायातो दृष्ट्वा नाहुषमेव च॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000392021, "chapter_id": 20392, "verse_number": "२-६४-२२", "content_sanskrit": "इंद्र उवाच ।\nसत्यधर्मेण को राजा प्रजाः पालयते सदा ।\nसर्वधर्मसमायुक्तः श्रुतवाञ्ज्ञानवान्गुणी॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000392022, "chapter_id": 20392, "verse_number": "२-६४-२३", "content_sanskrit": "पृथिव्यामस्ति को राजा वेदज्ञो ब्राह्मणप्रियः ।\nब्रह्मण्यो वेदविच्छूरो यज्वा दाता सुभक्तिमान्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000392023, "chapter_id": 20392, "verse_number": "२-६४-२४", "content_sanskrit": "नारद उवाच ।\nएभिर्गुणैस्तु संयुक्तो नहुषस्यात्मजो बली ।\nयस्य सत्येन वीर्येण सर्वे लोकाः प्रतिष्ठिताः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000392024, "chapter_id": 20392, "verse_number": "२-६४-२५", "content_sanskrit": "भवादृशो हि भूर्लोके ययातिर्नहुषात्मजः ।\nभवान्स्वर्गे स चैवास्ति भूतले भूतिवर्धनः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000392025, "chapter_id": 20392, "verse_number": "२-६४-२६", "content_sanskrit": "पितुः श्रेष्ठो महाराज ह्यश्वमेधशतं तथा ।\nवाजपेयशतं चक्रे ययातिः पृथिवीपतिः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000392026, "chapter_id": 20392, "verse_number": "२-६४-२७", "content_sanskrit": "दत्तान्यनेकरूपाणि दानानि तेन भक्तितः ।\nगवां लक्षसहस्राणि गवां कोटिशतानि च॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000392027, "chapter_id": 20392, "verse_number": "२-६४-२८", "content_sanskrit": "कोटिहोमांश्चकाराथ लक्षहोमांस्तथैव च ।\nभूमिदानादि दानानि ब्राह्मणेभ्योददाच्च यः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000392028, "chapter_id": 20392, "verse_number": "२-६४-२९", "content_sanskrit": "सर्वं येन स्वरूपं हि धर्मस्य परिपालितम् ।\nएवं गुणैः समायुक्तो ययातिर्नहुषात्मजः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000392029, "chapter_id": 20392, "verse_number": "२-६४-३०", "content_sanskrit": "वर्षाणां तु सहस्राणि अशीतिर्नृपसत्तमः ।\nराज्यं चकार सत्येन यथा दिवि भवानिह॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000392030, "chapter_id": 20392, "verse_number": "२-६४-३१", "content_sanskrit": "सुकर्मोवाच ।\nएवमाकर्ण्य देवेंद्रो नारदात्स मुनीश्वरात् ।\nसमालोच्य स मेधावी संभीतो धर्मपालनात्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000392031, "chapter_id": 20392, "verse_number": "२-६४-३२", "content_sanskrit": "शतयज्ञप्रभावेण नहुषो हि पुरा मम ।\nएंद्रं पदं गतो वीरो देवराजोभवत्पुरा॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000392032, "chapter_id": 20392, "verse_number": "२-६४-३३", "content_sanskrit": "शची बुद्धिप्रभावेण पदभ्रष्टो व्यजायत ।\nतादृशोयं महाराजः पितुस्तुल्यपराक्रमः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000392033, "chapter_id": 20392, "verse_number": "२-६४-३४", "content_sanskrit": "प्राप्स्यते नात्र संदेहः पदमैंद्रं न संशयः ।\nयेन केनाप्युपायेन तं भूपं दिवमानये॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000392034, "chapter_id": 20392, "verse_number": "२-६४-३५", "content_sanskrit": "इत्येवं चिंतयामास तस्माद्भीतः सुरेश्वरः ।\nभूपालस्य नृपश्रेष्ठ ययातेः सुमहद्भयात्॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000392035, "chapter_id": 20392, "verse_number": "२-६४-३६", "content_sanskrit": "तमानेतुं ततो दूतं प्रेषयामास देवराट् ।\nनहुषस्य विमानं तु सर्वकामसमन्वितम्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000392036, "chapter_id": 20392, "verse_number": "२-६४-३७", "content_sanskrit": "सारथिं मातलिं नाम विमानेन समन्वितम् ।\nगतो हि मातलिस्तत्र यत्रास्ते नहुषात्मजः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000392037, "chapter_id": 20392, "verse_number": "२-६४-३८", "content_sanskrit": "प्रहितः सुरराजेन समानेतुं महामतिम् ।\nसभायां वर्त्तमानस्तु यथा इंद्र प्रःशोभते॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000392038, "chapter_id": 20392, "verse_number": "२-६४-३९", "content_sanskrit": "तथा ययातिर्धर्मात्मा स्वसभायां विराजते ।\nतमुवाच महात्मानं राजानं सत्यभूषणम्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000392039, "chapter_id": 20392, "verse_number": "२-६४-४०", "content_sanskrit": "सारथिर्देवराजस्य शृणु राजन्वचो मम ।\nप्रहितो देवराजेन सकाशं तव सांप्रतम्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000392040, "chapter_id": 20392, "verse_number": "२-६४-४१", "content_sanskrit": "यद्ब्रूते देवराजस्तु तत्सर्वं सुमनाः कुरु ।\nआगंतव्यं त्वया देव एंद्रं लोकं हि नान्यथा॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000392041, "chapter_id": 20392, "verse_number": "२-६४-४२", "content_sanskrit": "पुत्रे राज्यं विसृज्यैव कृत्वा चांतेष्टिमुत्तमाम् ।\nइलो राजा महातेजा वसते नहुषात्मज॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000392042, "chapter_id": 20392, "verse_number": "२-६४-४३", "content_sanskrit": "पुरूरवा महावीर्यो विप्रचित्तिर्महामनाः ।\nशिबिर्वसति तत्रैव मनुरिक्ष्वाकु भूपतिः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000392043, "chapter_id": 20392, "verse_number": "२-६४-४४", "content_sanskrit": "सगरो नाम मेधावी नहुषश्च पिता तव ।\nऋतवीर्यः कृतज्ञश्च शंतनुश्च महामनाः॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000392044, "chapter_id": 20392, "verse_number": "२-६४-४५", "content_sanskrit": "भरतो युवनाश्वश्च कार्तवीर्यो नरेश्वरः ।\nयज्ञानाहृत्य बहुधा मोदंते दिवि भूभृतः॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000392045, "chapter_id": 20392, "verse_number": "२-६४-४६", "content_sanskrit": "अन्ये चैव तु राजानो यज्ञकर्मसु तत्पराः ।\nसर्वे ते दिवि चेंद्रेण मोदंते स्वेन कर्मणा॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000392046, "chapter_id": 20392, "verse_number": "२-६४-४७", "content_sanskrit": "त्वं पुनः सर्वधर्मज्ञः सर्वधर्मेषु संस्थितः ।\nशक्रेण सह मोदस्व स्वर्गलोके महीपते॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000392047, "chapter_id": 20392, "verse_number": "२-६४-४८", "content_sanskrit": "ययातिरुवाच ।\nकिं मया तत्कृतं कर्म येन मय्यर्थिता तव ।\nइंद्रस्य देवराजस्य तत्सर्वं मे वदस्व च॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000392048, "chapter_id": 20392, "verse_number": "२-६४-४९", "content_sanskrit": "मातलिरुवाचमातलि उपरि टिप्पणी ।\nयदशीतिसहस्राणि वर्षाणां हि त्वया नृप ।\nदानपुण्यादिकं कर्म यज्ञैस्तु परिसाधितम्॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000392049, "chapter_id": 20392, "verse_number": "२-६४-५०", "content_sanskrit": "दिवं गच्छ महाराज कर्मणा स्वेन भूपते ।\nसखित्वं देवराजेन कुरु गच्छ सुरालयम्॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000392050, "chapter_id": 20392, "verse_number": "२-६४-५१", "content_sanskrit": "पंचात्मकं शरीरं च भूमौ त्यज महामते ।\nदिव्यरूपं समास्थाय भुंक्ष्व भोगान्मनोनुगान्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000392051, "chapter_id": 20392, "verse_number": "२-६४-५२", "content_sanskrit": "यथायथा कृता भूमौ यज्ञा दानं तपश्च ते ।\nतथातथा स्वर्गभोगाः प्रार्थयंते नरेश्वर॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000392052, "chapter_id": 20392, "verse_number": "२-६४-५३", "content_sanskrit": "ययातिरुवाच ।\nयेन कायेन सिध्येत सुकृतं दुष्कृतं भुवि ।\nमातले तत्कथं त्यक्त्वा गच्छेल्लोकमुपार्जितम्॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000392053, "chapter_id": 20392, "verse_number": "२-६४-५४", "content_sanskrit": "मातलिरुवाच ।\nयत्रैवोपार्जितं कायं पंचात्मकमिदं नृप ।\nतत्तत्रैव परित्यज्य दिव्येनैव व्रजंति तम्॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000392054, "chapter_id": 20392, "verse_number": "२-६४-५५", "content_sanskrit": "इतरे मानवाः सर्वे पापपुण्यप्रसाधकाः ।\nतेऽपि कायं परित्यज्य अधऊर्ध्वं व्रजंति वै॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000392055, "chapter_id": 20392, "verse_number": "२-६४-५६", "content_sanskrit": "ययातिरुवाच ।\nपंचात्मकेन कायेन सुकृतं दुष्कृतं नराः ।\nउत्पाद्यैव प्रयांत्येव अधऊर्ध्वं तु मातले॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000392056, "chapter_id": 20392, "verse_number": "२-६४-५७", "content_sanskrit": "को विशेषो हि धर्मज्ञ भूमौ कायं परित्यजेत् ।\nपापपुण्यप्रभावाद्वै कायस्य पतनं भवेत्॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000392057, "chapter_id": 20392, "verse_number": "२-६४-५८", "content_sanskrit": "दृष्टांतो दृश्यते सूत प्रत्यक्षं मर्त्यमंडले ।\nविशेषं नैव पश्यामि पापपुण्यस्य चाधिकम्॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000392058, "chapter_id": 20392, "verse_number": "२-६४-५९", "content_sanskrit": "सत्यधर्मादिकं कर्म येन कायेन मानवः ।\nसमर्जयति वै मर्त्यस्तं कस्माद्विप्रसर्जयेत्॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000392059, "chapter_id": 20392, "verse_number": "२-६४-६०", "content_sanskrit": "आत्मा कायश्च द्वावेतौ मित्ररूपावुभावपि ।\nकायं मित्रं परित्यज्य आत्मा याति सुनिश्चितः॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000392060, "chapter_id": 20392, "verse_number": "२-६४-६१", "content_sanskrit": "मातलिरुवाच ।\nसत्यमुक्तं त्वया राजन्कायं त्यक्त्वा प्रयाति सः ।\nसंबंधो नास्ति तेनापि समं कायेन चात्मनः॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000392061, "chapter_id": 20392, "verse_number": "२-६४-६२", "content_sanskrit": "यस्मात्पंचत्वरूपोऽयं संधिजर्जरितः सदा ।\nजरया पीड्यमानस्तु व्याधिभिर्दूषितः सदा॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000392062, "chapter_id": 20392, "verse_number": "२-६४-६३", "content_sanskrit": "जरादोषैः प्रभग्नोऽसौ अत्र स्थातुं स नेच्छति ।\nआकुलव्याकुलो भूत्वा जीवस्त्यक्त्वा प्रयाति सः॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000392063, "chapter_id": 20392, "verse_number": "२-६४-६४", "content_sanskrit": "सत्येन धर्मपुण्यैश्च दानैर्नियमसंयमैः ।\nअश्वमेधादिभिर्यज्ञैस्तीर्थैः संयमनैस्तथा॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000392064, "chapter_id": 20392, "verse_number": "२-६४-६५", "content_sanskrit": "सुपुण्यैः सुकृतैश्चान्यैर्जरा नैव प्रधार्यते ।\nपातकैश्च महाराज द्रवते कायमेव सा॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000392065, "chapter_id": 20392, "verse_number": "२-६४-६६", "content_sanskrit": "ययातिरुवाच ।\nकस्माज्जरा समुत्पन्ना कस्मात्कायं प्रपीडयेत् ।\nमम विस्तरतस्त्वं च वक्तुमर्हसि सत्तम॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000392066, "chapter_id": 20392, "verse_number": "२-६४-६७", "content_sanskrit": "मातलिरुवाच ।\nहंत ते वर्णयिष्यामि जरायाः परिकारणम् ।\nयस्माच्चेयं समुद्भूता कायमध्ये नृपोत्तम॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000392067, "chapter_id": 20392, "verse_number": "२-६४-६८", "content_sanskrit": "पंचभूतात्मकः कायो विषयैः पंचभिः श्रितः ।\nयदात्मा त्यजते राजन्स कायः परिधक्ष्यते॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000392068, "chapter_id": 20392, "verse_number": "२-६४-६९", "content_sanskrit": "वह्निना दीप्यमानस्तु सरसो ज्वलते नृप ।\nतस्माद्विजायते धूमो धूमान्मेघाश्च जज्ञिरे॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000392069, "chapter_id": 20392, "verse_number": "२-६४-७०", "content_sanskrit": "मेघादापः प्रवर्तंते अद्भ्यः पृथ्वी प्रकल्पते ।\nजलमायाति साध्वी सा यथा नारी रजस्वला॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000392070, "chapter_id": 20392, "verse_number": "२-६४-७१", "content_sanskrit": "तस्मात्प्रजायते गंधो गंधाद्रसो नृपोत्तम ।\nरसात्प्रभवते चान्नमन्नाच्छुक्रं न संशयः॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000392071, "chapter_id": 20392, "verse_number": "२-६४-७२", "content_sanskrit": "शुक्राद्धि जायते कायः कुरूपः काय एव च ।\nयथा पृथ्वी सृजेद्गंधान्रसैश्चरति भूतले॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000392072, "chapter_id": 20392, "verse_number": "२-६४-७३", "content_sanskrit": "तथा कायश्चरेन्नित्यं रसाधारो हि सर्वशः ।\nगंधश्च जायते तस्माद्गंधाद्रसो भवेत्पुनः॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000392073, "chapter_id": 20392, "verse_number": "२-६४-७४", "content_sanskrit": "तस्माज्जज्ञे महावह्निर्दृष्टांतं पश्य भूपते ।\nयथा काष्ठाद्भवेद्वह्निः पुनः काष्ठं प्रकाशयेत्॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000392074, "chapter_id": 20392, "verse_number": "२-६४-७५", "content_sanskrit": "कायमध्ये रसादग्निस्तद्वदेव प्रजायते ।\nतत्र संचरते नित्यं कायं पुष्णाति भूपते॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000392075, "chapter_id": 20392, "verse_number": "२-६४-७६", "content_sanskrit": "यावद्रसस्य चाधिक्यं तावज्जीवः प्रशांतिमान् ।\nचरित्वा तादृशं वह्निः क्षुधारूपेण वर्तते॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000392076, "chapter_id": 20392, "verse_number": "२-६४-७७", "content_sanskrit": "अन्नमिच्छत्यसौ तीव्रः पयसा च समन्वितम् ।\nप्रदानं लभते चान्नमुदकं चापि भूपते॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000392077, "chapter_id": 20392, "verse_number": "२-६४-७८", "content_sanskrit": "शोणितं चरते वह्निस्तद्वद्वीर्यं न संशयः ।\nयक्ष्मरोगो भवेत्तस्मात्सर्वकायप्रणाशकः॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000392078, "chapter_id": 20392, "verse_number": "२-६४-७९", "content_sanskrit": "रसाधिक्यं भवेद्राजन्नथ वह्निः प्रशाम्यति ।\nरसेन पीड्यमानस्तु ज्वररूपोभिजायते॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000392079, "chapter_id": 20392, "verse_number": "२-६४-८०", "content_sanskrit": "ग्रीवा पृष्ठं कटिं पायुं सर्वास्वेव तु संधिषु ।\nआरुध्य तिष्ठते वह्निः काये वह्निः प्रवर्तते॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000392080, "chapter_id": 20392, "verse_number": "२-६४-८१", "content_sanskrit": "तस्याऽधिक्यं चरेन्नित्यं कायं पुष्णाति सर्वतः ।\nरसस्तु बंधमायाति बलरूपो भवेत्तदा॥ ८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000392081, "chapter_id": 20392, "verse_number": "२-६४-८२", "content_sanskrit": "अतिरिक्तो बलेनैव वीर्यान्मर्माणि चालयेत् ।\nतेनैव जायते कामः शल्यरूपो भवेन्नृप॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000392082, "chapter_id": 20392, "verse_number": "२-६४-८३", "content_sanskrit": "सकामाग्निः समाख्यातो बलनाशकरो नृप ।\nमैथुनस्य प्रसंगेन विनाशत्वं कलेवरे॥ ८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000392083, "chapter_id": 20392, "verse_number": "२-६४-८४", "content_sanskrit": "नारीं च संश्रयेत्प्राणी पीडितः कामवह्निना ।\nमैथुनस्य प्रसंगेन मूर्छितः कामकर्शितः॥ ८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000392084, "chapter_id": 20392, "verse_number": "२-६४-८५", "content_sanskrit": "तेजोहीनो भवेत्कायो बलहानिश्च जायते ।\nबलहीनो यदा स्याद्वै दुर्बलो वह्निनेरितः॥ ८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000392085, "chapter_id": 20392, "verse_number": "२-६४-८६", "content_sanskrit": "स वह्निः प्रचरेत्काये शोणितं शुक्रमेव च ।\nशुक्रशोणितयोर्नाशाच्छून्यदेहोभिजायते॥ ८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000392086, "chapter_id": 20392, "verse_number": "२-६४-८७", "content_sanskrit": "अतीव जायते वायुः प्रचंडो दारुणाकृतिः ।\nविवर्णो दुःखसंतप्तः शून्यबुद्धिस्ततो भवेत्॥ ८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000392087, "chapter_id": 20392, "verse_number": "२-६४-८८", "content_sanskrit": "दृष्टा श्रुता तु या नारी तच्चित्तो भ्रमते सदा ।\nतृप्तिर्न जायते काये लोलुपे चित्तवर्त्मनि॥ ८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000392088, "chapter_id": 20392, "verse_number": "२-६४-८९", "content_sanskrit": "विरूपश्च सुरूपश्च ध्यानान्मध्ये प्रजायते ।\nबलहीनो यदा कामी मांसशोणितसंक्षयात्॥ ८९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000392089, "chapter_id": 20392, "verse_number": "२-६४-९०", "content_sanskrit": "पलितं जायते काये नाशिते कामवह्निना ।\nतस्मात्संजायते कामी वृद्धो भूत्वा दिनेदिने॥ ९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000392090, "chapter_id": 20392, "verse_number": "२-६४-९१", "content_sanskrit": "सुरते चिंतते नारीं यथा वार्द्धुषिको नरः ।\nतथातथा भवेद्धानिस्तेजसोऽस्य नरेश्वर॥ ९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000392091, "chapter_id": 20392, "verse_number": "२-६४-९२", "content_sanskrit": "तस्मात्प्रजायते कायो नाशरूपं समृच्छति ।\nअग्निः प्रजायते भूयो जरारूपो न संशयः॥ ९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000392092, "chapter_id": 20392, "verse_number": "२-६४-९३", "content_sanskrit": "प्राणिनां क्षयरूपेण ज्वरो भवति दारुणः ।\nस्थावरा जंगमाः सर्वे ज्वरेण परिपीडिताः॥ ९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7000392093, "chapter_id": 20392, "verse_number": "२-६४-९४", "content_sanskrit": "नाशमायांति ते सर्वे बहुपीडा प्रपीडिताः ।\nएतत्ते सर्वमाख्यातमन्यत्किं ते वदाम्यहम्॥ ९४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7000392094, "chapter_id": 20392, "verse_number": "२-६४-९५", "content_sanskrit": "एवमुक्तो महाराजो मातलिं वाक्यमब्रवीत्॥ ९५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}]