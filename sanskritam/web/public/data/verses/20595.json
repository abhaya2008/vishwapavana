[{"id": 7000595000, "chapter_id": 20595, "verse_number": "५-५४-१", "content_sanskrit": "शेष उवाच ।\nगतः प्रातःक्रियां कर्तुं समिधस्तत्क्रियार्हकाः ।\nआनेतुं जानकीसूनुर्वृतो मुनिसुतैर्लवः॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000595001, "chapter_id": 20595, "verse_number": "५-५४-२", "content_sanskrit": "ददर्श तत्र यज्ञाश्वं स्वर्णपत्रेण चिह्नितम् ।\nकुंकुमागरुकस्तूरी दिव्यगंधेन वासितम्॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000595002, "chapter_id": 20595, "verse_number": "५-५४-३", "content_sanskrit": "विलोक्य जातकुतुको मुनिपुत्रानुवाच सः ।\nअर्वा कस्य मनोवेगः प्राप्तो दैवान्मदाश्रमम्॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000595003, "chapter_id": 20595, "verse_number": "५-५४-४", "content_sanskrit": "आगच्छंतु मया सार्धं प्रेक्षंतां मा भयं कृथाः ।\nइत्युक्त्वा स लवस्तूर्णं वाहस्य निकटे गतः॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000595004, "chapter_id": 20595, "verse_number": "५-५४-५", "content_sanskrit": "स रराज समीपस्थो वाहस्य रघुवंशजः ।\nधनुर्बाणधरः स्कंधे जयंत इव दुर्जयः॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000595005, "chapter_id": 20595, "verse_number": "५-५४-६", "content_sanskrit": "गत्वा मुनिसुतैः सार्धं वाचयामास पत्रकम् ।\nभालस्थितं स्पष्टवर्णराजिराजितमुत्तमम्॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000595006, "chapter_id": 20595, "verse_number": "५-५४-७", "content_sanskrit": "विवस्वतो महान्वंशः सर्वलोकेषु विश्रुतः ।\nयत्र कोपि पराबाधी न परद्रव्यलंपटः॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000595007, "chapter_id": 20595, "verse_number": "५-५४-८", "content_sanskrit": "सूर्यवंशध्वजो धन्वी धनुर्दीक्षा गुरुर्गुरुः ।\nयं देवाः सामराः सर्वे नमंति मणिमौलिभिः॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000595008, "chapter_id": 20595, "verse_number": "५-५४-९", "content_sanskrit": "तस्यात्मजो वीर बलदर्पहारी रघूद्वहः ।\nरामचंद्रो महाभागः सर्वशूरशिरोमणिः॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000595009, "chapter_id": 20595, "verse_number": "५-५४-१०", "content_sanskrit": "तन्माता कोशलनृपपुत्रीरत्नसमुद्भवा ।\nतस्याः कुक्षिभवं रत्नं रामः शत्रुक्षयंकरः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000595010, "chapter_id": 20595, "verse_number": "५-५४-११", "content_sanskrit": "करोति हयमेधं स ब्राह्मणेन सुशिक्षितः ।\nरावणाभिधविप्रेंद्र वधपापापनुत्तये॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000595011, "chapter_id": 20595, "verse_number": "५-५४-१२", "content_sanskrit": "मोचितस्तेन वाहानां मुख्योऽसौ याज्ञिको हयः ।\nमहाबलपरीवारो परिखाभिः सुरक्षितः॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000595012, "chapter_id": 20595, "verse_number": "५-५४-१३", "content_sanskrit": "तद्रक्षकोऽस्ति मद्भ्राता शत्रुघ्नो लवणांतकः ।\nहस्त्यश्वरथपादातसंघसेनासमन्वितः॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000595013, "chapter_id": 20595, "verse_number": "५-५४-१४", "content_sanskrit": "यस्य राज्ञ इति श्रेष्ठो मानो जायेत्स्वकान्मदात् ।\nशूरा वयं धनुर्धारि श्रेष्ठा वयमिहोत्कटाः॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000595014, "chapter_id": 20595, "verse_number": "५-५४-१५", "content_sanskrit": "ते गृह्णंतु बलाद्वाहं रत्नमालाविभूषितम् ।\nमनोवेगं कामजवं सर्वगत्याधिभास्वरम्॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000595015, "chapter_id": 20595, "verse_number": "५-५४-१६", "content_sanskrit": "ततो मोचयिता भ्राता शत्रुघ्नो लीलया हठात् ।\nशरासनविनिर्मुक्त वत्सदंतकृतव्यथात्॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000595016, "chapter_id": 20595, "verse_number": "५-५४-१७", "content_sanskrit": "ये क्षत्रियाः क्षत्रियकन्यकायां ।\nजाताश्च सत्क्षेत्रकुलेषु सत्सु ।\nगृह्णंतु ते तद्विपरीतदेहा ।\nनमंतु राज्यं रघवे निवेद्य॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000595017, "chapter_id": 20595, "verse_number": "५-५४-१८", "content_sanskrit": "इति संवाच्य कुपितो लवः शस्त्रधनुर्धरः ।\nउवाच मुनिपुत्रांस्तान्रोषगद्गदभाषितः॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000595018, "chapter_id": 20595, "verse_number": "५-५४-१९", "content_sanskrit": "पश्यत क्षिप्रमेतस्य धृष्टत्वं क्षत्रियस्य वै ।\nलिलेख यो भालपत्रे स्वप्रतापबलं नृपः॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000595019, "chapter_id": 20595, "verse_number": "५-५४-२०", "content_sanskrit": "कोऽसौ रामः कः शत्रुघ्नः कीटाः स्वल्पबलाश्रिताः ।\nक्षत्रियाणां कुले जाता एते न वयमुत्तमाः॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000595020, "chapter_id": 20595, "verse_number": "५-५४-२१", "content_sanskrit": "एतस्य वीरसूर्माता जानकी न कुशप्रसूः ।\nया रत्नं कुशसंज्ञं तु दधाराग्निमिवारणिः॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000595021, "chapter_id": 20595, "verse_number": "५-५४-२२", "content_sanskrit": "इदानीं क्षत्रियत्वादि दर्शयिष्यामि सर्वतः ।\nयदि क्षत्रियभूरेष भविष्यति च शत्रुहा॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000595022, "chapter_id": 20595, "verse_number": "५-५४-२३", "content_sanskrit": "गृहीष्यति मया बद्धं वाहं यज्ञक्रियोचितम् ।\nनोचेत्क्षत्रत्वमुन्मुच्य कुशस्य चरणार्चकः॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000595023, "chapter_id": 20595, "verse_number": "५-५४-२४", "content_sanskrit": "अधुना मद्धनुर्मुक्तैः शरैः सुप्तो भविष्यति ।\nअन्ये ये च महावीरा रणमंडलभूषणाः॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000595024, "chapter_id": 20595, "verse_number": "५-५४-२५", "content_sanskrit": "इत्यादिवाक्यमुच्चार्य लवो जग्राह तं हयम् ।\nतृणीकृत्य नृपान्सर्वांश्चापबाणधरो वरः॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000595025, "chapter_id": 20595, "verse_number": "५-५४-२६", "content_sanskrit": "तदा मुनिसुताः प्रोचुर्लवं हयजिहीर्षकम् ।\nअयोध्यानृपती रामो महाबलपराक्रमः॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000595026, "chapter_id": 20595, "verse_number": "५-५४-२७", "content_sanskrit": "तस्य वाहं न गृह्णाति शक्रोऽपि स्वबलोद्धतः ।\nमा गृहाण शृणुष्वेदं मद्वाक्यं हितसंयुतम्॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000595027, "chapter_id": 20595, "verse_number": "५-५४-२८", "content_sanskrit": "इत्युक्तं स श्रुतौ धृत्वा जगाद स द्विजात्मजान् ।\nयूयं बलं न जानीथ क्षत्रियाणां द्विजोत्तमाः॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000595028, "chapter_id": 20595, "verse_number": "५-५४-२९", "content_sanskrit": "क्षत्रिया वीर्यशौंडीर्या द्विजा भोजनशालिनः ।\nतस्माद्यूयं गृहे गत्वा भुंजंतु जननी हृतम्॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000595029, "chapter_id": 20595, "verse_number": "५-५४-३०", "content_sanskrit": "इत्युक्तास्तेऽभवंस्तूष्णीं प्रेक्षंतस्तत्पराक्रमम् ।\nलवस्य मुनिपुत्रास्ते संतस्थुर्दूरतो बहिः॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000595030, "chapter_id": 20595, "verse_number": "५-५४-३१", "content_sanskrit": "एवं व्यतिकरे वृत्ते सेवकास्तस्य भूपतेः ।\nआयातास्तं हयं बद्धं दृष्ट्वा प्रोचुस्तदा लवम्॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000595031, "chapter_id": 20595, "verse_number": "५-५४-३२", "content_sanskrit": "बबंध को हयमहो रुष्टः कस्य च धर्मराट् ।\nको बाणव्रजमध्यस्थः प्राप्स्यते परमां व्यथाम्॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000595032, "chapter_id": 20595, "verse_number": "५-५४-३३", "content_sanskrit": "तदा लवो जगादाशु मया बद्धोऽश्व उत्तमः ।\nयो मोचयति तस्याशु रुष्टो भ्राता कुशो महान्॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000595033, "chapter_id": 20595, "verse_number": "५-५४-३४", "content_sanskrit": "यमः करिष्यति किमु ह्यागतोऽपि स्वयं प्रभुः ।\nनत्वा गमिष्यति क्षिप्रं शरवृष्ट्या सुतोषितः॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000595034, "chapter_id": 20595, "verse_number": "५-५४-३५", "content_sanskrit": "शेष उवाच ।\nइति वाक्यं समाकर्ण्य बालोयमिति तेब्रुवन् ।\nसमागता मोचयितुं हयं बद्धं तु ये हरेः॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000595035, "chapter_id": 20595, "verse_number": "५-५४-३६", "content_sanskrit": "तान्वैमोचयितुं प्राप्ताञ्छत्रुघ्नस्य च सेवकान् ।\nकोदंडं करयोर्धृत्वा क्षुरप्रान्सममूमुचत्॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000595036, "chapter_id": 20595, "verse_number": "५-५४-३७", "content_sanskrit": "ते छिन्नबाहवः शोकाच्छत्रुघ्नं प्रतिसंगताः ।\nपृष्टास्ते जगदुः सर्वे लवात्स्वभुजकृंतनम्॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]