[{"id": 2028272, "chapter_id": 1612, "verse_number": "३-२५०-०x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2028273, "chapter_id": 1612, "verse_number": "३-२५०-१", "content_sanskrit": "चित्रसेनं समागम्य प्रहसन्नर्जुनस्तदा।\nइदं वचनमक्लीवमब्रवीत्परवीरहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2028274, "chapter_id": 1612, "verse_number": "३-२५०-२", "content_sanskrit": "भ्रातृनर्हसि मे वीर मोक्तुं गन्धर्वसत्तम।\nअनर्हधर्षणा हीमे जीवमानेषु पाण्डुषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2028275, "chapter_id": 1612, "verse_number": "३-२५०-३", "content_sanskrit": "एवमुक्तस्तु गन्धर्वः पाण्डवेन महात्मना।\nउवाच यत्कर्ण वयं मन्त्रयन्तो विनिर्गताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2028276, "chapter_id": 1612, "verse_number": "३-२५०-४", "content_sanskrit": "`स्थितोराज्येच्युतान्स्थानाच्छ्रियाहीनांश्रियावृतः\nद्रष्टास्मि निःसुखान्वीरान्सदारान्पाण्डवानिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2028277, "chapter_id": 1612, "verse_number": "३-२५०-५", "content_sanskrit": "तस्मिन्नुच्चार्यमाणे तु गन्धर्वेण वचस्तथा।\nभूमेर्विवरमन्वैच्छं प्रवेष्टुं व्रीडयाऽन्वितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2028278, "chapter_id": 1612, "verse_number": "३-२५०-६", "content_sanskrit": "युधिष्ठिरमथागम् गन्धर्वाः सह पाण्डवैः।\nअस्मद्दुर्मन्त्रितं तस्मै बद्धांश्चास्मान्न्यवेदयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2028279, "chapter_id": 1612, "verse_number": "३-२५०-७", "content_sanskrit": "स्त्रीसमक्षमहं दीनो बद्धः शत्रुवशं गतः।\nयुधिष्ठिरस्योपहृतः किंनु दुःखमतः परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2028280, "chapter_id": 1612, "verse_number": "३-२५०-८", "content_sanskrit": "ये मे निराकृता नित्यं रिपुर्येषामहं सदा।\nतैर्मोक्षितोऽहं दुर्बुद्धिर्दत्तं तैरेव जीवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2028281, "chapter_id": 1612, "verse_number": "३-२५०-९", "content_sanskrit": "प्राप्तः स्यां यद्यहं वीर वधं तस्मिन्महारणे।\nश्रेयस्तद्भविता मह्यं नैवंभूतस्य जीवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2028282, "chapter_id": 1612, "verse_number": "३-२५०-१०", "content_sanskrit": "भवेद्यशः पृथिव्यां मे ख्यातं गन्धर्वतो वधात्।\nप्राप्ताश्च पुण्यलोकाः स्युर्महेन्द्रसदनेऽक्षयाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2028283, "chapter_id": 1612, "verse_number": "३-२५०-११", "content_sanskrit": "यत्त्वद्य मे व्यवसितं तच्छृणुध्वं नरर्षभाः।\nइह प्रायमुपासिष्ये यूयं व्रजत वै गृहान्।\nभ्रातरश्चैव मे सर्वे यान्त्वद्य स्वपुरं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2028284, "chapter_id": 1612, "verse_number": "३-२५०-१२", "content_sanskrit": "कर्णप्रभृतयश्चैव सुहृदो बान्धवाश्च ये।\nदुःशासनं पुरस्कृत्य प्रयान्त्वद्य पुरं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2028285, "chapter_id": 1612, "verse_number": "३-२५०-१३", "content_sanskrit": "न ह्यहं संप्रयास्यामि पुरं शत्रुनिराकृतः।\nशत्रुमानापहो भूत्वा सुहृदां मानकृत्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2028286, "chapter_id": 1612, "verse_number": "३-२५०-१४", "content_sanskrit": "`कामं रणशिरस्यद्य शत्रुभिर्वै विमानितः।\nस सुहृच्छोकदो जातः शत्रूणां हर्वर्धनः।\nवारणाह्वयमासाद्य किं वक्ष्यामि जनाधिपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2028287, "chapter_id": 1612, "verse_number": "३-२५०-१५", "content_sanskrit": "भीष्मद्रोणौ कृपद्रौणी विदुरः संजयस्तथा।\nबाह्लीकः सौमदत्तिश्च ये चान्ये वृद्धसंमताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2028288, "chapter_id": 1612, "verse_number": "३-२५०-१६", "content_sanskrit": "ब्राह्मणाः श्रेणिमुख्याश्च तथोदासीनवृत्तयः।\nकिं मां वक्ष्यंति किं चापि प्रतिवक्ष्यामि तानहं ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2028289, "chapter_id": 1612, "verse_number": "३-२५०-१७", "content_sanskrit": "रिपूणां शिरसि स्थित्वा तथा विक्रम्य चोरसि।\nआत्मदोषात्परिभ्रष्टः कथं वक्ष्यामि तानहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2028290, "chapter_id": 1612, "verse_number": "३-२५०-१८", "content_sanskrit": "दुर्विनीताः श्रियं प्राप्य विद्यामैश्वर्यमेव च।\nतिष्ठन्ति न चिरं भद्रे यथाऽहं मदगर्वितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2028291, "chapter_id": 1612, "verse_number": "३-२५०-१९", "content_sanskrit": "अहो वत यथेदं मे कष्टं दुश्चरितं कृतम्।\nस्वयं दुर्बुद्धिना मोहाद्येन प्राप्तोस्मि संशयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2028292, "chapter_id": 1612, "verse_number": "३-२५०-२०", "content_sanskrit": "तस्मात्प्रायमुपासिष्ये न हिशक्ष्यामि जीवितुम्।\nचेतयानो हि को जीवेत्कृच्छ्राच्छत्रुभिरुद्धृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2028293, "chapter_id": 1612, "verse_number": "३-२५०-२१", "content_sanskrit": "शत्रुभिश्चावहसितो मानी पौरुषवर्जितः।\nपाण्डवैर्विक्रमाढ्यैशच् सावमानमवेक्षितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2028294, "chapter_id": 1612, "verse_number": "३-२५०-२२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2028295, "chapter_id": 1612, "verse_number": "३-२५०-२२", "content_sanskrit": "एवं चिन्तापरिगतो दुःशासनमथाब्रवीत्।\nदुःशासन निबोधेदं वचनं मम भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2028296, "chapter_id": 1612, "verse_number": "३-२५०-२३", "content_sanskrit": "प्रतीच्छ त्वं मया दत्तमभिषेकं नृपो भव।\nप्रशाधि पृथिवीं स्फीतांकर्णसौबलपालिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2028297, "chapter_id": 1612, "verse_number": "३-२५०-२४", "content_sanskrit": "भ्रातॄन्पालय विस्रब्धं मरुतो वृत्रहा यथा।\nबान्धवाश्चोपजीवन्तु देवा इव शतक्रतुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2028298, "chapter_id": 1612, "verse_number": "३-२५०-२५", "content_sanskrit": "ब्राह्मणेषु सदा वृत्तिं कुर्वीथाश्चाप्रमादतः।\nबन्धूनां सुहृदां चैव भवेथास्त्वं गतिः सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2028299, "chapter_id": 1612, "verse_number": "३-२५०-२६", "content_sanskrit": "ज्ञातींश्चाप्यनुपश्येथा विष्णुर्देवगणान्यथा।\nगुरवः पालनीयास्ते गच्छ पालय मेदिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2028300, "chapter_id": 1612, "verse_number": "३-२५०-२७", "content_sanskrit": "नन्दयन्सुहृदः सर्वाञ्शात्रवांश्चावभर्त्सयन्।\nकण्ठे चैनं परिष्वज्यगम्यतामित्युवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2028301, "chapter_id": 1612, "verse_number": "३-२५०-२८", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा दीनो दुशासनोऽब्रवीत्।\nअश्रुकण्ठः सुदुःखार्तः प्राञ्जलिः प्रणिपत्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2028302, "chapter_id": 1612, "verse_number": "३-२५०-२९", "content_sanskrit": "सगद्गदमिदं वाक्यं भ्रातरं ज्येष्ठमात्मनः।\nकप्रसीदेत्यपतद्भूमौ दूयमानेन चेतसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2028303, "chapter_id": 1612, "verse_number": "३-२५०-३०", "content_sanskrit": "दुःखितः पादयोस्तस्य नेत्रजं जलमुत्सृजन्।\nउक्तवांश्च नरव्याघ्रो नैतदेवं भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2028304, "chapter_id": 1612, "verse_number": "३-२५०-३१", "content_sanskrit": "विदीर्यत्सकला भूमिर्द्यौश्चापि शकलीभवेत्।\nरविरात्मप्रभां जह्यात्सोमः शीतांशुतां त्यजेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2028305, "chapter_id": 1612, "verse_number": "३-२५०-३२", "content_sanskrit": "वायुः शैघ्र्यमथो जह्याद्धिमवांश्च हिमं त्यजेत्।\nशुष्येत्तोयं समुद्रेषु वह्निरप्युष्णतां त्यजेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2028306, "chapter_id": 1612, "verse_number": "३-२५०-३३", "content_sanskrit": "न चाहं त्वदृते राजन्प्रशासेयं वसुंधराम्।\nपुनःपुनः प्रसीदेति वाक्यं चेदमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2028307, "chapter_id": 1612, "verse_number": "३-२५०-३४", "content_sanskrit": "`शत्रूणां शोककृद्राजन्सुहृदां शोकनाशनः\nत्वमेव नःकुलेराजा भविष्यसि शतं समाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2028308, "chapter_id": 1612, "verse_number": "३-२५०-३५", "content_sanskrit": "एवमुक्त्वा स राजानं सुश्वरं प्ररुरोद ह।\nपादौ संस्पृश्य मानार्हौ भ्रातुर्ज्येष्ठस्य भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2028309, "chapter_id": 1612, "verse_number": "३-२५०-३६", "content_sanskrit": "तथा तौ दुःखितौ दृष्ट्वा दुःशासनसुयोधनौ।\nअभिगम्य व्यथाविष्टः कर्णस्तौ प्रत्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2028310, "chapter_id": 1612, "verse_number": "३-२५०-३७", "content_sanskrit": "विषीदथः किं कौरव्यौ बालिश्यात्प्राकृताविव।\nन शोकः शोचमानस्य विनिवर्तेत कर्हिचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2028311, "chapter_id": 1612, "verse_number": "३-२५०-३८", "content_sanskrit": "यदा च शोचतः शोकोव्यसनं नापकर्षति।\nसामर्थ्यं किं ततः शोके शोचमानौ प्रपश्यथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2028312, "chapter_id": 1612, "verse_number": "३-२५०-३९", "content_sanskrit": "धृतिं गृह्णीतं मा शत्रूञ्शोचन्तौ नन्दयिष्यथः।\nकर्तव्यं हि कृतं राजन्पाण्डवैस्तव मोक्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2028313, "chapter_id": 1612, "verse_number": "३-२५०-४०", "content_sanskrit": "नित्यमेव प्रियं कार्यं राज्ञो विपयवासिभिः।\nपाल्यमानास्त्वया ते हि निवसन्ति गतज्वराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2028314, "chapter_id": 1612, "verse_number": "३-२५०-४१", "content_sanskrit": "नार्हस्येवंगते मन्युं कर्तुं प्राकृतवत्स्वयम्।\nविषण्णास्तव सोदर्यास्त्वयि प्रायं समास्थिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2028315, "chapter_id": 1612, "verse_number": "३-२५०-४२", "content_sanskrit": "`तदलं दुःखितानेतान्कर्तुं सर्वान्नराधिप।\nउत्तिष्ठ व्रज भद्रं ते समाश्वासय सोदरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2028316, "chapter_id": 1612, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि घोषयात्रापर्वणि पञ्चाशदधिकद्विशततमोऽध्यायः ॥ २५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]