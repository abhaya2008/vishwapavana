[{"id": 2092352, "chapter_id": 2966, "verse_number": "१३-९६-१", "content_sanskrit": "युधिष्ठर उवाच।\nदानं यज्ञः क्रिया चेह किंस्वित्प्रेत्य महाफलम्।\nकस्य ज्यायः फलं प्रोक्तं कीदृशेभ्यः कथं कदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2092353, "chapter_id": 2966, "verse_number": "१३-९६-२", "content_sanskrit": "एतदिच्छामि विज्ञातुं याथातथ्येनि भारत।\nविद्वञ्जिज्ञासमानाय दानधर्मान्प्रचक्ष्व मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2092354, "chapter_id": 2966, "verse_number": "१३-९६-३", "content_sanskrit": "अन्तर्वेद्यां च यद्दत्तं श्रद्धया चानृशंस्यतः।\nकिंस्विन्नैःश्रेयसं तात तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2092355, "chapter_id": 2966, "verse_number": "१३-९६-४x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2092356, "chapter_id": 2966, "verse_number": "१३-९६-४", "content_sanskrit": "रौद्रं कर्म क्षत्रियस्य सततं तात वर्तते।\nनास्य वैतानिकफलं विना दानं सुपावनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2092357, "chapter_id": 2966, "verse_number": "१३-९६-५", "content_sanskrit": "न तु पापकृतां राज्ञां याजका द्विजसत्तमाः॥\nधने सत्यप्रदातॄणां प्रतिगृह्णन्ति साधवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2092358, "chapter_id": 2966, "verse_number": "१३-९६-६", "content_sanskrit": "प्रतिगृह्णन्ति न तु चेद्यद्रोषादाप्तदक्षिणैः।\nएतस्मात्कारणाद्यज्ञैर्यजेद्राजाऽऽप्तदक्षिणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2092359, "chapter_id": 2966, "verse_number": "१३-९६-७", "content_sanskrit": "अथ चेत्प्रतिगृह्णीयुर्दद्यादहरहर्नृपः।\nश्रद्धामास्थाय परमां पावनं ह्येतुदुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2092360, "chapter_id": 2966, "verse_number": "१३-९६-८", "content_sanskrit": "ब्राह्मणांस्तर्पयन्द्रव्यैः स वै यज्ञोऽनुपद्रवः।\nमैत्रान्साधून्वेदविदः शीलवृत्ततपोर्जितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2092361, "chapter_id": 2966, "verse_number": "१३-९६-९", "content_sanskrit": "यत्ते ते न करिष्यन्ति कृतं ते न भविष्यति।\nयज्ञान्साधय साधुभ्यः स्वाद्वन्नान्दक्षिणावतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2092362, "chapter_id": 2966, "verse_number": "१३-९६-१०", "content_sanskrit": "इष्टं दत्तं च मन्येथा आत्मानं दानकर्मणा।\nपूजयेथा यायजूकांस्तवाप्यंशो भवेद्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2092363, "chapter_id": 2966, "verse_number": "१३-९६-११", "content_sanskrit": "`विद्वद्भ्यः सम्प्रदानेन तत्राप्यंशोऽस्य पूजया।\nयज्वभ्यश्चाथ विद्वद्भ्यो दत्त्वा लोकं प्रदापयेत्।\nप्रदद्याज्ज्ञानदातॄणां ज्ञानदानांशभाग्यभवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2092364, "chapter_id": 2966, "verse_number": "१३-९६-१२", "content_sanskrit": "प्रजावतो भरेथाश्च ब्राह्मणान्बहुभारिणः।\nप्रजावांस्तेन भवति यथा जनयिता तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2092365, "chapter_id": 2966, "verse_number": "१३-९६-१३", "content_sanskrit": "यावतः साधुधर्मान्वै सन्तः संवर्धयन्त्युत।\nसर्वस्वैश्चापि भर्तव्या नरा ये बहुकारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2092366, "chapter_id": 2966, "verse_number": "१३-९६-१४", "content_sanskrit": "समृद्धः सम्प्रयच्छ त्वं ब्राह्म्णेभ्यो युधिष्ठिर।\nधेनूरनडुहोऽन्नानि च्छत्रं वासांस्युपानहौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2092367, "chapter_id": 2966, "verse_number": "१३-९६-१५", "content_sanskrit": "आज्यानि यजमानेभ्यस्तथाऽन्नानि च भारत।\nअश्ववन्ति च यानानि वेश्मानि शयनानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2092368, "chapter_id": 2966, "verse_number": "१३-९६-१६", "content_sanskrit": "एते देयाः पुष्टिमद्भिर्लघूपायाश्च भारत।\nअजुगुप्सांश्च विज्ञाय ब्राह्मणान्वृत्तिकर्शितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2092369, "chapter_id": 2966, "verse_number": "१३-९६-१७", "content_sanskrit": "उपच्छन्नं प्रकाशं वा वृत्त्या तान्प्रतिपालय।\nराजसूयाश्वमेधाभ्यां श्रेयस्तत्क्षत्रियान्प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2092370, "chapter_id": 2966, "verse_number": "१३-९६-१८", "content_sanskrit": "एवं पापैर्विनिर्मुक्तस्त्वं पूतः स्वर्गमाप्स्यसि।\nसञ्चयित्वा पुनः कोशं यद्राष्ट्रं पालयिष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2092371, "chapter_id": 2966, "verse_number": "१३-९६-१९", "content_sanskrit": "तेन त्वं ब्रह्मभूयत्वमवाप्स्यसि धनानि च।\nआत्मनश्च परेषां च वृत्तिं संरक्ष भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2092372, "chapter_id": 2966, "verse_number": "१३-९६-२०", "content_sanskrit": "पुत्रवच्चापि भृत्यान्स्वान्प्रजाश्च परिपालय।\n[योगः क्षेमश्च ते नित्यं ब्राह्मणेष्वस्तु भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2092373, "chapter_id": 2966, "verse_number": "१३-९६-२१", "content_sanskrit": "तदर्थं जीवितं तेऽस्तु मा तेभ्योऽप्रतिपालनम्।\nअनर्थो ब्राह्मणस्यैष यद्वित्तनिचयो महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2092374, "chapter_id": 2966, "verse_number": "१३-९६-२२", "content_sanskrit": "क्षिया ह्यभीक्ष्णं संवासो दर्पयेत्सम्प्रमोहयेत्।\nब्राह्मणेषु प्रमूढेषु धर्मो विप्रणशेद्धुवम्।\nधर्मप्रणाशे भूतानामभावः स्यान्न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2092375, "chapter_id": 2966, "verse_number": "१३-९६-२३", "content_sanskrit": "यो रक्षिभ्यः सम्प्रदाय राजा राष्ट्रं विलुम्पति।\nयज्ञे राष्ट्राद्धनं तस्मादानयध्वमिति ब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2092376, "chapter_id": 2966, "verse_number": "१३-९६-२४", "content_sanskrit": "यच्चादाय तदाज्ञप्तं भीतं दत्तं सुदारुणम्।\nयजेद्राजा न तं यज्ञं प्रशंसन्त्यस्य साधवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2092377, "chapter_id": 2966, "verse_number": "१३-९६-२५", "content_sanskrit": "अपीडिताः सुसंवृद्धा ये ददत्यनुकूलतः।\nतादृशेनाप्युपायेन यष्टव्यं नोद्यमाहृतैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2092378, "chapter_id": 2966, "verse_number": "१३-९६-२६", "content_sanskrit": "यदा परिनिषिच्येत निहितो वै यथाविधि।\nतदा राजा महायज्ञैर्यजेत बहुदक्षिणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2092379, "chapter_id": 2966, "verse_number": "१३-९६-२७", "content_sanskrit": "वृद्धबालधनं रक्ष्यमन्धस्य कृपणस्य च।\nन खातपूर्वं कुर्वीत न रुदन्तीधनं हरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2092380, "chapter_id": 2966, "verse_number": "१३-९६-२८", "content_sanskrit": "हृतं कृपणवित्तं हि राष्ट्रं हन्ति नृप श्रियम्।\nदद्याच्च महतो भोगान्क्षुद्भयं प्रणुदेत्सताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2092381, "chapter_id": 2966, "verse_number": "१३-९६-२९", "content_sanskrit": "येषां स्वादूनि भोज्यानि समवेक्ष्यन्ति बालकाः।\nनाश्नन्ति विधिवत्तानि किन्नु पापतरं ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2092382, "chapter_id": 2966, "verse_number": "१३-९६-३०", "content_sanskrit": "यदि ते तादृशो राष्ट्रे विद्वान्त्सीदेत्क्षुधा द्विजः।\nभ्रूणहत्यां च गच्छेथाः कृत्वा पापमिवोत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2092383, "chapter_id": 2966, "verse_number": "१३-९६-३१", "content_sanskrit": "धिक्तस्य जीवितं राज्ञो राष्ट्रे यस्यावसीदति।\nद्विजोऽन्यो वा मनुष्योपि शिबिराह वचो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2092384, "chapter_id": 2966, "verse_number": "१३-९६-३२", "content_sanskrit": "यस्य स्म विषये राज्ञः स्नातकः सीदति क्षुधा।\nअवृद्धिमेति तद्राष्ट्रं विन्दते सह राजकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2092385, "chapter_id": 2966, "verse_number": "१३-९६-३३", "content_sanskrit": "क्रोशन्त्यो यस्य वै राष्ट्राद्ध्रियन्ते तरसा स्त्रियः।\nक्रोशतां पतिपुत्राणां मृतोऽसौ न च जीवति]॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2092386, "chapter_id": 2966, "verse_number": "१३-९६-३४", "content_sanskrit": "अरक्षितारं हर्तारं विलोप्तारमनायकम्।\nतं वै राजकलिं हन्युः प्रजाः सन्नह्य निर्घृणं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2092387, "chapter_id": 2966, "verse_number": "१३-९६-३५", "content_sanskrit": "अहं वो रक्षितेत्युक्त्वा यो न रक्षति भूमिपः।\nस संहत्य निहन्तव्यः श्वेव सोन्माद आतुरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2092388, "chapter_id": 2966, "verse_number": "१३-९६-३६", "content_sanskrit": "पापं कुर्वन्ति यत्किञ्चित्प्रजा राज्ञा ह्यरक्षिताः।\nचतुर्थं तस्य पापस्य राजा विन्दति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2092389, "chapter_id": 2966, "verse_number": "१३-९६-३७", "content_sanskrit": "अथाहुः सर्वमेवैति भूयोऽर्धमिति निश्चयः।\nचतुर्थं मतमस्माकं मनोः श्रुत्वानुशासनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2092390, "chapter_id": 2966, "verse_number": "१३-९६-३८", "content_sanskrit": "शुभं वा यच्च कुर्वन्ति प्रजा राज्ञा सुरक्षिताः।\nचतुर्थं तस्य पुण्यस्य राजा चाप्नोति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2092391, "chapter_id": 2966, "verse_number": "१३-९६-३९", "content_sanskrit": "जीवन्तं त्वानुजीवन्तु प्रजाः सर्वा युधिष्ठिर।\nपर्जन्यमिव भूतानि महाद्रुममिवाण्डजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2092392, "chapter_id": 2966, "verse_number": "१३-९६-४०", "content_sanskrit": "कुबेरमिव रक्षांसि शतक्रतुमिवामराः।\nज्ञातयस्त्वाऽनुजीवन्तु सुहृदश्च परन्तप॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2092393, "chapter_id": 2966, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि षण्णवतितमोऽध्यायः॥ ९६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]