[{"id": 7001031000, "chapter_id": 21031, "verse_number": "५-१३-१", "content_sanskrit": "गते शक्र तु गोपालाः कृष्णमक्लिष्टकारिणम् ।\nऊचुः प्रीत्या धृतं दृष्ट्वा तेन गोवर्द्धनाचलम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001031001, "chapter_id": 21031, "verse_number": "५-१३-२", "content_sanskrit": "वयमस्मान्महाबाहो! भवता महतो भयात् ।\nगावश्व भवता त्राता गिरिधारणकर्म्मणा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001031002, "chapter_id": 21031, "verse_number": "५-१३-३", "content_sanskrit": "बालीक्रीड़ेयमतुला गोपालत्वं जुगुप्सितम् ।\nदिव्यञ्च कर्म्म भवतः किमेतत् तात!कथ्यताम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001031003, "chapter_id": 21031, "verse_number": "५-१३-४", "content_sanskrit": "कालियो दमितस्तोये प्रलम्बो विनिपातितः ।\nधृतो गोवर्द्धनश्वायं शङ्कितानि मनांसि नः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001031004, "chapter_id": 21031, "verse_number": "५-१३-५", "content_sanskrit": "सत्यं सत्यं हरेः पादौ शापामीऽमितविक्रम ।\nयथा त्वद्रीर्य्यमालोक्य न त्वां मन्यामहे नरम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001031005, "chapter_id": 21031, "verse_number": "५-१३-६", "content_sanskrit": "प्रीतिः सस्त्रीकुमारस्य व्रजस्य तव केशव!\nकर्म्म चेदमशक्यं यत् समस्तैस्त्रिदशैरपि ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001031006, "chapter_id": 21031, "verse_number": "५-१३-७", "content_sanskrit": "बालत्वं चातिवीर्य्यञ्च जन्म जास्मास्वशोभनम् ।\nचिन्त्यमानममेयात्मन्!शङ्कां कृष्ण प्रयच्छति ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001031007, "chapter_id": 21031, "verse_number": "५-१३-८", "content_sanskrit": "देवो वा दानवो वा त्वं यक्षो गन्धर्व्व एव वा ।\nकिं वास्माकं विचारेण बान्धवोऽसि नमोऽस्तु ते ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001031008, "chapter_id": 21031, "verse_number": "५-१३-९", "content_sanskrit": "क्षणं भूत्वा त्वसौ तूष्णीं किञ्चित् प्रणयकोपवान् ।\nइत्येवमुक्तस्तैर्गोपैः कृष्णोऽप्याह महामुने ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001031009, "chapter_id": 21031, "verse_number": "५-१३-१०", "content_sanskrit": "मत्सम्बन्धेन भो गोपा! यदि लज्जा न जायते ।\nशलाध्यो वाहं ततऋः किं वो विचारेण प्रयोजनम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001031010, "chapter_id": 21031, "verse_number": "५-१३-११", "content_sanskrit": "यदि वोऽस्ति मयि प्रीतिः श्लाध्योऽहं भवतां यदि ।\nतदात्मबन्धुसदृशी बुद्धिर्वः क्रियतां मयि ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001031011, "chapter_id": 21031, "verse_number": "५-१३-१२", "content_sanskrit": "नाहं देवो न गन्धर्व्वो न यक्षो न च दानवः ।\nअहं वो बान्धवो जातो नास्ति चिन्त्यमतोऽन्यथा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001031012, "chapter_id": 21031, "verse_number": "५-१३-१३", "content_sanskrit": "इति श्रुत्वा हरेर्वाक्यं बद्धमौनास्ततो वनम् ।\nययूर्गोपा महाभाग!तस्मिन् प्रणयकोपितनि ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001031013, "chapter_id": 21031, "verse_number": "५-१३-१४", "content_sanskrit": "कृष्णस्तु विमलं व्योम शरच्चन्द्रस्य चन्दिरकाम् ।\nतथा कुमुदिनीं फुल्लामामोदितदिगन्तराम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001031014, "chapter_id": 21031, "verse_number": "५-१३-१५", "content_sanskrit": "वनराजिं तथा कूजदूभृङ्गमालां मनोरमाम् ।\nविलोक्य सह गोपीभिर्मनश्वक्र रतिं प्रति ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001031015, "chapter_id": 21031, "verse_number": "५-१३-१६", "content_sanskrit": "सह रामेणा मधुरमतीव वनिताप्रियम् ।\nजगौ कलपदं शौरिर्नानातन्त्री-कृतव्रतम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001031016, "chapter_id": 21031, "verse_number": "५-१३-१७", "content_sanskrit": "रम्यं गीतध्वनि श्रत्वा सन्त्यज्यावसथांस्तदा ।\nआजग्मुस्त्वरिता गोप्यो यत्रास्ते मधृसूदनः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001031017, "chapter_id": 21031, "verse_number": "५-१३-१८", "content_sanskrit": "शनैः शनैर्ज्जगौ गोपी काचित् तस्य लयानुगम् ।\nदत्तावधाना काचित्तू तमेव मनसास्मरत् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001031018, "chapter_id": 21031, "verse_number": "५-१३-१९", "content_sanskrit": "काचित् कृष्णेति कृष्णेति प्रेक्त्वा लज्जामुपागता ।\nययौ च काचित् प्रेमान्धा ततपार्श्वमविलज्जिता ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001031019, "chapter_id": 21031, "verse_number": "५-१३-२०", "content_sanskrit": "काचिदावसथस्यान्तः स्थिता दृष्ट्वा बहिर्गुरून् ।\nतन्मयत्वेन गोविन्दं दध्यौ मीलितलोचना ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001031020, "chapter_id": 21031, "verse_number": "५-१३-२१", "content_sanskrit": "तच्विन्ताविपुलाह्लाद-क्षीणपुणयचया तथा ।\nतदप्राप्ति-महादुःविलीनाशेषपातका ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001031021, "chapter_id": 21031, "verse_number": "५-१३-२२", "content_sanskrit": "चिन्तयन्ती जगत्सूतिं परब्रह्मस्वरूपिणम् ।\nनिरुच्छ्वासतया मुक्ति गतान्या गोपकन्यका ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001031022, "chapter_id": 21031, "verse_number": "५-१३-२३", "content_sanskrit": "गोपीपरिवृतो रात्रि शरचन्द्रमनोरमाम् ।\nमानयामास गोविन्दो रासारम्भरसोत्सुकः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001031023, "chapter_id": 21031, "verse_number": "५-१३-२४", "content_sanskrit": "गोप्यश्व वृन्दशः कृष्णचेष्टास्वायत्तमूर्त्तयः ।\nअन्यदेशं गते कृष्णो चेरुर्वृन्दावमान्तरम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001031024, "chapter_id": 21031, "verse_number": "५-१३-२५", "content_sanskrit": "कृष्णो निरुद्धह्टदया इदसूचुः परस्परम् ।\nकृष्णोऽहमेतल्ललितं व्रजाम्यालोक्यतां गतिः ।\nअन्या ब्रवीति कष्णस्य मम गीतिर्निशम्यताम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001031025, "chapter_id": 21031, "verse_number": "५-१३-२६", "content_sanskrit": "दुषृकालिय!तिष्ठात्र कृणोऽहमिति चापरा ।\nबाहुमास्फोठ्य कृष्णस्य लीलासर्व्वस्वमाददे ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001031026, "chapter_id": 21031, "verse_number": "५-१३-२७", "content_sanskrit": "अन्यां ब्रवीति भो गोपा!निः शङ्कः स्थीयतामिह ।\nअलं बृष्टिभयेनात्र धृतो गोवर्द्धनो मया ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001031027, "chapter_id": 21031, "verse_number": "५-१३-२८", "content_sanskrit": "धेनुकोऽयं मया क्षिप्तो विचरन्लु यथेच्छया ।\nगोपी ब्रवीति वै चान्या कृष्मालीलानुकारिणी ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001031028, "chapter_id": 21031, "verse_number": "५-१३-२९", "content_sanskrit": "एवं नानाप्रकारासु कृष्णचेष्टासु तास्तदा ।\nगोप्या व्यग्राः समं चरू रम्य वृन्दावनान्तरम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001031029, "chapter_id": 21031, "verse_number": "५-१३-३०", "content_sanskrit": "विलोक्यैका भुवं प्राह् गोपी गोपवराङ्गना ।\nपुलकाञ्चितसर्व्वाङ्गी विकाशि-नयनोत्पला ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001031030, "chapter_id": 21031, "verse_number": "५-१३-३१", "content_sanskrit": "ध्वजवज्राङ्कु शाब्जाङ्क-रेखावन्त्यालि पश्यत ।\nपदान्येतानि कृष्णस्य लीलालङ्कृतगामिनः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001031031, "chapter_id": 21031, "verse_number": "५-१३-३२", "content_sanskrit": "कापि तेम समं याता कृतपुण्या मदालसा ।\nपदानि तस्याश्चैतानि घनान्यल्पतनूनि च ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001031032, "chapter_id": 21031, "verse_number": "५-१३-३३", "content_sanskrit": "पुष्पावचयमत्रोच्चैश्वक्रे दामोदरो ध्रु वम् ।\nयेनाग्राक्रान्तिमात्राणि पदान्यत्र महात्मनः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001031033, "chapter_id": 21031, "verse_number": "५-१३-३४", "content_sanskrit": "अत्रोपविश्य सा तेन कापि पुष्पैरलङ्कृता ।\nअन्यजन्मनि सर्व्वात्मा विष्णुरभ्यर्ज्वितो ॥।।३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001031034, "chapter_id": 21031, "verse_number": "५-१३-३५", "content_sanskrit": "पुष्पबन्धनसम्मान-कृतमानामपास्य ताम् ।\nनन्दगोपसुतो यातो मार्गेणानेन पश्यत ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001031035, "chapter_id": 21031, "verse_number": "५-१३-३६", "content_sanskrit": "अनुयानेऽसमर्थान्या नितम्बभरमन्थरा ।\nया गन्तव्ये द्रुतं याति निम्रपादाग्रसंस्थितिः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001031036, "chapter_id": 21031, "verse_number": "५-१३-३७", "content_sanskrit": "हस्तन्यस्ताग्रहस्तेयं तेन याति तथा सखि!\nअनायत्तपदन्यासा लक्ष्यते पदपद्धतिः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001031037, "chapter_id": 21031, "verse_number": "५-१३-३८", "content_sanskrit": "हस्तसंस्पर्शमात्रेण धूर्त्तेनैषा विमानिता ।\nनैराश्यमन्दगामिन्या निवुत्तं लक्ष्यते पदम ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001031038, "chapter_id": 21031, "verse_number": "५-१३-३९", "content_sanskrit": "नूनमुक्ता त्वरामीति पुनरेष्यामि तेऽन्तिकम् ।\nतेन कृष्णेन येनैषा त्वरिता पदपद्धतिः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001031039, "chapter_id": 21031, "verse_number": "५-१३-४०", "content_sanskrit": "प्रविष्टो गहनं कृष्णः पदमत्र न लक्ष्यते ।\nनिवर्त्तध्व शशाङ्कस्य नैतद्दीधितिगोचरे ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001031040, "chapter_id": 21031, "verse_number": "५-१३-४१", "content_sanskrit": "निवृत्तास्तास्ततो गोप्यो निराशाः कृष्णदर्शने ।\nयमुनातीरमागत्य जगुस्तज्वरितं तदा ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001031041, "chapter_id": 21031, "verse_number": "५-१३-४२", "content_sanskrit": "ततो ददृशुरायान्तं विकाशिमुखपङ्कजम् ।\nगोप्यस्त्रैलोक्यगोप्तारं कृष्णमक्लिष्टचेष्टितम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001031042, "chapter_id": 21031, "verse_number": "५-१३-४३", "content_sanskrit": "काचिदालोक्य गोविन्दमायान्तमतिहर्षिता ।\nकूष्ण् कृष्णेति कृष्णेति प्राह नान्यदुदैरयत् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001031043, "chapter_id": 21031, "verse_number": "५-१३-४४", "content_sanskrit": "काचिदू भ्रू भङ्गुरं कृत्वा ललाटफलकं हरिम् ।\nविलोक्य नैत्रभृङ्गाभ्यां पपौ यन्मुखपङ्कजम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001031044, "chapter_id": 21031, "verse_number": "५-१३-४५", "content_sanskrit": "काचिदालोक्य गोविन्दं निमीलित-विलोचना ।\nतस्यैव रूपं ध्यायन्ती योगारूढ़ेव चाबभौ ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001031045, "chapter_id": 21031, "verse_number": "५-१३-४६", "content_sanskrit": "ततः काश्वित् प्रियालापैः काश्विदू भ्रू भङ्गवीक्षणः ।\nनिन्येऽनुनयमन्याञ्च करस्पर्शेन माघवः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001031046, "chapter_id": 21031, "verse_number": "५-१३-४७", "content_sanskrit": "ताभिः प्रसन्नचित्तामभिर्गोपीभिः सह सादरम् ।\nरराम रासगोष्ठीभिरुदारचरितो हरिः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001031047, "chapter_id": 21031, "verse_number": "५-१३-४८", "content_sanskrit": "रासमणडलबन्धोऽपि कृष्णपार्श्वमनुजूझता ।\nगोपीजनेन नैवाभूदेकस्थानस्थिरात्मना ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001031048, "chapter_id": 21031, "verse_number": "५-१३-४९", "content_sanskrit": "हर्ते प्रगृह्य चैकैकां गोपिकां रासमणडलीम् ।\nचकार तत्करस्पर्श-निमीलितदृशं हरिः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001031049, "chapter_id": 21031, "verse_number": "५-१३-५०", "content_sanskrit": "ततः स ववृते रासश्वलदूवलयनिः स्वनः ।\nअनुयातशरतूकाव्यगेयगीतिरनुक्रमात् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001031050, "chapter_id": 21031, "verse_number": "५-१३-५१", "content_sanskrit": "कृष्णाः शरज्वन्द्रमसं कौमुदीं कुमुदाकरम् ।\nजगौ गोपीजनस्त्वेकं कूष्णनाम पुनः पुनः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001031051, "chapter_id": 21031, "verse_number": "५-१३-५२", "content_sanskrit": "परिवर्त्तश्रमेणोक चलदूवलयलापिनीम् ।\nददौ बाहुलतां स्कन्धे गोपी मधुनिघातिनः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001031052, "chapter_id": 21031, "verse_number": "५-१३-५३", "content_sanskrit": "काचित् प्रविलसदूबाहुः परिरभ्य चुचुम्ब तम् ।\nगोपी गीतस्तुतिव्याज-निपुणा मधुसूदनम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001031053, "chapter_id": 21031, "verse_number": "५-१३-५४", "content_sanskrit": "गोपी-कपोल-संश्लेषमभिपत्य हरेभुर्जौ ।\nपुलकोदूगमशस्याय स्वेदाम्बुघनतां गतौ ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001031054, "chapter_id": 21031, "verse_number": "५-१३-५५", "content_sanskrit": "रासगेयं जगौ कृष्णेति यावत् तारतरध्वनिः ।\nसाधु कृष्णेति कृष्णेतितावत् ता द्रिगुणं अगुः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001031055, "chapter_id": 21031, "verse_number": "५-१३-५६", "content_sanskrit": "गते तु गमनं चक्रु र्वलने सम्मुखं ययुः ।\nप्रतिलोमानुलोमाब्यां भेजुर्गोपाङ्गना हरिम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001031056, "chapter_id": 21031, "verse_number": "५-१३-५७", "content_sanskrit": "स तथा सह गोपीभी रराम मघुसूदनः ।\nयथाब्दकोटिप्रमितः क्षणस्तेन विनामवत् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001031057, "chapter_id": 21031, "verse_number": "५-१३-५८", "content_sanskrit": "ता वार्य्यमाणाः पतिभिः पितृभिर्भ्रातृभिस्तथा ।\nकृष्णां गोपाङ्गना रात्रौ रमयन्ति रतिप्रियाः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001031058, "chapter_id": 21031, "verse_number": "५-१३-५९", "content_sanskrit": "सोऽपि कैशोरकवयो मानयन् मधुसूदनः ।\nरेमे ताभिरमेयात्मा क्षपासु क्षपिताहितः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001031059, "chapter_id": 21031, "verse_number": "५-१३-६०", "content_sanskrit": "तद्भर्त्तृषु तथा तासु सर्व्वभूतेषु चेश्वरः ।\nआत्मखरूपरूपोऽसौ व्याप्य सर्व्वमवस्थितः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001031060, "chapter_id": 21031, "verse_number": "५-१३-६१", "content_sanskrit": "यथा समस्तभूतेषु नभोऽग्रिः पृथिवी जलम् ।\nवायुश्वात्मा तथैवासौ व्याप्य सर्व्वमवस्थितः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}]