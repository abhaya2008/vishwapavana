[{"id": 2202794, "chapter_id": 5317, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2202795, "chapter_id": 5317, "verse_number": "१", "content_sanskrit": "अकामाश्च सकामाश्च हता येऽस्मिन् महाहवे ।\nकां गतिं प्रतिपद्यन्ते तन्मे ब्रूहि पितामह\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2202796, "chapter_id": 5317, "verse_number": "२", "content_sanskrit": "दुःखं प्राणपरित्यागः पुरुषाणां महामृधे ।\nजानामि तत्त्वं धर्मज्ञ प्राणत्यागः सुदुष्करः\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2202797, "chapter_id": 5317, "verse_number": "३", "content_sanskrit": "समृद्धे वाऽसमृद्धे वा शुभे वा यदि वाऽशुभे ।\nकारणं तत्र मे ब्रूहि सर्वज्ञो ह्यसि मे मतः\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2202798, "chapter_id": 5317, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2202799, "chapter_id": 5317, "verse_number": "४", "content_sanskrit": "समृद्धे वाऽसमृद्धे वा शुभे वा यदि वाऽशुभे ।\nसंसारेऽस्मिन् समाजाताः प्राणिनः पृथिवीपते\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2202800, "chapter_id": 5317, "verse_number": "५", "content_sanskrit": "निरता येन भावेन तत्र मे शृणु कारणम् ।\nसम्यक्चायमनुप्रश्नस्त्वयोक्तश्च युधिष्ठिर\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2202801, "chapter_id": 5317, "verse_number": "६", "content_sanskrit": "अत्र ते वर्तयिष्यामि पुरावृत्तमिदं नृप ।\nद्वैपायनस्य संवादं कीटस्य च युधिष्ठिर\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2202802, "chapter_id": 5317, "verse_number": "७", "content_sanskrit": "ब्रह्मभूतश्चरन् विप्रः कृष्णद्वैपायनः पुरा ।\nददर्श कीटं धावन्तं शीघ्रं शकटवर्त्मनि\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2202803, "chapter_id": 5317, "verse_number": "८", "content_sanskrit": "गतिज्ञः सर्वभूतानां रुतज्ञश्च शरीरिणाम् ।\nसर्वज्ञः सर्वदर्शी च कीटं वचनमब्रवीत्\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2202804, "chapter_id": 5317, "verse_number": "९", "content_sanskrit": "कीट सन्त्रस्तरूपोऽसि त्वरितश्चैव लक्ष्यसे ।\nक्व धावसि तदाचक्ष्व कुतस्ते भयमागतम्\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2202805, "chapter_id": 5317, "verse_number": "", "content_sanskrit": "कीटः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2202806, "chapter_id": 5317, "verse_number": "१०", "content_sanskrit": "शकटस्यास्य महतो घोषं श्रुत्वा भयं मम ।\nआगतं वै महाबुद्धे स्वन एष हि दारुणः ।\nश्रूयते न स मां हन्यादिति तस्मादपाक्रमे\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2202807, "chapter_id": 5317, "verse_number": "११", "content_sanskrit": "श्वसतां च शृणोम्येवं गोपुत्राणां प्रचोद्यताम् ।\nवहतां सुमहाभारं सन्निकर्षे स्वनं प्रभो ।\nनृणां च संवाहयतां श्रूयन्ते विविधाः स्वनाः\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2202808, "chapter_id": 5317, "verse_number": "१२", "content_sanskrit": "सोढुमस्मद्विधेनैष न शक्यः कीटयोनिना ।\nतस्मादपक्रमाम्येष भयादस्मात् सुदारुणात्\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2202809, "chapter_id": 5317, "verse_number": "१३", "content_sanskrit": "दुःखं हि मृत्युर्भूतानां जीवितं च सुदुर्लभम् ।\nअतो भीतः पलायामि गच्छेयं नासुखं सुखात्\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2202810, "chapter_id": 5317, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2202811, "chapter_id": 5317, "verse_number": "१४", "content_sanskrit": "इत्युक्तः स तु तं प्राह कुतः कीट सुखं तव ।\nमरणं ते सुखं मन्ये तिर्यग्योनौ हि वर्तसे\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2202812, "chapter_id": 5317, "verse_number": "१५", "content_sanskrit": "शब्दं स्पर्शं रसं गन्धं भोगांश्चोच्चावचान् बहून् ।\nनाभिजानासि कीट त्वं श्रेयो मरणमेव ते\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2202813, "chapter_id": 5317, "verse_number": "", "content_sanskrit": "कीटः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2202814, "chapter_id": 5317, "verse_number": "१६", "content_sanskrit": "सर्वत्र निरतो जीव इतीहापि सुखं मम ।\nचेतयामि महाप्राज्ञ तस्मादिच्छामि जीवितम्\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2202815, "chapter_id": 5317, "verse_number": "१७", "content_sanskrit": "इहापि विषयः सर्वो यथादेहं प्रवर्तितः ।\nमानुषास्तिर्यगाश्चैव पृथग्भोगा विशेषतः\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2202816, "chapter_id": 5317, "verse_number": "१८", "content_sanskrit": "अहमासं मनुष्यो वै शूद्रो बहुधनः पुरा ।\nअब्रह्मण्यो नृशंसश्च कदर्यो वृद्धिजीवनः\t ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2202817, "chapter_id": 5317, "verse_number": "१९", "content_sanskrit": "वाक्तीक्ष्णो निकृतिप्रज्ञो मोष्टा विश्वस्य सर्वशः ।\nमिथःकृतोऽपनिधनः परस्वहरणे रतः\t ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2202818, "chapter_id": 5317, "verse_number": "२०", "content_sanskrit": "भृत्यातिथिजनश्चापि गृहे पर्युषितो मया ।\nमात्सर्यात् स्वादुकामेन नृशंसेन बुभूषता\t ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2202819, "chapter_id": 5317, "verse_number": "२१", "content_sanskrit": "देवार्थं पितृयज्ञार्थमन्नं श्रद्धाकृतं मया ।\nन दत्तमर्थकामेन दत्तमन्नं लुनामि च\t ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2202820, "chapter_id": 5317, "verse_number": "२२", "content_sanskrit": "गुप्तं शरणमाश्रित्य भयेषु शरणागताः ।\nअकस्मान्नो भयात् त्यक्ता न च त्राताऽभयैषिणः\t ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2202821, "chapter_id": 5317, "verse_number": "२३", "content_sanskrit": "धनधान्यं प्रिया दारा यानं वासस्तथाऽद्भुतम् ।\nश्रियं दृष्ट्वा मनुष्याणामसूयामि निरर्थकम्\t ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2202822, "chapter_id": 5317, "verse_number": "२४", "content_sanskrit": "ईर्ष्युः परसुखं दृष्ट्वा आतताय्यबुभूषकः ।\nत्रिवर्गहन्ता चान्येषां मूर्खाणां चानुवर्तिता\t ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2202823, "chapter_id": 5317, "verse_number": "२५", "content_sanskrit": "नृशंसगुणभूयिष्ठं पुरा कर्म कृतं मया ।\nस्मृत्वा तदनुतप्येऽहं त्यक्त्वा प्रियमिवात्मजम्\t ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2202824, "chapter_id": 5317, "verse_number": "२६", "content_sanskrit": "शुभानामपि जानामि कृतानां कर्मणां फलम् ।\nमाता च पूजिता वृद्धा ब्राह्मणाश्चार्चिता मया\t ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2202825, "chapter_id": 5317, "verse_number": "२७", "content_sanskrit": "सकृज्जातिगुणोपेतः सङ्गत्या गृहमागतः ।\nअतिथिः पूजितो ब्रह्मन् तेन मां नाजहात् स्मृतिः\t ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2202826, "chapter_id": 5317, "verse_number": "२८", "content_sanskrit": "कर्मणा तेन चैवाहं सुखाशामिह लक्षये ।\nतच्छ्रोतुमहमिच्छामि त्वत्तः श्रेयस्तपोधन\t ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2202827, "chapter_id": 5317, "verse_number": "", "content_sanskrit": "॥इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे व्यासकीटसंवादो नाम अष्टषष्ट्युत्तरशततमोऽध्यायः ॥१६८॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]