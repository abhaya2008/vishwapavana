[{"id": 2134966, "chapter_id": 3919, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2134967, "chapter_id": 3919, "verse_number": "१", "content_sanskrit": "अजानतस्ते राधेय नाभ्यसूयाम्यहं वचः ।\nजानासि त्वं जिताञ्छत्रून् गन्धर्वांस्तेजसा मया \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2134968, "chapter_id": 3919, "verse_number": "२", "content_sanskrit": "आयोधितास्तु गन्धर्वाः सुचिरं सोदरैर्मम ।\nमया सह महाबाहो कृतश्चोभयतः क्षयः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2134969, "chapter_id": 3919, "verse_number": "३", "content_sanskrit": "मायाधिकास्त्वयुध्यन्त यदा शूरा वियद्गताः ।\nतदा नो न समं युद्धमभवत् खेचरैः सह \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2134970, "chapter_id": 3919, "verse_number": "", "content_sanskrit": "असमर्थास्ततस्तांस्तु प्रतियोद्धुं वियद्गतान् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2134971, "chapter_id": 3919, "verse_number": "४", "content_sanskrit": "पराजयं च प्राप्ताः स्मो रणे बन्धनमेव च ।\nसभृत्यामात्यपुत्राश्च सदारबलवाहनाः ।\nउच्चैराकाशमार्गेण ह्रियामस्तैः सुदुःखिताः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2134972, "chapter_id": 3919, "verse_number": "५", "content_sanskrit": "अथ नः सैनिकाः केचिदमात्याश्च महारथान् ।\nउपगम्याब्रुवन् दीनाः पाण्डवाञ्छरणप्रदान् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2134973, "chapter_id": 3919, "verse_number": "६", "content_sanskrit": "एष दुर्योधनो राजा धार्तराष्ट्रः सहानुजः ।\nसामात्यदारो ह्रियते गन्धर्वैर्दिवमास्थितैः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2134974, "chapter_id": 3919, "verse_number": "७", "content_sanskrit": "तं मोक्षयत भद्रं वः सहदारं नराधिपम् ।\nपरामर्षो मा भवतां कुरुदारेषु सर्वशः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2134975, "chapter_id": 3919, "verse_number": "८", "content_sanskrit": "एवमुक्ते तु धर्मात्मा ज्येष्ठः पाण्डुसुतस्तदा ।\nप्रसाद्य सोदरान् सर्वानाज्ञापयत मोक्षणे \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2134976, "chapter_id": 3919, "verse_number": "९", "content_sanskrit": "अथागम्य तमुद्देशं पाण्डवाः पुरुषर्षभाः ।\nसान्त्वपूर्वमयाचन्त शक्ताः सन्तो महारथाः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2134977, "chapter_id": 3919, "verse_number": "१०", "content_sanskrit": "यदा चास्मान् न मुमुचुर्गन्धर्वाः सान्त्विता अपि ।\nआकाशचारिणो वीरा नदन्तो जलदा इव \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2134978, "chapter_id": 3919, "verse_number": "११", "content_sanskrit": "ततोऽर्जुनश्च भीमश्च यमजौ च बलोत्कटौ ।\nमुमुचुः शरवर्षाणि गन्धर्वान् प्रत्यनेकशः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2134979, "chapter_id": 3919, "verse_number": "१२", "content_sanskrit": "अथ सर्वे रणं मुक्त्वा प्रयाताः खेचरा दिवम् ।\nअस्मानेवाभिकर्षन्तो दीनान् मुदितमानसाः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2134980, "chapter_id": 3919, "verse_number": "१३", "content_sanskrit": "ततः समन्तात् पश्यामः शरजालेन वेष्टिताः ।\nअमानुषाणि चास्त्राणि प्रमुञ्चन्तं धनञ्जयम् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2134981, "chapter_id": 3919, "verse_number": "१४", "content_sanskrit": "समावृता दिशो दृष्ट्वा पाण्डवेन शितैः शरैः ।\nधनञ्जयसखाऽऽत्मानं दर्शयामास वै तदा \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2134982, "chapter_id": 3919, "verse_number": "१५", "content_sanskrit": "चित्रसेनः पाण्डवेन समाश्लिष्य परस्परम् ।\nकुशलं परिपप्रच्छ तैः पृष्टश्चाप्यनामयम् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2134983, "chapter_id": 3919, "verse_number": "१६", "content_sanskrit": "ते समेत्य तथान्योन्यं सदारान् विप्रमोच्य च ।\nएकीभूतास्ततो वीरा गन्धर्वाः पाण्डवैः सह \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2134984, "chapter_id": 3919, "verse_number": "१७", "content_sanskrit": "अपूजयेतामन्योन्यं चित्रसेनधनञ्जयौ ।\nपरस्परं समागम्य प्रीत्या परमया युताः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2134985, "chapter_id": 3919, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि घोषयात्रापर्वणि दुर्योधनवाक्ये सप्तत्रिंशदधिकद्विशततमोऽध्यायः ॥२३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2134986, "chapter_id": 3919, "verse_number": "", "content_sanskrit": "प्रायोपवेशपर्वणि द्वितीयोऽध्यायः ॥२॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]