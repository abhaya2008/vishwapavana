[{"id": 900004080, "chapter_id": 8318, "verse_number": "14.1", "content_sanskrit": "कृत्वा दैत्यवधं कृष्णः सरामो यदुभिर्वृतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900004081, "chapter_id": 8318, "verse_number": "14.2", "content_sanskrit": "गोविन्दभुजगुप्तायां द्वारकायां कुरूद्वह", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900004082, "chapter_id": 8318, "verse_number": "14.3", "content_sanskrit": "परस्य विष्णोरीशस्य मायिनामपि मोहिनीम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900004083, "chapter_id": 8318, "verse_number": "14.4", "content_sanskrit": "यानि यानीह कर्माणि यैर्यैः स्वच्छन्दजन्मभिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900004084, "chapter_id": 8318, "verse_number": "14.5", "content_sanskrit": "भगवन्तं हरिं प्रायो न भजन्त्यात्मवित्तमाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900004085, "chapter_id": 8318, "verse_number": "14.6", "content_sanskrit": "अथ ब्रह्मात्मजैर्दैवैः प्रजेशैरावृतोऽभ्यगात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900004086, "chapter_id": 8318, "verse_number": "14.7", "content_sanskrit": "यदात्थ मां महाभाग तच्चिकीर्षितमेव मे", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900004087, "chapter_id": 8318, "verse_number": "14.8", "content_sanskrit": "सुखमैन्द्रियकं राजन् स्वर्गे नरक एव च", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900004088, "chapter_id": 8318, "verse_number": "14.9", "content_sanskrit": "परिग्रहोऽयं दुःखाय यद्यत् प्रियतमं नृणाम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900004089, "chapter_id": 8318, "verse_number": "14.10", "content_sanskrit": "मयोदितेष्ववहितः स्वधर्मेषु मदाश्रयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900004090, "chapter_id": 8318, "verse_number": "14.11", "content_sanskrit": "बद्धो मुक्त इति ह्याख्या गुणतो मे न वस्तुतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900004091, "chapter_id": 8318, "verse_number": "14.12", "content_sanskrit": "न रोधयति मां योगो न साङ्ख्यं धर्म एव च", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900004092, "chapter_id": 8318, "verse_number": "14.13", "content_sanskrit": "सत्वं रजस्तम इति गुणा बुद्धेर्न चात्मनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900004093, "chapter_id": 8318, "verse_number": "14.14", "content_sanskrit": "वदन्ति कृष्ण श्रेयांसि बहूनि ब्रह्मवादिनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900004094, "chapter_id": 8318, "verse_number": "14.15", "content_sanskrit": "जितेन्द्रियस्य युक्तस्य जितश्वासस्य योगिनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900004095, "chapter_id": 8318, "verse_number": "14.16", "content_sanskrit": "त्वं ब्रह्म परमं साक्षादनाद्यन्तमपावृतम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900004096, "chapter_id": 8318, "verse_number": "14.17", "content_sanskrit": "यस्त्वयाऽभिहितः पूर्वं धर्मस्त्वद्भक्तिलक्षणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900004097, "chapter_id": 8318, "verse_number": "14.18", "content_sanskrit": "वनं विविक्षुः पुत्रेषु भार्यां न्यस्य सहैव वा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900004098, "chapter_id": 8318, "verse_number": "14.19", "content_sanskrit": "यो विद्याश्रुतसम्पन्न आत्मवानानुमानिकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 900004099, "chapter_id": 8318, "verse_number": "14.20", "content_sanskrit": "विधिश्च प्रतिषेधश्च निगमो हीश्वरस्य ते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 900004100, "chapter_id": 8318, "verse_number": "14.21", "content_sanskrit": "य एतान् मत्पथो हित्वा भक्तिज्ञानक्रियात्मकान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 900004101, "chapter_id": 8318, "verse_number": "14.22", "content_sanskrit": "कानि तत्वानि विश्वेश सङ्ख्यातान्यृषिभिः प्रभो", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 900004102, "chapter_id": 8318, "verse_number": "14.23", "content_sanskrit": "स एवमाशंसित उद्धवेन भागवतमुख्येन दशार्हवर्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 900004103, "chapter_id": 8318, "verse_number": "14.24", "content_sanskrit": "अथ ते सम्प्रवक्ष्यामि साङ्ख्यं पूर्वविनिश्चितम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 900004104, "chapter_id": 8318, "verse_number": "14.25", "content_sanskrit": "गुणानामप्यमिश्राणां पुमान् येन यथा भवेत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 900004105, "chapter_id": 8318, "verse_number": "14.26", "content_sanskrit": "मल्लक्षणमिमं कायं लब्ध्वा मद्धर्ममास्थितः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 900004106, "chapter_id": 8318, "verse_number": "14.27", "content_sanskrit": "क्रियायोगं समाचक्ष्व भवदाराधनं प्रभो", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 900004107, "chapter_id": 8318, "verse_number": "14.28", "content_sanskrit": "परस्वभावकर्माणि न प्रशंसेन्न गर्हयेत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 900004108, "chapter_id": 8318, "verse_number": "14.29", "content_sanskrit": "सुदुश्चरामिमां मन्ये योगचर्यामनात्म(ना)नः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 900004109, "chapter_id": 8318, "verse_number": "14.30", "content_sanskrit": "ततो महाभागवत उद्धवे बदरीं गते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 900004110, "chapter_id": 8318, "verse_number": "14.31", "content_sanskrit": "अथ तत्रागमद् ब्रह्मा भवान्या च समं भवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]