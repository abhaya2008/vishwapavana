[{"id": 2034407, "chapter_id": 1742, "verse_number": "४-६५-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2034408, "chapter_id": 1742, "verse_number": "४-६५-१", "content_sanskrit": "कर्णं पराजितं दृष्ट्वा पार्थो वैराटिमब्रवीत्।\nएतं मां प्रापयेदानीं रथवृन्दं प्रहारिणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2034409, "chapter_id": 1742, "verse_number": "४-६५-२", "content_sanskrit": "यत्र शान्तनवो भीष्मः सर्वेषां नः पितामहः ।\nसुयुद्धं काङ्क्षमाणो वै रथे तिष्ठति दंशितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2034410, "chapter_id": 1742, "verse_number": "४-६५-३", "content_sanskrit": "तालो वै काञ्चनो यत्र वज्रवैडूर्यभूषितः ।\nअतीव समरे भाति मातरिश्वप्रकम्पितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2034411, "chapter_id": 1742, "verse_number": "४-६५-४", "content_sanskrit": "दारुणं प्रहरिष्यामि रथबृन्दानि धन्विनाम्।\nआदास्याम्यहमेतेषां धनुर्ज्यावेष्टनानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2034412, "chapter_id": 1742, "verse_number": "४-६५-५", "content_sanskrit": "अस्यन्तं दिव्यमस्त्राणि चित्रमुत्तर पश्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2034413, "chapter_id": 1742, "verse_number": "४-६५-६", "content_sanskrit": "शतह्रदां जृम्भमाणां मेघस्थां प्रावृषीव च।\nसुवर्णपृष्ठं गाण्डीवं पश्यन्तु कुरवो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2034414, "chapter_id": 1742, "verse_number": "४-६५-७", "content_sanskrit": "दक्षिणेनाथ वामेन कतमेन स्विदस्यति।\nइति मां शत्रवः सर्वे न विज्ञास्यन्ति सारथे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2034415, "chapter_id": 1742, "verse_number": "४-६५-८", "content_sanskrit": "अस्त्रोदकां हयावर्तां नागनक्रां रथह्रदाम्।\nनदीं प्रस्कन्दयिष्यामि परलोकापहारिणीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2034416, "chapter_id": 1742, "verse_number": "४-६५-९", "content_sanskrit": "पाणिपादशिरःपृष्ठबाहुशङ्खचराचरम्।\nवनं कुरूणां छेत्स्यामि भल्लैः सन्नतपर्वभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2034417, "chapter_id": 1742, "verse_number": "४-६५-१०", "content_sanskrit": "तूणीशयाः सुपुङ्खाग्रा विशिखा दुन्दुभिस्वनाः।\nमया प्रमुक्ताः संग्रामे कुरून्धक्ष्यन्ति सायकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2034418, "chapter_id": 1742, "verse_number": "४-६५-११", "content_sanskrit": "ध्वजवृक्षं शरतृणं नागाश्वश्वापदाकुलम् ।\nरथसिंहगणैर्युक्तं धनुर्वल्लिसमाकुलम्।\nवनमादीपयिष्यामि कुरूणामस्त्रतेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2034419, "chapter_id": 1742, "verse_number": "४-६५-१२", "content_sanskrit": "जयतो भारतीं सेनामेकस्य मम संयुगे।\nशतं मार्गा भविष्यन्ति पावकस्येव कानने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2034420, "chapter_id": 1742, "verse_number": "४-६५-१३", "content_sanskrit": "मया चक्रमिवाविद्धं सैन्यं द्रक्ष्यसि केवलम् ।\nतानहं रथनीडेभ्यः परलोकाय शात्रवान्।\nएकः प्रद्रावयिष्यामि चक्रपाणिरिवासुरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2034421, "chapter_id": 1742, "verse_number": "४-६५-१४", "content_sanskrit": "असंभ्रान्तो रथे तिष्ठन्समेषु विषमेषु च।\nमार्गमावृत्य तिष्ठन्तमपि भेत्स्यामि पर्वतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2034422, "chapter_id": 1742, "verse_number": "४-६५-१५", "content_sanskrit": "अहमिन्द्रस्य संग्रामे द्विषतो बलदर्पितान्।\nमातलिं सारथिं कृत्वा निवातकवचान्रणे ।\nहतवान्सर्वतः सर्वान्धावतो युध्यतस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2034423, "chapter_id": 1742, "verse_number": "४-६५-१६", "content_sanskrit": "निवातकवचान्हत्वा गाण्डीवास्त्रैः सहस्रशः ।\nपरं पारे समुद्रस्य हिरण्यपुरमारुजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2034424, "chapter_id": 1742, "verse_number": "४-६५-१७", "content_sanskrit": "हत्वा षष्टिसहस्राणि रथानामुग्रधन्विनाम्।\nपौलोमान्कालकेयांश्च समरे भृशदारुणान् ।\nअसुरानहनं घोरान्रौद्रेणास्त्रेण सारथे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2034425, "chapter_id": 1742, "verse_number": "४-६५-१८", "content_sanskrit": "अहमिन्द्राद्दृढां मुष्टिं ब्रह्मणः क्षिप्रहस्तताम् ।\nप्रगाढनिपुणं चित्रमतिवृद्धं प्रजापतेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2034426, "chapter_id": 1742, "verse_number": "४-६५-१९", "content_sanskrit": "रौद्रं रुद्रादहं वेद्मि वारुणं वरुणादपि ।\nसौर्यं सूर्यादहं वेद्मि याम्यं दण्डधरादपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2034427, "chapter_id": 1742, "verse_number": "४-६५-२०", "content_sanskrit": "अस्त्रमाग्नेयमग्नेश्च वायव्यं मातरिश्वनः।\nअन्यैर्देवैरहं प्राप्तः को मां विषहते पुमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2034428, "chapter_id": 1742, "verse_number": "४-६५-२१", "content_sanskrit": "अद्य गाण्डीवनिर्मुक्तैःशरौघै रोमहर्षणैः ।\nकुरूणां पातयिष्यामि रथवृन्दानि धन्विनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2034429, "chapter_id": 1742, "verse_number": "४-६५-२२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2034430, "chapter_id": 1742, "verse_number": "४-६५-२२", "content_sanskrit": "एवमाश्वासितस्तेन वैराटिः सव्यसाचिना।\nव्यगाहत रथानीकं भीमं भीष्मस्य वाजिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2034431, "chapter_id": 1742, "verse_number": "४-६५-२३", "content_sanskrit": "रथिसिंहमनाधृष्यं जिगीषन्तं परान्रणे।\nअभ्यधावत्तदैवोग्रो ज्यां विकर्षन्धनञ्जयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2034432, "chapter_id": 1742, "verse_number": "४-६५-२४", "content_sanskrit": "दुःशासनोऽभ्ययात्तूर्णमर्जुनं भरतर्षभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2034433, "chapter_id": 1742, "verse_number": "४-६५-२५", "content_sanskrit": "अन्येऽपि चित्राभरणा युवानो मृष्टकुण्डलाः ।\nअभ्ययुर्भीमधन्वानो मौवी पर्यस्य बाहुभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2034434, "chapter_id": 1742, "verse_number": "४-६५-२६", "content_sanskrit": "दुःशासनो विकर्णश्च वृषसेनो विविशतिः।\nअभीता भीमधन्वानं पाण्डवं पर्यवारयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2034435, "chapter_id": 1742, "verse_number": "४-६५-२७", "content_sanskrit": "तस्य दुःशासनः षष्टिं वामपार्श्वे समार्पयत्।\nअस्यतः प्रतिसन्धाय कुन्तीपुत्रस्य धीमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2034436, "chapter_id": 1742, "verse_number": "४-६५-२८", "content_sanskrit": "पुनश्चैव स भल्लेन विद्ध्वा वैराटिमुत्तरम् ।\nद्वितीयेनार्जुनं वीरं प्रत्यविध्यत्स्तनान्तरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2034437, "chapter_id": 1742, "verse_number": "४-६५-२९", "content_sanskrit": "तस्य जिष्णुरुदावृत्य क्षुरधारेण कार्मुकम्।\nप्राकृन्तद्गृध्रपत्रेण जातरूपपरिष्कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2034438, "chapter_id": 1742, "verse_number": "४-६५-३०", "content_sanskrit": "अथैनं पञ्चभिर्बाणैः प्रत्यविध्यत्स्तनान्तरे।\nसोपयातो रथोपस्थात्पार्थबाणाभिपीडितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2034439, "chapter_id": 1742, "verse_number": "४-६५-३१", "content_sanskrit": "सर्वा दिशश्चाभ्यपतद्बीभत्सुरपाराजितः।\nतं विकर्णः शरैस्तीक्ष्णैर्गृध्रपक्षैः शिलाशितैः।\nविव्याध परवीरध्नमर्जुनं धृतराष्ट्रजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2034440, "chapter_id": 1742, "verse_number": "४-६५-३२", "content_sanskrit": "ततस्तमपि कौन्तेयः शरेण नतपर्वणा ।\nललाटेऽभ्यहनद्गाढं स विद्धः प्राद्रवद्भयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2034441, "chapter_id": 1742, "verse_number": "४-६५-३३", "content_sanskrit": "ततः पार्थमुपाद्रुत्य दुस्सहः सविविंशतिः।\nअवाकिरच्छरैस्तीक्ष्णैः परीप्सन्भ्रातरं रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2034442, "chapter_id": 1742, "verse_number": "४-६५-३४", "content_sanskrit": "तावुभौ गृध्रपत्राभ्यां निशिताभ्यां धनञ्जयः।\nविव्याध युगपद्व्यग्रस्तयोर्वाहानसूदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2034443, "chapter_id": 1742, "verse_number": "४-६५-३५", "content_sanskrit": "तौ हताश्वौ तु विद्धाङ्गौ धृतराष्ट्रात्मजावुभौ ।\nअभिपत्य रथैरन्यैरपनीतौ पदानुगैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2034444, "chapter_id": 1742, "verse_number": "४-६५-३६", "content_sanskrit": "व्यद्रावयदशेषांश्च धृतराष्ट्रसुतांस्तदा ।\nविद्राव्य च रणे पार्थो रणभूमिं व्यराजयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2034445, "chapter_id": 1742, "verse_number": "४-६५-३७", "content_sanskrit": "किरीटमाली कौन्तेयो लब्धलक्षः प्रतापवान् ।\nपातयन्नुत्तमाङ्गानि बाहूश्च परिघोपमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2034446, "chapter_id": 1742, "verse_number": "४-६५-३८", "content_sanskrit": "अशेरत महावीराः शतशो रुक्ममालिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2034447, "chapter_id": 1742, "verse_number": "४-६५-३९", "content_sanskrit": "कमलदिनकरेन्दुसन्निभैः सितदशनैः सुमुखाक्षिनासिकैः।\nरुचिरमकरकुण्डलैर्मही पुरुषशिरोभिरथास्तृता बभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2034448, "chapter_id": 1742, "verse_number": "४-६५-४०", "content_sanskrit": "सुनसं चारुदीप्ताश्चं क्लृप्तश्मश्रु स्वलंकृतम् ।\nअदृश्यत शिरश्छिन्नमनेकं हेमकुण्डलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2034449, "chapter_id": 1742, "verse_number": "४-६५-४१", "content_sanskrit": "एवं तत्प्रहतं सैन्यं समन्तात्प्रद्रुतं भयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2034450, "chapter_id": 1742, "verse_number": "४-६५-४२", "content_sanskrit": "अथ दुर्योधनः कर्णः सौबलः शकुनिस्तदा।\nद्रोणश्च द्रोणपुत्रश्च कृपश्चातिरथो रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2034451, "chapter_id": 1742, "verse_number": "४-६५-४३", "content_sanskrit": "सहिता विजयं तत्र योधयन्तो महारथाः।\nविष्फारयन्तश्चापानि बलवन्ति महाबलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2034452, "chapter_id": 1742, "verse_number": "४-६५-४४", "content_sanskrit": "ततः कीर्णपताकेन रथेनादित्यवर्चसा।\nपुनरावृत्य मार्गस्थं ददृशुर्वानरध्वजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2034453, "chapter_id": 1742, "verse_number": "४-६५-४५", "content_sanskrit": "ते महास्त्रैर्महेष्वासाः परिवार्य धनञ्जयम्।\nअभ्यवर्षन्सुसंक्रुद्धा महामेघा इवाचलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2034454, "chapter_id": 1742, "verse_number": "४-६५-४६", "content_sanskrit": "शरौघान्सम्यगस्यन्तो जीमूता इव शारदाः ।\nयुद्धे तस्थुर्महावीर्याः प्रतपन्तः किरीटिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2034455, "chapter_id": 1742, "verse_number": "४-६५-४७", "content_sanskrit": "इषुभिर्बहुभिस्तूर्णं निशितैर्लोमवापिभिः ।\nअदूरात्प्रत्यवस्थाय पाण्डवं समयोधयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2034456, "chapter_id": 1742, "verse_number": "४-६५-४८", "content_sanskrit": "ततः प्रहस्य बीभत्सुस्तमैन्द्रं पञ्चवार्षिकम् ।\nअस्त्रमादित्यसंकाशं गाण्डीवे समयोजयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2034457, "chapter_id": 1742, "verse_number": "४-६५-४९", "content_sanskrit": "नाक्षणां न च चक्राणां न रथानां न वाजिनाम् ।\nअङ्गुलाद्दव्यङ्गुलाद्वापि विवृतं प्रत्यदृश्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2034458, "chapter_id": 1742, "verse_number": "४-६५-५०", "content_sanskrit": "यथा रश्मिभिरादित्यो वृणुते सर्वतो दिशम्।\nएवं किरीटिना मुक्तं सर्वं प्राच्छादयञ्जगत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2034459, "chapter_id": 1742, "verse_number": "४-६५-५१", "content_sanskrit": "यथा बलाहके विद्युत्पावको वा शिलोच्चये।\nतथा गाण्डीवमभवच्चक्राभुधमिवाततम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2034460, "chapter_id": 1742, "verse_number": "४-६५-५२", "content_sanskrit": "यथा वर्षति पर्जन्यो विद्युत्पतति पर्वते।\nविस्फूर्जिता दिशः सर्वा ज्वलद्गाण्डीवमावृणोत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2034461, "chapter_id": 1742, "verse_number": "४-६५-५३", "content_sanskrit": "त्रस्ताश्च रथिनःक सर्वे चैन्द्रमस्त्रं विकुर्वति।\nसर्वे शान्तिपरा योधाः स्वचित्तं नाभिजझिरे ।\nसहिता द्रोणभीष्माभ्यां प्रमोहगतचेतनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2034462, "chapter_id": 1742, "verse_number": "४-६५-५४", "content_sanskrit": "तानि सर्वाणि सैन्यानि भग्नानि भरतर्षभ ।\nप्राद्रवन्त दिशः सर्वा भयाद्वै सव्यसाचिनः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2034463, "chapter_id": 1742, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते विराटपर्वणि गोग्रहणपर्वणि पञ्चषष्टितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]