[{"id": 7001347000, "chapter_id": 21347, "verse_number": "४-३७-१", "content_sanskrit": "॥ ऋषय ऊचुः  ।\nसूतसूत महाभाग ज्ञानवानसि सुव्रत ।\nपुनरेव शिवस्य वै चरितं ब्रूहि विस्तरात्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001347001, "chapter_id": 21347, "verse_number": "४-३७-२", "content_sanskrit": "पुरातनाश्च राजान ऋषयो देवतास्तथा ।\nआराधनञ्च तस्यैव चकुर्देववरस्य हि॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001347002, "chapter_id": 21347, "verse_number": "४-३७-३", "content_sanskrit": "सूत उवाच ।\nसाधु पृष्टमृषिश्रेष्ठाः श्रूयतां कथयामि वः॥  ।\nचरित्रं शांकरं रम्यं शृण्वतां भुक्तिमुक्तिदम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001347003, "chapter_id": 21347, "verse_number": "४-३७-४", "content_sanskrit": "एतदेव पुरा पृष्टो नारदेन पितामहः ।\nप्रत्युवाच प्रसन्नात्मा नारदं मुनिसत्तमम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001347004, "chapter_id": 21347, "verse_number": "४-३७-५", "content_sanskrit": "ब्रह्मोवाच ।\nशृणु नारद सुप्रीत्या शांकरं चरितं वरम् ।\nप्रवक्ष्यामि भवत्स्नेहान्महापातकनाशनम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001347005, "chapter_id": 21347, "verse_number": "४-३७-६", "content_sanskrit": "रमया सहितो विष्णुश्शिवपूजां चकार ह ।\nकृपया परमेशस्य सर्वान्कामानवाप हि॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001347006, "chapter_id": 21347, "verse_number": "४-३७-७", "content_sanskrit": "अहं पितामहश्चापि शिवपूजनकारकः ।\nतस्यैव कृपया तात विश्वसृष्टिकरस्सदा॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001347007, "chapter_id": 21347, "verse_number": "४-३७-८", "content_sanskrit": "शिवपूजाकरा नित्यं मत्पुत्राः परमर्षयः ।\nअन्ये च ऋषयो ये ते शिवपूजनकारकाः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001347008, "chapter_id": 21347, "verse_number": "४-३७-९", "content_sanskrit": "नारद त्वं विशेषेण शिवपूजनकारकः ।\nसप्तर्षयो वसिष्ठाद्याः शिवपूजनकारकाः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001347009, "chapter_id": 21347, "verse_number": "४-३७-१०", "content_sanskrit": "अरुंधती मदासाध्वी लोपामुद्रा तथैव च ।\nअहल्या गौतमस्त्री च शिवपूजनकारिकाः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001347010, "chapter_id": 21347, "verse_number": "४-३७-११", "content_sanskrit": "दुर्वासाः कौशिकश्शक्तिर्दधीचो गौतमस्तथा ।\nकणादो भार्गवो जीवो वैशंपायन एव च॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001347011, "chapter_id": 21347, "verse_number": "४-३७-१२", "content_sanskrit": "एते च मुनयस्सर्वे शिवपूजाकरा मताः ।\nतथा पराशरो व्यासश्शिवपूजारतस्सदा॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001347012, "chapter_id": 21347, "verse_number": "४-३७-१३", "content_sanskrit": "उपमन्युर्महाभक्तश्शिवस्य परमात्मनः ।\nयाज्ञवल्क्यो महाशैवो जैमिनिर्गर्ग एव च॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001347013, "chapter_id": 21347, "verse_number": "४-३७-१४", "content_sanskrit": "शुकश्च शौनकाद्याश्च शङ्करस्य प्रपूजकाः ।\nअन्येऽपि बहवस्सन्ति मुनयो मुनिसत्तमाः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001347014, "chapter_id": 21347, "verse_number": "४-३७-१५", "content_sanskrit": "अदितिर्देवमाता च नित्यं प्रीत्या चकार ह ।\nपार्थिवीं शैवपूजां वै सवधूः प्रेमतत्परा॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001347015, "chapter_id": 21347, "verse_number": "४-३७-१६", "content_sanskrit": "शक्रादयो लोकपाला वसवश्च सुरास्तथा ।\nमहाराजिकदेवाश्च साध्याश्च शिवपूजकाः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001347016, "chapter_id": 21347, "verse_number": "४-३७-१७", "content_sanskrit": "गन्धर्वा किन्नराद्याश्चोपसुराश्शिवपूजकाः ।\nतथाऽसुरा महात्मानश्शिवपूजाकरा मताः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001347017, "chapter_id": 21347, "verse_number": "४-३७-१८", "content_sanskrit": "हिरण्यकशिपुर्देत्यस्सानुजत्ससुतो मुने ।\nशिवपूजाकरो नित्यं विरोचनबली तथा॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001347018, "chapter_id": 21347, "verse_number": "४-३७-१९", "content_sanskrit": "महाशैव स्मृतो बाणो हिरण्याक्षसुतास्तथा ।\nवृषपर्वा दनुस्तात दानवाः शिवपूजकाः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001347019, "chapter_id": 21347, "verse_number": "४-३७-२०", "content_sanskrit": "शेषश्च वासुकिश्चैव तक्षकश्च तथा परे ।\nशिवभक्ता महानागा गरुडाद्याश्च पक्षिणः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001347020, "chapter_id": 21347, "verse_number": "४-३७-२१", "content_sanskrit": "सूर्यचन्द्रावुभौ देवौ पृथ्व्यां वंशप्रवर्त्तकौ ।\nशिवसेवारतौ नित्यं सवंश्यौ तौ मुनीश्वर॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001347021, "chapter_id": 21347, "verse_number": "४-३७-२२", "content_sanskrit": "मनवश्च तथा चक्रुस्स्वायंभुवपुरस्सराः ।\nशिवपूजां विशेषेण शिववेषधरा मुने॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001347022, "chapter_id": 21347, "verse_number": "४-३७-२३", "content_sanskrit": "प्रियव्रतश्च तत्पुत्रास्तथा चोत्तानपात्सुतः ।\nतद्वंशाश्चैव राजानश्शिवपूजनकारकाः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001347023, "chapter_id": 21347, "verse_number": "४-३७-२४", "content_sanskrit": "ध्रुवश्च ऋषभश्चैव भरतो नव योगिनः ।\nतद्भ्रातरः परे चापि शिवपूजनकारकाः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001347024, "chapter_id": 21347, "verse_number": "४-३७-२५", "content_sanskrit": "वैवस्वतसुतास्तार्क्ष्य इक्ष्वाकुप्रमुखा नृपाः ।\nशिवपूजारतात्मानः सर्वदा सुखभोगिनः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001347025, "chapter_id": 21347, "verse_number": "४-३७-२६", "content_sanskrit": "ककुत्स्थश्चापि मांधाता सगरश्शैवसत्तमः ।\nमुचुकुन्दो हरिश्चन्द्रः कल्माषांघ्रिस्तथैव च॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001347026, "chapter_id": 21347, "verse_number": "४-३७-२७", "content_sanskrit": "भगीरथादयो भूपा बहवो नृपसत्तमाः ।\nशिवपूजाकरा ज्ञेयाः शिववेषविधायिनः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001347027, "chapter_id": 21347, "verse_number": "४-३७-२८", "content_sanskrit": "खट्वांगश्च महाराजो देवसाहाय्यकारकः ।\nविधितः पार्थिवीम्मूर्तिं शिवस्यापूजयत्सदा॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001347028, "chapter_id": 21347, "verse_number": "४-३७-२९", "content_sanskrit": "तत्पुत्रो हि दिलीपश्च शिवपूजनकृत्सदा ।\nरघुस्तत्तनयः शैवः सुप्रीत्याः शिवपूजकः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001347029, "chapter_id": 21347, "verse_number": "४-३७-३०", "content_sanskrit": "अजश्शिवार्चकस्तस्य तनयो धर्मयुद्धकृत् ।\nजातो दशरथो भूयो महाराजो विशेषतः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001347030, "chapter_id": 21347, "verse_number": "४-३७-३१", "content_sanskrit": "पुत्रार्थे पार्थिवी मूर्त्ति शैवी दशरथो हि सः ।\nसमानर्च विशेषेण वसि ष्ठस्याज्ञया मुनेः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001347031, "chapter_id": 21347, "verse_number": "४-३७-३२", "content_sanskrit": "पुत्रेष्टिं च चकारासौ पार्थिवो भवभक्तिमान् ।\nऋष्यशृङ्गमुनेराज्ञां संप्राप्य नृपसत्तमः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001347032, "chapter_id": 21347, "verse_number": "४-३७-३३", "content_sanskrit": "कौसल्या तत्प्रिया मूर्त्ति पार्थिवीं शांकरीं मुदा ।\nऋष्यशृंगसमादिष्टा समानर्च सुताप्तये॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001347033, "chapter_id": 21347, "verse_number": "४-३७-३४", "content_sanskrit": "सुमित्रा च शिवं प्रीत्या कैकेयी नृपवल्लभा ।\nपूजयामास सत्पुत्रप्राप्तये मुनिसत्तम॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001347034, "chapter_id": 21347, "verse_number": "४-३७-३५", "content_sanskrit": "शिवप्रसादतस्ता वै पुत्रान्प्रापुश्शुभंकरान् ।\nमहाप्रतापिनो वीरान्सन्मार्गनिरतान्मुने॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001347035, "chapter_id": 21347, "verse_number": "४-३७-३६", "content_sanskrit": "ततः शिवाज्ञया तस्मात्तासु राज्ञस्स्वयं हरिः ।\nचतुर्भिश्चैव रूपैश्चाविर्बभूव नृपात्मजः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001347036, "chapter_id": 21347, "verse_number": "४-३७-३७", "content_sanskrit": "कौसल्यायाः सुतो राम सुमित्रायाश्च लक्ष्मण ।\nशत्रुघ्नश्चैव कैकेय्या भरतश्चेति सुव्रताः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001347037, "chapter_id": 21347, "verse_number": "४-३७-३८", "content_sanskrit": "रामस्ससहजो नित्यं पार्थिवं समपूजयत् ।\nभस्म रुद्राक्षधारी च विरजागममास्थितः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001347038, "chapter_id": 21347, "verse_number": "४-३७-३९", "content_sanskrit": "तद्वंशे ये समुत्पन्ना राजानः सानुगा मुने ।\nते सर्वे पार्थिवं लिंगं शिवस्य समपूजयन्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001347039, "chapter_id": 21347, "verse_number": "४-३७-४०", "content_sanskrit": "सुद्युम्नश्च महाराजश्शैवो मुनिसुतो मुने ।\nशिवशापात्प्रियाहेतोरभून्नारी ससेवकः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001347040, "chapter_id": 21347, "verse_number": "४-३७-४१", "content_sanskrit": "पार्थिवेशसमर्चातः पुनस्सोऽभूत्पुमान्वरः ।\nमासं स्त्री पुरुषो मासमेवं स्त्रीत्वं न्यवर्त्तत॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001347041, "chapter_id": 21347, "verse_number": "४-३७-४२", "content_sanskrit": "ततो राज्यं परित्यज्य शिवधर्मपरायणः ।\nशिववेषधरो भक्त्या दुर्लभं मोक्षमाप्तवान्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001347042, "chapter_id": 21347, "verse_number": "४-३७-४३", "content_sanskrit": "पुरूरवाश्च तत्पुत्रो महाराजस्तु पूजक ।\nशिवस्य देवदेवस्य तत्सुतः शिवपूजकः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001347043, "chapter_id": 21347, "verse_number": "४-३७-४४", "content_sanskrit": "भरतस्तु महापूजां शिवस्यैव सदाकरोत् ।\nनहुषश्च महा शैवः शिवपूजारतो ह्यभूत्॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001347044, "chapter_id": 21347, "verse_number": "४-३७-४५", "content_sanskrit": "ययातिः शिवपूजातः सर्वान्कामानवाप्तवान् ।\nअजीजनत्सुतान्पंच शिवधर्मपरायणान्॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001347045, "chapter_id": 21347, "verse_number": "४-३७-४६", "content_sanskrit": "तत्सुता यदुमुख्याश्च पंचापि शिवपूजकाः ।\nशिवपूजाप्रभावेण सर्वान्कामांश्च लेभिरे॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001347046, "chapter_id": 21347, "verse_number": "४-३७-४७", "content_sanskrit": "अन्येऽपि ये महाभागाः समानर्चुश्शिवं हि ते ।\nतद्वंश्या अन्यवंश्याश्च भुक्तिमुक्तिप्रदं मुने॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001347047, "chapter_id": 21347, "verse_number": "४-३७-४८", "content_sanskrit": "कृष्णेन च कृतं नित्यं बदरीपर्वतोत्तमे ।\nपूजनं तु शिवस्यैव सप्तमासावधि स्वयम्॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001347048, "chapter_id": 21347, "verse_number": "४-३७-४९", "content_sanskrit": "प्रसन्नाद्भगवांस्तस्माद्वरान्दिव्यानने कशः ।\nसम्प्राप्य च जगत्सर्वं वशेऽनयत शङ्करात्॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001347049, "chapter_id": 21347, "verse_number": "४-३७-५०", "content_sanskrit": "प्रद्युम्नः तत्सुतस्तात शिवपूजाकरस्सदा ।\nअन्ये च कार्ष्णिप्रवरास्साम्बाद्याश्शिवपूजकाः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001347050, "chapter_id": 21347, "verse_number": "४-३७-५१", "content_sanskrit": "जरासंधो महाशैवस्तद्वंश्याश्च नृपास्तथा ।\nनिमिश्शैवश्च जनकस्तत्पुत्राश्शिवपूजकाः॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001347051, "chapter_id": 21347, "verse_number": "४-३७-५२", "content_sanskrit": "नलेन च कृता पूजा वीरसेनसुतेन वै ।\nपूर्वजन्मनि यो भिल्लो वने पान्थसुरक्षकः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001347052, "chapter_id": 21347, "verse_number": "४-३७-५३", "content_sanskrit": "यतिश्च रक्षितस्तेन पुरा हरसमीपतः ।\nस्वयंव्याघ्रादिभी रात्रौ भक्षितश्च मृतो वृषात्॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001347053, "chapter_id": 21347, "verse_number": "४-३७-५४", "content_sanskrit": "तेन पुण्यप्रभावेण स भिल्लो हि नलोऽभवत् ।\nचक्रवर्ती महाराजो दमयन्ती प्रियोऽभवत्॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001347054, "chapter_id": 21347, "verse_number": "४-३७-५५", "content_sanskrit": "इति ते कथितं तात यत्पृष्टं भवतानघ ।\nशाङ्करं चरितं दिव्यं किमन्यत्प्रष्टुमिच्छसि॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}]