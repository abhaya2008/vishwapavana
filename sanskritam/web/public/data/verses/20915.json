[{"id": 7000915000, "chapter_id": 20915, "verse_number": "७-३-१", "content_sanskrit": "जैमिनिरुवाच ।\nक्रियायोगस्य तत्वं मे ब्रूहि व्यास महामते ।\nक्रियायोगमहं ज्ञातुमिच्छामि भवदग्रतः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000915001, "chapter_id": 20915, "verse_number": "७-३-२", "content_sanskrit": "व्यास उवाच ।\nशरीरं मानुषं विप्र दुर्लभं चात्र भूतले ।\nधीरः शरीरमासाद्य मोक्षार्थं योगमभ्यसेत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000915002, "chapter_id": 20915, "verse_number": "७-३-३", "content_sanskrit": "क्रियायोगध्यानयोगावुभौ योगौ प्रकीर्तितौ ।\nतयोराद्यः क्रियायोगः कुर्वतां सर्वकामदः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000915003, "chapter_id": 20915, "verse_number": "७-३-४", "content_sanskrit": "गङ्गा श्रीर्विष्णुपूजा च दानानि द्विजसत्तम ।\nब्राह्मणानां तथा भक्तिर्भक्तिरेकादशी व्रते ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000915004, "chapter_id": 20915, "verse_number": "७-३-५", "content_sanskrit": "धात्री तुलस्योर्भक्तिश्च तथा चातिथिपूजनम् ।\nक्रियायोगाङ्गभूतानि प्रोक्तानीति समासतः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000915005, "chapter_id": 20915, "verse_number": "७-३-६", "content_sanskrit": "क्रियायोगादृते विप्र ध्यानयोगेन सिद्ध्यति ।\nक्रियायोगरतो याति तद्विष्णोः परमं पदम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000915006, "chapter_id": 20915, "verse_number": "७-३-७", "content_sanskrit": "जैमिनिरुवाच ।\nक्रियायोगाङ्गभूतानि यानि प्रोक्तानि भोः प्रभो ।\nतन्माहात्म्यानि कथय यदि भो मय्यनुग्रहः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000915007, "chapter_id": 20915, "verse_number": "७-३-८", "content_sanskrit": "गङ्गायाः के गुणा ब्रह्मन्विष्णुपूजाफलं च किम् ।\nश्रेष्ठानि कानि दानानि का वा भक्तिर्द्विजन्मनाम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000915008, "chapter_id": 20915, "verse_number": "७-३-९", "content_sanskrit": "एकादश्याः फलं किंवा धात्रीभक्तिश्च कीदृशी ।\nतुलस्याः कीदृशी भक्तिः किं वा चातिथिपूजनम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000915009, "chapter_id": 20915, "verse_number": "७-३-१०", "content_sanskrit": "एतत्सर्वं मुने ब्रूहि श्रोतुमस्ति ममादरः ।\nत्वत्तोऽन्य कथितुं कोऽपि न शक्नोति जगत्त्रये ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000915010, "chapter_id": 20915, "verse_number": "७-३-११", "content_sanskrit": "व्यास उवाच ।\nसाधुसाधु द्विजश्रेष्ठ मनस्ते विमलं ध्रुवम् ।\nयतो गुह्यकथामेतां श्रोतुं श्रद्धा च कौतुकम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000915011, "chapter_id": 20915, "verse_number": "७-३-१२", "content_sanskrit": "भागीरथ्या गुणं सम्यक्कथितुं न हि शक्यते ।\nतस्मात्समासतो वक्ष्ये श्रूयतामेकचेतसा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000915012, "chapter_id": 20915, "verse_number": "७-३-१३", "content_sanskrit": "गङ्गेत्यक्षरयुग्मं च जपत्यत्यन्तकोमलम् ।\nमन्ये व्रजेत्तथाप्येनो महाभूतरसायनम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000915013, "chapter_id": 20915, "verse_number": "७-३-१४", "content_sanskrit": "सर्वत्र सुलभा गङ्गा त्रिषु स्थानेषु दुर्लभा ।\nगङ्गाद्वारे प्रयागे च गङ्गासागरसङ्गमे ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000915014, "chapter_id": 20915, "verse_number": "७-३-१५", "content_sanskrit": "सवासवाः सुराः सर्वे गङ्गाद्वारं मनोरमम् ।\nसमागत्य प्रकुर्वन्ति स्नानदानादिकं मुने ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000915015, "chapter_id": 20915, "verse_number": "७-३-१६", "content_sanskrit": "दैवयोगान्मुने तत्र ये त्यजंति कलेवरम् ।\nमनुष्य पशु कीटाद्या लभंते परमं पदम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000915016, "chapter_id": 20915, "verse_number": "७-३-१७", "content_sanskrit": "अत्रेतिहासं विप्रर्षे कथ्यमानं मया शुणु ।\nसम्यक्छ्रवणमात्रेण सर्वपापैः प्रमुच्यते ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000915017, "chapter_id": 20915, "verse_number": "७-३-१८", "content_sanskrit": "मनोभद्रो नाम राजा सोमवंश समुद्भवः ।\nपूर्वमासीज्जगत्यस्मिन्बलवान्सर्वधर्म्मवित् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000915018, "chapter_id": 20915, "verse_number": "७-३-१९", "content_sanskrit": "तस्य हेमप्रभा नाम महिषी प्रियवादिनी ।\nपतिव्रता महाभागा सर्वलक्षणसंयुता ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000915019, "chapter_id": 20915, "verse_number": "७-३-२०", "content_sanskrit": "स राजा समरे हत्वा सकलानेव शात्रवान् ।\nशशास पृथिवीं कृत्स्नां साब्धिद्वीपां महाबलः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000915020, "chapter_id": 20915, "verse_number": "७-३-२१", "content_sanskrit": "स एकदा महीपालः समाहूय स्वमंत्रिणः ।\nउवाचेदं वचः प्रीत्या सभामध्ये महायशाः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000915021, "chapter_id": 20915, "verse_number": "७-३-२२", "content_sanskrit": "मनोभद्र उवाच ।\nअमात्याः पृथिवी सर्वा मयेयं परिपालिता ।\nनिहता रिपवः सर्वे सपुत्रबलवाहनाः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000915022, "chapter_id": 20915, "verse_number": "७-३-२३", "content_sanskrit": "पालितानि स्वगोत्राणि दानैर्विप्राश्च तोषिताः ।\nशिष्टाश्च त्रिदशाः सर्वे सपुत्रबलवाहनाः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000915023, "chapter_id": 20915, "verse_number": "७-३-२४", "content_sanskrit": "पालितानि स्वगोत्राणि यज्ञैः सर्वैः सदक्षिणैः ।\nएतद्धि जरया सर्वं महत्या मे बलं हृतम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000915024, "chapter_id": 20915, "verse_number": "७-३-२५", "content_sanskrit": "कर्माणि कानिचित्कर्त्तुं न हि शक्नोमि दुर्बलः ।\nसामर्थ्यहीने पुरुषे राजश्रीर्न हि शोभते ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000915025, "chapter_id": 20915, "verse_number": "७-३-२६", "content_sanskrit": "सर्वाभरणसंयुक्ता वृद्धाङ्गा इव कामिनी ।\nतावद्विभ्यति सर्वेऽपि शत्रवः पृथिवीतले ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000915026, "chapter_id": 20915, "verse_number": "७-३-२७", "content_sanskrit": "यावद्धि गतसामर्थ्यं नेच्छन्ति चारुचक्षुषा ।\nसमस्तगुणसम्पन्नामपि तद्गतमानसम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000915027, "chapter_id": 20915, "verse_number": "७-३-२८", "content_sanskrit": "पृथ्वी त्यजेन्नृपं वृद्धं स्वैरिणीपालिता यथा ।\nभक्तिलभ्यागुणाः सर्वे गुणलभ्यं महद्यशः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000915028, "chapter_id": 20915, "verse_number": "७-३-२९", "content_sanskrit": "निःश्रेयसं दानलभ्यं बललभ्या तु मेदिनी ।\nसामर्थ्यहीनः कृपणो निश्चितो रिपुशासने ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000915029, "chapter_id": 20915, "verse_number": "७-३-३०", "content_sanskrit": "मूर्खमात्रवचो ग्राही स नृपः शत्रुनंदनः ।\nततोऽहं सकलं राज्यं विभज्य वरमंत्रिणः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000915030, "chapter_id": 20915, "verse_number": "७-३-३१", "content_sanskrit": "दातुमिच्छामि पुत्राभ्यां युष्माभिर्यदि मन्यते ।\nमन्त्रिण ऊचुः ।\nयदेतद्वचनं प्रोक्तं त्वया नीतिविदा नृप ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000915031, "chapter_id": 20915, "verse_number": "७-३-३२", "content_sanskrit": "तदेव मतमस्माकं संदेहो नात्र विद्यते ।\nअथायातौ नृपादेशात्संसदं प्रति सत्तमौ ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000915032, "chapter_id": 20915, "verse_number": "७-३-३३", "content_sanskrit": "वीरभद्र यशोभद्र नामानौ तनयावुभौ ।\nतौ च सर्वगुणोपेतौ कुमारौ प्रियवादिनौ ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000915033, "chapter_id": 20915, "verse_number": "७-३-३४", "content_sanskrit": "पितृभक्तौ सदा शांतौ बलिनौ धर्मतत्परौ ।\nततः स भूपः सहसा राजनीति विदांवरः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000915034, "chapter_id": 20915, "verse_number": "७-३-३५", "content_sanskrit": "विभज्य सकलं राज्यं ददौ ताभ्यां कुतूहलात् ।\nअत्रांतरे गृध्र एकः स्वकीयस्त्री समन्वितः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000915035, "chapter_id": 20915, "verse_number": "७-३-३६", "content_sanskrit": "आगत्य तत्सभामध्ये उपविष्टो द्विजोत्तमाः ।\nतावागतौ समालोक्य पक्षिणावतिहर्षितौ ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000915036, "chapter_id": 20915, "verse_number": "७-३-३७", "content_sanskrit": "राजाह युवयोः कस्माच्छुभागमनमुच्यताम् ।\nगृध्र उवाच ।\nगृध्रोऽहं पृथिवीपाल ममेयं स्त्री परंतपः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000915037, "chapter_id": 20915, "verse_number": "७-३-३८", "content_sanskrit": "आगतोऽस्मि मुदा द्रष्टुं संपदं पुत्रयोस्तव ।\nएतयोर्महती दृष्टा विपत्तिः पूर्वजन्मनि ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000915038, "chapter_id": 20915, "verse_number": "७-३-३९", "content_sanskrit": "इह जन्मनि संपत्तिं द्रष्टुमावां समागतौ ।\nतस्यैतद्वचनं श्रुत्वा गृध्रस्य परमाद्भुतम् ।\nराजोवाच पुनर्विप्र विस्मयाविष्टमानसः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000915039, "chapter_id": 20915, "verse_number": "७-३-४०", "content_sanskrit": "राजोवाच ।\nअत्यद्भुतं वचो गृध्र त्वत्तः श्रुतमिदं मया ।\nएतयोः पूर्ववृत्तान्तो भवता ज्ञायते कथम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000915040, "chapter_id": 20915, "verse_number": "७-३-४१", "content_sanskrit": "यदि जानासि तत्वेन पूर्ववृत्तांतमेतयोः ।\nब्रूहि तर्हि खगश्रेष्ठ सर्वमेतदशेषतः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000915041, "chapter_id": 20915, "verse_number": "७-३-४२", "content_sanskrit": "गृध्र उवाच ।\nनृपते वृषलावेतौ युगे द्वापरसंज्ञके ।\nगरसंगरनामानौ सत्यघोषसुतौ स्थितौ ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000915042, "chapter_id": 20915, "verse_number": "७-३-४३", "content_sanskrit": "एककाले च भूपाल मृतौ निज गृहांतरे ।\nततो नेतुमिमौ भूप दंष्ट्रिणो यमकिंकराः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000915043, "chapter_id": 20915, "verse_number": "७-३-४४", "content_sanskrit": "पाशहस्ताः समायाताः कोटिकोटिसहस्रशः ।\nबबंधुश्चर्मपाशेन द्वावेतौ तौ मदोद्धतौ ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000915044, "chapter_id": 20915, "verse_number": "७-३-४५", "content_sanskrit": "निन्युश्च निलयं मृत्योरतिदुर्गमवर्त्मना ।\nइमौ दृष्ट्वा धर्मराजश्चित्रगुप्तमुवाच ह ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000915045, "chapter_id": 20915, "verse_number": "७-३-४६", "content_sanskrit": "एतयोः सकलं वृत्तं चित्रगुप्त विचार्यताम् ।\nतस्याज्ञया चित्रगुप्तः सर्वकर्मशुभाशुभम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000915046, "chapter_id": 20915, "verse_number": "७-३-४७", "content_sanskrit": "मूलाद्विचारयामास तत इत्याह चांतकम् ।\nचित्रगुप्त उवाच ।\nसत्यमेतौ महाबाहो पुण्यव्रत महाशयौ ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000915047, "chapter_id": 20915, "verse_number": "७-३-४८", "content_sanskrit": "अस्तिचेद्दुष्कृतं किञ्चित्सर्वकर्मविलोकितम् ।\nस्वयंदानं समुत्सृज्य न हि दत्तं द्विजातये ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000915048, "chapter_id": 20915, "verse_number": "७-३-४९", "content_sanskrit": "तेनैव कर्मणा राजन्निमौ नरकगामिनौ ।\nदाता दानं समुत्सृज्य यो न दद्याद्दिवजातये ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000915049, "chapter_id": 20915, "verse_number": "७-३-५०", "content_sanskrit": "स याति नरकं घोरं सर्वभूतभयावहम् ।\nदाता हि न स्मरेद्दानं प्रतिग्राही न याचते ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000915050, "chapter_id": 20915, "verse_number": "७-३-५१", "content_sanskrit": "उभयोर्नरके वासो यावच्चन्द्र दिवाकरौ ।\nतस्मादिमौ महापापौ ब्रह्मस्वाहारिणौ प्रभो ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000915051, "chapter_id": 20915, "verse_number": "७-३-५२", "content_sanskrit": "नयंतु किंकराः शीघ्रं नरकं प्रतिदारुणम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000915052, "chapter_id": 20915, "verse_number": "७-३-५३", "content_sanskrit": "यमाज्ञया ततो दूताः संदष्टौष्ठपुटाः क्रुधा ।\nचिक्षिपुर्नरके घोरे तावेतौ पृथिवीपते ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000915053, "chapter_id": 20915, "verse_number": "७-३-५४", "content_sanskrit": "तस्मिन्नेव दिने राजन्ननया भार्यया सह ।\nयमदूतैः समागत्य नीतोऽहं यममन्दिरम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000915054, "chapter_id": 20915, "verse_number": "७-३-५५", "content_sanskrit": "मयापि तत्कृतं कर्म तदाकर्णय भूपते ।\nमूलात्सर्वं प्रवक्ष्यामि शृण्वतां विस्मयप्रदम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000915055, "chapter_id": 20915, "verse_number": "७-३-५६", "content_sanskrit": "पुरासीत्सर्वगो नाम ब्राह्मणोऽहं महाकुलः ।\nसौराष्ट्रदेशवासी च वेदवेदाङ्गपारगः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000915056, "chapter_id": 20915, "verse_number": "७-३-५७", "content_sanskrit": "इयं मंजूकषा नाम मम पत्नी यशस्विनी ।\nपतिव्रता महाभागा पवित्रकुलसंभवा ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000915057, "chapter_id": 20915, "verse_number": "७-३-५८", "content_sanskrit": "प्रमत्तोऽहं महाभाग विद्यया वयसाधनैः ।\nअवज्ञां मनसा पित्रोश्चकाराहं युवैकदा ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000915058, "chapter_id": 20915, "verse_number": "७-३-५९", "content_sanskrit": "अहं भूरि सभाश्लाघ्यो वनस्थः सर्वकर्मकृत् ।\nधनवान्सुन्दरो ज्ञानी ज्ञातिपोषणतत्परः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000915059, "chapter_id": 20915, "verse_number": "७-३-६०", "content_sanskrit": "ममैव पुंसः पितरौ तौ च पापपरायणौ ।\nमुखरौ दययाहीनौ पाखंडिसङ्ग लोलुपौ ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000915060, "chapter_id": 20915, "verse_number": "७-३-६१", "content_sanskrit": "पौरुषं जीवनं चैव धनं चैव कुलं तथा ।\nविद्या कीर्तिश्च सर्वस्वं पितृभ्यां विफलीकृतम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000915061, "chapter_id": 20915, "verse_number": "७-३-६२", "content_sanskrit": "एतद्विचिन्त्य मनसा मया नृप मुहुर्मुहुः ।\nअवज्ञया परित्यक्ता पित्रोः सेवा शुभप्रदा ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000915062, "chapter_id": 20915, "verse_number": "७-३-६३", "content_sanskrit": "अनेन कर्मणा राजन्सदारोऽहं यमाज्ञया ।\nविक्षिप्तो नरके दूतैर्यत्रतौ पापिनांवरौ ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000915063, "chapter_id": 20915, "verse_number": "७-३-६४", "content_sanskrit": "एताभ्यां सह पापाभ्यां सदारेण मया नृप ।\nस्थितं च नरके घोरे यावत्कालं शृणुष्व तत् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000915064, "chapter_id": 20915, "verse_number": "७-३-६५", "content_sanskrit": "युगकोटिसहस्राणि युगकोटिशतानि च ।\nअनुभूतं महादुःखं नरकस्य नृपोत्तम ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000915065, "chapter_id": 20915, "verse_number": "७-३-६६", "content_sanskrit": "नरकांते ततः सोऽहं कांतया सह भूपते ।\nगृध्रपक्षकुलेजातौ मृतमांसाशनौ तथा ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000915066, "chapter_id": 20915, "verse_number": "७-३-६७", "content_sanskrit": "एतावपि च तौ राजन्नरकांत गतैषिणौ ।\nजातौ शलभयोर्वंशे भोक्तुं फलं स्वकर्मणः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000915067, "chapter_id": 20915, "verse_number": "७-३-६८", "content_sanskrit": "यदेताभ्यां कृतं कर्म्म राजञ्छलभजन्मनि ।\nतदाकर्णय वक्ष्यामि श्रोतॄणां विस्मयप्रदम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000915068, "chapter_id": 20915, "verse_number": "७-३-६९", "content_sanskrit": "एकदा सुमहान्वायुः समायातो महीपते ।\nउड्डीय पातितौ तेन गङ्गागर्भे सुनिर्मले ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000915069, "chapter_id": 20915, "verse_number": "७-३-७०", "content_sanskrit": "निपत्य गङ्गासलिले कोमलाङ्गाविमौ तथा ।\nजग्मतुः पंचतां सद्यः समस्तकलुषापहम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000915070, "chapter_id": 20915, "verse_number": "७-३-७१", "content_sanskrit": "ततो नेतुमिमौ दूता आयाताश्चारुचक्षुषः ।\nआयातानि विमानानि सर्वभोगान्वितानि च ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000915071, "chapter_id": 20915, "verse_number": "७-३-७२", "content_sanskrit": "विमुक्तौ सर्वपापेभ्यस्तुलसी माल्य शोभितौ ।\nदिव्यंविमानमारुह्य गतौ विष्णुपुरं प्रति ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000915072, "chapter_id": 20915, "verse_number": "७-३-७३", "content_sanskrit": "तावत्कालं स्थितौ राजन्ब्रह्मणोऽव्यक्तजन्मनः ।\nब्रह्माज्ञया समायातौ तत इन्द्रपुरं प्रति ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000915073, "chapter_id": 20915, "verse_number": "७-३-७४", "content_sanskrit": "भुक्तवंतौ सुखं तत्र दुर्ल्लभं यत्सुरैरपि ।\nतावत्कालं स्थितौ राजन्भोक्तुं कृच्छ्रां वसुंधराम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000915074, "chapter_id": 20915, "verse_number": "७-३-७५", "content_sanskrit": "पवित्रे भवतो वंशे जातावेतौ महायशौ ।\nगङ्गायां त्यजतो देहं भूयो जन्म न विद्यते ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000915075, "chapter_id": 20915, "verse_number": "७-३-७६", "content_sanskrit": "तथापि वसुधां भोक्तुं जातौ पुण्यतमाविमौ ।\nचिरं भुक्त्वा महीं कृत्स्नां पुत्रपौत्रसमन्वितौ ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000915076, "chapter_id": 20915, "verse_number": "७-३-७७", "content_sanskrit": "गङ्गामरणमासाद्य योगिनामपि दुर्ल्लभम् ।\nनारायणस्य सायुज्यमिमौ भूप गमिष्यतः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000915077, "chapter_id": 20915, "verse_number": "७-३-७८", "content_sanskrit": "एतत्सर्वं मया प्रोक्तं पूर्व वृत्तांतमेतयोः ।\nजातिस्मरप्रभावेन नृपवर्गशिरोमणी ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000915078, "chapter_id": 20915, "verse_number": "७-३-७९", "content_sanskrit": "गङ्गामरणमासाद्य गतावेतौ दशामिमाम् ।\nआवयोः कः परित्राणं करिष्यति दुरात्मनोः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000915079, "chapter_id": 20915, "verse_number": "७-३-८०", "content_sanskrit": "मित्रावज्ञा मनुष्याणां नरकक्लेशदायिनी ।\nममैव पृथिवीपाल दृष्टा केवलमेवतत् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000915080, "chapter_id": 20915, "verse_number": "७-३-८१", "content_sanskrit": "पित्रभक्तिर्द्विजश्रेष्ठ इहामुत्र च दुःखदा ।\nइह संपद्विनाशाय परत्र नरकाय च ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000915081, "chapter_id": 20915, "verse_number": "७-३-८२", "content_sanskrit": "वरं मन्ये महीपाल ब्रह्महत्यादि पातकम् ।\nकदाचिन्निष्कृतिस्तस्मादियं भवति शाश्वती ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000915082, "chapter_id": 20915, "verse_number": "७-३-८३", "content_sanskrit": "दुःखार्जितं पुण्यवृक्षं सर्वक्लेशविनाशनम् ।\nपित्रवज्ञाकुठारेण च्छिंदंति भुवि मानवाः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000915083, "chapter_id": 20915, "verse_number": "७-३-८४", "content_sanskrit": "यत्किञ्चिद्दीयते राजन्पित्र्ये वक्त्रे परंतप ।\nतदश्नाति स्वयं विष्णुः पितृरूपो हरिर्यतः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000915084, "chapter_id": 20915, "verse_number": "७-३-८५", "content_sanskrit": "प्रत्यक्षदेवौ पितरौ सेवंते येत्वहर्निशम् ।\nसर्वसिद्धिर्भवेत्तेषां प्रसादाज्जगतीपतेः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000915085, "chapter_id": 20915, "verse_number": "७-३-८६", "content_sanskrit": "पितृभक्तिविहीना ये दिनं तिष्ठंति मानवाः ।\nतावत्कल्पसहस्रं तु तिष्ठंति नरके जनाः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000915086, "chapter_id": 20915, "verse_number": "७-३-८७", "content_sanskrit": "तस्मादिदं महादुःखं बभूव मम सांप्रतम् ।\nमोक्षं कदा गमिष्यामि सदारोऽहं न वेद्मि तत् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000915087, "chapter_id": 20915, "verse_number": "७-३-८८", "content_sanskrit": "व्यासौवाच ।\nएतत्तस्य वचः श्रुत्वा प्रगृह्य द्विजसत्तम ।\nबभूव हर्षितो राजा विस्मितश्च पुनः पुनः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000915088, "chapter_id": 20915, "verse_number": "७-३-८९", "content_sanskrit": "राजोवाच ।\nआश्चर्यं हि वचो गृध्र श्रुतमेतन्मुखात्तव ।\nमम चैषां च हृदये प्रतीतिर्न हि जायते ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000915089, "chapter_id": 20915, "verse_number": "७-३-९०", "content_sanskrit": "अथांतरिक्षे वागुच्चैरिति जाता नृपोत्तम ।\nसत्यं सत्यं सत्यमिदं संदेहोनात्र विद्यते ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000915090, "chapter_id": 20915, "verse_number": "७-३-९१", "content_sanskrit": "ततः स पक्षी विप्रर्षे सहसा भार्यया सह ।\nगङ्गा माहात्म्यकथनात्पूर्वस्थित इवाभवत् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000915091, "chapter_id": 20915, "verse_number": "७-३-९२", "content_sanskrit": "दिवि दुंदुभयो नेदुर्जगुर्गन्धर्वसत्तमाः ।\nननृतुश्चाप्सरोवर्गा ह्यपतत्पुष्पवर्षणम् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000915092, "chapter_id": 20915, "verse_number": "७-३-९३", "content_sanskrit": "विमानमागतं दिव्यं सर्वभोगसमन्वितम् ।\nसमायाता दूतगणाः प्रेषिताः कैटभद्विषा ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7000915093, "chapter_id": 20915, "verse_number": "७-३-९४", "content_sanskrit": "अथासौ सर्वगो विप्र प्रियया सह भार्यया ।\nसद्यो विमानमारुह्य जगाम भवनं हरेः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7000915094, "chapter_id": 20915, "verse_number": "७-३-९५", "content_sanskrit": "एतच्छ्रुत्वाद्भुतं कर्म स राजा द्विजसत्तम ।\nसपुत्रदारः सेवायां गङ्गायास्तत्परोऽभवत् ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7000915095, "chapter_id": 20915, "verse_number": "७-३-९६", "content_sanskrit": "भागीरथ्या समं तीर्थं नास्ति वै भुवनत्रये ।\nयन्नामोच्चारणादेव सर्वगो मोक्षमाप्नुयात् ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7000915096, "chapter_id": 20915, "verse_number": "७-३-९७", "content_sanskrit": "गङ्गाद्वारस्य माहात्म्यं कथितं ते द्विजोत्तम ।\nसमस्तपापविध्वंसि किमन्यच्छ्रोतुमिच्छसि ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7000915097, "chapter_id": 20915, "verse_number": "७-३-९८", "content_sanskrit": "अध्यायमेतत्परमादरेण पठंति ये देवगृहे मनुष्याः ।\nशृण्वंति ये च द्विजवर्गभक्ता नश्यंति तेषां दुरितानि सद्यः ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}]