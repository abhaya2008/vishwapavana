[{"id": 2027220, "chapter_id": 1584, "verse_number": "३-२२२-०x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2027221, "chapter_id": 1584, "verse_number": "३-२२२-१", "content_sanskrit": "काश्यपो ह्यथ वासिष्ठः प्राणश्च प्राणपुत्रकः।\nअग्निराङ्गिरसश्चैव च्यवनस्तीव्रवर्चकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2027222, "chapter_id": 1584, "verse_number": "३-२२२-२", "content_sanskrit": "अचरत्स तपस्तीव्रं पुत्रार्थे बहुवार्षिकम्।\nपुत्रं लभेयं धर्मिष्ठं यशसा ब्रह्मणा समम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2027223, "chapter_id": 1584, "verse_number": "३-२२२-३", "content_sanskrit": "महाव्याहृतिभिर्ध्यातः पञ्चभिस्तैस्तदा त्वथ।\nजज्ञे तेजोमयार्चिष्मान्पञ्चवर्णः प्राकरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2027224, "chapter_id": 1584, "verse_number": "३-२२२-४", "content_sanskrit": "समिद्धोऽग्निः शिरस्तस्य बाहू सूर्यनिभौ तथा।\nत्वङ्नेत्रे च सुवर्णाभे कृष्णे जङ्घे च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2027225, "chapter_id": 1584, "verse_number": "३-२२२-५", "content_sanskrit": "पञ्चवर्षः स तपसा कृतस्तैः पञ्चभिर्जनैः।\nपाञ्चजन्यः श्रुतो देवः पञ्चवंशकरस्तु सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2027226, "chapter_id": 1584, "verse_number": "३-२२२-६", "content_sanskrit": "दशवर्षसहस्राणि तपस्तप्त्वा महातपाः।\nजनयत्पावकं घोरं पितॄणां स प्रजाः सृजन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2027227, "chapter_id": 1584, "verse_number": "३-२२२-७", "content_sanskrit": "बृहद्रथंतरौ मूर्ध्ना वक्राच्च तपसा हरिम्।\nशिवं नाभ्यां बलादिन्द्रं प्राणाद्वायुं च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2027228, "chapter_id": 1584, "verse_number": "३-२२२-८", "content_sanskrit": "बाहुभ्यामनुदात्तौ च विश्वे भूतानि चैव ह।\nएतान्सृष्ट्वा ततः पञ्च पितॄणामसृजत्सुतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2027229, "chapter_id": 1584, "verse_number": "३-२२२-९", "content_sanskrit": "बृहद्रथस्य प्रणिधिः काश्यपश्य महत्तरः।\nभानुरङ्गिरसो धीरः पुत्रो वर्चस्य सौरभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2027230, "chapter_id": 1584, "verse_number": "३-२२२-१०", "content_sanskrit": "प्राणस्य चानुदात्तस्तु व्याख्याताः पञ्च वंशजाः।\nदेवान्यज्ञमुषश्चान्यान्सृजन्पञ्चदशोत्तरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2027231, "chapter_id": 1584, "verse_number": "३-२२२-११", "content_sanskrit": "सुभीममतिभीमं च भीमं भीमबलाबलम्।\nएतान्यज्ञमुषः पञ्च देवानप्यसृजत्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2027232, "chapter_id": 1584, "verse_number": "३-२२२-१२", "content_sanskrit": "सुमित्रं मित्रवन्तं च मित्रज्ञं मित्रवर्धनम्।\nमित्रधर्माणमित्येतान्देवानभ्यसृजत्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2027233, "chapter_id": 1584, "verse_number": "३-२२२-१३", "content_sanskrit": "सुरप्रवीरं वीरं च सुरेशं च सुवर्चसम्।\nसुराणामपि भर्तारं पञ्चैतानसृजत्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2027234, "chapter_id": 1584, "verse_number": "३-२२२-१४", "content_sanskrit": "त्रिविधं संस्थिता ह्येते पञ्चपञ्च पृथक्पृथक्।\nमुष्णन्त्यत्र स्थिता ह्येते स्वर्गतान्यज्ञयाजिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2027235, "chapter_id": 1584, "verse_number": "३-२२२-१५", "content_sanskrit": "तेषामिष्टं हरन्त्येते निघ्नन्ति च महद्धविः।\nस्पर्धयाहव्यवाहानां निघ्नन्त्येते हरन्ति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2027236, "chapter_id": 1584, "verse_number": "३-२२२-१६", "content_sanskrit": "बहिर्वेद्यां तदादानं कुशलैः संप्रवर्तितम्।\nतत्रैते नोपसर्पन्ति यत्र चाग्निः स्थितो भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2027237, "chapter_id": 1584, "verse_number": "३-२२२-१७", "content_sanskrit": "चितोऽग्निरुद्वहन्यज्ञं पक्षाभ्यां तान्प्रबाधते।\nमन्त्रै प्रशमिताह्येते नेष्टं मुष्णन्ति यज्ञियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2027238, "chapter_id": 1584, "verse_number": "३-२२२-१८", "content_sanskrit": "तपस्ये बृदुक्थस्य पुत्रो भूमिमुपाश्रितः।\nअग्निहोत्रे हूयमाने पृथिव्यां सद्भिरीड्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2027239, "chapter_id": 1584, "verse_number": "३-२२२-१९", "content_sanskrit": "रथन्तरश्चतपसः पुत्रोऽग्निः परिपठ्यते।\nमित्रविन्दा तथा भार्या हविरध्वर्यवो विदुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2027240, "chapter_id": 1584, "verse_number": "३-२२२-२०", "content_sanskrit": "`एतैः सह महाभाग तपस्तेजस्विभिर्नृप।\nमुमुदे परमप्रीतः सह पुत्रैर्भहायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2027241, "chapter_id": 1584, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि मार्कण्डेयसमास्यापर्वणि द्वाविंशत्यधिरकद्विरतितमोऽध्यायः ॥ २२२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]