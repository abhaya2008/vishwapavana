[{"id": 5000158000, "chapter_id": 9158, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अयोध्याकाण्डे एकाशीतितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000158001, "chapter_id": 9158, "verse_number": "२-८१-१", "content_sanskrit": "ततः नान्दी मुखीम् रात्रिम् भरतम् सूत मागधाः ।\nतुष्टुवुर् वाग् विशेषज्ञाः स्तवैः मन्गल सम्हितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000158002, "chapter_id": 9158, "verse_number": "२-८१-२", "content_sanskrit": "सुवर्ण कोण अभिहतः प्राणदद् याम दुन्दुभिः ।\nदध्मुः शन्खामः च शतशो वाद्यामः च उच्च अवच स्वरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000158003, "chapter_id": 9158, "verse_number": "२-८१-३", "content_sanskrit": "स तूर्य घोषः सुमहान् दिवम् आपूरयन्न् इव ।\nभरतम् शोक सम्तप्तम् भूयः शोकैः अरन्ध्रयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000158004, "chapter_id": 9158, "verse_number": "२-८१-४", "content_sanskrit": "ततः प्रबुद्धो भरतः तम् घोषम् सम्निवर्त्य च ।\nन अहम् राजा इति च अपि उक्त्वा शत्रुघ्नम् इदम् अब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000158005, "chapter_id": 9158, "verse_number": "२-८१-५", "content_sanskrit": "पश्य शत्रुघ्न कैकेय्या लोकस्य अपकृतम् महत् ।\nविसृज्य मयि दुह्खानि राजा दशरथो गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000158006, "chapter_id": 9158, "verse_number": "२-८१-६", "content_sanskrit": "तस्य एषा धर्म राजस्य धर्म मूला महात्मनः ।\nपरिभ्रमति राज श्रीर् नौर् इव अकर्णिका जले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000158007, "chapter_id": 9158, "verse_number": "२-८१-७", "content_sanskrit": "यो हि नः सुमहान्नाथः सोऽपि प्रव्राजितो वनम् ।\nअनया धर्ममुत्सृज्य मात्रा मे राघवः स्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000158008, "chapter_id": 9158, "verse_number": "२-८१-८", "content_sanskrit": "इति एवम् भरतम् प्रेक्ष्य विलपन्तम् विचेतनम् ।\nकृपणम् रुरुदुः सर्वाः सस्वरम् योषितः तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000158009, "chapter_id": 9158, "verse_number": "२-८१-९", "content_sanskrit": "तथा तस्मिन् विलपति वसिष्ठो राज धर्मवित् ।\nसभाम् इक्ष्वाकु नाथस्य प्रविवेश महा यशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000158010, "chapter_id": 9158, "verse_number": "२-८१-१०", "content_sanskrit": "शात कुम्भमयीम् रम्याम् मणि रत्न समाकुलाम् ।\nसुधर्माम् इव धर्म आत्मा सगणः प्रत्यपद्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000158011, "chapter_id": 9158, "verse_number": "२-८१-११", "content_sanskrit": "स कान्चनमयम् पीठम् पर अर्ध्य आस्तरण आवृतम् ।\nअध्यास्त सर्व वेदज्ञो दूतान् अनुशशास च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000158012, "chapter_id": 9158, "verse_number": "२-८१-१२", "content_sanskrit": "ब्राह्मणान् क्षत्रियान् योधान् अमात्यान् गण बल्लभान् ।\nक्षिप्रम् आनयत अव्यग्राः कृत्यम् आत्ययिकम् हि नः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000158013, "chapter_id": 9158, "verse_number": "२-८१-१३", "content_sanskrit": "सराजभृत्यम् शत्रुघ्नम् भरतम् च यश्स्विनम् ।\nयुधाजितम् सुमन्त्रम् च ये च तत्र हिता जनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000158014, "chapter_id": 9158, "verse_number": "२-८१-१४", "content_sanskrit": "ततः हलहला शब्दो महान् समुदपद्यत ।\nरथैः अश्वैः गजैः च अपि जनानाम् उपगच्चताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000158015, "chapter_id": 9158, "verse_number": "२-८१-१५", "content_sanskrit": "ततः भरतम् आयान्तम् शत क्रतुम् इव अमराः ।\nप्रत्यनन्दन् प्रकृतयो यथा दशरथम् तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000158016, "chapter_id": 9158, "verse_number": "२-८१-१६", "content_sanskrit": "ह्रदैव तिमि नाग सम्वृतः ।\nस्तिमित जलो मणि शन्ख शर्करः ।\nदशरथ सुत शोभिता सभा ।\nसदशरथा इव बभौ यथा पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000158017, "chapter_id": 9158, "verse_number": null, "content_sanskrit": "इति वाल्मीकि रामायणे आदि काव्ये अयोध्याकाण्डे एकाशीतितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]