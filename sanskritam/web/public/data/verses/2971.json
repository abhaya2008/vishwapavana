[{"id": 2092614, "chapter_id": 2971, "verse_number": "१३-१०१-१", "content_sanskrit": "युधिष्ठिर उवाच।\nदह्यमानाय विप्राय यः प्रयच्छत्युपानहौ।\nयत्फलं तस्य भवति तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2092615, "chapter_id": 2971, "verse_number": "१३-१०१-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2092616, "chapter_id": 2971, "verse_number": "१३-१०१-२", "content_sanskrit": "उपानहौ प्रयच्छेद्यो ब्राह्मणेभ्यः समाहितः।\nमर्दते कण्टकान्सर्वान्विषमान्निस्तरत्यपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2092617, "chapter_id": 2971, "verse_number": "१३-१०१-३", "content_sanskrit": "स शत्रूणामुपरि च सन्तिष्ठति युधिष्ठिर।\nयानं चाश्वतरीयुक्तं तस्य शुभ्रं विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2092618, "chapter_id": 2971, "verse_number": "१३-१०१-४", "content_sanskrit": "उपतिष्ठति कौन्तेय रौप्यकाञ्चनभूषितम्।\nशकटं दम्यसंयुक्तं दत्तं भवति चैव हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2092619, "chapter_id": 2971, "verse_number": "१३-१०१-५x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2092620, "chapter_id": 2971, "verse_number": "१३-१०१-५", "content_sanskrit": "यत्फलं तिलदाने च भूमिदाने च कीर्तितम्।\nगोदाने चान्नदाने च भूयस्तद्ब्रूहि कौरव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2092621, "chapter_id": 2971, "verse_number": "१३-१०१-६x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2092622, "chapter_id": 2971, "verse_number": "१३-१०१-६", "content_sanskrit": "शृणुष्व मम कौन्तैय तिलदानस्य यत्फलम्।\nनिशम्य च यथान्यायं प्रयच्छ कुरुसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2092623, "chapter_id": 2971, "verse_number": "१३-१०१-७", "content_sanskrit": "पितॄणां प्रथमं भोज्यं तिलाः सृष्टाः स्वयंभुवा।\nतिलदानेन वै तस्मात्पितृपक्षः प्रमोदते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2092624, "chapter_id": 2971, "verse_number": "१३-१०१-८", "content_sanskrit": "माघमासे तिलान्यस्तु ब्राह्मणेभ्यः प्रयच्छति।\nसर्वसत्वसमाकीर्णं नरकं स न पश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2092625, "chapter_id": 2971, "verse_number": "१३-१०१-९", "content_sanskrit": "सर्वसत्रैश्च यजते यस्तिलैर्यजते पितॄन्।\nन चाकामेन दातव्यं तिलैः श्राद्धं कदाचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2092626, "chapter_id": 2971, "verse_number": "१३-१०१-१०", "content_sanskrit": "महर्षेः कश्यपस्यैते गात्रेभ्यः प्रसृतास्तिलाः।\nततो दिव्यं गता भावं प्रदानेषु तिलाः प्रभो", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2092627, "chapter_id": 2971, "verse_number": "१३-१०१-११", "content_sanskrit": "पौष्टिका रूपदाश्चैव तथा पापविनाशनाः।\nतस्मात्सर्वप्रदानेभ्यस्तिलदानं विशिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2092628, "chapter_id": 2971, "verse_number": "१३-१०१-१२", "content_sanskrit": "आपस्तम्बश्च मेधावी शङ्खश्च लिखितस्तथा।\nमहर्षिर्गौतमश्चापि तिलदानैर्दिवं गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2092629, "chapter_id": 2971, "verse_number": "१३-१०१-१३", "content_sanskrit": "तिलहोमरता विप्राः सर्वे संयतमैथुनाः।\nसमा गव्येन हविषा प्रवृत्तिषु च संस्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2092630, "chapter_id": 2971, "verse_number": "१३-१०१-१४", "content_sanskrit": "सर्वेषामिति दानानां तिलदानं विशिष्यते।\nअक्षयं सर्वदानानां तिलदानमिहोच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2092631, "chapter_id": 2971, "verse_number": "१३-१०१-१५", "content_sanskrit": "उच्छिन्ने तु पुरा हव्ये कुशिकर्षिः परन्तपः।\nतिलैरग्नित्रयं हुत्वा प्राप्तवान्गतिमुत्तमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2092632, "chapter_id": 2971, "verse_number": "१३-१०१-१६", "content_sanskrit": "इति प्रोक्तं कुरुश्रेष्ठ तिलदानमनुत्तमम्।\nविधानं येन विधिना तिलानामिह शस्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2092633, "chapter_id": 2971, "verse_number": "१३-१०१-१७", "content_sanskrit": "अत ऊर्ध्वं निबोधेदं देवानां यष्टुमिच्छताम्।\nसमागमे महाराज ब्रह्मणा वै स्वयंभुवा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2092634, "chapter_id": 2971, "verse_number": "१३-१०१-१८", "content_sanskrit": "देवाः समेत्य ब्रह्माणं भूमिभागे यियश्रवः।\nशुभं देशमयाचन्त यजेम इति पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2092635, "chapter_id": 2971, "verse_number": "१३-१०१-१९x", "content_sanskrit": "देवा ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2092636, "chapter_id": 2971, "verse_number": "१३-१०१-१९", "content_sanskrit": "भगवंस्त्वं प्रभुर्भूमेः सर्वस्य त्रिदिवस्य च।\nयजेम हि महाभाग यज्ञं भवदनुज्ञया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2092637, "chapter_id": 2971, "verse_number": "१३-१०१-२०", "content_sanskrit": "नाननुज्ञातभूमिर्हि यज्ञस्य फलमश्नुते।\nत्वं हि सर्वस्य जगतः स्थावरस्य चरस्य च।\nप्रभुर्भवसि तस्मात्त्वं समनुज्ञातुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2092638, "chapter_id": 2971, "verse_number": "१३-१०१-२१x", "content_sanskrit": "ब्रह्मोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2092639, "chapter_id": 2971, "verse_number": "१३-१०१-२१", "content_sanskrit": "ददानि मेदिनीभागं भवद्भ्योऽहं सुरर्षभाः।\nयस्मिन्देशे करिष्यध्वं यज्ञान्काश्यपनन्दनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2092640, "chapter_id": 2971, "verse_number": "१३-१०१-२२x", "content_sanskrit": "दैवा ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2092641, "chapter_id": 2971, "verse_number": "१३-१०१-२२", "content_sanskrit": "भगवन्कृतकामाः स्म यक्ष्महे स्वाप्तदक्षिणैः।\nइमं तु देशं मुनयः पर्युपासन्ति नित्यदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2092642, "chapter_id": 2971, "verse_number": "१३-१०१-२३", "content_sanskrit": "ततोऽगस्त्यश्च कण्वश्च भृगुरत्रिर्वृषाकपिः।\nअसितो देवलश्चैव देवयज्ञमुपागमन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2092643, "chapter_id": 2971, "verse_number": "१३-१०१-२४", "content_sanskrit": "ततो देवा महात्मान ईजिरे यज्ञमच्युतम्।\nतथा समापयामासुर्यथाकालं सुरर्षभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2092644, "chapter_id": 2971, "verse_number": "१३-१०१-२५", "content_sanskrit": "त इष्टयज्ञास्त्रिदशा हिमवत्यचलोत्तमे।\nषष्ठमंशं क्रतोस्तस्य भूमिदानं प्रचक्रिरे।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2092645, "chapter_id": 2971, "verse_number": "१३-१०१-२६", "content_sanskrit": "प्रादेशमात्रं भूमेस्तु यो दद्यादनुपस्कृतम्।\nन सीदति स कृच्छ्रेषु न च दुर्गाण्यवाप्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2092646, "chapter_id": 2971, "verse_number": "१३-१०१-२७", "content_sanskrit": "शीतवातातपसहां यागभूमिं सुसंस्कृताम्।\nप्रदाय सुरलोकस्थः पुण्यान्तेऽपि न चाल्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2092647, "chapter_id": 2971, "verse_number": "१३-१०१-२८", "content_sanskrit": "मुदितो वसति प्राज्ञः शक्रेण सह पार्थिव।\nपतिश्रयप्रदानाच्च सोऽपि स्वर्गे महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2092648, "chapter_id": 2971, "verse_number": "१३-१०१-२९", "content_sanskrit": "अध्यापककुले जातः श्रोत्रियो नियतेन्द्रियः।\nगृहे यस्य वसेत्तुष्टः प्रधानं लोकमश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2092649, "chapter_id": 2971, "verse_number": "१३-१०१-३०", "content_sanskrit": "तथा गवार्थे शरणं शीतवर्षसहं दृढम्।\nआसप्तमं तारयति कुलं भरतसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2092650, "chapter_id": 2971, "verse_number": "१३-१०१-३१", "content_sanskrit": "क्षेत्रभूमिं ददल्लोके शुभां श्रियमवाप्नुयात्।\nरत्नभूमिं प्रदद्यात्तु कुलवंशं प्रवर्धयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2092651, "chapter_id": 2971, "verse_number": "१३-१०१-३२", "content_sanskrit": "न चोषरां न निर्दग्धां महीं दद्यात्कथञ्चन।\nन श्मशानपरीतां च न च पापनिषेविताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2092652, "chapter_id": 2971, "verse_number": "१३-१०१-३३", "content_sanskrit": "पारक्ये भूमिदेशे तु पितॄणां निर्वपेत्तु यः।\nतद्भूमिं वाऽपि पितृभिः श्राद्धकर्म विहन्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2092653, "chapter_id": 2971, "verse_number": "१३-१०१-३४", "content_sanskrit": "तस्मात्क्रीत्वा महीं दद्यात्स्वल्पामपि विचक्षणः।\nपिण्डः पितृभ्यो दत्तो वै तस्यां भवति शाश्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2092654, "chapter_id": 2971, "verse_number": "१३-१०१-३५", "content_sanskrit": "अटवी पर्वताश्चैव नद्यस्तीर्थानि यानि च।\nसर्वाण्यस्वामिकान्याद्दुर्न हि तत्र परिग्रहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2092655, "chapter_id": 2971, "verse_number": "१३-१०१-३६", "content_sanskrit": "इत्येतद्भूमिदानस्य फलमुक्तं विशाम्पते।\nअतः परं तु गोदानं कीर्तयिष्यामि तेऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2092656, "chapter_id": 2971, "verse_number": "१३-१०१-३७", "content_sanskrit": "गावोऽधिकास्तपस्विभ्यो यस्मात्सर्वेभ्य एव च।\nतस्मान्महेश्वरो देवस्तपस्ताभिः सहास्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2092657, "chapter_id": 2971, "verse_number": "१३-१०१-३८", "content_sanskrit": "ब्राह्मे लोके वसन्त्येताः सोमेन सह भारत।\nयां तां ब्रह्मर्षयः सिद्धाः प्रार्थयन्ति परां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2092658, "chapter_id": 2971, "verse_number": "१३-१०१-३९", "content_sanskrit": "पयसा हविषा दध्ना शकृता चाथ चर्मणा।\nअस्थिभिश्चोपकुर्वन्ति शृङ्गैर्वालैश्च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2092659, "chapter_id": 2971, "verse_number": "१३-१०१-४०", "content_sanskrit": "नासां शीतातपौ स्यातां सदैताः कर्म कुर्वते।\nन वर्षविषयं वाऽपि दुःखमासां भवत्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2092660, "chapter_id": 2971, "verse_number": "१३-१०१-४१", "content_sanskrit": "ब्राह्मणैः सहिता यान्ति तस्मात्पारमकं पदम्।\nएकं गोब्राह्मणं तस्मात्प्रवदन्ति मनीषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2092661, "chapter_id": 2971, "verse_number": "१३-१०१-४२", "content_sanskrit": "रन्तिदेवस्य यज्ञे ताः पशुत्वेनोपकल्पिताः।\nअतश्चर्मण्वती राजन्गोचर्मभ्यः प्रवर्तिता।\nपशुत्वाच्च विनिर्मुक्ताः प्रदानायोपकल्पिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2092662, "chapter_id": 2971, "verse_number": "१३-१०१-४३", "content_sanskrit": "ता इमा विप्रमुख्येभ्यो यो ददाति महीपते।\nनिस्तरेदापदं कृच्छ्रां विषमस्थोऽपि पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2092663, "chapter_id": 2971, "verse_number": "१३-१०१-४४", "content_sanskrit": "गवां सहस्रदः प्रेत्य नरकं न प्रपद्यते।\nसर्वत्र विजयं चापि लभते मनुजाधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2092664, "chapter_id": 2971, "verse_number": "१३-१०१-४५", "content_sanskrit": "अमृतं वै गवां क्षीरमित्याह त्रिदशाधिपः।\nतस्माद्ददाति यो धेनुममृतं स प्रयच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2092665, "chapter_id": 2971, "verse_number": "१३-१०१-४६", "content_sanskrit": "अग्नीनामव्ययं ह्येतद्धौम्यं वेदविदो विदुः।\nतस्माद्ददाति यो धेनुं स हौम्यं सम्प्रयच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2092666, "chapter_id": 2971, "verse_number": "१३-१०१-४७", "content_sanskrit": "स्वर्गो वै मूर्तिमानेष वृषभं यो गवां पतिम्।\nविप्रे गुणयुते दद्यात्स वै स्वर्गे महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2092667, "chapter_id": 2971, "verse_number": "१३-१०१-४८", "content_sanskrit": "प्राणा वै प्राणिनामेते प्रोच्यन्ते भरतर्षभ।\nतस्माद्ददाति यो धेनुं प्राणानेष प्रयच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2092668, "chapter_id": 2971, "verse_number": "१३-१०१-४९", "content_sanskrit": "गावः शरण्या भूतानामिति वेदविदो विदुः।\nतस्माद्ददाति यो धेनुं शरणं सम्प्रयच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2092669, "chapter_id": 2971, "verse_number": "१३-१०१-५०", "content_sanskrit": "न वधार्थं प्रदातव्या न कीनाशे न नास्तिके।\nगोजीविने न दातव्या तथा गौर्भरतर्षभ।\n`गोरसानां न विक्रेतू रसं च यजनस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2092670, "chapter_id": 2971, "verse_number": "१३-१०१-५१", "content_sanskrit": "ददत्स तादृशानां वै नरो गां पापकर्मणाम्।\nअक्षयं नरकं यातीत्येवमाहुर्महर्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2092671, "chapter_id": 2971, "verse_number": "१३-१०१-५२", "content_sanskrit": "न कृशां नापवत्सां वा वन्ध्यां रोगान्वितां तथा।\nन व्यङ्गां न परिश्रान्तां दद्याद्गां ब्राह्मणाय वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2092672, "chapter_id": 2971, "verse_number": "१३-१०१-५३", "content_sanskrit": "दशगोसहस्रदः सम्यक् शक्रेण सह मोदते।\nअक्षयाँल्लभते लोकान्नरः शतसहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2092673, "chapter_id": 2971, "verse_number": "१३-१०१-५४", "content_sanskrit": "इत्येतद्गोप्रदानं च तिलदानं च कीर्तितम्।\nतथा भूमिप्रदानं च शृणुष्वान्ने च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2092674, "chapter_id": 2971, "verse_number": "१३-१०१-५५", "content_sanskrit": "अन्नदानं प्रधानं हि कौन्तेय परिचक्षते।\nअन्नस्य हि प्रदानेन रन्तिदेवो दिवं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2092675, "chapter_id": 2971, "verse_number": "१३-१०१-५६", "content_sanskrit": "श्रान्ताय क्षुधितायान्नं यः प्रयच्छति भूमिप।\nस्वायंभुवं महात्स्थानं स गच्छति नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2092676, "chapter_id": 2971, "verse_number": "१३-१०१-५७", "content_sanskrit": "न हिरण्यैर्न वासोभिर्नान्यदानेन भारत।\nप्राप्नुवन्ति नराः श्रेयो यथा ह्यन्नप्रदाः प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2092677, "chapter_id": 2971, "verse_number": "१३-१०१-५८", "content_sanskrit": "अन्नं वै प्रथमं द्रव्यमन्नं श्रीश्च परा मता।\nअन्नात्प्राणः प्रभवति तेजो वीर्यं बलं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2092678, "chapter_id": 2971, "verse_number": "१३-१०१-५९", "content_sanskrit": "सद्यो ददाति यश्चान्नं सदैकाग्रमना नरः।\nन स दुर्गाण्यवाप्नोतीत्येवमाह पराशरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2092679, "chapter_id": 2971, "verse_number": "१३-१०१-६०", "content_sanskrit": "अर्चयित्वा यथान्यायं देवेभ्योऽन्नं निवेदयेत्।\nयदन्ना हि नरा राजंस्तदन्नास्तस्य देवतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2092680, "chapter_id": 2971, "verse_number": "१३-१०१-६१", "content_sanskrit": "कौमुद्यां शुक्लपक्षे तु योऽन्नदानं करोत्युत।\nस सन्तरति दुर्गाणि प्रेत्य चानन्त्यमश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2092681, "chapter_id": 2971, "verse_number": "१३-१०१-६२", "content_sanskrit": "अभुक्त्वाऽतिथेये चान्नं प्रयच्छेद्यः समाहितः।\nस वै ब्रह्मविदां लोकान्प्राप्नुयाद्भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2092682, "chapter_id": 2971, "verse_number": "१३-१०१-६३", "content_sanskrit": "सुकृच्छ्रामापदं प्राप्तश्चान्नदः पुरुषस्तरेत्।\nपापं तरति चैवेह दुष्कृतं चापकर्षति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2092683, "chapter_id": 2971, "verse_number": "१३-१०१-६४", "content_sanskrit": "इत्येतदन्नदानस्य तिलदानस्य चैव ह।\nभूमिदानस्य च फलं गोदानस्य च कीर्तितम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2092684, "chapter_id": 2971, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि एकाधिकशततमोऽध्यायः॥ १०१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}]