[{"id": 7003266000, "chapter_id": 23266, "verse_number": "१-६९-१", "content_sanskrit": "सूत उवाच  ।\nसात्त्वतः सत्यसंपन्नः प्रजज्ञे चतुरः सुतान्  ।\nभजनं भ्राभमानं च दिव्यं देवावृधं नृपम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003266001, "chapter_id": 23266, "verse_number": "१-६९-२", "content_sanskrit": "अंधकं च महाभागं वृष्णिं च यदुनंदनम्  ।\nतेषां निसर्गांश्चतुरः श्रृणुध्वं विस्तरेण वै ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003266002, "chapter_id": 23266, "verse_number": "१-६९-३", "content_sanskrit": "सृंजय्यां भजनाच्चैव भ्राजमानाद्विजज्ञिरे  ।\nअयुतायुः शातयुश्च बलवान् हर्षकृत्स्मृतः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003266003, "chapter_id": 23266, "verse_number": "१-६९-४", "content_sanskrit": "तेषां देवावृधो राजा चचार परमं तपः  ।\nपुत्रः सर्वगुणोपेतो मम भूयादिति स्मरन् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003266004, "chapter_id": 23266, "verse_number": "१-६९-५", "content_sanskrit": "तस्य बभ्रुरिति ख्यातः पुण्यश्लोको नृपोत्तमः  ।\nअनुवंशपुराणज्ञा गायंतीति परिश्रुतम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003266005, "chapter_id": 23266, "verse_number": "१-६९-६", "content_sanskrit": "गुणान्देवावृधस्याथ कीर्तयंतो महात्मनः  ।\nयथैव श्रृणुमो दूरात् संपश्यामस्तथांतिकात् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003266006, "chapter_id": 23266, "verse_number": "१-६९-७", "content_sanskrit": "बभ्रुः श्रेष्ठो मनुष्याणां देवैर्देवावृधः समः  ।\nपुरुषाः पंच षष्टिस्तु षट् सहस्राणि चाष्ट च ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003266007, "chapter_id": 23266, "verse_number": "१-६९-८", "content_sanskrit": "येऽमृतत्वमनुप्राप्ता बभ्रोर्देवावृधादपि  ।\nयज्वा दानमतिर्वीरो ब्रह्मण्यस्तु दृढव्रतः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003266008, "chapter_id": 23266, "verse_number": "१-६९-९", "content_sanskrit": "कीर्तिमांश्च महातेजाः सात्त्वतानां महारथः  ।\nतस्यान्ववाये संभूता भोजा वै दैवतोपमाः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003266009, "chapter_id": 23266, "verse_number": "१-६९-१०", "content_sanskrit": "गांधारी चैव माद्री च वृष्णिभार्यो बभूवतुः  ।\nगांधरी जनयामास सुमित्रं मित्रनंदनम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003266010, "chapter_id": 23266, "verse_number": "१-६९-११", "content_sanskrit": "माद्री लेभे च तं पुत्रं ततः सा देवमीढुषम्  ।\nअनमित्रं शिनिं चैव तावुभौ पुरुषोत्तमौ ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003266011, "chapter_id": 23266, "verse_number": "१-६९-१२", "content_sanskrit": "अनमित्रसुतो नघ्न निघ्नोस्य द्वौ बभूवतुः  ।\nप्रसेनश्च महाभागः सत्राजिच्च सुतावुभौ ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003266012, "chapter_id": 23266, "verse_number": "१-६९-१३", "content_sanskrit": "तस्य सत्राजितः सूर्यः सखा प्राणसमोऽभवत्  ।\nस्यमंतको नाम मणिर्दत्तस्तस्मै विवस्वता ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003266013, "chapter_id": 23266, "verse_number": "१-६९-१४", "content_sanskrit": "पृथिव्यां सर्वरत्नानामसौ राजाऽभवन्मणिः  ।\nकदाचिन्मृगयां यातः प्रसेनेन सहैव सः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003266014, "chapter_id": 23266, "verse_number": "१-६९-१५", "content_sanskrit": "वधं प्राप्तो सहायश्च सिंहादेव सुदारुणात्  ।\nअथ पुत्रः शिनेर्जज्ञे कनिष्ठाद्वृष्णिनंदानात् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003266015, "chapter_id": 23266, "verse_number": "१-६९-१६", "content_sanskrit": "सत्यवाक् सत्यसंपन्नः सत्यकस्तस्य चात्मजः  ।\nसात्यकिर्युयुधानस्तु शिनेर्नप्ता प्रतापवान् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003266016, "chapter_id": 23266, "verse_number": "१-६९-१७", "content_sanskrit": "असंगो युयुधानस्य कुणिस्तस्य सुतोऽभवत्  ।\nकुणेर्युगंधरः पुत्रः शैनेया इति कीर्तिताः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003266017, "chapter_id": 23266, "verse_number": "१-६९-१८", "content_sanskrit": "माद्याः सुतस्य संजज्ञे सुतो वार्ष्णिर्युधाजितः  ।\nश्वफल्क इति विख्यातस्त्रैलोक्यहितकारकः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003266018, "chapter_id": 23266, "verse_number": "१-६९-१९", "content_sanskrit": "श्वफल्कश्च महाराजो धर्मात्मा यत्र वर्तते  ।\nनास्ति व्याधिभयं तत्र नावृष्टिभयमप्युत ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003266019, "chapter_id": 23266, "verse_number": "१-६९-२०", "content_sanskrit": "श्वफल्कः काशिराजस्य सुतां भार्यामवाप सः  ।\nगांदिनीं नाम काश्यो हि ददौ तस्मै स्वकन्यकाम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003266020, "chapter_id": 23266, "verse_number": "१-६९-२१", "content_sanskrit": "सा मातुरुदरस्था वै बहून्वर्षगणान्किल  ।\nवसंती न च संजज्ञे गर्भस्था तां पिताऽब्रवीत् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003266021, "chapter_id": 23266, "verse_number": "१-६९-२२", "content_sanskrit": "जायस्व शीघ्रं भद्रं ते किमर्थं चाभितिष्ठसि  ।\nप्रोवाच चैनं गर्भस्था सा कन्या गांदिनी तदा ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003266022, "chapter_id": 23266, "verse_number": "१-६९-२३", "content_sanskrit": "वर्षत्रयं प्रतिदिनं गामेकां ब्राह्मणाय तु  ।\nयदि दद्यास्ततः कुक्षेर्निर्गमिष्याम्यहं पितः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003266023, "chapter_id": 23266, "verse_number": "१-६९-२४", "content_sanskrit": "तथेत्युवाच तस्या वै पिता काममपूरयत्  ।\nदाता शूरश्च यज्वा च श्रुतवानतिथिप्रियः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003266024, "chapter_id": 23266, "verse_number": "१-६९-२५", "content_sanskrit": "तस्याः पुत्रः स्मृतोऽक्रूरः श्वफल्काद्भूरिदक्षिणः  ।\nरत्ना कन्या च शैवस्य ह्यक्रूरस्तामवाप्तवान् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003266025, "chapter_id": 23266, "verse_number": "१-६९-२६", "content_sanskrit": "अस्यामुत्पादयामास तनयांस्तान्निबोधत  ।\nउपमन्युस्तथा मार्गुवृतस्तु जनमेजयः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003266026, "chapter_id": 23266, "verse_number": "१-६९-२७", "content_sanskrit": "गिरिरक्षस्तथोपेक्षः शत्रुघ्नो योरिमर्दनः  ।\nधर्मभृद्दृष्टधर्मा च गोधनोथ वरस्तथा ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003266027, "chapter_id": 23266, "verse_number": "१-६९-२८", "content_sanskrit": "आवाहप्रतिवाहौ च सुधारा च वरांगना  ।\nअक्रूरस्योग्रसेन्यां तु पुत्रौ द्वौ कुलनंदनौ ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003266028, "chapter_id": 23266, "verse_number": "१-६९-२९", "content_sanskrit": "देववानुपदेवश्च जज्ञाते देवसंमतौ  ।\nसुमित्रस्य सुतो जज्ञे चित्रकश्च महायशाः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003266029, "chapter_id": 23266, "verse_number": "१-६९-३०", "content_sanskrit": "चित्रकस्याभवन्पुत्रा विपृथुः पृथुरेव च  ।\nअश्वग्रीवः सुबाहुश्च सुधासूकगवेक्षणौ ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003266030, "chapter_id": 23266, "verse_number": "१-६९-३१", "content_sanskrit": "अरिष्टनेमिरश्वश्च धर्मो धर्मभृदेव च  ।\nसुभूमिर्बहुभूमिश्च श्रविष्ठाश्रवणे स्त्रियौ ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003266031, "chapter_id": 23266, "verse_number": "१-६९-३२", "content_sanskrit": "अंधकात्काश्यदुहिता लेभे च चतुरः सुतान्  ।\nकुकुरं भजमानं च शुचिं कंबलबर्हिषम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003266032, "chapter_id": 23266, "verse_number": "१-६९-३३", "content_sanskrit": "कुकुरस्य सुतो वृष्मिर्वष्णेः शूरस्ततोऽभवत्  ।\nकपोतरोमातिबलस्तस्य पुत्रो विलोमकः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003266033, "chapter_id": 23266, "verse_number": "१-६९-३४", "content_sanskrit": "तस्यासीत्तुंबुरुमखो विद्वान्पुत्रो नलः किल  ।\nख्यायते स सुनाम्ना तु चंदनानकदुंदुभिः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003266034, "chapter_id": 23266, "verse_number": "१-६९-३५", "content_sanskrit": "तस्मादप्यभिजित्पुत्र उत्पन्नोस्य पुनर्वसुः  ।\nअश्वमेधं स पुत्रार्थमाजहार नरोत्तमः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003266035, "chapter_id": 23266, "verse_number": "१-६९-३६", "content_sanskrit": "तस्य मध्येतिरात्रस्य सदोमध्यात्समुत्थितः  ।\nततस्तु विद्वान् सर्वज्ञो दाता यज्वा पुनर्वसुः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003266036, "chapter_id": 23266, "verse_number": "१-६९-३७", "content_sanskrit": "तस्यापि पुत्रमिथुनं बभूवाभिजितः किल  ।\nआहुकश्चाहुकी चैव ख्यातौ कीर्तिमतां वरौ ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003266037, "chapter_id": 23266, "verse_number": "१-६९-३८", "content_sanskrit": "आहुकात्काश्यदुहितुर्द्वौ पुत्रौ संबभूवतुः  ।\nदेवकश्चोग्रसेनश्च देवगर्भसमावुभौ ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003266038, "chapter_id": 23266, "verse_number": "१-६९-३९", "content_sanskrit": "देवकस्य सुता राज्ञो जज्ञिरे त्रिदशोपमाः  ।\nदेववामनुपदेवश्च सुदेवो देवरक्षितः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003266039, "chapter_id": 23266, "verse_number": "१-६९-४०", "content_sanskrit": "तेषां स्वसारः सप्तासन् वसुदेवाय ता ददौ  ।\nवृषदेवोपदेवा च तथान्या देवरक्षिता ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003266040, "chapter_id": 23266, "verse_number": "१-६९-४१", "content_sanskrit": "श्रीदेवा शांतिदेवा च सहदेवा तथापरा  ।\nदेवकी चापि तासां च वरिष्ठाऽभूत्सुमध्यमा ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003266041, "chapter_id": 23266, "verse_number": "१-६९-४२", "content_sanskrit": "नवोग्रसेनस्य सुतास्तेषां कंसस्तु पूर्वजः  ।\nतेषां पुत्राश्च पौत्राश्च शतशोथ सहस्रशः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003266042, "chapter_id": 23266, "verse_number": "१-६९-४३", "content_sanskrit": "देवकस्य सुता पत्नी वसुदेवस्य धीमतः  ।\nबभुव वंद्या पूज्या च देवैरपि पतिव्रता ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003266043, "chapter_id": 23266, "verse_number": "१-६९-४४", "content_sanskrit": "रोहिणी च महाभागा पत्नी चानकदुंदुभेः  ।\nपौरवी बाह्लिकसुता संपूज्यासीत्सुरैरपि ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003266044, "chapter_id": 23266, "verse_number": "१-६९-४५", "content_sanskrit": "असूत रोहिणी रामं बलश्रेष्ठं हलायुधम्  ।\nआश्रितं कंसभीत्या च स्वात्मानं शांततेजसम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003266045, "chapter_id": 23266, "verse_number": "१-६९-४६", "content_sanskrit": "जाते रामेऽथ निहते षङ्गर्भे चातिदक्षिणे  ।\nवसुदेवो हरिं धीमान्देवक्यामुदपादयत् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003266046, "chapter_id": 23266, "verse_number": "१-६९-४७", "content_sanskrit": "स एव परमात्मासौ देवदेवो जनार्दनः  ।\nहलायुधश्च भगवाननंतो रजतप्रभः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003266047, "chapter_id": 23266, "verse_number": "१-६९-४८", "content_sanskrit": "भृगुशापच्छलेनैव मानयन्मानुषीं तनुम्  ।\nबभूव तस्यां देवक्यां वासुदेवो जनार्दन ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003266048, "chapter_id": 23266, "verse_number": "१-६९-४९", "content_sanskrit": "उमादेहसमुद्भूता योगनिद्रा च कौशिकी  ।\nनियोगाद्देवदेवस्य यशोदातनया ह्यभूत् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003266049, "chapter_id": 23266, "verse_number": "१-६९-५०", "content_sanskrit": "सा चैव प्रकृतिः साक्षात्सर्वदेवनमस्कृता  ।\nपुरुषो भगवान्कृष्णो धर्ममोक्षफलप्रदः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003266050, "chapter_id": 23266, "verse_number": "१-६९-५१", "content_sanskrit": "तां कन्यां जगृहे रक्षन्कंसात्स्वस्यात्मजं तदा  ।\nचतुर्भुजं विशालाक्षं श्रीवत्सकृतलांछनम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003266051, "chapter_id": 23266, "verse_number": "१-६९-५२", "content_sanskrit": "शंखचक्रगदापद्मं धारयंतं जनार्दनम्  ।\nयशोदायौ प्रदत्त्वा तु वसुदेवश्च बुद्धिमान् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003266052, "chapter_id": 23266, "verse_number": "१-६९-५३", "content_sanskrit": "दत्त्वैनं नंदगोपस्य रक्षतामिति चाब्रवीत्  ।\nरक्षकं जगतां विष्णुं स्वेच्छया धृतविग्रहम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003266053, "chapter_id": 23266, "verse_number": "१-६९-५४", "content_sanskrit": "प्रसादाच्चैव देवस्य शिवस्यामिततेजसः  ।\nरामेण सार्धं तं दत्त्वा वरदं परमेश्वरम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003266054, "chapter_id": 23266, "verse_number": "१-६९-५५", "content_sanskrit": "भूभारनिग्रहार्थं च ह्यवतीर्णं जगद्गुरुम्  ।\nअतो वै सर्वकल्याणं यादवानां भविष्यति ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003266055, "chapter_id": 23266, "verse_number": "१-६९-५६", "content_sanskrit": "अयं स गर्भो देवक्या यो नः क्लेश्यान्हरिष्यति  ।\nउग्रसेनात्मजायाथ कंसायानकदुंदुभिः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003266056, "chapter_id": 23266, "verse_number": "१-६९-५७", "content_sanskrit": "निवेदयामास तदा जातां कन्यां सुलक्षणाम्  ।\nअस्यास्त वाष्टमो गर्भो देवक्याः कंस सुव्रत ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003266057, "chapter_id": 23266, "verse_number": "१-६९-५८", "content_sanskrit": "मृत्युरेव न संदेह इति वाणी पुरातनी  ।\nततस्तां हंतुमारेभे कंसः सोल्लंघ्य चांबरम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003266058, "chapter_id": 23266, "verse_number": "१-६९-५९", "content_sanskrit": "उवाचाष्टभुजा देवी मेघगंभीरया गिरा  ।\nरक्षस्व तत्स्वकं देहमायातो मृत्युरेव ते ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003266059, "chapter_id": 23266, "verse_number": "१-६९-६०", "content_sanskrit": "रक्षमाणस्य देहस्य मायावी कंसरूपिणः  ।\nकिं कृतं दुष्कृतं मूर्ख जातः खलु तवांतकृत् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003266060, "chapter_id": 23266, "verse_number": "१-६९-६१", "content_sanskrit": "देवक्याः स भयात्कंसो जघानैवाष्टभं त्विति  ।\nस्मरंति विहितो मृत्युर्देवक्यास्त नयोऽष्टमः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003266061, "chapter_id": 23266, "verse_number": "१-६९-६२", "content_sanskrit": "यस्तत्प्रतिकृतौ यत्नो भोजस्यासीद्वृथा हरेः  ।\nप्रभावान्मुनिसार्दूलास्तया चैव जडीकृतः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003266062, "chapter_id": 23266, "verse_number": "१-६९-६३", "content_sanskrit": "कंसोपि निहतस्तेन कृष्णेनाक्लिष्ट कर्मणा  ।\nनिहता बहवश्चान्ये देवब्राह्मणघातिनः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003266063, "chapter_id": 23266, "verse_number": "१-६९-६४", "content_sanskrit": "तस्य कृष्णस्य तनयाः प्रद्युम्नप्रमुखास्तथा  ।\nबहवः परिसंख्याताः सर्वे युद्धविशारदाः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003266064, "chapter_id": 23266, "verse_number": "१-६९-६५", "content_sanskrit": "कृष्णपुत्राः समाख्याताः कृष्णेन सदृशाः सुताः  ।\nपुत्रेष्वेतेषु सर्वेषु चारुदेष्णादयो हरेः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003266065, "chapter_id": 23266, "verse_number": "१-६९-६६", "content_sanskrit": "विशिष्टा बलवंतश्च रौक्मिणेयारिसूदनाः  ।\nषोडशस्त्रीसहस्राणि शतमेकं तथाधिकम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003266066, "chapter_id": 23266, "verse_number": "१-६९-६७", "content_sanskrit": "कृष्णस्य तासु सर्वासु प्रिया ज्येष्ठा च रुक्मिणी  ।\nतया  द्वादशवर्षाणि कृष्णेनाक्लिष्टकर्मणा ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003266067, "chapter_id": 23266, "verse_number": "१-६९-६८", "content_sanskrit": "उष्यता वायुभक्षेण पुत्रार्थं पूजितो हरः  ।\nचारुदेष्णः सुचारुश्च चारुवेषो यशोधरः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003266068, "chapter_id": 23266, "verse_number": "१-६९-६९", "content_sanskrit": "चारुश्रवाश्चारुयशाः प्रद्युम्नः सांब एव च  ।\nएते लब्धास्तु कृष्णेन शूलपाणिप्रसादतः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003266069, "chapter_id": 23266, "verse_number": "१-६९-७०", "content_sanskrit": "तान् दृष्ट्वा तनयान्वीरान् रौक्मिणेयांश्च रुक्मिणीम्  ।\nजांबवत्यब्रवीत्कृष्णं भार्या कृष्णस्य धीमतः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003266070, "chapter_id": 23266, "verse_number": "१-६९-७१", "content_sanskrit": "मम त्वं पुंडरीकाक्ष विशिष्टं गुणवत्तरम्  ।\nसुरेशसंमितं पुत्रं प्रसन्नो दातुमर्हसि ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003266071, "chapter_id": 23266, "verse_number": "१-६९-७२", "content_sanskrit": "जांबवत्या वचः श्रुत्वा जगन्नाथस्ततो हरिः  ।\nतपस्तप्तुं समारेभे तपोनिधिरनिंदितः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003266072, "chapter_id": 23266, "verse_number": "१-६९-७३", "content_sanskrit": "सोऽथ नारायणः कृष्णः शंखचक्रगदाधरः  ।\nव्याग्रपादस्य च मुनेर्गत्वा चैवाश्रमोत्तमम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003266073, "chapter_id": 23266, "verse_number": "१-६९-७४", "content_sanskrit": "ऋषिं दृष्ट्वा त्वंगिरसं प्रणिपत्य जनार्दनः  ।\nदिव्यं पाशुपतं योगं लब्धवांस्तस्य चाज्ञया ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003266074, "chapter_id": 23266, "verse_number": "१-६९-७५", "content_sanskrit": "प्रलुप्तश्मश्रुकेशश्च घृताक्तो मुंजमेखली  ।\nदीक्षितो भगवान्कृष्णस्तताप च परंतपः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003266075, "chapter_id": 23266, "verse_number": "१-६९-७६", "content_sanskrit": "ऊर्ध्व बाहुर्निरालंबः पादांगुष्ठाग्रधिष्ठितः  ।\nफलाम्बवनिलभोजी च ऋतुत्रयमधोक्षजः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003266076, "chapter_id": 23266, "verse_number": "१-६९-७७", "content_sanskrit": "तपसा तस्य संतुष्टो ददौ रुद्रो बहून् वरान्  ।\nसांबं जांबवतीपुत्रं कृष्णाय च महात्मने ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003266077, "chapter_id": 23266, "verse_number": "१-६९-७८", "content_sanskrit": "तथा जांबवती चैव सांबं भार्या हरेः सुतम्  ।\nप्रहर्षमतुलं लेभे लब्ध्वादित्यं यथादितिः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003266078, "chapter_id": 23266, "verse_number": "१-६९-७९", "content_sanskrit": "बाणस्य च तदा तेन च्छेदितं मुनिपुंगवाः  ।\nभुजानां चैव साहस्रं शापाद्रुद्रस्य धीमतः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003266079, "chapter_id": 23266, "verse_number": "१-६९-८०", "content_sanskrit": "अथ दैत्यवधं चक्रे हलायुधसहायवान्  ।\nतथा दुष्टक्षितीशानां लीलयैव रणाजिरे ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003266080, "chapter_id": 23266, "verse_number": "१-६९-८१", "content_sanskrit": "स हत्वा देवसंभूतं नरकं दैत्यपुंगवम्  ।\nब्राह्मणस्योर्ध्वचक्रस्य वरदानान्महात्मनः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003266081, "chapter_id": 23266, "verse_number": "१-६९-८२", "content_sanskrit": "स्वोपबोग्यानि कन्यानां षोडशातुलविक्रमः  ।\nशताधिकानि जग्राह सहस्राणि महाबलः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003266082, "chapter_id": 23266, "verse_number": "१-६९-८३", "content_sanskrit": "शापव्याजेन विप्राणामुपसंहृतवान् कुलम्  ।\nसंहृत्य तत्कुलं चैव प्रभासेऽतिष्ठदच्युतः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003266083, "chapter_id": 23266, "verse_number": "१-६९-८४", "content_sanskrit": "तदा तस्यैव तु गंत वर्षाणामधिकं शतम्  ।\nकृष्णस्य द्वारकायां वै जराक्लेशापहारिणः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003266084, "chapter_id": 23266, "verse_number": "१-६९-८५", "content_sanskrit": "विश्वामित्रस्य कण्वस्य नारदस्य च धीमतः  ।\nशापं पिंडारकेऽरक्षद्वचो दुर्वाससस्तदा ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003266085, "chapter_id": 23266, "verse_number": "१-६९-८६", "content_sanskrit": "त्यक्त्वा च मानुषं रूपं जरकास्त्रच्छलेन तु  ।\nअनुगृह्य च कृष्णोपि लुब्धकं प्रययौ दिवम् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003266086, "chapter_id": 23266, "verse_number": "१-६९-८७", "content_sanskrit": "अष्टावक्रस्य शापेन भार्याः कृष्णस्य धीमतः  ।\nचौरैश्चापहृताः सर्वास्तस्य मायबलेन च ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003266087, "chapter_id": 23266, "verse_number": "१-६९-८८", "content_sanskrit": "बलभद्रोपि संत्यज्य नागो भूत्वा जगाम च  ।\nमहिष्यस्तस्य कृष्णस्य रुक्मिणीप्रमुखाः शुभाः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003266088, "chapter_id": 23266, "verse_number": "१-६९-८९", "content_sanskrit": "सहाग्निं विविशुः सर्वाः कृष्णेनाक्लिष्टकर्मणा  ।\nरेवती च तथा देवी बलभद्रेण धीमता ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003266089, "chapter_id": 23266, "verse_number": "१-६९-९०", "content_sanskrit": "प्रविष्टा पावकं विप्राः सा च भर्तृपथं गता  ।\nप्रेतकार्यं हरेः कृत्वा पार्थः परमवीर्यवान् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003266090, "chapter_id": 23266, "verse_number": "१-६९-९१", "content_sanskrit": "रामस्य च तथान्येषां वृष्णीनामपि सुव्रतः  ।\nकंदमूलफलैस्तस्य बलिकार्यं चकार सः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003266091, "chapter_id": 23266, "verse_number": "१-६९-९२", "content_sanskrit": "द्रव्याभावात्स्वंयं पार्थो भ्रातृभिस्च दिवं गतः  ।\nएवं संक्षेपतः प्रोक्तः कृष्णस्याक्लिष्टकर्मणः ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003266092, "chapter_id": 23266, "verse_number": "१-६९-९३", "content_sanskrit": "प्रभावों विलयश्चैव स्वेच्छयैव महात्मनः  ।\nइत्येतत्सोमवंशानां नृपाणां चरितं द्विजाः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003266093, "chapter_id": 23266, "verse_number": "१-६९-९४", "content_sanskrit": "यः पठेच्छृणुयाद्वापि ब्राह्मणान् श्रावयेदपि  ।\nस याति वैष्णवं लोकं नात्र कार्या विचारणा ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003266094, "chapter_id": 23266, "verse_number": "१-६९-९५", "content_sanskrit": "इति श्रीलिंगमहापुराणे पूर्वभागे सोमवंशानुकीर्तनं नामैकोनसप्ततितमोऽध्याय:।। ६९", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}]