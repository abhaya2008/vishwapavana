[{"id": 7002003000, "chapter_id": 22003, "verse_number": "४८-१", "content_sanskrit": "भगवानुवाच ।\nॐ रूपः केशवः पद्मशङ्खचक्रगदाधरः ।\nनारायणः शङ्खपद्मगदाचक्री प्रदक्षिणम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002003001, "chapter_id": 22003, "verse_number": "४८-२", "content_sanskrit": "ततो गदी माधवोरिशङ्खपद्मी नमामि तम् ।\nचक्रकौमोदकीपद्मशङ्खी गोविन्द ऊर्जितः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002003002, "chapter_id": 22003, "verse_number": "४८-३", "content_sanskrit": "मोक्षदः श्रीगदी पद्मी शङ्खी विष्णुश्च चक्रधृक् ।\nशङ्खचक्राब्जगदिनं मधुसूदनमानमे ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002003003, "chapter_id": 22003, "verse_number": "४८-४", "content_sanskrit": "भक्त्या त्रिविक्रमः पद्मगदी चक्री च शङ्ख्यपि ।\nशङ्खचक्रगदापद्मी वामनः पातु मां सदा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002003004, "chapter_id": 22003, "verse_number": "४८-५", "content_sanskrit": "गतिदः श्रीधरः पद्मी चक्रशार्ङ्गी च शङ्ख्यपि ।\nहृपीकेशो गदा चक्री पद्मी शङ्खी च पातु नः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002003005, "chapter_id": 22003, "verse_number": "४८-६", "content_sanskrit": "वरदः पद्मनाभस्तु शङ्खाब्जारिगदाधरः ।\nदामोदरः पद्मशङ्खगदाचक्री नमामि तम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002003006, "chapter_id": 22003, "verse_number": "४८-७", "content_sanskrit": "तेने गदी शङ्खचक्री वासुदेवोब्जभृज्जगत् ।\nसङ्कर्षणो गदी शङ्खी पद्मी चक्री च पातु वः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002003007, "chapter_id": 22003, "verse_number": "४८-८", "content_sanskrit": "गदी चक्री शङ्खगदी प्रद्युम्नः पद्मभृत् प्रभुः ।\nअनिरुद्धस्चक्रगदी शङ्खी पद्मी च पातु नः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002003008, "chapter_id": 22003, "verse_number": "४८-९", "content_sanskrit": "सुरेशोर्यब्जशङ्खाढ्यः श्रीगदी पुरुपोत्तमः ।\nअधोक्षजः पद्मगदी शङखी चक्री च पातु वः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002003009, "chapter_id": 22003, "verse_number": "४८-१०", "content_sanskrit": "देवो नृसिंहश्चक्राब्जगदाशङ्खी नमामि तम् ।\nअच्युतः श्रीगदी पद्मी चक्री शङ्खी च पातु वः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002003010, "chapter_id": 22003, "verse_number": "४८-११", "content_sanskrit": "बालरूपी शङ्खगदी उपेन्द्रश्चक्रपद्म्यपि ।\nजनार्द्दनः पद्म चक्री शङ्खधारी गदाधरः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002003011, "chapter_id": 22003, "verse_number": "४८-१२", "content_sanskrit": "शङ्खीपद्मी च चक्री चहरिः कौमोदकीधरः ।\nकृष्णः शङ्खी गदी पद्मी चक्री मे भुक्तिमुक्तिदः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002003012, "chapter_id": 22003, "verse_number": "४८-१३", "content_sanskrit": "आदि मूर्त्तिर्वासुदेवस्तस्मात् सङ्कर्पणोभवत् ।\nसङ्कर्पणाच्च प्रद्युम्नः प्रद्युम्नादनिरुद्धकः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002003013, "chapter_id": 22003, "verse_number": "४८-१४", "content_sanskrit": "केशवादिप्रभेदेन एकैकस्य त्रिधा क्रमात् ।\nद्वादशाक्षरकं स्तोत्रं चतुर्विंशातिमूर्त्तिमत् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002003014, "chapter_id": 22003, "verse_number": "४८-१५", "content_sanskrit": "यः पठेच्छृणुयाद्वापि निर्मलः सर्वमाप्नुयात् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]