[{"id": 2114685, "chapter_id": 3465, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2114686, "chapter_id": 3465, "verse_number": "१", "content_sanskrit": "धृतराष्ट्रप्रयुक्तेषु पाण्डवेषु महात्मसु ।\nदुर्योधनः परं हर्षमाजगाम दुरात्मवान् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2114687, "chapter_id": 3465, "verse_number": "२", "content_sanskrit": "ततः सुबलपुत्रश्च कर्णो दुर्योधनस्तथा ।\nदहने सहपुत्रायाः कुन्त्या मतिमकुर्वत \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2114688, "chapter_id": 3465, "verse_number": "३", "content_sanskrit": "मन्त्रयित्वा च तैः सार्धं दुरात्मा धृतराष्ट्रजः ।\nस पुरोचनमेकान्तमानीय भरतर्षभ ।\nगृहीत्वा दक्षिणे पाणौ सचिवं वाक्यमब्रवीत् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2114689, "chapter_id": 3465, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2114690, "chapter_id": 3465, "verse_number": "४", "content_sanskrit": "ममेयं वसुसम्पूर्णा पुरोचन वसुन्धरा ।\nयथैव भविता तात तथा त्वं द्रष्टुमर्हसि \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2114691, "chapter_id": 3465, "verse_number": "५", "content_sanskrit": "न हि मे कश्चिदन्योऽस्ति वैश्वासिकतरस्त्वया ।\nसहायो मेऽसि सन्ध्यायां मन्त्रयेयं यथा त्वया \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2114692, "chapter_id": 3465, "verse_number": "६", "content_sanskrit": "त्वं रक्ष तात मन्त्रं च सपत्नांश्च ममोद्धर ।\nनिपुणेनाभ्युपायेन तव वक्ष्यामि तच्छृणु \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2114693, "chapter_id": 3465, "verse_number": "७", "content_sanskrit": "पाण्डवा धृतराष्ट्रेण प्रेषिता वारणावतम् ।\nउत्सवे विहरिष्यन्ति धृतराष्ट्रस्य शासनात् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2114694, "chapter_id": 3465, "verse_number": "८", "content_sanskrit": "स त्वं रासभयुक्तेन स्यन्दनेनाशुगामिना ।\nवारणावतमद्यैव यथा यासि तथा कुरु \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2114695, "chapter_id": 3465, "verse_number": "९", "content_sanskrit": "तत्र गत्वा चतुःशालं गृहं परमसंवृतम् ।\nआयुधागारमाश्रित्य कारयेथा महाधनम् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2114696, "chapter_id": 3465, "verse_number": "१०", "content_sanskrit": "शणसर्जरसादीनि यानि द्रव्याणि कानि चित् ।\nआग्नेयान्यत्र कुड्येषु तानि द्रव्याणि दापय \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2114697, "chapter_id": 3465, "verse_number": "११", "content_sanskrit": "बल्वजेन च सम्मिश्रं मधूच्छिष्टेन चैव हि ।\nसर्पिषा च सतैलेन लाक्षया चाप्यनल्पया \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2114698, "chapter_id": 3465, "verse_number": "१२", "content_sanskrit": "मृत्तिकां मिश्रयित्वा च लेपं कुड्येषु दापय ।\nशाणवंशकटं दारु वस्त्राणि विविधानि च \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2114699, "chapter_id": 3465, "verse_number": "१३", "content_sanskrit": "वेश्मनस्तस्य सर्वत्र निक्षिपेथाः समन्ततः ।\nसञ्छाद्य तूलमिश्रैश्च क्षिप्रं प्रज्वलितानि च\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2114700, "chapter_id": 3465, "verse_number": "१४", "content_sanskrit": "यथा च तन्न शङ्केरन् परीक्षन्तोऽपि पाण्डवाः ।\nआग्नेयमिति तत् कार्यमपि चान्येऽपि मानवाः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2114701, "chapter_id": 3465, "verse_number": "१५", "content_sanskrit": "वेश्मन्येवं कृते तत्र कृत्वा तान् परमार्चितान् ।\nवासयेथाः पाण्डवेयान् कुन्तीं च ससुहृज्जनाम् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2114702, "chapter_id": 3465, "verse_number": "१६", "content_sanskrit": "तत्रासनानि मुख्यानि यानानि शयनानि च ।\nविधातव्यानि पाण्डूनां यथा तुष्येच्च मे पिता \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2114703, "chapter_id": 3465, "verse_number": "१७", "content_sanskrit": "ततो रमेरन् विश्वस्ता नगरे वारणावते ।\nतथा सर्वं विधातव्यं यावत् कालस्य पर्ययः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2114704, "chapter_id": 3465, "verse_number": "१८", "content_sanskrit": "ज्ञात्वा परमविश्वस्तान् नितरामकुतोभयान् ।\nअग्निस्तत्र त्वया देयो द्वारतस्तस्य वेश्मनः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2114705, "chapter_id": 3465, "verse_number": "१९", "content_sanskrit": "दग्धानेवं स्वके गेहे दग्धा इति ततो जनाः ।\nज्ञातयो न वदिष्यन्ति पाण्डवार्थाय कर्हिचित् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2114706, "chapter_id": 3465, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2114707, "chapter_id": 3465, "verse_number": "२०", "content_sanskrit": "स तथेति प्रतिज्ञाय कौरवाय पुरोचनः ।\nप्रायाद् रासभयुक्तेन नगरं वारणावतम् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2114708, "chapter_id": 3465, "verse_number": "२१", "content_sanskrit": "स गत्वा त्वरितं राजन् दुर्योधनमते स्थितः ।\nयथोक्तं राजपुत्रेण तथा चक्रे पुरोचनः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2114709, "chapter_id": 3465, "verse_number": "२२", "content_sanskrit": "यथाऽऽज्ञप्तं नृपतिना कौरवेण यशस्विना ।\nदाहार्थं पाण्डवेयानां गृहं रौद्रमकारयत् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2114710, "chapter_id": 3465, "verse_number": "२", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nचतुश्चत्वारिंशत्यधिकशततमोऽध्यायः ॥१४४॥ ॥ इति जतुगृहदाहपर्वणि द्वितीयोऽध्यायः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2114711, "chapter_id": 3465, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]