[{"id": 7000987000, "chapter_id": 20987, "verse_number": "३-११-१", "content_sanskrit": "सगर उवाच  ।\nगृहस्थस्य सदाचारं श्रोतुमिच्छाम्यहं मुने ।\nलोकादस्मात्परस्माच्च यमातिष्ठन्न हीयते ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000987001, "chapter_id": 20987, "verse_number": "३-११-२", "content_sanskrit": "और्व उवाच ।\nश्रूयतां पृथिवीपाल सदाचारस्य लक्षणम् ।\nसदाचारवता पुंसा जितौ लोकावुभावपि ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000987002, "chapter_id": 20987, "verse_number": "३-११-३", "content_sanskrit": "साधवः क्षीणदोषास्तु सच्छब्दः साधुवाचकः ।\nतेषामाचरणं यस्तु सदाचारस्स उच्यते ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000987003, "chapter_id": 20987, "verse_number": "३-११-४", "content_sanskrit": "सप्तर्षयोथ मनवः प्रजानां पतयस्तथा ।\nसदाचारस्य वक्तारः कर्तारश्च महीपते ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000987004, "chapter_id": 20987, "verse_number": "३-११-५", "content_sanskrit": "ब्राह्मे मुहूर्त्ते चोत्थाय मनसा मतिमान्नृप ।\nप्रबुद्धश्चिंतयेद्धर्ममर्थं चाप्यविरोधिनम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000987005, "chapter_id": 20987, "verse_number": "३-११-६", "content_sanskrit": "अपीडया तयोः काममुभयोरपि चिंतयेत् ।\nदृष्टादृष्टविनाशाय त्रिवर्गे समदर्शिना ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000987006, "chapter_id": 20987, "verse_number": "३-११-७", "content_sanskrit": "परित्यजेदर्थकामौ धर्मपीडाकरौ नृप ।\nधर्ममप्यसुखोदर्कं लोकविद्वेष्टमेव च ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000987007, "chapter_id": 20987, "verse_number": "३-११-८", "content_sanskrit": "ततः काल्यं समुत्थाय कुर्य्यान्मूत्रं नरेश्वर ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000987008, "chapter_id": 20987, "verse_number": "३-११-९", "content_sanskrit": "नैरृत्यामिषुविक्षेपमतीत्याभ्यधिकं भुवः ।\nदूरादावसथान्मूत्रं पुरीषं च विसर्जयेत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000987009, "chapter_id": 20987, "verse_number": "३-११-१०", "content_sanskrit": "पादावनेजनोच्छिष्टे प्रक्षिपेन्न गृहांगणे ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000987010, "chapter_id": 20987, "verse_number": "३-११-११", "content_sanskrit": "आत्मच्छायां तरुच्छायां गोसूर्य्याग्न्यनिलांस्तथा ।\nगुरुद्विजादींस्तु बुधो नाधिमेहेत्कदाचन ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000987011, "chapter_id": 20987, "verse_number": "३-११-१२", "content_sanskrit": "न कृष्टे सस्यमध्ये वा गौव्रजे जनसंसदि ।\nन वर्त्मनि न नद्यादितीर्थेषु पुरुषर्षभ ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000987012, "chapter_id": 20987, "verse_number": "३-११-१३", "content_sanskrit": "नाप्सु नैवांभसस्तीरे श्मशाने न समाचरेत् ।\nउत्सर्गं वै पुरीषस्य मूत्रस्य च विसर्जनम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000987013, "chapter_id": 20987, "verse_number": "३-११-१४", "content_sanskrit": "उदङ्मुखो दिवामूत्रं विपरीतमुखो निशि ।\nकुर्वीतानापदि प्राज्ञो मूत्रोत्सर्गं च पार्थिव ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000987014, "chapter_id": 20987, "verse_number": "३-११-१५", "content_sanskrit": "तृणैरास्तीर्य्य वसुधां वस्त्रप्रावृतमस्तकः ।\nतिष्ठेन्नातिचिरं तत्र नैव किंचिदुदीरयेत् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000987015, "chapter_id": 20987, "verse_number": "३-११-१६", "content_sanskrit": "वल्मीकमूषिकोद्भूतां मृदं नांतर्जलां तथा ।\nशौचावशिष्टां गेहाच्च नादद्याल्लेपसंभवाम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000987016, "chapter_id": 20987, "verse_number": "३-११-१७", "content_sanskrit": "अणुप्राण्युपपन्नां च हलोत्खातां च पार्थिव ।\nपरित्यजेन्मृदो ह्येतास्सकलाश्शौचकर्मणि ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000987017, "chapter_id": 20987, "verse_number": "३-११-१८", "content_sanskrit": "एका लिंगे गुदे तिस्रो दश वामकरे नृप ।\nहस्तद्वये च सप्त स्युर्मृदश्शौचोपपादिकाः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000987018, "chapter_id": 20987, "verse_number": "३-११-१९", "content_sanskrit": "अच्छेनागंधलेपेन जलेनाबुद्बुदेन च ।\nआचामेच्चमृदं भूयस्तथा दद्यात्समाहितः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000987019, "chapter_id": 20987, "verse_number": "३-११-२०", "content_sanskrit": "निष्पादितांघ्रिशौचस्तु पादावभ्युक्ष्य तैः पुनः ।\nत्रिः पिबेत्सलिलं तेन तथा द्विः परिमार्जयेत् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000987020, "chapter_id": 20987, "verse_number": "३-११-२१", "content_sanskrit": "शिर्षण्यानि ततः खानि मूर्द्धानं च समालभेत् ।\nबाहू नाभिं च तोयेन हृदयं चापि संस्पृश्तो! ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000987021, "chapter_id": 20987, "verse_number": "३-११-२२", "content_sanskrit": "स्वाचांतस्तु ततः कुर्यात्पुमान्केशप्रसाधनम् ।\nआदर्शांजनमांगल्यं दूर्वाद्यालंभनानि च ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000987022, "chapter_id": 20987, "verse_number": "३-११-२३", "content_sanskrit": "ततस्स्ववर्णधर्मेण वृत्त्यर्थं च धनार्जनम् ।\nकुर्वीत श्रद्धासंपन्नो यजेच्च पृथिवीपते ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000987023, "chapter_id": 20987, "verse_number": "३-११-२४", "content_sanskrit": "सोमसंस्था हविस्संस्थाः पाकसंस्थास्तु संस्थिताः ।\nधने यतो मनुष्याणां यतेतातो धनार्जने ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000987024, "chapter_id": 20987, "verse_number": "३-११-२५", "content_sanskrit": "नदीनदतटाकेषु देवखातजलेषु च ।\nनित्यक्रियार्थं स्नायीत गीरिप्रस्रवणेषु च ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000987025, "chapter_id": 20987, "verse_number": "३-११-२६", "content_sanskrit": "कूपेषूद्धृततोयेन स्नानं कुर्वीत वा भुवि ।\nगृहेषूद्धृततोयेन ह्यथवा भुव्यसंभवे ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000987026, "chapter_id": 20987, "verse_number": "३-११-२७", "content_sanskrit": "शुचिवस्त्रधरः स्नातो देवर्षिपितृतर्पणम् ।\nतेषामेव हि तीर्थेन कुर्वीत सुसमाहितः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000987027, "chapter_id": 20987, "verse_number": "३-११-२८", "content_sanskrit": "त्रिरपः प्रीणनार्थाय देवानामपवर्जयेत् ।\nऋषीणां च यथान्यायं सकृच्चापि प्रजापतेः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000987028, "chapter_id": 20987, "verse_number": "३-११-२९", "content_sanskrit": "पितॄणां प्रीणनार्थाय तदपः पृथिवीपते ।\nपितामहेभ्यश्च तथा प्रीणयेत्प्रपितामहान् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000987029, "chapter_id": 20987, "verse_number": "३-११-३०", "content_sanskrit": "मातामहाय तत्पित्रे तत्पित्रे च समाहितः ।\nदद्यात्पैत्रेण तीर्थेन काम्यं चान्यच्छृणुष्व मे ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000987030, "chapter_id": 20987, "verse_number": "३-११-३१", "content_sanskrit": "मात्रे स्वमात्रे तन्मात्रे गुरुपत्न्यै तथा नृप ।\nगुरूणां मातुलानां च स्निग्धमित्राय भूभुजे ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000987031, "chapter_id": 20987, "verse_number": "३-११-३२", "content_sanskrit": "इदं चापि जपेदंबु दद्यादात्मेच्छया नृप ।\nउपकाराय भूतानां कृतदेवादितर्पणम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000987032, "chapter_id": 20987, "verse_number": "३-११-३३", "content_sanskrit": "देवासुरास्तथा यक्षा नागगंधर्वराक्षसाः ।\nपिशाचा गुह्यकास्सिद्धाः कूष्मांडाः पशवः खगाः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000987033, "chapter_id": 20987, "verse_number": "३-११-३४", "content_sanskrit": "जलेचरा भूनिलया वाय्वाहाराश्च जन्तवः ।\nतृप्तिमेतेन यांत्याशु मद्दत्तेनांबुनाऽखिलाः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000987034, "chapter_id": 20987, "verse_number": "३-११-३५", "content_sanskrit": "नरकेषु समस्तेषु यातनासु च संस्थिताः ।\nतेषामाप्यायनायौतद्दीयते सलिलं मया ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000987035, "chapter_id": 20987, "verse_number": "३-११-३६", "content_sanskrit": "ये बांधवाबांधवा ये येन्यजन्मनि बांधवाः ।\nते तृप्तिमखिला यांतु ये चास्मत्तोभिवांछति ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000987036, "chapter_id": 20987, "verse_number": "३-११-३७", "content_sanskrit": "यत्र क्वचनसंस्थानां क्षुत्तृष्णोपहतात्मनाम् ।\nइदमाप्यायनायास्तु मया दत्तं तिलोदकम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000987037, "chapter_id": 20987, "verse_number": "३-११-३८", "content_sanskrit": "काम्योदकप्रदानं ते मयैतत्कथितं नृप ।\nयद्दत्त्वा प्रीणयत्येतन्मनुष्यस्सकलं जगत् ।\nजगदाप्यायनोद्भूतं पुण्यमाप्नोति चानघ ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000987038, "chapter_id": 20987, "verse_number": "३-११-३९", "content_sanskrit": "दत्त्वा काम्योदकं सम्यगेतेभ्यः श्राद्धयान्वितः ।\nआचम्य च ततो दद्यात्सूर्याय सलिलांजलिम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000987039, "chapter_id": 20987, "verse_number": "३-११-४०", "content_sanskrit": "नमो विवस्वते ब्रह्मभास्वते विष्णुतेजसे ।\nजगत्सवित्रे शुचये सवित्रे कर्मसाक्षिणे ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000987040, "chapter_id": 20987, "verse_number": "३-११-४१", "content_sanskrit": "ततो गृहाऽर्चनं कुर्यादभीष्टसुरपूजनम् ।\nजलाभिषेकैः पुष्पैश्च धूपाद्यैश्च निवेदनम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000987041, "chapter_id": 20987, "verse_number": "३-११-४२", "content_sanskrit": "अपूर्वमग्निहोत्रं च कुर्यात्प्राग्ब्रह्मणे नृप ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000987042, "chapter_id": 20987, "verse_number": "३-११-४३", "content_sanskrit": "प्रजापतिं समुद्दिश्य दद्यादाहुतिमादरात् ।\nगृहेभ्यः काश्यपायाथ ततोनुमतये क्रमात् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000987043, "chapter_id": 20987, "verse_number": "३-११-४४", "content_sanskrit": "तच्छेषं मणिके पृथ्वीपर्जन्येभ्यः क्षिपेत्ततः ।\nद्वारे धातुर्विधातुश्च मध्ये च ब्रह्मणे क्षिपेत् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000987044, "chapter_id": 20987, "verse_number": "३-११-४५", "content_sanskrit": "गृहस्य पुरषव्याघ्र दिग्देवानपि मे शृणु ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000987045, "chapter_id": 20987, "verse_number": "३-११-४६", "content_sanskrit": "इंद्रा य धर्मराजाय वरुणाय तथेंदवे ।\nप्राच्यादिषु बुधो दद्याद्धुतश्षोआ!त्मकं बलिम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000987046, "chapter_id": 20987, "verse_number": "३-११-४७", "content_sanskrit": "प्रागुत्तरे च दिग्भागे धन्वंतारिबलिं बुधः ।\nनिर्वपैद्वैश्वदेवं च कर्म कुर्य्यादतः परम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000987047, "chapter_id": 20987, "verse_number": "३-११-४८", "content_sanskrit": "वायव्यां वायवे दिक्षु समस्तासु यथादिशम् ।\nब्रह्मणे चांतरिक्षाय भानवे च क्षिपेद्बलिम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000987048, "chapter_id": 20987, "verse_number": "३-११-४९", "content_sanskrit": "विश्वेदेवान्विश्वभूतानष्टौ विश्वपतीन्पितॄन् ।\nयक्षाणां च समुद्दिश्य बलिं दद्यान्नरेश्वर ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000987049, "chapter_id": 20987, "verse_number": "३-११-५०", "content_sanskrit": "ततोन्यदन्नमादाय भूमि भागे शुचौ बुधः ।\nदद्यादश्षोभूतेभ्यस्स्वेच्छया सुसमाहितः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000987050, "chapter_id": 20987, "verse_number": "३-११-५१", "content_sanskrit": "देवा मनुष्याः पशवो वयांसि सिद्धास्सयक्षोरगदैत्यसंघाः ।\nप्रतोः पिशाचास्तरवस्समस्ता ये चान्नमिच्छंति मयात्र दत्तम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000987051, "chapter_id": 20987, "verse_number": "३-११-५२", "content_sanskrit": "पिपीलिकाः कीटपतंगकाद्या बुभुक्षिताः कर्मनिबंधबद्धाः ।\nप्रयांति ते तृप्तिमिदं मयान्नं तेभ्यो विसृष्टं सुखिनो भवंतु ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000987052, "chapter_id": 20987, "verse_number": "३-११-५३", "content_sanskrit": "येषां न माता न पिता न बंधुर्नैवान्नसिद्धिर्न तथान्नमस्ति ।\nतत्तृप्तयेऽन्नं भुवि दत्तमेव ते यांतु तृप्तिं मुदिता भवंतु ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000987053, "chapter_id": 20987, "verse_number": "३-११-५४", "content_sanskrit": "भूतानि सर्वाणि तथान्नमेतदहं च विष्णुर्न यतोन्यदस्ति ।\nतस्मादहं भूतनिकायभूतमन्नं प्रयच्छामि भवाय तेषाम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000987054, "chapter_id": 20987, "verse_number": "३-११-५५", "content_sanskrit": "चतुर्दशो भूतगणो य एष तत्र स्थिता येऽखिलभूतसंघाः ।\nतृप्त्यर्थमन्नं हि मया निसृष्टं तेषामिदं ते मुदिता भवंतु ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000987055, "chapter_id": 20987, "verse_number": "३-११-५६", "content_sanskrit": "इत्युच्चार्य्य नरो दद्यादन्नं श्रद्धासमन्वितः ।\nभुवि सर्वोपकाराय गृही सर्वाश्रयो यतः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000987056, "chapter_id": 20987, "verse_number": "३-११-५७", "content_sanskrit": "श्वचंडालविहंगानां भुवि दद्यान्नरेश्वर ।\nये चान्ये पतिताः केचिदपुत्राः संति मानवाः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000987057, "chapter_id": 20987, "verse_number": "३-११-५८", "content_sanskrit": "ततो गोदोहमात्रं वै कालं तिष्ठेद्गृहांगणे ।\nअतिथिग्रहणार्थाय तदूर्ध्वं तु यथेच्छया ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000987058, "chapter_id": 20987, "verse_number": "३-११-५९", "content_sanskrit": "अतिथिं तत्र संप्राप्तं पूजयेत्स्वागतादिना ।\nतथासनप्रदानेन पादप्रक्षालनेन च ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000987059, "chapter_id": 20987, "verse_number": "३-११-६०", "content_sanskrit": "श्रद्धया चान्नदानेन प्रियप्रश्नोत्तरेण च ।\nगच्छतश्चानुयानेन प्रीतिमुत्पादयेद्गृही ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000987060, "chapter_id": 20987, "verse_number": "३-११-६१", "content_sanskrit": "अज्ञातकुलनामानमन्यदेशादुपागतम् ।\nपूजयेदतिथिं सम्यङ्नैकग्रामनिवासिनम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000987061, "chapter_id": 20987, "verse_number": "३-११-६२", "content_sanskrit": "अकिंचनमसंबंधमज्ञातकुलशीलिनम् ।\nअसंपूज्यातिथिं भुक्त्वा भोक्तुकामं व्रजत्यधः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000987062, "chapter_id": 20987, "verse_number": "३-११-६३", "content_sanskrit": "स्वाध्यायगोत्राचरणमपृष्ट्वा च तथा कुलम् ।\nहिरण्यगर्भबुद्ध्या तं मन्येताभ्यागतं गृही ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000987063, "chapter_id": 20987, "verse_number": "३-११-६४", "content_sanskrit": "पित्रर्थं चापरं विप्रमेकमप्याशयेन्नृप ।\nतद्देश्यं विदिताचारसंभूतिं पांचयज्ञिकम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000987064, "chapter_id": 20987, "verse_number": "३-११-६५", "content_sanskrit": "अन्नाग्रं च समुद्धृत्य हंतकारोपकल्पितम् ।\nनिर्वापभूतं भूपाल श्रोत्रियायोपपादयेत् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000987065, "chapter_id": 20987, "verse_number": "३-११-६६", "content_sanskrit": "दद्याच्च भिक्षात्रितयं परिव्राड्ब्रह्मचारीणाम् ।\nइच्छया च बुधो दद्याद्विभवे सत्यवारितम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000987066, "chapter_id": 20987, "verse_number": "३-११-६७", "content_sanskrit": "इत्येतेतिथयः प्रोक्ता प्रागुक्ता भिक्षवश्च ये ।\nचतुरः पूजयित्वैतान्नृप पापात्प्रमुच्यते ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000987067, "chapter_id": 20987, "verse_number": "३-११-६८", "content_sanskrit": "अतिथिर्यस्य भग्नाशो गृहात्प्रतिनिवर्त्तते ।\nस तस्मै दुष्कृतं दत्त्वा पुण्यमादाय गच्छति ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000987068, "chapter_id": 20987, "verse_number": "३-११-६९", "content_sanskrit": "धाता प्रजापतिः शक्रो वह्निर्वसुगणोऽर्यया ।\nप्रविश्यातिथिमेते वै भुंजंतेन्नं नरेश्वर ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000987069, "chapter_id": 20987, "verse_number": "३-११-७०", "content_sanskrit": "तस्मादतिथिपूजायां यतेत सततं नरः ।\nस केवलमघं भुंक्ते यो भुंक्ते ह्यतिथिं विना ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000987070, "chapter_id": 20987, "verse_number": "३-११-७१", "content_sanskrit": "ततः स्ववासिनीं दुःखीं गुर्विणीं वृद्धबालकान् ।\nभोजयेत्संस्कृतान्नेन प्रथमं चरमं गृही ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000987071, "chapter_id": 20987, "verse_number": "३-११-७२", "content_sanskrit": "अभुक्तवत्सु चैतेषु भुंजन्भुंक्ते स दुष्कृतम् ।\nमृतश्च गत्वा नरकं श्लेष्मभुग्जायते नरः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000987072, "chapter_id": 20987, "verse_number": "३-११-७३", "content_sanskrit": "अस्नाताशी मलं भुंक्ते ह्यजपी पूयशोणितम् ।\nअसंस्कृतान्नभुङ्मूत्रं बालादिप्रथमं शकृत् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000987073, "chapter_id": 20987, "verse_number": "३-११-७४", "content_sanskrit": "अहोमी च कृमीन्भुंक्ते अदत्त्वा विषमाश्नुते ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000987074, "chapter_id": 20987, "verse_number": "३-११-७५", "content_sanskrit": "तस्माच्छृणुष्व राजेंद्र यथा भुंजीत वै गृही ।\nभुंजतश्च यथा पुंसः पापबंधो न जायते ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000987075, "chapter_id": 20987, "verse_number": "३-११-७६", "content_sanskrit": "इह चारोग्यविपुलं बलबुद्धिस्तथा नृप ।\nभवत्यरिष्टशांतिश्च वैरिपक्षाभिचारिणः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000987076, "chapter_id": 20987, "verse_number": "३-११-७७", "content_sanskrit": "स्नातो यथावत्कृत्वा च देवर्षिपितृतर्पणम् ।\nप्रशस्तरत्नपाणिस्तु भुंजीत प्रयतो गृही ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000987077, "chapter_id": 20987, "verse_number": "३-११-७८", "content_sanskrit": "कृते जपे हुते वह्नौ शुद्धवस्त्रधरो नृप ।\nदत्त्वाऽतिथिभ्यो विप्रेभ्यो गुरुभ्यस्संश्रिताय च ।\nपुण्यगंधश्शस्तमाल्यधारी चैव नरेश्वर ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000987078, "chapter_id": 20987, "verse_number": "३-११-७९", "content_sanskrit": "नैकवस्त्रधरो नार्द्र पाणिपादो महीपते ।\nविशुद्धवदनः प्रीतो भुंजीत न विदिङ्मुखः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000987079, "chapter_id": 20987, "verse_number": "३-११-८०", "content_sanskrit": "प्राङ्मुखोदङ्मुखो वापि न चैवान्यमना नरः ।\nअन्नं प्रशस्तं पथ्यं च प्रोक्षितं प्रोक्षणोदकैः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000987080, "chapter_id": 20987, "verse_number": "३-११-८१", "content_sanskrit": "न कुत्सिताहृतं नैव जुगुप्सापदसंस्कृतम् ।\nदत्त्वा तु भक्तं शिष्येभ्यः क्षुधितेभ्यस्तथा गृही ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000987081, "chapter_id": 20987, "verse_number": "३-११-८२", "content_sanskrit": "प्रशस्तशुद्धपात्रे तु भुंजीताकुपितो द्विजः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000987082, "chapter_id": 20987, "verse_number": "३-११-८३", "content_sanskrit": "नासंदिसंस्थिते पात्रे नादेशो! च नरेश्वर ।\nनाकाले नातिसंकीर्णे दत्त्वाग्रं च नरोग्नये ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000987083, "chapter_id": 20987, "verse_number": "३-११-८४", "content_sanskrit": "मंत्राभिमंत्रितं शस्तं न च पर्युषितं नृप ।\nअन्यत्र फलमूलेभ्यश्शुष्कशाखादिकात्तथा ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000987084, "chapter_id": 20987, "verse_number": "३-११-८५", "content_sanskrit": "तद्वद्धारीतकेभ्यश्च गुडभक्ष्येभ्य एव च ।\nभुंजीतोद्धृतसाराणि न कदापि नरेश्वर ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000987085, "chapter_id": 20987, "verse_number": "३-११-८६", "content_sanskrit": "न श्षॐ पुरुषोश्नीय्यादन्यत्र जगतीपते ।\nमध्वंबुदधिसर्पिभ्यस्सक्तुभ्यश्च विवेकवान् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000987086, "chapter_id": 20987, "verse_number": "३-११-८७", "content_sanskrit": "अश्नीयात्तन्मयो भूत्वा पूर्वं तु मधुरं रसम् ।\nलवणाम्लौ तथा मध्ये कटुतिक्तादिकांस्ततः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000987087, "chapter_id": 20987, "verse_number": "३-११-८८", "content_sanskrit": "प्राग्द्र वं पुरुषोश्नीयान्मध्ये कठिनभोजनः ।\nअंते पुनर्द्रवाशी तु बलारोग्ये न मुंचति ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000987088, "chapter_id": 20987, "verse_number": "३-११-८९", "content_sanskrit": "अनिंद्यं भक्षयेदित्थं वाग्यतोन्नमकुत्सयन् ।\nपंचग्रासं महामौनं प्राणाद्याप्यायनं हि तत् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000987089, "chapter_id": 20987, "verse_number": "३-११-९०", "content_sanskrit": "भुक्त्वा सम्यगथाचम्य प्राङ्मुखोदङ्मुखोपि वा ।\nयथावत्पुनराचामेत्पाणी प्रक्षाल्य मूलतः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000987090, "chapter_id": 20987, "verse_number": "३-११-९१", "content_sanskrit": "स्वस्थः प्रशांतचित्तस्तु कृतासनपरिग्रहः ।\nअभीष्टदेवतानां तु कुर्वीत स्मरणं नरः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000987091, "chapter_id": 20987, "verse_number": "३-११-९२", "content_sanskrit": "अग्निराप्याययेद्धातुं पार्थिवं पवनेरितः ।\nदत्तावकाशं नभसा जरयत्यस्तु मे सुखम् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000987092, "chapter_id": 20987, "verse_number": "३-११-९३", "content_sanskrit": "अन्नं बलाय मे भूमेरपामग्न्यनिलस्य च ।\nभवत्येतत्परीणतं ममास्त्यव्याहतं सुखम् ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7000987093, "chapter_id": 20987, "verse_number": "३-११-९४", "content_sanskrit": "प्राणापानसमानानामुदानव्यानयोस्तथा ।\nअन्नं पुष्टिकरं चास्तु ममाप्यव्याहतं सुखम् ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7000987094, "chapter_id": 20987, "verse_number": "३-११-९५", "content_sanskrit": "अगस्तिरग्निर्वडवानलश्च भुक्तं मयान्नं जरयत्वशेषम् ।\nसुखं च मे तत्परिणामसंभवं यच्छंत्वरोगं मम चास्तु देहे ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7000987095, "chapter_id": 20987, "verse_number": "३-११-९६", "content_sanskrit": "विष्णुस्समस्तेंद्रियदेहदेही वृथा न भूतो भगवान्यथैकः ।\nसत्येन तेनात्तमश्षोमन्नमारोग्यतां मे परिणाममेतु ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7000987096, "chapter_id": 20987, "verse_number": "३-११-९७", "content_sanskrit": "विष्णुरत्ता तथैवान्नं परिणामश्च वै तथा ।\nसत्येन तेन मद्भुक्तं जीर्यत्यन्नमिदं तथा ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7000987097, "chapter_id": 20987, "verse_number": "३-११-९८", "content_sanskrit": "इत्युच्चार्य्य स्वहस्तेन परिमृज्य तथोदरम् ।\nअनायासप्रदायीनि कुर्य्यात्कर्माण्यतंद्रि तः ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7000987098, "chapter_id": 20987, "verse_number": "३-११-९९", "content_sanskrit": "सच्छास्त्रादिविनोदेन सन्मार्गादविरोधिना ।\nदिनं नयेत्ततस्संध्यामुपतिष्ठेत्समाहितः ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7000987099, "chapter_id": 20987, "verse_number": "३-११-१००", "content_sanskrit": "दिनांतसंध्यां सूर्येण पूर्वामृक्षैर्युतां बुधः ।\nउपतिष्ठेद्यथान्याय्यं सम्यगाचम्य पार्थिव ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7000987100, "chapter_id": 20987, "verse_number": "३-११-१०१", "content_sanskrit": "सर्वकालमुपस्थानं संध्ययोः पार्थिवेष्यते।\nअन्यत्र सूतकाशौचविभ्रमातुरभीतितः ॥१०१।॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7000987101, "chapter_id": 20987, "verse_number": "३-११-१०२", "content_sanskrit": "सूर्येणाभ्युदितो यश्च त्यक्तः सूर्येण वा स्वपन् ।\nअन्यत्रातुरभावात्तु प्रायश्चित्ती भवेन्नरः ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7000987102, "chapter_id": 20987, "verse_number": "३-११-१०३", "content_sanskrit": "तस्मादनुदिते सूर्य्ये समुत्थाय महीपते ।\nउपतिष्ठेन्नरस्संध्यामस्वपंश्च दिनांतजाम् ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7000987103, "chapter_id": 20987, "verse_number": "३-११-१०४", "content_sanskrit": "उपतिष्ठंति वै संध्यां ये न पूर्वां न पश्चिमाम् ।\nव्रजंति ते दुरात्मानस्तमिस्रं नरकं नृप ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7000987104, "chapter_id": 20987, "verse_number": "३-११-१०५", "content_sanskrit": "पुनः पाकमुपादाय सायमप्यवनीपते ।\nवैश्वदेवनिमित्तं वै पत्न्या सार्द्धं बलिं हरेत् ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7000987105, "chapter_id": 20987, "verse_number": "३-११-१०६", "content_sanskrit": "तत्रापि श्वपचादिभ्यस्तथैवान्नविसर्जनम् ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7000987106, "chapter_id": 20987, "verse_number": "३-११-१०७", "content_sanskrit": "अतिथिं चागतं तत्र स्वशक्तया पूजयेद्बुधः ।\nपादशौचासनप्रह्वस्वागतोक्त्या च पूजनम् ।\nततश्चान्नप्रदानेन शयनेन च पार्थिव ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7000987107, "chapter_id": 20987, "verse_number": "३-११-१०८", "content_sanskrit": "दिवातिथौ तु विमुखे गते यत्पातकं नृप ।\nतदेवाष्टगुणं पुंसस्सूर्य्योढे विमुखे गते ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7000987108, "chapter_id": 20987, "verse_number": "३-११-१०९", "content_sanskrit": "तस्मात्स्वशक्त्या राजेंद्र सूर्य्योढमतिथिं नरः ।\nपूजयेत्पूजिते तस्मिन्पूजितास्सर्वदेवता ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7000987109, "chapter_id": 20987, "verse_number": "३-११-११०", "content_sanskrit": "अन्नशकांबुदानेन स्वशक्त्या पूजयेत्पुमान् ।\nशयनप्रस्तरमहीप्रदानैरथवापि तम् ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7000987110, "chapter_id": 20987, "verse_number": "३-११-१११", "content_sanskrit": "कृतपादादिशौचस्तु भुक्त्वा सायं ततो गृही ।\nगच्छेच्छय्यामस्फुटितामपि दारुमयीं नृप ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7000987111, "chapter_id": 20987, "verse_number": "३-११-११२", "content_sanskrit": "नाविशालां न वै भुग्नां नासमां मलिनां न च ।\nन च जंतुमयींशय्यामधितिष्ठेदनास्तृताम् ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7000987112, "chapter_id": 20987, "verse_number": "३-११-११३", "content_sanskrit": "प्राच्यां दिशि शिरश्शस्तं याम्यायामथ वा नृप ।\nसदैव स्वपतः पुंसो विपरीतं तु रोगदम् ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7000987113, "chapter_id": 20987, "verse_number": "३-११-११४", "content_sanskrit": "ऋतावुपगमश्शस्तस्स्वपत्न्यामवनीपते ।\nपुन्नामर्क्षे शुभे काले ज्येष्ठायुग्मासु रात्रिषु ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7000987114, "chapter_id": 20987, "verse_number": "३-११-११५", "content_sanskrit": "नाद्यूनां तु स्त्रियं गच्छेन्नातुरां न रजस्वलाम् ।\nनानिष्टां न प्रकुपितां न त्रस्तां न च गर्भिणीम् ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7000987115, "chapter_id": 20987, "verse_number": "३-११-११६", "content_sanskrit": "नादक्षिणां नान्यकामां नाकामां नान्ययोषितम् ।\nक्षुत्क्षामां नातिभुक्तां वा स्वयं चैभिर्गुणैर्युतः ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7000987116, "chapter_id": 20987, "verse_number": "३-११-११७", "content_sanskrit": "स्नातस्स्रग्गंधधृक्प्रीतो नाध्मातः क्षुधितोपि वा ।\nसकामस्सानुरागश्च व्यवायं पुरुषो व्रजेत् ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7000987117, "chapter_id": 20987, "verse_number": "३-११-११८", "content_sanskrit": "चतुर्दश्यष्टमी चैव तथा माचाथ पूर्णिमा ।\nपर्वाण्येतानि राजेंद्र रविसंक्रांतिरेव च ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7000987118, "chapter_id": 20987, "verse_number": "३-११-११९", "content_sanskrit": "तैलस्त्रीमांससंभोगी सर्वेष्वेतेषु वै पुमान् ।\nविण्मूत्रभोजनं नाम प्रयाति नरकं मृतः ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7000987119, "chapter_id": 20987, "verse_number": "३-११-१२०", "content_sanskrit": "अश्षोपर्वस्वेतेषु तस्मात्संयमिभिर्बुधैः ।\nभाव्यं सच्छास्त्रदेवेज्याध्यानजप्यपरैर्नरैः ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7000987120, "chapter_id": 20987, "verse_number": "३-११-१२१", "content_sanskrit": "नान्ययोनावयोनौ वा नोपयुक्तौषधस्तथा ।\nद्विजदेवगुरूणां च व्यवायी नाश्रमे भवेत् ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7000987121, "chapter_id": 20987, "verse_number": "३-११-१२२", "content_sanskrit": "चैत्यचत्वरतीरेषु नैव गोष्ठे चतुष्पथे ।\nनैव श्मशानोपवने सलिलेषु महीपते ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7000987122, "chapter_id": 20987, "verse_number": "३-११-१२३", "content_sanskrit": "प्रोक्तपर्वस्वश्षोए!षु नैव भूपाल संध्ययोः ।\nगच्छेद्व्यवायं मनसा न मूत्रोच्चारपीडितः ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7000987123, "chapter_id": 20987, "verse_number": "३-११-१२४", "content_sanskrit": "पर्वस्वभिगमोनिन्द्यो दिवा पापप्रदो नृप ।\nभुवि रोगावहो नॄणामप्रशस्तो जलाशये ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7000987124, "chapter_id": 20987, "verse_number": "३-११-१२५", "content_sanskrit": "परदारान्न गच्छेत मनसापि कथंचन ।\nकिमु वाचास्थिबंधोपि नास्ति तेषु व्यवायिनाम् ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7000987125, "chapter_id": 20987, "verse_number": "३-११-१२६", "content_sanskrit": "मृतो नरकमभ्येति हीयते त्रापि चायुषः ।\nपरदाररतिः पुंसामिह चामुत्र भीतिदा ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7000987126, "chapter_id": 20987, "verse_number": "३-११-१२७", "content_sanskrit": "इति मत्वा स्वदारेषु ऋतुमत्सु बुधो व्रजेत् ।\nयथोक्तदोषहीनेषु सकामेष्वनृतावपि ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}]