[{"id": 2059171, "chapter_id": 2274, "verse_number": "७-२०१-०x", "content_sanskrit": "सञ्जय उवाय।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2059172, "chapter_id": 2274, "verse_number": "७-२०१-१", "content_sanskrit": "भीमसेनं समाकीर्णं दृष्ट्वाऽस्त्रेण धनञ्जयः।\nतेजसः प्रतिघातार्थं वारुणेन समावृणोत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2059173, "chapter_id": 2274, "verse_number": "७-२०१-२", "content_sanskrit": "नालक्षयत तत्कश्चिद्वारुणास्त्रेण संवृतम्।\nअर्जुनस्य लघुत्वाच्च संवृतत्वाच्च तेजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2059174, "chapter_id": 2274, "verse_number": "७-२०१-३", "content_sanskrit": "साश्वसूतरथो भीमो द्रोणपुत्रास्त्रसंवृतः।\nअग्नावग्निरिव न्यस्तो ज्वालामाली सुदुर्दृशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2059175, "chapter_id": 2274, "verse_number": "७-२०१-४", "content_sanskrit": "यथा रात्रिक्षये राजञ्ज्योतीष्यस्तगिरिं प्रति।\nसमापेतुस्तथा बाणा भीमसेनरथं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2059176, "chapter_id": 2274, "verse_number": "७-२०१-५", "content_sanskrit": "स हि भीमो रथश्चास्य हयाः सूतश्च मारिष।\nसंवृता द्रोणपुत्रेण पावकान्तर्गताऽभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2059177, "chapter_id": 2274, "verse_number": "७-२०१-६", "content_sanskrit": "यथा जग्ध्वा जगत्कृत्स्नं समये सचराचरम्।\nगच्छेद्वह्निर्विभोरास्यं तथाऽस्त्रं भीममावृणोत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2059178, "chapter_id": 2274, "verse_number": "७-२०१-७", "content_sanskrit": "सूर्यमग्निः प्रविष्टः स्याद्यथा चाग्निं दिवाकरः।\nतथा प्रविष्टं तत्तेजो न आज्ञायत पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2059179, "chapter_id": 2274, "verse_number": "७-२०१-८", "content_sanskrit": "`तदस्त्रं भीमहुङ्कारादपयाति पुनःपुनः।\nपुनः पुनस्तमायाति हुंकारात्तं विमुञ्चति।\nततो देवाः सगन्धर्वा भीमं दृष्ट्वा सुविस्मिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2059180, "chapter_id": 2274, "verse_number": "७-२०१-९", "content_sanskrit": "विकीर्णमस्त्रं तद्दृष्ट्वा तथा भीमरथं प्रति।\nउदीर्यमाणं द्रौणिं च निष्प्रतिद्वन्द्वमाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2059181, "chapter_id": 2274, "verse_number": "७-२०१-१०", "content_sanskrit": "सर्वसैन्यं च पाण्डूनां न्यस्तशस्त्रमचेतनम्।\nयुधिष्ठिरपुरोगांश्च विमुखांस्तान्महारथनान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2059182, "chapter_id": 2274, "verse_number": "७-२०१-११", "content_sanskrit": "अर्जुनो वासुदेवश्च त्वरमाणौ महाद्युती।\nअवप्लुत्य रथाद्वीरौ भीममाद्रवतां ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2059183, "chapter_id": 2274, "verse_number": "७-२०१-१२", "content_sanskrit": "ततस्तद्द्रोणपुत्रस्य तेजोऽस्त्रबलसम्भवम्।\nविगाह्य तौ सुबलिनौ माययाऽविशतां तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2059184, "chapter_id": 2274, "verse_number": "७-२०१-१३", "content_sanskrit": "न्यस्तशस्त्रौ ततस्तौ तु नादहत्सोऽस्त्रजोऽनलः।\nवारुणास्त्रप्रयोगाच्च वीर्यवत्त्वाच्च कृष्णयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2059185, "chapter_id": 2274, "verse_number": "७-२०१-१४", "content_sanskrit": "ततश्चकृषतुर्भीमं सर्वशस्त्रायुधानि च।\nनारायणास्त्रशान्त्यर्थं नरनारायणौ बलात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2059186, "chapter_id": 2274, "verse_number": "७-२०१-१५", "content_sanskrit": "आकृष्यमाणः कौन्तेयो नदत्येव महारवम्।\nवर्धते चैव तद्वोरं द्रौणेरस्त्रं सुदुर्जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2059187, "chapter_id": 2274, "verse_number": "७-२०१-१६", "content_sanskrit": "तमब्रवीद्वासुदेवः किमिदं पाण्डुनन्दन।\nवार्यमाणोऽपि कौन्तेय यद्युद्वान्न निवर्तसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2059188, "chapter_id": 2274, "verse_number": "७-२०१-१७", "content_sanskrit": "यदि युद्वेन जेयाः स्युरिमे कौरवनन्दनाः।\nवयमप्यत्र युध्येम तथा चेमे नरर्षभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2059189, "chapter_id": 2274, "verse_number": "७-२०१-१८", "content_sanskrit": "रथेभ्यस्त्ववतीर्णाः स्म सर्व एव हि तावकाः।\nतस्मात्त्वमपि कौन्तेय रथात्तूर्णमपाक्रम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2059190, "chapter_id": 2274, "verse_number": "७-२०१-१९", "content_sanskrit": "एवमुक्त्वा तु तं कृष्णो रथाद्भूमिमवर्तयत्।\nनिःश्वसन्तं यथा नागं क्रोधसंरक्तलोचनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2059191, "chapter_id": 2274, "verse_number": "७-२०१-२०", "content_sanskrit": "यदाऽपकृष्टः स रथान्न्यासितश्चायुधं भुवि।\nततो नारायणास्त्रं तत्प्रशान्तं शत्रुतापनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2059192, "chapter_id": 2274, "verse_number": "७-२०१-२१x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2059193, "chapter_id": 2274, "verse_number": "७-२०१-२१", "content_sanskrit": "तस्मिन्प्रशान्ते विधिना तेन तेजसि दुःसहे।\nबभूवुर्विमलाः सर्वा दिशः प्रदिश एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2059194, "chapter_id": 2274, "verse_number": "७-२०१-२२", "content_sanskrit": "प्रववुश्च शिवा वाताः प्रशान्ता मृगपक्षिणः।\nवाहनानि च हृष्टानि प्रशान्तेऽस्त्रे सुदुर्जये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2059195, "chapter_id": 2274, "verse_number": "७-२०१-२३", "content_sanskrit": "व्यपोढे च ततो घोरे तस्मिंस्तेजसि भारत।\nबभौ भीमो निशापाये धीमान्सूर्य इवोदितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2059196, "chapter_id": 2274, "verse_number": "७-२०१-२४", "content_sanskrit": "हतशेषं बलं तत्तु पाण्डवानामतिष्ठत।\nअस्त्रव्युपरमाद्वृष्टं तव पुत्रजिघांसया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2059197, "chapter_id": 2274, "verse_number": "७-२०१-२५", "content_sanskrit": "व्यवस्थिते बले तस्मिन्नेस्त्रे प्रतिहते तथा।\nदुर्योधनो महाराज द्रोणपुत्रमथाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2059198, "chapter_id": 2274, "verse_number": "७-२०१-२६", "content_sanskrit": "अश्वत्थामन्पुनः शीघ्रमस्त्रमेतत्प्रयोजय।\nअवस्थिता हि पाञ्चालाः पुनरेते जयैषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2059199, "chapter_id": 2274, "verse_number": "७-२०१-२७", "content_sanskrit": "अश्वत्थामा तथोक्तस्तु तव पुत्रेण मारिष।\nसुदीनमभिनिः श्वस्य राजानमिदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2059200, "chapter_id": 2274, "verse_number": "७-२०१-२८", "content_sanskrit": "नैतदावर्तते राजन्नस्त्रं द्विर्नोपपद्यते।\nआवृतं हि निवर्तेत प्रयोक्तारं न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2059201, "chapter_id": 2274, "verse_number": "७-२०१-२९", "content_sanskrit": "एष चास्त्रप्रतीघातं वासुदेवः प्रयुक्तवान्।\n`अस्य तु ह्येष वै दाता मानुषेषु न विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2059202, "chapter_id": 2274, "verse_number": "७-२०१-३०", "content_sanskrit": "परावरज्ञो लोकानां न तदस्ति न वेत्ति यत्।\nतदेतदस्त्रं प्रशमं यातं कृष्णस्य मन्त्रितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2059203, "chapter_id": 2274, "verse_number": "७-२०१-३१", "content_sanskrit": "द्विविधो विहितः सङ्ख्ये वधः शस्त्रोर्जनाधिप।\nपराजयो वा मृत्युर्वा श्रेयान्मृत्युर्न निर्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2059204, "chapter_id": 2274, "verse_number": "७-२०१-३२", "content_sanskrit": "विजिताश्चारयो ह्योते शस्त्रोत्सर्गान्मृतोपमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2059205, "chapter_id": 2274, "verse_number": "७-२०१-३३x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2059206, "chapter_id": 2274, "verse_number": "७-२०१-३३", "content_sanskrit": "आचार्यपुत्र यद्येतद्द्विरस्त्रं न प्रयुज्यते।\nअन्यैर्गुरुघ्ना वध्यन्तामस्त्रैरस्त्रविदां वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2059207, "chapter_id": 2274, "verse_number": "७-२०१-३४", "content_sanskrit": "त्वयि शस्त्राणि दिव्यानि त्र्यम्बके चामितौजसि।\n`घ्नतैतान्सुमहावीर्य शात्रवान्युद्वकोविदः।\nइच्छतो न हि ते मुच्येत्सङ्क्रुद्धो हि पुरन्दरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2059208, "chapter_id": 2274, "verse_number": "७-२०१-३५x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2059209, "chapter_id": 2274, "verse_number": "७-२०१-३५", "content_sanskrit": "तस्मिन्नस्त्रे प्रतिहते द्रोणे चोपधिना हते।\nतथा दुर्योधनेनोक्तो द्रौणिः किमकरोत्पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2059210, "chapter_id": 2274, "verse_number": "७-२०१-३६", "content_sanskrit": "दृष्ट्वा पार्थांश्च सङ्ग्रामे युद्धाय समुपस्थितान्।\nनारायणास्त्रनिर्मुक्तांश्चरतः पृतनामुखे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2059211, "chapter_id": 2274, "verse_number": "७-२०१-३७x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2059212, "chapter_id": 2274, "verse_number": "७-२०१-३७", "content_sanskrit": "जानन्पितुः स निधनं सिंहलाङ्गूलकेतनः।\nसक्रोधो भयमुत्सृज्य सोऽभिदुद्राव पार्षतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2059213, "chapter_id": 2274, "verse_number": "७-२०१-३८", "content_sanskrit": "अभिद्रुत्य च विंशत्या क्षुद्रकाणां नरर्षभ।\nपञ्चभिश्चातिवेगेन विव्याध पुरुषर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2059214, "chapter_id": 2274, "verse_number": "७-२०१-३९", "content_sanskrit": "धृष्टद्युम्नस्ततो राजञ्ज्वलन्तमिव पावकम्।\nद्रोणपुत्रं त्रिषष्ट्या तु राजन्विव्याध पत्रिणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2059215, "chapter_id": 2274, "verse_number": "७-२०१-४०", "content_sanskrit": "सारथिं चास्य विंशत्या स्वर्णपुङ्खैः शिलाशितैः।\nहयांश्च चतुरोऽविध्यच्चतुर्भिर्निशितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2059216, "chapter_id": 2274, "verse_number": "७-२०१-४१", "content_sanskrit": "विद्व्वा विद्वाऽनदद्द्रौणिं कम्पयन्निव मेदिनीम्।\nआददे सर्वलोकस्य प्राणानिव महारणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2059217, "chapter_id": 2274, "verse_number": "७-२०१-४२", "content_sanskrit": "पार्षतस्तु बली राजन्कृतास्त्रः कृतनिश्चयः।\nद्रौणिमेवाभिदुद्राव मृत्युं कृत्वा निवर्तनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2059218, "chapter_id": 2274, "verse_number": "७-२०१-४३", "content_sanskrit": "ततो बाणमयं वर्षं द्रोणपुत्रस्य मूर्धनि।\nअवासृजदमेयात्मा पाञ्चाल्यो रथिनांवरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2059219, "chapter_id": 2274, "verse_number": "७-२०१-४४", "content_sanskrit": "तं द्रौणिः समरे क्रुद्धं छादयामास पत्रिभिः।\nविव्याध चैनं दशभिः पितुर्वधमनुस्मरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2059220, "chapter_id": 2274, "verse_number": "७-२०१-४५", "content_sanskrit": "द्वाभ्यां च सुविसृष्टाभ्यां क्षुराभ्यां ध्वजकार्मुके।\nछित्त्वा पाञ्चालराजस्य द्रौणिरन्यैः समार्दयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2059221, "chapter_id": 2274, "verse_number": "७-२०१-४६", "content_sanskrit": "व्यश्वसूतरथं चैनं द्रौणिश्चक्रे महाहावे।\nतस्य चानुचरान्सर्वान्क्रुद्धः प्राद्रावयच्छरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2059222, "chapter_id": 2274, "verse_number": "७-२०१-४७", "content_sanskrit": "ततः प्रदुद्रुवे सैन्यं पाञ्चालानां विशाम्पते।\nसम्भ्रान्तरूपमार्तं च न परस्परमैक्षत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2059223, "chapter_id": 2274, "verse_number": "७-२०१-४८", "content_sanskrit": "दृष्ट्वा तु विमुखान्योधान्धृष्टद्युम्नं च पीडितम्।\nशैनेयोऽचोदयत्तूर्णं रथं द्रौणिरथं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2059224, "chapter_id": 2274, "verse_number": "७-२०१-४९", "content_sanskrit": "अष्टभिर्निशितैर्बाणैरश्वत्थामानमार्दयत्।\nविंशत्या पुनराहत्य नानारूपैरमर्षणः।\nविव्याध च तथा सूतं चतुर्भिश्चतुरो हयान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2059225, "chapter_id": 2274, "verse_number": "७-२०१-५०", "content_sanskrit": "[धनुर्ध्वजं* ; संयत्तश्चिच्छेद कृतहस्तवत्।\nस साश्वं व्यधमच्चापि रथं हेमपरिष्कृतम्।\nहृदि विव्याध समरे त्रिंशता सायकैर्भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2059226, "chapter_id": 2274, "verse_number": "७-२०१-५१", "content_sanskrit": "एवं स पीडितो राजन्नश्वत्थामा महाबालः।\nशरजालैः परिवृतः कर्तव्यं नान्वपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2059227, "chapter_id": 2274, "verse_number": "७-२०१-५२", "content_sanskrit": "एवं गते गुरोः पुत्रे तव पुत्रो महारथः।\nकृपकर्णादिभिः सार्धं शरैः सात्वतमावृणोत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2059228, "chapter_id": 2274, "verse_number": "७-२०१-५३", "content_sanskrit": "दुर्योधनस्तु विंशत्या कृपः शारद्वतस्त्रिभिः।\nकृतवर्माऽथ दशभिः कर्णः पञ्चाशता शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2059229, "chapter_id": 2274, "verse_number": "७-२०१-५४", "content_sanskrit": "दुःशासनः शतेनैव वृषसेनश्च सप्तभिः।\nसात्यकिं विव्यधुस्तूर्णं समन्तान्निशितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2059230, "chapter_id": 2274, "verse_number": "७-२०१-५५", "content_sanskrit": "ततः स सात्यकी राजन्सर्वानेव महारथान्।\nविरथान्विमुखांश्चैव क्षणेनैवाकरोन्नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2059231, "chapter_id": 2274, "verse_number": "७-२०१-५६", "content_sanskrit": "अश्वत्थामा तु सम्प्राप्य चेतनां भरतर्षभ।\nचिन्तयामास दुःखार्तो निःश्वसंश्च पुनःपुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2059232, "chapter_id": 2274, "verse_number": "७-२०१-५७", "content_sanskrit": "अथो रथान्तरं द्रौणिः समारुह्य परन्तपः।\nसात्यकिं वारयामास किरञ्शरशतान्बहून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2059233, "chapter_id": 2274, "verse_number": "७-२०१-५८", "content_sanskrit": "तमापतन्तं सम्प्रेक्ष्य भारद्वाजसुतं रणे।\nविरथं विमुखं चैव पुनश्चक्रे महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2059234, "chapter_id": 2274, "verse_number": "७-२०१-५९", "content_sanskrit": "ततस्ते पाण्डवा राजन्दृष्ट्वा सात्यकिविक्रमम्।\nशङ्खशब्दान्भृशं चक्रुः सिंहनादांश्च नेदिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2059235, "chapter_id": 2274, "verse_number": "७-२०१-६०", "content_sanskrit": "एवं तं विरथं कृत्वा सात्यकिः सत्यविक्रमः।\nजघान वृषसेनस्य त्रिसाहस्रान्महारथान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2059236, "chapter_id": 2274, "verse_number": "७-२०१-६१", "content_sanskrit": "अयुतं दन्तिनां सार्धं कृपस्य निजघान सः।\nपञ्चायुतानि चाश्वानां शकुनेर्निजघान ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2059237, "chapter_id": 2274, "verse_number": "७-२०१-६२", "content_sanskrit": "ततो द्रौणिर्महाराज रथमारुह्य वीर्यवान्।\nसात्यकिं प्रति सङ्क्रुद्धः प्रययौ तद्वधेप्सया।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2059238, "chapter_id": 2274, "verse_number": "७-२०१-६३", "content_sanskrit": "पुनस्तमागतं दृष्ट्वा शनेयो निशितैः शरैः।\nअदारयत्क्रुरतरैः पुनःपुनररिन्दम॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2059239, "chapter_id": 2274, "verse_number": "७-२०१-६४", "content_sanskrit": "सोऽतिविद्धो महेष्वासो नानालिङ्गैरमर्षणः।\nयुयुधानेन वै द्रौणिः प्रहसन्वाक्यमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2059240, "chapter_id": 2274, "verse_number": "७-२०१-६५", "content_sanskrit": "शैनेयाब्युपपत्तिं ते जानाम्याचार्यघातिनि।\nन चैनं त्रास्यसि मया ग्रस्तमात्मानमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2059241, "chapter_id": 2274, "verse_number": "७-२०१-६६", "content_sanskrit": "शपेत्मनाऽहं शैनेय सत्येन तपसा तथा।\nअहत्वा सर्वपाञ्चालान्यदि शान्तिमहं लभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2059242, "chapter_id": 2274, "verse_number": "७-२०१-६७", "content_sanskrit": "यद्बलं पाण्डवेयानां वृष्णीनामपि यद्बलम्।\nक्रियतां सर्वमेवेह निहनिष्यामि सोमकान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2059243, "chapter_id": 2274, "verse_number": "७-२०१-६८", "content_sanskrit": "एवमुक्त्वाऽर्करम्याभं सुतीक्ष्णं तं शरोत्तमम्।\nव्यसृजत्सात्वते द्रौणिर्वज्रं वृत्रे यथा हरिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2059244, "chapter_id": 2274, "verse_number": "७-२०१-६९", "content_sanskrit": "स तं निर्भिद्य तेनास्तः सायकः शरावरम्।\nविवेश वसुधां भित्त्वा श्वसन्बिलमिवोरगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2059245, "chapter_id": 2274, "verse_number": "७-२०१-७०", "content_sanskrit": "स भिन्नकवचः शूरस्तोत्रार्दित इव द्विपः।\nविमुच्य सशरं चापं भूरिव्रणपरिस्रवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2059246, "chapter_id": 2274, "verse_number": "७-२०१-७१", "content_sanskrit": "सीदन्रुधिरसिक्तश्च रथोपस्थ उपाविशत्।\nसूतेनापहृतस्तूर्णं द्रोणपुत्राद्रथान्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2059247, "chapter_id": 2274, "verse_number": "७-२०१-७२", "content_sanskrit": "अथान्येन सुपुङ्खेन शरेणानतपर्वणा।\nआजघान भ्रवोर्मध्ये धृष्टद्युम्नं परन्तपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2059248, "chapter_id": 2274, "verse_number": "७-२०१-७३", "content_sanskrit": "स पूर्वमतिविद्धश्च भृशं पस्चाच्च पीडितः।\nससदाथ च पाञ्चाल्यो व्यपाश्रयत च ध्वजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2059249, "chapter_id": 2274, "verse_number": "७-२०१-७४", "content_sanskrit": "तं नागमिव सिंहेन दृष्ट्वा राजञ्शरार्दितम्।\nजवेनाभ्यद्रवञ्छूराः पञ्च पाण़्डवतो रथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2059250, "chapter_id": 2274, "verse_number": "७-२०१-७५", "content_sanskrit": "किरीटी भीमसेनश्च वृद्वक्षत्रश्च पौरवः।\nयुवराजश्च चेदीनां मालवश्च सुदर्शनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2059251, "chapter_id": 2274, "verse_number": "७-२०१-७६", "content_sanskrit": "एते हाहाकृताः सर्वे प्रगृहीतशरासनाः।\nवीरं द्रौणायनिं वीराः सर्वतः पर्यवारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2059252, "chapter_id": 2274, "verse_number": "७-२०१-७७", "content_sanskrit": "ते विंशतिपदे यत्ता गुरुपुत्रममर्षणम्।\nपञ्चभिः पञ्चभिर्बाणैरभ्यघ्नन्सर्वतः समम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2059253, "chapter_id": 2274, "verse_number": "७-२०१-७८", "content_sanskrit": "आशीविषाभैर्विंशत्या पञ्चभिस्तु शितैः शरैः।\nचिच्छेद युगपद्द्रौणिः पञ्चविंशतिसायकान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2059254, "chapter_id": 2274, "verse_number": "७-२०१-७९", "content_sanskrit": "सप्तभिस्तु शितैर्बाणैः पौरवं द्रौणिरार्दयत्।\nमालवं त्रिभिरेकेन पार्थं ष़ड्भिर्वृकोदरम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2059255, "chapter_id": 2274, "verse_number": "७-२०१-८०", "content_sanskrit": "ततस्ते विव्यधुः सर्वे द्रौणिं राजन्महारथाः।\nयुगपच्च पृथक्चैव रुक्मपुङ्खैः शिलाशितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2059256, "chapter_id": 2274, "verse_number": "७-२०१-८१", "content_sanskrit": "युवराजश्च विंशत्या द्रौणिं विव्याध पत्रिभिः।\nपार्थश्च पुनरष्टाभिस्तथा सर्वे त्रिभिस्त्रिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2059257, "chapter_id": 2274, "verse_number": "७-२०१-८२", "content_sanskrit": "ततोऽर्जुनं षड्भिरथाजघान\nद्रौणायनिर्दशभिर्वासुदेवम्।\nभीमं दशार्धैर्युवारजं चतुर्भि-\nर्द्वाभ्यां द्वाभ्यां मालवं पौरवं च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2059258, "chapter_id": 2274, "verse_number": "७-२०१-८३", "content_sanskrit": "सूतं विद्व्वाः भीमसेनस्य षड्भि--\nर्द्वाभ्यां विद्व्वा कार्मुकं च ध्वजं च।\nपुनः पार्थं शरवर्षेण विद्व्वा\nद्रौणिर्घोरं सिंहनादं ननाद॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2059259, "chapter_id": 2274, "verse_number": "७-२०१-८४", "content_sanskrit": "तस्यास्यतस्तान्निशितान्पीतधारा--\nन्द्रौणेः शरान्पृष्ठतश्चाग्रतश्च।\nधरा वियद्द्यौः प्रदिशो दिशश्च\nच्छन्ना बाणैरभवन्धोररूपैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2059260, "chapter_id": 2274, "verse_number": "७-२०१-८५", "content_sanskrit": "आसन्नस्य स्वरथं तीव्रतेजाः\nसुदर्शनस्येन्द्रकेतुप्रकाशौ।\nभुजौ शिरश्चेन्द्रसमानवीर्य--\nस्त्रिभिः शरैर्युगपत्सञ्चकर्त॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2059261, "chapter_id": 2274, "verse_number": "७-२०१-८६", "content_sanskrit": "स पौरवं रथशक्त्या निहत्य\nच्छित्त्वा रथं तिलशश्चास्य बाणैः।\nछित्त्वा च बाहू वरचन्दनाक्तौ\nभल्लेन कायाच्छिर उच्चकर्त॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2059262, "chapter_id": 2274, "verse_number": "७-२०१-८७", "content_sanskrit": "युवानमिन्दीवरदामवर्णं\nचेदिप्रभुं युवराजं प्रसह्य।\nबाणैस्त्वरावाञ्ज्वलिताग्निकल्पै--\nर्विद्व्वा प्रादान्मृत्येव साश्वसूतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2059263, "chapter_id": 2274, "verse_number": "७-२०१-८८", "content_sanskrit": "[*मालवं पौरवं चैव युवराजं च चेदिपम्।\nदृष्ट्वा समक्षं निहतं द्रोणपुत्रोण पाण्डवः।\nभीमसेनो महाबाहुः क्रोधमाहारयत्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2059264, "chapter_id": 2274, "verse_number": "७-२०१-८९", "content_sanskrit": "ततः शरशतैस्तीक्ष्णैः सङ्क्रुद्धाशीविषोपमैः।\nछादयामास समरे द्रोणपुत्रं परन्तपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2059265, "chapter_id": 2274, "verse_number": "७-२०१-९०", "content_sanskrit": "ततो द्रौणिर्महातेजाः शरवर्षं निहत्य तम्।\nविव्याध निशितैर्बाणैर्भीमसेनममर्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2059266, "chapter_id": 2274, "verse_number": "७-२०१-९१", "content_sanskrit": "ततो भीमो महाबाहुद्रौणेर्युधि महाबलः।\nक्षुरप्रेण धनुश्छित्त्वा द्रौणिं विव्याध पत्रिणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2059267, "chapter_id": 2274, "verse_number": "७-२०१-९२", "content_sanskrit": "तदपास्य धनुश्छिन्नं द्रोणपुत्रो महामनाः।\nअन्यत्कार्मुकमादाय भीमं विव्याध पत्रिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2059268, "chapter_id": 2274, "verse_number": "७-२०१-९३", "content_sanskrit": "तौ द्रौणिभीमौ समरे पराक्रान्तौ महाबलौ।\nअवर्षतां शरवर्षं वृष्टिमन्ताविवाम्बुदौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2059269, "chapter_id": 2274, "verse_number": "७-२०१-९४", "content_sanskrit": "भीमनामाङ्किता बाणाः स्वर्णपुङ्खाः शिलाशिताः।\nद्रौणिं सञ्छादयामासुर्घनौघा इव भास्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2059270, "chapter_id": 2274, "verse_number": "७-२०१-९५", "content_sanskrit": "तथैव द्रौणिनिर्मुक्तैर्भीमः सन्नतपर्वभिः।\nअवाकीर्यत स क्षिप्रं शरैः शतसहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2059271, "chapter_id": 2274, "verse_number": "७-२०१-९६", "content_sanskrit": "स च्छाद्यमानः समरे द्रौणिना रणशालिना।\nन विव्यथे महाराज तदद्भुतमिवाभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2059272, "chapter_id": 2274, "verse_number": "७-२०१-९७", "content_sanskrit": "ततो भीमो महाबाहुः कार्तस्वरविभूषितान्।\nनाराचान्दश सम्प्रैषीद्यमदण्डनिभाञ्छितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2059273, "chapter_id": 2274, "verse_number": "७-२०१-९८", "content_sanskrit": "ते जत्रुदेशमासाद्य द्रोणपुत्रस्य मारिष।\nनिर्भिद्य विविशुस्तूर्णं वल्मीकमिव पन्नगाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2059274, "chapter_id": 2274, "verse_number": "७-२०१-९९", "content_sanskrit": "सोऽतिविद्धो भृशं द्रौणिः पाण्डवेन महात्मना।\nध्वजयष्टिं समासाद्य न्यमीलयत लोचने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2059275, "chapter_id": 2274, "verse_number": "७-२०१-१००", "content_sanskrit": "स मुहूर्तात्पुनः संज्ञां लब्ध्वा द्रौणिर्नराधिप।\nक्रोधं परममातस्थौ समरे रुधिरोक्षितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2059276, "chapter_id": 2274, "verse_number": "७-२०१-१०१", "content_sanskrit": "दृढं सोऽभिहतस्तेन पाण्डवेन महात्मना।\nवेगं चक्रे महाबाहुर्भीमसेनरथं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2059277, "chapter_id": 2274, "verse_number": "७-२०१-१०२", "content_sanskrit": "तत आकर्णपूर्णानां शराणां तिग्मतेजसाम्।\nशतमाशीविषाभानां प्रेषयामास भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2059278, "chapter_id": 2274, "verse_number": "७-२०१-१०३", "content_sanskrit": "भीमोऽपि समरश्लाघी तस्य वीर्यमचिन्तयत्।\nतूर्णं प्रासृजदुग्राणि शरवर्षाणि पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2059279, "chapter_id": 2274, "verse_number": "७-२०१-१०४", "content_sanskrit": "ततो द्रौणिर्महाराज च्छित्त्वाऽस्य विशिखैर्धनुः।\nआजघानोरसि क्रुद्धः पाण्डवं निशितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2059280, "chapter_id": 2274, "verse_number": "७-२०१-१०५", "content_sanskrit": "ततोऽन्यद्धनुरादाय भीमसेनो ह्यमर्षणः।\nविव्याध निशितैर्बाणैर्द्रौणिं पञ्चभिराहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2059281, "chapter_id": 2274, "verse_number": "७-२०१-१०६", "content_sanskrit": "जीमूताविव घर्मान्ते तौ शरौघप्रवर्षिणौ।\nअन्योन्यक्रोधताम्राक्षौ छादयामासतुर्युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2059282, "chapter_id": 2274, "verse_number": "७-२०१-१०७", "content_sanskrit": "तलशब्दैस्ततो घोरैस्त्रासयन्तौ परस्परम्।\nअयुध्येतां सुसंरब्धौ कृतप्रतिकृतैषिणौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2059283, "chapter_id": 2274, "verse_number": "७-२०१-१०८", "content_sanskrit": "ततो विष्फार्य सुमहच्चापं रुक्मविभूषितम्।\nभीमं प्रैक्षत स द्रौणिः शरानस्यन्तमन्तिकात्।\nशरद्यहर्मध्यगतो द्रीप्तार्चिरिव भास्करः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2059284, "chapter_id": 2274, "verse_number": "७-२०१-१०९", "content_sanskrit": "आददनास्य विशिखान्सन्दधानस्य चाशुगान्।\nविकर्षतो मुञ्चतश्च नान्तरं ददृशुर्जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2059285, "chapter_id": 2274, "verse_number": "७-२०१-११०", "content_sanskrit": "अलातचक्रप्रतिमं तस्य मण्डलमायुधम्।\nद्रौणेरासीन्महाराज बाणान्विसृजतस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2059286, "chapter_id": 2274, "verse_number": "७-२०१-१११", "content_sanskrit": "धनुश्च्युताः शरास्तस्य शतशोऽथ सहस्रशः।\nआकाशे प्रत्यदृश्यन्त शलभानामिवायतीः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2059287, "chapter_id": 2274, "verse_number": "७-२०१-११२", "content_sanskrit": "ते तु द्रौणिविनिर्मुक्ताः शरा हेमविभूषिताः।\nअजस्रमन्वकीर्यन्त घोरा भीमरथं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2059288, "chapter_id": 2274, "verse_number": "७-२०१-११३", "content_sanskrit": "तत्राद्भुतकमपश्याम भीमसेनस्य विक्रमम्।\nबलं वीर्यं प्रभावं च व्यवसायं च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2059289, "chapter_id": 2274, "verse_number": "७-२०१-११४", "content_sanskrit": "तां स मेघादिवोद्भूतां बाणवृष्टिं समन्ततः।\nजलवृष्टिं महाघोरां तपान्त इव चिन्तयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2059290, "chapter_id": 2274, "verse_number": "७-२०१-११५", "content_sanskrit": "द्रोणपुत्रवधप्रेप्सुर्भीमो भीमपराक्रमः।\nअमुञ्चच्छरवर्षाणि प्रावृषीव बलाहकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2059291, "chapter_id": 2274, "verse_number": "७-२०१-११६", "content_sanskrit": "तद्रुक्मपृष्टं भीमस्य धनुर्घारं महारणे।\nविकृष्यमाणं विबभौ शक्रचापमिवापरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2059292, "chapter_id": 2274, "verse_number": "७-२०१-११७", "content_sanskrit": "तस्माच्छराः प्रादुरासञ्छतशोऽथ सहस्रशः।\nसञ्छादयन्तः समरे द्रौणिमाहवशोभिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2059293, "chapter_id": 2274, "verse_number": "७-२०१-११८", "content_sanskrit": "तयोर्विसृजतोरेवं शरजालानि मारिष।\nवायुरप्यन्तरा राजन्नाशक्नोत्प्रतिसर्पितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2059294, "chapter_id": 2274, "verse_number": "७-२०१-११९", "content_sanskrit": "तथा द्रौणिर्महाराज शरान्हेमविभूषितान्।\nतैलधौतान्प्रसन्नाग्रान्प्राहिणोद्वधकाङ्क्षया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2059295, "chapter_id": 2274, "verse_number": "७-२०१-१२०", "content_sanskrit": "तानन्तरिक्षे विशिखैस्त्रिधैकैकमशातयत्\nविशेषयन्द्रोणसुतं तिष्ठतिष्ठेति चाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2059296, "chapter_id": 2274, "verse_number": "७-२०१-१२१", "content_sanskrit": "पुनश्च शरवर्षाणि घोराण्युग्राणि पाण्डवः।\nव्यसृजद्बलवानक्रुद्धो द्रोणपुत्रवधेप्सया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 2059297, "chapter_id": 2274, "verse_number": "७-२०१-१२२", "content_sanskrit": "ततोऽस्त्रमायया तूर्णं शरवृष्टिं निवार्य ताम्।\nधनुश्चिच्छेद भीमस्य द्रोणपुत्रो महास्त्रवित्।\nशरैश्चैनं सुबहुभिः क्रुद्धः सङ्ख्ये पराभिनत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 2059298, "chapter_id": 2274, "verse_number": "७-२०१-१२३", "content_sanskrit": "स छिन्नधन्वा बलवान्रथशक्तिं सुदारुणाम्॥\nवेगेनाविध्य चिक्षेप द्रोणपुत्ररथं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 2059299, "chapter_id": 2274, "verse_number": "७-२०१-१२४", "content_sanskrit": "तामापतन्तीं सहसा महोल्काभां शितैः शरैः।\nचिच्छेद समरे द्रौणिर्दर्शयन्पाणिलाघवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 2059300, "chapter_id": 2274, "verse_number": "७-२०१-१२५", "content_sanskrit": "एतस्मिन्नन्तरे भीमो दृढमादाय कार्मुकम्।\nद्रौणिं विव्याध विशिखैः स्मयमानो वृकोदरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 2059301, "chapter_id": 2274, "verse_number": "७-२०१-१२६", "content_sanskrit": "ततो द्रौणिर्महाराज भीमसेनस्य सारथिम्।\nललाटे दारयामास शरेणानतपर्वणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 2059302, "chapter_id": 2274, "verse_number": "७-२०१-१२७", "content_sanskrit": "सोऽतिविद्धो बलवता द्रोणपुत्रेण सारथिः।\nव्यामोहमगमद्राजन्रश्मीनुत्सृज्य वाजिनां॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 2059303, "chapter_id": 2274, "verse_number": "७-२०१-१२८", "content_sanskrit": "ततोऽश्वाः प्राद्रवंस्तूर्णं मोहिते रथसारथौ।\nभीमसेनस्य राजेनद्र् पश्यतां सर्वधन्विनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 2059304, "chapter_id": 2274, "verse_number": "७-२०१-१२९", "content_sanskrit": "तं दृष्ट्वा प्रद्रुतैरश्वैरपकृष्टं रणाजिरात्।\nदध्मौ प्रमुदितः शङ्खं बृहन्तमपराजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 2059305, "chapter_id": 2274, "verse_number": "७-२०१-१३०", "content_sanskrit": "ततः सर्वे च पाञ्चाला भीमसेनश्च पाण़्डवः।\nधृष्टद्युम्नरथं त्यक्त्वा भीताः सम्प्राद्रवन्दिशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 2059306, "chapter_id": 2274, "verse_number": "७-२०१-१३१", "content_sanskrit": "तान्प्रभग्नांस्ततो द्रौणिः पृष्ठतो विकिरञ्शरान्।\nअभ्यवर्तत वेगेन कालयन्पाण्डुवाहिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 2059307, "chapter_id": 2274, "verse_number": "७-२०१-१३२", "content_sanskrit": "ते वध्यमानाः समरे द्रोणपुत्रेण पार्थिवाः।\nद्रोणपुत्रभयाद्राजन्दिशः सर्वाश्च भेजिरे॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 2059308, "chapter_id": 2274, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वण नारायणास्त्रमोक्षपर्वणि पञ्चदशदिवसयुद्धे एकाधिकद्विशततमोऽध्यायः॥ २०१ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-२०१-* एतदादि १४ श्लोकाः झ. पुस्त एव दृश्यन्ते। ५-२०१-* एतदादि ४२ श्लोकाः झ. पाठ एव सन्ति।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}]