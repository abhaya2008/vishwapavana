[{"id": 5000111000, "chapter_id": 9111, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अयोध्याकाण्डे चतुस्त्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000111001, "chapter_id": 9111, "verse_number": "२-३४-१", "content_sanskrit": "ततः कमलपत्राक्षः श्यामो निरुपमो महान्।\nउवाच रामस्तं सूतं पितुराख्याहि मामिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000111002, "chapter_id": 9111, "verse_number": "२-३४-२", "content_sanskrit": "स रामप्रेषितः क्षिप्रं संतापकलुषेन्द्रियम्।\nप्रविश्य नृपतिं सूतो निःश्वसन्तं ददर्श ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000111003, "chapter_id": 9111, "verse_number": "२-३४-३", "content_sanskrit": "उपरक्तमिवादित्यं भस्मच्छन्नमिवानलम्।\nतटाकमिव निस्तोयमपश्यज्जगतीपतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000111004, "chapter_id": 9111, "verse_number": "२-३४-४", "content_sanskrit": "आबोध्य च महाप्राज्ञः परमाकुलचेतनम्।\nराममेवानुशोचन्तं सूतः प्राञ्जलिरब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000111005, "chapter_id": 9111, "verse_number": "२-३४-५", "content_sanskrit": "तं वर्धयित्वा राजानं पूर्वं सूतो जयाशिषा।\nभयविक्लवया वाचा मन्दया श्लक्ष्णयाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000111006, "chapter_id": 9111, "verse_number": "२-३४-६", "content_sanskrit": "अयं स पुरुषव्याघ्रो द्वारि तिष्ठति ते सुतः।\nब्राह्मणेभ्यो धनं दत्त्वा सर्वं चैवोपजीविनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000111007, "chapter_id": 9111, "verse_number": "२-३४-७", "content_sanskrit": "स त्वां पश्यतु भद्रं ते रामः सत्यपराक्रमः।\nसर्वान् सुहृद आपृच्छ्य त्वां हीदानीं दिदृक्षते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000111008, "chapter_id": 9111, "verse_number": "२-३४-८", "content_sanskrit": "गमिष्यति महारण्यं तं पश्य जगतीपते।\nवृतं राजगुणैः सर्वैरादित्यमिव रश्मिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000111009, "chapter_id": 9111, "verse_number": "२-३४-९", "content_sanskrit": "स सत्यवाक्यो धर्मात्मा गाम्भीर्यात् सागरोपमः।\nआकाश इव निष्पङ्को नरेन्द्रः प्रत्युवाच तम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000111010, "chapter_id": 9111, "verse_number": "२-३४-१०", "content_sanskrit": "सुमन्त्रानय मे दारान् ये केचिदिह मामकाः।\nदारैः परिवृतः सर्वैर्द्रष्टुमिच्छामि राघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000111011, "chapter_id": 9111, "verse_number": "२-३४-११", "content_sanskrit": "सोऽन्तःपुरमतीत्यैव स्त्रियस्ता वाक्यमब्रवीत्।\nआर्यो ह्वयति वो राजा गम्यतां तत्र मा चिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000111012, "chapter_id": 9111, "verse_number": "२-३४-१२", "content_sanskrit": "एवमुक्ताः स्त्रियः सर्वाः सुमन्त्रेण नृपाज्ञया।\nप्रचक्रमुस्तद् भवनं भर्तुराज्ञाय शासनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000111013, "chapter_id": 9111, "verse_number": "२-३४-१३", "content_sanskrit": "अर्धसप्तशतास्तत्र प्रमदास्ताम्रलोचनाः।\nकौसल्यां परिवार्याथ शनैर्जग्मुर्धृतव्रताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000111014, "chapter_id": 9111, "verse_number": "२-३४-१४", "content_sanskrit": "आगतेषु च दारेषु समवेक्ष्य महीपतिः।\nउवाच राजा तं सूतं सुमन्त्रानय मे सुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000111015, "chapter_id": 9111, "verse_number": "२-३४-१५", "content_sanskrit": "स सूतो राममादाय लक्ष्मणं मैथिलीं तथा।\nजगामाभिमुखस्तूर्णं सकाशं जगतीपतेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000111016, "chapter_id": 9111, "verse_number": "२-३४-१६", "content_sanskrit": "स राजा पुत्रमायान्तं दृष्ट्वा चारात् कृताञ्जलिम्।\nउत्पपातासनात् तूर्णमार्तः स्त्रीजनसंवृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000111017, "chapter_id": 9111, "verse_number": "२-३४-१७", "content_sanskrit": "सोऽभिदुद्राव वेगेन रामं दृष्ट्वा विशाम्पतिः।\nतमसम्प्राप्य दुःखार्तः पपात भुवि मूर्च्छितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000111018, "chapter_id": 9111, "verse_number": "२-३४-१८", "content_sanskrit": "तं रामोऽभ्यपतत् क्षिप्रं लक्ष्मणश्च महारथः।\nविसंज्ञमिव दुःखेन सशोकं नृपतिं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000111019, "chapter_id": 9111, "verse_number": "२-३४-१९", "content_sanskrit": "स्त्रीसहस्रनिनादश्च संजज्ञे राजवेश्मनि।\nहा हा रामेति सहसा भूषणध्वनिमिश्रितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000111020, "chapter_id": 9111, "verse_number": "२-३४-२०", "content_sanskrit": "तं परिष्वज्य बाहुभ्यां तावुभौ रामलक्ष्मणौ।\nपर्यङ्के सीतया सार्धं रुदन्तः समवेशयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000111021, "chapter_id": 9111, "verse_number": "२-३४-२१", "content_sanskrit": "अथ रामो मुहूर्तस्य लब्धसंज्ञं महीपतिम्।\nउवाच प्राञ्जलिर्बाष्पशोकार्णवपरिप्लुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000111022, "chapter_id": 9111, "verse_number": "२-३४-२२", "content_sanskrit": "आपृच्छे त्वां महाराज सर्वेषामीश्वरोऽसि नः।\nप्रस्थितं दण्डकारण्यं पश्य त्वं कुशलेन माम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000111023, "chapter_id": 9111, "verse_number": "२-३४-२३", "content_sanskrit": "लक्ष्मणं चानुजानीहि सीता चान्वेतु मां वनम्।\nकारणैर्बहुभिस्तथ्यैर्वार्यमाणौ न चेच्छतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000111024, "chapter_id": 9111, "verse_number": "२-३४-२४", "content_sanskrit": "अनुजानीहि सर्वान् नः शोकमुत्सृज्य मानद।\nलक्ष्मणं मां च सीतां च प्रजापतिरिवात्मजान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000111025, "chapter_id": 9111, "verse_number": "२-३४-२५", "content_sanskrit": "प्रतीक्षमाणमव्यग्रमनुज्ञां जगतीपतेः।\nउवाच राजा सम्प्रेक्ष्य वनवासाय राघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000111026, "chapter_id": 9111, "verse_number": "२-३४-२६", "content_sanskrit": "अहं राघव कैकेय्या वरदानेन मोहितः।\nअयोध्यायां त्वमेवाद्य भव राजा निगृह्य माम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000111027, "chapter_id": 9111, "verse_number": "२-३४-२७", "content_sanskrit": "एवमुक्तो नृपतिना रामो धर्मभृतां वरः।\nप्रत्युवाचाञ्जलिं कृत्वा पितरं वाक्यकोविदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000111028, "chapter_id": 9111, "verse_number": "२-३४-२८", "content_sanskrit": "भवान् वर्षसहस्राय पृथिव्या नृपते पतिः।\nअहं त्वरण्ये वत्स्यामि न मे राज्यस्य कांक्षिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000111029, "chapter_id": 9111, "verse_number": "२-३४-२९", "content_sanskrit": "नव पञ्च च वर्षाणि वनवासे विहृत्य ते।\nपुनः पादौ ग्रहीष्यामि प्रतिज्ञान्ते नराधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000111030, "chapter_id": 9111, "verse_number": "२-३४-३०", "content_sanskrit": "रुदन्नार्तः प्रियं पुत्रं सत्यपाशेन संयुतः।\nकैकेय्या चोद्यमानस्तु मिथो राजा तमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000111031, "chapter_id": 9111, "verse_number": "२-३४-३१", "content_sanskrit": "श्रेयसे वृद्धये तात पुनरागमनाय च।\nगच्छस्वारिष्टमव्यग्रः पन्थानमकुतोभयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000111032, "chapter_id": 9111, "verse_number": "२-३४-३२", "content_sanskrit": "न हि सत्यात्मनस्तात धर्माभिमनसस्तव।\nसंनिवर्तयितुं बुद्धिः शक्यते रघुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000111033, "chapter_id": 9111, "verse_number": "२-३४-३३", "content_sanskrit": "अद्य त्विदानीं रजनीं पुत्र मा गच्छ सर्वथा।\nएकाहं दर्शनेनापि साधु तावच्चराम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000111034, "chapter_id": 9111, "verse_number": "२-३४-३४", "content_sanskrit": "मातरं मां च सम्पश्यन् वसेमामद्य शर्वरीम्।\nतर्पितः सर्वकामैस्त्वं श्वः काल्ये साधयिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000111035, "chapter_id": 9111, "verse_number": "२-३४-३५", "content_sanskrit": "दुष्करं क्रियते पुत्र सर्वथा राघव प्रिय।\nत्वया हि मत्प्रियार्थं तु वनमेवमुपाश्रितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000111036, "chapter_id": 9111, "verse_number": "२-३४-३६", "content_sanskrit": "न चैतन्मे प्रियं पुत्र शपे सत्येन राघव।\nछन्नया चलितस्त्वस्मि स्त्रिया भस्माग्निकल्पया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000111037, "chapter_id": 9111, "verse_number": "२-३४-३७", "content_sanskrit": "वञ्चना या तु लब्धा मे तां त्वं निस्तर्तुमिच्छसि।\nअनया वृत्तसादिन्या कैकेय्याभिप्रचोदितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000111038, "chapter_id": 9111, "verse_number": "२-३४-३८", "content_sanskrit": "न चैतदाश्चर्यतमं यत् त्वं ज्येष्ठः सुतो मम।\nअपानृतकथं पुत्र पितरं कर्तुमिच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000111039, "chapter_id": 9111, "verse_number": "२-३४-३९", "content_sanskrit": "अथ रामस्तदा श्रुत्वा पितुरार्तस्य भाषितम्।\nलक्ष्मणेन सह भ्रात्रा दीनो वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000111040, "chapter_id": 9111, "verse_number": "२-३४-४०", "content_sanskrit": "प्राप्स्यामि यानद्य गुणान् को मे श्वस्तान् प्रदास्यति।\nअपक्रमणमेवातः सर्वकामैरहं वृणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000111041, "chapter_id": 9111, "verse_number": "२-३४-४१", "content_sanskrit": "इयं सराष्ट्रा सजना धनधान्यसमाकुला।\nमया विसृष्टा वसुधा भरताय प्रदीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000111042, "chapter_id": 9111, "verse_number": "२-३४-४२", "content_sanskrit": "वनवासकृता बुद्धिर्न च मेऽद्य चलिष्यति।\nयस्तु युद्धे वरो दत्तः कैकेय्यै वरद त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000111043, "chapter_id": 9111, "verse_number": "२-३४-४३", "content_sanskrit": "दीयतां निखिलेनैव सत्यस्त्वं भव पार्थिव।\nअहं निदेशं भवतो यथोक्तमनुपालयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000111044, "chapter_id": 9111, "verse_number": "२-३४-४४", "content_sanskrit": "चतुर्दश समा वत्स्ये वने वनचरैः सह।\nमा विमर्शो वसुमती भरताय प्रदीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000111045, "chapter_id": 9111, "verse_number": "२-३४-४५", "content_sanskrit": "नहि मे कांक्षितं राज्यं सुखमात्मनि वा प्रियम्।\nयथानिदेशं कर्तुं वै तवैव रघुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000111046, "chapter_id": 9111, "verse_number": "२-३४-४६", "content_sanskrit": "अपगच्छतु ते दुःखं मा भूर्बाष्पपरिप्लुतः।\nनहि क्षुभ्यति दुर्धर्षः समुद्रः सरितां पतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000111047, "chapter_id": 9111, "verse_number": "२-३४-४७", "content_sanskrit": "नैवाहं राज्यमिच्छामि न सुखं न च मेदिनीम्।\nनैव सर्वानिमान् कामान् न स्वर्गं न च जीवितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000111048, "chapter_id": 9111, "verse_number": "२-३४-४८", "content_sanskrit": "त्वामहं सत्यमिच्छामि नानृतं पुरुषर्षभ।\nप्रत्यक्षं तव सत्येन सुकृतेन च ते शपे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000111049, "chapter_id": 9111, "verse_number": "२-३४-४९", "content_sanskrit": "न च शक्यं मया तात स्थातुं क्षणमपि प्रभो।\nस शोकं धारयस्वेमं नहि मेऽस्ति विपर्ययः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000111050, "chapter_id": 9111, "verse_number": "२-३४-५०", "content_sanskrit": "अर्थितो ह्यस्मि कैकेय्या वनं गच्छेति राघव।\nमया चोक्तं व्रजामीति तत्सत्यमनुपालये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000111051, "chapter_id": 9111, "verse_number": "२-३४-५१", "content_sanskrit": "मा चोत्कण्ठां कृथा देव वने रंस्यामहे वयम्।\nप्रशान्तहरिणाकीर्णे नानाशकुनिनादिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000111052, "chapter_id": 9111, "verse_number": "२-३४-५२", "content_sanskrit": "पिता हि दैवतं तात देवतानामपि स्मृतम्।\nतस्माद् दैवतमित्येव करिष्यामि पितुर्वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000111053, "chapter_id": 9111, "verse_number": "२-३४-५३", "content_sanskrit": "चतुर्दशसु वर्षेषु गतेषु नृपसत्तम।\nपुनर्द्रक्ष्यसि मां प्राप्तं संतापोऽयं विमुच्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000111054, "chapter_id": 9111, "verse_number": "२-३४-५४", "content_sanskrit": "येन संस्तम्भनीयोऽयं सर्वो बाष्पकलो जनः।\nस त्वं पुरुषशार्दूल किमर्थं विक्रियां गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000111055, "chapter_id": 9111, "verse_number": "२-३४-५५", "content_sanskrit": "पुरं च राष्ट्रं च मही च केवला\nमया विसृष्टा भरताय दीयताम्।\nअहं निदेशं भवतोऽनुपालयन्\nवनं गमिष्यामि चिराय सेवितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 5000111056, "chapter_id": 9111, "verse_number": "२-३४-५६", "content_sanskrit": "मया विसृष्टां भरतो महीमिमां\nसशैलखण्डां सपुरोपकाननाम्।\nशिवासु सीमास्वनुशास्तु केवलं\nत्वया यदुक्तं नृपते तथास्तु तत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 5000111057, "chapter_id": 9111, "verse_number": "२-३४-५७", "content_sanskrit": "न मे तथा पार्थिव धीयते मनो\nमहत्सु कामेषु न चात्मनः प्रिये।\nयथा निदेशे तव शिष्टसम्मते\nव्यपैतु दुःखं तव मत्कृतेऽनघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 5000111058, "chapter_id": 9111, "verse_number": "२-३४-५८", "content_sanskrit": "तदद्य नैवानघ राज्यमव्ययं\nन सर्वकामान् वसुधां न मैथिलीम्।\nन चिन्तितं त्वामनृतेन योजयन्\nवृणीय सत्यं व्रतमस्तु ते तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 5000111059, "chapter_id": 9111, "verse_number": "२-३४-५९", "content_sanskrit": "फलानि मूलानि च भक्षयन् वने\nगिरींश्च पश्यन् सरितः सरांसि च।\nवनं प्रविश्यैव विचित्रपादपं\nसुखी भविष्यामि तवास्तु निर्वृतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 5000111060, "chapter_id": 9111, "verse_number": "२-३४-६०", "content_sanskrit": "एवं स राजा व्यसनाभिपन्न-\nस्तापेन दुःखेन च पीड्यमानः।\nआलिङ्ग्य पुत्रं सुविनष्टसंज्ञो\nभूमिं गतो नैव चिचेष्ट किंचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 5000111061, "chapter_id": 9111, "verse_number": "२-३४-६१", "content_sanskrit": "देव्यः समस्ता रुरुदुः समेता-\nस्तां वर्जयित्वा नरदेवपत्नीम्।\nरुदन् सुमन्त्रोऽपि जगाम मूर्च्छां\nहाहाकृतं तत्र बभूव सर्वम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 5000111062, "chapter_id": 9111, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अयोध्याकाण्डे चतुस्त्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}]