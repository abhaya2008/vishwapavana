[{"id": 7000836000, "chapter_id": 20836, "verse_number": "६-१७९-१", "content_sanskrit": "श्रीभगवानुवाच ।\nपंचमस्याधुना देवि माहात्म्यं लोकपूजितम् ।\nकथयामि समासेन सावधाना शृणु प्रिये॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000836001, "chapter_id": 20836, "verse_number": "६-१७९-२", "content_sanskrit": "पिंगलो नाम भद्रेषु पुरुकुत्सपुरे द्विजः ।\nअवदाते कुले जातो विश्रुते वेदवादिनाम्॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000836002, "chapter_id": 20836, "verse_number": "६-१७९-३", "content_sanskrit": "कुलोचितानि शास्त्राणि तथा वेदान्विसृज्य सः ।\nतौर्यत्रिके मतिं चक्रे वादयन्मुरजादिकम्॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000836003, "chapter_id": 20836, "verse_number": "६-१७९-४", "content_sanskrit": "कृतश्रमस्ततस्तत्र गीते नृत्ये च वादने ।\nपरां प्रसिद्धिमासाद्य नृपसद्म विवेश सः॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000836004, "chapter_id": 20836, "verse_number": "६-१७९-५", "content_sanskrit": "समातस्थे स तेनासौ पुरा भूमिभुजा सह ।\nपरदारानुपाहृत्य बुभुजे ता अनन्यधीः॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000836005, "chapter_id": 20836, "verse_number": "६-१७९-६", "content_sanskrit": "तत उत्सिक्तगर्वोऽयं सूचमानो निरंकुशः ।\nपरच्छिद्राणि चामुष्मै विविक्ते स निरंतरम्॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000836006, "chapter_id": 20836, "verse_number": "६-१७९-७", "content_sanskrit": "तस्यासीदरुणा नाम भार्या हीनकुलोद्भवा॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000836007, "chapter_id": 20836, "verse_number": "६-१७९-८", "content_sanskrit": "भ्रमत्यन्वेषयंती सा कामुकेन विहारिणी ।\nतमंतरायं मन्वाना निशीथिन्यां निजालये॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000836008, "chapter_id": 20836, "verse_number": "६-१७९-९", "content_sanskrit": "निजघान शिरश्छित्त्वा निचखान महीतले ।\nवियोजितस्तः प्राणैरुपेत्य यमसादनम्॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000836009, "chapter_id": 20836, "verse_number": "६-१७९-१०", "content_sanskrit": "दुर्जयान्नरकान्भुंक्त्वा गृध्रोऽभूद्विजने वने ।\nभगंदरेण रोगेण सापि हित्वा वरां तनुम्॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000836010, "chapter_id": 20836, "verse_number": "६-१७९-११", "content_sanskrit": "उपेत्य नरकान्घोरान्जज्ञे तत्र वने शुकी ।\nकणानादातुकामां तां संचरंतीमितस्ततः॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000836011, "chapter_id": 20836, "verse_number": "६-१७९-१२", "content_sanskrit": "विददार नखैस्तीक्ष्णैर्गृध्रो वैरमनुस्मरन् ।\nनृकपाले पयः पूर्णे निपतंतीं ततः शुकीम्॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000836012, "chapter_id": 20836, "verse_number": "६-१७९-१३", "content_sanskrit": "अभिदुद्राव गृध्रोऽपि निजघ्ने स च जालिकैः ।\nपत्नीवियोजिता प्राणैर्नृकपालजले ततः॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000836013, "chapter_id": 20836, "verse_number": "६-१७९-१४", "content_sanskrit": "तत्रैव निममज्जा सा वेत्यक्रूरतरः खगः ।\nपितृलोकं प्रपेदाते नीतौ तौ यमकिंकरैः ।\nप्राक्कृतं दुष्कृतं कर्म स्मरंतौ भयभागिनौ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000836014, "chapter_id": 20836, "verse_number": "६-१७९-१५", "content_sanskrit": "ततो यमः समालोक्य तयोः कर्म जुगुप्सितम् ।\nअकस्मादेवतत्स्नानान्मरणे सुकृतं महत्॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000836015, "chapter_id": 20836, "verse_number": "६-१७९-१६", "content_sanskrit": "अनुजज्ञे ततो लोकमीप्सितं गंतुमेतयोः ।\nमहापातकसंघातैरपि दुर्द्धर्षमानसौ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000836016, "chapter_id": 20836, "verse_number": "६-१७९-१७", "content_sanskrit": "ततोविस्मयमापन्नौ स्मृत्वा तौ दुष्कृतं निजम् ।\nउपेत्य प्रणतौ भूत्वा वैवस्वतमपृच्छताम्॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000836017, "chapter_id": 20836, "verse_number": "६-१७९-१८", "content_sanskrit": "संचितं दुष्कृतं पूर्वमावाभ्यामपि गर्हितम् ।\nलोकानामीप्सितानां तु को हेतुस्तद्वदस्व नौ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000836018, "chapter_id": 20836, "verse_number": "६-१७९-१९", "content_sanskrit": "एवमुक्तस्ततस्ताभ्यामाह वैवस्वतो वचः ।\nआसीद्गंगातटे नाम्ना बुद्ध्वा ब्रह्म सनातनम्॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000836019, "chapter_id": 20836, "verse_number": "६-१७९-२०", "content_sanskrit": "एकाकी निर्ममः शांतो वीतरागो विमत्सरः ।\nगीतानां पंचमाध्यायमावर्त्तयति सर्वदा॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000836020, "chapter_id": 20836, "verse_number": "६-१७९-२१", "content_sanskrit": "तेन पुण्येन पूतात्मा बुद्ध्वा ब्रह्म सनातनम् ।\nपापीयानपि यं श्रुत्वा तनुमुत्सृष्टवानसौ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000836021, "chapter_id": 20836, "verse_number": "६-१७९-२२", "content_sanskrit": "निर्मलीकृतदेहस्य गीताभिर्भावितात्मनः ।\nतत्कपालजलं प्राप्य युवां यातौ पवित्रताम्॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000836022, "chapter_id": 20836, "verse_number": "६-१७९-२३", "content_sanskrit": "तद्गच्छतं युवां लोकान्मनोरथपथिस्थितान् ।\nगीतानां पंचमाध्यायमाहात्म्येन पवित्रितौ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000836023, "chapter_id": 20836, "verse_number": "६-१७९-२४", "content_sanskrit": "एवं तौ बोधितौ तेन मुदितौ समवर्तिना ।\nव्योमयानं समारुह्य जग्मतुर्वैष्णवं पदम्॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]