[{"id": 7005950000, "chapter_id": 25950, "verse_number": "१-१३३-१", "content_sanskrit": "ब्रह्मोवाच ।\nअशोककलिका ह्यष्टौ ये पिबन्ति पुनर्वसौ ।\nचैत्रे मासि सिताष्टम्यां न ते शोकमवाप्नुयुः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005950001, "chapter_id": 25950, "verse_number": "१-१३३-२", "content_sanskrit": "त्वामशोक ! हराभीष्ट ! मधुमाससमुद्व ।\nपिबामि शोकसन्तप्तो मामशोकं सदा कुरु ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005950002, "chapter_id": 25950, "verse_number": "१-१३३-३", "content_sanskrit": "ब्रह्मोवाच । शुक्लाष्टम्यामाश्वयुजे उत्तराषाढया युता ।\nसा महानवमीत्युक्ता स्नानदानादि चाक्षयम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005950003, "chapter_id": 25950, "verse_number": "१-१३३-४", "content_sanskrit": "नवमी केवला चापि दुर्गां चैव तु पूजयेत् ।\nमहाव्रतं महापुण्यं शङ्कराद्यैरनुष्ठितम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005950004, "chapter_id": 25950, "verse_number": "१-१३३-५", "content_sanskrit": "अयाचितादि षष्ठ्यादौ राजा शत्रुजयाया च। ।\nजपहोमसमायुक्तः कन्यां वा भोजयेत्सदा ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005950005, "chapter_id": 25950, "verse_number": "१-१३३-६", "content_sanskrit": "दुर्गेदुर्गे रक्षिणि स्वाहा मन्त्रोऽयं पूजनदिषु ।\nदीर्घाकारादिमात्राभिर्नव देव्यो नमोऽन्तिकाः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005950006, "chapter_id": 25950, "verse_number": "१-१३३-७", "content_sanskrit": "षड्भिः पदैर्नमः स्वाहा वषडादिहृदादिकम् ।\nअङ्गुष्ठादिकनिष्ठान्तं न्यस्य वै पृजयेच्छिवाम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005950007, "chapter_id": 25950, "verse_number": "१-१३३-८", "content_sanskrit": "अष्टम्यां नव गेहानि दारुजान्येकमेव वा ।\nतस्मिन्देवी प्रकर्तव्या हैमी वाराजतापि वा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005950008, "chapter_id": 25950, "verse_number": "१-१३३-९", "content_sanskrit": "शूले खङ्गे पुस्तके वा पटे वा मण्डले (प) यजेत् ।\nकपालं खेटकं घण्टां दर्पणं तर्जनीं धनः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005950009, "chapter_id": 25950, "verse_number": "१-१३३-१०", "content_sanskrit": "ध्वजं डमरुकं पाशं वामहस्तेषु बिभ्रती ।\nशक्तिं च मुद्गरं शूलं वज्रं खङ्गं तथाङ्कुशम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005950010, "chapter_id": 25950, "verse_number": "१-१३३-११", "content_sanskrit": "शरं चक्रं शलाकां च दुर्गामायुधसंयुताम् ।\nशेषाः षोडशहस्तां स्युरञ्जनं डमरुं विना ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005950011, "chapter_id": 25950, "verse_number": "१-१३३-१२", "content_sanskrit": "रुद्रचण्डा प्रचण्डा च चण्डोग्रा चण्डनयका ।\nचण्डा चण्डवती चैव चण्डरूपातिचण्डिका ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005950012, "chapter_id": 25950, "verse_number": "१-१३३-१३", "content_sanskrit": "नवमी चोग्रचण्डा च मध्यमाग्निप्रभाकृतिः ।\nरोचना त्वरुणा कृष्णा नीलं धूम्रा च शुक्रका ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005950013, "chapter_id": 25950, "verse_number": "१-१३३-१४", "content_sanskrit": "पाता च पाण्डुरा प्रोक्ता आलीढं हरितं तथा ।\nम (मा) हिषोऽस्य स खड्गाग्रप्रकचग्रहमुष्टिकः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005950014, "chapter_id": 25950, "verse_number": "१-१३३-१५", "content_sanskrit": "जप्त्वा दशाक्षरीं विद्यां नासौ केनापि ।\nपञ्च (ञ्चा) दशाङ्गुलं खड्गं त्रिशूलं च त यजेत् ।\nलिङ्गस्यां पूजयेद्वापि पादुकेऽथ जलेऽपि वा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005950015, "chapter_id": 25950, "verse_number": "१-१३३-१६", "content_sanskrit": "विचित्रां रक्षयेत्पूजामष्टम्यामुपवासयेत् ।\nपञ्चाब्दं महिषं बस्तं रात्रिशेषे च घातयेत् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005950016, "chapter_id": 25950, "verse_number": "१-१३३-१७", "content_sanskrit": "विधिवत्कालिकालीति तदुत्थरुधिरादिकम् ।\nनेरृत्यां पूतनां चैव वायव्यां पापराक्षसीम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005950017, "chapter_id": 25950, "verse_number": "१-१३३-१८", "content_sanskrit": "दद्याच्चरक्यै चैशान्यामाग्नेय्यां च विदारिकाम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]