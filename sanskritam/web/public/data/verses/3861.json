[{"id": 2132360, "chapter_id": 3861, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2132361, "chapter_id": 3861, "verse_number": "१", "content_sanskrit": "ततः स पाण्डवो विप्रं मार्कण्डेयमुवाच ह ।\nकथयस्वेति चरितं मनोर्वैवस्वतस्य च \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2132362, "chapter_id": 3861, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2132363, "chapter_id": 3861, "verse_number": "२", "content_sanskrit": "विवस्वतः सुतो राजन् महर्षिः सुप्रतापवान् ।\nबभूव नरशार्दूल प्रजापतिसमद्युतिः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2132364, "chapter_id": 3861, "verse_number": "३", "content_sanskrit": "ओजसा तेजसा लक्ष्म्या तपसा च विशेषतः ।\nअतिचक्राम पितरं मनुः स्वं च पितामहम् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2132365, "chapter_id": 3861, "verse_number": "४", "content_sanskrit": "ऊर्ध्वबाहुर्विशालायां बदर्यां स नराधिप ।\nएकपादस्थितस्तीव्रं चकार सुमहत्तपः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2132366, "chapter_id": 3861, "verse_number": "५", "content_sanskrit": "अवाक्शिरास्तथा चापि नेत्रैरनिमिषैर्दृढम् ।\nसोऽतप्यत तपो घोरं वर्षाणामयुतं तदा\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2132367, "chapter_id": 3861, "verse_number": "६", "content_sanskrit": "तं कदाचित् तपस्यन्तमार्द्रचीरजटाधरम् ।\nचीरिणीतीरम् आगम्य मत्स्यो वचनमब्रवीत्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2132368, "chapter_id": 3861, "verse_number": "७", "content_sanskrit": "भगवन् क्षुद्रमत्स्योऽस्मि बलवद्भ्यो भयं मम ।\nमत्स्येभ्यो हि ततो मां त्वं त्रातुमर्हसि सुव्रत \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2132369, "chapter_id": 3861, "verse_number": "८", "content_sanskrit": "दुर्बलं बलवन्तो हि मत्स्या मत्स्यं विशेषतः ।\nआस्वदन्ति सदा वृत्तिर्विहिता नः सनातनी\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2132370, "chapter_id": 3861, "verse_number": "९", "content_sanskrit": "तस्माद् भयौघान्महतो मज्जन्तं मां विशेषतः ।\nत्रातुमर्हसि कर्तास्मि कृते प्रतिकृतं तव \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2132371, "chapter_id": 3861, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2132372, "chapter_id": 3861, "verse_number": "१०", "content_sanskrit": "स मत्स्यवचनं श्रुत्वा कृपयाऽभिपरिप्लुतः ।\nमनुर्वैवस्वतोऽगृह्णात् तं मत्स्यं पाणिना स्वयम् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2132373, "chapter_id": 3861, "verse_number": "११", "content_sanskrit": "उदकान्तमुपानीय मत्स्यं वैवस्वतो मनुः ।\nअरञ्जले प्राक्षिपत् तं चन्द्रांशुसदृशप्रभे(भम्)\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2132374, "chapter_id": 3861, "verse_number": "१२", "content_sanskrit": "स तत्र ववृधे राजन् मत्स्यः परमसत्कृतः ।\nपुत्रवत् स्वीकरोत् तस्मै मनुर्भावं विशेषतः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2132375, "chapter_id": 3861, "verse_number": "१३", "content_sanskrit": "अथ कालेन महता स मत्स्यः सुमहानभूत् ।\nअरञ्जले यथा चैव नासौ समभवत् किल ।\nअथ मत्स्यो मनुं दृष्ट्वा पुनरेवाभ्यभाषत \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2132376, "chapter_id": 3861, "verse_number": "१४", "content_sanskrit": "भगवन् साधु मेऽद्यान्यत् स्थानं सम्प्रतिपादय\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2132377, "chapter_id": 3861, "verse_number": "१५", "content_sanskrit": "उद्धृत्यारञ्जलात् तस्मात् ततः स भगवान् मनुः ।\nतं मत्स्यमनयद्वापीं महतीं स मनुस्तदा\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2132378, "chapter_id": 3861, "verse_number": "१६", "content_sanskrit": "तत्र तं प्राक्षिपच्चापि मनुः परपुरञ्जय ।\nअथावर्धत मत्स्यः स पुनर्वर्षगणान् बहून्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2132379, "chapter_id": 3861, "verse_number": "१७", "content_sanskrit": "द्वियोजनायता वापी विस्तृता चापि योजनम् ।\nतस्यां नासौ समभवन्मत्स्यो राजीवलोचन\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2132380, "chapter_id": 3861, "verse_number": "१८", "content_sanskrit": "विचेष्टितुं च कौन्तेय मत्स्यो वाप्यां विशाम्पते ।\nमनुं मत्स्यस्ततो दृष्ट्वा पुनरेवाभ्यभाषत \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2132381, "chapter_id": 3861, "verse_number": "१९", "content_sanskrit": "नय मां भगवन् साधो समुद्रमहिषीं प्रियाम् ।\nगङ्गां तत्र निवत्स्यामि यथा वा तात मन्यसे\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2132382, "chapter_id": 3861, "verse_number": "२०", "content_sanskrit": "निदेशे हि मया तुभ्यं स्थातव्यमनसूयता ।\nवृद्धिर्हि परमा प्राप्ता त्वत्कृते हि मयाऽनघ \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2132383, "chapter_id": 3861, "verse_number": "२१", "content_sanskrit": "एवमुक्तो मनुर्मत्स्यमनयद् भगवान् वशी ।\nसमुद्रमहिषीं गङ्गां स्वयं प्राक्षिपदेव च \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2132384, "chapter_id": 3861, "verse_number": "२२", "content_sanskrit": "स तत्र ववृधे मत्स्यः किञ्चित् कालमरिन्दम ।\nततः पुनर्मनुं दृष्ट्वा मत्स्यो वचनमब्रवीत्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2132385, "chapter_id": 3861, "verse_number": "२३", "content_sanskrit": "गङ्गायां हि न शक्नोमि बृहत्त्वाच्चेष्टितुं प्रभो ।\nसमुद्रं नय मामाशु प्रसीद भगवन्निति\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2132386, "chapter_id": 3861, "verse_number": "२४", "content_sanskrit": "उद्धृत्य गङ्गासलिलात् ततो मत्स्यं मनुः स्वयम् ।\nसमुद्रमनयत् पार्थ तत्र चैनमवासृजत्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2132387, "chapter_id": 3861, "verse_number": "२५", "content_sanskrit": "सुमहानपि मत्स्यस्तु स मनोर्नयतस्तदा ।\nआसीद् यथेष्टहार्यश्च स्पर्शगन्धसुखश्च वै\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2132388, "chapter_id": 3861, "verse_number": "२६", "content_sanskrit": "यदा समुद्रे प्रक्षिप्तः स मत्स्यो मनुना तदा ।\nतत एनमिदं वाक्यं स्मयमान इवाब्रवीत्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2132389, "chapter_id": 3861, "verse_number": "२७", "content_sanskrit": "भगवन् हि कृता रक्षा त्वया सर्वा विशेषतः ।\nप्राप्तकालं तु यत्कार्यं त्वया तच्छ्रूयतां मम\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2132390, "chapter_id": 3861, "verse_number": "२८", "content_sanskrit": "अचिराद् भगवन् भौममिदं स्थावरजङ्गमम् ।\nसर्वमेव महाभाग प्रलयं वै गमिष्यति\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2132391, "chapter_id": 3861, "verse_number": "२९", "content_sanskrit": "सम्प्रक्षालनकालोऽयं लोकानां समुपस्थितः ।\nतस्मात् त्वां बोधयाम्यद्य यत् ते हितमनुत्तमम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2132392, "chapter_id": 3861, "verse_number": "३०", "content_sanskrit": "चराणां स्थावराणां च यच्चेङ्गं यच्च नेङ्गति ।\nतस्य सर्वस्य सम्प्राप्तः कालः परमदारुणः \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2132393, "chapter_id": 3861, "verse_number": "३१", "content_sanskrit": "नौश्च कारयितव्या ते दृढा युक्तवटाङ्कुरा ।\nतत्र सप्तर्षिभिः सार्धमारुहेथा महामुने\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2132394, "chapter_id": 3861, "verse_number": "३२", "content_sanskrit": "बीजानि चैव सर्वाणि यथोक्तानि द्विजैः पुरा ।\nतस्यामारोहयेर्नावि सुसङ्गुप्तानि भागशः \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2132395, "chapter_id": 3861, "verse_number": "३३", "content_sanskrit": "नौस्थश्च मां प्रतीक्षेथास्ततो मुनिजनप्रिय ।\nआगमिष्याम्यहं शृङ्गी विज्ञेयस्तेन तापस\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2132396, "chapter_id": 3861, "verse_number": "३४", "content_sanskrit": "एवमेतत् त्वया कार्यम् आपृच्छास्मिन् व्रजाम्यहम् ।\nता न शक्या महत्यो वै आपस्तर्तुं मया विना ।\nनातिशङ्क्यमिदं चापि वचनं मे त्वया विभो\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2132397, "chapter_id": 3861, "verse_number": "३५", "content_sanskrit": "एवं करिष्य इति तं स मत्स्यं प्रत्यभाषत ।\nजग्मतुश्च यथाकाममनुज्ञाप्य परस्परम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2132398, "chapter_id": 3861, "verse_number": "३६", "content_sanskrit": "ततो मनुर्महाराज यथोक्तं मत्स्यकेन ह ।\nबीजान्यादाय सर्वाणि सागरं पुप्लुवे तदा ।\nनौकया शुभया वीर महोर्मिणमरिन्दम\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2132399, "chapter_id": 3861, "verse_number": "३७", "content_sanskrit": "चिन्तयामास च मनुस्तं मत्स्यं पृथिवीपते\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2132400, "chapter_id": 3861, "verse_number": "३८", "content_sanskrit": "स च तच्चिन्तितं ज्ञात्वा मत्स्यः परपुरञ्जय ।\nशृङ्गी तत्राजगामाशु तदा भरतसत्तम\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2132401, "chapter_id": 3861, "verse_number": "३९", "content_sanskrit": "तं दृष्ट्वा मनुजव्याघ्र मनुर्मत्स्यं जलार्णवे ।\nशृङ्गिणं तं यथोक्तेन रूपेणाद्रिमिवोच्छ्रितम्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2132402, "chapter_id": 3861, "verse_number": "४०", "content_sanskrit": "वटारकमयं पाशमथ मत्स्यस्य मूर्धनि ।\nमनुर्मनुजशार्दूल तस्मिन् शृङ्गे न्यवेशयत्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2132403, "chapter_id": 3861, "verse_number": "४१", "content_sanskrit": "संयतस्तेन पाशेन मत्स्यः परपुरञ्जय ।\nवेगेन महता नावं प्राकर्षल्लवणाम्भसि\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2132404, "chapter_id": 3861, "verse_number": "४२", "content_sanskrit": "स च तांस्तारयन् नावा समुद्रं मनुजेश्वर ।\nनृत्यमानमिवोर्मीभिर्गर्जमानमिवाम्भसा\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2132405, "chapter_id": 3861, "verse_number": "४३", "content_sanskrit": "क्षोभ्यमाणा महावातैः सा नौस्तस्मिन् महोदधौ ।\nघूर्णते चपलेव स्त्री मत्ता परपुरञ्जय\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2132406, "chapter_id": 3861, "verse_number": "४४", "content_sanskrit": "नैव भूमिर्न च दिशः प्रदिशो वा चकाशिरे ।\nसर्वमाम्भसमेवासीत् खं द्यौश्च नरपुङ्गव \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2132407, "chapter_id": 3861, "verse_number": "४५", "content_sanskrit": "एवम्भूते तदा लोके सङ्कुले भरतर्षभ ।\nअदृश्यन्तर्षयः सप्त मनुर्मत्स्यस्तथैव च \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2132408, "chapter_id": 3861, "verse_number": "४६", "content_sanskrit": "एवं बहून् वर्षगणांस्तां नावं सोऽथ मत्स्यकः ।\nचकर्ष तन्त्रितो राजंस्तस्मिन् सलिलसञ्चये\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2132409, "chapter_id": 3861, "verse_number": "४७", "content_sanskrit": "ततो हिमवतः शृङ्गं यत्परं भरतर्षभ ।\nतत्राकर्षत् ततो नावं स मत्स्यः कुरुनन्दन ।\nअथाब्रवीत् तदा मत्स्यस्तानृषीन् प्रहसन् शनैः \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2132410, "chapter_id": 3861, "verse_number": "४८", "content_sanskrit": "अस्मिन् हिमवतः शृङ्गे नावं बध्नीत मा चिरम्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2132411, "chapter_id": 3861, "verse_number": "४९", "content_sanskrit": "सा बद्धा तत्र तैस्तूर्णमृषिभिर्भरतर्षभ ।\nनौर्मत्स्यस्य वचः श्रुत्वा शृङ्गे हिमवतस्तदा\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2132412, "chapter_id": 3861, "verse_number": "५०", "content_sanskrit": "तच्च नौबन्धनं नाम शृङ्गं हिमवतः परम् ।\nख्यातमद्यापि कौन्तेय तद् विद्धि भरतर्षभ ।\nअथाब्रवीदनिमिषस्तानृषीन् सहितस्तदा \t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2132413, "chapter_id": 3861, "verse_number": "५१", "content_sanskrit": "अहं प्रजापतिर्ब्रह्म मत्परं नाधिगम्यते ।\nमत्स्यरूपेण यूयं च मयाऽस्मान्मोक्षिता भयात्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2132414, "chapter_id": 3861, "verse_number": "५२", "content_sanskrit": "मनुना च प्रजाः सर्वाः सदेवासुरमानुषाः ।\nस्रष्टव्याः सर्वलोकाश्च यच्चेङ्गं यच्च नेङ्गति\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2132415, "chapter_id": 3861, "verse_number": "५३", "content_sanskrit": "तपसा चापि तीव्रेण प्रतिभाऽस्य भविष्यति ।\nमत्प्रसादात् प्रजासर्गे न च मोहं गमिष्यति\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2132416, "chapter_id": 3861, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2132417, "chapter_id": 3861, "verse_number": "५४", "content_sanskrit": "इत्युक्त्वा वचनं मत्स्यः क्षणेनादर्शनं गतः \t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2132418, "chapter_id": 3861, "verse_number": "५५", "content_sanskrit": "स्रष्टुकामः प्रजाश्चापि मनुर्वैवस्वतः स्वयम् ।\nप्रमूढोऽभूत् प्रजासर्गे तपस्तेपे महत्ततः \t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2132419, "chapter_id": 3861, "verse_number": "५६", "content_sanskrit": "तपसा महता युक्तः सोऽथ स्रष्टुं प्रचक्रमे ।\nसर्वाः प्रजा मनुः साक्षाद्यथावद् भरतर्षभ\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2132420, "chapter_id": 3861, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2132421, "chapter_id": 3861, "verse_number": "५७", "content_sanskrit": "इत्येतन्मात्स्यकं नाम पुराणं परिकीर्तितम् ।\nआख्यानमिदमाख्यातं सर्वपापहरं मया\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2132422, "chapter_id": 3861, "verse_number": "५८", "content_sanskrit": "य इदं शृणुयान्नित्यं मनोश्चरितमादितः ।\nस सुखी सर्वपूर्णार्थः सर्वलोकमियान्नरः \t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2132423, "chapter_id": 3861, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि द्व्यशीत्य- धिकशततमोऽध्यायः ॥ १८२॥ मार्कण्डेये मत्स्योपाख्याने सप्तमोऽध्यायः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}]