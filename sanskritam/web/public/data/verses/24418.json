[{"id": 7004418000, "chapter_id": 24418, "verse_number": "५-३-११२-१", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nततो गच्छेत्तु राजेन्द्र तीर्थमाङ्गिरसस्य तु ।\nउत्तरे नर्मदाकूले सर्वपापविनाशनम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004418001, "chapter_id": 24418, "verse_number": "५-३-११२-२", "content_sanskrit": "पुरासीदङ्गिरानाम ब्राह्मणो वेदपारगः ।\nपुत्रहेतोर्युगस्यादौ चचार विपुलं तपः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004418002, "chapter_id": 24418, "verse_number": "५-३-११२-३", "content_sanskrit": "नित्यं त्रिषवणस्नायी जपन्देवं सनातनम् ।\nपूजयंश्च महादेवं कृच्छ्रचान्द्रायणादिभिः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004418003, "chapter_id": 24418, "verse_number": "५-३-११२-४", "content_sanskrit": "द्वादशाब्दे ततः पूर्णे तुतोष परमेश्वरः ।\nवरेण छन्दयामास द्विजमाङ्गिरसं वरम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004418004, "chapter_id": 24418, "verse_number": "५-३-११२-५", "content_sanskrit": "वव्रे स तु महादेवं पुत्रं पुत्रवतां वरम् ।\nवेदविद्याव्रतस्नातं सर्वशास्त्रविशारदम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004418005, "chapter_id": 24418, "verse_number": "५-३-११२-६", "content_sanskrit": "देवानां मन्त्रिणं राजन् सर्वलोकेषु पूजितम् ।\nब्रह्मलक्ष्म्याः सदावासमक्षयं चाव्ययं सुतम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004418006, "chapter_id": 24418, "verse_number": "५-३-११२-७", "content_sanskrit": "तथाभिलषितः पुत्रः सर्वविद्याविशारदः ।\nभविष्यति न सन्देहश्चैवमुक्त्वा ययौ हरः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004418007, "chapter_id": 24418, "verse_number": "५-३-११२-८", "content_sanskrit": "वरैरङ्गिरसश्चापि बृहस्पतिरजायत ।\nयथाभिलषितः पुत्रो वेदवेदाङ्गपारगः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004418008, "chapter_id": 24418, "verse_number": "५-३-११२-९", "content_sanskrit": "जाते पुत्रेऽङ्गिरास्तत्र स्थापयामास शङ्करम् ।\nहृष्टतुष्टमना भूत्वा जगामोत्तरपर्वतम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004418009, "chapter_id": 24418, "verse_number": "५-३-११२-१०", "content_sanskrit": "तत्र चाङ्गिरसे तीर्थे यः स्नात्वा पूजयेच्छिवम् ।\nसर्वपापविनिर्मुक्तो रुद्रलोकं स गच्छति॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004418010, "chapter_id": 24418, "verse_number": "५-३-११२-११", "content_sanskrit": "अपुत्रो लभते पुत्रमधनो धनमाप्नुयात् ।\nइच्छते यश्च यं कामं स तं लभति मानवः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}]