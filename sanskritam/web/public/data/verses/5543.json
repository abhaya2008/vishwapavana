[{"id": 2212994, "chapter_id": 5543, "verse_number": "", "content_sanskrit": "धृतराष्ट्रेण भीष्मदुर्योधनाद्युद्देश्यकश्राद्धे धनवस्त्रान्नादिना ब्राह्मणादिसन्तर्पणम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2212995, "chapter_id": 5543, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2212996, "chapter_id": 5543, "verse_number": "१", "content_sanskrit": "विदुरेणैवमुक्तस्तु धृतराष्ट्रो जनाधिपः ।\nप्रीतिमानभवद् राजा राज्ञो जिष्णोश्च कर्मणा\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2212997, "chapter_id": 5543, "verse_number": "२", "content_sanskrit": "ततोऽभिरूपान् भीष्माय ब्राह्मणानृषिसत्तमान् ।\nपुत्रार्थे सुहृदां चैव स समीक्ष्य सहस्रशः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2212998, "chapter_id": 5543, "verse_number": "३", "content_sanskrit": "कारयित्वाऽन्नपानानि यानान्याच्छादनानि च ।\nसुवर्णमणिरत्नानि दासीदासपरिच्छदान्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2212999, "chapter_id": 5543, "verse_number": "४", "content_sanskrit": "कम्बलानि च रत्नानि ग्रामान् क्षेत्राण्यजाविकान् ।\nअलङ्कारानथाश्वांश्च काम्याश्चैव वरस्त्रियः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2213000, "chapter_id": 5543, "verse_number": "५", "content_sanskrit": "आदिश्यादिश्य विप्रेभ्यो स ददौ नृपसत्तमः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2213001, "chapter_id": 5543, "verse_number": "६", "content_sanskrit": "द्रोणं सङ्कीर्त्य भीष्मं च सोमदत्तं च बाह्लिकम् ।\nदुर्योधनं च राजानं पुत्रांश्चैव पृथक् पृथक्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2213002, "chapter_id": 5543, "verse_number": "७", "content_sanskrit": "जयद्रथपुरोगाणां सुहृदां चैव सर्वशः ।\nस श्राद्धयज्ञो ववृते बहुगोपशुदक्षिणः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2213003, "chapter_id": 5543, "verse_number": "८", "content_sanskrit": "अनेकधनरत्नौघो युधिष्ठिरमते तदा\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2213004, "chapter_id": 5543, "verse_number": "९", "content_sanskrit": "अनिशं यत्र पुरुषा गणका लेखकास्तथा ।\nयुधिष्ठिरस्य वचनादापृच्छन्ति स्म तं नृपम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2213005, "chapter_id": 5543, "verse_number": "१०", "content_sanskrit": "आज्ञापय त्वमेतेभ्यः प्रदेयं दीयतामिति\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2213006, "chapter_id": 5543, "verse_number": "११", "content_sanskrit": "तदुपस्थितमेवात्र वचनान्ते प्रदृश्यते\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2213007, "chapter_id": 5543, "verse_number": "१२", "content_sanskrit": "शते देये दशशतं सहस्रे चायुतं तथा ।\nदीयते वचनाद् राज्ञः कुन्तीपुत्रस्य धीमतः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2213008, "chapter_id": 5543, "verse_number": "१३", "content_sanskrit": "एवं स वसुधाराभिवर्षमाणो नृपाम्बुदः ।\nतर्पयामास विप्रांस्तान् वर्षाद् भूमिमिवाम्बुदः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2213009, "chapter_id": 5543, "verse_number": "१४", "content_sanskrit": "ततोऽनन्तरमेवात्र सर्ववर्णान् महामतिः ।\nअन्नपानरसौघेण प्लावयामास पार्थिवः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2213010, "chapter_id": 5543, "verse_number": "१५", "content_sanskrit": "सवस्त्रौघेन रत्नौघो मृदङ्गनिनदध्वनिः ।\nगवाश्वमहिषावर्तो नानारत्नमहाकरः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2213011, "chapter_id": 5543, "verse_number": "१६", "content_sanskrit": "ग्रामाग्रहारकुल्याढ्यो मणिहेमजलार्णवः ।\nजगत् सम्प्लावयामास धृतराष्ट्रोडुपो ध्रुवम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2213012, "chapter_id": 5543, "verse_number": "१७", "content_sanskrit": "एवं स पुत्रपौत्राणां पितॄणामात्मनस्तदा ।\nगान्धार्यपि महाराज प्रददौ चोर्ध्वदेहिकम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2213013, "chapter_id": 5543, "verse_number": "१८", "content_sanskrit": "परिश्रान्तो यदासीत् स ददद्दानान्यनेकशः ।\nततो निवर्तयामास दानयज्ञं कुरूद्वहः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2213014, "chapter_id": 5543, "verse_number": "१९", "content_sanskrit": "एवं स राजा कौरव्यश्चक्रे दानमहोत्सवम् ।\nनटनर्तप्रगीताढ्यं बह्वन्नरसदक्षिणम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2213015, "chapter_id": 5543, "verse_number": "२०", "content_sanskrit": "दशाहमेव दानानि दत्त्वा राजाऽम्बिकासुतः ।\nबभूव पुत्रपौत्राणामानृणो भरतर्षभ\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2213016, "chapter_id": 5543, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्रमवासिकपर्वणि धृतराष्ट्रेण भीष्मादीनां श्राद्धदानकथनं नाम एकोनविंशोऽध्यायः ॥१९॥\nआश्रमवासपर्वणि एकोनविंशोऽध्यायः ॥१९॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]