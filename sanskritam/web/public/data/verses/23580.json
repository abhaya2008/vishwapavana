[{"id": 7003580000, "chapter_id": 23580, "verse_number": "१-१-२-१", "content_sanskrit": "लोमश उवाच ।\nएकदा तु तदा तेन यज्ञः प्रारंभितो महान् ।\nतत्राहूतास्तदा सर्वे दीक्षितेन तपस्विना ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003580001, "chapter_id": 23580, "verse_number": "१-१-२-२", "content_sanskrit": "ऋषयो विविधास्तत्र वशिष्ठाद्याः समागताः ।\nअगस्त्यः कश्यपोऽत्रिश्च वामदेवस्तथा भृगुः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003580002, "chapter_id": 23580, "verse_number": "१-१-२-३", "content_sanskrit": "दधीचो भगवान्व्यासो भरद्वाजोऽथ गौतमः ।\nएते चान्ये च बहवः समाजग्मुर्महर्षयः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003580003, "chapter_id": 23580, "verse_number": "१-१-२-४", "content_sanskrit": "तथा सर्वे सुरगणा लोकपालस्तथाऽपरे विद्याधराश्च गंधर्वाः किंनराप्सरसां गणाः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003580004, "chapter_id": 23580, "verse_number": "१-१-२-५", "content_sanskrit": "सप्तलोकात्समानीतो ब्रह्मा लोकपितामहः ।\nवैकुंठाच्च तथा विष्णुः समानीतो मरवं प्रति ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003580005, "chapter_id": 23580, "verse_number": "१-१-२-६", "content_sanskrit": "देवेन्द्रो हि समानीत इंद्राण्या सह सुप्रभः ।\nतथा चंद्रो हि रोहिण्या वरुणः प्रिययया सह ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003580006, "chapter_id": 23580, "verse_number": "१-१-२-७", "content_sanskrit": "कुबेरः पुष्पकारूढो मृगाऽरूढोऽथ मारुतः ।\nबस्ताऽरूढः पावकश्च प्रेताऽरूढोऽथ निरृति ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003580007, "chapter_id": 23580, "verse_number": "१-१-२-८", "content_sanskrit": "एते सर्वे समायाता यज्ञवाटे द्विजन्मनः ।\nते सर्वे सत्कृतास्तेन दक्षेण च दुरात्मना ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003580008, "chapter_id": 23580, "verse_number": "१-१-२-९", "content_sanskrit": "भवनानि महार्हाणि सुप्रभाणि महांति च ।\nत्वष्ट्रा कृतानि दिव्यानि कौशल्येन महात्मना ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003580009, "chapter_id": 23580, "verse_number": "१-१-२-१०", "content_sanskrit": "तेषु सर्वेषु धिष्ण्येषु यथाजोषं समास्थिताः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003580010, "chapter_id": 23580, "verse_number": "१-१-२-११", "content_sanskrit": "वर्त्तमाने महायज्ञे तीर्थे कनखले तथा ।\nऋत्विजश्च कृतास्तेन भृग्वाद्याश्च तपोधनाः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003580011, "chapter_id": 23580, "verse_number": "१-१-२-१२", "content_sanskrit": "दीक्षायुक्तस्तदा दक्षः कृतकौतुकमंगलः ।\nभार्यया सहितो विप्रैः कृतस्वत्ययनो भृशम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003580012, "chapter_id": 23580, "verse_number": "१-१-२-१३", "content_sanskrit": "रेजे महत्त्वेन तदा सुहृद्भिः परितः सदा ।\nएतस्मिन्नंतरे तत्र दधीचिर्वाक्यमब्रवीत् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003580013, "chapter_id": 23580, "verse_number": "१-१-२-१४", "content_sanskrit": "दधीचिरुवाच ।\nएते सुरेशा ऋषयो महत्तराः सलोकपालाश्च समागतास्तव ।\nतथाऽपि यज्ञस्तु न शोभते भृशंपिनाकिना तेन महात्मना विना ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003580014, "chapter_id": 23580, "verse_number": "१-१-२-१५", "content_sanskrit": "येनैव सर्वाण्यपि मंगलानि जातानि शंसंति महाविपश्चितः ।\nसोऽसौ न दृष्टोऽत्र पुमान्पुराणो वृषध्वजो नीलकण्ठः कपर्दी ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003580015, "chapter_id": 23580, "verse_number": "१-१-२-१६", "content_sanskrit": "अमंगलान्येव च मंगलानि भवंति येनाधिकृतानि दक्ष ।\nत्रियंबकेनाथ सुमंगलानि भवंति सद्योह्यपमंगलानि ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003580016, "chapter_id": 23580, "verse_number": "१-१-२-१७", "content_sanskrit": "तस्मात्त्वयैव कर्तव्यमाह्वानं परमेष्ठिना ।\nत्वरितं चैव शक्रेण विष्णुना प्रभविष्णुना ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003580017, "chapter_id": 23580, "verse_number": "१-१-२-१८", "content_sanskrit": "सर्वैरेव हि गंतव्यं यत्र देवो महेश्वरः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003580018, "chapter_id": 23580, "verse_number": "१-१-२-१९", "content_sanskrit": "दाक्षायण्या समेतं तमानयध्वं त्वरान्विताः ।\nतेन सर्वं पवित्रं स्याच्छंभुना योगिना भृशम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003580019, "chapter_id": 23580, "verse_number": "१-१-२-२०", "content_sanskrit": "यस्य स्मृत्या च नामोक्त्या समग्रं सुकृतं भवेत् ।\nतस्मात्सर्वप्रयत्नेन समानेयो वृषध्वजः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003580020, "chapter_id": 23580, "verse_number": "१-१-२-२१", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा प्रहसन्नाह दुष्टधीः ।\nमूलं विष्णुर्हि देवानां यत्र धर्मः सनातनः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003580021, "chapter_id": 23580, "verse_number": "१-१-२-२२", "content_sanskrit": "यस्मिन्वेदाश्च यज्ञाश्च कर्माणिविविधानि च ।\nप्रतिष्ठितानि सर्वाणि सोऽसौ विष्णुरिहागतः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003580022, "chapter_id": 23580, "verse_number": "१-१-२-२३", "content_sanskrit": "सत्यलोकात्समायातो ब्रह्मा लोकपितामहः ।\nवेदैश्चोपनिषद्भिश्च आगमैर्विविधैः सह ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003580023, "chapter_id": 23580, "verse_number": "१-१-२-२४", "content_sanskrit": "तथा सुरगणैः साकमागतः सुरराट् स्वयम् ।\nतथा यूयं समायाता ऋषयो वीतकल्मषाः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003580024, "chapter_id": 23580, "verse_number": "१-१-२-२५", "content_sanskrit": "येये यज्ञोचिताः शांतास्तेते सर्वे समागताः ।\nवेदवेदार्थतत्त्वज्ञाः सर्वे यूयं दृढव्रताः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003580025, "chapter_id": 23580, "verse_number": "१-१-२-२६", "content_sanskrit": "अत्रैव च किमस्माकं रुद्रेणापि प्रयोजनम् ।\nकन्या दत्ता मया विप्रा ब्रह्मणा नोदितेन हि ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003580026, "chapter_id": 23580, "verse_number": "१-१-२-२७", "content_sanskrit": "अकुलीनो ह्यसौ विप्रा नष्टो नष्टप्रियः सदा ।\nभूतप्रेतपिशाचानां पतिरेको दुरत्ययः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003580027, "chapter_id": 23580, "verse_number": "१-१-२-२८", "content_sanskrit": "आत्मसंभावितो मूढःस्तब्धो मौनी समत्सरः ।\nकर्मण्यस्मिन्नयोग्योऽसौ नानीतो हि मयाऽधुना ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003580028, "chapter_id": 23580, "verse_number": "१-१-२-२९", "content_sanskrit": "तस्मात्त्वया न वक्तव्यं पुनरेवं वचोद्विज ।\nसर्वैर्भवद्भिः कर्तव्यो यज्ञो मे सफलो महान् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003580029, "chapter_id": 23580, "verse_number": "१-१-२-३०", "content_sanskrit": "एतच्छ्रुत्वा वचस्तस्य दधीचिर्वाक्यमब्रवीत् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003580030, "chapter_id": 23580, "verse_number": "१-१-२-३१", "content_sanskrit": "दधीचिरुवाच ।\nसर्वेषामृषिवर्याणां सुराणां भावितात्मनाम् ।\nअनयोऽयं महाञ्जातो विना तेन महात्मना ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003580031, "chapter_id": 23580, "verse_number": "१-१-२-३२", "content_sanskrit": "विनाशोऽपि महान्सद्योह्यत्रत्यानां भविष्यति ।\nएवमुक्त्वा दधीचोऽसावेक एव विनिर्गतः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003580032, "chapter_id": 23580, "verse_number": "१-१-२-३३", "content_sanskrit": "यज्ञवाटाच्च दक्षस्य त्वरितः स्वाश्रमं ययौ ।\nमुनौ विनिर्गते दक्षः प्रहसन्निदमब्रवीत् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003580033, "chapter_id": 23580, "verse_number": "१-१-२-३४", "content_sanskrit": "गतः शिवप्रियो वीरो दधीचिर्नाम नामतः ।\nआविष्टचित्ता मंदाश्च मिथ्यावादरताः खलाः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003580034, "chapter_id": 23580, "verse_number": "१-१-२-३५", "content_sanskrit": "वेदबाह्य दुराचारास्त्याज्यास्ते ह्यत्र कर्मणि ।\nवेदवादरता यूयं सर्वे विष्णुपुरोगमाः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003580035, "chapter_id": 23580, "verse_number": "१-१-२-३६", "content_sanskrit": "यज्ञं मे सफलं विप्राः कुर्वंतु ह्यचिरादिव ।\nतदा ते देवयजनं चक्रुः सर्वे सहर्षयः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003580036, "chapter_id": 23580, "verse_number": "१-१-२-३७", "content_sanskrit": "एतस्मिन्नंतरे तत्र पर्वते गंधमादने ।\nधारागृहे विमानेन सखीभिः परिवारिता ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003580037, "chapter_id": 23580, "verse_number": "१-१-२-३८", "content_sanskrit": "दाक्षायणी महादेवी चकार विविधास्तदा ।\nक्रीडा विमानमध्यस्ता कन्दुकाद्याः सहस्रशः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003580038, "chapter_id": 23580, "verse_number": "१-१-२-३९", "content_sanskrit": "क्रीडासक्ता तदा देवी ददर्शाथ महासती ।\nयज्ञं प्रयांतं सोमं च रोहिण्या सहितं प्रभुम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003580039, "chapter_id": 23580, "verse_number": "१-१-२-४०", "content_sanskrit": "क्व गमिष्यति चंद्रोऽयं विजये पृच्छ सत्वरम् ।\nतयोक्ता विजया देवी तं पप्रच्छ यथोचितम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003580040, "chapter_id": 23580, "verse_number": "१-१-२-४१", "content_sanskrit": "कथितं तेन तत्सर्वं दक्षस्यैव मखादिकम् ।\nतच्छ्रुत्वा त्वरिता देवी विजया जातसंभ्रमा ।\nकथयामास तत्सर्वं यदुक्तं शशिना भृशम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003580041, "chapter_id": 23580, "verse_number": "१-१-२-४२", "content_sanskrit": "विमृश्य कारणं देवी किमाह्वानं करोति न ।\nदक्षः पिता मे माता च विस्मृता मां कुतोऽधुना ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003580042, "chapter_id": 23580, "verse_number": "१-१-२-४३", "content_sanskrit": "पृच्छामि शंकरं चाद्य कारणं कृतनिश्चया ।\nस्थापयित्वा सखीस्तत्र आगता शंकरं प्रति ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003580043, "chapter_id": 23580, "verse_number": "१-१-२-४४", "content_sanskrit": "ददर्शतं सभामध्ये त्रिलोचनमवस्थितम् ।\nगणैः परिवृतं सर्वैश्चंडमुंडादिभिस्तदा ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003580044, "chapter_id": 23580, "verse_number": "१-१-२-४५", "content_sanskrit": "बाणो भृंगिस्तथा नंदी शैलादो हि महातपाः ।\nमहाकालो महाचंडो महामुंडो महाशिराः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003580045, "chapter_id": 23580, "verse_number": "१-१-२-४६", "content_sanskrit": "धूम्राक्षो धूम्रकेतुश्च धूम्रपादस्तथैव च ।\nएते चान्ये च बहवो गणा रुद्रानुवर्तिनः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003580046, "chapter_id": 23580, "verse_number": "१-१-२-४७", "content_sanskrit": "केचिद्भयानका रौद्राः कबंधाश्च तथा परे ।\nविलोचनाश्च केचिच्च वक्षोहीनास्तथा परे ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003580047, "chapter_id": 23580, "verse_number": "१-१-२-४८", "content_sanskrit": "एवंभूताश्च शतशः सर्वे ते कृत्तिवाससः ।\nजटाकलापसंभूषाः सर्वे रुद्राक्षभूषणाः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003580048, "chapter_id": 23580, "verse_number": "१-१-२-४९", "content_sanskrit": "जितेंद्रिया वीतरागाः सर्वे विषयवैरिणः ।\nएभिः सर्वैः परिवृतः शंकरो लोकशंकरः ।\nदृष्टस्तया उपाविष्ट आसने परामाद्भुते ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003580049, "chapter_id": 23580, "verse_number": "१-१-२-५०", "content_sanskrit": "आक्षिप्तचित्ता सहसा जगाम शिवसंनिधिम् ।\nशिवेन स्थापिता स्वांके प्रीतियुक्तेन वल्लभा ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003580050, "chapter_id": 23580, "verse_number": "१-१-२-५१", "content_sanskrit": "प्रेम्णोदिता वचोभिः सा बहुमानपुरःसरम् ।\nकिमागमनकार्यंमे वद शीघ्रं सुमध्यमे ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003580051, "chapter_id": 23580, "verse_number": "१-१-२-५२", "content_sanskrit": "एवमुक्ता तदा तेन उवाचासितलोचना ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003580052, "chapter_id": 23580, "verse_number": "१-१-२-५३", "content_sanskrit": "सत्युवाच ।\nपितुर्मम महायज्ञे कस्मात्तव न रोचते ।\nगमनं देवदेवश तत्सर्वं कथय प्रभो ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003580053, "chapter_id": 23580, "verse_number": "१-१-२-५४", "content_sanskrit": "सुहृदामेष वै धर्मः सुहृद्भिः सह संगतिम् ।\nकुर्वंति यन्महादेव सुहृदां प्रीतिवर्धिनीम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003580054, "chapter_id": 23580, "verse_number": "१-१-२-५५", "content_sanskrit": "तसमात्सर्वप्रयत्नेन अनाहूतोऽपि गच्छ भोः ।\nयज्ञवाटं पितुर्मेऽद्य वचनान्मे सदाशिव ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003580055, "chapter_id": 23580, "verse_number": "१-१-२-५६", "content_sanskrit": "तस्यास्तद्वचनं श्रुत्वा ब भाषे सूनृतं वचः ।\nत्वया भद्रे न गंतव्यं दक्षस्य यजनं प्रति ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003580056, "chapter_id": 23580, "verse_number": "१-१-२-५७", "content_sanskrit": "तस्य ये मानिनः सर्वे ससुरासुकिंनराः ।\nते स्रेव यजनं प्राप्ताः पितुस्तव न संशयः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003580057, "chapter_id": 23580, "verse_number": "१-१-२-५८", "content_sanskrit": "अनाहूताश्च ये सुभ्रु गच्छंति परमन्दिरम् ।\nअपमानं प्राप्नुवन्ति मरणादधिकं ततः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003580058, "chapter_id": 23580, "verse_number": "१-१-२-५९", "content_sanskrit": "परेषां मंदिरं प्राप्त इंद्रोपि लघुतां व्रजेत् ।\nतस्मात्त्वाया न गंतव्यं दक्षस्य यजनं शुभे ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003580059, "chapter_id": 23580, "verse_number": "१-१-२-६०", "content_sanskrit": "एवमुक्ता सती तेन महेशेन महात्मना ।\nउवाच रोषसंयुक्तं वाक्यं वाक्यविदां वरा ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003580060, "chapter_id": 23580, "verse_number": "१-१-२-६१", "content_sanskrit": "यज्ञो हि सत्यं लोके त्वं स त्वं देववरेश्वर ।\nअनाहूतोऽसि तेनाद्य पित्रा मे दृष्टचारिणा ।\nतत्सर्वं ज्ञातुमिच्छामि तस्य भावं दुरात्मनः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003580061, "chapter_id": 23580, "verse_number": "१-१-२-६२", "content_sanskrit": "तस्माच्चाद्यैव गच्छामि यज्ञवाडं पितुर्म्मम ।\nअनुज्ञां देहि मे नाथ देवदेव जगत्पते ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003580062, "chapter_id": 23580, "verse_number": "१-१-२-६३", "content_sanskrit": "इत्युक्तो भगवान्रुद्रस्तया देव्या शिवः स्वयम् ।\nविज्ञाताखिलदृग्द्रष्टा भगवान्भूतभावनः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003580063, "chapter_id": 23580, "verse_number": "१-१-२-६४", "content_sanskrit": "स तामुवाच देवेशो महेशः सर्वसिद्धिदः ।\nगच्छ देवि त्वरायुक्ता वचनान्मम सुव्रते ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003580064, "chapter_id": 23580, "verse_number": "१-१-२-६५", "content_sanskrit": "एतं नंदिनमारुह्य नानाविधगणान्विता ।\nगणाः षष्टिसहस्राणि जग्मूरौद्राः शिवज्ञया ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003580065, "chapter_id": 23580, "verse_number": "१-१-२-६६", "content_sanskrit": "तैर्गणैः संवृता देवी जगाम पितृमंदिरम् ।\nनिरीक्ष्य तद्बलं सर्वं महादेवोतिविस्मितः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003580066, "chapter_id": 23580, "verse_number": "१-१-२-६७", "content_sanskrit": "भूषणानि महार्हाणि तेभ्यो देव्यै परंतपः ।\nप्रेषयामास चाव्यग्रो महादेवोऽनु पृष्ठतः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003580067, "chapter_id": 23580, "verse_number": "१-१-२-६८", "content_sanskrit": "देव्या गतं वै स्वपितुर्गृहं तदा विमृश्य सर्वं भगवान्महेशः ।\nदाक्षायणी पित्रवमानिता सती न यास्यतीति स्वपुरं पुनर्जगौ ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003580068, "chapter_id": 23580, "verse_number": "१-१-२-६९", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां प्रथमे माहेश्वरखण्डे केदारखंडे दक्षयज्ञं प्रति सतीदेव्यागमनवर्णनंनाम द्वितीयोऽध्यायः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}]