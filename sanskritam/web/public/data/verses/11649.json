[{"id": 50019852, "chapter_id": 11649, "verse_number": "1", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50019853, "chapter_id": 11649, "verse_number": "2", "content_sanskrit": "बलभद्रः कुरुश्रेष्ठ भगवान् रथमास्थितः। सुहृद्दिदृक्षुरुत्कण्ठः प्रययौ नन्दगोकुलम्॥ १०/८८/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50019854, "chapter_id": 11649, "verse_number": "3", "content_sanskrit": "परिष्वक्तश्चिरोत्कण्ठैर्गोपैर्गोपीभिरेव च। रामोऽभिवाद्य पितरावाशीर्भिरभिनन्दितः॥ १०/८८/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50019855, "chapter_id": 11649, "verse_number": "4", "content_sanskrit": "इत्यारोप्याङ्कमालिङ्ग्य नेत्रैः सिषिचतुर्जलैः॥ १०/८८/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50019856, "chapter_id": 11649, "verse_number": "5", "content_sanskrit": "गोपवृद्धाश्च विधिवद् यविष्ठैरभिवादितः। यथावयो यथासख्यं यथासम्बन्धमात्मनः॥ ४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50019857, "chapter_id": 11649, "verse_number": "6", "content_sanskrit": "समुपेत्याथ गोपाला हास्यहस्तग्रहादिभिः। विश्रान्तं सुखमासीनं पप्रच्छुः पर्युपासिताः॥ १०/८८/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50019858, "chapter_id": 11649, "verse_number": "7", "content_sanskrit": "पृष्टश्चाकथयत् स्वेषु प्रेमगद्गदया गिरा। कृष्णे कमलपत्राक्षे सन्न्यस्ताखिलराधसः॥ १०/८८/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50019859, "chapter_id": 11649, "verse_number": "8", "content_sanskrit": "कच्चिन्नो बान्धवा राम सर्वे कुशलमासते। कच्चित् स्मरथ नो राम यूयं दारसुतान्विताः॥ १०/८८/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50019860, "chapter_id": 11649, "verse_number": "9", "content_sanskrit": "दिष्ट्या कंसो हतः पापो दिष्ट्या मुक्ताः सुहृज्जनाः। निहत्य निर्जित्य रिपून् दिष्ट्या दुर्गं समास्थिताः॥ गोप्यो हसन्त्यः पप्रच्छू रामसन्दर्शनादृताः। कच्चिदास्ते सुखं कृष्णः पुरस्त्रीजनवल्लभः॥ १०/८८/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50019861, "chapter_id": 11649, "verse_number": "10", "content_sanskrit": "कच्चित् स्मरति वा बन्धून् पितरं मातरं च सः। अपि वा स्मरतेऽस्माकमनुसेवां महाभुजः॥ १०/८८/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50019862, "chapter_id": 11649, "verse_number": "11", "content_sanskrit": "मातरं पितरं भ्रातॄन् पतीन् पुत्रान् स्वसॄरपि। यदर्थे हिन्म दाशार्ह दुस्त्यजान् स्वजनान् प्रभो॥ १०/८८/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50019863, "chapter_id": 11649, "verse_number": "12", "content_sanskrit": "ता नः सद्यः परित्यज्य गतः सञ्छिन्नसौहृदः। कथं नु तादृशं स्त्रीभिर्न श्रद्धीयीत भाषितम्॥ १०/८८/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50019864, "chapter_id": 11649, "verse_number": "13", "content_sanskrit": "कथं नु गृह्णन्त्यनवस्थितात्मनो वचः कृतघ्नस्य मुधा परस्त्रियः। कृष्णस्य वैचित्रकथस्य सुन्दरस्मितावलोकोच्छ्वसितस्मरातुराः॥ १०/८८/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50019865, "chapter_id": 11649, "verse_number": "14", "content_sanskrit": "किं नस्तत्कथया गोप्यः कथाः कथयतापराः। यात्यस्माभिर्विना कालो यदि तस्य तथैव नः॥ १०/८८/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50019866, "chapter_id": 11649, "verse_number": "15", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50019867, "chapter_id": 11649, "verse_number": "16", "content_sanskrit": "इति प्रहसितं शौरेर्जल्पितं चानुवीक्षितम्। गतिं प्रेमपरिष्वङ्गं स्मरन्त्यो रुरुदुः स्त्रियः॥ १०/८८/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50019868, "chapter_id": 11649, "verse_number": "17", "content_sanskrit": "सङ्कर्षणस्ताः कृष्णस्य सन्देशैर्हृदयङ्गमैः। सान्त्वयामास भगवान् नानानुनयकोविदः॥ १०/८८/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50019869, "chapter_id": 11649, "verse_number": "18", "content_sanskrit": "द्वौ मासौ तत्र चावात्सीन्मधुं माधवमेव च। रामः क्षपासु भगवान् गोपीनां रतिमावहन्॥ १०/८८/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50019870, "chapter_id": 11649, "verse_number": "19", "content_sanskrit": "पूर्णचन्द्रकरामृष्टे कौमुदीगन्धवायुना। यमुनोपवने रेमे सेविते स्त्रीगणैर्वृतः॥ १०/८८/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50019871, "chapter_id": 11649, "verse_number": "20", "content_sanskrit": "वरुणप्रेषिता देवी वारुणी वृक्षकोटरात्। पतन्ती तद्वनं सर्वं सौरभेणाध्यवासयत्॥ १०/८८/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50019872, "chapter_id": 11649, "verse_number": "21", "content_sanskrit": "तं गन्धं मधुधाराया वायुनोपहृतं बलः। आध्रायोपगतस्तत्र ललनाभिः पपौ समम्॥ १०/८८/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50019873, "chapter_id": 11649, "verse_number": "22", "content_sanskrit": "नेदुर्दुन्दुभयो व्योम्नि ववृषुः कुसुमैर्मुदा। गन्धर्वा मुनयो रामं तद्वीर्यैरीडिरे मुदा॥ १०/८८/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50019874, "chapter_id": 11649, "verse_number": "23", "content_sanskrit": "उपगीयमानचरितो वनिताभिर्हलायुधः। वनेषु व्यचरत् क्षीबो माहेन्द्र इव वारणः॥ १०/८८/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50019875, "chapter_id": 11649, "verse_number": "24", "content_sanskrit": "शुभैककुण्डलो मत्तो वैजयन्त्या च मालया। बिभ्रत् स्मितमुखाम्भोजं स्वेदप्रालेयभूषितम्॥ १०/८८/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50019876, "chapter_id": 11649, "verse_number": "25", "content_sanskrit": "स चाजुहाव यमुनां जलक्रीडार्थमीश्वरः। निजवाक्यमनादृत्य मत्त इत्यापगां बलः॥ १०/८८/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 50019877, "chapter_id": 11649, "verse_number": "26", "content_sanskrit": "अनागतां हलाग्रेण कुपितो विचकर्ष ह। पापे त्वं मामवज्ञाय यन्नायासि मयाऽऽहुता॥ १०/८८/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 50019878, "chapter_id": 11649, "verse_number": "27", "content_sanskrit": "नेष्ये त्वां लाङ्गलाग्रेण शतधा कामचारिणीम्। एवं निर्भर्त्सिता भीता यमुना यदुनन्दनम्॥ १०/८८/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 50019879, "chapter_id": 11649, "verse_number": "28", "content_sanskrit": "उवाच चकिता वाचं पतित्वा पादयोर्नृप॥ १०/८८/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 50019880, "chapter_id": 11649, "verse_number": "29", "content_sanskrit": "यमुनोवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 50019881, "chapter_id": 11649, "verse_number": "30", "content_sanskrit": "रामराम महाबाहो न जाने तव विक्रमम्। यस्यैकांशेन विधृता जगती जगतां पते॥ १०/८८/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 50019882, "chapter_id": 11649, "verse_number": "31", "content_sanskrit": "परं भावं भगवतो भगवन् मामजानतीम्। मोक्तुमर्हसि विश्वात्मन् प्रपन्नां भक्तवत्सल॥ १०/८८/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 50019883, "chapter_id": 11649, "verse_number": "32", "content_sanskrit": "ततो व्यमुञ्चत् करुणो याचितो यमुनां बलः। विजगाह जलं स्त्रीभिः करेणुभिरिवेभराट्॥ १०/८८/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 50019884, "chapter_id": 11649, "verse_number": "33", "content_sanskrit": "कामं विहृत्य सलिलादुत्तीर्णायासिताम्बरे। भूषणानि विचित्राणि ददौ कान्तिमतीं स्रजम्॥ १०/८८/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 50019885, "chapter_id": 11649, "verse_number": "34", "content_sanskrit": "वसित्वा वाससी नीले मालामाबध्य काञ्चनीम्। रेजे स्वलङ्कृतस्ताभिर्माहेन्द्र इव वारणः॥ १०/८८/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 50019886, "chapter_id": 11649, "verse_number": "35", "content_sanskrit": "अद्यापि दृश्यते राजन् यमुनाऽऽकृष्टवर्त्मना। बलस्यानन्तवीर्यस्य वीर्यं सूचयतीव हि॥ १०/८८/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 50019887, "chapter_id": 11649, "verse_number": "36", "content_sanskrit": "एवं सर्वा निशा याता एकेव रमतो व्रजे। रामस्याक्षिप्तचित्तस्य माधुर्यैर्व्रजयोषिताम्॥ १०/८८/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 50019888, "chapter_id": 11649, "verse_number": "37", "content_sanskrit": "इति श्रीमद्भागवते दशमस्कन्धे अष्टाशीतितमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]