[{"id": 6000184000, "chapter_id": 10184, "verse_number": null, "content_sanskrit": "अथ नवमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000184001, "chapter_id": 10184, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_009/BhP_09.009.001.m4a", "display_order": 2}, {"id": 6000184002, "chapter_id": 10184, "verse_number": "९-९-१", "content_sanskrit": "भगवानात्मनाऽऽत्मानं राम उत्तमकल्पकैः।\nसर्वदेवमयं देवमीज आचार्यवान् मखैः॥ ९/९/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_009/BhP_09.009.002.m4a", "display_order": 3, "topics": [{"text": "बहुभिर्मखैर्यजनपूर्वकं रामस्य भ्रात्रादिभिः सह सुखेनायोध्यायां वासः", "range": "१–५"}]}, {"id": 6000184003, "chapter_id": 10184, "verse_number": "९-९-२", "content_sanskrit": "होत्रेऽददाद् दिशं प्राचीं ब्रह्मणो दक्षिणां विभुः।\nअध्वर्यवे प्रतीचीं च उदीचीं सामगाय सः॥ ९/९/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_009/BhP_09.009.003.m4a", "display_order": 4}, {"id": 6000184004, "chapter_id": 10184, "verse_number": "९-९-३", "content_sanskrit": "आचार्याय ददौ शेषा यावती भूस्तदन्तरा।\nमन्यमान इदं कृत्स्नं ब्राह्मणोऽर्हति निःस्पृहः॥ ९/९/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_009/BhP_09.009.004.m4a", "display_order": 5}, {"id": 6000184005, "chapter_id": 10184, "verse_number": "९-९-४", "content_sanskrit": "इत्यदात् स्वमलङ्कारं वासोभ्यामवशेषितः।\nतथा राज्ञ्यपि वैदेही सौमङ्गल्यावशेषिता॥ ९/९/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_009/BhP_09.009.005.m4a", "display_order": 6}, {"id": 6000184006, "chapter_id": 10184, "verse_number": "९-९-५", "content_sanskrit": "ते तु ब्राह्मणदेवस्य वात्सल्यं वीक्ष्य सज्जनाः।\nप्रीताः क्लिन्नधियस्तस्मै प्रत्यर्प्येदं बभाषिरे॥ ९/९/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_009/BhP_09.009.006.m4a", "display_order": 7}, {"id": 6000184007, "chapter_id": 10184, "verse_number": null, "content_sanskrit": "ब्राह्मणा ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_009/BhP_09.009.007.m4a", "display_order": 8}, {"id": 6000184008, "chapter_id": 10184, "verse_number": "९-९-६", "content_sanskrit": "अप्रत्तं नस्त्वया किन्नु भगवन् भुवनेश्वर।\nयतोऽन्तर्हृदि संविश्य तमो हंसि स्वरोचिषा॥ ९/९/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_009/BhP_09.009.008.m4a", "display_order": 9, "topics": [{"text": "तत्कृतराज्यपरिपालनप्रकारकथनम्", "range": "६–३६"}]}, {"id": 6000184009, "chapter_id": 10184, "verse_number": "९-९-७", "content_sanskrit": "नमो ब्रह्मण्यदेवाय रामायाकुण्ठमेधसे।\nउत्तमश्लोकधुर्याय न्यस्ततन्वेऽर्पिताङ्घ्रये॥ ९/९/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_009/BhP_09.009.009.m4a", "display_order": 10}, {"id": 6000184010, "chapter_id": 10184, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_009/BhP_09.009.010.m4a", "display_order": 11}, {"id": 6000184011, "chapter_id": 10184, "verse_number": "९-९-८", "content_sanskrit": "कदाचिल्लोकजिज्ञासुर्गूढा रात्र्यामलक्षितः।\nचरन् वचोऽशृणोद् रामो भार्यामुद्दिश्य कस्यचित्॥ ९/९/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_009/BhP_09.009.011.m4a", "display_order": 12}, {"id": 6000184012, "chapter_id": 10184, "verse_number": "९-९-९", "content_sanskrit": "नाहं बिभर्मि त्वां दुष्टामसतीं परवेश्मगाम्।\nस्‍त्रैणो हि बिभृयात् सीतां रामो नाहं भजे पुनः॥ ९/९/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_009/BhP_09.009.012.m4a", "display_order": 13}, {"id": 6000184013, "chapter_id": 10184, "verse_number": "९-९-१०", "content_sanskrit": "इति लोकाद् बहुमुखाद् दुराराध्यादसंविदः।\nश्रुत्वा भीतेन सा त्यक्ता प्राप्ता प्राचेतसाश्रमम्॥ ९/९/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_009/BhP_09.009.013.m4a", "display_order": 14}, {"id": 6000184014, "chapter_id": 10184, "verse_number": "९-९-११", "content_sanskrit": "अन्तर्वत्न्यागते काले यमौ सा सुषुवे सुतौ।\nकुशो लव इति ख्यातौ तयोश्चक्रे क्रिया मुनिः॥ ९/९/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_009/BhP_09.009.014.m4a", "display_order": 15}, {"id": 6000184015, "chapter_id": 10184, "verse_number": "९-९-१२", "content_sanskrit": "अङ्गदश्चक्रकेतुश्च लक्ष्मणस्यात्मजौ स्मृतौ।\nतक्षः पुष्कल इत्यास्तां भरतस्य महीपते॥ ९/९/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_009/BhP_09.009.015.m4a", "display_order": 16}, {"id": 6000184016, "chapter_id": 10184, "verse_number": "९-९-१३", "content_sanskrit": "सुबाहुः श्रुतसेनश्च शत्रुघ्नस्य बभूवतुः। गन्धर्वान् कोटिशो जघ्ने भरतो विजये दिशाम्।\nतदीयं धनमानीय सर्वं राज्ञे न्यवेदयत्॥ ९/९/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_009/BhP_09.009.016.m4a", "display_order": 17}, {"id": 6000184017, "chapter_id": 10184, "verse_number": "९-९-१४", "content_sanskrit": "शत्रुघ्नश्च मधोः पुत्रं लवणं नाम राक्षसम्।\nहत्वा मधुवनं चक्रे मधुरां नाम वै पुरीम्॥ ९/९/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_009/BhP_09.009.017.m4a", "display_order": 18}, {"id": 6000184018, "chapter_id": 10184, "verse_number": "९-९-१५", "content_sanskrit": "मुनौ निक्षिप्य तनयौ सीता भर्त्रा विवासिता।\nध्यायन्ती रामचरणौ विवरं प्रविवेश ह॥ ९/९/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_009/BhP_09.009.018.m4a", "display_order": 19}, {"id": 6000184019, "chapter_id": 10184, "verse_number": "९-९-१६", "content_sanskrit": "तच्छ्रुत्वा भगवान् रामो रुन्धन्नपि धिया शुचः।\nस्मरंस्तस्या गुणांस्तांस्तान् नाशक्नोद् रोद्धुमीश्वरः॥ ९/९/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_009/BhP_09.009.019.m4a", "display_order": 20}, {"id": 6000184020, "chapter_id": 10184, "verse_number": "९-९-१७", "content_sanskrit": "स्‍त्रीपुंप्रसङ्ग एतादृक् सर्वत्र त्रासमावहः।\nअपीश्वराणां किमुत ग्राम्यस्य गृहमेधिनः॥ ९/९/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_009/BhP_09.009.020.m4a", "display_order": 21}, {"id": 6000184021, "chapter_id": 10184, "verse_number": "९-९-१८", "content_sanskrit": "तत ऊर्ध्वं ब्रह्मचर्यं धारयन्नजुहोत् प्रभुः।\nत्रयोदशाब्दसाहस्रमग्निहोत्रमखण्डितम्॥ ९/९/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_009/BhP_09.009.021.m4a", "display_order": 22}, {"id": 6000184022, "chapter_id": 10184, "verse_number": "९-९-१९", "content_sanskrit": "स्मरतां हृदि विन्यस्य बुद्धं पद्ममिवांशुकैः।\nस्वपादपल्लवं राम आत्मज्योतिरगात् ततः॥ ९/९/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_009/BhP_09.009.022.m4a", "display_order": 23}, {"id": 6000184023, "chapter_id": 10184, "verse_number": "९-९-२०", "content_sanskrit": "नेदं यशो रघुपतेरिह विश्वमूर्तेर्लीलातनोरधिकशान्तविमुक्तधाम्नः।\nरक्षोवधो जलधिबन्धनमस्‍त्रपाणेः किं तस्य शत्रुहनने कपयः सहायाः॥ ९/९/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_009/BhP_09.009.023.m4a", "display_order": 24}, {"id": 6000184024, "chapter_id": 10184, "verse_number": "९-९-२१", "content_sanskrit": "यस्यामलं नृपसदस्सु यशोऽधुनाऽपि गायन्त्यघघ्नमृषयो दिगिभेन्द्रपाते।\nतन्नाकपालवसुपालकिरीटजुष्टं पादाम्बुजं रघुपतेः शरणं प्रपद्ये॥ ९/९/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_009/BhP_09.009.024.m4a", "display_order": 25}, {"id": 6000184025, "chapter_id": 10184, "verse_number": "९-९-२२", "content_sanskrit": "स यैः स्पृष्टोऽभिदृष्टो वा संवित्तोऽनुगतोऽपि वा।\nकोसलास्ते ययुः स्थानं यत्र गच्छन्ति योगिनः॥ ९/९/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_009/BhP_09.009.025.m4a", "display_order": 26}, {"id": 6000184026, "chapter_id": 10184, "verse_number": "९-९-२३", "content_sanskrit": "पुरुषो रामचरितं श्रवणैरुपधारयन्।\nआनृशंस्यपरो राजन् कर्मबन्धैर्विमुच्यते॥ ९/९/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_009/BhP_09.009.026.m4a", "display_order": 27}, {"id": 6000184027, "chapter_id": 10184, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_009/BhP_09.009.027.m4a", "display_order": 28}, {"id": 6000184028, "chapter_id": 10184, "verse_number": "९-९-२४", "content_sanskrit": "कथं स भगवान् रामो भ्रातृबन्धुष्ववर्तत।\nप्रजास्वौरसवद्रामः कथं वा राम ईश्वरः॥ ९/९/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_009/BhP_09.009.028.m4a", "display_order": 29}, {"id": 6000184029, "chapter_id": 10184, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_009/BhP_09.009.029.m4a", "display_order": 30}, {"id": 6000184030, "chapter_id": 10184, "verse_number": "९-९-२५", "content_sanskrit": "अथादिशद् दिग्विजये भ्रातॄंश्च त्रिदशेश्वरः।\nआत्मानं दर्शयन् स्वानां पुरीमैक्षत सानुगः॥ ९/९/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_009/BhP_09.009.030.m4a", "display_order": 31}, {"id": 6000184031, "chapter_id": 10184, "verse_number": "९-९-२६", "content_sanskrit": "आसिक्तमार्गां गन्धोदैः करिणां मदसीकरैः।\nस्वामिनं प्राप्तमालोक्य मत्तां वा सुतरामिव॥ ९/९/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_009/BhP_09.009.031.m4a", "display_order": 32}, {"id": 6000184032, "chapter_id": 10184, "verse_number": "९-९-२७", "content_sanskrit": "प्रासादगोपुरसभाचैत्यदेवगृहादिषु।\nविन्यस्तहेमकलशैः पताकाभिश्च मण्डिताम्॥ ९/९/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_009/BhP_09.009.032.m4a", "display_order": 33}, {"id": 6000184033, "chapter_id": 10184, "verse_number": "९-९-२८", "content_sanskrit": "पूगैः सवृन्तै रम्भाभिः पालिकाभिः सुवाससाम्।\nआदर्शैरंशुकैः स्रग्भिः कृतकौतुकतोरणाम्॥ ९/९/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_009/BhP_09.009.033.m4a", "display_order": 34}, {"id": 6000184034, "chapter_id": 10184, "verse_number": "९-९-२९", "content_sanskrit": "तमुपेयुस्तत्र तत्र पौरा अर्हणपाणयः।\nआशिषो युयुजुर्देव पाहीमां प्राक् त्वयोद्धृताम्॥ ९/९/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_009/BhP_09.009.034.m4a", "display_order": 35}, {"id": 6000184035, "chapter_id": 10184, "verse_number": "९-९-३०", "content_sanskrit": "तं ताः प्रजा वीक्ष्य पतिं चिरागतं दिदृक्षयोत्सृज्य गृहान् स्‍त्रियो नराः।\nआरुह्य हर्म्याण्यरविन्दलोचनं नतृप्तनेत्राः कुसुमैरवाकिरन्॥ ९/९/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_009/BhP_09.009.035.m4a", "display_order": 36}, {"id": 6000184036, "chapter_id": 10184, "verse_number": "९-९-३१", "content_sanskrit": "अथ प्रविष्टः स्वगृहं जुष्टं स्वैः पूर्वराजभिः।\nअनन्तगृहकोशाढ्यमनर्घ्योरुपरिच्छदम्॥ ९/९/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_009/BhP_09.009.036.m4a", "display_order": 37}, {"id": 6000184037, "chapter_id": 10184, "verse_number": "९-९-३२", "content_sanskrit": "विद्रुमोदुम्बरद्वारैर्वैदूर्यस्तम्भपङ्क्तिभिः।\nस्थलैर्मारकतैः स्वच्छैर्भातं स्फटिकभित्तिभिः॥ ९/९/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_009/BhP_09.009.037.m4a", "display_order": 38}, {"id": 6000184038, "chapter_id": 10184, "verse_number": "९-९-३३", "content_sanskrit": "चित्रस्रग्भिः पट्टिकाभिर्वासोमणिगणांशुभिः।\nमुक्ताफलैश्चिदुल्लासैः कान्तकामोपपत्तिभिः॥ ९/९/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_009/BhP_09.009.038.m4a", "display_order": 39}, {"id": 6000184039, "chapter_id": 10184, "verse_number": "९-९-३४", "content_sanskrit": "धूपदीपैः सुरभिभिर्मण्डितैः पुष्पमण्डकैः।\nस्‍त्रीपुंभिः सुरसङ्काशैर्जुष्टं भूषणभूषणैः॥ ९/९/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_009/BhP_09.009.039.m4a", "display_order": 40}, {"id": 6000184040, "chapter_id": 10184, "verse_number": "९-९-३५", "content_sanskrit": "तस्मिन् स भगवान् रामः स्‍निग्धया प्रिययेष्टया।\nरेमे स्वारामचाराणामृषभः सीतया सह॥ ९/९/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_009/BhP_09.009.040.m4a", "display_order": 41}, {"id": 6000184041, "chapter_id": 10184, "verse_number": "९-९-३६", "content_sanskrit": "बुभुजे च यथाकामं कामं धर्ममपीडयन्।\nवर्षपूगान् बहून् नॄणामभिध्येयाङ्घ्रिपल्लवः॥ ९/९/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_009/BhP_09.009.041.m4a", "display_order": 42}, {"id": 6000184042, "chapter_id": 10184, "verse_number": null, "content_sanskrit": "इति श्रीमद्भागवते वैयासिक्यां संहितायां नवमस्कन्धे नवमाध्यायः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]