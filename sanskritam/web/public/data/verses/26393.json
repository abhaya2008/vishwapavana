[{"id": 7006393000, "chapter_id": 26393, "verse_number": "२-५०-१", "content_sanskrit": "जनमेजय उवाच\nहत्या कंसं महावीर्यं देवैरपि दुरासदम् ।\nनाभिषिक्तः स्वयं राज्ये नोपविष्टो नृपासने ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006393001, "chapter_id": 26393, "verse_number": "२-५०-२", "content_sanskrit": "कन्यार्थे चागतः कृष्णस्तत्रापि न कृतोऽतिथिः ।\nअमानमतुलं प्राप्य क्षान्तवान् केन हेतुना ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006393002, "chapter_id": 26393, "verse_number": "२-५०-३", "content_sanskrit": "विनतायाः सुतश्चैव महाबलपराक्रमः ।\nस चापि क्षमया युक्तः कारणं किमपेक्षिनः ।\nएतदाख्याहि भगवन् परं कौतूहलं हि मे ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006393003, "chapter_id": 26393, "verse_number": "२-५०-४", "content_sanskrit": "वैशम्पायन उवाच\nग्दिर्भनगरीं प्र;प्ते वैनतेये सदुरने ।\nमनसा चिन्तयामास वासुदेवाय कशिकः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006393004, "chapter_id": 26393, "verse_number": "२-५०-५", "content_sanskrit": "दृष्ट्वाऽऽश्चर्यं  हि नः सर्वान् राजन्यान् प्रवदाम्यहम् ।\nवसुदेवसुते दृष्टे ध्रुवं पापक्षयो भवेत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006393005, "chapter_id": 26393, "verse_number": "२-५०-६", "content_sanskrit": "विशुद्धभावः कृष्णस्य आवयोर्दृष्टक्तवतः ।\nअतः पात्रतरः कोऽन्यस्त्रिषु लोकेषु विद्यते ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006393006, "chapter_id": 26393, "verse_number": "२-५०-७", "content_sanskrit": "कृष्णात् कमलपत्राक्षाद् दैवदैवाज्जनार्दनात् ।\nतस्यावां किं प्रदास्याव आतिथ्यकरणे नृप ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006393007, "chapter_id": 26393, "verse_number": "२-५०-८", "content_sanskrit": "एवमन्योन्यं संचिन्त्य भ्रातरौ क्रथकैशिकौ ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006393008, "chapter_id": 26393, "verse_number": "२-५०-९", "content_sanskrit": "स्वं राज्यं दातुकामोतु जग्मतुः केशवान्तिकम् ।\nदेवमासाद्य तौ वीरौ विदर्भनगराधिपौ ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006393009, "chapter_id": 26393, "verse_number": "२-५०-१०", "content_sanskrit": "ऊचतुस्तौ महाभागौ प्रणम्य शिरसा हरिम् ।\nअद्यावां सफलं जन्म अद्यावां सफलं यशः ।\nअद्यावां पितरस्तृप्ता देवे चावां गृहागते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006393010, "chapter_id": 26393, "verse_number": "२-५०-११", "content_sanskrit": "चामरं व्यजनं छत्रं ध्वजं सिंहासनं बलम् ।\nस्फीतकोशा पुरी चेयमावाभ्यां सहिता तव ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006393011, "chapter_id": 26393, "verse_number": "२-५०-१२", "content_sanskrit": "उपेन्द्रस्त्वं महाबाहो देवेन्द्रेणाभिषिक्तवान् ।\nआवामिह हि राज्ये त्वामभिषिक्तं ददामि ते ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006393012, "chapter_id": 26393, "verse_number": "२-५०-१३", "content_sanskrit": "आवयोर्यत्कृतं कार्यं बहुभिः पार्थिवैरपि ।\nन शक्यतेऽन्यथा कर्तुं जरासंधेन वा स्वयम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006393013, "chapter_id": 26393, "verse_number": "२-५०-१४", "content_sanskrit": "शत्रुस्ते मागधो राजा जरासंधो महाद्युतिः ।\nकथां ते ब्रुवते नित्यं नृपाणामभयप्रदः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006393014, "chapter_id": 26393, "verse_number": "२-५०-१५", "content_sanskrit": "सिंहासनमनध्यास्यं पुरं चास्य न विद्यते ।\nकथं राजसमाजेऽस्मिन्नास्यते देवकीसुतः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006393015, "chapter_id": 26393, "verse_number": "२-५०-१६", "content_sanskrit": "कृष्णोऽपि सुमहावीर्यो ह्यभिमानी महाद्युतिः ।\nन चागमिष्यते वास्मिन् कन्यार्थे च स्वयंवरे ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006393016, "chapter_id": 26393, "verse_number": "२-५०-१७", "content_sanskrit": "पार्थिवेषूपविष्टेषु स्वेषु सिंहासनेषु वै ।\nकथमास्यति नीचेषु आसनेषु महाद्युतिः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006393017, "chapter_id": 26393, "verse_number": "२-५०-१८", "content_sanskrit": "इति संचोद्यमानस्तु श्रुत्वासौ भीष्मको नृपः ।\nआवयोः सह सम्मन्त्र्य विग्रहोपशमाय च ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006393018, "chapter_id": 26393, "verse_number": "२-५०-१९", "content_sanskrit": "तव विश्रामहेतोर्हि कारितेदं गृहोत्तमम् ।\nदेवानामादिदेवोऽसि सर्वलोकनमस्कृतः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006393019, "chapter_id": 26393, "verse_number": "२-५०-२०", "content_sanskrit": "मानुष्ये मर्न्यलोकैऽस्मिन् राजेन्द्रत्वं समाचर ।\nसमाजे मनुजेन्द्राणां मा भूदासनसंकटम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006393020, "chapter_id": 26393, "verse_number": "२-५०-२१", "content_sanskrit": "विदर्भनगरे वैषां राजेन्द्रत्वं विचेष्टय ।\nआस्यतामासने शुभ्रे श्वः प्रभाते महाद्युते ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006393021, "chapter_id": 26393, "verse_number": "२-५०-२२", "content_sanskrit": "अधिवास्याद्य चात्मानं विधिदृष्टेन कर्मणा ।\nय गमिष्यन्ति नृपाः करिष्ये देवशासनात् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006393022, "chapter_id": 26393, "verse_number": "२-५०-२३", "content_sanskrit": "एवमुक्त्वा सुरश्रेष्ठं प्रणिपत्य कृताञ्जली ।\nभूषयामासतुवीरौ रङ्गमध्ये नृपैर्वृते ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006393023, "chapter_id": 26393, "verse_number": "२-५०-२४", "content_sanskrit": "देवदूतस्य वचनं यथोक्तं वज्रपाणिना ।\nलिखित्वा सुमहातेजाः कैशिकः प्राह शासनम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006393024, "chapter_id": 26393, "verse_number": "२-५०-२५", "content_sanskrit": "कैशिक उवाच\nविदितं वो नृपाः सर्वे वैनतेयसहाच्युतः ।\nआगतोऽतिथिरूपेण विदर्भनगरीं हरिः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006393025, "chapter_id": 26393, "verse_number": "२-५०-२६", "content_sanskrit": "प्राप्तमालोक्य पात्रोऽयमिति संचिन्त्य भूपतिः ।\nप्रददौ वासुदेवाय स्वं राज्यं धर्महेतुना ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006393026, "chapter_id": 26393, "verse_number": "२-५०-२७", "content_sanskrit": "इदमासनमास्वेति भ्रात्रा मे चोदिते ततः ।\nवागुक्ता चाशरीरेण केनापि व्योमचारिणा ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006393027, "chapter_id": 26393, "verse_number": "२-५०-२८", "content_sanskrit": "देवदूत उवाच\nन युक्तमासनं दातुं त्वयासीनं नराधिप ।\nइदमस्यासनं दिव्यं सर्वरत्नविभूषितम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006393028, "chapter_id": 26393, "verse_number": "२-५०-२९", "content_sanskrit": "जाम्बूनदमयं शुभ्रं रचितं विश्वकर्मणा ।\nप्रेषितं देवराजेन सिंहलक्षणलक्षितम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006393029, "chapter_id": 26393, "verse_number": "२-५०-३०", "content_sanskrit": "अत्रोपविष्टं देवेशं चराचरनमस्कृतम् ।\nअभिषिञ्चन्तु राजेन्द्रं बहुभिः पार्थिवैः सह ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006393030, "chapter_id": 26393, "verse_number": "२-५०-३१", "content_sanskrit": "आगताः कुण्डिनगरे कन्याहेतोर्नराधिपाः ।\nनागमिष्यति यः कश्चित्सोऽस्य वध्यो भविष्यति॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006393031, "chapter_id": 26393, "verse_number": "२-५०-३२", "content_sanskrit": "इमे चैवाष्टकलशा निधीनामंशसम्भवाः ।\nअक्षया राजराजस्य धनेशस्य महात्मनः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006393032, "chapter_id": 26393, "verse_number": "२-५०-३३", "content_sanskrit": "दिव्या काञ्चनरत्नाढ्या दिव्याभरणयोनयः ।\nराजेन्द्रस्याभिषेकार्थमागच्छन्ति नृपैर्वृताः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006393033, "chapter_id": 26393, "verse_number": "२-५०-३४", "content_sanskrit": "एष शक्रस्य संदेशः कथितो वो नराधिपाः ।\nलेखेनाहूय तान् सर्वानभिषिञ्चन्तु केशवम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006393034, "chapter_id": 26393, "verse_number": "२-५०-३५", "content_sanskrit": "कैशिक उवाच\nइति संचोद्य खस्थोऽसौ देवदूतो गतो दिवम् ।\nदत्त्वाऽऽसनं च कृष्णाय बालार्कसदृशप्रभम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006393035, "chapter_id": 26393, "verse_number": "२-५०-३६", "content_sanskrit": "तेनाहं नोदयिष्यामि भवद्भिर्ये समागताः ।\nदुर्निवार्यतरं घोरं शक्रस्य स्वयमीरितम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006393036, "chapter_id": 26393, "verse_number": "२-५०-३७", "content_sanskrit": "युष्माभिर्दर्शने युक्तमद्भुतं भुवि दुर्लभम् ।\nकलशैरभिषिच्यन्तं स्वयमेव नभस्तलात् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006393037, "chapter_id": 26393, "verse_number": "२-५०-३८", "content_sanskrit": "दृष्ट्वाऽऽश्चर्यं हि नः सर्वान् ध्रुवं पापक्षयो भवेत् ।\nस्नापनार्थं च कृष्णाय देवदेवाय विष्णवे ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006393038, "chapter_id": 26393, "verse_number": "२-५०-३९", "content_sanskrit": "आगच्छध्वं नृपश्रेष्ठा न भयं कर्तुमर्हथ ।\nआवयोः कृतसन्धानो युष्मदर्थे जनार्दनः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006393039, "chapter_id": 26393, "verse_number": "२-५०-४०", "content_sanskrit": "सर्वेषां मनुजेन्द्राणामभयं कुरुते हरिः ।\nविशुद्धभावः कृष्णस्तु आवयोर्दृष्टतत्त्वतः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006393040, "chapter_id": 26393, "verse_number": "२-५०-४१", "content_sanskrit": "मागधस्य विशेषेण न वैरं हृदि दृश्यते ।\nयदत्र कारणं कार्यं तद् भवद्भिर्विचिन्त्यताम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006393041, "chapter_id": 26393, "verse_number": "२-५०-४२", "content_sanskrit": "वैशम्पायन उवाच\nएवं संचिन्तयामासुर्नृपाः शापभयार्दिताः ।\nभूयः शुश्रुवु राजेन्द्राः केशवाय महात्मने ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006393042, "chapter_id": 26393, "verse_number": "२-५०-४३", "content_sanskrit": "मेघगम्भीरनादेन स्वरेणापूरयन् नभः ।\nवागुवाचाशरीरेण देवराजस्य शासनात् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006393043, "chapter_id": 26393, "verse_number": "२-५०-४४", "content_sanskrit": "चित्राङ्गद उवाच\nत्रैलोक्याधिपतिः शक्रः प्रजापालनहेतुना ।\nआज्ञापयति युष्माकं नृपाणां हितकाम्यया ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006393044, "chapter_id": 26393, "verse_number": "२-५०-४५", "content_sanskrit": "न युक्तं वसतान्योन्यं कृष्णेन सह वैरिणा ।\nवसध्वं प्रीतिमुत्पाद्य स्वराष्ट्रेषु नृपोत्तमाः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006393045, "chapter_id": 26393, "verse_number": "२-५०-४६", "content_sanskrit": "प्रणतार्तिहरः कृष्णः प्रतिसेनान्तकोऽनलः ।\nअनेन सह सम्प्रीत्या मोदध्वं विगतज्वराः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006393046, "chapter_id": 26393, "verse_number": "२-५०-४७", "content_sanskrit": "मानुषाणां नृपा देवा नृपाणां देवताः सुराः ।\nसुराणां देवता शक्रः शक्रस्यापि जनार्दनः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006393047, "chapter_id": 26393, "verse_number": "२-५०-४८", "content_sanskrit": "एष विष्णुः प्रभुर्देवो देवानामपि दैवतम् ।\nजातोऽयं मानुषे लोके नररूपेण केशवः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006393048, "chapter_id": 26393, "verse_number": "२-५०-४९", "content_sanskrit": "अजेयः सर्वलोकेषु देवदानवमानवैः ।\nकार्तिकेयसहायस्य अपि शूलभृतः स्वयम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006393049, "chapter_id": 26393, "verse_number": "२-५०-५०", "content_sanskrit": "तस्मै देवाधिदेवाय केशवाय महात्मने ।\nअभिषेक्तुं सुरैः सार्द्धं किमिच्छेयमतः परम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006393050, "chapter_id": 26393, "verse_number": "२-५०-५१", "content_sanskrit": "न चाधिकारो देवानां राजेन्द्रस्याभिषेचने ।\nतेनाहं नाभिषिञ्चामि सर्वलोकनमस्कृतम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006393051, "chapter_id": 26393, "verse_number": "२-५०-५२", "content_sanskrit": "नुपाणामधिकारोऽयं राजेन्द्रस्य निवेशने ।\nगत्वा यूयं विदर्भायां क्रथकैशेकयोः सह ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006393052, "chapter_id": 26393, "verse_number": "२-५०-५३", "content_sanskrit": "संचिन्त्य विधिदृष्टेन कुरुध्वं नृपसत्तमाः ।\nप्रीतिसन्धानकालोऽयमिति संचिन्त्य वासवः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006393053, "chapter_id": 26393, "verse_number": "२-५०-५४", "content_sanskrit": "बोधनार्थं विसृष्टोऽहं युष्माकं मनुजेश्वराः ।\nविदर्भनगरे कृष्णः श्रावितोऽस्याधिवासनम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006393054, "chapter_id": 26393, "verse_number": "२-५०-५५", "content_sanskrit": "राजेन्द्रत्वाभिषेकार्थं राजानौ क्रथकैशिकौ ।\nताभ्यां सह नृपश्रेष्ठाः कृत्वा सुमहदुत्सवम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006393055, "chapter_id": 26393, "verse_number": "२-५०-५६", "content_sanskrit": "अभिषेकेण सत्कृत्य प्रतिगृह्यास्य दक्षिणम् ।\nआगमिष्यथ संहृष्टाः पुनरेव स्वयंवरम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006393056, "chapter_id": 26393, "verse_number": "२-५०-५७", "content_sanskrit": "जरासंधः सुनीथश्च रुक्मी चैव महारथः ।\nशाल्वः सौभपतिश्चैव चत्वारो राजसत्तमाः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006393057, "chapter_id": 26393, "verse_number": "२-५०-५८", "content_sanskrit": "रङ्गस्याशून्यहेतोर्हि तिष्ठन्तु इह पार्थिवाः ।\nवैशम्पायन उवाच\nएवमाज्ञां सुरेशस्य श्रुत्वा चित्राङ्गदेरिताम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006393058, "chapter_id": 26393, "verse_number": "२-५०-५९", "content_sanskrit": "गमनाय मतिं चक्रुः सर्व एव नृपोत्तमाः ।\nअनुज्ञाता नरेन्द्रेण जरासंधेन धीमता ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006393059, "chapter_id": 26393, "verse_number": "२-५०-६०", "content_sanskrit": "भीष्मकं पुरतः कृत्वा प्रयाताः स्वबलैर्वृताः ।\nभीष्मकश्च महाबाहुः स्वबलेन समन्वितः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006393060, "chapter_id": 26393, "verse_number": "२-५०-६१", "content_sanskrit": "जगाम पार्थिवैः सार्द्धं दह्यमानेन चेतसा ।\nयत्र कृष्णो महाबाहुः कैशिकस्य निवेशने ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006393061, "chapter_id": 26393, "verse_number": "२-५०-६२", "content_sanskrit": "दूरादेव प्रकाशन्ती पताकाध्वजमालिनी ।\nशुभा देवसभा रम्या स्नानहेतोरिहागता ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006393062, "chapter_id": 26393, "verse_number": "२-५०-६३", "content_sanskrit": "दिव्यरत्नप्रभाकीर्णा दिव्यध्वजसमाकुला ।\nदिव्याम्बरपताकाढ्या दिव्याभरणभूषिता ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006393063, "chapter_id": 26393, "verse_number": "२-५०-६४", "content_sanskrit": "दिव्यस्रग्दामकलिला दिव्यगन्धाधिवासिता ।\nविमानयानैः श्रीमद्भिः समन्तात् परिवारिता ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006393064, "chapter_id": 26393, "verse_number": "२-५०-६५", "content_sanskrit": "दिव्याप्सरोगणाश्चैव विद्याधरगणास्तथा ।\nगन्धर्वा मुनयश्चैव किन्नराश्च समन्ततः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006393065, "chapter_id": 26393, "verse_number": "२-५०-६६", "content_sanskrit": "उपगायन्ति देवेशमम्बरान्तरमाश्रिताः ।\nस्तुवन्ति मुनयश्चैव सिद्धाश्च परमर्षयः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006393066, "chapter_id": 26393, "verse_number": "२-५०-६७", "content_sanskrit": "देवदुन्दुभयश्चैव स्वयमेवानदन् दिवि ।\nपञ्चयोनिसमुत्थानि गन्धचूर्णान्यनेकशः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006393067, "chapter_id": 26393, "verse_number": "२-५०-६८", "content_sanskrit": "समन्तात्पात्यमानानि चाकाशस्थैर्दिवौकसैः ।\nस्वयमागत्य देवेन्द्रो दैवैः सह शचीपतिः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006393068, "chapter_id": 26393, "verse_number": "२-५०-६९", "content_sanskrit": "विमानवरमारुह्य सप्रकाशः स्थितोऽम्बरे ।\nअष्टौ ये लोकपालास्ते स्वासु दिक्षु समास्थिताः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006393069, "chapter_id": 26393, "verse_number": "२-५०-७०", "content_sanskrit": "उपगायन्ति नृत्यन्ति स्तुवन्ति च समन्ततः ।\nश्रुत्वा सुतुमुलं नादं सर्व एव नराधिपाः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006393070, "chapter_id": 26393, "verse_number": "२-५०-७१", "content_sanskrit": "विस्मयोत्फुल्लनयना विविशुस्ते सभां शुभाम् ।\nकैशिकश्च महाबाहुरुपगम्य नराधिपान् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006393071, "chapter_id": 26393, "verse_number": "२-५०-७२", "content_sanskrit": "प्रवेशयामास बली प्रतिपूज्य यथाविधि ।\nनिवेदिते सुरश्रेष्ठे पार्थिवानां समागमे ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006393072, "chapter_id": 26393, "verse_number": "२-५०-७३", "content_sanskrit": "निर्जगाम हरिः श्रीमान् सर्वमङ्गपूजितः ।\nततोऽम्बरस्थास्ते दिव्याः कलशाश्चैलकण्ठिनः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006393073, "chapter_id": 26393, "verse_number": "२-५०-७४", "content_sanskrit": "सहकारसमायुक्ता ववर्षुर्जलदा इव ।\nदिव्यकाञ्चनरत्नौघैर्दिव्यपुप्पसमन्वितैः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006393074, "chapter_id": 26393, "verse_number": "२-५०-७५", "content_sanskrit": "गन्धचूर्णविमिश्रैश्च राजेन्द्रस्याभिषेचने ।\nयथोक्तविधिपूर्वेण अभिषिच्य जनार्दनम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006393075, "chapter_id": 26393, "verse_number": "२-५०-७६", "content_sanskrit": "दर्शयित्वा नरेन्द्राणां दिव्यैरावरणैः शुभै ।\nदिव्याम्बरविचित्रैश्च दिव्यमाल्यानुलेपनैः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7006393076, "chapter_id": 26393, "verse_number": "२-५०-७७", "content_sanskrit": "सत्कृत्य विधिवद्राज्ञ उपविष्टो जनार्दनः ।\nशुभे देवसभे रम्ये स्नानहेतोरिहागते ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7006393077, "chapter_id": 26393, "verse_number": "२-५०-७८", "content_sanskrit": "उपास्यमानो यदुभिर्विदर्भैश्च नराधिपैः ।\nवैनतेयश्च बलवान् कामरूपो नराकृतिः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7006393078, "chapter_id": 26393, "verse_number": "२-५०-७९", "content_sanskrit": "दक्षिणं पार्श्वमाश्रित्य आसनस्थो महाबलः ।\nक्रथश्च कैशिको वीरो वामपार्श्वे तथासने ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7006393079, "chapter_id": 26393, "verse_number": "२-५०-८०", "content_sanskrit": "उपविष्टौ महात्मानौ देवस्यानुमते नृपौ ।\nतथैव वामपार्श्वे तु वृष्ण्यन्धकमहारथाः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7006393080, "chapter_id": 26393, "verse_number": "२-५०-८१", "content_sanskrit": "सात्यकिप्रमुखा वीरा उपविष्टा महाबलाः ।\nभास्करप्रतिमे दिव्ये दिव्यास्तरणविस्तृते ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7006393081, "chapter_id": 26393, "verse_number": "२-५०-८२", "content_sanskrit": "सुखोपविष्टं श्रीमन्तं देवैरिव शचीपतिम् ।\nसचिवैः श्राविताः सर्वे प्रविष्टास्ते नराधिपाः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7006393082, "chapter_id": 26393, "verse_number": "२-५०-८३", "content_sanskrit": "यथार्हेण च सम्पूज्य राजानः सर्व एव ते ।\nसुखोपविष्टास्ते स्वेषु आसनेषु नराधिपाः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7006393083, "chapter_id": 26393, "verse_number": "२-५०-८४", "content_sanskrit": "कैशिकस्तु महाप्राज्ञः सर्वशास्त्रार्थवित्तमः ।\nपूजयित्वा यथान्यायमुवाच वदतां वरः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7006393084, "chapter_id": 26393, "verse_number": "२-५०-८५", "content_sanskrit": "कैशिक उवाच\nअविज्ञाता नृपाः सर्वे मानुषोऽयमिति प्रभो ।\nभवन्तमुपरुद्धानां देव त्वं क्षन्तुमर्हसि ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7006393085, "chapter_id": 26393, "verse_number": "२-५०-८६", "content_sanskrit": "श्रीकृष्ण उवाच\nन मे वैरं प्रवसति एकाहमपि कैशिक ।\nविशेषेण नरेन्द्राणां क्षत्रधर्मऽवतिष्ठताम् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7006393086, "chapter_id": 26393, "verse_number": "२-५०-८७", "content_sanskrit": "योद्धव्यमिति धर्मेण अधर्मे तु पराङ्मुखे ।\nतेषां किं हेतुना कोपः कर्तव्यस्त्ववनीश्वराः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7006393087, "chapter_id": 26393, "verse_number": "२-५०-८८", "content_sanskrit": "यद्गतं तदतिक्रान्तं ये मृतास्ते दिवं गताः ।\nएष धर्मो नृलोकेऽस्मिञ्जायन्ते च म्रियन्ति च ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7006393088, "chapter_id": 26393, "verse_number": "२-५०-८९", "content_sanskrit": "तस्मादशोच्यं भवतां मृतार्थे च नराधिपाः ।\nक्षन्तव्यं रोचतेऽस्माकं वीतवैरा भवन्तु ते ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7006393089, "chapter_id": 26393, "verse_number": "२-५०-९०", "content_sanskrit": "वैशम्पायन उवाच\nएवमुक्त्वा नरेन्द्रांस्तानाश्वास्य मधुसूदनः ।\nकैशिकस्य मुखं वीक्ष्य विरराम महाद्युतिः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7006393090, "chapter_id": 26393, "verse_number": "२-५०-९१", "content_sanskrit": "एतस्मिन्नेव काले तु भीष्मको नयकोविदः ।\nपूजयित्वा यथान्यायमुवाच वदतां वरः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}]