[{"id": 2105954, "chapter_id": 3294, "verse_number": "१६-२३-१", "content_sanskrit": "वैशम्पायन उवाच।\nवनं गते कौरवेन्द्रे दुःखशोकसमन्विताः।\nबभूवुः पाण्डवा राजन्मातृशोकेनि चान्विताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2105955, "chapter_id": 3294, "verse_number": "१६-२३-२", "content_sanskrit": "तथा पौरजनः सर्वः शोचन्नास्ते जनाधिपम्।\nकुर्वाणाश्च कथास्तत्र ब्राह्मणा नृपतिं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2105956, "chapter_id": 3294, "verse_number": "१६-२३-३", "content_sanskrit": "कथं न राजा वृद्धः स वने वसति निर्जने।\nगान्धारी च महाभागा सा च कुन्ती पृथा कथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2105957, "chapter_id": 3294, "verse_number": "१६-२३-४", "content_sanskrit": "सुखार्हः स हि राजर्षिरसुखी तद्वनं महत्।\nकिमवस्थः समासाद्य प्रज्ञाचक्षुर्महामनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2105958, "chapter_id": 3294, "verse_number": "१६-२३-५", "content_sanskrit": "सुदुष्करं कृतवती कुन्ती पुत्रानपास्य सा।\nराज्यश्रियं परित्यज्य वनं सा समरोचयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2105959, "chapter_id": 3294, "verse_number": "१६-२३-६", "content_sanskrit": "विदुरः किमवस्थश्च भ्रातृशुश्रूषुरात्मवान्।\nस च गावल्गणिर्धीमान्भर्तृपिण्डानुपालकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2105960, "chapter_id": 3294, "verse_number": "१६-२३-७", "content_sanskrit": "आकुमारं च पौरास्ते चिन्ताशोकसमाहताः।\nतत्रतत्र कथाश्चक्रुः समासाद्य परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2105961, "chapter_id": 3294, "verse_number": "१६-२३-८", "content_sanskrit": "पाण्डवाश्चैव ते सर्वे भृशं शोकपरायणाः।\nशोचन्तो मातरं वृद्धामूषुर्नातिचिरं पुरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2105962, "chapter_id": 3294, "verse_number": "१६-२३-९", "content_sanskrit": "तथैव वृद्धं पितरं हतपुत्रं जनेश्वरम्।\nगान्धारीं च महाभागां विदुरं च महामतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2105963, "chapter_id": 3294, "verse_number": "१६-२३-१०", "content_sanskrit": "नैषां बभूव सम्प्रीतिस्तान्विचिन्तयतां तदा।\nन राज्ये न च नारीषु न वेदाध्ययनेषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2105964, "chapter_id": 3294, "verse_number": "१६-२३-११", "content_sanskrit": "परं निर्वेदमगमंश्चिन्तयन्ता नराधिपम्।\nतं च ज्ञातिवधं घोरं संस्मरन्तः पुनःपुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2105965, "chapter_id": 3294, "verse_number": "१६-२३-१२", "content_sanskrit": "अभिमन्योश्च बालस्य विनाशं रणमूर्धनि।\nकर्णस्य च महाबाहोः सङ्ग्रामेष्वपलायिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2105966, "chapter_id": 3294, "verse_number": "१६-२३-१३", "content_sanskrit": "तथैव द्रौपदेयानामन्येषां सुहृदामपि।\nवधं संस्मृत्य ते वीरा नातिप्रमनसोऽभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2105967, "chapter_id": 3294, "verse_number": "१६-२३-१४", "content_sanskrit": "हतप्रवीरां पृथिवीं हृतरत्नां च भारत।\nसदैव चिन्तयन्तस्ते न शमं चोपलेभिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2105968, "chapter_id": 3294, "verse_number": "१६-२३-१५", "content_sanskrit": "द्रौपदी हतपुत्रा च सुभद्रा चैव भामिनी।\nनातिप्रीतियुते देव्यौ तदास्तामप्रहृष्टवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2105969, "chapter_id": 3294, "verse_number": "१६-२३-१६", "content_sanskrit": "वैराट्यास्तनयं दृष्ट्वा पितरं ते परिक्षितम्।\nधारयन्ति स्म ते प्राणांस्तव पूर्वपितामहाः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2105970, "chapter_id": 3294, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्रमवासिकपर्वणि आश्रमवासपर्वणि त्रयोविंशोऽध्यायः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]