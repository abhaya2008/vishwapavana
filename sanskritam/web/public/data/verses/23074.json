[{"id": 7003074000, "chapter_id": 23074, "verse_number": "४-९-१", "content_sanskrit": "नारद उवाच ।\nसंस्थाप्य गोकुले कृष्णं यशोदामंदिरं वसुः ।\nजगाम स्वगृहं नन्दः किं चकार महां प्रभुः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003074001, "chapter_id": 23074, "verse_number": "४-९-२", "content_sanskrit": "किञ्चकार हरिस्तत्र कतिवर्षस्थितिः प्रभोः ।\nबालक्रीडनकं तस्य वर्णय क्रमशो मुने ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003074002, "chapter_id": 23074, "verse_number": "४-९-३", "content_sanskrit": "पुरा कृता या प्रतिज्ञा गोलोके राधया सह ।\nतत्कृतं केन विधिना प्रतिज्ञापालनं हरेः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003074003, "chapter_id": 23074, "verse_number": "४-९-४", "content_sanskrit": "कीदृग्वृन्दावनं नाम मण्डलं किंविधं वद ।\nरासक्रीडां जलक्रीडां संव्यस्य वर्णय प्रभो ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003074004, "chapter_id": 23074, "verse_number": "४-९-५", "content_sanskrit": "नन्दस्तपः किञ्चकार यशोदा चाथ रोहिणी ।\nहरेः पूर्वं च हलिनः कुत्र जन्म बभूव ह ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003074005, "chapter_id": 23074, "verse_number": "४-९-६", "content_sanskrit": "पीयूषखंडमाख्यानमपूर्वं श्रीहरेः स्मृतम् ।\nविशेषतः कविमुखान्नव्यं नूनं पदे पदे ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003074006, "chapter_id": 23074, "verse_number": "४-९-७", "content_sanskrit": "स्वरासमण्डलक्रीडां वर्णय स्वयमेव च ।\nपरोक्षवर्णनात्काव्यं प्रशस्तं नव्यवर्णनम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003074007, "chapter_id": 23074, "verse_number": "४-९-८", "content_sanskrit": "श्रीकृष्णांशो भवान्साक्षाद्योगींद्राणां गुरोर्गुरुः ।\nयो यस्यांशः स च जनस्तस्यैव सुखतः सुखी ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003074008, "chapter_id": 23074, "verse_number": "४-९-९", "content_sanskrit": "त्वयैव वर्णितौ पादौ विलीनौ तु युवां हरेः ।\nसाक्षाद्गोलोकनाथांशस्त्वमेव तत्समो महान् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003074009, "chapter_id": 23074, "verse_number": "४-९-१०", "content_sanskrit": "नारायण उवाच ।\nब्रह्मेशशेषविघ्नेशाः कूर्मो धर्मोऽहमेव च ।\nनरश्च कार्त्तिकेयश्च श्रीकृष्णांशा वयं नव ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003074010, "chapter_id": 23074, "verse_number": "४-९-११", "content_sanskrit": "अहो गोलोकनाथस्य महिमा केन वर्ण्यते ।\nयं स्वयं नो विजानीमो न वेदाः किं विपश्चितः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003074011, "chapter_id": 23074, "verse_number": "४-९-१२", "content_sanskrit": "सूकरो वामनः कल्किर्बौद्धः कपिलमीनकौ ।\nएते चांशाः कलाश्चान्ये संत्येव कतिधा मुने ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003074012, "chapter_id": 23074, "verse_number": "४-९-१३", "content_sanskrit": "कूर्मो नृसिंहो रामश्च श्वेतद्वीपविराड्विभुः ।\nपरिपूर्णतमः कृष्णो वैकुण्ठे गोकुले स्वयम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003074013, "chapter_id": 23074, "verse_number": "४-९-१४", "content_sanskrit": "वैकुण्ठे कमलाकांतो रूपभेदाच्चतुर्भुजः ।\nगोलोके गोकुले राधाकांतोऽयं द्विभुजः स्वयम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003074014, "chapter_id": 23074, "verse_number": "४-९-१५", "content_sanskrit": "अस्यैव तेजो नित्यं च चित्ते कुर्वंति योगिनः ।\nभक्ताः पादाम्बुजं तेजः कुतस्तेजस्विनं विना ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003074015, "chapter_id": 23074, "verse_number": "४-९-१६", "content_sanskrit": "शृणु विप्र वर्णयामि यशोदानन्दयोस्तपः ।\nरोहिण्याश्च यतो हेतोर्ददृशुस्ते हरेर्मुखम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003074016, "chapter_id": 23074, "verse_number": "४-९-१७", "content_sanskrit": "वसूनां प्रवरो नन्दो नाम्ना द्रोणस्तपोधनः ।\nतस्य पत्नी धरा साध्वी यशोदा सा तपस्विनी ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003074017, "chapter_id": 23074, "verse_number": "४-९-१८", "content_sanskrit": "रोहिणी सर्पमाता च कद्रूश्च सर्पकारिणी ।\nएतेषां जन्मचरितं निबोध कथयामि  ते ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003074018, "chapter_id": 23074, "verse_number": "४-९-१९", "content_sanskrit": "एकदा च धरा द्रोणौ पर्वते गन्धमादने ।\nपुण्यदे भारते वर्षे गौतमाश्रमसन्निधौ ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003074019, "chapter_id": 23074, "verse_number": "४-९-२०", "content_sanskrit": "चक्रतुश्च तपस्तत्र वर्षाणामयुतं मुने ।\nश्रीकृष्णदर्शनार्थं च निर्जने सुप्रभातटे ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003074020, "chapter_id": 23074, "verse_number": "४-९-२१", "content_sanskrit": "न ददर्श हरिं द्रोणो धरा चैव तपस्विनी ।\nकृत्वाग्निकुंडं वैराग्यात्प्रवेष्टुं समुपस्थितौ ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003074021, "chapter_id": 23074, "verse_number": "४-९-२२", "content_sanskrit": "तौ मर्तुकामौ दृष्ट्वा च वाग्बभूवाशरीरिणी ।\nद्रक्ष्यथः श्रीहरिं पृथ्व्यां गोकुले पुत्ररूपिणम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003074022, "chapter_id": 23074, "verse_number": "४-९-२३", "content_sanskrit": "जन्मांतरे वसुश्रेष्ठ दुर्दर्शं योगिनां विभुम्।\nध्यानासाध्यं च विदुषां ब्रह्मादीनां च वंदितम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003074023, "chapter_id": 23074, "verse_number": "४-९-२४", "content_sanskrit": "श्रुत्वैवं तद्धराद्रोणौ जग्मतुः स्वालयं सुखात् ।\nलब्ध्वा तु भारते जन्म  दृष्टं ताभ्यां हरेर्मुखम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003074024, "chapter_id": 23074, "verse_number": "४-९-२५", "content_sanskrit": "यशोदानंदयोरेवं कथितं चरितं तव ।\nसुगोप्यं त्रिदशानां च रोहिणीचरितं शृणु ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003074025, "chapter_id": 23074, "verse_number": "४-९-२६", "content_sanskrit": "एकदा देवमाता च पुष्पोत्सवदिने सती ।\nविज्ञापनं चरद्वारा चकार कश्यपं मुने ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003074026, "chapter_id": 23074, "verse_number": "४-९-२७", "content_sanskrit": "सुस्नाता सुंदरी देवी रत्नालंकार भूषिता ।\nचकार वेषं विविधं ददर्श दर्पणे मुखम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003074027, "chapter_id": 23074, "verse_number": "४-९-२८", "content_sanskrit": "कस्तूरीबिंदुना सार्द्धं सिंदूरबिंदुसंयुतम् ।\nरत्नकुंडलशोभाढ्यं पत्राभरणभूषितम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003074028, "chapter_id": 23074, "verse_number": "४-९-२९", "content_sanskrit": "गजमौक्तिकसंयुक्तं नासाग्रं सुमनोहरम् ।\nशरत्पार्वणचंद्रास्यं शरत्पंकजलोचनम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003074029, "chapter_id": 23074, "verse_number": "४-९-३०", "content_sanskrit": "वक्रभ्रूभंगिना युक्तं विचित्रकज्जलोज्ज्वलम् ।\nपक्वदाडिमबीजाभदंतपंक्तिविराजितम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003074030, "chapter_id": 23074, "verse_number": "४-९-३१", "content_sanskrit": "पक्वबिंबाधरौष्ठं च सस्मितं सुंदरं सदा ।\nअतीव कमनीयं च मुनींद्रचित्तमोहनम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003074031, "chapter_id": 23074, "verse_number": "४-९-३२", "content_sanskrit": "एवंभूतं मुखं दृष्ट्वा सुंदरी स्वगृहे स्थिता ।\nपश्यंती पतिमार्गं च कामबाणप्रपीडिता ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003074032, "chapter_id": 23074, "verse_number": "४-९-३३", "content_sanskrit": "शुश्राव वार्तामदितिः कश्यपं कद्रुसंयुतम् ।\nरत्नसारसमारंभे तस्या वक्षस्थले स्थितम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003074033, "chapter_id": 23074, "verse_number": "४-९-३४", "content_sanskrit": "श्रुत्वा चुकोप साध्वी सा हताशा रतिकातरा ।\nन शशाप पतिं प्रेम्णा शशाप सर्पमातरम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003074034, "chapter_id": 23074, "verse_number": "४-९-३५", "content_sanskrit": "न देवालययोग्या सा धर्मिष्ठा धर्मनाशिनी ।\nदूरं गच्छतु स्वर्लोकादात्मयोनिं च मानवीम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003074035, "chapter_id": 23074, "verse_number": "४-९-३६", "content_sanskrit": "श्रुत्वैवं सा चरद्वारा शशाप देवमातरम् ।\nसा चैवं मानवीं योनिं यातु मर्त्ये जरायुताम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003074036, "chapter_id": 23074, "verse_number": "४-९-३७", "content_sanskrit": "कश्यपो बोधयामास कद्रुं च सर्पमातरम् ।\nकाले यास्यसि मर्त्यं च मया सह शुचिस्मिते ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003074037, "chapter_id": 23074, "verse_number": "४-९-३८", "content_sanskrit": "त्यज भीतिं लभ सुखं द्रक्ष्यसि श्रीहरेर्मुखम्।\nएवमुक्त्वा कश्यपश्च जगाम चादितेर्गृहम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003074038, "chapter_id": 23074, "verse_number": "४-९-३९", "content_sanskrit": "वांछां पूर्णां च तस्याश्च चकार भगवान्विभुः ।\nऋतौ तत्र महेंद्रश्च बभूव च सुरर्षभः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003074039, "chapter_id": 23074, "verse_number": "४-९-४०", "content_sanskrit": "अदितिर्देवकी चैव सर्पमाता च रोहिणी ।\nकश्यपो वसुदेवश्च श्रीकृष्णजनको महान् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003074040, "chapter_id": 23074, "verse_number": "४-९-४१", "content_sanskrit": "रहस्यं गोपनीयं च सर्वं निगदितं मुने ।\nअधुना बलदेवस्य जन्माख्यानं मुने शृणु ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003074041, "chapter_id": 23074, "verse_number": "४-९-४२", "content_sanskrit": "अनंतस्याप्रमेयस्य सहस्रशिरसः प्रभोः ।\nरोहिणी वसुदेवस्य भार्यारत्नं च प्रेयसी ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003074042, "chapter_id": 23074, "verse_number": "४-९-४३", "content_sanskrit": "जगाम गोकुलं साध्वी वसुदेवाज्ञया मुने ।\nसंकर्षणस्य रक्षार्थं कंसभीता पलायिता ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003074043, "chapter_id": 23074, "verse_number": "४-९-४४", "content_sanskrit": "देवक्याः सप्तमं गर्भं माया कृष्णाज्ञया तदा ।\nरोहिण्या जठरे तत्र स्थापयामास गोकुले ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003074044, "chapter_id": 23074, "verse_number": "४-९-४५", "content_sanskrit": "संस्थाप्य च तदा गर्भं कैलासं सा जगाम ह ।\nदिनांतरे कतिपये रोहिणी नंदमंदिरे ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003074045, "chapter_id": 23074, "verse_number": "४-९-४६", "content_sanskrit": "सुषाव पुत्रं कृष्णांशं तप्तरौप्याभमीश्वरम् ।\nईषद्धास्यं प्रसन्नास्यं ज्वलंतं ब्रह्मतेजसा ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003074046, "chapter_id": 23074, "verse_number": "४-९-४७", "content_sanskrit": "तस्यैव जन्ममात्रेण देवा मुमुदिरे तदा ।\nस्वर्गे दुंदुभयो नेदुरानका मुरजादयः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003074047, "chapter_id": 23074, "verse_number": "४-९-४८", "content_sanskrit": "जयशब्दं शंखशब्दं चक्रुर्देवा मुदान्विताः ।\nनंदो हृष्टो ब्राह्मणेभ्यो धनं बहुविधं ददौ ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003074048, "chapter_id": 23074, "verse_number": "४-९-४९", "content_sanskrit": "चिच्छेद नाडीं धात्री च स्नापयामास बालकम् ।\nजयशब्दं जगुर्गोप्यः सर्वाभ रणभूषिताः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003074049, "chapter_id": 23074, "verse_number": "४-९-५०", "content_sanskrit": "परपुत्रोत्सवं नंदश्चकार परमादरात् ।\nतदा यशोदा गोपीभ्यो ब्राह्मणेभ्यो ददौ मुदा ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003074050, "chapter_id": 23074, "verse_number": "४-९-५१", "content_sanskrit": "धनानि नानावस्तूनि तैलं सिंदूरमेव च ।\nइत्येवं कथितं वत्स यशोदानंदयोस्तपः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003074051, "chapter_id": 23074, "verse_number": "४-९-५२", "content_sanskrit": "जन्माख्यानं च हलिनो रोहिणीचरितं तथा ।\nअधुना ते वांछनीयं नंदपुत्रोत्सवं शृणु ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003074052, "chapter_id": 23074, "verse_number": "४-९-५३", "content_sanskrit": "सुखदं मोक्षदं सारं जन्ममृत्युजरापहम् ।\nमंगलं कृष्णचरितं वैष्णवानां च जीवनम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003074053, "chapter_id": 23074, "verse_number": "४-९-५४", "content_sanskrit": "सर्वाशुभविनाशं च भक्तिदास्यप्रदं हरेः ।\nश्रीकृष्णं वसुदेवश्च संस्थाप्य नंदमंदिरे ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003074054, "chapter_id": 23074, "verse_number": "४-९-५५", "content_sanskrit": "गृहीत्वा बालिकां हृष्टो जगाम निजमंदिरम् ।\nकथितं चरितं तस्याः श्रुतं संमुखतो मुने ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003074055, "chapter_id": 23074, "verse_number": "४-९-५६", "content_sanskrit": "अधुना गोकुले कृष्णचरितं शृणु मंगलम् ।\nवसुदेवे गृहं याते यशोदा नंद एव च ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003074056, "chapter_id": 23074, "verse_number": "४-९-५७", "content_sanskrit": "मंगले सूतिकागारे जयागारे जयान्विते ।\nददर्श पुत्रं भूमिस्थं नवीननीरदप्रभम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003074057, "chapter_id": 23074, "verse_number": "४-९-५८", "content_sanskrit": "अतीव सुंदरं नग्नं पश्यंतं गृहशेखरम् ।\nशरत्पार्वणचंद्रास्यं नीलेंदीवरलोचनम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003074058, "chapter_id": 23074, "verse_number": "४-९-५९", "content_sanskrit": "रुदंतं च हसंतं च् वेणुसंसक्तविग्रहम् ।\nहस्तद्वयं सुविन्यस्तं प्रेमवंतं पदांबुजम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003074059, "chapter_id": 23074, "verse_number": "४-९-६०", "content_sanskrit": "दृष्ट्वा नंदः स्त्रिया सार्द्धं हरिं हृष्टो बभूव ह ।\nधात्री तं स्नापयामास शीततोयेन बालकम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003074060, "chapter_id": 23074, "verse_number": "४-९-६१", "content_sanskrit": "चिच्छेद नाडीं बालस्य हर्षाद्गोप्यो जयं ददुः ।\nआजग्मुर्गोपिकाः सर्वा बृहच्छ्रोण्यश्चलत्कुचाः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003074061, "chapter_id": 23074, "verse_number": "४-९-६२", "content_sanskrit": "बालिकाश्च वयस्यश्च विप्रपत्न्याश्च सूतिकाम् ।\nआशिषं युयुजुः सर्वा ददृशुर्बालकं मुदा ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003074062, "chapter_id": 23074, "verse_number": "४-९-६३", "content_sanskrit": "क्रोडे चक्रुः प्रशंसंत्य ऊषुस्तत्र च काश्चन ।\nनंदः सचैलः स्नातश्च धृत्वा धौते च वाससी ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003074063, "chapter_id": 23074, "verse_number": "४-९-६४", "content_sanskrit": "पारंपर्यविधिं तत्र चकार हृष्टमानसः ।\nब्राह्मणान्भोजयामास कारयामास मंगलम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003074064, "chapter_id": 23074, "verse_number": "४-९-६५", "content_sanskrit": "वाद्यानि वादयामास बंदिभ्यश्च ददौ धनम् ।\nततो नंदश्च सानंदं ब्राह्मणेभ्यो ददौ धनम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003074065, "chapter_id": 23074, "verse_number": "४-९-६६", "content_sanskrit": "सद्रत्नानि प्रवालानि हीरकाणि च सादरम् ।\nतिलानां पर्वतान्सप्त सुवर्णशतकं  मुने ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003074066, "chapter_id": 23074, "verse_number": "४-९-६७", "content_sanskrit": "रौप्यं धान्याचलं वस्त्रं गोसहस्रं मनोहरम् ।\nदधि दुग्धं शर्करां च नवनीतं घृतं मधु ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003074067, "chapter_id": 23074, "verse_number": "४-९-६८", "content_sanskrit": "मिष्टान्नं सल्लड्डुकौघं स्वादूनि मोदकानि च ।\nभूमिं च सर्वसस्याढ्यां वायुवेगांस्तुरंगमान् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003074068, "chapter_id": 23074, "verse_number": "४-९-६९", "content_sanskrit": "तांबूलानि च तैलानि दत्त्वा हृष्टो बभूव ह ।\nरक्षितुं सूतिकागारं योजयामास ब्राह्मणान् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003074069, "chapter_id": 23074, "verse_number": "४-९-७०", "content_sanskrit": "तत्र मंत्रज्ञमनुजान्स्थविरान्गोपिकागणान् ।\nवेदांश्च पाठयामास हरेर्नामैकमंगलम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003074070, "chapter_id": 23074, "verse_number": "४-९-७१", "content_sanskrit": "भक्त्या च ब्राह्मणद्वारा पूजयामास देवताः ।\nगोपालिकाश्च वृद्धाश्च रत्नालंकारभूषिताः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003074071, "chapter_id": 23074, "verse_number": "४-९-७२", "content_sanskrit": "सस्मिता शीघ्रगामिन्य आजग्मुर्नंदमंदिरम् ।\nनानाविधाश्च गणका ज्योतिःशास्त्रविशार दाः७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003074072, "chapter_id": 23074, "verse_number": "४-९-७३", "content_sanskrit": "वाक्सिद्धाः पुस्तककरा आजग्मुर्नंदमंदिरम् ।\nसस्मिता विप्रपत्न्यश्च वयस्याः स्थविरा वराः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003074073, "chapter_id": 23074, "verse_number": "४-९-७४", "content_sanskrit": "बालिका बालकयुता आजग्मुर्नंदमंदिरम् ।\nतेभ्योऽपि प्रददौ रत्नं धनानि विविधानि  च७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003074074, "chapter_id": 23074, "verse_number": "४-९-७५", "content_sanskrit": "वरवस्त्राणि रौप्याणि गोसहस्राणि सादरम् ।\nनंदस्तेभ्यो नमस्कृत्य चकार विनयं मुदा ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003074075, "chapter_id": 23074, "verse_number": "४-९-७६", "content_sanskrit": "आशिषं युयुजुः सर्वे ददृशुर्बालकं परम् ।\nएवं संभृतसंभारो बभूव व्रजपुंगवः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003074076, "chapter_id": 23074, "verse_number": "४-९-७७", "content_sanskrit": "गणकैः कारयामास यद्भविष्यं शुभाशुभम् ।\nएवं ववर्ध बालश्च शुक्लपक्षे यथा शशी ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003074077, "chapter_id": 23074, "verse_number": "४-९-७८", "content_sanskrit": "नंदालये हली चैव भुक्त मातुः पयोधरम् ।\nतदा च रोहिणी हृष्टा तत्र पुत्रोत्सवे मुदा ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003074078, "chapter_id": 23074, "verse_number": "४-९-७९", "content_sanskrit": "तैलसिंदूरतांबूलं धनं ताभ्यो ददौ मुने ।\nदत्त्वाशिषश्च शिरसि ताश्च ते स्वालयं ययुः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003074079, "chapter_id": 23074, "verse_number": "४-९-८०", "content_sanskrit": "यशोदारोहिणीनंदास्तस्थुर्गेहे मुदान्विताः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}]