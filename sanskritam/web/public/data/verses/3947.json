[{"id": 2135899, "chapter_id": 3947, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2135900, "chapter_id": 3947, "verse_number": "१", "content_sanskrit": "पुलस्त्यस्य तु यः क्रोधादर्धदेहोऽभवन्मुनिः ।\nविश्रवा नाम सक्रोधः स वैश्रवणमैक्षत \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2135901, "chapter_id": 3947, "verse_number": "२", "content_sanskrit": "बुबुधे तं तु सक्रोधं पितरं राक्षसेश्वरः ।\nकुबेरस्तु प्रसादार्थं यतते स्म सदा नृप \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2135902, "chapter_id": 3947, "verse_number": "३", "content_sanskrit": "स राजराजो लङ्कायां न्यवसन् नरवाहनः ।\nराक्षसीः प्रददौ तिस्रः पितुर्वै परिचारिकाः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2135903, "chapter_id": 3947, "verse_number": "४", "content_sanskrit": "ताः सदा तं महात्मानं सन्तोषयितुमुद्यताः ।\nऋषिं भरतशार्दूल नृत्यगीतविशारदाः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2135904, "chapter_id": 3947, "verse_number": "५", "content_sanskrit": "पुष्पोत्कटा च राका च मानिनी च विशाम्पते ।\nअन्योन्यस्पर्धया राजन् श्रेयस्कामाः सुमध्यमाः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2135905, "chapter_id": 3947, "verse_number": "६", "content_sanskrit": "स तासां भगवांस्तुष्टो महात्मा प्रददौ वरान् ।\nलोकपालोपमान् पुत्रानेकैकस्यां यथेप्सितान् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2135906, "chapter_id": 3947, "verse_number": "७", "content_sanskrit": "पुष्पोत्कटायां जज्ञाते द्वौ पुत्रौ राक्षसेश्वरौ।\nकुम्भकर्णदशग्रीवौ बलेनाप्रतिमौ भुवि \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2135907, "chapter_id": 3947, "verse_number": "८", "content_sanskrit": "मालिनी जनयामास पुत्रमेकं विभीषणम् ।\nराकायां मिथुनं जज्ञे खरः शूर्पणखा तथा \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2135908, "chapter_id": 3947, "verse_number": "९", "content_sanskrit": "विभीषणस्तु रूपेण सर्वेभ्योऽभ्यधिकोऽभवत् ।\nस बभूव महाभागो धर्मगोप्ता क्रियारतिः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2135909, "chapter_id": 3947, "verse_number": "१०", "content_sanskrit": "दशग्रीवस्तु सर्वेषां श्रेष्ठो राक्षसपुङ्गवः ।\nमहोत्साहो महावीर्यो महासत्त्वपराक्रमः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2135910, "chapter_id": 3947, "verse_number": "११", "content_sanskrit": "कुम्भकर्णो बलेनासीत् सर्वेभ्योऽभ्यधिको युधि ।\nमायावी रणशौण्डश्च रौद्रश्च रजनीचरः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2135911, "chapter_id": 3947, "verse_number": "१२", "content_sanskrit": "खरो धनुषि विक्रान्तो ब्रह्मद्विट् पिशिताशनः ।\nसिद्धविघ्नकरी चापि रौद्री शूर्पणखा तथा \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2135912, "chapter_id": 3947, "verse_number": "१३", "content_sanskrit": "सर्वे वेदविदः शूराः सर्वे सुचरितव्रताः ।\nऊषुः पित्रा सह रता गन्धमादनपर्वते \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2135913, "chapter_id": 3947, "verse_number": "१४", "content_sanskrit": "ततो वैश्रवणं तत्र ददृशुर्नरवाहनम् ।\nपित्रा सार्धं समासीनमृद्ध्या परमया युतम् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2135914, "chapter_id": 3947, "verse_number": "१५", "content_sanskrit": "जातामर्षास्ततस्ते तु तपसे धृतनिश्चयाः ।\nब्रह्माणं तोषयामासुर्घोरेण तपसा तदा \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2135915, "chapter_id": 3947, "verse_number": "१६", "content_sanskrit": "अतिष्ठदेकपादेन सहस्रं परिवत्सरान् ।\nवायुभक्षो दशग्रीवः पञ्चाग्निः सुसमाहितः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2135916, "chapter_id": 3947, "verse_number": "१७", "content_sanskrit": "अधःशायी कुम्भकर्णो यताहारो यतव्रतः ।\nविभीषणः शीर्णपर्णमेकमभ्यवहारयन् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2135917, "chapter_id": 3947, "verse_number": "१८", "content_sanskrit": "उपवासरतिर्धीमान् सदा जप्यपरायणः ।\nतमेव कालमातिष्ठत् तीव्रं तप उदारधीः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2135918, "chapter_id": 3947, "verse_number": "१९", "content_sanskrit": "खरः शूर्पणखा चैव तेषां वै तप्यतां तपः ।\nपरिचर्यां च रक्षां च चक्रतुर्हृष्टमानसौ \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2135919, "chapter_id": 3947, "verse_number": "२०", "content_sanskrit": "विभीषणदशग्रीवौ तेपाते उत्तमं तपः ।\nपूर्णे वर्षसहस्रे तु शिरश्छित्त्वा दशाननः ।\nजुहोत्यग्नौ दुराधर्षस्तेनातुष्यज्जगत् प्रभुः \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2135920, "chapter_id": 3947, "verse_number": "२१", "content_sanskrit": "ततो ब्रह्मा स्वयं गत्वा तपसस्तान्न्यवारयत् ।\nप्रलोभ्य वरदानेन सर्वानेव पृथक्पृथक् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2135921, "chapter_id": 3947, "verse_number": "", "content_sanskrit": "ब्रह्मा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2135922, "chapter_id": 3947, "verse_number": "२२", "content_sanskrit": "प्रीतोऽस्मि वो निवर्तध्वं वरान् वृणुत पुत्रकाः ।\nयद्यदिष्टमृते त्वेकममरत्वं तथास्तु तत् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2135923, "chapter_id": 3947, "verse_number": "२३", "content_sanskrit": "यद्यदग्नौ हुतं सर्वं शिरस्ते महदीप्सया ।\nतथैव तानि ते देहे भविष्यन्ति यथेप्सया \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2135924, "chapter_id": 3947, "verse_number": "२४", "content_sanskrit": "वैरूप्यं च न ते देहे कामरूपधरस्तथा ।\nभविष्यसि रणेऽरीणां विजेता न च संशयः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2135925, "chapter_id": 3947, "verse_number": "", "content_sanskrit": "रावणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2135926, "chapter_id": 3947, "verse_number": "२५", "content_sanskrit": "गन्धर्वदेवासुरतो यक्षराक्षसतस्तथा ।\nसर्पकिन्नरभूतेभ्यो न मे भूयात्पराभवः \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2135927, "chapter_id": 3947, "verse_number": "", "content_sanskrit": "ब्रह्मा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2135928, "chapter_id": 3947, "verse_number": "२६", "content_sanskrit": "य एते कीर्तिताः सर्वे न तेभ्योऽस्ति भयं तव ।\nऋते मनुष्याद् भद्रं ते तथा तद् विहितं मया \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2135929, "chapter_id": 3947, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2135930, "chapter_id": 3947, "verse_number": "२७", "content_sanskrit": "एवमुक्तो दशग्रीवस्तुष्टः समभवत् तदा ।\nअवमेने हि दुर्बुद्धिर्मनुष्यान् पुरुषादकः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2135931, "chapter_id": 3947, "verse_number": "२८", "content_sanskrit": "कुम्भकर्णमथोवाच तथैव प्रपितामहः ।\nवरं वृणीष्व भद्रं ते प्रीतोऽस्मीति पुनः पुनः \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2135932, "chapter_id": 3947, "verse_number": "२९", "content_sanskrit": "स वव्रे महतीं निद्रां तमसा ग्रस्तचेतनः।\nतथा भविष्यतीत्युक्त्वा विभीषणमुवाच ह ।\nवरं वृष्णीष्व पुत्र त्वं प्रीतोऽस्मीति पुनः पुनः \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2135933, "chapter_id": 3947, "verse_number": "", "content_sanskrit": "विभीषणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2135934, "chapter_id": 3947, "verse_number": "३०", "content_sanskrit": "परमापद्गतस्यापि नाधर्मे मे मतिर्भवेत् ।\nअशिक्षितं च भगवन् ब्रह्मास्त्रं प्रतिभातु मे \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2135935, "chapter_id": 3947, "verse_number": "", "content_sanskrit": "ब्रह्मा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2135936, "chapter_id": 3947, "verse_number": "३१", "content_sanskrit": "यस्माद् राक्षसयोनौ ते जातस्यामित्रकर्शन ।\nनाधर्मे धीयते बुद्धिरमरत्वं ददामि ते\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2135937, "chapter_id": 3947, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2135938, "chapter_id": 3947, "verse_number": "३२", "content_sanskrit": "राक्षसस्तु वरं लब्ध्वा दशग्रीवो विशाम्पते ।\nलङ्कायाश्च्यावयामास युधि जित्वा धनेश्वरम् \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2135939, "chapter_id": 3947, "verse_number": "३३", "content_sanskrit": "हित्वा स भगवाँल्लङ्कामाविशद् गन्धमादनम् ।\nगन्धर्वयक्षानुगतो रक्षः किम्पुरुषैः सह \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2135940, "chapter_id": 3947, "verse_number": "३४", "content_sanskrit": "विमानं पुष्पकं तस्य जहाराक्रम्य रावणः ।\nशशाप तं वैश्रवणो न त्वामेतद् वहिष्यति \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2135941, "chapter_id": 3947, "verse_number": "३५", "content_sanskrit": "यस्तु त्वां समरे हन्ता तमेवैतद् वहिष्यति ।\nअवमन्य गुरुं मां च क्षिप्रं त्वं न भविष्यसि \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2135942, "chapter_id": 3947, "verse_number": "३६", "content_sanskrit": "विभीषणस्तु धर्मात्मा सतां धर्ममनुस्मरन् ।\nअन्वगच्छन् महाराज श्रिया परमया युतः \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2135943, "chapter_id": 3947, "verse_number": "३७", "content_sanskrit": "तस्मै स भगवांस्तुष्टो भ्राता भ्रात्रे धनेश्वरः।\nसैनापत्यं ददौ धीमान् यक्षराक्षससेनयोः \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2135944, "chapter_id": 3947, "verse_number": "३८", "content_sanskrit": "राक्षसाः पुरुषादाश्च पिशाचाश्च महाबलाः ।\nसर्वे समेत्य राजानमभ्यषिञ्चन् दशाननम् \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2135945, "chapter_id": 3947, "verse_number": "३९", "content_sanskrit": "दशग्रीवश्च दैत्यानां देवानां च बलोत्कटः ।\nआक्रम्य रत्नान्यहरत् कामरूपी विहङ्गमः \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2135946, "chapter_id": 3947, "verse_number": "४०", "content_sanskrit": "रावयामास लोकान् यत् तस्माद् रावण उच्यते ।\nदशग्रीवः कामबलो देवानां भयमादधत् \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2135947, "chapter_id": 3947, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि रामोपाख्यानपर्वणि त्रिषष्ट्यधिकद्विशततमोऽध्यायः ॥२६३॥\nरामोपाख्यानपर्वणि तृतीयोऽध्यायः ॥३॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]