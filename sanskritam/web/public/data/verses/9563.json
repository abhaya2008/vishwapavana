[{"id": 5000563000, "chapter_id": 9563, "verse_number": "७-२८-१", "content_sanskrit": "सुमालिनं हतं दृष्ट्वा वसुना भस्मसात्कृतम् ।\nस्वसैन्यं विद्रुतं चापि लक्षयित्वा ऽर्दितं सुरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000563001, "chapter_id": 9563, "verse_number": "७-२८-२", "content_sanskrit": "ततः स बलवान्क्रुद्धो रावणस्य सुतस्तदा ।\nनिवर्त्य राक्षसान्सर्वान्मेघनादो व्यवस्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000563002, "chapter_id": 9563, "verse_number": "७-२८-३", "content_sanskrit": "सुरथेनाग्निवर्णेन कामगेन महारथः ।\nअभिदुद्राव सेनां तां वनान्यग्निरिव ज्वलन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000563003, "chapter_id": 9563, "verse_number": "७-२८-४", "content_sanskrit": "ततः प्रविशतस्तस्य विविधायुधधारिणः ।\nविदुद्रुवुर्दिशः सर्वा दर्शनादेव देवताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000563004, "chapter_id": 9563, "verse_number": "७-२८-५", "content_sanskrit": "न बभूव तदा कश्चिद्युयुत्सोरस्य सम्मुखे ।\nसर्वानाविद्ध्य वित्रस्तांस्ततः शक्रो ऽब्रवीत्सुरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000563005, "chapter_id": 9563, "verse_number": "७-२८-६", "content_sanskrit": "न भेतव्यं न गन्तव्यं निवर्तध्वं रणे सुराः ।\nएष गच्छति पुत्रो मे युद्धार्थमपराजितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000563006, "chapter_id": 9563, "verse_number": "७-२८-७", "content_sanskrit": "ततः शक्रसुतो देवो जयन्त इति विश्रुतः ।\nरथेनाद्भुतकल्पेन सङ्ग्रामे सो ऽभ्यवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000563007, "chapter_id": 9563, "verse_number": "७-२८-८", "content_sanskrit": "ततस्ते त्रिदशाः सर्वे परिवार्य शचीसुतम् ।\nरावणस्य सुतं युद्धे समासाद्य प्रजघ्निरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000563008, "chapter_id": 9563, "verse_number": "७-२८-९", "content_sanskrit": "तेषां युद्धं समभवत्सदृशं देवरक्षसाम् ।\nमहेन्द्रस्य च पुत्रस्य राक्षसेन्द्रसुतस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000563009, "chapter_id": 9563, "verse_number": "७-२८-१०", "content_sanskrit": "ततो मातलिपुत्रे तु गोमुखे राक्षसात्मजः ।\nसारथौ पातयामास शरान्कनकभूषणान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000563010, "chapter_id": 9563, "verse_number": "७-२८-११", "content_sanskrit": "शचीसुतश्चापि तथा जयन्तस्तस्य सारथिम् ।\nतं चापि रावणिः क्रुद्धः समन्तात्प्रत्यविध्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000563011, "chapter_id": 9563, "verse_number": "७-२८-१२", "content_sanskrit": "स हि क्रोधसमाविष्टो बली विस्फारितेक्षणः ।\nरावणिः शक्रतनयं शरवर्षैरवाकिरत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000563012, "chapter_id": 9563, "verse_number": "७-२८-१३", "content_sanskrit": "ततो नानाप्रहरणाञ्छितधारान्सहस्रशः ।\nपातयामास सङ्क्रुद्धः सुरसैन्येषु रावणिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000563013, "chapter_id": 9563, "verse_number": "७-२८-१४", "content_sanskrit": "शतघ्नीमुसलप्रासगदाखड्गपरश्वधान् ।\nमहान्ति गिरिशृङ्गाणि पातयामास रावणिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000563014, "chapter_id": 9563, "verse_number": "७-२८-१५", "content_sanskrit": "ततः प्रव्यथिता लोकाः सञ्जज्ञे च तमो ऽभवत् ।\nतस्य रावणपुत्रस्य शत्रुसैन्यानि निघ्नतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000563015, "chapter_id": 9563, "verse_number": "७-२८-१६", "content_sanskrit": "ततस्तद्दैवतबलं समन्तात्तं शचीसुतम् ।\nबहुप्रकारमस्वस्थमभवच्छरपीडितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000563016, "chapter_id": 9563, "verse_number": "७-२८-१७", "content_sanskrit": "नाभ्यजानन्त चान्योन्यं रक्षो वा देवता ऽथवा ।\nतत्र तत्र विपर्यस्तं समन्तात्परिधावति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000563017, "chapter_id": 9563, "verse_number": "७-२८-१८", "content_sanskrit": "देवा देवान्निजघ्नुस्ते राक्षसान्राक्षसास्तथा ।\nसम्मूढास्तमसाच्छन्ना व्यद्रवन्नपरे तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000563018, "chapter_id": 9563, "verse_number": "७-२८-१९", "content_sanskrit": "एतस्मिन्नन्तरे वीरः पुलोमा नाम वीर्यवान् ।\nदैत्येन्द्रस्तेन सङ्गृह्य शचीपुत्रो ऽपवाहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000563019, "chapter_id": 9563, "verse_number": "७-२८-२०", "content_sanskrit": "सङ्गृह्य तं तु दौहित्रं प्रविष्टः सागरं तदा ।\nआर्यकः स हि तस्यासीत्पुलोमा येन सा शची ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000563020, "chapter_id": 9563, "verse_number": "७-२८-२१", "content_sanskrit": "ज्ञात्वा प्रणाशं तु तदा जयन्तस्याथ देवताः ।\nअप्रहृष्टास्ततः सर्वा व्यथिताः सम्प्रदुद्रुवुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000563021, "chapter_id": 9563, "verse_number": "७-२८-२२", "content_sanskrit": "रावणिस्त्वथ सङ्क्रुद्धो बलैः परिवृतः स्वकैः ।\nअभ्यधावत देवांस्तान्मुमोच च महास्वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000563022, "chapter_id": 9563, "verse_number": "७-२८-२३", "content_sanskrit": "दृष्ट्वा प्रणाशं पुत्रस्य दैवतेषु च विद्रुतम् ।\nमातलिं चाह देवेशो रथः समुपनीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000563023, "chapter_id": 9563, "verse_number": "७-२८-२४", "content_sanskrit": "स तु दिव्यो महाभीमः सज्ज एव महारथः ।\nउपस्थितो मातलिना वाह्यमानो महाजवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000563024, "chapter_id": 9563, "verse_number": "७-२८-२५", "content_sanskrit": "ततो मेघा रथे तस्मिंस्तडित्त्वन्तो महाबलाः ।\nअग्रतो वायुचपला नेदुः परमनिःस्वनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000563025, "chapter_id": 9563, "verse_number": "७-२८-२६", "content_sanskrit": "नानावाद्यानि वाद्यन्त गन्धर्वाश्च समाहिताः ।\nननृतुश्चाप्सरःसङ्घा निर्याते त्रिदशेश्वरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000563026, "chapter_id": 9563, "verse_number": "७-२८-२७", "content_sanskrit": "रुद्रैर्वसुभिरादित्यैस्साध्यैश्च समरुद्गणैः ।\nवृतो नानाप्रहरणैर्निर्ययौ त्रिदशाधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000563027, "chapter_id": 9563, "verse_number": "७-२८-२८", "content_sanskrit": "निर्गच्छतस्तु शक्रस्य परुषं पवनो ववौ ।\nभास्करो निष्प्रभश्चासीन्महोल्काश्च प्रपेदिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000563028, "chapter_id": 9563, "verse_number": "७-२८-२९", "content_sanskrit": "एतस्मिन्नन्तरे शूरो दशग्रीवः प्रतापवान् ।\nआरुरोह रथं दिव्यं निर्मितं विश्वकर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000563029, "chapter_id": 9563, "verse_number": "७-२८-३०", "content_sanskrit": "पन्नगैः सुमहाकार्यैर्वेष्टितं रोमहर्षणैः ।\nतेषां निःश्वासवातेन प्रदीप्तमिव संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000563030, "chapter_id": 9563, "verse_number": "७-२८-३१", "content_sanskrit": "दैत्यैर्निशाचरैश्चैव स रथः परिवारितः ।\nसमराभिमुखो दैत्यो महेन्द्रं सो ऽभ्यवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000563031, "chapter_id": 9563, "verse_number": "७-२८-३२", "content_sanskrit": "पुत्रं तं वारयित्वा तु स्वयमेव व्यवस्थितः ।\nसो ऽपि युद्धाद्विनिष्क्रम्य रावणिः समुपाविशत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000563032, "chapter_id": 9563, "verse_number": "७-२८-३३", "content_sanskrit": "ततो युद्धं प्रवृत्तं तु सुराणां राक्षसैः सह ।\nशस्त्राणि वर्षतां घोरं मेघानामिव संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000563033, "chapter_id": 9563, "verse_number": "७-२८-३४", "content_sanskrit": "कुम्भकर्णस्तु दुष्टात्मा नानाप्रहरणोद्यतः ।\nनाज्ञायत तदा युद्धे सह केनाप्ययुध्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000563034, "chapter_id": 9563, "verse_number": "७-२८-३५", "content_sanskrit": "दन्तैः भुजाभ्यां पद्मां च शक्तितोमरसायकैः ।\nयेन केनैव संरब्धस्ताडयामास वै सुरान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000563035, "chapter_id": 9563, "verse_number": "७-२८-३६", "content_sanskrit": "ततो रुद्रैर्महाघोरैः सङ्गम्याथ निशाचरः ।\nप्रयुद्धस्तैश्च सङ्ग्रामे क्षतः शस्त्रैर्निरन्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000563036, "chapter_id": 9563, "verse_number": "७-२८-३७", "content_sanskrit": "बभौ शस्त्राचिततनुः कुम्भकर्णः क्षरन्नसृक् ।\nविद्युत्स्तनितनिर्घोषो धारवानिव तोयदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000563037, "chapter_id": 9563, "verse_number": "७-२८-३८", "content_sanskrit": "ततस्तद्राक्षसं सैन्यं प्रयुद्धं समरुद्गणैः ।\nरणे विद्रावितं सर्वं नानाप्रहरणैः शितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000563038, "chapter_id": 9563, "verse_number": "७-२८-३९", "content_sanskrit": "केचिद्विनिहताः कृत्ताश्चेष्टन्ति स्म महीतले ।\nवाहनेष्ववसक्ताश्च स्थिता एवापरे रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000563039, "chapter_id": 9563, "verse_number": "७-२८-४०", "content_sanskrit": "रथान्नागान्खरानुष्ट्रान्पन्नगांस्तुरगान् रणे ।\nशिंशुमारान्वराहांश्च पिशाचवदनान्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000563040, "chapter_id": 9563, "verse_number": "७-२८-४१", "content_sanskrit": "तान्समालिङ्ग्य बाहुभ्यां विष्टब्धाः केचिदुच्छ्रुताः ।\nदेवैस्तु शस्त्रसम्भिन्ना मम्रिरे च निशाचराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000563041, "chapter_id": 9563, "verse_number": "७-२८-४२", "content_sanskrit": "चित्रकर्म इवाभाति स तेषां रणसम्प्लवः ।\nनिहतानां प्रमत्तानां राक्षसानां महीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000563042, "chapter_id": 9563, "verse_number": "७-२८-४३", "content_sanskrit": "शोणितोदकनिष्पन्दकङ्कगृध्रसमाकुला ।\nप्रवृत्ता संयुगमुखे शस्त्रग्राहवती नदी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000563043, "chapter_id": 9563, "verse_number": "७-२८-४४", "content_sanskrit": "एतस्मिन्नन्तरे क्रुद्धो दशग्रीवः प्रतापवान् ।\nनिरीक्ष्य तद्बलं कृत्स्नं दैवतैर्विनिपातितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000563044, "chapter_id": 9563, "verse_number": "७-२८-४५", "content_sanskrit": "स तं प्रति विगाह्याशु प्रवृद्धं सैन्यसागरम् ।\nत्रिदशान्समरे निघ्नञ्छक्रमेवाभ्यवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000563045, "chapter_id": 9563, "verse_number": "७-२८-४६", "content_sanskrit": "आगाच्छक्रो महच्चापं विस्फार्य सुमहास्वनम् ।\nयस्य विस्फारघोषेण स्तनन्ति स्म दिशो दश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000563046, "chapter_id": 9563, "verse_number": "७-२८-४७", "content_sanskrit": "तद्विकृष्य महच्चापमिन्द्रो रावणमूर्धनि ।\nनिपातयामास शरान्पावकादित्यवर्चसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000563047, "chapter_id": 9563, "verse_number": "७-२८-४८", "content_sanskrit": "तथैव च महाबाहुर्दशग्रीवो व्यवस्थितः ।\nशक्रं कार्मुकविभ्रष्टैः शरवर्षैरवाकिरत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000563048, "chapter_id": 9563, "verse_number": "७-२८-४९", "content_sanskrit": "प्रयुध्यतोरथ तयोर्बाणवर्षैः समन्ततः ।\nन ज्ञायते तदा किञ्चित्सर्वं हि तमसा वृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000563049, "chapter_id": 9563, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे ऽष्टाविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]