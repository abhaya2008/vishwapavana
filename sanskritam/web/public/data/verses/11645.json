[{"id": 50019670, "chapter_id": 11645, "verse_number": "1", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50019671, "chapter_id": 11645, "verse_number": "2", "content_sanskrit": "तत्र दुर्योधनो मानी परीतो भ्रातृभिः प्रियैः। किरीटमाली न्यविशदसिहस्तः क्षिपन् रुचा॥ १०/८४/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50019672, "chapter_id": 11645, "verse_number": "3", "content_sanskrit": "स्थलेऽप्यगृह्णाद् वस्त्रान्तं हरिनीलोपलाचिते। स्वच्छां पुष्करिणीं मत्वा सर्वे तं जहसुर्जनाः॥ १०/८४/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50019673, "chapter_id": 11645, "verse_number": "4", "content_sanskrit": "आगच्छन्नेवमुर्वीशः पुरः पुष्करिणीं क्वचित्। विलोक्य स्फाटिकां भूमिं मन्वानो न्यपतज्जले॥ १०/८४/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50019674, "chapter_id": 11645, "verse_number": "5", "content_sanskrit": "जहास भीमस्तं दृष्ट्वा स्त्रियो भूपाश्च केचन। निवार्यमाणा अप्यङ्ग राज्ञा कृष्णानुमोदिताः॥ १०/८४/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50019675, "chapter_id": 11645, "verse_number": "6", "content_sanskrit": "अजातशत्रुराकर्ण्य वस्त्रस्रग्भूषणादिकम्। सम्प्रेष्याह्वापयामास साम्ना योगेश्वरेण च॥ १०/८४/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50019676, "chapter_id": 11645, "verse_number": "7", "content_sanskrit": "तदनादृत्य सत्कारं व्रीळावनतकन्धरः। जाज्वल्यमानहृदयो न जगाम तदन्तिकम्॥ १०/८४/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50019677, "chapter_id": 11645, "verse_number": "8", "content_sanskrit": "स व्रीळितोऽवाग्वदनो रुषा ज्वलन् निष्क्रम्य तूष्णीं प्रययौ गजाह्वयम्। हाहेति शब्दः सुमहानभूत् सतामजातशत्रुर्विमना इवाभवत्॥ १०/८४/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50019678, "chapter_id": 11645, "verse_number": "9", "content_sanskrit": "बभूव तूष्णीं भगवान् भुवो भरं जिहीर्षुरात्मेहितमात्मनि स्मरन्। तदाऽऽविरासीज्जगदीशसन्निधौ मुनिः सुराराधितपादपङ्कजः॥ १०/८४/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50019679, "chapter_id": 11645, "verse_number": "10", "content_sanskrit": "उपेत्य नारदः सर्वैः सदस्यैः परिपूजितः। कृष्णेनाभ्यर्चितः सम्पगुपविष्टो नृपान्तिके॥ १०/८४/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50019680, "chapter_id": 11645, "verse_number": "11", "content_sanskrit": "उवाच धर्मराजस्तं प्रणिपत्य यथाविधि। भवान् सर्वत्रगो ब्रह्मन् सर्वकालेष्वसङ्गतः॥ १०/८४/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50019681, "chapter_id": 11645, "verse_number": "12", "content_sanskrit": "नृपाणां शौर्ययुक्तानां सर्वमण्डलवासिनाम्। इदानीं कतमः शूरो नित्योद्योगेन वर्तते॥ १०/८४/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50019682, "chapter_id": 11645, "verse_number": "13", "content_sanskrit": "इति तेनोदितां वाणीमाकर्ण्य मुनिरब्रवीत्॥ १०/८४/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50019683, "chapter_id": 11645, "verse_number": "14", "content_sanskrit": "नारद उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50019684, "chapter_id": 11645, "verse_number": "15", "content_sanskrit": "भग्नदर्पा नृपाः सर्वे कृष्णेनाप्रतिमौजसा। वसन्ति विषये स्वेस्वे नष्टचेष्टा गतश्रियः॥ १०/८४/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50019685, "chapter_id": 11645, "verse_number": "16", "content_sanskrit": "एक एव महोत्साहः क्षत्रियाणां दुराग्रही। जातः साल्वेषु नृपतिर्बहुपादातिवाहनः॥ १०/८४/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50019686, "chapter_id": 11645, "verse_number": "17", "content_sanskrit": "भ्रातर्युपरते युद्धे विष्णुना लोकजिष्णुना। ब्रह्मदत्तसुते हंसे यमुनायां महात्मना॥ १०/८४/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50019687, "chapter_id": 11645, "verse_number": "18", "content_sanskrit": "कृष्णद्विडेत्य राज्ञोऽसौ रुग्म्यादीन् कुण्डिने पुरे। समाजं कारयामास भ्रातुरानृण्यकाङ्क्ष्या॥ १०/८४/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50019688, "chapter_id": 11645, "verse_number": "19", "content_sanskrit": "शिशुपालद्रुममुखैर्दन्तवक्रपुरःसरैः। पराजितेषु सङ्ग्रामे जरासन्धादिषु प्रभो॥ १०/८४/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50019689, "chapter_id": 11645, "verse_number": "20", "content_sanskrit": "साल्वः प्रतिज्ञामकरोच्छृण्वतां सर्वभूभुजाम्। अयादवीं क्ष्मां करिष्ये पश्यन्तु मम पौरुषम्॥ १०/८४/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50019690, "chapter_id": 11645, "verse_number": "21", "content_sanskrit": "इति मूढः प्रतिज्ञाय तपसे प्राविशद् वनम्। गते तस्मिन् बहून् वर्षान् प्रतीक्ष्य तदुपागमम्॥ १०/८४/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50019691, "chapter_id": 11645, "verse_number": "22", "content_sanskrit": "तदनन्तरजोऽमात्यैरभिषिक्तो नृपार्थिभिः। तपस्तप्त्वा स नृपतिर्देवं पशुपतिं प्रभुम्॥ १०/८४/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50019692, "chapter_id": 11645, "verse_number": "23", "content_sanskrit": "आराधयामास वने पांसुमुष्टिं सकृद् ग्रसन्। संवत्सरान्ते भगवान् सन्तुष्टस्तमुमापतिः॥ १०/८४/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50019693, "chapter_id": 11645, "verse_number": "24", "content_sanskrit": "वरेण च्छन्दयामास साल्वं शरणमागतम्। देवासुरमनुष्याणां गन्धर्वोरगरक्षसाम्॥ १०/८४/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50019694, "chapter_id": 11645, "verse_number": "25", "content_sanskrit": "अभेद्यं कामगं वव्रे स यानं वृष्णिभीषणम्। तथेति गिरिशादिष्टो मयः परपुरञ्जयः॥ १०/८४/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 50019695, "chapter_id": 11645, "verse_number": "26", "content_sanskrit": "पुरं निर्माय साल्वाय प्रादात् सौभमयस्मयम्। स लब्ध्वा कामगं यानं तमोधाम दुरासदम्॥ १०/८४/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 50019696, "chapter_id": 11645, "verse_number": "27", "content_sanskrit": "आययौ स्वं जनपदं समग्रबलवाहनम्। इदानीं राजपुत्राणां स एवोद्योगवान् नृप॥ १०/८४/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 50019697, "chapter_id": 11645, "verse_number": "28", "content_sanskrit": "इति धर्मसुतः श्रीमान् श्रुत्वा तन्नारदोदितम्। पार्श्वे भगवतः शौरेः शनैर्मुखमवैक्षत॥ १०/८४/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 50019698, "chapter_id": 11645, "verse_number": "29", "content_sanskrit": "निशम्य तद् वासुदेवो धैर्यसारो निराकुलः। किञ्चित् प्रहस्यास्तु नामेत्याह सा हि महात्मता॥ १०/८४/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 50019699, "chapter_id": 11645, "verse_number": "30", "content_sanskrit": "पूजयित्वा ऋषिं सम्यक् सूनृतैर्गीर्भिरच्युतः। चिराभिलषितः सोऽपि प्राप्तः साध्वित्यचिन्तयत्॥ १०/८४/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 50019700, "chapter_id": 11645, "verse_number": "31", "content_sanskrit": "उग्रसेनं यदुपतिं युयुधानं च माधवः। अक्रूरं कृतवर्माणमन्यांश्च यदुपुङ्गवान्॥ १०/८४/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 50019701, "chapter_id": 11645, "verse_number": "32", "content_sanskrit": "प्रेषयामास रक्षायै द्वारवत्याः स्वसैनिकान्॥ १०/८४/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 50019702, "chapter_id": 11645, "verse_number": "33", "content_sanskrit": "इति श्रीमद्भागवते दशमस्कन्धे चतुरशीतितमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]