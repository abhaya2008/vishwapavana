[{"id": 2041645, "chapter_id": 1925, "verse_number": "५-१७०-०x", "content_sanskrit": "भीष्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2041646, "chapter_id": 1925, "verse_number": "५-१७०-१", "content_sanskrit": "द्रौपदेया महाराज सर्वे पञ्च महारथाः ।\nवैराटिरुत्तरश्चैव रथोदारो मतो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2041647, "chapter_id": 1925, "verse_number": "५-१७०-२", "content_sanskrit": "अभिमन्युर्महाबाहू रथयूथमयूथपः ।\nसमः पार्थेन समरे वासुदेवेन चारिहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2041648, "chapter_id": 1925, "verse_number": "५-१७०-३", "content_sanskrit": "लघ्वस्त्रश्चित्रयोधी च मनस्वी च दृढव्रतः ।\nसंस्मरन्वै परिक्लेशं स्वपितुर्विक्रमिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2041649, "chapter_id": 1925, "verse_number": "५-१७०-४", "content_sanskrit": "सात्यकिर्माधवः शूरो रथयूथपयूथपः।\nएष वृष्णिप्रवीराणाममर्षी जितसाध्वसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2041650, "chapter_id": 1925, "verse_number": "५-१७०-५", "content_sanskrit": "उत्तमौजास्तथा राजन्रथोदारो मतो मम ।\nयुधामन्युश्च विक्रान्तो रथोदारो मतो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2041651, "chapter_id": 1925, "verse_number": "५-१७०-६", "content_sanskrit": "एतेषां बहुसाहस्रा रथा नागा हयास्तथा ।\nयोत्स्यन्ते ते तनूस्त्यक्त्वा कुन्तीपुत्रप्रियेप्सया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2041652, "chapter_id": 1925, "verse_number": "५-१७०-७", "content_sanskrit": "पाण्डवैः सह राजेन्द्र तव सेनासु भारत।\nअग्निमारुतवद्राजन्नाह्वयन्तः परस्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2041653, "chapter_id": 1925, "verse_number": "५-१७०-८", "content_sanskrit": "अजेयौ समरे वृद्धौ विराटद्रुपदौ तथा।\nमहारथौ महावीर्यौ मतौ मे पुरुषर्षभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2041654, "chapter_id": 1925, "verse_number": "५-१७०-९", "content_sanskrit": "वयोवृद्धावपि हि तौ क्षत्रधर्मपरायणौ ।\nयतिष्येते परं शक्त्या स्थितौ वीरगते पथि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2041655, "chapter_id": 1925, "verse_number": "५-१७०-१०", "content_sanskrit": "संबन्धिकेन राजेन्द्र तौ तु वीर्यबलान्वयात् ।\nआर्यवृत्तौ महेष्वासौ स्नेहवीर्यसितावुभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2041656, "chapter_id": 1925, "verse_number": "५-१७०-११", "content_sanskrit": "कारणं प्राप्य तु नराः सर्व एव महाभुजाः ।\nशूरा वा कातरा वापि भवन्ति कुरुपुङ्गव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2041657, "chapter_id": 1925, "verse_number": "५-१७०-१२", "content_sanskrit": "एकायनगतावेतौ पार्थिवौ दृढधन्विनौ ।\nप्राणांस्त्यक्त्वा परं शक्त्या घट्टितारौ परन्तप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2041658, "chapter_id": 1925, "verse_number": "५-१७०-१३", "content_sanskrit": "पृथगक्षौहिणीभ्यां तावुभौ संयति दारुणौ ।\nसंबन्धिभावं रक्षन्तौ महत्कर्म करिष्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2041659, "chapter_id": 1925, "verse_number": "५-१७०-१४", "content_sanskrit": "लोकवीरौ महेष्वासौ त्यक्तात्मानौ च भारत।\nप्रत्ययं परिरक्षन्तौ महत्कर्म करिष्यतः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2041660, "chapter_id": 1925, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि रथातिरथसंख्यानपर्वणि सप्तत्यधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]