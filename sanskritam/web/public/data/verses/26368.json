[{"id": 7006368000, "chapter_id": 26368, "verse_number": "२-२४-१", "content_sanskrit": "वैशम्पायन उवाच\nअन्धकस्य वचः श्रुत्वा कंसः संरक्तलोचनः ।\nन किंचिदब्रवीत् क्रोधाद् विवेश स्वं निकेतनम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006368001, "chapter_id": 26368, "verse_number": "२-२४-२", "content_sanskrit": "ते च सर्वे यथावेश्म यादवाः श्रुतविस्तराः ।\nजग्मुर्विगतसंकल्पाः कंसवैकृतशंसिनः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006368002, "chapter_id": 26368, "verse_number": "२-२४-३", "content_sanskrit": "अक्रूरोऽपि यथाऽऽज्ञप्तः कृष्णदर्शनलालसः ।\nजगाम रथमुख्येन मनसा तुल्यगामिना ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006368003, "chapter_id": 26368, "verse_number": "२-२४-४", "content_sanskrit": "कृष्णस्यापि निमित्तानि शुभान्यङ्गगतानि वै ।\nपितृतुल्येन शंसन्ति बान्धवेन समागमम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006368004, "chapter_id": 26368, "verse_number": "२-२४-५", "content_sanskrit": "प्रागेव च नरेन्द्रेण माथुरेणौग्रसेनिना ।\nकेशिनः प्रेषितो दूतो वधायोपेन्द्रकारणात् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006368005, "chapter_id": 26368, "verse_number": "२-२४-६", "content_sanskrit": "स च दूतवचः श्रुत्वा केशी क्लेशकरो नृणाम् ।\nवृन्दावनगतो गोपान् बाधते स्म दुरासदः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006368006, "chapter_id": 26368, "verse_number": "२-२४-७", "content_sanskrit": "मानुषं मांसमश्नानः क्रुद्धो दुष्टपराक्रमः ।\nदुर्दान्तो वाजिदैत्योऽसावकरोत् कदनं महत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006368007, "chapter_id": 26368, "verse_number": "२-२४-८", "content_sanskrit": "निघ्नन् गा वै सगोपालान् गवां पिशितभोजनः ।\nदुर्मदः कामचारी च स केशी निरवग्रहः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006368008, "chapter_id": 26368, "verse_number": "२-२४-९", "content_sanskrit": "तदरण्यं श्मशानाभं नृणां मांसास्थिभिर्वृतम् ।\nयत्रास्ते स हि दुष्टात्मा केशी तुरगदानवः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006368009, "chapter_id": 26368, "verse_number": "२-२४-१०", "content_sanskrit": "खुरैर्दारयते भूमिं वेगेनारुजते द्रुमान् ।\nहेषितैः स्पर्द्धते वायुं प्लुतैर्लङ्घयते नभः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006368010, "chapter_id": 26368, "verse_number": "२-२४-११", "content_sanskrit": "अतिप्रवृद्धो मत्तश्च दुष्टोऽश्वो वनगोचरः ।\nआकम्पितसटो रौद्रः कंसस्य चरितानुगः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006368011, "chapter_id": 26368, "verse_number": "२-२४-१२", "content_sanskrit": "ईरिणं तद् वनं सर्वं तेनासीत् पापकर्मणा ।\nकृतं तुरगदैत्येन सर्वान् गोपाञ्जिघांसता ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006368012, "chapter_id": 26368, "verse_number": "२-२४-१३", "content_sanskrit": "तेन दुष्टप्रचारेण दूषितं तद् वनं महत् ।\nन नृभिर्गोधनैवापि सेव्यते वनवृत्तिभिः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006368013, "chapter_id": 26368, "verse_number": "२-२४-१४", "content_sanskrit": "निःसम्पातः कृतः पन्थास्तेन तद्विषयाश्रयः ।\nमदाच्चलितवृत्तेन नृमांसान्यश्नता भृशम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006368014, "chapter_id": 26368, "verse_number": "२-२४-१५", "content_sanskrit": "नृशब्दानुसरः क्रुद्धः स कदाचिद् वनागमे ।\nजगाम घोषसंवासं चोदितः कालधर्मणा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006368015, "chapter_id": 26368, "verse_number": "२-२४-१६", "content_sanskrit": "तं दृष्ट्वा दुद्रुवुर्गोपाः स्त्रियश्च शिशुभिः सह ।\nक्रन्दमाना जगन्नाथं कृष्णं नाथमुपाश्रिताः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006368016, "chapter_id": 26368, "verse_number": "२-२४-१७", "content_sanskrit": "तासां रुदितशब्देन गोपानां क्रन्दितेन च ।\nदत्त्वाभयं तु कृष्णो वै केशिनं सोऽभिदुद्रुवे ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006368017, "chapter_id": 26368, "verse_number": "२-२४-१८", "content_sanskrit": "केशी चाप्युन्नतग्रीवः प्रकाशदशनेक्षणः ।\nहेषमाणो जवोदग्रो गोविन्दाभिमुखो ययौ ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006368018, "chapter_id": 26368, "verse_number": "२-२४-१९", "content_sanskrit": "तमापतन्तं सम्प्रेक्ष्य केशिनं हयदानवम् ।\nप्रत्युज्जगाम गोविन्दस्तोयदः शशिनं यथा ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006368019, "chapter_id": 26368, "verse_number": "२-२४-२०", "content_sanskrit": "केशिनस्तु तमभ्याशे दृष्ट्वा कृष्णमवस्थितम् ।\nमनुष्यबुद्धयो गोपाः कृष्णमूचुर्हितैषिणः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006368020, "chapter_id": 26368, "verse_number": "२-२४-२१", "content_sanskrit": "कृष्ण तात न खल्वेष सहसा ते हयाधमः ।\nउपसर्प्यो भवान् बालः पापश्चैष दुरासदः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006368021, "chapter_id": 26368, "verse_number": "२-२४-२२", "content_sanskrit": "एष कंसस्य सहजः प्राणस्तात बहिश्चरः ।\nउत्तमश्च हयेन्द्राणां दानवोऽप्रतिमो युधि ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006368022, "chapter_id": 26368, "verse_number": "२-२४-२३", "content_sanskrit": "त्रासनः सर्वभूतानां तुरगाणां महाबलः ।\nअवध्यः सर्वभूतानां प्रथमः पापकर्मणाम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006368023, "chapter_id": 26368, "verse_number": "२-२४-२४", "content_sanskrit": "गोपानां तद् वचः श्रुत्वा वदतां मधुसूदनः ।\nकेशिना सह युद्धाय मतिं चक्रेऽरिसूदनः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006368024, "chapter_id": 26368, "verse_number": "२-२४-२५", "content_sanskrit": "ततः सव्यं दक्षिणं च मण्डलं स परिभ्रमन् ।\nपद्भ्यामुभाभ्यां स हयः क्रोधेनारुजते द्रुमान् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006368025, "chapter_id": 26368, "verse_number": "२-२४-२६", "content_sanskrit": "मुखे लम्बसटे चास्य स्कन्धे केशघनावृते ।\nवलयोऽभ्रतरङ्गाभाः सुस्रुवुः क्रोधजं जलम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006368026, "chapter_id": 26368, "verse_number": "२-२४-२७", "content_sanskrit": "स फेनं वक्त्रजं चैव ववर्ष रजसावृतम् ।\nहिमकाले यथा व्योम्नि नीहारमिव चन्द्रमाः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006368027, "chapter_id": 26368, "verse_number": "२-२४-२८", "content_sanskrit": "गोविन्दमरविन्दाक्षं हेषितोद्गारशीकरैः ।\nस फेनैर्वक्त्रनिर्गीर्णैः प्रोक्षयामास भारत ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006368028, "chapter_id": 26368, "verse_number": "२-२४-२९", "content_sanskrit": "खुरोद्धूतावसिक्तेन मधुकक्षोदपाण्डुना ।\nरजसा स हयः कृष्णं चकारारुणमूर्धजम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006368029, "chapter_id": 26368, "verse_number": "२-२४-३०", "content_sanskrit": "प्लुतवल्गितपादस्तु तक्षमाणो धरां खुरैः ।\nदन्तान् निर्दशमानस्तु केशी कृष्णमुपाद्रवत् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006368030, "chapter_id": 26368, "verse_number": "२-२४-३१", "content_sanskrit": "स संसक्तस्तु कृष्णेन केशी तुरगसत्तमः ।\nपूर्वाभ्यां चरणाभ्यां वै कृष्णं वक्षस्यताडयत् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006368031, "chapter_id": 26368, "verse_number": "२-२४-३२", "content_sanskrit": "पुनः पुनः स च बली प्राहिणोत्पार्श्वतः खुरान् ।\nकृष्णस्य दानवो घोरं प्रहारममितौजसः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006368032, "chapter_id": 26368, "verse_number": "२-२४-३३", "content_sanskrit": "वक्त्रेण चास्य घोरेण तीक्ष्णदंष्ट्रायुधेन वै ।\nअदशद् बाहुशिखरं कृष्णस्य रुषितो हयः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006368033, "chapter_id": 26368, "verse_number": "२-२४-३४", "content_sanskrit": "स लम्बकेसरसटः कृष्णेन सह सङ्गतः ।\nरराज केशी मेघेन संसक्तः ख इवांशुमान् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006368034, "chapter_id": 26368, "verse_number": "२-२४-३५", "content_sanskrit": "उरस्तस्योरसा हन्तुमियेष बलवान् हयः ।\nवेगेन वासुदेवस्य क्रोधाद् द्विगुणविक्रमः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006368035, "chapter_id": 26368, "verse_number": "२-२४-३६", "content_sanskrit": "तस्योत्सिक्तस्य बलवान् कृष्णोऽप्यमितविक्रमः ।\nबाहुमाभोगिनं कृत्वा मुखे क्रुद्धः समादधत् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006368036, "chapter_id": 26368, "verse_number": "२-२४-३७", "content_sanskrit": "स तं बाहुमशक्तो वै खादितुं भेत्तुमेव च ।\nदशनैर्मूलनिर्मुक्तैः सफेनं रुधिरं वमन् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006368037, "chapter_id": 26368, "verse_number": "२-२४-३८", "content_sanskrit": "विपाटिताभ्यामोष्ठाभ्यां कटाभ्यां विदलीकृतः ।\nअक्षिणी विवृते चक्रे विसृते मुक्तबन्धने ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006368038, "chapter_id": 26368, "verse_number": "२-२४-३९", "content_sanskrit": "निरस्तहनुराविष्टः शोणिताक्तविलोचनः ।\nउत्कर्णो नष्टचेतास्तु स केशी बह्वचेष्टत ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006368039, "chapter_id": 26368, "verse_number": "२-२४-४०", "content_sanskrit": "उत्पतन्नसकृत्पादैः शकृन्मूत्रं समुत्सृजन् ।\nखिन्नाङ्गरोमा श्रान्तस्तु निर्यत्नचरणोऽभवत् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006368040, "chapter_id": 26368, "verse_number": "२-२४-४१", "content_sanskrit": "केशिवक्त्रविलग्नस्तु कृष्णबाहुरशोभत ।\nव्याभुग्न इव घर्मान्ते चन्द्रार्धकिरणैर्घनः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006368041, "chapter_id": 26368, "verse_number": "२-२४-४२", "content_sanskrit": "केशी च कृष्णसंसक्तः शान्तगात्रो व्यरोचत ।\nप्रभातावनतश्चन्द्रः श्रान्तो मेरुमिवाश्रितः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006368042, "chapter_id": 26368, "verse_number": "२-२४-४३", "content_sanskrit": "तस्य कृष्णभुजोद्धूताः केशिनो दशना मुखात् ।\nपेतुः शरदि निस्तोयाः सिताभ्रावयवा इव ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006368043, "chapter_id": 26368, "verse_number": "२-२४-४४", "content_sanskrit": "स तु केशी भृशं शान्तः कृष्णेनाक्लिष्टकर्मणा ।\nस्वभुजं स्वायतं कृत्वा पाटितो बलवत्तदा ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006368044, "chapter_id": 26368, "verse_number": "२-२४-४५", "content_sanskrit": "स पाटितो भुजेनाजौ कृष्णेन विकृताननः ।\nकेशी नदन्महानादं दानवो व्यथितस्तदा ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006368045, "chapter_id": 26368, "verse_number": "२-२४-४६", "content_sanskrit": "विघूर्णमानस्त्रस्ताङ्गो मुखाद् रुधिरमुद्वमन् ।\nभृशं व्यङ्गीकृतवपुर्निकृत्तार्द्ध इवाचलः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006368046, "chapter_id": 26368, "verse_number": "२-२४-४७", "content_sanskrit": "व्यादितास्यो महारौद्रः सोऽसुरः कृष्णबाहुना ।\nनिपपात यथा कृत्तो नागो हि द्विदलीकृतः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006368047, "chapter_id": 26368, "verse_number": "२-२४-४८", "content_sanskrit": "बाहुना कृत्तदेहस्य केशिनो रूपमाबभौ ।\nपशोरिव महाघोरं निहतस्य पिनाकिना ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006368048, "chapter_id": 26368, "verse_number": "२-२४-४९", "content_sanskrit": "द्विपादपृष्ठपुच्छार्द्धे श्रवणैकाक्षिनासिके ।\nकेशिनस्तद्विधाभूते द्वे चार्धे रेजतुः क्षितौ ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006368049, "chapter_id": 26368, "verse_number": "२-२४-५०", "content_sanskrit": "केशिदन्तक्षतस्यापि कृष्णस्य शुशुभे भुजः ।\nवृद्धः साल इवारण्ये गजेन्द्रदशनाङ्कितः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006368050, "chapter_id": 26368, "verse_number": "२-२४-५१", "content_sanskrit": "तं हत्वा केशिनं युद्धे कल्पयित्वा च भागशः ।\nकृष्णः पद्मपलाशाक्षो हसंस्तत्रैव तस्थिवान् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006368051, "chapter_id": 26368, "verse_number": "२-२४-५२", "content_sanskrit": "तं हतं केशिनं दृष्ट्वा गोपा गोपस्त्रियस्तथा ।\nबभूवुर्मुदिताः सर्वे हतविघ्ना गतक्लमाः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006368052, "chapter_id": 26368, "verse_number": "२-२४-५३", "content_sanskrit": "दामोदरं तु श्रीमन्तं यथास्थानं यथावयः ।\nअभ्यनन्दन् प्रियैर्वाक्यैः पूजयन्तः पुनः पुनः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006368053, "chapter_id": 26368, "verse_number": "२-२४-५४", "content_sanskrit": "गोपा ऊचुः\nअहो तात कृतं कर्म हतोऽयं लोककण्टकः ।\nदैत्यः क्षितिचरः कृष्ण हयरूपं समास्थितः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006368054, "chapter_id": 26368, "verse_number": "२-२४-५५", "content_sanskrit": "कृतं वृन्दावनं क्षेमं सेव्यं नृमृगपक्षिणाम् ।\nघ्नता पापमिमं तात केशिनं हयदानवम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006368055, "chapter_id": 26368, "verse_number": "२-२४-५६", "content_sanskrit": "हता नो बहवो गोपा गावो वत्सेषु वत्सलाः ।\nनैके चान्ये जनपदा हतानेन दुरात्मना ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006368056, "chapter_id": 26368, "verse_number": "२-२४-५७", "content_sanskrit": "एष संवर्तकं कर्तुमुद्यतः खलु पापकृत् ।\nनृलोकं निर्नरं कृत्वा चर्तुकामो यथासुखम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006368057, "chapter_id": 26368, "verse_number": "२-२४-५८", "content_sanskrit": "नैतस्य प्रमुखे स्थातुं कश्चिच्छक्तो जिजीविषुः ।\nअपि देवसमूहेषु किं पुनः पृथिवीतले ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006368058, "chapter_id": 26368, "verse_number": "२-२४-५९", "content_sanskrit": "वैशम्पायन उवाच\nअथाहान्तर्हितो विप्रो नारदः खगमो मुनिः ।\nप्रीतोऽस्मि विष्णो देवेश कृष्ण कृष्णेति चाब्रवीत् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006368059, "chapter_id": 26368, "verse_number": "२-२४-६०", "content_sanskrit": "नारद उवाच\nयदिदं दुष्करं कर्म कृतं केशिजिघांसया ।\nत्वय्येव केवलं युक्तं त्रिदिवे त्र्यम्बकस्य वा ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006368060, "chapter_id": 26368, "verse_number": "२-२४-६१", "content_sanskrit": "अहं युद्धोत्सुकस्तात त्वद्गतेनान्तरात्मना ।\nइदं नरहयं युद्धं द्रष्टुं स्वर्गादिहागतः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006368061, "chapter_id": 26368, "verse_number": "२-२४-६२", "content_sanskrit": "पूतनानिधनादीनि कर्माणि तव दृष्टवान् ।\nअहं त्वनेन गोविन्द कर्मणा परितोषितः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006368062, "chapter_id": 26368, "verse_number": "२-२४-६३", "content_sanskrit": "हयादस्मान्महेन्द्रोऽपि बिभेति बलसूदनः ।\nकुर्वाणाच्च वपुर्घोरं केशिनो दुष्टचेतसः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006368063, "chapter_id": 26368, "verse_number": "२-२४-६४", "content_sanskrit": "यत्त्वया पाटितो देहो भुजेनायतपर्वणा ।\nएषोऽस्य मृत्युरन्ताय विहितो विश्वयोनिना ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006368064, "chapter_id": 26368, "verse_number": "२-२४-६५", "content_sanskrit": "यस्मात् त्वया हतः केशी तस्मान्मच्छासनं शृणु ।\nकेशवो नाम नाम्ना त्वं ख्यातो लोके भविष्यसि ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006368065, "chapter_id": 26368, "verse_number": "२-२४-६६", "content_sanskrit": "स्वस्त्यस्तु भवतो लोके साधु याम्यहमाशुगः ।\nकृत्यशेषं च ते कार्यं शक्तस्त्वमसि मा चिरम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006368066, "chapter_id": 26368, "verse_number": "२-२४-६७", "content_sanskrit": "त्वयि कार्यान्तरगते नरा इव दिवौकसः ।\nविडम्बयन्तः क्रीडन्ति लीलां त्वद्बलमाश्रिताः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006368067, "chapter_id": 26368, "verse_number": "२-२४-६८", "content_sanskrit": "अभ्याशे वर्तते कालो भारतस्याहवोदधेः ।\nहस्तप्राप्तानि युद्धानि रागं त्रिदिवगामिनाम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006368068, "chapter_id": 26368, "verse_number": "२-२४-६९", "content_sanskrit": "पन्थानः शोधिता व्योम्नि विमानारोहणोर्ध्वगाः ।\nअवकाशा विभज्यन्ते शक्रलोके महीक्षिताम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006368069, "chapter_id": 26368, "verse_number": "२-२४-७०", "content_sanskrit": "उग्रसेनसुते शान्ते पदस्थे त्वयि केशव ।\nअभितस्तन्महद् युद्धं भविष्यति महीक्षिताम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006368070, "chapter_id": 26368, "verse_number": "२-२४-७१", "content_sanskrit": "त्वां चाप्रतिमकर्माणं संश्रयिष्यन्ति पाण्डवाः ।\nभेदकाले नरेन्द्राणां पक्षग्राहो भविष्यसि ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006368071, "chapter_id": 26368, "verse_number": "२-२४-७२", "content_sanskrit": "त्वयि राजासनस्थे हि राजश्रियमनुत्तमाम् ।\nशुभां त्यक्ष्यन्ति राजानस्त्वत्प्रभावान्न संशयः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006368072, "chapter_id": 26368, "verse_number": "२-२४-७३", "content_sanskrit": "एष मे कृष्ण संदेशः श्रुतिभिः ख्यातिमेष्यति ।\nदेवतानां दिविस्थानां जगतश्च जगत्पते ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006368073, "chapter_id": 26368, "verse_number": "२-२४-७४", "content_sanskrit": "दृष्टं मे भवतः कर्म दृष्टश्चासि मया प्रभो ।\nकंसे भूयः समेष्यामि साधिते साधु याम्यहम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006368074, "chapter_id": 26368, "verse_number": "२-२४-७५", "content_sanskrit": "एवमुक्त्वा तु स तदा नारदः खं जगाम ह ।\nनारदस्य वचः श्रुत्वा देवसंगीतयोनिनः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006368075, "chapter_id": 26368, "verse_number": "२-२४-७६", "content_sanskrit": "तथेति स समाभाष्य पुनर्गोपान् समासदत् ।\nगोपाः कृष्णं समासाद्य विविशुर्व्रजमेव ह ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}]