[{"id": 2065155, "chapter_id": 2381, "verse_number": "८-१०१-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2065156, "chapter_id": 2381, "verse_number": "८-१०१-१", "content_sanskrit": "हते वैकर्तने कर्णे कुरवो भयपीडिताः।\nवीक्षमाणा दिशः सर्वाः पलायन्त सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2065157, "chapter_id": 2381, "verse_number": "८-१०१-२", "content_sanskrit": "रावणं निहतं दृष्ट्वा राक्षसा राघवेण वा।\nदिशो भीता द्रवन्नेव तावका भयपीडिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2065158, "chapter_id": 2381, "verse_number": "८-१०१-३", "content_sanskrit": "ततो महारवं चक्रुर्योधा राजन्समन्ततः।\nवार्यमाणा भृशोद्विग्नास्तव पुत्रेण भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2065159, "chapter_id": 2381, "verse_number": "८-१०१-४", "content_sanskrit": "तेषां तु मतमाज्ञाय पुत्रस्ते भरतर्षभ।\nअवहारं ततश्चक्रे शल्यस्यानुमतेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2065160, "chapter_id": 2381, "verse_number": "८-१०१-५", "content_sanskrit": "कृतवर्मा रणे तूर्णं वृतो भारत तावकैः।\nनारायणावशिष्टैश्च शिबिरायैव दुद्रुवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2065161, "chapter_id": 2381, "verse_number": "८-१०१-६", "content_sanskrit": "अश्वत्थामा ततः शूरो विनिश्वस्य मुहुर्मुहुः।\nपाण्डवानां जयं दृष्ट्वा शिबिरायैव दुद्रुवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2065162, "chapter_id": 2381, "verse_number": "८-१०१-७", "content_sanskrit": "कृपः शारद्वतो राजन्नागानीकेन भारत।\nमहता मेघकल्पेन शिबिरायैव दुद्रुवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2065163, "chapter_id": 2381, "verse_number": "८-१०१-८", "content_sanskrit": "गान्धाराणां सहस्रेण शकुनिः परिवारितः।\nसुशर्मा च ययौ राजन्वीक्षमाणो भयार्दितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2065164, "chapter_id": 2381, "verse_number": "८-१०१-९", "content_sanskrit": "दुर्योधनोऽपि स ययौ ह्वतसर्वस्व आतुरः।\nज्ञातिशोकसमापन्नश्चिन्तयित्वा मुहुर्मुहुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2065165, "chapter_id": 2381, "verse_number": "८-१०१-१०", "content_sanskrit": "छिन्नध्वजेन शल्यस्तु रथेन रथिनां वरः।\nप्रययौ शिबिरायैव वीक्षमाणो दिशो दश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2065166, "chapter_id": 2381, "verse_number": "८-१०१-११", "content_sanskrit": "ततोऽपरे सुबहुशो भारतानां महारथाः।\nव्यद्रवन्त दिशो भीता भयविह्वलचेतसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2065167, "chapter_id": 2381, "verse_number": "८-१०१-१२", "content_sanskrit": "अश्रूपूर्णा भयोद्विग्ना वेपमाना भयातुराः।\nकुरवः प्राद्रवन्सर्वे दृष्ट्वा कर्णं निपातितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2065168, "chapter_id": 2381, "verse_number": "८-१०१-१३", "content_sanskrit": "प्रशंसन्तोऽर्जुनं केचित्केचित्कर्णं महारथाः।\nप्राद्रवन्त रणे भीताः कुरवः कुरुसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2065169, "chapter_id": 2381, "verse_number": "८-१०१-१४", "content_sanskrit": "तेषां योधसहस्राणां तावकानां महामृधे।\nनासीत्तत्र पुमान्कश्चिद्यस्तु युद्धे मनो दधे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2065170, "chapter_id": 2381, "verse_number": "८-१०१-१५", "content_sanskrit": "कर्णे हते महाराज निराशाः कुरवोऽभवन्।\nजीवनेषु च राज्येषु दारेषु च धनेषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2065171, "chapter_id": 2381, "verse_number": "८-१०१-१६", "content_sanskrit": "तान्समानीय पुत्रस्ते यत्नेन महता विभो।\nनिवेशाय मनो दध्रे दुःखशोकसमन्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2065172, "chapter_id": 2381, "verse_number": "८-१०१-१७", "content_sanskrit": "तस्याज्ञां शिरसा दीनाः प्रतिगृह्य विशाम्पते।\nविषण्णमनसो भीत्या न्यविशन्त महारथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2065173, "chapter_id": 2381, "verse_number": "८-१०१-१८", "content_sanskrit": "चिन्तयन्तो वधं घोरं सूतपुत्रस्य संयुगे।\nअर्जुनस्य जयं युद्धे चिन्तयानाः पुनःपुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2065174, "chapter_id": 2381, "verse_number": "८-१०१-१९", "content_sanskrit": "पाण्डवाश्च महेष्वासा न्यविशन्त परन्तपाः।\nप्रहृष्टमनसः सर्वे जित्वा शत्रुं महारथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2065175, "chapter_id": 2381, "verse_number": "८-१०१-२०", "content_sanskrit": "ततो युधिष्ठिरं तत्र निविष्टं वै मुदान्वितम्।\nसमेत्य सर्वे पाञ्चाला वर्धयन्तो यथाविधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2065176, "chapter_id": 2381, "verse_number": "८-१०१-२१", "content_sanskrit": "अर्जुनस्तु रथात्तूर्णमवरुह्य महायशाः।\nधर्मराजस्य चरणौ पीडयामास हृष्टवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2065177, "chapter_id": 2381, "verse_number": "८-१०१-२२", "content_sanskrit": "तमुत्थाप्य महाराज धर्मपुत्रः प्रतापवान्।\nसस्वजे भरतश्रेष्ठमुपजिघ्रन्नुपस्पृशन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2065178, "chapter_id": 2381, "verse_number": "८-१०१-२३", "content_sanskrit": "नकुलः सहदेवश्च पाण्डवश्च वृकोदरः।\nअभिवाद्य महाराजमस्वजन्त स्म फल्गुनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2065179, "chapter_id": 2381, "verse_number": "८-१०१-२४", "content_sanskrit": "धृष्टद्युम्नः शिखण्डी च पाण्डवानां च ये रथाः।\nवर्धयन्ते स्म राजानं निहते सूतनन्दने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2065180, "chapter_id": 2381, "verse_number": "८-१०१-२५", "content_sanskrit": "ततः कृष्णो महाराज सात्यकिश्चापि सात्वतः।\nवर्धयन्ते स्म राजानं निहते सूतनन्दने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2065181, "chapter_id": 2381, "verse_number": "८-१०१-२६", "content_sanskrit": "वासुदेवश्च कौन्तेयं प्रणयादिदमब्रवीत्।\nअद्य राजन्हताः सर्वे धार्तराष्ट्राः सराजकाः।\nहते वैकर्तने कर्णे रथानां प्रवरे रथे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2065182, "chapter_id": 2381, "verse_number": "८-१०१-२७", "content_sanskrit": "यदि लोकास्त्रयः सर्वे योधयेयुः सवासवाः।\nतथापि दुर्जयः सूतस्तव कोपात्तु सूदितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2065183, "chapter_id": 2381, "verse_number": "८-१०१-२८", "content_sanskrit": "एवमुक्तः प्रत्युवाच धर्मराजो जनार्दनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2065184, "chapter_id": 2381, "verse_number": "८-१०१-२९", "content_sanskrit": "तव प्रसादाद्ग्रोविन्द हतः कर्णो महायशाः।\nपाण्डवाश्च जयं प्राप्या नाशिताश्चापि शत्रवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2065185, "chapter_id": 2381, "verse_number": "८-१०१-३०", "content_sanskrit": "त्वं हि शक्तो भयात्त्रातुं यस्य कस्यचिदाहवे।\nत्वमस्य जगतो गोप्ता पाण्डवानां च सर्वदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2065186, "chapter_id": 2381, "verse_number": "८-१०१-३१", "content_sanskrit": "त्वां समासाद्य शक्रोऽपि मोदते दिवि नित्यशः।\nत्वं पाता पाण्डुपुत्राणां यथैव जगतस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2065187, "chapter_id": 2381, "verse_number": "८-१०१-३२", "content_sanskrit": "अनाश्चर्यो जयस्तेषां भक्तिर्येषां त्वयि प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2065188, "chapter_id": 2381, "verse_number": "८-१०१-३३", "content_sanskrit": "त्वया नाथेन गोविन्द नाथवन्तो वयं युधि।\nयथेन्द्रेण पुरा देवास्त्वया चापि जनार्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2065189, "chapter_id": 2381, "verse_number": "८-१०१-३४", "content_sanskrit": "स्वप्स्याम्यद्य सुखं कृष्णनिद्रां लप्स्ये त्वहं क्षपाम्।\nविगतं हि भयं मेऽद्य त्वत्प्रसादान्न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2065190, "chapter_id": 2381, "verse_number": "८-१०१-३५", "content_sanskrit": "एवमुक्तस्तु पार्थेन केशवः प्राह पाण्डवम्।\nनिमित्तमात्रं हि वयं तवाप्यस्मिन्मुदागमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2065191, "chapter_id": 2381, "verse_number": "८-१०१-३६", "content_sanskrit": "यस्य ते भ्रातरः शूरा भीमसेनादयो नृप।\nसम्बन्धिनश्चेन्द्रवीर्याः पार्षतप्रमुखास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2065192, "chapter_id": 2381, "verse_number": "८-१०१-३७", "content_sanskrit": "अर्हते च भवान्नित्यं प्रियं नित्यं च मद्वितम्।\nप्रियो हि मे त्वमेतेन वचनेन नरोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2065193, "chapter_id": 2381, "verse_number": "८-१०१-३८", "content_sanskrit": "इत्युक्तो धर्मराजस्तु स्वरथं हेमभूपितम्।\nदन्तवर्णैर्हयैर्युक्तं कालवालैर्महीपतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2065194, "chapter_id": 2381, "verse_number": "८-१०१-३९", "content_sanskrit": "आस्थाय पुरुषव्याघ्रः स्वबलेनापि संवृतः।\nप्रययौ बहुवृत्तान्तं द्रष्टुमायोधनं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2065195, "chapter_id": 2381, "verse_number": "८-१०१-४०", "content_sanskrit": "सम्भाषमाणौ तौ वीर उभौ माधवपाण्डवौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2065196, "chapter_id": 2381, "verse_number": "८-१०१-४१", "content_sanskrit": "स ददर्श रणे कर्णं शयानं पुरुषर्षभम्।\nगाण्डीवमुक्तैर्विशिखैः सर्वतः सन्निपीडितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2065197, "chapter_id": 2381, "verse_number": "८-१०१-४२", "content_sanskrit": "सपुत्रं निहतं दृष्ट्वा कर्णं राजा युधिष्ठिरः।\nप्रशशंस नरव्याघ्रावुभौ माधवपाण्डवौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2065198, "chapter_id": 2381, "verse_number": "८-१०१-४३", "content_sanskrit": "अद्य राजाऽस्मि सर्वस्यां पृथिव्यां मधुसूदन।\nदिष्ट्या जयसि गोविन्द दिष्ट्याशत्रुर्निपातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2065199, "chapter_id": 2381, "verse_number": "८-१०१-४४", "content_sanskrit": "एवं सुबहुशो राजन्प्रशशंस जनार्दनम्।\nअर्जुनं च कुरुश्रेष्ठो धर्मराजो युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2065200, "chapter_id": 2381, "verse_number": "८-१०१-४५", "content_sanskrit": "दृष्ट्वा च निहतं कर्णं स पुत्रं पार्थसायकैः।\nपुनर्जातमिवात्मानं मेने कुरुकुलोद्वहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2065201, "chapter_id": 2381, "verse_number": "८-१०१-४६", "content_sanskrit": "समेत्य च कुरुश्रेष्ठं कुन्तीपुत्रं युधिष्ठिरम्।\nवर्धयन्ति स्म राजानो हर्षयुक्ता महारथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2065202, "chapter_id": 2381, "verse_number": "८-१०१-४७x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2065203, "chapter_id": 2381, "verse_number": "८-१०१-४७", "content_sanskrit": "एवमेष क्षयो वृत्तः सुमहान्रोमहर्षणः।\nतव दुर्मन्त्रिते राजन्दिष्ट्या त्वमनुशोचसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2065204, "chapter_id": 2381, "verse_number": "८-१०१-४८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2065205, "chapter_id": 2381, "verse_number": "८-१०१-४८", "content_sanskrit": "श्रुत्वैतदप्रियं राजा धृतराष्ट्रो महीपतिः।\nपपात भूमौ निश्चेष्टः कौरव्यः परमासनात्।\nतथा सत्यव्रता देवी गान्धारी दिव्यदर्शना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2065206, "chapter_id": 2381, "verse_number": "८-१०१-४९", "content_sanskrit": "ततस्तूर्णं तु विदुरस्तं नृपं सञ्जयस्तथा।\nपर्याश्वासयतां चैतावुभावेव तु भूमिपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2065207, "chapter_id": 2381, "verse_number": "८-१०१-५०", "content_sanskrit": "तथैवाश्वासयामासुर्गान्धारीं कुरुयोषितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2065208, "chapter_id": 2381, "verse_number": "८-१०१-५१", "content_sanskrit": "स दैवं परमं मेने भवितव्यं च भारत।\nताभ्यामाश्वासितो राजा तूष्णीमास्ते विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2065209, "chapter_id": 2381, "verse_number": "८-१०१-५२", "content_sanskrit": "एवमाख्याय राज्ञे च सञ्जयो राजसत्तम।\nजगाम शिबिरं भूयो हते कर्णे महात्मनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2065210, "chapter_id": 2381, "verse_number": "८-१०१-५३", "content_sanskrit": "स दृष्ट्वा निहतं शल्यं राजानं च सुयोधनम्।\nशकुनिं सुबहून्राजन्सैनिकांश्च सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2065211, "chapter_id": 2381, "verse_number": "८-१०१-५४", "content_sanskrit": "तथैव पाण्डवीं सेनां निहतां प्रेक्ष्य सञ्जयः।\nसौप्तिके द्रौणिना राजन्हतवाजिनरद्विपाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2065212, "chapter_id": 2381, "verse_number": "८-१०१-५५", "content_sanskrit": "स हि दृष्ट्वा हतान्सर्वान्समन्ताद्युधि सञ्जयः।\nप्रयातो हास्तिनपुरं शोकार्तो भयविह्वलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2065213, "chapter_id": 2381, "verse_number": "८-१०१-५६", "content_sanskrit": "हतेषु पुनरेतेषु प्रभूतगजवाजिषु।\nयोधैश्च तैर्महाराज नानादेशसमुद्भवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2065214, "chapter_id": 2381, "verse_number": "८-१०१-५७", "content_sanskrit": "कुरुक्षेत्रं तु तत्सर्वं शून्यमासीद्विशाम्पते।\nनिहतैः पाण्डवेयैश्च धार्तराष्ट्रैश्च संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2065215, "chapter_id": 2381, "verse_number": "८-१०१-५८", "content_sanskrit": "यथाहि विषयं वृत्तं धार्तराष्ट्रस्य संञ्जयः।\nनिवेदयति तत्सर्वं यथावृत्तं यथाविधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2065216, "chapter_id": 2381, "verse_number": "८-१०१-५९", "content_sanskrit": "एवं महायुद्धमिदं महात्मनो\nधनञ्जयस्याधिरथेश्च यः पठेत्।\nस सम्यगिष्टस्य मखस्य यत्फलं\nतदाप्नुयाद्यः शृणुयाच्च नित्यशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2065217, "chapter_id": 2381, "verse_number": "८-१०१-६०", "content_sanskrit": "मखो हि विष्णुर्भगवान्सनातनो\nवहन्ति यं चाप्यनिलेन्दुभानवः।\nअतोऽनसूयुः शृणुयात्पठेच्च यः\nस सर्वलोकांश्च जयेत्सुखी भवेत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2065218, "chapter_id": 2381, "verse_number": "८-१०१-१", "content_sanskrit": "इति श्रीमन्महाभारते शतसाहस्रिकायां संहितायां वैयासिक्यां कर्णपर्वणि एकाधिकशततमोऽध्यायः॥ १०१ ॥ ॥ कर्णपर्व समाप्तम्॥ ८ ॥\nअतः परं शल्यपर्व भविष्यति।\nतस्यायमाद्यः श्लोकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2065219, "chapter_id": 2381, "verse_number": "८-१०१-२x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2065220, "chapter_id": 2381, "verse_number": "८-१०१-२", "content_sanskrit": "एवं निपातिते कर्णे समरे सव्यसाचिना।\nअल्पावशिष्टाः कुरवः किमकुर्वत वै द्विज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2065221, "chapter_id": 2381, "verse_number": "", "content_sanskrit": "इदं कर्णपर्व कुम्भघोणस्थेन टी.आर्.कृष्णाचार्येण टी. आर्. व्यासाचार्येण च मुम्बय्यां निर्णयसागरमुद्रायन्त्रे मुद्रापितम्। शकाब्दाः १८२९ सन १९०७.", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}]