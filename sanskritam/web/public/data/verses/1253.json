[{"id": 2012374, "chapter_id": 1253, "verse_number": "१-२५४-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2012375, "chapter_id": 1253, "verse_number": "१-२५४-१", "content_sanskrit": "तथा शैलनिपातेन भीषिताः खाण्डवालयाः।\nदानवा राक्षसा नागास्तरक्ष्वृक्षवनौकसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2012376, "chapter_id": 1253, "verse_number": "१-२५४-२", "content_sanskrit": "द्विपाः प्रभिन्नाः शार्दूलाः सिंहाः केसरिणस्तथा।\nमृगाश्च महिषाश्चैव शतशः पक्षिणस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2012377, "chapter_id": 1253, "verse_number": "१-२५४-३", "content_sanskrit": "समुद्विग्ना विससृपुस्तथान्या भूतजातयः।\nतं दावं समुदैक्षन्त कृष्णौ चाभ्युद्यतायुधौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2012378, "chapter_id": 1253, "verse_number": "१-२५४-४", "content_sanskrit": "उत्पातनादशब्देन त्रासिता इव चाभवन्।\nते वनं प्रसमीक्ष्याथ दह्यमानमनेकधा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2012379, "chapter_id": 1253, "verse_number": "१-२५४-५", "content_sanskrit": "कृष्णमभ्युद्यतास्त्रं च नादं मुमुचुरुल्बणम्।\nतेन नादेन रौद्रेण नादेन च विभावसोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2012380, "chapter_id": 1253, "verse_number": "१-२५४-६", "content_sanskrit": "ररास गगनं कृत्स्नमुत्पातजलदैरिव।\nततः कृष्णो महाबाहुः स्वतेजोभास्वरं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2012381, "chapter_id": 1253, "verse_number": "१-२५४-७", "content_sanskrit": "चक्रं व्यसृजदत्युग्रं तेषां नाशाय केशवः।\nतेनार्ता जातयः क्षुद्राः सदानवनिशाचराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2012382, "chapter_id": 1253, "verse_number": "१-२५४-८", "content_sanskrit": "निकृत्ताः शतशः सर्वा निपेतुरनलं क्षणात्।\nतत्रादृश्यन्त ते दैत्याः कृष्णचक्रविदारिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2012383, "chapter_id": 1253, "verse_number": "१-२५४-९", "content_sanskrit": "वसारुधिरसंपृक्ताः सन्ध्यायामिव तोयदाः।\nपिशाचान्पक्षिणो नागान्पशूंश्चैव सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2012384, "chapter_id": 1253, "verse_number": "१-२५४-१०", "content_sanskrit": "निघ्नंश्चरति वार्ष्णेयः कालवत्तत्र भारत।\nक्षिप्तं क्षिप्तं पुनश्चक्रं कृष्णस्यामित्रघातिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2012385, "chapter_id": 1253, "verse_number": "१-२५४-११", "content_sanskrit": "छित्त्वानेकानि सत्वानि पाणिमेति पुनः पुनः।\nतथा तु निघ्नतस्तस्य पिशाचोरगराक्षसान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2012386, "chapter_id": 1253, "verse_number": "१-२५४-१२", "content_sanskrit": "बभूव रूपमत्युग्रं सर्वभूतात्मनस्तदा।\nसमेतानां च सर्वेषां दानवानां च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2012387, "chapter_id": 1253, "verse_number": "१-२५४-१३", "content_sanskrit": "विजेता नाभवत्कश्चित्कृष्णपाण्डवयोर्मृधे।\nतयोर्बलात्परित्रातुं तं च दावं यदा सुराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2012388, "chapter_id": 1253, "verse_number": "१-२५४-१४", "content_sanskrit": "नाशक्नुवञ्शमयितुं तदाऽभूवन्पराङ्मुखाः।\nशतक्रतुस्तु संप्रेक्ष्य विमुखानमरांस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2012389, "chapter_id": 1253, "verse_number": "१-२५४-१५", "content_sanskrit": "बभूव मुदितो राजन्प्रशंसन्केशवार्जुनौ।\nनिवृत्तेष्वथ देवेषु वागुवाचाशरीरिणी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2012390, "chapter_id": 1253, "verse_number": "१-२५४-१६", "content_sanskrit": "शतक्रतुं समाभाष्य महागम्भीरनिःस्वना।\nन ते सखा सन्निहितस्तक्षको भुजगोत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2012391, "chapter_id": 1253, "verse_number": "१-२५४-१७", "content_sanskrit": "दाहकाले खाण्डवस्य कुरुक्षेत्रं गतो ह्यसौ।\nन च शक्यौ युधा जेतुं कथंचिदपि वासव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2012392, "chapter_id": 1253, "verse_number": "१-२५४-१८", "content_sanskrit": "वासुदेवार्जुनावेतौ निबोध वचनान्मम।\nनरनारायणावेतौ पूर्वदेवौ दिवि श्रुतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2012393, "chapter_id": 1253, "verse_number": "१-२५४-१९", "content_sanskrit": "भवानप्यभिजानाति यद्वीर्यौ यत्पराक्रमौ।\nनैतौ शक्यौ दुराधर्षौ विजेतुमजितौ युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2012394, "chapter_id": 1253, "verse_number": "१-२५४-२०", "content_sanskrit": "अपि सर्वेषु लोकेषु पुराणावृषिसत्तमौ।\nपूजनीयतमावेतावपि सर्वैः सुरासुरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2012395, "chapter_id": 1253, "verse_number": "१-२५४-२१", "content_sanskrit": "यक्षराक्षसगन्धर्वनरकिन्नरपन्नगैः।\nतस्मादितः सुरैः सार्धं गन्तुमर्हसि वासव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2012396, "chapter_id": 1253, "verse_number": "१-२५४-२२", "content_sanskrit": "दिष्टं चाप्यनुपश्यैतत्खाण्डवस्य विनाशनम्।\nइति वाक्यमुपश्रुत्य तथ्यमित्यमरेश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2012397, "chapter_id": 1253, "verse_number": "१-२५४-२३", "content_sanskrit": "क्रोधामर्षौ समुत्सृज्य संप्रतस्थे दिवं तदा।\nतं प्रस्थितं महात्मानं समवेक्ष्य दिवौकसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2012398, "chapter_id": 1253, "verse_number": "१-२५४-२४", "content_sanskrit": "सहिताः सेनया राजन्ननुजग्मुः पुरन्दरम्।\nदेवराजं तदा यान्तं सह देवैरवेक्ष्य तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2012399, "chapter_id": 1253, "verse_number": "१-२५४-२५", "content_sanskrit": "वासुदेवार्जुनौ वीरौ सिंहनादं विनेदतुः।\nदेवराजे गते राजन्प्रहृष्टौ केशवार्जुनौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2012400, "chapter_id": 1253, "verse_number": "१-२५४-२६", "content_sanskrit": "निर्विशङ्कं वनं वीरौ दाहयामासतुस्तदा।\nस मारुत इवाभ्राणि नाशयित्वाऽर्जुनः सुरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2012401, "chapter_id": 1253, "verse_number": "१-२५४-२७", "content_sanskrit": "व्यधमच्छरसङ्घातैर्देहिनः खाण्डवालयान्।\nन च स्म किंचिच्छक्नोति भूतं निश्चरितुं ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2012402, "chapter_id": 1253, "verse_number": "१-२५४-२८", "content_sanskrit": "संछिद्यमानमिषुभिरस्यता सव्यसाचिना।\nनाशक्नुवंश्च भूतानि महान्त्यपि रणेऽर्जुनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2012403, "chapter_id": 1253, "verse_number": "१-२५४-२९", "content_sanskrit": "निरीक्षितुममोघास्त्रं योद्धुं चापि कुतो रणे।\nशतं चैकेन विव्याध शतेनैकं पतत्रिणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2012404, "chapter_id": 1253, "verse_number": "१-२५४-३०", "content_sanskrit": "व्यसवस्तेऽपतन्नग्नौ साक्षात्कालहता इव।\nन चालभन्त ते शर्म रोधःसु विषमेषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2012405, "chapter_id": 1253, "verse_number": "१-२५४-३१", "content_sanskrit": "पितृदेवनिवासेषु सन्तापश्चाप्यजायत।\nभूतसङ्घाश्च बहवो दीनाश्चक्रुर्महास्वनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2012406, "chapter_id": 1253, "verse_number": "१-२५४-३२", "content_sanskrit": "रुरुदुर्वारणाश्चैव तथा मृगतरक्षवः।\nतेन शब्देन वित्रेसुर्गङ्गोदधिचरा झषाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2012407, "chapter_id": 1253, "verse_number": "१-२५४-३३", "content_sanskrit": "विद्याधरगणाश्चैव ये च तत्र वनौकसः।\nन त्वर्जुनं महाबाहो नापि कृष्णं जनार्दनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2012408, "chapter_id": 1253, "verse_number": "१-२५४-३४", "content_sanskrit": "निरीक्षितुं वै शक्नोति कश्चिद्योद्धुं कुतः पुनः।\nएकायनगता येऽपि निष्पेतुस्तत्र केचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2012409, "chapter_id": 1253, "verse_number": "१-२५४-३५", "content_sanskrit": "राक्षसा दानवा नागा जघ्ने चक्रेण तान्हरिः।\nते तु भिन्नशिरोदेहाश्चक्रवेगाद्गतासवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2012410, "chapter_id": 1253, "verse_number": "१-२५४-३६", "content_sanskrit": "पेतुरन्ये महाकायाः प्रदीप्ते वसुरेतसि।\nसमांसरुधिरौधैश्च वसाभिश्चापि तर्पितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2012411, "chapter_id": 1253, "verse_number": "१-२५४-३७", "content_sanskrit": "उपर्याकाशगो भूत्वा विधूमः समपद्यत।\nदीप्ताक्षो दीप्तजिह्वश्च संप्रदीप्तमहाननः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2012412, "chapter_id": 1253, "verse_number": "१-२५४-३८", "content_sanskrit": "दीप्तोर्ध्वकेशः पिङ्गाक्षः पिबन्प्राणभृतां वसाम्।\nतां स कृष्णार्जुनकृतां सुधां प्राप्य हुताशनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2012413, "chapter_id": 1253, "verse_number": "१-२५४-३९", "content_sanskrit": "बभूव मुदितस्तृप्तः परां निर्वृतिमागतः।\nतथाऽसुरं मयं नाम तक्षकस्य निवेशनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2012414, "chapter_id": 1253, "verse_number": "१-२५४-४०", "content_sanskrit": "विप्रद्रवन्तं सहसा ददर्श मधुसूदनः।\nतमग्निः प्रार्थयामास दिधक्षुर्वातसारथिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2012415, "chapter_id": 1253, "verse_number": "१-२५४-४१", "content_sanskrit": "शरीरवाञ्जटी भूत्वा नदन्निव बलाहकः।\nविज्ञाय दानवेन्द्राणां मयं वै शिल्पिनां वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2012416, "chapter_id": 1253, "verse_number": "१-२५४-४२", "content_sanskrit": "जिघांसुर्वासुदेवस्तं चक्रमुद्यम्य धिष्ठितः।\nस चक्रमुद्यतं दृष्ट्वा दिधक्षन्तं च पावकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2012417, "chapter_id": 1253, "verse_number": "१-२५४-४३", "content_sanskrit": "अभिधावार्जुनेत्येवं मयस्त्राहीति चाब्रवीत्।\nतस्य भीतस्वनं श्रुत्वा मा भैरिति धनंजयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2012418, "chapter_id": 1253, "verse_number": "१-२५४-४४", "content_sanskrit": "प्रत्युवाच मयं पार्थो जीवयन्निव भारत।\nतं न भेतव्यमित्याह मयं पार्थो दयापरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2012419, "chapter_id": 1253, "verse_number": "१-२५४-४५", "content_sanskrit": "तं पार्थेनाभये दत्ते नमुचेर्भ्रातरं मयम्।\nन हन्तुमैच्छद्दाशार्हः पावको न ददाह च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2012420, "chapter_id": 1253, "verse_number": "१-२५४-४६", "content_sanskrit": "तद्वनं पावको धीमान्दिनानि दश पञ्च च।\nददाह कृष्णपार्थाभ्यां रक्षितः पाकशासनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2012421, "chapter_id": 1253, "verse_number": "१-२५४-४७", "content_sanskrit": "तस्मिन्वने दह्यमाने षडग्निर्न ददाह च।\nअश्वसेनं मयं चैव चतुरः शार्ङ्गकांस्तथा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2012422, "chapter_id": 1253, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि मयदर्शनपर्वणि चतुःपञ्चाशदधिकद्विशततमोऽध्यायः॥ २५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]