[{"id": 7001675000, "chapter_id": 21675, "verse_number": "१-६१-१", "content_sanskrit": "सनत्कुमार उवाच ।\nअशोकं शोकनाशार्थं शास्त्रं शांतिकरं शिवम् ।\nनिशम्य लभ्यते बुद्धिर्लब्धायां सुखमेधते ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001675001, "chapter_id": 21675, "verse_number": "१-६१-२", "content_sanskrit": "हर्षस्थानसहस्राणि शोकस्थानशतानि च ।\nदिवसे दिवसे मूढमाविशंति न पंडितम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001675002, "chapter_id": 21675, "verse_number": "१-६१-३", "content_sanskrit": "अनिष्टसंप्रंयोगाश्च विप्रयोगात्प्रियस्य च ।\nमनुष्या मानसैर्दुःखैर्युज्यन्ते येऽल्पबुद्धयः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001675003, "chapter_id": 21675, "verse_number": "१-६१-४", "content_sanskrit": "द्रव्येषु समतीतेषु ये गुणास्तेन्न चिंदयेत् ।\nताननाद्रियमाणश्च स्नेहबन्धाद्विमुच्यते ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001675004, "chapter_id": 21675, "verse_number": "१-६१-५", "content_sanskrit": "दोषदर्शी भवेत्तत्र यत्र रागः प्रवर्त्तते ।\nअनिष्टबुद्धितां यच्छेत्ततः क्षिप्रं विराजते ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001675005, "chapter_id": 21675, "verse_number": "१-६१-६", "content_sanskrit": "नार्थो न धर्मो न यशो योऽतीतमनुशोचति ।\nअस्याभावेन युज्येतं तञ्चास्य तु निवर्तते ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001675006, "chapter_id": 21675, "verse_number": "१-६१-७", "content_sanskrit": "गुणैर्भूतानि युज्यंते तथैव च न युज्यते ।\nसर्वाणि नैतदेकस्य शोकस्थानं हि विद्यते ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001675007, "chapter_id": 21675, "verse_number": "१-६१-८", "content_sanskrit": "मृतं वा यदि वा नष्टं योऽतीतमनुशोचति ।\nदुःखेन लभते दुःखं महानर्थे प्रपद्यते ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001675008, "chapter_id": 21675, "verse_number": "१-६१-९", "content_sanskrit": "दुःखोपघाते शारीरे मानसे चाप्युपस्थिते ।\nयस्मिन्न शक्यते कर्तुं यत्नस्तन्नानुर्चितयेत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001675009, "chapter_id": 21675, "verse_number": "१-६१-१०", "content_sanskrit": "भैषज्यमेतद्दःखस्य यदेतन्नानुचिंतयेत् ।\nचिंत्यमानं हि न व्येति भूयश्चाभिप्रवर्द्धते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001675010, "chapter_id": 21675, "verse_number": "१-६१-११", "content_sanskrit": "प्रज्ञया मानसं दुःखं हन्याच्छारीरमौषधैः ।\nएतद्विज्ञाय सामर्थ्यं न वान्यैः समतामियात् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001675011, "chapter_id": 21675, "verse_number": "१-६१-१२", "content_sanskrit": "अनित्यं जीवितं रूपं यौवनं द्रव्यसञ्चयः ।\nआरोग्यं प्रियसंवासं न मृध्येत्पंडितः क्वचित् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001675012, "chapter_id": 21675, "verse_number": "१-६१-१३", "content_sanskrit": "नाज्ञानप्रभवं दुःखमेकं शोचितुमर्हति ।\nअशोचन्प्रतिकुर्वीत यदि पश्येदुपक्रमम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001675013, "chapter_id": 21675, "verse_number": "१-६१-१४", "content_sanskrit": "सुखात्प्रियतरं दुःखं जीविते नात्र संशयः ।\nजरामरणदुःखेभ्यः प्रियमात्मानमुद्धरेत् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001675014, "chapter_id": 21675, "verse_number": "१-६१-१५", "content_sanskrit": "भजंति हि शारीराणि रोगाः शरीरमानसाः ।\nसायका इव तीक्ष्णाग्राः प्रयुक्ता दृढधन्विभिः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001675015, "chapter_id": 21675, "verse_number": "१-६१-१६", "content_sanskrit": "व्याधितस्य चिकित्साभिस्त्रस्यतो जीवितैषिणः ।\nआमयस्य विनाशाय शरीरमनुकृष्यते ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001675016, "chapter_id": 21675, "verse_number": "१-६१-१७", "content_sanskrit": "स्रंसंति न निवर्तंते स्रोतांसि सरितामिव ।\nआयुरादाय मर्त्यानां रात्र्यहानि पुनःपुनः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001675017, "chapter_id": 21675, "verse_number": "१-६१-१८", "content_sanskrit": "अपयंत्ययमत्यंतं पक्षयोः शुक्लकृष्णयोः ।\nजातं मर्त्यं जरयति निमिषं नावतिष्टते ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001675018, "chapter_id": 21675, "verse_number": "१-६१-१९", "content_sanskrit": "सुखदुःखाभिभूतानामजरो जरयत्यसून् ।\nआदित्यो ह्यस्तमभ्येति पुनः पुनरुदेति च ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001675019, "chapter_id": 21675, "verse_number": "१-६१-२०", "content_sanskrit": "अदृष्टपूर्वानादाय भावानपरिशंकितान् ।\nइष्टानिष्टा मनुष्याणां मतं गच्छन्ति रात्रयः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001675020, "chapter_id": 21675, "verse_number": "१-६१-२१", "content_sanskrit": "यो यदिच्छेद्यथाकामं कामानां तत्तदाप्नुयात् ।\nयदि स्यान्न पराधीनं पुरुषस्य क्रियाफलम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001675021, "chapter_id": 21675, "verse_number": "१-६१-२२", "content_sanskrit": "संयताश्चैव तक्षाश्च मतिमंतश्च मानवाः ।\nदृश्यंते निष्फलाः संतः प्रहीनाश्च स्वकर्मभिः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001675022, "chapter_id": 21675, "verse_number": "१-६१-२३", "content_sanskrit": "अपरे निष्फलाः सन्तो निर्गुणाः पुरुषाधमाः ।\nआशाभिरण्यसंयुक्ता दृश्यन्ते सर्वकामिनः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001675023, "chapter_id": 21675, "verse_number": "१-६१-२४", "content_sanskrit": "भूतानामपरः कश्चिद्धिंसायां सततोत्थितः ।\nवंचनायां च लोकेषु ससुखेष्वेव जीयते ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001675024, "chapter_id": 21675, "verse_number": "१-६१-२५", "content_sanskrit": "अचेष्टमानमासीनं श्रीः कंचिदुपतिष्टति ।\nकश्चित्कर्माणि कुरुते न प्राप्यमधिगच्छति ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001675025, "chapter_id": 21675, "verse_number": "१-६१-२६", "content_sanskrit": "अपराधान्समाच्ष्टुं पुरुषस्य स्वभावतः ।\nशुक्रमन्यत्र संभूतं पुनरन्यत्र गच्छति ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001675026, "chapter_id": 21675, "verse_number": "१-६१-२७", "content_sanskrit": "तस्य योनौ प्रसक्तस्य गर्भो भवति मानवः ।\nआम्रपुष्पोपमा यस्य निवृत्तिरुपलभ्यते ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001675027, "chapter_id": 21675, "verse_number": "१-६१-२८", "content_sanskrit": "केषांचित्पुत्रकामानामनुसन्तानमिच्छताम् ।\nसिद्धौ प्रयतमानानां नैवांडमुपजायते ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001675028, "chapter_id": 21675, "verse_number": "१-६१-२९", "content_sanskrit": "गर्भादुद्विजमानानां क्रुद्धादशीविषादिव ।\nआयुष्मान् जायते पुत्रः कथं प्रेतः पितेव सः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001675029, "chapter_id": 21675, "verse_number": "१-६१-३०", "content_sanskrit": "देवानिष्ट्वा तपस्तप्त्वा कृपणैः पुत्रहेतुभिः ।\nदशमासान्परिधृता जायते कुलपांसनाः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001675030, "chapter_id": 21675, "verse_number": "१-६१-३१", "content_sanskrit": "अपरे धनधान्यानि भोगांश्च पितृसंचितान् ।\nविमलानभिजायन्ते लब्ध्वा तैरेव मङ्गलैः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001675031, "chapter_id": 21675, "verse_number": "१-६१-३२", "content_sanskrit": "अन्योन्य समभिप्रेत्य मैथुनस्य समागमे ।\nउपद्रवइवादृष्टो योनौ गर्भः प्रपद्यते ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001675032, "chapter_id": 21675, "verse_number": "१-६१-३३", "content_sanskrit": "स्निग्धत्वादिंद्रियार्थेषु मोहान्मरणमप्रियम् ।\nपरित्यजति यो दुःखं सुखमप्युभयं नरः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001675033, "chapter_id": 21675, "verse_number": "१-६१-३४", "content_sanskrit": "अत्येति ब्रह्म सोऽत्यन्तं सुखमप्यश्नुते परम् ।\nदुःखमर्था हि त्यज्यंते पालने च न ते सुखाः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001675034, "chapter_id": 21675, "verse_number": "१-६१-३५", "content_sanskrit": "श्रुत्वैव नाधिगमनं नाशमेषां न चिंतयेत् ।\nअन्यामन्यां धनावस्थां प्राप्य वैशेषिका नराः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001675035, "chapter_id": 21675, "verse_number": "१-६१-३६", "content_sanskrit": "अतृप्ता यांति विध्वंसं सन्तोषं यांति पंडिताः ।\nसर्वे क्षयांता निचयाः पतनांताः समुच्छ्रयाः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001675036, "chapter_id": 21675, "verse_number": "१-६१-३७", "content_sanskrit": "संयोगा विप्रयोगांता मरणांतं हि जीवितम् ।\nअन्तो नास्ति पिपासायास्तुष्टिस्तु परमं सुखम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001675037, "chapter_id": 21675, "verse_number": "१-६१-३८", "content_sanskrit": "तस्मात्संतोषमेवेह धनं शंसन्ति पंडिताः ।\nनिमेषमात्रमपि हि योऽधिगच्छन्न तिष्टति ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001675038, "chapter_id": 21675, "verse_number": "१-६१-३९", "content_sanskrit": "सशरीरेष्वनित्येषु नित्यं किमनुचिंतयेत् ।\nभूतेषु भावं संचिंत्य ये बुद्ध्या तमसः परम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001675039, "chapter_id": 21675, "verse_number": "१-६१-४०", "content_sanskrit": "न शोचंति गताध्वानः पश्यंति परमां गतिम् ।\nसंचिन्वन्नेकमेवैनं कामानावितृप्तकम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001675040, "chapter_id": 21675, "verse_number": "१-६१-४१", "content_sanskrit": "व्याघ्र पशुमिवासाद्य मृत्युरादाय गच्छति ।\nअथाप्युपायं संपश्येद्दुःखस्यास्य विमोक्षणे ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001675041, "chapter_id": 21675, "verse_number": "१-६१-४२", "content_sanskrit": "अशोचन्नारभेन्नैव युक्तश्चाव्यसनी भवेत् ।\nशब्दे स्पर्शे रसे रूपे गंधे च परमं तथा ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001675042, "chapter_id": 21675, "verse_number": "१-६१-४३", "content_sanskrit": "नोपभोगात्परं किंचिद्धनिनो वाऽधनस्य वा ।\nवाक्संप्रयोगाद्भृतानां नास्ति दुःखमनामयम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001675043, "chapter_id": 21675, "verse_number": "१-६१-४४", "content_sanskrit": "विप्रयोगश्च सर्वस्य न वाचा न च विद्यया ।\nप्रणयं परिसंहृत्य संस्तुतेष्वितरेषु च ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001675044, "chapter_id": 21675, "verse_number": "१-६१-४५", "content_sanskrit": "विचरेदसमुन्नद्धः स सुखी स च पंडितः ।\nअध्यात्मगतमालीनो निरपेक्षो निरामिषः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001675045, "chapter_id": 21675, "verse_number": "१-६१-४६", "content_sanskrit": "आत्मनैव सहायेन चश्चरेत्स सुखी भवेत् ।\nसुखदुःखविपर्यासो यदा समुपपद्यते ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001675046, "chapter_id": 21675, "verse_number": "१-६१-४७", "content_sanskrit": "नैनं प्रज्ञा सुनियतं त्रायते नापि पौरुषम् ।\nस्वभावाद्यत्नमातिष्ठेद्यत्नवान्नावसीदति ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001675047, "chapter_id": 21675, "verse_number": "१-६१-४८", "content_sanskrit": "उपद्रव इवानिष्टो योनिं गर्भः प्रपद्यते ।\nतानि पूर्वशरीराणि नित्यमेकं शरीरिणम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001675048, "chapter_id": 21675, "verse_number": "१-६१-४९", "content_sanskrit": "प्राणिनां प्राणसंरोधे मांसश्लेष्मविचेष्टितम् ।\nनिर्दग्धं परदेहेन परदेंहं बलाबलम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001675049, "chapter_id": 21675, "verse_number": "१-६१-५०", "content_sanskrit": "विनश्यति विनाशांते नावि नावमिवाचलाम् ।\nसंगत्या जठरे न्यस्तं रेतोबिंदुमचेतनम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001675050, "chapter_id": 21675, "verse_number": "१-६१-५१", "content_sanskrit": "केन यत्नेन जीवंतं गर्भं त्वमिह पश्यसि ।\nअन्नपानानि जीर्यंते यत्र भक्ष्याश्च भक्षिताः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001675051, "chapter_id": 21675, "verse_number": "१-६१-५२", "content_sanskrit": "तस्मिन्नेवोदरे गर्भः किं नान्नमिव जीर्यति ।\nगर्भे मूत्रपुरीषाणां स्वभावनियता गतिः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001675052, "chapter_id": 21675, "verse_number": "१-६१-५३", "content_sanskrit": "धारणे वा विसर्गे च न कर्तुं विद्यतेऽवशः ।\nप्रभवंत्युदरे गर्भा जायमानास्तथापरे ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001675053, "chapter_id": 21675, "verse_number": "१-६१-५४", "content_sanskrit": "आगमेन महान्येषां विनाश उपपद्यते ।\nएतस्माद्योनिसंबंधाद्यो जीवन्परिमुच्यते ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001675054, "chapter_id": 21675, "verse_number": "१-६१-५५", "content_sanskrit": "पूजां न लभते कांचित्पुनर्द्धंद्वेषु मज्जति ।\nगर्भस्य सह जातस्य सप्तमीमीदृशीं दशाम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001675055, "chapter_id": 21675, "verse_number": "१-६१-५६", "content_sanskrit": "प्राप्नुवंति ततः पंच न भवंति शतायुषः ।\nनाभ्युत्थाने मनुष्याणां योगाः स्युर्नात्र संशयः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001675056, "chapter_id": 21675, "verse_number": "१-६१-५७", "content_sanskrit": "व्याधिभिश्च विवध्यंते व्याघ्रैः क्षुद्रमृगा इव ।\nव्याधिभिर्भक्ष्यमाणानां त्यजतां विपुलंधनम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001675057, "chapter_id": 21675, "verse_number": "१-६१-५८", "content_sanskrit": "वेदना नापकर्षंति यतमानास्चिकित्सकाः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001675058, "chapter_id": 21675, "verse_number": "१-६१-५९", "content_sanskrit": "ते चापि विविधा वैद्याः कुशला संमतौषधाः ।\nव्याधिभिः परिकृष्यंते मृगा ज्याघ्रैरिवार्दिताः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001675059, "chapter_id": 21675, "verse_number": "१-६१-६०", "content_sanskrit": "ते पिबंति कषायांश्च सर्पीषि विविधानि च ।\nदृश्यंते जरया भग्ना नागैर्नागा इवोत्तमाः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001675060, "chapter_id": 21675, "verse_number": "१-६१-६१", "content_sanskrit": "कैर्वा भुवि चिकित्स्येंत रोगार्त्ता मृगपक्षिणः ।\nश्वापदाश्च दरिद्राश्च प्रायो नार्ता भवंति ते ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001675061, "chapter_id": 21675, "verse_number": "१-६१-६२", "content_sanskrit": "घोरानपि दुराधर्षान्नृपतीनुग्रतेजस ।\nआक्रम्य रोग आदत्ते पशून्पशुपचो यथा ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001675062, "chapter_id": 21675, "verse_number": "१-६१-६३", "content_sanskrit": "इति लोकमनाक्रंदं मोहशोकपरिप्लुतम् ।\nस्रोतसा महसा क्षिप्रं ह्रियमाणं बलीयसा ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001675063, "chapter_id": 21675, "verse_number": "१-६१-६४", "content_sanskrit": "न धनेन न राज्येन नोग्रेण तपसा तथा ।\nस्वभावा ह्यतिवर्तंते ये निर्मुक्ताः शरीरिषु ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001675064, "chapter_id": 21675, "verse_number": "१-६१-६५", "content_sanskrit": "उपर्यपरि लोकस्य सर्वो भवितुमिच्छति ।\nयतते च यथाशक्ति न च तद्वर्तते तथा ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001675065, "chapter_id": 21675, "verse_number": "१-६१-६६", "content_sanskrit": "न म्रियेरन्नजीर्येरन्सर्वे स्युः सार्वकामिकाः ।\nनाप्रियं प्रतिपद्येरन्नुत्थानस्य फलं प्रति ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001675066, "chapter_id": 21675, "verse_number": "१-६१-६७", "content_sanskrit": "ऐश्वर्यमदमत्ताश्च मानान्मयमदेन च ।\nअप्रमत्ताः शठाः क्रूरा विक्रांताः पर्युपासते ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001675067, "chapter_id": 21675, "verse_number": "१-६१-६८", "content_sanskrit": "शोकाः प्रतिनिवर्तंते केषांचिदसमीक्षताम् ।\nस्वं स्वं च पुनरन्येषां न कंचिदतिगच्छति ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001675068, "chapter_id": 21675, "verse_number": "१-६१-६९", "content_sanskrit": "महञ्च फलवैषम्यं दृश्यते कर्मसंधिषु ।\nवहंति शिबिकामन्ये यांत्यन्ये शिबिकारुहः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001675069, "chapter_id": 21675, "verse_number": "१-६१-७०", "content_sanskrit": "सर्वेषामृद्धिकामानामन्ये रथपुरः सराः ।\nमनुजाश्च गतश्रीकाः शतशो विविधाः स्त्रियाः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001675070, "chapter_id": 21675, "verse_number": "१-६१-७१", "content_sanskrit": "द्वंद्वारामेषु भूतेषु गच्छन्त्येकैकशो नराः ।\nइदमन्यत्परं पश्य नात्र मोहं करिष्यसि ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7001675071, "chapter_id": 21675, "verse_number": "१-६१-७२", "content_sanskrit": "धर्मं चापि त्यजा धर्मं त्यज सत्यानृतां धियम् ।\nसर्वं त्यक्त्वा स्वरूपस्थः सुखी भव निरामयः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7001675072, "chapter_id": 21675, "verse_number": "१-६१-७३", "content_sanskrit": "एतत्ते परमं गुह्यमाख्यातमृषिसत्तम ।\nयेन देवाः परित्यज्य भर्त्यलोकं दिवं गताः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7001675073, "chapter_id": 21675, "verse_number": "१-६१-७४", "content_sanskrit": "सनंदन उवाच ।\nइत्युक्त्वा व्यासतनयं समापृच्छ्य महामुनिः ।\nसनत्कुमारः प्रययौ पूजितस्तेन सादरम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7001675074, "chapter_id": 21675, "verse_number": "१-६१-७५", "content_sanskrit": "शुकोऽपि योगिनां श्रेष्टः सम्यग्ज्ञात्वा ह्यवस्थितम् ।\nब्रह्मणः पदमन्वेष्टुमुत्सुकः पितरं ययौ ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7001675075, "chapter_id": 21675, "verse_number": "१-६१-७६", "content_sanskrit": "ततः पित्रा समागम्य प्रणम्य च महामुनिः ।\nशुकः प्रदक्षिणीकृत्य ययौ कैलासपर्वतम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7001675076, "chapter_id": 21675, "verse_number": "१-६१-७७", "content_sanskrit": "व्यासस्तद्विरहाद्दूनः पुत्रस्नेहसमावृतः ।\nक्षणैकं स्थीयतां पुत्र इति च क्रोश दुर्मनाः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7001675077, "chapter_id": 21675, "verse_number": "१-६१-७८", "content_sanskrit": "निरपेक्षः शुको भूत्वा निःस्नेहो मुक्तबन्धनः ।\nमोक्षमेवानुसंचित्य गत एव परं पदम् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}]