[{"id": 2075923, "chapter_id": 2607, "verse_number": "१२-११२-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2075924, "chapter_id": 2607, "verse_number": "१२-११२-१", "content_sanskrit": "किं पार्थिवेन कर्तव्यं किंच कृत्वा सुखी भवेत्।\nतन्ममाचक्ष्व तत्त्वेन सर्वधर्मभृतां वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2075925, "chapter_id": 2607, "verse_number": "१२-११२-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2075926, "chapter_id": 2607, "verse_number": "१२-११२-२", "content_sanskrit": "हन्त तेऽहं प्रवक्ष्यामि शृणु कार्यैकनिश्चयम्।\nयथा राज्ञेह कर्तव्यं यच्च कृत्वा सुखी भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2075927, "chapter_id": 2607, "verse_number": "१२-११२-३", "content_sanskrit": "नचैवं वर्तितव्यं स्म यथेदमनुशुश्रुम्।\nउष्ट्रस्य तु महद्वृत्तं तन्निबोध युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2075928, "chapter_id": 2607, "verse_number": "१२-११२-४", "content_sanskrit": "जातिस्मरो महानुष्ट्रः प्रजापतिकुलोद्भवः।\nतपः सुमहदातिष्ठदरण्ये संशितव्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2075929, "chapter_id": 2607, "verse_number": "१२-११२-५", "content_sanskrit": "तपसस्तस्य चान्तेऽथ प्रीतिमानभवद्विभुः।\nवरेण च्छन्दयामास ततश्चैनं पितामहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2075930, "chapter_id": 2607, "verse_number": "१२-११२-६x", "content_sanskrit": "उष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2075931, "chapter_id": 2607, "verse_number": "१२-११२-६", "content_sanskrit": "भगवंस्त्वत्प्रसादान्मे दीर्घा ग्रीवा भवेदियम्।\nयोजनानां शतं साग्रमिच्छेयं चारितुं विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2075932, "chapter_id": 2607, "verse_number": "१२-११२-७", "content_sanskrit": "एवमस्विति चोक्तः स वरदेन महात्मना।\nप्रतिलभ्य वरं श्रेष्ठं ययावुष्ट्रः स्वकं वनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2075933, "chapter_id": 2607, "verse_number": "१२-११२-८", "content_sanskrit": "स चकार तदाऽऽलस्यं वरदानात्सुदुर्मतिः।\nन चैच्छच्चिरतुं गन्तुं दुरात्मा कालमोहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2075934, "chapter_id": 2607, "verse_number": "१२-११२-९", "content_sanskrit": "स कदाचित्प्रसार्यैव तां ग्रीवां शतयोजनाम्।\nचचार श्रान्तहृदयो वातश्चागात्ततो महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2075935, "chapter_id": 2607, "verse_number": "१२-११२-१०", "content_sanskrit": "स गुहायां शिरोग्रीवां निधाय पशुरात्मनः।\nआस्ते वर्षमथाभ्यागात्सुमहत्प्लावयज्जगत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2075936, "chapter_id": 2607, "verse_number": "१२-११२-११", "content_sanskrit": "अथ शीतपरीताङ्गो जम्बुकः क्षुच्छ्रमान्वितः।\nसदारस्तां गुहामाशु प्रविवेश जलार्दितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2075937, "chapter_id": 2607, "verse_number": "१२-११२-१२", "content_sanskrit": "स दृष्ट्वा मांसजीवी तु सुभृशं क्षुच्छ्रमान्वितः॥\nअभक्षयत्ततो ग्रीवामुष्ट्रस्य भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2075938, "chapter_id": 2607, "verse_number": "१२-११२-१३", "content_sanskrit": "यदा त्वबुध्यतात्मानं भक्ष्यमाणं स वै पशु।\nतदा संकोचने यत्नमकरोद्भृशदुःखितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2075939, "chapter_id": 2607, "verse_number": "१२-११२-१४", "content_sanskrit": "यावदूर्ध्वमधश्चैव ग्रीवां संक्षिपते पशुः।\nतावत्तेन सदारेण जम्बुकेन स भक्षितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2075940, "chapter_id": 2607, "verse_number": "१२-११२-१५", "content_sanskrit": "स हत्वा भक्षयित्वा च तमुष्ट्रं जम्बुकस्तदा।\nविगते वातवर्पे तु निश्चक्राम गुहोदरात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2075941, "chapter_id": 2607, "verse_number": "१२-११२-१६", "content_sanskrit": "एवं दुर्बुद्धिना प्राप्तमुष्ट्रेण निधनं तदा।\nआलस्यस्य क्रमात्पश्य महान्तं दोषमागतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2075942, "chapter_id": 2607, "verse_number": "१२-११२-१७", "content_sanskrit": "त्वमप्येवंविधं हित्वा योगेन नियतेन्द्रियः।\nवर्तस्व बुद्धिमूलं तु विजयं मनुरब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2075943, "chapter_id": 2607, "verse_number": "१२-११२-१८", "content_sanskrit": "बुद्धिश्रेष्ठानि कर्माणि बाहुमध्यानि भारत।\nतानि जङ्घाजघन्यानि भारप्रत्यवराणि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2075944, "chapter_id": 2607, "verse_number": "१२-११२-१९", "content_sanskrit": "राज्यं तिष्ठति दक्षस्य संगृहीतेन्द्रियस्य च।\n[आर्तस्य बुद्धिमूलं हि विजयं मनुरब्रवीत्।]\nगुप्तं मन्त्रं श्रुतवतः सुसहायस्य चानघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2075945, "chapter_id": 2607, "verse_number": "१२-११२-२०", "content_sanskrit": "`असहायवतो ह्यर्था न तिष्ठन्ति कदाचन।\nपरीक्षितसहायस्य तिष्ठन्तीह युधिष्ठिर।\nसहाययुक्तेन मही कृत्स्ना शक्या प्रशासितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2075946, "chapter_id": 2607, "verse_number": "१२-११२-२१", "content_sanskrit": "इदं हि सद्भिः कथितं विधिज्ञैः\nपुरा महेन्द्रप्रतिमप्रभावः।\nमयाऽपि चोक्तं तव शास्त्रदृष्ट्या\nत्वमप्रमत्तः प्रचरस्व राजन्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2075947, "chapter_id": 2607, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि द्वादशाधिकशततमोऽध्यायः॥ ११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]