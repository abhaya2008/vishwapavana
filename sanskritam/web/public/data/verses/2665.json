[{"id": 2078414, "chapter_id": 2665, "verse_number": "१२-१७०-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2078415, "chapter_id": 2665, "verse_number": "१२-१७०-१", "content_sanskrit": "ततः स विदितो राज्ञः प्रविश्य गृहमुत्तमम्।\nपूजितो राक्षसेन्द्रेण निपसादासनोत्तमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2078416, "chapter_id": 2665, "verse_number": "१२-१७०-२", "content_sanskrit": "पृष्टश्च गोत्रचरणं स्वाध्यायं ब्रह्मचारिकम्।\nपृष्टो राज्ञा स नाज्ञासीद्गोत्रमात्रमथाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2078417, "chapter_id": 2665, "verse_number": "१२-१७०-३", "content_sanskrit": "ब्रह्मवर्चमहीनस्य स्वाध्यायाद्विरतस्य च।\nगोत्रमात्रविदो राजा निवामं समपृच्छत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2078418, "chapter_id": 2665, "verse_number": "१२-१७०-४x", "content_sanskrit": "राक्षम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2078419, "chapter_id": 2665, "verse_number": "१२-१७०-४", "content_sanskrit": "क्व ते निवासः कल्याण किंगोत्रा ब्राह्मणी च ते।\nतत्त्वं ब्रूहि न भीः कार्या विश्रमस्व यथासुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2078420, "chapter_id": 2665, "verse_number": "१२-१७०-५x", "content_sanskrit": "गौतम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2078421, "chapter_id": 2665, "verse_number": "१२-१७०-५", "content_sanskrit": "मध्यदेशप्रसूतोऽहं वासो मे शवरालये।\nशूद्री पुनर्भूर्भार्या मे सत्यमेतद्ब्रवीमि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2078422, "chapter_id": 2665, "verse_number": "१२-१७०-६x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2078423, "chapter_id": 2665, "verse_number": "१२-१७०-६", "content_sanskrit": "ततो राजा विममृशे कथं कार्यमिदं भवेत्।\nकथं वा सुकृतं मे स्यादिति वुद्ध्याऽन्वचिन्तयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2078424, "chapter_id": 2665, "verse_number": "१२-१७०-७", "content_sanskrit": "अयं वै जन्मना विप्रः सुहृत्तम्य महात्मनः।\nसंप्रेपितश्च तेनायं काश्यपेन महात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2078425, "chapter_id": 2665, "verse_number": "१२-१७०-८", "content_sanskrit": "तस्य प्रियं करिष्यामि स हि मामाश्रितः सदा।\nभ्राता मे बान्धवश्चासौ सखा चैव प्रियो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2078426, "chapter_id": 2665, "verse_number": "१२-१७०-९", "content_sanskrit": "कार्तिक्यामद्य भोक्तारः सहस्रं मे द्विजोत्तमाः।\nतत्रायमपि भोक्ता तु देयमस्मै च मे धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2078427, "chapter_id": 2665, "verse_number": "१२-१७०-१०", "content_sanskrit": "स चाद्य दिवसः पुण्यो ह्यतिथिश्चायमागतः।\nसंकल्पितं चैव धनं किं विचार्यमतः परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2078428, "chapter_id": 2665, "verse_number": "१२-१७०-११", "content_sanskrit": "ततः सहस्रं विप्राणां विदुषां समलंकृतम्।\nस्नातानामनुलिप्तानामहतक्षौमवाससाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2078429, "chapter_id": 2665, "verse_number": "१२-१७०-१२", "content_sanskrit": "तानागतान्द्विजश्रेष्ठान्विरूपाक्षो विशांपते।\nयथार्हं प्रतिजग्राह विधिदृष्टेन कर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2078430, "chapter_id": 2665, "verse_number": "१२-१७०-१३", "content_sanskrit": "बृस्यस्तेषां तु संन्यस्ता राक्षसेन्द्रस्य शासनात्।\nभूमौ वरकुशाः स्तीर्णाः प्रेष्यैर्भरतसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2078431, "chapter_id": 2665, "verse_number": "१२-१७०-१४", "content_sanskrit": "तासु ते पूजिता राज्ञा निपण्णा द्विजसत्तमाः।\nनिलदर्भोदकेनाथ अर्चिता विधिवद्द्विजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2078432, "chapter_id": 2665, "verse_number": "१२-१७०-१५", "content_sanskrit": "विश्वेदेवाः सपितरः साग्नयश्चोपकल्पिताः।\nविलिप्ताः पुष्पवन्तश्च सुप्रचाराः सुपूजिताः।\nव्यराजन्त महाराज नक्षत्रपतयो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2078433, "chapter_id": 2665, "verse_number": "१२-१७०-१६", "content_sanskrit": "ततो जाम्बूनदीः पात्रीर्वज्राङ्का विमलाः शुभाः।\nवरान्नपूर्णा विप्रेभ्यः प्रादान्मधुघृतप्लुताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2078434, "chapter_id": 2665, "verse_number": "१२-१७०-१७", "content_sanskrit": "तस्य नित्यं मदापाढ्यां माध्यां च बहवो द्विजाः।\nईप्सितं भोजनवरं लभन्ते सत्कृतं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2078435, "chapter_id": 2665, "verse_number": "१२-१७०-१८", "content_sanskrit": "विशेषतस्तु कार्तिक्यां द्विजेभ्यः संप्रयच्छति।\nशरद्व्यपाये रत्नानि पौर्णमास्यामिति श्रुतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2078436, "chapter_id": 2665, "verse_number": "१२-१७०-१९", "content_sanskrit": "सुवर्णं रजतं चैव मणीनथ च मौक्तिकान्।\nवज्रान्महाधनांश्चैव वैदूर्याजिनराङ्कवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2078437, "chapter_id": 2665, "verse_number": "१२-१७०-२०", "content_sanskrit": "रत्नवन्ति च पात्राणि दक्षिणार्थं स भारत।\nदत्त्वा प्राह द्विजश्रेष्ठान्विरूपाक्षो महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2078438, "chapter_id": 2665, "verse_number": "१२-१७०-२१", "content_sanskrit": "गृह्णीत रत्नान्येतानि यथोत्साहं यथेष्टतः।\nयेषुयेषु च भाण्डेषु भुक्तवन्तो द्विजोत्तमाः।\nतान्येवादाय गच्छध्वं स्ववेश्मानीति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2078439, "chapter_id": 2665, "verse_number": "१२-१७०-२२", "content_sanskrit": "इत्युक्तवचने तस्मिन्राक्षसेन्द्रे महात्मनि।\nयथेष्टं तानि रत्नानि जगृहुर्ब्राह्मणवर्षभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2078440, "chapter_id": 2665, "verse_number": "१२-१७०-२३", "content_sanskrit": "ततो महार्हैस्तैस्तेन रत्नैरभ्यर्चिताः शुभैः।\nब्राह्मणा मृष्टवसनाः सुप्रीताः समुदोऽभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2078441, "chapter_id": 2665, "verse_number": "१२-१७०-२४", "content_sanskrit": "ततस्तान्राक्षसेन्द्रस्तु द्विजानाह पुनर्वचः।\nनाना देशागतान्राजा ब्राह्मणाननुमन्य वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2078442, "chapter_id": 2665, "verse_number": "१२-१७०-२५", "content_sanskrit": "अद्यैकं दिवसं विप्रा न वोऽस्तीह भयं क्वचित्।\nराक्षसेभ्यः प्रमोदध्वमिष्टतो यात माचिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2078443, "chapter_id": 2665, "verse_number": "१२-१७०-२६", "content_sanskrit": "ततः प्रदुद्रुवुः सर्वे विप्रसङ्घाः समन्ततः।\nगौतमोऽपि सुवर्णस्य भारमादाय सत्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2078444, "chapter_id": 2665, "verse_number": "१२-१७०-२७", "content_sanskrit": "कृच्छ्रात्समुद्वहन्भारं न्यग्रोधं समुपागमत्।\nन्यषीदच्च परिश्रान्तः क्लान्तश्च क्षुधितश्च सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2078445, "chapter_id": 2665, "verse_number": "१२-१७०-२८", "content_sanskrit": "ततस्तमभ्यगाद्राजन्राजधर्मा खगोत्तमः।\nस्वागतेनाभ्यनन्दच्च गौतमं मित्रवत्सलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2078446, "chapter_id": 2665, "verse_number": "१२-१७०-२९", "content_sanskrit": "तस्य पक्षाग्रविक्षेपैः क्लमं व्यपनयद्बकः।\nपूजां चाप्यकरोद्धीमान्भोजनं च यथाविधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2078447, "chapter_id": 2665, "verse_number": "१२-१७०-३०", "content_sanskrit": "ततस्तौ संविदं कृत्वा खगेन्द्रद्विजसत्तमौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2078448, "chapter_id": 2665, "verse_number": "१२-१७०-३१", "content_sanskrit": "गौतमश्चिन्तयामास रात्रौ तस्य समीपतः।\nहाटकस्याभिरूपस्य भारोऽयं सुमहान्मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2078449, "chapter_id": 2665, "verse_number": "१२-१७०-३२", "content_sanskrit": "गृहीतो लोभमोहाभ्यां दूरं च गमनं मम।\nन चास्ति पथि भोक्तव्यं प्राणसंधारणं मम।\nकिं कृत्वा सुकृतं हि स्यादिति चिन्तापरोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2078450, "chapter_id": 2665, "verse_number": "१२-१७०-३३", "content_sanskrit": "ततः स पथि भोक्तव्यं प्रेक्षमाणो न किंचन।\nकृतघ्नः पुरुषव्याघ्र मनसेदमचिन्तयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2078451, "chapter_id": 2665, "verse_number": "१२-१७०-३४", "content_sanskrit": "अयं बकपतिः पार्श्वे मांसराशिचितो महान्।\nइमं हत्वा गृहीत्वाऽस्य मांसं यास्य इति प्रभो॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2078452, "chapter_id": 2665, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि आपद्धर्मपर्वणि सप्तत्यधिकशततमोऽध्यायः॥ १७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]