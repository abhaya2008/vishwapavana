[{"id": 7000811000, "chapter_id": 20811, "verse_number": "६-१५४-१", "content_sanskrit": "साभ्रमत्यास्तटे गुप्तं तीर्थं परमपावनम् ।\nखङ्गधारमिति ख्यातं कलौ गुप्तं भविष्यति॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000811001, "chapter_id": 20811, "verse_number": "६-१५४-२", "content_sanskrit": "यत्र प्रसंगतः स्नात्वा पीत्वा वापो यदृच्छया ।\nसर्वपापविनिर्मुक्तो रुद्रलोके महीयते॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000811002, "chapter_id": 20811, "verse_number": "६-१५४-३", "content_sanskrit": "यत्र साभ्रमती पुण्या कश्यपानुगता सती ।\nरुद्रेण हि जटाजूटे धृता पातालगामिनः॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000811003, "chapter_id": 20811, "verse_number": "६-१५४-४", "content_sanskrit": "खङ्गधारेति वै नाम्ना रुद्रस्तत्रैव संस्थितः ।\nयत्र स्नात्वा दिवं याताः पापिनोऽपि सुरेश्वरि॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000811004, "chapter_id": 20811, "verse_number": "६-१५४-५", "content_sanskrit": "अत्रैवोदाहरंतीममितिहासं पुरातनम् ।\nकिरातेन कृतं यच्च व्रतं परमदुष्करम्॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000811005, "chapter_id": 20811, "verse_number": "६-१५४-६", "content_sanskrit": "पार्वत्युवाच ।\nकिं नाम वै किरातोऽभूत्किं तेन व्रतमाहितम् ।\nतत्सर्वं श्रोतुमिच्छामि यथातथ्येन कथ्यताम्॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000811006, "chapter_id": 20811, "verse_number": "६-१५४-७", "content_sanskrit": "नह्यन्यो विद्यते लोके त्वां विना वदतां वरः ।\nतस्मात्कथय भो देव सर्वं शुश्रूषणे हितम्॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000811007, "chapter_id": 20811, "verse_number": "६-१५४-८", "content_sanskrit": "महादेव उवाच ।\nआसीत्पुरा महारौद्रश्चंडो नाम दुरात्मवान् ।\nक्रूरः शठो नैष्कृतिको भूतानां च भयावहः॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000811008, "chapter_id": 20811, "verse_number": "६-१५४-९", "content_sanskrit": "जालेन मत्स्यान्दुष्टात्मा घातयत्यनिशं ततः ।\nभल्लैर्मृगान्श्वापदांश्च कृष्णसारान्सशल्लकान्॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000811009, "chapter_id": 20811, "verse_number": "६-१५४-१०", "content_sanskrit": "खगान्नानाविधांश्चैव विध्वा कांश्चित्प्रपातयेत् ।\nपक्षिणो घातयन्क्रुद्धो बर्हिणश्च विशेषतः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000811010, "chapter_id": 20811, "verse_number": "६-१५४-११", "content_sanskrit": "लुब्धको हि महापापो दुष्टो दुष्टजनप्रियः ।\nभार्या तथाविधा तस्य पुंश्चली च महामया॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000811011, "chapter_id": 20811, "verse_number": "६-१५४-१२", "content_sanskrit": "एवं विहरतस्तस्य बहुकालो व्यवर्त्तत ।\nएकदा निशि पापीयान्श्रीवृक्षोपरि संस्थितः॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000811012, "chapter_id": 20811, "verse_number": "६-१५४-१३", "content_sanskrit": "कोलं हंतुं धनुःपाणिः शरं संयोज्य कार्मुके ।\nएवं निशा गता तस्य जाग्रतो निमिषस्य हि ।\nमाघमासे सितायां वै चतुर्दश्यां नगात्मजे॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000811013, "chapter_id": 20811, "verse_number": "६-१५४-१४", "content_sanskrit": "श्रीवृक्षपत्राणि बहूनि तत्र संच्छेदयामास रुषान्वितोऽपि ।\nश्रीवृक्षमूले परिवर्त्तमानं लिगं च तस्योपरितानि पेतुः॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000811014, "chapter_id": 20811, "verse_number": "६-१५४-१५", "content_sanskrit": "श्रीवृक्षपर्णानि च दैवयोगात्जातं च सर्वं शिवपूजनं तत्॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000811015, "chapter_id": 20811, "verse_number": "६-१५४-१६", "content_sanskrit": "गंडूषकारिणा तेन स्नपनं च महत्कृतम् ।\nअज्ञानिना च तेनैव पुष्कसेन दुरात्मना॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000811016, "chapter_id": 20811, "verse_number": "६-१५४-१७", "content_sanskrit": "माघमासे सिते पक्षे चतुर्दश्यां विधूदये ।\nपुष्कसो हि दुराचारो निष्पन्नो गतकल्मषः॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000811017, "chapter_id": 20811, "verse_number": "६-१५४-१८", "content_sanskrit": "तस्य भार्या प्रचंडा च आगता तस्य सन्निधौ ।\nनिराशा च निराहारा यत्रासौ पुष्कसः स्थितः॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000811018, "chapter_id": 20811, "verse_number": "६-१५४-१९", "content_sanskrit": "न प्राप्तः शूकरस्तेन मृगोऽपि महिषोऽपि वा ।\nअशनार्थं च तस्यैव अन्नमादाय भामिनी॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000811019, "chapter_id": 20811, "verse_number": "६-१५४-२०", "content_sanskrit": "तेन दृष्टा प्रचंडा सा आयांती क्रूरलोचना ।\nसा तस्य भार्या नद्यां वै जलमध्ये पपात ह॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000811020, "chapter_id": 20811, "verse_number": "६-१५४-२१", "content_sanskrit": "तावत्तयोक्तश्चंडात्मा एहि शीघ्रं च भक्षय ।\nसमानीतं त्वदर्थं च मत्स्यमांसं मयाधुना॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000811021, "chapter_id": 20811, "verse_number": "६-१५४-२२", "content_sanskrit": "कृतं किं मूढ पूर्वेद्युर्मांसं पार्श्वे न दृश्यते ।\nनाशितं च त्वया मूढ कुटुंबं लंघते तव॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000811022, "chapter_id": 20811, "verse_number": "६-१५४-२३", "content_sanskrit": "एतच्छ्रुत्वा तु वचनं चंडायाश्चंडरूपवान् ।\nशिवरात्र्युपवासेन रात्रौ जागरणेन च॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000811023, "chapter_id": 20811, "verse_number": "६-१५४-२४", "content_sanskrit": "शुद्धांतःकरणो जातः स्नातुं नद्यां शुचिव्रतः ।\nयावत्स्नाति स दुष्टात्मा तावत्श्वा तत्र चागतः॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000811024, "chapter_id": 20811, "verse_number": "६-१५४-२५", "content_sanskrit": "शुना तदा भक्षितं च सर्वं मांसं सुरेश्वरि ।\nचंडा प्रकुपिता तं च श्वानं हंतुमुपस्थिता॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000811025, "chapter_id": 20811, "verse_number": "६-१५४-२६", "content_sanskrit": "निवारिता हि चंडेन चंडा प्रकुपिता तदा ।\nन हंतव्यस्त्वया चैष किमनेनाशुभं कृतम्॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000811026, "chapter_id": 20811, "verse_number": "६-१५४-२७", "content_sanskrit": "तयोक्तं भक्षितं चान्नं अनेनैव दुरात्मना ।\nकिं त्वं भक्षयिता मूढ भविताद्य बुभुक्षितः॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000811027, "chapter_id": 20811, "verse_number": "६-१५४-२८", "content_sanskrit": "पुष्कस उवाच ।\nयच्छुना भक्षितं चान्नं तेनाहं परितोषितः ।\nकिमनेन शरीरेण नश्वरेण गतायुषा॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000811028, "chapter_id": 20811, "verse_number": "६-१५४-२९", "content_sanskrit": "ये पुष्यंति शरीरं वै सर्वभावेन भामिनि ।\nमूढास्ते पापिनो ज्ञेया लोकद्वय बहिष्कृताः॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000811029, "chapter_id": 20811, "verse_number": "६-१५४-३०", "content_sanskrit": "तस्मान्मानं परित्यज्य कामं चापि दुरात्मताम् ।\nस्वस्थाभावविमर्शेन तत्वबुध्या स्थिरा भव॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000811030, "chapter_id": 20811, "verse_number": "६-१५४-३१", "content_sanskrit": "अहमेतच्छरीरं वै खङ्गधारव्रतेन च ।\nत्यक्ष्याम्यद्य वरारोहे किं चिरंजीवनेन मे॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000811031, "chapter_id": 20811, "verse_number": "६-१५४-३२", "content_sanskrit": "इत्युक्त्वा खङ्गमाकृष्य यावद्भिनत्ति कं स्वकम् ।\nआगताश्च गणास्तावद्बहवः शिवनोदिताः॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000811032, "chapter_id": 20811, "verse_number": "६-१५४-३३", "content_sanskrit": "विमानानि बहून्यत्र आगतानि तदंतिके ।\nदृष्ट्वा स चैव तान्येवं विमानानि गणांस्तथा॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000811033, "chapter_id": 20811, "verse_number": "६-१५४-३४", "content_sanskrit": "उवाच परया भक्त्या पुष्कसोऽपि च तान्प्रति ।\nकस्मात्समागता यूयं सर्वे रुद्राक्षधारिणः॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000811034, "chapter_id": 20811, "verse_number": "६-१५४-३५", "content_sanskrit": "सर्वे स्फटिकसंकाशाः सर्वे चंद्रार्द्धशेखराः ।\nकपर्दिनश्चर्मपरीतवाससो भुजंगभोगैः कृतहारभूषणाः॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000811035, "chapter_id": 20811, "verse_number": "६-१५४-३६", "content_sanskrit": "श्रियान्विता रुद्रसमानवीर्या यथातथं भो वदतोचितं मम ।\nपुष्कसेन तदा पृष्टा ऊचुस्ते रुद्रपार्षदाः॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000811036, "chapter_id": 20811, "verse_number": "६-१५४-३७", "content_sanskrit": "गणा ऊचुः ।\nप्रेषितास्मो वयं चंड शिवेन परमेष्ठिना ।\nआगच्छ त्वरितो भूत्वा सस्त्रीको यानमारुह॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000811037, "chapter_id": 20811, "verse_number": "६-१५४-३८", "content_sanskrit": "लिगार्चनं कृतं यच्च त्वया रात्रौ शिवस्य च ।\nतेन कर्मविपाकेन प्राप्तोऽसि परमां गतिम्॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000811038, "chapter_id": 20811, "verse_number": "६-१५४-३९", "content_sanskrit": "तथोक्तो वीरभद्रेण उवाच प्रहसन्निव ।\nकिं मया सुकृतं चीर्णं पापिना पुष्कसेन हि॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000811039, "chapter_id": 20811, "verse_number": "६-१५४-४०", "content_sanskrit": "मृगयारसिकेनैव मूढेन च दुरात्मना ।\nपापाचारोह्यहं नित्यं कथं स्वर्गे वसाम्यहम्॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000811040, "chapter_id": 20811, "verse_number": "६-१५४-४१", "content_sanskrit": "कथं लिगार्चनं चाद्या कृतमस्ति तदुच्यताम् ।\nपरं कौतुकमापन्नः पृच्छामि कृपया वद॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000811041, "chapter_id": 20811, "verse_number": "६-१५४-४२", "content_sanskrit": "वीरभद्र उवाच ।\nदेवदेवो महादेवो यो गंगाधरसंज्ञकः ।\nपरितुष्टोऽद्य ते चंड सभार्यस्य उमापतिः॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000811042, "chapter_id": 20811, "verse_number": "६-१५४-४३", "content_sanskrit": "प्रासंगिकं त्वया चाद्य कृतमर्चनमेव च ।\nकोलं निरीक्षमाणेन बिल्वपत्राणि चैव हि॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000811043, "chapter_id": 20811, "verse_number": "६-१५४-४४", "content_sanskrit": "छेदितानि त्वया चंड पतितानि तदैव हि ।\nलिंगस्य मस्तके तानि तेन त्वं सुकृती प्रभो॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000811044, "chapter_id": 20811, "verse_number": "६-१५४-४५", "content_sanskrit": "तवैवं जागरो जातो महावृक्षोपरि ध्रुवम् ।\nतेनैव जागरेणैव तुतोष जगदीश्वरः॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000811045, "chapter_id": 20811, "verse_number": "६-१५४-४६", "content_sanskrit": "छलेनैव महाभाग कोलसंदर्शनेन हि ।\nशिवरात्रिदिनं व्याध प्रसंगेनाप्युपोषितम्॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000811046, "chapter_id": 20811, "verse_number": "६-१५४-४७", "content_sanskrit": "तेनोपवासेन च जागरेणतुष्टो ह्यसौ देववरो महात्मा ।\nतव प्रसादाय महानुभावो ददाति सर्वान्वरदो वरांश्च॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000811047, "chapter_id": 20811, "verse_number": "६-१५४-४८", "content_sanskrit": "एवमुक्तस्तदा तेन वीरभद्रेण धीमता ।\nपुष्कसोऽपि विमानाग्र्यमारुरोह च पश्यताम्॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000811048, "chapter_id": 20811, "verse_number": "६-१५४-४९", "content_sanskrit": "गणानां देवतानां च सर्वेषां प्राणिनामपि ।\nतदा दुंदुभयो नेदुर्भेरीतूर्याण्यनेकशः॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000811049, "chapter_id": 20811, "verse_number": "६-१५४-५०", "content_sanskrit": "वीणावेणुमृदंगानि लास्यनाट्य युतानि च ।\nजगुर्गंधर्वपतयो ननृतुश्चाप्सरोगणाः॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000811050, "chapter_id": 20811, "verse_number": "६-१५४-५१", "content_sanskrit": "चामरैर्विज्यमानो हि छत्रैश्च विविधैरपि ।\nमहोत्सवेन महता ह्यानीतः शिवसन्निधौ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000811051, "chapter_id": 20811, "verse_number": "६-१५४-५२", "content_sanskrit": "पुष्कसोऽपि तदा प्राप्तस्तीर्थस्नान शिवार्चनात् ।\nकिं पुनः श्रद्धया भक्त्या शिवाय परमात्माने॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000811052, "chapter_id": 20811, "verse_number": "६-१५४-५३", "content_sanskrit": "पुष्पादिकं फलं गंधं तांबूलाक्षतमेव च ।\nये प्रयच्छंति लोकेऽस्मिंस्ते रुद्रा नात्र संशयः॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000811053, "chapter_id": 20811, "verse_number": "६-१५४-५४", "content_sanskrit": "महादेव उवाच ।\nतदाप्रभृति तत्तीर्थं खङ्गधारेति विश्रुतम् ।\nएतत्तीर्थं कलौ गुप्तं भविष्यति सुरेश्वरि॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000811054, "chapter_id": 20811, "verse_number": "६-१५४-५५", "content_sanskrit": "माघमासेऽथ वैशाखे कार्तिक्यां च विशेषतः ।\nस्नानं येन प्रकुर्वंति मुक्तास्ते नगनंदिनि॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000811055, "chapter_id": 20811, "verse_number": "६-१५४-५६", "content_sanskrit": "वसिष्ठो वामदेवश्च भरद्वाजोऽथ गौतमः ।\nस्नानार्थे वै समायांति देवं द्रष्टुं पिनाकिनम्॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000811056, "chapter_id": 20811, "verse_number": "६-१५४-५७", "content_sanskrit": "त्रियुगे वर्त्तते लिंगं कलौ नैव तु पार्वति ।\nविश्वामित्रेण ऋषिणा दत्तशापो ह्यहं तदा॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000811057, "chapter_id": 20811, "verse_number": "६-१५४-५८", "content_sanskrit": "पार्वत्युवाच ।\nकथं शापस्तु ऋषिणा दत्तश्चैव सुरेश्वर ।\nतदहं श्रोतुमिच्छामि त्वत्तो देव न संशयः॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000811058, "chapter_id": 20811, "verse_number": "६-१५४-५९", "content_sanskrit": "महादेव उवाच ।\nएकस्मिन्समये देवि विश्वामित्रो महातपाः ।\nआगतः खङ्गधारेऽस्मिंस्तीर्थे वै परमाद्भुते॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000811059, "chapter_id": 20811, "verse_number": "६-१५४-६०", "content_sanskrit": "साभ्रमत्यां कृतस्नानो दर्शनं कृतवान्मम ।\nतत्र तिष्ठति नित्यं वै पूजां कुर्वन्ननेकधा॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000811060, "chapter_id": 20811, "verse_number": "६-१५४-६१", "content_sanskrit": "तत्र कोऽपि महादुष्टः कौलिकः पापरुपधृक् ।\nमांसं दत्तं तदा तेन शिवस्योपरि भामिनि॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000811061, "chapter_id": 20811, "verse_number": "६-१५४-६२", "content_sanskrit": "दृष्ट्वा तदपि मांसं च विश्वामित्रोऽथ वै पुनः ।\nअब्रवीच्च तदा तत्र दुष्कृतं पापिना कृतम्॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000811062, "chapter_id": 20811, "verse_number": "६-१५४-६३", "content_sanskrit": "न दत्तस्तस्य दंडो हि शर्वेण परमात्मना ।\nतस्मादहं हि निश्चित्य शापं दास्ये न संशयः॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000811063, "chapter_id": 20811, "verse_number": "६-१५४-६४", "content_sanskrit": "विचार्यैवं तदा तेन शप्तोऽहं देवि वै तदा॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000811064, "chapter_id": 20811, "verse_number": "६-१५४-६५", "content_sanskrit": "अस्मिन्कलियुगे घोरे गुप्तस्त्वं भव सर्वथा ।\nइति दत्वाथ वै शापं गतवान्मुनिसत्तमः॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000811065, "chapter_id": 20811, "verse_number": "६-१५४-६६", "content_sanskrit": "तदा प्रभृति भो देवि गुप्तोऽहं ऋषिशापतः ।\nममस्थाने विशेषेण पूजनं कुरुते यदि॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000811066, "chapter_id": 20811, "verse_number": "६-१५४-६७", "content_sanskrit": "तेषां हि दुरितं यच्च नश्यते तत्क्षणादपि ।\nमृन्मयीं मामकीं मूर्तिं कृत्वा ये पूजयंति वै॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000811067, "chapter_id": 20811, "verse_number": "६-१५४-६८", "content_sanskrit": "अत्र स्थाने विशेषेण मामके तु वसंति हि ।\nखङ्गधारेश्वर इति नाम्ना ख्यातः कलौयुगे॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000811068, "chapter_id": 20811, "verse_number": "६-१५४-६९", "content_sanskrit": "कृते वै मंदिरं नाम त्रेतायां गौरवः स्मृतः ।\nद्वापरे विश्वविख्यातः कलौ खङ्गेश्वरः स्मृतः॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000811069, "chapter_id": 20811, "verse_number": "६-१५४-७०", "content_sanskrit": "दक्षिणं भागमाश्रित्य मम स्थानं सुरेश्वरि ।\nइति ज्ञात्वा तु तत्रैव कृत्वा मूर्तिं सदा बुधः॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000811070, "chapter_id": 20811, "verse_number": "६-१५४-७१", "content_sanskrit": "पूजनं कुरुते नित्यं वांछितं फलमाप्नुयात् ।\nधर्मार्थकाममोक्षांश्च लभते मानवो भुवि॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000811071, "chapter_id": 20811, "verse_number": "६-१५४-७२", "content_sanskrit": "धूपं दीपं च नैवेद्यं तथा वै चंदनादिकम् ।\nयेऽर्पयंति हि देवेशि लोकनाथे महेश्वरि ।\nन दुःखं तु भवेत्तेषां सत्यं सत्यं वरानने॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}]