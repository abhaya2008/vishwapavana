[{"id": 2079078, "chapter_id": 2682, "verse_number": "१२-१८७-०x", "content_sanskrit": "भरद्वाज उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2079079, "chapter_id": 2682, "verse_number": "१२-१८७-१", "content_sanskrit": "ब्राह्मणः केन भवति क्षत्रियो वा द्विजोत्तम।\nवैश्यः शूद्रश्च विप्रर्षे तद्ब्रूहि वदतां वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2079080, "chapter_id": 2682, "verse_number": "१२-१८७-२x", "content_sanskrit": "भृगुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2079081, "chapter_id": 2682, "verse_number": "१२-१८७-२", "content_sanskrit": "जातकर्मादिभिर्यस्तु संस्कारैः संस्कृतः शुचिः।\nवेदाध्ययनसंपन्नः षट्सु कर्मस्ववस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2079082, "chapter_id": 2682, "verse_number": "१२-१८७-३", "content_sanskrit": "शौचाचारस्थितः सम्यग्विघसाशी गुरुप्रियः।\nनित्यव्रती सत्यपरः स वै ब्राह्मण उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2079083, "chapter_id": 2682, "verse_number": "१२-१८७-४", "content_sanskrit": "सत्यं दानमथाद्रोह आनृशंस्यं क्षमा धृणा।\nतपश्च दृश्यते यत्र स ब्राह्मण इति स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2079084, "chapter_id": 2682, "verse_number": "१२-१८७-५", "content_sanskrit": "क्षत्रजं सेवते कर्म देवाध्ययनसंगतः।\nदानादानरतिर्यस्तु स वै क्षत्रिय उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2079085, "chapter_id": 2682, "verse_number": "१२-१८७-६", "content_sanskrit": "कृपिगोरक्षवाणिज्यं यो विशत्यनिशं शुचिः।\nवेदाध्ययनसंपन्नः स वैश्य इति संज्ञितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2079086, "chapter_id": 2682, "verse_number": "१२-१८७-७", "content_sanskrit": "सर्वभक्षरतिर्नित्यं सर्वकर्मकरोऽशुचिः।\nत्यक्तवेदस्त्वनाचारः स वै शूद्र इति स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2079087, "chapter_id": 2682, "verse_number": "१२-१८७-८", "content_sanskrit": "शूद्रे चैतद्भवेल्लक्ष्यं द्विजे तच्च न विद्यते।\nन वै शूद्रो भवेच्छ्रद्रो ब्राह्मणो न च ब्राह्मणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2079088, "chapter_id": 2682, "verse_number": "१२-१८७-९", "content_sanskrit": "सर्वोपायैस्तु लोभस्य क्रोधस्य च विनिग्रहः।\nएतत्पवित्रं ज्ञातव्यं तथा चैवात्मसंयमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2079089, "chapter_id": 2682, "verse_number": "१२-१८७-१०", "content_sanskrit": "वार्यौ सर्वात्मना तौ हि श्रेयोघातार्थमुच्छ्रितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2079090, "chapter_id": 2682, "verse_number": "१२-१८७-११", "content_sanskrit": "नित्यं क्रोधाच्छ्रियं रक्षेत्तपो रक्षेच्च मत्सरात्।\nविद्यां मानापमानाभ्यामात्मानं तु प्रमादतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2079091, "chapter_id": 2682, "verse_number": "१२-१८७-१२", "content_sanskrit": "यस्य सर्वे समारम्भा निराशाबन्धना द्विज।\nत्यागे यस्य हुतं सर्वं स त्यागी च स बुद्धिमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2079092, "chapter_id": 2682, "verse_number": "१२-१८७-१३", "content_sanskrit": "अहिंस्रः सर्वभूतानां मैत्रायणगतिश्चरेत्।\nपरिग्रहान्परित्यज्य भवेद्बुद्ध्या जितेन्द्रियः।\nअचलं स्थानमातिष्ठेदिह चामुत्र चोभयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2079093, "chapter_id": 2682, "verse_number": "१२-१८७-१४", "content_sanskrit": "तपोनित्येन दान्तेन मुनिना संयतात्मना।\nअजितं जेतुकामेन भाव्यं सङ्गेष्वसङ्गिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2079094, "chapter_id": 2682, "verse_number": "१२-१८७-१५", "content_sanskrit": "इन्द्रियैर्गृह्यते यद्यत्तत्तद्व्यक्तमिति स्थितिः।\nअव्यक्तमिति विज्ञेयं लिङ्गग्राह्यमतीन्द्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2079095, "chapter_id": 2682, "verse_number": "१२-१८७-१६", "content_sanskrit": "अविस्रम्भे न गन्तव्यं विस्रम्भे धारयेन्मनः।\nमनः प्राणे निगृह्णीयात्प्राणं ब्रह्मणि धारयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2079096, "chapter_id": 2682, "verse_number": "१२-१८७-१७", "content_sanskrit": "निर्वेदादेव निर्वायान्न च किंचिद्विचिन्तयेत्।\nसुखं वै ब्राह्मणो ब्रह्म स वै तेनाधिगच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2079097, "chapter_id": 2682, "verse_number": "१२-१८७-१८", "content_sanskrit": "शौचेन सततं युक्तः सदाचारसमन्वितः।\nसानुक्रोशश्च भूतेषु तद्द्विजातिषु लक्षणम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2079098, "chapter_id": 2682, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि सप्ताशीत्यधिकशततमोऽध्यायः॥ १८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]