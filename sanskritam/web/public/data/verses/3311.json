[{"id": 2106476, "chapter_id": 3311, "verse_number": "१६-४०-१", "content_sanskrit": "युधिष्ठिर उवाच।\nतथा महात्मनस्तस्य तपस्युग्रे च तस्थुषः।\nअनाथस्येव निधनं तिष्ठत्स्वस्मासु बन्धुषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2106477, "chapter_id": 3311, "verse_number": "१६-४०-२", "content_sanskrit": "दुर्विज्ञेया गतिर्ब्रह्मन्पुरुषाणां मतिर्मम।\nयत्र वैचित्रवीर्योसौ दग्ध एवं वनाग्निना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2106478, "chapter_id": 3311, "verse_number": "१६-४०-३", "content_sanskrit": "यस्य पुत्रशतं श्रीमदभवद्बाहुशालिनः।\nनागायुतबलो राजा स दग्धो हि दवाग्निना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2106479, "chapter_id": 3311, "verse_number": "१६-४०-४", "content_sanskrit": "यं पुरा पर्यवीजन्त तालवृन्तैर्वरस्त्रियः।\nतं गृध्राः पर्यवीजन्त दावाग्निपरिकालितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2106480, "chapter_id": 3311, "verse_number": "१६-४०-५", "content_sanskrit": "सूतमागधसङ्घैश्च शयानो यः प्रबोध्यते।\nधरण्यां स नृपः शेते विकृष्टो गृध्रवायसैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2106481, "chapter_id": 3311, "verse_number": "१६-४०-६", "content_sanskrit": "न च शोचामि गान्धारीं हतपुत्रां यशस्विनीम्।\nपतिलोकमनुप्राप्तां तथा भर्तृव्रते स्थिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2106482, "chapter_id": 3311, "verse_number": "१६-४०-७", "content_sanskrit": "पृथामेव च शोचामि या पुत्रैश्वर्यमृद्धिमत्।\nउत्सृज्य् सुमहद्दीप्तं वनवासमरोचयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2106483, "chapter_id": 3311, "verse_number": "१६-४०-८", "content_sanskrit": "धिग्राज्यमिदमस्माकं धिग्बलं धिक्पराक्रमम्।\nक्षत्रधर्मं च धिग्यस्मान्मृता जीवामहे वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2106484, "chapter_id": 3311, "verse_number": "१६-४०-९", "content_sanskrit": "सुसूक्ष्मा किल लोकस्य गतिर्द्विजवरोत्तम।\nयत्समुत्सृज्य राज्यं सा वनवासमरोचयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2106485, "chapter_id": 3311, "verse_number": "१६-४०-१०", "content_sanskrit": "युधिष्ठिरस्य जननी भीमस्य विजयस्य च।\nअनाथवत्कथं दग्धा इति मुह्यामि चिन्तयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2106486, "chapter_id": 3311, "verse_number": "१६-४०-११", "content_sanskrit": "वृथा संतर्पितो वह्निः खाण्डवे सव्यसाचिना।\nउपकारमजानन्स कृतघ्न इति मे मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2106487, "chapter_id": 3311, "verse_number": "१६-४०-१२", "content_sanskrit": "यत्रादहत्स भगवान्मातरं सव्यसाचिनः।\nकृत्वा यो ब्राह्मणच्छद्म भिक्षार्थी समुपागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2106488, "chapter_id": 3311, "verse_number": "१६-४०-१३", "content_sanskrit": "धिगग्निं धिक् च पार्थस्य विश्रुतां सत्यसन्धताम्।\nइदं कष्टतरं चान्यद्भगवन्प्रतिभाति मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2106489, "chapter_id": 3311, "verse_number": "१६-४०-१४", "content_sanskrit": "वृथाऽग्निना समायोगो यदभूत्पृथिवीपतेः।\nतथा तपस्विनस्तस्य राजर्षेः कौरवस्य ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2106490, "chapter_id": 3311, "verse_number": "१६-४०-१५", "content_sanskrit": "कथमेवंविधो मृत्युः प्रशास्य पृथिवीमिमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2106491, "chapter_id": 3311, "verse_number": "१६-४०-१६", "content_sanskrit": "तिष्ठत्सु मन्त्रपूतेषु तस्याग्निषु महावने।\nवृथाऽग्निना समायुक्तो निष्ठां प्राप्तः पिता मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2106492, "chapter_id": 3311, "verse_number": "१६-४०-१७", "content_sanskrit": "मन्ये पृथा वेपमाना कृशा धमनिसंतता।\nहा तात धर्मराजेति मामाक्रन्दन्महाभये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2106493, "chapter_id": 3311, "verse_number": "१६-४०-१८", "content_sanskrit": "भीम पर्याप्नुहि भयादिति चैवाभिवाशती।\nसमन्ततः परिक्षिप्ता माताऽभून्मे दवाग्निना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2106494, "chapter_id": 3311, "verse_number": "१६-४०-१९", "content_sanskrit": "सहदेवः प्रियस्तस्याः पुत्रेभ्योधिक एव तु।\nन चैनां मोक्षयामास वीरो माद्रवतीसुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2106495, "chapter_id": 3311, "verse_number": "१६-४०-२०", "content_sanskrit": "तच्छ्रुत्वा रुरुदुः सर्वे समालिङ्ग्य परस्परम्।\nपाण्डवाःक पञ्च दुःखार्ता भूतानीव युगक्षये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2106496, "chapter_id": 3311, "verse_number": "१६-४०-२१", "content_sanskrit": "तेषां तु पुरुषेन्द्राणां रुदतां रुदितस्वनः।\nप्रासादाभोगसंरुद्धे अन्वरौत्सीत्स रोदसी॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2106497, "chapter_id": 3311, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्रमवासिकपर्वणि नारदागमनपर्वणि चत्वारिंशोऽध्यायः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]