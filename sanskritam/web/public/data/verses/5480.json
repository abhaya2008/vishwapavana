[{"id": 2209563, "chapter_id": 5480, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2209564, "chapter_id": 5480, "verse_number": "१", "content_sanskrit": "त्रिगर्तैरभवद् युद्धं कृतवैरैः किरीटिनः ।\nमहारथसमाज्ञातैर्हतानां पुत्रनप्तृभिः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2209565, "chapter_id": 5480, "verse_number": "२", "content_sanskrit": "ते तमाज्ञाय सम्प्राप्तं याज्ञियं तुरगोत्तमम् ।\nविषयान्ते ततो वीरा दंसिताः पर्यवारयन् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2209566, "chapter_id": 5480, "verse_number": "३", "content_sanskrit": "रथिनो बद्धतूणीराः सदश्वैः समलङ्कृतैः ।\nपरिवार्य हयं राजन् ग्रहीतुमुपचक्रमुः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2209567, "chapter_id": 5480, "verse_number": "४", "content_sanskrit": "ततः किरीटी सञ्चिन्त्य तेषां राज्ञां चिकीर्षितम् ।\nवारयामास तान् सर्वान् सान्त्वपूर्वमरिन्दमः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2209568, "chapter_id": 5480, "verse_number": "५", "content_sanskrit": "तमनादृत्य ते सर्वे शरैरभ्यहनंस्तदा ।\nतमोरजोभ्यां सञ्छन्नान् तान् किरीटी न्यवारयत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2209569, "chapter_id": 5480, "verse_number": "६", "content_sanskrit": "अब्रवीच्च ततो जिष्णुः प्रहसन्निव भारत ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2209570, "chapter_id": 5480, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2209571, "chapter_id": 5480, "verse_number": "७", "content_sanskrit": "निवर्तध्वमधर्मज्ञाः श्रेयो जीवितमेव वः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2209572, "chapter_id": 5480, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2209573, "chapter_id": 5480, "verse_number": "८", "content_sanskrit": "स्वयं वीरः प्रयास्यन् वै धर्मराजेन वारितः ।\nअबान्धवा रणे वीर हन्तव्याः क्षत्रिया इति ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2209574, "chapter_id": 5480, "verse_number": "९", "content_sanskrit": "स तदा तद्वचः श्रुत्वा धर्मराजस्य धीमतः ।\nतान् निवर्तध्वमित्याह न न्यवर्तन्त चापि ते ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2209575, "chapter_id": 5480, "verse_number": "१०", "content_sanskrit": "ततस्त्रिगर्तराजानं सूर्यवर्माणमाहवे ।\nवितत्य शरजालेन प्रजहास धनञ्जयः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2209576, "chapter_id": 5480, "verse_number": "११", "content_sanskrit": "ततस्ते रथघोषेण खुरनेमिस्वनेन च ।\nपूरयन्तो दिशः सर्वा धनञ्जयमुपाद्रवन् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2209577, "chapter_id": 5480, "verse_number": "१२", "content_sanskrit": "सूर्यवर्मा ततः पार्थे शराणां नतपर्वणाम् ।\nशतान्यमुञ्चद् राजेन्द्र लाघवं त्वभिदर्शयन् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2209578, "chapter_id": 5480, "verse_number": "१३", "content_sanskrit": "तथा चान्ये महेष्वासा ये तस्यैवानुयायिनः ।\nमुमुचुः शरवर्षाणि धनञ्जयमुपाद्रवन् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2209579, "chapter_id": 5480, "verse_number": "१४", "content_sanskrit": "ततस्त्रिगर्तैर्निर्मुक्तान् बहुभिः सुबहून् शरान् ।\nचिच्छेद पाण्डवो राजन् ते भूमौ न्यपतन् तदा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2209580, "chapter_id": 5480, "verse_number": "१५", "content_sanskrit": "केतुवर्मा तु तेजस्वी तस्यैवावरजो युवा ।\nयुयुधे भ्रातुरर्थाय पाण्डवेन महात्मना ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2209581, "chapter_id": 5480, "verse_number": "१६", "content_sanskrit": "तमापतन्तं सम्प्रेक्ष्य केतुवर्माणमाहवे ।\nअभ्यघ्नन् निशितैर्बाणैः बीभत्सुः परवीरहा ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2209582, "chapter_id": 5480, "verse_number": "१७", "content_sanskrit": "केतुवर्मण्यभिहते धृतवर्मा महारथः ।\nरथेनाशु समावृत्य शरैर्जिष्णुमवाकिरत् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2209583, "chapter_id": 5480, "verse_number": "१८", "content_sanskrit": "तस्य तां शीघ्रतां ज्ञात्वा तुतोषातीव वीर्यवान् ।\nगुडाकेशो महातेजा बालस्य धृतवर्मणः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2209584, "chapter_id": 5480, "verse_number": "१९", "content_sanskrit": "न सन्दधानं ददृशे नाददानं च तं तदा ।\nकिरन्तमेव स शरान् ददृशे पाकशासनिः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2209585, "chapter_id": 5480, "verse_number": "२०", "content_sanskrit": "स तु तं पूजयामास धृतवर्माणमाहवे ।\nपरिवव्रुर्गुडाकेशं तत्राक्रुद्ध्यद् धनञ्जयः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2209586, "chapter_id": 5480, "verse_number": "२१", "content_sanskrit": "ततो योधान् जघानाशु तेषां स दश चाष्ट च ।\nमहेन्द्रवज्रप्रतिमैरायसैः निशितैः शरैः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2209587, "chapter_id": 5480, "verse_number": "२२", "content_sanskrit": "तांस्तु भग्नान् स सम्प्रेक्ष्य त्वरमाणो धनञ्जयः ।\nशरैराशीविषाकारैर्जघान स्वनवद्धसन् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2209588, "chapter_id": 5480, "verse_number": "२३", "content_sanskrit": "ते भग्नमनसः सर्वे त्रैगर्तास्तु महारथाः ।\nदिशो विदुद्रवू राजन् धनञ्जयशरार्दिताः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2209589, "chapter_id": 5480, "verse_number": "२४", "content_sanskrit": "हतावशिष्टा हि पुरा पार्थं दृष्टपराक्रमाः ।\nतमूचुः पुरुषव्याघ्रं संशप्तकनिषूदनम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2209590, "chapter_id": 5480, "verse_number": "", "content_sanskrit": "त्रैगर्ताः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2209591, "chapter_id": 5480, "verse_number": "२५", "content_sanskrit": "तव स्म किङ्कराः सर्वे सर्वे च वशगास्तव ।\nआज्ञापयस्व नः पार्थ प्रह्वान् प्रेष्यानिव स्थितान् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2209592, "chapter_id": 5480, "verse_number": "२६", "content_sanskrit": "करिष्यामः प्रियं सर्वे तव कौरवनन्दन ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2209593, "chapter_id": 5480, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2209594, "chapter_id": 5480, "verse_number": "२७", "content_sanskrit": "एतदाज्ञाय वचनं सर्वांस्तानब्रवीत् तदा ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2209595, "chapter_id": 5480, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2209596, "chapter_id": 5480, "verse_number": "२८", "content_sanskrit": "जीवितं रक्षत नृपाः शासनं गृह्यतां मम ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2209597, "chapter_id": 5480, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि त्रिगर्तयुद्धवर्णनं नाम चतुःसप्ततितमोऽध्यायः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]