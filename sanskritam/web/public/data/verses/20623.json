[{"id": 7000623000, "chapter_id": 20623, "verse_number": "५-८२-१", "content_sanskrit": "शिव उवाच ।\nअथ दीक्षाविधिं वक्ष्ये शृणु नारद तत्त्वतः ।\nश्रवणादेव मुच्येत विना तस्य विधानतः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000623001, "chapter_id": 20623, "verse_number": "५-८२-२", "content_sanskrit": "आविरंच्याज्जगत्सर्वं विज्ञाय नश्वरं बुधः ।\nआध्यात्मिकादि त्रिविध दुःखमेवानुभूय च ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000623002, "chapter_id": 20623, "verse_number": "५-८२-३", "content_sanskrit": "अनित्यत्वाच्च सर्वेषां सुखानां मुनिसत्तम ।\nदुःखपक्षे विनिक्षिप्य तानि तेभ्यो विवर्जितः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000623003, "chapter_id": 20623, "verse_number": "५-८२-४", "content_sanskrit": "विरज्य संसृतेर्हानौ साधनानि विचिंतयेत् ।\nअनुत्तमसुखस्यापि संप्राप्तौ भृशनिर्वृतः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000623004, "chapter_id": 20623, "verse_number": "५-८२-५", "content_sanskrit": "नराणां दुष्करत्वं हि विज्ञाय च महामतिः ।\nभृशमार्त्तस्ततो विप्र मां गुरुं शरणं व्रजेत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000623005, "chapter_id": 20623, "verse_number": "५-८२-६", "content_sanskrit": "शांतो विमत्सरः कृष्णे भक्तोऽनन्यप्रयोजनः ।\nअनन्यसाधनः श्रीमान्कामलोभविवर्जितः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000623006, "chapter_id": 20623, "verse_number": "५-८२-७", "content_sanskrit": "श्रीकृष्णरसतत्त्वज्ञः कृष्णमंत्रविदां वरः ।\nकृष्णमंत्राश्रयो नित्यं मंत्रभक्तः सदा शुचिः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000623007, "chapter_id": 20623, "verse_number": "५-८२-८", "content_sanskrit": "सद्धर्मशासकोनित्यं सदाचारनियोजकः ।\nसंप्रदायी कृपापूर्णो विरागी गुरुरुच्यते ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000623008, "chapter_id": 20623, "verse_number": "५-८२-९", "content_sanskrit": "एवमादिगुणः प्रायः शुश्रूषुर्गुरुपादयोः ।\nगुरौ नितांतभक्तश्च मुमुक्षुः शिष्य उच्यते ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000623009, "chapter_id": 20623, "verse_number": "५-८२-१०", "content_sanskrit": "यत्साक्षात्सेवनं तस्य प्रेम्णा भागवतो भवेत् ।\nस मोक्षः प्रोच्यते प्राज्ञैर्वेदवेदांगवेदिभिः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000623010, "chapter_id": 20623, "verse_number": "५-८२-११", "content_sanskrit": "आश्रित्य स्वगुरोः पादौ निजवृत्तं निवेदयेत् ।\nस संदेहानपाकृत्य बोधयित्वा पुनः पुनः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000623011, "chapter_id": 20623, "verse_number": "५-८२-१२", "content_sanskrit": "स्वपादप्रणतं शांतं शुश्रूषुं निजपादयोः ।\nअतिहृष्टमनाः शिष्यं मनुमध्यापयेत्परम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000623012, "chapter_id": 20623, "verse_number": "५-८२-१३", "content_sanskrit": "चंदनेन मृदा वापि विलिखेद्बाहुमूलयोः ।\nवामदक्षिणयोर्विप्र शंखचक्रे यथाक्रमम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000623013, "chapter_id": 20623, "verse_number": "५-८२-१४", "content_sanskrit": "ऊर्द्ध्वपुंड्रं ततः कुर्याद्भालादिषु विधानतः ।\nततोमंत्रद्वयं तस्य दक्षकर्णे विनिर्दिशेत् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000623014, "chapter_id": 20623, "verse_number": "५-८२-१५", "content_sanskrit": "मंत्रार्थं च वदेत्तस्मै यथावदनुपूर्वशः ।\nदासशब्दयुतं नाम धार्यं तस्य प्रयत्नतः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000623015, "chapter_id": 20623, "verse_number": "५-८२-१६", "content_sanskrit": "ततोऽतिभक्त्या सस्नेहं वैष्णवान्भोजयेद्बुधः ।\nश्रीगुरुं पूजयेच्चापि वस्त्रालंकरणादिभिः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000623016, "chapter_id": 20623, "verse_number": "५-८२-१७", "content_sanskrit": "सर्वस्वं गुरवे दद्यात्तदर्द्धं वा महामुने ।\nस्वदेहमपि निक्षिप्य गुरौ स्थेयमकिंचनैः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000623017, "chapter_id": 20623, "verse_number": "५-८२-१८", "content_sanskrit": "य एतैः पंचभिर्विद्वान्संस्कारैः संस्कृतो भवेत् ।\nदास्यभागी स कृष्णस्य नान्यथा कल्पकोटिभिः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000623018, "chapter_id": 20623, "verse_number": "५-८२-१९", "content_sanskrit": "अंकनं चोर्द्ध्वपुंड्रश्च मंत्रो नामविधारणम् ।\nपंचमो याग इत्युक्ताः संस्काराः पूर्वसूरिभिः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000623019, "chapter_id": 20623, "verse_number": "५-८२-२०", "content_sanskrit": "अंकनं शंखचक्राद्यैः सच्छिद्रं पुंड्रमुच्यते ।\nदासशब्दयुतं नाममंत्रो युगलसंज्ञकः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000623020, "chapter_id": 20623, "verse_number": "५-८२-२१", "content_sanskrit": "गुरुवैष्णवयोः पूजा याग इत्यभिधीयते ।\nएते परमसंस्कारा मया ते परिकीर्तिताः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000623021, "chapter_id": 20623, "verse_number": "५-८२-२२", "content_sanskrit": "अथ तुभ्यं प्रपन्नानां धर्मान्वक्ष्यामि नारद ।\nयानास्थाय गमिष्यंति हरिधाम नराः कलौ ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000623022, "chapter_id": 20623, "verse_number": "५-८२-२३", "content_sanskrit": "इत्थं गुरोर्लब्धमंत्रो गुरुभक्तिपरायणः ।\nसेवमानो गुरुं नित्यं तत्कृपां भावयेत्सुधीः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000623023, "chapter_id": 20623, "verse_number": "५-८२-२४", "content_sanskrit": "सतां धर्मां स्ततः शिक्षेत्प्रपन्नानां विशेषतः ।\nस्वेष्टदेवधिया नित्यं वैष्णवान्परितोषयेत् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000623024, "chapter_id": 20623, "verse_number": "५-८२-२५", "content_sanskrit": "ताडनं भर्त्सनं कामिभोग्यत्वेन यथा स्त्रियः ।\nगृह्णंति वैष्णवानां च तत्तद्ग्राह्यं तथा बुधैः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000623025, "chapter_id": 20623, "verse_number": "५-८२-२६", "content_sanskrit": "ऐहिक्यामुष्मिकी चिंता नैव कार्या कदाचन ।\nऐहिकं तु सदा भाव्यं पूर्वाचरितकर्मणा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000623026, "chapter_id": 20623, "verse_number": "५-८२-२७", "content_sanskrit": "आमुष्मिकं तथा कृष्णः स्वयमेव करिष्यति ।\nअतो हि तत्कृते त्याज्यः प्रयत्नः सर्वथा नरैः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000623027, "chapter_id": 20623, "verse_number": "५-८२-२८", "content_sanskrit": "सर्वोपायपरित्यागः कृष्णीयात्मतयार्चनम् ।\nसुचिरं प्रोषिते कांते यथा पतिपरायणा ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000623028, "chapter_id": 20623, "verse_number": "५-८२-२९", "content_sanskrit": "प्रियानुरागिणी दीना तस्यसंगैककांक्षिणी ।\nतद्गुणान्भावयेन्नित्यं गायत्यपि शृणोति च ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000623029, "chapter_id": 20623, "verse_number": "५-८२-३०", "content_sanskrit": "श्रीकृष्णगुणलीलादि स्मरणादि तथाचरेत् ।\nन पुनः साधनत्वेन कार्यं तत्तु कदाचन ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000623030, "chapter_id": 20623, "verse_number": "५-८२-३१", "content_sanskrit": "चिरं प्रोष्यागतं कांतं प्राप्य कांतधिया यथा ।\nचुंबंती वा श्लिष्यंतीव नेत्रांते न पिबंत्यपि ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000623031, "chapter_id": 20623, "verse_number": "५-८२-३२", "content_sanskrit": "ब्रह्मानंदगतेवाशु सेवते परया मुदा ।\nश्रीमदर्चावतारेण तथा परिचरेद्धरिम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000623032, "chapter_id": 20623, "verse_number": "५-८२-३३", "content_sanskrit": "अनन्यशरणो नित्यं तथैवानन्यसाधनः ।\nअनन्यसाधनार्थत्वात्स्यादनन्य प्रयोजनः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000623033, "chapter_id": 20623, "verse_number": "५-८२-३४", "content_sanskrit": "नान्यं च पूजयेद्देवं न नमेत्तं स्मरेन्न च ।\nन च पश्येन्न गायेच्च न च निंदेत्कदाचन ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000623034, "chapter_id": 20623, "verse_number": "५-८२-३५", "content_sanskrit": "नान्योच्छिष्टं च भुंजीत नान्यशेषं च धारयेत् ।\nअवैष्णवानां संभाषा वंदनादि विवर्जयेत् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000623035, "chapter_id": 20623, "verse_number": "५-८२-३६", "content_sanskrit": "ईशवैष्णवयोर्निंदां शृणुयान्न कदाचन ।\nकर्णौ पिधाय गंतव्यं शक्तौ दंडं समाचरेत् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000623036, "chapter_id": 20623, "verse_number": "५-८२-३७", "content_sanskrit": "आश्रित्य चातकीं वृत्तिं देहपातावधि द्विज ।\nद्वयस्यार्थं भावयित्वा स्थेयमित्येव मे मतिः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000623037, "chapter_id": 20623, "verse_number": "५-८२-३८", "content_sanskrit": "सरः समुद्र नद्यादीन्विहाय चातको यथा ।\nतृषितो म्रियते वापि याचते वा पयोधरम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000623038, "chapter_id": 20623, "verse_number": "५-८२-३९", "content_sanskrit": "एवमेव प्रयत्नेन साधनानि विचिंतयेत् ।\nस्वेष्टदेवःसदायाच्योगतिस्त्वंमेभवेरिति ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000623039, "chapter_id": 20623, "verse_number": "५-८२-४०", "content_sanskrit": "स्वेष्टदेव तदीयानां गुरोरपि विशेषतः ।\nआनुकूल्ये सदा स्थेयं प्रातिकूल्यं विवर्जयेत् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000623040, "chapter_id": 20623, "verse_number": "५-८२-४१", "content_sanskrit": "सकृत्प्रपन्नो वक्ष्यामि कल्याणगुणतां तयोः ।\nविचिंत्य विश्वसेदेतौ मामिमावुद्धरिष्यतः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000623041, "chapter_id": 20623, "verse_number": "५-८२-४२", "content_sanskrit": "संसारसागरान्नाथ मित्र पुत्र गृहा कुलात् ।\nगोप्तारौ मे युवामेव प्रपन्नभयभंजनौ ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000623042, "chapter_id": 20623, "verse_number": "५-८२-४३", "content_sanskrit": "योहं ममास्ति यत्किंचिदिह लोके परत्र च ।\nतत्सर्वं भवतोरद्य चरणेषु समर्चितम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000623043, "chapter_id": 20623, "verse_number": "५-८२-४४", "content_sanskrit": "अहमस्म्यपराधानामालयस्त्यक्त साधनः ।\nअगतिश्च ततो नाथौ भवंतावेव मे गतिः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000623044, "chapter_id": 20623, "verse_number": "५-८२-४५", "content_sanskrit": "तवास्मि राधिकाकांत कर्मणा मनसा गिरा ।\nकृष्णकांते तवैवास्मि युवामेव गतिर्मम ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000623045, "chapter_id": 20623, "verse_number": "५-८२-४६", "content_sanskrit": "शरणं वां प्रपन्नोऽस्मि करुणानिकराकरौ ।\nप्रसादं कुरु तं दास्यं मयि दुष्टेऽपराधिनि ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000623046, "chapter_id": 20623, "verse_number": "५-८२-४७", "content_sanskrit": "इत्येवं जपता नित्यं स्थातव्यं पद्यपंचकम् ।\nअचिरादेव तद्दास्यमिच्छता मुनिसत्तम ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000623047, "chapter_id": 20623, "verse_number": "५-८२-४८", "content_sanskrit": "बाह्यधर्मा मया ह्येते संक्षेपेणोपवर्णिताः ।\nआंतरः परमो धर्मः प्रपन्नानामथोच्यते ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000623048, "chapter_id": 20623, "verse_number": "५-८२-४९", "content_sanskrit": "कृष्णप्रिया सखीभावं समाश्रित्य प्रयत्नतः ।\nतयोः सेवां प्रकुर्वीत दिवानक्तमतंद्रितः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000623049, "chapter_id": 20623, "verse_number": "५-८२-५०", "content_sanskrit": "उक्तो मंत्रस्तदंगानि तथा तस्याधिकारिणः ।\nतद्धर्माश्च तथा तेभ्यः फलं मंत्रस्य नारद ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000623050, "chapter_id": 20623, "verse_number": "५-८२-५१", "content_sanskrit": "अनुतिष्ठ त्वमप्येतत्तयोर्दास्यमवाप्स्यसि ।\nस्वाधिकारक्षये विप्र संदेहो नात्र कश्चन ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000623051, "chapter_id": 20623, "verse_number": "५-८२-५२", "content_sanskrit": "सकृन्मात्रप्रपन्नाय तवास्मीति च याचते ।\nनिजदास्यं हरिर्दद्यान्न मेऽत्रास्ति विचारणा ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000623052, "chapter_id": 20623, "verse_number": "५-८२-५३", "content_sanskrit": "अत्र ते वर्णयिष्यामि रहस्यं परमाद्भुतम् ।\nश्रुतपूर्वं मया कृष्णात्साक्षाद्भगवतः परम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000623053, "chapter_id": 20623, "verse_number": "५-८२-५४", "content_sanskrit": "एष ते कथितो धर्म आंतरो मुनिसत्तम ।\nगुह्यादेष गुह्यतमो गोपनीयः प्रयत्नतः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000623054, "chapter_id": 20623, "verse_number": "५-८२-५५", "content_sanskrit": "मंत्ररत्नमहं पूर्वं जपन्कैलासमूर्द्धनि ।\nध्यायन्नारायणं देवमवसं गहने वने ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000623055, "chapter_id": 20623, "verse_number": "५-८२-५६", "content_sanskrit": "ततस्तु भगवांस्तुष्टः प्रादुरास ममाग्रतः ।\nव्रियतां वर इत्युक्ते मयाप्युद्घाट्य लोचने ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000623056, "chapter_id": 20623, "verse_number": "५-८२-५७", "content_sanskrit": "दृष्टो देवःप्रिया सार्द्धं संस्थितो गरुडोपरि ।\nप्रणिपत्यावोचमहं वरदं कमलापतिम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000623057, "chapter_id": 20623, "verse_number": "५-८२-५८", "content_sanskrit": "यद्रूपं ते कृपासिंधो परमानंददायकम् ।\nसर्वानंदाश्रयं नित्यं मूर्तिमत्सर्वतोऽधिकम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000623058, "chapter_id": 20623, "verse_number": "५-८२-५९", "content_sanskrit": "निर्गुणं निष्क्रियं शांतं यद्ब्रह्मेति विदुर्बुधाः ।\nतदहं द्रष्टुमिच्छामि चक्षुर्भ्यां परमेश्वर ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000623059, "chapter_id": 20623, "verse_number": "५-८२-६०", "content_sanskrit": "ततो मामाह भगवान्प्रपन्नं कमलापतिः ।\nतदद्य द्रक्ष्यसे रूपं यत्ते मनसि कांक्षितम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000623060, "chapter_id": 20623, "verse_number": "५-८२-६१", "content_sanskrit": "यमुना पश्चिमे तीरे गच्छ वृंदावनं मम ।\nइत्युक्त्वांतर्दधे देवः प्रियासार्द्धं जगत्पतिः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000623061, "chapter_id": 20623, "verse_number": "५-८२-६२", "content_sanskrit": "अहमप्यागतस्तर्हि यमुनायास्तटं शुभम् ।\nतत्र कृष्णमपश्यं च सर्वदेवेश्वरेश्वरम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000623062, "chapter_id": 20623, "verse_number": "५-८२-६३", "content_sanskrit": "गोपवेषधरं कांतं किशोरवयसान्वितम् ।\nप्रियास्कंधे सुविन्यस्त वामहस्तं मनोहरम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000623063, "chapter_id": 20623, "verse_number": "५-८२-६४", "content_sanskrit": "हसंतं हासयतं तां मध्ये गोपीकदंबके ।\nस्निग्धमेघसमाभासं कल्याणगुणमंदिरम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000623064, "chapter_id": 20623, "verse_number": "५-८२-६५", "content_sanskrit": "प्रहस्य च ततः कृष्णो मामाहामृतभाषणः ।\nअहं ते दर्शनं यातो ज्ञात्वा रुद्र तवेप्सितम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000623065, "chapter_id": 20623, "verse_number": "५-८२-६६", "content_sanskrit": "यदद्य मे त्वया दृष्टमिदं रूपमलौकिकम् ।\nघनीभूतामलप्रेम सच्चिदानंदविग्रहम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000623066, "chapter_id": 20623, "verse_number": "५-८२-६७", "content_sanskrit": "नीरूपं निर्गुणं व्यापि क्रियाहीनं परात्परम् ।\nवदंत्युपनिषत्संघा इदमेव ममानघम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000623067, "chapter_id": 20623, "verse_number": "५-८२-६८", "content_sanskrit": "प्रकृत्युत्थगुणाभावादनंतत्वात्तथेश्वरम् ।\nअसिद्धत्वान्मद्गुणानां निर्गुणं मां वदंति हि ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000623068, "chapter_id": 20623, "verse_number": "५-८२-६९", "content_sanskrit": "अदृश्यत्वान्ममैतस्य रूपस्य चर्मचक्षुषा ।\nअरूपं मां वदंत्येते वेदाः सर्वे महेश्वर ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000623069, "chapter_id": 20623, "verse_number": "५-८२-७०", "content_sanskrit": "व्यापकत्वाच्चिदंशेन ब्रह्मेति च विदुर्बुधाः ।\nअकर्तृत्वात्प्रपंचस्य निष्क्रियं मां वदंति हि ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000623070, "chapter_id": 20623, "verse_number": "५-८२-७१", "content_sanskrit": "मायागुणैर्यतोमेंऽशा कुर्वंति सर्जनादिकम् ।\nन करोमि स्वयं किंचित्सृष्ट्यादिकमहं शिव ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000623071, "chapter_id": 20623, "verse_number": "५-८२-७२", "content_sanskrit": "अहमासां महादेव गोपीनां प्रेमविह्वलः ।\nक्रियांतरं न जानामि नात्मानमपि नारद ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000623072, "chapter_id": 20623, "verse_number": "५-८२-७३", "content_sanskrit": "विहराम्यनया नित्यमस्याः प्रेमवशीकृतः ।\nइमां तु मत्प्रियां विद्धि राधिकां परदेवताम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000623073, "chapter_id": 20623, "verse_number": "५-८२-७४", "content_sanskrit": "अस्याश्च परितः पश्य सख्यः शतसहस्रशः ।\nनित्याः सर्वा इमा रुद्र यथाहं नित्यविग्रहः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000623074, "chapter_id": 20623, "verse_number": "५-८२-७५", "content_sanskrit": "गोपा गावो गोपिकाश्च सदा वृंदावनं मम ।\nसर्वमेतन्नित्यमेव चिदानंदरसात्मकम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000623075, "chapter_id": 20623, "verse_number": "५-८२-७६", "content_sanskrit": "इदमानंदकंदाख्यं विद्धि वृंदावनं मम ।\nयस्मिन्प्रवेशमात्रेण न पुनः संसृतिं विशेत् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000623076, "chapter_id": 20623, "verse_number": "५-८२-७७", "content_sanskrit": "मद्वनं प्राप्य यो मूढः पुनरन्यत्र गच्छति ।\nस आत्महा भवेदेव सत्यं सत्यं मयोदितम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000623077, "chapter_id": 20623, "verse_number": "५-८२-७८", "content_sanskrit": "वृंदावनं परित्यज्य नैव गच्छाम्यहं क्वचित् ।\nनिवसाम्यनया सार्द्धमहमत्रैव सर्वदा ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000623078, "chapter_id": 20623, "verse_number": "५-८२-७९", "content_sanskrit": "इत्येवं सर्वमाख्यातं यत्ते रुद्र हृदि स्थितम् ।\nकथयस्व ममेदानीं किमन्यच्छ्रोतुमिच्छसि ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000623079, "chapter_id": 20623, "verse_number": "५-८२-८०", "content_sanskrit": "ततस्तमब्रवं देवमहं च मुनिसत्तम ।\nईदृशस्त्वं कथं लभ्यस्तमुपायं वदस्व मे ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000623080, "chapter_id": 20623, "verse_number": "५-८२-८१", "content_sanskrit": "ततो मामाह भगवान्साधु रुद्र तवोदितम् ।\nअतिगुह्यतमं ह्येतद्गोपनीयं प्रयत्नतः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000623081, "chapter_id": 20623, "verse_number": "५-८२-८२", "content_sanskrit": "सकृदावां प्रपन्नो यस्त्यक्तोपाय उपासते ।\nगोपीभावेन देवेश स मामेति न चेतरः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000623082, "chapter_id": 20623, "verse_number": "५-८२-८३", "content_sanskrit": "सकृदावां प्रपन्नो वा मत्प्रियामेकिकामुत ।\nसेवतेनन्यभावेन स मामेति न संशयः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000623083, "chapter_id": 20623, "verse_number": "५-८२-८४", "content_sanskrit": "यो मामेव प्रपन्नश्च मत्प्रियां न महेश्वर ।\nन कदापि स चाप्नोति मामेवं ते मयोदितम् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000623084, "chapter_id": 20623, "verse_number": "५-८२-८५", "content_sanskrit": "सकृदेव प्रपन्नोयस्तवास्मीति वदेदपि ।\nसाधनेन विनाप्येव मामाप्नोति न संशयः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000623085, "chapter_id": 20623, "verse_number": "५-८२-८६", "content_sanskrit": "तस्मात्सर्वप्रयत्नेन मत्प्रियां शरणं व्रजेत् ।\nआश्रित्य मत्प्रियां रुद्र मां वशीकर्त्तुमर्हसि ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000623086, "chapter_id": 20623, "verse_number": "५-८२-८७", "content_sanskrit": "इदं रहस्यं परमं मया ते परिकीर्तितम् ।\nत्वयाप्येतन्महादेव गोपनीयं प्रयत्नतः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000623087, "chapter_id": 20623, "verse_number": "५-८२-८८", "content_sanskrit": "त्वमप्येनां समाश्रित्य राधिकां मम वल्लभाम् ।\nजपन्मे युगलं मंत्रं सदा तिष्ठ मदालये ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000623088, "chapter_id": 20623, "verse_number": "५-८२-८९", "content_sanskrit": "शिव उवाच ।\nइत्युक्त्वा दक्षिणे कर्णे मम कृष्णो दयानिधिः ।\nउपदिश्य परं मंत्रं संस्कारांश्च विधाय हि ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000623089, "chapter_id": 20623, "verse_number": "५-८२-९०", "content_sanskrit": "सगणोंऽतर्दधे विप्र तत्रैव मम पश्यतः ।\nअहमप्यत्र तिष्ठामि तदारभ्य निरंतरम् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000623090, "chapter_id": 20623, "verse_number": "५-८२-९१", "content_sanskrit": "सर्वमेतन्मया तुभ्यं सांगमेव प्रकीर्त्तितम् ।\nअधुना वद विप्रेंद्र किं भूयः श्रोतुमिच्छसि ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}]