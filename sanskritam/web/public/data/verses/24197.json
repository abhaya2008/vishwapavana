[{"id": 7004197000, "chapter_id": 24197, "verse_number": "५-१-४६-१", "content_sanskrit": "सनत्कुमार उवाच ।\nअमरावती यथा जाता पुरी ह्येषा कुशस्थली ।\nशृणु व्यास महाभाग यथा ब्रह्माब्रवीत्सुरान्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004197001, "chapter_id": 24197, "verse_number": "५-१-४६-२", "content_sanskrit": "तथाहं संप्रवक्ष्यामि विस्तरेण तपोधन ।\nएकदा ब्रह्मणादिष्टः प्रजार्थमृषिसत्तमः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004197002, "chapter_id": 24197, "verse_number": "५-१-४६-३", "content_sanskrit": "मारीचः कश्यपस्तेपे तपः परमदुष्करम् ।\nमहाकालवने रम्ये दिव्ये स हि महानृषिः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004197003, "chapter_id": 24197, "verse_number": "५-१-४६-४", "content_sanskrit": "शीर्णपत्रानिलाहारो वायुभक्षी जितेन्द्रियः ।\nपूर्णे वर्षसहस्रे तु वागुवाचाशरीरिणी॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004197004, "chapter_id": 24197, "verse_number": "५-१-४६-५", "content_sanskrit": "श्रूयतां भो द्विजश्रेष्ठ मम वाक्यमनुत्तमम् ।\nयस्मात्तपसि तपस्तीव्रं फलमुद्दिश्य सुव्रत॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004197005, "chapter_id": 24197, "verse_number": "५-१-४६-६", "content_sanskrit": "तस्मात्ते संततिस्तात यावच्चंद्रदिवाकरौ ।\nतावत्तिष्ठतु मेदिन्यां यशसा पुत्रपौत्रकैः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004197006, "chapter_id": 24197, "verse_number": "५-१-४६-७", "content_sanskrit": "अदितिस्ते सती भार्या त्वया सहाचरत्तपः ।\nतस्मात्सर्वेषु कालेषु छायाभूता यशस्विनी॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004197007, "chapter_id": 24197, "verse_number": "५-१-४६-८", "content_sanskrit": "भविष्यंति सुताः सर्वे विष्णुश्चेंद्रपुरोगमाः ।\nअमरा निर्जरा देवा दिवि ख्याताः सदैव हि॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004197008, "chapter_id": 24197, "verse_number": "५-१-४६-९", "content_sanskrit": "त्वं चापि च ऋषिश्रेष्ठः प्रजापतिरकल्मषः ।\nभविष्यसि न संदेहो ममवाक्याद्द्विजोत्तम॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004197009, "chapter_id": 24197, "verse_number": "५-१-४६-१०", "content_sanskrit": "इत्युक्त्वा च पुन र्देवी तत्रैवांतरधीयत ।\nतदारभ्य पुरीं व्यास कुशस्थलीमनुत्तमाम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004197010, "chapter_id": 24197, "verse_number": "५-१-४६-११", "content_sanskrit": "कश्यपः सह दाक्षिण्या साग्निकः समुपाश्रितः ।\nप्रजापि ववृधे तस्मा त्सदेवासुरमानुषा॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004197011, "chapter_id": 24197, "verse_number": "५-१-४६-१२", "content_sanskrit": "मरीचेः कश्यपो जज्ञे ततः सर्वं प्रतिष्ठितम् ।\nसुधापानकृतो देवाः शश्वत्तेनामराः कृताः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004197012, "chapter_id": 24197, "verse_number": "५-१-४६-१३", "content_sanskrit": "नंदनं चापि तत्रैव महाकालवनोत्तमे ।\nकामधेनुः समाख्याता मनोरथवरप्रदा॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004197013, "chapter_id": 24197, "verse_number": "५-१-४६-१४", "content_sanskrit": "सा सिषेवे सदा तत्र महाकालं महेश्वरम् ।\nपारिजाततरुश्रेष्ठस्तथा चाम्लानपंकजम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004197014, "chapter_id": 24197, "verse_number": "५-१-४६-१५", "content_sanskrit": "बिंदुसरः समाख्यातं मानसं सर उत्तमम् ।\nहंससारससमाकीर्णं सुरसिद्धनिषेवितम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004197015, "chapter_id": 24197, "verse_number": "५-१-४६-१६", "content_sanskrit": "मुक्तामणिगणाकीर्णं रत्नशोभनशोभितम् ।\nनिधिरेष महापद्मः कह्लारकुमुदोज्ज्वलः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004197016, "chapter_id": 24197, "verse_number": "५-१-४६-१७", "content_sanskrit": "यानि यानि च दिव्यानि संति ब्रह्माण्डगोलके ।\nतानि सर्वाणि तिष्ठंति महाकालवने शुभे॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004197017, "chapter_id": 24197, "verse_number": "५-१-४६-१८", "content_sanskrit": "तेनतेनात्मयोगेन मानवाश्चात्र संस्थिताः ।\nतदाहारास्तदाचारास्तद्रूपास्तत्पराक्रमाः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004197018, "chapter_id": 24197, "verse_number": "५-१-४६-१९", "content_sanskrit": "अन्योन्यं च समाकीर्णा सर्वे चामरसंनिभाः ।\nविचरंति यथा देवाः पुरीमेतां जना भुवि॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004197019, "chapter_id": 24197, "verse_number": "५-१-४६-२०", "content_sanskrit": "अमरांगनासमा नार्यः सदैव स्थिरयौवनाः ।\nईदृशी च पुरी दृष्टा भुवि व्यास सनातनी॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004197020, "chapter_id": 24197, "verse_number": "५-१-४६-२१", "content_sanskrit": "देवदानवगन्धर्वैः किन्नरोरगराक्षसैः ।\nभुक्तिमुक्तिप्रदा नित्या बहुकालफलप्रदा॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004197021, "chapter_id": 24197, "verse_number": "५-१-४६-२२", "content_sanskrit": "अमराणां कटकं ह्यत्र तस्माजातामरावती ।\nय एतस्यां महाभागाः प्रसंगेन समागताः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004197022, "chapter_id": 24197, "verse_number": "५-१-४६-२३", "content_sanskrit": "स्नानदानादिकं कृत्वा पश्यत्येव महेश्वरम् ।\nन तेषां दुर्लभं किञ्चित्पुत्रतो धनतोऽपि वा॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004197023, "chapter_id": 24197, "verse_number": "५-१-४६-२४", "content_sanskrit": "सर्वभोगानवाप्नोति मृतः शिवपुरं व्रजेत् ।\nपठनाच्छ्रवणाद्वापि शतरुद्रियफलं लभेत्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]