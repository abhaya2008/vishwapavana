[{"id": 2094601, "chapter_id": 3023, "verse_number": "१३-१५३-१", "content_sanskrit": "`युधिष्ठिर उवाच।\nकेषां देवा महाभागाः सन्नमन्ते महात्मनाम्।\nलोकेऽस्मिंस्तनृषीन्सर्वञ्श्रोतुमिच्छामि सत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2094602, "chapter_id": 3023, "verse_number": "१३-१५३-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2094603, "chapter_id": 3023, "verse_number": "१३-१५३-२", "content_sanskrit": "इतिहासमिमं विप्राः कीर्तयन्ति पुराविदः।\nअस्मिन्नर्थे महाप्राज्ञास्तं निबोध युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2094604, "chapter_id": 3023, "verse_number": "१३-१५३-३", "content_sanskrit": "वृत्रं हत्वाऽप्युपावृत्तं त्रिदशानां पुरस्कृतम्।\nमहेन्द्रमनुसम्प्राप्तं स्तूयमानं महर्षिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2094605, "chapter_id": 3023, "verse_number": "१३-१५३-४", "content_sanskrit": "श्रिया परमया युक्तं रथस्थं हरिवाहनम्।\nमातलिः प्राञ्जलिर्भूत्वा देवमिन्द्रमुघाच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2094606, "chapter_id": 3023, "verse_number": "१३-१५३-५", "content_sanskrit": "नमस्कृतानां सर्वेषां भगवंस्त्वं पुरस्कृतः।\nयेषां लोके नमस्कुर्यात्तान्ब्रवीतु भवान्मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2094607, "chapter_id": 3023, "verse_number": "१३-१५३-६", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा देवराजः शचीपतिः।\nयन्तारं परिपृच्छन्तं तमिन्द्रः प्रत्युवाच सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2094608, "chapter_id": 3023, "verse_number": "१३-१५३-७", "content_sanskrit": "धर्मं चार्थं च कामं च येषां चिन्तयतां मतिः।\nनाधर्मे वर्तते नित्यं तान्नमस्यामि मातले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2094609, "chapter_id": 3023, "verse_number": "१३-१५३-८", "content_sanskrit": "ये रूपगुणसम्पन्नाः प्रमदाहृदयंगमाः।\nनिवृत्ताः कामभोगेषु तान्नमस्यामि मातले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2094610, "chapter_id": 3023, "verse_number": "१३-१५३-९", "content_sanskrit": "स्वेषु भोगेषु सन्तुष्टाः सुवाचो वचनक्षमाः।\nअमानकामाश्चार्घार्हास्तान्नमस्यामि मातले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2094611, "chapter_id": 3023, "verse_number": "१३-१५३-१०", "content_sanskrit": "धनं विद्यास्तथैश्वर्यं येषां न चलयेन्मतिम्।\nचलितां ये निगृह्णन्ति तान्नित्यं पूजयाम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2094612, "chapter_id": 3023, "verse_number": "१३-१५३-११", "content_sanskrit": "इष्टैर्दारैरुपेतानां शुचीनामग्निहोत्रिणाम्।\nचतुष्पादकुटुम्बानां मातिले प्रणमाम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2094613, "chapter_id": 3023, "verse_number": "१३-१५३-१२", "content_sanskrit": "महतस्तपसा प्राप्तौ धनस्य विपुलस्य च।\nकत्यागस्तस्य न वै कार्यो योऽऽत्मानं नावबुध्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2094614, "chapter_id": 3023, "verse_number": "१३-१५३-१३", "content_sanskrit": "येषामर्थस्तथा कामो धर्ममूलविवर्धितः।\nधर्मार्थौ तस्य नियतौ तान्नमस्यामि मातले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2094615, "chapter_id": 3023, "verse_number": "१३-१५३-१४", "content_sanskrit": "धर्ममूलार्थकामानां ब्राह्मणानां गवामपि॥\nपतिव्रतानां नारीणां प्रणामं प्रकरोम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2094616, "chapter_id": 3023, "verse_number": "१३-१५३-१५", "content_sanskrit": "ये भुक्त्वा मानुषान्भोगान्पूर्वे वयसि मातले।\nतपसा स्वर्गमायान्ति शश्वत्तान्पूजयाम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2094617, "chapter_id": 3023, "verse_number": "१३-१५३-१६", "content_sanskrit": "असंभोगान्नचासक्तान्धर्मनित्याञ्जितेन्द्रियान्।\nसंन्यस्तानचलप्रख्यान्मनसा पूजयामि तान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2094618, "chapter_id": 3023, "verse_number": "१३-१५३-१७", "content_sanskrit": "ज्ञानप्रसन्नविद्यानां निरूढं धर्ममीप्सितम्।\nपरैः कीर्तितशौचानां मातले तान्नमाम्यहम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2094619, "chapter_id": 3023, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि त्रिपञ्चाशदधिकशततमोऽध्यायः॥ १५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]