[{"id": 2101770, "chapter_id": 3196, "verse_number": "१४-५२-१", "content_sanskrit": "वैशम्पायन उवाच।\nततोऽभ्यनोदयत्कृष्णो युज्यतामिति दारुकम्।\nमुहूर्तादिव चाचष्ट युक्तमित्येव दारुकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2101771, "chapter_id": 3196, "verse_number": "१४-५२-२", "content_sanskrit": "तथैव चानुयात्राणि चोदयामास पाण्डवः।\nसन्नह्यध्वं प्रयास्यामो नगर गजसाह्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2101772, "chapter_id": 3196, "verse_number": "१४-५२-३", "content_sanskrit": "इत्युक्ताः सैनिकास्ते तु सज्जीभूता विशाम्पते।\nआचख्युः सज्जमित्येवं पार्थायामिततेजसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2101773, "chapter_id": 3196, "verse_number": "१४-५२-४", "content_sanskrit": "ततस्तौ रथमास्थाय प्रयातौ कृष्णपाण्डवौ।\nविकुर्वाणौ कताश्चित्राः प्रीयमाणौ विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2101774, "chapter_id": 3196, "verse_number": "१४-५२-५", "content_sanskrit": "रथस्थं तु महातेजा वासुदेवं धनञ्जयः।\nपुनरेवाब्रवीद्वाक्यमिदं भरतसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2101775, "chapter_id": 3196, "verse_number": "१४-५२-६", "content_sanskrit": "त्वत्प्रसादाज्ज्यः प्राप्तो राज्ञा वृष्णिकुलोद्वह।\nनिहताः शत्रवश्चापि प्राप्तं राज्यमकण्टकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2101776, "chapter_id": 3196, "verse_number": "१४-५२-७", "content_sanskrit": "नाथवन्तश्च भवता पाण्डवा मधुसूदन।\nभवन्तं प्लवमासाद्य तीर्णाः स्म कुरुसागरम्।\n`भक्तांस्त्वमाश्रितानस्मान्पालयामुत्र चेह च।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2101777, "chapter_id": 3196, "verse_number": "१४-५२-८", "content_sanskrit": "विश्वकर्मन्नमस्तेऽस्तु विश्वात्मन्विश्वसत्तम।\nतथा त्वामभिजानामि तथा चाहं भवान्मतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2101778, "chapter_id": 3196, "verse_number": "१४-५२-९", "content_sanskrit": "त्वत्तेजःसम्भवो नित्यं हुताशो मधुसूदन।\nरतिः क्रीडामयी तुभ्यं माया ते रोदसी विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2101779, "chapter_id": 3196, "verse_number": "१४-५२-१०", "content_sanskrit": "त्वयि सर्वमिदं विश्वं यदिदं स्थाणु जङ्गमम्।\nत्वं हि सर्वं विकुरुषे भूतग्रामं चतुर्विधम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2101780, "chapter_id": 3196, "verse_number": "१४-५२-११", "content_sanskrit": "पृथिवीं चान्तरिक्षं च तथा स्थावरजङ्गमम्।\nहसिंतं तेऽमला ज्योत्स्ना ऋतवश्चेन्द्रियाणि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2101781, "chapter_id": 3196, "verse_number": "१४-५२-१२", "content_sanskrit": "प्राणो वायुः सततगः क्रोधो मृत्युः सनातनः।\nप्रसादे चापि पद्मा श्रीर्नित्यं त्वयि महामते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2101782, "chapter_id": 3196, "verse_number": "१४-५२-१३", "content_sanskrit": "रतिस्तुष्टिर्धृतिः क्षान्तिर्मतिः कान्तिश्चराचरम्।\nत्वमेवेह युगान्तेषु निधनं प्रोच्यसेऽनध॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2101783, "chapter_id": 3196, "verse_number": "१४-५२-१४", "content_sanskrit": "सुदीर्घेणापि कालेन न ते शक्या गुणा मया।\nआत्मा च परमो वक्तुं नमस्ते नलिनेक्षण॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2101784, "chapter_id": 3196, "verse_number": "१४-५२-१५", "content_sanskrit": "विदितो मे सुदुर्धर्ष नारदाद्देवलात्तथा।\nकृष्णद्वैपायनाच्चेव तथा कुरुपितामहात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2101785, "chapter_id": 3196, "verse_number": "१४-५२-१६", "content_sanskrit": "त्वयि सर्वं समासक्तं त्वमेवैको जनेश्वरः।\nयच्चानुग्रहसंयुक्तमेतदुक्तं त्वयाऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2101786, "chapter_id": 3196, "verse_number": "१४-५२-१७", "content_sanskrit": "एतत्सर्वमहं सम्यगाचरिष्ये जनार्दन।\nइदं चाद्भुतमत्यन्तं कृतमस्मत्प्रियेप्सया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2101787, "chapter_id": 3196, "verse_number": "१४-५२-१८", "content_sanskrit": "यत्पापो निहतः सङ्ख्ये कौरव्यो धृतराष्ट्रजः।\nत्वया दग्धं हि तत्सैन्यं मया विजितमाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2101788, "chapter_id": 3196, "verse_number": "१४-५२-१९", "content_sanskrit": "भवता तत्कृतं कर्म येनावाप्तो जयो मया।\nदुर्योधनस्य सङ्ग्रामे तव बुद्धिपराक्रमैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2101789, "chapter_id": 3196, "verse_number": "१४-५२-२०", "content_sanskrit": "कर्णस्य च वधोपायो यथावत्सम्प्रदर्शितः।\nसैन्धवस्य च पापस्य भूरिश्रवस एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2101790, "chapter_id": 3196, "verse_number": "१४-५२-२१", "content_sanskrit": "`तस्मात्त्वमेव सञ्चिन्त्य हितं कुरु यथा तथा।\nअहं च प्रीयमाणेन त्वया देवकिनन्दन।\nयदुक्तस्तत्करिष्यामि न हि मेऽत्र विचारणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2101791, "chapter_id": 3196, "verse_number": "१४-५२-२२", "content_sanskrit": "राजानं च समासाद्य धर्मात्मानं युधिष्ठिरम्।\nचोदयिष्यामि धर्मज्ञ गमनार्थं तवानघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2101792, "chapter_id": 3196, "verse_number": "१४-५२-२३", "content_sanskrit": "आहृतं हि ममैतत्ते द्वारकागमनं प्रभो।\nअचिरादेव द्रष्टा त्वं मातुलं मे जनार्दन।\nबलदेवं च दुर्धर्षं तथाऽन्यान्वृष्णिपुङ्गवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2101793, "chapter_id": 3196, "verse_number": "१४-५२-२४", "content_sanskrit": "एवं सम्भाषमाणौ तौ प्राप्तौ वारणसाह्वयम्।\nतथा विविशतुश्चोभौ सम्प्रहृष्टनराकुलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2101794, "chapter_id": 3196, "verse_number": "१४-५२-२५", "content_sanskrit": "तौ गत्वा धृतराष्ट्रस्य गृहं शक्रगृहोपमम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2101795, "chapter_id": 3196, "verse_number": "१४-५२-२५", "content_sanskrit": "ददृशाते महाराज धृतराष्ट्रं जनेश्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2101796, "chapter_id": 3196, "verse_number": "१४-५२-२६", "content_sanskrit": "विदुरं च महाबुद्धिं राजानं च युधिष्ठिरम्।\nभीमसेनं च दुर्धर्षं माद्रीपुत्रौ च पाण्डवौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2101797, "chapter_id": 3196, "verse_number": "१४-५२-२७", "content_sanskrit": "धृतराष्ट्रमुपासीनं युयुत्सुं चापराजितम्।\nगान्धारीं च महाप्रज्ञां पृथा कृष्णां च भामिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2101798, "chapter_id": 3196, "verse_number": "१४-५२-२८", "content_sanskrit": "सुभद्राद्याश्च ताः सर्वा भरतानां स्त्रियस्तथा।\nददृशाते स्त्रियः सर्वा गान्धारीपरिचारिकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2101799, "chapter_id": 3196, "verse_number": "१४-५२-२९", "content_sanskrit": "ततः समेत्य राजानं धृतराष्ट्रमरिंदमौ।\nनिवेद्य नामधेये स्वे तस्य पादावगृह्णताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2101800, "chapter_id": 3196, "verse_number": "१४-५२-३०", "content_sanskrit": "गान्धार्याश्च पृथायाश्च धर्मराजस्य चैव हि।\nभीमस्य च महात्मानौ तथा पादावगृह्णताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2101801, "chapter_id": 3196, "verse_number": "१४-५२-३१", "content_sanskrit": "क्षत्तारं चापि सङ्गृह्य पृष्ट्वा कुशलमव्ययम्।\n`परिष्वज्य महात्मानं वेश्यापुत्रं महारथम्।\nतैः सार्धं नृपतिं वृद्धं ततस्तौ पर्युपासताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2101802, "chapter_id": 3196, "verse_number": "१४-५२-३२", "content_sanskrit": "ततो निशि महाराजो धृतराष्ट्रः कुरूद्वहान्।\nजनार्दनं च मेधावी व्यसर्जयत वै गृहान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2101803, "chapter_id": 3196, "verse_number": "१४-५२-३३", "content_sanskrit": "तेऽनुज्ञाता नृपतिना ययुः स्वं स्वं निवेशनम्।\nधनंजयगृहानेव ययौ कृष्णस्तु वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2101804, "chapter_id": 3196, "verse_number": "१४-५२-३४", "content_sanskrit": "तत्रार्चितो यथान्यायं सर्वकामैरुपस्थितः।\nकृष्णः सुष्वाप मेधावी धनंजयसहायवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2101805, "chapter_id": 3196, "verse_number": "१४-५२-३५", "content_sanskrit": "प्रभातायां तु शर्वर्यां कृत्वा पौर्वाह्णिकीं क्रियाम्।\nधर्मराजस्य भनं जग्मतुः परमार्चितौ।\nयत्रास्ते स सहामात्यो धर्मराजो महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2101806, "chapter_id": 3196, "verse_number": "१४-५२-३६", "content_sanskrit": "तौ प्रविश्य महात्मानौ तद्गृहं परमार्चितम्।\nधर्मराजं ददृशतुर्देवराजमिवाश्विनौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2101807, "chapter_id": 3196, "verse_number": "१४-५२-३७", "content_sanskrit": "समासाद्य तु राजानं वार्ष्णेयकुरुपुङ्गवौ।\nनिषीदतुरनुज्ञातौ प्रीयमाणेन तेन तौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2101808, "chapter_id": 3196, "verse_number": "१४-५२-३८", "content_sanskrit": "ततः स राजा मेधावी विवक्षू प्रेक्ष्य तावुभौ।\nप्रोवाच वदतां श्रेष्ठो वचनं राजसत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2101809, "chapter_id": 3196, "verse_number": "१४-५२-३९", "content_sanskrit": "विवक्षू हि युवां मन्ये वीरौ यदुकुरूद्वहौ।\nब्रूतं कर्तास्मि सर्वं वां नचिरान्मा विचार्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2101810, "chapter_id": 3196, "verse_number": "१४-५२-४०", "content_sanskrit": "इत्युक्तः फल्गुनस्तत्र धर्मराजानमब्रवीत्।\nविनीतवदुपागम्य वाक्यं वाक्यविशारदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2101811, "chapter_id": 3196, "verse_number": "१४-५२-४१", "content_sanskrit": "अयं चिरोषितो राजन्वासुदेवः प्रतापवान्।\nभवन्तं समनुज्ञाप्य पितरं द्रष्टुमिच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2101812, "chapter_id": 3196, "verse_number": "१४-५२-४२", "content_sanskrit": "स गच्छेदभ्यनुज्ञातो भवता यदि मन्यसे।\nआनर्तनगरीं वीरस्तदनुज्ञातुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2101813, "chapter_id": 3196, "verse_number": "१४-५२-४३x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2101814, "chapter_id": 3196, "verse_number": "१४-५२-४३", "content_sanskrit": "पुण्डरीकाक्ष भद्रं ते गच्छ त्वं मदुसूदन।\nपुरीं द्वारवतीमद्य द्रष्टुं शूरसुतं प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2101815, "chapter_id": 3196, "verse_number": "१४-५२-४४", "content_sanskrit": "रोचते मे महाबाहो गमनं तव केशव।\nमातुलश्चिरदृष्टो मे त्वया देवी च देवकी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2101816, "chapter_id": 3196, "verse_number": "१४-५२-४५", "content_sanskrit": "समेत्यि मातुलं गत्वा बलदेवं च मानद।\nपूजयेथा महाप्राज्ञ मद्वाक्येन यथाऽर्हतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2101817, "chapter_id": 3196, "verse_number": "१४-५२-४६", "content_sanskrit": "स्मरेथाश्चापि मां नित्यं भीमं च बलिनां वरम्।\nफाल्गुनं सहदेवं च नकुलं चैव मानद॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2101818, "chapter_id": 3196, "verse_number": "१४-५२-४७", "content_sanskrit": "आनर्तानवलोक्य त्वं पितरं च महाभुजः।\nवृष्णींश्च पुनरागच्छेर्हयमेधे ममानघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2101819, "chapter_id": 3196, "verse_number": "१४-५२-४८", "content_sanskrit": "स गच्छ रत्नान्यादाय विविधानि वसूनि च।\nयच्चप्यन्यन्मनोज्ञं ते तदप्यादत्स्व सात्वत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2101820, "chapter_id": 3196, "verse_number": "१४-५२-४९", "content_sanskrit": "इयं च वसुधा कृत्स्ना प्रसादात्तव केशव।\nअस्मानुपागता वीर निहताश्चापि शत्रवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2101821, "chapter_id": 3196, "verse_number": "१४-५२-५०", "content_sanskrit": "स्वर्गापवर्गविषयं त्वद्भक्तानां न दुर्लभम्।\nसंसारगहने चेद्धपापाग्निप्रशमाम्बुद॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2101822, "chapter_id": 3196, "verse_number": "१४-५२-५१", "content_sanskrit": "एवं ब्रुवति कौरव्ये धर्मराजे युधिष्ठिरे।\nवासुदेवो वरः पुंसामिदं वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2101823, "chapter_id": 3196, "verse_number": "१४-५२-५२", "content_sanskrit": "तवैव रत्नानि धनं च केवलं\nधरा तु कृत्स्ना तु महाभुजाद्य वै।\nयदस्ति चान्यद्द्रविणं गृहे मम\nत्वमेव तस्येश्वर नित्यमीश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2101824, "chapter_id": 3196, "verse_number": "१४-५२-५३", "content_sanskrit": "तथेत्यथोक्तः प्रतिपूजितस्तदा\nगदाग्रजो धर्मसुतेन वीर्यवान्।\nपितृष्वसारं त्ववदद्यथाविधि\nसम्पूजितश्चाप्यगमत्प्रदक्षिणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2101825, "chapter_id": 3196, "verse_number": "१४-५२-५४", "content_sanskrit": "तया स सम्यक् प्रतिनन्दितस्तत-\nस्तथैव सर्वैर्विदुरादिभिस्तथा।\nविनिर्ययौ नागपुराद्गदाग्रजो\nरथेन दिव्येन चतुर्भुजः स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2101826, "chapter_id": 3196, "verse_number": "१४-५२-५५", "content_sanskrit": "रथे सुभद्रामधिरोप्य भामिनीं\nयुधिष्ठिरस्यानुमते जनार्दनः।\nपितृष्वसुश्चापि तथा महाभुजो\nविनिर्ययौ पौरजनाभिसंवृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2101827, "chapter_id": 3196, "verse_number": "१४-५२-५६", "content_sanskrit": "तमन्वयाद्वानरवर्यकेतनः\nससात्यकिर्माद्रवतीसुतावपि।\nअगाधबुद्धिर्विदुरश्च माधवं\nस्वयं च भीमो गजराजविक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2101828, "chapter_id": 3196, "verse_number": "१४-५२-५७", "content_sanskrit": "निवर्तयित्वा कुरुराष्ट्रवर्धनां-\nस्ततः स सर्वान्विदुरं च वीर्यवान्।\nजनार्दनो दारुकमाह सत्वरः\nप्रचोदयाश्वानिति सात्यकिं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2101829, "chapter_id": 3196, "verse_number": "१४-५२-५८", "content_sanskrit": "ततो ययौ शत्रुगणप्रमर्दनः\nशिनिप्रवीरानुगतो जनार्दनः।\nयथा निहत्यारिगणं शतकतु-\nर्दिवं तथाऽऽनर्तपुरीं प्रतापवान्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2101830, "chapter_id": 3196, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि द्विपञ्चसोऽध्यायः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}]