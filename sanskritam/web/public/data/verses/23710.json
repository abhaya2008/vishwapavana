[{"id": 7003710000, "chapter_id": 23710, "verse_number": "१-४-१८-१", "content_sanskrit": "नंदिकेश्वर उवाच ।\nगार्हस्थ्यं बिभ्रती भर्तुरेकाम्रतलवासिनः ।\nपक्वान्नपानैस्सा तत्र पर्य्यतर्पयत प्रजाः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003710001, "chapter_id": 23710, "verse_number": "१-४-१८-२", "content_sanskrit": "जातु संध्यानुसंधानमुकुलीकृतलोचनम् ।\nबद्धांजलिपुटं देवमद्राक्षीदद्रिनंदिनी ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003710002, "chapter_id": 23710, "verse_number": "१-४-१८-३", "content_sanskrit": "ध्यायते नूनमधुना कापि सौभाग्यशालिनी ।\nक्रियते यन्मयि प्रेम तन्मन्ये वचनं महत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003710003, "chapter_id": 23710, "verse_number": "१-४-१८-४", "content_sanskrit": "कथं विज्ञायते पुंसां कुटिला मानसी स्थितिः ।\nमिथ्योपचाराद्दक्षेण वंचितास्म्यमुना भृशम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003710004, "chapter_id": 23710, "verse_number": "१-४-१८-५", "content_sanskrit": "मयि दाक्षिण्यमेवास्य मन्ये मनसि चेद्रहः ।\nजनः सौभाग्यवान्यस्माद्भवति स्नेहभाजनम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003710005, "chapter_id": 23710, "verse_number": "१-४-१८-६", "content_sanskrit": "अद्यप्रभृति ते दासस्तपोभिः क्रीत इत्यपि ।\nमुग्धेंदुशेखरेणास्मि विप्रलब्धा स्मरारिणा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003710006, "chapter_id": 23710, "verse_number": "१-४-१८-७", "content_sanskrit": "असमानानुरागेषु नारीणां मूढचेतसाम् ।\nसौभाग्यगर्वो लोकेषु परिहासाय केवलम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003710007, "chapter_id": 23710, "verse_number": "१-४-१८-८", "content_sanskrit": "इति प्रणयरोषेण देव्याः कलुषचेतसः ।\nहव्यवाहातपालीढमिवाननमलक्ष्यत ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003710008, "chapter_id": 23710, "verse_number": "१-४-१८-९", "content_sanskrit": "वाष्पवारिप्लवे तस्या आताम्रे च विलोचने ।\nनीलोत्पले जलापूर्णे इव भूम्ना विरेजतुः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003710009, "chapter_id": 23710, "verse_number": "१-४-१८-१०", "content_sanskrit": "यत्तस्याधीनतिलकं भ्रुवोर्युगमभज्यत ।\nद्वेधाकृतमिवादर्शि मन्मथस्य शरासनम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003710010, "chapter_id": 23710, "verse_number": "१-४-१८-११", "content_sanskrit": "अंतर्मन्युभरेणास्याः कंपते स्माधरच्छदः ।\nमुहुः प्रवालस्थायीव रक्ताशोकस्य पल्लवः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003710011, "chapter_id": 23710, "verse_number": "१-४-१८-१२", "content_sanskrit": "अतीव रज्यमाने तत्पार्वत्या गंडमंडलम् ।\nशाणावघर्षमाणिक्यदर्पणप्रतिमं बभौ ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003710012, "chapter_id": 23710, "verse_number": "१-४-१८-१३", "content_sanskrit": "अंतर्वेपधुतौ तस्याश्चकंपाते पयोधरौ ।\nपद्मकोशाविवांतःस्थ चंचरीकप्रचालितौ ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003710013, "chapter_id": 23710, "verse_number": "१-४-१८-१४", "content_sanskrit": "अचिंतयच्च संभूय सौभाग्याभावतो ननु ।\nममायमन्यस्त्रीचिंतां कुरुते चंद्रभूषणः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003710014, "chapter_id": 23710, "verse_number": "१-४-१८-१५", "content_sanskrit": "तदैषा क्वापि यास्यामि किमत्रास्त्येकया मम ।\nतपस्यते च सौभाग्यमर्जनीयं मयाधुना ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003710015, "chapter_id": 23710, "verse_number": "१-४-१८-१६", "content_sanskrit": "निमीलिताक्षिण्येवास्य गंतव्यं निभृतं मया ।\nन चेन्मां वारयत्येष कंठादुपरि भाषितैः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003710016, "chapter_id": 23710, "verse_number": "१-४-१८-१७", "content_sanskrit": "वत्सौ तु वर्धयत्येव गंगेयमतिवत्सला ।\nदेवस्तु न स्मरत्येव मामन्यस्त्रीपरायणः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003710017, "chapter_id": 23710, "verse_number": "१-४-१८-१८", "content_sanskrit": "इति निश्चित्य देवस्य पार्श्वादाशु निवृत्त्य सा ।\nअनिर्दिश्य दिशं कांचिद्यातुं व्यग्रा प्रचक्रमे ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003710018, "chapter_id": 23710, "verse_number": "१-४-१८-१९", "content_sanskrit": "चलावती माल्यवती मालिनी विजया जया ।\nवारिता अपि संरंभात्स्वामिनीमन्वयुः स्वयम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003710019, "chapter_id": 23710, "verse_number": "१-४-१८-२०", "content_sanskrit": "तत्र सापि गिरीन्पुण्यान्वनानि नगराणि च ।\nसरांसि सरितश्चैषा विचचार समंततः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003710020, "chapter_id": 23710, "verse_number": "१-४-१८-२१", "content_sanskrit": "भ्रमंती सह्यपादेषु द्राविडाख्ये सुनीवृति ।\nतीर्त्वा शक्त्यापगां देवी विजयां समभाषत ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003710021, "chapter_id": 23710, "verse_number": "१-४-१८-२२", "content_sanskrit": "दृश्योऽयं नातिदूरेण पुरस्तात्सकलारुणः ।\nशृंगैस्संलक्ष्यतेऽष्टाभिर्नूनं माहात्म्यवान्गिरिः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003710022, "chapter_id": 23710, "verse_number": "१-४-१८-२३", "content_sanskrit": "उपत्यकासु चैतस्य दृश्यंते तापसाश्रमाः ।\nअतीव पावनाः शांताः पुण्यारण्यमनोहराः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003710023, "chapter_id": 23710, "verse_number": "१-४-१८-२४", "content_sanskrit": "गत्वा निरूपयामस्तानिमान्पुण्याश्रमान्वयम् ।\nप्रसीदतितरां चेत एषां संदर्शनेन मे ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003710024, "chapter_id": 23710, "verse_number": "१-४-१८-२५", "content_sanskrit": "एवमाह्रादयत्यालि क्रमेण गिरिनंदिनी ।\nतस्याद्रेर्जग्मुषी पार्श्वमपश्यत्कंचिदाश्रमम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003710025, "chapter_id": 23710, "verse_number": "१-४-१८-२६", "content_sanskrit": "लूतास्तंतून्नयंत्यत्र कुम्भीराः शैवलान्यपि ।\nशिशून्पुष्णंति नीवारैः सफरान्भूरिमायवः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003710026, "chapter_id": 23710, "verse_number": "१-४-१८-२७", "content_sanskrit": "हरंत्यवकरान्वालैश्चमराः स्फीतरोमभिः ।\nसमीकुर्वंति चोद्भूतैर्विषाणैर्यत्र सैरिभाः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003710027, "chapter_id": 23710, "verse_number": "१-४-१८-२८", "content_sanskrit": "वानराः फलपुष्पाणि मधुपत्राणि भल्लुकाः ।\nक्रोडाः स्नानीयमृत्स्नां च यत्रर्षिभ्यो नयंत्यहो ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003710028, "chapter_id": 23710, "verse_number": "१-४-१८-२९", "content_sanskrit": "काकोलूकैः शुकश्येनैर्मृगव्याघ्रैर्हरिद्विपैः ।\nकलापिसर्पैर्यत्रासुमार्जारैः सौहृदं श्रितम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003710029, "chapter_id": 23710, "verse_number": "१-४-१८-३०", "content_sanskrit": "हूयमानपुराडाशद्रव्यसौरभ्यहारिणी ।\nयत्र द्रुमांतरालेभ्यो धूम्या निर्याति पावनी ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003710030, "chapter_id": 23710, "verse_number": "१-४-१८-३१", "content_sanskrit": "पठंति शतरुद्रीयं यत्र वायसवैरिणः ।\nगृणंति काकाः स्तोत्राणि साम गायंति सारिकाः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003710031, "chapter_id": 23710, "verse_number": "१-४-१८-३२", "content_sanskrit": "शाकशालिषु शार्दूलाश्चरंति च तथैव गाः ।\nसिंचंति पुष्करांभोभिः कुंभिनी यत्र पादपान् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003710032, "chapter_id": 23710, "verse_number": "१-४-१८-३३", "content_sanskrit": "क्वचिच्च शोभने देशे पुण्ये पुण्यमनोहरे ।\nददर्श सा तपस्यन्तं यं कंचिद्दृषिसत्तमम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003710033, "chapter_id": 23710, "verse_number": "१-४-१८-३४", "content_sanskrit": "अधस्तात्सप्तपर्णस्य चित्रव्याघ्रत्वगासने ।\nबद्धवीरासनं सम्यक्पावने कुशविष्टरे ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003710034, "chapter_id": 23710, "verse_number": "१-४-१८-३५", "content_sanskrit": "शालिशूकारुणाभाभिर्जटाभिर्भस्मपांडुरम् ।\nअचंचलाभिर्विद्युद्भिरिव शारदवारिदम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003710035, "chapter_id": 23710, "verse_number": "१-४-१८-३६", "content_sanskrit": "नासाग्रनिश्चलदृशं समप्रस्फुरिताधरम् ।\nआवर्त्तयन्तं रुद्राक्षमालिकामग्रपाणिना ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003710036, "chapter_id": 23710, "verse_number": "१-४-१८-३७", "content_sanskrit": "प्रत्यग्रनिर्णेजनतो ह्यंत्यश्यानदशांचले ।\nवसानं वल्कलयुगे संध्याभ्रे भूभृतां यथा ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003710037, "chapter_id": 23710, "verse_number": "१-४-१८-३८", "content_sanskrit": "षड्वर्गहिंस्रबंधाय स्थापितां वागुरामिव ।\nउपवीतत्रयीमारादुरोगर्तस्य बिभ्रतम् ।\nकृतोचितोपचारा सा तमप्राक्षीत्तपोधनम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003710038, "chapter_id": 23710, "verse_number": "१-४-१८-३९", "content_sanskrit": "पार्वत्युवाच ।\nकस्त्वं कोऽयं गिरिवरो यत्र त्वं कुरुषे तपः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003710039, "chapter_id": 23710, "verse_number": "१-४-१८-४०", "content_sanskrit": "स चाहारुणशैलोऽयं पुण्यक्षेत्रेषु पूजितः ।\nगौतमोऽहं मुनिर्मुक्त्यै तपसाराधये शिवम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003710040, "chapter_id": 23710, "verse_number": "१-४-१८-४१", "content_sanskrit": "इत्युक्त्वा विजयादीनां मुखेनैनामुमां विदन् ।\nप्रणम्य भक्त्या बहुशो नीतवानुटजं निजम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003710041, "chapter_id": 23710, "verse_number": "१-४-१८-४२", "content_sanskrit": "कन्दमूलफलाद्यैश्च कृतातिथ्यामिमां मुनिः ।\nजगन्मंगलमूलाय तपसे चान्वमन्यत ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003710042, "chapter_id": 23710, "verse_number": "१-४-१८-४३", "content_sanskrit": "ज्योतिःस्तम्भस्य संभूतिमारभ्यानुक्रमेण सः ।\nजगाद चास्यै शोणाद्रेर्महिमानमशेषतः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003710043, "chapter_id": 23710, "verse_number": "१-४-१८-४४", "content_sanskrit": "शोणाद्रेः पूर्वदिग्भागे स्थलीश्वरमिति स्थलम् ।\nयत्र संनिहितः शंभुर्ज्योतिर्लिंगात्मतां गतः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003710044, "chapter_id": 23710, "verse_number": "१-४-१८-४५", "content_sanskrit": "वैकुण्ठपरमेष्ठ्यादि गीर्वाण निबिडीकृते ।\nन तत्र मे तपः कर्तुमव्याक्षेपेण शक्यते ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003710045, "chapter_id": 23710, "verse_number": "१-४-१८-४६", "content_sanskrit": "अयं शोणगिरेः पादः प्रवालाचलनामवान् ।\nपुण्यारण्योपरुद्धत्वाद्रहस्यत्वं विगाहते ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003710046, "chapter_id": 23710, "verse_number": "१-४-१८-४७", "content_sanskrit": "तत एवाहमत्रैव प्रतिष्ठाप्य त्रिलोचनम् ।\nआराधये यथाशक्ति तपोभिः कल्पितात्मभिः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003710047, "chapter_id": 23710, "verse_number": "१-४-१८-४८", "content_sanskrit": "ममाश्रमसमीपेऽस्मिन्पुण्यक्षेत्रमिदं महत् ।\nक्रियतामाश्रमो देव्या कर्त्तव्यं हि तपश्चिरम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003710048, "chapter_id": 23710, "verse_number": "१-४-१८-४९", "content_sanskrit": "मुनेरेवमनुज्ञानात्कृताश्रमपरिग्रहा ।\nउदयुंक्त तपः कर्त्तुं सुमहत्पर्वतात्मजा ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003710049, "chapter_id": 23710, "verse_number": "१-४-१८-५०", "content_sanskrit": "आश्रमं रक्षितुं सत्यवतीं काननवासिनीम् ।\nशुभगां धुंधुमारिं च प्रागाद्याशास्वतिष्ठिपत् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003710050, "chapter_id": 23710, "verse_number": "१-४-१८-५१", "content_sanskrit": "तपोवनस्य सर्वस्य रक्षार्थं सा समादिशत् ।\nदुर्गामनर्गलस्फूर्तिमाज्ञानिर्वाहणक्षमाम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003710051, "chapter_id": 23710, "verse_number": "१-४-१८-५२", "content_sanskrit": "अनंतरं सा धम्मिल्लं मंदारप्रसवोचितम् ।\nजटाभरत्वं तपसे गमयामास पार्वती ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003710052, "chapter_id": 23710, "verse_number": "१-४-१८-५३", "content_sanskrit": "हंसचिह्नदशं हित्वा दुकूलं मिहकालघु ।\nपरुषं सुकुमारांगी परिधत्तेस्म वल्कलम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003710053, "chapter_id": 23710, "verse_number": "१-४-१८-५४", "content_sanskrit": "अपि प्रसूनावचयनिस्सहांगुलिपल्लवा ।\nअलावीदतितीक्ष्णाग्राण्यविकारं कुशानि सा ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003710054, "chapter_id": 23710, "verse_number": "१-४-१८-५५", "content_sanskrit": "वज्रसूचिनिर्भरांगैरवच्छिन्नानि कंटकैः ।\nशिरीषमृद्वी शांडिल्यपल्लवान्युच्चिकाय या ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003710055, "chapter_id": 23710, "verse_number": "१-४-१८-५६", "content_sanskrit": "पावन्यां कमलानद्यां प्रातर्विहितमज्जना ।\nअर्चयामास रक्ताब्जैर्यथाविधि विभाकरम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003710056, "chapter_id": 23710, "verse_number": "१-४-१८-५७", "content_sanskrit": "दर्भाक्षततिलोन्मिश्रैर्गौरी श्रीनदिवारिभिः ।\nदेवी निर्वर्तयामास देवर्षिपितृतर्पणम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003710057, "chapter_id": 23710, "verse_number": "१-४-१८-५८", "content_sanskrit": "वालुकामंडले सूर्यमावाह्याभ्यर्च्य पंकजैः ।\nकृतप्रदक्षिणा गौरी प्रणनाम सहस्रशः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003710058, "chapter_id": 23710, "verse_number": "१-४-१८-५९", "content_sanskrit": "स्वयमेव प्रतिष्ठाप्य लिंगं किमपि शंकरम् ।\nआगमोक्तेन विधिना पूजयामास पार्वती ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003710059, "chapter_id": 23710, "verse_number": "१-४-१८-६०", "content_sanskrit": "आसनेन च मूर्त्या च मूलेनांगैश्च सा रविम् ।\nदंडिपिंगलमुख्यांश्च शक्तीर्दीप्तादिका अपि ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003710060, "chapter_id": 23710, "verse_number": "१-४-१८-६१", "content_sanskrit": "तत्तद्दिक्षु च सोमादीन्ग्रहान्धेन्वादिमुद्रया ।\nतेजश्चंडे चार्चयित्वा निर्माल्यं च न्यवेदयत् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003710061, "chapter_id": 23710, "verse_number": "१-४-१८-६२", "content_sanskrit": "अर्घेणातीव शुद्धेन संप्रोक्ष्य च समंततः ।\nद्वारवास्तु समभ्यर्च्य न्यासानपि चकार सा ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003710062, "chapter_id": 23710, "verse_number": "१-४-१८-६३", "content_sanskrit": "भूतशुद्धिं विधायान्वगंतर्यागं चकार सा ।\nहृदि पद्मासने चार्च्य ज्ञानधर्मादिकान्क्रमात् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003710063, "chapter_id": 23710, "verse_number": "१-४-१८-६४", "content_sanskrit": "शक्तीर्दलेषु वामादीर्दलाग्रे सूर्यवेधसौ ।\nकेसराग्रे सोमविष्णू कर्णिकाग्रेऽग्निधूर्जटी ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003710064, "chapter_id": 23710, "verse_number": "१-४-१८-६५", "content_sanskrit": "तदूर्ध्वे शक्तिचक्रं च विन्यस्तब्रह्मपंचका ।\nअंगैर्दत्त्वा च पाद्यादीनुपचर्याभिषिच्य सा ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003710065, "chapter_id": 23710, "verse_number": "१-४-१८-६६", "content_sanskrit": "प्रादाच्चंदनपुष्पादि धूपदीपप्रदायिनी ।\nभूयोपि पंचब्रह्माणि षडंगान्यप्यपूजयत् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003710066, "chapter_id": 23710, "verse_number": "१-४-१८-६७", "content_sanskrit": "तत्तद्दिक्षु च शक्रादीन्वज्रादींश्च विधानतः ।\nकृत्वा सर्वोपचारांश्च वितताराष्टपुष्पिकाम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003710067, "chapter_id": 23710, "verse_number": "१-४-१८-६८", "content_sanskrit": "पंचवक्त्राणि चाभ्यर्च्य कृतचंडेश्वरार्चना ।\nप्रदक्षिणा प्रणामाद्यैर्नित्यं शिवमपूजयत् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003710068, "chapter_id": 23710, "verse_number": "१-४-१८-६९", "content_sanskrit": "शिवागमोक्तविधिना द्रव्यैः सौभाग्यदायिभिः ।\nसा जुहाव च पूजांते प्रणीते जातवेदसि ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003710069, "chapter_id": 23710, "verse_number": "१-४-१८-७०", "content_sanskrit": "परिकल्पितोपचारा च कंदमूलफलादिकैः ।\nस्वयं कृतोपचारेयमतिथीनभ्यपूजयत् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003710070, "chapter_id": 23710, "verse_number": "१-४-१८-७१", "content_sanskrit": "अंगुष्ठाग्रेण तिष्ठंती ग्रीष्ये पंचाग्निमध्यतः ।\nह्रदे च शिशिरे चंद्रपीयूषाप्यायिताऽभवत् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003710071, "chapter_id": 23710, "verse_number": "१-४-१८-७२", "content_sanskrit": "वर्षरात्रीषु धाराभिः सह वारिधरा पुनः ।\nसौदामिनीव ददृशे तमसि स्तिमिता कृतिः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003710072, "chapter_id": 23710, "verse_number": "१-४-१८-७३", "content_sanskrit": "पाणिपादेन पद्मानि मुखेन च कलानिधिम् ।\nप्रदर्शयत्यनायासान्निन्ये सा हैमनीर्निशाः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003710073, "chapter_id": 23710, "verse_number": "१-४-१८-७४", "content_sanskrit": "नीवारबीजदानेन सा मृगानप्यपोषयत् ।\nअज्ञातहिंसाभिभवानाश्रमोपांतवर्तिनः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003710074, "chapter_id": 23710, "verse_number": "१-४-१८-७५", "content_sanskrit": "कृतालवालसलिलैः सुवालाकलशाहृतैः ।\nवात्सल्याद्वर्द्धयामास पूर्णानाश्रमपादपान् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003710075, "chapter_id": 23710, "verse_number": "१-४-१८-७६", "content_sanskrit": "प्रदक्षिणां कृतवती शोणशैलं गिरींद्रजा ।\nसा मनोरथसंसिद्ध्यै नित्यं सह सखीजनैः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003710076, "chapter_id": 23710, "verse_number": "१-४-१८-७७", "content_sanskrit": "पंचाक्षरी जजापैषा शिवस्तोत्राण्युदैरयत् ।\nदध्यौ च देवं मनसा शोणपर्वतरूपिणम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003710077, "chapter_id": 23710, "verse_number": "१-४-१८-७८", "content_sanskrit": "अनुदिनमरुणाचलेश्वरं सा प्रणतवती विहितप्रदक्षिणाद्यैः ।\nशिवनिगमविधानवेदिनी सा व्यरचयदद्रिसुता चिरं तपस्याम् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}]