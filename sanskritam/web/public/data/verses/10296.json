[{"id": 6000296000, "chapter_id": 10296, "verse_number": null, "content_sanskrit": "अथ शततमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000296001, "chapter_id": 10296, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.001.m4a", "display_order": 2}, {"id": 6000296002, "chapter_id": 10296, "verse_number": "१०-१००-१", "content_sanskrit": "भगवानपि गोविन्दः साधयित्वा स्ववाञ्छितम्।\nसुयोधने महाबाहौ निहते गदया रणे॥ १०/१००/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.002.m4a", "display_order": 3, "topics": [{"text": "पाण्डवान् राज्ये संस्थाप्य कृष्णस्य द्वारकागमनम्", "range": "१–२१"}]}, {"id": 6000296003, "chapter_id": 10296, "verse_number": "१०-१००-२", "content_sanskrit": "विसृज्यायोधनं शून्यं प्रयातुमुपचक्रमे।\nकृपश्च कृतवर्मा च द्रौणिश्च रथिनां वरः॥ १०/१००/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.003.m4a", "display_order": 4}, {"id": 6000296004, "chapter_id": 10296, "verse_number": "१०-१००-३", "content_sanskrit": "अवशिष्टा महात्मानः सुयोधनबले त्रयः।\nपञ्च पाण्डुसुता वीराः सात्यकिश्च महाबलः॥ १०/१००/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.004.m4a", "display_order": 5}, {"id": 6000296005, "chapter_id": 10296, "verse_number": "१०-१००-४", "content_sanskrit": "वैश्यापुत्रो युयुत्सुश्च शिष्टाः कृष्णपुरोगमाः।\nतान् पुरस्कृत्य गोविन्दो मुनिवृद्धसमन्वितः॥ १०/१००/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.005.m4a", "display_order": 6}, {"id": 6000296006, "chapter_id": 10296, "verse_number": "१०-१००-५", "content_sanskrit": "जगाम हास्तिनपुरं धृतराष्ट्रं प्रसादितुम्।\nगान्धारीं धृतराष्ट्रं च विदुरं च महामतिम्॥ १०/१००/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.006.m4a", "display_order": 7}, {"id": 6000296007, "chapter_id": 10296, "verse_number": "१०-१००-६", "content_sanskrit": "प्रसाद्य पाण्डवान् स्वे स्वे राज्ये संस्थाप्य यत्नतः।\nस्तूयमानो मुनिगणैः सूतमागधवन्दिभिः॥ १०/१००/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.007.m4a", "display_order": 8}, {"id": 6000296008, "chapter_id": 10296, "verse_number": "१०-१००-७", "content_sanskrit": "अनुयातः पाण्डुपुत्रैः प्रेमबाष्पाविलेक्षणैः।\nताननुज्ञाप्य सोत्कण्ठान् रथेनादित्यवर्चसा॥ १०/१००/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.008.m4a", "display_order": 9}, {"id": 6000296009, "chapter_id": 10296, "verse_number": "१०-१००-८", "content_sanskrit": "शङ्खदुन्दुभिनिर्घोषैर्वेदमङ्गलनिस्वनैः।\nपुण्याहमन्त्रघोषैश्च द्वारकां प्रययौ हरिः॥ १०/१००/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.009.m4a", "display_order": 10}, {"id": 6000296010, "chapter_id": 10296, "verse_number": "१०-१००-९", "content_sanskrit": "विचित्रतोरणां रम्यां चलत्कदलिकाकुलाम्।\nअलङ्कृतां पौरजनैः सिक्तसंसृष्टभूतलाम्॥ १०/१००/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.010.m4a", "display_order": 11}, {"id": 6000296011, "chapter_id": 10296, "verse_number": "१०-१००-१०", "content_sanskrit": "उपस्थितः पौरजनैः पालिकाङ्कुरधारिभिः।\nयोषिद्भिर्वारमुख्याभिर्भूषिताभिश्च भूषणैः॥ १०/१००/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.011.m4a", "display_order": 12}, {"id": 6000296012, "chapter_id": 10296, "verse_number": "१०-१००-११", "content_sanskrit": "वहद्भिर्दीपमुकुरकलशस्रक्फलाक्षतान्।\nउपस्थितो ब्राह्मणैश्च पुत्रैः पौत्रैः सहानुजैः॥ १०/१००/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.012.m4a", "display_order": 13}, {"id": 6000296013, "chapter_id": 10296, "verse_number": "१०-१००-१२", "content_sanskrit": "प्रविवेश पुरीं दिव्यां दिवसे पूजितो हरिः।\nस प्रविश्य सभां दिव्यां सुधर्मां लोकविश्रुताम्॥ १०/१००/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.013.m4a", "display_order": 14}, {"id": 6000296014, "chapter_id": 10296, "verse_number": "१०-१००-१३", "content_sanskrit": "आहुकं वसुदेवं च रामं चैवाभ्यवादयत्।\nप्रणम्य मातरो विश्वाः काञ्चने परमासने॥ १०/१००/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.014.m4a", "display_order": 15}, {"id": 6000296015, "chapter_id": 10296, "verse_number": "१०-१००-१४", "content_sanskrit": "उपविश्य यथाजोषं पूजितो यदुपुङ्गवैः।\nरराज रजनीनाथो यथा ग्रहगणैर्दिवि॥ १०/१००/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.015.m4a", "display_order": 16}, {"id": 6000296016, "chapter_id": 10296, "verse_number": "१०-१००-१५", "content_sanskrit": "हतावशिष्टैर्भूपालैस्तत्पुत्रैश्च महाबलैः।\nअभिषिक्तैर्यथास्थानं सेव्यमानो दिवानिशम्॥ १०/१००/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.016.m4a", "display_order": 17}, {"id": 6000296017, "chapter_id": 10296, "verse_number": "१०-१००-१६", "content_sanskrit": "अवतीर्णमहाभारां विश्वां विश्वान्तरो हरिः।\nधर्मराजं पुरस्कृत्य धर्मेणैवान्वशासत॥ १०/१००/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.017.m4a", "display_order": 18}, {"id": 6000296018, "chapter_id": 10296, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.018.m4a", "display_order": 19}, {"id": 6000296019, "chapter_id": 10296, "verse_number": "१०-१००-१७", "content_sanskrit": "भगवन् यानि चान्यानि मुकुन्दस्य महात्मनः।\nवीर्याण्यनन्तवीर्यस्य श्रोतुमिच्छामहे प्रभो॥ १०/१००/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.019.m4a", "display_order": 20}, {"id": 6000296020, "chapter_id": 10296, "verse_number": "१०-१००-१८", "content_sanskrit": "को नु श्रुत्वा सकृद् ब्रह्मन्नुत्तमश्लोकसत्कथाम्।\nविरमेत विशेषज्ञो विषण्णः काममार्गणैः॥ १०/१००/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.020.m4a", "display_order": 21}, {"id": 6000296021, "chapter_id": 10296, "verse_number": "१०-१००-१९", "content_sanskrit": "सा वागनन्तस्य गुणान् गृणीते करौ च तत्कर्मकरौ मनश्च।\nस्मरेद् वसन्तं स्थिरजङ्गमेषु शृृणोति तत्पुण्यकथाः स कर्णः॥ १०/१००/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.021.m4a", "display_order": 22}, {"id": 6000296022, "chapter_id": 10296, "verse_number": "१०-१००-२०", "content_sanskrit": "शिरस्तु तस्योभयलिङ्गमानमेत् तदेव यत् पश्यति तद्धि चक्षुः।\nअङ्गानि विष्णोरथ तज्जनानां पादोदकं यानि भजन्ति नित्यम्॥ १०/१००/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.022.m4a", "display_order": 23}, {"id": 6000296023, "chapter_id": 10296, "verse_number": null, "content_sanskrit": "सूत उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.023.m4a", "display_order": 24}, {"id": 6000296024, "chapter_id": 10296, "verse_number": "१०-१००-२१", "content_sanskrit": "विष्णुरातेन सम्पृष्टो भगवान् बादरायणिः।\nवासुदेवे भगवति निमग्नहृदयोऽब्रवीत्॥ १०/१००/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.024.m4a", "display_order": 25}, {"id": 6000296025, "chapter_id": 10296, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.025.m4a", "display_order": 26}, {"id": 6000296026, "chapter_id": 10296, "verse_number": "१०-१००-२२", "content_sanskrit": "कृष्णस्यासीत् सखा कश्चिद् ब्राह्मणो ब्रह्मवित्तमः।\nविरक्त इन्द्रियार्थेषु प्रशान्तात्मा जितेन्द्रियः॥ १०/१००/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.026.m4a", "display_order": 27, "topics": [{"text": "कुचेलोपाख्यानम्", "range": "२२–२९"}]}, {"id": 6000296027, "chapter_id": 10296, "verse_number": "१०-१००-२३", "content_sanskrit": "यदृच्छयोपपन्नेन वर्तमानो गृहाश्रमी।\nतस्य भार्या कुचेलस्य क्षुत्क्षामा च तथाविधा॥ १०/१००/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.027.m4a", "display_order": 28}, {"id": 6000296028, "chapter_id": 10296, "verse_number": "१०-१००-२४", "content_sanskrit": "पतिव्रता पतिं प्राह म्लायता वदनेन सा।\nदरिद्रं साध्व्यशनया वेपमानाऽभिगम्य च॥ १०/१००/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.028.m4a", "display_order": 29}, {"id": 6000296029, "chapter_id": 10296, "verse_number": "१०-१००-२५", "content_sanskrit": "ननु ब्रह्मन् भगवतः सखा साक्षाच्छ्रियः पतिः।\nब्रह्मण्यश्च शरण्यश्च भगवान् सात्वतर्षभः॥ १०/१००/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.029.m4a", "display_order": 30}, {"id": 6000296030, "chapter_id": 10296, "verse_number": "१०-१००-२६", "content_sanskrit": "तमुपैहि महाभाग साधूनां च परायणम्।\nदास्यति द्रविणं भूरि सीदते ते कुटुम्बिने॥ १०/१००/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.030.m4a", "display_order": 31}, {"id": 6000296031, "chapter_id": 10296, "verse_number": "१०-१००-२७", "content_sanskrit": "आस्तेऽधुना द्वारवत्यां भोजवृष्ण्यन्धकेश्वरः।\nस्मरतः पादयुगलमात्मानमपि यच्छति॥ १०/१००/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.031.m4a", "display_order": 32}, {"id": 6000296032, "chapter_id": 10296, "verse_number": "१०-१००-२८", "content_sanskrit": "किम्वर्थकामान् भजतो नान्यमिष्टं जगद्गुरुः।\nस एवं भार्यया विप्रो बहुशः प्रार्थितो विभुः॥ १०/१००/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.032.m4a", "display_order": 33}, {"id": 6000296033, "chapter_id": 10296, "verse_number": "१०-१००-२९", "content_sanskrit": "अयं हि परमो लाभ उत्तमश्लोकदर्शनम्।\nइति सञ्चिन्त्य मनसा गमनाय मनो दधे॥ १०/१००/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.033.m4a", "display_order": 34}, {"id": 6000296034, "chapter_id": 10296, "verse_number": "१०-१००-३०", "content_sanskrit": "अप्यस्त्युपायनं किञ्चिद् गृहे कल्याणि दीयताम्।\nयाचित्वा चतुरो मुष्टीन् विप्रान् पृथुकतण्डुलान्॥ १०/१००/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.034.m4a", "display_order": 35, "topics": [{"text": "तत्र कुचेलस्य द्वारकागमनम्, कृष्णस्य तत्सत्कारः, पूर्ववृत्तस्मरणं च", "range": "३०–६२"}]}, {"id": 6000296035, "chapter_id": 10296, "verse_number": "१०-१००-३१", "content_sanskrit": "चैलखण्डेन तान् बद्ध्वा भर्त्रे प्रादादुपायनम्।\nस तानादाय विप्राग्य्रः प्रययौ द्वारकां किल॥ १०/१००/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.035.m4a", "display_order": 36}, {"id": 6000296036, "chapter_id": 10296, "verse_number": "१०-१००-३२", "content_sanskrit": "कृष्णसन्दर्शनं मह्यं कथं स्यादिति चिन्तयन्।\nत्रीणि गुल्मान्यतीयाय तिस्रः कक्ष्याश्च स द्विजः॥ १०/१००/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.036.m4a", "display_order": 37}, {"id": 6000296037, "chapter_id": 10296, "verse_number": "१०-१००-३३", "content_sanskrit": "विप्रो गम्यान्धवृष्णीनां गृहेष्वच्युतधर्मिणाम्।\nगृहाणि व्द्यष्टसाहस्रमहिषीणां हरेर्द्विजः॥ १०/१००/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.037.m4a", "display_order": 38}, {"id": 6000296038, "chapter_id": 10296, "verse_number": "१०-१००-३४", "content_sanskrit": "विवेशैकतमं श्रीमद् ब्रह्मानन्दं गतो यथा।\nतं विलोक्याच्युतो दूरात् प्रियापर्यङ्क आश्रितः॥ १०/१००/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.038.m4a", "display_order": 39}, {"id": 6000296039, "chapter_id": 10296, "verse_number": "१०-१००-३५", "content_sanskrit": "सहसोत्थाय चाभ्येत्य दोर्भ्यां पर्यग्रहीन्मुदा।\nसख्युः प्रियस्य विप्रर्षेरङ्गसङ्गातिनिर्वृतः॥ १०/१००/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.039.m4a", "display_order": 40}, {"id": 6000296040, "chapter_id": 10296, "verse_number": "१०-१००-३६", "content_sanskrit": "प्रीतो ह्यमुञ्चदब्बिन्दून् नेत्राभ्यां पुष्करेक्षणः।\nअथोपवेश्य पर्यङ्के स्वयं सख्युः समर्हणम्॥ १०/१००/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.040.m4a", "display_order": 41}, {"id": 6000296041, "chapter_id": 10296, "verse_number": "१०-१००-३७", "content_sanskrit": "उपहृत्यावनिज्यास्य पादौ पादावनेजनीः।\nअग्रहीच्छिरसा राजन् भगवाँल्लोकपावनः॥ १०/१००/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.041.m4a", "display_order": 42}, {"id": 6000296042, "chapter_id": 10296, "verse_number": "१०-१००-३८", "content_sanskrit": "व्यलिम्पद् दिव्यगन्धेन चन्दनागरुकुङ्कुमैः।\nधूपैः सुरभिभिर्मित्रं प्रदीपावलिभिर्मुदा॥ १०/१००/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.042.m4a", "display_order": 43}, {"id": 6000296043, "chapter_id": 10296, "verse_number": "१०-१००-३९", "content_sanskrit": "अर्चित्वाऽऽवेद्य ताम्बूलं गां च स्वागतमब्रवीत्।\nकुचेलं मलिनं क्षामं द्विजं धमनिसन्ततम्॥ १०/१००/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.043.m4a", "display_order": 44}, {"id": 6000296044, "chapter_id": 10296, "verse_number": "१०-१००-४०", "content_sanskrit": "देवी पर्यचरच्छैब्या चामरव्यजनेन वै॥ १०/१००/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.044.m4a", "display_order": 45}, {"id": 6000296045, "chapter_id": 10296, "verse_number": "१०-१००-४१", "content_sanskrit": "अन्तःपुरजनो दृष्ट्वा कृष्णेनामलकीर्तिना।\nविस्मितोऽभूत् स विप्राग्य्रमवधूतं सभाजितम्॥ १०/१००/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.045.m4a", "display_order": 46}, {"id": 6000296046, "chapter_id": 10296, "verse_number": "१०-१००-४२", "content_sanskrit": "किमनेन कृतं पुण्यमवधूतेन भिक्षुणा। श्रिया हीनेन लोकेऽस्मिन् गर्हितेनावमेन च।\nयोऽसौ त्रिलोकगुरुणा श्रीनिवासेन सम्भृतः॥ १०/१००/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.046.m4a", "display_order": 47}, {"id": 6000296047, "chapter_id": 10296, "verse_number": "१०-१००-४४", "content_sanskrit": "पर्यङ्कस्थां श्रियं हित्वा परिष्वक्तोऽग्रजो यथा।\nकथयाञ्चक्रतुर्गाथां पूर्वां गुरुकुले सताम्॥ १०/१००/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.047.m4a", "display_order": 48}, {"id": 6000296048, "chapter_id": 10296, "verse_number": "१०-१००-४४", "content_sanskrit": "आत्मनोल्लसितौ राजन् करौ गृह्य परस्परम्।\nअपि ब्रह्मन् गुरुकुलाद् भवता लब्धदक्षिणात्॥ १०/१००/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.048.m4a", "display_order": 49}, {"id": 6000296049, "chapter_id": 10296, "verse_number": "१०-१००-४५", "content_sanskrit": "समावृत्तेन धर्मज्ञा भार्योढा सदृशी न वा।\nप्रायो गृहेषु ते चित्तमकामविहतं तथा॥ १०/१००/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.049.m4a", "display_order": 50}, {"id": 6000296050, "chapter_id": 10296, "verse_number": "१०-१००-४६", "content_sanskrit": "नैवातिप्रीयते तद्वद् धनेषु विदितं हि मे॥ १०/१००/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.050.m4a", "display_order": 51}, {"id": 6000296051, "chapter_id": 10296, "verse_number": "१०-१००-४७", "content_sanskrit": "केचित् कुर्वन्ति कर्माणि कामैरहतचेतसः।\nत्यजन्तः प्रकृतिं दैवीं यथाऽहं लोकसङ्ग्रहः॥ १०/१००/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.051.m4a", "display_order": 52}, {"id": 6000296052, "chapter_id": 10296, "verse_number": "१०-१००-४८", "content_sanskrit": "कच्चिद् गुरुकुलावासं ब्रह्मन् स्मरसि नौ यतः।\nद्विजो विज्ञाय विज्ञेयं तमसः पारमश्नुते॥ १०/१००/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.052.m4a", "display_order": 53}, {"id": 6000296053, "chapter_id": 10296, "verse_number": "१०-१००-४९", "content_sanskrit": "स वै सत्कर्मणां साक्षाद् द्विजातेरिह सम्भवः।\nआद्यो गुरुर्ह्याश्रमिणां यथाऽहं ज्ञानदो गुरुः॥ १०/१००/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.053.m4a", "display_order": 54}, {"id": 6000296054, "chapter_id": 10296, "verse_number": "१०-१००-५०", "content_sanskrit": "ते त्वर्थकोविदा ब्रह्मन् वर्णाश्रमवतामिह।\nये मया गुरुणा वाचा तरन्त्यञ्जो भवार्णवम्॥ १०/१००/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.054.m4a", "display_order": 55}, {"id": 6000296055, "chapter_id": 10296, "verse_number": "१०-१००-५१", "content_sanskrit": "नाहमिज्याप्रजातिभ्यां तपसोपशमेन वा।\nतुष्येयं सर्वभूतात्मा गुरुशुश्रूषया यथा॥ १०/१००/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.055.m4a", "display_order": 56}, {"id": 6000296056, "chapter_id": 10296, "verse_number": "१०-१००-५२", "content_sanskrit": "अपि नः स्मर्यतां ब्रह्मन् वृत्तं निवसतां गुरौ।\nगुरुदारैश्चोदितानामिन्धनानयने क्‍वचित्॥ १०/१००/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.056.m4a", "display_order": 57}, {"id": 6000296057, "chapter_id": 10296, "verse_number": "१०-१००-५३", "content_sanskrit": "प्रविष्टानां महारण्यमपर्तौ सुमहद् द्विज।\nवातवर्षमभूत् तीव्रं निष्ठुराः स्तनयित्नवः॥ १०/१००/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.057.m4a", "display_order": 58}, {"id": 6000296058, "chapter_id": 10296, "verse_number": "१०-१००-५४", "content_sanskrit": "सूर्यश्चास्तं गतस्तावत् तमसा संवृता दिशः।\nनिम्नं कूलं जलौघेन न प्राज्ञायत किञ्चन॥ १०/१००/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.058.m4a", "display_order": 59}, {"id": 6000296059, "chapter_id": 10296, "verse_number": "१०-१००-५५", "content_sanskrit": "वयं भृशं तत्र महानिलाम्बुभिर्निहन्यमाना मुहुरम्बुसम्प्लवे।\nदिशोऽविदन्तोऽथ परस्परं वने गृहीतहस्ता परिबभ्रमतुराः॥ १०/१००/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.059.m4a", "display_order": 60}, {"id": 6000296060, "chapter_id": 10296, "verse_number": "१०-१००-५६", "content_sanskrit": "एतद् विदित्वा उदिते रवौ सान्दीपनिर्गुरुः।\nअन्वेषमाणो नः शिष्यानार्योऽपश्यन्नरूरुदत्॥ १०/१००/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.060.m4a", "display_order": 61}, {"id": 6000296061, "chapter_id": 10296, "verse_number": "१०-१००-५७", "content_sanskrit": "अहो मे पुत्रका यूयमस्मदर्थेऽतिदुःखिताः।\nआत्मा हि प्राणिनां प्रेष्ठस्तमनादृत्य मत्पराः॥ १०/१००/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.061.m4a", "display_order": 62}, {"id": 6000296062, "chapter_id": 10296, "verse_number": "१०-१००-५८", "content_sanskrit": "इयदेव हि सच्छिष्यैः कर्तव्यं गुरुनिष्कृतम्।\nयद् वै विशुद्धभावेन सर्वार्थात्मार्पणं गुरौ॥ १०/१००/५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.062.m4a", "display_order": 63}, {"id": 6000296063, "chapter_id": 10296, "verse_number": "१०-१००-५९", "content_sanskrit": "सन्तुष्टोऽहं द्विजश्रेष्ठाः सत्याः सन्तु मनोरथाः।\nछन्दांस्ययातयामानि भवन्तीह परत्र च॥ १०/१००/५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.063.m4a", "display_order": 64}, {"id": 6000296064, "chapter_id": 10296, "verse_number": "१०-१००-६०", "content_sanskrit": "इत्थंविधान्यनेकानि वसतां गुरुवेश्मसु।\nगुरोरनुग्रहेणैव पुमान् पूर्णः प्रशान्तये॥ १०/१००/६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.064.m4a", "display_order": 65}, {"id": 6000296065, "chapter_id": 10296, "verse_number": null, "content_sanskrit": "ब्राह्मण उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.065.m4a", "display_order": 66}, {"id": 6000296066, "chapter_id": 10296, "verse_number": "१०-१००-६१", "content_sanskrit": "किमस्माभिरनिर्वृत्तं देवदेव जगद्गुरो।\nभवता सत्यकामेन येषां वासो गुरावभूत्॥ १०/१००/६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.066.m4a", "display_order": 67}, {"id": 6000296067, "chapter_id": 10296, "verse_number": "१०-१००-६२", "content_sanskrit": "यस्य छन्दोमयं ब्रह्म देह आवापनं विभो।\nयोऽयं स तस्य गुरुषु वासोऽत्यन्तविडम्बनम्॥ १०/१००/६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_100/BhP_10.100.067.m4a", "display_order": 68}, {"id": 6000296068, "chapter_id": 10296, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्ध उत्तरार्धे शततमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}]