[{"id": 5000442000, "chapter_id": 9442, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे पञ्चत्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000442001, "chapter_id": 9442, "verse_number": "६-३५-१", "content_sanskrit": "तेन शङ्खविमिश्रेण भेरीशब्देन नादिना।\nउपयाति महाबाहू रामः परपुरंजयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000442002, "chapter_id": 9442, "verse_number": "६-३५-२", "content_sanskrit": "तं निनादं निशम्याथ रावणो राक्षसेश्वरः।\nमुहूर्तं ध्यानमास्थाय सचिवानभ्युदैक्षत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000442003, "chapter_id": 9442, "verse_number": "६-३५-३", "content_sanskrit": "अथ तान् सचिवांस्तत्र सर्वानाभाष्य रावणः।\nसभां संनादयन् सर्वामित्युवाच महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000442004, "chapter_id": 9442, "verse_number": "६-३५-४", "content_sanskrit": "जगत्संतापनः क्रूरोऽगर्हयन् राक्षसेश्वरः।\nतरणं सागरस्यास्य विक्रमं बलपौरुषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000442005, "chapter_id": 9442, "verse_number": "६-३५-५", "content_sanskrit": "यदुक्तवन्तो रामस्य भवन्तस्तन्मया श्रुतम्।\nभवतश्चाप्यहं वेद्मि युद्धे सत्यपराक्रमान्।\nतूष्णीकानीक्षतोऽन्योन्यं विदित्वा रामविक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000442006, "chapter_id": 9442, "verse_number": "६-३५-६", "content_sanskrit": "ततस्तु सुमहाप्राज्ञो माल्यवान् नाम राक्षसः।\nरावणस्य वचः श्रुत्वा इति मातामहोऽब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000442007, "chapter_id": 9442, "verse_number": "६-३५-७", "content_sanskrit": "विद्यास्वभिविनीतो यो राजा राजन् नयानुगः।\nस शास्ति चिरमैश्वर्यमरींश्च कुरुते वशे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000442008, "chapter_id": 9442, "verse_number": "६-३५-८", "content_sanskrit": "संदधानो हि कालेन विगृह्णंश्चारिभिः सह।\nस्वपक्षे वर्धनं कुर्वन्महदैश्वर्यमश्नुते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000442009, "chapter_id": 9442, "verse_number": "६-३५-९", "content_sanskrit": "हीयमानेन कर्तव्यो राज्ञा संधिः समेन च।\nन शत्रुमवमन्येत ज्यायान् कुर्वीत विग्रहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000442010, "chapter_id": 9442, "verse_number": "६-३५-१०", "content_sanskrit": "तन्मह्यं रोचते संधिः सह रामेण रावण।\nयदर्थमभियुक्तोऽसि सीता तस्मै प्रदीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000442011, "chapter_id": 9442, "verse_number": "६-३५-११", "content_sanskrit": "तस्य देवर्षयः सर्वे गन्धर्वाश्च जयैषिणः।\nविरोधं मा गमस्तेन संधिस्ते तेन रोचताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000442012, "chapter_id": 9442, "verse_number": "६-३५-१२", "content_sanskrit": "असृजद् भगवान् पक्षौ द्वावेव हि पितामहः।\nसुराणामसुराणां च धर्माधर्मौ तदाश्रयौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000442013, "chapter_id": 9442, "verse_number": "६-३५-१३", "content_sanskrit": "धर्मो हि श्रूयते पक्ष अमराणां महात्मनाम्।\nअधर्मो रक्षसां पक्षो ह्यसुराणां च राक्षस ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000442014, "chapter_id": 9442, "verse_number": "६-३५-१४", "content_sanskrit": "धर्मो वै ग्रसतेऽधर्मं यदा कृतमभूद् युगम्।\nअधर्मो ग्रसते धर्मं यदा तिष्यः प्रवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000442015, "chapter_id": 9442, "verse_number": "६-३५-१५", "content_sanskrit": "तत् त्वया चरता लोकान् धर्मोऽपि निहतो महान्।\nअधर्मः प्रगृहीतश्च तेनास्मद् बलिनः परे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000442016, "chapter_id": 9442, "verse_number": "६-३५-१६", "content_sanskrit": "स प्रमादात् प्रवृद्धस्तेऽधर्मोऽहिर्ग्रसते हि नः।\nविवर्धयति पक्षं च सुराणां सुरभावनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000442017, "chapter_id": 9442, "verse_number": "६-३५-१७", "content_sanskrit": "विषयेषु प्रसक्तेन यत्किंचित्कारिणा त्वया।\nऋषीणामग्निकल्पानामुद्वेगो जनितो महान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000442018, "chapter_id": 9442, "verse_number": "६-३५-१८", "content_sanskrit": "तेषां प्रभावो दुर्धर्षः प्रदीप्त इव पावकः।\nतपसा भावितात्मानो धर्मस्यानुग्रहे रताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000442019, "chapter_id": 9442, "verse_number": "६-३५-१९", "content_sanskrit": "मुख्यैर्यज्ञैर्यजन्त्येते तैस्तैर्यत्ते द्विजातयः।\nजुह्वत्यग्नींश्च विधिवद् वेदांश्चोच्चैरधीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000442020, "chapter_id": 9442, "verse_number": "६-३५-२०", "content_sanskrit": "अभिभूय च रक्षांसि ब्रह्मघोषानुदीरयन्।\nदिशो विप्रद्रुताः सर्वाः स्तनयित्नुरिवोष्णगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000442021, "chapter_id": 9442, "verse_number": "६-३५-२१", "content_sanskrit": "ऋषीणामग्निकल्पानामग्निहोत्रसमुत्थितः।\nआदत्ते रक्षसां तेजो धूमो व्याप्य दिशो दश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000442022, "chapter_id": 9442, "verse_number": "६-३५-२२", "content_sanskrit": "तेषु तेषु च देशेषु पुण्येष्वेव दृढव्रतैः।\nचर्यमाणं तपस्तीव्रं संतापयति राक्षसान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000442023, "chapter_id": 9442, "verse_number": "६-३५-२३", "content_sanskrit": "देवदानवयक्षेभ्यो गृहीतश्च वरस्त्वया।\nमनुष्या वानरा ऋक्षा गोलाङ्गूला महाबलाः।\nबलवन्त इहागम्य गर्जन्ति दृढविक्रमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000442024, "chapter_id": 9442, "verse_number": "६-३५-२४", "content_sanskrit": "उत्पातान् विविधान् दृष्ट्वा घोरान् बहुविधान् बहून्।\nविनाशमनुपश्यामि सर्वेषां रक्षसामहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000442025, "chapter_id": 9442, "verse_number": "६-३५-२५", "content_sanskrit": "खराभिस्तनिता घोरा मेघाः प्रतिभयंकराः।\nशोणितेनाभिवर्षन्ति लङ्कामुष्णेन सर्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000442026, "chapter_id": 9442, "verse_number": "६-३५-२६", "content_sanskrit": "रुदतां वाहनानां च प्रपतन्त्यश्रुबिन्दवः।\nरजोध्वस्ता विवर्णाश्च न प्रभान्ति यथापुरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000442027, "chapter_id": 9442, "verse_number": "६-३५-२७", "content_sanskrit": "व्याला गोमायवो गृध्रा वाश्यन्ति च सुभैरवम्।\nप्रविश्य लङ्कामारामे समवायांश्च कुर्वते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000442028, "chapter_id": 9442, "verse_number": "६-३५-२८", "content_sanskrit": "कालिकाः पाण्डुरैर्दन्तैः प्रहसन्त्यग्रतः स्थिताः।\nस्त्रियः स्वप्नेषु मुष्णन्त्यो गृहाणि प्रतिभाष्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000442029, "chapter_id": 9442, "verse_number": "६-३५-२९", "content_sanskrit": "गृहाणां बलिकर्माणि श्वानः पर्युपभुञ्जते।\nखरा गोषु प्रजायन्ते मूषका नकुलेषु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000442030, "chapter_id": 9442, "verse_number": "६-३५-३०", "content_sanskrit": "मार्जारा द्वीपिभिः सार्धं सूकराः शुनकैः सह।\nकिंनरा राक्षसैश्चापि समेयुर्मानुषैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000442031, "chapter_id": 9442, "verse_number": "६-३५-३१", "content_sanskrit": "पाण्डुरा रक्तपादाश्च विहगाः कालचोदिताः।\nराक्षसानां विनाशाय कपोता विचरन्ति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000442032, "chapter_id": 9442, "verse_number": "६-३५-३२", "content_sanskrit": "चीचीकूचीति वाशन्त्यः शारिका वेश्मसु स्थिताः।\nपतन्ति ग्रथिताश्चापि निर्जिताः कलहैषिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000442033, "chapter_id": 9442, "verse_number": "६-३५-३३", "content_sanskrit": "पक्षिणश्च मृगाः सर्वे प्रत्यादित्यं रुदन्ति ते।\nकरालो विकटो मुण्डः पुरुषः कृष्णपिङ्गलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000442034, "chapter_id": 9442, "verse_number": "६-३५-३४", "content_sanskrit": "कालो गृहाणि सर्वेषां काले कालेऽन्ववेक्षते।\nएतान्यन्यानि दुष्टानि निमित्तान्युत्पतन्ति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000442035, "chapter_id": 9442, "verse_number": "६-३५-३५", "content_sanskrit": "विष्णुं मन्यामहे रामं मानुषं रूपमास्थितम्।\nनहि मानुषमात्रोऽसौ राघवो दृढविक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000442036, "chapter_id": 9442, "verse_number": "६-३५-३६", "content_sanskrit": "येन बद्धः समुद्रे च सेतुः स परमाद्भुतः।\nकुरुष्व नरराजेन संधिं रामेण रावण।\nज्ञात्वावधार्य कर्माणि क्रियतामायतिक्षमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000442037, "chapter_id": 9442, "verse_number": "६-३५-३७", "content_sanskrit": "इदं वचस्तस्य निगद्य माल्यवान्\nपरीक्ष्य रक्षोधिपतेर्मनः पुनः।\nअनुत्तमेषूत्तमपौरुषो बली\nबभूव तूष्णीं समवेक्ष्य रावणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000442038, "chapter_id": 9442, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे पञ्चत्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]