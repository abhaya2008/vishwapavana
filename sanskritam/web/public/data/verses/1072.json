[{"id": 2003718, "chapter_id": 1072, "verse_number": "१-७३-०x", "content_sanskrit": "शुक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2003719, "chapter_id": 1072, "verse_number": "१-७३-१", "content_sanskrit": "यः परेषां नरो नित्यमतिवादांस्तितिक्षते।\nदेवयानि विजानीहि तेन सर्वमिदं जितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2003720, "chapter_id": 1072, "verse_number": "१-७३-२", "content_sanskrit": "यः समुत्पतितं क्रोधं निगृह्णाति इयं यथा।\nस यन्तेत्युच्यते सद्भिर्न यो रश्मिषु लम्बते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2003721, "chapter_id": 1072, "verse_number": "१-७३-३", "content_sanskrit": "यः समुत्पतितं क्रोधमक्रोधेन निरस्यति।\nदेवयानि विजानीहि तेन सर्वमिदं जितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2003722, "chapter_id": 1072, "verse_number": "१-७३-४", "content_sanskrit": "यः समुत्पतितं क्रोधं क्षमयेह निरस्यति।\nयथोरगस्त्वचं जीर्णां स वै पुरुष उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2003723, "chapter_id": 1072, "verse_number": "१-७३-५", "content_sanskrit": "यः संधारयते मन्युं योऽतिवादांस्तितिक्षते।\nयश्च तप्तो न तपति दृढं सोऽर्थस्य भाजनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2003724, "chapter_id": 1072, "verse_number": "१-७३-६", "content_sanskrit": "यो यजेदपरिश्रान्तो मासिमासि शतं समाः।\nन क्रुद्ध्येद्यश्च सर्वस्य तयोरक्रोधनोऽधिकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2003725, "chapter_id": 1072, "verse_number": "१-७३-७", "content_sanskrit": "तस्मादक्रोधनः श्रेष्ठः कामक्रोधौ विगर्हितौ।\nक्रुद्धस्य निष्फलान्येव दानयज्ञतपांसि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2003726, "chapter_id": 1072, "verse_number": "१-७३-८", "content_sanskrit": "तस्मादक्रोधने यज्ञतपोदानफलं महत्।\nभवेदसंशयं भद्रे नेतरस्मिन्कदाचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2003727, "chapter_id": 1072, "verse_number": "१-७३-९", "content_sanskrit": "न यतिर्न तपस्वी च न यज्वा न च धर्मभाक्।\nक्रोधस्य यो वशं गच्छेत्तस्य लोकद्वयं न च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2003728, "chapter_id": 1072, "verse_number": "१-७३-१०", "content_sanskrit": "पुत्रो भृत्यः सुहृद्भ्राता भार्या धर्मश्च सत्यता।\nतस्यैतान्यपयास्यन्ति क्रोधशीलस्य निश्चितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2003729, "chapter_id": 1072, "verse_number": "१-७३-११", "content_sanskrit": "यत्कुमाराः कुमार्यश्च वैरं कुर्युरचेतसः।\nन तत्प्राज्ञोऽनुकुर्वीत न विदुस्ते बलाबलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2003730, "chapter_id": 1072, "verse_number": "१-७३-१२x", "content_sanskrit": "देवयान्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2003731, "chapter_id": 1072, "verse_number": "१-७३-१२", "content_sanskrit": "वेदाहं तात बालाऽपि धर्माणां यदिहान्तरम्।\nअक्रोधे चातिवादे च वेद चापि बलाबलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2003732, "chapter_id": 1072, "verse_number": "१-७३-१३", "content_sanskrit": "स्ववृत्तिमननुष्ठाय धर्ममुत्सृज्य तत्त्वतः।\nशिष्यस्याशिष्यवृत्तेस्तु न क्षन्तव्यं बुभूषता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2003733, "chapter_id": 1072, "verse_number": "१-७३-१४", "content_sanskrit": "प्रेष्यः शिष्यः स्ववृत्तिं हि विसृज्य विफलं गतः।\nतस्मात्संकीर्णवृत्तेषु वासो मम न रोचते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2003734, "chapter_id": 1072, "verse_number": "१-७३-१५", "content_sanskrit": "पुमांसो ये हि निन्दन्ति वृत्तेनाभिजनेन च।\nन तेषु निवसेत्प्राज्ञः श्रेयोऽर्थी पापबुद्धिषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2003735, "chapter_id": 1072, "verse_number": "१-७३-१६", "content_sanskrit": "ये त्वेनमभिजानन्ति वृत्तेनाभिजनेन वा।\nतेषु साधुषु वस्तव्यं स वासः श्रेष्ठ उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2003736, "chapter_id": 1072, "verse_number": "१-७३-१७", "content_sanskrit": "सुयन्त्रितपरा नित्यं विहीनाश्च धनैर्वराः।\nदुर्वृत्ताः पापकर्माणश्चण्डाला धनिनोपि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2003737, "chapter_id": 1072, "verse_number": "१-७३-१८", "content_sanskrit": "नैव जात्या हि चण्डालाः स्वकर्मविहितैर्विना।\nधनाभिजनविद्यासु सक्ताश्चण्डालधर्मिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2003738, "chapter_id": 1072, "verse_number": "१-७३-१९", "content_sanskrit": "अकारणाश्च द्वेष्यन्ति परिवादं वदन्ति ते।\nसाधोस्तत्र न वासोस्ति पापिभिः पापतां व्रजेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2003739, "chapter_id": 1072, "verse_number": "१-७३-२०", "content_sanskrit": "सुकृते दुष्कृते वापि यत्र सज्जति यो नरः।\nध्रुवं रतिर्भवेत्तस्य तस्माद्द्वेषं न रोचयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2003740, "chapter_id": 1072, "verse_number": "१-७३-२१", "content_sanskrit": "वाग्दुरुक्तं महाघोरं दुहितुर्वृषपर्वणः।\nमम मथ्नाति हृदयमग्निकाम इवारणिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2003741, "chapter_id": 1072, "verse_number": "१-७३-२२", "content_sanskrit": "न ह्यतो दुष्करतरं मन्ये लोकेष्वपि त्रिषु।\nयः सपत्नश्रियं दीप्तां हीनश्रीः पर्युपासते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2003742, "chapter_id": 1072, "verse_number": "१-७३-२३", "content_sanskrit": "मरणं शोभनं तस्य इति विद्वज्जना विदुः।\nअवमानमवाप्नोति शनैर्नीचसमागमात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2003743, "chapter_id": 1072, "verse_number": "१-७३-२४", "content_sanskrit": "अतिवादा वक्त्रतो निःसरन्ति\nयैराहतः शोचति रात्र्यहानि।\nपरस्य वै मर्मसु ते पतन्ति\nतस्माद्धीरो नैव मुच्येत्परेषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2003744, "chapter_id": 1072, "verse_number": "१-७३-२५", "content_sanskrit": "निरोहेदायुधैश्छिन्नं संरोहेद्दग्धमाग्निना।\nवाक्क्षतं च न संरोहेदाशरीरं शरीरिणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2003745, "chapter_id": 1072, "verse_number": "१-७३-२६", "content_sanskrit": "संरोहित शरैर्विद्धं नवं परशुना हतम्।\nवाचा दुरुक्तं बीभत्सं न संरोहेत वाक्क्षतम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2003746, "chapter_id": 1072, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि त्रिसप्ततितमोऽध्यायः॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]