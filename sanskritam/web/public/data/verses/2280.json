[{"id": 2059780, "chapter_id": 2280, "verse_number": "८-१-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2059781, "chapter_id": 2280, "verse_number": "८-१-१", "content_sanskrit": "हते द्रोणे महेष्वासे तव पुत्रा महारथाः।\nबभूवुरस्वस्थमुखा विषण्णा गतचेतसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2059782, "chapter_id": 2280, "verse_number": "८-१-२", "content_sanskrit": "अवाङ्मुखाः शस्त्रभृतः सर्व एव विशाम्पते।\nअवेक्षमाणाः शोकार्ता नाभ्यभाषन्परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2059783, "chapter_id": 2280, "verse_number": "८-१-३", "content_sanskrit": "तान्दृष्ट्वा व्यथिताकारान्सैन्यानि तव भारत।\nऊर्ध्वमेव निरैक्षन्त दुःखत्रस्तान्यनेकशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2059784, "chapter_id": 2280, "verse_number": "८-१-४", "content_sanskrit": "शस्त्राण्येषां तु राजेन्द्र शोणिताक्तानि सर्वशः।\nप्राभ्रश्यन्त कराग्रेभ्यो दृष्ट्वा द्रोणं हतं युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2059785, "chapter_id": 2280, "verse_number": "८-१-५", "content_sanskrit": "तानि बद्वान्यरिष्टानि लम्बमानानि भारत।\nअदृश्यन्त महाराज नक्षत्राणि यथा दिवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2059786, "chapter_id": 2280, "verse_number": "८-१-६", "content_sanskrit": "तथा तु स्तिमितं दृष्ट्वा गतसत्वमवस्थितम्।\nबलं तव महाराज राजा दुर्योधनोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2059787, "chapter_id": 2280, "verse_number": "८-१-७", "content_sanskrit": "भवतां बाहुवीर्यं हि समाश्रित्य मया युधि।\nपाण्डवेयाः समाहूता युद्वं चेदं प्रवर्तितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2059788, "chapter_id": 2280, "verse_number": "८-१-८", "content_sanskrit": "तदिदं निहते द्रोणे विषण्णमिव लक्ष्यते।\nयुध्यमानाश्च समरे योधा वध्यन्ति सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2059789, "chapter_id": 2280, "verse_number": "८-१-९", "content_sanskrit": "जयो वाऽपि वधो वाऽपि युध्यमानस्य संयुगे।\nभवेत्किमत्र चित्रं वै युध्यध्वं सर्वतोमुखाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2059790, "chapter_id": 2280, "verse_number": "८-१-१०", "content_sanskrit": "पश्यध्वं च महात्मानं कर्णं वैकर्तनं युधि।\nप्रचरन्तं महेष्वासं दिव्यैरस्त्रैर्महाबलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2059791, "chapter_id": 2280, "verse_number": "८-१-११", "content_sanskrit": "यस्य वै युधि सन्त्रासात्कुन्तीपुत्रो धनञ्जयः।\nनिवर्तते सदा मन्दः सिंहात्क्षुद्रमृगो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2059792, "chapter_id": 2280, "verse_number": "८-१-१२", "content_sanskrit": "येन नागायुतप्राणो भीमसेनो महाबलः।\nमानुषेणैव युद्धेन तामवस्थां प्रवेशितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2059793, "chapter_id": 2280, "verse_number": "८-१-१३", "content_sanskrit": "येन दिव्यास्त्रविच्छूरो मायावी स घटोत्कचः।\nअमोघया रणे शक्त्या निहतो भैरवं नदन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2059794, "chapter_id": 2280, "verse_number": "८-१-१४", "content_sanskrit": "तस्य दुर्वारवीर्यस्य सत्यसन्धस्य धीमतः।\nबाह्वोर्द्रविणमक्षय्यमद्य द्रक्ष्यथ संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2059795, "chapter_id": 2280, "verse_number": "८-१-१५", "content_sanskrit": "द्रोणपुत्रस्य विक्रान्तं राधेयस्यैव चोभयोः।\nपश्यन्तु पाण्डुपुत्रास्ते विष्णुवासवयोरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2059796, "chapter_id": 2280, "verse_number": "८-१-१६", "content_sanskrit": "सर्व एव भवन्तश्च शक्ताः प्रत्येकशोऽपि वा।\nपाण्डुपुत्रान्रणे हन्तुं ससैन्यान्किसु संहताः।\nवीर्यवन्तः कृतास्त्राश्च द्रक्ष्यथाद्य परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2059797, "chapter_id": 2280, "verse_number": "८-१-१७x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2059798, "chapter_id": 2280, "verse_number": "८-१-१७", "content_sanskrit": "एवमुक्त्वा ततः कर्णं चक्रे सेनापतिं तदा।\nतव पुत्रो महावीर्यो भ्रातृभिः सहितोऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2059799, "chapter_id": 2280, "verse_number": "८-१-१८", "content_sanskrit": "सैनापत्यमथावाप्य कर्णो राजन्महारथः।\nसिंहनादं विनद्योच्चैः प्रायुध्यत रणोत्कटः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2059800, "chapter_id": 2280, "verse_number": "८-१-१९", "content_sanskrit": "ससृञ्जयानां सर्वेषां पाञ्चालानां च मारिष।\nकेकयानां विदेहानां चकार कदनं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2059801, "chapter_id": 2280, "verse_number": "८-१-२०", "content_sanskrit": "तस्येषुधाराः शतशः प्रादुरासञ्छरासनात्।\nअग्रे पुङ्खेषु संसक्ता यथा भ्रमरपङ्क्तयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2059802, "chapter_id": 2280, "verse_number": "८-१-२१", "content_sanskrit": "स पीडयित्वा पाञ्चालान्पाण्डवांश्च तरस्विनः।\nहत्वा सहस्रशो योधानर्जुनेन निपातितः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2059803, "chapter_id": 2280, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि तृतीयोऽध्यायः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]