[{"id": 7006489000, "chapter_id": 26489, "verse_number": "३-२८-१", "content_sanskrit": "पुष्करे श्रीविष्ण्वादीनां तपःकरणं, तस्य प्रभावस्य वर्णनम् वैशम्पायन उवाच दिशं जिगमिषुर्दिव्यामुत्तरां सत्यसाधनः ।\nतथा स धातुनिचये पुण्ये पर्वतरोधसि ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006489001, "chapter_id": 26489, "verse_number": "३-२८-२", "content_sanskrit": "विष्णुः परमधर्मात्मा एकपादेन तिष्ठति ।\nदशवर्षसहस्राणि पुष्करे पुष्करेक्षणः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006489002, "chapter_id": 26489, "verse_number": "३-२८-३", "content_sanskrit": "आत्मन्यात्मानमाधाय तपसा ब्रह्मसम्भवः ।\nघटते कर्मणोग्रेण लोकमुत्थानकारणात् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006489003, "chapter_id": 26489, "verse_number": "३-२८-४", "content_sanskrit": "भासुरो भस्मनाऽऽच्छाद्य गात्राणि स्वयमात्मनः ।\nअष्टौ वर्षसहस्राणि सहस्रं च तपोधनः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006489004, "chapter_id": 26489, "verse_number": "३-२८-५", "content_sanskrit": "तेजसा तेन ज्योतींषि विभाव्य ब्राह्मणर्षभः ।\nतिष्ठते नभसो मध्ये योगात्मा भावयञ्जगत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006489005, "chapter_id": 26489, "verse_number": "३-२८-६", "content_sanskrit": "सोमो विषयमाक्षिप्य मनसा धारयन्मनः ।\nयुक्तः परमधर्मात्मा ब्राह्मीं सिद्धिमुपागतः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006489006, "chapter_id": 26489, "verse_number": "३-२८-७", "content_sanskrit": "सम्प्रदृश्यत सर्वत्र दिवि भुव्यन्तरे तथा ।\nज्योतिष्णु कर्म कुर्वाणो बहुरूपः स सम्पदा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006489007, "chapter_id": 26489, "verse_number": "३-२८-८", "content_sanskrit": "महेश्वरोऽतिगूढान्मा वृषरूपेण तिष्ठति ।\nउद्धृत्य दक्षिणं पादं वायुभक्षः समाहितः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006489008, "chapter_id": 26489, "verse_number": "३-२८-९", "content_sanskrit": "अष्टौ वर्षसहस्राणि स्रहस्रं शतमेव च ।\nमहायोगी महादेवो नियमाद् ब्रह्मसम्भवः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006489009, "chapter_id": 26489, "verse_number": "३-२८-१०", "content_sanskrit": "अथ वायुर्घनीभूतो अन्ते चरति गोपतेः ।\nफेनीभूतं समुद्गारैः पवनं निर्गिरन्मुखात् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006489010, "chapter_id": 26489, "verse_number": "३-२८-११", "content_sanskrit": "स निष्क्रान्तस्ततो वक्त्रात्प्राणेन परमाप्तवान् ।\nनिर्यासभूतः पतितो नैवार्द्रो नैव पार्थिवः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006489011, "chapter_id": 26489, "verse_number": "३-२८-१२", "content_sanskrit": "स फेनो वारिणाऽऽविश्य चचार वसुधातले ।\nनैवार्द्रो नैव शुष्काङ्गो वायुसंघातमागतः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006489012, "chapter_id": 26489, "verse_number": "३-२८-१३", "content_sanskrit": "तत्काले फेनमुत्क्षिप्य पवनः सह वारिणा ।\nनिरालम्बे निरालम्बस्त्वभ्राणि समपद्यत ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006489013, "chapter_id": 26489, "verse_number": "३-२८-१४", "content_sanskrit": "ते क्षिपन्ति पयो भूमावात्मानं स्वेन घट्टिताः ।\nनीलमेघारुणप्रख्या नैवाद्रा नैव पार्थिवाः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006489014, "chapter_id": 26489, "verse_number": "३-२८-१५", "content_sanskrit": "ब्राह्मीं मूर्तिं समाधाय वायुः सर्वत्रगो वशी ।\nसमाः सहस्रं सम्पूर्णं चचार विपुल तपः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006489015, "chapter_id": 26489, "verse_number": "३-२८-१६", "content_sanskrit": "वह्निर्बहुजटी भूत्वा चीरवल्कलवासभृत् तपस्तप्यदनाहारो मौनमास्थाय पौष्करे ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006489016, "chapter_id": 26489, "verse_number": "३-२८-१७", "content_sanskrit": "वर्षाणां च सहस्राणि त्रीणि चैकं च यत्नतः ।\nतस्याग्नेस्तेजः सम्भूतो महानग्निः प्रवर्तते ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006489017, "chapter_id": 26489, "verse_number": "३-२८-१८", "content_sanskrit": "स्वर्गप्रकाशं कृत्वा च स्वर्गवासी तमोनुदः ।\nदिवि भूतप्रकाशाख्यस्तपसा ब्रह्मसम्भवः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006489018, "chapter_id": 26489, "verse_number": "३-२८-१९", "content_sanskrit": "तत्तमो भुवि राजेन्द्र मानुषेषु प्रतिष्ठितम् ।\nभास्करस्तेजसंहारस्ततो भवति सत्तमः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006489019, "chapter_id": 26489, "verse_number": "३-२८-२०", "content_sanskrit": "मर्त्यानां सर्वभूतानां तेज आक्षिप्य वर्तते ।\nन तु योगबले राजन् ब्राह्मणस्य विशेषतः ।\nतत्तमोनाशयेद् रात्रौ नाप्यहोभविताद्वयम्॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006489020, "chapter_id": 26489, "verse_number": "३-२८-२१", "content_sanskrit": "पुष्पमित्रो महातेजा यक्षः सर्वत्रगो वशी ।\nतपश्चरति धर्मात्मा पुष्करेषु समाहितः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006489021, "chapter_id": 26489, "verse_number": "३-२८-२२", "content_sanskrit": "महेन्द्रशिखराद्धारा यावन्त्यो यान्ति मेदिनीम् ।\nतावत्स्वरूपमास्थाय तिष्ठते निखिलाः समाः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006489022, "chapter_id": 26489, "verse_number": "३-२८-२३", "content_sanskrit": "जानुभ्यां पतितो भूमौ ज्योतिर्नभसि पश्यति ।\nसमाः सहस्रं निखिलं नेत्रैरनिमिषैर्जगत् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006489023, "chapter_id": 26489, "verse_number": "३-२८-२४", "content_sanskrit": "नेत्राणि बहुधा तस्य नेत्रान्तैरभिनिःसृताः ।\nमध्यन्दिनकरे प्राप्ते रश्मिवान् सपरिग्रहे ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006489024, "chapter_id": 26489, "verse_number": "३-२८-२५", "content_sanskrit": "ते रश्मयः प्रभानेत्रैः शतशोऽथ सहस्रशः ।\nरराज तेजःसंयोगाद् विद्वद्भिरिव पावकः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006489025, "chapter_id": 26489, "verse_number": "३-२८-२६", "content_sanskrit": "स विस्फुलिङ्गैर्नेत्रान्तैरादित्यमनुवर्तते ।\nकर्मणोऽन्ते युगान्ते वा जगतो बहुरूपिणः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006489026, "chapter_id": 26489, "verse_number": "३-२८-२७", "content_sanskrit": "बहुतापः पुनर्भूत्वा निषण्णो वसुधातले ।\nसमाः सहस्रं सम्पूर्णं तपस्तेपे सुदारुणम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006489027, "chapter_id": 26489, "verse_number": "३-२८-२८", "content_sanskrit": "निगृहीतेन्द्रियो भूत्वा अप्सरोभिर्ललाम ह ।\nमेरोः शिखरमासाद्य कामं कामेन निर्वमन् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006489028, "chapter_id": 26489, "verse_number": "३-२८-२९", "content_sanskrit": "तपःकामः स यक्षस्तु कुबेरो नरवाहनः ।\nविष्णुरेव तपोऽध्यक्षस्तेजसोऽन्ते विजृम्भति ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006489029, "chapter_id": 26489, "verse_number": "३-२८-३०", "content_sanskrit": "न हि कश्चित् पुमानस्ति य एवं तप आचरेत् ।\nत्रिषु लोकेषु राजेन्द्र ऋते विष्णुं सनातनम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006489030, "chapter_id": 26489, "verse_number": "३-२८-३१", "content_sanskrit": "वासुकिर्बहुशीर्षस्तु नागेन्द्रो मौनमास्थितः ।\nतप आचरते सम्यङ् निधाय मनसा मनः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006489031, "chapter_id": 26489, "verse_number": "३-२८-३२", "content_sanskrit": "शेषः सत्यधृतिर्नागो बलवान् ब्रह्मसम्भवः ।\nवृक्षमारुह्य धर्मात्मा अवाक्छीर्षोऽवलम्बते ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006489032, "chapter_id": 26489, "verse_number": "३-२८-३३", "content_sanskrit": "जिह्वाभिर्लेलिहानाभिर्गात्रजं विषमुत्सृजन् ।\nसमाः सहस्रं सम्पूर्णं निराहारस्तपोधनः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006489033, "chapter_id": 26489, "verse_number": "३-२८-३४", "content_sanskrit": "कालकूटं विषं तद्धि सुमहत् समपद्यत ।\nयेन लोको ह्यभिग्रस्तो न सुखं विन्दते नृप ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006489034, "chapter_id": 26489, "verse_number": "३-२८-३५", "content_sanskrit": "सर्वत्रानुगतं तीक्ष्णं भुजङ्गेषु महीपते ।\nजङ्गमं स्थावरं चैव सर्वत्रानुगतं विषम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006489035, "chapter_id": 26489, "verse_number": "३-२८-३६", "content_sanskrit": "परस्परविवृद्धेन हिंसायुक्तेन भारत ।\nनाशयत्यान्मनोऽङ्गानि तेन तीक्ष्णेन भारत ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006489036, "chapter_id": 26489, "verse_number": "३-२८-३७", "content_sanskrit": "अथ ब्रह्मा महाभागो भूतानां हितकाम्यया ।\nमन्त्रं विसृजते राजन् ब्रह्माक्षरमहिंसकम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006489037, "chapter_id": 26489, "verse_number": "३-२८-३८", "content_sanskrit": "गरुत्मान् विततैः पक्षैर्नखाग्रैः सलिलं महीम् ।\nसमाः सहस्रं सम्पूर्णं चूलाग्रेणावलम्बिना ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006489038, "chapter_id": 26489, "verse_number": "३-२८-३९", "content_sanskrit": "पर्णभारैश्च विकचैर्विस्तीर्णैर्वसुधातले ।\nरराज वसुधा चैव पर्णैर्बहुविचित्रितैः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006489039, "chapter_id": 26489, "verse_number": "३-२८-४०", "content_sanskrit": "येन वृत्तेन जीवेयुः सर्वभूतानि भारत ।\nइह लोके मनुष्येन्द्र देवलोके च भारत ।\nद्यौरिवाचितनक्षत्रा मही तलविसर्पिभिः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006489040, "chapter_id": 26489, "verse_number": "३-२८-४१", "content_sanskrit": "हिमवान् हिमसम्पाते भवत्येकचरो वशी ।\nपुष्कराम्भसि धर्मात्मा मत्स्योल्लिखितमूर्धजः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006489041, "chapter_id": 26489, "verse_number": "३-२८-४२", "content_sanskrit": "अथ स्वबलमाक्रम्य पृथिवीं प्रांशुद्वाहिनीम् ।\nतपश्चरति धर्मात्मा बाहुमुद्यम्य दक्षिणम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006489042, "chapter_id": 26489, "verse_number": "३-२८-४३", "content_sanskrit": "साग्रं वर्षसहस्रं च शतमेकं च सुव्रत ।\nतपश्चरति संयोगाद् वायुभक्षः समाहितः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006489043, "chapter_id": 26489, "verse_number": "३-२८-४४", "content_sanskrit": "समाधियोगात् सङ्गाद् वा ब्रह्मयोगस्य भारत ।\nयेनेयं पृथिवी राजन् धार्यते ब्रह्मयोनिना ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006489044, "chapter_id": 26489, "verse_number": "३-२८-४५", "content_sanskrit": "अनाद्यन्तेन नित्येन सर्वत्र विषयैषिणा ।\nयोऽसौ विष्णुरगाधात्मा परमात्मा निराकृतिः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006489045, "chapter_id": 26489, "verse_number": "३-२८-४६", "content_sanskrit": "दिने निषण्णो भवति रात्रौ भवति वै स्थिरः ।\nसत्यसंधः स धर्मात्मा कामकारकरो भवेत् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006489046, "chapter_id": 26489, "verse_number": "३-२८-४७", "content_sanskrit": "तस्य यः सोद्यतः पाणिः पृथिव्यां पृथिवीसमः ।\nरात्रौ स तपनो भवति मण्डलं विपुलं नभः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006489047, "chapter_id": 26489, "verse_number": "३-२८-४८", "content_sanskrit": "स चन्द्रविषयं राजञ्छमयामास रुन्धति ।\nग्रहाणां गतयश्चैव ताराणां च विशेषतः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006489048, "chapter_id": 26489, "verse_number": "३-२८-४९", "content_sanskrit": "तां छायामाक्षिपन् सोमात्स्रवद्भिर्मण्डलेन वै ।\nपृथिव्यां दक्षिणो हस्तो महायोगी महामनाः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006489049, "chapter_id": 26489, "verse_number": "३-२८-५०", "content_sanskrit": "सैषा छाया शशीभूता शशिमण्डलमाविशत् ।\nअलिङ्गा पृथिवीलिङ्गादद्भुतादक्षया दिवि ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006489050, "chapter_id": 26489, "verse_number": "३-२८-५१", "content_sanskrit": "अङ्गाङ्गान्युपगृह्यैव तपश्चरति निश्चयात् ।\nप्रोक्ष्य पादौ तु सतलौ पृथिवी तपसि स्थिता ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006489051, "chapter_id": 26489, "verse_number": "३-२८-५२", "content_sanskrit": "सूर्यार्चिभिः पीयमानादाक्षिप्यत मही तले ।\nमहीमिवाम्बुवसनां युगान्ते विष्णुतेजसा ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006489052, "chapter_id": 26489, "verse_number": "३-२८-५३", "content_sanskrit": "रराज सूर्यरश्मिभिर्व्यतिषिक्ता महानदी ।\nस्फाटिकेव शुभा सैषा काञ्चनैर्धातुभिर्वृता ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006489053, "chapter_id": 26489, "verse_number": "३-२८-५४", "content_sanskrit": "आदित्येन समादत्ता रश्मितेजोऽभिसम्भवैः ।\nमण्डलान्तर्गता देवी चक्षुषा नोपलभ्यते ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006489054, "chapter_id": 26489, "verse_number": "३-२८-५५", "content_sanskrit": "रश्मिभिः पुनरुत्तीर्णा ततो योगेन धावति ।\nआकाशगङ्गा संवृत्ता विपुलैरम्बुविग्रहैः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006489055, "chapter_id": 26489, "verse_number": "३-२८-५६", "content_sanskrit": "शीतच्छायैश्च तरुभिर्लताभिश्च सुगन्धिभिः ।\nपद्मखण्डैश्च विविधैः शुशुभे दिव्यगन्धिभिः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006489056, "chapter_id": 26489, "verse_number": "३-२८-५७", "content_sanskrit": "काञ्चनापीडजघना स्फाटिकान्तरमेखला ।\nपद्मरेणुसिता पीता चक्रवाकावतंसिका ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006489057, "chapter_id": 26489, "verse_number": "३-२८-५८", "content_sanskrit": "नीलगर्भसुकेशान्ता पुष्पसंचयसंकुला ।\nशोभते विप्रसर्पन्ति प्रमदेव विभूषिता ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006489058, "chapter_id": 26489, "verse_number": "३-२८-५९", "content_sanskrit": "सैषा गङ्गा फलं लेभे पुष्करेण समाहिता ।\nसुतपा चन्द्रविहिता लोकानां धारणे रता ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006489059, "chapter_id": 26489, "verse_number": "३-२८-६०", "content_sanskrit": "सरस्वती स्वरैर्व्यक्तैरधीते ब्रह्मवादिनी ।\nपृष्ठात् प्रयाता शैलेन्द्रे मन्दरे मन्दगामिनी ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006489060, "chapter_id": 26489, "verse_number": "३-२८-६१", "content_sanskrit": "ऋङ्मयांश्चतुरो वेदान् पादैश्चतुर्भिरावृतान् ।\nयजुर्भिः सामभिश्चैव ग्रथिताञ्छिक्षया तदा ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006489061, "chapter_id": 26489, "verse_number": "३-२८-६२", "content_sanskrit": "ऋषिभिर्ज्वलनप्रख्यैस्तपसा दग्धकिल्बिषैः ।\nसुपार्श्वस्य गिरेः पादे परिदायैः सुपारणैः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006489062, "chapter_id": 26489, "verse_number": "३-२८-६३", "content_sanskrit": "निःस्वनं सर्वभूतानि नियमैश्च न शृण्वते ।\nमन्दराग्रे विसर्पन्तं जगत्कृत्स्नमतीन्द्रियम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006489063, "chapter_id": 26489, "verse_number": "३-२८-६४", "content_sanskrit": "विरामनियमे प्राप्ते तूष्णींभूता बभूव ह ।\nन वाचमीरयेद् देवी नियमात् सत्यवादिनी ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006489064, "chapter_id": 26489, "verse_number": "३-२८-६५", "content_sanskrit": "अथ भूतानि सर्वाणि तूष्णींभूतानि सर्वशः ।\nन शेकुरभिधानार्थं व्याहर्तुं वदनैर्बलात् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006489065, "chapter_id": 26489, "verse_number": "३-२८-६६", "content_sanskrit": "विभज्य योगं मनसा सर्वभूतेष्वनुग्रहम् ।\nसरस्वती तीरयुता व्याजहार महास्वनम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006489066, "chapter_id": 26489, "verse_number": "३-२८-६७", "content_sanskrit": "सरस्वत्या समायुक्तां शिक्षां गृह्णन्ति देहिनः ।\nतस्मिन्नेवाथ ते सर्वे गानं गायन्ति शिक्षया ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006489067, "chapter_id": 26489, "verse_number": "३-२८-६८", "content_sanskrit": "आदित्या वसवो रुद्रा मरुतश्चाश्विभिः सह ।\nजटिलाश्चीरवसना मुञ्जमेखलधारिणः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006489068, "chapter_id": 26489, "verse_number": "३-२८-६९", "content_sanskrit": "गन्धर्वाः किन्नराश्चैव सनागाः सह चाम्भसः ।\nतपश्चरन्ति सहिताः पुष्करेषु मनीषिणः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006489069, "chapter_id": 26489, "verse_number": "३-२८-७०", "content_sanskrit": "अपि कीटपतङ्गैश्च सह सर्वैः सरीसृपैः ।\nशोषयन्ति शरीराणि तपसोग्रेण यत्नतः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006489070, "chapter_id": 26489, "verse_number": "३-२८-७१", "content_sanskrit": "विष्णुर्विष्णुत्वमापन्नो देहान्तरविसृष्टवान् ।\nसंरक्षति महायोगी सर्वांस्तान् सहचारिणः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006489071, "chapter_id": 26489, "verse_number": "३-२८-७२", "content_sanskrit": "पुष्करे रमते विष्णुर्विष्णुरेव द्विधा कृतः ।\nदीप्यमानः स्वतेजोभिर्विधूम इव पावकः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006489072, "chapter_id": 26489, "verse_number": "३-२८-७३", "content_sanskrit": "सोऽग्निर्मनःसमुद्भूतः पृथिवीं तापयन्निव ।\nप्रधावति समं तेन मण्डलं दशयोजनम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006489073, "chapter_id": 26489, "verse_number": "३-२८-७४", "content_sanskrit": "विरराजार्चिभिर्दीप्तैः पृष्ठतश्चावलम्बिभिः ।\nविशीर्णपार्थिविभवैर्मयूखैरिव दीपितः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006489074, "chapter_id": 26489, "verse_number": "३-२८-७५", "content_sanskrit": "तस्याग्नेर्विस्फुलिङ्गानां न शेकुर्लङ्घने रताः ।\nविप्रकीर्णस्य वसुधामर्यादामिव भास्करम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006489075, "chapter_id": 26489, "verse_number": "३-२८-७६", "content_sanskrit": "सोऽग्निर्दीप्य विभज्यांशून्विधूम इव पावकः ।\nऋत्विग्भिर्ज्वलनप्रख्यैर्विक्रीयत इवाध्वरे ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7006489076, "chapter_id": 26489, "verse_number": "३-२८-७७", "content_sanskrit": "सोऽग्निर्धूमगतस्तत्र तिष्ठते विपुलं तदा ।\nयावद्विष्णुक्रमः प्राप्तो नियमस्य समापनात् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7006489077, "chapter_id": 26489, "verse_number": "३-२८-७८", "content_sanskrit": "रक्षां कृत्वा स्थितं विद्याद् विष्णुर्विष्णुपराक्रमः ।\nभूत्वा शतशरीरो वै नागो बालाहकोऽभवत् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7006489078, "chapter_id": 26489, "verse_number": "३-२८-७९", "content_sanskrit": "तमग्निमात्मसंसृष्टं लेलिहानं महामतिम् ।\nप्रतिप्रवृत्तं तेजोभिर्भूतानां हितकाम्यया ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7006489079, "chapter_id": 26489, "verse_number": "३-२८-८०", "content_sanskrit": "वारिणा सुखशीतेन प्राणिनां प्राणवर्धनः ।\nन्यषिञ्चद् दहनं तत्र नागो बालाहकस्तदा ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7006489080, "chapter_id": 26489, "verse_number": "३-२८-८१", "content_sanskrit": "ततः सिद्धगणैर्जुष्टः पुष्करे तप्यते तपः ।\nसंहृत्य मनसाऽऽत्मानं महायोगी महाबलः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7006489081, "chapter_id": 26489, "verse_number": "३-२८-८२", "content_sanskrit": "पादगात्राणि संहृत्य मनो मूर्ध्नि विधारयन् ।\nअचलं स्थानमासाद्य तूष्णीभूतो बभूव ह ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7006489082, "chapter_id": 26489, "verse_number": "३-२८-८३", "content_sanskrit": "एष धर्मो हि धर्माणां नोपधानविकल्पितः ।\nहितः सर्वेषु भूतेषु इह चामुत्र चोभयोः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7006489083, "chapter_id": 26489, "verse_number": "३-२८-८४", "content_sanskrit": "अथ दैत्या हतास्तत्र समागम्योद्यतायुधाः ।\nमायाप्राप्तैर्बहुविधैर्नगरैरभिसंवृताः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7006489084, "chapter_id": 26489, "verse_number": "३-२८-८५", "content_sanskrit": "अग्निं दैत्याः पर्वताग्रैरभिघ्नन्ति परंतप ।\nज्वलन्तं ज्वलनप्रख्या महाकाया महाबलाः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7006489085, "chapter_id": 26489, "verse_number": "३-२८-८६", "content_sanskrit": "मेघीभूताश्च मायाभिर्वर्षन्ति बलदर्पिताः ।\nतस्मिन्नेवाभिसंघाते ससंघातं महाबलम् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7006489086, "chapter_id": 26489, "verse_number": "३-२८-८७", "content_sanskrit": "ते शैलास्त्वर्षिषा दग्धाः शतशोऽथ सहस्रशः ।\nयुगान्ते प्रभुरादित्यः प्रजा इव दिधक्षति ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7006489087, "chapter_id": 26489, "verse_number": "३-२८-८८", "content_sanskrit": "न शेकुरग्निं दैत्यास्ते मायाभिर्मुखमुद्यतम् ।\nआदित्यमिव दीप्यन्तं नभः सूर्योदये यथा ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7006489088, "chapter_id": 26489, "verse_number": "३-२८-८९", "content_sanskrit": "विहितैरुद्यमैः सर्वे देत्या भग्नपराक्रमाः ।\nगन्धमादनमासाद्य निषण्णा नगमूर्धनि ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7006489089, "chapter_id": 26489, "verse_number": "३-२८-९०", "content_sanskrit": "स चाग्निर्वैष्णवैर्लोकैर्विद्युद्भिः सह संगतः ।\nअन्तरिक्षचरान् दैत्यान् निर्दहन्व्यचरद् दिवि॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7006489090, "chapter_id": 26489, "verse_number": "३-२८-९१", "content_sanskrit": "नागो बालाहकश्चैव मेघैः संघातमागतः ।\nमुमोच सलिलं भूमौ पर्जन्य इव वृष्टिमान् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7006489091, "chapter_id": 26489, "verse_number": "३-२८-९२", "content_sanskrit": "मन्त्रैः संचोदितो नागो द्विजेभ्यो वदनोद्गतैः ।\nमुमोच तोयसंघातं मानयन् विप्रजं जनम् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}]