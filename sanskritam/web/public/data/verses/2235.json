[{"id": 2056981, "chapter_id": 2235, "verse_number": "७-१६२-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2056982, "chapter_id": 2235, "verse_number": "७-१६२-१", "content_sanskrit": "ततो युधिष्ठिरश्चैव भीमसेनश्च पाण्डवः।\nद्रोणपुत्रं महाराज समन्तात्पर्यवारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2056983, "chapter_id": 2235, "verse_number": "७-१६२-२", "content_sanskrit": "ततो दुर्योधनो राजा भारद्वाजेन संवृतः।\nअभ्ययात्पाण्डवान्सङ्ख्ये ततो युद्धमवर्तत।\nघोररूपं महाराज भीरूणां भयवर्धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2056984, "chapter_id": 2235, "verse_number": "७-१६२-३", "content_sanskrit": "अम्बष्ठान्मालवान्वङ्गाञ्छिबींस्त्रैगर्तकानपि।\nप्राहिणोन्मृत्युलोकाय गणान्क्रुद्धो वृकोदरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2056985, "chapter_id": 2235, "verse_number": "७-१६२-४", "content_sanskrit": "अभीषाहाञ्छूरसेनान्क्षत्रियान्युद्धदुर्मदान्।\nनिकृत्त्य पृथिवीं चक्रे भीमः शोणितकर्दमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2056986, "chapter_id": 2235, "verse_number": "७-१६२-५", "content_sanskrit": "यौधेयानद्रिजान्राजन्मद्रकान्मालवानपि।\nप्राहिणोन्मृत्युलोकाय किरीटी निशितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2056987, "chapter_id": 2235, "verse_number": "७-१६२-६", "content_sanskrit": "प्रगाढमञ्चोगतिभिर्नाराचैरभिताडिताः।\nनिपेतुर्द्विरदा भूमौ द्विशृङ्गा इव पर्वताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2056988, "chapter_id": 2235, "verse_number": "७-१६२-७", "content_sanskrit": "निकृत्तैर्हस्तिहस्तैश्च चेष्टमानैरितस्ततः।\nरराज वसुधाऽऽकीर्णा विसर्पद्भिरिवोरगैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2056989, "chapter_id": 2235, "verse_number": "७-१६२-८", "content_sanskrit": "क्षिप्तैः कनकचित्रैश्च नृपच्छत्रैः क्षितिर्बभौ।\nद्यौरिवादित्यचन्द्राद्यैर्ग्रहैः कीर्णा युगक्षये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2056990, "chapter_id": 2235, "verse_number": "७-१६२-९", "content_sanskrit": "हत प्रहरताभीता विध्यत व्यवकृन्तत।\nइत्यासीत्तुमुलः शब्दः शोणाश्वस्य रथं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2056991, "chapter_id": 2235, "verse_number": "७-१६२-१०", "content_sanskrit": "द्रोणस्तु परमक्रुद्धो वायव्यास्त्रेण संयुगे।\nव्यधमत्तान्महवायुर्मेघानिव दुरत्ययः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2056992, "chapter_id": 2235, "verse_number": "७-१६२-११", "content_sanskrit": "ते हन्यमाना द्रोणेन पाञ्चालाः प्राद्रवन्भयात्।\nपश्यतो भीमसेनस्य पार्थस्य च महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2056993, "chapter_id": 2235, "verse_number": "७-१६२-१२", "content_sanskrit": "ततः किरीटि भीमश्च सहसा सन्न्यवर्तताम्।\nमहता रथवंशेन परिगृह्य बलं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2056994, "chapter_id": 2235, "verse_number": "७-१६२-१३", "content_sanskrit": "बीभत्सुर्दक्षिणं वार्श्वमुत्तरं तु वृकोदरः।\nभारद्वाजं शरौघाभ्यां महद्भामभ्यवर्षताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2056995, "chapter_id": 2235, "verse_number": "७-१६२-१४", "content_sanskrit": "तौ तथा सृञ्जयाश्चैव पाञ्चालाश्च महौजसः।\nअन्वगच्छन्महाराज मात्स्यैश्च सह सोमकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2056996, "chapter_id": 2235, "verse_number": "७-१६२-१५", "content_sanskrit": "तथैव तव पुत्रस्य रथोदाराः प्रहारिणः।\nमहत्या सेनया राजञ्जग्मुर्द्रोणरथं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2056997, "chapter_id": 2235, "verse_number": "७-१६२-१६", "content_sanskrit": "ततः सा भारती सेना हन्यमाना किरीटिना।\nतमसा निद्रया चैव पुनरेव व्यदीर्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2056998, "chapter_id": 2235, "verse_number": "७-१६२-१७", "content_sanskrit": "द्रोणेन वार्यमाणास्ते स्वयं तव सुतेन च।\nनाशक्यन्त महाराज योधा वारयितुं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2056999, "chapter_id": 2235, "verse_number": "७-१६२-१८", "content_sanskrit": "सा पाण्डुपुत्रस्य शरैर्दीर्यमाणा महाचमूः।\nतमसा संवृते लोके व्यद्रवत्सर्वतोमुखी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2057000, "chapter_id": 2235, "verse_number": "७-१६२-१९", "content_sanskrit": "उत्सृज्य शतशो वाहांस्तत्र केचिन्नराधिपाः।\nप्राद्रवन्त महाराज भयाविष्टाः समन्ततः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2057001, "chapter_id": 2235, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि घटोत्कचवधपर्वणि चतुर्दशरात्रियुद्धे द्विषष्ट्यधिकशततमोऽध्यायः॥ १६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]