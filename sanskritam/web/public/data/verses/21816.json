[{"id": 7001816000, "chapter_id": 21816, "verse_number": "२-७७-१", "content_sanskrit": "मोहिन्युवाच ।\nश्रुतं मया द्विजश्रेष्ठ सेतुमाहात्म्यमुत्तमम् ।\nअधुना श्रोतुमिच्छामि नर्मदातीर्थसंग्रहम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001816001, "chapter_id": 21816, "verse_number": "२-७७-२", "content_sanskrit": "वसुरुवाच ।\nश्रृणु मोहिनि वक्ष्यामि नर्मदोभयतीरगम् ।\nचतुःशतं मुख्यतमं प्रोक्तं तीर्थकदंबकम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001816002, "chapter_id": 21816, "verse_number": "२-७७-३", "content_sanskrit": "एकादशोत्तरे तीरे दक्षिणे च त्रिविंशतिः ।\nपंचत्रिंशत्तमः प्रोक्तो रेवासागरसंगमः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001816003, "chapter_id": 21816, "verse_number": "२-७७-४", "content_sanskrit": "ॐकारतीर्थं परितोनगादमरकंटकात् ।\nक्रोशद्वये सर्वदिक्षु सार्द्धकोटित्रयी स्थिता ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001816004, "chapter_id": 21816, "verse_number": "२-७७-५", "content_sanskrit": "कोटिरेका तु तीर्थानां कपिलासंगमे स्थिता ।\nअशोकवनिकायां च तीर्थलक्षं प्रतिष्ठितम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001816005, "chapter_id": 21816, "verse_number": "२-७७-६", "content_sanskrit": "शतमंगारगर्तायाः कुब्जांया अयुतं तथा ।\nसहस्रं वायुसंगे तु सरस्वत्याः शतं स्थितम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001816006, "chapter_id": 21816, "verse_number": "२-७७-७", "content_sanskrit": "शतद्वयं शुक्लतीर्थे सहस्रं विष्णुतीर्थके ।\nमाहिष्मत्यां च साहस्रं शूलभेदेऽयुतं विदुः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001816007, "chapter_id": 21816, "verse_number": "२-७७-८", "content_sanskrit": "देवग्रामे सहस्रं चोलूके सप्तशती स्थिता ।\nतीर्थान्यष्टोत्तरशतं मणिनद्याश्च संगमे ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001816008, "chapter_id": 21816, "verse_number": "२-७७-९", "content_sanskrit": "वैद्यनाथे च तावंति तावंत्येव घटेश्वरे ।\nसार्द्धलक्षं च तीर्थानां स्थितं रेवाब्धिसंगमे ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001816009, "chapter_id": 21816, "verse_number": "२-७७-१०", "content_sanskrit": "अष्टाशीतिसहस्राणि व्यासे द्वीपशतानि च ।\nसंगमे तु करंजायाः स्थितमष्टोत्तरायुतम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001816010, "chapter_id": 21816, "verse_number": "२-७७-११", "content_sanskrit": "एरंडीसंगमे तद्वत्तीर्थान्यष्टाधिकं शतम् ।\nधूतपापेऽष्टषष्टिश्च सार्द्धकोटिश्च कोकिले ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001816011, "chapter_id": 21816, "verse_number": "२-७७-१२", "content_sanskrit": "सहस्रं रोमकेशे च द्वादशार्के सहस्रकम् ।\nलक्षाष्टके सहस्रे द्वे शुक्लतीर्थे नरेश्वरि ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001816012, "chapter_id": 21816, "verse_number": "२-७७-१३", "content_sanskrit": "संगमेषु तु सर्वेषु शतमष्टाधिकं विदुः ।\nकावेर्याः संगमे नंदे तीर्थपंचशतीस्थिता ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001816013, "chapter_id": 21816, "verse_number": "२-७७-१४", "content_sanskrit": "भृगोः क्षेत्रे च तीर्थानां कोटिरेका व्यवस्थिता ।\nभारभूत्यां च तीर्थानां शतमष्टोत्तरं स्थितम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001816014, "chapter_id": 21816, "verse_number": "२-७७-१५", "content_sanskrit": "अक्रूरेशे सार्द्धशतं विमलेशे दशायुतम् ।\nसा सार्द्धकोटिरित्येषा तीर्थसंज्ञा च नार्मदे ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001816015, "chapter_id": 21816, "verse_number": "२-७७-१६", "content_sanskrit": "दशादित्यस्य नव च कपिलस्याष्ट वै विधोः ।\nनंदिनः कोटिसंज्ञानि तथैवाष्ट शुभानने ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001816016, "chapter_id": 21816, "verse_number": "२-७७-१७", "content_sanskrit": "नागाग्निसिद्धावर्तानि सप्तसंख्यानि मोहिनि ।\nकेदारेन्द्रियवारीशनंदिदैवानि पंच वै ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001816017, "chapter_id": 21816, "verse_number": "२-७७-१८", "content_sanskrit": "यमेशा वैद्यनाथाश्च वामनांगारकेश्वराः ।\nसारस्वता मुनीशाश्च दारुकेशाश्च गौतमाः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001816018, "chapter_id": 21816, "verse_number": "२-७७-१९", "content_sanskrit": "चत्वार एव गदितास्त्रयो वै विमलेश्वराः ।\nसहस्रयज्ञभीष्मेशास्स्वर्णतीर्थानि चापि हि ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001816019, "chapter_id": 21816, "verse_number": "२-७७-२०", "content_sanskrit": "धौतपापकरंजेशऋणमुक्तिगुहाह्वयम् ।\nदशाश्वमेधनंदाख्यं मन्मथेशाख्यभार्गवम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001816020, "chapter_id": 21816, "verse_number": "२-७७-२१", "content_sanskrit": "पराशरायोनिसंज्ञं व्यासाख्यपितृनंदिकम् ।\nगोपेशमारुतेशाख्यं जंगलेशाख्यशुक्लकम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001816021, "chapter_id": 21816, "verse_number": "२-७७-२२", "content_sanskrit": "अक्षरेशं पिप्पलेशं मांडव्यदीपकेश्वरम् ।\nउत्तरेशमशोकेशं योधनेशं च रौहिणम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001816022, "chapter_id": 21816, "verse_number": "२-७७-२३", "content_sanskrit": "लुकेशं च द्विसंख्याकं प्रत्येकं गदितं शुभे ।\nसैकोनविंशतिशतं तीर्थान्येकैकशः शुभे ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001816023, "chapter_id": 21816, "verse_number": "२-७७-२४", "content_sanskrit": "स्तबकेषु च नीर्थानि द्विशतं च चतुर्द्दशम् ।\nशैवान्येतानि तीर्थानि वैष्णवानि द्विविँशतिः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001816024, "chapter_id": 21816, "verse_number": "२-७७-२५", "content_sanskrit": "ब्राह्माणि सर्वतीर्थानि शाक्तान्यष्टौ च विंशतिः ।\nतेषु सप्त च मातॄणां त्रीणि ब्राह्याः शुभानने ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001816025, "chapter_id": 21816, "verse_number": "२-७७-२६", "content_sanskrit": "वैष्णव्या द्वे तथा भद्रे रौद्री शेवेषु संस्थिता ।\nतथैकं क्षेत्रपालस्य तीर्थमुक्तं शुभानने ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001816026, "chapter_id": 21816, "verse_number": "२-७७-२७", "content_sanskrit": "अवांतराणि गुह्यानि प्रकटानि च मोहिनि ।\nसार्द्धत्रिकोटितीर्थानि गदितानीह वायुना ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001816027, "chapter_id": 21816, "verse_number": "२-७७-२८", "content_sanskrit": "दिवि भुव्यंतरिक्षे च रेवायां तानि संति च ।\nयस्त्वेतेषु महाभागे यत्र कुत्रापि मानवः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001816028, "chapter_id": 21816, "verse_number": "२-७७-२९", "content_sanskrit": "स्नानं करोति शुद्धात्मा स लभेदुत्तमां गतिम् ।\nस्नानं दानं जपो होंवो वेदाध्ययनमर्चनम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001816029, "chapter_id": 21816, "verse_number": "२-७७-३०", "content_sanskrit": "सर्वमक्षयतां याति नर्मदायास्तटे कृतम् ।\nत्र्यहात्सारस्वतं तोयं सप्ताहाद्यामुनं सति ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001816030, "chapter_id": 21816, "verse_number": "२-७७-३१", "content_sanskrit": "गांगं सकृत्प्लवात्पुण्यं दर्शनादेव नार्मदम् ।\nइत्येष कथितो देवि नर्मदातीर्थसंग्रहः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001816031, "chapter_id": 21816, "verse_number": "२-७७-३२", "content_sanskrit": "स्मरतामपि मर्त्यानां महापातकशांतिदः ।\nय इमं श्रृणुयान्मर्त्यो नर्मदातीर्थसंग्रहम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001816032, "chapter_id": 21816, "verse_number": "२-७७-३३", "content_sanskrit": "श्रावयेद्वा पठेद्भद्रे सोऽपि पापैः प्रमुच्यते ।\nयद्गृहे लिखितं चैतन्माहात्म्यं नर्मदाभवम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001816033, "chapter_id": 21816, "verse_number": "२-७७-३४", "content_sanskrit": "विद्यतेऽभ्यर्चितं तत्र न मारीनाग्निजं भयम् ।\nन राजचौरशत्रुभ्यो भयं रोगभयं न च ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001816034, "chapter_id": 21816, "verse_number": "२-७७-३५", "content_sanskrit": "तदूगृहं पूर्य्यते लक्ष्म्या धनैर्द्धान्यैर्निरंतरम् ।\nपुत्रपौत्रादिकानां च विवाहाद्यैः सुमंगलम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]