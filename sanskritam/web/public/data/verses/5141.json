[{"id": 2194841, "chapter_id": 5141, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2194842, "chapter_id": 5141, "verse_number": "१", "content_sanskrit": "स वनानि विचित्राणि तीर्थानि च सरांसि च ।\nअभिगच्छन्क्रमेण स्म कञ्चिन्मुनिमुपस्थितः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2194843, "chapter_id": 5141, "verse_number": "२", "content_sanskrit": "तं स तेन यथोद्दिष्टं नागं विप्रेण ब्राह्मणः ।\nपर्यपृच्छद् यथान्यायं श्रुत्वैव च जगाम सः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2194844, "chapter_id": 5141, "verse_number": "३", "content_sanskrit": "सोऽभिगम्य यथाख्यातं नागायतनमर्थवित् ।\nप्रोक्तवानहमस्मीति भोःशब्दालङ्कृतं वचः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2194845, "chapter_id": 5141, "verse_number": "४", "content_sanskrit": "ततस्तस्य वचः श्रुत्वा रूपिणी धर्मवत्सला ।\nदर्शयामास तं विप्रं नागपत्नी पतिव्रता\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2194846, "chapter_id": 5141, "verse_number": "५", "content_sanskrit": "सा तस्मै विधिवत् पूजां चक्रे धर्मपरायणा ।\nस्वागतेनागतं कृत्वा किं करोमीति चाब्रवीत्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2194847, "chapter_id": 5141, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2194848, "chapter_id": 5141, "verse_number": "६", "content_sanskrit": "विश्रान्तोऽभ्यर्चितश्चास्मि भवत्या श्र्लक्ष्णया गिरा ।\nद्रष्टुमिच्छामि भवति तं देवं नागमुत्तमम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2194849, "chapter_id": 5141, "verse_number": "७", "content_sanskrit": "एतद्धि परमं कार्यमेतन्मे फलमीप्सितम् ।\nअनेनार्थेन चास्म्यद्य सम्प्राप्तः पन्नगालयम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2194850, "chapter_id": 5141, "verse_number": "", "content_sanskrit": "नागभार्या", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2194851, "chapter_id": 5141, "verse_number": "८", "content_sanskrit": "आर्य सूर्यरथं वोढुं गतोऽसौ मासचारिकः ।\nसप्ताष्टभिर्दिनैर्विप्र दर्शयिष्यत्यसंशयम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2194852, "chapter_id": 5141, "verse_number": "९", "content_sanskrit": "एतद् विदितमार्यस्य विवासकरणं मम ।\nभर्तुर्भवतु किं चान्यत्क्रियतां तद्वदस्व मे\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2194853, "chapter_id": 5141, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2194854, "chapter_id": 5141, "verse_number": "१०", "content_sanskrit": "अनेन निश्चयेनाहं साध्वि सम्प्राप्तवानिह ।\nप्रतीक्षन्नागमं देवि वत्स्याम्यस्मिन् महावने\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2194855, "chapter_id": 5141, "verse_number": "११", "content_sanskrit": "सम्प्राप्तस्यैव चाव्यग्रमावेद्योऽहमिहागतः ।\nममाभिगमनं प्राप्तो वाच्यश्च वचनं त्वया\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2194856, "chapter_id": 5141, "verse_number": "१२", "content_sanskrit": "अहमप्यत्र वत्स्यामि गोमत्याः पुलिने शुभे ।\nकालं परिमिताहारो यथोक्तं परिपालयन्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2194857, "chapter_id": 5141, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2194858, "chapter_id": 5141, "verse_number": "१३", "content_sanskrit": "ततः स विप्रस्तां नागीं समाधाय पुनः पुनः ।\nतदेव पुलिनं नद्याः प्रययौ ब्राह्मणर्षभः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2194859, "chapter_id": 5141, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे नवत्युत्तरशततमोऽध्यायः ॥१९०॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]