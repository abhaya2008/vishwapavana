[{"id": 2080481, "chapter_id": 2711, "verse_number": "१२-२१६-०x", "content_sanskrit": "गुरुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2080482, "chapter_id": 2711, "verse_number": "१२-२१६-१", "content_sanskrit": "अत्रोपायं प्रवक्ष्यामि यथावच्छास्त्रचक्षुषा।\nतत्त्वज्ञानाच्चरन्राजन्प्राप्नुयात्परमां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2080483, "chapter_id": 2711, "verse_number": "१२-२१६-२", "content_sanskrit": "सर्वेषामेव भूतानां पुरुषः श्रेष्ठ उच्यते।\nपुरुषेभ्यो द्विजानाहुर्द्विजेभ्यो मन्त्रदर्शिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2080484, "chapter_id": 2711, "verse_number": "१२-२१६-३", "content_sanskrit": "सर्वभूतात्मभूतास्ते सर्वज्ञाः सर्वदर्शिनः।\nब्राह्मणा वेदशास्त्रज्ञास्तत्त्वार्थगतनिश्चयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2080485, "chapter_id": 2711, "verse_number": "१२-२१६-४", "content_sanskrit": "नेत्रहीनो यथा ह्येकः कृच्छ्राणि लभतेऽध्वनि।\nज्ञानहीनस्तथा लोके तस्माज्ज्ञानविदोऽधिकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2080486, "chapter_id": 2711, "verse_number": "१२-२१६-५", "content_sanskrit": "तांस्तानुपासते धर्मान्धर्मकामा यथागमम्।\nन त्वेषामर्थसामान्यमन्तरेण गुणानिमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2080487, "chapter_id": 2711, "verse_number": "१२-२१६-६", "content_sanskrit": "वाग्देहमनसां शौचं क्षमा सत्यं धृतिः स्मृतिः।\nसर्वधर्मेषु धर्मज्ञा ज्ञापयन्ति गुणाञ्छुभान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2080488, "chapter_id": 2711, "verse_number": "१२-२१६-७", "content_sanskrit": "यदिदं ब्रह्मणो रूपं ब्रह्मंचर्यमिति स्मृतम्।\nपरं तत्सर्वधर्मेभ्यस्तेन यान्ति परां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2080489, "chapter_id": 2711, "verse_number": "१२-२१६-८", "content_sanskrit": "लिङ्गसंयोगहीनं यच्छब्दस्पर्शविवर्जितम्।\nश्रोत्रेण श्रवणं चैव चक्षुषा चैव दर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2080490, "chapter_id": 2711, "verse_number": "१२-२१६-९", "content_sanskrit": "वाक्संभाषाप्रवृत्तं यत्तन्मनः परिवर्जितम्।\nबुद्ध्या चाध्यवसीयीत ब्रह्मचर्यमकल्मषम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2080491, "chapter_id": 2711, "verse_number": "१२-२१६-१०", "content_sanskrit": "सम्यग्वृत्तिर्ब्रह्मलोकं प्राप्नुयान्मध्यमः सुरान्।\nद्विजाग्र्यो जायते विद्वान्कन्यसीं वृत्तिमास्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2080492, "chapter_id": 2711, "verse_number": "१२-२१६-११", "content_sanskrit": "सुदुष्करं ब्रह्मचर्यमुपायं तत्र मे शृणु।\nसंप्रदीप्तमुदीर्णं च निगृह्णीयाद्द्विजो मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2080493, "chapter_id": 2711, "verse_number": "१२-२१६-१२", "content_sanskrit": "योषितां न कथा श्राव्या न निरीक्ष्या निरम्बराः।\nकथंचिद्दर्शनादासां दुर्बलानां विशेद्रजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2080494, "chapter_id": 2711, "verse_number": "१२-२१६-१३", "content_sanskrit": "रागोत्पन्नश्चेरत्कृच्छ्रमह्नस्त्रिः प्रविशेदपः।\nमग्नस्त्वप्स्वेव मनसा त्रिर्जपेदघमर्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2080495, "chapter_id": 2711, "verse_number": "१२-२१६-१४", "content_sanskrit": "पाप्मानं निर्दहेदेवमन्तर्भूतरजोमयम्।\nज्ञानयुक्तेन मनसा संततेन विचक्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2080496, "chapter_id": 2711, "verse_number": "१२-२१६-१५", "content_sanskrit": "कुणपामेध्यसंयुक्तं यद्वदच्छिद्रबन्धनम्।\nतद्वद्देहगतं विद्यादात्मानं देहबन्धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2080497, "chapter_id": 2711, "verse_number": "१२-२१६-१६", "content_sanskrit": "`अमेध्यपूर्णं यद्भाण्डं श्लेष्मान्तकलिलावृतम्।\nनेच्छते वीक्षितुं भाण्डं कुतः स्प्रष्टुं प्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2080498, "chapter_id": 2711, "verse_number": "१२-२१६-१७", "content_sanskrit": "देहभाण्डं मलैः पूर्णं बहिः स्वेदजलावृतम्।\nबीभत्सं नरनारीणां ज्ञानिनां नरकं मतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2080499, "chapter_id": 2711, "verse_number": "१२-२१६-१८", "content_sanskrit": "छिद्रकुम्भो यथा स्रावं सृजते तद्गतं दृढम्।\nअन्तस्यं स्रंसते तद्वज्जलं देहेषु देहिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2080500, "chapter_id": 2711, "verse_number": "१२-२१६-१९", "content_sanskrit": "श्लेष्माश्रुमूत्रकलिलं पुरीषं शुक्लमेव च।\nकफजालविनिर्यासः सरसश्चित्त मुञ्चय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2080501, "chapter_id": 2711, "verse_number": "१२-२१६-२०", "content_sanskrit": "वातपित्तकफान्रक्तं त्वङ्भांसं स्नायुमस्थि च।\nमज्जां देहं सिराजालैस्तर्पयन्ति रसा नृणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2080502, "chapter_id": 2711, "verse_number": "१२-२१६-२१", "content_sanskrit": "दश विद्याद्धमन्योऽत्र पञ्चेन्द्रियगुणावहाः।\nयाभिः सूक्ष्माः प्रजायन्ते धमन्योऽन्याः सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2080503, "chapter_id": 2711, "verse_number": "१२-२१६-२२", "content_sanskrit": "एवमेताः सिरा नद्यो रसोदा देहसागरम्।\nतर्पयन्ति यथाकालमापगा इव सागरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2080504, "chapter_id": 2711, "verse_number": "१२-२१६-२३", "content_sanskrit": "मध्ये च हृदयस्यैका सिरा तत्र मनोवहा।\nशुक्रं संकल्पजं नॄणां सर्वगात्रैर्विमुञ्चति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2080505, "chapter_id": 2711, "verse_number": "१२-२१६-२४", "content_sanskrit": "सर्वगात्रप्रतायिन्यस्तस्या ह्यनुगताः सिराः।\nनेत्रयोः प्रतिपद्यन्ते वहन्त्यस्तैजसं गुणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2080506, "chapter_id": 2711, "verse_number": "१२-२१६-२५", "content_sanskrit": "पयस्यन्तर्हितं सर्पिर्यद्वन्निर्मथ्यते खजैः।\nशुक्रं निर्मथ्यते तद्वद्देहसंकल्पजैः खजैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2080507, "chapter_id": 2711, "verse_number": "१२-२१६-२६", "content_sanskrit": "स्वप्नेऽप्येवं यथाऽभ्येति मनः संकल्पजं रजः।\nशुक्रमस्पर्शजं देहात्सृजन्त्यस्य मनोवहाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2080508, "chapter_id": 2711, "verse_number": "१२-२१६-२७", "content_sanskrit": "महर्षिर्भगवानत्रिर्वेद तच्छ्रुक्रसंभवम्।\nनृबीजमिन्द्रदैवत्यं तस्मादिन्द्रियमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2080509, "chapter_id": 2711, "verse_number": "१२-२१६-२८", "content_sanskrit": "ये वै शुक्रगतिं विद्युर्भूतसंकरकारिकाम्।\nविरागा दग्धदोषास्ते नाप्नुयुर्देहसंभवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2080510, "chapter_id": 2711, "verse_number": "१२-२१६-२९", "content_sanskrit": "गुणानां साम्यमागम्य मनसैव मनोवहम्।\nदेहकर्म नुदन्प्राणानन्तकाले विमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2080511, "chapter_id": 2711, "verse_number": "१२-२१६-३०", "content_sanskrit": "भविता मनसो ज्ञानं मन एव प्रजायते।\nज्योतिष्मद्विरजो नित्यं मन्त्रसिद्धं महात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2080512, "chapter_id": 2711, "verse_number": "१२-२१६-३१", "content_sanskrit": "तस्मात्तदभिघाताय कर्म कुर्यादकल्मषम्।\nदेहबीजं समुत्पन्नमस्मित्कर्मणि विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2080513, "chapter_id": 2711, "verse_number": "१२-२१६-३२", "content_sanskrit": "न स्मरेन्न प्रयुञ्जीत ज्ञानी तत्कर्म बुद्धिमान्।\nरजस्तमश्च हित्वेह न तिर्यग्गतिमाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2080514, "chapter_id": 2711, "verse_number": "१२-२१६-३३", "content_sanskrit": "तरुणाधिगतं ज्ञानं जरादुर्बलतां गतम्।\nविपक्वबुद्धिः कालेन आदत्ते मानसं बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2080515, "chapter_id": 2711, "verse_number": "१२-२१६-३४", "content_sanskrit": "`एव पुत्रकलत्रेषु ज्ञातिसंबन्धिबन्धुषु।\nआदत्ते हृदये कामं व्याध्यादिभिरभिप्लुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2080516, "chapter_id": 2711, "verse_number": "१२-२१६-३५", "content_sanskrit": "यतस्ततः परिपतन्नविन्दन्सुखमण्वपि।\nबहुदुःखसमापन्नः पश्चान्निर्वेदमास्थितः।\nज्ञानवृक्षं समाश्रित्य पश्चान्निर्वृतिमश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2080517, "chapter_id": 2711, "verse_number": "१२-२१६-३६", "content_sanskrit": "सुदुर्गमिव पन्थानमतीत्य गुणबन्धनम्।\nयथा पश्येत्तथा दोषानतीत्यामृतमश्नुते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2080518, "chapter_id": 2711, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि षोडशाधिकद्विशततमोऽध्यायः॥ २१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]