[{"id": 2008475, "chapter_id": 1164, "verse_number": "१-१६५-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2008476, "chapter_id": 1164, "verse_number": "१-१६५-१", "content_sanskrit": "तां विदित्वा चिरगतां हिडिम्बो राक्षसेश्वरः।\nअवतीर्य द्रुमात्तस्मादाजगामाशु पाण्डवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2008477, "chapter_id": 1164, "verse_number": "१-१६५-२", "content_sanskrit": "लोहिताक्षो महाबाहुरूर्ध्वकेशो महाननः।\nमेघसङ्घातवर्ष्मा च तीक्ष्णदंष्ट्रो भयानकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2008478, "chapter_id": 1164, "verse_number": "१-१६५-३", "content_sanskrit": "तलं तलेन संहत्य बाहू विक्षिप्य चासकृत्।\nउद्वृत्तनेत्रः संक्रुद्धो दन्तान्दन्तेषु निष्कुषन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2008479, "chapter_id": 1164, "verse_number": "१-१६५-४", "content_sanskrit": "कोऽद्य मे भोक्तुकामस्य विघ्नं चरति दुर्मतिः।\nन बिभेति हिडिम्बी च प्रेषिता किमनागता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2008480, "chapter_id": 1164, "verse_number": "१-१६५-५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2008481, "chapter_id": 1164, "verse_number": "१-१६५-५", "content_sanskrit": "तमापतन्तं दृष्ट्वै तथा विकृतदर्शनम्।\nहिडिम्बोवाच वित्रस्ता भीमसेनमिदं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2008482, "chapter_id": 1164, "verse_number": "१-१६५-६", "content_sanskrit": "आपतत्येष दुष्टात्मा संक्रुद्धः पुरुषादकः।\nसाऽहं त्वां भ्रातृभिः सार्धं यद्ब्रवीमि तथा कुरु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2008483, "chapter_id": 1164, "verse_number": "१-१६५-७", "content_sanskrit": "अहं कामगमा वीर रक्षोबलसमन्विता।\nआरुहेमां मम श्रोणिं नेष्यामि त्वां विहायसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2008484, "chapter_id": 1164, "verse_number": "१-१६५-८", "content_sanskrit": "प्रबोधयैतान्संसुप्तान्मातरं च परन्तप।\nसर्वानेव गमिष्याभि गृहीत्वा वो विहायसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2008485, "chapter_id": 1164, "verse_number": "१-१६५-९x", "content_sanskrit": "भीम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2008486, "chapter_id": 1164, "verse_number": "१-१६५-९", "content_sanskrit": "मा भैस्त्वं पृथुसुश्रोणि नैष कश्चिन्मयि स्थिते।\nअहमेनं हनिष्यामि पश्यन्त्यास्ते सुमध्यमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2008487, "chapter_id": 1164, "verse_number": "१-१६५-१०", "content_sanskrit": "नायं प्रतिबलो भीरु राक्षसापसदो मम।\nसोढुं युधि परिस्पन्दमथवा सर्वराक्षसाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2008488, "chapter_id": 1164, "verse_number": "१-१६५-११", "content_sanskrit": "पश्य बाहू सुवृत्तौ मे हस्तिहस्तनिभाविमौ।\nऊरू परिघसङ्काशौ संहतं चाप्युरो महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2008489, "chapter_id": 1164, "verse_number": "१-१६५-१२", "content_sanskrit": "विक्रमं मे यथेन्द्रस्य साऽद्य द्रक्ष्यसि शोभने।\nमाऽवमंस्थाः पृथुश्रोणि मत्वा मामिह मानुषम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2008490, "chapter_id": 1164, "verse_number": "१-१६५-१३x", "content_sanskrit": "हिडिम्बोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2008491, "chapter_id": 1164, "verse_number": "१-१६५-१३", "content_sanskrit": "नावमन्ये नरव्याघ्र त्वामहं देवरूपिणम्।\nदृष्टप्रभावस्तु मया मानुषेष्वेव राक्षसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2008492, "chapter_id": 1164, "verse_number": "१-१६५-१४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2008493, "chapter_id": 1164, "verse_number": "१-१६५-१४", "content_sanskrit": "तथा संजल्पतस्तस्य भीमसेनस्य भारत।\nवाचः शुश्राव ताः क्रुद्धो राक्षसः पुरुषादकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2008494, "chapter_id": 1164, "verse_number": "१-१६५-१५", "content_sanskrit": "अवेक्षमाणस्तस्याश्च हिडिम्बो मानुषं वपुः।\nस्रग्दामपूरितशिखां समग्रेन्दुनिभाननाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2008495, "chapter_id": 1164, "verse_number": "१-१६५-१६", "content_sanskrit": "सुभ्रूनासाक्षिकेशान्तां सुकुमारनखत्वचम्।\nसर्वाभरणसंयुक्तां सुसूक्ष्माम्बरधारिणीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2008496, "chapter_id": 1164, "verse_number": "१-१६५-१७", "content_sanskrit": "तां तथा मानुषं रूपं बिभ्रतीं सुमनोहरम्।\nपुंस्कामां शङ्कमानश्च चुक्रोध पुरुषादकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2008497, "chapter_id": 1164, "verse_number": "१-१६५-१८", "content_sanskrit": "संक्रुद्धो राक्षसस्तस्या भगिन्याः कुरुसत्तम।\nउत्फाल्य विपुले नेत्रे ततस्तामिदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2008498, "chapter_id": 1164, "verse_number": "१-१६५-१९", "content_sanskrit": "को हि मे भोक्तुकामस्य विघ्नं चरति दुर्मतिः।\nन बिभेषि हिडिम्बे किं मत्कोपाद्विप्रमोहिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2008499, "chapter_id": 1164, "verse_number": "१-१६५-२०", "content_sanskrit": "धिक्त्वामसति पुंस्कामे मम विप्रियकारिणि।\nपूर्वेषां राक्षसेन्द्राणां सर्वेषामयशस्करि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2008500, "chapter_id": 1164, "verse_number": "१-१६५-२१", "content_sanskrit": "यानिमानाश्रिताऽकार्षीर्विप्रियं समुहन्मम।\nएष तानद्य वै सर्वान्हनिष्यामि त्वया सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2008501, "chapter_id": 1164, "verse_number": "१-१६५-२२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2008502, "chapter_id": 1164, "verse_number": "१-१६५-२२", "content_sanskrit": "एवमुक्त्वा हिडिम्बां स हिडिम्बो लोहितेक्षणः।\nवधायाभिपपातैनान्दन्तैर्दन्तानुपस्पृशन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2008503, "chapter_id": 1164, "verse_number": "१-१६५-२३", "content_sanskrit": "गर्जन्तमेवं विजने भीमसेनोऽभिवीक्ष्य तम्।\nरक्षन्प्रबोधं भ्रातॄणां मातुश्च परवीरहा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2008504, "chapter_id": 1164, "verse_number": "१-१६५-२४", "content_sanskrit": "तमापतान्तं संप्रेक्ष्य भीमः प्रहरतां वरः।\nभर्त्सयामास तेजस्वी तिष्ठतिष्ठेति चाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2008505, "chapter_id": 1164, "verse_number": "१-१६५-२५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2008506, "chapter_id": 1164, "verse_number": "१-१६५-२५", "content_sanskrit": "भीमसेनस्तु तं दृष्ट्वा राक्षसं प्रहसन्निव।\nभगिनीं प्रति सङ्क्रुद्धमिदं वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2008507, "chapter_id": 1164, "verse_number": "१-१६५-२६", "content_sanskrit": "किं ते हिडिम्ब एतैर्वा सुखसुप्तैः प्रबोधितैः।\nमामासादय दुर्बुद्धे तरसा त्वं नराशन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2008508, "chapter_id": 1164, "verse_number": "१-१६५-२७", "content_sanskrit": "मय्येव प्रहरैहि त्वं न स्त्रियं हन्तुमर्हसि।\nविशेषतोऽनपकृते परेणापकृते सति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2008509, "chapter_id": 1164, "verse_number": "१-१६५-२८", "content_sanskrit": "न हीयं स्ववशा बाला कामयत्यद्य मामिह।\nचोदितैषा ह्यनङ्गेन शरीरान्तरचारिणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2008510, "chapter_id": 1164, "verse_number": "१-१६५-२९", "content_sanskrit": "भगिनी तव दुर्वृत्त रक्षसां वै यशोहर।\nत्वन्नियोगेन चैवेयं रूपं मम समीक्ष्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2008511, "chapter_id": 1164, "verse_number": "१-१६५-३०", "content_sanskrit": "कामयत्यद्य मां भीरुस्तव नैषापराध्यति।\nअनङ्गेन कृते दोषे नेमां गर्हितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2008512, "chapter_id": 1164, "verse_number": "१-१६५-३१", "content_sanskrit": "मयि तिष्ठति दुष्टात्मन्न स्त्रियं हन्तुमर्हसि।\nसंगच्छस्व मया सार्धमेकेनैको नराशन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2008513, "chapter_id": 1164, "verse_number": "१-१६५-३२", "content_sanskrit": "अहमेको गमिष्यामि त्वामद्य यमसादनम्।\nअद्य मद्बलनिष्पिष्टं शिरो राक्षस दीर्यताम्।\nकुञ्जरस्येव पादेन विनिष्पिष्टं बलीयसाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2008514, "chapter_id": 1164, "verse_number": "१-१६५-३३", "content_sanskrit": "अद्य गात्राणि ते कङ्काः श्येना गोमायवस्तथा।\nकर्षन्तु भुवि संहृष्टा निहतस्य मया मृधे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2008515, "chapter_id": 1164, "verse_number": "१-१६५-३४", "content_sanskrit": "क्षणेनाद्य करिष्येऽहमिदं वनमराक्षसम्।\nपुरा यद्दूषितं नित्यं त्वया भक्षयता नरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2008516, "chapter_id": 1164, "verse_number": "१-१६५-३५", "content_sanskrit": "अद्य त्वां भगिनी रक्षः कृष्यमाणं मयाऽसकृत्।\nद्रक्ष्यत्यद्रिप्रतीकाशं सिंहेनेव महाद्विपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2008517, "chapter_id": 1164, "verse_number": "१-१६५-३६", "content_sanskrit": "निराबाधास्त्वयि हते मया राक्षसपांसन।\nवनमेतच्चरिष्यन्ति पुरुषा वनचारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2008518, "chapter_id": 1164, "verse_number": "१-१६५-३७x", "content_sanskrit": "हिडिम्ब उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2008519, "chapter_id": 1164, "verse_number": "१-१६५-३७", "content_sanskrit": "गर्जितेन वृथा किं ते कत्थितेन च मानुष।\nकृत्वैतत्कर्मणा सर्वं कत्थेया मा चिरं कृथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2008520, "chapter_id": 1164, "verse_number": "१-१६५-३८", "content_sanskrit": "बलिनं मन्यसे यच्चाप्यात्मानं सपराक्रमम्।\nज्ञास्यस्यद्य समागम्य मयात्मानं बलाधिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2008521, "chapter_id": 1164, "verse_number": "१-१६५-३९", "content_sanskrit": "न तावदेतान्हिंसिष्ये स्वपन्त्वेते यथासुखम्।\nएष त्वामेव दुर्बुद्धे निहन्म्यद्याप्रियंवदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2008522, "chapter_id": 1164, "verse_number": "१-१६५-४०", "content_sanskrit": "पीत्वा तवासृग्गात्रेभ्यस्ततः पश्चादिमानपि।\nहनिष्यामि ततः पश्चादिमां विप्रियकारिणीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2008523, "chapter_id": 1164, "verse_number": "१-१६५-४१x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2008524, "chapter_id": 1164, "verse_number": "१-१६५-४१", "content_sanskrit": "एवमुक्त्वा ततो बाहुं प्रगृह्य पुरुषादकः।\nअभ्यद्रवत संक्रुद्धो भीमसेनमरिन्दमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2008525, "chapter_id": 1164, "verse_number": "१-१६५-४२", "content_sanskrit": "तस्याभिद्रवतस्तूर्णं भीमो भीमपराक्रमः।\nवेगेन प्रहितं बाहुं निजग्राह हसन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2008526, "chapter_id": 1164, "verse_number": "१-१६५-४३", "content_sanskrit": "निगृह्य तं बलाद्भीमो विस्फुरन्तं चकर्ष ह।\nतस्माद्देशाद्धनूंष्यष्टौ सिंहः क्षुद्रमृगं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2008527, "chapter_id": 1164, "verse_number": "१-१६५-४४", "content_sanskrit": "ततः स राक्षसः क्रुद्धः पाण्डवेन बलार्दितः।\nभीमसेनं समालिङ्ग्य व्यनदद्भैरवं रवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2008528, "chapter_id": 1164, "verse_number": "१-१६५-४५", "content_sanskrit": "पुनर्भीमो बलादेनं विचकर्ष महाबलः।\nमा शब्दः सुखसुप्तानां भ्रातॄणां मे भवेदिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2008529, "chapter_id": 1164, "verse_number": "१-१६५-४६", "content_sanskrit": "हस्ते गृहीत्वा तद्रक्षो दूरमन्यत्र नीतवान्।\nपृच्छे गृहीत्वा तुण्डेन गरुडः पन्नगं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2008530, "chapter_id": 1164, "verse_number": "१-१६५-४७", "content_sanskrit": "अन्योन्यं तौ समासाद्य विचकर्षतुरोजसा।\nहिडिम्बो भीमसेनश्च विक्रमं चक्रतुः परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2008531, "chapter_id": 1164, "verse_number": "१-१६५-४८", "content_sanskrit": "बभञ्जतुस्तदा वृक्षाँल्लताश्चाकर्षतुस्तदा।\nमत्ताविव चं संरब्धौ वारणौ षष्टिहायनौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2008532, "chapter_id": 1164, "verse_number": "१-१६५-४९", "content_sanskrit": "पादपानुद्धरन्तौ तावूरुवेगेन वेगितौ।\nस्फोटयन्तौ लताजालान्यूरुभ्यां गृह्य सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2008533, "chapter_id": 1164, "verse_number": "१-१६५-५०", "content_sanskrit": "वित्रासयन्तौ तौ शब्दैः सर्वतो मृगपक्षिणः।\nबलेन बलिनौ मत्तावन्योन्यवधकाङ्क्षिणौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2008534, "chapter_id": 1164, "verse_number": "१-१६५-५१", "content_sanskrit": "भीमराक्षसयोर्युद्धं तदाऽवर्तत दारुणम्।\nपुरा देवासुरे युद्धे वृत्रवासवयोरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2008535, "chapter_id": 1164, "verse_number": "१-१६५-५२", "content_sanskrit": "भङूक्त्वा वृक्षान्महाशाखांस्ताडयामासतुः क्रुधा।\nसालतालतमालाम्रवटार्जुनविभीतकान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2008536, "chapter_id": 1164, "verse_number": "१-१६५-५३", "content_sanskrit": "न्यग्रोधप्लक्षखर्जूरपनसानश्मकण्टकान्।\nएतानन्यान्महावृक्षानुत्खाय तरसाऽखिलान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2008537, "chapter_id": 1164, "verse_number": "१-१६५-५४", "content_sanskrit": "उत्क्षिप्यान्योन्यरोषेण ताडयामासतू रणे।\nयदाऽभवद्वनं सर्वं निर्वृक्षं वृक्षसङ्कुलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2008538, "chapter_id": 1164, "verse_number": "१-१६५-५५", "content_sanskrit": "तदा शिलाश्च कुञ्जांश्च वृक्षान्कण्टकिनस्तथा।\nततस्तौ गिरिशृङ्गाणि पर्वतांश्चाभ्रलेलिहान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2008539, "chapter_id": 1164, "verse_number": "१-१६५-५६", "content_sanskrit": "शैलांश्च गण्डपाषाणानुत्खायादाय वैरिणौ।\nचिक्षेपतुरुपर्याजावन्योन्यं विजयेषिणौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2008540, "chapter_id": 1164, "verse_number": "१-१६५-५७", "content_sanskrit": "तद्वनं परितः पञ्चयोजनं निर्महीरुहम्।\nनिर्लतागुल्मपाषाणं निर्मृगं चक्रतुर्भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2008541, "chapter_id": 1164, "verse_number": "१-१६५-५८", "content_sanskrit": "तयोर्युद्धेन राजेन्द्र तद्वनं भीमरक्षसोः।\nमुहूर्तेनाभवत्कूमर्पृष्ठवच्छ्लक्ष्णमव्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2008542, "chapter_id": 1164, "verse_number": "१-१६५-५९", "content_sanskrit": "ऊरुबाहुपरिक्लेशात्कर्षन्तावितरेतरम्।\nउत्कर्षन्तौ विकर्षन्तौ प्रकर्षन्तौ परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2008543, "chapter_id": 1164, "verse_number": "१-१६५-६०", "content_sanskrit": "तौ स्वनेन विना राजन्गर्जन्तौ च परस्परम्।\nपाषाणसंघट्टनिभैः प्रहारैरभिजघ्नतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2008544, "chapter_id": 1164, "verse_number": "१-१६५-६१", "content_sanskrit": "अन्योन्यं च समालिङ्ग्य विकर्षन्तौ परस्परम्।\nबाहुयुद्धमभूद्धोरं बलिवासवयोरिव।\nयुद्धसंरम्भनिर्गच्छत्फूत्काररवनिस्वनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2008545, "chapter_id": 1164, "verse_number": "१-१६५-६२", "content_sanskrit": "तयोः शब्देन महता विबुद्धास्ते नरर्षभाः।\nसह मात्रा च ददृशुर्हिडिम्बामग्रतःस्थिताम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2008546, "chapter_id": 1164, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि हिडिम्बवधपर्वणि पञ्चषष्ट्यधिकशततमोऽध्यायः॥ १६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}]