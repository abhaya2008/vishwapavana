[{"id": 2013946, "chapter_id": 1288, "verse_number": "२-२९-१", "content_sanskrit": "वैशम्पायन इवाच॥\nस श्वेतपर्वतं वीरः समतिक्रम्य वीर्यवान्।\nदेशं किम्पुरुषावासं द्रुमपुत्रेण रक्षितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2013947, "chapter_id": 1288, "verse_number": "२-२९-२", "content_sanskrit": "महता सन्निपातेन क्षत्रियान्तकरेण ह।\nअजयत्पाण्डवश्रेष्ठः करे चैनं न्यवेशयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2013948, "chapter_id": 1288, "verse_number": "२-२९-३", "content_sanskrit": "तं जित्वा हाटकं नाम देशं गुह्यकरक्षितम्।\nपाकशासनिरव्यग्रः सहसैन्यः समासदत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2013949, "chapter_id": 1288, "verse_number": "२-२९-४", "content_sanskrit": "तांस्तु सान्त्वेन निर्जित्य मानसं सर उत्तमम्।\nऋषिकुल्यास्तथा सर्वा ददर्श कुरुनन्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2013950, "chapter_id": 1288, "verse_number": "२-२९-५", "content_sanskrit": "सरो मानसमासाद्य हाटकानभितः प्रभुः।\nगन्धर्वरक्षितं देशमजयत्पाण्डवस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2013951, "chapter_id": 1288, "verse_number": "२-२९-६", "content_sanskrit": "तत्र तित्तिरिकल्माषान्मण्डूकाख्यान्हयोत्तमान्।\nलेभे स करसमत्यन्तं गन्धर्वनगरात्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2013952, "chapter_id": 1288, "verse_number": "२-२९-७", "content_sanskrit": "हेमकूटमथासाद्य न्यवसत्फल्गुनस्तदा।\nतं हेमकूटं राजेन्द्र समतिक्रम्य पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2013953, "chapter_id": 1288, "verse_number": "२-२९-८", "content_sanskrit": "हरिवर्षं विवेशाथ सैन्येन महता वृतः।\nतत्र पार्थो ददर्शाथ बहूनिह मनोरमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2013954, "chapter_id": 1288, "verse_number": "२-२९-९", "content_sanskrit": "नगरान्सवनांश्चैव नदीश्च विमलोदकाः।\nपुरुषान्देवकल्पांश्च नारीश्च प्रियदर्शनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2013955, "chapter_id": 1288, "verse_number": "२-२९-१०", "content_sanskrit": "तान्सर्वास्तत्र दृष्ट्वाऽथ मुदा युक्तो धनञ्जयटः।\nवशे चक्रे स रत्नानि लेभे च सुबहूनि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2013956, "chapter_id": 1288, "verse_number": "२-२९-११", "content_sanskrit": "ततो निषधमासाद्य गिरिस्थानजयत्प्रभुः।\nअथ राजन्नतिक्रम्य निषधं शैलमायतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2013957, "chapter_id": 1288, "verse_number": "२-२९-१२", "content_sanskrit": "विवेश मध्यमं वर्षं पार्थो दिव्यमिलावृतम्।\nतत्र दिव्योपमान्दिव्यान्पुरुषान्देवदर्शनान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2013958, "chapter_id": 1288, "verse_number": "२-२९-१३", "content_sanskrit": "अदृष्टपूर्वान्सुभगान्स ददर्श धनञ्जयः।\nसदनानि च शुभ्राणि नारीश्चाप्सरसंनिभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2013959, "chapter_id": 1288, "verse_number": "२-२९-१४", "content_sanskrit": "दृष्ट्वा तानजयद्रम्यान्स तैश्च ददृशे तदा।\nजित्वा च तान्महाभागान्करे च विनिवेश्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2013960, "chapter_id": 1288, "verse_number": "२-२९-१५", "content_sanskrit": "रत्नान्यादाय दिव्यानि भूषणान्यासनैः सह।\nउदीचीमथ राजेन्द्र ययौ पार्थो मुदाऽन्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2013961, "chapter_id": 1288, "verse_number": "२-२९-१६", "content_sanskrit": "स ददर्श ततो मेरुं शिखरीणां प्रभुं महत्।\nतं काञ्चनमयं दिव्यं चतुर्वणं दुरासदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2013962, "chapter_id": 1288, "verse_number": "२-२९-१७", "content_sanskrit": "उन्नतं शतसाहस्रं योजनानां तु सुस्थितम्।\nज्वलन्तमचलं मेरुं तेजोराशिमनुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2013963, "chapter_id": 1288, "verse_number": "२-२९-१८", "content_sanskrit": "आक्षिपन्तं प्रभां भानोः स्वशृङ्गैः काञ्चनोज्ज्वलैः।\nकाञ्चनाभरणं दिव्यदेवगन्धर्वसेवितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2013964, "chapter_id": 1288, "verse_number": "२-२९-१९", "content_sanskrit": "अप्रमेयमनाधृष्यमधर्मबहुलैर्जनैः।\nव्यालैराचरितं धोरैर्दिव्यौषधिविदीपितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2013965, "chapter_id": 1288, "verse_number": "२-२९-२०", "content_sanskrit": "स्वर्गमावृत्य तिष्ठन्तमुच्छ्रायेण महागिरिम्।\nअगम्यं मनसाप्यन्यैर्नदीवृक्षसमन्वितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2013966, "chapter_id": 1288, "verse_number": "२-२९-२१", "content_sanskrit": "नानाविहगसङ्घैश्च नादितं सुमनोहरैः।\nतं दृष्टा फल्गुनो मेरुं प्रीतिमानभवत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2013967, "chapter_id": 1288, "verse_number": "२-२९-२२", "content_sanskrit": "मेरोरिलावृतं दिव्यं सर्वतः परिमण़्डितम्।\nमेरोस्तु दक्षिणे पार्श्वे जम्बूर्नाम वनस्पतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2013968, "chapter_id": 1288, "verse_number": "२-२९-२३", "content_sanskrit": "नित्यपुष्पफलोपेवः सिद्धचारणसेवितः।\nआस्वर्गमुच्छ्रिता राजंस्तस्य शाखा वनस्पतेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2013969, "chapter_id": 1288, "verse_number": "२-२९-२४", "content_sanskrit": "यस्य नाम्ना त्विदं द्वीपं जन्बूद्वीपमिति स्मृतम्।\nतां च जम्बूं ददर्शाथ सव्यसाची परन्तपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2013970, "chapter_id": 1288, "verse_number": "२-२९-२५", "content_sanskrit": "तौ दृष्ट्वाऽप्रतिमौ लोके जम्बूं मेरुं च संस्थितौ।\nप्रतीमानभवद्राजन्सर्वतः स विलोकयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2013971, "chapter_id": 1288, "verse_number": "२-२९-२६", "content_sanskrit": "तत्र लेभे ततो जिष्णुः सिद्धैर्दिव्यैश्च चारणैः।\nरत्नानि बहुसाहस्रं दत्तान्याभरणानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2013972, "chapter_id": 1288, "verse_number": "२-२९-२७", "content_sanskrit": "वासांसि च महार्हाणि तत्र लब्ध्वाऽर्जुनस्तदा।\nआमन्त्रयित्वा तान्सर्वान्यज्ञमुद्दिश्य वै गुरोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2013973, "chapter_id": 1288, "verse_number": "२-२९-२८", "content_sanskrit": "अथादाय बहून्रत्नान्गमनाययोपचक्रमे।\nमेरुं प्रदक्षिणीकृत्य प्रवतप्रवरं प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2013974, "chapter_id": 1288, "verse_number": "२-२९-२९", "content_sanskrit": "ययौ जम्बूनदीतीरे नदीं श्रेष्ठां विलोकयन्।\nस तां मनोरमां दिव्यां जम्बूस्वादुरसावहाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2013975, "chapter_id": 1288, "verse_number": "२-२९-३०", "content_sanskrit": "हैमपक्षिगणैर्जुष्टां सौवर्णजलजाकुलाम्।\nहैमपङ्कां हैमजलां सौवर्णोज्ज्वलवालुकाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2013976, "chapter_id": 1288, "verse_number": "२-२९-३१", "content_sanskrit": "क्वचित्मुपिष्पितैः पूर्णां सौवर्णकुसुमोत्पलैः।\nक्वचित्तीररुहैः कीर्णां हैमपुष्पैः सुपुष्पितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2013977, "chapter_id": 1288, "verse_number": "२-२९-३२", "content_sanskrit": "तीर्थैश्च रुक्मसोपानैः सर्वतः समलङ्कुताम्।\nविमलैर्मणिजालैश्च नृत्तगीतरवैर्युताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2013978, "chapter_id": 1288, "verse_number": "२-२९-३३", "content_sanskrit": "दीप्तैर्हेमवितानैश्च समन्ताच्छोभितां शुभाम्।\nतथाविधां नदीं दृष्ट्वा पार्थस्तां प्रशशंस ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2013979, "chapter_id": 1288, "verse_number": "२-२९-३४", "content_sanskrit": "अदृष्टपूर्वां राजेन्द्र दृष्ट्वा हर्षमवाप च।\nदर्शनीयां नदीतीरे पुरुषान्सुमनोहरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2013980, "chapter_id": 1288, "verse_number": "२-२९-३५", "content_sanskrit": "तान्नदीसलिलाहारान्सदारानमरोपमान्।\nनित्यं सुखमुदा युक्तान्सर्वालङ्कारशोभितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2013981, "chapter_id": 1288, "verse_number": "२-२९-३६", "content_sanskrit": "तेभ्यो बहूनि रत्नानि तदा लेभे धनञ्जयः।\nदिव्यजम्बूफलं हैमं भूषणानि च पेशलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2013982, "chapter_id": 1288, "verse_number": "२-२९-३७", "content_sanskrit": "लब्ध्वा तान्दुर्लभान्पार्थः प्रतीचीं प्रययौ दिशम्।\nनागानां रक्षितं देशमजयश्च पुनस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2013983, "chapter_id": 1288, "verse_number": "२-२९-३८", "content_sanskrit": "ततो गन्वा महाराज वारुणीं पाकशासनिः।\nगन्धमादनमासाद्य ततस्तानजयत्प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2013984, "chapter_id": 1288, "verse_number": "२-२९-३९", "content_sanskrit": "तं गन्धमादनं राजन्नतिक्रम्य ततोऽर्जुनः।\nकेतुमालं ददर्शाथ वर्षं रत्नसमन्वितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2013985, "chapter_id": 1288, "verse_number": "२-२९-४०", "content_sanskrit": "सेवितं देवकल्पैश्च नारीभिः प्रियदर्शनैः।\nतं जित्वा चार्जुनो राजन्करे च विनिवेश्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2013986, "chapter_id": 1288, "verse_number": "२-२९-४१", "content_sanskrit": "आहृत्य तत्र रत्नानि दुर्लभानि तथार्जुनः।\nपुनश्च परिवृत्याथ माध्यं देशमिलावृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2013987, "chapter_id": 1288, "verse_number": "२-२९-४२", "content_sanskrit": "गत्वा प्राचीं दिशं राजन्सव्यसाची धनञ्जयः।\nमेरुमन्दरयोर्मध्ये शैलोदामभितो नदीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2013988, "chapter_id": 1288, "verse_number": "२-२९-४३", "content_sanskrit": "ये ते कीचकवेणूनां छायां रम्यामुपासते।\nकषान्झषांश्च नद्यौ तान्प्रघसान्दीप्तवेणिपान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2013989, "chapter_id": 1288, "verse_number": "२-२९-४४", "content_sanskrit": "पशुपांश्च कुलिन्दांश्च तङ्कणान्परतङ्कणान्।\nएतान्समस्ताञ्जित्वा च करे च विनिवेश्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2013990, "chapter_id": 1288, "verse_number": "२-२९-४५", "content_sanskrit": "रत्नान्यादाय सर्वेभ्यो माल्यवन्तं ततो ययौ।\nतं माल्यवन्तं शैलेन्द्रं समतिक्रम्य पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2013991, "chapter_id": 1288, "verse_number": "२-२९-४६", "content_sanskrit": "भद्राश्वं प्रविवेशाथ वर्षं स्वर्गोपमं शुचिम्।\nतत्र देवोपमान्दिव्यान्पुरुषाञ्शुभसंयुतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2013992, "chapter_id": 1288, "verse_number": "२-२९-४७", "content_sanskrit": "जित्वा तान्स्ववशे कृत्वा करे च विनिवेश्य च।\nआहृत्य सर्वतो रत्नान्यसङ्ख्यानि ततस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2013993, "chapter_id": 1288, "verse_number": "२-२९-४८", "content_sanskrit": "नीलं नाम गिरिं गत्वा तत्रस्थानजयत्प्रभुः।\nततो जिष्णुरतिक्रम्य पर्वतं नीलमायतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2013994, "chapter_id": 1288, "verse_number": "२-२९-४९", "content_sanskrit": "विवेश रम्यकं वर्षं सङ्कीर्णं मिथुनैः शुभैः।\nतं देशमथ जित्वा स करे च विनिवेश्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2013995, "chapter_id": 1288, "verse_number": "२-२९-५०", "content_sanskrit": "अजयच्चापि बीभत्सुर्देशं गुह्यकरक्षितम्।\nतत्र लेभे च राजेन्द्र सौवर्णान्मृगपक्षिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2013996, "chapter_id": 1288, "verse_number": "२-२९-५१", "content_sanskrit": "अगृह्णाद्यज्ञभूत्यर्थं रमणीयान्मनोहरान्।\nअन्यांश्च लब्ध्वा रत्नानि पाण्डवोऽथ महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2013997, "chapter_id": 1288, "verse_number": "२-२९-५२", "content_sanskrit": "गन्धर्वरक्षितं देशमजयत्सगणं तदा।\nतत्र रत्नानि दिव्यानि लब्ध्वा राजन्नथार्जुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2013998, "chapter_id": 1288, "verse_number": "२-२९-५३", "content_sanskrit": "वर्षं हिरण्वतं नाम विवेशाथ महीपते।\nस तु देशेषु रम्येषु गन्तुं तत्रोपचक्रमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2013999, "chapter_id": 1288, "verse_number": "२-२९-५४", "content_sanskrit": "मध्ये प्रासादवृन्देषु नक्षत्राणां शशी यथा।\nमहापथेषु राजैन्द्र सर्वतो यान्तमर्जुनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2014000, "chapter_id": 1288, "verse_number": "२-२९-५५", "content_sanskrit": "प्रासादवरशृङ्गस्थाः परया वीर्यशोभया।\nददृशुस्तं स्रियः सर्वाः पार्थमात्मयशस्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2014001, "chapter_id": 1288, "verse_number": "२-२९-५६", "content_sanskrit": "तं कलापधरं शूरं सरथं सधनुः करम्।\nसवर्मं सकिरीटं वै संनद्धं सपरिच्छदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2014002, "chapter_id": 1288, "verse_number": "२-२९-५७", "content_sanskrit": "सुकुमारं महासत्वं तेजोराशिमनुत्तमम्।\nशक्रोपमममित्रघ्नं परवारणवारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2014003, "chapter_id": 1288, "verse_number": "२-२९-५८", "content_sanskrit": "पश्यन्तः स्त्रीगणास्तत्र शक्तिपाणिं स्म मेनिरे।\nअयं स पुरुषव्याघ्रो रणेऽद्भुतपराक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2014004, "chapter_id": 1288, "verse_number": "२-२९-५९", "content_sanskrit": "अस्य बाहुबलं प्राप्य न भवन्त्यसुहृद्गणाः।\nइति वाचो ब्रुवन्त्यस्ताः स्त्रियः प्रेम्णा धनञ्जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2014005, "chapter_id": 1288, "verse_number": "२-२९-६०", "content_sanskrit": "तुष्टुवुः पुष्पवृष्टिं च ससृजुस्तस्य मूर्धनि।\nदृष्ट्वा ते तु मुदा युक्ताः कौतूहलसमन्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2014006, "chapter_id": 1288, "verse_number": "२-२९-६१", "content_sanskrit": "रत्नैर्विभूषणैश्चैव अभ्यवर्षंश्च पाण्डवम्।\nअथ जित्वा समस्तांस्तान्करे च विनिवेश्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2014007, "chapter_id": 1288, "verse_number": "२-२९-६२", "content_sanskrit": "मणिहेमप्रबालानि शस्त्राण्याभरणानि च।\nएतानि लब्ध्वा पार्थोऽथ शृङ्गवन्तं गिरिं ययौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2014008, "chapter_id": 1288, "verse_number": "२-२९-६३", "content_sanskrit": "शृङ्गवन्तं च कौरव्यः समतिक्रम्य फल्गुनः।\nउत्तरं हरिवर्षं तु स समासाद्य पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2014009, "chapter_id": 1288, "verse_number": "२-२९-६४", "content_sanskrit": "विद्याधरगणांश्चैव यक्षेन्द्रांश्च विनिर्जयन्।\nतत्र लेभे महात्मा वै वासो दिव्यमनुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2014010, "chapter_id": 1288, "verse_number": "२-२९-६५", "content_sanskrit": "किन्नरद्रुमपत्रांश्च तत्र कृष्णाजिनान्बहून्।\nयाज्ञीयांस्तांस्तदा दिव्यांस्तत्र लेभे धनञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2014011, "chapter_id": 1288, "verse_number": "२-२९-६६", "content_sanskrit": "उत्तरं हरिवर्षं तु स समासाद्य पाण्डवः।\nइयेष जेतुं तं देशं पाकशासनन्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2014012, "chapter_id": 1288, "verse_number": "२-२९-६७", "content_sanskrit": "तत एनं महावीर्यं महाकाया महाबलाः।\nद्वारपालाः समासाद्य हृष्टा वचनमब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2014013, "chapter_id": 1288, "verse_number": "२-२९-६८", "content_sanskrit": "पार्थ नेदं त्वया शक्यं पुरं जेतुं कथञ्जन।\nउपावर्तस्व कल्याण पर्याप्तमिदमच्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2014014, "chapter_id": 1288, "verse_number": "२-२९-६९", "content_sanskrit": "इदं पुरं यः प्रविशेद्घ्रुवं न स भवेन्नरः।\nप्रीयामहे त्वया वीर पर्याप्तो विजयस्तवै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2014015, "chapter_id": 1288, "verse_number": "२-२९-७०", "content_sanskrit": "न चात्र किञ्चिज्जेतव्यमर्जुनात्र प्रदृश्यते।\nउत्तराः कुरुवो ह्येते नात्र युद्धं प्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2014016, "chapter_id": 1288, "verse_number": "२-२९-७१", "content_sanskrit": "प्रविष्टोऽपि हि कौन्तेय नेह द्रक्ष्यसि किञ्चन।\nन हि मानुषदेहेन शक्यमत्राभिवीक्षितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2014017, "chapter_id": 1288, "verse_number": "२-२९-७२", "content_sanskrit": "अथेह पुरुषव्याघ्र किञ्चिदन्यच्चिकीर्षसि।\nतत्प्रब्रूहि करिष्यामो वचनात्तव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2014018, "chapter_id": 1288, "verse_number": "२-२९-७३", "content_sanskrit": "ततस्तानब्रवीद्राजन्नर्जुनः प्रहसन्निव।\nपार्थिवत्वं चिकीर्षामि धर्मराजस्य धीमतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2014019, "chapter_id": 1288, "verse_number": "२-२९-७४", "content_sanskrit": "न प्रवेक्ष्यामि वो देशं विरुद्धं यदि मानुषैः।\nयुधिष्ठिराय यत्किञ्चित्करपण्यं प्रदीयताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2014020, "chapter_id": 1288, "verse_number": "२-२९-७५", "content_sanskrit": "नो चेत्कृष्णेन सहितो योधयिष्यामि सायकैः।\nततो दिव्यानि वस्त्राणि दिव्यान्याभरणानि च।\nक्षौमाजिनानि दिव्यानि तस्य ते प्रददुः करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2014021, "chapter_id": 1288, "verse_number": "२-२९-७६", "content_sanskrit": "एवं स पुरुषव्याघ्रो विजित्य दिशमुत्तराम्।\nसङ्ग्रामान्सुबहून्कृत्वा क्षत्रियैर्दस्युभिस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2014022, "chapter_id": 1288, "verse_number": "२-२९-७७", "content_sanskrit": "स विनिर्जित्य राज्ञस्तान्करे च विनिवेश्य तु।\nधनान्यादाय सर्वेभ्यो रत्नानि विविधानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2014023, "chapter_id": 1288, "verse_number": "२-२९-७८", "content_sanskrit": "हयांस्तित्तिरिकल्माषाञ्शुकपत्रनिभानपि।\nमयूरसदृशान्यान्सर्वाननिलरंहसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2014024, "chapter_id": 1288, "verse_number": "२-२९-७९", "content_sanskrit": "वृतः सुमहता राजन्बलेन चतुरङ्गिणा।\nआजगाम पुनर्वीरः शक्रप्रस्थं पुरोत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2014025, "chapter_id": 1288, "verse_number": "२-२९-८०", "content_sanskrit": "धर्मराजाय तत्पार्थो धनं सर्वं सवाहनम्।\nन्यवेदयदनुज्ञातस्तेन राज्ञा गृहान्ययौ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2014026, "chapter_id": 1288, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि दिग्विजयपर्वणि एकोनत्रिंशोऽध्यायः॥ २९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}]