[{"id": 7000588000, "chapter_id": 20588, "verse_number": "५-४७-१", "content_sanskrit": "शेष उवाच ।\nहयो गतो हेमकूटं भारतांते ततो द्विज ।\nअनेकभटसाहस्रै रक्षितो बद्धचामरः॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000588001, "chapter_id": 20588, "verse_number": "५-४७-२", "content_sanskrit": "यो वै विस्तरतो दैर्घ्याद्योजनानां समं ततः ।\nअयुतेन सुशृङ्गैश्च राजतैः कांचनादिभिः॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000588002, "chapter_id": 20588, "verse_number": "५-४७-३", "content_sanskrit": "तत्रोद्यानं महच्छ्रेष्ठं पादपैः परिशोभितम् ।\nशालैस्तालैस्तमालैश्च कर्णिकारैः समन्ततः॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000588003, "chapter_id": 20588, "verse_number": "५-४७-४", "content_sanskrit": "हिंतालैर्नागपुन्नागैः कोविदारैः सबिल्वकैः ।\nचम्पकैर्बकुलैर्मेघैर्मदनैः कुटजादिभिः॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000588004, "chapter_id": 20588, "verse_number": "५-४७-५", "content_sanskrit": "जातिकाभिर्यूथिकाभिर्नवमालिकया तथा ।\nआम्रैर्माधवद्राक्षाभिर्दाडिमैः शोभितं वनम्॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000588005, "chapter_id": 20588, "verse_number": "५-४७-६", "content_sanskrit": "अनेकपक्षिसंघुष्टं भ्रमरैर्निनदीकृतम् ।\nमयूरकेकारवितं सर्वर्तुसुखदं हयः॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000588006, "chapter_id": 20588, "verse_number": "५-४७-७", "content_sanskrit": "प्रविवेश स शत्रुघ्नो मनोवेगसमन्वितः ।\nस्वर्णपत्रं विशाले स्वे भाले बिभ्रन्मनोहरम्॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000588007, "chapter_id": 20588, "verse_number": "५-४७-८", "content_sanskrit": "गच्छतस्तस्य वाहस्य हयमेधक्रतोस्तदा ।\nअकस्मादभवच्चित्रं तच्छृणुष्व द्विजोत्तम॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000588008, "chapter_id": 20588, "verse_number": "५-४७-९", "content_sanskrit": "गात्रस्तंभोऽभवत्तस्य न चचाल पथिस्थितः ।\nहेमकूटैवाचाल्यो बभूव हयसत्तमः॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000588009, "chapter_id": 20588, "verse_number": "५-४७-१०", "content_sanskrit": "तदा तद्रक्षकाः सर्वे कशाघातान्वितेनिरे ।\nतदाहतेऽपि न ययौ स्तब्धगात्रो हयोत्तमः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000588010, "chapter_id": 20588, "verse_number": "५-४७-११", "content_sanskrit": "शत्रुघ्नं सविधे गत्वा चुक्रुशुर्वाहरक्षकाः ।\nस्वामिन्वयं न जानीमः किमभूद्धयसत्तमे॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000588011, "chapter_id": 20588, "verse_number": "५-४७-१२", "content_sanskrit": "गच्छतो वाहवर्यस्य मनोवेगस्य भूपते ।\nआकस्मिकोऽभवत्तस्य गात्रस्तंभो महामते॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000588012, "chapter_id": 20588, "verse_number": "५-४७-१३", "content_sanskrit": "कशाभिस्ताडितोऽस्माभिः परं तत्र चचाल न ।\nएवं विचार्य यत्कर्म तत्कुरुष्व नृपोत्तम॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000588013, "chapter_id": 20588, "verse_number": "५-४७-१४", "content_sanskrit": "तदा विस्मयमापन्नो भूपतिः सह सैनिकैः ।\nजगाम सहितः सर्वैर्हयस्य महतोऽन्तिके॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000588014, "chapter_id": 20588, "verse_number": "५-४७-१५", "content_sanskrit": "पुष्कलो बाहुना धृत्वा चरणौ तस्य भूतलात् ।\nउत्पाटयामास तदा परं नो चेलतुस्ततः॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000588015, "chapter_id": 20588, "verse_number": "५-४७-१६", "content_sanskrit": "बलेन बलिनाक्रांतो नाकम्पत हयस्तदा ।\nहनूमांस्तं समुद्धर्तुं मतिं चक्रे महामनाः॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000588016, "chapter_id": 20588, "verse_number": "५-४७-१७", "content_sanskrit": "लांगूलेन समावेष्ट्य बलेन बलिनां वरः ।\nआचकर्ष बलाद्वाहं न चचाल तथापि सः॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000588017, "chapter_id": 20588, "verse_number": "५-४७-१८", "content_sanskrit": "तदोवाच कपिश्रेष्ठो हनूमान्विस्मयान्वितः ।\nशत्रुघ्नं बलिनां श्रेष्ठं वीराणां परिशृण्वताम्॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000588018, "chapter_id": 20588, "verse_number": "५-४७-१९", "content_sanskrit": "मया द्रोणो लांगुलेन लीलयोत्पाटितोऽधुना ।\nपरमत्र महाश्चर्यं कम्पते न हयोऽल्पकः॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000588019, "chapter_id": 20588, "verse_number": "५-४७-२०", "content_sanskrit": "दृष्टमत्र निदानं हि वीरैर्बलिभिरुद्धतैः ।\nआकृष्टोऽपि न च स्थानाच्चचाल तिलमात्रतः॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000588020, "chapter_id": 20588, "verse_number": "५-४७-२१", "content_sanskrit": "कपिभाषितमाकर्ण्य शत्रुघ्नो विस्मयान्वितः ।\nसुमतिं मंत्रिणां श्रेष्ठमुवाच वदतां वरः॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000588021, "chapter_id": 20588, "verse_number": "५-४७-२२", "content_sanskrit": "शत्रुघ्न उवाच ।\nमंत्रिन्किमभवद्वाहे स्तंभनं वपुषोऽनघ ।\nकोऽत्रोपायो विधेयः स्याद्येन वाहगतिर्भवेत्॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000588022, "chapter_id": 20588, "verse_number": "५-४७-२३", "content_sanskrit": "सुमतिरुवाच ।\nस्वामिन्कश्चिन्मुनिर्मृग्योऽखिलज्ञानविचक्षणः ।\nदेशोद्भवमहं जाने प्रत्यक्षं न परोक्षजम्॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000588023, "chapter_id": 20588, "verse_number": "५-४७-२४", "content_sanskrit": "शेष उवाच ।\nइति वाक्यं समाकर्ण्य सुमतेर्धर्मकोविदः ।\nअन्वेषयामास मुनिं सेवकैः सह शोभनम्॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000588024, "chapter_id": 20588, "verse_number": "५-४७-२५", "content_sanskrit": "ते सर्वे सर्वतो गत्वा मुनिं धर्मविदं भटाः ।\nव्यालोकयंतः सर्वत्र न चापश्यन्मुनीश्वरम्॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000588025, "chapter_id": 20588, "verse_number": "५-४७-२६", "content_sanskrit": "एकस्त्वनुचरो विप्र गतो योजनमात्रतः ।\nपूर्वस्यां दिशि चोद्युक्तः पश्यति स्म महाश्रमम्॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000588026, "chapter_id": 20588, "verse_number": "५-४७-२७", "content_sanskrit": "यत्र निर्वैरिणः सर्वे पशवो जनतास्तथा ।\nगंगास्नानहताशेषकिल्बिषाः सुमनोहराः॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000588027, "chapter_id": 20588, "verse_number": "५-४७-२८", "content_sanskrit": "यत्र केचित्तपः श्रेष्ठं कुर्वंति स्म हुताशनैः ।\nधूमैरधोमुखाः पत्रैर्वायुभिः स्वोदरंभराः॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000588028, "chapter_id": 20588, "verse_number": "५-४७-२९", "content_sanskrit": "यत्राग्निहोत्रजो धूमः पवित्रयति सर्वदा ।\nअनेकमुनिसंहृष्टो मुक्तपत्रलतोत्तमः॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000588029, "chapter_id": 20588, "verse_number": "५-४७-३०", "content_sanskrit": "तमाश्रमं मुनेर्ज्ञात्वा शौनकस्य मनोहरम् ।\nन्यवेदयन्नृपायासौ विस्मयाविष्टचेतसे॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000588030, "chapter_id": 20588, "verse_number": "५-४७-३१", "content_sanskrit": "तच्छ्रुत्वा हर्षितोऽत्यंतं शत्रुघ्नः सह सेवकैः ।\nहनूमत्पुष्कलाद्यैश्च सयुतोऽगात्तदाश्रमम्॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000588031, "chapter_id": 20588, "verse_number": "५-४७-३२", "content_sanskrit": "तत्र वीक्ष्य मुनिश्रेष्ठं सम्यग्घुतहुताशनम् ।\nप्रणम्य दंडवत्तस्य चरणौ पापहारिणौ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000588032, "chapter_id": 20588, "verse_number": "५-४७-३३", "content_sanskrit": "तमागतं नृपं ज्ञात्वा शत्रुघ्नं बलिनां वरम् ।\nअर्घ्यपाद्यादिकं चक्रे प्रीतस्तद्दर्शनादभूत्॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000588033, "chapter_id": 20588, "verse_number": "५-४७-३४", "content_sanskrit": "सुखोपविष्टं विश्रान्तं नृपं प्राह मुनीश्वरः ।\nकिमर्थमटनं देव महत्पर्यटनं तव॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000588034, "chapter_id": 20588, "verse_number": "५-४७-३५", "content_sanskrit": "त्वादृशाः पृथिवीं सर्वां नृपा वै न भ्रमंति चेत् ।\nतदा दुष्टजनाः साधून्बाधंते विगतज्वरान्॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000588035, "chapter_id": 20588, "verse_number": "५-४७-३६", "content_sanskrit": "कथयस्व महीपाल शत्रुघ्न बलिनां वर ।\nसर्वं शुभायनो भूयात्तव पर्यटनादिकम्॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000588036, "chapter_id": 20588, "verse_number": "५-४७-३७", "content_sanskrit": "शेष उवाच ।\nइत्युक्तवंतं भूदेवं प्रत्युवाच महीश्वरः ।\nगद्गद स्वरया वाण्या हर्षित स्वीयविग्रहः॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000588037, "chapter_id": 20588, "verse_number": "५-४७-३८", "content_sanskrit": "शत्रुघ्न उवाच ।\nअकस्मादभवच्चित्रं रामाश्वस्य मनोहृतः ।\nनातिदूरे त्वदावासात्तच्छृणुष्व विदांवर॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000588038, "chapter_id": 20588, "verse_number": "५-४७-३९", "content_sanskrit": "उद्याने तव शोभाढ्ये यदृच्छातो हयो गतः ।\nतत्प्रांते तस्य वाहस्य गात्रस्तंभोऽभवत्क्षणात्॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000588039, "chapter_id": 20588, "verse_number": "५-४७-४०", "content_sanskrit": "तदा मे बलिनो वीराः पुष्कलाद्या मदोत्कटाः ।\nबलादाचकृषुर्वाहं न चचाल तथाप्यसौ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000588040, "chapter_id": 20588, "verse_number": "५-४७-४१", "content_sanskrit": "अस्मानपारदुःखाब्धौ मग्नान्प्रतितरिः स्मृतः ।\nदैवाद्दृष्टः सुभाग्यैस्त्वं कथयस्व निदानकम्॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000588041, "chapter_id": 20588, "verse_number": "५-४७-४२", "content_sanskrit": "शेष उवाच ।\nएवं पृष्टो मुनिवरः क्षणं दध्यौ महामतिः ।\nततः कारणसंयुक्तं विचारेण दधद्धयम्॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000588042, "chapter_id": 20588, "verse_number": "५-४७-४३", "content_sanskrit": "क्षणात्तज्ज्ञानतां प्राप्य विस्मयोत्फुल्ललोचनः ।\nजगाद स महीपालं दुःखितं संशयान्वितम्॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000588043, "chapter_id": 20588, "verse_number": "५-४७-४४", "content_sanskrit": "शौनक उवाच ।\nशृणु राजन्प्रवक्ष्यामि हयस्तंभस्य कारणम् ।\nयच्छ्रुत्वा मुच्यते दुःखादतिचित्रकथानकम्॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000588044, "chapter_id": 20588, "verse_number": "५-४७-४५", "content_sanskrit": "गौडदेशे महारण्ये कावेरीतीरभूषिते ।\nवाडवः सात्वको नाम्ना चचार परमं तपः॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000588045, "chapter_id": 20588, "verse_number": "५-४७-४६", "content_sanskrit": "एकाहं पयसः प्राशी दिनैकं वायुभक्षकः ।\nदिनैकं तु निराहार एवं त्रिदिनमुन्नयेत्॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000588046, "chapter_id": 20588, "verse_number": "५-४७-४७", "content_sanskrit": "एवं व्रते प्रवृत्तस्य कालः सर्वक्षयंकरः ।\nजग्राह स्वस्य दंष्ट्रायां मृतिं प्राप महाव्रती॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000588047, "chapter_id": 20588, "verse_number": "५-४७-४८", "content_sanskrit": "विमाने सर्वशोभाढ्ये सर्वरत्नविभूषिते ।\nअप्सरोभिः सह क्रीडन्ययौ मेरोः शिखास्थितौ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000588048, "chapter_id": 20588, "verse_number": "५-४७-४९", "content_sanskrit": "जंबूनाममहावृक्षस्तत्र सेव्यरसोऽभवत् ।\nनदी जांबवती संज्ञा स्वर्णद्रवसमन्विता॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000588049, "chapter_id": 20588, "verse_number": "५-४७-५०", "content_sanskrit": "तस्यां मुनयैच्छाभिः क्रीडंते कुतुकान्विताः ।\nअनेकतपसा पुण्याः सर्वसौख्यसमन्विताः॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000588050, "chapter_id": 20588, "verse_number": "५-४७-५१", "content_sanskrit": "तत्रासौ स्वेच्छया क्रीडन्नप्सरोभिर्मुदान्वितः ।\nप्रतीपमाचरत्तेषां स्वाभिमानमदोद्धतः॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000588051, "chapter_id": 20588, "verse_number": "५-४७-५२", "content_sanskrit": "ततः शप्तः स मुनिभी राक्षसो भव दुर्मुखः ।\nततोऽतिदुःखितः प्राह मुनीन्विद्यातपोधनान्॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000588052, "chapter_id": 20588, "verse_number": "५-४७-५३", "content_sanskrit": "अनुगृह्णंतु मां सर्वे विप्रा यूयं कृपालवः ।\nतदा तैरनुगृहीतो यदा रामहयं भवान्॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000588053, "chapter_id": 20588, "verse_number": "५-४७-५४", "content_sanskrit": "स्तंभयिष्यति वेगेन ततो रामकथाश्रुतिः ।\nपश्चान्मुक्तिर्भवित्री ते शापादस्मात्सुदारुणात्॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000588054, "chapter_id": 20588, "verse_number": "५-४७-५५", "content_sanskrit": "स प्रोक्तो मुनिभिर्देवो राक्षसत्वमितः प्रभो ।\nस्तंभयामास रामाश्वं मोचयानघकीर्तनैः॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}]