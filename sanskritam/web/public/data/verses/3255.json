[{"id": 2104542, "chapter_id": 3255, "verse_number": "१४-१११-१", "content_sanskrit": "युधिष्ठिर उवाच।\nस्वभक्तस्य हृषीकेश धर्माधर्ममजानतः।\nधर्मं पुण्यतमं देव पृच्छतः कथयस्व मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2104543, "chapter_id": 3255, "verse_number": "१४-१११-२x", "content_sanskrit": "भगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2104544, "chapter_id": 3255, "verse_number": "१४-१११-२", "content_sanskrit": "यदेतदग्निहोत्रं वै सृष्टं वर्णत्रयस्य तु।\nमन्त्रवद्यद्धुतं सम्यग्विधिना चाप्युपासितम्।\nआहिताग्निं नयत्यूर्ध्वं सपत्नीकं सबान्धवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2104545, "chapter_id": 3255, "verse_number": "१४-१११-३x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2104546, "chapter_id": 3255, "verse_number": "१४-१११-३", "content_sanskrit": "कथं तद्ब्राह्मणैर्देव होतव्यं क्षत्रियैः कथम्।\nवैश्यैर्वा देवदेवेश कथं वा सुहुतं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2104547, "chapter_id": 3255, "verse_number": "१४-१११-४", "content_sanskrit": "कस्मिन्काले कतं कस्य आधेयोऽग्निः सुरोत्तम।\nआहितस्य कथं वाऽपि सम्यगाचरणं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2104548, "chapter_id": 3255, "verse_number": "१४-१११-५", "content_sanskrit": "कत्यग्नयः किमात्मानः स्थानं किं कस्य वा विभो।\nकतरस्मिन्हुते स्थाने कं व्रजेदाग्निहोत्रिकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2104549, "chapter_id": 3255, "verse_number": "१४-१११-६", "content_sanskrit": "अग्निहोत्रनिमित्तं च किमुत्पन्नं पुराऽनघ।\nकथमेवाथ हूयन्ते प्रीयन्ते च सुराः कथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2104550, "chapter_id": 3255, "verse_number": "१४-१११-७", "content_sanskrit": "विधिवन्मन्त्रवत्कृत्वा पूजितास्त्वग्नयः कथम्।\nकां गतिं वदतांश्रेष्ठ नयन्ति ह्यग्निहोत्रिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2104551, "chapter_id": 3255, "verse_number": "१४-१११-८", "content_sanskrit": "दुर्हुताश्चापि भगवन्नविज्ञातास्त्रयोऽग्नयः।\nकिमाहिताग्नेः कुर्वन्ति दुश्चीर्णा वाऽपि केशव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2104552, "chapter_id": 3255, "verse_number": "१४-१११-९", "content_sanskrit": "उत्सन्नाग्निस्तु पापात्मा कां योनिं देव गच्छति।\nएतत्सर्वं समासेन भक्त्या ह्युपगतस्य मे।\nवक्तुमर्हसि सर्वज्ञ सर्वाधिकं नमोस्तु ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2104553, "chapter_id": 3255, "verse_number": "१४-१११-१०x", "content_sanskrit": "भगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2104554, "chapter_id": 3255, "verse_number": "१४-१११-१०", "content_sanskrit": "शृणु राजन्महापुण्यमिदं धर्मामृतं परम्।\nयत्तु तारयते युक्तान्ब्राह्मणानग्निहोत्रिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2104555, "chapter_id": 3255, "verse_number": "१४-१११-११", "content_sanskrit": "ब्र्हमित्वेनासृजं लोकानहमादौ महाद्युते।\nसृष्टोऽग्निर्मुखतः पूर्वं लोकानां हितकाम्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2104556, "chapter_id": 3255, "verse_number": "१४-१११-१२", "content_sanskrit": "यस्मादग्रे स भूतानां सर्वेषां निर्मितो मया।\nतस्मादग्नीत्यभिहितः पुराणज्ञैर्मनीषिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2104557, "chapter_id": 3255, "verse_number": "१४-१११-१३", "content_sanskrit": "यस्मात्तु सर्वकृत्येषु पूर्वमस्मै प्रदीयते।\nआहुतिर्दीप्यमानाय तस्मादग्नीति कथ्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2104558, "chapter_id": 3255, "verse_number": "१४-१११-१४", "content_sanskrit": "यस्माच्च तु नयत्यग्रां गतिं विप्रान्सुपूजितः।\nयस्माच्च नयनाद्राजन्देवेष्वग्नीति कथ्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2104559, "chapter_id": 3255, "verse_number": "१४-१११-१५", "content_sanskrit": "तस्माच्च दुर्हुतः सोयमलं भक्षयितुं क्षणात्।\nयजमानं नरश्रेष्ठ क्रव्यादोऽग्निस्ततः स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2104560, "chapter_id": 3255, "verse_number": "१४-१११-१६", "content_sanskrit": "सर्वभूतात्मको राजन्देवानामेष वै मुखम्।\nप्रथमं मन्मुखात्सृष्टो लोकार्थे पचनः प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2104561, "chapter_id": 3255, "verse_number": "१४-१११-१७", "content_sanskrit": "सृष्टमात्रो जगत्सर्वमत्तुमैच्छत्पुरा खलु।\nततः प्रशमितः सोग्निरूपास्यैव मया पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2104562, "chapter_id": 3255, "verse_number": "१४-१११-१८", "content_sanskrit": "सततोपासनात्सोयमौपासन इति स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2104563, "chapter_id": 3255, "verse_number": "१४-१११-१९", "content_sanskrit": "आहुतिः सर्वमाख्याति तस्मिन्वसति सोनलः।\nआवसथ्य इति ख्यातस्तेनासौ ब्रह्मवादिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2104564, "chapter_id": 3255, "verse_number": "१४-१११-२०", "content_sanskrit": "तस्मात्पञ्च महायज्ञा वर्तन्ते यस्य धर्मतः।\nसोममण्डलमध्येन गतिस्तस्य द्विजन्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2104565, "chapter_id": 3255, "verse_number": "१४-१११-२१", "content_sanskrit": "ते च सप्तर्षयः सिद्धाः संयतेन्द्रियबुद्धयः।\nगता ह्यमरसायुज्यं ते ह्यग्न्यर्चनतत्पराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2104566, "chapter_id": 3255, "verse_number": "१४-१११-२२", "content_sanskrit": "अपरे चावसथ्यं च पचनाग्निं प्रचक्षते।\nतस्मिन्पञ्च महायज्ञा वैश्वदेवश्च वर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2104567, "chapter_id": 3255, "verse_number": "१४-१११-२३", "content_sanskrit": "स्थलीपाकं च गार्हं च सर्वे चास्मिन्प्रतिष्ठिताः।\nगृह्यकर्मवहो यस्मात्तस्माद्गृहपतिस्तु सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2104568, "chapter_id": 3255, "verse_number": "१४-१११-२४", "content_sanskrit": "औपासनं चावसथ्यं सभ्यं पचनपावकम्।\nआहुर्ब्रह्मविदः केचिन्मतमेतन्ममापि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2104569, "chapter_id": 3255, "verse_number": "१४-१११-२५", "content_sanskrit": "अग्निहोत्रप्रकारं च शृणु राजन्समाहितः।\nत्रयाणां गुणनामानां वह्नीनामुच्यते मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2104570, "chapter_id": 3255, "verse_number": "१४-१११-२६", "content_sanskrit": "गृहाणां हि पतित्वं हि गृहपत्यमिति स्मृतम्।\nगृहपत्यं तु यस्यासीत्तत्तस्माद्गार्हपत्यता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2104571, "chapter_id": 3255, "verse_number": "१४-१११-२७", "content_sanskrit": "यजमानं तु यस्मात्तु दक्षिणां तु गतिं नयेत्।\nदक्षिणाग्निं तमाहुस्ते दक्षिणायतनं द्विजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2104572, "chapter_id": 3255, "verse_number": "१४-१११-२८", "content_sanskrit": "आहुतिः सर्वमाख्याति हव्यं वै वहनं स्मृतम्।\nसर्वहव्यवहो वह्निर्गतश्चाहवनीयताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2104573, "chapter_id": 3255, "verse_number": "१४-१११-२९", "content_sanskrit": "यं चाक्सथ्यं जुहुयान्मूलाग्निं विधिवद्द्विजः।\nआवसथ्यं तु तं चाग्निं पचनाग्निं प्रचक्षते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2104574, "chapter_id": 3255, "verse_number": "१४-१११-३०", "content_sanskrit": "तेषां स भागतो वह्निः सभ्य इत्यभिधीयते।\nआवतथ्यस्तु यो वह्निः प्रथमः स प्रजापतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2104575, "chapter_id": 3255, "verse_number": "१४-१११-३१", "content_sanskrit": "ब्रह्मा च गार्हपत्योऽग्निस्तस्मिन्नेव हि सोभवत्।\nदक्षिणाग्निस्त्वयं रुद्रः क्रोधात्मा चण्ड एव सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2104576, "chapter_id": 3255, "verse_number": "१४-१११-३२", "content_sanskrit": "अहमाहवनीयोऽग्निराहोमाद्यस्य वै मुखे।\nसभ्योऽग्निः पञ्चमो यस्तु स्कन्द एव नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2104577, "chapter_id": 3255, "verse_number": "१४-१११-३३", "content_sanskrit": "पृथिवी गार्हपत्योऽग्निरन्तरिक्षं च दक्षिणः।\nस्वर्गमाहवनीयोऽग्निरेवमग्नित्रयं स्मृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2104578, "chapter_id": 3255, "verse_number": "१४-१११-३४", "content_sanskrit": "वृत्तश्च गार्हपत्योऽग्निर्यस्माद्वृत्ता च मेदिनी।\nअर्धचन्द्राकृतिस्तं वै दक्षिणाग्निस्तथा भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2104579, "chapter_id": 3255, "verse_number": "१४-१११-३५", "content_sanskrit": "चतुरश्रं ततः स्वर्गं निर्मलं तु निरामयम्।\nतस्मादाहवनीयोऽग्निश्चतुरश्रो भवेन्नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2104580, "chapter_id": 3255, "verse_number": "१४-१११-३६", "content_sanskrit": "जुहुयाद्गार्हपत्यं यो भुवं जयति स द्विजः।\nजुहोति दक्षिणं यस्तु स जयत्यन्तरिक्षकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2104581, "chapter_id": 3255, "verse_number": "१४-१११-३७", "content_sanskrit": "पृथिवीमन्तरिक्षं च दिवं ऋषिगणैः सह।\nजयत्याहवनीयं यो जुहुयाद्भक्तिमान्नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2104582, "chapter_id": 3255, "verse_number": "१४-१११-३८", "content_sanskrit": "आभिमुख्येन होमस्तु यस्य यज्ञेषु वर्तते।\nतेनाप्याहवनीयत्वं गतो वह्निर्महाद्युतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2104583, "chapter_id": 3255, "verse_number": "१४-१११-३९", "content_sanskrit": "आहोमादग्निहोत्रेषु यज्ञैर्वा यत्र सर्वशः।\nयस्मात्तस्मात्प्रवर्तन्ते ततो ह्याहवनीयता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2104584, "chapter_id": 3255, "verse_number": "१४-१११-४०", "content_sanskrit": "यस्त्वावसथ्यं जुहुयान्मूलाग्निं विधिवद्द्विजः।\nस तु सप्तर्षिलोकेषु सपत्नीकः प्रमोदते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2104585, "chapter_id": 3255, "verse_number": "१४-१११-४१", "content_sanskrit": "इष्टो भवति सर्वाग्नेरग्निहोत्रं च तद्भवेत्।\nत्राणाद्वै यजमानस्य ह्यग्निहोत्रमिति स्मृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2104586, "chapter_id": 3255, "verse_number": "१४-१११-४२", "content_sanskrit": "होइज्येषु विषादो वै विषादो दुःखमुच्यते।\nदुःखं तापत्रयं प्रोक्तं तापं हि नरकं विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2104587, "chapter_id": 3255, "verse_number": "१४-१११-४३", "content_sanskrit": "आध्यात्मिकं चाधिदैवमाधिभौतिकमेव च।\nएतत्तापत्रयं प्रोक्तमात्मविद्भिर्नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2104588, "chapter_id": 3255, "verse_number": "१४-१११-४४", "content_sanskrit": "यस्माद्वै त्रायते दुःखाद्यजमानं हुतोऽनलः।\nतस्मात्तु विधिवत्प्रोक्तमग्निहोत्रमिति श्रुतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2104589, "chapter_id": 3255, "verse_number": "१४-१११-४५", "content_sanskrit": "तदग्निहोत्रं सृष्टं वै ब्रह्मणा लोककर्तृणा।\nवेदाश्चाप्यग्निहोत्रं तु जज्ञिरे स्वयमेव तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2104590, "chapter_id": 3255, "verse_number": "१४-१११-४६", "content_sanskrit": "अग्निहोत्रफला दारा दत्तभुक्तफलं धनम्॥\nरतिपुत्रफला दारा दत्तभुक्तफलं धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2104591, "chapter_id": 3255, "verse_number": "१४-१११-४७", "content_sanskrit": "त्रिवेदमन्त्रसंयोगादग्निहोत्रं प्रवर्तते।\nऋग्यजुःसामभिः पुण्यैः स्थाप्यते सूत्रसंयुतैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2104592, "chapter_id": 3255, "verse_number": "१४-१११-४८", "content_sanskrit": "वसन्ते ब्राह्मणस्य स्यादाधेयोऽग्निर्नराधिप।\nवसन्तो ब्राह्मणो ज्ञेयो वेदयोनिः स उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2104593, "chapter_id": 3255, "verse_number": "१४-१११-४९", "content_sanskrit": "अग्न्याधेयं तु येनाथ वसन्ते क्रियतेऽनघ।\nतस्य श्रीर्बह्मवृद्धिश्च ब्राह्मणस्य विवर्धते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2104594, "chapter_id": 3255, "verse_number": "१४-१११-५०", "content_sanskrit": "क्षत्रियस्याग्निराधेयो ग्रीष्मे श्रेष्ठः स वै नृप।\nयेनाधानं तु वै ग्रीष्मे क्रियते तस्य वर्धते।\nश्रीः प्रजाःक पशवश्चैव वित्तं तेजो बलं यशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2104595, "chapter_id": 3255, "verse_number": "१४-१११-५१", "content_sanskrit": "शरदृतौ तु वैश्यस्य ह्याधानीयो हुताशनः।\nशरद्रात्रं स्वयं वैश्यो वैश्ययोनिः स उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2104596, "chapter_id": 3255, "verse_number": "१४-१११-५२", "content_sanskrit": "शरद्याधानमेवं वै क्रियते येन पाण्डव।\nतस्यापि श्रीः प्रजाऽऽयुश्च पशवोऽर्थश्च वर्धते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2104597, "chapter_id": 3255, "verse_number": "१४-१११-५३", "content_sanskrit": "पशवः सर्व एवैते त्रिभिः सर्वैरलङ्कृताः।\nअग्निहोत्रा ह्यवर्तन्ते तैरेव ध्रियते जगत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2104598, "chapter_id": 3255, "verse_number": "१४-१११-५४", "content_sanskrit": "ग्राम्यारण्याश्च पशवो पृक्षाश्चैव तृणानि च।\nफलान्योषधयश्चापि अग्निहोत्रकृते हविः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2104599, "chapter_id": 3255, "verse_number": "१४-१११-५५", "content_sanskrit": "रसाः स्नेहास्तथा गन्धा रत्नानि मणयस्तथा।\nकाञ्चनानि च लोहानि ह्यग्निहोत्रकृतेऽभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2104600, "chapter_id": 3255, "verse_number": "१४-१११-५६", "content_sanskrit": "आयुर्वेदो धनुर्वेदो मीमांसा न्यायविस्तरः।\nधर्मशास्त्रं च तत्सर्वमग्निहोत्रकृते कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2104601, "chapter_id": 3255, "verse_number": "१४-१११-५७", "content_sanskrit": "छन्दः शिक्षा च कल्पश्च तथा व्याकरणानि च।\nशास्त्रं ज्योतिर्निरुक्तं चाप्यग्निहोत्रकृते कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2104602, "chapter_id": 3255, "verse_number": "१४-१११-५८", "content_sanskrit": "इतिहासपुराणं च गाथाश्चोपनिषत्तथा।\nआथर्वणानि कर्माणि चाग्निहोत्रकृते कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2104603, "chapter_id": 3255, "verse_number": "१४-१११-५९", "content_sanskrit": "यच्चैतस्यां पृथिव्यां वै किंचिदस्ति चराचरम्।\nतत्सर्वमग्निहोत्रस्य कृते सृष्टं स्वयंभुवा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2104604, "chapter_id": 3255, "verse_number": "१४-१११-६०", "content_sanskrit": "अग्निहोत्रस्य दर्शस्य पूर्णमासस्य चाप्यथ।\nयुपेष्टिपशुबन्धानां सोमपानक्रियावताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2104605, "chapter_id": 3255, "verse_number": "१४-१११-६१", "content_sanskrit": "तिथिनक्षत्रयोगानां मुहूर्तकरणात्मकम्।\nकालस्य वेदनार्थं तु ज्योतिर्ज्ञानं पुराऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2104606, "chapter_id": 3255, "verse_number": "१४-१११-६२", "content_sanskrit": "ऋग्यजुः साममन्त्राणां श्लोकतत्वार्थचिन्तनात्।\nप्रत्यापत्तिविकल्पानां छन्दोज्ञानं प्रल्पितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2104607, "chapter_id": 3255, "verse_number": "१४-१११-६३", "content_sanskrit": "वर्णाक्षरपदार्थानां सन्धिलिङ्गं प्रकीर्तितम्।\nनामधातुविवेकार्थं पुरा व्याकरणं स्मृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2104608, "chapter_id": 3255, "verse_number": "१४-१११-६४", "content_sanskrit": "यूपवेद्यध्वरार्थं तु प्रोक्षणश्रवणाय तु।\nयज्ञदैवतयोगार्थं शिक्षाज्ञानं प्रकल्पितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2104609, "chapter_id": 3255, "verse_number": "१४-१११-६५", "content_sanskrit": "यज्ञपात्रपवित्रार्थं द्रव्यसंभारणाय च।\nसर्वयज्ञविकल्पाय पुराकल्पं प्रकल्पितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2104610, "chapter_id": 3255, "verse_number": "१४-१११-६६", "content_sanskrit": "नामधातुविकल्पानां तत्वार्थनियमाय च।\nसर्ववेदनिरुक्तानां निरुक्तमृषिभिः कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2104611, "chapter_id": 3255, "verse_number": "१४-१११-६७", "content_sanskrit": "वेद्यर्थं पृथिवी सृष्टा संभारार्थ तथैव च।\nइध्मार्थमथ यूपार्थं ब्रह्मा चक्रे वनस्पतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2104612, "chapter_id": 3255, "verse_number": "१४-१११-६८", "content_sanskrit": "ग्राम्यारण्याश्च पशवो जायन्ते यज्ञकारणात्।\nमन्त्राणां विनियोगं च प्रोक्षितं श्रपणं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2104613, "chapter_id": 3255, "verse_number": "१४-१११-६९", "content_sanskrit": "अनुयाजप्रयाजाश्च मरुतां शंसिनस्तथा।\nऔद्गात्रं चैव साम्नां वै प्रतिप्रस्थानमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2104614, "chapter_id": 3255, "verse_number": "१४-१११-७०", "content_sanskrit": "विष्णुक्रमाणां क्रमणं दक्षिणावभृथं तथा।\nत्रिकासमर्चनं चैव स्यानेषूपहृतं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2104615, "chapter_id": 3255, "verse_number": "१४-१११-७१", "content_sanskrit": "देवताग्रहणं मोक्षं हविषां श्रपणं तथा।\nनावबुद्ध्यन्ति ये विप्रा निन्दन्ति च पशोर्वधम्।\nते यान्ति नरकं घोरं रौरवं तमसाऽऽवृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2104616, "chapter_id": 3255, "verse_number": "१४-१११-७२", "content_sanskrit": "शतवर्षसहस्राणि तत्र स्थित्वा नराधमाः।\nकृमिर्भिर्भक्ष्यमाणाश्च तिष्ठेयुः पूयशोणिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2104617, "chapter_id": 3255, "verse_number": "१४-१११-७३", "content_sanskrit": "वृक्षा यूपत्वमिच्छन्ति पशुत्वं पशवस्तथा।\nतृणानीच्छन्ति बर्हिष्ट्वमोषध्यश्च हविष्यताम्।\nसोमत्वं च लताः सर्वा वेदित्वं च वसुंधर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2104618, "chapter_id": 3255, "verse_number": "१४-१११-७४", "content_sanskrit": "यस्मात्पशुत्वमिच्छन्ति पशवः स्वर्गलिप्सया।\nतस्मात्पशुवधे हिंसा नास्ति यज्ञेषु पाण्डव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2104619, "chapter_id": 3255, "verse_number": "१४-१११-७५", "content_sanskrit": "यूपास्तन्मन्त्रसंस्कारैर्दर्भाश्च पशवस्तथा।\nयजमानेन सहिताः स्वर्गं यान्ति नरेश्वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2104620, "chapter_id": 3255, "verse_number": "१४-१११-७६", "content_sanskrit": "यावत्कालं हि यज्वा वै स्वर्गलोके महीयते।\nतावत्कालं प्रमोदन्ते पशवो ह्यध्वरे हताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2104621, "chapter_id": 3255, "verse_number": "१४-१११-७७", "content_sanskrit": "अहिंसा वैदिकं कर्म ब्रह्मकर्मेति तत्कृतम्।\nवेदोक्तं ये न कुर्वन्ति हिंसाबुद्ध्या क्रतून्द्विजाः।\nसद्यः शूद्रत्वामायान्ति प्रेत्य चण्डालतामपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2104622, "chapter_id": 3255, "verse_number": "१४-१११-७८", "content_sanskrit": "गावो यज्ञार्थमुत्पन्ना दक्षिणार्थं तथैव च।\nसुवर्णं रजतं चैव पात्रक्रुभार्थमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2104623, "chapter_id": 3255, "verse_number": "१४-१११-७९", "content_sanskrit": "दर्भाः संस्तरणार्तं तु रक्षसां रक्षणाय च।\nपजनार्थं द्विजाः सृष्टास्तारका दिवि देवताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2104624, "chapter_id": 3255, "verse_number": "१४-१११-८०", "content_sanskrit": "क्षत्रिया रक्षणार्थं तु वैश्या वार्तानिमित्ततः।\nशुश्रूषार्थं त्रयाणां वै शूद्राः सृष्टाः स्वयंभुवा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2104625, "chapter_id": 3255, "verse_number": "१४-१११-८१", "content_sanskrit": "एवमेतज्जगत्सर्वमग्निहोत्रकृते कृतम्।\nनावबुध्यन्ति ये चैव नरास्तु तमसा वृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2104626, "chapter_id": 3255, "verse_number": "१४-१११-८२", "content_sanskrit": "ते यान्ति नरकं घोरं रौरवं नाम विश्रुतम्।\nरौरवाद्विप्रयुक्तास्तु कृमियोनिं व्रजन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2104627, "chapter_id": 3255, "verse_number": "१४-१११-८३", "content_sanskrit": "यथोक्तमग्निहोत्राणां शुश्रूषन्ति च ये द्विजाः।\nतैर्दत्तं सहुतं चेष्टं दत्तमध्यापितं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2104628, "chapter_id": 3255, "verse_number": "१४-१११-८४", "content_sanskrit": "एवमिष्टं च पूर्तं च यद्विप्रैः क्रियते नृप।\nतत्सर्वं सम्यगाहृत्य चादित्ये स्थापयाम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2104629, "chapter_id": 3255, "verse_number": "१४-१११-८५", "content_sanskrit": "मया स्थापितमादित्ये लोकस्य सुकृतं हि तत्।\nधारयेद्यत्सहस्रांशुः सुकृतं ह्यग्निहोत्रिणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2104630, "chapter_id": 3255, "verse_number": "१४-१११-८६", "content_sanskrit": "यावत्कालं तु तिष्ठन्ति लोके चाप्यग्निहोत्रिणः।\nतावदेव हि पुण्येन दीप्यते रविणाऽम्बरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2104631, "chapter_id": 3255, "verse_number": "१४-१११-८७", "content_sanskrit": "स्वर्गे स्वर्गं गतानां तु वीर्याद्भवति वीर्यवान्।\nतत्र ते ह्युपभुञ्जन्ति ह्यग्निहोत्रस्य तत्फलम्।\nसमानरूपा देवानां तिष्ठन्त्याबूतसंप्लवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2104632, "chapter_id": 3255, "verse_number": "१४-१११-८८", "content_sanskrit": "वृथाऽग्निना च ये केचिद्दह्यन्ते ह्यग्निहोत्रिणः।\nन तेऽग्निहोत्रिणां लोके मानसाऽपि व्रजन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2104633, "chapter_id": 3255, "verse_number": "१४-१११-८९", "content_sanskrit": "वीरघ्रास्तु दुराचारा दरिद्रास्तु नराधमाः।\nविकला व्याधिताश्चापि जायन्ते शूद्रयोनिषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2104634, "chapter_id": 3255, "verse_number": "१४-१११-९०", "content_sanskrit": "तस्मादप्रोषितैर्नित्यमग्निहोत्रं द्विजातिभिः।\nहोतव्यं विधिवद्राजन्नूर्ध्वामिच्छन्ति ये गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2104635, "chapter_id": 3255, "verse_number": "१४-१११-९१", "content_sanskrit": "आत्मवन्नावमन्तव्यमग्निहोत्रं युधिष्ठिर।\nन त्याज्यं क्षणिमप्येतदग्निहोत्रं युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2104636, "chapter_id": 3255, "verse_number": "१४-१११-९२", "content_sanskrit": "वृद्धत्वेऽप्यग्निहोत्रं ये गृह्णन्ति विधिवद्द्विजाः।\nशूद्रान्नाद्विरता दान्ताः संयतेन्द्रियबुद्धयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2104637, "chapter_id": 3255, "verse_number": "१४-१११-९३", "content_sanskrit": "पञ्चयज्ञपरा नित्यं लोभक्रोधविवर्जिताः।\nद्विकालमतिथींश्चैव पूजयन्ति च भक्तितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2104638, "chapter_id": 3255, "verse_number": "१४-१११-९४", "content_sanskrit": "तेऽपि सूर्योदयप्रख्यैर्विमानैर्वायुवेगिभिः।\nमम लोके प्रमोदन्ते दृष्ट्वा मां च युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2104639, "chapter_id": 3255, "verse_number": "१४-१११-९५", "content_sanskrit": "मन्वन्तरं च तत्रैकं मोदिता द्विजसत्तमाः।\nइह मानुष्यके लोके जायन्ते द्विजसत्तमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2104640, "chapter_id": 3255, "verse_number": "१४-१११-९६", "content_sanskrit": "बालाहिताग्रयो ये च शूद्रान्नाद्विरताः सदा।\nक्रोधलोभविनिर्मुक्ताः प्रातस्स्नानपरायणाः।\nयथोक्तमग्निहोत्रं वै जुह्वते विजितेन्द्रियाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2104641, "chapter_id": 3255, "verse_number": "१४-१११-९७", "content_sanskrit": "आतिथेयाः सदा सौम्या द्विकालं मत्परायणाः।\nते यान्त्यपुनरावृत्तिं भित्त्वा चादित्यमण्डलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2104642, "chapter_id": 3255, "verse_number": "१४-१११-९८", "content_sanskrit": "मम लोकं सपत्नीका यानैः सूर्योदयप्रभैः।\nतत्र बालार्कसङ्काशाः कामगाः कामरूपिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2104643, "chapter_id": 3255, "verse_number": "१४-१११-९९", "content_sanskrit": "ऐश्वर्यगुणसंपन्नाः क्रीडन्ति च यथासुखम्।\nइत्येषामाहिताग्नीनां विभूतिः पाण्डुनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2104644, "chapter_id": 3255, "verse_number": "१४-१११-१००", "content_sanskrit": "श्रुतिं केचिन्निन्दमानाः श्रुतिं दूष्यन्त्यबुद्धयः।\nप्रमाणं न च कुर्वन्ति ये यान्तीहापि दुर्गतिम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2104645, "chapter_id": 3255, "verse_number": "१४-१११-१०१", "content_sanskrit": "प्रमाणमितिहासं च वेदान्कुर्वति ये द्विजाः।\nते यान्त्यमरसायुज्यं नित्यमास्तिक्यबुद्धयः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2104646, "chapter_id": 3255, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि वैष्णवधर्मपर्वणि एकादशाधिकशततमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}]