[{"id": 7001738000, "chapter_id": 21738, "verse_number": "१-१२४-१", "content_sanskrit": "सनातन उवाच ।\nअथ नारद वक्ष्यामि श्रृणु पूर्णाव्रतानि ते ।\nयानि कृत्वा नरो नारी प्राप्नुयात्सुखसंततिम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001738001, "chapter_id": 21738, "verse_number": "१-१२४-२", "content_sanskrit": "चैत्रपूर्णा तु विप्रेंद्र मन्वादिः समुदाहृता ।\nअस्यां सान्नोदकं कुंभं प्रदद्यात्सोमतुष्टये ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001738002, "chapter_id": 21738, "verse_number": "१-१२४-३", "content_sanskrit": "वैशाख्यामपि पूर्णायां दानं सर्वस्य सर्वदम् ।\nयद्यद्द्रव्यं ददेद्विप्रे तत्तदाप्नोति निश्चितम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001738003, "chapter_id": 21738, "verse_number": "१-१२४-४", "content_sanskrit": "धर्मराजव्रतं चात्र कथितं तन्निशामय ।\nश्रृतान्नमुदकुंभं च वैशाख्यां वै द्विजोत्तमे ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001738004, "chapter_id": 21738, "verse_number": "१-१२४-५", "content_sanskrit": "दद्याद्गोदानफलदं धर्मराजस्य तुष्टये ।\nअत्र कृष्णाजिनं दद्यात्सखुरं च सश्रृङ्गकम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001738005, "chapter_id": 21738, "verse_number": "१-१२४-६", "content_sanskrit": "तिलैः सहसमाच्छाद्य वस्त्रैर्हेम्ना द्विजातये ।\nयस्तु कृष्णाजिनं दद्यात्सत्कृत्य विधिपूर्वकम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001738006, "chapter_id": 21738, "verse_number": "१-१२४-७", "content_sanskrit": "सर्वशास्त्रविदे सप्तद्वीपभूमिप्रदः स वै ।\nमोदते विष्णु लोके हि यावच्चन्द्रार्कतारकम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001738007, "chapter_id": 21738, "verse_number": "१-१२४-८", "content_sanskrit": "कुंभान्स्वच्छजलैः पूर्णान्हिरण्येन समन्वितान् ।\nयः प्रदद्याद्द्विजाग्र्येभ्यः स न शोचति कर्हिचित् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001738008, "chapter_id": 21738, "verse_number": "१-१२४-९", "content_sanskrit": "अथ ज्येष्ठस्य पूर्णायां वटसावित्रिकं व्रतम् ।\nसोपवासा वटं सिंचेत्सलिलैरमृतोपमैः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001738009, "chapter_id": 21738, "verse_number": "१-१२४-१०", "content_sanskrit": "सूत्रेण वेष्टयेच्चैव सशताष्टप्रदक्षिणम् ।\nततः संप्रार्थयेद्दैवीं सावित्रीं सुपतिव्रताम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001738010, "chapter_id": 21738, "verse_number": "१-१२४-११", "content_sanskrit": "जगत्पूज्ये जगन्मातः सावित्रि पतिदैवते ।\nपत्या सहावियोगं मे वटस्थे कुरु ते नमः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001738011, "chapter_id": 21738, "verse_number": "१-१२४-१२", "content_sanskrit": "इति सप्रार्थ्य या नारी भोजयित्वा परेऽहनि ।\nसुवासिनीः स्वयं भुंज्यात्सा स्यात्सौभाग्यभागिनी ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001738012, "chapter_id": 21738, "verse_number": "१-१२४-१३", "content_sanskrit": "आषाढस्य तु पूर्णायां गोपद्मव्रतमुच्यते ।\nचतुर्भुजं महाकायं जांबूनदसमप्रभम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001738013, "chapter_id": 21738, "verse_number": "१-१२४-१४", "content_sanskrit": "शंखचक्रगदापद्मरमागरुडशोभितम् ।\nसेवितं मुनिभिर्देवैर्यक्षगंधर्वकिन्नरैः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001738014, "chapter_id": 21738, "verse_number": "१-१२४-१५", "content_sanskrit": "एवंविधं हरिं तत्र स्नात्वा पूजां समाचरेत् ।\nपौरुषेणैव सूक्तेन गंधाद्यैरुपचारकैः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001738015, "chapter_id": 21738, "verse_number": "१-१२४-१६", "content_sanskrit": "आचार्यं वस्त्रभूषाद्यैस्तोषयेत्स्निग्धमानसः ।\nभोजयेन्मिष्टपक्वान्नैर्द्विजानन्यांश्च शक्तितः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001738016, "chapter_id": 21738, "verse_number": "१-१२४-१७", "content_sanskrit": "एवं कृत्वा व्रतं विप्र प्रसादात्कमलापतेः ।\nऐहिकामुष्मिकान्कामांल्लभते नात्र संशयः ॥१७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]