[{"id": 7002045000, "chapter_id": 22045, "verse_number": "९०-१", "content_sanskrit": "ईश्वर उवाच ।\nशिवमभ्यर्च्याभिषेकं कुर्य्याच्छिष्यादिके क्षिये ।\nसुम्भानीशादिकाष्ठासु क्रमशो नव विन्यसेत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002045001, "chapter_id": 22045, "verse_number": "९०-२", "content_sanskrit": "तेषु क्षारोदं क्षीरीदं दध्युदं घृतसागरं ।\nइक्षुकादम्बरीस्वादुमस्तूदानष्टसागरान् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002045002, "chapter_id": 22045, "verse_number": "९०-३", "content_sanskrit": "निवेशयेद् यथासङ्ख्यमष्टौ विद्येश्वरानथ ।\nएकं शिखण्डिनं रुद्रं श्रीकण्ठन्तु द्वितीयकं ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002045003, "chapter_id": 22045, "verse_number": "९०-४", "content_sanskrit": "त्रिमूर्त्तमेकरुद्राक्षमेकनेत्रं शिवोत्तमं ।\nसप्तमं सूक्ष्मनामानमनन्तं रुद्रमष्टमं ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002045004, "chapter_id": 22045, "verse_number": "९०-५", "content_sanskrit": "मध्ये शिवं समुद्रञ्च शिंवमन्त्रं च विन्यसेत् ।\nयागालयान् दिगीशस्य रचिते स्नानमण्डपे ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002045005, "chapter_id": 22045, "verse_number": "९०-६", "content_sanskrit": "कुर्य्यात् करद्वयायामां वेदीमष्टाङ्गुलोच्छ्रितां ।\nश्रीपर्णाद्यासने तत्र विन्यस्यानन्तमानसं ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002045006, "chapter_id": 22045, "verse_number": "९०-७", "content_sanskrit": "शिष्यं निवेश्य पूर्वास्यं सकलीकृत्य पूजयेत् ।\nकाञ्चिकौदनमृद्भस्मदूर्वागोमयगोलकैः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002045007, "chapter_id": 22045, "verse_number": "९०-८", "content_sanskrit": "सिद्धार्थदधितोयैश्च कुर्य्यान्निर्म्मञ्छनं ततः ।\nक्षारोदानुक्रमेणाथ हृदा विद्येशशम्बरै ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002045008, "chapter_id": 22045, "verse_number": "९०-९", "content_sanskrit": "कलसैः स्नापयेच्छिष्यं स्वधाधारणयान्वितं ।\nपरिधाप्य सिने वस्त्रे निवेश्य शिवदक्षिणे ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002045009, "chapter_id": 22045, "verse_number": "९०-१०", "content_sanskrit": "पूर्व्वोदितासने शिष्यं पुनः पूर्ववदर्च्चयेत् ।\nउष्णीषं योगपट्टञ्च मुकुटं कर्त्तरीं घटीं ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002045010, "chapter_id": 22045, "verse_number": "९०-११", "content_sanskrit": "अक्षमालां पुस्तकादि शिविकाद्यधिकारकं ।\nदीक्षाव्याख्याप्रतिष्ठाद्यं ज्ञात्वाऽद्यप्रभृति त्वया ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002045011, "chapter_id": 22045, "verse_number": "९०-१२", "content_sanskrit": "सुपरीक्ष्य विधातव्यमाज्ञां संश्रावयेदिति ।\nअभिवाद्य ततः शिष्यं प्रणिपत्य महेश्वरं ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002045012, "chapter_id": 22045, "verse_number": "९०-१३", "content_sanskrit": "विघ्नज्वालापनोदार्थं कुर्य्याद्विज्ञापनां यथा ।\nअभिषेकार्थमादिष्टस्त्वयाऽहं गुरुमुर्त्तिना ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002045013, "chapter_id": 22045, "verse_number": "९०-१४", "content_sanskrit": "संहितापारगः सोऽयमभिषिक्तो मया शिव ।\nतृप्तये मन्त्रचक्रस्य पञ्चपञ्चाहुतीर्यजेत् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002045014, "chapter_id": 22045, "verse_number": "९०-१५", "content_sanskrit": "दद्यात् पूर्णां ततः शिष्यं स्थापयेन्निजदक्षिणे ।\nशिष्यदक्षिणपाणिस्था अह्गुलष्ठाद्यङ्गुलीः क्रमात् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002045015, "chapter_id": 22045, "verse_number": "९०-१६", "content_sanskrit": "लात्र्छयेदुपबद्धाय दग्धदर्भाग्रशम्बरैः ।\nकुसुमानि करे दत्वा प्रणामं कारयेदमुं ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002045016, "chapter_id": 22045, "verse_number": "९०-१७", "content_sanskrit": "कुम्भेऽनले शिवे स्वस्मिंस्ततस्तत्कृत्यमाविशेत् ।\nअनुग्राह्यास्त्वया शिष्याः शास्त्रेण सुपरीक्षिताः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002045017, "chapter_id": 22045, "verse_number": "९०-१८", "content_sanskrit": "भूपबन्मानवादीनामभिषेकादबीप्सितं ।\nआं श्रां श्रौं पशुं हूं फडिति अस्त्रराजाभिषेकतः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]