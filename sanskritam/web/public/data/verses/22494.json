[{"id": 7002494000, "chapter_id": 22494, "verse_number": "१-१५६-१", "content_sanskrit": "सुमन्तुरुवाच ।\nइत्थं दत्त्वा वरं भानुरीश्वराय विशां पते ।\nशालग्रामं जगामाशु वरं दातुं हरेर्नृप ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002494001, "chapter_id": 22494, "verse_number": "१-१५६-२", "content_sanskrit": "ददर्श स हरिं तत्र तपन्तं परमं तपः ।\nकृष्णाजिनधरं शान्तं प्रज्वलन्तं स्वतेजसा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002494002, "chapter_id": 22494, "verse_number": "१-१५६-३", "content_sanskrit": "पूजयन्तं महद्व्योम चक्राकारमनौपमम् ।\nगन्धमाल्योपहारैश्च नृत्यगीतप्रवादितैः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002494003, "chapter_id": 22494, "verse_number": "१-१५६-४", "content_sanskrit": "एवं संपूज्य तद्व्योम भक्त्या श्रद्धासमन्वितः ।\nजगाम शिरसा भूमिं हृदि ध्यायन्दिवाकरम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002494004, "chapter_id": 22494, "verse_number": "१-१५६-५", "content_sanskrit": "विष्णुं तं प्रणतं दृष्ट्वा तुष्टो देवो विभावसुः ।\nउवाच विष्णुमामंत्र्य पश्य मामागतं हरे ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002494005, "chapter_id": 22494, "verse_number": "१-१५६-६", "content_sanskrit": "तद्वाक्यं केशवः श्रुत्वा शिरसा च महीं गतः ।\nनमस्ते सर्वदेवेश नमस्ते गगनेचर ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002494006, "chapter_id": 22494, "verse_number": "१-१५६-७", "content_sanskrit": "जगत्पते नमस्तेऽस्तु ग्रहाणां पतये नमः ।\nदारिद्र्यव्याधिदुःखघ्न नमस्ते भवनाशन ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002494007, "chapter_id": 22494, "verse_number": "१-१५६-८", "content_sanskrit": "आदित्यार्क रवे भानो भग पूर्ण दिवाकर ।\nनमस्ते सर्वतत्त्वज्ञ सर्वपापवितर्जित ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002494008, "chapter_id": 22494, "verse_number": "१-१५६-९", "content_sanskrit": "प्रसीद मे जगन्नाथ हंसानघ दिवस्पते ।\nसंसारार्णवमग्नानां त्राहि देव वृषध्वज ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002494009, "chapter_id": 22494, "verse_number": "१-१५६-१०", "content_sanskrit": "पुत्रोऽहं तव देवेश द्वितीयो ब्राह्मणोऽनघ ।\nपितेव पुत्रस्य रवे देहि कामाञ्जगत्पते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002494010, "chapter_id": 22494, "verse_number": "१-१५६-११", "content_sanskrit": "विष्णोर्वचनमाकर्ण्य हर्षं प्राप्य दिवाकरः ।\nउवाच कुरुशार्दूल हर्षगद्गदया गिरा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002494011, "chapter_id": 22494, "verse_number": "१-१५६-१२", "content_sanskrit": "साधु कृष्ण महाबाहो तुष्टोहं तव केशव ।\nनिशम्य ते परां भक्तिं श्रद्धां च पुरुषोत्तम ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002494012, "chapter_id": 22494, "verse_number": "१-१५६-१३", "content_sanskrit": "वरं वरय तस्मात्त्वं वत्स यं मनसेच्छसि ।\nवरदोऽ हमनुप्राप्तो भक्त्याक्रांतस्तवानघ ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002494013, "chapter_id": 22494, "verse_number": "१-१५६-१४", "content_sanskrit": "निशम्य वचनं भानोर्विष्णुर्भक्त्या समन्वितः ।\nकृतांजलिपुटो भूत्वा इदं वचनमब्रवीत् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002494014, "chapter_id": 22494, "verse_number": "१-१५६-१५", "content_sanskrit": "कृतकृत्योऽस्मि देवेश नास्ति धन्यतरो मम ।\nयस्य मे भगवंस्तुष्टो वरदस्त्वं गतः स्वयम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002494015, "chapter_id": 22494, "verse_number": "१-१५६-१६", "content_sanskrit": "यदि तुष्टो मम विभुर्भक्त्या क्रीतो मया यदि ।\nप्रयच्छ त्वचलां भक्तिं यथा शत्रुं पराजये ।\nतथा मम वरं देहि सर्वाराति विनाशनम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002494016, "chapter_id": 22494, "verse_number": "१-१५६-१७", "content_sanskrit": "मम स्थानं च परमं सर्वलोकनमस्कृतम् ।\nलोकानां पालने युक्तिं बलं वीर्यं यशः सुखम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002494017, "chapter_id": 22494, "verse_number": "१-१५६-१८", "content_sanskrit": "एवमुक्तो रविर्भक्त्या विष्णुना वाक्यमुत्तमम् ।\nउवाच कुरुशार्दूल गजत्सन्नादयन्निव ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002494018, "chapter_id": 22494, "verse_number": "१-१५६-१९", "content_sanskrit": "साधु साधु महाबाहो ब्रह्मणस्त्वं जघन्यजः ।\nहरस्य अग्रजश्चापि सर्वदेवनमस्कृतः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002494019, "chapter_id": 22494, "verse_number": "१-१५६-२०", "content_sanskrit": "भक्तश्चापि ममात्यंतं ब्रह्मण्यश्च सदानघ ।\nतस्मात्तवाचला भक्तिर्भविष्यति ममोपरि ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002494020, "chapter_id": 22494, "verse_number": "१-१५६-२१", "content_sanskrit": "एतदेव महद्व्योम चक्रं ते प्रभविष्यति ।\nसर्वायुधवरं वीर सर्वारातिविनाशनम् ।\nतथा स्थानं च परमं सर्वलोकनमस्कृतम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002494021, "chapter_id": 22494, "verse_number": "१-१५६-२२", "content_sanskrit": "इत्थं भानोर्वरं प्राप्य हरिर्देवो जगत्पतिः ।\nमहाप्रसादमित्युक्त्वा जगाम शिरसा महीम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002494022, "chapter_id": 22494, "verse_number": "१-१५६-२३", "content_sanskrit": "भास्करोऽपि वरं दत्त्वा केशवायामितौजसे ।\nजगामाशु महाराज स्वपुरं विबुधाधिपः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002494023, "chapter_id": 22494, "verse_number": "१-१५६-२४", "content_sanskrit": "लोकानां पालने शक्तिं बलं वीर्यं यशः सुखम् ।\nदत्त्वा कृष्णाय देवेशस्तथान्यदपि कांक्षितम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002494024, "chapter_id": 22494, "verse_number": "१-१५६-२५", "content_sanskrit": "एवं ब्रह्मादयो देवाः पूजयित्वा दिवाकरम् ।\nशक्तिमंतो बभूवुस्ते सर्गादीनां प्रवर्तने ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002494025, "chapter_id": 22494, "verse_number": "१-१५६-२६", "content_sanskrit": "इति ते कथितं पुण्यमाख्यानं पापनाशनम् ।\nत्रिदैवत्यमुपाख्यानं त्रैसुरं लोकपूजितम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002494026, "chapter_id": 22494, "verse_number": "१-१५६-२७", "content_sanskrit": "स्तोत्रत्रयसमायुक्तं धर्मकामार्थसाधनम् ।\nधर्म्यं स्वर्ग्यं तथा पुण्यमारोग्यधनधान्यदम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002494027, "chapter_id": 22494, "verse_number": "१-१५६-२८", "content_sanskrit": "य इदं शृणुयान्नित्यं पठेत्स्तोत्रत्रयं च यः ।\nसोऽग्नेयं यानमारूढो याति भानोः पर पदम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002494028, "chapter_id": 22494, "verse_number": "१-१५६-२९", "content_sanskrit": "अपुत्रो लभते पुत्रमधनो धनमश्नुते ।\nविद्यार्थी लभते विद्यां प्रसादाद्भास्करस्य तु ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002494029, "chapter_id": 22494, "verse_number": "१-१५६-३०", "content_sanskrit": "तेजसा रविसंकाशः प्रभया पृश्निसन्निभः ।\nमोदते सुचिरं कालं ज्ञानिनामुत्तमो भवेत् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]