[{"id": 2016642, "chapter_id": 1349, "verse_number": "२-९०-१", "content_sanskrit": "भीम उवाच।\nभवन्ति गेहे बन्धक्यः कितवानां युधिष्ठिर।\nभवन्ति दीव्यन्ति दया चैवास्ति तावस्वपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2016643, "chapter_id": 1349, "verse_number": "२-९०-२", "content_sanskrit": "काश्यो यद्धनमाहार्षीद्द्रव्यं यच्चान्यदुत्तमम्।\nतथाऽन्ये पृथिवीपाला यानि रत्नान्युपाहरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2016644, "chapter_id": 1349, "verse_number": "२-९०-३", "content_sanskrit": "वाहनानि धनं चैव कवचान्यायुधानि च।\nराज्यमात्मा वयं चैव कैतवेन हृतं परैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2016645, "chapter_id": 1349, "verse_number": "२-९०-४", "content_sanskrit": "न च मे तत्र कोपोऽभूत्सर्वस्येशो हि नो भवान्।\nइमं त्वतिक्रमं मन्यो द्रौपदी यत्र पण्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2016646, "chapter_id": 1349, "verse_number": "२-९०-५", "content_sanskrit": "एषा ह्यनर्हती बाला पाण्डवान्प्राप्य कौरवैः।\nत्वत्कृते क्लिश्यते क्षुद्रैर्नृशंसैरकृतात्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2016647, "chapter_id": 1349, "verse_number": "२-९०-६", "content_sanskrit": "अस्याः कृते मन्युरयं त्वयि राजन्निपात्यते।\nबाहू ते सम्प्रधक्ष्यामि सहदेवाग्निमानयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2016648, "chapter_id": 1349, "verse_number": "२-९०-७x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2016649, "chapter_id": 1349, "verse_number": "२-९०-७", "content_sanskrit": "न पुरा भीमसेन त्वमीदृशीर्वदिता गिरः।\nपरैस्ते नाशितं नूनं नृशंसैर्धर्मगौरवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2016650, "chapter_id": 1349, "verse_number": "२-९०-८", "content_sanskrit": "न सकामाः परो कार्या धर्ममेवाचरोत्तमम्।\nभ्रातरं धार्मिकं ज्येष्ठं कोऽतिवर्तितुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2016651, "chapter_id": 1349, "verse_number": "२-९०-९", "content_sanskrit": "आहूतो हि परै राजा क्षात्रं व्रतमनुस्मरन्।\nदीव्यते परकामेन तन्नः कीर्तिकरं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2016652, "chapter_id": 1349, "verse_number": "२-९०-१०x", "content_sanskrit": "भीमसेन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2016653, "chapter_id": 1349, "verse_number": "२-९०-१०", "content_sanskrit": "एवमस्मिन्कृतं विद्यां यदि नाहं धनञ्जय।\nदीप्तेऽग्नौ सहितौ बाहू निर्दहेयं बलादिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2016654, "chapter_id": 1349, "verse_number": "२-९०-११x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2016655, "chapter_id": 1349, "verse_number": "२-९०-११", "content_sanskrit": "तथा तान्दुः खितान्दृष्ट्वा पाण्डवान्धृतराष्ट्रजः।\nकृष्यमाणां च पाञ्चालीं विकर्ण इदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2016656, "chapter_id": 1349, "verse_number": "२-९०-१२", "content_sanskrit": "याज्ञसेन्या यदुक्तं तद्वाक्यं विब्रूत पार्थिवाः।\nअविवेकेन वाक्यस्य नरकः सद्य एव नः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2016657, "chapter_id": 1349, "verse_number": "२-९०-१३", "content_sanskrit": "भीष्मश्च धृतराष्ट्रश्च कुरुवृद्धतमावुभौ।\nसमेत्य नाहतुः किञ्चिद्विदुरश्च महामतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2016658, "chapter_id": 1349, "verse_number": "२-९०-१४", "content_sanskrit": "भारद्वाजश्च सर्वेषामाचार्यः कृप एव च।\nकुत एतावपि प्रश्नं नाहतुर्द्विजसत्तमौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2016659, "chapter_id": 1349, "verse_number": "२-९०-१५", "content_sanskrit": "ये त्वन्ये पृथिवीपालाः समेताः सर्वतोदिशम्।\nकामक्रोधौ समुत्सृज्य ते ब्रुवन्तु यथामति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2016660, "chapter_id": 1349, "verse_number": "२-९०-१६", "content_sanskrit": "यदितं द्रौपदी वाक्यमुक्तवत्यसकृच्छुभा।\nविमृश्य कस्य कः पक्षः पार्थिवा वदतोत्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2016661, "chapter_id": 1349, "verse_number": "२-९०-१७x", "content_sanskrit": "वाशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2016662, "chapter_id": 1349, "verse_number": "२-९०-१७", "content_sanskrit": "एवं स बहुशः सर्वानुक्तवांस्तान्सभासदः।\nन च ते पृथिवीपालास्तमूचुः साध्वसाधु वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2016663, "chapter_id": 1349, "verse_number": "२-९०-१८", "content_sanskrit": "उक्त्वाऽसकृत्तथा सर्वान्विकर्णः पृथिवीपतीन्।\nपाणौ पाणिं विनिष्पिष्य निःश्वसन्निदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2016664, "chapter_id": 1349, "verse_number": "२-९०-१९", "content_sanskrit": "विब्रूत पृथिवीपाला वाक्यं मा वा कथञ्चनि।\nमन्ये न्याय्यं यदत्राहं तद्वि वक्ष्यामि कौरवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2016665, "chapter_id": 1349, "verse_number": "२-९०-२०", "content_sanskrit": "चत्वार्याहुर्नश्रेष्ठा व्यसनानि महीक्षिताम्।\nमृगयां पानमक्षांश्च ग्राम्ये चैवातिरक्तताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2016666, "chapter_id": 1349, "verse_number": "२-९०-२१", "content_sanskrit": "एतेषु हि नरः सक्तो धर्ममुत्सृज्य वर्तते।\nयथाऽयुक्तेन च कृतां क्रियां लोको न मन्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2016667, "chapter_id": 1349, "verse_number": "२-९०-२२", "content_sanskrit": "तथेयं पाण्डुपुत्रेण व्यसने वर्तता भृशम्।\nसमाहूतेन कितवैरास्थितो द्रौपदीपणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2016668, "chapter_id": 1349, "verse_number": "२-९०-२३", "content_sanskrit": "साधारणी च सर्वेषां पाण्डवानामनिन्दिता।\nजितेन पूर्वं चानेन पाण्डवेन कृतः पणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2016669, "chapter_id": 1349, "verse_number": "२-९०-२४", "content_sanskrit": "इयं च कीर्तिता कृष्णा सौबलेन पणार्थिना।\nएतत्सर्वं विचार्याहं मन्ये न विजितामिमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2016670, "chapter_id": 1349, "verse_number": "२-९०-२५x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2016671, "chapter_id": 1349, "verse_number": "२-९०-२५", "content_sanskrit": "एतच्छ्रुत्वा महान्नादः सभ्यानामुदतिष्ठत।\nविकर्णं शंसमानानां सौबलं चापि निन्दताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2016672, "chapter_id": 1349, "verse_number": "२-९०-२६", "content_sanskrit": "तस्मिन्नुपरते शब्दे राधेयः क्रोधमूर्छितः।\nप्रगृह्य रुचिरं बाहुमिदं वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2016673, "chapter_id": 1349, "verse_number": "२-९०-२७x", "content_sanskrit": "कर्ण उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2016674, "chapter_id": 1349, "verse_number": "२-९०-२७", "content_sanskrit": "दृश्यन्ते वै विकर्णेह वैकृतानि बहून्यपि।\nतज्जातस्तद्विनाशाय यथाऽग्निररणिप्रजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2016675, "chapter_id": 1349, "verse_number": "२-९०-२८", "content_sanskrit": "एते न किञ्चिदप्याहुश्चोदिता ह्यपि कृष्णया।\nधर्मेण विजितामेतां मन्यन्ते द्रपदात्मजाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2016676, "chapter_id": 1349, "verse_number": "२-९०-२९", "content_sanskrit": "त्वं तु केवलबाल्येन धार्तराष्ट्र विदीर्यसे।\nयद्ब्रवीषि सभाम्ध्ये बालः स्थविरभाषितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2016677, "chapter_id": 1349, "verse_number": "२-९०-३०", "content_sanskrit": "न च धर्म यथावत्त्वं कृष्णां च जितेति सुमन्दधीः।\nयद्ब्रवीषि जितां कृष्णां न जितेति सुमन्दधीः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2016678, "chapter_id": 1349, "verse_number": "२-९०-३१", "content_sanskrit": "कथं ह्यविजितां कृष्णां मन्यसे धृतराष्ट्रज।\nयदा सभायां सर्वस्वं न्यस्तवान्पाण्डवाग्रजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2016679, "chapter_id": 1349, "verse_number": "२-९०-३२", "content_sanskrit": "अभ्यन्तर च सर्वस्वे द्रौपदी भरतर्षभ।\nएवं धर्मजितां कृष्णां मन्यसे न जितां कथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2016680, "chapter_id": 1349, "verse_number": "२-९०-३३", "content_sanskrit": "कीर्तिता द्रौपदी वाचा अनुज्ञाता च पाण्डवैः।\nभवत्यविजिता केन हेतुनैषा मता तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2016681, "chapter_id": 1349, "verse_number": "२-९०-३४", "content_sanskrit": "मन्यसे वा सभामेतामानीतामेकवाससम्।\nअधर्मेणेति तत्रापि शृणु मे वाक्यमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2016682, "chapter_id": 1349, "verse_number": "२-९०-३५", "content_sanskrit": "एको भर्ता स्त्रिया देवैर्विहितः कुरुनन्दन।\nइयं त्वनेकवशगा बन्धकीति विनिश्चिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2016683, "chapter_id": 1349, "verse_number": "२-९०-३६", "content_sanskrit": "अस्याः सभामानयनं न चित्रमिति मे मतिः।\nएकाम्बरधरत्वं वाऽप्यथवाऽपि विवस्त्रता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2016684, "chapter_id": 1349, "verse_number": "२-९०-३७", "content_sanskrit": "यच्चैषां द्रविणं किञ्चिद्य चैषा ये च पाण्डवाः।\nसौबलेनेह तत्सर्वं धर्मेण विजितं वसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2016685, "chapter_id": 1349, "verse_number": "२-९०-३८", "content_sanskrit": "दुःशासन सुबालोऽयं विकर्णः प्राज्ञवादिकः।\nपाण्डवानां च वासांसि द्रौपद्याश्चाप्युपाहर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2016686, "chapter_id": 1349, "verse_number": "२-९०-३९x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2016687, "chapter_id": 1349, "verse_number": "२-९०-३९", "content_sanskrit": "तच्छ्रुत्वा पाण्डवाः सर्वे स्वानि वासांसि भारत।\nअवकीर्योत्तरीयाणि सभायां समुपाविशन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2016688, "chapter_id": 1349, "verse_number": "२-९०-४०", "content_sanskrit": "ततो दुःशासनो राजन्द्रौपद्या वसनं बलात्।\nसभामध्ये सभाक्षिप्य व्यपाक्रष्टुं प्रचक्रमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2016689, "chapter_id": 1349, "verse_number": "२-९०-४१", "content_sanskrit": "आकृष्यमाणे वसने विललाप सुदुःखिता।\nज्ञातं मया विसिष्ठेन पुरा गीतं महात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2016690, "chapter_id": 1349, "verse_number": "२-९०-४२", "content_sanskrit": "महत्यापदि सम्प्राप्ते स्मर्तव्यो भगवान्हरिः।\nइति निश्चित्य मनसा शरणागतवत्सलम्।\nआकृष्यमाणे वसने द्रौपदी कृष्णमस्तरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2016691, "chapter_id": 1349, "verse_number": "२-९०-४३", "content_sanskrit": "शङ्खचक्रगदापाणे द्वारकानिलयाच्युत।\nगोविन्द पुण्डरीकाक्ष रक्ष मां शरणागताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2016692, "chapter_id": 1349, "verse_number": "२-९०-४४", "content_sanskrit": "हा कृष्ण द्वारकावासिन्क्वासि यादवन्दन।\nइमामवस्थां सम्प्राप्तामनाथां किमुपेक्षसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2016693, "chapter_id": 1349, "verse_number": "२-९०-४५", "content_sanskrit": "गोविन्द द्वारकावासिन्कृष्ण गोपीजनप्रिय।\nकौरवैः परिभूतां मां किं न जानासि केशव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2016694, "chapter_id": 1349, "verse_number": "२-९०-४६", "content_sanskrit": "हे नाथ हे रमानाथ व्रजनाथार्तिनाशन।\nकौरवार्णवग्नां मामुद्धरस्व जनार्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2016695, "chapter_id": 1349, "verse_number": "२-९०-४७", "content_sanskrit": "कृष्णकृष्ण महायोगिन्विश्वात्मन्विश्व्भावन।\nप्रपन्नां पाहि गोविन्द कुरमध्येऽवसीदतीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2016696, "chapter_id": 1349, "verse_number": "२-९०-४८", "content_sanskrit": "इत्यनुस्मृत्य कृष्णं सा हरिं त्रिभुवनेश्वरम्।\nप्रारुदद्दुः खिता राजन्मुखमाच्छाद्य भामिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2016697, "chapter_id": 1349, "verse_number": "२-९०-४९", "content_sanskrit": "तस्य प्रसाद्द्रौपद्याः कृष्णमाणेऽम्बरे तदा।\nतद्रूपमपरे वस्त्रं प्रादुरासीदनेकशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2016698, "chapter_id": 1349, "verse_number": "२-९०-५०", "content_sanskrit": "नानारागविरागाणि वसनान्यथ वै प्रभो।\nप्रादुर्भवन्ति शतशो धर्मस्य परिपालनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2016699, "chapter_id": 1349, "verse_number": "२-९०-५१", "content_sanskrit": "ततो हलहलाशब्दस्तत्रासीद्घोरदर्शनः।\nतदद्भुततमं लोके वीक्ष्य सर्वे महीभृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2016700, "chapter_id": 1349, "verse_number": "२-९०-५२", "content_sanskrit": "शशंसुर्द्रौपदीं तत्र कुत्सन्तो धृतराष्ट्रजम्।\nधिग्धिगित्यशिवां वाचमुत्सृजन्कौरवान्प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2016701, "chapter_id": 1349, "verse_number": "२-९०-५३", "content_sanskrit": "यदा तु वाससां राशिः सभामध्ये समाचितः।\nतदा दुःशासनः श्रान्तो व्रीडितः समुपाविशत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2016702, "chapter_id": 1349, "verse_number": "२-९०-५४", "content_sanskrit": "शशाप तत्र भीमस्तु राजमध्ये बृहत्स्वनः।\nक्रोधाद्विस्फुरमाणौष्ठो विनिष्पिष्य करे करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2016703, "chapter_id": 1349, "verse_number": "२-९०-५५x", "content_sanskrit": "भीम उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2016704, "chapter_id": 1349, "verse_number": "२-९०-५५", "content_sanskrit": "इदं मे वाक्यमादध्वं क्षत्रिया लोकवासिनः।\nनोक्तपूर्वं नरैरन्यैर्न चान्यो यद्वदिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2016705, "chapter_id": 1349, "verse_number": "२-९०-५६", "content_sanskrit": "यद्येतदेवमुक्त्वाऽहं न कुर्यां पृथिवीश्वराः।\nपितामहानां पूर्वेषां नाहं गतिमवाप्नुयाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2016706, "chapter_id": 1349, "verse_number": "२-९०-५७", "content_sanskrit": "अस्य पापस्य दुर्बुद्धेर्भारतापसदस्य च।\nन पिबेयं बलाद्वक्षो भित्त्वा चेद्रुधिरं युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2016707, "chapter_id": 1349, "verse_number": "२-९०-५८x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2016708, "chapter_id": 1349, "verse_number": "२-९०-५८", "content_sanskrit": "तस्य ते तद्वचः श्रुत्वा रौद्रं लोमप्रहर्षणम्॥\nप्रचक्रुर्बहुलां पूजां कुसन्तो धृतराष्ट्रजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2016709, "chapter_id": 1349, "verse_number": "२-९०-५९", "content_sanskrit": "न विब्रुवन्ति कौरव्याः प्रश्नमेतमिति स्म ह।\nसुजनः क्रोशति स्मात्र धृतराष्ट्रं विगर्हयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2016710, "chapter_id": 1349, "verse_number": "२-९०-६०", "content_sanskrit": "विदुर उवाच।\nद्रौपदी प्रश्नमुक्त्वैवं रोरवीति त्वनाथवत्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2016711, "chapter_id": 1349, "verse_number": "२-९०-६१x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2016712, "chapter_id": 1349, "verse_number": "२-९०-६१", "content_sanskrit": "तस्य ते तद्वचः श्रुत्वा रौद्रं लोमप्रहर्षणम्।\nन च विब्रूत तं प्रश्नं सभ्या धर्मोऽत्र पीड्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2016713, "chapter_id": 1349, "verse_number": "२-९०-६२", "content_sanskrit": "सभां प्रपद्यते प्रश्नः प्रज्वलन्निव हव्यवाद्।\nतं वै सत्येन धर्मेण सभ्याः प्रशमयन्त्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2016714, "chapter_id": 1349, "verse_number": "२-९०-६३", "content_sanskrit": "धर्म्यं प्रश्नमतो ब्रूयादार्यः सत्येन मानवः।\nविब्रूयुस्तत्र तं प्रश्नं कामक्रोधबलातिगाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2016715, "chapter_id": 1349, "verse_number": "२-९०-६४", "content_sanskrit": "विकर्णेन यथाप्रज्ञमुक्तः प्रश्नो नराधिपाः।\nभवन्तोऽपि हि तं प्रश्नं विब्रुवन्तु यथामति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2016716, "chapter_id": 1349, "verse_number": "२-९०-६५", "content_sanskrit": "यो हि प्रश्नं न विब्रूयाद्धर्मदर्शी सभां गतः।\nअनृते या फलावाप्तिस्तस्याः सोऽर्धं समश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2016717, "chapter_id": 1349, "verse_number": "२-९०-६६", "content_sanskrit": "यः पुनर्वितथं ब्रूयाद्धर्मदशीं सभां गतः।\nअनृतस्य फलं कृत्स्नं स प्राप्नोतीति निश्चयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2016718, "chapter_id": 1349, "verse_number": "२-९०-६७", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nप्रह्लादस्य च संवादं मुनेराङ्गिरसस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2016719, "chapter_id": 1349, "verse_number": "२-९०-६८", "content_sanskrit": "प्रह्लादो नाम दैत्येन्द्रस्तस्य पुत्रो विरोचनः।\nकन्याहेतोराङ्गिरसं सुधन्वानमुपाद्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2016720, "chapter_id": 1349, "verse_number": "२-९०-६९", "content_sanskrit": "अहं ज्यायानहं ज्यायानिति कन्येप्सया तदा।\nतयोर्देवनमत्रासीत्प्राणयोरिति नः श्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2016721, "chapter_id": 1349, "verse_number": "२-९०-७०", "content_sanskrit": "तयोः प्रश्नविवादोऽभूत्प्रह्लादं तावपृच्छताम्।\nज्यायान्क आवयोरेकः प्रश्नं प्रब्रूहि मा मृषा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2016722, "chapter_id": 1349, "verse_number": "२-९०-७१", "content_sanskrit": "स वै विवदनाद्भीतः सुधन्वानं विलोकयन्।\nतं सुधन्वाब्रवीत्क्रुद्धो ब्रह्मदम्ड इव ज्वलन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2016723, "chapter_id": 1349, "verse_number": "२-९०-७२", "content_sanskrit": "यदि वै वक्ष्यसि मृषा प्रह्लादाथ न वक्ष्यसि॥\nशतघा ते शिरो वज्री वज्रेण प्रहरिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2016724, "chapter_id": 1349, "verse_number": "२-९०-७३", "content_sanskrit": "सुधन्वना तथोक्तः सन्व्यथितोऽश्वत्थपर्णवत्।\nजगाम कश्यपं दैत्यः परिप्रष्टुं महौजसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2016725, "chapter_id": 1349, "verse_number": "२-९०-७४x", "content_sanskrit": "प्रह्लाद उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2016726, "chapter_id": 1349, "verse_number": "२-९०-७४", "content_sanskrit": "त्वं वै धर्मस्य विज्ञाता दैवस्येहासुरस्य च।\nब्राह्मणस्य महाभाग धर्मकृच्छ्रमिदं शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2016727, "chapter_id": 1349, "verse_number": "२-९०-७५", "content_sanskrit": "यो वै प्रश्नं न विब्रूयाद्वितथं चैव निर्दिशेत्।\nके वै तस्य परे लोकास्तन्ममाचक्ष्व पृच्छतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2016728, "chapter_id": 1349, "verse_number": "२-९०-७६x", "content_sanskrit": "कश्यप उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2016729, "chapter_id": 1349, "verse_number": "२-९०-७६", "content_sanskrit": "जानन्नविब्रुवन्प्रश्नान्कामात्क्रोधाद्भयात्तथा।\nसहस्रं वारुणान्पाशानात्मनि प्रतिमुञ्चति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2016730, "chapter_id": 1349, "verse_number": "२-९०-७७", "content_sanskrit": "साक्षी वा विब्रुवन्साक्ष्यं गोकर्णशिथिलश्वरन्।\nसहस्रं वारुणान्पाशानात्मनि प्रतिमुञ्जति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2016731, "chapter_id": 1349, "verse_number": "२-९०-७८", "content_sanskrit": "तस्य संवत्सरे पूर्णे पाश एकः प्रमुच्यते।\nतस्मात्सत्यं तु वक्तव्यं जानता सत्यमुञ्जसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2016732, "chapter_id": 1349, "verse_number": "२-९०-७९", "content_sanskrit": "विद्धो धर्मो ह्यधर्मेण सभां यत्रोपपद्यते।\nन चास्य शल्यं कृन्तन्ति विद्धास्तत्र सभासदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2016733, "chapter_id": 1349, "verse_number": "२-९०-८०", "content_sanskrit": "अर्धं हरति वै श्रेष्ठः पादो भवति कर्तृषु।\nपादश्चैव सभासत्सु ये न निन्दन्ति निन्दितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2016734, "chapter_id": 1349, "verse_number": "२-९०-८१", "content_sanskrit": "अनेना भवति श्रेष्ठो मुच्यन्ते च सभासदः।\nएनो गच्छति कर्तारं निन्दार्हो यत्र निन्द्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2016735, "chapter_id": 1349, "verse_number": "२-९०-८२", "content_sanskrit": "वितथं तु वदेयुर्ये धर्मं प्रह्लाद पृच्छते।\nइष्टापूर्तं च ते घ्न्ति सप्तसप्त परावरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2016736, "chapter_id": 1349, "verse_number": "२-९०-८३", "content_sanskrit": "हृतस्वस्य हि यद्दुःखं हतपुत्रस्य चैव यत्।\nऋणिनः प्रति यच्चैव स्वार्थाद्धष्टस्य चैव यत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2016737, "chapter_id": 1349, "verse_number": "२-९०-८४", "content_sanskrit": "स्त्रियाः पत्या विहीनाया राज्ञा ग्रस्तस्य चैव यत्।\nअपुत्रायाश्च यद्दुःखं व्याघ्राघ्रातस्य चैव यत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2016738, "chapter_id": 1349, "verse_number": "२-९०-८५", "content_sanskrit": "अध्यूढायाश्च यद्दुःखं व्याघ्राघ्रातस्य चैव यत्॥\nएतानि वै समान्याहुर्दुःखानि त्रिदिवेश्वराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2016739, "chapter_id": 1349, "verse_number": "२-९०-८६", "content_sanskrit": "तानि सर्वाणि दुःखानि प्राप्नोति वितथं ब्रुवन्।\nसमक्षदर्शनात्साक्षी श्रवणाच्चेति धारणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2016740, "chapter_id": 1349, "verse_number": "२-९०-८७", "content_sanskrit": "तस्मात्सत्यं ब्रुवत्साक्षी धर्मार्थाभ्यां न हीयते।\nकश्यपस्य वचः श्रुत्वा प्रह्लादः पुत्रमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2016741, "chapter_id": 1349, "verse_number": "२-९०-८८", "content_sanskrit": "श्रेयान्सुधन्वा त्वत्तो वै मत्तः श्रेयांस्तथाङ्गिराः।\nमाता सुधन्वाऽयं प्राणानामीश्वरस्तव॥\nविरोचन सुधन्वाऽयं प्राणानामीश्वरस्तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2016742, "chapter_id": 1349, "verse_number": "२-९०-८९x", "content_sanskrit": "सुधन्वोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2016743, "chapter_id": 1349, "verse_number": "२-९०-८९", "content_sanskrit": "पुत्रस्नेहं पिरत्यज्य यस्त्वं धर्मे व्यवस्थितः।\nअनुजानामि ते पुत्रं जीवत्वेव शतं समाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2016744, "chapter_id": 1349, "verse_number": "२-९०-९०x", "content_sanskrit": "विदुर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2016745, "chapter_id": 1349, "verse_number": "२-९०-९०", "content_sanskrit": "एवं वै परमं धर्मं श्रुत्वा सर्वे सभासदः।\nयथाप्रश्नं तु कृष्णाया मन्यध्वं तत्र किं परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2016746, "chapter_id": 1349, "verse_number": "२-९०-९१x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2016747, "chapter_id": 1349, "verse_number": "२-९०-९१", "content_sanskrit": "विदुरस्य वचः श्रुत्वा नोचुः किञ्चन पार्थिवाः।\nकर्णो दुःशासनं त्वाह कृष्णं दासीं गृहान्नय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2016748, "chapter_id": 1349, "verse_number": "२-९०-९२", "content_sanskrit": "तां वेपमानां सव्रीडां प्रलपन्तीं स्म पाण्डवान्।\nदुःशासनः सभामध्ये विचकर्ष तपस्विनीम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2016749, "chapter_id": 1349, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि द्यूतपर्वणि नवतितमोऽध्यायः॥ ९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}]