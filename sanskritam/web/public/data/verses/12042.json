[{"id": 50025784, "chapter_id": 12042, "verse_number": "1", "content_sanskrit": "आनन्दतीर्थमुनिना व्यासवाक्यसमुद्धृतिः। सदाचारस्य विषये कृता सङ्क्षेपतः शुभा॥ ३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50025785, "chapter_id": 12042, "verse_number": "2", "content_sanskrit": "अशेषकल्याणगुणनित्यानुभवसत्तनुः। अशेषदोषरहितः प्रीयतां पुरुषोत्तमः॥ ३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50025786, "chapter_id": 12042, "verse_number": "3", "content_sanskrit": "॥ इति श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचिता सदाचारस्मृतिः सम्पूर्णा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}]