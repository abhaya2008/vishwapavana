[{"id": 2010477, "chapter_id": 1212, "verse_number": "१-२१३-०x", "content_sanskrit": "द्रुपद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2010478, "chapter_id": 1212, "verse_number": "१-२१३-१", "content_sanskrit": "ब्रूहि तत्कारणं येन ब्रह्मन्नालायनी शुभा।\nजाता ममाध्वरे कृष्मा सर्ववेदविदां वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2010479, "chapter_id": 1212, "verse_number": "१-२१३-२x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2010480, "chapter_id": 1212, "verse_number": "१-२१३-२", "content_sanskrit": "शृणु राजन्यथा ह्यस्या दत्तो रुद्रेण वै वरः।\nयदर्थं चैव संभूता तव गेहे यशस्विनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2010481, "chapter_id": 1212, "verse_number": "१-२१३-३", "content_sanskrit": "हन्त त कथयिष्यामि कृष्मायाः पौर्वदेहिकम्।\nइन्द्रसेनेति विख्याता पुरा नालायनी शुभा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2010482, "chapter_id": 1212, "verse_number": "१-२१३-४", "content_sanskrit": "मौद्गल्यस्य पतिमासाद्य चचार विगतज्वरा।\nमौद्गल्यस्य महर्षेश्च रममाणस्य वै तया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2010483, "chapter_id": 1212, "verse_number": "१-२१३-५", "content_sanskrit": "संवत्सरगणा राजन्व्यतीयुः क्षणवत्तदा।\nततः कदाचिद्धर्मात्मा तृप्तः कामैर्व्यरज्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2010484, "chapter_id": 1212, "verse_number": "१-२१३-६", "content_sanskrit": "अन्विच्छन्परमं धर्मं ब्रह्मयोगपरोऽभवत्।\nउत्ससर्ज स तां विप्रः सा तदा चापतद्भुवि।\nमौद्गल्यो राजशार्दूल तपोभिर्भावितः सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2010485, "chapter_id": 1212, "verse_number": "१-२१३-७x", "content_sanskrit": "नालायन्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2010486, "chapter_id": 1212, "verse_number": "१-२१३-७", "content_sanskrit": "प्रसीद भगवन्मह्यं न मामुत्स्रष्टुमर्हसि।\nअवितृप्तास्मि ब्रह्मर्षे कामानां कामसेवनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2010487, "chapter_id": 1212, "verse_number": "१-२१३-८x", "content_sanskrit": "मौद्गल्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2010488, "chapter_id": 1212, "verse_number": "१-२१३-८", "content_sanskrit": "यस्मात्त्वं मामनिःशङ्का ह्यवक्तव्यं भाषसे।\nआचरन्ती तपोविघ्नं तस्माच्छृणु वचो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2010489, "chapter_id": 1212, "verse_number": "१-२१३-९", "content_sanskrit": "भविष्यसि नृलोके त्वं राजपुत्री यशस्वि।\nपाञ्चालराजस्य सुता द्रुपदस्य महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2010490, "chapter_id": 1212, "verse_number": "१-२१३-१०", "content_sanskrit": "भवितारस्तत्र तव पतयः पञ्च विप्लुताः।\nतैः सार्धं मधुराकारैश्चिरं रतिमवाप्स्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2010491, "chapter_id": 1212, "verse_number": "१-२१३-११x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2010492, "chapter_id": 1212, "verse_number": "१-२१३-११", "content_sanskrit": "सैवं शप्ता तु विमना वनं प्रागाद्यशस्विनी।\nभोगैरतृप्ता देवेशं तपसाऽऽराधयत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2010493, "chapter_id": 1212, "verse_number": "१-२१३-१२", "content_sanskrit": "निराशीर्मारुताहारा निराहारा तथैव च।\nअनुवर्तमाना त्वादित्यं तथा पञ्चतपाभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2010494, "chapter_id": 1212, "verse_number": "१-२१३-१३", "content_sanskrit": "तीव्रेण तपसा तस्यास्तुष्टः पशुपतिः स्वयम्।\nवचं प्रादात्तदा रुद्रः सर्वलोकेश्वरः प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2010495, "chapter_id": 1212, "verse_number": "१-२१३-१४", "content_sanskrit": "भविष्यति परं जन्म भविष्यति वराङ्गना।\nभविष्यन्ति परं भद्रे पतयः पञ्च विश्रुताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2010496, "chapter_id": 1212, "verse_number": "१-२१३-१५", "content_sanskrit": "महेन्द्रवपुषः सर्वे महेन्द्रसमविक्रमाः।\nतत्रस्था च महत्कर्म सुराणां त्वं करिष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2010497, "chapter_id": 1212, "verse_number": "१-२१३-१६x", "content_sanskrit": "स्त्र्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2010498, "chapter_id": 1212, "verse_number": "१-२१३-१६", "content_sanskrit": "एकः खलु मया भर्ता वृतः पञ्च त्विमे कथम्।\nएको भवति नैकस्या बहवस्तद्ब्रवीहि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2010499, "chapter_id": 1212, "verse_number": "१-२१३-१७x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2010500, "chapter_id": 1212, "verse_number": "१-२१३-१७", "content_sanskrit": "पञ्चकृत्वस्त्वया चोक्तः पतिं देहीत्यहं पुनः।\nपञ्चते पतयो भद्रे भविष्यन्ति सुखावहाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2010501, "chapter_id": 1212, "verse_number": "१-२१३-१८x", "content_sanskrit": "स्त्र्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2010502, "chapter_id": 1212, "verse_number": "१-२१३-१८", "content_sanskrit": "धर्म एकः पतिः स्त्रीणां पूर्वमे प्रकल्पितः।\nबहुपत्नीकता पुंसो धर्मश्च बहुभिः कृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2010503, "chapter_id": 1212, "verse_number": "१-२१३-१९", "content_sanskrit": "स्त्रीधर्मः पूर्वमेवायं निर्मितो मुनिभिः सदा।\nसहधर्मचरी भर्तुरेका एकस्य चोच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2010504, "chapter_id": 1212, "verse_number": "१-२१३-२०", "content_sanskrit": "एको हि भर्ता नारीणां कौमार इति लौकिकः।\nआपत्सु च नियोगेन भर्तुर्नार्याः परः स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2010505, "chapter_id": 1212, "verse_number": "१-२१३-२१", "content_sanskrit": "गच्छेत न तृतीयं तु तस्या निष्कृतिरुच्यते।\nचतुर्थे पतिता नारी पञ्चमे वर्धकी भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2010506, "chapter_id": 1212, "verse_number": "१-२१३-२२", "content_sanskrit": "एवं गते धर्मपथे न वृणे बहुपुंस्कताम्।\nअलोकाचरितात्त्समात्कथं मुच्येय सङ्करात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2010507, "chapter_id": 1212, "verse_number": "१-२१३-२३x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2010508, "chapter_id": 1212, "verse_number": "१-२१३-२३", "content_sanskrit": "अनावृताः पुरा नार्यो ह्यासञ्शुध्यन्ति चार्तवे।\nसकृदुक्तं त्वया नैतन्नाधर्मस्ते भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2010509, "chapter_id": 1212, "verse_number": "१-२१३-२४x", "content_sanskrit": "स्त्र्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2010510, "chapter_id": 1212, "verse_number": "१-२१३-२४", "content_sanskrit": "यदि मे पतयः पञ्च रतिमिच्छामि तैर्मिथः।\nकौमारं च भवेत्सर्वैः संगमे संगमे च मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2010511, "chapter_id": 1212, "verse_number": "१-२१३-२५", "content_sanskrit": "पतिशुश्रूषया चैव सिद्धिः प्राप्ता मया पुरा।\nभोगेच्छा च मया प्राप्ता स च भोगश्च मे भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2010512, "chapter_id": 1212, "verse_number": "१-२१३-२६x", "content_sanskrit": "रुद्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2010513, "chapter_id": 1212, "verse_number": "१-२१३-२६", "content_sanskrit": "रतिश्च भद्रे सिद्धिश्च न भजेते परस्परम्।\nभोगानाप्स्यसि सिद्धिं च योगेन च महत्त्वताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2010514, "chapter_id": 1212, "verse_number": "१-२१३-२७", "content_sanskrit": "अन्यदेहान्तरे चैव रूपभाग्यगुणान्विता।\nपञ्चभिः प्राप्य कौमारं महाभागा भविष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2010515, "chapter_id": 1212, "verse_number": "१-२१३-२८", "content_sanskrit": "गच्छ गङ्गाजलस्था च नरं पश्यसि यं शुभे।\nतमानय ममाभ्याशं सुरराजं शुचिस्मिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2010516, "chapter_id": 1212, "verse_number": "१-२१३-२९", "content_sanskrit": "इत्युक्ता विश्वरूपेण रुद्रं कृत्वा प्रदक्षिणम्।\nजगाम गङ्गामुद्दिश्य पुण्यां त्रिपथगां नदीम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2010517, "chapter_id": 1212, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि वैवाहिकपर्वणि त्रयोदशाधिकद्विशततमोऽध्यायः॥ २१३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]