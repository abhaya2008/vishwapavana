[{"id": 2065974, "chapter_id": 2394, "verse_number": "९-१२-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2065975, "chapter_id": 2394, "verse_number": "९-१२-१", "content_sanskrit": "पीडिते धर्मराजे तु मद्रराजेन मारिष।\nसात्यकिर्भीमसेनश्च माद्रीपुत्रौ च पाण्डवौ।\nपरिवार्य रथैः शल्यं पीडयामासुराहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2065976, "chapter_id": 2394, "verse_number": "९-१२-२", "content_sanskrit": "तमेकं बहुभिर्दृष्ट्वा पीड्यमानं महारथैः।\nसाधुवादो महाञ्जज्ञे सिद्धाश्चासन्प्रहर्षिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2065977, "chapter_id": 2394, "verse_number": "९-१२-३", "content_sanskrit": "आश्चर्यमित्यभाषन्त मुनयश्चापि सङ्गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2065978, "chapter_id": 2394, "verse_number": "९-१२-४", "content_sanskrit": "भीमसेनो रणे शल्यं शल्यभूतं पराक्रमे।\nएकेन विद्ध्वा बाणेन पुनर्विव्याध सप्तभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2065979, "chapter_id": 2394, "verse_number": "९-१२-५", "content_sanskrit": "सात्यकिश्च शतेनैनं धर्मपुत्रपरीप्सया।\nमद्रेश्वरमवाकीर्य सिंहनादमथानदत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2065980, "chapter_id": 2394, "verse_number": "९-१२-६", "content_sanskrit": "नकुलः पञ्चभिश्चैनं सहदेवश्च प़ञ्चभिः।\nविद्ध्वा तं तु पुनस्तूर्णं ततो विव्याध सप्तभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2065981, "chapter_id": 2394, "verse_number": "९-१२-७", "content_sanskrit": "स तु शूरो रणे यत्तः पीडितस्तैर्महारथैः।\nविकृष्य कार्मुकं घोरं भारघ्नं वेगवत्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2065982, "chapter_id": 2394, "verse_number": "९-१२-८", "content_sanskrit": "सात्यकिं पञ्चविंशत्या शल्यो विव्याध मारिष।\nभीमसेनं तु सप्तत्या नकुलं सप्तभिस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2065983, "chapter_id": 2394, "verse_number": "९-१२-९", "content_sanskrit": "ततः स विशिखं चापं सहदेवस्य धन्विनः।\nछित्त्वा भल्लेन समरे विव्याधैनं त्रिसप्तभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2065984, "chapter_id": 2394, "verse_number": "९-१२-१०", "content_sanskrit": "सहदेवस्तु समरे मातुलं भूरिवर्चसम्।\nसज्यमन्यद्धनुः कृत्वा पञ्चभिः समताडयत्।\nशरैराशीविषाकारैर्ज्वलज्ज्वलनसन्निभैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2065985, "chapter_id": 2394, "verse_number": "९-१२-११", "content_sanskrit": "सारथिं चास्य समरे शरेणानतपर्वणा।\nविव्याध भृशसङ्क्रुद्धस्तं वै भूयस्त्रिभिः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2065986, "chapter_id": 2394, "verse_number": "९-१२-१२", "content_sanskrit": "भीमसेनस्तु सप्तत्या सात्यकिर्नवभिः शरैः।\nधर्मराजस्तथा षष्ट्या गात्रे शल्यं समार्पयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2065987, "chapter_id": 2394, "verse_number": "९-१२-१३", "content_sanskrit": "ततः शल्यो महाराज निर्विद्धस्तैर्महारथैः।\nसुस्राव रुधिरं गात्रैर्गैरिकं पर्वतो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2065988, "chapter_id": 2394, "verse_number": "९-१२-१४", "content_sanskrit": "तांश्च सर्वान्महेष्वासान्पञ्चभिः पञ्चभिः शरैः।\nविव्याध तरसा राजंस्तदद्भुतमिवाभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2065989, "chapter_id": 2394, "verse_number": "९-१२-१५", "content_sanskrit": "ततोऽपरेण भल्लेन धर्मपुत्रस्य मारिष।\nधनुश्चिच्छेद समरे सज्जयं स सुमहारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2065990, "chapter_id": 2394, "verse_number": "९-१२-१६", "content_sanskrit": "अथान्यद्धनुरादाय धर्मपुत्रो युधिष्ठिरः।\nसाश्वसूतध्वजरथं शल्यं प्राच्छादयच्छरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2065991, "chapter_id": 2394, "verse_number": "९-१२-१७", "content_sanskrit": "स च्छाद्यमानः समरे धर्मपुत्रस्य सायकैः।\nयुधिष्ठिरमथाविध्यद्दशभिर्निशितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2065992, "chapter_id": 2394, "verse_number": "९-१२-१८", "content_sanskrit": "सात्यकिस्तु ततः क्रुद्धो धर्मपुत्रे शरार्दिते।\nमद्राणामधिपं शूरं शरैर्विव्याध पञ्चभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2065993, "chapter_id": 2394, "verse_number": "९-१२-१९", "content_sanskrit": "स सात्यकेः प्रचिच्छेद क्षुरप्रेण महद्धनुः।\nभीमसेनमुखांस्तांश्च त्रिभिस्त्रिभिरताडयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2065994, "chapter_id": 2394, "verse_number": "९-१२-२०", "content_sanskrit": "तस्य क्रुद्धो महाराज सात्यकिः सत्यविक्रमः।\nतोमरं प्रेषयामास स्वर्णदण्डं महारणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2065995, "chapter_id": 2394, "verse_number": "९-१२-२१", "content_sanskrit": "भीमसेनोऽथ नाराचं ज्वलन्तमिव पन्नगम्।\nनकुलः समरे शक्तिं सहदेवो गदां शुभाम्।\nधर्मराजः शतघ्नीं च जिघांसुः शल्यमाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2065996, "chapter_id": 2394, "verse_number": "९-१२-२२", "content_sanskrit": "तानापतत एवाशु पञ्चानां वै भुजच्युतान्।\nवारयामास समरे शस्त्रसङ्घैः स मद्रराट्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2065997, "chapter_id": 2394, "verse_number": "९-१२-२३", "content_sanskrit": "सात्यकिप्रहितं शल्यो भल्लैश्चिच्छेद तोमरम्।\nप्रहितं भीमसेनेन शरं कनकभूषणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2065998, "chapter_id": 2394, "verse_number": "९-१२-२४", "content_sanskrit": "द्विधा चिच्छेद समरे कृतहस्तः प्रतापवान्।\nनकुलप्रेषितां शक्तिं हेमदण्डां भयावहाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2065999, "chapter_id": 2394, "verse_number": "९-१२-२५", "content_sanskrit": "गदां च सहदेवेन शरौघैः समवारयत्।\nशराभ्यां च शतघ्नीं तां राज्ञश्चिच्छेद भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2066000, "chapter_id": 2394, "verse_number": "९-१२-२६", "content_sanskrit": "पश्यतां पाण्डुपुत्राणां सिंहनादं ननाद च।\nनामृष्यत्तत्र शैनेयः शत्रोर्विजयमाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2066001, "chapter_id": 2394, "verse_number": "९-१२-२७", "content_sanskrit": "अथान्यद्धनुरादाय सात्यकिः क्रोधमूर्च्छितः।\nद्वाभ्यां मद्रेश्वरं विद्वा सारथिं च त्रिभिः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2066002, "chapter_id": 2394, "verse_number": "९-१२-२८", "content_sanskrit": "ततः शल्यो रणे राजन्सर्वांस्तान्दशभिः शरैः।\nविव्याध भृशसङ्क्रुद्धस्तोत्रैरिव महाद्विपान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2066003, "chapter_id": 2394, "verse_number": "९-१२-२९", "content_sanskrit": "ते वार्यमाणाः समरे मद्रराज्ञा महारथाः।\nन शेकुः सम्मुखे स्थातुं तस्य शत्रुनिषूदनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2066004, "chapter_id": 2394, "verse_number": "९-१२-३०", "content_sanskrit": "ततो दुर्योधनो राजा दृष्ट्वा शल्यस्य विक्रमम्।\nनिहतान्पाण्डवान्मेने पाञ्चालानथ सृञ्जयान्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2066005, "chapter_id": 2394, "verse_number": "९-१२-३१", "content_sanskrit": "`तथाविधं महाराज मद्रराजस्य विक्रमम्।\nअसह्यं मानवैर्युद्धे तद्बभूव नरर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2066006, "chapter_id": 2394, "verse_number": "९-१२-३२", "content_sanskrit": "ततो राजन्महाबाहुर्भीमसेनः प्रतापवान्।\nसन्त्यज्य मनसा प्राणान्मद्राधिपमयोधयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2066007, "chapter_id": 2394, "verse_number": "९-१२-३३", "content_sanskrit": "नकुलः सहदेवश्च सात्यकिश्च महारथः।\nपरिवार्य तदा शल्यं समन्ताद्व्यकिरञ्शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2066008, "chapter_id": 2394, "verse_number": "९-१२-३४", "content_sanskrit": "स चतुर्भिर्महेष्वासैः पाण्डवानां महारथः।\nवृतस्तान्योधयामास मद्रराजः प्रतापवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2066009, "chapter_id": 2394, "verse_number": "९-१२-३५", "content_sanskrit": "तस्य धर्मसुतो राजन्क्षुरप्रेण महाहवे।\nचक्ररक्षं जघानाशु मद्रराजस्य पार्थिवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2066010, "chapter_id": 2394, "verse_number": "९-१२-३६", "content_sanskrit": "तस्मिंस्तु निहते शूरे चक्ररक्षे महारथे।\nमद्रराजोऽपि बलवान्सैनिकानावृणोच्छरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2066011, "chapter_id": 2394, "verse_number": "९-१२-३७", "content_sanskrit": "समावृतांस्ततस्तांस्तु राजन्वीक्ष्य स्वसैनिकान्।\nचिन्तयामास समरे धर्मपुत्रो युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2066012, "chapter_id": 2394, "verse_number": "९-१२-३८", "content_sanskrit": "कथं नु न भवेत्सत्यं तन्माधववचो महत्।\nअपि क्रुद्धो रणे राजन्क्षपयेत बलं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2066013, "chapter_id": 2394, "verse_number": "९-१२-३९", "content_sanskrit": "`अहं मद्धातरश्चैव सात्यकिश्च महारथः।\nपाञ्चालाः सृञ्जयाश्चैव न शक्तास्म हि मद्रपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2066014, "chapter_id": 2394, "verse_number": "९-१२-४०", "content_sanskrit": "निहनिष्यति चैवाद्य मातुलोऽस्मान्महाबलः।\nगोविन्दवचनं सत्यं कथं भवति किन्त्विदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2066015, "chapter_id": 2394, "verse_number": "९-१२-४१", "content_sanskrit": "ततः सरथनागाश्वा पाण्डवाः पाण्डुपूर्वज।\nमद्रराजं समासेदुः पीडयन्तः समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2066016, "chapter_id": 2394, "verse_number": "९-१२-४२", "content_sanskrit": "नानाशस्त्रौघबहुलां शस्त्रवृष्टिं समुद्यताम्।\nव्यधमत्समरे राजा महाभ्राणीव मारुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2066017, "chapter_id": 2394, "verse_number": "९-१२-४३", "content_sanskrit": "ततः कनकपुङ्खां तां शल्यक्षिप्तां वियद्गताम्।\nशरवृष्टिमपश्याम शलभानामिवायतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2066018, "chapter_id": 2394, "verse_number": "९-१२-४४", "content_sanskrit": "ते शरा मद्रराजेन प्रेषिता रणमूर्धनि।\nसम्पतन्तः स्म दृश्यन्ते शलभानां व्रजा इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2066019, "chapter_id": 2394, "verse_number": "९-१२-४५", "content_sanskrit": "मद्रराजधनुर्मुक्तैः शरैः कनकभूषणैः।\nनिरन्तरमिवाकाशं सम्बभूव जनाधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2066020, "chapter_id": 2394, "verse_number": "९-१२-४६", "content_sanskrit": "न पाण्डवानां नास्माकं तत्र किञ्चिद्व्यदृश्यत।\nबाणान्धकारे महति कृते तत्र महाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2066021, "chapter_id": 2394, "verse_number": "९-१२-४७", "content_sanskrit": "मद्रराजेन बलिना लाघवाच्छरवृष्टिभिः।\nचाल्यमानं तु तं दृष्ट्वा पाण्डवानां बलार्णवम्।\nविस्मयं परमं जग्मुर्देवगन्धर्वदानवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2066022, "chapter_id": 2394, "verse_number": "९-१२-४८", "content_sanskrit": "स तु तान्सर्वतो यत्ताञ्शरैः सञ्छाद्य मारिष।\nधर्मराजमवच्छाद्य सिंहवद्व्यनदन्मुहुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2066023, "chapter_id": 2394, "verse_number": "९-१२-४९", "content_sanskrit": "ते च्छन्नाः समरे तेन पाण्डवानां महारथाः।\nनाशक्नुवंस्तदा युद्धे प्रत्युद्यातुं महारथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2066024, "chapter_id": 2394, "verse_number": "९-१२-५०", "content_sanskrit": "धर्मराजपुरोगास्तु भीमसेनमुखा रथाः।\nनिजघ्नुः समरे शूरंशल्यमाहवशोभिनम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2066025, "chapter_id": 2394, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शल्यपर्वणि शल्यवधपर्वणि अष्टादशदिवसयुद्धे द्वादशोऽध्यायः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]