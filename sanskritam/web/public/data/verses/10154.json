[{"id": 6000154000, "chapter_id": 10154, "verse_number": null, "content_sanskrit": "भगवद्बादरायणप्रणीतं श्रीमद्भागवतम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000154001, "chapter_id": 10154, "verse_number": null, "content_sanskrit": "अथ प्रथमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 6000154002, "chapter_id": 10154, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_001/BhP_08.001.001.m4a", "display_order": 3}, {"id": 6000154003, "chapter_id": 10154, "verse_number": "८-१-१", "content_sanskrit": "स्वायम्भुवस्येह मनोर्वंशोऽयं विस्तराच्छ्रुतः।\nयत्र विश्वसृजां सर्गो मनूनन्यान् वदस्व नः॥ ८/१/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_001/BhP_08.001.002.m4a", "display_order": 4, "topics": [{"text": "स्वायंभुवादिमन्वन्तरचतुष्टयनिरूपणम्", "range": "१–२९"}]}, {"id": 6000154004, "chapter_id": 10154, "verse_number": "८-१-२", "content_sanskrit": "यत्र धर्मा हि विविधाश्चतुर्वर्णाश्रिताः शुभाः।\nमन्वन्तरे हरेर्जन्म कर्माणि च महीयसः॥ ८/१/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_001/BhP_08.001.003.m4a", "display_order": 5}, {"id": 6000154005, "chapter_id": 10154, "verse_number": "८-१-३", "content_sanskrit": "गृणन्ति कवयो ब्रह्मन् तानि नो वद शृृण्वताम्। यदस्मिन्नन्तरे ब्रह्मन् भगवान् विश्वभावनः।\nकृतवान् कुरुते कर्ता ह्यतीतेऽनागतेऽथवा॥ ८/१/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_001/BhP_08.001.004.m4a", "display_order": 6}, {"id": 6000154006, "chapter_id": 10154, "verse_number": null, "content_sanskrit": "ऋषिरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_001/BhP_08.001.005.m4a", "display_order": 7}, {"id": 6000154007, "chapter_id": 10154, "verse_number": "८-१-४", "content_sanskrit": "मनवोऽस्मिन् व्यतीताः षट् कल्पे स्वायम्भुवादयः।\nआद्यस्ते कथितो ह्यत्र देवादीनां च सम्भवः॥ ८/१/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_001/BhP_08.001.006.m4a", "display_order": 8}, {"id": 6000154008, "chapter_id": 10154, "verse_number": "८-१-५", "content_sanskrit": "आकूत्यां देवहूत्यां च दुहित्रोस्तस्य वै मनोः।\nधर्मज्ञानोपदेशार्थं भगवान् पुत्रतां गतः॥ ८/१/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_001/BhP_08.001.007.m4a", "display_order": 9}, {"id": 6000154009, "chapter_id": 10154, "verse_number": "८-१-६", "content_sanskrit": "कृतं पुरा भगवतः कपिलस्यानुवर्णितम्।\nआख्यास्ये भगवान् यज्ञो यच्चकार कुरूद्वह॥ ८/१/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_001/BhP_08.001.008.m4a", "display_order": 10}, {"id": 6000154010, "chapter_id": 10154, "verse_number": "८-१-७", "content_sanskrit": "विरक्तः कामभोगेषु शतरूपापतिः प्रभुः।\nविसृज्य राज्यं तपसे सभार्यो वनमाविशत्॥ ८/१/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_001/BhP_08.001.009.m4a", "display_order": 11}, {"id": 6000154011, "chapter_id": 10154, "verse_number": "८-१-८", "content_sanskrit": "सुनन्दायां वर्षशतं पदैकेन भुवं स्पृशन्।\nतप्यमानस्तपो घोरमिदमन्वाह भारत॥ ८/१/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_001/BhP_08.001.010.m4a", "display_order": 12}, {"id": 6000154012, "chapter_id": 10154, "verse_number": null, "content_sanskrit": "मनुरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_001/BhP_08.001.011.m4a", "display_order": 13}, {"id": 6000154013, "chapter_id": 10154, "verse_number": "८-१-९", "content_sanskrit": "येनायं तपते विश्वं विश्ववीर्यं यतस्तपः।\nयो जागर्ति शयानेऽस्मिन् नायं तं वेद वेद सः॥ ८/१/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_001/BhP_08.001.012.m4a", "display_order": 14}, {"id": 6000154014, "chapter_id": 10154, "verse_number": "८-१-१०", "content_sanskrit": "आत्मावास्यमिदं विश्वं यज्जगत्यां जगन्मनः।\nतेन त्यक्तेन भुञ्जीथा मा गृधः कस्यचिद् धनम्॥ ८/१/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_001/BhP_08.001.013.m4a", "display_order": 15}, {"id": 6000154015, "chapter_id": 10154, "verse_number": "८-१-११", "content_sanskrit": "यं न पश्यन्ति पश्यन्तं चक्षुर्यस्य न रिष्यति।\nतं भूतनिलयं देवं सुपर्णमुपधावत॥ ८/१/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_001/BhP_08.001.014.m4a", "display_order": 16}, {"id": 6000154016, "chapter_id": 10154, "verse_number": "८-१-१२", "content_sanskrit": "यस्याद्यन्तौ न मध्यं च न परो नान्तरं बहिः।\nविश्वस्यामूनि यद् यस्माद् विश्वं च तद् ऋतं महत्॥ ८/१/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_001/BhP_08.001.015.m4a", "display_order": 17}, {"id": 6000154017, "chapter_id": 10154, "verse_number": "८-१-१३", "content_sanskrit": "स विश्वकायः पुरुहूत ईशः सत्यं परंज्योतिरजः पुराणः।\nधत्तेऽस्य जन्माद्यजयाऽऽत्मशक्त्या तां विद्ययोदस्य निरीह आस्ते॥ ८/१/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_001/BhP_08.001.016.m4a", "display_order": 18}, {"id": 6000154018, "chapter_id": 10154, "verse_number": "८-१-१४", "content_sanskrit": "अथाग्र ऋषयः कर्माणीहन्ते कर्महन्तवे।\nईहमानो हि पुरुषः प्रायोऽनीहां प्रपद्यते॥ ८/१/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_001/BhP_08.001.017.m4a", "display_order": 19}, {"id": 6000154019, "chapter_id": 10154, "verse_number": "८-१-१५", "content_sanskrit": "ईहते भगवानीशो न हि तत्र विषज्जते।\nआत्मलाभेन पूर्णार्थो नावसीदन्ति येऽनु तम्॥ ८/१/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_001/BhP_08.001.018.m4a", "display_order": 20}, {"id": 6000154020, "chapter_id": 10154, "verse_number": "८-१-१६", "content_sanskrit": "तमीहमानं निरहङ्कृतं बुधैर्निराशिषं पूर्णमनन्यचोदितम्।\nतच्छिक्षयन्तं निजवर्त्ममूढान् प्रभुं प्रपद्येऽखिलधर्मभावनम्॥ ८/१/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_001/BhP_08.001.019.m4a", "display_order": 21}, {"id": 6000154021, "chapter_id": 10154, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_001/BhP_08.001.020.m4a", "display_order": 22}, {"id": 6000154022, "chapter_id": 10154, "verse_number": "८-१-१७", "content_sanskrit": "इति मन्त्रोपनिषदं व्याहरन्तं समाहितम्।\nदृष्ट्वाऽसुरा यातुधाना जग्धुमभ्यद्रवन् क्षुधा॥ ८/१/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_001/BhP_08.001.021.m4a", "display_order": 23}, {"id": 6000154023, "chapter_id": 10154, "verse_number": "८-१-१८", "content_sanskrit": "तांस्तथाऽवसितान् वीक्ष्य यज्ञः सर्वगतो हरिः।\nयामैः परिवृतो देवैर्हत्वाऽशासत् त्रिविष्टपम्॥ ८/१/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_001/BhP_08.001.022.m4a", "display_order": 24}, {"id": 6000154024, "chapter_id": 10154, "verse_number": "८-१-१९", "content_sanskrit": "स्वारोचिषो द्वितीयस्तु मनुरग्नेः सुतोऽभवत्।\nद्युमत्सुषेणरोचिष्मत्प्रमुखास्तस्य चात्मजाः॥ ८/१/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_001/BhP_08.001.023.m4a", "display_order": 25}, {"id": 6000154025, "chapter_id": 10154, "verse_number": "८-१-२०", "content_sanskrit": "तत्रेन्द्रो रोचनस्त्वासीत् देवाश्च तुषितादयः।\nऊर्जस्तम्भादयः सप्त ऋषयो ब्रह्मवादिनः॥ ८/१/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_001/BhP_08.001.024.m4a", "display_order": 26}, {"id": 6000154026, "chapter_id": 10154, "verse_number": "८-१-२१", "content_sanskrit": "ऋषेस्तु वेदशिरसस्तुषिता नाम पत्न्यभूत्।\nतस्यां जज्ञे ततो देवो विभुरित्यभिविश्रुतः॥ ८/१/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_001/BhP_08.001.025.m4a", "display_order": 27}, {"id": 6000154027, "chapter_id": 10154, "verse_number": "८-१-२२", "content_sanskrit": "अष्टाशीतिसहस्राणि मुनयो ये धृतव्रताः।\nअन्वशिक्षन् व्रतं तस्य कौमारब्रह्मचारिणः॥ ८/१/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_001/BhP_08.001.026.m4a", "display_order": 28}, {"id": 6000154028, "chapter_id": 10154, "verse_number": "८-१-२३", "content_sanskrit": "तृतीय उत्तमो नाम प्रियव्रतसुतो मनुः।\nपवनः सृञ्जयो यज्ञहोत्राद्यास्तत्सुता नृप॥ ८/१/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_001/BhP_08.001.027.m4a", "display_order": 29}, {"id": 6000154029, "chapter_id": 10154, "verse_number": "८-१-२४", "content_sanskrit": "वसिष्ठतनयाः सप्त ऋषयः प्रमदादयः।\nसत्या वेदश्रुता भद्रा देवा इन्द्रस्तु सत्यजित्॥ ८/१/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_001/BhP_08.001.028.m4a", "display_order": 30}, {"id": 6000154030, "chapter_id": 10154, "verse_number": "८-१-२५", "content_sanskrit": "धर्मस्य सूनृतायां तु भगवान् पुरुषोत्तमः।\nसत्यसेन इति ख्यातो जातः सत्यव्रतैः सह॥ ८/१/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_001/BhP_08.001.029.m4a", "display_order": 31}, {"id": 6000154031, "chapter_id": 10154, "verse_number": "८-१-२६", "content_sanskrit": "सोऽनृतव्रतदुःशीलानसतो यक्षराक्षसान्।\nभूतद्रुहो भूतगणांस्त्ववधीत् सत्यजित्स्तुतः॥ ८/१/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_001/BhP_08.001.030.m4a", "display_order": 32}, {"id": 6000154032, "chapter_id": 10154, "verse_number": "८-१-२७", "content_sanskrit": "चतुर्थ उत्तमभ्राता मनुर्नाम्ना च तापसः।\nवृषः ख्यातिर्नरः केतुरित्याद्या दश तत्सुताः॥ ८/१/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_001/BhP_08.001.031.m4a", "display_order": 33}, {"id": 6000154033, "chapter_id": 10154, "verse_number": "८-१-२८", "content_sanskrit": "सत्यका हरयो वीरा देवास्‍त्रिशिख ईश्वरः।\nज्योतिर्धामादयः सप्त ऋषयस्तापसेऽन्तरे॥ ८/१/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_001/BhP_08.001.032.m4a", "display_order": 34}, {"id": 6000154034, "chapter_id": 10154, "verse_number": "८-१-२९", "content_sanskrit": "देवा वैधृतयो नाम विधृतेस्तनया नृप।\nनष्टाः कालेन यैर्वेदा विधृताः स्वेन तेजसा॥ ८/१/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_001/BhP_08.001.033.m4a", "display_order": 35}, {"id": 6000154035, "chapter_id": 10154, "verse_number": "८-१-३०", "content_sanskrit": "तत्रापि जज्ञे भगवान् हरिण्यां हरिमेधसः।\nहरिरित्याहुतो येन गजेन्द्रो मोचितो ग्रहात्॥ ८/१/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_001/BhP_08.001.034.m4a", "display_order": 36, "topics": [{"text": "चतुर्थमन्वन्तरीयभगवदवतारभूतस्य हरेर्गजेन्द्रमोक्षणकथा", "range": "३०–३२"}]}, {"id": 6000154036, "chapter_id": 10154, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_001/BhP_08.001.035.m4a", "display_order": 37}, {"id": 6000154037, "chapter_id": 10154, "verse_number": "८-१-३१", "content_sanskrit": "बादरायण एतत्ते श्रोतुमिच्छामहे वयम्।\nहरिर्यथा गजपतिं ग्राहग्रस्तममूमुचत्॥ ८/१/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_001/BhP_08.001.036.m4a", "display_order": 38}, {"id": 6000154038, "chapter_id": 10154, "verse_number": "८-१-३२", "content_sanskrit": "तत् कथासु महत्पुण्यं धन्यं स्वस्त्ययनं शुभम्।\nयत्र यत्रोत्तमश्लोको भगवान् गीयते हरिः॥ ८/१/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_001/BhP_08.001.037.m4a", "display_order": 39}, {"id": 6000154039, "chapter_id": 10154, "verse_number": null, "content_sanskrit": "सूत उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_001/BhP_08.001.038.m4a", "display_order": 40}, {"id": 6000154040, "chapter_id": 10154, "verse_number": "८-१-३३", "content_sanskrit": "परीक्षितैवं स तु बादरायणिः प्रायोपविष्टेन कथासु चोदितः।\nउवाच विप्राः प्रतिनन्द्य पार्थिवं मुदा मुनीनां सदसि स्म शृण्वताम्॥ ८/१/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_001/BhP_08.001.039.m4a", "display_order": 41}, {"id": 6000154041, "chapter_id": 10154, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायाम् अष्टमस्कन्धे प्रथमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]