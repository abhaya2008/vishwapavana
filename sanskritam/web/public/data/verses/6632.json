[
  {
    "id": 20005930,
    "chapter_id": 6632,
    "verse_number": "2.1",
    "content_sanskrit": "यियक्षमाणेनाहूतः पार्थेनाथ द्विषन्मुरम् । अभिचैद्यं प्रतिष्ठासुरासीत्कार्यद्वयाकुलः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "avatarnika": ""
  },
  {
    "id": 20005931,
    "chapter_id": 6632,
    "verse_number": "2.2",
    "content_sanskrit": "सार्धमुद्धवसीरिभ्यामथासावासदत्सदः । गुरुकाव्यानुगां बिभ्रच्चान्द्रीमभिनभः श्रियम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "avatarnika": ""
  },
  {
    "id": 20005932,
    "chapter_id": 6632,
    "verse_number": "2.3",
    "content_sanskrit": "जाज्वल्यमाना जगतः शान्तये समुपेयुषी । व्यद्योतिष्टसभावेद्यामसौ नरशिखित्रयी ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "avatarnika": ""
  },
  {
    "id": 20005933,
    "chapter_id": 6632,
    "verse_number": "2.4",
    "content_sanskrit": "रत्नस्तम्भेषु संक्रान्तप्रतिमास्ते चकाशिरे । एकाकिनोऽपि परितः पौरुषेयवृता इव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "avatarnika": ""
  },
  {
    "id": 20005934,
    "chapter_id": 6632,
    "verse_number": "2.5",
    "content_sanskrit": "अध्यासामासुरुत्तुङ्गहेमपीठानि यान्यमी । तैरूहे केशारिक्रान्तत्रिकूटशिखिरोपमा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "avatarnika": ""
  },
  {
    "id": 20005935,
    "chapter_id": 6632,
    "verse_number": "2.6",
    "content_sanskrit": "गुरुद्वयाय गुरुणोरुभयोरथ कार्ययोः । हरिविप्रतिषेधं तममाचचक्षे विचक्षणः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "avatarnika": ""
  },
  {
    "id": 20005936,
    "chapter_id": 6632,
    "verse_number": "2.7",
    "content_sanskrit": "द्योतितान्तःसभैः कुन्दकुड्मलाग्रदतः स्मितैः । स्नपितेवाभवत्तस्य शुद्धवर्णा सरस्वती ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "avatarnika": ""
  },
  {
    "id": 20005937,
    "chapter_id": 6632,
    "verse_number": "2.8",
    "content_sanskrit": "भवद्गिरामवसरप्रदानाय वचांसि नः । पूर्वरङ्गः प्रसङ्गाय नाटकीयस्य वस्तुनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "avatarnika": ""
  },
  {
    "id": 20005938,
    "chapter_id": 6632,
    "verse_number": "2.9",
    "content_sanskrit": "करदीकृतभूपालो भ्रातृभिर्जित्वरैर्दिशाम् । विनाप्यस्मदलंभूष्णुरिज्यायै तपसः सुतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "avatarnika": ""
  },
  {
    "id": 20005939,
    "chapter_id": 6632,
    "verse_number": "2.10",
    "content_sanskrit": "उत्तिष्ठमानस्तु परो नोपेक्ष्यः पत्यमिच्छता । समौ हि शिष्टैराम्नातौ वर्त्स्यन्तावामयः स च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "avatarnika": ""
  },
  {
    "id": 20005940,
    "chapter_id": 6632,
    "verse_number": "2.11",
    "content_sanskrit": "न दूये सात्वतीसूनुर्यन्मह्यमपराध्यति । यत्तु दह्यन्ते लोकमदो दुःखाकरोतिमाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "avatarnika": ""
  },
  {
    "id": 20005941,
    "chapter_id": 6632,
    "verse_number": "2.12",
    "content_sanskrit": "मम तावन्मतमिदं श्रूयतामङ्ग वामपि । ज्ञातसारोऽपि खल्वेकः संदिग्धे कार्यवस्तुनि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "avatarnika": ""
  },
  {
    "id": 20005942,
    "chapter_id": 6632,
    "verse_number": "2.13",
    "content_sanskrit": "यावदर्थपदां वाचमेवमादाय माधवः । विरराम महीयांसः प्रकृत्या मितभाषिणः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "avatarnika": ""
  },
  {
    "id": 20005943,
    "chapter_id": 6632,
    "verse_number": "2.14",
    "content_sanskrit": "ततः सपत्नापनयस्मरणानुशयस्फुरा । ओष्ठेन रामो रामोष्ठबिम्बचुम्बनचुञ्चुना ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "avatarnika": ""
  },
  {
    "id": 20005944,
    "chapter_id": 6632,
    "verse_number": "2.15",
    "content_sanskrit": "विवक्षितामर्थविदस्तत्क्षणप्रतिसंहृतां । प्रापयन्पवनव्याधेर्गिरमुत्तरपक्षताम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "avatarnika": ""
  },
  {
    "id": 20005945,
    "chapter_id": 6632,
    "verse_number": "2.16",
    "content_sanskrit": "घूर्णयन्मदिरास्वादमदपाटलितद्युती । रेवतीवदनोच्छिष्टपरिपूतपुटे दृशौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "avatarnika": ""
  },
  {
    "id": 20005946,
    "chapter_id": 6632,
    "verse_number": "2.17",
    "content_sanskrit": "आश्लेषलोलुपवधूस्तनकार्कश्यसाक्षिणीं । म्लापयन्नभिमानोष्णैर्वनमालां मुखानिलैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "avatarnika": ""
  },
  {
    "id": 20005947,
    "chapter_id": 6632,
    "verse_number": "2.18",
    "content_sanskrit": "दधत्संन्ध्यारुणव्योमस्फुरत्तारानुकारिणीः । द्वषद्वेषोपरक्ताङ्गसङ्गिनीः स्वेदविप्रुषः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "avatarnika": ""
  },
  {
    "id": 20005948,
    "chapter_id": 6632,
    "verse_number": "2.19",
    "content_sanskrit": "प्रोल्लसत्कुणडलप्रोतपद्मरागदलत्विषा । कृष्णोत्तरासङ्गरुचं विदधच्चौतपल्लवीम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "avatarnika": ""
  },
  {
    "id": 20005949,
    "chapter_id": 6632,
    "verse_number": "2.20",
    "content_sanskrit": "ककुद्मिकन्यावक्त्रान्तर्वासलब्धाधिवासया । मुखमोदं मदिरया कृतानुव्याधमुद्वमन् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "avatarnika": ""
  },
  {
    "id": 20005950,
    "chapter_id": 6632,
    "verse_number": "2.21",
    "content_sanskrit": "जगादवदनछद्मपद्मपर्यन्तपातिनः । नयन्मधुलिहः श्वैत्यमुदग्रदशनांशुभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "avatarnika": ""
  },
  {
    "id": 20005951,
    "chapter_id": 6632,
    "verse_number": "2.22",
    "content_sanskrit": "यद्वासुदेवेनादीनमनादीनवमीरितम् । वचसस्तस्य सपदि क्रिया केवलमुत्तरम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "avatarnika": ""
  },
  {
    "id": 20005952,
    "chapter_id": 6632,
    "verse_number": "2.23",
    "content_sanskrit": "नैतल्लघ्वपि भूयस्या वचो वाचातिशय्यते । इन्धनौघधगप्यग्नित्विषा नात्येति पूषणम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "avatarnika": ""
  },
  {
    "id": 20005953,
    "chapter_id": 6632,
    "verse_number": "2.24",
    "content_sanskrit": "संक्षिप्तस्याप्यतोऽस्यैव वाक्यस्यार्थगरीयसः । सुविस्तरतरा वाचो भूष्यभूता भवन्तु मो ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "avatarnika": ""
  },
  {
    "id": 20005954,
    "chapter_id": 6632,
    "verse_number": "2.25",
    "content_sanskrit": "विरोधिवचसो मूकान्वगीशानपि कुर्वते । जडानप्यनुलोमार्थान्प्रवाचः कृतिनां गिरः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "avatarnika": ""
  },
  {
    "id": 20005955,
    "chapter_id": 6632,
    "verse_number": "2.26",
    "content_sanskrit": "षड्गुणाः शक्तयस्तिस्रः सिद्धयोदयास्त्रयः । ग्रन्धानधीत्य व्याकर्तुमिति दुर्मेधसोऽप्यलम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "avatarnika": ""
  },
  {
    "id": 20005956,
    "chapter_id": 6632,
    "verse_number": "2.27",
    "content_sanskrit": "अनिर्लोडितकार्यस्य वाग्जालं वाग्मिनो वृथा । निमित्तादपराद्धेषोर्धानुष्कस्येव वल्गितम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "avatarnika": ""
  },
  {
    "id": 20005957,
    "chapter_id": 6632,
    "verse_number": "2.28",
    "content_sanskrit": "सर्वकार्यशरीरेषु मुक्त्वाङ्गस्कन्दपञ्चकम् । सौगतानामिवात्मान्यो नास्ति मन्त्रो महीभृताम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "avatarnika": ""
  },
  {
    "id": 20005958,
    "chapter_id": 6632,
    "verse_number": "2.29",
    "content_sanskrit": "मन्त्रो योध इवाधीरः सर्वाङ्गैः संवृतैरपि । चिरं न स्थातुं परेभ्यो भेदशङ्कया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "avatarnika": ""
  },
  {
    "id": 20005959,
    "chapter_id": 6632,
    "verse_number": "2.30",
    "content_sanskrit": "आत्मोदयः परज्यानिर्द्वयं नीतिरितीयति । तदूरीकृत्य कृतिभिर्वाचस्पत्यं प्रतायते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "avatarnika": ""
  },
  {
    "id": 20005960,
    "chapter_id": 6632,
    "verse_number": "2.31",
    "content_sanskrit": "तृप्तियोगः परेणापिमहिम्ना न महात्मनाम् । पूर्णश्चन्द्रोदयाकाङ्क्षी दृष्टानतोऽत्र महार्णवः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "avatarnika": ""
  },
  {
    "id": 20005961,
    "chapter_id": 6632,
    "verse_number": "2.32",
    "content_sanskrit": "संपदासुस्थिरंमन्यो भवति स्वल्पयापि यः । कृतकृत्यो विधिर्मन्ये न वर्धयन्ति तस्य ताम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "avatarnika": ""
  },
  {
    "id": 20005962,
    "chapter_id": 6632,
    "verse_number": "2.33",
    "content_sanskrit": "शमूलघातमघ्नन्तः परान्नोद्यन्ति मानिनः । प्रध्वंसितान्धतमसस्तत्रोदाहरणं रविः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 33,
    "avatarnika": ""
  },
  {
    "id": 20005963,
    "chapter_id": 6632,
    "verse_number": "2.34",
    "content_sanskrit": "विपक्षममखिलीकृत्य प्रतिष्ठा खलु दुर्लभा । अनीत्वा पङ्कतां धूलिमुदकं नावतिष्ठते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34,
    "avatarnika": ""
  },
  {
    "id": 20005964,
    "chapter_id": 6632,
    "verse_number": "2.35",
    "content_sanskrit": "ध्रियतेयावदेकोऽपि रिपुस्तावत्कुतः सुखम् । पुरः क्लश्नाति सोमं हि सैंहिकेयोऽसुरद्रुहाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 35,
    "avatarnika": ""
  },
  {
    "id": 20005965,
    "chapter_id": 6632,
    "verse_number": "2.36",
    "content_sanskrit": "सखागरीयान्शत्रुश्छकृत्रिमस्तौ हि कार्यतः । स्याताममित्रौ मित्रेच सहजप्रकृतावपि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 36,
    "avatarnika": ""
  },
  {
    "id": 20005966,
    "chapter_id": 6632,
    "verse_number": "2.37",
    "content_sanskrit": "उपकर्त्ररिणा संधिर्न मित्रेणापकारिणा । उपकारापकारौ हि लक्ष्यं लक्षममेतयोः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 37,
    "avatarnika": ""
  },
  {
    "id": 20005967,
    "chapter_id": 6632,
    "verse_number": "2.38",
    "content_sanskrit": "त्वयाविप्रकृतश्चैद्यो रुक्मिणीं हरताहरे । बद्धमूलस्यमूलं हि महद्वैरतरोः स्त्रियः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 38,
    "avatarnika": ""
  },
  {
    "id": 20005968,
    "chapter_id": 6632,
    "verse_number": "2.39",
    "content_sanskrit": "त्वयि भौमं गते जेतुमरौत्सीत्स पुरीमिमाम् । प्रोषितार्यमणं मेरोरन्धकारस्तटीमिव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
