    "avatarnika": ""
  },
  {
    "id": 20005969,
    "chapter_id": 6632,
    "verse_number": "2.40",
    "content_sanskrit": "आलाप्यालमिदं बभ्रोयत्स दारानपाहरत् । कथापि खलु पापानामलमश्रेयसे यतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 40,
    "avatarnika": ""
  },
  {
    "id": 20005970,
    "chapter_id": 6632,
    "verse_number": "2.41",
    "content_sanskrit": "विराद्ध एवं भमता विराद्धा बहुधा च नः । निर्वत्यतेऽरिः क्रियया स श्रुतश्रवसः सुतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 41,
    "avatarnika": ""
  },
  {
    "id": 20005971,
    "chapter_id": 6632,
    "verse_number": "2.42",
    "content_sanskrit": "विधायवैरं सामर्षेनरेऽरौ यःउदासते । प्रक्षिप्योदर्चिषं कक्षे शेरते तेऽभिमारुतम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 42,
    "avatarnika": ""
  },
  {
    "id": 20005972,
    "chapter_id": 6632,
    "verse_number": "2.43",
    "content_sanskrit": "मनागनभ्यावृत्त्या वा कामं क्षाम्यतु यः क्षमी । क्रियासमभिहारेण विराध्यन्तं क्षमेत कः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 43,
    "avatarnika": ""
  },
  {
    "id": 20005973,
    "chapter_id": 6632,
    "verse_number": "2.44",
    "content_sanskrit": "अन्यदा भूषणं पुंसः क्षमा लज्जेव योषितः । पराक्रमः परिभवे वैयात्यं सुरतेष्विव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 44,
    "avatarnika": ""
  },
  {
    "id": 20005974,
    "chapter_id": 6632,
    "verse_number": "2.45",
    "content_sanskrit": "माजीवन्यः परावज्ञादुखदग्धोऽपि जीवति । तस्याजननिरेवास्तु जननीक्लेशकारिणः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 45,
    "avatarnika": ""
  },
  {
    "id": 20005975,
    "chapter_id": 6632,
    "verse_number": "2.46",
    "content_sanskrit": "पदाहतं यदुत्थाय मूर्धानमधिरोहति । स्वस्थादेववपमानेऽपि देहिनस्तद्वरं रजः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 46,
    "avatarnika": ""
  },
  {
    "id": 20005976,
    "chapter_id": 6632,
    "verse_number": "2.47",
    "content_sanskrit": "असंपादयतः कञ्चिदर्थं जातिक्रियागुणैः । यदृच्छशब्दवत्पुंसः संज्ञायै जन्म केवलम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 47,
    "avatarnika": ""
  },
  {
    "id": 20005977,
    "chapter_id": 6632,
    "verse_number": "2.48",
    "content_sanskrit": "तुङ्गत्वमितरा नाद्रौ नेदं सिन्धावागाधता । अलङ्घनीयताहेतुरुभयं तन्मनस्विनि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 48,
    "avatarnika": ""
  },
  {
    "id": 20005978,
    "chapter_id": 6632,
    "verse_number": "2.49",
    "content_sanskrit": "तुल्येऽपराधे स्वर्भानुर्भानुमन्तं चिरेण यत् । हिमांशुमाशु ग्रसते तन्म्रदिम्नः स्फुटं फलम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 49,
    "avatarnika": ""
  },
  {
    "id": 20005979,
    "chapter_id": 6632,
    "verse_number": "2.50",
    "content_sanskrit": "स्वयं प्रणतेऽल्पेऽपि परवायावुपेयुषी । निदर्शनमसाराणां लघुर्बहुतृणं नरः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 50,
    "avatarnika": ""
  },
  {
    "id": 20005980,
    "chapter_id": 6632,
    "verse_number": "2.51",
    "content_sanskrit": "तेजस्विमध्ये तेजस्वी दवीयानपि गण्यते । पञ्चम पञ्चपसस्तपनो जातवेदसाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 51,
    "avatarnika": ""
  },
  {
    "id": 20005981,
    "chapter_id": 6632,
    "verse_number": "2.52",
    "content_sanskrit": "अकृत्वा हेलया पादमुच्चैर्मूर्धसु विद्वषाम् । कथङ्कारमनालम्बा कीर्तिद्यामधिरोहति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 52,
    "avatarnika": ""
  },
  {
    "id": 20005982,
    "chapter_id": 6632,
    "verse_number": "2.53",
    "content_sanskrit": "अङ्गाधिरोपितश्चन्द्रमा मृगलाञ्छनः । केशरी निष्ठुराक्षिप्तमृगयूथो मृगाधिपः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 53,
    "avatarnika": ""
  },
  {
    "id": 20005983,
    "chapter_id": 6632,
    "verse_number": "2.54",
    "content_sanskrit": "चतुर्थोपायसाध्येतु रिपौ सान्त्वमपक्रिया । स्वेद्यमामज्वरं प्राज्ञः कोऽम्भसा परिषिञ्चति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 54,
    "avatarnika": ""
  },
  {
    "id": 20005984,
    "chapter_id": 6632,
    "verse_number": "2.55",
    "content_sanskrit": "सामवादाः सकोपस्य तस्य प्रत्युत दीपकाः । प्रतप्तस्येव सहसा सर्पिषस्तोयबिन्दवः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 55,
    "avatarnika": ""
  },
  {
    "id": 20005985,
    "chapter_id": 6632,
    "verse_number": "2.56",
    "content_sanskrit": "गुणानामायथातथ्यादर्थं विप्लावयन्ति ये । अमात्यव्यञ्जनाराज्ञां दूष्यास्ते शत्रुसंज्ञिताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 56,
    "avatarnika": ""
  },
  {
    "id": 20005986,
    "chapter_id": 6632,
    "verse_number": "2.57",
    "content_sanskrit": "स्वशक्त्युपचये केचित्परस्य व्यसनेऽपरे । यानमाहुस्तदासीनं त्वामुत्थापयति द्वयम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 57,
    "avatarnika": ""
  },
  {
    "id": 20005987,
    "chapter_id": 6632,
    "verse_number": "2.58",
    "content_sanskrit": "लिलङ्घयिषतो लोकानलङ्घ्यानलघीयसः । यादवाम्भोनिधीन्रुन्धे वेलेव भवतः क्षमा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 58,
    "avatarnika": ""
  },
  {
    "id": 20005988,
    "chapter_id": 6632,
    "verse_number": "2.59",
    "content_sanskrit": "विजयस्वयि सेनायाः साक्षिमात्रेऽपादिश्यताम् । फलभाजि समीक्ष्योक्ते बुद्धेर्भोग इवात्मनि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 59,
    "avatarnika": ""
  },
  {
    "id": 20005989,
    "chapter_id": 6632,
    "verse_number": "2.60",
    "content_sanskrit": "हृतेहिडिम्बरिपुणा राज्ञि द्वैमातुरे युधि । चिरस्य मित्त्रव्यसनि सुदमो दमघोषजः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 60,
    "avatarnika": ""
  },
  {
    "id": 20005990,
    "chapter_id": 6632,
    "verse_number": "2.61",
    "content_sanskrit": "नीतिरापदि यद्गम्यः परस्तन्मानिनो ह्रिये । विधुर्विधुन्तस्येव पूर्णस्तस्योत्सवाय सः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 61,
    "avatarnika": ""
  },
  {
    "id": 20005991,
    "chapter_id": 6632,
    "verse_number": "2.62",
    "content_sanskrit": "अन्यदुच्छृङ्घलं सत्वमन्यत्छ्छास्त्रनियन्त्रितं । सामानाधिकरण्यं हि तेजस्तमिरयोः कुतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 62,
    "avatarnika": ""
  },
  {
    "id": 20005992,
    "chapter_id": 6632,
    "verse_number": "2.63",
    "content_sanskrit": "इन्द्रप्रस्थगमस्तावत्कारि मा सन्तु चेदयः । आस्माकदन्तिसान्निध्याद्वामनीभूतभूरुहः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 63,
    "avatarnika": ""
  },
  {
    "id": 20005993,
    "chapter_id": 6632,
    "verse_number": "2.64",
    "content_sanskrit": "निरुद्धवीवधासारप्रसारा गा इव व्रजम् । उपरुन्धन्तु दाशार्हाः पुरीं माहिष्मतीं द्विषः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 64,
    "avatarnika": ""
  },
  {
    "id": 20005994,
    "chapter_id": 6632,
    "verse_number": "2.65",
    "content_sanskrit": "यजतां पाण्डवः स्वर्गमवत्विन्द्रस्पस्विनः । वयं हनाम द्विषतः सर्वः स्वार्थं समीहते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 65,
    "avatarnika": ""
  },
  {
    "id": 20005995,
    "chapter_id": 6632,
    "verse_number": "2.66",
    "content_sanskrit": "प्राप्यतां विद्युतां संपद्संपर्कादर्करोचिषाम् । शस्त्रैद्विषच्छिरश्छेदप्रोच्छलच्छोणितोक्षितैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 66,
    "avatarnika": ""
  },
  {
    "id": 20005996,
    "chapter_id": 6632,
    "verse_number": "2.67",
    "content_sanskrit": "इतिसंरम्भिणो वाणीर्बलस्यालेख्यदेवताः । सभाभित्तिप्रतिध्वनैर्भयादन्ववदन्निव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 67,
    "avatarnika": ""
  },
  {
    "id": 20005997,
    "chapter_id": 6632,
    "verse_number": "2.68",
    "content_sanskrit": "निशम्य ताः शेषगवीरमभिधातुमधोक्षजः । शिष्याय बृहतां प्रत्युः प्रस्तावमदिशद्दृशा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 68,
    "avatarnika": ""
  },
  {
    "id": 20005998,
    "chapter_id": 6632,
    "verse_number": "2.69",
    "content_sanskrit": "भारतीमाहितभरामथानुद्धतमुद्धवः । तथ्यामुतथ्यानुजवज्जगादाग्रे गदाग्रजम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 69,
    "avatarnika": ""
  },
  {
    "id": 20005999,
    "chapter_id": 6632,
    "verse_number": "2.70",
    "content_sanskrit": "संप्रत्यसांप्रतं वक्तुमुक्ते मुसलपाणिना । निर्धारितेर्ऽथे लेखेनखलूक्त्वा खलुवाचिकम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 70,
    "avatarnika": ""
  },
  {
    "id": 20006000,
    "chapter_id": 6632,
    "verse_number": "2.71",
    "content_sanskrit": "तथापि यन्मय्यपि ते गुरुरित्यस्ति गौरवम् । तत्प्रयोजककर्तृत्वमुपैति मम जल्पतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 71,
    "avatarnika": ""
  },
  {
    "id": 20006001,
    "chapter_id": 6632,
    "verse_number": "2.72",
    "content_sanskrit": "वर्णै कतिपयैरेव ग्रथितस्य स्वरैरिव । अनन्ता वाङ्मयस्याहो गेयस्येव विचित्रता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 72,
    "avatarnika": ""
  },
  {
    "id": 20006002,
    "chapter_id": 6632,
    "verse_number": "2.73",
    "content_sanskrit": "बह्वपि स्वेच्छया कामं प्रकीर्णमभिधीयते । अनुज्झितर्थसंबन्धः प्रबन्धो दुरुदाहरः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 73,
    "avatarnika": ""
  },
  {
    "id": 20006003,
    "chapter_id": 6632,
    "verse_number": "2.74",
    "content_sanskrit": "म्रदीयसीमपि घनामनल्पगुणकल्पिताम् । प्रसारयन्ति कुशलाश्चित्रां वाचं पटीमिव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 74,
    "avatarnika": ""
  },
  {
    "id": 20006004,
    "chapter_id": 6632,
    "verse_number": "2.75",
    "content_sanskrit": "विशेषविदुषः शास्त्रं यत्तवोद्ग्राह्यते पुरः । हेतुः परिचयस्थैर्ये वक्तुर्गुणनिकैव सा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 75,
    "avatarnika": ""
  },
  {
    "id": 20006005,
    "chapter_id": 6632,
    "verse_number": "2.76",
    "content_sanskrit": "पज्ञोत्साहवतः स्वामी यतेताधातुमात्मनि । तौ हि मूलमुदेष्यन्त्या जिगीषोरात्मसंपदः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 76,
    "avatarnika": ""
  },
  {
    "id": 20006006,
    "chapter_id": 6632,
    "verse_number": "2.77",
    "content_sanskrit": "सोपधानां धियं धीराः स्थेयसीं खट्वयन्ति ये । तत्रानिशं निषम्ण्णास्ते जानते जातु न श्रमंम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 77,
    "avatarnika": ""
  },
  {
    "id": 20006007,
    "chapter_id": 6632,
    "verse_number": "2.78",
    "content_sanskrit": "स्पृशन्ति शरवत्तीक्ष्णस्तोकमन्तर्विशन्ति च । बहुस्पृशापि स्थूलेन स्थीयते बहिरश्मवत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 78,
    "avatarnika": ""
  },
  {
    "id": 20006008,
    "chapter_id": 6632,
    "verse_number": "2.79",
    "content_sanskrit": "आरभन्तेऽल्पमेवाज्ञाः कामं व्यग्रा भवन्ति च । महारम्भाः कृतधियस्तिष्ठन्ति च निराकुलाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 79,
    "avatarnika": ""
  },
  {
    "id": 20006009,
    "chapter_id": 6632,
    "verse_number": "2.80",
    "content_sanskrit": "उपायमस्थितस्यापि नश्यन्त्यर्थाः प्रमाद्यतः । हन्ति नोपशयस्थोऽपि शयालुर्मृगयुर्मृगान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 80,
    "avatarnika": ""
  },
  {
    "id": 20006010,
    "chapter_id": 6632,
    "verse_number": "2.81",
    "content_sanskrit": "उदेतुमत्यजन्नीहां राजसु द्वदशस्वपि । जिगीषुरेको दिनकृदादित्येष्विव कल्पते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 81,
    "avatarnika": ""
  },
  {
    "id": 20006011,
    "chapter_id": 6632,
    "verse_number": "2.82",
    "content_sanskrit": "बुद्धिशस्त्रः प्रकृत्यङ्गो घनसंवृतिकञ्चुकः । चारेक्षणो दूतमुखः पपुरुषः कोऽपि पार्थिवः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 82,
    "avatarnika": ""
  },
  {
    "id": 20006012,
    "chapter_id": 6632,
    "verse_number": "2.83",
    "content_sanskrit": "तेजः क्षमा वा नैकान्तं कालज्ञस्य महीपतेः । नैकमोजः प्रसादो वा रसभावविदः कवेः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 83,
    "avatarnika": ""
  },
  {
    "id": 20006013,
    "chapter_id": 6632,
    "verse_number": "2.84",
    "content_sanskrit": "कृतापचारोऽपि परैरनाविष्कृतविक्रियः । असाध्यः कुरुते वा रसभावविदः कवेः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 84,
    "avatarnika": ""
  },
  {
    "id": 20006014,
    "chapter_id": 6632,
    "verse_number": "2.85",
    "content_sanskrit": "मृदुव्यवहितं तेजो भोक्तमर्थान्प्रकल्पते । प्रदीपः स्नेहमादत्ते दशयाभ्यन्तरस्थया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 85,
    "avatarnika": ""
  },
  {
    "id": 20006015,
    "chapter_id": 6632,
    "verse_number": "2.86",
    "content_sanskrit": "नालम्बते नैष्ठिकतां न निषीदति पौरुषे । शब्दार्थौ सत्कविरिव द्वयं विद्वानपेक्षते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 86,
    "avatarnika": ""
  },
  {
    "id": 20006016,
    "chapter_id": 6632,
    "verse_number": "2.87",
    "content_sanskrit": "स्थायिनोर्ऽथे प्रवर्तन्ते भावाः संचारिणो यथा । रसस्यैकस्य भूयांसस्तथा नेतुर्महीभृतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 87,
    "avatarnika": ""
  },
  {
    "id": 20006017,
    "chapter_id": 6632,
    "verse_number": "2.88",
    "content_sanskrit": "तन्त्रवापविदा योगैर्मण्डलान्यधिष्ठिता । सुनिग्रहानरेन्द्रेण फणीन्द्रा इव शत्रवः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 88,
    "avatarnika": ""
  },
  {
    "id": 20006018,
    "chapter_id": 6632,
    "verse_number": "2.89",
    "content_sanskrit": "करप्रचेयामुत्तुङ्गः प्रभुशक्तिं प्रतीयसीम् । प्रज्ञाबलबृहन्मूलः फलत्युत्साहपादपः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 89,
    "avatarnika": ""
  },
  {
    "id": 20006019,
    "chapter_id": 6632,
    "verse_number": "2.90",
    "content_sanskrit": "अल्पत्वात्प्रबलत्वाद्वंशस्येवेतरे स्वराः । विजीगीषोनृपतयः प्रयान्ति परिवारतां ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 90,
    "avatarnika": ""
  },
  {
    "id": 20006020,
    "chapter_id": 6632,
    "verse_number": "2.91",
    "content_sanskrit": "अप्यनारभमाणस्य विभोरुत्पादिताः परैः । व्रजन्ति गुणतामर्थाः शब्दा इव विहायसः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 91,
    "avatarnika": ""
  },
  {
    "id": 20006021,
    "chapter_id": 6632,
    "verse_number": "2.92",
    "content_sanskrit": "यातव्यपार्ष्णिग्राहादिमालायामधिकद्युतिः । एकार्थतन्तुप्रोतायां नायको नायकायते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 92,
    "avatarnika": ""
  },
  {
    "id": 20006022,
    "chapter_id": 6632,
    "verse_number": "2.93",
    "content_sanskrit": "षाड्गुण्यमुपयुञ्जीत शक्त्यपेक्षो रसायनं । भवन्त्यस्येवमङ्गानि स्थास्नूनि बलवन्ति च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 93,
    "avatarnika": ""
  },
  {
    "id": 20006023,
    "chapter_id": 6632,
    "verse_number": "2.94",
    "content_sanskrit": "स्थाने शमवतां शक्त्या व्यायामे वृद्धिरङ्गिनां । अयथाबलमारम्भो निदानं क्षयसंपदः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 94,
    "avatarnika": ""
  },
  {
    "id": 20006024,
    "chapter_id": 6632,
    "verse_number": "2.95",
    "content_sanskrit": "तदीशितारं चेदिनां भवांस्तमवमंस्त मा । निहन्त्यरीनेकपदे य उदात्तः स्वरानिव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 95,
    "avatarnika": ""
  },
  {
    "id": 20006025,
    "chapter_id": 6632,
    "verse_number": "2.96",
    "content_sanskrit": "मा वेदि यदसावेको जेतव्यश्चेदिराडिति । राजयक्ष्मेव रोगाणां समूह स महीभृतां ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 96,
    "avatarnika": ""
  },
  {
    "id": 20006026,
    "chapter_id": 6632,
    "verse_number": "2.97",
    "content_sanskrit": "संपादितफलस्तेन सपक्षः परभेदनः । कार्मुकेणेवगुणिना बाणः संधानमेष्यति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 97,
    "avatarnika": ""
  },
  {
    "id": 20006027,
    "chapter_id": 6632,
    "verse_number": "2.98",
    "content_sanskrit": "ये चान्ये कालयवनशाल्वरुक्मिद्रुमादयः । तमःस्वभावस्ते।प्येनं प्रदोषमनुयायिनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 98,
    "avatarnika": ""
  },
  {
    "id": 20006028,
    "chapter_id": 6632,
    "verse_number": "2.99",
    "content_sanskrit": "उपजापः कृतस्तेन तानाकोपवतस्त्वयि । आशु दीपयिताल्पोऽपि साग्नीनेधानिवानिलः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 99,
    "avatarnika": ""
  },
  {
    "id": 20006029,
    "chapter_id": 6632,
    "verse_number": "2.100",
    "content_sanskrit": "बृहत्सहायः कार्यान्तं क्षोदीयानपि गच्छति । संभूयाम्भोधिमभ्येति महानद्या नगापगा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 100,
    "avatarnika": ""
  },
  {
    "id": 20006030,
    "chapter_id": 6632,
    "verse_number": "2.101",
    "content_sanskrit": "तस्य मित्राण्यमित्रास्ते ये च ये चोभये नृपाः । अबियुक्तं त्वयैनं ते गन्तारस्त्वामतः परे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 101,
    "avatarnika": ""
  },
  {
    "id": 20006031,
    "chapter_id": 6632,
    "verse_number": "2.102",
    "content_sanskrit": "मखविघ्नाय सकलमित्थमित्युत्थाप्य राजकम् । हन्त जातमजातारेः प्रथमेन त्वयारिणा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 102,
    "avatarnika": ""
  },
  {
    "id": 20006032,
    "chapter_id": 6632,
    "verse_number": "2.103",
    "content_sanskrit": "संभाव्य त्वामतिभरक्षमस्कन्धं सबान्धवः । सहायमध्वरधुरां धर्मराजो विवक्षते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 103,
    "avatarnika": ""
  },
  {
    "id": 20006033,
    "chapter_id": 6632,
    "verse_number": "2.104",
    "content_sanskrit": "महात्मनोऽनुगृह्णन्ति भजमानान्रिपूनपि । सपन्तीः प्रापयन्त्यब्धिं सिन्धवो नगनिम्नगा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 104,
    "avatarnika": ""
  },
  {
    "id": 20006034,
    "chapter_id": 6632,
    "verse_number": "2.105",
    "content_sanskrit": "चिरादपि बलात्कारो बलिनः सिद्धयेऽरिषु । छन्दानुवृत्तिदुःःसाध्याः सुहृदो विमनीकृताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 105,
    "avatarnika": ""
  },
  {
    "id": 20006035,
    "chapter_id": 6632,
    "verse_number": "2.106",
    "content_sanskrit": "मन्यसेऽरिवधः श्रेयान्प्रीतये नाकिनामिति । पुरोडाशभुजामिष्टमिष्टं कर्तुमलन्तरां ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 106,
    "avatarnika": ""
  },
  {
    "id": 20006036,
    "chapter_id": 6632,
    "verse_number": "2.107",
    "content_sanskrit": "अमृतं नाम यत्सन्तो मन्त्रजिह्वेषु जुह्वति । शोभैव मन्दरक्षुब्धक्षुभिताम्भोधिवर्णना ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 107,
    "avatarnika": ""
  },
  {
    "id": 20006037,
    "chapter_id": 6632,
    "verse_number": "2.108",
    "content_sanskrit": "सहिष्ये शतमागांसि सूनोस्त इति यत्वया । प्रतीक्ष्यन्तत्प्रतीक्ष्यायै पितृष्वस्रे प्रतिश्रुतम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 108,
    "avatarnika": ""
  },
  {
    "id": 20006038,
    "chapter_id": 6632,
    "verse_number": "2.109",
    "content_sanskrit": "तीक्ष्णा नारुन्तुदा बुद्धिः कर्म शान्तं प्रतापवत् । नोपतापि मनः सोषमवागेका वाग्मिनः सतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 109,
    "avatarnika": ""
  },
  {
    "id": 20006039,
    "chapter_id": 6632,
    "verse_number": "2.110",
    "content_sanskrit": "स्वयङ्कृतप्रसादस्य तस्याह्नो भानुमानिव । समयावधिमप्राप्यय नान्तायालं भवानपि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 110,
    "avatarnika": ""
  },
  {
    "id": 20006040,
    "chapter_id": 6632,
    "verse_number": "2.111",
    "content_sanskrit": "कृत्वा कृत्यविदस्तीर्थेष्वन्तः प्रणिधयः पदम् । विदां कुर्वन्तु महतस्तलं विद्विषम्भसः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 111,
    "avatarnika": ""
  },
  {
    "id": 20006041,
    "chapter_id": 6632,
    "verse_number": "2.112",
    "content_sanskrit": "अनुत्सूत्रपदन्यासा सद्वृत्ति सन्निबन्धना । शब्दविद्येव नो भाति राजनीतिरस्पशा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 112,
    "avatarnika": ""
  },
  {
    "id": 20006042,
    "chapter_id": 6632,
    "verse_number": "2.113",
    "content_sanskrit": "अज्ञातदोषैर्देषज्ञैरुद्दूष्योभयवेतनैः । भेद्याः शत्रोरभिव्यक्तशासनैः सामवायिकाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 113,
    "avatarnika": ""
  },
  {
    "id": 20006043,
    "chapter_id": 6632,
    "verse_number": "2.114",
    "content_sanskrit": "उपेयिवांसि कर्तारः पुरीमाजातशत्रवीम् । राजन्यकान्युपायज्ञैरेकार्थानि चरैस्तव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 114,
    "avatarnika": ""
  },
  {
    "id": 20006044,
